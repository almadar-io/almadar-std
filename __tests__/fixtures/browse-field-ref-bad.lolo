app browse-field-ref [
  version: "1.0.0",
  description: "bad"
]
uses Browse from "std/behaviors/std-browse"

orbital ArticleOrbital {
  entity Article [persistent: articles] {
    id : string!
    subject : string!
    body : string
  }
  trait ArticleList = Browse.traits.BrowseItemBrowse -> Article {
    config {
      searchField: subject
      detailFields: []
      fields: [{
        name: title
        label: Title
        variant: h4
      }]
      columns: [{
        key: c
        field: nope
        header: Title
      }]
    }
  }
  page "/articles" as ArticlePage -> ArticleList
}
