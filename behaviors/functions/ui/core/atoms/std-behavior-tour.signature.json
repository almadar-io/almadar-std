        "events": [
          {
            "name": "TOUR_PLAY",
            "direction": "emit",
            "description": "Toggles the composed transport's clock: the demo scrolled into view with playWhenVisible on, or it left the view while playing (paused) and came back (resumed).",
            "tier": "internal"
          },
          {
            "name": "TOUR_STEP",
            "direction": "emit",
            "description": "One scripted step: the program routes it to the demo behavior's own event with a filtered listen on `event`.",
            "synonyms": "tour step, demo step, tutorial step, next step",
            "tier": "domain"
          },
          {
            "name": "TOUR_RESET",
            "direction": "emit",
            "description": "Reset was pressed: the program returns the demo behavior to its starting state.",
            "synonyms": "restart tour, reset demo",
            "tier": "domain"
          },
          {
            "name": "INIT",
            "direction": "listen"
          },
          {
            "name": "LEARN_STEP",
            "direction": "listen",
            "description": "One tick of the composed transport, or its Step button.",
            "tier": "internal"
          },
