          "provides": [
            "lastLogId",
            "lastNote",
            "round"
          ]
        },
        "effectRow": [
          {
            "kind": "emit",
            "resource": "ReviewDecided"
          },
          {
            "kind": "emit",
            "resource": "ReviewRequested"
          },
          {
            "kind": "persist",
            "resource": "ReviewEvent"
          },
          {
            "kind": "render-ui",
            "resource": "toast"
          },
          {
