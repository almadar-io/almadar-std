;; From @almadar/core (runtime BINDING_CONTEXT_RULES export)
binding-rules {
  guard  : (entity payload state now config user)
  effect : (entity payload state now trait config user callsitePayload pages currentTheme)
  tick   : (entity state now config user)
}

;; Sigils (sealed; never extend):
;;   @entity        - the trait's linkedEntity row
;;   @entity.field  - field on linkedEntity
;;   @payload       - the current event's payload object
;;   @payload.field - field on event payload
;;   @state         - current state name (string)
;;   @now           - current timestamp
;;   @config.field  - OrbitalConfig field
;;   @EntityName.f  - cross-entity field reference

