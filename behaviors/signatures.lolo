  events         : (INIT ACTION HOVER @config.onClick @config.onMouseEnter @config.onMouseLeave @config.action @config.hoverEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ACTION) (idle -> idle on HOVER))
  emits          : (@config.onClick @config.onMouseEnter @config.onMouseLeave @config.action @config.hoverEvent)
  config {
    action         : event = "ACTION" @label "Action" @description "Declarative event name — emits UI:{action} via eventBus on click" @tier "presentation"
    annotationId   : string @label "Annotation Id" @description "Unique ID for the annotation" @tier "presentation"
    children       : node @label "Children" @description "Highlighted text content" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    highlightType  : string = "question" @label "Highlight Type" @description "Type of highlight (determines color)" @tier "presentation" @values (question note)
    hoverEvent     : event = "HOVER" @label "Hover Event" @description "Declarative hover event — emits UI:{hoverEvent} with { hovered, annotationId }" @tier "presentation"
    isActive       : boolean = false @label "Is Active" @description "Whether the highlight is currently active/focused" @tier "presentation"
    onClick        : event = "CLICK" @label "On Click" @description "Callback when highlight is clicked" @tier "presentation"
    onMouseEnter   : event = "MOUSE_ENTER" @label "On Mouse Enter" @description "Callback when highlight is hovered" @tier "presentation"
    onMouseLeave   : event = "MOUSE_LEAVE" @label "On Mouse Leave" @description "Callback when hover ends" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/ui-text-highlight.orb orbitals[0].traits[0])"
}

