  params         : ((seed any) (...steps function[]))
  returns        : any
  side-effects?  : false
  compile-time?  : true
  desc           : "Left-to-right composition. Each step receives the previous result as its first arg."
  example        : "(behavior/pipe orbitals (behavior/wire wiring) (behavior/compose { appName: \"X\" }))"
  source         : ["@almadar/std/modules/composition.ts: behavior/pipe" "@almadar/std (STD_OPERATORS): behavior/pipe"]
}

operator behavior/wire {
  category       : std-composition
  module         : composition
  arity          : 2
  params         : ((orbitals array) (wiring array))
  returns        : array
  side-effects?  : false
  compile-time?  : true
  desc           : "Apply cross-orbital event wiring. Adds external emits/listens to inline traits."
  example        : "(behavior/wire orbitals wiring)"
  source         : ["@almadar/std/modules/composition.ts: behavior/wire" "@almadar/std (STD_OPERATORS): behavior/wire"]
}


