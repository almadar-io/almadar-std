;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-floating-action-button.orb orbitals[0].traits[0])
trait ui-floating-action-button.traits.FloatingActionButtonRender {
  alias          : UiFloatingActionButton
  linkedEntity   : FloatingActionButtonItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.action @config.onClick)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.action @config.onClick)
  config {
    action         : event = "ACTION" @label "Action" @description "Declarative event name. When set, clicking the FAB emits `UI:{action}` via the event bus and (if also provided) calls `onClick`. Mirrors the Button atom's `action` prop so schemas can write `{ type: 'floating-action-button', action: 'INIT' }` uniformly." @tier "presentation"
    actionPayload  : @payload(action) @label "Action Payload" @description "Payload to include with the dispatched action event." @tier "presentation"
    actions        : [FloatingActionButtonActionsItem] = [] @label "Actions" @description "Multiple actions. When provided, the button expands to show all of them." @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    icon           : icon @label "Icon" @description "Icon: a canonical icon name string (resolved by Button) or a Lucide component." @tier "presentation"
    label          : string @label "Label" @description "Optional label shown via `aria-label` (visually hidden in single-action mode; rendered as a tooltip beside expanded actions in multi-action mode)." @tier "presentation"
    onClick        : event = "CLICK" @label "On Click" @description "Optional direct click handler. Runs after the action emit when both are present." @tier "presentation"
    position       : string = "bottom-right" @label "Position" @description "Button position" @tier "presentation"
    variant        : string = "primary" @label "Variant" @description "Visual variant." @tier "presentation" @values (primary secondary success danger warning)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-floating-action-button.orb orbitals[0].traits[0])"
}

