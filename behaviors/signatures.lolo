    event          : event = "GEO_SEARCH" @label "Search event" @description "Event emitted when the user runs a geo search" @tier "internal"
    placeholder    : string = "Search nearby…" @label "Search placeholder" @description "Hint text in the location search input" @tier "presentation"
  }
