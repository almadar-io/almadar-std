;; From @almadar/std (behaviors/registry/ml/atoms/std-weight-validator.orb orbitals[0].traits[0])
trait std-weight-validator.traits.WeightValidatorRun {
  alias          : WeightValidator
  linkedEntity   : WeightValidation
  category       : lifecycle
  states         : (idle* checked)
  events         : (INIT VALIDATE_WEIGHTS RESET WEIGHTS_ACCEPTED WEIGHTS_REJECTED)
  transitions    : ((idle -> idle on INIT) (idle -> checked on VALIDATE_WEIGHTS) (checked -> checked on INIT) (checked -> idle on RESET))
  emits          : (WEIGHTS_ACCEPTED WEIGHTS_REJECTED)
