    heading        : string = "" @label "Heading" @description "Heading above the figures; empty hides it" @tier "presentation"
    items          : [StatBandItem] = [{"label":"Building blocks","value":"120+"},{"label":"Languages","value":"3"},{"label":"Uptime","value":"99.9%"}] @label "Figures" @description "One entry per figure: value (number or short text) and label" @synonyms "stats, numbers, metrics, kpis, by the numbers" @tier "presentation"
    surface        : string = "plain" @label "Surface" @tier "presentation" @values (plain muted)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-stat-band.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-stats.orb orbitals[0].traits[0])
trait std-stats.traits.StatsItemStats {
  alias          : Stats
  linkedEntity   : StatsItem
  category       : interaction
  states         : (idle*)
  events         : (INIT ITEMS_LOADED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ITEMS_LOADED))
  config {
    bodyContent    : render-ui = {"children":[{"entity":"@entity.cards","fields":[],"renderItem":["fn","card",{"clickEvent":"@card.clickEvent","format":"@card.format","icon":"@card.icon","label":"@card.label","look":"@config.statLook","max":"@card.max","prefix":"@card.prefix","sparklineData":"@card.sparklineData","suffix":"@card.suffix","target":"@card.target","trend":"@card.trend","trendFormat":"@card.trendFormat","trendPolarity":"@card.trendPolarity","type":"stat-display","value":"@card.value","variant":"@card.variant"}],"type":"@config.viewPattern"}],"data-theme":"@config.theme","type":"box"} @label "Body content tree" @description "Render-ui SExpr rendered after metrics aggregate for statsLook='cards' — the canonical data-grid call mapping @entity.cards through stat-display. Other statsLook values render kpiTilesBodyContent / heroMetricBodyContent / sparklineRowBodyContent instead; all four share this trait's state machine, aggregation pipeline, and listens." @tier "internal"
    heroMetricBodyContent : render-ui = {"children":[{"entity":"@entity.cards","fields":[],"gap":"none","renderItem":["fn","card",{"children":[{"children":[{"align":"center","children":[{"align":"center","children":[{"color":"muted","name":"@card.icon","size":"md","type":"icon"},{"className":"uppercase tracking-widest","color":"muted","content":"@card.label","type":"typography","variant":"overline","weight":"bold"}],"direction":"horizontal","gap":"sm","justify":"center","type":"stack"},{"align":"baseline","children":[{"color":"muted","content":"@card.prefix","type":"typography","variant":"h2","weight":"normal"},{"className":"text-7xl md:text-8xl font-bold tracking-tighter tabular-nums text-[var(--color-foreground)]","format":"@card.format","type":"animated-counter","value":"@card.value"},{"color":"muted","content":"@card.suffix","type":"typography","variant":"h2","weight":"normal"}],"className":"py-section","direction":"horizontal","gap":"xs","justify":"center","type":"stack"},{"showValue":true,"size":"md","type":"trend-indicator","value":"@card.trend"}],"className":"relative z-10 w-full max-w-2xl mx-auto text-center","direction":"vertical","gap":"md","type":"stack"},{"className":"absolute inset-x-0 bottom-0 w-full opacity-10 pointer-events-none","color":"auto","data":"@card.sparklineData","fill":true,"height":96,"strokeWidth":1,"type":"sparkline"}],"look":"elevated","padding":"lg","type":"card"}],"className":"relative w-full rounded-xl shadow-lg overflow-hidden","direction":"vertical","gap":"none","type":"stack"}],"type":"data-list"}],"data-theme":"@config.theme","type":"box"} @label "Hero metric body content tree" @description "Render-ui SExpr for statsLook='hero-metric' — one elevated card, one oversize number, background sparkline." @tier "internal"
    kpiTilesBodyContent : render-ui = {"children":[{"className":"w-full","entity":"@entity.cards","fields":[],"gap":"lg","minCardWidth":220,"renderItem":["fn","card",{"children":[{"align":"center","children":[{"className":"uppercase tracking-wide","color":"muted","content":"@card.label","type":"typography","variant":"caption","weight":"medium"},{"color":"muted","name":"@card.icon","size":"sm","type":"icon"}],"direction":"horizontal","gap":"xs","justify":"between","type":"stack"},{"align":"baseline","children":[{"color":"muted","content":"@card.prefix","type":"typography","variant":"caption"},{"className":"text-4xl font-bold tracking-tight","format":"@card.format","type":"animated-counter","value":"@card.value"},{"color":"muted","content":"@card.suffix","type":"typography","variant":"caption"}],"direction":"horizontal","gap":"xs","type":"stack"},{"align":"center","children":[{"showValue":true,"size":"sm","type":"trend-indicator","value":"@card.trend"},{"className":"flex-1","color":"auto","data":"@card.sparklineData","fill":true,"height":24,"type":"sparkline"}],"direction":"horizontal","gap":"sm","type":"stack"}],"className":"rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-card-lg shadow-elevation-sm hover:shadow-elevation-md transition-shadow","direction":"vertical","gap":"sm","type":"stack"}],"type":"data-grid"}],"data-theme":"@config.theme","type":"box"} @label "KPI tiles body content tree" @description "Render-ui SExpr for statsLook='kpi-tiles' — Stripe-dashboard style tile grid: huge typography number, label, trend indicator, sparkline hint." @tier "internal"
    metrics        : [MetricSpec] = [{"aggregation":"count","format":"number","icon":"list","label":"Total Items","sparklineData":[2,4,3,6,5,8,7],"variant":"primary"},{"aggregation":"count","format":"number","icon":"check-circle","label":"Active","sparklineData":[1,3,2,4,6,5,7],"variant":"success"},{"aggregation":"avg","field":"value","format":"number","icon":"trending-up","label":"Avg Value","sparklineData":[5,4,6,3,5,7,6],"variant":"info"}] @label "Metrics" @description "One stat card per entry; declares aggregation, format, and styling" @synonyms "list of KPI cards / stat tiles / metric cards. each entry has label / value / format / icon / variant / aggregation. user phrases: 'replace metrics with X, Y, Z' -> rewrite array; 'add Revenue tile' -> append entry; 'change KPIs to X' -> rewrite array" @tier "presentation"
    sparklineRowBodyContent : render-ui = {"children":[{"className":"w-full","entity":"@entity.cards","fields":[],"gap":"md","minCardWidth":260,"renderItem":["fn","card",{"children":[{"align":"center","children":[{"color":"muted","name":"@card.icon","size":"xs","type":"icon"},{"className":"uppercase tracking-wide truncate","color":"muted","content":"@card.label","type":"typography","variant":"overline","weight":"semibold"}],"direction":"horizontal","gap":"xs","type":"stack"},{"className":"w-full","color":"auto","data":"@card.sparklineData","fill":true,"height":64,"strokeWidth":2,"type":"sparkline"},{"align":"baseline","children":[{"align":"baseline","children":[{"color":"muted","content":"@card.prefix","type":"typography","variant":"caption"},{"className":"text-2xl font-semibold tabular-nums","format":"@card.format","type":"animated-counter","value":"@card.value"},{"color":"muted","content":"@card.suffix","type":"typography","variant":"caption"}],"direction":"horizontal","gap":"xs","type":"stack"},{"showValue":true,"size":"sm","type":"trend-indicator","value":"@card.trend"}],"direction":"horizontal","gap":"sm","justify":"between","type":"stack"}],"className":"rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] p-card-md shadow-elevation-sm hover:shadow-elevation-md transition-shadow min-h-[180px]","direction":"vertical","gap":"sm","type":"stack"}],"type":"data-grid"}],"data-theme":"@config.theme","type":"box"} @label "Sparkline row body content tree" @description "Render-ui SExpr for statsLook='sparkline-row' — chart-first tiles where the mini trend line is the visual centerpiece, label above, value+delta footer." @tier "internal"
    statLook       : string = "elevated" @label "Stat display look" @description "Layer 2 visual treatment for stat / KPI cards." @tier "presentation" @values (elevated flat progress-backed gauge sparkline)
    statsLook      : string = "cards" @label "Stats look" @description "Layer 3 body layout: default per-metric stat-card grid ('cards'), Stripe-dashboard KPI tile row ('kpi-tiles'), single oversize hero number ('hero-metric'), or chart-first sparkline tile grid ('sparkline-row')." @tier "presentation" @values (cards kpi-tiles hero-metric sparkline-row)
    theme          : string = "" @label "Theme" @description "Data-theme skin applied to the stat body root — for chrome-less pages composed without an AppShell." @tier "presentation"
    title          : string = "Summary" @label "Section title" @description "Heading shown above the stat-card grid" @synonyms "the section header text. user phrases: 'rename section to X' / 'title the KPIs X' / 'change section title to X' -> X" @tier "presentation"
    viewPattern    : pattern = "data-grid" @label "Render pattern" @description "UI pattern used to arrange the stat cards" @synonyms "internal pattern selector. user prompts rarely target this directly" @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-stats.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-status-lifecycle.orb orbitals[0].traits[0])
trait std-status-lifecycle.traits.StatusMachine {
  alias          : StatusLifecycle
  linkedEntity   : StatusRecord
  category       : lifecycle
  states         : (idle*)
  events         : (ChangeStatusRequested StatusPersisted StatusChangeFailed StatusChanged)
  transitions    : ((idle -> idle on ChangeStatusRequested) (idle -> idle on StatusPersisted) (idle -> idle on StatusChangeFailed))
  emits          : (StatusChanged StatusPersisted StatusChangeFailed)
  config {
    enabled        : boolean = false @label "Enforce status lifecycle rules?" @description "Validate and apply status transitions against the configured table. Off by default." @synonyms "lifecycle, statuses, states, stages, workflow, status transitions, enforce, enable, apply" @tier "infra"
    initialStatus  : string = "draft" @label "What status do new records start in?" @description "The status assigned when a record is first created." @synonyms "starting state, default status, first stage, initial state" @tier "domain"
    states         : [string] = ["draft","active","archived"] @label "What are the possible statuses?" @description "The complete set of statuses a record can hold." @synonyms "states, stages, phases, statuses, lifecycle, workflow steps" @tier "domain"
    statusField    : string = "status" @label "Which field holds the status?" @description "Entity field this lifecycle drives (e.g. 'status', 'state', 'stage', 'phase')." @synonyms "state field, stage field, status column, lifecycle field" @tier "infra"
    targetEntity   : entity = "StatusRecord" @label "Target entity" @description "Entity name whose status field this lifecycle drives (e.g. 'Contract'). Rebind per composition. Typed `entity`, so a rename of the bound entity threads through to this value automatically." @tier "internal"
    transitions    : [TransitionSpec] = [{"event":"ACTIVATE","from":"draft","label":"Activate","to":"active"},{"event":"ARCHIVE","from":"active","label":"Archive","to":"archived"}] @label "Which status moves are allowed?" @description "Legal transitions as { from, to, event, label }. Only matching moves are applied." @synonyms "edges, allowed moves, status flow, workflow transitions" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-status-lifecycle.orb orbitals[0].traits[0])"
}

