  emits          : (OPEN_HOURS CLOSE_VIEW INVOICE_HOURS WRITE_OFF_HOURS BillableHourLoaded BillableHourLoadFailed)
  config {
    columns        : [ColumnSpec] = [{"align":"left","field":"workerName","header":"Worker","key":"workerName","width":"minmax(8rem, 1fr)"},{"align":"left","field":"matterId","header":"Matter","key":"matterId","width":"8rem"},{"align":"left","field":"workDate","format":"date","header":"Date","key":"workDate","width":"8rem"},{"align":"right","field":"hours","format":"number","header":"Hours","key":"hours","width":"6rem"},{"align":"right","field":"rate","format":"currency","header":"Rate","key":"rate","width":"7rem"},{"align":"center","field":"invoiceStatus","format":"badge","header":"Status","key":"invoiceStatus","width":"8rem"}] @label "Table columns" @description "ColumnSpec list for the dense hours ledger table." @tier "presentation"
    itemActions    : [ItemAction] = [{"event":"OPEN_HOURS","icon":"arrow-right","label":"Open","variant":"ghost"},{"event":"WRITE_OFF_HOURS","label":"Write Off","variant":"danger"}] @label "Row actions" @description "Per-row actions rendered by the hours table." @tier "presentation"
    statLook       : string = "elevated" @label "Stat display look" @description "Layer 2 visual treatment for stat / KPI cards." @tier "presentation" @values (elevated flat progress-backed gauge sparkline)
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless bordered)
    title          : string = "Time Entries" @label "Section title" @description "Heading shown above the time-entries list" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
