  events         : (INIT CLASSIFY CLASSIFIED_RAW CLASSIFY_CALL_FAILED RESET CLASSIFIED CLASSIFY_FAILED)
  transitions    : ((idle -> idle on INIT) (idle -> classifying on CLASSIFY) (classifying -> done on CLASSIFIED_RAW) (classifying -> done on CLASSIFY_CALL_FAILED) (done -> done on INIT) (done -> idle on RESET))
  emits          : (CLASSIFIED_RAW CLASSIFY_CALL_FAILED CLASSIFIED CLASSIFY_FAILED)
  config {
    categories     : [string] = [] @label "Categories" @description "Closed set of category labels the LLM must choose from" @tier "domain"
    model          : string = "" @label "Model" @description "Model override forwarded to the classify call" @tier "infra"
    provider       : string = "" @label "Provider" @description "Reserved for provider selection; LLMServiceActions.classify (packages/almadar-llm/src/contracts.ts) takes no provider param today, so this knob is not forwarded to the call" @tier "infra"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
