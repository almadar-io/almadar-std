    cancelIcon     : Asset = {} @label "Cancel Icon" @description "Icon asset for the Cancel button." @tier "presentation"
    crewCount      : number = 3 @label "Crew Count" @description "Initial HUD crew-count display value. Cosmetic only: the source board never changes it after INIT." @tier "domain"
    crewIcon       : Asset = {} @label "Crew Icon" @description "Icon asset for the Crew HUD stat." @tier "presentation"
