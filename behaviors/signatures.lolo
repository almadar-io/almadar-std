;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-code-block.orb orbitals[0].traits[0])
trait ui-code-block.traits.CodeBlockRender {
  alias          : UiCodeBlock
  linkedEntity   : CodeBlockItem
  category       : interaction
  states         : (idle*)
  events         : (INIT CHANGE EDITOR_FOCUS EDITOR_BLUR MOTION OPERATE INSERT_TEXT SET_MODE @config.onChange @config.onEditorFocus @config.onEditorBlur)
  transitions    : ((idle -> idle on INIT) (idle -> idle on CHANGE) (idle -> idle on EDITOR_FOCUS) (idle -> idle on EDITOR_BLUR) (idle -> idle on MOTION) (idle -> idle on OPERATE) (idle -> idle on INSERT_TEXT) (idle -> idle on SET_MODE))
  emits          : (@config.onChange @config.onEditorFocus @config.onEditorBlur)
  config {
    actions        : [CodeBlockActionsItem] = [] @label "Actions" @description "Action badges in the toolbar" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    code           : string @label "Code" @description "The code content to display" @tier "presentation"
    diff           : [CodeBlockDiffItem] = [] @label "Diff" @description "Pre-computed diff lines" @tier "presentation"
    editable       : boolean = false @label "Editable" @description "When true, render an editable surface that composes a transparent `Textarea` over a Prism-highlighted overlay. The overlay re-tokenizes on each keystroke (driven from a local mirror of the textarea value), so users see syntax-highlighted code while still being able to type. Folding is skipped in editable mode. History: GAP-51 first-cut shipped plain (no-highlighting) editable text; GAP-77 (2026-04-12) added the Prism overlay layer. Default: false (existing read-only behavior unchanged)." @tier "presentation"
    editorId       : string @label "Editor Id" @description "Stable identity for the keyboard router / plugin host to target this editor. Unset = this instance never receives capability events." @tier "presentation"
    error          : CodeBlockError @label "Error" @description "Error state" @tier "presentation"
    files          : [CodeBlockFilesItem] = [] @label "Files" @description "Multiple files shown as tabs" @tier "presentation"
    foldable       : boolean @label "Foldable" @description "Enable brace-based code folding of multi-line `{}`/`[]` blocks (default: true)." @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    language       : string = "text" @label "Language" @description "Programming language for syntax highlighting (any Prism id; loaded on demand if not pre-registered)" @tier "presentation"
    maxHeight      : scalar = "60vh" @label "Max Height" @description "Maximum height before scrolling" @tier "presentation"
    mode           : string = "code" @label "Mode" @description "Diff or plain-code display mode" @tier "presentation" @values (code diff)
    motions        : [string] = ["left","right","up","down","word-forward","word-back","word-end","line-start","line-end","first-nonblank","doc-start","doc-end","paragraph-forward","paragraph-back","line","selection","match-bracket"] @label "Motions" @description "Motion vocabulary this editor accepts. Default: the full `EditorMotion` set." @tier "presentation"
    newValue       : string @label "New Value" @description "New source text — generates diff when combined with oldValue" @tier "presentation"
    oldValue       : string @label "Old Value" @description "Old source text — generates diff when combined with newValue" @tier "presentation"
    onChange       : event = "CHANGE" @label "On Change" @description "GAP-51: called with the new code on every keystroke when `editable === true`. Consumers should debounce + parse downstream — `CodeBlock` does not." @tier "presentation"
    onEditorBlur   : event = "EDITOR_BLUR" @label "On Editor Blur" @description "Declarative bus emit fired when this editor loses focus." @tier "presentation"
    onEditorFocus  : event = "EDITOR_FOCUS" @label "On Editor Focus" @description "Declarative bus emit fired when this editor gains focus." @tier "presentation"
    onInsertText   : event = "INSERT_TEXT" @label "On Insert Text" @description "Declarative bus listen: insert literal text at the cursor." @tier "presentation"
    onMotion       : event = "MOTION" @label "On Motion" @description "Declarative bus listen: move the cursor per the vim-style motion vocabulary." @tier "presentation"
    onOperate      : event = "OPERATE" @label "On Operate" @description "Declarative bus listen: apply a text operator over a motion's range." @tier "presentation"
    onSetMode      : event = "SET_MODE" @label "On Set Mode" @description "Declarative bus listen: switch editor mode and caret style." @tier "presentation"
    operators      : [string] = ["delete","yank","change","put","put-before","undo","redo","join","toggle-case","indent","dedent","replace"] @label "Operators" @description "Operator vocabulary this editor accepts. Default: the full `EditorOperator` set." @tier "presentation"
    showCopy       : boolean @label "Show Copy" @description "Show copy button (viewer alias for showCopyButton)" @tier "presentation"
    showCopyButton : boolean = true @label "Show Copy Button" @description "Show the copy button" @tier "presentation"
    showLanguageBadge : boolean = true @label "Show Language Badge" @description "Show the language badge" @tier "presentation"
    showLineNumbers : boolean = false @label "Show Line Numbers" @description "Show line numbers in code / diff mode" @tier "presentation"
    title          : string @label "Title" @description "── Viewer props (absorbed from CodeViewer / DocCodeBlock) ────────────────" @tier "presentation"
    wordWrap       : boolean = false @label "Word Wrap" @description "Enable word-wrap in code / diff mode" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-code-block.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-command-palette.orb orbitals[0].traits[0])
trait ui-command-palette.traits.CommandPaletteRender {
  alias          : UiCommandPalette
  linkedEntity   : CommandPaletteItem
  category       : interaction
  states         : (idle*)
  events         : (INIT OPEN_CHANGE @config.onOpenChange @config.onSelect)
  transitions    : ((idle -> idle on INIT) (idle -> idle on OPEN_CHANGE))
  emits          : (@config.onOpenChange @config.onSelect)
  config {
    className      : string @label "Class Name" @description "Additional CSS classes on the overlay's dialog" @tier "presentation"
    commands       : [CommandPaletteCommandsItem] = [] @label "Commands" @description "Commands listed in the palette, filtered as the user types" @tier "presentation"
    emptyLabel     : string = "No matching commands" @label "Empty Label" @description "Label shown when no command matches the query" @tier "presentation"
    onOpenChange   : event = "OPEN_CHANGE" @label "On Open Change" @description "Called to open/close the overlay (Escape, overlay click, or a selection)" @tier "presentation"
    onSelect       : event = "SELECT" @label "On Select" @description "Called with the selected command (click, or Enter on the highlighted row)" @tier "presentation"
    open           : boolean = false @label "Open" @description "Whether the palette overlay is open" @tier "presentation"
    placeholder    : string = "Type a command..." @label "Placeholder" @description "Search field placeholder. Consumers own i18n — plain string prop, no package-internal translation (matches FloatingToolbar's convention)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-command-palette.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-confirm-dialog.orb orbitals[0].traits[0])
trait ui-confirm-dialog.traits.ConfirmDialogRender {
  alias          : UiConfirmDialog
  linkedEntity   : ConfirmDialogItem
  category       : interaction
  states         : (closed* open)
  events         : (INIT OPEN CLOSE @config.onClose @config.onConfirm)
  transitions    : ((closed -> closed on INIT) (closed -> open on OPEN) (open -> closed on CLOSE))
  emits          : (@config.onClose @config.onConfirm OPEN)
  config {
    cancelLabel    : string @label "Cancel Label" @description "Alias for cancelText (schema compatibility)" @tier "presentation"
    cancelText     : string @label "Cancel Text" @description "Cancel button text" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    confirmLabel   : string @label "Confirm Label" @description "Alias for confirmText (schema compatibility)" @tier "presentation"
    confirmText    : string @label "Confirm Text" @description "Confirm button text" @tier "presentation"
    description    : node @label "Description" @description "Alias for message (schema compatibility)" @tier "presentation"
    error          : ConfirmDialogError @label "Error" @description "Error state" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state for confirm button" @tier "presentation"
    isOpen         : boolean = true @label "Is Open" @description "Whether the dialog is open (defaults to true when rendered by slot wrapper)" @tier "presentation"
    message        : node @label "Message" @description "Dialog message/description" @tier "presentation"
    onClose        : event = "CLOSE" @label "On Close" @description "Callback when dialog is closed (injected by slot wrapper)" @tier "presentation"
    onConfirm      : event = "CONFIRM" @label "On Confirm" @description "Callback when action is confirmed (injected by slot wrapper)" @tier "presentation"
    size           : string = "sm" @label "Size" @description "Dialog size" @tier "presentation" @values (sm md lg xl full)
    title          : string = "" @label "Title" @description "Dialog title" @tier "presentation"
    variant        : string = "danger" @label "Variant" @description "Dialog variant" @tier "presentation" @values (danger warning info default)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-confirm-dialog.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-connection-block.orb orbitals[0].traits[0])
trait ui-connection-block.traits.ConnectionBlockRender {
