;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-trait-slot.orb orbitals[0].traits[0])
trait ui-trait-slot.traits.TraitSlotRender {
  alias          : UiTraitSlot
  linkedEntity   : TraitSlotItem
  category       : interaction
  states         : (idle*)
  events         : (INIT CLICK DROP @config.onItemDrop @config.onDragStart @config.onClick @config.dropEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on CLICK) (idle -> idle on DROP))
  emits          : (@config.onItemDrop @config.onDragStart @config.onClick @config.dropEvent)
  config {
    categoryColors : Map<string,TraitSlotCategoryColorsValue> = {} @label "Category Colors" @description "Category → color mapping" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    clickEvent     : event = "CLICK" @label "Click Event" @description "-- Declarative events --" @tier "presentation"
    draggable      : boolean = false @label "Draggable" @description "Whether this slot's equipped item is draggable" @tier "presentation"
    dropEvent      : event = "DROP" @label "Drop Event" @description "Emits UI:{dropEvent} with { slotNumber, itemId } when an item is dropped into this slot" @tier "presentation"
    equippedItem   : TraitSlotEquippedItem @label "Equipped Item" @description "Currently equipped item, if any" @tier "presentation"
    error          : TraitSlotError @label "Error" @description "Error state" @tier "presentation"
    feedback       : string = "correct" @label "Feedback" @description "Per-slot correctness feedback after a failed attempt" @tier "presentation" @values (correct wrong)
    isLoading      : boolean @label "Is Loading" @description "Loading state" @tier "presentation"
    locked         : boolean = false @label "Locked" @description "Whether slot is locked" @tier "presentation"
    lockLabel      : string @label "Lock Label" @description "Label shown when locked" @tier "presentation"
    onClick        : event = "CLICK" @label "On Click" @description "-- Callbacks --" @tier "presentation"
    onDragStart    : event = "DRAG_START" @label "On Drag Start" @description "Called when drag starts from this slot" @tier "presentation"
    onItemDrop     : event = "ITEM_DROP" @label "On Item Drop" @description "-- Drag and drop --" @tier "presentation"
    onRemove       : event = "" @label "On Remove" @description "Remove handler" @tier "presentation"
    removeEvent    : event = "" @label "Remove Event" @description "Emits UI:{removeEvent} with { slotNumber }" @tier "presentation"
    selected       : boolean = false @label "Selected" @description "Whether slot is selected" @tier "presentation"
    showTooltip    : boolean = true @label "Show Tooltip" @description "Show tooltip on hover" @tier "presentation"
    size           : string = "md" @label "Size" @description "Size variant" @tier "presentation" @values (sm md lg)
    slotNumber     : number = 1 @label "Slot Number" @description "Slot index (1-based)" @tier "presentation"
    tooltipFrameUrl : TraitSlotTooltipFrameUrl @label "Tooltip Frame Url" @description "Optional tooltip frame image asset" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-trait-slot.orb orbitals[0].traits[0])"
}

