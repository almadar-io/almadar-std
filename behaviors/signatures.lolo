    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    items          : [CarouselItemsItem] = [{"id":"Id","image":"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png","title":"Title"},{"id":"Id 2","image":"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png","title":"Title 2"}] @label "Items" @description "Array of items to display as slides" @tier "presentation"
    loop           : boolean = false @label "Loop" @description "Enable infinite loop" @tier "presentation"
    showArrows     : boolean = true @label "Show Arrows" @description "Show prev/next arrow buttons" @tier "presentation"
    showDots       : boolean = true @label "Show Dots" @description "Show dot indicators" @tier "presentation"
    slideChangeEvent : event = "SLIDE_CHANGE" @label "Slide Change Event" @description "Declarative event name for slide change" @tier "presentation"
    slideChangePayload : @payload(slideChangeEvent) @label "Slide Change Payload" @description "Payload to include with the slide change event" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
