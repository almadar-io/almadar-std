    isOpen         : boolean = false @label "Is Open" @description "Whether the lightbox is open" @tier "presentation"
    onClose        : event = "CLOSE" @label "On Close" @description "Direct onClose callback" @tier "presentation"
    onIndexChange  : event = "INDEX_CHANGE" @label "On Index Change" @description "Direct onIndexChange callback" @tier "presentation"
    showCounter    : boolean = true @label "Show Counter" @description "Show image counter (e.g., '3 of 12')" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-lightbox.orb orbitals[0].traits[0])"
}

