;; From @almadar/std (behaviors/registry/ui/core/atoms/std-event-log.orb orbitals[0].traits[0])
trait std-event-log.traits.EventLogTimeline {
  alias          : EventLog
  linkedEntity   : EventLogView
  category       : interaction
  states         : (loading* viewing backfilling error)
  events         : (INIT EventLogLoaded EventLogLoadFailed EventLogSaved EventLogSaveFailed APPLY_FILTER REFETCH_QUERY REFETCH_FILTER REFETCH_PAGE OPEN_BACKFILL SAVE_BACKFILL CANCEL_BACKFILL)
  transitions    : ((loading -> loading on INIT) (loading -> viewing on EventLogLoaded) (loading -> error on EventLogLoadFailed) (loading -> loading on EventLogSaved) (loading -> error on EventLogSaveFailed) (viewing -> loading on INIT) (viewing -> viewing on APPLY_FILTER) (viewing -> viewing on REFETCH_QUERY) (viewing -> viewing on REFETCH_FILTER) (viewing -> viewing on REFETCH_PAGE) (viewing -> viewing on EventLogLoadFailed) (viewing -> viewing on EventLogLoaded) (viewing -> backfilling on OPEN_BACKFILL) (backfilling -> loading on SAVE_BACKFILL) (backfilling -> viewing on CANCEL_BACKFILL) (error -> loading on INIT))
  emits          : (APPLY_FILTER OPEN_BACKFILL SAVE_BACKFILL CANCEL_BACKFILL EventLogLoaded EventLogLoadFailed EventLogSaved EventLogSaveFailed)
  config {
    bodySearch     : boolean = false @label "Show the log's own search box?" @description "Embeds a search box above the activity feed. Set true only when the page has no other search affordance (e.g. no page-level std-search), so the surface shows one search box instead of two. False is the default — no consumer of this atom has ever had a search box." @synonyms "inline search, log search, built-in search, show search" @tier "presentation"
    cardLook       : string = "elevated" @label "Card look" @description "Layer 2 visual treatment for cards rendered by this atom." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    displayPageSize : number = 20 @label "How many entries per page should a pager show?" @description "Page size a consumer-composed std-pagination control should use to compute total pages (e.g. from totalCount). This atom's own timeline pattern has no built-in pager UI, so this knob is informational for the composed control, not consumed by the timeline itself." @synonyms "visible rows, items per page, display limit" @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the feed?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the timeline; each selection fires REFETCH_FILTER on this trait, ANDed with the current kind tab. Empty (the default) = no filter bar — the right setting whenever the page already composes std-filter beside this atom and routes XFilter.FILTER -> REFETCH_FILTER, or relies solely on the built-in kind-filter chips (driven by kindOptions, which this knob does not duplicate or replace). Use this knob only for an extra facet beyond kind (e.g. actor, priority)." @synonyms "filter bar, faceted filters, field filters, dropdowns" @tier "presentation"
    formFields     : [string] = ["backfillTitle","backfillDescription","backfillKind","backfillDate"] @label "Backfill fields" @description "Inputs shown in the form for manually logging missed events" @tier "presentation"
    kindOptions    : [KindOption] = [{"icon":"plus-circle","key":"created","label":"Created","status":"active"},{"icon":"edit-3","key":"updated","label":"Updated","status":"pending"},{"icon":"check-circle","key":"approved","label":"Approved","status":"complete"},{"icon":"x-circle","key":"rejected","label":"Rejected","status":"error"}] @label "Event kinds" @description "Maps each event kind to its label, icon, and status color" @tier "presentation"
    pageSize       : number = 20 @label "How many entries per page when paging?" @description "Records fetched from the server per REFETCH_PAGE request. The initial load and every search/kind/filter refetch stay unpaginated (load everything that matches) so the default unlimited activity feed is unchanged; only an explicit REFETCH_PAGE from a composed std-pagination control applies this limit." @synonyms "fetch limit, records per page, page limit" @tier "presentation"
    searchPlaceholder : string = "Search activity…" @label "Search box placeholder text" @description "Hint text inside the log's search box." @synonyms "search hint, placeholder, search box text" @tier "presentation"
    timelineLook   : string = "vertical-spacious" @label "Timeline look" @description "Layer 2 visual treatment for the timeline." @tier "presentation" @values (vertical-compact vertical-spacious horizontal swimlane)
    title          : string = "Activity" @label "Section title" @description "Heading shown above the activity timeline" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-event-log.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-export.orb orbitals[0].traits[0])
trait std-export.traits.ExportMenu {
  alias          : Export
  linkedEntity   : ExportPanel
  category       : interaction
  states         : (idle*)
  events         : (INIT OPEN_EXPORT EXPORT_REQUESTED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on OPEN_EXPORT) (idle -> idle on EXPORT_REQUESTED))
  emits          : (EXPORT_REQUESTED)
  config {
    buttonLabel    : string = "Export" @label "Button label" @description "Text shown on the toolbar button that opens the export popover" @synonyms "the text on the export trigger button. user phrases: 'rename export button to X' / 'set the button label to X' / 'call the button X' / 'change export button text to X' -> X (e.g. 'Download CSV', 'Download', 'Export Data')" @tier "presentation"
    event          : string = "EXPORT_REQUESTED" @label "Export event" @description "Event emitted when the user picks a format. Each entry in formats[] carries its own literal event field (no per-item templating in .lolo) — overriding this alone does not retarget the click; also set formats[].event to match." @synonyms "bus event name. internal wiring; users rarely target directly" @tier "internal"
    formats        : [FormatOption] = [{"event":"EXPORT_REQUESTED","format":"csv","id":"csv","label":"CSV"},{"event":"EXPORT_REQUESTED","format":"xlsx","id":"xlsx","label":"XLSX"},{"event":"EXPORT_REQUESTED","format":"pdf","id":"pdf","label":"PDF"}] @label "Available formats" @description "Export formats shown to the user in the popover" @synonyms "list of export format entries (csv / xlsx / pdf / png / json). user phrases: 'only CSV' -> keep only csv entry; 'add JSON' -> append json entry; 'no PNG' -> remove png; 'allow X and Y' -> set the array to those two" @tier "presentation"
    tileId         : string = "" @label "Tile id" @description "Identifier of the dashboard tile being exported" @synonyms "internal identifier — host orbital wires this; users rarely set it directly" @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-export.orb orbitals[0].traits[0])"
}

