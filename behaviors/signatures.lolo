;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-content-renderer.orb orbitals[0].traits[0])
trait ui-content-renderer.traits.ContentRendererRender {
  alias          : UiContentRenderer
  linkedEntity   : ContentRendererItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    activeFilters  : Map<string,string> = {} @label "Active Filters" @description "Active filters" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    content        : string @label "Content" @description "Raw content string — auto-parsed into segments" @tier "presentation"
    direction      : string = "rtl" @label "Direction" @description "Text direction for markdown" @tier "presentation" @values (rtl ltr)
    error          : ContentRendererError @label "Error" @description "Error state (UiError)" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    pageProp       : number @label "Page" @description "Current page number" @synonyms "page" @tier "presentation"
    pageSize       : number @label "Page Size" @description "Number of items per page" @tier "presentation"
    searchValue    : string @label "Search Value" @description "Current search query value" @tier "presentation"
    segments       : [ContentRendererSegmentsItem] = [] @label "Segments" @description "Pre-parsed segments (overrides content)" @tier "presentation"
    selectedIds    : [string] = [] @label "Selected Ids" @description "Currently selected item IDs" @tier "presentation"
    sortBy         : string @label "Sort By" @description "Current sort field" @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Current sort direction" @tier "presentation" @values (asc desc)
    totalCount     : number @label "Total Count" @description "Total number of items" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-content-renderer.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-data-grid.orb orbitals[0].traits[0])
trait ui-data-grid.traits.DataGridRender {
  alias          : UiDataGrid
  linkedEntity   : DataGridItem
  category       : interaction
  states         : (idle*)
  events         : (INIT DataGridLoaded @config.selectionEvent @config.loadMoreEvent VIEW)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on DataGridLoaded))
  emits          : (@config.selectionEvent @config.loadMoreEvent VIEW DataGridLoaded)
  config {
    accepts        : string @label "Accepts" @description "When set, the container accepts drops whose dragGroup matches this value (or '*' for any group)" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    cols           : number @label "Cols" @description "Number of columns (uses auto-fit if omitted)" @tier "presentation"
    columns        : [DataGridColumnsItem] = [] @label "Columns" @description "Alias for `fields` — the compiler emits `columns` for field defs." @tier "presentation"
    dndItemIdField : string @label "Dnd Item Id Field" @description "Row field used as the @dnd-kit draggable id (default 'id')" @tier "presentation"
    dndRoot        : boolean @label "Dnd Root" @description "Mark this container as the DnD root for its subtree — descendant zones share one DndContext (cross-container drag). Use on an outer container whose own items are not draggable." @tier "presentation"
    dragGroup      : string @label "Drag Group" @description "When set, items in this container are draggable and announce this group as their source" @tier "presentation"
    dropEvent      : string @label "Drop Event" @description "Bus event fired on cross-container drop. Payload: { id, sourceGroup, targetGroup, newIndex }" @tier "presentation"
    error          : DataGridError @label "Error" @description "Error state" @tier "presentation"
    fields         : [DataGridFieldsItem] = [] @label "Fields" @description "Field definitions for rendering each card. The pattern contract in `@almadar/core/patterns` documents `columns` as the wire-format alias the compiler emits — both names resolve to the same shape here. Pass either." @tier "presentation"
    gap            : string = "md" @label "Gap" @description "Gap between cards" @tier "presentation" @values (none sm md lg xl)
    hasMore        : boolean @label "Has More" @description "Whether more items are available for infinite scroll" @tier "presentation"
    imageField     : string @label "Image Field" @description "Entity field name containing an image URL for card thumbnails" @tier "presentation"
    infiniteScroll : boolean @label "Infinite Scroll" @description "Enable infinite scroll loading" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    itemActions    : [DataGridItemActionsItem] = [] @label "Item Actions" @description "Per-item action buttons" @tier "presentation"
    loadMoreEvent  : event = "LOAD_MORE" @label "Load More Event" @description "Event emitted when more items needed: UI:{loadMoreEvent}" @tier "presentation"
    look           : string = "dense" @label "Look" @description "Layer 2 visual treatment — mirrors the `entity-table` look enum so data-grid / data-list / entity-table share one knob name from authors." @tier "presentation" @values (dense spacious striped borderless card-rows)
    maxInlineActions : number @label "Max Inline Actions" @description "Max inline primary action buttons before the rest collapse into a '⋯' overflow menu. Omit = all inline." @tier "presentation"
    minCardWidth   : number = 280 @label "Min Card Width" @description "Minimum card width in pixels (used when cols is not set, default 280)" @tier "presentation"
    pageSize       : number = 0 @label "Page Size" @description "Max items to show before 'Show More' button. Defaults to 0 (disabled)." @tier "presentation"
    positionEvent  : string @label "Position Event" @description "Bus event fired N times per drop (one per item in affected zones) so the trait can persist new positions for the WHOLE zone, not just the moved item. Payload: { id, position }" @tier "presentation"
    relationsData  : Map<string,[DataGridRelationsDataValueItem]> = {} @label "Relations Data" @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names for a field whose type is relation. Same contract DetailPanel takes." @tier "presentation"
    reorderEvent   : string @label "Reorder Event" @description "Bus event fired on in-container reorder. Payload: { id, oldIndex, newIndex }" @tier "presentation"
    scrollX        : boolean = false @label "Scroll X" @description "Lay items in a single horizontally-scrolling row (kanban columns) sized to `minCardWidth` instead of a wrapping grid." @tier "presentation"
    selectable     : boolean = false @label "Selectable" @description "Enable multi-select with checkboxes" @tier "presentation"
    selectionEvent : event = "SELECTION" @label "Selection Event" @description "Selection change event name (emits UI:{selectionEvent} with { selectedIds: string[] })" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    sortable       : boolean @label "Sortable" @description "Enable in-container reorder; items can be dragged to new positions among siblings" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-data-grid.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-data-list.orb orbitals[0].traits[0])
trait ui-data-list.traits.DataListRender {
  alias          : UiDataList
  linkedEntity   : DataListItem
  category       : interaction
  states         : (idle*)
  events         : (INIT DataListLoaded @config.reorderEvent @config.itemClickEvent @config.swipeLeftEvent @config.swipeRightEvent @config.longPressEvent @config.loadMoreEvent VIEW)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on DataListLoaded))
  emits          : (@config.reorderEvent @config.itemClickEvent @config.swipeLeftEvent @config.swipeRightEvent @config.longPressEvent @config.loadMoreEvent VIEW DataListLoaded)
  config {
    accepts        : string @label "Accepts" @description "When set, the container accepts drops whose dragGroup matches this value (or '*' for any group)" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    columns        : [DataListColumnsItem] = [] @label "Columns" @description "Alias for `fields` — the compiler emits `columns` for field defs." @tier "presentation"
    currentUser    : string @label "Current User" @description "Current user identifier; messages matching this value align right (used with variant: 'message')" @tier "presentation"
    dndItemIdField : string @label "Dnd Item Id Field" @description "Row field used as the @dnd-kit draggable id (default 'id')" @tier "presentation"
    dndRoot        : boolean @label "Dnd Root" @description "Mark this container as the DnD root for its subtree — descendant zones share one DndContext (cross-container drag). Use on an outer container whose own items are not draggable." @tier "presentation"
    dragGroup      : string @label "Drag Group" @description "When set, items in this container are draggable and announce this group as their source" @tier "presentation"
    dropEvent      : string @label "Drop Event" @description "Bus event fired on cross-container drop. Payload: { id, sourceGroup, targetGroup, newIndex }" @tier "presentation"
    emptyMessage   : string @label "Empty Message" @description "Message shown when there are no rows. Falls back to the generic 'no items' translation. `TableView` already exposes this; an agenda or an inbox wants to say what 'empty' means in its own words." @tier "presentation"
    error          : DataListError @label "Error" @description "Error state" @tier "presentation"
    fields         : [DataListFieldsItem] = [] @label "Fields" @description "Field definitions for rendering each row. The pattern contract in `@almadar/core/patterns` documents `columns` as the wire-format alias the compiler emits — both names resolve to the same shape here. Pass either." @tier "presentation"
    gap            : string = "none" @label "Gap" @description "Gap between rows" @tier "presentation" @values (none sm md lg)
    groupBy        : string @label "Group By" @description "Group items by a field value (renders section headers between groups)" @tier "presentation"
    hasMore        : boolean @label "Has More" @description "Whether more items are available for infinite scroll" @tier "presentation"
    infiniteScroll : boolean @label "Infinite Scroll" @description "Enable infinite scroll loading" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    itemActions    : [DataListItemActionsItem] = [] @label "Item Actions" @description "Per-item action buttons" @tier "presentation"
    itemClickEvent : event = "ITEM_CLICK" @label "Item Click Event" @description "When set, the whole row is clickable and emits UI:{itemClickEvent} with { id, row } (action-button clicks stopPropagation so they still win)." @tier "presentation"
    loadMoreEvent  : event = "LOAD_MORE" @label "Load More Event" @description "Event emitted when more items needed: UI:{loadMoreEvent}" @tier "presentation"
    longPressEvent : event = "LONG_PRESS" @label "Long Press Event" @description "Event emitted on long press: UI:{longPressEvent} with { row }" @tier "presentation"
    look           : string = "dense" @label "Look" @description "Layer 2 visual treatment — mirrors the `entity-table` look enum so data-grid / data-list / entity-table share one knob name from authors." @tier "presentation" @values (dense spacious striped borderless card-rows)
    maxInlineActions : number @label "Max Inline Actions" @description "Max inline action buttons before the rest collapse into a '⋯' overflow menu. Omit = all inline." @tier "presentation"
    pageSize       : number = 5 @label "Page Size" @description "Max items to show before 'Show More' button. Defaults to 5. Set to 0 to disable." @tier "presentation"
    positionEvent  : string @label "Position Event" @description "Bus event fired N times per drop (one per item in affected zones) so the trait can persist new positions for the WHOLE zone, not just the moved item. Payload: { id, position }" @tier "presentation"
    relationsData  : Map<string,[DataListRelationsDataValueItem]> = {} @label "Relations Data" @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names for a field whose type is relation. Same contract DetailPanel takes." @tier "presentation"
    reorderable    : boolean @label "Reorderable" @description "Enable drag-to-reorder with grip handles" @tier "presentation"
    reorderEvent   : event = "REORDER" @label "Reorder Event" @description "Event emitted on reorder: UI:{reorderEvent} with { fromIndex, toIndex }" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    senderField    : string @label "Sender Field" @description "Field name identifying the sender (used with variant: 'message')" @tier "presentation"
    senderLabelField : string @label "Sender Label Field" @description "Field holding the sender's human-readable name (used with variant: 'message'). Defaults to `senderField`. Set this when `senderField` holds an id — an id-keyed thread otherwise labels bubbles `staff-1` instead of `Sam Staff`." @tier "presentation"
    sortable       : boolean @label "Sortable" @description "Enable in-container reorder; items can be dragged to new positions among siblings" @tier "presentation"
    sortBy         : string @label "Sort By" @description "Field name to order rows by. Values are compared by their own type — numbers numerically, date-like strings chronologically, everything else alphabetically — never by what the field is called. Empty cells sort last. Unset leaves the incoming order untouched. Orders only the rows already fetched: a collection larger than its `limit` still needs ordering at the data layer." @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Direction for `sortBy`. Defaults to ascending." @tier "presentation" @values (asc desc)
    swipeLeftActions : [DataListSwipeLeftActionsItem] = [] @label "Swipe Left Actions" @description "Actions revealed on left swipe" @tier "presentation"
    swipeLeftEvent : event = "SWIPE_LEFT" @label "Swipe Left Event" @description "Event emitted on left swipe: UI:{swipeLeftEvent} with { row }" @tier "presentation"
    swipeRightActions : [DataListSwipeRightActionsItem] = [] @label "Swipe Right Actions" @description "Actions revealed on right swipe" @tier "presentation"
    swipeRightEvent : event = "SWIPE_RIGHT" @label "Swipe Right Event" @description "Event emitted on right swipe: UI:{swipeRightEvent} with { row }" @tier "presentation"
    variant        : string = "default" @label "Variant" @description "Visual variant" @tier "presentation" @values (default card compact message)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-data-list.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-date-range-picker.orb orbitals[0].traits[0])
trait ui-date-range-picker.traits.DateRangePickerRender {
  alias          : UiDateRangePicker
  linkedEntity   : DateRangePickerItem
  category       : interaction
  states         : (idle*)
  events         : (INIT EVENT @config.event @config.onChange)
  transitions    : ((idle -> idle on INIT) (idle -> idle on EVENT))
  emits          : (@config.event @config.onChange)
  config {
    className      : string @label "Class Name" @description "Additional CSS classes." @tier "presentation"
    event          : event = "EVENT" @label "Event" @description "Event name emitted as `UI:{event}` with payload `{ from, to }`. Optional — when omitted, only the `onChange` callback fires." @tier "presentation"
    fromLabel      : string = "From" @label "From Label" @description "From-input label." @tier "presentation"
    fromProp       : string @label "From" @description "Controlled `from` (ISO date YYYY-MM-DD)." @synonyms "from" @tier "presentation"
    onChange       : event = "CHANGE" @label "On Change" @description "Callback fired alongside the bus emit." @tier "presentation"
    presets        : [DateRangePickerPresetsItem] = [] @label "Presets" @description "Preset shortcuts. Defaults to the standard finance set (Last 7d / Last 30d / This Month / This Quarter / YTD). Pass an empty array to hide presets entirely." @tier "presentation"
    toLabel        : string = "To" @label "To Label" @description "To-input label." @tier "presentation"
    toProp         : string @label "To" @description "Controlled `to` (ISO date YYYY-MM-DD)." @synonyms "to" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-date-range-picker.orb orbitals[0].traits[0])"
}

