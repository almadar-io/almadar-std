  events         : (INIT BODY_MOVED RESTART)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on RESTART))
  config {
    regions        : [CurveFogRegion] = [] @label "Fog Regions" @description "One row per fogged world span: x-range (x0..x1) and lookAhead — how far past the player the road stays revealed while inside. Small values force prediction (blowups), large values suit slow tail lessons. Empty list = no fog anywhere." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED tracks the reveal horizon; toggle to freeze the fog where it is." @tier "domain"
