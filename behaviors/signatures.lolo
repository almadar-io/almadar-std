    currentState   : string @label "Current State" @description "State highlighted as current (test playback / initial)." @tier "presentation"
    height         : number = 400 @label "Height" @description "Graph canvas height." @tier "presentation"
    initialState   : string @label "Initial State" @description "The machine's initial state (ring-marked)." @tier "presentation"
    nodeClickEvent : event = "NODE_CLICK" @label "Node Click Event" @description "Emits UI:{nodeClickEvent} with { stateId } when a node is clicked." @tier "presentation"
    selectedState  : string @label "Selected State" @description "State the player has selected (first click)." @tier "presentation"
    states         : [string] = ["Item","Item 2"] @label "States" @description "All states in the machine (node labels)." @tier "presentation"
    transitions    : [StateGraphTransitionsItem] = [] @label "Transitions" @description "Player-built transitions rendered as arrows." @tier "presentation"
    width          : number = 500 @label "Width" @description "Graph canvas width." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-state-graph.orb orbitals[0].traits[0])"
}

