    feedbackTrait  : trait @label "Feedback trait" @description "Trait that provides visual, audio, or narrative feedback. Usually a rebinding of std-fx-particles, std-fx-narrative, std-tutorial-overlay, std-audio-cue, or std-zone-card." @tier "domain"
    goalTrait      : trait @label "Goal trait" @description "Trait that resolves the win condition. Usually a rebinding of std-objective-flow or std-objective-reach." @tier "domain"
    hudBackgroundAsset : Asset = {} @label "HUD Background Asset" @description "HUD panel background sprite (theme chrome)." @tier "presentation"
    rewardTrait    : trait @label "Reward trait" @description "Trait that provides collectibles or scoring. Usually a rebinding of std-pickup, std-score, std-xp, or std-gold." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/organisms/std-platformer-puzzle.orb orbitals[0].traits[1])"
