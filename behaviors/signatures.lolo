    running        : boolean = true @label "Running" @description "When true, hero steps onto resource nodes are gathered; toggle to freeze" @tier "domain"
    startStone     : number = 0 @label "Start Stone" @description "Stone set on INIT" @tier "domain"
    startWood      : number = 0 @label "Start Wood" @description "Wood set on INIT" @tier "domain"
    stoneType      : string = "rock" @label "Stone Type" @description "Feature type counted as a stone resource node" @tier "domain"
    woodType       : string = "tree" @label "Wood Type" @description "Feature type counted as a wood resource node" @tier "domain"
    yieldPerNode   : number = 1 @label "Yield Per Node" @description "Wood or stone gained per node gathered" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-gather.orb orbitals[0].traits[0])"
