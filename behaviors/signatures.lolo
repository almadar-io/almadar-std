;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-side-panel.orb orbitals[0].traits[0])
trait ui-side-panel.traits.SidePanelRender {
  alias          : UiSidePanel
  linkedEntity   : SidePanelItem
  category       : interaction
  states         : (closed* open)
  events         : (INIT OPEN CLOSE @config.onClose)
  transitions    : ((closed -> closed on INIT) (closed -> open on OPEN) (open -> closed on CLOSE))
  emits          : (@config.onClose OPEN)
  config {
    children       : node @label "Children" @description "Panel content" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    closeEvent     : event = "CLOSE" @label "Close Event" @description "Declarative close event — emits UI:{closeEvent} via eventBus when panel should close" @tier "presentation"
    isOpen         : boolean = false @label "Is Open" @description "Is panel open" @tier "presentation"
    onClose        : event = "CLOSE" @label "On Close" @description "On close handler" @tier "presentation"
    position       : string = "right" @label "Position" @description "Panel position" @tier "presentation" @values (left right)
    showOverlay    : boolean = true @label "Show Overlay" @description "Show overlay on mobile" @tier "presentation"
    title          : string = "" @label "Title" @description "Panel title" @tier "presentation"
    width          : string = "w-full sm:w-96" @label "Width" @description "Panel width as Tailwind class string. Default fills the viewport on mobile and snaps to `w-96` (384 px) at `sm:` and above so phones don't lose content to a fixed 384 px column. Consumers passing a custom value should include a `w-full` mobile fallback in the same string (e.g. `'w-full sm:w-[480px]'`) — Tailwind's JIT can't see dynamically-concatenated class names." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-side-panel.orb orbitals[0].traits[0])"
}

