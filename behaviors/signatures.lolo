trait ui-avatar.traits.AvatarRender {
  alias          : UiAvatar
  linkedEntity   : AvatarItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onClick @config.action)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onClick @config.action)
  config {
    action         : event = "ACTION" @label "Action" @description "Declarative event name — emits UI:{action} via eventBus on click" @tier "presentation"
    actionPayload  : @payload(action) @label "Action Payload" @description "Payload to include with the action event" @tier "presentation"
    alt            : string @label "Alt" @description "Alt text for the image" @tier "presentation"
    badge          : scalar @label "Badge" @description "Badge content (e.g., notification count)" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    icon           : icon @label "Icon" @description "Icon to display when no image or initials. Accepts a Lucide component directly, or a canonical kebab-case icon name string (resolved via `resolveIcon`) so trait/factory authors can pass an icon by name." @tier "presentation"
    initials       : string @label "Initials" @description "Initials to display (e.g., 'JD' for John Doe) If not provided but name is, initials will be auto-generated" @tier "presentation"
    name           : string @label "Name" @description "Full name - initials will be generated automatically" @tier "presentation"
    onClick        : event = "CLICK" @label "On Click" @description "Click handler" @tier "presentation"
    size           : string = "md" @label "Size" @description "Size of the avatar" @tier "presentation" @values (xs sm md lg xl)
    src            : asset = "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png" @label "Src" @description "Image source URL" @tier "presentation"
    status         : string = "online" @label "Status" @description "Status indicator" @tier "presentation" @values (online offline away busy)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/ui-avatar.orb orbitals[0].traits[0])"
