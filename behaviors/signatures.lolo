;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-document-details.orb orbitals[0].traits[0])
trait ui-document-details.traits.DocumentDetailsRender {
  alias          : UiDocumentDetails
  linkedEntity   : DocumentDetailsItem
  category       : interaction
  states         : (idle*)
  events         : (INIT DocumentDetailsLoaded @config.metaCommitEvent @config.relationEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on DocumentDetailsLoaded))
  emits          : (@config.metaCommitEvent @config.relationEvent DocumentDetailsLoaded)
  config {
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    fields         : [DocumentDetailsFieldsItem] = [] @label "Fields" @description "The properties shown; empty renders nothing." @tier "presentation"
    metaCommitEvent : event = "META_COMMIT" @label "Meta Commit Event" @description "Emitted when a property commits: { id, patch } — patch carries the id plus the one changed field, ready for a partial persist update." @tier "presentation"
    relationEvent  : event = "RELATION" @label "Relation Event" @description "Makes relation chips clickable: emitted with { field, id, name } when a hydrated relation value (or one row of a many-relation) is clicked — the host routes it to the linked record's own surface." @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    title          : string @label "Title" @description "Card heading (defaults to the localized 'Details')" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-document-details.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-document-panel.orb orbitals[0].traits[0])
trait ui-document-panel.traits.DocumentPanelRender {
  alias          : UiDocumentPanel
  linkedEntity   : DocumentPanelItem
  category       : interaction
  states         : (idle*)
  events         : (INIT TITLE_COMMIT CONTENT_CHANGE @config.titleCommitEvent @config.contentChangeEvent @config.editEvent @config.doneEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on TITLE_COMMIT) (idle -> idle on CONTENT_CHANGE))
  emits          : (@config.titleCommitEvent @config.contentChangeEvent @config.editEvent @config.doneEvent)
  config {
    actions        : [DocumentPanelActionsItem] = [] @label "Actions" @description "Header actions (settings, history, …). At most one explicit primary stays inline; the rest live under a single '⋯' menu — the title owns its row." @tier "presentation"
    autosaveHint   : string @label "Autosave Hint" @description "Muted caption beside Done telling the author work persists on its own" @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    contentChangeEvent : event = "CONTENT_CHANGE" @label "Content Change Event" @description "Forwarded to the embedded RichTextEditor's autosave stream: { value }" @tier "presentation"
    coverImage     : string @label "Cover Image" @description "Cover/hero image URL painted as a full-bleed banner above the header row (Notion/article-hero shape); hidden when empty" @tier "presentation"
    doneEvent      : event = "DONE" @label "Done Event" @description "Emitted by the Done button that ends the editing session: { id }" @tier "presentation"
    doneLabel      : string @label "Done Label" @description "doneLabel prop" @tier "presentation"
    editEvent      : event = "EDIT" @label "Edit Event" @description "Emitted by the header Edit affordance and a click on the read body: { id }" @tier "presentation"
    editing        : boolean = false @label "Editing" @description "false = read surface with click-to-edit body; true = live editor" @tier "presentation"
    editLabel      : string @label "Edit Label" @description "editLabel prop" @tier "presentation"
    icon           : icon @label "Icon" @description "Document icon rendered beside the title (a file glyph, a domain icon); hidden when empty" @tier "presentation"
    maxInlineActions : number @label "Max Inline Actions" @description "0 collapses even the primary action into the menu" @tier "presentation"
    placeholder    : string @label "Placeholder" @description "Placeholder for an empty body" @tier "presentation"
    subtitle       : string @label "Subtitle" @description "Muted byline under the title; hidden when empty" @tier "presentation"
    title          : string @label "Title" @description "Document title (falls back to 'Untitled' for a blank draft)" @tier "presentation"
    titleCommitEvent : event = "TITLE_COMMIT" @label "Title Commit Event" @description "Emitted when the title commits: { title, id }" @tier "presentation"
    value          : string @label "Value" @description "The document body as rich-text HTML" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-document-panel.orb orbitals[0].traits[0])"
}

