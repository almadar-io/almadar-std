}

form uses-file-scope {
  syntax  : "uses Alias from \"std/behaviors/std-modal\""
  desc    : "A uses declaration is file-scoped: written above any orbital block, its alias is visible to every orbital in the file, not only the one it sits next to (an orbital may also declare its own uses, merged with the file-scoped table — the local alias wins on collision)."
