    placeholder    : string = "Add a tag…" @label "Input placeholder" @description "Placeholder in the type-to-add input" @tier "presentation"
    readOnly       : boolean = false @label "Read-only?" @description "When true the strip renders nothing — no add input, no remove, no suggestion chips. Hosts pass a role condition here so read-only viewers rely on the record's read-only rails (which keep showing the tags) instead of an editing surface." @synonyms "read only tags, viewer mode, no tag editing, hide tag input" @tier "policy"
    title          : string = "Tags" @label "Strip caption" @description "Small caption above the chips; empty hides it" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
