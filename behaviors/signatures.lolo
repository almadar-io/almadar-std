pattern orbital-visualization {
  category       : display
  desc           : "OrbitalVisualization Component Visualizes KFlow schemas as atomic orbitals based on complexity. Uses CSS 3D transforms for lightweight rendering without Three.js. Orbital Types (based on complexity score): - 1s (1-3): Simple sphere - Red - 2s (4-8): Larger sphere - Orange - 2p (9-15): Dumbbell shape - Yellow - 3s (16-25): Sphere with node - Green - 3p (26-40): Complex dumbbell - Blue - 3d (41-60): Cloverleaf - Indigo - 4f (61+): Multi-lobe - Violet"
  props {
    animated?              : boolean
    className?             : string
    complexity?            : number
    error?                 : object
    isLoading?             : boolean
    onClick?               : function
    schema?                : object
    showLabel?             : boolean
    size?                  : string
  }
  emits          : ()
  requires       : ()
  source         : "@almadar/core/patterns (PATTERN_REGISTRY): orbital-visualization"
}

