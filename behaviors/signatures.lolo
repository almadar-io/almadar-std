;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-draw-skinned-mesh.orb orbitals[0].traits[0])
trait ui-draw-skinned-mesh.traits.DrawSkinnedMeshRender {
  alias          : UiDrawSkinnedMesh
  linkedEntity   : DrawSkinnedMeshItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    asset          : DrawSkinnedMeshAsset @label "Asset" @description "The texture the mesh UVs cut into." @tier "presentation"
    bones          : [DrawSkinnedMeshBonesItem] = [{"name":"Name","parent":"Parent","pivot":[1,2],"tip":[1,2]},{"name":"Name 2","parent":"Parent 2","pivot":[1,2],"tip":[1,2]}] @label "Bones" @description "The skeleton (bind pose; FK chain via `parent` names). Falls back to the rigbundle's `bones` when empty." @tier "presentation"
    clip           : DrawSkinnedMeshClip @label "Clip" @description "Pose animation clip; with `frame`, pose = `frames[frame % frames.length]`." @tier "presentation"
    clipName       : string @label "Clip Name" @description "Named clip inside the rigbundle at `meshUrl` (`clips[clipName].frames`); used when `clip` is absent. Empty/unknown = no clip." @tier "presentation"
    frame          : number @label "Frame" @description "Clip frame counter (host-driven paint clock frame)." @tier "presentation"
    ghost          : DrawSkinnedMeshGhost @label "Ghost" @description "Onion skin: render the mesh at this clip frame underneath, at this opacity." @tier "presentation"
    mesh           : DrawSkinnedMeshMesh @label "Mesh" @description "Inline bind mesh; wins over `meshUrl`." @tier "presentation"
    meshUrl        : string @label "Mesh Url" @description "URL of a JSON `SkinMesh` (fetched + cached); used when `mesh` is absent." @tier "presentation"
    opacity        : number @label "Opacity" @description "0..1 opacity." @tier "presentation"
    pose           : Map<string,number> = {"item":1} @label "Pose" @description "Static pose (bone name → degrees relative to bind). Overridden by `clip` + `frame`." @tier "presentation"
    position       : DrawSkinnedMeshPosition = {"x":1,"y":1,"z":1} @label "Position" @description "Logical scene position; mesh local coords are world units relative to its projected top-left." @tier "presentation"
    weightsOverlay : boolean @label "Weights Overlay" @description "Paint per-triangle dominant-bone colors instead of the texture (rig inspection)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-draw-skinned-mesh.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-draw-sprite.orb orbitals[0].traits[0])
trait ui-draw-sprite.traits.DrawSpriteRender {
  alias          : UiDrawSprite
  linkedEntity   : DrawSpriteItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    anchor         : string = "top-left" @label "Anchor" @description "How the sprite aligns to its projected position. Default `'top-left'`." @tier "presentation" @values (top-left ground center)
    animation      : string @label "Animation" @description "Animation to play. 3D backend: a named GLB clip (matched case-insensitively). 2D painter: when `asset.atlas` resolves to a `SpriteSheetAtlas` manifest, the canonical row of that name (idle/walk/attack/hit/death) plays off the host paint clock; an explicit `frame` rect overrides." @tier "presentation"
    asset          : DrawSpriteAsset @label "Asset" @description "The image / atlas reference to blit." @tier "presentation"
    clockMs        : number @label "Clock Ms" @description "Animation clock override in ms (e.g. an fx entry's age since spawn). Omitted → the host paint clock; one-shot rows anchored to wall-time would otherwise sit on their final frame." @tier "presentation"
    flipX          : boolean @label "Flip X" @description "Mirror horizontally (facing)." @tier "presentation"
    frame          : DrawSpriteFrame @label "Frame" @description "Explicit atlas sub-rect override (px); omitted → resolved from `asset.atlas`/`asset.sprite`." @tier "presentation"
    height         : number @label "Height" @description "Draw height in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`." @tier "presentation"
    loop           : boolean @label "Loop" @description "Override the sheet row's loop flag. The paint clock is wall-time, so one-shot rows hold their final frame — preview pages set `true` to cycle attack/hit/death continuously." @tier "presentation"
    opacity        : number @label "Opacity" @description "0..1 opacity." @tier "presentation"
    position       : DrawSpritePosition = {"x":1,"y":1,"z":1} @label "Position" @description "Logical scene position; the projector maps it to pixels / world." @tier "presentation"
    rotation       : number @label "Rotation" @description "Rotation in radians about the sprite's center." @tier "presentation"
    shadow         : DrawSpriteShadow @label "Shadow" @description "Drop shadow (e.g. a team-colored glow)." @tier "presentation"
    width          : number @label "Width" @description "Draw width in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-draw-sprite.orb orbitals[0].traits[0])"
}

