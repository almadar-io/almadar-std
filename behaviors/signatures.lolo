    gridWidth      : number = 7 @label "Grid Width" @description "Grid column count (matches CrewAuthority.gridWidth)." @tier "presentation"
    hudBackgroundAsset : Asset = {} @label "HUD Background Asset" @description "HUD panel background sprite (theme chrome)." @tier "presentation"
    movementRange  : number = 2 @label "Movement Range" @description "Max manhattan distance a selected crew unit may move." @tier "domain"
    oxygen         : number = 100 @label "Oxygen" @description "Initial HUD oxygen display value. Cosmetic only: the source board never depletes it, so no atom writes it after INIT." @tier "domain"
