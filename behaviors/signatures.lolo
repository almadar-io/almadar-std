;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-header.orb orbitals[0].traits[0])
trait ui-header.traits.HeaderRender {
  alias          : UiHeader
  linkedEntity   : HeaderItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onMenuToggle @config.onSearch @config.onUserClick @config.onLogoClick)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onMenuToggle @config.onSearch @config.onUserClick @config.onLogoClick)
  config {
    actions        : node @label "Actions" @description "Action buttons (right side)" @tier "presentation"
    brandName      : string = "KFlow" @label "Brand Name" @description "Brand/App name" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    error          : HeaderError @label "Error" @description "Error state (closed circuit)" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator (closed circuit)" @tier "presentation"
    isMenuOpen     : boolean = false @label "Is Menu Open" @description "Is menu open (for toggle icon)" @tier "presentation"
    logo           : node @label "Logo" @description "Logo/Brand content" @tier "presentation"
    logoSrc        : asset = "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png" @label "Logo Src" @description "Logo image source" @tier "presentation"
    look           : string = "compact-bar" @label "Look" @description "Layer 2 visual treatment — orthogonal to the structural variant (which currently flips mobile vs desktop)." @tier "presentation" @values (hero compact-bar breadcrumb contextual editorial-banner)
    navigationItems : [HeaderNavigationItemsItem] = [] @label "Navigation Items" @description "Navigation items (for desktop header variant)" @tier "presentation"
    onLogoClick    : event = "LOGO_CLICK" @label "On Logo Click" @description "Callback when logo/brand is clicked" @tier "presentation"
    onMenuToggle   : event = "MENU_TOGGLE" @label "On Menu Toggle" @description "Menu toggle callback" @tier "presentation"
    onSearch       : event = "SEARCH" @label "On Search" @description "Search callback" @tier "presentation"
    onUserClick    : event = "USER_CLICK" @label "On User Click" @description "Callback when user avatar is clicked" @tier "presentation"
    searchPlaceholder : string @label "Search Placeholder" @description "Search placeholder" @tier "presentation"
    showMenuToggle : boolean = true @label "Show Menu Toggle" @description "Show menu toggle button" @tier "presentation"
    showSearch     : boolean = false @label "Show Search" @description "Show search input" @tier "presentation"
    sticky         : boolean = true @label "Sticky" @description "Sticky header" @tier "presentation"
    userAvatar     : HeaderUserAvatar @label "User Avatar" @description "User avatar configuration" @tier "presentation"
    userName       : string @label "User Name" @description "User name (display name or email)" @tier "presentation"
    variant        : string = "mobile" @label "Variant" @description "Variant - mobile shows menu toggle, desktop shows full nav" @tier "presentation" @values (mobile desktop)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-header.orb orbitals[0].traits[0])"
}

