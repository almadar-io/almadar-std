;; From @almadar/std (behaviors/registry/infra/atoms/std-notify-on-event.orb orbitals[0].traits[0])
trait std-notify-on-event.traits.NotifyOnEventListener {
  alias          : NotifyOnEvent
  linkedEntity   : NotificationRecord
  category       : lifecycle
  states         : (idle*)
  events         : (EventOccurred NOTIFY_PREFS_LOADED NOTIFY_CAP_LOADED NOTIFY_PUSH_SUBS NOTIFY_EMAIL_SENT NOTIFY_EMAIL_FAILED NOTIFY_SMS_SENT NOTIFY_SMS_FAILED NOTIFY_WEBHOOK_SENT NOTIFY_WEBHOOK_FAILED NOTIFY_PUSH_SENT NOTIFY_PUSH_FAILED NOTIFY_LOOKUP_FAILED NotificationDispatched)
  transitions    : ((idle -> idle on EventOccurred) (idle -> idle on NOTIFY_PREFS_LOADED) (idle -> idle on NOTIFY_CAP_LOADED) (idle -> idle on NOTIFY_PUSH_SUBS) (idle -> idle on NOTIFY_EMAIL_SENT) (idle -> idle on NOTIFY_EMAIL_FAILED) (idle -> idle on NOTIFY_SMS_SENT) (idle -> idle on NOTIFY_SMS_FAILED) (idle -> idle on NOTIFY_WEBHOOK_SENT) (idle -> idle on NOTIFY_WEBHOOK_FAILED) (idle -> idle on NOTIFY_PUSH_SENT) (idle -> idle on NOTIFY_PUSH_FAILED) (idle -> idle on NOTIFY_LOOKUP_FAILED))
  emits          : (NotificationDispatched NOTIFY_PREFS_LOADED NOTIFY_CAP_LOADED NOTIFY_PUSH_SUBS NOTIFY_EMAIL_SENT NOTIFY_EMAIL_FAILED NOTIFY_SMS_SENT NOTIFY_SMS_FAILED NOTIFY_WEBHOOK_SENT NOTIFY_WEBHOOK_FAILED NOTIFY_PUSH_SENT NOTIFY_PUSH_FAILED NOTIFY_LOOKUP_FAILED)
  config {
    coalesce       : string = "none" @label "Collapse repeat notifications from one action?" @description "When one action raises the subscribed event several times (a bulk import, a batch save), send one notification for the whole action (`perDispatch`) or one per distinct value of `coalesceKey` (`perKey`) instead of one per event. `none` (default) notifies on every event. Scoped to a single action: the next action notifies again." @synonyms "dedupe, deduplicate, collapse, batch notifications, one notification, bulk, coalesce, summarize, avoid spam, notification storm" @tier "policy" @values (none perDispatch perKey)
    coalesceKey    : string = "id" @label "Which field makes two events distinct?" @description "With `coalesce: perKey`, the upstream event's payload field compared to tell repeats apart (e.g. `id` = one notification per record). Ignored otherwise." @synonyms "dedupe key, distinct by, per record, unique field" @tier "policy"
    emailSubject   : string = "" @label "Email subject" @description "Subject line used for the email channel. Falls back to `template` when blank. Ignored for other channels." @synonyms "subject, subject line, email title, mail subject" @tier "presentation"
    eventKey       : string = "" @label "Event key for preferences" @description "Stable key naming the upstream event this listener is bound to (e.g. 'OrderPlaced'). NotificationPreference rows (std-notification-center) whose eventKey equals this key — or is blank — apply to this listener's dispatches." @synonyms "preference key, event name, subscription key, notification topic" @tier "policy"
    fallbackRecipient : string = "" @label "Fallback recipient" @description "Recipient used when `recipients` is empty, instead of the acting user. The acting-user fallback (used when this is blank) is intended for personal notifications only — set this to an ops/team address (e.g. 'ops@example.com') for system alerts like low-stock or shipping notices, so the acting user isn't notified in place of the intended audience." @synonyms "default recipient, backup recipient, ops address, fallback address, notify default, alert owner" @tier "policy"
    frequencyCapPerWeek : number = 0 @label "Frequency cap (per week)" @description "Max dispatched sends per (channel, recipient) per rolling 7-day window, counted against dispatched NotificationRecord audit rows. 0 = uncapped. Applies to the persisted channels (email/sms/push/webhook); in-app toasts are not audited and not capped. A capped dispatch persists an audit row (`error: frequency-cap`, dispatched:false)." @synonyms "rate limit, cap, max per week, throttle, send limit" @tier "policy"
    guardField     : string = "" @label "Guard field (numeric)" @description "Field read from the upstream event's `data` payload and compared against `guardValue` when `guardOp` is not `eq` (e.g. 'stockLevel', 'quantity'). Ignored when `guardOp` is `eq`." @synonyms "threshold field, numeric field, compare field, watched field, data field" @tier "policy"
    guardOp        : string = "eq" @label "Guard comparison" @description "How to gate dispatch. `eq` (default) does string-equality via `triggerStatus` against the upstream event's `status` field, exactly as before. `gt`/`lt`/`gte`/`lte` instead numerically compare `guardField` (read from the event's `data` payload) against `guardValue` — e.g. fire only when a stock level drops below a threshold." @synonyms "comparison operator, threshold operator, guard mode, trigger comparison, numeric gate, greater than, less than, threshold crossing" @tier "policy" @values (eq gt lt gte lte)
    guardValue     : number = 0 @label "Guard value (numeric)" @description "Threshold compared against `guardField` when `guardOp` is not `eq` (e.g. fire when stock drops below 5)." @synonyms "threshold, cutoff, limit, watermark, trigger value" @tier "policy"
    listensFor     : [string] = [] @label "Trigger events" @description "Event names that should fire a notification. Set this to the upstream event name (e.g. OrderPlaced, CheckoutCompleted) so this atom listens for events from the orbital that emits them. The orbital owning this trait reacts whenever the named event fires anywhere in the schema." @synonyms "subscribe to event, listen for event, react to event, watch for, wire upstream event, observe event from another orbital, cross-orbital subscription, on-event trigger" @tier "internal"
    notifyChannel  : string = "in-app" @label "Channel" @description "Delivery channel. `in-app` (default) emits the in-app `notify` toast. `email`/`sms`/`webhook` dispatch through call-service at event time (email.send / twilio.sendSMS / webhook.send) and persist a NotificationRecord audit row with an honest `dispatched` flag: true only once the service call succeeds, false plus the failure detail in `error` otherwise. `push` looks up the recipient's PushSubscription row (captured by std-notification-center's subscribe flow) and dispatches web-push via push.send — a recipient with no subscription records the audit row undispatched (`no-push-subscription`). `webhook` requires `webhookUrl` to actually dispatch; a blank `webhookUrl` still records the audit row undispatched rather than failing. A per-user NotificationPreference row's `channel` overrides this value for that recipient." @synonyms "delivery method, notification channel, send via, dispatch through, push notification, web push" @tier "policy" @values (in-app email sms push webhook)
    pushDeepLink   : string = "" @label "Push deep link" @description "In-app path opened when the recipient clicks the push notification (e.g. '/orders'). Blank = the app root." @synonyms "click url, open on click, target path, notification link" @tier "presentation"
    pushIcon       : string = "" @label "Push icon" @description "Icon URL shown on the push notification. Blank = the browser default." @synonyms "notification icon, badge image" @tier "presentation"
    pushTitle      : string = "" @label "Push title" @description "Notification title for the push channel. Falls back to `template` when blank. Ignored for other channels." @synonyms "notification title, push heading, alert title" @tier "presentation"
    quietEndHour   : number = 0 @label "Quiet hours end" @description "Hour of day (0-23) when the atom-level quiet window closes. Equal to `quietStartHour` = disabled." @synonyms "do not disturb until, silence end, night mode end" @tier "policy"
    quietStartHour : number = 0 @label "Quiet hours start" @description "Hour of day (0-23) when the atom-level quiet window opens. Equal to `quietEndHour` = disabled. Dispatches inside the window persist an audit row (`error: quiet-hours`, dispatched:false) which std-notification-center's digest cycle drains later. Per-user quiet hours from NotificationPreference rows apply in addition." @synonyms "quiet hours, do not disturb from, silence start, night mode start" @tier "policy"
    recipients     : [string] = [] @label "Recipients" @description "Recipient ids/addresses. v1.1 uses the first entry; multi-recipient fan-out lands in v1.2 (gap). When empty, falls back to `fallbackRecipient` if set, otherwise the authenticated user." @synonyms "targets, addressees, notify to" @tier "policy"
    severity       : string = "info" @label "Severity" @description "info, success, warning, or error — controls styling" @synonyms "alert level, priority, urgency" @tier "policy"
    suppressionList : [string] = [] @label "Suppression list" @description "Recipient ids/addresses to skip (e.g. unsubscribed users). Suppression check runs before dispatch." @synonyms "block list, unsubscribed, opt-out list" @tier "policy"
    template       : string = "" @label "Message template" @description "Text shown to the recipient; supports payload interpolation" @synonyms "notification text, message body, alert text" @tier "presentation"
    triggerStatus  : string = "" @label "Trigger status" @description "When `guardOp` is `eq` and this is set, dispatch only when the upstream event's `status` field equals this value (e.g. fire only when a record becomes 'approved'). Empty = fire on every subscribed event. Ignored when `guardOp` is a numeric comparison." @synonyms "on status, when status, status filter, only when, fire on, react on status" @tier "policy"
    webhookSecret  : string = "" @label "Webhook secret" @description "Signing secret forwarded to the webhook service so the receiving endpoint can verify the payload. Ignored when `webhookUrl` is blank." @synonyms "signing secret, hmac secret, webhook signature, shared secret" @tier "internal"
    webhookUrl     : string = "" @label "Webhook URL" @description "Destination endpoint for the webhook channel. Dispatch only fires when this is non-blank; a blank URL on channel \"webhook\" records the audit row with dispatched:false instead of crashing (a consumer misconfiguration, not a failure)." @synonyms "webhook endpoint, callback url, target url, http endpoint, notify url" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-notify-on-event.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-objective-flow.orb orbitals[0].traits[0])
trait std-objective-flow.traits.ObjectiveFlow {
  alias          : ObjectiveFlow
  linkedEntity   : FlowState
  category       : lifecycle
  states         : (active*)
  events         : (INIT PROGRESS RESTART GAME_END)
  transitions    : ((active -> active on INIT) (active -> active on PROGRESS) (active -> active on RESTART))
  emits          : (GAME_END)
  config {
    running        : boolean = true @label "Running" @description "When true, PROGRESS signals resolve win/lose; toggle to freeze" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-objective-flow.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-objective-reach.orb orbitals[0].traits[0])
trait std-objective-reach.traits.ObjectiveReach {
  alias          : ObjectiveReach
  linkedEntity   : ObjectiveState
  category       : lifecycle
  states         : (active*)
  events         : (INIT HERO_STEPPED RESTART BURST PROGRESS)
  transitions    : ((active -> active on INIT) (active -> active on HERO_STEPPED) (active -> active on RESTART))
  emits          : (BURST PROGRESS)
  config {
    features       : [Feature] = [] @label "Features" @description "Board features — collectible targets (matched by targetType) plus decorations" @tier "domain"
    pointsPerTarget : number = 1 @label "Points Per Target" @description "Score awarded per objective reached" @tier "domain"
    reachRadius    : number = 0 @label "Reach Radius" @description "Manhattan distance at which a target counts as reached: 0 = step onto the tile (collect), 1 = adjacent (deliver)" @tier "domain"
    removeOnReach  : boolean = true @label "Remove On Reach" @description "When true the target model is removed once reached (collect); when false it is flagged done and stays (visit/deliver)" @tier "domain"
    running        : boolean = true @label "Running" @description "When true, hero steps onto targets are scored; toggle to freeze" @tier "domain"
    startScore     : number = 0 @label "Start Score" @description "Score set on INIT" @tier "domain"
    targetType     : string = "gift" @label "Target Type" @description "Feature type counted as a collectible objective" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-objective-reach.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-pad-lock.orb orbitals[0].traits[0])
trait std-pad-lock.traits.PadLock {
  alias          : PadLock
  linkedEntity   : PadLockData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_PADS RESTART PAD_GROUP_COMPLETED PAD_SET_COMPLETED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_PADS) (active -> active on RESTART))
  emits          : (PAD_GROUP_COMPLETED PAD_SET_COMPLETED)
  config {
    pads           : [PadLock] = [] @label "Pads" @description "One row per floor pad: id, center (x, y in world units), and grp (0 = ungrouped, always live; N = live only while it is the lowest uncompleted group). lit is stamped at runtime. Seeded onto the entity on INIT; the live set is entity.pads — SET_PADS replaces it at runtime (boards that import pads), and RESTART re-arms the live set rather than re-reading config, so injected pads survive respawns." @tier "domain"
    reachX         : number = 0.7 @label "Reach X" @description "Horizontal tolerance (world units) around a pad's center when testing player contact (approximates the body's half-width plus a step)." @tier "domain"
    reachY         : number = 1.2 @label "Reach Y" @description "Vertical tolerance (world units) around a pad's center when testing player contact (covers skating over the surface the pad sits on)." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED lights touched live pads and reports group/set completion; toggle to freeze every pad as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-pad-lock.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-pagination.orb orbitals[0].traits[0])
trait std-pagination.traits.PagedItemPagination {
  alias          : Pagination
  linkedEntity   : PagedItem
  category       : interaction
  states         : (idle*)
  events         : (INIT PagedItemLoaded PAGE ITEMS_LOADED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on PagedItemLoaded) (idle -> idle on PAGE) (idle -> idle on ITEMS_LOADED))
  emits          : (PAGE PagedItemLoaded)
  config {
    event          : event = "PAGE" @label "Page-change event" @description "Event emitted when the user picks a new page" @tier "internal"
    pageSize       : number = 10 @label "Page size" @description "Rows per page used to derive total page count" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-pagination.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-patience.orb orbitals[0].traits[0])
trait std-patience.traits.Patience {
  alias          : Patience
  linkedEntity   : PatienceData
  category       : lifecycle
  states         : (active*)
  events         : (INIT HERO_STEPPED RESTART BURST SERVICE_CHANGED CUSTOMER_LOST)
  transitions    : ((active -> active on INIT) (active -> active on HERO_STEPPED) (active -> active on RESTART))
  emits          : (BURST SERVICE_CHANGED CUSTOMER_LOST)
  config {
    customers      : [Customer] = [] @label "Customers" @description "Seed roster of stationary customers, each with their own position + patience/maxPatience" @tier "domain"
    running        : boolean = true @label "Running" @description "When true, patience ticks down and HERO_STEPPED serves nearby customers; toggle to freeze" @tier "domain"
    serveRadius    : number = 1 @label "Serve Radius" @description "Manhattan distance at which a customer counts as served by the hero's last step: 0 = step onto tile, 1 = adjacent" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-patience.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-patrol-hazard.orb orbitals[0].traits[0])
trait std-patrol-hazard.traits.PatrolHazard {
  alias          : PatrolHazard
  linkedEntity   : PatrolState
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_PATROLS RESTART PATROL_HIT)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_PATROLS) (active -> active on RESTART))
  emits          : (PATROL_HIT)
  config {
    hitRadius      : number = 0.7 @label "Hit Radius" @description "Per-axis distance (world units) within which a patrol counts as touching the player; smaller values demand precise contact, larger values forgive." @tier "domain"
    patrols        : [Patrol] = [] @label "Patrols" @description "One row per patroller: id, the [x0, x1] beat it walks, its base y, its speed in units/s, and optionally waveAmp/wavePeriod for a vertical sine bob (waveAmp 0 = flat ping-pong). Current x/dir/t/cy/touching/hit are stamped at runtime. Seeded onto the entity on INIT; the live set is entity.patrols — SET_PATROLS replaces it at runtime (boards that import patrols), and RESTART re-arms the live set rather than re-reading config, so injected patrols survive respawns." @tier "domain"
    playerSpawnX   : number = 0 @label "Player Spawn X" @description "Player x assumed before the first BODY_MOVED arrives (match the body authority's spawn)." @tier "domain"
    playerSpawnY   : number = 0 @label "Player Spawn Y" @description "Player y assumed before the first BODY_MOVED arrives." @tier "domain"
    running        : boolean = true @label "Running" @description "When true the 33ms tick moves patrols and tests contact; toggle to freeze every patrol in place." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-patrol-hazard.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-permission-matrix.orb orbitals[0].traits[1])
trait std-permission-matrix.traits.PermissionGrantPersistor {
  alias          : PermissionMatrix
  linkedEntity   : PermissionGrant
  category       : lifecycle
  states         : (idle*)
  events         : (INIT DO_CREATE DO_UPDATE DO_DELETE PermissionGrantSaveFailed PermissionGrantDeleteFailed PermissionGrantSaved PermissionGrantDeleted)
  transitions    : ((idle -> idle on INIT) (idle -> idle on DO_CREATE) (idle -> idle on DO_UPDATE) (idle -> idle on DO_DELETE) (idle -> idle on PermissionGrantSaveFailed) (idle -> idle on PermissionGrantDeleteFailed))
  emits          : (PermissionGrantSaved PermissionGrantSaveFailed PermissionGrantDeleted PermissionGrantDeleteFailed)
  config {
    adminRoles     : [string] = [] @label "Who can manage grants?" @description "Roles eligible to create, edit, or delete grants. ENFORCED by the DO_CREATE/DO_UPDATE/DO_DELETE transition guards: a viewer whose @user.role is not listed cannot fire a write, from the form submit or from the bus. Empty = every signed-in viewer may manage grants (ungated). Mounting the page is the opt-in — there is deliberately no separate enable flag (a default-off flag made the whole page's affordances dead on a fresh mount)." @synonyms "admin roles, permission managers, who edits permissions, grant admins, permission matrix, role permissions, capability matrix, permission grants, access matrix, manage permissions" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-permission-matrix.orb orbitals[0].traits[1])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-permission-matrix.orb orbitals[0].traits[2])
trait std-permission-matrix.traits.PermissionGrantQuery {
  alias          : PermissionMatrix
  linkedEntity   : PermissionGrant
  category       : lifecycle
  states         : (idle*)
  events         : (CHECK_GRANT GrantCheckLoaded GrantCheckFailed GRANT_RESOLVED)
  transitions    : ((idle -> idle on CHECK_GRANT) (idle -> idle on GrantCheckLoaded) (idle -> idle on GrantCheckFailed))
  emits          : (GRANT_RESOLVED GrantCheckLoaded GrantCheckFailed)
  config {
    enabled        : boolean = false @label "Answer permission lookups" @description "Answer CHECK_GRANT lookups with GRANT_RESOLVED from the persisted grant table. Off by default." @synonyms "enable, turn on, activate, permission lookup, grant query, resolve capabilities" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-permission-matrix.orb orbitals[0].traits[2])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-permission-matrix.orb orbitals[0].traits[0])
trait std-permission-matrix.traits.PermissionMatrixAdmin {
  alias          : PermissionMatrix
  linkedEntity   : PermissionGrant
  category       : interaction
  states         : (loading* listing error)
  events         : (INIT PermissionGrantLoaded PermissionGrantLoadFailed NEW EDIT DELETE)
  transitions    : ((loading -> loading on INIT) (loading -> listing on PermissionGrantLoaded) (loading -> error on PermissionGrantLoadFailed) (listing -> loading on INIT) (error -> loading on INIT))
  emits          : (NEW EDIT DELETE PermissionGrantLoaded PermissionGrantLoadFailed)
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-permission-matrix.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-pickup.orb orbitals[0].traits[0])
trait std-pickup.traits.Pickup {
  alias          : Pickup
  linkedEntity   : PickupData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_FEATURES ADD_FEATURES FEATURES_ACTIVE RESTART PICKED COLLECT PICKUP_SET_COMPLETED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_FEATURES) (active -> active on ADD_FEATURES) (active -> active on FEATURES_ACTIVE) (active -> active on RESTART))
  emits          : (PICKED COLLECT PICKUP_SET_COMPLETED)
  config {
    features       : [PickupFeature] = [] @label "Features" @description "One row per collectible: id, center (x, y in world units), board-defined kind (star, boost, …), display glyph and message floated on pickup. collected is stamped at runtime. Seeded onto the entity on INIT; the live set is entity.pickups — SET_FEATURES replaces it at runtime (boards that import collectibles), and RESTART re-arms the live set rather than re-reading config, so injected features survive respawns." @tier "domain"
    reachX         : number = 0.7 @label "Reach X" @description "Horizontal tolerance (world units) around a feature's center when testing player contact." @tier "domain"
    reachY         : number = 1.2 @label "Reach Y" @description "Vertical tolerance (world units) around a feature's center when testing player contact; generous values catch fly-through pickups." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED collects touched features; toggle to freeze the set as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-pickup.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-platformer-body.orb orbitals[0].traits[0])
trait std-platformer-body.traits.PlatformerBody {
  alias          : PlatformerBody
  linkedEntity   : PlatformerBodyData
  category       : lifecycle
  states         : (active*)
  events         : (INIT STEER JUMP PLACE CURVE_MOD_ADD CURVE_MOD_CLEAR CURVE_MOD_CLEAR_RANGE SET_TUNING SET_PLATFORMS SET_SKATE_CURVE SET_DRIFT_REGIONS RESTART BODY_MOVED BODY_SKATE_START BODY_SKATE_END BODY_JUMPED BODY_LANDED BODY_HAZARD BODY_GOAL BODY_FELL)
  transitions    : ((active -> active on INIT) (active -> active on STEER) (active -> active on JUMP) (active -> active on PLACE) (active -> active on CURVE_MOD_ADD) (active -> active on CURVE_MOD_CLEAR) (active -> active on CURVE_MOD_CLEAR_RANGE) (active -> active on SET_TUNING) (active -> active on SET_PLATFORMS) (active -> active on SET_SKATE_CURVE) (active -> active on SET_DRIFT_REGIONS) (active -> active on RESTART))
  emits          : (BODY_MOVED BODY_SKATE_START BODY_SKATE_END BODY_JUMPED BODY_LANDED BODY_HAZARD BODY_GOAL BODY_FELL CURVE_MOD_CLEAR)
  config {
    curveModsEnabled : boolean = false @label "Curve Mods Enabled" @description "When true, entity.curveMods reshape the skate surface inside each mod's x-range: the road samples the base curve at b·(x − h) and applies a·y + k (slope scales by a·b) — coefficient pads lift/tilt/compress the segment the player is riding. Multiple overlapping mods stack by summing each mod's delta from the base surface; a mod whose shifted sample leaves the curve range is skipped. Default off: boards without coef pads pay nothing." @tier "domain"
    driftRegions   : [BodyDriftRegion] = [] @label "Drift Regions" @description "Axis-aligned rects (x0..x1, y0..y1 in world units) each carrying a constant acceleration (ax, ay in units/s²) applied with the physics dt whenever the body's center is inside — winds, currents, gradient pushes. Empty list = zero behavior change. Seeded onto the entity on INIT; the live set is entity.driftRegions — SET_DRIFT_REGIONS replaces it at runtime and RESTART does not reseed it." @tier "domain"
    gravity        : number = 24 @label "Gravity" @description "Units/s² added to vertical velocity; the SIGN is the vertical convention — positive pulls toward +y (screen boards, y down), negative toward −y (math canvases, y up) — and jumps always fire against it" @tier "domain"
    jumpStrength   : number = 11 @label "Jump Strength" @description "Vertical speed in units/s imparted by JUMP, directed against gravity; apex height ≈ jumpStrength² / (2·|gravity|)" @tier "domain"
    killY          : number = 1000000 @label "Kill Y" @description "Fall line: crossing it in the gravity direction fires BODY_FELL once (past it downward on y-down boards, below it on y-up canvases); y-up consumers must set a value below their world floor" @tier "domain"
    maxFallSpeed   : number = 14 @label "Max Fall Speed" @description "Terminal velocity cap in units/s applied to vertical speed each tick" @tier "presentation"
    moveSpeed      : number = 5 @label "Move Speed" @description "Horizontal run speed in units/s applied by STEER dir ±1" @tier "domain"
    platforms      : [PlatformerPlatform] = [] @label "Platforms" @description "Level geometry as min-corner rects: ground/platform tiles are solid one-way landing surfaces, hazard tiles emit BODY_HAZARD on touch, goal tiles emit BODY_GOAL. Seeded onto the entity on INIT; the live set is entity.platforms — SET_PLATFORMS replaces it at runtime (boards that import geometry, e.g. stitched open worlds) and RESTART deliberately does NOT reseed it, so injected geometry survives respawns." @tier "domain"
    running        : boolean = true @label "Running" @description "When true the 33ms physics tick integrates and collides; toggle to freeze the body" @tier "domain"
    skate          : boolean = false @label "Curve Skating" @description "When true, a grounded body within skateSnap of the skateCurve surface rides the curve: y snaps to the interpolated surface and tangential gravity (g·slope/(1+slope²)) accelerates vx, so the body slides downhill along the graph and launches off its ends; JUMP kicks free. Engages when grounded, when landing on a tile, or when a falling (not rising) body passes within skateSnap above the surface." @tier "domain"
    skateCurve     : [PlatformerCurveSample] = [] @label "Skate Curve" @description "Surface samples (x strictly increasing) the body skates when skate is on; y is the surface height for the body's MIN corner, linearly interpolated between bracketing samples — mirror the render-side curve so what you see is what you ride. Seeded onto the entity on INIT; the live curve is entity.skateCurve — SET_SKATE_CURVE replaces it at runtime (stitched mega-curves) and RESTART does not reseed it." @tier "domain"
    skateMaxGap    : number = 0 @label "Skate Max Gap" @description "Largest x-gap between consecutive skateCurve samples that still counts as surface. 0 = unlimited (sparse two-sample lines skate fine). Dense resampled curves with real gaps between segments (stitched worlds) MUST set this — otherwise the sampler invents a skatable chord across every gap (an invisible line above the bridge/terrain that the body snaps to and glides along)." @tier "domain"
    skateSnap      : number = 0.75 @label "Skate Snap" @description "Max vertical gap (world units) between the body's min corner and the curve surface for skating to engage or stay engaged; larger values grab earlier on landing, smaller values release sooner on bumps" @tier "domain"
    spawn          : PlatformerBody = {"facingRight":true,"grounded":false,"height":0.6,"vx":0,"vy":0,"width":0.6,"x":2,"y":8} @label "Spawn Body" @description "Initial body rect (min-corner x/y plus width/height) seeded on INIT/RESTART; width/height also define the collision box" @tier "domain"
    xMax           : number = 1000000 @label "Right Wall" @description "Largest x the body's min corner may hold (world bounds, not level geometry)" @tier "presentation"
    xMin           : number = -1000000 @label "Left Wall" @description "Smallest x the body's min corner may hold (world bounds, not level geometry)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-platformer-body.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-pricing.orb orbitals[0].traits[0])
trait std-pricing.traits.PricingRender {
  alias          : Pricing
  linkedEntity   : PricingView
  category       : interaction
  states         : (idle*)
  events         : (INIT PLAN_CHOOSE PLAN_SELECTED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on PLAN_CHOOSE))
  emits          : (PLAN_SELECTED)
  config {
    footnote       : string = "" @label "Footnote" @description "Small print under the plans, e.g. taxes or billing terms" @tier "presentation"
    heading        : string = "" @label "Heading" @description "Section heading above the plans; empty hides it" @synonyms "title" @tier "presentation"
    lede           : string = "" @label "Supporting text" @tier "presentation"
    plans          : [PricingPlan] = [{"actionHref":"#","actionLabel":"Start free","features":["1 project","Community support"],"name":"Starter","period":"/month","price":"$0","summary":"For trying things out."},{"actionHref":"#","actionLabel":"Choose Team","badge":"Popular","features":["Unlimited projects","Shared workspace","Priority support"],"highlighted":true,"name":"Team","period":"/month","price":"$29","summary":"For teams shipping every week."}] @label "Plans" @description "One card per plan: name, price, period, summary, features, action; `highlighted` marks the recommended plan" @synonyms "tiers, packages, subscriptions, pricing table" @tier "presentation"
    surface        : string = "plain" @label "Surface" @tier "presentation" @values (plain muted)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-pricing.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-production.orb orbitals[0].traits[0])
trait std-production.traits.Producer {
  alias          : Production
  linkedEntity   : ProductionState
  category       : lifecycle
  states         : (active*)
  events         : (INIT AI_TURN PRODUCE SPAWN)
  transitions    : ((active -> active on INIT) (active -> active on AI_TURN) (active -> active on PRODUCE))
  emits          : (SPAWN)
  config {
    pointsPerTurn  : number = 2 @label "Points Per Turn" @description "Points accrued each AI_TURN (turn advance)." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, turns accrue points and PRODUCE spends them; toggle to freeze production." @tier "domain"
    spawnCost      : number = 3 @label "Spawn Cost" @description "Points spent per produced unit; PRODUCE only fires when affordable." @tier "domain"
    spawnHealth    : number = 3 @label "Spawn Health" @description "Health/maxHealth of produced units." @tier "domain"
    spawnTeam      : string = "player" @label "Spawn Team" @description "Team of produced units." @tier "domain"
    spawnUnitType  : string = "unit" @label "Spawn Unit Type" @description "unitType of produced units (drives the asset-manifest sprite)." @tier "domain"
    spawnX         : number = 0 @label "Spawn X" @description "Grid column where produced units appear (rally point)." @tier "domain"
    spawnY         : number = 0 @label "Spawn Y" @description "Grid row where produced units appear (rally point)." @tier "domain"
    startPoints    : number = 0 @label "Start Points" @description "Production points set on INIT." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-production.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-prose.orb orbitals[0].traits[0])
trait std-prose.traits.ProseRender {
  alias          : Prose
  linkedEntity   : ProseView
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    body           : string = "Write the text here in **markdown**." @label "Body" @description "Markdown text" @synonyms "content, article, text, copy" @tier "presentation"
    direction      : string = "ltr" @label "Text direction" @tier "presentation" @values (ltr rtl)
    eyebrow        : string = "" @label "Eyebrow" @description "Small badge above the heading; empty hides it" @tier "presentation"
    heading        : string = "" @label "Heading" @description "Empty hides it" @synonyms "title" @tier "presentation"
    meta           : string = "" @label "Meta line" @description "Date, author or reading time under the heading; empty hides it" @synonyms "byline, date, author" @tier "presentation"
    surface        : string = "plain" @label "Surface" @tier "presentation" @values (plain muted)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-prose.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-rate-limiter.orb orbitals[0].traits[0])
trait std-rate-limiter.traits.RateBucketRateLimiter {
  alias          : RateLimiter
  linkedEntity   : RateBucket
  category       : interaction
  states         : (open* throttled)
  events         : (INIT REQUEST THROTTLE RESET)
  transitions    : ((open -> open on INIT) (open -> open on REQUEST) (open -> throttled on THROTTLE) (open -> open on RESET) (throttled -> open on RESET) (throttled -> throttled on INIT))
  config {
    burstSize      : number = 10 @label "Burst size" @description "Requests allowed to burst above the per-minute rate before steady-state throttling kicks in. Lower burst = strict/no-spikes; higher burst = forgiving/allow-spikes." @synonyms "burst capacity, allowance, spike allowance, no-spike (low) vs allow-bursts (high)" @tier "domain"
    enabled        : boolean = false @label "Enabled" @description "Whether rate limiting is active for the host orbital. Off by default; turn on to throttle requests." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, rate limit, throttle, requests per minute, slow down, cap usage, request cap, limit traffic, prevent abuse" @tier "domain"
    keyStrategy    : string = "user" @label "Rate-limit key strategy" @description "What identifier the per-bucket counter is keyed on: source IP, authenticated user, API key, or one global bucket." @synonyms "limiter key, bucket key" @tier "domain" @values (ip user api-key global)
    overrideRoles  : [string] = [] @label "Override roles" @description "Roles exempt from rate limiting (e.g. internal services, admin override). Empty = no exemptions." @synonyms "exempt roles, bypass list" @tier "domain"
    requestsPerMinute : number = 60 @label "Requests per minute" @description "Maximum number of requests allowed per minute before throttling begins." @synonyms "rate limit, request cap, RPS, throttle threshold" @tier "domain"
    statLook       : string = "elevated" @label "Stat display look" @description "Layer 2 visual treatment for stat / KPI cards." @tier "presentation" @values (elevated flat progress-backed gauge sparkline)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-rate-limiter.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-rating-review.orb orbitals[0].traits[0])
trait std-rating-review.traits.RatingReviewBoard {
  alias          : RatingReview
  linkedEntity   : ReviewView
  category       : interaction
  states         : (loading* viewing composing submitting submitted error)
  events         : (INIT ReviewsLoaded ReviewsLoadFailed ReviewSaved ReviewSaveFailed WRITE_REVIEW CHANGE_SORT MARK_HELPFUL RATE_DRAFT SUBMIT_REVIEW CANCEL_REVIEW RESTART)
  transitions    : ((loading -> loading on INIT) (loading -> viewing on ReviewsLoaded) (loading -> error on ReviewsLoadFailed) (loading -> loading on ReviewSaved) (loading -> error on ReviewSaveFailed) (viewing -> composing on WRITE_REVIEW) (viewing -> viewing on CHANGE_SORT) (viewing -> viewing on CHANGE_SORT) (viewing -> viewing on CHANGE_SORT) (viewing -> viewing on MARK_HELPFUL) (composing -> composing on RATE_DRAFT) (composing -> submitting on SUBMIT_REVIEW) (composing -> viewing on CANCEL_REVIEW) (submitting -> submitted on ReviewSaved) (submitting -> error on ReviewSaveFailed) (submitted -> loading on RESTART) (error -> loading on INIT))
  emits          : (WRITE_REVIEW RATE_DRAFT SUBMIT_REVIEW CANCEL_REVIEW CHANGE_SORT MARK_HELPFUL RESTART ReviewsLoaded ReviewsLoadFailed ReviewSaved ReviewSaveFailed)
  config {
    cancelLabel    : string = "Cancel" @label "Cancel button" @description "Label on the cancel button inside the compose form" @tier "presentation"
    cardLook       : string = "elevated" @label "Card look" @description "Layer 2 visual treatment for cards rendered by this atom." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    reviewFields   : [string] = ["draftComment"] @label "Review form fields" @description "Inputs shown in the review compose form" @tier "presentation"
    sortOptions    : [SortOption] = [{"icon":"clock","id":"recent","label":"Most recent"},{"icon":"star","id":"highest","label":"Top rated"},{"icon":"trending-down","id":"lowest","label":"Lowest"}] @label "Sort tabs" @description "Sort modes shown as tabs above the reviews list" @tier "presentation"
    starDistribution : [StarBucket] = [{"label":"5 stars","percentage":74},{"label":"4 stars","percentage":18},{"label":"3 stars","percentage":5},{"label":"2 stars","percentage":2},{"label":"1 star","percentage":1}] @label "Star bars" @description "Per-star distribution displayed as horizontal progress bars" @tier "presentation"
    subjectTitle   : string = "Bali Sunset Villa · 3 nights" @label "Subject title" @description "Name of the item being reviewed (shown in the header)" @tier "presentation"
    submitLabel    : string = "Submit review" @label "Submit button" @description "Label on the primary submit-review button" @tier "presentation"
    writeLabel     : string = "Write a review" @label "Write CTA" @description "Label on the call-to-action that opens the compose form" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-rating-review.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-rating-review.orb orbitals[0].traits[2])
trait std-rating-review.traits.RatingReviewPageNav {
  alias          : RatingReview
  linkedEntity   : ReviewView
  category       : interaction
  states         : (ready*)
