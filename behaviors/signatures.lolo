    hideCollapseButton : boolean = false @label "Hide Collapse Button" @description "Hide the collapse/expand button" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    items          : [SidebarItemsItem] = [{"active":false,"badge":"Badge","href":"Href","icon":"circle","id":"Id","isActive":false,"label":"Label","subItems":[]},{"active":true,"badge":"Badge 2","href":"Href 2","icon":"circle","id":"Id 2","isActive":true,"label":"Label 2","subItems":[]}] @label "Items" @description "Navigation items" @tier "presentation"
    logo           : node @label "Logo" @description "Logo/Brand content - can be a ReactNode or logo config" @tier "presentation"
    logoClickEvent : event = "LOGO_CLICK" @label "Logo Click Event" @description "Event emitted when logo/brand is clicked" @tier "presentation"
    logoSrc        : asset = "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png" @label "Logo Src" @description "Logo image source" @tier "presentation"
    showCloseButton : boolean = false @label "Show Close Button" @description "Show a close button (for mobile)" @tier "presentation"
    userSection    : node @label "User Section" @description "User section content" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-sidebar.orb orbitals[0].traits[0])"
}

