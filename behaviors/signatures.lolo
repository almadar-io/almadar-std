    forbiddenRegions : [Range] = [] @label "Forbidden regions" @description "Value ranges no weight may fall inside, even within the magnitude bound" @tier "domain"
    maxMagnitude   : float = 10 @label "Max weight magnitude" @description "Every weight's absolute value must not exceed this bound" @tier "policy"
    regressionThreshold : float = 0 @label "Regression threshold" @description "Max allowed per-element absolute drift between candidate and baseline weights; 0 disables the regression check" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-weight-validator.orb orbitals[0].traits[0])"
}

