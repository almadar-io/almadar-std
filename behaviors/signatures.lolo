;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-predict.orb orbitals[0].traits[0])
trait std-learn-predict.traits.PredictSim {
  alias          : LearnPredict
  linkedEntity   : PredictScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED PREDICT NEXT RETRY PREDICTION_COMMITTED SCENARIO_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on PREDICT) (idle -> idle on NEXT) (idle -> idle on RETRY))
  emits          : (PREDICTION_COMMITTED SCENARIO_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  config {
    gridStep       : number = 25 @label "Grid Step" @tier "presentation"
    height         : number = 320 @label "Height" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    nextLabel      : string = "Next" @label "Next Label" @tier "presentation"
    retryLabel     : string = "Try Again" @label "Retry Label" @tier "presentation"
    revealColor    : string = "#3b82f6" @label "Reveal Color" @tier "presentation"
    revealLabel    : string = "Outcome" @label "Reveal Label" @tier "presentation"
    scenarios      : [PredictScenario] = [{"correctIndex":1,"explanation":"With no limiting factor yet, growth compounds each season.","frames":[{"caption":"Season 1: 40 rabbits","value":40},{"caption":"Season 2: 52 rabbits","value":52},{"caption":"Season 3: 68 rabbits","value":68},{"caption":"Season 4: 88 rabbits","value":88},{"caption":"Season 5: 114 rabbits","value":114},{"caption":"Season 6: 148 rabbits — still accelerating","value":148}],"options":["It levels off","It keeps accelerating","It collapses"],"question":"What happens to the population over the next six seasons?","setup":"A small island hosts 40 rabbits with unlimited grass and no predators."},{"correctIndex":1,"explanation":"Predation and food limits impose a carrying capacity.","frames":[{"caption":"Season 1: 148 rabbits","value":148},{"caption":"Season 2: 160 rabbits","value":160},{"caption":"Season 3: 166 rabbits","value":166},{"caption":"Season 4: 169 rabbits","value":169},{"caption":"Season 5: 170 rabbits — the curve flattens","value":170}],"options":["It keeps accelerating","It levels off near a ceiling","It grows linearly"],"question":"What happens to the rabbit population now?","setup":"The same island now has foxes, and grass is running short."}] @label "Scenarios" @description "The scenario roster; each carries a setup, the question, the offered predictions with the correct index, an explanation, and the reveal frames (caption + value) that play out after the learner commits. Realizations declare their own subject's scenarios here." @tier "domain"
    title          : string = "Predict, Then Watch" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    valueMax       : number = 200 @label "Value Max" @description "Upper bound of the reveal chart's y axis." @tier "presentation"
    valueMin       : number = 0 @label "Value Min" @description "Lower bound of the reveal chart's y axis." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-predict.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-sample-accumulator.orb orbitals[0].traits[0])
trait std-learn-sample-accumulator.traits.SampleAccumulatorSim {
  alias          : LearnSampleAccumulator
  linkedEntity   : SampleAccumulatorScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED DRAW SET_BATCH_SIZE RESET SAMPLES_DRAWN ACCUMULATOR_RESET)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on DRAW) (idle -> idle on SET_BATCH_SIZE) (idle -> idle on RESET))
  emits          : (SAMPLES_DRAWN ACCUMULATOR_RESET)
  config {
    batchSize      : number = 25 @label "Batch Size" @description "Number of samples the Draw button adds per click." @synonyms "batch size, draws per click, sample batch" @tier "domain"
    bias           : number = 0.5 @label "Bias" @description "Probability the coin source draws 1, used only when sourceKind is coin." @synonyms "probability, bernoulli parameter, coin bias, p" @tier "domain"
    binCount       : number = 10 @label "Bin Count" @description "Number of histogram buckets across the 0..1 value range." @tier "presentation"
    color          : string = "#2563eb" @label "Bar Color" @tier "presentation"
    height         : number = 400 @label "Height" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    sourceKind     : string = "uniform" @label "Source Kind" @description "Distribution each draw samples from: uniform (0..1) or coin (Bernoulli 0/1 weighted by bias)." @synonyms "uniform distribution, coin flip, bernoulli trial, random sampling, source distribution" @tier "domain"
    title          : string = "Sample Accumulator" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-sample-accumulator.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-sandbox.orb orbitals[0].traits[0])
trait std-learn-sandbox.traits.LearnSandboxSim {
  alias          : LearnSandbox
  linkedEntity   : LearnSandboxScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED TOGGLE RESET SYSTEM_CHANGED SANDBOX_RESET)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on TOGGLE) (idle -> idle on RESET))
  emits          : (SYSTEM_CHANGED SANDBOX_RESET)
  config {
    animate        : boolean = false @label "Animate" @description "Enable continuous redraw loop." @tier "presentation"
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    disabledColor  : string = "#cbd5e1" @label "Disabled Node Color" @tier "presentation"
    disabledEdgeColor : string = "#e2e8f0" @label "Disabled Edge Color" @tier "presentation"
    elements       : [LearnSandboxElement] = [{"enabled":true,"id":"a","label":"Module A","weight":15,"x":100,"y":80},{"enabled":true,"id":"b","label":"Module B","weight":20,"x":300,"y":60},{"enabled":false,"id":"c","label":"Module C","weight":10,"x":500,"y":80},{"enabled":true,"id":"d","label":"Module D","weight":25,"x":200,"y":220},{"enabled":true,"id":"e","label":"Module E","weight":18,"x":420,"y":220}] @label "Elements" @description "Roster of toggleable elements; each carries its label, its weight toward the derived total, its default enabled state, and its canvas position." @synonyms "element, node, component, module, factor, contributor" @tier "domain"
    enabledColor   : string = "#2563eb" @label "Enabled Node Color" @tier "presentation"
    enabledEdgeColor : string = "#1e3a8a" @label "Enabled Edge Color" @tier "presentation"
    height         : number = 320 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "Enable pointer interaction on the canvas." @tier "presentation"
    links          : [LearnSandboxLink] = [{"from":"a","to":"b"},{"from":"b","to":"c"},{"from":"a","to":"d"},{"from":"d","to":"e"}] @label "Links" @description "Declared relationships drawn between elements; a link dims when either endpoint is disabled." @synonyms "link, edge, connection, dependency, relationship" @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    nodeRadius     : number = 34 @label "Node Radius" @tier "presentation"
    outcomeLabel   : string = "System Status" @label "Outcome Label" @description "Label prefix used in the readout describing the derived total and hold status." @tier "presentation"
    resetLabel     : string = "Reset" @label "Reset Button Label" @tier "presentation"
    threshold      : number = 60 @label "Threshold" @description "The summed weight of enabled elements must reach this value for the system to hold." @synonyms "threshold, tipping point, sufficient total" @tier "domain"
    title          : string = "System Sandbox" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    width          : number = 640 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-sandbox.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-scatter-fit.orb orbitals[0].traits[0])
trait std-learn-scatter-fit.traits.LearnScatterFitSim {
  alias          : LearnScatterFit
  linkedEntity   : LearnScatterFitScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED ADD_POINT DRAG_POINT GUESS_LINE REVEAL_FIT TOGGLE_RUN RESET LEARN_SCATTER_FIT_UPDATED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on ADD_POINT) (idle -> idle on DRAG_POINT) (idle -> idle on GUESS_LINE) (idle -> idle on REVEAL_FIT) (idle -> idle on TOGGLE_RUN) (idle -> idle on RESET))
  emits          : (LEARN_SCATTER_FIT_UPDATED LEARN_ROUND_COMPLETE)
  config {
    addPointLabel  : string = "Add Point" @label "Add Point Button Label" @tier "presentation"
    animate        : boolean = false @label "Animate" @description "Enable continuous redraw loop." @tier "presentation"
    autoRun        : boolean = false @label "Auto Run" @description "When true, INIT/MODE_SELECTED start the tick auto-adding points up to Max Points; toggle live with the Run/Pause button." @tier "domain"
    axisXMax       : number = 100 @label "X Axis Max" @description "Upper bound of the canvas x axis, in data coordinates; also the x endpoint the fit/guess lines are drawn to." @tier "domain"
    axisXMin       : number = 0 @label "X Axis Min" @description "Lower bound of the canvas x axis, in data coordinates." @tier "domain"
    axisYMax       : number = 100 @label "Y Axis Max" @description "Upper bound of the canvas y axis; also the ceiling curve samples clamp to and the high end of the guess-intercept slider default range." @tier "domain"
    axisYMin       : number = 0 @label "Y Axis Min" @description "Lower bound of the canvas y axis; also the floor curve samples clamp to and the low end of the guess-intercept slider default range." @tier "domain"
    fitColor       : string = "#2563eb" @label "Fit Curve Color" @tier "presentation"
    fitLabel       : string = "fit" @label "Fit Curve Label" @description "Legend label for the computed least-squares fit line." @tier "presentation"
    gridStep       : number = 20 @label "Grid Step" @description "Spacing between canvas gridlines, in data coordinates." @tier "presentation"
    guessColor     : string = "#dc2626" @label "Guess Curve Color" @tier "presentation"
    guessInterceptCaption : string = "Guess intercept: " @label "Guess Intercept Caption" @description "Text prefixed to the current guess-intercept value above its slider." @tier "presentation"
    guessInterceptMax : number = 100 @label "Guess Intercept Max" @description "Upper bound of the guess-intercept slider; typically set to axisYMax." @tier "domain"
    guessInterceptMin : number = 0 @label "Guess Intercept Min" @description "Lower bound of the guess-intercept slider; typically set to axisYMin." @tier "domain"
    guessInterceptStep : number = 1 @label "Guess Intercept Step" @tier "domain"
    guessLabel     : string = "your guess" @label "Guess Curve Label" @description "Legend label for the learner's proposed line, shown while guessMode is on and the fit isn't yet revealed." @tier "presentation"
    guessMode      : boolean = true @label "Guess Mode" @description "When true the learner's guessed line is shown instead of the fit until Reveal Fit, and the guess is scored against least squares." @synonyms "guess the line, prediction, estimate the fit" @tier "domain"
    guessSlopeCaption : string = "Guess slope: " @label "Guess Slope Caption" @description "Text prefixed to the current guess-slope value above its slider." @tier "presentation"
    guessSlopeMax  : number = 3 @label "Guess Slope Max" @description "Upper bound of the guess-slope slider." @tier "domain"
    guessSlopeMin  : number = -3 @label "Guess Slope Min" @description "Lower bound of the guess-slope slider." @tier "domain"
    guessSlopeStep : number = 0.05 @label "Guess Slope Step" @tier "domain"
    height         : number = 400 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    initialPoints  : [LearnScatterFitPoint] = [{"color":"#334155","id":"p0","label":"","radius":5,"x":15,"y":25},{"color":"#334155","id":"p1","label":"","radius":5,"x":32,"y":40},{"color":"#334155","id":"p2","label":"","radius":5,"x":48,"y":44},{"color":"#334155","id":"p3","label":"","radius":5,"x":63,"y":62},{"color":"#334155","id":"p4","label":"","radius":5,"x":80,"y":70}] @label "Initial Points" @description "Scatter points the canvas starts with, in axis data coordinates; Reset reseeds from this roster." @synonyms "seed points, dataset, scatter data, sample" @tier "domain"
    interactive    : boolean = true @label "Interactive" @description "Enable pointer interaction on the canvas — required for dragging points." @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    maxPoints      : number = 20 @label "Max Points" @description "Cap on accumulated scatter points; Add Point and the auto-run tick stop once reached, until Reset." @tier "domain"
    narrationAddedTemplate : string = "point added" @label "Added Narration Template" @description "Narration phrase after a point is added (button or tick), assembled as \"<template> <n> — r = .., R² = ..\"." @tier "domain"
    narrationAutoAddingTemplate : string = "Auto-adding — tick adds a new point." @label "Auto-Adding Narration" @description "Narration shown after Run is pressed." @tier "domain"
    narrationFitRevealedTemplate : string = "fit revealed" @label "Fit Revealed Narration Template" @description "Narration phrase after Reveal Fit, assembled as \"<template> — r = .., R² = .. — guess score <score>%\"." @tier "domain"
    narrationGuessUpdatedTemplate : string = "guess updated — score" @label "Guess Updated Narration Template" @description "Narration phrase after a guess slider moves, assembled as \"<template> <score>%\"." @tier "domain"
    narrationLoadedTemplate : string = "point(s) loaded" @label "Loaded Narration Template" @description "Narration phrase after INIT/MODE_SELECTED/Reset load the seed points, assembled as \"<n> <template> — r = .., R² = ..\"." @tier "domain"
    narrationMaxReachedSuffix : string = " — max points reached" @label "Max Reached Narration Suffix" @description "Suffix appended to the added-point narration once maxPoints is hit." @tier "domain"
    narrationMovedTemplate : string = "point moved" @label "Moved Narration Template" @description "Narration phrase after a point is dragged, assembled as \"<template> — r = .., R² = ..\"." @tier "domain"
    narrationPausedTemplate : string = "Paused — add manually with Add Point." @label "Paused Narration" @description "Narration shown after Pause is pressed." @tier "domain"
    newPointColor  : string = "#334155" @label "New Point Color" @description "Fill color assigned to points created by Add Point or the auto-add tick." @tier "presentation"
    newPointRadius : number = 5 @label "New Point Radius" @tier "presentation"
    pauseLabel     : string = "Pause" @label "Pause Button Label" @tier "presentation"
    pointMarginPct : number = 0.05 @label "Point Margin Percent" @description "Fraction of each axis span kept clear at both ends when Add Point/the tick place a new random point, so new points never land flush against the axis edge." @tier "domain"
    resetLabel     : string = "Reset" @label "Reset Button Label" @tier "presentation"
    residualColor  : string = "#f59e0b" @label "Residual Color" @tier "presentation"
    residualDash   : string = "dashed" @label "Residual Dash Style" @tier "presentation" @values (dashed dotted)
    revealLabel    : string = "Reveal Fit" @label "Reveal Fit Button Label" @tier "presentation"
    runLabel       : string = "Run" @label "Run Button Label" @tier "presentation"
    showAxes       : boolean = true @label "Show Axes" @tier "presentation"
    showGrid       : boolean = true @label "Show Grid" @tier "presentation"
    showR          : boolean = true @label "Show r and R²" @description "Show the correlation coefficient r and coefficient of determination R² under the canvas." @synonyms "correlation coefficient, r squared, goodness of fit" @tier "domain"
    showResiduals  : boolean = true @label "Show Residuals" @description "Draw a dashed segment from each point to the fit line — the errors least squares minimizes." @synonyms "residuals, errors, deviations" @tier "domain"
    showTickLabels : boolean = true @label "Show Tick Labels" @tier "presentation"
    title          : string = "Scatter Fit" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    width          : number = 600 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-scatter-fit.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-scenario.orb orbitals[0].traits[0])
trait std-learn-scenario.traits.ScenarioSim {
  alias          : LearnScenario
  linkedEntity   : ScenarioScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED CHOOSE RESTART CHOICE_MADE SCENARIO_RESTARTED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on CHOOSE) (idle -> idle on RESTART))
  emits          : (CHOICE_MADE SCENARIO_RESTARTED)
  config {
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    metricALabel   : string = "Budget" @label "Metric A Label" @description "Display name of the first tracked consequence metric." @tier "domain"
    metricAStart   : number = 100 @label "Metric A Start" @tier "domain"
    metricBLabel   : string = "Support" @label "Metric B Label" @description "Display name of the second tracked consequence metric." @tier "domain"
    metricBStart   : number = 50 @label "Metric B Start" @tier "domain"
    nodes          : [ScenarioNode] = [{"choices":[{"deltaA":-60,"deltaB":10,"label":"Build a levee now","next":"levee","note":"Fast protection, most of the budget gone."},{"deltaA":-25,"deltaB":-5,"label":"Restore the upstream wetlands","next":"wetlands","note":"Cheaper and greener, but slower to work."}],"id":"start","situation":"Your town's river floods every spring. The council asks you to lead the response."},{"choices":[{"deltaA":-30,"deltaB":-10,"label":"Raise the levee again","next":"end-lock-in","note":"Costs keep compounding."},{"deltaA":-20,"deltaB":15,"label":"Add wetlands as a second line","next":"end-hybrid","note":"Late, but it eases the pressure."}],"id":"levee","situation":"The levee holds the first spring, but silt builds up and the river rises higher each year."},{"choices":[{"deltaA":-15,"deltaB":25,"label":"Expand the wetland corridor","next":"end-green","note":"The town rallies behind the project."},{"deltaA":10,"deltaB":5,"label":"Bank the savings","next":"end-thrifty","note":"Prudent, though the corridor stays small."}],"id":"wetlands","situation":"Two springs pass; the wetlands now absorb most floods, and wildlife is returning."},{"choices":[],"id":"end-lock-in","situation":"You are locked into an arms race with the river: protected, but at ever-growing cost."},{"choices":[],"id":"end-hybrid","situation":"The hybrid defense works: the levee buys time and the wetlands cut the peak floods."},{"choices":[],"id":"end-green","situation":"The restored river corridor protects the town and becomes its most loved public space."},{"choices":[],"id":"end-thrifty","situation":"The town stays safe in normal years, with savings in reserve for a bigger flood."}] @label "Nodes" @description "The decision graph; each node carries a situation and its choices, each choice naming the next node, metric deltas, and a consequence note. A node with no choices ends the run. Realizations declare their own subject's decision tree here." @tier "domain"
    restartLabel   : string = "Play Again" @label "Restart Label" @tier "presentation"
    startId        : string = "start" @label "Start Node" @description "Id of the node the scenario opens on." @tier "domain"
    title          : string = "Decision Scenario" @label "Title" @description "Title shown above the scenario." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-scenario.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-sim-3d.orb orbitals[0].traits[0])
trait std-learn-sim-3d.traits.Learn3DSimTransport {
  alias          : LearnSim3d
  linkedEntity   : Learn3DSimScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED RUN PAUSE RESET SPEED_HALF SPEED_NORMAL SPEED_DOUBLE SPEED_QUAD SIM_3D_TICK SIM_3D_UPDATED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on RUN) (idle -> idle on PAUSE) (idle -> idle on RESET) (idle -> idle on SPEED_HALF) (idle -> idle on SPEED_NORMAL) (idle -> idle on SPEED_DOUBLE) (idle -> idle on SPEED_QUAD))
  emits          : (SIM_3D_TICK SIM_3D_UPDATED)
  config {
    dt             : number = 0.02 @label "Timestep" @description "Simulated seconds per tick before the speed multiplier; the effective step emitted on SIM_3D_TICK is dt x speedMultiplier." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    running        : boolean = true @label "Running" @description "When true the clock starts ticking on INIT; the Reset arm restores this value." @tier "domain"
    title          : string = "3D Simulation" @label "Title" @description "Title shown above the transport controls." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-sim-3d.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-slope-probe.orb orbitals[0].traits[0])
trait std-learn-slope-probe.traits.LearnSlopeProbe {
  alias          : LearnSlopeProbe
  linkedEntity   : SlopeProbeState
  category       : lifecycle
  states         : (idle*)
  events         : (INIT SET_CURVE BODY_MOVED RESTART SLOPE_CHANGED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on SET_CURVE) (idle -> idle on BODY_MOVED) (idle -> idle on RESTART))
  emits          : (SLOPE_CHANGED)
  config {
    curve          : [ProbeSample] = [] @label "Curve" @description "Surface samples (x strictly increasing) of the graph being ridden — the same table the body skates and the canvas draws, so the readout matches what is underfoot. Seeded onto the entity on INIT; the live curve is entity.curve — SET_CURVE replaces it at runtime (stitched mega-curves) and RESTART does not reseed it." @tier "domain"
    running        : boolean = true @label "Running" @description "When true the probe derives the readout off BODY_MOVED; toggle to freeze it (the board hides the tangent overlays when probing goes stale)." @tier "domain"
    triRun         : number = 1 @label "Triangle Run" @description "Horizontal leg of the rise-over-run triangle; the vertical leg is slope × triRun, so triRun = 1 reads the slope directly." @tier "presentation"
    window         : number = 1.5 @label "Tangent Window" @description "Half-length (world units along the tangent) of the tangent segment and of the glow sample window around the contact point." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-slope-probe.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-speed-drill.orb orbitals[0].traits[0])
trait std-learn-speed-drill.traits.SpeedDrillSim {
  alias          : LearnSpeedDrill
  linkedEntity   : SpeedDrillScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED ANSWER NEXT RETRY ANSWER_JUDGED PROMPT_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on ANSWER) (idle -> idle on NEXT) (idle -> idle on RETRY))
  emits          : (ANSWER_JUDGED PROMPT_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  config {
    basePoints     : number = 10 @label "Base Points" @description "Points for a correct answer regardless of speed." @tier "domain"
    items          : [SpeedDrillItem] = [{"correctIndex":1,"options":["54","56","63","48"],"prompt":"7 × 8"},{"correctIndex":0,"options":["54","56","45","63"],"prompt":"9 × 6"},{"correctIndex":2,"options":["124","132","144","148"],"prompt":"12 × 12"}] @label "Items" @description "The drill roster; each item carries a prompt, its options, and the index of the correct option. Realizations declare their own subject's items here." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    nextLabel      : string = "Next" @label "Next Label" @tier "presentation"
    retryLabel     : string = "Try Again" @label "Retry Label" @tier "presentation"
    speedBonus     : number = 10 @label "Speed Bonus" @description "Maximum extra points awarded in proportion to the time left on the clock." @tier "domain"
    timeLimit      : number = 6 @label "Time Limit" @description "Seconds the learner has to answer each item before it counts as a miss." @tier "domain"
    title          : string = "Speed Drill" @label "Title" @description "Title shown above the drill." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-speed-drill.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-stepper.orb orbitals[0].traits[0])
trait std-learn-stepper.traits.LearnStepperSim {
  alias          : LearnStepper
  linkedEntity   : LearnStepperScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED NEXT PREV FILTER_CATEGORY RESET_STEPPER STEPPER_ADVANCED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on NEXT) (idle -> idle on PREV) (idle -> idle on FILTER_CATEGORY) (idle -> idle on RESET_STEPPER))
  emits          : (STEPPER_ADVANCED)
  config {
    allLabel       : string = "All" @label "All Filter Label" @tier "presentation"
    allSummary     : string = "Taken together, every stage contributes to the full sequence. No single category tells the whole story." @label "All-Lens Summary" @description "Narrative summary shown when no category filter is applied — the full, multi-category picture." @synonyms "multi-causal, full picture, no single lens" @tier "domain"
    animate        : boolean = false @label "Animate" @description "Enable continuous redraw loop." @tier "presentation"
    atEndNote      : string = " — Last stage; press Reset to review from the start." @label "At-End Note" @description "Text appended to the current stage's description once the cursor reaches the final stage, narrating that Next is now deliberately clamped rather than doing nothing." @tier "presentation"
    axisMarginLeft : number = 60 @label "Axis Left Margin" @tier "presentation"
    axisMarginRight : number = 60 @label "Axis Right Margin" @tier "presentation"
    axisY          : number = 220 @label "Axis Y" @description "Canvas y-position of the horizontal axis." @tier "presentation"
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    categories     : [LearnStepperCategory] = [{"category":"a","color":"#7c3aed","label":"Category A"},{"category":"b","color":"#15803d","label":"Category B"}] @label "Categories" @description "Marker color and button label per stage category, used for the axis dots, the legend, the FILTER_CATEGORY buttons, and the running per-category tally." @synonyms "category color, category legend, stage category, filter lens" @tier "domain"
    categorySummaries : [LearnStepperCategorySummary] = [{"category":"a","summary":"Viewed through Category A alone, only the stages tagged A are highlighted."},{"category":"b","summary":"Viewed through Category B alone, only the stages tagged B are highlighted."}] @label "Category Summaries" @description "Narrative summary shown when the learner filters the sequence to a single category — how the sequence reads through that lens alone." @synonyms "historiographical lens, primary source lens, single-cause narrative, category narrative, visible thread" @tier "domain"
    height         : number = 420 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "Enable pointer interaction on the canvas." @tier "presentation"
    markerHighlightRadius : number = 14 @label "Marker Highlight Radius" @description "Radius of the current step's marker, larger than an ordinary stage marker." @tier "presentation"
    markerRadius   : number = 8 @label "Marker Radius" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    maxPosition    : number = 4 @label "Max Position" @description "Latest position on the axis (after the last stage)." @tier "domain"
    minPosition    : number = 0 @label "Min Position" @description "Earliest position on the axis (before the first stage)." @tier "domain"
    stages         : [LearnStepperStage] = [{"category":"a","description":"First stage in the sequence.","id":"stage-1","label":"Stage One","position":1},{"category":"b","description":"Second stage in the sequence.","id":"stage-2","label":"Stage Two","position":2},{"category":"a","description":"Third stage in the sequence.","id":"stage-3","label":"Stage Three","position":3}] @label "Stages" @description "Ordered roster of stages (position, label, category, description) stepped through by NEXT/PREV and filtered by FILTER_CATEGORY. Sorted ascending by position." @synonyms "stage roster, sequence, timeline, cycle, phase, event roster, ordered stages" @tier "domain"
    startPrompt    : string = "Press Next to begin." @label "Start Prompt" @description "Narration shown before the learner has advanced past the first stage." @tier "presentation"
    title          : string = "Stepper" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    unreachedColor : string = "#d6d3d1" @label "Unreached Marker Color" @description "Color of stage markers the learner has not yet stepped to." @tier "presentation"
    width          : number = 640 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-stepper.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-tour-3d.orb orbitals[0].traits[0])
trait std-learn-tour-3d.traits.Learn3DTourSim {
  alias          : LearnTour3d
  linkedEntity   : Learn3DTourScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED TOUR SELECT_STATION RESET SYNC_STATIONS TOUR_3D_UPDATED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on TOUR) (idle -> idle on SELECT_STATION) (idle -> idle on RESET) (idle -> idle on SYNC_STATIONS))
  emits          : (TOUR_3D_UPDATED LEARN_ROUND_COMPLETE)
  config {
    azimuth        : number = 0.6 @label "Azimuth" @description "Camera orbit azimuth in radians; the learner can orbit freely on top of this." @tier "presentation"
    backdrop       : [Learn3DStation] = [] @label "Backdrop Nodes" @description "Non-station scene geometry rendered under the tour stations (painted first, stations on top) — painted but never tour stops and never highlight-selected; SYNC_STATIONS swaps it together with the roster, so a composed preset coordinator can re-skin the whole scene per preset." @synonyms "backdrop, scenery, geometry, context nodes, 3d" @tier "domain"
    backgroundColor : string = "#0f172a" @label "Background Color" @description "Canvas background color — a dark stage makes translucent shells and station colors read in 3D." @tier "presentation"
    edges          : [Learn3DEdge] = [] @label "Edges" @description "Optional connector lines drawn between stations, by id." @synonyms "edge, link, connector, tether" @tier "domain"
    fov            : number = 50 @label "Field of View" @description "Perspective camera field of view in degrees." @tier "presentation"
    height         : number = 400 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    lighting       : Lighting3D = {} @label "Lighting" @description "3D scene light rig as data; empty object uses the standard rig." @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    post           : Post3D = {} @label "Post Processing" @description "3D post-processing stack (bloom/vignette) as data; empty object disables it." @tier "presentation"
    resetLabel     : string = "Reset" @label "Reset Button Label" @description "Label text for the button that returns the tour to the first station." @tier "presentation"
    stations       : [Learn3DStation] = [{"caption":"The first stop on the tour — the camera retargets here and the narration reads its caption.","color":"#2563eb","id":"alpha","name":"Station Alpha","opacity":1,"radius":1,"shape":"sphere","x":0,"y":0,"z":0},{"caption":"The second stop — press Tour again or click a shape to advance the selection.","color":"#7c3aed","id":"beta","name":"Station Beta","opacity":1,"radius":0.8,"shape":"sphere","x":3,"y":1,"z":-1},{"caption":"The final stop — once every station has been visited the tour marks itself complete.","color":"#0891b2","id":"gamma","name":"Station Gamma","opacity":1,"radius":0.8,"shape":"sphere","x":-3,"y":-1,"z":1}] @label "Stations" @description "The station roster in didactic tour order — each with scene position, mesh shape, and a caption. Tour and clicks enlarge the selected station, retarget the camera onto its x/y/z, and narrate its caption." @synonyms "station, stop, waypoint, tour, landmark, 3d" @tier "domain"
    title          : string = "3D Guided Tour" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    tourLabel      : string = "Tour" @label "Tour Button Label" @description "Label text for the button that advances the tour to the next station." @tier "presentation"
    width          : number = 600 @label "Width" @description "Canvas width in pixels." @tier "presentation"
    zoom           : number = 1 @label "Zoom" @description "Camera zoom factor for the 3D scene." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-tour-3d.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-trace-player.orb orbitals[0].traits[0])
trait std-learn-trace-player.traits.TracePlayerSim {
  alias          : LearnTracePlayer
  linkedEntity   : TracePlayerScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED PLAY PAUSE RESTART FRAME_ADVANCED TRACE_DONE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on PLAY) (idle -> idle on PAUSE) (idle -> idle on RESTART))
  emits          : (FRAME_ADVANCED TRACE_DONE)
  config {
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    baseColor      : string = "#3b82f6" @label "Base Bar Color" @description "Color of bars not highlighted in the current frame." @tier "presentation"
    frames         : [TraceFrame] = [{"caption":"Unsorted array.","highlights":[],"label":"Start","values":[5,3,8,1,9,2]},{"caption":"Compare the first two elements; 5 > 3 so swap them.","highlights":[0,1],"label":"Compare 5, 3","values":[3,5,8,1,9,2]},{"caption":"Compare the next pair; already in order.","highlights":[1,2],"label":"Compare 5, 8","values":[3,5,8,1,9,2]},{"caption":"8 > 1 so swap them.","highlights":[2,3],"label":"Compare 8, 1","values":[3,5,1,8,9,2]},{"caption":"Already in order.","highlights":[3,4],"label":"Compare 8, 9","values":[3,5,1,8,9,2]},{"caption":"9 > 2 so swap them; one pass complete.","highlights":[4,5],"label":"Compare 9, 2","values":[3,5,1,8,2,9]}] @label "Frames" @description "Ordered roster of frames (label, caption, values, highlights) stepped through by Play/Pause/Restart. Each frame's values render as bars; highlighted indices pick out which bars changed." @synonyms "trace, animation frames, snapshot roster, playback sequence, keyframes" @tier "domain"
    height         : number = 400 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    highlightColor : string = "#f59e0b" @label "Highlight Bar Color" @description "Color of bars whose index appears in the current frame's highlights." @tier "presentation"
    loop           : boolean = false @label "Loop" @description "When true, autoplay wraps from the last frame back to the first instead of stopping and emitting TRACE_DONE." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    tickMs         : number = 500 @label "Tick Milliseconds" @description "Milliseconds per frame shown in the readout; the autoplay cadence." @tier "presentation"
    title          : string = "Trace Player" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    width          : number = 600 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-trace-player.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-transport.orb orbitals[0].traits[0])
trait std-learn-transport.traits.LearnTransportSim {
  alias          : LearnTransport
  linkedEntity   : LearnTransportScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED STEP TOGGLE_RUN RESET LEARN_STEP LEARN_RESET LEARN_UPDATED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on STEP) (idle -> idle on TOGGLE_RUN) (idle -> idle on RESET))
  emits          : (LEARN_STEP LEARN_RESET LEARN_UPDATED)
  config {
    autoRun        : boolean = false @label "Auto Run" @description "When true the clock starts stepping on INIT; the Reset arm restores this value." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    stepIntervalMs : number = 500 @label "Step Interval (ms)" @description "Milliseconds of running clock per domain step — the 32ms base tick accumulates elapsed time and fires LEARN_STEP each time this interval elapses. 300-900 suits narrated steppers; 32 fires every frame for continuous sims." @tier "domain"
    title          : string = "Learning Instrument" @label "Title" @description "Title shown above the transport controls." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-transport.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-tree.orb orbitals[0].traits[0])
trait std-learn-tree.traits.LearnTreeSim {
  alias          : LearnTree
  linkedEntity   : LearnTreeScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED INSERT_VALUE DELETE_VALUE RUN_TRAVERSAL TOGGLE_RUN RESET TREE_UPDATED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on INSERT_VALUE) (idle -> idle on DELETE_VALUE) (idle -> idle on RUN_TRAVERSAL) (idle -> idle on TOGGLE_RUN) (idle -> idle on RESET))
  emits          : (TREE_UPDATED)
  config {
    autoRun        : boolean = false @label "Auto Run" @description "When true, the tick auto-steps the traversal sweep started by Traverse; toggle live with the Run/Pause button. Has no effect on Insert/Delete, which stay manual." @synonyms "auto run, auto step, auto play" @tier "domain"
    backgroundColor : string = "#f8fafc" @label "Background Color" @description "Canvas background color." @tier "presentation"
    balanced       : boolean = false @label "Balance Readout" @description "When true, each insert's narration reports the tree's current height against its node count so the learner can judge balance; no auto-rotation is performed." @synonyms "balance, height, balance readout" @tier "domain"
    height         : number = 400 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    showComparisons : boolean = true @label "Show Comparisons" @description "Include each left/right comparison in the narration while a value descends; turn off for a terse attach-only narration." @synonyms "comparisons, narration detail" @tier "presentation"
    title          : string = "Ordered Tree" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    traversalKind  : string = "inorder" @label "Traversal Kind" @description "Which sweep Traverse replays — inorder (sorted order, left to right), preorder (root before children), or levelorder (breadth first, top to bottom)." @synonyms "traversal, in-order, pre-order, level-order, sweep" @tier "domain"
    values         : [number] = [50,30,70,20,40,60,80] @label "Values" @description "The values Insert feeds into the tree, one per descent, in order." @synonyms "keys, values to insert, dataset, sequence" @tier "domain"
    width          : number = 600 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-tree.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-lifecycle.orb orbitals[0].traits[0])
trait std-lifecycle.traits.LifecycleScheduler {
  alias          : Lifecycle
  linkedEntity   : LifecycleRunLog
  category       : lifecycle
  states         : (idle* scanning)
  events         : (INIT ScanRecordsLoaded ScanFailed LifecycleStepped LifecycleTransitioned)
  transitions    : ((idle -> idle on INIT) (idle -> scanning on ScanRecordsLoaded) (idle -> idle on ScanRecordsLoaded) (idle -> idle on ScanFailed) (scanning -> scanning on LifecycleStepped) (scanning -> scanning on ScanRecordsLoaded) (scanning -> idle on ScanRecordsLoaded) (scanning -> idle on ScanFailed))
  emits          : (LifecycleTransitioned ScanRecordsLoaded ScanFailed LifecycleStepped)
  config {
    ageDays        : number = 30 @label "How old (in days) before a record is transitioned?" @description "Records older than this many days move from the source status to the destination status." @synonyms "age threshold, days until archive, expiry days, max age, retention days" @tier "infra"
    dateField      : string = "ranAt" @label "Which date field measures the record's age?" @description "Numeric (ms-epoch) entity field compared against the age threshold (e.g. 'createdAt')." @tier "internal"
    dryRun         : boolean = false @label "Run in dry-run mode (no changes written)?" @description "When true, the scan runs but no status transitions are persisted." @synonyms "test mode, preview, simulate, dry run, no write" @tier "infra"
    enabled        : boolean = false @label "Auto-archive old records" @description "Automatically change the status of records once they age past a threshold. Off by default." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, retention, ttl, expire, archive after, sunset, lifecycle, age out, time-based status, scheduled transitions, expire old records, auto-archive" @tier "infra"
    fromStatus     : string = "" @label "Which status triggers the age-out?" @description "Only records currently in this status are candidates for automatic transition." @synonyms "source status, current status, eligible status, starting status" @tier "infra"
    targetEntity   : entity = "LifecycleRunLog" @label "Target entity" @description "Entity name to scan and transition (e.g. 'Task'). Defaults to the atom's own log so the standalone validates; rebind per composition. Typed `entity`, so a rename of the bound entity threads through to this value automatically." @tier "internal"
    toStatus       : string = "" @label "What status should old records move to?" @description "Status assigned once a record ages past the threshold (e.g. 'archived', 'expired')." @synonyms "target status, end status, destination status, archive status" @tier "infra"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-lifecycle.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-list.orb orbitals[0].traits[0])
trait std-list.traits.ListItemBrowse {
  alias          : List
  linkedEntity   : ListItem
  category       : interaction
  states         : (loading* browsing error)
  events         : (INIT ListItemLoaded ListItemLoadFailed REFETCH_QUERY REFETCH_FILTER REFETCH_PAGE RETRY CREATE EDIT DELETE)
  transitions    : ((loading -> loading on INIT) (loading -> browsing on ListItemLoaded) (loading -> error on ListItemLoadFailed) (browsing -> loading on INIT) (browsing -> browsing on REFETCH_QUERY) (browsing -> browsing on REFETCH_FILTER) (browsing -> browsing on REFETCH_PAGE) (browsing -> browsing on ListItemLoadFailed) (browsing -> browsing on ListItemLoaded) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (CREATE EDIT DELETE ListItemLoaded ListItemLoadFailed)
  config {
    bodySearch     : boolean = false @label "Show the list's own search box?" @description "Embeds a search box above the grid. Set true only when the page has no other search affordance (e.g. no page-level std-search), so the surface shows one search box instead of two. False is the default — this atom has never had a search box (0 consumers today)." @synonyms "inline search, list search, built-in search, show search" @tier "presentation"
    displayPageSize : number = 20 @label "How many rows to show at once?" @description "Rows visible per page before the data-grid's own pagination control appears — 20 matches the CRUD-list density sweet spot (Miller's law, 10-25 rows)." @synonyms "visible rows, items per page, display limit, show per page" @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the grid?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the rows; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, the right setting whenever the page already composes std-filter beside this list and routes XFilter.FILTER -> REFETCH_FILTER — that is the wired owner and remains the primary path. Use this knob only for a standalone list with no page-level filter affordance." @synonyms "filter bar, faceted filters, field filters, dropdowns" @tier "presentation"
    pageSize       : number = 20 @label "How many rows per page when paging?" @description "Records fetched from the server per REFETCH_PAGE request. The initial load and search/filter refetches remain unpaginated (load everything that matches) unless a consumer wires REFETCH_PAGE, so the default list surface is unchanged." @synonyms "fetch limit, records per page, page limit" @tier "presentation"
    searchField    : string = "name" @label "Which column does the search box match against?" @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `name` column must set this to a real field (e.g. title, label) or the search box can never match a row." @synonyms "search column, search on field, match field, search key" @tier "policy"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the list search box." @synonyms "search hint, placeholder, search box text" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-list.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-list.orb orbitals[0].traits[1])
trait std-list.traits.ListItemPersistor {
