pattern state-graph {
  category       : game
  desc           : "StateGraph (molecule) Dumb visual renderer for a state-machine graph: lays states out on a circle, draws the player's transitions as SVG arrows, and emits a node-click event. All state (which transitions exist, the pending \"from\" selection, test results) lives in the .lolo FSM — this molecule only renders and reports clicks."
  props {
    addingFrom?            : string
    className?             : string
    currentState?          : string
    height?                : number
    initialState?          : string
    nodeClickEvent?        : string
    selectedState?         : string
    states                 : array
    transitions?           : array
    width?                 : number
  }
  emits          : ()
  requires       : ()
  source         : "@almadar/core/patterns (PATTERN_REGISTRY): state-graph"
}

pattern state-json-view {
  category       : game
  desc           : "StateJsonView Component Shows a state machine's definition as an expandable code block, so the learner sees the declarative schema behind the visual graph. Dumb molecule: takes the machine as plain typed fields (name/states/initialState/transitions) — the .lolo organism owns the entity and the molecule renders + stringifies it."
  props {
    className?             : string
    defaultExpanded?       : boolean
    initialState           : string
    label?                 : string
    name                   : string
    states                 : array
    transitions            : array
  }
  emits          : ()
  requires       : ()
  source         : "@almadar/core/patterns (PATTERN_REGISTRY): state-json-view"
}

