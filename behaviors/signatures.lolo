;; From @almadar/std (behaviors/registry/ui/game/organisms/std-arcade-board-3d.orb orbitals[0].traits[0])
trait std-arcade-board-3d.traits.ArcadeIntent {
  alias          : ArcadeBoard3d
  linkedEntity   : GameState
  category       : interaction
  states         : (playing*)
  events         : (INIT UNIT_CLICK TILE_CLICK CANCEL FEATURE_CLICK PLAY_AGAIN MOVE WANDER PLAY_MACHINE RESTART)
  transitions    : ((playing -> playing on INIT) (playing -> playing on UNIT_CLICK) (playing -> playing on TILE_CLICK) (playing -> playing on CANCEL) (playing -> playing on FEATURE_CLICK) (playing -> playing on PLAY_AGAIN))
  emits          : (MOVE WANDER PLAY_MACHINE RESTART TILE_CLICK UNIT_CLICK FEATURE_CLICK CANCEL)
  config {
    assetManifest  : AssetManifest = {"effects":{},"features":{},"terrains":{},"units":{}} @label "Asset Manifest" @description "Per-role model manifest resolving tile/unit/feature models by terrain/category key." @tier "presentation"
    bgColor        : string = "#12161d" @label "Bg Color" @description "Canvas background color." @tier "presentation"
    cameraMode     : string = "isometric" @label "Camera Mode" @description "3D canvas camera mode." @tier "presentation"
    features       : [Feature] = [] @label "Features" @description "Arcade machines + decorations rendered on the board (static; matched against machines for playability)." @tier "presentation"
    fxPresets      : [FxPreset] = [{"color":"#ffd23f","color2":"#ff6b35","count":7,"glow":0.16,"shape":"spark","size":0.55,"type":"score","vy":-0.3},{"color":"#38bdf8","color2":"#0c4a6e","count":4,"shape":"puff","size":0.4,"type":"info"}] @label "Fx Presets" @description "This board's effect vocabulary — one look/recipe row per fx type its mechanics emit; unknown types fall back to a neutral spark." @tier "presentation"
    goalText       : string = "Collect tickets from the arcade machines to win" @label "Goal Text" @description "Static HUD hint describing the win condition." @tier "presentation"
    gridHeight     : number = 12 @label "Grid Height" @description "Grid row count (matches HeroAuthority.gridHeight)." @tier "presentation"
    gridWidth      : number = 12 @label "Grid Width" @description "Grid column count (matches HeroAuthority.gridWidth)." @tier "presentation"
    howText        : string = "Click your kid, then click an adjacent tile to walk; click a machine to play a token" @label "How Text" @description "Static HUD hint describing the controls." @tier "presentation"
    movementRange  : number = 1 @label "Movement Range" @description "Max manhattan distance the hero may step, or reach a machine, per action." @tier "domain"
    scale          : number = 0.45 @label "Scale" @description "Canvas render scale." @tier "presentation"
    ticketsLabel   : string = "Tickets" @label "Tickets Label" @description "HUD label for the tickets-won counter." @tier "presentation"
    tokensLabel    : string = "Tokens" @label "Tokens Label" @description "HUD label for the remaining-tokens counter." @tier "presentation"
    unitScale      : number = 1 @label "Unit Scale" @description "Unit draw-size multiplier." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/organisms/std-arcade-board-3d.orb orbitals[0].traits[0])"
}

