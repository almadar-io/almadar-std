trait std-tag-strip.traits.TagStrip {
  alias          : TagStrip
  linkedEntity   : StripTag
  category       : interaction
  states         : (idle* loading ready adding creating removing)
  events         : (INIT TagStripOptions TagStripLoadFailed SHOW_TAG_STRIP ADD_TAG REMOVE_TAG TagStripTagCreated TagStripAddOptions TagStripRemoveOptions TAGS_CHANGED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on TagStripOptions) (idle -> idle on TagStripLoadFailed) (idle -> loading on SHOW_TAG_STRIP) (loading -> loading on SHOW_TAG_STRIP) (loading -> ready on TagStripOptions) (loading -> idle on TagStripLoadFailed) (ready -> loading on SHOW_TAG_STRIP) (ready -> adding on ADD_TAG) (ready -> removing on REMOVE_TAG) (ready -> ready on TagStripTagCreated) (adding -> loading on SHOW_TAG_STRIP) (adding -> ready on TagStripAddOptions) (adding -> creating on TagStripAddOptions) (adding -> idle on TagStripLoadFailed) (creating -> loading on SHOW_TAG_STRIP) (creating -> ready on TagStripTagCreated) (creating -> idle on TagStripLoadFailed) (removing -> loading on SHOW_TAG_STRIP) (removing -> ready on TagStripRemoveOptions) (removing -> idle on TagStripLoadFailed))
  emits          : (TAGS_CHANGED ADD_TAG REMOVE_TAG TagStripOptions TagStripAddOptions TagStripRemoveOptions TagStripTagCreated TagStripLoadFailed)
  config {
