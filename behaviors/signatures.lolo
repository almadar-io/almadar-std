  states         : (idle* checked)
  events         : (INIT LOOKUP RESET KEY_HIT KEY_MISS)
  transitions    : ((idle -> idle on INIT) (idle -> checked on LOOKUP) (checked -> checked on INIT) (checked -> idle on RESET))
  emits          : (KEY_HIT KEY_MISS)
  config {
