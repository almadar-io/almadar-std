}

form config-orbital {
  syntax  : "orbital Name { ... config { browseColumns : array = [] } }"
  desc    : "An orbital's own declared config knobs — the surface it publishes for importers via Alias.orbitals.X, distinct from a call-site config override of an ALREADY-imported orbital's knobs (which lives on the orbital-reference's own config {} block instead)."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/mod.rs (parse_orbital, config branch) + orbital-rust/crates/orbital-lolo/src/parser/trait.rs (parse_config_block)"
}

form uses-config {
  syntax  : "uses A from \"std/behaviors/std-time-tracking\" { config { appName = \"Timesheets\" } }"
  desc    : "A uses import with a body block overriding the imported behavior's app-level config knobs (config-app) for every orbital taken from this alias."
