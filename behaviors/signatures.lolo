trait std-tag-taxonomy.traits.TagBrowse {
  alias          : TagTaxonomy
  linkedEntity   : Tag
  category       : interaction
  states         : (loading* browsing creating editing error)
  events         : (LEVEL_RELOAD INIT TagLoaded TagLoadFailed SELECT_TAG SHOW_ROOT NEW_TAG COMMIT_TAG CANCEL_TAG CLOSE TagCreated TagCreateFailed TagSelected)
  transitions    : ((loading -> loading on LEVEL_RELOAD) (loading -> loading on INIT) (loading -> browsing on TagLoaded) (loading -> error on TagLoadFailed) (browsing -> loading on INIT) (browsing -> editing on SELECT_TAG) (browsing -> loading on SHOW_ROOT) (browsing -> browsing on TagLoaded) (browsing -> creating on NEW_TAG) (browsing -> error on TagLoadFailed) (creating -> creating on COMMIT_TAG) (creating -> loading on CANCEL_TAG) (creating -> loading on CLOSE) (creating -> loading on TagCreated) (creating -> creating on TagCreateFailed) (editing -> loading on INIT) (editing -> editing on SELECT_TAG) (editing -> editing on TagSelected) (editing -> browsing on TagLoaded) (editing -> error on TagLoadFailed) (error -> loading on INIT))
  emits          : (SELECT_TAG TagLoaded TagLoadFailed TagSelected COMMIT_TAG CANCEL_TAG LEVEL_RELOAD TagCreated TagCreateFailed)
  config {
    allowEdit      : boolean = false @label "Allow editing" @description "Render the create-tag affordance: creations land at the level currently open (top level, or inside the drilled-into category). Rename is a follow-up (ledgered)." @tier "domain"
    createLabel    : string = "New tag" @label "Create-button label" @description "Label on the create affordance and its form heading — say what this taxonomy calls its entries (New tag, New category, New topic)." @synonyms "add label, new tag label, create caption" @tier "presentation"
    rootLabel      : string = "All tags" @label "Back-to-root label" @description "Label on the back affordance that returns from a drilled-in level to the root — phrase it in this taxonomy's vocabulary (All tags, All categories)." @synonyms "back label, root caption, all label" @tier "presentation"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    title          : string = "Categories" @label "Section title" @description "Heading shown above the tag tree" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-tag-taxonomy.orb orbitals[0].traits[0])"
}

