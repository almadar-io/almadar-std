    fx             : [Fx] = [] @label "Initial Fx" @description "Seed particles rendered before the first BURST; usually empty." @tier "domain"
    running        : boolean = true @label "Running" @description "When true the decay tick runs; toggle to freeze effects." @tier "domain"
  }
