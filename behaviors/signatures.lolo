    revealedChars  : number @label "Revealed Chars" @description "Number of `text` characters to reveal (typewriter effect). Omit to show the full string — LOLO drives this from `@entity.revealedChars` via a tick, incrementing it until it reaches `text.length`." @tier "presentation"
    speaker        : string = "Hero" @label "Speaker" @description "Speaker name displayed at the top" @tier "presentation"
