    headerContent  : render-ui = {"children":[{"actions":{"action":"NAV_LINK","actionPayload":{"href":"@config.actionHref","label":"@config.actionLabel"},"className":["if",["==","@config.actionLabel",""],"hidden",""],"href":"@config.actionHref","label":"@config.actionLabel","size":"sm","type":"button","variant":"primary"},"brandName":"@config.brandName","className":"hidden md:flex","logoSrc":"@config.logoSrc","navigationItems":["array/map","@config.links",["fn","entry",{"active":["==",["object/get","@entry","href",""],"@config.currentPath"],"href":["object/get","@entry","href",""],"label":["object/get","@entry","label",""]}]],"showMenuToggle":false,"sticky":false,"type":"header","variant":"desktop"},{"brandName":"@config.brandName","className":"md:hidden","isMenuOpen":"@entity.menuOpen","logoSrc":"@config.logoSrc","onMenuToggle":"MENU_TOGGLE","showMenuToggle":true,"sticky":false,"type":"header","variant":"mobile"},{"align":"stretch","children":["array/map","@config.links",["fn","entry",{"action":"NAV_LINK","actionPayload":{"href":["object/get","@entry","href",""],"label":["object/get","@entry","label",""]},"className":"justify-start","href":["object/get","@entry","href",""],"label":["object/get","@entry","label",""],"type":"button","variant":["if",["==",["object/get","@entry","href",""],"@config.currentPath"],"secondary","ghost"]}]],"className":["if","@entity.menuOpen","md:hidden border-b border-border bg-card px-4 py-3","hidden"],"direction":"vertical","gap":"xs","type":"stack"}],"className":"sticky top-0 z-50","direction":"vertical","gap":"none","type":"stack"} @label "Header body" @tier "internal"
    links          : [SiteNavLink] = [{"href":"/features","label":"Features"},{"href":"/pricing","label":"Pricing"},{"href":"/about","label":"About"}] @label "Navigation links" @synonyms "menu, nav items, top navigation" @tier "presentation"
    logoSrc        : string = "" @label "Logo image" @description "Logo URL; empty shows the name only" @tier "presentation"
