;; From @almadar/std (behaviors/registry/ui/core/atoms/std-slide-deck.orb orbitals[0].traits[0])
trait std-slide-deck.traits.SlideDeckPresenter {
  alias          : SlideDeck
  linkedEntity   : SlideDeck
  category       : interaction
  states         : (presenting*)
  events         : (INIT GO_TO SLIDE_CHANGED)
  transitions    : ((presenting -> presenting on INIT) (presenting -> presenting on GO_TO))
  emits          : (SLIDE_CHANGED)
  config {
    bodyContent    : render-ui = {"children":[{"align":"center","children":[["array/map",[["array/len","@config.slides"]],["fn","n",["if","@config.showArrows",{"action":"GO_TO","actionPayload":{"index":["if","@config.loop",["math/wrap",["-","@entity.slideIndex",1],0,"@n"],["math/max",0,["-","@entity.slideIndex",1]]]},"disabled":["and",["==","@config.loop",false],["<=","@entity.slideIndex",0]],"icon":"@config.prevIcon","size":"lg","type":"button","variant":"ghost"},null]]],{"children":["array/map",["@entity.slideIndex"],["fn","i",{"children":[["array/nth","@config.slides","@i"]],"className":"w-full","type":"box"}]],"className":"flex-1 min-w-0","minHeight":"@config.stageMinHeight","type":"center"},["array/map",[["array/len","@config.slides"]],["fn","n",["if","@config.showArrows",{"action":"GO_TO","actionPayload":{"index":["if","@config.loop",["math/wrap",["+","@entity.slideIndex",1],0,"@n"],["math/min",["-","@n",1],["+","@entity.slideIndex",1]]]},"disabled":["and",["==","@config.loop",false],[">=","@entity.slideIndex",["-","@n",1]]],"icon":"@config.nextIcon","size":"lg","type":"button","variant":"ghost"},null]]]],"direction":"horizontal","gap":"md","type":"stack"},["if","@config.showProgress",{"align":"center","children":["array/map",[["array/len","@config.slides"]],["fn","n",{"align":"center","children":[{"count":"@n","currentIndex":"@entity.slideIndex","onDotClick":"GO_TO","size":"sm","type":"progress-dots"},{"color":"muted","content":["str/concat","",["+","@entity.slideIndex",1]," / ","@n"],"type":"typography","variant":"caption"}],"direction":"horizontal","gap":"md","type":"stack"}]],"direction":"horizontal","gap":"md","justify":"center","type":"stack"},null]],"className":"w-full","direction":"vertical","gap":"md","type":"stack"} @label "Body content tree" @description "Render-ui tree for the deck. Default: slide centred between previous/next arrows, dot strip and counter below. A realization overrides this to restyle (full-bleed, bottom bar, no chrome) while keeping the same cursor, keys and emits." @tier "internal"
    loop           : boolean = false @label "Loop" @description "Wrap from the last slide to the first (and back) instead of stopping at either end." @tier "presentation"
    nextIcon       : icon = "chevron-right" @label "Next icon" @tier "presentation"
    prevIcon       : icon = "chevron-left" @label "Previous icon" @tier "presentation"
    showArrows     : boolean = true @label "Show arrows" @description "Previous/next buttons on the left and right of the slide." @tier "presentation"
    showProgress   : boolean = true @label "Show progress" @description "Dot strip and k / n counter under the slide; dots jump to their slide." @tier "presentation"
    slides         : [trait] = [] @label "Slides" @description "Ordered slide nodes; each entry is a render tree or a @trait reference and is shown one at a time." @tier "domain"
    stageMinHeight : string = "70vh" @label "Stage height" @description "Minimum height of the slide stage (any CSS length, e.g. 70vh or 640px); the slide is centred vertically inside it so short and tall slides share one frame." @tier "presentation"
    startIndex     : number = 0 @label "Start slide" @description "Zero-based slide shown on first render; clamped to the deck." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-slide-deck.orb orbitals[0].traits[0])"
}

