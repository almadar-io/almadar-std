;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-wizard-navigation.orb orbitals[0].traits[0])
trait ui-wizard-navigation.traits.WizardNavigationRender {
  alias          : UiWizardNavigation
  linkedEntity   : WizardNavigationItem
  category       : interaction
  states         : (idle*)
  events         : (INIT BACK NEXT COMPLETE @config.onBack @config.onNext @config.onComplete @config.onBackClick @config.onNextClick @config.onCompleteClick)
  transitions    : ((idle -> idle on INIT) (idle -> idle on BACK) (idle -> idle on NEXT) (idle -> idle on COMPLETE))
  emits          : (@config.onBack @config.onNext @config.onComplete @config.onBackClick @config.onNextClick @config.onCompleteClick)
  config {
    backLabel      : string @label "Back Label" @description "Custom label for Back button" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    compact        : boolean = false @label "Compact" @description "Compact mode (smaller padding)" @tier "presentation"
    completeLabel  : string @label "Complete Label" @description "Custom label for Complete button" @tier "presentation"
    currentStep    : number = 1 @label "Current Step" @description "Current step index (0-based)" @tier "presentation"
    isValid        : boolean = true @label "Is Valid" @description "Whether the current step is valid (enables Next/Complete)" @tier "presentation"
    nextLabel      : string @label "Next Label" @description "Custom label for Next button" @tier "presentation"
    onBack         : event = "BACK" @label "On Back" @description "Event to emit on Back click — emits UI:{onBack} with { currentStep, totalSteps }" @tier "presentation"
    onBackClick    : event = "BACK_CLICK" @label "On Back Click" @description "Direct callback for Back (alternative to event)" @tier "presentation"
    onComplete     : event = "COMPLETE" @label "On Complete" @description "Event to emit on Complete click — emits UI:{onComplete} with { currentStep, totalSteps }" @tier "presentation"
    onCompleteClick : event = "COMPLETE_CLICK" @label "On Complete Click" @description "Direct callback for Complete (alternative to event)" @tier "presentation"
    onNext         : event = "NEXT" @label "On Next" @description "Event to emit on Next click — emits UI:{onNext} with { currentStep, totalSteps }" @tier "presentation"
    onNextClick    : event = "NEXT_CLICK" @label "On Next Click" @description "Direct callback for Next (alternative to event)" @tier "presentation"
    showBack       : boolean = true @label "Show Back" @description "Show the Back button" @tier "presentation"
    showComplete   : boolean = true @label "Show Complete" @description "Show the Complete button (on last step)" @tier "presentation"
    showNext       : boolean = true @label "Show Next" @description "Show the Next button" @tier "presentation"
    totalSteps     : number = 1 @label "Total Steps" @description "Total number of steps" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-wizard-navigation.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-wizard-progress.orb orbitals[0].traits[0])
trait ui-wizard-progress.traits.WizardProgressRender {
  alias          : UiWizardProgress
  linkedEntity   : WizardProgressItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onStepClick)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onStepClick)
  config {
    allowNavigation : boolean = true @label "Allow Navigation" @description "Allow clicking on completed steps to navigate back" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    compact        : boolean = false @label "Compact" @description "Compact mode (smaller, no titles)" @tier "presentation"
    currentStep    : number = 1 @label "Current Step" @description "Current step index (0-based)" @tier "presentation"
    onStepClick    : event = "STEP_CLICK" @label "On Step Click" @description "Callback when a completed step is clicked" @tier "presentation"
    stepClickEvent : event = "STEP_CLICK" @label "Step Click Event" @description "Declarative step click event — emits UI:{stepClickEvent} with { stepIndex }. Setting it requires declaring that event (with a `{ stepIndex }` payload) and a transition handling it in the same trait; omit this prop for non-clickable progress indicators." @tier "presentation"
    steps          : [WizardProgressStepsItem] = [] @label "Steps" @description "Step definitions (compatible with WizardContainer's WizardStep). A string is shorthand for `{ id: str, title: str }`." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-wizard-progress.orb orbitals[0].traits[0])"
}

