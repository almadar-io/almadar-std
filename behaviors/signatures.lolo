;; From @almadar/std (behaviors/registry/ui/core/atoms/ui-input.orb orbitals[0].traits[0])
trait ui-input.traits.InputRender {
  alias          : UiInput
  linkedEntity   : InputItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.action @config.onClear @config.onChange)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.action @config.onClear @config.onChange)
  config {
    action         : event = "ACTION" @label "Action" @description "Declarative event name for trait dispatch." @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes applied to the root element." @tier "presentation"
    clearable      : boolean @label "Clearable" @description "Show clear button when input has value" @tier "presentation"
    disabled       : boolean @label "Disabled" @description "Whether input is disabled" @tier "presentation"
    error          : string @label "Error" @description "error prop" @tier "presentation"
    helperText     : string @label "Helper Text" @description "helperText prop" @tier "presentation"
    icon           : icon @label "Icon" @description "Lucide icon component or canonical kebab-case icon name string for left side" @tier "presentation"
    inputType      : string = "text" @label "Input Type" @description "Input type — selects the field's data mode. Use 'password' for masked credentials / secret / passphrase entry (there is no separate password pattern); 'email', 'tel', 'url', 'number', 'search', 'date', and 'time' for their respective values; and 'select' / 'textarea' for choice and multi-line entry in addition to the standard single-line types." @tier "presentation" @values (text email password number tel url search date datetime-local time checkbox select textarea)
    label          : string @label "Label" @description "label prop" @tier "presentation"
    leftIcon       : icon @label "Left Icon" @description "leftIcon prop" @tier "presentation"
    onChange       : event = "CHANGE" @label "On Change" @description "onChange handler or declarative event key for trait dispatch" @tier "presentation"
    onClear        : event = "CLEAR" @label "On Clear" @description "Callback or declarative event key when clear button is clicked" @tier "presentation"
    options        : [InputOptionsItem] = [] @label "Options" @description "Options for select type" @tier "presentation"
    placeholder    : string @label "Placeholder" @description "Placeholder text" @tier "presentation"
    rightIcon      : icon @label "Right Icon" @description "rightIcon prop" @tier "presentation"
    rows           : number = 3 @label "Rows" @description "Rows for textarea type" @tier "presentation"
    value          : scalar @label "Value" @description "Current value" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/ui-input.orb orbitals[0].traits[0])"
}

