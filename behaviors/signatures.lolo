    icon           : icon @label "Icon" @description "Lucide icon component or canonical kebab-case icon name string" @tier "presentation"
    label          : scalar @label "Label" @description "Pill label text (alternative to children for schema-driven rendering)." @tier "presentation"
    onClick        : event = "CLICK" @label "On Click" @description "Click handler for the body of the pill (filter toggle)" @tier "presentation"
    onRemove       : event = "" @label "On Remove" @description "Called when the user clicks the remove (×) button" @tier "presentation"
    removable      : boolean = true @label "Removable" @description "Disable the remove button (renders without × control)" @tier "presentation"
    removeEvent    : event = "" @label "Remove Event" @description "Event name dispatched via event bus when the remove (×) button is clicked. Payload: { label }" @tier "presentation"
