;; From @almadar/std (behaviors/registry/ui/core/organisms/ui-form.orb orbitals[0].traits[0])
trait ui-form.traits.FormRender {
  alias          : UiForm
  linkedEntity   : FormItem
  category       : interaction
  states         : (idle*)
  events         : (INIT FormLoaded @config.submitEvent @config.cancelEvent @config.onFieldChange)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on FormLoaded))
  emits          : (@config.submitEvent @config.cancelEvent @config.onFieldChange FormLoaded)
  config {
    cancelEvent    : event = "CANCEL" @label "Cancel Event" @description "Event to dispatch on cancel (defaults to 'CANCEL')" @tier "presentation"
    cancelLabel    : string @label "Cancel Label" @description "Cancel button label (if provided, shows cancel button)" @tier "presentation"
    children       : node @label "Children" @description "Form fields (traditional React children)" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    conditionalFields : Map<string,SExpr> = {} @label "Conditional Fields" @description "Inspection form extensions" @tier "presentation"
    configPath     : string @label "Config Path" @description "Config path for form configuration (schema-driven)" @tier "presentation"
    error          : FormError @label "Error" @description "Error state" @tier "presentation"
    evaluationContext : FormEvaluationContext @label "Evaluation Context" @description "Context for S-expression evaluation" @tier "presentation"
    fieldOverrides : [FormFieldOverridesItem] = [] @label "Field Overrides" @description "Per-field display-copy overrides (label/placeholder/hint), merged by field name over the schema-enriched fields." @tier "presentation"
    fields         : [FormFieldsItem] = [{"disabled":false,"field":"Field","hint":"Hint","inputType":"Input Type","label":"Label","max":1,"min":1,"name":"Name","options":[{"label":"Label","value":"Value"},{"label":"Label 2","value":"Value 2"}],"pattern":"Pattern","placeholder":"Placeholder","readonly":false,"relation":{"cardinality":"one","displayField":"Display Field","entity":"Entity"},"required":false,"type":"Type","validation":{"enum":["Item","Item 2"]},"values":["Item","Item 2"]},{"disabled":true,"field":"Field 2","hint":"Hint 2","inputType":"Input Type 2","label":"Label 2","max":2,"min":2,"name":"Name 2","options":[{"label":"Label","value":"Value"},{"label":"Label 2","value":"Value 2"}],"pattern":"Pattern 2","placeholder":"Placeholder 2","readonly":true,"relation":{"cardinality":"many","displayField":"Display Field 2","entity":"Entity 2"},"required":true,"type":"Type 2","validation":{"enum":["Item","Item 2"]},"values":["Item","Item 2"]}] @label "Fields" @description "Fields definition (schema format) - accepts readonly for generated const arrays" @tier "presentation"
    gap            : string = "md" @label "Gap" @description "Gap between fields" @tier "presentation" @values (sm md lg)
    hiddenCalculations : [FormHiddenCalculationsItem] = [] @label "Hidden Calculations" @description "Hidden calculations that emit GLOBAL_VARIABLE_SET on field change (boolean true means enabled but config loaded separately)" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    layout         : string = "vertical" @label "Layout" @description "Form layout" @tier "presentation" @values (vertical horizontal inline)
    mode           : string @label "Mode" @description "Form mode — 'create' for new records, 'edit' for updating existing. Accepts `string` so schema-driven callers (whose `config.mode` is typed as `string` per the trait's declared config block) compile cleanly. The runtime treats anything other than 'edit' as 'create'." @tier "presentation"
    onCancel       : string @label "On Cancel" @description "Cancel event name for trait dispatch (emitted via eventBus as UI:{onCancel})" @tier "presentation"
    onFieldChange  : event = "FIELD_CHANGE" @label "On Field Change" @description "Callback when any field value changes" @tier "presentation"
    onSubmit       : string @label "On Submit" @description "Submit event name for trait dispatch (emitted via eventBus as UI:{onSubmit})" @tier "presentation"
    relationsData  : Map<string,[FormRelationsDataValueItem]> = {} @label "Relations Data" @description "Relation data props" @tier "presentation"
    relationsLoading : Map<string,boolean> = {} @label "Relations Loading" @description "Loading state for relation data: { fieldName: boolean }" @tier "presentation"
    repeatable     : boolean @label "Repeatable" @description "Whether the form supports repeatable entries" @tier "presentation"
    sections       : [FormSectionsItem] = [] @label "Sections" @description "Nested form sections with optional conditions" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    showCancel     : boolean @label "Show Cancel" @description "Show cancel button (defaults to true for schema forms)" @tier "presentation"
    showSubmit     : boolean = true @label "Show Submit" @description "Show submit button (defaults to true for schema forms). Set false when a parent atom owns the submit action externally (e.g. wizard footers)." @tier "presentation"
    submitEvent    : event = "SUBMIT" @label "Submit Event" @description "Event dispatch props (for trait state machine integration)" @tier "presentation"
    submitLabel    : string @label "Submit Label" @description "Submit button label" @tier "presentation"
    title          : string @label "Title" @description "Form title (used by ModalSlot to extract title)" @tier "presentation"
    violationTriggers : [FormViolationTriggersItem] = [] @label "Violation Triggers" @description "Violation conditions that emit VIOLATION_DETECTED when met (boolean true means enabled but config loaded separately)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/organisms/ui-form.orb orbitals[0].traits[0])"
}

