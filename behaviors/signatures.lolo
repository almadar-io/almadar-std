;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-graph-canvas.orb orbitals[0].traits[0])
trait ui-graph-canvas.traits.GraphCanvasRender {
  alias          : UiGraphCanvas
  linkedEntity   : GraphCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onNodeClick @config.onMarkClick @config.onNodeDoubleClick @config.onBadgeClick)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onNodeClick @config.onMarkClick @config.onNodeDoubleClick @config.onBadgeClick)
  config {
    actions        : [GraphCanvasActionsItem] = [] @label "Actions" @description "Actions" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    draggable      : boolean = true @label "Draggable" @description "Enable node dragging" @tier "presentation"
    edges          : [GraphCanvasEdgesItem] = [] @label "Edges" @description "Graph edges (the only rendered links)" @tier "presentation"
    error          : GraphCanvasError @label "Error" @description "Error state" @tier "presentation"
    height         : number = 400 @label "Height" @description "Canvas height" @tier "presentation"
    interactive    : boolean = true @label "Interactive" @description "Enable zoom/pan" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    layout         : string = "force" @label "Layout" @description "Layout algorithm" @tier "presentation" @values (force circular grid)
    linkDistance   : number = 100 @label "Link Distance" @description "Force-sim target edge length (larger ⇒ more spread out)" @tier "presentation"
    linkOpacity    : number = 0.18 @label "Link Opacity" @description "Base opacity for links when nothing is hovered (kept faint so dense graphs stay readable; incident links brighten on hover)." @tier "presentation"
    nodeClickEvent : event = "NODE_CLICK" @label "Node Click Event" @description "Node click event" @tier "presentation"
    nodes          : [GraphCanvasNodesItem] = [] @label "Nodes" @description "Graph nodes" @tier "presentation"
    nodeSpacing    : number = 28 @label "Node Spacing" @description "Minimum empty gap (px) enforced between node edges so nodes never overlap." @tier "presentation"
    onBadgeClick   : event = "BADGE_CLICK" @label "On Badge Click" @description "On node badge click (e.g. to expand a merged cluster)." @tier "presentation"
    onMarkClick    : event = "MARK_CLICK" @label "On Mark Click" @description "On marked-node click (suggestion/proposal target). Takes priority over onNodeClick." @tier "presentation"
    onNodeClick    : event = "NODE_CLICK" @label "On Node Click" @description "On node click" @tier "presentation"
    onNodeDoubleClick : event = "NODE_DOUBLE_CLICK" @label "On Node Double Click" @description "On node double-click (e.g. to drill in)" @tier "presentation"
    proposedEdges  : [GraphCanvasProposedEdgesItem] = [] @label "Proposed Edges" @description "Uncommitted proposal links — rendered dashed/faint in a separate pass, never folded into the layout springs." @tier "presentation"
    repulsion      : number = 800 @label "Repulsion" @description "Force-sim repulsion strength between nodes (larger ⇒ more spread out)" @tier "presentation"
    selectedNodeId : string @label "Selected Node Id" @description "Currently selected node id (rendered emphasized)" @tier "presentation"
    showLabels     : boolean = true @label "Show Labels" @description "Show node labels" @tier "presentation"
    similarity     : [GraphCanvasSimilarityItem] = [] @label "Similarity" @description "All-pairs similarity (cosine 0–1) used ONLY for layout, never drawn. It is the secondary macro-layout: non-connected pairs get a weak spring (higher cosine ⇒ closer) so clusters arrange relative to each other; drawn `edges` stay the primary tight structure. When omitted, edges alone drive the layout." @tier "presentation"
    title          : string @label "Title" @description "Graph title" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-graph-canvas.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-graph-view.orb orbitals[0].traits[0])
trait ui-graph-view.traits.GraphViewRender {
  alias          : UiGraphView
  linkedEntity   : GraphViewItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onNodeClick @config.onNodeHover)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onNodeClick @config.onNodeHover)
  config {
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    edges          : [GraphViewEdgesItem] = [{"color":"Color","label":"Label","source":"Source","target":"Target"},{"color":"Color 2","label":"Label 2","source":"Source 2","target":"Target 2"}] @label "Edges" @description "Graph edges" @tier "presentation"
    height         : number @label "Height" @description "Height in pixels" @tier "presentation"
    layout         : string = "force" @label "Layout" @description "Layout mode. force = physics simulation (default); flow = layered left-to-right process flow; tree = top-down hierarchy tiers from the roots; radial = concentric rings by depth (a pure cycle renders as a single ring). Non-force layouts are deterministic." @synonyms "layout mode, flow layout, tree layout, radial layout, hierarchy layout" @tier "domain" @values (force flow tree radial)
    nodes          : [GraphViewNodesItem] = [{"color":"Color","group":"Group","id":"Id","label":"Label","size":1},{"color":"Color 2","group":"Group 2","id":"Id 2","label":"Label 2","size":2}] @label "Nodes" @description "Graph nodes" @tier "presentation"
    onNodeClick    : event = "NODE_CLICK" @label "On Node Click" @description "Callback when a node is clicked" @tier "presentation"
    onNodeHover    : event = "NODE_HOVER" @label "On Node Hover" @description "Callback when a node is hovered (null on leave)" @tier "presentation"
    showLabels     : boolean = true @label "Show Labels" @description "Show node labels (default true)" @tier "presentation"
    width          : number @label "Width" @description "Width in pixels" @tier "presentation"
    zoomToFit      : boolean = true @label "Zoom To Fit" @description "Auto zoom-to-fit after layout settles (default true)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-graph-view.orb orbitals[0].traits[0])"
}

