;; From @almadar/std (behaviors/registry/ui/learning/atoms/ui-algorithm-canvas.orb orbitals[0].traits[0])
trait ui-algorithm-canvas.traits.AlgorithmCanvasRender {
  alias          : UiAlgorithmCanvas
  linkedEntity   : AlgorithmCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT UPDATE @config.onShapeClick)
  transitions    : ((idle -> idle on INIT) (idle -> idle on UPDATE))
  emits          : (@config.onShapeClick)
  config {
    animate        : boolean = false @label "Animate" @description "animate prop" @tier "presentation"
    auxBars        : [AlgorithmCanvasAuxBarsItem] = [] @label "Aux Bars" @description "Secondary bar strip inside the bars panel (e.g. a running total beside the primary values)." @tier "presentation"
    backgroundColor : string @label "Background Color" @description "backgroundColor prop" @tier "presentation"
    bars           : [AlgorithmCanvasBarsItem] = [] @label "Bars" @description "Sorting/histogram bars; laid out left-to-right, height proportional to value." @tier "presentation"
    buckets        : [AlgorithmCanvasBucketsItem] = [] @label "Buckets" @description "Hash-table buckets; each row is an index chip plus its chained entries." @tier "presentation"
    cells          : [AlgorithmCanvasCellsItem] = [] @label "Cells" @description "Grid/array/DP cells; laid out on a row/col lattice sized to the extent." @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    colLabels      : [AlgorithmCanvasColLabelsItem] = [] @label "Col Labels" @description "Column-header labels drawn above the cells grid." @tier "presentation"
    error          : AlgorithmCanvasError @label "Error" @description "error prop" @tier "presentation"
    frames         : [AlgorithmCanvasFramesItem] = [] @label "Frames" @description "Recursion/call-stack frames; laid out bottom-up like a real call stack." @tier "presentation"
    height         : number = 400 @label "Height" @description "height prop" @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "interactive prop" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "isLoading prop" @tier "presentation"
    onShapeClick   : event = "SHAPE_CLICK" @label "On Shape Click" @description "onShapeClick prop" @tier "presentation"
    pointers       : [AlgorithmCanvasPointersItem] = [] @label "Pointers" @description "Index cursors (i/j/lo/hi/mid); drawn as markers beneath the referenced bar/slot column." @tier "presentation"
    ranges         : [AlgorithmCanvasRangesItem] = [] @label "Ranges" @description "Highlighted index ranges over the bars panel (translucent fill bands or labeled brackets)." @tier "presentation"
    rowLabels      : [AlgorithmCanvasRowLabelsItem] = [] @label "Row Labels" @description "Row-header labels drawn to the left of the cells grid." @tier "presentation"
    shapes         : [AlgorithmCanvasShapesItem] = [] @label "Shapes" @description "Extra declarative shapes in canvas pixel coordinates." @tier "presentation"
    slotOrientation : string = "horizontal" @label "Slot Orientation" @description "Slot stack direction; horizontal lays slots left-to-right, vertical stacks bottom-up." @tier "presentation" @values (horizontal vertical)
    slots          : [AlgorithmCanvasSlotsItem] = [] @label "Slots" @description "Discrete value slots (registers/variables); laid out in a row or a vertical stack." @tier "presentation"
    title          : string @label "Title" @description "title prop" @tier "presentation"
    width          : number = 600 @label "Width" @description "width prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/ui-algorithm-canvas.orb orbitals[0].traits[0])"
}

