    interactive    : boolean = false @label "Interactive" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    paramADefault  : number = 1 @label "Parameter A Default" @description "Starting value of the first parameter." @tier "domain"
    paramALabel    : string = "A" @label "Parameter A Label" @description "Display label for the first parameter, shown in the caption and readout." @tier "presentation"
    paramAMax      : number = 5 @label "Parameter A Max" @description "Upper bound of the first parameter's slider." @tier "domain"
    paramAMin      : number = -5 @label "Parameter A Min" @description "Lower bound of the first parameter's slider." @tier "domain"
    paramAStep     : number = 0.1 @label "Parameter A Step" @description "Slider increment for the first parameter." @tier "presentation"
    paramBDefault  : number = 2 @label "Parameter B Default" @description "Starting value of the second parameter." @tier "domain"
    paramBLabel    : string = "B" @label "Parameter B Label" @description "Display label for the second parameter, shown in the caption and readout." @tier "presentation"
    paramBMax      : number = 5 @label "Parameter B Max" @description "Upper bound of the second parameter's slider." @tier "domain"
    paramBMin      : number = -5 @label "Parameter B Min" @description "Lower bound of the second parameter's slider." @tier "domain"
    paramBStep     : number = 0.1 @label "Parameter B Step" @description "Slider increment for the second parameter." @tier "presentation"
    showAxes       : boolean = true @label "Show Axes" @tier "presentation"
    showGrid       : boolean = true @label "Show Grid" @tier "presentation"
    title          : string = "Parameter Explorer" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
    xMax           : number = 10 @label "X Max" @description "Right edge of the sampled x range." @tier "presentation"
    xMin           : number = 0 @label "X Min" @description "Left edge of the sampled x range." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
