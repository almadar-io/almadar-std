;; From @almadar/std (behaviors/registry/ui/core/organisms/ui-detail-panel.orb orbitals[0].traits[0])
trait ui-detail-panel.traits.DetailPanelRender {
  alias          : UiDetailPanel
  linkedEntity   : DetailPanelItem
  category       : interaction
  states         : (idle*)
  events         : (INIT DetailPanelLoaded)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on DetailPanelLoaded))
  emits          : (DetailPanelLoaded)
  config {
    actions        : [DetailPanelActionsItem] = [] @label "Actions" @description "Unified actions array - first action with variant='primary' is the main action" @tier "presentation"
    activeFilters  : Map<string,string> = {} @label "Active Filters" @description "Active filters" @tier "presentation"
    avatar         : node @label "Avatar" @description "avatar prop" @tier "presentation"
    backAction     : DetailPanelBackAction @label "Back Action" @description "Navigation-back affordance. Renders top-LEFT before the title (OS/back convention — Almadar_UX §8.4), spatially separated from the right-aligned action buttons + close X. Never inferred from actions[] labels." @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    displayFields  : [string] = [] @label "Display Fields" @description "Display fields (alias for fields)" @tier "presentation"
    error          : DetailPanelError @label "Error" @description "Error state (UiError)" @tier "presentation"
    fieldNames     : [string] = [] @label "Field Names" @description "Alias for fields - backwards compatibility" @tier "presentation"
    fields         : [DetailPanelFieldsItem] = [{"header":"Header","key":"Key","relation":{"cardinality":"one","entity":"Entity"},"type":"Type","values":["Item","Item 2"]},{"header":"Header 2","key":"Key 2","relation":{"cardinality":"many","entity":"Entity 2"},"type":"Type 2","values":["Item","Item 2"]}] @label "Fields" @description "Fields to display - accepts string[], {key, header}[], or DetailField[]" @tier "presentation"
    footer         : node @label "Footer" @description "footer prop" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    maxInlineActions : number = 2 @label "Max Inline Actions" @description "Max inline action buttons before the rest collapse into a '⋯' overflow menu (mirrors DataGrid's maxInlineActions). Defaults to 2 — primary + secondary visible, the rest under the menu — so every detail panel carries the same action pattern." @tier "presentation"
    mode           : string @label "Mode" @description "Display mode (passed by compiler)" @tier "presentation"
    onTitleCommit  : event = "" @label "On Title Commit" @description "When bound, the title becomes editable in place: clicking it swaps the heading for an input, Enter or blur commits, Escape reverts. Receives the committed title and the record's id so the host can persist a partial update. Unbound, the title stays a plain heading." @tier "presentation"
    pageProp       : number @label "Page" @description "Current page number" @synonyms "page" @tier "presentation"
    pageSize       : number @label "Page Size" @description "Number of items per page" @tier "presentation"
    position       : string = "left" @label "Position" @description "Panel position (for drawer/sidebar placement)" @tier "presentation" @values (left right)
    relationsData  : Map<string,[DetailPanelRelationsDataValueItem]> = {} @label "Relations Data" @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names." @tier "presentation"
    searchValue    : string @label "Search Value" @description "Current search query value" @tier "presentation"
    sections       : [DetailPanelSectionsItem] = [] @label "Sections" @description "sections prop" @tier "presentation"
    selectedIds    : [string] = [] @label "Selected Ids" @description "Currently selected item IDs" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    showActions    : boolean = true @label "Show Actions" @description "When false, hides the action buttons + overflow menu (and the close ×). Defaults to true." @tier "presentation"
    slideOver      : boolean = false @label "Slide Over" @description "slideOver prop" @tier "presentation"
    sortBy         : string @label "Sort By" @description "Current sort field" @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Current sort direction" @tier "presentation" @values (asc desc)
    status         : DetailPanelStatus @label "Status" @description "status prop" @tier "presentation"
    subtitle       : string @label "Subtitle" @description "subtitle prop" @tier "presentation"
    title          : string @label "Title" @description "title prop" @tier "presentation"
    totalCount     : number @label "Total Count" @description "Total number of items" @tier "presentation"
    width          : string @label "Width" @description "Panel width (CSS value, e.g., '400px', '50%')" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/organisms/ui-detail-panel.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/organisms/ui-dock-layout.orb orbitals[0].traits[0])
trait ui-dock-layout.traits.DockLayoutRender {
  alias          : UiDockLayout
  linkedEntity   : DockLayoutItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onSidebarCollapsedChange @config.onSidebarWidthChange @config.onBottomPanelCollapsedChange @config.onBottomPanelHeightChange @config.onSecondarySidebarCollapsedChange)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onSidebarCollapsedChange @config.onSidebarWidthChange @config.onBottomPanelCollapsedChange @config.onBottomPanelHeightChange @config.onSecondarySidebarCollapsedChange)
  config {
    bottomPanel    : node @label "Bottom Panel" @description "Collapsible, resizable-height bottom panel." @tier "presentation"
    bottomPanelClassName : string @label "Bottom Panel Class Name" @description "bottomPanelClassName prop" @tier "presentation"
    bottomPanelCollapsed : boolean = false @label "Bottom Panel Collapsed" @description "Whether `bottomPanel` is collapsed. @default false" @tier "presentation"
    bottomPanelHeight : number = 30 @label "Bottom Panel Height" @description "Bottom panel size as a SplitPane ratio (0-100, percentage given to the panel). @default 30" @tier "presentation"
    bottomPanelMinSize : number = 120 @label "Bottom Panel Min Size" @description "Minimum bottom panel size in pixels, forwarded to SplitPane's `minSize`. @default 120" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes on the root frame." @tier "presentation"
    main           : node = [] @label "Main" @description "Required center region." @tier "presentation"
    mainClassName  : string @label "Main Class Name" @description "mainClassName prop" @tier "presentation"
    onBottomPanelCollapsedChange : event = "BOTTOM_PANEL_COLLAPSED_CHANGE" @label "On Bottom Panel Collapsed Change" @description "onBottomPanelCollapsedChange prop" @tier "presentation"
    onBottomPanelHeightChange : event = "BOTTOM_PANEL_HEIGHT_CHANGE" @label "On Bottom Panel Height Change" @description "onBottomPanelHeightChange prop" @tier "presentation"
    onSecondarySidebarCollapsedChange : event = "SECONDARY_SIDEBAR_COLLAPSED_CHANGE" @label "On Secondary Sidebar Collapsed Change" @description "onSecondarySidebarCollapsedChange prop" @tier "presentation"
    onSidebarCollapsedChange : event = "SIDEBAR_COLLAPSED_CHANGE" @label "On Sidebar Collapsed Change" @description "onSidebarCollapsedChange prop" @tier "presentation"
    onSidebarWidthChange : event = "SIDEBAR_WIDTH_CHANGE" @label "On Sidebar Width Change" @description "onSidebarWidthChange prop" @tier "presentation"
    rail           : node @label "Rail" @description "Fixed-width far-left vertical strip (e.g. an icon nav rail)." @tier "presentation"
    railClassName  : string @label "Rail Class Name" @description "railClassName prop" @tier "presentation"
    railWidth      : number = 56 @label "Rail Width" @description "Width of `rail` in pixels. @default 56" @tier "presentation"
    secondarySidebar : node @label "Secondary Sidebar" @description "Collapsible right sidebar." @tier "presentation"
    secondarySidebarClassName : string @label "Secondary Sidebar Class Name" @description "secondarySidebarClassName prop" @tier "presentation"
    secondarySidebarCollapsed : boolean = false @label "Secondary Sidebar Collapsed" @description "Whether `secondarySidebar` is collapsed. @default false" @tier "presentation"
    secondarySidebarWidth : number = 280 @label "Secondary Sidebar Width" @description "Width of `secondarySidebar` in pixels (fixed — not resizable). @default 280" @tier "presentation"
    sidebar        : node @label "Sidebar" @description "Collapsible, resizable left sidebar." @tier "presentation"
    sidebarClassName : string @label "Sidebar Class Name" @description "sidebarClassName prop" @tier "presentation"
    sidebarCollapsed : boolean = false @label "Sidebar Collapsed" @description "Whether `sidebar` is collapsed. @default false" @tier "presentation"
    sidebarMinSize : number = 160 @label "Sidebar Min Size" @description "Minimum sidebar size in pixels, forwarded to SplitPane's `minSize`. @default 160" @tier "presentation"
    sidebarWidth   : number = 20 @label "Sidebar Width" @description "Sidebar size as a SplitPane ratio (0-100, percentage of the sidebar/main split). @default 20" @tier "presentation"
    statusBar      : node @label "Status Bar" @description "Slim strip pinned to the bottom of the frame, below the bottom panel." @tier "presentation"
    statusBarClassName : string @label "Status Bar Class Name" @description "statusBarClassName prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/organisms/ui-dock-layout.orb orbitals[0].traits[0])"
}

