;; From @almadar/std (behaviors/registry/ui/core/templates/ui-auth-layout.orb orbitals[0].traits[0])
trait ui-auth-layout.traits.AuthLayoutRender {
  alias          : UiAuthLayout
  linkedEntity   : AuthLayoutItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    appName        : string = "My App" @label "App Name" @description "App name" @tier "presentation"
    backgroundImage : asset = "https://almadar-kflow-assets.web.app/shared/ui-visual-novel-board/default/backgrounds/corridor.png" @label "Background Image" @description "Background image URL" @tier "presentation"
    brandingContent : node @label "Branding Content" @description "Branding panel content" @tier "presentation"
    logo           : node @label "Logo" @description "Logo component or URL" @tier "presentation"
    showBranding   : boolean = true @label "Show Branding" @description "Show branding panel on the side" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/templates/ui-auth-layout.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/templates/ui-counter-template.orb orbitals[0].traits[0])
trait ui-counter-template.traits.CounterTemplateRender {
  alias          : UiCounterTemplate
  linkedEntity   : CounterTemplateItem
  category       : interaction
  states         : (idle*)
  events         : (INIT CounterTemplateLoaded @config.onIncrement @config.onDecrement @config.onReset)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on CounterTemplateLoaded))
  emits          : (@config.onIncrement @config.onDecrement @config.onReset CounterTemplateLoaded)
  config {
    className      : string @label "Class Name" @description "External styling override" @tier "presentation"
    decrementEvent : event = "DECREMENT" @label "Decrement Event" @description "Declarative event key — emits UI:{decrementEvent} via bus on decrement" @tier "presentation"
    incrementEvent : event = "INCREMENT" @label "Increment Event" @description "Declarative event key — emits UI:{incrementEvent} via bus on increment" @tier "presentation"
    onDecrement    : event = "DECREMENT" @label "On Decrement" @description "Called when decrement is clicked" @tier "presentation"
    onIncrement    : event = "INCREMENT" @label "On Increment" @description "Called when increment is clicked" @tier "presentation"
    onReset        : event = "RESET" @label "On Reset" @description "Called when reset is clicked" @tier "presentation"
    resetEvent     : event = "RESET" @label "Reset Event" @description "Declarative event key — emits UI:{resetEvent} via bus on reset" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    showReset      : boolean = true @label "Show Reset" @description "Show reset button" @tier "presentation"
    size           : string = "md" @label "Size" @description "Counter display size" @tier "presentation" @values (sm md lg)
    title          : string = "Counter" @label "Title" @description "Title displayed above the counter" @tier "presentation"
    variant        : string = "minimal" @label "Variant" @description "Template variant" @tier "presentation" @values (minimal standard full)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/templates/ui-counter-template.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/templates/ui-dashboard-layout.orb orbitals[0].traits[0])
trait ui-dashboard-layout.traits.DashboardLayoutRender {
  alias          : UiDashboardLayout
  linkedEntity   : DashboardLayoutItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.searchEvent @config.onSearchSubmit @config.notificationClickEvent @config.onSignOut)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.searchEvent @config.onSearchSubmit @config.notificationClickEvent @config.onSignOut)
  config {
    appName        : string = "{{APP_TITLE}}" @label "App Name" @description "App name shown in sidebar" @tier "presentation"
    children       : node @label "Children" @description "Page content rendered inside the main area" @tier "presentation"
    currentPath    : string @label "Current Path" @description "Active path used to highlight the matching nav item. Falls back to `useCurrentPagePath()` (set by `CurrentPagePathProvider`), then to `useLocation().pathname`. Production deploys can omit it; the studio preview passes the in-frame `?page=` value so highlighting works inside the embedded playground where `pathname` would be the studio route." @tier "presentation"
    headerActions  : node @label "Header Actions" @description "Header actions (extra slots beyond bell/search/theme)." @tier "presentation"
    layoutMode     : string = "sidebar" @label "Layout Mode" @description "Layout mode. Default `'sidebar'`. - `sidebar`: Left sidebar nav + top header (classic dashboard) - `topnav`: Horizontal nav in header, no sidebar - `bottomnav`: Bottom tab bar, no sidebar - `minimal`: No nav chrome, content only" @tier "presentation" @values (sidebar topnav bottomnav minimal)
    logo           : node @label "Logo" @description "Logo component or URL" @tier "presentation"
    navItems       : [DashboardLayoutNavItemsItem] = [] @label "Nav Items" @description "Navigation items. Apps that need a Settings page should add it as a navItems entry, not depend on baked-in chrome." @tier "presentation"
    notificationClickEvent : event = "NOTIFICATION_CLICK" @label "Notification Click Event" @description "Declarative bell click event — fires `UI:{notificationClickEvent}` on the bus with an empty payload when the user clicks the bell." @tier "presentation"
    notifications  : [DashboardLayoutNotificationsItem] = [] @label "Notifications" @description "Notification list. Pass an empty array to show the bell with no badge; omit / pass null to hide the bell entirely." @tier "presentation"
    onNotificationClick : event = "NOTIFICATION_CLICK" @label "On Notification Click" @description "React-side bell click callback." @tier "presentation"
    onSearchSubmit : event = "SEARCH_SUBMIT" @label "On Search Submit" @description "React-side search submit callback. Used when the host wires the layout directly (not via render-ui pattern resolution)." @tier "presentation"
    onSignOut      : event = "SIGN_OUT" @label "On Sign Out" @description "Callback when user clicks sign out (optional - uses auth context signOut if not provided)" @tier "presentation"
    searchEvent    : event = "SEARCH" @label "Search Event" @description "Declarative search event — fires `UI:{searchEvent}` on the bus when the user submits the search box (Enter key). Setting this implies `showSearch=true`. Use `onSearchSubmit` for direct React usage instead." @tier "presentation"
    showSearch     : boolean = false @label "Show Search" @description "Show the top-bar search box. Default `false` — opt in by setting `searchEvent` (any truthy value implies showSearch) or this flag." @tier "presentation"
    showThemeToggle : boolean = true @label "Show Theme Toggle" @description "Show the theme toggle button in the header. Default `true` — universally useful for a11y / dark mode." @tier "presentation"
    sidebarContent : node @label "Sidebar Content" @description "Optional content region rendered between the nav links and the footer — a page tree or any consumer navigation surface; scrolls independently and takes the sidebar's remaining height. Hidden in the collapsed rail." @tier "presentation"
    sidebarFooter  : node @label "Sidebar Footer" @description "Custom sidebar footer (optional). When omitted, the sidebar has no footer — apps that need Settings/etc. add them via navItems." @tier "presentation"
    topBarActions  : [DashboardLayoutTopBarActionsItem] = [] @label "Top Bar Actions" @description "Generic top-bar action buttons rendered between the search bar and the notifications bell. Each entry: `{icon, label?, event, badge?, variant?}`. Domain-agnostic — consumers add a cart icon, profile button, help-bubble, or any other top-bar action by appending entries. Empty array (default) renders nothing." @tier "presentation"
    user           : DashboardLayoutUser @label "User" @description "Current user info (optional - auto-populated from auth context if not provided). Accepts `null` as well as `undefined`: the `.lolo` substrate's signed-out spelling is `(if @config.viewerName {…} null)`, and the compiled path passes that `null` through verbatim." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/templates/ui-dashboard-layout.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/templates/ui-game-shell.orb orbitals[0].traits[0])
trait ui-game-shell.traits.GameShellRender {
  alias          : UiGameShell
  linkedEntity   : GameShellItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    addons         : node @label "Addons" @description "Action cluster — floats bottom-right (End Turn, Fire, Reset, …). Legacy chrome surface: new behaviors emit action chrome via render-ui \"hud-bottom\" or \"floating\" instead." @tier "presentation"
    appName        : string = "Game" @label "App Name" @description "Application / game title shown as a floating chip" @tier "presentation"
    backgroundAsset : GameShellBackgroundAsset @label "Background Asset" @description "Pattern slice tiled at low opacity across the surface (never cover-stretched)." @tier "presentation"
    children       : node = [{"type":"canvas-2d"}] @label "Children" @description "Game content — fills the whole surface underneath the overlays" @tier "presentation"
    className      : string @label "Class Name" @description "Extra class name on the root container" @tier "presentation"
    controls       : node @label "Controls" @description "Movement controls — floats bottom-left (d-pad / control-grid). Legacy chrome surface: new behaviors emit movement controls via render-ui \"hud-bottom\" instead." @tier "presentation"
    fontFamily     : string = "" @label "Font Family" @description "Game display-font key (pixel | fredoka | future | future-narrow | blocks | mini) or a CSS font-family. Scoped override of the theme contract's --font-family-display slot: titles and numerics take this face, body text follows the active theme. Empty = the active theme's font-family-display token decides." @tier "presentation"
    hud            : node @label "Hud" @description "Stat chips row — floats along the top edge. Legacy chrome surface: new behaviors emit HUD chrome via render-ui \"hud-top\" instead." @tier "presentation"
    hudBackgroundAsset : GameShellHudBackgroundAsset @label "Hud Background Asset" @description "Per-call-site 9-sliced panel override. Chrome normally comes from the active theme (see the theme config knob); most callers leave this unset." @tier "presentation"
    overlay        : node @label "Overlay" @description "Centered overlay layer (victory/defeat banners, dialogs). Legacy chrome surface: new behaviors emit overlays via render-ui \"overlay\" (clear with render-ui \"overlay\" null on every exit) instead." @tier "presentation"
    showTopBar     : boolean = true @label "Show Top Bar" @description "Whether to show the title chip (default: true)" @tier "presentation"
    theme          : string = "" @label "Theme" @description "Scopes an @almadar/ui theme (e.g. game-sci-fi-dark) to this shell's subtree. Empty = inherit the ambient theme." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/templates/ui-game-shell.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/templates/ui-generic-app-template.orb orbitals[0].traits[0])
trait ui-generic-app-template.traits.GenericAppTemplateRender {
  alias          : UiGenericAppTemplate
  linkedEntity   : GenericAppTemplateItem
  category       : interaction
  states         : (idle*)
  events         : (INIT GenericAppTemplateLoaded)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on GenericAppTemplateLoaded))
  emits          : (GenericAppTemplateLoaded)
  config {
    children       : node @label "Children" @description "Main content" @tier "presentation"
    className      : string @label "Class Name" @description "Additional class name" @tier "presentation"
    footer         : node @label "Footer" @description "Footer content" @tier "presentation"
    headerActions  : node @label "Header Actions" @description "Header actions (buttons, links)" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    subtitle       : string @label "Subtitle" @description "Subtitle or description" @tier "presentation"
    title          : string = "" @label "Title" @description "Page title" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/templates/ui-generic-app-template.orb orbitals[0].traits[0])"
}

