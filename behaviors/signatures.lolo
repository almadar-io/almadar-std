;; From @almadar/std (behaviors/registry/agent/organisms/std-agent-builder.orb orbitals[0].traits[1])
trait std-agent-builder.traits.BuilderListener {
  alias          : AgentBuilder
  linkedEntity   : BuilderProcess
  category       : lifecycle
  states         : (waiting* resolved)
  events         : (INIT BUILD_COMPLETE RESET)
  transitions    : ((waiting -> waiting on INIT) (waiting -> resolved on BUILD_COMPLETE) (resolved -> resolved on INIT) (resolved -> waiting on RESET))
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/agent/organisms/std-agent-builder.orb orbitals[0].traits[1])"
}

;; From @almadar/std (behaviors/registry/agent/organisms/std-agent-builder.orb orbitals[0].traits[0])
trait std-agent-builder.traits.BuilderPipeline {
  alias          : AgentBuilder
  linkedEntity   : BuilderProcess
  category       : lifecycle
  states         : (idle* planning done)
  events         : (INIT START PLANNED PLAN_FAILED RESET BUILD_COMPLETE RETRY)
  transitions    : ((idle -> idle on INIT) (idle -> planning on START) (planning -> done on PLANNED) (planning -> done on PLAN_FAILED) (done -> done on INIT) (done -> idle on RESET))
  emits          : (BUILD_COMPLETE PLANNED)
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/agent/organisms/std-agent-builder.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/agent/organisms/std-agent-rabit.orb orbitals[0].traits[2])
trait std-agent-rabit.traits.CoordinatorListener {
  alias          : AgentRabit
  linkedEntity   : Coordinator
  category       : lifecycle
  states         : (waiting* done)
  events         : (INIT RABIT_DONE)
  transitions    : ((waiting -> waiting on INIT) (waiting -> done on RABIT_DONE) (done -> done on INIT))
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/agent/organisms/std-agent-rabit.orb orbitals[0].traits[2])"
}

;; From @almadar/std (behaviors/registry/agent/organisms/std-agent-rabit.orb orbitals[0].traits[1])
trait std-agent-rabit.traits.CoordinatorMonitor {
  alias          : AgentRabit
  linkedEntity   : Coordinator
  category       : lifecycle
  states         : (waiting* counting)
  events         : (INIT ORBITAL_COMPLETE ORBITAL_FAILED ALL_DONE)
  transitions    : ((waiting -> waiting on INIT) (waiting -> counting on ORBITAL_COMPLETE) (waiting -> counting on ORBITAL_FAILED) (counting -> counting on INIT) (counting -> counting on ORBITAL_COMPLETE) (counting -> counting on ORBITAL_FAILED))
  emits          : (ALL_DONE)
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/agent/organisms/std-agent-rabit.orb orbitals[0].traits[1])"
}

;; From @almadar/std (behaviors/registry/agent/organisms/std-agent-rabit.orb orbitals[0].traits[0])
trait std-agent-rabit.traits.CoordinatorPipeline {
  alias          : AgentRabit
  linkedEntity   : Coordinator
  category       : lifecycle
  states         : (idle* planning monitoring assembling done)
  events         : (INIT START PLANNED PLAN_FAILED ALL_DONE COMPOSED COMPOSE_FAILED RESET DISPATCHED RABIT_DONE)
