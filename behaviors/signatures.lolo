;; From @almadar/std (behaviors/registry/ui/learning/atoms/ui-physics-canvas.orb orbitals[0].traits[0])
trait ui-physics-canvas.traits.PhysicsCanvasRender {
  alias          : UiPhysicsCanvas
  linkedEntity   : PhysicsCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT UPDATE @config.onShapeClick)
  transitions    : ((idle -> idle on INIT) (idle -> idle on UPDATE))
  emits          : (@config.onShapeClick)
  config {
    angles         : [PhysicsCanvasAnglesItem] = [] @label "Angles" @description "Angle arcs between two bearings. 2D only." @tier "presentation"
    animate        : boolean = false @label "Animate" @description "2D only: continuous redraw loop. 3D motion is entity-state driven." @tier "presentation"
    backgroundColor : string @label "Background Color" @description "backgroundColor prop" @tier "presentation"
    bodies         : [PhysicsCanvasBodiesItem] = [] @label "Bodies" @description "bodies prop" @tier "presentation"
    camera         : PhysicsCanvasCamera @label "Camera" @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })." @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    constraints    : [PhysicsCanvasConstraintsItem] = [] @label "Constraints" @description "constraints prop" @tier "presentation"
    error          : PhysicsCanvasError @label "Error" @description "error prop" @tier "presentation"
    field          : PhysicsCanvasField @label "Field" @description "A single uniform vector/into/out field lattice. 2D only." @tier "presentation"
    forceScale     : number = 20 @label "Force Scale" @description "forceScale prop" @tier "presentation"
    height         : number = 400 @label "Height" @description "height prop" @tier "presentation"
    interactive    : boolean @label "Interactive" @description "2D: pointer interaction (click/hover). 3D: orbit camera controls." @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "isLoading prop" @tier "presentation"
    lighting       : PhysicsCanvasLighting @label "Lighting" @description "3D only: scene light rig as data." @tier "presentation"
    meters         : [PhysicsCanvasMetersItem] = [] @label "Meters" @description "Bottom-left labeled bar gauges. 2D only." @tier "presentation"
    mode           : string = "2d" @label "Mode" @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host." @tier "presentation" @values (2d 3d)
    onShapeClick   : event = "SHAPE_CLICK" @label "On Shape Click" @description "onShapeClick prop" @tier "presentation"
    post           : PhysicsCanvasPost @label "Post" @description "3D only: post-processing stack (bloom/vignette)." @tier "presentation"
    readouts       : [PhysicsCanvasReadoutsItem] = [] @label "Readouts" @description "Top-right status chip row, forwarded to LearningCanvas verbatim." @tier "presentation"
    sceneObjects   : [PhysicsCanvasSceneObjectsItem] = [] @label "Scene Objects" @description "Ground/wall/ramp/box/pivot scene fixtures. 2D only." @tier "presentation"
    shadows        : boolean @label "Shadows" @description "3D only: enable shadows. Omitted → the host default." @tier "presentation"
    shapes         : [PhysicsCanvasShapesItem] = [] @label "Shapes" @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)." @tier "presentation"
    showForces     : boolean = false @label "Show Forces" @description "showForces prop" @tier "presentation"
    showGrid       : boolean @label "Show Grid" @description "3D only: show the ground grid (default off)." @tier "presentation"
    showVelocity   : boolean = true @label "Show Velocity" @description "showVelocity prop" @tier "presentation"
    surface3d      : PhysicsCanvasSurface3d @label "Surface3d" @description "A 3D height-field surface mesh (wave, terrain, potential well). 3D only." @tier "presentation"
    title          : string @label "Title" @description "title prop" @tier "presentation"
    traces         : [PhysicsCanvasTracesItem] = [] @label "Traces" @description "Inset sparkline panels, forwarded to LearningCanvas verbatim." @tier "presentation"
    trails         : [PhysicsCanvasTrailsItem] = [] @label "Trails" @description "Fading trajectory polylines (2D) / trajectory tubes (3D)." @tier "presentation"
    vectors        : [PhysicsCanvasVectorsItem] = [] @label "Vectors" @description "Named force/velocity/free-body arrows, anchored by point or by body id. 2D only." @tier "presentation"
    vectors3d      : [PhysicsCanvasVectors3dItem] = [] @label "Vectors3d" @description "Labeled 3D arrows (field arrows, axis triads). 3D only." @tier "presentation"
    vectorScale    : number = 1 @label "Vector Scale" @description "Multiplies every `vectors3d` entry's `dx`/`dy`/`dz` (default 1). 3D only." @tier "presentation"
    velocityScale  : number = 20 @label "Velocity Scale" @description "velocityScale prop" @tier "presentation"
    width          : number = 600 @label "Width" @description "width prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/ui-physics-canvas.orb orbitals[0].traits[0])"
}

