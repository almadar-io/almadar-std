  transitions    : ((loading -> loading on INIT) (loading -> browsing on ThreadPostLoaded) (loading -> error on ThreadPostLoadFailed) (loading -> loading on SET_THREAD_ROOT) (browsing -> loading on INIT) (browsing -> browsing on ThreadPostLoaded) (browsing -> browsing on REPLY) (browsing -> replying on REPLY) (browsing -> browsing on ThreadPostCreated) (browsing -> loading on SELECT) (browsing -> browsing on EDIT_REPLY) (browsing -> browsing on SUBMIT_REPLY) (browsing -> browsing on CANCEL_REPLY) (browsing -> browsing on ThreadPostCreateFailed) (browsing -> error on ThreadPostLoadFailed) (browsing -> loading on SET_THREAD_ROOT) (replying -> replying on EDIT_REPLY) (replying -> browsing on SUBMIT_REPLY) (replying -> browsing on CANCEL_REPLY) (replying -> browsing on ThreadPostCreated) (replying -> replying on ThreadPostCreateFailed) (replying -> loading on SET_THREAD_ROOT) (error -> loading on INIT) (error -> loading on SET_THREAD_ROOT))
  emits          : (SELECT REPLY EDIT_REPLY SUBMIT_REPLY CANCEL_REPLY ThreadPostLoaded ThreadPostLoadFailed ThreadPostCreated ThreadPostCreateFailed)
  config {
    bodyContent    : render-ui = {"children":[["if",["!=","@config.sectionTitle",""],{"content":"@config.sectionTitle","type":"typography","variant":"h4"},{"children":[],"gap":"none","type":"stack"}],{"entity":"@payload.data","fields":[{"label":"Author","name":"authorName","variant":"h4"},{"label":"","name":"content","variant":"body"},{"label":"Votes","name":"voteCount","variant":"caption"}],"gap":"sm","itemActions":[{"event":"REPLY","icon":"message-square","label":"Reply"}],"look":"@config.tableLook","type":"data-list","variant":"card"},["if",["!=","@config.sectionTitle",""],{"action":"REPLY","icon":"message-square","label":"@config.composerLabel","type":"button","variant":"secondary"},{"children":[],"gap":"none","type":"stack"}]],"direction":"vertical","gap":"md","type":"stack"} @label "Body content tree" @description "Render-ui SExpr rendered after thread posts load. Default is the canonical forum-style data-list. Layer 3 variants override this with their own tree (chat bubbles, email-threaded cards, linear comment stacks, etc.) to deliver entirely different thread UX while inheriting the same trait, state machine, emits, and listens." @tier "internal"
    composerLabel  : string = "Add comment" @label "composerLabel" @description "Label of the standalone composer button rendered under the post list when sectionTitle is non-empty." @synonyms "reply label, comment button, add comment" @tier "presentation"
    detailAuthorBinding : string = "@entity.focusedRow.authorName" @label "detailAuthorBinding" @description "Detail-pane binding for the focused message author." @tier "presentation"
    detailContentBinding : string = "@entity.focusedRow.content" @label "detailContentBinding" @description "Detail-pane binding for the message body." @tier "presentation"
    detailDateBinding : string = "@entity.focusedRow.createdAt" @label "detailDateBinding" @description "Detail-pane binding for the timestamp." @tier "presentation"
    detailFromBinding : string = "@entity.focusedRow.fromAddress" @label "detailFromBinding" @description "Detail-pane binding for the From address." @tier "presentation"
    detailSubjectBinding : string = "@entity.focusedRow.subject" @label "detailSubjectBinding" @description "Detail-pane binding for the focused message subject." @tier "presentation"
    detailToBinding : string = "@entity.focusedRow.toAddress" @label "detailToBinding" @description "Detail-pane binding for the To address." @tier "presentation"
    emailAuthorBinding : string = "@item.authorName" @label "emailAuthorBinding" @description "List-pane binding for the message author." @tier "presentation"
    emailPreviewBinding : string = "@item.preview" @label "emailPreviewBinding" @description "List-pane binding for the message preview text." @tier "presentation"
    emailSubjectBinding : string = "@item.subject" @label "emailSubjectBinding" @description "List-pane binding for the message subject." @tier "presentation"
    flat           : boolean = false @label "Flat thread" @description "Render replies as a linear list instead of nested tree" @tier "presentation"
    recipientName  : string = "Conversation" @label "recipientName" @description "Header/recipient label for chat-style threads." @tier "presentation"
    replyAuthorBinding : string = "@reply.authorName" @label "replyAuthorBinding" @description "Reply binding for the reply author." @tier "presentation"
    replyContentBinding : string = "@reply.content" @label "replyContentBinding" @description "Reply binding for the reply body." @tier "presentation"
    replyDateBinding : string = "@reply.createdAt" @label "replyDateBinding" @description "Reply binding for the reply timestamp." @tier "presentation"
    replyFromBinding : string = "@reply.fromAddress" @label "replyFromBinding" @description "Reply binding for the reply From address." @tier "presentation"
    sectionTitle   : string = "" @label "sectionTitle" @description "Section header rendered by the default bodyContent when non-empty, along with a standalone composer button — the only REPLY affordance an empty thread has. Blank (the default) keeps the bare post list for embedded threads that bring their own chrome (chat rails, custom comment sections)." @synonyms "header, comments title, discussion title" @tier "presentation"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    threadRootId   : string = "" @label "Root post id" @description "Top-level post whose descendants are loaded, filters every fetch and defaults new top-level replies' threadRootId (blank = all roots, unfiltered)" @synonyms "rootId, topLevelId, scope, threadScope" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-thread.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ml/atoms/std-tokenizer.orb orbitals[0].traits[0])
trait std-tokenizer.traits.TokenizerRun {
  alias          : Tokenizer
  linkedEntity   : TokenSequence
  category       : lifecycle
  states         : (idle* checked)
  events         : (INIT TOKENIZE RESET TOKENIZED)
  transitions    : ((idle -> idle on INIT) (idle -> checked on TOKENIZE) (checked -> checked on INIT) (checked -> idle on RESET))
  emits          : (TOKENIZED)
  config {
    delimiter      : string = "," @label "Delimiter" @description "Split delimiter used when method is delimiter; ignored otherwise" @tier "domain"
    lowercase      : boolean = true @label "Lowercase" @description "Lowercase every token before vocabulary lookup" @tier "policy"
    maxLength      : int = 512 @label "Max length" @description "Truncate the token sequence to at most this many tokens" @tier "policy"
    method         : string = "whitespace" @label "Method" @description "Whitespace splits on single spaces, character splits into individual characters, delimiter splits on config.delimiter" @tier "policy" @values (whitespace character delimiter)
    trimWhitespace : boolean = true @label "Trim whitespace" @description "Trim each token and drop tokens that are empty afterward" @tier "policy"
    unkId          : int = 0 @label "Unknown token id" @description "Id assigned to a token that is not present in config.vocab" @tier "policy"
    vocab          : Map<string,int> = {} @label "Vocabulary" @description "Token-to-id map; a token absent from this map resolves to unkId" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-tokenizer.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-tree.orb orbitals[0].traits[0])
trait std-tree.traits.TreeBrowse {
  alias          : Tree
  linkedEntity   : TreeNode
  category       : interaction
  states         : (loading* browsing error)
  events         : (SET_CURRENT INIT TreeNodeLoaded TreeNodeLoadFailed REFETCH_QUERY REFETCH_FILTER OPEN_NODE ADD_CHILD RETRY CHILD_REQUESTED)
  transitions    : ((loading -> loading on SET_CURRENT) (loading -> loading on INIT) (loading -> browsing on TreeNodeLoaded) (loading -> error on TreeNodeLoadFailed) (browsing -> loading on INIT) (browsing -> browsing on REFETCH_QUERY) (browsing -> browsing on REFETCH_FILTER) (browsing -> browsing on OPEN_NODE) (browsing -> browsing on SET_CURRENT) (browsing -> browsing on ADD_CHILD) (browsing -> browsing on TreeNodeLoaded) (browsing -> error on TreeNodeLoadFailed) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (OPEN_NODE CHILD_REQUESTED TreeNodeLoaded TreeNodeLoadFailed)
  config {
    bodySearch     : boolean = false @label "Show the tree's own search box?" @description "Embeds a search box above the tree that re-fetches the flat node set server-side. Set false (the default) when the page already provides a search affordance (a toolbar Search molecule), so the surface shows one search box instead of two." @synonyms "inline search, list search, built-in search, show search, duplicate search" @tier "presentation"
    childAction    : boolean = false @label "Row + affordance?" @description "Render a hover + on every row that emits CHILD_REQUESTED { parentId } — wire it to the host's create-draft writer so new records are born inside the node." @synonyms "add inside, new subpage button, plus on rows" @tier "domain"
    childActionLabel : string = "Add inside" @label "Row + tooltip" @description "Accessible label on the row's + affordance (e.g. New subpage)." @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the tree?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the tree; each selection fires REFETCH_FILTER on this trait, re-fetching the flat node set. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this tree and routes `XFilter.FILTER -> REFETCH_FILTER` — that is the wired owner and remains the primary path." @synonyms "filter bar, faceted filters, field filters, dropdowns" @tier "presentation"
    iconField      : string = "icon" @label "Icon column" @description "Entity field holding each node's icon name; point it at a nonexistent field (or empty) to suppress per-node icons." @synonyms "glyph field, icon column" @tier "presentation"
    labelField     : string = "name" @label "Label column" @description "Entity field rendered as each node's label. Config-driven on purpose: the trait-level `fields {}` remap is compiled-path-only (the JS runtime never applies it), so a rebind names its columns here and both execution paths agree." @synonyms "title field, name column, display field" @tier "domain"
    look           : string = "full" @label "Tree look" @description "full = standalone section (heading, count, divider); rail = compact sidebar navigation (slim caption, nav-styled rows) for an app layout's sidebarTrait slot." @synonyms "sidebar tree, rail look, nav tree, compact" @tier "presentation" @values (full rail)
    parentField    : string = "parentId" @label "Parent column" @description "Entity field holding the parent reference the hierarchy nests by." @synonyms "parent id field, hierarchy column" @tier "domain"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the tree search box (e.g. 'Search nodes…')." @synonyms "search hint, placeholder, search box text, search label" @tier "presentation"
    title          : string = "Tree" @label "Section title" @description "Heading shown above the tree" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-tree.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-tutorial-autodemo.orb orbitals[0].traits[0])
trait std-tutorial-autodemo.traits.AutoDemo {
  alias          : TutorialAutodemo
  linkedEntity   : AutoDemoData
  category       : interaction
  states         : (idle* playing)
  events         : (INIT TUTORIAL_DEMO_START TUTORIAL_DEMO_STOP DEMO_CANCEL DEMO_LEFT DEMO_RIGHT DEMO_JUMP DEMO_STOP)
  transitions    : ((idle -> idle on INIT) (idle -> playing on TUTORIAL_DEMO_START) (idle -> idle on TUTORIAL_DEMO_STOP) (idle -> idle on DEMO_CANCEL) (playing -> playing on TUTORIAL_DEMO_START) (playing -> idle on TUTORIAL_DEMO_STOP) (playing -> idle on DEMO_CANCEL))
  emits          : (DEMO_LEFT DEMO_RIGHT DEMO_JUMP DEMO_STOP)
  config {
    scripts        : [DemoScript] = [] @label "Scripts" @description "Named cue scripts keyed by the tutorial step's demoId; each cue fires its event after `at` milliseconds of the demo clock." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-tutorial-autodemo.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-tutorial-overlay.orb orbitals[0].traits[0])
trait std-tutorial-overlay.traits.TutorialEmptyPreview {
  alias          : TutorialOverlay
  linkedEntity   : TutorialState
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-tutorial-overlay.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-tutorial-overlay.orb orbitals[0].traits[1])
trait std-tutorial-overlay.traits.TutorialOverlay {
  alias          : TutorialOverlay
  linkedEntity   : TutorialState
  category       : interaction
  states         : (hidden* showing)
  events         : (INIT TUT_AUTO SHOW TUT_NEXT TUT_BACK TUT_DISMISS CLOSE TUTORIAL_DONE TUTORIAL_DEMO_START TUTORIAL_DEMO_STOP)
  transitions    : ((hidden -> hidden on INIT) (hidden -> showing on TUT_AUTO) (hidden -> showing on SHOW) (showing -> showing on TUT_NEXT) (showing -> hidden on TUT_NEXT) (showing -> showing on TUT_BACK) (showing -> hidden on TUT_DISMISS) (showing -> hidden on CLOSE))
  emits          : (TUT_AUTO TUT_NEXT TUT_BACK TUT_DISMISS SHOW TUTORIAL_DONE TUTORIAL_DEMO_START TUTORIAL_DEMO_STOP)
  config {
    autoShow       : boolean = true @label "Auto Show" @description "When true the tutorial opens on INIT for this run; when false it stays hidden until SHOW." @tier "domain"
    previewTrait   : trait = "@trait.TutorialEmptyPreview" @label "Preview trait" @description "Trait rendered in the media position of the modal — the live, demo-driven preview of the mechanic (a bare game canvas, no shell chrome). '@trait.TutorialEmptyPreview' leaves the slot blank. Override with '@trait.<TraitName>' to show a board's live frame." @tier "presentation"
    steps          : [TutorialStep] = [] @label "Steps" @description "One row per tutorial page: title, one line of body copy, and an optional demoId that plays a scripted live demo (std-tutorial-autodemo) for the mechanic being taught." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-tutorial-overlay.orb orbitals[0].traits[1])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-velocity-gate.orb orbitals[0].traits[0])
trait std-velocity-gate.traits.VelocityGate {
  alias          : VelocityGate
  linkedEntity   : VelocityGateData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_VGATES RESTART VELOCITY_GATE_OPENED VELOCITY_GATE_DENIED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_VGATES) (active -> active on RESTART))
  emits          : (VELOCITY_GATE_OPENED VELOCITY_GATE_DENIED)
  config {
    gates          : [VelocityGate] = [] @label "Gates" @description "One row per velocity gate: id, min-corner rect (x, y, width, height in world units), the speed band [minSpeed, maxSpeed] that opens it, the hold required (dwellMs 0 = instant), the horizontal direction required (dir -1/0/+1), and an optional hint shown when denied. open/touching/denied/held/reported are stamped at runtime. Seeded onto the entity on INIT; the live set is entity.gates — SET_VGATES replaces it at runtime (boards that import gates), and RESTART re-arms the live set rather than re-reading config, so injected gates survive respawns." @tier "domain"
    reachMargin    : number = 0.6 @label "Reach Margin" @description "Extra world units padded around a closed gate's rect when testing player contact (approximates the body's size)." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED tests every gate's band and opens/denies; toggle to freeze every gate as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-velocity-gate.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-version-history.orb orbitals[0].traits[0])
trait std-version-history.traits.RevisionManage {
  alias          : VersionHistory
  linkedEntity   : Revision
  category       : interaction
  states         : (loading* browsing viewing_single comparing error)
  events         : (INIT RevisionLoaded RevisionRolledBack RevisionRollbackFailed RevisionLoadFailed SHOW_HISTORY OPEN_REVISION ROLLBACK CLOSE_VIEW COMPARE)
  transitions    : ((loading -> loading on INIT) (loading -> browsing on RevisionLoaded) (loading -> loading on RevisionRolledBack) (loading -> error on RevisionRollbackFailed) (loading -> error on RevisionLoadFailed) (loading -> loading on SHOW_HISTORY) (browsing -> loading on INIT) (browsing -> viewing_single on OPEN_REVISION) (browsing -> loading on ROLLBACK) (browsing -> loading on SHOW_HISTORY) (viewing_single -> loading on CLOSE_VIEW) (viewing_single -> comparing on COMPARE) (viewing_single -> loading on ROLLBACK) (viewing_single -> loading on SHOW_HISTORY) (comparing -> loading on CLOSE_VIEW) (comparing -> loading on ROLLBACK) (comparing -> loading on SHOW_HISTORY) (error -> loading on INIT) (error -> loading on SHOW_HISTORY))
  emits          : (OPEN_REVISION CLOSE_VIEW COMPARE ROLLBACK RevisionLoaded RevisionLoadFailed RevisionRolledBack RevisionRollbackFailed)
  config {
    scopeField     : string = "" @label "Scope field" @description "Revision entity field holding the parent document's id. When set, a page-mounted {id} route param scopes INIT's fetch, and a SHOW_HISTORY { key } event rescopes the feed, to rows whose scopeField equals the id/key; rollback and retry refetches stay scoped too. Empty (default) or no id = unfiltered global feed, unchanged from prior behavior." @tier "domain"
    statLook       : string = "elevated" @label "Stat display look" @description "Layer 2 visual treatment for stat / KPI cards." @tier "presentation" @values (elevated flat progress-backed gauge sparkline)
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    title          : string = "Version History" @label "Section title" @description "Heading shown above the revision list" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-version-history.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-vote.orb orbitals[0].traits[0])
trait std-vote.traits.VoteCast {
  alias          : Vote
  linkedEntity   : Vote
  category       : interaction
  states         : (loading* idle voting error)
  events         : (INIT VoteLoaded VoteLoadFailed VOTE SET_VOTE_TARGET VoteCasted VoteCastFailed)
  transitions    : ((loading -> loading on INIT) (loading -> idle on VoteLoaded) (loading -> idle on VoteLoadFailed) (idle -> voting on VOTE) (idle -> voting on VOTE) (idle -> idle on SET_VOTE_TARGET) (idle -> idle on VoteLoaded) (idle -> idle on VoteLoadFailed) (voting -> idle on VoteCasted) (voting -> error on VoteCastFailed) (error -> loading on INIT))
  emits          : (VOTE VoteLoaded VoteLoadFailed VoteCasted VoteCastFailed)
  config {
    allowDown      : boolean = true @label "Allow downvotes" @description "Show the downvote arrow alongside the upvote" @tier "domain"
  }
