;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-breadcrumb.orb orbitals[0].traits[0])
trait ui-breadcrumb.traits.BreadcrumbRender {
  alias          : UiBreadcrumb
  linkedEntity   : BreadcrumbItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.itemEvent)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.itemEvent)
  config {
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    fromNavStack   : boolean = false @label "From Nav Stack" @description "Render the current orbital's navigation stack (NavStackProvider) as the trail: one crumb per visited/declared level, last entry current. The stack is client-session state both execution paths maintain; outside a provider this renders nothing." @tier "presentation"
    itemEvent      : event = "ITEM" @label "Item Event" @description "Event emitted when a non-current crumb is clicked, with payload `{ label, href, index }` — the trait handles it with `(navigate ?href)`. Without it, stack crumbs navigate directly." @tier "presentation"
    items          : [BreadcrumbItemsItem] = [] @label "Items" @description "Breadcrumb items. Omit together with `fromNavStack` to render the orbital-scoped navigation stack instead of an authored trail." @tier "presentation"
    maxItems       : number @label "Max Items" @description "Maximum items to show (truncates with ellipsis)" @tier "presentation"
    separator      : icon @label "Separator" @description "Separator icon (canonical kebab-case name or LucideIcon component)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-breadcrumb.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-calendar-grid.orb orbitals[0].traits[0])
trait ui-calendar-grid.traits.CalendarGridRender {
  alias          : UiCalendarGrid
  linkedEntity   : CalendarGridItem
  category       : interaction
  states         : (idle*)
  events         : (INIT CalendarGridLoaded @config.onSlotClick @config.onDayClick @config.onEventClick @config.longPressEvent @config.swipeLeftEvent @config.swipeRightEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on CalendarGridLoaded))
  emits          : (@config.onSlotClick @config.onDayClick @config.onEventClick @config.longPressEvent @config.swipeLeftEvent @config.swipeRightEvent CalendarGridLoaded)
  config {
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    colorField     : string = "color" @label "Color Field" @description "Row field holding the chip's Tailwind colour class. Defaults to `color`." @tier "presentation"
    dayWindow      : string @label "Day Window" @description "Override the viewport-driven day window. `'auto'` (default) tracks `window.innerWidth` — 1 day on mobile, 3 on tablet, 7 on laptop+. Pass an explicit number to force a fixed window (useful for print layouts or screenshot tests)." @tier "presentation"
    endField       : string = "endTime" @label "End Field" @description "Row field holding the end timestamp (ISO or epoch). Defaults to `endTime`. When a row carries an end, the event's chip renders in its start slot and every further slot it covers shows a subdued continuation bar — without this, multi-hour events silently collapsed to their first hour." @tier "presentation"
    longPressEvent : event = "LONG_PRESS" @label "Long Press Event" @description "Event emitted on long-press of a time slot: UI:{longPressEvent} with { date, time, ...longPressPayload }" @tier "presentation"
    longPressPayload : @payload(longPressEvent) @label "Long Press Payload" @description "Additional payload for long-press events" @tier "presentation"
    onDayClick     : event = "DAY_CLICK" @label "On Day Click" @description "Called when a day header is clicked" @tier "presentation"
    onEventClick   : event = "EVENT_CLICK" @label "On Event Click" @description "Called when an event is clicked" @tier "presentation"
    onSlotClick    : event = "SLOT_CLICK" @label "On Slot Click" @description "Called when a time slot is clicked" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    startField     : string = "startTime" @label "Start Field" @description "Row field holding the start timestamp (ISO or epoch). Defaults to `startTime`." @tier "presentation"
    swipeLeftEvent : event = "SWIPE_LEFT" @label "Swipe Left Event" @description "Event emitted on swipe left (next week): UI:{swipeLeftEvent}" @tier "presentation"
    swipeRightEvent : event = "SWIPE_RIGHT" @label "Swipe Right Event" @description "Event emitted on swipe right (prev week): UI:{swipeRightEvent}" @tier "presentation"
    timeSlots      : [string] = [] @label "Time Slots" @description "Time slot labels (defaults to 09:00-17:00)" @tier "presentation"
    titleField     : string = "title" @label "Title Field" @description "Row field holding the chip label. Defaults to `title`. Lets a host bound to its own entity name the column instead of being forced to rename its fields to this grid's contract (same accessor idiom as `DataList`'s `senderField` / `DataGrid`'s `imageField`)." @tier "presentation"
    weekStart      : date = "2024-01-01" @label "Week Start" @description "Start of the week (defaults to current week's Monday)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-calendar-grid.orb orbitals[0].traits[0])"
}

