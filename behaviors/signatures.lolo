trait std-platformer-board-2d.traits.PlatformerIntent {
  alias          : PlatformerBoard2d
  linkedEntity   : GameState
  category       : interaction
  states         : (playing*)
  events         : (INIT LEFT RIGHT STOP JUMP PLAT_GOAL PLAT_HAZARD PLAT_FELL GAME_END PLAY_AGAIN PLAT_STEER PLAT_JUMP PLAT_PLACE BURST PROGRESS RESTART)
  transitions    : ((playing -> playing on INIT) (playing -> playing on LEFT) (playing -> playing on RIGHT) (playing -> playing on STOP) (playing -> playing on JUMP) (playing -> playing on PLAT_GOAL) (playing -> playing on PLAT_HAZARD) (playing -> playing on PLAT_FELL) (playing -> playing on GAME_END) (playing -> playing on PLAY_AGAIN))
  emits          : (LEFT RIGHT STOP JUMP PLAT_STEER PLAT_JUMP PLAT_PLACE PLAT_GOAL PLAT_HAZARD PLAT_FELL BURST PROGRESS GAME_END RESTART PLAY_AGAIN)
  config {
    backgroundAsset : Asset = {} @label "Background Asset" @description "Game-shell background panel sprite (theme chrome)" @tier "presentation"
    backgroundImage : Asset = {} @label "Background Image" @description "Canvas background image Asset" @tier "presentation"
    bgColor        : string = "#5c94fc" @label "Bg Color" @description "Canvas background color" @tier "presentation"
    clearTitle     : string = "YOU WIN!" @label "Clear Title" @description "Overlay title when the goal tile is reached" @tier "presentation"
    directionAssets : DirectionAssets = {} @label "Direction Assets" @description "D-pad direction icon sprites" @tier "presentation"
    fxPresets      : [FxPreset] = [{"color":"#ffe066","color2":"#fff4cc","count":6,"glow":0.15,"shape":"spark","size":22,"type":"score","vy":-35},{"color":"#ef4444","color2":"#7f1d1d","count":5,"glow":0.12,"gravity":40,"shape":"spark","size":20,"type":"damage"}] @label "Fx Presets" @description "This board's effect vocabulary — one look/recipe row per fx type its intent trait emits (goal score, hazard/fell damage)." @tier "presentation"
    goalScore      : number = 100 @label "Goal Score" @description "Points awarded when the body touches the goal tile" @tier "domain"
    hudBackgroundAsset : Asset = {} @label "HUD Background Asset" @description "HUD panel background sprite (theme chrome)" @tier "presentation"
    lostTitle      : string = "GAME OVER" @label "Lost Title" @description "Overlay title when lives run out" @tier "presentation"
    platforms      : [PlatformerPlatform] = [{"height":32,"id":"g0","type":"ground","width":800,"x":0,"y":368},{"height":16,"id":"p1","type":"platform","width":160,"x":150,"y":280},{"height":16,"id":"p2","type":"platform","width":160,"x":420,"y":220},{"height":16,"id":"h1","type":"hazard","width":80,"x":580,"y":300},{"height":28,"id":"goal","type":"goal","width":64,"x":700,"y":340}] @label "Platforms" @description "Level geometry rendered by the canvas (must match BodyAuthority.platforms, which owns collision — override both together)" @tier "domain"
    playerSprite   : Asset = {} @label "Player Sprite" @description "Player sprite Asset; its atlas must expose adventurer_idle/walk1/walk2/jump frames (or override the sprite-selection expression)" @tier "presentation"
    respawnX       : number = 80 @label "Respawn X" @description "X the body teleports to after hazard/pit damage (matches BodyAuthority spawn.x)" @tier "domain"
    respawnY       : number = 320 @label "Respawn Y" @description "Y the body teleports to after hazard/pit damage (matches BodyAuthority spawn.y)" @tier "domain"
    startLives     : number = 3 @label "Start Lives" @description "Lives seeded on INIT/PLAY_AGAIN; hazard or pit contact costs one, zero loses the round" @tier "domain"
    tileSprites    : Map<string,Asset> = {} @label "Tile Sprites" @description "Map of platform type (ground/platform/hazard/goal) to tile sprite Asset" @tier "presentation"
    worldHeight    : number = 400 @label "World Height" @description "World pixel height (camera + canvas bounds)" @tier "presentation"
    worldWidth     : number = 800 @label "World Width" @description "World pixel width (camera + canvas bounds)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/organisms/std-platformer-board-2d.orb orbitals[0].traits[0])"
}

