    fillAsset      : HealthBarFillAsset @label "Fill Asset" @description "Sprite image tiled across the filled portion of bar/progress formats. Falls back to CSS color gradient." @tier "presentation"
    format         : string = "hearts" @label "Format" @description "Display format. - `hearts` / `bar` / `numeric` — health display - `progress` — XP / generic progress bar with optional level badge and value label" @tier "presentation" @values (hearts bar numeric progress)
    frameAsset     : HealthBarFrameAsset @label "Frame Asset" @description "Sprite image used as the bar track/frame border for bar/progress formats. Falls back to CSS rounded bg-muted." @tier "presentation"
    labelSuffix    : string @label "Label Suffix" @description "Label suffix shown next to the value (e.g. 'XP') when showLabel=true" @tier "presentation"
    level          : number @label "Level" @description "Current level — shown as 'Lv.N' badge when format='progress'" @tier "presentation"
