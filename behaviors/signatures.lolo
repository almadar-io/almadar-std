    enabled        : boolean = true @label "Run the review workflow?" @description "Accept submissions into review. Off = submissions are ignored." @synonyms "enable, turn on, review, require review, review workflow" @tier "policy"
    requireSeparateApproval : boolean = true @label "Require approval to be a separate action?" @description "Four-eyes review: reject an approval raised by the same action that submitted the record, such as an automatic rule or bot that approves instantly. Approvals made as their own action are unaffected." @synonyms "four eyes, two person rule, no self approval, separate reviewer, independent approval, no auto approve" @tier "policy"
  }
