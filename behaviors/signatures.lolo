    layout         : string = "row" @label "Layout" @description "row = side-by-side columns, vertical = a top-to-bottom list" @tier "presentation" @values (row vertical)
    lede           : string = "" @label "Supporting text" @tier "presentation"
    steps          : [StepItem] = [{"description":"Say what you want in plain words.","title":"Describe it"},{"description":"Check the plan before anything is built.","title":"Review it"},{"description":"Publish when it looks right.","title":"Ship it"}] @label "Steps" @description "One entry per step: title, optional description and icon (an icon replaces the step number)" @synonyms "how it works, process, stages, phases, path" @tier "presentation"
    surface        : string = "plain" @label "Surface" @tier "presentation" @values (plain muted)
  }
