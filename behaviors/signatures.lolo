    styles         : Map<string,StyleDef> = {"celebrate":{"color":"#facc15","effect":"sparkle","size":0.9,"ttl":3},"fact":{"color":"#38bdf8","effect":"float-text","size":0.7,"ttl":3},"hint":{"color":"#a78bfa","effect":"float-text","size":0.6,"ttl":2},"warn":{"color":"#f87171","effect":"shake","size":0.6,"ttl":1.5}} @label "Styles" @description "Map of narrative style to color, size, ttl, and effect. Override per game theme." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-fx-narrative.orb orbitals[0].traits[0])"
