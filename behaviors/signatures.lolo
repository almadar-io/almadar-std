;; ============================================================================
;; Behavior reference surface (from @almadar/std + @almadar-io/behaviors behaviors/registry/*.orb)
;; ============================================================================

;; Each behavior file ships a registry .orb file describing its callable
;; surface. Authors import it with
;;   uses Alias from "std/behaviors/std-X"   (or "almadar-behaviors/X" for io)
;; and reference its parts as Alias.entity, Alias.traits.X, Alias.pages.X,
;; and Alias.orbitals.X — with overrides at the call site (linkedEntity, name,
;; events, effects, listens, emitsScope, config for traits; path/linkedEntity/
;; traits for pages; extends/name/fields/persistence/collection for entities;
;; entity/fields/extend/pages/omit/only/config/events/roles/entities/mounts for orbitals).
;;
;; The state-machine topology of an imported trait is fixed: states,
;; transitions, and event keys come from the atom that defines them.
;; Override fields rebind identifiers and replace effects, but cannot
;; add or remove states or transitions. Same rule at the orbital level:
;; an `Alias.orbitals.X` reference overrides config + identifiers, never
;; the imported orbital's own topology.

;; === atoms (275 behaviors, 275 apps, 275 orbitals, 275 entities, 301 traits, 278 pages) ===

;; From @almadar/std (behaviors/registry/agent/atoms/std-agent-completion.orb)
app std-agent-completion {
  alias          : AgentCompletion
  version        : "1.0.0"
  orbitals       : (AgentCompletionOrbital)
  override-surface : (config)
  ;; via uses Alias from "std/behaviors/std-agent-completion" { config { ... } }
  source         : "@almadar/std (behaviors/registry/agent/atoms/std-agent-completion.orb)"
}

;; From @almadar/std (behaviors/registry/agent/atoms/std-agent-context.orb)
app std-agent-context {
