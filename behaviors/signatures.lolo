  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    align          : string = "left" @label "Align" @description "Text alignment" @tier "presentation" @values (left center right)
    children       : node @label "Children" @description "Children elements" @tier "presentation"
    className      : string @label "Class Name" @description "Additional class names" @tier "presentation"
    color          : string = "primary" @label "Color" @description "Text color" @tier "presentation" @values (primary secondary muted error success warning inherit)
    content        : node @label "Content" @description "Text content (alternative to children)" @tier "presentation"
    format         : string = "none" @label "Format" @description "Value formatting applied to string/number/Date content — `none` (the default) renders content as-is. Covers the raw-ISO-date class: a bound datetime renders human-readable via `format='date'|'time'|'datetime'`." @tier "presentation" @values (none date time datetime number currency percent)
    level          : number @label "Level" @description "Heading level (1-6) - alternative to variant for headings" @tier "presentation"
    overflow       : string = "visible" @label "Overflow" @description "Overflow handling mode" @tier "presentation" @values (visible hidden wrap clamp-2 clamp-3)
    size           : string = "none" @label "Size" @description "Font size override" @tier "presentation" @values (none xs sm md lg xl 2xl 3xl)
    style          : Map<string,string> = {} @label "Style" @description "Inline style" @tier "presentation"
    truncate       : boolean = false @label "Truncate" @description "Truncate with ellipsis (single line)" @tier "presentation"
    variant        : string = "h1" @label "Variant" @description "Typography variant" @tier "presentation" @values (h1 h2 h3 h4 h5 h6 heading subheading body1 body2 body caption overline small large label)
    weight         : string = "none" @label "Weight" @description "Font weight override — `none` = no override, the variant's baked weight applies" @tier "presentation" @values (none light normal medium semibold bold)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/ui-typography.orb orbitals[0].traits[0])"
}

