    defaultTab     : string = "overview" @label "Default tab" @description "Tab id selected on first render" @tier "presentation"
    orientation    : string = "horizontal" @label "Orientation" @description "Horizontal strip or vertical rail layout" @tier "presentation" @values (horizontal vertical)
    tabs           : [TabSpec] = [{"icon":"info","id":"overview","label":"Overview"},{"icon":"list","id":"details","label":"Details"},{"icon":"settings","id":"settings","label":"Settings"}] @label "Tabs" @description "Tab entries with id, label, icon, badge, and optional content trait" @tier "presentation"
    variant        : string = "default" @label "Tab style" @description "Visual style of the tab strip" @tier "presentation" @values (default pills underline)
  }
