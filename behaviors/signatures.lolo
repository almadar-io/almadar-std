trait ui-wizard-container.traits.WizardContainerRender {
  alias          : UiWizardContainer
  linkedEntity   : WizardContainerItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onStepChange @config.onComplete @config.nextEvent @config.backEvent)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onStepChange @config.onComplete @config.nextEvent @config.backEvent)
  config {
    allowBack      : boolean = true @label "Allow Back" @description "Allow navigation to previous steps" @tier "presentation"
    backEvent      : event = "BACK" @label "Back Event" @description "Emits UI:{backEvent} when going to previous step" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    compact        : boolean = false @label "Compact" @description "Modal mode (compact header, no padding)" @tier "presentation"
    completeEvent  : event = "COMPLETE" @label "Complete Event" @description "Emits UI:{completeEvent} when wizard completes" @tier "presentation"
    currentStep    : scalar @label "Current Step" @description "Current step index (controlled) - accepts number or string for generated code compatibility" @tier "presentation"
    error          : WizardContainerError @label "Error" @description "Error state" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    nextEvent      : event = "NEXT" @label "Next Event" @description "Emits UI:{nextEvent} when advancing to next step" @tier "presentation"
