;; From @almadar/std (behaviors/registry/ui/learning/atoms/ui-chemistry-canvas.orb orbitals[0].traits[0])
trait ui-chemistry-canvas.traits.ChemistryCanvasRender {
  alias          : UiChemistryCanvas
  linkedEntity   : ChemistryCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT UPDATE @config.onShapeClick)
  transitions    : ((idle -> idle on INIT) (idle -> idle on UPDATE))
  emits          : (@config.onShapeClick)
  config {
    animate        : boolean = false @label "Animate" @description "2D only: continuous redraw loop. 3D motion is entity-state driven." @tier "presentation"
    arrows         : [ChemistryCanvasArrowsItem] = [] @label "Arrows" @description "arrows prop" @tier "presentation"
    atoms          : [ChemistryCanvasAtomsItem] = [] @label "Atoms" @description "atoms prop" @tier "presentation"
    backgroundColor : string @label "Background Color" @description "backgroundColor prop" @tier "presentation"
    bonds          : [ChemistryCanvasBondsItem] = [] @label "Bonds" @description "bonds prop" @tier "presentation"
    bondStyle      : string = "thick" @label "Bond Style" @description "Bond line rendering: 'thick' varies stroke width by order (default), 'parallel' draws offset parallel strokes. 2D only." @tier "presentation" @values (thick parallel)
    camera         : ChemistryCanvasCamera @label "Camera" @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })." @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    containers     : [ChemistryCanvasContainersItem] = [] @label "Containers" @description "Beaker/flask/container outlines (2D only)." @synonyms "beaker, flask, box, membrane, burette" @tier "presentation"
    equation       : string @label "Equation" @description "Reaction equation text centered at the top of the canvas. 2D only." @synonyms "reaction equation, formula" @tier "presentation"
    equationColor  : string @label "Equation Color" @description "Equation text color (default '#111827')." @tier "presentation"
    error          : ChemistryCanvasError @label "Error" @description "error prop" @tier "presentation"
    height         : number = 400 @label "Height" @description "height prop" @tier "presentation"
    interactive    : boolean @label "Interactive" @description "2D: pointer interaction (click/hover). 3D: orbit camera controls." @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "isLoading prop" @tier "presentation"
    lattice3d      : ChemistryCanvasLattice3d @label "Lattice3d" @description "A 3D crystal lattice block (simple cubic, BCC, FCC, rock salt, diamond, ...). 3D only." @tier "presentation"
    lighting       : ChemistryCanvasLighting @label "Lighting" @description "3D only: scene light rig as data." @tier "presentation"
    mode           : string = "2d" @label "Mode" @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host." @tier "presentation" @values (2d 3d)
    onShapeClick   : event = "SHAPE_CLICK" @label "On Shape Click" @description "onShapeClick prop" @tier "presentation"
    post           : ChemistryCanvasPost @label "Post" @description "3D only: post-processing stack (bloom/vignette)." @tier "presentation"
    readouts       : [ChemistryCanvasReadoutsItem] = [] @label "Readouts" @description "Top-right status chip row, forwarded to LearningCanvas verbatim." @tier "presentation"
    shadows        : boolean @label "Shadows" @description "3D only: enable shadows. Omitted → the host default." @tier "presentation"
    shapes         : [ChemistryCanvasShapesItem] = [] @label "Shapes" @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)." @tier "presentation"
    showGrid       : boolean @label "Show Grid" @description "3D only: show the ground grid (default off)." @tier "presentation"
    title          : string @label "Title" @description "title prop" @tier "presentation"
    traces         : [ChemistryCanvasTracesItem] = [] @label "Traces" @description "Inset sparkline panels, forwarded to LearningCanvas verbatim." @tier "presentation"
    width          : number = 600 @label "Width" @description "width prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/ui-chemistry-canvas.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-choice-button.orb orbitals[0].traits[0])
