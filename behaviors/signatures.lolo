;; From @almadar/std (behaviors/registry/ui/core/atoms/std-board.orb orbitals[0].traits[0])
trait std-board.traits.BoardItemBoard {
  alias          : Board
  linkedEntity   : BoardView
  category       : interaction
  states         : (loading* viewing_board viewing_card adding error)
  events         : (INIT BoardItemsLoaded BoardItemsLoadFailed BoardItemsSaved BoardItemDeleted BoardItemsSaveFailed OPEN_CARD ADD_CARD MOVE_CARD REORDER_CARD REORDER_POSITION REFETCH_QUERY REFETCH_FILTER REFETCH_PAGE CLOSE_CARD DELETE_CARD SAVE_CARD CANCEL_ADD EDIT_CARD)
  transitions    : ((loading -> loading on INIT) (loading -> viewing_board on BoardItemsLoaded) (loading -> error on BoardItemsLoadFailed) (loading -> loading on BoardItemsSaved) (loading -> loading on BoardItemDeleted) (loading -> error on BoardItemsSaveFailed) (viewing_board -> loading on INIT) (viewing_board -> viewing_card on OPEN_CARD) (viewing_board -> adding on ADD_CARD) (viewing_board -> viewing_board on MOVE_CARD) (viewing_board -> viewing_board on REORDER_CARD) (viewing_board -> viewing_board on REORDER_POSITION) (viewing_board -> viewing_board on BoardItemsSaved) (viewing_board -> viewing_board on REFETCH_QUERY) (viewing_board -> viewing_board on REFETCH_FILTER) (viewing_board -> viewing_board on REFETCH_PAGE) (viewing_board -> viewing_board on BoardItemsLoaded) (viewing_board -> viewing_board on BoardItemsSaveFailed) (viewing_board -> viewing_board on BoardItemsLoadFailed) (viewing_card -> loading on CLOSE_CARD) (viewing_card -> loading on MOVE_CARD) (viewing_card -> loading on DELETE_CARD) (adding -> loading on SAVE_CARD) (adding -> viewing_board on CANCEL_ADD) (error -> loading on INIT))
  emits          : (OPEN_CARD CLOSE_CARD ADD_CARD CANCEL_ADD SAVE_CARD MOVE_CARD REORDER_CARD DELETE_CARD EDIT_CARD BoardItemsLoaded BoardItemsLoadFailed BoardItemsSaved BoardItemDeleted BoardItemsSaveFailed)
  config {
    boardLook      : string = "columns" @label "Board look" @description "Layer 3 body layout: default N-column data-grid ('columns'), or a Trello-style wide-column kanban with sticky column headers ('kanban-classic')." @tier "presentation" @values (columns kanban-classic)
    bodyContent    : render-ui = {"children":[{"align":"center","children":[{"name":"kanban-square","size":"lg","type":"icon"},{"content":"@config.title","type":"typography","variant":"h3"}],"direction":"horizontal","gap":"sm","type":"stack"},{"type":"divider"},["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BoardView","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"cols":"@config.gridCols","dndRoot":true,"entity":"@entity.boards","fields":[],"gap":"md","renderItem":["fn","col",{"children":[{"children":[{"align":"center","children":[{"name":"@col.icon","type":"icon"},{"content":"@col.label","type":"typography","variant":"h4"},{"label":"@col.count","type":"badge","variant":"@col.variant"}],"direction":"horizontal","gap":"xs","type":"stack"},{"accepts":"*","dragGroup":"@col.key","dropEvent":"MOVE_CARD","entity":"@col.items","fields":[],"gap":"sm","positionEvent":"REORDER_POSITION","renderItem":["fn","item",{"children":[{"children":[{"content":"@config.cardTitleBinding","type":"typography","variant":"h4"},{"color":"muted","content":"@config.cardDescriptionBinding","type":"typography","variant":"caption"},{"align":"center","children":[{"action":"OPEN_CARD","actionPayload":{"description":"@config.cardDescriptionBinding","id":"@config.cardIdBinding","notes":"@config.cardNotesBinding","row":"@item","stage":"@config.cardStageBinding","title":"@config.cardTitleBinding"},"icon":"arrow-right","label":"Open","type":"button","variant":"ghost"}],"direction":"horizontal","gap":"xs","type":"stack"}],"direction":"vertical","gap":"xs","type":"stack"}],"look":"@config.cardLook","type":"card"}],"reorderEvent":"REORDER_CARD","sortable":true,"type":"data-list"}],"direction":"vertical","gap":"sm","type":"stack"}],"look":"@config.cardLook","type":"card"}],"type":"data-grid"},{"action":"ADD_CARD","icon":"plus","label":"Add item","type":"floating-action-button","variant":"primary"}],"direction":"vertical","gap":"md","type":"stack"} @label "Body content tree" @description "Render-ui SExpr rendered after the board loads for boardLook='columns' — the canonical column data-grid with nested per-column data-lists. boardLook='kanban-classic' renders kanbanClassicBodyContent instead; both share this trait's state machine, emits, and listens." @tier "internal"
    bodySearch     : boolean = false @label "Show the board's own search box?" @description "Renders an inline search box above the columns. Defaults false: unlike std-browse, std-board has never had a search box, so defaulting this true would silently add one to every existing consumer. The wired path — composing std-search beside the board and routing its FILTER/SEARCH event to REFETCH_QUERY — works regardless of this knob; set true only for a standalone board with no page-level search affordance." @synonyms "inline search, board search, built-in search, show search, duplicate search" @tier "presentation"
    cardActionsContent : render-ui = {"align":"center","children":[{"action":"DELETE_CARD","actionPayload":{"id":"@entity.currentId"},"icon":"trash-2","label":"Delete","type":"button","variant":"danger"}],"direction":"horizontal","gap":"sm","type":"stack"} @label "Card panel actions" @description "Actions row of the open-card panel. Default is the Delete button only. Override to add consumer-wired actions — e.g. an Edit button with action: EDIT_CARD and actionPayload: { id: @entity.currentId, row: @entity.currentRow }, listened to by the organism's edit modal. Never leave a button here without a listener." @tier "presentation"
    cardDescriptionBinding : string = "@item.description" @label "Card description binding" @description "Per-card binding for the description slot." @tier "presentation"
    cardIdBinding  : string = "@item.id" @label "Card id binding" @description "Per-card binding for the id used in action payloads." @tier "presentation"
    cardLook       : string = "elevated" @label "Card look" @description "Layer 2 visual treatment for cards rendered by this board." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    cardNotesBinding : string = "@item.notes" @label "Card notes binding" @description "Per-card binding for the notes slot shown in the card detail view. Set to an empty string for hosts with no notes-equivalent field — declared as 'no notes capture', never inferred." @tier "presentation"
    cardStageBinding : string = "@item.stage" @label "Card stage binding" @description "Per-card binding for the stage/status slot." @tier "presentation"
    cardTitleBinding : string = "@item.title" @label "Card title binding" @description "Per-card binding for the title slot." @tier "presentation"
    columns        : [ColumnSpec] = [{"icon":"circle","key":"todo","label":"To Do","variant":"default"},{"icon":"circle-dot","key":"doing","label":"In Progress","variant":"primary"},{"icon":"check-circle","key":"done","label":"Done","variant":"success"}] @label "Columns" @description "Board columns; each row's stage maps to a column key" @tier "domain"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the board?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the columns; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this board and routes its FILTER event to REFETCH_FILTER — that is the wired owner and remains the primary path. Use this knob only for a standalone board with no page-level filter affordance." @synonyms "filter bar, faceted filters, field filters, column filters, dropdowns" @tier "presentation"
    formFields     : [string] = ["title","description","stage","notes"] @label "New-card fields" @description "Fields shown in the add-card form" @tier "presentation"
    gridCols       : number = 3 @label "Grid columns" @description "Outer grid column count before the board wraps" @tier "presentation"
    groupByField   : string = "stage" @label "Group-by field" @description "Entity field whose value matches a column key — items are filtered into columns by it. Default 'stage'; set to 'status' (or any field) for entities that track state under a different name." @tier "presentation"
    kanbanClassicBodyContent : render-ui = {"children":[{"align":"center","children":[{"name":"kanban-square","size":"xl","type":"icon"},{"content":"@config.title","type":"typography","variant":"h2"}],"className":"px-card-md","direction":"horizontal","gap":"sm","type":"stack"},{"type":"divider"},["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"px-card-md","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BoardView","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"px-card-md","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"className":"w-full pb-2","dndRoot":true,"entity":"@entity.boards","fields":[],"gap":"lg","minCardWidth":300,"renderItem":["fn","col",{"children":[{"children":[{"align":"center","children":[{"name":"@col.icon","type":"icon"},{"className":"flex-1","content":"@col.label","type":"typography","variant":"h4"},{"label":"@col.count","size":"sm","type":"badge","variant":"primary"}],"className":"p-card-md border-b border-[var(--color-border)] sticky top-0 bg-[var(--color-surface)]","direction":"horizontal","gap":"sm","type":"stack"},{"accepts":"*","className":"p-card-md min-h-[120px]","dragGroup":"@col.key","dropEvent":"MOVE_CARD","entity":"@col.items","fields":[],"gap":"sm","positionEvent":"REORDER_POSITION","renderItem":["fn","item",{"children":[{"children":[{"content":"@config.cardTitleBinding","type":"typography","variant":"body","weight":"medium"},{"className":"line-clamp-2","color":"muted","content":"@config.cardDescriptionBinding","type":"typography","variant":"caption"},{"align":"center","children":[{"label":"@config.cardStageBinding","size":"sm","type":"badge","variant":"@col.variant"},{"action":"OPEN_CARD","actionPayload":{"description":"@config.cardDescriptionBinding","id":"@config.cardIdBinding","notes":"@config.cardNotesBinding","row":"@item","stage":"@config.cardStageBinding","title":"@config.cardTitleBinding"},"className":"ml-auto","icon":"arrow-right","label":"Open","size":"sm","type":"button","variant":"ghost"}],"className":"pt-1","direction":"horizontal","gap":"xs","type":"stack"}],"direction":"vertical","gap":"xs","type":"stack"}],"className":"cursor-grab hover:shadow-lg transition-shadow","look":"@config.cardLook","padding":"sm","type":"card"}],"reorderEvent":"REORDER_CARD","sortable":true,"type":"data-list"}],"direction":"vertical","gap":"none","type":"stack"}],"className":"w-[300px] bg-[var(--color-surface-subtle)] rounded-lg overflow-hidden","look":"elevated","padding":"none","type":"card"}],"scrollX":true,"type":"data-grid"},{"action":"ADD_CARD","icon":"plus","label":"Add card","type":"floating-action-button","variant":"primary"}],"className":"h-full","direction":"vertical","gap":"md","type":"stack"} @label "Kanban classic body content tree" @description "Render-ui SExpr for boardLook='kanban-classic' — Trello-style wide elevated columns with sticky headers, dense cards with a status badge; per-item cards honor config.cardLook (the column wrapper stays elevated — it is column chrome, not a card)." @tier "internal"
    pageSize       : number = 10 @label "Fetch page size" @description "Records fetched per REFETCH_PAGE request. std-board renders no pagination control itself — this only feeds the fetch limit/offset when a consumer wires a composed std-pagination to REFETCH_PAGE." @synonyms "fetch limit, records per page, batch size, page limit" @tier "presentation"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the board's embedded search box (e.g. 'Search cards…'). Only shown when bodySearch is true." @synonyms "search hint, placeholder, search box text, search label" @tier "presentation"
    title          : string = "Board" @label "Board title" @description "Heading shown above the column board" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-board.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-book-reader.orb orbitals[0].traits[0])
trait std-book-reader.traits.BookReaderRead {
  alias          : BookReader
  linkedEntity   : BookReaderView
  category       : interaction
  states         : (cover* reading)
  events         : (INIT START_READING OPEN_CHAPTER NEXT_CHAPTER PREV_CHAPTER BACK_TO_COVER CHAPTER_OPENED)
  transitions    : ((cover -> cover on INIT) (cover -> reading on START_READING) (cover -> reading on OPEN_CHAPTER) (reading -> cover on INIT) (reading -> reading on OPEN_CHAPTER) (reading -> reading on NEXT_CHAPTER) (reading -> reading on PREV_CHAPTER) (reading -> cover on BACK_TO_COVER))
  emits          : (CHAPTER_OPENED)
  config {
    author         : string = "" @label "Author" @tier "presentation"
    chapters       : [BookChapter] = [{"content":"The first chapter's text, in **markdown**.","title":"Chapter one"},{"content":"The second chapter's text.","title":"Chapter two"}] @label "Chapters" @description "Ordered chapters: a title and markdown content each" @synonyms "sections, parts, pages, table of contents" @tier "presentation"
    contentsLabel  : string = "Contents" @label "Contents heading" @tier "presentation"
    coverContent   : render-ui = {"children":[{"children":[{"children":[{"align":"center","children":[{"alt":"@config.title","bordered":true,"className":"max-w-xs","loading":"eager","rounded":"lg","src":"@config.coverImage","type":"image"},{"align":"center","className":"tracking-tight text-balance","content":"@config.title","type":"typography","variant":"h1","weight":"bold"},{"align":"center","className":["if",["==","@config.subtitle",""],"hidden","text-pretty"],"color":"muted","content":"@config.subtitle","type":"typography","variant":"large"},{"align":"center","className":["if",["==","@config.author",""],"hidden",""],"color":"muted","content":"@config.author","type":"typography","variant":"label"},{"action":"START_READING","className":["if",["==",["array/len","@config.chapters"],0],"hidden",""],"label":"@config.startLabel","size":"lg","type":"button","variant":"primary"}],"direction":"vertical","gap":"md","type":"stack"},{"children":[{"content":"@config.contentsLabel","type":"typography","variant":"label","weight":"semibold"},{"align":"start","children":["array/map","@config.chapters",["fn","chapter",{"action":"OPEN_CHAPTER","actionPayload":{"index":"@index"},"label":["str/concat",["+","@index",1],". ",["object/get","@chapter","title",""]],"type":"button","variant":"link"}]],"direction":"vertical","gap":"none","type":"stack"}],"className":["if",["==",["array/len","@config.chapters"],0],"hidden",""],"direction":"vertical","gap":"xs","type":"stack"}],"direction":"vertical","gap":"xl","type":"stack"}],"maxWidth":"md","padding":"lg","size":"md","type":"container"}],"dir":"@config.direction","fullWidth":true,"paddingY":"2xl","type":"box"} @label "Cover body" @tier "internal"
    coverImage     : string = "" @label "Cover image" @description "Cover image URL; empty hides it" @tier "presentation"
    coverLabel     : string = "Cover" @label "Back-to-cover label" @tier "presentation"
    direction      : string = "ltr" @label "Text direction" @description "rtl for Arabic, Hebrew and other right-to-left books" @synonyms "right to left, arabic book" @tier "presentation" @values (ltr rtl)
    nextLabel      : string = "Next" @label "Next button label" @tier "presentation"
    previousLabel  : string = "Previous" @label "Previous button label" @tier "presentation"
    readingContent : render-ui = {"children":[{"children":[{"children":[{"align":"start","children":[{"action":"BACK_TO_COVER","label":"@config.coverLabel","leftIcon":"book-open","type":"button","variant":"link"},{"className":"pt-2","content":"@config.contentsLabel","type":"typography","variant":"label","weight":"semibold"},{"align":"start","children":["array/map","@config.chapters",["fn","chapter",{"action":"OPEN_CHAPTER","actionPayload":{"index":"@index"},"className":["if",["==","@index","@entity.chapterIndex"],"text-foreground font-semibold",""],"label":["object/get","@chapter","title",""],"type":"button","variant":"link"}]],"direction":"vertical","gap":"none","type":"stack"}],"className":"lg:sticky lg:top-6 self-start","direction":"vertical","gap":"xs","type":"stack"},{"children":[{"color":"muted","content":"@entity.progressLabel","type":"typography","variant":"caption"},{"className":"tracking-tight","content":"@entity.chapterTitle","type":"typography","variant":"h2","weight":"bold"},{"content":"@entity.chapterContent","direction":"@config.direction","type":"markdown-content"},{"type":"divider"},{"children":[{"action":"PREV_CHAPTER","disabled":"@entity.isFirst","label":"@config.previousLabel","leftIcon":["if",["==","@config.direction","rtl"],"chevron-right","chevron-left"],"type":"button","variant":"secondary"},{"action":"NEXT_CHAPTER","disabled":"@entity.isLast","label":"@config.nextLabel","rightIcon":["if",["==","@config.direction","rtl"],"chevron-left","chevron-right"],"type":"button","variant":"primary"}],"direction":"horizontal","gap":"md","justify":"between","type":"stack"}],"direction":"vertical","gap":"lg","type":"stack"}],"gap":"xl","ratio":"1:3","type":"split"}],"maxWidth":"xl","padding":"lg","size":"xl","type":"container"}],"dir":"@config.direction","fullWidth":true,"paddingY":"xl","type":"box"} @label "Reading body" @tier "internal"
    startLabel     : string = "Start reading" @label "Start button label" @tier "presentation"
    subtitle       : string = "" @label "Subtitle" @tier "presentation"
    title          : string = "Untitled book" @label "Title" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-book-reader.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-browse.orb orbitals[0].traits[0])
trait std-browse.traits.BrowseItemBrowse {
  alias          : Browse
  linkedEntity   : BrowseItem
  category       : interaction
  states         : (loading* browsing error)
  events         : (INIT BrowseItemLoaded BrowseItemLoadFailed REFETCH_QUERY REFETCH_FILTER REFETCH_PAGE VIEW CLOSE EDIT DELETE)
  transitions    : ((loading -> loading on INIT) (loading -> browsing on BrowseItemLoaded) (loading -> error on BrowseItemLoadFailed) (browsing -> loading on INIT) (browsing -> browsing on REFETCH_QUERY) (browsing -> browsing on REFETCH_FILTER) (browsing -> browsing on REFETCH_PAGE) (browsing -> browsing on VIEW) (browsing -> browsing on CLOSE) (browsing -> browsing on BrowseItemLoaded) (browsing -> browsing on BrowseItemLoadFailed) (error -> loading on INIT))
  emits          : (BrowseItemLoaded BrowseItemLoadFailed VIEW EDIT DELETE)
  config {
    assigneeBinding : string = "@item.assignee" @label "Assignee field binding" @description "Binding path for the assignee/owner slot." @tier "internal"
    badgeBinding   : string = "@item.status" @label "Badge field binding" @description "Binding path for the status/badge slot." @tier "internal"
    bodyContent    : render-ui = {"children":[["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"cols":"@config.cols","entity":"@payload.data","fields":"@config.fields","gap":"@config.gap","imageField":"@config.imageField","itemActions":"@config.itemActions","maxInlineActions":"@config.maxInlineActions","pageSize":"@config.displayPageSize","type":"data-grid"}],"direction":"vertical","gap":"md","type":"stack"} @label "Body content tree" @description "Render-ui SExpr rendered after rows load when browseLook = table (the default). Toolbar (search when bodySearch, filter bar when filters is non-empty) above the canonical data-grid call. Until 2026-08-27 this was the only one of the six looks with no search affordance at all. See denseBodyContent/feedBodyContent/galleryBodyContent for the other browseLook bodies; any may be overridden directly while inheriting the same trait, state machine, emits, and listens. Inlined directly (not via a composed sibling trait) 2026-09-08 — a separately-listening DataGrid1 sibling fired unconditionally on every BrowseItemLoaded regardless of browseLook, racing the correct body for slot main (a listens guard can't gate this: both the Rust interpreter and the TS codegen path restrict a listens guard's context to @payload only, so a browseLook config check there always evaluates undefined)."
    bodySearch     : boolean = true @label "Show the list's own search box?" @description "The dense/feed/gallery looks embed their own search box above the rows. Set false when the page already provides a search affordance (a toolbar Search molecule), so the surface shows one search box instead of two." @synonyms "inline search, list search, built-in search, show search, duplicate search" @tier "presentation"
    browseLook     : string = "table" @label "Browse look" @description "Layer 2 visual treatment for the whole browse surface. table = the default data-grid (bodyContent); dense = spreadsheet-style table with toolbar search (denseBodyContent); feed = chronological card stream (feedBodyContent); gallery = image-first responsive card grid (galleryBodyContent); master-detail = record-work split view — dense list left, clicked record's detail right (masterDetailBodyContent); triage = inbox-register compact rows for queue work (triageBodyContent). Selecting a non-table look swaps which body tree renders after rows load; any body may still be overridden directly at the call site for a one-off layout." @tier "presentation" @values (table dense feed gallery master-detail triage)
    categoryBinding : string = "@item.category" @label "Category field binding" @description "Binding path for the category/tag slot." @tier "internal"
    cols           : number = 1 @label "How many columns in the grid?" @description "Number of columns in the responsive card/grid layout." @synonyms "columns, grid width, card columns, num columns" @tier "presentation"
    columns        : [ColumnSpec] = [{"align":"left","field":"name","header":"Name","key":"name","weight":"medium"},{"align":"left","field":"description","header":"Detail","key":"description"},{"align":"center","field":"status","format":"badge","header":"Status","key":"status"}] @label "Table columns" @description "Column definitions for table-style variants (dense). Each maps an entity field to a column with optional width / align / weight / format." @tier "presentation"
    denseBodyContent : render-ui = {"children":[["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"children":[{"columns":"@config.columns","emptyMessage":"No records","entity":"@payload.data","itemActions":"@config.itemActions","itemClickEvent":"@config.itemClickEvent","look":"dense","maxInlineActions":"@config.maxInlineActions","pageSize":"@config.displayPageSize","selectable":"@config.selectable","type":"table-view"}],"className":"overflow-x-auto","direction":"vertical","gap":"none","type":"stack"}],"className":"rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] shadow-sm overflow-hidden","direction":"vertical","gap":"none","type":"stack"} @label "Dense look body" @description "Render-ui SExpr rendered after rows load when browseLook = dense. Spreadsheet-style sticky-header data-table with a search bar; composes columns/itemActions/maxInlineActions/displayPageSize/searchPlaceholder. Folded from std-browse-dense (Phase 5.B). Inlined directly (not via a composed sibling trait) 2026-09-08 — see the table-default body's note for why." @tier "internal"
    descriptionBinding : string = "@item.description" @label "Description field binding" @description "Binding path for the card body/subtitle slot." @tier "internal"
    detailActions  : [BrowseDetailAction] = [{"event":"CLOSE","label":"Close"}] @label "Master-detail record pane actions" @description "Action buttons on the master-detail record pane (detail-panel `actions` descriptors: label/event/icon/variant). Consumers add their own record actions (Edit/Delete/…) alongside or instead of Close." @synonyms "record actions, detail actions, pane actions" @tier "presentation"
    detailFields   : [string] = ["name","description","status","createdAt"] @label "Which fields appear in the master-detail record pane?" @description "Field names shown in the detail panel when browseLook = master-detail; the first entry doubles as the pane title. Consumers overriding columns/fields should override this list to match their entity." @synonyms "detail columns, record fields, detail pane fields" @tier "presentation"
    displayPageSize : number = 10 @label "How many rows to show at once?" @description "Rows visible per page before the pagination control appears." @synonyms "visible rows, items per page, display limit, show per page" @tier "presentation"
    feedBodyContent : render-ui = {"children":[["if","@config.bodySearch",{"align":"center","children":[{"className":"w-full","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"w-full","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"w-full","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"entity":"@payload.data","fields":[],"gap":"md","itemActions":"@config.itemActions","renderItem":["fn","item",{"children":[{"align":"start","children":[{"className":"rounded-full flex-shrink-0","fallback":"@config.titleBinding","size":"md","type":"avatar"},{"children":[{"align":"center","children":[{"className":"truncate","content":"@config.titleBinding","type":"typography","variant":"body","weight":"medium"},{"label":"@config.categoryBinding","size":"sm","type":"badge","variant":"neutral"}],"className":"flex-wrap","direction":"horizontal","gap":"xs","type":"stack"},{"className":"text-[var(--color-foreground)] whitespace-pre-wrap break-words leading-relaxed","content":"@config.descriptionBinding","type":"typography","variant":"body"},{"align":"center","children":[{"color":"muted","content":"@config.metaBinding","format":"@config.metaFormat","type":"typography","variant":"caption"},{"label":"@config.badgeBinding","size":"sm","type":"badge","variant":"default"}],"className":"pt-1","direction":"horizontal","gap":"sm","justify":"between","type":"stack"}],"className":"flex-1 min-w-0","direction":"vertical","gap":"xs","type":"stack"}],"className":"p-card-md","direction":"horizontal","gap":"md","type":"stack"}],"className":"rounded-lg bg-[var(--color-card)] border border-[var(--color-border)] shadow-sm transition-all duration-normal hover:shadow-main hover:border-[var(--color-border-strong)] hover:-translate-y-px","look":"flat-bordered","padding":"none","type":"card"}],"type":"data-list","variant":"card"}],"className":"w-full","direction":"vertical","gap":"lg","type":"stack"} @label "Feed look body" @description "Render-ui SExpr rendered after rows load when browseLook = feed. Chronological card-per-item stream with avatar, title, meta, body, timestamp; composes titleBinding/descriptionBinding/categoryBinding/badgeBinding/metaBinding/searchPlaceholder/itemActions. Folded from std-browse-feed (Phase 5.B)." @tier "internal"
    fields         : [FieldSpec] = [{"label":"Name","name":"name","variant":"h4"},{"label":"Description","name":"description","variant":"caption"},{"label":"Status","name":"status","variant":"badge"}] @label "Which fields should appear as columns?" @description "Each entry maps one entity field to a display column with an optional label and variant." @synonyms "visible columns, displayed fields, card fields, column list" @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the list?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the rows; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this list and routes `XFilter.FILTER -> REFETCH_FILTER` — that is the wired owner and remains the primary path. Use this knob only for a standalone list with no page-level filter affordance, so the surface shows one filter bar instead of two." @synonyms "filter bar, faceted filters, field filters, column filters, dropdowns" @tier "presentation"
    galleryBodyContent : render-ui = {"children":[["if","@config.bodySearch",{"align":"center","children":[{"className":"w-full","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"sticky top-0 z-10 py-3 bg-[var(--color-surface)]/95 backdrop-blur","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"w-full","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"className":"w-full","entity":"@payload.data","fields":"@config.fields","gap":"lg","imageField":"@config.imageField","itemActions":"@config.itemActions","maxInlineActions":"@config.maxInlineActions","minCardWidth":260,"type":"data-grid"}],"className":"w-full","direction":"vertical","gap":"lg","type":"stack"} @label "Gallery look body" @description "Render-ui SExpr rendered after rows load when browseLook = gallery. Image-first responsive card grid (auto-fit minCardWidth) on the data-grid fields path: imageField renders the card photo when set (falsy-safe when empty), fields drive title/badges/meta. One tree, no renderItem lambda — lambdas do not survive inside (if) arms (2026-07-27)." @tier "internal"
    gap            : string = "md" @label "Spacing between rows" @description "Gap between grid cells: sm, md, or lg." @synonyms "row gap, cell spacing, grid gap, padding between items" @tier "presentation"
    imageField     : string = "" @label "Which field holds the row image?" @description "Entity field containing the thumbnail URL for each row." @synonyms "image field, thumbnail field, photo field, picture column" @tier "presentation"
    imageLabelBinding : string = "@item.thumbnailLabel" @label "Image label binding" @description "Binding path for the image-area label slot." @tier "internal"
    include        : [string] = [] @label "Which relation fields to hydrate?" @description "Entity relation field names to hydrate on fetch (e.g. a `tag : Category` field named `tag`), so grid columns can use dot-paths like tag.name. Empty = no hydration, the default." @synonyms "relation hydration, populate relations, joined fields, hydrate relations" @tier "internal"
    initialFilterField : string = "" @label "Which field does the first load filter on?" @description "Name the field the INITIAL load filters on, paired with initialFilterValue. This is the detail half of a list-detail pair: a thread that must wait for a conversation to be picked sets the field to its parent key and leaves the value blank, so the first load matches nothing and the empty state shows instead of every record in the table. REFETCH_FILTER then supplies the real selection. Left blank the first load is unfiltered, which is the default." @synonyms "initial filter, first load filter, wait for selection, detail pane filter, requires selection, start empty" @tier "policy"
    initialFilterValue : string = "" @label "What value does the first load filter for?" @description "The value initialFilterField must equal on the first load. Blank is meaningful: it matches only records whose field is itself blank, which for a detail pane is normally none — that is how a thread stays empty until its parent is selected." @synonyms "initial filter value, first load value, default selection" @tier "policy"
    itemActions    : [ItemAction] = [] @label "What actions can users take on each row?" @description "Buttons rendered on each row (e.g. Edit, Delete, View)." @synonyms "row buttons, row actions, item actions, per-row buttons, table actions" @tier "presentation"
    itemClickEvent : event = "VIEW" @label "Which event does clicking a row fire?" @description "Row-click channel. Retarget when two browse lists coexist in one orbital and their VIEW payloads differ, so each gets its own typed channel." @synonyms "row click event, item click, open event, select event" @tier "presentation"
    masterDetailBodyContent : render-ui = {"children":[["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"detail":{"children":[],"gap":"none","type":"stack"},"emptyDetail":{"description":"Select a record from the list to see its details.","icon":"mouse-pointer-click","title":"Nothing selected","type":"empty-state"},"hasSelection":false,"master":{"children":["@trait.MasterListView"],"className":"overflow-y-auto","direction":"vertical","gap":"none","type":"stack"},"type":"master-detail-layout"}],"className":"rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] shadow-sm overflow-hidden","direction":"vertical","gap":"none","type":"stack"} @label "Master-detail look body (no selection)" @description "Render-ui SExpr rendered after rows load when browseLook = master-detail: record-work split view — toolbar, dense list left, empty-state pane right until a row is opened. Opening a row renders masterDetailRecordBodyContent. The toolbar honours bodySearch and filters like every other look; it used to render its search box unconditionally, which put a second search box on any page that already composed std-search (observed in std-crm ContactOrbital)." @tier "internal"
    masterDetailRecordBodyContent : render-ui = {"children":[["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"detail":{"actions":"@config.detailActions","fieldNames":"@config.detailFields","initialData":"@payload.row","showActions":true,"type":"detail-panel"},"hasSelection":true,"master":{"children":["@trait.MasterListView"],"className":"overflow-y-auto","direction":"vertical","gap":"none","type":"stack"},"type":"master-detail-layout"}],"className":"rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] shadow-sm overflow-hidden","direction":"vertical","gap":"none","type":"stack"} @label "Master-detail look body (record open)" @description "Render-ui SExpr rendered by the VIEW transition when browseLook = master-detail: the same split view with the clicked record's detail panel on the right, fed by the VIEW payload row and detailFields." @tier "internal"
    maxInlineActions : number = 3 @label "How many row actions to show before collapsing?" @description "Actions beyond this count collapse into a '⋯' overflow menu. Set 2–3 for dense tables." @synonyms "inline actions limit, overflow threshold, max buttons per row" @tier "presentation"
    metaBinding    : string = "@item.createdAt" @label "Meta field binding" @description "Binding path for the secondary meta slot (timestamp / category). Hosts binding a count or other non-date value should label it in the binding itself (e.g. (str/concat \"Vehicles: \" @item.vehicleCount)) and set metaFormat: none." @tier "internal"
    metaFormat     : string = "date" @label "Meta value format" @description "Typography format for the feed meta slot — date by default so the createdAt binding renders human-readable instead of raw ISO; set none for non-date bindings." @tier "presentation" @values (none date time datetime number)
    pageSize       : number = 10 @label "How many rows to fetch per page?" @description "Records fetched from the server per page request." @synonyms "fetch limit, records per page, batch size, page limit" @tier "presentation"
    priceBinding   : string = "@item.price" @label "Price field binding" @description "Binding path for the price/amount overlay slot." @tier "internal"
    priorityBinding : string = "@item.priority" @label "Priority field binding" @description "Binding path for the priority slot." @tier "internal"
    scopeField     : string = "" @label "Only show records owned by the signed-in user?" @description "Name the field on this entity that holds the viewer's id (e.g. memberId, patientId, assignee). When set, the list loads ONLY rows whose that field equals @user.id — the 'my bookings' / 'my appointments' shape. Left blank the list loads every row, which is the default. Declared, never inferred: guessing the column from its name would silently scope the wrong one." @synonyms "owner field, my records, only mine, only my own, scope to user, per-user list, mine only, owned by me" @tier "policy"
    searchField    : string = "name" @label "Which column does the search box match against?" @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `name` column must set this to a real field (e.g. title, content) or the search box can never match a row." @synonyms "search column, search on field, match field, search key" @tier "policy"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the list search box (e.g. 'Search orders…')." @synonyms "search hint, placeholder, search box text, search label" @tier "presentation"
    selectable     : boolean = false @label "Show row selection checkboxes?" @description "Adds a checkbox column with select-all to the dense table. Enable only when the surface offers bulk actions — checkboxes with nothing to act on are a dead affordance." @synonyms "row checkboxes, multi-select, bulk select, selection column" @tier "presentation"
    titleBinding   : string = "@item.name" @label "Title field binding" @description "Binding path for the card title slot (e.g. @item.dishName)." @tier "internal"
    triageBodyContent : render-ui = {"children":[["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"BrowseItem","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"className":"px-card-md py-card-sm border-b border-[var(--color-border)]","direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"children":[{"entity":"@payload.data","fields":"@config.fields","itemActions":"@config.itemActions","maxInlineActions":"@config.maxInlineActions","type":"data-list","variant":"compact"}],"className":"overflow-x-auto","direction":"vertical","gap":"none","type":"stack"}],"className":"rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] shadow-sm overflow-hidden","direction":"vertical","gap":"none","type":"stack"} @label "Triage look body" @description "Render-ui SExpr rendered after rows load when browseLook = triage. Inbox-register queue: one surface with a toolbar search and compact list rows (title + badges + inline meta) built for keyboard-pace queue work; row actions collapse per maxInlineActions. Composes fields/itemActions/searchPlaceholder/bodySearch." @tier "internal"
    viewPattern    : pattern = "data-grid" @label "Render pattern" @description "UI pattern used to render the collection. Used by the default bodyContent tree; Layer 3 variants override bodyContent directly instead and may ignore this knob." @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-browse.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-cache-aside.orb orbitals[0].traits[0])
trait std-cache-aside.traits.CacheEntryCacheManager {
  alias          : CacheAside
  linkedEntity   : CacheEntry
  category       : interaction
  states         : (empty* loading cached stale error)
  events         : (INIT FETCH CacheEntryLoaded CacheEntryLoadFailed CacheEntryUpdateFailed CacheEntryUpdated INVALIDATE CACHED REFRESH)
  transitions    : ((empty -> empty on INIT) (empty -> loading on FETCH) (loading -> cached on CacheEntryLoaded) (loading -> error on CacheEntryLoadFailed) (loading -> loading on CacheEntryUpdateFailed) (loading -> loading on CacheEntryUpdated) (cached -> stale on INVALIDATE) (cached -> loading on CACHED) (stale -> loading on REFRESH) (stale -> loading on FETCH) (error -> empty on INIT) (error -> loading on FETCH))
  emits          : (CacheEntryLoaded CacheEntryLoadFailed CacheEntryUpdated CacheEntryUpdateFailed)
  config {
    emptyLook      : string = "icon-only" @label "Empty-state look" @description "Layer 2 visual treatment for the empty-state placeholder." @tier "presentation" @values (illustrated icon-only text-only mascot)
    evictionPolicy : string = "lru" @label "Eviction policy" @description "How entries are evicted when the cache fills: least-recently-used, least-frequently-used, first-in-first-out, or TTL-only (never evict early)." @synonyms "cache replacement, eviction strategy" @tier "domain" @values (lru lfu fifo ttl-only)
    maxCacheSize   : number = 1000 @label "Max cache entries" @description "Hard cap on cached entries before eviction. 0 = unlimited." @synonyms "cache capacity, max entries" @tier "domain"
    staleWhileRevalidate : boolean = true @label "Serve stale while revalidating" @description "When true, serve stale entries to consumers while a background refresh fetches fresh data. Reduces latency at the cost of brief staleness." @synonyms "SWR, stale serving" @tier "domain"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    ttlSeconds     : number = 300 @label "TTL (seconds)" @description "Cache entry time-to-live before it goes stale. Default 5 minutes. Shorter = fresher/real-time data; longer = stable/long-lived caching." @synonyms "expiration, time to live, cache duration, freshness, real-time (short) vs long-lived (long)" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-cache-aside.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-calendar.orb orbitals[0].traits[0])
trait std-calendar.traits.CalendarEventCalendar {
  alias          : Calendar
  linkedEntity   : CalendarEvent
  category       : interaction
  states         : (loading* month-view error)
  events         : (INIT CalendarEventLoaded CalendarEventLoadFailed SELECT_DAY CALENDAR_PREV_WEEK CALENDAR_NEXT_WEEK REFETCH_QUERY REFETCH_FILTER RETRY @config.onEventClick SELECT_SLOT)
  transitions    : ((loading -> loading on INIT) (loading -> month-view on CalendarEventLoaded) (loading -> error on CalendarEventLoadFailed) (month-view -> loading on INIT) (month-view -> loading on SELECT_DAY) (month-view -> loading on CALENDAR_PREV_WEEK) (month-view -> loading on CALENDAR_NEXT_WEEK) (month-view -> loading on REFETCH_QUERY) (month-view -> loading on REFETCH_FILTER) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (CalendarEventLoaded CalendarEventLoadFailed @config.onEventClick)
  config {
    agendaGroupBy  : string = "date" @label "Agenda group-by field" @description "Row field the agenda list groups its day sections by. Rebound hosts point this at their own timestamp column (e.g. startTime, scheduledAt)." @synonyms "group field, section field, day field" @tier "presentation"
    agendaItemActions : [ItemAction] = [] @label "Agenda item actions" @description "Per-item action buttons on agenda-list rows — data-list itemActions descriptors (label/event/icon/variant). Consumers override to wire their own row actions (View/Edit/Delete) so agenda hosts never need a second table for actions." @synonyms "agenda actions, row actions, event actions, list actions" @tier "presentation"
    agendaListBodyContent : render-ui = {"children":[{"align":"center","children":[{"align":"center","children":[{"name":"list","size":"xl","type":"icon"},{"content":"Agenda","type":"typography","variant":"h2"}],"direction":"horizontal","gap":"sm","type":"stack"},{"onSelect":"SELECT_DAY","selected":"@entity.selectedRange","type":"date-range-selector"}],"direction":"horizontal","gap":"md","justify":"between","type":"stack"},["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"CalendarEvent","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"type":"divider"},{"entity":"@payload.data","fields":[],"gap":"md","groupBy":"@config.agendaGroupBy","itemActions":"@config.agendaItemActions","renderItem":["fn","item",{"children":[{"align":"start","children":[{"align":"center","children":[{"color":"muted","content":"@config.timeBinding","format":"time","type":"typography","variant":"overline"},{"color":"muted","name":"clock","size":"sm","type":"icon"}],"className":"w-16 shrink-0","direction":"vertical","gap":"xs","type":"stack"},{"orientation":"vertical","type":"divider"},{"children":[{"align":"center","children":[{"className":"truncate","content":"@config.titleBinding","type":"typography","variant":"h4","weight":"medium"},{"label":"@config.badgeBinding","size":"sm","type":"badge","variant":"default"}],"direction":"horizontal","gap":"sm","justify":"between","type":"stack"},{"className":"truncate","color":"muted","content":"@config.descriptionBinding","type":"typography","variant":"body2"}],"className":"flex-1 min-w-0","direction":"vertical","gap":"xs","type":"stack"}],"direction":"horizontal","gap":"md","type":"stack"}],"look":"flat-bordered","padding":"md","type":"card"}],"type":"data-list","variant":"default"}],"className":"w-full p-card-md","direction":"vertical","gap":"lg","type":"stack"} @label "Agenda list body content tree" @description "Render-ui SExpr for calendarLook='agenda-list' — events grouped by day with overline day headers (Today, Tomorrow, …) and a time marker per event." @tier "internal"
    badgeBinding   : string = "@item.status" @label "Badge binding" @description "Per-row binding for the event status/badge slot." @tier "presentation"
    bodyContent    : render-ui = {"children":[{"align":"center","children":[{"align":"center","children":[{"name":"calendar","size":"xl","type":"icon"},{"content":"@config.title","type":"typography","variant":"h2"}],"direction":"horizontal","gap":"sm","type":"stack"},{"onSelect":"SELECT_DAY","selected":"@entity.selectedRange","type":"date-range-selector"}],"direction":"horizontal","gap":"md","justify":"between","type":"stack"},["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"CalendarEvent","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"type":"divider"},{"events":"@payload.data","onEventClick":"@config.onEventClick","renderItem":["fn","item",{"content":"@config.titleBinding","type":"typography","variant":"small"}],"startField":"@config.startField","type":"calendar-grid"},{"type":"divider"},{"content":"Upcoming Events","type":"typography","variant":"h4"},{"entity":"@payload.data","fields":"@config.fields","itemActions":"@config.agendaItemActions","look":"@config.tableLook","type":"data-list"}],"direction":"vertical","gap":"lg","type":"stack"} @label "Body content tree" @description "Render-ui SExpr rendered after events load for calendarLook='month' — the month-grid + upcoming-events list. calendarLook='agenda-list' / 'week-timeline' render agendaListBodyContent / weekTimelineBodyContent instead; all three share this trait's state machine, emits, and listens." @tier "internal"
    bodySearch     : boolean = false @label "Show the calendar's own search box?" @description "Embeds a title search box in the toolbar above the calendar body (all three calendarLook trees). Defaults false: std-calendar has never had a search box, so an untouched consumer's surface is unchanged; the primary path is composing std-search beside this atom and wiring XSearch.SEARCH -> REFETCH_QUERY. Set true only for a standalone calendar with no page-level search affordance." @synonyms "inline search, calendar search, built-in search, show search, duplicate search" @tier "presentation"
    calendarLook   : string = "month" @label "Calendar look" @description "Layer 3 body layout: default month-grid + upcoming-events list ('month'), day-grouped agenda list ('agenda-list'), or 7-column week timeline ('week-timeline')." @tier "presentation" @values (month agenda-list week-timeline)
    descriptionBinding : string = "@item.description" @label "Description binding" @description "Per-row binding for the event description slot." @tier "presentation"
    fields         : [FieldSpec] = [{"icon":"calendar","label":"Event","name":"name","variant":"h4"},{"label":"Time","name":"time","variant":"badge"},{"format":"date","label":"Date","name":"date","variant":"caption"},{"label":"Status","name":"status","variant":"badge"}] @label "Upcoming-events columns" @description "Row field descriptors for the 'Upcoming Events' data-list under calendarLook='month'. Rebound hosts must override this — it is a literal entity[field.name] lookup, unlike titleBinding/timeBinding/descriptionBinding (expression bindings), so it does not follow a rebind automatically." @synonyms "upcoming events columns, month view fields, event list columns" @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the calendar?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the calendar body (all three calendarLook trees); each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this calendar and routes XFilter.FILTER -> REFETCH_FILTER — that is the wired owner and remains the primary path. Use this knob only for a standalone calendar with no page-level filter affordance." @synonyms "filter bar, faceted filters, field filters, dropdowns" @tier "presentation"
    include        : [string] = [] @label "Which relation fields to hydrate?" @description "Entity relation field names to hydrate on fetch (e.g. a `category : Category` field named `category`), so chip bindings can use dot-paths like @item.category.name. Empty = no hydration, the default." @synonyms "relation hydration, populate relations, joined fields, hydrate relations" @tier "internal"
    onEventClick   : event = "" @label "On Event Click" @description "Event emitted when a calendar chip is clicked: UI:{onEventClick} with { event } carrying the clicked row. Empty means chips are not clickable." @synonyms "open event, event click, select event, chip click" @tier "presentation"
    searchField    : string = "name" @label "Which column does the search box match against?" @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `name` column must set this to a real field (e.g. title, description) or the search box can never match a row." @synonyms "search column, search on field, match field, search key" @tier "policy"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the calendar's search box (e.g. 'Search events…')." @synonyms "search hint, placeholder, search box text, search label" @tier "presentation"
    startField     : string = "date" @label "Start field" @description "Row column holding the timestamp the calendar grid places each chip by. Rebound hosts point this at their own column (e.g. startTime, startsAt, dueAt); the chip's LABEL comes from titleBinding, not from here." @synonyms "start column, date column, when field, timestamp field" @tier "presentation"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    timeBinding    : string = "@item.time" @label "Time binding" @description "Per-row binding for the event time slot." @tier "presentation"
    title          : string = "Calendar" @label "Title" @description "Header text shown above the calendar body." @tier "presentation"
    titleBinding   : string = "@item.name" @label "Title binding" @description "Per-row binding for the event title slot." @tier "presentation"
    weekTimelineBodyContent : render-ui = {"children":[{"align":"center","children":[{"align":"center","children":[{"name":"calendar","size":"xl","type":"icon"},{"content":"Week","type":"typography","variant":"h2"}],"direction":"horizontal","gap":"sm","type":"stack"},{"align":"center","children":[{"action":"CALENDAR_PREV_WEEK","icon":"chevron-left","label":"Previous week","type":"button","variant":"ghost"},{"color":"muted","content":["time/format","@entity.weekAnchor","MMM D, YYYY"],"type":"typography","variant":"caption"},{"action":"CALENDAR_NEXT_WEEK","icon":"chevron-right","label":"Next week","type":"button","variant":"ghost"}],"direction":"horizontal","gap":"xs","type":"stack"},{"onSelect":"SELECT_DAY","selected":"@entity.selectedRange","type":"date-range-selector"}],"direction":"horizontal","gap":"md","justify":"between","type":"stack"},["if","@config.bodySearch",{"children":[{"className":"w-full max-w-md","clearable":true,"event":"REFETCH_QUERY","placeholder":"@config.searchPlaceholder","type":"search-input"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],["if",[">",["array/len","@config.filters"],0],{"children":[{"entity":"CalendarEvent","event":"REFETCH_FILTER","filters":"@config.filters","look":"@config.filterBarLook","type":"filter-group"}],"direction":"horizontal","gap":"sm","type":"stack"},{"children":[],"gap":"none","type":"stack"}],{"type":"divider"},{"className":"w-full","dayWindow":7,"events":"@payload.data","onEventClick":"@config.onEventClick","renderItem":["fn","item",{"content":"@config.titleBinding","type":"typography","variant":"small"}],"startField":"@config.startField","swipeLeftEvent":"CALENDAR_NEXT_WEEK","swipeRightEvent":"CALENDAR_PREV_WEEK","type":"calendar-grid","weekStart":"@entity.weekAnchor"}],"direction":"vertical","gap":"md","type":"stack"} @label "Week timeline body content tree" @description "Render-ui SExpr for calendarLook='week-timeline' — events grouped by weekday in a 7-column timeline window." @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-calendar.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-calendar-sync.orb orbitals[0].traits[0])
trait std-calendar-sync.traits.CalendarSync {
  alias          : CalendarSync
  linkedEntity   : CalendarSyncRun
  category       : lifecycle
  states         : (idle* pushing pulling)
  events         : (INIT SYNC_NOW CAL_REMOTE_CHANGED PUSH_ROWS_LOADED CAL_REMOTE_LISTED CAL_SYNC_FAILED CAL_EVENT_CREATED PUSH_STEPPED PULL_TARGET_LOADED PULL_STEPPED PULL_NEXT CAL_SYNCED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on SYNC_NOW) (idle -> idle on CAL_REMOTE_CHANGED) (idle -> pushing on PUSH_ROWS_LOADED) (idle -> idle on PUSH_ROWS_LOADED) (idle -> pulling on CAL_REMOTE_LISTED) (idle -> idle on CAL_REMOTE_LISTED) (idle -> idle on CAL_SYNC_FAILED) (pushing -> pushing on CAL_EVENT_CREATED) (pushing -> pushing on PUSH_STEPPED) (pushing -> pushing on PUSH_ROWS_LOADED) (pushing -> idle on PUSH_ROWS_LOADED) (pushing -> idle on CAL_SYNC_FAILED) (pulling -> pulling on PULL_TARGET_LOADED) (pulling -> pulling on PULL_STEPPED) (pulling -> pulling on PULL_NEXT) (pulling -> idle on PULL_NEXT) (pulling -> idle on CAL_SYNC_FAILED))
  emits          : (CAL_SYNCED CAL_SYNC_FAILED PUSH_ROWS_LOADED CAL_EVENT_CREATED PUSH_STEPPED CAL_REMOTE_LISTED PULL_TARGET_LOADED PULL_STEPPED PULL_NEXT)
  config {
    calendarId     : string = "" @label "Calendar id" @description "Google calendar to sync with; blank = the service's default (GOOGLE_CALENDAR_ID env, else primary)." @synonyms "google calendar id, target calendar" @tier "infra"
    descriptionField : string = "" @label "Description field" @description "Target-entity field holding the description/notes; blank = none." @synonyms "notes field, details field" @tier "internal"
    durationField  : string = "" @label "Duration field" @description "Target-entity field holding the per-row duration in minutes (e.g. ClassSession.durationMinutes). Takes precedence over the fixed `durationMinutes` when set; ignored when `endField` is set. Field precedence: endField > durationField > durationMinutes — the corpus carries all these event shapes." @synonyms "minutes field, length field, per-row duration" @tier "internal"
    durationMinutes : number = 60 @label "Duration (minutes)" @description "Fixed event length used when both `endField` and `durationField` are blank; the calendar service computes the timezone-correct end." @synonyms "length, event duration, minutes" @tier "internal"
    enabled        : boolean = false @label "Sync with Google Calendar" @description "Push local records to Google Calendar and pull remote events into the CalendarEvent store. Off by default; needs the calendar service credentials (GOOGLE_CALENDAR_SA_KEY)." @synonyms "enable, calendar sync, google calendar, two-way sync, sync events, connect calendar" @tier "infra"
    endField       : string = "endsAt" @label "End field" @description "Target-entity field holding the ISO end. Blank = derive the end from `durationMinutes` instead (the corpus carries all four event shapes)." @synonyms "end date field, finishes field" @tier "internal"
    locationField  : string = "" @label "Location field" @description "Target-entity field holding the location; blank = none." @synonyms "place field, venue field" @tier "internal"
    startField     : string = "startsAt" @label "Start field" @description "Target-entity field holding the ISO start (dateTime, or YYYY-MM-DD for all-day)." @synonyms "start date field, begins field, scheduledAt field" @tier "internal"
    targetEntity   : entity = "CalendarEvent" @label "Entity to push" @description "Event-shaped entity whose rows export to Google Calendar. MUST declare the marker columns `externalEventId : string = \"\"` and `syncedAt : number = 0` (stamped by the push loop). Defaults to the atom's own CalendarEvent store so the standalone validates; rebind per composition." @synonyms "entity to sync, source entity, record type, appointments entity, sessions entity" @tier "internal"
    titleField     : string = "title" @label "Title field" @description "Target-entity field holding the event title." @synonyms "summary field, name field" @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-calendar-sync.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-camera-rig.orb orbitals[0].traits[0])
trait std-camera-rig.traits.CameraRig {
  alias          : CameraRig
  linkedEntity   : CameraState
  category       : lifecycle
  states         : (active*)
  events         : (INIT FOLLOW CUT SET_ZOOM SHAKE RESTART CAMERA_MOVED)
  transitions    : ((active -> active on INIT) (active -> active on FOLLOW) (active -> active on CUT) (active -> active on SET_ZOOM) (active -> active on SHAKE) (active -> active on RESTART))
  emits          : (CAMERA_MOVED)
  config {
    bounds         : CameraBounds = {"xMax":1000000,"xMin":-1000000,"yMax":1000000,"yMin":-1000000} @label "Bounds" @description "World-space clamp applied to the eased camera position every tick" @tier "presentation"
    deadzoneX      : number = 0 @label "Dead Zone X" @description "Horizontal distance from target the camera tolerates without easing" @tier "presentation"
    deadzoneY      : number = 0 @label "Dead Zone Y" @description "Vertical distance from target the camera tolerates without easing" @tier "presentation"
    lead           : number = 0 @label "Lead" @description "Horizontal look-ahead multiplier applied to FOLLOW's vx" @tier "presentation"
    maxZoom        : number = 3 @label "Max Zoom" @description "Upper clamp for SET_ZOOM and the eased zoom" @tier "presentation"
    minZoom        : number = 0.5 @label "Min Zoom" @description "Lower clamp for SET_ZOOM and the eased zoom" @tier "presentation"
    running        : boolean = true @label "Running" @description "When true the 33ms camera tick eases toward target; toggle to freeze the camera" @tier "domain"
    shakeDecay     : number = 0.1 @label "Shake Decay" @description "Amount camShake reduces toward 0 every tick" @tier "presentation"
    start          : CameraPos = {"x":0,"y":0} @label "Start Position" @description "Initial and RESTART camera position/target" @tier "domain"
    stiffness      : number = 0.1 @label "Stiffness" @description "Per-tick lerp factor easing position/zoom toward target (0-1, higher = snappier)" @tier "presentation"
    zoom           : number = 1 @label "Zoom" @description "Initial and RESTART zoom level" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-camera-rig.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-card-grid.orb orbitals[0].traits[0])
trait std-card-grid.traits.CardGridRender {
  alias          : CardGrid
  linkedEntity   : CardGridView
  category       : interaction
  states         : (idle*)
  events         : (INIT CARD_OPEN CARD_OPENED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on CARD_OPEN))
  emits          : (CARD_OPENED)
  config {
    alignment      : string = "center" @label "Heading alignment" @tier "presentation" @values (center start)
    columns        : number = 3 @label "Max columns" @tier "presentation"
    heading        : string = "" @label "Heading" @description "Section heading above the grid; empty hides it" @synonyms "title" @tier "presentation"
    items          : [CardItem] = [{"description":"What this card is about.","title":"First card"},{"description":"What this card is about.","title":"Second card"},{"description":"What this card is about.","title":"Third card"}] @label "Cards" @description "One card per entry: title plus any of image, avatar, icon, badge, meta, description, href + linkLabel" @synonyms "items, entries, showcase, portfolio, team members, case studies, services, testimonials" @tier "presentation"
    lede           : string = "" @label "Supporting text" @description "Text under the heading; empty hides it" @tier "presentation"
    look           : string = "plain" @label "Card look" @description "media = image-led cards, profile = centered portrait cards, plain = text cards" @tier "presentation" @values (media profile plain)
    surface        : string = "plain" @label "Surface" @description "Background behind the section" @tier "presentation" @values (plain muted)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-card-grid.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-cascade-on-delete.orb orbitals[0].traits[0])
trait std-cascade-on-delete.traits.CascadeOnDeleteGate {
  alias          : CascadeOnDelete
  linkedEntity   : CascadeLog
  category       : lifecycle
  states         : (idle* scanning)
  events         : (INIT ParentDeleted DepsLoaded CascadeStepped CascadeFailed CascadeRowDeleted CascadeCompleted)
  transitions    : ((idle -> idle on INIT) (idle -> scanning on ParentDeleted) (scanning -> scanning on DepsLoaded) (scanning -> idle on DepsLoaded) (scanning -> scanning on CascadeStepped) (scanning -> idle on CascadeFailed))
  emits          : (CascadeRowDeleted CascadeCompleted DepsLoaded CascadeStepped CascadeFailed)
  config {
    dependentEntity : entity = "CascadeLog" @label "Dependent entity" @description "Entity holding rows that point at the parent (compose one cascade trait per dependent type). Defaults to the atom's own log so the standalone validates; rebind per composition." @tier "internal"
    enabled        : boolean = false @label "Delete related records too" @description "When a record is deleted, also delete the records that belong to it. Off by default." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, cascade delete, delete children, on delete cascade, cascade on delete, remove related, soft delete cascade, dependent deletes, integrity cascade" @tier "infra"
    foreignKeyField : string = "parentId" @label "Foreign-key field" @description "Field on dependent rows that holds the parent's id." @tier "internal"
    parentEntity   : entity = "" @label "Parent entity" @description "Entity whose deletion triggers the cascade." @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-cascade-on-delete.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-chase-ai.orb orbitals[0].traits[0])
trait std-chase-ai.traits.ChaseAi {
  alias          : ChaseAi
  linkedEntity   : ChaseState
  category       : lifecycle
  states         : (active*)
  events         : (INIT BURST UNITS_CHANGED)
  transitions    : ((active -> active on INIT))
  emits          : (BURST UNITS_CHANGED)
  config {
    gridHeight     : number = 12 @label "Grid Height" @description "Grid row count clamping enemy movement bounds" @tier "presentation"
    gridWidth      : number = 12 @label "Grid Width" @description "Grid column count clamping enemy movement bounds" @tier "presentation"
    running        : boolean = true @label "Running" @description "When true the chase tick runs; toggle to freeze the mechanic" @tier "domain"
    tiles          : [Tile] = [] @label "Initial Tiles" @description "Seed grid tiles used for passability checks during movement" @tier "presentation"
    units          : [Unit] = [] @label "Initial Units" @description "Seed units (players and enemies) present before the first tick" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-chase-ai.orb orbitals[0].traits[0])"
