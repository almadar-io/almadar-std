;; From @almadar/std (behaviors/registry/ui/core/atoms/std-graphs.orb orbitals[0].traits[0])
trait std-graphs.traits.GraphItemGraph {
  alias          : Graphs
  linkedEntity   : GraphItem
  category       : interaction
  states         : (idle*)
  events         : (INIT ITEMS_LOADED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ITEMS_LOADED))
  config {
    aggregation    : string = "count" @label "Aggregation" @description "How values within a bucket combine into one number" @synonyms "user phrases: 'count' / 'how many' -> count; 'total' / 'sum of' -> sum; 'average' / 'mean' -> avg; 'minimum' / 'lowest' -> min; 'maximum' / 'highest' -> max" @tier "presentation" @values (count sum avg min max)
    categoryField  : string = "status" @label "Group / categorize / bucket / split by field" @description "Entity field whose values become the chart's category buckets. Set this when the user voices 'group by X' / 'categorize by X' / 'bucket by X' / 'split by X' / 'break down by X' for any non-time field X (for time-units, set period + timeAxis=true instead)." @synonyms "regroup / rebucket / categorize / breakdown by / split by / segment by. user phrases: 'group by status' -> categoryField=status; 'group by region' / 'by region' -> categoryField=region; 'group by category' / 'by category' -> categoryField=category; 'group by product' / 'by product' -> categoryField=product; 'group by month' / 'by month' -> categoryField=month (when explicitly requested as a category, not a time bucket); 'split by X' / 'break down by X' / 'segment by X' / 'bucket by X' -> categoryField=X" @tier "presentation"
    chartType      : string = "bar" @label "Chart type" @description "Visual format for the rendered chart" @synonyms "bar = vertical bars, line = connected line, pie = pie chart, donut = pie with hole, area = filled area chart, histogram = frequency distribution, scatter = XY scatter. user phrases: 'switch to donut' / 'make it a donut' / 'as a donut chart' -> donut; 'use a pie chart' -> pie; 'show as line' / 'line chart' -> line; 'as bars' / 'bar chart' -> bar" @tier "presentation" @values (bar line pie area donut histogram scatter)
    drillEvent     : event = "" @label "Drill event" @description "Event emitted when a user clicks a chart point" @synonyms "click-through navigation event. user phrases: 'on click navigate to X' / 'drill into X' / 'when clicked open X' -> X event name" @tier "internal"
    height         : number = 280 @label "Chart height" @description "Pixel height of the rendered chart" @synonyms "vertical size in pixels. user phrases: 'taller' / 'make it taller' / 'increase height' / 'bigger vertically' -> larger number (e.g. 300, 400); 'shorter' / 'smaller' -> smaller; 'set height to 300' / '300px tall' -> 300" @tier "presentation"
    limit          : number = 0 @label "Top N" @description "Keep only the first N points after sorting (0 = all)" @synonyms "user phrases: 'top 5' -> 5; 'top 10' -> 10; 'first 3' -> 3; 'all' / 'no limit' -> 0; 'show all' -> 0" @tier "presentation"
    period         : string = "month" @label "Group by month / quarter / week / day / year" @description "Group by month, quarter, week, day, or year — the calendar bucket the chart groups data into. Set ALONGSIDE timeAxis=true whenever the user says 'group by <time-unit>' or 'by <time-unit>' or 'rebucket to <time-unit>' or 'instead of <other-time-unit>'." @synonyms "regroup / rebucket / change bucket / group differently. user phrases: 'group by month' / 'by month' / 'monthly' / 'monthly buckets' / 'switch to monthly' / 'instead of quarter' -> month; 'group by quarter' / 'by quarter' / 'quarterly' -> quarter; 'group by week' / 'by week' / 'weekly' / 'weekly buckets' -> week; 'group by day' / 'by day' / 'daily' / 'daily buckets' -> day; 'group by year' / 'by year' / 'yearly' / 'annually' -> year. Whenever the user voices 'group by <time-unit>' BOTH period AND timeAxis=true should be set." @tier "presentation" @values (day week month quarter year)
    series         : [SeriesSpec] = [] @label "Series" @description "Pre-formatted multi-series spec for stacked or layered charts" @synonyms "multiple lines / bars per category. user phrases: 'compare X and Y' -> add two series entries" @tier "presentation"
    showLegend     : boolean = true @label "Show legend" @description "Display the series legend" @synonyms "true shows the color key. user phrases: 'show legend' / 'show the legend' / 'show key' / 'with legend' / 'with a legend' -> true; 'hide legend' / 'no legend' / 'without legend' / 'remove legend' -> false" @tier "presentation"
    showValues     : boolean = false @label "Show values" @description "Render the numeric value on top of each data point" @synonyms "user phrases: 'show values' / 'show numbers on bars' / 'with data labels' / 'label the bars' -> true; 'hide values' / 'no labels' -> false" @tier "presentation"
    sortDir        : string = "desc" @label "Sort direction" @description "Ascending or descending order for the sort field" @synonyms "asc = ascending = lowest-to-highest = low-to-high = smallest-first. desc = descending = highest-to-lowest = high-to-low = largest-first. user phrases: 'highest to lowest' / 'largest first' / 'descending' -> desc; 'lowest to highest' / 'smallest first' / 'ascending' -> asc" @tier "presentation" @values (asc desc)
    sortField      : string = "none" @label "Sort by" @description "Order points by value, label, or leave unsorted" @synonyms "user phrases: 'sort by value' / 'order by amount' -> value; 'sort alphabetically' / 'sort by name' -> label; 'no sort' / 'leave order' -> none" @tier "presentation" @values (value label none)
    stack          : string = "none" @label "Stacking" @description "Stack bars, normalize to 100%, or render side-by-side" @synonyms "user phrases: 'side by side' / 'grouped' -> none; 'stacked' / 'stack the bars' -> stack; 'percent stacked' / '100% stacked' / 'normalized' -> normalize" @tier "presentation" @values (none stack normalize)
    subtitle       : string = "Counts per category" @label "Subtitle" @description "Secondary line below the title" @synonyms "secondary header below the title. user phrases: 'with subtitle X' / 'set subtitle to X' -> X" @tier "presentation"
    timeAxis       : boolean = false @label "Time axis" @description "Group by timeField bucketed by period instead of categoryField" @synonyms "true means group by date / month / time. user phrases: 'group by month / week / year / date' -> set timeAxis=true; 'group by status / category' -> timeAxis=false" @tier "presentation"
    timeField      : string = "date" @label "Date field" @description "Entity field used as the time axis when timeAxis is on" @synonyms "the date / timestamp / created-at column. set when timeAxis=true" @tier "presentation"
    title          : string = "Distribution" @label "Title" @description "Heading shown above the chart" @synonyms "the chart's header text. user phrases: 'rename to X' / 'title it X' / 'change the title to X' / 'call it X' -> X" @tier "presentation"
    valueField     : string = "" @label "Value field" @description "Numeric field aggregated per bucket (blank = row count)" @synonyms "the numeric column to aggregate. empty string counts rows. user phrases: 'sum revenue' -> valueField=revenue + aggregation=sum" @tier "presentation"
    viewPattern    : pattern = "chart" @label "Render pattern" @description "UI pattern used to draw the chart" @synonyms "internal pattern selector. user prompts rarely target this directly — pattern selection is upstream" @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-graphs.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-grid-tactics.orb orbitals[0].traits[0])
trait std-grid-tactics.traits.GridTactics {
  alias          : GridTactics
  linkedEntity   : TacticsState
  category       : lifecycle
  states         : (active*)
  events         : (INIT MOVE ATTACK SPAWN HEAL AI_TURN BURST UNITS_CHANGED)
  transitions    : ((active -> active on INIT) (active -> active on MOVE) (active -> active on ATTACK) (active -> active on SPAWN) (active -> active on HEAL) (active -> active on AI_TURN))
  emits          : (BURST UNITS_CHANGED)
  config {
    attackDamage   : number = 1 @label "Attack Damage" @description "Health removed from a target per ATTACK intent" @tier "domain"
    gridHeight     : number = 12 @label "Grid Height" @description "Grid row count clamping move + AI bounds" @tier "presentation"
    gridWidth      : number = 12 @label "Grid Width" @description "Grid column count clamping move + AI bounds" @tier "presentation"
    running        : boolean = true @label "Running" @description "When true, incoming MOVE/ATTACK/AI_TURN intents are applied; toggle to freeze the board" @tier "domain"
    tiles          : [Tile] = [] @label "Tiles" @description "Grid tiles used for passability checks during moves and AI stepping" @tier "presentation"
    units          : [Unit] = [] @label "Initial Units" @description "Seed unit roster (players and enemies) present before the first intent" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-grid-tactics.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-hero.orb orbitals[0].traits[0])
trait std-hero.traits.HeroRender {
  alias          : Hero
  linkedEntity   : HeroView
  category       : interaction
  states         : (idle*)
  events         : (INIT HERO_PRIMARY HERO_SECONDARY CTA_PRIMARY CTA_SECONDARY)
  transitions    : ((idle -> idle on INIT) (idle -> idle on HERO_PRIMARY) (idle -> idle on HERO_SECONDARY))
  emits          : (CTA_PRIMARY CTA_SECONDARY)
  config {
    alignment      : string = "center" @label "Alignment" @description "Center the copy, or align it to the start edge" @tier "presentation" @values (center start)
    command        : string = "" @label "Command" @description "A shell command shown in a copyable code box under the actions, e.g. an install one-liner; empty hides it" @synonyms "install command, cli, terminal snippet" @tier "presentation"
    copyContent    : render-ui = {"align":["if",["==","@config.alignment","center"],"center","start"],"children":[{"label":"@config.eyebrow","size":"md","type":"badge","variant":"primary"},{"align":["if",["==","@config.alignment","center"],"center","left"],"className":"tracking-tight text-balance","content":"@config.headline","type":"typography","variant":["if",["==","@config.look","banner"],"h2","h1"],"weight":"bold"},{"align":["if",["==","@config.alignment","center"],"center","left"],"className":["if",["==","@config.lede",""],"hidden","max-w-2xl text-pretty"],"color":"muted","content":"@config.lede","type":"typography","variant":"large"},{"children":[{"action":"HERO_PRIMARY","actionPayload":{"href":"@config.primaryHref"},"className":["if",["==","@config.primaryLabel",""],"hidden",""],"href":"@config.primaryHref","label":"@config.primaryLabel","size":"lg","type":"button","variant":"primary"},{"action":"HERO_SECONDARY","actionPayload":{"href":"@config.secondaryHref"},"className":["if",["==","@config.secondaryLabel",""],"hidden",""],"href":"@config.secondaryHref","label":"@config.secondaryLabel","size":"lg","type":"button","variant":"secondary"}],"className":["if",["==","@config.primaryLabel",""],["if",["==","@config.secondaryLabel",""],"hidden","pt-2"],"pt-2"],"direction":"horizontal","gap":"md","justify":["if",["==","@config.alignment","center"],"center","start"],"type":"stack","wrap":true},{"children":[{"code":"@config.command","language":"bash","showCopyButton":true,"showLanguageBadge":false,"type":"code-block"}],"className":["if",["==","@config.command",""],"hidden","max-w-xl"],"fullWidth":true,"type":"box"}],"direction":"vertical","gap":"lg","type":"stack"} @label "Copy block" @tier "internal"
    eyebrow        : string = "" @label "Eyebrow" @description "Small badge above the headline; empty hides it" @synonyms "tag, kicker, label above title" @tier "presentation"
    headline       : string = "Build what you mean" @label "Headline" @description "Main headline" @synonyms "title, heading" @tier "presentation"
    lede           : string = "" @label "Supporting text" @description "One or two sentences under the headline; empty hides it" @synonyms "subtitle, subheading, description, tagline" @tier "presentation"
    look           : string = "hero" @label "Look" @description "hero = full-width page opener with an h1; banner = contained call-to-action card with an h2" @synonyms "cta banner, call to action, callout, page header, masthead" @tier "presentation" @values (hero banner)
    mediaAlt       : string = "" @label "Media alt text" @tier "presentation"
    mediaContent   : render-ui = {"alt":"@config.mediaAlt","bordered":true,"loading":"eager","rounded":"xl","src":"@config.mediaSrc","type":"image"} @label "Media block" @tier "internal"
    mediaPosition  : string = "below" @label "Media position" @description "Below the copy, or beside it on wide screens" @tier "presentation" @values (below side)
    mediaSrc       : string = "" @label "Media image" @description "Screenshot or illustration URL; empty hides it" @synonyms "hero image, screenshot, picture" @tier "presentation"
    primaryHref    : string = "#" @label "Primary action link" @description "In-app path, #anchor, or absolute URL" @tier "presentation"
    primaryLabel   : string = "Get started" @label "Primary action label" @description "Empty hides the primary action" @tier "presentation"
    secondaryHref  : string = "" @label "Secondary action link" @description "In-app path, #anchor, or absolute URL" @tier "presentation"
    secondaryLabel : string = "" @label "Secondary action label" @description "Empty hides the secondary action" @tier "presentation"
    sideContent    : render-ui = {"bg":["if",["==","@config.surface","muted"],"muted","transparent"],"children":[{"children":[{"bg":["if",["==","@config.look","banner"],"muted","transparent"],"border":["==","@config.look","banner"],"children":[{"align":"center","children":["@config.copyContent","@config.mediaContent"],"gap":"xl","ratio":"1:1","type":"split"}],"padding":["if",["==","@config.look","banner"],"xl","none"],"rounded":["if",["==","@config.look","banner"],"2xl","none"],"type":"box"}],"maxWidth":"xl","padding":"lg","size":"xl","type":"container"}],"fullWidth":true,"paddingY":["if",["==","@config.look","banner"],"xl","2xl"],"type":"box"} @label "Side-by-side body" @tier "internal"
    stackedContent : render-ui = {"bg":["if",["==","@config.surface","muted"],"muted","transparent"],"children":[{"children":[{"bg":["if",["==","@config.look","banner"],"muted","transparent"],"border":["==","@config.look","banner"],"children":[{"align":["if",["==","@config.alignment","center"],"center","stretch"],"children":["@config.copyContent","@config.mediaContent"],"direction":"vertical","gap":"2xl","type":"stack"}],"padding":["if",["==","@config.look","banner"],"xl","none"],"rounded":["if",["==","@config.look","banner"],"2xl","none"],"type":"box"}],"maxWidth":"xl","padding":"lg","size":"xl","type":"container"}],"fullWidth":true,"paddingY":["if",["==","@config.look","banner"],"xl","2xl"],"type":"box"} @label "Stacked body" @tier "internal"
    surface        : string = "plain" @label "Surface" @description "Background behind the block" @tier "presentation" @values (plain muted)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-hero.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-hero-nav.orb orbitals[0].traits[0])
trait std-hero-nav.traits.HeroNav {
  alias          : HeroNav
  linkedEntity   : HeroNavData
  category       : lifecycle
  states         : (active*)
  events         : (INIT MOVE WANDER RESTART HERO_STEPPED)
  transitions    : ((active -> active on INIT) (active -> active on MOVE) (active -> active on WANDER) (active -> active on RESTART))
  emits          : (HERO_STEPPED)
  config {
    gridHeight     : number = 12 @label "Grid Height" @description "Grid row count clamping move + wander bounds" @tier "presentation"
    gridWidth      : number = 12 @label "Grid Width" @description "Grid column count clamping move + wander bounds" @tier "presentation"
    moveBudget     : number = 45 @label "Move Budget" @description "Moves the hero may spend before the round is lost if objectives remain" @tier "domain"
    running        : boolean = true @label "Running" @description "When true, MOVE/WANDER intents are applied; toggle to freeze the board" @tier "domain"
    tiles          : [Tile] = [] @label "Tiles" @description "Grid tiles used for passability checks (auto-generated all-passable when empty)" @tier "presentation"
    units          : [Unit] = [] @label "Initial Units" @description "Seed roster: the player hero plus any neutral NPCs" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-hero-nav.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-image-upload-multi.orb orbitals[0].traits[0])
trait std-image-upload-multi.traits.UploadedImageUpload {
  alias          : ImageUploadMulti
  linkedEntity   : UploadedImage
  category       : interaction
  states         : (loading* browsing uploading error)
  events         : (INIT UploadedImageLoaded UploadedImageLoadFailed UPLOAD DELETE UploadedImageDeleted UploadedImageDeleteFailed UploadedImageStored UploadedImageCreated UploadedImageUploadFailed)
  transitions    : ((loading -> loading on INIT) (loading -> browsing on UploadedImageLoaded) (loading -> error on UploadedImageLoadFailed) (browsing -> loading on INIT) (browsing -> uploading on UPLOAD) (browsing -> browsing on DELETE) (browsing -> loading on UploadedImageDeleted) (browsing -> error on UploadedImageDeleteFailed) (uploading -> uploading on UploadedImageStored) (uploading -> loading on UploadedImageCreated) (uploading -> error on UploadedImageUploadFailed) (error -> browsing on UploadedImageLoaded))
  emits          : (UPLOAD UploadedImageLoaded UploadedImageLoadFailed UploadedImageCreated UploadedImageStored UploadedImageUploadFailed UploadedImageDeleted UploadedImageDeleteFailed)
  config {
    accept         : string = "image/*" @label "MIME filter" @description "Browser accept filter for the file picker" @tier "domain"
    bucket         : string = "images" @label "Storage bucket" @description "Object-storage bucket the batch uploads into" @tier "domain"
    maxBytesPerImage : number = 10485760 @label "Size limit (bytes)" @description "Per-image upload size cap" @tier "domain"
    maxImages      : number = 10 @label "Max images" @description "Maximum number of images accepted per upload batch" @tier "domain"
    title          : string = "Upload Images" @label "Section title" @description "Heading shown above the upload zone" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-image-upload-multi.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-import.orb orbitals[0].traits[0])
trait std-import.traits.ImportMenu {
  alias          : Import
  linkedEntity   : ImportPanel
  category       : interaction
  states         : (idle* picking)
  events         : (INIT OPEN_IMPORT IMPORT_SOURCE_PICKED IMPORT_REQUESTED IMPORT_FAILED FILES_PICKED PICK_FAILED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on OPEN_IMPORT) (idle -> picking on IMPORT_SOURCE_PICKED) (idle -> idle on IMPORT_SOURCE_PICKED) (idle -> idle on IMPORT_REQUESTED) (idle -> idle on IMPORT_FAILED) (picking -> idle on FILES_PICKED) (picking -> idle on PICK_FAILED))
  emits          : (IMPORT_REQUESTED IMPORT_FAILED FILES_PICKED PICK_FAILED)
  config {
    accept         : string = ".md,.markdown,.txt" @label "Accepted file types" @description "File-extension filter for the OS file picker when a file-kind source is picked" @synonyms "file filter, allowed extensions, accepted formats" @tier "presentation"
    buttonLabel    : string = "Import" @label "Button label" @description "Text shown on the toolbar button that opens the import source popover" @synonyms "the text on the import trigger button. user phrases: 'rename import button to X' / 'set the button label to X' -> X (e.g. 'Import Data', 'Add Sources')" @tier "presentation"
    event          : string = "IMPORT_SOURCE_PICKED" @label "Source-picked event" @description "Event emitted when the user picks a source. Each entry in sources[] carries its own literal event field (no per-item templating in .lolo) — overriding this alone does not retarget the click; also set sources[].event to match." @synonyms "bus event name. internal wiring; users rarely target directly" @tier "internal"
    sources        : [SourceOption] = [{"event":"IMPORT_SOURCE_PICKED","id":"paste","kind":"paste","label":"Paste text"},{"event":"IMPORT_SOURCE_PICKED","id":"markdown","kind":"file","label":"Markdown files"}] @label "Import sources" @description "Sources shown in the import popover. kind 'file' opens the OS file picker before IMPORT_REQUESTED; any other kind emits immediately (the host renders the matching input UI, e.g. a paste textarea)." @synonyms "list of import source entries (paste / file / api / database). user phrases: 'only paste' -> keep only the paste entry; 'add database' -> append a database entry" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-import.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-knowledge-loop.orb orbitals[0].traits[0])
trait std-knowledge-loop.traits.KnowledgeLoop {
  alias          : KnowledgeLoop
  linkedEntity   : KnowledgeClaim
  category       : interaction
  states         : (varying* comparing hypothesizing predicting falsifying verifying generalizing isolating composing calibrating selecting)
  events         : (INIT CHANGE_CONDITION MEASURE_DIFFERENCE FORM_GUESS EXTRAPOLATE SURVIVED FAILED CHECKS_AGREE CHECKS_DISAGREE STRIP_TO_ESSENTIALS FIND_AND_CONTROL_CAUSE COMBINE_WITH_TRUSTED CONFIRM_SCORE CANCEL_SCORE CHOOSE_NEXT_TARGET FalsificationRequested VerificationRequested CalibrationRequested LoopConcluded)
  transitions    : ((varying -> varying on INIT) (varying -> comparing on CHANGE_CONDITION) (comparing -> hypothesizing on MEASURE_DIFFERENCE) (hypothesizing -> predicting on FORM_GUESS) (predicting -> falsifying on EXTRAPOLATE) (falsifying -> generalizing on SURVIVED) (falsifying -> verifying on SURVIVED) (falsifying -> hypothesizing on FAILED) (verifying -> generalizing on CHECKS_AGREE) (verifying -> hypothesizing on CHECKS_DISAGREE) (generalizing -> isolating on STRIP_TO_ESSENTIALS) (isolating -> composing on FIND_AND_CONTROL_CAUSE) (composing -> calibrating on COMBINE_WITH_TRUSTED) (calibrating -> selecting on CONFIRM_SCORE) (calibrating -> falsifying on CONFIRM_SCORE) (calibrating -> calibrating on CANCEL_SCORE) (selecting -> varying on CHOOSE_NEXT_TARGET))
  emits          : (FalsificationRequested VerificationRequested CalibrationRequested LoopConcluded)
  config {
    manualFalsification : boolean = true @label "Falsification is judged by a person" @description "On: the falsification gate renders Survived / Failed buttons and a person decides. Off: no buttons render; the consumer's own sibling trait must answer FalsificationRequested by routing its result into SURVIVED / FAILED through a listens override." @synonyms "manual falsification, human judged, automated check off" @tier "policy"
    manualVerification : boolean = true @label "Verification is judged by a person" @description "On: the verification gate renders Checks-agree / Checks-disagree buttons. Off: the consumer's sibling trait answers VerificationRequested by routing its result into CHECKS_AGREE / CHECKS_DISAGREE through a listens override." @synonyms "manual verification, human second opinion, automated cross-check off" @tier "policy"
    reliabilityThreshold : number = 0.8 @label "Reliability threshold" @description "The measured reliability score a calibrated claim must clear before it is considered good enough to act on. Below it, the loop returns to falsification for more testing." @synonyms "confidence threshold, calibration bar, minimum reliability" @tier "policy"
    requireIndependentVerification : boolean = true @label "Require independent verification" @description "Whether a second, independent check must agree before the claim advances. Off skips straight to generalization once falsification survives." @synonyms "second opinion, independent check, cross-verify" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-knowledge-loop.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-arrangement.orb orbitals[0].traits[0])
trait std-learn-arrangement.traits.LearnArrangementSim {
  alias          : LearnArrangement
  linkedEntity   : LearnArrangementScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED PLACE UNDO CHECK RETRY ARRANGEMENT_CHECKED ARRANGEMENT_RESET LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on PLACE) (idle -> idle on UNDO) (idle -> idle on CHECK) (idle -> idle on RETRY))
  emits          : (ARRANGEMENT_CHECKED ARRANGEMENT_RESET LEARN_ROUND_COMPLETE)
  config {
    animate        : boolean = false @label "Animate" @description "Enable continuous redraw loop." @tier "presentation"
    checkLabel     : string = "Check" @label "Check Button Label" @tier "presentation"
    correctColor   : string = "#16a34a" @label "Correct Slot Color" @description "Fill color for a filled slot whose item matches its correct position, once graded." @tier "presentation"
    emptySlotColor : string = "#e2e8f0" @label "Empty Slot Color" @description "Fill color for a slot with no item placed yet." @tier "presentation"
    height         : number = 220 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    incorrectColor : string = "#dc2626" @label "Incorrect Slot Color" @description "Fill color for a filled slot whose item does not match its correct position, once graded." @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "Enable pointer interaction on the canvas." @tier "presentation"
    items          : [LearnArrangementItem] = [{"correctPosition":0,"hint":"What has to happen before anything can be poured?","id":"1","label":"Boil water in a kettle"},{"correctPosition":1,"hint":"The bag goes in before the water does.","id":"2","label":"Place a tea bag in the cup"},{"correctPosition":2,"hint":"Now the water and the bag meet.","id":"3","label":"Pour the hot water over the tea bag"},{"correctPosition":3,"hint":"Flavor needs time to develop.","id":"4","label":"Let it steep for a few minutes"},{"correctPosition":4,"hint":"This happens once the tea is strong enough.","id":"5","label":"Remove the tea bag and add milk or sugar to taste"}] @label "Items" @description "Roster of items to order; each carries its label, its zero-based correct position in the finished sequence, and an optional hint shown beneath its button while unplaced." @synonyms "item, step, stage, sequence, order, ranking, procedure" @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    pendingColor   : string = "#94a3b8" @label "Pending Slot Color" @description "Fill color for a filled slot before grading." @tier "presentation"
    retryLabel     : string = "Retry" @label "Retry Button Label" @tier "presentation"
    slotBorderColor : string = "#334155" @label "Slot Border Color" @tier "presentation"
    slotFontSize   : number = 13 @label "Slot Font Size" @tier "presentation"
    slotHeight     : number = 60 @label "Slot Height (px)" @tier "presentation"
    slotLeft       : number = 40 @label "First Slot X (px)" @tier "presentation"
    slotSpacing    : number = 120 @label "Slot Spacing (px)" @tier "presentation"
    slotTextColor  : string = "#0f172a" @label "Slot Text Color" @tier "presentation"
    slotWidth      : number = 100 @label "Slot Width (px)" @tier "presentation"
    slotY          : number = 70 @label "Slot Row Y (px)" @tier "presentation"
    title          : string = "Build the Order" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    undoLabel      : string = "Undo" @label "Undo Button Label" @tier "presentation"
    width          : number = 640 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-arrangement.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-classify.orb orbitals[0].traits[0])
trait std-learn-classify.traits.LearnClassifySim {
  alias          : LearnClassify
  linkedEntity   : LearnClassifyScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED PICK ADVANCE RETRY TOGGLE_RUN CLASSIFY_UPDATED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on PICK) (idle -> idle on ADVANCE) (idle -> idle on RETRY) (idle -> idle on TOGGLE_RUN))
  emits          : (CLASSIFY_UPDATED LEARN_ROUND_COMPLETE)
  config {
    advanceLabel   : string = "Next" @label "Advance Button Label" @description "Label text for the button that advances to the next item." @tier "presentation"
    advanceMs      : number = 900 @label "Auto-Advance Interval (ms)" @description "Milliseconds between automatic advances while running — the 32ms base tick accumulates elapsed time and fires ADVANCE each time this interval elapses." @tier "domain"
    animate        : boolean = false @label "Animate" @description "Enable continuous redraw loop." @tier "presentation"
    autoRun        : boolean = false @label "Auto Run" @description "When true the advance clock starts on load and the drill flips to the next item every advanceMs milliseconds; toggle live with the Auto/Pause button." @tier "domain"
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    categories     : [LearnClassifyOption] = [{"color":"#94a3b8","label":"Category A","value":"a"},{"color":"#64748b","label":"Category B","value":"b"}] @label "Categories" @description "Ordered bottom-to-top roster of category buckets (value/label/color) used to render the stacked backdrop and the pick buttons; order determines the backdrop's stacking, widest at the bottom to narrowest at the top." @synonyms "category, bucket, class, tier, level, classification, roster" @tier "domain"
    correctColor   : string = "#16a34a" @label "Correct Highlight Color" @description "Fill color for the correct category once the learner has picked." @tier "presentation"
    height         : number = 420 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    incorrectColor : string = "#dc2626" @label "Incorrect Highlight Color" @description "Fill color for the learner's picked category when it does not match the correct category." @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "Enable pointer interaction on the canvas." @tier "presentation"
    items          : [LearnClassifyItem] = [{"category":"a","explanation":"This example was written to satisfy category A's defining trait.","hint":"Consider what makes this belong to category A.","text":"Example item one."},{"category":"b","explanation":"This example was written to satisfy category B's defining trait.","hint":"Consider what makes this belong to category B.","text":"Example item two."}] @label "Items" @description "Roster of items the learner classifies; each carries its prompt text, the value of its correct category, and optional hint/explanation text shown before/after the pick." @synonyms "item, prompt, scenario, situation, case, example, question" @tier "domain"
    loopRound      : boolean = false @label "Loop Round" @description "When true the item cursor wraps past the last item forever (a looping drill) instead of ending the round at the summary screen." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    orderStride    : number = 1 @label "Order Stride" @description "Items advance by this stride through the roster — 1 is sequential; a stride coprime with the roster length (e.g. 3) interleaves the corpus so adjacent items differ." @tier "domain"
    passScore      : number = 0 @label "Pass Score" @description "Target score shown next to the running score as \"pass at N\"; 0 hides the target." @tier "domain"
    penaltyPerMiss : number = 0 @label "Penalty Per Miss" @description "Rubric points subtracted for each incorrect pick (score never drops below 0)." @tier "domain"
    pointsPerCorrect : number = 1 @label "Points Per Correct" @description "Rubric points added to the score for each correct pick; at the default 1 with no penalty, the plain correct/attempted counts render instead of the rubric score." @tier "domain"
    retryLabel     : string = "Retry Round" @label "Retry Button Label" @description "Label text for the button that restarts the round from the end-of-round summary." @tier "presentation"
    scoreCap       : number = 0 @label "Score Cap" @description "Upper bound on the rubric score; 0 means uncapped." @tier "domain"
    showHint       : boolean = true @label "Show Hint" @description "Show each item's hint line beneath the prompt before the learner picks; hide for a harder drill." @tier "domain"
    title          : string = "Classify" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    width          : number = 640 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-classify.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-compare.orb orbitals[0].traits[0])
trait std-learn-compare.traits.CompareSim {
  alias          : LearnCompare
  linkedEntity   : CompareScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED SET_PARAM COMPARISON_CHANGED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on SET_PARAM))
  emits          : (COMPARISON_CHANGED)
  config {
    compareText    : string = "Tune each side's parameters and watch how the two curves diverge." @label "Compare Text" @description "One-sentence statement of what is being contrasted." @tier "domain"
    curveKind      : string = "power" @label "Curve Kind" @description "Curve family both sides are drawn from: power (y = A·xᴮ), linear (y = A + B·x), or sine (y = A·sin(B·x))." @synonyms "curve family, power law, linear function, sine wave, function type" @tier "domain"
    gridStep       : number = 1 @label "Grid Step" @tier "presentation"
    height         : number = 400 @label "Height" @tier "presentation"
    leftADefault   : number = 1 @label "Left A Default" @tier "domain"
    leftBDefault   : number = 2 @label "Left B Default" @tier "domain"
    leftColor      : string = "#3b82f6" @label "Left Color" @tier "presentation"
    leftLabel      : string = "Left" @label "Left Label" @description "Display name of the first compared instance." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    paramALabel    : string = "A" @label "Parameter A Label" @tier "presentation"
    paramAMax      : number = 5 @label "Parameter A Max" @tier "domain"
    paramAMin      : number = -5 @label "Parameter A Min" @tier "domain"
    paramAStep     : number = 0.1 @label "Parameter A Step" @tier "presentation"
    paramBLabel    : string = "B" @label "Parameter B Label" @tier "presentation"
    paramBMax      : number = 5 @label "Parameter B Max" @tier "domain"
    paramBMin      : number = -5 @label "Parameter B Min" @tier "domain"
    paramBStep     : number = 0.1 @label "Parameter B Step" @tier "presentation"
    rightADefault  : number = 2 @label "Right A Default" @tier "domain"
    rightBDefault  : number = 1.5 @label "Right B Default" @tier "domain"
    rightColor     : string = "#f59e0b" @label "Right Color" @tier "presentation"
    rightLabel     : string = "Right" @label "Right Label" @description "Display name of the second compared instance." @tier "domain"
    showAxes       : boolean = true @label "Show Axes" @tier "presentation"
    showGrid       : boolean = true @label "Show Grid" @tier "presentation"
    title          : string = "Compare Two Settings" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
    xMax           : number = 10 @label "X Max" @tier "presentation"
    xMin           : number = 0 @label "X Min" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-compare.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-coupled-sim.orb orbitals[0].traits[0])
trait std-learn-coupled-sim.traits.CoupledSimSim {
  alias          : LearnCoupledSim
  linkedEntity   : CoupledSimScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED RUN PAUSE RESET SET_A SET_B SHOCK RUN_TOGGLED SIM_RESET COEFS_CHANGED SHOCK_APPLIED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on RUN) (idle -> idle on PAUSE) (idle -> idle on RESET) (idle -> idle on SET_A) (idle -> idle on SET_B) (idle -> idle on SHOCK))
  emits          : (RUN_TOGGLED SIM_RESET COEFS_CHANGED SHOCK_APPLIED)
  config {
    autoRun        : boolean = true @label "Auto Run" @description "Whether the simulation starts running immediately on load." @tier "domain"
    coefADefault   : number = 0.6 @label "Coefficient A Default" @tier "domain"
    coefALabel     : string = "Prey growth rate" @label "Coefficient A Label" @description "Display label of the first governing rate slider." @tier "domain"
    coefAMax       : number = 2 @label "Coefficient A Max" @tier "domain"
    coefAMin       : number = 0 @label "Coefficient A Min" @tier "domain"
    coefAStep      : number = 0.01 @label "Coefficient A Step" @tier "presentation"
    coefBDefault   : number = 0.9 @label "Coefficient B Default" @tier "domain"
    coefBLabel     : string = "Predation rate" @label "Coefficient B Label" @description "Display label of the second governing rate slider." @tier "domain"
    coefBMax       : number = 2 @label "Coefficient B Max" @tier "domain"
    coefBMin       : number = 0 @label "Coefficient B Min" @tier "domain"
    coefBStep      : number = 0.01 @label "Coefficient B Step" @tier "presentation"
    coefC          : number = 0.5 @label "Coefficient C" @description "Predator-prey only: conversion efficiency of predation into predator growth." @tier "domain"
    coefD          : number = 0.4 @label "Coefficient D" @description "Predator-prey only: predator death rate." @tier "domain"
    duration       : number = 30 @label "Duration" @description "Simulated seconds before the run stops automatically." @tier "domain"
    gridStep       : number = 50 @label "Grid Step" @tier "presentation"
    height         : number = 360 @label "Height" @tier "presentation"
    kind           : string = "predator-prey" @label "Interaction Family" @description "Which coupled dynamics govern the two quantities: predator-prey (oscillating cycles), epidemic (S and I with transmission and recovery), or kinetics (A decaying into B)." @synonyms "predator prey, Lotka-Volterra, SIR, epidemic, reaction kinetics, coupled ODE" @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    pColor         : string = "#16a34a" @label "P Color" @tier "presentation"
    pLabel         : string = "Prey" @label "P Label" @description "Display name of the first quantity." @tier "domain"
    pStart         : number = 120 @label "P Start" @tier "domain"
    qColor         : string = "#dc2626" @label "Q Color" @tier "presentation"
    qLabel         : string = "Predators" @label "Q Label" @description "Display name of the second quantity." @tier "domain"
    qStart         : number = 40 @label "Q Start" @tier "domain"
    shockDownLabel : string = "− Prey cull" @label "Shock Down Label" @tier "presentation"
    shockSize      : number = 40 @label "Shock Size" @description "How much of the first quantity a shock button injects or removes." @tier "domain"
    shockUpLabel   : string = "+ Prey burst" @label "Shock Up Label" @tier "presentation"
    taskText       : string = "Run the system, retune the rates, and shock it — watch how the two quantities push and pull each other." @label "Task Text" @description "One-sentence statement of what to explore." @tier "domain"
    timeScale      : number = 1 @label "Time Scale" @description "Multiplier on the integration step; raise it to fast-forward the dynamics." @tier "domain"
    title          : string = "Coupled System" @label "Title" @description "Title shown above the simulation." @tier "presentation"
    valueMax       : number = 300 @label "Value Max" @description "Upper bound of the chart's y axis." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-coupled-sim.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-derivation.orb orbitals[0].traits[0])
trait std-learn-derivation.traits.LearnDerivationSim {
  alias          : LearnDerivation
  linkedEntity   : LearnDerivationScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED APPLY_STEP TOGGLE_RUN RESET DERIVATION_UPDATED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on APPLY_STEP) (idle -> idle on TOGGLE_RUN) (idle -> idle on RESET))
  emits          : (DERIVATION_UPDATED LEARN_ROUND_COMPLETE)
  config {
    autoApplyIntervalMs : number = 800 @label "Auto-Apply Interval (ms)" @description "Milliseconds of running clock per automatic candidate application — the 32ms base tick accumulates elapsed time and applies the first applicable candidate each time this interval elapses." @tier "domain"
    autoRun        : boolean = false @label "Auto Run" @description "When true, INIT/MODE_SELECTED/Reset start the tick auto-applying candidates; toggle live with the Run/Pause button." @tier "domain"
    autoRunOffMessage : string = "Paused — apply steps manually." @label "Auto Run Off Message" @description "Feedback shown when Run is toggled off (Pause)." @tier "presentation"
    autoRunOnMessage : string = "Auto-stepping — tick applies the next available step." @label "Auto Run On Message" @description "Feedback shown when Run is toggled on." @tier "presentation"
    candidates     : [LearnDerivationCandidate] = [{"deriveNegationMode":"same","deriveSide":"right","key":"FORWARD","label":"Forward Rule","matchNegationMode":"same","matchSide":"left","noMatchFeedback":"No matching premises yet for the forward rule.","resultBadgeLabel":"DERIVED","resultBadgeVariant":"success"},{"deriveNegationMode":"invert","deriveSide":"left","key":"BACKWARD","label":"Backward Rule","matchNegationMode":"opposite","matchSide":"right","noMatchFeedback":"No matching premises yet for the backward rule.","resultBadgeLabel":"DERIVED","resultBadgeVariant":"success"}] @label "Candidates" @description "Candidate steps offered as buttons. Each declares which side of a link it matches against a current fact (matchSide/matchNegationMode) and which side it derives (deriveSide/deriveNegationMode) — left/right and same/opposite/invert are structural roles, not domain vocabulary, so the same two candidates can encode modus ponens/modus tollens, a forward/backward chemical rule, or any other two-sided derivation pair." @synonyms "candidate, rule, step, inference rule, derivation rule, deduction rule" @tier "domain"
    goalLabel      : string = "B" @label "Goal" @description "The line label the learner is trying to derive; goalReached fires when a newly derived line's label equals this." @synonyms "target, goal, derivation target, conclusion" @tier "domain"
    goalPrefix     : string = "Goal: derive " @label "Goal Caption Prefix" @description "Text prepended to goalLabel to form the goal caption shown above the derivation panel." @tier "presentation"
    goalReachedMessage : string = "Goal reached." @label "Goal Reached Message" @description "Caption shown once goalReached is true." @tier "presentation"
    height         : number = 400 @label "Height" @description "Maximum height of the scrollable derivation panel, in pixels." @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    negationSymbol : string = "¬" @label "Negation Symbol" @description "Prefix prepended to a derived line's label when it is negated." @tier "presentation"
    noStepAvailableMessage : string = "No further steps are available yet." @label "No Step Available Message" @description "Feedback shown when the auto-apply tick finds no applicable candidate." @tier "presentation"
    premises       : [LearnDerivationLine] = [{"badgeLabel":"GIVEN","badgeVariant":"neutral","id":"given-a","kind":"fact","label":"A","negated":false,"subject":"A"},{"badgeLabel":"RULE","badgeVariant":"info","id":"given-a-implies-b","kind":"link","label":"A → B","leftNegated":false,"leftSubject":"A","rightNegated":false,"rightSubject":"B"}] @label "Premises" @description "The starting lines of the derivation: plain facts (subject/negated) and two-sided links (leftSubject/leftNegated/rightSubject/rightNegated) the learner combines with candidate steps. Each line carries its own badgeLabel/badgeVariant." @synonyms "premise, given, starting line, hypothesis, starting statement" @tier "domain"
    resetLabel     : string = "Reset" @label "Reset Button Label" @description "Label text for the button that restores the starting premises." @tier "presentation"
    title          : string = "Derivation Lab" @label "Title" @description "Title shown above the derivation panel." @tier "presentation"
    width          : number = 600 @label "Width" @description "Maximum width of the panel, in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-derivation.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-diagram.orb orbitals[0].traits[0])
trait std-learn-diagram.traits.LearnDiagramSim {
  alias          : LearnDiagram
  linkedEntity   : LearnDiagramScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED SELECT_PART CLEAR_PART PART_SELECTED SELECTION_CLEARED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on SELECT_PART) (idle -> idle on CLEAR_PART))
  emits          : (PART_SELECTED SELECTION_CLEARED)
  config {
    backgroundColor : string = "#f8fafc" @label "Background Color" @description "Canvas background color." @tier "presentation"
    clearLabel     : string = "Clear" @label "Clear Button Label" @description "Label text for the button that clears the current selection." @tier "presentation"
    height         : number = 400 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    highlightColor : string = "#f59e0b" @label "Highlight Color" @description "Ring color drawn around the selected part." @tier "presentation"
    links          : [LearnDiagramLink] = [{"color":"#cbd5e1","from":"input","label":"","to":"processor"},{"color":"#cbd5e1","from":"processor","label":"","to":"storage"},{"color":"#cbd5e1","from":"processor","label":"","to":"output"},{"color":"#cbd5e1","from":"controller","label":"","to":"processor"}] @label "Links" @description "Connector lines drawn between parts, by id." @synonyms "link, edge, connector, arrow" @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    overviewText   : string = "Select a part below to learn what it does." @label "Overview Text" @description "Caption card text shown when no part is selected." @tier "presentation"
    parts          : [LearnDiagramPart] = [{"color":"#2563eb","description":"Receives raw data or requests from the outside world and hands them to the processor.","id":"input","label":"Input","radius":34,"x":120,"y":200},{"color":"#7c3aed","description":"The central component that transforms incoming data according to the system's rules.","id":"processor","label":"Processor","radius":46,"x":300,"y":200},{"color":"#0891b2","description":"Persists data so it can be retrieved later, even after the system restarts.","id":"storage","label":"Storage","radius":34,"x":300,"y":320},{"color":"#16a34a","description":"Delivers the processor's results back out to users or other systems.","id":"output","label":"Output","radius":34,"x":480,"y":200},{"color":"#dc2626","description":"Coordinates timing and configuration for the processor without touching the data itself.","id":"controller","label":"Controller","radius":26,"x":300,"y":80}] @label "Parts" @description "Roster of labeled parts (id, label, description, x, y, radius, color) the diagram renders as circles; the learner selects one to see its description." @synonyms "part, node, component, label, annotation" @tier "domain"
    title          : string = "System Diagram" @label "Title" @description "Title shown above the diagram." @tier "presentation"
    width          : number = 600 @label "Width" @description "Canvas width in pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-diagram.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-doser.orb orbitals[0].traits[0])
trait std-learn-doser.traits.LearnDoserSim {
  alias          : LearnDoser
  linkedEntity   : DoserScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED ADD_SMALL ADD_LARGE TOGGLE_DRIP RESET DOSE_ADDED DOSE_RESET DOSER_UPDATED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on ADD_SMALL) (idle -> idle on ADD_LARGE) (idle -> idle on TOGGLE_DRIP) (idle -> idle on RESET))
  emits          : (DOSE_ADDED DOSE_RESET DOSER_UPDATED LEARN_ROUND_COMPLETE)
  config {
    autoDrip       : boolean = false @label "Auto Drip" @description "When true, INIT/MODE_SELECTED/Reset start the drip clock adding a small increment each interval; toggle live with the Auto-dose/Pause button." @tier "domain"
    backgroundColor : string = "#fafafa" @label "Background Color" @description "Canvas background color." @tier "presentation"
    bands          : [DoserBand] = [{"color":"#94a3b8","label":"Low","terminal":false,"upperBound":50},{"color":"#16a34a","label":"High","terminal":true,"upperBound":999999999}] @label "Bands" @description "Ordered ascending roster of dose bands/zones — each carries the dose upper bound it covers, a label, a color, and whether crossing into it is terminal (irreversible; sets done true until Reset). The accumulated dose is classified into the first band whose upperBound it does not exceed, falling through to the last band beyond all bounds." @synonyms "zone, band, threshold, region, stage, phase, tier" @tier "domain"
    capacity       : number = 100 @label "Capacity" @description "Maximum total dose the source can deliver; the source vessel drains to empty and additions clamp once accumulated dose reaches this cap." @tier "domain"
    dripIntervalMs : number = 500 @label "Drip Interval (ms)" @description "Milliseconds of running clock per auto-drip increment — the 32ms base tick accumulates elapsed time and adds a small step each time this interval elapses." @tier "domain"
    height         : number = 400 @label "Height" @description "Canvas height in pixels." @tier "presentation"
    historyLength  : number = 300 @label "Dose History" @description "Maximum points kept in the dose-history trace; older points drop off once exceeded." @tier "domain"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    quantityLabel  : string = "Dose" @label "Quantity Label" @description "Label used for the accumulated-quantity readout and in the narration line." @synonyms "quantity, amount, dose, volume, level" @tier "domain"
    reservoirLabel : string = "Reservoir" @label "Reservoir Label" @description "Label for the vessel that fills as dose accumulates." @synonyms "reservoir, beaker, tank, container, receiving vessel" @tier "presentation"
    showCanvas     : boolean = true @label "Show Canvas" @description "When true (the default, standalone use) the instrument renders its own reservoir/source canvas and narration below the control strip. Set false when a domain sibling trait composes this atom via @rebindable and owns the accurate scene render itself — then only the control strip (add/drip/reset buttons) embeds via @trait.<name>, avoiding a duplicate canvas." @tier "presentation"
    sourceColor    : string = "#60a5fa" @label "Source Color" @description "Fill color for the source vessel." @tier "presentation"
    sourceLabel    : string = "Source" @label "Source Label" @description "Label for the vessel that drains as dose is delivered from it." @synonyms "source, burette, supply, dispenser" @tier "presentation"
    stepLarge      : number = 5 @label "Large Step" @description "Quantity added per press of the coarse add button." @tier "domain"
    stepSmall      : number = 1 @label "Small Step" @description "Quantity added per press of the fine add button, and per auto-drip tick — for precise control near a band boundary." @tier "domain"
    title          : string = "Doser" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    unit           : string = "" @label "Unit" @description "Unit suffix appended to the step-size button labels (e.g. \"mL\", \"mg\", \"units\"); empty means no unit shown." @tier "domain"
    width          : number = 600 @label "Width" @description "Canvas width in pixels." @tier "presentation"
    zoneReadoutLabel : string = "Zone" @label "Zone Readout Label" @description "Label used for the current-band readout row." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-doser.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-estimate.orb orbitals[0].traits[0])
trait std-learn-estimate.traits.EstimateSim {
  alias          : LearnEstimate
  linkedEntity   : EstimateScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED SET_ESTIMATE LOCK_IN NEXT RETRY ESTIMATE_JUDGED PROMPT_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on SET_ESTIMATE) (idle -> idle on LOCK_IN) (idle -> idle on NEXT) (idle -> idle on RETRY))
  emits          : (ESTIMATE_JUDGED PROMPT_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  config {
    closePct       : number = 0.25 @label "Close Band" @description "Relative error at or below this fraction (but above the exact band) counts as close (partial points)." @tier "domain"
    closePoints    : number = 1 @label "Close Points" @tier "domain"
    exactPct       : number = 0.05 @label "Exact Band" @description "Relative error at or below this fraction counts as exact (full points)." @tier "domain"
    exactPoints    : number = 2 @label "Exact Points" @tier "domain"
    lockLabel      : string = "Lock In" @label "Lock Label" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    nextLabel      : string = "Next" @label "Next Label" @tier "presentation"
    prompts        : [EstimatePrompt] = [{"answer":300,"hint":"Light covers 300,000 km every second.","prompt":"How many meters does light travel in one microsecond?","unit":"m"},{"answer":212,"hint":"It is 100 °C.","prompt":"What is the boiling point of water at sea level, in Fahrenheit?","unit":"°F"},{"answer":11.6,"hint":"A day is 86,400 seconds.","prompt":"Roughly how many days is one million seconds?","unit":"days"}] @label "Prompts" @description "The question roster; each prompt carries the true numeric answer, an optional unit, and an optional hint. Realizations declare their own subject's quantities here." @tier "domain"
    retryLabel     : string = "Try Again" @label "Retry Label" @tier "presentation"
    sliderDefault  : number = 100 @label "Slider Default" @description "Starting position of the estimate slider for each prompt." @tier "domain"
    sliderMax      : number = 500 @label "Slider Max" @description "Upper bound of the estimate slider." @tier "domain"
    sliderMin      : number = 0 @label "Slider Min" @description "Lower bound of the estimate slider." @tier "domain"
    sliderStep     : number = 0.1 @label "Slider Step" @tier "presentation"
    title          : string = "Estimate It" @label "Title" @description "Title shown above the drill." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-estimate.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-fx-cues.orb orbitals[0].traits[0])
trait std-learn-fx-cues.traits.LearnFxCues {
  alias          : LearnFxCues
  linkedEntity   : LearnFxCuesScene
  category       : lifecycle
  states         : (active*)
  events         : (INIT ANSWER_JUDGED TAP_JUDGED ESTIMATE_JUDGED CLASSIFY_UPDATED ARRANGEMENT_CHECKED GOAL_CHECKED LEARN_ROUND_COMPLETE TRACE_DONE BURST)
  transitions    : ((active -> active on INIT) (active -> active on ANSWER_JUDGED) (active -> active on TAP_JUDGED) (active -> active on ESTIMATE_JUDGED) (active -> active on CLASSIFY_UPDATED) (active -> active on ARRANGEMENT_CHECKED) (active -> active on GOAL_CHECKED) (active -> active on LEARN_ROUND_COMPLETE) (active -> active on TRACE_DONE))
  emits          : (BURST)
  config {
    bandCues       : [FxBandCue] = [] @label "Band Cues" @description "Per-band cues for ESTIMATE_JUDGED — one row per error band (exact/close/off); bands with no row spawn nothing." @tier "presentation"
    celebrationCue : FxCue = {"color":"#facc15","effect":"confetti","particleCount":40,"space":"screen","ttl":5,"type":"celebration","x":0.5,"z":0.45} @label "Celebration Cue" @description "Cue spawned when a round completes (LEARN_ROUND_COMPLETE / TRACE_DONE)." @tier "presentation"
    correctCue     : FxCue = {"color":"#4ade80","effect":"sparkle","particleCount":10,"space":"screen","ttl":1.5,"type":"correct","x":0.5,"z":0.35} @label "Correct Cue" @description "Cue spawned on a correct judged answer." @tier "presentation"
    progressCue    : FxCue = {"color":"#a5b4fc","effect":"sparkle","particleCount":4,"space":"screen","ttl":1.5,"type":"progress","x":0.5,"z":0.35} @label "Progress Cue" @description "Cue spawned on a partial arrangement check (some but not all slots correct)." @tier "presentation"
    running        : boolean = true @label "Running" @description "When false every cue arm is inert — visual feedback fully disabled without unmounting." @tier "domain"
    streakCue      : FxCue = {"color":"#fbbf24","effect":"streak-glow","space":"screen","ttl":2.5,"type":"streak","x":0.5,"z":0.2} @label "Streak Cue" @description "Extra cue layered on the correct cue once the streak reaches the threshold." @tier "presentation"
    streakThreshold : number = 3 @label "Streak Threshold" @description "Minimum ANSWER_JUDGED streak that adds the streak cue on top of the correct cue." @tier "domain"
    verdictCues    : [FxBandCue] = [] @label "Verdict Cues" @description "Per-verdict cues for CLASSIFY_UPDATED — one row per verdict string; verdicts with no row spawn nothing." @tier "presentation"
    wrongCue       : FxCue = {"color":"#fda4af","effect":"shake","space":"screen","ttl":1,"type":"wrong","x":0.5,"z":0.35} @label "Wrong Cue" @description "Cue spawned on a wrong judged answer (and an unmatched goal check)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-fx-cues.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-goal-seek.orb orbitals[0].traits[0])
trait std-learn-goal-seek.traits.GoalSeekSim {
  alias          : LearnGoalSeek
  linkedEntity   : GoalSeekScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED SET_PARAM_A SET_PARAM_B CHECK RESET PARAMS_CHANGED GOAL_CHECKED GOAL_RESET LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on SET_PARAM_A) (idle -> idle on SET_PARAM_B) (idle -> idle on CHECK) (idle -> idle on RESET))
  emits          : (PARAMS_CHANGED GOAL_CHECKED GOAL_RESET LEARN_ROUND_COMPLETE)
  config {
    checkLabel     : string = "Check" @label "Check Label" @tier "presentation"
    curveKind      : string = "sine" @label "Curve Kind" @description "Curve family both curves are drawn from: power (y = A·xᴮ), linear (y = A + B·x), or sine (y = A·sin(B·x))." @synonyms "curve family, power law, linear function, sine wave, function type" @tier "domain"
    goalText       : string = "Tune the two sliders until your curve matches the target curve, then press Check." @label "Goal Text" @description "One-sentence statement of the inverse problem the learner must solve." @tier "domain"
    gridStep       : number = 1 @label "Grid Step" @tier "presentation"
    height         : number = 400 @label "Height" @tier "presentation"
    learnerColor   : string = "#3b82f6" @label "Learner Color" @tier "presentation"
    learnerLabel   : string = "Yours" @label "Learner Label" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    paramADefault  : number = 1 @label "Parameter A Default" @description "Starting value of the learner's first parameter." @tier "domain"
    paramALabel    : string = "A" @label "Parameter A Label" @description "Display label for the first parameter." @tier "presentation"
    paramAMax      : number = 5 @label "Parameter A Max" @tier "domain"
    paramAMin      : number = -5 @label "Parameter A Min" @tier "domain"
    paramAStep     : number = 0.1 @label "Parameter A Step" @tier "presentation"
    paramBDefault  : number = 1 @label "Parameter B Default" @description "Starting value of the learner's second parameter." @tier "domain"
    paramBLabel    : string = "B" @label "Parameter B Label" @description "Display label for the second parameter." @tier "presentation"
    paramBMax      : number = 5 @label "Parameter B Max" @tier "domain"
    paramBMin      : number = -5 @label "Parameter B Min" @tier "domain"
    paramBStep     : number = 0.1 @label "Parameter B Step" @tier "presentation"
    showAxes       : boolean = true @label "Show Axes" @tier "presentation"
    showGrid       : boolean = true @label "Show Grid" @tier "presentation"
    showLiveDistance : boolean = true @label "Show Live Distance" @description "When true the RMS distance updates live as the learner tunes (warmer/colder); when false only attempts are shown, for a harder variant." @tier "domain"
    targetA        : number = 2.5 @label "Target A" @description "Hidden first parameter of the target curve the learner must recover." @tier "domain"
    targetB        : number = 1.5 @label "Target B" @description "Hidden second parameter of the target curve the learner must recover." @tier "domain"
    targetColor    : string = "#94a3b8" @label "Target Color" @tier "presentation"
    targetLabel    : string = "Target" @label "Target Label" @tier "presentation"
    title          : string = "Goal Seek" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    tolerance      : number = 0.35 @label "Tolerance" @description "Maximum RMS distance between learner and target curves that still counts as a match." @tier "domain"
    width          : number = 600 @label "Width" @tier "presentation"
    xMax           : number = 10 @label "X Max" @tier "presentation"
    xMin           : number = 0 @label "X Min" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-goal-seek.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-grid-sim.orb orbitals[0].traits[0])
trait std-learn-grid-sim.traits.GridSimSim {
  alias          : LearnGridSim
  linkedEntity   : GridSimScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED RUN PAUSE STEP TAP_CELL RESET RUN_TOGGLED GRID_STEPPED CELL_TOGGLED GRID_RESET)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on RUN) (idle -> idle on PAUSE) (idle -> idle on STEP) (idle -> idle on TAP_CELL) (idle -> idle on RESET))
  emits          : (RUN_TOGGLED GRID_STEPPED CELL_TOGGLED GRID_RESET)
  config {
    autoRun        : boolean = false @label "Auto Run" @description "Whether the evolution starts running immediately on load." @tier "domain"
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    cellSize       : number = 26 @label "Cell Size" @tier "presentation"
    cols           : number = 16 @label "Columns" @tier "domain"
    decay          : number = 0.995 @label "Decay" @description "Diffusion rule only: fraction of a cell's value retained each generation." @tier "domain"
    diffuseRate    : number = 0.5 @label "Diffuse Rate" @description "Diffusion rule only: how strongly a cell moves toward its neighbourhood average each generation." @tier "domain"
    height         : number = 332 @label "Height" @tier "presentation"
    lowColor       : string = "#bfdbfe" @label "Low Color" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    midColor       : string = "#60a5fa" @label "Mid Color" @tier "presentation"
    offColor       : string = "#e2e8f0" @label "Off Color" @tier "presentation"
    onColor        : string = "#1d4ed8" @label "On Color" @tier "presentation"
    rows           : number = 12 @label "Rows" @tier "domain"
    rule           : string = "life" @label "Rule" @description "The local update rule: life (Conway birth-3 survive-2-3), spread (an active 4-neighbour activates a cell), or diffusion (cells relax toward the neighbourhood average with decay)." @synonyms "game of life, contagion, wavefront, heat diffusion, cellular automaton rule" @tier "domain"
    seeds          : [number] = [1,18,32,33,34,88,89,90] @label "Seeds" @description "Flat cell indexes (row·cols + col) active at the start — the default plants a glider and a blinker. Realizations declare their own starting pattern here." @tier "domain"
    stepLabel      : string = "Step" @label "Step Label" @tier "presentation"
    taskText       : string = "Tap cells to seed the world, then Run — or Step one generation at a time to see the rule at work." @label "Task Text" @description "One-sentence statement of what to explore." @tier "domain"
    title          : string = "Grid World" @label "Title" @description "Title shown above the grid." @tier "presentation"
    width          : number = 436 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-grid-sim.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-hotspot.orb orbitals[0].traits[0])
trait std-learn-hotspot.traits.HotspotSim {
  alias          : LearnHotspot
  linkedEntity   : HotspotScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED TAP_SHAPE NEXT RETRY TAP_JUDGED PROMPT_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on TAP_SHAPE) (idle -> idle on NEXT) (idle -> idle on RETRY))
  emits          : (TAP_JUDGED PROMPT_ADVANCED ROUND_RESTARTED LEARN_ROUND_COMPLETE)
  config {
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    height         : number = 380 @label "Height" @tier "presentation"
    hitColor       : string = "#16a34a" @label "Hit Ring Color" @description "Color of the highlight ring drawn around the target once found." @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    nextLabel      : string = "Next" @label "Next Label" @tier "presentation"
    prompts        : [HotspotPrompt] = [{"explanation":"The nucleus holds the DNA.","prompt":"Tap the part that stores the cell's genetic material.","targetId":"nucleus"},{"explanation":"Mitochondria run cellular respiration.","prompt":"Tap the part that produces the cell's energy.","targetId":"mitochondrion"},{"explanation":"Ribosomes translate mRNA into protein.","prompt":"Tap the part that builds proteins.","targetId":"ribosome"}] @label "Prompts" @description "The question roster; each prompt names a target hotspot id and an explanation revealed on a hit." @tier "domain"
    retryLabel     : string = "Try Again" @label "Retry Label" @tier "presentation"
    shapes         : [HotspotShape] = [{"color":"#8b5cf6","id":"nucleus","label":"Nucleus","radius":34,"x":300,"y":170},{"color":"#3b82f6","id":"membrane","label":"Membrane","radius":26,"x":130,"y":120},{"color":"#f59e0b","id":"mitochondrion","label":"Mitochondrion","radius":24,"x":460,"y":120},{"color":"#16a34a","id":"ribosome","label":"Ribosome","radius":18,"x":200,"y":280},{"color":"#06b6d4","id":"vacuole","label":"Vacuole","radius":28,"x":420,"y":280}] @label "Hotspots" @description "The labeled parts of the scene; each carries an id, display label, canvas position, radius, and color. Realizations declare their own subject's parts here." @tier "domain"
    title          : string = "Tap the Part" @label "Title" @description "Title shown above the canvas." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-hotspot.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-live-sim.orb orbitals[0].traits[0])
trait std-learn-live-sim.traits.LiveSimSim {
  alias          : LearnLiveSim
  linkedEntity   : LiveSimScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED RUN PAUSE RESET SET_GRAVITY SET_DAMPING RUN_TOGGLED SIM_RESET)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on RUN) (idle -> idle on PAUSE) (idle -> idle on RESET) (idle -> idle on SET_GRAVITY) (idle -> idle on SET_DAMPING))
  emits          : (RUN_TOGGLED SIM_RESET)
  config {
    backgroundColor : string = "#f8fafc" @label "Background Color" @tier "presentation"
    bodies         : [LiveSimBody] = [{"color":"#2563eb","id":"ball-a","radius":14,"vx":4,"vy":0,"x":100,"y":60},{"color":"#16a34a","id":"ball-b","radius":18,"vx":-3,"vy":2,"x":260,"y":90},{"color":"#f59e0b","id":"ball-c","radius":11,"vx":2,"vy":-1,"x":420,"y":40}] @label "Bodies" @description "Initial bodies; each carries position (x,y), radius, color, and velocity (vx,vy). Restored on Reset." @tier "presentation"
    damping        : number = 0.995 @label "Damping" @description "Initial fraction of velocity retained each tick (air resistance); adjustable live via the Damping slider." @tier "domain"
    gravity        : number = 0.4 @label "Gravity" @description "Initial downward acceleration added to each body's vy every tick; adjustable live via the Gravity slider." @tier "domain"
    height         : number = 400 @label "Height" @description "Simulation height in pixels; bounds the bounce." @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    restitution    : number = 0.78 @label "Restitution" @description "Fraction of speed kept when a body bounces off a wall." @tier "domain"
    running        : boolean = false @label "Running" @description "Whether the simulation starts already running on INIT." @tier "domain"
    showVelocity   : boolean = true @label "Show Velocity" @description "Draw each body's velocity vector as an arrow." @tier "presentation"
    title          : string = "Live Sim" @label "Title" @description "Title shown above the instrument." @tier "presentation"
    velocityScale  : number = 8 @label "Velocity Scale" @description "Length multiplier for the velocity arrows." @tier "presentation"
    width          : number = 600 @label "Width" @description "Simulation width in pixels; bounds the bounce." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-live-sim.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-measure.orb orbitals[0].traits[0])
trait std-learn-measure.traits.MeasureSim {
  alias          : LearnMeasure
  linkedEntity   : MeasureScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED RUN PAUSE PROBE RESET RUN_TOGGLED PROBE_RECORDED MEASURE_RESET)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on RUN) (idle -> idle on PAUSE) (idle -> idle on PROBE) (idle -> idle on RESET))
  emits          : (RUN_TOGGLED PROBE_RECORDED MEASURE_RESET)
  config {
    amplitude      : number = 5 @label "Amplitude" @description "The A parameter: the signal's scale." @tier "domain"
    duration       : number = 12 @label "Duration" @description "Seconds the signal runs before stopping automatically." @tier "domain"
    gridStep       : number = 1 @label "Grid Step" @tier "presentation"
    height         : number = 360 @label "Height" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    probeColor     : string = "#dc2626" @label "Probe Color" @tier "presentation"
    probeLabel     : string = "Probe" @label "Probe Label" @tier "presentation"
    rate           : number = 1.2 @label "Rate" @description "The B parameter: angular rate for sine, growth rate for growth, half-life in seconds for decay." @tier "domain"
    signalColor    : string = "#94a3b8" @label "Signal Color" @tier "presentation"
    signalKind     : string = "sine" @label "Signal Kind" @description "How the measured quantity evolves: sine (A·sin(B·t)), growth (A·(1+B)ᵗ), or decay (half-life A·(1/2)^(t/B))." @synonyms "signal family, oscillation, exponential growth, half-life decay" @tier "domain"
    taskText       : string = "Run the signal, then press Probe to record measurements. Watch the running mean settle." @label "Task Text" @description "One-sentence statement of the measuring task." @tier "domain"
    title          : string = "Measurement Lab" @label "Title" @description "Title shown above the experiment." @tier "presentation"
    valueLabel     : string = "value" @label "Value Label" @description "Display name of the measured quantity." @tier "presentation"
    valueMax       : number = 6 @label "Value Max" @description "Upper bound of the chart's y axis." @tier "presentation"
    valueMin       : number = -6 @label "Value Min" @description "Lower bound of the chart's y axis." @tier "presentation"
    width          : number = 600 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-measure.orb orbitals[0].traits[0])"
}

