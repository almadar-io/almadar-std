;; From @almadar/std (behaviors/registry/ui/core/organisms/ui-chat-bar.orb orbitals[0].traits[0])
trait ui-chat-bar.traits.ChatBarRender {
  alias          : UiChatBar
  linkedEntity   : ChatBarItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    activeFilters  : Map<string,string> = {} @label "Active Filters" @description "Active filters" @tier "presentation"
    activeGate     : string @label "Active Gate" @description "Currently active gate label, e.g. 'Gate 2: State machines'" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    context        : string @label "Context" @description "Agent context description" @tier "presentation"
    error          : ChatBarError @label "Error" @description "Error state (UiError)" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    jepaValidity   : number @label "Jepa Validity" @description "JEPA validity probability 0-1" @tier "presentation"
    pageProp       : number @label "Page" @description "Current page number" @synonyms "page" @tier "presentation"
    pageSize       : number @label "Page Size" @description "Number of items per page" @tier "presentation"
    placeholder    : string @label "Placeholder" @description "Input placeholder text" @tier "presentation"
    runningIndicator : node @label "Running Indicator" @description "Shown beside the gate while `status` is running; defaults to a Spinner (a host passes its brand mark)." @tier "presentation"
    searchValue    : string @label "Search Value" @description "Current search query value" @tier "presentation"
    selectedIds    : [string] = [] @label "Selected Ids" @description "Currently selected item IDs" @tier "presentation"
    sortBy         : string @label "Sort By" @description "Current sort field" @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Current sort direction" @tier "presentation" @values (asc desc)
    status         : string = "idle" @label "Status" @description "Pipeline status" @tier "presentation" @values (idle running paused complete error)
    totalCount     : number @label "Total Count" @description "Total number of items" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/organisms/ui-chat-bar.orb orbitals[0].traits[0])"
}

