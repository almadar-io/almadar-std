trait std-wizard.traits.WizardForm {
  alias          : Wizard
  linkedEntity   : WizardView
  category       : interaction
  states         : (loading* running completed cancelled error)
  events         : (INIT WizardLoaded WizardLoadFailed WizardSaved WizardSaveFailed ADVANCE RETREAT CANCEL RESTART)
  transitions    : ((loading -> loading on INIT) (loading -> running on WizardLoaded) (loading -> error on WizardLoadFailed) (loading -> loading on WizardSaved) (loading -> error on WizardSaveFailed) (running -> running on ADVANCE) (running -> completed on ADVANCE) (running -> running on RETREAT) (running -> cancelled on CANCEL) (completed -> completed on WizardSaved) (completed -> completed on WizardSaveFailed) (completed -> loading on RESTART) (cancelled -> loading on RESTART) (error -> loading on INIT))
  emits          : (ADVANCE RETREAT CANCEL RESTART WizardLoaded WizardLoadFailed WizardSaved WizardSaveFailed)
  config {
    cardLook       : string = "elevated" @label "Card look" @description "Layer 2 visual treatment for cards rendered by this atom." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    steps          : [StepSpec] = [{"description":"Basic information","fields":["title","description"],"icon":"file-text","key":"details","label":"Details"},{"description":"Configure preferences","fields":["category","priority"],"icon":"settings","key":"options","label":"Options"},{"description":"Confirm and submit","fields":["notes"],"icon":"check-circle","key":"review","label":"Review"}] @label "Steps" @description "Ordered steps with their label, icon, and form fields" @tier "domain"
    title          : string = "Wizard" @label "Wizard title" @description "Heading shown across all wizard steps" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-wizard.orb orbitals[0].traits[0])"
