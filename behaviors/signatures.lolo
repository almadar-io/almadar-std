;; From @almadar/std (behaviors/registry/ml/atoms/std-ml-exact-check.orb orbitals[0].traits[0])
trait std-ml-exact-check.traits.ExactCheckRun {
  alias          : MlExactCheck
  linkedEntity   : ExactCheck
  category       : lifecycle
  states         : (idle* checked)
  events         : (INIT CHECK RESET EXACT_MATCHED EXACT_UNMATCHED)
  transitions    : ((idle -> idle on INIT) (idle -> checked on CHECK) (checked -> checked on INIT) (checked -> idle on RESET))
  emits          : (EXACT_MATCHED EXACT_UNMATCHED)
  config {
    caseSensitive  : boolean = false @label "Case sensitive" @description "Compare candidate and key with case sensitivity; off lowercases both sides before comparing" @tier "policy"
    numericTolerance : float = 0 @label "Numeric tolerance" @description "Absolute tolerance applied when both candidate and key are numbers; 0 requires an exact numeric match" @tier "policy"
    trimWhitespace : boolean = true @label "Trim whitespace" @description "Strip leading and trailing whitespace from both sides before comparing" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-ml-exact-check.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ml/atoms/std-ml-infer.orb orbitals[0].traits[0])
trait std-ml-infer.traits.InferenceRun {
  alias          : MlInfer
  linkedEntity   : Inference
  category       : lifecycle
  states         : (idle* inferring resolved)
  events         : (INIT INFER INFERRED_RAW INFER_CALL_FAILED RESET INFERRED INFER_ABSTAINED)
  transitions    : ((idle -> idle on INIT) (idle -> inferring on INFER) (inferring -> resolved on INFERRED_RAW) (inferring -> resolved on INFER_CALL_FAILED) (resolved -> resolved on INIT) (resolved -> idle on RESET))
  emits          : (INFERRED_RAW INFER_CALL_FAILED INFERRED INFER_ABSTAINED)
  config {
    confidenceFloor : float = 0.7 @label "Confidence floor" @description "Minimum service-reported confidence required to answer; below this the atom abstains with reason low confidence" @tier "policy"
    model          : string = "" @label "Model reference" @description "hf:<id> for off-the-shelf weights, or a masar checkpoint id, forwarded to the ml service infer action" @tier "infra"
    outputContract : OutputContract = {"ranges":{}} @label "Output contract" @description "Declared shape and per-dimension ranges the model output must satisfy; a failing check abstains with reason contract violation. Omit shape to assert ranges only — an empty shape [] asserts a SCALAR output, it does not mean unconstrained" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-ml-infer.orb orbitals[0].traits[0])"
}

