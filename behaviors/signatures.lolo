    content        : string = "" @label "Content" @description "Markdown content summarising what the learner already knows" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-connection-block.orb orbitals[0].traits[0])"
