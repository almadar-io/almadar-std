;; From @almadar/std (behaviors/registry/ui/core/atoms/ui-select.orb orbitals[0].traits[0])
trait ui-select.traits.SelectRender {
  alias          : UiSelect
  linkedEntity   : SelectItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.action @config.onChange @config.onValueChange)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.action @config.onChange @config.onValueChange)
  config {
    action         : event = "ACTION" @label "Action" @description "Declarative event name for trait dispatch — emits `{ value }` on selection commit (same gestures as `onChange`)." @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes applied to the root element." @tier "presentation"
    clearable      : boolean @label "Clearable" @description "Show a clear button when a value is selected." @tier "presentation"
    error          : string @label "Error" @description "Error message" @tier "presentation"
    groups         : [SelectGroupsItem] = [] @label "Groups" @description "Grouped options — rendered as <optgroup> in native mode, sections in rich mode." @tier "presentation"
    multiple       : boolean @label "Multiple" @description "Allow selecting multiple values — activates the rich dropdown." @tier "presentation"
    onChange       : event = "CHANGE" @label "On Change" @description "onChange handler (native ChangeEvent) or declarative event key for trait dispatch" @tier "presentation"
    onValueChange  : event = "VALUE_CHANGE" @label "On Value Change" @description "Value-based change: a React callback (internal use) OR a declarative event key that emits `{ value }` on the bus (render-ui / lolo authoring). Mirrors the `onChange` handler|event convention so it's an event-emitting prop, not a bare callback." @tier "presentation"
    options        : [SelectOptionsItem] = [] @label "Options" @description "Select options (flat list)" @tier "presentation"
    placeholder    : string @label "Placeholder" @description "Placeholder text" @tier "presentation"
    searchable     : boolean @label "Searchable" @description "Show a search input inside the dropdown — activates the rich dropdown." @tier "presentation"
    value          : string @label "Value" @description "Current value (string for single, string[] for multiple)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/ui-select.orb orbitals[0].traits[0])"
}

