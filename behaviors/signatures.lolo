;; From @almadar/std (behaviors/registry/ui/learning/atoms/ui-biology-canvas.orb orbitals[0].traits[0])
trait ui-biology-canvas.traits.BiologyCanvasRender {
  alias          : UiBiologyCanvas
  linkedEntity   : BiologyCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT UPDATE @config.onShapeClick)
  transitions    : ((idle -> idle on INIT) (idle -> idle on UPDATE))
  emits          : (@config.onShapeClick)
  config {
    animate        : boolean = false @label "Animate" @description "2D only: continuous redraw loop. 3D motion is entity-state driven." @tier "presentation"
    backgroundColor : string @label "Background Color" @description "backgroundColor prop" @tier "presentation"
    bands          : [BiologyCanvasBandsItem] = [] @label "Bands" @description "Full-width horizontal background stripes, drawn first (2D only)." @synonyms "trophic levels, zones, layers" @tier "presentation"
    camera         : BiologyCanvasCamera @label "Camera" @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })." @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    compartments   : [BiologyCanvasCompartmentsItem] = [] @label "Compartments" @description "Organelle/membrane/cell-boundary ellipses (2D only)." @synonyms "membrane, organelle region, cell boundary" @tier "presentation"
    edges          : [BiologyCanvasEdgesItem] = [] @label "Edges" @description "edges prop" @tier "presentation"
    error          : BiologyCanvasError @label "Error" @description "error prop" @tier "presentation"
    height         : number = 400 @label "Height" @description "height prop" @tier "presentation"
    helix          : BiologyCanvasHelix @label "Helix" @description "A DNA double-helix ladder panel (2D only)." @synonyms "DNA ladder, replication fork, base pairs" @tier "presentation"
    helix3d        : BiologyCanvasHelix3d @label "Helix3d" @description "A 3D DNA double-helix ladder. 3D only." @tier "presentation"
    interactive    : boolean @label "Interactive" @description "2D: pointer interaction (click/hover). 3D: orbit camera controls." @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "isLoading prop" @tier "presentation"
    lighting       : BiologyCanvasLighting @label "Lighting" @description "3D only: scene light rig as data." @tier "presentation"
    mode           : string = "2d" @label "Mode" @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host." @tier "presentation" @values (2d 3d)
    nodes          : [BiologyCanvasNodesItem] = [] @label "Nodes" @description "nodes prop" @tier "presentation"
    onShapeClick   : event = "SHAPE_CLICK" @label "On Shape Click" @description "onShapeClick prop" @tier "presentation"
    post           : BiologyCanvasPost @label "Post" @description "3D only: post-processing stack (bloom/vignette)." @tier "presentation"
    readouts       : [BiologyCanvasReadoutsItem] = [] @label "Readouts" @description "Top-right status chip row, forwarded to LearningCanvas verbatim." @tier "presentation"
    shadows        : boolean @label "Shadows" @description "3D only: enable shadows. Omitted → the host default." @tier "presentation"
    shapes         : [BiologyCanvasShapesItem] = [] @label "Shapes" @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)." @tier "presentation"
    showGrid       : boolean @label "Show Grid" @description "3D only: show the ground grid (default off)." @tier "presentation"
    stages         : [BiologyCanvasStagesItem] = [] @label "Stages" @description "Phase/step chips (2D only)." @synonyms "phases, timeline, cycle" @tier "presentation"
    stageStyle     : string = "timeline" @label "Stage Style" @description "Layout for `stages`: a bottom timeline strip (default) or a radial ring." @tier "presentation" @values (timeline ring)
    title          : string @label "Title" @description "title prop" @tier "presentation"
    traces         : [BiologyCanvasTracesItem] = [] @label "Traces" @description "Inset sparkline panels, forwarded to LearningCanvas verbatim." @tier "presentation"
    width          : number = 600 @label "Width" @description "width prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/ui-biology-canvas.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/ui-box.orb orbitals[0].traits[0])
trait ui-box.traits.BoxRender {
  alias          : UiBox
  linkedEntity   : BoxItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.action @config.hoverEvent)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.action @config.hoverEvent)
  config {
    action         : event = "ACTION" @label "Action" @description "Declarative event name — emits UI:{action} via eventBus on click" @tier "presentation"
    actionPayload  : @payload(action) @label "Action Payload" @description "Payload to include with the action event" @tier "presentation"
    bg             : string = "transparent" @label "Bg" @description "Background color" @tier "presentation" @values (transparent primary secondary muted accent surface overlay)
    border         : boolean = false @label "Border" @description "Show border" @tier "presentation"
    children       : node @label "Children" @description "Children elements" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes applied to the root element." @tier "presentation"
    dir            : string @label "Dir" @description "Text direction for this subtree: 'ltr', 'rtl' (Arabic/Hebrew content) or 'auto'" @tier "presentation"
    display        : string = "block" @label "Display" @description "Display type" @tier "presentation" @values (block inline inline-block flex inline-flex grid)
    fullHeight     : boolean = false @label "Full Height" @description "Fill available height" @tier "presentation"
    fullWidth      : boolean = false @label "Full Width" @description "Fill available width" @tier "presentation"
    hoverEvent     : event = "HOVER" @label "Hover Event" @description "Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false } on mouseEnter/mouseLeave" @tier "presentation"
    margin         : string = "none" @label "Margin" @description "Margin on all sides" @tier "presentation" @values (none xs sm md lg xl 2xl auto)
    marginX        : string = "none" @label "Margin X" @description "Horizontal margin" @tier "presentation" @values (none xs sm md lg xl 2xl auto)
    marginY        : string = "none" @label "Margin Y" @description "Vertical margin" @tier "presentation" @values (none xs sm md lg xl 2xl auto)
    maxWidth       : string @label "Max Width" @description "Maximum width (CSS value, e.g., '550px', '80rem')" @tier "presentation"
    overflow       : string = "auto" @label "Overflow" @description "Overflow behavior" @tier "presentation" @values (auto hidden visible scroll)
    padding        : string = "none" @label "Padding" @description "Padding on all sides" @tier "presentation" @values (none xs sm md lg xl 2xl)
    paddingX       : string = "none" @label "Padding X" @description "Horizontal padding (overrides padding for x-axis)" @tier "presentation" @values (none xs sm md lg xl 2xl)
    paddingY       : string = "none" @label "Padding Y" @description "Vertical padding (overrides padding for y-axis)" @tier "presentation" @values (none xs sm md lg xl 2xl)
    position       : string = "relative" @label "Position" @description "Position" @tier "presentation" @values (relative absolute fixed sticky)
    rounded        : string = "none" @label "Rounded" @description "Border radius" @tier "presentation" @values (none sm md lg xl 2xl full)
    shadow         : string = "none" @label "Shadow" @description "Box shadow" @tier "presentation" @values (none sm md lg xl)
    tapReveal      : boolean = true @label "Tap Reveal" @description "When true (default), a touch/pen tap also fires `hoverEvent` (toggling hovered) so hover-only reveals work on touch." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/ui-box.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/ui-button.orb orbitals[0].traits[0])
trait ui-button.traits.ButtonRender {
