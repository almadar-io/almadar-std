;; From @almadar/std (behaviors/registry/ui/game/atoms/std-xp.orb orbitals[0].traits[0])
trait std-xp.traits.XpProgression {
  alias          : Xp
  linkedEntity   : XpState
  category       : lifecycle
  states         : (active*)
  events         : (INIT UNITS_CHANGED HEAL)
  transitions    : ((active -> active on INIT) (active -> active on UNITS_CHANGED))
  emits          : (HEAL)
  config {
    baseXpToNext   : number = 100 @label "Base XP To Next" @description "XP threshold for the first level-up." @tier "domain"
    healTeam       : string = "player" @label "Heal Team" @description "Team whose units are healed on level-up." @tier "domain"
    initialEnemies : number = 0 @label "Initial Enemies" @description "Enemy count at start; the kill baseline so the first kill grants xp correctly." @tier "domain"
    levelUpHeal    : number = 2 @label "Level-Up Heal" @description "Health restored to the healTeam's units on each level-up." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, enemy-count drops grant xp and trigger level-ups; toggle to freeze." @tier "domain"
    startXp        : number = 0 @label "Start XP" @description "XP set on INIT." @tier "domain"
    xpPerKill      : number = 25 @label "XP Per Kill" @description "XP awarded for each enemy removed since the last signal." @tier "domain"
    xpToNextIncrement : number = 50 @label "XP To Next Increment" @description "Amount the threshold rises by on each level-up." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-xp.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-zone-card.orb orbitals[0].traits[0])
trait std-zone-card.traits.ZoneCard {
  alias          : ZoneCard
  linkedEntity   : ZoneCardData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED CARD_DISMISS RESTART ZONE_CHANGED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on CARD_DISMISS) (active -> active on RESTART))
  emits          : (ZONE_CHANGED)
  config {
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED tracks the current zone and ages the card; toggle to freeze the card as-is." @tier "domain"
    ttlTicks       : number = 120 @label "TTL Ticks" @description "BODY_MOVED ticks the card stays up after a zone crossing (≈ 4s at 30 moves/s) before it clears itself." @tier "domain"
    zones          : [ZoneCardZone] = [] @label "Zones" @description "One row per world band: id, display name, the one-line concept, the zone's objective text, and the x-range (x0..x1) the band covers." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-zone-card.orb orbitals[0].traits[0])"
