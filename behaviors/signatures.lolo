  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-rating-review.orb orbitals[0].traits[2])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-rating-review.orb orbitals[0].traits[1])
trait std-rating-review.traits.RatingReviewSubmit {
  alias          : RatingReview
  linkedEntity   : ReviewView
  category       : interaction
  states         : (composing* submitting submitted error)
  events         : (INIT RATE_DRAFT SUBMIT_REVIEW CANCEL_REVIEW ReviewSaved ReviewSaveFailed RESTART)
  transitions    : ((composing -> composing on INIT) (composing -> composing on RATE_DRAFT) (composing -> submitting on SUBMIT_REVIEW) (composing -> composing on CANCEL_REVIEW) (submitting -> submitted on ReviewSaved) (submitting -> error on ReviewSaveFailed) (submitted -> composing on RESTART) (error -> composing on RESTART))
  emits          : (RATE_DRAFT SUBMIT_REVIEW CANCEL_REVIEW RESTART ReviewSaved ReviewSaveFailed)
  config {
    allowComment   : boolean = true @label "Allow comment" @description "Show a free-text comment field below the stars" @tier "presentation"
    allowPhotos    : boolean = false @label "Allow photos" @description "Let the user attach photos to the review" @tier "presentation"
    cancelLabel    : string = "Cancel" @label "Cancel button" @description "Label on the cancel button" @tier "presentation"
    cardLook       : string = "elevated" @label "Card look" @description "Visual style of the wrapper card. Layer 2 cardLook knob — render-ui references @config.cardLook on the compose card." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    maxStars       : number = 5 @label "Max stars" @description "Top of the rating scale (typically 5)" @tier "domain"
    submitEvent    : string = "SUBMIT_REVIEW" @label "Submit event" @description "Event emitted when the user submits the form" @tier "internal"
    submitLabel    : string = "Submit review" @label "Submit button" @description "Label on the primary submit button" @tier "presentation"
    title          : string = "Write a review" @label "Form title" @description "Heading shown above the review compose form" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-rating-review.orb orbitals[0].traits[1])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-record-detail.orb orbitals[0].traits[0])
trait std-record-detail.traits.RecordItemDetail {
  alias          : RecordDetail
  linkedEntity   : RecordItem
  category       : interaction
  states         : (idle* loading editing viewing error)
  events         : (INIT CONTENT_SAVED CONTENT_COMMITTED TITLE_COMMITTED OPEN_VIEW RecordItemLoaded RecordItemSlugLoaded RecordItemLoadFailed CONTENT_CHANGE DONE_EDITING CLOSE_VIEW EDIT_CONTENT RETRY EDIT DELETE)
  transitions    : ((idle -> loading on INIT) (idle -> loading on INIT) (idle -> loading on INIT) (idle -> idle on INIT) (idle -> idle on CONTENT_SAVED) (idle -> idle on CONTENT_COMMITTED) (idle -> idle on TITLE_COMMITTED) (idle -> loading on OPEN_VIEW) (loading -> loading on INIT) (loading -> loading on INIT) (loading -> editing on RecordItemLoaded) (loading -> viewing on RecordItemLoaded) (loading -> editing on RecordItemSlugLoaded) (loading -> viewing on RecordItemSlugLoaded) (loading -> error on RecordItemSlugLoaded) (loading -> error on RecordItemLoadFailed) (editing -> loading on INIT) (editing -> loading on INIT) (editing -> editing on CONTENT_CHANGE) (editing -> editing on TITLE_COMMITTED) (editing -> viewing on DONE_EDITING) (editing -> idle on CLOSE_VIEW) (viewing -> loading on INIT) (viewing -> loading on INIT) (viewing -> viewing on RecordItemLoaded) (viewing -> viewing on RecordItemSlugLoaded) (viewing -> error on RecordItemSlugLoaded) (viewing -> editing on EDIT_CONTENT) (viewing -> viewing on TITLE_COMMITTED) (viewing -> error on RecordItemLoadFailed) (viewing -> idle on CLOSE_VIEW) (error -> loading on INIT) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (RecordItemLoaded RecordItemSlugLoaded RecordItemLoadFailed EDIT DELETE CONTENT_SAVED CONTENT_COMMITTED TITLE_COMMITTED EDIT_CONTENT DONE_EDITING)
  config {
    actions        : [RecordAction] = [{"event":"EDIT","label":"Edit","variant":"secondary"},{"event":"DELETE","label":"Delete","variant":"danger"}] @label "What actions can users take on this record?" @description "Buttons on the panel header. One primary at most; the rest collapse past maxInlineActions." @synonyms "record actions, detail actions, panel buttons" @tier "presentation"
    allowEdit      : boolean = true @label "Allow editing the document?" @description "When false the document look is a pure read surface: no header Edit button, no click-to-edit body, no click-to-rename title. Hosts pass a role condition here so read-only viewers get the page without its authoring affordances; the entity's own access predicates stay the enforcement floor." @synonyms "read only document, viewer mode, can edit, editing allowed" @tier "policy"
    autosaveHint   : string = "Saves as you type" @label "Autosave hint" @description "Muted caption next to the Done button telling the author their work persists on its own." @tier "presentation"
    bodyContent    : render-ui = {"children":[{"actions":"@config.actions","entity":"@payload.data","fields":"@config.fields","initialData":"@payload.data","maxInlineActions":"@config.maxInlineActions","sections":"@config.sections","showActions":"@config.showActions","subtitle":"@entity.description","title":"@entity.name","type":"detail-panel"}],"direction":"vertical","gap":"lg","type":"stack"} @label "Body content tree" @description "Render-ui SExpr rendered after the record loads when detailLook = panel (the default). See slideOverBodyContent/pageBodyContent for the other looks; any may be overridden directly while inheriting the same trait, state machine, emits, and listens." @tier "internal"
    contentField   : string = "content" @label "Which field holds the document body?" @description "Name of the field on the loaded record that carries the rich-text HTML body the document look renders and edits (e.g. content, body, articleText)." @synonyms "body field, content field, document field" @tier "presentation"
    coverField     : string = "" @label "Which field is the cover image?" @description "Name of the image-typed field on the loaded record painted as the document look's full-bleed hero banner (e.g. coverImage, heroImage). Empty = no banner, the default." @synonyms "cover field, hero image field, banner field" @tier "presentation"
    detailLook     : string = "panel" @label "Detail look" @description "Visual treatment for the record surface. panel = an inline detail-panel in the page flow (bodyContent); slide-over = the same panel as a right-hand drawer over the list behind it (slideOverBodyContent); page = a full-width record page with roomier spacing (pageBodyContent); document = a wiki-page/note/article surface — big editable title over a rich-text body, no labelled field rows, click-to-edit with autosave (documentBodyContent / documentEditingContent). Selecting a look swaps which body tree renders after the record loads; any body may still be overridden directly at the call site." @synonyms "detail style, drawer, slide over, full page, document, wiki page, note, article" @tier "presentation" @values (panel slide-over page document)
    documentBodyContent : render-ui = {"actions":"@config.actions","className":"w-full","coverImage":"@entity.coverUrl","editEvent":["if","@config.allowEdit","EDIT_CONTENT",null],"editLabel":"@config.editLabel","icon":"@entity.iconName","id":"@entity.id","maxInlineActions":"@config.maxInlineActions","placeholder":"@config.placeholder","subtitle":"@entity.description","title":"@entity.name","titleCommitEvent":["if","@config.allowEdit","TITLE_COMMITTED",null],"type":"document-panel","value":"@entity.content"} @label "Document look body (reading)" @description "Render-ui SExpr for detailLook = document while reading: the pure writing surface — editable title with the rich-text body DIRECTLY beneath it, Edit and the actions menu tucked into the header corner. Metadata never sits between title and content; compose the sibling RecordItemDetails trait beside this one for the settings rail. Binds only @entity fields, never ?data, because it is also painted by arms whose payload is not the record." @tier "internal"
    documentEditingContent : render-ui = {"actions":"@config.actions","autosaveHint":"@config.autosaveHint","className":"w-full","contentChangeEvent":"CONTENT_CHANGE","coverImage":"@entity.coverUrl","doneEvent":"DONE_EDITING","doneLabel":"@config.doneLabel","editing":true,"icon":"@entity.iconName","id":"@entity.id","maxInlineActions":"@config.maxInlineActions","placeholder":"@config.placeholder","subtitle":"@entity.description","title":"@entity.name","titleCommitEvent":"TITLE_COMMITTED","type":"document-panel","value":"@entity.content"} @label "Document look body (editing)" @description "Render-ui SExpr for detailLook = document during an editing session: the same surface with the body live and the header corner showing the autosave hint + Done. Binds only @entity fields, never ?data." @tier "internal"
    doneLabel      : string = "Done" @label "Done button label" @description "Label of the button that ends the document editing session; work is already autosaved when it is pressed." @tier "presentation"
    editLabel      : string = "Edit" @label "Edit button label" @description "Label of the quiet button above the document body that starts an editing session (the body itself is also clickable)." @tier "presentation"
    fields         : [RecordFieldSpec] = [{"header":"Name","key":"name"},{"header":"Description","key":"description"},{"header":"Status","key":"status"},{"format":"date","header":"Created","key":"createdAt"}] @label "Which fields appear in the record panel?" @description "Each entry maps one entity field to a labelled row in the panel. Unlike a list row, a detail panel SHOULD label every field — the value stands alone here with no column header or repeated row position to name it." @synonyms "detail fields, record fields, panel fields, shown fields" @tier "presentation"
    iconField      : string = "" @label "Which field is the document icon?" @description "Name of the field on the loaded record whose icon name renders beside the document title (e.g. icon). Empty = no icon, the default." @synonyms "icon field, glyph field" @tier "presentation"
    include        : [string] = [] @label "Which relation fields to hydrate?" @description "Entity relation field names to hydrate on fetch, so panel fields can use dot-paths like owner.name. Empty = no hydration, the default." @synonyms "relation hydration, populate relations, joined fields" @tier "internal"
    maxInlineActions : number = 3 @label "How many actions before collapsing?" @description "Actions beyond this count collapse into a '⋯' overflow menu." @synonyms "inline actions limit, overflow threshold" @tier "presentation"
    openOn         : string = "init" @label "When does this surface load?" @description "init = a routed detail page; the record loads as soon as the page mounts (the default). event = an overlay that stays blank until a row-click OPEN_VIEW hands it an id, which is what a list-embedded slide-over needs — mounting an init-loading surface on a list page would fetch a record it has no id for." @synonyms "open on click, slide over, row click, blank until opened, list embedded" @tier "policy" @values (init event)
    pageBodyContent : render-ui = {"children":[{"actions":"@config.actions","entity":"@payload.data","fields":"@config.fields","initialData":"@payload.data","maxInlineActions":"@config.maxInlineActions","sections":"@config.sections","showActions":"@config.showActions","subtitle":"@entity.description","title":"@entity.name","type":"detail-panel"}],"className":"w-full max-w-4xl","direction":"vertical","gap":"lg","type":"stack"} @label "Page look body" @description "Render-ui SExpr rendered after the record loads when detailLook = page: a full record page, width-capped so field rows do not stretch past a readable measure (Almadar_UI_Beauty.md §3)." @tier "internal"
    placeholder    : string = "Start writing…" @label "Placeholder text" @description "Placeholder shown in the document body when it is empty." @tier "presentation"
    sections       : [RecordSection] = [] @label "How should the fields be grouped?" @description "Optional titled groups over `fields`, e.g. [{title: Contact, fields: [email, phone]}]. Group into sections of 3-5 once a record carries more than about seven fields — a flat list past that is the cognitive-load problem Almadar_UX.md §1.4 (Miller) describes. Empty = one ungrouped list, the default." @synonyms "field groups, grouped fields, panel sections, fieldsets" @tier "presentation"
    showActions    : boolean = true @label "Show the action buttons?" @description "Set false for a read-only record view; a panel with actions nothing listens to is a dead affordance." @synonyms "read only, hide actions, view only" @tier "presentation"
    slideOverBodyContent : render-ui = {"children":[{"actions":"@config.actions","entity":"@payload.data","fields":"@config.fields","initialData":"@payload.data","maxInlineActions":"@config.maxInlineActions","sections":"@config.sections","showActions":"@config.showActions","slideOver":true,"subtitle":"@entity.description","title":"@entity.name","type":"detail-panel"}],"direction":"vertical","gap":"none","type":"stack"} @label "Slide-over look body" @description "Render-ui SExpr rendered after the record loads when detailLook = slide-over: the same panel as a right-hand drawer, so the list behind stays in place. Use when the record is a glance, not a workspace." @tier "internal"
    subtitleField  : string = "description" @label "Which field is the subtitle?" @description "Name of the field shown under the title (e.g. company, category). Set to \"\" for no subtitle at all — the right choice for the document look, whose metadata lives in the properties strip, not a second line." @synonyms "subtitle field, secondary field, subheading, no subtitle" @tier "presentation"
    titleField     : string = "name" @label "Which field is the record's title?" @description "Name of the field on the loaded record shown as the panel title (e.g. contactName, subject, title)." @synonyms "title field, heading field, name field, label field" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-record-detail.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-record-detail.orb orbitals[0].traits[1])
trait std-record-detail.traits.RecordItemDetails {
  alias          : RecordDetail
  linkedEntity   : RecordItem
  category       : interaction
  states         : (idle* showing)
  events         : (INIT SHOW_DETAILS OPEN_DETAILS META_SAVED CLOSE META_CHANGE RELATION_OPEN)
  transitions    : ((idle -> idle on INIT) (idle -> idle on SHOW_DETAILS) (idle -> showing on OPEN_DETAILS) (idle -> idle on META_SAVED) (showing -> showing on SHOW_DETAILS) (showing -> showing on OPEN_DETAILS) (showing -> idle on CLOSE) (showing -> idle on INIT) (showing -> showing on META_CHANGE))
  emits          : (META_SAVED RELATION_OPEN)
  config {
    detailsContent : render-ui = {"entity":"@entity.loadedRow","fields":"@config.metaFields","relationEvent":"RELATION_OPEN","title":"@config.detailsTitle","type":"document-details"} @label "Details drawer content tree" @description "Render-ui SExpr painted into the drawer slot on OPEN_DETAILS; binds the row stashed by SHOW_DETAILS. Info-only by default — no metaCommitEvent, so every row displays rather than edits (editing rides the document's actions menu). Override at the call site to extend the panel or to opt into in-place commits via metaCommitEvent: META_CHANGE." @tier "internal"
    detailsTitle   : string = "Details" @label "Details drawer heading" @description "Heading of the settings card (e.g. Details, Page info, Document settings)." @tier "presentation"
    metaFields     : [MetaFieldSpec] = [] @label "Which metadata properties appear in the details drawer?" @description "The record's metadata shown as read-only INFO in the details drawer (Updated, address, status, …). Editing metadata is a normal action under the document's menu, not an inline affordance here." @synonyms "properties, metadata fields, document info, page info, front matter" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-record-detail.orb orbitals[0].traits[1])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-recurrence.orb orbitals[0].traits[0])
trait std-recurrence.traits.RecurrenceEditor {
  alias          : Recurrence
  linkedEntity   : RecurrenceView
  category       : interaction
  states         : (loading* viewing defining_rule awaiting_exception_decision cancelled error)
  events         : (INIT RecurrenceLoaded RecurrenceLoadFailed RecurrenceSaved RecurrenceSaveFailed EDIT_RULE OPEN_EXCEPTION CANCEL_SCHEDULE SAVE_RULE CANCEL_RULE SKIP_OCCURRENCE RESCHEDULE_OCCURRENCE CLOSE_EXCEPTION RESTART)
  transitions    : ((loading -> loading on INIT) (loading -> viewing on RecurrenceLoaded) (loading -> error on RecurrenceLoadFailed) (loading -> loading on RecurrenceSaved) (loading -> error on RecurrenceSaveFailed) (viewing -> defining_rule on EDIT_RULE) (viewing -> awaiting_exception_decision on OPEN_EXCEPTION) (viewing -> cancelled on CANCEL_SCHEDULE) (defining_rule -> loading on SAVE_RULE) (defining_rule -> loading on CANCEL_RULE) (awaiting_exception_decision -> loading on SKIP_OCCURRENCE) (awaiting_exception_decision -> loading on RESCHEDULE_OCCURRENCE) (awaiting_exception_decision -> loading on CLOSE_EXCEPTION) (cancelled -> loading on RESTART) (error -> loading on INIT))
  emits          : (EDIT_RULE SAVE_RULE CANCEL_RULE OPEN_EXCEPTION CLOSE_EXCEPTION SKIP_OCCURRENCE RESCHEDULE_OCCURRENCE CANCEL_SCHEDULE RESTART RecurrenceLoaded RecurrenceLoadFailed RecurrenceSaved RecurrenceSaveFailed)
  config {
    cardLook       : string = "elevated" @label "Card look" @description "Layer 2 visual treatment for cards rendered by this atom." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    formFields     : [string] = ["frequency","interval","startDate","endDate","endAfterCount"] @label "Rule fields" @description "Inputs shown in the recurrence-rule definition form" @tier "presentation"
    timelineLook   : string = "vertical-spacious" @label "Timeline look" @description "Layer 2 visual treatment for the timeline." @tier "presentation" @values (vertical-compact vertical-spacious horizontal swimlane)
    title          : string = "Schedule" @label "Section title" @description "Heading shown above the recurrence editor" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-recurrence.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-related.orb orbitals[0].traits[0])
trait std-related.traits.RelatedItemList {
  alias          : Related
  linkedEntity   : RelatedItem
  category       : interaction
  states         : (loading* loaded error)
  events         : (INIT SHOW_RELATED RelatedItemLoaded RelatedItemLoadFailed SELECT_RELATED RETRY)
  transitions    : ((loading -> loading on INIT) (loading -> loading on SHOW_RELATED) (loading -> loaded on RelatedItemLoaded) (loading -> error on RelatedItemLoadFailed) (loaded -> loading on INIT) (loaded -> loaded on SELECT_RELATED) (loaded -> loading on SHOW_RELATED) (error -> loading on INIT) (error -> loading on RETRY) (error -> loading on SHOW_RELATED))
  emits          : (RelatedItemLoaded RelatedItemLoadFailed SELECT_RELATED)
  config {
    labelField     : string = "name" @label "Which field labels each related row?" @description "Name of the field on the (rebound) related row rendered as the row label and carried as SELECT_RELATED's name — set it to `title` (etc.) whenever the bound entity labels rows differently. The rows are mapped through this at render time, because a trait-level `fields {}` rename is declaration-only on the runtime path and every populated row used to render a blank label." @tier "presentation"
    relationField  : string = "" @label "Relation field" @description "RelatedItem field compared against SHOW_RELATED's key to scope the fetch to one parent document; empty renders the full unfiltered collection (default)." @tier "domain"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    title          : string = "Related" @label "Section title" @description "Heading shown above the related list." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-related.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-reminder-scheduler.orb orbitals[0].traits[0])
trait std-reminder-scheduler.traits.ReminderScheduler {
  alias          : ReminderScheduler
  linkedEntity   : ReminderRunLog
  category       : lifecycle
  states         : (idle* scanning)
  events         : (INIT ScanRecordsLoaded ScanFailed ReminderStepped ReminderDue)
  transitions    : ((idle -> idle on INIT) (idle -> scanning on ScanRecordsLoaded) (idle -> idle on ScanRecordsLoaded) (idle -> idle on ScanRecordsLoaded) (idle -> idle on ScanFailed) (scanning -> scanning on ReminderStepped) (scanning -> scanning on ScanRecordsLoaded) (scanning -> idle on ScanRecordsLoaded) (scanning -> idle on ScanFailed))
  emits          : (ReminderDue ScanRecordsLoaded ScanFailed ReminderStepped)
  config {
    dateField      : string = "dueAt" @label "Which date field is the deadline?" @description "Field on the target entity holding the deadline (e.g. 'dueAt', 'startsAt'). Accepts a ms-epoch number or an ISO datetime string; both are coerced to ms-epoch for comparison." @synonyms "due date field, timestamp field, cutoff field, expiry field, when it's due" @tier "internal"
    direction      : string = "future" @label "Scan which side of now?" @description "'future' (default) matches records whose dateField is still ahead, up to offsetHours out — upcoming-deadline reminders. 'past' matches records whose dateField is at least offsetHours behind now — act-after-the-fact policies. The emitted event and the dedup marker are identical either way." @synonyms "direction, past due, overdue, after the deadline, look back, backward scan, past-window" @tier "infra" @values (future past)
    enabled        : boolean = false @label "Send deadline reminders" @description "Automatically remind about upcoming deadlines. Off by default." @synonyms "enable, turn on, activate, switch on, reminders, deadline reminders, due-date reminders, advance notice, heads up, nudge before due" @tier "infra"
    offsetHours    : number = 24 @label "How many hours before the deadline to remind?" @description "A reminder fires once the deadline is within this many hours of now." @synonyms "advance notice, lead time, heads up, early warning hours, how far ahead" @tier "infra"
    severity       : string = "info" @label "How urgent are the reminders?" @description "Severity passed to the notifier: info / warning / error." @synonyms "urgency level, priority, importance, alert level, how urgent" @tier "infra"
    targetEntity   : entity = "ReminderRunLog" @label "Target entity" @description "Entity to scan for upcoming deadlines (e.g. 'Task', 'ClassSession'). Defaults to the atom's own log so the standalone validates; rebind per composition. Typed `entity`, so a rename of the bound entity threads through to this value automatically." @synonyms "entity to monitor, entity to watch, record type, object type" @tier "internal"
    template       : string = "" @label "What should the reminder message say?" @description "Message body passed to the notifier." @synonyms "message text, reminder body, notification copy, alert message, what to say" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-reminder-scheduler.orb orbitals[0].traits[0])"
}

