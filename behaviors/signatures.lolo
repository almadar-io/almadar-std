;; From @almadar/std (behaviors/registry/ui/core/organisms/ui-subagent-trace-panel.orb orbitals[0].traits[0])
trait ui-subagent-trace-panel.traits.SubagentTracePanelRender {
  alias          : UiSubagentTracePanel
  linkedEntity   : SubagentTracePanelItem
  category       : interaction
  states         : (closed* open)
  events         : (INIT OPEN CLOSE @config.onClose)
  transitions    : ((closed -> closed on INIT) (closed -> open on OPEN) (open -> closed on CLOSE))
  emits          : (@config.onClose OPEN)
  config {
    activeFilters  : Map<string,string> = {} @label "Active Filters" @description "Active filters" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    coordinatorMessages : [SubagentTracePanelCoordinatorMessagesItem] = [] @label "Coordinator Messages" @description "Canonical Coordinator conversation — same shape live and on reload. When present, takes precedence over `coordinatorActivities` for the Coordinator section." @tier "presentation"
    disclosureLevel : number = 1 @label "Disclosure Level" @description "Drives density: 1-2 → compact, 3-4 → full activity embed (when mode='overlay')." @tier "presentation"
    error          : SubagentTracePanelError @label "Error" @description "Error state (UiError)" @tier "presentation"
    focusedOrbital : string @label "Focused Orbital" @description "Current canvas focus orbital — only used by overlay mode. Tab mode ignores this." @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    mode           : string = "overlay" @label "Mode" @description "Rendering mode. - `'overlay'` (default): floating side panel positioned absolutely over the canvas. Density follows `disclosureLevel` (compact L1/L2, rich L3+). The `open` flag actually hides the panel when false. - `'tab'`: full-width content for a dedicated 'trace' supplemental tab. Always renders rich (regardless of disclosure level), always visible (the `open` flag is ignored), and includes an empty state when no subagents are present so users see the surface even before generation starts." @tier "presentation" @values (overlay tab)
    onClose        : event = "CLOSE" @label "On Close" @description "Optional dismiss handler." @tier "presentation"
    open           : boolean = false @label "Open" @description "Whether the panel is visible. Typically auto-opens during generation in overlay mode." @tier "presentation"
    pageProp       : number @label "Page" @description "Current page number" @synonyms "page" @tier "presentation"
    pageSize       : number @label "Page Size" @description "Number of items per page" @tier "presentation"
    searchValue    : string @label "Search Value" @description "Current search query value" @tier "presentation"
    selectedIds    : [string] = [] @label "Selected Ids" @description "Currently selected item IDs" @tier "presentation"
    sortBy         : string @label "Sort By" @description "Current sort field" @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Current sort direction" @tier "presentation" @values (asc desc)
    subagents      : [SubagentTracePanelSubagentsItem] = [{"durationMs":1,"id":"Id","messages":[{"message":"Message","timestamp":1,"tool":"Tool"},{"message":"Message 2","timestamp":2,"tool":"Tool 2"}],"name":"Name","orbitalName":"Orbital Name","parentId":"Parent Id","role":"Role","status":"running","task":"Task","timeline":[]},{"durationMs":2,"id":"Id 2","messages":[{"message":"Message","timestamp":1,"tool":"Tool"},{"message":"Message 2","timestamp":2,"tool":"Tool 2"}],"name":"Name 2","orbitalName":"Orbital Name 2","parentId":"Parent Id 2","role":"Role 2","status":"complete","task":"Task 2","timeline":[]}] @label "Subagents" @description "All known subagents from the runner." @tier "presentation"
    totalCount     : number @label "Total Count" @description "Total number of items" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/organisms/ui-subagent-trace-panel.orb orbitals[0].traits[0])"
}

