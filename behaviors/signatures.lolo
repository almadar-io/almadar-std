    projection     : string = "flat" @label "Projection" @description "canvas-2d projection: flat or isometric." @tier "presentation"
    scale          : number = 1 @label "Scale" @description "Canvas render scale." @tier "presentation"
    showMinimap    : boolean = false @label "Show Minimap" @description "Whether the canvas draws a minimap." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
