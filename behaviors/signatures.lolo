;; From @almadar/std (behaviors/registry/ui/core/atoms/std-gallery.orb orbitals[0].traits[0])
trait std-gallery.traits.GalleryItemGallery {
  alias          : Gallery
  linkedEntity   : GalleryItem
  category       : interaction
  states         : (loading* browsing viewing error)
  events         : (INIT GalleryItemLoaded GalleryItemLoadFailed REFETCH_QUERY REFETCH_FILTER REFETCH_PAGE VIEW CLOSE)
  transitions    : ((loading -> loading on INIT) (loading -> browsing on GalleryItemLoaded) (loading -> error on GalleryItemLoadFailed) (browsing -> loading on INIT) (browsing -> browsing on REFETCH_QUERY) (browsing -> browsing on REFETCH_FILTER) (browsing -> browsing on REFETCH_PAGE) (browsing -> browsing on GalleryItemLoadFailed) (browsing -> browsing on GalleryItemLoaded) (browsing -> viewing on VIEW) (viewing -> loading on CLOSE) (error -> loading on INIT))
  emits          : (VIEW GalleryItemLoaded GalleryItemLoadFailed)
  config {
    bodySearch     : boolean = false @label "Show the gallery's own search box?" @description "Embeds a search box above the gallery grid. Set false (the default) when the page already provides a search affordance (a toolbar Search molecule), so the surface shows one search box instead of two." @synonyms "inline search, list search, built-in search, show search, duplicate search" @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the gallery?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the grid; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this gallery and routes `XFilter.FILTER -> REFETCH_FILTER` — that is the wired owner and remains the primary path. Use this knob only for a standalone gallery with no page-level filter affordance." @synonyms "filter bar, faceted filters, field filters, dropdowns" @tier "presentation"
    imageField     : string = "imageUrl" @label "Image field" @description "Entity field holding the image URL shown in the lightbox for the selected item" @synonyms "image url field, thumbnail field, src field" @tier "presentation"
    nameField      : string = "name" @label "Name field" @description "Entity field providing the lightbox alt text and caption for the selected item" @synonyms "title field, label field" @tier "presentation"
    pageSize       : number = 20 @label "How many images to fetch per page?" @description "Records fetched from the server when REFETCH_PAGE fires (a composed std-pagination driving this trait). The initial load and revisit fetches stay unpaged (whole collection), unchanged from before this knob existed." @synonyms "fetch limit, records per page, batch size, page limit" @tier "presentation"
    searchField    : string = "name" @label "Which column does the search box match against?" @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `name` column must set this to a real field (e.g. title, caption) or the search box can never match a row." @synonyms "search column, search on field, match field, search key" @tier "policy"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the gallery search box (e.g. 'Search photos…')." @synonyms "search hint, placeholder, search box text, search label" @tier "presentation"
    title          : string = "Gallery" @label "Section title" @description "Heading shown above the image gallery" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-gallery.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-game-clock.orb orbitals[0].traits[0])
trait std-game-clock.traits.GameClock {
  alias          : GameClock
  linkedEntity   : GameClockRecord
  category       : game-core
  states         : (running* paused)
  events         : (PAUSE RESUME GameClockTicked)
  transitions    : ((running -> paused on PAUSE) (running -> running on RESUME) (paused -> running on RESUME) (paused -> paused on PAUSE))
  emits          : (GameClockTicked)
  config {
    autoStart      : boolean = true @label "Auto-start clock" @description "When true the clock begins ticking immediately on INIT without waiting for a RESUME event." @synonyms "start on init, auto-run, begin immediately" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-game-clock.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-gantt-schedule.orb orbitals[0].traits[0])
trait std-gantt-schedule.traits.TaskGanttSchedule {
  alias          : GanttSchedule
  linkedEntity   : Task
  category       : interaction
  states         : (loading* chart error)
  events         : (INIT TaskLoaded TaskLoadFailed RETRY @config.onBarClick)
  transitions    : ((loading -> loading on INIT) (loading -> chart on TaskLoaded) (loading -> error on TaskLoadFailed) (chart -> loading on INIT) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (TaskLoaded TaskLoadFailed @config.onBarClick)
  config {
    dayWidth       : number = 28 @label "Day width" @description "Pixels per day on the time axis." @tier "presentation"
    durationField  : string = "" @label "Duration field" @description "Row column holding the task length in days, used when the row has no end value. Empty = bars always read endField." @synonyms "duration column, length field, days field" @tier "presentation"
    endField       : string = "end" @label "End field" @description "Row column holding the end timestamp each bar is placed to. When a row has no end, durationField (days) is used instead." @synonyms "end column, due field, finish field" @tier "presentation"
    groupField     : string = "" @label "Group field" @description "Row column rows are grouped under header rows by (e.g. team, project). Empty (default) = flat list, no group headers." @synonyms "group column, swimlane field, section field" @tier "presentation"
    include        : [string] = [] @label "Which relation fields to hydrate?" @description "Entity relation field names to hydrate on fetch, so field mappings can use dot-paths like assignee.name. Empty = no hydration, the default." @synonyms "relation hydration, populate relations, joined fields" @tier "internal"
    labelField     : string = "title" @label "Label field" @description "Row column holding the bar label. Rebound hosts point this at their own column (e.g. name, summary)." @synonyms "title field, label column, name field" @tier "presentation"
    links          : [GanttLinkSpec] = [] @label "Dependency links" @description "Dependency arrows between task ids ({ from, to }); the host derives them from its own relation field and passes them here." @synonyms "dependencies, dependency arrows, precedences" @tier "presentation"
    onBarClick     : event = "" @label "On bar click" @description "Event emitted when a bar is clicked: UI:{onBarClick} with { id } carrying the clicked row's id. Empty means bars are not clickable." @synonyms "bar click, task click, select task, open task" @tier "presentation"
    rangeEnd       : string = "" @label "Range end" @description "Last visible day (ISO date). Empty (default) = 2 days after the latest task end." @synonyms "window end, axis end, to date" @tier "presentation"
    rangeStart     : string = "" @label "Range start" @description "First visible day (ISO date). Empty (default) = 2 days before the earliest task." @synonyms "window start, axis start, from date" @tier "presentation"
    showToday      : boolean = true @label "Show today marker" @description "Paint the today marker line when today falls inside the visible range." @tier "presentation"
    startField     : string = "start" @label "Start field" @description "Row column holding the start timestamp each bar is placed from (e.g. startTime, startsAt, beginsAt)." @synonyms "start column, from field, begin field" @tier "presentation"
    statusField    : string = "status" @label "Status field" @description "Row column holding the status value that drives bar colour." @synonyms "status column, state field, stage field" @tier "presentation"
    title          : string = "Schedule" @label "Title" @description "Header text shown above the gantt chart." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-gantt-schedule.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-gate-lock.orb orbitals[0].traits[0])
trait std-gate-lock.traits.GateLock {
  alias          : GateLock
  linkedEntity   : GateLockData
  category       : lifecycle
  states         : (active*)
  events         : (INIT COLLECT BODY_MOVED SET_DOORS RESTART GATE_OPENED GATE_BLOCKED)
  transitions    : ((active -> active on INIT) (active -> active on COLLECT) (active -> active on BODY_MOVED) (active -> active on SET_DOORS) (active -> active on RESTART))
  emits          : (GATE_OPENED GATE_BLOCKED)
  config {
    doors          : [Door] = [] @label "Doors" @description "One row per gate: id, min-corner rect (x, y, width, height in world units) and the collected total that opens it. open/touching are stamped at runtime. Seeded onto the entity on INIT; the live set is entity.doors — SET_DOORS replaces it at runtime (boards that import doors), and RESTART re-arms the live set rather than re-reading config, so injected doors survive respawns." @tier "domain"
    reachMargin    : number = 0.6 @label "Reach Margin" @description "Extra world units padded around a closed door's rect when testing player contact (approximates the body's size)." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, COLLECT opens doors and closed doors report contact; toggle to freeze every door as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-gate-lock.orb orbitals[0].traits[0])"
}

