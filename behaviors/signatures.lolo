    edgeField      : string = "" @label "Edge field" @description "Field on each source entity holding its adjacency — an array of target ids" @tier "domain"
    nodeFeatures   : [string] = [] @label "Node features" @description "Entity fields carried onto each node alongside id" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-graph-builder.orb orbitals[0].traits[0])"
