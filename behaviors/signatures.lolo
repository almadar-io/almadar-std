    items          : [FxOverlayItemsItem] = [{"id":"e1","message":"Unit spawned","ttl":1,"type":"spawn","x":2,"y":2},{"id":"e2","message":"Attack landed","ttl":2,"type":"effect","x":3,"y":1}] @label "Items" @description "Live screen-space fx entries (the mechanic's fx list filtered to `space == 'screen'`); mount starts each item's animation, ttl decay unmounts it." @tier "presentation"
    tickMs         : number @label "Tick Ms" @description "The fx mechanic's decay tick period in ms; per-item animation duration = maxTtl × tickMs. Default 500." @tier "presentation"
