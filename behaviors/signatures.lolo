    extraAddons    : [HudButton] = [] @label "Extra Addon Buttons" @description "Board-specific action buttons appended after Pass Turn." @tier "presentation"
    extraStats     : [HudStat] = [] @label "Extra HUD Stats" @description "Board-specific HUD stats appended after Region/Turn/Gold." @tier "presentation"
    features       : [Feature] = [] @label "Features" @description "Board features — gold mines, portals, and other decorative/interactive map markers." @tier "domain"
    fontFamily     : string = "future" @label "Font Family" @description "game-shell fontFamily prop (theme chrome)." @tier "presentation"
