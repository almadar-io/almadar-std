    look           : string = "elevated" @label "Look" @description "Layer 2 visual treatment — orthogonal to the semantic variant." @tier "presentation" @values (elevated flat-bordered borderless-divider ticket invoice chip tile-image-first)
    padding        : string = "md" @label "Padding" @description "padding prop" @tier "presentation" @values (none sm md lg)
