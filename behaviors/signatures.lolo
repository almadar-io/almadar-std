    chartType      : string = "bar" @label "Chart Type" @description "Chart type (legacy alias for `look`)." @synonyms "chart style, graph type, bar chart, line chart, pie chart, area chart, donut chart, scatter plot, histogram" @tier "domain" @values (bar line pie area donut scatter histogram)
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    data           : [ChartDataItem] = [] @label "Data" @description "Simple single-series shorthand (bar/line/pie/area/donut/histogram)" @tier "presentation"
    drillEvent     : string @label "Drill Event" @description "Event name emitted as `UI:{drillEvent}` with `{ label, value, seriesLabel? }` on data-point click" @tier "presentation"
    error          : ChartError @label "Error" @description "Error state" @tier "presentation"
    height         : number = 200 @label "Height" @description "Chart height in px" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    look           : string = "bar-vertical" @label "Look" @description "Layer 2 visual treatment — drives the chart sub-renderer (bar / line / pie / etc.)." @synonyms "chart style, render style, visual treatment" @tier "presentation" @values (bar-vertical bar-horizontal line area pie donut scatter histogram)
    scatterData    : [ChartScatterDataItem] = [] @label "Scatter Data" @description "Raw {x,y} points for scatter" @tier "presentation"
    series         : [ChartSeriesItem] = [] @label "Series" @description "Multi-series data" @tier "presentation"
    showLegend     : boolean = true @label "Show Legend" @description "Show legend" @tier "presentation"
    showValues     : boolean = false @label "Show Values" @description "Show values on chart" @tier "presentation"
    stack          : string = "none" @label "Stack" @description "Stack mode for bar / area" @tier "presentation" @values (none stack normalize)
    subtitle       : string @label "Subtitle" @description "Chart subtitle / description" @tier "presentation"
    timeAxis       : boolean = false @label "Time Axis" @description "Format X-axis labels as time (ISO date in → 'Mar 2026'-style label out)" @tier "presentation"
    title          : string @label "Title" @description "Chart title" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-chart.orb orbitals[0].traits[0])"
