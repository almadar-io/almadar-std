;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-canvas.orb orbitals[0].traits[0])
trait ui-canvas.traits.CanvasRender {
  alias          : UiCanvas
  linkedEntity   : CanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.tileClickEvent @config.unitClickEvent @config.tileHoverEvent @config.tileLeaveEvent @config.featureClickEvent @config.onSelect @config.onMove)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.tileClickEvent @config.unitClickEvent @config.tileHoverEvent @config.tileLeaveEvent @config.featureClickEvent @config.onSelect @config.onMove)
  config {
    backgroundColor : string @label "Background Color" @description "Solid backdrop colour — 2D `side` fill and 3D scene clear colour." @tier "presentation"
    backgroundImage : asset @label "Background Image" @description "Backdrop image (2D iso/hex/flat/free/side)." @tier "presentation"
    camera         : CanvasCamera @label "Camera" @description "Neutral camera pose. Mapped to the underlying host's framing + zoom." @tier "presentation"
    children       : node @label "Children" @description "Declarative JSX drawable children (`<DrawShape .../>` composed in paint order). Forwarded to the 2D host, which collects them via drawable registry context." @tier "presentation"
    className      : string @label "Class Name" @description "--- Shared view config ---" @tier "presentation"
    drawables      : [node] = [] @label "Drawables" @description "Neutral drawable descriptors — the `draw-*` children. Routed to the host's painter." @tier "presentation"
    editable       : boolean @label "Editable" @description "--- Scene-edit mode (a game studio selecting/dragging drawables). Purely" @tier "presentation"
    featureClickEvent : event = "FEATURE_CLICK" @label "Feature Click Event" @description "Feature-click event (3D only)." @tier "presentation"
    fit            : boolean @label "Fit" @description "Auto-fit the board's grid extent to the viewport (2D grid layouts; default false — boards render at their authored `camera.zoom` scale)." @tier "presentation"
    fogOfWar       : [[boolean]] = [] @label "Fog Of War" @description "fogOfWar prop" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "isLoading prop" @tier "presentation"
    keyMap         : Map<string,string> = {"item":"INIT"} @label "Key Map" @description "Maps a keydown `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event (device-agnostic input), emitted as `UI:{event}`; keystrokes inside inputs/textareas never route." @tier "presentation"
    keyUpMap       : Map<string,string> = {"item":"INIT"} @label "Key Up Map" @description "Maps a keyup `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event, emitted as `UI:{event}`; keystrokes inside inputs/textareas never route." @tier "presentation"
    lighting       : CanvasLighting @label "Lighting" @description "3D scene light rig as data — ambient/directional/hemisphere/point lights + optional 'room' environment for PBR reflections. Omitted → the standard fixed rig." @tier "presentation"
    mode           : string = "2d" @label "Mode" @description "Painter: 2D sprite/shape/text raster, or 3D mesh. Default '2d'." @tier "presentation" @values (2d 3d)
    moveEvent      : event = "MOVE" @label "Move Event" @description "Declarative move event, `UI:{moveEvent} { id, x, y }` — fired once on drop." @tier "presentation"
    onMove         : event = "MOVE" @label "On Move" @description "Fired once per drag gesture, on drop — before `moveEvent`." @tier "presentation"
    onSelect       : event = "SELECT" @label "On Select" @description "Fired on a click that changes selection — before `selectEvent`." @tier "presentation"
    pixelsPerUnit  : number @label "Pixels Per Unit" @description "3D world-unit → pixel scale (perspective/side depth). 3D only." @tier "presentation"
    post           : CanvasPost @label "Post" @description "3D post-processing stack — bloom (emissive glow / neon) and vignette. Omitted → no post pass." @tier "presentation"
    projection     : string = "isometric" @label "Projection" @description "2D grid layout (2D mode only): isometric / hex / flat / free / side." @tier "presentation" @values (isometric hex flat free side)
    selectedId     : string @label "Selected Id" @description "The currently-selected drawable id (controlled); `null`/undefined = none." @tier "presentation"
    selectEvent    : event = "SELECT" @label "Select Event" @description "Declarative selection event, `UI:{selectEvent} { id }`." @tier "presentation"
    shadows        : boolean @label "Shadows" @description "shadows prop" @tier "presentation"
    showCoordinates : boolean @label "Show Coordinates" @description "showCoordinates prop" @tier "presentation"
    showGrid       : boolean @label "Show Grid" @description "3D-only presentation." @tier "presentation"
    showMinimap    : boolean @label "Show Minimap" @description "Minimap overlay (2D)." @tier "presentation"
    showTileInfo   : boolean @label "Show Tile Info" @description "showTileInfo prop" @tier "presentation"
    tileClickEvent : event = "TILE_CLICK" @label "Tile Click Event" @description "--- Shared interaction (LOLO-owned). The painter emitted at runtime depends on" @tier "presentation"
    tileHoverEvent : event = "TILE_HOVER" @label "Tile Hover Event" @description "tileHoverEvent prop" @tier "presentation"
    tileLeaveEvent : event = "TILE_LEAVE" @label "Tile Leave Event" @description "tileLeaveEvent prop" @tier "presentation"
    tileWidth      : number @label "Tile Width" @description "Native tile/cell width in source px of the board's asset (2D grid layouts; defaults to the detected atlas tile width, else 256)." @tier "presentation"
    unitClickEvent : event = "UNIT_CLICK" @label "Unit Click Event" @description "unitClickEvent prop" @tier "presentation"
    unitScale      : number @label "Unit Scale" @description "Unit draw-size multiplier (both painters)." @tier "presentation"
    worldHeight    : number @label "World Height" @description "worldHeight prop" @tier "presentation"
    worldWidth     : number @label "World Width" @description "Side/free world bounds (2D `side`) and 3D world extent." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-canvas.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-canvas-2d.orb orbitals[0].traits[0])
trait ui-canvas-2d.traits.Canvas2dRender {
  alias          : UiCanvas2d
  linkedEntity   : Canvas2dItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.tileClickEvent @config.unitClickEvent @config.tileHoverEvent @config.tileLeaveEvent @config.onSelect @config.onMove)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.tileClickEvent @config.unitClickEvent @config.tileHoverEvent @config.tileLeaveEvent @config.onSelect @config.onMove)
  config {
    backgroundImage : asset @label "Background Image" @description "Background image (tiled behind iso/hex/flat/free; cover-scaled for atlas slices). A bare URL string is accepted as shorthand for a standalone backdrop." @tier "presentation"
    bgColor        : string @label "Bg Color" @description "Solid backdrop colour — the base layer under any `backgroundImage`." @tier "presentation"
    camera         : string = "pan-zoom" @label "Camera" @description "--- View config (pure render) ---" @tier "presentation" @values (pan-zoom follow fixed)
    cameraPos      : Canvas2dCameraPos @label "Camera Pos" @description "Initial camera position in scene space (the neutral core `Camera.pos`). The host projects this to screen space and centers the viewport on it for the first render; ignored once the user pans or a follow target takes over." @tier "presentation"
    children       : node @label "Children" @description "Declarative JSX drawable children (`<DrawShape .../>` composed in paint order). When `drawables` is empty, each child registers its descriptor via the drawable registry context and the host paints them." @tier "presentation"
    className      : string @label "Class Name" @description "--- Closed-circuit ---" @tier "presentation"
    drawables      : [node] = [] @label "Drawables" @description "--- Scene ---" @tier "presentation"
    editable       : boolean = false @label "Editable" @description "--- Scene-edit mode (a game studio selecting/dragging drawables). Purely" @tier "presentation"
    error          : Canvas2dError @label "Error" @description "Error state" @tier "presentation"
    fit            : boolean = false @label "Fit" @description "Auto-fit the board's grid extent to the viewport (default false — boards render at their authored `scale` and overflow → pan). Opt in for whole-board-overview boards. User wheel/pinch zoom always wins after the initial fit." @tier "presentation"
    followTarget   : Canvas2dFollowTarget @label "Follow Target" @description "Follow-camera target in scene space (the neutral core `Camera.target`). When `camera:'follow'` the host lerps to keep this point centered." @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    keyMap         : Map<string,string> = {"item":"INIT"} @label "Key Map" @description "Maps a keydown `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event (device-agnostic input), emitted as `UI:{event}`; keystrokes inside inputs/textareas never route." @tier "presentation"
    keyUpMap       : Map<string,string> = {"item":"INIT"} @label "Key Up Map" @description "Maps a keyup `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event, emitted as `UI:{event}`; keystrokes inside inputs/textareas never route." @tier "presentation"
    moveEvent      : event = "MOVE" @label "Move Event" @description "Declarative move event, `UI:{moveEvent} { id, x, y }` — fired once on drop." @tier "presentation"
    onMove         : event = "MOVE" @label "On Move" @description "Fired once per drag gesture, on drop — before `moveEvent`." @tier "presentation"
    onSelect       : event = "SELECT" @label "On Select" @description "Fired on a click that changes selection — before `selectEvent`." @tier "presentation"
    projection     : string = "isometric" @label "Projection" @description "--- Projection ---" @tier "presentation" @values (isometric hex flat free side)
    scale          : number = 0.4 @label "Scale" @description "Render scale, legacy-squared semantics: on-screen cell ≈ `256 × scale²` px (the authored contract every board tuned its value for). Converted internally to the single camera zoom against the board's native tile width, so the cell pitch follows the asset while the on-screen size stays as authored. Ignored when `fit` is on; passed through raw for `free`/`side` (world-pixel-direct)." @tier "presentation"
    selectedId     : string @label "Selected Id" @description "The currently-selected drawable id (controlled); `null`/undefined = none." @tier "presentation"
    selectEvent    : event = "SELECT" @label "Select Event" @description "Declarative selection event, `UI:{selectEvent} { id }`." @tier "presentation"
    showMinimap    : boolean = true @label "Show Minimap" @description "Toggle minimap overlay." @tier "presentation"
    tileClickEvent : event = "TILE_CLICK" @label "Tile Click Event" @description "--- Declarative events back to LOLO ---" @tier "presentation"
    tileHoverEvent : event = "TILE_HOVER" @label "Tile Hover Event" @description "Emits UI:{tileHoverEvent} with the unprojected scene { x, y } on hover." @tier "presentation"
    tileLeaveEvent : event = "TILE_LEAVE" @label "Tile Leave Event" @description "Emits UI:{tileLeaveEvent} with {} on pointer leave." @tier "presentation"
    tileWidth      : number @label "Tile Width" @description "Native tile/cell width in source px for this board's asset (e.g. 16 for Kenney tiny-dungeon, ~128 for iso blocks). The grid cell pitch follows the asset, so tile textures map 1:1 (crisp, no stretch). Defaults to the detected atlas tile width, else 256." @tier "presentation"
    unitClickEvent : event = "UNIT_CLICK" @label "Unit Click Event" @description "Unit-click event. The neutral drawable host cannot resolve a click to a per-entity id (descriptors carry only a `ScenePos`, no id), so this prop is accepted but not yet emitted — the id-hit-test is a tracked fork (docs/Almadar_Std_Game_V2_PLAN.md)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-canvas-2d.orb orbitals[0].traits[0])"
}

