;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-control-grid.orb orbitals[0].traits[0])
trait ui-control-grid.traits.ControlGridRender {
  alias          : UiControlGrid
  linkedEntity   : ControlGridItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onAction @config.onDirection)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onAction @config.onDirection)
  config {
    actionEvent    : event = "ACTION" @label "Action Event" @description "Event-bus event emitted with `{ id, pressed }` on press/release" @tier "presentation"
    buttons        : [ControlGridButtonsItem] = [] @label "Buttons" @description "action buttons (kind='actions')" @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    directionAssets : Map<string,ControlGridDirectionAssetsValue> = {"item":{"animations":["static"],"aspect":"1:1","category":"item","dimension":"2d","name":"item","role":"item","style":"pixel","thumbnailUrl":"","url":"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/features/sword.png"}} @label "Direction Assets" @description "Per-direction sprite assets for kind='dpad' buttons (e.g. Kenny arrow PNGs). Falls back to arrow emoji." @tier "presentation"
    directionEvent : event = "DIRECTION" @label "Direction Event" @description "Event-bus event emitted with `{ direction, pressed }` (kind='dpad')" @tier "presentation"
    directionEvents : Map<string,string> = {"item":"INIT"} @label "Direction Events" @description "Per-direction PRESS → the board's SEMANTIC event (kind='dpad'), e.g. `{ left: 'LEFT', right: 'RIGHT', up: 'JUMP' }`. Lets the d-pad emit the SAME intent events as the keyboard so the FSM stays device-agnostic." @tier "presentation"
    directionReleaseEvents : Map<string,string> = {"item":"INIT"} @label "Direction Release Events" @description "Per-direction RELEASE → semantic event, e.g. `{ left: 'STOP', right: 'STOP' }`. Omit a direction to ignore its release." @tier "presentation"
    disabled       : boolean @label "Disabled" @description "disabled prop" @tier "presentation"
    includeDiagonals : boolean = false @label "Include Diagonals" @description "Whether to include diagonal buttons (kind='dpad')" @tier "presentation"
    kind           : string = "dpad" @label "Kind" @description "kind prop" @tier "presentation" @values (dpad actions)
    layout         : string = "horizontal" @label "Layout" @description "Layout for kind='actions'" @tier "presentation" @values (horizontal vertical diamond)
    onAction       : event = "ACTION" @label "On Action" @description "Called when a button/direction is pressed or released" @tier "presentation"
    onDirection    : event = "DIRECTION" @label "On Direction" @description "Called when a direction is pressed or released (kind='dpad' convenience overload)" @tier "presentation"
    size           : string = "md" @label "Size" @description "size prop" @tier "presentation" @values (sm md lg)
    visibility     : string = "auto" @label "Visibility" @description "'auto' (default) renders only on coarse-pointer (touch) devices; 'always' renders everywhere." @tier "presentation" @values (auto always)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-control-grid.orb orbitals[0].traits[0])"
}

