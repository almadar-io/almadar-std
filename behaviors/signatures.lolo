    curveKind      : string = "power" @label "Curve Kind" @description "Curve family the two parameters drive: power (y = A·xᴮ), linear (y = A + B·x), or sine (y = A·sin(B·x))." @synonyms "curve family, power law, linear function, sine wave, function type" @tier "domain"
    gridStep       : number = 1 @label "Grid Step" @tier "presentation"
