;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-gantt.orb orbitals[0].traits[0])
trait ui-gantt.traits.GanttRender {
  alias          : UiGantt
  linkedEntity   : GanttItem
  category       : interaction
  states         : (idle*)
  events         : (INIT GanttLoaded @config.barClickEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on GanttLoaded))
  emits          : (@config.barClickEvent GanttLoaded)
  config {
    barClickEvent  : event = "BAR_CLICK" @label "Bar Click Event" @description "Event emitted when a bar is clicked: UI:{barClickEvent} with { id }" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    dayWidth       : number = 28 @label "Day Width" @description "Pixels per day on the axis (default 28)" @tier "presentation"
    durationField  : string @label "Duration Field" @description "Row field holding the task length in days, used when the row has no end." @tier "presentation"
    endField       : string = "end" @label "End Field" @description "Row field holding the end timestamp (ISO or epoch). Defaults to `end`. When absent, `durationField` (days) is used instead." @tier "presentation"
    error          : GanttError @label "Error" @description "Error state" @tier "presentation"
    groupField     : string @label "Group Field" @description "Row field rows are grouped under header rows by. Empty (default) = flat list." @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    links          : [GanttLinksItem] = [] @label "Links" @description "Dependency arrows between task ids" @tier "presentation"
    rangeEnd       : date = "2024-01-01" @label "Range End" @description "Last visible day (ISO or Date). Defaults to 2 days after the latest task end." @tier "presentation"
    rangeStart     : date = "2024-01-01" @label "Range Start" @description "First visible day (ISO or Date). Defaults to 2 days before the earliest task." @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    showToday      : boolean = true @label "Show Today" @description "Paint the today marker line when today falls inside the range (default true)." @tier "presentation"
    startField     : string = "start" @label "Start Field" @description "Row field holding the start timestamp (ISO or epoch). Defaults to `start`." @tier "presentation"
    statusField    : string = "status" @label "Status Field" @description "Row field holding the bar status (drives bar colour). Defaults to `status`." @tier "presentation"
    titleField     : string = "title" @label "Title Field" @description "Row field holding the bar label. Defaults to `title`." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-gantt.orb orbitals[0].traits[0])"
}

