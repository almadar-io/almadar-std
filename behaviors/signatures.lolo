;; From @almadar/std (behaviors/registry/infra/organisms/std-status-lifecycle-control.orb orbitals[0].traits[0])
trait std-status-lifecycle-control.traits.StatusLifecycleControl {
  alias          : StatusLifecycleControl
  linkedEntity   : StatusControlItem
  category       : interaction
  states         : (idle*)
  events         : (INIT TRANSITION_REQUESTED ChangeStatusRequested)
  transitions    : ((idle -> idle on INIT) (idle -> idle on TRANSITION_REQUESTED))
  emits          : (ChangeStatusRequested TRANSITION_REQUESTED)
  config {
    currentStatus  : string = "" @label "Current status" @description "The record's current status, shown as a badge and used to compute which transitions are legal. Forward the host entity's status field at the embed site (e.g. currentStatus={@entity.status})." @tier "internal"
    recordId       : string = "" @label "Record id" @description "id of the record whose status this control changes. Forward the host entity's id at the embed site (e.g. recordId={@entity.id})." @tier "internal"
    transitions    : [TransitionSpec] = [] @label "Which status moves are allowed?" @description "Legal transitions as { from, to, event, label } — pass the SAME table given to the paired StatusMachine trait's config.transitions so the rendered buttons never offer a move the atom would reject." @synonyms "edges, allowed moves, status flow, workflow transitions" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/organisms/std-status-lifecycle-control.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/organisms/std-survival-board-3d.orb orbitals[0].traits[0])
trait std-survival-board-3d.traits.SurvivalIntent {
  alias          : SurvivalBoard3d
  linkedEntity   : GameState
  category       : interaction
  states         : (playing*)
  events         : (INIT UNIT_CLICK TILE_CLICK CANCEL BUILD_CAMP_PRESS PLAY_AGAIN MOVE WANDER RESTART BUILD_CAMP)
  transitions    : ((playing -> playing on INIT) (playing -> playing on UNIT_CLICK) (playing -> playing on TILE_CLICK) (playing -> playing on CANCEL) (playing -> playing on BUILD_CAMP_PRESS) (playing -> playing on PLAY_AGAIN))
  emits          : (MOVE WANDER RESTART TILE_CLICK UNIT_CLICK CANCEL BUILD_CAMP_PRESS BUILD_CAMP)
  config {
    assetManifest  : AssetManifest = {"effects":{},"features":{},"terrains":{},"units":{}} @label "Asset Manifest" @description "Per-role model manifest resolving tile/unit/feature models by terrain/category key." @tier "presentation"
    bgColor        : string = "#0a0f1a" @label "Bg Color" @description "Canvas background color." @tier "presentation"
    cameraMode     : string = "top-down" @label "Camera Mode" @description "3D canvas camera mode." @tier "presentation"
    campStone      : number = 4 @label "Camp Stone" @description "Stone required before the Build Camp action is allowed." @tier "domain"
    campWood       : number = 4 @label "Camp Wood" @description "Wood required before the Build Camp action is allowed." @tier "domain"
    extraStats     : [HudStat] = [] @label "Extra Stats" @description "Board-specific HUD stats appended after the standard set." @tier "presentation"
    fxPresets      : [FxPreset] = [{"color":"#84a98c","color2":"#6b4226","count":5,"shape":"spark","size":0.45,"type":"pickup","vy":-0.2}] @label "Fx Presets" @description "This board's effect vocabulary — one look/recipe row per fx type its mechanics emit; unknown types fall back to a neutral spark." @tier "presentation"
    gridHeight     : number = 16 @label "Grid Height" @description "Grid row count (matches HeroAuthority.gridHeight)." @tier "presentation"
    gridWidth      : number = 16 @label "Grid Width" @description "Grid column count (matches HeroAuthority.gridWidth)." @tier "presentation"
    movementRange  : number = 3 @label "Movement Range" @description "Max manhattan distance the hero may step per move." @tier "domain"
    scale          : number = 0.45 @label "Scale" @description "Canvas render scale." @tier "presentation"
    unitScale      : number = 1 @label "Unit Scale" @description "Unit draw-size multiplier." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/organisms/std-survival-board-3d.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/organisms/std-tactics-board-2d.orb orbitals[0].traits[0])
trait std-tactics-board-2d.traits.PlayerIntent {
  alias          : TacticsBoard2d
  linkedEntity   : GameState
  category       : interaction
  states         : (playing*)
  events         : (INIT UNIT_CLICK TILE_CLICK CANCEL END_TURN MOVE ATTACK AI_TURN @config.extraAddonEvent)
  transitions    : ((playing -> playing on INIT) (playing -> playing on UNIT_CLICK) (playing -> playing on UNIT_CLICK) (playing -> playing on UNIT_CLICK) (playing -> playing on TILE_CLICK) (playing -> playing on CANCEL) (playing -> playing on END_TURN) (playing -> playing on MOVE) (playing -> playing on ATTACK))
  emits          : (MOVE ATTACK AI_TURN TILE_CLICK UNIT_CLICK CANCEL @config.extraAddonEvent)
  config {
    assetManifest  : AssetManifest = {"effects":{},"features":{},"terrains":{},"units":{}} @label "Asset Manifest" @description "Terrain/unit/feature/effect sprite manifest." @tier "presentation"
    attackRange    : number = 1 @label "Attack Range" @description "Max manhattan distance a selected unit may strike an enemy." @tier "domain"
    backgroundAsset : Asset = {} @label "Background Asset" @description "Game-shell background panel sprite (theme chrome)." @tier "presentation"
    extraAddonEvent : event = "" @label "Extra Addon Event" @description "Event name used by an `extraAddons` button's `action` literal (e.g. \"PRODUCE\"). Set this to the same value so the trait's own event set declares it." @tier "domain"
    extraAddons    : [HudButton] = [] @label "Extra Addon Buttons" @description "Board-specific action buttons appended after End Turn/Cancel (e.g. Produce). The action names events listened by composed mechanic atoms." @tier "presentation"
    extraStats     : [HudStat] = [] @label "Extra HUD Stats" @description "Board-specific HUD stats appended after Result/Phase/Turn/Score (e.g. production, resources). Values may bind @entity fields owned by composed mechanic atoms." @tier "presentation"
    features       : [Feature] = [] @label "Features" @description "Decorative environment features drawn on the board." @tier "presentation"
    fxPresets      : [FxPreset] = [{"color":"#ff6b6b","color2":"#ffb347","count":6,"glow":0.12,"shape":"spark","size":0.45,"type":"hit","vy":-0.3}] @label "Fx Presets" @description "This board's effect vocabulary — one look/recipe row per fx type its mechanics emit; unknown types fall back to a neutral spark." @tier "presentation"
    gridHeight     : number = 2 @label "Grid Height" @description "Grid row count (matches TacticsAuthority.gridHeight)." @tier "presentation"
    gridWidth      : number = 2 @label "Grid Width" @description "Grid column count (matches TacticsAuthority.gridWidth)." @tier "presentation"
    hudBackgroundAsset : Asset = {} @label "HUD Background Asset" @description "HUD panel background sprite (theme chrome)." @tier "presentation"
    movementRange  : number = 4 @label "Movement Range" @description "Max manhattan distance a selected unit may move." @tier "domain"
    projection     : string = "flat" @label "Projection" @description "canvas-2d projection: flat or isometric." @tier "presentation"
    scale          : number = 1 @label "Scale" @description "Canvas render scale." @tier "presentation"
    showMinimap    : boolean = false @label "Show Minimap" @description "Whether the canvas draws a minimap." @tier "presentation"
    vectorUnitScale : number = 1 @label "Vector Unit Scale" @description "Uniform scale applied to vector (svgAssetArt draw-group) units." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/organisms/std-tactics-board-2d.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/organisms/std-tactics-board-3d.orb orbitals[0].traits[0])
trait std-tactics-board-3d.traits.PlayerIntent {
  alias          : TacticsBoard3d
  linkedEntity   : GameState
  category       : interaction
  states         : (playing*)
  events         : (INIT UNIT_CLICK TILE_CLICK CANCEL END_TURN MOVE ATTACK AI_TURN)
  transitions    : ((playing -> playing on INIT) (playing -> playing on UNIT_CLICK) (playing -> playing on UNIT_CLICK) (playing -> playing on UNIT_CLICK) (playing -> playing on TILE_CLICK) (playing -> playing on CANCEL) (playing -> playing on END_TURN))
  emits          : (MOVE ATTACK AI_TURN TILE_CLICK UNIT_CLICK CANCEL)
  config {
    assetManifest  : AssetManifest = {"effects":{},"features":{},"terrains":{},"units":{}} @label "Asset Manifest" @description "Terrain/unit/feature/effect model manifest." @tier "presentation"
    bgColor        : string = "#05070f" @label "Bg Color" @description "Canvas background color." @tier "presentation"
    cameraMode     : string = "isometric" @label "Camera Mode" @description "3D canvas camera mode." @tier "presentation"
    features       : [Feature] = [] @label "Features" @description "Decorative environment features drawn on the board." @tier "presentation"
    fxPresets      : [FxPreset] = [{"color":"#ff5252","color2":"#7a1010","count":6,"glow":0.12,"gravity":0.6,"shape":"spark","size":0.5,"type":"hit","vy":-0.2}] @label "Fx Presets" @description "This board's effect vocabulary — one look/recipe row per fx type its mechanics emit; unknown types fall back to a neutral spark." @tier "presentation"
    gridHeight     : number = 2 @label "Grid Height" @description "Grid row count (matches TacticsAuthority.gridHeight)." @tier "presentation"
    gridWidth      : number = 2 @label "Grid Width" @description "Grid column count (matches TacticsAuthority.gridWidth)." @tier "presentation"
    lighting       : Lighting3D = {} @label "Lighting" @description "3D scene light rig as data — ambient/directional/hemisphere/points + environment ('room' | 'none') for PBR reflections. Empty → the standard fixed rig." @tier "presentation"
    meshUnitScale  : number = 1 @label "Mesh Unit Scale" @description "Uniform scale applied to volumetric (meshAssetArt draw-group) units." @tier "presentation"
    movementRange  : number = 4 @label "Movement Range" @description "Max manhattan distance a selected unit may move." @tier "domain"
    post           : Post3D = {} @label "Post Effects" @description "3D post-processing stack — bloom and vignette. Empty → no post pass." @tier "presentation"
    scale          : number = 0.45 @label "Scale" @description "Canvas render scale." @tier "presentation"
    unitScale      : number = 1 @label "Unit Scale" @description "Unit draw-size multiplier." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/organisms/std-tactics-board-3d.orb orbitals[0].traits[0])"
}

