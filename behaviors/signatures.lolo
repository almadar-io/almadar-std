    variant        : string = "star8" @label "Variant" @description "Which geometric tile design" @tier "presentation" @values (star8 star6 khatam star10 star12 rosette-double rosette-filled seigaiha greek-key celtic-knot kolam arch arabesque-vine arabesque-net)
