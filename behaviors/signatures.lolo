;; From @almadar/std (behaviors/registry/ui/core/atoms/std-selection.orb orbitals[0].traits[0])
trait std-selection.traits.SelectableItemSelection {
  alias          : Selection
  linkedEntity   : SelectableItem
  category       : interaction
  states         : (loading* idle selecting selected error)
  events         : (INIT SelectableItemLoaded SelectableItemLoadFailed REFETCH_QUERY REFETCH_FILTER REFETCH_PAGE SELECT CONFIRM_SELECTION CLEAR RETRY)
  transitions    : ((loading -> loading on INIT) (loading -> idle on SelectableItemLoaded) (loading -> error on SelectableItemLoadFailed) (idle -> idle on REFETCH_QUERY) (idle -> idle on REFETCH_FILTER) (idle -> idle on REFETCH_PAGE) (idle -> idle on SelectableItemLoadFailed) (idle -> idle on SelectableItemLoaded) (idle -> selecting on SELECT) (selecting -> selected on CONFIRM_SELECTION) (selecting -> loading on CLEAR) (selected -> loading on CLEAR) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (SelectableItemLoaded SelectableItemLoadFailed)
  config {
    bodySearch     : boolean = false @label "Show the pick-list's own search box?" @description "Embeds a search box above the pick-list. Set true only when the page has no other search affordance (e.g. no page-level std-search), so the surface shows one search box instead of two. False is the default — this atom has never had a search box (0 consumers today)." @synonyms "inline search, list search, built-in search, show search" @tier "presentation"
    displayPageSize : number = 20 @label "How many candidates to show at once?" @description "Rows visible per page before the data-grid's own pagination control appears — 20 matches the pick-list density sweet spot (Miller's law, 10-25 rows)." @synonyms "visible rows, items per page, display limit, show per page" @tier "presentation"
    filterBarLook  : string = "toolbar" @label "Filter bar look" @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty." @synonyms "filter bar style, facet style, chips, pills" @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    filters        : [FilterSpec] = [] @label "Which filters should appear above the pick-list?" @description "Dropdown filter facets by field, rendered as an embedded filter bar above the rows; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, the right setting whenever the page already composes std-filter beside this list and routes XFilter.FILTER -> REFETCH_FILTER — that is the wired owner and remains the primary path. Use this knob only for a standalone pick-list with no page-level filter affordance." @synonyms "filter bar, faceted filters, field filters, dropdowns" @tier "presentation"
    pageSize       : number = 20 @label "How many candidates per page when paging?" @description "Records fetched from the server per REFETCH_PAGE request. The initial load and search/filter refetches remain unpaginated (load every candidate) unless a consumer wires REFETCH_PAGE, so the default pick-list surface is unchanged. Safe to page: this atom's selection is a single transient id (never an accumulated array), so no already-picked item can be stranded on another page." @synonyms "fetch limit, records per page, page limit" @tier "presentation"
    searchField    : string = "name" @label "Which column does the search box match against?" @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `name` column must set this to a real field (e.g. title, label) or the search box can never match a row." @synonyms "search column, search on field, match field, search key" @tier "policy"
    searchPlaceholder : string = "Search…" @label "Search box placeholder text" @description "Hint text inside the pick-list search box." @synonyms "search hint, placeholder, search box text" @tier "presentation"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-selection.orb orbitals[0].traits[0])"
}

