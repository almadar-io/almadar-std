}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/std-learn-perturb.orb orbitals[0].traits[0])
trait std-learn-perturb.traits.PerturbSim {
  alias          : LearnPerturb
  linkedEntity   : PerturbScene
  category       : interaction
  states         : (idle*)
  events         : (INIT MODE_SELECTED RUN PAUSE RESET SET_POINT SET_RATE SHOCK RUN_TOGGLED SIM_RESET SETPOINT_CHANGED RATE_CHANGED SHOCK_APPLIED)
  transitions    : ((idle -> idle on INIT) (idle -> idle on MODE_SELECTED) (idle -> idle on RUN) (idle -> idle on PAUSE) (idle -> idle on RESET) (idle -> idle on SET_POINT) (idle -> idle on SET_RATE) (idle -> idle on SHOCK))
  emits          : (RUN_TOGGLED SIM_RESET SETPOINT_CHANGED RATE_CHANGED SHOCK_APPLIED)
  config {
    autoRun        : boolean = true @label "Auto Run" @description "Whether the simulation starts running immediately on load." @tier "domain"
    duration       : number = 20 @label "Duration" @description "Simulated seconds before the run stops automatically." @tier "domain"
    gridStep       : number = 2 @label "Grid Step" @tier "presentation"
    height         : number = 360 @label "Height" @tier "presentation"
    matchMode      : string = "" @label "Match Mode" @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT." @tier "presentation"
    rateDefault    : number = 0.8 @label "Rate Default" @tier "domain"
    rateLabel      : string = "Recovery rate" @label "Rate Label" @description "Display name of the relaxation-rate slider." @tier "domain"
    rateMax        : number = 3 @label "Rate Max" @tier "domain"
    rateMin        : number = 0.05 @label "Rate Min" @tier "domain"
    rateStep       : number = 0.05 @label "Rate Step" @tier "presentation"
    setpointColor  : string = "#94a3b8" @label "Setpoint Color" @tier "presentation"
    setpointDefault : number = 37 @label "Setpoint Default" @tier "domain"
    setpointLabel  : string = "Setpoint" @label "Setpoint Label" @description "Display name of the equilibrium target." @tier "domain"
    setpointMax    : number = 44 @label "Setpoint Max" @tier "domain"
    setpointMin    : number = 30 @label "Setpoint Min" @tier "domain"
    setpointStep   : number = 0.5 @label "Setpoint Step" @tier "presentation"
    shockDownLabel : string = "− Shock down" @label "Shock Down Label" @tier "presentation"
    shockSize      : number = 4 @label "Shock Size" @description "How far a shock button knocks the quantity from its current value." @tier "domain"
    shockUpLabel   : string = "+ Shock up" @label "Shock Up Label" @tier "presentation"
    taskText       : string = "Run the system, shock it off its setpoint, and watch it recover — then move the setpoint mid-run." @label "Task Text" @description "One-sentence statement of what to explore." @tier "domain"
    title          : string = "Equilibrium & Shock" @label "Title" @description "Title shown above the simulation." @tier "presentation"
    valueColor     : string = "#dc2626" @label "Value Color" @tier "presentation"
    valueLabel     : string = "Temperature" @label "Value Label" @description "Display name of the regulated quantity." @tier "domain"
    valueMax       : number = 46 @label "Value Max" @description "Upper bound of the chart's y axis." @tier "presentation"
    valueMin       : number = 28 @label "Value Min" @description "Lower bound of the chart's y axis." @tier "presentation"
    valueStart     : number = 37 @label "Value Start" @tier "domain"
    width          : number = 600 @label "Width" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/std-learn-perturb.orb orbitals[0].traits[0])"
