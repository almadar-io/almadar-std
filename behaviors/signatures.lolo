  transitions    : ((loading -> loading on INIT) (loading -> browsing on StoredFileLoaded) (loading -> error on StoredFileLoadFailed) (browsing -> loading on INIT) (browsing -> viewing_single on OPEN_FILE) (browsing -> loading on REORDER) (browsing -> loading on ARCHIVE_FILE) (viewing_single -> loading on CLOSE_VIEW) (viewing_single -> loading on DOWNLOAD_FILE) (viewing_single -> loading on ARCHIVE_FILE) (error -> loading on INIT))
  emits          : (OPEN_FILE CLOSE_VIEW DOWNLOAD_FILE ARCHIVE_FILE REORDER StoredFileLoaded StoredFileLoadFailed)
  config {
    detailActions  : [ItemAction] = [{"event":"DOWNLOAD_FILE","label":"Download","variant":"primary"},{"event":"ARCHIVE_FILE","label":"Archive","variant":"danger"}] @label "Detail actions" @description "Buttons shown on the opened row's detail" @tier "presentation"
    fields         : [FieldSpec] = [{"label":"Name","name":"name","variant":"caption"},{"label":"Folder","name":"folder","variant":"caption"},{"label":"Type","name":"mimeType","variant":"badge"},{"label":"Size","name":"sizeBytes","variant":"caption"},{"label":"Uploaded","name":"uploadedAt","variant":"caption"}] @label "Columns to show" @description "Each column maps to one field on the linked entity" @tier "presentation"
    headerIcon     : string = "folder" @label "Header icon" @description "Icon shown beside the section title and in the detail header" @tier "presentation"
    itemActions    : [ItemAction] = [{"event":"OPEN_FILE","icon":"arrow-right","label":"Open","variant":"primary"},{"event":"ARCHIVE_FILE","label":"Archive","variant":"danger"}] @label "Row actions" @description "Buttons on each row" @tier "presentation"
    reorderable    : boolean = false @label "Reorderable rows" @description "Allow drag-reordering of rows (emits REORDER). On for ordered trees (e.g. wiki page nav)." @tier "presentation"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    title          : string = "Files" @label "Section title" @description "Heading shown above the browser" @tier "presentation"
    tree           : [TreeNode] = [{"children":[{"name":"Active.pdf","path":"Active.pdf","type":"file"},{"name":"Archived.pdf","path":"Archived.pdf","type":"file"}],"name":"Contracts","path":"Contracts","type":"dir"},{"children":[{"name":"HR.docx","path":"Policies/HR.docx","type":"file"},{"name":"Security.md","path":"Policies/Security.md","type":"file"}],"name":"Policies","path":"Policies","type":"dir"},{"children":[{"name":"Invoice.docx","path":"Templates/Invoice.docx","type":"file"},{"name":"NDA.pdf","path":"Templates/NDA.pdf","type":"file"}],"name":"Templates","path":"Templates","type":"dir"}] @label "Folder tree" @description "Hierarchical nav tree shown above the table" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
