operator - {
  category       : arithmetic
  module         : core
  arity          : (1 .. 2)
  params         : ((a number) (b? number))
  returns        : number
  side-effects?  : false
  desc           : "Subtract or negate"
  example        : "[\"-\", 5, 2] // => 3; [\"-\", 5] // => -5"
  source         : ["@almadar/std/modules/core.ts: -" "@almadar/std (STD_OPERATORS): -"]
}

