    dismissible    : boolean = true @label "Dismissible" @description "Show dismiss button" @tier "presentation"
    duration       : number = 5000 @label "Duration" @description "Auto-dismiss duration in milliseconds (0 = no auto-dismiss)" @tier "presentation"
    message        : string = "" @label "Message" @description "Toast message" @tier "presentation"
    onAction       : event = "ACTION" @label "On Action" @description "Action button click handler" @tier "presentation"
    onDismiss      : event = "DISMISS" @label "On Dismiss" @description "Callback when toast is dismissed" @tier "presentation"
    title          : string @label "Title" @description "Toast title (optional)" @tier "presentation"
    variant        : string = "info" @label "Variant" @description "Toast variant" @tier "presentation" @values (success error info warning)
  }
