    currentPage    : number @label "Current Page" @description "Current page (for multi-page documents)" @tier "presentation"
    documents      : [DocumentViewerDocumentsItem] = [] @label "Documents" @description "Multiple documents (tabbed view)" @tier "presentation"
    documentType   : string = "pdf" @label "Document Type" @description "Document type" @tier "presentation" @values (pdf text html markdown)
    error          : DocumentViewerError @label "Error" @description "Error state" @tier "presentation"
    height         : scalar = 600 @label "Height" @description "Viewer height" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    showDownload   : boolean = false @label "Show Download" @description "Show download button" @tier "presentation"
    showPrint      : boolean = false @label "Show Print" @description "Show print button" @tier "presentation"
    showToolbar    : boolean = true @label "Show Toolbar" @description "Show toolbar" @tier "presentation"
    src            : asset = "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png" @label "Src" @description "Document URL (for PDF/external documents)" @tier "presentation"
    title          : string @label "Title" @description "Document title" @tier "presentation"
    totalPages     : number @label "Total Pages" @description "Total pages" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-document-viewer.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-drawer.orb orbitals[0].traits[0])
trait ui-drawer.traits.DrawerRender {
  alias          : UiDrawer
  linkedEntity   : DrawerItem
  category       : interaction
  states         : (closed* open)
  events         : (INIT OPEN CLOSE @config.onClose)
  transitions    : ((closed -> closed on INIT) (closed -> open on OPEN) (open -> closed on CLOSE))
  emits          : (@config.onClose OPEN)
  config {
    children       : node @label "Children" @description "Drawer content (can be empty if using slot content)" @tier "presentation"
    className      : string @label "Class Name" @description "Additional class name" @tier "presentation"
    closeEvent     : event = "CLOSE" @label "Close Event" @description "Declarative close event — emits UI:{closeEvent} via eventBus when drawer should close" @tier "presentation"
    closeOnEscape  : boolean = true @label "Close On Escape" @description "Close on escape key" @tier "presentation"
    closeOnOverlayClick : boolean = true @label "Close On Overlay Click" @description "Close on overlay click" @tier "presentation"
    footer         : node @label "Footer" @description "Footer content" @tier "presentation"
    isOpen         : boolean = true @label "Is Open" @description "Whether the drawer is open (defaults to true when rendered by slot wrapper)" @tier "presentation"
    onClose        : event = "CLOSE" @label "On Close" @description "Callback when drawer should close (injected by slot wrapper)" @tier "presentation"
    position       : string = "right" @label "Position" @description "Position (left or right)" @tier "presentation" @values (left right)
    showCloseButton : boolean = true @label "Show Close Button" @description "Show close button" @tier "presentation"
    title          : node @label "Title" @description "Drawer title (text or any node, e.g. a brand logo + name)." @tier "presentation"
    width          : string = "md" @label "Width" @description "Width (CSS value or preset size)" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-drawer.orb orbitals[0].traits[0])"
}

