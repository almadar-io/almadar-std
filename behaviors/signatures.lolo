    segments       : number = 5 @label "Segments" @description "Number of segments (for segmented variant)" @tier "presentation"
    showValue      : boolean = true @label "Show Value" @description "Show value text" @tier "presentation"
    size           : string = "md" @label "Size" @description "Size (for radial variant)" @tier "presentation" @values (sm md lg)
    thresholds     : [MeterThresholdsItem] = [] @label "Thresholds" @description "Color thresholds" @tier "presentation"
    unit           : string @label "Unit" @description "Unit suffix (e.g., '%', 'MB', 'credits')" @tier "presentation"
    value          : number = 1 @label "Value" @description "Current value" @tier "presentation"
    variant        : string = "linear" @label "Variant" @description "Display variant" @tier "presentation" @values (linear radial segmented)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-meter.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-modal.orb orbitals[0].traits[0])
trait ui-modal.traits.ModalRender {
  alias          : UiModal
  linkedEntity   : ModalItem
  category       : interaction
  states         : (closed* open)
  events         : (INIT OPEN CLOSE @config.onClose @config.onExited)
  transitions    : ((closed -> closed on INIT) (closed -> open on OPEN) (open -> closed on CLOSE))
  emits          : (@config.onClose @config.onExited OPEN)
  config {
    children       : node @label "Children" @description "Modal content (can be empty if using slot content)" @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    closeEvent     : event = "CLOSE" @label "Close Event" @description "Declarative close event — emits UI:{closeEvent} via eventBus when modal should close" @tier "presentation"
    closeOnEscape  : boolean = true @label "Close On Escape" @description "closeOnEscape prop" @tier "presentation"
    closeOnOverlayClick : boolean = true @label "Close On Overlay Click" @description "closeOnOverlayClick prop" @tier "presentation"
    footer         : node @label "Footer" @description "footer prop" @tier "presentation"
    isOpen         : boolean = true @label "Is Open" @description "Whether the modal is open (defaults to true when rendered by slot wrapper)" @tier "presentation"
    look           : string = "centered-card" @label "Look" @description "Layer 2 visual treatment — orthogonal to the semantic variant." @tier "presentation" @values (centered-card top-sheet side-drawer full-screen)
    onClose        : event = "CLOSE" @label "On Close" @description "Callback when modal should close (injected by slot wrapper)" @tier "presentation"
    onExited       : event = "EXITED" @label "On Exited" @description "Fires after the exit animation completes (the modal is about to unmount)." @tier "presentation"
    showCloseButton : boolean = true @label "Show Close Button" @description "showCloseButton prop" @tier "presentation"
    size           : string = "md" @label "Size" @description "size prop" @tier "presentation" @values (sm md lg xl full)
    swipeDownToClose : boolean = true @label "Swipe Down To Close" @description "Enable swipe-down-to-close on mobile bottom sheet (default: true)" @tier "presentation"
    title          : string @label "Title" @description "title prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-modal.orb orbitals[0].traits[0])"
}

