;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-draw-fx-layer.orb orbitals[0].traits[0])
trait ui-draw-fx-layer.traits.DrawFxLayerRender {
  alias          : UiDrawFxLayer
  linkedEntity   : DrawFxLayerItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    art            : Map<string,Map<string,[node]>> = {"item":{}} @label "Art" @description "Vector art per fx type (an asset-art map: type → anim-state → drawables); a type's `idle` state wins over sprites/procedural." @tier "presentation"
    items          : [DrawFxLayerItemsItem] = [{"id":"e1","message":"Unit spawned","ttl":1,"type":"spawn","x":2,"y":2},{"id":"e2","message":"Attack landed","ttl":2,"type":"effect","x":3,"y":1}] @label "Items" @description "The live fx entries — the mechanic's `@entity.fx` list passed whole; `space: 'screen'` entries are skipped (the overlay owns those)." @tier "presentation"
    presets        : [DrawFxLayerPresetsItem] = [] @label "Presets" @description "Consumer-declared effect vocabulary — one row per fx `type` (look + recipe). Unknown types fall back to a neutral spark burst." @tier "presentation"
    sprites        : Map<string,DrawFxLayerSpritesValue> = {"item":{"animations":["static"],"aspect":"1:1","category":"item","dimension":"2d","name":"item","role":"item","style":"pixel","thumbnailUrl":"","url":"https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/features/sword.png"}} @label "Sprites" @description "Sprite asset per fx type (an asset-manifest effects map) — used when no vector art matches." @tier "presentation"
    textColor      : string @label "Text Color" @description "Floating-message text color when an item declares none. Default `#ffe066`." @tier "presentation"
    tickMs         : number @label "Tick Ms" @description "The fx mechanic's decay tick period in ms; lifetime = maxTtl × tickMs. Default 500." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-draw-fx-layer.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-draw-group.orb orbitals[0].traits[0])
trait ui-draw-group.traits.DrawGroupRender {
  alias          : UiDrawGroup
  linkedEntity   : DrawGroupItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    animation      : DrawGroupAnimation @label "Animation" @description "Keyframe animation over the group TRANSFORM tracks (`offsetX/Y/Z` in cells, `rotateX/Y/Z` in radians, `scale`; the 2D painter also honors `opacity`) — children inherit it, so nested animated groups form a joint chain. Material tracks belong on leaf meshes." @tier "presentation"
    bone           : string @label "Bone" @description "Skeleton bone name. A named group is addressable by a `draw-mesh` `skin` block (smooth skinning): the skinned mesh deforms with this group's animated transform. Names resolve within the nearest enclosing `skeleton: true` group (falling back to the canvas), so multiple instances of one rig never collide. Distinct from `id` (the hit-test handle)." @tier "presentation"
    clip           : string @label "Clip" @description "Clip the group's items to an SVG path (`d` syntax) in world units relative to the group origin — masked reveals, meters, portraits." @tier "presentation"
    items          : [node] = [] @label "Items" @description "The grouped drawables, painted through the normal dispatch." @tier "presentation"
    opacity        : number @label "Opacity" @description "0..1 opacity." @tier "presentation"
    position       : DrawGroupPosition = {"x":1,"y":1,"z":1} @label "Position" @description "Logical scene position; the projector maps it to pixels / world." @tier "presentation"
    rotate         : number @label "Rotate" @description "Rotation in radians (painter units)." @tier "presentation"
    rotation       : [number] = [] @label "Rotation" @description "Euler rotation `[x, y, z]` in radians (world axes) — per-axis joint rotation for the 3D backend; a group placed at a joint with children authored joint-local IS a bone. The 2D painter applies only the in-plane `z` component, after `rotate`." @tier "presentation"
    scale          : number @label "Scale" @description "Uniform scale applied to the whole group." @tier "presentation"
    skeleton       : boolean @label "Skeleton" @description "Marks this group as a skeleton SCOPE: `bone` names and `skin` bindings in its subtree resolve against each other only — one scope per rig instance." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-draw-group.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-draw-mesh.orb orbitals[0].traits[0])
trait ui-draw-mesh.traits.DrawMeshRender {
  alias          : UiDrawMesh
  linkedEntity   : DrawMeshItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    animation      : DrawMeshAnimation @label "Animation" @description "Keyframe animation over transform/material tracks; the 3D host runs it per frame." @tier "presentation"
    castShadow     : boolean @label "Cast Shadow" @description "castShadow prop" @tier "presentation"
    depth          : number @label "Depth" @description "Box/plane Z extent in cells (default `width`)." @tier "presentation"
    faces          : [[number]] = [] @label "Faces" @description "`polyhedron` only: triangle index triples into `vertices`, wound counter-clockwise seen from OUTSIDE in the scene frame." @tier "presentation"
    height         : number @label "Height" @description "Box Y (height) extent / capsule-cylinder-cone length in cells (default 1)." @tier "presentation"
    material       : DrawMeshMaterial @label "Material" @description "material prop" @tier "presentation"
    opacity        : number @label "Opacity" @description "0..1 opacity; multiplies the material and enclosing group opacity." @tier "presentation"
    outline        : DrawMeshOutline @label "Outline" @description "outline prop" @tier "presentation"
    pivot          : string = "bottom" @label "Pivot" @description "`bottom` (default) rests the mesh on its position's ground plane; `center` centers it there. For `polyhedron`, `bottom` lifts by −min(z) and `center` applies no offset — the vertices are authoritative." @tier "presentation" @values (bottom center)
    position       : DrawMeshPosition = {"x":1,"y":1,"z":1} @label "Position" @description "Logical scene position; `z` is height in cells (projected to world Y)." @tier "presentation"
    radius         : number @label "Radius" @description "Sphere/capsule/cone/torus/circle radius in cells (default 0.4)." @tier "presentation"
    radiusBottom   : number @label "Radius Bottom" @description "Cylinder bottom radius (default `radius`)." @tier "presentation"
    radiusTop      : number @label "Radius Top" @description "Cylinder top radius (default `radius`)." @tier "presentation"
    receiveShadow  : boolean @label "Receive Shadow" @description "receiveShadow prop" @tier "presentation"
    rotation       : [number] = [] @label "Rotation" @description "Euler rotation `[x, y, z]` in radians." @tier "presentation"
    segments       : number @label "Segments" @description "Curved-surface tessellation, clamped 3..64 (default 24). 4–8 + `flatShading` = low-poly." @tier "presentation"
    shape          : string = "box" @label "Shape" @description "shape prop" @tier "presentation" @values (box sphere capsule cylinder cone torus plane circle polyhedron)
    skin           : DrawMeshSkin @label "Skin" @description "`polyhedron` only: smooth-skinning weights binding the vertices to named bone groups. Vertices must then be authored in BIND POSE model space; the bones' animated transforms deform them." @tier "presentation"
    tube           : number @label "Tube" @description "Torus tube radius in cells (default `radius` / 3)." @tier "presentation"
    uvs            : [[number]] = [] @label "Uvs" @description "`polyhedron` only: per-vertex `[u, v]` texture coordinates parallel to `vertices`, glTF convention (`v` grows DOWN from the image's top-left). Pairs with `material.map`." @tier "presentation"
    vertices       : [[number]] = [] @label "Vertices" @description "`polyhedron` only: raw vertices as scene-frame `[x, y, z]` triples in cells, `z` = up." @tier "presentation"
    width          : number @label "Width" @description "Box/plane X extent in cells (default 1)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-draw-mesh.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/ui-draw-shape.orb orbitals[0].traits[0])
trait ui-draw-shape.traits.DrawShapeRender {
  alias          : UiDrawShape
  linkedEntity   : DrawShapeItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    anchor         : string = "top-left" @label "Anchor" @description "How the shape aligns to its projected position. Default varies by `shape`." @tier "presentation" @values (top-left ground center)
    animation      : DrawShapeAnimation @label "Animation" @description "Keyframe animation over this shape's props; the host runs a paint clock while present." @tier "presentation"
    blendMode      : string = "source-over" @label "Blend Mode" @description "Composite/blend mode for this shape's draws (`lighter`, `multiply`, `screen`, …)." @tier "presentation" @values (source-over lighter multiply screen overlay darken lighten color-dodge color-burn hard-light soft-light difference exclusion hue saturation color luminosity source-atop destination-over destination-out xor)
    blur           : number @label "Blur" @description "Gaussian blur in painter-px. Expensive — forces an intermediate raster; use sparingly." @tier "presentation"
    d              : string @label "D" @description "SVG path data in world units relative to the cell's projected top-left — same coordinate convention as `points`." @tier "presentation"
    fill           : string @label "Fill" @description "fill prop" @tier "presentation"
    fillPattern    : DrawShapeFillPattern @label "Fill Pattern" @description "Repeating texture painted over the fill (grain / tiling image)." @tier "presentation"
    gradient       : DrawShapeGradient @label "Gradient" @description "Gradient fill in world units; overrides `fill` when present." @tier "presentation"
    height         : number @label "Height" @description "Rect height in world units (fractions of `projector.tileWidth`)." @tier "presentation"
    offsetX        : number @label "Offset X" @description "Fine nudge in world units — applies to every shape kind except `cell` (rect/ellipse from their anchor point; poly/path from the projected top-left)." @tier "presentation"
    offsetY        : number @label "Offset Y" @description "offsetY prop" @tier "presentation"
    opacity        : number @label "Opacity" @description "0..1 opacity." @tier "presentation"
    pivot          : DrawShapePivot @label "Pivot" @description "Rotation pivot in world units relative to the cell's projected top-left; default `{x:0.5, y:0.5}` (cell center)." @tier "presentation"
    points         : [DrawShapePointsItem] = [] @label "Points" @description "Poly vertices as world-unit offsets relative to the cell's projected top-left." @tier "presentation"
    position       : DrawShapePosition = {"x":1,"y":1,"z":1} @label "Position" @description "Logical scene position; the projector maps it to pixels / world." @tier "presentation"
    radiusX        : number @label "Radius X" @description "Ellipse horizontal radius in world units (fractions of `projector.tileWidth`)." @tier "presentation"
    radiusY        : number @label "Radius Y" @description "Ellipse vertical radius in world units; omitted → `radiusX` (a circle)." @tier "presentation"
    rotate         : number @label "Rotate" @description "Rotation in radians (painter units, same as `draw-group`), about `pivot`." @tier "presentation"
    shadow         : DrawShapeShadow @label "Shadow" @description "Soft glow / drop-shadow behind the shape; `blur` in world units." @tier "presentation"
    shape          : string = "cell" @label "Shape" @description "shape prop" @tier "presentation" @values (cell rect ellipse poly path)
    stroke         : string @label "Stroke" @description "stroke prop" @tier "presentation"
    strokeDash     : [number] = [] @label "Stroke Dash" @description "Dash pattern in painter-px (constant under group scale, like `strokeWidth`)." @tier "presentation"
    strokeDashOffset : number @label "Stroke Dash Offset" @description "Dash phase offset in painter-px; animatable (marching ants)." @tier "presentation"
    strokeGradient : DrawShapeStrokeGradient @label "Stroke Gradient" @description "Gradient stroke in world units; overrides `stroke` when present." @tier "presentation"
    strokeWidth    : number @label "Stroke Width" @description "strokeWidth prop" @tier "presentation"
    width          : number @label "Width" @description "Rect width in world units (fractions of `projector.tileWidth`)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-draw-shape.orb orbitals[0].traits[0])"
}

