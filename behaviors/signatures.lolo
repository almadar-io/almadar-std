;; From @almadar/std (behaviors/registry/ui/core/atoms/std-notification-panel.orb orbitals[0].traits[0])
trait std-notification-panel.traits.NotificationPanel {
  alias          : NotificationPanel
  linkedEntity   : NotificationRecord
  category       : interaction
  states         : (idle*)
  events         : (INIT OPEN CLOSE)
  transitions    : ((idle -> idle on INIT) (idle -> idle on OPEN) (idle -> idle on CLOSE))
  emits          : (CLOSE)
  config {
    closeLabel     : string = "Close" @label "What should the dismiss button say?" @description "Label on the button that closes the overlay." @synonyms "dismiss label, close label, back label" @tier "presentation"
    emptyMessage   : string = "You're all caught up." @label "What shows when there are no notifications?" @description "Message rendered in place of the list when there is nothing to show." @synonyms "empty state, no notifications, nothing here" @tier "presentation"
    icon           : string = "bell" @label "Which icon appears in the overlay header?" @description "Lucide icon name shown next to the overlay title." @synonyms "header icon, bell icon, panel icon" @tier "presentation"
    notifications  : [NotificationSpec] = [] @label "Which notifications should the overlay list?" @description "Items rendered in the overlay — the same list std-app-layout takes for its bell dropdown." @synonyms "alerts, messages, notices, notification items" @tier "presentation"
    panelSlot      : slot = "modal" @label "Render slot" @description "UI slot the overlay renders into. Never `main` — repainting main is what strands the viewer." @tier "internal"
    title          : string = "Notifications" @label "What should the overlay heading say?" @description "Heading displayed at the top of the notification overlay." @synonyms "panel title, overlay heading, notifications title" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-notification-panel.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-notification-preferences.orb orbitals[0].traits[1])
trait std-notification-preferences.traits.PreferenceGate {
  alias          : NotificationPreferences
  linkedEntity   : GateView
  category       : lifecycle
  states         : (idle*)
  events         : (CHECK_PREFERENCE PREFERENCE_ROWS_LOADED PREFERENCE_CHECK_FAILED PREFERENCE_RESOLVED)
  transitions    : ((idle -> idle on CHECK_PREFERENCE) (idle -> idle on PREFERENCE_ROWS_LOADED) (idle -> idle on PREFERENCE_CHECK_FAILED))
  emits          : (PREFERENCE_RESOLVED PREFERENCE_ROWS_LOADED PREFERENCE_CHECK_FAILED)
  config {
    eventKey       : string = "" @label "Event key" @description "Stable key naming the event this gate checks preferences for (e.g. 'BudgetThreshold' — the std-finance-tracker NotifyOnEventListener convention). A blank CHECK_PREFERENCE payload eventKey falls back to this value. Preference rows whose eventKey is blank apply to every event." @synonyms "preference key, event name, subscription key, notification topic" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-notification-preferences.orb orbitals[0].traits[1])"
}

