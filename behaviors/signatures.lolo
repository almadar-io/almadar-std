  emits          : (PLANNED COMPOSED DISPATCHED RABIT_DONE)
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/agent/organisms/std-agent-rabit.orb orbitals[0].traits[0])"
