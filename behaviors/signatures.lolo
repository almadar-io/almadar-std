form trait-inline {
  syntax  : "trait Name -> Entity [category] { state s { EVENT -> target (effect ...) } }"
  desc    : "Inline trait declaration with state machine, transitions, and effects. The [category] tag is one of interaction|integration|lifecycle|game-core etc."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/trait.rs (parse_trait)"
}

form trait-reference {
  syntax  : "trait Name = Alias.traits.Upstream -> Entity { events { OPEN: ADD_ITEM } on ADD_ITEM { (fetch X) } emitsScope external }"
  desc    : "Reference an imported trait with overrides. The events block renames atom event keys; each on EVENT block replaces a transition's effects list. States, transitions, and event-key topology come from the upstream atom."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/trait.rs (parse_trait_reference)"
}

form state {
  syntax  : "state name [for 30s] { EVENT -> target (effect1) (effect2) }"
  desc    : "One state in an inline trait. The optional [for duration] tag auto-generates a TIMEOUT transition that fires after the duration if no other transition runs."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/trait.rs (parse_state)"
}

form emits {
  syntax  : "emits { EVENT_NAME external { field : type } }"
  desc    : "Declare events this trait emits. The scope (internal|external) controls whether the event is broadcast on the orbital event bus or stays trait-local."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/trait.rs (parse_emits_block)"
}

form listens {
  syntax  : "listens { Source EVENT -> TARGET when (guard ...) with { id: ?id } }"
  desc    : "Listen for events from another trait or orbital. The triggers field maps the upstream event to a local event that fires inside this trait."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/trait.rs (parse_listens_block)"
}

form page-inline {
  syntax  : "page \"/path\" -> Trait1, Trait2 [view: list, entity: Foo, initial]"
  desc    : "Inline page declaration. Lists the traits bound to the page and optional [view: type, entity: Name, initial] hints for layout selection."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/page.rs (parse_page)"
}

form page-reference {
  syntax  : "page \"/path\" = Alias.pages.Upstream -> Trait1, Trait2"
  desc    : "Reference an imported page with overrides. The path is overridden, the trait list replaces the upstream page's default traits. Pages always come whole — there is no partial/headless import."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/page.rs (parse_page, reference branch)"
}

form type-alias {
  syntax  : "type Status = active | inactive | pending"
  desc    : "File-scoped or orbital-scoped enum / sum-type alias. Lowers to a string field with values: [...] when used in an entity field type position."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/type.rs (parse_type_alias)"
}

form let {
  syntax  : "(let ((x value) (y value)) body)"
  desc    : "S-expression local-binding form. Introduces names scoped to the body. The names are NOT @ sigils — they live only inside the let scope."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/expression.rs (parse_let_bindings)"
}

form orbital-reference {
  syntax  : "orbital Local = Alias.orbitals.Upstream { entity · entities · fields · roles · pages · omit · only · config · events · trait … }"
  desc    : "Reference an imported orbital (orbital-import Stage B). Rebinds the primary entity (entity) and out-of-orbital relation targets (entities); remaps fields/pages/roles; drops (omit) or keeps (only) traits from the imported set; overrides the upstream orbital's declared config knobs (config); renames events orbital-wide (events); and may declare sibling trait(s) inline (never prefixed) that ride the imported closure unmodified. Pages always come whole. Topology (states/transitions/event keys) is fixed by the upstream orbital and cannot be added to or removed here."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/orbital.rs (parse_orbital_reference, parse_orbital_ref_body)"
}

form config-app {
  syntax  : "app Name vX.Y.Z config { appName : string = \"Time Tracking\" @label \"App name\" }"
  desc    : "App-level (organism-wide) declared config knobs, resolved against the file-level type/entity scope. Every orbital's traits in the file may forward one via @config.<key>; a caller overrides them at import time with uses-config."
