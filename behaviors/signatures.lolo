trait ui-entity-cards.traits.EntityCardsRender {
  alias          : UiEntityCards
  linkedEntity   : EntityCardsItem
  category       : interaction
  states         : (idle*)
  events         : (INIT EntityCardsLoaded VIEW)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on EntityCardsLoaded))
  emits          : (VIEW EntityCardsLoaded)
  config {
    activeFilters  : Map<string,string> = {} @label "Active Filters" @description "Active filters" @tier "presentation"
    alignItems     : string = "stretch" @label "Align Items" @description "Align cards vertically in their cells" @tier "presentation" @values (start center end stretch)
    children       : node @label "Children" @description "Children elements (cards) - optional when using entity prop" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    columns        : [EntityCardsColumnsItem] = [] @label "Columns" @description "Alias for fields - backwards compatibility" @tier "presentation"
    error          : EntityCardsError @label "Error" @description "Error state (UiError)" @tier "presentation"
    fieldNames     : [string] = [] @label "Field Names" @description "Alias for fields - backwards compatibility" @tier "presentation"
    fields         : [EntityCardsFieldsItem] = [{"header":"Header","key":"Key","label":"Label","name":"Name"},{"header":"Header 2","key":"Key 2","label":"Label 2","name":"Name 2"}] @label "Fields" @description "Fields to display - required for schema-driven rendering" @tier "presentation"
    gap            : string = "md" @label "Gap" @description "Gap between cards" @tier "presentation" @values (none sm md lg xl)
    imageField     : string @label "Image Field" @description "Entity field name containing an image URL to display as card thumbnail" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    itemActions    : [EntityCardsItemActionsItem] = [{"event":"VIEW","label":"View","variant":"ghost"}] @label "Item Actions" @description "Actions for each card item (schema-driven)" @tier "presentation"
    maxCols        : number @label "Max Cols" @description "Maximum number of columns" @tier "presentation"
    minCardWidth   : number = 280 @label "Min Card Width" @description "Minimum width of each card (default: 280px)" @tier "presentation"
    pageProp       : number @label "Page" @description "Current page number" @synonyms "page" @tier "presentation"
    pageSize       : number @label "Page Size" @description "Number of items per page" @tier "presentation"
    searchValue    : string @label "Search Value" @description "Current search query value" @tier "presentation"
    selectedIds    : [string] = [] @label "Selected Ids" @description "Currently selected item IDs" @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    showAvatar     : boolean @label "Show Avatar" @description "Show avatar/image field on cards" @tier "presentation"
    showTotal      : boolean = true @label "Show Total" @description "Show total count in pagination" @tier "presentation"
    sortBy         : string @label "Sort By" @description "Current sort field" @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Current sort direction" @tier "presentation" @values (asc desc)
    totalCount     : number @label "Total Count" @description "Total number of items" @tier "presentation"
    variant        : string @label "Variant" @description "Visual variant for the card grid" @tier "presentation"
  }
