;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-doc-pagination.orb orbitals[0].traits[0])
trait ui-doc-pagination.traits.DocPaginationRender {
  alias          : UiDocPagination
  linkedEntity   : DocPaginationItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
