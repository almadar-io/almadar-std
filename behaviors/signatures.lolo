  transitions    : ((loading -> loading on INIT) (loading -> browsing on PreferencesLoaded) (loading -> error on PreferencesLoadFailed) (browsing -> loading on INIT) (browsing -> browsing on DELETE) (browsing -> browsing on DO_CREATE) (browsing -> browsing on DO_UPDATE) (browsing -> loading on PreferenceSaved) (browsing -> loading on PreferenceDeleted) (browsing -> browsing on PreferenceSaveFailed) (browsing -> error on PreferencesLoadFailed) (error -> loading on INIT) (error -> loading on RETRY))
  emits          : (CREATE EDIT DELETE PreferencesLoaded PreferencesLoadFailed PreferenceSaved PreferenceSaveFailed PreferenceDeleted)
  config {
