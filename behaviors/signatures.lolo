;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-table-view.orb orbitals[0].traits[0])
trait ui-table-view.traits.TableViewRender {
  alias          : UiTableView
  linkedEntity   : TableViewItem
  category       : interaction
  states         : (idle*)
  events         : (INIT TableViewLoaded @config.selectEvent @config.sortEvent VIEW)
  transitions    : ((idle -> idle on INIT) (idle -> idle on INIT) (idle -> idle on TableViewLoaded))
  emits          : (@config.selectEvent @config.sortEvent VIEW TableViewLoaded)
  config {
    accepts        : string @label "Accepts" @description "When set, the container accepts drops whose dragGroup matches this value (or '*' for any group)" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes applied to the table root." @tier "presentation"
    columns        : [TableViewColumnsItem] = [] @label "Columns" @description "Column definitions. The compiler emits `columns`; `fields` is the alias." @tier "presentation"
    dndItemIdField : string @label "Dnd Item Id Field" @description "Row field used as the @dnd-kit draggable id (default 'id')" @tier "presentation"
    dndRoot        : boolean @label "Dnd Root" @description "Mark this container as the DnD root for its subtree — descendant zones share one DndContext (cross-container drag). Use on an outer container whose own items are not draggable." @tier "presentation"
    dragGroup      : string @label "Drag Group" @description "When set, items in this container are draggable and announce this group as their source" @tier "presentation"
    dropEvent      : string @label "Drop Event" @description "Bus event fired on cross-container drop. Payload: { id, sourceGroup, targetGroup, newIndex }" @tier "presentation"
    emptyMessage   : string @label "Empty Message" @description "Message shown when there are no rows." @tier "presentation"
    error          : TableViewError @label "Error" @description "Error state." @tier "presentation"
    fields         : [TableViewFieldsItem] = [] @label "Fields" @description "Alias for `columns`." @tier "presentation"
    groupBy        : string @label "Group By" @description "Group rows under section headers by a field value." @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state." @tier "presentation"
    itemActions    : [TableViewItemActionsItem] = [] @label "Item Actions" @description "Per-row actions, collected under a trailing kebab overflow menu." @tier "presentation"
    itemClickEvent : event = "" @label "Item Click Event" @description "When set, the whole row is clickable and emits UI:{itemClickEvent} with { id, row } (action-button clicks stopPropagation so they still win). Mirrors DataList's contract. When OMITTED and `itemActions` exist, the row click defaults to the first non-danger item action (the view/open action by authoring convention) — a danger action never becomes the row default (destructive actions require intentional reach)." @tier "presentation"
    look           : string = "dense" @label "Look" @description "Layer 2 visual treatment — mirrors the data-list / entity-table look enum so authors share one knob name across row renderers." @tier "presentation" @values (dense spacious striped borderless bordered)
    maxInlineActions : number @label "Max Inline Actions" @description "maxInlineActions prop" @tier "presentation"
    pageSize       : number = 0 @label "Page Size" @description "Max rows before a 'Show More' button. Defaults to 0 (show all)." @tier "presentation"
    positionEvent  : string @label "Position Event" @description "Bus event fired N times per drop (one per item in affected zones) so the trait can persist new positions for the WHOLE zone, not just the moved item. Payload: { id, position }" @tier "presentation"
    relationsData  : Map<string,[TableViewRelationsDataValueItem]> = {} @label "Relations Data" @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names for a column whose field is relation-typed. Same contract DetailPanel takes." @tier "presentation"
    reorderEvent   : string @label "Reorder Event" @description "Bus event fired on in-container reorder. Payload: { id, oldIndex, newIndex }" @tier "presentation"
    selectable     : boolean = false @label "Selectable" @description "Render a leading checkbox column. Selection changes emit `selectEvent`." @tier "presentation"
    selectedIds    : [string] = [] @label "Selected Ids" @description "Currently-selected ids (controlled). Falls back to local state when omitted." @tier "presentation"
    selectEvent    : event = "SELECT" @label "Select Event" @description "Event emitted on selection change: UI:{selectEvent} with { selectedIds }." @tier "presentation"
    selfFetch      : boolean = true @label "Fetch its own rows on mount?" @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's." @tier "internal"
    sortable       : boolean @label "Sortable" @description "Enable in-container reorder; items can be dragged to new positions among siblings" @tier "presentation"
    sortColumn     : string @label "Sort Column" @description "Current sort column (display hint for the active header arrow)." @tier "presentation"
    sortDirection  : string = "asc" @label "Sort Direction" @description "Current sort direction (display hint)." @tier "presentation" @values (asc desc)
    sortEvent      : event = "SORT" @label "Sort Event" @description "Event emitted on sortable-header click: UI:{sortEvent} with { column, direction }." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-table-view.orb orbitals[0].traits[0])"
}

