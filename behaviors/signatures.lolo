;; From @almadar/std (behaviors/registry/ui/game/atoms/std-lives.orb orbitals[0].traits[0])
trait std-lives.traits.Lives {
  alias          : Lives
  linkedEntity   : LivesData
  category       : lifecycle
  states         : (active*)
  events         : (INIT DAMAGE BODY_MOVED RESTART LIFE_LOST RESPAWN GAME_OVER CHECKPOINT_REACHED)
  transitions    : ((active -> active on INIT) (active -> active on DAMAGE) (active -> active on BODY_MOVED) (active -> active on RESTART))
  emits          : (LIFE_LOST RESPAWN GAME_OVER CHECKPOINT_REACHED)
  config {
    checkpoints    : [Checkpoint] = [] @label "Checkpoints" @description "Ordered along the run: when the player's x crosses atX the respawn point moves to (x, y). Must be sorted by atX ascending." @tier "domain"
    invulnMs       : number = 1500 @label "Invulnerability Window (ms)" @description "Milliseconds after a accepted hit during which further DAMAGE is ignored, so a hazard overlapping the respawn can't chain-drain." @tier "domain"
    maxLives       : number = 3 @label "Max Lives" @description "Lives seeded on INIT/RESTART; reaching zero fires GAME_OVER." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, DAMAGE and checkpoint crossings are processed; toggle to make the run harmless (practice mode)." @tier "domain"
    spawnX         : number = 0 @label "Spawn X" @description "Respawn x before any checkpoint is reached (match the body authority's spawn)." @tier "domain"
    spawnY         : number = 0 @label "Spawn Y" @description "Respawn y before any checkpoint is reached." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-lives.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-loop-lock.orb orbitals[0].traits[0])
trait std-loop-lock.traits.LoopLock {
  alias          : LoopLock
  linkedEntity   : LoopLockData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_LOCKS RESTART LOOP_UNLOCKED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_LOCKS) (active -> active on RESTART))
  emits          : (LOOP_UNLOCKED)
  config {
    locks          : [LoopLock] = [] @label "Locks" @description "One row per winding lock: id, anchor (x, y in world units), ring radius, radial tolerance band, and revolutions required. swept/inside/unlocked are stamped at runtime. Seeded onto the entity on INIT; the live set is entity.locks — SET_LOCKS replaces it at runtime (boards that import locks), and RESTART re-arms the live set rather than re-reading config, so injected locks survive respawns." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED accumulates angular sweep and unlocks locks; toggle to freeze every lock as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-loop-lock.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-market-flow.orb orbitals[0].traits[0])
trait std-market-flow.traits.MarketFlow {
  alias          : MarketFlow
  linkedEntity   : MarketFlowData
  category       : lifecycle
  states         : (active*)
  events         : (INIT SERVICE_CHANGED RESTART GAME_END)
  transitions    : ((active -> active on INIT) (active -> active on SERVICE_CHANGED) (active -> active on RESTART))
  emits          : (GAME_END)
  config {
    maxLost        : number = 3 @label "Max Lost" @description "Cumulative starved-customer count that ends the round in a loss" @tier "domain"
    running        : boolean = true @label "Running" @description "When true, SERVICE_CHANGED signals resolve win/lose; toggle to freeze" @tier "domain"
    targetServed   : number = 10 @label "Target Served" @description "Cumulative customers served needed to win" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-market-flow.orb orbitals[0].traits[0])"
}

