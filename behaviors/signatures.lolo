;; From @almadar/std (behaviors/registry/ui/core/atoms/std-app-layout.orb orbitals[0].traits[0])
trait std-app-layout.traits.AppLayout {
  alias          : AppLayout
  linkedEntity   : AppLayoutData
  category       : interaction
  states         : (composing*)
  events         : (INIT AppLayoutStateLoaded AppLayoutStateLoadFailed SEARCH NOTIFY_CLICK)
  transitions    : ((composing -> composing on INIT) (composing -> composing on AppLayoutStateLoaded) (composing -> composing on AppLayoutStateLoadFailed) (composing -> composing on SEARCH) (composing -> composing on NOTIFY_CLICK))
  emits          : (SEARCH NOTIFY_CLICK AppLayoutStateLoaded AppLayoutStateLoadFailed)
  config {
    appName        : string = "App" @label "What should this app be called?" @description "Name shown in the top-left of the chrome header." @synonyms "app title, product name, brand name, application name, site name" @tier "presentation"
    contentClassName : string = "max-w-5xl mx-auto w-full" @label "Content wrapper class" @description "CSS class applied to the content area wrapper." @tier "internal"
    contentTrait   : trait @label "Content trait" @description "Trait rendered inside the app layout content area" @tier "presentation"
    currentPath    : string = "" @label "Current path" @description "Nav-highlight ONLY: which nav item to mark active. This is NOT the page route — it does not change what page loads or where the orbital lives. To set the landing route or a page path, use the orbital's pagePath / page path, not this knob. When omitted, the layout reads the current route." @synonyms "active nav item, highlighted nav link, which menu item is selected, nav highlight" @tier "internal"
    detailSlot     : slot = "modal" @label "Detail slot" @description "Slot where detail/edit views render" @tier "internal"
    layoutMode     : string = "sidebar" @label "Where should navigation be placed?" @description "sidebar = left rail; topnav = top bar; bottomnav = mobile tab bar; minimal = no nav." @synonyms "nav position, navigation style, menu placement, layout style" @tier "presentation" @values (sidebar topnav bottomnav minimal)
    layoutPattern  : pattern = "dashboard-layout" @label "Layout pattern" @description "UI pattern used to render the application chrome" @tier "internal"
    navItems       : [NavItem] = "@pages" @label "Which sections appear in the sidebar?" @description "Top-level navigation links shown on the left rail." @synonyms "nav links, menu items, sidebar sections, navigation entries, pages" @tier "presentation"
    notificationClickEvent : event = "NOTIFY_CLICK" @label "Notification click event" @description "Event emitted when the user picks a notification" @tier "internal"
    notifications  : [NotificationSpec] = [] @label "What notifications should appear?" @description "Items shown in the notifications dropdown." @synonyms "alerts, messages, notices, notification items, bell items" @tier "presentation"
    searchEvent    : event = "SEARCH" @label "Search event" @description "Event emitted when the user runs a global search" @tier "internal"
    sidebarTrait   : trait @label "Sidebar trait" @description "Optional trait rendered in the sidebar between the nav links and the footer — the Notion/Confluence-style always-visible page tree; scrolls independently. Unset renders plain nav only." @synonyms "sidebar tree, nav tree, page tree in sidebar, hierarchy rail" @tier "presentation"
    theme          : string = "@currentTheme" @label "Theme" @description "Data-theme attribute applied to the layout root (e.g. almadar-website-dark)." @tier "presentation"
    topBarActions  : [ItemAction] = [] @label "What shortcuts go in the top bar?" @description "Icon buttons shown on the right side of the top bar (e.g. cart, help, profile)." @synonyms "toolbar buttons, header actions, shortcut icons, quick actions" @tier "presentation"
    viewerAvatar   : string = "" @label "Signed-in avatar" @description "Avatar image URL for the account menu." @tier "presentation"
    viewerEmail    : string = "" @label "Signed-in email" @description "Email shown under the name in the account menu — typically @user.email." @tier "presentation"
    viewerName     : string = "" @label "Who is signed in" @description "Display name of the signed-in viewer, shown in the app bar's account menu — typically @user.name. Blank renders no account menu, so people can see which account (and which persona) they are viewing the app as only when it is actually known." @synonyms "signed in user, current user, account, profile, persona, who am i" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-app-layout.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-app-search.orb orbitals[0].traits[1])
trait std-app-search.traits.AppSearch {
  alias          : AppSearch
  linkedEntity   : AppSearchTarget
  category       : interaction
  states         : (idle* searching results)
  events         : (INIT APP_SEARCH AppSearchLoaded AppSearchFailed CLEAR_SEARCH)
  transitions    : ((idle -> idle on INIT) (idle -> searching on APP_SEARCH) (searching -> idle on INIT) (searching -> searching on APP_SEARCH) (searching -> results on AppSearchLoaded) (searching -> idle on AppSearchFailed) (results -> idle on INIT) (results -> searching on APP_SEARCH) (results -> idle on CLEAR_SEARCH))
  emits          : (AppSearchLoaded AppSearchFailed)
  config {
    idleContent    : trait = "@trait.AppSearchIdleHint" @label "Idle content" @description "The normal content view (e.g. the data ledger/browse trait) shown when no search is active." @tier "presentation"
    resultActions  : [AppSearchActionSpec] = [] @label "Result row actions" @description "Optional per-row actions on a result, e.g. { label: \"View Details\", event: \"VIEW\" }." @tier "presentation"
    resultFields   : [AppSearchFieldSpec] = [{"label":"Name","name":"name","variant":"h4"}] @label "Result columns" @description "Columns shown in the search-results grid; maps entity fields to display cells." @tier "presentation"
    resultsTitle   : string = "Search results" @label "Results title" @description "Heading shown above the search-results grid." @tier "presentation"
    searchField    : string = "name" @label "Search field" @description "Entity field matched against the query (case-insensitive substring)." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-app-search.orb orbitals[0].traits[1])"
}

