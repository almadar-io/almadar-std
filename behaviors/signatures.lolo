    items          : [FeatureGridItemsItem] = [{"className":"Class Name","description":"Description","href":"Href","icon":"circle","linkLabel":"Link Label","size":"sm","title":"Title","variant":"default"},{"className":"Class Name 2","description":"Description 2","href":"Href 2","icon":"circle","linkLabel":"Link Label 2","size":"md","title":"Title 2","variant":"bordered"}] @label "Items" @description "Array of feature card configurations" @tier "presentation"
  }
