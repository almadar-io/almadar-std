;; From @almadar/std (behaviors/registry/ui/game/atoms/std-fx-trail.orb orbitals[0].traits[0])
trait std-fx-trail.traits.FxTrail {
  alias          : FxTrail
  linkedEntity   : FxTrailData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED RESTART)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on RESTART))
  config {
    minSpeed       : number = 0.5 @label "Min Speed" @description "Body speed (units/s, from BODY_MOVED) below which no dot is appended, so a resting body doesn't pile dots on one spot." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED appends trail dots; toggle to freeze the trail (existing dots still age out)." @tier "domain"
    ttl            : number = 600 @label "Trail Ttl (ms)" @description "Milliseconds a trail dot lives; at a 33ms move cadence ~600ms keeps the last eighteen positions. The ttl is also the natural length cap — no separate limit needed." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
