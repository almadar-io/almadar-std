    rightIcon      : icon @label "Right Icon" @description "Right icon: a Lucide component or a canonical icon name string." @tier "presentation"
    size           : string = "md" @label "Size" @description "size prop" @tier "presentation" @values (sm md lg)
    variant        : string = "primary" @label "Variant" @description "variant prop" @tier "presentation" @values (primary secondary ghost danger success warning default link)
  }
