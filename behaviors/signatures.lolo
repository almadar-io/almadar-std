    closeEvent     : event = "CLOSE" @label "Close Event" @description "Event emitted when close button is clicked" @tier "presentation"
    collapseChangeEvent : event = "COLLAPSE_CHANGE" @label "Collapse Change Event" @description "Event emitted when collapse state changes, payload: { collapsed: boolean }" @tier "presentation"
    collapsed      : boolean @label "Collapsed" @description "Collapsed state (controlled)" @tier "presentation"
    defaultCollapsed : boolean = false @label "Default Collapsed" @description "Default collapsed state" @tier "presentation"
