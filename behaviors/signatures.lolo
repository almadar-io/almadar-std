    center         : boolean = true @label "Center" @description "Center horizontally" @tier "presentation"
    children       : node @label "Children" @description "Children elements" @tier "presentation"
    className      : string @label "Class Name" @description "Custom class name" @tier "presentation"
    maxWidth       : string = "xs" @label "Max Width" @description "Alias for size (pattern compatibility)" @tier "presentation" @values (xs sm md lg xl 2xl full)
    padding        : string = "md" @label "Padding" @description "Horizontal padding" @tier "presentation" @values (none sm md lg xl)
    size           : string = "xs" @label "Size" @description "Maximum width" @tier "presentation" @values (xs sm md lg xl 2xl full)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-container.orb orbitals[0].traits[0])"
