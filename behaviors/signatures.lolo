    justify        : string = "start" @label "Justify" @description "Justify items on the main axis" @tier "presentation" @values (start center end between around evenly)
    responsive     : boolean = false @label "Responsive" @description "When true, horizontal stacks flip to vertical below the md breakpoint (768px)" @tier "presentation"
    reverse        : boolean = false @label "Reverse" @description "Reverse the order of children" @tier "presentation"
    role           : string @label "Role" @description "Role for accessibility" @tier "presentation"
    style          : Map<string,string> = {} @label "Style" @description "Inline styles" @tier "presentation"
    tabIndex       : number @label "Tab Index" @description "Tab index for focus management" @tier "presentation"
    wrap           : boolean = false @label "Wrap" @description "Allow items to wrap" @tier "presentation"
  }
