    filters        : [FilterSpec] = [{"field":"status","filterType":"select","label":"Status","options":["active","inactive","pending"]}] @label "Filter controls" @description "Field, label, control type, and options for each filter input. numberrange renders a min/max slider pair (bounded by min/max/step) and emits one FILTER per side as `<field>_min` / `<field>_max`, mirroring daterange's `<field>_from` / `<field>_to` convention." @synonyms "numeric range, price range, min max, slider filter, range filter, threshold filter" @tier "presentation"
