;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-file-tree.orb orbitals[0].traits[0])
trait ui-file-tree.traits.FileTreeRender {
  alias          : UiFileTree
  linkedEntity   : FileTreeItem
  category       : interaction
  states         : (idle*)
  events         : (INIT @config.onFileSelect)
  transitions    : ((idle -> idle on INIT))
  emits          : (@config.onFileSelect)
  config {
    className      : string @label "Class Name" @description "CSS class" @tier "presentation"
    indent         : number = 16 @label "Indent" @description "Indent size per level in px (default: 16)" @tier "presentation"
    items          : [FileTreeItemsItem] = [] @label "Items" @description "Flat node list, nested by `parentId` at render time — takes precedence over `tree` when provided. A `parentId` with no matching row renders that node as a root rather than dropping it." @tier "presentation"
    look           : string = "files" @label "Look" @description "Visual treatment for flat `items` mode: `files` (default) keeps the monospace file-browser look; `nav` renders a sidebar navigation tree — regular font, document icons, roomier hit areas." @tier "presentation" @values (files nav)
    nodeActionIcon : string @label "Node Action Icon" @description "Icon for the row hover action (default: plus)." @tier "presentation"
    nodeActionLabel : string @label "Node Action Label" @description "Accessible label/tooltip for the row hover action." @tier "presentation"
    onFileSelect   : event = "FILE_SELECT" @label "On File Select" @description "Called when a file is clicked" @tier "presentation"
    onNodeAction   : event = "" @label "On Node Action" @description "Called from the row's hover action button, in flat `items` mode; carries that node's id. Presence-gated: binding it renders the action." @tier "presentation"
    onNodeReorder  : event = "" @label "On Node Reorder" @description "Called when a row is dropped onto another, in flat `items` mode; carries the moved node's id, its new parent id (`null` for a root drop), and its index within the new parent's children. Presence-gated: binding this prop is what turns on row dragging." @tier "presentation"
    onNodeSelect   : event = "" @label "On Node Select" @description "Called when a node is clicked, in flat `items` mode; carries the selected node's id. Presence-gated: binding this prop is what turns on the click-to-select affordance, mirroring Badge's `onRemove`." @tier "presentation"
    selectedId     : string @label "Selected Id" @description "Currently selected node id, in flat `items` mode: the row highlights and every ancestor auto-expands so the selection is always visible — the 'you are here' a navigation tree needs." @tier "presentation"
    selectedPath   : string @label "Selected Path" @description "Currently selected file path" @tier "presentation"
    tree           : [FileTreeTreeItem] = [] @label "Tree" @description "The tree data (pre-nested). Ignored when `items` is provided." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-file-tree.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-filter-group.orb orbitals[0].traits[0])
trait ui-filter-group.traits.FilterGroupRender {
  alias          : UiFilterGroup
  linkedEntity   : FilterGroupItem
  category       : interaction
  states         : (idle*)
  events         : (INIT EVENT CLEAR @config.onFilterChange @config.onClearAll @config.event @config.clearEvent)
  transitions    : ((idle -> idle on INIT) (idle -> idle on EVENT) (idle -> idle on CLEAR))
  emits          : (@config.onFilterChange @config.onClearAll @config.event @config.clearEvent)
  config {
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    clearEvent     : event = "CLEAR" @label "Clear Event" @description "Declarative clear event — emits UI:{clearEvent} via eventBus on clear-all (alongside canonical UI:CLEAR_FILTERS)" @tier "presentation"
    event          : event = "EVENT" @label "Event" @description "Declarative filter event — emits UI:{event} via eventBus on filter change (alongside canonical UI:FILTER)" @tier "presentation"
    filters        : [FilterGroupFiltersItem] = [{"field":"Field","filterType":"text","label":"Label","max":1,"min":1,"options":["Item","Item 2"],"step":1,"type":"text"},{"field":"Field 2","filterType":"select","label":"Label 2","max":2,"min":2,"options":["Item","Item 2"],"step":2,"type":"select"}] @label "Filters" @description "Filter definitions from schema" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state indicator" @tier "presentation"
    look           : string = "toolbar" @label "Look" @description "Layer 2 visual treatment — orthogonal to the semantic variant." @tier "presentation" @values (toolbar chips pills popover-trigger inline-column-header)
    onClearAll     : event = "CLEAR_ALL" @label "On Clear All" @description "Callback to clear all filters" @tier "presentation"
    onFilterChange : event = "FILTER_CHANGE" @label "On Filter Change" @description "Callback when a filter changes - for EntityStore integration" @tier "presentation"
    query          : string @label "Query" @description "Query singleton binding for state management. When provided, syncs filter state with the query singleton. Example: '@TaskQuery'" @tier "presentation"
    showIcon       : boolean = true @label "Show Icon" @description "Show filter icon" @tier "presentation"
