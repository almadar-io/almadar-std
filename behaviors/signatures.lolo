    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    disabled       : boolean = false @label "Disabled" @description "Whether the choice is disabled" @tier "presentation"
    icon           : icon @label "Icon" @description "Icon displayed before the text" @tier "presentation"
    index          : number @label "Index" @description "Choice index number (displayed as prefix)" @tier "presentation"
    onClick        : event = "CLICK" @label "On Click" @description "Click handler" @tier "presentation"
    payload        : Map<string,string> = {"item":"Item"} @label "Payload" @description "Semantic payload emitted with the action (e.g. `{ nextId, choiceIndex }` for a branching choice)." @tier "presentation"
    selected       : boolean = false @label "Selected" @description "Whether the choice is currently selected" @tier "presentation"
    text           : string = "Charge forward into the fray" @label "Text" @description "Choice text content" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/ui-choice-button.orb orbitals[0].traits[0])"
}

