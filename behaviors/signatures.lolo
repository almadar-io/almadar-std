;; From @almadar/std (behaviors/registry/ml/atoms/std-graph-builder.orb orbitals[0].traits[0])
trait std-graph-builder.traits.GraphBuilderRun {
  alias          : GraphBuilder
  linkedEntity   : GraphStructure
