  category       : interaction
  states         : (composing*)
  events         : (INIT)
  transitions    : ((composing -> composing on INIT))
  config {
    filter1Trait   : trait = "@trait.EmptyTile" @label "Filter slot 1" @description "Trait reference for the first filter-row position. Format '@trait.<TraitName>' picks any trait declared on the orbital (typical use: date range picker); '@trait.EmptyTile' leaves the slot blank. Override THIS config to add, swap, remove, or reorder filter controls — never edit other traits." @tier "presentation"
    filter2Trait   : trait = "@trait.EmptyTile" @label "Filter slot 2" @description "Trait reference for the second filter-row position. Format '@trait.<TraitName>' picks any trait declared on the orbital (typical use: search input); '@trait.EmptyTile' leaves the slot blank. Override THIS config to add, swap, remove, or reorder filter controls — never edit other traits." @tier "presentation"
    filter3Trait   : trait = "@trait.EmptyTile" @label "Filter slot 3" @description "Trait reference for the third filter-row position. Format '@trait.<TraitName>' picks any trait declared on the orbital (typical use: dropdown filter); '@trait.EmptyTile' leaves the slot blank. Override THIS config to add, swap, remove, or reorder filter controls — never edit other traits." @tier "presentation"
    filter4Trait   : trait = "@trait.EmptyTile" @label "Filter slot 4" @description "Trait reference for the fourth filter-row position. Format '@trait.<TraitName>' picks any trait declared on the orbital (typical use: secondary dropdown filter); '@trait.EmptyTile' leaves the slot blank. Override THIS config to add, swap, remove, or reorder filter controls — never edit other traits." @tier "presentation"
    minTileWidth   : string = "320px" @label "Tile min width" @description "Minimum CSS width per tile before the grid re-flows (a CSS length, e.g. \"320px\" or \"20rem\")" @tier "presentation"
    theme          : string = "" @label "Theme" @description "Design-system skin applied to the embedded grid surface via data-theme (e.g. 'linear-clean-light'). Empty inherits the surrounding shell's theme. Needed because this atom renders without app-shell chrome, so no layout-level theme cascade reaches it." @tier "presentation"
    tile10Trait    : trait = "@trait.EmptyTile" @label "Tile slot 10" @description "Trait reference for grid cell 10. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile11Trait    : trait = "@trait.EmptyTile" @label "Tile slot 11" @description "Trait reference for grid cell 11. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile12Trait    : trait = "@trait.EmptyTile" @label "Tile slot 12" @description "Trait reference for grid cell 12. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile1Trait     : trait = "@trait.EmptyTile" @label "Tile slot 1" @description "Trait reference for grid cell 1. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile2Trait     : trait = "@trait.EmptyTile" @label "Tile slot 2" @description "Trait reference for grid cell 2. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile3Trait     : trait = "@trait.EmptyTile" @label "Tile slot 3" @description "Trait reference for grid cell 3. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile4Trait     : trait = "@trait.EmptyTile" @label "Tile slot 4" @description "Trait reference for grid cell 4. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile5Trait     : trait = "@trait.EmptyTile" @label "Tile slot 5" @description "Trait reference for grid cell 5. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile6Trait     : trait = "@trait.EmptyTile" @label "Tile slot 6" @description "Trait reference for grid cell 6. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
    tile7Trait     : trait = "@trait.EmptyTile" @label "Tile slot 7" @description "Trait reference for grid cell 7. Format '@trait.<TraitName>' picks any trait declared on the orbital; '@trait.EmptyTile' leaves the cell blank. Override THIS config to swap a chart, remove a tile, or reorder — never edit any other trait to move tile content." @tier "presentation"
