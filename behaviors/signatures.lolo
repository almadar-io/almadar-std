;; From @almadar/std (behaviors/registry/infra/atoms/std-approval-gate.orb orbitals[0].traits[0])
trait std-approval-gate.traits.ApprovalGateReview {
  alias          : ApprovalGate
  linkedEntity   : ApprovalRequest
  category       : interaction
  states         : (idle* loading reviewing denying error)
  events         : (INIT ApprovalRequestLoaded ApprovalRequestLoadFailed APPROVAL_REPLAY_FAILED ApprovalRequestReviewFailed OPEN CLOSE APPROVE DENY OPEN_SUBJECT ApprovalRequestReviewed CONFIRM_DENY CANCEL_DENY ApprovalGranted ApprovalDenied)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ApprovalRequestLoaded) (idle -> idle on ApprovalRequestLoadFailed) (idle -> idle on APPROVAL_REPLAY_FAILED) (idle -> idle on ApprovalRequestReviewFailed) (idle -> loading on OPEN) (loading -> reviewing on ApprovalRequestLoaded) (loading -> error on ApprovalRequestLoadFailed) (loading -> idle on CLOSE) (reviewing -> reviewing on APPROVE) (reviewing -> denying on DENY) (reviewing -> reviewing on OPEN_SUBJECT) (reviewing -> loading on ApprovalRequestReviewed) (reviewing -> reviewing on ApprovalRequestReviewFailed) (reviewing -> reviewing on APPROVAL_REPLAY_FAILED) (reviewing -> idle on CLOSE) (denying -> reviewing on CONFIRM_DENY) (denying -> loading on CANCEL_DENY) (denying -> loading on ApprovalRequestReviewed) (denying -> denying on ApprovalRequestReviewFailed) (denying -> idle on CLOSE) (error -> loading on OPEN) (error -> idle on CLOSE))
  emits          : (APPROVE DENY OPEN_SUBJECT CONFIRM_DENY CANCEL_DENY CLOSE ApprovalGranted ApprovalDenied ApprovalRequestLoaded ApprovalRequestLoadFailed ApprovalRequestReviewed ApprovalRequestReviewFailed)
  config {
    approverRoles  : [string] = [] @label "Who can approve requests?" @description "Roles eligible to decide. ENFORCED by the APPROVE/DENY transition guards: a viewer whose @user.role is not listed cannot fire a decision, from the button or from the bus. Empty = every signed-in viewer may decide (ungated)." @synonyms "approver, reviewer, authorized roles, sign-off roles, who approves" @tier "policy"
    autoApproveBelowThreshold : boolean = true @label "Skip review queue for low-value requests?" @description "When true, auto-approves requests below the threshold without queuing. v1.0 declarative only." @synonyms "auto approve, skip review, bypass queue, automatic approval" @tier "policy"
    blockSelfApproval : boolean = false @label "Block approving your own requests?" @description "When on, a reviewer cannot APPROVE a request they submitted themselves (requestedBy = the viewer's id) — enforced by the APPROVE transition guard, from the button or from the bus. Requires hosts to stamp requestedBy at request creation. DENY stays allowed on your own request (denying your own request withdraws it). Off by default." @synonyms "self approval, self-approval, four eyes, four-eyes, separation of duties, cannot approve own, no self sign-off, dual control" @tier "policy"
    enabled        : boolean = false @label "Require approval" @description "Require sign-off before a record is finalized. Off by default." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, approval, needs approval, sign-off, signed off, review before, gatekeeper, editor approval, publishing approval, draft approval, content review, requires approval, manager approval, supervisor approval, admin approval, before going live" @tier "policy"
    escalationHours : number = 0 @label "Escalate after how many hours pending?" @description "Hours a request can sit pending before escalating. v1.0 declarative only." @synonyms "escalation time, SLA hours, pending timeout, escalate after" @tier "policy"
    escalationRoles : [string] = [] @label "Who gets notified when a request escalates?" @description "Roles notified on escalation (compose sibling std-notify-on-event to deliver)." @synonyms "escalation contacts, escalate to, notify roles, escalated approver" @tier "policy"
    reviewSlot     : slot = "modal" @label "Review slot" @description "UI slot the review queue renders into. Defaults to the modal overlay so the queue never seizes the host's main content; summoned via OPEN, cleared via CLOSE." @tier "internal"
    tableLook      : string = "dense" @label "Review queue table style" @description "Visual treatment for the approval-queue data table." @synonyms "table style, grid look, compact, spacious, striped" @tier "presentation" @values (dense spacious striped borderless card-rows)
    threshold      : number = 0 @label "Auto-approve below this value" @description "Requests whose gated value is below this threshold are auto-approved. v1.0 declarative only." @synonyms "auto approve amount, skip review under, threshold, limit" @tier "policy"
    valueField     : string = "" @label "Value field" @description "Payload field name to compare against threshold (e.g. 'amount' on a RefundRequested event). v1.0 declarative only." @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-approval-gate.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-arcade-flow.orb orbitals[0].traits[0])
trait std-arcade-flow.traits.ArcadeFlow {
  alias          : ArcadeFlow
  linkedEntity   : ArcadeFlowData
  category       : lifecycle
  states         : (active*)
  events         : (INIT SCORE_CHANGED RESTART GAME_END)
  transitions    : ((active -> active on INIT) (active -> active on SCORE_CHANGED) (active -> active on RESTART))
  emits          : (GAME_END)
  config {
    running        : boolean = true @label "Running" @description "When true, SCORE_CHANGED signals resolve win/lose; toggle to freeze" @tier "domain"
    ticketsToWin   : number = 5 @label "Tickets To Win" @description "Ticket count that ends the round in a win" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-arcade-flow.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-arcade-play.orb orbitals[0].traits[0])
trait std-arcade-play.traits.ArcadePlay {
  alias          : ArcadePlay
  linkedEntity   : ArcadePlayData
  category       : lifecycle
  states         : (active*)
  events         : (INIT PLAY_MACHINE RESTART BURST SCORE_CHANGED)
  transitions    : ((active -> active on INIT) (active -> active on PLAY_MACHINE) (active -> active on RESTART))
  emits          : (BURST SCORE_CHANGED)
  config {
    machines       : [Machine] = [] @label "Machines" @description "Playable machine ids the PLAY_MACHINE intent is validated against" @tier "domain"
    maxPayout      : number = 1 @label "Max Payout" @description "Highest ticket payout a single play can award" @tier "domain"
    minPayout      : number = 0 @label "Min Payout" @description "Lowest ticket payout a single play can award" @tier "domain"
    running        : boolean = true @label "Running" @description "When true, PLAY_MACHINE intents are applied; toggle to freeze the economy" @tier "domain"
    startTokens    : number = 14 @label "Start Tokens" @description "Tokens the player starts with" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-arcade-play.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-area-fill.orb orbitals[0].traits[0])
trait std-area-fill.traits.AreaFill {
  alias          : AreaFill
  linkedEntity   : AreaFillData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_FILLS RESTART AREA_FILLED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_FILLS) (active -> active on RESTART))
  emits          : (AREA_FILLED)
  config {
    fills          : [AreaFill] = [] @label "Fills" @description "One row per fill region: id, x-range (x0..x1 in world units), baseline the height is measured from, target area, rateMode (area | speed | ride — default area), optional hint, and the curve samples to interpolate. filled/frontier/reported are stamped at runtime. Seeded onto the entity on INIT; the live set is entity.fills — SET_FILLS replaces it at runtime (boards that import fills), and RESTART re-arms the live set rather than re-reading config, so injected fills survive respawns." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED paints every fill the player moves through; toggle to freeze every fill as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-area-fill.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-audio-cue.orb orbitals[0].traits[0])
trait std-audio-cue.traits.AudioCue {
  alias          : AudioCue
  linkedEntity   : AudioState
  category       : lifecycle
  states         : (active*)
  events         : (INIT CUE MUSIC STOP_MUSIC MUTE UNMUTE TOGGLE_MUTE SET_VOLUME RESTART AUDIO_MUTED)
  transitions    : ((active -> active on INIT) (active -> active on CUE) (active -> active on MUSIC) (active -> active on STOP_MUSIC) (active -> active on MUTE) (active -> active on UNMUTE) (active -> active on TOGGLE_MUTE) (active -> active on SET_VOLUME) (active -> active on RESTART))
  emits          : (AUDIO_MUTED)
  config {
    baseUrl        : string = "" @label "Base Url" @description "Prefix prepended to every manifest path." @tier "infra"
    initialMusic   : string = "" @label "Initial Music" @description "Manifest key auto-played as looping music on INIT/RESTART; empty plays none." @tier "presentation"
    initialMuted   : boolean = false @label "Initial Muted" @description "Muted state seeded on INIT/RESTART." @tier "presentation"
    initialVolume  : number = 1 @label "Initial Volume" @description "Master volume 0-1 seeded on INIT/RESTART." @tier "presentation"
    manifest       : Map<string,SoundEntry> = {} @label "Manifest" @description "Sound definitions keyed by logical name — path(s), volume, loop, pooling, autostart, crossfade." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-audio-cue.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-audit-capture.orb orbitals[0].traits[0])
trait std-audit-capture.traits.AuditCaptureListener {
  alias          : AuditCapture
  linkedEntity   : AuditEntry
  category       : lifecycle
  states         : (idle*)
  events         : (EntityMutated AuditRecorded)
  transitions    : ((idle -> idle on EntityMutated))
  emits          : (AuditRecorded)
  config {
    captureBeforeAfter : boolean = false @label "Store before-and-after snapshots?" @description "Store a full before-and-after snapshot of each change. More detail, but a larger audit log." @synonyms "before after, snapshot, diff, change snapshot, field diff" @tier "policy"
    captureEntity  : entity = "" @label "Entity to audit" @description "Type name of the entity whose mutations get logged" @tier "internal"
    captureEventTypes : [string] = [] @label "Event-kind filter" @description "When set, only these kinds are audited: the payload's `kind` field, or the delivering event's name when there is no kind. Empty list = capture every event." @tier "internal"
    enabled        : boolean = false @label "Track every change" @description "Keep an audit trail of every change to records — who changed what, and when. Off by default." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, audit, audit trail, log changes, track changes, who edited what, mutation log, change history, edit history, modification log, accountability log, record changes, log every edit, compliance log" @tier "policy"
    excludeFields  : [string] = [] @label "Skip fields" @description "Entity fields to omit from the before/after snapshots — e.g. passwords or other sensitive fields you do not want copied into the audit trail." @tier "internal"
    retentionDays  : number = 2555 @label "How long should the audit log be kept (days)?" @description "Number of days to retain audit entries. Default 2555 ≈ 7 years, typical for compliance." @synonyms "log retention, keep for, audit expiry, retention period, log lifetime" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-audit-capture.orb orbitals[0].traits[0])"
}

