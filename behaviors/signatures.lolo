;; From @almadar/std (behaviors/registry/ui/game/atoms/std-choice-gate.orb orbitals[0].traits[0])
trait std-choice-gate.traits.ChoiceGate {
  alias          : ChoiceGate
  linkedEntity   : ChoiceGateData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_GATES RESTART CHOICE_CORRECT CHOICE_WRONG)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_GATES) (active -> active on RESTART))
  emits          : (CHOICE_CORRECT CHOICE_WRONG)
  config {
    gates          : [ChoiceGate] = [] @label "Choice Gates" @description "One row per gate: id, gate center (x, y — y is the option-platform surface the judge tests against), the hint floated on a wrong answer, and the options: id, dx offset from the gate center, the label drawn above the platform, and correct. solved/chosen are stamped at runtime. Seeded onto the entity on INIT; the live set is entity.choices — SET_GATES replaces it at runtime (boards that import gates), and RESTART re-arms the live set rather than re-reading config, so injected gates survive respawns." @tier "domain"
    reachX         : number = 0.7 @label "Reach X" @description "Horizontal tolerance (world units) around an option platform's center when testing a landing (approximates the body's half-width plus a step)." @tier "domain"
    reachY         : number = 1.2 @label "Reach Y" @description "Vertical tolerance (world units) around the gate's option plane when testing a landing (covers small hops onto the platform surface)." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED judges option landings; toggle to freeze every gate as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-choice-gate.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-circuit-breaker.orb orbitals[0].traits[0])
trait std-circuit-breaker.traits.ServiceNodeCircuitBreaker {
  alias          : CircuitBreaker
  linkedEntity   : ServiceNode
  category       : interaction
  states         : (closed* open halfOpen)
  events         : (INIT ServiceNodeLoadFailed FAILURE SUCCESS TIMEOUT RESET ServiceNodeLoaded)
  transitions    : ((closed -> closed on INIT) (closed -> closed on ServiceNodeLoadFailed) (closed -> open on FAILURE) (closed -> closed on SUCCESS) (open -> halfOpen on TIMEOUT) (open -> closed on RESET) (halfOpen -> closed on SUCCESS) (halfOpen -> open on FAILURE) (halfOpen -> closed on RESET))
  emits          : (ServiceNodeLoaded ServiceNodeLoadFailed)
  config {
    cooldownSeconds : number = 30 @label "Cooldown (seconds)" @description "Seconds the circuit stays open before transitioning to half-open and probing for recovery." @synonyms "reset timeout, open duration" @tier "domain"
    failureThreshold : number = 5 @label "Failure threshold" @description "Number of consecutive failures before the circuit opens and starts rejecting requests." @synonyms "open trigger, failure count" @tier "domain"
    fallbackBehavior : string = "reject" @label "Fallback behavior" @description "What to return to callers while the circuit is open: reject = fail-fast/strict, cached-response = graceful degrade with stale data, queue = retry-later/no data loss, static-default = safe placeholder." @synonyms "open-state response, degraded mode, fail-fast vs graceful degrade" @tier "domain" @values (reject cached-response queue static-default)
    halfOpenRequests : number = 1 @label "Half-open probe requests" @description "Probe requests allowed through in the half-open state before deciding to close or re-open. Lower = cautious single-probe recovery; higher = aggressive parallel re-validation." @synonyms "probe count, recovery test size, probe aggressiveness, recovery test volume, cautious vs fast recovery" @tier "domain"
    statLook       : string = "elevated" @label "Stat display look" @description "Layer 2 visual treatment for stat / KPI cards." @tier "presentation" @values (elevated flat progress-backed gauge sparkline)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-circuit-breaker.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/game/atoms/std-coef-pad.orb orbitals[0].traits[0])
trait std-coef-pad.traits.CoefPadLock {
  alias          : CoefPad
  linkedEntity   : CoefPadData
  category       : lifecycle
  states         : (active*)
  events         : (INIT BODY_MOVED SET_PADS RESTART COEF_PAD_APPLIED COEF_PAD_SET_COMPLETED)
  transitions    : ((active -> active on INIT) (active -> active on BODY_MOVED) (active -> active on SET_PADS) (active -> active on RESTART))
  emits          : (COEF_PAD_APPLIED COEF_PAD_SET_COMPLETED)
  config {
    coefPads       : [CoefPad] = [] @label "Coefficient Pads" @description "One row per pad: id, center (x, y in world units), the mod applied to the road while inside x0..x1 (a scales slope+height, b compresses/stretch period, h shifts horizontally, k lifts), and the hint floated on apply, and hop (true = the board teleports the player onto the reshaped surface — use when the mod steps the road far from the pad; false = the skate snap carries the player, preserving speed). applied is stamped at runtime. Seeded onto the entity on INIT; the live set is entity.coefPads — SET_PADS replaces it at runtime (boards that import pads), and RESTART re-arms the live set rather than re-reading config, so injected pads survive respawns." @tier "domain"
    reachX         : number = 0.7 @label "Reach X" @description "Horizontal tolerance (world units) around a pad's center when testing player contact (approximates the body's half-width plus a step)." @tier "domain"
    reachY         : number = 1.2 @label "Reach Y" @description "Vertical tolerance (world units) around a pad's center when testing player contact (covers riding the surface the pad sits on)." @tier "domain"
    running        : boolean = true @label "Running" @description "When true, BODY_MOVED applies touched pads; toggle to freeze every pad as-is." @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/game/atoms/std-coef-pad.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/atoms/std-confirmation.orb orbitals[0].traits[0])
trait std-confirmation.traits.ConfirmActionConfirmation {
  alias          : Confirmation
  linkedEntity   : ConfirmAction
  category       : interaction
  states         : (idle* confirming)
  events         : (INIT ConfirmActionLoadFailed REQUEST CONFIRM CANCEL CLOSE ConfirmActionLoaded)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ConfirmActionLoadFailed) (idle -> confirming on REQUEST) (confirming -> idle on CONFIRM) (confirming -> idle on CANCEL) (confirming -> idle on CLOSE))
  emits          : (CONFIRM CANCEL ConfirmActionLoadFailed ConfirmActionLoaded)
  config {
    alertMessage   : string = "Are you sure?" @label "Alert message" @description "Body text explaining what the user is confirming" @tier "presentation"
    confirmLabel   : string = "Confirm" @label "Confirm button" @description "Label on the primary confirm action button" @tier "presentation"
    icon           : string = "alert-triangle" @label "Icon" @description "Icon name displayed in the confirmation modal header" @tier "presentation"
    title          : string = "Confirm Action" @label "Modal title" @description "Heading shown at the top of the confirmation modal" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-confirmation.orb orbitals[0].traits[0])"
}

