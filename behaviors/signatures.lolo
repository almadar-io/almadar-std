}

;; From @almadar/std (behaviors/registry/ml/atoms/std-ml-posterior.orb orbitals[0].traits[0])
trait std-ml-posterior.traits.PosteriorBelief {
  alias          : MlPosterior
  linkedEntity   : Posterior
  category       : lifecycle
  states         : (idle*)
  events         : (INIT OBSERVE MASTERY_REACHED REMEDIATION_NEEDED EVIDENCE_INSUFFICIENT)
  transitions    : ((idle -> idle on INIT) (idle -> idle on OBSERVE))
  emits          : (MASTERY_REACHED REMEDIATION_NEEDED EVIDENCE_INSUFFICIENT)
  config {
    intervalWidthMax : float = 0.3 @label "Max credible-interval width" @description "Above this width the posterior is too uncertain to decide — abstain with EVIDENCE_INSUFFICIENT." @tier "policy"
    masteryFloor   : float = 0.8 @label "Mastery floor" @description "Posterior mean at or above this, with a tight interval, licenses MASTERY_REACHED." @tier "policy"
    priorAlpha     : float = 1 @label "Prior alpha" @description "Beta prior success pseudo-count before any observation." @tier "domain"
    priorBeta      : float = 1 @label "Prior beta" @description "Beta prior failure pseudo-count before any observation." @tier "domain"
    remediationCeiling : float = 0.4 @label "Remediation ceiling" @description "Posterior mean at or below this, with a tight interval, licenses REMEDIATION_NEEDED." @tier "policy"
    sampleCount    : int = 200 @label "Posterior sample count" @description "Number of Monte Carlo draws from the Beta posterior used to estimate the credible interval." @tier "infra"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-ml-posterior.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ml/atoms/std-ml-similarity.orb orbitals[0].traits[0])
trait std-ml-similarity.traits.SimilarityRun {
  alias          : MlSimilarity
  linkedEntity   : SimilarityComparison
  category       : lifecycle
  states         : (idle* embedding resolved)
  events         : (INIT COMPARE EMBEDDED EMBED_FAILED RESET SIMILARITY_MATCHED SIMILARITY_ABSTAINED)
  transitions    : ((idle -> idle on INIT) (idle -> embedding on COMPARE) (idle -> resolved on COMPARE) (embedding -> resolved on EMBEDDED) (embedding -> resolved on EMBED_FAILED) (resolved -> resolved on INIT) (resolved -> idle on RESET))
  emits          : (EMBEDDED SIMILARITY_MATCHED SIMILARITY_ABSTAINED)
  config {
    embedModel     : string = "" @label "Embedding model" @description "Reserved for embedding-model selection; llm/embed takes only a texts array today, so this knob is not yet wired into the call" @tier "infra"
    floor          : float = 0.82 @label "Match floor" @description "Minimum cosine score for a confident match" @tier "policy"
    margin         : float = 0.05 @label "Match margin" @description "Minimum gap between the best and second-best score required to trust the match" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ml/atoms/std-ml-similarity.orb orbitals[0].traits[0])"
}

