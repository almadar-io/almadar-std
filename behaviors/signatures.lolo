  category       : interaction
  states         : (idle* loading reviewing error)
  events         : (INIT ModQueueItemLoaded ModQueueItemLoadFailed OPEN CLOSE APPROVE REJECT ESCALATE ModQueueItemReviewed ModQueueItemReviewFailed)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ModQueueItemLoaded) (idle -> idle on ModQueueItemLoadFailed) (idle -> loading on OPEN) (loading -> reviewing on ModQueueItemLoaded) (loading -> error on ModQueueItemLoadFailed) (loading -> idle on CLOSE) (reviewing -> reviewing on APPROVE) (reviewing -> reviewing on REJECT) (reviewing -> reviewing on ESCALATE) (reviewing -> loading on ModQueueItemReviewed) (reviewing -> reviewing on ModQueueItemReviewFailed) (reviewing -> idle on CLOSE) (error -> loading on OPEN) (error -> idle on CLOSE))
  emits          : (APPROVE REJECT ESCALATE CLOSE ModQueueItemLoaded ModQueueItemLoadFailed ModQueueItemReviewed ModQueueItemReviewFailed)
  config {
    autoEscalateThreshold : number = 5 @label "Auto-escalate at" @description "Flag count after which an item is auto-escalated to senior review" @tier "policy"
    enabled        : boolean = false @label "Enable moderation queue" @description "Send submissions to a review queue before they go live. Off by default." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, moderation, moderation queue, content review queue, flag for review, content moderation, review flagged content, abuse review, spam queue, report queue" @tier "policy"
    reviewSlot     : slot = "modal" @label "Review slot" @description "UI slot the moderation queue renders into. Defaults to the modal overlay so it never seizes the host's main content; summoned via OPEN, cleared via CLOSE." @tier "internal"
    tableLook      : string = "dense" @label "Table look" @description "Layer 2 visual treatment for the data table rendered by this atom." @tier "presentation" @values (dense spacious striped borderless card-rows)
    title          : string = "Moderation Queue" @label "Section title" @description "Heading shown above the moderation queue" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-mod-queue.orb orbitals[0].traits[0])"
}

