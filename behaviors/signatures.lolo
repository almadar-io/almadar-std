    traitName      : string = "" @label "Trait Name" @description "Name of the trait whose current frame to embed. Must match a trait declared in the current orbital. Compiler validates that the name exists at build time (see `ORB_BINDING_TRAIT_UNKNOWN`)." @tier "presentation"
