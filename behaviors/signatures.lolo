    destructive    : boolean @label "Destructive" @description "Destructive styling for confirmation dialogs" @tier "presentation"
    icon           : icon @label "Icon" @description "Icon to display. Accepts either: - A Lucide icon component (LucideIcon) - A string icon name (e.g., 'check-circle', 'x-circle')" @tier "presentation"
    look           : string = "icon-only" @label "Look" @description "Layer 2 visual treatment — orthogonal to the semantic variant (which carries status color)." @tier "presentation" @values (illustrated icon-only text-only mascot)
    message        : string @label "Message" @description "Alias for title - used by schema patterns" @tier "presentation"
    onAction       : event = "ACTION" @label "On Action" @description "onAction prop" @tier "presentation"
