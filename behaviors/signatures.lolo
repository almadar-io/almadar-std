;; From @almadar/std (behaviors/registry/infra/atoms/std-data-erasure.orb orbitals[0].traits[0])
trait std-data-erasure.traits.ErasureWorkflow {
  alias          : DataErasure
  linkedEntity   : ErasureRequest
  category       : interaction
  states         : (idle* execScanning loading browsing error)
  events         : (INIT ErasureLoaded ErasureLoadFailed OPEN ExecScanLoaded ExecScanFailed ExecStepped CLOSE CANCEL_ERASURE ErasureSaved ErasureSaveFailed ExecuteErasure)
  transitions    : ((idle -> idle on INIT) (idle -> idle on ErasureLoaded) (idle -> idle on ErasureLoadFailed) (idle -> loading on OPEN) (idle -> execScanning on ExecScanLoaded) (idle -> idle on ExecScanLoaded) (idle -> idle on ExecScanFailed) (execScanning -> execScanning on ExecStepped) (execScanning -> execScanning on ExecScanLoaded) (execScanning -> idle on ExecScanLoaded) (execScanning -> idle on ExecScanFailed) (loading -> browsing on ErasureLoaded) (loading -> error on ErasureLoadFailed) (loading -> idle on CLOSE) (browsing -> browsing on CANCEL_ERASURE) (browsing -> loading on ErasureSaved) (browsing -> browsing on ErasureSaveFailed) (browsing -> idle on CLOSE) (error -> loading on OPEN) (error -> idle on CLOSE))
  emits          : (CANCEL_ERASURE CLOSE ErasureLoaded ErasureLoadFailed ErasureSaved ErasureSaveFailed ExecuteErasure ExecScanLoaded ExecScanFailed ExecStepped)
  config {
    anonymizeVsDelete : string = "anonymize" @label "Anonymize or fully delete the record?" @description "anonymize = scrub PII fields and keep row for audit; delete = remove the row entirely." @synonyms "deletion mode, anonymize, delete, scrub or remove, retention mode" @tier "policy" @values (anonymize delete)
    enabled        : boolean = false @label "Allow data erasure (GDPR)" @description "Let people request that their data be permanently removed. Off by default." @synonyms "enable, turn on, enforce, require, activate, apply, switch on, gdpr, erasure, right to be forgotten, data deletion, scheduled deletion, retention purge, account deletion, anonymize user data, scrub PII, delete user data" @tier "policy"
    gracePeriodDays : number = 30 @label "How many days before deletion is carried out?" @description "Days between request submission and execution. The subject can cancel during this window." @synonyms "grace period, cancellation window, deletion delay, days before delete" @tier "policy"
    piiFields      : [string] = [] @label "Which fields contain personal data to scrub?" @description "Fields the target atom nulls when anonymizing (e.g. email, name, phone)." @synonyms "PII fields, personal data fields, sensitive fields, fields to scrub" @tier "policy"
    reviewSlot     : slot = "modal" @label "Review slot" @description "UI slot the erasure-requests queue renders into. Defaults to the modal overlay so it never seizes the host's main content; summoned via OPEN, cleared via CLOSE." @tier "internal"
    tableLook      : string = "dense" @label "Erasure queue table style" @description "Visual treatment for the erasure-requests data table." @synonyms "table style, grid look, compact, spacious" @tier "presentation" @values (dense spacious striped borderless card-rows)
    targetEntity   : string = "" @label "Target entity" @description "Entity name whose records erasure requests apply to (e.g. 'CustomerAccount')." @tier "internal"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-data-erasure.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/infra/atoms/std-data-import.orb orbitals[0].traits[0])
trait std-data-import.traits.DataImportLifecycle {
  alias          : DataImport
  linkedEntity   : ImportBatch
  category       : lifecycle
  states         : (idle* uploaded staged confirmed failed)
  events         : (INIT UPLOAD_CSV BATCH_CREATED STAGE_ROWS IMPORT_PERSIST_FAILED DISCARD_IMPORT ROWS_STAGED CONFIRM_IMPORT IMPORT_ROWS_FETCHED RESET IMPORT_CONFIRMED IMPORT_ROWS_PARSED IMPORT_FAILED)
  transitions    : ((idle -> idle on INIT) (idle -> uploaded on UPLOAD_CSV) (uploaded -> uploaded on BATCH_CREATED) (uploaded -> staged on STAGE_ROWS) (uploaded -> failed on STAGE_ROWS) (uploaded -> uploaded on IMPORT_PERSIST_FAILED) (uploaded -> idle on DISCARD_IMPORT) (staged -> staged on ROWS_STAGED) (staged -> confirmed on CONFIRM_IMPORT) (staged -> staged on IMPORT_PERSIST_FAILED) (staged -> idle on DISCARD_IMPORT) (confirmed -> confirmed on IMPORT_ROWS_FETCHED) (confirmed -> confirmed on IMPORT_PERSIST_FAILED) (confirmed -> idle on RESET) (confirmed -> confirmed on IMPORT_CONFIRMED) (confirmed -> confirmed on IMPORT_ROWS_PARSED) (failed -> idle on RESET) (failed -> failed on IMPORT_FAILED))
  emits          : (BATCH_CREATED ROWS_STAGED IMPORT_PERSIST_FAILED IMPORT_CONFIRMED IMPORT_ROWS_FETCHED IMPORT_ROWS_PARSED IMPORT_FAILED)
  config {
    fieldMappingJson : string = "{}" @label "Field mapping (JSON)" @description "JSON object mapping source CSV column names to target field names. Stored verbatim on the batch row (mappingJson); the atom applies it when it parses staged rows into IMPORT_ROWS_PARSED, so the consumer persists already-mapped rows into the target entity." @synonyms "field mapping, column mapping, map columns, remap fields, csv columns" @tier "domain"
    historyWindowDays : number = 0 @label "Historical data range (days)" @description "How many days back an import may reach (0 = unbounded). A declared import-config knob for the consumer's staging/mapping layer — the atom stages whatever rows it is handed and never filters by date." @synonyms "history window, historical range, import range, days back, lookback period" @tier "policy"
    sourceName     : string = "" @label "Source name" @description "Free-form name of the upstream source this import pulls from — whatever tool or file export the user names. Recorded on the batch row for provenance and echoed on IMPORT_CONFIRMED." @synonyms "source, origin, import from, provider name, data source" @tier "domain"
    targetEntity   : string = "" @label "Target entity" @description "Name of the consumer organism's entity the staged rows land in after confirm. Declarative contract only — the atom never writes the target entity; the consumer persists on IMPORT_CONFIRMED." @synonyms "destination, import into, target type" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-data-import.orb orbitals[0].traits[0])"
}

