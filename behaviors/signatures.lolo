;; From @almadar/std (behaviors/registry/ui/core/atoms/std-form-advanced.orb orbitals[0].traits[0])
trait std-form-advanced.traits.FormEntryFormAdvanced {
  alias          : FormAdvanced
  linkedEntity   : FormEntry
  category       : interaction
  states         : (editing* submitted)
  events         : (INIT CANCEL SUBMIT FormEntryLoaded FormEntryLoadFailed RESET FormEntrySaved FormEntrySaveFailed)
  transitions    : ((editing -> editing on INIT) (editing -> editing on CANCEL) (editing -> submitted on SUBMIT) (editing -> editing on FormEntryLoaded) (editing -> editing on FormEntryLoadFailed) (submitted -> editing on RESET) (submitted -> submitted on FormEntrySaved) (submitted -> submitted on FormEntrySaveFailed))
  emits          : (FormEntryLoaded FormEntryLoadFailed FormEntrySaved FormEntrySaveFailed)
  config {
    fields         : [FieldSpec] = [{"label":"Name","name":"name"},{"label":"Description","name":"description"},{"label":"Status","name":"status","type":"enum","values":["active","inactive","pending"]},{"label":"Notes","name":"notes","type":"textarea"},{"label":"Age","name":"age","type":"number"},{"label":"Is Active","name":"isActive","type":"boolean"},{"label":"Birth Date","name":"birthDate","type":"date"},{"label":"Priority","name":"priority","type":"enum","values":["low","medium","high","critical"]},{"label":"Category ID","name":"categoryId","relation":{"cardinality":"one","entity":"FormEntry"},"type":"relation"}] @label "Form fields" @description "Inputs to render; each entry follows the form-section field schema" @tier "presentation"
    fieldValidation : [ValidationSpec] = [] @label "Field validation" @description "Per-field rules (format, regex, length) shown inline on submit" @tier "domain"
    icon           : string = "file-text" @label "Header icon" @description "Icon shown beside the form title" @tier "presentation"
    title          : string = "Form" @label "Form title" @description "Heading shown above the form" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/atoms/std-form-advanced.orb orbitals[0].traits[0])"
}

