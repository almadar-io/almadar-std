    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    disabled       : boolean @label "Disabled" @description "Whether the button is disabled" @tier "presentation"
    icon           : icon @label "Icon" @description "Icon component or emoji" @tier "presentation"
    label          : string @label "Label" @description "Button label text" @tier "presentation"
    onPress        : event = "PRESS" @label "On Press" @description "Called when button is pressed" @tier "presentation"
    onRelease      : event = "RELEASE" @label "On Release" @description "Called when button is released" @tier "presentation"
    pressed        : boolean @label "Pressed" @description "Whether the button is currently pressed" @tier "presentation"
    pressEvent     : event = "PRESS" @label "Press Event" @description "Declarative event name emitted on press via useEventBus" @tier "presentation"
    releaseEvent   : event = "RELEASE" @label "Release Event" @description "Declarative event name emitted on release via useEventBus" @tier "presentation"
    shape          : string = "circle" @label "Shape" @description "Shape variant" @tier "presentation"
    size           : string = "md" @label "Size" @description "Size variant" @tier "presentation"
    variant        : string = "secondary" @label "Variant" @description "Visual variant" @tier "presentation"
  }
