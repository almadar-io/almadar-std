    gridWidth      : number = 4 @label "Grid Width" @description "Grid column count (matches TacticsAuthority.gridWidth)." @tier "presentation"
    hudBackgroundAsset : Asset = {} @label "HUD Background Asset" @description "HUD panel background sprite (theme chrome)." @tier "presentation"
    movementRange  : number = 3 @label "Movement Range" @description "Max manhattan distance the selected hero may travel in one move." @tier "domain"
