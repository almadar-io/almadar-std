}

form entity-inline {
  syntax  : "entity Name [persistent: collection] { id : string! field : type }"
  desc    : "Inline entity declaration. The optional [persistence: collection] tag sets persistence mode and database collection name."
  source  : "orbital-rust/crates/orbital-lolo/src/parser/entity.rs (parse_entity)"
}

form entity-extends {
  syntax  : "entity Name extends Alias.entity { extra : type }"
  desc    : "Inherit an imported entity, optionally rename it, and append fields. Supported at .orb level via EntityCall; .lolo parser support is pending."
