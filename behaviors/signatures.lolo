  transitions    : ((draft -> draft on INIT) (draft -> in_review on ReviewSubmitted) (in_review -> in_review on INIT) (in_review -> in_review on ReviewLogged) (in_review -> in_review on ReviewLogFailed) (in_review -> changes_requested on ReviewChangesRequested) (in_review -> approved on ReviewApproved) (changes_requested -> changes_requested on INIT) (changes_requested -> changes_requested on ReviewLogged) (changes_requested -> changes_requested on ReviewLogFailed) (changes_requested -> in_review on ReviewSubmitted) (approved -> approved on INIT) (approved -> approved on ReviewLogged) (approved -> approved on ReviewLogFailed))
  emits          : (ReviewLogged ReviewLogFailed ReviewRequested ReviewDecided)
