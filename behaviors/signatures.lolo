;; From @almadar/std (behaviors/registry/infra/atoms/std-global-search.orb orbitals[0].traits[0])
trait std-global-search.traits.GlobalSearch {
  alias          : GlobalSearch
  linkedEntity   : SearchQuery
  category       : lifecycle
  states         : (idle* searching)
  events         : (INIT SEARCH FAN_OUT_STEP SEARCH_RESULTS QUERY_SAVED QUERY_SAVE_FAILED MODULE_SEARCH_REQUESTED GLOBAL_SEARCH_COMPLETED)
  transitions    : ((idle -> idle on INIT) (idle -> searching on SEARCH) (searching -> searching on SEARCH) (searching -> searching on FAN_OUT_STEP) (searching -> searching on SEARCH_RESULTS) (searching -> searching on QUERY_SAVED) (searching -> searching on QUERY_SAVE_FAILED))
  emits          : (SEARCH MODULE_SEARCH_REQUESTED GLOBAL_SEARCH_COMPLETED QUERY_SAVED QUERY_SAVE_FAILED FAN_OUT_STEP)
  config {
    modules        : string = "" @label "Modules to search" @description "Comma-separated module keys to fan each query out to (e.g. \"contacts,projects,invoices\"). Each key gets one scoped MODULE_SEARCH_REQUESTED; the module owning a key subscribes to it and answers with SEARCH_RESULTS. Empty = no fan-out (the query is still persisted to history)." @synonyms "search modules, search scope, sources, providers, search providers, indexes, search targets, modules" @tier "internal"
    placeholder    : string = "Search across modules…" @label "Search placeholder" @description "Hint text in the search input." @synonyms "placeholder, hint text, input hint" @tier "presentation"
    saveHistory    : boolean = true @label "Keep recent searches" @description "Persist each query as a SearchQuery row so recent and saved searches survive reloads." @synonyms "search history, recent searches, saved searches, remember searches, keep history" @tier "policy"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-global-search.orb orbitals[0].traits[0])"
}

