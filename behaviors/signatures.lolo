;; From @almadar/std (behaviors/registry/ui/learning/atoms/ui-learning-canvas.orb orbitals[0].traits[0])
trait ui-learning-canvas.traits.LearningCanvasRender {
  alias          : UiLearningCanvas
  linkedEntity   : LearningCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT UPDATE @config.onShapeClick @config.onShapeHover)
  transitions    : ((idle -> idle on INIT) (idle -> idle on UPDATE))
  emits          : (@config.onShapeClick @config.onShapeHover)
  config {
    animate        : boolean = false @label "Animate" @description "Enable continuous redraw loop." @tier "presentation"
    backgroundColor : string @label "Background Color" @description "Background color (default transparent)." @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes." @tier "presentation"
    drawables      : [node] = [] @label "Drawables" @description "Neutral game-canvas drawables (e.g. `draw-sprite`, `draw-fx-layer`) painted in world coordinates via the supplied `projector`. This lets the learning canvas reuse the game drawable vocabulary without reimplementing sprites/FX." @tier "presentation"
    error          : LearningCanvasError @label "Error" @description "Error state." @tier "presentation"
    fontFamily     : string @label "Font Family" @description "Canvas text font family. Falls back to the theme's --font-family-body." @tier "presentation"
    height         : number = 400 @label "Height" @description "Canvas height in CSS pixels." @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "Enable pointer interaction (click/hover)." @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "Loading state." @tier "presentation"
    onShapeClick   : event = "SHAPE_CLICK" @label "On Shape Click" @description "Clicked shape payload: { id?, type?, index }." @tier "presentation"
    onShapeHover   : event = "SHAPE_HOVER" @label "On Shape Hover" @description "Hovered shape payload: { id?, type?, index }." @tier "presentation"
    projector      : LearningCanvasProjector @label "Projector" @description "World-to-pixel projector for `drawables`. When absent, `drawables` are ignored." @tier "presentation"
    readouts       : [LearningCanvasReadoutsItem] = [] @label "Readouts" @description "Top-right status chip row (live measurements, scores, counters)." @synonyms "chips, stats, measurements" @tier "presentation"
    shapes         : [LearningCanvasShapesItem] = [] @label "Shapes" @description "Declarative shapes to draw." @tier "presentation"
    traces         : [LearningCanvasTracesItem] = [] @label "Traces" @description "Inset sparkline panels stacked from the bottom-right corner." @synonyms "sparkline, time series, history plot" @tier "presentation"
    width          : number = 600 @label "Width" @description "Canvas width in CSS pixels." @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/ui-learning-canvas.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/learning/atoms/ui-math-canvas.orb orbitals[0].traits[0])
trait ui-math-canvas.traits.MathCanvasRender {
  alias          : UiMathCanvas
  linkedEntity   : MathCanvasItem
  category       : interaction
  states         : (idle*)
  events         : (INIT UPDATE @config.onShapeClick)
  transitions    : ((idle -> idle on INIT) (idle -> idle on UPDATE))
  emits          : (@config.onShapeClick)
  config {
    angles         : [MathCanvasAnglesItem] = [] @label "Angles" @description "Angle-sweep arcs at a vertex." @tier "presentation"
    animate        : boolean = false @label "Animate" @description "animate prop" @tier "presentation"
    axisColor      : string = "var(--color-muted-foreground, #374151)" @label "Axis Color" @description "Axis line color; resolves theme tokens (default `var(--color-muted-foreground, #374151)`)." @tier "presentation"
    backgroundColor : string @label "Background Color" @description "Canvas fill color; `var(--token, fallback)` strings resolve against the active theme. Default transparent." @tier "presentation"
    bars           : [MathCanvasBarsItem] = [] @label "Bars" @description "Riemann/histogram bar strips." @tier "presentation"
    className      : string @label "Class Name" @description "className prop" @tier "presentation"
    curves         : [MathCanvasCurvesItem] = [] @label "Curves" @description "curves prop" @tier "presentation"
    drawables      : [node] = [] @label "Drawables" @description "Game-canvas drawables painted in math world coordinates (e.g. `draw-sprite` for a character sprite on the graph). The canvas maps their `ScenePos` through the same x/y world→pixel transform used for curves/points." @tier "presentation"
    error          : MathCanvasError @label "Error" @description "error prop" @tier "presentation"
    fontFamily     : string @label "Font Family" @description "Canvas text font family. Accepts a known game-font key (e.g. 'future-narrow') or a CSS font-family string." @tier "presentation"
    gridColor      : string = "var(--color-border, #9ca3af)" @label "Grid Color" @description "Grid line color; resolves theme tokens (default `var(--color-border, #9ca3af)`)." @tier "presentation"
    gridStep       : number = 1 @label "Grid Step" @description "gridStep prop" @tier "presentation"
    guides         : [MathCanvasGuidesItem] = [] @label "Guides" @description "Fixed reference lines (vline/hline)." @tier "presentation"
    height         : number = 400 @label "Height" @description "height prop" @tier "presentation"
    hops           : [MathCanvasHopsItem] = [] @label "Hops" @description "Number-line jump arcs." @tier "presentation"
    interactive    : boolean = false @label "Interactive" @description "interactive prop" @tier "presentation"
    isLoading      : boolean @label "Is Loading" @description "isLoading prop" @tier "presentation"
    keyMap         : Map<string,string> = {"item":"INIT"} @label "Key Map" @description "Maps a keydown `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event (device-agnostic input), emitted as `UI:{event}` — same contract as the game canvas keyMap; keystrokes inside inputs/textareas never route." @tier "presentation"
    keyUpMap       : Map<string,string> = {"item":"INIT"} @label "Key Up Map" @description "Maps a keyup `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event, emitted as `UI:{event}`; keystrokes inside inputs/textareas never route." @tier "presentation"
    labelFontSize  : number = 12 @label "Label Font Size" @description "Base font size in px for all other canvas annotations (points, vectors, guides, curves, regions, angles, hops; default 12)." @tier "presentation"
    onShapeClick   : event = "SHAPE_CLICK" @label "On Shape Click" @description "onShapeClick prop" @tier "presentation"
    points         : [MathCanvasPointsItem] = [] @label "Points" @description "points prop" @tier "presentation"
    readouts       : [MathCanvasReadoutsItem] = [] @label "Readouts" @description "Top-right status chips, forwarded verbatim to LearningCanvas." @tier "presentation"
    regions        : [MathCanvasRegionsItem] = [] @label "Regions" @description "Filled areas under curves or between curve pairs." @tier "presentation"
    shapes         : [MathCanvasShapesItem] = [] @label "Shapes" @description "Extra declarative shapes in canvas pixel coordinates." @tier "presentation"
    showAxes       : boolean = true @label "Show Axes" @description "showAxes prop" @tier "presentation"
    showCurveLabels : boolean = false @label "Show Curve Labels" @description "Draw each curve's `label` at its last in-range sample (default false)." @tier "presentation"
    showGrid       : boolean = true @label "Show Grid" @description "showGrid prop" @tier "presentation"
    showTickLabels : boolean = false @label "Show Tick Labels" @description "Draw numeric labels on grid lines (default false)." @tier "presentation"
    tickLabelFontSize : number = 10 @label "Tick Label Font Size" @description "Font size in px for axis tick labels (default 10)." @tier "presentation"
    title          : string @label "Title" @description "title prop" @tier "presentation"
    traces         : [MathCanvasTracesItem] = [] @label "Traces" @description "Inset sparkline panels, forwarded verbatim to LearningCanvas." @tier "presentation"
    vectors        : [MathCanvasVectorsItem] = [] @label "Vectors" @description "vectors prop" @tier "presentation"
    width          : number = 600 @label "Width" @description "width prop" @tier "presentation"
    xMax           : number = 10 @label "X Max" @description "xMax prop" @tier "presentation"
    xMin           : number = -10 @label "X Min" @description "xMin prop" @tier "presentation"
    yMax           : number = 10 @label "Y Max" @description "yMax prop" @tier "presentation"
    yMin           : number = -10 @label "Y Min" @description "yMin prop" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/learning/atoms/ui-math-canvas.orb orbitals[0].traits[0])"
}

