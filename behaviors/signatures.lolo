    src            : asset = "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png" @label "Src" @description "URL to an SVG file. Fetched and inlined to enable stroke/fill animations." @tier "presentation"
    strokeColor    : string @label "Stroke Color" @description "Stroke color override for SVG paths" @tier "presentation"
    svgContent     : string @label "Svg Content" @description "Inline SVG string. Takes precedence over src if both provided." @tier "presentation"
