    language       : string @label "Language" @description "Language label (informational)." @tier "presentation"
    onRevert       : event = "REVERT" @label "On Revert" @description "Called when the user clicks the revert button (passes the 'before' id)." @tier "presentation"
    onSelectAfter  : event = "SELECT_AFTER" @label "On Select After" @description "Called when the user picks a different 'after' revision." @tier "presentation"
    onSelectBefore : event = "SELECT_BEFORE" @label "On Select Before" @description "Called when the user picks a different 'before' revision." @tier "presentation"
    revertEvent    : event = "REVERT" @label "Revert Event" @description "Event name dispatched via event bus when the user clicks revert. Payload: { id }." @tier "presentation"
    revisions      : [VersionDiffRevisionsItem] = [{"author":"Author","content":"Content","id":"Id","label":"Label","timestamp":"Timestamp"},{"author":"Author 2","content":"Content 2","id":"Id 2","label":"Label 2","timestamp":"Timestamp 2"}] @label "Revisions" @description "All available revisions (at least 2). Accepts either a typed array (direct consumers) or the runtime payload shape from a render-ui binding (`@payload.revisions`). Narrowed to `[]` internally when the value isn't an array." @tier "presentation"
    selectAfterEvent : event = "SELECT_AFTER" @label "Select After Event" @description "Event name dispatched via event bus when the 'after' revision changes. Payload: { id }." @tier "presentation"
    selectBeforeEvent : event = "SELECT_BEFORE" @label "Select Before Event" @description "Event name dispatched via event bus when the 'before' revision changes. Payload: { id }." @tier "presentation"
    view           : string = "side-by-side" @label "View" @description "Display mode." @tier "presentation" @values (side-by-side inline)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
