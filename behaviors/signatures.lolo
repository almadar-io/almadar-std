;; From @almadar/std (behaviors/registry/infra/atoms/std-migration-job.orb orbitals[0].traits[0])
trait std-migration-job.traits.MigrationJobLifecycle {
  alias          : MigrationJob
  linkedEntity   : MigrationJob
  category       : lifecycle
  states         : (idle* fetching mapping reviewing committing done failed)
  events         : (INIT MIGRATION_START DOCUMENTS_LISTED MIGRATION_FETCHED MIGRATION_DOCUMENT MIGRATION_CALL_FAILED FETCH_DOCUMENT DOCUMENT_FETCHED MIGRATION_STAGED MIGRATION_DISCARDED MIGRATION_APPROVED MIGRATION_REJECTED MIGRATION_REVIEW_READY CLOSE COMMITTED RESET MIGRATION_COMPLETED MIGRATION_RETRY MIGRATION_FAILED)
  transitions    : ((idle -> idle on INIT) (idle -> fetching on MIGRATION_START) (fetching -> mapping on DOCUMENTS_LISTED) (fetching -> mapping on MIGRATION_FETCHED) (fetching -> mapping on MIGRATION_DOCUMENT) (fetching -> failed on MIGRATION_CALL_FAILED) (mapping -> mapping on FETCH_DOCUMENT) (mapping -> mapping on DOCUMENT_FETCHED) (mapping -> reviewing on MIGRATION_STAGED) (mapping -> idle on MIGRATION_DISCARDED) (mapping -> failed on MIGRATION_CALL_FAILED) (reviewing -> committing on MIGRATION_APPROVED) (reviewing -> mapping on MIGRATION_REJECTED) (reviewing -> reviewing on MIGRATION_REVIEW_READY) (reviewing -> idle on MIGRATION_DISCARDED) (reviewing -> idle on CLOSE) (committing -> done on COMMITTED) (committing -> failed on MIGRATION_CALL_FAILED) (done -> idle on RESET) (done -> done on MIGRATION_COMPLETED) (failed -> fetching on MIGRATION_RETRY) (failed -> idle on RESET) (failed -> failed on MIGRATION_FAILED))
  emits          : (DOCUMENTS_LISTED DOCUMENT_FETCHED COMMITTED MIGRATION_CALL_FAILED MIGRATION_FETCHED MIGRATION_DOCUMENT MIGRATION_REVIEW_READY MIGRATION_COMPLETED MIGRATION_FAILED)
  config {
    connectionRef  : secret = "" @label "Connection reference" @description "Secret-store / environment KEY holding the source credentials. The reference is stored; the secret itself never enters config, traces, or snapshots — the migration service resolves it at run time. (Typed `secret` — the config-field type that marks a credential reference; UI password-renders it and traces mask it.)" @synonyms "credential key, connection string reference, secret name" @tier "internal"
    reviewSlot     : slot = "modal" @label "Review slot" @description "UI slot the staged-import review renders into when the host stages the full units/skipped rows (not stats-only). Defaults to the modal overlay so a host that never places this trait on a page — or that only ever sends {stats} — stays effectively headless; the rendered tree's confirm/cancel wire to the atom's own MIGRATION_APPROVED/MIGRATION_DISCARDED events." @synonyms "preview slot, review outlet, staging modal, import review slot" @tier "internal"
    target         : string = "" @label "Target entity" @description "Name of the host entity this import writes into (e.g. the organism's own entity). The migration service derives the full target descriptor from the running app's schema." @synonyms "destination, import into, target type" @tier "domain"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/infra/atoms/std-migration-job.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ml/atoms/std-ml-classify.orb orbitals[0].traits[0])
trait std-ml-classify.traits.ClassifyRun {
