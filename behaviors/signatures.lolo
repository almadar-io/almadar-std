    actionPayload  : @payload(action) @label "Action Payload" @description "Payload to include with the action event" @tier "presentation"
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    label          : string @label "Label" @description "Accessible label" @tier "presentation"
    max            : number = 5 @label "Max" @description "Maximum number of stars" @tier "presentation"
    onChange       : event = "CHANGE" @label "On Change" @description "Direct onChange callback" @tier "presentation"
    precision      : string = "full" @label "Precision" @description "Full or half-star precision" @tier "presentation" @values (full half)
    readOnly       : boolean = false @label "Read Only" @description "Read-only display mode" @tier "presentation"
    size           : string = "md" @label "Size" @description "Star size" @tier "presentation" @values (sm md lg)
    value          : number = 0 @label "Value" @description "Current rating value" @tier "presentation"
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-star-rating.orb orbitals[0].traits[0])"
}

;; From @almadar/std (behaviors/registry/ui/core/molecules/ui-stat-display.orb orbitals[0].traits[0])
trait ui-stat-display.traits.StatDisplayRender {
  alias          : UiStatDisplay
  linkedEntity   : StatDisplayItem
  category       : interaction
  states         : (idle*)
  events         : (INIT)
  transitions    : ((idle -> idle on INIT))
  config {
    className      : string @label "Class Name" @description "Additional CSS classes" @tier "presentation"
    clickEvent     : string @label "Click Event" @description "Event name emitted as `UI:{clickEvent}` with `{ metricLabel }` when the card is clicked." @tier "presentation"
    compact        : boolean = false @label "Compact" @description "Compact mode (inline, no card wrapper)" @tier "presentation"
    error          : StatDisplayError @label "Error" @description "Error state" @tier "presentation"
    format         : string @label "Format" @description "Display format: 'number', 'currency', 'percent'" @tier "presentation"
    icon           : icon @label "Icon" @description "Lucide icon name or component" @tier "presentation"
    iconBg         : string = "bg-muted" @label "Icon Bg" @description "Icon background color class" @tier "presentation"
    iconColor      : string = "text-foreground" @label "Icon Color" @description "Icon color class" @tier "presentation"
    isLoading      : boolean = false @label "Is Loading" @description "Loading state" @tier "presentation"
    label          : string = "" @label "Label" @description "Display label (e.g., 'Total', 'Remaining')" @tier "presentation"
    look           : string = "elevated" @label "Look" @description "Layer 2 visual treatment." @tier "presentation" @values (elevated flat progress-backed gauge sparkline)
    max            : number @label "Max" @description "Optional denominator. >0 renders 'value / max'; 0 or omitted hides the divider." @tier "presentation"
    prefix         : string @label "Prefix" @description "Prefix prepended to the formatted value (e.g. '≈ ')." @tier "presentation"
    size           : string = "md" @label "Size" @description "Size variant" @tier "presentation" @values (sm md lg)
    sparklineData  : [number] = [] @label "Sparkline Data" @description "Optional inline sparkline data appended to the trend row. Length < 2 renders nothing." @tier "presentation"
    suffix         : string @label "Suffix" @description "Suffix appended to the formatted value (e.g. ' /mo', ' ms')." @tier "presentation"
    target         : number @label "Target" @description "Optional progress target. >0 renders a progress bar at value/target." @tier "presentation"
    trend          : number @label "Trend" @description "Signed delta vs previous period. >0 renders ↑ green, <0 renders ↓ red, 0 hides. Polarity reversal via `trendPolarity`." @tier "presentation"
    trendFormat    : string = "absolute" @label "Trend Format" @description "When `'percent'`, renders trend with a `%` suffix (e.g. `↓ 3.3%`); default is `'absolute'`." @tier "presentation" @values (absolute percent)
    trendPolarity  : string = "higher-is-better" @label "Trend Polarity" @description "Controls whether `trend > 0` is 'good' (default) or 'bad'. `lower-is-better` inverts the color logic." @tier "presentation" @values (higher-is-better lower-is-better)
    value          : scalar = "" @label "Value" @description "Primary value (number or formatted string)" @tier "presentation"
    variant        : string = "default" @label "Variant" @description "Color variant" @tier "presentation" @values (default primary success warning error info)
  }
  override-surface : (linkedEntity name events effects listens emitsScope config)
  source         : "@almadar/std (behaviors/registry/ui/core/molecules/ui-stat-display.orb orbitals[0].traits[0])"
}

