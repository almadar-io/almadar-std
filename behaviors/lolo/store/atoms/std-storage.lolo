app std-storage [
  version: "1.0.0",
  description: "std-storage — S3-compatible object storage over SigV4-signed HTTP (AWS S3, MinIO, any S3 emulator through the origin knob). STORAGE_UPLOAD stores one object (a file payload with a base64 data URL, or a key + content pair), STORAGE_UPLOAD_MANY stores a batch of file payloads one after another, STORAGE_DOWNLOAD returns an object as base64, STORAGE_LIST lists keys, STORAGE_DELETE removes one, STORAGE_GET_SIGNED_URL presigns a get or put URL. Every action answers with its result event, or STORAGE_FAILED ({code, message}) when the store refuses, is unreachable or the input cannot be uploaded.",
  egress: ["http://127.0.0.1:9000", "https://s3.us-east-1.amazonaws.com"]
]
type StorageMetadata = Map string string
type S3ErrorDoc = { Code : string, Message : string, message : string }
type S3Entry = { Key : string, Size : string, LastModified : string }
type S3Listing = { Contents : [S3Entry], IsTruncated : string, NextContinuationToken : string }
type StorageFile = { name : string, size : number, type : string, content : string }
type StorageKey = { key : string, size : number, lastModified : number }
type StorageItem = { id : string, key : string, url : string, name : string, sizeBytes : number, mimeType : string }
type StoragePending = { mode : string, bucket : string!, key : string!, size : number, isPublic : boolean, fileName : string, fileSize : number, fileKind : string, etag : string, batch : string }
type StorageBatch = { files : [StorageFile]!, idx : number, acl : string, maxSize : number, bucket : string, items : [StorageItem]! }
orbital StorageOrbital {
  entity StorageObject [runtime] {
    id : string!
  }

  trait StorageClient -> @rebindable StorageObject [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      STORAGE_UPLOAD -> idle
        (emit STORAGE_RESOLVE {
          mode: "single",
          bucket: (str/default @payload.bucket @config.bucket),
          hasFile: (and (!= @payload.file null) (validate/required (object/get @payload.file name null))),
          fileName: (object/get @payload.file name ""),
          fileSize: (object/get @payload.file size 0),
          fileType: (str/default (object/get @payload.file type "") "application/octet-stream"),
          hasContent: (validate/required @payload.content),
          raw: (if (and (!= @payload.file null) (validate/required (object/get @payload.file name null))) (object/get @payload.file content "") (str/default @payload.content "")),
          key: (str/default @payload.key ""),
          contentType: (str/default @payload.contentType ""),
          acl: (str/default @payload.acl ""),
          maxSize: (or @payload.maxSize 0),
          batch: ""
        })

      STORAGE_RESOLVE -> idle when (and @payload.hasFile (> @payload.maxSize 0) (> @payload.fileSize @payload.maxSize))
        (emit STORAGE_FAILED { code: null, message: (str/concat "Upload rejected: " @payload.fileName " is " @payload.fileSize " bytes (max " @payload.maxSize ")") })
      STORAGE_RESOLVE -> idle when (and (and @payload.hasFile (not (and (> @payload.maxSize 0) (> @payload.fileSize @payload.maxSize)))) (= @payload.raw ""))
        (emit STORAGE_FAILED { code: null, message: (str/concat "Upload rejected: file payload for '" @payload.fileName "' carries no content — the uploader must include the base64 data URL") })
      STORAGE_RESOLVE -> idle when (and (or (and (and @payload.hasFile (not (and (> @payload.maxSize 0) (> @payload.fileSize @payload.maxSize)))) (!= @payload.raw "")) (and (not @payload.hasFile) (!= @payload.key "") @payload.hasContent)) (and (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (not (str/uri-component-valid (str/join (array/drop (str/split @payload.raw ",") 1) ",")))))
        (emit STORAGE_FAILED { code: null, message: "URI malformed" })
      STORAGE_RESOLVE -> idle when (and (or (and (and @payload.hasFile (not (and (> @payload.maxSize 0) (> @payload.fileSize @payload.maxSize)))) (!= @payload.raw "")) (and (not @payload.hasFile) (!= @payload.key "") @payload.hasContent)) (and (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (not (validate/pattern (str/join (array/drop (str/split @payload.raw ",") 1) ",") "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"))))
        (emit STORAGE_FAILED { code: "INVALID_BASE64", message: "Upload rejected: the data URL base64 payload is malformed" })
      STORAGE_RESOLVE -> idle when (and (or (and (and @payload.hasFile (not (and (> @payload.maxSize 0) (> @payload.fileSize @payload.maxSize)))) (!= @payload.raw "")) (and (not @payload.hasFile) (!= @payload.key "") @payload.hasContent)) (not (and (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (not (str/uri-component-valid (str/join (array/drop (str/split @payload.raw ",") 1) ","))))) (not (and (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (not (validate/pattern (str/join (array/drop (str/split @payload.raw ",") 1) ",") "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$")))))
        (emit STORAGE_PUT {
          mode: @payload.mode,
          bucket: @payload.bucket,
          key: (if @payload.hasFile (str/concat @now "-" (str/join (array/map (array/filter (str/split @payload.fileName "") (fn c (!= @c ""))) (fn c (if (str/includes "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._-" @c) @c (if (= (str/len (str/encode-uri-component @c)) 12) "__" "_")))) "")) @payload.key),
          b64: (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/join (array/drop (str/split @payload.raw ",") 1) ",") (base64/encode (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (str/decode-uri-component (str/join (array/drop (str/split @payload.raw ",") 1) ",")) @payload.raw))),
          contentType: (if @payload.hasFile (if (and (or (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";")))) (!= (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) (str/slice (array/nth (str/split @payload.raw ",") 0) 5)) "")) (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) (str/slice (array/nth (str/split @payload.raw ",") 0) 5)) @payload.fileType) (if (!= @payload.contentType "") @payload.contentType (if (and (or (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";")))) (!= (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) (str/slice (array/nth (str/split @payload.raw ",") 0) 5)) "")) (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) (str/slice (array/nth (str/split @payload.raw ",") 0) 5)) "application/octet-stream"))),
          size: (- (math/floor (/ (* (str/len (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/join (array/drop (str/split @payload.raw ",") 1) ",") (base64/encode (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (str/decode-uri-component (str/join (array/drop (str/split @payload.raw ",") 1) ",")) @payload.raw)))) 3) 4)) (if (str/endsWith (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/join (array/drop (str/split @payload.raw ",") 1) ",") (base64/encode (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (str/decode-uri-component (str/join (array/drop (str/split @payload.raw ",") 1) ",")) @payload.raw))) "==") 2 (if (str/endsWith (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/join (array/drop (str/split @payload.raw ",") 1) ",") (base64/encode (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (str/decode-uri-component (str/join (array/drop (str/split @payload.raw ",") 1) ",")) @payload.raw))) "=") 1 0))),
          etag: (str/concat "\"" (hash/md5 (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64") (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5 (- (str/len (array/nth (str/split @payload.raw ",") 0)) 7)) ";"))) (str/join (array/drop (str/split @payload.raw ",") 1) ",") (base64/encode (if (and (and (str/startsWith @payload.raw "data:") (str/includes @payload.raw ",")) (not (str/endsWith (array/nth (str/split @payload.raw ",") 0) ";base64")) (not (str/includes (str/slice (array/nth (str/split @payload.raw ",") 0) 5) ";"))) (str/decode-uri-component (str/join (array/drop (str/split @payload.raw ",") 1) ",")) @payload.raw))) "hex") "\""),
          isPublic: (= @payload.acl "public"),
          fileName: @payload.fileName,
          fileSize: @payload.fileSize,
          fileKind: @payload.fileType,
          batch: @payload.batch
        })
      STORAGE_RESOLVE -> idle when (and (not @payload.hasFile) (not (and (not @payload.hasFile) (!= @payload.key "") @payload.hasContent)))
        (emit STORAGE_FAILED { code: null, message: "upload requires either `file` (with content) or the `key` + `content` pair" })

      STORAGE_PUT -> idle when (= @payload.bucket "")
        (emit STORAGE_FAILED { code: null, message: "No value provided for input HTTP label: Bucket." })
      STORAGE_PUT -> idle when (and (!= @payload.bucket "") (not @payload.isPublic))
        (http PUT (if (!= @config.endpoint "") @config.endpoint (if (and (>= (str/len @payload.bucket) 3) (<= (str/len @payload.bucket) 63) (not (str/startsWith @payload.bucket "-")) (not (str/endsWith @payload.bucket "-")) (array/every (array/filter (str/split @payload.bucket "") (fn c (!= @c ""))) (fn c (str/includes "abcdefghijklmnopqrstuvwxyz0123456789-" @c)))) (str/concat "https://" @payload.bucket ".s3." @config.region ".amazonaws.com") (str/concat "https://s3." @config.region ".amazonaws.com"))) (if (or (!= @config.endpoint "") (not (and (>= (str/len @payload.bucket) 3) (<= (str/len @payload.bucket) 63) (not (str/startsWith @payload.bucket "-")) (not (str/endsWith @payload.bucket "-")) (array/every (array/filter (str/split @payload.bucket "") (fn c (!= @c ""))) (fn c (str/includes "abcdefghijklmnopqrstuvwxyz0123456789-" @c)))))) (str/concat "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @payload.bucket) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @payload.key) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "%2F" "/")) (str/concat "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @payload.key) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "%2F" "/"))) {
            query: { "x-id": "PutObject" },
            queryEncoding: rfc3986,
            headers: { "Content-Type": @payload.contentType },
            bytes: @payload.b64,
            auth: { scheme: aws-sigv4, accessKeyId: @config.accessKeyId, secretAccessKey: @config.secretAccessKey, region: @config.region, service: "s3" },
            timeoutMs: @config.timeoutMs,
            retry: { max: 2, on: [500, 502, 503, 504, 429, "timeout", "failed"], backoffMs: 100 }
          } { key: (json/stringify { mode: @payload.mode, bucket: @payload.bucket, key: @payload.key, size: @payload.size, isPublic: false, fileName: @payload.fileName, fileSize: @payload.fileSize, fileKind: @payload.fileKind, etag: @payload.etag, batch: @payload.batch }), emit: { success: STORAGE_PUT_REPLIED, failure: STORAGE_HTTP_FAILED } })
      STORAGE_PUT -> idle when (and (!= @payload.bucket "") @payload.isPublic)
        (http PUT (if (!= @config.endpoint "") @config.endpoint (if (and (>= (str/len @payload.bucket) 3) (<= (str/len @payload.bucket) 63) (not (str/startsWith @payload.bucket "-")) (not (str/endsWith @payload.bucket "-")) (array/every (array/filter (str/split @payload.bucket "") (fn c (!= @c ""))) (fn c (str/includes "abcdefghijklmnopqrstuvwxyz0123456789-" @c)))) (str/concat "https://" @payload.bucket ".s3." @config.region ".amazonaws.com") (str/concat "https://s3." @config.region ".amazonaws.com"))) (if (or (!= @config.endpoint "") (not (and (>= (str/len @payload.bucket) 3) (<= (str/len @payload.bucket) 63) (not (str/startsWith @payload.bucket "-")) (not (str/endsWith @payload.bucket "-")) (array/every (array/filter (str/split @payload.bucket "") (fn c (!= @c ""))) (fn c (str/includes "abcdefghijklmnopqrstuvwxyz0123456789-" @c)))))) (str/concat "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @payload.bucket) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @payload.key) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "%2F" "/")) (str/concat "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @payload.key) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "%2F" "/"))) {
            query: { "x-id": "PutObject" },
            queryEncoding: rfc3986,
            headers: { "Content-Type": @payload.contentType, "x-amz-acl": "public-read" },
            bytes: @payload.b64,
            auth: { scheme: aws-sigv4, accessKeyId: @config.accessKeyId, secretAccessKey: @config.secretAccessKey, region: @config.region, service: "s3" },
            timeoutMs: @config.timeoutMs,
            retry: { max: 2, on: [500, 502, 503, 504, 429, "timeout", "failed"], backoffMs: 100 }
          } { key: (json/stringify { mode: @payload.mode, bucket: @payload.bucket, key: @payload.key, size: @payload.size, isPublic: true, fileName: @payload.fileName, fileSize: @payload.fileSize, fileKind: @payload.fileKind, etag: @payload.etag, batch: @payload.batch }), emit: { success: STORAGE_PUT_REPLIED, failure: STORAGE_HTTP_FAILED } })
      STORAGE_PUT_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (object/get (json/parse @payload.key StoragePending) isPublic false))
        (let ((u (json/parse @payload.key StoragePending)))
          (emit STORAGE_PUT_DONE { url: (if (!= @config.publicUrlBase "") (str/concat (if (str/endsWith @config.publicUrlBase "/") (str/slice @config.publicUrlBase 0 (- (str/len @config.publicUrlBase) 1)) @config.publicUrlBase) "/" @u.key) (if (!= @config.endpoint "") (str/concat (if (str/endsWith @config.endpoint "/") (str/slice @config.endpoint 0 (- (str/len @config.endpoint) 1)) @config.endpoint) "/" @u.bucket "/" @u.key) (str/concat "https://" @u.bucket ".s3." @config.region ".amazonaws.com/" @u.key))), state: (json/stringify @u) }))
      STORAGE_PUT_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (not (object/get (json/parse @payload.key StoragePending) isPublic false)))
        (let ((u (json/parse @payload.key StoragePending)))
          (http GET (if (!= @config.endpoint "") @config.endpoint (if (and (>= (str/len @u.bucket) 3) (<= (str/len @u.bucket) 63) (not (str/startsWith @u.bucket "-")) (not (str/endsWith @u.bucket "-")) (array/every (array/filter (str/split @u.bucket "") (fn c (!= @c ""))) (fn c (str/includes "abcdefghijklmnopqrstuvwxyz0123456789-" @c)))) (str/concat "https://" @u.bucket ".s3." @config.region ".amazonaws.com") (str/concat "https://s3." @config.region ".amazonaws.com"))) (if (or (!= @config.endpoint "") (not (and (>= (str/len @u.bucket) 3) (<= (str/len @u.bucket) 63) (not (str/startsWith @u.bucket "-")) (not (str/endsWith @u.bucket "-")) (array/every (array/filter (str/split @u.bucket "") (fn c (!= @c ""))) (fn c (str/includes "abcdefghijklmnopqrstuvwxyz0123456789-" @c)))))) (str/concat "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @u.bucket) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @u.key) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "%2F" "/")) (str/concat "/" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/encode-uri-component @u.key) "!" "%21") "*" "%2A") "'" "%27") "(" "%28") ")" "%29") "%2F" "/"))) {
              query: { "x-amz-checksum-mode": "ENABLED", "x-id": "GetObject" },
              auth: { scheme: aws-sigv4, accessKeyId: @config.accessKeyId, secretAccessKey: @config.secretAccessKey, region: @config.region, service: "s3" },
              presign: { expiresSec: 3600 }
            } { key: (json/stringify @u), emit: { success: STORAGE_PUT_PRESIGNED, failure: STORAGE_HTTP_FAILED } }))
      STORAGE_PUT_REPLIED -> idle when (or (< @payload.status 200) (>= @payload.status 300))
        (emit STORAGE_HTTP_ERROR { text: @payload.body })
      STORAGE_PUT_PRESIGNED -> idle
        (emit STORAGE_PUT_DONE { url: @payload.url, state: @payload.key })
      STORAGE_PUT_DONE -> idle when (= (object/get (json/parse @payload.state StoragePending) mode "single") "single")
        (let ((u (json/parse @payload.state StoragePending)))
          (emit STORAGE_UPLOADED { key: @u.key, bucket: @u.bucket, size: @u.size, etag: @u.etag, id: @u.key, url: @payload.url }))
      STORAGE_PUT_DONE -> idle when (= (object/get (json/parse @payload.state StoragePending) mode "single") "batch")
        (let ((u (json/parse @payload.state StoragePending)))
          (let ((b (json/parse @u.batch StorageBatch)))
            (emit STORAGE_BATCH_NEXT { batch: (json/stringify { files: @b.files, idx: (+ @b.idx 1), acl: @b.acl, maxSize: @b.maxSize, bucket: @b.bucket, items: (array/append @b.items { id: @u.key, key: @u.key, url: @payload.url, name: @u.fileName, sizeBytes: @u.fileSize, mimeType: @u.fileKind }) }) })))

      STORAGE_UPLOAD_MANY -> idle when (= (array/len (array/filter (or @payload.files []) (fn f (validate/required (object/get @f name null))))) 0)
        (emit STORAGE_FAILED { code: null, message: "uploadMany requires a non-empty `files` array (UploadDropZone batch shape)" })
      STORAGE_UPLOAD_MANY -> idle when (> (array/len (array/filter (or @payload.files []) (fn f (validate/required (object/get @f name null))))) 0)
        (emit STORAGE_BATCH_NEXT { batch: (json/stringify { files: (array/filter @payload.files (fn f (validate/required (object/get @f name null)))), idx: 0, acl: (str/default @payload.acl ""), maxSize: (or @payload.maxSize 0), bucket: (str/default @payload.bucket @config.bucket), items: [] }) })
