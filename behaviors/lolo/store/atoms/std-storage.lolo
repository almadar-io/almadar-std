    }

    emits {
      STORAGE_UPLOADED -> external {
        key : string!
        bucket : string!
        size : number!
        etag : string!
        id : string!
        url : string!
      }
        @description "The stored object: its key, bucket, byte size, the ETag the store answered with, and a url (public base or origin url for a public acl, otherwise a one-hour presigned get)."
        @synonyms "file uploaded, object stored, upload complete"
        @tier "primary"
      STORAGE_UPLOADED_MANY -> external {
        items : [StorageItem]!
        count : number!
      }
        @description "The batch result: one item per uploaded file, in order, with the declared size and mime type."
        @synonyms "files uploaded, batch stored, upload batch complete"
        @tier "primary"
      STORAGE_DOWNLOADED -> external {
        content : string!
        contentType : string!
        size : number!
        metadata : Map string string!
      }
        @description "The object body as base64, its content type (octet-stream when the store sent none) and byte size; metadata is always empty."
        @synonyms "file downloaded, object content, fetched object"
        @tier "primary"
      STORAGE_LISTED -> external {
        keys : [StorageKey]!
        truncated : boolean!
        nextToken : string
      }
        @description "One page of keys with size and last-modified epoch ms; nextToken is present only on a truncated page."
        @synonyms "list objects, bucket listing, keys page"
        @tier "primary"
      STORAGE_DELETED -> external {
        deleted : boolean!
      }
        @description "The delete was accepted by the store."
        @synonyms "object deleted, file removed"
        @tier "primary"
      STORAGE_SIGNED_URL -> external {
        url : string!
        expiresAt : number!
      }
        @description "A presigned url and the epoch-ms instant it stops working."
        @synonyms "presigned url, signed link, upload url"
        @tier "primary"
      STORAGE_FAILED -> external {
        code : string
        message : string!
      }
        @description "An action failed: the store refused, could not be reached, a credential is missing, or the upload input was rejected."
        @synonyms "storage error, upload failed, s3 error"
        @tier "primary"
      STORAGE_RESOLVE {
        mode : string!
        bucket : string!
        hasFile : boolean!
        fileName : string!
        fileSize : number!
        fileType : string!
        hasContent : boolean!
        raw : string!
        key : string!
        contentType : string!
        acl : string!
        maxSize : number!
        batch : string!
      }
        @description "Internal: an upload input to validate and turn into a put."
        @tier "secondary"
      STORAGE_PUT {
        mode : string!
        bucket : string!
        key : string!
        b64 : string!
        contentType : string!
        size : number!
        etag : string!
        isPublic : boolean!
        fileName : string!
        fileSize : number!
        fileKind : string!
        batch : string!
      }
        @description "Internal: a validated object ready to put."
        @tier "secondary"
      STORAGE_PUT_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: the put's HTTP reply."
        @tier "secondary"
      STORAGE_PUT_PRESIGNED {
        url : string!
        key : string!
      }
        @description "Internal: the presigned get url of an uploaded object."
        @tier "secondary"
      STORAGE_PUT_DONE {
        url : string!
        state : string!
      }
        @description "Internal: an upload finished with its url."
        @tier "secondary"
      STORAGE_BATCH_NEXT {
        batch : string!
      }
        @description "Internal: the next file of a batch upload."
        @tier "secondary"
      STORAGE_DOWNLOAD_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the download's HTTP reply (body is base64)."
        @tier "secondary"
      STORAGE_LIST_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the listing's HTTP reply."
        @tier "secondary"
      STORAGE_DELETE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
        @description "Internal: the delete's HTTP reply."
        @tier "secondary"
      STORAGE_SIGNED_REPLIED {
        url : string!
        key : string
      }
        @description "Internal: the presigned url."
        @tier "secondary"
      STORAGE_HTTP_ERROR {
        text : string!
      }
        @description "Internal: a non-2xx reply body to turn into a failure message."
        @tier "secondary"
      STORAGE_HTTP_FAILED {
        error : string!
        kind : string!
        credential : string
        key : string
      }
        @description "Internal: a storage call never produced a reply."
        @tier "secondary"
    }

    listens {
      STORAGE_UPLOAD -> input {
        bucket : string
        key : string
        content : string
        contentType : string
        metadata : Map string string
        file : StorageFile
        acl : string
        maxSize : number
        requestId : string
      }
        @description "Store one object: a file payload (name, size, type, content as a base64 data URL; the key becomes <epoch ms>-<sanitised name>) or a key + content pair. acl public returns a public url."
        @synonyms "upload file, put object, store file"
      STORAGE_UPLOAD_MANY -> input {
        bucket : string
        files : [StorageFile]
        acl : string
        maxSize : number
      }
        @description "Store a batch of file payloads in order; the first failure stops the batch."
        @synonyms "upload files, batch upload, drop zone upload"
      STORAGE_DOWNLOAD -> input {
        bucket : string
        key : string!
        requestId : string
      }
        @description "Fetch an object as base64."
        @synonyms "download file, get object, read file"
      STORAGE_LIST -> input {
        bucket : string
        prefix : string
        maxKeys : number
        continuationToken : string
        requestId : string
      }
        @description "List a page of keys; maxKeys defaults to 1000."
        @synonyms "list files, list objects, browse bucket"
      STORAGE_DELETE -> input {
        bucket : string
        key : string!
        requestId : string
      }
        @description "Delete an object."
        @synonyms "delete file, remove object"
      STORAGE_GET_SIGNED_URL -> input {
        bucket : string
        key : string!
        expiresIn : number
        operation : string
      }
        @description "Presign a get (default) or put url valid for expiresIn seconds (default 3600, whole seconds 1 to 604800)."
        @synonyms "signed url, presign, temporary link"
      STORAGE_RESOLVE {
        mode : string!
        bucket : string!
        hasFile : boolean!
        fileName : string!
        fileSize : number!
        fileType : string!
        hasContent : boolean!
        raw : string!
        key : string!
        contentType : string!
        acl : string!
        maxSize : number!
        batch : string!
      }
      STORAGE_PUT {
        mode : string!
        bucket : string!
        key : string!
        b64 : string!
        contentType : string!
        size : number!
        etag : string!
        isPublic : boolean!
        fileName : string!
        fileSize : number!
        fileKind : string!
        batch : string!
      }
      STORAGE_PUT_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      STORAGE_PUT_PRESIGNED {
        url : string!
        key : string!
      }
      STORAGE_PUT_DONE {
        url : string!
        state : string!
      }
      STORAGE_BATCH_NEXT {
        batch : string!
      }
      STORAGE_DOWNLOAD_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      STORAGE_LIST_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      STORAGE_DELETE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
      }
      STORAGE_SIGNED_REPLIED {
        url : string!
        key : string
      }
      STORAGE_HTTP_ERROR {
        text : string!
      }
      STORAGE_HTTP_FAILED {
        error : string!
        kind : string!
        credential : string
        key : string
      }
    }

    config {
      endpoint : string = ""
        @label "S3 endpoint"
        @description "Empty selects AWS S3 (virtual-hosted https://<bucket>.s3.<region>.amazonaws.com, path-style https://s3.<region>.amazonaws.com for buckets that are not DNS-compatible). Set scheme://host[:port][/prefix] for an S3-compatible service; local development uses an emulator, for example http://127.0.0.1:9000. Every origin the atom can reach must be in the app egress list."
        @synonyms "s3 endpoint, storage url, emulator url"
        @tier "infra"
      region : string = "us-east-1"
        @label "Signing region"
        @description "The AWS region requests and presigned urls are signed for."
        @synonyms "aws region, s3 region"
        @tier "infra"
      bucket : string = ""
        @label "Default bucket"
        @description "The bucket used when an action names none."
        @synonyms "default bucket, bucket name"
        @tier "infra"
      publicUrlBase : string = ""
        @label "Public url base"
        @description "When set, public uploads answer <base>/<key>; otherwise <origin>/<bucket>/<key>."
        @synonyms "cdn url, public base"
        @tier "infra"
      accessKeyId : secret = "STORAGE_ACCESS_KEY_ID"
        @label "Access key id credential"
        @description "Name of the credential holding the S3 access key id; resolved by the host on every call."
        @synonyms "s3 access key, aws key id"
        @tier "infra"
      secretAccessKey : secret = "STORAGE_SECRET_ACCESS_KEY"
        @label "Secret access key credential"
        @description "Name of the credential holding the S3 secret access key; resolved by the host on every call."
        @synonyms "s3 secret, aws secret"
        @tier "infra"
      timeoutMs : number = 300000
        @label "Request timeout (ms)"
        @description "Milliseconds each S3 request may take before it fails."
        @synonyms "timeout, request deadline, wait limit"
        @tier "infra"
    }
  }

  page boot as StoragePage -> StorageClient
}
