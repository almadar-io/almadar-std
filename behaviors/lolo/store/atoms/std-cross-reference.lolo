app std-cross-reference [
  version: "1.0.0",
  description: "std-cross-reference — join-table primitive for N:M relationships. Listens for LinkRequested/UnlinkRequested/FETCH_LINKS_FOR and manages the junction collection (default CrossRefLink [persistent: cross_ref_links]). Rebind via linkedEntity={YourJunction} to your consumer junction; if your junction's id fields differ from leftId/rightId, override them with fields{} renames at the call site. A rebind target must supply leftId, rightId, createdAt, filteredLinks. Emits LinkCreated, LinkRemoved, LinksLoaded as external broadcasts for downstream consumers."
]
type LinkSpec = { label : string!, href : string!, icon : string }
type CrossRefRow = { id : string!, leftId : string, rightId : string, createdAt : string }
orbital CrossReferenceOrbital {
    type LinkRequested = Event { leftId : string, rightId : string } "Request to create a link between leftId and rightId."

    type UnlinkRequested = Event { leftId : string, rightId : string } "Request to delete the link between leftId and rightId."

    type FETCH_LINKS_FOR = Event { leftId : string } "Request the link set for a given leftId."

    type LinkCreated = Event @entity "Fired after a junction row is persisted."

    type LinkRemoved = Event { id : string, deleted : boolean } "Fired after a junction row is deleted — persist delete emits the deleted row's id and a deleted flag, not the link's leftId/rightId."

    type LinksLoaded = Event { leftId : string, data : [CrossRefRow] } "Fired after junction rows for leftId are fetched."

    type LinkOpFailed = Event { error : string, code : string } "Fired when a junction persist or fetch fails."

    type LinksFetched = Event { data : [CrossRefRow]!, totalCount : number! } "Internal: raw fetch result before filtering by leftId."

  entity CrossRefLink [persistent: cross_ref_links] {
    id : string!
    leftId : string @description "Identifier for the related entity on the left side." @synonyms "sourceId, originId, parentId" = ""
    rightId : string @description "Identifier for the related entity on the right side." @synonyms "targetId, relatedId, counterpartId" = ""
    createdAt : string = ""
    filteredLinks : [CrossRefRow] @description "A list of filtered link specifications." @synonyms "links, references, connections" = []
  }

  trait CrossReferenceGate -> @rebindable CrossRefLink {
    initial: idle

    state idle {
      LinkRequested -> idle
        (persist create CrossRefLink { leftId: ?leftId, rightId: ?rightId } {
          emit: { failure: LinkOpFailed, success: LinkCreated }
        })
      UnlinkRequested -> idle
        (persist delete CrossRefLink ? {
          emit: { failure: LinkOpFailed, success: LinkRemoved }
        })
      FETCH_LINKS_FOR -> idle
        (set @entity.leftId ?leftId)
        (fetch CrossRefLink {
          filter: { leftId: ?leftId }
          limit: @config.maxRows
          emit: { failure: LinkOpFailed, success: LinksFetched }
        })
      LinksFetched -> idle when (> ?totalCount (array/len ?data))
        (emit LinkOpFailed { error: (str/concat "CrossRefLink has " ?totalCount " links for one leftId, over the maxRows cap of " @config.maxRows), code: "LINKS_OVER_CAP" })
      LinksFetched -> idle
        (set @entity.filteredLinks (array/filter ?data (fn row (= (object/get @row leftId) @entity.leftId))))
        (emit LinksLoaded { data: @entity.filteredLinks, leftId: @entity.leftId })
      LinkOpFailed -> idle
        (notify error (str/concat "Couldn't update the link — " ?error))
    }

    emits {
      LinkCreated -> external
      LinkRemoved -> external {
        id : string
        deleted : boolean
      }
      LinksLoaded -> external {
        leftId : string
        data : [CrossRefRow]
      }
      LinksFetched -> external {
        data : [CrossRefRow]!
        totalCount : number!
      }
      LinkOpFailed -> external {
        error : string
        code : string
      }
    }

    listens {
      LinkRequested {
        leftId : string
        rightId : string
      }
      UnlinkRequested {
        leftId : string
        rightId : string
      }
      FETCH_LINKS_FOR {
        leftId : string
      }
      LinksFetched {
        data : [CrossRefRow]!
        totalCount : number!
      }
    }

    config {
      maxRows : number = 1000
        @label "Links per left id"
        @description "Most junction rows one FETCH_LINKS_FOR may read for a single leftId. The whole link set is joined and returned to consumers, so a left id with more links is refused through LinkOpFailed rather than answered from a partial set."
        @synonyms "link limit, link cap"
        @tier "policy"
    }
  }

  page "/cross-reference" as CrossReferencePage -> CrossReferenceGate
}