        (emit DRIVE_FAILED { code: null, message: "URI malformed" })
      DRIVE_CREATE_FOLDER -> idle
        (http POST @config.origin "/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name" },
          queryEncoding: rfc3986,
