app std-drive [
  version: "1.0.0",
  description: "std-drive — Google Drive through the REST API (www.googleapis.com/drive/v3): list, fetch, upload, create folders and share. Reads use the service account when its key is configured, else the user's refresh token; writes prefer the user's refresh token, then the service account. A failure answers DRIVE_FAILED with the provider's message.",
  egress: ["https://www.googleapis.com", "https://oauth2.googleapis.com"]
]
type DriveListParams = { folderId : string, query : string, maxResults : number }
type DriveFileRow = { id : string, name : string, mimeType : string, size : string, modifiedTime : string, webViewLink : string }
type DriveListReply = { files : [DriveFileRow] }
type DriveFileRecord = { id : string, name : string, mimeType : string, size : number, modifiedTime : string, webViewLink : string }
type DriveGetParams = { fileId : string }
type DriveMeta = { id : string, name : string, mimeType : string }
type DriveGetState = { fileId : string, id : string, name : string, mimeType : string }
type DriveUploadParams = { name : string, content : string, mimeType : string, folderId : string }
type DriveUploadReply = { id : string, name : string, webViewLink : string }
type DriveFolderParams = { name : string, parentId : string }
type DriveFolderReply = { id : string, name : string }
type DriveShareParams = { fileId : string, email : string, role : string }
type DriveShareReply = { id : string }
type DriveCall = { op : string, auth : string, tried : number, p : string }
type DriveApiErrorItem = { message : string }
type DriveApiError = { code : number, message : string, errors : [DriveApiErrorItem] }
type DriveErrorReply = { error : DriveApiError }
type DriveErrorStringReply = { error : string }
type DriveGrantError = { error : string, error_description : string, error_subtype : string }
orbital DriveOrbital {
  entity DriveRequest [runtime] {
    id : string!
  }

  trait DriveClient -> DriveRequest [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      DRIVE_LIST_FILES -> idle
        (http GET @config.origin "/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { q: (str/concat "trashed = false" (if (!= (or @payload.folderId "") "") (str/concat " and '" (str/replaceAll @payload.folderId "'" "\\'") "' in parents") "") (if (!= (or @payload.query "") "") (str/concat " and " @payload.query) "")), pageSize: (if (= (or @payload.maxResults 0) 0) 100 @payload.maxResults), fields: "files(id, name, mimeType, size, modifiedTime, webViewLink)" },
          queryEncoding: rfc3986,
          retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 },
          auth: {
            scheme: jwt-bearer,
            key: @config.serviceAccountKey,
            alg: RS256,
            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "list", auth: "sa", tried: 0, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_LIST_FILES_AS_USER -> idle
        (http GET @config.origin "/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { q: (str/concat "trashed = false" (if (!= (or @payload.folderId "") "") (str/concat " and '" (str/replaceAll @payload.folderId "'" "\\'") "' in parents") "") (if (!= (or @payload.query "") "") (str/concat " and " @payload.query) "")), pageSize: (if (= (or @payload.maxResults 0) 0) 100 @payload.maxResults), fields: "files(id, name, mimeType, size, modifiedTime, webViewLink)" },
          queryEncoding: rfc3986,
          retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 },
          auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "list", auth: "user", tried: 1, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_GET_FILE -> idle
        (http GET @config.origin (str/concat "/drive/v3/files/" (str/encode-uri-component @payload.fileId)) {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, mimeType, size" },
          queryEncoding: rfc3986,
          retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 },
          auth: {
            scheme: jwt-bearer,
            key: @config.serviceAccountKey,
            alg: RS256,
            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "meta", auth: "sa", tried: 0, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_GET_FILE_AS_USER -> idle
        (http GET @config.origin (str/concat "/drive/v3/files/" (str/encode-uri-component @payload.fileId)) {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, mimeType, size" },
          queryEncoding: rfc3986,
          retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 },
          auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "meta", auth: "user", tried: 1, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_SHARE_FILE -> idle
        (http POST @config.origin (str/concat "/drive/v3/files/" (str/encode-uri-component @payload.fileId) "/permissions") {
          headers: { Accept: "*/*" },
          query: { fields: "id" },
          queryEncoding: rfc3986,
          json: { type: "user", role: (if (!= (or @payload.role "") "") @payload.role "reader"), emailAddress: @payload.email },
          auth: {
            scheme: jwt-bearer,
            key: @config.serviceAccountKey,
            alg: RS256,
            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "share", auth: "sa", tried: 0, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_SHARE_FILE_AS_USER -> idle
        (http POST @config.origin (str/concat "/drive/v3/files/" (str/encode-uri-component @payload.fileId) "/permissions") {
          headers: { Accept: "*/*" },
          query: { fields: "id" },
          queryEncoding: rfc3986,
          json: { type: "user", role: (if (!= (or @payload.role "") "") @payload.role "reader"), emailAddress: @payload.email },
          auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "share", auth: "user", tried: 1, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_UPLOAD_FILE -> idle when (and (str/startsWith @payload.content "data:") (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2) (= (array/nth (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";") 1) "base64") (str/includes @payload.content ","))
        (http POST @config.origin "/upload/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, webViewLink", uploadType: "multipart" },
          queryEncoding: rfc3986,
          multipart: { kind: related, parts: [{ headers: { "content-type": "application/json" }, text: (json/stringify (if (!= (if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId) "") { name: @payload.name, parents: [(if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId)] } { name: @payload.name })) }, { headers: { "content-type": (if (!= (or @payload.mimeType "") "") @payload.mimeType (if (!= (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "") (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "application/octet-stream")) }, bytes: (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ",") }] },
          auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "upload", auth: "user", tried: 0, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_UPLOAD_FILE -> idle when (and (not (and (str/startsWith @payload.content "data:") (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2) (= (array/nth (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";") 1) "base64") (str/includes @payload.content ","))) (not (and (str/startsWith @payload.content "data:") (str/includes @payload.content ",") (not (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2)) (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 1))))
        (http POST @config.origin "/upload/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, webViewLink", uploadType: "multipart" },
          queryEncoding: rfc3986,
          multipart: { kind: related, parts: [{ headers: { "content-type": "application/json" }, text: (json/stringify (if (!= (if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId) "") { name: @payload.name, parents: [(if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId)] } { name: @payload.name })) }, { headers: { "content-type": (if (!= (or @payload.mimeType "") "") @payload.mimeType "application/octet-stream") }, text: @payload.content }] },
          auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "upload", auth: "user", tried: 0, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_UPLOAD_FILE -> idle when (and (and (str/startsWith @payload.content "data:") (str/includes @payload.content ",") (not (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2)) (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 1)) (str/uri-component-valid (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ",")))
        (http POST @config.origin "/upload/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, webViewLink", uploadType: "multipart" },
          queryEncoding: rfc3986,
          multipart: { kind: related, parts: [{ headers: { "content-type": "application/json" }, text: (json/stringify (if (!= (if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId) "") { name: @payload.name, parents: [(if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId)] } { name: @payload.name })) }, { headers: { "content-type": (if (!= (or @payload.mimeType "") "") @payload.mimeType (if (!= (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "") (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "application/octet-stream")) }, text: (str/decode-uri-component (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ",")) }] },
          auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "upload", auth: "user", tried: 0, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_UPLOAD_FILE -> idle when (and (and (str/startsWith @payload.content "data:") (str/includes @payload.content ",") (not (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2)) (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 1)) (not (str/uri-component-valid (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ","))))
        (emit DRIVE_FAILED { code: null, message: "URI malformed" })
      DRIVE_UPLOAD_FILE_AS_SA -> idle when (and (str/startsWith @payload.content "data:") (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2) (= (array/nth (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";") 1) "base64") (str/includes @payload.content ","))
        (http POST @config.origin "/upload/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, webViewLink", uploadType: "multipart" },
          queryEncoding: rfc3986,
          multipart: { kind: related, parts: [{ headers: { "content-type": "application/json" }, text: (json/stringify (if (!= (if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId) "") { name: @payload.name, parents: [(if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId)] } { name: @payload.name })) }, { headers: { "content-type": (if (!= (or @payload.mimeType "") "") @payload.mimeType (if (!= (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "") (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "application/octet-stream")) }, bytes: (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ",") }] },
          auth: {
            scheme: jwt-bearer,
            key: @config.serviceAccountKey,
            alg: RS256,
            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "upload", auth: "sa", tried: 1, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_UPLOAD_FILE_AS_SA -> idle when (and (not (and (str/startsWith @payload.content "data:") (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2) (= (array/nth (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";") 1) "base64") (str/includes @payload.content ","))) (not (and (str/startsWith @payload.content "data:") (str/includes @payload.content ",") (not (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2)) (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 1))))
        (http POST @config.origin "/upload/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, webViewLink", uploadType: "multipart" },
          queryEncoding: rfc3986,
          multipart: { kind: related, parts: [{ headers: { "content-type": "application/json" }, text: (json/stringify (if (!= (if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId) "") { name: @payload.name, parents: [(if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId)] } { name: @payload.name })) }, { headers: { "content-type": (if (!= (or @payload.mimeType "") "") @payload.mimeType "application/octet-stream") }, text: @payload.content }] },
          auth: {
            scheme: jwt-bearer,
            key: @config.serviceAccountKey,
            alg: RS256,
            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "upload", auth: "sa", tried: 1, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
      DRIVE_UPLOAD_FILE_AS_SA -> idle when (and (and (str/startsWith @payload.content "data:") (str/includes @payload.content ",") (not (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 2)) (= (array/len (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) 1)) (str/uri-component-valid (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ",")))
        (http POST @config.origin "/upload/drive/v3/files" {
          headers: { Accept: "*/*" },
          query: { fields: "id, name, webViewLink", uploadType: "multipart" },
          queryEncoding: rfc3986,
          multipart: { kind: related, parts: [{ headers: { "content-type": "application/json" }, text: (json/stringify (if (!= (if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId) "") { name: @payload.name, parents: [(if (!= (or @payload.folderId "") "") @payload.folderId @config.defaultFolderId)] } { name: @payload.name })) }, { headers: { "content-type": (if (!= (or @payload.mimeType "") "") @payload.mimeType (if (!= (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "") (array/first (str/split (array/first (str/split (str/slice @payload.content 5) ",")) ";")) "application/octet-stream")) }, text: (str/decode-uri-component (str/join (array/drop (str/split (str/slice @payload.content 5) ",") 1) ",")) }] },
          auth: {
            scheme: jwt-bearer,
            key: @config.serviceAccountKey,
            alg: RS256,
            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
        } { key: (json/stringify { op: "upload", auth: "sa", tried: 1, p: (json/stringify @payload) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } })
