      DRIVE_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (object/get (json/parse @payload.key DriveCall) op "") "list"))
        (emit DRIVE_FILES_LISTED {
          files: (array/map (or (object/get (json/parse @payload.body DriveListReply) files []) []) (fn f {
