      DRIVE_REPLIED -> idle when (and (or (< @payload.status 200) (>= @payload.status 300)) (!= (object/get (json/parse @payload.key DriveCall) op "") "media"))
        (emit DRIVE_FAILED { code: null, message: (if (= (object/get (json/parse @payload.body DriveErrorReply) error null) null) (if (>= @payload.status 400) (if (str/startsWith (json/stringify (json/parse @payload.body DriveErrorReply)) "{") "[object Object]" @payload.body) (str/concat "Request failed with status code " @payload.status)) (if (str/startsWith (json/stringify (object/get (json/parse @payload.body DriveErrorReply) error null)) "\"") (object/get (json/parse @payload.body DriveErrorStringReply) error "") (if (object/has (json/parse @payload.body DriveErrorReply) "error.errors") (str/join (array/map (object/get (json/parse @payload.body DriveErrorReply) "error.errors" []) (fn e (or (object/get @e message "") ""))) "\n") (or (object/get (json/parse @payload.body DriveErrorReply) "error.message" "") "")))) })
      DRIVE_CALL_FAILED -> idle when (and (= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) op "") "list") (= (object/get (json/parse @payload.key DriveCall) tried 0) 0))
        (let ((st (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveListParams))) (emit DRIVE_LIST_FILES_AS_USER { folderId: (object/get @st folderId ""), query: (object/get @st query ""), maxResults: (object/get @st maxResults 0) }))
      DRIVE_CALL_FAILED -> idle when (and (= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) op "") "meta") (= (object/get (json/parse @payload.key DriveCall) tried 0) 0))
        (let ((st (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetParams))) (emit DRIVE_GET_FILE_AS_USER { fileId: (object/get @st fileId "") }))
      DRIVE_CALL_FAILED -> idle when (and (= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) op "") "share") (= (object/get (json/parse @payload.key DriveCall) tried 0) 0))
        (let ((st (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveShareParams))) (emit DRIVE_SHARE_FILE_AS_USER { fileId: (object/get @st fileId ""), email: (object/get @st email ""), role: (object/get @st role "") }))
      DRIVE_CALL_FAILED -> idle when (and (= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) op "") "upload") (= (object/get (json/parse @payload.key DriveCall) tried 0) 0))
        (let ((st (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveUploadParams))) (emit DRIVE_UPLOAD_FILE_AS_SA { name: (object/get @st name ""), content: (object/get @st content ""), mimeType: (object/get @st mimeType ""), folderId: (object/get @st folderId "") }))
      DRIVE_CALL_FAILED -> idle when (and (= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) op "") "folder") (= (object/get (json/parse @payload.key DriveCall) tried 0) 0))
        (let ((st (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveFolderParams))) (emit DRIVE_CREATE_FOLDER_AS_SA { name: (object/get @st name ""), parentId: (object/get @st parentId "") }))
      DRIVE_CALL_FAILED -> idle when (and (= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) tried 0) 1))
        (credential-status { credential: @config.refreshToken, scope: app } { emit: { success: DRIVE_REFRESH_PROBED } })
      DRIVE_CALL_FAILED -> idle when (and (= @payload.phase "grant") (!= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) auth "") "sa"))
        (emit DRIVE_FAILED { code: null, message: (if (!= (or (object/get (json/parse @payload.grantBody DriveGrantError) error "") "") "") (str/concat (or (object/get (json/parse @payload.grantBody DriveGrantError) error "") "") (if (!= (or (object/get (json/parse @payload.grantBody DriveGrantError) error_description "") "") "") (str/concat ": " (or (object/get (json/parse @payload.grantBody DriveGrantError) error_description "") "")) "")) (if (= (object/get (json/parse @payload.grantBody DriveErrorReply) error null) null) (if (>= @payload.grantStatus 400) (if (str/startsWith (json/stringify (json/parse @payload.grantBody DriveErrorReply)) "{") "[object Object]" @payload.grantBody) (str/concat "Request failed with status code " @payload.grantStatus)) (if (str/startsWith (json/stringify (object/get (json/parse @payload.grantBody DriveErrorReply) error null)) "\"") (object/get (json/parse @payload.grantBody DriveErrorStringReply) error "") (if (object/has (json/parse @payload.grantBody DriveErrorReply) "error.errors") (str/join (array/map (object/get (json/parse @payload.grantBody DriveErrorReply) "error.errors" []) (fn e (or (object/get @e message "") ""))) "\n") (or (object/get (json/parse @payload.grantBody DriveErrorReply) "error.message" "") ""))))) })
      DRIVE_CALL_FAILED -> idle when (and (= @payload.phase "grant") (!= @payload.kind "unconfigured") (= (object/get (json/parse @payload.key DriveCall) auth "") "user"))
        (emit DRIVE_FAILED { code: null, message: (if (and (= (or (object/get (json/parse @payload.grantBody DriveGrantError) error "") "") "invalid_grant") (str/includes (str/lower (or (object/get (json/parse @payload.grantBody DriveGrantError) error_description "") "")) "reauth")) (json/stringify (json/parse @payload.grantBody DriveGrantError)) (if (= (object/get (json/parse @payload.grantBody DriveErrorReply) error null) null) (if (>= @payload.grantStatus 400) (if (str/startsWith (json/stringify (json/parse @payload.grantBody DriveErrorReply)) "{") "[object Object]" @payload.grantBody) (str/concat "Request failed with status code " @payload.grantStatus)) (if (str/startsWith (json/stringify (object/get (json/parse @payload.grantBody DriveErrorReply) error null)) "\"") (object/get (json/parse @payload.grantBody DriveErrorStringReply) error "") (if (object/has (json/parse @payload.grantBody DriveErrorReply) "error.errors") (str/join (array/map (object/get (json/parse @payload.grantBody DriveErrorReply) "error.errors" []) (fn e (or (object/get @e message "") ""))) "\n") (or (object/get (json/parse @payload.grantBody DriveErrorReply) "error.message" "") ""))))) })
      DRIVE_CALL_FAILED -> idle when (and (!= @payload.kind "unconfigured") (!= @payload.phase "grant"))
        (emit DRIVE_FAILED { code: null, message: (if (= @payload.kind "timeout") "network timeout" @payload.error) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Google Drive unavailable: " @payload.error) })
      DRIVE_REFRESH_PROBED -> idle when @payload.connected
        (emit DRIVE_FAILED { code: null, message: "Drive not configured — set GOOGLE_DRIVE_SA_KEY (reads) and/or GOOGLE_DRIVE_REFRESH_TOKEN + OAUTH_CLIENT_ID/SECRET (writes)" })
      DRIVE_REFRESH_PROBED -> idle when (not @payload.connected)
        (emit DRIVE_FAILED { code: "NOT_CONFIGURED", message: "Integration not configured: drive. Set GOOGLE_DRIVE_SA_KEY / GOOGLE_DRIVE_SUBJECT / GOOGLE_DRIVE_REFRESH_TOKEN / GOOGLE_DRIVE_FOLDER_ID." })
    }

    emits {
      DRIVE_FILES_LISTED -> external {
        files : [DriveFileRecord]!
      }
        @description "The non-trashed files matching the listing, mapped to flat records; size is the byte count as a number, empty text fields when Drive returned none."
        @synonyms "listed files, drive listing"
        @tier "primary"
      DRIVE_FILE_FETCHED -> external {
        id : string!
        name : string!
        mimeType : string!
        content : string!
        size : number!
      }
        @description "A file's metadata and its content as base64, with the byte size."
        @synonyms "downloaded file, file content"
        @tier "primary"
      DRIVE_FILE_UPLOADED -> external {
        id : string!
        name : string!
        webViewLink : string!
      }
        @description "The uploaded file's id, name and web link."
        @synonyms "uploaded file, upload result"
        @tier "primary"
      DRIVE_FOLDER_CREATED -> external {
        id : string!
        name : string!
      }
        @description "The created folder's id and name."
        @synonyms "created folder"
        @tier "primary"
      DRIVE_FILE_SHARED -> external {
        shared : boolean!
        permissionId : string!
      }
        @description "The file was shared; the id of the created permission."
        @synonyms "shared file, permission created"
        @tier "primary"
      DRIVE_FAILED -> external {
        code : string
        message : string!
      }
        @description "A Drive action failed: the provider's error message, NOT_CONFIGURED when no credential is set."
        @synonyms "drive error, drive failure"
        @tier "primary"
      DRIVE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
        @description "Internal: a Drive HTTP reply."
        @tier "secondary"
      DRIVE_CALL_FAILED {
        error : string!
        kind : string!
        credential : string
        phase : string
        grantStatus : number
        grantBody : string
        key : string!
      }
        @description "Internal: a Drive request never produced a reply."
        @tier "secondary"
      DRIVE_REFRESH_PROBED {
        connected : boolean!
      }
        @description "Internal: whether the user refresh token is configured."
        @tier "secondary"
      DRIVE_LIST_FILES_AS_USER {
        folderId : string
        query : string
        maxResults : number
      }
        @description "Internal: list through the user client after the service account was unconfigured."
        @tier "secondary"
      DRIVE_GET_FILE_AS_USER {
        fileId : string!
      }
        @description "Internal: fetch through the user client."
        @tier "secondary"
      DRIVE_SHARE_FILE_AS_USER {
        fileId : string!
        email : string!
        role : string
      }
        @description "Internal: share through the user client."
        @tier "secondary"
      DRIVE_UPLOAD_FILE_AS_SA {
        name : string!
        content : string!
        mimeType : string
        folderId : string
      }
        @description "Internal: upload through the service account after the user client was unconfigured."
        @tier "secondary"
      DRIVE_CREATE_FOLDER_AS_SA {
        name : string!
        parentId : string
      }
        @description "Internal: create a folder through the service account."
        @tier "secondary"
    }

    listens {
      DRIVE_LIST_FILES -> input {
        folderId : string
        query : string
        maxResults : number
      }
        @description "List non-trashed Drive files, optionally inside a folder and filtered by a Drive query; maxResults defaults to 100."
        @synonyms "list files, drive files"
      DRIVE_GET_FILE -> input {
        fileId : string!
      }
        @description "Fetch a file's metadata and base64 content."
        @synonyms "download file, get file"
      DRIVE_UPLOAD_FILE -> input {
        name : string!
        content : string!
        mimeType : string
        folderId : string
      }
        @description "Upload a file; content is text or a base64 data URL, the folder defaults to the configured one."
        @synonyms "upload file, save file"
      DRIVE_CREATE_FOLDER -> input {
        name : string!
        parentId : string
      }
        @description "Create a folder, optionally inside a parent."
        @synonyms "new folder, make folder"
      DRIVE_SHARE_FILE -> input {
        fileId : string!
        email : string!
        role : string
      }
        @description "Share a file with a user by email; role defaults to reader."
        @synonyms "share file, grant access"
      DRIVE_LIST_FILES_AS_USER {
        folderId : string
        query : string
        maxResults : number
      }
      DRIVE_GET_FILE_AS_USER {
        fileId : string!
      }
      DRIVE_SHARE_FILE_AS_USER {
        fileId : string!
        email : string!
        role : string
      }
      DRIVE_UPLOAD_FILE_AS_SA {
        name : string!
        content : string!
        mimeType : string
        folderId : string
      }
      DRIVE_CREATE_FOLDER_AS_SA {
        name : string!
        parentId : string
      }
      DRIVE_REPLIED {
        status : number!
        headers : Map string string
        body : string!
        key : string!
      }
      DRIVE_CALL_FAILED {
        error : string!
        kind : string!
        credential : string
        phase : string
        grantStatus : number
        grantBody : string
        key : string!
      }
      DRIVE_REFRESH_PROBED {
        connected : boolean!
      }
    }

    config {
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the atom reports an unreachable Drive call; a page running it in the background keeps it in `system`"
        @synonyms "status area, slot"
        @tier "presentation"
      origin : url = "https://www.googleapis.com"
        @label "Google APIs origin"
        @description "The Google APIs origin (scheme://host, no path). Must be declared in the app egress list."
        @synonyms "drive url, api host"
        @tier "infra"
      serviceAccountKey : secret = "GOOGLE_DRIVE_SA_KEY"
        @label "Service-account key credential"
        @description "Name of the credential holding the service-account key JSON (raw or base64); reads prefer it."
        @synonyms "service account, sa key"
        @tier "infra"
      subject : string = ""
        @label "Delegated subject"
        @description "Workspace user the service account impersonates (domain-wide delegation); empty for none."
        @synonyms "impersonate, delegation"
        @tier "infra"
      refreshToken : secret = "GOOGLE_DRIVE_REFRESH_TOKEN"
        @label "User refresh-token credential"
        @description "Name of the credential holding the user's OAuth refresh token; writes prefer it."
        @synonyms "refresh token, user token"
        @tier "infra"
      clientId : secret = "OAUTH_CLIENT_ID"
        @label "OAuth client id credential"
        @description "Name of the credential holding the OAuth client id used with the refresh token."
        @synonyms "client id"
        @tier "infra"
      clientSecret : secret = "OAUTH_CLIENT_SECRET"
        @label "OAuth client secret credential"
        @description "Name of the credential holding the OAuth client secret used with the refresh token."
        @synonyms "client secret"
        @tier "infra"
      defaultFolderId : string = ""
        @label "Default folder id"
        @description "Parent folder for uploads and new folders when the call names none; empty for the Drive root."
        @synonyms "root folder, default parent"
        @tier "infra"
    }
  }

  page "/drive" as DrivePage -> DriveClient
}
