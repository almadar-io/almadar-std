      DRIVE_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (object/get (json/parse @payload.key DriveCall) op "") "meta") (= (object/get (json/parse @payload.key DriveCall) auth "") "sa"))
