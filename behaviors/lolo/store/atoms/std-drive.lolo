          id: (or (object/get (json/parse @payload.body DriveUploadReply) id "") ""),
          name: (or (object/get (json/parse @payload.body DriveUploadReply) name "") (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveUploadParams) name "")),
          webViewLink: (or (object/get (json/parse @payload.body DriveUploadReply) webViewLink "") "")
        })
      DRIVE_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (object/get (json/parse @payload.key DriveCall) op "") "folder"))
