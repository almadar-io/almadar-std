            claims: (if (= @config.subject "")
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)) }
              { scope: "https://www.googleapis.com/auth/drive", aud: "https://www.googleapis.com/oauth2/v4/token", exp: (+ (math/floor (/ @now 1000)) 3600), iat: (math/floor (/ @now 1000)), sub: @config.subject }),
            tokenUrl: "https://www.googleapis.com/oauth2/v4/token",
            expiresMarginMs: 300000,
            storeAs: { name: "drive:service-account-token", scope: app },
            grantRequest: { headers: { Accept: "application/json" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
          } { key: (json/stringify { op: "media", auth: "sa", tried: 1, p: (json/stringify { fileId: (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetParams) fileId ""), id: (or (object/get (json/parse @payload.body DriveMeta) id "") (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetParams) fileId "")), name: (or (object/get (json/parse @payload.body DriveMeta) name "") ""), mimeType: (or (object/get (json/parse @payload.body DriveMeta) mimeType "") "application/octet-stream") }) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } }))
      DRIVE_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (object/get (json/parse @payload.key DriveCall) op "") "meta") (= (object/get (json/parse @payload.key DriveCall) auth "") "user"))
        (let ((st (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetParams)))
          (http GET @config.origin (str/concat "/drive/v3/files/" (str/encode-uri-component (object/get @st fileId ""))) {
            headers: { Accept: "*/*" },
            query: { alt: "media" },
            queryEncoding: rfc3986,
            responseAs: bytes,
            retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 },
            auth: {
            scheme: token-exchange,
            tokenUrl: "https://oauth2.googleapis.com/token",
            body: { form: { refresh_token: { credential: @config.refreshToken }, client_id: { credential: @config.clientId }, client_secret: { credential: @config.clientSecret }, grant_type: "refresh_token" } },
            expiresMarginMs: 300000,
            storeAs: { name: "drive:user-token", scope: app },
            grantRequest: { headers: { Accept: "*/*" }, retry: { max: 3, on: ["1xx", "408", "429", "5xx", "failed", "timeout"], scheduleMs: [100, 500, 1500], noResponseMax: 2 } }
          }
          } { key: (json/stringify { op: "media", auth: "user", tried: 1, p: (json/stringify { fileId: (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetParams) fileId ""), id: (or (object/get (json/parse @payload.body DriveMeta) id "") (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetParams) fileId "")), name: (or (object/get (json/parse @payload.body DriveMeta) name "") ""), mimeType: (or (object/get (json/parse @payload.body DriveMeta) mimeType "") "application/octet-stream") }) }), emit: { success: DRIVE_REPLIED, failure: DRIVE_CALL_FAILED } }))
      DRIVE_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (object/get (json/parse @payload.key DriveCall) op "") "media"))
        (emit DRIVE_FILE_FETCHED {
          id: (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetState) id ""),
          name: (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetState) name ""),
          mimeType: (object/get (json/parse (object/get (json/parse @payload.key DriveCall) p "") DriveGetState) mimeType ""),
          content: @payload.body,
          size: (- (* (/ (str/len @payload.body) 4) 3) (if (str/endsWith @payload.body "==") 2 (if (str/endsWith @payload.body "=") 1 0)))
        })
      DRIVE_REPLIED -> idle when (and (and (>= @payload.status 200) (< @payload.status 300)) (= (object/get (json/parse @payload.key DriveCall) op "") "upload"))
