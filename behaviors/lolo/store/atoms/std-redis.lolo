app std-redis [
  version: "1.0.0",
  net: { "redis.example.test:6379": [tcp] },
  description: "std-redis — a cache, counter, lock and message channel on a real Redis server: each call becomes one RESP command for std-resp-client, which speaks RESP over os/tcp-connect, os/send, os/recv and os/close. REDIS_GET, REDIS_SET (ttl in seconds), REDIS_DELETE, REDIS_INCREMENT (INCRBY), REDIS_EXPIRE (seconds, PEXPIRE), REDIS_PUBLISH, REDIS_LOCK (SET NX PX, ttl in milliseconds; the lock id is drawn from the host CSPRNG) and REDIS_UNLOCK (EVAL of the compare-and-delete script, so only the holder releases). Values are text. Every failure answers REDIS_FAILED with the action, the failure kind (refused, timeout, failed, protocol, unsupported, redis), the server's error word when it answered one, and the message. Calls overlap: the wire pipelines them over one connection and answers each in order. AUTH and the ACL user ride the RedisWire knobs: authenticated true sends AUTH [user] password ahead of the command, the password being the credential the password secret knob names (default REDIS_PASSWORD), filled into the send by the host so the atom never holds it; a credential that is not held answers REDIS_FAILED unconfigured. Not carried yet: TLS (rediss) and subscribing (G-ORB-307). The server is the host and port knobs, which the net grant names."
]
uses Resp from "std/behaviors/std-resp-client"

type RedisLockRequest = { key : string, ttl : number }
type RedisCallKey = { action : string!, lockId : string }

orbital RedisOrbital {
  entity RedisCall [runtime] {
    id : string!
  }

  trait RedisWire = Resp.traits.RespClient {
    listens {
      RedisClient.RESP_RUN -> RESP_RUN
      RESP_RUN {
        key : string!
        argv : [string]!
      }
      RESP_CONNECTED {
        sock : number!
      }
      RESP_SENT {
        bytes : number!
      }
      RESP_READ {
        data : bytes!
        eof : boolean!
      }
      RESP_IO_FAILED {
        error : string
        kind : string
      }
      RESP_CLOSED {
      }
    }
    config {
      host: "redis.example.test"
      port: 6379
      authenticated: false
      user: ""
      password: "REDIS_PASSWORD"
      db: 0
    }
  }

  trait RedisClient -> RedisCall [optimistic] {
    initial: idle

    state idle {
      INIT -> idle

      REDIS_GET -> idle when (!= @payload.key "")
        (emit RESP_RUN { key: (json/stringify { action: "get", lockId: "" }), argv: ["GET", @payload.key] })
      REDIS_GET -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "get", kind: "refused", code: null, message: "key is required" })
      REDIS_REPLY -> idle when (= @payload.action "get")
        (emit REDIS_GOT { value: (if (= @payload.kind "null") null @payload.text) })

      REDIS_SET -> idle when (and (!= @payload.key "") (> (default @payload.ttl 0) 0))
        (emit RESP_RUN { key: (json/stringify { action: "set", lockId: "" }), argv: ["SET", @payload.key, @payload.value, "EX", (str/concat (default @payload.ttl 0))] })
      REDIS_SET -> idle when (and (!= @payload.key "") (<= (default @payload.ttl 0) 0))
        (emit RESP_RUN { key: (json/stringify { action: "set", lockId: "" }), argv: ["SET", @payload.key, @payload.value] })
      REDIS_SET -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "set", kind: "refused", code: null, message: "key is required" })
      REDIS_REPLY -> idle when (= @payload.action "set")
        (emit REDIS_SET_DONE { ok: (= @payload.text "OK") })

      REDIS_DELETE -> idle when (!= @payload.key "")
        (emit RESP_RUN { key: (json/stringify { action: "delete", lockId: "" }), argv: ["DEL", @payload.key] })
      REDIS_DELETE -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "delete", kind: "refused", code: null, message: "key is required" })
      REDIS_REPLY -> idle when (= @payload.action "delete")
        (emit REDIS_DELETED { deleted: (> (default (str/to-int @payload.text) 0) 0) })

      REDIS_INCREMENT -> idle when (!= @payload.key "")
        (emit RESP_RUN { key: (json/stringify { action: "increment", lockId: "" }), argv: ["INCRBY", @payload.key, (str/concat (default @payload.by 1))] })
      REDIS_INCREMENT -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "increment", kind: "refused", code: null, message: "key is required" })
      REDIS_REPLY -> idle when (= @payload.action "increment")
        (emit REDIS_INCREMENTED { value: (default (str/to-int @payload.text) 0) })

      REDIS_EXPIRE -> idle when (!= @payload.key "")
        (emit RESP_RUN { key: (json/stringify { action: "expire", lockId: "" }), argv: ["PEXPIRE", @payload.key, (str/concat (* @payload.ttl 1000))] })
      REDIS_EXPIRE -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "expire", kind: "refused", code: null, message: "key is required" })
      REDIS_REPLY -> idle when (= @payload.action "expire")
        (emit REDIS_EXPIRED { set: (= @payload.text "1") })

      REDIS_PUBLISH -> idle when (!= @payload.channel "")
        (emit RESP_RUN { key: (json/stringify { action: "publish", lockId: "" }), argv: ["PUBLISH", @payload.channel, @payload.message] })
      REDIS_PUBLISH -> idle when (= @payload.channel "")
        (emit REDIS_FAILED { action: "publish", kind: "refused", code: null, message: "channel is required" })
      REDIS_REPLY -> idle when (= @payload.action "publish")
        (emit REDIS_PUBLISHED { receivers: (default (str/to-int @payload.text) 0) })

      REDIS_LOCK -> idle when (!= @payload.key "")
        (random-bytes 16 { key: (json/stringify { key: @payload.key, ttl: (default @payload.ttl 30000) }), emit: { success: REDIS_LOCK_ID_DRAWN, failure: REDIS_LOCK_ID_FAILED } })
      REDIS_LOCK -> idle when (= @payload.key "")
        (emit REDIS_FAILED { action: "lock", kind: "refused", code: null, message: "key is required" })
      REDIS_LOCK_ID_DRAWN -> idle
        (emit RESP_RUN { key: (json/stringify { action: "lock", lockId: @payload.value }), argv: ["SET", (object/get (default (json/parse @payload.key RedisLockRequest) { key: "", ttl: 30000 }) key ""), @payload.value, "NX", "PX", (str/concat (object/get (default (json/parse @payload.key RedisLockRequest) { key: "", ttl: 30000 }) ttl 30000))] })
      REDIS_LOCK_ID_FAILED -> idle
        (emit REDIS_FAILED { action: "lock", kind: "failed", code: null, message: @payload.error })
      REDIS_REPLY -> idle when (and (= @payload.action "lock") (= @payload.text "OK"))
        (emit REDIS_LOCKED { acquired: true, lockId: @payload.lockId })
      REDIS_REPLY -> idle when (and (= @payload.action "lock") (!= @payload.text "OK"))
        (emit REDIS_LOCKED { acquired: false, lockId: "" })

      REDIS_UNLOCK -> idle when (and (!= @payload.key "") (!= @payload.lockId ""))
        (emit RESP_RUN { key: (json/stringify { action: "unlock", lockId: "" }), argv: ["EVAL", "if redis.call('get', KEYS[1]) == ARGV[1] then return redis.call('del', KEYS[1]) else return 0 end", "1", @payload.key, @payload.lockId] })
      REDIS_UNLOCK -> idle when (or (= @payload.key "") (= @payload.lockId ""))
        (emit REDIS_FAILED { action: "unlock", kind: "refused", code: null, message: "key and lockId are required" })
      REDIS_REPLY -> idle when (= @payload.action "unlock")
        (emit REDIS_UNLOCKED { released: (= @payload.text "1") })

      RESP_REPLIED -> idle
        (emit REDIS_REPLY { action: (object/get (default (json/parse @payload.key RedisCallKey) { action: "", lockId: "" }) action ""), lockId: (object/get (default (json/parse @payload.key RedisCallKey) { action: "", lockId: "" }) lockId ""), kind: @payload.kind, text: @payload.text })
      RESP_FAILED -> idle
        (emit REDIS_FAILED { action: (object/get (default (json/parse @payload.key RedisCallKey) { action: "", lockId: "" }) action ""), kind: @payload.kind, code: @payload.code, message: @payload.message })
    }

    emits {
      REDIS_GOT -> external {
        value : string?
      }
        @description "The value stored at the key as text; null when the key does not exist."
        @synonyms "cache hit, value read, key value"
        @tier "primary"
      REDIS_SET_DONE -> external {
        ok : boolean!
      }
        @description "The key was set; ok is true when the server answered OK."
        @synonyms "cache stored, value written"
        @tier "primary"
      REDIS_DELETED -> external {
        deleted : boolean!
      }
        @description "Whether the key existed and was removed."
        @synonyms "cache evicted, key removed"
        @tier "primary"
      REDIS_INCREMENTED -> external {
        value : number!
      }
        @description "The counter's value after INCRBY; a missing key starts at 0."
        @synonyms "counter incremented, count after increase"
        @tier "primary"
      REDIS_EXPIRED -> external {
        set : boolean!
      }
        @description "Whether the key existed and now expires after the given seconds."
        @synonyms "expiry set, ttl applied"
        @tier "primary"
      REDIS_PUBLISHED -> external {
        receivers : number!
      }
        @description "How many subscribers received the message."
        @synonyms "message published, subscribers reached"
        @tier "primary"
      REDIS_LOCKED -> external {
        acquired : boolean!
        lockId : string!
      }
        @description "Whether the lock was taken and, when it was, the id that releases it; empty when another holder has it."
        @synonyms "lock acquired, mutex taken"
        @tier "primary"
      REDIS_UNLOCKED -> external {
        released : boolean!
      }
        @description "Whether the lock was held under that id and is now released; false when it expired or another holder has it."
        @synonyms "lock released, mutex freed"
        @tier "primary"
      REDIS_FAILED -> external {
        action : string!
        kind : string!
        code : string?
        message : string!
      }
        @description "A call did not complete: the action, the kind (refused, unconfigured, timeout, failed, protocol, unsupported, redis), the Redis error word when the server answered one (WRONGTYPE, NOAUTH, ...) and the message."
        @synonyms "cache failed, redis unreachable, wrong password"
        @tier "primary"
      REDIS_REPLY -> internal {
        action : string!
        lockId : string!
        kind : string!
        text : string!
      }
        @description "Internal: a reply of the wire, with the action and lock id its key carried."
        @tier "internal"
      RESP_RUN -> external {
        key : string!
        argv : [string]!
      }
        @description "One RESP command for the wire."
        @tier "secondary"
      REDIS_LOCK_ID_DRAWN {
        value : string!
        key : string!
      }
        @description "Internal: the lock id was drawn from the host CSPRNG; the key carries the lock request."
        @tier "secondary"
      REDIS_LOCK_ID_FAILED {
        error : string!
      }
        @description "Internal: the host could not draw a lock id."
        @tier "secondary"
    }

    listens {
      REDIS_GET -> input {
        key : string!
      }
        @description "Read the text value stored at a key."
        @synonyms "cache get, read key, fetch cached value"
      REDIS_SET -> input {
        key : string!
        value : string!
        ttl : number
      }
        @description "Store a text value at a key; ttl is seconds, none keeps it until removed."
        @synonyms "cache set, write key, store value"
      REDIS_DELETE -> input {
        key : string!
      }
        @description "Remove a key."
        @synonyms "cache delete, evict key, remove value"
      REDIS_INCREMENT -> input {
        key : string!
        by : number
      }
        @description "Add to a counter (INCRBY); by defaults to 1 and a missing key starts at 0."
        @synonyms "counter increment, count up, add to counter"
      REDIS_EXPIRE -> input {
        key : string!
        ttl : number!
      }
        @description "Make a key expire after ttl seconds."
        @synonyms "set expiry, time to live, expire key"
      REDIS_PUBLISH -> input {
        channel : string!
        message : string!
      }
        @description "Publish a text message on a channel."
        @synonyms "publish message, broadcast, send to channel"
      REDIS_LOCK -> input {
        key : string!
        ttl : number
      }
        @description "Take a lock on a key for ttl milliseconds (default 30000); the answer carries the id that releases it."
        @synonyms "acquire lock, mutex, take lock"
      REDIS_UNLOCK -> input {
        key : string!
        lockId : string!
      }
        @description "Release a lock held under lockId; only the holder releases it."
        @synonyms "release lock, free mutex, drop lock"
      REDIS_REPLY {
        action : string!
        lockId : string!
        kind : string!
        text : string!
      }
      RedisWire.RESP_REPLIED -> RESP_REPLIED
      RedisWire.RESP_FAILED -> RESP_FAILED
      RESP_REPLIED {
        key : string!
        kind : string!
        text : string!
      }
      RESP_FAILED {
        key : string!
        kind : string!
        code : string?
        message : string!
      }
      REDIS_LOCK_ID_DRAWN {
        value : string!
        key : string!
      }
      REDIS_LOCK_ID_FAILED {
        error : string!
      }
    }
  }

  page boot as RedisPage -> RedisClient, RedisWire
}
