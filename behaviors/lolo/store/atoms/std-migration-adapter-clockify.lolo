app std-migration-adapter-clockify [
  version: "1.0.0",
  description: "std-migration-adapter-clockify — the Clockify report-export adapter of a migration run. Each fetched document is Clockify's detailed-report JSON: a bare entry array, or an object holding the entries under timeentries (or timeEntries). Entries group under one folder unit per project, created just before the project's first entry (an entry with no project name groups under '(no project)'); each entry becomes a root unit titled with its description ('(no description)' when blank), nested under its project folder, and carrying start, end, duration (as text), user, client and billable. An entry without timeInterval.start is left out of the units and ledgered in skipped with the reason. A document that is not a JSON entry array or timeentries object fails the whole run with MIGRATION_SOURCE_UNREADABLE. Answers std-migration-job's MIGRATION_EXTRACT when the profile's adapter is clockify."
]
orbital MigrationAdapterClockifyOrbital {
  type ImportFieldValue = string | number | boolean
  type ImportRawDocument = { ref : string!, raw : string! }
  type ImportSkip = { ref : string!, reason : string! }
  type ExtractedUnit = { ref : string!, kind : "root" | "folder" | "section" | "qa"!, title : string?, content : string?, parentRef : string?, metadata : Map string ImportFieldValue!, source : string!, span : string? }
  type ClockifyInterval = { start : string, end : string, duration : string | number }
  type ClockifyEntry = { _id : string, id : string, description : string, projectName : string, clientName : string, userName : string, billable : boolean, timeInterval : ClockifyInterval }
  type ClockifyList = [ClockifyEntry]
  type ClockifyReport = { timeentries : [ClockifyEntry], timeEntries : [ClockifyEntry] }
  type ClockifyDocument = { ref : string!, ok : boolean!, valid : boolean!, entries : [ClockifyEntry]! }

  entity MigrationAdapterClockifyRun [runtime] {
    id : string!
    documents : [ClockifyDocument] = []
  }

  trait MigrationAdapterClockify -> MigrationAdapterClockifyRun [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.documents [])

      MIGRATION_EXTRACT -> idle when (= ?adapter "clockify")
        (set
          @entity.documents
          (array/map
            ?documents
            (fn d
              (if
                (not (json/valid (object/get @d raw)))
                { ref: (object/get @d ref), ok: false, valid: false, entries: [] }
                (if
                  (str/startsWith (str/trim (object/get @d raw)) "[")
                  (let ((list (json/parse (object/get @d raw) ClockifyList)))
                    (if (== @list null)
                      { ref: (object/get @d ref), ok: false, valid: true, entries: [] }
                      { ref: (object/get @d ref), ok: true, valid: true, entries: @list }))
                  (if
                    (str/startsWith (str/trim (object/get @d raw)) "{")
                    (let ((report (json/parse (object/get @d raw) ClockifyReport)))
                      (if
                        (== @report null)
                        { ref: (object/get @d ref), ok: false, valid: true, entries: [] }
                        (let ((found (default (object/get @report timeentries) (object/get @report timeEntries))))
                          (if
                            (validate/array @found)
                            { ref: (object/get @d ref), ok: true, valid: true, entries: @found }
                            { ref: (object/get @d ref), ok: false, valid: true, entries: [] }))))
                    { ref: (object/get @d ref), ok: false, valid: true, entries: [] }))))))
        (emit CLOCKIFY_PARSED {})

      CLOCKIFY_PARSED -> idle when (array/some @entity.documents (fn d (not (object/get @d ok))))
        (emit MIGRATION_SOURCE_UNREADABLE { error: (if (object/get (default (array/find @entity.documents (fn d (not (object/get @d ok)))) { ref: "", ok: true, valid: true, entries: [] }) valid) "Clockify export must be an entry array or { timeentries: [...] }" "Clockify export is not valid JSON") })

      CLOCKIFY_PARSED -> idle when (array/every @entity.documents (fn d (object/get @d ok)))
        (emit
          MIGRATION_EXTRACTED
          {
            units: (array/flatten
                     (array/map
                       @entity.documents
                       (fn d
                         (let ((okIdx (array/filter
                                       (array/range (array/len (object/get @d entries)))
                                       (fn i
                                         (and
                                           (validate/required                                              (object/get
                                               (default (array/nth (object/get @d entries) @i) {})
                                               "timeInterval.start"
                                               ""))
                                           (!=
                                             (object/get
                                               (default (array/nth (object/get @d entries) @i) {})
                                               "timeInterval.start"
                                               "")
                                             ""))))))
                           (array/flatten
                             (array/map
                               @okIdx
                               (fn i p
                                 (let ((e (default (array/nth (object/get @d entries) @i) {}))
                                       (proj (if
                                              (and
                                                (validate/required (object/get @e projectName ""))
                                                (!= (object/get @e projectName "") ""))
                                              (object/get @e projectName "")
                                              "(no project)")))
                                   (array/concat
                                     (if
                                       (array/some
                                         (array/take @okIdx @p)
                                         (fn j
                                           (=
                                             (if
                                               (and
                                                 (validate/required                                                    (object/get
                                                     (default (array/nth (object/get @d entries) @j) {})
                                                     projectName
                                                     ""))
                                                 (!=
                                                   (object/get
                                                     (default (array/nth (object/get @d entries) @j) {})
                                                     projectName
                                                     "")
                                                   ""))
                                               (object/get
                                                 (default (array/nth (object/get @d entries) @j) {})
                                                 projectName
                                                 "")
                                               "(no project)")
                                             @proj)))
                                       []
                                       [
                                        (let ((u : ExtractedUnit {
                                          ref: (str/concat
                                                 "clockify:"
                                                 (object/get @d ref)
                                                 ":project:"
                                                 (str/replace-pattern (str/lower @proj) "[^a-z0-9]+" "-")),
                                          kind: folder,
                                          title: @proj,
                                          content: null,
                                          parentRef: null,
                                          source: "clockify",
                                          span: (object/get @d ref),
                                          metadata: { source: "clockify" }
                                        })) @u)
                                       ])
                                     [
                                      (let ((u : ExtractedUnit {
                                        ref: (str/concat
                                               "clockify:"
                                               (object/get @d ref)
                                               ":"
                                               (default (object/get @e _id) (default (object/get @e id) (str/concat "entry-" @i)))),
                                        kind: root,
                                        title: (if
                                                 (and
                                                   (validate/required (object/get @e description ""))
                                                   (!= (object/get @e description "") ""))
                                                 (object/get @e description "")
                                                 "(no description)"),
                                        content: null,
                                        parentRef: (str/concat
                                                     "clockify:"
                                                     (object/get @d ref)
                                                     ":project:"
                                                     (str/replace-pattern (str/lower @proj) "[^a-z0-9]+" "-")),
                                        source: "clockify",
                                        span: (str/concat (object/get @d ref) "#" @i),
                                        metadata: (let ((none : Map string ImportFieldValue {}) (all : Map string ImportFieldValue { source: "clockify",
                                                      start: (object/get @e "timeInterval.start" ""), billable: (not (not (object/get @e billable false))) })) (default (object/merge @all (default (object/fromEntries
                                                      (array/map
                                                        (array/filter
                                                          [
                                                           {
                                                             k: "end",
                                                             v: (default
                                                                  (object/get @e "timeInterval.end" "")
                                                                  "")
                                                           }
                                                          ]
                                                          (fn q (!= (object/get @q v) "")))
                                                        (fn q [(object/get @q k), (object/get @q v)]))) @none) (default (object/fromEntries
                                                      (array/map
                                                        (array/filter
                                                          [
                                                           {
                                                             k: "duration",
                                                             v: (str/concat (default (object/get @e "timeInterval.duration") ""))
                                                           }
                                                          ]
                                                          (fn q (object/has @e "timeInterval.duration")))
                                                        (fn q [(object/get @q k), (object/get @q v)]))) @none) (default (object/fromEntries
                                                      (array/map
                                                        (array/filter
                                                          [
                                                           {
                                                             k: "user",
                                                             v: (default (object/get @e userName "") "")
                                                           },
                                                           {
                                                             k: "client",
                                                             v: (default (object/get @e clientName "") "")
                                                           }
                                                          ]
                                                          (fn q (!= (object/get @q v) "")))
                                                        (fn q [(object/get @q k), (object/get @q v)]))) @none)) @all))
                                      })) @u)
                                     ]))))))))),
            skipped: (array/flatten
                       (array/map
                         @entity.documents
                         (fn d
                           (array/map
                             (array/filter
                               (array/range (array/len (object/get @d entries)))
                               (fn i
                                 (not
                                   (and
                                     (validate/required                                        (object/get
                                         (default (array/nth (object/get @d entries) @i) {})
                                         "timeInterval.start"
                                         ""))
                                     (!=
                                       (object/get
                                         (default (array/nth (object/get @d entries) @i) {})
                                         "timeInterval.start"
                                         "")
                                       "")))))
                             (fn i
                               {
                                 ref: (str/concat
                                        "clockify:"
                                        (object/get @d ref)
                                        ":"
                                        (default (object/get (default (array/nth (object/get @d entries) @i) {}) _id) (default (object/get (default (array/nth (object/get @d entries) @i) {}) id) (str/concat "entry-" @i)))),
                                 reason: "entry has no timeInterval.start"
                               })))))
          })
    }

    emits {
      CLOCKIFY_PARSED {
        ok : boolean
      }
        @description "Internal: the fetched documents are parsed into entry lists and checked."
        @tier "secondary"
      MIGRATION_EXTRACTED -> external {
        units : [ExtractedUnit]!
        skipped : [ImportSkip]!
      }
        @description "The Clockify entries extracted into project folders and entry units, plus the ledger of entries left out, in document order."
        @synonyms "clockify extracted, clockify staging, clockify units"
        @tier "domain"
      MIGRATION_SOURCE_UNREADABLE -> external {
        error : string!
      }
        @description "A document is not a Clockify report export, so the run cannot stage."
        @synonyms "clockify export invalid, clockify parse failed"
        @tier "domain"
    }

    listens {
      MIGRATION_EXTRACT -> input {
        adapter : string!
        documents : [ImportRawDocument]!
      }
        @description "A migration run asks its profile's adapter to extract the fetched documents; this adapter answers when adapter is clockify and ignores every other adapter."
        @synonyms "extract documents, parse fetched documents"
        @tier "domain"
    }
  }

  page boot as MigrationAdapterClockifyOrbitalStart -> MigrationAdapterClockify
}
