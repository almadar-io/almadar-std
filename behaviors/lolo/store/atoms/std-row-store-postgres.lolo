    emits {
      ROW_FOUND -> external {
        key : string!
        row : Row?
      }
        @tier "internal"
      ROWS_LISTED -> external {
        key : string!
        rows : [Row]!
      }
        @tier "internal"
      ROWS_PAGE -> external {
        key : string!
        rows : [Row]!
        total : number!
      }
        @tier "internal"
      ROWS_IDS -> external {
        key : string!
        ids : [string]!
        total : number!
      }
        @tier "internal"
      ROWS_WRITTEN -> external {
        key : string!
        outcomes : [RowWriteOutcome]!
      }
        @tier "internal"
      STORE_UNSUPPORTED -> external {
        key : string!
        reason : string!
      }
        @tier "internal"
      STORE_FAILED -> external {
        key : string!
        message : string!
      }
        @tier "internal"
      PG_WIRE_SENT -> external {
        stage : string!
        sql : string!
        params : [PgParam]!
        frame : bytes!
      }
        @tier "internal"
      PG_BUILD -> internal { }
        @tier "internal"
      PG_CLOSED -> internal { }
        @tier "internal"
      PG_COMPOSE -> internal { }
        @tier "internal"
      PG_CONNECTED -> internal {
        sock : number!
      }
        @tier "internal"
      PG_FINISH -> internal { }
        @tier "internal"
      PG_FLUSH -> internal { }
        @tier "internal"
      PG_FRAME -> internal { }
        @tier "internal"
      PG_IO_FAILED -> internal {
        error : string!
      }
        @tier "internal"
      PG_KINDED -> internal { }
        @tier "internal"
      PG_KINDS -> internal { }
        @tier "internal"
      PG_NONCE_DRAWN -> internal {
        value : string!
      }
        @tier "internal"
      PG_NONCE_FAILED -> internal {
        error : string!
      }
        @tier "internal"
      PG_OP -> internal { }
        @tier "internal"
      PG_OPPED -> internal { }
        @tier "internal"
      PG_OUTCOME -> internal { }
        @tier "internal"
      PG_PLAN -> internal { }
        @tier "internal"
      PG_PROOF_FAILED -> internal { }
        @tier "internal"
      PG_RECEIVED -> internal {
        data : bytes!
        eof : boolean!
      }
        @tier "internal"
      PG_RECORD -> internal {
        outcome : RowWriteOutcome!
      }
        @tier "internal"
    }

    listens {
      ROW_READ -> input {
        key : string!
        entityType : string!
        id : string!
      }
        @description "Read one row of an entity type by id."
        @tier "internal"
      ROW_LIST -> input {
        key : string!
        entityType : string!
      }
        @description "List every row of an entity type."
        @tier "internal"
      ROWS_QUERY -> input {
        key : string!
        entityType : string!
        query : RowQuery!
        project : "rows" | "ids"
      }
        @description "A query ask, pushed down as one parameterised SELECT."
        @tier "internal"
      ROWS_WRITE -> input {
        key : string!
        batch : RowWriteBatch!
      }
        @description "Apply a batch of create, upsert, update and delete ops, atomic in BEGIN and COMMIT or stop at the first op that is not applied."
        @tier "internal"
      ROW_COLLECTION -> input {
        entityType : string!
        collection : string!
      }
        @description "Declare the table an entity type's rows live in, as written; an undeclared entity type uses its snake_case plural."
        @tier "internal"
    }
  }

  page "/row-store-postgres" -> RowStoreDriver
}
