app std-row-store-postgres [
  version: "1.0.0",
  net: { "postgres.example.test:5432": [tcp] },
  description: "std-row-store-postgres — a row-store driver over a held Postgres v3 session, in .lolo over os/tcp-connect, os/send, os/recv and os/close, bytes/*, str/*, hash/* and bit/* (no postgres effect, no new operator): the native twin of runtime/src/stores/pg_rows.rs. It answers the row-store typed verbs (ROW_READ, ROW_LIST, ROWS_QUERY, ROWS_WRITE, ROWS_ENSURE_INDEXES) with the exact SQL of spec/store/row-store-postgres.lolo: one table per entity (snake_case, pluralised, or the declared collection), stamps in created_at and updated_at, parameterised two-valued-logic predicates pushed down, an exact total from a window count, atomic batches in BEGIN and COMMIT, stop batches and the atomic take in one statement, and column kinds discovered from information_schema. The wire is spoken here: an SSLRequest unless sslmode is disable or allow (an S answer is STORE_FAILED because os sockets carry no TLS), the startup message, cleartext, md5 and SCRAM-SHA-256 login (HMAC built from hash/sha256 over bytes), then every statement is one Parse, Bind, Describe, Execute and Sync send read until ReadyForQuery. One session is held; a transport failure closes it and the next ask reconnects. Every send emits PG_WIRE_SENT with the stage, the SQL, the binds and the exact frame, the diagnostic the replay goldens assert. One request is in flight per frame: the store seam asks the driver in a frame keyed by the ask (EXEC-STORE-4), and orb validate refuses a trait outside the driver that emits a row verb (ORB_STORE_VERB_OUTSIDE_SEAM)."
]
uses Spec from "almadar-std/row-store-postgres"

orbital RowStorePostgresOrbital {
  type RowCell = string | number | boolean | [RowCell?] | Map string RowCell?
  type Row = Map string RowCell?

  type CompareLeaf = { kind : "compare", field : string!, op : "==" | "!=" | "<" | "<=" | ">" | ">=", value : RowCell }
  type MemberLeaf = { kind : "member", field : string!, values : [RowCell]! }
  type HasElementLeaf = { kind : "hasElement", field : string!, value : RowCell }
  type ContainsLeaf = { kind : "contains", field : string!, text : string!, caseSensitive : boolean! }
  type IsNullLeaf = { kind : "isNull", field : string!, isNull : boolean! }
  type AllNode = { kind : "all", of : [RowPredicate]! }
  type AnyNode = { kind : "any", of : [RowPredicate]! }
  type NotNode = { kind : "not", of : RowPredicate! }
  type ConstLeaf = { kind : "const", value : boolean! }
  type RowPredicate = CompareLeaf | MemberLeaf | HasElementLeaf | ContainsLeaf | IsNullLeaf | AllNode | AnyNode | NotNode | ConstLeaf

  type RowOrder = { field : string!, direction : "asc" | "desc" }
  type RowNearest = { field : string!, vector : [number]!, k : number! }
  type RowQuery = { policy : RowPredicate?, filter : RowPredicate?, order : RowOrder?, offset : number?, limit : number?, total : "exact" | "none"?, nearest : RowNearest? }

  type RowLeafKind = "compare" | "member" | "hasElement" | "contains" | "isNull"
  type RowCombinator = "all" | "any" | "not"
  type RowOperator = "==" | "!=" | "<" | "<=" | ">" | ">=" | "member" | "hasElement" | "contains"
  type RowValueKind = "string" | "number" | "boolean" | "date" | "null"
  type OperatorValueKinds = { operator : RowOperator!, valueKinds : [RowValueKind]! }
  type EveryFieldOrderable = { kind : "every-field" }
  type ListedOrderable = { kind : "listed", fields : [string]! }
  type RowOrderableFields = EveryFieldOrderable | ListedOrderable
  type QueryCapabilities = { leaves : [RowLeafKind]!, combinators : [RowCombinator]!, compareOps : [string]!, operatorValueKinds : [OperatorValueKinds]?, orderableFields : RowOrderableFields!, window : boolean!, exactTotal : boolean!, idsOnly : boolean?, nearest : boolean?, indexes : "runtime" | "deploy" | "none"? }
  type GuardCapabilities = { leaves : [RowLeafKind]!, combinators : [RowCombinator]!, compareOps : [string]! }
  type WriteCapabilities = { guards : GuardCapabilities!, conditional : boolean!, returnsRow : boolean!, stopRuns : boolean!, atomicBatch : boolean! }

  type CreateOp = { kind : "create", entityType : string!, data : Row! }
  type UpsertOp = { kind : "upsert", entityType : string!, data : Row! }
  type UpdateOp = { kind : "update", entityType : string!, id : string!, data : Row!, guard : RowPredicate? }
  type DeleteOp = { kind : "delete", entityType : string!, id : string!, guard : RowPredicate? }
  type SingletonTarget = { kind : "singleton" }
  type KeyTarget = { kind : "key", key : string! }
  type RowTarget = SingletonTarget | KeyTarget
  type RekeyOp = { kind : "rekey", entityType : string!, target : RowTarget!, newId : string!, guard : RowPredicate? }
  type RowWriteOp = CreateOp | UpsertOp | UpdateOp | DeleteOp | RekeyOp
  type RowWriteBatch = { ops : [RowWriteOp]!, onFailure : "atomic" | "stop" }

  type CreatedOutcome = { kind : "created", row : Row! }
  type UpdatedOutcome = { kind : "updated", row : Row!, before : Row? }
  type DeletedOutcome = { kind : "deleted", before : Row? }
  type NotFoundOutcome = { kind : "not-found" }
  type DuplicateIdOutcome = { kind : "duplicate-id" }
  type RefusedOutcome = { kind : "refused" }
  type FailedOutcome = { kind : "failed", message : string! }
  type RolledBackOutcome = { kind : "rolled-back" }
  type RowWriteOutcome = CreatedOutcome | UpdatedOutcome | DeletedOutcome | NotFoundOutcome | DuplicateIdOutcome | RefusedOutcome | FailedOutcome | RolledBackOutcome

  type RowReadVerb = { key : string!, entityType : string!, id : string!, collection : string }
  type RowListVerb = { key : string!, entityType : string!, collection : string }
  type RowsQueryVerb = { key : string!, entityType : string!, query : RowQuery!, project : "rows" | "ids", collection : string }
  type RowsWriteVerb = { key : string!, batch : RowWriteBatch!, collections : Map string string }
  type IndexPath = { fields : [string]!, orderBy : string? }
  type RowsEnsureIndexesVerb = { key : string!, entityType : string!, indexes : [IndexPath]! }

  type SqlColumn = { name : string!, typeOid : number! }
  type PgNullParam = { kind : "null" }
  type PgTextParam = { kind : "text", text : string! }
  type PgParam = PgNullParam | PgTextParam
  type PgBind = { isNull : boolean!, text : string! }
  type ColumnKinds = Map string string
  type SchemaCache = Map string ColumnKinds
  type PgCol = { name : string!, oid : number! }
  type PgRaw = { cells : [PgBind]! }
  type PgErr = { present : boolean!, code : string!, message : string! }
  type PgAuth = { code : number!, body : bytes! }
  type PgScan = { pos : number!, cols : [PgCol]!, raw : [PgRaw]!, err : PgErr!, auth : [PgAuth]!, done : boolean!, stop : boolean!, bad : boolean!, tag : string! }
  type PgProof = { frame : bytes?, sig : bytes?, error : string! }
  type PgWrapped = { sql : string!, binds : [PgBind]! }
  type PgWhere = { sqls : [string]!, binds : [PgBind]! }
  type PgBuilt = { sql : string!, binds : [PgBind]!, bindBase : number!, countSql : string!, countBinds : [PgBind]! }
  type PgHalt = { kind : string!, message : string! }
  type OpView = { kind : string!, entityType : string!, id : string, data : Row, guard : RowPredicate? }
  type NumBox = { value : number! }
  type FieldList = { fields : [string]! }

  entity RowStoreFlight [runtime] {
    id : string!
    key : string @description "The kernel's key for the ask in flight; every reply carries it" = ""
    entityType : string @description "The entity type a read, list or query asks about" = ""
    op : string @description "The ask in flight: read, list, query, write, ensure or sql" = ""
    rowId : string @description "The id a read asks for" = ""
    table : string @description "The table the statement in flight targets" = ""
    project : string @description "What a query answers: rows or ids" = ""
    query : RowQuery @description "The query a query ask carries" = {}
    batch : RowWriteBatch @description "The batch a write ask carries" = { ops: [], onFailure: "stop" }
    opAt : number @description "The index of the batch op or index statement in flight" = 0
    paths : [IndexPath] @description "The index paths an ensureIndexes ask carries" = []
    ddl : [string] @description "The CREATE INDEX statements an ensureIndexes ask runs, in order" = []
    outcomes : [RowWriteOutcome] @description "The outcomes of the ops that ran" = []
    sql : string @description "The SQL of the statement in flight" = ""
    params : [PgParam] @description "The binds of the statement in flight, as the diagnostic emits them" = []
    binds : [PgBind] @description "The binds of the statement in flight" = []
    userName : string @description "The login role read from the connection URL" = ""
    pwLen : number @description "The byte length of the login password, read by the kernel from the password credential; -1 when it is not held" = -1
    dbName : string @description "The database read from the connection URL" = ""
    sock : number @description "The held session's socket; below zero while no session is open" = -1
    inbox : bytes @description "Bytes received and not yet consumed as whole messages" = ""
    nonce : string @description "The SCRAM client nonce" = ""
    scram : string @description "The server signature the SCRAM server-final must carry" = ""
    schema : SchemaCache @description "Column kinds per table, read from information_schema" = {}
    declared : string @description "The declared collection the read, list or query in flight names; empty when the entity declares none" = ""
    writeCollections : Map string string @description "The declared collection per entity type the write batch in flight names" = {}
    stage : string @description "What the statement in flight is for: ssl-request, startup, password, scram-first, scram-final, discover, begin, statement, count, commit or rollback" = ""
    bindBase : number @description "How many binds the SQL text already numbers itself" = 0
    frame : bytes @description "The exact bytes of the send in flight" = ""
    cols : [PgCol] @description "The result columns of the reply being read" = []
    raw : [PgRaw] @description "The data rows of the reply being read, cells undecoded" = []
    rows : [Row] @description "The decoded data rows of the finished reply" = []
    err : PgErr @description "The server error of the reply being read" = { present: false, code: "", message: "" }
    scan : PgScan @description "The result of reading one chunk" = { pos: 0, cols: [], raw: [], err: { present: false, code: "", message: "" }, auth: [], done: false, stop: false, bad: false, tag: "" }
    tag : string @description "The command tag of the reply being read (SELECT 3): its last word is the row count a ROWS_SQL answers" = ""
    userSql : string @description "The statement a ROWS_SQL ask carries, sent as given" = ""
    userParams : [RowCell?] @description "The bind values a ROWS_SQL ask carries" = []
    act : PgAuth @description "The authentication request this chunk asks the driver to answer; code 0 when there is none" = { code: 0, body: "" }
    badSig : boolean @description "The server-final signature did not match" = false
    proof : PgProof @description "The SCRAM client-final frame and the signature expected back; absent when the exchange failed" = { error: "" }
    preds : [RowPredicate] @description "The predicates the statement in flight compiles" = []
    extra : [string] @description "Fields the statement reads besides its predicates" = []
    written : [string] @description "Fields the write in flight sets" = []
    needKinds : boolean @description "Whether the statement needs column kinds" = false
    fresh : boolean @description "Column kinds were read for the op in flight" = false
    covered : boolean @description "The cached column kinds know every field the statement names" = false
    fields : [string] @description "Every field the statement names" = []
    kinds : ColumnKinds @description "The column kinds the statement is built with" = {}
    where : PgWhere @description "The compiled predicates" = { sqls: [], binds: [] }
    built : PgBuilt @description "The statement composed for the op in flight" = { sql: "", binds: [], bindBase: 0, countSql: "", countBinds: [] }
    cur : OpView @description "The batch op in flight" = { kind: "", entityType: "" }
    halt : PgHalt @description "Why an atomic batch is rolling back without an outcome; empty kind when it is not" = { kind: "", message: "" }
    page : [Row] @description "The rows of a query page held while the total is counted" = []
    lastOutcome : RowWriteOutcome @description "The outcome of the batch op whose reply was just read" = { kind: "not-found" }
    countSql : string @description "The count statement of the query in flight" = ""
    countBinds : [PgBind] @description "The binds of the count statement" = []
  }

  trait RowStoreDriver -> RowStoreFlight [optimistic] {
    initial: ready

    config {
      host : string = "postgres.example.test"
        @label "Host"
        @description "The server address os/tcp-connect opens; a literal knob because the net grant is checked against it."
        @tier "infra"
      port : number = 5432
        @label "Port"
        @description "The server port os/tcp-connect opens; a literal knob because the net grant is checked against it."
        @tier "infra"
      url : string = "postgres://app@postgres.example.test:5432/app"
        @label "Connection URL"
        @description "postgres://user@host:port/database, the DATABASE_URL form without the password: the user and the database come from it (percent-decoded), and a URL that carries a password is refused. host and port below open the socket and must name the same server, because the net grant is checked against literals."
        @tier "infra"
      password : secret = "POSTGRES_PASSWORD"
        @label "Password"
        @description "The credential holding the login password. The kernel reads its length and derives the md5 and SCRAM proofs from it, and the host fills it into the cleartext password message, so the atom never holds the password; a server that asks for a password while the credential is not held is STORE_FAILED."
        @tier "infra"
      sslmode : string!
        @label "SSL mode"
        @description "Required: disable, allow, prefer, require, verify-ca or verify-full, declared by every call site (no default, so nothing downgrades silently). disable and allow send no SSLRequest; the rest send one, and N is accepted under prefer only. An S answer is STORE_FAILED until the kernel's os/tls-upgrade lands (EXEC-HTTP-7)."
        @tier "infra"
      statementTimeoutMs : number = 0
        @label "Statement timeout (ms)"
        @description "Milliseconds the server lets one statement of the held session run before it cancels it (SQLSTATE 57014), sent as the session's statement_timeout in the startup message so it bounds every statement alike; 0 sends none."
        @tier "infra"
      recvBytes : number = 16384
        @label "Read size"
        @description "The most bytes one os/recv takes."
        @tier "infra"
      queryCapabilities : QueryCapabilities = { leaves: ["compare", "member", "hasElement", "contains", "isNull"], combinators: ["all", "any", "not"], compareOps: ["==", "!=", "<", "<=", ">", ">="], orderableFields: { kind: "every-field" }, window: true, exactTotal: true, idsOnly: true, indexes: "runtime" }
        @description "What query the store pushes down: every leaf and combinator, any orderable field, a window, an exact total and an ids-only projection; nearest is not pushed down."
        @tier "infra"
      writeCapabilities : WriteCapabilities = { guards: { leaves: ["compare", "member", "hasElement", "contains", "isNull"], combinators: ["all", "any", "not"], compareOps: ["==", "!=", "<", "<=", ">", ">="] }, conditional: true, returnsRow: true, stopRuns: true, atomicBatch: true }
        @description "What write the store honours: every guard form, the row before an update or delete, stop runs and atomic batches."
        @tier "infra"
    }

    state ready {
      INIT -> ready
      PG_BROKEN -> ready
        (os/close @entity.sock { key: "close" emit: { success: PG_CLOSED, failure: PG_CLOSED } })
        (set @entity.sock -1)
        (set @entity.inbox (bytes/from-string ""))
        (emit STORE_FAILED { key: @entity.key, message: @payload.message })

      PG_CLOSED -> ready
      ROWS_QUERY -> ready when (and (!= (object/get @payload.query "nearest" null) null) (not (object/get @config.queryCapabilities "nearest" false)))
        (emit STORE_UNSUPPORTED { key: @payload.key, reason: "nearest is unsupported by this store" })
      ROWS_WRITE -> ready when (and (= @payload.batch.onFailure "atomic") (not @config.writeCapabilities.atomicBatch))
        (emit STORE_UNSUPPORTED { key: @payload.key, reason: "this store declares no atomic batches" })
      ROWS_WRITE -> ready when (and (= @payload.batch.onFailure "stop") (not @config.writeCapabilities.stopRuns))
        (emit STORE_UNSUPPORTED { key: @payload.key, reason: "this store declares no stop runs" })
      ROWS_WRITE -> ready when (array/some @payload.batch.ops (fn ro (= (object/get @ro "kind" "") "rekey")))
        (emit STORE_FAILED { key: @payload.key, message: "rekey is unsupported by this store" })
      ROWS_WRITE -> ready when (and (not (array/some @payload.batch.ops (fn ro (= (object/get @ro "kind" "") "rekey")))) (= (array/len @payload.batch.ops) 0))
        (emit ROWS_WRITTEN { key: @payload.key, outcomes: [] })
      ROWS_ENSURE_INDEXES -> ready when (= (array/len @payload.indexes) 0)
        (emit ROWS_INDEXES_ENSURED { key: @payload.key })
      ROW_READ -> ready when (and true (and (< @entity.sock 0) (not (and (and (str/includes @config.url "://") (array/includes ["postgres", "postgresql"] (array/nth (str/split @config.url "://") 0)) (not (str/includes (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":"))) (array/includes ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] @config.sslmode)))))
        (emit STORE_FAILED { key: @payload.key, message: (if (not (str/includes @config.url "://")) "DATABASE_URL is not a URL: relative URL without a base" (if (not (array/includes ["postgres", "postgresql"] (array/nth (str/split @config.url "://") 0))) (str/concat "DATABASE_URL must be postgres:// or postgresql://, not " (array/nth (str/split @config.url "://") 0) "://") (if (not (not (str/includes (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":"))) "DATABASE_URL carries a password: the login password is the password credential, never part of the URL" (str/concat "sslmode `" @config.sslmode "` is not one of disable, allow, prefer, require, verify-ca, verify-full")))) })
      ROW_READ -> connecting when (and true (and (< @entity.sock 0) (and (str/includes @config.url "://") (array/includes ["postgres", "postgresql"] (array/nth (str/split @config.url "://") 0)) (not (str/includes (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":"))) (array/includes ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] @config.sslmode)))
        (set @entity.key @payload.key)
        (set @entity.entityType @payload.entityType)
        (set @entity.rowId @payload.id)
        (set @entity.declared (default @payload.collection ""))
        (set @entity.op "read")
        (set @entity.stage "start")
        (set @entity.opAt 0)
        (set @entity.outcomes [])
        (set @entity.fresh false)
        (set @entity.halt { kind: "", message: "" })
        (set @entity.rows [])
        (set @entity.raw [])
        (set @entity.cols [])
        (set @entity.err { present: false, code: "", message: "" })
        (set @entity.sql "")
        (set @entity.params [])
        (set @entity.binds [])
        (set @entity.inbox (bytes/from-string ""))
        (set @entity.ddl [])
        (set @entity.table (let ((tachars (str/split @entity.entityType ""))) (let ((tasnake (str/join (array/map (array/range 0 (array/len @tachars)) (fn tai (let ((tac (array/nth @tachars @tai))) (if (and (> @tai 0) (validate/pattern @tac "^[A-Z]$") (validate/pattern (array/nth @tachars (- @tai 1)) "^[a-z0-9]$")) (str/concat "_" (str/lower @tac)) (str/lower @tac))))) ""))) (let ((tadecl @entity.declared)) (if (!= @tadecl "") @tadecl (if (str/endsWith @tasnake "y") (str/concat (str/slice @tasnake 0 (- (str/len @tasnake) 1)) "ies") (if (str/endsWith @tasnake "s") (str/concat @tasnake "es") (str/concat @tasnake "s"))))))))
        (set @entity.userName (if (= (array/nth (str/split (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":") 0) "") "postgres" (let ((dt (array/nth (str/split (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":") 0))) (if (str/uri-component-valid @dt) (str/decode-uri-component @dt) @dt))))
        (set @entity.pwLen (default (credential/byte-length @config.password) -1))
        (set @entity.dbName (if (= (array/nth (str/split (str/join (array/drop (str/split (array/nth (str/split @config.url "://") 1) "/") 1) "/") "?") 0) "") @entity.userName (let ((dt (array/nth (str/split (str/join (array/drop (str/split (array/nth (str/split @config.url "://") 1) "/") 1) "/") "?") 0))) (if (str/uri-component-valid @dt) (str/decode-uri-component @dt) @dt))))
        (os/tcp-connect @config.host @config.port { key: "connect" emit: { success: PG_CONNECTED, failure: PG_IO_FAILED } })
      ROW_LIST -> ready when (and true (and (< @entity.sock 0) (not (and (and (str/includes @config.url "://") (array/includes ["postgres", "postgresql"] (array/nth (str/split @config.url "://") 0)) (not (str/includes (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":"))) (array/includes ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] @config.sslmode)))))
        (emit STORE_FAILED { key: @payload.key, message: (if (not (str/includes @config.url "://")) "DATABASE_URL is not a URL: relative URL without a base" (if (not (array/includes ["postgres", "postgresql"] (array/nth (str/split @config.url "://") 0))) (str/concat "DATABASE_URL must be postgres:// or postgresql://, not " (array/nth (str/split @config.url "://") 0) "://") (if (not (not (str/includes (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":"))) "DATABASE_URL carries a password: the login password is the password credential, never part of the URL" (str/concat "sslmode `" @config.sslmode "` is not one of disable, allow, prefer, require, verify-ca, verify-full")))) })
      ROW_LIST -> connecting when (and true (and (< @entity.sock 0) (and (str/includes @config.url "://") (array/includes ["postgres", "postgresql"] (array/nth (str/split @config.url "://") 0)) (not (str/includes (if (str/includes (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) (array/nth (str/split (array/nth (str/split (array/nth (str/split @config.url "://") 1) "/") 0) (str/slice "a@b" 1 2)) 0) "") ":"))) (array/includes ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] @config.sslmode)))
        (set @entity.key @payload.key)
        (set @entity.entityType @payload.entityType)
        (set @entity.declared (default @payload.collection ""))
        (set @entity.op "list")
        (set @entity.stage "start")
        (set @entity.opAt 0)
        (set @entity.outcomes [])
        (set @entity.fresh false)
        (set @entity.halt { kind: "", message: "" })
        (set @entity.rows [])
        (set @entity.raw [])
        (set @entity.cols [])
        (set @entity.err { present: false, code: "", message: "" })
        (set @entity.sql "")
        (set @entity.params [])
        (set @entity.binds [])
        (set @entity.inbox (bytes/from-string ""))
        (set @entity.ddl [])
