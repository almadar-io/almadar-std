        total : number!
      }
        @tier "internal"
      FS_REPLIED -> internal {
        status : number!
        headers : Map string string
        body : string!
        key : string
      }
        @tier "internal"
      FS_UNREACHABLE -> internal {
        error : string!
        kind : string
        credential : string
        key : string
      }
        @tier "internal"
    }

    listens {
      ROW_READ -> input {
        key : string!
        entityType : string!
        id : string!
      }
        @description "Read one row of an entity type by id."
        @tier "internal"
      ROW_LIST -> input {
        key : string!
        entityType : string!
      }
        @description "List every row of an entity type."
        @tier "internal"
      ROWS_QUERY -> input {
        key : string!
        entityType : string!
        query : RowQuery!
        project : "rows" | "ids"
      }
        @description "A query ask; answered as a structured Firestore query when Firestore can run it, else STORE_UNSUPPORTED."
        @tier "internal"
      ROWS_WRITE -> input {
        key : string!
        batch : RowWriteBatch!
      }
        @description "Apply a batch of create, upsert, update and delete ops in one Firestore transaction."
        @tier "internal"
    }
  }

  page boot as FirestoreStart -> RowStoreDriver
}
