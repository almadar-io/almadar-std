app std-firestore [
  version: "1.0.0",
  description: "std-firestore — a row-store driver over the Firestore REST API, the std twin of runtime/src/stores/firestore.rs (contract: spec/store/firestore.lolo). It answers the same typed row verbs as every RowStoreDriver (spec/store/row-store.lolo): ROW_READ, ROW_LIST, ROWS_QUERY and ROWS_WRITE in, ROW_FOUND, ROWS_LISTED, ROWS_PAGE, ROWS_IDS, ROWS_WRITTEN, STORE_UNSUPPORTED or STORE_FAILED out, each carrying the asked key. Layout: with a root document path (an even number of segments) rows live at <root>/entities/<key>/rows/<id>, with an empty root at the top-level collection <key>/<id>, where <key> is the entity's declared collection (config.collections) else the entity type name; a document holds the row's fields and its id and a read stamps the document name's id over it. Wire (POST <origin>/v1/projects/<project>/databases/<database>/documents<suffix>?$alt=json%3Benum-encoding=int, JSON in and out, Authorization Bearer): a read is :batchGet with documents [<document name>], a list is <parent>:runQuery with from [{collectionId}], a query is <parent>:runQuery with the structured query the plan builds, a count is <parent>:runAggregationQuery, a write batch is one transaction (:batchGet with newTransaction {readWrite: {}} over every touched document, then :commit with the net change and the transaction id). The parent path segments are URI-encoded. Values use Firestore's typed encoding: stringValue, integerValue (a decimal string, whole numbers below 2^63), doubleValue, booleanValue, nullValue, arrayValue ({} when empty), mapValue {fields}; timestampValue and referenceValue read back as text. Query push-down: == and the four range operators, member (IN, at most 30 values), hasElement (ARRAY_CONTAINS), all, and an any over one field and one leaf kind (IN or ARRAY_CONTAINS_ANY); an id comparison is a referenceValue on __name__. A query Firestore cannot run answers STORE_UNSUPPORTED with the plan's reason word (leaf-unsupported, combinator-unsupported, value-kind-unsupported, order-field, nearest) and so does a Firestore refusal with status FAILED_PRECONDITION or INVALID_ARGUMENT (the reason is that status); a query that can match nothing answers an empty page without a request. The total is settled from the window when it can be (a non-empty window that ended before its limit, an empty first page), else counted. Writes: every touched document is read inside the transaction, the ops run over those rows with the reference semantics (create on a taken id is duplicate-id, update or delete of a miss is not-found, a guard that does not hold is refused, an id-less create or upsert fails with 'create needs a string id' or 'upsert needs a string id'), an atomic batch that fails commits nothing and reports rolled-back for the earlier ops, a stop batch commits what was applied; only changed documents are written, deletes before sets per entity type. A commit that Firestore aborts (ABORTED) repeats the whole transaction from its read, at most config.transactionAttempts times, then STORE_FAILED 'the Firestore transaction kept aborting: <last error text>'. A rekey op is STORE_FAILED 'rekey is unsupported by this store' before any request. Failures: a non-2xx reply is STORE_FAILED with the reply text, a transport failure with the transport's error text, a 2xx reply that is not JSON 'Firestore answered an unreadable reply', a count reply with no result 'Firestore answered a count with no result'. A root with an odd number of segments is STORE_FAILED. Auth: config.auth emulator sends Bearer owner, token sends Bearer <the access-token credential>, service-account mints an RS256 service-account bearer through the http jwt-bearer auth (scope https://www.googleapis.com/auth/datastore, audience https://oauth2.googleapis.com/token, refreshed a minute before expiry). One request is in flight per frame: the store seam asks the driver in a frame keyed by the ask (EXEC-STORE-4), and orb validate refuses a trait outside the driver that emits a row verb (ORB_STORE_VERB_OUTSIDE_SEAM).",
  egress: ["http://127.0.0.1:8080", "https://firestore.googleapis.com", "https://oauth2.googleapis.com"]
]
uses Spec from "almadar-std/firestore"

orbital FirestoreOrbital {
  type RowCell = string | number | boolean | [RowCell?] | Map string RowCell?
  type Row = Map string RowCell?

  type CompareLeaf = { kind : "compare", field : string!, op : "==" | "!=" | "<" | "<=" | ">" | ">=", value : RowCell? }
  type MemberLeaf = { kind : "member", field : string!, values : [RowCell?]! }
  type HasElementLeaf = { kind : "hasElement", field : string!, value : RowCell? }
  type ContainsLeaf = { kind : "contains", field : string!, text : string!, caseSensitive : boolean! }
  type IsNullLeaf = { kind : "isNull", field : string!, isNull : boolean! }
  type AllNode = { kind : "all", of : [RowPredicate]! }
  type AnyNode = { kind : "any", of : [RowPredicate]! }
  type NotNode = { kind : "not", of : RowPredicate! }
  type ConstLeaf = { kind : "const", value : boolean! }
  type RowPredicate = CompareLeaf | MemberLeaf | HasElementLeaf | ContainsLeaf | IsNullLeaf | AllNode | AnyNode | NotNode | ConstLeaf

  type RowOrder = { field : string!, direction : "asc" | "desc" }
  type RowNearest = { field : string!, vector : [number]!, k : number! }
  type RowQuery = { policy : RowPredicate?, filter : RowPredicate?, order : RowOrder?, offset : number?, limit : number?, total : "exact" | "none"?, nearest : RowNearest? }

  type RowLeafKind = "compare" | "member" | "hasElement" | "contains" | "isNull"
  type RowCombinator = "all" | "any" | "not"
  type RowOperator = "==" | "!=" | "<" | "<=" | ">" | ">=" | "member" | "hasElement" | "contains"
  type RowValueKind = "string" | "number" | "boolean" | "date" | "null"
  type OperatorValueKinds = { operator : RowOperator!, valueKinds : [RowValueKind]! }
  type EveryFieldOrderable = { kind : "every-field" }
  type ListedOrderable = { kind : "listed", fields : [string]! }
  type RowOrderableFields = EveryFieldOrderable | ListedOrderable
  type QueryCapabilities = { leaves : [RowLeafKind]!, combinators : [RowCombinator]!, compareOps : [string]!, operatorValueKinds : [OperatorValueKinds]?, orderableFields : RowOrderableFields!, window : boolean!, exactTotal : boolean!, idsOnly : boolean?, nearest : boolean? }
  type GuardCapabilities = { leaves : [RowLeafKind]!, combinators : [RowCombinator]!, compareOps : [string]! }
  type WriteCapabilities = { guards : GuardCapabilities!, conditional : boolean!, returnsRow : boolean!, stopRuns : boolean!, atomicBatch : boolean! }

  type CreateOp = { kind : "create", entityType : string!, data : Row! }
  type UpsertOp = { kind : "upsert", entityType : string!, data : Row! }
  type UpdateOp = { kind : "update", entityType : string!, id : string!, data : Row!, guard : RowPredicate? }
  type DeleteOp = { kind : "delete", entityType : string!, id : string!, guard : RowPredicate? }
  type SingletonTarget = { kind : "singleton" }
  type KeyTarget = { kind : "key", key : string! }
  type RowTarget = SingletonTarget | KeyTarget
  type RekeyOp = { kind : "rekey", entityType : string!, target : RowTarget!, newId : string!, guard : RowPredicate? }
  type RowWriteOp = CreateOp | UpsertOp | UpdateOp | DeleteOp | RekeyOp
  type RowWriteBatch = { ops : [RowWriteOp]!, onFailure : "atomic" | "stop" }

  type CreatedOutcome = { kind : "created", row : Row! }
  type UpdatedOutcome = { kind : "updated", row : Row!, before : Row? }
  type DeletedOutcome = { kind : "deleted", before : Row? }
  type NotFoundOutcome = { kind : "not-found" }
  type DuplicateIdOutcome = { kind : "duplicate-id" }
  type RefusedOutcome = { kind : "refused" }
  type FailedOutcome = { kind : "failed", message : string! }
  type RolledBackOutcome = { kind : "rolled-back" }
  type RowWriteOutcome = CreatedOutcome | UpdatedOutcome | DeletedOutcome | NotFoundOutcome | DuplicateIdOutcome | RefusedOutcome | FailedOutcome | RolledBackOutcome

  type FirestoreAuth = "emulator" | "token" | "service-account"
  type Wire = string | number | boolean | [Wire?] | Map string Wire?
  type FsFound = { name : string!, fields : Map string Wire? }
  type FsResult = { aggregateFields : Map string Wire? }
  type FsElement = { transaction : string, found : FsFound, document : FsFound, result : FsResult }
  type FsReply = [FsElement]
  type FsErrorDetail = { status : string }
  type FsErrorBody = { error : FsErrorDetail }
  type FsDoc = { name : string!, id : string!, fields : Row }
  type WhereClause = { field : string!, op : string!, value : RowCell?, values : [RowCell?]! }
  type Collection = { entityType : string!, collection : string! }
  type PlanPart = { leafBad : boolean!, kindBad : boolean!, k : string!, ws : [WhereClause]!, reason : string!, ak : string!, af : string!, av : [RowCell?]! }
  type Clause = { k : string!, ws : [WhereClause]!, reason : string! }
  type OrderBy = { field : string!, descending : boolean! }
  type QueryPlan = { decline : string!, nothing : boolean!, ws : [WhereClause]!, orderBy : [OrderBy]!, offset : number?, limit : number?, idsOnly : boolean!, totalNone : boolean! }
  type Touched = { entityType : string!, id : string! }
  type Table = { entityType : string!, rows : [Row]! }
  type WriteRun = { tables : [Table]!, outcomes : [RowWriteOutcome]!, halted : boolean! }
  type JsonDoc = string | number | boolean | [JsonDoc] | Map string JsonDoc
  type RowIdRec = { id : string }
  type ArrayInner = { values : [JsonDoc] }
  type MapInner = { fields : Map string JsonDoc }
  type FsWrite = Map string RowCell

  entity FirestoreFlight [runtime] {
    id : string!
    key : string @description "The kernel's key for the ask in flight; every reply carries it" = ""
    entityType : string @description "The entity type a read, list or query asks" = ""
    rowId : string @description "The id a read asks for" = ""
    op : string @description "The ask in flight: read, list, query or write" = ""
    phase : string @description "The request in flight: read, list, query, count, txread or commit" = ""
    project : string @description "What a query answers: rows or ids" = ""
    rowsPath : string @description "The collection path holding the asked entity's rows" = ""
    parentSuffix : string @description "The query suffix path of the collection's parent, URI-encoded per segment; empty for a top-level collection" = ""
    collection : string @description "The collection id of the asked rows" = ""
    suffix : string @description "The request path after /documents" = ""
    body : Map string RowCell @description "The request body" = { }
    els : [FsElement] @description "The elements of the reply just read" = []
    docs : [FsDoc] @description "The documents of the reply just read, decoded" = []
    pageDocs : [FsDoc] @description "The documents of a query window while its total is counted" = []
    tx : string @description "The transaction id the transactional read answered; empty when none" = ""
    counted : number @description "The count a count reply answered" = 0
    query : RowQuery @description "The query being planned" = { }
    parts : [PlanPart] @description "The plan fold of the policy and the filter" = []
    caps : string @description "The capability reason word, empty when Firestore can run the query" = ""
    clause : Clause @description "The where clauses of the policy and filter together" = { k: "some", ws: [], reason: "" }
    plan : QueryPlan @description "What planning the query decided" = { decline: "", nothing: false, ws: [], orderBy: [], idsOnly: false, totalNone: false }
    batch : RowWriteBatch @description "The batch a write applies" = { ops: [], onFailure: "stop" }
    touched : [Touched] @description "The documents the batch touches, in first-use order" = []
    entities : [string] @description "The entity types the batch touches, in first-use order" = []
    readBody : Map string RowCell @description "The transactional read, kept to repeat it when Firestore aborts the transaction" = { }
    attempt : number @description "The transaction attempt in flight, from 1" = 0
    tables0 : [Table] @description "The touched rows as the transaction read them, by entity type" = []
    run : WriteRun @description "The batch applied over the rows read" = { tables: [], outcomes: [], halted: false }
    writes : [FsWrite] @description "The commit's writes: the net change, deletes before sets per entity type" = []
    errStatus : string @description "The gRPC status word of the failed reply, empty when none" = ""
    errMessage : string @description "The failure text" = ""
    errKind : string @description "decline, abort or fail" = ""
  }

  trait RowStoreDriver -> FirestoreFlight {
    initial: ready

    config {
      origin : url = "http://127.0.0.1:8080"
        @label "Firestore origin"
        @description "The Firestore REST origin: the emulator as http://host:port or https://firestore.googleapis.com. Must be declared in the app egress list."
        @synonyms "firestore host, emulator host, database server"
        @tier "infra"
      projectId : string = "demo-almadar"
        @label "Project id"
        @description "The Firebase project the documents live in (the emulator accepts any)."
        @synonyms "firebase project, gcp project"
        @tier "infra"
      databaseId : string = "(default)"
        @label "Database id"
        @description "The Firestore database id."
        @synonyms "database name, firestore database"
        @tier "infra"
      root : string = ""
        @label "Root document"
        @description "The document path the rows hang under (hosted/<appId>), an even number of segments; empty keeps the entity collections at the top level."
        @synonyms "root path, tenant root, app root"
        @tier "infra"
      collections : [Collection] = []
        @label "Declared collections"
        @description "The collection an entity type is keyed by in place of its name, for an entity bound to a declared persistent collection."
        @synonyms "collection names, table names"
        @tier "domain"
      orderableFields : [string] = []
        @label "Orderable fields"
        @description "The fields (besides id) every document carries, non-null and indexed with the document id as tie-break: only these can order a pushed-down query, since Firestore drops documents lacking the ordered field."
        @synonyms "sortable fields, indexed fields"
        @tier "domain"
      auth : FirestoreAuth = "emulator"
        @label "Authentication"
        @description "emulator sends Bearer owner; token sends the access-token credential as the bearer; service-account mints an RS256 bearer from the service-account key credential."
        @synonyms "credentials mode, bearer mode"
        @tier "infra"
      accessTokenCredential : secret = "FIRESTORE_ACCESS_TOKEN"
        @label "Access token credential"
        @description "The credential name the host resolves to the bearer token (auth token)."
        @synonyms "oauth token, bearer token"
        @tier "infra"
      serviceAccountCredential : secret = "FIREBASE_SERVICE_ACCOUNT"
        @label "Service-account credential"
        @description "The credential name the host resolves to the service-account key JSON (auth service-account)."
        @synonyms "service account key, firebase admin key"
        @tier "infra"
      tokenUrl : url = "https://oauth2.googleapis.com/token"
        @label "Token URL"
        @description "The OAuth token endpoint the service-account assertion is exchanged at."
        @synonyms "oauth endpoint"
        @tier "infra"
      scope : string = "https://www.googleapis.com/auth/datastore"
        @label "Token scope"
        @description "The scope claim of the service-account assertion."
        @synonyms "oauth scope"
        @tier "infra"
      transactionAttempts : number = 5
        @label "Transaction attempts"
        @description "How many times a write transaction that Firestore aborts (contention) is repeated from its read."
        @synonyms "contention retries"
        @tier "infra"
      queryCapabilities : QueryCapabilities = { leaves: ["compare", "member", "hasElement"], combinators: ["all", "any"], compareOps: ["==", "<", "<=", ">", ">="], operatorValueKinds: [{ operator: "<", valueKinds: ["string", "number", "boolean", "date"] }, { operator: "<=", valueKinds: ["string", "number", "boolean", "date"] }, { operator: ">", valueKinds: ["string", "number", "boolean", "date"] }, { operator: ">=", valueKinds: ["string", "number", "boolean", "date"] }], orderableFields: { kind: "every-field" }, window: true, exactTotal: true, idsOnly: true, nearest: false }
        @label "Query capabilities"
        @description "What query Firestore runs: == and range comparisons, member, hasElement, all, and an any over one field."
        @synonyms "pushdown capabilities"
        @tier "infra"
      writeCapabilities : WriteCapabilities = { guards: { leaves: ["compare", "member", "hasElement", "contains", "isNull"], combinators: ["all", "any", "not"], compareOps: ["==", "!=", "<", "<=", ">", ">="] }, conditional: true, returnsRow: true, stopRuns: true, atomicBatch: true }
        @label "Write capabilities"
        @description "What write the store honours: every guard form, the row before an update or delete, stop runs and atomic batches, all inside one transaction."
        @synonyms "write forms"
        @tier "infra"
    }

    state ready {
      INIT -> ready

      ROW_READ -> ready when (!= (math/mod (array/len (array/filter (str/split @config.root "/") (fn s (!= @s "")))) 2) 0)
        (emit STORE_FAILED { key: @payload.key, message: (str/concat "FirestoreRows root \"" @config.root "\" is not a document path (it needs an even number of segments)") })
      ROW_READ -> busy when (not (!= (math/mod (array/len (array/filter (str/split @config.root "/") (fn s (!= @s "")))) 2) 0))
        (set @entity.key @payload.key)
        (set @entity.entityType @payload.entityType)
        (set @entity.rowId @payload.id)
        (set @entity.op "read")
        (set @entity.phase "read")
        (set @entity.rowsPath (let ((ck (let ((cc (array/find @config.collections (fn c (= @c.entityType @entity.entityType))))) (if (= @cc null) @entity.entityType (object/get @cc "collection" @entity.entityType))))) (if (= @config.root "") @ck (str/concat @config.root "/entities/" @ck "/rows"))))
        (set @entity.collection (array/last (str/split @entity.rowsPath "/")))
        (set @entity.parentSuffix (str/join (array/map (array/take (str/split @entity.rowsPath "/") (- (array/len (str/split @entity.rowsPath "/")) 1)) (fn s (str/encode-uri-component @s))) "/"))
        (set @entity.suffix ":batchGet")
        (set @entity.body { documents: [(str/concat "projects/" @config.projectId "/databases/" @config.databaseId "/documents/" (str/concat @entity.rowsPath "/" @entity.rowId))] })
        (emit FS_SEND { })

      ROW_LIST -> ready when (!= (math/mod (array/len (array/filter (str/split @config.root "/") (fn s (!= @s "")))) 2) 0)
        (emit STORE_FAILED { key: @payload.key, message: (str/concat "FirestoreRows root \"" @config.root "\" is not a document path (it needs an even number of segments)") })
      ROW_LIST -> busy when (not (!= (math/mod (array/len (array/filter (str/split @config.root "/") (fn s (!= @s "")))) 2) 0))
        (set @entity.key @payload.key)
        (set @entity.entityType @payload.entityType)
        (set @entity.op "list")
        (set @entity.phase "list")
        (set @entity.rowsPath (let ((ck (let ((cc (array/find @config.collections (fn c (= @c.entityType @entity.entityType))))) (if (= @cc null) @entity.entityType (object/get @cc "collection" @entity.entityType))))) (if (= @config.root "") @ck (str/concat @config.root "/entities/" @ck "/rows"))))
        (set @entity.collection (array/last (str/split @entity.rowsPath "/")))
        (set @entity.parentSuffix (str/join (array/map (array/take (str/split @entity.rowsPath "/") (- (array/len (str/split @entity.rowsPath "/")) 1)) (fn s (str/encode-uri-component @s))) "/"))
        (set @entity.suffix (if (= @entity.parentSuffix "") ":runQuery" (str/concat "/" @entity.parentSuffix ":runQuery")))
        (set @entity.body { structuredQuery: { from: [{ collectionId: @entity.collection }] } })
        (emit FS_SEND { })

      ROWS_QUERY -> ready when (!= (math/mod (array/len (array/filter (str/split @config.root "/") (fn s (!= @s "")))) 2) 0)
        (emit STORE_FAILED { key: @payload.key, message: (str/concat "FirestoreRows root \"" @config.root "\" is not a document path (it needs an even number of segments)") })
      ROWS_QUERY -> busy when (not (!= (math/mod (array/len (array/filter (str/split @config.root "/") (fn s (!= @s "")))) 2) 0))
        (set @entity.key @payload.key)
        (set @entity.entityType @payload.entityType)
        (set @entity.project (or @payload.project "rows"))
        (set @entity.op "query")
        (set @entity.query @payload.query)
        (set @entity.rowsPath (let ((ck (let ((cc (array/find @config.collections (fn c (= @c.entityType @entity.entityType))))) (if (= @cc null) @entity.entityType (object/get @cc "collection" @entity.entityType))))) (if (= @config.root "") @ck (str/concat @config.root "/entities/" @ck "/rows"))))
        (set @entity.collection (array/last (str/split @entity.rowsPath "/")))
        (set @entity.parentSuffix (str/join (array/map (array/take (str/split @entity.rowsPath "/") (- (array/len (str/split @entity.rowsPath "/")) 1)) (fn s (str/encode-uri-component @s))) "/"))
        (set @entity.parts (array/map (array/filter [(object/get @payload.query "policy" null), (object/get @payload.query "filter" null)] (fn p (!= @p null))) (fn p (let ((pf (tree/fold @p (fn (n k) (let ((kind (object/get @n "kind" ""))) (if (= @kind "const") { leafBad: false, kindBad: false, k: (if (= (object/get @n "value" false) true) "some" "nothing"), ws: [], reason: "", ak: (if (= (object/get @n "value" true) false) "false" "other"), af: "", av: [] } (if (= @kind "compare") (let ((op (object/get @n "op" ""))) (let ((v (object/get @n "value" null))) { leafBad: (= @op "!="), kindBad: (and (array/includes ["<", "<=", ">", ">="] @op) (= @v null)), k: (if (not (or (validate/string @v) (validate/number @v) (validate/boolean @v))) "nothing" (if (= @op "!=") "decline" "some")), ws: (if (and (or (validate/string @v) (validate/number @v) (validate/boolean @v)) (!= @op "!=")) [{ field: (if (= (object/get @n "field" "") "id") "__name__" (object/get @n "field" "")), op: (object/get { "==": "EQUAL", "<": "LESS_THAN", "<=": "LESS_THAN_OR_EQUAL", ">": "GREATER_THAN", ">=": "GREATER_THAN_OR_EQUAL" } @op ""), value: @v, values: [] }] []), reason: (if (and (or (validate/string @v) (validate/number @v) (validate/boolean @v)) (= @op "!=")) "leaf-unsupported" ""), ak: (if (= @op "==") "eq" "other"), af: (object/get @n "field" ""), av: (if (or (validate/string @v) (validate/number @v) (validate/boolean @v)) [@v] []) })) (if (= @kind "member") (let ((vals (array/filter (object/get @n "values" []) (fn x (or (validate/string @x) (validate/number @x) (validate/boolean @x)))))) { leafBad: false, kindBad: false, k: (if (= (array/len @vals) 0) "nothing" (if (> (array/len @vals) 30) "decline" "some")), ws: (if (and (> (array/len @vals) 0) (<= (array/len @vals) 30)) [{ field: (if (= (object/get @n "field" "") "id") "__name__" (object/get @n "field" "")), op: "IN", value: "", values: @vals }] []), reason: (if (> (array/len @vals) 30) "value-kind-unsupported" ""), ak: "member", af: (object/get @n "field" ""), av: @vals }) (if (= @kind "hasElement") (let ((v (object/get @n "value" null))) { leafBad: false, kindBad: false, k: (if (or (= @v null) (or (validate/string @v) (validate/number @v) (validate/boolean @v))) "some" "nothing"), ws: (if (= @v null) [{ field: (if (= (object/get @n "field" "") "id") "__name__" (object/get @n "field" "")), op: "ARRAY_CONTAINS", values: [] }] (if (or (validate/string @v) (validate/number @v) (validate/boolean @v)) [{ field: (if (= (object/get @n "field" "") "id") "__name__" (object/get @n "field" "")), op: "ARRAY_CONTAINS", value: @v, values: [] }] [])), reason: "", ak: "has", af: (object/get @n "field" ""), av: (if (and (!= @v null) (or (validate/string @v) (validate/number @v) (validate/boolean @v))) [@v] []) }) (if (= @kind "all") (let ((cl (array/reduce @k.of { k: "some", ws: [], reason: "" } (fn a r (if (!= @a.k "some") @a (if (!= @r.k "some") { k: @r.k, ws: [], reason: @r.reason } { k: "some", ws: (array/concat @a.ws @r.ws), reason: "" })))))) { leafBad: (array/some @k.of (fn r @r.leafBad)), kindBad: (array/some @k.of (fn r @r.kindBad)), combBad: (array/some @k.of (fn r (object/get @r "combBad" false))), k: @cl.k, ws: @cl.ws, reason: @cl.reason, ak: "other", af: "", av: [] }) (if (= @kind "any") (let ((kids (array/filter @k.of (fn c (!= @c.ak "false"))))) (let ((elig (array/every @kids (fn c (array/includes ["eq", "member", "has"] @c.ak))))) (let ((fields (array/unique (array/map @kids (fn c @c.af))))) (let ((kinds (array/unique (array/map @kids (fn c (if (= @c.ak "has") "ARRAY_CONTAINS_ANY" "IN")))))) (let ((vals (array/reduce @kids [] (fn acc c (array/concat @acc @c.av))))) (let ((st (if (= (array/len @kids) 0) "nothing" (if (or (not @elig) (> (array/len @fields) 1) (> (array/len @kinds) 1)) "decline" (if (= (array/len @vals) 0) "nothing" (if (> (array/len @vals) 30) "decline" "some")))))) { leafBad: (array/some @k.of (fn r @r.leafBad)), kindBad: (array/some @k.of (fn r @r.kindBad)), combBad: (array/some @k.of (f