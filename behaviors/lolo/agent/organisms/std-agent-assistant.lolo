app std-agent-assistant [
  version: "2.0.0",
  description: "std-agent-assistant — an in-app assistant that operates the running app for the signed-in user. Each section's floating button opens it in a side panel docked beside the page (std-panel-launcher; a side sheet on small screens), where the conversation shows every step the assistant takes live as it works; /assistant is the same conversation as a full page, in the app's own shell (pass `appName` and `navItems`); past conversations and what the assistant remembers open in place from its toolbar (Back returns to the chat), on either surface. One request flows down a chain of std agent atoms on the bus: the conversation (std-agent-session) SENDs → CONVERSE → std-agent-context bounds it → std-agent-memory adds what it recalls → std-agent-tool-loop answers it through std-llm's tool loop, firing only the inputs and reading only the entities its `tools` allow, as the signed-in user → ASSISTANT_REPLIED goes back to the conversation, to memory (remembered) and to std-agent-trace (the run record). By default the tools are the program's own declarations: every `-> external` input (its @description is the tool text) and a read over every persisted entity, so composing building blocks composes the assistant's abilities. Any section's page gets the assistant with two traits, `XAssistant = AgentSession.traits.AgentConversation` and a std-panel-launcher dock: the conversation speaks the ASSISTANT_* contract from any orbital, so the assistant needs no per-section wiring. Import the orbital once per app: `orbital Assistant = Agent.orbitals.AgentAssistantOrbital { config { instructions: \"…\" } }`. The conversation, memory and run records live in AgentRecordsOrbital; retarget them onto your own owner-scoped entities (`ownerId` a relation to your [identity] roster, with @read/@create) with `entities { AgentMessage: …, AgentMemory: …, AgentRun: …, AgentChat: … }`. The conversation is kept across pages and reloads (each person's most recently used conversation is the current one);",
  net: { "api.openai.com:443": [tcp], "openrouter.ai:443": [tcp] },
]

type AgentToolScope = {
  scope : "declared"!
  roles : [string]!
  fireAndForget : boolean
}
type AgentToolField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [AgentToolField]
  description : string
}
type AgentToolInput = {
  event : EventAddress!
  roles : [string]!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type AgentToolRead = {
  read : string!
  roles : [string]!
}
type AgentTool = AgentToolScope | AgentToolInput | AgentToolRead
type AgentLink = {
  label : string!
  href : string!
}
type NavItem = { label : string!, href : string!, icon : string, badge : string, children : [NavItem], roles : [string] }

type AgentToolKind = "input" | "read" | "invalid"
type AgentToolCallActivity = {
  type : "tool_call"!
  tool : string!
  kind : AgentToolKind
  argsText : string!
  timestamp : instant!
  isExecuting : boolean
}
type AgentToolResultActivity = {
  type : "tool_result"!
  tool : string!
  kind : AgentToolKind
  success : boolean!
  detail : string
  rows : number
  resultText : string!
  timestamp : instant!
}
type AgentLlmCall = {
  service : string!
  provider : string!
  model : string!
  systemPrompt : string!
  userPrompt : string!
  toolCallsJson : string
  attempt : number
  durationMs : number!
  promptTokens : number
  completionTokens : number
  cachedPromptTokens : number
  costUSD : number
}
type AgentLlmResponseActivity = {
  type : "llm_response"!
  content : string!
  llm : AgentLlmCall
  timestamp : instant!
}
type AgentActivity = AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity
type AgentUsage = {
  promptTokens : number!
  completionTokens : number!
  totalTokens : number!
  modelCalls : number!
}

type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type ToolArguments = Map string JsonValue
type ToolCall = { id : string!, name : string!, arguments : ToolArguments }
orbital AgentAssistantOrbital {
  uses Session from "std/behaviors/std-agent-session"
  uses Context from "std/behaviors/std-agent-context"
  uses Memory from "std/behaviors/std-agent-memory"
  uses Llm from "std/behaviors/std-llm"
  uses Req from "std/behaviors/std-http-request"
  uses Http from "std/behaviors/std-http-client"
  uses Delay from "std/behaviors/std-delay"
  uses Loop from "std/behaviors/std-agent-tool-loop"
  uses Trace from "std/behaviors/std-agent-trace"
  uses Shell from "std/behaviors/std-app-layout"

  config {
    tools : [AgentTool] = [{ scope: declared, fireAndForget: true, roles: [] }]
      @label "What may the assistant do?"
      @description "As the signed-in user: `{ scope: declared }` (the default) gives it every external input the program declares and a read over every persisted entity, so each building block's declared inputs become its abilities; or list them — `{ event: Orbital.Trait.EVENT }` for one input, `{ read: Entity }` for one entity."
      @synonyms "allowlist, abilities, actions, permissions"
      @tier "domain"
    instructions : string = "You operate this app for the signed-in user. Use the tools to act and to look things up; when a tool reports that something was refused or denied, say so plainly."
      @label "How should the assistant behave?"
      @description "Standing instructions sent with every request."
      @synonyms "system prompt, persona, guidance"
      @tier "domain"
    maxSteps : number = 8
      @label "Model round-trips per request"
      @tier "policy"
    keepMessages : number = 12
      @label "Turns kept verbatim"
      @tier "policy"
    recallLimit : number = 3
      @label "Memories recalled per request"
      @tier "policy"
    links : [AgentLink] = [{ label: "Run history", href: "/assistant/runs" }]
      @label "Links above the conversation"
      @description "Related pages, e.g. the assistant's run history."
      @tier "presentation"
    appName : string = "Assistant"
      @label "App name in the assistant page's header"
      @description "Pass the app's own name so the assistant page matches the rest of the app."
      @tier "presentation"
    navItems : [NavItem] = []
      @label "Sidebar navigation on the assistant page"
      @description "Pass the app's own navItems so the assistant page keeps the app's sidebar."
      @tier "presentation"
    viewerRole : string = ""
      @label "Viewer role on the assistant page"
      @description "The role the assistant page's sidebar items and their `roles` are checked against. Bind `@user.role` in an app whose identity carries a role; left empty, only items with no `roles` show."
      @tier "policy"
  }

  entity AgentAssistant [runtime] {
    id : string!
  }

  trait AssistantThread = Session.traits.AgentThread -> AgentMessage {
    events {
      CONVERSE: REQUEST_CONTEXT
    }
    listens {
      AssistantChatKeeper.ASSISTANT_CHAT_OPENED -> OPEN_CHAT
      AssistantChatKeeper.ASSISTANT_SEND_IN_CHAT -> SEND_IN_CHAT
      AssistantChatKeeper.ASSISTANT_REPLY_IN_CHAT -> REPLY_IN_CHAT
    }
  }

  trait AssistantChatKeeper = Session.traits.AgentChatKeeper -> AgentChat {
    listens {
      *.ASSISTANT_SEND -> SEND
      *.ASSISTANT_HISTORY_REQUESTED -> LOAD_HISTORY
      *.ASSISTANT_NEW_CHAT -> NEW_CHAT
      *.ASSISTANT_CHAT_SELECTED -> SELECT_CHAT
      *.ASSISTANT_CHATS_REQUESTED -> LIST_CHATS
      AssistantLoop.ASSISTANT_REPLIED -> REPLIED
    }
  }

  trait AssistantConversation = Session.traits.AgentConversation {
    config {
      links: @config.links
    }
  }

  ;; The full assistant page: the same conversation as the side panel, in the
  ;; app's own shell.
  trait AssistantLayout = Shell.traits.AppLayout {
    config {
      viewerRole: @config.viewerRole
      viewerName: (default @user.name "")
      viewerEmail: (default @user.email "")
      appName: @config.appName
      navItems: @config.navItems
      contentTrait: <trait.AssistantConversation />
      contentClassName: "mx-auto flex w-full max-w-3xl flex-col h-[calc(100vh-9rem)] min-h-0"
    }
  }

  trait AssistantContext = Context.traits.AgentContextCompactor {
    config {
      keepMessages: @config.keepMessages
    }
    listens {
      AssistantThread.REQUEST_CONTEXT -> COMPACT
      *.ASSISTANT_EPHEMERAL_SEND -> COMPACT
      AssistantLlm.LLM_SUMMARIZE_RESULT -> ContextSummarized
      AssistantLlm.LLM_FAILED -> ContextSummarizeFailed
      ContextSummarized {
        summary : string!
        keyPoints : [string]!
      }
      ContextSummarizeFailed {
        code : string
        message : string!
      }
    }
  }

  trait AssistantLlm = Llm.traits.LlmClient {
    listens {
      AssistantContext.LLM_SUMMARIZE -> LLM_SUMMARIZE
      AssistantMemory.LLM_EMBED -> LLM_EMBED
      AssistantMemoryStore.LLM_EMBED -> LLM_EMBED
      AssistantLoop.LLM_CALL_TOOLS -> LLM_CALL_TOOLS
      AssistantLoop.LLM_TOOLS_ANSWERED -> LLM_TOOLS_ANSWERED
      AssistantLoop.LLM_CANCEL -> LLM_CANCEL
      AsstEmbedWait.ASST_EMBED_WAITED -> LLM_EMBED_WAITED
      AsstEmbedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      AsstEmbedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      AsstEmbedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
      AsstChatRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      AsstChatRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      AsstChatRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      AsstChatHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait AsstEmbedWait = Delay.traits.Delay {
    events {
      ELAPSED: ASST_EMBED_WAITED
    }
    listens {
      AssistantLlm.LLM_EMBED_WAIT -> START
    }
  }

  trait AsstEmbedRequest = Req.traits.HttpRequest {
    listens {
      AssistantLlm.LLM_EMBED_WIRE -> HTTP_REQUEST
      AssistantLlm.LLM_EMBED_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      AsstEmbedHttp.HTTP_REPLIED -> HTTP_REPLIED
      AsstEmbedHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait AsstEmbedHttp = Http.traits.HttpClient {
    config {
      host: "openrouter.ai"
      port: 443
      tls: true
      serverName: "openrouter.ai"
      credential: "EMBEDDING_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      AsstEmbedRequest.HTTP_SEND -> HTTP_SEND
      AsstEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }

  trait AsstChatRequest = Req.traits.HttpRequest {
    listens {
      AssistantLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      AssistantLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      AsstChatHttp.HTTP_REPLIED -> HTTP_REPLIED
      AsstChatHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait AsstChatHttp = Http.traits.HttpClient {
    config {
      host: "api.openai.com"
      port: 443
      tls: true
      serverName: "api.openai.com"
      credential: "OPENAI_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      AsstChatRequest.HTTP_SEND -> HTTP_SEND
      AsstChatRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }

  trait AssistantMemory = Memory.traits.AgentMemoryRecall -> AgentMemory {
    config {
      recallLimit: @config.recallLimit
    }
    listens {
      AssistantContext.COMPACTED -> RECALL
      *.ASSISTANT_MEMORIES_REQUESTED -> LIST
      AssistantLlm.LLM_EMBED_RESULT -> MemoryEmbedded
      AssistantLlm.LLM_FAILED -> MemoryEmbedFailed
      MemoryEmbedded {
        embeddings : [[number]]
        key : string
      }
      MemoryEmbedFailed {
        code : string
        message : string!
        key : string
      }
    }
  }

  trait AssistantMemoryStore = Memory.traits.AgentMemoryStore -> AgentMemory {
    listens {
      AssistantLoop.ASSISTANT_REPLIED -> REMEMBER
      AssistantLlm.LLM_EMBED_RESULT -> MemoryEmbedded
      AssistantLlm.LLM_FAILED -> MemoryEmbedFailed
      MemoryEmbedded {
        embeddings : [[number]]
        key : string
      }
      MemoryEmbedFailed {
        code : string
        message : string!
        key : string
      }
    }
  }

  trait AssistantMemoryView = Memory.traits.AgentMemoryView -> AgentMemory {
    listens {
      AssistantMemory.MEMORY_RECALL_NOTICE -> MEMORY_RECALL_NOTICE
      AssistantMemoryStore.MEMORY_STORE_NOTICE -> MEMORY_STORE_NOTICE
    }
  }

  trait AssistantLoop = Loop.traits.AgentToolLoop {
    config {
      tools: @config.tools
      instructions: @config.instructions
      maxSteps: @config.maxSteps
    }
    listens {
      AssistantMemory.RECALLED -> CONVERSE
      AssistantLlm.LLM_TOOLS_REQUESTED -> ToolsRequested
      AssistantLlm.LLM_TOOLS_STEP -> ToolsStep
      AssistantLlm.LLM_CALL_TOOLS_RESULT -> ToolsReplied
      AssistantLlm.LLM_FAILED -> ToolsFailed
      AssistantLlm.LLM_CANCELLED -> ToolsCancelled
      ToolsRequested {
        session : string!
        calls : [ToolCall]!
      }
      ToolsStep {
        activity : AgentActivity!
      }
      ToolsReplied {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
      }
      ToolsFailed {
        code : string
        message : string!
      }
      ToolsCancelled {
        key : string!
      }
    }
  }

  trait AssistantTrace = Trace.traits.AgentTraceRecorder -> AgentRun {
    listens {
      AssistantLoop.ASSISTANT_REPLIED -> REPLIED
      AssistantLoop.ASSISTANT_REPLY_FAILED -> REPLY_FAILED
    }
  }

  page "/assistant" as AssistantPage -> AssistantLayout, AssistantThread, AssistantChatKeeper, AssistantContext, AssistantMemory, AssistantMemoryStore, AssistantMemoryView, AssistantLlm, AsstEmbedWait, AsstEmbedRequest, AsstEmbedHttp, AsstChatRequest, AsstChatHttp, AssistantLoop, AssistantTrace
}

;; The assistant's records live outside AgentAssistantOrbital, so a consumer
;; importing that orbital retargets them onto its own owner-scoped entities:
;; `entities { AgentMessage: MyMessage, AgentMemory: MyMemory, AgentRun: MyRun }`.
orbital AgentRecordsOrbital {
  uses Trace from "std/behaviors/std-agent-trace"

  entity AgentRun [persistent: agentRuns] {
    id : string!
  }
  entity AgentMessage [persistent: agentMessages] {
    id : string!
  }
  entity AgentMemory [persistent: agentMemories] {
    id : string!
  }
  entity AgentChat [persistent: agentChats] {
    id : string!
    ownerId : string!
    title : string = ""
    startedAt : instant
    lastActiveAt : instant
    pendingMessage : string @intrinsic = ""
    pendingReply : string @intrinsic = ""
  }

  trait AgentRunHistory = Trace.traits.AgentRunBrowse -> AgentRun {
    listens {
      AgentAssistantOrbital.AssistantTrace.RUN_RECORDED -> RUN_RECORDED
    }
  }

  page "/assistant/runs" as AssistantRunsPage -> AgentRunHistory
}
