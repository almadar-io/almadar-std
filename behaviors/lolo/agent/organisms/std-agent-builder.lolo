app std-agent-builder [
  version: "3.0.0",
  description: "Agent builder — turns a request into a behavior by walking a ladder of caching tiers, cheapest first. START { request, orbitalName, context } embeds the request with std-llm (LLM_EMBED) and walks `ladder`: each step ranks its source by cosine similarity — installed behaviors under its registry folders (`behavior/catalog`), or a pool (POOL_SEARCH, answered by POOL_FOUND from std-agent-pool) — and when the best match reaches the step's threshold runs the step's action, otherwise goes to the next step. Actions: `mount` builds a page around the best match's first trait (`program/eval`); `adopt` serves the best match as it is, no model call; `fill` describes the best match (`behavior/describe`), asks the model once to set its knobs and the extra `fillFields`, applies them (`behavior/apply`) and evaluates the result (`program/eval`, final), feeding validator issues back for up to `maxRepairs` repair turns. BUILD_PROGRESS streams each step; BUILD_COMPLETE { orbitalName, behavior, value, tier, fields } carries the behavior and the step that served it; BUILD_REJECTED { error, errors } follows an exhausted ladder or a failed build. The default ladder mounts the closest UI molecule, as earlier versions did.",
  egress: ["https://api.openai.com", "https://openrouter.ai"]
]
;; @capabilities "build a behavior from a request, caching tiers, retrieve before generating, adopt an existing behavior, fill a behavior's knobs, pick a behavior by meaning, program evaluation"

type AgentBuilderCatalogHit = {
  behavior : string!
  description : string
  traits : [trait]!
  value : behavior!
  vectors : Map string [number]
}
type PoolHit = {
  id : string!
  behavior : string!
  value : behavior!
  name : string
  kind : string
  topic : string
  fields : Map string string
  description : string
  score : number!
}
type Ranked = {
  behavior : string!
  value : behavior!
  trait : trait
  description : string
  fields : Map string string
  score : number!
}
type BuilderStep = {
  name : string!
  source : "catalog" | "pool"!
  scope : [string]
  threshold : number!
  action : "mount" | "adopt" | "fill"!
  take : number
}
type Built = {
  behavior : string!
  value : behavior!
}
type BuildIssue = {
  code : string!
  message : string!
}
type AgentChatMessage = {
  role : "user" | "assistant"!
  content : string!
}
type AgentToolField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [AgentToolField]
  description : string
}
type FieldWordLimit = {
  name : string!
  words : number!
}
type AgentToolInput = {
  event : EventAddress!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type KnobField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [KnobField]
  default : SExpr
  label : string
  description : string
  tier : string
}
type DescribedTrait = {
  trait : string!
  knobs : [KnobField]!
}
type DescribedOrbital = {
  value : orbital!
  knobs : [KnobField]!
  traits : [DescribedTrait]!
}
type BehaviorDescription = {
  behavior : string!
  knobs : [KnobField]!
  orbitals : [DescribedOrbital]!
}
type FilledTrait = {
  config : Map string SExpr
}

type AgentToolKind = "input" | "read" | "invalid"
type AgentToolCallActivity = {
  type : "tool_call"!
  tool : string!
  kind : AgentToolKind
  argsText : string!
  timestamp : instant!
  isExecuting : boolean
}
type AgentToolResultActivity = {
  type : "tool_result"!
  tool : string!
  kind : AgentToolKind
  success : boolean!
  detail : string
  rows : number
  resultText : string!
  timestamp : instant!
}
type AgentLlmCall = {
  service : string!
  provider : string!
  model : string!
  systemPrompt : string!
  userPrompt : string!
  toolCallsJson : string
  attempt : number
  durationMs : number!
  promptTokens : number
  completionTokens : number
  cachedPromptTokens : number
  costUSD : number
}
type AgentLlmResponseActivity = {
  type : "llm_response"!
  content : string!
  llm : AgentLlmCall
  timestamp : instant!
}
type AgentActivity = AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity
type AgentUsage = {
  promptTokens : number!
  completionTokens : number!
  totalTokens : number!
  modelCalls : number!
}

uses ToolLoop from "std/behaviors/std-agent-tool-loop"

uses Llm from "std/behaviors/std-llm"

type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type ToolArguments = Map string JsonValue
type ToolCall = { id : string!, name : string!, arguments : ToolArguments }
orbital AgentBuilderOrbital {

  entity BuilderProcess [runtime] {
    id : string!
    request : string = ""
    orbitalName : string = ""
    context : string = ""
    queryVector : [number] = []
    step : number = 0
    ranked : [Ranked] = []
    pick : trait = none
    chosen : string = ""
    chosenDescription : string = ""
    target : orbital = none
    filledConfig : Map string SExpr = {}
    filledTraits : Map string FilledTrait = {}
    filledFields : Map string string = {}
    pickedFields : Map string string = {}
    tool : [AgentToolField] = []
    repairs : number = 0
    behavior : string = ""
    error : string = ""
    status : "idle" | "searching" | "choosing" | "describing" | "filling" | "building" | "done" | "failed" = idle
  }

  trait BuilderPipeline -> BuilderProcess [optimistic] {
    config {
      ladder : [BuilderStep] = [{ name: "mount", source: "catalog", scope: ["almadar-std/ui/core/molecules"], threshold: 0, action: "mount", take: 1 }]
        @label "Caching tiers, cheapest first"
        @description "Each step ranks its source (a registry catalog under `scope`, or the pool) against the request and, when the best match reaches `threshold`, runs `action` on it: `mount` (a page around its first trait), `adopt` (serve it as it is, no model call) or `fill` (one model turn setting its knobs). A step whose best match falls short hands over to the next one; when no step serves, the build is rejected."
        @synonyms "tiers, cache levels, retrieval ladder"
        @tier "domain"
      fillFields : [AgentToolField] = []
        @label "Extra fields the fill turn writes"
        @description "Fields the model fills alongside the knobs (e.g. a one-line hint); they come back in BUILD_COMPLETE's `fields`."
        @tier "domain"
      fillInstructions : string = "You adapt an existing building block to a request. Call the FILL tool once: set only the knobs the request needs (in `config` and `traits` → trait → `config`), write every requested field in `fields`, then reply with one sentence."
        @label "How the fill turn is briefed"
        @tier "domain"
      pickInstructions : string = "Several building blocks could serve the request. Pick the one whose interaction does what the request asks (sorting into groups, putting in order, estimating, exploring…), not just the one about the same subject. Call the PICK tool once with the block and every requested field, then reply with one sentence."
        @label "How the pick turn is briefed"
        @description "Used when a fill step takes more than one candidate: the model picks the building block before filling it."
        @tier "domain"
      pickDecider : "chat" | "jev" = chat
        @label "Who picks the building block"
        @description "`chat`: a model turn picks it (and writes `pickFields`). `jev`: the decision model picks it in one typed choice (`llm choose`), and the fill turn writes `pickFields`."
        @tier "policy"
      pickQuestion : string = "Which building block's interaction does what the request asks (sorting into groups, putting in order, estimating, exploring), not just the one about the same subject?"
        @label "The decision model's question"
        @tier "domain"
      pickEvent : EventAddress = BuilderPipeline.PICK
        @label "Pick tool event"
        @description "The address the model's PICK tool fires; a consumer that renames this trait sets it to its own name."
        @tier "internal"
      pickFields : [AgentToolField] = []
        @label "Fields the pick turn writes"
        @description "Fields the model writes while it picks the building block, before it sees the block's knobs (e.g. a how-to-play hint that must not lean on the content). They win over the fill turn's; with no pick turn the fill turn writes them."
        @tier "domain"
      fieldWordLimits : [FieldWordLimit] = []
        @label "Most words per fill field"
        @description "A fill field written longer than its limit goes back to the model as a repair turn; after the last repair turn the build goes ahead with what was written."
        @tier "policy"
      fillEvent : EventAddress = BuilderPipeline.FILL
        @label "Fill tool event"
        @description "The address the model's FILL tool fires; a consumer that renames this trait sets it to its own name."
        @tier "internal"
      maxRepairs : number = 2
        @label "Repair turns"
        @description "How many times validator issues go back to the model before the build fails."
        @tier "policy"
    }
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.status idle)
      START -> searching
        (set @entity.request ?request)
        (set @entity.orbitalName ?orbitalName)
        (set @entity.context (default ?context ""))
        (set @entity.step 0)
        (set @entity.repairs 0)
        (set @entity.status searching)
        (emit BUILD_PROGRESS { status: "searching", tier: "" })
        (emit LLM_EMBED { texts: (array/prepend [] ?request) })
      FILL -> idle
      PICK -> idle
      CONVERSE -> idle
      ASSISTANT_REPLIED -> idle
      TOOLS_FAILED -> idle
    }

    state searching {
      INIT -> searching
        (set @entity.status searching)
      REQUEST_EMBEDDED -> searching when (> (array/len ?embeddings) 0)
        (set @entity.queryVector (array/first ?embeddings))
        (emit STEP {})
      REQUEST_EMBEDDED -> failed when (= (array/len ?embeddings) 0)
        (set @entity.error "The model returned no embedding")
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: "The model returned no embedding", errors: [] })
      STEP -> searching when (and (< @entity.step (array/len @config.ladder)) (= (object/get (array/nth @config.ladder @entity.step) source) "catalog"))
        (behavior/catalog { paths: (object/get (array/nth @config.ladder @entity.step) scope []) } {
          emit: { failure: BUILD_FAILED, success: CATALOG_LISTED }
        })
      STEP -> searching when (and (< @entity.step (array/len @config.ladder)) (= (object/get (array/nth @config.ladder @entity.step) source) "pool"))
        (emit POOL_SEARCH { vector: @entity.queryVector, take: (object/get (array/nth @config.ladder @entity.step) take 5) })
      STEP -> failed when (>= @entity.step (array/len @config.ladder))
        (set @entity.error "No tier of the ladder could serve the request")
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: "No tier of the ladder could serve the request", errors: [] })
      CATALOG_LISTED -> failed when (> (array/len (array/filter (array/filter ?result (fn e (> (array/len (object/get @e.vectors description)) 0))) (fn e (= (array/cosine (object/get @e.vectors description []) @entity.queryVector) null)))) 0)
        (let ((bad (array/first (array/filter (array/filter ?result (fn e (> (array/len (object/get @e.vectors description)) 0))) (fn e (= (array/cosine (object/get @e.vectors description []) @entity.queryVector) null))))))
          (let ((msg (str/concat "candidate " (object/get @bad behavior) " was embedded with " (array/len (object/get @bad.vectors description)) " dims, the query with " (array/len @entity.queryVector))))
            (do
              (set @entity.error @msg)
              (set @entity.status failed)
              (emit BUILD_REJECTED { error: @msg, errors: [] }))))
      CATALOG_LISTED -> searching when (= (array/len (array/filter (array/filter ?result (fn e (> (array/len (object/get @e.vectors description)) 0))) (fn e (= (array/cosine (object/get @e.vectors description []) @entity.queryVector) null)))) 0)
        (set @entity.ranked (array/sort (array/flatten (array/map (array/filter ?result (fn e (> (array/len (object/get @e.vectors description)) 0))) (fn e (let ((s (array/cosine (object/get @e.vectors description []) @entity.queryVector))) (if (= @s null) [] [{ behavior: @e.behavior, value: @e.value, trait: (array/first @e.traits), description: (object/get @e description ""), fields: {}, score: @s }]))))) score desc))
        (emit RANKED {})
      POOL_FOUND -> searching
        (set @entity.ranked (array/map ?hits (fn h { behavior: @h.behavior, value: @h.value, description: (object/get @h description ""), fields: (object/get @h fields {}), score: @h.score })))
        (emit RANKED {})
      RANKED -> searching when (or (= (array/len @entity.ranked) 0) (< (object/get (array/first @entity.ranked) score) (object/get (array/nth @config.ladder @entity.step) threshold)))
        (set @entity.step (+ @entity.step 1))
        (emit STEP {})
      RANKED -> building when (and (> (array/len @entity.ranked) 0) (and (>= (object/get (array/first @entity.ranked) score) (object/get (array/nth @config.ladder @entity.step) threshold)) (= (object/get (array/nth @config.ladder @entity.step) action) "mount")))
        (set @entity.pick (object/get (array/first @entity.ranked) trait))
        (set @entity.status building)
        (emit BUILD_PROGRESS { status: "building", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (program/eval (quasiquote {
          name: (unquote @entity.orbitalName)
          orbitals: [{
            name: (unquote @entity.orbitalName)
            entity: { name: "BuiltView", persistence: "runtime", fields: [{ name: "id", type: "string" }] }
            traits: [{
              name: "BuiltFrame"
              scope: "instance"
              linkedEntity: "BuiltView"
              stateMachine: {
                states: [{ name: "idle", isInitial: true }]
                events: [{ key: "INIT", name: "Init" }]
                transitions: [{ from: "idle", to: "idle", event: "INIT", effects: [["render-ui", "main", { type: "stack", children: [(unquote @entity.pick)] }]] }]
              }
            }]
            pages: [{ name: "Built", path: "/", traits: [{ ref: "BuiltFrame" }] }]
          }]
        }) {
          emit: { failure: BUILD_FAILED, success: BUILT }
        })
      RANKED -> done when (and (> (array/len @entity.ranked) 0) (and (>= (object/get (array/first @entity.ranked) score) (object/get (array/nth @config.ladder @entity.step) threshold)) (= (object/get (array/nth @config.ladder @entity.step) action) "adopt")))
        (set @entity.behavior (object/get (array/first @entity.ranked) behavior))
        (set @entity.status done)
        (emit BUILD_COMPLETE { orbitalName: @entity.orbitalName, behavior: @entity.behavior, value: (object/get (array/first @entity.ranked) value), tier: (object/get (array/nth @config.ladder @entity.step) name), fields: (object/get (array/first @entity.ranked) fields {}) })
      RANKED -> describing when (and (and (> (array/len @entity.ranked) 0) (and (>= (object/get (array/first @entity.ranked) score) (object/get (array/nth @config.ladder @entity.step) threshold)) (= (object/get (array/nth @config.ladder @entity.step) action) "fill"))) (or (<= (object/get (array/nth @config.ladder @entity.step) take 1) 1) (= (array/len @entity.ranked) 1)))
        (set @entity.chosen (object/get (array/first @entity.ranked) behavior))
        (set @entity.chosenDescription (object/get (array/first @entity.ranked) description ""))
        (set @entity.pickedFields {})
        (set @entity.status describing)
        (emit BUILD_PROGRESS { status: "describing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (behavior/describe { behavior: @entity.chosen } {
          emit: { failure: BUILD_FAILED, success: DESCRIBED }
        })
      RANKED -> choosing when (and (and (> (array/len @entity.ranked) 0) (and (>= (object/get (array/first @entity.ranked) score) (object/get (array/nth @config.ladder @entity.step) threshold)) (= (object/get (array/nth @config.ladder @entity.step) action) "fill"))) (and (> (object/get (array/nth @config.ladder @entity.step) take 1) 1) (and (> (array/len @entity.ranked) 1) (= @config.pickDecider "jev"))))
        (set @entity.chosen "")
        (set @entity.pickedFields {})
        (set @entity.status choosing)
        (emit BUILD_PROGRESS { status: "choosing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (emit LLM_CHOOSE { state: (if (= @entity.context "") @entity.request (str/concat @entity.request "\n\n" @entity.context)), instructions: @config.pickQuestion, options: (array/map (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r { value: @r.behavior, description: (object/get @r description "") })) })
      RANKED -> choosing when (and (and (> (array/len @entity.ranked) 0) (and (>= (object/get (array/first @entity.ranked) score) (object/get (array/nth @config.ladder @entity.step) threshold)) (= (object/get (array/nth @config.ladder @entity.step) action) "fill"))) (and (> (object/get (array/nth @config.ladder @entity.step) take 1) 1) (and (> (array/len @entity.ranked) 1) (= @config.pickDecider "chat"))))
        (set @entity.chosen "")
        (set @entity.pickedFields {})
        (set @entity.status choosing)
        (emit BUILD_PROGRESS { status: "choosing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (emit CONVERSE {
          messages: [{ role: "user", content: (if (= @entity.context "") @entity.request (str/concat @entity.request "\n\n" @entity.context)) }]
          instructions: (str/concat @config.pickInstructions "\nThe building blocks:\n" (str/join (array/map (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r (str/concat "- " @r.behavior ": " (object/get @r description "")))) "\n"))
          tools: [{ fireAndForget: true, event: @config.pickEvent, payload: [{ name: "behavior", type: "string", required: true, values: (array/map (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r @r.behavior)), description: "The building block that fits the request." }, { name: "fields", type: "object", required: (> (array/len @config.pickFields) 0), properties: @config.pickFields }] }]
          ephemeral: true
        })
      BUILD_FAILED -> failed
        (set @entity.error ?error)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?error, errors: [] })
      LLM_REQUEST_FAILED -> failed
        (set @entity.error ?message)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?message, errors: [] })
    }

    state choosing {
      INIT -> choosing
        (set @entity.status choosing)
      CHOSEN -> describing when (array/some (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r (= @r.behavior ?choice)))
        (set @entity.chosen ?choice)
        (set @entity.chosenDescription (object/get (array/find @entity.ranked (fn r (= @r.behavior ?choice))) description ""))
        (set @entity.status describing)
        (emit BUILD_PROGRESS { status: "describing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (behavior/describe { behavior: ?choice } {
          emit: { failure: BUILD_FAILED, success: DESCRIBED }
        })
      CHOSEN -> failed when (not (array/some (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r (= @r.behavior ?choice))))
        (set @entity.error "The decision model picked none of the building blocks offered")
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: "The decision model picked none of the building blocks offered", errors: [] })
      BUILD_FAILED -> failed
        (set @entity.error ?error)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?error, errors: [] })
      LLM_REQUEST_FAILED -> failed
        (set @entity.error ?message)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?message, errors: [] })
      PICK -> choosing
        (set @entity.chosen (default ?behavior ""))
        (set @entity.pickedFields (if (== ?fields null) {} ?fields))
      ASSISTANT_REPLIED -> describing when (array/some (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r (= @r.behavior @entity.chosen)))
        (set @entity.chosenDescription (object/get (array/find @entity.ranked (fn r (= @r.behavior @entity.chosen))) description ""))
        (set @entity.status describing)
        (emit BUILD_PROGRESS { status: "describing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (behavior/describe { behavior: @entity.chosen } {
          emit: { failure: BUILD_FAILED, success: DESCRIBED }
        })
      ASSISTANT_REPLIED -> failed when (not (array/some (array/take @entity.ranked (object/get (array/nth @config.ladder @entity.step) take 1)) (fn r (= @r.behavior @entity.chosen))))
        (set @entity.error "The model picked none of the building blocks offered")
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: "The model picked none of the building blocks offered", errors: [] })
      TOOLS_FAILED -> failed
        (set @entity.error ?error)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?error, errors: [] })
    }

    state describing {
      INIT -> describing
        (set @entity.status describing)
      DESCRIBED -> filling when (> (array/len (object/get ?result orbitals [])) 0)
        (let ((o (array/first (object/get ?result orbitals []))))
          (do
            (set @entity.target (object/get @o value))
            (set @entity.tool [
              { name: "config", type: "object", properties: (array/map (array/filter (object/get @o knobs []) (fn k (!= (object/get @k tier "") "internal"))) (fn k (object/pick @k ["default", "description", "name", "properties", "required", "type", "values"]))) },
              { name: "traits", type: "object", properties: (array/map (object/get @o traits []) (fn t { name: (object/get @t trait), type: "object", properties: [{ name: "config", type: "object", properties: (array/map (array/filter (object/get @t knobs []) (fn k (!= (object/get @k tier "") "internal"))) (fn k (object/pick @k ["default", "description", "name", "properties", "required", "type", "values"]))) }] })) },
              { name: "fields", type: "object", required: (> (+ (array/len @config.fillFields) (array/len @config.pickFields)) 0), properties: (array/concat @config.fillFields @config.pickFields) }
            ])
            (set @entity.status filling)
            (emit BUILD_PROGRESS { status: "filling", tier: (object/get (array/nth @config.ladder @entity.step) name) })
            (emit CONVERSE {
              messages: [{ role: "user", content: (if (= @entity.context "") @entity.request (str/concat @entity.request "\n\n" @entity.context)) }]
              instructions: (str/concat @config.fillInstructions "\nThe building block: " @entity.chosen " — " @entity.chosenDescription)
              tools: [{ fireAndForget: true, event: @config.fillEvent, payload: @entity.tool }]
              ephemeral: true
            })))
      DESCRIBED -> failed when (= (array/len (object/get ?result orbitals [])) 0)
        (set @entity.error "The best match has no orbital to fill")
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: "The best match has no orbital to fill", errors: [] })
      BUILD_FAILED -> failed
        (set @entity.error ?error)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?error, errors: [] })
    }

    state filling {
      INIT -> filling
        (set @entity.status filling)
      FILL -> filling
        (set @entity.filledConfig (if (== ?config null) {} ?config))
        (set @entity.filledTraits (if (== ?traits null) {} ?traits))
        (set @entity.filledFields (object/merge (if (== ?fields null) {} ?fields) @entity.pickedFields))
      ASSISTANT_REPLIED -> filling when (and (not (array/every @config.fieldWordLimits (fn l (<= (array/len (str/split (str/trim (object/get @entity.filledFields @l.name "")) " ")) @l.words)))) (< @entity.repairs @config.maxRepairs))
        (set @entity.repairs (+ @entity.repairs 1))
        (set @entity.pickedFields {})
        (emit BUILD_PROGRESS { status: "repairing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (emit CONVERSE {
          messages: [{ role: "user", content: @entity.request }, { role: "user", content: (str/concat "Some fields are too long. The most words each field may hold: " (str/join (array/map @config.fieldWordLimits (fn l (str/concat @l.name " " (str/concat @l.words) " words"))) ", ") ". What you wrote: " (json/stringify @entity.filledFields) ". Call FILL again with the same knobs and shorter fields.") }]
          instructions: (str/concat @config.fillInstructions "\nThe building block: " @entity.chosen " — " @entity.chosenDescription)
          tools: [{ fireAndForget: true, event: @config.fillEvent, payload: @entity.tool }]
          ephemeral: true
        })
      ASSISTANT_REPLIED -> building when (or (array/every @config.fieldWordLimits (fn l (<= (array/len (str/split (str/trim (object/get @entity.filledFields @l.name "")) " ")) @l.words))) (>= @entity.repairs @config.maxRepairs))
        (set @entity.status building)
        (emit BUILD_PROGRESS { status: "building", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (program/eval (quasiquote { name: (unquote @entity.orbitalName), orbitals: [(unquote (behavior/apply @entity.target { config: @entity.filledConfig, traits: @entity.filledTraits }))] }) { final: true } {
          emit: { failure: BUILD_FAILED, success: BUILT }
        })
      TOOLS_FAILED -> failed
        (set @entity.error ?error)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?error, errors: [] })
    }

    state building {
      INIT -> building
        (set @entity.status building)
      BUILT -> done
        (set @entity.behavior (object/get ?result behavior))
        (set @entity.status done)
        (emit BUILD_COMPLETE { orbitalName: @entity.orbitalName, behavior: (object/get ?result behavior), value: (object/get ?result value), tier: (object/get (array/nth @config.ladder @entity.step) name), fields: @entity.filledFields })
      BUILD_FAILED -> filling when (and (= (object/get (array/nth @config.ladder @entity.step) action) "fill") (< @entity.repairs @config.maxRepairs))
        (set @entity.repairs (+ @entity.repairs 1))
        (set @entity.status filling)
        (emit BUILD_PROGRESS { status: "repairing", tier: (object/get (array/nth @config.ladder @entity.step) name) })
        (emit CONVERSE {
          messages: [{ role: "user", content: @entity.request }, { role: "user", content: (str/concat "The result did not validate. The validator's issues: " (json/stringify (if (== ?errors null) [] ?errors)) " (" ?error "). Call FILL again with corrected values.") }]
          instructions: @config.fillInstructions
          tools: [{ fireAndForget: true, event: @config.fillEvent, payload: @entity.tool }]
          ephemeral: true
        })
      BUILD_FAILED -> failed when (or (!= (object/get (array/nth @config.ladder @entity.step) action) "fill") (>= @entity.repairs @config.maxRepairs))
        (set @entity.error ?error)
        (set @entity.status failed)
        (emit BUILD_REJECTED { error: ?error, errors: (if (== ?errors null) [] ?errors) })
    }

    state done {
      INIT -> done
        (set @entity.status done)
      RESET -> idle
        (set @entity.status idle)
        (set @entity.pick none)
      START -> searching
        (set @entity.request ?request)
        (set @entity.orbitalName ?orbitalName)
        (set @entity.context (default ?context ""))
        (set @entity.step 0)
        (set @entity.repairs 0)
        (set @entity.status searching)
        (emit BUILD_PROGRESS { status: "searching", tier: "" })
        (emit LLM_EMBED { texts: (array/prepend [] ?request) })
    }

    state failed {
      INIT -> failed
        (set @entity.status failed)
      RESET -> idle
        (set @entity.status idle)
        (set @entity.pick none)
      START -> searching
        (set @entity.request ?request)
        (set @entity.orbitalName ?orbitalName)
        (set @entity.context (default ?context ""))
        (set @entity.step 0)
        (set @entity.repairs 0)
        (set @entity.status searching)
        (emit BUILD_PROGRESS { status: "searching", tier: "" })
        (emit LLM_EMBED { texts: (array/prepend [] ?request) })
    }

    emits {
      BUILD_COMPLETE -> external {
        orbitalName : string!
        behavior : string!
        value : behavior!
        tier : string!
        fields : Map string string
      }
        @description "A tier served the request: the behavior (its specifier and its value), the ladder step that served it, and the extra fields the fill turn wrote (or that the adopted pool entry carries)."
        @tier "domain"
      BUILD_REJECTED -> external {
        error : string!
        errors : [BuildIssue]
      }
        @description "No tier could serve the request, or the build failed; the validator's issues come back as data."
        @tier "domain"
      BUILD_PROGRESS -> external {
        status : string!
        tier : string
      }
        @description "The build moved on (searching, describing, filling, repairing, building) at a ladder step, for a page that shows the build as it streams."
        @tier "domain"
      POOL_SEARCH -> external {
        vector : [number]!
        take : number
      }
        @description "A pool step asks the pool for its best entries for the request's vector; std-agent-pool's SEARCH answers with POOL_FOUND."
        @tier "domain"
      CONVERSE -> external {
        messages : [AgentChatMessage]!
        instructions : string
        tools : [AgentToolInput]
        ephemeral : boolean
      }
        @tier "internal"
      STEP {
      }
        @tier "internal"
      RANKED {
      }
        @tier "internal"
      LLM_EMBED -> external {
        texts : [string]!
      }
        @description "Ask std-llm to embed the request."
        @tier "internal"
      LLM_CHOOSE -> external {
        state : string!
        instructions : string!
        options : [{ value : string!, description : string! }]!
      }
        @description "Ask std-llm's decision model to pick one of the ranked building blocks."
        @tier "internal"
      CATALOG_LISTED {
        result : [AgentBuilderCatalogHit]!
      }
        @tier "internal"
      DESCRIBED {
        result : BehaviorDescription!
      }
        @tier "internal"
      BUILT {
        result : Built!
      }
        @tier "internal"
      BUILD_FAILED {
        error : string!
        errors : [BuildIssue]
      }
        @tier "internal"
    }

    listens {
      START -> input {
        request : string!
        orbitalName : string!
        context : string
      }
        @description "Build a behavior for the request; orbitalName names the program a mount or fill writes; context is any extra the fill turn should know."
      RESET
      POOL_FOUND {
        hits : [PoolHit]!
      }
        @description "The pool's answer to POOL_SEARCH: its best entries, best first."
      FILL -> input {
        config : Map string SExpr
        traits : Map string FilledTrait
        fields : Map string string
      }
        @description "The model's knob settings for the building block and the extra fields it was asked to write."
      PICK -> input {
        behavior : string!
        fields : Map string string
      }
        @description "The model's pick among the building blocks a fill step offered."
      BuilderTools.ASSISTANT_REPLIED -> ASSISTANT_REPLIED
      ASSISTANT_REPLIED {
        reply : string
      }
      BuilderLlm.LLM_EMBED_RESULT -> REQUEST_EMBEDDED
      BuilderLlm.LLM_CHOOSE_RESULT -> CHOSEN
      BuilderLlm.LLM_FAILED -> LLM_REQUEST_FAILED
      REQUEST_EMBEDDED {
        embeddings : [[number]]!
      }
      CHOSEN {
        choice : string!
        confidence : number!
      }
      LLM_REQUEST_FAILED {
        code : string
        message : string!
      }
      BuilderTools.ASSISTANT_REPLY_FAILED -> TOOLS_FAILED
      TOOLS_FAILED {
        error : string!
      }
    }
  }

  trait BuilderLlm = Llm.traits.LlmClient {
    listens {
      BuilderPipeline.LLM_EMBED -> LLM_EMBED
      BuilderPipeline.LLM_CHOOSE -> LLM_CHOOSE
      BuilderTools.LLM_CALL_TOOLS -> LLM_CALL_TOOLS
      BuilderTools.LLM_TOOLS_ANSWERED -> LLM_TOOLS_ANSWERED
      BuilderTools.LLM_CANCEL -> LLM_CANCEL
    }
  }

  trait BuilderTools = ToolLoop.traits.AgentToolLoop {
    config {
      quiet: true
      maxSteps: 4
    }
    listens {
      BuilderPipeline.CONVERSE -> CONVERSE
      BuilderLlm.LLM_TOOLS_REQUESTED -> ToolsRequested
      BuilderLlm.LLM_TOOLS_STEP -> ToolsStep
      BuilderLlm.LLM_CALL_TOOLS_RESULT -> ToolsReplied
      BuilderLlm.LLM_FAILED -> ToolsFailed
      BuilderLlm.LLM_CANCELLED -> ToolsCancelled
      ToolsRequested {
        session : string!
        calls : [ToolCall]!
      }
      ToolsStep {
        activity : AgentActivity!
      }
      ToolsReplied {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
      }
      ToolsFailed {
        code : string
        message : string!
      }
      ToolsCancelled {
        key : string!
      }
    }
  }

  page boot as AgentBuilderPage -> BuilderPipeline, BuilderTools, BuilderLlm
}
