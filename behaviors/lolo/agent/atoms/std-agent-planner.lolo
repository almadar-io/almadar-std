app std-agent-planner [
  version: "1.0.0",
  description: "Agent planner molecule — recall memories, then generate a plan from the prompt + recalled context through std-llm (LLM_GENERATE).",
  net: { "api.openai.com:443": [tcp], "openrouter.ai:443": [tcp] },
]

uses Spec from "almadar-std/planner"
uses Llm from "std/behaviors/std-llm"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"
uses Delay from "std/behaviors/std-delay"
uses Memory from "std/behaviors/std-agent-memory"

type PlannerChatMessage = { role : "user" | "assistant"!, content : string! }

orbital AgentPlannerOrbital {

  entity AgentMemory [persistent: agentMemories] {
    id : string!
    ownerId : string!
    content : string!
    embedding : [number] = []
    createdAt : instant
    pendingMessages : [PlannerChatMessage] @intrinsic = []
    pendingQuery : string @intrinsic = ""
    pendingContent : string @intrinsic = ""
    page : number @intrinsic = 1
    queryVector : [number] @intrinsic = []
  }

  entity PlannerPlan [runtime] {
    prompt : string = ""
    context : string = ""
    plan : string = ""
    status : "idle" | "planning" | "planned" = idle
  }

  trait PlannerLlm = Llm.traits.LlmClient {
    listens {
      PlannerExecution.LLM_GENERATE -> LLM_GENERATE
      PlannerChatRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      PlannerChatRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      PlannerChatRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      PlannerChatHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
      PlannerMemory.LLM_EMBED -> LLM_EMBED
      PlannerEmbedWait.PLANNER_EMBED_WAITED -> LLM_EMBED_WAITED
      PlannerEmbedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      PlannerEmbedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      PlannerEmbedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }

  trait PlannerEmbedWait = Delay.traits.Delay {
    events {
      ELAPSED: PLANNER_EMBED_WAITED
    }
    listens {
      PlannerLlm.LLM_EMBED_WAIT -> START
    }
  }

  trait PlannerEmbedRequest = Req.traits.HttpRequest {
    listens {
      PlannerLlm.LLM_EMBED_WIRE -> HTTP_REQUEST
      PlannerLlm.LLM_EMBED_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      PlannerEmbedHttp.HTTP_REPLIED -> HTTP_REPLIED
      PlannerEmbedHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait PlannerEmbedHttp = Http.traits.HttpClient {
    config {
      host: "openrouter.ai"
      port: 443
      tls: true
      serverName: "openrouter.ai"
      credential: "EMBEDDING_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      PlannerEmbedRequest.HTTP_SEND -> HTTP_SEND
      PlannerEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }

  trait PlannerMemory = Memory.traits.AgentMemoryRecall -> AgentMemory {
    listens {
      PlannerExecution.RECALL -> RECALL
      PlannerLlm.LLM_EMBED_RESULT -> MemoryEmbedded
      PlannerLlm.LLM_FAILED -> MemoryEmbedFailed
      MemoryEmbedded {
        embeddings : [[number]]
        key : string
      }
      MemoryEmbedFailed {
        code : string
        message : string!
        key : string
      }
    }
  }

  trait PlannerChatRequest = Req.traits.HttpRequest {
    listens {
      PlannerLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      PlannerLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      PlannerChatHttp.HTTP_REPLIED -> HTTP_REPLIED
      PlannerChatHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait PlannerChatHttp = Http.traits.HttpClient {
    config {
      host: "api.openai.com"
      port: 443
      tls: true
      serverName: "api.openai.com"
      credential: "OPENAI_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      PlannerChatRequest.HTTP_SEND -> HTTP_SEND
      PlannerChatRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }

  trait PlannerExecution -> PlannerPlan [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.context "")
        (set @entity.plan "")
        (set @entity.status idle)
      PLAN -> recalling
        (set @entity.prompt ?prompt)
        (emit RECALL { messages: [{ role: "user", content: @entity.prompt }] })
    }

    state recalling {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.context "")
        (set @entity.plan "")
        (set @entity.status idle)
      RECALLED -> planning
        (set @entity.context (default ?context ""))
        (emit LLM_GENERATE { userPrompt: @entity.prompt })
    }

    state planning {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.context "")
        (set @entity.plan "")
        (set @entity.status idle)
      PLAN_GENERATED -> planned
        (set @entity.plan ?content)
        (set @entity.status planned)
        (emit PLANNED { plan: @entity.plan, memoryCount: (if (!= @entity.context "") 1 0) })
      PLAN_GENERATION_FAILED -> planned
        (set @entity.plan "")
        (set @entity.status planned)
        (emit PLANNED { plan: @entity.plan, memoryCount: (if (!= @entity.context "") 1 0) })
    }

    state planned {
      INIT -> planned
        (set @entity.status planned)
      RESET -> idle
        (set @entity.plan "")
        (set @entity.context "")
        (set @entity.prompt "")
        (set @entity.status idle)
    }

    emits {
      PLANNED {
        plan : string!
        memoryCount : number!
      }
      RECALL -> external {
        messages : [PlannerChatMessage]!
      }
        @description "Ask std-agent-memory to recall what is relevant to the prompt"
        @tier "secondary"
      LLM_GENERATE -> external {
        userPrompt : string!
      }
        @description "Ask std-llm to generate the plan from the prompt"
        @tier "secondary"
    }

    listens {
      PlannerLlm.LLM_GENERATE_RESULT -> PLAN_GENERATED
      PlannerLlm.LLM_FAILED -> PLAN_GENERATION_FAILED
      PlannerMemory.RECALLED -> RECALLED
      RECALLED {
        messages : [PlannerChatMessage]
        context : string
      }
      PLAN_GENERATED {
        content : string!
      }
      PLAN_GENERATION_FAILED {
        code : string
        message : string!
      }
      PLAN {
        prompt : string!
      }
    }
  }

  trait PlannerListener -> PlannerPlan [client] {
    initial: waiting

    state waiting {
      INIT -> waiting
        (set @entity.status idle)
      PLANNED -> ready
        (set @entity.status planned)
    }

    state ready {
      INIT -> ready
        (set @entity.status planned)
      RESET -> waiting
        (set @entity.status idle)
    }

    listens {
      PlannerExecution.PLANNED -> PLANNED
      RESET
    }
  }

  page boot as AgentPlannerPage -> PlannerExecution, PlannerListener, PlannerLlm, PlannerChatRequest, PlannerChatHttp, PlannerEmbedWait, PlannerEmbedRequest, PlannerEmbedHttp, PlannerMemory
}
