app std-agent-planner [
  version: "1.0.0",
  description: "Agent planner molecule — recall memories, then generate a plan from the prompt + recalled context through std-llm (LLM_GENERATE).",
  egress: ["https://api.openai.com", "https://openrouter.ai"]
]

uses Spec from "almadar-std/planner"
uses Llm from "std/behaviors/std-llm"

type MemoryRecord = { id: string!, content: string!, category: string!, strength: number }

orbital AgentPlannerOrbital {

  entity PlannerPlan [runtime] {
    prompt : string = ""
    memories : [MemoryRecord] = []
    plan : string = ""
    status : "idle" | "planning" | "planned" = idle
  }

  trait PlannerLlm = Llm.traits.LlmClient {
    listens {
      PlannerExecution.LLM_GENERATE -> LLM_GENERATE
    }
  }

  trait PlannerExecution -> PlannerPlan [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.memories [])
        (set @entity.plan "")
        (set @entity.status idle)
      PLAN -> recalling
        (set @entity.prompt ?prompt)
        (memory/recall @entity.prompt { emit: { success: MEMORIES_RECALLED, failure: RECALL_FAILED } })
    }

    state recalling {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.memories [])
        (set @entity.plan "")
        (set @entity.status idle)
      MEMORIES_RECALLED -> planning
        (set @entity.memories ?result)
        (emit LLM_GENERATE { userPrompt: @entity.prompt })
      RECALL_FAILED -> planning
        (set @entity.memories [])
        (emit LLM_GENERATE { userPrompt: @entity.prompt })
    }

    state planning {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.memories [])
        (set @entity.plan "")
        (set @entity.status idle)
      PLAN_GENERATED -> planned
        (set @entity.plan ?content)
        (set @entity.status planned)
        (emit PLANNED { plan: @entity.plan, memoryCount: @entity.memories })
      PLAN_GENERATION_FAILED -> planned
        (set @entity.plan "")
        (set @entity.status planned)
        (emit PLANNED { plan: @entity.plan, memoryCount: @entity.memories })
    }

    state planned {
      INIT -> planned
        (set @entity.status planned)
      RESET -> idle
        (set @entity.plan "")
        (set @entity.memories [])
        (set @entity.prompt "")
        (set @entity.status idle)
    }

    emits {
      PLANNED {
        plan : string!
        memoryCount : number!
      }
      MEMORIES_RECALLED {
        result : [MemoryRecord]!
      }
      LLM_GENERATE -> external {
        userPrompt : string!
      }
        @description "Ask std-llm to generate the plan from the prompt"
        @tier "secondary"
    }

    listens {
      PlannerLlm.LLM_GENERATE_RESULT -> PLAN_GENERATED
      PlannerLlm.LLM_FAILED -> PLAN_GENERATION_FAILED
      PLAN_GENERATED {
        content : string!
      }
      PLAN_GENERATION_FAILED {
        code : string
        message : string!
      }
      PLAN {
        prompt : string!
      }
    }
  }

  trait PlannerListener -> PlannerPlan [lifecycle, instance] {
    initial: waiting

    state waiting {
      INIT -> waiting
        (set @entity.status idle)
      PLANNED -> ready
        (set @entity.status planned)
    }

    state ready {
      INIT -> ready
        (set @entity.status planned)
      RESET -> waiting
        (set @entity.status idle)
    }

    listens {
      PlannerExecution.PLANNED -> PLANNED
      RESET
    }
  }

  page "/agent-planner" as AgentPlannerPage -> PlannerExecution, PlannerListener, PlannerLlm
}
