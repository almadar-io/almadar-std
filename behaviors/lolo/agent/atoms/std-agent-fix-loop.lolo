app std-agent-fix-loop [
  version: "2.0.0",
  description: "Agent fix loop — evaluate a program and, when it does not validate, ask the model for a repair. VALIDATE_PROGRAM { program } runs `program/eval` (the 0-error / 0-warning gate, written to the workspace's orbitals/ on success): a valid program emits PROGRAM_VALID { behavior }; an invalid one hands the validator's issues to `call-service llm generate` and emits FIX_PROPOSED { issues, fix } with the model's repair instructions. Headless apart from a status line.",
  egress: ["https://api.openai.com", "https://openrouter.ai"]
]
;; @capabilities "program repair, fix validation errors, evaluate a program, repair suggestion"

type FixIssue = {
  code : string!
  message : string!
}
type Evaluated = {
  behavior : string!
}

uses Llm from "std/behaviors/std-llm"

orbital AgentFixLoopOrbital {

  entity FixLoop [runtime] {
    id : string!
    issues : [FixIssue] = []
    fix : string = ""
    status : "idle" | "validating" | "fixing" | "fixed" | "valid" | "failed" = idle
  }

  trait FixLoopLlm = Llm.traits.LlmClient {
    listens {
      FixLoopExecution.LLM_GENERATE -> LLM_GENERATE
    }
  }

  trait FixLoopExecution -> FixLoop [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.status idle)
        (render-ui main <typography content="Waiting for a program." variant="caption" />)
      VALIDATE_PROGRAM -> validating
        (set @entity.status validating)
        (program/eval ?program {
          emit: { failure: PROGRAM_INVALID, success: PROGRAM_EVALUATED }
        })
    }

    state validating {
      INIT -> idle
        (set @entity.status idle)
        (render-ui main <typography content="Waiting for a program." variant="caption" />)
      PROGRAM_EVALUATED -> valid
        (set @entity.status valid)
        (render-ui main <typography content={(str/concat "Valid: " (object/get ?result behavior))} variant="caption" />)
        (emit PROGRAM_VALID { behavior: (object/get ?result behavior) })
      PROGRAM_INVALID -> fixing
        (set @entity.issues ?errors)
        (set @entity.status fixing)
        (render-ui main <typography content={(str/concat "Does not validate: " ?error)} variant="caption" />)
        (emit LLM_GENERATE {
          userPrompt: (str/concat "This program does not validate. Explain, step by step, how to fix it. Issues:\n" (str/join (array/map ?errors (fn issue (str/concat (object/get @issue code) ": " (object/get @issue message)))) "\n"))
        })
    }

    state fixing {
      INIT -> idle
        (set @entity.status idle)
        (render-ui main <typography content="Waiting for a program." variant="caption" />)
      LLM_GENERATE_RESULT -> fixed
        (set @entity.fix ?content)
        (set @entity.status fixed)
        (render-ui main <typography content="Repair proposed." variant="caption" />)
        (emit FIX_PROPOSED { issues: @entity.issues, fix: ?content })
      LLM_FAILED -> failed
        (set @entity.status failed)
        (render-ui main <typography content={(str/concat "No repair: " ?message)} variant="caption" />)
    }

    state valid {
      INIT -> valid
        (set @entity.status valid)
      RESET -> idle
        (set @entity.status idle)
        (render-ui main <typography content="Waiting for a program." variant="caption" />)
    }

    state fixed {
      INIT -> fixed
        (set @entity.status fixed)
      RESET -> idle
        (set @entity.status idle)
        (render-ui main <typography content="Waiting for a program." variant="caption" />)
    }

    state failed {
      INIT -> failed
        (set @entity.status failed)
      RESET -> idle
        (set @entity.status idle)
        (render-ui main <typography content="Waiting for a program." variant="caption" />)
    }

    emits {
      PROGRAM_VALID -> external {
        behavior : string!
      }
      FIX_PROPOSED -> external {
        issues : [FixIssue]!
        fix : string!
      }
      PROGRAM_EVALUATED {
        result : Evaluated!
      }
      PROGRAM_INVALID {
        error : string!
        errors : [FixIssue]!
      }
      LLM_GENERATE -> external {
        userPrompt : string!
      }
      LLM_GENERATE_RESULT {
        content : string!
      }
      LLM_FAILED {
        code : string
        message : string!
      }
    }

    listens {
      VALIDATE_PROGRAM -> external {
        program : SExpr!
      }
      RESET
      FixLoopLlm.LLM_GENERATE_RESULT -> LLM_GENERATE_RESULT
      FixLoopLlm.LLM_FAILED -> LLM_FAILED
    }
  }

  page "/agent-fix-loop" as AgentFixLoopPage -> FixLoopExecution, FixLoopLlm
}
