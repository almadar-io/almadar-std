app std-agent-memory [
  version: "2.0.0",
  description: "std-agent-memory — what an in-app assistant remembers across conversations. Owns AgentMemory rows (content + its embedding, ownerId = the real @user). RECALL { messages } embeds the last turn with std-llm (LLM_EMBED), ranks the stored memories whose embedding is comparable (same length as the query's) by cosine similarity and emits RECALLED { messages, context } with the closest `recallLimit` memories joined into one context string (empty when nothing is stored); if embedding fails it emits RECALLED with an empty context, so a memory outage never blocks the assistant. REMEMBER { reply } stores the exchange it just recalled for (asked + answered) with its embedding. AgentMemoryRecall (RECALL) and AgentMemoryStore (REMEMBER) are headless data traits that report failures as MEMORY_RECALL_NOTICE / MEMORY_STORE_NOTICE; AgentMemoryView renders those notices as toasts, so a composer that wants them composes it; AgentMemoryBrowse is the list view. Rows are meant to be private to their owner: the binding organism declares the @read scoping.",
  net: { "openrouter.ai:443": [tcp] },
]

type AgentChatMessage = {
  role : "user" | "assistant"!
  content : string!
}
type AgentToolScope = {
  scope : "declared"!
  roles : [string]!
  fireAndForget : boolean
}
type AgentToolField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [AgentToolField]
  description : string
}
type AgentToolInput = {
  event : EventAddress!
  roles : [string]!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type AgentToolRead = {
  read : string!
  roles : [string]!
}
type AgentTool = AgentToolScope | AgentToolInput | AgentToolRead
type AgentMemoryRow = {
  id : string!
  content : string!
  createdAt : instant
}

uses Llm from "std/behaviors/std-llm"

uses Req from "std/behaviors/std-http-request"

uses Http from "std/behaviors/std-http-client"

uses Delay from "std/behaviors/std-delay"

orbital AgentMemoryOrbital {
  type AgentMemoriesLoaded = Event { data : [AgentMemory]!, totalCount : number } "Fired when the stored memories finish loading"
  type AgentMemoriesLoadFailed = Event { error : string, code : string } "Fired when the stored memories fail to load"
  type MemoryEmbedded = Event { embeddings : [[number]]!, key : string } "Fired when a memory or query has been embedded"
  type MemoryEmbedFailed = Event { code : string, message : string!, key : string } "Fired when embedding fails"

  entity AgentMemory [persistent: agentMemories] {
    id : string!
    ownerId : string! @description "Whose memory this is (the real @user). The binding organism scopes @read to it." @synonyms "user, owner, account"
    content : string! @description "What is remembered." @synonyms "memory, note, fact"
    embedding : [number] @description "The content's embedding, for similarity recall." = []
    createdAt : instant @description "When it was remembered." @synonyms "time, timestamp"
    pendingMessages : [AgentChatMessage] @intrinsic @description "The conversation a recall is running for." = []
    pendingQuery : string @intrinsic @description "The turn a recall is running for." = ""
    pendingContent : string @intrinsic @description "The exchange being remembered." = ""
    page : number @intrinsic @description "The page the list shows." = 1
    queryVector : [number] @intrinsic @description "The recall query's embedding." = []
  }

  trait AgentMemoryLlm = Llm.traits.LlmClient {
    listens {
      AgentMemoryRecall.LLM_EMBED -> LLM_EMBED
      AgentMemoryStore.LLM_EMBED -> LLM_EMBED
      MemEmbedWait.MEM_EMBED_WAITED -> LLM_EMBED_WAITED
      MemEmbedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      MemEmbedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      MemEmbedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }

  trait MemEmbedWait = Delay.traits.Delay {
    events {
      ELAPSED: MEM_EMBED_WAITED
    }
    listens {
      AgentMemoryLlm.LLM_EMBED_WAIT -> START
    }
  }

  trait MemEmbedRequest = Req.traits.HttpRequest {
    listens {
      AgentMemoryLlm.LLM_EMBED_WIRE -> HTTP_REQUEST
      AgentMemoryLlm.LLM_EMBED_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      MemEmbedHttp.HTTP_REPLIED -> HTTP_REPLIED
      MemEmbedHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait MemEmbedHttp = Http.traits.HttpClient {
    config {
      host: "openrouter.ai"
      port: 443
      tls: true
      serverName: "openrouter.ai"
      credential: "EMBEDDING_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      MemEmbedRequest.HTTP_SEND -> HTTP_SEND
      MemEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }

  trait AgentMemoryRecall -> @rebindable AgentMemory {
    config {
      recallLimit : number = 3
        @label "Memories recalled per request"
        @description "How many of the closest memories go to the model with each request."
        @tier "policy"
      maxRows : number = 5000
        @label "Memories ranked per recall"
        @description "Most stored memories one recall may read to rank by similarity. Each row holds an embedding, so the cap bounds the scan; a store holding more is refused through AgentMemoriesLoadFailed and the assistant answers with an empty context instead of a ranking over a partial set."
        @synonyms "recall scan limit, memory cap"
        @tier "infra"
      pageSize : number = 50
        @label "Memories listed per request"
        @description "Newest memories ASSISTANT_MEMORIES_LOADED carries per LIST request; totalCount in the payload says how many are stored."
        @synonyms "list limit, records per page, page limit"
        @tier "presentation"
    }
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.pendingQuery "")
      LIST -> ready
        (fetch AgentMemory {
          emit: { failure: MemoryListFailed, success: MemoriesForList }
          limit: @config.pageSize
          offset: 0
          orderBy: "createdAt:desc"
        })
      MemoriesForList -> ready
        (emit ASSISTANT_MEMORIES_LOADED { data: (array/map (array/sort (default ?data []) createdAt desc) (fn item { id: @item.id, content: @item.content, createdAt: @item.createdAt })), totalCount: ?totalCount })
      MemoryListFailed -> ready
        (emit ASSISTANT_MEMORIES_LOADED { data: [] })
        (emit MEMORY_RECALL_NOTICE { message: ?error, variant: "error" })
      RECALL -> ready when (default ?ephemeral false)
        (emit RECALLED { messages: ?messages, context: "", instructions: (default ?instructions ""), tools: (object/get ? tools []), ephemeral: true })
      RECALL -> recalling when (not (default ?ephemeral false))
        (set @entity.pendingMessages ?messages)
        (set @entity.pendingQuery (object/get (default (array/last ?messages) {}) content ""))
        (emit LLM_EMBED {
          texts: (array/prepend [] (object/get (default (array/last ?messages) {}) content "")),
          key: "recall"
        })
    }

    state recalling {
      INIT -> ready
        (set @entity.pendingQuery "")
      MemoryEmbedded -> recalling when (= (default ?key "") "recall")
        (set @entity.queryVector (default (array/first ?embeddings) []))
        (fetch AgentMemory {
          emit: { failure: AgentMemoriesLoadFailed, success: MemoriesForRecall }
          limit: @config.maxRows
        })
      MemoriesForRecall -> recalling when (> ?totalCount (array/len (default ?data [])))
        (emit AgentMemoriesLoadFailed { error: (str/concat "AgentMemory has " ?totalCount " rows, over the maxRows cap of " @config.maxRows), code: "AGENT_MEMORY_OVER_CAP" })
      MemoriesForRecall -> ready
        (emit RECALLED {
          messages: @entity.pendingMessages
          context: (str/join (array/map (array/take (array/sort (array/map (array/filter (default ?data []) (fn item (and (> (array/len @entity.queryVector) 0) (= (array/len @item.embedding) (array/len @entity.queryVector))))) (fn item { content: @item.content, score: (array/cosine @item.embedding @entity.queryVector) })) score desc) @config.recallLimit) (fn item @item.content)) "\n")
        })
      MemoryEmbedFailed -> ready when (= (default ?key "") "recall")
        (emit RECALLED { messages: @entity.pendingMessages, context: "" })
        (emit MEMORY_RECALL_NOTICE { message: ?message, variant: "warning" })
      AgentMemoriesLoadFailed -> ready
        (emit RECALLED { messages: @entity.pendingMessages, context: "" })
        (emit MEMORY_RECALL_NOTICE { message: ?error, variant: "warning" })
    }

    emits {
      RECALLED -> external {
        messages : [AgentChatMessage]!
        context : string
        instructions : string
        tools : [AgentTool]
        ephemeral : boolean
      }
        @description "The conversation, with what the assistant remembers that is closest to its last turn. An ephemeral conversation is never recalled for: empty `context`, its own `instructions`, `tools` and `ephemeral` flag pass through."
        @synonyms "recalled, remembered, context ready"
        @tier "domain"
      ASSISTANT_MEMORIES_LOADED -> external {
        data : [AgentMemoryRow]!
        totalCount : number
      }
        @description "What the assistant remembers for this person, newest first (empty when nothing is, or the list could not load)."
        @synonyms "memories, what I remember"
        @tier "domain"
      MemoriesForList -> internal {
        data : [AgentMemory]
        totalCount : number
      }
        @tier "internal"
      MemoryListFailed -> internal {
        error : string
        code : string
      }
        @tier "internal"
      MEMORY_RECALL_NOTICE -> internal {
        message : string
        variant : "error" | "warning"
      }
        @tier "internal"
      AgentMemoriesLoadFailed {
        error : string
        code : string
      }
        @tier "internal"
      MemoriesForRecall -> internal {
        data : [AgentMemory]
        totalCount : number!
      }
        @tier "internal"
      LLM_EMBED -> external {
        texts : [string]!
        key : string
      }
        @description "Ask std-llm to embed the recall query or the exchange being remembered."
        @tier "internal"
    }

    listens {
      *.ASSISTANT_MEMORIES_REQUESTED -> LIST
      AgentMemoryLlm.LLM_EMBED_RESULT -> MemoryEmbedded
      AgentMemoryLlm.LLM_FAILED -> MemoryEmbedFailed
      MemoryEmbedded {
        embeddings : [[number]]!
        key : string
      }
      MemoryEmbedFailed {
        code : string
        message : string!
        key : string
      }
      LIST {
      }
        @description "List what the assistant remembers for this person."
      RECALL {
        messages : [AgentChatMessage]!
        instructions : string
        tools : [AgentTool]
        ephemeral : boolean
      }
        @description "Recall what is relevant to this conversation's last turn. An ephemeral conversation skips the recall."
    }
  }

  trait AgentMemoryStore -> @rebindable AgentMemory {
    initial: ready

    state ready {
      INIT -> ready
      MEMORY_STORED -> ready
        (set @entity.pendingContent "")
      REMEMBER -> ready when (default ?ephemeral false)
      REMEMBER -> remembering when (not (default ?ephemeral false))
        (set @entity.pendingContent (str/concat "Asked: " @entity.pendingQuery " | Answered: " ?reply))
        (emit LLM_EMBED {
          texts: (array/prepend [] (str/concat "Asked: " @entity.pendingQuery " | Answered: " ?reply)),
          key: "store"
        })
    }

    state remembering {
      INIT -> ready
        (set @entity.pendingQuery "")
      MemoryEmbedded -> ready when (= (default ?key "") "store")
        (persist create AgentMemory {
          ownerId: @user.id
          content: @entity.pendingContent
          embedding: (default (array/first ?embeddings) [])
          createdAt: @now
        } {
          emit: { success: MEMORY_STORED }
        })
      MemoryEmbedFailed -> ready when (= (default ?key "") "store")
        (emit MEMORY_STORE_NOTICE { message: ?message, variant: "warning" })
    }

    emits {
      MEMORY_STORED -> external
        @description "A new memory was stored — payload is the created AgentMemory row itself."
        @synonyms "remembered, stored, saved"
        @tier "domain"
      LLM_EMBED -> external {
        texts : [string]!
        key : string
      }
        @description "Ask std-llm to embed the exchange being remembered."
        @tier "internal"
      MEMORY_STORE_NOTICE -> internal {
        message : string
        variant : "error" | "warning"
      }
        @tier "internal"
    }

    listens {
      AgentMemoryLlm.LLM_EMBED_RESULT -> MemoryEmbedded
      AgentMemoryLlm.LLM_FAILED -> MemoryEmbedFailed
      MemoryEmbedded {
        embeddings : [[number]]!
        key : string
      }
      MemoryEmbedFailed {
        code : string
        message : string!
        key : string
      }
      REMEMBER {
        reply : string!
        ephemeral : boolean
      }
        @description "Remember the exchange just answered. An ephemeral conversation is never remembered."
    }
  }

  trait AgentMemoryView -> @rebindable AgentMemory {
    initial: ready

    state ready {
      INIT -> ready
      MEMORY_RECALL_NOTICE -> ready
        (render-ui toast {
          message: ?message
          type: alert
          variant: ?variant
        })
      MEMORY_STORE_NOTICE -> ready
        (render-ui toast {
          message: ?message
          type: alert
          variant: ?variant
        })
    }

    listens {
      AgentMemoryRecall.MEMORY_RECALL_NOTICE -> MEMORY_RECALL_NOTICE
      AgentMemoryStore.MEMORY_STORE_NOTICE -> MEMORY_STORE_NOTICE
      MEMORY_RECALL_NOTICE {
        message : string
        variant : "error" | "warning"
      }
      MEMORY_STORE_NOTICE {
        message : string
        variant : "error" | "warning"
      }
    }
  }

  trait AgentMemoryBrowse -> @rebindable AgentMemory {
    initial: browsing

    config {
      pageSize : number = 50
        @label "How many memories to fetch per page?"
        @description "Memories fetched from the server per page request, newest first; the list's own pager loads later pages through REFETCH_PAGE."
        @synonyms "fetch limit, records per page, batch size, page limit"
        @tier "presentation"
    }

    state browsing {
      INIT -> browsing
        (set @entity.page 1)
        (fetch AgentMemory {
          emit: { failure: AgentMemoriesLoadFailed, success: AgentMemoriesLoaded }
          limit: @config.pageSize
          offset: 0
          orderBy: "createdAt:desc"
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
      AgentMemoriesLoaded -> browsing
        (render-ui main {
          children: [{
            emptyTitle: "Nothing remembered yet"
            entity: (array/sort ?data createdAt desc)
            fields: []
            gap: sm
            renderItem: (fn item {
              content: @item.content
              type: typography
              variant: body
            })
            type: data-list
          }, {
            currentPage: @entity.page
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
            totalPages: (math/max 1 (math/ceil (/ ?totalCount @config.pageSize)))
            type: pagination
          }]
          direction: vertical
          gap: md
          type: stack
        })
      AgentMemoriesLoadFailed -> browsing
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      MEMORY_STORED -> browsing
        (set @entity.page 1)
        (fetch AgentMemory {
          emit: { failure: AgentMemoriesLoadFailed, success: AgentMemoriesLoaded }
          limit: @config.pageSize
          offset: 0
          orderBy: "createdAt:desc"
        })
      REFETCH_PAGE -> browsing
        (set @entity.page ?page)
        (fetch AgentMemory {
          emit: { failure: AgentMemoriesLoadFailed, success: AgentMemoriesLoaded }
          limit: @config.pageSize
          offset: (* (- ?page 1) @config.pageSize)
          orderBy: "createdAt:desc"
        })
    }

    emits {
      AgentMemoriesLoaded {
        data : [AgentMemory]!
        totalCount : number
      }
        @description "The stored memories finished loading."
        @tier "internal"
      AgentMemoriesLoadFailed {
        error : string
        code : string
      }
        @tier "internal"
    }

    listens {
      AgentMemoryStore.MEMORY_STORED -> MEMORY_STORED
      REFETCH_PAGE {
        page : number!
      }
        @description "Triggers a memory list page refresh."
        @synonyms "reload, refresh, update, paginate"
    }
  }

  page "/agent-memory" as AgentMemoryPage -> AgentMemoryBrowse, AgentMemoryRecall, AgentMemoryStore, AgentMemoryView, AgentMemoryLlm, MemEmbedWait, MemEmbedRequest, MemEmbedHttp
}
