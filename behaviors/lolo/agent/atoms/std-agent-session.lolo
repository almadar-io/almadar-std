app std-agent-session [
  version: "3.0.0",
  description: "std-agent-session — the conversation with an in-app assistant. AgentThread owns the persisted AgentMessage rows (role, content, ownerId stamped with the real @user, createdAt): SEND stores the user's message, reloads the thread and emits CONVERSE with the whole conversation, oldest first, for std-agent-tool-loop to answer; REPLIED stores the reply. AgentConversation is what the user sees, in the browser: the thread as chat bubbles with every step the assistant takes interleaved live (STEP: each model call, each tool it used and what the app answered), a thinking row while it works, and a chat bar. The two talk over the assistant contract, from any orbital: AgentConversation emits ASSISTANT_SEND and hears AgentMessagesLoaded, ASSISTANT_THREAD_FAILED, ASSISTANT_STEP, ASSISTANT_REPLIED and ASSISTANT_REPLY_FAILED; AgentThread hears ASSISTANT_SEND. So a conversation placed on any section's page reaches the app's one assistant (std-agent-assistant) with no wiring. Rows are meant to be private to their owner: owner-scoped access needs an [identity] roster, so the binding organism declares the @read/@create scoping on AgentMessage — this generic atom cannot."
]

type AgentChatMessage = {
  role : "user" | "assistant"!
  content : string!
}
type AgentLink = {
  label : string!
  href : string!
}
type AgentChatRow = {
  id : string!
  title : string
  lastActiveAt : number
}
type AgentMemoryRow = {
  id : string!
  content : string!
  createdAt : number
}
type AgentThreadRow = {
  role : "user" | "assistant"!
  content : string!
  createdAt : number
}
type AgentToolScope = {
  scope : "declared"!
}
type AgentToolInput = {
  event : EventAddress!
}
type AgentToolRead = {
  read : string!
}
type AgentTool = AgentToolScope | AgentToolInput | AgentToolRead
type AgentToolKind = "input" | "read" | "invalid"
type AgentMessageEntry = {
  type : "message"!
  role : "user" | "assistant"!
  content : string!
  timestamp : number!
}
type AgentErrorEntry = {
  type : "error"!
  message : string!
  timestamp : number!
}
type AgentToolCallActivity = {
  type : "tool_call"!
  tool : string!
  kind : AgentToolKind
  argsText : string!
  timestamp : number!
  isExecuting : boolean
}
type AgentToolResultActivity = {
  type : "tool_result"!
  tool : string!
  kind : AgentToolKind
  success : boolean!
  detail : string
  rows : number
  resultText : string!
  timestamp : number!
}
type AgentLlmCall = {
  service : string!
  provider : string!
  model : string!
  systemPrompt : string!
  userPrompt : string!
  toolCallsJson : string
  attempt : number
  durationMs : number!
  promptTokens : number
  completionTokens : number
  cachedPromptTokens : number
  costUSD : number
}
type AgentLlmResponseActivity = {
  type : "llm_response"!
  content : string!
  llm : AgentLlmCall
  timestamp : number!
}
type AgentActivity = AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity
type AgentFeedEntry = AgentMessageEntry | AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity | AgentErrorEntry

orbital AgentSessionOrbital {
  type AgentMessagesLoaded = Event { data : [AgentMessage] } "Fired when the conversation finishes loading"
  type AgentMessagesLoadFailed = Event { error : string, code : string } "Fired when the conversation fails to load"
  type AgentMessageSaved = Event AgentMessage "Fired after a message persists"
  type AgentMessageSaveFailed = Event { error : string, code : string } "Fired when a message fails to persist"

  entity AgentMessage [persistent: agentMessages] {
    id : string!
    ownerId : string! @description "Whose conversation this message belongs to (the real @user). The binding organism scopes @read to it." @synonyms "user, owner, account"
    role : "user" | "assistant" @description "Who said it." @synonyms "speaker, author" = user
    content : string! @description "What was said." @synonyms "text, message, body"
    createdAt : number @description "When it was said (ms)." @synonyms "time, timestamp" = 0
    chatId : string @description "The conversation this message belongs to (an AgentChat id)." @synonyms "conversation, thread, session" = ""
  }

  entity AgentConversationView [runtime] {
    id : string!
    entries : [AgentFeedEntry] @description "The conversation as shown: messages with the assistant's steps between them." = []
    working : boolean @description "The assistant is answering." = false
    chatInstructions : string @description "The ephemeral conversation's own instructions (empty: the assistant's configured ones)." = ""
    chatTools : [AgentTool] @description "The ephemeral conversation's own tools (empty: none)." = []
    chatTitle : string @description "The ephemeral conversation's header title." = ""
    chatSubtitle : string @description "The ephemeral conversation's header subtitle." = ""
    chatAvatar : string @description "The ephemeral conversation's header avatar image." = ""
  }

  trait AgentThread -> @rebindable AgentMessage [lifecycle] {
    initial: ready

    state ready {
      INIT -> ready
      OPEN_CHAT -> ready when ["=", (str/default ?chatId ""), ""]
        (emit AgentMessagesLoaded { data: [] })
      OPEN_CHAT -> ready when (not ["=", (str/default ?chatId ""), ""])
        (fetch AgentMessage {
          emit: { failure: AgentMessagesLoadFailed, success: AgentMessagesLoaded }
          filter: ["=", (object/get @entity chatId), ?chatId]
        })
      SEND_IN_CHAT -> ready when (not ["=", (str/default ?message ""), ""])
        (persist create AgentMessage {
          ownerId: @user.id
          chatId: ?chatId
          role: user
          content: ?message
          createdAt: @now
        } {
          emit: { failure: AgentMessageSaveFailed, success: AgentMessageSaved }
        })
      AgentMessageSaved -> ready
        (fetch AgentMessage {
          emit: { failure: AgentMessagesLoadFailed, success: AgentConversationLoaded }
          filter: ["=", (object/get @entity chatId), ?chatId]
        })
      AgentConversationLoaded -> ready
        (emit CONVERSE {
          messages: (array/map (array/sort ?data createdAt asc) (fn item { role: @item.role, content: @item.content }))
        })
      REPLY_IN_CHAT -> ready
        (persist create AgentMessage {
          ownerId: @user.id
          chatId: ?chatId
          role: assistant
          content: ?reply
          createdAt: @now
        })
      AgentMessagesLoadFailed -> ready
        (emit ASSISTANT_THREAD_FAILED { error: ?error })
        (render-ui toast {
          message: ?error
          type: alert
          variant: error
        })
      AgentMessageSaveFailed -> ready
        (emit ASSISTANT_THREAD_FAILED { error: ?error })
        (render-ui toast {
          message: ?error
          type: alert
          variant: error
        })
    }

    emits {
      ASSISTANT_THREAD_FAILED -> external {
        error : string!
      }
        @description "The conversation could not be loaded or a message could not be stored."
        @synonyms "failed, error"
        @tier "domain"
      CONVERSE -> external {
        messages : [AgentChatMessage]!
      }
        @description "The current conversation to answer, oldest first; the last turn is the request."
        @synonyms "ask, converse, request"
        @tier "domain"
      AgentMessagesLoaded -> external {
        data : [AgentMessage]
      }
        @description "The current conversation's messages finished loading (empty for a new conversation)."
        @tier "internal"
      AgentMessagesLoadFailed -> external {
        error : string
        code : string
      }
        @description "The conversation could not be loaded."
        @tier "internal"
      AgentConversationLoaded -> internal {
        data : [AgentMessage]
      }
        @tier "internal"
      AgentMessageSaved
        @description "A message persisted — payload is the created AgentMessage row itself."
        @tier "internal"
      AgentMessageSaveFailed -> external {
        error : string
        code : string
      }
        @description "The message could not be stored."
        @tier "internal"
    }

    listens {
      *.ASSISTANT_CHAT_OPENED -> OPEN_CHAT
      *.ASSISTANT_SEND_IN_CHAT -> SEND_IN_CHAT
      *.ASSISTANT_REPLY_IN_CHAT -> REPLY_IN_CHAT
      OPEN_CHAT {
        chatId : string
      }
        @description "Load a conversation's messages (none for a new one)."
      SEND_IN_CHAT {
        chatId : string!
        message : string!
      }
        @description "Store the user's message in this conversation and ask the assistant."
        @synonyms "ask, message, chat"
      REPLY_IN_CHAT {
        chatId : string
        reply : string!
      }
        @description "Store the assistant's answer in this conversation."
    }
  }

  trait AgentConversation -> @rebindable AgentConversationView [interaction, instance] {
    config {
      placeholder : string = "Ask the assistant…"
        @label "Message placeholder"
        @tier "presentation"
      emptyTitle : string = "Ask me to do something in this app"
        @label "Empty conversation title"
        @tier "presentation"
      links : [AgentLink] = [{ label: "All conversations", href: "/agent-session/chats" }]
        @label "Links above the conversation"
        @description "Related pages (e.g. the run history)."
        @tier "presentation"
      newChatLabel : string = "New conversation"
        @label "New conversation button"
        @description "Starts a fresh conversation; earlier ones stay in the conversation list."
        @tier "presentation"
      chatsLabel : string = "Conversations"
        @label "Past conversations button"
        @description "Shows the person's past conversations in place of the chat; picking one reopens it."
        @tier "presentation"
      memoryLabel : string = "What I remember"
        @label "Memory button"
        @description "Shows what the assistant remembers for this person in place of the chat."
        @tier "presentation"
      untitledLabel : string = "New conversation"
        @label "Title of a conversation with no messages yet"
        @tier "presentation"
      chatsEmptyTitle : string = "No conversations yet"
        @label "Empty conversation list"
        @tier "presentation"
      memoryEmptyTitle : string = "Nothing remembered yet"
        @label "Empty memory list"
        @tier "presentation"
      backLabel : string = "Back"
        @label "Back to the conversation"
        @tier "presentation"
      ephemeral : boolean = false
        @label "Ephemeral conversation?"
        @description "A self-contained conversation: it runs under the instructions, tools, greeting and header the app starts it with (ASSISTANT_CHAT_START), is never stored among the person's conversations or remembered, shows no conversation, past-chat or memory buttons, and ignores the assistant's own replies."
        @synonyms "private, one-off, scoped chat, own persona, not saved"
        @tier "domain"
    }
    initial: idle

    state idle {
      INIT -> idle when (not @config.ephemeral)
        (emit ASSISTANT_HISTORY_REQUESTED {})
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      INIT -> idle when @config.ephemeral
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      THREAD_LOADED -> idle when (not @config.ephemeral)
        (set @entity.entries (array/map (array/sort ?data createdAt asc) (fn item { type: message, role: @item.role, content: @item.content, timestamp: @item.createdAt })))
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      ASK -> idle when (and (not @config.ephemeral) (not @entity.working) (not ["=", (str/default ?message ""), ""]))
        (set @entity.entries (array/append @entity.entries { type: message, role: user, content: ?message, timestamp: @now }))
        (set @entity.working true)
        (emit ASSISTANT_SEND { message: ?message })
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      ASK -> idle when (and @config.ephemeral (not @entity.working) (not ["=", (str/default ?message ""), ""]))
        (set @entity.entries (array/append @entity.entries { type: message, role: user, content: ?message, timestamp: @now }))
        (set @entity.working true)
        (emit ASSISTANT_EPHEMERAL_SEND {
          messages: (array/map (array/filter @entity.entries (fn item ["=", @item.type, "message"])) (fn item { role: @item.role, content: @item.content }))
          instructions: @entity.chatInstructions
          tools: @entity.chatTools
          ephemeral: true
        })
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      START_CHAT -> idle when (and @config.ephemeral (not @entity.working))
        (set @entity.entries (if ["=", (str/default ?greeting ""), ""] [] [{ type: message, role: assistant, content: ?greeting, timestamp: @now }]))
        (set @entity.chatInstructions (str/default ?instructions ""))
        (set @entity.chatTools (object/get ? tools []))
        (set @entity.chatTitle (str/default ?title ""))
        (set @entity.chatSubtitle (str/default ?subtitle ""))
        (set @entity.chatAvatar (str/default ?avatar ""))
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      STEP -> idle when (not @config.ephemeral)
        (set @entity.entries (array/append @entity.entries ?activity))
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      REPLIED -> idle when ["=", (if ?ephemeral true false), @config.ephemeral]
        (set @entity.entries (array/append @entity.entries { type: message, role: assistant, content: ?reply, timestamp: @now }))
        (set @entity.working false)
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      NEW_CHAT_CLICKED -> idle when (not @entity.working)
        (set @entity.entries [])
        (emit ASSISTANT_NEW_CHAT {})
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      OPEN_CHATS_CLICKED -> idle
        (emit ASSISTANT_CHATS_REQUESTED {})
      CHATS_LISTED -> idle when (not @config.ephemeral)
        (render-ui main {
          children: [{
            children: [{
              action: BACK_TO_CHAT
              aria-label: @config.backLabel
              icon: arrow-left
              label: @config.backLabel
              size: sm
              type: button
              variant: ghost
            }, {
              content: @config.chatsLabel
              type: typography
              variant: h4
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            type: stack
          }, {
            emptyMessage: @config.chatsEmptyTitle
            entity: ?data
            fields: []
            gap: none
            itemClickEvent: CHAT_PICKED
            renderItem: (fn item {
              children: [{
                className: truncate
                content: (if ["=", (str/default @item.title ""), ""] @config.untitledLabel @item.title)
                type: typography
                variant: body
              }, {
                color: muted
                content: @item.lastActiveAt
                format: date
                type: typography
                variant: caption
              }]
              direction: vertical
              gap: none
              type: stack
            })
            type: data-list
            variant: compact
          }]
          className: "h-full min-h-0 flex-1 overflow-y-auto"
          direction: vertical
          gap: sm
          type: stack
        })
      CHAT_PICKED -> idle when (not @entity.working)
        (emit ASSISTANT_CHAT_SELECTED { chatId: ?id })
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      OPEN_MEMORY_CLICKED -> idle
        (emit ASSISTANT_MEMORIES_REQUESTED {})
      MEMORIES_LISTED -> idle when (not @config.ephemeral)
        (render-ui main {
          children: [{
            children: [{
              action: BACK_TO_CHAT
              aria-label: @config.backLabel
              icon: arrow-left
              label: @config.backLabel
              size: sm
              type: button
              variant: ghost
            }, {
              content: @config.memoryLabel
              type: typography
              variant: h4
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            type: stack
          }, {
            emptyMessage: @config.memoryEmptyTitle
            entity: ?data
            fields: []
            gap: sm
            renderItem: (fn item {
              children: [{
                content: @item.content
                type: typography
                variant: body
              }, {
                color: muted
                content: @item.createdAt
                format: date
                type: typography
                variant: caption
              }]
              direction: vertical
              gap: none
              type: stack
            })
            type: data-list
          }]
          className: "h-full min-h-0 flex-1 overflow-y-auto"
          direction: vertical
          gap: sm
          type: stack
        })
      BACK_TO_CHAT -> idle
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
      REPLY_FAILED -> idle when ["=", (if ?ephemeral true false), @config.ephemeral]
        (set @entity.entries (array/append @entity.entries { type: error, message: ?error, timestamp: @now }))
        (set @entity.working false)
        (render-ui main {
          children: [(if @config.ephemeral { type: stack, direction: horizontal, align: center, gap: sm, className: shrink-0, children: [{ type: avatar, src: (object/get @entity chatAvatar ""), name: @entity.chatTitle, size: md, className: (if ["=", @entity.chatAvatar, ""] hidden "") }, { type: stack, direction: vertical, gap: none, children: [{ type: typography, variant: h4, content: @entity.chatTitle }, { type: typography, variant: caption, content: @entity.chatSubtitle }] }] } {
            children: [{
              action: NEW_CHAT_CLICKED
              aria-label: @config.newChatLabel
              icon: message-square-plus
              label: @config.newChatLabel
              size: sm
              type: button
              variant: secondary
            }, {
              children: [{
                action: OPEN_CHATS_CLICKED
                aria-label: @config.chatsLabel
                label: @config.chatsLabel
                size: sm
                type: button
                variant: ghost
              }, {
                action: OPEN_MEMORY_CLICKED
                aria-label: @config.memoryLabel
                label: @config.memoryLabel
                size: sm
                type: button
                variant: ghost
              }, {
                children: (array/map @config.links (fn item {
                  href: @item.href
                  label: @item.label
                  size: sm
                  type: button
                  variant: ghost
                }))
                direction: horizontal
                gap: xs
                type: stack
              }]
              align: center
              className: shrink-0
              direction: horizontal
              gap: none
              type: stack
            }]
            align: center
            className: shrink-0
            direction: horizontal
            gap: sm
            justify: between
            wrap: true
            type: stack
          }), {
            activities: @entity.entries
            className: flex-1
            emptyTitle: @config.emptyTitle
            idPrefix: agent-conversation
            rawLlmPreferenceKey: agent-conversation-raw-llm
            type: agent-chat-feed
            working: @entity.working
          }, {
            placeholder: @config.placeholder
            sendEvent: ASK
            type: chat-bar
          }]
          className: "h-full min-h-0 flex-1"
          direction: vertical
          gap: sm
          type: stack
        })
    }

    emits {
      ASSISTANT_HISTORY_REQUESTED -> external {
      }
        @description "This conversation view opened; the assistant thread loads the current conversation into it."
        @synonyms "load history, restore conversation"
        @tier "domain"
      ASSISTANT_NEW_CHAT -> external {
      }
        @description "The user started a new conversation."
        @synonyms "new chat, new conversation, start over"
        @tier "domain"
      NEW_CHAT_CLICKED {
      }
        @description "Start a new conversation."
        @synonyms "new chat, start over, clear"
        @tier "presentation"
      ASSISTANT_EPHEMERAL_SEND -> external {
        messages : [AgentChatMessage]!
        instructions : string
        tools : [AgentTool]
        ephemeral : boolean!
      }
        @description "An ephemeral conversation asked something: the whole conversation so far (greeting included), and its own `instructions` and `tools`. Nothing is stored or remembered; the assistant answers under exactly these."
        @synonyms "ask privately, scoped ask"
        @tier "domain"
      ASSISTANT_SEND -> external {
        message : string!
      }
        @description "The user asked something; AgentThread stores it and asks the assistant."
        @synonyms "ask, send, submit"
        @tier "domain"
      ASSISTANT_CHATS_REQUESTED -> external {
      }
        @description "The user opened the conversation list; the conversation keeper sends the person's conversations."
        @synonyms "conversations, history, past chats"
        @tier "domain"
      ASSISTANT_CHAT_SELECTED -> external {
        chatId : string!
      }
        @description "The user picked a past conversation to reopen."
        @synonyms "open conversation, reopen chat"
        @tier "domain"
      ASSISTANT_MEMORIES_REQUESTED -> external {
      }
        @description "The user opened what the assistant remembers; the assistant's memory sends it."
        @synonyms "memories, what I remember"
        @tier "domain"
      OPEN_CHATS_CLICKED {
      }
        @description "Show past conversations."
        @tier "presentation"
      OPEN_MEMORY_CLICKED {
      }
        @description "Show what the assistant remembers."
        @tier "presentation"
      CHAT_PICKED {
        id : string!
        row : AgentChatRow
      }
        @description "Reopen the picked conversation."
        @tier "presentation"
      ASK {
        message : string!
      }
        @description "Send the typed message."
        @synonyms "send, ask, submit"
        @tier "presentation"
    }

    listens {
      *.AgentMessagesLoaded -> THREAD_LOADED
      *.ASSISTANT_THREAD_FAILED -> REPLY_FAILED
      *.ASSISTANT_STEP -> STEP
      *.ASSISTANT_REPLIED -> REPLIED
      *.ASSISTANT_REPLY_FAILED -> REPLY_FAILED
      *.ASSISTANT_CHATS_LOADED -> CHATS_LISTED
      *.ASSISTANT_MEMORIES_LOADED -> MEMORIES_LISTED
      *.ASSISTANT_CHAT_START -> START_CHAT
      START_CHAT {
        greeting : string
        instructions : string
        tools : [AgentTool]
        title : string
        subtitle : string
        avatar : string
      }
        @description "Start an ephemeral conversation (only on an AgentConversation whose `ephemeral` knob is on): it opens with `greeting` as the assistant's first message under a header of `title`, `subtitle` and `avatar` (an image URL), and every ask runs under `instructions` (empty: the assistant's configured ones) and exactly `tools` (absent or `[]`: none). Ignored while it is answering."
        @synonyms "open private chat, begin scoped conversation"
      CHATS_LISTED {
        data : [AgentChatRow]
      }
        @description "Show the person's conversations to pick from."
      MEMORIES_LISTED {
        data : [AgentMemoryRow]
      }
        @description "Show what the assistant remembers."
      BACK_TO_CHAT {
      }
        @description "Back to the conversation."
      THREAD_LOADED {
        data : [AgentThreadRow]
      }
        @description "Show the stored conversation."
      STEP {
        activity : AgentActivity!
      }
        @description "One step the assistant just took, shown as it happens."
        @synonyms "progress, activity, working"
      REPLIED {
        reply : string!
        ephemeral : boolean
      }
        @description "The assistant answered."
      REPLY_FAILED {
        error : string!
        ephemeral : boolean
      }
        @description "The assistant could not answer."
    }
  }

  page "/agent-session" as AgentSessionPage -> AgentConversation, AgentThread
}

;; Conversations: each person's kept chats, the current one (most recently
;; used) and the list of past ones.
orbital AgentChatsOrbital {
  type ChatReadyForSend = Event AgentChat "Fired when the current conversation exists and is marked active"
  type NewChatStarted = Event AgentChat "Fired after a new conversation persists"
  type ChatSelected = Event AgentChat "Fired after a past conversation is reopened"

  entity AgentChat [persistent: agentChats] {
    id : string!
    ownerId : string! @description "Whose conversation this is (the real @user). The binding organism scopes @read to it." @synonyms "user, owner, account"
    title : string @description "The conversation's first request, shown in the conversation list; empty until the first message." @synonyms "name, subject, topic" = ""
    startedAt : number @description "When the conversation started (ms)." @synonyms "created, opened" = 0
    lastActiveAt : number @description "When the conversation was last used (ms). The most recent one is the current conversation." @synonyms "last used, updated, recent" = 0
    pendingMessage : string @intrinsic = ""
    pendingReply : string @intrinsic = ""
  }

  ;; Which conversation is current: each person's most recently used AgentChat.
  ;; It starts, reopens and touches conversations and tells AgentThread which
  ;; one a request belongs to, so only this trait (bound to AgentChat) touches
  ;; conversation rows.
  trait AgentChatKeeper -> @rebindable AgentChat [lifecycle] {
    initial: ready

    state ready {
      INIT -> ready
      LOAD_HISTORY -> ready
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: ChatsForHistory }
        })
      ChatsForHistory -> ready
        (emit ASSISTANT_CHAT_OPENED { chatId: (if [">", (array/len ?data), 0] (object/get (array/first (array/sort ?data lastActiveAt desc)) id) "") })
      SEND -> ready when (not ["=", (str/default ?message ""), ""])
        (set @entity.pendingMessage ?message)
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: ChatsForSend }
        })
      ChatsForSend -> ready when ["=", (array/len ?data), 0]
        (persist create AgentChat {
          ownerId: @user.id
          title: @entity.pendingMessage
          startedAt: @now
          lastActiveAt: @now
        } {
          emit: { failure: AgentChatsLoadFailed, success: ChatReadyForSend }
        })
      ChatsForSend -> ready when [">", (array/len ?data), 0]
        (persist update AgentChat {
          id: (object/get (array/first (array/sort ?data lastActiveAt desc)) id)
          ownerId: (object/get (array/first (array/sort ?data lastActiveAt desc)) ownerId)
          title: (if ["=", (str/default (object/get (array/first (array/sort ?data lastActiveAt desc)) title) ""), ""] @entity.pendingMessage (object/get (array/first (array/sort ?data lastActiveAt desc)) title))
          startedAt: (object/get (array/first (array/sort ?data lastActiveAt desc)) startedAt)
          lastActiveAt: @now
        } {
          emit: { failure: AgentChatsLoadFailed, success: ChatReadyForSend }
        })
      ChatReadyForSend -> ready
        (emit ASSISTANT_SEND_IN_CHAT { chatId: ?id, message: @entity.pendingMessage })
        (emit ASSISTANT_CHATS_CHANGED {})
      REPLIED -> ready when (not ?ephemeral)
        (set @entity.pendingReply ?reply)
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: ChatsForReply }
        })
      ChatsForReply -> ready
        (emit ASSISTANT_REPLY_IN_CHAT { chatId: (if [">", (array/len ?data), 0] (object/get (array/first (array/sort ?data lastActiveAt desc)) id) ""), reply: @entity.pendingReply })
      NEW_CHAT -> ready
        (persist create AgentChat {
          ownerId: @user.id
          title: ""
          startedAt: @now
          lastActiveAt: @now
        } {
          emit: { failure: AgentChatsLoadFailed, success: NewChatStarted }
        })
      NewChatStarted -> ready
        (emit ASSISTANT_CHAT_OPENED { chatId: ?id })
        (emit ASSISTANT_CHATS_CHANGED {})
      SELECT_CHAT -> ready
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: ChatsForSelect }
          filter: ["=", (object/get @entity id), ?chatId]
        })
      ChatsForSelect -> ready when [">", (array/len ?data), 0]
        (persist update AgentChat {
          id: (object/get (array/first ?data) id)
          ownerId: (object/get (array/first ?data) ownerId)
          title: (object/get (array/first ?data) title)
          startedAt: (object/get (array/first ?data) startedAt)
          lastActiveAt: @now
        } {
          emit: { failure: AgentChatsLoadFailed, success: ChatSelected }
        })
      ChatSelected -> ready
        (emit ASSISTANT_CHAT_OPENED { chatId: ?id })
        (emit ASSISTANT_CHATS_CHANGED {})
      LIST_CHATS -> ready
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: ChatsForList }
        })
      ChatsForList -> ready
        (emit ASSISTANT_CHATS_LOADED { data: (array/map (array/sort ?data lastActiveAt desc) (fn item { id: @item.id, title: @item.title, lastActiveAt: @item.lastActiveAt })) })
      AgentChatsLoadFailed -> ready
        (emit ASSISTANT_THREAD_FAILED { error: ?error })
        (render-ui toast {
          message: ?error
          type: alert
          variant: error
        })
    }

    emits {
      ASSISTANT_CHAT_OPENED -> external {
        chatId : string
      }
        @description "This conversation is now the current one (empty for none yet); AgentThread loads its messages."
        @tier "internal"
      ASSISTANT_SEND_IN_CHAT -> external {
        chatId : string!
        message : string!
      }
        @description "The user's message, placed in the current conversation."
        @tier "internal"
      ASSISTANT_REPLY_IN_CHAT -> external {
        chatId : string
        reply : string!
      }
        @description "The assistant's answer, placed in the current conversation."
        @tier "internal"
      ASSISTANT_CHATS_CHANGED -> external {
      }
        @description "A conversation was started, used or reopened; the conversation list refreshes."
        @synonyms "conversations changed, history changed"
        @tier "domain"
      ASSISTANT_THREAD_FAILED -> external {
        error : string!
      }
        @description "A conversation could not be loaded or stored."
        @tier "domain"
      ASSISTANT_CHATS_LOADED -> external {
        data : [AgentChatRow]!
      }
        @description "The person's conversations, most recently used first."
        @synonyms "conversations, history"
        @tier "domain"
      ChatsForList -> internal {
        data : [AgentChat]
      }
        @tier "internal"
      ChatsForHistory -> internal {
        data : [AgentChat]
      }
        @tier "internal"
      ChatsForSend -> internal {
        data : [AgentChat]
      }
        @tier "internal"
      ChatsForReply -> internal {
        data : [AgentChat]
      }
        @tier "internal"
      ChatsForSelect -> internal {
        data : [AgentChat]
      }
        @tier "internal"
      ChatReadyForSend
        @description "The current conversation exists and is marked active — payload is the AgentChat row."
        @tier "internal"
      NewChatStarted
        @description "A new conversation started — payload is the AgentChat row."
        @tier "internal"
      ChatSelected
        @description "A past conversation was reopened — payload is the AgentChat row."
        @tier "internal"
      AgentChatsLoadFailed -> external {
        error : string
        code : string
      }
        @tier "internal"
    }

    listens {
      *.ASSISTANT_SEND -> SEND
      *.ASSISTANT_HISTORY_REQUESTED -> LOAD_HISTORY
      *.ASSISTANT_NEW_CHAT -> NEW_CHAT
      *.ASSISTANT_CHAT_SELECTED -> SELECT_CHAT
      *.ASSISTANT_REPLIED -> REPLIED
      *.ASSISTANT_CHATS_REQUESTED -> LIST_CHATS
      LIST_CHATS {
      }
        @description "Send the person's conversations to the conversation list."
      SEND {
        message : string!
      }
        @description "The user asked something; place it in the current conversation."
      REPLIED {
        reply : string!
        ephemeral : boolean
      }
        @description "The assistant answered; place the answer in the current conversation."
      LOAD_HISTORY {
      }
        @description "A conversation view opened; open the current conversation."
      NEW_CHAT {
      }
        @description "Start a new conversation; the previous one stays in the list."
      SELECT_CHAT {
        chatId : string!
      }
        @description "Reopen a past conversation and make it the current one."
    }
  }

  trait AgentChatList -> @rebindable AgentChat [interaction, instance] {
    config {
      newChatLabel : string = "New conversation"
        @label "New conversation button"
        @tier "presentation"
      untitledLabel : string = "New conversation"
        @label "Name of a conversation with no messages yet"
        @tier "presentation"
    }
    initial: loading

    state loading {
      INIT -> loading
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: AgentChatsLoaded }
        })
        (render-ui main { type: skeleton, variant: list, rows: 4 })
      AgentChatsLoaded -> browsing
        (render-ui main {
          children: [{
            action: NEW_CHAT_CLICKED
            aria-label: @config.newChatLabel
            className: w-full
            icon: message-square-plus
            label: @config.newChatLabel
            type: button
            variant: secondary
          }, {
            emptyDescription: "Your conversations with the assistant appear here."
            emptyIcon: messages-square
            emptyTitle: "No conversations yet"
            entity: (array/sort ?data lastActiveAt desc)
            itemClickEvent: OPEN_CHAT
            renderItem: (fn item {
              children: [{
                className: truncate
                content: (if ["=", (str/default @item.title ""), ""] @config.untitledLabel @item.title)
                type: typography
                variant: body
              }]
              direction: vertical
              gap: none
              type: stack
            })
            type: data-list
            variant: compact
          }]
          className: "h-full min-h-0 overflow-y-auto"
          direction: vertical
          gap: sm
          type: stack
        })
      AgentChatsLoadFailed -> browsing
        (render-ui main { message: ?error, title: "Couldn't load your conversations", type: alert, variant: error })
    }

    state browsing {
      INIT -> loading
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: AgentChatsLoaded }
        })
        (render-ui main { type: skeleton, variant: list, rows: 4 })
      CHATS_CHANGED -> browsing
        (fetch AgentChat {
          emit: { failure: AgentChatsLoadFailed, success: AgentChatsLoaded }
        })
      AgentChatsLoaded -> browsing
        (render-ui main {
          children: [{
            action: NEW_CHAT_CLICKED
            aria-label: @config.newChatLabel
            className: w-full
            icon: message-square-plus
            label: @config.newChatLabel
            type: button
            variant: secondary
          }, {
            emptyDescription: "Your conversations with the assistant appear here."
            emptyIcon: messages-square
            emptyTitle: "No conversations yet"
            entity: (array/sort ?data lastActiveAt desc)
            itemClickEvent: OPEN_CHAT
            renderItem: (fn item {
              children: [{
                className: truncate
                content: (if ["=", (str/default @item.title ""), ""] @config.untitledLabel @item.title)
                type: typography
                variant: body
              }]
              direction: vertical
              gap: none
              type: stack
            })
            type: data-list
            variant: compact
          }]
          className: "h-full min-h-0 overflow-y-auto"
          direction: vertical
          gap: sm
          type: stack
        })
      AgentChatsLoadFailed -> browsing
        (render-ui main { message: ?error, title: "Couldn't load your conversations", type: alert, variant: error })
      OPEN_CHAT -> browsing
        (emit ASSISTANT_CHAT_SELECTED { chatId: ?id })
      NEW_CHAT_CLICKED -> browsing
        (emit ASSISTANT_NEW_CHAT {})
    }

    emits {
      ASSISTANT_CHAT_SELECTED -> external {
        chatId : string!
      }
        @description "The user reopened a past conversation."
        @synonyms "open conversation, switch conversation"
        @tier "domain"
      ASSISTANT_NEW_CHAT -> external {
      }
        @description "The user started a new conversation."
        @synonyms "new chat, new conversation, start over"
        @tier "domain"
      AgentChatsLoaded -> external {
        data : [AgentChat]
      }
        @tier "internal"
      AgentChatsLoadFailed -> external {
        error : string
        code : string
      }
        @tier "internal"
    }

    listens {
      *.ASSISTANT_CHATS_CHANGED -> CHATS_CHANGED
      CHATS_CHANGED {
      }
        @description "A conversation was started, used or reopened."
      OPEN_CHAT {
        id : string!
        row : AgentChat
      }
        @description "Reopen this conversation."
        @synonyms "open, select, switch"
        @tier "presentation"
      NEW_CHAT_CLICKED {
      }
        @description "Start a new conversation."
        @tier "presentation"
    }
  }

  page "/agent-session/chats" as AgentChatsPage -> AgentChatList, AgentChatKeeper
}
