app std-agent-context "2.0.0"
"std-agent-context — keeps what an in-app assistant sends the model bounded. COMPACT { messages } passes a conversation of at most `keepMessages` turns straight through as COMPACTED; a longer one has its older turns summarized with `call-service llm summarize` into one leading note and keeps the last `keepMessages` turns verbatim. If summarizing fails, the older turns are dropped and the recent ones still go through, with a visible warning — a summarizer outage never blocks the assistant. Headless. Nothing is persisted: the conversation itself lives in std-agent-session."

type AgentChatMessage = {
  role : "user" | "assistant"
  content : string!
}

orbital AgentContextOrbital {
  type ContextSummarized = Event { summary : string, keyPoints : [string] } "Fired when the older turns have been summarized"
  type ContextSummarizeFailed = Event { error : string } "Fired when summarizing fails"

  entity AgentContextWindow [runtime] {
    id : string!
    pendingMessages : [AgentChatMessage] @description "The conversation being compacted." = []
    lastSize : number @description "Turns in the last conversation compacted." @synonyms "size, length" = 0
  }

  trait AgentContextCompactor -> AgentContextWindow [interaction] {
    config {
      keepMessages : number = 12
        @label "Turns kept verbatim"
        @description "The most recent turns sent to the model word for word; older turns are summarized."
        @synonyms "window, history length, context size"
        @tier "policy"
    }
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.lastSize 0)
      COMPACT -> ready when (<= (array/len ?messages) @config.keepMessages)
        (set @entity.lastSize (array/len ?messages))
        (emit COMPACTED { messages: ?messages })
      COMPACT -> summarizing when (> (array/len ?messages) @config.keepMessages)
        (set @entity.lastSize (array/len ?messages))
        (set @entity.pendingMessages ?messages)
        (call-service llm summarize {
          text: (str/join (array/map (array/dropLast ?messages @config.keepMessages) (fn item (str/concat @item.role ": " @item.content))) "\n")
        } {
          emit: { failure: ContextSummarizeFailed, success: ContextSummarized }
        })
    }

    state summarizing {
      ContextSummarized -> ready
        (emit COMPACTED {
          messages: (array/prepend (array/takeLast @entity.pendingMessages @config.keepMessages) { role: assistant, content: (str/concat "Earlier in this conversation: " ?summary) })
        })
      ContextSummarizeFailed -> ready
        (emit COMPACTED { messages: (array/takeLast @entity.pendingMessages @config.keepMessages) })
        (render-ui toast {
          message: ?error
          type: alert
          variant: warning
        })
    }

    emits {
      COMPACTED -> external {
        messages : [AgentChatMessage]!
      }
        @description "The conversation, bounded: recent turns verbatim, older turns as one summary note."
        @synonyms "compacted, trimmed, bounded"
        @tier "domain"
      ContextSummarized -> internal {
        summary : string
        keyPoints : [string]
      }
        @tier "internal"
      ContextSummarizeFailed -> internal {
        error : string
      }
        @tier "internal"
    }

    listens {
      COMPACT {
        messages : [AgentChatMessage]!
      }
        @description "Bound this conversation for the model."
    }
  }

  page "/agent-context" as AgentContextPage -> AgentContextCompactor
}
