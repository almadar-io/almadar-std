app std-agent-context [
  version: "2.0.0",
  description: "std-agent-context — keeps what an in-app assistant sends the model bounded. COMPACT { messages } passes a conversation of at most `keepMessages` turns straight through as COMPACTED; a longer one has its older turns summarized with std-llm (LLM_SUMMARIZE) into one leading note and keeps the last `keepMessages` turns verbatim. If summarizing fails, the older turns are dropped and the recent ones still go through, and CONTEXT_NOTICE { message, variant } reports it — a summarizer outage never blocks the assistant. AgentContextCompactor is a headless data trait (server by default, so a boot-mounted composer runs it with no UI); AgentContextView renders CONTEXT_NOTICE as a toast, so a composer that wants the warning composes it. Headless data. Nothing is persisted: the conversation itself lives in std-agent-session.",
  net: { "api.openai.com:443": [tcp] },
]

type AgentChatMessage = {
  role : "user" | "assistant"!
  content : string!
}
type AgentToolScope = {
  scope : "declared"!
  roles : [string]!
  fireAndForget : boolean
}
type AgentToolField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [AgentToolField]
  description : string
}
type AgentToolInput = {
  event : EventAddress!
  roles : [string]!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type AgentToolRead = {
  read : string!
  roles : [string]!
}
type AgentTool = AgentToolScope | AgentToolInput | AgentToolRead
type AgentToolInputData = {
  event : string!
  roles : [string]!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type AgentToolData = AgentToolScope | AgentToolInputData | AgentToolRead

uses Llm from "std/behaviors/std-llm"

uses Req from "std/behaviors/std-http-request"

uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"

orbital AgentContextOrbital {

  entity AgentContextWindow [runtime] {
    id : string!
    pendingMessages : [AgentChatMessage] @description "The conversation being compacted." = []
    lastSize : number @description "Turns in the last conversation compacted." @synonyms "size, length" = 0
    pendingInstructions : string @description "The ephemeral conversation's own instructions, carried through a summarizing." = ""
    pendingTools : [AgentToolData] @description "The ephemeral conversation's own tools, carried through a summarizing." = []
    pendingEphemeral : boolean @description "The conversation being compacted is ephemeral." = false
    pendingHasLive : boolean @description "The conversation being compacted carried a `live` flag, so it is forwarded; absent stays absent." = false
    pendingLive : boolean @description "The `live` flag of the conversation being compacted, carried through a summarizing." = false
  }

  trait ContextSummarizerLlm = Llm.traits.LlmClient {
    listens {
      AgentContextCompactor.LLM_SUMMARIZE -> LLM_SUMMARIZE
      CtxChatRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      CtxChatRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      CtxChatRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      CtxChatHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait CtxChatRequest = Req.traits.HttpRequest {
    listens {
      CtxChatRequestDelay.ELAPSED -> RETRY_ELAPSED
      CtxChatRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      ContextSummarizerLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      ContextSummarizerLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      CtxChatHttp.HTTP_REPLIED -> HTTP_REPLIED
      CtxChatHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait CtxChatRequestDelay = Req.traits.RequestDelay {
    listens {
      CtxChatRequest.RETRY_WAIT -> START
      CtxChatRequest.RETRY_STOP -> CANCEL
    }
  }

  trait CtxChatRequestDeadline = Req.traits.RequestDeadline {
    listens {
      CtxChatRequest.TIMEOUT_START -> START
      CtxChatRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait CtxChatHttpFrame = Frame.traits.HttpFrame {
    listens {
      CtxChatHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait CtxChatHttp = Http.traits.HttpClient {
    config {
      host: "api.openai.com"
      port: 443
      tls: true
      serverName: "api.openai.com"
      credential: "OPENAI_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      CtxChatRequest.HTTP_SEND -> HTTP_SEND
      CtxChatRequest.HTTP_CANCEL -> HTTP_CANCEL
      CtxChatHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      CtxChatHttpFrame.FRAME_DRAINED -> HC_DRAINED
      CtxChatHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait AgentContextCompactor -> AgentContextWindow {
    config {
      keepMessages : number = 12
        @label "Turns kept verbatim"
        @description "The most recent turns sent to the model word for word; older turns are summarized."
        @synonyms "window, history length, context size"
        @tier "policy"
    }
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.lastSize 0)
      COMPACT -> ready when (and (<= (array/len ?messages) @config.keepMessages) (not (object/has ? live)))
        (set @entity.lastSize (array/len ?messages))
        (emit COMPACTED { messages: ?messages, instructions: (default ?instructions ""), tools: (object/get ? tools []), ephemeral: (default ?ephemeral false) })
      COMPACT -> ready when (and (<= (array/len ?messages) @config.keepMessages) (object/has ? live))
        (set @entity.lastSize (array/len ?messages))
        (emit COMPACTED { messages: ?messages, instructions: (default ?instructions ""), tools: (object/get ? tools []), ephemeral: (default ?ephemeral false), live: ?live })
      COMPACT -> summarizing when (> (array/len ?messages) @config.keepMessages)
        (set @entity.lastSize (array/len ?messages))
        (set @entity.pendingMessages ?messages)
        (set @entity.pendingInstructions (default ?instructions ""))
        (set @entity.pendingTools (object/get ? tools []))
        (set @entity.pendingEphemeral (default ?ephemeral false))
        (set @entity.pendingHasLive (object/has ? live))
        (set @entity.pendingLive (default ?live false))
        (emit LLM_SUMMARIZE {
          text: (str/join (array/map (array/dropLast ?messages @config.keepMessages) (fn item (str/concat @item.role ": " @item.content))) "\n")
        })
    }

    state summarizing {
      INIT -> ready
        (set @entity.lastSize 0)
      ContextSummarized -> ready when (not @entity.pendingHasLive)
        (emit COMPACTED {
          messages: (array/prepend (array/takeLast @entity.pendingMessages @config.keepMessages) { role: assistant, content: (str/concat "Earlier in this conversation: " ?summary) })
          instructions: @entity.pendingInstructions
          tools: @entity.pendingTools
          ephemeral: @entity.pendingEphemeral
        })
      ContextSummarized -> ready when @entity.pendingHasLive
        (emit COMPACTED {
          messages: (array/prepend (array/takeLast @entity.pendingMessages @config.keepMessages) { role: assistant, content: (str/concat "Earlier in this conversation: " ?summary) })
          instructions: @entity.pendingInstructions
          tools: @entity.pendingTools
          ephemeral: @entity.pendingEphemeral
          live: @entity.pendingLive
        })
      ContextSummarizeFailed -> ready when (not @entity.pendingHasLive)
        (emit COMPACTED { messages: (array/takeLast @entity.pendingMessages @config.keepMessages), instructions: @entity.pendingInstructions, tools: @entity.pendingTools, ephemeral: @entity.pendingEphemeral })
        (emit CONTEXT_NOTICE { message: ?message, variant: "warning" })
      ContextSummarizeFailed -> ready when @entity.pendingHasLive
        (emit COMPACTED { messages: (array/takeLast @entity.pendingMessages @config.keepMessages), instructions: @entity.pendingInstructions, tools: @entity.pendingTools, ephemeral: @entity.pendingEphemeral, live: @entity.pendingLive })
        (emit CONTEXT_NOTICE { message: ?message, variant: "warning" })
    }

    emits {
      COMPACTED -> external {
        messages : [AgentChatMessage]!
        instructions : string
        tools : [AgentToolData]
        ephemeral : boolean
        live : boolean
      }
        @description "The conversation, bounded: recent turns verbatim, older turns as one summary note. An ephemeral conversation's own `instructions`, `tools`, `ephemeral` flag and `live` flag (only when it was given) pass through untouched."
        @synonyms "compacted, trimmed, bounded"
        @tier "domain"
      LLM_SUMMARIZE -> external {
        text : string!
      }
        @description "Ask std-llm to summarize the older turns."
        @tier "internal"
      CONTEXT_NOTICE -> external {
        message : string
        variant : "warning"
      }
        @description "The older turns could not be summarized and were dropped; the recent turns still went through. AgentContextView shows it as a toast."
        @tier "internal"
    }

    listens {
      ContextSummarizerLlm.LLM_SUMMARIZE_RESULT -> ContextSummarized
      ContextSummarizerLlm.LLM_FAILED -> ContextSummarizeFailed
      ContextSummarized {
        summary : string!
        keyPoints : [string]!
      }
      ContextSummarizeFailed {
        code : string
        message : string!
      }
      COMPACT {
        messages : [AgentChatMessage]!
        instructions : string
        tools : [AgentToolData]
        ephemeral : boolean
        live : boolean
      }
        @description "Bound this conversation for the model. An ephemeral conversation's own `instructions`, `tools`, `ephemeral` flag and, when given, `live` flag ride along."
    }
  }

  trait AgentContextView -> @rebindable AgentContextWindow [client] {
    initial: ready

    state ready {
      INIT -> ready
      CONTEXT_NOTICE -> ready
        (render-ui toast {
          message: ?message
          type: alert
          variant: ?variant
        })
    }

    listens {
      AgentContextCompactor.CONTEXT_NOTICE -> CONTEXT_NOTICE
      CONTEXT_NOTICE {
        message : string
        variant : "warning"
      }
    }
  }

  page "/agent-context" as AgentContextPage -> AgentContextCompactor, AgentContextView, ContextSummarizerLlm, CtxChatRequest, CtxChatRequestDelay, CtxChatRequestDeadline, CtxChatHttp, CtxChatHttpFrame
}
