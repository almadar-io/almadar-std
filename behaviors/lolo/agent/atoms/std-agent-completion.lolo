app std-agent-completion [
  version: "1.0.0",
  description: "Takes a prompt, returns generated text through std-llm (LLM_GENERATE).",
  net: { "api.openai.com:443": [tcp] },
]

uses Spec from "almadar-std/completion"
uses Llm from "std/behaviors/std-llm"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"

orbital AgentCompletionOrbital {

  entity Completion [runtime] {
    prompt : string = ""
    response : string = ""
    status : "idle" | "done" = idle
  }

  trait CompletionLlm = Llm.traits.LlmClient {
    listens {
      CompletionGeneration.LLM_GENERATE -> LLM_GENERATE
      CompletionChatRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      CompletionChatRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      CompletionChatRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      CompletionChatHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait CompletionChatRequest = Req.traits.HttpRequest {
    listens {
      CompletionLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      CompletionLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      CompletionChatHttp.HTTP_REPLIED -> HTTP_REPLIED
      CompletionChatHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait CompletionChatHttp = Http.traits.HttpClient {
    config {
      host: "api.openai.com"
      port: 443
      tls: true
      serverName: "api.openai.com"
      credential: "OPENAI_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      CompletionChatRequest.HTTP_SEND -> HTTP_SEND
      CompletionChatRequest.HTTP_CANCEL -> HTTP_CANCEL
    }
  }

  trait CompletionGeneration -> Completion [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.response "")
        (set @entity.status idle)
      GENERATE -> generating
        (set @entity.prompt ?prompt)
        (emit LLM_GENERATE { userPrompt: @entity.prompt })
    }

    state generating {
      INIT -> idle
        (set @entity.prompt "")
        (set @entity.response "")
        (set @entity.status idle)
      GENERATED -> done
        (set @entity.response ?content)
        (set @entity.status done)
        (emit COMPLETED { response: @entity.response })
      GENERATION_FAILED -> done
        (set @entity.response "")
        (set @entity.status done)
    }

    state done {
      INIT -> done
        (set @entity.status done)
      RESET -> idle
        (set @entity.response "")
        (set @entity.prompt "")
        (set @entity.status idle)
    }

    emits {
      COMPLETED {
        response : string!
      }
      LLM_GENERATE -> external {
        userPrompt : string!
      }
        @description "Ask std-llm to generate text from the prompt"
        @tier "secondary"
    }

    listens {
      CompletionLlm.LLM_GENERATE_RESULT -> GENERATED
      CompletionLlm.LLM_FAILED -> GENERATION_FAILED
      GENERATED {
        content : string!
      }
      GENERATION_FAILED {
        code : string
        message : string!
      }
      GENERATE {
        prompt : string!
      }
    }
  }

  trait CompletionReady -> Completion [client] {
    initial: waiting

    state waiting {
      INIT -> waiting
        (set @entity.status idle)
      COMPLETED -> ready
        (set @entity.status done)
    }

    state ready {
      INIT -> ready
        (set @entity.status done)
      RESET -> waiting
        (set @entity.status idle)
    }

    listens {
      CompletionGeneration.COMPLETED -> COMPLETED
      RESET
    }
  }

  page boot as AgentCompletionPage -> CompletionGeneration, CompletionReady, CompletionLlm, CompletionChatRequest, CompletionChatHttp
}
