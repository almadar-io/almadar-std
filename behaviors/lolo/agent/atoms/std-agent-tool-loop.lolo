app std-agent-tool-loop [
  version: "3.0.0",
  description: "std-agent-tool-loop — answers a conversation by operating the running app as the caller, through std-llm's tool loop. Its `tools` are `{ scope: declared }` (every declared external input plus a read over every persisted entity that declares who reads it (`@read`, or an `@read none` waiver)), or named declared inputs (addressed like a listens source: `Trait.EVENT`, `Orbital.Trait.EVENT`, optionally with the `payload` the model is shown and held to) and entities to read. The program reflects its own inputs (`program/inputs`); each tool call the model makes fires as the signed-in user through the ordinary dispatch (`program/dispatch`: guards, grants and entity policies apply) and each read returns only the rows the caller may read (`persist/read-named`); a refused or unknown tool is answered to the model as an explicit refusal. Headless: the conversation UI (std-agent-session) shows the reply; a failure is emitted as ASSISTANT_REPLY_FAILED for the embedder to present (`quiet` is for a background run nobody is watching: no live steps; an ephemeral turn runs under its own instructions and tools and streams no steps unless its CONVERSE carries `live`, which decides for any turn). CONVERSE carries the conversation (and optionally what std-agent-memory recalled); ASSISTANT_STEP carries each step live while it works (a model call, a tool it used, what the app answered) to the asking tab; ASSISTANT_REPLIED carries the reply, every step and the token usage; ASSISTANT_REPLY_FAILED carries the error. These names are the assistant contract std-agent-session's conversation hears from any orbital. The model side is a std-llm LlmClient trait that listens to the loop's LLM_CALL_TOOLS and LLM_TOOLS_ANSWERED and is heard through LLM_TOOLS_REQUESTED, LLM_TOOLS_STEP, LLM_CALL_TOOLS_RESULT and LLM_FAILED; a composer wires its own. CANCEL aborts the model call at its provider (std-llm's LLM_CANCEL, under the key `agent-tool-loop`) and stops any tool call not yet started; nothing is replied and no failure is reported, and a new CONVERSE is refused until std-llm confirms the cancel (LLM_CANCELLED). Compose with std-agent-session (the conversation) and std-agent-trace (the step record).",
  net: { "api.openai.com:443": [tcp] },
]

type AgentToolScope = {
  scope : "declared"!
  roles : [string]!
  fireAndForget : boolean
}
type AgentToolField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [AgentToolField]
  description : string
}
type AgentToolInput = {
  event : EventAddress!
  roles : [string]!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type AgentToolRead = {
  read : string!
  roles : [string]!
}
type AgentTool = AgentToolScope | AgentToolInput | AgentToolRead
type AgentToolInputData = {
  event : string!
  roles : [string]!
  payload : [AgentToolField]
  fireAndForget : boolean
}
type AgentToolData = AgentToolScope | AgentToolInputData | AgentToolRead
type AgentChatMessage = {
  role : "user" | "assistant"!
  content : string!
}
type AgentToolKind = "input" | "read" | "invalid"
type AgentToolCallActivity = {
  type : "tool_call"!
  tool : string!
  kind : AgentToolKind
  argsText : string!
  timestamp : instant!
  isExecuting : boolean
}
type AgentToolResultActivity = {
  type : "tool_result"!
  tool : string!
  kind : AgentToolKind
  success : boolean!
  detail : string
  rows : number
  resultText : string!
  timestamp : instant!
}
type AgentLlmCall = {
  service : string!
  provider : string!
  model : string!
  systemPrompt : string!
  userPrompt : string!
  toolCallsJson : string
  attempt : number
  durationMs : number!
  promptTokens : number
  completionTokens : number
  cachedPromptTokens : number
  costUSD : number
}
type AgentLlmResponseActivity = {
  type : "llm_response"!
  content : string!
  llm : AgentLlmCall
  timestamp : instant!
}
type AgentActivity = AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity
type AgentUsage = {
  promptTokens : number!
  completionTokens : number!
  totalTokens : number!
  modelCalls : number!
}
type LlmSchema = { type : string, additionalProperties : boolean, properties : Map string LlmSchema, required : [string], enum : [string], items : LlmSchema }
type LlmToolDef = { name : string!, description : string!, parameters : LlmSchema! }
type LlmToolOutcome = { id : string!, tool : string!, kind : "input" | "read" | "invalid"!, success : boolean!, detail : string, rows : number, content : string!, startedAt : instant!, endedAt : instant! }
type AgentToolBinding = {
  name : string!
  description : string!
  parameters : LlmSchema!
  label : string!
  kind : "input" | "read"!
  address : string
  entity : string
  readAny : boolean!
  contract : [AgentToolField]
  contracted : boolean!
  fireAndForget : boolean!
}
type AgentReflectedInput = {
  orbital : string!
  trait : string!
  event : string!
  address : string!
  description : string
  parameters : LlmSchema!
}
type AgentReflection = {
  inputs : [AgentReflectedInput]!
  entities : [string]!
  selected : [AgentReflectedInput]!
}
type AgentDispatchAnswer = {
  ok : boolean!
  error : string
}
type AgentReadAnswer = {
  entity : string!
  count : number!
}
type AgentPortIssue = {
  code : string!
  message : string!
}
type AgentReadArguments = {
  entity : string
}

uses Spec from "almadar-std/tool-loop"
uses Llm from "std/behaviors/std-llm"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Identity from "std/behaviors/std-agent-identity"

type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type ToolArguments = Map string JsonValue
type ToolCall = { id : string!, name : string!, arguments : ToolArguments }
orbital AgentToolLoopOrbital {
  entity AgentTurn [runtime] {
    id : string!
    status : "idle" | "thinking" | "answered" | "failed" @description "Where the current turn is." = idle
    reply : string @description "The last reply." = ""
    error : string @description "Why the last turn failed." = ""
    ephemeral : boolean @description "The current turn belongs to an ephemeral conversation." = false
    live : boolean @description "The current turn streams its steps to the asking tab." = false
    cancelled : boolean @description "The current turn was cancelled while the model was answering: its late outcome is dropped." = false
    turnMessages : [AgentChatMessage] @description "The conversation being answered." = []
    turnInstructions : string @description "The instructions sent with the current turn." = ""
    turnTools : [AgentToolData] @description "The tools the current turn may use." = []
    table : [AgentToolBinding] @description "The tools offered to the model, by name." = []
    session : string @description "The model's tool run the calls being executed belong to." = ""
    calls : [ToolCall] @description "The tool calls the model asked for." = []
    cursor : number @description "The call being executed." = 0
    results : [LlmToolOutcome] @description "What the calls answered so far." = []
    current : ToolCall @description "The call being executed."
    binding : AgentToolBinding @description "The tool the call being executed names."
    callStartedAt : instant @description "When the call being executed began."
    turnSteps : [AgentActivity] @description "Every step of the current turn so far, kept so a failed run can be audited." = []
    pendingTools : [AgentToolData] @description "The tools the current turn names, held while the assistant's own identity signs in (caller identity)." = []
  }

  trait LoopLlm = Llm.traits.LlmClient {
    listens {
      AgentToolLoop.LLM_CALL_TOOLS -> LLM_CALL_TOOLS
      AgentToolLoop.LLM_TOOLS_ANSWERED -> LLM_TOOLS_ANSWERED
      AgentToolLoop.LLM_CANCEL -> LLM_CANCEL
      LoopChatRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      LoopChatRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      LoopChatRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      LoopChatHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait LoopChatRequest = Req.traits.HttpRequest {
    listens {
      LoopChatRequestDelay.ELAPSED -> RETRY_ELAPSED
      LoopChatRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      LoopLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      LoopLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      LoopChatHttp.HTTP_REPLIED -> HTTP_REPLIED
      LoopChatHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait LoopChatRequestDelay = Req.traits.RequestDelay {
    listens {
      LoopChatRequest.RETRY_WAIT -> START
      LoopChatRequest.RETRY_STOP -> CANCEL
    }
  }

  trait LoopChatRequestDeadline = Req.traits.RequestDeadline {
    listens {
      LoopChatRequest.TIMEOUT_START -> START
      LoopChatRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait LoopChatHttpFrame = Frame.traits.HttpFrame {
    listens {
      LoopChatHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait LoopChatHttp = Http.traits.HttpClient {
    config {
      host: "api.openai.com"
      port: 443
      tls: true
      serverName: "api.openai.com"
      credential: "OPENAI_API_KEY"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      LoopChatRequest.HTTP_SEND -> HTTP_SEND
      LoopChatRequest.HTTP_CANCEL -> HTTP_CANCEL
      LoopChatHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      LoopChatHttpFrame.FRAME_DRAINED -> HC_DRAINED
      LoopChatHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait LoopIdentity = Identity.traits.AgentIdentity {
    config {
      ownOrbital: "AgentToolLoopOrbital"
      ownTrait: "LoopIdentity"
    }
    listens {
      AgentToolLoop.AGENT_IDENTITY_REQUESTED -> AGENT_IDENTITY_REQUESTED
      AgentToolLoop.AGENT_ACT -> AGENT_ACT
      AgentToolLoop.AGENT_LOOK -> AGENT_LOOK
    }
  }

  trait AgentToolLoop -> AgentTurn [optimistic] {
    config {
      tools : [AgentTool] = []
        @label "What may the assistant do?"
        @description "The declared inputs it may fire (`{ event: Trait.EVENT }`, optionally with the `payload` the model is shown and held to) and the entities it may read (`{ read: Entity }`), as the signed-in user."
        @synonyms "allowlist, abilities, actions, permissions"
        @tier "domain"
      instructions : string = "You operate this app for the signed-in user. Use the tools to act and to look things up; when a tool reports that something was refused or denied, say so plainly."
        @label "How should the assistant behave?"
        @description "Standing instructions sent with every conversation."
        @synonyms "system prompt, persona, guidance"
        @tier "domain"
      maxSteps : number = 8
        @label "Model round-trips per request"
        @description "How many model calls one request may take before it fails."
        @tier "policy"
      caller : "user" | "process" | "identity" = user
        @label "Whose tools are these?"
        @description "user: each tool is offered only to a signed-in user whose role it lists, and runs as that user. process: the tools are the running program's own, offered with no signed-in user and no role filter, for a command-line or headless run that its composer declares. identity: the assistant is its own row of the app's identity entity (std-agent-identity, wired to this loop); each tool is offered only when it lists that row's role, and every call and read runs as that identity, never as the person asking. A tool is then answered with what its dispatch emitted, not awaited through TOOL_RESULT."
        @synonyms "headless, command line, no user, unattended, service account, support agent, acts as"
        @tier "policy"
      quiet : boolean = false
        @label "Run in the background?"
        @description "No live ASSISTANT_STEP stream: the request is reported only through ASSISTANT_REPLIED and ASSISTANT_REPLY_FAILED. For a run nobody is watching, such as one the app starts on its own."
        @synonyms "silent, background, no toast, suppress errors, headless run"
        @tier "policy"
    }
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.status idle)
      CONVERSE -> preparing when (and (!= @config.caller "identity") (not (default ?ephemeral false)))
        (set @entity.status thinking)
        (set @entity.ephemeral false)
        (set @entity.cancelled false)
        (set @entity.turnSteps [])
        (set @entity.live (object/get ? live (not @config.quiet)))
        (set @entity.turnMessages ?messages)
        (set @entity.turnInstructions (if (= (default ?context "") "") @config.instructions (str/concat @config.instructions "\n\nWhat you remember that may be relevant:\n" (default ?context ""))))
        (set @entity.turnTools (let ((all : [AgentTool] @config.tools)) (array/filter @all (fn t (or (= @config.caller "process") (and (not (= @user null)) (array/includes @t.roles (default @user.role ""))))))))
        (program/inputs { select: (array/flatten (array/map @entity.turnTools (fn t (if (object/has @t scope) [] (if (object/has @t read) [] (let ((ev : AgentToolInputData @t)) [(if (object/has @ev payload) { event: @ev.event, payload: @ev.payload } { event: @ev.event })])))))) } { emit: { success: INPUTS_KNOWN, failure: INPUTS_FAILED } })
      CONVERSE -> preparing when (and (!= @config.caller "identity") (default ?ephemeral false))
        (set @entity.status thinking)
        (set @entity.ephemeral true)
        (set @entity.cancelled false)
        (set @entity.turnSteps [])
        (set @entity.live (object/get ? live false))
        (set @entity.turnMessages ?messages)
        (set @entity.turnInstructions (if (= (default ?instructions "") "") @config.instructions ?instructions))
        (set @entity.turnTools (array/filter (object/get ? tools []) (fn t (or (= @config.caller "process") (and (not (= @user null)) (array/includes @t.roles (default @user.role "")))))))
        (program/inputs { select: (array/flatten (array/map @entity.turnTools (fn t (if (object/has @t scope) [] (if (object/has @t read) [] (let ((ev : AgentToolInputData @t)) [(if (object/has @ev payload) { event: @ev.event, payload: @ev.payload } { event: @ev.event })])))))) } { emit: { success: INPUTS_KNOWN, failure: INPUTS_FAILED } })
      CONVERSE -> preparing when (and (= @config.caller "identity") (not (default ?ephemeral false)))
        (set @entity.status thinking)
        (set @entity.ephemeral false)
        (set @entity.cancelled false)
        (set @entity.turnSteps [])
        (set @entity.live (object/get ? live (not @config.quiet)))
        (set @entity.turnMessages ?messages)
        (set @entity.turnInstructions (if (= (default ?context "") "") @config.instructions (str/concat @config.instructions "\n\nWhat you remember that may be relevant:\n" (default ?context ""))))
        (set @entity.turnTools [])
        (set @entity.pendingTools (let ((all : [AgentTool] @config.tools)) @all))
        (emit AGENT_IDENTITY_REQUESTED {})
      CONVERSE -> preparing when (and (= @config.caller "identity") (default ?ephemeral false))
        (set @entity.status thinking)
        (set @entity.ephemeral true)
        (set @entity.cancelled false)
        (set @entity.turnSteps [])
        (set @entity.live (object/get ? live false))
        (set @entity.turnMessages ?messages)
        (set @entity.turnInstructions (if (= (default ?instructions "") "") @config.instructions ?instructions))
        (set @entity.turnTools [])
        (set @entity.pendingTools (object/get ? tools []))
        (emit AGENT_IDENTITY_REQUESTED {})
    }

    state preparing {
      INIT -> idle
        (set @entity.status idle)
      CANCEL -> idle
        (set @entity.status idle)
      AgentIdentityReady -> preparing
        (set @entity.turnTools (array/filter @entity.pendingTools (fn t (array/includes @t.roles ?role))))
        (program/inputs { select: (array/flatten (array/map (array/filter @entity.pendingTools (fn t (array/includes @t.roles ?role))) (fn t (if (object/has @t scope) [] (if (object/has @t read) [] (let ((ev : AgentToolInputData @t)) [(if (object/has @ev payload) { event: @ev.event, payload: @ev.payload } { event: @ev.event })])))))) } { emit: { success: INPUTS_KNOWN, failure: INPUTS_FAILED } })
      AgentIdentityRefused -> idle
        (set @entity.status failed)
        (set @entity.pendingTools [])
        (set @entity.error (str/concat "The assistant's own identity could not sign in: " ?reason))
        (emit ASSISTANT_REPLY_FAILED { error: (str/concat "The assistant's own identity could not sign in: " ?reason), ephemeral: @entity.ephemeral })
      INPUTS_KNOWN -> thinking when (= (array/len @payload.result.selected) (array/count @entity.turnTools (fn y (object/has @y event))))
        (let ((table : [AgentToolBinding] (array/flatten (array/flatten (array/map (array/range 0 (array/len @entity.turnTools) 1) (fn i
            (array/map (array/take (array/drop @entity.turnTools @i) 1) (fn t
              (let ((r : [AgentToolBinding] (if (object/has @t scope)
                (array/concat
                  (array/map @payload.result.inputs (fn x
                    { name: (str/concat @x.event "_" (+ (array/findIndex @payload.result.inputs (fn z (= @z.address @x.address))) 1)), description: (str/concat (default @x.description @x.event) " (" @x.orbital " → " @x.trait ")"), parameters: @x.parameters, label: @x.address, kind: input, address: @x.address, readAny: false, contracted: false, fireAndForget: (object/get @t fireAndForget false) }))
                  (if (> (array/len @payload.result.entities) 0)
                    [{ name: "read", description: "Read the rows of an entity that you may see", parameters: { type: "object", properties: { entity: { type: "string", enum: @payload.result.entities } }, required: ["entity"] }, label: "read", kind: read, readAny: true, contracted: false, fireAndForget: false }]
                    []))
                (if (object/has @t read)
                  (let ((rd : AgentToolRead @t)) [{ name: (str/concat "read__" @rd.read), description: (str/concat "Read the " @rd.read " rows you may see"), parameters: { type: "object", properties: {} }, label: @rd.read, kind: read, entity: @rd.read, readAny: false, contracted: false, fireAndForget: false }])
                  (let ((ev : AgentToolInputData @t)) (array/map (array/take (array/drop @payload.result.selected (array/count (array/take @entity.turnTools @i) (fn y (object/has @y event)))) 1) (fn s
                    { name: (str/replaceAll @ev.event "." "__"), description: (default @s.description @ev.event), parameters: @s.parameters, label: @ev.event, kind: input, address: @s.address, contract: (object/get @ev payload []), readAny: false, contracted: (object/has @ev payload), fireAndForget: (object/get @ev fireAndForget false) }))))))) @r)))))))))
          (do
            (set @entity.table @table)
            (emit LLM_CALL_TOOLS {
              messages: @entity.turnMessages
              tools: (array/map @table (fn b { name: @b.name, description: @b.description, parameters: @b.parameters }))
              instructions: @entity.turnInstructions
              maxSteps: @config.maxSteps
              key: "agent-tool-loop"
            })))
      INPUTS_KNOWN -> idle when (!= (array/len @payload.result.selected) (array/count @entity.turnTools (fn y (object/has @y event))))
        (set @entity.status failed)
        (set @entity.error "The app reflected a different number of inputs than the assistant's tools name.")
        (emit ASSISTANT_REPLY_FAILED { error: "The app reflected a different number of inputs than the assistant's tools name.", ephemeral: @entity.ephemeral })
      INPUTS_FAILED -> idle
        (set @entity.status failed)
        (set @entity.error ?error)
        (emit ASSISTANT_REPLY_FAILED { error: ?error, ephemeral: @entity.ephemeral })
    }

    state thinking {
      INIT -> idle
        (set @entity.status idle)
      CANCEL -> thinking
        (set @entity.cancelled true)
        (set @entity.status idle)
        (emit LLM_CANCEL { key: "agent-tool-loop" })
      ToolsCancelled -> idle when (and @entity.cancelled (= ?key "agent-tool-loop"))
        (set @entity.cancelled false)
      CONVERSE -> thinking when @entity.cancelled
        (emit ASSISTANT_REPLY_FAILED { error: "The previous request is still being cancelled; ask again in a moment.", ephemeral: (default ?ephemeral false) })
      ToolsStep -> thinking when (and @entity.live (not @entity.cancelled))
        (set @entity.turnSteps (array/append @entity.turnSteps ?activity))
        (emit ASSISTANT_STEP { activity: ?activity })
      ToolsStep -> thinking when (or (not @entity.live) @entity.cancelled)
        (set @entity.turnSteps (array/append @entity.turnSteps ?activity))
      ToolsRequested -> running when (not @entity.cancelled)
        (set @entity.session ?session)
        (set @entity.calls ?calls)
        (set @entity.cursor 0)
        (set @entity.results [])
        (emit RUN_NEXT {})
      ToolsRequested -> idle when @entity.cancelled
        (set @entity.cancelled false)
      ToolsReplied -> idle when (not @entity.cancelled)
        (set @entity.status answered)
        (set @entity.reply ?reply)
        (emit ASSISTANT_REPLIED { reply: ?reply, steps: ?steps, usage: ?usage, ephemeral: @entity.ephemeral })
      ToolsReplied -> idle when @entity.cancelled
        (set @entity.cancelled false)
      ToolsFailed -> idle when @entity.cancelled
        (set @entity.cancelled false)
      ToolsFailed -> idle when (not @entity.cancelled)
        (set @entity.status failed)
        (set @entity.error ?message)
        (emit ASSISTANT_REPLY_FAILED { error: ?message, steps: @entity.turnSteps, ephemeral: @entity.ephemeral })
    }

    state running {
      INIT -> idle
        (set @entity.status idle)
      CANCEL -> idle
        (set @entity.status idle)
      RUN_NEXT -> thinking when (>= @entity.cursor (array/len @entity.calls))
        (emit LLM_TOOLS_ANSWERED { session: @entity.session, results: @entity.results })
      RUN_NEXT -> running when (< @entity.cursor (array/len @entity.calls))
        (set @entity.current (default (if (>= @entity.cursor 0) (array/nth @entity.calls @entity.cursor) null) { id: "", name: "" }))
        (set @entity.callStartedAt (time/now))
        (emit CALL_BEGIN {})
      CALL_BEGIN -> running when (= (array/count @entity.table (fn x (= @x.name @entity.current.name))) 0)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.current.name, kind: invalid, success: false, detail: "not an allowed tool", content: (json/stringify { error: (str/concat "'" (default @entity.current.name "") "' is not one of your tools"), tools: (array/map @entity.table (fn x @x.name)) }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @b null) (or (= @b.kind "input") @b.readAny) (= @entity.current.arguments null)))
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.current.name, kind: invalid, success: false, detail: "arguments are not a JSON object", content: (json/stringify { error: (str/concat "'" (default @entity.current.name "") "' arguments are not a JSON object") }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @config.caller "identity") (!= @b null) (= @b.kind "input") (not @b.contracted) @b.fireAndForget))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (program/dispatch @b.address @entity.current.arguments { key: (str/concat "tool-call:" @entity.current.id), emit: { success: DISPATCHED, failure: DISPATCH_FAILED } })))
      CALL_BEGIN -> awaitingResult when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @config.caller "identity") (!= @b null) (= @b.kind "input") (not @b.contracted) (not @b.fireAndForget)))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (emit TOOL_PENDING { callId: @entity.current.id, tool: @b.label })
            (program/dispatch @b.address @entity.current.arguments { key: (str/concat "tool-call:" @entity.current.id), emit: { success: AWAIT_DISPATCHED, failure: AWAIT_DISPATCH_FAILED } })))
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @config.caller "identity") (!= @b null) (= @b.kind "input") @b.contracted @b.fireAndForget))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (program/dispatch @b.address @entity.current.arguments { schema: @b.contract } { key: (str/concat "tool-call:" @entity.current.id), emit: { success: DISPATCHED, failure: DISPATCH_FAILED } })))
      CALL_BEGIN -> awaitingResult when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @config.caller "identity") (!= @b null) (= @b.kind "input") @b.contracted (not @b.fireAndForget)))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (emit TOOL_PENDING { callId: @entity.current.id, tool: @b.label })
            (program/dispatch @b.address @entity.current.arguments { schema: @b.contract } { key: (str/concat "tool-call:" @entity.current.id), emit: { success: AWAIT_DISPATCHED, failure: AWAIT_DISPATCH_FAILED } })))
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @config.caller "identity") (!= @b null) (= @b.kind "read") (not @b.readAny)))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (persist/read-named @b.entity { emit: { success: READ_DONE, failure: READ_FAILED } })))
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (!= @config.caller "identity") (!= @b null) (= @b.kind "read") @b.readAny))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (persist/read-named (object/get (default (as @entity.current.arguments AgentReadArguments) {}) entity "") { emit: { success: READ_DONE, failure: READ_FAILED } })))
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (= @config.caller "identity") (!= @b null) (= @b.kind "input") (!= @entity.current.arguments null)))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (emit AGENT_ACT { callId: @entity.current.id, address: (default @b.address ""), arguments: (default @entity.current.arguments {}), contract: (object/get @b contract []), contracted: @b.contracted })))
      CALL_BEGIN -> running when (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name))))) (and (= @config.caller "identity") (!= @b null) (= @b.kind "read") (or (not @b.readAny) (!= @entity.current.arguments null))))
        (let ((b (array/find @entity.table (fn x (= @x.name @entity.current.name)))))
          (do
            (set @entity.binding @b)
            (emit AGENT_LOOK { callId: @entity.current.id, entity: (if @b.readAny (object/get (default (as @entity.current.arguments AgentReadArguments) {}) entity "") @b.entity) })))
      AgentActed -> running when (and (= ?callId @entity.current.id) ?ok)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: true, content: ?content, startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      AgentActed -> running when (and (= ?callId @entity.current.id) (not ?ok))
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: (if (= (default ?error "") "") "dispatch failed" ?error), content: ?content, startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      AgentActFailed -> running when (= ?callId @entity.current.id)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: ?error, content: (json/stringify { ok: false, error: ?error }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      AgentLooked -> running when (= ?callId @entity.current.id)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: ?entity, kind: read, success: true, rows: ?count, content: ?content, startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      AgentLookFailed -> running when (and (= ?callId @entity.current.id) (default ?unknown false))
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: read, success: false, detail: "not a readable entity", content: (json/stringify { error: "not an entity you can read" }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      AgentLookFailed -> running when (and (= ?callId @entity.current.id) (not (default ?unknown false)))
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: read, success: false, detail: ?error, content: (json/stringify { error: ?error }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      DISPATCHED -> running when @payload.result.ok
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: true, content: (json/stringify ?result), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      DISPATCHED -> running when (not @payload.result.ok)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: (default @payload.result.error "dispatch failed"), content: (json/stringify ?result), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      DISPATCH_FAILED -> running
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: ?error, content: (json/stringify { ok: false, error: ?error }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      READ_DONE -> running
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @payload.result.entity, kind: read, success: true, rows: @payload.result.count, content: (json/stringify ?result), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      READ_FAILED -> running when (> (array/count (default ?errors []) (fn e (= @e.code "unknown-entity"))) 0)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: read, success: false, detail: "not a readable entity", content: (json/stringify { error: "not an entity you can read" }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      READ_FAILED -> running when (= (array/count (default ?errors []) (fn e (= @e.code "unknown-entity"))) 0)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: read, success: false, detail: ?error, content: (json/stringify { error: ?error }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
    }

    state awaitingResult {
      INIT -> idle
        (set @entity.status idle)
      CANCEL -> idle
        (set @entity.status idle)
      AWAIT_DISPATCHED -> awaitingResult when @payload.result.ok
      AWAIT_DISPATCHED -> running when (not @payload.result.ok)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: (default @payload.result.error "dispatch failed"), content: (json/stringify ?result), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      AWAIT_DISPATCH_FAILED -> running
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: ?error, content: (json/stringify { ok: false, error: ?error }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      TOOL_RESULT -> running when (= ?callId @entity.current.id)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: true, content: ?result, startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
      TOOL_FAILED -> running when (= ?callId @entity.current.id)
        (set @entity.results (array/append @entity.results { id: @entity.current.id, tool: @entity.binding.label, kind: input, success: false, detail: ?error, content: (json/stringify { ok: false, error: ?error }), startedAt: @entity.callStartedAt, endedAt: (time/now) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit RUN_NEXT {})
    }

    emits {
      ASSISTANT_STEP -> external {
        activity : AgentActivity!
      }
        @description "One thing the assistant just did, live while it works: a model call, a tool it used, or what the app answered. Delivered to the asking tab only."
        @synonyms "progress, activity, trace step, working"
        @tier "domain"
      ASSISTANT_REPLIED -> external {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
        ephemeral : boolean
      }
        @description "The assistant answered; carries every tool step it took and the tokens it used. `ephemeral` echoes the conversation's: an ephemeral reply is not stored or remembered, and only an ephemeral conversation shows it."
        @synonyms "answered, responded, done"
        @tier "domain"
      ASSISTANT_REPLY_FAILED -> external {
        error : string!
        steps : [AgentActivity]
        ephemeral : boolean
      }
        @description "The assistant could not answer (model unavailable, or out of steps)."
        @synonyms "failed, error, gave up"
        @tier "domain"
      LLM_CALL_TOOLS -> external {
        messages : [AgentChatMessage]!
        tools : [LlmToolDef]!
        instructions : string
        maxSteps : number
        key : string
      }
        @description "Ask std-llm to run the model's tool loop for this conversation, under the key LLM_CANCEL aborts it by."
        @tier "internal"
      LLM_TOOLS_ANSWERED -> external {
        session : string!
        results : [LlmToolOutcome]!
      }
        @description "Answer std-llm's tool calls with what each one came to."
        @tier "internal"
      LLM_CANCEL -> external {
        key : string!
      }
        @description "Ask std-llm to abort the model call of a cancelled run."
        @tier "internal"
      TOOL_PENDING -> external {
        callId : string!
        tool : string!
      }
        @description "The loop dispatched a tool that waits for its outcome: this is the call id the tool answers with TOOL_RESULT or TOOL_FAILED."
        @tier "domain"
      AGENT_IDENTITY_REQUESTED -> external {
      }
        @description "Ask std-agent-identity to sign the assistant's own identity in and answer its role (caller identity)."
        @tier "internal"
      AGENT_ACT -> external {
        callId : string!
        address : string!
        arguments : Map string JsonValue
        contract : [AgentToolField]
        contracted : boolean!
      }
        @description "Ask std-agent-identity to fire a declared input as the assistant's own identity."
        @tier "internal"
      AGENT_LOOK -> external {
        callId : string!
        entity : string!
      }
        @description "Ask std-agent-identity to read an entity as the assistant's own identity."
        @tier "internal"
      AWAIT_DISPATCHED {
        result : AgentDispatchAnswer!
      }
      AWAIT_DISPATCH_FAILED {
        error : string!
        errors : [AgentPortIssue]
      }
      INPUTS_KNOWN {
        result : AgentReflection!
      }
      INPUTS_FAILED {
        error : string!
      }
      RUN_NEXT
      CALL_BEGIN
      DISPATCHED {
        result : AgentDispatchAnswer!
      }
      DISPATCH_FAILED {
        error : string!
        errors : [AgentPortIssue]
      }
      READ_DONE {
        result : AgentReadAnswer!
      }
      READ_FAILED {
        error : string!
        errors : [AgentPortIssue]
      }
    }

    listens {
      TOOL_RESULT {
        callId : string!
        result : string!
      }
        @description "A dispatched tool's outcome: `result` goes back to the model as the tool message for `callId` before its next turn."
        @synonyms "tool output, tool answer"
      TOOL_FAILED {
        callId : string!
        error : string!
      }
        @description "A dispatched tool failed: `error` goes back to the model as the failed tool message for `callId`."
        @synonyms "tool error"
      CANCEL {
      }
        @description "Abort the request in flight; nothing is replied and no failure is reported."
        @synonyms "stop, abort, cancel"
      CONVERSE {
        messages : [AgentChatMessage]!
        context : string
        instructions : string
        tools : [AgentToolData]
        ephemeral : boolean
        live : boolean
      }
        @description "Answer this conversation; the last turn is the request. `context` is what the assistant remembers that may be relevant. An `ephemeral` conversation runs under its own `instructions` (empty: the configured ones) and exactly its own `tools` (absent or `[]`: none, never the configured ones), by default streams no live steps and shows no failure toast. `live`, when present, decides whether this turn streams ASSISTANT_STEP to the asking tab, whatever `ephemeral` is; absent, an ephemeral turn does not stream and any other turn streams unless `quiet`."
        @synonyms "ask, chat, request"
      LoopLlm.LLM_TOOLS_REQUESTED -> ToolsRequested
      LoopLlm.LLM_TOOLS_STEP -> ToolsStep
      LoopLlm.LLM_CALL_TOOLS_RESULT -> ToolsReplied
      LoopLlm.LLM_FAILED -> ToolsFailed
      LoopLlm.LLM_CANCELLED -> ToolsCancelled
      LoopIdentity.AGENT_IDENTITY_READY -> AgentIdentityReady
      LoopIdentity.AGENT_IDENTITY_REFUSED -> AgentIdentityRefused
      LoopIdentity.AGENT_ACTED -> AgentActed
      LoopIdentity.AGENT_ACT_FAILED -> AgentActFailed
      LoopIdentity.AGENT_LOOKED -> AgentLooked
      LoopIdentity.AGENT_LOOK_FAILED -> AgentLookFailed
      AgentIdentityReady {
        subject : string!
        role : string!
      }
      AgentIdentityRefused {
        reason : string!
      }
      AgentActed {
        callId : string!
        ok : boolean!
        error : string
        content : string!
      }
      AgentActFailed {
        callId : string!
        error : string!
      }
      AgentLooked {
        callId : string!
        entity : string!
        count : number!
        content : string!
      }
      AgentLookFailed {
        callId : string!
        error : string!
        unknown : boolean
      }
      ToolsRequested {
        session : string!
        calls : [ToolCall]!
      }
      ToolsStep {
        activity : AgentActivity!
      }
      ToolsReplied {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
      }
      ToolsFailed {
        code : string
        message : string!
      }
      ToolsCancelled {
        key : string!
      }
    }
  }

  page boot as AgentToolLoopPage -> AgentToolLoop, LoopLlm, LoopChatRequest, LoopChatRequestDelay, LoopChatRequestDeadline, LoopChatHttp, LoopChatHttpFrame, LoopIdentity
}
