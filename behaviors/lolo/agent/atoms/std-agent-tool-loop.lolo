app std-agent-tool-loop "2.0.0"
"std-agent-tool-loop — answers a conversation by operating the running app as the caller, through `call-service llm call-tools`. The `tools` allowlist names declared external inputs (addressed like a listens source: `Trait.EVENT`, `Orbital.Trait.EVENT`) and entities to read; each input fires as the signed-in user through the ordinary dispatch (guards and entity policies apply) and each read returns only the rows the caller may read. Headless: the conversation UI (std-agent-session) shows the reply; a failure shows as a toast. CONVERSE carries the conversation (and optionally what std-agent-memory recalled); STEP carries each step live while it works (a model call, a tool it used, what the app answered) to the asking tab; REPLIED carries the reply, every step and the token usage; REPLY_FAILED carries the error. Compose with std-agent-session (the conversation) and std-agent-trace (the step record)."

type AgentTool = {
  event : event
  read : string
}
type AgentChatMessage = {
  role : "user" | "assistant"
  content : string!
}
type AgentToolKind = "input" | "read" | "invalid"
type AgentToolCallActivity = {
  type : "tool_call"!
  tool : string!
  kind : AgentToolKind
  argsText : string!
  timestamp : number!
  isExecuting : boolean
}
type AgentToolResultActivity = {
  type : "tool_result"!
  tool : string!
  kind : AgentToolKind
  success : boolean!
  detail : string
  rows : number
  resultText : string!
  timestamp : number!
}
type AgentLlmCall = {
  service : string!
  provider : string!
  model : string!
  systemPrompt : string!
  userPrompt : string!
  toolCallsJson : string
  attempt : number
  durationMs : number!
  promptTokens : number
  completionTokens : number
  cachedPromptTokens : number
  costUSD : number
}
type AgentLlmResponseActivity = {
  type : "llm_response"!
  content : string!
  llm : AgentLlmCall
  timestamp : number!
}
type AgentActivity = AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity
type AgentUsage = {
  promptTokens : number!
  completionTokens : number!
  totalTokens : number!
  modelCalls : number!
}

orbital AgentToolLoopOrbital {
  entity AgentTurn [runtime] {
    id : string!
    status : "idle" | "thinking" | "answered" | "failed" @description "Where the current turn is." = idle
    reply : string @description "The last reply." = ""
    error : string @description "Why the last turn failed." = ""
  }

  trait AgentToolLoop -> AgentTurn [interaction] {
    config {
      tools : [AgentTool] = []
        @label "What may the assistant do?"
        @description "The declared inputs it may fire (`{ event: Trait.EVENT }`) and the entities it may read (`{ read: Entity }`), as the signed-in user."
        @synonyms "allowlist, abilities, actions, permissions"
        @tier "domain"
      instructions : string = "You operate this app for the signed-in user. Use the tools to act and to look things up; when a tool reports that something was refused or denied, say so plainly."
        @label "How should the assistant behave?"
        @description "Standing instructions sent with every conversation."
        @synonyms "system prompt, persona, guidance"
        @tier "domain"
      maxSteps : number = 8
        @label "Model round-trips per request"
        @description "How many model calls one request may take before it fails."
        @tier "policy"
    }
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.status idle)
      CONVERSE -> thinking
        (set @entity.status thinking)
        (call-service llm call-tools {
          messages: ?messages
          tools: @config.tools
          instructions: (if ["=", (str/default ?context ""), ""] @config.instructions (str/concat @config.instructions "\n\nWhat you remember that may be relevant:\n" ?context))
          maxSteps: @config.maxSteps
        } {
          emit: { failure: ASK_FAILED, success: ANSWERED, onMessage: STEP }
        })
    }

    state thinking {
      ANSWERED -> idle
        (set @entity.status answered)
        (set @entity.reply ?reply)
        (emit REPLIED { reply: ?reply, steps: ?steps, usage: ?usage })
      ASK_FAILED -> idle
        (set @entity.status failed)
        (set @entity.error ?error)
        (emit REPLY_FAILED { error: ?error })
        (render-ui toast {
          message: ?error
          type: alert
          variant: error
        })
    }

    emits {
      STEP -> external {
        activity : AgentActivity!
      }
        @description "One thing the assistant just did, live while it works: a model call, a tool it used, or what the app answered. Delivered to the asking tab only."
        @synonyms "progress, activity, trace step, working"
        @tier "domain"
      REPLIED -> external {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
      }
        @description "The assistant answered; carries every tool step it took and the tokens it used."
        @synonyms "answered, responded, done"
        @tier "domain"
      REPLY_FAILED -> external {
        error : string!
      }
        @description "The assistant could not answer (model unavailable, or out of steps)."
        @synonyms "failed, error, gave up"
        @tier "domain"
      ANSWERED -> internal {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
      }
        @tier "internal"
      ASK_FAILED -> internal {
        error : string!
      }
        @tier "internal"
    }

    listens {
      CONVERSE {
        messages : [AgentChatMessage]!
        context : string
      }
        @description "Answer this conversation; the last turn is the request. `context` is what the assistant remembers that may be relevant."
        @synonyms "ask, chat, request"
    }
  }

  page "/agent-tool-loop" as AgentToolLoopPage -> AgentToolLoop
}
