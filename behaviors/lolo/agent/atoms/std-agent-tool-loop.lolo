app std-agent-tool-loop [
  version: "2.0.0",
  description: "std-agent-tool-loop — answers a conversation by operating the running app as the caller, through `call-service llm call-tools`. Its `tools` are `{ scope: declared }` (every declared external input plus a read over every persisted entity), or named declared inputs (addressed like a listens source: `Trait.EVENT`, `Orbital.Trait.EVENT`) and entities to read; each input fires as the signed-in user through the ordinary dispatch (guards and entity policies apply) and each read returns only the rows the caller may read. Headless: the conversation UI (std-agent-session) shows the reply; a failure shows as a toast, unless `quiet` is on (a background run nobody is watching: no live steps and no toast). CONVERSE carries the conversation (and optionally what std-agent-memory recalled); ASSISTANT_STEP carries each step live while it works (a model call, a tool it used, what the app answered) to the asking tab; ASSISTANT_REPLIED carries the reply, every step and the token usage; ASSISTANT_REPLY_FAILED carries the error. These names are the assistant contract std-agent-session's conversation hears from any orbital. Compose with std-agent-session (the conversation) and std-agent-trace (the step record)."
]

type AgentToolScope = {
  scope : "declared"!
}
type AgentToolField = {
  name : string!
  type : string!
  required : boolean
  values : [string]
  properties : [AgentToolField]
  description : string
}
type AgentToolInput = {
  event : EventAddress!
  payload : [AgentToolField]
}
type AgentToolRead = {
  read : string!
}
type AgentTool = AgentToolScope | AgentToolInput | AgentToolRead
type AgentChatMessage = {
  role : "user" | "assistant"
  content : string!
}
type AgentToolKind = "input" | "read" | "invalid"
type AgentToolCallActivity = {
  type : "tool_call"!
  tool : string!
  kind : AgentToolKind
  argsText : string!
  timestamp : number!
  isExecuting : boolean
}
type AgentToolResultActivity = {
  type : "tool_result"!
  tool : string!
  kind : AgentToolKind
  success : boolean!
  detail : string
  rows : number
  resultText : string!
  timestamp : number!
}
type AgentLlmCall = {
  service : string!
  provider : string!
  model : string!
  systemPrompt : string!
  userPrompt : string!
  toolCallsJson : string
  attempt : number
  durationMs : number!
  promptTokens : number
  completionTokens : number
  cachedPromptTokens : number
  costUSD : number
}
type AgentLlmResponseActivity = {
  type : "llm_response"!
  content : string!
  llm : AgentLlmCall
  timestamp : number!
}
type AgentActivity = AgentToolCallActivity | AgentToolResultActivity | AgentLlmResponseActivity
type AgentUsage = {
  promptTokens : number!
  completionTokens : number!
  totalTokens : number!
  modelCalls : number!
}

orbital AgentToolLoopOrbital {
  entity AgentTurn [runtime] {
    id : string!
    status : "idle" | "thinking" | "answered" | "failed" @description "Where the current turn is." = idle
    reply : string @description "The last reply." = ""
    error : string @description "Why the last turn failed." = ""
    ephemeral : boolean @description "The current turn belongs to an ephemeral conversation." = false
  }

  trait AgentToolLoop -> AgentTurn [interaction] {
    config {
      tools : [AgentTool] = []
        @label "What may the assistant do?"
        @description "The declared inputs it may fire (`{ event: Trait.EVENT }`) and the entities it may read (`{ read: Entity }`), as the signed-in user."
        @synonyms "allowlist, abilities, actions, permissions"
        @tier "domain"
      instructions : string = "You operate this app for the signed-in user. Use the tools to act and to look things up; when a tool reports that something was refused or denied, say so plainly."
        @label "How should the assistant behave?"
        @description "Standing instructions sent with every conversation."
        @synonyms "system prompt, persona, guidance"
        @tier "domain"
      maxSteps : number = 8
        @label "Model round-trips per request"
        @description "How many model calls one request may take before it fails."
        @tier "policy"
      quiet : boolean = false
        @label "Run in the background?"
        @description "No live ASSISTANT_STEP stream and no failure toast: the request is reported only through ASSISTANT_REPLIED and ASSISTANT_REPLY_FAILED. For a run nobody is watching, such as one the app starts on its own."
        @synonyms "silent, background, no toast, suppress errors, headless run"
        @tier "policy"
      cancelKey : string = "agent-tool-loop"
        @label "Cancel key"
        @description "The key this instance's model call runs under, so CANCEL aborts it. Give each instance of the loop in one app its own."
        @synonyms "call key, abort key"
        @tier "internal"
    }
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.status idle)
      CONVERSE -> thinking when (and (not @config.quiet) (not ?ephemeral))
        (set @entity.status thinking)
        (set @entity.ephemeral false)
        (call-service llm call-tools {
          messages: ?messages
          tools: @config.tools
          instructions: (if ["=", (str/default ?context ""), ""] @config.instructions (str/concat @config.instructions "\n\nWhat you remember that may be relevant:\n" ?context))
          maxSteps: @config.maxSteps
        } {
          key: @config.cancelKey, emit: { failure: ASK_FAILED, success: ANSWERED, onMessage: ASSISTANT_STEP }
        })
      CONVERSE -> thinking when (and @config.quiet (not ?ephemeral))
        (set @entity.status thinking)
        (set @entity.ephemeral false)
        (call-service llm call-tools {
          messages: ?messages
          tools: @config.tools
          instructions: (if ["=", (str/default ?context ""), ""] @config.instructions (str/concat @config.instructions "\n\nWhat you remember that may be relevant:\n" ?context))
          maxSteps: @config.maxSteps
        } {
          key: @config.cancelKey, emit: { failure: ASK_FAILED, success: ANSWERED }
        })
      CONVERSE -> thinking when ?ephemeral
        (set @entity.status thinking)
        (set @entity.ephemeral true)
        (call-service llm call-tools {
          messages: ?messages
          tools: (object/get ? tools [])
          instructions: (if ["=", (str/default ?instructions ""), ""] @config.instructions ?instructions)
          maxSteps: @config.maxSteps
        } {
          key: @config.cancelKey, emit: { failure: ASK_FAILED, success: ANSWERED }
        })
    }

    state thinking {
      CANCEL -> idle
        (cancel-call @config.cancelKey)
        (set @entity.status idle)
      ANSWERED -> idle
        (set @entity.status answered)
        (set @entity.reply ?reply)
        (emit ASSISTANT_REPLIED { reply: ?reply, steps: ?steps, usage: ?usage, ephemeral: @entity.ephemeral })
      ASK_FAILED -> idle when (or @config.quiet @entity.ephemeral)
        (set @entity.status failed)
        (set @entity.error ?error)
        (emit ASSISTANT_REPLY_FAILED { error: ?error, ephemeral: @entity.ephemeral })
      ASK_FAILED -> idle when (and (not @config.quiet) (not @entity.ephemeral))
        (set @entity.status failed)
        (set @entity.error ?error)
        (emit ASSISTANT_REPLY_FAILED { error: ?error, ephemeral: @entity.ephemeral })
        (render-ui toast {
          message: ?error
          type: alert
          variant: error
        })
    }

    emits {
      ASSISTANT_STEP -> external {
        activity : AgentActivity!
      }
        @description "One thing the assistant just did, live while it works: a model call, a tool it used, or what the app answered. Delivered to the asking tab only."
        @synonyms "progress, activity, trace step, working"
        @tier "domain"
      ASSISTANT_REPLIED -> external {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
        ephemeral : boolean
      }
        @description "The assistant answered; carries every tool step it took and the tokens it used. `ephemeral` echoes the conversation's: an ephemeral reply is not stored or remembered, and only an ephemeral conversation shows it."
        @synonyms "answered, responded, done"
        @tier "domain"
      ASSISTANT_REPLY_FAILED -> external {
        error : string!
        ephemeral : boolean
      }
        @description "The assistant could not answer (model unavailable, or out of steps)."
        @synonyms "failed, error, gave up"
        @tier "domain"
      ANSWERED -> internal {
        reply : string!
        steps : [AgentActivity]!
        usage : AgentUsage!
      }
        @tier "internal"
      ASK_FAILED -> internal {
        error : string!
      }
        @tier "internal"
    }

    listens {
      CANCEL {
      }
        @description "Abort the request in flight; nothing is replied and no failure is reported."
        @synonyms "stop, abort, cancel"
      CONVERSE {
        messages : [AgentChatMessage]!
        context : string
        instructions : string
        tools : [AgentTool]
        ephemeral : boolean
      }
        @description "Answer this conversation; the last turn is the request. `context` is what the assistant remembers that may be relevant. An `ephemeral` conversation runs under its own `instructions` (empty: the configured ones) and exactly its own `tools` (absent or `[]`: none, never the configured ones), streams no live steps and shows no failure toast."
        @synonyms "ask, chat, request"
    }
  }

  page "/agent-tool-loop" as AgentToolLoopPage -> AgentToolLoop
}
