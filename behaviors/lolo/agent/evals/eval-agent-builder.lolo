app eval-agent-builder [
  version: "1.0.0",
  description: "Eval of std-agent-builder's ladder over std-agent-pool. RUN_CASE { index } builds the case's request through the ladder (the pool first, adopted at or above its threshold; otherwise a std learning instrument filled by the model with its knobs and a one-line hint), pools what was built, and records an EvalCase: the tier that served it, the behavior, the hint, the latency and the verdict: the tier the case expects, with a hint. Driven from outside, one case at a time.",
  egress: ["https://api.openai.com", "https://openrouter.ai"]
]
;; @exposure internal

type EvalCaseSpec = { id : string!, request : string!, expectTier : string! }

uses Builder from "std/behaviors/std-agent-builder"
uses Pool from "std/behaviors/std-agent-pool"

orbital EvalPoolOrbital = Pool.orbitals.AgentPoolOrbital {
  config {
    pool: "eval-agent-builder"
  }
  listens {
    EvalBuilderOrbital.BuilderPipeline.POOL_SEARCH -> AgentPoolSearch.SEARCH
    EvalRunOrbital.EvalDriver.POOL_WRITE -> AgentPoolWriter.WRITE
  }
}

orbital EvalBuilderOrbital = Builder.orbitals.AgentBuilderOrbital {
  traits {
    BuilderPipeline {
      config {
        ladder: [
          { name: "pool", source: "pool", scope: [], threshold: 0.8, action: "adopt", take: 5 },
          { name: "instrument", source: "catalog", scope: ["almadar-std/ui/learning/atoms"], threshold: 0, action: "fill", take: 3 }
        ]
        pickFields: [{ name: "howToPlay", type: "string", required: true, description: "How to play, in one short sentence of at most 12 words: the controls to use (tap, drag, slide, press) and the goal. Never name an item, a rule, a step, an order or a number; the learner works those out by playing." }]
        fieldWordLimits: [{ name: "howToPlay", words: 12 }]
        fillEvent: EvalBuilderOrbital.EvalBuilderOrbitalBuilderPipeline.FILL
        pickEvent: EvalBuilderOrbital.EvalBuilderOrbitalBuilderPipeline.PICK
        pickDecider: jev
      }
    }
  }
  listens {
    EvalRunOrbital.EvalDriver.START_BUILD -> BuilderPipeline.START
    EvalPoolOrbital.AgentPoolSearch.POOL_FOUND -> BuilderPipeline.POOL_FOUND
  }
}

orbital EvalRunOrbital {
  entity EvalRunView [runtime] {
    id : string!
    index : number = 0
    startedAt : number = 0
  }

  entity EvalCase [persistent: evalCases] {
    id : string!
    caseId : string = ""
    request : string = ""
    expectTier : string = ""
    tier : string = ""
    behavior : string = ""
    hint : string = ""
    latencyMs : number = 0
    verdict : "pass" | "fail" = fail
    error : string = ""
  }

  trait EvalDriver -> EvalRunView [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main { type: stack, direction: horizontal, gap: sm, children: [{ type: button, variant: ghost, label: "Cases", href: "/" }, { type: button, variant: ghost, label: "Builder", href: "/agent-builder" }, { type: button, variant: ghost, label: "Pool", href: "/agent-pool" }] })
      RUN_CASE -> running when (< ?index (array/len @config.cases))
        (set @entity.index ?index)
        (set @entity.startedAt @now)
        (emit START_BUILD { request: (object/get (array/nth @config.cases ?index) request), orbitalName: (str/concat "EvalCard" (object/get (array/nth @config.cases ?index) id)) })
      RUN_CASE -> idle when (>= ?index (array/len @config.cases))
      READ_CASES -> idle
        (fetch EvalCase {
          emit: { failure: CASES_FAILED, success: CASES_READ }
          limit: @config.pageSize
          offset: 0
        })
      REFETCH_PAGE -> idle
        (fetch EvalCase {
          emit: { failure: CASES_FAILED, success: CASES_READ }
          limit: @config.pageSize
          offset: (* (- ?page 1) @config.pageSize)
        })
      CASES_READ -> idle
      CASES_FAILED -> idle
        (render-ui toast { message: ?error, type: alert, variant: warning })
    }

    state running {
      INIT -> idle
      BUILD_DONE -> idle when (= ?tier "pool")
        (persist create EvalCase { caseId: (object/get (array/nth @config.cases @entity.index) id), request: (object/get (array/nth @config.cases @entity.index) request), expectTier: (object/get (array/nth @config.cases @entity.index) expectTier), tier: ?tier, behavior: ?behavior, hint: (object/get ?fields howToPlay ""), latencyMs: (- @now @entity.startedAt), verdict: (if (and (= ?tier (object/get (array/nth @config.cases @entity.index) expectTier)) (!= (object/get ?fields howToPlay "") "")) pass fail) })
      BUILD_DONE -> idle when (!= ?tier "pool")
        (persist create EvalCase { caseId: (object/get (array/nth @config.cases @entity.index) id), request: (object/get (array/nth @config.cases @entity.index) request), expectTier: (object/get (array/nth @config.cases @entity.index) expectTier), tier: ?tier, behavior: ?behavior, hint: (object/get ?fields howToPlay ""), latencyMs: (- @now @entity.startedAt), verdict: (if (and (= ?tier (object/get (array/nth @config.cases @entity.index) expectTier)) (!= (object/get ?fields howToPlay "") "")) pass fail) })
        (emit POOL_WRITE { value: ?value, name: ?orbitalName, kind: "instrument", topic: "", fields: ?fields, description: (object/get (array/nth @config.cases @entity.index) request) })
      BUILD_FAILED_CASE -> idle
        (persist create EvalCase { caseId: (object/get (array/nth @config.cases @entity.index) id), request: (object/get (array/nth @config.cases @entity.index) request), expectTier: (object/get (array/nth @config.cases @entity.index) expectTier), latencyMs: (- @now @entity.startedAt), verdict: fail, error: ?error })
    }

    config {
      pageSize : number = 100
        @label "Cases read per request"
        @description "Recorded cases READ_CASES returns per request; each run adds one row per case in the list, so ten runs of the default set fit one page. totalCount in CASES_READ says how many are stored, and REFETCH_PAGE reads a later page."
        @synonyms "fetch limit, records per page, batch size, page limit"
        @tier "presentation"
      cases : [EvalCaseSpec] = [
          { id: "sort-animals", request: "A quick game sorting animals into mammals, birds and reptiles", expectTier: "instrument" },
          { id: "sort-animals-again", request: "Sort some animals into mammals, birds and reptiles", expectTier: "pool" },
          { id: "water-cycle", request: "Put the stages of the water cycle in order", expectTier: "instrument" },
          { id: "planets-order", request: "Line up the planets from the closest to the Sun to the farthest", expectTier: "instrument" },
          { id: "planets-again", request: "Order the planets by their distance from the Sun", expectTier: "pool" },
          { id: "fractions-compare", request: "Which fraction is bigger? Compare pairs of fractions", expectTier: "instrument" },
          { id: "plant-light", request: "Explore how light and water change how fast a plant grows", expectTier: "instrument" },
          { id: "times-tables", request: "Quick-fire times tables practice against the clock", expectTier: "instrument" },
          { id: "moon-distance", request: "Guess how far away the Moon is from Earth", expectTier: "instrument" },
          { id: "sort-foods", request: "Sort foods into fruits and vegetables", expectTier: "instrument" }
        ]
        @label "Cases"
        @tier "domain"
    }

    emits {
      CASES_READ -> external {
        data : [EvalCase]!
        totalCount : number
      }
        @description "One page of the cases recorded so far, with the total stored."
        @tier "domain"
      CASES_FAILED {
        error : string!
      }
        @tier "internal"
      START_BUILD -> external {
        request : string!
        orbitalName : string!
      }
        @tier "internal"
      POOL_WRITE -> external {
        value : behavior!
        name : string!
        kind : string!
        topic : string
        fields : Map string string
        description : string!
      }
        @tier "internal"
    }

    listens {
      RUN_CASE -> input {
        index : number!
      }
        @description "Run one case of the eval."
      READ_CASES -> input {
      }
        @description "Read back the first page of the cases recorded so far."
      REFETCH_PAGE -> input {
        page : number!
      }
        @description "Read back one later page of the recorded cases."
      EvalBuilderOrbital.BuilderPipeline.BUILD_COMPLETE -> BUILD_DONE
      BUILD_DONE {
        orbitalName : string!
        behavior : string!
        value : behavior!
        tier : string!
        fields : Map string string
      }
      EvalBuilderOrbital.BuilderPipeline.BUILD_REJECTED -> BUILD_FAILED_CASE
      BUILD_FAILED_CASE {
        error : string!
      }
    }
  }

  page "/" as EvalAgentBuilderPage -> EvalDriver, EvalBuilderOrbitalBuilderPipeline, EvalBuilderOrbitalBuilderTools, EvalPoolOrbitalAgentPoolWriter, EvalPoolOrbitalAgentPoolSearch, EvalPoolOrbitalAgentPoolSignal [initial]
}
