app std-package-registry [
  version: "1.0.0",
  description: "std-package-registry — the package registry server as one atom, following spec/ops/package-registry.lolo (not bound with uses: its PackageRegistry @ensures obligations are stated on PackageVersion as the trait's own entity, which this atom keeps separate from its request state). It listens to REQUEST_RECEIVED from std-http1 for paths under apiPrefix/packages/ and answers RESPOND { requestId, status, headers, body }, one request at a time with later ones queued: PUT /packages/:name/:version publishes (the bearer must be a live std-api-keys key, verified by std-api-key-verifier: a missing, unknown, revoked or expired key answers 401 UNAUTHORIZED, a verifier that cannot decide 503 STORE_UNAVAILABLE; empty body 400 EMPTY_TARBALL; a stored name+version 409 VERSION_EXISTS), GET /packages/:name/:version answers the version row (404 NOT_FOUND), GET /packages/:name/:version/tarball streams the stored bytes as application/gzip (410 YANKED when yanked), GET /packages/:name lists versions newest publish first, POST /packages/:name/:version/yank (bearer key, verified as for publish) marks the version yanked and is idempotent; every error answers { error, code }, and an unmatched path under the prefix answers 404 NOT_FOUND. PackageVersion rows live in the row store seam (persistent: package_versions); a deployment binds the store. A publish that passes auth, the empty check and the duplicate check is hashed by std-sha256 (sha256 over the tarball bytes, hex), stored as a PackageVersion with that integrity, and answered 201 { name, version, url, integrity } with PACKAGE_PUBLISHED; a tarball std-sha256 cannot hash answers 501 INTEGRITY_UNAVAILABLE and stores nothing. Answers carry no CORS headers (the router owns the policy headers). A server composing it sets std-http-router's `externalPrefix` to apiPrefix/packages/ so the router leaves those paths to this atom (composition pending G-STD-086)."
]
type RegistryHeader = { name : string!, value : string! }
type RegistryRequest = { requestId : number!, method : string!, path : string!, authorization : string!, body : bytes! }
type RegistryClaim = { name : string!, value : string! }
type RegistryOrb = { language : string? }
type RegistryManifest = { orb : RegistryOrb? }
type RegistryGunzip = { ok : boolean!, data : bytes, crc : number, code : string }
type RegistryTarEntry = { path : string!, data : bytes!, executable : boolean! }
type RegistryTarRead = { ok : boolean!, entries : [RegistryTarEntry], code : string }
type RegistryCall = { requestId : number!, op : string!, name : string!, version : string!, integrity : string! }
orbital PackageRegistryOrbital {
  uses Sha from "std/behaviors/std-sha256"
  uses Keys from "std/behaviors/std-api-key-verifier"

  entity RegistryState [runtime] {
    id : string!
    busy : boolean = false
    current : RegistryCall @description "The request being served; empty while none is." = { requestId: 0, op: "", name: "", version: "", integrity: "" }
    queue : [RegistryRequest] @description "Requests received while one is being served." = []
    tarball : bytes @description "The tarball of the publish being served."
    gz : RegistryGunzip? @description "The gunzip answer for the publish tarball."
    tarRead : RegistryTarRead? @description "The tar reader answer for the gunzipped publish tarball."
  }

  entity PackageVersion [persistent: package_versions] {
    @create none "A substrate atom: the composing program decides who reaches the trait that writes these rows, so this atom states no creator of its own."
    id : string! @key @description "name@version."
    name : string!
    version : string!
    integrity : string!
    tarball : bytes!
    yanked : boolean = false
    language : string @description "The orb.language range of the version's package.json, recorded at publish; empty when the tarball declares none." = ""
    publishedAt : instant!
    @read none "served only through the registry routes"
  }

  trait Digest = Sha.traits.Sha256 {
    listens {
      PackageRegistry.REG_HASH -> SHA256_DIGEST
    }
  }

  trait ApiKeys = Keys.traits.ApiKeyVerifier {
    listens {
      PackageRegistry.VERIFY_KEY -> VERIFY_KEY
    }
  }

  trait PackageRegistry -> RegistryState [optimistic] {
    initial: serving

    config {
      apiPrefix : string = "/api"
        @label "API prefix"
        @description "The routes live under this prefix followed by /packages."
        @tier "infra"
      baseUrl : string = ""
        @label "Base URL"
        @description "Prepended to the tarball url the registry answers."
        @tier "infra"
      maxRows : number = 1000
        @label "Versions per package"
        @description "Most versions one GET /packages/:name listing may read. The answer names every version, so a partial read would be a wrong answer; a package with more versions is refused through the store-unavailable answer instead of listing a cut set."
        @synonyms "version cap, listing limit"
        @tier "policy"
      maxEntries : number = 100000
        @label "Archive entry cap"
        @description "Most files a publish tarball may hold while its package.json is read for the orb.language range; a tarball with more, or one the tar reader refuses, records no range."
        @tier "policy"
      maxUnpackedBytes : number = 536870912
        @label "Unpacked size cap"
        @description "Most bytes a publish tarball may inflate to while its package.json is read for the orb.language range; a tarball that inflates past it records no range."
        @tier "policy"
    }

    state serving {
      INIT -> serving
      REQUEST_RECEIVED -> serving when (and (str/startsWith @payload.path (str/concat @config.apiPrefix "/packages/")) (not @entity.busy))
        (set @entity.busy true)
        (emit REGISTRY_ENTER { requestId: @payload.requestId, method: @payload.method, path: @payload.path, authorization: (default (object/get (default @payload.headers {}) "authorization") ""), body: (default @payload.body (bytes/from-string "")) })
      REQUEST_RECEIVED -> serving when (and (str/startsWith @payload.path (str/concat @config.apiPrefix "/packages/")) @entity.busy)
        (set @entity.queue (array/append @entity.queue { requestId: @payload.requestId, method: @payload.method, path: @payload.path, authorization: (default (object/get (default @payload.headers {}) "authorization") ""), body: (default @payload.body (bytes/from-string "")) }))
      REGISTRY_DONE -> serving when (= (array/len @entity.queue) 0)
        (set @entity.busy false)
      REGISTRY_DONE -> serving when (> (array/len @entity.queue) 0)
        (let ((nx (array/first @entity.queue)))
          (emit REGISTRY_ENTER { requestId: @nx.requestId, method: @nx.method, path: @nx.path, authorization: @nx.authorization, body: @nx.body }))
        (set @entity.queue (array/drop @entity.queue 1))
      ;; the rest defaults never fire: each route's guard fixes the segment count first
      REGISTRY_ENTER -> serving when (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (and (= @m "PUT") (= @n 2)))
        (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (emit PACKAGE_PUBLISH { requestId: @payload.requestId, name: (default (array/nth @rest 0) ""), version: (default (array/nth @rest 1) ""), token: (str/replace @payload.authorization "Bearer " ""), tarball: @payload.body }))
      REGISTRY_ENTER -> serving when (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (and (= @m "GET") (= @n 2)))
        (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (emit PACKAGE_FETCH { requestId: @payload.requestId, name: (default (array/nth @rest 0) ""), version: (default (array/nth @rest 1) "") }))
      REGISTRY_ENTER -> serving when (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (and (= @m "GET") (= @n 3) (= (array/nth @rest 2) "tarball")))
        (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (emit PACKAGE_TARBALL { requestId: @payload.requestId, name: (default (array/nth @rest 0) ""), version: (default (array/nth @rest 1) "") }))
      REGISTRY_ENTER -> serving when (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (and (= @m "GET") (= @n 1)))
        (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (emit PACKAGE_VERSIONS { requestId: @payload.requestId, name: (default (array/nth @rest 0) "") }))
      REGISTRY_ENTER -> serving when (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (and (= @m "POST") (= @n 3) (= (array/nth @rest 2) "yank")))
        (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (emit PACKAGE_YANK { requestId: @payload.requestId, name: (default (array/nth @rest 0) ""), version: (default (array/nth @rest 1) ""), token: (str/replace @payload.authorization "Bearer " "") }))
      REGISTRY_ENTER -> serving when (let ((rest (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/"))
              (n (array/len (str/split (str/slice @payload.path (str/len (str/concat @config.apiPrefix "/packages/"))) "/")))
              (m (str/upper @payload.method))) (not (or (and (= @m "PUT") (= @n 2)) (and (= @m "GET") (= @n 2)) (and (= @m "GET") (= @n 3) (= (array/nth @rest 2) "tarball")) (and (= @m "GET") (= @n 1)) (and (= @m "POST") (= @n 3) (= (array/nth @rest 2) "yank")))))
        (emit PACKAGE_REFUSED { requestId: @payload.requestId, status: 404, code: "NOT_FOUND", error: "Not found" })
        (emit RESPOND { requestId: @payload.requestId, status: 404, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Not found", code: "NOT_FOUND" })) })
        (emit REGISTRY_DONE {})
      PACKAGE_PUBLISH -> serving
        (set @entity.tarball @payload.tarball)
        (set @entity.current { requestId: @payload.requestId, op: "publish", name: @payload.name, version: @payload.version, integrity: "" })
        (emit VERIFY_KEY { requestId: @payload.requestId, token: (default @payload.token "") })
      PACKAGE_YANK -> serving
        (set @entity.current { requestId: @payload.requestId, op: "yank", name: @payload.name, version: @payload.version, integrity: "" })
        (emit VERIFY_KEY { requestId: @payload.requestId, token: (default @payload.token "") })
      REG_KEY_VERIFIED -> serving when (and (= @entity.current.op "publish") (= (bytes/length (default @entity.tarball (bytes/from-string ""))) 0))
        (emit RESPOND { requestId: @entity.current.requestId, status: 400, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Empty tarball", code: "EMPTY_TARBALL" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 400, code: "EMPTY_TARBALL", error: "Empty tarball" })
        (emit REGISTRY_DONE {})
      REG_KEY_VERIFIED -> serving when (and (= @entity.current.op "publish") (> (bytes/length (default @entity.tarball (bytes/from-string ""))) 0))
        (fetch PackageVersion { id: (str/concat @entity.current.name (str/slice "a@b" 1 2) @entity.current.version), emit: { success: REGISTRY_FOUND, failure: REGISTRY_MISSING } })
      REG_KEY_VERIFIED -> serving when (= @entity.current.op "yank")
        (fetch PackageVersion { id: (str/concat @entity.current.name (str/slice "a@b" 1 2) @entity.current.version), emit: { success: REGISTRY_FOUND, failure: REGISTRY_MISSING } })
      REG_KEY_REFUSED -> serving when (or (= @payload.reason "not-a-key") (= @payload.reason "unknown") (= @payload.reason "revoked") (= @payload.reason "expired"))
        (set @entity.tarball (bytes/from-string ""))
        (emit RESPOND { requestId: @entity.current.requestId, status: 401, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Unauthorized", code: "UNAUTHORIZED" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 401, code: "UNAUTHORIZED", error: "Unauthorized" })
        (emit REGISTRY_DONE {})
      REG_KEY_REFUSED -> serving when (not (or (= @payload.reason "not-a-key") (= @payload.reason "unknown") (= @payload.reason "revoked") (= @payload.reason "expired")))
        (set @entity.tarball (bytes/from-string ""))
        (emit RESPOND { requestId: @entity.current.requestId, status: 503, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Package store unavailable", code: "STORE_UNAVAILABLE" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 503, code: "STORE_UNAVAILABLE", error: "Package store unavailable" })
        (emit REGISTRY_DONE {})
      PACKAGE_FETCH -> serving
        (set @entity.current { requestId: @payload.requestId, op: "fetch", name: @payload.name, version: @payload.version, integrity: "" })
        (fetch PackageVersion { id: (str/concat @payload.name (str/slice "a@b" 1 2) @payload.version), emit: { success: REGISTRY_FOUND, failure: REGISTRY_MISSING } })
      PACKAGE_TARBALL -> serving
        (set @entity.current { requestId: @payload.requestId, op: "tarball", name: @payload.name, version: @payload.version, integrity: "" })
        (fetch PackageVersion { id: (str/concat @payload.name (str/slice "a@b" 1 2) @payload.version), emit: { success: REGISTRY_FOUND, failure: REGISTRY_MISSING } })
      PACKAGE_VERSIONS -> serving
        (set @entity.current { requestId: @payload.requestId, op: "versions", name: @payload.name, version: "", integrity: "" })
        (fetch PackageVersion { filter: (= (object/get @entity name) @payload.name), limit: @config.maxRows, emit: { success: REGISTRY_LISTED, failure: REGISTRY_STORE_REFUSED } })
      REGISTRY_FOUND -> serving when (= @entity.current.op "publish")
        (emit RESPOND { requestId: @entity.current.requestId, status: 409, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Version already published", code: "VERSION_EXISTS" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 409, code: "VERSION_EXISTS", error: "Version already published" })
        (emit REGISTRY_DONE {})
      REGISTRY_FOUND -> serving when (= @entity.current.op "fetch")
        (emit RESPOND { requestId: @entity.current.requestId, status: 200, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { name: @entity.current.name, version: @entity.current.version, url: (str/concat @config.baseUrl @config.apiPrefix "/packages/" @entity.current.name "/" @entity.current.version "/tarball"), integrity: @payload.data.integrity, yanked: @payload.data.yanked, language: @payload.data.language })) })
        (emit REGISTRY_DONE {})
      REGISTRY_FOUND -> serving when (and (= @entity.current.op "tarball") @payload.data.yanked)
        (emit RESPOND { requestId: @entity.current.requestId, status: 410, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Version yanked", code: "YANKED" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 410, code: "YANKED", error: "Version yanked" })
        (emit REGISTRY_DONE {})
      REGISTRY_FOUND -> serving when (and (= @entity.current.op "tarball") (not @payload.data.yanked))
        (emit RESPOND { requestId: @entity.current.requestId, status: 200, headers: [{ name: "content-type", value: "application/gzip" }], body: @payload.data.tarball })
        (emit REGISTRY_DONE {})
      REGISTRY_FOUND -> serving when (= @entity.current.op "yank")
        (persist update PackageVersion (object/set @payload.data "yanked" true) { emit: { success: REGISTRY_YANKED, failure: REGISTRY_STORE_REFUSED } })
      REGISTRY_YANKED -> serving
        (emit RESPOND { requestId: @entity.current.requestId, status: 200, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { name: @entity.current.name, version: @entity.current.version, yanked: true })) })
        (emit REGISTRY_DONE {})
      REGISTRY_MISSING -> serving when (and (= @entity.current.op "publish") (= @payload.code "not-found"))
        (emit REG_HASH { requestId: (str/concat @entity.current.requestId), data: (default @entity.tarball (bytes/from-string "")), encoding: "hex" })
      REG_DIGESTED -> serving
        (set @entity.current (object/set @entity.current "integrity" @payload.digest))
        (set @entity.gz (gzip/decompress (default @entity.tarball (bytes/from-string "")) @config.maxUnpackedBytes { result: true }))
        (set @entity.tarRead (tar/entries (default @entity.gz.data (bytes/from-string "")) @config.maxEntries { result: true }))
        (let ((e (array/find (default @entity.tarRead.entries []) (fn x (= @x.path "package/package.json")))))
          (let ((m (if (= @e null) null (json/parse (default (bytes/to-string @e.data) "") RegistryManifest))))
            (emit REG_LANGUAGE { language: (if (= @m null) "" (if (= (object/get @m "orb") null) "" (default (object/get (object/get @m "orb") "language") ""))) })))
      REG_LANGUAGE -> serving
        (set @entity.tarRead null)
        (persist create PackageVersion { id: (str/concat @entity.current.name (str/slice "a@b" 1 2) @entity.current.version), name: @entity.current.name, version: @entity.current.version, integrity: @entity.current.integrity, tarball: @entity.tarball, yanked: false, language: @payload.language, publishedAt: (time/now) } { emit: { success: REGISTRY_PUBLISHED, failure: REGISTRY_STORE_REFUSED } })
      REGISTRY_PUBLISHED -> serving
        (set @entity.tarball (bytes/from-string ""))
        (emit RESPOND { requestId: @entity.current.requestId, status: 201, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { name: @entity.current.name, version: @entity.current.version, url: (str/concat @config.baseUrl @config.apiPrefix "/packages/" @entity.current.name "/" @entity.current.version "/tarball"), integrity: @entity.current.integrity })) })
        (emit PACKAGE_PUBLISHED { requestId: @entity.current.requestId, name: @entity.current.name, version: @entity.current.version, url: (str/concat @config.baseUrl @config.apiPrefix "/packages/" @entity.current.name "/" @entity.current.version "/tarball"), integrity: @entity.current.integrity })
        (emit REGISTRY_DONE {})
      REG_HASH_REFUSED -> serving
        (set @entity.tarball (bytes/from-string ""))
        (emit RESPOND { requestId: @entity.current.requestId, status: 501, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "The tarball could not be hashed", code: "INTEGRITY_UNAVAILABLE" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 501, code: "INTEGRITY_UNAVAILABLE", error: "The tarball could not be hashed" })
        (emit REGISTRY_DONE {})
      REGISTRY_MISSING -> serving when (and (!= @entity.current.op "publish") (= @payload.code "not-found"))
        (emit RESPOND { requestId: @entity.current.requestId, status: 404, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Not found", code: "NOT_FOUND" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 404, code: "NOT_FOUND", error: "Not found" })
        (emit REGISTRY_DONE {})
      REGISTRY_MISSING -> serving when (!= @payload.code "not-found")
        (emit RESPOND { requestId: @entity.current.requestId, status: 503, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Package store unavailable", code: "STORE_UNAVAILABLE" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 503, code: "STORE_UNAVAILABLE", error: "Package store unavailable" })
        (emit REGISTRY_DONE {})
      REGISTRY_STORE_REFUSED -> serving
        (emit RESPOND { requestId: @entity.current.requestId, status: 503, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Package store unavailable", code: "STORE_UNAVAILABLE" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 503, code: "STORE_UNAVAILABLE", error: "Package store unavailable" })
        (emit REGISTRY_DONE {})
      REGISTRY_LISTED -> serving when (> @payload.totalCount (array/len @payload.data))
        (emit REGISTRY_STORE_REFUSED { error: (str/concat "PackageVersion has " @payload.totalCount " versions for one package, over the maxRows cap of " @config.maxRows), code: "VERSIONS_OVER_CAP" })
      REGISTRY_LISTED -> serving when (= (array/len @payload.data) 0)
        (emit RESPOND { requestId: @entity.current.requestId, status: 404, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { error: "Not found", code: "NOT_FOUND" })) })
        (emit PACKAGE_REFUSED { requestId: @entity.current.requestId, status: 404, code: "NOT_FOUND", error: "Not found" })
        (emit REGISTRY_DONE {})
      REGISTRY_LISTED -> serving when (> (array/len @payload.data) 0)
        (emit RESPOND { requestId: @entity.current.requestId, status: 200, headers: [{ name: "content-type", value: "application/json" }], body: (bytes/from-string (json/stringify { name: @entity.current.name, versions: (array/map (array/sort @payload.data "publishedAt" "desc") (fn r { version: @r.version, integrity: @r.integrity, yanked: @r.yanked, language: @r.language, publishedAt: @r.publishedAt })) })) })
        (emit REGISTRY_DONE {})
    }

    emits {
      RESPOND -> external {
        requestId : number!
        status : number!
        headers : [RegistryHeader]!
        body : bytes!
      }
        @description "Answer this request: status, headers and body for std-http1 to write."
        @tier "primary"
      PACKAGE_REFUSED -> external {
        requestId : number!
        status : number!
        code : string!
        error : string!
      }
        @description "A registry request was refused with this status and code."
        @tier "primary"
      VERIFY_KEY {
        requestId : number!
        token : string!
      }
        @description "Internal: ask std-api-key-verifier whether the request's bearer is a live key."
        @tier "secondary"
      REG_HASH {
        requestId : string!
        data : bytes!
        encoding : string!
      }
        @description "Internal: hash the publish tarball."
        @tier "secondary"
      REGISTRY_PUBLISHED -> internal {
        id : string!
        integrity : string!
      }
        @description "Internal: the version is stored."
        @tier "secondary"
      PACKAGE_PUBLISHED -> external {
        requestId : number!
        name : string!
        version : string!
        url : string!
        integrity : string!
      }
        @description "A package version was published; integrity is sha256 over its tarball bytes, hex."
        @tier "primary"
      REG_LANGUAGE -> internal {
        language : string!
      }
        @description "Internal: the orb.language range read from the tarball's package.json; empty when it declares none."
        @tier "secondary"
      REGISTRY_ENTER -> internal {
        requestId : number!
        method : string!
        path : string!
        authorization : string!
        body : bytes!
      }
        @description "Internal: start serving one request."
        @tier "secondary"
      REGISTRY_DONE -> internal {
      }
        @description "Internal: the request was answered."
        @tier "secondary"
      PACKAGE_PUBLISH -> internal {
        requestId : number!
        name : string!
        version : string!
        token : string
        tarball : bytes!
      }
        @description "Internal: a publish request, parsed."
        @tier "secondary"
      PACKAGE_FETCH -> internal {
        requestId : number!
        name : string!
        version : string!
      }
        @description "Internal: a version lookup, parsed."
        @tier "secondary"
      PACKAGE_TARBALL -> internal {
        requestId : number!
        name : string!
        version : string!
      }
        @description "Internal: a tarball download, parsed."
        @tier "secondary"
      PACKAGE_VERSIONS -> internal {
        requestId : number!
        name : string!
      }
        @description "Internal: a version listing, parsed."
        @tier "secondary"
      PACKAGE_YANK -> internal {
        requestId : number!
        name : string!
        version : string!
        token : string
      }
        @description "Internal: a yank request, parsed."
        @tier "secondary"
      REGISTRY_FOUND -> internal {
        data : PackageVersion!
      }
        @description "Internal: a store result."
        @tier "secondary"
      REGISTRY_MISSING -> internal {
        error : string
        code : string
      }
        @description "Internal: a store result."
        @tier "secondary"
      REGISTRY_LISTED -> internal {
        data : [PackageVersion]!
        totalCount : number!
      }
        @description "Internal: a store result."
        @tier "secondary"
      REGISTRY_YANKED -> internal {
        id : string
      }
        @description "Internal: a store result."
        @tier "secondary"
      REGISTRY_STORE_REFUSED -> internal {
        error : string
        code : string
      }
        @description "Internal: a store result."
        @tier "secondary"
    }

    listens {
      REG_DIGESTED { requestId : string  digest : string! }
        @description "Internal: the tarball's SHA-256."
      REG_HASH_REFUSED { requestId : string  reason : string! }
        @description "Internal: the tarball could not be hashed."
      REG_KEY_VERIFIED { requestId : number  owner : string!  claims : [RegistryClaim]! }
        @description "Internal: std-api-key-verifier accepted the bearer."
      REG_KEY_REFUSED { requestId : number  reason : "not-a-key" | "salt" | "lookup" | "unknown" | "revoked" | "expired" | "busy"  message : string! }
        @description "Internal: std-api-key-verifier refused the bearer, and why."
      ApiKeys.API_KEY_VERIFIED -> REG_KEY_VERIFIED
      ApiKeys.API_KEY_REFUSED -> REG_KEY_REFUSED
      Digest.SHA256_DIGESTED -> REG_DIGESTED
      Digest.SHA256_REFUSED -> REG_HASH_REFUSED
      REQUEST_RECEIVED {
        requestId : number!
        method : string!
        path : string!
        query : string
        headers : Map string string
        body : bytes
        peer : string
      }
    }
  }

  page boot as PackageRegistryPage -> PackageRegistry, Digest, ApiKeys
}
