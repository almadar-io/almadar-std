app std-aws-board [
  version: "1.0.0",
  description: "std-aws-board — one AWS region of an account at a glance, read through the aws CLI (std-cli, with the host's PATH and HOME passed through so the CLI finds its credentials). AWS_LOAD answers AWS_BOARD from the cache within cacheTtlMs; AWS_REFRESH reads afresh; a load during a read is answered by that read. A read, in order: EC2 instances (each priced and specified from the catalog knob, null when its type is not in it; daily and monthly price at 24 and hoursPerMonth hours), EBS volumes (priced at ebsPerGbMonth, one rate for every volume type), the account's own images (snapshot rate), the S3 buckets whose name contains a bucketNameContains entry (object count and size from the CLI's summary), the security groups matching securityGroupFilter, key pairs, the roles whose name contains roleNameContains, the quotas knob's service quotas (a quota that counts running instances sums the catalog vCPUs of running instances of the gvtFamilies families, usedComplete false when one of them is not in the catalog), this month's cost per service (Cost Explorer, cents, highest first) and the EC2 instance types billed over the last historyDays days (hours and cost summed per type, types below minHistoryCost left out, highest first). runningHourlyCost sums the running instances' prices; estimatedMonthlyCost adds volumes, images, buckets and the running instances for hoursPerMonth. A part the CLI cannot read is empty.",
  exec: ["aws"],
  env: ["PATH", "HOME"]
]
uses Spec from "almadar-std/aws-board"
type AwsCell = string | number
type AwsCells = [[AwsCell]]
type AwsInstanceRows = [[[string]]]
type AwsStringRows = [[string]]
type AwsRole = { RoleName : string!, CreateDate : string! }
type AwsRoleRows = [AwsRole]
type AwsMoney = { Amount : string!, Unit : string! }
type AwsMetrics = { UnblendedCost : AwsMoney!, UsageQuantity : AwsMoney! }
type AwsGroup = { Keys : [string]!, Metrics : AwsMetrics! }
type AwsBucketTime = { Groups : [AwsGroup]! }
type AwsCostReply = { ResultsByTime : [AwsBucketTime]! }
type AwsSpec = { vcpus : number!, memoryGb : number!, gpu : string?, gpuCount : number!, gpuMemoryGb : number!, hourlyUsd : number! }
type AwsQuotaRef = { code : string!, name : string!, countsRunning : boolean! }
type AwsInstance = { instanceId : string!, instanceType : string!, state : string!, name : string!, launchTime : string!, publicIp : string?, az : string!, vcpus : number?, memoryGb : number?, gpu : string?, gpuCount : number!, gpuMemoryGb : number!, hourlyUsd : number?, dailyUsd : number?, monthlyUsd : number? }
type AwsVolume = { volumeId : string!, size : number!, state : string!, volumeType : string!, az : string!, name : string!, attachedTo : string?, iops : number!, monthlyCost : number! }
type AwsImage = { imageId : string!, name : string!, state : string!, created : string!, sizeGb : number!, monthlyCost : number! }
type AwsBucket = { name : string!, totalObjects : number!, totalSizeMb : number!, monthlyCost : number! }
type AwsSecurityGroup = { groupId : string!, groupName : string!, description : string! }
type AwsKeyPair = { keyName : string!, keyId : string!, created : string! }
type AwsIamRole = { roleName : string?, created : string? }
type AwsQuota = { name : string!, value : number!, used : number!, usedComplete : boolean! }
type AwsServiceCost = { service : string!, cost : number!, unit : string! }
type AwsTypeUsage = { instanceType : string!, hours : number!, rawCost : number!, cost : number!, vcpus : number?, memoryGb : number?, gpu : string?, gpuCount : number! }
type AwsTypeRow = { instanceType : string!, hours : number!, cost : number!, vcpus : number?, memoryGb : number?, gpu : string?, gpuCount : number! }
type StatusBoardTile = { label : string!, value : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, icon : string! }
type StatusBoardSection = { key : string!, label : string! }
type StatusBoardRow = { id : string!, section : string!, title : string!, subtitle : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, statusLabel : string!, icon : string!, meta : [string]!, at : instant?, url : string! }
type StatusBoardDetailItem = { label : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, statusLabel : string!, meta : string! }
type StatusBoardDetail = { rowId : string!, phase : "loading" | "ready" | "failed"!, items : [StatusBoardDetailItem]!, code : string!, codeTitle : string!, errorLines : [number]!, error : string! }
type AwsOverview = { instances : [AwsInstance]!, volumes : [AwsVolume]!, amis : [AwsImage]!, s3Buckets : [AwsBucket]!, securityGroups : [AwsSecurityGroup]!, keyPairs : [AwsKeyPair]!, iamRoles : [AwsIamRole]!, quotas : [AwsQuota]!, costExplorer : [AwsServiceCost]!, costExplorerTotal : number!, costExplorerPeriod : string!, estimatedMonthlyCost : number!, runningHourlyCost : number!, instanceTypeHistory : [AwsTypeRow]!, instanceTypeHistoryDays : number!, fetchedAt : string! }
orbital AwsBoardOrbital {
  uses Cli from "std/behaviors/std-cli"
  uses Board from "std/behaviors/std-status-board"

  entity AwsBoard [runtime] {
    id : string!
    board : AwsOverview @description "The board last answered; empty before the first." = { instances: [], volumes: [], amis: [], s3Buckets: [], securityGroups: [], keyPairs: [], iamRoles: [], quotas: [], costExplorer: [], costExplorerTotal: 0, costExplorerPeriod: "", estimatedMonthlyCost: 0, runningHourlyCost: 0, instanceTypeHistory: [], instanceTypeHistoryDays: 0, fetchedAt: "" }
    cachedAt : instant @description "Instant at which the board was cached." = 0
    hasCache : boolean = false
    loading : boolean @description "Whether a read is in flight." = false
    startedAt : instant @description "Instant at which the read in flight began." = 0
    instances : [AwsInstance] = []
    volumes : [AwsVolume] = []
    amis : [AwsImage] = []
    buckets : [string] @description "The buckets of the read in flight whose summary is read next." = []
    s3Buckets : [AwsBucket] = []
    securityGroups : [AwsSecurityGroup] = []
    keyPairs : [AwsKeyPair] = []
    iamRoles : [AwsIamRole] = []
    quotas : [AwsQuota] = []
    costExplorer : [AwsServiceCost] = []
    history : [AwsTypeUsage] = []
    cursor : number @description "Index of the bucket or quota being read." = 0
    details : [StatusBoardDetail] @description "The detail of every row last answered to the board." = []
  }

  trait AwsCli = Cli.traits.CliRunner {
    listens { AwsStatus.AWS_RUN -> CLI_RUN }
    config {
      commands: ["aws"]
      passEnv: ["PATH", "HOME"]
    }
  }

  trait AwsView = Board.traits.StatusBoard {
    listens {
      AwsStatus.AWS_BOARD_LOADING -> BOARD_LOADING
      AwsStatus.AWS_BOARD_SHOW -> BOARD_SHOW
      AwsStatus.AWS_BOARD_FAILED -> BOARD_FAILED
      AwsStatus.AWS_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
    }
    config {
      title: "AWS"
      icon: "cloud"
      idleTitle: "AWS not read yet"
      idleDescription: "Load the board to read the region's instances, cost and quotas."
      emptyTitle: "Nothing in this region"
      emptyDescription: "The read answered no instances, quotas or cost."
      searchPlaceholder: "Search instances, quotas and services"
    }
  }

  trait AwsStatus -> AwsBoard [client] {
    initial: idle

    state idle {
      INIT -> idle when (not @config.loadOnInit)
      INIT -> idle when @config.loadOnInit
        (emit AWS_LOAD { })
      AWS_LOAD -> idle when (and @entity.hasCache (< (time/diff @now @entity.cachedAt) @config.cacheTtlMs))
        (emit AWS_BOARD { instances: @entity.board.instances, volumes: @entity.board.volumes, amis: @entity.board.amis, s3Buckets: @entity.board.s3Buckets, securityGroups: @entity.board.securityGroups, keyPairs: @entity.board.keyPairs, iamRoles: @entity.board.iamRoles, quotas: @entity.board.quotas, costExplorer: @entity.board.costExplorer, costExplorerTotal: @entity.board.costExplorerTotal, costExplorerPeriod: @entity.board.costExplorerPeriod, estimatedMonthlyCost: @entity.board.estimatedMonthlyCost, runningHourlyCost: @entity.board.runningHourlyCost, instanceTypeHistory: @entity.board.instanceTypeHistory, instanceTypeHistoryDays: @entity.board.instanceTypeHistoryDays, fetchedAt: @entity.board.fetchedAt })
        (emit AWS_SHOW { })
      AWS_LOAD -> reading when (not (and @entity.hasCache (< (time/diff @now @entity.cachedAt) @config.cacheTtlMs)))
        (emit AWS_BOARD_LOADING { })
        (set @entity.loading true)
        (set @entity.startedAt @now)
        (set @entity.instances [])
        (set @entity.volumes [])
        (set @entity.amis [])
        (set @entity.buckets [])
        (set @entity.s3Buckets [])
        (set @entity.securityGroups [])
        (set @entity.keyPairs [])
        (set @entity.iamRoles [])
        (set @entity.quotas [])
        (set @entity.costExplorer [])
        (set @entity.history [])
        (set @entity.cursor 0)
        (emit AWS_RUN { stage: "instances", argv: ["ec2", "describe-instances", "--query", "Reservations[*].Instances[*].[InstanceId,InstanceType,State.Name,Tags[?Key==`Name`].Value|[0],LaunchTime,PublicIpAddress,Placement.AvailabilityZone]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_REFRESH -> reading
        (emit AWS_BOARD_LOADING { })
        (set @entity.loading true)
        (set @entity.startedAt @now)
        (set @entity.instances [])
        (set @entity.volumes [])
        (set @entity.amis [])
        (set @entity.buckets [])
        (set @entity.s3Buckets [])
        (set @entity.securityGroups [])
        (set @entity.keyPairs [])
        (set @entity.iamRoles [])
        (set @entity.quotas [])
        (set @entity.costExplorer [])
        (set @entity.history [])
        (set @entity.cursor 0)
        (emit AWS_RUN { stage: "instances", argv: ["ec2", "describe-instances", "--query", "Reservations[*].Instances[*].[InstanceId,InstanceType,State.Name,Tags[?Key==`Name`].Value|[0],LaunchTime,PublicIpAddress,Placement.AvailabilityZone]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_SHOW -> idle
        (let ((irows (array/map @entity.board.instances (fn i (let ((st @i.state)) (let ((r : StatusBoardRow { id: @i.instanceId, section: (if (= @st "running") "running" (if (or (= @st "stopped") (= @st "terminated")) "stopped" "changing")), title: (if (= @i.name "") @i.instanceId @i.name), subtitle: (str/concat @i.instanceType " · " @i.az), tone: (if (= @st "running") "success" (if (= @st "terminated") "danger" (if (= @st "stopped") "neutral" "info"))), statusLabel: (if (= @st "running") "Running" (if (= @st "pending") "Pending" (if (= @st "stopping") "Stopping" (if (= @st "shutting-down") "Shutting down" (if (= @st "stopped") "Stopped" (if (= @st "terminated") "Terminated" @st)))))), icon: "", meta: (array/concat (if (== @i.gpu null) [] [(str/concat @i.gpuCount " × " (default @i.gpu ""))]) [(if (== @i.hourlyUsd null) "unpriced" (str/concat "$" @i.hourlyUsd "/h"))]), at: (let ((t (time/parse @i.launchTime))) (if (== @t null) null (as @t instant))), url: "" })) @r))))) (qrows (array/map @entity.board.quotas (fn q (let ((r : StatusBoardRow { id: (str/concat "quota:" @q.name), section: "quotas", title: @q.name, subtitle: (str/concat @q.used " of " @q.value (if @q.usedComplete "" " · some instances are not in the catalog")), tone: (if (>= @q.used @q.value) "danger" (if (>= (* @q.used 100) (* @q.value @config.quotaWarnPercent)) "warning" "success")), statusLabel: (if (>= @q.used @q.value) "At limit" (if (>= (* @q.used 100) (* @q.value @config.quotaWarnPercent)) "Near limit" "OK")), icon: "", meta: [(if (>= @q.used @q.value) "0 left" (str/concat (- @q.value @q.used) " left"))], at: null, url: "" })) @r)))) (crows (array/map @entity.board.costExplorer (fn c (let ((r : StatusBoardRow { id: (str/concat "cost:" @c.service), section: "cost", title: @c.service, subtitle: (str/concat "Billed " @entity.board.costExplorerPeriod " to date"), tone: "neutral", statusLabel: (str/concat "$" @c.cost), icon: "dollar-sign", meta: [@c.unit], at: null, url: "" })) @r)))))
          (do
            (set @entity.details (array/concat (array/concat (array/map @entity.board.instances (fn i (let ((d : StatusBoardDetail { rowId: @i.instanceId, phase: "ready", items: (array/map (array/concat (array/concat (array/concat (array/concat (array/concat (array/concat [["ID", @i.instanceId], ["Type", @i.instanceType], ["State", @i.state], ["Zone", @i.az], ["Launched", @i.launchTime]] (if (== @i.publicIp null) [] [["Public IP", (default @i.publicIp "")]])) (if (== @i.vcpus null) [] [["vCPUs", (str/concat @i.vcpus)]])) (if (== @i.memoryGb null) [] [["Memory", (str/concat @i.memoryGb " GB")]])) (if (== @i.gpu null) [] [["GPU", (str/concat @i.gpuCount " × " (default @i.gpu ""))], ["GPU memory", (str/concat @i.gpuMemoryGb " GB")]])) (if (== @i.hourlyUsd null) [["Price", "unpriced"]] [["Hourly", (str/concat "$" @i.hourlyUsd)], ["Daily", (str/concat "$" (default @i.dailyUsd 0))], ["Monthly", (str/concat "$" (default @i.monthlyUsd 0))]])) []) (fn p { label: (default (array/nth @p 1) ""), tone: "neutral", statusLabel: (default (array/nth @p 0) ""), meta: "" })), code: "", codeTitle: "", errorLines: [], error: "" })) @d))) (array/map @entity.board.quotas (fn q (let ((d : StatusBoardDetail { rowId: (str/concat "quota:" @q.name), phase: "ready", items: (array/map [["Quota", @q.name], ["Used", (str/concat @q.used)], ["Limit", (str/concat @q.value)], ["Used counted from", (if @q.usedComplete "every running instance" "only instances in the catalog")]] (fn p { label: (default (array/nth @p 1) ""), tone: "neutral", statusLabel: (default (array/nth @p 0) ""), meta: "" })), code: "", codeTitle: "", errorLines: [], error: "" })) @d)))) (array/map @entity.board.costExplorer (fn c (let ((d : StatusBoardDetail { rowId: (str/concat "cost:" @c.service), phase: "ready", items: (array/map [["Service", @c.service], ["Cost", (str/concat "$" @c.cost)], ["Unit", @c.unit], ["Period", @entity.board.costExplorerPeriod]] (fn p { label: (default (array/nth @p 1) ""), tone: "neutral", statusLabel: (default (array/nth @p 0) ""), meta: "" })), code: "", codeTitle: "", errorLines: [], error: "" })) @d)))))
            (emit AWS_BOARD_SHOW { note: @config.region, tiles: [{ label: "Running instances", value: (str/concat (array/count @entity.board.instances (fn i (= @i.state "running")))), tone: "neutral", icon: "server" }, { label: "Month to date", value: (str/concat "$" @entity.board.costExplorerTotal), tone: "neutral", icon: "dollar-sign" }, { label: "Running spend", value: (str/concat "$" @entity.board.runningHourlyCost "/h"), tone: "neutral", icon: "activity" }, { label: "Estimated monthly", value: (str/concat "$" @entity.board.estimatedMonthlyCost), tone: "neutral", icon: "trending-up" }, { label: "Quota headroom", value: (let ((tight (array/nth (array/sort (array/map @entity.board.quotas (fn q { left: (- @q.value @q.used) })) "left" "asc") 0))) (if (== @tight null) "none" (if (<= @tight.left 0) "0 left" (str/concat @tight.left " left")))), tone: (if (array/some @qrows (fn r (= @r.tone "danger"))) "danger" (if (array/some @qrows (fn r (= @r.tone "warning"))) "warning" "neutral")), icon: "gauge" }], sections: [{ key: "running", label: "Running" }, { key: "changing", label: "Changing" }, { key: "stopped", label: "Stopped" }, { key: "quotas", label: "Quotas" }, { key: "cost", label: "Cost" }], rows: (array/concat (array/concat @irows @qrows) @crows), fetchedAt: (let ((t (time/parse @entity.board.fetchedAt))) (if (== @t null) @now (default (as @t instant) @now))), error: "" })))
      AWS_ROW_OPENED -> idle
        (let ((gone : StatusBoardDetail { rowId: @payload.rowId, phase: "failed", items: [], code: "", codeTitle: "", errorLines: [], error: "That row is no longer on the board." }))
          (emit AWS_BOARD_DETAIL { detail: (default (array/find @entity.details (fn x (= @x.rowId @payload.rowId))) @gone) }))
    }

    state reading {
      AWS_ROW_OPENED -> reading
        (let ((gone : StatusBoardDetail { rowId: @payload.rowId, phase: "failed", items: [], code: "", codeTitle: "", errorLines: [], error: "That row is no longer on the board." }))
          (emit AWS_BOARD_DETAIL { detail: (default (array/find @entity.details (fn x (= @x.rowId @payload.rowId))) @gone) }))
      INIT -> reading
      AWS_LOAD -> reading
      AWS_REFRESH -> reading

      AWS_RAN -> reading when (= @payload.stage "instances")
        (when (!= @payload.exitCode 0) (notify error (str/concat "aws failed reading instances (exit " @payload.exitCode "): " (if (= (str/trim @payload.stderr) "") "no error text" (str/trim @payload.stderr)))))
        (set @entity.instances (let ((rows (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (json/parse @payload.stdout AwsInstanceRows) null))) (if (== @rows null) [] (array/map (array/flatten @rows) (fn i (let ((t (default (array/nth @i 1) "")) (spec (object/get @config.catalog (default (array/nth @i 1) "") null))) { instanceId: (default (array/nth @i 0) ""), instanceType: @t, state: (default (array/nth @i 2) ""), name: (default (array/nth @i 3) ""), launchTime: (default (array/nth @i 4) ""), publicIp: (array/nth @i 5), az: (default (array/nth @i 6) ""), vcpus: (if (== @spec null) null @spec.vcpus), memoryGb: (if (== @spec null) null @spec.memoryGb), gpu: (if (== @spec null) null @spec.gpu), gpuCount: (if (== @spec null) 0 @spec.gpuCount), gpuMemoryGb: (if (== @spec null) 0 @spec.gpuMemoryGb), hourlyUsd: (if (== @spec null) null @spec.hourlyUsd), dailyUsd: (if (== @spec null) null (math/round (* @spec.hourlyUsd 24) 2)), monthlyUsd: (if (== @spec null) null (math/round (* @spec.hourlyUsd @config.hoursPerMonth) 2)) }))))))
        (emit AWS_RUN { stage: "volumes", argv: ["ec2", "describe-volumes", "--query", "Volumes[*].[VolumeId,Size,State,VolumeType,AvailabilityZone,Tags[?Key==`Name`].Value|[0],Attachments[0].InstanceId,Iops]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_CLI_FAILED -> idle when (= @payload.stage "instances")
        (set @entity.loading false)
        (emit AWS_BOARD_FAILED { error: (str/concat "aws is not installed or could not run: " @payload.error) })
      AWS_RAN -> reading when (= @payload.stage "volumes")
        (set @entity.volumes (let ((rows (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (json/parse @payload.stdout AwsCells) null))) (if (or (== @rows null) (not (array/every @rows (fn v (!= (str/to-number (str/concat (default (array/nth @v 1) 0))) null))))) [] (array/map @rows (fn v (let ((size (default (str/to-number (str/concat (default (array/nth @v 1) 0))) 0))) { volumeId: (str/concat (default (array/nth @v 0) "")), size: @size, state: (str/concat (default (array/nth @v 2) "")), volumeType: (str/concat (default (array/nth @v 3) "")), az: (str/concat (default (array/nth @v 4) "")), name: (str/concat (default (array/nth @v 5) "")), attachedTo: (let ((at (array/nth @v 6))) (if (validate/string @at) @at null)), iops: (let ((io (array/nth @v 7))) (if (validate/number @io) @io 0)), monthlyCost: (math/round (* @size @config.ebsPerGbMonth) 2) }))))))
        (emit AWS_RUN { stage: "images", argv: ["ec2", "describe-images", "--owners", "self", "--query", "Images[*].[ImageId,Name,State,CreationDate,BlockDeviceMappings[0].Ebs.VolumeSize]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_CLI_FAILED -> reading when (= @payload.stage "volumes")
        (emit AWS_RUN { stage: "images", argv: ["ec2", "describe-images", "--owners", "self", "--query", "Images[*].[ImageId,Name,State,CreationDate,BlockDeviceMappings[0].Ebs.VolumeSize]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_RAN -> reading when (= @payload.stage "images")
        (set @entity.amis (let ((rows (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (json/parse @payload.stdout AwsCells) null))) (if (or (== @rows null) (not (array/every @rows (fn a (!= (str/to-number (str/concat (default (array/nth @a 4) 0))) null))))) [] (array/map @rows (fn a (let ((size (default (str/to-number (str/concat (default (array/nth @a 4) 0))) 0))) { imageId: (str/concat (default (array/nth @a 0) "")), name: (str/concat (default (array/nth @a 1) "")), state: (str/concat (default (array/nth @a 2) "")), created: (str/concat (default (array/nth @a 3) "")), sizeGb: @size, monthlyCost: (math/round (* @size @config.snapshotPerGbMonth) 2) }))))))
        (emit AWS_RUN { stage: "s3", argv: ["s3", "ls", "--region", @config.region, "--output", "json"] })
      AWS_CLI_FAILED -> reading when (= @payload.stage "images")
        (emit AWS_RUN { stage: "s3", argv: ["s3", "ls", "--region", @config.region, "--output", "json"] })
      ;; the nth defaults never fire: each line is non-blank, so it has at least one part
      AWS_RAN -> reading when (= @payload.stage "s3")
        (set @entity.buckets (if (= @payload.exitCode 0) (array/filter (array/map (array/filter (str/split (str/trim @payload.stdout) "\n") (fn l (!= (str/trim @l) ""))) (fn l (let ((parts (array/filter (str/split (str/trim @l) " ") (fn p (!= @p ""))))) (default (array/nth @parts (- (array/len @parts) 1)) "")))) (fn b (array/some @config.bucketNameContains (fn m (str/includes @b @m))))) []))
        (set @entity.cursor 0)
        (emit AWS_BUCKET_NEXT { })
      AWS_CLI_FAILED -> reading when (= @payload.stage "s3")
        (set @entity.cursor 0)
        (emit AWS_BUCKET_NEXT { })
      ;; the bucket default never fires: the cursor is below the bucket count
      AWS_BUCKET_NEXT -> reading when (< @entity.cursor (array/len @entity.buckets))
        (emit AWS_RUN { stage: "bucket", argv: ["s3", "ls", (str/concat "s3://" (default (array/nth @entity.buckets @entity.cursor) "") "/"), "--recursive", "--summarize", "--output", "text"] })
      AWS_BUCKET_NEXT -> reading when (>= @entity.cursor (array/len @entity.buckets))
        (emit AWS_RUN { stage: "security-groups", argv: ["ec2", "describe-security-groups", "--filters", (str/concat "Name=group-name,Values=" @config.securityGroupFilter), "--query", "SecurityGroups[*].[GroupId,GroupName,Description]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_RAN -> reading when (and (= @payload.stage "bucket") (!= (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Objects:"))) "") "Total Objects:") 1) ""))) null) (!= (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Size:"))) "") "Total Size:") 1) ""))) null))
        (set @entity.s3Buckets (array/append @entity.s3Buckets { name: (default (array/nth @entity.buckets @entity.cursor) ""), totalObjects: (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Objects:"))) "") "Total Objects:") 1) ""))), totalSizeMb: (math/round (/ (/ (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Size:"))) "") "Total Size:") 1) ""))) 1024) 1024) 1), monthlyCost: (math/round (* (/ (math/round (/ (/ (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Size:"))) "") "Total Size:") 1) ""))) 1024) 1024) 1) 1024) @config.s3PerGbMonth) 2) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit AWS_BUCKET_NEXT { })
      AWS_RAN -> reading when (and (= @payload.stage "bucket") (or (== (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Objects:"))) "") "Total Objects:") 1) ""))) null) (== (str/to-number (str/trim (default (array/nth (str/split (default (array/find (let ((ls (str/split @payload.stdout "\n"))) (let ((ls2 (if (= (array/nth @ls (- (array/len @ls) 1)) "") (array/take @ls (- (array/len @ls) 1)) @ls))) (array/takeLast @ls2 2))) (fn l (str/includes @l "Total Size:"))) "") "Total Size:") 1) ""))) null)))
        (notify warning "aws answered a bucket summary whose Total Objects or Total Size is not a number; the bucket is left out")
        (set @entity.cursor (+ @entity.cursor 1))
        (emit AWS_BUCKET_NEXT { })
      AWS_CLI_FAILED -> reading when (= @payload.stage "bucket")
        (set @entity.cursor (+ @entity.cursor 1))
        (emit AWS_BUCKET_NEXT { })
      AWS_RAN -> reading when (= @payload.stage "security-groups")
        (set @entity.securityGroups (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (array/map (json/parse @payload.stdout AwsStringRows) (fn g { groupId: (default (array/nth @g 0) ""), groupName: (default (array/nth @g 1) ""), description: (default (array/nth @g 2) "") })) []))
        (emit AWS_RUN { stage: "key-pairs", argv: ["ec2", "describe-key-pairs", "--query", "KeyPairs[*].[KeyName,KeyPairId,CreateTime]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_CLI_FAILED -> reading when (= @payload.stage "security-groups")
        (emit AWS_RUN { stage: "key-pairs", argv: ["ec2", "describe-key-pairs", "--query", "KeyPairs[*].[KeyName,KeyPairId,CreateTime]", "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_RAN -> reading when (= @payload.stage "key-pairs")
        (set @entity.keyPairs (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (array/map (json/parse @payload.stdout AwsStringRows) (fn k { keyName: (default (array/nth @k 0) ""), keyId: (default (array/nth @k 1) ""), created: (default (array/nth @k 2) "") })) []))
        (emit AWS_RUN { stage: "roles", argv: ["iam", "list-roles", "--query", (str/concat "Roles[?contains(RoleName, `" @config.roleNameContains "`)].{RoleName:RoleName,CreateDate:CreateDate}"), "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_CLI_FAILED -> reading when (= @payload.stage "key-pairs")
        (emit AWS_RUN { stage: "roles", argv: ["iam", "list-roles", "--query", (str/concat "Roles[?contains(RoleName, `" @config.roleNameContains "`)].{RoleName:RoleName,CreateDate:CreateDate}"), "--output", "json", "--region", @config.region, "--output", "json"] })
      AWS_RAN -> reading when (= @payload.stage "roles")
        (set @entity.iamRoles (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (array/map (json/parse @payload.stdout AwsRoleRows) (fn r { roleName: @r.RoleName, created: @r.CreateDate })) []))
        (set @entity.cursor 0)
        (emit AWS_QUOTA_NEXT { })
      AWS_CLI_FAILED -> reading when (= @payload.stage "roles")
        (set @entity.cursor 0)
        (emit AWS_QUOTA_NEXT { })
      ;; the code default never fires: the cursor is below the quota count
      AWS_QUOTA_NEXT -> reading when (< @entity.cursor (array/len @config.quotas))
        (emit AWS_RUN { stage: "quota", argv: ["service-quotas", "get-service-quota", "--service-code", "ec2", "--quota-code", (default (array/nth (array/map @config.quotas (fn q @q.code)) @entity.cursor) ""), "--query", "Quota.Value", "--output", "text", "--region", @config.region, "--output", "json"] })
      AWS_QUOTA_NEXT -> reading when (>= @entity.cursor (array/len @config.quotas))
        (emit AWS_RUN { stage: "cost", argv: ["ce", "get-cost-and-usage", "--time-period", (str/concat "Start=" (time/format (time/startOf @entity.startedAt "month") "YYYY-MM-DD") ",End=" (time/format @entity.startedAt "YYYY-MM-DD")), "--granularity", "MONTHLY", "--metrics", "UnblendedCost", "--group-by", "Type=DIMENSION,Key=SERVICE", "--region", @config.region, "--output", "json"] })
      AWS_RAN -> reading when (and (= @payload.stage "quota") (= @payload.exitCode 0) (!= (str/trim @payload.stdout) ""))
        (set @entity.quotas (array/append @entity.quotas (let ((q (array/nth @config.quotas @entity.cursor)))
          { name: @q.name, value: (str/to-number (str/trim @payload.stdout)), used: (if @q.countsRunning (array/reduce (array/filter @entity.instances (fn i (and (= @i.state "running") (array/includes @config.gvtFamilies (array/nth (str/split @i.instanceType ".") 0))))) 0 (fn acc i (+ @acc (default @i.vcpus 0)))) 0), usedComplete: (or (not @q.countsRunning) (not (array/some (array/filter @entity.instances (fn i (and (= @i.state "running") (array/includes @config.gvtFamilies (array/nth (str/split @i.instanceType ".") 0))))) (fn i (== @i.vcpus null))))) })))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit AWS_QUOTA_NEXT { })
      AWS_RAN -> reading when (and (= @payload.stage "quota") (not (and (= @payload.exitCode 0) (!= (str/trim @payload.stdout) ""))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit AWS_QUOTA_NEXT { })
      AWS_CLI_FAILED -> reading when (= @payload.stage "quota")
        (set @entity.cursor (+ @entity.cursor 1))
        (emit AWS_QUOTA_NEXT { })
      AWS_RAN -> reading when (= @payload.stage "cost")
        (when (and (= @payload.exitCode 0) (== (json/parse @payload.stdout AwsCostReply) null)) (notify warning "aws answered the cost explorer read with something that is not a cost report"))
        (set @entity.costExplorer (if (and (= @payload.exitCode 0) (!= (json/parse @payload.stdout AwsCostReply) null) (array/every (default (array/nth (array/map (object/get (json/parse @payload.stdout AwsCostReply) "ResultsByTime" []) (fn b @b.Groups)) 0) []) (fn g (!= (str/to-number (object/get @g "Metrics.UnblendedCost.Amount" "0")) null)))) (array/sort (array/map (default (array/nth (array/map (object/get (json/parse @payload.stdout AwsCostReply) "ResultsByTime" []) (fn b @b.Groups)) 0) []) (fn g { service: (default (array/nth (default @g.Keys []) 0) "Unknown"), cost: (math/round (default (str/to-number (object/get @g "Metrics.UnblendedCost.Amount" "0")) 0) 2), unit: (object/get @g "Metrics.UnblendedCost.Unit" "USD") })) "cost" "desc") []))
        (emit AWS_RUN { stage: "history", argv: ["ce", "get-cost-and-usage", "--time-period", (str/concat "Start=" (time/format (time/subtract @entity.startedAt (* @config.historyDays 86400000) "ms") "YYYY-MM-DD") ",End=" (time/format @entity.startedAt "YYYY-MM-DD")), "--granularity", "MONTHLY", "--metrics", "UnblendedCost", "UsageQuantity", "--filter", (json/stringify { Dimensions: { Key: "SERVICE", Values: ["Amazon Elastic Compute Cloud - Compute"] } }), "--group-by", "Type=DIMENSION,Key=INSTANCE_TYPE", "--region", @config.region, "--output", "json"] })
      AWS_CLI_FAILED -> reading when (= @payload.stage "cost")
        (emit AWS_RUN { stage: "history", argv: ["ce", "get-cost-and-usage", "--time-period", (str/concat "Start=" (time/format (time/subtract @entity.startedAt (* @config.historyDays 86400000) "ms") "YYYY-MM-DD") ",End=" (time/format @entity.startedAt "YYYY-MM-DD")), "--granularity", "MONTHLY", "--metrics", "UnblendedCost", "UsageQuantity", "--filter", (json/stringify { Dimensions: { Key: "SERVICE", Values: ["Amazon Elastic Compute Cloud - Compute"] } }), "--group-by", "Type=DIMENSION,Key=INSTANCE_TYPE", "--region", @config.region, "--output", "json"] })
      ;; the Keys defaults never fire: groups with an empty first key are filtered out first
      AWS_RAN -> idle when (= @payload.stage "history")
        (when (and (= @payload.exitCode 0) (== (json/parse @payload.stdout AwsCostReply) null)) (notify warning "aws answered the instance-type history read with something that is not a cost report"))
        (set @entity.history (if (and (= @payload.exitCode 0) (!= (json/parse @payload.stdout AwsCostReply) null) (array/every (array/flatten (array/map (object/get (json/parse @payload.stdout AwsCostReply) "ResultsByTime" []) (fn b (default @b.Groups [])))) (fn g (and (!= (str/to-number (object/get @g "Metrics.UsageQuantity.Amount" "0")) null) (!= (str/to-number (object/get @g "Metrics.UnblendedCost.Amount" "0")) null))))) (let ((groups (array/filter (array/flatten (array/map (object/get (json/parse @payload.stdout AwsCostReply) "ResultsByTime" []) (fn b (default @b.Groups [])))) (fn g (and (!= (default (array/nth (default @g.Keys []) 0) "") "") (!= (default (array/nth (default @g.Keys []) 0) "") "NoInstanceType"))))))
          (array/sort (array/filter (array/map (array/unique (array/map @groups (fn g (default (array/nth (default @g.Keys []) 0) "")))) (fn t (let ((gs (array/filter @groups (fn g (= (default (array/nth (default @g.Keys []) 0) "") @t)))) (spec (object/get @config.catalog @t null)))
            { instanceType: @t, hours: (math/round (array/reduce @gs 0 (fn acc g (+ @acc (default (str/to-number (object/get @g "Metrics.UsageQuantity.Amount" "0")) 0)))) 1), rawCost: (array/reduce @gs 0 (fn acc g (+ @acc (default (str/to-number (object/get @g "Metrics.UnblendedCost.Amount" "0")) 0)))), cost: (math/round (array/reduce @gs 0 (fn acc g (+ @acc (default (str/to-number (object/get @g "Metrics.UnblendedCost.Amount" "0")) 0)))) 2), vcpus: (if (== @spec null) null @spec.vcpus), memoryGb: (if (== @spec null) null @spec.memoryGb), gpu: (if (== @spec null) null @spec.gpu), gpuCount: (if (== @spec null) 0 @spec.gpuCount) }))) (fn h (>= @h.rawCost @config.minHistoryCost))) "cost" "desc")) []))
        (let ((running (math/round (array/reduce (array/filter @entity.instances (fn i (= @i.state "running"))) 0 (fn acc i (+ @acc (default @i.hourlyUsd 0)))) 2)))
          (set @entity.board {
            instances: @entity.instances, volumes: @entity.volumes, amis: @entity.amis, s3Buckets: @entity.s3Buckets,
            securityGroups: @entity.securityGroups, keyPairs: @entity.keyPairs, iamRoles: @entity.iamRoles, quotas: @entity.quotas,
            costExplorer: @entity.costExplorer,
            costExplorerTotal: (math/round (array/reduce @entity.costExplorer 0 (fn acc c (+ @acc @c.cost))) 2),
            costExplorerPeriod: (time/format @entity.startedAt "YYYY-MM"),
            estimatedMonthlyCost: (math/round (+ (+ (+ (array/reduce @entity.volumes 0 (fn acc v (+ @acc @v.monthlyCost))) (array/reduce @entity.amis 0 (fn acc a (+ @acc @a.monthlyCost)))) (array/reduce @entity.s3Buckets 0 (fn acc b (+ @acc @b.monthlyCost)))) (* @running @config.hoursPerMonth)) 2),
            runningHourlyCost: @running,
            instanceTypeHistory: (array/map @entity.history (fn h { instanceType: @h.instanceType, hours: @h.hours, cost: @h.cost, vcpus: @h.vcpus, memoryGb: @h.memoryGb, gpu: @h.gpu, gpuCount: @h.gpuCount })),
            instanceTypeHistoryDays: @config.historyDays,
            fetchedAt: (str/concat (default (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z") }))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit AWS_BOARD { instances: @entity.board.instances, volumes: @entity.board.volumes, amis: @entity.board.amis, s3Buckets: @entity.board.s3Buckets, securityGroups: @entity.board.securityGroups, keyPairs: @entity.board.keyPairs, iamRoles: @entity.board.iamRoles, quotas: @entity.board.quotas, costExplorer: @entity.board.costExplorer, costExplorerTotal: @entity.board.costExplorerTotal, costExplorerPeriod: @entity.board.costExplorerPeriod, estimatedMonthlyCost: @entity.board.estimatedMonthlyCost, runningHourlyCost: @entity.board.runningHourlyCost, instanceTypeHistory: @entity.board.instanceTypeHistory, instanceTypeHistoryDays: @entity.board.instanceTypeHistoryDays, fetchedAt: @entity.board.fetchedAt })
        (emit AWS_SHOW { })
      AWS_CLI_FAILED -> idle when (= @payload.stage "history")
        (set @entity.history [])
        (let ((running (math/round (array/reduce (array/filter @entity.instances (fn i (= @i.state "running"))) 0 (fn acc i (+ @acc (default @i.hourlyUsd 0)))) 2)))
          (set @entity.board {
            instances: @entity.instances, volumes: @entity.volumes, amis: @entity.amis, s3Buckets: @entity.s3Buckets,
            securityGroups: @entity.securityGroups, keyPairs: @entity.keyPairs, iamRoles: @entity.iamRoles, quotas: @entity.quotas,
            costExplorer: @entity.costExplorer,
            costExplorerTotal: (math/round (array/reduce @entity.costExplorer 0 (fn acc c (+ @acc @c.cost))) 2),
            costExplorerPeriod: (time/format @entity.startedAt "YYYY-MM"),
            estimatedMonthlyCost: (math/round (+ (+ (+ (array/reduce @entity.volumes 0 (fn acc v (+ @acc @v.monthlyCost))) (array/reduce @entity.amis 0 (fn acc a (+ @acc @a.monthlyCost)))) (array/reduce @entity.s3Buckets 0 (fn acc b (+ @acc @b.monthlyCost)))) (* @running @config.hoursPerMonth)) 2),
            runningHourlyCost: @running,
            instanceTypeHistory: (array/map @entity.history (fn h { instanceType: @h.instanceType, hours: @h.hours, cost: @h.cost, vcpus: @h.vcpus, memoryGb: @h.memoryGb, gpu: @h.gpu, gpuCount: @h.gpuCount })),
            instanceTypeHistoryDays: @config.historyDays,
            fetchedAt: (str/concat (default (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z") }))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit AWS_BOARD { instances: @entity.board.instances, volumes: @entity.board.volumes, amis: @entity.board.amis, s3Buckets: @entity.board.s3Buckets, securityGroups: @entity.board.securityGroups, keyPairs: @entity.board.keyPairs, iamRoles: @entity.board.iamRoles, quotas: @entity.board.quotas, costExplorer: @entity.board.costExplorer, costExplorerTotal: @entity.board.costExplorerTotal, costExplorerPeriod: @entity.board.costExplorerPeriod, estimatedMonthlyCost: @entity.board.estimatedMonthlyCost, runningHourlyCost: @entity.board.runningHourlyCost, instanceTypeHistory: @entity.board.instanceTypeHistory, instanceTypeHistoryDays: @entity.board.instanceTypeHistoryDays, fetchedAt: @entity.board.fetchedAt })
        (notify error (str/concat "The aws CLI could not run: " @payload.error))
        (emit AWS_SHOW { })
    }

    emits {
      AWS_BOARD -> external {
        instances : [AwsInstance]!
        volumes : [AwsVolume]!
        amis : [AwsImage]!
        s3Buckets : [AwsBucket]!
        securityGroups : [AwsSecurityGroup]!
        keyPairs : [AwsKeyPair]!
        iamRoles : [AwsIamRole]!
        quotas : [AwsQuota]!
        costExplorer : [AwsServiceCost]!
        costExplorerTotal : number!
        costExplorerPeriod : string!
        estimatedMonthlyCost : number!
        runningHourlyCost : number!
        instanceTypeHistory : [AwsTypeRow]!
        instanceTypeHistoryDays : number!
        fetchedAt : string!
      }
        @description "The AWS board: instances, volumes, images, buckets, groups, keys, roles, quotas, the month's cost per service, billed instance types, the estimates and when it was read."
        @synonyms "aws status, ec2 cost, aws board"
        @tier "primary"
      AWS_LOAD -> internal { }
        @description "Internal: the load a page opening with loadOnInit asks for."
        @tier "internal"
      AWS_SHOW -> internal { }
        @description "Internal: answer the board's figures, rows and details from the board last read."
        @tier "internal"
      AWS_BOARD_LOADING { }
        @description "Internal: a read began."
        @tier "internal"
      AWS_BOARD_SHOW {
        note : string!
        tiles : [StatusBoardTile]!
        sections : [StatusBoardSection]!
        rows : [StatusBoardRow]!
        fetchedAt : instant!
        error : string!
      }
        @description "Internal: the board's figures, sections and rows."
        @tier "internal"
      AWS_BOARD_FAILED {
        error : string!
      }
        @description "Internal: the read failed."
        @tier "internal"
      AWS_BOARD_DETAIL {
        detail : StatusBoardDetail!
      }
        @description "Internal: one row's detail."
        @tier "internal"
      AWS_RUN {
        stage : string!
        argv : [string]!
      }
        @description "Internal: one aws run."
        @tier "internal"
      AWS_BUCKET_NEXT -> internal { }
        @description "Internal: summarize the next bucket, or move on."
        @tier "internal"
      AWS_QUOTA_NEXT -> internal { }
        @description "Internal: read the next quota, or move on."
        @tier "internal"
    }

    listens {
      AWS_LOAD -> input { }
        @description "Answer the AWS board, from the cache while it is fresh."
        @synonyms "show aws, aws cost"
      AWS_REFRESH -> input { }
        @description "Read the AWS board afresh."
        @synonyms "refresh aws"
      AWS_ROW_OPENED {
        rowId : string!
      }
        @description "A board row opened: answer its detail."
      AwsView.BOARD_LOAD -> AWS_LOAD
      AwsView.BOARD_REFRESH -> AWS_REFRESH
      AwsView.BOARD_ROW_OPENED -> AWS_ROW_OPENED with { rowId: ?rowId }
      AWS_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "A std-cli CLI_DONE: one aws run exited."
      AWS_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "A std-cli CLI_FAILED: the aws CLI could not run."
      AwsCli.CLI_DONE -> AWS_RAN
      AwsCli.CLI_FAILED -> AWS_CLI_FAILED
    }

    config {
      loadOnInit : boolean = false
        @label "Load when opened"
        @description "Read the board as soon as its page opens."
        @tier "presentation"
      quotaWarnPercent : number = 80
        @label "Quota warning"
        @description "A quota whose used share reaches this percent is shown as near its limit."
        @tier "domain"
      region : string = "us-east-1"
        @label "Region"
        @description "The AWS region the board reads."
        @tier "domain"
      catalog : Map string AwsSpec = {}
        @label "Instance catalog"
        @description "Specs and on-demand hourly price per EC2 instance type."
        @synonyms "instance types, prices"
        @tier "domain"
      ebsPerGbMonth : number = 0.08
        @description "EBS price per GB-month, applied to every volume."
        @tier "domain"
      snapshotPerGbMonth : number = 0.05
        @description "Snapshot price per GB-month, applied to every own image."
        @tier "domain"
      s3PerGbMonth : number = 0.023
        @description "S3 Standard price per GB-month."
        @tier "domain"
      hoursPerMonth : number = 730
        @description "Hours an always-on instance is billed per month."
        @tier "domain"
      bucketNameContains : [string] = []
        @label "Buckets shown"
        @description "A bucket is shown when its name contains one of these."
        @synonyms "bucket filter"
        @tier "domain"
      securityGroupFilter : string = "*"
        @description "The group-name filter the security groups are listed with."
        @tier "domain"
      roleNameContains : string = ""
        @description "The text a listed role's name contains."
        @tier "domain"
      quotas : [AwsQuotaRef] = []
        @label "Service quotas"
        @description "The EC2 service quotas shown: code, name, and whether running G/VT instances count against it."
        @tier "domain"
      gvtFamilies : [string] = []
        @description "The instance families the G and VT quotas cover."
        @tier "domain"
      historyDays : number = 90
        @description "Days of billed instance-type history."
        @tier "domain"
      minHistoryCost : number = 0.005
        @description "Billed instance types below this cost are left out of the history."
        @tier "domain"
      cacheTtlMs : number = 300000
        @label "Cache window"
        @description "Milliseconds a read board is answered without reading again."
        @tier "infra"
    }
  }

  page "/aws-board" as AwsBoardPage -> AwsStatus, AwsCli, AwsView
}
