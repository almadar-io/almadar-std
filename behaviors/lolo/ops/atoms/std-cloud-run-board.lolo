app std-cloud-run-board [
  version: "1.0.0",
  description: "std-cloud-run-board — a Google Cloud project's Cloud Run services and this month's cost, read through the gcloud and bq CLIs (std-cli, with the host's PATH and HOME passed through so they find their login) and Cloud Monitoring. CLOUD_RUN_LOAD answers CLOUD_RUN_BOARD from the cache within cacheTtlMs; CLOUD_RUN_REFRESH reads afresh; a load during a read is answered by that read. A read, in order: sums each service's billable instance seconds and request count for the UTC month to date from Cloud Monitoring (Monitoring is read over std-http-client with the accessToken credential held by the host, GCLOUD_ACCESS_TOKEN, which std-gcloud-token makes from gcloud's stored Application Default Credentials before the first read and the store renews; usage unavailable, with a not-configured warning naming the missing credential, when the token cannot be made, or when Monitoring is unreachable; a refused metric reads as none); when resourceLevelExport is on, reads each Cloud Run service's gross and net (credits included) cost from the billingExportTable billing export; lists the project's Cloud Run services with each one's template from the same list read (cpu, memory, min and max instances, concurrency, GPU; an unset value is Cloud Run's documented default from the default knobs; a service whose template does not parse has hasResourceData false and zero resources and price); lists the enabled Google Cloud APIs the trackedServices knob names, then replaces them with the month's cost per service from the billing export when it answers rows (each rounded to cents, sorted by cost, highest first, then by name). Per service: hourlyIfUp is one instance's list price for an hour at the rate knobs, activeInstanceHours the billed hours, avgInstances those over the hours elapsed, projectedMonthlyUsd the net cost scaled to hoursPerMonth. actualBilledUsd is the Cloud Run row of the rollup.",
  exec: ["gcloud", "bq"],
  env: ["PATH", "HOME"],
  egress: ["https://oauth2.googleapis.com"],
  net: { "monitoring.googleapis.com:443": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Token from "std/behaviors/std-gcloud-token"
type HttpHeader = { name : string!, value : string! }
uses Spec from "almadar-std/cloud-run-board"
type StatusBoardTile = { label : string!, value : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, icon : string! }
type StatusBoardSection = { key : string!, label : string! }
type StatusBoardRow = { id : string!, section : string!, title : string!, subtitle : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, statusLabel : string!, icon : string!, meta : [string]!, at : instant?, url : string! }
type StatusBoardDetailItem = { label : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, statusLabel : string!, meta : string! }
type StatusBoardDetail = { rowId : string!, phase : "loading" | "ready" | "failed"!, items : [StatusBoardDetailItem]!, code : string!, codeTitle : string!, errorLines : [number]!, error : string! }
type CrCondition = { type : string, status : string }
type CrStatus = { url : string, conditions : [CrCondition], latestReadyRevisionName : string, latestCreatedRevisionName : string }
type CrMeta = { name : string, creationTimestamp : string, annotations : Map string string, labels : Map string string }
type CrService = { metadata : CrMeta, status : CrStatus, spec : CrSpec }
type CrLimits = { limits : Map string string }
type CrContainer = { resources : CrLimits }
type CrTemplateSpec = { containerConcurrency : number, nodeSelector : Map string string, containers : [CrContainer] }
type CrTemplateMeta = { annotations : Map string string }
type CrTemplate = { metadata : CrTemplateMeta, spec : CrTemplateSpec }
type CrSpec = { template : CrTemplate }
type CrResources = { known : boolean!, cpu : number!, memoryGb : number!, minInstances : number!, maxInstances : number!, concurrency : number!, gpuCount : number!, gpu : string, zonal : boolean! }
type CrMonValue = { doubleValue : number, int64Value : string }
type CrMonPoint = { value : CrMonValue }
type CrMonLabels = { service_name : string }
type CrMonResource = { labels : CrMonLabels }
type CrMonSeries = { resource : CrMonResource, points : [CrMonPoint] }
type CrMonReply = { timeSeries : [CrMonSeries] }
type CrSeriesSum = { svc : string!, value : number! }
type CrSeriesSums = [CrSeriesSum]
type CrCostRow = { svc : string!, gross : string!, net : string! }
type CrCost = { svc : string, gross : number, net : number }
type CrBillRow = { service_name : string!, total_cost : string!, currency : string }
type CrApiConfig = { name : string, title : string }
type CrApi = { config : CrApiConfig }
type CrEntry = { service : string!, cost : number!, currency : string! }
type CrServiceRow = { name : string, region : string, url : string, lastDeployed : string, latestRevision : string, status : string, creator : string, hasResourceData : boolean?, cpu : number?, memoryGb : number?, minInstances : number?, maxInstances : number?, concurrency : number?, gpu : string?, gpuCount : number?, hourlyIfUp : number, activeInstanceHours : number, avgInstances : number, requestCount : number, hasUsageData : boolean, grossCostMtd : number, netCostMtd : number, projectedMonthlyUsd : number, hasCostData : boolean }
type CrBilling = { entries : [CrEntry]!, totalCost : number!, currency : string!, billingPeriod : string! }
type CrCloudRun = { services : [CrServiceRow]!, actualBilledUsd : number?, periodHoursElapsed : number }
type CrBillRows = [CrBillRow]
type CrServices = [CrService]
type CrCostRows = [CrCostRow]
type CrApis = [CrApi]
type CrGpuRate = { zonal : number!, noZonal : number! }
orbital CloudRunBoardOrbital {
  uses Cli from "std/behaviors/std-cli"
  uses Board from "std/behaviors/std-status-board"

  entity CloudRunBoard [runtime] {
    id : string!
    ;; nothing read yet: no entries, no cost, no services, until the first read answers
    billing : CrBilling @description "The billing part of the board last answered." = { entries: [], totalCost: 0, currency: "", billingPeriod: "" }
    cloudRun : CrCloudRun @description "The Cloud Run part of the board last answered." = { services: [], periodHoursElapsed: 0 }
    fetchedAt : instant @description "When the read the board came from began." = "1970-01-01T00:00:00.000Z"
    cachedAt : instant @description "ISO-8601 instant at which the board was cached." = "1970-01-01T00:00:00.000Z"
    hasCache : boolean = false
    loading : boolean @description "Whether a read is in flight." = false
    startedAt : instant @description "ISO-8601 instant at which the read in flight began." = "1970-01-01T00:00:00.000Z"
    usageAvailable : boolean = false
    instanceSeconds : [CrSeriesSum] = []
    requests : [CrSeriesSum] = []
    costAvailable : boolean = false
    costRows : [CrCost] = []
    services : [CrService] = []
    resources : [CrResources] = []
    entries : [CrEntry] = []
    currency : string = "USD"
    noMap : Map string string @description "An empty map, read where a part of a reply is absent." = {}
  }

  trait CrGcloud = Cli.traits.CliRunner {
    listens { CloudRunStatus.CR_GCLOUD -> CLI_RUN }
    config {
      commands: ["gcloud"]
      passEnv: ["PATH", "HOME"]
    }
  }

  trait CrBq = Cli.traits.CliRunner {
    listens { CloudRunStatus.CR_BQ -> CLI_RUN }
    config {
      commands: ["bq"]
      passEnv: ["PATH", "HOME"]
    }
  }

  trait CrMonitoringFrame = Frame.traits.HttpFrame {
    listens {
      CrMonitoring.HC_FRAME -> FRAME_RUN
    }
  }

  trait CrMonitoring = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: CR_HTTP_REPLIED
      HTTP_FAILED: CR_HTTP_FAILED
    }
    config {
      host: "monitoring.googleapis.com"
      port: 443
      tls: true
      serverName: "monitoring.googleapis.com"
      credential: "GCLOUD_ACCESS_TOKEN"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      CloudRunStatus.CR_HTTP_SEND -> HTTP_SEND
      CrMonitoringFrame.FRAME_EVENT -> HC_FRAME_EVENT
      CrMonitoringFrame.FRAME_DRAINED -> HC_DRAINED
      CrMonitoringFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait CrToken = Token.traits.GcloudToken {
    events {
      GCLOUD_TOKEN_READY: CR_TOKEN_READY
      GCLOUD_TOKEN_MISSING: CR_TOKEN_MISSING
    }
    listens {
      CloudRunStatus.CR_TOKEN_ENSURE -> GCLOUD_TOKEN_ENSURE
    }
  }

  trait CloudRunView = Board.traits.StatusBoard {
    listens {
      CloudRunStatus.CR_BOARD_LOADING -> BOARD_LOADING
      CloudRunStatus.CR_BOARD_SHOW -> BOARD_SHOW
      CloudRunStatus.CR_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
    }
    config {
      title: "Google Cloud"
      icon: "cloud"
      idleDescription: "Load the board to read the Cloud Run services and this month's cost."
      emptyTitle: "No Cloud Run services"
      emptyDescription: "The project has no Cloud Run services and no billed cost."
    }
  }

  trait CloudRunStatus -> CloudRunBoard [client] {
    initial: idle

    state idle {
      CR_SHOW -> idle
        (let ((cur (default @entity.billing.currency "USD")) (svcs @entity.cloudRun.services) (unhealthy (array/count @entity.cloudRun.services (fn v (= @v.status "Inactive")))))
          (emit CR_BOARD_SHOW { note: (default @config.project ""), fetchedAt: @entity.cachedAt, error: "",
            tiles: [{ label: "Cloud Run services", value: (str/concat (array/len @svcs)), tone: "neutral", icon: "server" },
              (if (> @unhealthy 0) { label: "Not ready", value: (str/concat @unhealthy), tone: "danger", icon: "alert-triangle" } { label: "Not ready", value: "0", tone: "success", icon: "check-circle" }),
              { label: "Month to date", value: (str/concat @cur " " @entity.billing.totalCost), tone: "neutral", icon: "dollar-sign" }],
            sections: [{ key: "services", label: "Services" }, { key: "billing", label: "Billing" }],
            rows: (array/concat
              (array/map @svcs (fn v (let ((name (default @v.name "")) (rev (default @v.latestRevision "")) (deployed (let ((t (time/parse (default @v.lastDeployed "")))) (if (== @t null) null (as @t instant)))))
                (let ((sub (if (= (default @v.url "") "") (default @v.region "") (str/concat (default @v.region "") " · " (default @v.url ""))))
                      (meta (array/concat (if (= @rev "") (array/take [""] 0) [(str/concat "rev " @rev)]) (if (== @v.hasResourceData true) [(str/concat (default @v.cpu 0) " vCPU, " (default @v.memoryGb 0) " GiB")] (array/take [""] 0)) (if (default @v.hasCostData false) [(str/concat @cur " " (default @v.netCostMtd 0))] (array/take [""] 0)))))
                  (if (= @v.status "Active") (let ((r : StatusBoardRow { id: @name, section: "services", title: @name, subtitle: @sub, tone: "success", statusLabel: "Ready", icon: "", meta: @meta, at: @deployed, url: (default @v.url "") })) @r) (if (= @v.status "Inactive") (let ((r : StatusBoardRow { id: @name, section: "services", title: @name, subtitle: @sub, tone: "danger", statusLabel: "Not ready", icon: "", meta: @meta, at: @deployed, url: (default @v.url "") })) @r) (let ((r : StatusBoardRow { id: @name, section: "services", title: @name, subtitle: @sub, tone: "neutral", statusLabel: "Unknown", icon: "", meta: @meta, at: @deployed, url: (default @v.url "") })) @r)))))))
              (array/map @entity.billing.entries (fn e (let ((r : StatusBoardRow { id: (str/concat "billing:" @e.service), section: "billing", title: @e.service, subtitle: @entity.billing.billingPeriod, tone: "neutral", statusLabel: (str/concat @e.cost), icon: "", meta: [], at: null, url: "" })) @r)))) }))
      CR_ROW_OPENED -> idle
        (let ((v (array/find @entity.cloudRun.services (fn x (= (default @x.name "") @payload.rowId)))) (e (array/find @entity.billing.entries (fn x (= (str/concat "billing:" @x.service) @payload.rowId)))) (cur (default @entity.billing.currency "USD")))
          (emit CR_BOARD_DETAIL { detail: (if (!= @v null)
            { rowId: @payload.rowId, phase: "ready", code: "", codeTitle: "", errorLines: [], error: "",
              items: (array/concat [{ label: "Status", tone: "neutral", statusLabel: (default @v.status ""), meta: "" }, { label: "Region", tone: "neutral", statusLabel: (default @v.region ""), meta: "" }, { label: "Latest revision", tone: "neutral", statusLabel: (default @v.latestRevision ""), meta: "" }, { label: "Last deployed", tone: "neutral", statusLabel: (default @v.lastDeployed ""), meta: "" }, { label: "Created by", tone: "neutral", statusLabel: (default @v.creator ""), meta: "" }]
                (if (== @v.hasResourceData true) [{ label: "Size", tone: "neutral", statusLabel: (str/concat (default @v.cpu 0) " vCPU, " (default @v.memoryGb 0) " GiB"), meta: (if (> (default @v.gpuCount 0) 0) (str/concat (default @v.gpuCount 0) " " (default @v.gpu "")) "") }, { label: "Instances", tone: "neutral", statusLabel: (str/concat (default @v.minInstances 0) "–" (default @v.maxInstances 0)), meta: (str/concat "concurrency " (default @v.concurrency 0)) }, { label: "List price per instance hour", tone: "neutral", statusLabel: (str/concat @cur " " (default @v.hourlyIfUp 0)), meta: "" }] (array/take [{ label: "", tone: "neutral", statusLabel: "", meta: "" }] 0))
                (if (default @v.hasUsageData false) [{ label: "Active instance hours", tone: "neutral", statusLabel: (str/concat (default @v.activeInstanceHours 0)), meta: (str/concat "average " (default @v.avgInstances 0) " instances") }, { label: "Requests", tone: "neutral", statusLabel: (str/concat (default @v.requestCount 0)), meta: "" }] (array/take [{ label: "", tone: "neutral", statusLabel: "", meta: "" }] 0))
                (if (default @v.hasCostData false) [{ label: "Net cost to date", tone: "neutral", statusLabel: (str/concat @cur " " (default @v.netCostMtd 0)), meta: (str/concat "gross " (default @v.grossCostMtd 0)) }, { label: "Projected month", tone: "neutral", statusLabel: (str/concat @cur " " (default @v.projectedMonthlyUsd 0)), meta: "" }] (array/take [{ label: "", tone: "neutral", statusLabel: "", meta: "" }] 0))) }
            (if (!= @e null)
              { rowId: @payload.rowId, phase: "ready", code: "", codeTitle: "", errorLines: [], error: "", items: [{ label: "Month to date", tone: "neutral", statusLabel: (str/concat @cur " " @e.cost), meta: @entity.billing.billingPeriod }] }
              { rowId: @payload.rowId, phase: "failed", items: [], code: "", codeTitle: "", errorLines: [], error: "The row is no longer on the board" })) }))
      CLOUD_RUN_LOAD -> idle when (and @entity.hasCache (< (time/diff @now @entity.cachedAt "ms") @config.cacheTtlMs))
        (emit CLOUD_RUN_BOARD { billing: @entity.billing, cloudRun: @entity.cloudRun, fetchedAt: @entity.fetchedAt })
        (emit CR_SHOW { })
      CLOUD_RUN_LOAD -> reading when (not (and @entity.hasCache (< (time/diff @now @entity.cachedAt "ms") @config.cacheTtlMs)))
        (set @entity.loading true)
        (emit CR_BOARD_LOADING { })
        (set @entity.startedAt (time/now))
        (set @entity.usageAvailable false)
        (set @entity.instanceSeconds [])
        (set @entity.requests [])
        (set @entity.costAvailable false)
        (set @entity.costRows [])
        (set @entity.services [])
        (set @entity.resources [])
        (set @entity.entries [])
        (set @entity.noMap (object/fromEntries (array/take [["", ""]] 0)))
        (emit CR_TOKEN_ENSURE { })
      CLOUD_RUN_REFRESH -> reading
        (set @entity.loading true)
        (emit CR_BOARD_LOADING { })
        (set @entity.startedAt (time/now))
        (set @entity.usageAvailable false)
        (set @entity.instanceSeconds [])
        (set @entity.requests [])
        (set @entity.costAvailable false)
        (set @entity.costRows [])
        (set @entity.services [])
        (set @entity.resources [])
        (set @entity.entries [])
        (set @entity.noMap (object/fromEntries (array/take [["", ""]] 0)))
        (emit CR_TOKEN_ENSURE { })
    }

    state reading {
      CR_ROW_OPENED -> reading
        (let ((v (array/find @entity.cloudRun.services (fn x (= (default @x.name "") @payload.rowId)))) (e (array/find @entity.billing.entries (fn x (= (str/concat "billing:" @x.service) @payload.rowId)))) (cur (default @entity.billing.currency "USD")))
          (emit CR_BOARD_DETAIL { detail: (if (!= @v null)
            { rowId: @payload.rowId, phase: "ready", code: "", codeTitle: "", errorLines: [], error: "",
              items: (array/concat [{ label: "Status", tone: "neutral", statusLabel: (default @v.status ""), meta: "" }, { label: "Region", tone: "neutral", statusLabel: (default @v.region ""), meta: "" }, { label: "Latest revision", tone: "neutral", statusLabel: (default @v.latestRevision ""), meta: "" }, { label: "Last deployed", tone: "neutral", statusLabel: (default @v.lastDeployed ""), meta: "" }, { label: "Created by", tone: "neutral", statusLabel: (default @v.creator ""), meta: "" }]
                (if (== @v.hasResourceData true) [{ label: "Size", tone: "neutral", statusLabel: (str/concat (default @v.cpu 0) " vCPU, " (default @v.memoryGb 0) " GiB"), meta: (if (> (default @v.gpuCount 0) 0) (str/concat (default @v.gpuCount 0) " " (default @v.gpu "")) "") }, { label: "Instances", tone: "neutral", statusLabel: (str/concat (default @v.minInstances 0) "–" (default @v.maxInstances 0)), meta: (str/concat "concurrency " (default @v.concurrency 0)) }, { label: "List price per instance hour", tone: "neutral", statusLabel: (str/concat @cur " " (default @v.hourlyIfUp 0)), meta: "" }] (array/take [{ label: "", tone: "neutral", statusLabel: "", meta: "" }] 0))
                (if (default @v.hasUsageData false) [{ label: "Active instance hours", tone: "neutral", statusLabel: (str/concat (default @v.activeInstanceHours 0)), meta: (str/concat "average " (default @v.avgInstances 0) " instances") }, { label: "Requests", tone: "neutral", statusLabel: (str/concat (default @v.requestCount 0)), meta: "" }] (array/take [{ label: "", tone: "neutral", statusLabel: "", meta: "" }] 0))
                (if (default @v.hasCostData false) [{ label: "Net cost to date", tone: "neutral", statusLabel: (str/concat @cur " " (default @v.netCostMtd 0)), meta: (str/concat "gross " (default @v.grossCostMtd 0)) }, { label: "Projected month", tone: "neutral", statusLabel: (str/concat @cur " " (default @v.projectedMonthlyUsd 0)), meta: "" }] (array/take [{ label: "", tone: "neutral", statusLabel: "", meta: "" }] 0))) }
            (if (!= @e null)
              { rowId: @payload.rowId, phase: "ready", code: "", codeTitle: "", errorLines: [], error: "", items: [{ label: "Month to date", tone: "neutral", statusLabel: (str/concat @cur " " @e.cost), meta: @entity.billing.billingPeriod }] }
              { rowId: @payload.rowId, phase: "failed", items: [], code: "", codeTitle: "", errorLines: [], error: "The row is no longer on the board" })) }))
      INIT -> reading
      CLOUD_RUN_LOAD -> reading
      CLOUD_RUN_REFRESH -> reading

      CR_TOKEN_READY -> reading
        (emit CR_MONITOR { })
      CR_TOKEN_MISSING -> reading
        (set @entity.instanceSeconds [])
        (set @entity.requests [])
        (set @entity.usageAvailable false)
        (notify warning @payload.message)
        (emit CR_COST { })

      CR_MONITOR -> reading
        (emit CR_HTTP_SEND { key: "time", method: "GET", target: (str/concat "/v3/projects/" @config.project "/timeSeries?" (str/join (array/map (object/entries { filter: "metric.type=\"run.googleapis.com/container/billable_instance_time\"", "interval.startTime": (time/startOf @entity.startedAt "month"), "interval.endTime": @entity.startedAt, "aggregation.alignmentPeriod": (str/concat (math/max 60 (math/round (time/diff @entity.startedAt (time/startOf @entity.startedAt "month") "s") 0)) "s"), "aggregation.perSeriesAligner": "ALIGN_SUM", "aggregation.crossSeriesReducer": "REDUCE_SUM", "aggregation.groupByFields": "resource.label.\"service_name\"" }) (fn kv (str/concat (str/encode-uri-component (default (array/nth @kv 0) "")) "=" (str/encode-uri-component (default (array/nth @kv 1) ""))))) "&")), headers: [], body: (bytes/from-string ""), stream: "none" })
        (emit CR_COST { })
      CR_REPLIED -> reading when (and (= @payload.key "time") (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse (default (bytes/to-string @payload.body) "") CrMonReply) null)))
        (set @entity.instanceSeconds (array/filter (array/map (object/get (json/parse (default (bytes/to-string @payload.body) "") CrMonReply) "timeSeries" []) (fn ts { svc: (object/get @ts "resource.labels.service_name" ""), value: (array/reduce (object/get @ts "points" []) 0 (fn acc p (+ @acc (if (!= (object/get @p "value.doubleValue" null) null) (object/get @p "value.doubleValue" 0) (str/to-number (object/get @p "value.int64Value" "0")))))) })) (fn x (!= @x.svc ""))))
        (emit CR_HTTP_SEND { key: "requests", method: "GET", target: (str/concat "/v3/projects/" @config.project "/timeSeries?" (str/join (array/map (object/entries { filter: "metric.type=\"run.googleapis.com/request_count\"", "interval.startTime": (time/startOf @entity.startedAt "month"), "interval.endTime": @entity.startedAt, "aggregation.alignmentPeriod": (str/concat (math/max 60 (math/round (time/diff @entity.startedAt (time/startOf @entity.startedAt "month") "s") 0)) "s"), "aggregation.perSeriesAligner": "ALIGN_SUM", "aggregation.crossSeriesReducer": "REDUCE_SUM", "aggregation.groupByFields": "resource.label.\"service_name\"" }) (fn kv (str/concat (str/encode-uri-component (default (array/nth @kv 0) "")) "=" (str/encode-uri-component (default (array/nth @kv 1) ""))))) "&")), headers: [], body: (bytes/from-string ""), stream: "none" })
      CR_REPLIED -> reading when (and (= @payload.key "time") (not (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse (default (bytes/to-string @payload.body) "") CrMonReply) null))))
        (notify warning "Cloud Monitoring time series could not be read: the reply is not a time-series list")
        (set @entity.instanceSeconds [])
        (emit CR_HTTP_SEND { key: "requests", method: "GET", target: (str/concat "/v3/projects/" @config.project "/timeSeries?" (str/join (array/map (object/entries { filter: "metric.type=\"run.googleapis.com/request_count\"", "interval.startTime": (time/startOf @entity.startedAt "month"), "interval.endTime": @entity.startedAt, "aggregation.alignmentPeriod": (str/concat (math/max 60 (math/round (time/diff @entity.startedAt (time/startOf @entity.startedAt "month") "s") 0)) "s"), "aggregation.perSeriesAligner": "ALIGN_SUM", "aggregation.crossSeriesReducer": "REDUCE_SUM", "aggregation.groupByFields": "resource.label.\"service_name\"" }) (fn kv (str/concat (str/encode-uri-component (default (array/nth @kv 0) "")) "=" (str/encode-uri-component (default (array/nth @kv 1) ""))))) "&")), headers: [], body: (bytes/from-string ""), stream: "none" })
      CR_REPLIED -> reading when (and (= @payload.key "requests") (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse (default (bytes/to-string @payload.body) "") CrMonReply) null)))
        (set @entity.requests (array/filter (array/map (object/get (json/parse (default (bytes/to-string @payload.body) "") CrMonReply) "timeSeries" []) (fn ts { svc: (object/get @ts "resource.labels.service_name" ""), value: (array/reduce (object/get @ts "points" []) 0 (fn acc p (+ @acc (if (!= (object/get @p "value.doubleValue" null) null) (object/get @p "value.doubleValue" 0) (str/to-number (object/get @p "value.int64Value" "0")))))) })) (fn x (!= @x.svc ""))))
        (set @entity.usageAvailable true)
        (emit CR_COST { })
      CR_REPLIED -> reading when (and (= @payload.key "requests") (not (and (>= @payload.status 200) (< @payload.status 300) (!= (json/parse (default (bytes/to-string @payload.body) "") CrMonReply) null))))
        (notify warning "Cloud Monitoring requests series could not be read: the reply is not a time-series list")
        (set @entity.requests [])
        (set @entity.usageAvailable false)
        (emit CR_COST { })
      CR_FAILED -> reading
        (set @entity.instanceSeconds [])
        (set @entity.requests [])
        (set @entity.usageAvailable false)
        (notify warning (str/concat "Cloud Monitoring unreachable: " @payload.error))
        (emit CR_COST { })

      CR_COST -> reading when (and @config.resourceLevelExport (!= @config.billingExportTable ""))
        (emit CR_BQ { stage: "cost", argv: [(str/concat "--project_id=" @config.project), "query", "--use_legacy_sql=false", "--format=json", (str/concat "SELECT resource.name AS svc,   SUM(cost) AS gross,   SUM(cost) + SUM(IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0)) AS net FROM `" @config.project ".billing_export." @config.billingExportTable "` WHERE service.description = 'Cloud Run' AND DATE(usage_start_time) >= '" (time/format (time/startOf @entity.startedAt "month") "YYYY-MM-DD") "' GROUP BY svc")] })
      CR_COST -> reading when (not (and @config.resourceLevelExport (!= @config.billingExportTable "")))
        (emit CR_GCLOUD { stage: "services", argv: ["run", "services", "list", (str/concat "--project=" @config.project), "--format=json"] })
      CR_RAN -> reading when (and (= @payload.stage "cost") (= @payload.exitCode 0) (json/valid (if (= (str/trim @payload.stdout) "") "[]" @payload.stdout)))
        (let ((rows (json/parse (if (= (str/trim @payload.stdout) "") "[]" @payload.stdout) CrCostRows)))
          (do
            (when (!= @rows null)
              (do
                (set @entity.costAvailable true)
                (set @entity.costRows (array/reduce @rows @entity.costRows (fn (acc row) (let ((g (str/to-number @row.gross)) (n (str/to-number @row.net))) (if (or (= (default @row.svc "") "") (= @g null) (= @n null)) @acc (array/concat @acc [{ svc: @row.svc, gross: @g, net: @n }]))))))))
            (emit CR_GCLOUD { stage: "services", argv: ["run", "services", "list", (str/concat "--project=" @config.project), "--format=json"] })))
      CR_RAN -> reading when (and (= @payload.stage "cost") (not (and (= @payload.exitCode 0) (json/valid (if (= (str/trim @payload.stdout) "") "[]" @payload.stdout)))))
        (emit CR_GCLOUD { stage: "services", argv: ["run", "services", "list", (str/concat "--project=" @config.project), "--format=json"] })

      CR_RAN -> reading when (and (= @payload.stage "services") (= @payload.exitCode 0) (!= (json/parse @payload.stdout CrServices) null))
        (set @entity.services (json/parse @payload.stdout CrServices))
        (set @entity.resources (array/map @entity.services (fn d (let ((limits (object/get @d "spec.template.spec.containers.0.resources.limits" @entity.noMap))
                  (ann (object/get @d "spec.template.metadata.annotations" @entity.noMap))
                  (selector (object/get @d "spec.template.spec.nodeSelector" @entity.noMap)))
              (let ((cpuRaw (array/nth (object/values (object/pick @limits [(str/concat "cpu")])) 0)) (memRaw (array/nth (object/values (object/pick @limits [(str/concat "memory")])) 0)) (gpuRaw (array/nth (object/values (object/pick @limits [(str/concat "nvidia.com/gpu")])) 0)) (minRaw (array/nth (object/values (object/pick @ann [(str/concat "autoscaling.knative.dev/minScale")])) 0)) (maxRaw (array/nth (object/values (object/pick @ann [(str/concat "autoscaling.knative.dev/maxScale")])) 0)))
                (let ((cpu (if (== @cpuRaw null) @config.defaultCpu (if (str/endsWith @cpuRaw "m") (let ((v (str/to-number (str/slice @cpuRaw 0 (- (str/len @cpuRaw) 1))))) (if (== @v null) null (/ @v 1000))) (str/to-number @cpuRaw))))
                      (memoryGb (if (== @memRaw null) @config.defaultMemoryGb (let ((m (str/trim @memRaw))) (if (or (str/endsWith @m "Gi") (str/endsWith @m "Mi") (str/endsWith @m "Ki")) (let ((v (str/to-number (str/trim (str/slice @m 0 (- (str/len @m) 2)))))) (if (== @v null) null (/ @v (if (str/endsWith @m "Gi") 1 (if (str/endsWith @m "Mi") 1024 1048576))))) (if (or (str/endsWith @m "G") (str/endsWith @m "M") (str/endsWith @m "K")) (let ((v (str/to-number (str/trim (str/slice @m 0 (- (str/len @m) 1)))))) (if (== @v null) null (/ @v (if (str/endsWith @m "G") 1 (if (str/endsWith @m "M") 1024 1048576))))) (let ((v (str/to-number @m))) (if (== @v null) null (/ @v 1073741824))))))))
                      (minInstances (if (== @minRaw null) @config.defaultMinInstances (str/to-number @minRaw)))
                      (maxInstances (if (== @maxRaw null) @config.defaultMaxInstances (str/to-number @maxRaw)))
                      (gpuCount (if (== @gpuRaw null) 0 (str/to-number @gpuRaw))))
                  (if (or (== @cpu null) (== @memoryGb null) (== @minInstances null) (== @maxInstances null) (== @gpuCount null)) { known: false, cpu: 0, memoryGb: 0, minInstances: 0, maxInstances: 0, concurrency: 0, gpuCount: 0, zonal: true }
                    { known: true,
                      cpu: @cpu,
                      memoryGb: @memoryGb,
                      minInstances: @minInstances,
                      maxInstances: @maxInstances,
                      concurrency: (object/get @d "spec.template.spec.containerConcurrency" @config.defaultConcurrency),
                      gpuCount: @gpuCount,
                      gpu: (if (> @gpuCount 0) (array/nth (object/values (object/pick @selector [(str/concat "run.googleapis.com/accelerator")])) 0) (array/nth (object/values (object/pick @entity.noMap [(str/concat "gpu")])) 0)),
                      zonal: (!= (array/nth (object/values (object/pick @ann [(str/concat "run.googleapis.com/gpu-zonal-redundancy-disabled")])) 0) "true") })))))))
        (emit CR_GCLOUD { stage: "enabled", argv: ["services", "list", "--enabled", (str/concat "--project=" @config.project), "--format=json"] })
      CR_RAN -> reading when (and (= @payload.stage "services") (not (and (= @payload.exitCode 0) (!= (json/parse @payload.stdout CrServices) null))))
        (notify warning (str/concat "Cloud Run services could not be read: " @payload.stderr))
        (set @entity.services [])
        (emit CR_GCLOUD { stage: "enabled", argv: ["services", "list", "--enabled", (str/concat "--project=" @config.project), "--format=json"] })
      CR_RAN -> reading when (= @payload.stage "enabled")
        (let ((apis (if (and (= @payload.exitCode 0) (json/valid @payload.stdout)) (json/parse @payload.stdout CrApis) null)))
          (set @entity.entries (if (= @apis null) [] (array/map (array/filter @apis (fn a (!= (array/nth (object/values (object/pick @config.trackedServices [(object/get @a "config.name" "")])) 0) null))) (fn a { service: (array/nth (object/values (object/pick @config.trackedServices [(object/get @a "config.name" "")])) 0), cost: 0, currency: "USD" })))))
        (set @entity.currency "USD")
        (emit CR_ROLLUP { })
      CR_ROLLUP -> reading when (!= @config.billingExportTable "")
        (emit CR_BQ { stage: "rollup", argv: [(str/concat "--project_id=" @config.project), "query", "--use_legacy_sql=false", "--format=json", (str/concat "SELECT service.description AS service_name,   SUM(cost) + SUM(IFNULL((SELECT SUM(c.amount) FROM UNNEST(credits) c), 0)) AS total_cost,   currency FROM `" @config.project ".billing_export." @config.billingExportTable "` WHERE DATE(usage_start_time) >= '" (time/format (time/startOf @entity.startedAt "month") "YYYY-MM-DD") "' GROUP BY service_name, currency ORDER BY total_cost DESC")] })
      CR_ROLLUP -> reading when (= @config.billingExportTable "")
        (emit CR_ANSWER { })
      CR_RAN -> reading when (and (= @payload.stage "rollup") (= @payload.exitCode 0) (!= (str/trim @payload.stdout) "") (json/valid @payload.stdout))
        (let ((rows (json/parse @payload.stdout CrBillRows)) (none : [CrEntry] []))
          (do
            (when (!= @rows null)
              (when (> (array/len @rows) 0)
                (let ((built (array/reduce @rows { ok: true, es: @none } (fn (acc row) (let ((c (str/to-number @row.total_cost))) (if (or (not @acc.ok) (= @c null)) { ok: false, es: @acc.es } { ok: true, es: (array/concat @acc.es [{ service: @row.service_name, cost: (math/round @c 2), currency: (default @row.currency "USD") }]) }))))))
                  (when @built.ok
                    (do
                      (set @entity.entries @built.es)
                      (set @entity.currency (let ((lastRow (let ((nxi (- (array/len @rows) 1))) (if (>= @nxi 0) (array/nth @rows @nxi) null)))) (if (== @lastRow null) "USD" (default @lastRow.currency "USD")))))))))
            (emit CR_ANSWER { })))
      CR_RAN -> reading when (and (= @payload.stage "rollup") (not (and (= @payload.exitCode 0) (!= (str/trim @payload.stdout) "") (json/valid @payload.stdout))))
        (emit CR_ANSWER { })

      CR_ANSWER -> idle
        (set @entity.billing { entries: (array/sort (array/sort @entity.entries "service" "asc") "cost" "desc"), totalCost: (math/round (array/reduce @entity.entries 0 (fn acc e (+ @acc @e.cost))) 2), currency: @entity.currency, billingPeriod: (time/format @entity.startedAt "YYYY-MM") })
        (set @entity.cloudRun { services: (array/map @entity.services (fn svc (let ((r (array/nth @entity.resources (array/indexOf @entity.services @svc))))
            (let ((name (object/get @svc "metadata.name" "")) (ready (array/find (object/get @svc "status.conditions" []) (fn c (= @c.type "Ready")))) (cost (array/find @entity.costRows (fn c (= @c.svc (object/get @svc "metadata.name" ""))))))
              { name: @name,
                region: (default (array/nth (object/values (object/pick (object/get @svc "metadata.labels" @entity.noMap) [(str/concat "cloud.googleapis.com/location")])) 0) ""),
                url: (object/get @svc "status.url" ""),
                lastDeployed: (default (array/nth (object/values (object/pick (object/get @svc "metadata.annotations" @entity.noMap) [(str/concat "serving.knative.dev/lastModified")])) 0) (object/get @svc "metadata.creationTimestamp" "")),
                latestRevision: (default (object/get @svc "status.latestReadyRevisionName" null) (object/get @svc "status.latestCreatedRevisionName" "")),
                status: (if (== @ready null) "Unknown" (if (= @ready.status "True") "Active" "Inactive")),
                creator: (default (array/nth (object/values (object/pick (object/get @svc "metadata.annotations" @entity.noMap) [(str/concat "serving.knative.dev/creator")])) 0) ""),
                hasResourceData: @r.known, cpu: @r.cpu, memoryGb: @r.memoryGb, minInstances: @r.minInstances, maxInstances: @r.maxInstances, concurrency: @r.concurrency, gpu: @r.gpu, gpuCount: @r.gpuCount,
                hourlyIfUp: (if (== @r.known true) (math/round (* (+ (+ (* @r.cpu @config.cpuRatePerSecond) (* @r.memoryGb @config.memoryRatePerSecond)) (let ((rate (object/get @config.gpuRatesPerSecond (default @r.gpu "") null))) (if (and (!= @r.gpu null) (> @r.gpuCount 0) (!= @rate null)) (* @r.gpuCount (if @r.zonal @rate.zonal @rate.noZonal)) 0))) 3600) 4) 0),
                activeInstanceHours: (math/round (/ (array/reduce (array/filter @entity.instanceSeconds (fn x (= @x.svc @name))) 0 (fn acc x (+ @acc @x.value))) 3600) 2),
                avgInstances: (math/round (default (/ (math/round (/ (array/reduce (array/filter @entity.instanceSeconds (fn x (= @x.svc @name))) 0 (fn acc x (+ @acc @x.value))) 3600) 2) (/ (math/max 60 (math/round (time/diff @entity.startedAt (time/startOf @entity.startedAt "month") "s") 0)) 3600)) 0) 3),
                requestCount: (math/round (array/reduce (array/filter @entity.requests (fn x (= @x.svc @name))) 0 (fn acc x (+ @acc @x.value))) 0),
                hasUsageData: @entity.usageAvailable,
                grossCostMtd: (math/round (if (== @cost null) 0 @cost.gross) 4),
                netCostMtd: (math/round (if (== @cost null) 0 @cost.net) 4),
                projectedMonthlyUsd: (math/round (* (if (== @cost null) 0 @cost.net) (default (/ @config.hoursPerMonth (/ (math/max 60 (math/round (time/diff @entity.startedAt (time/startOf @entity.startedAt "month") "s") 0)) 3600)) 0)) 2),
                hasCostData: @entity.costAvailable })))), actualBilledUsd: (object/get (default (array/find @entity.entries (fn e (= @e.service "Cloud Run"))) {}) "cost" null), periodHoursElapsed: (math/round (/ (math/max 60 (math/round (time/diff @entity.startedAt (time/startOf @entity.startedAt "month") "s") 0)) 3600) 1) })
        (set @entity.fetchedAt @entity.startedAt)
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit CLOUD_RUN_BOARD { billing: @entity.billing, cloudRun: @entity.cloudRun, fetchedAt: @entity.fetchedAt })
        (emit CR_SHOW { })

      CR_CLI_FAILED -> reading when (= @payload.stage "cost")
        (emit CR_GCLOUD { stage: "services", argv: ["run", "services", "list", (str/concat "--project=" @config.project), "--format=json"] })
      CR_CLI_FAILED -> reading when (= @payload.stage "services")
        (set @entity.services [])
        (emit CR_GCLOUD { stage: "enabled", argv: ["services", "list", "--enabled", (str/concat "--project=" @config.project), "--format=json"] })
      CR_CLI_FAILED -> reading when (= @payload.stage "enabled")
        (set @entity.entries [])
        (emit CR_ROLLUP { })
      CR_CLI_FAILED -> reading when (= @payload.stage "rollup")
        (emit CR_ANSWER { })
    }

    emits {
      CLOUD_RUN_BOARD -> external {
        billing : CrBilling!
        cloudRun : CrCloudRun!
        fetchedAt : instant!
      }
        @description "The board: the month's cost per Google Cloud service, the Cloud Run services with resources, usage and cost, and when it was read."
        @synonyms "cloud run status, gcp cost, cloud board"
        @tier "primary"
      CR_BOARD_LOADING { }
        @description "Internal: a read began, to the board."
        @tier "internal"
      CR_BOARD_SHOW {
        note : string!
        tiles : [StatusBoardTile]!
        sections : [StatusBoardSection]!
        rows : [StatusBoardRow]!
        fetchedAt : instant!
        error : string!
      }
        @description "Internal: the figures, sections and rows, to the board."
        @tier "internal"
      CR_BOARD_DETAIL {
        detail : StatusBoardDetail!
      }
        @description "Internal: one row's detail, to the board."
        @tier "internal"
      CR_SHOW -> internal { }
        @description "Internal: show the held board."
        @tier "internal"
      CR_GCLOUD {
        stage : string!
        argv : [string]!
      }
        @description "Internal: one gcloud run."
        @tier "internal"
      CR_BQ {
        stage : string!
        argv : [string]!
      }
        @description "Internal: one bq run."
        @tier "internal"
      CR_TOKEN_ENSURE { }
        @description "Internal: make sure the Google access token is held before the Monitoring read."
        @tier "internal"
      CR_MONITOR -> internal { }
        @description "Internal: read the month's usage from Cloud Monitoring."
        @tier "internal"
      CR_COST -> internal { }
        @description "Internal: read the per-service cost."
        @tier "internal"
      CR_ROLLUP -> internal { }
        @description "Internal: read the month's cost per service."
        @tier "internal"
      CR_ANSWER -> internal { }
        @description "Internal: answer the board."
        @tier "internal"
      CR_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one request, for the HTTP client."
        @tier "internal"
    }

    listens {
      CLOUD_RUN_LOAD -> input { }
        @description "Answer the Google Cloud board, from the cache while it is fresh."
        @synonyms "show cloud run, gcp cost"
      CLOUD_RUN_REFRESH -> input { }
        @description "Read the Google Cloud board afresh."
        @synonyms "refresh cloud run"
      CR_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "A std-cli CLI_DONE: one gcloud or bq run exited."
      CR_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "A std-cli CLI_FAILED: gcloud or bq could not run."
      CR_ROW_OPENED {
        rowId : string!
      }
        @description "The board opened a row: its detail is answered from the held board."
      CloudRunView.BOARD_LOAD -> CLOUD_RUN_LOAD
      CloudRunView.BOARD_REFRESH -> CLOUD_RUN_REFRESH
      CloudRunView.BOARD_ROW_OPENED -> CR_ROW_OPENED
      CrGcloud.CLI_DONE -> CR_RAN
      CrGcloud.CLI_FAILED -> CR_CLI_FAILED
      CrBq.CLI_DONE -> CR_RAN
      CrBq.CLI_FAILED -> CR_CLI_FAILED
      CR_REPLIED {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
      CR_FAILED {
        key : string
        error : string!
        kind : string!
      }
      CrMonitoring.CR_HTTP_REPLIED -> CR_REPLIED
      CrMonitoring.CR_HTTP_FAILED -> CR_FAILED
      CR_TOKEN_READY { }
      CR_TOKEN_MISSING {
        message : string!
      }
      CrToken.CR_TOKEN_READY -> CR_TOKEN_READY
      CrToken.CR_TOKEN_MISSING -> CR_TOKEN_MISSING
    }

    config {
      project : string = ""
        @label "Project"
        @description "The Google Cloud project id."
        @synonyms "gcp project"
        @tier "domain"
      billingExportTable : string = ""
        @label "Billing export table"
        @description "The table id in the project's billing_export dataset; empty reads no cost."
        @synonyms "billing export"
        @tier "domain"
      resourceLevelExport : boolean = false
        @label "Resource-level export"
        @description "The billing export table carries resource names, so cost can be read per Cloud Run service."
        @synonyms "per-service cost"
        @tier "domain"
      trackedServices : Map string string = {}
        @label "Tracked APIs"
        @description "The enabled Google Cloud APIs the board lists before cost is known, by API name, with the name to show."
        @synonyms "tracked services"
        @tier "domain"
      cpuRatePerSecond : number = 0.000024
        @label "vCPU price per second"
        @description "Cloud Run's list price per active vCPU-second."
        @tier "domain"
      memoryRatePerSecond : number = 0.0000025
        @label "Memory price per second"
        @description "Cloud Run's list price per active GiB-second."
        @tier "domain"
      gpuRatesPerSecond : Map string CrGpuRate = {}
        @label "GPU prices per second"
        @description "Cloud Run's list price per GPU-second by accelerator, with and without zonal redundancy."
        @tier "domain"
      hoursPerMonth : number = 730
        @label "Hours per month"
        @description "The month length a projection scales to."
        @tier "domain"
      defaultCpu : number = 1
        @description "Cloud Run's vCPU limit when a service sets none."
        @tier "domain"
      defaultMemoryGb : number = 0.5
        @description "Cloud Run's memory limit in GiB when a service sets none."
        @tier "domain"
      defaultMinInstances : number = 0
        @description "Cloud Run's minimum instances when a service sets none."
        @tier "domain"
      defaultMaxInstances : number = 100
        @description "Cloud Run's maximum instances when a service sets none."
        @tier "domain"
      defaultConcurrency : number = 80
        @description "Cloud Run's concurrency when a service sets none."
        @tier "domain"
      cacheTtlMs : number = 600000
        @label "Cache window"
        @description "Milliseconds a read board is answered without reading again."
        @tier "infra"
    }
  }

  page "/cloud-run-board" as CloudRunBoardPage -> CloudRunStatus, CloudRunView, CrMonitoring, CrMonitoringFrame, CrToken, CrGcloud, CrBq
}
