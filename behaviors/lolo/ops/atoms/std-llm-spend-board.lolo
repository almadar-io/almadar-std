      LS_TRACE_REPLIED -> idle when (not (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body) (str/startsWith (str/trim @payload.body) "[") (!= (json/parse @payload.body LsTrace) null) (array/every (json/parse @payload.body LsTrace) (fn d (!= (time/format @d.atMs "YYYY-MM-DDTHH:mm:ss") null)))))
        (set @entity.usage { totalCalls: 0, inputTokens: (array/nth (object/values (object/pick @entity.noNumbers [(str/concat "x")])) 0), outputTokens: (array/nth (object/values (object/pick @entity.noNumbers [(str/concat "x")])) 0), unreportedCalls: 0, totalCost: (array/nth (object/values (object/pick @entity.noNumbers [(str/concat "x")])) 0), byModel: [], byDay: [], recentCalls: [], source: (str/concat @config.traceOrigin "/api/trace"), error: (if (and (>= @payload.status 200) (< @payload.status 300)) (str/concat (str/concat @config.traceOrigin "/api/trace") " did not answer a dispatch trace: the body is not a dispatch trace (an array of dispatches)") (str/concat (str/concat @config.traceOrigin "/api/trace") " answered " @payload.status "; the server exposes no trace")) })
        (set @entity.fetchedAt (str/concat (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "." (str/padStart (str/concat (math/mod @entity.startedAt 1000)) 3 "0") "Z"))
        (set @entity.cachedAt @now)
