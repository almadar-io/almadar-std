app std-llm-spend-board [
  version: "1.0.0",
  description: "std-llm-spend-board — what LLM providers cost: the OpenRouter key's usage and limit, the DeepSeek and Moonshot (Kimi) account balances, the spend those balances show between the first and latest kept snapshot, and the token usage a kernel server's dispatch trace reports (its usageEvent emits, as std-llm reports them), priced from LlmPrice rows (listed by provider, then model). LLM_SPEND_LOAD answers LLM_SPEND from the cache within cacheTtlMs; LLM_SPEND_REFRESH reads afresh; a load during a read is answered by that read. A provider whose key credential is not configured is absent; one that refuses or cannot be reached is unavailable with the reason. Each DeepSeek and Moonshot balance read keeps a LlmBalanceSnapshot row (the newest snapshotsKept per provider). The usage read needs traceOrigin (a program lists it in its egress; a loopback origin must be an IP literal); without one the usage says so. LLM_PRICE_SET sets a model's price per 1K prompt and completion tokens.",
  egress: ["https://openrouter.ai", "https://api.deepseek.com", "https://api.moonshot.ai", "http://127.0.0.1:3000"]
]
uses Spec from "almadar-std/llm-spend-board"
type LsProvider = { available : boolean!, balance : number?, usage : number?, limit : number?, actualSpend : number?, currency : string!, error : string? }
type LsOrData = { usage : number?, limit : number? }
type LsOrReply = { data : LsOrData! }
type LsDsInfo = { currency : string?, total_balance : string! }
type LsDsReply = { balance_infos : [LsDsInfo]! }
type LsKmData = { available_balance : number! }
type LsKmReply = { data : LsKmData! }
type LsUsagePayload = { provider : string, model : string, action : string, inputTokens : number, outputTokens : number }
type LsEmit = { event : string, payload : LsUsagePayload }
type LsOutcome = { emits : [LsEmit] }
type LsDispatch = { atMs : number!, outcomes : [LsOutcome] }
type LsTrace = [LsDispatch]
type LsCall = { at : string!, provider : string?, model : string?, action : string?, inputTokens : number?, outputTokens : number?, cost : number? }
type LsModel = { provider : string!, model : string!, calls : number!, inputTokens : number?, outputTokens : number?, unreportedCalls : number!, cost : number? }
type LsDay = { date : string!, calls : number!, inputTokens : number?, outputTokens : number?, cost : number? }
type LsUsage = { totalCalls : number!, inputTokens : number?, outputTokens : number?, unreportedCalls : number!, totalCost : number?, byModel : [LsModel]!, byDay : [LsDay]!, recentCalls : [LsCall]!, source : string?, error : string? }
type LsPriceRow = { provider : string!, model : string!, promptPer1K : number!, completionPer1K : number! }
type LsProviders = { openrouter : LsProvider?, deepseek : LsProvider?, kimi : LsProvider? }
orbital LlmSpendBoardOrbital {
  entity LlmBalanceSnapshot [persistent: llm_balance_snapshots] {
    id : string!
    provider : string! @description "The provider whose balance this is."
    timestamp : instant! @description "When it was read."
    balance : number! @description "The balance."
    currency : string @description "Its currency."
  }

  entity LlmPrice [persistent: llm_prices] {
    id : string! @description "provider/model."
    provider : string!
    model : string!
    promptPer1K : number! @description "Price per 1K prompt tokens."
    completionPer1K : number! @description "Price per 1K completion tokens."
  }

  entity LlmSpendBoard [runtime] {
    id : string!
    openrouter : LsProvider?
    deepseek : LsProvider?
    kimi : LsProvider?
    usage : LsUsage
    prices : [LsPriceRow] = []
    fetchedAt : string = ""
    cachedAt : instant = 0
    hasCache : boolean = false
    loading : boolean @description "Whether a read is in flight." = false
    startedAt : instant = 0
    pendingSpendFor : string @description "The provider whose snapshots are being read." = ""
  }

  trait LlmSpend -> LlmSpendBoard [optimistic] {
    initial: idle

    state idle {
      INIT -> idle when (not @config.loadOnInit)
        (render-ui @config.statusSlot { type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Load", variant: primary, action: LLM_SPEND_LOAD }] })
      INIT -> idle when @config.loadOnInit
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Reading " @config.title "…") })
        (emit LLM_SPEND_LOAD { })
      LLM_SPEND_LOAD -> idle when (and @entity.hasCache (< (time/diff @now @entity.cachedAt) @config.cacheTtlMs))
        (emit LLM_SPEND { providers: { openrouter: @entity.openrouter, deepseek: @entity.deepseek, kimi: @entity.kimi }, usage: @entity.usage, modelPricing: @entity.prices, fetchedAt: @entity.fetchedAt })
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: LLM_SPEND_REFRESH }] }, { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/filter [{ name: "openrouter", v: @entity.openrouter }, { name: "deepseek", v: @entity.deepseek }, { name: "kimi", v: @entity.kimi }] (fn e (!= @e.v null))) (fn e (let ((v @e.v)) { id: @e.name, provider: @e.name, state: (if @v.available "read" (default @v.error "unavailable")), balance: (if (== @v.balance null) "" (str/concat @v.balance " " @v.currency)), spend: (if (== @v.actualSpend null) "" (str/concat @v.actualSpend " " @v.currency)) }))), fields: [{ label: Provider, name: provider, variant: body }, { label: State, name: state, variant: badge }, { label: Balance, name: balance, variant: caption }, { label: Spend, name: spend, variant: caption }] }, { type: typography, variant: caption, content: (if (!= @entity.usage.error null) @entity.usage.error (str/concat @entity.usage.totalCalls " calls, " (default @entity.usage.inputTokens 0) " in / " (default @entity.usage.outputTokens 0) " out tokens, cost " (if (== @entity.usage.totalCost null) "unpriced" @entity.usage.totalCost))) }, { type: data-grid, cols: 1, gap: sm, entity: (array/map @entity.usage.byModel (fn m { id: (str/concat @m.provider "/" @m.model), model: (str/concat @m.provider "/" @m.model), calls: @m.calls, tokens: (str/concat (default @m.inputTokens 0) " / " (default @m.outputTokens 0)), cost: (if (== @m.cost null) "unpriced" @m.cost) })), fields: [{ label: Model, name: model, variant: body }, { label: Calls, name: calls, variant: caption }, { label: "Tokens in / out", name: tokens, variant: caption }, { label: Cost, name: cost, variant: caption }] }] })
      LLM_SPEND_LOAD -> reading when (not (and @entity.hasCache (< (time/diff @now @entity.cachedAt) @config.cacheTtlMs)))
        (set @entity.loading true)
        (set @entity.startedAt (time/now))
        (set @entity.openrouter null)
        (set @entity.deepseek null)
        (set @entity.kimi null)
        (http GET @config.openRouterOrigin "/api/v1/auth/key" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.openRouterKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_OR_REPLIED, failure: LS_OR_FAILED } })
      LLM_SPEND_REFRESH -> reading
        (set @entity.loading true)
        (set @entity.startedAt (time/now))
        (set @entity.openrouter null)
        (set @entity.deepseek null)
        (set @entity.kimi null)
        (http GET @config.openRouterOrigin "/api/v1/auth/key" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.openRouterKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_OR_REPLIED, failure: LS_OR_FAILED } })
      LLM_PRICE_SET -> idle
        (persist upsert LlmPrice { id: (str/concat @payload.provider "/" @payload.model), provider: @payload.provider, model: @payload.model, promptPer1K: @payload.promptPer1K, completionPer1K: @payload.completionPer1K } { emit: { success: LS_PRICE_SAVED, failure: LS_PRICE_NOT_SAVED } })
      LS_PRICE_SAVED -> idle
        (set @entity.hasCache false)
        (emit LLM_PRICE_SAVED { provider: @payload.provider, model: @payload.model })
      LS_PRICE_NOT_SAVED -> idle
        (emit LLM_PRICE_SAVE_FAILED { error: @payload.error })
        (notify error (str/concat "The price could not be saved: " @payload.error))
    }

    state reading {
      INIT -> reading
      LLM_SPEND_LOAD -> reading
      LLM_SPEND_REFRESH -> reading

      LS_OR_REPLIED -> reading when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body))
        (let ((rep (json/parse @payload.body LsOrReply)))
          (set @entity.openrouter (if (= @rep null) { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "USD", error: "the reply is not an OpenRouter key reply" } { available: true, balance: null, usage: @rep.data.usage, limit: @rep.data.limit, actualSpend: @rep.data.usage, currency: "USD", error: null })))
        (http GET @config.deepseekOrigin "/user/balance" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.deepseekKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_DS_REPLIED, failure: LS_DS_FAILED } })
      LS_OR_REPLIED -> reading when (not (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body)))
        (set @entity.openrouter { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "USD", error: (str/concat "HTTP " @payload.status) })
        (http GET @config.deepseekOrigin "/user/balance" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.deepseekKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_DS_REPLIED, failure: LS_DS_FAILED } })
      LS_OR_FAILED -> reading
        (notify warning (if (= @payload.kind "unconfigured") "OpenRouter has no key configured." (str/concat "OpenRouter could not be read: " @payload.error)))
        (set @entity.openrouter (if (= @payload.kind "unconfigured") null { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "USD", error: (if (= @payload.kind "timeout") "timed out" @payload.error) }))
        (http GET @config.deepseekOrigin "/user/balance" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.deepseekKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_DS_REPLIED, failure: LS_DS_FAILED } })

      LS_DS_REPLIED -> reading when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body))
        (let ((rep (json/parse @payload.body LsDsReply)))
          (let ((info (if (= @rep null) null (array/nth @rep.balance_infos 0))))
            (let ((bal (if (= @info null) null (str/to-number @info.total_balance))))
              (if (= @bal null)
                (do
                  (set @entity.deepseek { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "CNY", error: "the reply carries no readable DeepSeek balance" })
                  (http GET @config.deepseekOrigin "/user/balance" {
                    headers: { Accept: "application/json" },
                    auth: { scheme: bearer, credential: @config.deepseekKey },
                    timeoutMs: @config.timeoutMs
                  } { emit: { success: LS_DS_REPLIED, failure: LS_DS_FAILED } }))
                (do
                  (set @entity.deepseek { available: true, balance: @bal, usage: null, limit: null, actualSpend: null, currency: (default @info.currency "CNY"), error: null })
                  (set @entity.pendingSpendFor "deepseek")
                  (persist create LlmBalanceSnapshot { id: (str/concat "deepseek#" @now), provider: "deepseek", timestamp: @now, balance: @bal, currency: (default @info.currency "CNY") } { emit: { success: LS_SNAPSHOT_SAVED, failure: LS_SNAPSHOT_NOT_SAVED } }))))))
      LS_DS_REPLIED -> reading when (not (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body)))
        (set @entity.deepseek { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "CNY", error: (str/concat "HTTP " @payload.status) })
        (http GET @config.kimiOrigin "/v1/users/me/balance" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.kimiKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_KM_REPLIED, failure: LS_KM_FAILED } })
      LS_DS_FAILED -> reading
        (notify warning (if (= @payload.kind "unconfigured") "DeepSeek has no key configured." (str/concat "DeepSeek could not be read: " @payload.error)))
        (set @entity.deepseek (if (= @payload.kind "unconfigured") null { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "CNY", error: (if (= @payload.kind "timeout") "timed out" @payload.error) }))
        (http GET @config.kimiOrigin "/v1/users/me/balance" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.kimiKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_KM_REPLIED, failure: LS_KM_FAILED } })

      LS_KM_REPLIED -> reading when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body))
        (let ((rep (json/parse @payload.body LsKmReply)))
          (if (= @rep null)
            (do
              (set @entity.kimi { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "CNY", error: "the reply is not a Moonshot balance reply" })
              (emit LS_PRICES { }))
            (do
              (set @entity.kimi { available: true, balance: @rep.data.available_balance, usage: null, limit: null, actualSpend: null, currency: "CNY", error: null })
              (set @entity.pendingSpendFor "kimi")
              (persist create LlmBalanceSnapshot { id: (str/concat "kimi#" @now), provider: "kimi", timestamp: @now, balance: @rep.data.available_balance, currency: "CNY" } { emit: { success: LS_SNAPSHOT_SAVED, failure: LS_SNAPSHOT_NOT_SAVED } }))))
      LS_KM_REPLIED -> reading when (not (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body)))
        (set @entity.kimi { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "CNY", error: (str/concat "HTTP " @payload.status) })
        (emit LS_PRICES { })
      LS_KM_FAILED -> reading
        (notify warning (if (= @payload.kind "unconfigured") "Moonshot has no key configured." (str/concat "Moonshot could not be read: " @payload.error)))
        (set @entity.kimi (if (= @payload.kind "unconfigured") null { available: false, balance: null, usage: null, limit: null, actualSpend: null, currency: "CNY", error: (if (= @payload.kind "timeout") "timed out" @payload.error) }))
        (emit LS_PRICES { })

      LS_SNAPSHOT_SAVED -> reading
        (fetch LlmBalanceSnapshot { filter: (= (object/get @entity provider) @entity.pendingSpendFor), limit: @config.maxSnapshotRows, emit: { success: LS_SNAPSHOTS_LOADED, failure: LS_SNAPSHOTS_UNREADABLE } })
      LS_SNAPSHOT_NOT_SAVED -> reading
        (notify error (str/concat "A balance snapshot could not be kept: " @payload.error))
        (emit LS_SPEND_DONE { })
      LS_SNAPSHOTS_LOADED -> reading when (> @payload.totalCount (array/len @payload.data))
        (emit LS_SNAPSHOTS_UNREADABLE { error: (str/concat "LlmBalanceSnapshot has " @payload.totalCount " rows for " @entity.pendingSpendFor ", over the maxSnapshotRows cap of " @config.maxSnapshotRows), code: "LS_OVER_CAP" })
      LS_SNAPSHOTS_LOADED -> reading when (= @entity.pendingSpendFor "deepseek")
        (set @entity.deepseek (let ((cur @entity.deepseek) (rows (array/sort (array/map @payload.data (fn r { at: @r.timestamp, balance: @r.balance, id: @r.id })) "at" "asc"))) (let ((newest (array/last @rows)) (oldest (array/first @rows))) (if (= @cur null) null (object/merge @cur { actualSpend: (if (or (< (array/len @rows) 2) (= @newest null) (= @oldest null)) null (let ((d (- @oldest.balance @newest.balance))) (if (> @d 0) (math/round @d 4) 0))) })))))
        (persist batch (let ((rows (array/sort (array/map @payload.data (fn r { at: @r.timestamp, id: @r.id })) "at" "asc"))) (array/map (array/take @rows (math/max 0 (- (array/len @rows) @config.snapshotsKept))) (fn r ["delete", "LlmBalanceSnapshot", @r.id]))) { emit: { success: LS_SPEND_DONE, failure: LS_TRIM_FAILED } })
      LS_SNAPSHOTS_LOADED -> reading when (= @entity.pendingSpendFor "kimi")
        (set @entity.kimi (let ((cur @entity.kimi) (rows (array/sort (array/map @payload.data (fn r { at: @r.timestamp, balance: @r.balance, id: @r.id })) "at" "asc"))) (let ((newest (array/last @rows)) (oldest (array/first @rows))) (if (= @cur null) null (object/merge @cur { actualSpend: (if (or (< (array/len @rows) 2) (= @newest null) (= @oldest null)) null (let ((d (- @oldest.balance @newest.balance))) (if (> @d 0) (math/round @d 4) 0))) })))))
        (persist batch (let ((rows (array/sort (array/map @payload.data (fn r { at: @r.timestamp, id: @r.id })) "at" "asc"))) (array/map (array/take @rows (math/max 0 (- (array/len @rows) @config.snapshotsKept))) (fn r ["delete", "LlmBalanceSnapshot", @r.id]))) { emit: { success: LS_SPEND_DONE, failure: LS_TRIM_FAILED } })
      LS_SNAPSHOTS_UNREADABLE -> reading
        (notify error (str/concat "The balance snapshots could not be read: " @payload.error))
        (emit LS_SPEND_DONE { })
      LS_TRIM_FAILED -> reading
        (notify error (str/concat "Old balance snapshots could not be removed: " @payload.error))
        (emit LS_SPEND_DONE { })
      LS_SPEND_DONE -> reading when (= @entity.pendingSpendFor "deepseek")
        (set @entity.pendingSpendFor "")
        (http GET @config.kimiOrigin "/v1/users/me/balance" {
          headers: { Accept: "application/json" },
          auth: { scheme: bearer, credential: @config.kimiKey },
          timeoutMs: @config.timeoutMs
        } { emit: { success: LS_KM_REPLIED, failure: LS_KM_FAILED } })
      LS_SPEND_DONE -> reading when (= @entity.pendingSpendFor "kimi")
        (set @entity.pendingSpendFor "")
        (emit LS_PRICES { })

      LS_PRICES -> reading
        (fetch LlmPrice { limit: @config.maxPriceRows, emit: { success: LS_PRICES_LOADED, failure: LS_PRICES_UNREADABLE } })
      LS_PRICES_LOADED -> reading when (> @payload.totalCount (array/len @payload.data))
        (emit LS_PRICES_UNREADABLE { error: (str/concat "LlmPrice has " @payload.totalCount " rows, over the maxPriceRows cap of " @config.maxPriceRows), code: "LS_OVER_CAP" })
      LS_PRICES_LOADED -> reading
        (set @entity.prices (array/sort (array/sort (array/map @payload.data (fn p { provider: @p.provider, model: @p.model, promptPer1K: @p.promptPer1K, completionPer1K: @p.completionPer1K })) "model" "asc") "provider" "asc"))
        (emit LS_TRACE { })
      LS_PRICES_UNREADABLE -> reading
        (set @entity.prices [])
        (notify error (str/concat "The price rows could not be read: " @payload.error))
        (emit LS_TRACE { })

      LS_TRACE -> reading when (!= @config.traceOrigin "")
        (http GET @config.traceOrigin "/api/trace" { timeoutMs: @config.timeoutMs } { emit: { success: LS_TRACE_REPLIED, failure: LS_TRACE_FAILED } })
      LS_TRACE -> idle when (= @config.traceOrigin "")
        (set @entity.usage { totalCalls: 0, inputTokens: null, outputTokens: null, unreportedCalls: 0, totalCost: null, byModel: [], byDay: [], recentCalls: [], source: null, error: "no traceOrigin is configured; point it at a kernel server that serves /api/trace" })
        (set @entity.fetchedAt (str/concat (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z"))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit LLM_SPEND { providers: { openrouter: @entity.openrouter, deepseek: @entity.deepseek, kimi: @entity.kimi }, usage: @entity.usage, modelPricing: @entity.prices, fetchedAt: @entity.fetchedAt })
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: LLM_SPEND_REFRESH }] }, { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/filter [{ name: "openrouter", v: @entity.openrouter }, { name: "deepseek", v: @entity.deepseek }, { name: "kimi", v: @entity.kimi }] (fn e (!= @e.v null))) (fn e (let ((v @e.v)) { id: @e.name, provider: @e.name, state: (if @v.available "read" (default @v.error "unavailable")), balance: (if (== @v.balance null) "" (str/concat @v.balance " " @v.currency)), spend: (if (== @v.actualSpend null) "" (str/concat @v.actualSpend " " @v.currency)) }))), fields: [{ label: Provider, name: provider, variant: body }, { label: State, name: state, variant: badge }, { label: Balance, name: balance, variant: caption }, { label: Spend, name: spend, variant: caption }] }, { type: typography, variant: caption, content: (if (!= @entity.usage.error null) @entity.usage.error (str/concat @entity.usage.totalCalls " calls, " (default @entity.usage.inputTokens 0) " in / " (default @entity.usage.outputTokens 0) " out tokens, cost " (if (== @entity.usage.totalCost null) "unpriced" @entity.usage.totalCost))) }, { type: data-grid, cols: 1, gap: sm, entity: (array/map @entity.usage.byModel (fn m { id: (str/concat @m.provider "/" @m.model), model: (str/concat @m.provider "/" @m.model), calls: @m.calls, tokens: (str/concat (default @m.inputTokens 0) " / " (default @m.outputTokens 0)), cost: (if (== @m.cost null) "unpriced" @m.cost) })), fields: [{ label: Model, name: model, variant: body }, { label: Calls, name: calls, variant: caption }, { label: "Tokens in / out", name: tokens, variant: caption }, { label: Cost, name: cost, variant: caption }] }] })
      LS_TRACE_REPLIED -> idle when (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body) (str/startsWith (str/trim @payload.body) "["))
        (set @entity.usage (let ((trace (json/parse @payload.body LsTrace)))
          (if (= @trace null)
            { totalCalls: 0, inputTokens: null, outputTokens: null, unreportedCalls: 0, totalCost: null, byModel: [], byDay: [], recentCalls: [], source: (str/concat @config.traceOrigin "/api/trace"), error: (str/concat (str/concat @config.traceOrigin "/api/trace") " did not answer a dispatch trace: the body is not a dispatch trace (an array of dispatches)") }
            (let ((records (array/flatten (array/map @trace (fn d (let ((origin : instant "1970-01-01T00:00:00.000Z") (at : instant (time/add @origin @d.atMs "ms")) (stamp (time/format @at "YYYY-MM-DDTHH:mm:ss"))) (array/map (array/filter (array/flatten (array/map (default @d.outcomes []) (fn o (default @o.emits [])))) (fn e (= @e.event @config.usageEvent))) (fn e { at: (str/concat @stamp "." (str/padStart (str/concat (time/diff @at (time/startOf @at "second"))) 3 "0") "Z"), provider: @e.payload.provider, model: @e.payload.model, action: @e.payload.action, inputTokens: @e.payload.inputTokens, outputTokens: @e.payload.outputTokens }))))))))
              (if (array/some @records (fn r (or (= @r.provider null) (= @r.model null))))
                { totalCalls: 0, inputTokens: null, outputTokens: null, unreportedCalls: 0, totalCost: null, byModel: [], byDay: [], recentCalls: [], source: (str/concat @config.traceOrigin "/api/trace"), error: (str/concat (str/concat @config.traceOrigin "/api/trace") " reported a usage event that names no provider or model") }
                (let ((calls (array/map @records (fn r { at: @r.at, provider: @r.provider, model: @r.model, action: @r.action, inputTokens: @r.inputTokens, outputTokens: @r.outputTokens, cost: (let ((price (array/find @entity.prices (fn p (and (= @p.provider @r.provider) (= @p.model @r.model)))))) (if (== @price null) null (+ (if (== @r.inputTokens null) 0 (* (/ @r.inputTokens 1000) @price.promptPer1K)) (if (== @r.outputTokens null) 0 (* (/ @r.outputTokens 1000) @price.completionPer1K))))) }))))
                  { totalCalls: (array/len @calls),
                    inputTokens: (if (array/some @calls (fn x (!= @x.inputTokens null))) (array/reduce @calls 0 (fn acc x (+ @acc (default @x.inputTokens 0)))) null), outputTokens: (if (array/some @calls (fn x (!= @x.outputTokens null))) (array/reduce @calls 0 (fn acc x (+ @acc (default @x.outputTokens 0)))) null),
                    unreportedCalls: (array/len (array/filter @calls (fn c (and (== @c.inputTokens null) (== @c.outputTokens null))))),
                    totalCost: (if (array/some @calls (fn x (!= @x.cost null))) (array/reduce @calls 0 (fn acc x (+ @acc (default @x.cost 0)))) null),
                    byModel: (array/map (array/sort (array/sort (array/map (array/unique (array/map @calls (fn c { provider: (default @c.provider ""), model: (default @c.model "") }))) (fn g (let ((ms (array/filter @calls (fn c (and (= (default @c.provider "") @g.provider) (= (default @c.model "") @g.model)))))) { provider: @g.provider, model: @g.model, calls: (array/len @ms), inputTokens: (if (array/some @ms (fn x (!= @x.inputTokens null))) (array/reduce @ms 0 (fn acc x (+ @acc (default @x.inputTokens 0)))) null), outputTokens: (if (array/some @ms (fn x (!= @x.outputTokens null))) (array/reduce @ms 0 (fn acc x (+ @acc (default @x.outputTokens 0)))) null), unreportedCalls: (array/len (array/filter @ms (fn c (and (== @c.inputTokens null) (== @c.outputTokens null))))), cost: (if (array/some @ms (fn x (!= @x.cost null))) (array/reduce @ms 0 (fn acc x (+ @acc (default @x.cost 0)))) null), rank: (default (if (array/some @ms (fn x (!= @x.cost null))) (array/reduce @ms 0 (fn acc x (+ @acc (default @x.cost 0)))) null) -1) }))) "calls" "desc") "rank" "desc") (fn m { provider: @m.provider, model: @m.model, calls: @m.calls, inputTokens: @m.inputTokens, outputTokens: @m.outputTokens, unreportedCalls: @m.unreportedCalls, cost: @m.cost })),
                    byDay: (array/sort (array/map (array/unique (array/map @calls (fn c (str/slice @c.at 0 10)))) (fn day (let ((ds (array/filter @calls (fn c (= (str/slice @c.at 0 10) @day))))) { date: @day, calls: (array/len @ds), inputTokens: (if (array/some @ds (fn x (!= @x.inputTokens null))) (array/reduce @ds 0 (fn acc x (+ @acc (default @x.inputTokens 0)))) null), outputTokens: (if (array/some @ds (fn x (!= @x.outputTokens null))) (array/reduce @ds 0 (fn acc x (+ @acc (default @x.outputTokens 0)))) null), cost: (if (array/some @ds (fn x (!= @x.cost null))) (array/reduce @ds 0 (fn acc x (+ @acc (default @x.cost 0)))) null) }))) "date" "desc"),
                    recentCalls: (array/reverse @calls), source: (str/concat @config.traceOrigin "/api/trace"), error: null }))))))
        (set @entity.fetchedAt (str/concat (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z"))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit LLM_SPEND { providers: { openrouter: @entity.openrouter, deepseek: @entity.deepseek, kimi: @entity.kimi }, usage: @entity.usage, modelPricing: @entity.prices, fetchedAt: @entity.fetchedAt })
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: LLM_SPEND_REFRESH }] }, { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/filter [{ name: "openrouter", v: @entity.openrouter }, { name: "deepseek", v: @entity.deepseek }, { name: "kimi", v: @entity.kimi }] (fn e (!= @e.v null))) (fn e (let ((v @e.v)) { id: @e.name, provider: @e.name, state: (if @v.available "read" (default @v.error "unavailable")), balance: (if (== @v.balance null) "" (str/concat @v.balance " " @v.currency)), spend: (if (== @v.actualSpend null) "" (str/concat @v.actualSpend " " @v.currency)) }))), fields: [{ label: Provider, name: provider, variant: body }, { label: State, name: state, variant: badge }, { label: Balance, name: balance, variant: caption }, { label: Spend, name: spend, variant: caption }] }, { type: typography, variant: caption, content: (if (!= @entity.usage.error null) @entity.usage.error (str/concat @entity.usage.totalCalls " calls, " (default @entity.usage.inputTokens 0) " in / " (default @entity.usage.outputTokens 0) " out tokens, cost " (if (== @entity.usage.totalCost null) "unpriced" @entity.usage.totalCost))) }, { type: data-grid, cols: 1, gap: sm, entity: (array/map @entity.usage.byModel (fn m { id: (str/concat @m.provider "/" @m.model), model: (str/concat @m.provider "/" @m.model), calls: @m.calls, tokens: (str/concat (default @m.inputTokens 0) " / " (default @m.outputTokens 0)), cost: (if (== @m.cost null) "unpriced" @m.cost) })), fields: [{ label: Model, name: model, variant: body }, { label: Calls, name: calls, variant: caption }, { label: "Tokens in / out", name: tokens, variant: caption }, { label: Cost, name: cost, variant: caption }] }] })
      LS_TRACE_REPLIED -> idle when (not (and (>= @payload.status 200) (< @payload.status 300) (json/valid @payload.body) (str/startsWith (str/trim @payload.body) "[")))
        (set @entity.usage { totalCalls: 0, inputTokens: null, outputTokens: null, unreportedCalls: 0, totalCost: null, byModel: [], byDay: [], recentCalls: [], source: (str/concat @config.traceOrigin "/api/trace"), error: (if (and (>= @payload.status 200) (< @payload.status 300)) (str/concat (str/concat @config.traceOrigin "/api/trace") " did not answer a dispatch trace: the body is not a dispatch trace (an array of dispatches)") (str/concat (str/concat @config.traceOrigin "/api/trace") " answered " @payload.status "; the server exposes no trace")) })
        (set @entity.fetchedAt (str/concat (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z"))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit LLM_SPEND { providers: { openrouter: @entity.openrouter, deepseek: @entity.deepseek, kimi: @entity.kimi }, usage: @entity.usage, modelPricing: @entity.prices, fetchedAt: @entity.fetchedAt })
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: LLM_SPEND_REFRESH }] }, { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/filter [{ name: "openrouter", v: @entity.openrouter }, { name: "deepseek", v: @entity.deepseek }, { name: "kimi", v: @entity.kimi }] (fn e (!= @e.v null))) (fn e (let ((v @e.v)) { id: @e.name, provider: @e.name, state: (if @v.available "read" (default @v.error "unavailable")), balance: (if (== @v.balance null) "" (str/concat @v.balance " " @v.currency)), spend: (if (== @v.actualSpend null) "" (str/concat @v.actualSpend " " @v.currency)) }))), fields: [{ label: Provider, name: provider, variant: body }, { label: State, name: state, variant: badge }, { label: Balance, name: balance, variant: caption }, { label: Spend, name: spend, variant: caption }] }, { type: typography, variant: caption, content: (if (!= @entity.usage.error null) @entity.usage.error (str/concat @entity.usage.totalCalls " calls, " (default @entity.usage.inputTokens 0) " in / " (default @entity.usage.outputTokens 0) " out tokens, cost " (if (== @entity.usage.totalCost null) "unpriced" @entity.usage.totalCost))) }, { type: data-grid, cols: 1, gap: sm, entity: (array/map @entity.usage.byModel (fn m { id: (str/concat @m.provider "/" @m.model), model: (str/concat @m.provider "/" @m.model), calls: @m.calls, tokens: (str/concat (default @m.inputTokens 0) " / " (default @m.outputTokens 0)), cost: (if (== @m.cost null) "unpriced" @m.cost) })), fields: [{ label: Model, name: model, variant: body }, { label: Calls, name: calls, variant: caption }, { label: "Tokens in / out", name: tokens, variant: caption }, { label: Cost, name: cost, variant: caption }] }] })
      LS_TRACE_FAILED -> idle
        (set @entity.usage { totalCalls: 0, inputTokens: null, outputTokens: null, unreportedCalls: 0, totalCost: null, byModel: [], byDay: [], recentCalls: [], source: (str/concat @config.traceOrigin "/api/trace"), error: (str/concat (str/concat @config.traceOrigin "/api/trace") " is unreachable: " @payload.error) })
        (set @entity.fetchedAt (str/concat (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z"))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit LLM_SPEND { providers: { openrouter: @entity.openrouter, deepseek: @entity.deepseek, kimi: @entity.kimi }, usage: @entity.usage, modelPricing: @entity.prices, fetchedAt: @entity.fetchedAt })
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: LLM_SPEND_REFRESH }] }, { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/filter [{ name: "openrouter", v: @entity.openrouter }, { name: "deepseek", v: @entity.deepseek }, { name: "kimi", v: @entity.kimi }] (fn e (!= @e.v null))) (fn e (let ((v @e.v)) { id: @e.name, provider: @e.name, state: (if @v.available "read" (default @v.error "unavailable")), balance: (if (== @v.balance null) "" (str/concat @v.balance " " @v.currency)), spend: (if (== @v.actualSpend null) "" (str/concat @v.actualSpend " " @v.currency)) }))), fields: [{ label: Provider, name: provider, variant: body }, { label: State, name: state, variant: badge }, { label: Balance, name: balance, variant: caption }, { label: Spend, name: spend, variant: caption }] }, { type: typography, variant: caption, content: (if (!= @entity.usage.error null) @entity.usage.error (str/concat @entity.usage.totalCalls " calls, " (default @entity.usage.inputTokens 0) " in / " (default @entity.usage.outputTokens 0) " out tokens, cost " (if (== @entity.usage.totalCost null) "unpriced" @entity.usage.totalCost))) }, { type: data-grid, cols: 1, gap: sm, entity: (array/map @entity.usage.byModel (fn m { id: (str/concat @m.provider "/" @m.model), model: (str/concat @m.provider "/" @m.model), calls: @m.calls, tokens: (str/concat (default @m.inputTokens 0) " / " (default @m.outputTokens 0)), cost: (if (== @m.cost null) "unpriced" @m.cost) })), fields: [{ label: Model, name: model, variant: body }, { label: Calls, name: calls, variant: caption }, { label: "Tokens in / out", name: tokens, variant: caption }, { label: Cost, name: cost, variant: caption }] }] })
    }

    emits {
      LLM_SPEND -> external {
        providers : LsProviders!
        usage : LsUsage!
        modelPricing : [LsPriceRow]!
        fetchedAt : string!
      }
        @description "The providers' balances and spend, the trace's token usage and cost, the prices used, and when it was read."
        @synonyms "llm cost, ai spend, token usage"
        @tier "primary"
      LLM_PRICE_SAVED -> external {
        provider : string!
        model : string!
      }
        @description "A model's price was set."
        @tier "primary"
      LLM_PRICE_SAVE_FAILED -> external {
        error : string!
      }
        @description "The price could not be saved."
        @tier "primary"
      LLM_SPEND_LOAD -> internal { }
        @description "Internal: the load a page opening with loadOnInit asks for."
        @tier "internal"
      LS_PRICES -> internal { }
        @description "Internal: read the price rows."
        @tier "internal"
      LS_TRACE -> internal { }
        @description "Internal: read the trace."
        @tier "internal"
      LS_SPEND_DONE -> internal { }
        @description "Internal: a provider's spend is known."
        @tier "internal"
      LS_OR_REPLIED { status : number!  headers : Map string string  body : string! }
        @tier "internal"
      LS_OR_FAILED { error : string!  kind : string! }
        @tier "internal"
      LS_DS_REPLIED { status : number!  headers : Map string string  body : string! }
        @tier "internal"
      LS_DS_FAILED { error : string!  kind : string! }
        @tier "internal"
      LS_KM_REPLIED { status : number!  headers : Map string string  body : string! }
        @tier "internal"
      LS_KM_FAILED { error : string!  kind : string! }
        @tier "internal"
      LS_TRACE_REPLIED { status : number!  headers : Map string string  body : string! }
        @tier "internal"
      LS_TRACE_FAILED { error : string!  kind : string! }
        @tier "internal"
      LS_SNAPSHOT_SAVED { id : string!  provider : string!  timestamp : instant!  balance : number!  currency : string }
        @tier "internal"
      LS_SNAPSHOT_NOT_SAVED { error : string  code : string }
        @tier "internal"
      LS_SNAPSHOTS_LOADED { data : [LlmBalanceSnapshot]!  totalCount : number! }
        @tier "internal"
      LS_SNAPSHOTS_UNREADABLE { error : string  code : string }
        @tier "internal"
      LS_PRICES_LOADED { data : [LlmPrice]!  totalCount : number! }
        @tier "internal"
      LS_PRICES_UNREADABLE { error : string  code : string }
        @tier "internal"
      LS_TRIM_FAILED { error : string  code : string  index : number }
        @tier "internal"
      LS_TRIM_FAILED { error : string  code : string  index : number }
      LS_PRICE_SAVED { id : string!  provider : string!  model : string!  promptPer1K : number!  completionPer1K : number! }
        @tier "internal"
      LS_PRICE_NOT_SAVED { error : string  code : string }
        @tier "internal"
    }

    listens {
      LLM_SPEND_LOAD -> input { }
        @description "Answer the LLM spend board, from the cache while it is fresh."
        @synonyms "llm spend, provider balances"
      LLM_SPEND_REFRESH -> input { }
        @description "Read the LLM spend board afresh."
      LLM_PRICE_SET -> input {
        provider : string!
        model : string!
        promptPer1K : number!
        completionPer1K : number!
      }
        @description "Set a model's price per 1K prompt and completion tokens."
        @synonyms "llm price, model price"
      LS_OR_REPLIED { status : number!  headers : Map string string  body : string! }
      LS_OR_FAILED { error : string!  kind : string! }
      LS_DS_REPLIED { status : number!  headers : Map string string  body : string! }
      LS_DS_FAILED { error : string!  kind : string! }
      LS_KM_REPLIED { status : number!  headers : Map string string  body : string! }
      LS_KM_FAILED { error : string!  kind : string! }
      LS_TRACE_REPLIED { status : number!  headers : Map string string  body : string! }
      LS_TRACE_FAILED { error : string!  kind : string! }
      LS_SNAPSHOT_SAVED { id : string!  provider : string!  timestamp : instant!  balance : number!  currency : string }
      LS_SNAPSHOT_NOT_SAVED { error : string  code : string }
      LS_SNAPSHOTS_LOADED { data : [LlmBalanceSnapshot]!  totalCount : number! }
      LS_SNAPSHOTS_UNREADABLE { error : string  code : string }
      LS_PRICES_LOADED { data : [LlmPrice]!  totalCount : number! }
      LS_PRICES_UNREADABLE { error : string  code : string }
      LS_PRICE_SAVED { id : string!  provider : string!  model : string!  promptPer1K : number!  completionPer1K : number! }
      LS_PRICE_NOT_SAVED { error : string  code : string }
    }

    config {
      title : string = "LLM spend"
        @label "Title"
        @description "The board's heading."
        @tier "presentation"
      loadOnInit : boolean = false
        @label "Load when opened"
        @description "Read the board as soon as its page opens."
        @tier "presentation"
      statusSlot : slot = main
        @label "Status slot"
        @description "Where the board shows its one-line status."
        @tier "presentation"
      openRouterOrigin : url = "https://openrouter.ai"
        @tier "infra"
      deepseekOrigin : url = "https://api.deepseek.com"
        @tier "infra"
      kimiOrigin : url = "https://api.moonshot.ai"
        @tier "infra"
      openRouterKey : secret = "OPEN_ROUTER_API_KEY"
        @description "The credential holding the OpenRouter key."
        @tier "infra"
      deepseekKey : secret = "DEEPSEEK_API_KEY"
        @description "The credential holding the DeepSeek key."
        @tier "infra"
      kimiKey : secret = "KIMI_API_KEY"
        @description "The credential holding the Moonshot (Kimi) key."
        @tier "infra"
      traceOrigin : url = "http://127.0.0.1:3000"
        @label "Trace server"
        @description "The kernel server whose GET /api/trace the usage is read from; empty reads none."
        @tier "infra"
      usageEvent : string = "LLM_USAGE_REPORTED"
        @description "The event a usage report is."
        @tier "domain"
      snapshotsKept : number = 1000
        @description "Balance snapshots kept per provider."
        @tier "domain"
      maxSnapshotRows : number = 10000
        @label "Snapshot rows per read"
        @description "Most balance snapshots one provider read may return; the spend and the trim to snapshotsKept need the whole set, so ten times snapshotsKept leaves room for a lowered snapshotsKept to catch up, and a provider holding more is refused through LS_SNAPSHOTS_UNREADABLE instead of computing the spend from a partial set. Keep it above snapshotsKept."
        @synonyms "snapshot read limit, snapshot cap"
        @tier "infra"
      maxPriceRows : number = 1000
        @label "Price rows per read"
        @description "Most LlmPrice rows one read may return to price the usage; a table holding more is refused through LS_PRICES_UNREADABLE instead of pricing from a partial list."
        @synonyms "price read limit, price cap"
        @tier "infra"
      timeoutMs : number = 30000
        @tier "infra"
      cacheTtlMs : number = 30000
        @tier "infra"
    }
  }

  page "/llm-spend-board" as LlmSpendBoardPage -> LlmSpend
}
