app std-analytics-collector [
  version: "1.0.0",
  inbound: ["analytics"],
  description: "std-analytics-collector — the collector std-analytics reports to. A beacon (`{ n, d, u, r?, w?, p? }` JSON: event name, site, path, referrer, screen width, properties) arrives at the inbound hook analytics (/api/hooks/analytics) and is stored as an AnalyticsEvent whose visitorId is the SHA-256 of the day's salt, the client IP (the first x-forwarded-for address), the user agent and the site: stable within one UTC day, never reversible, and the IP itself is never stored. One random salt per UTC day lives in an AnalyticsSalt row created on the day's first beacon. The hook answers 202 for a stored beacon, 400 for one that is not a JSON object with a non-empty name, site and path (or whose site the domains knob does not list) and 500 when the store fails. ANALYTICS_STATS answers the pageviews, unique visitors and the top pages, countries and referrer hosts of a site and time window."
]
uses Spec from "almadar-std/analytics-collector"
uses Lifecycle from "std/behaviors/std-lifecycle"
uses Stats from "std/behaviors/std-analytics-stats"
type AnalyticsProps = Map string (string | number | boolean)
type AnalyticsBeacon = { n : string!, d : string!, u : string!, r : string, w : number, p : AnalyticsProps }
type AnalyticsDraft = { ts : number!, name : string!, domain : string!, path : string!, referrer : string?, screenWidth : number?, props : AnalyticsProps?, ip : string!, ua : string! }
orbital AnalyticsCollectorOrbital {
  config {
    keepDays : number = 90
      @label "Days to keep analytics events"
      @description "Stored analytics events older than this many days are deleted. 0 turns the clean-up off and keeps them all."
      @synonyms "retention, retention days, ttl, expire analytics, delete old analytics, keep events for"
      @tier "policy"
  }

  entity AnalyticsEvent [persistent: analyticsEvents] {
    id : string!
    ts : number! @description "When the beacon arrived, in epoch milliseconds."
    name : string! @description "The event name; pageview for a page visit."
    domain : string! @description "The site the beacon was reported under."
    path : string! @description "The page path."
    referrer : string? @description "The page's referrer as the browser reported it."
    screenWidth : number? @description "The screen width in CSS pixels."
    visitorId : string! @description "SHA-256 of the day's salt, the client IP, the user agent and the site."
    props : AnalyticsProps? @description "The event's properties."
  }

  entity AnalyticsSalt [persistent: analyticsSalt] {
    id : string! @description "The UTC day, YYYY-MM-DD."
    salt : string! @description "The day's random salt."
    createdAt : number? @description "When the salt was drawn, in epoch milliseconds."
  }

  entity AnalyticsRetentionLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
  }

  entity AnalyticsCollector [runtime] {
    id : string!
    saltDay : string @description "The UTC day of the salt held in memory." = ""
    salt : string @description "That day's salt." = ""
    pending : AnalyticsDraft? @description "The beacon waiting for the day's salt; its IP is held in memory only."
    statsLimit : number @description "The row limit of the stats query in flight." = 100
  }

  trait AnalyticsIntake -> AnalyticsCollector [optimistic] {
    initial: ready

    config {
      epoch : instant = "1970-01-01T00:00:00.000Z"
        @label "Epoch"
        @description "The instant an event's ts counts milliseconds from."
        @tier "infra"
      statusSlot : slot = system
        @label "Status slot"
        @description "Where the intake shows why a beacon could not be stored."
        @synonyms "status area, slot"
        @tier "presentation"
      domains : [string] = []
        @label "Accepted sites"
        @description "The sites beacons may be reported under; an empty list accepts every site."
        @synonyms "allowed domains, sites, hostnames"
        @tier "domain"
    }

    state ready {
      INIT -> ready

      BEACON_RECEIVED -> ready when (not (and (!= (json/parse (default @payload.rawBody "") AnalyticsBeacon) null) (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "n")) "\"") (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d")) "\"") (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "u")) "\"") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "n") "") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d") "") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "u") "")))
        (emit BEACON_ANSWERED { status: 400, body: "{\"error\":\"invalid beacon\"}" })
      BEACON_RECEIVED -> ready when (and (!= (json/parse (default @payload.rawBody "") AnalyticsBeacon) null) (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "n")) "\"") (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d")) "\"") (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "u")) "\"") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "n") "") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d") "") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "u") "") (> (array/len @config.domains) 0) (not (array/includes @config.domains (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d"))))
        (emit BEACON_ANSWERED { status: 400, body: "{\"error\":\"site not accepted\"}" })
      BEACON_RECEIVED -> ready when (and (!= (json/parse (default @payload.rawBody "") AnalyticsBeacon) null) (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "n")) "\"") (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d")) "\"") (str/startsWith (json/stringify (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "u")) "\"") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "n") "") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d") "") (!= (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "u") "") (or (= (array/len @config.domains) 0) (array/includes @config.domains (object/get (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {}) "d"))))
        (let ((b (default (json/parse (default @payload.rawBody "") AnalyticsBeacon) {})))
          (emit BEACON_ACCEPTED { draft: {
            ts: (time/diff @now @config.epoch "ms"),
            name: @b.n,
            domain: @b.d,
            path: @b.u,
            referrer: (if (str/startsWith (json/stringify @b.r) "\"") @b.r null),
            screenWidth: (if (validate/pattern (json/stringify @b.w) "^-?[0-9]") @b.w null),
            props: (if (str/startsWith (json/stringify @b.p) "{") @b.p null),
            ip: (str/trim (default (array/first (str/split (object/get (default @payload.headers {}) "x-forwarded-for" "") ",")) "")),
            ua: (object/get (default @payload.headers {}) "user-agent" "")
          } }))

      BEACON_ACCEPTED -> ready when (= @entity.saltDay (time/format (time/add @config.epoch @payload.draft.ts "ms") "YYYY-MM-DD"))
        (persist create AnalyticsEvent { ts: @payload.draft.ts, name: @payload.draft.name, domain: @payload.draft.domain, path: @payload.draft.path, referrer: @payload.draft.referrer, screenWidth: @payload.draft.screenWidth, props: @payload.draft.props, visitorId: (default (hash/sha 256 (str/concat @entity.salt ":" @payload.draft.ip ":" @payload.draft.ua ":" @payload.draft.domain) "hex") "") } { emit: { success: EVENT_RECORDED, failure: EVENT_UNRECORDED } })
      BEACON_ACCEPTED -> ready when (!= @entity.saltDay (time/format (time/add @config.epoch @payload.draft.ts "ms") "YYYY-MM-DD"))
        (set @entity.pending @payload.draft)
        (fetch AnalyticsSalt { id: (time/format (time/add @config.epoch @payload.draft.ts "ms") "YYYY-MM-DD"), emit: { success: SALT_LOADED, failure: SALT_ABSENT } })

      SALT_LOADED -> ready
        (set @entity.saltDay @payload.data.id)
        (set @entity.salt @payload.data.salt)
        (emit SALT_READY { })
      SALT_ABSENT -> ready when (= @payload.code "not-found")
        (random-bytes 32 { emit: { success: SALT_DRAWN, failure: SALT_FAILED } })
      SALT_ABSENT -> ready when (!= @payload.code "not-found")
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
      SALT_DRAWN -> ready
        (persist create AnalyticsSalt { id: (time/format (time/add @config.epoch (default @entity.pending.ts (time/diff @now @config.epoch "ms")) "ms") "YYYY-MM-DD"), salt: @payload.value, createdAt: (default @entity.pending.ts (time/diff @now @config.epoch "ms")) } { emit: { success: SALT_CREATED, failure: SALT_TAKEN } })
      SALT_CREATED -> ready
        (set @entity.saltDay @payload.id)
        (set @entity.salt @payload.salt)
        (emit SALT_READY { })
      SALT_TAKEN -> ready when (= @payload.code "duplicate-id")
        (fetch AnalyticsSalt { id: (time/format (time/add @config.epoch (default @entity.pending.ts (time/diff @now @config.epoch "ms")) "ms") "YYYY-MM-DD"), emit: { success: SALT_LOADED, failure: SALT_UNREADABLE } })
      SALT_TAKEN -> ready when (!= @payload.code "duplicate-id")
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
      SALT_UNREADABLE -> ready
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
      SALT_FAILED -> ready
        (set @entity.pending null)
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })

      SALT_READY -> ready
        (persist create AnalyticsEvent { ts: (default @entity.pending.ts (time/diff @now @config.epoch "ms")), name: @entity.pending.name, domain: @entity.pending.domain, path: @entity.pending.path, referrer: @entity.pending.referrer, screenWidth: @entity.pending.screenWidth, props: @entity.pending.props, visitorId: (default (hash/sha 256 (str/concat @entity.salt ":" (default @entity.pending.ip "") ":" (default @entity.pending.ua "") ":" (default @entity.pending.domain "")) "hex") "") } { emit: { success: EVENT_RECORDED, failure: EVENT_UNRECORDED } })
        (set @entity.pending null)

      EVENT_RECORDED -> ready
        (emit BEACON_ANSWERED { status: 202, body: "{}" })
      EVENT_UNRECORDED -> ready
        (emit BEACON_ANSWERED { status: 500, body: (json/stringify { error: @payload.error }) })
        (render-ui @config.statusSlot { type: typography, variant: caption, role: status, content: (str/concat "Beacon not stored: " @payload.error) })
    }

    emits {
      BEACON_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the HTTP answer to the beacon, which the inbound hook writes back."
        @tier "internal"
      BEACON_ACCEPTED -> internal {
        draft : AnalyticsDraft!
      }
        @description "Internal: a well-formed beacon, as the event it becomes before the visitor hash."
        @tier "internal"
      SALT_READY -> internal { }
        @description "Internal: the day's salt is held; the pending beacon can be stored."
        @tier "internal"
      SALT_LOADED {
        data : AnalyticsSalt!
      }
        @description "Internal: the day's salt row was read."
      SALT_ABSENT {
        error : string!
        code : string
      }
        @description "Internal: the day's salt row could not be read; not-found means it does not exist yet."
      SALT_DRAWN {
        value : string!
      }
        @description "Internal: fresh random bytes for the day's salt."
      SALT_FAILED {
        error : string!
      }
        @description "Internal: the host could not draw random bytes."
      SALT_CREATED {
        id : string!
        salt : string!
      }
        @description "Internal: the day's salt row was created."
      SALT_TAKEN {
        error : string!
        code : string
      }
        @description "Internal: the salt row could not be created; duplicate-id means another instance created it first."
      SALT_UNREADABLE {
        error : string!
        code : string
      }
        @description "Internal: the salt row another instance created could not be read."
      EVENT_RECORDED {
        id : string!
      }
        @description "Internal: the beacon's event row was stored."
      EVENT_UNRECORDED {
        error : string!
        code : string
      }
        @description "Internal: the beacon's event row could not be stored."
    }

    listens {
      BEACON_RECEIVED -> inbound "analytics" answers BEACON_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "A beacon delivered at /api/hooks/analytics: the JSON text std-analytics sends (text/plain)."
        @synonyms "analytics beacon, pageview, tracking event"
    }
  }

  trait AnalyticsStats = Stats.traits.AnalyticsStats -> AnalyticsCollector {}

  trait AnalyticsRetention = Lifecycle.traits.LifecycleRetention -> AnalyticsRetentionLog {
    config {
      enabled: true
      targetEntity: AnalyticsEvent
      dateField: ts
      dateEncoding: epochMs
      ageDays: @config.keepDays
    }
  }

  page "/analytics-collector" -> AnalyticsIntake, AnalyticsStats, AnalyticsRetention
}
