app std-app-hosting-board [
  version: "1.0.0",
  description: "std-app-hosting-board — a Firebase App Hosting project's backends at a glance, read through the App Hosting REST API (over std-http-client with the accessToken credential, GCLOUD_ACCESS_TOKEN, which the host holds and the operator refreshes) and the gcloud CLI (std-cli, with the host's PATH and HOME passed through). AH_STATUS_LOAD { backendId, force? } answers AH_STATUS with the backend's latest rollout (by creation time): its state, id, time (updated, else created), and from the build behind it the commit's first line, short hash and url, the build log url, the Cloud Build id and region read from that url (the region knob when the url names none) and the error source; status UNKNOWN when the credential is not held, the API refuses, or there is no rollout, and a build that cannot be read leaves its fields empty. AH_LOGS_LOAD { backendId } answers AH_LOGS with the backend's last 60 Cloud Run log lines: time to the second, severity, the revision's last name segment and the message (the text payload, else the structured payload's message, else the structured payload as JSON; terminal colour codes removed; empty lines left out). AH_BUILD_LOGS_LOAD { cloudBuildId, region? } answers AH_BUILD_LOGS with the build's non-blank log lines (gcloud prints a failed build's log and exits non-zero). Requests that arrive during a read wait in a first-in-first-out queue; a status is cached statusTtlMs (force skips it), logs and build logs logsTtlMs.",
  exec: ["gcloud"],
  env: ["PATH", "HOME"],
  net: { "firebaseapphosting.googleapis.com:443": [tcp] }
]
uses Http from "std/behaviors/std-http-client"
type HttpHeader = { name : string!, value : string! }
uses Spec from "almadar-std/app-hosting-board"
type AhRequest = { kind : "status" | "logs" | "build-logs"!, backendId : string!, force : boolean!, cloudBuildId : string!, region : string! }
type AhStatus = { rolloutState : string!, rolloutId : string!, rolloutTime : string!, commitMessage : string!, commitHash : string!, commitUrl : string!, buildLogsUrl : string!, cloudBuildId : string!, cloudBuildRegion : string!, errorSource : string! }
type AhLogLine = { ts : string!, severity : string!, revision : string!, msg : string! }
type AhRollout = { name : string, createTime : string!, updateTime : string, state : string, build : string }
type AhRollouts = { rollouts : [AhRollout] }
type AhCodebase = { branch : string, hash : string, commitMessage : string, uri : string }
type AhSource = { codebase : AhCodebase }
type AhBuildError = { errorSource : string }
type AhBuild = { name : string, state : string, buildLogsUri : string, source : AhSource, errors : [AhBuildError], errorSource : string }
type AhLogLabels = { revision_name : string }
type AhLogResource = { labels : AhLogLabels }
type AhLogEntry = { timestamp : string, severity : string, textPayload : string, jsonPayload : Map string SExpr, resource : AhLogResource }
type AhLogEntries = [AhLogEntry]
type AhBoardRow = { id : string, backend : string, state : string, when : string, commit : string, error : string }
type AhStatusCached = { backendId : string!, status : AhStatus!, cachedAt : instant! }
type AhLinesCached = { key : string!, lines : [AhLogLine]!, cachedAt : instant! }
type AhBuildCached = { key : string!, lines : [string]!, cachedAt : instant! }
orbital AppHostingBoardOrbital {
  uses Cli from "std/behaviors/std-cli"

  entity AppHostingBoard [runtime] {
    id : string!
    loading : boolean @description "Whether a read is in flight." = false
    queue : [AhRequest] @description "Requests waiting to be read, oldest first." = []
    current : AhRequest @description "The request being read; the empty status request while none is." = { kind: "status", backendId: "", force: false, cloudBuildId: "", region: "" }
    latest : AhRollout @description "The latest rollout of the status read in flight." = { createTime: "" }
    build : AhBuild @description "Its build; empty when it could not be read." = {}
    statusCache : [AhStatusCached] = []
    logsCache : [AhLinesCached] = []
    buildCache : [AhBuildCached] = []
    noPayload : Map string SExpr @description "An empty payload, read when a log entry has none." = {}
    selected : string @description "The backend whose log lines the board shows." = ""
    noLines : [AhLogLine] @description "No lines." = []
  }

  trait AhGcloud = Cli.traits.CliRunner {
    listens { AppHostingStatus.AH_GCLOUD -> CLI_RUN }
    config {
      commands: ["gcloud"]
      passEnv: ["PATH", "HOME"]
    }
  }

  trait AhApi = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: AH_HTTP_REPLIED
      HTTP_FAILED: AH_HTTP_FAILED
    }
    config {
      host: "firebaseapphosting.googleapis.com"
      port: 443
      tls: true
      serverName: "firebaseapphosting.googleapis.com"
      credential: "GCLOUD_ACCESS_TOKEN"
      credentialHeader: "authorization"
      credentialPrefix: "Bearer "
    }
    listens {
      AppHostingStatus.AH_HTTP_SEND -> HTTP_SEND
    }
  }

  trait AppHostingStatus -> AppHostingBoard [client] {
    initial: idle

    state idle {
      INIT -> idle when (not @config.loadOnInit)
        (set @entity.noPayload (object/fromEntries (array/take [["", ""]] 0)))
        (set @entity.selected "")
        (set @entity.noLines [])
        (render-ui @config.statusSlot { type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Load", variant: primary, action: AH_REFRESH_ALL }] })
      INIT -> idle when @config.loadOnInit
        (set @entity.noPayload (object/fromEntries (array/take [["", ""]] 0)))
        (set @entity.selected "")
        (set @entity.noLines [])
        (set @entity.queue (array/concat @entity.queue (array/map @config.backends (fn b { kind: "status", backendId: @b, force: false, cloudBuildId: "", region: "" }))))
        (emit AH_RENDER { })
        (emit AH_PUMP { })
      AH_REFRESH_ALL -> idle
        (set @entity.queue (array/concat @entity.queue (array/map @config.backends (fn b { kind: "status", backendId: @b, force: true, cloudBuildId: "", region: "" }))))
        (emit AH_PUMP { })
      AH_BACKEND_OPEN -> idle
        (set @entity.selected @payload.id)
        (set @entity.queue (array/append @entity.queue { kind: "logs", backendId: @payload.id, force: false, cloudBuildId: "", region: "" }))
        (emit AH_PUMP { })
      AH_RENDER -> idle
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [
          { type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: AH_REFRESH_ALL }] },
          { type: data-grid, cols: 1, gap: sm, itemClickEvent: AH_BACKEND_OPEN, entity: (array/map @config.backends (fn b (let ((c (array/find @entity.statusCache (fn x (= @x.backendId @b))))) (if (== @c null) { id: @b, backend: @b, state: "reading…", when: "", commit: "", error: "" } { id: @b, backend: @b, state: @c.status.rolloutState, when: @c.status.rolloutTime, commit: (str/concat @c.status.commitHash " " @c.status.commitMessage), error: @c.status.errorSource })))), fields: [{ label: Backend, name: backend, variant: body }, { label: Rollout, name: state, variant: badge }, { label: When, name: when, variant: caption }, { label: Commit, name: commit, variant: caption }, { label: Error, name: error, variant: caption }] },
          { type: typography, variant: caption, content: (if (= @entity.selected "") "Pick a backend to read its recent log lines." (str/concat @entity.selected " · recent log lines")) },
          { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/range (array/len (object/get (array/find @entity.logsCache (fn c (= @c.key @entity.selected))) "lines" @entity.noLines))) (fn i (let ((l (array/nth (object/get (array/find @entity.logsCache (fn c (= @c.key @entity.selected))) "lines" @entity.noLines) @i))) { id: (str/concat @i), ts: @l.ts, severity: @l.severity, msg: @l.msg }))), fields: [{ label: Time, name: ts, variant: caption }, { label: Severity, name: severity, variant: badge }, { label: Message, name: msg, variant: body }] }
        ] })
      AH_STATUS_LOAD -> idle
        (set @entity.queue (array/append @entity.queue { kind: "status", backendId: @payload.backendId, force: (if (== @payload.force null) false @payload.force), cloudBuildId: "", region: "" }))
        (emit AH_PUMP { })
      AH_LOGS_LOAD -> idle
        (set @entity.queue (array/append @entity.queue { kind: "logs", backendId: @payload.backendId, force: false, cloudBuildId: "", region: "" }))
        (emit AH_PUMP { })
      AH_BUILD_LOGS_LOAD -> idle
        (set @entity.queue (array/append @entity.queue { kind: "build-logs", backendId: "", force: false, cloudBuildId: @payload.cloudBuildId, region: (if (= (default @payload.region "") "") @config.region @payload.region) }))
        (emit AH_PUMP { })
      AH_PUMP -> reading when (> (array/len @entity.queue) 0)
        (set @entity.current (array/nth @entity.queue 0))
        (set @entity.queue (array/slice @entity.queue 1))
        (set @entity.loading true)
        (emit AH_START { })
      AH_PUMP -> idle when (= (array/len @entity.queue) 0)
        (set @entity.loading false)
    }

    state reading {
      INIT -> reading
      AH_STATUS_LOAD -> reading
        (set @entity.queue (array/append @entity.queue { kind: "status", backendId: @payload.backendId, force: (if (== @payload.force null) false @payload.force), cloudBuildId: "", region: "" }))
      AH_LOGS_LOAD -> reading
        (set @entity.queue (array/append @entity.queue { kind: "logs", backendId: @payload.backendId, force: false, cloudBuildId: "", region: "" }))
      AH_BUILD_LOGS_LOAD -> reading
        (set @entity.queue (array/append @entity.queue { kind: "build-logs", backendId: "", force: false, cloudBuildId: @payload.cloudBuildId, region: (if (= (default @payload.region "") "") @config.region @payload.region) }))
      AH_PUMP -> reading
      AH_REFRESH_ALL -> reading
        (set @entity.queue (array/concat @entity.queue (array/map @config.backends (fn b { kind: "status", backendId: @b, force: true, cloudBuildId: "", region: "" }))))
      AH_BACKEND_OPEN -> reading
        (set @entity.selected @payload.id)
        (set @entity.queue (array/append @entity.queue { kind: "logs", backendId: @payload.id, force: false, cloudBuildId: "", region: "" }))
      AH_RENDER -> reading
        (render-ui @config.statusSlot { type: stack, direction: vertical, gap: md, children: [
          { type: stack, direction: horizontal, justify: between, align: center, children: [{ type: typography, variant: h3, content: @config.title }, { type: button, label: "Refresh", variant: secondary, action: AH_REFRESH_ALL }] },
          { type: data-grid, cols: 1, gap: sm, itemClickEvent: AH_BACKEND_OPEN, entity: (array/map @config.backends (fn b (let ((c (array/find @entity.statusCache (fn x (= @x.backendId @b))))) (if (== @c null) { id: @b, backend: @b, state: "reading…", when: "", commit: "", error: "" } { id: @b, backend: @b, state: @c.status.rolloutState, when: @c.status.rolloutTime, commit: (str/concat @c.status.commitHash " " @c.status.commitMessage), error: @c.status.errorSource })))), fields: [{ label: Backend, name: backend, variant: body }, { label: Rollout, name: state, variant: badge }, { label: When, name: when, variant: caption }, { label: Commit, name: commit, variant: caption }, { label: Error, name: error, variant: caption }] },
          { type: typography, variant: caption, content: (if (= @entity.selected "") "Pick a backend to read its recent log lines." (str/concat @entity.selected " · recent log lines")) },
          { type: data-grid, cols: 1, gap: sm, entity: (array/map (array/range (array/len (object/get (array/find @entity.logsCache (fn c (= @c.key @entity.selected))) "lines" @entity.noLines))) (fn i (let ((l (array/nth (object/get (array/find @entity.logsCache (fn c (= @c.key @entity.selected))) "lines" @entity.noLines) @i))) { id: (str/concat @i), ts: @l.ts, severity: @l.severity, msg: @l.msg }))), fields: [{ label: Time, name: ts, variant: caption }, { label: Severity, name: severity, variant: badge }, { label: Message, name: msg, variant: body }] }
        ] })

      AH_START -> idle when (and (= @entity.current.kind "status") (not @entity.current.force) (!= (array/find @entity.statusCache (fn c (and (= @c.backendId @entity.current.backendId) (< (time/diff @now @c.cachedAt) @config.statusTtlMs)))) null))
        (let ((hit (array/find @entity.statusCache (fn c (= @c.backendId @entity.current.backendId)))))
          (when (!= @hit null) (emit AH_STATUS { backendId: @entity.current.backendId, status: @hit.status })))
        (emit AH_RENDER { })
        (emit AH_PUMP { })
      AH_START -> reading when (and (= @entity.current.kind "status") (or @entity.current.force (== (array/find @entity.statusCache (fn c (and (= @c.backendId @entity.current.backendId) (< (time/diff @now @c.cachedAt) @config.statusTtlMs)))) null)))
        (emit AH_ROLLOUTS { })
      AH_START -> idle when (and (= @entity.current.kind "logs") (!= (array/find @entity.logsCache (fn c (and (= @c.key @entity.current.backendId) (< (time/diff @now @c.cachedAt) @config.logsTtlMs)))) null))
        (let ((hit (array/find @entity.logsCache (fn c (= @c.key @entity.current.backendId)))))
          (when (!= @hit null) (emit AH_LOGS { backendId: @entity.current.backendId, lines: @hit.lines })))
        (emit AH_RENDER { })
        (emit AH_PUMP { })
      AH_START -> reading when (and (= @entity.current.kind "logs") (== (array/find @entity.logsCache (fn c (and (= @c.key @entity.current.backendId) (< (time/diff @now @c.cachedAt) @config.logsTtlMs)))) null))
        (emit AH_GCLOUD { stage: "logs", argv: ["logging", "read", (str/concat "resource.type=\"cloud_run_revision\" resource.labels.service_name=\"" @entity.current.backendId "\""), (str/concat "--project=" @config.project), (str/concat "--limit=" @config.logLimit), "--format=json"] })
      AH_START -> idle when (and (= @entity.current.kind "build-logs") (!= (array/find @entity.buildCache (fn c (and (= @c.key (str/concat @entity.current.cloudBuildId "|" @entity.current.region)) (< (time/diff @now @c.cachedAt) @config.logsTtlMs)))) null))
        (let ((hit (array/find @entity.buildCache (fn c (= @c.key (str/concat @entity.current.cloudBuildId "|" @entity.current.region))))))
          (when (!= @hit null) (emit AH_BUILD_LOGS { cloudBuildId: @entity.current.cloudBuildId, region: @entity.current.region, lines: @hit.lines })))
        (emit AH_PUMP { })
      AH_START -> reading when (and (= @entity.current.kind "build-logs") (== (array/find @entity.buildCache (fn c (and (= @c.key (str/concat @entity.current.cloudBuildId "|" @entity.current.region)) (< (time/diff @now @c.cachedAt) @config.logsTtlMs)))) null))
        (emit AH_GCLOUD { stage: "build-logs", argv: ["builds", "log", @entity.current.cloudBuildId, (str/concat "--project=" @config.project), (str/concat "--region=" @entity.current.region)] })

      AH_ROLLOUTS -> reading
        (emit AH_HTTP_SEND { key: "rollouts", method: "GET", target: (str/concat "/v1beta/projects/" @config.project "/locations/" @config.region "/backends/" @entity.current.backendId "/rollouts?pageSize=100"), headers: [], body: (bytes/from-string ""), stream: "none" })
      AH_REPLIED -> reading when (and (= @payload.key "rollouts") (!= (json/parse (default (bytes/to-string @payload.body) "") AhRollouts) null) (> (array/len (object/get (json/parse (default (bytes/to-string @payload.body) "") AhRollouts) "rollouts" [])) 0))
        (let ((top (array/nth (array/sort (object/get (json/parse (default (bytes/to-string @payload.body) "") AhRollouts) "rollouts" []) "createTime" "desc") 0)))
          (when (!= @top null) (do
            (set @entity.latest @top)
            (emit AH_BUILD { }))))
      AH_REPLIED -> idle when (and (= @payload.key "rollouts") (!= (json/parse (default (bytes/to-string @payload.body) "") AhRollouts) null) (= (array/len (object/get (json/parse (default (bytes/to-string @payload.body) "") AhRollouts) "rollouts" [])) 0))
        (set @entity.statusCache (array/append (array/filter @entity.statusCache (fn c (!= @c.backendId @entity.current.backendId))) { backendId: @entity.current.backendId, status: { rolloutState: "UNKNOWN", rolloutId: "", rolloutTime: "", commitMessage: "", commitHash: "", commitUrl: "", buildLogsUrl: "", cloudBuildId: "", cloudBuildRegion: "", errorSource: "" }, cachedAt: @now }))
        (emit AH_STATUS { backendId: @entity.current.backendId, status: { rolloutState: "UNKNOWN", rolloutId: "", rolloutTime: "", commitMessage: "", commitHash: "", commitUrl: "", buildLogsUrl: "", cloudBuildId: "", cloudBuildRegion: "", errorSource: "" } })
        (emit AH_RENDER { })
        (emit AH_PUMP { })
      AH_REPLIED -> idle when (and (= @payload.key "rollouts") (== (json/parse (default (bytes/to-string @payload.body) "") AhRollouts) null))
        (notify warning "The App Hosting rollouts could not be read: the reply is not a rollout list")
        (set @entity.statusCache (array/append (array/filter @entity.statusCache (fn c (!= @c.backendId @entity.current.backendId))) { backendId: @entity.current.backendId, status: { rolloutState: "UNKNOWN", rolloutId: "", rolloutTime: "", commitMessage: "", commitHash: "", commitUrl: "", buildLogsUrl: "", cloudBuildId: "", cloudBuildRegion: "", errorSource: "" }, cachedAt: @now }))
        (emit AH_STATUS { backendId: @entity.current.backendId, status: { rolloutState: "UNKNOWN", rolloutId: "", rolloutTime: "", commitMessage: "", commitHash: "", commitUrl: "", buildLogsUrl: "", cloudBuildId: "", cloudBuildRegion: "", errorSource: "" } })
        (emit AH_RENDER { })
        (emit AH_PUMP { })
      AH_BUILD -> reading when (!= (default @entity.latest.build "") "")
        (emit AH_HTTP_SEND { key: "build", method: "GET", target: (str/concat "/v1beta/" (default @entity.latest.build "")), headers: [], body: (bytes/from-string ""), stream: "none" })
      AH_BUILD -> reading when (= (default @entity.latest.build "") "")
        (set @entity.build { })
        (emit AH_SETTLE { })
      AH_REPLIED -> reading when (and (= @payload.key "build") (!= (json/parse (default (bytes/to-string @payload.body) "") AhBuild) null))
        (set @entity.build (json/parse (default (bytes/to-string @payload.body) "") AhBuild))
        (emit AH_SETTLE { })
      AH_REPLIED -> reading when (and (= @payload.key "build") (== (json/parse (default (bytes/to-string @payload.body) "") AhBuild) null))
        (notify warning "The App Hosting build could not be read: the reply is not a build")
        (set @entity.build { })
        (emit AH_SETTLE { })
      AH_FAILED -> reading when (= @payload.key "build")
        (notify warning (str/concat "The App Hosting build could not be read: " @payload.error))
        (set @entity.build { })
        (emit AH_SETTLE { })
      ;; the nth defaults below never fire: a split always yields at least one part
      AH_SETTLE -> idle
        (set @entity.statusCache (array/append (array/filter @entity.statusCache (fn c (!= @c.backendId @entity.current.backendId))) { backendId: @entity.current.backendId, status: (let ((latest @entity.latest) (b @entity.build) (logsUrl (object/get @entity.build "buildLogsUri" "")))
          { rolloutState: (default @latest.state "UNKNOWN"),
            rolloutId: (let ((parts (str/split (default @latest.name "") "/"))) (default (array/nth @parts (- (array/len @parts) 1)) "")),
            rolloutTime: (default @latest.updateTime @latest.createTime),
            commitMessage: (default (array/nth (str/split (object/get @b "source.codebase.commitMessage" "") "\n") 0) ""),
            commitHash: (str/slice (object/get @b "source.codebase.hash" "") 0 7),
            commitUrl: (object/get @b "source.codebase.uri" ""),
            buildLogsUrl: @logsUrl,
            cloudBuildId: (let ((segs (str/split (default (array/nth (str/split @logsUrl "?") 0) "") "/"))) (let ((last (default (array/nth @segs (- (array/len @segs) 1)) ""))) (if (and (str/includes @logsUrl "?") (validate/pattern @last "^[0-9a-f-]{36}$")) @last ""))),
            cloudBuildRegion: (let ((tail (default (array/nth (str/split @logsUrl "region=") 1) ""))) (if (and (str/includes @logsUrl "region=") (str/includes @tail "/")) (default (array/nth (str/split @tail "/") 0) @config.region) @config.region)),
            errorSource: (if (!= (object/get @b "errorSource" "") "") (object/get @b "errorSource" "") (object/get @b "errors.0.errorSource" "")) }), cachedAt: @now }))
        (emit AH_STATUS { backendId: @entity.current.backendId, status: (let ((latest @entity.latest) (b @entity.build) (logsUrl (object/get @entity.build "buildLogsUri" "")))
          { rolloutState: (default @latest.state "UNKNOWN"),
            rolloutId: (let ((parts (str/split (default @latest.name "") "/"))) (default (array/nth @parts (- (array/len @parts) 1)) "")),
            rolloutTime: (default @latest.updateTime @latest.createTime),
            commitMessage: (default (array/nth (str/split (object/get @b "source.codebase.commitMessage" "") "\n") 0) ""),
            commitHash: (str/slice (object/get @b "source.codebase.hash" "") 0 7),
            commitUrl: (object/get @b "source.codebase.uri" ""),
            buildLogsUrl: @logsUrl,
            cloudBuildId: (let ((segs (str/split (default (array/nth (str/split @logsUrl "?") 0) "") "/"))) (let ((last (default (array/nth @segs (- (array/len @segs) 1)) ""))) (if (and (str/includes @logsUrl "?") (validate/pattern @last "^[0-9a-f-]{36}$")) @last ""))),
            cloudBuildRegion: (let ((tail (default (array/nth (str/split @logsUrl "region=") 1) ""))) (if (and (str/includes @logsUrl "region=") (str/includes @tail "/")) (default (array/nth (str/split @tail "/") 0) @config.region) @config.region)),
            errorSource: (if (!= (object/get @b "errorSource" "") "") (object/get @b "errorSource" "") (object/get @b "errors.0.errorSource" "")) }) })
        (emit AH_PUMP { })
      AH_FAILED -> idle when (= @payload.key "rollouts")
        (notify warning (str/concat "App Hosting unreachable: " @payload.error))
        (set @entity.statusCache (array/append (array/filter @entity.statusCache (fn c (!= @c.backendId @entity.current.backendId))) { backendId: @entity.current.backendId, status: { rolloutState: "UNKNOWN", rolloutId: "", rolloutTime: "", commitMessage: "", commitHash: "", commitUrl: "", buildLogsUrl: "", cloudBuildId: "", cloudBuildRegion: "", errorSource: "" }, cachedAt: @now }))
        (emit AH_STATUS { backendId: @entity.current.backendId, status: { rolloutState: "UNKNOWN", rolloutId: "", rolloutTime: "", commitMessage: "", commitHash: "", commitUrl: "", buildLogsUrl: "", cloudBuildId: "", cloudBuildRegion: "", errorSource: "" } })
        (emit AH_RENDER { })
        (emit AH_PUMP { })

      AH_RAN -> idle when (and (= @payload.stage "logs") (= @payload.exitCode 0) (!= (json/parse @payload.stdout AhLogEntries) null))
        (let ((entries (json/parse @payload.stdout AhLogEntries)) (lines (if (== @entries null) [] (array/filter (array/map @entries (fn e { ts: (str/slice (default @e.timestamp "") 0 19), severity: (default @e.severity ""), revision: (let ((rev (object/get @e "resource.labels.revision_name" ""))) (if (= @rev "") "" (default (array/nth (str/split @rev "-") (- (array/len (str/split @rev "-")) 1)) ""))), msg: (str/trim (str/replace-pattern (if (!= (default @e.textPayload "") "") (default @e.textPayload "") (if (!= (object/get @e "jsonPayload.message" "") "") (object/get @e "jsonPayload.message" "") (if (> (array/len (object/keys (default @e.jsonPayload @entity.noPayload))) 0) (json/stringify @e.jsonPayload) ""))) "\u{1b}\\[[0-9;]*m" "")) })) (fn l (> (str/len @l.msg) 0))))))
          (do
            (set @entity.logsCache (array/append (array/filter @entity.logsCache (fn c (!= @c.key @entity.current.backendId))) { key: @entity.current.backendId, lines: @lines, cachedAt: @now }))
            (emit AH_LOGS { backendId: @entity.current.backendId, lines: @lines })))
        (emit AH_PUMP { })
      AH_RAN -> idle when (and (= @payload.stage "logs") (not (and (= @payload.exitCode 0) (!= (json/parse @payload.stdout AhLogEntries) null))))
        (emit AH_LOGS { backendId: @entity.current.backendId, lines: [] })
        (emit AH_RENDER { })
        (notify warning (str/concat "gcloud could not read the logs: " @payload.stderr))
        (emit AH_PUMP { })
      AH_RAN -> idle when (= @payload.stage "build-logs")
        (let ((lines (array/filter (str/split @payload.stdout "\n") (fn l (> (str/len (str/trim @l)) 0)))))
          (do
            (set @entity.buildCache (array/append (array/filter @entity.buildCache (fn c (!= @c.key (str/concat @entity.current.cloudBuildId "|" @entity.current.region)))) { key: (str/concat @entity.current.cloudBuildId "|" @entity.current.region), lines: @lines, cachedAt: @now }))
            (emit AH_BUILD_LOGS { cloudBuildId: @entity.current.cloudBuildId, region: @entity.current.region, lines: @lines })))
        (emit AH_PUMP { })

      AH_CLI_FAILED -> idle when (= @payload.stage "logs")
        (emit AH_LOGS { backendId: @entity.current.backendId, lines: [] })
        (emit AH_RENDER { })
        (notify warning (str/concat "gcloud could not run: " @payload.error))
        (emit AH_PUMP { })
      AH_CLI_FAILED -> idle when (= @payload.stage "build-logs")
        (emit AH_BUILD_LOGS { cloudBuildId: @entity.current.cloudBuildId, region: @entity.current.region, lines: [] })
        (notify warning (str/concat "gcloud could not run: " @payload.error))
        (emit AH_PUMP { })
    }

    emits {
      AH_STATUS -> external {
        backendId : string!
        status : AhStatus!
      }
        @description "A backend's latest rollout and the build behind it."
        @synonyms "rollout status, deploy status, app hosting status"
        @tier "primary"
      AH_LOGS -> external {
        backendId : string!
        lines : [AhLogLine]!
      }
        @description "A backend's recent Cloud Run log lines."
        @synonyms "backend logs, server logs"
        @tier "primary"
      AH_BUILD_LOGS -> external {
        cloudBuildId : string!
        region : string!
        lines : [string]!
      }
        @description "A Cloud Build's log lines."
        @synonyms "build log"
        @tier "primary"
      AH_GCLOUD {
        stage : string!
        argv : [string]!
      }
        @description "Internal: one gcloud run."
        @tier "internal"
      AH_RENDER -> internal { }
        @description "Internal: repaint the board from what is known."
        @tier "internal"
      AH_PUMP -> internal { }
        @description "Internal: read the oldest waiting request, if the board is free."
        @tier "internal"
      AH_START -> internal { }
        @description "Internal: begin the request taken from the queue."
        @tier "internal"
      AH_ROLLOUTS -> internal { }
        @description "Internal: read the backend's rollouts."
        @tier "internal"
      AH_SETTLE -> internal { }
        @description "Internal: cache and answer the status read once its build is known or known unreadable."
        @tier "internal"
      AH_BUILD -> internal { }
        @description "Internal: read the latest rollout's build."
        @tier "internal"
      AH_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
        @description "Internal: one request, for the HTTP client."
        @tier "internal"
    }

    listens {
      AH_STATUS_LOAD -> input {
        backendId : string!
        force : boolean
      }
        @description "Answer this backend's latest rollout; force skips the cache."
        @synonyms "deploy status, rollout"
      AH_LOGS_LOAD -> input {
        backendId : string!
      }
        @description "Answer this backend's recent log lines."
        @synonyms "backend logs"
      AH_BUILD_LOGS_LOAD -> input {
        cloudBuildId : string!
        region : string
      }
        @description "Answer this Cloud Build's log; the region knob when none is given."
        @synonyms "build logs, why did the deploy fail"
      AH_REFRESH_ALL -> input { }
        @description "Read every listed backend's status afresh."
        @synonyms "refresh app hosting"
      AH_BACKEND_OPEN {
        id : string!
        row : AhBoardRow
      }
        @description "A board row was clicked: read that backend's recent log lines."
      AH_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "A std-cli CLI_DONE: one gcloud run exited."
      AH_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "A std-cli CLI_FAILED: gcloud could not run."
      AhGcloud.CLI_DONE -> AH_RAN
      AhGcloud.CLI_FAILED -> AH_CLI_FAILED
      AH_REPLIED {
        key : string!
        status : number!
        headers : Map string string
        body : bytes!
      }
      AH_FAILED {
        key : string
        error : string!
        kind : string!
      }
      AhApi.AH_HTTP_REPLIED -> AH_REPLIED
      AhApi.AH_HTTP_FAILED -> AH_FAILED
    }

    config {
      title : string = "App Hosting"
        @label "Title"
        @description "The board's heading."
        @tier "presentation"
      loadOnInit : boolean = false
        @label "Load when opened"
        @description "Read every listed backend's status as soon as the page opens."
        @tier "presentation"
      backends : [string] = []
        @label "Backends"
        @description "The App Hosting backends the board lists."
        @tier "domain"
      statusSlot : slot = main
        @label "Status slot"
        @description "Where the board shows its one-line status."
        @synonyms "status area"
        @tier "presentation"
      project : string = ""
        @label "Project"
        @description "The Firebase / Google Cloud project id."
        @synonyms "firebase project"
        @tier "domain"
      region : string = ""
        @label "Region"
        @description "The App Hosting region the backends run in, and the Cloud Build region when a build log url names none."
        @synonyms "location"
        @tier "domain"
      logLimit : number = 60
        @label "Log lines"
        @description "How many recent log entries a logs read asks for."
        @tier "domain"
      statusTtlMs : number = 120000
        @label "Status cache window"
        @description "Milliseconds a backend's status is answered without reading again."
        @tier "infra"
      logsTtlMs : number = 60000
        @label "Logs cache window"
        @description "Milliseconds a backend's logs or a build's log are answered without reading again."
        @tier "infra"
    }
  }

  page "/app-hosting-board" as AppHostingBoardPage -> AppHostingStatus, AhApi, AhGcloud
}
