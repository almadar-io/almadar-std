app std-program-host [
  version: "1.0.0",
  inbound: ["cli-program-host"],
  fs: { cwd: "**/*.lolo": [read] },
  kernel: { "guest": [spawn] },
  description: "std-program-host — the runtime as a .lolo program (`orb host <shell> <program>`). The cli-program-host command takes argv: the guest program path, then optional `--grant=<kind>` flags (a kind the guestGrants knob holds: fs, exec, net, credentials) that narrow the guestGrants knob to those kinds; with no flag the guest gets the whole knob, and the knob defaults to no grants at all, so the guest never inherits the host's own. It resolves the program (program/read { resolve }, EXEC-LOAD-1) and opens it as a guest session with program/open, passing the grants at open and only there (EXEC-CONC-7); the host holds the grant `kernel: { guest: [spawn] }` and the kernel refuses an open whose grants the host does not hold, naming them. It emits HOST_LOADED { path } once the guest is open, or HOST_REFUSED { reason } when argv names no program, the file cannot be read, resolved or opened, or a flag names a kind the knob does not hold; the command is answered with a status and body (200 loaded, 400 usage or refused grants, 500 unreadable or refused at open). Once loaded, each HOST_EVENT { key, orbital, trait, event, payload } (payload as JSON text) is forwarded to the guest by a keyed program/dispatch { guest } to Orbital.Trait.EVENT, run on the guest's own lane, and each guest answer is relayed as HOST_ANSWERED { key, result }; a failed dispatch is answered under the key it was sent with. A guest's lazy pages are not carried: the open takes the resolved program only."
]
uses Spec from "almadar-std/program-host"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type HostOpened = { guest : string! }
type HostResolved = { program : SExpr! }
type HostFsGrant = { glob : string!, modes : [string]! }
type HostNetGrant = { target : string!, kinds : [string]! }
type HostGrants = { fs : [HostFsGrant]?, exec : [string]?, net : [HostNetGrant]?, credentials : [string]? }

orbital ProgramHostOrbital {
  uses Args from "std/behaviors/std-args"

  entity GuestProgram [runtime] {
    id : string!
    path : string! = ""
    file : string! = ""
    cwd : string! = ""
    guest : string! = ""
    loaded : boolean! = false
    grants : HostGrants = {}
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      ProgramHost.HOST_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait ProgramHost -> GuestProgram [optimistic] {
    initial: waiting

    state waiting {
      INIT -> waiting
      HOST_CALLED -> waiting when (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (emit HOST_COMMAND_ANSWERED { status: 500, body: "Error: orb host: the command arguments could not be read" })
      HOST_CALLED -> parsing when (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (set @entity.cwd (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [], cwd: "" }) "cwd"))
        (emit HOST_ARGS_PARSE { stage: "host" argv: (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [] }) "argv") flags: [{ name: "grant" aliases: [] takesValue: true repeatable: true }] })
    }

    state parsing {
      INIT -> parsing
      HOST_ARGS_DONE -> waiting when (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0))
        (emit HOST_REFUSED { reason: "usage: orb host <shell> <program.lolo> [--grant=<kind>]" })
        (emit HOST_COMMAND_ANSWERED { status: 400, body: "usage: orb host <shell> <program.lolo> [--grant=<kind>]" })
      HOST_ARGS_DONE -> waiting when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (> (array/len (array/filter (default (object/get @payload.flags "grant") []) (fn k (not (object/has @config.guestGrants @k))))) 0))
        (emit HOST_REFUSED { reason: "a grant flag names a kind the guestGrants knob does not hold" })
        (emit HOST_COMMAND_ANSWERED { status: 400, body: "host: a grant flag names a kind the guestGrants knob does not hold" })
      HOST_ARGS_DONE -> reading when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (= (array/len (array/filter (default (object/get @payload.flags "grant") []) (fn k (not (object/has @config.guestGrants @k))))) 0))
        (set @entity.path (default (array/first @payload.positionals) ""))
        (set @entity.grants (let ((sel (default (object/get @payload.flags "grant") []))) { fs: (if (or (= (array/len @sel) 0) (array/includes @sel "fs")) (default (object/get @config.guestGrants "fs") []) []) exec: (if (or (= (array/len @sel) 0) (array/includes @sel "exec")) (default (object/get @config.guestGrants "exec") []) []) net: (if (or (= (array/len @sel) 0) (array/includes @sel "net")) (default (object/get @config.guestGrants "net") []) []) credentials: (if (or (= (array/len @sel) 0) (array/includes @sel "credentials")) (default (object/get @config.guestGrants "credentials") []) []) }))
        (set @entity.file (if (os/path-is-absolute (default (array/first @payload.positionals) "")) (array/first @payload.positionals) (str/concat @entity.cwd "/" (array/first @payload.positionals))))
        (program/read "" { resolve: true text: false path: @entity.file } { key: "program" emit: { success: HOST_PROGRAM_READ, failure: HOST_LOAD_FAILED } })
    }

    state reading {
      INIT -> reading
      HOST_PROGRAM_READ -> reading
        (program/open (object/get @payload.result "program") { grants: @entity.grants } { key: "guest" emit: { success: HOST_GUEST_OPENED, failure: HOST_LOAD_FAILED } })
      HOST_GUEST_OPENED -> hosting
        (set @entity.guest @payload.result.guest)
        (set @entity.loaded true)
        (emit HOST_LOADED { path: @entity.path })
        (emit HOST_COMMAND_ANSWERED { status: 200, body: (str/concat "hosting " @entity.path) })
      HOST_LOAD_FAILED -> waiting
        (emit HOST_REFUSED { reason: @payload.error })
        (emit HOST_COMMAND_ANSWERED { status: 500, body: (str/concat "host: " (default @payload.error "")) })
    }

    state hosting {
      INIT -> hosting
      HOST_EVENT -> hosting
        (program/dispatch (str/concat @payload.orbital "." @payload.trait "." @payload.event) @payload.payload { guest: @entity.guest key: @payload.key emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_GUEST_ANSWERED -> hosting
        (emit HOST_ANSWERED { key: @payload.key, result: (json/stringify @payload.result) })
      HOST_GUEST_FAILED -> hosting
        (emit HOST_ANSWERED { key: (default @payload.key ""), result: (json/stringify { ok: false, error: @payload.error }) })
    }

    emits {
      HOST_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the --grant flag."
        @tier "internal"
      HOST_COMMAND_ANSWERED -> internal { status : number!  body : string! }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      HOST_LOADED -> external { path : string! }
        @description "The guest program was read and parsed."
      HOST_REFUSED -> external { reason : string! }
        @description "The command or the guest program was refused."
      HOST_ANSWERED -> external { key : string!  result : string! }
        @description "A guest's answer to a forwarded event."
      HOST_PROGRAM_READ { result : HostResolved! }
        @description "The guest program resolved."
        @tier "internal"
      HOST_GUEST_OPENED { result : HostOpened! }
        @description "The guest session opened; its handle keys every dispatch."
        @tier "internal"
      HOST_LOAD_FAILED { error : string }
        @description "A read, resolve or open that failed."
        @tier "internal"
      HOST_GUEST_ANSWERED { key : string, result : string }
        @description "The keyed dispatch completed."
        @tier "internal"
      HOST_GUEST_FAILED { key : string, error : string }
        @description "The keyed dispatch failed."
        @tier "internal"
    }

    listens {
      HOST_CALLED -> inbound "cli-program-host" answers HOST_COMMAND_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb host` with its arguments and working directory."
        @synonyms "orb host, runtime host, host a program"
      HOST_EVENT { key : string!, orbital : string!, trait : string!, event : string!, payload : string }
        @description "An external event for the guest program."
      HOST_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> HOST_ARGS_DONE
    }

    config {
      guestGrants : HostGrants = {}
        @label "Guest grants"
        @description "The os grants the guest is opened with, by kind (fs, exec, net, credentials) in the form a program declares them; the guest gets nothing else, and the host must hold every one (the kernel refuses an open it does not cover). The default is no grants."
        @synonyms "guest permissions, sandbox grants"
        @tier "domain"
    }
  }

  page boot as ProgramHostOrbitalStart -> ProgramHost, ArgsCli
}
