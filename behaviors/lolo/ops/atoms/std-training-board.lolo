app std-training-board [
  version: "1.0.0",
  description: "std-training-board — the model-training instances of one AWS region, read through the aws and ssh CLIs (std-cli, with the host's PATH and HOME passed through). TRAINING_LOAD answers TRAINING_BOARD from the cache within cacheTtlMs; TRAINING_REFRESH reads afresh; a load during a read is answered by that read. A read lists the region's running instances of the instanceTypes families, then, for each one with a public address, runs one ssh command as sshUser with the sshKey identity that prints four sections: the GPU (nvidia-smi: name, temperature, memory used and total, utilization; each number is the value's leading token), the first process matching processPattern (pid, cpu, memory in MiB, elapsed time, command), the uptime, and the last logLines lines of the first readable logPaths file. From the log it keeps the last tailLines lines and the epochs in the trainer's declared formats: an `Epoch N | key=value … (Ts)` line (best when it carries *BEST*), and a Hugging Face Trainer metrics dict (its epoch times 1000, rounded). An instance ssh cannot reach, or without a public address, keeps its listing with every other part absent.",
  exec: ["aws", "ssh"],
  env: ["PATH", "HOME"]
]
uses Spec from "almadar-std/training-board"
type StatusBoardTile = { label : string!, value : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, icon : string! }
type StatusBoardSection = { key : string!, label : string! }
type StatusBoardRow = { id : string!, section : string!, title : string!, subtitle : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, statusLabel : string!, icon : string!, meta : [string]!, at : instant?, url : string! }
type StatusBoardDetailItem = { label : string!, tone : "neutral" | "success" | "warning" | "danger" | "info"!, statusLabel : string!, meta : string! }
type StatusBoardDetail = { rowId : string!, phase : "loading" | "ready" | "failed"!, items : [StatusBoardDetailItem]!, code : string!, codeTitle : string!, errorLines : [number]!, error : string! }
type TrListed = { Id : string, Type : string, IP : string, Launch : string }
type TrListing = [TrListed]
type TrFound = { instanceId : string?, instanceType : string?, publicIp : string, launchTime : string? }
type TrGpu = { name : string, temp : number, memoryUsed : number, memoryTotal : number, utilization : number }
type TrProcess = { pid : number, cpu : number, memoryMb : number?, elapsed : string, command : string }
type TrGpuMap = Map string TrGpu
type TrProcessMap = Map string TrProcess
type TrMetricText = Map string string
type TrEpoch = { epoch : number, metrics : Map string number, time : number, isBest : boolean }
type TrInstance = { instanceId : string, instanceType : string, publicIp : string, launchTime : string, uptime : string, gpu : TrGpu, process : TrProcess, epochs : [TrEpoch], logTail : [string] }
orbital TrainingBoardOrbital {
  uses Cli from "std/behaviors/std-cli"
  uses Board from "std/behaviors/std-status-board"

  entity TrainingBoard [runtime] {
    id : string!
    instances : [TrInstance] @description "The board last answered." = []
    fetchedAt : string @description "When the read the board came from began." = ""
    cachedAt : instant = 0
    hasCache : boolean = false
    loading : boolean @description "Whether a read is in flight." = false
    startedAt : instant = 0
    found : [TrFound] @description "The instances the read in flight is visiting." = []
    collected : [TrInstance] = []
    cursor : number @description "Index of the instance being visited." = 0
    noText : Map string string @description "Empty: read where a part is absent." = {}
    noGpu : TrGpuMap @description "Empty: read where a GPU is absent." = {}
    noProcess : TrProcessMap @description "Empty: read where a process is absent." = {}
    noMetrics : Map string number @description "Empty metrics." = {}
  }

  trait TrAws = Cli.traits.CliRunner {
    listens { TrainingStatus.TR_AWS -> CLI_RUN }
    config {
      commands: ["aws"]
      passEnv: ["PATH", "HOME"]
    }
  }

  trait TrSsh = Cli.traits.CliRunner {
    listens { TrainingStatus.TR_SSH -> CLI_RUN }
    config {
      commands: ["ssh"]
      passEnv: ["PATH", "HOME"]
    }
  }

  trait TrainingView = Board.traits.StatusBoard {
    listens {
      TrainingStatus.TR_BOARD_LOADING -> BOARD_LOADING
      TrainingStatus.TR_BOARD_SHOW -> BOARD_SHOW
      TrainingStatus.TR_BOARD_FAILED -> BOARD_FAILED
      TrainingStatus.TR_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
    }
    config {
      title: "Training"
      icon: "cpu"
      idleDescription: "Load the board to read the training instances."
      emptyTitle: "No training instances"
      emptyDescription: "No running instance matched the instance types."
    }
  }

  trait TrainingStatus -> TrainingBoard [client] {
    initial: idle

    state idle {
      TR_SHOW -> idle
        (let ((withGpu (array/filter @entity.instances (fn i (!= @i.gpu null)))) (training (array/count @entity.instances (fn i (!= @i.process null)))))
          (emit TR_BOARD_SHOW { note: (str/concat (array/len @config.instanceTypes) " instance families in " @config.region), fetchedAt: @entity.cachedAt, error: "",
            tiles: [{ label: "Instances", value: (str/concat (array/len @entity.instances)), tone: "neutral", icon: "server" },
              (if (> @training 0) { label: "Training", value: (str/concat @training), tone: "success", icon: "activity" } { label: "Training", value: "0", tone: "neutral", icon: "activity" }),
              { label: "GPU utilization", value: (if (= (array/len @withGpu) 0) "no GPU data" (str/concat (math/round (/ (array/sum (array/map @withGpu (fn i (default @i.gpu.utilization 0)))) (array/len @withGpu)) 0) "%")), tone: "neutral", icon: "cpu" },
              { label: "Hottest GPU", value: (if (= (array/len @withGpu) 0) "no GPU data" (str/concat (default (array/max (array/map @withGpu (fn i (default @i.gpu.temp 0)))) 0) "°C")), tone: "neutral", icon: "thermometer" }],
            sections: [{ key: "training", label: "Training" }, { key: "idle", label: "Idle" }, { key: "unreachable", label: "Unreachable" }],
            rows: (array/map @entity.instances (fn i (let ((id (default @i.instanceId "")) (ip (if (= (default @i.publicIp "") "") "no public address" (default @i.publicIp ""))))
              (let ((sub (if (== @i.process null) (str/concat (default @i.instanceType "") " · " @ip) (default @i.process.command "")))
                    (meta (if (== @i.gpu null) (array/take [""] 0) [(str/concat (default @i.gpu.utilization 0) "% GPU"), (str/concat (math/round (/ (default @i.gpu.memoryUsed 0) 1024) 1) "/" (math/round (/ (default @i.gpu.memoryTotal 0) 1024) 1) " GiB"), (str/concat (default @i.gpu.temp 0) "°C")])))
                (if (== @i.gpu null) (let ((r : StatusBoardRow { id: @id, section: "unreachable", title: @id, subtitle: @sub, tone: "warning", statusLabel: "Unreachable", icon: "", meta: @meta, at: null, url: "" })) @r) (if (== @i.process null) (let ((r : StatusBoardRow { id: @id, section: "idle", title: @id, subtitle: @sub, tone: "neutral", statusLabel: "Idle", icon: "", meta: @meta, at: null, url: "" })) @r) (let ((r : StatusBoardRow { id: @id, section: "training", title: @id, subtitle: @sub, tone: "success", statusLabel: "Training", icon: "", meta: @meta, at: null, url: "" })) @r)))))))  }))
      TR_ROW_OPENED -> idle
        (let ((i (array/find @entity.instances (fn x (= @x.instanceId @payload.rowId)))))
          (if (== @i null)
            (emit TR_BOARD_DETAIL { detail: { rowId: @payload.rowId, phase: "failed", items: [], code: "", codeTitle: "", errorLines: [], error: "The instance is no longer listed" } })
            (emit TR_BOARD_DETAIL { detail: { rowId: @payload.rowId, phase: "ready", code: (str/join (default @i.logTail []) "\n"), codeTitle: "Training log", errorLines: [], error: "",
              items: (array/concat [{ label: "Instance type", tone: "neutral", statusLabel: (default @i.instanceType ""), meta: "" }, { label: "Address", tone: "neutral", statusLabel: (if (= (default @i.publicIp "") "") "no public address" (default @i.publicIp "")), meta: "" }, { label: "Uptime", tone: "neutral", statusLabel: (default @i.uptime "unreachable"), meta: (str/concat "launched " (default @i.launchTime "")) }]
                (if (== @i.gpu null) [] [{ label: "GPU", tone: "neutral", statusLabel: (str/concat (default @i.gpu.utilization 0) "%"), meta: (str/concat (default @i.gpu.name "") " · " (default @i.gpu.memoryUsed 0) "/" (default @i.gpu.memoryTotal 0) " MiB · " (default @i.gpu.temp 0) "°C") }])
                (if (== @i.process null) [{ label: "Process", tone: "neutral", statusLabel: "none", meta: "" }] [{ label: "Process", tone: "success", statusLabel: "running", meta: (str/concat "pid " (default @i.process.pid 0) " · cpu " (default @i.process.cpu 0) "% · " (default @i.process.elapsed "")) }])
                [{ label: "Epochs", tone: "neutral", statusLabel: (str/concat (array/len (default @i.epochs []))), meta: "" }]
                (let ((last (array/last (default @i.epochs [])))) (if (== @last null) [] [{ label: "Latest epoch", tone: "info", statusLabel: (str/concat (default @last.epoch 0)), meta: (str/join (array/map (object/entries (default @last.metrics @entity.noMetrics)) (fn e (str/concat (default (array/nth @e 0) "") "=" (default (array/nth @e 1) 0)))) " ") }]))
                (let ((best (array/find (default @i.epochs []) (fn e (default @e.isBest false))))) (if (== @best null) [] [{ label: "Best epoch", tone: "success", statusLabel: (str/concat (default @best.epoch 0)), meta: (str/join (array/map (object/entries (default @best.metrics @entity.noMetrics)) (fn e (str/concat (default (array/nth @e 0) "") "=" (default (array/nth @e 1) 0)))) " ") }]))) } })))
      TRAINING_LOAD -> idle when (and @entity.hasCache (< (time/diff @now @entity.cachedAt) @config.cacheTtlMs))
        (emit TRAINING_BOARD { instances: @entity.instances, fetchedAt: @entity.fetchedAt })
        (emit TR_SHOW { })
      TRAINING_LOAD -> reading when (not (and @entity.hasCache (< (time/diff @now @entity.cachedAt) @config.cacheTtlMs)))
        (set @entity.loading true)
        (emit TR_BOARD_LOADING { })
        (set @entity.startedAt @now)
        (set @entity.found [])
        (set @entity.collected [])
        (set @entity.cursor 0)
        (set @entity.noText (object/fromEntries (array/take [["", ""]] 0)))
        (set @entity.noGpu {})
        (set @entity.noProcess {})
        (set @entity.noMetrics (object/fromEntries (array/take [["", 0]] 0)))
        (emit TR_AWS { stage: "list", argv: ["ec2", "describe-instances", "--region", @config.region, "--filters", "Name=instance-state-name,Values=running", (str/concat "Name=instance-type,Values=" (str/join @config.instanceTypes ",")), "--query", "Reservations[].Instances[].{Id:InstanceId,Type:InstanceType,IP:PublicIpAddress,Launch:LaunchTime}", "--output", "json"] })
      TRAINING_REFRESH -> reading
        (set @entity.loading true)
        (emit TR_BOARD_LOADING { })
        (set @entity.startedAt @now)
        (set @entity.found [])
        (set @entity.collected [])
        (set @entity.cursor 0)
        (set @entity.noText (object/fromEntries (array/take [["", ""]] 0)))
        (set @entity.noGpu {})
        (set @entity.noProcess {})
        (set @entity.noMetrics (object/fromEntries (array/take [["", 0]] 0)))
        (emit TR_AWS { stage: "list", argv: ["ec2", "describe-instances", "--region", @config.region, "--filters", "Name=instance-state-name,Values=running", (str/concat "Name=instance-type,Values=" (str/join @config.instanceTypes ",")), "--query", "Reservations[].Instances[].{Id:InstanceId,Type:InstanceType,IP:PublicIpAddress,Launch:LaunchTime}", "--output", "json"] })
    }

    state reading {
      TR_ROW_OPENED -> reading
        (let ((i (array/find @entity.instances (fn x (= @x.instanceId @payload.rowId)))))
          (if (== @i null)
            (emit TR_BOARD_DETAIL { detail: { rowId: @payload.rowId, phase: "failed", items: [], code: "", codeTitle: "", errorLines: [], error: "The instance is no longer listed" } })
            (emit TR_BOARD_DETAIL { detail: { rowId: @payload.rowId, phase: "ready", code: (str/join (default @i.logTail []) "\n"), codeTitle: "Training log", errorLines: [], error: "",
              items: (array/concat [{ label: "Instance type", tone: "neutral", statusLabel: (default @i.instanceType ""), meta: "" }, { label: "Address", tone: "neutral", statusLabel: (if (= (default @i.publicIp "") "") "no public address" (default @i.publicIp "")), meta: "" }, { label: "Uptime", tone: "neutral", statusLabel: (default @i.uptime "unreachable"), meta: (str/concat "launched " (default @i.launchTime "")) }]
                (if (== @i.gpu null) [] [{ label: "GPU", tone: "neutral", statusLabel: (str/concat (default @i.gpu.utilization 0) "%"), meta: (str/concat (default @i.gpu.name "") " · " (default @i.gpu.memoryUsed 0) "/" (default @i.gpu.memoryTotal 0) " MiB · " (default @i.gpu.temp 0) "°C") }])
                (if (== @i.process null) [{ label: "Process", tone: "neutral", statusLabel: "none", meta: "" }] [{ label: "Process", tone: "success", statusLabel: "running", meta: (str/concat "pid " (default @i.process.pid 0) " · cpu " (default @i.process.cpu 0) "% · " (default @i.process.elapsed "")) }])
                [{ label: "Epochs", tone: "neutral", statusLabel: (str/concat (array/len (default @i.epochs []))), meta: "" }]
                (let ((last (array/last (default @i.epochs [])))) (if (== @last null) [] [{ label: "Latest epoch", tone: "info", statusLabel: (str/concat (default @last.epoch 0)), meta: (str/join (array/map (object/entries (default @last.metrics @entity.noMetrics)) (fn e (str/concat (default (array/nth @e 0) "") "=" (default (array/nth @e 1) 0)))) " ") }]))
                (let ((best (array/find (default @i.epochs []) (fn e (default @e.isBest false))))) (if (== @best null) [] [{ label: "Best epoch", tone: "success", statusLabel: (str/concat (default @best.epoch 0)), meta: (str/join (array/map (object/entries (default @best.metrics @entity.noMetrics)) (fn e (str/concat (default (array/nth @e 0) "") "=" (default (array/nth @e 1) 0)))) " ") }]))) } })))
      INIT -> reading
      TRAINING_LOAD -> reading
      TRAINING_REFRESH -> reading

      TR_RAN -> reading when (and (= @payload.stage "list") (= @payload.exitCode 0) (json/valid @payload.stdout))
        (set @entity.found (array/map (json/parse @payload.stdout TrListing) (fn i { instanceId: @i.Id, instanceType: @i.Type, publicIp: (default @i.IP ""), launchTime: @i.Launch })))
        (set @entity.cursor 0)
        (emit TR_NEXT { })
      TR_RAN -> idle when (and (= @payload.stage "list") (not (and (= @payload.exitCode 0) (json/valid @payload.stdout))))
        (set @entity.loading false)
        (emit TR_BOARD_FAILED { error: (if (= @payload.exitCode 0) "aws answered something that is not JSON" (str/concat "aws failed (exit " @payload.exitCode "): " (if (= (str/trim @payload.stderr) "") "no error text" (str/trim @payload.stderr)))) })
      TR_CLI_FAILED -> idle when (= @payload.stage "list")
        (set @entity.loading false)
        (emit TR_BOARD_FAILED { error: (str/concat "aws is not installed or could not run: " @payload.error) })
      TR_NEXT -> reading when (and (< @entity.cursor (array/len @entity.found)) (!= (default (array/nth (array/map @entity.found (fn f (default @f.publicIp ""))) @entity.cursor) "") ""))
        (emit TR_SSH { stage: "visit", argv: ["-i", @config.sshKey, "-o", "ConnectTimeout=5", "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null", "-o", "LogLevel=ERROR", "-l", @config.sshUser, (default (array/nth (array/map @entity.found (fn f (default @f.publicIp ""))) @entity.cursor) ""), (str/concat "echo \"===GPU===\"; nvidia-smi --query-gpu=name,temperature.gpu,memory.used,memory.total,utilization.gpu --format=csv,noheader 2>/dev/null || echo \"N/A\"; echo \"===PROCESS===\"; ps aux | grep -E \"" @config.processPattern "\" | grep -v grep | head -1 || echo \"NONE\"; echo \"===UPTIME===\"; uptime -p 2>/dev/null || uptime; echo \"===LOG===\"; " (str/join (array/map @config.logPaths (fn p (str/concat "tail -" @config.logLines " " @p " 2>/dev/null"))) " || ") " || echo \"NO LOG\"")] })
      TR_NEXT -> reading when (and (< @entity.cursor (array/len @entity.found)) (= (default (array/nth (array/map @entity.found (fn f (default @f.publicIp ""))) @entity.cursor) "") ""))
        (emit TR_SKIP { })
      TR_SKIP -> reading
        (set @entity.collected (array/append @entity.collected (let ((inst (array/nth @entity.found @entity.cursor)))
          { instanceId: @inst.instanceId, instanceType: @inst.instanceType, publicIp: @inst.publicIp, launchTime: @inst.launchTime,
            uptime: (array/nth (object/values (object/pick @entity.noText [(str/concat "x")])) 0),
            gpu: (array/nth (object/values (object/pick @entity.noGpu [(str/concat "x")])) 0),
            process: (array/nth (object/values (object/pick @entity.noProcess [(str/concat "x")])) 0),
            epochs: [], logTail: [] })))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit TR_NEXT { })
      TR_NEXT -> idle when (>= @entity.cursor (array/len @entity.found))
        (set @entity.instances @entity.collected)
        (set @entity.fetchedAt (str/concat (default (time/format @entity.startedAt "YYYY-MM-DDTHH:mm:ss") "") "." (str/padStart (str/concat (time/diff @entity.startedAt (time/startOf @entity.startedAt "second"))) 3 "0") "Z"))
        (set @entity.cachedAt @now)
        (set @entity.hasCache true)
        (set @entity.loading false)
        (emit TRAINING_BOARD { instances: @entity.instances, fetchedAt: @entity.fetchedAt })
        (emit TR_SHOW { })
      ;; the nth defaults below never fire: gpu parts (>= 5), process columns (>= 11) and split heads are length-checked first
      TR_RAN -> reading when (= @payload.stage "visit")
        (set @entity.collected (array/append @entity.collected (let ((inst (array/nth @entity.found @entity.cursor)) (out (if (= @payload.exitCode 0) (str/trim @payload.stdout) "")))
          (let ((gpuText (let ((parts (str/split @out "==="))) (let ((at (array/findIndex @parts (fn x (= @x "GPU"))))) (if (and (>= @at 0) (= (math/mod @at 2) 1)) (str/trim (default (array/nth @parts (+ @at 1)) "")) "")))) (procText (let ((parts (str/split @out "==="))) (let ((at (array/findIndex @parts (fn x (= @x "PROCESS"))))) (if (and (>= @at 0) (= (math/mod @at 2) 1)) (str/trim (default (array/nth @parts (+ @at 1)) "")) "")))) (upText (let ((parts (str/split @out "==="))) (let ((at (array/findIndex @parts (fn x (= @x "UPTIME"))))) (if (and (>= @at 0) (= (math/mod @at 2) 1)) (str/trim (default (array/nth @parts (+ @at 1)) "")) "")))) (logText (let ((parts (str/split @out "==="))) (let ((at (array/findIndex @parts (fn x (= @x "LOG"))))) (if (and (>= @at 0) (= (math/mod @at 2) 1)) (str/trim (default (array/nth @parts (+ @at 1)) "")) "")))))
            (let ((gpuParts (array/map (str/split @gpuText ",") (fn x (str/trim @x))))
                  (cols (array/filter (str/split @procText " ") (fn c (!= @c ""))))
                  (lines (if (and (!= @logText "") (!= @logText "NO LOG")) (str/split @logText "\n") (array/take [""] 0))))
              { instanceId: @inst.instanceId, instanceType: @inst.instanceType, publicIp: @inst.publicIp, launchTime: @inst.launchTime,
                uptime: (if (= @upText "") (array/nth (object/values (object/pick @entity.noText [(str/concat "x")])) 0) @upText),
                gpu: (if (and (!= @gpuText "") (!= @gpuText "N/A") (>= (array/len @gpuParts) 5)) { name: (array/nth @gpuParts 0), temp: (str/to-number (default (array/nth (str/split (str/trim (default (array/nth @gpuParts 1) "")) " ") 0) "")), memoryUsed: (str/to-number (default (array/nth (str/split (str/trim (default (array/nth @gpuParts 2) "")) " ") 0) "")), memoryTotal: (str/to-number (default (array/nth (str/split (str/trim (default (array/nth @gpuParts 3) "")) " ") 0) "")), utilization: (str/to-number (default (array/nth (str/split (str/trim (default (array/nth @gpuParts 4) "")) " ") 0) "")) } (array/nth (object/values (object/pick @entity.noGpu [(str/concat "x")])) 0)),
                process: (if (and (!= @procText "") (!= @procText "NONE") (>= (array/len @cols) 11)) { pid: (str/to-number (default (array/nth @cols 1) "")), cpu: (str/to-number (default (array/nth @cols 2) "")), memoryMb: (let ((rss (str/to-number (default (array/nth @cols 5) "")))) (if (== @rss null) null (math/round (/ @rss 1024) 0))), elapsed: (array/nth @cols 9), command: (str/join (array/slice @cols 10) " ") } (array/nth (object/values (object/pick @entity.noProcess [(str/concat "x")])) 0)),
                epochs: (array/flatten (array/map @lines (fn l (if (validate/pattern @l "Epoch\\s+\\d+\\s*\\|.+\\(\\d+(?:\\.\\d+)?s\\)") [(let ((afterPipe (str/join (array/slice (str/split @l "|") 1) "|")))
            (let ((parts (str/split @afterPipe "(")))
              { epoch: (let ((head (default (array/nth (str/split @l "|") 0) ""))) (str/to-number (str/trim (default (array/nth (str/split @head "Epoch") (- (array/len (str/split @head "Epoch")) 1)) "")))),
                metrics: (object/fromEntries (array/map (array/filter (str/split (str/trim (str/join (array/take @parts (- (array/len @parts) 1)) "(")) " ") (fn t (validate/pattern @t "^\\w+=[\\d.]+$"))) (fn t [(array/nth (str/split @t "=") 0), (str/to-number (default (array/nth (str/split @t "=") 1) ""))]))),
                time: (str/to-number (default (array/nth (str/split (default (array/nth @parts (- (array/len @parts) 1)) "") "s)") 0) "")),
                isBest: (str/includes @l "*BEST*") }))] (let ((dict (if (validate/pattern @l "\\{(?:'[a-z_]+':\\s*'[\\d.e+-]+',?\\s*)+\\}") (json/parse (str/replaceAll (let ((afterBrace (str/join (array/slice (str/split @l "{") 1) "{"))) (str/concat "{" (str/join (array/take (str/split @afterBrace "}") (- (array/len (str/split @afterBrace "}")) 1)) "}") "}")) "'" "\"") TrMetricText) null)))
            (if (== @dict null) (array/take [{ epoch: 0, metrics: @entity.noMetrics, time: 0, isBest: false }] 0) [(let ((metrics (object/fromEntries (array/map (object/entries @dict) (fn e [(array/nth @e 0), (str/to-number (array/nth @e 1))])))))
              { epoch: (math/round (* (object/get @metrics "epoch" 0) 1000) 0), metrics: @metrics, time: 0, isBest: false })])))))),
                logTail: (array/takeLast @lines @config.tailLines) })))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit TR_NEXT { })
      TR_CLI_FAILED -> reading when (= @payload.stage "visit")
        (set @entity.collected (array/append @entity.collected (let ((inst (array/nth @entity.found @entity.cursor)))
          { instanceId: @inst.instanceId, instanceType: @inst.instanceType, publicIp: @inst.publicIp, launchTime: @inst.launchTime,
            uptime: (array/nth (object/values (object/pick @entity.noText [(str/concat "x")])) 0),
            gpu: (array/nth (object/values (object/pick @entity.noGpu [(str/concat "x")])) 0),
            process: (array/nth (object/values (object/pick @entity.noProcess [(str/concat "x")])) 0),
            epochs: [], logTail: [] })))
        (set @entity.cursor (+ @entity.cursor 1))
        (notify warning (str/concat "ssh could not run: " @payload.error))
        (emit TR_NEXT { })
    }

    emits {
      TRAINING_BOARD -> external {
        instances : [TrInstance]!
        fetchedAt : string!
      }
        @description "The training instances with their GPU, process, uptime, log tail and epochs, and when they were read."
        @synonyms "training status, gpu instances, training progress"
        @tier "primary"
      TR_BOARD_LOADING { }
        @description "Internal: a read began, to the board."
        @tier "internal"
      TR_BOARD_SHOW {
        note : string!
        tiles : [StatusBoardTile]!
        sections : [StatusBoardSection]!
        rows : [StatusBoardRow]!
        fetchedAt : instant!
        error : string!
      }
        @description "Internal: the figures, sections and rows, to the board."
        @tier "internal"
      TR_BOARD_FAILED {
        error : string!
      }
        @description "Internal: the read failed, to the board."
        @tier "internal"
      TR_BOARD_DETAIL {
        detail : StatusBoardDetail!
      }
        @description "Internal: one instance's detail, to the board."
        @tier "internal"
      TR_SHOW -> internal { }
        @description "Internal: show the held instances on the board."
        @tier "internal"
      TR_AWS {
        stage : string!
        argv : [string]!
      }
        @description "Internal: one aws run."
        @tier "internal"
      TR_SSH {
        stage : string!
        argv : [string]!
      }
        @description "Internal: one ssh run."
        @tier "internal"
      TR_NEXT -> internal { }
        @description "Internal: visit the next instance, or answer."
        @tier "internal"
      TR_SKIP -> internal { }
        @description "Internal: list an instance without a public address as it is."
        @tier "internal"
    }

    listens {
      TRAINING_LOAD -> input { }
        @description "Answer the training board, from the cache while it is fresh."
        @synonyms "show training"
      TRAINING_REFRESH -> input { }
        @description "Read the training board afresh."
      TR_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "A std-cli CLI_DONE: one aws or ssh run exited."
      TR_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "A std-cli CLI_FAILED: aws or ssh could not run."
      TR_ROW_OPENED {
        rowId : string!
      }
        @description "The board opened an instance's row: its detail is answered from the held instances."
      TrainingView.BOARD_LOAD -> TRAINING_LOAD
      TrainingView.BOARD_REFRESH -> TRAINING_REFRESH
      TrainingView.BOARD_ROW_OPENED -> TR_ROW_OPENED
      TrAws.CLI_DONE -> TR_RAN
      TrAws.CLI_FAILED -> TR_CLI_FAILED
      TrSsh.CLI_DONE -> TR_RAN
      TrSsh.CLI_FAILED -> TR_CLI_FAILED
    }

    config {
      region : string = "us-east-1"
        @description "The AWS region the training instances run in."
        @tier "domain"
      instanceTypes : [string] = []
        @description "The instance-type filters a training instance matches, e.g. g5.*."
        @tier "domain"
      sshKey : string = ""
        @description "The ssh identity file (ssh expands a leading ~)."
        @tier "domain"
      sshUser : string = "ubuntu"
        @description "The user ssh logs in as."
        @tier "domain"
      processPattern : string = ""
        @description "The extended regular expression (grep -E) the training process's ps line matches."
        @tier "domain"
      logPaths : [string] = []
        @description "The training log files, in order; the first readable one is read."
        @tier "domain"
      logLines : number = 60
        @description "Lines read from the end of the log."
        @tier "domain"
      tailLines : number = 30
        @description "Lines of the log kept in the board."
        @tier "domain"
      cacheTtlMs : number = 30000
        @description "Milliseconds a read board is answered without reading again."
        @tier "infra"
    }
  }

  page "/training-board" as TrainingBoardPage -> TrainingStatus, TrainingView, TrAws, TrSsh
}
