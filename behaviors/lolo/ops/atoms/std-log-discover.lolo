app std-log-discover [
  version: "1.0.0",
  net: { "127.0.0.1:8088": [tcp], "127.0.0.1:4790": [tcp] },
  env: ["HOME"],
  fs: { env HOME: ".almadar/rows/**": [read, write, remove, create], env HOME: ".almadar/rows/": [create] },
  description: "std-log-discover — Discover over the logs of several boxes, each answering std-log-search's log-search hook: the local box (127.0.0.1:8088), this Mac's launchpad (127.0.0.1:4790) and, when its host is set, the remote box, each read by its own std-http-client whose credential knob puts the box's fleet key in the x-fleet-key header (the program never holds it). A search is a lolo predicate over @line (time, level, namespace, message, app, release, box, data), a time window (a preset of the last 15 minutes, hour, day or week, or the range a histogram bar narrows it to) and the levels to read. Run starts a job on every box, one after another (the boxes' clients share one call frame), then polls them, waiting pollMs between rounds on the composed std-delay, until each is done or failed; the board then shows each box's status, the total, a histogram whose bars sum every box's counts over the window (a click on a bar narrows the window to it and runs again), the top values of level, namespace, app, release and box with their counts (a click adds `(= @line.<field> \"<value>\")` to the query with and, and runs), and the newest hitsShown kept lines of all boxes, newest first, each opening to its whole JSON; Load older runs the same search for the window up to the oldest line shown and appends what it finds. Live tail runs the search again tailMs after each run ends, over the preset window ending now, until it is turned off. Saves keep a search (name, query, preset, levels) as a LogSavedSearch row in the LogSavedRows store, a std-row-store-file under $HOME/.almadar/rows/, so they survive a restart; a saved search opens and runs by name (LD_OPEN_SAVED, which a composer's route can send for a link) and can be deleted."
]
;; @capabilities "search logs like Kibana Discover, lolo query over log lines, histogram of hits, field filters, live tail, saved log searches"
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Delay from "std/behaviors/std-delay"
uses RowStore from "std/behaviors/std-row-store-file"

type HttpHeader = { name : string!, value : string! }
type LogValue = string | number | boolean | [LogValue?] | Map string LogValue?
type LogLine = { time : string!, level : string!, namespace : string!, message : string!, app : string!, release : string!, box : string!, data : Map string LogValue? }
type LogFieldCount = { field : string!, value : string!, count : number! }
type LogJobView = { id : string!, status : string!, error : string!, scanned : number!, total : number!, hits : [LogLine]!, histogram : [number]!, fields : [LogFieldCount]! }
type LogJobStarted = { job : string! }
type LdBox = { box : string!, label : string!, job : string!, status : string!, error : string!, scanned : number!, total : number!, hits : [LogLine]!, histogram : [number]!, fields : [LogFieldCount]! }
type LdBar = { label : string!, value : number! }
type LdFilter = { field : string!, value : string! }
type LdHitRow = { id : string!, index : number!, shown : string!, time : string!, level : string!, namespace : string!, message : string!, app : string!, release : string!, box : string! }
type LdDrill = { label : string, value : number }

orbital LogDiscoverOrbital {
  entity LogDiscoverRun [runtime] {
    id : string!
    query : string = "true"
    preset : "15m" | "1h" | "24h" | "7d" = "1h"
    levels : [string] = ["error", "warn", "info"]
    from : instant? = null
    to : instant? = null
    append : boolean @description "The run in flight adds older hits to the ones shown (Load older)." = false
    boxes : [LdBox] = []
    index : number @description "The box the start or poll in flight is for." = 0
    phase : "idle" | "starting" | "polling" | "done" = idle
    hits : [LogLine] = []
    histogram : [number] = []
    fields : [LogFieldCount] = []
    total : number = 0
    tail : boolean = false
    round : number @description "Poll rounds of the run in flight; each step carries it so a repeat of the last round is never taken for one (EXEC-QUEUE-4)." = 0
  }

  entity LogSavedSearch [persistent: log_saved_searches, store: LogSavedRows] {
    @create none "A substrate atom: the composing program decides who reaches the trait that writes these rows, so this atom states no creator of its own."
    @read none "This atom declares no identity entity, so it has no signed-in viewer to scope reads to; the composing program gates its pages (the launchpad requires sign-in)."
    id : string!
    name : string!
    query : string!
    preset : string!
    levels : [string]!
  }

  trait LdLocalHttpFrame = Frame.traits.HttpFrame {
    listens {
      LdLocalHttp.HC_FRAME -> FRAME_RUN
    }
  }
  trait LdLocalHttp = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: LD_LOCAL_REPLIED
      HTTP_FAILED: LD_LOCAL_FAILED
      HTTP_CANCEL: LD_LOCAL_CANCEL
    }
    config {
      host: "127.0.0.1"
      port: 8088
      tls: false
      serverName: ""
      credential: "ORB_FLEET_KEY_LOCAL"
      credentialHeader: "x-fleet-key"
      credentialPrefix: ""
    }
    listens {
      LogDiscover.LD_LOCAL_SEND -> HTTP_SEND
      LdLocalHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      LdLocalHttpFrame.FRAME_DRAINED -> HC_DRAINED
      LdLocalHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait LdMacHttpFrame = Frame.traits.HttpFrame {
    listens {
      LdMacHttp.HC_FRAME -> FRAME_RUN
    }
  }
  trait LdMacHttp = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: LD_MAC_REPLIED
      HTTP_FAILED: LD_MAC_FAILED
      HTTP_CANCEL: LD_MAC_CANCEL
    }
    config {
      host: "127.0.0.1"
      port: 4790
      tls: false
      serverName: ""
      credential: "ORB_FLEET_KEY_LOCAL"
      credentialHeader: "x-fleet-key"
      credentialPrefix: ""
    }
    listens {
      LogDiscover.LD_MAC_SEND -> HTTP_SEND
      LdMacHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      LdMacHttpFrame.FRAME_DRAINED -> HC_DRAINED
      LdMacHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait LdRemoteHttpFrame = Frame.traits.HttpFrame {
    listens {
      LdRemoteHttp.HC_FRAME -> FRAME_RUN
    }
  }
  trait LdRemoteHttp = Http.traits.HttpClient {
    events {
      HTTP_REPLIED: LD_REMOTE_REPLIED
      HTTP_FAILED: LD_REMOTE_FAILED
      HTTP_CANCEL: LD_REMOTE_CANCEL
    }
    config {
      host: ""
      port: 443
      tls: true
      serverName: ""
      credential: "ORB_FLEET_KEY_REMOTE"
      credentialHeader: "x-fleet-key"
      credentialPrefix: ""
    }
    listens {
      LogDiscover.LD_REMOTE_SEND -> HTTP_SEND
      LdRemoteHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      LdRemoteHttpFrame.FRAME_DRAINED -> HC_DRAINED
      LdRemoteHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait LdDelay = Delay.traits.Delay {
    listens {
      LogDiscover.LD_WAIT -> START with { delayMs: ?delayMs }
    }
  }

  trait LogDiscover -> LogDiscoverRun [server] {
    config {
      boxes : [string] = ["local", "mac"]
        @label "Boxes"
        @description "The boxes searched, in order: local (127.0.0.1:8088), mac (this launchpad, 127.0.0.1:4790) and remote (the LdRemoteHttp client's host)."
        @tier "domain"
      hitsShown : number = 500
        @label "Lines shown"
        @description "How many of the newest kept lines the table shows; Load older reaches the ones before them."
        @tier "policy"
      pollMs : number = 1500
        @label "Poll interval"
        @description "Milliseconds between polls of a running search. A box's /api is rate limited per client (std-rate-limiter, 60 requests a minute by default), so a search polls at most about 40 times a minute."
        @tier "infra"
      savedLimit : number = 200
        @label "Saved searches listed"
        @description "Most saved searches the board lists."
        @tier "policy"
      tailMs : number = 10000
        @label "Live tail interval"
        @description "Milliseconds between the end of a tailed search and the next run; with the start and its polls a tailed search makes about 16 requests a minute, inside a box's rate limit."
        @tier "policy"
    }
    initial: idle

    state idle {
      INIT -> idle
        (fetch LogSavedSearch { limit: @config.savedLimit, emit: { success: LD_SAVED_LOADED, failure: LD_SAVED_UNREAD } })

      LD_RUN -> idle
        (set @entity.query (if (= (str/trim ?query) "") "true" ?query))
        (set @entity.preset ?preset)
        (set @entity.levels ?levels)
        (set @entity.append ?append)
        (set @entity.to (if (= ?to null) @now ?to))
        (set @entity.from (if (= ?from null) (time/add @now (- 0 (if (= ?preset "15m") 900000 (if (= ?preset "24h") 86400000 (if (= ?preset "7d") 604800000 3600000)))) "ms") ?from))
        (set @entity.boxes (array/map @config.boxes (fn b (let ((box : LdBox { box: @b, label: @b, job: "", status: "starting", error: "", scanned: 0, total: 0, hits: [], histogram: [], fields: [] })) @box))))
        (set @entity.index 0)
        (set @entity.round (+ @entity.round 1))
        (set @entity.phase starting)
        (emit LD_SHOW_RUNNING { boxes: @entity.boxes, query: @entity.query, preset: @entity.preset, levels: @entity.levels })
        (emit LD_SEND { index: 0, op: "start", round: (+ @entity.round 1) })

      LD_SEND -> idle when (>= ?index (array/len @entity.boxes))
        (when (= ?op "start") (do (set @entity.phase polling) (emit LD_WAIT { delayMs: @config.pollMs })))
        (when (= ?op "poll") (emit LD_ROUND_DONE { round: ?round }))
      LD_SEND -> idle when (< ?index (array/len @entity.boxes))
        (set @entity.index ?index)
        (let ((b (default (array/nth @entity.boxes ?index) (let ((none : LdBox { box: "", label: "", job: "", status: "done", error: "", scanned: 0, total: 0, hits: [], histogram: [], fields: [] })) @none))))
          (if (and (= ?op "poll") (array/includes ["done", "failed"] @b.status))
            (emit LD_SEND { index: (+ ?index 1), op: ?op, round: ?round })
            (let ((body (bytes/from-string (if (= ?op "start")
                    (json/stringify { op: "start", query: @entity.query, from: @entity.from, to: @entity.to, levels: @entity.levels })
                    (json/stringify { op: "poll", job: @b.job }))))
                  (headers [{ name: "content-type", value: "application/json" }]))
              (if (= @b.box "remote")
                (emit LD_REMOTE_SEND { key: (str/concat "ld-" ?op), method: "POST", target: "/api/hooks/log-search", headers: @headers, body: @body, stream: "none" })
                (if (= @b.box "mac")
                  (emit LD_MAC_SEND { key: (str/concat "ld-" ?op), method: "POST", target: "/api/hooks/log-search", headers: @headers, body: @body, stream: "none" })
                  (emit LD_LOCAL_SEND { key: (str/concat "ld-" ?op), method: "POST", target: "/api/hooks/log-search", headers: @headers, body: @body, stream: "none" }))))))

      LD_REPLIED -> idle
        (let ((started (if (= ?status 202) (json/parse ?body LogJobStarted) null))
              (job (if (= ?status 200) (json/parse ?body LogJobView) null)))
          (do
            (set @entity.boxes (array/map (array/zip @entity.boxes (array/range 0 (array/len @entity.boxes))) (fn p
              (let ((b (array/nth @p 0)) (i (array/nth @p 1)))
                (if (!= @i @entity.index) @b
                  (if (!= @started null) (object/merge @b { job: @started.job, status: "queued" })
                    (if (!= @job null) (object/merge @b { status: @job.status, error: @job.error, scanned: @job.scanned, total: @job.total, hits: @job.hits, histogram: @job.histogram, fields: @job.fields })
                      (object/merge @b { status: "failed", error: (if (= ?status 401) "the fleet key was refused" (str/concat "answered " ?status ": " ?body)) }))))))))
            (emit LD_SEND { index: (+ @entity.index 1), op: (if (= @entity.phase "starting") "start" "poll"), round: @entity.round })))
      LD_UNREACHED -> idle
        (set @entity.boxes (array/map (array/zip @entity.boxes (array/range 0 (array/len @entity.boxes))) (fn p
          (if (= (array/nth @p 1) @entity.index) (object/merge (array/nth @p 0) { status: "failed", error: (str/concat "unreachable: " ?error) }) (array/nth @p 0)))))
        (emit LD_SEND { index: (+ @entity.index 1), op: (if (= @entity.phase "starting") "start" "poll"), round: @entity.round })

      LD_POLL_ROUND -> idle when (= @entity.phase "polling")
        (set @entity.round (+ @entity.round 1))
        (emit LD_SEND { index: 0, op: "poll", round: (+ @entity.round 1) })
      LD_ROUND_DONE -> idle
        (let ((running (array/some @entity.boxes (fn b (not (array/includes ["done", "failed"] @b.status)))))
              (merged (array/take (array/sort (array/concat (if @entity.append @entity.hits []) (array/flatten (array/map @entity.boxes (fn b @b.hits)))) "time" "desc") @config.hitsShown)))
          (do
            (when (not @running) (set @entity.phase done))
            (set @entity.hits (if @entity.append (array/take (array/concat @entity.hits (array/filter @merged (fn h (not (array/some @entity.hits (fn s (and (= @s.time @h.time) (= @s.message @h.message) (= @s.box @h.box)))))))) (+ (array/len @entity.hits) @config.hitsShown)) @merged))
            (set @entity.total (array/sum (array/map @entity.boxes (fn b @b.total))))
            (set @entity.histogram (array/reduce @entity.boxes [] (fn acc b (if (= (array/len @acc) 0) @b.histogram (array/map (array/range 0 (array/len @acc)) (fn i (+ (default (array/nth @acc @i) 0) (default (array/nth @b.histogram @i) 0))))))))
            (set @entity.fields (array/reduce (array/flatten (array/map @entity.boxes (fn b (array/concat @b.fields [(let ((own : LogFieldCount { field: "box", value: @b.box, count: @b.total })) @own)])))) (let ((none : [LogFieldCount] [])) @none) (fn acc c
              (if (array/some @acc (fn x (and (= @x.field @c.field) (= @x.value @c.value))))
                (array/map @acc (fn x (if (and (= @x.field @c.field) (= @x.value @c.value)) (object/merge @x { count: (+ @x.count @c.count) }) @x)))
                (array/append @acc @c)))))
            (emit LD_SHOW_DONE { running: @running, boxes: @entity.boxes, hits: @entity.hits, histogram: @entity.histogram, fields: @entity.fields, total: @entity.total, from: (default @entity.from @now), to: (default @entity.to @now) })
            (if @running (emit LD_WAIT { delayMs: @config.pollMs }) (when @entity.tail (emit LD_WAIT { delayMs: @config.tailMs })))))

      LD_ELAPSED -> idle when (= @entity.phase "polling")
        (emit LD_POLL_ROUND {})
      LD_ELAPSED -> idle when (and (= @entity.phase "done") @entity.tail)
        (emit LD_RUN_AGAIN {})
      LD_ELAPSED -> idle when (not (or (= @entity.phase "polling") (and (= @entity.phase "done") @entity.tail)))
      LD_RUN_AGAIN -> idle
        (emit LD_RUN_SELF { query: @entity.query, preset: @entity.preset, levels: @entity.levels, from: null, to: null, append: false })
      LD_TAIL -> idle
        (set @entity.tail ?on)
        (when (and ?on (= @entity.phase "done")) (emit LD_RUN_AGAIN {}))

      LD_SAVE -> idle
        (persist upsert LogSavedSearch { id: ?name, name: ?name, query: @entity.query, preset: @entity.preset, levels: @entity.levels } { emit: { success: LD_SAVED, failure: LD_SAVE_FAILED } })
      LD_LIST_SAVED -> idle
        (fetch LogSavedSearch { limit: @config.savedLimit, emit: { success: LD_SAVED_LOADED, failure: LD_SAVED_UNREAD } })
      LD_SAVED -> idle
        (fetch LogSavedSearch { limit: @config.savedLimit, emit: { success: LD_SAVED_LOADED, failure: LD_SAVED_UNREAD } })
      LD_SAVE_FAILED -> idle
        (notify error (str/concat "The search could not be saved: " (default ?error "")))
      LD_DELETE_SAVED -> idle
        (persist delete LogSavedSearch ?name { emit: { success: LD_SAVED, failure: LD_SAVE_FAILED } })
      LD_SAVED_LOADED -> idle
        (emit LD_SHOW_SAVED { saved: ?data })
      LD_SAVED_UNREAD -> idle
        (emit LD_SHOW_SAVED { saved: [] })
      LD_OPEN_SAVED -> idle
        (fetch LogSavedSearch { id: ?name, emit: { success: LD_SAVED_ONE, failure: LD_SAVED_MISSING } })
      LD_SAVED_ONE -> idle
        (emit LD_RUN_SELF { query: ?data.query, preset: (if (array/includes ["15m", "1h", "24h", "7d"] ?data.preset) ?data.preset "1h"), levels: ?data.levels, from: null, to: null, append: false })
      LD_SAVED_MISSING -> idle
        (notify error "No saved search by that name")
    }

    emits {
      LD_LOCAL_SEND -> internal { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
      LD_MAC_SEND -> internal { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
      LD_REMOTE_SEND -> internal { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
      LD_SEND -> internal { index : number!  op : string!  round : number! }
        @description "Start or poll the job of the box at index."
      LD_ROUND_DONE -> internal { round : number! }
      LD_POLL_ROUND -> internal { }
      LD_RUN_AGAIN -> internal { }
      LD_RUN_SELF -> internal { query : string!  preset : "15m" | "1h" | "24h" | "7d"!  levels : [string]!  from : instant?  to : instant?  append : boolean! }
      LD_WAIT -> internal { delayMs : number! }
      LD_SHOW_RUNNING -> internal { boxes : [LdBox]!  query : string!  preset : "15m" | "1h" | "24h" | "7d"!  levels : [string]! }
      LD_SHOW_DONE -> internal { running : boolean!  boxes : [LdBox]!  hits : [LogLine]!  histogram : [number]!  fields : [LogFieldCount]!  total : number!  from : instant!  to : instant! }
      LD_SHOW_SAVED -> internal { saved : [LogSavedSearch]! }
    }

    listens {
      LD_RUN -> input { query : string!  preset : "15m" | "1h" | "24h" | "7d"!  levels : [string]!  from : instant?  to : instant?  append : boolean! }
        @description "Run a search: a lolo predicate over @line, the preset window ending now (or from..to), the levels read."
        @synonyms "search logs, run log query, discover"
      LD_TAIL -> input { on : boolean! }
        @description "Turn live tail on or off."
      LD_SAVE -> input { name : string! }
        @description "Save the current search under a name."
      LD_OPEN_SAVED -> input { name : string! }
        @description "Open and run a saved search by name."
      LD_DELETE_SAVED -> input { name : string! }
        @description "Delete a saved search."
      LD_LIST_SAVED -> input { }
        @description "List the saved searches."
      LogDiscover.LD_RUN_SELF -> LD_RUN
      LogDiscoverView.LD_RUN -> LD_RUN
      LogDiscoverView.LD_TAIL -> LD_TAIL
      LogDiscoverView.LD_SAVE -> LD_SAVE
      LogDiscoverView.LD_OPEN_SAVED -> LD_OPEN_SAVED
      LogDiscoverView.LD_DELETE_SAVED -> LD_DELETE_SAVED
      LogDiscoverView.LD_LIST_SAVED -> LD_LIST_SAVED
      LogDiscoverLink.LD_LINK_OPENED -> LD_OPEN_SAVED with { name: ?name }
      LdDelay.ELAPSED -> LD_ELAPSED
      LD_ELAPSED { waitedMs : number }
        @tier "internal"
      LD_REPLIED { status : number!  body : string! }
        @tier "internal"
      LD_UNREACHED { error : string! }
        @tier "internal"
      LD_SAVED { id : string }
        @tier "internal"
      LD_SAVE_FAILED { error : string }
        @tier "internal"
      LD_SAVED_LOADED { data : [LogSavedSearch]! }
        @tier "internal"
      LD_SAVED_UNREAD { error : string }
        @tier "internal"
      LD_SAVED_ONE { data : LogSavedSearch! }
        @tier "internal"
      LD_SAVED_MISSING { error : string }
        @tier "internal"
      LdLocalHttp.LD_LOCAL_REPLIED -> LD_REPLIED with { status: ?status, body: (default (bytes/to-string ?body) "") }
      LdLocalHttp.LD_LOCAL_FAILED -> LD_UNREACHED with { error: ?error }
      LdMacHttp.LD_MAC_REPLIED -> LD_REPLIED with { status: ?status, body: (default (bytes/to-string ?body) "") }
      LdMacHttp.LD_MAC_FAILED -> LD_UNREACHED with { error: ?error }
      LdRemoteHttp.LD_REMOTE_REPLIED -> LD_REPLIED with { status: ?status, body: (default (bytes/to-string ?body) "") }
      LdRemoteHttp.LD_REMOTE_FAILED -> LD_UNREACHED with { error: ?error }
    }
  }

  entity LogDiscoverScreen [runtime] {
    id : string!
    query : string = "true"
    filters : [LdFilter] = []
    preset : "15m" | "1h" | "24h" | "7d" = "1h"
    levels : [string] = ["error", "warn", "info"]
    saveOpen : boolean = false
    saveName : string = ""
    ran : boolean = false
    running : boolean = false
    boxes : [LdBox] = []
    rows : [LdHitRow] = []
    hits : [LogLine] = []
    histogram : [number] = []
    fields : [LogFieldCount] = []
    total : number = 0
    from : instant? = null
    to : instant? = null
    tail : boolean = false
    saved : [LogSavedSearch] = []
    selected : LdHitRow? = null
  }

  trait LogDiscoverView -> LogDiscoverScreen [client] {
    config {
      title : string = "Logs"
      levelChoices : [string] = ["error", "warn", "info", "debug"]
      fieldsShown : [string] = ["level", "box", "app", "namespace", "release"]
      valuesShown : number = 5
      bars : number = 12
        @label "Bars over time"
        @description "How many bars the histogram draws; each sums its share of the boxes' buckets."
        @tier "presentation"
      bodyContent : node = {
        type: stack
        direction: vertical
        gap: lg
        children: [
          { type: page-header, title: @config.title, icon: "scroll-text",
            subtitle: (if @entity.running "Searching…" (if @entity.ran (str/concat @entity.total " matching lines · " (if (= @entity.preset "15m") "last 15 minutes" (if (= @entity.preset "24h") "last 24 hours" (if (= @entity.preset "7d") "last 7 days" "last hour")))) "Search every box's logs with a lolo predicate")),
            actions: [{ label: "Run", event: RUN_CLICKED, icon: "play", variant: primary, loading: @entity.running }, { label: (if @entity.saveOpen "Cancel" "Save search"), event: SAVE_TOGGLED, icon: "bookmark", variant: secondary }] },
          { type: card, children: [{ type: stack, direction: vertical, gap: md, children: [
            { type: textarea, label: "Query", rows: 2, className: "font-mono", value: @entity.query, onChange: QUERY_CHANGED, action: RUN_CLICKED, helperText: "A lolo predicate over @line (time, level, namespace, message, app, release, box, data). ⌘↵ runs it." },
            { type: stack, direction: horizontal, gap: md, align: center, justify: between, wrap: true, children: [
              { type: stack, direction: horizontal, gap: sm, align: center, wrap: true, children: [
                { type: date-range-selector, selected: @entity.preset, onSelect: PRESET_PICKED, options: [{ value: "15m", label: "15 min" }, { value: "1h", label: "1 hour" }, { value: "24h", label: "24 hours" }, { value: "7d", label: "7 days" }] },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.levelChoices (fn l { type: filter-pill, label: @l, size: sm, selected: (array/includes @entity.levels @l), variant: (if (array/includes @entity.levels @l) primary default), clickEvent: LEVEL_TOGGLED })) }] },
              { type: switch, label: "Live tail", checked: @entity.tail, action: TAIL_TOGGLED }] },
            (if (= (array/len @entity.filters) 0) null { type: stack, direction: horizontal, gap: xs, align: center, wrap: true, children: [
              { type: stack, direction: horizontal, gap: xs, wrap: true, children: (array/map (array/range 0 (array/len @entity.filters)) (fn i (let ((f (default (array/nth @entity.filters @i) { field: "", value: "" })))
                { type: button, label: (str/concat @f.field ": " @f.value), icon: "x", size: sm, variant: secondary, aria-label: (str/concat "Remove filter " @f.field ": " @f.value), action: FILTER_REMOVED, actionPayload: { index: @i } }))) },
              { type: button, label: "Clear filters", variant: ghost, size: sm, action: FILTERS_CLEARED }] }),
            (if @entity.saveOpen { type: stack, direction: horizontal, gap: sm, align: end, children: [
              { type: input, label: "Name this search", placeholder: "e.g. friday-errors", value: @entity.saveName, onChange: SAVE_NAME_CHANGED, className: "w-64" },
              { type: button, label: "Save", icon: "check", variant: secondary, action: SAVE_CLICKED }] } null),
            (if (= (array/len @entity.saved) 0) null { type: stack, direction: horizontal, gap: xs, align: center, wrap: true, children: (array/concat
              [{ type: typography, variant: caption, color: muted, content: "Saved" }]
              (array/map @entity.saved (fn s { type: stack, direction: horizontal, gap: none, align: center, children: [
                { type: filter-pill, label: @s.name, icon: "bookmark", size: sm, clickEvent: SAVED_OPENED },
                { type: button, label: "", icon: "trash-2", size: sm, variant: ghost, aria-label: (str/concat "Delete saved search " @s.name), action: SAVED_DELETED, actionPayload: { name: @s.name } }] }))) })
          ] }] },
          (if (= (array/len @entity.boxes) 0) null { type: stack, direction: horizontal, gap: lg, wrap: true, children: (array/map @entity.boxes (fn b
            { type: stack, direction: horizontal, gap: xs, align: center, children: [
              { type: status-dot, status: (if (= @b.status "failed") critical (if (= @b.status "done") online away)), pulse: (not (array/includes ["done", "failed"] @b.status)), label: @b.label },
              { type: typography, variant: caption, content: (str/concat @b.label " · " (if (= @b.status "done") (str/concat @b.total " matching · " @b.scanned " read") (if (= @b.status "failed") @b.error (if (> @b.scanned 0) (str/concat "searching · " @b.scanned " lines read") "searching")))) }] })) }),
          (if (not @entity.ran)
            { type: empty-state, icon: "search", title: "Search every box's logs", description: "Write a lolo predicate over @line, or leave it as true, pick a window and press Run. Click any value in the results to filter by it." }
            (if (and @entity.running (= (array/len @entity.rows) 0))
              { type: skeleton, variant: table, rows: 8, columns: 5 }
              (if (= @entity.total 0)
                { type: empty-state, icon: "search-x", title: "No lines match", description: "Widen the time window, turn on more levels or remove a filter.", actionLabel: (if (> (array/len @entity.filters) 0) "Clear filters" ""), actionEvent: FILTERS_CLEARED }
                { type: stack, direction: vertical, gap: lg, children: [
                  { type: card, children: [{ type: stack, direction: vertical, gap: sm, children: [
                    { type: stack, direction: horizontal, justify: between, align: center, children: [
                      { type: typography, variant: h4, content: (str/concat @entity.total " lines over time") },
                      { type: typography, variant: caption, color: muted, content: "Click a bar to zoom into it" }] },
                    { type: chart, chartType: histogram, height: 120, timeAxis: false, drillEvent: BAR_PICKED,
                      data: (array/map (array/range 0 @config.bars) (fn i
                        { label: (time/format (time/add (default @entity.from @now) (default (/ (* @i (time/diff (default @entity.to @now) (default @entity.from @now) "ms")) @config.bars) 0) "ms") (if (> (time/diff (default @entity.to @now) (default @entity.from @now) "ms") 86400000) "MM-DD HH:mm" "HH:mm")), value: (array/sum (array/slice @entity.histogram (* @i (math/ceil (/ (array/len @entity.histogram) @config.bars))) (* (+ @i 1) (math/ceil (/ (array/len @entity.histogram) @config.bars))))) })) }] }] },
                  { type: stack, direction: horizontal, gap: lg, align: start, children: [
                    (if (!= @entity.selected null) null
                    { type: card, className: "w-64 shrink-0", children: [{ type: stack, direction: vertical, gap: md, children: (array/map @config.fieldsShown (fn f
                      { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, color: muted, content: @f },
                        { type: stack, direction: vertical, gap: none, children: (array/map (array/take (array/sort (array/filter @entity.fields (fn c (and (= @c.field @f) (!= @c.value "") (> @c.count 0)))) "count" "desc") @config.valuesShown) (fn c
                          { type: stack, direction: horizontal, gap: sm, align: center, justify: between, children: [
                            { type: button, variant: ghost, size: sm, className: "min-w-0 flex-1 justify-start truncate font-normal", label: @c.value, aria-label: (str/concat "Filter " @f " " @c.value), action: FIELD_PICKED, actionPayload: { field: @f, value: @c.value } },
                            { type: typography, variant: caption, color: muted, className: "tabular-nums", content: (str/concat @c.count) }] })) }] })) }] }),
                    { type: stack, direction: vertical, gap: sm, className: "min-w-0 flex-1", children: [
                      { type: table-view, entity: @entity.rows, look: dense, itemClickEvent: HIT_PICKED,
                        columns: [{ key: "shown", field: "shown", label: "Time", width: "11rem", className: "font-mono tabular-nums" }, { key: "level", field: "level", label: "Level", width: "6rem", format: badge, colorMap: { error: danger, warn: warning, info: info, debug: neutral } }, { key: "box", field: "box", label: "Box", width: "6rem" }, { key: "app", field: "app", label: "App", width: "10rem" }, { key: "message", field: "message", label: "Message", wrap: true }],
                        emptyTitle: "No lines", emptyDescription: "" },
                      { type: stack, direction: horizontal, justify: center, children: [{ type: button, label: "Load older lines", icon: "chevrons-down", variant: secondary, size: sm, action: OLDER_CLICKED }] }] },
                    (if (= @entity.selected null) null
                      { type: card, className: "w-2/5 min-w-0 shrink-0 overflow-hidden sticky top-0 self-start", children: [{ type: stack, direction: vertical, gap: sm, children: [
                        { type: stack, direction: horizontal, justify: between, align: center, children: [
                          { type: typography, variant: h4, content: "Line" },
                          { type: button, label: "", icon: "x", variant: ghost, size: sm, aria-label: "Close the line", action: HIT_CLOSED }] },
                        { type: typography, variant: caption, color: muted, className: "font-mono", content: (default (object/get (default @entity.selected {}) "time") "") },
                        { type: code-block, language: "json", code: (json/stringify (array/nth @entity.hits (default (object/get (default @entity.selected {}) "index") 0)) { pretty: true }), maxHeight: "60vh" }] }] })] }] })))
        ]
      }
        @label "Body content tree"
        @tier "internal"
    }
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main @config.bodyContent)
        (emit LD_LIST_SAVED {})
      QUERY_CHANGED -> idle
        (set @entity.query ?value)
      SAVE_NAME_CHANGED -> idle
        (set @entity.saveName ?value)
      SAVE_TOGGLED -> idle
        (set @entity.saveOpen (not @entity.saveOpen))
        (render-ui main @config.bodyContent)
      PRESET_PICKED -> idle
        (set @entity.preset (if (array/includes ["15m", "1h", "24h", "7d"] ?value) ?value "1h"))
        (emit LD_RUN { query: (if (= (array/len @entity.filters) 0) @entity.query (str/concat "(and " @entity.query " " (str/join (array/map @entity.filters (fn f (str/concat "(= @line." @f.field " " (json/stringify @f.value) ")"))) " ") ")")), preset: (if (array/includes ["15m", "1h", "24h", "7d"] ?value) ?value "1h"), levels: @entity.levels, from: null, to: null, append: false })
      LEVEL_TOGGLED -> idle
        (set @entity.levels (if (array/includes @entity.levels ?label) (array/filter @entity.levels (fn l (!= @l ?label))) (array/append @entity.levels ?label)))
        (render-ui main @config.bodyContent)
      RUN_CLICKED -> idle
        (emit LD_RUN { query: (if (= (array/len @entity.filters) 0) @entity.query (str/concat "(and " @entity.query " " (str/join (array/map @entity.filters (fn f (str/concat "(= @line." @f.field " " (json/stringify @f.value) ")"))) " ") ")")), preset: @entity.preset, levels: @entity.levels, from: null, to: null, append: false })
      FIELD_PICKED -> idle
        (let ((filters (array/append (array/filter @entity.filters (fn f (not (and (= @f.field ?field) (= @f.value ?value))))) { field: ?field, value: ?value })))
          (do
            (set @entity.filters @filters)
            (emit LD_RUN { query: (str/concat "(and " @entity.query " " (str/join (array/map @filters (fn f (str/concat "(= @line." @f.field " " (json/stringify @f.value) ")"))) " ") ")"), preset: @entity.preset, levels: @entity.levels, from: @entity.from, to: @entity.to, append: false })))
      FILTER_REMOVED -> idle
        (let ((filters (array/filter (array/map (array/range 0 (array/len @entity.filters)) (fn i { i: @i, f: (default (array/nth @entity.filters @i) { field: "", value: "" }) })) (fn x (!= @x.i ?index)))))
          (let ((kept (array/map @filters (fn x @x.f))))
            (do
              (set @entity.filters @kept)
              (emit LD_RUN { query: (if (= (array/len @kept) 0) @entity.query (str/concat "(and " @entity.query " " (str/join (array/map @kept (fn f (str/concat "(= @line." @f.field " " (json/stringify @f.value) ")"))) " ") ")")), preset: @entity.preset, levels: @entity.levels, from: @entity.from, to: @entity.to, append: false }))))
      FILTERS_CLEARED -> idle
        (set @entity.filters [])
        (emit LD_RUN { query: @entity.query, preset: @entity.preset, levels: @entity.levels, from: null, to: null, append: false })
      BAR_PICKED -> idle
        (let ((width (/ (time/diff (default @entity.to @now) (default @entity.from @now) "ms") @config.bars)))
          (let ((i (array/findIndex (array/range 0 @config.bars) (fn k (= (time/format (time/add (default @entity.from @now) (* @k @width) "ms") (if (> (time/diff (default @entity.to @now) (default @entity.from @now) "ms") 86400000) "MM-DD HH:mm" "HH:mm")) (default ?label ""))))))
            (when (>= (default @i -1) 0)
              (emit LD_RUN { query: (if (= (array/len @entity.filters) 0) @entity.query (str/concat "(and " @entity.query " " (str/join (array/map @entity.filters (fn f (str/concat "(= @line." @f.field " " (json/stringify @f.value) ")"))) " ") ")")), preset: @entity.preset, levels: @entity.levels, from: (time/add (default @entity.from @now) (* (default @i 0) @width) "ms"), to: (time/add (default @entity.from @now) (* (+ (default @i 0) 1) @width) "ms"), append: false }))))
      OLDER_CLICKED -> idle
        (emit LD_RUN { query: (if (= (array/len @entity.filters) 0) @entity.query (str/concat "(and " @entity.query " " (str/join (array/map @entity.filters (fn f (str/concat "(= @line." @f.field " " (json/stringify @f.value) ")"))) " ") ")")), preset: @entity.preset, levels: @entity.levels, from: @entity.from, to: (default (as (default (time/parse (default (object/get (default (array/last @entity.rows) {}) "time") "")) @now) instant) @now), append: true })
      TAIL_TOGGLED -> idle
        (let ((on (not @entity.tail)))
          (do
            (set @entity.tail @on)
            (emit LD_TAIL { on: @on })))
        (render-ui main @config.bodyContent)
      SAVE_CLICKED -> idle when (!= (str/trim @entity.saveName) "")
        (set @entity.saveOpen false)
        (emit LD_SAVE { name: (str/trim @entity.saveName) })
        (render-ui main @config.bodyContent)
      SAVED_OPENED -> idle
        (set @entity.filters [])
        (emit LD_OPEN_SAVED { name: ?label })
      SAVED_DELETED -> idle
        (emit LD_DELETE_SAVED { name: ?name })
      HIT_PICKED -> idle
        (set @entity.selected ?row)
        (render-ui main @config.bodyContent)
      HIT_CLOSED -> idle
        (set @entity.selected null)
        (render-ui main @config.bodyContent)
      SHOW_RUNNING -> idle
        (set @entity.ran true)
        (set @entity.running true)
        (set @entity.boxes ?boxes)
        (set @entity.preset ?preset)
        (set @entity.levels ?levels)
        (render-ui main @config.bodyContent)
      SHOW_DONE -> idle
        (set @entity.running ?running)
        (set @entity.boxes ?boxes)
        (set @entity.rows (array/map (array/range 0 (array/len ?hits)) (fn i (let ((h (default (array/nth ?hits @i) { time: "", level: "", namespace: "", message: "", app: "", release: "", box: "", data: {} })))
          (let ((row { id: (str/concat "hit-" @i), index: @i, shown: (time/format (default (time/parse @h.time) @now) (if (> (time/diff ?to ?from "ms") 86400000) "MM-DD HH:mm:ss" "HH:mm:ss")), time: @h.time, level: @h.level, namespace: @h.namespace, message: @h.message, app: @h.app, release: @h.release, box: @h.box })) @row)))))
        (set @entity.hits ?hits)
        (set @entity.histogram ?histogram)
        (set @entity.fields ?fields)
        (set @entity.total ?total)
        (set @entity.from ?from)
        (set @entity.to ?to)
        (set @entity.selected null)
        (render-ui main @config.bodyContent)
      SHOW_SAVED -> idle
        (set @entity.saved ?saved)
        (render-ui main @config.bodyContent)
      SHOW_OPENED -> idle
        (set @entity.query ?query)
        (render-ui main @config.bodyContent)
    }

    emits {
      LD_RUN -> external { query : string!  preset : "15m" | "1h" | "24h" | "7d"!  levels : [string]!  from : instant?  to : instant?  append : boolean! }
      LD_TAIL -> external { on : boolean! }
      LD_SAVE -> external { name : string! }
      LD_OPEN_SAVED -> external { name : string! }
      LD_DELETE_SAVED -> external { name : string! }
      LD_LIST_SAVED -> external { }
      QUERY_CHANGED -> internal { value : string! }
      SAVE_NAME_CHANGED -> internal { value : string! }
      SAVE_TOGGLED -> internal { }
      LEVEL_TOGGLED -> internal { label : string! }
      RUN_CLICKED -> internal { }
      FIELD_PICKED -> internal { field : string!  value : string! }
      FILTER_REMOVED -> internal { index : number! }
      FILTERS_CLEARED -> internal { }
      OLDER_CLICKED -> internal { }
      TAIL_TOGGLED -> internal { }
      SAVE_CLICKED -> internal { }
      SAVED_DELETED -> internal { name : string! }
      HIT_CLOSED -> internal { }
    }

    listens {
      LogDiscover.LD_SHOW_RUNNING -> SHOW_RUNNING
      LogDiscover.LD_SHOW_DONE -> SHOW_DONE
      LogDiscover.LD_SHOW_SAVED -> SHOW_SAVED
      SHOW_RUNNING { boxes : [LdBox]!  query : string!  preset : "15m" | "1h" | "24h" | "7d"!  levels : [string]! }
        @tier "internal"
      SHOW_DONE { running : boolean!  boxes : [LdBox]!  hits : [LogLine]!  histogram : [number]!  fields : [LogFieldCount]!  total : number!  from : instant!  to : instant! }
        @tier "internal"
      SHOW_SAVED { saved : [LogSavedSearch]! }
        @tier "internal"
      SHOW_OPENED { query : string! }
        @tier "internal"
      BAR_PICKED { label : string  value : number }
        @description "A histogram bar was clicked: zoom into its slice of time."
      PRESET_PICKED { value : string! }
        @description "A time window was picked."
      SAVED_OPENED { label : string! }
        @description "A saved search pill was clicked."
      HIT_PICKED { id : string!  row : LdHitRow! }
        @description "A line was clicked: show it whole beside the table."
    }
  }

  trait LogDiscoverLink -> LogDiscoverScreen [client] {
    initial: ready

    state ready {
      INIT -> ready
        (emit LD_LINK_OPENED { name: ?search })
    }

    emits {
      LD_LINK_OPENED -> external { name : string! }
        @description "A link to a saved search was opened: it runs."
    }

    listens {
      INIT { search : string! }
    }
  }

  page "/log-discover" as LogDiscoverPage -> LogDiscoverView, LogDiscover, LdLocalHttp, LdLocalHttpFrame, LdMacHttp, LdMacHttpFrame, LdRemoteHttp, LdRemoteHttpFrame, LdDelay
  page "/log-discover/:search" as LogDiscoverLinkPage -> LogDiscoverLink, LogDiscoverView, LogDiscover, LdLocalHttp, LdLocalHttpFrame, LdMacHttp, LdMacHttpFrame, LdRemoteHttp, LdRemoteHttpFrame, LdDelay
}

orbital LogSavedRows = RowStore.orbitals.RowStoreFileOrbital {
  traits {
    RowStoreDriver {
      config {
        anchor: { env: "HOME" }
        dir: ".almadar/rows/"
      }
    }
  }
}
