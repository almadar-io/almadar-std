app std-system-stats [
  version: "1.0.0",
  sys: [memory, cpu, processes],
  description: "std-system-stats — the load of the machine the program runs on, sampled on an interval. STATS_START begins sampling and STATS_STOP ends it; a sample is taken as soon as the interval knob's time (intervalMs, kept to the second by the one-second tick that checks it) has passed since the last one ended, so two samples never overlap. A sample reads os/memory-info (total, available, used and used percent), os/cpu-usage (the percent between this ask and the previous one: the host samples across two asks, so the first sample of a run has nothing to compare with), os/load-avg (one, five and fifteen minutes) and os/uptime, one after the other, then the resident memory of the processes STATS_WATCH { pids } names, read by the composed std-process-sample (os/process-list; resident memory in bytes; a pid the host lists no process for is answered in missing and one it will not measure in unmeasured, never as zero memory; an empty pid list reads nothing). Each sample ends with STATS_READ { memoryTotal, memoryUsed, memoryAvailable, memoryPercent, cpuPercent, load1, load5, load15, uptimeSeconds, processes, missing, unmeasured, unavailable, at }; a stat the host cannot answer (the grant is denied, the platform does not support it) is named in STATS_FAILED { stat, code, error } with the host's failure kind as code, listed in unavailable, and left at zero, and the rest of the sample is still taken. STATS_WATCH while sampling takes a sample at once so a new process shows its memory without waiting for the interval. Memory is in bytes. Subject-agnostic: it knows nothing of what the pids are.",
  egress: []
]
;; @capabilities "read the memory, cpu, load average and uptime of this machine on an interval, read the resident memory of given processes"
uses Spec from "almadar-std/system-stats"
uses Sample from "std/behaviors/std-process-sample"

type StatsProcess = { pid : number!, rssBytes : number! }
type StatsMeasured = { pid : number!, rssBytes : number!, cpuSeconds : number!, startedAt : number! }

orbital SystemStatsOrbital {
  entity SystemStatsRun [runtime] {
    id : string!
    active : boolean = false
    sampling : boolean = false
    dueAt : instant? = null
    pids : [number] = []
    memoryTotal : number = 0
    memoryUsed : number = 0
    memoryAvailable : number = 0
    memoryPercent : number = 0
    cpuPercent : number = 0
    load1 : number = 0
    load5 : number = 0
    load15 : number = 0
    uptimeSeconds : number = 0
    processes : [StatsProcess] = []
    missing : [number] = []
    unmeasured : [number] = []
    unavailable : [string] = []
  }

  trait SystemStatsMeter -> SystemStatsRun {
    config {
      intervalMs : number = 3000
        @label "Sample interval"
        @description "Milliseconds between the end of one sample and the start of the next; it is checked once a second, so it is kept to the second."
        @tier "policy"
    }
    initial: ready

    state ready {
      INIT -> ready
      STATS_START -> ready
        (set @entity.active true)
        (set @entity.dueAt null)
      STATS_STOP -> ready
        (set @entity.active false)
      STATS_WATCH -> ready when (and @entity.active (not @entity.sampling))
        (set @entity.pids ?pids)
        (emit STATS_SAMPLE {})
      STATS_WATCH -> ready when (not (and @entity.active (not @entity.sampling)))
        (set @entity.pids ?pids)
      STATS_SAMPLE -> ready when (not @entity.sampling)
        (set @entity.sampling true)
        (set @entity.unavailable [])
        (os/memory-info { emit: { success: STATS_MEMORY, failure: STATS_MEMORY_FAILED } })
      STATS_MEMORY -> ready
        (set @entity.memoryTotal ?total)
        (set @entity.memoryUsed ?used)
        (set @entity.memoryAvailable ?available)
        (set @entity.memoryPercent ?usedPercent)
        (os/cpu-usage { emit: { success: STATS_CPU, failure: STATS_CPU_FAILED } })
      STATS_MEMORY_FAILED -> ready
        (set @entity.memoryTotal 0)
        (set @entity.memoryUsed 0)
        (set @entity.memoryAvailable 0)
        (set @entity.memoryPercent 0)
        (set @entity.unavailable (array/append @entity.unavailable "memory"))
        (emit STATS_FAILED { stat: "memory", code: (default ?kind "unknown"), error: ?error })
        (os/cpu-usage { emit: { success: STATS_CPU, failure: STATS_CPU_FAILED } })
      STATS_CPU -> ready
        (set @entity.cpuPercent ?percent)
        (os/load-avg { emit: { success: STATS_LOAD, failure: STATS_LOAD_FAILED } })
      STATS_CPU_FAILED -> ready
        (set @entity.cpuPercent 0)
        (set @entity.unavailable (array/append @entity.unavailable "cpu"))
        (emit STATS_FAILED { stat: "cpu", code: (default ?kind "unknown"), error: ?error })
        (os/load-avg { emit: { success: STATS_LOAD, failure: STATS_LOAD_FAILED } })
      STATS_LOAD -> ready
        (set @entity.load1 ?one)
        (set @entity.load5 ?five)
        (set @entity.load15 ?fifteen)
        (os/uptime { emit: { success: STATS_UPTIME, failure: STATS_UPTIME_FAILED } })
      STATS_LOAD_FAILED -> ready
        (set @entity.load1 0)
        (set @entity.load5 0)
        (set @entity.load15 0)
        (set @entity.unavailable (array/append @entity.unavailable "load"))
        (emit STATS_FAILED { stat: "load", code: (default ?kind "unknown"), error: ?error })
        (os/uptime { emit: { success: STATS_UPTIME, failure: STATS_UPTIME_FAILED } })
      STATS_UPTIME -> ready
        (set @entity.uptimeSeconds ?seconds)
        (emit STATS_PROCESSES {})
      STATS_UPTIME_FAILED -> ready
        (set @entity.uptimeSeconds 0)
        (set @entity.unavailable (array/append @entity.unavailable "uptime"))
        (emit STATS_FAILED { stat: "uptime", code: (default ?kind "unknown"), error: ?error })
        (emit STATS_PROCESSES {})
      STATS_PROCESSES -> ready when (= (array/len @entity.pids) 0)
        (set @entity.processes [])
        (set @entity.missing [])
        (set @entity.unmeasured [])
        (emit STATS_FINISH {})
      STATS_PROCESSES -> ready when (> (array/len @entity.pids) 0)
        (emit STATS_PROCESS_SAMPLE { key: "stats", pids: @entity.pids })
      STATS_PROCESSES_READ -> ready
        (set @entity.processes (let ((measured : [StatsMeasured] ?processes)) (array/map @measured (fn p { pid: @p.pid, rssBytes: @p.rssBytes }))))
        (set @entity.missing ?missing)
        (set @entity.unmeasured ?unmeasured)
        (emit STATS_FINISH {})
      STATS_PROCESSES_FAILED -> ready
        (set @entity.processes [])
        (set @entity.missing [])
        (set @entity.unmeasured [])
        (set @entity.unavailable (array/append @entity.unavailable "processes"))
        (emit STATS_FAILED { stat: "processes", code: ?code, error: ?error })
        (emit STATS_FINISH {})
      STATS_FINISH -> ready
        (set @entity.sampling false)
        (set @entity.dueAt (time/add @now @config.intervalMs "ms"))
        (emit STATS_READ { memoryTotal: @entity.memoryTotal, memoryUsed: @entity.memoryUsed, memoryAvailable: @entity.memoryAvailable, memoryPercent: @entity.memoryPercent, cpuPercent: @entity.cpuPercent, load1: @entity.load1, load5: @entity.load5, load15: @entity.load15, uptimeSeconds: @entity.uptimeSeconds, processes: @entity.processes, missing: @entity.missing, unmeasured: @entity.unmeasured, unavailable: @entity.unavailable, at: @now })
    }

    ticks {
      sampleDue every 1s [background]
        when (and @entity.active (not @entity.sampling) (or (== @entity.dueAt null) (>= (time/diff @now @entity.dueAt "ms") 0)))
        (emit STATS_SAMPLE {})
    }

    emits {
      STATS_READ -> external {
        memoryTotal : number!
        memoryUsed : number!
        memoryAvailable : number!
        memoryPercent : number!
        cpuPercent : number!
        load1 : number!
        load5 : number!
        load15 : number!
        uptimeSeconds : number!
        processes : [StatsProcess]!
        missing : [number]!
        unmeasured : [number]!
        unavailable : [string]!
        at : instant!
      }
        @description "One finished sample: memory in bytes, cpu and memory percent, the load averages, the uptime in seconds, the resident memory (bytes) of each watched process, the watched pids the host lists no process for, the ones it will not measure, and the stats the host could not answer (left at zero)."
        @tier "domain"
      STATS_FAILED -> external {
        stat : "memory" | "cpu" | "load" | "uptime" | "processes"!
        code : string!
        error : string!
      }
        @description "One stat of a sample could not be read: code is the host's failure kind (denied, unsupported, io, ...), or busy from std-process-sample."
        @tier "domain"
      STATS_SAMPLE { }
        @description "Internal: take a sample."
        @tier "internal"
      STATS_PROCESSES { }
        @description "Internal: read the watched processes."
        @tier "internal"
      STATS_FINISH { }
        @description "Internal: the sample is complete."
        @tier "internal"
      STATS_PROCESS_SAMPLE -> external {
        key : string!
        pids : [number]!
      }
        @description "The reading of the watched processes, handed to std-process-sample."
        @tier "internal"
      STATS_MEMORY {
        total : number!
        available : number!
        used : number!
        usedPercent : number!
      }
        @description "Internal: os/memory-info's success."
        @tier "internal"
      STATS_MEMORY_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/memory-info's failure."
        @tier "internal"
      STATS_CPU {
        percent : number!
      }
        @description "Internal: os/cpu-usage's success."
        @tier "internal"
      STATS_CPU_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/cpu-usage's failure."
        @tier "internal"
      STATS_LOAD {
        one : number!
        five : number!
        fifteen : number!
      }
        @description "Internal: os/load-avg's success."
        @tier "internal"
      STATS_LOAD_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/load-avg's failure."
        @tier "internal"
      STATS_UPTIME {
        seconds : number!
      }
        @description "Internal: os/uptime's success."
        @tier "internal"
      STATS_UPTIME_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/uptime's failure."
        @tier "internal"
    }

    listens {
      STATS_START -> input {
      }
        @description "Begin sampling: the first sample is taken within a second."
        @synonyms "start monitoring, watch the machine, begin system stats"
      STATS_STOP -> input {
      }
        @description "Stop sampling; a sample in flight still finishes."
        @synonyms "stop monitoring, pause system stats"
      STATS_WATCH -> input {
        pids : [number]!
      }
        @description "Name the processes whose resident memory each sample reads; an empty list reads none."
        @synonyms "watch processes, process memory, rss of pids"
      StatsProcessSample.PROCESS_SAMPLED -> STATS_PROCESSES_READ
      StatsProcessSample.PROCESS_SAMPLE_FAILED -> STATS_PROCESSES_FAILED
      STATS_PROCESSES_READ {
        key : string!
        at : number!
        processes : [StatsMeasured]!
        missing : [number]!
        unmeasured : [number]!
      }
        @description "std-process-sample's reading of the watched processes."
      STATS_PROCESSES_FAILED {
        key : string!
        code : string!
        error : string!
      }
        @description "std-process-sample's failure."
      STATS_SAMPLE { }
        @description "Self: take a sample."
      STATS_PROCESSES { }
        @description "Self: read the watched processes."
      STATS_FINISH { }
        @description "Self: the sample is complete."
      STATS_MEMORY {
        total : number!
        available : number!
        used : number!
        usedPercent : number!
      }
        @description "os/memory-info's success."
      STATS_MEMORY_FAILED {
        error : string!
        kind : string
      }
        @description "os/memory-info's failure."
      STATS_CPU {
        percent : number!
      }
        @description "os/cpu-usage's success."
      STATS_CPU_FAILED {
        error : string!
        kind : string
      }
        @description "os/cpu-usage's failure."
      STATS_LOAD {
        one : number!
        five : number!
        fifteen : number!
      }
        @description "os/load-avg's success."
      STATS_LOAD_FAILED {
        error : string!
        kind : string
      }
        @description "os/load-avg's failure."
      STATS_UPTIME {
        seconds : number!
      }
        @description "os/uptime's success."
      STATS_UPTIME_FAILED {
        error : string!
        kind : string
      }
        @description "os/uptime's failure."
    }
  }

  trait StatsProcessSample = Sample.traits.ProcessSample {
    listens {
      SystemStatsMeter.STATS_PROCESS_SAMPLE -> PROCESS_SAMPLE
    }
  }

  page boot as SystemStatsOrbitalStart -> SystemStatsMeter, StatsProcessSample
}
