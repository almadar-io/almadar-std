app std-infra-projection [
  version: "1.0.0",
  description: "std-infra-projection — projects a program onto cloud infrastructure. INFRA_PROJECT hands it a resolved program (the .orb JSON `orb resolve` prints) with the credentials each external service declares; it counts the program's orbitals, traits, pages, transitions, entities by persistence, effects by kind, ticks, cross-orbital events and external services, weights them into a complexity score whose tier (1 single instance, 2 multi-instance with a Redis event bus, 3 distributed with Postgres) sizes the infrastructure, and answers INFRA_PROJECTED once with the Terraform main and variables text (GCP; another provider answers a placeholder), the resources, the score and its breakdown, the tier and a monthly cost estimate per resource. A tier, database or instance-count override replaces the computed choice. Nothing is deployed and nothing is written; INFRA_PROJECT_FAILED answers a program that is not JSON."
]
uses Spec from "almadar-std/infra-projection"
type InfraField = { name : string, type : string }
type InfraEntity = { name : string, persistence : string, identity : boolean, fields : [InfraField] }
type InfraEffects = { effects : [SExpr] }
type InfraStateMachine = { transitions : [InfraEffects] }
type InfraTrait = { name : string, ticks : [InfraEffects], emits : [SExpr], listens : [SExpr], stateMachine : InfraStateMachine }
type InfraEventRef = { event : string }
type InfraServiceAuth = { secretEnv : string }
type InfraService = { name : string, ref : string, type : string, auth : InfraServiceAuth }
type InfraOrbital = { name : string, entity : SExpr, auxiliaryEntities : [SExpr], pages : [SExpr], services : [SExpr], traits : [SExpr] }
type InfraProgram = { name : string, orbitals : [InfraOrbital], services : [SExpr] }
type InfraForm = [SExpr]
type InfraPattern = { type : string }
type InfraCredential = { envVar : string!, required : boolean!, description : string! }
type InfraServiceCredentials = { name : string!, credentials : [InfraCredential]! }
type InfraSecret = { svc : string!, env : string!, envVar : string! }
type InfraEnv = { name : string!, value : string!, reference : boolean! }
type InfraCost = { resource : string!, min : number!, max : number!, notes : string! }
type InfraCount = { key : string!, value : number! }
type InfraEffectCounts = { renderUI : number!, persist : number!, fetch : number!, callService : number!, emitExternal : number!, spawn : number!, despawn : number!, navigate : number!, notify : number!, set : number! }
type InfraAnalysis = { orbitalCount : number!, effectCounts : InfraEffectCounts!, tickCount : number!, persistentEntityCount : number!, runtimeEntityCount : number!, crossOrbitalEventCount : number!, serviceRefs : [string]!, serviceCredentials : [InfraServiceCredentials]!, hasAuth : boolean!, hasFileUploads : boolean!, entityNames : [string]!, traitCount : number!, pageCount : number!, totalTransitions : number! }
orbital InfraProjectionOrbital {
  entity InfraProjection [runtime] {
    id : string!
    status : "idle" | "projected" | "failed" @description "What the last projection did." = idle
    appName : string = ""
    provider : string = "gcp"
    region : string = ""
    tierOverride : number = 0
    database : string = ""
    maxInstances : number = 0
    orbitalCount : number = 0
    traitCount : number = 0
    pageCount : number = 0
    totalTransitions : number = 0
    persistentEntityCount : number = 0
    runtimeEntityCount : number = 0
    tickCount : number = 0
    crossOrbitalEventCount : number = 0
    renderUI : number = 0
    persistCount : number = 0
    fetchCount : number = 0
    callService : number = 0
    emitExternal : number = 0
    spawnCount : number = 0
    despawnCount : number = 0
    navigateCount : number = 0
    notifyCount : number = 0
    setCount : number = 0
    hasAuth : boolean = false
    hasFileUploads : boolean = false
    entityNames : [string] = []
    serviceRefs : [string] = []
    serviceCredentials : [InfraServiceCredentials] = []
  }

  trait InfraProjector -> InfraProjection [client] {
    initial: idle


    state idle {
      INIT -> idle

      INFRA_PROJECT -> idle when (== (json/parse @payload.program InfraProgram) null)
        (set @entity.status "failed")
        (emit INFRA_PROJECT_FAILED { error: "the program is not a JSON object" })
      INFRA_PROJECT -> idle when (!= (json/parse @payload.program InfraProgram) null)
        (set @entity.appName @payload.appName)
        (set @entity.provider (or @payload.provider "gcp"))
        (set @entity.region (or @payload.region ""))
        (set @entity.tierOverride (if (== @payload.tier null) 0 @payload.tier))
        (set @entity.database (or @payload.database ""))
        (set @entity.maxInstances (if (== @payload.maxInstances null) 0 @payload.maxInstances))
        (let ((p (json/parse @payload.program InfraProgram)))
            (let ((orbitals (object/get @p "orbitals" [])))
              (let ((infos (array/map @orbitals (fn o (let ((ts (array/map (array/filter (or @o.traits []) (fn t (str/startsWith (json/stringify @t) "{"))) (fn t (json/parse (json/stringify @t) InfraTrait)))))
                      (let ((effs (array/flatten (array/map @ts (fn t (array/concat (array/flatten (array/map (or @t.stateMachine.transitions []) (fn x (or @x.effects [])))) (array/flatten (array/map (or @t.ticks []) (fn x (or @x.effects []))))))))))
                      (let ((forms (array/map @effs (fn e (if (str/startsWith (json/stringify @e) "[") (or (json/parse (json/stringify @e) InfraForm) []) []))))
                            (badTop (array/filter (array/map @effs (fn e (if (and (str/startsWith (json/stringify @e) "[") (= (json/parse (json/stringify @e) InfraForm) null)) (json/stringify @e) ""))) (fn n (!= @n ""))))
                            (badNested (array/flatten (array/map @effs (fn e (if (str/startsWith (json/stringify @e) "[") (let ((pf (json/parse (json/stringify @e) InfraForm))) (if (= @pf null) [] (array/filter (array/map (json/nodes (array/drop @pf 1)) (fn n (if (and (str/startsWith (json/stringify @n) "[") (= (json/parse (json/stringify @n) InfraForm) null)) (json/stringify @n) ""))) (fn n (!= @n ""))))) []))))))
                        {
                          name: (or @o.name ""),
                          ts: @ts,
                          forms: @forms,
                          badForms: (array/concat @badTop @badNested),
                          services: (array/concat
                            (array/filter (array/map (or @o.services []) (fn s (if (validate/string @s) @s (let ((d (json/parse (json/stringify @s) InfraService))) (or @d.ref @d.name ""))))) (fn n (!= @n "")))
                            (array/flatten (array/map @forms (fn f (array/concat
                              (array/flatten (array/map (json/nodes (array/drop @f 1)) (fn n (if (str/startsWith (json/stringify @n) "[") (let ((l (json/parse (json/stringify @n) InfraForm))) (if (= @l null) [] (if (and (> (array/len @l) 1) (= (json/stringify (array/first @l)) "\"call-service\"") (validate/string (array/nth @l 1))) [(array/nth @l 1)] []))) []))))
                              (if (and (> (array/len @f) 1) (= (json/stringify (array/first @f)) "\"call-service\"") (validate/string (array/nth @f 1))) [(str/concat (array/nth @f 1))] (array/take [""] 0))))))),
                          emits: (array/unique (array/filter (array/map (array/flatten (array/map @ts (fn t (or @t.emits [])))) (fn e (if (validate/string @e) @e (if (str/startsWith (json/stringify @e) "{") (or (object/get (json/parse (json/stringify @e) InfraEventRef) "event") "") "")))) (fn n (!= @n "")))),
                          listens: (array/unique (array/filter (array/map (array/flatten (array/map @ts (fn t (or @t.listens [])))) (fn e (if (validate/string @e) @e (if (str/startsWith (json/stringify @e) "{") (or (object/get (json/parse (json/stringify @e) InfraEventRef) "event") "") "")))) (fn n (!= @n ""))))
                        })))))))
                (let ((bad (array/flatten (array/map @infos (fn i @i.badForms)))))
                  (if (> (array/len @bad) 0)
                    (do (set @entity.status "failed") (emit INFRA_PROJECT_FAILED { error: (str/concat "a form node of the program is malformed: " (array/first @bad)) }))
                    (let ((allTs (array/flatten (array/map @infos (fn i @i.ts))))
                      (forms (array/flatten (array/map @infos (fn i @i.forms))))
                      (entities (array/map (array/filter @orbitals (fn o (str/startsWith (json/stringify @o.entity) "{"))) (fn o { entity: (json/parse (json/stringify @o.entity) InfraEntity), orbital: (or @o.name "") })))
                      (schemaServices (array/concat (or @p.services []) (array/flatten (array/map @orbitals (fn o (or @o.services [])))))))
                  (let ((heads (array/map @forms (fn f (if (> (array/len @f) 0) (json/stringify (array/first @f)) ""))))
                        (refs (array/unique (array/concat (array/flatten (array/map @infos (fn i @i.services))) (array/filter (array/map (or @p.services []) (fn s (if (str/startsWith (json/stringify @s) "{") (or (object/get (json/parse (json/stringify @s) InfraService) "name") "") ""))) (fn n (!= @n "")))))))
                    (do
                      (set @entity.orbitalCount (array/len @orbitals))
                      (set @entity.traitCount (array/len @allTs))
                      (set @entity.pageCount (array/sum (array/map @orbitals (fn o (array/len (or @o.pages []))))))
                      (set @entity.totalTransitions (array/sum (array/map @allTs (fn t (array/len (or @t.stateMachine.transitions []))))))
                      (set @entity.tickCount (array/sum (array/map @allTs (fn t (array/len (or @t.ticks []))))))
                      (set @entity.persistentEntityCount (array/len (array/filter @entities (fn e (= (or @e.entity.persistence "persistent") "persistent")))))
                      (set @entity.runtimeEntityCount (array/len (array/filter @entities (fn e (= @e.entity.persistence "runtime")))))
                      (set @entity.hasFileUploads (array/some @entities (fn e (array/some (or @e.entity.fields []) (fn f (or (= @f.type "file") (= @f.type "image")))))))
                      (set @entity.entityNames (array/map @entities (fn e (or @e.entity.name @e.orbital))))
                      (set @entity.renderUI (array/len (array/filter @heads (fn h (= @h "\"render-ui\"")))))
                      (set @entity.persistCount (array/len (array/filter @heads (fn h (= @h "\"persist\"")))))
                      (set @entity.fetchCount (array/len (array/filter @heads (fn h (= @h "\"fetch\"")))))
                      (set @entity.callService (array/len (array/filter @heads (fn h (= @h "\"call-service\"")))))
                      (set @entity.emitExternal (array/len (array/filter @heads (fn h (= @h "\"emit\"")))))
                      (set @entity.spawnCount (array/len (array/filter @heads (fn h (= @h "\"spawn\"")))))
                      (set @entity.despawnCount (array/len (array/filter @heads (fn h (= @h "\"despawn\"")))))
                      (set @entity.navigateCount (array/len (array/filter @heads (fn h (= @h "\"navigate\"")))))
                      (set @entity.notifyCount (array/len (array/filter @heads (fn h (= @h "\"notify\"")))))
                      (set @entity.setCount (array/len (array/filter @heads (fn h (= @h "\"set\"")))))
                      (set @entity.hasAuth (array/some (array/concat (array/map @orbitals (fn o @o.entity)) (array/flatten (array/map @orbitals (fn o (or @o.auxiliaryEntities []))))) (fn e (and (str/startsWith (json/stringify @e) "{") (= (object/get (json/parse (json/stringify @e) InfraEntity) "identity") true)))))
                      (set @entity.crossOrbitalEventCount (array/sum (array/map (array/range 0 (array/len @infos)) (fn i (array/sum (array/map (array/range 0 (array/len @infos)) (fn j (if (= (object/get (array/nth @infos @i) "name") (object/get (array/nth @infos @j) "name")) 0 (array/len (array/filter (object/get (array/nth @infos @i) "emits") (fn ev (array/includes (object/get (array/nth @infos @j) "listens") @ev))))))))))))
                      (set @entity.serviceRefs @refs)
                      (set @entity.serviceCredentials (array/map @refs (fn svc (let ((registered (if (>= (array/indexOf (object/keys (or @payload.credentials {})) @svc) 0) (array/nth (object/values (or @payload.credentials {})) (array/indexOf (object/keys (or @payload.credentials {})) @svc)) (array/take [{ envVar: "", required: false, description: "" }] 0))))
                        { name: @svc, credentials: (if (> (array/len @registered) 0) @registered (array/map (array/filter (array/map (array/filter @schemaServices (fn s (str/startsWith (json/stringify @s) "{"))) (fn s (json/parse (json/stringify @s) InfraService))) (fn s (and (= @s.name @svc) (= @s.type "rest") (!= (or @s.auth.secretEnv "") "")))) (fn s { envVar: @s.auth.secretEnv, required: true, description: (str/concat "API credential for " @svc) }))) }))))
                      (emit INFRA_ANALYZED { })))))))))

      INFRA_ANALYZED -> idle
        (let ((breakdown (array/filter [
                { key: "orbitals", value: (* @entity.orbitalCount 1) },
                { key: "persist", value: (* @entity.persistCount 2) },
                { key: "fetch", value: (* @entity.fetchCount 2) },
                { key: "callService", value: (* @entity.callService 3) },
                { key: "emitExternal", value: (* @entity.emitExternal 4) },
                { key: "spawn", value: (* @entity.spawnCount 2) },
                { key: "despawn", value: (* @entity.despawnCount 1) },
                { key: "ticks", value: (* @entity.tickCount 3) },
                { key: "persistentEntities", value: (* @entity.persistentEntityCount 2) },
                { key: "crossOrbitalEvents", value: (* @entity.crossOrbitalEventCount 4) },
                { key: "serviceRefs", value: (* (array/len @entity.serviceRefs) 3) }
              ] (fn c (> @c.value 0)))))
          (let ((raw (array/sum (array/map @breakdown (fn c @c.value)))))
            (let ((tier (if (> @entity.tierOverride 0) @entity.tierOverride (if (<= @raw 25) 1 (if (<= @raw 60) 2 3))))
                  (gcp (= @entity.provider "gcp"))
                  (heavy (and (> @entity.persistCount 20) (> @entity.persistentEntityCount 5)))
                  (events (or (> @entity.crossOrbitalEventCount 0) (> @entity.emitExternal 0)))
                  (secrets (array/flatten (array/map @entity.serviceCredentials (fn s (array/map @s.credentials (fn c { svc: (str/replace-pattern @s.name "[^a-zA-Z0-9]" "-"), env: (str/lower (str/replace-pattern @c.envVar "[^a-zA-Z0-9]" "-")), envVar: @c.envVar })))))))
              (let ((db (if (!= @entity.database "") @entity.database (if (or (= @tier 3) (and (>= @tier 2) @heavy)) "postgres" "firestore")))
                    (maxInstances (if (> @entity.maxInstances 0) @entity.maxInstances (if (= @tier 1) 3 (if (= @tier 2) 10 50))))
                    (region (if (= @entity.region "") "europe-west4" @entity.region))
                    (anyCreds (> (array/len @secrets) 0)))
                (let ((firestore (and (> @entity.persistentEntityCount 0) (= @db "firestore")))
                      (usePostgres (= @db "postgres"))
                      (useRedis (and (>= @tier 2) @events)))
                  (let ((vpc (or @useRedis @usePostgres))
                        (cost (array/flatten [
                          (if (= @tier 1) (array/flatten [
                            [{ resource: (if @gcp "Cloud Run" "ECS Fargate"), min: 0, max: 15, notes: "Scale-to-zero. Free tier covers 2M requests/mo." }],
                            (if @firestore [{ resource: (if @gcp "Firestore" "DynamoDB"), min: 0, max: 15, notes: "Free tier: 50K reads/day, 20K writes/day." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            (if @usePostgres [{ resource: (if @gcp "Cloud SQL Postgres" "RDS Postgres"), min: 51, max: 100, notes: "db-g1-small shared instance." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            (if @vpc [{ resource: "VPC Connector", min: 7, max: 20, notes: "Serverless VPC Access: $0.01/hr per instance (2-3 instances)." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            [{ resource: "CDN/Hosting", min: 0, max: 5, notes: "Free tier: 10 GiB storage, 360 MiB/day bandwidth." }],
                            (if @entity.hasAuth [{ resource: "Authentication", min: 0, max: 0, notes: "Free up to 50K MAU." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            (if @entity.hasFileUploads [{ resource: "Object Storage", min: 1, max: 10, notes: "$0.026/GiB/month." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0))
                          ]) (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                          (if (= @tier 2) (array/flatten [
                            [{ resource: (if @gcp "Cloud Run" "ECS Fargate"), min: 15, max: 80, notes: "2-5 instances average. Auto-scaling." }],
                            (if @usePostgres [{ resource: (if @gcp "Cloud SQL Postgres" "RDS Postgres"), min: 51, max: 100, notes: "db-g1-small shared instance." }] (if @firestore [{ resource: (if @gcp "Firestore" "DynamoDB"), min: 15, max: 80, notes: "Pay-per-operation beyond free tier." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0))),
                            (if @events [{ resource: "Redis (event bus)", min: 5, max: 30, notes: "Upstash pay-as-you-go: $0.20/100K commands." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            [{ resource: "CDN/Hosting", min: 5, max: 30, notes: "Beyond free tier bandwidth." }],
                            (if (> (array/len @entity.serviceRefs) 0) [{ resource: "Secrets Manager", min: 1, max: 5, notes: (str/concat (array/len @entity.serviceRefs) " API keys stored.") }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            (if (> @entity.tickCount 0) [{ resource: "Scheduler", min: 0, max: 5, notes: (str/concat @entity.tickCount " scheduled jobs.") }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            (if @vpc [{ resource: "VPC Connector", min: 7, max: 20, notes: "Serverless VPC Access: $0.01/hr per instance (2-3 instances)." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0))
                          ]) (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                          (if (= @tier 3) (array/flatten [
                            [{ resource: (if @gcp "Cloud Run" "ECS Fargate"), min: 100, max: 500, notes: "10-30 instances. Multi-region." }],
                            (if @usePostgres [{ resource: (if @gcp "Cloud SQL Postgres" "RDS Postgres"), min: 100, max: 400, notes: "db-custom-2-4096. Regional availability." }] (if @firestore [{ resource: (if @gcp "Firestore" "DynamoDB"), min: 15, max: 80, notes: "Pay-per-operation beyond free tier." }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0))),
                            [{ resource: "Redis Cluster", min: 50, max: 200, notes: "Managed Redis with replication." }],
                            [{ resource: "CDN/Load Balancer", min: 30, max: 100, notes: "Global load balancer + CDN." }],
                            [{ resource: "WAF/Security", min: 10, max: 50, notes: "Cloud Armor or AWS WAF." }],
                            (if (> (array/len @entity.serviceRefs) 0) [{ resource: "Secrets Manager", min: 2, max: 10, notes: (str/concat (array/len @entity.serviceRefs) " secrets.") }] (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0)),
                            [{ resource: "VPC Connector", min: 14, max: 30, notes: "Serverless VPC Access: 2-3 instances sustained." }],
                            [{ resource: "Monitoring/Logging", min: 20, max: 80, notes: "Cloud Ops Suite or CloudWatch." }]
                          ]) (array/take [{ resource: "", min: 0, max: 0, notes: "" }] 0))
                        ]))
                        (env (array/filter (array/flatten [
                          [{ name: "NODE_ENV", value: "production", reference: false }, { name: "FIREBASE_PROJECT_ID", value: "var.project_id", reference: true }],
                          (if @firestore [{ name: "FIREBASE_DATABASE_ID", value: "(default)", reference: false }] (array/take [{ name: "", value: "", reference: false }] 0)),
                          (if @entity.hasFileUploads [{ name: "FIREBASE_STORAGE_BUCKET", value: "${var.app_name}-uploads", reference: false }] (array/take [{ name: "", value: "", reference: false }] 0)),
                          (if @useRedis [{ name: "REDIS_HOST", value: "google_redis_instance.events.host", reference: true }, { name: "REDIS_PORT", value: "google_redis_instance.events.port", reference: true }] (array/take [{ name: "", value: "", reference: false }] 0)),
                          (if @usePostgres [{ name: "DATABASE_URL", value: "postgresql://postgres:${var.db_password}@localhost/${var.app_name}?host=/cloudsql/${google_sql_database_instance.main.connection_name}", reference: false }] (array/take [{ name: "", value: "", reference: false }] 0))
                          (if (and (> @entity.tickCount 0) (> @tier 1)) [{ name: "ORB_TICK_INVOKER", value: "google_service_account.app.email", reference: true }, { name: "ORB_TICK_AUDIENCE", value: "orb-tick:${var.app_name}", reference: false }] (array/take [{ name: "", value: "", reference: false }] 0)),
                        ]) (fn v (not (and @usePostgres (= @v.name "FIREBASE_DATABASE_ID")))))))
                    (let ((resources (let ((all (array/flatten [[(str/concat "google_service_account")] (if @firestore [(str/concat "google_project_iam_member")] (array/take [""] 0)) (if @entity.hasFileUploads [(str/concat "google_project_iam_member")] (array/take [""] 0)) (if @anyCreds [(str/concat "google_project_iam_member")] (array/take [""] 0)) (if (> @entity.renderUI 0) [(str/concat "google_firebase_hosting_site")] (array/take [""] 0)) [(str/concat "google_cloud_run_v2_service")] [(str/concat "google_cloud_run_v2_service_iam_member")] (if @firestore [(str/concat "google_firestore_database")] (array/take [""] 0)) (if @entity.hasAuth [(str/concat "google_identity_platform_config")] (array/take [""] 0)) (if @entity.hasFileUploads [(str/concat "google_storage_bucket")] (array/take [""] 0)) (if @anyCreds [(str/concat "google_secret_manager_secret")] (array/take [""] 0)) (array/flatten [(if @useRedis [(str/concat "google_redis_instance")] (array/take [""] 0)) (if @usePostgres [(str/concat "google_sql_database_instance") (str/concat "google_sql_database") (str/concat "google_project_iam_member")] (array/take [""] 0)) (if @vpc [(str/concat "google_vpc_access_connector")] (array/take [""] 0)) (if (and (>= @tier 2) (> @entity.tickCount 0)) [(str/concat "google_cloud_scheduler_job")] (array/take [""] 0))]) (if (= @tier 3) [(str/concat "google_compute_global_address") (str/concat "google_compute_security_policy") (str/concat "google_compute_region_network_endpoint_group") (str/concat "google_compute_backend_service") (str/concat "google_compute_url_map") (str/concat "google_compute_managed_ssl_certificate") (str/concat "google_compute_target_https_proxy") (str/concat "google_compute_global_forwarding_rule")] (array/take [""] 0))])))
                            (if (and @usePostgres (>= (array/indexOf @all "google_firestore_database") 0)) (array/remove @all (array/indexOf @all "google_firestore_database")) @all)))
                          (envBlock (let ((lines (array/concat (array/map @env (fn v (if @v.reference (str/concat "      env {\n        name  = \"" @v.name "\"\n        value = " @v.value "\n      }") (str/concat "      env {\n        name  = \"" @v.name "\"\n        value = \"" @v.value "\"\n      }")))) (array/map @secrets (fn c (str/concat "      env {\n        name = \"" @c.envVar "\"\n        value_source {\n          secret_key_ref {\n            secret  = google_secret_manager_secret." @c.svc "_" @c.env ".secret_id\n            version = \"latest\"\n          }\n        }\n      }"))))))
                            (if (> (array/len @lines) 0) (str/concat "\n\n" (str/join @lines "\n\n")) "")))
                          (databaseHcl (str/join (array/flatten [(if @usePostgres [(str/concat "resource \"google_sql_database_instance\" \"main\" {\n  name             = \"${var.app_name}-db\"\n  database_version = \"POSTGRES_15\"\n  region           = var.region\n\n  settings {\n    tier              = \"db-g1-small\"\n    availability_type = \"ZONAL\"\n    disk_size         = 10\n\n    backup_configuration {\n      enabled = true\n    }\n\n    ip_configuration {\n      ipv4_enabled = true\n    }\n  }\n\n  deletion_protection = true\n}\n\nresource \"google_sql_database\" \"app\" {\n  name     = var.app_name\n  instance = google_sql_database_instance.main.name\n}\n\noutput \"database_connection\" {\n  value     = google_sql_database_instance.main.connection_name\n  sensitive = true\n}\n")] (array/take [""] 0)) (if @usePostgres [(str/concat "resource \"google_project_iam_member\" \"sa_cloudsql\" {\n  project = var.project_id\n  role    = \"roles/cloudsql.client\"\n  member  = \"serviceAccount:${google_service_account.app.email}\"\n}\n")] (array/take [""] 0)) (if @vpc [(str/concat "resource \"google_vpc_access_connector\" \"main\" {\n  name          = \"${var.app_name}-vpc\"\n  region        = var.region\n  network       = \"default\"\n  ip_cidr_range = \"10.8.0.0/28\"\n  min_instances = 2\n  max_instances = 3\n}\n")] (array/take [""] 0))]) "\n"))
                          (volumeMount (if @usePostgres "\n\n      volume_mounts {\n        name       = \"cloudsql\"\n        mount_path = \"/cloudsql\"\n      }" ""))
