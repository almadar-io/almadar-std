.name\n  provider     = google-beta\n}\n")] (array/take [""] 0)) [(str/concat "resource \"google_cloud_run_v2_service_iam_member\" \"public\" {\n  name     = google_cloud_run_v2_service.app.name\n  location = var.region\n  role     = \"roles/run.invoker\"\n  member   = \"allUsers\"\n}\n")] (if @firestore [(str/concat "resource \"google_firestore_database\" \"main\" {\n  name        = \"(default)\"\n  location_id = var.region\n  type        = \"FIRESTORE_NATIVE\"\n}\n")] (array/take [""] 0)) (if @entity.hasAuth [(str/concat "resource \"google_identity_platform_config\" \"auth\" {\n  project = var.project_id\n\n  sign_in {\n    allow_duplicate_emails = false\n    email {\n      enabled           = true\n      password_required = true\n    }\n  }\n}\n")] (array/take [""] 0)) (if @entity.hasFileUploads [(str/concat "resource \"google_storage_bucket\" \"uploads\" {\n  name          = \"${var.app_name}-uploads\"\n  location      = var.region\n  force_destroy = false\n\n  uniform_bucket_level_access = true\n}\n")] (array/take [""] 0)) (if @anyCreds (array/map @secrets (fn c (str/concat "resource \"google_secret_manager_secret\" \"" @c.svc "_" @c.env "\" {\n  secret_id = \"${var.app_name}-" @c.env "\"\n  replication {\n    auto {}\n  }\n}\n"))) (array/take [""] 0)) [(str/concat "output \"backend_url\" {\n  value = google_cloud_run_v2_service.app.uri\n}\n")] (if (> @entity.renderUI 0) [(str/concat "output \"frontend_url\" {\n  value = \"https://${var.app_name}.web.app\"\n}\n")] (array/take [""] 0)) [(str/concat "output \"service_account_email\" {\n  value = google_service_account.app.email\n}\n")]]) "\n") (if (= @tier 2) (str/join (array/flatten [[(str/concat (str/join (array/flatten [[(str/concat "provider \"google\" {\n  project = var.project_id\n  region  = var.region\n}\n\nprovider \"google-beta\" {\n  project = var.project_id\n  region  = var.region\n}\n")] [(str/concat "resource \"google_service_account\" \"app\" {\n  account_id   = \"${var.app_name}-sa\"\n  display_na