app std-cli [
  version: "1.0.0",
  exec: ["echo"],
  description: "std-cli — runs one command-line program as a child process through os/spawn, os/read and os/wait. CLI_RUN carries the arguments and a stage name the caller uses to tell its runs apart; the atom pipes stdout and stderr, reads both to the end, waits for the exit and answers CLI_DONE with the stage, the exit code (-1 when a signal ended it), the signal and both streams as text. What a non-zero exit means is the caller's to decide. CLI_FAILED answers a run that could not be made: the child did not start (cli_spawn_failed), a read, close or wait failed (cli_host_failed), or another run is in flight (cli_busy); a cancel with nothing running answers cli_idle. CLI_CANCEL sends TERM to the running child; a cancel that arrives before the child has started is applied as soon as it starts. The command knob names the executable, matched exactly against the exec grant the composing program declares; the child runs with exactly the environment the run's env or else the env knob names, with the passEnv knob's host variables added (read with os/getenv; the explicit env wins on a clash), in the cwd knob's directory (the host's working directory when it is empty). A run may feed the child stdin bytes, which are written whole and closed before the output is read. With the binaryOutput knob on, stdout is answered as bytes only. With the stdio knob set to inherit the child runs on this process's terminal instead: nothing is piped or read, the atom waits for the exit and CLI_DONE carries the exit code with empty streams."
]
uses Spec from "almadar-std/cli"
type AnchoredEnv = { anchor : { env : string! }! }
type AnchoredPath = { anchor : string!, path : string! }
type CliCommand = string | AnchoredEnv | AnchoredPath
orbital CliOrbital {
  entity CliCall [runtime] {
    id : string!
    stage : string @description "The caller's name for the run in flight; blank when idle." = ""
    pid : number @description "Process id of the running child; 0 before it starts." = 0
    outFd : number @description "Descriptor of the child's piped stdout." = 0
    errFd : number @description "Descriptor of the child's piped stderr." = 0
    outDone : boolean @description "True once the child's stdout reached end of file." = false
    errDone : boolean @description "True once the child's stderr reached end of file." = false
    out : bytes @description "Everything the child wrote to stdout so far." = ""
    err : bytes @description "Everything the child wrote to stderr so far." = ""
    exitCode : number @description "Exit code of the last finished child; -1 when a signal ended it." = 0
    cancelRequested : boolean @description "A cancel arrived before the child started." = false
    hasStdin : boolean @description "The run in flight feeds the child bytes on stdin." = false
    stdin : bytes @description "The bytes the run in flight feeds the child on stdin." = ""
    inFd : number @description "Descriptor of the child's piped stdin." = 0
    argv : [string] @description "The arguments of the run in flight." = []
    baseEnv : Map string string @description "The run's env, or the env knob, for the run in flight." = {}
    passed : Map string string @description "The passEnv variables read from the host for the run in flight." = {}
    cmdCursor : number @description "Index of the candidate command being tried." = 0
    envCursor : number @description "Index of the next passEnv variable to read." = 0
  }

  trait CliRunner -> @rebindable CliCall [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.stage "")
      CLI_CANCEL -> idle
        (emit CLI_FAILED { stage: "" error: "nothing is running" code: "cli_idle" })
      CLI_RUN -> running
        (set @entity.stage @payload.stage)
        (set @entity.pid 0)
        (set @entity.out (bytes/from-string ""))
        (set @entity.err (bytes/from-string ""))
        (set @entity.outDone false)
        (set @entity.errDone false)
        (set @entity.cancelRequested false)
        (set @entity.hasStdin (!= @payload.stdin null))
        (set @entity.stdin (or @payload.stdin (bytes/from-string "")))
        (set @entity.argv @payload.argv)
        (set @entity.baseEnv (or @payload.env @config.env))
        (set @entity.passed (object/fromEntries (array/take [["", ""]] 0)))
        (set @entity.envCursor 0)
        (set @entity.cmdCursor 0)
        (emit CLI_ENV_NEXT { })
    }

    state running {
      INIT -> running
      CLI_RUN -> running
        (emit CLI_FAILED { stage: @payload.stage error: "another run is in flight" code: "cli_busy" })
      CLI_ENV_NEXT -> running when (< @entity.envCursor (array/len @config.passEnv))
        (os/getenv (array/nth @config.passEnv @entity.envCursor) { key: "getenv" emit: { success: CLI_ENV_READ failure: CLI_HOST_FAILED } })
      CLI_ENV_READ -> running when (== @payload.value null)
        (set @entity.envCursor (+ @entity.envCursor 1))
        (emit CLI_ENV_NEXT { })
      CLI_ENV_READ -> running when (!= @payload.value null)
        (let ((entry (object/fromEntries [[(array/nth @config.passEnv @entity.envCursor), @payload.value]]))) (set @entity.passed (if (= @entry null) @entity.passed (object/merge @entity.passed @entry))))
        (set @entity.envCursor (+ @entity.envCursor 1))
        (emit CLI_ENV_NEXT { })
      CLI_ENV_NEXT -> running when (and (>= @entity.envCursor (array/len @config.passEnv)) (= @config.cwd "") (= @config.stdio "pipe") (not @entity.hasStdin))
        (os/spawn (array/nth @config.commands @entity.cmdCursor) @entity.argv { cwd: null env: (object/merge @entity.passed @entity.baseEnv) stdin: "null" stdout: "pipe" stderr: "pipe" detached: false } { key: "spawn" emit: { success: CLI_SPAWNED failure: CLI_SPAWN_FAILED } })
      CLI_ENV_NEXT -> running when (and (>= @entity.envCursor (array/len @config.passEnv)) (= @config.cwd "") (= @config.stdio "pipe") @entity.hasStdin)
        (os/spawn (array/nth @config.commands @entity.cmdCursor) @entity.argv { cwd: null env: (object/merge @entity.passed @entity.baseEnv) stdin: "pipe" stdout: "pipe" stderr: "pipe" detached: false } { key: "spawn" emit: { success: CLI_SPAWNED failure: CLI_SPAWN_FAILED } })
      CLI_ENV_NEXT -> running when (and (>= @entity.envCursor (array/len @config.passEnv)) (!= @config.cwd "") (= @config.stdio "pipe") (not @entity.hasStdin))
        (os/spawn (array/nth @config.commands @entity.cmdCursor) @entity.argv { cwd: @config.cwd env: (object/merge @entity.passed @entity.baseEnv) stdin: "null" stdout: "pipe" stderr: "pipe" detached: false } { key: "spawn" emit: { success: CLI_SPAWNED failure: CLI_SPAWN_FAILED } })
      CLI_ENV_NEXT -> running when (and (>= @entity.envCursor (array/len @config.passEnv)) (!= @config.cwd "") (= @config.stdio "pipe") @entity.hasStdin)
        (os/spawn (array/nth @config.commands @entity.cmdCursor) @entity.argv { cwd: @config.cwd env: (object/merge @entity.passed @entity.baseEnv) stdin: "pipe" stdout: "pipe" stderr: "pipe" detached: false } { key: "spawn" emit: { success: CLI_SPAWNED failure: CLI_SPAWN_FAILED } })
      CLI_ENV_NEXT -> running when (and (>= @entity.envCursor (array/len @config.passEnv)) (= @config.cwd "") (= @config.stdio "inherit"))
        (os/spawn (array/nth @config.commands @entity.cmdCursor) @entity.argv { cwd: null env: (object/merge @entity.passed @entity.baseEnv) stdin: "inherit" stdout: "inherit" stderr: "inherit" detached: false } { key: "spawn" emit: { success: CLI_SPAWNED failure: CLI_SPAWN_FAILED } })
      CLI_ENV_NEXT -> running when (and (>= @entity.envCursor (array/len @config.passEnv)) (!= @config.cwd "") (= @config.stdio "inherit"))
        (os/spawn (array/nth @config.commands @entity.cmdCursor) @entity.argv { cwd: @config.cwd env: (object/merge @entity.passed @entity.baseEnv) stdin: "inherit" stdout: "inherit" stderr: "inherit" detached: false } { key: "spawn" emit: { success: CLI_SPAWNED failure: CLI_SPAWN_FAILED } })
      CLI_CANCEL -> running when (> @entity.pid 0)
        (os/kill @entity.pid "TERM" { key: "kill" emit: { failure: CLI_HOST_FAILED } })
      CLI_CANCEL -> running when (= @entity.pid 0)
        (set @entity.cancelRequested true)
      CLI_SPAWNED -> running when (and (= @config.stdio "pipe") (not @entity.cancelRequested) (not @entity.hasStdin))
        (set @entity.pid @payload.pid)
        (set @entity.outFd @payload.stdout)
        (set @entity.errFd @payload.stderr)
        (os/read @payload.stdout 65536 { key: "out" emit: { success: CLI_OUT_CHUNK failure: CLI_HOST_FAILED } })
        (os/read @payload.stderr 65536 { key: "err" emit: { success: CLI_ERR_CHUNK failure: CLI_HOST_FAILED } })
      CLI_SPAWNED -> running when (and (= @config.stdio "pipe") (not @entity.cancelRequested) @entity.hasStdin)
        (set @entity.pid @payload.pid)
        (set @entity.outFd @payload.stdout)
        (set @entity.errFd @payload.stderr)
        (set @entity.inFd @payload.stdin)
        (os/write @payload.stdin @entity.stdin { key: "stdin" emit: { success: CLI_STDIN_WRITTEN failure: CLI_HOST_FAILED } })
      CLI_SPAWNED -> running when (and (= @config.stdio "pipe") @entity.cancelRequested (not @entity.hasStdin))
        (set @entity.pid @payload.pid)
        (set @entity.outFd @payload.stdout)
        (set @entity.errFd @payload.stderr)
        (os/kill @payload.pid "TERM" { key: "kill" emit: { failure: CLI_HOST_FAILED } })
        (os/read @payload.stdout 65536 { key: "out" emit: { success: CLI_OUT_CHUNK failure: CLI_HOST_FAILED } })
        (os/read @payload.stderr 65536 { key: "err" emit: { success: CLI_ERR_CHUNK failure: CLI_HOST_FAILED } })
      CLI_SPAWNED -> running when (and (= @config.stdio "pipe") @entity.cancelRequested @entity.hasStdin)
        (set @entity.pid @payload.pid)
        (set @entity.outFd @payload.stdout)
        (set @entity.errFd @payload.stderr)
        (os/kill @payload.pid "TERM" { key: "kill" emit: { failure: CLI_HOST_FAILED } })
        (set @entity.inFd @payload.stdin)
        (os/close @payload.stdin { key: "close-in" emit: { success: CLI_STDIN_CLOSED failure: CLI_HOST_FAILED } })
      CLI_SPAWNED -> running when (and (= @config.stdio "inherit") (not @entity.cancelRequested))
        (set @entity.pid @payload.pid)
        (os/wait @payload.pid { key: "wait" emit: { success: CLI_EXITED failure: CLI_HOST_FAILED } })
      CLI_SPAWNED -> running when (and (= @config.stdio "inherit") @entity.cancelRequested)
        (set @entity.pid @payload.pid)
        (os/kill @payload.pid "TERM" { key: "kill" emit: { failure: CLI_HOST_FAILED } })
        (os/wait @payload.pid { key: "wait" emit: { success: CLI_EXITED failure: CLI_HOST_FAILED } })
      CLI_STDIN_WRITTEN -> running
        (os/close @entity.inFd { key: "close-in" emit: { success: CLI_STDIN_CLOSED failure: CLI_HOST_FAILED } })
      CLI_STDIN_CLOSED -> running
        (os/read @entity.outFd 65536 { key: "out" emit: { success: CLI_OUT_CHUNK failure: CLI_HOST_FAILED } })
        (os/read @entity.errFd 65536 { key: "err" emit: { success: CLI_ERR_CHUNK failure: CLI_HOST_FAILED } })
      CLI_SPAWN_FAILED -> running when (and (= @payload.kind "not-found") (< (+ @entity.cmdCursor 1) (array/len @config.commands)))
        (set @entity.cmdCursor (+ @entity.cmdCursor 1))
        (emit CLI_ENV_NEXT { })
      CLI_SPAWN_FAILED -> idle when (or (!= @payload.kind "not-found") (>= (+ @entity.cmdCursor 1) (array/len @config.commands)))
        (emit CLI_FAILED { stage: @entity.stage error: (or @payload.error "") code: "cli_spawn_failed" })
        (set @entity.stage "")
      CLI_OUT_CHUNK -> running when (not @payload.eof)
        (set @entity.out (bytes/concat [@entity.out @payload.data]))
        (os/read @entity.outFd 65536 { key: "out" emit: { success: CLI_OUT_CHUNK failure: CLI_HOST_FAILED } })
      CLI_OUT_CHUNK -> running when (and @payload.eof (not @entity.errDone))
        (set @entity.outDone true)
        (os/close @entity.outFd { key: "close-out" emit: { failure: CLI_HOST_FAILED } })
      CLI_OUT_CHUNK -> running when (and @payload.eof @entity.errDone)
        (set @entity.outDone true)
        (os/close @entity.outFd { key: "close-out" emit: { failure: CLI_HOST_FAILED } })
        (os/wait @entity.pid { key: "wait" emit: { success: CLI_EXITED failure: CLI_HOST_FAILED } })
      CLI_ERR_CHUNK -> running when (not @payload.eof)
        (set @entity.err (bytes/concat [@entity.err @payload.data]))
        (os/read @entity.errFd 65536 { key: "err" emit: { success: CLI_ERR_CHUNK failure: CLI_HOST_FAILED } })
      CLI_ERR_CHUNK -> running when (and @payload.eof (not @entity.outDone))
        (set @entity.errDone true)
        (os/close @entity.errFd { key: "close-err" emit: { failure: CLI_HOST_FAILED } })
      CLI_ERR_CHUNK -> running when (and @payload.eof @entity.outDone)
        (set @entity.errDone true)
        (os/close @entity.errFd { key: "close-err" emit: { failure: CLI_HOST_FAILED } })
        (os/wait @entity.pid { key: "wait" emit: { success: CLI_EXITED failure: CLI_HOST_FAILED } })
      CLI_HOST_FAILED -> idle
        (emit CLI_FAILED { stage: @entity.stage error: (or @payload.error "") code: "cli_host_failed" })
        (set @entity.stage "")
        (set @entity.pid 0)
      CLI_EXITED -> idle when (not @config.binaryOutput)
        (set @entity.exitCode (if (== @payload.code null) -1 @payload.code))
        (let ((text (bytes/to-string @entity.out)) (errText (bytes/to-string @entity.err)))
          (if (or (== @text null) (== @errText null))
            (emit CLI_FAILED { stage: @entity.stage error: "the child wrote output that is not valid UTF-8 text" code: "cli_output_undecodable" })
            (emit CLI_DONE { stage: @entity.stage exitCode: (if (== @payload.code null) -1 @payload.code) signal: (or @payload.signal 0) stdout: @text stdoutBytes: @entity.out stderr: @errText })))
        (set @entity.stage "")
        (set @entity.pid 0)
      CLI_EXITED -> idle when @config.binaryOutput
        (set @entity.exitCode (if (== @payload.code null) -1 @payload.code))
        (let ((errText (bytes/to-string @entity.err)))
          (if (== @errText null)
            (emit CLI_FAILED { stage: @entity.stage error: "the child wrote output that is not valid UTF-8 text" code: "cli_output_undecodable" })
            (emit CLI_DONE { stage: @entity.stage exitCode: (if (== @payload.code null) -1 @payload.code) signal: (or @payload.signal 0) stdout: "" stdoutBytes: @entity.out stderr: @errText })))
        (set @entity.stage "")
        (set @entity.pid 0)
    }

    emits {
      CLI_DONE -> external {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "The child exited: its exit code (-1 when a signal ended it), the signal (0 when none) and everything it wrote to stdout (as text, and as bytes for binary output) and stderr, for the run named by stage."
        @synonyms "command finished, process exited, output"
        @tier "domain"
      CLI_FAILED -> external {
        stage : string!
        error : string!
        code : string!
      }
        @description "The run could not be made: cli_spawn_failed (the child did not start), cli_host_failed (a read, close, kill or wait failed) cli_output_undecodable (stdout or stderr was not valid UTF-8 text; run with binaryOutput to read stdout as bytes) cli_busy (another run is in flight) or cli_idle (a cancel with nothing running)."
        @synonyms "command error, spawn failed, busy"
        @tier "domain"
      CLI_SPAWNED -> internal {
        pid : number!
        stdin : number
        stdout : number!
        stderr : number!
      }
        @description "Internal: the os/spawn answer."
        @tier "internal"
      CLI_ENV_NEXT -> internal {
      }
        @description "Internal: read the next passEnv variable, or start the child."
        @tier "internal"
      CLI_ENV_READ -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for one passEnv variable; value is absent when it is unset."
        @tier "internal"
      CLI_STDIN_WRITTEN -> internal {
        bytes : number!
      }
        @description "Internal: the os/write of the run's stdin bytes."
        @tier "internal"
      CLI_STDIN_CLOSED -> internal {
      }
        @description "Internal: the child's stdin was closed after the run's bytes were written."
        @tier "internal"
      CLI_SPAWN_FAILED -> internal {
        error : string
        kind : string
      }
        @description "Internal: os/spawn could not start the child."
        @tier "internal"
      CLI_OUT_CHUNK -> internal {
        data : bytes!
        eof : boolean!
      }
        @description "Internal: one os/read of the child's stdout."
        @tier "internal"
      CLI_ERR_CHUNK -> internal {
        data : bytes!
        eof : boolean!
      }
        @description "Internal: one os/read of the child's stderr."
        @tier "internal"
      CLI_EXITED -> internal {
        code : number
        signal : number
      }
        @description "Internal: the os/wait answer."
        @tier "internal"
      CLI_HOST_FAILED -> internal {
        error : string
      }
        @description "Internal: an os/read, os/close, os/kill or os/wait failed."
        @tier "internal"
    }

    config {
      commands : [CliCommand] = ["echo"]
        @label "Commands"
        @description "The executables to try, in order, each matched exactly against the exec grant of the program that composes this atom, e.g. [\"gh\"], [\"gcloud\"] or [{ anchor: { env: \"ORB_BUN_PATH\" } }, { anchor: \"exe-dir\", path: \"bun\" }, \"bun\"]. A candidate that is absent (not found, or an unset env anchor) is skipped for the next; any other start failure, or the end of the list, fails the run with cli_spawn_failed. The default, echo, is what the atom grants on its own."
        @synonyms "program, executable, binary, command candidates"
        @tier "domain"
      cwd : string = ""
        @label "Working directory"
        @description "The absolute directory the child runs in, covered by the composing program's fs read grant; empty runs it in the host's working directory."
        @synonyms "directory, folder"
        @tier "domain"
      stdio : string = "pipe"
        @label "Standard streams"
        @description "pipe (the default) captures the child's stdout and stderr and answers them in CLI_DONE; inherit hands the child this process's terminal on stdin, stdout and stderr, so a prompt and live output reach the user, CLI_DONE carries the exit code with empty stdout and stderr, and a run's stdin bytes are not written. inherit needs the stdio grant (in, out, err) in the composing program; any other word is not a mode and no child starts."
        @synonyms "terminal, tty, inherit terminal, interactive"
        @tier "domain"
      binaryOutput : boolean = false
        @label "Binary output"
        @description "The child writes bytes that are not UTF-8 text on stdout (an archive, an image): CLI_DONE then carries them in stdoutBytes only, with stdout empty. Off decodes stdout as text."
        @synonyms "raw output, bytes"
        @tier "domain"
      env : Map string string = {}
        @label "Environment"
        @description "Environment variables the child runs with, e.g. HOME or PATH. A run's own env replaces it; beyond it and passEnv the child inherits nothing."
        @synonyms "child environment, variables"
        @tier "domain"
      passEnv : [string] = []
        @label "Host variables passed through"
        @description "Names of host environment variables read with os/getenv before each run and added to the child's environment, e.g. PATH and HOME for a CLI that keeps its login under HOME. Each must be in the composing program's env grant; an unset one is left out, and one the run's env (or the env knob) also names keeps that value."
        @synonyms "inherit env, host environment, pass through variables"
        @tier "domain"
    }

    listens {
      CLI_RUN -> input {
        stage : string!
        argv : [string]!
        env : Map string string
        stdin : bytes
      }
        @description "Run the command once with these arguments; stage names the run in its answer, env, when given, replaces the env knob for this run, and stdin, when given, is written to the child and then closed."
        @synonyms "run command, execute, spawn"
      CLI_CANCEL -> input {
      }
        @description "Stop the running child with TERM; its exit is still answered with CLI_DONE."
        @synonyms "cancel, kill, stop"
      CLI_SPAWNED {
        pid : number!
        stdin : number
        stdout : number!
        stderr : number!
        key : string!
      }
        @description "The os/spawn success."
      CLI_STDIN_WRITTEN {
        bytes : number!
        key : string!
      }
        @description "The os/write success on stdin."
      CLI_STDIN_CLOSED {
        key : string!
      }
        @description "The os/close success on stdin."
      CLI_SPAWN_FAILED {
        error : string
        kind : string
        key : string!
      }
        @description "The os/spawn failure."
      CLI_OUT_CHUNK {
        data : bytes!
        eof : boolean!
        key : string!
      }
        @description "The os/read success on stdout."
      CLI_ERR_CHUNK {
        data : bytes!
        eof : boolean!
        key : string!
      }
        @description "The os/read success on stderr."
      CLI_EXITED {
        code : number
        signal : number
        key : string!
      }
        @description "The os/wait success."
      CLI_HOST_FAILED {
        error : string
        kind : string
        key : string!
      }
        @description "An os/read, os/close, os/kill or os/wait failure."
    }
  }

  page boot as CliOrbitalStart -> CliRunner
}
