app std-boot-env-check [
  version: "1.0.0",
  description: "std-boot-env-check — what keeps a deployment's declared environment from working in production, one line per problem. ENV_CHECK { requestId?, env, production, mock, missingCredentials?, catalogError? } answers ENV_CHECKED { requestId, problems, ok }. Auth problems first (unknown provider alone; auth emulator host set; firebase needs a project or service account path; demo- project; oidc needs issuer and audience), then under production a Firestore emulator host, then unless mocked each missing integration credential and an unreadable catalog. The host computes missingCredentials from the credential catalog."
]
uses Spec from "almadar-std/boot-env-check"
type BootEnv = { authProvider : string, oidcIssuerUrl : string, oidcAudience : string, firebaseProjectId : string, firebaseServiceAccountPath : string, firebaseAuthEmulatorHost : string, firestoreEmulatorHost : string, integrationsMock : boolean }
orbital BootEnvCheckOrbital {
  type ENV_CHECK = Event { requestId : number, env : BootEnv!, production : boolean!, mock : boolean!, missingCredentials : [string], catalogError : string } "Check one declared environment."

  entity EnvCheck [runtime] {
    id : string!
    problems : [string] @description "The problems found by the last check, in order." = []
  }

  trait BootEnvCheck -> EnvCheck [client] {
    initial: ready

    state ready {
      INIT -> ready

      ENV_CHECK -> ready
        (let ((e @payload.env) (provider (or @payload.env.authProvider "firebase")))
          (let ((auth (if (not (array/includes ["firebase", "oidc"] @provider))
                        [(str/concat "AUTH_PROVIDER must be one of firebase, oidc, got '" @provider "'")]
                        (array/concat
                          (if (!= (or @e.firebaseAuthEmulatorHost "") "") ["FIREBASE_AUTH_EMULATOR_HOST is set: the Auth emulator is for local dev only"] [])
                          (if (= @provider "firebase")
                            (array/concat
                              (if (and (= (or @e.firebaseProjectId "") "") (= (or @e.firebaseServiceAccountPath "") "")) ["AUTH_PROVIDER=firebase needs FIREBASE_PROJECT_ID (with FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY or application-default credentials) or FIREBASE_SERVICE_ACCOUNT_PATH"] [])
                              (if (str/startsWith (or @e.firebaseProjectId "") "demo-") [(str/concat "FIREBASE_PROJECT_ID=" @e.firebaseProjectId " is an emulator-only demo project")] []))
                            (array/concat
                              (if (= (or @e.oidcIssuerUrl "") "") ["AUTH_PROVIDER=oidc needs OIDC_ISSUER_URL"] [])
                              (if (= (or @e.oidcAudience "") "") ["AUTH_PROVIDER=oidc needs OIDC_AUDIENCE"] []))))))
                (fire (if (and @payload.production (!= (or @e.firestoreEmulatorHost "") "")) ["FIRESTORE_EMULATOR_HOST is set: the Firestore emulator is for local dev only"] []))
                (mocked (or @payload.mock (or @e.integrationsMock false))))
            (let ((creds (if @mocked [] (array/concat
                            (array/map (or @payload.missingCredentials []) (fn m (str/concat "missing required integration credential " @m)))
                            (if (!= (or @payload.catalogError "") "") [(str/concat "the declared integration credentials could not be read: " @payload.catalogError)] [])))))
              (let ((all (array/concat @auth @fire @creds)))
                (do
                  (set @entity.problems @all)
                  (emit ENV_CHECKED { requestId: (or @payload.requestId 0), problems: @all, ok: (= (array/len @all) 0) }))))))
    }

    emits {
      ENV_CHECKED -> external {
        requestId : number
        problems : [string]!
        ok : boolean!
      }
        @description "The environment was checked; problems lists each reason it cannot serve production."
        @synonyms "env checked, boot problems"
        @tier "primary"
    }

    listens {
      ENV_CHECK {
        requestId : number
        env : BootEnv!
        production : boolean!
        mock : boolean!
        missingCredentials : [string]
        catalogError : string
      }
        @description "Check one declared environment."
        @synonyms "check env, boot check"
    }
  }

  page boot as BootEnvCheckOrbitalStart -> BootEnvCheck
}
