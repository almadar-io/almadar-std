app std-fleet-cli [
  version: "1.0.0",
  inbound: ["cli-fleet"],
  env: ["HOME"],
  fs: { env HOME: ".almadar/fleet/**": [read] },
  description: "std-fleet-cli — a deploy command over std-deploy-host fleets: `orb <command> deploy [--target <name>] [--only <app>[,<app>…]] [--runtime]`. The apps knob lists every app the command deploys ({ name, program, site, staticDir, env, firestoreDatabase, origins, secrets }; an app's secrets map env names to files under secretDir, read at deploy time and laid into that app's env only, so its app.env holds them and no program does, std-deploy-host's FleetAppSpec), and the targets knob the places it deploys to ({ name, env, indexes, stackEnv }): a target's env is laid over each app's env (a target name wins), and a target with indexes false deploys no store indexes (an emulator needs none). FLEET_CALLED { rawBody } (the cli hook, `{ argv, cwd }`) parses the words with std-args; a first word other than deploy, an unknown flag, an unknown target or an --only name the apps knob does not list answers the usage or the error (status 400). Otherwise it emits FLEET_DEPLOY { target, apps, only } once, which the composer routes to the std-deploy-host of that target as DEPLOY_FLEET, and answers when that host's FLEET_DONE arrives: one line per app (`ok <app> release <n>` or `failed <app>: <step error>; …`), status 200 when every app is ok, else 500. With --runtime the target's runtime record ({ steps, context, stack }) is built first: FLEET_RUNTIME_BUILD runs its steps as sh -c through std-step-runner (the first step prints the image tag), FLEET_RUNTIME_DEPLOY then starts that image on the target (std-deploy-host DEPLOY_RUNTIME from context, stack and env: CORS_ORIGIN, every app's origins in apps order without duplicates joined with a comma, under the target's stackEnv, which wins on a shared key), and the apps deploy only once FLEET_RUNTIME_UP arrives; a failed step or a runtime that did not come up answers status 500 and deploys no app. A target's secrets ({ NAME: file }) are read from secretDir under HOME after the build and written with the stack env (a file that cannot be read fails the runtime, status 500); no secret is kept in the manifest. A target without a runtime record refuses --runtime (400). The target defaults to the defaultTarget knob. Two more words run previews on a target whose record declares preview ({ orb, stage, origin, server, env, stopSteps }): `preview <file> [--name <name>]` names the preview (--name, else the file name before its first dot; lower-case letters, digits and dashes, else 400), resolves the file and runs `<orb> compose --app-name preview-<name> --resolve <file> [<server>] -o <stage>/preview-<name>.orb` (an atom is wrapped into an app, and the preview record's server program, a std-http-server whose originFromEnv gives the web client its API origin, is composed in when no orbital of the file declares an http page; file and name reach the shell only as arguments), then deploys that program as the app preview-<name> with its web client on the hosting site of the same name and the env of the target, then of the preview record, then FIRESTORE_DATABASE_ID preview-<name> (each preview its own database), and answers the deploy lines plus `preview <origin with {name} replaced>`; `stop <name>` runs the preview record's stopSteps as sh -c with preview-<name> as $1 and answers `stopped preview-<name>`. A target with no preview record refuses both (400). One call at a time: a call while one runs answers status 409."
]
uses Args from "std/behaviors/std-args"

type FleetCommandArgs = { argv : [string]!, cwd : string! }
type FleetCliFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type FleetCliApp = { name : string!, program : string!, site : string, staticDir : string, env : Map string string, firestoreDatabase : string, origins : [string], secrets : Map string string? }
type FleetCliAppSecret = { app : string!, name : string!, file : string! }
type FleetCliRuntime = { steps : [string]!, context : string!, stack : string! }
type FleetCliPreview = { orb : string!, stage : string!, origin : string!, server : string!, env : Map string string, stopSteps : [string]! }
type FleetCliPreviewRun = { file : string!, app : string!, stage : string!, orb : string!, server : string! }
type FleetCliPage = { protocol : string }
type FleetCliOrbital = { pages : [FleetCliPage] }
type FleetCliProgram = { orbitals : [FleetCliOrbital] }
type FleetCliRead = { program : FleetCliProgram! }
type FleetCliTarget = { name : string!, env : Map string string, indexes : boolean!, runtime : FleetCliRuntime?, stackEnv : Map string string, preview : FleetCliPreview?, secrets : Map string string? }
type FleetCliSecret = { name : string!, file : string! }
type FleetCliDeploy = { target : string!, contextDir : string!, stackDir : string!, tag : string!, env : Map string string! }
type FleetCliStep = { scope : string!, args : [string]!, stdin : string!, feed : boolean!, tolerate : boolean!, raw : boolean! }
type FleetCliResult = { app : string!, version : number!, ok : boolean!, failures : [string]! }

orbital FleetCliOrbital {
  entity FleetCliRun [runtime] {
    id : string!
    busy : boolean = false
    target : string @description "The target of the call in flight." = ""
    only : [string] @description "The --only names of the call in flight." = []
    apps : [FleetCliApp] @description "The apps the call deploys once its runtime is up." = []
    link : string @description "The preview link the call in flight answers with once deployed." = ""
    stopping : string @description "The preview app the stop in flight removes." = ""
    preview : FleetCliPreviewRun? @description "The preview the call in flight composes." = null
    deploy : FleetCliDeploy? @description "The runtime deploy waiting for its secrets to be read." = null
    secretsLeft : [FleetCliSecret] @description "The target's secrets not read yet, in order." = []
    appSecretsLeft : [FleetCliAppSecret] @description "The apps' own secrets not read yet, in order." = []
    cwd : string @description "The working directory of the call in flight; a relative preview file is read from it." = ""
  }

  trait FleetArgs = Args.traits.ArgsParser {
    listens {
      FleetCli.FLEET_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait FleetCli -> FleetCliRun [optimistic] {
    initial: ready

    config {
      apps : [FleetCliApp] = []
        @label "Apps"
        @description "Every app the command deploys: its name, its program (a .lolo or .orb path from the directory the command runs in), its hosting site (empty: no web client), its static folder copied beside the client, the env it is opened with, its Firestore database (empty: no indexes) and its origins, the browser origins of its clients."
        @synonyms "fleet, app list, deployment manifest"
        @tier "domain"
      targets : [FleetCliTarget] = []
        @label "Targets"
        @description "The places the command deploys to by name, each with the env laid over every app's env there, whether store indexes are deployed there and the stackEnv lines written to the runtime stack's .env."
        @synonyms "environments, box, local"
        @tier "domain"
      secretDir : string = ".almadar/fleet/"
        @label "Secrets folder"
        @description "The folder under HOME, ending in /, holding the files a target's secrets name; each file's trimmed text is written into the runtime stack's .env under its name, so no secret is kept in the program."
        @tier "infra"
      defaultTarget : string = "local"
        @label "Default target"
        @description "The target used when --target is not given."
        @tier "domain"
    }

    state ready {
      INIT -> ready
      FLEET_CALLED -> ready when @entity.busy
        (emit FLEET_ANSWERED { status: 409, body: "error: a deploy is already running" })
      FLEET_CALLED -> ready when (not @entity.busy)
        (let ((args (json/parse @payload.rawBody FleetCommandArgs)))
          (if (= @args null)
            (emit FLEET_ANSWERED { status: 400, body: "error: malformed cli command arguments" })
            (do (set @entity.cwd (default (object/get @args "cwd") "")) (emit FLEET_ARGS_PARSE { stage: "fleet", argv: (object/get @args "argv"), flags: [{ name: "target", aliases: [], takesValue: true, repeatable: false }, { name: "only", aliases: [], takesValue: true, repeatable: true }, { name: "runtime", aliases: [], takesValue: false, repeatable: false }, { name: "name", aliases: [], takesValue: true, repeatable: false }] }))))
      FLEET_ARGS_DONE -> ready when (not (and (= (array/len @payload.errors) 0) (or (and (= (default (array/first @payload.positionals) "") "deploy") (= (array/len @payload.positionals) 1)) (and (array/includes ["preview", "stop"] (default (array/first @payload.positionals) "")) (= (array/len @payload.positionals) 2)))))
        (let ((targets (str/join (array/map @config.targets (fn t @t.name)) "|")))
          (emit FLEET_ANSWERED { status: 400, body: (str/concat (str/join (array/map @payload.errors (fn e (str/concat "error: " @e "\n"))) "") "usage: deploy [--target " @targets "] [--only <app>[,<app>…]] [--runtime]\n       preview <file> [--name <name>] [--target " @targets "]\n       stop <name> [--target " @targets "]") }))
      FLEET_ARGS_DONE -> ready when (and (= (array/len @payload.errors) 0) (array/includes ["preview", "stop"] (default (array/first @payload.positionals) "")) (= (array/len @payload.positionals) 2))
        (let ((verb (default (array/first @payload.positionals) ""))
              (arg (default (array/nth @payload.positionals 1) ""))
              (target (default (array/first (default (object/get @payload.flags "target") [])) @config.defaultTarget)))
          (let ((t (array/find @config.targets (fn x (= @x.name @target))))
                (name (if (= @verb "stop") @arg (default (array/first (default (object/get @payload.flags "name") [])) (default (array/first (str/split (default (array/last (str/split @arg "/")) "") ".")) "")))))
            (if (= @t null)
              (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: no target named " @target " (targets: " (str/join (array/map @config.targets (fn x @x.name)) ", ") ")") })
              (let ((pv (default @t.preview null)))
                (if (= @pv null)
                  (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: target " @target " declares no preview") })
                  (if (= (array/len (str/find-pattern @name "^[a-z0-9][a-z0-9-]*$")) 0)
                    (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: a preview name is lower-case letters, digits and dashes (got " @name "); pass --name") })
                    (let ((app (str/concat "preview-" @name)))
                      (do
                        (set @entity.busy true)
                        (set @entity.target @target)
                        (set @entity.only [])
                        (if (= @verb "stop")
                          (do
                            (set @entity.stopping @app)
                            (emit FLEET_RUNTIME_BUILD { requestId: (str/concat "stop-" @name), steps: (array/map @pv.stopSteps (fn x { scope: "root", args: ["-c", @x, "sh", @app], stdin: "", feed: false, tolerate: false, raw: false })), prefix: [], env: {}, rootDir: "", repoDir: "", dirFlag: "", rawInputs: [] }))
                          (do
                            (set @entity.link (str/replaceAll @pv.origin "{name}" @name))
                            (set @entity.apps [{ name: @app, program: (str/concat @pv.stage "/" @app ".orb"), site: @app, staticDir: "", env: (object/merge (object/merge (default @t.env {}) (default @pv.env {})) { FIRESTORE_DATABASE_ID: @app }), firestoreDatabase: "", origins: [] }])
                            (set @entity.preview { file: @arg, app: @app, stage: @pv.stage, orb: @pv.orb, server: @pv.server })
                            (program/read "" { resolve: true path: (if (str/startsWith @arg "/") @arg (str/concat @entity.cwd "/" @arg)) } { key: "preview" emit: { success: FLEET_PREVIEW_READ, failure: FLEET_PREVIEW_UNREAD } })))))))))))
      FLEET_ARGS_DONE -> ready when (and (= (array/len @payload.errors) 0) (= (default (array/first @payload.positionals) "") "deploy") (= (array/len @payload.positionals) 1))
        (let ((target (default (array/first (default (object/get @payload.flags "target") [])) @config.defaultTarget)) (only (array/filter (array/flatten (array/map (default (object/get @payload.flags "only") []) (fn o (str/split @o ",")))) (fn o (!= (str/trim @o) "")))))
          (let ((t (array/find @config.targets (fn x (= @x.name @target)))) (unknown (array/filter @only (fn o (not (array/some @config.apps (fn a (= @a.name @o))))))))
            (if (= @t null)
              (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: no target named " @target " (targets: " (str/join (array/map @config.targets (fn x @x.name)) ", ") ")") })
              (if (> (array/len @unknown) 0)
                (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: no app named " (str/join @unknown ", ") " (apps: " (str/join (array/map @config.apps (fn a @a.name)) ", ") ")") })
                (if (and (object/has @payload.flags "runtime") (= (default @t.runtime null) null))
                  (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: target " @target " declares no runtime build") })
                  (do
                    (set @entity.busy true)
                    (set @entity.target @target)
                    (set @entity.only @only)
                    (set @entity.apps (array/map @config.apps (fn a (object/merge @a { env: (object/merge (default @a.env {}) (default @t.env {})), firestoreDatabase: (if @t.indexes (default @a.firestoreDatabase "") "") }))))
                    (if (object/has @payload.flags "runtime")
                      (emit FLEET_RUNTIME_BUILD { requestId: (str/concat "runtime-" @target), steps: (array/map (default (object/get (default @t.runtime {}) "steps") []) (fn x { scope: "root", args: ["-c", @x], stdin: "", feed: false, tolerate: false, raw: false })), prefix: [], env: {}, rootDir: "", repoDir: "", dirFlag: "", rawInputs: [] })
                      (emit FLEET_APP_SECRETS_START {}))))))))
      FLEET_PREVIEW_READ -> ready when (!= @entity.preview null)
        (let ((pr (default @entity.preview { file: "", app: "", stage: "", orb: "", server: "" }))
              (served (array/some (default @payload.result.program.orbitals []) (fn o (array/some (default @o.pages []) (fn pg (= (default @pg.protocol "route") "http")))))))
          (emit FLEET_RUNTIME_BUILD { requestId: @pr.app, steps: [{ scope: "root", args: (if @served
            ["-c", "mkdir -p \"$3\" && \"$4\" compose --app-name \"$2\" --resolve \"$1\" -o \"$3/$2.orb\"", "sh", @pr.file, @pr.app, @pr.stage, @pr.orb]
            ["-c", "mkdir -p \"$3\" && \"$4\" compose --app-name \"$2\" --resolve \"$1\" \"$5\" -o \"$3/$2.orb\"", "sh", @pr.file, @pr.app, @pr.stage, @pr.orb, @pr.server]), stdin: "", feed: false, tolerate: false, raw: false }], prefix: [], env: {}, rootDir: "", repoDir: "", dirFlag: "", rawInputs: [] }))
      FLEET_PREVIEW_UNREAD -> ready
        (set @entity.busy false)
        (set @entity.link "")
        (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: cannot read " (default (object/get (default @entity.preview {}) "file") "") ": " (default ?error "")) })
        (set @entity.preview null)
      FLEET_RUNTIME_BUILT -> ready when (str/startsWith @payload.requestId "preview-")
        (emit FLEET_DEPLOY { target: @entity.target, only: [], apps: @entity.apps })
      FLEET_RUNTIME_BUILT -> ready when (str/startsWith @payload.requestId "stop-")
        (set @entity.busy false)
        (emit FLEET_ANSWERED { status: 200, body: (str/concat "stopped " @entity.stopping) })
        (set @entity.stopping "")
      FLEET_RUNTIME_BUILT -> ready when (not (or (str/startsWith @payload.requestId "preview-") (str/startsWith @payload.requestId "stop-")))
        (let ((t (array/find @config.targets (fn x (= @x.name @entity.target)))))
          (let ((origins (array/unique (array/flatten (array/map @config.apps (fn a (default @a.origins []))))))
                (secrets (array/map (object/entries (default (object/get (default @t {}) "secrets") {})) (fn e { name: (array/nth @e 0), file: (array/nth @e 1) }))))
            (let ((deploy : FleetCliDeploy { target: @entity.target, contextDir: (default (object/get (default (object/get (default @t {}) "runtime") {}) "context") ""), stackDir: (default (object/get (default (object/get (default @t {}) "runtime") {}) "stack") ""), tag: (str/trim (default (array/first @payload.outputs) "")), env: (object/merge (if (> (array/len @origins) 0) { CORS_ORIGIN: (str/join @origins ",") } {}) (default (object/get (default @t {}) "stackEnv") {})) }))
              (if (= (array/len @secrets) 0)
                (emit FLEET_RUNTIME_DEPLOY @deploy)
                (do
                  (set @entity.deploy @deploy)
                  (set @entity.secretsLeft @secrets)
                  (emit FLEET_SECRET_NEXT { left: (array/len @secrets) }))))))
      FLEET_SECRET_NEXT -> ready when (> (array/len @entity.secretsLeft) 0)
        (let ((next (default (array/first @entity.secretsLeft) { name: "", file: "" })))
          (os/read-file { anchor: { env: "HOME" }, path: (str/concat @config.secretDir @next.file) } { key: @next.name emit: { success: FLEET_SECRET_READ, failure: FLEET_SECRET_UNREAD } }))
      FLEET_SECRET_NEXT -> ready when (= (array/len @entity.secretsLeft) 0)
        (when (!= @entity.deploy null) (emit FLEET_RUNTIME_DEPLOY (default @entity.deploy { target: "", contextDir: "", stackDir: "", tag: "", env: {} })))
        (set @entity.deploy null)
      FLEET_SECRET_READ -> ready
        (let ((d (default @entity.deploy { target: "", contextDir: "", stackDir: "", tag: "", env: {} })))
          (do
            (set @entity.deploy (object/merge @d { env: (object/set @d.env (default ?key "") (str/trim (default (bytes/to-string ?data) ""))) }))
            (set @entity.secretsLeft (array/filter @entity.secretsLeft (fn x (!= @x.name (default ?key "")))))
            (emit FLEET_SECRET_NEXT { left: (- (array/len @entity.secretsLeft) 1) })))
      FLEET_SECRET_UNREAD -> ready
        (let ((s (array/find @entity.secretsLeft (fn x (= @x.name (default ?key ""))))))
          (do
            (set @entity.busy false)
            (set @entity.deploy null)
            (set @entity.secretsLeft [])
            (emit FLEET_ANSWERED { status: 500, body: (str/concat "failed runtime: secret " (default ?key "") " could not be read from " (default (object/get (default @s {}) "file") "") ": " (default ?error "")) })))
      FLEET_APP_SECRETS_START -> ready
        (let ((appSecrets (array/flatten (array/map (array/filter @entity.apps (fn a (or (= (array/len @entity.only) 0) (array/includes @entity.only @a.name)))) (fn a (array/map (object/entries (default @a.secrets {})) (fn e (let ((one : FleetCliAppSecret { app: @a.name, name: (default (array/nth @e 0) ""), file: (default (array/nth @e 1) "") })) @one))))))))
          (do
            (set @entity.appSecretsLeft @appSecrets)
            (emit FLEET_APP_SECRET_NEXT { left: (array/len @appSecrets) })))
      FLEET_APP_SECRET_NEXT -> ready when (> (array/len @entity.appSecretsLeft) 0)
        (let ((next (default (array/first @entity.appSecretsLeft) { app: "", name: "", file: "" })))
          (os/read-file { anchor: { env: "HOME" }, path: (str/concat @config.secretDir @next.file) } { key: (str/concat @next.app "|" @next.name) emit: { success: FLEET_APP_SECRET_READ, failure: FLEET_APP_SECRET_UNREAD } }))
      FLEET_APP_SECRET_NEXT -> ready when (= (array/len @entity.appSecretsLeft) 0)
        (emit FLEET_DEPLOY { target: @entity.target, only: @entity.only, apps: @entity.apps })
      FLEET_APP_SECRET_READ -> ready
        (let ((next (default (array/first @entity.appSecretsLeft) { app: "", name: "", file: "" })))
          (do
            (set @entity.apps (array/map @entity.apps (fn a (if (= @a.name @next.app) (object/merge @a { env: (object/set (default @a.env {}) @next.name (str/trim (default (bytes/to-string ?data) ""))) }) @a))))
            (set @entity.appSecretsLeft (array/drop @entity.appSecretsLeft 1))
            (emit FLEET_APP_SECRET_NEXT { left: (array/len (array/drop @entity.appSecretsLeft 1)) })))
      FLEET_APP_SECRET_UNREAD -> ready
        (let ((next (default (array/first @entity.appSecretsLeft) { app: "", name: "", file: "" })))
          (do
            (set @entity.busy false)
            (set @entity.appSecretsLeft [])
            (emit FLEET_ANSWERED { status: 500, body: (str/concat "failed " @next.app ": secret " @next.name " could not be read from " @next.file ": " (default ?error "")) })))
      FLEET_RUNTIME_BUILD_FAILED -> ready
        (set @entity.busy false)
        (set @entity.link "")
        (set @entity.stopping "")
        (emit FLEET_ANSWERED { status: 500, body: (str/concat "failed runtime build step " @payload.index ": " @payload.stderr) })
      FLEET_RUNTIME_UP -> ready
        (emit FLEET_APP_SECRETS_START {})
      FLEET_RUNTIME_DOWN -> ready
        (set @entity.busy false)
        (emit FLEET_ANSWERED { status: 500, body: (str/concat "failed runtime: " @payload.error) })
      FLEET_RESULTS -> ready
        (set @entity.busy false)
        (emit FLEET_ANSWERED { status: (if (array/every @payload.results (fn r @r.ok)) 200 500), body: (str/concat (str/join (array/map @payload.results (fn r (if @r.ok (str/concat "ok " @r.app " release " @r.version) (str/concat "failed " @r.app ": " (str/join @r.failures "; "))))) "\n") (if (and (!= @entity.link "") (array/every @payload.results (fn r @r.ok))) (str/concat "\npreview " @entity.link) "")) })
        (set @entity.link "")
    }

    emits {
      FLEET_ANSWERED -> internal { status : number!  body : string! }
        @tier "internal"
      FLEET_ARGS_PARSE -> external { stage : string!  argv : [string]!  flags : [FleetCliFlag]! }
        @tier "internal"
      FLEET_RUNTIME_BUILD -> external { requestId : string!  steps : [FleetCliStep]!  prefix : [string]!  env : Map string string  rootDir : string!  repoDir : string!  dirFlag : string!  rawInputs : [bytes]! }
        @description "Build the target's runtime context: its runtime steps, each run as sh -c, in order (std-step-runner's STEPS_RUN); the first step prints the image tag."
        @tier "primary"
      FLEET_APP_SECRETS_START -> internal { }
        @description "List the secrets the deployed apps name, then read them one by one; a runtime deploy starts it once the runtime is up."
        @tier "internal"
      FLEET_APP_SECRET_NEXT -> internal { left : number! }
        @description "Read the next secret an app names, or deploy the apps once none is left."
        @tier "internal"
      FLEET_SECRET_NEXT -> internal { left : number! }
        @description "Read the next secret of the runtime deploy, or deploy once none is left."
        @tier "internal"
      FLEET_RUNTIME_DEPLOY -> external { target : string!  contextDir : string!  stackDir : string!  tag : string!  env : Map string string }
        @description "Start the built runtime on the target; the composer routes it to that target's std-deploy-host as DEPLOY_RUNTIME and its RUNTIME_DEPLOYED back as FLEET_RUNTIME_UP, its RUNTIME_ROLLED_BACK or runtime DEPLOY_FAILED as FLEET_RUNTIME_DOWN."
        @tier "primary"
      FLEET_DEPLOY -> external { target : string!  apps : [FleetCliApp]!  only : [string]! }
        @description "Deploy these apps (or only those named) to the named target; the composer routes it to that target's std-deploy-host as DEPLOY_FLEET and its FLEET_DONE back as FLEET_RESULTS."
        @tier "primary"
    }

    listens {
      FLEET_CALLED -> inbound "cli-fleet" answers FLEET_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run the deploy command with its arguments and working directory."
        @synonyms "deploy command, orb deploy, ship apps"
      FLEET_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
        @tier "internal"
      FLEET_PREVIEW_READ { result : FleetCliRead!, key : string }
        @description "The previewed file, resolved: whether an orbital of it declares an http page decides whether the target's server program is composed with it."
        @tier "internal"
      FLEET_PREVIEW_UNREAD { error : string, key : string }
        @description "The previewed file could not be read or resolved."
        @tier "internal"
      FLEET_RESULTS {
        results : [FleetCliResult]!
      }
        @description "The target's std-deploy-host FLEET_DONE: per app, the release deployed and its failures."
        @tier "internal"
      FLEET_RUNTIME_BUILT { requestId : string!  outputs : [string]!  rawOuts : [bytes]!  codes : [number]!  failures : [string]! }
        @description "The runtime build steps all ran (std-step-runner's STEPS_DONE)."
        @tier "internal"
      FLEET_RUNTIME_BUILD_FAILED { requestId : string!  index : number!  code : string!  stderr : string!  stdout : string! }
        @description "A runtime build step failed (std-step-runner's STEPS_FAILED)."
        @tier "internal"
      FLEET_APP_SECRET_READ { data : bytes!, key : string }
        @description "An app's secret file read."
        @tier "internal"
      FLEET_APP_SECRET_UNREAD { error : string, kind : string, key : string }
        @description "An app's secret file could not be read."
        @tier "internal"
      FLEET_SECRET_READ { data : bytes!, key : string }
        @description "A secret file read."
        @tier "internal"
      FLEET_SECRET_UNREAD { error : string, kind : string, key : string }
        @description "A secret file could not be read."
        @tier "internal"
      FLEET_RUNTIME_UP { image : string! }
        @description "The target runs the new runtime image."
        @tier "internal"
      FLEET_RUNTIME_DOWN { error : string! }
        @description "The runtime did not come up (rolled back or failed)."
        @tier "internal"
      FleetArgs.ARGS_PARSED -> FLEET_ARGS_DONE
    }
  }

  page boot as FleetCliStart -> FleetCli, FleetArgs
}
