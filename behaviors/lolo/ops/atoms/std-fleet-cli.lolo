app std-fleet-cli [
  version: "1.0.0",
  inbound: ["cli-fleet"],
  description: "std-fleet-cli — a deploy command over std-deploy-host fleets: `orb <command> deploy [--target <name>] [--only <app>[,<app>…]] [--runtime]`. The apps knob lists every app the command deploys ({ name, program, site, staticDir, env, firestoreDatabase, origins }, std-deploy-host's FleetAppSpec), and the targets knob the places it deploys to ({ name, env, indexes, stackEnv }): a target's env is laid over each app's env (a target name wins), and a target with indexes false deploys no store indexes (an emulator needs none). FLEET_CALLED { rawBody } (the cli hook, `{ argv, cwd }`) parses the words with std-args; a first word other than deploy, an unknown flag, an unknown target or an --only name the apps knob does not list answers the usage or the error (status 400). Otherwise it emits FLEET_DEPLOY { target, apps, only } once, which the composer routes to the std-deploy-host of that target as DEPLOY_FLEET, and answers when that host's FLEET_DONE arrives: one line per app (`ok <app> release <n>` or `failed <app>: <step error>; …`), status 200 when every app is ok, else 500. With --runtime the target's runtime record ({ steps, context, stack }) is built first: FLEET_RUNTIME_BUILD runs its steps as sh -c through std-step-runner (the first step prints the image tag), FLEET_RUNTIME_DEPLOY then starts that image on the target (std-deploy-host DEPLOY_RUNTIME from context, stack and env: CORS_ORIGIN, every app's origins in apps order without duplicates joined with a comma, under the target's stackEnv, which wins on a shared key), and the apps deploy only once FLEET_RUNTIME_UP arrives; a failed step or a runtime that did not come up answers status 500 and deploys no app. A target without a runtime record refuses --runtime (400). The target defaults to the defaultTarget knob. One call at a time: a call while one runs answers status 409."
]
uses Args from "std/behaviors/std-args"

type FleetCommandArgs = { argv : [string]!, cwd : string! }
type FleetCliFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type FleetCliApp = { name : string!, program : string!, site : string, staticDir : string, env : Map string string, firestoreDatabase : string, origins : [string] }
type FleetCliRuntime = { steps : [string]!, context : string!, stack : string! }
type FleetCliTarget = { name : string!, env : Map string string, indexes : boolean!, runtime : FleetCliRuntime?, stackEnv : Map string string }
type FleetCliStep = { scope : string!, args : [string]!, stdin : string!, feed : boolean!, tolerate : boolean!, raw : boolean! }
type FleetCliResult = { app : string!, version : number!, ok : boolean!, failures : [string]! }

orbital FleetCliOrbital {
  entity FleetCliRun [runtime] {
    id : string!
    busy : boolean = false
    target : string @description "The target of the call in flight." = ""
    only : [string] @description "The --only names of the call in flight." = []
    apps : [FleetCliApp] @description "The apps the call deploys once its runtime is up." = []
  }

  trait FleetArgs = Args.traits.ArgsParser {
    listens {
      FleetCli.FLEET_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait FleetCli -> FleetCliRun [optimistic] {
    initial: ready

    config {
      apps : [FleetCliApp] = []
        @label "Apps"
        @description "Every app the command deploys: its name, its program (a .lolo or .orb path from the directory the command runs in), its hosting site (empty: no web client), its static folder copied beside the client, the env it is opened with, its Firestore database (empty: no indexes) and its origins, the browser origins of its clients."
        @synonyms "fleet, app list, deployment manifest"
        @tier "domain"
      targets : [FleetCliTarget] = []
        @label "Targets"
        @description "The places the command deploys to by name, each with the env laid over every app's env there, whether store indexes are deployed there and the stackEnv lines written to the runtime stack's .env."
        @synonyms "environments, box, local"
        @tier "domain"
      defaultTarget : string = "local"
        @label "Default target"
        @description "The target used when --target is not given."
        @tier "domain"
    }

    state ready {
      INIT -> ready
      FLEET_CALLED -> ready when @entity.busy
        (emit FLEET_ANSWERED { status: 409, body: "error: a deploy is already running" })
      FLEET_CALLED -> ready when (not @entity.busy)
        (let ((args (json/parse @payload.rawBody FleetCommandArgs)))
          (if (= @args null)
            (emit FLEET_ANSWERED { status: 400, body: "error: malformed cli command arguments" })
            (emit FLEET_ARGS_PARSE { stage: "fleet", argv: (object/get @args "argv"), flags: [{ name: "target", aliases: [], takesValue: true, repeatable: false }, { name: "only", aliases: [], takesValue: true, repeatable: true }, { name: "runtime", aliases: [], takesValue: false, repeatable: false }] })))
      FLEET_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (!= (default (array/first @payload.positionals) "") "deploy") (> (array/len @payload.positionals) 1))
        (emit FLEET_ANSWERED { status: 400, body: (str/concat (str/join (array/map @payload.errors (fn e (str/concat "error: " @e "\n"))) "") "usage: deploy [--target " (str/join (array/map @config.targets (fn t @t.name)) "|") "] [--only <app>[,<app>…]] [--runtime]") })
      FLEET_ARGS_DONE -> ready when (and (= (array/len @payload.errors) 0) (= (default (array/first @payload.positionals) "") "deploy") (= (array/len @payload.positionals) 1))
        (let ((target (default (array/first (default (object/get @payload.flags "target") [])) @config.defaultTarget)) (only (array/filter (array/flatten (array/map (default (object/get @payload.flags "only") []) (fn o (str/split @o ",")))) (fn o (!= (str/trim @o) "")))))
          (let ((t (array/find @config.targets (fn x (= @x.name @target)))) (unknown (array/filter @only (fn o (not (array/some @config.apps (fn a (= @a.name @o))))))))
            (if (= @t null)
              (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: no target named " @target " (targets: " (str/join (array/map @config.targets (fn x @x.name)) ", ") ")") })
              (if (> (array/len @unknown) 0)
                (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: no app named " (str/join @unknown ", ") " (apps: " (str/join (array/map @config.apps (fn a @a.name)) ", ") ")") })
                (if (and (object/has @payload.flags "runtime") (= (default @t.runtime null) null))
                  (emit FLEET_ANSWERED { status: 400, body: (str/concat "error: target " @target " declares no runtime build") })
                  (do
                    (set @entity.busy true)
                    (set @entity.target @target)
                    (set @entity.only @only)
                    (set @entity.apps (array/map @config.apps (fn a (object/merge @a { env: (object/merge (default @a.env {}) (default @t.env {})), firestoreDatabase: (if @t.indexes (default @a.firestoreDatabase "") "") }))))
                    (if (object/has @payload.flags "runtime")
                      (emit FLEET_RUNTIME_BUILD { requestId: (str/concat "runtime-" @target), steps: (array/map (default (object/get (default @t.runtime {}) "steps") []) (fn x { scope: "root", args: ["-c", @x], stdin: "", feed: false, tolerate: false, raw: false })), prefix: [], env: {}, rootDir: "", repoDir: "", dirFlag: "", rawInputs: [] })
                      (emit FLEET_DEPLOY { target: @target, only: @only, apps: (array/map @config.apps (fn a (object/merge @a { env: (object/merge (default @a.env {}) (default @t.env {})), firestoreDatabase: (if @t.indexes (default @a.firestoreDatabase "") "") }))) }))))))))
      FLEET_RUNTIME_BUILT -> ready
        (let ((t (array/find @config.targets (fn x (= @x.name @entity.target)))))
          (let ((origins (array/unique (array/flatten (array/map @config.apps (fn a (default @a.origins [])))))))
            (emit FLEET_RUNTIME_DEPLOY { env: (object/merge (if (> (array/len @origins) 0) { CORS_ORIGIN: (str/join @origins ",") } {}) (default (object/get (default @t {}) "stackEnv") {})), target: @entity.target, contextDir: (default (object/get (default (object/get (default @t {}) "runtime") {}) "context") ""), stackDir: (default (object/get (default (object/get (default @t {}) "runtime") {}) "stack") ""), tag: (str/trim (default (array/first @payload.outputs) "")) })))
      FLEET_RUNTIME_BUILD_FAILED -> ready
        (set @entity.busy false)
        (emit FLEET_ANSWERED { status: 500, body: (str/concat "failed runtime build step " @payload.index ": " @payload.stderr) })
      FLEET_RUNTIME_UP -> ready
        (emit FLEET_DEPLOY { target: @entity.target, only: @entity.only, apps: @entity.apps })
      FLEET_RUNTIME_DOWN -> ready
        (set @entity.busy false)
        (emit FLEET_ANSWERED { status: 500, body: (str/concat "failed runtime: " @payload.error) })
      FLEET_RESULTS -> ready
        (set @entity.busy false)
        (emit FLEET_ANSWERED { status: (if (array/every @payload.results (fn r @r.ok)) 200 500), body: (str/join (array/map @payload.results (fn r (if @r.ok (str/concat "ok " @r.app " release " @r.version) (str/concat "failed " @r.app ": " (str/join @r.failures "; "))))) "\n") })
    }

    emits {
      FLEET_ANSWERED -> internal { status : number!  body : string! }
        @tier "internal"
      FLEET_ARGS_PARSE -> external { stage : string!  argv : [string]!  flags : [FleetCliFlag]! }
        @tier "internal"
      FLEET_RUNTIME_BUILD -> external { requestId : string!  steps : [FleetCliStep]!  prefix : [string]!  env : Map string string  rootDir : string!  repoDir : string!  dirFlag : string!  rawInputs : [bytes]! }
        @description "Build the target's runtime context: its runtime steps, each run as sh -c, in order (std-step-runner's STEPS_RUN); the first step prints the image tag."
        @tier "primary"
      FLEET_RUNTIME_DEPLOY -> external { target : string!  contextDir : string!  stackDir : string!  tag : string!  env : Map string string }
        @description "Start the built runtime on the target; the composer routes it to that target's std-deploy-host as DEPLOY_RUNTIME and its RUNTIME_DEPLOYED back as FLEET_RUNTIME_UP, its RUNTIME_ROLLED_BACK or runtime DEPLOY_FAILED as FLEET_RUNTIME_DOWN."
        @tier "primary"
      FLEET_DEPLOY -> external { target : string!  apps : [FleetCliApp]!  only : [string]! }
        @description "Deploy these apps (or only those named) to the named target; the composer routes it to that target's std-deploy-host as DEPLOY_FLEET and its FLEET_DONE back as FLEET_RESULTS."
        @tier "primary"
    }

    listens {
      FLEET_CALLED -> inbound "cli-fleet" answers FLEET_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run the deploy command with its arguments and working directory."
        @synonyms "deploy command, orb deploy, ship apps"
      FLEET_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
        @tier "internal"
      FLEET_RESULTS {
        results : [FleetCliResult]!
      }
        @description "The target's std-deploy-host FLEET_DONE: per app, the release deployed and its failures."
        @tier "internal"
      FLEET_RUNTIME_BUILT { requestId : string!  outputs : [string]!  rawOuts : [bytes]!  codes : [number]!  failures : [string]! }
        @description "The runtime build steps all ran (std-step-runner's STEPS_DONE)."
        @tier "internal"
      FLEET_RUNTIME_BUILD_FAILED { requestId : string!  index : number!  code : string!  stderr : string!  stdout : string! }
        @description "A runtime build step failed (std-step-runner's STEPS_FAILED)."
        @tier "internal"
      FLEET_RUNTIME_UP { image : string! }
        @description "The target runs the new runtime image."
        @tier "internal"
      FLEET_RUNTIME_DOWN { error : string! }
        @description "The runtime did not come up (rolled back or failed)."
        @tier "internal"
      FleetArgs.ARGS_PARSED -> FLEET_ARGS_DONE
    }
  }

  page boot as FleetCliStart -> FleetCli, FleetArgs
}
