app rsa-spec [
  version: "1.0.0",
  description: "Design contract for verifying an RSASSA-PKCS1-v1_5 signature with SHA-256 (RFC 8017 section 8.2.2, what JWS RS256 needs). RSA_VERIFY { n, e, message, signature } takes the modulus and public exponent as big-endian padded base64 bytes, the message as text (hashed as its UTF-8 bytes), and the signature as bytes. It answers RSA_VERIFIED { valid } or RSA_REFUSED { reason }, reason key-size (modulus under 2048 bits, with a leading zero byte, or an exponent empty or not shorter than the modulus), signature-length (not the modulus length), signature-range (signature not below the modulus) or bigint (std-bigint refused). valid is exact byte equality of s^e mod n, left-padded to the modulus length, with the whole encoded message 00 01 FF..FF 00 DigestInfo(SHA-256) hash, never a parse. Signing and PSS are out of scope. Golden vectors (openssl, 2048-bit, e 65537): the signature of its key verifies true; one changed message byte, one flipped signature bit and another key's modulus verify false; a 255-byte signature refuses signature-length, the modulus itself as signature refuses signature-range, a 1024-bit modulus refuses key-size."
]

orbital RsaSpec {
  expects entity RsaRun [runtime] {
    id : string!
  }
  expects trait RsaVerifier {
    state idle {
      RSA_VERIFY -> idle
    }
    emits {
      RSA_VERIFIED { valid : boolean! }
      RSA_REFUSED { reason : string! }
    }
  }
  expects page "/rsa" -> RsaVerifier
}
