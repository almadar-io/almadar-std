{
 "atom": "auth/atoms/std-identity-binding.lolo",
 "trait": "IdentityBinder",
 "note": "The one owner of a sign-in (docs/Almadar_Orbital_Core.md §11): an ask is verified in the program session and its outcome matched by the session the sign-in or sign-out names.",
 "cases": [
  {
   "id": "an ask naming no session and carrying no header is anonymous",
   "config": {
    "createIdentity": true,
    "identityEntity": "Identity"
   },
   "steps": [
    {
     "event": "BEARER_PRESENT",
     "payload": {
      "requestId": 7,
      "authorization": "",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "IDENTITY_ANONYMOUS",
        "payload": {
         "requestId": 7
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "CONTROL an ask naming no session but carrying a header is refused no-client-session",
   "config": {
    "createIdentity": true,
    "identityEntity": "Identity"
   },
   "steps": [
    {
     "event": "BEARER_PRESENT",
     "payload": {
      "requestId": 7,
      "authorization": "Bearer a.b.c",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "IDENTITY_REFUSED",
        "payload": {
         "requestId": 7,
         "reason": "no-client-session"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an ask naming a session is verified in the program session",
   "config": {
    "createIdentity": true,
    "identityEntity": "Identity"
   },
   "steps": [
    {
     "event": "BEARER_PRESENT",
     "payload": {
      "requestId": 7,
      "authorization": "Bearer a.b.c",
      "clientId": "tab-1"
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "BEARER_VERIFY",
        "payload": {
         "requestId": 7,
         "authorization": "Bearer a.b.c"
        }
       }
      ],
      "entity": {
       "asks": [
        {
         "requestId": 7,
         "session": "tab-1",
         "self": false,
         "authorization": "Bearer a.b.c",
         "stage": "verifying",
         "reason": "",
         "subject": "",
         "email": "",
         "name": "",
         "created": false
        }
       ]
      }
     }
    }
   ]
  },
