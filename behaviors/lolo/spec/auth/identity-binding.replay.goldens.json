    {
     "event": "BEARER_PRESENT",
     "payload": {
      "requestId": 7,
      "authorization": "",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "IDENTITY_ANONYMOUS",
