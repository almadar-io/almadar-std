   "id": "G-STD-389: a late verdict takes its own presented request, not the newest one",
   "config": {
    "ownOrbital": "HttpServerOrbital",
    "ownTrait": "ServerBinding",
    "createIdentity": true,
    "identityEntity": "Identity"
   },
   "entity": {
    "presented": [
     {
      "requestId": 7,
      "clientId": "tab-1",
      "authorization": "Bearer a.b.c",
      "created": false,
      "deferred": true
     },
     {
      "requestId": 8,
      "clientId": "tab-1",
      "authorization": "Bearer a.b.c",
      "created": false,
      "deferred": true
     }
    ]
   },
   "steps": [
    {
     "event": "REFUSED_SEEN",
     "payload": {
      "requestId": 7,
      "reason": "expired"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "CREDENTIAL_REFUSED",
        "payload": {
         "requestId": 7,
         "reason": "expired"
        }
       },
       {
        "event": "SETTLE_REPORT",
        "payload": {
         "requestId": 7,
         "outcome": "refused",
         "reason": "expired",
         "deferred": true
        }
       }
      ],
      "entity": {
       "requestId": 7,
       "presented": [
        {
         "requestId": 8,
         "clientId": "tab-1",
         "authorization": "Bearer a.b.c",
         "created": false,
         "deferred": true
        }
       ]
      }
     }
    }
   ]
  },
