app bearer-verify-spec [
  version: "2.0.0",
  description: "Design contract for verifying a sign-in bearer (Firebase ID token or generic OIDC) into a Viewer, over std-jws. BEARER_VERIFY { requestId?, authorization? } carries the raw Authorization header. No header (absent or blank) answers BEARER_ANONYMOUS, never an implicit viewer. A header that is not 'Bearer <token>' (scheme compared case-insensitively) or whose token is not three dot-separated segments refuses malformed. Keys come from the jwksOrigin and jwksPath knobs (OIDC jwks_uri; Firebase https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com), fetched with an http GET to a declared egress origin, kept in the entity until now + the response's Cache-Control max-age (no max-age keeps nothing); a stale cache refetches, and a kid absent from a fresh cache refetches once; a failing or non-200 fetch refuses keys-unavailable. The header kid selects the key; with no kid every key of use sig (or no use) is tried in order, one JWS_VERIFY per key, never the same question twice in one dispatch; a kid with no matching key after the refetch refuses unknown-key. A std-jws refusal other than signature, key-type, alg-mismatch, curve or key-missing ends the dispatch with its reason (alg-not-allowed reported as algorithm); those five move to the next key when there is one. Claim policy on JWS_VERIFIED against now in epoch seconds with knobs issuer, audience, clockSkewSeconds, requireAuthTime, allowedTenants: exp absent refuses malformed, exp <= now - skew expired, nbf > now + skew not-yet-valid, iat > now + skew issued-in-future, iss != issuer issuer, aud (string equal or list containing) != audience audience, empty sub subject, requireAuthTime with auth_time absent or > now auth-time, allowedTenants set and firebase.tenant not in it tenant. Every answer carries the requestId it was asked with (one bearer is in flight at a time). Overlapping requests queue first-in first-out in the entity (queue accepted in every state, one in flight, BEARER_PUMP starts the oldest on every completion); one beyond maxQueue is refused busy; each is answered exactly once, in order. A role claim must be a string and a permissions claim a list of strings (else refused claims); they become the viewer's role and permissions and every other claim stays in claims. Success is BEARER_VERIFIED { viewer }: id the sub, email, name, role and permissions when present, claims every remaining payload entry as { name, value } with the claim JSON as is."
]

orbital BearerVerifySpec {
  expects entity BearerCheck [runtime] {
    id : string!
  }
  expects trait BearerVerifier {
    state idle {
      BEARER_VERIFY -> idle
      API_KEY_VERIFIED -> idle
      API_KEY_REFUSED -> idle
      BEARER_PUMP -> verifying
    }
    state fetching {
      BEARER_VERIFY -> fetching
      JWKS_REPLIED -> idle
    }
    state verifying {
      BEARER_VERIFY -> verifying
      JWS_VERIFIED -> idle
    }
    emits {
      BEARER_VERIFIED { requestId : number  viewer : Viewer! }
      BEARER_ANONYMOUS { requestId : number }
      BEARER_REFUSED { requestId : number  reason : string! }
    }
  }
  expects page boot -> BearerVerifier
}
