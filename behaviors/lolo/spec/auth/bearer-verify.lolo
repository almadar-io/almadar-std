app bearer-verify-spec [
  version: "2.0.0",
  description: "Design contract for verifying a sign-in bearer (Firebase ID token or generic OIDC) into a sealed Verified, through the native jws/verify operator. BEARER_VERIFY { requestId?, authorization? } carries the raw Authorization header. No header (absent or blank) answers BEARER_ANONYMOUS, never an implicit viewer. A header that is not Bearer <token> or whose token is not three dot-separated segments refuses malformed. Keys come from the jwksPath knob (OIDC jwks_uri; Firebase securetoken JWK endpoint or x509 certificates), fetched with an http GET to a declared egress origin, kept in the entity until now + the response Cache-Control max-age (no max-age keeps nothing); a stale cache refetches, and a kid absent from a fresh cache refetches once; a failing or non-200 fetch refuses keys-unavailable; a kid with no matching key after the refetch refuses unknown-key. jws/verify checks the signature, exp, nbf, iss, aud and sub against the issuer, audience and clockSkewSeconds knobs and answers a Verified or a failure kind (malformed, algorithm, key, signature, claim, expired, not-yet-valid, issuer, audience), which is the refusal reason. The claim policy then reads Verified.claims: iat in the future refuses issued-in-future, requireAuthTime with auth_time absent or in the future refuses auth-time, allowedTenants set and firebase.tenant not in it refuses tenant. Every answer carries the requestId it was asked with (one bearer is in flight at a time); overlapping requests queue first-in first-out (one beyond maxQueue is refused busy). Success is BEARER_VERIFIED { requestId, verified }; no claim is read as the role."
]

orbital BearerVerifySpec {
  expects entity BearerCheck [runtime] {
    id : string!
  }
  expects trait BearerVerifier {
    state idle {
      BEARER_VERIFY -> idle
      API_KEY_VERIFIED -> idle
      API_KEY_REFUSED -> idle
      BEARER_PUMP -> verifying
      TOKEN_VERIFIED -> idle
    }
    state fetching {
      BEARER_VERIFY -> fetching
      JWKS_REPLIED -> idle
    }
    state verifying {
      BEARER_VERIFY -> verifying
      BEARER_CHECK -> idle
    }
    emits {
      BEARER_VERIFIED { requestId : number  verified : Verified! }
      BEARER_ANONYMOUS { requestId : number }
      BEARER_REFUSED { requestId : number  reason : string! }
    }
  }
  expects page boot -> BearerVerifier
}
