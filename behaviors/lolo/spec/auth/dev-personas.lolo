app dev-personas-spec [
  version: "1.0.0",
  description: "Design contract for signing in as a development persona: the app's identity rows listed at the inbound hook personas, and one of them signed in at persona-sign-in as a real Auth-emulator user (uid = row id, display name = its name, every other non-null field but email a custom claim) answered with an unsigned custom token the emulator accepts. Both hooks answer 404 unless FIREBASE_AUTH_EMULATOR_HOST names the local Auth emulator, so a deployment never lists or signs in personas. With the autoSignIn knob set (a persona id) and FIREBASE_AUTH_EMULATOR_HOST equal to the emulator host, a new session signs in as that persona at its start: its unsigned emulator custom token goes through jws/verify (allowUnsigned, the emulator issuer) and identity/sign-in. TOKEN_SIGN_IN_REQUESTED { token } signs a session in with a token a persona sign-in answered, the path the dev persona picker uses; both answer PERSONA_SIGNED_IN { subject } or PERSONA_SIGN_IN_REFUSED { error, kind }."
]

orbital DevPersonasSpec {
  expects entity DevPersona {
    id : string!
    name : string
    email : email
  }
  expects trait DevPersonas {
    state ready {
      PERSONAS_ROWS -> ready
      SIGN_IN_CALLED -> ready
      SIGN_IN_ROW -> ready
      SIGN_IN_ROW_MISSED -> ready
      SIGN_IN_UPDATED -> ready
    }
    emits {
      PERSONAS_ANSWERED { status : number!  body : string! }
      PERSONA_SIGN_IN_ANSWERED { status : number!  body : string! }
      PERSONA_SIGNED_IN { subject : string }
      PERSONA_SIGN_IN_REFUSED { error : string  kind : string }
      SIGN_IN_ROW_MISSED { error : string!  code : string }
    }
  }
  expects page boot -> DevPersonas
}
