{
 "source": "openssl genrsa 2048 + openssl dgst -sha256 -sign over the text 'header.payload' (RSASSA-PKCS1-v1_5 SHA-256)",
 "spec": "spec/auth/rsa.lolo",
 "atom": "auth/atoms/std-rsa.lolo",
 "trait": "RsaVerifier",
 "cases": [
  {
   "id": "a real signature over the message verifies",
   "steps": [
    {
     "event": "RSA_VERIFY",
     "payload": {
      "n": "",
      "e": "AQAB",
      "message": "header.payload",
      "signature": ""
     },
     "expect": {
      "emits": [
       {
        "event": "RSA_VERIFIED",
        "payload": {
         "valid": true
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "CONTROL the same signature with its last bit flipped does not verify",
   "steps": [
    {
     "event": "RSA_VERIFY",
     "payload": {
      "n": "",
      "e": "AQAB",
      "message": "header.payload",
      "signature": ""
     },
     "expect": {
      "emits": [
       {
        "event": "RSA_VERIFIED",
        "payload": {
         "valid": false
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
