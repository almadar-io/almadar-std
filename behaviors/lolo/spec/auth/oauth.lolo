app oauth-spec [
  version: "1.0.0",
  description: "Design contract for the OAuth 2 / OIDC authorization-code flow with PKCE (google, github, auth0) on the host credential store. The orbital serves one provider, the provider config knob; no action payload carries a provider. OAUTH_AUTHORIZE { scopes, redirectUri, subject? } answers OAUTH_AUTHORIZED { authUrl, state, code } or OAUTH_AUTHORIZE_ERROR. The authorization endpoint comes from the issuer discovery document (GET <issuer>/.well-known/openid-configuration through std-http-client, https only, the advertised issuer equal to the expected one) or, for github without an issuerUrl, the static github.com endpoints. The URL is built in .lolo: the extra params first (google adds access_type offline, prompt consent), then redirect_uri, scope joined by one space, state, code_challenge = base64url(SHA-256(verifier)), code_challenge_method S256, client_id and response_type code. State and verifier are drawn from one 64-byte host draw (43 base64url characters each). The pending grant (provider, redirectUri, verifier, subject, scopes, endpoints, expiry) is an owner-scoped OAuthGrant row keyed by state. OAUTH_CONNECT { code, state } takes the grant once (unknown, expired, a different provider or a different subject each fail with OAUTH_CONNECT_ERROR) and asks the host credential store to exchange the code (credential-connect, grant authorization_code, scope user): the store holds the tokens, so no token, verifier or vendor body ever reaches program state, an event or the journal. A host whose store cannot connect answers unavailable, which is OAUTH_CONNECT_ERROR code NOT_CONFIGURED. After a connect the userinfo endpoint (when the provider has one) fills the account and avatar of the owner-scoped OAuthConnection row, which also keeps the scopes, connectedAt and the endpoints. OAUTH_CONNECTED { provider, connected, account, avatarUrl, scope, connectedAt } answers. OAUTH_REFRESH asks the store to refresh the held credential and answers OAUTH_REFRESHED { connected }. OAUTH_USERINFO sends a Bearer GET to the userinfo endpoint with the viewer's held credential as a user-scoped secret segment and answers OAUTH_USERINFO_RESULT { sub, email, name, picture }. OAUTH_REVOKE POSTs the held credential as the token form field to the revocation endpoint and answers OAUTH_REVOKED { revoked }. github without an issuerUrl has only the static authorize and token endpoints, so its revoke and userinfo answer an error naming the missing endpoint, and auth0 without an issuerUrl answers an error naming the missing issuer. OAUTH_CONNECTION reads the viewer's credential status and OAuthConnection row and answers OAUTH_CONNECTION_RESULT; OAUTH_DISCONNECT drops the credential and the row and answers OAUTH_DISCONNECTED. Every failure answers OAUTH_<ACTION>_ERROR { code, message } and carries no token, verifier or vendor body."
]

orbital OAuthSpec {
  expects entity OAuthFlow [runtime] {
    id : string!
  }
  expects trait OAuthClient {
    state idle {
      INIT -> idle
      OAUTH_AUTHORIZE -> idle
      OAUTH_REFRESH -> idle
      OAUTH_REVOKE -> idle
      OAUTH_USERINFO -> idle
      OAUTH_CONNECT -> idle
      OAUTH_CONNECTION -> idle
      OAUTH_DISCONNECT -> idle
    }
    emits {
      OAUTH_AUTHORIZED { authUrl : string!  state : string!  code : string! }
      OAUTH_REFRESHED { connected : boolean! }
      OAUTH_REVOKED { revoked : boolean! }
      OAUTH_USERINFO_RESULT { sub : string!  email : string!  name : string!  picture : string! }
      OAUTH_CONNECTED { provider : string!  connected : boolean!  account : string!  avatarUrl : string!  scope : [string]  connectedAt : string! }
      OAUTH_CONNECTION_RESULT { provider : string!  connected : boolean!  account : string!  avatarUrl : string!  scope : [string]  connectedAt : string! }
      OAUTH_DISCONNECTED { provider : string!  connected : boolean!  account : string!  avatarUrl : string!  scope : [string]  connectedAt : string! }
      OAUTH_AUTHORIZE_ERROR { code : string  message : string! }
      OAUTH_REFRESH_ERROR { code : string  message : string! }
      OAUTH_REVOKE_ERROR { code : string  message : string! }
      OAUTH_USERINFO_ERROR { code : string  message : string! }
      OAUTH_CONNECT_ERROR { code : string  message : string! }
      OAUTH_CONNECTION_ERROR { code : string  message : string! }
      OAUTH_DISCONNECT_ERROR { code : string  message : string! }
    }
  }
  expects config { provider : "google" | "github" | "auth0" = "google"  clientAuth : "secret" | "basic" | "none" = "secret"  redirectUri : string = ""  issuerUrl : string = "" }
  expects page boot -> OAuthClient
}
