{
 "atom": "spec/auth/dev-personas-identity.lolo",
 "trait": "Acting",
 "note": "PERSONA_ACT_AS over a runtime [identity] entity: the dispatching session signs in as the persona (the next step reads it as @user); a session that never acted stays the anonymous viewer.",
 "cases": [
  {
   "id": "act-as-signs-the-session-in-with-subject-the-persona",
   "steps": [
    {
     "trait": "Acting",
     "from": "ready",
     "event": "PERSONA_ACT_AS",
     "payload": {
      "persona": "ada"
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "PERSONA_SIGNED_IN",
       "PERSONA_SIGN_IN_REFUSED"
      ]
     }
    },
    {
     "trait": "Acting",
     "from": "ready",
     "event": "ACT_AS_HOST",
     "payload": {
      "value": "127.0.0.1:9099",
      "key": "ada"
     },
     "expect": {
      "emits": [
       {
        "event": "TOKEN_MINT",
        "payload": {
         "key": "ada",
         "purpose": "sign-in"
        }
       },
       {
        "event": "PERSONA_SIGNED_IN",
        "payload": {
         "subject": "ada"
        }
       }
      ],
      "neverEmits": [
       "PERSONA_SIGN_IN_REFUSED"
      ],
      "fired": true
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "ada",
         "role": "member"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-second-session-that-never-acted-has-no-identity",
   "steps": [
    {
     "trait": "Acting",
     "from": "ready",
     "event": "PERSONAS_HOST",
     "payload": {
      "value": ""
     },
     "expect": {
      "fired": true
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "anonymous",
         "role": "anonymous"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "act-as-another-persona-binds-that-subject",
   "steps": [
    {
     "trait": "Acting",
     "from": "ready",
     "event": "PERSONA_ACT_AS",
     "payload": {
      "persona": "bob"
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "PERSONA_SIGNED_IN",
       "PERSONA_SIGN_IN_REFUSED"
      ]
     }
    },
    {
     "trait": "Acting",
     "from": "ready",
     "event": "ACT_AS_HOST",
     "payload": {
      "value": "127.0.0.1:9099",
      "key": "bob"
     },
     "expect": {
      "emits": [
       {
        "event": "PERSONA_SIGNED_IN",
        "payload": {
         "subject": "bob"
        }
       }
      ],
      "fired": true
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "bob"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-act-as-without-the-emulator-host-leaves-the-session-anonymous",
   "note": "Production: the host is unset, so the dev persona sign-in is refused and the session keeps the anonymous viewer.",
   "steps": [
    {
     "trait": "Acting",
     "from": "ready",
     "event": "PERSONA_ACT_AS",
     "payload": {
      "persona": "ada"
     },
     "expect": {
      "fired": true
     }
    },
    {
     "trait": "Acting",
     "from": "ready",
     "event": "ACT_AS_HOST",
     "payload": {
      "value": "",
      "key": "ada"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "PERSONA_SIGN_IN_REFUSED",
        "payload": {
         "kind": "no-emulator"
        }
       }
      ],
      "neverEmits": [
       "PERSONA_SIGNED_IN",
       "TOKEN_MINT"
      ]
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "anonymous",
         "role": "anonymous"
        }
       }
      ]
     }
    }
   ]
  }
 ]
}