{
 "atom": "spec/auth/dev-personas-identity.lolo",
 "trait": "DevPersonas",
 "note": "PERSONA_ACT_AS over a runtime [identity] entity: the persona token is one ask to PersonaBinding, which signs the dispatching session in (the next step reads it as @user); a session that never acted stays the anonymous viewer.",
 "cases": [
  {
   "id": "act-as-signs-the-session-in-with-subject-the-persona",
   "steps": [
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "PERSONA_ACT_AS",
     "payload": {
      "persona": "ada"
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "PERSONA_SIGNED_IN",
       "PERSONA_SIGN_IN_REFUSED"
      ]
     }
    },
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "VERIFY_HOST",
     "payload": {
      "value": "127.0.0.1:9099",
      "key": "Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJpc3MiOiJmaXJlYmFzZS1hdXRoLWVtdWxhdG9yQGV4YW1wbGUuY29tIiwiYXVkIjoiZGVtby1hbG1hZGFyIiwic3ViIjoiYWRhIiwidWlkIjoiYWRhIiwiZXhwIjo0MTAyNDQ0ODAwfQ."
     },
     "expect": {
      "emits": [
       {
        "event": "PERSONA_SIGNED_IN",
        "payload": {
         "subject": "ada"
        }
       }
      ],
      "neverEmits": [
       "PERSONA_SIGN_IN_REFUSED"
      ],
      "fired": true
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "ada",
         "role": "member"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "PersonaBinding"
   ]
  },
  {
   "id": "control-a-second-session-that-never-acted-has-no-identity",
   "steps": [
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "PERSONAS_HOST",
     "payload": {
      "value": ""
     },
     "expect": {
      "fired": true
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "anonymous",
         "role": "anonymous"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "PersonaBinding"
   ]
  },
  {
   "id": "act-as-another-persona-binds-that-subject",
   "steps": [
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "PERSONA_ACT_AS",
     "payload": {
      "persona": "bob"
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "PERSONA_SIGNED_IN",
       "PERSONA_SIGN_IN_REFUSED"
      ]
     }
    },
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "VERIFY_HOST",
     "payload": {
      "value": "127.0.0.1:9099",
      "key": "Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJpc3MiOiJmaXJlYmFzZS1hdXRoLWVtdWxhdG9yQGV4YW1wbGUuY29tIiwiYXVkIjoiZGVtby1hbG1hZGFyIiwic3ViIjoiYm9iIiwidWlkIjoiYm9iIiwiZXhwIjo0MTAyNDQ0ODAwfQ."
     },
     "expect": {
      "emits": [
       {
        "event": "PERSONA_SIGNED_IN",
        "payload": {
         "subject": "bob"
        }
       }
      ],
      "fired": true
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "bob"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "PersonaBinding"
   ]
  },
  {
   "id": "control-act-as-without-the-emulator-host-leaves-the-session-anonymous",
   "note": "Production: the host is unset, so the dev persona sign-in is refused and the session keeps the anonymous viewer.",
   "steps": [
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "PERSONA_ACT_AS",
     "payload": {
      "persona": "ada"
     },
     "expect": {
      "fired": true
     }
    },
    {
     "trait": "DevPersonas",
     "from": "ready",
     "event": "VERIFY_HOST",
     "payload": {
      "value": "",
      "key": "Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJpc3MiOiJmaXJlYmFzZS1hdXRoLWVtdWxhdG9yQGV4YW1wbGUuY29tIiwiYXVkIjoiZGVtby1hbG1hZGFyIiwic3ViIjoiYWRhIiwidWlkIjoiYWRhIiwiZXhwIjo0MTAyNDQ0ODAwfQ."
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "PERSONA_REFUSED",
        "payload": {
         "reason": "no-emulator"
        }
       },
       {
        "event": "PERSONA_SIGN_IN_REFUSED",
        "payload": {
         "kind": "no-emulator"
        }
       }
      ],
      "neverEmits": [
       "PERSONA_SIGNED_IN"
      ]
     }
    },
    {
     "trait": "Who",
     "from": "idle",
     "event": "WHO",
     "payload": {},
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "WHOAMI",
        "payload": {
         "id": "anonymous",
         "role": "anonymous"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "PersonaBinding"
   ]
  }
 ]
}
