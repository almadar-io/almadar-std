      "fired": true,
      "state": "failed"
     }
    }
   ]
  },
  {
   "id": "the-server-signing-the-session-in-shows-who",
   "note": "",
   "steps": [
    {
     "trait": "PersonaPicker",
     "from": "signing",
     "event": "SIGNED_IN",
     "entity": {
      "id": "p",
      "personas": [
       {
        "id": "ada",
        "name": "Ada"
       }
      ],
      "selectedId": "ada",
      "message": ""
     },
     "payload": {
      "subject": "ada"
     },
     "expect": {
      "fired": true,
      "state": "signedIn"
     }
    }
   ]
  },
  {
   "id": "a-sign-in-refusal-shows-the-failure",
   "note": "",
   "steps": [
    {
     "trait": "PersonaPicker",
     "from": "signing",
     "event": "SIGN_IN_REFUSED",
     "entity": {
      "id": "p",
      "personas": [
       {
