{
 "atom": "auth/atoms/std-viewer.lolo",
 "trait": "ViewerResolver",
 "note": "viewers[] of viewer.goldens.json; claims are [{name,value}] and the expected viewer is the atom's full object (golden is the flattened view). sources[] (identitySourceOf over entity lists) has no atom event: it is a validator/loader function.",
 "cases": [
  {
   "id": "no token is anonymous (none)",
   "golden": "{\"id\": \"anonymous\", \"role\": \"anonymous\", \"permissions\": []}",
   "steps": [
    {
     "event": "VIEWER_RESOLVE",
     "payload": {
      "requestId": 1,
      "sourceKind": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "VIEWER_RESOLVED",
        "payload": {
         "requestId": 1,
         "viewer": {
          "id": "anonymous",
          "role": "anonymous",
          "permissions": [],
          "claims": []
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "no token is anonymous (directory)",
   "golden": "{\"id\": \"anonymous\", \"role\": \"anonymous\", \"permissions\": []}",
   "steps": [
    {
     "event": "VIEWER_RESOLVE",
     "payload": {
      "requestId": 1,
      "sourceKind": "directory",
      "sourceEntity": "Member"
     },
     "expect": {
      "emits": [
       {
        "event": "VIEWER_RESOLVED",
        "payload": {
         "requestId": 1,
         "viewer": {
          "id": "anonymous",
          "role": "anonymous",
          "permissions": [],
          "claims": []
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "none: id from uid, every claim readable",
   "golden": "{\"id\": \"u-1\", \"uid\": \"u-1\", \"email\": \"ada@example.com\", \"name\": \"Ada\", \"role\": \"teacher\", \"plan\": \"pro\", \"sub\": \"u-1\", \"iss\": \"https://issuer\"}",
   "steps": [
    {
     "event": "VIEWER_RESOLVE",
     "payload": {
      "requestId": 1,
      "sourceKind": "none",
      "verified": {
       "uid": "u-1",
       "email": "ada@example.com",
       "name": "Ada",
       "claims": [
        {
         "name": "sub",
         "value": "u-1"
        },
        {
         "name": "role",
         "value": "teacher"
        },
        {
         "name": "plan",
         "value": "pro"
        },
        {
         "name": "iss",
         "value": "https://issuer"
        }
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "VIEWER_RESOLVED",
        "payload": {
         "requestId": 1,
         "viewer": {
          "id": "u-1",
          "email": "ada@example.com",
          "name": "Ada",
          "role": "teacher",
          "permissions": [],
          "claims": [
           {
            "name": "sub",
            "value": "u-1"
           },
           {
            "name": "role",
            "value": "teacher"
           },
           {
            "name": "plan",
            "value": "pro"
           },
           {
            "name": "iss",
            "value": "https://issuer"
           },
           {
            "name": "uid",
            "value": "u-1"
           }
          ]
         }
        }
       }
      ]
     }
    }
   ]
  },
