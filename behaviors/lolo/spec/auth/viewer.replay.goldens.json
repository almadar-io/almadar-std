  {
   "id": "directory: createMissing writes the first row and resolves its declared role",
   "note": "S1: with createMissing on, a verified uid with no directory row gets one (id from the uid, name from the token), then the written row is read back and its declared role is the viewer's role.",
   "steps": [
    {
     "event": "VIEWER_RESOLVE",
     "payload": {
      "requestId": 1,
      "sourceKind": "directory",
      "verified": {
       "uid": "u-9",
       "email": "ada@example.com",
       "name": "Ada",
       "claims": [
        {
         "name": "sub",
         "value": "u-9"
        }
       ]
      }
     }
    },
    {
     "event": "VIEWER_PUMP",
     "payload": {}
    },
    {
     "event": "DIRECTORY_ABSENT",
     "payload": {
      "code": "not-found"
     },
     "from": "looking",
     "expect": {
      "fired": true,
      "state": "creating",
      "effects": [
       {
        "type": "persist"
       }
      ]
     }
    },
    {
     "event": "DIRECTORY_CREATED",
     "payload": {
      "id": "u-9"
     },
     "from": "creating",
     "expect": {
      "fired": true,
      "state": "refetching",
      "effects": [
       {
        "type": "fetch"
       }
      ]
     }
    },
    {
     "event": "DIRECTORY_FOUND",
     "payload": {
      "data": {
       "id": "u-9",
       "role": "learner",
       "name": "Ada"
      }
     },
     "from": "refetching",
     "expect": {
      "emits": [
       {
        "event": "VIEWER_RESOLVED",
        "payload": {
         "requestId": 1,
         "viewer": {
          "id": "u-9",
          "email": "ada@example.com",
          "name": "Ada",
          "role": "learner",
          "permissions": [],
          "claims": [
           {
            "name": "name",
            "value": "Ada"
           }
          ]
         }
        }
       }
      ]
     }
    }
   ],
   "config": {
    "createMissing": true
   }
  },
