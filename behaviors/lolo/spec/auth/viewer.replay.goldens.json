  {
   "id": "directory without a lookup is refused",
   "golden": "{\"error\": \"no lookup\"}",
   "steps": [
    {
     "event": "VIEWER_RESOLVE",
     "payload": {
      "requestId": 1,
      "sourceKind": "directory",
      "sourceEntity": "Member",
      "verified": {
       "uid": "u-1",
       "email": "ada@example.com",
       "name": "Ada",
       "claims": [
        {
         "name": "sub",
         "value": "u-1"
        },
        {
         "name": "role",
         "value": "teacher"
        },
        {
         "name": "plan",
         "value": "pro"
        },
        {
         "name": "iss",
         "value": "https://issuer"
        }
       ]
      }
     }
    },
    {
     "event": "VIEWER_PUMP",
     "payload": {}
    },
    {
     "event": "DIRECTORY_ABSENT",
     "payload": {
      "code": "store",
      "error": "no lookup"
