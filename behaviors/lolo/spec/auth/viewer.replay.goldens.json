  {
   "id": "directory: the row keyed by the verified uid",
   "golden": "{\"id\": \"u-1\", \"role\": \"admin\", \"name\": \"Ada Lovelace\"}",
   "steps": [
    {
     "event": "VIEWER_RESOLVE",
     "payload": {
      "requestId": 1,
      "sourceKind": "directory",
      "verified": {
       "uid": "u-1",
       "email": "ada@example.com",
       "name": "Ada",
       "claims": [
        {
         "name": "sub",
         "value": "u-1"
        },
        {
         "name": "role",
         "value": "teacher"
        },
        {
         "name": "plan",
         "value": "pro"
        },
        {
         "name": "iss",
         "value": "https://issuer"
        }
       ]
      },
      "sourceEntity": "Member"
     }
    },
    {
     "event": "VIEWER_PUMP",
     "payload": {}
    },
    {
     "event": "DIRECTORY_FOUND",
     "payload": {
      "data": {
       "id": "u-1",
       "role": "admin",
       "name": "Ada Lovelace"
      }
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "VIEWER_RESOLVED",
        "payload": {
         "requestId": 1,
         "viewer": {
          "id": "u-1",
          "email": "ada@example.com",
          "name": "Ada Lovelace",
          "role": "admin",
          "permissions": [],
          "claims": [
           {
            "name": "name",
            "value": "Ada Lovelace"
           }
          ]
         }
        }
       }
      ]
     }
    }
   ]
