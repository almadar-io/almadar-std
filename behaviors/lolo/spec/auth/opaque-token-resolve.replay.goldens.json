                  "key": "r1",
                  "id": "1a7674eb4ee78df7e1ac439a93c3fa8e3c945784d4dec9fd8e3011738b2f1d62",
                  "row": {
                    "id": "1a7674eb4ee78df7e1ac439a93c3fa8e3c945784d4dec9fd8e3011738b2f1d62"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "an-expired-token-is-refused-expired",
      "now": 1700000000000,
      "steps": [
        {
          "event": "RESOLVE_TOKEN",
          "payload": {
            "key": "r1",
            "token": "tok"
          },
          "expect": {
            "fired": true,
            "state": "reading"
          }
        },
        {
          "event": "TOKEN_ROW_FOUND",
          "from": "reading",
          "payload": {
            "data": {
              "id": "1a7674eb4ee78df7e1ac439a93c3fa8e3c945784d4dec9fd8e3011738b2f1d62",
              "expiresAt": "2020-01-01T00:00:00Z"
            }
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "TOKEN_REFUSED",
                "payload": {
                  "key": "r1",
                  "code": "expired",
                  "message": "the token has expired",
                  "token": "tok"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-forged-token-is-refused-unknown",
