{
  "atom": "auth/atoms/std-opaque-token.lolo",
  "trait": "OpaqueTokenResolve",
  "note": "A live token resolves to its row; an expired, forged or spent one is refused by name, and single use claims the row before answering it.",
  "cases": [
    {
      "id": "a-live-token-resolves-to-its-row",
      "now": 1700000000000,
      "steps": [
        {
          "event": "RESOLVE_TOKEN",
          "payload": {
            "key": "r1",
            "token": "tok"
          },
          "expect": {
            "fired": true,
            "state": "reading"
          }
        },
        {
          "event": "TOKEN_ROW_FOUND",
          "from": "reading",
          "payload": {
            "data": {
              "id": "1a7674eb4ee78df7e1ac439a93c3fa8e3c945784d4dec9fd8e3011738b2f1d62",
              "expiresAt": "2030-01-01T00:00:00Z"
            }
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "TOKEN_RESOLVED",
                "payload": {
                  "key": "r1",
                  "id": "1a7674eb4ee78df7e1ac439a93c3fa8e3c945784d4dec9fd8e3011738b2f1d62",
                  "row": {
                    "id": "1a7674eb4ee78df7e1ac439a93c3fa8e3c945784d4dec9fd8e3011738b2f1d62",
                    "expiresAt": "2030-01-01T00:00:00Z"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-a-token-with-no-expiry-never-expires",
      "now": 1700000000000,
