  {
   "id": "auto-sign-in-mints-the-persona-token-when-the-host-is-the-emulator",
   "note": "With no [identity] entity in the atom the sign-in answers no-identity; the program's identity entity decides it for real.",
   "config": {
    "maxRows": 200,
    "authEmulatorHost": "127.0.0.1:9099",
    "projectId": "demo-almadar",
    "epoch": "1970-01-01T00:00:00.000Z",
    "reservedClaims": [
     "sub"
    ],
    "autoSignIn": "ada",
    "emulatorIssuer": "firebase-auth-emulator@example.com",
    "emulatorAudience": "https://identitytoolkit.googleapis.com/google.identity.identitytoolkit.v1.IdentityToolkit"
   },
   "steps": [
    {
     "from": "ready",
     "event": "AUTO_HOST",
     "payload": {
      "value": "127.0.0.1:9099",
      "key": "auto"
     },
     "expect": {
      "emits": [
       {
        "event": "TOKEN_MINT",
        "payload": {
         "key": "ada",
         "purpose": "sign-in"
        }
       },
       {
        "event": "TOKEN_MINTED",
        "payload": {
         "key": "ada",
         "purpose": "sign-in"
        }
       },
       {
        "event": "PERSONA_SIGN_IN_REFUSED",
        "payload": {
         "kind": "no-identity"
        }
       }
      ]
     }
    }
   ]
  },
