                    "description": "a"
                  },
                  {
                    "envVar": "P_B",
                    "required": true,
                    "description": "b"
                  },
                  {
                    "envVar": "P_OPT",
                    "required": false,
                    "description": "o"
                  }
                ]
              }
            ],
            "service": "pay",
            "held": [
              "P_A"
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "CRED_ADMIN_TESTED",
                "payload": {
                  "service": "pay",
                  "configured": false,
                  "missing": [
                    "P_B"
                  ],
                  "probed": false,
                  "ok": false,
                  "message": "Missing required credentials: P_B"
                }
              }
            ]
          }
        }
      ]
