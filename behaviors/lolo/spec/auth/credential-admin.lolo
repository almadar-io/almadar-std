app credential-admin-spec [
  version: "1.0.0",
  description: "Design contract for the policy of credential administration: a role gate that fails closed, the settable check over declared credentials, last-4 masking, the status catalog, the masked inventory, the presence-only test and the mock/real mode request, the store-source word with its host-setting names, the boot seed plan and boot check, and the store requirement of set, remove and rotate. Each answers once; the host stores and reads the values."
]

type CredDeclared = { envVar : string!, required : boolean!, description : string! }
type CredGroup = { service : string!, backend : string!, listed : boolean!, credentials : [CredDeclared]! }

type CredSeedRow = { service : string!, envVar : string! }
type CredEntry = { id : string!, service : string!, envVar : string!, required : boolean!, description : string!, configured : boolean!, source : string!, last4 : string! }
type CredServiceStatus = { id : string!, service : string!, configured : boolean!, mocked : boolean!, status : string!, backend : string!, needs : string! }

orbital CredentialAdminSpec {
  expects entity CredentialAdminRun [runtime] {
    id : string!
    group : [CredGroup]
    roles : [string]
    last4 : string
    mock : boolean
  }
  expects trait CredentialAdmin {
    state idle {
      CRED_ADMIN_GATE -> idle
      CRED_ADMIN_SETTABLE -> idle
      CRED_ADMIN_MASK -> idle
      CRED_ADMIN_SAVE -> idle
      CRED_ADMIN_CATALOG -> idle
      CRED_ADMIN_LIST -> idle
      CRED_ADMIN_TEST -> idle
      CRED_ADMIN_MODE -> idle
      CRED_ADMIN_ENV_MODE -> idle
      CRED_ADMIN_SOURCE -> idle
      CRED_ADMIN_SEED -> idle
      CRED_ADMIN_BOOT_CHECK -> idle
      CRED_ADMIN_REQUIRE_STORE -> idle
    }
    emits {
      CRED_ADMIN_ALLOWED { verb : string! }
      CRED_ADMIN_REFUSED { code : string!  message : string! }
      CRED_ADMIN_MASKED { last4 : string! }
      CRED_ADMIN_SAVED { service : string!  envVar : string!  last4 : string! }
      CRED_ADMIN_CATALOGED { groups : [CredGroup]! }
      CRED_ADMIN_LISTED { enabled : boolean!  mode : string!  services : [CredServiceStatus]!  entries : [CredEntry]! }
      CRED_ADMIN_TESTED { service : string!  configured : boolean!  missing : [string]!  probed : boolean!  ok : boolean!  message : string! }
      CRED_ADMIN_MODE_SET { mock : boolean!  mode : string! }
      CRED_ADMIN_SOURCED { store : boolean!  storeOnly : boolean! }
      CRED_ADMIN_SEED_PLAN { rows : [CredSeedRow]! }
      CRED_ADMIN_OWED { owed : [string]! }
    }
  }
  expects page boot -> CredentialAdmin
}
