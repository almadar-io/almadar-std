    {
      "id": "a-task-started-with-steps-holds-them-as-its-declared-plan",
      "defaults": [
        "CoordContext",
        "CoordLoop",
        "CoordLlm",
        "CoordChatRequest",
        "CoordChatRequestDelay",
        "CoordChatRequestDeadline",
        "CoordChatHttp",
        "CoordChatHttpFrame"
      ],
      "steps": [
        {
          "event": "TASK_START",
          "from": "idle",
          "payload": {
            "taskId": "t6",
            "task": "claims intake",
            "steps": [
              {
                "instruction": "read the documents",
                "hold": false,
                "limited": false,
                "tools": []
              }
            ]
          },
          "expect": {
            "fired": true,
            "state": "loading",
            "entity": {
              "declared": [
                {
                  "instruction": "read the documents",
                  "hold": false,
                  "limited": false,
                  "tools": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "releasing-a-held-step-clears-its-mark-and-says-so",
      "defaults": [
        "CoordContext",
        "CoordLoop",
        "CoordLlm",
        "CoordChatRequest",
        "CoordChatRequestDelay",
        "CoordChatRequestDeadline",
        "CoordChatHttp",
        "CoordChatHttpFrame"
      ],
      "steps": [
        {
          "event": "TASK_RELEASE",
          "from": "idle",
          "payload": {
            "taskId": "t7",
            "index": 1
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "effects": [
              {
                "type": "persist"
              }
            ]
          }
        },
        {
          "event": "StepReleased",
          "payload": {
            "id": "t7:1"
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "TASK_RELEASED",
                "payload": {
                  "stepId": "t7:1"
                }
              }
            ]
          }
        }
      ]
    }
  ]
