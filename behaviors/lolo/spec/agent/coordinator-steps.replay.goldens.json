{
  "atom": "agent/atoms/std-agent-coordinator.lolo",
  "trait": "AgentCoordinator",
  "note": "declared steps for a workflow (P-030): a caller that writes the step rows itself may mark a step held (the run stops before it and says so, and starts again when the caller clears the mark and sends TASK_START) and may limit a step to some of the configured tools. Written before the atom change; rows that name neither behave as before.",
  "cases": [
    {
      "id": "a-held-step-stops-the-run-before-it-and-says-which",
      "steps": [
        {
          "event": "STEP_NEXT",
          "from": "working",
          "entity": {
            "id": "r",
            "taskId": "t1",
            "task": "claims intake",
            "instructions": [
              "read the documents",
              "write the letter"
            ],
            "results": [
              "read"
            ],
            "index": 1,
            "total": 2,
            "stepRules": [
              {
                "hold": false,
                "limited": false,
                "tools": []
              },
              {
                "hold": true,
                "limited": false,
                "tools": []
              }
            ]
          },
          "payload": {},
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "TASK_HELD",
                "payload": {
                  "taskId": "t1",
                  "index": 1,
                  "total": 2,
                  "result": "read"
                }
              }
            ],
            "neverEmits": [
              "COMPACT",
              "TASK_FAILED",
              "TASK_DONE"
            ]
          }
        }
      ],
      "defaults": [
        "CoordContext",
        "CoordLoop",
        "CoordLlm",
        "CoordChatRequest",
        "CoordChatRequestDelay",
        "CoordChatRequestDeadline",
        "CoordChatHttp",
        "CoordChatHttpFrame"
      ]
    },
