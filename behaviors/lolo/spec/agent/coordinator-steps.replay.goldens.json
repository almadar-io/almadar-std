        "CoordChatHttp",
        "CoordChatHttpFrame"
      ]
    },
    {
      "id": "stored-step-rows-carry-their-hold-and-tools-into-the-run",
      "steps": [
        {
          "event": "StepsLoaded",
          "from": "loading",
          "entity": {
            "id": "r",
            "taskId": "t3",
            "task": "claims intake"
          },
          "payload": {
            "totalCount": 2,
            "data": [
              {
                "id": "t3:0",
                "taskId": "t3",
                "index": 0,
                "instruction": "read the documents",
                "status": "done",
                "result": "read",
                "error": "",
                "hold": false,
                "limited": true,
                "tools": [
                  "Claim"
                ]
              },
              {
                "id": "t3:1",
                "taskId": "t3",
                "index": 1,
                "instruction": "write the letter",
                "status": "pending",
                "result": "",
                "error": "",
                "hold": true,
                "limited": false,
                "tools": []
              }
            ]
          },
          "expect": {
            "fired": true,
            "state": "starting",
            "entity": {
              "index": 1,
              "total": 2,
              "stepRules": [
                {
                  "hold": false,
                  "limited": true,
                  "tools": [
                    "Claim"
                  ]
                },
                {
                  "hold": true,
                  "limited": false,
                  "tools": []
                }
              ]
            }
          }
        }
      ],
      "defaults": [
        "CoordContext",
        "CoordLoop",
        "CoordLlm",
        "CoordChatRequest",
        "CoordChatRequestDelay",
        "CoordChatRequestDeadline",
        "CoordChatHttp",
        "CoordChatHttpFrame"
      ]
    },
    {
      "id": "a-declared-plan-is-taken-as-given-and-no-model-plans",
      "defaults": [
        "CoordContext",
        "CoordLoop",
        "CoordLlm",
        "CoordChatRequest",
        "CoordChatRequestDelay",
        "CoordChatRequestDeadline",
        "CoordChatHttp",
        "CoordChatHttpFrame"
      ],
      "steps": [
        {
          "event": "TaskCreated",
          "from": "planning",
          "entity": {
            "id": "r",
            "taskId": "t4",
            "task": "claims intake",
            "declared": [
              {
                "instruction": "read the documents",
                "hold": false,
                "limited": true,
                "tools": [
                  "Claim"
                ]
              },
              {
                "instruction": "write the letter",
                "hold": true,
                "limited": false,
                "tools": []
              }
            ]
          },
          "payload": {
            "id": "t4"
          },
          "expect": {
            "fired": true,
            "state": "planning",
            "emits": [
              {
                "event": "PLAN_READ"
              }
            ],
            "neverEmits": [
              "LLM_EXTRACT"
            ],
            "entity": {
              "instructions": [
                "read the documents",
                "write the letter"
              ],
              "stepRules": [
                {
                  "hold": false,
                  "limited": true,
                  "tools": [
                    "Claim"
                  ]
                },
                {
                  "hold": true,
                  "limited": false,
                  "tools": []
                }
              ]
            }
          }
        }
      ]
    },
    {
