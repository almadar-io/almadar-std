    {
      "id": "a-run-row-carries-the-member-who-started-it-as-its-owner",
      "config": {
        "name": "Claims intake",
        "instructions": "Handle one insurance claim.",
        "inputFields": [
          {
            "name": "claimNumber",
            "label": "Claim number",
            "required": true
          }
        ],
        "steps": [
          {
            "title": "Read the documents",
            "instructions": "Read the claim's documents.",
            "tools": [
              "Claims.ClaimManage.OPEN_CLAIM"
            ],
            "approval": false
          },
          {
            "title": "Check the list",
            "instructions": "Check the claim against the checklist.",
            "tools": [],
            "approval": true
          },
          {
            "title": "Write the letter",
            "instructions": "Write the decision letter.",
            "tools": [],
            "approval": false
          }
        ]
      },
      "steps": [
        {
          "event": "WORKFLOW_RUN",
          "from": "idle",
          "payload": {
            "runId": "run-o",
            "input": {
              "claimNumber": "C-2026-17"
            }
          },
          "expect": {
            "fired": true,
            "state": "running",
            "effects": [
              {
                "type": "persist",
                "arg0": "create",
                "arg1": "WorkflowRun",
                "arg2": {
                  "id": "@payload.runId",
                  "ownerId": "@user.id",
                  "workflow": [
                    "default",
                    "@payload.workflow.name",
                    "Claims intake"
                  ],
