                  "runId": "run-1",
                  "index": 0,
                  "title": "Write the letter",
                  "result": "Dear policyholder."
                }
              }
            ],
            "neverEmits": [
              "WORKFLOW_DONE"
            ]
          }
        },
        {
          "event": "WORKFLOW_APPROVED",
          "payload": {
            "runId": "run-1"
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "WORKFLOW_DONE",
                "payload": {
                  "runId": "run-1",
                  "answer": "Dear policyholder."
                }
              }
            ],
            "neverEmits": [
              "TASK_RELEASE"
            ]
          }
        }
      ]
    },
