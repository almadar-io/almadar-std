{
  "atom": "agent/atoms/std-agent-workflow.lolo",
  "trait": "AgentWorkflow",
  "spec": "spec/agent/agent-workflow.lolo",
  "note": "a declared workflow run by the long-task coordinator (P-030). The coordinator's answers (TASK_PROGRESS, TASK_HELD, TASK_RELEASED, TASK_DONE, TASK_FAILED) are played as steps. The example is a claims intake of three steps whose second needs approval.",
  "cases": [
    {
      "id": "a-run-hands-the-declared-steps-to-the-coordinator-limited-and-held-after-an-approval-step",
      "config": {
        "name": "Claims intake",
        "instructions": "Handle one insurance claim.",
        "inputFields": [
          {
            "name": "claimNumber",
            "label": "Claim number",
            "required": true
          }
        ],
        "steps": [
          {
            "title": "Read the documents",
            "instructions": "Read the claim's documents.",
            "tools": [
              "Claims.ClaimManage.OPEN_CLAIM"
            ],
            "approval": false
          },
          {
            "title": "Check the list",
            "instructions": "Check the claim against the checklist.",
            "tools": [],
            "approval": true
          },
          {
            "title": "Write the letter",
            "instructions": "Write the decision letter.",
            "tools": [],
            "approval": false
          }
        ]
      },
      "steps": [
        {
          "event": "WORKFLOW_RUN",
          "from": "idle",
          "payload": {
            "runId": "run-1",
            "input": {
              "claimNumber": "C-2026-17"
            }
          },
          "expect": {
            "fired": true,
            "state": "running",
            "emits": [
              {
                "event": "TASK_START",
                "payload": {
                  "taskId": "run-1",
                  "task": "Claims intake\nHandle one insurance claim.\n\nclaimNumber: C-2026-17",
                  "steps": [
                    {
                      "instruction": "Read the documents: Read the claim's documents.",
                      "hold": false,
                      "limited": true,
                      "tools": [
                        "Claims.ClaimManage.OPEN_CLAIM"
                      ]
                    },
                    {
                      "instruction": "Check the list: Check the claim against the checklist.",
                      "hold": false,
                      "limited": true,
                      "tools": []
                    },
                    {
                      "instruction": "A person read the result of the step before this one and approved it.\nWrite the letter: Write the decision letter.",
                      "hold": true,
                      "limited": true,
                      "tools": []
                    }
                  ]
                }
              }
            ],
            "neverEmits": [
              "WORKFLOW_FAILED"
            ]
          }
        }
      ]
    },
    {
      "id": "a-run-missing-a-required-field-is-refused-and-nothing-starts",
