          },
          "expect": {
            "fired": true,
            "state": "awaitingApproval",
            "emits": [
              {
                "event": "WORKFLOW_APPROVAL_NEEDED",
                "payload": {
                  "runId": "run-1",
                  "index": 1,
                  "title": "Check the list",
                  "result": "Every item on the list is met."
                }
              }
            ]
          }
        },
        {
          "event": "WORKFLOW_APPROVED",
          "payload": {
            "runId": "run-1"
          },
          "expect": {
            "fired": true,
            "state": "running",
            "emits": [
              {
                "event": "TASK_RELEASE",
                "payload": {
                  "taskId": "run-1",
                  "index": 2
                }
              }
            ]
          }
        },
        {
          "event": "TaskReleased",
          "payload": {
            "stepId": "run-1:2"
          },
          "expect": {
            "fired": true,
            "state": "running",
            "emits": [
              {
                "event": "TASK_START",
                "payload": {
                  "taskId": "run-1"
                }
              }
            ]
          }
        }
      ]
    },
