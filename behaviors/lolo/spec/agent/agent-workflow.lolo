app agent-workflow-spec [
  version: "1.2.0",
  description: "Design contract for a reusable agent workflow: one business process as declared data, run step by step by an agent. The knobs name the process (name, instructions), the fields a run asks for (inputFields) and the ordered steps: each step has a title, its instructions, the configured tools it may use (event addresses and entity names; an empty list is a step that only reasons and writes its result), and whether a person must approve its result before the run goes on, written either as `approval` on the step or as a step of kind `approval` right after it (a person's sign-off is not work the agent does: such a step is never run, it marks the step before it). A workflow is composed into the program whose records it works on, so its tools are that program's own declared inputs and its writes pass that program's guards and policies. WORKFLOW_RUN { runId, input } refuses a run whose required field is missing (WORKFLOW_FAILED, index -1), otherwise stores a WorkflowRun row and hands the declared steps to the long-task coordinator (TASK_START { taskId = runId, task, steps }): the plan is the declared one, never a model's, each step is limited to its tools, and the step after an approval step is held. Each step reports WORKFLOW_STEP. When the coordinator stops before a held step (TASK_HELD), or ends with the last step marked approval, the run waits in awaitingApproval with WORKFLOW_APPROVAL_NEEDED { runId, index, title, result }; WORKFLOW_APPROVED releases the held step and resumes, and WORKFLOW_DENIED { reason } ends the run denied. WORKFLOW_DONE { runId, answer } or WORKFLOW_FAILED { runId, index, error } ends it. A run resumes after a crash at the first step that is not done, because the coordinator's step rows persist. One run at a time: a WORKFLOW_RUN while another runs is refused, never queued silently. Who may approve is the composer's gate (std-approval-gate); this contract only names the two answers."
]

type WorkflowField = { name : string!, label : string!, required : boolean! }
type WorkflowStep = { title : string!, instructions : string, tools : [string], approval : boolean, kind : "agent" | "approval" }
type WorkflowDeclared = { instruction : string!, hold : boolean, limited : boolean, tools : [string] }

orbital AgentWorkflowSpec {
  expects config { name : string = ""  instructions : string = ""  inputFields : [WorkflowField] = []  steps : [WorkflowStep] = [] }
  expects entity WorkflowRun [persistent] {
    id : string!
    workflow : string
    status : "running" | "awaitingApproval" | "done" | "denied" | "failed" | "cancelled"
    input : Map string string
    stepIndex : number
    stepTotal : number
    answer : string
    error : string
    startedAt : instant
    finishedAt : instant
  }
  expects trait AgentWorkflow {
    state idle {
      WORKFLOW_RUN -> running
    }
    state running {
      WORKFLOW_CANCEL -> idle
    }
    state awaitingApproval {
      WORKFLOW_APPROVED -> running
      WORKFLOW_DENIED -> idle
    }
    emits {
      TASK_START { taskId : string!  task : string!  steps : [WorkflowDeclared]! }
      WORKFLOW_STEP { runId : string!  index : number!  total : number!  title : string!  status : "started" | "done"! }
      WORKFLOW_APPROVAL_NEEDED { runId : string!  index : number!  title : string!  result : string! }
      WORKFLOW_DONE { runId : string!  answer : string! }
      WORKFLOW_FAILED { runId : string!  index : number!  error : string! }
    }
  }
  expects page boot -> AgentWorkflow
}
