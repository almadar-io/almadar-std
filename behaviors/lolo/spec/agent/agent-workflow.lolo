app agent-workflow-spec [
  version: "1.0.0",
  description: "Design contract for a reusable agent workflow: one business process as declared data, run step by step by an agent. The knobs name the process (name, instructions), the fields a run asks for (inputFields), the ordered steps (title, instructions, and whether a person must approve the step's result before the next one starts) and the tools the steps may use. WORKFLOW_RUN { runId, input } refuses a run whose required field is missing (WORKFLOW_FAILED, index -1), otherwise stores a WorkflowRun row and hands the declared steps to the long-task coordinator (TASK_START { taskId = runId, task, steps }); the plan is the declared one, never a model's. Each step reports WORKFLOW_STEP. A step marked approval stops the run in awaitingApproval with WORKFLOW_APPROVAL_NEEDED { runId, index, title, result }; WORKFLOW_APPROVED resumes at the next step and WORKFLOW_DENIED { reason } ends the run denied. WORKFLOW_DONE { runId, answer } or WORKFLOW_FAILED { runId, index, error } ends it. A run resumes after a crash at the first step that is not done. One run at a time: a WORKFLOW_RUN while another runs is refused, never queued silently. Who may approve is the composer's gate (std-approval-gate); this contract only names the two answers."
]

type WorkflowField = { name : string!, label : string!, required : boolean! }
type WorkflowStep = { title : string!, instructions : string!, approval : boolean! }

orbital AgentWorkflowSpec {
  expects config { name : string = ""  instructions : string = ""  inputFields : [WorkflowField] = []  steps : [WorkflowStep] = [] }
  expects entity WorkflowRun [persistent] {
    id : string!
    workflow : string
    status : "running" | "awaitingApproval" | "done" | "denied" | "failed" | "cancelled"
    input : Map string string
    stepIndex : number
    stepTotal : number
    answer : string
    error : string
    startedAt : instant
    finishedAt : instant
  }
  expects trait AgentWorkflow {
    state idle {
      WORKFLOW_RUN -> running
    }
    state running {
      WORKFLOW_CANCEL -> idle
    }
    state awaitingApproval {
      WORKFLOW_APPROVED -> running
      WORKFLOW_DENIED -> idle
    }
    emits {
      TASK_START { taskId : string!  task : string!  steps : [string]! }
      WORKFLOW_STEP { runId : string!  index : number!  total : number!  title : string!  status : "started" | "done" | "failed"! }
      WORKFLOW_APPROVAL_NEEDED { runId : string!  index : number!  title : string!  result : string! }
      WORKFLOW_DONE { runId : string!  answer : string! }
      WORKFLOW_FAILED { runId : string!  index : number!  error : string! }
    }
  }
  expects page boot -> AgentWorkflow
}
