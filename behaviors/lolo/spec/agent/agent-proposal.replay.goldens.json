   "steps": [
    {
     "from": "working",
     "event": "PROPOSE",
     "payload": {
      "summary": "One plan",
      "items": [
       {
        "trackId": "a",
        "entryBar": "1"
       }
      ]
     },
     "entity": {
      "id": "p",
      "input": "tracks",
      "context": "",
      "request": "tracks",
      "feedback": "",
      "summary": "",
      "items": [],
      "error": ""
     },
     "expect": {
      "fired": true,
      "state": "review"
     }
    }
   ]
  },
  {
