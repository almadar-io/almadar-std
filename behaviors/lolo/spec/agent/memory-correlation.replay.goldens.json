{
  "atom": "agent/atoms/std-agent-memory.lolo",
  "trait": "AgentMemoryRecall",
  "note": "RECALL and REMEMBER share one embedding service; each request carries its own key (recall / store) and each trait's result transition is guarded on it, so results delivered in either order go to the trait that asked",
  "cases": [
    {
      "id": "a recall and a remember in flight together, the store result delivered first: each trait takes only its own",
      "steps": [
        {
          "trait": "AgentMemoryRecall",
          "event": "RECALL",
          "payload": {
            "messages": [
              {
                "role": "user",
                "content": "what colour"
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "LLM_EMBED",
                "payload": {
                  "key": "recall"
                }
              }
            ]
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        },
        {
          "trait": "AgentMemoryStore",
          "event": "REMEMBER",
          "payload": {
            "reply": "blue"
          },
          "expect": {
            "emits": [
              {
                "event": "LLM_EMBED",
                "payload": {
                  "key": "store"
                }
              }
            ]
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        },
        {
          "trait": "AgentMemoryRecall",
          "event": "MemoryEmbedded",
          "payload": {
            "embeddings": [
              [
                1,
                0
              ]
            ],
            "key": "store"
          },
          "expect": {
            "neverEmits": [
              "RECALLED",
              "LLM_EMBED"
            ]
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        },
        {
          "trait": "AgentMemoryStore",
          "event": "MemoryEmbedded",
          "payload": {
            "embeddings": [
              [
                1,
                0
              ]
            ],
            "key": "store"
          },
          "expect": {
            "state": "ready"
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        },
        {
          "trait": "AgentMemoryStore",
          "event": "MemoryEmbedded",
          "payload": {
            "embeddings": [
              [
                1,
                0
              ]
            ],
            "key": "recall"
          },
          "expect": {
            "neverEmits": [
              "MEMORY_STORED"
            ]
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        },
        {
          "trait": "AgentMemoryRecall",
          "event": "MemoryEmbedded",
          "payload": {
            "embeddings": [
              [
                1,
                0
              ]
            ],
            "key": "recall"
          },
          "expect": {
            "emits": [
              {
                "event": "RECALLED",
                "payload": {
                  "context": "Asked:  | Answered: blue"
                }
              }
            ]
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        }
      ],
      "defaults": [
        "AgentMemoryLlm",
        "MemEmbedWait",
        "MemEmbedRequest",
        "MemEmbedHttp",
        "AgentMemoryBrowse",
        "AgentMemoryView"
      ]
    },
