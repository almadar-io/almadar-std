{
  "atom": "agent/atoms/std-agent-memory.lolo",
  "trait": "AgentMemoryRecall",
  "note": "`live` on RECALL reaches RECALLED when given and stays absent when not, on the ephemeral and every normal path",
  "cases": [
    {
      "id": "recall-ephemeral-live-true",
      "note": "ephemeral recall forwards live",
      "steps": [
        {
          "trait": "AgentMemoryRecall",
          "event": "RECALL",
          "payload": {
            "messages": [
              {
                "role": "user",
                "content": "hi"
              }
            ],
            "instructions": "i",
            "tools": [],
            "ephemeral": true,
            "live": true
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "RECALLED",
                "payload": {
                  "messages": [
                    {
                      "role": "user",
                      "content": "hi"
                    }
                  ],
                  "context": "",
                  "instructions": "i",
                  "tools": [],
                  "ephemeral": true,
                  "live": true
                }
              }
            ]
          },
          "identity": {
            "id": "u1",
            "role": "member"
          }
        }
      ],
      "defaults": [
        "AgentMemoryLlm",
        "MemEmbedWait",
        "MemEmbedRequest",
        "MemEmbedHttp",
        "AgentMemoryBrowse",
        "AgentMemoryView"
      ]
    },
    {
      "id": "control-recall-ephemeral-without-live",
      "note": "absent live stays absent",
