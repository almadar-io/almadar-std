app agent-planner-spec [
  version: "1.0.0",
  description: "Design contract for a planner: a prompt first recalls memories, then asks for a plan from the prompt; a failed recall still plans (without memories), and a failed generation still ends planned with an empty plan, never stuck planning. PLANNED answers the plan text and how many memories were recalled. A planned run can be reset to idle."
]

orbital AgentPlannerSpec {
  expects entity PlannerPlan [runtime] {
    prompt : string
    context : string
    plan : string
    status : "idle" | "planning" | "planned"
  }
  expects trait PlannerExecution {
    state idle {
      PLAN -> recalling
    }
    state recalling {
      RECALLED -> planning
    }
    state planning {
      PLAN_GENERATED -> planned
      PLAN_GENERATION_FAILED -> planned
    }
    state planned {
      RESET -> idle
    }
    emits {
      PLANNED { plan : string!  memoryCount : number! }
    }
  }
  expects page boot -> PlannerExecution
}
