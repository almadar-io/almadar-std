{
 "atom": "agent/atoms/std-agent-file-tools.lolo",
 "trait": "AgentFileTools",
 "note": "root work under cwd; host answers are played as the next step's event; effect arguments are not asserted, the refusal controls prove no effect fires",
 "cases": [
  {
   "id": "the loop's call id is what the answer carries",
   "config": {
    "rootDir": "work/"
   },
   "steps": [
    {
     "trait": "AgentFileTools",
     "event": "TOOL_PENDING",
     "from": "ready",
     "payload": {
      "callId": "c9",
      "tool": "AgentFileTools.READ_FILE"
     },
     "entity": {
      "id": "f",
      "callId": "",
      "dir": "",
      "entries": [],
      "sized": []
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "trait": "AgentFileTools",
     "event": "FILE_FAILED",
     "from": "ready",
     "payload": {
      "error": "gone"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "TOOL_FAILED",
        "payload": {
         "callId": "c9",
         "error": "gone"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a text path reads the file through os/read-file",
   "config": {
    "rootDir": "work/"
   },
   "steps": [
    {
     "trait": "AgentFileTools",
     "event": "READ_FILE",
     "from": "ready",
     "payload": {
      "path": "notes/a.txt"
     },
     "entity": {
      "id": "f",
      "callId": "c1",
      "dir": "",
      "entries": [],
      "sized": []
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "effects": [
       {
        "type": "os/read-file",
        "optionsAt": 1,
        "routed": true
