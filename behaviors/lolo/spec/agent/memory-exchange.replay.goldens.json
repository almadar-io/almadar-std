      ],
      "key": "store"
     },
     "expect": {
      "state": "ready"
     }
    },
    {
     "trait": "AgentMemoryRecall",
     "event": "RECALL",
     "identity": {
      "id": "u1",
      "role": "member"
     },
     "payload": {
      "messages": [
       {
        "role": "user",
        "content": "again"
       }
      ]
