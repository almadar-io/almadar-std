{
 "atom": "agent/atoms/std-agent-memory.lolo",
 "trait": "AgentMemoryRecall",
 "note": "what an exchange is stored as (the turn the recall ran for, then the reply) and which memories a recall keeps (minSimilarity: the lowest cosine similarity recalled; undeclared keeps every comparable memory)",
 "cases": [
  {
   "id": "the remembered exchange carries the turn it was recalled for",
   "steps": [
    {
     "trait": "AgentMemoryRecall",
     "event": "RECALL",
     "identity": {
      "id": "u1",
      "role": "member"
     },
     "payload": {
      "messages": [
       {
        "role": "user",
        "content": "what colour"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "LLM_EMBED",
        "payload": {
         "key": "recall"
        }
       }
      ]
     }
    },
    {
     "trait": "AgentMemoryRecall",
     "event": "MemoryEmbedded",
     "identity": {
      "id": "u1",
      "role": "member"
     },
     "payload": {
      "embeddings": [
       [
        1,
        0
       ]
      ],
      "key": "recall"
     },
     "expect": {
      "emits": [
       {
        "event": "RECALLED",
        "payload": {
         "context": ""
        }
       }
      ]
     }
    },
    {
     "trait": "AgentMemoryStore",
     "event": "REMEMBER",
     "identity": {
      "id": "u1",
      "role": "member"
     },
     "payload": {
      "reply": "blue"
     },
     "expect": {
      "emits": [
       {
        "event": "LLM_EMBED",
        "payload": {
         "key": "store"
        }
       }
      ]
     }
    },
    {
