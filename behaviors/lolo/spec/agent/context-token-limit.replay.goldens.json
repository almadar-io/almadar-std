  {
   "id": "a-short-conversation-over-the-token-limit-is-summarized",
   "config": {
    "keepMessages": 12,
    "tokenLimit": 1000,
    "keepMessagesOverLimit": 2
   },
   "steps": [
    {
     "trait": "AgentContextCompactor",
     "event": "COMPACT",
     "from": "ready",
     "payload": {
      "messages": [
       {
        "role": "user",
        "content": "m0"
       },
       {
        "role": "assistant",
        "content": "m1"
       },
       {
        "role": "user",
        "content": "m2"
       },
       {
        "role": "assistant",
        "content": "m3"
       },
       {
        "role": "user",
        "content": "m4"
       },
       {
        "role": "assistant",
        "content": "m5"
       }
      ]
     },
     "entity": {
      "id": "c",
      "pendingMessages": [],
      "lastSize": 0,
      "pendingInstructions": "",
      "pendingTools": [],
      "pendingEphemeral": false,
      "pendingHasLive": false,
      "pendingLive": false,
      "lastTokens": 1050,
      "pendingKeep": 12
     },
     "expect": {
      "fired": true,
      "state": "summarizing",
      "emits": [
       {
        "event": "LLM_SUMMARIZE",
        "payload": {
         "text": "user: m0\nassistant: m1\nuser: m2\nassistant: m3"
        }
       }
      ],
      "entity": {
       "pendingKeep": 2,
       "lastTokens": 0
      }
     }
    }
   ],
   "defaults": [
    "ContextSummarizerLlm",
    "CtxChatRequest",
    "CtxChatHttp"
   ]
  },
  {
