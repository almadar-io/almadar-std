{
 "atom": "agent/atoms/std-agent-context.lolo",
 "trait": "AgentContextCompactor",
 "note": "compaction by reported token usage: a declared token limit summarizes a conversation the turn count would pass through",
 "cases": [
  {
   "id": "a-conversation-reply's-usage-is-kept-as-the-context-size",
   "config": {
    "keepMessages": 12,
    "tokenLimit": 1000,
    "keepMessagesOverLimit": 2
   },
   "steps": [
    {
     "trait": "AgentContextCompactor",
     "event": "UsageReported",
     "from": "ready",
     "payload": {
      "provider": "lmstudio",
      "model": "m",
      "action": "call-tools",
      "inputTokens": 900,
      "outputTokens": 150
     },
     "entity": {
      "id": "c",
      "pendingMessages": [],
      "lastSize": 0,
      "pendingInstructions": "",
      "pendingTools": [],
      "pendingEphemeral": false,
      "pendingHasLive": false,
      "pendingLive": false,
      "lastTokens": 0,
      "pendingKeep": 12
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "entity": {
       "lastTokens": 1050
      }
     }
    }
   ]
  },
  {
   "id": "control-an-embedding's-usage-is-not-the-conversation's",
