          },
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "ASSISTANT_REPLY_FAILED",
                "payload": {
                  "error": "cut",
                  "code": "output-cut"
                }
              }
            ],
            "neverEmits": [
              "LLM_TOOLS_ANSWERED",
              "LLM_CALL_TOOLS"
            ]
          }
        }
      ]
    }
  ]
}
