          },
          "payload": {
            "code": "output-cut",
            "message": "cut"
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "ASSISTANT_REPLY_FAILED",
                "payload": {
                  "error": "cut",
                  "code": "output-cut"
                }
              }
            ],
            "neverEmits": [
              "LLM_CALL_TOOLS"
            ]
          }
        }
      ],
      "defaults": [
        "LoopLlm",
        "LoopChatRequest",
        "LoopChatHttp"
      ]
