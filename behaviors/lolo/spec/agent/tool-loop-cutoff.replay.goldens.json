    {
      "id": "a-requested-tool-marks-the-turn-as-having-run-tools",
      "steps": [
        {
          "event": "ToolsRequested",
          "from": "thinking",
          "entity": {
            "id": "t",
            "toolsRan": false
          },
          "payload": {
            "session": "s",
            "calls": []
          },
          "expect": {
            "fired": true,
            "entity": {
              "toolsRan": true
            }
          }
        }
      ],
      "defaults": [
        "LoopLlm",
        "LoopChatRequest",
        "LoopChatHttp"
      ]
    },
    {
      "id": "a-second-cut-off-after-tools-ran-fails-the-turn",
