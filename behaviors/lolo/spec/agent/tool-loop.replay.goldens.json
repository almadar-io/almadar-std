{
 "atom": "agent/atoms/std-agent-tool-loop.lolo",
 "trait": "AgentToolLoop",
 "orbital": "AgentToolLoopOrbital",
 "note": "S1 deny by default (owner decision 5, 2026-10-27): a tool is offered to the model only when its `roles` include the signed-in viewer's role; empty or absent roles, and no viewer, offer nothing.",
 "cases": [
  {
   "id": "a-tool-granted-to-the-viewers-role-is-offered",
   "note": "S1: the read tool lists staff, and the viewer is staff.",
   "steps": [
    {
     "event": "CONVERSE",
     "from": "idle",
     "payload": {
      "messages": [
       {
        "role": "user",
        "content": "show my notes"
       }
      ]
     },
     "expect": {
      "fired": true,
      "state": "preparing"
     },
     "viewer": {
      "id": "u1",
      "role": "staff",
      "claims": []
     }
    },
    {
     "event": "INPUTS_KNOWN",
     "from": "preparing",
     "payload": {
      "result": {
       "inputs": [],
       "entities": [],
       "selected": []
      },
      "text": ""
     },
     "expect": {
      "fired": true,
      "state": "thinking",
      "emits": [
       {
        "event": "LLM_CALL_TOOLS",
        "payload": {
         "tools": [
          {
           "name": "read__Note",
           "description": "Read the Note rows you may see",
           "parameters": {
            "type": "object",
            "properties": {}
           }
          }
         ]
        }
       }
      ]
     },
     "viewer": {
      "id": "u1",
      "role": "staff",
      "claims": []
     }
    }
   ],
   "config": {
    "tools": [
     {
      "read": "Note",
      "roles": [
       "staff"
      ]
     }
    ]
   },
   "defaults": [
    "LoopLlm",
    "LoopChatRequest",
    "LoopChatHttp"
   ]
  },
  {
