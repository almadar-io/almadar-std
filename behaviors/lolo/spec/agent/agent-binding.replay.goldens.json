{
  "atom": "agent/atoms/std-agent-identity.lolo",
  "trait": "AgentBinding",
  "note": "The agent's own binding takes only the agent's presentation: a viewer's bare BEARER_PRESENT sent into the program never reaches it (G-CROSS-731).",
  "cases": [
    {
      "id": "a viewer's bare BEARER_PRESENT does not reach the agent binding",
      "steps": [
        {
          "event": "BEARER_PRESENT",
          "payload": {
            "requestId": 0,
            "authorization": "Bearer viewer-google-token",
            "clientId": "viewer-session"
          },
          "expect": {
            "fired": false
          }
        }
      ]
    },
    {
      "id": "control: the agent's own presentation is verified",
      "steps": [
        {
          "event": "AGENT_BEARER_PRESENT",
          "payload": {
            "requestId": 0,
            "authorization": "Bearer agent-token",
            "clientId": "agent-session"
          },
          "expect": {
            "fired": true,
            "emits": [
              {
                "event": "BEARER_VERIFY",
                "payload": {
                  "requestId": 0,
                  "authorization": "Bearer agent-token"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
