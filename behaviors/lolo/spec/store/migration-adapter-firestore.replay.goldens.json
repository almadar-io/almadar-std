      "refs": [
       {
        "ref": "a",
        "raw": "projects/p/databases/(default)/documents/c/d1"
       }
      ],
      "cursor": 1,
      "docs": [
       {
        "name": "projects/p/databases/(default)/documents/c/d1",
        "fields": {
         "n": {
          "integerValue": "abc"
         },
         "m": {
          "integerValue": "12"
         }
        }
       }
      ],
      "unreadable": []
     }
    }
   ],
