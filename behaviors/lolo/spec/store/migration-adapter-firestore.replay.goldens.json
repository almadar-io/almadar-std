     }
    ]
   },
   "steps": [
    {
     "from": "reading",
     "event": "FIRESTORE_NEXT",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_EXTRACTED",
        "payload": {
         "skipped": [
          {
           "ref": "fs:c/d1#field:n",
           "reason": "field 'n': integerValue 'abc' is not a number, so the field is left out of the unit"
