{
 "atom": "store/atoms/std-migration-adapter-firestore.lolo",
 "trait": "MigrationAdapterFirestore",
 "cases": [
  {
   "id": "a-reply-that-is-valid-json-but-not-a-document-is-unreadable",
   "config": {
    "recipes": [
     {
      "adapterId": "fs1",
      "documentUnit": true,
      "documentKind": "root",
      "documentSlots": [],
      "nodesField": "nodes",
      "nodeKinds": [],
      "edgesField": "edges",
      "edgeKind": "folder",
      "edgeSlots": []
     }
    ]
   },
   "steps": [
    {
     "from": "reading",
     "event": "FIRESTORE_REPLIED",
     "payload": {
      "status": 200,
      "body": "{\"x\":1}"
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_SOURCE_UNREADABLE",
        "payload": {
         "error": "the Firestore reply is not a document"
        }
       }
      ]
     },
     "entity": {
      "adapter": "fs1",
      "refs": [
       {
        "ref": "a",
        "raw": "projects/p/databases/(default)/documents/c/d1"
       }
      ],
      "cursor": 0,
      "docs": [],
      "unreadable": []
     }
    }
   ],
   "note": "the reply path from reading, seeded: program/step has no HTTP host, so the live GET of MIGRATION_EXTRACT would fail before the reply",
   "defaults": [
    "MigrationAdapterFirestoreHttp",
    "MigrationAdapterFirestoreTimeout"
   ]
  },
