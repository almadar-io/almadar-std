  {
   "id": "control-malformed-json-is-refused",
   "steps": [
    {
     "event": "ROW_READ",
     "payload": {
      "key": "k",
      "entityType": "Invoice",
      "id": "a"
     }
    },
    {
     "event": "FILE_READ",
     "from": "loading",
     "payload": {
      "data": "ew=="
     },
     "expect": {
      "state": "loading",
      "emits": [
       {
        "event": "FILE_UNREADABLE",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "FILE_UNREADABLE",
     "from": "loading",
     "payload": {},
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "STORE_FAILED",
        "payload": {
         "key": "k",
         "message": "the rows file must be JSON of the shape { rows, changes }; a bare array (the retired format) or malformed JSON is not accepted, recreate the file"
        }
       }
      ]
     }
    }
   ]
  },
