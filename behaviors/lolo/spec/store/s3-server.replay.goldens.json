   "steps": [
    {
     "event": "REQUEST_RECEIVED",
     "payload": {
      "requestId": 1,
      "method": "PUT",
      "path": "/s3/photos/a/b.jpg",
      "query": "",
      "headers": {
       "host": "orb.test",
       "content-type": "text/plain",
       "x-amz-content-sha256": "8f434346648f6b96df89dda901c5176b10a6d83961dd3c1ac88b59b2dc327aa4",
       "x-amz-date": "20231114T221320Z",
       "authorization": "AWS4-HMAC-SHA256 Credential=TESTKEYID/20231114/us-east-1/s3/aws4_request, SignedHeaders=content-type;host;x-amz-content-sha256;x-amz-date, Signature=fe6372341c0c0ca6e32e08a9d948f4dffbe99b1f1c601899b36dc68fb60da558"
      },
      "body": "aGk=",
      "peer": "127.0.0.1"
     }
    },
    {
     "event": "ROUTE_EXTERNAL",
     "payload": {
      "requestId": 1,
      "responseHeaders": []
     },
     "answers": [
      {
       "operator": "os/mkdir",
       "ok": {}
      },
      {
       "operator": "os/mkdir",
       "ok": {}
      },
      {
       "operator": "os/write-file",
       "ok": {
        "bytes": 2
       }
      },
      {
       "operator": "os/write-file",
       "ok": {
        "bytes": 10
       }
      }
     ],
     "expect": {
      "emits": [
       {
        "event": "S3_SIGV4",
        "payload": {
         "tag": "1",
         "method": "PUT",
         "path": "/s3/photos/a/b.jpg"
        }
       },
       {
        "event": "RESPOND",
        "payload": {
         "requestId": 1,
         "status": 200,
         "headers": [
          {
           "name": "etag",
           "value": "\"8f434346648f6b96df89dda901c5176b10a6d83961dd3c1ac88b59b2dc327aa4\""
          }
         ]
        }
       }
      ]
     }
    }
   ]
