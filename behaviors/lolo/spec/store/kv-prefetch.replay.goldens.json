{
  "atom": "store/atoms/std-kv-prefetch.lolo",
  "trait": "KvPrefetch",
  "note": "std-kv-prefetch KvPrefetch keeps a device copy of a wanted list of records: it reads its index once, fetches only records whose kept version differs, one at a time, keeps each under its id and records its version, skips a failed fetch, lets a newer wanted list replace the waiting one, and empties the store on CLEAR.",
  "cases": [
    {
      "id": "the-first-wanted-list-reads-the-index-then-fetches-the-first-record",
      "config": {},
      "steps": [
        {
          "event": "WANTED",
          "from": "idle",
          "entity": {
            "id": "p",
            "loaded": false,
            "queue": [],
            "known": []
          },
          "payload": {
            "items": [
              {
                "id": "a",
                "version": "2"
              }
            ]
          },
          "expect": {
            "state": "reading",
            "entity": {
              "loaded": true,
              "current": "a",
              "currentVersion": "2",
              "queue": []
            },
            "emits": [
              {
                "event": "FETCH",
                "payload": {
                  "id": "a"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "the-index-drops-records-already-kept-at-their-version",
      "config": {},
      "steps": [
        {
          "event": "INDEX_READ",
          "from": "reading",
          "entity": {
            "id": "p",
            "loaded": false,
            "queue": [
              {
                "id": "a",
                "version": "2"
              },
              {
                "id": "b",
                "version": "1"
              }
            ],
            "known": []
          },
          "payload": {
            "found": true,
            "value": {
              "items": [
                {
                  "id": "a",
                  "version": "1"
                },
                {
                  "id": "b",
                  "version": "1"
                }
              ]
            }
          },
          "expect": {
            "state": "ready",
            "entity": {
              "loaded": true,
              "current": "a",
              "currentVersion": "2",
              "queue": [],
              "known": [
                {
                  "id": "a",
                  "version": "1"
                },
                {
                  "id": "b",
                  "version": "1"
                }
              ]
            },
            "emits": [
              {
                "event": "FETCH",
                "payload": {
                  "id": "a"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-missing-index-fetches-everything",
      "config": {},
      "steps": [
        {
          "event": "INDEX_MISSED",
          "from": "reading",
          "entity": {
            "id": "p",
            "loaded": false,
            "queue": [
              {
                "id": "a",
                "version": "2"
              }
            ],
            "known": []
          },
          "payload": {
            "error": "no store",
            "kind": "unavailable"
          },
          "expect": {
            "state": "ready",
            "entity": {
              "loaded": true,
              "current": "a",
              "queue": []
            },
            "emits": [
              {
                "event": "FETCH",
                "payload": {
                  "id": "a"
                }
              }
            ]
          }
        }
      ]
    },
    {
