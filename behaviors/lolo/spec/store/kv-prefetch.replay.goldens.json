              "current": "a",
              "currentVersion": "2",
              "queue": [
                {
                  "id": "c",
                  "version": "5"
                }
              ]
            },
            "emits": [
              {
                "event": "FETCH",
                "payload": {
                  "id": "a"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-a-step-with-nothing-waiting-goes-idle",
      "config": {},
      "steps": [
        {
          "event": "PrefetchStep",
          "from": "ready",
          "entity": {
            "id": "p",
