{
 "atom": "store/atoms/std-migration-adapter-slack.lolo",
 "trait": "MigrationAdapterSlack",
 "cases": [
  {
   "id": "a-file-that-is-not-json-is-unreadable",
   "note": "the unreadable-envelope route",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "slack",
      "documents": [
       {
        "ref": "a.json",
        "raw": "not json"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_SOURCE_UNREADABLE",
        "payload": {
         "error": "Slack export file is not valid JSON"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-file-of-the-wrong-shape-is-unreadable",
   "note": "valid JSON that is not an array of messages",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "slack",
      "documents": [
       {
        "ref": "a.json",
        "raw": "{\"x\":1}"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_SOURCE_UNREADABLE",
        "payload": {
         "error": "Slack export file must be a JSON array of messages"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-message-without-text-is-skipped-with-its-reason",
   "note": "the per-record ledger",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "slack",
      "documents": [
       {
        "ref": "a.json",
        "raw": "[{\"type\":\"message\",\"ts\":\"1.0\",\"user\":\"U1\",\"text\":\"\"}]"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_EXTRACTED",
        "payload": {
         "skipped": [
          {
           "ref": "slack:channel:1.0",
           "reason": "empty message text"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-message-becomes-a-unit",
   "note": "a channel folder unit plus the message unit",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "slack",
      "documents": [
       {
        "ref": "a.json",
        "raw": "[{\"type\":\"message\",\"ts\":\"1.0\",\"user\":\"U1\",\"text\":\"hello\"}]"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_EXTRACTED",
        "payload": {
         "units": [
          {
           "ref": "slack:channel:channel",
           "kind": "folder",
           "title": "#channel",
           "content": null,
           "parentRef": null,
           "source": "slack",
           "span": "a.json",
           "metadata": {
            "source": "slack"
           }
          },
          {
           "ref": "slack:channel:1.0",
           "kind": "root",
           "title": null,
           "content": "hello",
           "parentRef": "slack:channel:channel",
           "source": "slack",
           "span": "a.json#0",
           "metadata": {
            "source": "slack",
            "channel": "channel",
            "ts": "1.0",
            "author": "U1"
           }
          }
         ],
         "skipped": []
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
