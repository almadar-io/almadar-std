  {
   "id": "good-singleton-write",
   "steps": [
    {
     "event": "ROW_TARGET_RESOLVE",
     "payload": {
      "op": "write",
      "entityType": "Cursor",
      "singleton": true,
      "target": {
       "kind": "singleton"
      },
      "domainId": "cursor-1"
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "ROW_TARGET_RESOLVED",
        "payload": {
         "op": "write",
         "entityType": "Cursor",
         "storageKey": "singleton",
         "domainId": "cursor-1"
        }
       }
      ]
     }
    }
   ]
  },
