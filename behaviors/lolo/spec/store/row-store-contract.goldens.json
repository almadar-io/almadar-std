{
 "source": "packages/almadar-db/test/support/persistence-contract.ts (persistence-contract.test.ts over InMemoryPersistence and IndexedDbPersistence)",
 "atom": "store/atoms/std-row-store-file.lolo",
 "spec": "spec/store/row-store.lolo",
 "note": "CRUD contract every adapter runs. Each case is a sequence of steps over entity types Invoice, Ledger, Empty; `expect` is a subset match on the row read back (or null / the sorted id list).",
 "cases": [
  {
   "id": "create-returns-given-id",
   "steps": [
    {
     "op": "create",
     "entityType": "Invoice",
     "data": {
      "id": "INV-1",
      "amount": 4
     },
     "expect": {
      "id": "INV-1"
     }
    },
    {
     "op": "getById",
     "entityType": "Invoice",
     "id": "INV-1",
     "expect": {
      "id": "INV-1",
      "amount": 4
     }
    }
   ]
  },
  {
   "id": "create-without-id-mints-one",
   "steps": [
    {
     "op": "create",
     "entityType": "Invoice",
     "data": {
      "amount": 4
     },
     "expect": {
      "idNonEmptyString": true
     }
    },
    {
     "op": "getById",
     "entityType": "Invoice",
     "id": "<minted>",
     "expect": {
      "amount": 4
     }
    }
   ]
  },
  {
   "id": "update-merges",
   "steps": [
    {
     "op": "create",
     "entityType": "Invoice",
     "data": {
      "id": "INV-1",
      "amount": 4,
      "status": "draft"
     }
    },
    {
     "op": "update",
     "entityType": "Invoice",
     "id": "INV-1",
     "data": {
      "status": "paid"
     }
    },
    {
     "op": "getById",
     "entityType": "Invoice",
     "id": "INV-1",
     "expect": {
      "id": "INV-1",
      "amount": 4,
      "status": "paid"
     }
    }
   ]
  },
  {
   "id": "update-missing-creates-nothing",
   "steps": [
    {
     "op": "update",
     "entityType": "Invoice",
     "id": "NOPE",
     "data": {
      "status": "paid"
     }
    },
    {
     "op": "getById",
     "entityType": "Invoice",
     "id": "NOPE",
     "expect": null
    }
   ]
  },
  {
   "id": "delete-removes",
   "steps": [
    {
     "op": "create",
     "entityType": "Invoice",
     "data": {
      "id": "INV-1"
     }
    },
    {
     "op": "delete",
     "entityType": "Invoice",
     "id": "INV-1"
    },
    {
     "op": "getById",
     "entityType": "Invoice",
     "id": "INV-1",
     "expect": null
    }
   ]
  },
  {
   "id": "list-one-entity-type-only",
   "steps": [
    {
     "op": "create",
     "entityType": "Invoice",
     "data": {
      "id": "INV-1"
     }
    },
    {
     "op": "create",
     "entityType": "Invoice",
     "data": {
      "id": "INV-2"
     }
    },
    {
     "op": "create",
     "entityType": "Ledger",
     "data": {
      "id": "L-1"
     }
    },
    {
     "op": "listIds",
     "entityType": "Invoice",
     "sorted": true,
     "expect": [
      "INV-1",
      "INV-2"
     ]
    },
    {
     "op": "listIds",
     "entityType": "Empty",
     "expect": []
    }
   ]
  }
 ]
}
