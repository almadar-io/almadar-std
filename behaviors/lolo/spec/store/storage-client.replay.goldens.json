{
 "atom": "store/atoms/std-storage.lolo",
 "trait": "StorageClient",
 "note": "StorageClient: the stateless request builder (rebindable). Each entry validates its input and emits STORAGE_REQUEST to the gate; the gate is not a default trait here, so each entry stops there. Knob: bucket.",
 "cases": [
  {
   "id": "bad-percent-encoding-fails",
   "steps": [
    {
     "event": "STORAGE_UPLOAD",
     "payload": {
      "bucket": "my-bucket",
      "file": {
       "name": "a.txt",
       "size": 5,
       "type": "text/plain",
       "content": "data:text/plain,%E0%A4%A"
      }
     },
     "expect": {
      "emits": [
       {
        "event": "STORAGE_FAILED",
        "payload": {
         "message": "URI malformed"
        }
       }
      ]
     }
    }
   ],
   "config": {},
   "defaults": [],
   "credentials": {
    "STORAGE_SECRET_ACCESS_KEY": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
   }
  },
