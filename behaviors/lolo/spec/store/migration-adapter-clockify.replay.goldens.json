{
 "atom": "store/atoms/std-migration-adapter-clockify.lolo",
 "trait": "MigrationAdapterClockify",
 "cases": [
  {
   "id": "an-export-that-is-not-json-is-unreadable",
   "note": "the unreadable-envelope route",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "clockify",
      "documents": [
       {
        "ref": "a.json",
        "raw": "not json"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_SOURCE_UNREADABLE",
        "payload": {
         "error": "Clockify export is not valid JSON"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-export-of-the-wrong-shape-is-unreadable",
   "note": "valid JSON that is neither an entry array nor a report holding timeentries",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "clockify",
      "documents": [
       {
        "ref": "a.json",
        "raw": "{\"x\":1}"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_SOURCE_UNREADABLE",
        "payload": {
         "error": "Clockify export must be an entry array or { timeentries: [...] }"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-entry-without-a-start-is-skipped-with-its-reason",
   "note": "the per-record ledger",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "clockify",
      "documents": [
       {
        "ref": "a.json",
        "raw": "[{\"id\":\"e1\",\"description\":\"d\",\"projectName\":\"P\"}]"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_EXTRACTED",
        "payload": {
         "units": [],
         "skipped": [
          {
           "ref": "clockify:a.json:e1",
           "reason": "entry has no timeInterval.start"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-entry-with-a-start-becomes-a-project-and-a-unit",
   "note": "a project folder unit plus the entry unit",
   "steps": [
    {
     "event": "MIGRATION_EXTRACT",
     "payload": {
      "adapter": "clockify",
      "documents": [
       {
        "ref": "a.json",
        "raw": "[{\"id\":\"e1\",\"description\":\"d\",\"projectName\":\"P\",\"timeInterval\":{\"start\":\"2026-01-01T00:00:00Z\",\"end\":\"2026-01-01T01:00:00Z\",\"duration\":\"PT1H\"}}]"
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "MIGRATION_EXTRACTED",
        "payload": {
         "units": [
          {
           "ref": "clockify:a.json:project:p",
           "kind": "folder",
           "title": "P",
           "content": null,
           "parentRef": null,
           "source": "clockify",
           "span": "a.json",
           "metadata": {
            "source": "clockify"
           }
          },
          {
           "ref": "clockify:a.json:e1",
           "kind": "root",
           "title": "d",
           "content": null,
           "parentRef": "clockify:a.json:project:p",
           "source": "clockify",
           "span": "a.json#0",
           "metadata": {
            "source": "clockify",
            "start": "2026-01-01T00:00:00Z",
            "billable": false,
            "end": "2026-01-01T01:00:00Z",
            "duration": "PT1H"
           }
          }
         ],
         "skipped": []
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
