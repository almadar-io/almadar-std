    {
     "event": "STORE_FAILED",
     "payload": {
      "key": "pg",
      "message": "cannot connect to postgres.example.test:5432: refused"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PG_FAILED",
        "payload": {
         "kind": "failed",
         "message": "cannot connect to postgres.example.test:5432: refused"
        }
       }
      ]
     }
    }
   ]
  }
 ]
}