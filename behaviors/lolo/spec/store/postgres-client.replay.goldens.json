         "message": "relation \"missing_table\" does not exist"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "bad-an-unreachable-server-answers-failed",
   "steps": [
    {
     "event": "PG_QUERY",
     "payload": {
      "sql": "SELECT 1"
     },
     "from": "idle",
     "entity": {
      "id": "c"
     }
