  {
   "id": "pin-upload-of-a-key-and-content-pair-asks-to-resolve",
   "config": {
    "region": "us-east-1",
    "bucket": "my-bucket"
   },
   "steps": [
    {
     "event": "STORAGE_UPLOAD",
     "payload": {
      "bucket": "my-bucket",
      "key": "k.txt",
      "content": "hello",
      "contentType": "text/plain"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "STORAGE_RESOLVE",
        "payload": {
         "mode": "single",
         "bucket": "my-bucket",
         "key": "k.txt",
         "hasFile": false,
         "hasContent": true,
         "raw": "hello"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "pin-resolve-with-neither-a-file-nor-a-pair-fails",
   "config": {
    "region": "us-east-1",
    "bucket": "my-bucket"
   },
   "steps": [
    {
     "event": "STORAGE_RESOLVE",
     "payload": {
      "mode": "single",
      "bucket": "my-bucket",
      "hasFile": false,
      "hasContent": false,
      "raw": "",
      "key": "",
      "fileName": "",
      "fileSize": 0,
      "fileType": "",
      "contentType": "",
      "acl": "",
      "maxSize": 0,
      "batch": ""
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "STORAGE_FAILED",
        "payload": {
         "message": "upload requires either `file` (with content) or the `key` + `content` pair"
        }
       }
      ]
     }
    }
   ]
  },
