       {
        "event": "STORAGE_FAILED",
        "payload": {
         "message": "The listing could not be read"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "list-truncated-unreadable-last-modified-fails",
   "steps": [
    {
     "event": "STORAGE_LIST_REPLIED",
     "payload": {
      "status": 200,
      "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ListBucketResult><IsTruncated>true</IsTruncated><NextContinuationToken>tok</NextContinuationToken><Contents><Key>a.txt</Key><Size>5</Size><LastModified></LastModified></Contents></ListBucketResult>",
      "headers": {},
      "key": "k"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "STORAGE_FAILED",
        "payload": {
         "message": "The listing could not be read"
        }
       }
      ]
     }
    }
   ]
  },
