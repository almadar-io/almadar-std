app file-drop-spec [
  version: "1.0.0",
  description: "Design contract for a file drop: a delivery of named bytes is written under one directory and answered with where it went, or refused with why; a name that could leave the directory is refused before anything is written."
]

orbital FileDropSpec {
  expects trait FileDrop {
    emits {
      FILE_DROPPED { path : string! }
      FILE_DROP_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/file-drop" -> FileDrop
}
