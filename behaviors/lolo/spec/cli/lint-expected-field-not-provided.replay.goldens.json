{
  "atom": "cli/atoms/std-orb-lint-expected-field-not-provided.lolo",
  "trait": "OrbLintExpectedFieldNotProvided",
  "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. Cases copy tests/expectations_validation.rs (a_present_but_incompatible_provider_still_errors, an_expected_field_the_provider_lacks_is_reported, a_provider_superset_satisfies_the_expectation, an_event_payload_the_provider_carries_is_satisfied, an_event_payload_field_the_provider_lacks_is_not_provided, control_an_event_expectation_without_a_payload_ignores_the_providers_payload); the rest pin the identity and bare-identity shape arms, shape order and the no-emit and no-schema events. The compatibility arms (requiredness, vocabulary, type) of the same Rust functions are not this rule.",
  "cases": [
    {
      "id": "an-expected-field-the-provider-lacks-is-reported",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "App",
              "orbitals": [
                {
                  "name": "ConsumerOrbital",
                  "expects": [
                    {
                      "kind": "entity",
                      "name": "OrderRecord",
                      "shape": [
                        {
                          "name": "totalAmount",
                          "type": "number"
                        }
                      ]
                    }
                  ],
                  "entity": {
                    "name": "Cart",
                    "persistence": "persistent",
                    "collection": "carts",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [],
                  "pages": []
                },
                {
                  "name": "OrderOrbital",
                  "entity": {
                    "name": "OrderRecord",
                    "identity": false,
                    "persistence": "persistent",
                    "collection": "orders",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [],
                  "pages": []
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintExpectedFieldNotProvided"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "expected-field-not-provided",
                  "findings": [
                    {
                      "code": "ORB_S_EXPECTED_FIELD_NOT_PROVIDED",
                      "path": "orbitals[0 (ConsumerOrbital)].expects[0].totalAmount",
                      "message": "`ConsumerOrbital` expects `OrderRecord.totalAmount`; `OrderRecord` declares no such field.",
                      "suggestion": "Add `totalAmount` to `OrderRecord`, or drop it from `ConsumerOrbital`'s expectation.",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintExpectedFieldNotProvided"
        }
      ]
    },
