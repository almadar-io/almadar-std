app orb-census-spec [
  version: "1.0.0",
  description: "Design contract for `orb census <package-name>`, the consumer census a package passes before it moves to archive/ (port of tools/almadar-retire). It reports every file outside the package's own directory that imports it (TS and JS sources: from, import(), require(), any subpath) and every package.json that depends on it (all four dependency kinds and the overrides tables), one CensusHit per file, then a `<name>: N import file(s), M manifest edge(s)` line. Flags: `--root <dir>` (a directory inside the working directory; the default is the working directory), `--json`, `--path <dir>` (repeatable), `--max-bytes <n>` (default 67108864) and several package names, any number of each; no name and no --path, an unknown flag or a flag missing its value answers the usage `usage: orb census [--root <dir>] [--json] [--path <dir>]... <package-name>...` with status 400 (exit 2). The cases: (1) a manifest edge prints `  manifest <file> <kind> <range>`, where kind is dependencies, devDependencies, peerDependencies, optionalDependencies, pnpm.overrides, overrides or resolutions and range is the declared value (`dependencies ^6.111.0`), and the root package.json is included; (2) an import file prints `  import   <file> <specifier>, <specifier>` with every matched specifier of the file in order, subpaths included (`@almadar/logger/node`), and a longer name (`@almadar/logger-x`) is not a match; (3) a package.json whose own name is the package, and every import under that package.json's directory, is not a consumer; (4) --path <dir> adds (root-level files are never referrers, only the root package.json is read, as a manifest) a `<dir>: N file(s) name this path` line with one `  path     <file>` per file under the root, outside <dir>, of a TS, JS, JSON, shell, YAML, TOML, Rust or Python file that names the directory (a path boundary before it, none after: `packages/x` does not match `packages/xy`), the lock files and .d.ts excluded; (5) --json prints the report as an object keyed by name (and by path) with imports `{file, specifiers}`, manifests `{file, kind, range}` and references `{file}`, plus an `unscanned` array when any; (6) manifests (every package.json) are read unguarded by --max-bytes; a file over --max-bytes is never read: it is listed once under `UNSCANNED (over <n> bytes, not read): N file(s)` with one `  <file>` line each, sorted; the guard stats the TS and JS source files, and when --path is given also every JSON, shell, YAML, TOML, Rust and Python file, as the tool does; (7) the walk skips node_modules, dist, target, archive, .git, .next, .turbo, .orbital, .vite and build directories by name at every depth, never descends into them, reads only the root package.json from the root directory itself, and ignores symlinks; (8) the answer is status 500 (exit 1) when any package or path has a consumer or any file is unscanned, else 200 (exit 0); the tool exits 3 for unscanned-only and the answer record has no exit code, so that one distinction waits on `InboundAnswer.exit`; a name that nothing uses prints `<name>: 0 import file(s), 0 manifest edge(s)`; (9) a whole-repo run finishes inside the 180 s guard: the walk lists directories one by one and prunes, because os/glob cannot prune and its `**` re-walks the whole tree under its literal prefix for every pattern."
]

type CensusHit = { name : string!, file : string!, kind : string!, label : string!, detail : string! }
type CensusReport = { name : string!, imports : number!, manifests : number!, hits : [CensusHit]! }

orbital OrbCensusSpec {
  expects trait OrbCensus {
    state ready
    emits {
      CENSUS_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbCensus
}
