        },
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "p",
              "orbitals": [
                {
                  "name": "O",
                  "traits": [
                    {
                      "name": "T",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "INIT"
                          },
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "GO",
                            "effects": [
                              [
                                "set",
                                "@entity.out",
                                [
                                  "array/pmap",
