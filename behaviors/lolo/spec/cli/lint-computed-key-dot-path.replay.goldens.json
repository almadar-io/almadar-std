{
  "atom": "cli/atoms/std-orb-lint-computed-key-dot-path.lolo",
  "trait": "OrbLintComputedKeyDotPath",
  "note": "A computed key of object/get, object/has or object/set is read as one whole key; only a literal string key is a dotted path. A key built with str/concat from a string literal containing \".\" was meant as a path and is an error. Literal path keys, other separators, binding pieces and keys from value/key are clean.",
  "cases": [
    {
      "id": "object-get-with-a-dotted-concat-key-on-a-record-is-found",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "app",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "Run",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "cache",
                        "type": "object",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "name": "rec",
                        "type": "object",
                        "properties": {
                          "a": {
                            "name": "a",
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "T",
                      "linkedEntity": "Run",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "GO",
                            "effects": [
                              [
                                "set",
                                "@entity.rec",
                                [
                                  "object/get",
                                  "@payload.doc",
                                  [
                                    "str/concat",
                                    [
                                      "object/get",
                                      "@payload.row",
                                      "store"
                                    ],
                                    ".",
                                    [
                                      "object/get",
                                      "@payload.row",
                                      "field"
                                    ]
                                  ]
                                ]
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "trait": "OrbLintComputedKeyDotPath"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "computed-key-dot-path",
                  "scope": "",
                  "findings": [
                    {
                      "code": "ORB_COMPUTED_KEY_DOT_PATH",
                      "path": "orbitals[0 (O)].traits[0 (T)].stateMachine.transitions[0]",
                      "message": "object/get reads a computed key as one whole key, so the key built with str/concat from a literal containing \".\" names a single key and never a path",
                      "suggestion": "Pass the path as a string literal (only a literal key is a dotted path), or join the key parts with a separator other than \".\", such as \"|\".",
                      "severity": "error"
                    }
                  ]
                }
              }
            ]
          },
          "trait": "OrbLintComputedKeyDotPath"
        }
      ]
    },
