app lint-orbital-missing-pages-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint orbital-missing-pages <file>`. It lowers the file with program/read and reports ORB_O_MISSING_PAGES for every non-spec orbital that declares no page, with its path and suggestion (status 500, exit 1). Clean answers `lint orbital-missing-pages: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintOrbitalMissingPagesSpec {
  expects trait OrbLintOrbitalMissingPages {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintOrbitalMissingPagesCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintOrbitalMissingPages, OrbLintOrbitalMissingPagesCli
}
