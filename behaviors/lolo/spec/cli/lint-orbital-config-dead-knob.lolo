app lint-orbital-config-dead-knob-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint orbital-config-dead-knob <file>`. It resolves the file with program/read and reports ORB_O_CONFIG_DEAD_KNOB for every declared program-level or orbital-level config knob that no trait publishes through a `@config.<knob>` forward (status 500, exit 1). Clean answers `lint orbital-config-dead-knob: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintOrbitalConfigDeadKnobSpec {
  expects trait OrbLintOrbitalConfigDeadKnob {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintOrbitalConfigDeadKnobCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintOrbitalConfigDeadKnob, OrbLintOrbitalConfigDeadKnobCli
}
