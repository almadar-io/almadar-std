{
 "atom": "cli/atoms/std-orb-lint-tick-requires-runtime.lolo",
 "trait": "OrbLintTickRequiresRuntime",
 "cases": [
  {
   "id": "persistent-with-numeric-tick",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "traits": [
          {
           "name": "Cooldown",
           "ticks": [
            {
             "name": "Tick",
             "interval": 100,
             "effects": []
            }
           ],
           "linkedEntity": "CooldownRecord"
          }
         ],
         "entity": {
          "name": "CooldownRecord",
          "persistence": "persistent"
         }
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "tick-requires-runtime",
         "findings": [
          {
           "code": "ORB_TICK_REQUIRES_RUNTIME",
           "path": "orbitals[0 (A)].traits[0 (Cooldown)].ticks",
           "message": "trait \"Cooldown\" runs a non-cron tick against entity \"CooldownRecord\", which is Persistent — a persistent entity mutated on every tick is usually meant to be [runtime]",
           "suggestion": "Mark entity \"CooldownRecord\" [runtime], or switch the tick to a Cron interval if it's a server-scheduled job",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
