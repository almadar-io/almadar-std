app lint-type-param-sweep-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint type-param-sweep <file>`, the port of the compiler rule ORB_T_UNRESOLVED_TYPE_PARAM. The file is lowered with program/read. A type variable or type-parameter sentinel that survived resolution is reported as `[ORB_T_UNRESOLVED_TYPE_PARAM] <path>: <message>`, status 500 (exit 1): in an entity field shape, in an emit or event payload field, in a config knob's nested shape or own type, or as an unresolved sigil type on a config knob. A clean program answers `lint type-param-sweep: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintTypeParamSweepSpec {
  expects trait OrbLintTypeParamSweep {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintTypeParamSweepCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintTypeParamSweep, OrbLintTypeParamSweepCli
}
