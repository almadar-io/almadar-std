    {
     "trait": "OrbLintListenRedundantEmbedRoute",
     "event": "LINT_INPUT",
     "from": "ready",
     "payload": {
      "file": "a.lolo",
      "raw": "",
      "latin": true,
      "program": {
       "name": "redundant-route",
       "version": "1.0.0",
       "orbitals": [
        {
         "name": "O",
         "entity": {
          "name": "Row",
          "persistence": "persistent",
          "fields": [
           {
            "name": "id",
            "type": "string",
            "required": true
           }
          ]
         },
         "traits": [
          {
           "name": "Host",
           "linkedEntity": "Row",
           "config": {
            "body": {
             "type": "string",
             "default": "@trait.Child"
            }
           },
           "listens": [
            {
             "event": "REQUEST",
             "triggers": "REQUEST",
             "source": {
              "kind": "trait",
              "trait": "Child"
             }
            }
           ],
           "stateMachine": {
            "states": [],
            "events": [],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "REQUEST",
              "effects": []
             }
            ]
           }
          },
          {
           "name": "Child",
           "linkedEntity": "Row",
           "stateMachine": {
            "states": [],
            "events": [],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "button",
                 "action": "REQUEST",
                 "label": "Go"
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": []
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "fired": true
     }
    },
    {
     "trait": "OrbLintListenRedundantEmbedRoute",
     "event": "FIRED_HEARD",
     "from": "ready",
     "payload": {
      "scope": "",
      "byControl": {
       "Child": [
        "REQUEST"
       ],
       "Host": []
      },
      "byEffect": {
       "Child": [],
       "Host": []
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintListenRedundantEmbedRoute",
     "event": "LINT_FINISH",
     "from": "ready",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "listen-redundant-embed-route",
         "scope": "",
         "findings": [
          {
           "code": "ORB_LISTEN_REDUNDANT_EMBED_ROUTE",
           "path": "orbitals.O.traits.Host.listens",
           "message": "listens route Child.REQUEST -> REQUEST on 'Host' is redundant: 'Host' embeds 'Child', so the control's REQUEST already reaches 'Host' as its own transition, and the route delivers the same event a second time",
           "suggestion": "delete the `Child.REQUEST -> REQUEST` listen from 'Host'",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
