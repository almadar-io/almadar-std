app lint-entity-empty-enum-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint entity-empty-enum <file>`. It lowers the file with program/read and, for every orbital's inline entity, reports each top-level field of type enum whose values list is empty or absent, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint entity-empty-enum: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]

orbital LintEntityEmptyEnumSpec {
  expects trait OrbLintEntityEmptyEnum {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [string]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintEntityEmptyEnumCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-entity-empty-enum" -> OrbLintEntityEmptyEnum, OrbLintEntityEmptyEnumCli
}
