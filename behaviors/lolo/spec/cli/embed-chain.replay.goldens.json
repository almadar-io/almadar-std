{
 "atom": "cli/atoms/std-orb-embed-chain.lolo",
 "trait": "OrbEmbedChain",
 "note": "Cases for the EmbedGraph host chain the compiler builds (phases/program/embed_graph.rs): direct and transitive hosts, the reference sites (config default, guard, effect, tick), first referrer wins, self and cyclic references, `@trait.Name.field` and `@trait.Name[i]` forms, and per-orbital scoping.",
 "cases": [
  {
   "id": "a-config-default-reference-makes-the-referrer-the-host",
   "steps": [
    {
     "trait": "OrbEmbedChain",
     "event": "EMBED_INPUT_HEARD",
     "from": "ready",
     "payload": {
      "file": "a.lolo",
      "raw": "",
      "latin": true,
      "program": {
       "name": "p",
       "orbitals": [
        {
         "name": "O",
         "entity": {
          "name": "OE",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "Host",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": []
             }
            ]
           },
           "config": {
            "body": {
             "type": "string",
             "default": "@trait.Child"
            }
           }
          },
          {
           "name": "Child",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": []
             }
            ]
           }
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "EMBED_CHAINS",
        "payload": {
         "scope": "",
         "chains": [
          {
           "Host": [],
           "Child": [
            "Host"
           ]
          }
         ]
        }
       }
      ]
     }
    }
   ]
