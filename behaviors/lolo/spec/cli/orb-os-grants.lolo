app orb-os-grants-spec [
  version: "1.0.0",
  description: "Design contract for `orb os-grants <file>`; see the atom."
]
orbital OrbOsGrantsSpec {
  expects trait OrbOsGrants {
    state ready
    emits {
      GRANTS_ANSWERED { status : number!  body : string!  stderr : string }
    }
  }
  expects page boot -> OrbOsGrants
}
