         "pages": [
          {
           "name": "P",
           "path": "",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintPagePath"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "page-path",
         "findings": [
          {
           "code": "ORB_P_MISSING_PATH",
           "path": "orbitals[0].pages[0].path",
           "message": "Page path is required",
           "suggestion": "Add a path starting with / (e.g., '/tasks', '/users/:id')",
           "severity": "error"
