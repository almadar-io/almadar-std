app lint-route-init-params-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint route-init-params <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }

orbital LintRouteInitParamsSpec {
  expects trait OrbLintRouteInitParams {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintRouteInitParamsCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintRouteInitParams, OrbLintRouteInitParamsCli
}
