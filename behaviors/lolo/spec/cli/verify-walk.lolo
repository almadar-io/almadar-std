app verify-walk-spec [
  version: "1.0.0",
  description: "Design contract for `orb verify-walk <program>`: the L1 walk. VERIFY_WALK_START carries cwd so validation uses the same source path and sibling locale catalogs as `orb validate`; it optionally accepts viewer and owners, forwards them to the planner and dispatches every baseline step as that viewer. `--as <role>` sets the viewer's declared role member (a role the identity entity does not declare is refused) and `--render` turns the render probe on for the judge. Without a viewer, the walk plays every row as the viewer the planner answers: a sample row of the program's one identity entity, or anonymous when the program declares none. An internal caller may request render=true to supply the kernel's render-probe nodes to the existing judge and strict=true to require zero failed, unplanned, guard-blocked, and gap rows. The public verify-walk command retains its transition-walk status rule: failed rows exit 1, usage errors exit 2. It reads the program, enumerates every (trait, from, event) transition of its machines, plays each through the kernel with a payload built from the event's declared fields, and prints one report row per transition and totals. A reply route that is never driven is a gap unless std-verify-credit credits it from a fired hop. PENDING PS1: the walk records only each step's own hop; credit becomes decisive once program/step outcomes[] carry every cascaded hop."
]

type VerifyRow = { trait : string!, from : string!, event : string!, to : string!, verdict : string!, detail : string }

orbital VerifyWalkSpec {
  expects entity VerifyReport [runtime] {
    id : string!
    rows : [VerifyRow]!
    passed : number!
    failed : number!
    unplanned : number!
    guardBlocked : number!
  }
  expects trait VerifyWalk {
    state ready
    emits {
      VERIFY_WALK_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> VerifyWalk
}
