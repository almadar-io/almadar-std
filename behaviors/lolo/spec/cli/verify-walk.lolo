app verify-walk-spec [
  version: "1.0.0",
  description: "Design contract for `orb verify-walk <program>`: the L1 walk. It reads the program, enumerates every (trait, from, event) transition of its machines, plays each through the kernel with a payload built from the event's declared fields, and prints one report row per transition (trait, from, event, to, verdict), then the totals (passed, failed, unplanned, guard-blocked); verdicts are pass, fail, guard-blocked (a guard blocked the declared payload) and unplanned (a required payload slot declares no value, so no payload is invented); exit 0 when every verdict passes, 1 otherwise, 2 on a usage error. A reply route (an event an http, redis or postgres effect emits, or a listener it triggers) is never driven: it is reported as a gap (counted apart, appended to the totals only when present) unless std-verify-credit credits it from a hop another step fired. PENDING PS1: the walk records only each step's own hop; credit becomes decisive once program/step outcomes[] carry the event and arm of every cascaded hop, so a failure route fired by its request can be credited."
]

type VerifyRow = { trait : string!, from : string!, event : string!, to : string!, verdict : string!, detail : string }

orbital VerifyWalkSpec {
  expects entity VerifyReport [runtime] {
    id : string!
    rows : [VerifyRow]!
    passed : number!
    failed : number!
    unplanned : number!
    guardBlocked : number!
  }
  expects trait VerifyWalk {
    state ready
    emits {
      VERIFY_WALK_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/verify-walk" -> VerifyWalk
}
