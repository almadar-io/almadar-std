{
 "atom": "cli/atoms/std-orb-lint-duplicate-transition.lolo",
 "trait": "OrbLintDuplicateTransition",
 "cases": [
  {
   "id": "identical-guarded-arms",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "traits": [
          {
           "name": "T",
           "stateMachine": {
            "transitions": [
             {
              "from": "paused",
              "to": "paused",
              "event": "INIT",
              "guard": [
               "not",
               "@config.autoStart"
              ]
             },
             {
              "from": "paused",
              "to": "paused",
              "event": "INIT",
              "guard": [
               "not",
               "@config.autoStart"
              ]
             }
            ]
           }
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "duplicate-transition",
         "findings": [
          {
           "code": "ORB_T_DUPLICATE_TRANSITION",
           "path": "orbitals[0].traits[0].stateMachine.transitions",
           "message": "Duplicate transitions from 'paused' on event 'INIT' with the same guard",
           "suggestion": "Remove the repeated arm, or give each arm its own guard",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
