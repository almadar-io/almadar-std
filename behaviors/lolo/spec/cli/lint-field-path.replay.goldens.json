{
  "atom": "cli/atoms/std-orb-lint-field-path.lolo",
  "trait": "OrbLintFieldPath",
  "note": "The Rust validate_field_paths has no unit test of its own; these cases pin the behavior read from field_path.rs and the pattern.rs walk. Entity definitions are the orbitals' primary and auxiliary entities, later replacing earlier, as mod.rs builds them. Not ported: ORB_X_UNRESOLVED_PATTERN_FIELD_REF (tests/pattern_field_ref_validation.rs; needs the registry's field-ref prop kinds) and the expansion of operator-call children.",
  "cases": [
    {
      "id": "a-valid-nested-path-is-clean",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "app",
              "orbitals": [
                {
                  "name": "Home",
                  "traits": [
                    {
                      "name": "Tour",
                      "stateMachine": {
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "INIT",
                            "effects": [
                              [
                                "render-ui",
                                "main",
                                {
                                  "type": "data-grid",
                                  "entity": "Task",
                                  "fields": [
                                    "title",
                                    "company.name"
                                  ]
                                }
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ],
                  "entity": {
                    "name": "Task",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "title",
                        "type": "string"
                      },
                      {
                        "name": "company",
                        "type": "relation",
                        "relation": {
                          "entity": "Company"
                        }
                      }
                    ]
                  },
                  "auxiliaryEntities": [
                    {
                      "name": "Company",
                      "persistence": "runtime",
                      "fields": [
                        {
                          "name": "name",
                          "type": "string"
                        },
                        {
                          "name": "address",
                          "type": "string"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          }
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "field-path",
                  "findings": [],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintFieldPath"
        }
      ]
    },
