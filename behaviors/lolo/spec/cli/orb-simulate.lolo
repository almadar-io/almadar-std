app orb-simulate-spec [
  version: "1.0.0",
  description: "Design contract for `orb simulate <file>`, the port of `orb validate --simulate` (orbital-cli commands/simulate.rs): the render simulation that traces every state reachable from each page trait's initial state and reports what its transitions render. The file is lowered with program/read. For every orbital with pages, every inline page lists `Page: <name> (<path>)`; each of the orbital's inline traits the page names (by ref or name) is walked breadth first from its first initial state (`(unknown)` when none), printing `  State: <s>` (with ` (initial)` on the first), and per transition leaving that state in declaration order `    <EVENT> transition:` (`transition (guarded):` when it has a guard); then `      📦 fetch \"<entity>\"` for each fetch, one `      ✅ Slot \"<slot>\" ← [<type>] (<props except type>)` per render-ui (🗑️ and `[null (clear)]` for a null pattern; `?` for a missing slot or type), a `⚠️  WARNING: entity prop present but no fetch in this transition` line under a render that names an entity prop when the transition has no fetch, and `      (no render-ui effects)` when it has neither. A state the walk never reached ends the trait with `  ⚠️  Unreachable states: [...]`. The report opens with a blank line, `🔍 Render Simulation` and a 60-character rule and closes with the rule, `Simulation complete.` and a blank line (status 200, exit 0). Anything but one file argument is the usage `usage: orb simulate <file>` (status 400, exit 2); an unreadable or unlowerable file is status 500."
]

orbital OrbSimulateSpec {
  expects trait OrbSimulate {
    state ready
    emits {
      SIMULATE_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-simulate" -> OrbSimulate
}
