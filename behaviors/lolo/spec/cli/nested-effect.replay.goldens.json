{
  "atom": "spec/cli/nested-effect-fixture.lolo",
  "trait": "NestedEffect",
  "note": "G-ORB-498: the transition is (let ((x 1)) (emit FOO { n: @x })). A compound effect carries `nested`, the effects its body ran; `expect.effects` asserts them with a recursive `nested` key (ordered subsequence at every level). The let reports executed when its body ran.",
  "cases": [
    {
      "id": "control-emits-sees-the-nested-emit",
      "steps": [
        {
          "from": "ready",
          "event": "GO",
          "expect": {
            "fired": true,
            "emits": [
              {
                "event": "FOO",
                "payload": {
                  "n": 1
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "effects-assert-the-nested-emit-under-its-let",
      "note": "The emit FOO is asserted as the let's nested effect, by name (arg0), and the let by status.",
      "steps": [
        {
          "from": "ready",
          "event": "GO",
          "expect": {
            "fired": true,
            "effects": [
              {
                "type": "let",
                "status": "executed",
                "nested": [
                  {
                    "type": "emit",
                    "arg0": "FOO"
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "id": "blind-effects-let-alone-passes-for-any-nested-emit",
      "note": "Asserts the let and nothing under it, so a nested emit of any name or payload would pass; the effect list carries no trace of FOO.",
      "steps": [
        {
          "from": "ready",
          "event": "GO",
          "expect": {
            "fired": true,
            "effects": [
              {
                "type": "let"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-effects-arg1-compares-the-let-source-whole",
      "note": "The only way to pin the nested emit through effects today: the let's raw source in arg1, compared whole. It asserts the written expression (status of the nested emit is lost: the let reports skipped although the emit ran), not the effects that ran.",
      "steps": [
        {
          "from": "ready",
          "event": "GO",
          "expect": {
            "effects": [
              {
                "type": "let",
                "arg1": [
                  "emit",
                  "FOO",
                  {
                    "n": "@x"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}