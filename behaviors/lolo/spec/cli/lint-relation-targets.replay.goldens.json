{
 "atom": "cli/atoms/std-orb-lint-relation-targets.lolo",
 "trait": "OrbLintRelationTargets",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. The nested cases copy cross_orbital/relations.rs test_relation_targets_nested_in_array_items and entity.rs a_map_value_relation_without_a_definition_is_a_coded_error (paths .items.properties.byKey.items.items.relation.entity and .items.relation.entity); the order case pins the check_relation_targets walk (field, items, properties sorted by name). Every case folds the entity fields with tree/fold, so all of them await the orb reinstall.",
 "cases": [
  {
   "id": "relation-to-an-undeclared-entity",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           },
           {
            "name": "owner",
            "type": "relation",
            "relation": {
             "entity": "Missing",
             "cardinality": "one"
            }
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintRelationTargets"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "relation-targets",
         "findings": [
          {
           "code": "ORB_E_INVALID_RELATION",
           "path": "orbitals[0].entity.fields[1].relation.entity",
           "message": "Relation target entity 'Missing' does not exist",
           "suggestion": "Ensure the related entity is defined in the schema",
           "severity": "error"
          },
          {
           "code": "ORB_X_UNRESOLVED_RELATION_TARGET",
           "path": "orbitals[0].entity.fields[1].relation.entity",
           "message": "Relation field 'owner' on 'E' points at 'Missing', which is not declared in this schema",
           "suggestion": "Declare the target entity in one of the schema's orbitals, or correct the relation.entity name.",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintRelationTargets"
    }
   ]
  },
