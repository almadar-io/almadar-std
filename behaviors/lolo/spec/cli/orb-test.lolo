app orb-test-spec [
  version: "1.0.0",
  inbound: ["cli-test"],
  description: "Design contract for `orb test <program.lolo> [--trait <name>] [--orbital <name>] [--report text|json] [--execute]`: the kernel-planner replacement of the Rust exhaustive generator (owner ruling G-STD-105, 2026-10-21). The program is walked by std-verify-walk (its answer lines `verdict  Trait from --EVENT--> to [ detail]`, a validate finding `fail  validate [CODE] message`, then the totals line). TEST_WALK_ANSWERED { status, body } (the entity holds file, trait filter, report and verbose) reshapes that answer into outcomes: pass is passed; fail is failed; every other verdict (unplanned, guard-blocked, gap) is skipped with the verdict and its detail as the reason; a finding is a failed outcome of the trait `(program)` named `validate`. An outcome is { status, traitName, test, detail?, reason? } with test `<from> + <event> → <to>`. --trait and --orbital both keep the traits whose name contains the word, case-insensitively (as the Rust verb); no trait left answers `No traits found matching the filter criteria.` (status 200). Text report (the default): `Loading schema: <file>`, a blank line, the 60-wide `=` rule, `Headless Execution Results`, the rule, one line per trait `  ✓|✗ <trait> — <passed>/<passed+failed> passed[ (<n> failed)]`, a 60-wide `-` rule, `Total: <p> passed, <f> failed, <s> skipped`, the `=` rule; with --verbose the passed and skipped tests are listed above the rules. JSON report: { failed, outcomes, passed, skipped }. Status 200, or 500 when any outcome failed (the Rust JSON report exits 0; this exits 1 on a failure in both). A walk that answers 500 with no row prints `orb test: <its message>` (status 500). Usage: a missing program, a second word or an unknown flag, or --report outside text|json answers 400. Parity findings against the Rust generator are recorded in the std ledger."
]

type TestOutcome = { status : string!, traitName : string!, test : string!, detail : string, reason : string }

orbital OrbTestSpec {
  expects trait OrbTest {
    state ready
    state parsing
    emits {
      TEST_ANSWERED { status : number!  body : string! }
    }
  }
  expects trait TestEngine {
    state walking
    emits {
      TEST_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbTest
}
