app lint-page-path-uniqueness-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint page-path-uniqueness <file>`. It lowers the file with program/read, collapses every page path to its param shape (each :name segment becomes a bare :) and, for every shape shared by two or more pages across all orbitals, reports ORB_P_DUPLICATE_PATH once at the first page with the normalized path, the paths and the locations (status 500, exit 1). Clean answers `lint page-path-uniqueness: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]

orbital LintPagePathUniquenessSpec {
  expects trait OrbLintPagePathUniqueness {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [string]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintPagePathUniquenessCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-page-path-uniqueness" -> OrbLintPagePathUniqueness, OrbLintPagePathUniquenessCli
}
