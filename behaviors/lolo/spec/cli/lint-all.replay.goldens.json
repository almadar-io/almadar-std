     "payload": {
      "rawBody": "{\"argv\": [\"a.orb\", \"--json\"], \"cwd\": \".\"}"
     },
     "expect": {
      "state": "collecting",
      "emits": [
       {
        "event": "LINT_RUN",
        "payload": {
         "file": "a.orb"
        }
       }
      ]
     }
    }
   ],
