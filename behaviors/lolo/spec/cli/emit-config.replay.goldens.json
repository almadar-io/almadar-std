{
 "atom": "cli/atoms/std-orb-emit-config.lolo",
 "trait": "OrbEmitConfig",
 "source": "Mirrors orbital-compiler tests/emit_config_validation.rs (the emit-key, identifier and undeclared-event cases; the keyed-call cancelled cases that reach validate_emit_config) and the postgres and redis cancelled-key cases of tests/host_effects_validation.rs.",
 "note": "The caller passes the operator's allowed keys (from the operator shapes) and, as declared, the events its trait emits; checkDeclared false skips the undeclared-event check as the Rust None does.",
 "cases": [
  {
   "id": "fetch-with-success-and-failure-is-valid",
   "steps": [
    {
     "trait": "OrbEmitConfig",
     "event": "EMIT_CONFIG_CHECK",
     "from": "ready",
     "payload": {
      "requestId": "r",
      "items": [
       {
        "id": "i0",
        "path": "orbitals[0 (O)].traits[0 (T)].stateMachine.transitions[0].effects[0]",
        "emit": {
         "success": "PATIENT_LOADED",
         "failure": "LOAD_FAILED"
        },
        "allowedKeys": [
         "success",
         "failure"
        ],
        "checkDeclared": true,
        "declared": [
         "PATIENT_LOADED",
         "LOAD_FAILED"
        ]
       }
      ]
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "EMIT_CONFIG_CHECKED",
        "payload": {
         "requestId": "r",
         "results": [
          {
           "id": "i0",
           "findings": []
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
