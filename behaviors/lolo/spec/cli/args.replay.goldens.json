    {
      "id": "bare-optional-flag-takes-its-default",
      "steps": [
        {
          "event": "ARGS_PARSE",
          "payload": {
            "stage": "t",
            "argv": [
              "--dry-run",
              "--release-orbital-rust"
            ],
            "flags": [
              {
                "name": "dry-run",
                "aliases": [],
                "takesValue": false,
                "repeatable": false
              },
              {
                "name": "scope",
                "aliases": [],
                "takesValue": true,
                "repeatable": false
              },
              {
                "name": "release-orbital-rust",
                "aliases": [],
                "takesValue": true,
                "repeatable": false,
                "defaultValue": "minor",
                "choices": [
                  "patch",
                  "minor",
                  "major"
                ]
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "ARGS_PARSED",
                "payload": {
                  "stage": "t",
                  "flags": {
                    "dry-run": [
                      "true"
                    ],
                    "release-orbital-rust": [
                      "minor"
                    ]
                  },
                  "positionals": [],
                  "errors": [],
                  "words": [
                    "--dry-run",
                    "--release-orbital-rust",
                    "minor"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
