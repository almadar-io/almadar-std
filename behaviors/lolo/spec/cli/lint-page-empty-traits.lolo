app lint-page-empty-traits-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint page-empty-traits <file>`. It lowers the file with program/read and, for every page of a non-spec orbital, reports ORB_P_EMPTY_TRAITS (a traits list with no entries), ORB_P_MISSING_TRAITS (no traits list and no primaryEntity) and ORB_P_INVALID_VIEW_TYPE (a viewType outside list, detail, create, edit, dashboard, custom), each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint page-empty-traits: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintPageEmptyTraitsSpec {
  expects trait OrbLintPageEmptyTraits {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintPageEmptyTraitsCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintPageEmptyTraits, OrbLintPageEmptyTraitsCli
}
