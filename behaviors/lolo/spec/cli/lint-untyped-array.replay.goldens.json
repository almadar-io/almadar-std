{
 "atom": "cli/atoms/std-orb-lint-untyped-array.lolo",
 "trait": "OrbLintUntypedArray",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. The cases copy payload_field_name.rs untyped_array_field_errors_typed_array_field_does_not and entity.rs test_entity_untyped_array_field_errors_typed_array_field_does_not; the nested case pins the check_fields recursion. The payload cases fold with tree/fold and await the orb reinstall; the entity cases do not fold payloads.",
 "cases": [
  {
   "id": "emit-payload-array-without-an-element-type",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           },
           "emits": [
            {
             "event": "DONE",
             "payloadSchema": [
              {
               "name": "items",
               "type": "array"
              }
             ]
            }
           ]
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintUntypedArray"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "untyped-array",
         "findings": [
          {
           "code": "ORB_X_UNTYPED_ARRAY",
           "path": "orbitals[0 (A)].traits[0 (T)].emits(DONE).items",
           "message": "Field 'items' is typed `array` but its element type is undeclared.",
           "suggestion": "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintUntypedArray"
    }
   ]
  },
