{
  "atom": "cli/atoms/std-orb-signatures.lolo",
  "trait": "SignaturesEngine",
  "cases": [
    {
      "id": "the call asks std-args to parse with the out flag table",
      "steps": [
        {
          "trait": "OrbSignatures",
          "from": "ready",
          "event": "SIGNATURES_CALLED",
          "payload": {
            "headers": {},
            "rawBody": "{\"argv\": [\"--out\", \"c.json\"], \"cwd\": \"/w\"}"
          },
          "expect": {
            "state": "parsing",
            "emits": [
              {
                "event": "SIGNATURES_ARGS_PARSE",
                "payload": {
                  "stage": "signatures",
                  "argv": [
                    "--out",
                    "c.json"
                  ],
                  "flags": [
                    {
                      "name": "out",
                      "aliases": [],
                      "takesValue": true,
                      "repeatable": false
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "no words starts the catalog with no out file",
      "steps": [
        {
          "trait": "OrbSignatures",
          "from": "parsing",
          "event": "SIGNATURES_ARGS_DONE",
          "payload": {
            "stage": "signatures",
            "flags": {},
            "positionals": [],
            "errors": [],
            "words": []
          },
          "expect": {
            "state": "working",
            "emits": [
              {
                "event": "SIGNATURES_START",
                "payload": {
                  "out": ""
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "--out FILE starts the catalog with the file",
      "steps": [
        {
          "trait": "OrbSignatures",
          "from": "parsing",
          "event": "SIGNATURES_ARGS_DONE",
          "payload": {
            "stage": "signatures",
            "flags": {
              "out": [
                "c.json"
              ]
            },
            "positionals": [],
            "errors": [],
            "words": []
          },
          "expect": {
            "state": "working",
            "emits": [
              {
                "event": "SIGNATURES_START",
                "payload": {
                  "out": "c.json"
                }
              }
            ]
          }
        }
      ]
    },
    {
