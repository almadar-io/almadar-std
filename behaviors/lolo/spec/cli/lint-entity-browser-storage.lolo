app lint-entity-browser-storage-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint entity-browser-storage <file>`, the port of ORB_E_LOCAL_REQUIRES_PERSISTENT, ORB_E_MOCK_SEED_NOT_LOCAL and ORB_E_IDENTITY_LOCAL. The file is lowered with program/read; each orbital entity that is runtime and local, mock-seeded without local, or identity and local is reported as `[CODE] <path>: <message>` with the Rust message and suggestion, status 500 (exit 1). A clean program answers `lint entity-browser-storage: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintEntityBrowserStorageSpec {
  expects trait OrbLintEntityBrowserStorage {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintEntityBrowserStorageCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-entity-browser-storage" -> OrbLintEntityBrowserStorage, OrbLintEntityBrowserStorageCli
}
