app lint-host-calls-spec [
  version: "1.0.0",
  description: "Design contract for the shared host-call collector: HOST_CALLS_COLLECT { requestId, orbitals, heads, operators, fields } is answered by HOST_CALLS_COLLECTED { requestId, unread, calls, facts }, the calls headed by one of the heads at any depth of a guard or effect of an inline trait, parent before children, (the heads plus every operator whose table entry has one of the fields) and the operator table's entry of each requested operator, built from std-orb-lint-input's LINT_OPERATOR_SHAPES and LINT_HOST_FACTS (the collector reads no file). Each call carries its trait's config and whether it sits in a guard."
]
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]! }

orbital LintHostCallsSpec {
  expects entity OrbLintHostCallsRun [runtime] {
    id : string!
  }
  expects trait HostCalls {
    state ready
    emits {
      HOST_CALLS_COLLECTED { requestId : string!  unread : boolean!  calls : [HcCall]!  facts : Map string HcVal! }
    }
  }
  expects page boot -> HostCalls
}
