app lint-map-path-key-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint map-path-key <file>`: object/set, object/get or object/has on a Map entity field with a str/concat key built from a literal containing \".\" reads the key as a dot path and nests the value; it is a warning ORB_MAP_KEY_DOT_PATH. Findings answer status 500 (exit 1); a clean program answers `lint map-path-key: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintMapPathKeySpec {
  expects trait OrbLintMapPathKey {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintMapPathKeyCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintMapPathKey, OrbLintMapPathKeyCli
}
