{
 "atom": "cli/atoms/std-orb-lint-listen-per.lolo",
 "trait": "OrbLintListenPer",
 "note": "EXEC-STEP-1a: a trait that listens per a key needs a [runtime] entity with an id : string field and a boot page, not a route page.",
 "cases": [
  {
   "id": "a-keyed-trait-on-a-runtime-entity-with-an-id-on-a-boot-page-is-clean",
   "steps": [
    {
     "event": "LINT_INPUT",
     "from": "ready",
     "trait": "OrbLintListenPer",
     "payload": {
      "file": "a.lolo",
      "raw": "",
      "latin": true,
      "program": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": []
           },
           "listens": [
            {
             "event": "GO",
             "triggers": "GO",
             "source": {
              "kind": "trait",
              "trait": "C"
             },
             "key": "@payload.key"
            }
           ]
          }
         ],
         "pages": [
          {
           "name": "P",
           "protocol": "boot",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "listen-per",
         "findings": []
        }
       }
      ]
     }
    }
   ]
  },
  {
