     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "listen-per",
         "findings": [
          {
           "code": "ORB_X_LISTEN_PER_ENTITY",
           "path": "orbitals.A.traits.T.listens",
           "message": "`A.T` listens `per` a key, so its rows are addressed by it, but its entity `E` is not a `[runtime]` entity with an `id : string` field",
           "suggestion": "declare `entity E [runtime] { id : string! }` for the trait, or drop the `per` clause",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
