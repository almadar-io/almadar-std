    {
      "id": "json report passes through pretty (clean, Rust: success/valid/stats)",
      "entity": {
        "cwd": "/w",
        "file": "errors.lolo",
        "json": true,
        "denyWarnings": false,
        "report": {
          "success": true,
          "valid": true,
          "stats": {
            "orbitals": 1,
            "entities": 1,
            "traits": 2,
            "pages": 1
          }
        },
        "errors": [],
        "warnings": [],
        "valid": true
      },
      "steps": [
        {
          "trait": "ValidateEngine",
          "from": "merging",
          "event": "VALIDATE_MERGE",
          "payload": {
            "findings": []
          },
          "expect": {
            "emits": [
              {
                "event": "VALIDATE_ANSWERED",
                "payload": {
                  "status": 200,
                  "body": "{\n  \"success\": true,\n  \"valid\": true,\n  \"stats\": {\n    \"orbitals\": 1,\n    \"entities\": 1,\n    \"traits\": 2,\n    \"pages\": 1\n  }\n}"
                }
              }
            ],
            "state": "rendering"
          }
        }
      ]
    },
