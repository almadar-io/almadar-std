{
  "atom": "cli/atoms/std-orb-lint-icon-format.lolo",
  "trait": "OrbLintIconFormat",
  "note": "Cases mirror the icon.rs tests test_valid_kebab_case_icons, test_valid_pascal_case_icons, test_invalid_format (PLUS_ICON, 'plus icon'), test_empty_icon ('' and blank), test_uncommon_icon_warning and test_similar_icon_suggestions. The last two are ORB_UI_ICON_NOT_FOUND, which this rule does not port (no lint input carries the Lucide icon list), so they are controls here: a well-formed name that is not a Lucide icon yields no finding. Added cases pin the walk validate_pattern_icons performs: a non-string value, a binding, actions[i].icon (reported twice, once by the actions check and once by the recursion into the action object, as the compiler does), itemActions[i].icon, a nested object prop and an object element of an array prop. Differences from Rust: the format finding carries no valid_values list and the suggestion is empty.",
  "cases": [
    {
      "id": "valid-kebab-case-icons-are-clean",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "app",
              "orbitals": [
                {
                  "name": "Home",
                  "traits": [
                    {
                      "name": "Tour",
                      "stateMachine": {
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "INIT",
                            "effects": [
                              [
                                "render-ui",
                                "main",
                                {
                                  "type": "stack",
                                  "children": [
                                    {
                                      "type": "button",
                                      "icon": "plus"
                                    },
                                    {
                                      "type": "button",
                                      "icon": "trash-2"
                                    },
                                    {
                                      "type": "button",
                                      "icon": "chevron-right"
                                    }
                                  ]
                                }
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          }
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "icon-format",
                  "findings": [],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintIconFormat"
        }
      ]
    },
