{
 "atom": "cli/atoms/std-orb-lint-theme-pin-contradicts-app.lolo",
 "trait": "OrbLintThemePinContradictsApp",
 "cases": [
  {
   "id": "contradicting-pin",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "TaskOrbital",
         "traits": [
          {
           "name": "TaskLayout"
          }
         ]
        },
        {
         "name": "OddOrbital",
         "traits": [
          {
           "name": "OddLayout",
           "config": {
            "theme": {
             "type": "string",
             "default": "terminal-dark"
            }
           }
          }
         ]
        }
       ],
       "theme": "linear-clean-light"
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "theme-pin-contradicts-app",
         "findings": [
          {
           "code": "ORB_THEME_PIN_CONTRADICTS_APP",
           "path": "orbitals[1 (OddOrbital)].theme",
           "message": "OddOrbital pins theme \"terminal-dark\" while the app declares \"linear-clean-light\" at the app level",
           "suggestion": "remove the config pin so the orbital inherits the app theme via @currentTheme - or, for a deliberate per-orbital override, declare it as the orbital's own `theme \"<key>\"`",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
