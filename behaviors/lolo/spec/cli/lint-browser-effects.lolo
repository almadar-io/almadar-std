app lint-browser-effects-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint browser-effects <file>`: it reports ORB_BEACON_URL_NOT_ABSOLUTE, ORB_BEACON_TEXT_REQUIRED, ORB_BEACON_OPTION_UNKNOWN, ORB_PAGE_FACTS_FIELD_INVALID, ORB_ON_DEVICE_SCHEMA_INVALID, the arity and option findings of browser/prompt, browser/embed and the browser/tab-* operators, ORB_TAB_REQUEST_INVALID (an unknown key, a request that is not an object), ORB_ON_DEVICE_EFFECT_ON_SERVER and ORB_TAB_EFFECT_ON_SERVER (in a [background] tick), ORB_HTTP_ORIGIN_NOT_STATIC and ORB_HTTP_EGRESS_UNDECLARED (the beacon URL) and, through std-orb-emit-config, ORB_EFF_EMIT_KEY_INVALID, ORB_EFF_EMIT_INVALID_NAME and ORB_EFF_EMIT_UNDECLARED_EVENT, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint browser-effects: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintBrowserEffectsSpec {
  expects trait OrbLintBrowserEffects {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintBrowserEffectsCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintBrowserEffects, OrbLintBrowserEffectsCli
}
