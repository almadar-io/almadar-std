{
 "atom": "cli/atoms/std-orb-lint-event-id-uniqueness.lolo",
 "trait": "OrbLintEventIdUniqueness",
 "cases": [
  {
   "id": "duplicate-event-id-across-traits",
   "steps": [
    {
     "trait": "OrbLintEventIdUniqueness",
     "from": "reading",
     "event": "LINT_PROGRAM_READ",
     "payload": {
      "result": {
       "orbitals": [
        {
         "name": "Tasks",
         "traits": [
          {
           "name": "TaskList",
           "stateMachine": {
            "states": [],
            "transitions": [],
            "events": []
           },
           "emits": [
            {
             "event": "E",
             "eventId": "evt_REFRESH0000000000000000"
            }
           ]
          },
          {
           "name": "TaskListCopy",
           "stateMachine": {
            "states": [],
            "transitions": [],
            "events": []
           },
           "emits": [
            {
             "event": "E",
             "eventId": "evt_REFRESH0000000000000000"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintEventIdUniqueness",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "event-id-uniqueness",
         "findings": [
          {
           "code": "ORB_ID_DUPLICATE_EVENT_ID",
           "path": "orbitals[0 (Tasks)]",
           "message": "event id `evt_REFRESH0000000000000000` is declared by 2 different traits (TaskList, TaskListCopy) — ids must be document-unique; every id→name resolution over this schema is ambiguous.",
           "suggestion": "",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
