{
  "atom": "cli/atoms/std-orb-firestore-indexes.lolo",
  "trait": "OrbFirestoreIndexes",
  "note": " Bodies are two-space indented firestore.indexes.json text without the trailing newline (the printed answer); the file written by --out keeps the newline.",
  "cases": [
    {
      "id": "call-malformed-body-is-usage",
      "steps": [
        {
          "event": "FIRESTORE_INDEXES_CALLED",
          "from": "ready",
          "payload": {
            "rawBody": "not json"
          },
          "entity": {
            "id": "r"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "exactEmits": [
              {
                "event": "FIRESTORE_INDEXES_ANSWERED",
                "payload": {
                  "status": 400,
                  "body": "usage: orb firestore-indexes <file> [--scope collection|collection-group] [--out <path>]"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "call-well-formed-parses-args",
      "steps": [
        {
          "event": "FIRESTORE_INDEXES_CALLED",
          "from": "ready",
          "payload": {
            "rawBody": "{\"argv\": [\"p.lolo\"], \"cwd\": \"/w\"}"
          },
          "entity": {
            "id": "r"
          },
          "expect": {
            "fired": true,
            "state": "parsing",
            "emits": [
              {
                "event": "FIRESTORE_INDEXES_ARGS_PARSE",
                "payload": {
                  "stage": "firestore-indexes",
                  "argv": [
                    "p.lolo"
                  ],
                  "flags": [
                    {
                      "name": "scope",
                      "aliases": [],
                      "takesValue": true,
                      "repeatable": false
                    },
                    {
                      "name": "out",
                      "aliases": [],
                      "takesValue": true,
                      "repeatable": false
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
