{
 "atom": "cli/atoms/std-orb-lint-page-path-uniqueness.lolo",
 "trait": "OrbLintPagePathUniqueness",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program.",
 "cases": [
  {
   "id": "two-pages-share-a-path",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        },
        {
         "name": "B",
         "entity": {
          "name": "E2",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T2",
           "linkedEntity": "E2",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P2",
           "path": "/a",
           "traits": [
            {
             "ref": "T2"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintPagePathUniqueness"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "page-path-uniqueness",
         "findings": [
          {
           "code": "ORB_P_DUPLICATE_PATH",
           "path": "orbitals[0].pages[0]",
           "message": "Duplicate page path (normalized to '/a'): [\"/a\", \"/a\"] found at: [\"orbitals[0].pages[0]\", \"orbitals[1].pages[0]\"]",
           "suggestion": "Each page must have a unique path — two routes that only differ by a param NAME still collide at dispatch",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintPagePathUniqueness"
    }
   ]
  },
