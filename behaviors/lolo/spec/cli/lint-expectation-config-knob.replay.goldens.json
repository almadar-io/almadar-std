{
  "atom": "cli/atoms/std-orb-lint-expectation-config-knob.lolo",
  "trait": "OrbLintExpectationConfigKnob",
  "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. Cases copy the knob tests of composition/expectations.rs (a_knob_of_the_expected_type_and_default_satisfies_expects_config, control_a_missing_knob_outside_a_spec_is_deferred, a_knob_of_another_type_fails_expects_config, a_knob_with_another_closed_value_set_fails_expects_config, a_knob_with_another_default_fails_expects_config, an_expectation_without_a_default_accepts_any_default, control_a_program_without_expects_config_is_unaffected); a_missing_knob_fails_a_spec_config_expectation is the strict-unprovided finding of expectation-unsatisfied, so its case here expects none.",
  "cases": [
    {
      "id": "a-knob-of-the-expected-type-and-default-satisfies-expects-config",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "App",
              "orbitals": [
                {
                  "name": "CliOrbital",
                  "entity": {
                    "name": "CliCall",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "CliRunner",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": []
                      },
                      "config": {
                        "stdio": {
                          "type": "string",
                          "default": "pipe"
                        }
                      }
                    }
                  ],
                  "pages": [],
                  "expects": [
                    {
                      "kind": "config",
                      "name": "stdio",
                      "knob": {
                        "type": "string",
                        "default": "pipe"
                      },
                      "strict": true
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintExpectationConfigKnob"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "expectation-config-knob",
                  "findings": [],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintExpectationConfigKnob"
        }
      ]
    },
