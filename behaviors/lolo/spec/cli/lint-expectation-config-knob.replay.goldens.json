                  "traits": [
                    {
                      "name": "CliRunner",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": []
                      },
                      "config": {
                        "stdio": {
                          "type": "number",
                          "default": 0
                        }
                      }
                    }
                  ],
                  "pages": [],
                  "expects": [
                    {
                      "kind": "config",
                      "name": "stdio",
                      "knob": {
                        "type": "string",
                        "default": "pipe"
                      },
                      "strict": true
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintExpectationConfigKnob"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "expectation-config-knob",
                  "findings": [
                    {
                      "code": "ORB_S_EXPECTED_FIELD_TYPE_MISMATCH",
                      "path": "orbitals[0 (CliOrbital)].expects[0]",
                      "message": "`CliOrbital` expects config knob `stdio : string`, but `CliRunner` declares `number`.",
                      "suggestion": "Declare `stdio` as `string` in the trait's `config`.",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintExpectationConfigKnob"
        }
      ]
    },
