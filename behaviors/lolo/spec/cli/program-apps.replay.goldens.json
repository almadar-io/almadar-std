{
  "atom": "cli/atoms/std-program-host.lolo",
  "trait": "ProgramApps",
  "note": "Host answers (program/read, open, dispatch, close) are the next step's event; with no substrate host a step's asks fail inside the step, so each step seeds its own row.",
  "cases": [
    {
      "id": "first request reads the app file, then opens it, then replays the request",
      "now": 1000,
      "config": {
        "appsDir": "/apps"
      },
      "steps": [
        {
          "event": "APP_REQUEST",
          "from": "serving",
          "payload": {
            "key": "k1",
            "app": "a",
            "address": "O.T.E",
            "payload": {},
            "options": {}
          },
          "entity": {
            "id": "h",
            "apps": [],
            "waiting": [],
            "lastSweepMs": "1970-01-01T00:00:00.000Z"
          },
          "expect": {
            "fired": true,
            "state": "serving",
            "effects": [
              {
                "type": "os/read-file"
              }
            ]
          }
        },
        {
          "event": "APP_PROGRAM_READ",
          "from": "serving",
          "payload": {
            "result": {
              "program": {
                "name": "p",
                "orbitals": []
              },
              "lazy": []
            },
            "key": "a"
          },
          "entity": {
            "id": "h",
            "apps": [
              {
                "name": "a",
                "guest": "",
                "lastUsedMs": "1970-01-01T00:00:00.000Z",
                "loading": true
              }
            ],
            "waiting": [
              {
                "key": "k1",
                "app": "a",
                "address": "O.T.E",
                "payload": {},
                "options": {}
              }
            ],
            "lastSweepMs": "1970-01-01T00:00:00.000Z"
          },
          "expect": {
            "fired": true,
            "state": "serving",
            "effects": [
              {
                "type": "let",
                "nested": [
                  {
                    "type": "program/open"
                  }
                ]
              }
            ]
          }
        },
        {
          "event": "APP_OPENED",
          "from": "serving",
          "payload": {
            "result": {
              "guest": "g1"
            },
            "key": "a"
          },
          "entity": {
            "id": "h",
            "apps": [
              {
                "name": "a",
                "guest": "",
                "lastUsedMs": "1970-01-01T00:00:00.000Z",
                "loading": true
              }
            ],
            "waiting": [
              {
                "key": "k1",
                "app": "a",
                "address": "O.T.E",
                "payload": {},
                "options": {}
              }
            ],
            "lastSweepMs": "1970-01-01T00:00:00.000Z"
          },
          "expect": {
            "fired": true,
            "state": "serving",
            "emits": [
              {
                "event": "APP_DRAIN",
                "payload": {
                  "app": "a",
                  "guest": "g1"
                }
              }
            ],
            "entity": {
              "apps": [
                {
                  "name": "a",
                  "guest": "g1",
                  "lastUsedMs": "1970-01-01T00:00:01.000Z",
                  "loading": false
                }
              ]
            }
          }
        },
        {
          "event": "APP_DRAIN",
          "from": "serving",
          "payload": {
            "app": "a",
            "guest": "g1"
          },
          "entity": {
            "id": "h",
            "apps": [
              {
                "name": "a",
                "guest": "g1",
                "lastUsedMs": "1970-01-01T00:00:01.000Z",
