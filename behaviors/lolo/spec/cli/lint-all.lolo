app lint-all-spec [
  version: "1.0.0",
  description: "Spec for the orb lint-all command: an expected page and trait that emits LINT_RUN for a file and LINT_ANSWERED with a status and body."
]

orbital LintAllSpec {
  expects page boot -> OrbLintAll
  expects trait OrbLintAll {
    state ready
    emits {
      LINT_RUN { file : string! }
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
}
