app lint-slot-tick-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint slot-tick <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintSlotTickSpec {
  expects trait OrbLintSlotTick {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintSlotTickCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintSlotTick, OrbLintSlotTickCli
}
