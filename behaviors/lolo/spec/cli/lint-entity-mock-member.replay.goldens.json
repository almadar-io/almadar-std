{
 "atom": "cli/atoms/std-orb-lint-entity-mock-member.lolo",
 "trait": "OrbLintEntityMockMember",
 "cases": [
  {
   "id": "candidate-outside-enum",
   "steps": [
    {
     "trait": "OrbLintEntityMockMember",
     "from": "reading",
     "event": "LINT_PROGRAM_READ",
     "payload": {
      "result": {
       "orbitals": [
        {
         "entity": {
          "name": "Inv",
          "fields": [
           {
            "name": "status",
            "type": "string",
            "values": [
             "draft",
             "paid"
            ],
            "mock": "paid, refunded"
           }
          ]
         }
        }
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintEntityMockMember",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "entity-mock-member",
         "findings": [
          {
           "code": "ORB_E_MOCK_NOT_IN_ENUM",
           "path": "orbitals[0].entity.fields[0].mock",
           "message": "@mock candidate(s) refunded are not values of this field",
           "suggestion": "Use only the field's declared values as @mock candidates",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
