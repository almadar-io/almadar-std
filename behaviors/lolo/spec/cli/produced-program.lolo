app produced-program-spec [
  version: "1.0.0",
  description: "Design contract for the produced-program collection, the port of collect_effect_produced_events: for the offered program it answers PRODUCED_EVENTS { scope, byControl, byEffect }, each a map from trait name to the event names its effect trees produce."
]

orbital ProducedProgramSpec {
  expects trait OrbProducedProgram {
    state ready
    emits {
      PRODUCED_EVENTS { scope : string!  byControl : Map string [string]!  byEffect : Map string [string]! }
    }
  }
  expects page boot -> OrbProducedProgram
}
