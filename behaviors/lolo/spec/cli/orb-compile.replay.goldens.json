{
 "atom": "cli/atoms/std-orb-compile.lolo",
 "trait": "OrbCompile",
 "cases": [
  {
   "id": "the call asks std-args to parse with the compile flag table and its -o -s -m aliases",
   "steps": [
    {
     "trait": "OrbCompile",
     "from": "ready",
     "event": "COMPILE_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\": [\"a.lolo\", \"-o\", \"out\", \"-s\", \"python\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "state": "parsing",
      "emits": [
       {
        "event": "COMPILE_ARGS_PARSE",
        "payload": {
         "stage": "compile",
         "argv": [
          "a.lolo",
          "-o",
          "out",
          "-s",
          "python"
         ],
         "flags": [
          {
           "name": "output",
           "aliases": [
            "-o"
           ],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "shell",
           "aliases": [
            "-s"
           ],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "mode",
           "aliases": [
            "-m"
           ],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "frontend",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "backend",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "backend-url",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "patterns",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "dev-logs",
           "aliases": [],
           "takesValue": false,
           "repeatable": false
          },
          {
           "name": "host",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "emit-orb",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a relative file is validated first with --json, joined to the working directory",
   "steps": [
    {
     "trait": "OrbCompile",
     "from": "ready",
     "event": "COMPILE_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\": [\"a.lolo\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "state": "parsing"
     }
    },
    {
     "trait": "OrbCompile",
     "from": "parsing",
     "event": "COMPILE_ARGS_DONE",
     "payload": {
      "stage": "compile",
      "flags": {},
      "positionals": [
       "a.lolo"
      ],
      "errors": [],
      "words": []
     },
     "expect": {
      "state": "validating",
      "emits": [
       {
        "event": "VALIDATE_START",
        "payload": {
         "file": "a.lolo",
         "path": "/w/a.lolo",
         "cwd": "/w",
         "json": true,
         "denyWarnings": false,
         "finalProgram": false,
         "hasPatterns": false,
         "patterns": "",
         "hasServices": false,
         "services": ""
        }
       }
      ]
     }
    }
   ]
  },
