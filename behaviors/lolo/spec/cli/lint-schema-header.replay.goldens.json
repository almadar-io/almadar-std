{
 "atom": "cli/atoms/std-orb-lint-schema-header.lolo",
 "trait": "OrbLintSchemaHeader",
 "cases": [
  {
   "id": "missing-name",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "",
       "orbitals": [
        {
         "name": "A"
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "schema-header",
         "findings": [
          {
           "code": "ORB_S_MISSING_NAME",
           "path": "name",
           "message": "Schema name is required",
           "suggestion": "Add a name for your schema",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
