{
 "atom": "cli/atoms/std-orb-emit.lolo",
 "trait": "EmitEngine",
 "cases": [
  {
   "id": "the call asks std-args to parse with the emit flag table and its -o alias",
   "steps": [
    {
     "trait": "OrbEmit",
     "from": "ready",
     "event": "EMIT_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\": [\"orb\", \"a.lolo\", \"-o\", \"r.orb\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "state": "parsing",
      "emits": [
       {
        "event": "EMIT_ARGS_PARSE",
        "payload": {
         "stage": "emit",
         "argv": [
          "orb",
          "a.lolo",
          "-o",
          "r.orb"
         ],
         "flags": [
          {
           "name": "section",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "output",
           "aliases": [
            "-o"
           ],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "format",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "only",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "map",
           "aliases": [],
           "takesValue": false,
           "repeatable": false
          },
          {
           "name": "inspect-source",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "document-version",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "unit",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "out",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "sign-key",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "key-id",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "target and file start the emit with the working directory and the parsed flags",
   "steps": [
    {
     "trait": "OrbEmit",
     "from": "ready",
     "event": "EMIT_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\": [\"orb\", \"a.lolo\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "state": "parsing"
     }
    },
    {
     "trait": "OrbEmit",
     "from": "parsing",
     "event": "EMIT_ARGS_DONE",
     "payload": {
      "stage": "emit",
      "flags": {},
      "positionals": [
       "orb",
       "a.lolo"
      ],
      "errors": [],
      "words": []
     },
     "expect": {
      "state": "working",
      "emits": [
       {
        "event": "EMIT_START",
        "payload": {
         "cwd": "/w",
         "positionals": [
          "orb",
          "a.lolo"
         ],
         "flags": {}
        }
       }
      ]
     }
    }
   ]
  },
  {
