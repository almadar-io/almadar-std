  {
   "id": "a rendered emit prints its text without the one trailing newline the hook adds",
   "steps": [
    {
     "trait": "EmitEngine",
     "from": "idle",
     "event": "EMIT_START",
     "payload": {
      "cwd": "/w",
      "positionals": [
       "orb",
       "a.lolo"
      ],
      "flags": {}
     },
     "expect": {
      "state": "emitting"
     }
    },
    {
     "trait": "EmitEngine",
     "from": "emitting",
     "event": "EMIT_RENDERED",
     "payload": {
      "result": {
       "text": "{\n  \"name\": \"a\"\n}\n",
       "stderr": ""
      }
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "EMIT_ANSWERED",
        "payload": {
         "status": 200,
         "body": "{\n  \"name\": \"a\"\n}",
         "stderr": ""
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "stderr notes are relayed without their trailing newline",
