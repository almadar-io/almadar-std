  {
   "id": "a refusal answers 500 with its reason",
   "steps": [
    {
     "trait": "EmitEngine",
     "from": "emitting",
     "event": "EMIT_REFUSED",
     "payload": {
      "error": "program/print: Failed to read /w/a.lolo: No such file or directory (os error 2)"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "EMIT_ANSWERED",
        "payload": {
         "status": 500,
         "body": "",
         "stderr": "Error: program/print: Failed to read /w/a.lolo: No such file or directory (os error 2)"
        }
       }
      ]
     }
    }
   ]
  },
