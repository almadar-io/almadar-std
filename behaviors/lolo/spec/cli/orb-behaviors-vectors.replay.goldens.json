      {
       "key": "title",
       "type": "string"
      }
     ],
     "events": {
      "emits": [],
      "listens": [],
      "transitions": []
     },
     "model": ""
    },
    "vpath": "/w/x.orb"
   },
   "steps": [
    {
     "trait": "OrbBehaviors",
     "from": "working",
     "event": "PACKAGES_LISTED",
     "payload": {
      "result": [
       {
        "root": "/p/alpha",
        "prefix": "alpha"
       }
      ]
