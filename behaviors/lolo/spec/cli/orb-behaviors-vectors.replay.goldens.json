{
 "atom": "cli/atoms/std-orb-behaviors.lolo",
 "trait": "OrbBehaviors",
 "note": "The vector flows of `orb behaviors catalog|describe --knob-vectors|texts`: the host answers (behavior/catalog with texts, behavior/packages, behavior/describe, behavior/source) and the composed std traits' answers (text builder, sources, resolver) are fed as events. Cases are built from the retired orbital-cli behaviors_catalog.rs (catalog_with, describe_with) and behaviors_texts.rs (texts) and the Rust cases of tests/behaviors_catalog.rs, which also drive the real command end to end.",
 "cases": [
  {
   "id": "attached entries print as pretty JSON",
   "entity": {
    "sub": "catalog",
    "json": true
   },
   "steps": [
    {
     "trait": "OrbBehaviors",
     "from": "working",
     "event": "CATALOG_ATTACHED",
     "payload": {
      "result": [
       {
        "behavior": "alpha/alpha-card",
        "package": "alpha",
        "topic": "ui/core",
        "level": "atom",
        "description": "A card.",
        "capabilities": [
         "display"
        ],
        "traits": [],
        "value": {
         "behavior": "alpha/alpha-card"
        },
        "vectors": {},
        "model": "m1"
       }
      ]
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "BEHAVIORS_ANSWERED",
        "payload": {
         "status": 200,
         "body": "[\n  {\n    \"behavior\": \"alpha/alpha-card\",\n    \"package\": \"alpha\",\n    \"topic\": \"ui/core\",\n    \"level\": \"atom\",\n    \"description\": \"A card.\",\n    \"capabilities\": [\n      \"display\"\n    ],\n    \"traits\": [],\n    \"value\": {\n      \"behavior\": \"alpha/alpha-card\"\n    },\n    \"vectors\": {},\n    \"model\": \"m1\"\n  }\n]"
        }
       }
      ]
     }
    }
   ]
  },
