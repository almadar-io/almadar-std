{
 "atom": "cli/atoms/std-orb-lint-empty-event-name.lolo",
 "trait": "OrbLintEmptyEventName",
 "cases": [
  {
   "id": "empty-key-and-emit-in-order",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "traits": [
          {
           "name": "T",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [],
            "events": [
             {
              "key": "",
              "name": "on event click"
             }
            ]
           },
           "emits": [
            {
             "event": "",
             "scope": "external"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "empty-event-name",
         "findings": [
          {
           "code": "ORB_T_EMPTY_EVENT_NAME",
           "path": "orbitals[0].traits[0].stateMachine.events[0].key",
           "message": "Event name is empty",
           "suggestion": "Name the event, or remove it; an unset optional event knob declares no event",
           "severity": "error"
          },
          {
           "code": "ORB_T_EMPTY_EVENT_NAME",
           "path": "orbitals[0].traits[0].emits[0].event",
           "message": "Event name is empty",
           "suggestion": "Name the event, or remove it; an unset optional event knob declares no event",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
