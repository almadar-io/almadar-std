{
 "atom": "cli/atoms/std-orb-lint-finding-codes.lolo",
 "trait": "OrbLintFindingCodes",
 "note": "Cases for the finding-codes lint on the resolved program: in a rule trait (a trait with a `codes` knob), an object under a transition or tick whose `code` string the knob's record does not declare is an error; a declared code, a trait without the knob and a non-string code are controls.",
 "cases": [
  {
   "id": "a-code-the-record-does-not-declare-is-an-error",
   "steps": [
    {
     "event": "LINT_INPUT",
     "from": "ready",
     "payload": {
      "file": "a.orb",
      "raw": "",
      "latin": true,
      "program": {
       "typeContractVersion": 1,
       "name": "fc",
       "version": "1.0.0",
       "orbitals": [
        {
         "name": "O",
         "entity": {
          "name": "T",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string",
            "required": true
           }
          ]
         },
         "traits": [
          {
           "name": "R",
           "stateMachine": {
            "states": [
             {
              "name": "ready",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "event": "LINT_INPUT",
              "from": "ready",
              "to": "ready",
              "effects": [
               [
                "set",
                "@entity.findings",
                [
                 {
                  "code": "ORB_SOME_CODE",
                  "path": "p",
                  "message": "m",
                  "suggestion": "",
                  "severity": "error"
                 }
                ]
               ]
              ]
             }
            ]
           },
           "config": {
            "codes": {
             "type": "Codes",
             "default": {
              "a": {
               "code": "ORB_A",
               "category": "x",
               "description": "d"
              }
             }
            }
           }
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "finding-codes",
         "scope": "",
         "findings": [
          {
           "code": "ORB_LINT_FINDING_CODE_UNDECLARED",
           "path": "orbitals[0 (O)].traits[0 (R)]",
           "message": "A finding names the code 'ORB_SOME_CODE', which the rule's `codes` record does not declare",
           "suggestion": "Declare the code in the rule's `codes` record and read it as `@config.codes.<name>.code`",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
