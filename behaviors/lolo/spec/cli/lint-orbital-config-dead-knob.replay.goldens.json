{
  "atom": "cli/atoms/std-orb-lint-orbital-config-dead-knob.lolo",
  "trait": "OrbLintOrbitalConfigDeadKnob",
  "note": "Cases mirror the ORB_O_CONFIG_DEAD_KNOB tests in orbital_import_validation.rs (app/orbital unforwarded and forwarded, chain through an orbital knob, dotted tail, forwardedFrom provenance) and nested_config_forward.rs (nestedForwardedFrom folded, unfolded token, other-knob provenance). Expected findings carry the Rust message and suggestion; path is the Rust path; severity error.",
  "cases": [
    {
      "id": "app-level-unforwarded-knob-is-flagged",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.orb",
            "raw": "",
            "latin": true,
            "program": {
              "name": "test-dead-knob",
              "version": "1.0.0",
              "orbitals": [
                {
                  "name": "WidgetOrbital",
                  "entity": {
                    "name": "Widget",
                    "persistence": "persistent",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string",
                        "required": true
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "WidgetView",
                      "linkedEntity": "Widget",
                      "category": "interaction",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "OPEN",
                            "effects": []
                          }
                        ]
                      }
                    }
                  ],
                  "pages": []
                }
              ],
              "config": {
                "appName": {
                  "type": "string",
                  "default": "App"
                }
              }
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintOrbitalConfigDeadKnob"
        },
        {
          "event": "LINT_FINISH",
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "orbital-config-dead-knob",
                  "findings": [
                    {
                      "code": "ORB_O_CONFIG_DEAD_KNOB",
                      "path": "config(appName)",
                      "message": "Declared app-level config knob 'appName' is not forwarded by any trait's config default (`@config.appName`) — nothing publishes it, so no call site can ever reach it.",
                      "suggestion": "Forward it from a trait (`config { appName: @config.appName }`) or delete the declaration.",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintOrbitalConfigDeadKnob"
        }
      ]
    },
