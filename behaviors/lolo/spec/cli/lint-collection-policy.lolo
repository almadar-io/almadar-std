app lint-collection-policy-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint collection-policy <file>`, the port of the compiler rule ORB_S_COLLECTION_POLICY_CONFLICT. The file is lowered with program/read. Two entities bound to one collection must declare identical access directives; each later entity that differs from the first declarer is reported as `[ORB_S_COLLECTION_POLICY_CONFLICT] <Entity>.@access: <message>`, status 500 (exit 1). A clean program answers `lint collection-policy: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintCollectionPolicySpec {
  expects trait OrbLintCollectionPolicy {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintCollectionPolicyCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-collection-policy" -> OrbLintCollectionPolicy, OrbLintCollectionPolicyCli
}
