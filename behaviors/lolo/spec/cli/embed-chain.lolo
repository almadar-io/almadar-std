app embed-chain-spec [
  version: "1.0.0",
  description: "Design contract for the shared embed chains, the port of the compiler's EmbedGraph host chain: for the lowered program it answers EMBED_CHAINS { scope, chains }, one map per orbital in program order from each inline trait name to its host names, innermost first."
]

orbital EmbedChainSpec {
  expects trait OrbEmbedChain {
    state ready
    emits {
      EMBED_CHAINS { scope : string!  chains : [Map string [string]]!  embedders : [Map string [string]]! }
    }
  }
  expects page boot -> OrbEmbedChain
}
