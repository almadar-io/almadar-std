           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "Workspace",
           "linkedEntity": "HostView",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": [
                  {
                   "type": "box",
                   "children": [
                    [
                     "behavior/apply",
                     "@entity.plugin",
                     {
                      "bridge": {
                       "listens": [
                        "GO"
                       ],
                       "emits": [
                        "DONE"
