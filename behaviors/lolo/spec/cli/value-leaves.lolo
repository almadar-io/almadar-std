app value-leaves-spec [
  version: "1.0.0",
  description: "Design contract for the value-leaves collection, the port of the value-source walk (json_value_leaves with all_sources): for the offered values it answers VALUE_LEAVES { requestId, leaves }, the JSON text of each leaf of each value, read only through the operators' value-source slots."
]

orbital ValueLeavesSpec {
  expects trait OrbValueLeaves {
    state ready
    emits {
      VALUE_LEAVES { requestId : string!  leaves : [[string]]! }
    }
  }
  expects page boot -> OrbValueLeaves
}
