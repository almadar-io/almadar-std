{
 "atom": "cli/atoms/std-orb-lint-duplicate-use-alias.lolo",
 "trait": "OrbLintDuplicateUseAlias",
 "cases": [
  {
   "id": "same-alias-same-file",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "ConsumerOrbital",
         "uses": [
          {
           "from": "./pickup.orb",
           "as": "Pickup"
          },
          {
           "from": "./pickup.orb",
           "as": "Pickup"
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "duplicate-use-alias",
         "findings": [
          {
           "code": "ORB_O_DUPLICATE_USE_ALIAS",
           "path": "orbitals[name=ConsumerOrbital].uses[1]",
           "message": "Duplicate import alias 'Pickup' at orbitals[name=ConsumerOrbital].uses[1] — each `uses` alias names one import",
           "suggestion": "",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
