           "code": "ORB_P_EMPTY_TRAITS",
           "path": "orbitals[0].pages[0].traits",
           "message": "Page traits array cannot be empty",
           "suggestion": "Add at least one trait to render UI on the page",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintPageEmptyTraits"
    }
