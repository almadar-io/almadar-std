app lint-event-id-uniqueness-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint event-id-uniqueness <file>`, the port of ORB_ID_DUPLICATE_EVENT_ID. It lowers the file with program/read and, per orbital, reports each event id declared by two or more different inline traits, once per id sorted by id, with the Rust path and message (status 500, exit 1). Clean answers `lint event-id-uniqueness: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintEventIdUniquenessSpec {
  expects trait OrbLintEventIdUniqueness {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintEventIdUniquenessCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-event-id-uniqueness" -> OrbLintEventIdUniqueness, OrbLintEventIdUniquenessCli
}
