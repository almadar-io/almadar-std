{
 "atom": "cli/atoms/std-orb-lint-http-egress-entry.lolo",
 "trait": "OrbLintHttpEgressEntry",
 "cases": [
  {
   "id": "bad-https___a_com_path",
   "steps": [
    {
     "trait": "OrbLintHttpEgressEntry",
     "from": "reading",
     "event": "LINT_PROGRAM_READ",
     "payload": {
      "result": {
       "egress": [
        "https://a.com/path"
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintHttpEgressEntry",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "http-egress-entry",
         "findings": [
          {
           "code": "ORB_HTTP_EGRESS_ENTRY_INVALID",
           "path": "egress[0]",
           "message": "egress entry 'https://a.com/path' is not scheme://host[:port]",
           "suggestion": "Write an origin only: no path, query, credentials or trailing slash",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
