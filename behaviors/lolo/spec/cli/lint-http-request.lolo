app lint-http-request-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint http-request <file>`: it reports ORB_HTTP_METHOD_UNKNOWN, ORB_HTTP_PATH_INVALID, ORB_HTTP_AUTH_SCHEME_UNKNOWN, ORB_HTTP_OPTION_UNKNOWN, ORB_HTTP_BODY_CONFLICT, ORB_HTTP_AUTH_INVALID (onUnauthorized words and required keys), ORB_HTTP_PAGINATE_MAX_MISSING, ORB_HTTP_STREAM_WITHOUT_ON_MESSAGE, ORB_HTTP_TOKEN_ROTATE_INVALID, ORB_HTTP_ORIGIN_NOT_STATIC and ORB_HTTP_EGRESS_UNDECLARED (origin and tokenUrl) and, through std-orb-emit-config, ORB_EFF_EMIT_KEY_INVALID, ORB_EFF_EMIT_INVALID_NAME and ORB_EFF_EMIT_UNDECLARED_EVENT for http calls, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint http-request: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintHttpRequestSpec {
  expects trait OrbLintHttpRequest {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintHttpRequestCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintHttpRequest, OrbLintHttpRequestCli
}
