app lint-tick-requires-runtime-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint tick-requires-runtime <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintTickRequiresRuntimeSpec {
  expects trait OrbLintTickRequiresRuntime {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintTickRequiresRuntimeCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-tick-requires-runtime" -> OrbLintTickRequiresRuntime, OrbLintTickRequiresRuntimeCli
}
