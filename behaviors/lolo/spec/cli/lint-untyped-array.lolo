app lint-untyped-array-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint untyped-array <file>`, the port of the compiler rule ORB_X_UNTYPED_ARRAY. The file is lowered with program/read and the top-level payload fields of every trait emit and event are checked (array payload fields declare an element type); a violation is reported as `[ORB_X_UNTYPED_ARRAY] <path>: <message>` with the Rust suggestion, status 500 (exit 1). A clean program answers `lint untyped-array: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintUntypedArraySpec {
  expects trait OrbLintUntypedArray {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintUntypedArrayCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-untyped-array" -> OrbLintUntypedArray, OrbLintUntypedArrayCli
}
