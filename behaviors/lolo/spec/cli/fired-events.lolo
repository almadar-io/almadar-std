app fired-events-spec [
  version: "1.0.0",
  description: "Design contract for the shared fired-events collection, the port of collect_schema_fired_events: for the lowered program it answers FIRED_EVENTS { scope, byControl, byEffect }, each a map from trait name to the event names that trait produces, by a rendered control or by an emit effect."
]

orbital FiredEventsSpec {
  expects trait OrbFiredEvents {
    state ready
    emits {
      FIRED_EVENTS { scope : string!  byControl : Map string [string]!  byEffect : Map string [string]! }
    }
  }
  expects page boot -> OrbFiredEvents
}
