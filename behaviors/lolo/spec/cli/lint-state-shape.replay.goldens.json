{
 "atom": "cli/atoms/std-orb-lint-state-shape.lolo",
 "trait": "OrbLintStateShape",
 "cases": [
  {
   "id": "no-initial-state",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "traits": [
          {
           "name": "T",
           "stateMachine": {
            "states": [
             {
              "name": "idle"
             },
             {
              "name": "active"
             }
            ],
            "transitions": [],
            "events": []
           }
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "state-shape",
         "findings": [
          {
           "code": "ORB_T_NO_INITIAL_STATE",
           "path": "orbitals[0].traits[0].stateMachine.states",
           "message": "State machine must have an initial state",
           "suggestion": "Mark one state with isInitial: true",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
