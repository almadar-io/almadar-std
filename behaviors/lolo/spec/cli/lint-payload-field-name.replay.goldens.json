{
 "atom": "cli/atoms/std-orb-lint-payload-field-name.lolo",
 "trait": "OrbLintPayloadFieldName",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. The nested cases copy the recursion in payload_field_name.rs check_fields (the nested_where call), which has no dedicated Rust test.",
 "cases": [
  {
   "id": "emit-payload-field-that-is-not-an-identifier",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           },
           "emits": [
            {
             "event": "DONE",
             "payloadSchema": [
              {
               "name": "bad-name",
               "type": "string"
              }
             ]
            }
           ]
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintPayloadFieldName"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "payload-field-name",
         "findings": [
          {
           "code": "ORB_X_PAYLOAD_FIELD_NAME",
           "path": "orbitals[0 (A)].traits[0 (T)].emits(DONE).bad-name",
           "message": "Payload field name 'bad-name' is not a valid TypeScript identifier",
           "suggestion": "Use a single identifier (letters, digits, underscores; no dot, no space, no leading digit). For a nested shape, declare an object field with nested properties instead of a dotted name.",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintPayloadFieldName"
    }
   ]
  },
