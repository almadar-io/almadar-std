app orb-reference-spec [
  version: "1.0.0",
  inbound: ["cli-reference"],
  description: "Design contract for `orb reference [TOPIC]` (port of orbital-cli commands/reference.rs; `orb signatures` stays in lib.rs). The language reference, served from the installed @almadar/core language tables named by its package.json orbLanguage block (constructs, validationCodes, vocabulary). REFERENCE_RUN { topic, vocabulary, constructs, codes } answers REFERENCE_ANSWERED { status, body } where body is one compact JSON line. No topic: { codes: [{ count, topic: codes/<category> }] by category name, constructs: [{ kind, name }], vocabulary } (the index's own keys alphabetical; values read from the tables keep the table's key order, as Rust prints them). Topic vocabulary: the vocabulary object. Topic codes/<category> (case-sensitive): { category, codes: [{ code, category, description }] }; a category with no code answers 500 `Error: no validation codes in category `<category>``. Any other topic names a construct, matched case-insensitively: { name, kind, doc, fields: [{ name, type, doc }], examples }; no match answers 500 `Error: no reference topic `<topic>`; `orb reference` lists them`. The topics are tried in that order. examples are cut from the installed almadar-std `.lolo` tree as orbital_lolo::reference::examples does: every `.lolo` file under the package's orb.source in path order, each construct the config's examplePaths names printed by program/print `{ source, nodes }` (comments dropped; a file that does not parse gives none), stable-sorted by byte length, adjacent repeats dropped, then the item at index n/2 and the one at n*9/10 (sorted, unique); a construct with no entry has none, and a std package without an orb.source tree is an error. The scan runs once: each printed example is kept as a key (byte length, scan position) with its sha256 and its place in the scan, an example equal to the last one of its length is dropped, and when the scan ends the two items are picked from the sorted keys and printed again from their places. More than one word or an unknown flag answers the usage (status 400, exit 2). Replay goldens: orb-reference.replay.goldens.json."
]

type RefField = { name : string!, type : string!, doc : string! }
type RefConstruct = { name : string!, kind : string!, doc : string!, fields : [RefField]! }
type RefCode = { code : string!, category : string!, description : string! }

orbital OrbReferenceSpec {
  expects trait OrbReference {
    state ready
    state parsing
    emits {
      REFERENCE_ANSWERED { status : number!  body : string! }
    }
  }
  expects trait ReferenceEngine {
    state loading
    emits {
      REFERENCE_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbReference
}
