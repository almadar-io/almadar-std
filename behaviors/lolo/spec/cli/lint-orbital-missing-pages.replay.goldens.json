     "trait": "OrbLintOrbitalMissingPages"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "orbital-missing-pages",
         "findings": [
          {
           "code": "ORB_O_MISSING_PAGES",
