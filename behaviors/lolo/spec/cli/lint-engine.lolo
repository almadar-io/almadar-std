app lint-engine-spec [
  version: "1.0.0",
  description: "Design contract for the lint engine: for a LINT_RUN { file } it asks the lint input to read and lower the file once (LINT_REQUEST), collects every composed rule trait's LINT_FOUND { rule, findings } and, once all of them answered, emits LINT_COLLECTED { findings, found } (the findings flattened, and by rule). When the lint input cannot read or lower the file the run ends without an answer."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type RuleFound = { rule : string!, findings : [OrbFinding]! }

orbital LintEngineSpec {
  expects trait OrbLintEngine {
    state ready
    emits {
      LINT_REQUEST { file : string! }
      LINT_COLLECTED { findings : [OrbFinding]!  found : [RuleFound]! }
    }
  }
  expects page boot -> OrbLintEngine
}
