app lint-entity-name-shadows-trait-union-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint entity-name-shadows-trait-union <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintEntityNameShadowsTraitUnionSpec {
  expects trait OrbLintEntityNameShadowsTraitUnion {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintEntityNameShadowsTraitUnionCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintEntityNameShadowsTraitUnion, OrbLintEntityNameShadowsTraitUnionCli
}
