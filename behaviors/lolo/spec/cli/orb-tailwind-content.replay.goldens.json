{
 "atom": "cli/atoms/std-orb-tailwind-content.lolo",
 "trait": "OrbTailwindContent",
 "note": "G-STD-289: a behavior's class tokens come from every prop the installed pattern registry marks kind class-string (seeded here as classProps), not only className.",
 "cases": [
  {
   "id": "a-split-leftClassName-reaches-the-token-list",
   "steps": [
    {
     "from": "working",
     "event": "TAILWIND_SOURCED",
     "entity": {
      "hits": [],
      "cursor": 0,
      "acc": [],
      "tokens": [],
      "classProps": [
       "className",
       "leftClassName",
       "rightClassName"
      ]
     },
     "payload": {
      "result": [
       "render-ui",
       "main",
       {
        "type": "split",
        "leftClassName": "[--x:1px] w-1"
       }
      ]
     },
     "expect": {
      "fired": true,
      "entity": {
       "acc": [
        "[--x:1px]",
        "w-1"
       ]
      }
     }
    }
   ]
  },
  {
   "id": "a-sidebar-and-main-class-props-reach-the-token-list",
   "steps": [
    {
     "from": "working",
     "event": "TAILWIND_SOURCED",
     "entity": {
      "hits": [],
      "cursor": 0,
      "acc": [],
      "tokens": [],
      "classProps": [
       "className",
       "sidebarClassName",
       "mainClassName"
      ]
     },
     "payload": {
      "result": [
       "render-ui",
       "main",
       {
        "type": "app-shell",
        "sidebarClassName": "w-64"
       }
      ]
     },
     "expect": {
      "fired": true,
      "entity": {
       "acc": [
        "w-64"
       ]
      }
     }
    }
   ]
  },
  {
   "id": "control-className-reaches-the-token-list-and-a-non-class-prop-does-not",
   "steps": [
    {
     "from": "working",
     "event": "TAILWIND_SOURCED",
     "entity": {
      "hits": [],
      "cursor": 0,
      "acc": [],
      "tokens": [],
      "classProps": [
       "className"
      ]
     },
     "payload": {
      "result": [
       "render-ui",
       "main",
       {
        "type": "box",
        "className": "gap-2 p-2",
        "label": "not-a-class"
       }
      ]
     },
     "expect": {
      "fired": true,
      "entity": {
       "acc": [
        "gap-2",
        "p-2"
       ]
      }
     }
    }
   ]
  },
  {
   "id": "control-a-prop-the-registry-does-not-mark-is-not-read",
   "steps": [
    {
     "from": "working",
     "event": "TAILWIND_SOURCED",
     "entity": {
      "hits": [],
      "cursor": 0,
      "acc": [],
      "tokens": [],
      "classProps": [
       "className"
      ]
     },
     "payload": {
      "result": [
       "render-ui",
       "main",
       {
        "type": "split",
        "className": "gap-2",
        "leftClassName": "w-1"
       }
      ]
     },
     "expect": {
      "fired": true,
      "entity": {
       "acc": [
        "gap-2"
       ]
      }
     }
    }
   ]
  }
 ]
}
