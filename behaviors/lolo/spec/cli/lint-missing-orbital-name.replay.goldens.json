{
 "atom": "cli/atoms/std-orb-lint-missing-orbital-name.lolo",
 "trait": "OrbLintMissingOrbitalName",
 "cases": [
  {
   "id": "empty-name",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A"
        },
        {
         "name": ""
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "missing-orbital-name",
         "findings": [
          {
           "code": "ORB_X_MISSING_ORBITAL_NAME",
           "path": "orbitals[1].name",
           "message": "Orbital name is required",
           "suggestion": "Add a descriptive name for the orbital",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
