app lint-schema-header-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint schema-header <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintSchemaHeaderSpec {
  expects trait OrbLintSchemaHeader {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintSchemaHeaderCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-schema-header" -> OrbLintSchemaHeader, OrbLintSchemaHeaderCli
}
