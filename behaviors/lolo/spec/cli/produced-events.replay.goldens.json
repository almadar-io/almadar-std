                              {
                                "set": "@config.k",
                                "value": "x"
                              },
                              {
                                "fetch": "Missing"
                              },
                              {
                                "call_service": {
                                  "service": "s",
                                  "op": "a"
                                }
                              },
                              [
                                "http",
                                "GET",
                                "https://x.test",
                                {
                                  "emit": {
                                    "success": "B"
                                  }
                                }
                              ]
                            ]
                          }
                        ]
                      },
                      "ticks": [],
                      "config": {}
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "PRODUCED_EVENTS",
                "payload": {
                  "scope": "",
                  "byControl": {
                    "T": []
                  },
                  "byEffect": {
                    "T": [
                      "A",
                      "B"
                    ]
                  }
                }
              }
            ]
          }
        }
