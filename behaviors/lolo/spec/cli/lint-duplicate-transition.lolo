app lint-duplicate-transition-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint duplicate-transition <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintDuplicateTransitionSpec {
  expects trait OrbLintDuplicateTransition {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintDuplicateTransitionCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-duplicate-transition" -> OrbLintDuplicateTransition, OrbLintDuplicateTransitionCli
}
