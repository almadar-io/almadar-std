{
 "atom": "cli/atoms/std-orb-lint-asset-inline-url.lolo",
 "trait": "OrbLintAssetInlineUrl",
 "cases": [
  {
   "id": "config-default-url",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "Board",
         "uses": [
          {
           "from": "std/behaviors/std-asset-pack",
           "as": "Pack"
          }
         ],
         "traits": [
          {
           "name": "AssetPack",
           "ref": "Pack.traits.AssetPackLoader",
           "config": {
            "origin": {
             "type": "unknown",
             "default": "https://almadar-kflow-assets.web.app"
            },
            "assetPack": {
             "type": "unknown",
             "default": "kflow/x"
            }
           }
          },
          {
           "name": "Render",
           "config": {
            "sprite": {
             "type": "string",
             "default": "https://cdn.example.com/a.png"
            }
           }
          }
         ],
         "entity": {
          "name": "E"
         }
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "asset-inline-url",
         "findings": [
          {
           "code": "ORB_ASSET_INLINE_URL",
           "path": "orbitals[0 (Board)].traits[1 (Render)].config.sprite.default",
           "message": "Orbital 'Board' composes std-asset-pack but carries the literal asset url 'https://cdn.example.com/a.png'",
           "suggestion": "Add the art to the pack's assets rows and look it up by key; the pack atom's origin is the only place a host belongs",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
