{
 "atom": "cli/atoms/std-orb-lint-trait-refs.lolo",
 "trait": "OrbLintTraitRefs",
 "note": "Cases built from traits/trait_validator.rs: validate_trait_reference (undefined trait, missing ref/name, undeclared linked entity), validate_trait_definition (empty name, undeclared linked entity), validate_entity_rebind (unresolved target, atom not @rebindable, contract fields missing) and validate_trait_uniqueness (a name defined twice). Each program is an .orb fixture and the expected findings are the ones `orb validate --json` reports for these codes. The paired controls are in the same programs: a std/ reference, a reference to a defined trait, a rebindable atom whose contract is met, a rebind to the atom's own entity and a contract-free same-entity trait.",
 "cases": [
  {
   "id": "reference-to-an-undefined-trait",
   "steps": [
    {
     "event": "LINT_INPUT",
     "from": "ready",
     "payload": {
      "file": "a.orb",
      "raw": "",
      "latin": true,
      "program": {
       "typeContractVersion": 1,
       "name": "tr_a",
       "version": "1.0.0",
       "orbitals": [
        {
         "name": "O",
         "entity": {
          "name": "Task",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string",
            "required": true
           },
           {
            "name": "n",
            "type": "number",
            "default": 0
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "Task",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "events": [
             {
              "key": "E"
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "E",
              "effects": []
             }
            ]
           }
          },
          {
           "ref": "Nope"
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "trait-refs",
         "scope": "",
         "findings": [
          {
           "code": "ORB_T_UNDEFINED_TRAIT",
           "path": "orbitals[0 (O)].traits[1 (Nope)]",
           "message": "Trait 'Nope' is not defined",
           "suggestion": "Define traits inline within orbitals or use a std library trait",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
