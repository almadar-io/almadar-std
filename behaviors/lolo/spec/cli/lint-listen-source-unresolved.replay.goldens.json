{
 "atom": "cli/atoms/std-orb-lint-listen-source-unresolved.lolo",
 "trait": "OrbLintListenSourceUnresolved",
 "note": "Cases mirror listens.rs (listen_on_conditional_branch_only_event_resolves, with the PRODUCED_EVENTS std-orb-produced-events answers for the same program) and the inline-phase test tests/events_rename_sourced_listen.rs (the composed program's post-rename listen resolves), plus controls for a declared emit, an undeclared event, a produced effect emit, an out-of-program source orbital, orbital-sourced entries, the sibling-orbital suggestion, and wildcard and sourceless listens. Each case carries the PRODUCED_HEARD answer for its program. Expected findings are the code, path, message and suggestion the Rust validator reports.",
 "cases": [
  {
   "id": "listen-on-conditional-branch-only-event-resolves",
   "steps": [
    {
     "trait": "OrbLintListenSourceUnresolved",
     "event": "LINT_INPUT",
     "from": "ready",
     "payload": {
      "file": "a.lolo",
      "raw": "",
      "latin": true,
      "program": {
       "name": "p",
       "orbitals": [
        {
         "name": "TaskOrbital",
         "entity": {
          "name": "TaskOrbitalE",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "TaskList",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "data-list",
                 "itemActions": [
                  "if",
                  "@user.role",
                  [
                   {
                    "name": "Edit",
                    "event": "EDIT_ITEM"
                   }
                  ],
                  [
                   {
                    "name": "Edit",
                    "event": "VIEW_ITEM"
                   }
                  ]
                 ]
                }
               ]
              ]
             }
            ]
           }
          },
          {
           "name": "TaskDetail",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": []
           },
           "listens": [
            {
             "event": "VIEW_ITEM",
             "triggers": "REFRESH",
             "source": {
              "kind": "trait",
              "trait": "TaskList"
             }
            }
           ]
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "fired": true
     }
    },
    {
     "trait": "OrbLintListenSourceUnresolved",
     "event": "PRODUCED_HEARD",
     "from": "ready",
     "payload": {
      "scope": "",
      "byControl": {
       "TaskList": [
        "EDIT_ITEM",
        "VIEW_ITEM"
       ],
       "TaskDetail": []
      },
      "byEffect": {
       "TaskList": [],
       "TaskDetail": []
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintListenSourceUnresolved",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "listen-source-unresolved",
         "findings": [],
         "scope": ""
        }
       }
      ]
     }
    }
   ]
  },
