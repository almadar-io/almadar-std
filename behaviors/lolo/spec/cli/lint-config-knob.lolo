app lint-config-knob-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint config-knob <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintConfigKnobSpec {
  expects trait OrbLintConfigKnob {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintConfigKnobCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintConfigKnob, OrbLintConfigKnobCli
}
