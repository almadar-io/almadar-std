app lint-page-content-owner-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint page-content-owner <file>`, the port of ORB_PAGE_AMBIGUOUS_CONTENT_OWNER and ORB_PAGE_SECOND_CONTENT_BODY. Findings are reported at orbitals[<i>].pages[<j>] (status 500, exit 1). A clean program answers `lint page-content-owner: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintPageContentOwnerSpec {
  expects trait OrbLintPageContentOwner {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintPageContentOwnerCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintPageContentOwner, OrbLintPageContentOwnerCli
}
