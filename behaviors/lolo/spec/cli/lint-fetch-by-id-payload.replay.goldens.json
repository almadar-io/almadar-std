{
  "atom": "cli/atoms/std-orb-lint-fetch-by-id-payload.lolo",
  "trait": "OrbLintFetchByIdPayload",
  "note": "Cases copy the four fetch_by_id_payload.rs unit tests (by-id list declaration flagged; row declaration, list-fetch list declaration and shared list+by-id event controls) plus the state-machine events declaration, a fetch nested in an if (transition index), a repeated by-id event reported once, a second trait's index and a trait with no data field. Expected findings are the code, path, message and suggestion the Rust validator reports; severity is error.",
  "cases": [
    {
      "id": "a-by-id-only-success-declared-as-a-list-is-an-error",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "p",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "E",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "ProductEdit",
                      "linkedEntity": "E",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "EDIT",
                            "effects": [
                              [
                                "fetch",
                                "Product",
                                {
                                  "emit": {
                                    "success": "ProductLoaded"
                                  },
                                  "id": "@payload.id"
                                }
                              ]
                            ]
                          }
                        ]
                      },
                      "emits": [
                        {
                          "event": "ProductLoaded",
                          "payloadSchema": [
                            {
                              "name": "data",
                              "type": "[Product]"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintFetchByIdPayload"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "fetch-by-id-payload",
                  "findings": [
                    {
                      "code": "ORB_EFF_FETCH_BY_ID_PAYLOAD_LIST",
                      "path": "orbitals[0 (O)].traits[0 (ProductEdit)].stateMachine.transitions[0].effects",
                      "message": "`(fetch … { id: … })` delivers one row as `payload.data`, but `ProductLoaded` declares `data : [Product]`",
                      "suggestion": "Declare `ProductLoaded { data : <Row> }` (a struct type of the fields read) and read it with `(object/get ?data <field> <default>)`",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintFetchByIdPayload"
        }
      ]
    },
