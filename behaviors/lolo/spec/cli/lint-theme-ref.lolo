app lint-theme-ref-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint theme-ref <file>`. It lowers the file with program/read and reports ORB_X_UNKNOWN_THEME for every app, orbital or themes-list theme reference that is neither an Alias.theme form, an inline theme name nor a built-in theme key (status 500, exit 1); clean answers status 200."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintThemeRefSpec {
  expects trait OrbLintThemeRef {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintThemeRefCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintThemeRef, OrbLintThemeRefCli
}
