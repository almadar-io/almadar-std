app lint-trait-ref-config-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint trait-ref-config <file>`: the port of the call-site config rules for trait references (ORB_T_CONFIG_UNKNOWN_CALL_SITE_KEY, ORB_T_CONFIG_MISSING_REQUIRED_KEY, ORB_T_EVENT_RENAME_UNKNOWN_KEY). It pairs each `Alias.traits.Name` trait entry of the unresolved file with the upstream trait and reports the findings at `orbitals[name=<orbital>].traits[<index>]` (status 500, exit 1); clean answers `lint trait-ref-config: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2). It also checks renames on references to a trait declared inline in the same file (ORB_T_EVENT_RENAME_UNKNOWN_KEY at `orbitals[i (Orbital)].traits[j (label)]`)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }

orbital LintTraitRefConfigSpec {
  expects trait OrbLintTraitRefConfig {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintTraitRefConfigCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintTraitRefConfig, OrbLintTraitRefConfigCli
}
