app lint-inbound-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint inbound <file>`, the port of ORB_INBOUND_ENTRY_INVALID, ORB_INBOUND_UNDECLARED, ORB_INBOUND_DUPLICATE, ORB_INBOUND_VERIFY_INVALID and ORB_INBOUND_ANSWER_UNDECLARED. It lowers the file with program/read, checks the app's inbound entries and every inline trait event that handles an inbound hook, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint inbound: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintInboundSpec {
  expects trait OrbLintInbound {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintInboundCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintInbound, OrbLintInboundCli
}
