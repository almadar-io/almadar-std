app lint-state-shape-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint state-shape <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintStateShapeSpec {
  expects trait OrbLintStateShape {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintStateShapeCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-state-shape" -> OrbLintStateShape, OrbLintStateShapeCli
}
