app lint-empty-event-name-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint empty-event-name <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintEmptyEventNameSpec {
  expects trait OrbLintEmptyEventName {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintEmptyEventNameCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-empty-event-name" -> OrbLintEmptyEventName, OrbLintEmptyEventNameCli
}
