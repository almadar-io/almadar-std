{
  "atom": "cli/atoms/std-orb-lint-async-result-deaf-target.lolo",
  "trait": "OrbLintAsyncResultDeafTarget",
  "note": "Cases copy the four async_results.rs unit tests (deaf target flagged; every-result-handled, self-transition and call-service controls) plus two deaf results sorted with 'them', a wildcard arm control, a multi-from self-transition control, a multi-from display, and a persist nested in an if at its transition index. Expected findings are the code, path, message and suggestion the Rust validator reports; severity is error.",
  "cases": [
    {
      "id": "async-result-deaf-target-when-destination-state-has-no-arm-for-success",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "p",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "E",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "T",
                      "linkedEntity": "E",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "browsing",
                            "isInitial": true
                          },
                          {
                            "name": "loading",
                            "isInitial": false
                          }
                        ],
                        "transitions": [
                          {
                            "from": "browsing",
                            "to": "loading",
                            "event": "REFRESH",
                            "effects": [
                              [
                                "fetch",
                                "Item",
                                {
                                  "emit": {
                                    "success": "ItemLoaded",
                                    "failure": "ItemFailed"
                                  }
                                }
                              ]
                            ]
                          },
                          {
                            "from": "loading",
                            "to": "browsing",
                            "event": "ItemFailed"
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintAsyncResultDeafTarget"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "async-result-deaf-target",
                  "findings": [
                    {
                      "code": "ORB_CIRCUIT_ASYNC_RESULT_DEAF_TARGET",
                      "path": "orbitals[0 (O)].traits[0 (T)].stateMachine.transitions[0].effects",
                      "message": "transition browsing--[REFRESH]-->loading declares async result event(s) [\"ItemLoaded\"] but state 'loading' has no arm handling it — the requester departs before it can hear its own operation's result",
                      "suggestion": "Add a transition `from: 'loading'` handling each of [\"ItemLoaded\"] in state 'loading' (or route the result to a state that already does).",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintAsyncResultDeafTarget"
        }
      ]
    },
