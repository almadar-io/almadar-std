{
  "atom": "cli/atoms/std-orb-lint-map-path-key.lolo",
  "trait": "OrbLintMapPathKey",
  "note": "object/set, object/get and object/has read their key as a dot path. A key built with str/concat from a string literal containing \".\" aimed at an entity field declared as a Map nests the value instead of naming one entry; literal path keys, record targets, non-field targets and other separators are clean.",
  "cases": [
    {
      "id": "object-set-on-a-map-field-with-a-dotted-concat-key",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "app",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "Run",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      },
                      {
                        "name": "cache",
                        "type": "object",
                        "items": {
                          "type": "number"
                        }
                      },
                      {
                        "name": "rec",
                        "type": "object",
                        "properties": {
                          "a": {
                            "name": "a",
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "T",
                      "linkedEntity": "Run",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "GO",
                            "effects": [
                              [
                                "set",
                                "@entity.cache",
                                [
                                  "object/set",
                                  "@entity.cache",
                                  [
                                    "str/concat",
                                    [
                                      "object/get",
                                      "@payload.row",
                                      "store"
                                    ],
                                    ".",
                                    [
                                      "object/get",
                                      "@payload.row",
                                      "field"
                                    ]
                                  ],
                                  1
                                ]
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "trait": "OrbLintMapPathKey"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "map-path-key",
                  "scope": "",
                  "findings": [
                    {
                      "code": "ORB_MAP_KEY_DOT_PATH",
                      "path": "orbitals[0 (O)].traits[0 (T)].stateMachine.transitions[0]",
                      "message": "object/set reads its key as a dot path, so the key built with str/concat from a literal containing \".\" nests under 'cache' instead of naming one map entry",
                      "suggestion": "Join the key parts with a separator other than \".\", such as \"|\".",
                      "severity": "warning"
                    }
                  ]
                }
              }
            ]
          },
          "trait": "OrbLintMapPathKey"
        }
      ]
    },
