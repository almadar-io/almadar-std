app lint-store-binding-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint store-binding <file>`, the port of store_binding.rs (EXEC-STORE-4) less ORB_STORE_DRIVER_NOT_CONDITIONAL (persist-effect walk, waits on tree/fold). The file is lowered with program/read. For the program-level store and every entity store (primary and auxiliary, in orbital order): a store on a runtime or browser-local entity is `[ORB_STORE_ON_NON_PERSISTENT] <path>: entity <name> binds store <driver> but its rows live in no store (runtime or browser-local)`; then, once per driver at its first binding, a driver naming no orbital is `[ORB_STORE_UNKNOWN_ORBITAL] <path>: store <driver> names no orbital of this program (valid: <names>)` and a driver whose traits do not handle every row verb (ROW_READ, ROW_LIST, ROWS_QUERY, ROWS_WRITE) is `[ORB_STORE_DRIVER_CONTRACT] <path>: store driver <driver> has no trait handling [<missing>] (spec/infra/row-store.lolo RowStoreDriver)`. Findings answer status 500 (exit 1); a clean program answers `lint store-binding: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]

orbital LintStoreBindingSpec {
  expects trait OrbLintStoreBinding {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [string]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintStoreBindingCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-store-binding" -> OrbLintStoreBinding, OrbLintStoreBindingCli
}
