app lint-store-binding-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint store-binding <file>`, the port of store_binding.rs (EXEC-STORE-4). The file is lowered with program/read. For the program-level store and every entity store (primary and auxiliary, in orbital order): a store on a runtime or browser-local entity is `[ORB_STORE_ON_NON_PERSISTENT] <path>: entity <name> binds store <driver> but its rows live in no store (runtime or browser-local)`; then, once per driver at its first binding, a driver naming no orbital is `[ORB_STORE_UNKNOWN_ORBITAL] <path>: store <driver> names no orbital of this program (valid: <names>)` and a driver whose traits do not handle every row verb (ROW_READ, ROW_LIST, ROWS_QUERY, ROWS_WRITE) is `[ORB_STORE_DRIVER_CONTRACT] <path>: store driver <driver> has no trait handling [<missing>] (spec/store/row-store.lolo RowStoreDriver)`. When the program binds a driver, every `(emit <row verb> …)` in a trait outside a driver orbital is `[ORB_STORE_VERB_OUTSIDE_SEAM] orbitals[<i>].traits.<trait>: trait <trait> emits the row verb <verb>; a store driver is asked only by the store seam, one frame per ask (EXEC-STORE-4)`, and a single persist delete or update on an entity whose driver declares writeCapabilities.conditional false is `[ORB_STORE_DRIVER_NOT_CONDITIONAL] orbitals[<i> (<orbital>)].traits[<j> (<trait>)]: persist on <entity> is one conditional op (EXEC-STEP-8), and its store driver <driver> declares writeCapabilities.conditional false`. Findings answer status 500 (exit 1); a clean program answers `lint store-binding: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintStoreBindingSpec {
  expects trait OrbLintStoreBinding {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintStoreBindingCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-store-binding" -> OrbLintStoreBinding, OrbLintStoreBindingCli
}
