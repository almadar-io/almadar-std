app lint-rui-binding-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint rui-binding <file>`. It lowers the file with program/read and reports ORB_X_RENDER_UI_EVENT_LITERAL_STALE and ORB_RUI_RENDERABLE_IN_GENERIC_FIELD over the render-ui patterns and entity-field sets of every inline trait transition (status 500, exit 1). Clean answers `lint rui-binding: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintRuiBindingSpec {
  expects trait OrbLintRuiBinding {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintRuiBindingCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintRuiBinding, OrbLintRuiBindingCli
}
