app lint-config-dangling-ref-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint config-dangling-ref <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintConfigDanglingRefSpec {
  expects trait OrbLintConfigDanglingRef {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintConfigDanglingRefCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintConfigDanglingRef, OrbLintConfigDanglingRefCli
}
