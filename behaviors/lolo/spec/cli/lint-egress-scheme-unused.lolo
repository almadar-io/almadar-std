app lint-egress-scheme-unused-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint egress-scheme-unused <file>`: an app egress entry with the scheme redis, rediss, postgres or postgresql grants nothing since the TCP protocol-target grants were retired (G-ORB-586), and is reported with the net grant that replaces it (ORB_OS_EGRESS_SCHEME_UNUSED, status 500, exit 1). Clean answers `lint egress-scheme-unused: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintEgressSchemeUnusedSpec {
  expects trait OrbLintEgressSchemeUnused {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintEgressSchemeUnusedCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintEgressSchemeUnused, OrbLintEgressSchemeUnusedCli
}
