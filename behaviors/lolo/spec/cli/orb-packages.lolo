app orb-packages-spec [
  version: "1.0.0",
  description: "Design contract for `orb add|update|remove|list [--global]` and `orb engines add|update|remove|list`, the client of the package registry (spec/ops/package-registry.lolo). Golden = orbital-cli packages.rs and engines_cmd.rs today; the change is that a package is installed by URL at one exact version and the lockfile {name, version, url, integrity} replaces bun (ranges are refused with ORB_PACKAGE_RANGE; a package with non-orb dependencies is refused). Direct tarball URLs are valid sources only under the registry knob (required, no default) or a sourceOrigins entry (each declared in egress); any other host is refused ORB_PACKAGE_SOURCE. A name resolves through the registry knob. Integrity is sha256 over the downloaded gzip tarball; a mismatch installs nothing (ORB_PACKAGE_INTEGRITY). A package kind is read from its package.json: orbLanguage = language, orb = behaviors, orbVocabulary = language pack, orbProgram.kind shell|desktop = shell|desktop; no kind is refused ORB_PACKAGE_NOT_ORB with `<name>: not an orb package (its package.json declares none of orbLanguage, orb, orbVocabulary, orbProgram)`. add: installs, then checks each named or newly appeared package; a clean one prints `added <name>@<version> (<kinds joined by , >)`; one that declares no kind or does not load is refused and, if this call added it, removed again; any refusal fails with `not added:` and one indented `<name>: <problem>` line per refusal; an install that yields no package fails `installed nothing for <specs>`. update: installs the baseline (the `baseline` knob: {name, version, registry} entries at exact versions, seeded by the installer; core pin, std, first-party language packs, default programs) for each one missing, fails `did not install <specs>` when one is still absent, then moves every non-linked orb package to the highest non-yanked version by semver order, written exact into the lockfile (a workspace-linked package is never updated), prints the list rows, removes again what this call added and does not load, records the update check, and fails `these packages do not load for this orb:` with one indented `<name>: <problem>` line each. remove: a workspace-linked package is refused ORB_PACKAGE_LINKED and its link is never deleted; a behavior package whose prefix a .lolo or .orb file still imports (skipping node_modules, .git, dist, target) is refused `refusing to remove '<name>': N file(s) still import '<prefix>/':` plus the files, one per line; otherwise prints `removed <name>` per name. list: one row per installed orb package, sorted by name, columns package (34), version (12), kinds joined by `, ` (26), then `ok` or the problem, ` (linked)` for a workspace link, and ` [<prefix>/, N behaviors]` for a behavior package; --json prints the rows { package, kinds, version, path, link, prefix?, behaviors?, problem } as pretty JSON; with no rows the table is empty and stderr says `orb: nothing is installed in <dir> (no @almadar/core or @almadar/std); run `orb update --global` to set the language up`. Without --global the project directory is used, falling back to the user store when there is no project. Engines: `engines add|update` install the pinned runtime-verify/compiled engine packages at the exact pinned version (`installed <package>@<version> (entry <bin> → <path>)`; a wrong version fails `<package>: expected version <v>, got <w>`, a missing bin entry `<package>: installed package has no `<bin>` bin entry`, a package not found after install `<package>: install reported success but the package was not found`), update prints `updated <package>: <old> → <new>` or `<package>@<old> already up to date` or `installed <package>@<version>`, remove prints `removed <package>`, list prints rows engine (16), package (32), version (12), link (6), path, or `not installed — <hint>`, --json the rows { engine, package, version, entry, path, installed, link }."
]

type PackageKind = "language" | "behaviors" | "language pack" | "shell" | "desktop"
type PackageRow = { package : string!, kinds : [PackageKind]!, version : string!, path : string!, link : boolean!, prefix : string?, behaviors : number?, problem : string? }
type LockEntry = { name : string!, version : string!, url : string!, integrity : string! }
type BaselineEntry = { name : string!, version : string!, registry : string! }
type EngineRow = { engine : string!, package : string!, version : string?, entry : string?, path : string?, installed : boolean!, link : boolean! }

orbital OrbPackagesSpec {
  expects config { registry : string  sourceOrigins : [string] = ["https://registry.npmjs.org"]  lockfile : string = "orb.lock.json"  baseline : [BaselineEntry] = [] }
  expects entity PackageCall [runtime] {
    id : string!
    status : number
    lock : [LockEntry]
    @invariant (>= @entity.status 0)
  }
  expects trait OrbPackages {
    state ready
    state resolving
    state downloading
    state verifying
    state installing
    state checking
    state listing
    emits {
      PACKAGES_ANSWERED { status : number!  body : string!  stderr : string }
      PACKAGE_INSTALLED { name : string!  version : string!  kinds : [PackageKind]! }
      PACKAGE_REFUSED { name : string!  problem : string! }
    }
  }
  expects page boot -> OrbPackages
}
