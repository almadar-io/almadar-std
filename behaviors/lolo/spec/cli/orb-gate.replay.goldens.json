{
  "atom": "cli/atoms/std-orb-gate.lolo",
  "trait": "OrbGate",
  "cases": [
    {
      "id": "control-identical-lists-pass",
      "entity": {
        "knownPath": "gates/known.txt",
        "observedPath": "obs.txt",
        "knownText": "a  G-STD-001\nb  G-STD-001\n",
        "observedText": "b\na\n"
      },
      "steps": [
        {
          "from": "comparing",
          "event": "GATE_COMPARE",
          "payload": {},
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "GATE_ANSWERED",
                "payload": {
                  "status": 200,
                  "body": "0 new, 0 fixed, 2 known"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-new-failure-fails",
      "entity": {
        "knownPath": "gates/known.txt",
        "observedPath": "obs.txt",
        "knownText": "a  G-STD-001\n",
        "observedText": "a\nc\n"
      },
      "steps": [
        {
          "from": "comparing",
          "event": "GATE_COMPARE",
          "payload": {},
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "GATE_ANSWERED",
                "payload": {
                  "status": 500,
                  "body": "new    c\n1 new, 0 fixed, 1 known"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-fixed-failure-still-listed-fails",
      "entity": {
        "knownPath": "gates/known.txt",
        "observedPath": "obs.txt",
        "knownText": "a  G-STD-001\nb  G-STD-001\n",
