  {
   "id": "a refusal (missing file, lowering error, lazy or locales without --output, failed write) answers 500 with its reason",
   "steps": [
    {
     "trait": "ResolveEngine",
     "from": "resolving",
     "event": "RESOLVE_REFUSED",
     "payload": {
      "error": "program/read: /w/a.lolo declares locales; each locale's catalog is written beside the resolved .orb — pass --output"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "RESOLVE_ANSWERED",
        "payload": {
         "status": 500,
         "body": "",
         "stderr": "Error: program/read: /w/a.lolo declares locales; each locale's catalog is written beside the resolved .orb — pass --output"
        }
       }
      ]
     }
    }
   ]
  },
