  {
   "id": "the engine answer is relayed with its stderr",
   "steps": [
    {
     "trait": "OrbResolve",
     "from": "working",
     "event": "RESOLVE_DONE",
     "payload": {
      "status": 500,
      "body": "",
      "stderr": "Error: x"
     },
     "expect": {
      "state": "ready",
      "emits": [
