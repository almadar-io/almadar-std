{
 "atom": "cli/atoms/std-orb-resolve.lolo",
 "trait": "ResolveEngine",
 "cases": [
  {
   "id": "the call asks std-args to parse with the output flag table and its -o alias",
   "steps": [
    {
     "trait": "OrbResolve",
     "from": "ready",
     "event": "RESOLVE_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\": [\"a.lolo\", \"-o\", \"r.orb\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "state": "parsing",
      "emits": [
       {
        "event": "RESOLVE_ARGS_PARSE",
        "payload": {
         "stage": "resolve",
         "argv": [
          "a.lolo",
          "-o",
          "r.orb"
         ],
         "flags": [
          {
           "name": "output",
           "aliases": [
            "-o"
           ],
           "takesValue": true,
           "repeatable": false
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a relative file is joined to the working directory",
   "steps": [
    {
     "trait": "OrbResolve",
     "from": "ready",
     "event": "RESOLVE_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\": [\"a/b.lolo\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "state": "parsing"
     }
    },
    {
     "trait": "OrbResolve",
     "from": "parsing",
     "event": "RESOLVE_ARGS_DONE",
     "payload": {
      "stage": "resolve",
      "flags": {},
      "positionals": [
       "a/b.lolo"
      ],
      "errors": [],
      "words": []
     },
     "expect": {
      "state": "working",
      "emits": [
       {
        "event": "RESOLVE_START",
        "payload": {
         "path": "/w/a/b.lolo",
         "output": "",
         "hasOutput": false
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an absolute file is kept as given",
   "steps": [
    {
     "trait": "OrbResolve",
     "from": "ready",
