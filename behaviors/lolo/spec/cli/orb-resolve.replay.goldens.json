     "payload": {
      "stage": "resolve",
      "flags": {},
      "positionals": [
       "/x/b.lolo"
      ],
      "errors": [],
      "words": []
     },
     "expect": {
      "state": "working",
      "emits": [
       {
        "event": "RESOLVE_START",
        "payload": {
         "path": "/x/b.lolo",
         "output": "",
         "hasOutput": false
        }
       }
      ]
     }
    }
   ]
  },
