  {
   "id": "start without an output resolves the path",
   "steps": [
    {
     "trait": "ResolveEngine",
     "from": "idle",
     "event": "RESOLVE_START",
     "payload": {
      "path": "/w/a.lolo",
      "output": "",
      "hasOutput": false
     },
     "expect": {
      "state": "resolving"
     }
    }
   ]
  },
  {
   "id": "start with an output resolves the path and writes there",
   "steps": [
    {
     "trait": "ResolveEngine",
     "from": "idle",
     "event": "RESOLVE_START",
     "payload": {
      "path": "/w/a.lolo",
      "output": "r.orb",
      "hasOutput": true
     },
     "expect": {
      "state": "resolving"
     }
    }
   ]
  },
  {
   "id": "a resolved program prints its text and drops the program tree",
   "steps": [
    {
     "trait": "ResolveEngine",
     "from": "idle",
     "event": "RESOLVE_START",
     "payload": {
      "path": "/w/a.lolo",
      "output": "",
      "hasOutput": false
     },
     "expect": {
      "state": "resolving"
     }
    },
    {
     "trait": "ResolveEngine",
     "from": "resolving",
     "event": "RESOLVE_RESOLVED",
     "payload": {
      "result": {
       "program": {
        "name": "a",
        "orbitals": []
       },
       "text": "{\n  \"name\": \"a\",\n  \"orbitals\": []\n}"
      }
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "RESOLVE_ANSWERED",
        "payload": {
         "status": 200,
         "body": "{\n  \"name\": \"a\",\n  \"orbitals\": []\n}"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control: with --output the resolved text is written by the host and not printed",
   "steps": [
    {
     "trait": "ResolveEngine",
     "from": "idle",
     "event": "RESOLVE_START",
     "payload": {
      "path": "/w/a.lolo",
      "output": "r.orb",
      "hasOutput": true
