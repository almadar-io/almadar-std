{
 "atom": "cli/atoms/std-orb-lint-sign-in-route.lolo",
 "trait": "OrbLintSignInRoute",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. Added cases follow validate_sign_in_route (page.rs; it has no Rust test): the host route is exempt, paths compare normalized, a lazy page counts, and every page on the reserved route is its own finding.",
 "cases": [
  {
   "id": "page-on-the-host-login-route",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/login",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintSignInRoute"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "sign-in-route",
         "findings": [
          {
           "code": "ORB_P_HOST_RESERVED_ROUTE",
           "path": "/login",
           "message": "'/login' is the host's own sign-in route; no page may be declared on it",
           "suggestion": "move this page to another route; name `signIn: \"/login\"` to send viewers to the host's sign-in",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintSignInRoute"
    }
   ]
  },
