app lint-call-service-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint call-service <file>`: it reports ORB_EFF_CALL_SERVICE_MISSING_SERVICE, ORB_EFF_CALL_SERVICE_UNKNOWN_SERVICE, ORB_EFF_CALL_SERVICE_MISSING_ACTION, ORB_EFF_CALL_SERVICE_UNKNOWN_PARAM, ORB_EFF_CALL_SERVICE_MISSING_PARAM, ORB_EFF_CALL_SERVICE_PARAM_TYPE and ORB_CALL_SERVICE_RESULT_HAS_KEY for the call-service forms of inline traits, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint call-service: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintCallServiceSpec {
  expects trait OrbLintCallService {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintCallServiceCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintCallService, OrbLintCallServiceCli
}
