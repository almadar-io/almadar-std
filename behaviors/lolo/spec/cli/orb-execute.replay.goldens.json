{
 "atom": "cli/atoms/std-orb-execute.lolo",
 "trait": "OrbExecute",
 "cases": [
  {
   "id": "a call parses its words against the six flags",
   "steps": [
    {
     "trait": "OrbExecute",
     "from": "ready",
     "event": "EXEC_CALLED",
     "payload": {
      "rawBody": "{\"argv\": [\"a.lolo\", \"--steps\", \"[]\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "fired": true,
      "state": "parsing",
      "emits": [
       {
        "event": "EXEC_ARGS_PARSE",
        "payload": {
         "stage": "execute",
         "argv": [
          "a.lolo",
          "--steps",
          "[]"
         ],
         "flags": [
          {
           "name": "steps",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "live",
           "aliases": [],
           "takesValue": false,
           "repeatable": false
          },
          {
           "name": "event",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "trait",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "payload",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          },
          {
           "name": "cascade",
           "aliases": [],
           "takesValue": false,
           "repeatable": false
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
