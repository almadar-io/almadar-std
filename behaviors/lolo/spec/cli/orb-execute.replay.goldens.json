  {
   "id": "a steps run answers the report as it came, re-indented",
   "entity": {
    "mode": "steps"
   },
   "steps": [
    {
     "trait": "OrbExecute",
     "from": "stepping",
     "event": "EXEC_STEPPED",
     "payload": {
      "result": {
       "success": true,
       "steps": [
        {
         "outcomes": [
          {
           "trait": "Sender",
           "newState": "sent"
          }
         ],
         "states": {
          "Sender": "sent"
         }
        }
       ],
       "dispatchModes": {
        "Sender": "hybridClientOnly"
       }
      }
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "EXEC_ANSWERED",
        "payload": {
         "status": 200,
         "body": "{\n  \"success\": true,\n  \"steps\": [\n    {\n      \"outcomes\": [\n        {\n          \"trait\": \"Sender\",\n          \"newState\": \"sent\"\n        }\n      ],\n      \"states\": {\n        \"Sender\": \"sent\"\n      }\n    }\n  ],\n  \"dispatchModes\": {\n    \"Sender\": \"hybridClientOnly\"\n  }\n}"
        }
       }
      ]
     }
    }
   ]
  },
