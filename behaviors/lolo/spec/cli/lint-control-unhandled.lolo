app lint-control-unhandled-spec [
  version: "1.0.0",
  description: "std-orb-lint-control-unhandled - the `orb lint control-unhandled <file>` command, the port of validate_controls_handled (final_program.rs, G-ORB-187), the `orb validate --final` rule: a control event that a trait's rendered patterns fire (std-orb-fired-events' byControl, which already drops provably false branches and bus-excluded names) reaches the rendering trait and every trait that embeds it, directly or transitively through any referrer (std-orb-embed-chain's embedders) plus every `listens` route out of them. A control none of those handle, by a transition of the trait or a host, or by a listens route (an `any` source, or a trait or orbital source naming one of them, on the orbital or on any trait), does nothing when operated: ORB_EMIT_CONTROL_UNHANDLED at orbitals.<O>.traits.<T>. An event named by an emits entry carrying a definerKnob is the atom offering an affordance and is exempt. The finding reads its code from the rule's `codes` knob. Clean answers `lint control-unhandled: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintControlUnhandledSpec {
  expects trait OrbLintControlUnhandled {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintControlUnhandledCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintControlUnhandled, OrbLintControlUnhandledCli
}
