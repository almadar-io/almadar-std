{
 "atom": "cli/atoms/std-orb-update-notice.lolo",
 "trait": "OrbUpdateNotice",
 "source": "orbital-cli/src/commands/update_notice.rs",
 "note": "Expected values follow the Rust code (it has no tests). Each step seeds its entity; the replay kernel answers every os read, write and getenv with an unsupported failure, so a step's cascade runs on through those failure events, and the file answers a later step would carry are fed as seeded steps. Byte payloads (data) are standard base64 of the file text.",
 "cases": [
  {
   "id": "record-stamps-the-cache-without-gating",
   "steps": [
    {
     "event": "UPDATE_NOTICE_CALLED",
     "payload": {
      "rawBody": "{\"argv\": [\"record\"], \"cwd\": \"/w\"}"
     },
     "expect": {
      "emits": [
       {
        "event": "UN_WRITE",
        "payload": {}
       }
      ],
      "neverEmits": [
       "UN_GATE"
      ]
     }
    }
   ]
  },
  {
   "id": "check-gates-before-anything-is-written",
   "steps": [
