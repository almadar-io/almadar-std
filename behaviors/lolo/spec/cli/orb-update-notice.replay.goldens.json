      "rawBody": "{\"argv\": [], \"cwd\": \"/w\"}"
     },
     "expect": {
      "emits": [
       {
        "event": "UN_GATE",
        "payload": {}
       }
      ],
      "neverEmits": [
       "UN_WRITE"
      ]
     }
    }
   ]
  },
