{
  "atom": "cli/atoms/std-orb-lint-expectation-final.lolo",
  "trait": "OrbLintExpectationFinal",
  "note": "Expected findings are the code, path, message and suggestion `orb validate --final` (the Rust validator) reports for the same program. The first five cases copy composition/expectations.rs an_expectation_no_entity_provides_is_an_error_in_a_finished_program and control_a_provided_name_passes and tests/expectations_validation.rs final_validation_now_reports_an_unprovided_event_and_page; the rest pin the spec orbital (final checks spec orbitals too), the bare identity and the config knob.",
  "cases": [
    {
      "id": "an-expectation-no-entity-provides-is-an-error-in-a-finished-program",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "App",
              "orbitals": [
                {
                  "name": "Apps",
                  "entity": {
                    "name": "AppsENStudioApp",
                    "persistence": "persistent",
                    "identity": false,
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [],
                  "pages": []
                },
                {
                  "name": "Builder",
                  "entity": {
                    "name": "BuilderView",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "expects": [
                    {
                      "kind": "entity",
                      "name": "StudioApp"
                    }
                  ],
                  "traits": [],
                  "pages": []
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintExpectationFinal"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "expectation-final",
                  "findings": [
                    {
                      "code": "ORB_S_EXPECTATION_UNSATISFIED",
                      "path": "orbitals[1 (Builder)].expects[0]",
                      "message": "`Builder` expects entity `StudioApp`, but nothing in this program provides it — its reads, writes and navigation would reach nothing.",
                      "suggestion": "Provide it in an orbital of this program (give the providing import that name, or declare it here).",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintExpectationFinal"
        }
      ]
