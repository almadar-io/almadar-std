app lint-entity-seed-source-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint entity-seed-source <file>`, the port of ORB_E_SEED_SOURCE_CONFLICT. It lowers the file with program/read and reports, per orbital entity, a `mock` seed declared together with written-out instances or locale instances, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint entity-seed-source: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintEntitySeedSourceSpec {
  expects trait OrbLintEntitySeedSource {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintEntitySeedSourceCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintEntitySeedSource, OrbLintEntitySeedSourceCli
}
