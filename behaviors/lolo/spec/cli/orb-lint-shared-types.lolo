app orb-lint-shared-types-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint shared-types`, the guard behind the owner's 'shared types are copies' ruling. Every .lolo under the std and io behavior trees is lowered with program/read and every declared type alias is collected by name with its lowered definition. A name whose definitions differ across files is reported with the files of each variant and the fields that differ, status 500 (exit 1). When every copy of every name agrees the answer is `shared-types: consistent` (status 200, exit 0). Any argument is the usage (status 400, exit 2). A file that cannot be read or lowered is reported as UNREAD and fails the run."
]

type LintTypeCopy = { name : string!, file : string!, definition : string!, fields : [string]! }
type LintTypeDrift = { name : string!, variants : number!, files : [string]! }

orbital OrbLintSharedTypesSpec {
  expects trait OrbLintSharedTypes {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-shared-types" -> OrbLintSharedTypes
}
