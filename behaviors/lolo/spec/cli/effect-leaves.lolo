app effect-leaves-spec [
  version: "1.0.0",
  description: "Design contract for the shared effect leaves: for the lowered program's orbitals and the operator heads a rule checks, it answers EFFECT_LEAVES_EXPANDED { requestId, leaves }, one leaf per effect that is not a do, if, when or let form and whose head is asked, in program order, with its path, the flat typed nodes of the effect (asked from std-orb-lint-input's OrbLintExprNodes; the effect is the last node) and its orbital and trait index."
]
type LeafNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type EffectLeaf = { p : string!, n : [LeafNode]!, oi : number!, ti : number! }

orbital EffectLeavesSpec {
  expects entity OrbEffectLeavesRun [runtime] {
    id : string!
  }
  expects trait OrbEffectLeaves {
    state ready
    emits {
      EFFECT_LEAVES_EXPANDED { requestId : string!  leaves : [EffectLeaf]! }
    }
  }
  expects page boot -> OrbEffectLeaves
}
