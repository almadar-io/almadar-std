app orb-i18n-spec [
  version: "1.0.0",
  description: "Design contract for `orb i18n vocab [--json]` and `orb i18n check`. The English side is installed data: the 12 parser sections (keywords shapes tags categories capabilities annotations sigils effects types units literals reservedEvents) are the lists in the file @almadar/core declares as orbLanguage.vocabulary; the `orb` section (structural .orb keys) comes from the knob orbSource under @almadar/core (the stand-in src/i18n/en.json until core emits it into the vocabulary file); the operator table is the key set of the file @almadar/std declares as orbLanguage.operators. Every English word maps to itself. The other languages are the installed packs (std-orb-language discovery). vocab prints one line per section `<name> (<count>): <words joined by a space>` in the order above then orb and operators (both sorted), or with --json one document with those 14 arrays (2-space indent). check applies, per non-English language in code order and per section in the same 14-section order: each English key the language lacks (Missing) or maps to an empty value (Empty), in key order, then each key English lacks (Orphan); then, a second pass, each key whose value another earlier key of the same section has (Collision); then each first-token keyword (app uses expects type theme orbital) and orb.orbitals whose translation another language also uses (SelectorNotUnique); then, per language, each parser word that is missing or empty (`<code>.<section>.<word>: missing|empty`). Clean prints `orb i18n check: ok — 0 problems` (status 200); otherwise `orb i18n check: N problem(s)` then the groups with their counts, never truncated (status 500, exit 1). Any other argument is the usage (status 400). Golden = orbital-cli i18n.rs; the parser-vs-English equality gate has no counterpart because the parser lists are the English table."
]

type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbI18nSpec {
  expects entity I18nCall [runtime] {
    id : string!
    cmd : string
    json : boolean
  }
  expects trait OrbI18n {
    state ready
    state parsing
    state loading
    state checking
    emits {
      I18N_ANSWERED { status : number!  body : string!  stderr : string }
    }
  }
  expects page "/orb-i18n" -> OrbI18n
}
