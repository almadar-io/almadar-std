app lint-client-tick-locality-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint client-tick-locality <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintClientTickLocalitySpec {
  expects trait OrbLintClientTickLocality {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintClientTickLocalityCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintClientTickLocality, OrbLintClientTickLocalityCli
}
