app lint-derived-field-write-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint derived-field-write <file>`: a `set` of a `@derived` field of the trait's entity, or a `persist create|update|upsert` whose data names a `@derived` field, is `[ORB_DERIVED_FIELD_WRITTEN]`. Findings answer status 500 (exit 1); a clean program answers `lint derived-field-write: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintDerivedFieldWriteSpec {
  expects trait OrbLintDerivedFieldWrite {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintDerivedFieldWriteCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintDerivedFieldWrite, OrbLintDerivedFieldWriteCli
}
