app orb-agent-spec [
  version: "1.0.0",
  description: "Design contract for the `orb` commands that delegate to an agent program: `fix <file>`, `eval [--all] [spec]`, `trace [session]`, `login` and `status`. Each forwards its words to the agent program with the terminal handed over, so prompts and live output reach the user and nothing is captured (the answer body is empty); delegation is opt-in, so a call made without the opt-in is refused, and a call with the wrong number of words is a usage error (exit 2). A run that exits 0 answers its output (exit 0); any other exit, a missing agent bundle or a program that cannot start answers its message (exit 1). Exact exit-code passthrough waits for InboundAnswer to gain an exit field."
]

orbital OrbAgentSpec {
  expects trait OrbAgent {
    state ready
    emits {
      AGENT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-agent" -> OrbAgent
}
