app lint-composed-wiring-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint composed-wiring <file>`, the port of ORB_COMPOSED_STATE_UNREACHABLE and ORB_COMPOSED_TRANSITION_UNREACHABLE. Findings are reported at orbitals[<i>].traits[<j>] (status 500, exit 1). A clean program answers `lint composed-wiring: clean` (status 200, exit 0). Anything but exactly one file argument is the usage (status 400, exit 2). A file that cannot be read or lowered fails the run (status 500)."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintComposedWiringSpec {
  expects trait OrbLintComposedWiring {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintComposedWiringCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintComposedWiring, OrbLintComposedWiringCli
}
