{
 "atom": "cli/atoms/std-orb-lint-init-coverage.lolo",
 "trait": "OrbLintInitCoverage",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. Added cases copy init_coverage.rs a_wildcard_init_arm_covers_every_state, a_trait_that_does_not_init_in_its_initial_state_is_not_checked and a_state_reached_only_through_a_dead_guard_is_not_reported.",
 "cases": [
  {
   "id": "reachable-state-without-an-init-arm",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             },
             {
              "name": "busy"
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "busy",
              "event": "GO"
             },
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintInitCoverage"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "init-coverage",
         "findings": [
          {
           "code": "ORB_CIRCUIT_INIT_UNCOVERED_STATE",
           "path": "orbitals[0 (A)].traits[0 (T)].stateMachine.states.busy",
           "message": "Page trait 'T' handles INIT in 'idle' but not in reachable state 'busy': revisiting the page from there does nothing",
           "suggestion": "Add an `INIT` arm to state 'busy' that re-initializes the trait (as 'idle' does)",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintInitCoverage"
    }
   ]
  },
