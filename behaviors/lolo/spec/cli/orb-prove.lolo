app orb-prove-spec [
  version: "1.0.0",
  description: "Design contract for `orb prove <file>`; see the atom."
]
orbital OrbProveSpec {
  expects trait OrbProve {
    state ready
    emits {
      PROVE_ANSWERED { status : number!  body : string!  stderr : string }
    }
  }
  expects page boot -> OrbProve
}
