app orb-validate-spec [
  version: "1.0.0",
  inbound: ["cli-validate"],
  description: "Design contract for `orb validate <file> [--json] [--deny-warnings] [--final] [--patterns <path>] [--services <path>]`. The core checks are program/validate { report: true, path, final, denyWarnings, patterns?, services? }, which answers the report `orb validate --json` printed: { success, valid, errors?, warnings?, stats? } (a finding is { code, path, message, suggestion?, fixGuidance?, validValues?, line?, column?, endLine?, endColumn?, approximate? }). --json: the report as 2-space pretty JSON, status 200 (the Rust command exited 0 for an invalid program). Text: stdout `Validating schema: <file>`; errors print `Schema validation errors:` and `  ❌ [CODE] path: message[ @ line:col][ 💡 suggestion]` per error on stderr then `Error: Schema validation failed with N error(s)` (status 500); warnings alone print `Schema validation warnings:` and `  ⚠️  …` lines on stdout, and under --deny-warnings stderr `Error: Schema validation failed: N warning(s) under --deny-warnings` (status 500); a FILE_READ_ERROR prints `Error: <reason>` on stderr (status 500). Policy lint findings (std-orb-lint-all) merge into the report: severity error joins errors, warning joins warnings; valid is false when a lint error exists, or a lint warning exists under --deny-warnings. Usage (status 400, exit 2): no file, a second file, an unknown flag or a valueless --patterns / --services."
]

orbital OrbValidateSpec {
  expects trait OrbValidate {
    state ready
    state parsing
    state working
    emits {
      VALIDATE_ANSWERED { status : number!  body : string!  stderr : string }
    }
  }
  expects trait ValidateEngine {
    state idle
    state validating
    state linting
    state merging
    state rendering
    emits {
      VALIDATE_ANSWERED { status : number!  body : string!  stderr : string }
    }
  }
  expects page "/orb-validate" -> OrbValidate
}
