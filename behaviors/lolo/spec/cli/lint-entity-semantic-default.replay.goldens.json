{
 "atom": "cli/atoms/std-orb-lint-entity-semantic-default.lolo",
 "trait": "OrbLintEntitySemanticDefault",
 "cases": [
  {
   "id": "url-not-a-url",
   "steps": [
    {
     "trait": "OrbLintEntitySemanticDefault",
     "from": "reading",
     "event": "LINT_PROGRAM_READ",
     "payload": {
      "result": {
       "orbitals": [
        {
         "entity": {
          "name": "Inv",
          "fields": [
           {
            "name": "v",
            "type": "url",
            "default": "Cover Image"
           }
          ]
         }
        }
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintEntitySemanticDefault",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "entity-semantic-default",
         "findings": [
          {
           "code": "ORB_E_SEMANTIC_VALUE_INVALID",
           "path": "orbitals[0].entity.fields[0].default",
           "message": "'Cover Image' is not a valid url",
           "suggestion": "Provide a valid url or drop the default",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
