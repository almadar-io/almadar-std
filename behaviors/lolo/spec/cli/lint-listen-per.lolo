app lint-listen-per-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint listen-per <file>`. It lowers the file with program/read and, for every trait whose listens carry a `per` clause, reports ORB_X_LISTEN_PER_ENTITY when the trait's entity is not a `[runtime]` entity declaring `id : string`, and ORB_X_LISTEN_PER_ROUTED_PAGE when a route page places the trait (status 500, exit 1). Clean answers `lint listen-per: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintListenPerSpec {
  expects trait OrbLintListenPer {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintListenPerCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintListenPer, OrbLintListenPerCli
}
