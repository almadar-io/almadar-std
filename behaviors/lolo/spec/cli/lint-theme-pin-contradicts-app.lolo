app lint-theme-pin-contradicts-app-spec [
  version: "1.0.0",
  description: "Design contract for the `orb lint theme-pin-contradicts-app <file>` command, the port of ORB_THEME_PIN_CONTRADICTS_APP (theme.rs validate_theme_pin_matches_app). It lowers the file with program/read and, when the app declares a theme (a key, or an inline theme's name), reports each orbital whose traits pin a literal non-empty config.theme default (not an @ binding) that differs from it, listing the distinct pins sorted (status 500, exit 1). Clean answers `lint theme-pin-contradicts-app: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintThemePinContradictsAppSpec {
  expects trait OrbLintThemePinContradictsApp {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
      LINT_UNREAD { rule : string! }
    }
  }
  expects trait OrbLintThemePinContradictsAppCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page "/orb-lint-theme-pin-contradicts-app" -> OrbLintThemePinContradictsApp, OrbLintThemePinContradictsAppCli
}
