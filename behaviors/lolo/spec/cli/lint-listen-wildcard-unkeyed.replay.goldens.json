          "trait": "OrbLintListenWildcardUnkeyed"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "listen-wildcard-unkeyed",
                  "findings": [
                    {
                      "code": "ORB_LISTEN_WILDCARD_UNKEYED",
                      "path": "orbitals.O.traits.Consumer.listens",
                      "message": "listens route `*.KNOWLEDGE_FAILED -> LOAD_FAILED` in `O.Consumer` hears every caller's `KNOWLEDGE_FAILED`, whose payload carries the call's `key`, and its guard never reads it",
                      "suggestion": "guard the route on the call's own key: `*.KNOWLEDGE_FAILED -> LOAD_FAILED when (= ?key <the key this trait sent>)`",
                      "severity": "warning"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintListenWildcardUnkeyed"
