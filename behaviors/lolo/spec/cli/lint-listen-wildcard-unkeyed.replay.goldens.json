                {
                  "name": "O",
                  "entity": {
                    "name": "E",
                    "persistence": "runtime",
                    "fields": [
                      {
                        "name": "id",
                        "type": "string"
                      }
                    ]
                  },
                  "traits": [
                    {
                      "name": "Provider",
                      "linkedEntity": "E",
                      "emits": [
                        {
                          "event": "KNOWLEDGE_FAILED",
                          "payloadSchema": [
                            {
                              "name": "key",
                              "type": "CallKey"
                            }
                          ]
                        }
                      ],
                      "stateMachine": {
                        "states": [
                          {
                            "name": "on",
                            "isInitial": true
                          }
                        ],
                        "transitions": []
                      }
                    },
                    {
                      "name": "Consumer",
                      "linkedEntity": "E",
                      "listens": [
                        {
                          "event": "KNOWLEDGE_FAILED",
                          "triggers": "LOAD_FAILED",
                          "source": {
                            "kind": "any"
                          }
                        }
                      ],
                      "stateMachine": {
                        "states": [
                          {
                            "name": "on",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "on",
                            "to": "on",
                            "event": "ASK",
                            "effects": [
                              [
                                "emit",
                                "KNOWLEDGE_ASK",
                                {
                                  "key": [
                                    "as",
                                    "c|ask",
                                    "CallKey"
                                  ]
                                }
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ]
