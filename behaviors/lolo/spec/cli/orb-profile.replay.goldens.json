            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "with-samply-the-launchpad-pid-is-sampled-first",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "starting",
          "event": "PROFILE_PID",
          "payload": {
            "pid": 42
          },
          "entity": {
            "id": "p",
            "mode": "launchpad",
            "samply": true,
            "launchpadPid": 777
          },
          "expect": {
            "fired": true,
            "state": "starting",
            "emits": [
              {
                "event": "PROFILE_SAMPLY_START",
                "payload": {
                  "key": "profile-launchpad-777",
                  "pid": 777,
                  "rateHz": 100
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "the-catalog-leaves-out-specs-and-takes-the-limit",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "listing",
          "event": "PROFILE_CATALOG",
          "payload": {
            "result": [
              {
                "behavior": "a/one",
                "topic": "ui",
                "level": "atom",
                "package": "p"
              },
              {
                "behavior": "a/spec",
                "topic": "spec",
                "level": "atom",
                "package": "p"
              },
              {
                "behavior": "a/two",
                "topic": "ui",
                "level": "atom",
                "package": "p"
              },
              {
                "behavior": "a/three",
                "topic": "ui",
                "level": "atom",
                "package": "p"
              }
            ]
          },
          "entity": {
            "id": "p",
            "mode": "catalog",
            "limit": 2
          },
          "expect": {
            "fired": true,
            "state": "walking",
            "emits": [
              {
                "event": "PROFILE_NEXT",
                "payload": {}
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "with-samply-a-file-run-reads-its-own-binary-instead-of-attaching",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "starting",
          "event": "PROFILE_PID",
          "payload": {
            "pid": 42
          },
          "entity": {
            "id": "p",
            "mode": "file",
            "samply": true,
            "argv": [
              "x.lolo",
              "--samply"
            ]
          },
          "expect": {
            "fired": true,
            "state": "starting",
            "neverEmits": [
              "PROFILE_SAMPLY_START"
            ],
            "effects": [
              {
                "type": "os/current-exe"
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "the-walk-runs-again-as-a-child-samply-records",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "starting",
          "event": "PROFILE_EXE",
          "payload": {
            "path": "/b/orb-dev.bin"
          },
          "entity": {
            "id": "p",
            "mode": "catalog",
            "samply": true,
            "pid": 42,
            "argv": [
              "catalog",
              "--limit",
              "5",
              "--samply"
            ]
          },
          "expect": {
            "fired": true,
            "state": "recording",
            "emits": [
              {
                "event": "PROFILE_SAMPLY_RECORD",
                "payload": {
                  "key": "profile-42",
                  "argv": [
                    "/b/orb-dev.bin",
                    "profile",
                    "catalog",
                    "--limit",
                    "5",
                    "--sampled"
                  ],
                  "rateHz": 100
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "the-childs-report-is-answered-with-its-hot-functions",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "recording",
          "event": "PROFILE_HOT",
          "payload": {
            "key": "profile-42",
            "startTime": 1,
            "samples": 3,
            "cpuUs": 30000,
            "output": "the report\n",
            "functions": [
              {
                "name": "work",
                "lib": "orb-dev.bin",
                "selfSamples": 3,
                "totalSamples": 3,
                "selfCpuUs": 30000,
                "totalCpuUs": 30000
              }
            ]
          },
          "entity": {
            "id": "p",
            "mode": "catalog",
            "samply": true,
            "pid": 42,
            "report": "text"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "exactEmits": [
              {
                "event": "PROFILE_ANSWERED",
                "payload": {
                  "status": 200,
                  "body": "the report\n\nHot functions of the walking process (samply, 3 samples at 100 Hz; self | total samples, self CPU ms)\n  3 | 3 | 30  work  (orb-dev.bin)"
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
