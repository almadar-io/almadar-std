      "steps": [
        {
          "trait": "OrbProfile",
          "from": "browsing",
          "event": "PROFILE_PAGES_LISTED",
          "payload": {
            "result": [
              {
                "behavior": "almadar-std/a",
                "topic": "x",
                "level": "atom",
                "package": "almadar-std"
              },
              {
                "behavior": "almadar-std/b",
                "topic": "x",
                "level": "atom",
                "package": "almadar-std"
              }
            ]
          },
          "entity": {
            "id": "p",
            "mode": "launchpad",
            "baseUrl": "http://127.0.0.1:4790",
            "settleMs": 1500,
            "spa": true
          },
          "expect": {
            "fired": true,
            "entity": {
              "queue": [
                "almadar-std/a",
                "almadar-std/b"
              ],
              "index": 0
            },
            "emits": [
              {
                "event": "PROFILE_PAGE_NAVIGATE",
                "payload": {
                  "key": "warmup",
                  "url": "http://127.0.0.1:4790/"
                }
              }
            ],
            "emitCounts": {
              "PROFILE_PAGE_NEXT": 0
            }
          }
        }
