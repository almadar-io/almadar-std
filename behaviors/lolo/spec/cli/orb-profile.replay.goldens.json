    {
      "id": "with-samply-a-file-run-reads-its-own-binary-instead-of-attaching",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "starting",
          "event": "PROFILE_PID",
          "payload": {
            "pid": 42
          },
          "entity": {
            "id": "p",
            "mode": "file",
            "samply": true,
            "argv": [
              "x.lolo",
              "--samply"
