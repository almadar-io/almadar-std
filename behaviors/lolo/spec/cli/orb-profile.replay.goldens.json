{
  "atom": "cli/atoms/std-orb-profile.lolo",
  "trait": "OrbProfile",
  "defaults": [
    "ProfileWalk",
    "ProfileCost",
    "ProfileSample",
    "ProfileStats",
    "ProfileSamply",
    "ProfileSettle",
    "VerifyMachine",
    "VerifyPlan",
    "MockSeed",
    "MockStream",
    "VerifyJudge",
    "VerifyCreditor",
    "ProfileStatsVersion",
    "ProfileStatsSample",
    "ProfileSamplyRunner"
  ],
  "cases": [
    {
      "id": "catalog-with-a-limit-starts-by-reading-this-processs-id",
      "steps": [
        {
          "trait": "OrbProfile",
          "event": "PROFILE_CALLED",
          "payload": {
            "headers": {},
            "rawBody": "{\"argv\": [\"catalog\", \"--limit\", \"5\"], \"cwd\": \"/w\"}"
          },
          "entity": {
            "id": "p"
          },
          "expect": {
            "fired": true,
            "state": "starting",
            "effects": [
              {
                "type": "let"
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "unreadable-arguments-answer-500",
      "steps": [
        {
          "trait": "OrbProfile",
          "event": "PROFILE_CALLED",
          "payload": {
            "headers": {},
            "rawBody": "not json"
          },
          "entity": {
            "id": "p"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "exactEmits": [
              {
                "event": "PROFILE_ANSWERED",
                "payload": {
                  "status": 500,
                  "body": "profile: the call's arguments could not be read"
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
