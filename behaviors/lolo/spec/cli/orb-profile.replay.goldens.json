                "type": "os/current-exe"
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "the-walk-runs-again-as-a-child-samply-records",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "starting",
          "event": "PROFILE_EXE",
          "payload": {
            "path": "/b/orb-dev.bin"
          },
          "entity": {
            "id": "p",
            "mode": "catalog",
            "samply": true,
            "pid": 42,
            "argv": [
              "catalog",
              "--limit",
              "5",
              "--samply"
            ]
          },
          "expect": {
            "fired": true,
            "state": "recording",
            "emits": [
              {
                "event": "PROFILE_SAMPLY_RECORD",
                "payload": {
                  "key": "profile-42",
                  "argv": [
                    "/b/orb-dev.bin",
                    "profile",
                    "catalog",
                    "--limit",
                    "5",
                    "--sampled"
                  ],
                  "rateHz": 100
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "the-childs-report-is-answered-with-its-hot-functions",
      "steps": [
        {
          "trait": "OrbProfile",
          "from": "recording",
          "event": "PROFILE_HOT",
          "payload": {
            "key": "profile-42",
            "startTime": 1,
            "samples": 3,
            "cpuUs": 30000,
            "output": "the report\n",
            "functions": [
              {
                "name": "work",
                "lib": "orb-dev.bin",
                "selfSamples": 3,
                "totalSamples": 3,
                "selfCpuUs": 30000,
                "totalCpuUs": 30000
              }
            ]
          },
          "entity": {
            "id": "p",
            "mode": "catalog",
            "samply": true,
            "pid": 42,
            "report": "text"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "exactEmits": [
              {
                "event": "PROFILE_ANSWERED",
                "payload": {
                  "status": 200,
                  "body": "the report\n\nHot functions of the walking process (samply, 3 samples at 100 Hz; self | total samples, self CPU ms)\n  3 | 3 | 30  work  (orb-dev.bin)"
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
