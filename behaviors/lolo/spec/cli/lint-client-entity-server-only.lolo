app lint-client-entity-server-only-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint client-entity-server-only <file>`; see the atom."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintClientEntityServerOnlySpec {
  expects trait OrbLintClientEntityServerOnly {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintClientEntityServerOnlyCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintClientEntityServerOnly, OrbLintClientEntityServerOnlyCli
}
