app lint-nav-target-spec [
  version: "1.0.0",
  description: "Design contract for `orb lint nav-target <file>`, a final-only rule. It lowers the file with program/read and reports ORB_NAV_TARGET_UNDECLARED for every navigation target a trait or the app states as a literal path (or a str/concat of literals and `@config.<name>` bindings that fold through the trait, orbital and app config defaults) that matches no declared page route: a navigate effect target, an href or navigatesTo in a config default or a render-ui payload (a navItems entry among them), and a `uses lazy` page's links. External URLs, bindings, other computed paths, the signIn route and /login are never reported. It answers the whole-program scope only, under the final rule nav-target-final (status 500, exit 1). Clean answers `lint nav-target: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital LintNavTargetSpec {
  expects trait OrbLintNavTarget {
    state ready
    emits {
      LINT_FOUND { rule : string!  findings : [OrbFinding]! }
    }
  }
  expects trait OrbLintNavTargetCli {
    state ready
    emits {
      LINT_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbLintNavTarget, OrbLintNavTargetCli
}
