{
 "atom": "cli/atoms/std-orb-lint-egress-scheme-unused.lolo",
 "trait": "OrbLintEgressSchemeUnused",
 "note": "An app egress entry whose scheme (redis, rediss, postgres, postgresql) nothing uses since the TCP protocol-target grants were retired. Controls: http and https origins, a host that merely contains the word redis, no egress, an empty egress.",
 "cases": [
  {
   "id": "redis-with-a-port-names-the-net-grant",
   "steps": [
    {
     "trait": "OrbLintEgressSchemeUnused",
     "from": "ready",
     "event": "LINT_INPUT",
     "payload": {
      "file": "a.lolo",
      "raw": "",
      "latin": true,
      "program": {
       "egress": [
        "redis://cache.internal:6379"
       ]
      },
      "scope": ""
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintEgressSchemeUnused",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "egress-scheme-unused",
         "findings": [
          {
           "code": "ORB_OS_EGRESS_SCHEME_UNUSED",
           "path": "egress[0]",
           "message": "egress entry 'redis://cache.internal:6379' has a scheme that nothing uses: it grants nothing since the TCP protocol-target grants were retired",
           "suggestion": "Remove the entry and declare the socket as a net grant: net: { \"cache.internal:6379\": [tcp] }",
           "severity": "error"
          }
         ],
         "scope": ""
        }
       }
      ]
     }
    }
   ]
  },
