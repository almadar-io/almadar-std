     "event": "LINT_PROGRAM_READ",
     "payload": {
      "result": {
       "locales": [
        "en",
        "ar",
        "sl"
       ],
       "orbitals": [
        {
         "entity": {
          "name": "Invoice",
          "local": true,
          "instances": [
           {
            "id": "A"
           }
          ],
          "localeInstances": {
           "ar": [
            {
             "id": "A"
            }
           ],
           "sl": [
            {
             "id": "A"
            }
           ]
          }
         }
        }
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintEntityLocaleInstances",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "entity-locale-instances",
         "findings": []
        }
       }
      ]
     }
    }
   ]
