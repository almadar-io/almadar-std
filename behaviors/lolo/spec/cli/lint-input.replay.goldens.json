{
  "atom": "cli/atoms/std-orb-lint-input.lolo",
  "trait": "OrbLintInput",
  "note": "The input reads, scans the language packs and lowers once per lint run; every rule trait and the umbrella receive the result as LINT_INPUT. The language-decision cases moved here from lint-page-path.",
