    {
      "id": "lolo-arabic-first-token-is-not-english",
      "entity": {
        "raw": "تطبيق x [\n]\n",
        "packs": [
          {
            "name": "@almadar/lolo-ar",
            "text": "{\"meta\": {\"code\": \"ar\"}, \"keywords\": {\"app\": \"تطبيق\", \"uses\": \"يستخدم\", \"expects\": \"يتوقع\", \"type\": \"نوع\", \"theme\": \"مظهر\", \"orbital\": \"مدار\"}, \"orb\": {\"orbitals\": \"مدارات\"}}"
          },
          {
            "name": "@almadar/lolo-sl",
            "text": "{\"meta\": {\"code\": \"sl\"}, \"keywords\": {\"app\": \"aplikacija\", \"uses\": \"uporablja\", \"expects\": \"pricakuje\", \"type\": \"tip\", \"theme\": \"tema\", \"orbital\": \"orbitala\"}, \"orb\": {\"orbitals\": \"orbitale\"}}"
          }
        ],
        "file": "a.lolo"
      },
      "steps": [
        {
          "trait": "OrbLintInput",
          "from": "reading",
          "event": "LANGUAGE_PACKS_DONE_HEARD",
          "payload": {
            "problem": ""
          },
          "expect": {
            "emits": [
              {
                "event": "LINT_LANGUAGE",
                "payload": {
                  "latin": false
                }
              }
            ]
          }
        }
      ]
    },
