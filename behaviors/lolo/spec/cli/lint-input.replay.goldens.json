{
  "atom": "cli/atoms/std-orb-lint-input.lolo",
  "trait": "OrbLintInput",
  "note": "The input reads, scans the language packs and lowers once per lint run; every rule trait and the umbrella receive the result as LINT_INPUT. The language-decision cases moved here from lint-page-path.",
  "cases": [
    {
      "id": "lolo-arabic-first-token-is-not-english",
      "entity": {
        "raw": "تطبيق x [\n]\n",
        "packs": [
          {
            "name": "@almadar/lolo-ar",
            "text": "{\"meta\": {\"code\": \"ar\"}, \"keywords\": {\"app\": \"تطبيق\", \"uses\": \"يستخدم\", \"expects\": \"يتوقع\", \"type\": \"نوع\", \"theme\": \"مظهر\", \"orbital\": \"مدار\"}, \"orb\": {\"orbitals\": \"مدارات\"}}"
          },
          {
            "name": "@almadar/lolo-sl",
            "text": "{\"meta\": {\"code\": \"sl\"}, \"keywords\": {\"app\": \"aplikacija\", \"uses\": \"uporablja\", \"expects\": \"pricakuje\", \"type\": \"tip\", \"theme\": \"tema\", \"orbital\": \"orbitala\"}, \"orb\": {\"orbitals\": \"orbitale\"}}"
          }
        ],
        "file": "a.lolo"
      },
      "steps": [
        {
          "trait": "OrbLintInput",
          "from": "reading",
          "event": "LANGUAGE_PACKS_DONE_HEARD",
          "payload": {
            "problem": "",
            "coreRoot": "/core",
            "stdRoot": "/std"
          },
          "expect": {
            "emits": [
              {
                "event": "LINT_LANGUAGE",
                "payload": {
                  "latin": false
                }
              }
            ]
          }
        }
      ]
    },
