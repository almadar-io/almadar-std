            "text": "{\"meta\": {\"code\": \"ar\"}, \"keywords\": {\"app\": \"تطبيق\", \"uses\": \"يستخدم\", \"expects\": \"يتوقع\", \"type\": \"نوع\", \"theme\": \"مظهر\", \"orbital\": \"مدار\"}, \"orb\": {\"orbitals\": \"مدارات\"}}"
          },
          "expect": {
            "fired": true,
            "state": "reading"
          }
        }
      ]
    },
    {
      "id": "a-failed-language-scan-leaves-the-file-unread",
      "entity": {
        "file": "a.lolo"
      },
      "steps": [
        {
          "trait": "OrbLintInput",
          "from": "reading",
          "event": "LANG_SCAN_ANSWERED",
          "payload": {
            "status": 500,
            "body": "",
            "stderr": "x"
          },
          "expect": {
            "emits": [
              {
                "event": "LINT_INPUT_UNREAD",
                "payload": {
                  "file": "a.lolo"
                }
