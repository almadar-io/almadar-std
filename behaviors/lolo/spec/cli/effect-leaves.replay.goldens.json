{
  "atom": "cli/atoms/std-orb-effect-leaves.lolo",
  "trait": "OrbEffectLeaves",
  "note": "Cases for the shared effect-leaf expansion: plain effects and ticks, the paths of the do, if, when and let forms, a branch written as a list of effects, nesting, an effect in a value position, and the branches that are null or not effects, which are no leaf and leave the later indexes where they were.",
  "cases": [
    {
      "id": "a-plain-effect-is-its-own-leaf",
      "steps": [
        {
          "trait": "OrbEffectLeaves",
          "from": "ready",
          "event": "EFFECT_LEAVES_EXPAND",
          "payload": {
            "requestId": "r1",
            "orbitals": [
              {
                "name": "A",
                "traits": [
                  {
                    "name": "T",
                    "stateMachine": {
                      "transitions": [
                        {
                          "effects": [
                            [
                              "emit",
                              "X"
                            ],
                            [
                              "set",
                              "@entity.n",
                              1
                            ]
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "EFFECT_LEAVES_EXPANDED",
                "payload": {
                  "requestId": "r1",
                  "leaves": [
                    {
                      "p": "orbitals[0 (A)].traits[0 (T)].stateMachine.transitions[0].effects[0]",
                      "e": [
                        "emit",
                        "X"
                      ],
                      "oi": 0,
                      "ti": 0
                    },
                    {
                      "p": "orbitals[0 (A)].traits[0 (T)].stateMachine.transitions[0].effects[1]",
                      "e": [
                        "set",
                        "@entity.n",
                        1
                      ],
                      "oi": 0,
                      "ti": 0
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
