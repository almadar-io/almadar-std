{
 "atom": "cli/atoms/std-orb-lint-page-modifiers.lolo",
 "trait": "OrbLintPageModifiers",
 "note": "Expected findings are the code, path, message and suggestion `orb validate` (the Rust validator) reports for the same program. Added cases follow validate_page_modifiers (page.rs; it has no Rust test of its own): the missing parts are listed access, title, description; the parameter-route error is independent of the missing-parts error.",
 "cases": [
  {
   "id": "indexed-page-that-is-not-public-titled-or-described",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ],
           "indexing": "index"
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintPageModifiers"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "page-modifiers",
         "findings": [
          {
           "code": "ORB_P_INDEX_REQUIRES_PUBLIC",
           "path": "orbitals[0].pages[0]",
           "message": "page 'P' (/a) declares `indexing: index` but lacks `access: public`, `title:`, `description:`",
           "suggestion": "an indexed page is public, titled and described; otherwise declare `indexing: noindex`",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintPageModifiers"
    }
   ]
  },
