{
  "atom": "cli/atoms/std-orb-lint-item-action-event.lolo",
  "trait": "OrbLintItemActionEvent",
  "note": "The Rust validate_item_actions has no unit test of its own; these cases pin the behavior read from item_actions.rs and the pattern.rs walk (pattern with a string type, then children as an object, a list, a mapped-children array/map-with-lambda tuple or a conditional node). Not ported: ORB_RUI_UNKNOWN_ITEM_ACTION_PROP (needs the registry-wide itemActions property set) and the expansion of operator-call children (array/concat ...), which need data no lint input carries. A trait-value embed (skipped by the Rust walk) is not recognized; resolved programs inline embeds.",
  "cases": [
    {
      "id": "an-item-action-without-event-or-navigatesTo-fires",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "app",
              "orbitals": [
                {
                  "name": "Home",
                  "traits": [
                    {
                      "name": "Tour",
                      "stateMachine": {
                        "transitions": [
                          {
                            "from": "idle",
                            "to": "idle",
                            "event": "INIT",
                            "effects": [
                              [
                                "render-ui",
                                "main",
                                {
                                  "type": "data-list",
                                  "itemActions": [
                                    {
                                      "label": "Open"
                                    }
                                  ]
                                }
                              ]
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          }
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "item-action-event",
                  "findings": [
                    {
                      "code": "ORB_RUI_INVALID_ITEM_ACTION",
                      "path": "orbitals[0 (Home)].traits[0 (Tour)].stateMachine.transitions[0].effects[0][2].itemActions[0]",
                      "message": "itemAction must have 'event' or 'navigatesTo' property",
                      "suggestion": "Add event: 'EVENT_NAME' to emit an event, or navigatesTo: '/route/{{row.id}}' to navigate",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintItemActionEvent"
        }
      ]
    },
