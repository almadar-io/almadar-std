{
 "atom": "cli/atoms/std-orb-lint-transition-refs.lolo",
 "trait": "OrbLintTransitionRefs",
 "cases": [
  {
   "id": "nonexistent-target",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "traits": [
          {
           "name": "T",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             },
             {
              "name": "active"
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "nonexistent",
              "event": "GO"
             }
            ]
           }
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "transition-refs",
         "findings": [
          {
           "code": "ORB_T_INVALID_TRANSITION",
           "path": "orbitals[0].traits[0].stateMachine.transitions[0].to",
           "message": "Target state 'nonexistent' does not exist",
           "suggestion": "",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
