{
 "atom": "cli/atoms/std-orb-lint-state-unreachable.lolo",
 "trait": "OrbLintStateUnreachable",
 "cases": [
  {
   "id": "orphan-state",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "traits": [
          {
           "name": "T",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             },
             {
              "name": "active"
             },
             {
              "name": "orphan"
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "active",
              "event": "START"
             }
            ]
           }
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     }
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "state-unreachable",
         "findings": [
          {
           "code": "ORB_T_STATE_UNREACHABLE",
           "path": "orbitals[0].traits[0].stateMachine.states",
           "message": "State 'orphan' is unreachable from the initial state 'idle' via any transition path",
           "suggestion": "Add a transition that reaches this state, or remove the dead state",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
