app orb-eval-spec [
  version: "1.0.0",
  description: "Design contract for the answer std-orb-eval gives: the value of one evaluated expression, null included, or the reason it could not be evaluated."
]

orbital OrbEvalSpec {
  expects trait ExprEvaluator {
    state idle
    state evaluating
    emits {
      EXPR_EVAL_DONE { value : string }
      EXPR_EVAL_FAILED { error : string }
    }
  }
  expects page boot -> ExprEvaluator
}
