{
  "atom": "cli/atoms/std-orb-lint-entity-name-shadows-trait-union.lolo",
  "trait": "OrbLintEntityNameShadowsTraitUnion",
  "note": "Expected findings are the code, path, message and suggestion validate_all_entities (entities/entity.rs) reports. The Rust file carries no unit tests of its own; each case pins a branch of the function: the state shadow, the event shadow, the pairing control, an auxiliary entity at its own index, two orbitals, a reference trait named by its ref, and a spec orbital skipped. The message's closing example names the TRAIT (`<Trait>Data`), as the Rust format arguments do.",
  "cases": [
    {
      "id": "entity-named-trait-state",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "app",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "PlayState",
                    "persistence": "runtime"
                  },
                  "traits": [
                    {
                      "name": "Play",
                      "linkedEntity": "X",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "idle",
                            "isInitial": true
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          },
          "trait": "OrbLintEntityNameShadowsTraitUnion"
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "entity-name-shadows-trait-union",
                  "findings": [
                    {
                      "code": "ORB_T_ENTITY_NAME_SHADOWS_TRAIT_UNION",
                      "path": "orbitals[0].entity",
                      "message": "Entity 'PlayState' name collides with trait 'Play's generated state union — TS codegen would emit both `import type { PlayState }` and `type PlayState = '...'` in every handler/hook/view file (TS2440). Rename the entity (e.g. 'PlayData').",
                      "suggestion": "Rename entity 'PlayState' to 'PlayData' (or any name that doesn't match a trait's <Name>State / <Name>Event union)",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintEntityNameShadowsTraitUnion"
        }
      ]
    },
