{
  "atom": "cli/atoms/std-orb-lint-theme-ref.lolo",
  "trait": "OrbLintThemeRef",
  "note": "Cases mirror theme.rs validate_theme_ref: an app, orbital or themes-list reference is valid when it is an Alias.theme, an inline orbital theme name or a built-in key. Expected findings equal `orb validate --json` on the fixtures in the batch scratch dir (th-*.lolo, th-*.orb). The vocabulary step feeds a six-key subset.",
  "cases": [
    {
      "id": "an-unknown-app-theme-is-reported",
      "steps": [
        {
          "event": "UI_VOCAB_HEARD",
          "from": "ready",
          "payload": {
            "slots": [],
            "itemActionBaseProps": [],
            "lucideIcons": [],
            "themeKeys": [
              "almadar-dark",
              "almadar-light",
              "clay-dark",
              "clay-light",
              "terminal-dark",
              "game-adventure-dark"
            ],
            "deliveryRoots": [],
            "eventSourceKeys": []
          },
          "expect": {
            "fired": true,
            "state": "ready"
          }
        },
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.lolo",
            "raw": "",
            "latin": true,
            "program": {
              "name": "ThemeRefFx",
              "orbitals": [
                {
                  "name": "FooOrbital"
                }
              ],
              "theme": "nonexistent-dark"
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          }
        },
        {
          "trait": "OrbLintThemeRef",
          "event": "LINT_FINISH",
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "theme-ref",
                  "findings": [
                    {
                      "code": "ORB_X_UNKNOWN_THEME",
                      "path": "theme",
                      "message": "Unknown theme 'nonexistent-dark'. Must be a built-in theme key (the full data-theme value, e.g. linear-clean-light, terminal-dark, game-adventure-dark) or an orbital-declared inline theme.",
                      "suggestion": "",
                      "severity": "error"
                    }
                  ],
                  "scope": ""
                }
              }
            ]
          }
        }
      ]
    },
