{
  "atom": "cli/atoms/std-orb-lint-service-def.lolo",
  "trait": "OrbLintServiceDef",
  "note": "Cases mirror service.rs (test_valid_service_reference, test_valid_url, test_valid_env_var_name, test_validate_rest_service*) plus the edge values checked against `orb validate --json` on thm-svc-ok, thm-svc-bad and thm-svc-edge. A .lolo program never carries services, so every case is an .orb document. ORB_GEN_DUPLICATE follows the intent of service.rs (a name already declared by an EARLIER inline service); the installed Rust reports every inline service as a duplicate because validation/mod.rs pre-registers all inline service names before validate_all_services runs.",
  "cases": [
    {
      "id": "control a valid rest service is clean",
      "steps": [
        {
          "event": "LINT_INPUT",
          "from": "ready",
          "payload": {
            "file": "a.orb",
            "raw": "",
            "latin": true,
            "program": {
              "name": "site",
              "orbitals": [
                {
                  "name": "O",
                  "services": [
                    {
                      "type": "rest",
                      "name": "w",
                      "baseUrl": "https://api.x.com",
                      "auth": {
                        "type": "api-key",
                        "keyName": "appid",
                        "secretEnv": "API_KEY"
                      },
                      "timeout": 30
                    }
                  ]
                }
              ]
            },
            "scope": ""
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "LINT_FINISH",
                "payload": {}
              }
            ]
          }
        },
        {
          "event": "LINT_FINISH",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "LINT_FOUND",
                "payload": {
                  "rule": "service-def",
                  "findings": [],
                  "scope": ""
                }
              }
            ]
          },
          "trait": "OrbLintServiceDef"
        }
      ]
    },
