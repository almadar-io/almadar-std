       }
      ],
      "cursor": 0,
      "digest": "",
      "tarballSize": 0
     },
     "expect": {
      "emits": [
       {
        "event": "PKG_HASH",
        "payload": {
         "requestId": "tarball",
         "data": "YWJj",
         "encoding": "hex"
        }
       },
       {
        "event": "SHA256_DIGESTED",
        "payload": {
         "digest": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
        }
       },
       {
        "event": "PKG_VERIFY",
        "payload": {}
       },
       {
        "event": "PKG_INSTALL",
        "payload": {}
       },
       {
        "event": "PACKAGE_REFUSED",
        "payload": {
