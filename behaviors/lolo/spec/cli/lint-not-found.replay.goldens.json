       "version": "1.0.0",
       "orbitals": [
        {
         "name": "O",
         "entity": {
          "name": "T",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string",
            "required": true
           }
          ]
         },
         "traits": [],
         "pages": [
          {
           "name": "Home",
           "path": "/"
          },
          {
           "name": "A",
           "path": "/a",
           "isNotFound": true
          },
          {
           "name": "B",
           "path": "/b",
           "isNotFound": true
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "not-found",
         "scope": "",
         "findings": [
          {
           "code": "ORB_PAGE_NOT_FOUND_DUPLICATE",
           "path": "orbitals",
           "message": "The program declares 2 `[notFound]` pages; a path no page matches can show only one",
           "suggestion": "Keep one page with the `[notFound]` modifier",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
