app orb-firestore-indexes-spec [
  version: "1.0.0",
  description: "Design contract for `orb firestore-indexes <file> [--scope collection|collection-group] [--out <path>]`: render the composite indexes the program's persistent entities declare with `@index` as the text of a Firebase firestore.indexes.json, printed, or written to --out. A bad word count, an unknown flag or an unknown scope is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500 (exit 1)."
]

orbital OrbFirestoreIndexesSpec {
  expects trait OrbFirestoreIndexes {
    state ready
    emits {
      FIRESTORE_INDEXES_ANSWERED { status : number!  body : string! }
    }
  }
  expects page boot -> OrbFirestoreIndexes
}
