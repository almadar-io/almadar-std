{
 "atom": "cli/atoms/std-orb-lint-entity-seed-source.lolo",
 "trait": "OrbLintEntitySeedSource",
 "cases": [
  {
   "id": "mock-with-instances",
   "steps": [
    {
     "trait": "OrbLintEntitySeedSource",
     "from": "reading",
     "event": "LINT_PROGRAM_READ",
     "payload": {
      "result": {
       "orbitals": [
        {
         "entity": {
          "name": "Inv",
          "seedMock": true,
          "instances": [
           {
            "id": "a"
           }
          ]
         }
        }
       ]
      }
     },
     "expect": {
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintEntitySeedSource",
     "from": "ready",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "entity-seed-source",
         "findings": [
          {
           "code": "ORB_E_SEED_SOURCE_CONFLICT",
           "path": "orbitals[0].entity.instances",
           "message": "Entity 'Inv' declares both `mock` seeding and written-out `instances` — exactly one seed source",
           "suggestion": "Keep the written-out rows, or drop them and keep `mock`.",
           "severity": "error"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
