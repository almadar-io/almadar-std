             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           }
          }
         ],
         "pages": [
          {
           "name": "P2",
           "path": "/b",
           "traits": [
            {
             "ref": "T2"
