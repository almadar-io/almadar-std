     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintIdentityUnique"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "identity-unique",
         "findings": [
          {
           "code": "ORB_S_IDENTITY_NOT_UNIQUE",
           "path": "orbitals",
           "message": "2 entities are tagged [identity]: U1, U2. `@user` resolves to a single viewer, so more than one declaration makes every `@user.x` ambiguous.",
           "suggestion": "Keep exactly one [identity] entity and reference it from the other orbitals (`ownerId : <IdentityEntity>`).",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintIdentityUnique"
    }
   ]
