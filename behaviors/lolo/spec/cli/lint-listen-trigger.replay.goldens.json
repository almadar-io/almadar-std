 "cases": [
  {
   "id": "listen-trigger-matches-no-transition",
   "steps": [
    {
     "event": "LINT_PROGRAM_READ",
     "from": "reading",
     "payload": {
      "result": {
       "name": "app",
       "orbitals": [
        {
         "name": "A",
         "entity": {
          "name": "E",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "T",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [
             {
              "from": "idle",
              "to": "idle",
              "event": "INIT",
              "effects": [
               [
                "render-ui",
                "main",
                {
                 "type": "stack",
                 "children": []
                }
               ]
              ]
             }
            ]
           },
           "listens": [
            {
             "event": "PING",
             "triggers": "NOPE"
            }
           ]
          }
         ],
         "pages": [
          {
           "name": "P",
           "path": "/a",
           "traits": [
            {
             "ref": "T"
            }
           ]
          }
         ]
        }
       ]
      }
     },
     "expect": {
      "fired": true,
      "state": "ready"
     },
     "trait": "OrbLintListenTrigger"
    },
    {
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "listen-trigger",
         "findings": [
          {
           "code": "ORB_X_LISTEN_TRIGGER_UNMATCHED",
           "path": "orbitals.A.traits.T.listens",
           "message": "Listen entry in 'A.T' triggers 'NOPE' but no transition in the same trait reacts to it.",
           "suggestion": "Add a transition whose event matches the listen trigger, or fix the `-> TRIGGER` to name an event the trait's state machine handles.",
           "severity": "error"
          }
         ]
        }
       }
      ]
     },
     "trait": "OrbLintListenTrigger"
    }
   ]
  },
