app orb-serve-spec [
  version: "1.0.0",
  inbound: ["cli-serve"],
  description: "Design contract for `orb serve <file> [--port N] [--host H] [--no-mock] [--client-dir DIR] [--open] [--no-emulators]` (port of orbital-cli program_command.rs serve_program / server_overrides). SERVE_START { cwd, path, portText, portOk, host, hasClient, clientDir, clientGiven, clientInside, mock, open, noEmulators } reads HOME, then resolves the app into ~/.almadar/serve (program/read resolve with output; orb-app names that file), resolves std/behaviors/std-http-server (behavior/resolve) and composes them (program/compose { appName, overrides }) with Http1.host, Http1.port, Http1.portFromEnv false, the host:port listen grant and, with a client dir under the working directory, ServerStatic.clientDir (relative) with its anchored cwd read grant. It never runs the program: SERVE_ANSWERED { status: 200, headers: { orb-run: server, orb-mock: on|off, orb-app: <absolute app path> }, body: the composed program's JSON } is the hand-off the bootloader boots (catalogs from the app's locales, mock per orb-mock, INIT mounted on the server side, held until a signal). --open and --no-emulators answer 500 on stderr with the Rust bail texts; a bad port 400; a client dir outside the working directory, an app naming no app, or a refused read, resolve or compose 500 with `Error: <reason>`; a missing or second file or an unknown flag answers the usage (400, exit 2). Replay goldens: orb-serve.replay.goldens.json."
]

orbital OrbServeSpec {
  expects trait OrbServe {
    state ready
    state parsing
    state working
    state composing
    emits {
      SERVE_ANSWERED { status : number!  body : string!  stderr : string  headers : Map string string }
    }
  }
  expects trait ServeEngine {
    state idle
    state homing
    state reading
    state resolving
    emits {
      SERVE_ANSWERED { status : number!  body : string!  stderr : string  headers : Map string string }
    }
  }
  expects page "/orb-serve" -> OrbServe
}
