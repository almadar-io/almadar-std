{
 "atom": "cli/atoms/std-orb-lint-external-emit-payload.lolo",
 "trait": "OrbLintExternalEmitPayload",
 "note": "Cases copy the eight payload.rs unit tests (test_external_emit_missing_payload_with_consumer_warns, payload_free_intent_event_with_an_expectationless_consumer_is_silent, test_external_emit_missing_payload_no_consumer_silent, test_external_emit_self_listen_silent, test_external_emit_with_payload_passes, test_internal_emit_no_payload_ok, test_targeted_listener_on_another_emitter_is_not_a_consumer, test_targeted_listener_on_this_emitter_still_warns) plus an orbital-kind source, an optional-field consumer and the triggers-event cases. Findings are the code, path, message and suggestion the Rust validator reports; the Rust expected-shape JSON is not carried by a finding.",
 "cases": [
  {
   "id": "test-external-emit-missing-payload-with-consumer-warns",
   "steps": [
    {
     "trait": "OrbLintExternalEmitPayload",
     "event": "LINT_INPUT",
     "from": "ready",
     "payload": {
      "file": "a.lolo",
      "raw": "",
      "latin": true,
      "program": {
       "name": "p",
       "orbitals": [
        {
         "name": "OrderOrbital",
         "entity": {
          "name": "OrderOrbitalE",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "OrderTrait",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": []
           },
           "emits": [
            {
             "event": "ORDER_PAID",
             "scope": "external"
            }
           ]
          }
         ]
        },
        {
         "name": "LedgerOrbital",
         "entity": {
          "name": "LedgerOrbitalE",
          "persistence": "runtime",
          "fields": [
           {
            "name": "id",
            "type": "string"
           }
          ]
         },
         "traits": [
          {
           "name": "LedgerTrait",
           "linkedEntity": "E",
           "stateMachine": {
            "states": [
             {
              "name": "idle",
              "isInitial": true
             }
            ],
            "transitions": [],
            "events": [
             {
              "key": "ORDER_PAID",
              "payloadSchema": [
               {
                "name": "orderId",
                "type": "string",
                "required": true
               }
              ]
             }
            ]
           },
           "listens": [
            {
             "event": "ORDER_PAID",
             "source": {
              "kind": "any"
             }
            }
           ]
          }
         ]
        }
       ]
      },
      "scope": ""
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "LINT_FINISH",
        "payload": {}
       }
      ]
     }
    },
    {
     "trait": "OrbLintExternalEmitPayload",
     "event": "LINT_FINISH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "LINT_FOUND",
        "payload": {
         "rule": "external-emit-payload",
         "findings": [
          {
           "code": "ORB_T_EVT_EXTERNAL_MISSING_PAYLOAD",
           "path": "traits.OrderTrait.emits.ORDER_PAID",
           "message": "External event 'ORDER_PAID' in trait 'OrderTrait' should have a payload definition with typed fields",
           "suggestion": "Add a payload array with fields: { \"name\": \"fieldName\", \"type\": \"string\", \"required\": true, \"description\": \"...\" }",
           "severity": "error"
          }
         ],
         "scope": ""
        }
       }
      ]
     }
    }
   ]
  },
