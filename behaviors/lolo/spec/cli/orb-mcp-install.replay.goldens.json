{
 "atom": "cli/atoms/std-orb-mcp-install.lolo",
 "trait": "OrbMcpInstall",
 "note": "Host operators (os/exists, os/read-file, os/mkdir, os/write-file) are fed as their success and failure events; a step reports effects unevaluated, so the merged config's content is pinned by the live run, not here.",
 "cases": [
  {
   "id": "usage: no --client",
   "steps": [
    {
     "trait": "OrbMcpInstall",
     "from": "ready",
     "event": "MCP_CALLED",
     "payload": {
      "rawBody": "{\"argv\":[],\"cwd\":\"/work\"}"
     },
     "expect": {
      "state": "parsing",
      "emits": [
       {
        "event": "MCP_ARGS_PARSE",
        "payload": {
         "stage": "mcp",
         "argv": [],
         "flags": [
          {
           "name": "client",
           "aliases": [],
           "takesValue": true,
           "repeatable": false
          }
         ]
        }
       }
      ],
      "fired": true
     }
    },
    {
     "trait": "OrbMcpInstall",
     "from": "parsing",
     "event": "MCP_ARGS_DONE",
     "payload": {
      "stage": "mcp",
      "flags": {},
      "positionals": [],
      "errors": [],
      "words": []
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "MCP_INSTALL_ANSWERED",
        "payload": {
         "status": 400,
         "body": "usage: orb mcp install --client <claude|cursor|vscode>"
        }
       }
      ],
      "fired": true
     }
    }
   ]
  },
