{
 "atom": "store/atoms/std-store-selection.lolo",
 "trait": "StoreSelection",
 "source": "parity/retirement/gap-disposition-2026-10-22.json (wave-1 triage, lane F3)",
 "note": "Native parity proof for the mock/seed isolation class of the retired runtime ledger (G-RUNTIME-013 hosted mock-seed defects, G-RUNTIME-090 mock store seed): a production environment never selects the mock store, and a bad selection never selects a store. Cases drive the reading-state arms directly (entity carries the already-read NODE_ENV/USE_MOCK_DATA/backend).",
 "cases": [
  {
   "id": "bad-production-with-mock-flag-never-selects-a-store",
   "steps": [
    {
     "trait": "StoreSelection",
     "from": "reading",
     "entity": {
      "nodeEnv": "production",
      "useMock": true,
      "backend": "firebase",
      "url": ""
     },
     "event": "STORE_BACKEND",
     "payload": {
      "value": null
     },
     "expect": {
      "state": "idle",
      "exactEmits": [
       {
        "event": "STORE_SELECTION_FAILED",
        "payload": {
         "code": "store_mock_forbidden",
         "message": "USE_MOCK_DATA=true is not permitted when NODE_ENV=production"
        }
       }
      ],
      "neverEmits": [
       "STORE_SELECTED"
      ]
     }
    }
   ],
   "note": "Legacy G-RUNTIME-013/090 class (mock rows reaching a hosted store): production refuses USE_MOCK_DATA=true."
  },
  {
