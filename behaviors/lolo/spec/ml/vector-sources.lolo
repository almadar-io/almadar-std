app ml-vector-sources-spec [
  version: "1.0.0",
  description: "Design contract for reading the places orb's embedding vectors live. SOURCES { paths } reads the environment the Rust embedder reads (ALMADAR_VECTORS_DIR, HOME, EMBEDDING_PROVIDER, EMBEDDING_API_KEY, OPENAI_API_KEY, OPEN_ROUTER_API_KEY, EMBEDDING_MODEL, LMSTUDIO_EMBEDDING_MODEL) and each package snapshot path in order (a file that does not exist is an empty bytes value, any other read failure is a refusal), then answers SOURCES_READY { snapshots, snapshotPaths, userDir, userAnchor, providerModel, providerKind, embedModel }: userDir is ALMADAR_VECTORS_DIR, else HOME/.almadar/vectors, and userAnchor is env or home accordingly; providerKind is the embedding instance the configuration selects (openrouter-shared, openrouter-own, openai-shared, openai-own, lmstudio, empty when no provider is configured, openai and openrouter needing a key); providerModel is the model that provider produces (empty without one) and embedModel the name it is asked for. USER_STORE_NEEDED { model, path } answers USER_STORE_READ { data } with the user store file (empty bytes when it does not exist), read under ALMADAR_VECTORS_DIR when set, else under ~/.almadar/vectors. SOURCES_REFUSED { code, detail } carries a failed read."
]

orbital MlVectorSourcesSpec {
  expects entity SourcesRun [runtime] {
    id : string
    userDir : string
    userAnchor : string
  }
  expects trait VectorSources {
    state idle {
      SOURCES -> envs
    }
    state envs {
      SRC_ENV -> envs
    }
    state snapshots {
      SRC_SNAPSHOT_READ -> snapshots
    }
    emits {
      SOURCES_READY { snapshots : [bytes]!  snapshotPaths : [string]!  userDir : string!  userAnchor : string!  providerModel : string!  providerKind : string!  embedModel : string! }
      USER_STORE_READ { data : bytes! }
      SOURCES_REFUSED { code : string!  detail : string! }
    }
  }
  expects page boot -> VectorSources
}
