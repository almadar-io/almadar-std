{
 "source": "Expected rows come from the documented Rust quantize/round_sig6/f32 semantics reimplemented in a scratch python script: components cast to float32, scale = max abs (1 when zero), bytes floor((v/scale)*127+0.5) clamped, scale rounded to 6 significant digits with the decimal module (exact, ties to even, what format {:.5e} does for exact ties), then float32; key sha256(model NUL text). The Rust goldens quantize_matches_ts_math and the 0.123457f32 case are included. The F32 stage is stubbed by feeding F32_ENCODED with the binary32 values the std-f32 goldens pin.",
 "atom": "ml/atoms/std-vector-quantize.lolo",
 "trait": "VectorQuantize",
 "cases": [
  {
   "id": "rust quantize_matches_ts_math: scale 0.5 bytes 127 -63 25 0",
   "steps": [
    {
     "event": "QUANTIZE",
     "payload": {
      "model": "baai/bge-base-en-v1.5",
      "records": [
       {
        "text": "a",
        "vector": [
         0.5,
         -0.25,
         0.1,
         0.0
        ]
       }
      ]
     },
     "expect": {
      "emits": [
