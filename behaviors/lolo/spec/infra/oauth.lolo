app oauth-spec [
  version: "1.0.0",
  description: "Design contract for the OAuth 2 / OIDC authorization-code flow with PKCE (google, github, auth0). The orbital serves one provider, the provider config knob (google, github or auth0); every action runs as that provider's client and no action payload carries a provider. OAUTH_AUTHORIZE { scopes, redirectUri, subject? } answers OAUTH_AUTHORIZED { authUrl, state, code } or OAUTH_AUTHORIZE_ERROR. Real mode builds the authorization endpoint URL from the issuer's discovery document (GET <issuer>/.well-known/openid-configuration, https only, the advertised issuer equal to the expected one) or, for github without an issuerUrl, the static github.com endpoints; the query carries the extra params first (google adds access_type offline, prompt consent), then redirect_uri, scope joined by one space, state, code_challenge = base64url(SHA-256(verifier)), code_challenge_method S256, client_id and response_type code. State and verifier are 32 random bytes each, base64url without padding; the pending grant (provider, redirectUri, verifier, subject, scopes) stays with the host under state and the verifier is never emitted. Mock mode (or no client credentials) answers a provider URL with state as hex and client_id mock-client-id, no PKCE. OAUTH_TOKEN { code, state, subject? } and OAUTH_CONNECT { code, state } take the pending grant once: unknown state, expired state, a subject different from the grant's, and a provider different from the grant's each fail; the exchange POSTs grant_type authorization_code, the code, code_verifier and the grant's redirect_uri (query and fragment dropped) as application/x-www-form-urlencoded, client credentials in the form (post), as a Basic header, or client_id only (none). A token response needs a non-empty access_token and token_type bearer or dpop, a finite non-negative expires_in (default 3600), refresh_token and scope when present, scope split on whitespace and commas; an id_token must satisfy issuer, audience, azp and nonce rules. OAUTH_TOKEN_RESULT carries accessToken, refreshToken (absent when the provider issued none), expiresIn, tokenType bearer, scope and the grant's subject. OAUTH_REFRESH, OAUTH_REVOKE and OAUTH_USERINFO run as the configured provider's client (never a default to Google): github without an issuerUrl has only the static authorize and token endpoints, so its revoke and userinfo answer OAUTH_REVOKE_ERROR / OAUTH_USERINFO_ERROR naming the missing endpoint, and auth0 without an issuerUrl answers an error naming the missing issuer. OAUTH_CONNECTION and OAUTH_DISCONNECT read and drop the configured provider's row. OAUTH_REFRESH POSTs grant_type refresh_token and answers OAUTH_REFRESHED { accessToken, expiresIn }; OAUTH_REVOKE POSTs the token to the revocation endpoint and answers OAUTH_REVOKED { revoked }; OAUTH_USERINFO sends a Bearer GET to the userinfo endpoint and answers OAUTH_USERINFO_RESULT { sub, email, name, picture }, refusing a sub that differs from the one remembered for the token. OAUTH_CONNECT keeps the tokens with the host and answers only the connection row; it needs a signed-in caller. OAUTH_CONNECTION and OAUTH_DISCONNECT read and drop that row. Every failure answers OAUTH_<ACTION>_ERROR { code, message } and carries no token, verifier or vendor body."
]

orbital OAuthSpec {
  expects entity OAuthFlow [runtime] {
    id : string!
  }
  expects trait OAuthClient {
    state idle {
      INIT -> idle
      OAUTH_AUTHORIZE -> idle
      OAUTH_TOKEN -> idle
      OAUTH_REFRESH -> idle
      OAUTH_REVOKE -> idle
      OAUTH_USERINFO -> idle
      OAUTH_CONNECT -> idle
      OAUTH_CONNECTION -> idle
      OAUTH_DISCONNECT -> idle
    }
    emits {
      OAUTH_AUTHORIZED { authUrl : string!  state : string!  code : string! }
      OAUTH_TOKEN_RESULT { accessToken : string!  refreshToken : string  expiresIn : number!  tokenType : string!  scope : [string]!  subject : string }
      OAUTH_REFRESHED { accessToken : string!  expiresIn : number! }
      OAUTH_REVOKED { revoked : boolean! }
      OAUTH_USERINFO_RESULT { sub : string!  email : string!  name : string!  picture : string! }
      OAUTH_CONNECTED { provider : string!  connected : boolean!  account : string!  avatarUrl : string!  scope : [string]  connectedAt : string! }
      OAUTH_CONNECTION_RESULT { provider : string!  connected : boolean!  account : string!  avatarUrl : string!  scope : [string]  connectedAt : string! }
      OAUTH_DISCONNECTED { provider : string!  connected : boolean!  account : string!  avatarUrl : string!  scope : [string]  connectedAt : string! }
      OAUTH_AUTHORIZE_ERROR { code : string  message : string! }
      OAUTH_TOKEN_ERROR { code : string  message : string! }
      OAUTH_REFRESH_ERROR { code : string  message : string! }
      OAUTH_REVOKE_ERROR { code : string  message : string! }
      OAUTH_USERINFO_ERROR { code : string  message : string! }
      OAUTH_CONNECT_ERROR { code : string  message : string! }
      OAUTH_CONNECTION_ERROR { code : string  message : string! }
      OAUTH_DISCONNECT_ERROR { code : string  message : string! }
    }
  }
  expects config { provider : "google" | "github" | "auth0" = "google"  mode : string = "real"  clientAuth : string = "secret"  redirectUri : string = ""  issuerUrl : string = "" }
  expects page "/oauth" -> OAuthClient
}
