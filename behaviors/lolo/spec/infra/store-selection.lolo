app store-selection-spec [
  version: "1.0.0",
  description: "Design contract for choosing the row store an environment names: DATA_BACKEND (mock, firebase, postgres or couchdb; firebase when unset) with the USE_MOCK_DATA flag (true or false; false when unset), DATABASE_URL and PGPOOL_MAX for postgres, COUCHDB_URL for couchdb. An unset NODE_ENV counts as production, and production refuses mock data. Answers the choice once; the host builds the driver."
]

orbital StoreSelectionSpec {
  expects entity StoreChoice [runtime] {
    id : string!
    nodeEnv : string
    useMock : boolean
    backend : string
    url : string
    poolMax : number
  }
  expects trait StoreSelection {
    state idle {
      STORE_SELECT -> reading
    }
    state reading @holds (or (== @entity.poolMax null) (>= @entity.poolMax 0))
    emits {
      STORE_SELECTED { backend : string!  url : string!  poolMax : number }
      STORE_SELECTION_FAILED { code : string!  message : string! }
    }
  }
  expects page "/store-selection" -> StoreSelection
}
