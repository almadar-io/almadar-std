app audit-entry-spec [
  version: "1.0.0",
  description: "Design contract for the row an audit trail keeps: who did what to which record, with the before and after states. Entity only, so an organism that composes an audit atom under its own trait and page names can still satisfy it; other specs build on it with uses."
]

orbital AuditEntrySpec {
  expects entity AuditEntry [persistent] {
    id : string!
    actor : string
    action : string
    entityType : string
    entityId : string
    before : string
    after : string
    recordedAt : number
  }
}
