app http1-spec [
  version: "1.0.0",
  description: "Design contract for HTTP/1.1 over a raw TCP listener, the parity oracle being the os_host/http.rs reader and writer it replaces. LISTEN binds one os/tcp-listen stream; each accepted connection is read until its head ends in CRLF CRLF, then until content-length body bytes have arrived, and is delivered once as REQUEST_RECEIVED { requestId (the connection's socket id, a number), method, path, query, headers, body, peer }. Header names are lower-cased and repeated names are joined with a comma and a space; query is the raw text after the first ?, empty when there is none; body is the bytes of exactly content-length bytes, delivered intact whatever they hold. The atom never routes. A connection it cannot deliver is answered by the atom and never reaches the program: a head holding any byte of 0x80 or above, or that is not an HTTP/1.0 or HTTP/1.1 request line followed by name: value lines gets 400, so does a content-length that is not a number or that repeats with a different value; any transfer-encoding header gets 411; a head with no end after 65536 bytes gets 431, and so do more than 100 headers; a content-length over 67108864 gets 413. RESPOND { requestId, status, headers (a list of name and value, repeats allowed), body (bytes) } answers a delivered request once: the reply is the status line with the standard reason phrase, the given headers, content-length (left out for 204 and 304) and connection: close, then the body; the connection then closes and RESPONDED { requestId, bytes } follows. A RESPOND is refused with RESPOND_REFUSED { requestId, kind, error } and leaves the request pending when its status is outside 200-599 (invalid), a header name is not a token or a value holds a control character (invalid), a header is content-length, transfer-encoding or connection because the atom writes the framing (invalid), a 204 or 304 carries a body (invalid), or no pending request has that id (closed; a second answer is closed). Values it replaces (the http/listen and http/respond operators): POST /items/7?x=1&y=two with X-Two: a, x-two: b, Content-Length: 5 and body hello is delivered with path /items/7, query x=1&y=two, headers x-two a, b and body hello; NOT HTTP AT ALL is answered 400; Transfer-Encoding: chunked is answered 411; GET /ok with no query and no body is delivered with query and body empty; a 201 reply with content-type text/plain and body made (bytes) goes out as HTTP/1.1 201 Created, content-type, content-length 4, connection close."
]

type Http1Header = { name : string!, value : string! }
type Http1Reason = { status : number!, text : string! }
type Http1Conn = { sock : number!, key : string!, peer : string!, buf : string!, headLen : number!, need : number!, refuse : number!, method : string!, path : string!, query : string!, headers : [Http1Header]! }

orbital Http1Spec {
  expects entity Http1Server [runtime] {
    id : string!
    host : string
    port : number
    conns : [Http1Conn]
    asking : number
    @invariant (>= @entity.port 0)
  }
  expects trait Http1 {
    state booting {
      LISTEN -> booting
      LISTENING -> serving
      LISTEN_FAILED -> booting
    }
    state serving {
      CONN_ACCEPTED -> serving
      CHUNK_READ -> serving
      CONN_FAILED -> serving
      CONN_ADVANCE -> serving
      HEAD_SEARCHED -> serving
      HEAD_PARSED -> serving
      BODY_CHECK -> serving
      WANT_MORE -> serving
      DELIVER -> serving
      RESPOND -> serving
      RESPONSE_SENT -> serving
      RESPONSE_FAILED -> serving
    }
    emits {
      HTTP1_LISTENING { host : string!  port : number! }
      HTTP1_LISTEN_FAILED { error : string!  kind : string! }
      REQUEST_RECEIVED { requestId : number!  method : string!  path : string!  query : string!  headers : Map string string  body : bytes!  peer : string! }
      RESPONDED { requestId : number!  bytes : number! }
      RESPOND_REFUSED { requestId : number!  kind : string!  error : string! }
    }
  }
  expects page "/http1" -> Http1
}
