{
  "source": "orbital-rust/crates/orbital-core/crates/runtime/src/oauth.rs + oauth_flow.rs",
  "spec": "spec/infra/oauth.lolo",
  "note": "Host-backed parity cases the prover cannot state (URL bytes, hashes, form bodies, JWT checks). Random draws and the clock are journaled inputs; verifier = base64url(32 bytes), state = base64url(32 bytes) real / hex(drawn bytes) mock.",
  "cases": [
    {
      "id": "discovery-url",
      "ref": "oauth.rs discovery_url / tests",
      "in": [
        "https://accounts.google.com",
        "https://idp.example.com/tenant",
        "https://idp.example.com/tenant/"
      ],
      "out": [
        "https://accounts.google.com/.well-known/openid-configuration",
        "https://idp.example.com/tenant/.well-known/openid-configuration",
        "https://idp.example.com/tenant/.well-known/openid-configuration"
      ]
    },
    {
      "id": "discovery-request",
      "ref": "oauth.rs discovery_request",
      "expect": {
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        },
        "timeoutSeconds": 30,
        "issuerSchemeMustBe": "https",
        "badIssuer": "Invalid URL (metadata)",
        "nonHttps": "only requests to HTTPS are allowed"
      }
    },
    {
      "id": "discovery-response",
      "ref": "oauth.rs process_discovery",
      "expect": {
        "status!=200": "unexpected HTTP response status code",
        "notJsonObject": "invalid response encountered",
        "jsonParseFailWithJsonContentType": "parsing error occured",
        "jsonParseFailOtherContentType": "unexpected response content-type",
        "missingOrEmptyIssuer": "invalid response encountered",
        "issuerMismatch": "discovered metadata issuer does not match the expected issuer"
      }
    },
    {
      "id": "authorize-url-shape",
      "ref": "oauth.rs authorize",
      "setup": {
        "verifierBytes": 32,
        "stateBytes": 32
      },
      "expect": {
        "state": "base64url-nopad(32 bytes)",
        "code_challenge": "base64url-nopad(SHA-256(ascii(verifier)))",
        "code_challenge_method": "S256",
        "queryOrder": [
          "<existing endpoint query>",
          "<extra params>",
          "redirect_uri",
          "scope",
          "state",
          "code_challenge",
          "code_challenge_method",
          "client_id",
          "response_type=code"
        ],
        "scope": "scopes joined by one space",
        "clientIdAddedOnlyIfAbsentFromExtra": true,
        "responseTypeSkippedWhen": "extra has request_uri, request or response_type",
        "endpointMissingOrNotHttps": "authorization server metadata does not contain a valid \"as.authorization_endpoint\" / only requests to HTTPS are allowed"
      }
    },
    {
      "id": "authorize-pending-grant",
      "ref": "oauth.rs authorize",
      "expect": {
        "pending": {
          "provider": "client tag name",
          "redirectUri": "as given",
          "verifier": "never emitted",
          "subject": "given or none",
          "scopes": "as given"
        }
      }
    },
    {
      "id": "authorize-google-params",
      "ref": "std-oauth.lolo OAUTH_AUTHORIZE_ISSUER",
      "expect": {
        "extraParamsBeforeStandardOnes": {
          "access_type": "offline",
          "prompt": "consent"
        },
        "otherProviders": "no extra params"
      }
    },
    {
      "id": "authorize-options",
      "ref": "oauth_flow.rs plan_authorize",
      "expect": {
        "unknownOptionKey": "oauth-authorize: unknown option `<key>`",
        "redirectUriNotString": "oauth-authorize: redirectUri must be a string",
        "scopeString": "split on whitespace",
        "scopeList": "list of strings, else error",
        "badScope": "scope must be a string or a list of strings",
        "badSubject": "subject must be a string",
        "params": "strings, numbers (JS number text), booleans only"
      }
    },
    {
      "id": "authorize-mock",
      "ref": "oauth_flow.rs build_mock_authorization",
      "setup": {
        "stateBytes": "any"
      },
      "expect": {
        "state": "lowercase hex of drawn bytes",
        "urlBase": {
          "google": "https://accounts.google.com/o/oauth2/v2/auth",
          "github": "https://github.com/login/oauth/authorize",
          "auth0": "https://auth.example.com/authorize"
        },
        "queryOrder": [
          "response_type=code",
          "scope(space-joined)",
          "redirect_uri",
          "state",
          "client_id=mock-client-id"
        ],
        "pending": {
          "verifier": "",
          "subject": "given",
          "scopes": "given"
        },
        "readsCredential": false
      }
    },
    {
      "id": "authorize-static-github",
      "ref": "oauth_flow.rs static_metadata",
      "expect": {
        "authorization": "https://github.com/login/oauth/authorize",
        "token": "https://github.com/login/oauth/access_token",
        "issuer": "origin of authorization endpoint"
      }
    },
    {
      "id": "code-exchange-request",
      "ref": "oauth.rs exchange_request + token_request",
      "expect": {
        "method": "POST",
        "url": "token_endpoint (https)",
        "headers": {
          "Accept": "application/json",
          "Content-Type": "application/x-www-form-urlencoded;charset=UTF-8"
        },
        "formBodyOrder": [
          "redirect_uri",
          "code",
          "code_verifier",
          "grant_type=authorization_code",
          "client_id",
          "client_secret"
        ],
        "redirect_uri": "grant redirect uri with query and fragment removed",
        "clientAuth": {
          "post": "client_id and client_secret in the form",
          "basic": "Authorization: Basic base64(urlencode(id):urlencode(secret)), no client fields",
          "none": "client_id only"
        },
        "egress": "token endpoint origin must be in the egress list else EgressDenied"
      }
    },
    {
      "id": "code-exchange-callback-checks",
      "ref": "oauth.rs exchange_request",
      "expect": {
        "grantProviderMismatch": "grant was issued by <a>, not <b>",
        "badGrantRedirect": "Invalid URL (input)",
        "callbackHasResponse": "invalid response encountered",
        "issParamRequiredButMissing": "invalid response encountered",
        "issParamNotMatchingIssuer": "invalid response encountered",
        "callbackHasError": "authorization response from the server is an error",
        "callbackCodeAndStateReplaced": true
      }
    },
    {
      "id": "state-handling",
      "ref": "oauth_flow.rs Stage::Take",
      "expect": {
        "missing": "StateUnknown",
        "expired": "StateExpired",
        "subjectDiffersFromGrant": "SubjectMismatch (code: input subject; connect: signed-in principal; both None equal)",
        "providerDiffersFromGrant": "ProviderMismatch",
        "takenOnce": true,
        "mockPendingNeverExpires": true
      }
    },
    {
      "id": "connect-needs-principal",
      "ref": "oauth_flow.rs start",
      "expect": {
        "emptyOrNoPrincipal": "NotSignedIn",
        "storeUnavailable": "StoreUnavailable",
        "result": "connection row {provider, connected, account, avatarUrl, scope, connectedAt}, no tokens"
      }
    },
    {
      "id": "token-response",
      "ref": "oauth.rs process_tokens",
      "expect": {
        "status!=200": "challenge / error body / unexpected HTTP response status code (kind rejected)",
        "access_token": "non-empty string else invalid response encountered",
        "token_type": "non-empty, lowercased, bearer or dpop else unsupported operation",
        "expires_in": "number or JS parseFloat string, finite and >= 0 else invalid response encountered; absent defaults to 3600 in the result",
        "refresh_token": "if present non-empty string",
        "scope": "if present string, split on whitespace and commas, empty parts dropped",
        "result": {
          "tokenType": "bearer",
          "refreshToken": "absent (null) when no refresh_token"
        }
      }
    },
    {
      "id": "id-token-checks",
      "ref": "oauth.rs process_tokens + validate_jwt",
      "expect": {
        "parts": "3 else invalid response encountered; 5 (JWE) unsupported operation",
        "alg": "in id_token_signing_alg_values_supported else RS256 only",
        "crit header": "unsupported operation",
        "required claims": [
          "aud",
          "exp",
          "iat",
          "iss",
          "sub"
        ],
        "exp": "exp <= now - 30s fails (JWT timestamp claim value failed validation)",
        "nbf": "nbf > now + 30s fails",
        "iss": "equals metadata issuer else unexpected JWT claim value encountered",
        "aud": "string equals or list contains client id",
        "multiAud": "azp required and equal to client id",
        "nonce on code grant": "unexpected JWT claim value encountered",
        "signature": "not checked (response straight from issuer over TLS)",
        "sub": "remembered for the access token"
      }
    },
    {
      "id": "refresh",
      "ref": "oauth.rs refresh_request",
      "expect": {
        "emptyToken": "\"refreshToken\" must not be empty",
        "form": [
          "refresh_token",
          "grant_type=refresh_token",
          "client credentials"
        ],
        "result": {
          "accessToken": "string",
          "expiresIn": "expires_in or 3600"
        },
        "mock": {
          "unknownRefreshToken": "TokenRejected",
          "newAccessToken": "hex of 32 drawn bytes",
          "expiresIn": 3600
        }
      }
    },
    {
      "id": "revoke",
      "ref": "oauth.rs revoke_request/process_revoke",
      "expect": {
        "emptyToken": "\"token\" must not be empty",
        "endpoint": "revocation_endpoint",
        "headers": {
          "Accept": "*/*"
        },
        "form": [
          "token",
          "client credentials"
        ],
        "status!=200": "rejected error",
        "result": {
          "revoked": true
        },
        "mockUnknownToken": {
          "revoked": false
        }
      }
    },
    {
      "id": "userinfo",
      "ref": "oauth.rs userinfo_request/process_userinfo",
      "expect": {
        "emptyToken": "\"accessToken\" must not be empty",
        "request": {
          "method": "GET",
          "headers": {
            "Accept": "application/json, application/jwt",
            "Authorization": "Bearer <token>"
          }
        },
        "challenge": "server responded with a challenge in the WWW-Authenticate HTTP Header",
        "status!=200": "unexpected HTTP response status code",
        "sub": "non-empty",
        "subMismatchWithRememberedSubject": "unexpected JSON attribute value encountered",
        "jwtResponse": "alg from userinfo_signing_alg_values_supported else configuration error; aud and iss checked when present",
        "result": [
          "sub",
          "email",
          "name",
          "picture"
        ],
        "missingFieldsAreEmptyText": true
      }
    },
    {
      "id": "mock-profile",
      "ref": "oauth_flow.rs mock_profile",
      "setup": {
        "provider": "google",
        "sub": "abcdef0123456789"
      },
      "expect": {
        "email": "user-abcdef01@google.example.com",
        "name": "Mock User (google)",
        "picture": "https://google.example.com/avatar/abcdef01.png"
      }
    },
    {
      "id": "mock-token-exchange",
      "ref": "oauth_flow.rs Stage::MockAccess..",
      "expect": {
        "draws": [
          "32 bytes access",
          "32 bytes refresh",
          "8 bytes subject"
        ],
        "accessToken": "hex",
        "expiresIn": 3600,
        "scope": "the grant's scopes",
        "subject": "the grant's subject"
      }
    },
    {
      "id": "failure-hygiene",
      "ref": "oauth.rs OidcError",
      "expect": {
        "noTokenVerifierOrVendorBody": true,
        "unconfigured-client": "falls back to the mock backend",
        "transportFailure": "code null"
      }
    },
    {
      "id": "github-refresh",
      "ref": "oauth_flow.rs begin_meta Endpoints + refresh_request",
      "setup": {
        "config.provider": "github",
        "issuerUrl": ""
      },
      "expect": {
        "client": "tag github, static endpoints",
        "request": "POST https://github.com/login/oauth/access_token, form refresh_token, grant_type=refresh_token, client credentials",
        "neverGoogle": true
      }
    },
    {
      "id": "github-revoke",
      "ref": "oauth.rs revoke_request -> resolve_endpoint(revocation_endpoint)",
      "setup": {
        "config.provider": "github",
        "issuerUrl": ""
      },
      "expect": {
        "OAUTH_REVOKE_ERROR": {
          "code": null,
          "message": "Provider \"github\" has no revocation endpoint — set OIDC_ISSUER_URL to an OIDC-compliant issuer, or use OAUTH_MODE=mock"
        },
        "noHttpRequest": true,
        "withIssuerUrl": "uses the issuer's revocation_endpoint"
      }
    },
    {
      "id": "github-userinfo",
      "ref": "oauth.rs userinfo_request -> resolve_endpoint(userinfo_endpoint)",
      "setup": {
        "config.provider": "github",
        "issuerUrl": ""
      },
      "expect": {
        "OAUTH_USERINFO_ERROR": {
          "code": null,
          "message": "Provider \"github\" has no userinfo endpoint — set OIDC_ISSUER_URL to an OIDC-compliant issuer, or use OAUTH_MODE=mock"
        },
        "noHttpRequest": true,
        "withIssuerUrl": "uses the issuer's userinfo_endpoint"
      }
    },
    {
      "id": "provider-from-config",
      "ref": "std-oauth.lolo",
      "expect": {
        "providerSource": "@config.provider (google|github|auth0, default google)",
        "noActionPayloadCarriesProvider": true,
        "auth0WithoutIssuer": "error naming the missing OIDC issuer",
        "google": "issuer from issuerUrl or https://accounts.google.com",
        "mockClientTag": "config provider",
        "connectionRows": "read and dropped for the config provider"
      }
    }
  ]
}