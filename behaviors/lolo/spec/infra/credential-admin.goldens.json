    {
      "id": "mask-last4",
      "ref": "credential_admin.rs tests::a_set_stores_through_the_host_and_answers_the_masked_tail_only",
      "event": "CRED_ADMIN_MASK",
      "payload": {
        "value": "salt-value-1111"
      },
      "expect": [
        {
          "event": "CRED_ADMIN_MASKED",
          "payload": {
            "last4": "1111"
          }
        }
      ]
    },
    {
      "id": "mask-short",
      "ref": "admin::last4 (a value shorter than four units is returned whole)",
      "event": "CRED_ADMIN_MASK",
      "payload": {
        "value": "ab"
      },
      "expect": [
        {
          "event": "CRED_ADMIN_MASKED",
          "payload": {
            "last4": "ab"
          }
        }
      ]
    },
    {
      "id": "mask-empty",
