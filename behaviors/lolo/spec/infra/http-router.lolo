app http-router-spec [
  version: "1.0.0",
  description: "Design contract for the request pipeline of the HTTP server program, from the std-http-server organism it was lifted out of. REQUEST_RECEIVED { requestId, method, path, query, headers (a map of lower-cased names), body, peer } starts one request and any number are in flight at once, told apart by requestId. The router asks HTTP_DECIDE { requestId, method, path, headers, contentLength } of the policy and hears HTTP_DECIDED { requestId, verdict, status, responseHeaders, compress }: a preflight is answered at once with the policy status, the policy headers and an empty body; payload-too-large is answered 413 with the policy headers, content-type application/json and the body { error: Payload too large, code: PAYLOAD_TOO_LARGE }; an ok request whose path starts with apiPrefix is counted first (RATE_REQUEST { requestId }, answered ADMITTED { requestId, remaining, resetIn, limit, window } or THROTTLED { requestId, resetIn, limit, window }), any other ok request goes straight to routing. A throttled request is answered 429 with content-type text/plain; charset=utf-8, the policy headers, ratelimit-policy limit;w=window, ratelimit-limit, ratelimit-remaining 0 and ratelimit-reset, and the body Too many requests, please try again later. An admitted one carries the same four headers (remaining counted down) onto its answer. Routing is by method and path: GET /api/health answers 200 content-type application/json with { status: healthy, version }, every other request answers 404 { error: Not found, code: NOT_FOUND }. Each answer is RESPOND { requestId, status, headers (a list of name and value), body (bytes) } and is reported as REQUEST_ANSWERED { requestId, status, headers, body }; the request then leaves the pending list. Not in this slice: the other routes, the bearer guard, hooks, SSE and static files."
]

type RouterHeader = { name : string!, value : string! }
type RouterPending = { requestId : number!, method : string!, path : string!, responseHeaders : [RouterHeader]! }

orbital HttpRouterSpec {
  expects entity RouteRequest [runtime] {
    id : string!
    status : number
    pending : [RouterPending]
    @invariant (>= @entity.status 0)
  }
  expects trait HttpRouter {
    state routing {
      REQUEST_RECEIVED -> routing
      HTTP_DECIDED -> routing
      ADMITTED -> routing
      THROTTLED -> routing
      ROUTE_REQUEST -> routing
    }
    emits {
      HTTP_DECIDE { requestId : number!  method : string!  path : string!  headers : [RouterHeader]!  contentLength : number }
      RATE_REQUEST { requestId : number! }
      RESPOND { requestId : number!  status : number!  headers : [RouterHeader]!  body : bytes! }
      REQUEST_ANSWERED { requestId : number!  status : number!  headers : [RouterHeader]  body : string! }
      REQUEST_RATE_LIMITED { requestId : number!  resetSeconds : number! }
      ROUTE_HEALTH { requestId : number! }
      ROUTE_REFUSED { requestId : number! }
    }
  }
  expects page "/router" -> HttpRouter
}
