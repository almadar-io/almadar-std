    {
      "id": "an-unknown-token-reads-no-link-and-takes-no-decision",
      "now": 1700000000000,
      "defaults": [
        "LinkResolve"
      ],
      "steps": [
        {
          "event": "INIT",
          "payload": {
            "token": "forged"
          },
          "expect": {
            "fired": true,
            "state": "opening",
            "emits": [
              {
                "event": "LINK_TOKEN_RESOLVE",
                "payload": {
                  "key": "review",
                  "token": "forged"
                }
              },
              {
                "event": "TOKEN_REFUSED",
                "payload": {
                  "code": "unknown"
                }
              }
            ],
            "neverEmits": [
              "LINK_DECIDED"
            ]
          }
        }
      ]
    }
  ]
