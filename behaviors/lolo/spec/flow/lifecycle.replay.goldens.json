{
 "atom": "spec/flow/lifecycle-fixture.lolo",
 "trait": "StatusSweep",
 "note": "Runs std-lifecycle through spec/flow/lifecycle-fixture.lolo (the runner does not apply per-case config). The scan's fetch filter is store-side and the replay store holds no rows, so which rows a sweep selects is the filter expressions' job, not here (selection was checked by evaluating the filters on aged, fresh, other-status and undated rows); these cases play the host's answer (the fetched rows) as a step.",
 "cases": [
  {
   "id": "status-aged-row-transitions",
   "steps": [
    {
     "trait": "StatusSweep",
     "event": "ScanRecordsLoaded",
     "payload": {
      "data": [
       {
        "id": "j1",
        "status": "open",
        "createdAt": 1
       },
       {
        "id": "j2",
        "status": "open",
        "createdAt": 2
       }
      ],
      "totalCount": 2
     },
     "from": "idle",
     "expect": {
      "state": "scanning",
      "emits": [
       {
        "event": "LifecycleTransitioned",
        "payload": {
         "entityId": "j1",
         "status": "expired"
        }
       }
      ],
      "neverEmits": [
       "LifecycleDeleted"
      ]
     }
    }
   ]
  },
  {
   "id": "status-empty-scan-drains-to-idle",
   "steps": [
    {
     "trait": "StatusSweep",
     "event": "ScanRecordsLoaded",
     "payload": {
      "data": [
       {
        "id": "j1",
        "status": "open",
        "createdAt": 1
       },
       {
        "id": "j2",
        "status": "open",
        "createdAt": 2
       }
      ],
      "totalCount": 2
     },
     "from": "idle"
    },
    {
     "trait": "StatusSweep",
     "event": "ScanRecordsLoaded",
     "payload": {
      "data": [],
      "totalCount": 0
     },
     "from": "scanning",
     "expect": {
      "state": "idle",
      "neverEmits": [
       "LifecycleTransitioned",
       "LifecycleDeleted"
      ]
     }
    }
   ]
  },
