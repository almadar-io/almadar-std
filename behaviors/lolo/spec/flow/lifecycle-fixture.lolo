app lifecycle-fixture [
  version: "1.0.0",
  description: "Replay fixture for std-lifecycle: an enabled status sweep, delete sweeps (enabled, disabled, dry run, zero days) and a status-narrowed delete sweep over one Job entity, so lifecycle.replay.goldens.json runs against real config."
]
orbital LifecycleFixtureOrbital {
  uses Lifecycle from "std/behaviors/std-lifecycle"

  entity Job [persistent: lifecycle_fixture_jobs] {
    id : string!
    status : string = ""
    createdAt : instant
  }

  entity StatusSweepLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
    status : string = ""
  }

  entity DeleteSweepLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
    status : string = ""
  }

  entity DeleteOffLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
    status : string = ""
  }

  entity DeleteDryLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
    status : string = ""
  }

  entity DeleteInStatusLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
    status : string = ""
  }

  entity DeleteZeroLog [runtime] {
    id : string!
    headId : string = ""
    headStatus : string = ""
    status : string = ""
  }

  trait StatusSweep = Lifecycle.traits.LifecycleScheduler -> StatusSweepLog {
    config {
      enabled: true
      targetEntity: Job
      fromStatus: "open"
      toStatus: "expired"
      dateField: createdAt
      ageDays: 30
    }
  }

  trait DeleteSweep = Lifecycle.traits.LifecycleRetention -> DeleteSweepLog {
    config {
      enabled: true
      targetEntity: Job
      dateField: createdAt
      ageDays: 30
    }
  }

  trait DeleteOff = Lifecycle.traits.LifecycleRetention -> DeleteOffLog {
    config {
      enabled: false
      targetEntity: Job
      dateField: createdAt
      ageDays: 30
    }
  }

  trait DeleteDry = Lifecycle.traits.LifecycleRetention -> DeleteDryLog {
    config {
      enabled: true
      dryRun: true
      targetEntity: Job
      dateField: createdAt
      ageDays: 30
    }
  }

  trait DeleteZero = Lifecycle.traits.LifecycleRetention -> DeleteZeroLog {
    config {
      enabled: true
      targetEntity: Job
      dateField: createdAt
      ageDays: 0
    }
  }

  trait DeleteInStatus = Lifecycle.traits.LifecycleStatusRetention -> DeleteInStatusLog {
    config {
      enabled: true
      targetEntity: Job
      fromStatus: "closed"
      dateField: createdAt
      ageDays: 30
    }
  }

  page "/lifecycle-fixture" as LifecycleFixturePage -> StatusSweep, DeleteSweep, DeleteOff, DeleteDry, DeleteZero, DeleteInStatus
}
