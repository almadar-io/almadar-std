   "now": 1760531400000,
   "config": {
    "timeoutMs": 2000,
    "cancelOnDeadline": false
   },
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "TIMER_DUE",
     "payload": {},
     "from": "running",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "TIMED_OUT",
        "payload": {
         "key": "k1",
         "timeoutMs": 2000
        }
       }
      ],
      "effects": []
     }
    }
   ]
  },
  {
   "id": "control-the-default-cancels-the-key-on-the-deadline",
   "now": 1760531400000,
   "config": {
    "timeoutMs": 2000
   },
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "TIMER_DUE",
     "payload": {},
     "from": "running",
     "expect": {
      "state": "idle",
