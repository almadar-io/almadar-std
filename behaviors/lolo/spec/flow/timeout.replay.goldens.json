       {
        "type": "cancel-call"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "cancel-on-deadline-false-success-before-the-deadline-still-completes",
   "now": 1760531400000,
   "config": {
    "cancelOnDeadline": false
   },
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "SUCCEEDED",
     "payload": {
      "key": "k1"
     },
     "from": "running",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "COMPLETED",
        "payload": {
         "key": "k1"
        }
       }
      ],
