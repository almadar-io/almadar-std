{
 "atom": "flow/atoms/std-retry.lolo",
 "trait": "Retry",
 "note": "from std-retry-program.test.ts; the backoff tick (TIMER_DUE after real time) is a host answer played as a step",
 "cases": [
  {
   "id": "start-numbers-first-attempt-1",
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     },
     "expect": {
      "state": "running",
      "emits": [
       {
        "event": "ATTEMPT",
        "payload": {
         "key": "k1",
         "attempt": 1
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "failure-schedules-backoff-then-attempt-2",
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "boom"
     },
     "from": "running",
     "expect": {
      "state": "backoff",
      "emits": [
       {
        "event": "RETRY_SCHEDULED",
        "payload": {
         "key": "k1",
         "attempt": 1,
         "error": "boom"
        }
       }
      ]
     }
    },
    {
     "event": "TIMER_DUE",
     "payload": {},
     "from": "backoff",
     "expect": {
      "state": "running",
      "emits": [
       {
        "event": "ATTEMPT",
        "payload": {
         "key": "k1",
         "attempt": 2
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-failed-for-another-key-is-ignored",
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "other",
      "error": "x"
     },
     "from": "running",
     "expect": {
      "neverEmits": [
       "RETRY_SCHEDULED",
       "GAVE_UP"
      ]
     }
    }
   ]
  },
  {
   "id": "succeeded-completes",
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "SUCCEEDED",
     "payload": {
      "key": "k1"
     },
     "from": "running",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "COMPLETED",
        "payload": {
         "key": "k1",
         "attempts": 1
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "attempts-spent-gives-up-with-the-last-error",
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "a"
     },
     "from": "running"
    },
    {
     "event": "TIMER_DUE",
     "payload": {},
     "from": "backoff"
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "b"
     },
     "from": "running"
    },
    {
     "event": "TIMER_DUE",
     "payload": {},
     "from": "backoff"
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "c"
     },
     "from": "running",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "GAVE_UP",
        "payload": {
         "key": "k1",
         "attempts": 3,
         "error": "c"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-second-failure-still-schedules",
   "steps": [
    {
     "event": "START",
     "payload": {
      "key": "k1"
     }
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "a"
     },
     "from": "running"
    },
    {
     "event": "TIMER_DUE",
     "payload": {},
     "from": "backoff"
    },
    {
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "b"
     },
     "from": "running",
     "expect": {
      "state": "backoff",
      "neverEmits": [
       "GAVE_UP"
      ]
     }
    }
   ]
  },
  {
   "id": "overflowing backoff caps at maxDelayMs",
   "config": {
    "maxAttempts": 2000,
    "multiplier": 2,
    "baseDelayMs": 500,
    "maxDelayMs": 30000
   },
   "entity": {
    "key": "k1",
    "attempt": 1500
   },
   "steps": [
    {
     "from": "running",
     "event": "FAILED",
     "payload": {
      "key": "k1",
      "error": "x"
     },
     "expect": {
      "state": "backoff",
      "emits": [
       {
        "event": "RETRY_SCHEDULED",
        "payload": {
         "key": "k1",
         "attempt": 1500,
         "delayMs": 30000,
         "error": "x"
        }
       }
      ]
     }
    }
   ],
   "skip": "needs config override (G-ORB-460)"
  }
 ]
}
