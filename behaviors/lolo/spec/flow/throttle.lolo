app throttle-spec [
  version: "1.0.0",
  description: "Design contract for a throttle: an open gate has dropped nothing, and a cooling gate's dropped count is never negative."
]

orbital ThrottleSpec {
  expects trait Throttle {
    state open @holds (= @entity.suppressed 0)
    state cooling @holds (>= @entity.suppressed 0)
  }
}
