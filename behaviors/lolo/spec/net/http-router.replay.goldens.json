      },
      "steps": [
        {
          "from": "routing",
          "event": "HTTP_DECIDED",
          "payload": {
            "requestId": 7,
            "verdict": "preflight",
            "status": 200,
            "responseHeaders": [
              {
                "name": "vary",
                "value": "origin"
              }
            ],
            "compress": "none"
          },
          "expect": {
            "fired": true,
            "emits": [
              {
                "event": "REQUEST_ANSWERED",
                "payload": {
                  "requestId": 7,
                  "status": 200,
                  "headers": [
                    {
                      "name": "vary",
                      "value": "origin"
                    }
                  ],
                  "body": ""
                }
              }
            ],
            "neverEmits": [
              "RATE_REQUEST",
              "ROUTE_REQUEST"
            ]
          }
        }
      ]
    },
    {
      "id": "payload-too-large-is-answered-413-json",
      "entity": {
        "pending": [
          {
            "requestId": 7,
            "method": "POST",
            "path": "/api/x",
            "query": "",
            "authorization": "",
            "ip": "1.2.3.4",
            "responseHeaders": [
              {
