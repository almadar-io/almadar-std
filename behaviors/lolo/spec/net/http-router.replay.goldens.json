    {
      "id": "admitted-carries-the-ratelimit-headers-to-routing",
      "entity": {
        "pending": [
          {
            "requestId": 7,
            "method": "GET",
            "path": "/api/health",
            "query": "",
            "authorization": "",
            "ip": "1.2.3.4",
            "responseHeaders": [
              {
                "name": "vary",
                "value": "origin"
              }
            ]
          }
        ],
        "vapidKey": "",
        "tickInvoker": ""
      },
      "steps": [
        {
          "from": "routing",
          "event": "ADMITTED",
          "payload": {
            "requestId": 7,
            "limit": 100,
            "window": 60,
            "remaining": 99,
            "resetIn": 30,
            "counted": true
          },
          "expect": {
            "fired": true,
            "emits": [
              {
                "event": "ROUTE_REQUEST",
                "payload": {
                  "requestId": 7,
                  "rateHeaders": [
                    {
                      "name": "ratelimit-policy",
                      "value": "100;w=60"
                    },
                    {
                      "name": "ratelimit-limit",
                      "value": "100"
                    },
                    {
                      "name": "ratelimit-remaining",
                      "value": "99"
                    },
                    {
                      "name": "ratelimit-reset",
                      "value": "30"
                    }
                  ]
                }
              },
              {
                "event": "REQUEST_ANSWERED",
                "payload": {
                  "requestId": 7,
                  "status": 200,
                  "headers": [
                    {
                      "name": "vary",
                      "value": "origin"
                    },
                    {
                      "name": "ratelimit-policy",
                      "value": "100;w=60"
                    },
                    {
                      "name": "ratelimit-limit",
                      "value": "100"
                    },
                    {
                      "name": "ratelimit-remaining",
                      "value": "99"
                    },
                    {
                      "name": "ratelimit-reset",
                      "value": "30"
                    },
                    {
                      "name": "content-type",
                      "value": "application/json"
                    }
                  ],
                  "body": "{\"status\":\"healthy\",\"version\":\"0.0.0\"}"
                }
              }
            ]
          }
        }
      ],
      "note": "the cascade routes the pending /api/health request, whose answer carries the ratelimit headers"
    },
