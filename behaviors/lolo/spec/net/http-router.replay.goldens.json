        "tickInvoker": ""
      },
      "steps": [
        {
          "from": "routing",
          "event": "HTTP_DECIDED",
          "payload": {
            "requestId": 7,
            "verdict": "payload-too-large",
            "status": 413,
            "responseHeaders": [
              {
                "name": "vary",
                "value": "origin"
              }
            ],
            "compress": "none"
          },
          "expect": {
            "fired": true,
            "emits": [
              {
                "event": "REQUEST_ANSWERED",
                "payload": {
                  "requestId": 7,
                  "status": 413,
                  "headers": [
                    {
                      "name": "vary",
                      "value": "origin"
                    },
                    {
                      "name": "content-type",
                      "value": "application/json"
