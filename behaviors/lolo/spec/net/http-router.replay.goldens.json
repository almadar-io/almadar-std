{
  "atom": "net/atoms/std-http-router.lolo",
  "trait": "HttpRouter",
  "note": "Design contract spec/net/http-router.lolo. Each case seeds the pending request the event refers to; bodies are asserted through REQUEST_ANSWERED (text).",
  "cases": [
    {
      "id": "request-received-asks-the-policy-with-the-content-length",
      "entity": {
        "pending": [],
        "vapidKey": "",
        "tickInvoker": ""
      },
      "steps": [
        {
          "from": "routing",
          "event": "REQUEST_RECEIVED",
          "payload": {
            "requestId": 7,
            "method": "POST",
            "path": "/api/x",
            "query": "",
            "headers": {
              "content-length": "12"
            },
            "peer": "1.2.3.4:5000"
          },
          "expect": {
            "fired": true,
            "emits": [
              {
                "event": "HTTP_DECIDE",
                "payload": {
                  "requestId": 7,
                  "method": "POST",
                  "path": "/api/x",
                  "headers": [
                    {
                      "name": "content-length",
                      "value": "12"
                    }
                  ],
                  "contentLength": 12
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-request-without-content-length-asks-with-zero",
      "entity": {
        "pending": [],
