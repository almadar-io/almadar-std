                "event": "REQUEST_ANSWERED",
                "payload": {
                  "requestId": 7,
                  "status": 429,
                  "headers": [
                    {
                      "name": "vary",
                      "value": "origin"
                    },
                    {
                      "name": "ratelimit-policy",
                      "value": "100;w=60"
                    },
                    {
                      "name": "ratelimit-limit",
                      "value": "100"
                    },
                    {
                      "name": "ratelimit-remaining",
                      "value": "0"
                    },
                    {
                      "name": "ratelimit-reset",
                      "value": "30"
                    },
                    {
                      "name": "content-type",
                      "value": "text/plain; charset=utf-8"
                    }
                  ],
                  "body": "Too many requests, please try again later."
                }
              }
            ],
            "neverEmits": [
              "ROUTE_REQUEST"
            ]
          }
        }
      ]
