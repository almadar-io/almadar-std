{
 "atom": "net/atoms/std-http-request.lolo",
 "trait": "HttpRequest",
 "note": "request composition of the retired drivers/http_request request.rs (query, bodies, multipart) and the retry and pagination of driver.rs; auth is not built",
 "cases": [
  {
   "id": "a-get-with-a-query-is-percent-encoded-in-map-order",
   "steps": [
    {
     "event": "HTTP_REQUEST",
     "payload": {
      "key": "r1",
      "method": "GET",
      "path": "/x",
      "query": {
       "q": "a b&c",
       "limit": "2"
      },
      "headers": {},
      "form": {},
      "multipartParts": [],
      "stream": "none",
      "retryMax": 0,
      "retryOn": [],
      "retryOnFailure": [],
      "retryDelaysMs": [],
      "paginate": "none",
      "maxPages": 1
     },
     "expect": {
      "emits": [
       {
        "event": "HTTP_SEND",
        "payload": {
         "key": "r1",
         "method": "GET",
         "target": "/x?q=a%20b%26c&limit=2",
         "headers": [],
         "body": "",
         "stream": "none"
        }
       }
      ],
      "neverEmits": [
       "HTTP_REQUEST_REFUSED"
      ]
     }
    }
   ]
  },
