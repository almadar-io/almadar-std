{
 "atom": "net/atoms/std-rate-limiter-ip.lolo",
 "trait": "RateKeyRateLimiter",
 "cases": [
  {
   "id": "under-limit-headers",
   "config": {
    "enabled": true,
    "requestsPerMinute": 3,
    "windowSeconds": 10
   },
   "steps": [
    {
     "event": "REQUEST",
     "payload": {
      "requestId": 1,
      "ip": "A"
     },
     "expect": {
      "emits": [
       {
        "event": "ADMITTED",
        "payload": {
         "requestId": 1,
         "remaining": 2,
         "limit": 3,
         "window": 10
        }
       }
      ]
     }
    }
   ],
   "skip": "needs PS1 config/now"
  },
