app rate-limiter-ip-spec [
  version: "1.0.0",
  description: "Design contract for the per-client fixed-window rate limiter: each client address has its own window, a counted request adds exactly one to its client's window, and the answer is ADMITTED { requestId, remaining, resetIn, limit, window, counted } or THROTTLED { requestId, resetIn, limit, window }. A request with no address, or a disabled limiter, is admitted uncounted with counted false, so the server sends no ratelimit headers."
]

type RateKey = { ip : string!, count : number!, windowStart : instant! }

orbital RateLimiterIpSpec {
  expects entity RateClient [runtime] {
    id : string
    buckets : [RateKey]
  }
  expects trait RateKeyRateLimiter {
    state counting {
      REQUEST -> counting
    }
    emits {
      ADMITTED { requestId : number!  remaining : number!  resetIn : number!  limit : number!  window : number!  counted : boolean }
      THROTTLED { requestId : number!  resetIn : number!  limit : number!  window : number! }
    }
  }
}
