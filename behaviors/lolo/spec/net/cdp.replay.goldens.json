  {
   "id": "disconnect-closes-the-socket-then-fails-every-pending-command-oldest-first",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_DISCONNECT",
     "payload": {},
     "from": "connected",
     "entity": {
      "id": "c",
      "nextId": 3,
      "pending": [
       {
        "id": 1,
        "key": "a",
        "method": "A.one"
       },
       {
        "id": 2,
        "key": "b",
        "method": "B.two"
       }
      ],
      "closing": false
     },
     "expect": {
      "state": "connected",
      "emits": [
       {
        "event": "CDP_WS_CLOSE"
       }
      ],
      "entity": {
       "closing": true
      }
     }
    },
    {
     "event": "CDP_COMMAND",
     "payload": {
      "key": "c",
      "method": "C.three",
      "paramsJson": "{}"
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_ERROR",
        "payload": {
         "key": "c",
         "method": "C.three",
         "code": "not-connected"
        }
       }
      ],
      "neverEmits": [
       "CDP_WS_SEND"
      ]
     }
    },
    {
     "event": "CDP_WS_CLOSED",
     "payload": {
      "code": 1000,
      "reason": ""
     },
     "expect": {
      "state": "disconnected",
      "emits": [
       {
        "event": "CDP_ERROR",
        "payload": {
         "key": "a",
         "method": "A.one",
         "code": "disconnected"
        }
       },
       {
        "event": "CDP_ERROR",
        "payload": {
         "key": "b",
         "method": "B.two",
         "code": "disconnected"
        }
       },
       {
        "event": "CDP_DISCONNECTED",
        "payload": {
         "reason": "closed 1000: "
        }
       }
      ],
      "entity": {
       "pending": []
      }
     }
    }
   ]
  },
  {
   "id": "a-lost-connection-fails-pending-commands-with-the-failure-as-the-reason",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_WS_FAILED",
     "payload": {
      "error": "reset",
      "kind": "io"
     },
     "from": "connected",
     "entity": {
      "id": "c",
      "nextId": 2,
      "pending": [
       {
        "id": 1,
        "key": "a",
        "method": "A.one"
       }
      ],
      "closing": false
     },
     "expect": {
      "state": "disconnected",
      "emits": [
       {
        "event": "CDP_ERROR",
        "payload": {
         "key": "a",
         "code": "disconnected",
         "message": "failed io: reset"
        }
       },
       {
        "event": "CDP_DISCONNECTED",
        "payload": {
         "reason": "failed io: reset"
        }
       }
      ]
     }
    }
   ]
  },
