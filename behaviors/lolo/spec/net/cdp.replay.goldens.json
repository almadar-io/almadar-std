      "entity": {
       "nextId": 1,
       "pending": []
      }
     }
    }
   ]
  },
  {
   "id": "an-error-reply-answers-cdp-error-with-the-protocol-code-and-message",
   "note": "the error frame is the real answer of headless Chrome to an unknown method",
