  {
   "id": "connect-control-a-second-connect-while-connecting-or-connected-is-refused-and-changes-nothing",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_CONNECT",
     "payload": {},
     "from": "connecting",
     "expect": {
      "state": "connecting",
      "emits": [
