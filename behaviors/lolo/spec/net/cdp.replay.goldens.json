  {
   "id": "two-commands-in-flight-are-answered-out-of-order-each-to-its-own-key",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_COMMAND",
     "payload": {
      "key": "a",
      "method": "A.one",
      "paramsJson": "{}"
     },
     "from": "connected",
     "entity": {
      "id": "c",
      "nextId": 1,
      "pending": [],
      "closing": false
     },
     "expect": {
      "entity": {
       "nextId": 2
      }
     }
    },
    {
     "event": "CDP_COMMAND",
     "payload": {
      "key": "b",
      "method": "B.two",
      "paramsJson": "{}"
     },
     "expect": {
      "entity": {
       "nextId": 3,
       "wire": "{\"id\":2,\"method\":\"B.two\",\"params\":{}}",
       "pending": [
        {
         "id": 1,
         "key": "a",
         "method": "A.one"
        },
        {
         "id": 2,
         "key": "b",
         "method": "B.two"
        }
       ]
      }
     }
    },
    {
     "event": "CDP_WS_MESSAGE",
     "payload": {
      "text": "{\"id\":2,\"result\":{\"v\":2}}",
      "binary": false
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_REPLY",
        "payload": {
         "key": "b",
         "method": "B.two",
         "frame": "{\"id\":2,\"result\":{\"v\":2}}"
        }
       }
      ],
      "entity": {
       "pending": [
        {
         "id": 1,
         "key": "a",
         "method": "A.one"
        }
       ]
      }
     }
    },
    {
     "event": "CDP_WS_MESSAGE",
     "payload": {
      "text": "{\"id\":1,\"result\":{\"v\":1}}",
      "binary": false
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_REPLY",
        "payload": {
         "key": "a",
         "method": "A.one",
         "frame": "{\"id\":1,\"result\":{\"v\":1}}"
        }
       }
      ],
      "entity": {
       "pending": []
      },
      "neverEmits": [
       "CDP_STRAY"
      ]
     }
    }
   ]
  },
  {
   "id": "a-frame-with-a-method-and-no-id-answers-cdp-event",
   "note": "the event frame is a real Target.targetCreated of headless Chrome; control: the pending command is untouched",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_WS_MESSAGE",
     "payload": {
      "text": "{\"method\":\"Target.targetCreated\",\"params\":{\"targetInfo\":{\"targetId\":\"5D93F1FEBC1AABE3BBA444D828C3DEB5\",\"type\":\"background_page\",\"title\":\"Google Hangouts\",\"url\":\"chrome-extension://nkeimhogjdpnpccoofpliimaahmaaome/background.html\",\"attached\":false,\"canAccessOpener\":false,\"browserContextId\":\"3EBD69FF9AE13F3508347BC758AAE3E8\"}}}",
      "binary": false
     },
     "from": "connected",
     "entity": {
      "id": "c",
      "nextId": 2,
      "pending": [
       {
        "id": 1,
        "key": "a",
        "method": "A.one"
       }
      ],
      "closing": false
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_EVENT",
        "payload": {
         "method": "Target.targetCreated",
         "frame": "{\"method\":\"Target.targetCreated\",\"params\":{\"targetInfo\":{\"targetId\":\"5D93F1FEBC1AABE3BBA444D828C3DEB5\",\"type\":\"background_page\",\"title\":\"Google Hangouts\",\"url\":\"chrome-extension://nkeimhogjdpnpccoofpliimaahmaaome/background.html\",\"attached\":false,\"canAccessOpener\":false,\"browserContextId\":\"3EBD69FF9AE13F3508347BC758AAE3E8\"}}}"
        }
       }
      ],
      "neverEmits": [
       "CDP_REPLY",
       "CDP_ERROR",
       "CDP_STRAY"
      ],
      "entity": {
       "pending": [
        {
         "id": 1,
         "key": "a",
         "method": "A.one"
        }
       ]
      }
     }
    }
   ]
  },
