     "entity": {
      "id": "c",
      "nextId": 2,
      "pending": [
       {
        "id": 1,
        "key": "a",
        "method": "A.one"
       }
      ],
      "closing": false
     },
     "expect": {
      "state": "connected",
      "emits": [
       {
        "event": "CDP_STRAY",
        "payload": {
         "reason": "ws-refused"
