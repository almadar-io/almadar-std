  {
   "id": "a-command-still-pending-at-its-deadline-answers-timeout-and-is-forgotten",
   "note": "control: the other command stays pending and the late reply of the timed-out one is a stray",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_TIMEOUT",
     "payload": {
      "key": "1"
     },
     "from": "connected",
     "entity": {
      "id": "c",
      "nextId": 3,
      "pending": [
       {
        "id": 1,
        "key": "a",
        "method": "A.one"
       },
       {
        "id": 2,
        "key": "b",
        "method": "B.two"
       }
      ],
      "closing": false
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_ERROR",
        "payload": {
         "key": "a",
         "method": "A.one",
         "code": "timeout"
        }
       }
      ],
      "entity": {
       "pending": [
        {
         "id": 2,
         "key": "b",
         "method": "B.two"
        }
       ]
      },
      "neverEmits": [
       "CDP_STRAY"
      ]
     }
    },
    {
     "event": "CDP_WS_MESSAGE",
     "payload": {
      "text": "{\"id\":1,\"result\":{}}",
      "binary": false
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_STRAY",
        "payload": {
         "reason": "unknown-id"
        }
       }
      ],
      "neverEmits": [
       "CDP_REPLY"
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-timer-of-a-command-already-answered-is-a-stray-not-an-error",
   "defaults": [
    "CdpHttp",
    "CdpWs",
    "CdpDelay"
   ],
   "steps": [
    {
     "event": "CDP_TIMEOUT",
     "payload": {
      "key": "7"
     },
     "from": "connected",
     "entity": {
      "id": "c",
      "nextId": 2,
      "pending": [
       {
        "id": 1,
        "key": "a",
        "method": "A.one"
       }
      ],
      "closing": false
     },
     "expect": {
      "emits": [
       {
        "event": "CDP_STRAY",
        "payload": {
         "reason": "timer-without-command"
        }
       }
      ],
      "neverEmits": [
       "CDP_ERROR"
      ],
      "entity": {
       "pending": [
        {
         "id": 1,
         "key": "a",
         "method": "A.one"
        }
       ]
      }
     }
    }
   ]
