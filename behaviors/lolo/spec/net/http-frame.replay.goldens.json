    {
      "id": "a-provider-event-stream-delivers-each-chunk-json-whole",
      "steps": [
        {
          "event": "FRAME_RUN",
          "payload": {
            "key": "k2",
            "stream": "sse",
            "data": "",
            "final": false
          },
          "expect": {
            "emits": [
              {
                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k2",
                  "data": "{\"id\":\"1835\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\"Hi\"},\"logprobs\":null,\"finish_reason\":null}]}"
                }
              },
              {
                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k2",
                  "data": "{\"id\":\"1835\",\"object\":\"chat.completion.chunk\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\" there\"},\"logprobs\":null,\"finish_reason\":null}]}"
                }
