                }
              },
              {
                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k1",
                  "data": "b"
                }
              },
              {
                "event": "FRAME_DRAINED",
                "payload": {
                  "key": "k1",
                  "rest": ""
                }
              }
            ],
            "neverEmits": [
              "FRAME_FAILED"
            ],
            "emitCounts": {
              "FRAME_EVENT": 2
            }
          }
        }
      ]
    },
    {
