{
  "atom": "net/atoms/std-http-frame.lolo",
  "trait": "HttpFrame",
  "spec": "spec/net/http-frame.lolo",
  "note": "parity oracle: the retired drivers/http_request stream framing, carried by the http-client twin cases (event stream, json lines, non-UTF-8, multibyte) before the framer was extracted",
  "cases": [
    {
      "id": "an-event-stream-delivers-each-complete-block-and-skips-comments",
      "steps": [
        {
          "event": "FRAME_RUN",
          "payload": {
            "key": "k1",
            "stream": "sse",
            "data": "ZGF0YTogb25lCgpldmVudDogcGluZwppZDogNwpkYXRhOiB0d28KZGF0YTogbGluZXMKCjogY29tbWVudAoK",
            "final": false
          },
          "expect": {
            "emits": [
              {
                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k1",
                  "data": "one"
                }
              },
              {
                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k1",
                  "data": "two\nlines",
                  "event": "ping",
                  "id": "7"
                }
              },
              {
                "event": "FRAME_DRAINED",
                "payload": {
                  "key": "k1",
                  "rest": ""
                }
              }
            ],
            "neverEmits": [
              "FRAME_FAILED"
            ],
            "emitCounts": {
              "FRAME_EVENT": 2
            }
          }
        }
      ]
    },
    {
      "id": "an-unterminated-event-block-is-drained-until-final-closes-it",
      "steps": [
        {
          "event": "FRAME_RUN",
          "payload": {
            "key": "k1",
            "stream": "sse",
            "data": "ZGF0YTogdGFpbA==",
            "final": false
          },
          "expect": {
            "emits": [
              {
                "event": "FRAME_DRAINED",
                "payload": {
                  "key": "k1",
                  "rest": "ZGF0YTogdGFpbA=="
                }
              }
            ],
            "neverEmits": [
              "FRAME_EVENT",
              "FRAME_FAILED"
            ]
          }
        },
        {
          "event": "FRAME_RUN",
          "payload": {
            "key": "k1",
            "stream": "sse",
            "data": "ZGF0YTogdGFpbA==",
            "final": true
          },
          "expect": {
            "emits": [
              {
                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k1",
                  "data": "tail"
                }
              },
              {
                "event": "FRAME_DRAINED",
                "payload": {
                  "key": "k1",
                  "rest": ""
                }
              }
            ],
            "neverEmits": [
              "FRAME_FAILED"
            ]
          }
        }
      ]
    },
    {
      "id": "control-final-on-an-empty-rest-delivers-nothing",
      "steps": [
        {
          "event": "FRAME_RUN",
          "payload": {
            "key": "k1",
            "stream": "sse",
            "data": "",
            "final": true
          },
          "expect": {
            "emits": [
              {
                "event": "FRAME_DRAINED",
                "payload": {
                  "key": "k1",
                  "rest": ""
                }
              }
            ],
            "neverEmits": [
              "FRAME_EVENT",
              "FRAME_FAILED"
            ]
          }
        }
      ]
    },
