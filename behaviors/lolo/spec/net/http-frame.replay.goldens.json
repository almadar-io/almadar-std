                "event": "FRAME_EVENT",
                "payload": {
                  "key": "k1",
                  "data": "{\"c\":3}"
                }
              },
              {
                "event": "FRAME_DRAINED",
                "payload": {
                  "key": "k1",
                  "rest": ""
                }
              }
            ],
            "neverEmits": [
