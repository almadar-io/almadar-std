  },
  {
   "id": "dynamic-host-on-a-kept-alive-socket-is-closed-and-a-new-one-opened-when-the-call-names-another-host",
   "config": {
    "host": "*.notify.windows.com",
    "port": 80,
    "tls": false,
    "dynamicHost": true
   },
   "steps": [
    {
     "event": "HTTP_SEND",
     "from": "ready",
     "entity": {
      "idle": 5,
      "hostText": "a.notify.windows.com"
     },
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/x",
      "headers": [],
      "body": "",
      "stream": "none",
      "host": "b.notify.windows.com"
     },
     "expect": {
      "state": "connecting",
      "effects": [
       {
        "type": "os/close",
        "arg0": "@entity.idle"
       },
       {
        "type": "os/tcp-connect",
        "arg0": "@entity.hostText",
        "arg1": [
         "let",
         [
          [
           "knob_port",
           80,
           "{\"version\":1,\"type\":{\"kind\":\"number\"}}"
          ]
         ],
         "@knob_port"
        ]
       }
      ],
      "emits": [
       {
        "event": "HC_BUILT",
        "payload": {
         "request": "R0VUIC94IEhUVFAvMS4xDQpob3N0OiBiLm5vdGlmeS53aW5kb3dzLmNvbQ0KDQo="
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-dynamic-host-on-a-kept-alive-socket-is-reused-when-the-call-names-the-same-host",
   "config": {
    "host": "*.notify.windows.com",
    "port": 80,
    "tls": false,
    "dynamicHost": true
   },
   "steps": [
    {
     "event": "HTTP_SEND",
     "from": "ready",
     "entity": {
      "idle": 5,
      "hostText": "a.notify.windows.com"
     },
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/x",
      "headers": [],
      "body": "",
      "stream": "none",
      "host": "a.notify.windows.com"
     },
     "expect": {
      "state": "sending"
     }
    }
   ]
  },
