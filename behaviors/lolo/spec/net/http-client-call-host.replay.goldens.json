{
 "atom": "net/atoms/std-http-client.lolo",
 "trait": "HttpClient",
 "spec": "spec/net/http-client.lolo",
 "note": "G-ORBITAL-CORE-096: the dynamicHost knob (default false). On, a call that carries host connects to that host and uses it for the host header and the TLS server name (a separate guarded arm; the only computed os/tcp-connect target, covered by a pattern net grant), a call without host is refused, and a kept-alive socket serves only the host it was opened for. Off, a call's host is ignored and the host knob stays the connect target, host header and server name.",
 "cases": [
  {
   "id": "dynamic-host-on-a-call-host-is-the-connect-target-the-host-header-and-the-tls-server-name",
   "config": {
    "host": "*.notify.windows.com",
    "port": 443,
    "tls": true,
    "dynamicHost": true
   },
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/x",
      "headers": [],
      "body": "",
      "stream": "none",
      "host": "push.notify.windows.com"
     },
     "expect": {
      "state": "connecting",
      "effects": [
       {
        "type": "os/tcp-connect",
        "arg0": "@entity.hostText",
        "arg1": [
         "let",
         [
          [
           "knob_port",
           443,
           "{\"version\":1,\"type\":{\"kind\":\"number\"}}"
          ]
         ],
         "@knob_port"
        ],
        "arg2": {
         "serverName": "@entity.hostText",
         "alpn": [
          "list",
          "http/1.1"
         ]
        }
       }
      ],
      "emits": [
       {
        "event": "HC_BUILT",
        "payload": {
         "request": "R0VUIC94IEhUVFAvMS4xDQpob3N0OiBwdXNoLm5vdGlmeS53aW5kb3dzLmNvbQ0KDQo="
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "dynamic-host-on-a-call-host-on-a-port-that-is-not-the-default-writes-host-colon-port",
   "config": {
    "host": "*.notify.windows.com",
    "port": 9000,
    "tls": false,
    "dynamicHost": true
   },
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/x",
      "headers": [],
      "body": "",
      "stream": "none",
      "host": "eu.notify.windows.com"
     },
     "expect": {
      "state": "connecting",
      "effects": [
       {
        "type": "os/tcp-connect",
        "arg0": "@entity.hostText",
        "arg1": [
         "let",
         [
          [
           "knob_port",
           9000,
           "{\"version\":1,\"type\":{\"kind\":\"number\"}}"
          ]
         ],
         "@knob_port"
        ]
       }
      ],
      "emits": [
       {
        "event": "HC_BUILT",
        "payload": {
         "request": "R0VUIC94IEhUVFAvMS4xDQpob3N0OiBldS5ub3RpZnkud2luZG93cy5jb206OTAwMA0KDQo="
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "dynamic-host-off-a-call-host-is-ignored-the-knob-host-is-the-connect-target-the-host-header-and-the-tls-server-name",
   "config": {
    "host": "api.example.test",
    "port": 443,
    "tls": true,
    "serverName": "api.example.test"
   },
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/x",
      "headers": [],
      "body": "",
      "stream": "none",
      "host": "other.example"
     },
     "expect": {
      "state": "connecting",
      "effects": [
       {
        "type": "os/tcp-connect",
        "arg0": [
         "let",
         [
          [
           "knob_host",
           "api.example.test",
           "{\"version\":1,\"type\":{\"kind\":\"union\",\"variants\":[{\"name\":\"string\",\"fieldType\":{\"kind\":\"string\"},\"required\":true,\"constraints\":[],\"declared\":{\"nullable\":false,\"name\":\"string\",\"type\":\"string\"}},{\"name\":\"HttpEnvPart\",\"fieldType\":{\"kind\":\"struct\",\"fields\":[{\"name\":\"anchor\",\"fieldType\":{\"kind\":\"struct\",\"fields\":[{\"name\":\"env\",\"fieldType\":{\"kind\":\"string\"},\"required\":true,\"constraints\":[],\"declared\":{\"nullable\":false,\"name\":\"env\",\"type\":\"string\",\"required\":true}}]},\"required\":true,\"constraints\":[],\"declared\":{\"nullable\":false,\"name\":\"anchor\",\"type\":\"object\",\"required\":true,\"properties\":{\"env\":{\"nullable\":false,\"name\":\"env\",\"type\":\"string\",\"required\":true}}}}]},\"required\":true,\"constraints\":[],\"declared\":{\"nullable\":false,\"name\":\"HttpEnvPart\",\"type\":\"object\",\"properties\":{\"anchor\":{\"nullable\":false,\"name\":\"anchor\",\"type\":\"object\",\"required\":true,\"properties\":{\"env\":{\"nullable\":false,\"name\":\"env\",\"type\":\"string\",\"required\":true}}}}}}]}}"
          ]
         ],
         "@knob_host"
        ],
        "arg1": [
         "let",
         [
          [
           "knob_port",
           443,
           "{\"version\":1,\"type\":{\"kind\":\"number\"}}"
          ]
         ],
         "@knob_port"
        ],
        "arg2": {
         "serverName": [
          "if",
          [
           "validate/string",
           "api.example.test"
          ],
          "api.example.test",
          "@entity.hostText"
         ],
         "alpn": [
          "list",
          "http/1.1"
         ]
        }
       }
      ],
      "emits": [
       {
        "event": "HC_BUILT",
        "payload": {
         "request": "R0VUIC94IEhUVFAvMS4xDQpob3N0OiBhcGkuZXhhbXBsZS50ZXN0DQoNCg=="
        }
       }
      ]
     }
    }
   ]
  },
  {
