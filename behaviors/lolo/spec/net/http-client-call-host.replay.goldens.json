        ]
       }
      ],
      "emits": [
       {
        "event": "HC_BUILT",
        "payload": {
         "request": "R0VUIC94IEhUVFAvMS4xDQpob3N0OiBhcGkuZXhhbXBsZS50ZXN0DQoNCg=="
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "dynamic-host-on-with-no-host-is-refused-before-any-socket-opens",
   "config": {
    "host": "*.notify.windows.com",
    "port": 443,
    "tls": true,
    "dynamicHost": true
   },
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/x",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "HTTP_FAILED",
        "payload": {
         "key": "k1",
         "kind": "refused"
        }
       }
      ],
      "neverEmits": [
       "HC_BUILT"
      ]
     }
    }
   ]
  },
  {
