{
  "atom": "net/atoms/std-npm-lookup.lolo",
  "trait": "NpmLookup",
  "cases": [
    {
      "id": "lookup-lists-ascending-with-dist-tags-and-latest",
      "steps": [
        {
          "event": "NPM_LOOKUP",
          "payload": {
            "requestId": "r1",
            "name": "@almadar/core"
          },
          "expect": {
            "emits": [
              {
                "event": "NPM_LOOKUP_GET",
                "payload": {
                  "requestId": "r1"
                }
              }
            ]
          }
        },
        {
          "event": "NPM_LOOKUP_PACKUMENT",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "{\"name\": \"@almadar/core\", \"versions\": {\"1.10.0\": {\"dist\": {\"tarball\": \"https://registry.npmjs.org/@almadar/core/-/core-1.10.0.tgz\"}}, \"1.2.0\": {\"dist\": {\"tarball\": \"https://registry.npmjs.org/@almadar/core/-/core-1.2.0.tgz\"}}, \"1.9.3\": {\"dist\": {\"tarball\": \"https://registry.npmjs.org/@almadar/core/-/core-1.9.3.tgz\"}}, \"0.9.0\": {\"dist\": {\"tarball\": \"https://registry.npmjs.org/@almadar/core/-/core-0.9.0.tgz\"}}}, \"dist-tags\": {\"latest\": \"1.10.0\"}}",
            "key": "lookup"
          },
          "from": "looking",
          "expect": {
            "emits": [
              {
                "event": "NPM_LOOKED",
                "payload": {
                  "requestId": "r1",
                  "name": "@almadar/core",
                  "versions": [
                    "0.9.0",
                    "1.2.0",
                    "1.9.3",
                    "1.10.0"
                  ],
                  "distTags": {
                    "latest": "1.10.0"
                  },
                  "version": "1.10.0",
                  "tarballs": {
                    "0.9.0": "https://registry.npmjs.org/@almadar/core/-/core-0.9.0.tgz",
                    "1.2.0": "https://registry.npmjs.org/@almadar/core/-/core-1.2.0.tgz",
                    "1.9.3": "https://registry.npmjs.org/@almadar/core/-/core-1.9.3.tgz",
                    "1.10.0": "https://registry.npmjs.org/@almadar/core/-/core-1.10.0.tgz"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "lookup-named-tag-resolves-its-version",
      "steps": [
        {
          "event": "NPM_LOOKUP",
          "payload": {
            "requestId": "r1",
            "name": "@almadar/core",
            "tag": "next"
          },
          "expect": {
            "emits": [
              {
                "event": "NPM_LOOKUP_GET",
                "payload": {
                  "requestId": "r1"
                }
              }
            ]
          }
        },
        {
          "event": "NPM_LOOKUP_PACKUMENT",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "{\"versions\":{\"1.0.0\":{},\"2.0.0-rc.1\":{}},\"dist-tags\":{\"latest\":\"1.0.0\",\"next\":\"2.0.0-rc.1\"}}",
            "key": "lookup"
          },
          "from": "looking",
          "expect": {
            "emits": [
              {
                "event": "NPM_LOOKED",
                "payload": {
                  "requestId": "r1",
                  "version": "2.0.0-rc.1",
                  "versions": [
                    "1.0.0",
                    "2.0.0-rc.1"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
