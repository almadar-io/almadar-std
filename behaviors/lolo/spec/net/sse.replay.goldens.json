{
 "atom": "net/atoms/std-sse.lolo",
 "trait": "Sse",
 "note": "Design contract spec/net/sse.lolo. RESPOND_CHUNK bodies are bytes, which a step answers as base64 of the frame text.",
 "cases": [
  {
   "id": "open-writes-the-event-stream-head",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_OPEN",
     "payload": {
      "requestId": 5
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "RESPOND_HEAD",
        "payload": {
         "requestId": 5,
         "status": 200,
         "headers": [
          {
           "name": "content-type",
           "value": "text/event-stream"
          },
          {
           "name": "cache-control",
           "value": "no-cache"
          },
          {
           "name": "x-accel-buffering",
           "value": "no"
          }
         ]
        }
       },
       {
        "event": "RESPOND_CHUNK",
        "payload": {
         "requestId": 5,
         "body": "cmV0cnk6IDMwMDAKCg=="
        }
       }
      ]
     }
    }
   ],
   "entity": {
    "open": []
   }
  },
  {
   "id": "send-to-an-open-stream-writes-a-frame",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_SEND",
     "payload": {
      "requestId": 5,
      "data": "hello"
     },
     "expect": {
      "emits": [
       {
        "event": "RESPOND_CHUNK",
        "payload": {
         "requestId": 5,
         "body": "ZGF0YTogaGVsbG8KCg=="
        }
       }
      ],
      "neverEmits": [
       "SSE_REFUSED"
      ]
     }
    }
   ],
   "entity": {
    "open": [
     5
    ]
   }
  },
  {
   "id": "send-with-id-event-and-multiline-data-frames-every-line",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_SEND",
     "payload": {
      "requestId": 5,
      "event": "tick",
      "id": "7",
      "data": "a\nb"
     },
     "expect": {
      "emits": [
       {
        "event": "RESPOND_CHUNK",
        "payload": {
         "requestId": 5,
         "body": "aWQ6IDcKZXZlbnQ6IHRpY2sKZGF0YTogYQpkYXRhOiBiCgo="
        }
       }
      ]
     }
    }
   ],
   "entity": {
    "open": [
     5
    ]
   },
   "note": "spec: SSE_SEND { event: tick, id: 7, data: a newline b }"
  },
  {
   "id": "control-send-to-a-stream-never-opened-is-refused-closed",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_SEND",
     "payload": {
      "requestId": 9,
      "data": "x"
     },
     "expect": {
      "emits": [
       {
        "event": "SSE_REFUSED",
        "payload": {
         "requestId": 9,
         "kind": "closed",
         "error": "no open stream has this id"
        }
       }
      ],
      "neverEmits": [
       "RESPOND_CHUNK"
      ]
     }
    }
   ],
   "entity": {
    "open": [
     5
    ]
   }
  },
  {
   "id": "send-with-cr-in-data-is-refused-invalid",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_SEND",
     "payload": {
      "requestId": 5,
      "data": "a\rb"
     },
     "expect": {
      "emits": [
       {
        "event": "SSE_REFUSED",
        "payload": {
         "requestId": 5,
         "kind": "invalid",
         "error": "event and id take no CR or LF, id no NUL, data no CR"
        }
       }
      ],
      "neverEmits": [
       "RESPOND_CHUNK"
      ]
     }
    }
   ],
   "entity": {
    "open": [
     5
    ]
   }
  },
  {
   "id": "send-with-lf-in-event-is-refused-invalid",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_SEND",
     "payload": {
      "requestId": 5,
      "data": "x",
      "event": "a\nb"
     },
     "expect": {
      "emits": [
       {
        "event": "SSE_REFUSED",
        "payload": {
         "requestId": 5,
         "kind": "invalid",
         "error": "event and id take no CR or LF, id no NUL, data no CR"
        }
       }
      ],
      "neverEmits": [
       "RESPOND_CHUNK"
      ]
     }
    }
   ],
   "entity": {
