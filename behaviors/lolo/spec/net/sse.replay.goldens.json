       {
        "event": "SSE_CLOSED",
        "payload": {
         "requestId": 5,
         "reason": "client"
        }
       }
      ],
      "neverEmits": [
       "RESPOND_CHUNK",
       "RESPOND_END"
      ]
     }
    }
   ],
   "entity": {
    "open": [
     5
    ]
