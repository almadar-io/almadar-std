  },
  {
   "id": "send-with-nul-in-id-is-refused-invalid",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_SEND",
     "payload": {
      "requestId": 5,
      "data": "x",
      "id": "a\u0000b"
     },
     "expect": {
      "emits": [
       {
        "event": "SSE_REFUSED",
        "payload": {
         "requestId": 5,
         "kind": "invalid",
         "error": "event and id take no CR or LF, id no NUL, data no CR"
        }
       }
      ],
      "neverEmits": [
       "RESPOND_CHUNK"
      ]
     }
    }
   ],
   "entity": {
    "open": [
