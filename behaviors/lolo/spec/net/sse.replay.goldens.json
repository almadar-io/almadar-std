  {
   "id": "close-ends-the-stream-and-reports-server",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_CLOSE",
     "payload": {
      "requestId": 5
     },
     "expect": {
      "emits": [
       {
        "event": "RESPOND_END",
        "payload": {
         "requestId": 5
        }
       },
       {
        "event": "SSE_CLOSED",
        "payload": {
         "requestId": 5,
         "reason": "server"
        }
       }
      ]
     }
    }
   ],
   "entity": {
    "open": [
     5
    ]
   }
  },
  {
   "id": "control-close-of-a-stream-not-open-does-nothing",
   "steps": [
    {
     "from": "serving",
     "event": "SSE_CLOSE",
     "payload": {
      "requestId": 9
     },
     "expect": {
