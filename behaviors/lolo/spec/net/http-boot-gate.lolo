app http-boot-gate-spec [
  version: "1.0.0",
  description: "Design contract for the boot gate of the HTTP server program, the twin of the orbital-server boot path that reads the process environment, asks boot_env_problems what keeps the deployment from working and, under NODE_ENV=production, refuses to start while any problem stands (elsewhere each problem is only a warning). At INIT the gate reads the declared environment variables one at a time with os/getenv (NODE_ENV, AUTH_PROVIDER, OIDC_ISSUER_URL, OIDC_AUDIENCE, FIREBASE_PROJECT_ID, FIREBASE_SERVICE_ACCOUNT_PATH, FIREBASE_AUTH_EMULATOR_HOST, FIRESTORE_EMULATOR_HOST, ALMADAR_INTEGRATIONS_MODE, USE_MOCK_DATA), an unset one reading as blank, and when the last is read emits ENV_CHECK { env, production, mock } for std-boot-env-check: production is NODE_ENV equal to production, mock is the mock knob or ALMADAR_INTEGRATIONS_MODE equal to mock or USE_MOCK_DATA equal to true. It hears ENV_CHECKED { problems, ok } and CORS_CONFIGURED (the policy has read its origins); once it has heard both and the deployment is cleared it emits BOOT_CLEARED, which tells std-http1 to bind. Under production a non-empty problems list emits BOOT_REFUSED { problems } and BOOT_CLEARED is never emitted; outside production a non-empty list emits BOOT_WARNED { problems } and the boot is cleared. An environment variable the grant does not let the gate read emits BOOT_REFUSED with the reason and the boot never clears. When services are declared and integrations are not mocked, the gate reads credential-list, asks std-credential-admin CRED_ADMIN_BOOT_CHECK { catalog, services, held } (catalog grouped from the entries by service, held the configured env vars) and sends the owed lines as missingCredentials; an unreadable catalog is notified and sent as catalogError. The called services are the calledServices knob until std-orb-ir-calls derives them from the hosted program. Goldens: spec/net/http-boot-gate.replay.goldens.json."
]

type GateVar = { name : string!, value : string! }

orbital HttpBootGateSpec {
  expects entity BootRun [runtime] {
    id : string!
    read : [GateVar] = []
  }
  expects trait BootGate {
    state reading {
      READ_NODE_ENV -> reading
      READ_AUTH_PROVIDER -> reading
      READ_OIDC_ISSUER_URL -> reading
      READ_OIDC_AUDIENCE -> reading
      READ_FIREBASE_PROJECT_ID -> reading
      READ_FIREBASE_SERVICE_ACCOUNT_PATH -> reading
      READ_FIREBASE_AUTH_EMULATOR_HOST -> reading
      READ_FIRESTORE_EMULATOR_HOST -> reading
      READ_ALMADAR_INTEGRATIONS_MODE -> reading
      READ_USE_MOCK_DATA -> reading
      ENV_COLLECTED -> reading
      CRED_LISTED -> reading
      CRED_UNLISTED -> reading
      CRED_ADMIN_OWED -> reading
      ENV_ASK -> reading
      ENV_UNREAD -> refused
      ENV_CHECKED -> reading
      CORS_CONFIGURED -> reading
    }
    state refused {
      ENV_CHECKED -> refused
      CORS_CONFIGURED -> refused
    }
    emits {
      ENV_ASK { missing : [string]!  error : string! }
      CRED_ADMIN_BOOT_CHECK { services : [string]!  held : [string]! }
      ENV_CHECK { env : Map string string!  production : boolean!  mock : boolean!  missingCredentials : [string]  catalogError : string }
      BOOT_CLEARED { }
      BOOT_WARNED { problems : [string]! }
      BOOT_REFUSED { problems : [string]! }
    }
  }
  expects page "/boot-gate" -> BootGate
}
