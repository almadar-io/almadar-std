{
 "atom": "net/atoms/std-http-policy.lolo",
 "trait": "HttpPolicy",
 "note": "Design contract spec/net/http-policy.lolo; Rust twin orbital-server src/http_layers.rs tests. Every case seeds corsOrigins [https://a.app] (the http_layers.rs policy).",
 "cases": [
  {
   "id": "api-answer-carries-cors-grant-and-security-headers",
   "entity": {
    "corsOrigins": [
     "https://a.app"
    ]
   },
   "steps": [
    {
     "from": "idle",
     "event": "HTTP_DECIDE",
     "payload": {
      "requestId": 7,
      "method": "GET",
      "path": "/api/x",
      "headers": [
       {
        "name": "origin",
        "value": "https://a.app"
       }
      ]
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "HTTP_DECIDED",
        "payload": {
         "requestId": 7,
         "verdict": "ok",
         "status": 200,
         "responseHeaders": [
          {
           "name": "access-control-allow-origin",
           "value": "https://a.app"
          },
          {
           "name": "access-control-allow-credentials",
           "value": "true"
          },
          {
           "name": "vary",
           "value": "origin, access-control-request-method, access-control-request-headers"
          },
          {
           "name": "content-security-policy",
           "value": "default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests"
          },
          {
           "name": "cross-origin-opener-policy",
           "value": "same-origin"
          },
          {
           "name": "cross-origin-resource-policy",
           "value": "same-origin"
          },
          {
           "name": "origin-agent-cluster",
           "value": "?1"
          },
          {
           "name": "referrer-policy",
           "value": "no-referrer"
          },
          {
           "name": "strict-transport-security",
           "value": "max-age=31536000; includeSubDomains"
          },
          {
           "name": "x-content-type-options",
           "value": "nosniff"
          },
          {
           "name": "x-dns-prefetch-control",
           "value": "off"
          },
          {
           "name": "x-download-options",
           "value": "noopen"
          },
          {
           "name": "x-frame-options",
           "value": "SAMEORIGIN"
          },
          {
           "name": "x-permitted-cross-domain-policies",
           "value": "none"
          },
          {
           "name": "x-xss-protection",
           "value": "0"
          }
         ],
         "compress": "none"
        }
       }
      ]
     }
    }
   ],
   "note": "http_layers.rs api_answers_carry_the_security_headers_and_the_cors_grant_and_a_page_does_not"
  },
