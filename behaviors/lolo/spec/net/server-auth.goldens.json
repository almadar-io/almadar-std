{
  "source": "orbital-rust/crates/orbital-core/crates/runtime/src/auth.rs (WithApiKeys, authenticate_bearer, sign_in_from_env)",
  "spec": "spec/net/server.lolo",
  "program": "net/organisms/std-http-server.lolo",
  "run": "orb execute <program> --steps <case.steps>",
  "note": "Host-backed parity cases: the kernel has no HTTP or credential host under execute, so the JWKS fetch and the scrypt hash are journaled out; the verdict steps are played from the state the host leaves (from). The key-row requestId echoes 0 for steps played from looking because the entity is not seedable.",
  "cases": [
    {
      "id": "key-passes",
      "ref": "auth.rs WithApiKeys::verify (key branch)",
      "steps": [
        {
          "trait": "ApiKeys",
          "event": "KEY_FOUND",
          "payload": {
            "data": {
              "id": "h",
              "owner": "svc-1",
              "label": "ci",
              "revoked": false,
              "expiresAt": 0
            }
          },
          "from": "looking"
        }
      ],
      "expect": {
        "emits": [
          [
            "ApiKeys",
            "API_KEY_VERIFIED",
            {
              "owner": "svc-1",
              "claims": [
                {
                  "name": "label",
                  "value": "ci"
                }
              ]
            }
          ],
          [
            "ServerBearer",
            "BEARER_VERIFIED",
            {
              "viewer": {
                "id": "svc-1",
                "claims": [
                  {
                    "name": "label",
                    "value": "ci"
                  }
                ]
              }
            }
          ]
        ]
      }
    },
    {
      "id": "jwt-control",
      "ref": "auth.rs WithApiKeys::verify (sign-in branch)",
      "steps": [
        {
          "trait": "ServerBearer",
          "event": "KEY_SALT_READ",
          "payload": {
            "value": "00112233445566778899aabbccddeeff"
          }
        },
        {
          "trait": "ServerBearer",
          "event": "BEARER_VERIFY",
          "payload": {
            "requestId": 8,
            "authorization": "Bearer eyJhbGciOiJSUzI1NiIsImtpZCI6ImsifQ.e30.sig"
          }
        },
        {
          "trait": "ServerBearer",
          "event": "JWS_VERIFIED",
          "payload": {
            "header": {
              "alg": "RS256"
            },
            "payload": {
              "iss": "",
              "sub": "u1",
              "aud": "",
              "exp": 9999999999,
              "extra": {}
            }
          },
          "from": "verifying"
        }
      ],
      "expect": {
        "neverEmits": [
          "VERIFY_KEY"
        ],
        "emits": [
          [
            "ServerBearer",
            "BEARER_VERIFIED",
            {
              "viewer": {
                "id": "u1",
                "role": null,
                "permissions": null,
                "claims": []
              }
            }
          ]
        ],
        "note": "BEARER_VERIFY routes to the JWT path (fetching, keys fetched); the kernel has no HTTP host so the fetch step is journaled and JWS_VERIFIED is played from verifying"
      }
    },
    {
      "id": "bad-key-401",
      "ref": "auth.rs authenticate_bearer: refused -> 401 Unauthorized",
      "steps": [
        {
          "trait": "ApiKeys",
          "event": "KEY_ABSENT",
          "payload": {
            "code": "not-found",
            "error": "nf"
          },
          "from": "looking"
        }
      ],
      "expect": {
        "emits": [
          [
            "ApiKeys",
            "API_KEY_REFUSED",
            {
              "reason": "unknown"
            }
          ],
          [
            "ServerBearer",
            "BEARER_REFUSED",
            {
              "reason": "api-key-unknown"
            }
          ]
        ],
        "router401": {
          "status": 401,
          "body": {
            "error": "Unauthorized",
            "code": "UNAUTHORIZED"
          }
        }
      }
    },
    {
      "id": "key-with-keys-disabled",
      "ref": "auth.rs sign_in_from_env: keys only with ALMADAR_API_KEY_SALT",
      "steps": [
        {
          "trait": "ServerBearer",
          "event": "BEARER_VERIFY",
          "payload": {
            "requestId": 9,
            "authorization": "Bearer sk_live_abcdef"
          }
        }
      ],
      "expect": {
        "neverEmits": [
          "VERIFY_KEY",
          "JWS_VERIFY"
        ],
        "emits": [
          [
            "ServerBearer",
            "BEARER_REFUSED",
            {
              "requestId": 9,
              "reason": "keys-disabled"
            }
          ]
        ]
      }
    },
    {
      "id": "lowercase-bearer-not-widened",
      "ref": "auth.rs BEARER_PREFIX exact-case",
      "steps": [
        {
          "trait": "ServerBearer",
          "event": "KEY_SALT_READ",
          "payload": {
            "value": "00112233445566778899aabbccddeeff"
          }
        },
        {
          "trait": "ServerBearer",
          "event": "BEARER_VERIFY",
          "payload": {
            "requestId": 10,
            "authorization": "bearer sk_live_abcdef"
          }
        }
      ],
      "expect": {
        "neverEmits": [
          "VERIFY_KEY"
        ],
        "emits": [
          [
            "ServerBearer",
            "BEARER_REFUSED",
            {
              "requestId": 10,
              "reason": "malformed"
            }
          ]
        ]
      }
    }
  ]
}