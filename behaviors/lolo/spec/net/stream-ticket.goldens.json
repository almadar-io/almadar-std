{
  "source": "packages/almadar-auth/test/fixtures/stream-tickets.json (almadar-server stream-tickets.test.ts; orbital-server events_wire.rs)",
  "spec": "spec/net/stream-ticket.lolo",
  "atom": "net/atoms/std-stream-ticket.lolo",
  "note": "Live-stream ticket scenarios both servers run: orbital-server (events_wire.rs live_stream) and the Node servers (almadar-server stream-tickets.test.ts). A bearer of 'nobody' fails verification; any other bearer is that user. expect is the status on every server. A mint with no bearer is an anonymous ticket on every server.",
  "scenarios": [
    {
      "name": "a minted ticket opens the stream once",
      "ttlMs": 60000,
      "steps": [
        {
          "do": "mint",
          "bearer": "alice",
          "expect": 200,
          "keep": "t"
        },
        {
          "do": "open",
          "ticket": "$t",
          "expect": 200
        },
        {
          "do": "open",
          "ticket": "$t",
          "expect": 401
        }
      ]
    },
    {
      "name": "no ticket and a forged ticket are refused",
      "ttlMs": 60000,
      "steps": [
        {
          "do": "open",
          "ticket": null,
          "expect": 401
        },
        {
          "do": "open",
          "ticket": "forged",
          "expect": 401
        }
      ]
    },
    {
      "name": "an expired ticket is refused",
      "ttlMs": 50,
      "steps": [
        {
          "do": "mint",
          "bearer": "alice",
          "expect": 200,
          "keep": "t"
        },
        {
          "do": "sleep",
          "ms": 120
        },
        {
          "do": "open",
          "ticket": "$t",
          "expect": 401
        }
      ]
    },
    {
      "name": "a bearer that is present must verify; none is the anonymous viewer",
      "ttlMs": 60000,
      "steps": [
        {
          "do": "mint",
          "bearer": "nobody",
          "expect": 401
        },
        {
          "do": "mint",
          "bearer": null,
          "expect": 200
        }
      ]
    },
    {
      "name": "two viewers hold two tickets, each opens once",
      "ttlMs": 60000,
      "steps": [
        {
          "do": "mint",
          "bearer": "alice",
          "expect": 200,
          "keep": "a"
        },
        {
          "do": "mint",
          "bearer": "bob",
          "expect": 200,
          "keep": "b"
        },
        {
          "do": "open",
          "ticket": "$b",
          "expect": 200
        },
        {
          "do": "open",
          "ticket": "$a",
          "expect": 200
        },
        {
          "do": "open",
          "ticket": "$a",
          "expect": 401
        }
      ]
    }
  ],
  "counts": {
    "scenarios": 5
  }
}
