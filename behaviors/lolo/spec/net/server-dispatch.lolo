app server-dispatch-spec [
  version: "1.0.0",
  description: "Design contract for the dispatch routes of the HTTP server program, bound by net/atoms/std-http-dispatch: dispatch, inputs, row resolution, hooks and the bearer guard (401 UNAUTHORIZED). POST /api/orbitals/resolve-rows accepts { ref }, resolves it through program/resolve-rows for the verified viewer (explicit null for anonymous), and answers { rows, total }; host resolution failures answer 500 RESOLVE_ROWS_ERROR. Tick, stream tickets and static files are owned by std-http-router, std-stream-ticket and std-static-files. Routes: GET /api/orbitals, /api/orbitals/:name, /api/orbitals/:name/state, /api/stats, /api/trace, /api/orbitals/inputs, /api/push/vapid-public-key, /api/events (SSE, needs a ticket); POST /api/orbitals/:orbital/events, /api/orbitals/:orbital/traits/:trait/entities/:id/events, /api/orbitals/:orbital/inputs, /api/orbitals/resolve-rows, /api/events/ticket, /api/hooks/:name, /api/tick. Every dispatch route except the ticket needs a verified bearer; the ticket route admits the anonymous viewer; hooks, tick, push and health are outside the guard. Any other path is a static file, never under /api or /__."
]

type ServerHeader = { name : string!, value : string! }
type ServerErrorBody = { error : string!, code : string! }

orbital ServerDispatchSpec {
  expects entity HttpServerProgram [runtime] {
    id : string!
  }
  expects trait ServerDispatch {
    emits {
      REQUEST_UNAUTHORIZED { requestId : number!  error : ServerErrorBody! }
      DISPATCH_REQUESTED { requestId : number!  orbital : string!  traitName : string  entityId : string  event : string!  payload : string  clientId : string  locale : string  stream : boolean!  viewer : Viewer }
      INPUT_REQUESTED { requestId : number!  orbital : string!  traitName : string!  entityId : string  event : string!  payload : string  stream : boolean!  viewer : Viewer }
      RESOLVE_ROWS_REQUESTED { requestId : number!  reference : string!  viewer : Viewer }
      HOOK_DELIVERED { requestId : number!  name : string!  headers : [ServerHeader]  body : bytes! }
    }
  }
  expects page "/server" -> ServerDispatch
}
