{
 "atom": "net/atoms/std-npm-registry.lolo",
 "trait": "NpmRegistry",
 "cases": [
  {
   "id": "versions-listed-ascending-with-dist-tags",
   "steps": [
    {
     "event": "NPM_VERSIONS",
     "payload": {
      "name": "@almadar/core"
     },
     "expect": {
      "emits": [
       {
        "event": "NPM_GET",
        "payload": {
         "kind": "versions"
        }
       }
      ]
     }
    },
    {
     "event": "NPM_GET",
     "payload": {
      "kind": "versions"
     },
     "from": "listing"
    },
    {
     "event": "NPM_PACKUMENT_READ",
     "payload": {
      "requestId": "versions",
      "name": "@almadar/core",
      "versions": [
       "0.9.0",
       "1.2.0",
       "1.9.3",
       "1.10.0"
      ],
      "distTags": {
       "latest": "1.10.0"
      },
      "version": "",
      "tarballs": {
       "1.10.0": "https://registry.npmjs.org/@almadar/core/-/core-1.10.0.tgz",
       "1.2.0": "https://registry.npmjs.org/@almadar/core/-/core-1.2.0.tgz",
       "1.9.3": "https://registry.npmjs.org/@almadar/core/-/core-1.9.3.tgz",
       "0.9.0": "https://registry.npmjs.org/@almadar/core/-/core-0.9.0.tgz"
      }
     },
     "from": "listing",
     "expect": {
      "emits": [
       {
        "event": "NPM_VERSIONS_LISTED",
        "payload": {
         "name": "@almadar/core",
         "versions": [
          "0.9.0",
          "1.2.0",
          "1.9.3",
          "1.10.0"
         ],
         "tags": {
          "latest": "1.10.0"
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-versions-404-is-absent-not-an-empty-list",
   "steps": [
    {
     "event": "NPM_VERSIONS",
     "payload": {
      "name": "@almadar/core"
     }
    },
    {
     "event": "NPM_PACKUMENT_REFUSED",
     "payload": {
      "requestId": "versions",
      "name": "@almadar/core",
      "code": "absent",
      "status": 404,
      "error": "the registry answered 404 for @almadar/core"
     },
     "from": "listing",
     "expect": {
      "emits": [
       {
        "event": "NPM_FAILED",
        "payload": {
         "name": "@almadar/core",
         "code": "absent",
         "status": 404
        }
       }
      ],
      "neverEmits": [
       "NPM_VERSIONS_LISTED"
      ]
     }
    }
   ]
  },
  {
   "id": "next-patch-skips-published-versions",
   "steps": [
    {
     "event": "NPM_NEXT_VERSION",
     "payload": {
      "name": "@almadar/core",
      "current": "1.2.3",
      "bump": "patch"
     },
     "expect": {
      "emits": [
       {
        "event": "NPM_GET",
        "payload": {
         "kind": "next"
        }
       }
      ]
     }
    },
    {
     "event": "NPM_PACKUMENT_READ",
     "payload": {
      "requestId": "next",
      "name": "@almadar/core",
      "versions": [
       "1.2.3",
       "1.2.4",
       "1.2.5"
      ],
      "distTags": {},
      "version": "",
      "tarballs": {
       "1.2.3": "https://registry.npmjs.org/@almadar/core/-/core-1.2.3.tgz",
       "1.2.4": "https://registry.npmjs.org/@almadar/core/-/core-1.2.4.tgz",
       "1.2.5": "https://registry.npmjs.org/@almadar/core/-/core-1.2.5.tgz"
      }
     },
     "from": "listing",
     "expect": {
      "emits": [
       {
        "event": "NPM_NEXT",
        "payload": {
         "name": "@almadar/core",
         "current": "1.2.3",
         "next": "1.2.6",
         "skipped": [
          "1.2.4",
          "1.2.5"
         ]
        }
       }
      ]
     }
    }
   ]
  },
