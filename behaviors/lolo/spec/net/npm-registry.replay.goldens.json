  {
   "id": "wait-visible-then-tarball-downloads-then-visible",
   "steps": [
    {
     "event": "NPM_WAIT",
     "payload": {
      "name": "@almadar/core",
      "version": "3.1.0"
     },
     "expect": {
      "emits": [
       {
        "event": "NPM_WAIT_RETRY_START",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "NPM_WAIT_ATTEMPT",
     "payload": {
      "key": "npm-wait:1",
      "attempt": 1
     },
     "from": "waiting"
    },
    {
     "event": "NPM_PACKUMENT_READ",
     "payload": {
      "requestId": "wait",
      "name": "@almadar/core",
      "versions": [
       "3.1.0"
      ],
      "distTags": {},
      "version": "",
      "tarballs": {
       "3.1.0": "https://registry.npmjs.org/@almadar/core/-/core-3.1.0.tgz"
      }
     },
     "from": "waiting",
     "expect": {
      "emits": [
       {
        "event": "NPM_WAIT_TARBALL",
        "payload": {
         "url": "https://registry.npmjs.org/@almadar/core/-/core-3.1.0.tgz"
        }
       }
      ],
      "neverEmits": [
       "NPM_WAIT_RETRY_FAILED"
      ]
     }
    },
    {
     "event": "NPM_WAIT_TARBALL",
     "payload": {
      "url": "https://registry.npmjs.org/@almadar/core/-/core-3.1.0.tgz"
     },
     "from": "waiting"
    },
    {
     "event": "NPM_WAIT_TARBALL_REPLIED",
     "payload": {
      "status": 206,
      "headers": {},
      "body": "x",
      "key": ""
     },
     "from": "waiting",
     "expect": {
      "emits": [
       {
        "event": "NPM_WAIT_RETRY_SUCCEEDED",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "NPM_WAIT_DONE",
     "payload": {
      "key": "npm-wait:1",
      "attempts": 4
     },
     "from": "waiting",
     "expect": {
      "emits": [
       {
        "event": "NPM_VISIBLE",
        "payload": {
         "name": "@almadar/core",
         "version": "3.1.0",
         "attempts": 4
        }
       }
      ]
     }
    }
   ]
  },
