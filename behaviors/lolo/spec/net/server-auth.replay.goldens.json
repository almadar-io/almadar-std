{
 "atom": "net/organisms/std-http-server.lolo",
 "trait": "ServerBearer",
 "cases": [
  {
   "id": "a-jwt-bearer-never-reaches-the-key-path",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "KEY_SALT_READ",
     "payload": {
      "value": "00112233445566778899aabbccddeeff"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 8,
      "authorization": "Bearer eyJhbGciOiJSUzI1NiIsImtpZCI6ImsifQ.e30.sig"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_PUMP"
       }
      ],
      "neverEmits": [
       "VERIFY_KEY",
       "BEARER_KEY_VERIFIED"
      ]
     }
    }
   ]
  },
  {
   "id": "key-with-keys-disabled",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 9,
      "authorization": "Bearer sk_live_abcdef"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "requestId": 9,
         "reason": "keys-disabled"
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY",
       "BEARER_CHECK"
      ]
     }
    }
   ]
  },
  {
   "id": "key-passes",
   "steps": [
    {
     "trait": "ApiKeys",
     "event": "KEY_FOUND",
     "payload": {
      "data": {
       "id": "h",
       "owner": "svc-1",
       "label": "ci",
       "revoked": false,
       "expiresAt": "2099-01-01T00:00:00Z"
      }
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "API_KEY_VERIFIED",
        "payload": {
         "owner": "svc-1",
         "claims": [
          {
           "name": "label",
           "value": "ci"
          }
         ]
        }
       },
       {
        "event": "BEARER_KEY_VERIFIED",
        "payload": {
         "owner": "svc-1",
         "claims": [
          {
           "name": "label",
           "value": "ci"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "bad-key-401",
   "steps": [
    {
     "trait": "ApiKeys",
     "event": "KEY_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "nf"
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "API_KEY_REFUSED",
        "payload": {
         "reason": "unknown"
        }
       },
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "reason": "api-key-unknown"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "lowercase-bearer-not-widened",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "KEY_SALT_READ",
     "payload": {
      "value": "00112233445566778899aabbccddeeff"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 10,
      "authorization": "bearer sk_live_abcdef"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "requestId": 10,
         "reason": "malformed"
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY"
      ]
     }
    }
   ]
  },
  {
   "id": "program-session-no-client-and-no-header-is-anonymous",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "BEARER_PRESENT",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "authorization": "",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_ANONYMOUS",
        "payload": {
         "requestId": 3
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "program-session-no-client-with-a-header-is-refused",
   "note": "No client session can keep an identity.",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "BEARER_PRESENT",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "authorization": "Bearer a.b.c",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_REFUSED",
        "payload": {
         "requestId": 3,
         "reason": "no-client-session"
        }
       }
      ],
      "neverEmits": [
       "IDENTITY_BOUND"
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "program-session-forwards-the-header-to-the-client-session",
   "note": "The program session never signs in; it dispatches CREDENTIAL_PRESENTED to the clientId session.",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "BEARER_PRESENT",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "authorization": "Bearer a.b.c",
      "clientId": "tab-1"
     },
     "expect": {
      "fired": true,
      "effects": [
       {
        "type": "program/dispatch"
       }
      ],
      "neverEmits": [
       "IDENTITY_BOUND",
       "IDENTITY_ANONYMOUS",
       "IDENTITY_REFUSED"
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ],
   "config": {
    "ownOrbital": "HttpServerOrbital",
    "ownTrait": "ServerBinding",
    "createIdentity": false
   }
  },
  {
   "id": "a-client-session-that-bound-answers-identity-bound",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "CREDENTIAL_ANSWERED",
     "from": "idle",
     "payload": {
      "key": "3",
      "result": {
       "emittedEvents": [
        {
         "event": "CREDENTIAL_BOUND",
         "payload": {
          "requestId": 3
         }
        }
       ],
       "success": true
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_BOUND",
        "payload": {
         "requestId": 3
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "a-client-session-that-signed-out-answers-anonymous",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "CREDENTIAL_ANSWERED",
     "from": "idle",
     "payload": {
      "key": "4",
      "result": {
       "emittedEvents": [
        {
         "event": "CREDENTIAL_ANONYMOUS",
         "payload": {
          "requestId": 4
         }
        }
       ],
       "success": true
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_ANONYMOUS",
        "payload": {
         "requestId": 4
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "a-client-session-refusal-carries-its-reason",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "CREDENTIAL_ANSWERED",
     "from": "idle",
     "payload": {
      "key": "5",
      "result": {
       "emittedEvents": [
        {
         "event": "CREDENTIAL_REFUSED",
         "payload": {
          "requestId": 5,
          "reason": "expired"
         }
        }
       ],
       "success": true
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_REFUSED",
        "payload": {
         "requestId": 5,
         "reason": "expired"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "control-a-dispatch-outcome-with-no-credential-answer-is-refused",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "CREDENTIAL_ANSWERED",
     "from": "idle",
     "payload": {
      "key": "6",
      "result": {
       "emittedEvents": [],
       "success": false
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_REFUSED",
        "payload": {
         "requestId": 6,
         "reason": "credential-dispatch"
        }
       }
      ],
      "neverEmits": [
       "IDENTITY_BOUND"
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "a-failed-forward-is-refused",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "CREDENTIAL_FAILED",
     "from": "idle",
     "payload": {
      "key": "6",
      "error": "x"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_REFUSED",
        "payload": {
         "requestId": 6,
         "reason": "credential-dispatch"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "client-session-presented-credential-asks-the-verifier",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "CREDENTIAL_PRESENTED",
     "from": "idle",
     "payload": {
      "requestId": 7,
      "authorization": "Bearer a.b.c"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "BEARER_VERIFY",
        "payload": {
         "requestId": 7,
         "authorization": "Bearer a.b.c"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "client-session-no-bearer-signs-out-then-answers-anonymous",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "ANONYMOUS_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 7
     },
     "expect": {
      "fired": true,
      "effects": [
       {
        "type": "identity/sign-out"
       }
      ]
     }
    },
    {
     "trait": "ServerBinding",
     "event": "SIGNED_OUT",
     "from": "idle",
     "payload": {
      "subject": "anonymous"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "CREDENTIAL_ANONYMOUS",
        "payload": {
         "requestId": 7
        }
       }
      ]
     },
     "entity": {
      "awaiting": true,
      "requestId": 7,
      "authorization": "Bearer a.b.c",
      "subject": "u1",
      "created": false,
      "outcome": ""
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "awaiting": true,
    "requestId": 7,
    "authorization": "Bearer a.b.c",
    "subject": "u1",
    "created": false,
    "outcome": "",
    "presented": [
     {
      "requestId": 7,
      "clientId": "",
      "authorization": "Bearer a.b.c",
      "created": false,
      "deferred": false
     }
    ]
   }
  },
