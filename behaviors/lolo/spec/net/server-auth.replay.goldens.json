{
 "atom": "net/organisms/std-http-server.lolo",
 "trait": "ServerBearer",
 "cases": [
  {
   "id": "jwt-control",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "KEY_SALT_READ",
     "payload": {
      "value": "00112233445566778899aabbccddeeff"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 8,
      "authorization": "Bearer eyJhbGciOiJSUzI1NiIsImtpZCI6ImsifQ.e30.sig"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "JWS_VERIFIED",
     "payload": {
      "header": {
       "alg": "RS256"
      },
      "payload": {
       "iss": "",
       "sub": "u1",
       "aud": "",
       "exp": 9999999999,
       "extra": {}
      }
     },
     "from": "verifying",
     "expect": {
      "emits": [
       {
        "event": "BEARER_VERIFIED",
        "payload": {
         "viewer": {
          "id": "u1",
          "claims": []
         }
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY"
      ]
     }
    }
   ],
   "defaults": [
    "BearerHttp"
   ]
  },
  {
   "id": "key-with-keys-disabled",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 9,
      "authorization": "Bearer sk_live_abcdef"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "requestId": 9,
         "reason": "keys-disabled"
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY",
       "JWS_VERIFY"
      ]
     }
    }
   ]
  },
  {
   "id": "key-passes",
   "steps": [
    {
     "trait": "ApiKeys",
     "event": "KEY_FOUND",
     "payload": {
      "data": {
       "id": "h",
       "owner": "svc-1",
       "label": "ci",
       "revoked": false,
       "expiresAt": "2099-01-01T00:00:00Z"
      }
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "API_KEY_VERIFIED",
        "payload": {
         "owner": "svc-1",
         "claims": [
          {
           "name": "label",
           "value": "ci"
          }
         ]
        }
       },
       {
        "event": "BEARER_VERIFIED",
        "payload": {
         "viewer": {
          "id": "svc-1",
          "claims": [
           {
            "name": "label",
            "value": "ci"
           }
          ]
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "bad-key-401",
   "steps": [
    {
     "trait": "ApiKeys",
     "event": "KEY_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "nf"
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "API_KEY_REFUSED",
        "payload": {
         "reason": "unknown"
        }
       },
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "reason": "api-key-unknown"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "lowercase-bearer-not-widened",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "KEY_SALT_READ",
     "payload": {
      "value": "00112233445566778899aabbccddeeff"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 10,
      "authorization": "bearer sk_live_abcdef"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "requestId": 10,
         "reason": "malformed"
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY"
      ]
     }
    }
   ]
  }
 ]
}
