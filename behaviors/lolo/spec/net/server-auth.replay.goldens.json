{
 "atom": "net/organisms/std-http-server.lolo",
 "trait": "ServerBearer",
 "cases": [
  {
   "id": "a-jwt-bearer-never-reaches-the-key-path",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "KEY_SALT_READ",
     "payload": {
      "value": "00112233445566778899aabbccddeeff"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 8,
      "authorization": "Bearer eyJhbGciOiJSUzI1NiIsImtpZCI6ImsifQ.e30.sig"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_PUMP"
       }
      ],
      "neverEmits": [
       "VERIFY_KEY",
       "BEARER_KEY_VERIFIED"
      ]
     }
    }
   ]
  },
  {
   "id": "key-with-keys-disabled",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 9,
      "authorization": "Bearer sk_live_abcdef"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "requestId": 9,
         "reason": "keys-disabled"
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY",
       "BEARER_CHECK"
      ]
     }
    }
   ]
  },
  {
   "id": "key-passes",
   "steps": [
    {
     "trait": "ApiKeys",
     "event": "KEY_FOUND",
     "payload": {
      "data": {
       "id": "h",
       "owner": "svc-1",
       "label": "ci",
       "revoked": false,
       "expiresAt": "2099-01-01T00:00:00Z"
      }
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "API_KEY_VERIFIED",
        "payload": {
         "owner": "svc-1",
         "claims": [
          {
           "name": "label",
           "value": "ci"
          }
         ]
        }
       },
       {
        "event": "BEARER_KEY_VERIFIED",
        "payload": {
         "owner": "svc-1",
         "claims": [
          {
           "name": "label",
           "value": "ci"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "bad-key-401",
   "steps": [
    {
     "trait": "ApiKeys",
     "event": "KEY_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "nf"
     },
     "from": "looking",
     "expect": {
      "emits": [
       {
        "event": "API_KEY_REFUSED",
        "payload": {
         "reason": "unknown"
        }
       },
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "reason": "api-key-unknown"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "lowercase-bearer-not-widened",
   "steps": [
    {
     "trait": "ServerBearer",
     "event": "KEY_SALT_READ",
     "payload": {
      "value": "00112233445566778899aabbccddeeff"
     }
    },
    {
     "trait": "ServerBearer",
     "event": "BEARER_VERIFY",
     "payload": {
      "requestId": 10,
      "authorization": "bearer sk_live_abcdef"
     },
     "expect": {
      "emits": [
       {
        "event": "BEARER_REFUSED",
        "payload": {
         "requestId": 10,
         "reason": "malformed"
        }
       }
      ],
      "neverEmits": [
       "VERIFY_KEY"
      ]
     }
    }
   ]
  },
  {
   "id": "program-session-no-client-and-no-header-is-anonymous",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "BEARER_PRESENT",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "authorization": "",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_ANONYMOUS",
        "payload": {
         "requestId": 3
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "program-session-no-client-with-a-header-is-refused",
   "note": "No client session can keep an identity.",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "BEARER_PRESENT",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "authorization": "Bearer a.b.c",
      "clientId": ""
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_REFUSED",
        "payload": {
         "requestId": 3,
         "reason": "no-client-session"
        }
       }
      ],
      "neverEmits": [
       "IDENTITY_BOUND"
      ]
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ]
  },
  {
   "id": "control-the-program-session-ignores-a-verdict-it-did-not-ask-for",
   "note": "The router's own bearer verdicts reach the same trait; it signs nothing.",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "ANONYMOUS_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 9
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "CREDENTIAL_ANONYMOUS"
      ],
      "effects": []
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "awaiting": false,
    "requestId": 0
   }
  },
  {
   "id": "program-session-verifies-the-header-it-is-asked-to-bind",
   "defaults": [
    "ServerBearer"
   ],
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "BEARER_PRESENT",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "authorization": "Bearer a.b.c",
      "clientId": "tab-1"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "BEARER_VERIFY",
        "payload": {
         "requestId": 3,
         "authorization": "Bearer a.b.c"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-sign-in-of-the-named-session-answers-identity-bound",
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "asks": [
     {
      "requestId": 3,
      "session": "tab-1",
      "self": false,
      "authorization": "Bearer a.b.c",
      "stage": "signing",
      "reason": "",
      "subject": "u1",
      "email": "",
      "name": "",
      "created": false
     }
    ]
   },
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "IDENTITY_SIGNED_IN",
     "from": "idle",
     "payload": {
      "subject": "u1",
      "session": "tab-1"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_BOUND",
        "payload": {
         "requestId": 3
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-sign-out-with-no-reason-answers-anonymous",
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "asks": [
     {
      "requestId": 3,
      "session": "tab-1",
      "self": false,
      "authorization": "Bearer a.b.c",
      "stage": "signing-out",
      "reason": "",
      "subject": "",
      "email": "",
      "name": "",
      "created": false
     }
    ]
   },
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "IDENTITY_SIGNED_OUT",
     "from": "idle",
     "payload": {
      "subject": "anonymous",
      "session": "tab-1"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "IDENTITY_ANONYMOUS",
        "payload": {
         "requestId": 3
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-refused-bearer-signs-the-session-out-and-answers-its-reason",
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "asks": [
     {
      "requestId": 3,
      "session": "tab-1",
      "self": false,
      "authorization": "Bearer a.b.c",
      "stage": "verifying",
      "reason": "",
      "subject": "",
      "email": "",
      "name": "",
      "created": false
     }
    ]
   },
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "REFUSED_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 3,
      "reason": "expired"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "SIGN_OUT_ASKED",
        "payload": {
         "requestId": 3,
         "reason": "expired"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-api-key-binds-no-identity-and-is-refused",
   "note": "An API key makes no Verified.",
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "asks": [
     {
      "requestId": 3,
      "session": "tab-1",
      "self": false,
      "authorization": "Bearer a.b.c",
      "stage": "verifying",
      "reason": "",
      "subject": "",
      "email": "",
      "name": "",
      "created": false
     }
    ]
   },
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "KEY_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 3
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "SIGN_OUT_ASKED",
        "payload": {
         "requestId": 3,
         "reason": "api-key-identity"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-an-absent-header-signs-the-session-out-as-anonymous",
   "defaults": [
