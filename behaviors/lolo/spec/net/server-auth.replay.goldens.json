    "created": false,
    "outcome": "",
    "presented": [
     {
      "requestId": 7,
      "clientId": "",
      "authorization": "Bearer a.b.c",
      "created": false,
      "deferred": false
     }
    ]
   }
  },
  {
   "id": "an-api-key-binds-no-identity-and-is-refused",
   "note": "An API key makes no Verified.",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "KEY_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 7
     },
     "expect": {
      "fired": true,
      "effects": [
       {
        "type": "identity/sign-out"
       }
      ]
     }
    },
    {
     "trait": "ServerBinding",
     "event": "SIGNED_OUT",
     "from": "idle",
     "payload": {
      "subject": "anonymous"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "CREDENTIAL_REFUSED",
        "payload": {
         "requestId": 7,
         "reason": "api-key-identity"
        }
       }
      ]
     },
     "entity": {
      "awaiting": true,
      "requestId": 7,
      "authorization": "Bearer a.b.c",
      "subject": "u1",
      "created": false,
      "outcome": "api-key-identity"
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "awaiting": true,
    "requestId": 7,
    "authorization": "Bearer a.b.c",
    "subject": "u1",
    "created": false,
    "outcome": "",
    "presented": [
     {
      "requestId": 7,
      "clientId": "",
      "authorization": "Bearer a.b.c",
      "created": false,
      "deferred": false
     }
    ]
   }
  },
  {
   "id": "control-the-program-session-ignores-a-verdict-it-did-not-ask-for",
   "note": "The router's own bearer verdicts reach the same trait; it signs nothing.",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "ANONYMOUS_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 9
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "CREDENTIAL_ANONYMOUS"
      ],
      "effects": []
     }
    }
   ],
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "awaiting": false,
    "requestId": 0
   }
  },
  {
   "id": "a-sign-in-that-answers-no-identity-is-refused-without-createIdentity",
   "note": "",
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "SIGN_IN_FAILED",
     "from": "idle",
