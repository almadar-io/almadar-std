  },
  {
   "id": "a-sign-in-that-answers-no-identity-is-refused-without-createIdentity",
   "defaults": [
    "ServerBearer"
   ],
   "entity": {
    "asks": [
     {
      "requestId": 3,
      "session": "tab-1",
      "self": false,
      "authorization": "Bearer a.b.c",
      "stage": "signing",
      "reason": "",
      "subject": "u1",
      "email": "",
      "name": "",
      "created": false
     }
    ]
   },
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "IDENTITY_SIGN_IN_FAILED",
     "from": "idle",
     "payload": {
      "error": "no row",
      "kind": "no-identity",
      "session": "tab-1"
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "SIGN_OUT_ASKED",
        "payload": {
         "requestId": 3,
         "reason": "identity-no-identity"
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
