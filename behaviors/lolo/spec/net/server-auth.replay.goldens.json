   ],
   "entity": {
    "asks": [
     {
      "requestId": 3,
      "session": "tab-1",
      "self": false,
      "authorization": "Bearer a.b.c",
      "stage": "verifying",
      "reason": "",
      "subject": "",
      "email": "",
      "name": "",
      "created": false
     }
    ]
   },
   "steps": [
    {
     "trait": "ServerBinding",
     "event": "ANONYMOUS_SEEN",
     "from": "idle",
     "payload": {
      "requestId": 3
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "SIGN_OUT_ASKED",
