{
  "atom": "net/atoms/std-cdp-profile.lolo",
  "trait": "CdpProfile",
  "defaults": [
    "ProfileCdp"
  ],
  "cases": [
    {
      "id": "a-finished-trace-answers-busy-time-metrics-and-long-tasks-by-top-level-activity",
      "steps": [
        {
          "trait": "CdpProfile",
          "from": "ready",
          "event": "PROFILE_CDP_EVENT",
          "payload": {
            "method": "Tracing.tracingComplete",
            "frame": "{}"
          },
          "entity": {
            "id": "p",
            "targetId": "T",
            "sessionId": "S",
            "label": "page-1",
            "tracing": true,
            "events": [
              {
                "name": "thread_name",
                "ph": "M",
                "pid": 1,
                "tid": 7,
                "args": {
                  "name": "CrRendererMain"
                }
              },
              {
                "name": "RunTask",
                "ph": "X",
                "ts": 1000,
                "dur": 80000,
                "pid": 1,
                "tid": 7
              },
              {
                "name": "FunctionCall",
                "ph": "X",
                "ts": 2000,
                "dur": 50000,
                "pid": 1,
                "tid": 7,
                "args": {
                  "data": {
                    "url": "x"
                  }
                }
              },
              {
                "name": "Layout",
                "ph": "X",
                "ts": 3000,
                "dur": 10000,
                "pid": 1,
                "tid": 7
              },
              {
                "name": "Paint",
                "ph": "X",
                "ts": 60000,
                "dur": 5000,
                "pid": 1,
                "tid": 7
              },
              {
                "name": "RunTask",
                "ph": "X",
                "ts": 200000,
                "dur": 10000,
                "pid": 1,
                "tid": 7
              },
              {
                "name": "RunTask",
                "ph": "X",
                "ts": 5000,
                "dur": 90000,
                "pid": 2,
                "tid": 1
              }
            ],
            "metrics": [
              {
                "name": "JSHeapUsedSize",
                "value": 1000
              },
              {
                "name": "JSHeapTotalSize",
                "value": 2000
              },
              {
                "name": "Nodes",
                "value": 50
              },
              {
                "name": "LayoutCount",
                "value": 3
              },
              {
                "name": "RecalcStyleCount",
                "value": 4
              },
              {
                "name": "TaskDuration",
                "value": 0.5
              },
              {
                "name": "ScriptDuration",
                "value": 0.2
              },
              {
                "name": "LayoutDuration",
                "value": 0.05
              },
              {
                "name": "RecalcStyleDuration",
                "value": 0.01
              }
            ]
          },
          "expect": {
            "fired": true,
            "exactEmits": [
              {
                "event": "CDP_PROFILE_PAGE",
                "payload": {
                  "label": "page-1",
                  "events": 7,
                  "mainBusyMs": 90,
                  "metrics": {
                    "jsHeapUsedBytes": 1000,
                    "jsHeapTotalBytes": 2000,
                    "nodes": 50,
                    "layoutCount": 3,
                    "recalcStyleCount": 4,
                    "taskSeconds": 0.5,
                    "scriptSeconds": 0.2,
                    "layoutSeconds": 0.05,
                    "recalcStyleSeconds": 0.01
                  },
                  "longTasks": [
                    {
                      "startMs": 0,
                      "durMs": 80,
                      "groups": [
                        {
                          "group": "script",
                          "ms": 50
                        },
                        {
                          "group": "paint",
                          "ms": 5
                        }
                      ],
                      "unattributedMs": 25
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
