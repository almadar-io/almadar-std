  {
   "id": "hook-is-delivered-to-its-inbound-handler",
   "note": "The route names the hook and hands its body and headers to program/dispatch { inbound } keyed hook-<requestId>; the replay host answers no substrate op, so the delivery itself is not asserted here (orbital-shell-rust host/runtime.rs a_keyed_inbound_program_dispatch_* deliver through the host).",
   "steps": [
    {
     "event": "REQUEST_RECEIVED",
     "payload": {
      "requestId": 7,
      "method": "POST",
      "path": "/api/hooks/google-calendar",
      "query": "",
      "headers": {
       "content-type": "application/json",
       "x-goog-resource-state": "sync"
      },
      "body": "e30=",
      "peer": "127.0.0.1:5000"
     }
    },
    {
     "event": "ROUTE_DISPATCH",
     "payload": {
      "requestId": 7,
      "kind": "hook"
     },
     "expect": {
      "emits": [
       {
        "event": "HOOK_DELIVERED",
        "payload": {
         "requestId": 7,
         "name": "google-calendar",
         "headers": [
          {
           "name": "content-type",
           "value": "application/json"
          },
          {
           "name": "x-goog-resource-state",
           "value": "sync"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-hook-answer-is-the-response",
   "note": "The handler's { status, body } is the response, as application/json.",
