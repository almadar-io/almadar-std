{
  "atom": "net/atoms/std-http-dispatch.lolo",
  "trait": "ServerDispatch",
  "note": "Route table, hook delivery, 501/400 answers and queueing of the dispatch atom. The kernel cascades each step's emits and expect reads only that step's own emits, so later hops are played as direct steps. CORS carry-through is checked with orb execute --steps (RESPOND headers hold the ROUTE_EXTERNAL responseHeaders then content-type). Bodies are base64 bytes.",
  "cases": [
    {
      "id": "routes-events",
      "steps": [
        {
          "event": "REQUEST_RECEIVED",
          "payload": {
            "requestId": 7,
            "method": "POST",
            "path": "/api/orbitals/Notes/events",
            "query": "",
            "headers": {
              "content-type": "application/json"
            },
            "body": "e30=",
            "peer": "127.0.0.1:5000"
          }
        },
        {
          "event": "ROUTE_EXTERNAL",
          "payload": {
            "requestId": 7,
            "responseHeaders": [
              {
                "name": "access-control-allow-origin",
                "value": "https://app.example"
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "ROUTE_DISPATCH",
                "payload": {
                  "requestId": 7,
                  "kind": "events"
                }
              }
            ]
          }
        }
      ]
    },
