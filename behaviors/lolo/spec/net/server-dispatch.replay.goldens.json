      "traitName": "",
      "entityId": "",
      "stream": false,
      "authorization": "",
      "body": "e30=",
      "hookName": "google-calendar",
      "hookKey": "hook-7",
      "hookHeaders": {
       "x-goog-resource-state": "sync"
      },
      "responseHeaders": [
       {
        "name": "access-control-allow-origin",
        "value": "https://app.example"
       }
      ]
     }
    ]
   },
   "steps": [
    {
     "event": "HOOK_ANSWERED",
     "payload": {
      "result": {
       "status": 200,
       "body": "{\"ok\":true,\"dispatched\":false}"
      },
      "text": "{\"status\":200,\"body\":\"{\\\"ok\\\":true,\\\"dispatched\\\":false}\"}",
      "key": "hook-7"
     },
     "expect": {
      "emits": [
       {
        "event": "RESPOND",
        "payload": {
         "requestId": 7,
         "status": 200
        }
       }
      ]
     }
    }
   ]
  },
