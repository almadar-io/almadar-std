{
 "atom": "net/atoms/std-stream-ticket.lolo",
 "trait": "StreamTicketer",
 "spec": "spec/net/stream-ticket.lolo",
 "note": "StreamTicketer over std-opaque-token: a mint and a forged take run the real token chain; the store's take answers are fed from the taking state, since the drawn ticket is random.",
 "cases": [
  {
   "id": "a-mint-answers-one-ticket-for-the-client-valid-sixty-seconds",
   "now": 1700000000000,
   "defaults": [
    "TicketMint", "TicketTake"
   ],
   "steps": [
    {
     "event": "MINT_TICKET",
     "payload": {
      "clientId": "c1",
      "requestId": 7
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_TOKEN_MINT",
        "payload": {
         "key": "stream-ticket",
         "fields": [
          {
           "name": "clientId",
           "value": "c1"
          }
         ],
         "ttlMs": 60000
        }
       },
       {
        "event": "TICKET_MINTED",
        "payload": {
         "expiresAt": "2023-11-14T22:14:20.000Z",
         "requestId": 7
        }
       }
      ],
      "emitCounts": {
       "TICKET_MINTED": 1
      },
      "neverEmits": [
       "TICKET_REFUSED"
      ]
     }
    }
   ]
  },
  {
   "id": "a-forged-ticket-is-refused-unknown",
   "now": 1700000000000,
   "defaults": [
    "TicketMint", "TicketTake"
   ],
   "steps": [
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "forged"
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_TOKEN_TAKE",
        "payload": {
         "key": "stream-ticket",
         "token": "forged"
        }
       },
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "unknown",
         "message": "no such token",
         "ticket": "forged"
        }
       }
      ],
      "neverEmits": [
       "TICKET_TAKEN"
      ]
     }
    }
   ]
  },
  {
   "id": "a-resolved-ticket-names-the-client-that-minted-it",
   "now": 1700000000000,
   "steps": [
    {
     "event": "TOKEN_RESOLVED",
     "from": "taking",
     "entity": {
      "ticket": "tk",
      "queue": []
     },
     "payload": {
      "key": "stream-ticket",
      "id": "h",
      "row": {
       "id": "h",
       "clientId": "c1",
       "expiresAt": "2023-11-14T22:14:20Z"
      }
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_TAKEN",
        "payload": {
         "ticket": "tk",
         "clientId": "c1"
        }
       }
      ],
      "neverEmits": [
       "TICKET_REFUSED"
      ]
     }
    }
   ]
  },
  {
   "id": "a-spent-ticket-is-refused-used",
   "now": 1700000000000,
   "steps": [
    {
     "event": "TOKEN_REFUSED",
     "from": "taking",
     "entity": {
      "ticket": "tk",
      "queue": []
     },
     "payload": {
      "key": "stream-ticket",
      "code": "used",
      "message": "the token was already spent",
      "token": "tk"
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "used",
         "message": "the token was already spent",
         "ticket": "tk"
        }
       }
      ],
      "neverEmits": [
       "TICKET_TAKEN"
      ]
     }
    }
   ]
  },
  {
   "id": "an-expired-ticket-is-refused-expired",
   "now": 1700000000000,
   "steps": [
    {
     "event": "TOKEN_REFUSED",
     "from": "taking",
     "entity": {
      "ticket": "tk",
      "queue": []
     },
     "payload": {
      "key": "stream-ticket",
      "code": "expired",
      "message": "the token has expired",
      "token": "tk"
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "expired",
         "message": "the token has expired",
         "ticket": "tk"
        }
       }
      ],
      "neverEmits": [
       "TICKET_TAKEN"
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-resolved-row-with-no-client-is-refused-not-taken",
   "now": 1700000000000,
   "steps": [
    {
     "event": "TOKEN_RESOLVED",
     "from": "taking",
     "entity": {
      "ticket": "tk",
      "queue": []
     },
     "payload": {
      "key": "stream-ticket",
      "id": "h",
      "row": {
       "id": "h",
       "clientId": "",
       "expiresAt": "2023-11-14T22:14:20Z"
      }
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "unknown",
         "message": "the stream ticket names no client",
         "ticket": "tk"
        }
       }
      ],
      "neverEmits": [
       "TICKET_TAKEN"
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-minted-ticket-with-no-expiry-is-refused-not-minted",
   "now": 1700000000000,
   "steps": [
    {
     "event": "TOKEN_MINTED",
     "from": "minting",
     "entity": {
      "mintRequest": 3,
      "queue": []
     },
     "payload": {
      "key": "stream-ticket",
      "token": "tk",
      "id": "h"
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "store",
         "message": "the minted ticket has no expiry",
         "requestId": 3
        }
       }
      ],
      "neverEmits": [
       "TICKET_MINTED"
      ]
     }
    }
   ]
  },
  {
   "id": "a-mint-arriving-mid-mint-waits-its-turn-and-is-answered-once",
   "now": 1700000000000,
   "defaults": [
    "TicketMint", "TicketTake"
   ],
   "steps": [
    {
     "event": "MINT_TICKET",
     "from": "minting",
     "entity": {
      "mintRequest": 1,
      "queue": []
     },
     "payload": {
      "clientId": "c2",
      "requestId": 2
     },
     "expect": {
      "fired": true,
      "state": "minting",
      "neverEmits": [
       "TICKET_TOKEN_MINT",
       "TICKET_MINTED",
       "TICKET_REFUSED"
      ]
     }
    },
    {
     "event": "TOKEN_MINTED",
     "from": "minting",
     "payload": {
      "key": "stream-ticket",
      "token": "t1",
      "id": "h1",
      "expiresAt": "2023-11-14T22:14:20.000Z"
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_MINTED",
        "payload": {
         "ticket": "t1",
         "requestId": 1
        }
       },
       {
        "event": "TICKET_TOKEN_MINT",
        "payload": {
         "fields": [
          {
           "name": "clientId",
           "value": "c2"
          }
         ]
        }
       },
       {
        "event": "TICKET_MINTED",
        "payload": {
         "requestId": 2
        }
       }
      ],
      "emitCounts": {
       "TICKET_MINTED": 2
      },
      "neverEmits": [
       "TICKET_REFUSED"
      ]
     }
    }
   ]
  },
  {
   "id": "a-request-beyond-the-queue-bound-is-refused-busy",
   "now": 1700000000000,
   "config": {
    "maxQueue": 0
   },
   "steps": [
    {
     "event": "MINT_TICKET",
     "payload": {
      "clientId": "c1",
      "requestId": 9
     },
     "expect": {
      "fired": true,
      "state": "idle",
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "busy",
         "message": "the stream ticket queue is full",
         "requestId": 9
        }
       }
      ],
      "neverEmits": [
       "TICKET_TOKEN_MINT"
      ]
     }
    }
   ]
  }
 ]
}