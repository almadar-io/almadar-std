{
 "atom": "net/atoms/std-stream-ticket.lolo",
 "trait": "StreamTicketer",
 "note": "from the stream-ticket scenarios; the host answers (random draw, store fetch/persist) are played as steps; the mint-with-bearer 401s are router verdicts, not atom events",
 "cases": [
  {
   "id": "a-minted-ticket-opens-the-stream-once",
   "note": "keep t binds the minted ticket; $t is spent once, the second spend finds the row gone",
   "steps": [
    {
     "event": "MINT_TICKET",
     "payload": {
      "requestId": 1,
      "clientId": "client-alice"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "SEED_DRAWN",
     "payload": {
      "value": "tk1"
     },
     "from": "drawing"
    },
    {
     "event": "TICKET_SAVED",
     "payload": {
      "id": "tk1"
     },
     "from": "saving",
     "keep": "t",
     "keepField": "ticket",
     "expect": {
      "emits": [
       {
        "event": "TICKET_MINTED",
        "payload": {
         "ticket": "tk1",
         "requestId": 1
        }
       }
      ]
     }
    },
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "$t"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_LOADED",
     "payload": {
      "data": {
       "id": "tk1",
       "expiresAt": "5138-11-16T09:46:39.999Z",
       "clientId": "client-alice"
      }
     },
     "from": "taking"
    },
    {
     "event": "TICKET_SPENT",
     "payload": {
      "id": "tk1"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_TAKEN",
        "payload": {
         "ticket": "tk1",
         "clientId": "client-alice"
        }
       }
      ]
     }
    },
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "$t"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_LOADED",
     "payload": {
      "data": {
       "id": "tk1",
       "expiresAt": "5138-11-16T09:46:39.999Z",
       "clientId": "client-alice"
      }
     },
     "from": "taking"
    },
    {
     "event": "TICKET_NOT_SPENT",
     "payload": {
      "error": "gone"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "used",
         "ticket": "tk1"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-forged-ticket-is-refused",
   "steps": [
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "forged"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_ABSENT",
     "payload": {
      "code": "not-found"
     },
     "from": "taking",
     "expect": {
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "unknown",
         "ticket": "forged"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-expired-ticket-is-refused",
   "steps": [
    {
     "event": "MINT_TICKET",
     "payload": {
      "requestId": 1,
      "clientId": "client-alice"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "SEED_DRAWN",
     "payload": {
      "value": "tk1"
     },
     "from": "drawing"
    },
    {
     "event": "TICKET_SAVED",
     "payload": {
      "id": "tk1"
     },
     "from": "saving",
     "keep": "t",
     "keepField": "ticket",
     "expect": {
      "emits": [
       {
        "event": "TICKET_MINTED",
        "payload": {
         "ticket": "tk1",
         "requestId": 1
        }
       }
      ]
     }
    },
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "$t"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_LOADED",
     "payload": {
      "data": {
       "id": "tk1",
       "expiresAt": "1970-01-01T00:00:00.001Z",
       "clientId": "client-alice"
      }
     },
     "from": "taking"
    },
    {
     "event": "TICKET_SPENT",
     "payload": {
      "id": "tk1"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "expired",
         "ticket": "tk1"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "two-viewers-hold-two-tickets-each-opens-once",
   "note": "two tickets held at once; each spends on its own and a second take of the first is refused",
   "steps": [
    {
     "event": "MINT_TICKET",
     "payload": {
      "requestId": 1,
      "clientId": "client-alice"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "SEED_DRAWN",
     "payload": {
      "value": "tk1"
     },
     "from": "drawing"
    },
    {
     "event": "TICKET_SAVED",
     "payload": {
      "id": "tk1"
     },
     "from": "saving",
     "keep": "a",
     "keepField": "ticket",
     "expect": {
      "emits": [
       {
        "event": "TICKET_MINTED",
        "payload": {
         "ticket": "tk1",
         "requestId": 1
        }
       }
      ]
     }
    },
    {
     "event": "MINT_TICKET",
     "payload": {
      "requestId": 2,
      "clientId": "client-bob"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "SEED_DRAWN",
     "payload": {
      "value": "tk2"
     },
     "from": "drawing"
    },
    {
     "event": "TICKET_SAVED",
     "payload": {
      "id": "tk2"
     },
     "from": "saving",
     "keep": "b",
     "keepField": "ticket",
     "expect": {
      "emits": [
       {
        "event": "TICKET_MINTED",
        "payload": {
         "ticket": "tk2",
         "requestId": 2
        }
       }
      ]
     }
    },
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "$b"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_LOADED",
     "payload": {
      "data": {
       "id": "tk2",
       "expiresAt": "5138-11-16T09:46:39.999Z",
       "clientId": "client-bob"
      }
     },
     "from": "taking"
    },
    {
     "event": "TICKET_SPENT",
     "payload": {
      "id": "tk2"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_TAKEN",
        "payload": {
         "ticket": "tk2"
        }
       }
      ]
     }
    },
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "$a"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_LOADED",
     "payload": {
      "data": {
       "id": "tk1",
       "expiresAt": "5138-11-16T09:46:39.999Z",
       "clientId": "client-alice"
      }
     },
     "from": "taking"
    },
    {
     "event": "TICKET_SPENT",
     "payload": {
      "id": "tk1"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_TAKEN",
        "payload": {
         "ticket": "tk1"
        }
       }
      ]
     }
    },
    {
     "event": "TAKE_TICKET",
     "payload": {
      "ticket": "$a"
     }
    },
    {
     "event": "TICKET_PUMP",
     "payload": {}
    },
    {
     "event": "TICKET_LOADED",
     "payload": {
      "data": {
       "id": "tk1",
       "expiresAt": "5138-11-16T09:46:39.999Z",
       "clientId": "client-alice"
      }
     },
     "from": "taking"
    },
    {
     "event": "TICKET_NOT_SPENT",
     "payload": {
      "error": "gone"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "used",
         "ticket": "tk1"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-saved-ticket-with-no-expiry-is-refused-not-minted",
   "note": "TICKET_SAVED arrives with no mint in flight, so expiresAt was never set: the mint is refused as a store failure",
   "steps": [
    {
     "event": "TICKET_SAVED",
     "payload": {
      "id": "tk9"
     },
     "from": "saving",
     "expect": {
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "store"
        }
       }
      ],
      "neverEmits": [
       "TICKET_MINTED"
      ]
     }
    }
   ]
  },
  {
   "id": "a-spent-ticket-with-no-holder-is-refused-not-taken",
   "note": "TICKET_SPENT arrives with no stored ticket read, so holder was never set: the take is refused",
   "steps": [
    {
     "event": "TICKET_SPENT",
     "payload": {
      "id": "tk9"
     },
     "from": "spending",
     "expect": {
      "emits": [
       {
        "event": "TICKET_REFUSED",
        "payload": {
         "code": "unknown"
        }
       }
      ],
      "neverEmits": [
       "TICKET_TAKEN"
      ]
     }
    }
   ]
  }
 ]
}
