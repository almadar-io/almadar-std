app http-keyed-spec [
  version: "2.0.0",
  description: "Design contract for concurrent HTTP calls by key (std-http-client stays one call per frame): HTTP_SEND { key, method, target, headers, body, stream } routed with `per @payload.key` is answered HTTP_REPLIED { key, status, headers, body } or HTTP_FAILED { key, error, kind } carrying the same key, with a stream of sse or jsonl framed as HTTP_STREAM_EVENT { key, data, event, id }. Each key is its own row of std-http-client, so its own socket and its own head and body state, created on first use and dropped when the call has ended and the row is back at its defaults; a second call on a key in flight answers HTTP_FAILED kind refused; a key that is not a non-empty string is refused by the `per` clause as DELIVERY_REJECTED from HttpKeyed, which hears it and answers HTTP_FAILED with an empty key and kind refused. HTTP_CANCEL { key } closes the in-flight call's socket, and no answer follows. The stream framer is shared by every row."
]

type HttpHeader = { name : string!, value : string! }

orbital HttpKeyedSpec {
  expects entity HttpFlight [runtime] {
    id : string!
    key : string
    sock : number
  }
  expects trait HttpKeyed {
    state ready {
      HTTP_SEND -> ready
      HTTP_CANCEL -> ready
    }
    emits {
      HTTP_FAILED { key : string!  error : string!  kind : string! }
    }
  }
  expects trait KeyedHttp {
    state ready {
      HTTP_SEND -> connecting
      HTTP_CANCEL -> ready
    }
    state connecting {
      HC_CONNECTED -> sending
      HC_IO_FAILED -> ready
    }
    emits {
      HTTP_REPLIED { key : string!  status : number!  headers : Map string string  body : bytes! }
      HTTP_STREAM_EVENT { key : string!  data : string!  event : string  id : string }
      HTTP_FAILED { key : string!  error : string!  kind : string! }
    }
  }
  expects page boot -> HttpKeyed, KeyedHttp
}
