  {
   "id": "a-negative-port-is-refused-and-never-written",
   "steps": [
    {
     "from": "booting",
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": -1
     },
     "expect": {
      "fired": true,
      "state": "booting",
      "emits": [
       {
        "event": "HTTP1_LISTEN_FAILED",
        "payload": {
         "error": "listener reported a missing or negative port",
         "kind": "invalid-port"
        }
       }
      ],
      "neverEmits": [
       "HTTP1_LISTENING"
      ]
     }
    }
   ]
  },
  {
   "id": "an-accepted-connection-arms-its-idle-timer-while-its-read-waits",
   "steps": [
    {
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": 8080
     }
    },
    {
     "event": "CONN_ACCEPTED",
     "payload": {
      "sock": 7,
      "peer": "1.2.3.4:5",
      "key": "listener"
     },
     "expect": {
      "emits": [
       {
        "event": "CONN_WAIT",
        "payload": {
         "key": "conn-7",
         "delayMs": 5000
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-read-that-completes-disarms-its-timer",
   "steps": [
    {
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": 8080
     }
    },
    {
     "event": "CONN_ACCEPTED",
     "payload": {
      "sock": 7,
      "peer": "1.2.3.4:5",
      "key": "listener"
     }
    },
    {
     "event": "CHUNK_READ",
     "payload": {
      "key": "conn-7",
      "eof": false,
      "data": "R0VUIC8gSFRUUC8xLjENCg=="
     },
     "expect": {
      "emits": [
       {
        "event": "CONN_WAIT_DONE",
        "payload": {
         "key": "conn-7"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-idle-connection-whose-timer-elapses-is-shut-down",
   "steps": [
    {
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": 8080
     }
    },
    {
     "event": "CONN_ACCEPTED",
     "payload": {
      "sock": 7,
      "peer": "1.2.3.4:5",
      "key": "listener"
     }
    },
    {
     "event": "CONN_TIMER_ELAPSED",
     "payload": {
      "key": "conn-7",
      "waitedMs": 5000
     },
     "expect": {
      "effects": [
       {
        "type": "os/shutdown"
       }
      ],
      "neverEmits": [
       "STREAM_IDLE"
      ]
     }
    }
   ]
  },
  {
   "id": "an-open-stream-whose-timer-elapses-beats-and-rearms",
