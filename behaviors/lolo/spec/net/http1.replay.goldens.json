{
 "atom": "net/atoms/std-http1.lolo",
 "trait": "Http1",
 "note": "the head and body framing refusals the atom answers itself",
 "cases": [
  {
   "id": "a-chunked-body-is-assembled",
   "steps": [
    {
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": 8080
     }
    },
    {
     "event": "CONN_ACCEPTED",
     "payload": {
      "sock": 7,
      "peer": "1.2.3.4:5",
      "key": "listener"
     }
    },
    {
     "event": "CHUNK_READ",
     "payload": {
      "key": "conn-7",
      "eof": false,
      "data": "UE9TVCAvYT94PTEgSFRUUC8xLjENCkhvc3Q6IGENClRyYW5zZmVyLUVuY29kaW5nOiBjaHVua2VkDQoNCjUNCmhlbGxvDQowDQoNCg=="
     },
     "expect": {
      "emits": [
       {
        "event": "REQUEST_RECEIVED",
        "payload": {
         "requestId": 7,
         "method": "POST",
         "path": "/a",
         "query": "x=1",
         "headers": {
          "host": "a",
          "transfer-encoding": "chunked"
         },
         "body": "aGVsbG8=",
         "peer": "1.2.3.4:5"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-content-length-body-is-delivered",
   "steps": [
    {
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": 8080
     }
    },
