      "refuse": 0,
      "method": "GET",
      "path": "/api/events",
      "query": "",
      "headers": [],
      "te": false,
      "dec": "",
      "dstate": "",
      "phase": "streaming",
      "keepAlive": true,
      "http10": false,
      "chunked": false,
      "served": 1,
      "idle": 2,
      "sends": 0
     }
    ]
   },
   "steps": [
    {
     "event": "LISTENING",
     "payload": {
      "address": "127.0.0.1",
      "port": 8080
     }
    },
    {
     "event": "CONN_TIMER_ELAPSED",
     "payload": {
      "key": "conn-7",
      "waitedMs": 5000
     },
     "expect": {
      "emits": [
       {
        "event": "STREAM_IDLE",
        "payload": {
         "requestId": 7,
         "idle": 3
        }
       },
       {
        "event": "CONN_WAIT",
        "payload": {
         "key": "conn-7",
         "delayMs": 5000
        }
       }
      ]
     }
    }
   ]
  },
