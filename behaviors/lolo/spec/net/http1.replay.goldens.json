      "key": "listener"
     }
    },
    {
     "event": "CHUNK_READ",
     "payload": {
      "key": "conn-7",
      "eof": false,
      "data": "UE9TVCAvYSBIVFRQLzEuMQ0KSG9zdDogYQ0KQ29udGVudC1MZW5ndGg6IDMNCg0KYWJj"
     },
     "expect": {
      "emits": [
       {
        "event": "REQUEST_RECEIVED",
        "payload": {
         "requestId": 7,
         "method": "POST",
         "path": "/a",
         "query": "",
         "headers": {
          "host": "a",
          "content-length": "3"
         },
         "body": "YWJj",
         "peer": "1.2.3.4:5"
        }
       }
      ]
     }
    }
   ]
  },
