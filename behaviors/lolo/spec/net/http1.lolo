app http1-spec [
  version: "1.0.0",
  description: "Design contract for HTTP/1.1 over a raw TCP listener, the parity oracle being the os_host/http.rs reader and writer it replaces. LISTEN binds one os/tcp-listen stream; each accepted connection is read until its head ends in CRLF CRLF, then until content-length body bytes have arrived (or, for transfer-encoding: chunked, until the last chunk and its trailers have arrived), and is delivered once as REQUEST_RECEIVED { requestId (the connection's socket id, a number), method, path, query, headers, body, peer }. Header names are lower-cased and repeated names are joined with a comma and a space; query is the raw text after the first ?, empty when there is none; body is the bytes of exactly content-length bytes, or the chunk data assembled in order for a chunked request (RFC 7230 section 4.1: hex size line, chunk extensions after a semicolon ignored, CRLF framing, a 0 last chunk, then trailer fields read and discarded up to the blank line; trailers are never delivered), delivered intact whatever they hold. The atom never routes. A connection it cannot deliver is answered by the atom and never reaches the program: a head holding any byte of 0x80 or above, or that is not an HTTP/1.0 or HTTP/1.1 request line followed by name: value lines gets 400, so does a content-length that is not a number or that repeats with a different value; a request with both content-length and transfer-encoding gets 400 (RFC 7230 section 3.3.3), so does transfer-encoding on HTTP/1.0, a repeated chunked, a chunk size that is not 1 to 8 hex digits, a size line over 128 bytes, a chunk not followed by CRLF, a malformed trailer line and more than 4096 chunk steps; any transfer-encoding coding other than chunked (gzip, for one) gets 501; a decoded chunked body over 67108864 gets 413, checked as each size line is read, before its data arrives; a head with no end after 65536 bytes gets 431, and so do more than 100 headers; a content-length over 67108864 gets 413. SEND_RESPONSE { requestId, status, headers (a list of name and value, repeats allowed), body (bytes) } answers a delivered request once: the reply is the status line with the standard reason phrase, the given headers, content-length (left out for 204 and 304) and connection: close, then the body; the connection then closes and RESPONDED { requestId, bytes } follows. A SEND_RESPONSE is refused with RESPOND_REFUSED { requestId, kind, error } and leaves the request pending when its status is outside 200-599 (invalid), a header name is not a token or a value holds a control character (invalid), a header is content-length, transfer-encoding or connection because the atom writes the framing (invalid), a 204 or 304 carries a body (invalid), or no pending request has that id (closed; a second answer is closed). Values it replaces (the http/listen and http/respond operators): POST /items/7?x=1&y=two with X-Two: a, x-two: b, Content-Length: 5 and body hello is delivered with path /items/7, query x=1&y=two, headers x-two a, b and body hello; NOT HTTP AT ALL is answered 400; POST /u with Transfer-Encoding: chunked and the body 5 CRLF hello CRLF 6 CRLF  world CRLF 0 CRLF CRLF is delivered with body hello world (a chunk size line 5;ext=1 is the same chunk, 0 CRLF X-T: 1 CRLF CRLF ends it with the trailer discarded); Transfer-Encoding: gzip is answered 501; Content-Length: 5 with Transfer-Encoding: chunked is answered 400; GET /ok with no query and no body is delivered with query and body empty; a 201 reply with content-type text/plain and body made (bytes) goes out as HTTP/1.1 201 Created, content-type, content-length 4, connection close. Keep-alive: the reply says connection: keep-alive and the connection then reads the next request (bytes past the answered one are kept for it) unless the request said connection: close, it is HTTP/1.0 without connection: keep-alive, the connection has answered maxRequestsPerConn (100) requests, or the reply is an atom refusal (those say connection: close); a connection idle past the read timeout closes; SEND_RESPONSE is closed for a connection whose request is not pending. Streamed replies: RESPOND_HEAD { requestId, status, headers } on a pending request writes the head with transfer-encoding: chunked (raw, without it, for content-type text/event-stream and for HTTP/1.0 clients) and connection: close, then STREAM_OPENED { requestId }; RESPOND_CHUNK { requestId, body } writes hex length, CRLF, body, CRLF (the bare body when raw) and CHUNK_SENT { requestId, bytes } follows, an empty body being invalid; RESPOND_END { requestId } writes 0 CRLF CRLF (nothing when raw) and closes with RESPONDED. Each is closed when the request is not in the right phase. While streaming one read watches the client: it leaving, or a failed write, closes the connection and emits STREAM_CLOSED { requestId, reason: client }; every read timeout emits STREAM_IDLE { requestId, idle }. Values: a 4096 byte chunk is framed 1000 CRLF body CRLF; a 255 byte chunk ff; GET with connection: close is answered connection: close and closed; GET HTTP/1.1 with no connection header is answered connection: keep-alive and the next request on the socket is delivered with a fresh requestId-bearing REQUEST_RECEIVED."
]

type Http1Header = { name : string!, value : string! }
type Http1Reason = { status : number!, text : string! }
type Http1Conn = { sock : number!, key : string!, peer : string!, buf : bytes!, headLen : number!, need : number!, refuse : number!, method : string!, path : string!, query : string!, headers : [Http1Header]!, te : boolean!, dec : bytes!, dstate : string!, phase : string!, keepAlive : boolean!, http10 : boolean!, chunked : boolean!, served : number!, idle : number!, sends : number! }

orbital Http1Spec {
  expects entity Http1Server [runtime] {
    id : string!
    host : string
    port : number
    conns : [Http1Conn]
    @invariant (>= @entity.port 0)
  }
  expects trait Http1 {
    state booting {
      LISTEN -> booting
      LISTENING -> serving
      LISTEN_FAILED -> booting
    }
    state serving {
      CONN_ACCEPTED -> serving
      CHUNK_READ -> serving
      CONN_FAILED -> serving
      CONN_ADVANCE -> serving
      HEAD_SEARCHED -> serving
      HEAD_PARSED -> serving
      BODY_CHECK -> serving
      BODY_DECODE -> serving
      BODY_DECODED -> serving
      WANT_MORE -> serving
      DELIVER -> serving
      SEND_RESPONSE -> serving
      RESPONSE_SENT -> serving
      RESPONSE_FAILED -> serving
      RESPOND_HEAD -> serving
      RESPOND_CHUNK -> serving
      RESPOND_END -> serving
      HEAD_SENT -> serving
      SEND_DONE -> serving
      SEND_FAILED -> serving
    }
    emits {
      HTTP1_LISTENING { host : string!  port : number! }
      HTTP1_LISTEN_FAILED { error : string!  kind : string! }
      REQUEST_RECEIVED { requestId : number!  method : string!  path : string!  query : string!  headers : Map string string  body : bytes!  peer : string! }
      RESPONDED { requestId : number!  bytes : number! }
      RESPOND_REFUSED { requestId : number!  kind : string!  error : string! }
      STREAM_OPENED { requestId : number! }
      CHUNK_SENT { requestId : number!  bytes : number! }
      STREAM_CLOSED { requestId : number!  reason : string! }
      STREAM_IDLE { requestId : number!  idle : number! }
    }
  }
  expects page "/http1" -> Http1
}
