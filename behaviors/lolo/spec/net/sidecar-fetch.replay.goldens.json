{
 "atom": "net/atoms/std-sidecar-fetch.lolo",
 "trait": "SidecarFetch",
 "source": "orbital-cli/src/commands/sidecar_fetch.rs tests",
 "note": "Byte payloads are base64. The replay kernel answers every os and http call with an unsupported failure, so a step's cascade runs through those failure events; the digest is computed for real by std-sha256. A keyed os effect is reported by program/step and neither run nor failed (G-ORB-459), so the store-step cases assert the reported effect (type and key) with expect.effects.",
 "cases": [
  {
   "id": "cache-hit-does-not-fetch",
   "steps": [
    {
     "event": "SIDECAR_PROBED",
     "payload": {
      "ok": true
     },
     "from": "probing",
     "entity": {
      "id": "s",
      "requestId": "r1",
      "name": "pkg-a",
      "version": "1.0.0",
      "declared": "dist/vectors.vec",
      "sha256": "abc123",
      "url": "https://storage.googleapis.com/o/x?token=TOPSECRETTOKEN"
     },
     "expect": {
      "emits": [
       {
        "event": "SIDECAR_RESOLVED",
        "payload": {
         "requestId": "r1",
         "path": "~/.almadar/sidecars/abc123"
        }
       }
      ],
      "neverEmits": [
       "SIDECAR_REFUSED"
      ]
     }
    }
   ]
  },
  {
