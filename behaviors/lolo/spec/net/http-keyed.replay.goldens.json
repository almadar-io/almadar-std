{
 "atom": "net/atoms/std-http-keyed.lolo",
 "trait": "HttpKeyed",
 "note": "Row routing of the keyed client: HttpKeyed re-emits a call and KeyedHttp hears it `per @payload.key`, so each key is its own row of std-http-client (its own socket and head and body state), created on first use; the wire itself is std-http-client's (http-client.replay.goldens.json). A row's os completions are dispatched to its row by the host and are covered by the kernel twin tests (per_listen_instances).",
 "cases": [
  {
   "id": "a-call-opens-the-socket-of-its-own-row",
   "defaults": [
    "KeyedHttp",
    "KeyedFrame"
   ],
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/k1",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k1",
         "target": "/k1"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ],
      "neverEmits": [
       "HTTP_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "two-keys-are-in-flight-at-once-on-two-rows",
   "defaults": [
    "KeyedHttp",
    "KeyedFrame"
   ],
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/k1",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k1"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ]
     }
    },
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k2",
      "method": "GET",
      "target": "/k2",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k2"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ],
      "neverEmits": [
       "HTTP_FAILED"
      ]
     }
    },
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k3",
      "method": "GET",
      "target": "/k3",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k3"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ],
      "neverEmits": [
       "HTTP_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-key-already-in-flight-is-refused-on-its-own-row",
   "defaults": [
    "KeyedHttp",
    "KeyedFrame"
   ],
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/k1",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k1"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ]
     }
    },
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/again",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k1"
        }
       },
       {
        "event": "HTTP_FAILED",
        "payload": {
         "key": "k1",
         "kind": "refused"
        }
       }
      ],
      "neverEmits": [
       "HC_BUILT"
      ]
     }
    }
   ]
  },
  {
   "id": "a-cancel-reaches-only-its-own-row",
   "defaults": [
    "KeyedHttp",
    "KeyedFrame"
   ],
   "steps": [
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k1",
      "method": "GET",
      "target": "/k1",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k1"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ]
     }
    },
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k2",
      "method": "GET",
      "target": "/k2",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k2"
        }
       },
       {
        "event": "HC_BUILT"
       }
      ]
     }
    },
    {
     "event": "HTTP_CANCEL",
     "payload": {
      "key": "k1"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_CANCEL",
        "payload": {
         "key": "k1"
        }
       }
      ],
      "neverEmits": [
       "HTTP_FAILED",
       "HTTP_REPLIED"
      ]
     }
    },
    {
     "event": "HTTP_SEND",
     "payload": {
      "key": "k2",
      "method": "GET",
      "target": "/k2b",
      "headers": [],
      "body": "",
      "stream": "none"
     },
     "expect": {
      "emits": [
       {
        "event": "KEYED_SEND",
        "payload": {
         "key": "k2"
        }
       },
       {
        "event": "HTTP_FAILED",
        "payload": {
         "key": "k2",
         "kind": "refused"
        }
       }
      ]
     }
    }
   ]
  }
 ]
}