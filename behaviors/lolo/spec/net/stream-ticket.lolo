app stream-ticket-spec [
  version: "1.0.0",
  description: "Design contract for single-use stream tickets: a ticket is a std-opaque-token (32 CSPRNG bytes in base64url, stored only as its SHA-256), minted for the client of an authenticated request, valid for a bounded time (60 seconds unless a knob names another) and spent by its first take. A request arriving while one is in flight is queued in arrival order and answered exactly once; beyond the queue bound it is refused busy. A forged, expired or already spent ticket names nobody. The Rust values it replaces: a minted ticket names its viewer once; a second take, a forged ticket and a short draw are refused."
]

type StreamTicketJob = { kind : "mint" | "take", requestId : number, ticket : string, clientId : string }
orbital StreamTicketSpec {
  expects entity StreamTicket [persistent] {
    id : string!
    clientId : string!
    expiresAt : instant
  }
  expects entity StreamTicketRun [runtime] {
    id : string!
    queue : [StreamTicketJob] = []
    @invariant (>= (array/len @entity.queue) 0)
  }
  expects trait StreamTicketer {
    state idle {
      MINT_TICKET -> idle
      TAKE_TICKET -> idle
      TICKET_PUMP -> minting
    }
    state minting {
      MINT_TICKET -> minting
      TAKE_TICKET -> minting
      TOKEN_MINTED -> idle
      TOKEN_REFUSED -> idle
    }
    state taking {
      MINT_TICKET -> taking
      TAKE_TICKET -> taking
      TOKEN_RESOLVED -> idle
      TOKEN_REFUSED -> idle
    }
    emits {
      TICKET_MINTED { ticket : string!  expiresAt : instant!  requestId : number }
      TICKET_TAKEN { ticket : string!  clientId : string! }
      TICKET_REFUSED { code : "seed" | "store" | "unknown" | "expired" | "used" | "busy"  message : string!  ticket : string  requestId : number }
    }
  }
  expects page boot -> StreamTicketer
}
