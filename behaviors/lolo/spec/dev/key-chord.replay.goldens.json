  "cases": [
    {
      "id": "key-chord-fixed-modifier-order (useKeyboardRouter keyChord, key_chord.rs:302)",
      "steps": [
        {
          "event": "KEY_CHORD",
          "payload": {
            "key": "k",
            "ctrl": true,
            "alt": false,
            "shift": true,
            "meta": true
          },
          "expect": {
            "emits": [
              {
                "event": "KEY_RESULT",
                "payload": {
                  "value": "Control+Shift+Meta+k"
                }
              }
            ]
          }
        },
        {
          "event": "KEY_CHORD",
          "payload": {
            "key": "Escape",
            "ctrl": false,
            "alt": false,
            "shift": false,
            "meta": false
          },
          "expect": {
            "emits": [
              {
                "event": "KEY_RESULT",
                "payload": {
                  "value": "Escape"
                }
              }
            ]
          }
        },
        {
          "event": "KEY_CHORD",
          "payload": {
            "key": "x",
            "ctrl": true,
            "alt": true,
            "shift": true,
            "meta": true
          },
          "expect": {
            "emits": [
              {
                "event": "KEY_RESULT",
                "payload": {
                  "value": "Control+Alt+Shift+Meta+x"
                }
              }
            ]
          }
        }
      ]
    },
