{
  "atom": "dev/atoms/std-mock-seed-marks.lolo",
  "trait": "MarksCheck",
  "cases": [
    {
      "id": "a program declaring a mock_seed_marks auxiliary entity is marked",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
              "name": "a",
              "orbitals": [
                {
                  "name": "O",
                  "auxiliaryEntities": [
                    {
                      "collection": "mock_seed_marks"
                    }
                  ]
                }
              ]
            }
          },
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control: a program without the marks store is not marked",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
              "name": "a",
              "orbitals": [
                {
                  "name": "O",
                  "auxiliaryEntities": [
                    {
                      "collection": "other"
                    }
                  ]
                }
              ]
            }
          },
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": false
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "edge: a program with no orbitals is not marked",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
              "name": "a",
              "orbitals": []
            }
          },
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": false
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "edge: no program is not marked",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {},
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": false
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "an identity entity composes the personas signing in as its first declared role",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
              "name": "a",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "TeamMember",
                    "collection": "team_members",
                    "identity": true,
                    "fields": [
                      {
                        "name": "id"
                      },
                      {
                        "name": "role",
                        "values": [
                          "owner",
                          "manager",
                          "admin"
                        ]
                      }
                    ]
                  },
                  "auxiliaryEntities": []
                }
              ]
            }
          },
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": false,
                  "personas": "uses Personas from \"std/behaviors/std-dev-personas\"\norbital DevLogin = Personas.orbitals.DevPersonasOrbital {\n  entity DevPersona [persistent: team_members]\n  traits { DevPersonas { config { autoSignIn: \"owner\" } } }\n}\n",
                  "personasCollection": "team_members",
                  "personasSignIn": "owner",
                  "personaTrait": "DevPersonas"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control: a program without an identity entity has no personas text",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
              "name": "a",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "Deal",
                    "collection": "deals",
                    "fields": [
                      {
                        "name": "id"
                      }
                    ]
                  },
                  "auxiliaryEntities": []
                }
              ]
            }
          },
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": false,
                  "personas": "",
                  "personasCollection": "",
                  "personasSignIn": "",
                  "defaultRole": "",
                  "personaTrait": ""
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control: a program whose trait already handles PERSONA_ACT_AS has no personas text",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
              "name": "a",
              "orbitals": [
                {
                  "name": "O",
                  "entity": {
                    "name": "TeamMember",
                    "collection": "team_members",
                    "identity": true,
                    "fields": [
                      {
                        "name": "id"
                      },
                      {
                        "name": "role",
                        "values": [
                          "owner",
                          "manager",
                          "admin"
                        ]
                      }
                    ]
                  },
                  "auxiliaryEntities": [],
                  "traits": [
                    {
                      "stateMachine": {
                        "transitions": [
                          {
                            "event": "PERSONA_ACT_AS"
                          }
                        ]
                      },
                      "name": "MemberDevPersonas"
                    }
                  ]
                }
              ]
            }
          },
          "entity": {
            "id": "m"
          },
          "expect": {
            "fired": true,
            "state": "ready",
            "emits": [
              {
                "event": "MARKS_CHECKED",
                "payload": {
                  "marked": false,
                  "personas": "",
                  "personasCollection": "",
                  "personasSignIn": "",
                  "personaTrait": "MemberDevPersonas",
                  "defaultRole": "owner"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "edge: an identity entity with no declared role values signs in as nobody",
      "steps": [
        {
          "trait": "MarksCheck",
          "from": "ready",
          "event": "MARKS_CHECK",
          "payload": {
            "program": {
