  {
   "id": "no-shape-answer",
   "steps": [
    {
     "event": "MOCK_ANSWER",
     "payload": {
      "action": "send",
      "shape": {}
     },
     "expect": {
      "emits": [
       {
        "event": "MOCK_ANSWERED",
        "payload": {
         "answer": "{\"_action\":\"send\",\"_mock\":true,\"success\":true}"
        }
