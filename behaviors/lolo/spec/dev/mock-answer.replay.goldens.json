{
  "atom": "dev/atoms/std-mock-answer.lolo",
  "trait": "MockAnswerer",
  "note": "nested descriptors fold with tree/fold; a registry type string t is the descriptor { type: t }. A descriptor without a type never reaches the atom: the kernel's payload check refuses MOCK_ANSWER (\"shape.f.type (missing ...)\"), which a replay case cannot express",
  "cases": [
    {
      "id": "flat-string",
      "steps": [
        {
          "event": "MOCK_VALUE",
          "payload": {
            "key": "f",
            "type": "string"
          },
          "expect": {
            "emits": [
              {
                "event": "MOCK_ANSWERED",
                "payload": {
                  "answer": "\"mock_f\""
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "flat-union-falls-to-string",
      "steps": [
        {
          "event": "MOCK_VALUE",
          "payload": {
            "key": "f",
            "type": "number | null"
          },
          "expect": {
            "emits": [
              {
                "event": "MOCK_ANSWERED",
                "payload": {
                  "answer": "\"mock_f\""
                }
              }
            ]
          }
        }
      ]
    },
    {
