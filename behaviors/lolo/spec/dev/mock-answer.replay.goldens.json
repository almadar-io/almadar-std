{
 "atom": "dev/atoms/std-mock-answer.lolo",
 "trait": "MockAnswerer",
 "note": "nested descriptors (array-of-objects, map-value, control-array-without-items, malformed-*) stay in the Rust host (mock_answer.rs); the atom has no event for them",
 "cases": [
  {
   "id": "flat-string",
   "steps": [
    {
     "event": "MOCK_VALUE",
     "payload": {
      "key": "f",
      "type": "string"
     },
     "expect": {
      "emits": [
       {
        "event": "MOCK_ANSWERED",
        "payload": {
         "answer": "\"mock_f\""
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "flat-union-falls-to-string",
   "steps": [
    {
     "event": "MOCK_VALUE",
     "payload": {
      "key": "f",
      "type": "number | null"
     },
     "expect": {
      "emits": [
       {
        "event": "MOCK_ANSWERED",
        "payload": {
         "answer": "\"mock_f\""
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "flat-array-suffix",
