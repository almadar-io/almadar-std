{
 "atom": "spec/dev/mock-seed-access-fixture.lolo",
 "trait": "MockSeed",
 "note": "Restamp changes carry an explicit row target: singleton for a [runtime] registration (its storage key survives a rekey), else the changed row key (the old id for a rekey). The stamp right after seeding is firstOwner; a persona switch restamps only under config restampOnPersona (default false) and otherwise answers no changes.",
 "cases": [
  {
   "id": "restamp-target-runtime-entity-set-is-singleton",
   "steps": [
    {
     "event": "INIT",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "CORPUS_ASK",
        "payload": {}
       },
       {
        "event": "CORPUS_IS",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "DS_WRITE_CHUNK",
     "payload": {
      "ops": [
       [
        "create",
        "Task",
        {
         "id": "t1",
         "ownerRef": "old"
        }
       ]
      ]
     },
     "expect": {
      "fired": true,
      "neverEmits": [
       "DS_CHUNK_REFUSED"
      ]
     }
    },
    {
     "event": "RESTAMP_INPUT",
     "payload": {
      "program": {
       "orbitals": [
        {
         "entity": {
          "name": "Person",
          "identity": true,
          "collection": "people",
          "fields": [
           {
            "name": "id",
            "type": "string",
            "required": true
           },
           {
            "name": "role",
            "type": "string"
           }
          ]
         }
        },
        {
         "entity": {
          "name": "Task",
          "collection": "tasks",
          "fields": [
           {
            "name": "id",
            "type": "string",
            "required": true
           },
           {
            "name": "ownerRef",
            "type": "string"
           }
          ],
          "persistence": "runtime"
         }
        }
       ]
      },
      "stores": {
       "people": [
        {
         "id": "agent",
         "role": "agent"
        },
        {
         "id": "reader",
         "role": "reader"
        }
       ],
       "tasks": [
        {
         "id": "t1",
         "ownerRef": "old"
        }
       ]
      },
      "journal": {
       "viewerId": "old",
       "stamped": [
        {
         "store": "tasks",
         "id": "t1",
         "column": "ownerRef"
        }
       ],
       "deferred": []
      },
      "viewer": {
       "id": "new",
       "role": "reader",
       "name": "New viewer"
      },
      "firstOwner": true
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "RESTAMP_DONE",
        "payload": {
         "journal": {
          "viewerId": "new",
          "stamped": [
           {
            "store": "tasks",
            "id": "t1",
            "column": "ownerRef"
           }
          ],
          "deferred": []
         },
         "changes": [
          {
           "kind": "set",
           "store": "tasks",
           "id": "t1",
           "column": "ownerRef",
           "ownerId": "new",
           "target": {
            "kind": "singleton"
           }
          }
         ]
        }
       }
      ],
      "emitCounts": {
       "RESTAMP_DONE": 1
      },
      "neverEmits": [
       "DATASET_FAILED"
      ]
     }
    }
   ]
  },
