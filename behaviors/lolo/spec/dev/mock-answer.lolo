app mock-answer-spec [
  version: "1.0.0",
  description: "Design contract for the mock call-service answer (twin of mockServiceAnswer; the Rust mock_answer.rs is retired, archived 2026-10-23): an action's answer is built from the responseShape the services registry declares, no randomness and no clock. An action with no responseShape answers {success: true, _mock: true, _action: <action>}. A flat descriptor (a string, or an object with a type and no items/properties/mapValue) answers by its type: a type ending in [] gives [], number gives 42, boolean gives true, object gives {}, anything else gives the string mock_<key> (so 'number | null' gives mock_f). A descriptor with items or a type ending in [] or equal to array gives a one-element array of the items descriptor under key <key>Item, or [] when items is absent or falsy; properties give an object of each property's mock value; mapValue gives {sample: <mock of mapValue>}; any other nested descriptor gives {}. A descriptor with no string type, a non-object properties, or a non-descriptor value is malformed. Unknown service and unknown action are refused (No mock response for action: <service>.<action>). Goldens: mock-answer.goldens.json. std-mock-answer answers every descriptor (tree/fold): its MOCK_ANSWER takes each descriptor as a record { type, items?, properties?, mapValue? } (a registry type string t is { type: t }), its answer is JSON text with sorted keys, and a descriptor without a type is refused by the payload check. The registry lookup and its refusals belong to whoever routes a call-service to the atom (no seam yet, P-008)."
]

orbital MockAnswerSpec {
  expects entity MockAnswerRun [runtime] {
    id : string!
    action : string
    key : string
    descriptorType : string
    answer : string
  }
  expects trait MockAnswerer {
    state ready
    state ready { MOCK_ANSWER -> ready  MOCK_VALUE -> ready }
    emits { MOCK_ANSWERED }
  }
  expects page boot -> MockAnswerer
}
