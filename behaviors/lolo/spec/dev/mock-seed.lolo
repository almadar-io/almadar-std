app mock-seed-spec [
  version: "1.0.0",
  description: "Design contract for mock row synthesis from declared fields: a field tree walked into cells and a nested value, the gates in order (intrinsic, honored default, declared mock, projection, vocabulary, type), relative mock dates resolved against the stream clock, the same row ordinal always yielding the same index-strategy value, and a whole dataset derived from a program: identity store first, rows with stamps from one stream, owner columns stamped for the viewer, later registrants backfilled, relations and projected fields linked."
]

orbital MockSeedSpec {
  expects entity MockCell [runtime] {
    id : string!
    rng : number
    words : [string]
  }
  expects trait MockSeed {
    state ready
    state ready { INIT -> ready  CORPUS_IS -> ready  WALK_START -> ready  WALK_ROW -> ready  SEED_STREAM -> ready  SEED_ROW -> ready  SAMPLE_ROWS -> ready  ROWS_NEXT -> ready  WALKED -> ready  DATASET_START -> ready  DS_OWNS_ENV -> ready  DS_OWNS_ENV_FAILED -> ready  DS_PROGRAM_FAILED -> ready  DS_PROGRAM_READ -> ready  DS_STORE -> ready  DS_LINKS -> ready  DS_STAMP -> ready  DS_OLINK -> ready  DS_PROJS -> ready  AC_ASK -> ready  AC_ANSWER -> ready  AC_FAILED -> ready  AC_DONE -> ready  DERIVE_OWNERS -> ready }
    emits { WALKED  ROWS_DONE  SEED_ROW_DONE  STREAM_SEEDED  DATASET_DONE  DATASET_FAILED  OWNERS_DERIVED }
  }
  expects page "/mock-seed" -> MockSeed
}
