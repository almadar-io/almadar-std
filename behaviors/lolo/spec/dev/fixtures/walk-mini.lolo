app mini [
  version: "1.0.0",
  description: "mini walk fixture"
]
orbital Mini {
  entity Item [runtime] {
    id : string!
    title : string!
  }
  trait Flow -> Item [client] {
    initial: idle
    state idle {
      INIT -> idle
      GO -> done
    }
    state done {
      INIT -> done
      BACK -> idle
    }
  }
  page boot as MiniStart -> Flow
}
