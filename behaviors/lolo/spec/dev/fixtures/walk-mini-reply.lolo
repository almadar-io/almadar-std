app mini-reply [
  version: "1.0.0",
  net: { "example.test:443": [tcp] },
  description: "walk fixture with an http failure route"
]
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"
uses Timeout from "std/behaviors/std-timeout"
type HttpHeader = { name : string!, value : string! }
orbital MiniReply {
  entity Item [runtime] {
    id : string!
    title : string!
  }
  trait MiniHttpFrame = Frame.traits.HttpFrame {
    listens {
      MiniHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait MiniHttp = Http.traits.HttpClient {
    config {
      host: "example.test"
      port: 443
      tls: true
      serverName: "example.test"
    }
    listens {
      Caller.CALL_HTTP_SEND -> HTTP_SEND
      MiniTimeout.TIMED_OUT -> HTTP_CANCEL with { key: ?key }
      MiniHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      MiniHttpFrame.FRAME_DRAINED -> HC_DRAINED
      MiniHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }
  trait MiniTimeout = Timeout.traits.Timeout {
    config {
      timeoutMs: 30000
      cancelOnDeadline: false
    }
    listens {
      Caller.CALL_HTTP_SEND -> START with { key: (as ?key CallKey) }
      MiniHttp.HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      MiniHttp.HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }
  trait Caller -> Item [client] {
    initial: waiting
    state waiting {
      INIT -> waiting
      CALL -> waiting
        (emit CALL_HTTP_SEND { key: "x", method: "GET", target: "/x", headers: [], body: (bytes/from-string ""), stream: "none" })
      CALLED -> waiting
      CALL_FAILED -> failed
        (render-ui main { type: "alert", variant: "error", message: "Call failed" })
    }
    state failed {
      INIT -> failed
    }
    emits {
      CALL_HTTP_SEND {
        key : string!
        method : string!
        target : string!
        headers : [HttpHeader]!
        body : bytes!
        stream : string!
      }
    }
    listens {
      CALL { }
      CALLED {
        status : number!
      }
      CALL_FAILED {
        error : string!
        kind : string!
      }
      MiniHttp.HTTP_REPLIED -> CALLED with { status: ?status }
      MiniHttp.HTTP_FAILED -> CALL_FAILED with { error: ?error, kind: ?kind }
      MiniTimeout.TIMED_OUT -> CALL_FAILED with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" }
    }
  }
  page "/mini-reply" as MiniReplyPage -> Caller, MiniHttp, MiniHttpFrame, MiniTimeout
}
