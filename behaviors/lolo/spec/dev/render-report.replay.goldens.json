    {
      "id": "unsupported-message-names-pattern-renderer-version (renderer_coverage.rs:75)",
      "steps": [
        {
          "event": "UNSUPPORTED_MESSAGE",
          "payload": {
            "pattern": "zz-sprite",
            "renderer": "rust-test",
            "version": "1.2.3"
          },
          "expect": {
            "emits": [
              {
                "event": "REPORT_RESULT",
                "payload": {
                  "message": "pattern `zz-sprite` is not supported by renderer rust-test 1.2.3"
                }
              }
            ]
          }
        }
      ]
    },
