{
  "atom": "dev/atoms/std-render-report.lolo",
  "trait": "RenderReporter",
  "cases": [
    {
      "id": "offenders-counted-and-listed-once-sorted (render_report.rs:89)",
      "steps": [
        {
          "event": "RENDER_VERDICT",
          "payload": {
            "name": "renderer_coverage",
            "offenders": [
              "b",
              "a",
              "b"
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "REPORT_RESULT",
                "payload": {
                  "name": "renderer_coverage",
                  "passed": false,
                  "detail": "3 offender(s): a, b"
                }
              }
            ]
          }
        }
      ]
    },
    {
