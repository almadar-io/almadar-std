{
  "atom": "dev/atoms/std-review-pins.lolo",
  "trait": "ReviewOpener",
  "cases": [
    {
      "id": "a review row that names a program file opens that file without the catalog",
      "config": {
        "reviews": [
          {
            "name": "friday",
            "version": "1.1.0",
            "behavior": "pkg/friday",
            "label": "Friday",
            "route": "/projects",
            "path": "/srv/orb/apps/friday/current/app.orb"
          }
        ]
      },
      "steps": [
        {
          "event": "INIT",
          "payload": {
            "name": "friday",
            "version": "1.1.0"
          },
          "entity": {
            "id": "o",
            "wanted": "",
            "leaves": [],
            "listed": false,
            "openedBehavior": "",
            "openedRoute": "",
            "openedPath": ""
          },
          "from": "idle",
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "GUEST_START_ROUTE",
                "payload": {
                  "route": "/projects"
                }
              },
              {
                "event": "LOAD_PROGRAM_FILE",
                "payload": {
                  "path": "/srv/orb/apps/friday/current/app.orb"
                }
              }
            ],
            "neverEmits": [
              "LOAD_BEHAVIOR"
            ]
          }
        }
      ]
    },
    {
      "id": "CONTROL a review row without a program file waits for the catalog",
      "config": {
        "reviews": [
          {
            "name": "friday",
            "version": "1.1.0",
            "behavior": "pkg/friday",
            "label": "Friday",
            "route": "/projects"
          }
        ]
      },
      "steps": [
        {
          "event": "INIT",
          "payload": {
            "name": "friday",
            "version": "1.1.0"
          },
          "entity": {
            "id": "o",
            "wanted": "",
            "leaves": [],
            "listed": false,
            "openedBehavior": "",
            "openedRoute": "",
            "openedPath": ""
          },
          "from": "idle",
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "GUEST_START_ROUTE"
              }
            ],
            "neverEmits": [
              "LOAD_PROGRAM_FILE"
            ]
          }
        }
      ]
    }
  ]
}
