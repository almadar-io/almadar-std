    {
      "id": "the-slide-sign-marks-the-x-translate-inline (motion.rs:347)",
      "steps": [
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateX(calc(24px * var(--motion-enter-slide-sign)))"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": true,
                  "scale": 1,
                  "translateX": 24,
                  "translateY": 0,
                  "inlineSigned": true
                }
              }
            ]
          }
        },
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateX(24px)"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": true,
                  "scale": 1,
                  "translateX": 24,
                  "translateY": 0,
                  "inlineSigned": false
                }
              }
            ]
          }
        },
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateY(calc(8px * var(--motion-enter-slide-sign)))"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": false,
                  "error": "`calc(8px * var(--motion-enter-slide-sign))` is not a px length"
                }
              }
            ]
          }
        }
      ]
    },
    {
