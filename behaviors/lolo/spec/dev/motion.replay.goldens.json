    {
      "id": "signed-and-unsigned-x-translates-conflict-with-controls",
      "steps": [
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateX(8px) translateX(calc(8px * var(--motion-enter-slide-sign)))"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": false,
                  "error": "a signed and an unsigned x translate in one transform"
                }
              }
            ]
          }
        },
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateX(calc(8px * var(--motion-enter-slide-sign))) translateX(8px)"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": false,
                  "error": "a signed and an unsigned x translate in one transform"
                }
              }
            ]
          }
        },
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateX(calc(8px * var(--motion-enter-slide-sign))) translateX(0)"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": true,
                  "scale": 1,
                  "translateX": 8,
                  "translateY": 0,
                  "inlineSigned": true
                }
              }
            ]
          }
        },
        {
          "event": "PARSE_TRANSFORM",
          "payload": {
            "raw": "translateX(0) translateX(calc(8px * var(--motion-enter-slide-sign)))"
          },
          "expect": {
            "emits": [
              {
                "event": "TRANSFORM_RESULT",
                "payload": {
                  "ok": true,
                  "scale": 1,
                  "translateX": 8,
                  "translateY": 0,
                  "inlineSigned": true
                }
              }
            ]
          }
        }
      ]
    },
