    {
      "id": "a-theme-overrides-shapes-and-entry-and-a-bad-token-keeps-the-base (motion.rs:377)",
      "steps": [
        {
          "event": "RESOLVE_MOTION",
          "payload": {
            "motion": {
              "shapes": {
                "modalEnter": "none",
                "toastEnter": "rotate(3deg)",
                "enterSlide": "translateX(calc(32px * var(--motion-enter-slide-sign)))"
              },
              "entry": {
                "default": "rise",
                "stagger": "0.06s"
              }
            }
          },
          "expect": {
            "emits": [
              {
                "event": "MOTION_RESOLVED",
                "payload": {
                  "entryDefault": "rise",
                  "staggerMs": 60,
                  "shapes": {
                    "modalEnter": {
                      "scale": 1,
                      "translateX": 0,
                      "translateY": 0,
                      "inlineSigned": false
                    },
                    "modalExit": {
                      "scale": 0.92,
                      "translateX": 0,
                      "translateY": 14.72,
                      "inlineSigned": false
                    },
                    "popoverEnter": {
                      "scale": 0.95,
                      "translateX": 0,
                      "translateY": 0,
                      "inlineSigned": false
                    },
                    "popoverExit": {
                      "scale": 0.95,
                      "translateX": 0,
                      "translateY": 0,
                      "inlineSigned": false
                    },
                    "toastEnter": {
                      "scale": 1,
                      "translateX": 0,
                      "translateY": 16,
                      "inlineSigned": false
                    },
                    "toastExit": {
                      "scale": 1,
                      "translateX": 0,
                      "translateY": 16,
                      "inlineSigned": false
                    },
                    "pageEnter": {
                      "scale": 1,
                      "translateX": 0,
                      "translateY": 8,
                      "inlineSigned": false
                    },
                    "enterRise": {
                      "scale": 1,
                      "translateX": 0,
                      "translateY": 12,
                      "inlineSigned": false
                    },
                    "enterScale": {
                      "scale": 0.96,
                      "translateX": 0,
                      "translateY": 0,
                      "inlineSigned": false
                    },
                    "enterSlide": {
                      "scale": 1,
                      "translateX": 32,
                      "translateY": 0,
                      "inlineSigned": true
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
