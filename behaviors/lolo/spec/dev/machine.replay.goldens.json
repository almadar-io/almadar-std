    {
      "id": "mount-embeds-transitively-through-trait-refs",
      "steps": [
        {
          "event": "MACHINE_FACTS_READ",
          "payload": {
            "program": {
              "orbitals": [
                {
                  "name": "Shell",
                  "traits": [
                    {
                      "name": "Main",
                      "config": {
                        "tab": {
                          "type": "string",
                          "default": "@trait.Mid"
                        }
                      }
                    },
                    {
                      "name": "Mid",
                      "stateMachine": {
                        "events": [],
                        "transitions": [
                          {
                            "from": "idle",
                            "event": "INIT",
                            "to": "idle",
                            "effects": [
                              [
                                "render-ui",
                                "main",
                                {
                                  "type": "stack",
                                  "children": [
                                    "@trait.Main",
                                    {
                                      "type": "box",
                                      "child": "@trait.Leaf.view"
                                    }
                                  ]
                                }
                              ]
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "name": "Leaf",
                      "stateMachine": {
                        "events": [],
                        "transitions": [
                          {
                            "from": "idle",
                            "event": "INIT",
                            "to": "idle",
                            "effects": [
                              [
                                "emit",
                                "X",
                                {
                                  "to": "@trait.Ghost"
                                }
                              ]
                            ]
                          }
                        ]
                      }
                    },
                    {
                      "name": "Other"
                    }
                  ],
                  "pages": [
                    {
                      "name": "home",
                      "path": "/home",
                      "traits": [
                        {
                          "ref": "Main",
                          "refId": "m"
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "expect": {
            "emits": [
              {
                "event": "MACHINE_FACTS",
                "payload": {
                  "routes": [],
                  "mounts": [
                    {
                      "orbital": "Shell",
                      "page": "home",
                      "path": "/home",
                      "protocol": "",
                      "listed": [
                        "Main"
                      ],
                      "embedded": [
                        "Mid",
                        "Leaf"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
