{
  "atom": "dev/atoms/std-machine.lolo",
  "trait": "Machine",
  "note": "Hand-computed from spec/dev/machine.lolo: routes per listens entry, mounts per page with transitive @trait.Name embeds, and the unchanged MACHINE_READ rows.",
  "cases": [
    {
      "id": "routes-all-source-kinds-and-modifiers",
      "steps": [
        {
          "event": "MACHINE_FACTS_READ",
          "payload": {
            "program": {
              "orbitals": [
                {
                  "name": "Alpha",
                  "traits": [
                    {
                      "name": "Listener",
                      "listens": [
                        {
                          "event": "E_ANY"
                        },
                        {
                          "event": "E_W",
                          "triggers": "DO_W",
                          "source": {
                            "kind": "any"
                          }
                        },
                        {
                          "event": "E_T",
                          "source": {
                            "kind": "trait",
                            "trait": "Peer"
                          }
                        }
                      ]
                    },
                    {
                      "name": "Peer"
                    }
                  ]
                },
                {
                  "name": "Beta",
                  "traits": [
                    {
                      "name": "Remote",
                      "listens": [
                        {
                          "event": "E_O",
                          "source": {
                            "kind": "orbital",
                            "orbital": "Alpha",
                            "trait": "Peer"
                          }
                        },
                        {
                          "event": "E_K",
                          "triggers": "GO",
                          "key": "@payload.id",
                          "guard": [
                            "=",
                            "@payload.x",
                            1
                          ],
                          "payloadMapping": {
                            "a": "@payload.a"
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          },
          "expect": {
            "emits": [
              {
                "event": "MACHINE_FACTS",
                "payload": {
                  "routes": [
                    {
                      "orbital": "Alpha",
                      "trait": "Listener",
                      "at": 0,
                      "trigger": "E_ANY",
                      "event": "E_ANY",
                      "sourceKind": "any",
                      "sourceOrbital": "",
                      "sourceTrait": "",
                      "keyed": false,
                      "guarded": false,
                      "mapped": false
                    },
                    {
                      "orbital": "Alpha",
                      "trait": "Listener",
                      "at": 1,
                      "trigger": "DO_W",
                      "event": "E_W",
                      "sourceKind": "any",
                      "sourceOrbital": "",
                      "sourceTrait": "",
                      "keyed": false,
                      "guarded": false,
                      "mapped": false
                    },
                    {
                      "orbital": "Alpha",
                      "trait": "Listener",
                      "at": 2,
                      "trigger": "E_T",
                      "event": "E_T",
                      "sourceKind": "trait",
                      "sourceOrbital": "Alpha",
                      "sourceTrait": "Peer",
                      "keyed": false,
                      "guarded": false,
                      "mapped": false
                    },
                    {
                      "orbital": "Beta",
                      "trait": "Remote",
                      "at": 0,
                      "trigger": "E_O",
                      "event": "E_O",
                      "sourceKind": "orbital",
                      "sourceOrbital": "Alpha",
                      "sourceTrait": "Peer",
                      "keyed": false,
                      "guarded": false,
                      "mapped": false
                    },
                    {
                      "orbital": "Beta",
                      "trait": "Remote",
                      "at": 1,
                      "trigger": "GO",
                      "event": "E_K",
                      "sourceKind": "any",
                      "sourceOrbital": "",
                      "sourceTrait": "",
                      "keyed": true,
                      "guarded": true,
                      "mapped": true
                    }
                  ],
                  "mounts": []
                }
              }
            ]
          }
        }
      ]
    },
