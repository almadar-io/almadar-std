    {
      "id": "mount-embeds-across-orbitals-and-not-from-ticks",
      "steps": [
        {
          "event": "MACHINE_FACTS_READ",
          "payload": {
            "program": {
              "orbitals": [
                {
                  "name": "A",
                  "traits": [
                    {
                      "name": "Host",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "s",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "s",
                            "to": "s",
                            "event": "INIT",
                            "effects": [
                              [
                                "render-ui",
                                "main",
                                {
                                  "type": "stack",
                                  "children": [
                                    "@trait.Far"
                                  ]
                                }
                              ]
                            ]
                          }
                        ]
                      },
                      "ticks": [
                        {
                          "name": "t",
                          "effects": [
                            [
                              "render-ui",
                              "main",
                              "@trait.TickOnly"
                            ]
                          ]
                        }
                      ]
                    },
                    {
                      "name": "TickOnly",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "s",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "s",
                            "to": "s",
                            "event": "INIT",
                            "effects": []
                          }
                        ]
                      }
                    }
                  ],
                  "pages": [
                    {
                      "name": "Home",
                      "path": "/",
                      "protocol": "route",
                      "traits": [
                        {
                          "ref": "Host"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "B",
                  "traits": [
                    {
                      "name": "Far",
                      "stateMachine": {
                        "states": [
                          {
                            "name": "s",
                            "isInitial": true
                          }
                        ],
                        "transitions": [
                          {
                            "from": "s",
                            "to": "s",
                            "event": "INIT",
                            "effects": []
                          }
                        ]
                      }
                    }
                  ],
                  "pages": []
                }
              ]
            }
          },
          "expect": {
            "emits": [
              {
                "event": "MACHINE_FACTS",
                "payload": {
                  "routes": [],
                  "mounts": [
                    {
                      "orbital": "A",
                      "page": "Home",
                      "path": "/",
                      "protocol": "route",
                      "listed": [
                        "Host"
                      ],
                      "embedded": [
                        "Far"
                      ]
                    }
                  ]
                }
              }
            ]
