    {
      "id": "hosts-chain-innermost-first-stamped-ids-before-config-refs-in-name-order",
      "steps": [
        {
          "event": "MACHINE_FACTS_READ",
          "payload": {
            "program": {
              "orbitals": [
                {
                  "name": "One",
                  "traits": [
                    {
                      "name": "Delta",
                      "id": "d1",
                      "config": {
                        "body": "@trait.Cee"
                      }
                    },
                    {
                      "name": "Bee",
                      "id": "b1",
                      "config": {
                        "child": "@trait.Cee.view"
                      }
                    },
                    {
                      "name": "Ay",
                      "id": "a1",
                      "traitEmbedIds": {
                        "Bee": "b1",
                        "Gone": "zz9"
                      }
                    },
                    {
                      "name": "Cee",
                      "id": "c1"
                    },
                    {
                      "name": "Ee",
