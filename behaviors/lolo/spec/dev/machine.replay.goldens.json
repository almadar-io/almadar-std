    {
      "id": "machine-read-rows-unchanged",
      "steps": [
        {
          "event": "MACHINE_READ",
          "payload": {
            "program": {
              "orbitals": [
                {
                  "name": "O",
                  "traits": [
                    {
                      "name": "T",
                      "stateMachine": {
                        "events": [
                          {
                            "key": "GO",
                            "payloadSchema": [
                              {
                                "name": "id",
                                "type": "string",
                                "required": true
                              }
                            ]
                          }
                        ],
                        "transitions": [
                          {
                            "from": "a",
                            "event": "GO",
                            "to": "b"
                          },
                          {
                            "from": "a",
                            "event": "GO",
                            "to": "b"
                          },
                          {
                            "from": "b",
                            "event": "BACK",
                            "to": "a",
                            "guard": [
                              "=",
                              1,
                              1
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              ]
            }
          },
          "expect": {
            "emits": [
              {
                "event": "MACHINE_ANSWERED",
                "payload": {
                  "rows": [
                    {
                      "orbital": "O",
                      "trait": "T",
                      "from": "a",
                      "event": "GO",
                      "to": "b",
                      "guarded": false,
                      "payload": [
                        {
                          "name": "id",
                          "type": "string",
                          "required": true
                        }
                      ]
                    },
                    {
                      "orbital": "O",
                      "trait": "T",
                      "from": "b",
                      "event": "BACK",
                      "to": "a",
                      "guarded": true,
                      "payload": []
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
