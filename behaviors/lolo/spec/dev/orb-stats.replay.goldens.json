  {
   "id": "the-pid-asks-ps-for-its-elapsed-time",
   "steps": [
    {
     "trait": "OrbStatsReader",
     "event": "ORB_PID",
     "payload": {
      "pid": 46666
     },
     "entity": {
      "id": "o",
      "version": "",
      "versionAsked": true
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "ORB_UPTIME_RUN",
        "payload": {
         "stage": "uptime",
         "argv": [
          "-o",
          "etime=",
          "-p",
          "46666"
         ]
        }
       }
      ]
     }
    }
   ]
  },
