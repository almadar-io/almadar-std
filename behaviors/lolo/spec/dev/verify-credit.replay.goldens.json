{
  "atom": "dev/atoms/std-verify-credit.lolo",
  "trait": "Credit",
  "cases": [
    {
      "id": "failure-route-credited-from-fired-hop",
      "steps": [
        {
          "event": "CREDIT_REQUEST",
          "payload": {
            "steps": [
              {
                "trait": "Caller",
                "from": "waiting",
                "event": "CALL",
                "fired": [
                  {
                    "trait": "Caller",
                    "from": "waiting",
                    "event": "CALL_FAILED",
                    "to": "failed"
                  }
                ]
              },
              {
                "trait": "Caller",
                "from": "waiting",
                "event": "CALL_FAILED",
                "fired": [],
                "reply": "failure"
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "CREDIT_ANSWERED",
                "payload": {
                  "credits": [
                    {
                      "index": 1,
                      "stateBefore": "waiting",
                      "stateAfter": "failed"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-different-event-not-credited",
      "steps": [
        {
          "event": "CREDIT_REQUEST",
          "payload": {
            "steps": [
              {
                "trait": "Caller",
                "from": "waiting",
                "event": "CALL",
                "fired": [
                  {
                    "trait": "Caller",
                    "from": "waiting",
                    "event": "OTHER",
                    "to": "failed"
                  }
                ]
              },
              {
                "trait": "Caller",
                "from": "waiting",
                "event": "CALL_FAILED",
                "fired": [],
                "reply": "failure"
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "CREDIT_ANSWERED",
                "payload": {
                  "credits": []
                }
              }
            ]
          }
        }
      ]
    },
