        {
          "event": "TRANSITIONS_OF",
          "payload": {
            "key": "k1",
            "path": "/w/a.lolo",
            "text": "app x"
          },
          "expect": {
            "state": "reading",
            "entity": {
              "key": "k1",
              "path": "/w/a.lolo"
            }
          }
        }
      ]
    },
    {
