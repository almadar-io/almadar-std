                  "endColumn": 9,
                  "exact": true,
                  "pointer": "orbitals[0].traits[0].stateMachine.transitions[0]",
                  "scopeEndLine": 2
                }
              ]
            }
          },
          "from": "reading",
          "expect": {
            "emits": [
              {
                "event": "TRANSITIONS",
                "payload": {
                  "key": "k1",
                  "path": "/w/a.lolo",
                  "items": [
                    {
                      "pointer": "orbitals[0].traits[0].stateMachine.transitions[0]",
                      "trait": "T",
                      "event": "INIT",
                      "from": "idle",
                      "to": "idle",
                      "fromRow": 5,
                      "fromCol": 6,
                      "toRow": 5,
                      "source": "f"
                    },
                    {
                      "pointer": "orbitals[0].traits[0].stateMachine.transitions[1]",
                      "trait": "T",
                      "event": "GO",
                      "from": "idle",
                      "to": "busy",
                      "fromRow": 6,
                      "fromCol": 6,
                      "toRow": 8,
                      "source": "g\nh\ni"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
