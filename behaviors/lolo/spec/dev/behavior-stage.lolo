app behavior-stage-spec [
  version: "1.1.0",
  description: "Design contract for showing a behavior value on a stage, stated once in std-guest-session so no host of a run-time program writes its own opener or restates the guest's listen block. GuestOpener takes STAGE_OPEN { behavior, integrations? } (a behavior value: resolved with behavior/resolve, then handed to GuestSession as GUEST_OPEN), STAGE_SHOW { program, integrations? } (an already resolved program) and STAGE_CLOSE (GUEST_RESET). A stage holds one guest: an open closes the one already there. integrations is the composer's choice of reach for that open and is stated to the session (GUEST_REACH) before the program; absent keeps the session's current reach. A behavior that does not resolve is the guest's error (GUEST_FAIL, shown as GUEST_ERROR). GuestSession answers GUEST_READY { guest, integrations } once the guest is open: guest is the session id program/inputs and program/dispatch take as their guest option, so the composer can operate what it opened. GuestSession hears the opener inside the atom, so a composer rebinds only GuestOpener's listens. The stage owns no rows: what is kept, for whom and with what reach is the composer's."
]

orbital BehaviorStageSpec {
  expects trait GuestOpener {
    state idle {
      STAGE_OPEN -> idle
      STAGE_SHOW -> idle
      STAGE_CLOSE -> idle
    }
    emits {
      GUEST_OPEN
      GUEST_FAIL { message : string! }
      GUEST_REACH { integrations : "mock" | "live"! }
      GUEST_RESET
    }
  }
  expects trait GuestSession {
    state idle {
      GUEST_REACH -> idle
    }
    state opening {
      GUEST_REACH -> opening
    }
    state live {
      GUEST_REACH -> live
    }
    emits {
      GUEST_READY { guest : string!  integrations : "mock" | "live"! }
    }
  }
}
