{
 "atom": "dev/atoms/std-guest-session.lolo",
 "trait": "GuestLocal",
 "cases": [
  {
   "id": "a-composed-mock-program-opens-local-with-its-seed-and-env",
   "steps": [
    {
     "trait": "GuestLocal",
     "event": "GUEST_LOCAL_OP",
     "payload": {
      "kind": "open",
      "program": {
       "name": "x",
       "orbitals": []
      },
      "seed": "MockDataMockSeed",
      "env": {
       "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
       "FIREBASE_PROJECT_ID": "demo-almadar"
      }
     },
     "entity": {
      "id": "l"
     },
     "from": "ready",
     "expect": {
      "fired": true,
      "state": "ready",
      "effects": [
       {
        "type": "program/open"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-marked-program-opens-local-with-no-seed",
   "steps": [
    {
     "trait": "GuestLocal",
     "event": "GUEST_LOCAL_OP",
     "payload": {
      "kind": "open",
      "marked": {
       "name": "x",
       "orbitals": []
      },
      "seed": "",
      "env": {
       "FIREBASE_AUTH_EMULATOR_HOST": "127.0.0.1:9099",
       "FIREBASE_PROJECT_ID": "demo-almadar"
      }
     },
     "entity": {
      "id": "l"
     },
     "from": "ready",
     "expect": {
      "fired": true,
      "state": "ready",
      "effects": [
       {
        "type": "program/open"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-an-open-with-no-program-fails",
   "steps": [
    {
     "trait": "GuestLocal",
     "event": "GUEST_LOCAL_OP",
     "payload": {
      "kind": "open",
      "seed": ""
     },
     "entity": {
      "id": "l"
     },
     "from": "ready",
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "GUEST_FAILED",
        "payload": {
         "error": "a local open carries no program"
        }
       }
      ],
      "neverEmits": [
       "GUEST_OPENED"
      ]
     }
    }
   ]
  },
  {
