      ]
     }
    }
   ],
   "defaults": [
    "WalkPlan",
    "VerifyWalkCli"
   ]
  },
  {
   "id": "a-refused-plan-fails-the-walk",
   "steps": [
    {
     "from": "planning",
     "event": "WALK_PLAN_REFUSED",
     "payload": {
      "error": "verify-plan: no initial state declared for trait O.T"
     },
     "expect": {
      "emits": [
       {
        "event": "WALK_FAILED",
        "payload": {
         "error": "verify-plan: no initial state declared for trait O.T"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-walk-started-without-a-viewer-asks-the-planner-from-the-start-event",
   "note": "the start event itself sets the entity viewer to null; seeding the entity instead of starting the walk skips that write, so a null into a non-optional WALK_PLAN_REQUEST field is only seen on this chain (G-STD-184)",
   "steps": [
    {
     "event": "VERIFY_WALK_START",
     "payload": {
      "file": "p.orb"
     }
    },
    {
     "from": "machine",
     "event": "WALK_MACHINE_ANSWERED",
     "entity": {
      "program": "{\"orbitals\": [{\"name\": \"O\", \"entity\": {\"name\": \"Item\", \"fields\": []}, \"traits\": [{\"name\": \"T\", \"linkedEntity\": \"Item\", \"stateMachine\": {\"states\": [{\"name\": \"a\", \"isInitial\": true}, {\"name\": \"b\"}], \"transitions\": [{\"from\": \"a\", \"to\": \"b\", \"event\": \"GO\", \"effects\": []}]}}]}]}"
     },
     "payload": {
      "rows": [
       {
        "orbital": "O",
        "trait": "T",
        "from": "a",
        "event": "GO",
        "to": "b",
        "guarded": false,
        "payload": []
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "WALK_PLAN_REQUEST",
        "payload": {
         "rows": [
          {
           "orbital": "O",
           "trait": "T",
           "from": "a",
           "event": "GO",
           "to": "b",
           "guarded": false,
           "payload": []
          }
         ]
        }
       }
      ]
     }
    }
   ]
  }
 ]
