     "from": "machine",
     "event": "WALK_MACHINE_ANSWERED",
     "entity": {
      "program": "{\"orbitals\": [{\"name\": \"O\", \"entity\": {\"name\": \"Item\", \"fields\": []}, \"traits\": [{\"name\": \"T\", \"linkedEntity\": \"Item\", \"stateMachine\": {\"states\": [{\"name\": \"a\", \"isInitial\": true}, {\"name\": \"b\"}], \"transitions\": [{\"from\": \"a\", \"to\": \"b\", \"event\": \"GO\", \"effects\": []}]}}]}]}"
     },
