      }
     ]
    },
    "owners": {}
   },
   "steps": [
    {
     "from": "machine",
     "event": "WALK_MACHINE_ANSWERED",
     "payload": {
      "rows": [
       {
        "orbital": "O",
        "trait": "T",
        "from": "a",
        "event": "GO",
        "to": "b",
        "guarded": false,
        "payload": []
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "WALK_PLAN_REQUEST",
        "payload": {
         "program": {
          "orbitals": [
           {
            "name": "O",
            "entity": {
             "name": "Item",
             "fields": []
            },
            "traits": [
             {
              "name": "T",
              "linkedEntity": "Item",
              "stateMachine": {
               "transitions": [
                {
                 "from": "a",
                 "to": "b",
                 "event": "GO",
                 "effects": []
                }
               ],
               "states": [
                {
                 "name": "a",
                 "isInitial": true
                },
                {
                 "name": "b"
                }
               ]
              }
             }
            ]
           }
          ]
         },
         "rows": [
          {
           "orbital": "O",
           "trait": "T",
           "from": "a",
           "event": "GO",
           "to": "b",
           "guarded": false,
           "payload": []
          }
         ],
         "viewer": null,
         "owners": {}
