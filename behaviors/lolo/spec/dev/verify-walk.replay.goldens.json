{
 "atom": "cli/atoms/std-verify-walk.lolo",
 "trait": "VerifyWalk",
 "cases": [
  {
   "id": "control-usage-error",
   "steps": [
    {
     "event": "VERIFY_WALK_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\":[],\"cwd\":\".\"}"
     },
     "expect": {
      "emits": [
       {
        "event": "VERIFY_WALK_ANSWERED",
        "payload": {
         "status": 400,
         "body": "usage: orb verify-walk <program.lolo>"
        }
       }
      ]
     },
     "trait": "VerifyWalkCli"
    },
    {
     "trait": "VerifyWalkCli",
     "from": "ready",
     "event": "VERIFY_WALK_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\":[\"f.lolo\"],\"cwd\":\".\"}"
     },
     "expect": {
      "emits": [
       {
        "event": "VERIFY_WALK_START",
        "payload": {
         "file": "f.lolo"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "viewer-and-owner-map-forwarded-to-planner",
   "entity": {
    "program": "{\"orbitals\": [{\"name\": \"O\", \"entity\": {\"name\": \"Item\", \"fields\": []}, \"traits\": [{\"name\": \"T\", \"linkedEntity\": \"Item\", \"stateMachine\": {\"transitions\": [{\"from\": \"a\", \"to\": \"b\", \"event\": \"GO\", \"effects\": []}]}}]}]}",
    "viewer": {
     "id": "viewer-7"
    },
    "owners": {
     "item": [
      "ownerId"
     ]
    }
   },
   "steps": [
    {
     "from": "machine",
     "event": "WALK_MACHINE_ANSWERED",
     "payload": {
      "rows": [
       {
        "orbital": "O",
        "trait": "T",
        "from": "a",
        "event": "GO",
        "to": "b",
        "guarded": false,
        "payload": []
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "WALK_PLAN_REQUEST",
        "payload": {
         "program": {
          "orbitals": [
           {
            "name": "O",
            "entity": {
             "name": "Item",
             "fields": []
            },
            "traits": [
             {
              "name": "T",
              "linkedEntity": "Item",
              "stateMachine": {
               "transitions": [
                {
                 "from": "a",
                 "to": "b",
                 "event": "GO",
                 "effects": []
                }
               ]
              }
             }
            ]
           }
          ]
         },
         "rows": [
          {
           "orbital": "O",
           "trait": "T",
           "from": "a",
           "event": "GO",
           "to": "b",
           "guarded": false,
           "payload": []
          }
         ],
         "viewer": {
          "id": "viewer-7"
         },
         "owners": {
          "item": [
           "ownerId"
          ]
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-call-whose-arguments-cannot-be-read-answers-500",
   "steps": [
    {
     "trait": "VerifyWalkCli",
     "from": "ready",
     "event": "VERIFY_WALK_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "not json"
     },
     "expect": {
      "emits": [
       {
        "event": "VERIFY_WALK_ANSWERED",
        "payload": {
         "status": 500,
         "body": "Error: the call's arguments could not be read"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-stored-program-that-cannot-be-read-back-fails-the-walk",
   "entity": {
    "program": "not json"
   },
   "steps": [
    {
     "from": "machine",
     "event": "WALK_MACHINE_ANSWERED",
     "payload": {
      "rows": [
       {
        "orbital": "O",
        "trait": "T",
        "from": "a",
        "event": "GO",
        "to": "b",
        "guarded": false,
        "payload": []
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "WALK_FAILED",
        "payload": {
         "error": "the program could not be read back"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "an-unreadable-machine-fails-the-walk",
   "steps": [
    {
     "from": "machine",
     "event": "WALK_MACHINE_UNREAD",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "WALK_FAILED",
        "payload": {
         "error": "the program could not be read as a machine"
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
