      "rows": [
       {
        "orbital": "O",
        "trait": "T",
        "from": "a",
        "event": "GO",
        "to": "b",
        "guarded": false,
        "payload": []
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "WALK_PLAN_REQUEST",
        "payload": {
         "rows": [
          {
           "orbital": "O",
           "trait": "T",
           "from": "a",
           "event": "GO",
           "to": "b",
           "guarded": false,
           "payload": []
          }
