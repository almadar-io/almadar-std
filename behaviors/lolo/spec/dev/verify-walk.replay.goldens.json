    {
     "event": "VERIFY_WALK_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\":[],\"cwd\":\".\"}"
     },
     "expect": {
      "emits": [
       {
        "event": "VERIFY_WALK_ANSWERED",
        "payload": {
         "status": 400,
         "body": "usage: orb verify-walk <program.lolo> [--as <role>] [--trait <name>] [--render]"
        }
       }
      ]
     },
     "trait": "VerifyWalkCli"
    },
    {
     "trait": "VerifyWalkCli",
     "from": "ready",
     "event": "VERIFY_WALK_CALLED",
     "payload": {
      "headers": {},
      "rawBody": "{\"argv\":[\"f.lolo\"],\"cwd\":\".\"}"
     },
     "expect": {
      "emits": [
       {
        "event": "VERIFY_WALK_START",
        "payload": {
         "file": "f.lolo"
        }
       }
      ]
     }
    }
   ]
  },
