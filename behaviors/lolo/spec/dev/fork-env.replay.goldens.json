{
 "atom": "dev/atoms/std-fork-env.lolo",
 "trait": "ForkEnv",
 "note": "Captured from buildForkEnv and forkProjectRoot in packages/almadar-playground-runtime/src/launcher.ts via tsx; credentialVars is the real allCredentialEnvVars() of @almadar/shell-web. The TS takes the schema file path and dirnames it; the atom takes the directory.",
 "cases": [
  {
   "id": "default-scrub-no-integration-env",
   "steps": [
    {
     "event": "FORK_ENV",
     "payload": {
      "base": {
       "PATH": "/usr/bin",
       "GITHUB_TOKEN": "real-github-token",
       "STRIPE_SECRET_KEY": "k",
       "ALMADAR_CREDENTIAL_MASTER_KEY": "real-master-key",
       "NODE_ENV": "production"
      },
      "credentialVars": [
       "ALMADAR_CREDENTIAL_MASTER_KEY",
       "ALMADAR_CREDENTIAL_MASTER_KEY_PREVIOUS"
      ],
      "allowReal": false,
      "agentMock": false,
      "mockLLM": false,
      "integrationEnv": {}
     },
     "expect": {
      "emits": [
       {
        "event": "FORK_ENV_BUILT",
        "payload": {
         "env": {
          "PATH": "/usr/bin",
          "GITHUB_TOKEN": "real-github-token",
          "STRIPE_SECRET_KEY": "k",
          "NODE_ENV": "development",
          "ALMADAR_INTEGRATIONS_MODE": "mock"
         }
        }
       }
      ]
     }
    }
   ]
  },
