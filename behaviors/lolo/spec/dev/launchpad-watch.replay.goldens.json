{
 "atom": "dev/organisms/std-launchpad.lolo",
 "trait": "StatsWatch",
 "cases": [
  {
   "id": "the-pids-of-started-programs-are-watched",
   "steps": [
    {
     "trait": "StatsWatch",
     "event": "PROGRAMS_CHANGED",
     "payload": {
      "running": [
       {
        "id": "almadar-std/std-ci-status",
        "behavior": "almadar-std/std-ci-status",
        "label": "std-ci-status",
        "kind": "route",
        "verb": "serve",
        "file": "/f/std-ci-status",
        "port": 3061,
        "url": "http://127.0.0.1:3061/",
        "pid": 123,
        "mock": false,
        "status": "running"
       },
       {
        "id": "almadar-std/std-aws-board",
        "behavior": "almadar-std/std-aws-board",
        "label": "std-aws-board",
        "kind": "route",
        "verb": "serve",
        "file": "/f/std-aws-board",
        "port": 3062,
        "url": "http://127.0.0.1:3062/",
        "pid": 456,
        "mock": false,
        "status": "running"
       }
      ]
     },
     "entity": {
      "id": "l"
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "STATS_WATCH",
        "payload": {
         "pids": [
          123,
          456
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-starting-program-has-no-pid-yet-and-is-not-watched",
   "steps": [
    {
     "trait": "StatsWatch",
     "event": "PROGRAMS_CHANGED",
     "payload": {
      "running": [
       {
        "id": "almadar-std/std-ci-status",
        "behavior": "almadar-std/std-ci-status",
        "label": "std-ci-status",
        "kind": "route",
        "verb": "serve",
        "file": "/f/std-ci-status",
        "port": 3061,
        "url": "http://127.0.0.1:3061/",
        "pid": 123,
        "mock": false,
        "status": "running"
       },
       {
        "id": "almadar-std/std-aws-board",
        "behavior": "almadar-std/std-aws-board",
        "label": "std-aws-board",
        "kind": "route",
        "verb": "serve",
        "file": "/f/std-aws-board",
        "port": 3062,
        "url": "http://127.0.0.1:3062/",
        "pid": 0,
        "mock": false,
        "status": "starting"
       }
      ]
     },
     "entity": {
      "id": "l"
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "STATS_WATCH",
        "payload": {
         "pids": [
          123
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "no-programs-watch-no-pids",
   "steps": [
    {
     "trait": "StatsWatch",
     "event": "PROGRAMS_CHANGED",
     "payload": {
      "running": []
     },
     "entity": {
      "id": "l"
     },
     "expect": {
      "fired": true,
      "exactEmits": [
       {
        "event": "STATS_WATCH",
        "payload": {
         "pids": []
        }
       }
      ]
     }
    }
   ]
  }
 ]
}