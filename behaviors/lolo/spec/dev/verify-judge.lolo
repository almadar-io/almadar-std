app verify-judge-spec [
  version: "1.0.0",
  description: "Design contract for std-verify-judge: the kernel's verdict logic (orbital-core verify/observers.rs effects_fired, plan_wire.rs judge_propositions) as data. JUDGE_REQUEST carries the items to judge (each a PlannedStep from std-verify-plan, the PlayedResult program/step answered for it and its rendered nodes) and the resolved program, judged in one event; JUDGE_ANSWERED returns one result per item, in order, with step_completed first and then the verdicts the efficacy manifests name for orb, each {name, passed, detail} exactly as the Rust Verdict, plus the classes not yet ported with their Rust reason. effects_fired: no authored effect of a planned step failed (offender detail 'trait:event type(target) failed: error'). effects_fired exempts a failed effect carrying a routed event (the http failure the program routed to its declared emit.failure). proposition_held reads PlayedResult.ensures (kernel-judged @ensures of the played arm, each {proposition, verdict held|broken|inconclusive, reason?, counterexample?}): a broken one is an offender (detail trait:from--event-->to @ensures <json>), inconclusive passes; the answer's proposition is broken (first, proposition as JSON text), else the first inconclusive with its reason, else held. entity_data_bound checks the render-probe node binding; inline or named binding with 0 rows is an offender unless readGated, and payload-unresolved is an offender. renderer_supported checks the same rendered nodes' dynamic, supported and stub flags; a dynamic, unsupported or stubbed pattern is an offender. A class the .lolo cannot judge yet is listed in unported, never passed."
]

type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type Verdict = { name : string!, passed : boolean!, detail : string! }
type Unported = { name : string!, reason : string! }
type PropositionVerdict = { verdict : string!, proposition : string, reason : string }
type JudgeOutcome = { verdicts : [Verdict]!, unported : [Unported]!, proposition : PropositionVerdict, accessScopedEmpty : [string]! }

orbital VerifyJudgeSpec {
  expects entity JudgeRun [runtime] {
    id : string!
    results : [JudgeOutcome]!
  }
  expects trait Judge {
    state ready
    emits {
      JUDGE_ANSWERED { results : [JudgeOutcome]! }
    }
  }
  expects page boot -> Judge
}
