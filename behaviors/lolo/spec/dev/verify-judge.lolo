app verify-judge-spec [
  version: "1.0.0",
  description: "Design contract for std-verify-judge: the kernel's verdict logic (orbital-core verify/observers.rs effects_fired, plan_wire.rs judge_propositions) as data. JUDGE_REQUEST carries one PlannedStep (std-verify-plan), the PlayedResult program/step answered for it, and the resolved program; JUDGE_ANSWERED returns the verdicts the efficacy manifests name for orb, each {name, passed, detail} exactly as the Rust Verdict, plus the classes not yet ported with their Rust reason. effects_fired: no authored effect of a planned step failed (offender detail 'trait:event type(target) failed: error'). A class the .lolo cannot judge yet is listed in unported, never passed."
]

type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type Verdict = { name : string!, passed : boolean!, detail : string! }
type Unported = { name : string!, reason : string! }

orbital VerifyJudgeSpec {
  expects entity JudgeRun [runtime] {
    id : string!
    verdicts : [Verdict]!
    unported : [Unported]!
  }
  expects trait Judge {
    state ready
    emits {
      JUDGE_ANSWERED { verdicts : [Verdict]!, unported : [Unported]! }
    }
  }
  expects page "/verify-judge" -> Judge
}
