{
  "atom": "dev/organisms/std-behavior-playground.lolo",
  "trait": "PlaygroundStage",
  "cases": [
    {
      "id": "a-loaded-behavior-hands-its-program-to-the-guest-session",
      "steps": [
        {
          "trait": "PlaygroundOpen",
          "event": "BEHAVIOR_LOADED",
          "payload": {
            "behavior": "almadar-std/std-x",
            "program": {
              "name": "std-x",
              "orbitals": []
            }
          },
          "entity": {
            "id": "p"
          },
          "from": "idle",
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "GUEST_OPEN",
                "payload": {
                  "program": {
                    "name": "std-x",
                    "orbitals": []
                  }
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
    {
      "id": "opening-another-behavior-resets-the-previous-guest",
      "steps": [
        {
          "trait": "PlaygroundStage",
          "event": "OPEN",
          "payload": {
            "behavior": "almadar-std/std-y"
          },
          "entity": {
            "id": "p",
            "status": "open",
            "guestHandle": "guest-1"
          },
          "from": "open",
          "expect": {
            "fired": true,
            "state": "opening",
            "effects": [
              {
                "type": "emit",
                "arg0": "GUEST_RESET"
              }
            ]
          }
        }
      ],
      "now": 1760531445678,
      "defaults": [
        "PlaygroundLoader"
      ]
    },
