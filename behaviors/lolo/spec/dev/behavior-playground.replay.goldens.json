  "cases": [
    {
      "id": "a-behavior-program-goes-to-the-guest-session-on-the-server",
      "steps": [
        {
          "trait": "PlaygroundOpen",
          "event": "BEHAVIOR_PROGRAM",
          "payload": {
            "behavior": "almadar-std/std-x",
            "program": {
              "name": "std-x",
              "orbitals": []
            }
          },
          "entity": {
            "id": "p"
          },
          "from": "idle",
          "expect": {
            "fired": true,
            "state": "idle",
            "emits": [
              {
                "event": "GUEST_OPEN",
                "payload": {
                  "program": {
                    "name": "std-x",
                    "orbitals": []
                  }
                }
              }
            ]
          }
        }
      ],
      "now": 1760531445678
    },
