    {
      "id": "a-traced-dispatch-is-forwarded-under-the-key",
      "steps": [
        {
          "trait": "PageTrace",
          "event": "PAGE_TRACE_ITEM",
          "payload": {
            "dispatch": {
              "seq": 3,
              "outcomes": [
                {
                  "trait": "A",
                  "from": "x",
                  "to": "y",
                  "event": "GO",
                  "executed": true,
                  "cost": {
                    "startNs": 1,
                    "ns": 5,
                    "allocs": 2,
                    "allocBytes": 64
                  }
                }
              ]
            }
          },
          "expect": {
            "fired": true,
            "state": "live",
            "exactEmits": [
              {
                "event": "PAGE_TRACED",
                "payload": {
                  "key": "p1",
                  "dispatch": {
                    "seq": 3,
                    "outcomes": [
                      {
                        "trait": "A",
                        "from": "x",
                        "to": "y",
                        "event": "GO",
                        "executed": true,
                        "cost": {
                          "startNs": 1,
                          "ns": 5,
                          "allocs": 2,
                          "allocBytes": 64
                        }
                      }
                    ]
                  }
                }
              }
            ]
          },
          "from": "live",
          "entity": {
            "id": "t",
            "key": "p1",
            "browser": [
              "A"
            ],
            "server": []
          }
        }
      ],
      "now": 1760531445678
