{
  "atom": "dev/atoms/std-launchpad-recents.lolo",
  "trait": "RecentsStore",
  "cases": [
    {
      "id": "an-add-before-the-file-is-read-reads-the-file-first",
      "steps": [
        {
          "trait": "RecentsStore",
          "event": "RECENT_ADD",
          "payload": {
            "behavior": "std/play",
            "label": "Playground",
            "kind": "route",
            "command": "",
            "route": ""
          },
          "entity": {
            "id": "r",
            "items": [],
            "loaded": false,
            "pending": []
          },
          "expect": {
            "fired": true,
            "effects": [
              {
                "type": "os/read-file"
              }
            ],
            "neverEmits": [
              "RECENTS_CHANGED",
              "RECENTS_LOADED"
            ],
            "entity": {
              "loaded": false,
              "items": []
            }
          }
        }
      ]
    },
    {
      "id": "the-read-puts-the-held-add-on-top-of-the-file-and-writes-both",
      "steps": [
        {
          "trait": "RecentsStore",
          "event": "RECENTS_READ",
          "payload": {
            "data": ""
          },
          "entity": {
            "id": "r",
            "items": [],
            "loaded": false,
            "pending": [
              {
                "behavior": "std/play",
                "label": "Playground",
                "kind": "route",
                "command": "",
                "route": "",
                "at": "2026-02-02T00:00:00.000Z"
              }
            ]
          },
          "expect": {
            "fired": true,
            "exactEmits": [
              {
                "event": "RECENTS_LOADED",
                "payload": {
                  "items": [
                    {
                      "behavior": "std/play",
                      "label": "Playground",
                      "kind": "route",
                      "command": "",
                      "route": "",
                      "at": "2026-02-02T00:00:00.000Z"
                    },
                    {
                      "behavior": "std/ci",
                      "label": "CI",
                      "kind": "route",
                      "command": "",
                      "route": "",
                      "at": "2026-01-01T00:00:00.000Z"
                    },
                    {
                      "behavior": "std/analytics",
                      "label": "Analytics",
                      "kind": "route",
                      "command": "",
                      "route": "",
                      "at": "2025-12-31T00:00:00.000Z"
                    }
                  ]
                }
              }
            ],
            "effects": [
              {
                "type": "os/mkdir"
              }
            ],
            "entity": {
              "loaded": true,
              "pending": []
            }
          }
        }
      ]
    },
