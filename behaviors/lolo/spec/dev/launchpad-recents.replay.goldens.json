      "id": "control-an-unreadable-file-keeps-the-held-add-and-writes-nothing",
      "steps": [
        {
          "trait": "RecentsStore",
          "event": "RECENTS_READ",
          "payload": {
            "data": "bm90IGEgbGlzdA=="
          },
          "entity": {
            "id": "r",
            "items": [],
            "loaded": false,
            "pending": [
              {
                "behavior": "std/play",
                "label": "Playground",
                "kind": "route",
                "command": "",
                "route": "",
                "at": "2026-02-02T00:00:00.000Z"
              }
            ]
          },
          "expect": {
            "fired": true,
            "exactEmits": [
              {
                "event": "RECENTS_FAILED",
                "payload": {
                  "error": "the recents file is not a list of launches"
                }
              }
            ],
            "entity": {
              "loaded": false,
              "pending": [
                {
                  "behavior": "std/play",
                  "label": "Playground",
                  "kind": "route",
                  "command": "",
                  "route": "",
