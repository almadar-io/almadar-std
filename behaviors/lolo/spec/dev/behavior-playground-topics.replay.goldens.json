{
  "atom": "dev/organisms/std-behavior-playground.lolo",
  "trait": "PlaygroundTopics",
  "cases": [
    {
      "id": "a-route-page-does-not-open-the-start-topic-before-its-behavior-is-known: on a behavior route the topics arrive without the start topic being opened",
      "steps": [
        {
          "event": "INIT",
          "payload": {
            "name": "std-accounting"
          },
          "entity": {
            "id": "p"
          },
          "from": "idle",
          "expect": {
            "fired": true,
            "state": "idle",
            "effects": [
              {
                "type": "set",
                "arg0": "@entity.routePending"
              }
            ]
          }
        },
        {
          "event": "TOPICS_LOADED",
          "payload": {
            "topics": [
              {
                "package": "@almadar/std",
                "topic": "ui/core",
                "count": 1
              },
              {
                "package": "@almadar/behaviors",
                "topic": "app",
                "count": 1
              }
            ]
          },
          "from": "idle",
          "expect": {
            "fired": true,
            "state": "idle",
            "effects": [
              {
                "type": "set",
                "arg0": "@entity.topics"
              },
              {
                "type": "emit",
                "arg0": "TOPICS_SHOWN"
              }
            ]
          }
        }
      ],
      "now": 1760531445678,
      "config": {
        "openPackage": "@almadar/std",
        "openTopic": "ui/core",
        "labels": [],
        "leaves": true,
        "leafIcons": []
      }
    },
