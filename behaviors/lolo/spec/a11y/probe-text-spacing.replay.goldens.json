{
 "atom": "a11y/atoms/std-a11y-probe-text-spacing.lolo",
 "trait": "TextSpacingProbe",
 "note": "std-a11y-probe-text-spacing with the page answers played as events. Every measure JSON of the fixture cases is the real result of the atom's expressions in headless Chrome with the WCAG 1.4.12 style injected and removed (probe-text-spacing.gen/record.py); the style text asserted is the one the knobs build. Regenerate with python3 -I probe-text-spacing.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN measures the clipped text before any change",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "expect": {
      "state": "baselining",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:base",
         "expression": "(() => { const sel = (e) => { const p = []; for (let n = e; n && n.nodeType === 1; n = n.parentElement) { if (n.id) { p.unshift('#' + CSS.escape(n.id)); break; } let i = 1; for (let s = n.previousElementSibling; s; s = s.previousElementSibling) { if (s.tagName === n.tagName) i++; } p.unshift(n.tagName.toLowerCase() + ':nth-of-type(' + i + ')'); } return p.join('>'); }; const out = []; for (const e of document.body.querySelectorAll('*')) { let own = false; for (const n of e.childNodes) { if (n.nodeType === 3 && n.nodeValue.trim().length > 0) { own = true; break; } } if (!own) continue; const cs = getComputedStyle(e); if (cs.overflowX === 'visible' && cs.overflowY === 'visible') continue; out.push({ selector: sel(e), snippet: e.cloneNode(false).outerHTML, overflowX: cs.overflowX, overflowY: cs.overflowY, scrollWidth: e.scrollWidth, clientWidth: e.clientWidth, scrollHeight: e.scrollHeight, clientHeight: e.clientHeight }); } return JSON.stringify({ elements: out }); })()"
        }
       }
      ],
      "entity": {
       "runKey": "k1",
       "pageUrl": "http://127.0.0.1:24680/",
       "baseline": [],
       "findings": []
      }
     }
    }
   ]
  },
