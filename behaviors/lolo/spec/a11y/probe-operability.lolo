app a11y-probe-operability-spec [
  version: "1.0.0",
  description: "Design contract for the operability probe (WCAG 2.1.1, 4.1.2): an element that looks clickable must be reachable and operable by keyboard. PROBE_RUN { key, pageUrl } on a tab already at pageUrl answers PROBE_DONE { key, probe, findings } or PROBE_FAILED { key, probe, error, code }. Page requests ride PAGE_MEASURE, PAGE_KEY and PAGE_NAVIGATE; the page is navigated to pageUrl again before PROBE_DONE."
]

type WcagRef = { criterion : string!, level : "A" | "AA" | "AAA"!, version : "2.0" | "2.1" | "2.2"! }
type A11yFinding = { id : string!, pageUrl : string!, rule : string!, wcag : [WcagRef]!, method : "engine" | "probe" | "llm"!, engines : [string]!, impact : "critical" | "serious" | "moderate" | "minor"!, confidence : "confirmed" | "needs-verification"!, selector : string!, snippet : string!, evidence : string!, count : number! }

orbital A11yProbeOperabilitySpec {
  expects entity OperabilityRun [runtime] {
    id : string!
  }
  expects trait OperabilityProbe {
    state idle {
      PROBE_RUN -> listing
    }
    emits {
      PAGE_MEASURE { key : string!  expression : string! }
      PAGE_KEY { key : string!  keyName : "Tab" | "Enter" | "Space" | "Escape" | "ArrowDown" | "ArrowUp" | "ArrowLeft" | "ArrowRight" | "Home" | "End"!  shift : boolean }
      PAGE_NAVIGATE { key : string!  url : string! }
      PROBE_DONE { key : string!  probe : string!  findings : [A11yFinding]! }
      PROBE_FAILED { key : string!  probe : string!  error : string!  code : string! }
    }
  }
  expects page boot -> OperabilityProbe
}
