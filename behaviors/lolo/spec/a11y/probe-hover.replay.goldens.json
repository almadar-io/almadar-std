 "trait": "HoverProbe",
 "note": "std-a11y-probe-hover with the page answers played as events. The measure JSON of each live case is the real result of the four measure knobs run in headless Chrome (probe-hover.gen/gen_goldens.py, with a real Escape key through CDP) on hover-content-fail and hover-content-pass; the expressions asserted are probe-hover.gen/*.measure.js. Regenerate with python3 -I probe-hover.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN asks the page for the declared trigger elements",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "expect": {
      "state": "finding",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:find",
         "expression": "((selectors) => { const sel = (e) => { const p = []; for (let n = e; n && n.nodeType === 1; n = n.parentElement) { if (n.id) { p.unshift('#' + CSS.escape(n.id)); break; } let i = 1; for (let s = n.previousElementSibling; s; s = s.previousElementSibling) { if (s.tagName === n.tagName) i++; } p.unshift(n.tagName.toLowerCase() + ':nth-of-type(' + i + ')'); } return p.join('>'); }; return JSON.stringify({ triggers: Array.from(document.querySelectorAll(selectors)).map((e) => ({ selector: sel(e), snippet: e.cloneNode(false).outerHTML })) }); })(\"[aria-describedby],[aria-haspopup],[data-tooltip]\")"
        }
       }
      ]
     }
    }
   ]
  },
