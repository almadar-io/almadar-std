 "trait": "TextResizeProbe",
 "note": "std-a11y-probe-text-resize with the page answers played as events. Every measure JSON of the fixture cases is the real result of the atom's expressions in headless Chrome (probe-text-resize.gen/record.py); 200% text zoom was recorded as Chrome page zoom, a 640x400 CSS px viewport at device scale 2, because scaling the root font-size does not reach text sized in px. Regenerate with python3 -I probe-text-resize.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN reads the viewport meta tag under the run's step key",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:meta",
         "expression": "(() => { const m = document.querySelector('meta[name=viewport]'); const content = m ? m.getAttribute('content') : null; const pairs = content === null ? [] : content.split(/[,;]/).map((s) => s.trim()).filter((s) => s.length > 0).map((s) => { const i = s.indexOf('='); const name = (i < 0 ? s : s.slice(0, i)).trim().toLowerCase(); const value = (i < 0 ? '' : s.slice(i + 1)).trim().toLowerCase(); const n = parseFloat(value); return { name: name, value: value, number: Number.isNaN(n) ? null : n }; }); return JSON.stringify({ present: m !== null, snippet: m ? m.cloneNode(false).outerHTML : '', pairs: pairs }); })()"
        }
       }
      ],
      "entity": {
       "runKey": "k1",
       "pageUrl": "http://127.0.0.1:24680/",
       "baseline": [],
       "findings": []
      }
     }
    }
   ]
  },
