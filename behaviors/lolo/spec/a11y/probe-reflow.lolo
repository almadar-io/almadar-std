app a11y-probe-reflow-spec [
  version: "1.0.0",
  description: "Design contract for the reflow probe (WCAG 1.4.10): at a 320 CSS px wide viewport the page must not scroll horizontally. PROBE_RUN { key, pageUrl } on a tab already at pageUrl answers PROBE_DONE { key, probe, findings } or PROBE_FAILED { key, probe, error, code }. Page requests ride PAGE_VIEWPORT and PAGE_MEASURE; the viewport is restored before PROBE_DONE."
]

type WcagRef = { criterion : string!, level : "A" | "AA" | "AAA"!, version : "2.0" | "2.1" | "2.2"! }
type A11yFinding = { id : string!, pageUrl : string!, rule : string!, wcag : [WcagRef]!, method : "engine" | "probe" | "llm"!, engines : [string]!, impact : "critical" | "serious" | "moderate" | "minor"!, confidence : "confirmed" | "needs-verification"!, selector : string!, snippet : string!, evidence : string!, count : number! }

orbital A11yProbeReflowSpec {
  expects entity ReflowRun [runtime] {
    id : string!
  }
  expects trait ReflowProbe {
    state idle {
      PROBE_RUN -> narrowing
    }
    state restoring {
      PAGE_VIEWPORT_SET -> idle
    }
    emits {
      PAGE_VIEWPORT { key : string!  width : number!  height : number!  deviceScaleFactor : number!  mobile : boolean!  textZoom : number! }
      PAGE_MEASURE { key : string!  expression : string! }
      PROBE_DONE { key : string!  probe : string!  findings : [A11yFinding]! }
      PROBE_FAILED { key : string!  probe : string!  error : string!  code : string! }
    }
  }
  expects page boot -> ReflowProbe
}
