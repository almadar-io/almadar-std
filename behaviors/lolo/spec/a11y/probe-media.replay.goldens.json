{
 "atom": "a11y/atoms/std-a11y-probe-media.lolo",
 "trait": "MediaProbe",
 "note": "std-a11y-probe-media with the page answers played as events. The measure JSON of each live case is the real result of the measure knob run in headless Chrome (probe-media.gen/gen_goldens.py) on video-captions-fail, video-captions-pass and probe-media.gen/pages/media-extra.html; the expression asserted is probe-media.gen/media.measure.js. Regenerate with python3 -I probe-media.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN asks the page to measure under the run key",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "expect": {
      "state": "measuring",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:measure",
         "expression": "(() => { const sel = (e) => { const p = []; for (let n = e; n && n.nodeType === 1; n = n.parentElement) { if (n.id) { p.unshift('#' + CSS.escape(n.id)); break; } let i = 1; for (let s = n.previousElementSibling; s; s = s.previousElementSibling) { if (s.tagName === n.tagName) i++; } p.unshift(n.tagName.toLowerCase() + ':nth-of-type(' + i + ')'); } return p.join('>'); }; const refs = (e) => ['aria-describedby', 'aria-details'].reduce((n, a) => n + (e.getAttribute(a) || '').split(' ').filter((id) => id !== '' && document.getElementById(id) !== null).length, 0); const media = Array.from(document.querySelectorAll('video,audio')).map((e) => ({ kind: e.tagName.toLowerCase(), selector: sel(e), snippet: e.cloneNode(false).outerHTML, trackKinds: Array.from(e.querySelectorAll('track')).map((t) => t.kind), controls: e.hasAttribute('controls'), autoplay: e.hasAttribute('autoplay'), muted: e.hasAttribute('muted'), duration: Number.isFinite(e.duration) ? e.duration : null, transcriptRefs: refs(e) })); const frames = Array.from(document.querySelectorAll('iframe')).map((f) => ({ selector: sel(f), snippet: f.cloneNode(false).outerHTML, src: f.getAttribute('src') || '' })); return JSON.stringify({ media: media, frames: frames }); })()"
        }
       }
      ]
     }
    }
   ]
  },
  {
