app a11y-probe-media-spec [
  version: "1.0.0",
  description: "Design contract for the media probe (WCAG 1.2.x, 1.4.2): video and audio elements need captions, an audio description track and a transcript, and sound must not autoplay. PROBE_RUN { key, pageUrl } on a tab already at pageUrl measures the page once (PAGE_MEASURE) and answers PROBE_DONE { key, probe, findings } or PROBE_FAILED { key, probe, error, code }. The probe changes no page state."
]

type WcagRef = { criterion : string!, level : "A" | "AA" | "AAA"!, version : "2.0" | "2.1" | "2.2"! }
type A11yFinding = { id : string!, pageUrl : string!, rule : string!, wcag : [WcagRef]!, method : "engine" | "probe" | "llm"!, engines : [string]!, impact : "critical" | "serious" | "moderate" | "minor"!, confidence : "confirmed" | "needs-verification"!, selector : string!, snippet : string!, evidence : string!, count : number! }

orbital A11yProbeMediaSpec {
  expects entity MediaRun [runtime] {
    id : string!
  }
  expects trait MediaProbe {
    state idle {
      PROBE_RUN -> measuring
    }
    state measuring {
      PAGE_MEASURED -> idle
    }
    emits {
      PAGE_MEASURE { key : string!  expression : string! }
      PROBE_DONE { key : string!  probe : string!  findings : [A11yFinding]! }
      PROBE_FAILED { key : string!  probe : string!  error : string!  code : string! }
    }
  }
  expects page boot -> MediaProbe
}
