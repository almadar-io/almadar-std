           "selector": "html",
           "snippet": "<html>",
           "evidence": "",
           "count": 1
          }
         ]
        }
       }
      ]
     },
     "entity": {
      "runKey": "k1",
      "pageUrl": "http://127.0.0.1:24700/",
      "lang": "",
      "declared": ""
     }
    }
   ]
  },
