     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PROBE_DONE",
        "payload": {
         "key": "k1",
         "probe": "language",
         "findings": [
          {
           "id": "lang-missing:http://127.0.0.1:24700/",
           "pageUrl": "http://127.0.0.1:24700/",
           "rule": "lang-missing",
           "wcag": [
            {
             "criterion": "3.1.1",
             "level": "A",
