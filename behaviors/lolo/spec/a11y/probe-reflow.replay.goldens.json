{
 "atom": "a11y/atoms/std-a11y-probe-reflow.lolo",
 "trait": "ReflowProbe",
 "note": "std-a11y-probe-reflow with the page answers played as events. The measure JSON of the reflow-fail, reflow-pass and reflow-offender cases is the real result of the measure expression in headless Chrome at 320x256 (probe-reflow.gen/record.py). Regenerate with python3 -I probe-reflow.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN narrows the viewport to 320x256 under the run's step key",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "expect": {
      "state": "narrowing",
      "emits": [
       {
        "event": "PAGE_VIEWPORT",
        "payload": {
         "key": "k1:narrow",
         "width": 320,
         "height": 256,
         "deviceScaleFactor": 1,
         "mobile": false,
         "textZoom": 1
        }
       }
      ],
      "entity": {
       "runKey": "k1",
       "pageUrl": "http://127.0.0.1:24680/",
       "findings": []
      }
     }
    }
   ]
  },
  {
   "id": "the narrow viewport answer asks for the measurement with the allowed list embedded",
   "steps": [
    {
     "from": "narrowing",
     "event": "PAGE_VIEWPORT_SET",
     "entity": {
      "runKey": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "payload": {
      "key": "k1:narrow"
     },
     "expect": {
      "state": "measuring",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:measure",
         "expression": "((allowed) => { const de = document.documentElement; const vw = de.clientWidth; const sel = (e) => { const p = []; for (let n = e; n && n.nodeType === 1; n = n.parentElement) { if (n.id) { p.unshift('#' + CSS.escape(n.id)); break; } let i = 1; for (let s = n.previousElementSibling; s; s = s.previousElementSibling) { if (s.tagName === n.tagName) i++; } p.unshift(n.tagName.toLowerCase() + ':nth-of-type(' + i + ')'); } return p.join('>'); }; const out = []; for (const e of document.body.querySelectorAll('*')) { if (e.closest(allowed)) continue; const r = e.getBoundingClientRect(); if (r.width === 0 && r.height === 0) continue; if (r.right > vw) out.push({ selector: sel(e), snippet: e.cloneNode(false).outerHTML, rect: { x: r.x, y: r.y, width: r.width, height: r.height } }); } return JSON.stringify({ scrollWidth: de.scrollWidth, clientWidth: vw, offenders: out }); })(\"table,pre,img,video,canvas,svg,[role=img],map,object,embed\")"
        }
       }
      ]
     }
    }
   ]
  },
