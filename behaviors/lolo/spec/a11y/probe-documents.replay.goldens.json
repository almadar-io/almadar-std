       },
       {
        "event": "DOCS_NEXT",
        "payload": {}
       },
       {
        "event": "PROBE_DONE",
        "payload": {
         "key": "k2",
         "probe": "documents",
         "findings": []
        }
       }
      ],
      "neverEmits": [
       "DOCUMENTS_UNCHECKED"
      ]
