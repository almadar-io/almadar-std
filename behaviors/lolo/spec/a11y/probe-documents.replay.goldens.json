{
 "atom": "a11y/atoms/std-a11y-probe-documents.lolo",
 "trait": "DocumentsProbe",
 "spec": "spec/a11y/probe-documents.lolo",
 "note": "std-a11y-probe-documents with the page answers and the std-pdf-text answers played as events. The links are real, read through headless Chrome with the PAGE_LINKS expression (record.py); the PDF text and page counts are real pdftotext -layout output of the fixture PDFs. The download path is played. The replay runner delivers the internal DOCS_NEXT itself. Regenerate with python3 -I record.py && python3 -I gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN asks the tab for its links under the run key",
   "defaults": [
    "PdfText",
    "PdfCli"
   ],
   "steps": [
    {
     "trait": "DocumentsProbe",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24682/documents-pdf-notext-fail.html"
     },
     "expect": {
      "state": "linking",
      "emits": [
       {
        "event": "PAGE_LINKS",
        "payload": {
         "key": "k1:links"
        }
       }
      ]
     },
     "from": "idle"
    }
   ]
  },
  {
   "id": "pdf-scanned-fail: the linked PDF has no text on any page, so it is the confirmed pdf-scanned finding",
   "note": "links from headless Chrome (record.py); scan.pdf is a real PDF of drawn rectangles, pageCount from real pdftotext; the download is played",
   "defaults": [
    "PdfText",
    "PdfCli"
   ],
   "steps": [
    {
     "trait": "DocumentsProbe",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24682/documents-pdf-notext-fail.html"
     },
     "expect": {
      "state": "linking",
      "emits": [
       {
        "event": "PAGE_LINKS",
        "payload": {
         "key": "k1:links"
        }
       }
      ]
     },
     "from": "idle"
    },
    {
     "trait": "DocumentsProbe",
     "event": "PAGE_LINKS_READ",
     "payload": {
      "key": "k1:links",
      "links": [
       {
        "index": 0,
        "text": "Preskoči na vsebino",
        "href": "http://127.0.0.1:24682/documents-pdf-notext-fail.html#main",
        "download": false,
        "kind": "link"
       },
       {
        "index": 1,
        "text": "Domov",
        "href": "http://127.0.0.1:24682/index.html",
        "download": false,
        "kind": "link"
       },
       {
        "index": 2,
        "text": "Izdelki",
        "href": "http://127.0.0.1:24682/index.html",
        "download": false,
        "kind": "link"
       },
       {
        "index": 3,
        "text": "Cenik (PDF)",
        "href": "http://127.0.0.1:24682/docs/scan.pdf",
        "download": true,
        "kind": "link"
       }
      ]
     },
     "expect": {
      "state": "stepping",
      "emits": [
       {
        "event": "DOCS_NEXT",
        "payload": {}
       },
       {
        "event": "PAGE_DOWNLOAD",
        "payload": {
         "key": "k1:dl:0",
         "index": 3
        }
       }
      ],
      "entity": {
       "docs": [
        {
         "index": 3,
         "text": "Cenik (PDF)",
         "href": "http://127.0.0.1:24682/docs/scan.pdf"
        }
       ],
       "total": 1,
       "pos": 0
      }
     }
    },
    {
     "trait": "DocumentsProbe",
     "event": "PAGE_DOWNLOADED",
     "payload": {
      "key": "k1:dl:0",
      "path": "/downloads/scan.pdf",
      "url": "http://127.0.0.1:24682/docs/scan.pdf",
      "size": 1024
     },
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "PDF_REQUEST",
        "payload": {
         "key": "k1:pdf:0",
         "path": "/downloads/scan.pdf"
        }
       }
      ]
     }
    },
    {
     "trait": "PdfText",
     "event": "PDF_RAN",
     "payload": {
      "stage": "k1:pdf:0",
      "exitCode": 0,
      "signal": 0,
      "stdout": "\f",
      "stdoutBytes": "",
      "stderr": ""
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "PDF_NO_TEXT",
        "payload": {
         "key": "k1:pdf:0",
         "pageCount": 1
        }
       },
       {
        "event": "DOCS_NEXT",
        "payload": {}
       },
       {
        "event": "PROBE_DONE",
        "payload": {
         "key": "k1",
         "probe": "documents",
         "findings": [
          {
           "id": "pdf-scanned:http://127.0.0.1:24682/documents-pdf-notext-fail.html:http://127.0.0.1:24682/docs/scan.pdf",
           "pageUrl": "http://127.0.0.1:24682/documents-pdf-notext-fail.html",
           "rule": "pdf-scanned",
           "wcag": [
            {
             "criterion": "1.1.1",
             "level": "A",
             "version": "2.0"
            }
           ],
           "method": "probe",
           "engines": [
            "probe"
           ],
           "impact": "serious",
           "confidence": "confirmed",
           "selector": "a[href=\"http://127.0.0.1:24682/docs/scan.pdf\"]",
           "snippet": "<a href=\"http://127.0.0.1:24682/docs/scan.pdf\">Cenik (PDF)</a> is a PDF of 1 pages with no text",
           "evidence": "",
           "count": 1
          }
         ]
        }
       }
      ],
      "neverEmits": [
       "DOCUMENT_READ"
      ]
     }
    }
   ]
  },
