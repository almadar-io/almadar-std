app a11y-probe-hover-spec [
  version: "1.0.0",
  description: "Design contract for the hover and focus content probe (WCAG 1.4.13): content that appears on hover or focus must be dismissible with Escape and hoverable. PROBE_RUN { key, pageUrl } on a tab already at pageUrl finds the declared triggers, focuses each one (PAGE_MEASURE), presses Escape (PAGE_KEY), re-measures, and answers PROBE_DONE { key, probe, findings } or PROBE_FAILED { key, probe, error, code }. The page is navigated again (PAGE_NAVIGATE) to restore its state."
]

type WcagRef = { criterion : string!, level : "A" | "AA" | "AAA"!, version : "2.0" | "2.1" | "2.2"! }
type A11yFinding = { id : string!, pageUrl : string!, rule : string!, wcag : [WcagRef]!, method : "engine" | "probe" | "llm"!, engines : [string]!, impact : "critical" | "serious" | "moderate" | "minor"!, confidence : "confirmed" | "needs-verification"!, selector : string!, snippet : string!, evidence : string!, count : number! }

orbital A11yProbeHoverSpec {
  expects entity HoverRun [runtime] {
    id : string!
  }
  expects trait HoverProbe {
    state idle {
      PROBE_RUN -> finding
    }
    state escaping {
      PAGE_KEY_SENT -> checking
    }
    state restoring {
      PAGE_LOADED -> idle
    }
    emits {
      PAGE_MEASURE { key : string!  expression : string! }
      PAGE_KEY { key : string!  keyName : "Tab" | "Enter" | "Space" | "Escape" | "ArrowDown" | "ArrowUp" | "ArrowLeft" | "ArrowRight" | "Home" | "End"! }
      PAGE_NAVIGATE { key : string!  url : string! }
      PROBE_DONE { key : string!  probe : string!  findings : [A11yFinding]! }
      PROBE_FAILED { key : string!  probe : string!  error : string!  code : string! }
    }
  }
  expects page boot -> HoverProbe
}
