app a11y-probe-forms-spec [
  version: "1.0.0",
  description: "Design contract for the forms probe (WCAG 1.3.1, 1.3.5, 1.4.1, 3.3.1, 3.3.2, 4.1.2, 4.1.3). PROBE_RUN { key, pageUrl } on a tab already at pageUrl lists the form controls (PAGE_MEASURE), triggers the page's own client-side validation without submitting anything (PAGE_MEASURE sets invalid values and dispatches input and blur events, a second PAGE_MEASURE reads the result, a third restores the values), then navigates the tab back to pageUrl (PAGE_NAVIGATE) and answers PROBE_DONE { key, probe, findings } or PROBE_FAILED { key, probe, error, code }. It never calls submit() or requestSubmit() and never clicks a submit button."
]

type WcagRef = { criterion : string!, level : "A" | "AA" | "AAA"!, version : "2.0" | "2.1" | "2.2"! }
type A11yFinding = { id : string!, pageUrl : string!, rule : string!, wcag : [WcagRef]!, method : "engine" | "probe" | "llm"!, engines : [string]!, impact : "critical" | "serious" | "moderate" | "minor"!, confidence : "confirmed" | "needs-verification"!, selector : string!, snippet : string!, evidence : string!, count : number! }

orbital A11yProbeFormsSpec {
  expects entity FormsRun [runtime] {
    id : string!
  }
  expects trait FormsProbe {
    state idle {
      PROBE_RUN -> inventorying
    }
    state inventorying {
      PAGE_MEASURED -> stimulating
    }
    state returning {
      PAGE_LOADED -> idle
    }
    emits {
      PAGE_MEASURE { key : string!  expression : string! }
      PAGE_NAVIGATE { key : string!  url : string! }
      PROBE_DONE { key : string!  probe : string!  findings : [A11yFinding]! }
      PROBE_FAILED { key : string!  probe : string!  error : string!  code : string! }
    }
  }
  expects page boot -> FormsProbe
}
