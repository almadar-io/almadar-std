     "from": "scanning",
     "event": "WAVE_REPLY",
     "entity": {
      "key": "k1",
      "url": "https://a.test/p?x=1&y=2"
     },
     "payload": {
      "status": 200,
      "body": "<html>"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "WAVE_FAILED",
        "payload": {
         "key": "k1",
         "error": "the reply is not a WAVE report",
         "code": "wave_bad_reply"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "WaveHttp",
    "WaveTimeout"
   ],
   "config": {
    "credential": "WAVE_API_KEY"
   }
  },
  {
