      "status": 200,
      "body": "{\"status\": {\"success\": true, \"httpstatuscode\": 200}, \"statistics\": {\"pagetitle\": \"T\", \"pageurl\": \"https://a.test/p?x=1&y=2\", \"time\": 1.2, \"creditsremaining\": 1487, \"allitemcount\": 9, \"totalelements\": 50, \"waveurl\": \"https://wave.webaim.org/report?url=https://a.test/p?x=1&y=2\"}, \"categories\": {\"feature\": {\"description\": \"Features\", \"count\": 1, \"items\": {\"alt\": {\"id\": \"alt\", \"description\": \"Alternative text\", \"count\": 1, \"selectors\": [\"body > img:nth-of-type(3)\"]}}}, \"structure\": {\"description\": \"Structural Elements\", \"count\": 1, \"items\": {\"region\": {\"id\": \"region\", \"description\": \"Region\", \"count\": 1, \"selectors\": [\"body > main\"]}}}, \"aria\": {\"description\": \"ARIA\", \"count\": 1, \"items\": {\"aria_label\": {\"id\": \"aria_label\", \"description\": \"ARIA label\", \"count\": 1, \"selectors\": [\"body > nav\"]}}}}}"
