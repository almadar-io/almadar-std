  {
   "id": "status.success false is WAVE_FAILED wave_error with WAVE's text",
   "credentials": {
    "WAVE_API_KEY": "test-key"
   },
   "steps": [
    {
     "from": "scanning",
     "event": "WAVE_REPLY",
     "entity": {
      "key": "k1",
      "url": "https://a.test/p?x=1&y=2"
     },
     "payload": {
      "status": 200,
      "body": "{\"status\": {\"success\": false, \"httpstatuscode\": 500, \"error\": \"Invalid API key\"}, \"statistics\": {\"pagetitle\": \"T\", \"pageurl\": \"https://a.test/p?x=1&y=2\", \"time\": 1.2, \"creditsremaining\": 1487, \"allitemcount\": 9, \"totalelements\": 50, \"waveurl\": \"https://wave.webaim.org/report?url=https://a.test/p?x=1&y=2\"}, \"categories\": {}}"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "WAVE_FAILED",
        "payload": {
         "key": "k1",
         "error": "Invalid API key",
         "code": "wave_error"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "WaveHttp",
    "WaveTimeout"
   ],
   "config": {
    "credential": "WAVE_API_KEY"
   }
  },
  {
   "id": "a non-200 reply is WAVE_FAILED wave_http_<status>",
   "credentials": {
    "WAVE_API_KEY": "test-key"
   },
   "steps": [
    {
     "from": "scanning",
     "event": "WAVE_REPLY",
     "entity": {
      "key": "k1",
      "url": "https://a.test/p?x=1&y=2"
     },
     "payload": {
      "status": 503,
      "body": ""
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "WAVE_FAILED",
        "payload": {
         "key": "k1",
         "error": "WAVE answered 503",
         "code": "wave_http_503"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "WaveHttp",
    "WaveTimeout"
   ],
   "config": {
    "credential": "WAVE_API_KEY"
   }
  },
  {
   "id": "a 200 reply that is not a WAVE report is WAVE_FAILED wave_bad_reply",
   "credentials": {
