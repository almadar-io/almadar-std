  {
   "id": "a scan while another is in flight is WAVE_FAILED wave_busy and keeps the first",
   "credentials": {
    "WAVE_API_KEY": "test-key"
   },
   "steps": [
    {
     "from": "scanning",
     "event": "WAVE_SCAN",
     "entity": {
      "key": "k1",
      "url": "https://a.test/p?x=1&y=2"
     },
     "payload": {
      "key": "k2",
      "url": "https://b.test/"
     },
     "expect": {
      "state": "scanning",
      "emits": [
       {
        "event": "WAVE_FAILED",
        "payload": {
         "key": "k2",
         "error": "a scan of https://a.test/p?x=1&y=2 is in flight",
         "code": "wave_busy"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "WaveHttp",
    "WaveTimeout"
   ],
   "config": {
    "credential": "WAVE_API_KEY"
   }
  }
 ]
