{
 "atom": "a11y/atoms/std-a11y-probe-overlay.lolo",
 "trait": "OverlayProbe",
 "note": "std-a11y-probe-overlay with the page answer played as an event. The script lists of the fixtures are real, recorded through headless Chrome with record.py and expression.js. Regenerate with python3 -I probe-overlay.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN asks the page for every script src under the run key",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24812/"
     },
     "expect": {
      "state": "measuring",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:measure",
         "expression": "JSON.stringify({ scripts: Array.from(document.querySelectorAll(\"script[src]\")).map(function (s) { return s.src; }) })"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "overlay-script-fail: the local widget script is one confirmed overlay finding with no WCAG criterion",
   "steps": [
    {
     "from": "measuring",
     "event": "PAGE_MEASURED",
     "entity": {
      "runKey": "k1",
      "pageUrl": "http://127.0.0.1:24812/"
     },
     "payload": {
      "key": "k1:measure",
      "json": "{\"scripts\":[\"http://127.0.0.1:24812/vendor/userway/userway.js\"]}"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PROBE_DONE",
        "payload": {
         "key": "k1",
         "probe": "overlay",
         "findings": [
          {
           "id": "overlay:UserWay:http://127.0.0.1:24812/vendor/userway/userway.js",
           "pageUrl": "http://127.0.0.1:24812/",
           "rule": "overlay",
           "wcag": [],
           "method": "probe",
           "engines": [
            "probe"
           ],
           "impact": "moderate",
           "confidence": "confirmed",
           "selector": "script[src=\"http://127.0.0.1:24812/vendor/userway/userway.js\"]",
           "snippet": "http://127.0.0.1:24812/vendor/userway/userway.js",
           "evidence": "",
           "count": 1
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
