{
 "atom": "a11y/atoms/std-a11y-axe.lolo",
 "trait": "AxeProbe",
 "note": "std-a11y-axe with the page answers played as events. The measure JSON of the img-alt, contrast and lang-missing cases is the real reduced result of axe-core 4.14.0 run through headless Chrome (a11y-axe.gen/record.py) on the fixtures; the expression asserted is a11y-axe.gen/expression.js. Regenerate with python3 -I a11y-axe.gen/gen_goldens.py.",
 "cases": [
  {
   "id": "PROBE_RUN asks the page to evaluate the granted script under the run key",
   "steps": [
    {
     "from": "idle",
     "event": "PROBE_RUN",
     "payload": {
      "key": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "expect": {
      "state": "injecting",
      "emits": [
       {
        "event": "PAGE_INJECT",
        "payload": {
         "key": "k1:inject",
         "script": "axe-core/axe.min.js"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "PAGE_INJECTED asks the page to run axe with the recorded expression",
   "steps": [
    {
     "from": "injecting",
     "event": "PAGE_INJECTED",
     "entity": {
      "runKey": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "payload": {
      "key": "k1:inject"
     },
     "expect": {
      "state": "measuring",
      "emits": [
       {
        "event": "PAGE_MEASURE",
        "payload": {
         "key": "k1:measure",
         "expression": "axe.run(document, { runOnly: { type: \"tag\", values: [\"wcag2a\", \"wcag2aa\", \"wcag21a\", \"wcag21aa\", \"wcag22aa\"] } }).then(function (r) { return JSON.stringify({ version: r.testEngine.version, violations: r.violations.map(function (v) { return { id: v.id, impact: v.impact || undefined, tags: v.tags, nodes: v.nodes.map(function (n) { return { target: n.target.map(function (t) { return Array.isArray(t) ? t.join(\" \") : t; }).join(\" \"), html: n.html }; }) }; }) }); })"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control: an injected answer under another run's key is ignored",
   "steps": [
    {
     "from": "injecting",
     "event": "PAGE_INJECTED",
     "entity": {
      "runKey": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "payload": {
      "key": "k2:inject"
     },
     "expect": {
      "state": "injecting",
      "emits": []
     }
    }
   ]
  },
  {
   "id": "img-alt-fail: the missing alt is one confirmed critical finding with WCAG 1.1.1 and the axe version",
   "steps": [
    {
     "from": "measuring",
     "event": "PAGE_MEASURED",
     "entity": {
      "runKey": "k1",
      "pageUrl": "http://127.0.0.1:24680/"
     },
     "payload": {
      "key": "k1:measure",
      "json": "{\"version\":\"4.14.0\",\"violations\":[{\"id\":\"image-alt\",\"impact\":\"critical\",\"tags\":[\"cat.text-alternatives\",\"wcag2a\",\"wcag111\",\"section508\",\"section508.22.a\",\"TTv5\",\"TT7.a\",\"TT7.b\",\"EN-301-549\",\"EN-9.1.1.1\",\"ACT\",\"RGAAv4\",\"RGAA-1.1.1\"],\"nodes\":[{\"target\":\"img\",\"html\":\"<img class=\\\"photo\\\" src=\\\"img/lonec.svg\\\" width=\\\"120\\\" height=\\\"80\\\">\"}]}]}"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PROBE_DONE",
        "payload": {
         "key": "k1",
         "probe": "axe",
         "findings": [
          {
           "id": "axe:image-alt:img",
           "pageUrl": "http://127.0.0.1:24680/",
           "rule": "image-alt",
           "wcag": [
            {
             "criterion": "1.1.1",
             "level": "A",
             "version": "2.0"
            }
           ],
           "method": "engine",
           "engines": [
            "axe"
           ],
           "impact": "critical",
           "confidence": "confirmed",
           "selector": "img",
           "snippet": "<img class=\"photo\" src=\"img/lonec.svg\" width=\"120\" height=\"80\">",
           "evidence": "axe-core 4.14.0",
           "count": 1
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
