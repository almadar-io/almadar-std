{
 "atom": "../ui/core/atoms/std-hero.lolo",
 "trait": "HeroRender",
 "cases": [
  {
   "id": "landmark main makes the hero the page's main landmark and its headline the page's h1",
   "config": { "look": "header", "landmark": "main", "headline": "Not here" },
   "steps": [
    { "from": "idle", "event": "INIT", "payload": {},
      "expect": { "fired": true, "rendered": [ { "slot": "main", "props": { "role": "main", "children.1.children.0.children.0.children.0.children.0.children.0.children.1.as": "h1", "children.1.children.0.children.0.children.0.children.0.children.0.children.1.variant": "h2" } } ] },
      "options": { "render": true, "renderProps": true } }
   ]
  },
  {
   "id": "control: by default a header hero declares no landmark and keeps an h2 headline",
   "config": { "look": "header", "headline": "Not here" },
   "steps": [
    { "from": "idle", "event": "INIT", "payload": {},
      "expect": { "fired": true, "rendered": [ { "slot": "main", "props": { "role": null, "children.1.children.0.children.0.children.0.children.0.children.0.children.1.as": "h2" } } ] },
      "options": { "render": true, "renderProps": true } }
   ]
  },
  {
   "id": "control: a hero look keeps its h1 headline without a landmark",
   "config": { "look": "hero", "headline": "Welcome" },
   "steps": [
    { "from": "idle", "event": "INIT", "payload": {},
      "expect": { "fired": true, "rendered": [ { "slot": "main", "props": { "role": null, "children.1.children.0.children.0.children.0.children.0.children.0.children.1.as": "h1" } } ] },
      "options": { "render": true, "renderProps": true } }
   ]
  }
 ]
}
