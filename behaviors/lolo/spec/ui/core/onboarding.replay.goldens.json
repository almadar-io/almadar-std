{
 "atom": "../ui/core/atoms/std-onboarding.lolo",
 "trait": "OnboardingStore",
 "spec": "onboarding.lolo",
 "note": "a first-run flow kept per member: the store reads the row, resumes the wizard, saves every change it reports and speaks the ONBOARDING_* events. The persist answers are played as OB_SAVED / OB_SAVE_FAILED steps.",
 "cases": [
  {
   "id": "mounting-reads-the-members-record",
   "config": {},
   "steps": [
    {
     "trait": "OnboardingStore",
     "from": "loading",
     "event": "INIT",
     "entity": {
      "id": "u1",
      "ownerId": "u1",
      "done": false,
      "stepId": "welcome",
      "answers": {},
      "didAnswer": false,
      "answeredStep": "",
      "answeredValue": "",
      "announce": false
     },
     "payload": {},
     "expect": {
      "fired": true,
      "state": "loading",
      "effects": [
       {
        "type": "fetch"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-record-not-done-resumes-the-wizard-at-its-saved-step",
   "config": {},
   "steps": [
    {
     "trait": "OnboardingStore",
     "from": "loading",
     "event": "RECORD_READ",
     "entity": {
      "id": "u1",
      "ownerId": "u1",
      "done": false,
      "stepId": "welcome",
      "answers": {},
      "didAnswer": false,
      "answeredStep": "",
      "answeredValue": "",
      "announce": false
     },
     "payload": {
      "data": [
       {
        "id": "u1",
        "ownerId": "u1",
        "done": false,
        "stepId": "role",
        "answers": {
         "welcome": "x"
        }
       }
      ],
      "totalCount": 1
     },
     "expect": {
      "fired": true,
      "state": "active",
      "entity": {
       "stepId": "role",
       "answers": {
        "welcome": "x"
       },
       "announce": false,
       "done": false
      },
      "emits": [
       {
        "event": "STORE_POSITION",
        "payload": {
         "stepId": "role",
         "answers": {
          "welcome": "x"
         },
         "finished": false,
         "problem": ""
        }
       },
       {
        "event": "ONBOARDING_NEEDED",
        "payload": {
         "stepId": "details"
        }
       },
       {
        "event": "ONBOARDING_STEP",
        "payload": {
         "stepId": "details",
         "answers": {
          "welcome": "x"
         }
        }
       }
      ],
      "neverEmits": [
       "ONBOARDING_SKIPPED"
      ]
     }
    }
   ],
   "defaults": [
    "OnboardingFlow"
   ]
  },
  {
   "id": "control-a-record-that-is-done-finishes-the-wizard-and-is-skipped",
