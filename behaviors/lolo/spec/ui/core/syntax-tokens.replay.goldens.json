{
  "atom": "../ui/core/atoms/std-syntax-tokens.lolo",
  "trait": "SyntaxTokens",
  "cases": [
    {
      "id": "rules-claim-ranges-in-order",
      "steps": [
        {
          "event": "TOKENIZE",
          "payload": {
            "editorId": "e",
            "language": "toy",
            "text": "\"when\" when 42"
          },
          "expect": {
            "emits": [
              {
                "event": "DECORATE",
                "payload": {
                  "editorId": "e",
                  "source": "syntax",
                  "ranges": [
                    {
                      "id": "syntax-0-0",
                      "fromRow": 0,
                      "fromCol": 0,
                      "toRow": 0,
                      "toCol": 6,
                      "tone": "string",
                      "label": ""
                    },
                    {
                      "id": "syntax-0-7",
                      "fromRow": 0,
                      "fromCol": 7,
                      "toRow": 0,
                      "toCol": 11,
                      "tone": "keyword",
                      "label": ""
                    },
                    {
                      "id": "syntax-0-12",
                      "fromRow": 0,
                      "fromCol": 12,
                      "toRow": 0,
                      "toCol": 14,
                      "tone": "number",
                      "label": ""
                    }
                  ]
                }
              }
            ]
          }
        }
      ],
      "config": {
        "languages": {
          "toy": [
            {
              "tone": "comment",
              "pattern": ";;.*$"
            },
            {
              "tone": "string",
              "pattern": "\"[^\"]*\""
            },
            {
              "tone": "keyword",
              "pattern": "\\b(when|state)\\b"
            },
            {
              "tone": "number",
              "pattern": "\\b[0-9]+\\b"
            }
          ]
        }
      }
    },
