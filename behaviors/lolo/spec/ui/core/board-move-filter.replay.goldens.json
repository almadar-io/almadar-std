    { "from": "viewing_board", "event": "INIT", "payload": {},
      "expect": { "state": "loading", "effects": [ { "type": "fetch", "arg0": "BoardView", "arg1": { "emit": { "failure": "BoardItemsLoadFailed", "success": "BoardItemsLoaded" }, "include": [], "limit": 500, "filter": ["and", ["or", ["=", "@config.matchField", null], ["=", ["object/get", "@entity", "@config.matchField"], ""]], ["and", ["or", ["=", "@config.scopeField", null], ["=", ["object/get", "@entity", "@config.scopeField"], "@user.id"]], ["or", ["=", "@config.parentField", null], ["=", ["object/get", "@entity", "@config.parentField"], ["default", "@payload.id", ""]]]]] } } ] } }
   ]
  },
  {
