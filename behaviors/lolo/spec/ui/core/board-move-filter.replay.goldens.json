{
 "atom": "../ui/core/atoms/std-board.lolo",
 "trait": "BoardItemBoard",
 "cases": [
  {
   "id": "moving-a-card-writes-the-field-the-board-groups-by",
   "config": { "groupByField": "status" },
   "entity": { "id": "b" },
   "steps": [
    { "from": "viewing_board", "event": "MOVE_CARD", "payload": { "id": "c1", "targetGroup": "done" },
      "expect": { "state": "viewing_board", "effects": [ { "type": "persist", "arg0": "update", "arg1": "BoardView", "arg2": ["object/set", { "id": "@payload.id" }, "status", "@payload.targetGroup"] } ] } }
   ]
  },
  {
   "id": "control-default-grouping-still-writes-stage",
   "entity": { "id": "b" },
   "steps": [
    { "from": "viewing_board", "event": "MOVE_CARD", "payload": { "id": "c1", "targetGroup": "done" },
      "expect": { "state": "viewing_board", "effects": [ { "type": "persist", "arg0": "update", "arg1": "BoardView", "arg2": ["object/set", { "id": "@payload.id" }, "stage", "@payload.targetGroup"] } ] } }
   ]
  },
  {
   "id": "the-open-card-move-also-writes-the-grouping-field",
