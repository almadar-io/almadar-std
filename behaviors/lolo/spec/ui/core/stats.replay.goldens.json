    {
      "id": "number-gt-clause-evaluates",
      "note": "kind number, op >, bound: the clause narrows the row value with as and compares",
      "config": {
        "metrics": [
          {
            "aggregation": "count",
            "label": "Over 3",
            "where": [
              {
                "field": "value",
                "op": ">",
                "kind": "number",
                "bound": 3
              }
            ]
          }
        ]
      },
      "steps": [
        {
          "trait": "StatsItemStats",
          "from": "idle",
          "event": "ITEMS_LOADED",
          "entity": {
            "id": "s",
            "cards": []
          },
          "payload": {
            "data": [
              {
                "id": "a",
                "label": "a",
                "value": 5
              },
              {
                "id": "b",
                "label": "b",
                "value": 2
              }
            ],
            "totalCount": 2
          },
          "expect": {
            "fired": true,
            "state": "idle",
            "effects": [
              {
                "type": "set",
                "arg0": "@entity.cards"
              },
              {
                "type": "if"
              }
            ]
          }
        }
      ]
    },
