{
 "atom": "../ui/core/atoms/std-slide-deck.lolo",
 "trait": "SlideDeckPresenter",
 "cases": [
  {
   "id": "a-deck-that-does-not-paint-steps-and-announces-but-renders-nothing",
   "config": {
    "slideCount": 3,
    "paints": false
   },
   "entity": {
    "id": "d",
    "slideIndex": 0
   },
   "steps": [
    {
     "from": "presenting",
     "event": "NEXT",
     "payload": {},
     "options": {
      "render": true
     },
     "expect": {
      "state": "presenting",
      "entity": {
       "slideIndex": 1
      },
      "emits": [
       {
        "event": "SLIDE_CHANGED",
        "payload": {
         "index": 1
        }
       }
      ],
      "rendered": []
     }
    }
   ]
  },
  {
   "id": "control-a-deck-paints-its-body-by-default",
   "config": {
    "slideCount": 3
   },
   "entity": {
    "id": "d",
    "slideIndex": 0
   },
   "steps": [
    {
     "from": "presenting",
     "event": "NEXT",
     "payload": {},
     "options": {
      "render": true
     },
     "expect": {
      "state": "presenting",
      "entity": {
       "slideIndex": 1
      },
      "emits": [
       {
        "event": "SLIDE_CHANGED",
        "payload": {
         "index": 1
        }
       }
      ],
      "rendered": [
       {
        "slot": "main"
       }
      ]
     }
    }
   ]
  }
 ]
}
