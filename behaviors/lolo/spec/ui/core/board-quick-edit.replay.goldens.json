   "entity": { "id": "b" },
   "steps": [
    { "from": "viewing_board", "event": "OPEN_CARD", "payload": { "id": "c1", "row": { "id": "c1" } },
      "expect": { "fired": true, "state": "viewing_card", "neverEmits": ["QUICK_EDIT_CARD"] } }
   ]
  },
  {
   "id": "control-open-card-still-moves-to-the-card-view-by-default",
   "entity": { "id": "b" },
   "steps": [
    { "from": "viewing_board", "event": "OPEN_CARD", "payload": { "id": "c1", "row": { "id": "c1" } },
      "expect": { "fired": true, "state": "viewing_card" } }
   ]
  }
 ]
}
