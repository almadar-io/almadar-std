{
 "atom": "../ui/core/atoms/std-hero.lolo",
 "trait": "HeroRender",
 "cases": [
  {
   "id": "the reveal knob sets the content's scroll animation (g_std_048)",
   "config": {
    "reveal": "fade-up"
   },
   "steps": [
    {
     "from": "idle",
     "event": "INIT",
     "payload": {},
     "expect": {
      "fired": true,
      "rendered": [
       {
        "slot": "main",
        "props": {
         "children.1.children.0.children.0.type": "animated-reveal",
         "children.1.children.0.children.0.animation": "fade-up"
        }
       }
      ]
     },
     "options": {
      "render": true,
      "renderProps": true
     }
    }
   ]
  },
  {
   "id": "control: reveal defaults to none (g_std_048)",
   "config": {},
   "steps": [
    {
     "from": "idle",
     "event": "INIT",
     "payload": {},
     "expect": {
      "fired": true,
      "rendered": [
       {
        "slot": "main",
        "props": {
         "children.1.children.0.children.0.type": "animated-reveal",
         "children.1.children.0.children.0.animation": "none"
        }
       }
      ]
     },
     "options": {
      "render": true,
      "renderProps": true
     }
    }
   ]
  }
 ]
}
