app dashboard-layout-spec [
  version: "1.0.0",
  description: "Design contract for the dashboard layout's Sign out: the SIGN_OUT event is an arm of the layout's own trait, which ends the session with the auth/sign-out host ask (G-ORB-523, G-ORB-589)."
]

orbital DashboardLayoutSpec {
  expects trait DashboardLayoutRender {
    state idle {
      INIT -> idle
      SIGN_OUT -> idle
    }
  }
}
