{
 "atom": "../ui/core/atoms/std-confirmation.lolo",
 "trait": "ConfirmActionConfirmation",
 "note": "A confirmation opens only for a request that names the row it confirms.",
 "cases": [
  {
   "id": "a-request-with-a-row-opens-the-confirmation",
   "steps": [
    {
     "event": "REQUEST",
     "payload": { "id": "c-1", "row": { "id": "c-1", "name": "Zeleni Vrt" } },
     "from": "idle",
     "expect": { "fired": true, "state": "confirming" }
    }
   ]
  },
  {
   "id": "control-a-request-with-no-row-stays-idle",
   "steps": [
    {
     "event": "REQUEST",
     "payload": { "id": "c-1" },
     "from": "idle",
     "expect": { "state": "idle" }
    }
   ]
  }
 ]
}
