{
  "atom": "../ui/core/atoms/std-modal-editor.lolo",
  "trait": "Macros",
  "cases": [
    {
      "id": "records-keys-and-drops-the-stop-key",
      "steps": [
        {
          "event": "MACRO_RECORD",
          "payload": {
            "editorId": "e",
            "register": "a"
          }
        },
        {
          "event": "KEY",
          "payload": {
            "editorId": "e",
            "key": "j",
            "ctrl": false
          }
        },
        {
          "event": "KEY",
          "payload": {
            "editorId": "e",
            "key": "x",
            "ctrl": false
          }
        },
        {
          "event": "KEY",
          "payload": {
            "editorId": "e",
            "key": "q",
            "ctrl": false
          }
        },
        {
          "event": "MACRO_STOP",
          "payload": {
            "editorId": "e",
            "key": "q"
          },
          "expect": {
            "entity": {
              "recording": "",
              "macros": {
                "a": [
                  {
                    "key": "j",
                    "code": "",
                    "ctrl": false,
                    "alt": false,
                    "shift": false,
                    "meta": false
                  },
                  {
                    "key": "x",
                    "code": "",
                    "ctrl": false,
                    "alt": false,
                    "shift": false,
                    "meta": false
                  }
                ]
              }
            }
          }
        }
      ]
    },
    {
      "id": "keys-outside-a-recording-are-not-kept",
      "steps": [
        {
          "event": "KEY",
          "payload": {
            "editorId": "e",
            "key": "j",
            "ctrl": false
          },
          "expect": {
            "fired": false
          }
        }
      ]
    },
