{
  "atom": "../ui/core/atoms/std-scoped-list.lolo",
  "trait": "ScopedListBrowse",
  "cases": [
    {
      "id": "a-reorder-event-lets-rows-be-dragged-and-names-the-event",
      "config": {
        "reorderEvent": "MOVE_STEP"
      },
      "steps": [
        {
          "event": "ScopedListLoaded",
          "payload": {
            "data": []
          },
          "entity": {
            "id": "s",
            "name": "",
            "parentId": "",
            "scopeValue": "t1"
          },
          "from": "listing",
          "expect": {
            "fired": true,
            "state": "listing",
            "effects": [
              {
                "type": "render-ui",
                "arg0": "main",
                "arg1": {
                  "entity": "@payload.data",
                  "fields": [],
                  "itemActions": [
                    "array/filter",
                    "@config.itemActions",
                    [
                      "fn",
                      "item",
                      [
                        "or",
                        [
                          "=",
                          [
                            "array/len",
                            [
                              "object/get",
                              "@item",
                              "roles",
                              []
                            ]
                          ],
                          0
                        ],
                        [
                          "array/includes",
                          [
                            "object/get",
                            "@item",
                            "roles",
                            []
                          ],
                          ""
                        ]
                      ]
                    ]
                  ],
                  "itemClickEvent": "VIEW",
                  "sortBy": "",
                  "sortDirection": "asc",
                  "emptyTitle": "Nothing here yet",
                  "emptyDescription": "",
                  "emptyIcon": "inbox",
                  "gap": "sm",
                  "sortable": [
                    "!=",
                    "MOVE_STEP",
                    ""
                  ],
                  "type": "data-list",
                  "reorderEvent": "MOVE_STEP"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-without-a-reorder-event-the-rows-stay-put",
