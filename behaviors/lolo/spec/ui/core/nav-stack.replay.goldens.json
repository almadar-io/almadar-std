          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                }
              ]
            }
          }
        },
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Doc",
            "route": "/docs/7",
            "ancestors": [
              {
                "path": "/docs",
                "page": "Docs",
                "label": "Documents"
              }
            ],
            "crumb": "Seven"
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                },
                {
                  "href": "/docs/7",
                  "label": "Seven"
                }
              ]
            }
          }
        },
        {
          "event": "MOUNTED",
          "payload": {
            "page": "DocEdit",
            "route": "/docs/7/edit",
            "ancestors": [
              {
                "path": "/docs",
                "page": "Docs",
                "label": "Documents"
              }
            ],
            "label": "Edit"
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                },
                {
                  "href": "/docs/7",
                  "label": "Seven"
                },
                {
                  "href": "/docs/7/edit",
                  "label": "Edit"
                }
              ]
            }
          }
        },
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Doc",
            "route": "/docs/7",
            "ancestors": [
              {
                "path": "/docs",
                "page": "Docs",
                "label": "Documents"
              }
            ]
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                },
                {
                  "href": "/docs/7",
                  "label": "Seven"
                }
              ]
            }
          }
        }
      ]
    },
