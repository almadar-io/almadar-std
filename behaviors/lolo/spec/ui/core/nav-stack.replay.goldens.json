      "steps": [
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Contract",
            "route": "/contracts/9",
            "ancestors": []
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/contracts/9",
                  "label": ""
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "control-a-root-route-has-no-ancestors-and-is-the-only-entry",
      "steps": [
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Home",
            "route": "/",
            "ancestors": []
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/",
                  "label": ""
                }
              ]
            }
          }
