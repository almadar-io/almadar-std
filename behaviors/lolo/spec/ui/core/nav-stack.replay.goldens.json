    },
    {
      "id": "control-an-empty-crumb-is-no-crumb",
      "steps": [
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Contract",
            "route": "/contracts/9",
            "ancestors": [],
            "label": "Contract details",
