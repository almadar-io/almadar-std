{
  "atom": "../ui/core/atoms/std-nav-stack.lolo",
  "trait": "NavStackTrail",
  "cases": [
    {
      "id": "cold-load-seeds-the-trail-from-the-declared-ancestors",
      "note": "an empty trail takes the mount's ancestors, then the opened route with its crumb",
      "steps": [
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Doc",
            "route": "/docs/7",
            "ancestors": [
              {
                "path": "/docs",
                "page": "Docs",
                "label": "Documents"
              }
            ],
            "crumb": "Seven"
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                },
                {
                  "href": "/docs/7",
                  "label": "Seven"
                }
              ]
            },
            "emits": [
              {
                "event": "TRAIL",
                "payload": {
                  "entries": [
                    {
                      "href": "/docs",
                      "label": "Documents"
                    },
                    {
                      "href": "/docs/7",
                      "label": "Seven"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-new-route-is-pushed-and-the-ancestors-are-not-seeded-again",
      "steps": [
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Docs",
            "route": "/docs",
            "ancestors": [],
            "label": "Documents"
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                }
              ]
            }
          }
        },
        {
          "event": "MOUNTED",
          "payload": {
            "page": "Doc",
            "route": "/docs/7",
            "ancestors": [
              {
                "path": "/docs",
                "page": "Docs",
                "label": "Documents"
              }
            ],
            "crumb": "Seven"
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                },
                {
                  "href": "/docs/7",
                  "label": "Seven"
                }
              ]
            }
          }
        },
        {
          "event": "MOUNTED",
          "payload": {
            "page": "DocEdit",
            "route": "/docs/7/edit",
            "ancestors": [
              {
                "path": "/docs",
                "page": "Docs",
                "label": "Documents"
              },
              {
                "path": "/docs/7",
                "page": "Doc"
              }
            ],
            "label": "Edit"
          },
          "expect": {
            "entity": {
              "trail": [
                {
                  "href": "/docs",
                  "label": "Documents"
                },
                {
                  "href": "/docs/7",
                  "label": "Seven"
                },
                {
                  "href": "/docs/7/edit",
                  "label": "Edit"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "a-revisit-truncates-the-trail-back-to-the-visited-entry-and-keeps-its-label",
      "steps": [
        {
          "event": "MOUNTED",
