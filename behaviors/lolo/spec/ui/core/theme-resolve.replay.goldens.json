{
  "atom": "../ui/core/atoms/std-theme-resolve.lolo",
  "trait": "ThemeResolve",
  "cases": [
    {
      "id": "theme_keys_follow_the_generated_css_selectors: light and dark",
      "steps": [
        {
          "event": "THEME_KEYS",
          "payload": {
            "presets": [
              {
                "name": "clay",
                "declaresTokens": true,
                "hasDark": true
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "THEME_KEYS_RESULT",
                "payload": {
                  "declared": [
                    "clay-light",
                    "clay-dark"
                  ],
                  "keys": [
                    "clay-dark",
                    "clay-light"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "theme_keys: light only (control for the dark key)",
      "steps": [
        {
          "event": "THEME_KEYS",
