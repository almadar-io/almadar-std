    {
      "id": "resolve_theme_precedence: neither declares a theme gives the default",
      "steps": [
        {
          "event": "THEME_RESOLVE",
          "payload": {
            "presets": [
              {
                "name": "clay",
                "declaresTokens": true,
                "hasDark": true
              },
              {
                "name": "aqua",
                "declaresTokens": true,
                "hasDark": true
              },
              {
                "name": "minimalist",
                "declaresTokens": true,
                "hasDark": true
              },
              {
                "name": "linear-clean",
                "declaresTokens": true,
                "hasDark": true
              }
            ],
            "orbitals": [
              {
                "name": "A",
                "theme": ""
              }
            ],
            "orbital": "A",
            "appTheme": "",
            "hasMode": false,
            "requestedMode": "light"
          },
          "expect": {
            "emits": [
              {
                "event": "THEME_RESOLVED",
                "payload": {
                  "key": "minimalist-light",
                  "base": "minimalist",
                  "mode": "light",
                  "found": true,
                  "mergesVariant": false
                }
              }
            ]
          }
        }
      ]
