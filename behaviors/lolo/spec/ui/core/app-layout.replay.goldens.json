{
  "atom": "../ui/core/atoms/std-app-layout.lolo",
  "trait": "AppLayout",
  "cases": [
    {
      "id": "bell-click-emits-notify-click",
      "note": "the bell fires the internal NOTIFY_PICKED; the layout answers with the consumer contract NOTIFY_CLICK so a panel listening AppLayout.NOTIFY_CLICK hears it",
      "steps": [
        {
          "trait": "AppLayout",
          "from": "composing",
          "event": "NOTIFY_PICKED",
          "entity": {
            "id": "e"
          },
          "payload": {},
          "expect": {
            "fired": true,
            "state": "composing",
            "emitCounts": {
              "NOTIFY_CLICK": 1
            }
          }
        }
      ]
    },
    {
      "id": "control-load-failure-emits-no-notify-click",
      "note": "control: a layout load failure notifies the viewer and requests no notification panel",
      "steps": [
        {
          "trait": "AppLayout",
          "from": "composing",
          "event": "AppLayoutStateLoadFailed",
          "entity": {
            "id": "e"
          },
          "payload": {
            "error": "x"
          },
          "expect": {
            "fired": true,
            "neverEmits": [
              "NOTIFY_CLICK"
            ]
          }
        }
      ]
    },
    {
      "id": "control-loaded-emits-no-notify-click",
      "note": "control: the loaded signal opens nothing",
      "steps": [
        {
          "trait": "AppLayout",
          "from": "composing",
          "event": "AppLayoutStateLoaded",
          "entity": {
            "id": "e"
          },
          "payload": {
            "data": []
          },
          "expect": {
            "fired": true,
            "neverEmits": [
              "NOTIFY_CLICK"
            ]
          }
        }
      ]
    },
    {
      "id": "search-submit-emits-search",
      "note": "the search box fires the internal SEARCH_PICKED; the layout answers with LAYOUT_SEARCH { value } for the app's listeners",
      "steps": [
        {
          "trait": "AppLayout",
          "from": "composing",
          "event": "SEARCH_PICKED",
          "entity": {
            "id": "e"
          },
          "payload": {
            "value": "abc"
          },
          "expect": {
            "fired": true,
            "state": "composing",
            "exactEmits": [
              {
                "event": "LAYOUT_SEARCH",
                "payload": {
                  "value": "abc"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-search-without-value-emits-empty-query",
      "note": "control: a submit with no value emits an empty query, not a null",
      "steps": [
        {
          "trait": "AppLayout",
          "from": "composing",
          "event": "SEARCH_PICKED",
          "entity": {
            "id": "e"
          },
          "payload": {},
          "expect": {
            "fired": true,
            "exactEmits": [
              {
                "event": "LAYOUT_SEARCH",
                "payload": {
                  "value": ""
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-bell-emits-no-search",
      "note": "control: the bell opens notifications and runs no search",
      "steps": [
        {
          "trait": "AppLayout",
          "from": "composing",
          "event": "NOTIFY_PICKED",
          "entity": {
            "id": "e"
          },
          "payload": {},
          "expect": {
            "fired": true,
            "neverEmits": [
              "LAYOUT_SEARCH"
            ]
          }
        }
      ]
    },
    {
      "id": "g-cross-115-a-member-sees-no-staff-nav-item-or-action",
      "note": "a role the item does not list: the item is not rendered",
      "config": {
        "navItems": [
          {
            "label": "Home",
            "href": "/"
          },
          {
            "label": "Members",
            "href": "/members",
            "roles": [
              "staff"
            ]
          },
          {
            "label": "Policies",
            "href": "/policies",
            "roles": [
              "staff",
              "admin"
            ]
          }
        ],
        "topBarActions": [
          {
            "label": "Invite",
            "event": "INVITE",
            "roles": [
              "staff"
            ]
          },
          {
            "label": "Help",
            "event": "HELP"
          }
        ],
        "viewerRole": "member"
      },
      "steps": [
        {
          "trait": "AppLayout",
          "event": "INIT",
          "payload": {},
          "expect": {
            "fired": true,
            "rendered": [
              {
                "slot": "main",
                "props": {
                  "children.0.navItems": [
                    {
                      "label": "Home",
                      "href": "/"
                    }
                  ],
                  "children.0.topBarActions": [
                    {
                      "label": "Help",
                      "event": "HELP"
                    }
                  ]
                }
              }
            ]
          },
          "options": {
            "render": true,
            "renderProps": true
          }
        }
      ]
    },
    {
      "id": "g-cross-115-control-staff-sees-every-item",
      "note": "the listed role sees them all",
      "config": {
        "navItems": [
          {
            "label": "Home",
            "href": "/"
