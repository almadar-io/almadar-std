            "href": "/policies",
            "roles": [
              "staff",
              "admin"
            ]
          }
        ],
        "topBarActions": [
          {
            "label": "Invite",
            "event": "INVITE",
            "roles": [
              "staff"
            ]
          },
          {
            "label": "Help",
            "event": "HELP"
          }
        ],
        "viewerRole": "staff"
      },
      "steps": [
        {
          "trait": "AppLayout",
          "event": "INIT",
          "payload": {},
          "expect": {
            "fired": true,
            "rendered": [
              {
                "slot": "main",
                "props": {
                  "children.0.navItems": [
                    {
                      "label": "Home",
                      "href": "/"
                    },
                    {
                      "label": "Members",
                      "href": "/members",
                      "roles": [
                        "staff"
                      ]
                    },
                    {
                      "label": "Policies",
                      "href": "/policies",
                      "roles": [
                        "staff",
                        "admin"
                      ]
                    }
                  ],
                  "children.0.topBarActions": [
                    {
                      "label": "Invite",
                      "event": "INVITE",
                      "roles": [
                        "staff"
                      ]
                    },
                    {
                      "label": "Help",
                      "event": "HELP"
                    }
                  ]
                }
              }
            ]
          },
          "options": {
            "render": true,
            "renderProps": true
          }
        }
      ]
    },
    {
      "id": "g-cross-115-edge-no-viewer-role-sees-only-items-with-no-roles",
      "note": "an empty viewerRole matches no listed role",
      "config": {
        "navItems": [
          {
            "label": "Home",
            "href": "/"
          },
          {
            "label": "Members",
            "href": "/members",
            "roles": [
              "staff"
            ]
          },
          {
            "label": "Policies",
            "href": "/policies",
            "roles": [
              "staff",
              "admin"
            ]
          }
        ],
        "topBarActions": [
          {
            "label": "Invite",
            "event": "INVITE",
            "roles": [
              "staff"
            ]
          },
          {
            "label": "Help",
            "event": "HELP"
          }
        ],
        "viewerRole": ""
      },
      "steps": [
        {
          "trait": "AppLayout",
          "event": "INIT",
          "payload": {},
          "expect": {
            "fired": true,
            "rendered": [
              {
                "slot": "main",
                "props": {
                  "children.0.navItems": [
                    {
                      "label": "Home",
                      "href": "/"
                    }
                  ],
                  "children.0.topBarActions": [
                    {
                      "label": "Help",
                      "event": "HELP"
                    }
                  ]
                }
              }
            ]
          },
          "options": {
            "render": true,
            "renderProps": true
          }
        }
      ]
    }
  ]
}
