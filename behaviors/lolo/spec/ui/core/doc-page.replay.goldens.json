    {
      "id": "a-machine-segment-draws-its-machine-and-its-explainer-from-config",
      "config": {
        "explanations": [
          {
            "id": "inc",
            "orbitalName": "Docs",
            "traitName": "Counting",
            "transition": [
              "quote",
              "{\"from\":\"ready\",\"to\":\"ready\",\"event\":\"INCREMENT\"}"
            ]
          }
        ]
      },
      "entity": {
        "id": "v"
      },
      "steps": [
        {
          "trait": "DocPageRender",
          "event": "DOC_PAGE_SHOW",
          "payload": {
            "page": {
              "id": "en:/docs/m",
              "path": "/docs/m",
              "locale": "en",
              "title": "M",
              "lede": "",
              "crumbs": [],
