    {
      "id": "control-init-renders-the-configured-title",
      "config": {
        "title": "From config"
      },
      "entity": {
        "id": "v"
      },
      "steps": [
        {
          "trait": "DocPageRender",
          "event": "INIT",
          "payload": {},
          "expect": {
            "fired": true,
            "rendered": [
              {
                "slot": "main",
                "props": {
                  "children.0.children.0.children.1.children.1.children.0.content": "From config"
                }
              }
            ]
          },
          "options": {
            "render": true,
            "renderProps": true
          }
        }
      ]
    },
