          "expect": {
            "fired": true,
            "rendered": [
              {
                "slot": "main",
                "props": {
                  "children.0.children.0.children.1.children.1.children.0.content": "Page A",
                  "children.0.children.0.children.1.children.4.children.0.children.1.content": "Hello rows",
                  "children.0.children.0.children.1.children.4.children.0.children.0.content": "First",
