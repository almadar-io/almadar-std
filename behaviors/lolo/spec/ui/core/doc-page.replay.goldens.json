                  "anchor": "",
                  "heading": "",
                  "markdown": "",
                  "language": "",
                  "codeTitle": "",
                  "code": "",
                  "example": "",
                  "machine": {
                    "name": "Counting",
                    "linkedEntity": "Counter",
                    "states": [
                      {
                        "name": "ready",
                        "isInitial": true,
                        "isTerminal": false
                      }
                    ],
                    "transitions": [
                      {
                        "from": "ready",
                        "to": "ready",
                        "event": "INCREMENT",
                        "effects": [
                          {
                            "type": "set"
                          }
                        ],
                        "index": 1
                      }
                    ],
                    "emittedEvents": [],
                    "listenedEvents": []
                  },
                  "machineLabel": "Counter machine",
                  "explain": "inc",
                  "notes": {
                    "states": {},
                    "transitions": {
                      "INCREMENT": {
                        "body": "Adds one."
                      }
                    }
                  }
                }
              ]
            }
          },
          "expect": {
            "fired": true,
            "rendered": [
              {
                "slot": "main",
                "props": {
                  "children.0.children.0.children.1.children.4.children.0.children.3.trait.name": "Counting",
                  "children.0.children.0.children.1.children.4.children.0.children.3.aria-label": "Counter machine",
                  "children.0.children.0.children.1.children.4.children.0.children.4.children.0.traitName": "Counting",
                  "children.0.children.0.children.1.children.4.children.0.children.4.children.0.annotations.transitions.INCREMENT.body": "Adds one."
                }
              }
            ]
          },
          "options": {
            "render": true,
            "renderProps": true
