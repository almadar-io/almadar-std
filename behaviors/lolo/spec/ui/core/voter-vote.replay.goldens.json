{
 "atom": "../ui/core/atoms/std-voter-vote.lolo",
 "trait": "VoterVote",
 "note": "One row per voter and target, id = voter id, colon, target id. A vote updates the row; an update that answers not-found creates it; any other failure ends in error and writes nothing. The first case runs the whole chain against the replay kernel's store; the rest feed one store answer per step, and expect.state is that step's first transition.",
 "cases": [
  {
   "id": "first-vote-creates-the-row-and-later-votes-update-it",
   "note": "Played against the replay kernel's own store: the first update answers not-found and the create follows; the next votes update the stored row and never create.",
   "entity": {
    "id": "v",
    "targetId": "t1",
    "voterId": "",
    "direction": "none"
   },
   "steps": [
    {
     "trait": "VoterVote",
     "from": "idle",
     "event": "VOTE",
     "payload": {
      "next": "up"
     },
     "expect": {
      "fired": true,
      "state": "voting",
      "effects": [
       {
        "type": "persist",
        "arg0": "update",
        "arg1": "VoterVoteRow"
       }
      ],
      "exactEmits": [
       {
        "event": "VoterVoteRowMissed",
        "payload": {
         "code": "not-found"
        }
       },
       {
        "event": "VoteCasted"
       }
      ],
      "entity": {
       "direction": "up"
      }
     }
    },
    {
     "trait": "VoterVote",
     "from": "idle",
     "event": "VOTE",
     "payload": {
      "next": "down"
     },
     "expect": {
      "fired": true,
      "state": "voting",
      "effects": [
       {
        "type": "persist",
        "arg0": "update",
        "arg1": "VoterVoteRow"
       }
      ],
      "emitCounts": {
       "VoterVoteRowMissed": 0,
       "VoteCastFailed": 0,
       "VoteCasted": 1
      },
      "entity": {
       "direction": "down"
      }
     }
    },
    {
     "trait": "VoterVote",
     "from": "idle",
     "event": "VOTE",
     "payload": {
      "next": "down"
     },
     "expect": {
      "fired": true,
      "state": "voting",
      "effects": [
       {
        "type": "persist",
        "arg0": "update",
        "arg1": "VoterVoteRow"
       }
      ],
      "emitCounts": {
       "VoterVoteRowMissed": 0,
       "VoteCastFailed": 0,
       "VoteCasted": 1
      },
      "entity": {
       "direction": "none"
      }
     }
    }
   ]
  },
  {
