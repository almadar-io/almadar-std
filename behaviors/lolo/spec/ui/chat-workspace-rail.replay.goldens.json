    {
      "id": "picking-a-channel-row-opens-that-channel",
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "listing",
          "event": "CHANNEL_ROW",
          "payload": {
            "id": "design:u1",
            "row": {
              "id": "design:u1",
              "channel": "design",
              "channelName": "design",
              "member": "u1"
            }
          },
          "expect": {
            "state": "listing",
            "emits": [
              {
                "event": "CHANNEL_PICKED",
                "payload": {
                  "channel": "design",
                  "name": "design",
                  "isDirect": false
                }
              }
            ]
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
