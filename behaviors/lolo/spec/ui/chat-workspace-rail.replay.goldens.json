{
  "atom": "ui/core/atoms/std-chat-workspace.lolo",
  "trait": "ChannelRail",
  "cases": [
    {
      "id": "picking-a-channel-row-opens-that-channel",
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "listing",
          "event": "CHANNEL_ROW",
          "payload": {
            "id": "design:u1",
            "row": {
              "id": "design:u1",
              "channel": "design",
              "channelName": "design",
              "member": "u1"
            }
          },
          "expect": {
            "state": "listing",
            "emits": [
              {
                "event": "CHANNEL_PICKED",
                "payload": {
                  "channel": "design",
                  "name": "design",
                  "isDirect": false
                }
              }
            ]
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    },
    {
      "id": "picking-a-person-asks-for-their-direct-message-with-no-menu",
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "listing",
          "event": "PERSON_ROW",
          "payload": {
            "id": "u2",
            "row": {
              "id": "u2",
              "name": "Bor"
            }
          },
          "expect": {
            "state": "listing",
            "entity": {
              "openPerson": "u2"
            },
            "emits": [
              {
                "event": "PERSON_PICKED",
                "payload": {
                  "id": "u2",
                  "name": "Bor"
                }
              }
            ]
          },
          "trait": "PeopleRail"
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    }
  ]
}