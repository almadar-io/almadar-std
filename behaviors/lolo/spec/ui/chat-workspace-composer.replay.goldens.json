{
  "atom": "ui/core/atoms/std-chat-workspace.lolo",
  "trait": "MessageComposer",
  "cases": [
    {
      "id": "sending-in-an-open-conversation-emits-the-message-and-clears-the-draft",
      "entity": {
        "id": "x",
        "activeChannel": "design",
        "draft": "hello"
      },
      "steps": [
        {
          "from": "ready",
          "event": "SEND",
          "payload": {},
          "expect": {
            "state": "ready",
            "entity": {
              "draft": ""
            },
            "emits": [
              {
                "event": "SEND_MESSAGE",
                "payload": {
                  "data": {
                    "content": "hello",
                    "channel": "design",
                    "threadRootId": "",
                    "isReply": false
                  }
                }
              }
            ]
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    },
    {
      "id": "control-a-blank-draft-sends-nothing",
      "entity": {
        "id": "x",
        "activeChannel": "design",
        "draft": "   "
      },
      "steps": [
        {
          "from": "ready",
          "event": "SEND",
          "payload": {},
          "expect": {
            "state": "ready",
            "neverEmits": [
              "SEND_MESSAGE"
            ]
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    },
    {
      "id": "control-with-no-conversation-open-sends-nothing-and-keeps-the-draft",
      "entity": {
        "id": "x",
        "activeChannel": "",
        "draft": "hello"
      },
      "steps": [
        {
          "from": "ready",
          "event": "SEND",
          "payload": {},
          "expect": {
            "state": "ready",
            "entity": {
              "draft": "hello"
            },
            "neverEmits": [
              "SEND_MESSAGE"
            ]
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    },
    {
      "id": "an-emoji-is-appended-to-the-draft",
      "entity": {
        "id": "x",
        "draft": "nice "
      },
      "steps": [
        {
          "from": "ready",
          "event": "EMOJI_PICKED",
          "payload": {
            "emoji": "🎉"
          },
          "expect": {
            "state": "ready",
            "entity": {
              "draft": "nice 🎉"
            }
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    },
    {
      "id": "opening-a-conversation-arms-the-composer-in-its-own-frame",
      "entity": {
        "id": "x",
        "activeChannel": ""
      },
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ],
      "steps": [
        {
          "from": "ready",
          "event": "OPENED",
          "payload": {
            "channel": "general",
            "name": "general",
            "isDirect": false
          },
          "expect": {
            "state": "ready",
            "entity": {
              "activeChannel": "general",
              "draft": ""
            }
          }
        },
        {
          "from": "ready",
          "event": "DRAFT_CHANGED",
          "payload": {
            "value": "hi"
          },
          "expect": {
            "state": "ready",
            "entity": {
              "draft": "hi"
            }
          }
        },
        {
          "from": "ready",
          "event": "SEND",
          "payload": {},
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "SEND_MESSAGE",
                "payload": {
                  "data": {
                    "content": "hi",
                    "channel": "general",
                    "threadRootId": "",
                    "isReply": false
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-pressed-tool-is-announced-with-the-tool-it-names",
      "note": "Each composer tool fires TOOL_PRESSED with its event name; the composer emits TOOL_USED so a consumer routes it with a filtered listen.",
      "entity": {
        "id": "x",
        "draft": "hi"
      },
      "steps": [
        {
          "from": "ready",
          "event": "TOOL_PRESSED",
          "payload": {
            "tool": "MENTION_REQUESTED"
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "TOOL_USED",
                "payload": {
                  "tool": "MENTION_REQUESTED"
                }
              }
            ],
            "entity": {
              "draft": "hi"
            }
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    },
    {
      "id": "control-an-emoji-pick-announces-no-tool",
      "entity": {
        "id": "x",
        "draft": "nice "
      },
      "steps": [
        {
          "from": "ready",
          "event": "EMOJI_PICKED",
          "payload": {
            "emoji": "x"
          },
          "expect": {
            "state": "ready",
            "neverEmits": [
              "TOOL_USED"
            ]
          }
        }
      ],
      "defaults": [
        "WorkspaceShell",
        "ChannelRail",
        "PeopleRail",
        "ConversationHeader",
        "MessageFeed",
        "MessageComposer",
        "ThreadPanel",
        "MembersPanel",
        "PeoplePicker"
      ]
    }
  ]
}