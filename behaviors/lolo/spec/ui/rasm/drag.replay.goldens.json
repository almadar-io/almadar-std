{
 "atom": "../ui/rasm/atoms/std-rasm-drag.lolo",
 "trait": "RasmDrag",
 "cases": [
  {
   "id": "a-drop-on-a-target-reports-it-and-the-item-returns",
   "config": {
    "id": "d",
    "label": "Card",
    "targets": [
     "A",
     "B"
    ],
    "z": 2,
    "dragZ": 9
   },
   "entity": {
    "id": "d"
   },
   "steps": [
    {
     "from": "idle",
     "event": "RASM_PLACE",
     "payload": {
      "placed": [
       {
        "id": "d",
        "rect": {
         "x": 10,
         "y": 10,
         "w": 80,
         "h": 40
        }
       },
       {
        "id": "A",
        "rect": {
         "x": 200,
         "y": 0,
         "w": 100,
         "h": 100
        }
       },
       {
        "id": "B",
        "rect": {
         "x": 400,
         "y": 0,
         "w": 100,
         "h": 100
        }
       },
       {
        "id": "C",
        "rect": {
         "x": 600,
         "y": 0,
         "w": 100,
         "h": 100
        }
       }
      ]
     },
     "expect": {
      "entity": {
       "rect": {
        "x": 10,
        "y": 10,
        "w": 80,
        "h": 40
       }
      }
     }
    },
    {
     "from": "idle",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "down",
      "id": "d",
      "x": 20,
      "y": 20
     },
     "expect": {
      "state": "dragging"
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "move",
      "id": "d",
      "x": 120,
      "y": 70
     },
     "expect": {
      "entity": {
       "dx": 100,
       "dy": 50,
       "over": ""
      }
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "move",
      "id": "d",
      "x": 250,
      "y": 50
     },
     "expect": {
      "entity": {
       "dx": 230,
       "dy": 30,
       "over": "A"
      },
      "emits": [
       {
        "event": "RASM_DRAG_OVER",
        "payload": {
         "id": "d",
         "target": "A"
        }
       }
      ]
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "move",
      "id": "d",
      "x": 260,
      "y": 60
     },
     "expect": {
      "entity": {
       "over": "A"
      },
      "exactEmits": [
       {
        "event": "REPAINT",
        "payload": {
         "n": 5
        }
       }
      ]
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "up",
      "id": "d",
      "x": 260,
      "y": 60
     },
     "expect": {
      "state": "idle",
      "entity": {
       "dx": 0,
       "dy": 0,
       "over": ""
      },
      "emits": [
       {
        "event": "RASM_DRAG_DROPPED",
        "payload": {
         "id": "d",
         "target": "A",
         "x": 260,
         "y": 60
        }
       }
      ]
     }
    }
   ]
  },
