    "id": "ch",
    "title": "chat.title",
    "placeholder": "chat.placeholder",
    "messages": [
     {
      "on": "",
      "side": "user",
      "key": "m.ask"
     },
     {
      "on": "s1",
      "side": "agent",
      "key": "m.one"
     },
     {
      "on": "s2",
      "side": "agent",
      "key": "m.two"
     }
    ]
   },
   "entity": {
    "id": "x"
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_PLACE",
