{
  "atom": "../ui/rasm/atoms/std-rasm-chat.lolo",
  "trait": "RasmChat",
  "cases": [
    {
      "id": "a-placed-panel-paints",
      "config": {
        "id": "ch",
        "title": "chat.title",
        "placeholder": "chat.placeholder",
        "messages": [
          {
            "on": "",
            "side": "user",
            "key": "m.ask"
          },
          {
            "on": "s1",
            "side": "agent",
            "key": "m.one"
          },
          {
            "on": "s2",
            "side": "agent",
            "key": "m.two"
          }
        ]
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "ch",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 360,
                  "h": 600
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "CHAT_PAINT": 1
            }
          }
        }
      ]
    },
