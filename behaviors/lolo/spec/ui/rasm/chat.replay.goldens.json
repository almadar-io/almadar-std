       {
        "id": "ch",
        "rect": {
         "x": 0,
         "y": 0,
         "w": 360,
         "h": 600
        }
       }
      ]
     },
     "expect": {
      "state": "ready",
      "emitCounts": {
       "CHAT_PAINT": 1
      }
     }
    }
   ]
  },
