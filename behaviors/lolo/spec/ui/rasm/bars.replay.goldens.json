{
  "atom": "../ui/rasm/atoms/std-rasm-bars.lolo",
  "trait": "RasmBars",
  "cases": [
    {
      "id": "a-placed-chart-paints",
      "config": {
        "id": "bc",
        "bars": [
          {
            "label": "b.w1",
            "shown": "b.v1",
            "value": 4
          },
          {
            "label": "b.w2",
            "shown": "b.v2",
            "value": 8
          }
        ],
        "steps": [
          {
            "on": "k2",
            "bar": 1,
            "value": 9,
            "shown": "b.v9"
          }
        ]
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "bc",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 400,
                  "h": 200
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "BARS_PAINT": 1
            }
          }
        }
      ]
    },
    {
      "id": "a-step-entry-changes-the-bar-and-highlights-it",
      "config": {
        "id": "bc",
        "bars": [
          {
            "label": "b.w1",
            "shown": "b.v1",
            "value": 4
          },
          {
