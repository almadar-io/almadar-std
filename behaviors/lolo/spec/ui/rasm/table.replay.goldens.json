{
  "atom": "../ui/rasm/atoms/std-rasm-table.lolo",
  "trait": "RasmTable",
  "cases": [
    {
      "id": "a-placed-table-paints",
      "config": {
        "id": "tb",
        "columns": [
          {
            "key": "req",
            "label": "t.req",
            "share": 3,
            "kind": "text"
          },
          {
            "key": "dec",
            "label": "t.dec",
            "share": 1,
            "kind": "pill"
          }
        ],
        "rows": [
          {
            "id": "r1",
            "cells": {
              "req": "t.r1",
              "dec": "t.pending"
            },
            "tones": {
              "dec": "pending"
            }
          },
          {
            "id": "r2",
            "cells": {
              "req": "t.r2",
              "dec": "t.ok"
            },
            "tones": {
              "dec": "ok"
            }
          }
        ],
        "steps": [
          {
            "on": "s2",
            "row": "r1",
            "key": "dec",
            "value": "t.ok",
            "tone": "ok"
          }
        ]
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "tb",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 600,
                  "h": 200
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "TABLE_PAINT": 1
            }
          }
        }
      ]
    },
