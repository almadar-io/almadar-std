  {
   "id": "a-placed-image-paints-its-picture-into-a-target-and-shows-it-through-the-none-look",
   "config": {
    "id": "hero-art",
    "url": "https://images.test/a.jpg",
    "z": 2
   },
   "entity": {
    "id": "i",
    "looks": {
     "image/none/idle": {
      "fill": "primary",
      "material": {
       "wgsl": "NONE",
       "params": [
        0,
        0,
        0,
        0
       ],
       "live": false
      }
     },
     "image/riso/idle": {
      "fill": "primary",
      "material": {
       "wgsl": "RISO",
       "params": [
        0,
        0,
        0,
        0
       ],
       "live": false
      }
     }
    },
    "url": "https://images.test/a.jpg"
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_PLACE",
     "payload": {
      "placed": [
       {
        "id": "hero-art",
        "rect": {
         "x": 10,
         "y": 20,
         "w": 300.4,
         "h": 200
        }
       }
      ]
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_PAINT",
        "payload": {
         "id": "hero-art",
         "z": 2,
         "texts": [],
         "nodes": [
          {
           "type": "draw-group",
           "id": "hero-art:source",
           "position": {
            "x": 10,
            "y": 20,
            "z": 2
           },
           "target": {
            "id": "hero-art:target",
            "width": 300,
            "height": 200
           },
           "items": [
            {
             "type": "draw-sprite",
             "id": "hero-art:photo",
             "asset": {
              "url": "https://images.test/a.jpg"
             },
             "fit": "cover",
             "anchor": "top-left",
             "position": {
              "x": 0,
              "y": 0,
              "z": 0
             },
             "width": 300,
             "height": 200
            }
           ]
          },
          {
           "type": "draw-shape",
           "id": "hero-art",
           "shape": "rect",
           "anchor": "top-left",
           "position": {
            "x": 10,
            "y": 20,
            "z": 2
           },
           "width": 300.4,
           "height": 200,
           "fill": "primary",
           "material": {
            "wgsl": "NONE",
            "params": [
             0,
             0,
             0,
             0
            ],
            "live": false,
            "targets": [
             "hero-art:target"
            ]
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
