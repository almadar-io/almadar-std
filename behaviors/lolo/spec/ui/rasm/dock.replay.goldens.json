    {
      "id": "an idle breakpoint places nothing",
      "config": {
        "child": "bar",
        "edge": "bottom",
        "height": 600,
        "idleOn": [
          "phone"
        ]
      },
      "entity": {
        "id": "d",
        "viewW": 390,
        "viewH": 800,
        "bp": "phone"
      },
      "steps": [
        {
          "from": "ready",
          "event": "DOCK_PLACE",
