{
  "atom": "../ui/rasm/atoms/std-rasm-dock.lolo",
  "trait": "RasmDock",
  "cases": [
    {
      "id": "resize takes the size and asks for a placement",
      "config": {
        "child": "bar",
        "edge": "top"
      },
      "entity": {
        "id": "d"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_RESIZE",
          "payload": {
            "width": 1000,
            "height": 700
          },
          "expect": {
            "state": "ready",
            "entity": {
              "viewW": 1000,
              "viewH": 700
            },
            "emits": [
              {
                "event": "DOCK_PLACE"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a stretched bottom dock fills the width at the bottom edge",
      "config": {
        "child": "bar",
        "edge": "bottom",
        "align": "stretch",
        "height": 600,
        "margin": 0
      },
      "entity": {
        "id": "d",
        "viewW": 1000,
        "viewH": 800
      },
      "steps": [
        {
          "from": "ready",
          "event": "DOCK_PLACE",
          "payload": {
            "n": 1
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_PLACE",
                "payload": {
                  "placed": [
                    {
                      "id": "bar",
                      "rect": {
                        "x": 0,
                        "y": 200,
                        "w": 1000,
                        "h": 600
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a centred top dock sits in the middle under the margin",
      "config": {
        "child": "bar",
        "edge": "top",
        "align": "center",
        "width": 600,
        "height": 56,
        "margin": 16
      },
      "entity": {
        "id": "d",
        "viewW": 1000,
        "viewH": 800
      },
      "steps": [
