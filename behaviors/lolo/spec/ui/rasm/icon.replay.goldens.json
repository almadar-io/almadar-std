  "cases": [
    {
      "id": "a-labelled-icon-paints-a-tinted-sprite-and-announces-its-label-as-an-image",
      "config": {
        "id": "i",
        "icon": "lucide:arrow-right",
        "size": 24,
        "label": "icon.next",
        "decorative": false,
        "z": 2
      },
      "entity": {
        "id": "i",
        "looks": {
          "icon/default/idle": {
            "textColor": "foreground"
          }
        }
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "i",
                "rect": {
                  "x": 10,
                  "y": 20,
                  "w": 40,
                  "h": 40
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_PAINT",
                "payload": {
                  "id": "i",
                  "z": 2,
                  "nodes": [
                    {
                      "type": "draw-sprite",
                      "id": "i",
                      "asset": {
                        "url": "https://api.iconify.design/lucide/arrow-right.svg"
                      },
                      "anchor": "top-left",
                      "position": {
                        "x": 18,
                        "y": 28,
                        "z": 2
                      },
                      "width": 24,
                      "height": 24,
                      "tint": "foreground",
                      "flipX": false,
                      "rotation": 0,
                      "semantic": {
                        "role": "img",
                        "labelledBy": "i:name"
                      }
                    }
                  ],
                  "texts": [
                    {
                      "id": "i:name",
                      "key": "icon.next",
                      "x": 10,
                      "y": 20,
                      "z": 2,
                      "align": "left",
                      "baseline": "top",
                      "color": "transparent",
                      "font": "400 1px body"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
