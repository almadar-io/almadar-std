    {
      "id": "a press on a pressable strip announces where across it the press landed",
      "config": {
        "pressable": true
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_POINTER",
          "entity": {
            "looks": {},
            "rect": {
