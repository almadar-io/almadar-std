{
 "atom": "../ui/rasm/atoms/std-rasm-textfield.lolo",
 "trait": "RasmTextField",
 "cases": [
  {
   "id": "an-edit-paints-once-on-the-cursor-announcement-that-follows-it",
   "config": {
    "id": "name",
    "label": "Name"
   },
   "entity": {
    "id": "t",
    "hasLooks": true,
    "hasRect": true,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 200,
     "h": 60
    }
   },
   "steps": [
    {
     "from": "focused",
     "event": "BUFFER_EDITED",
     "payload": {
      "editorId": "name",
      "path": "",
      "version": 1,
      "text": "a",
      "dirty": true
     },
     "expect": {
      "state": "focused",
      "exactEmits": [
       {
        "event": "RASM_TEXT_CHANGED",
        "payload": {
         "value": "a"
        }
       }
      ]
     }
    },
    {
     "from": "focused",
     "event": "CURSOR_MOVED",
     "payload": {
      "editorId": "name",
      "row": 0,
      "col": 1,
      "mode": "INSERT"
     },
     "expect": {
      "state": "focused",
      "emits": [
       {
        "event": "RASM_PAINT",
        "payload": {
         "id": "name"
        }
       }
      ]
     }
    }
   ]
  },
