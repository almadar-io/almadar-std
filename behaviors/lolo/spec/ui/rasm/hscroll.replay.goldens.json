  "cases": [
    {
      "id": "a-tall-anchor-places-a-row-and-sends-the-travel-and-the-hold",
      "config": {
        "id": "g",
        "anchor": "track",
        "items": [
          "a",
          "b",
          "c"
        ],
        "moves": [
          "m"
        ],
        "holds": [
          "h"
        ],
        "lead": 100,
        "cardWidth": 0.5,
        "cardH": 300,
        "gap": 20,
        "pad": 40,
        "dwell": 0.1,
        "phoneCardH": 200,
        "stackOn": [
          "phone"
        ]
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_RESIZE",
          "payload": {
            "width": 1000,
            "height": 800
          },
          "expect": {
            "state": "ready",
            "neverEmits": [
              "RASM_PLACE",
              "RASM_SCRUB"
            ]
          }
        },
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "track",
                "rect": {
                  "x": 0,
                  "y": 1000,
                  "w": 1000,
                  "h": 2800
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_PLACE",
                "payload": {
                  "placed": [
                    {
                      "id": "a",
                      "rect": {
                        "x": 40,
                        "y": 1300,
                        "w": 500,
                        "h": 300
                      }
                    },
                    {
                      "id": "b",
                      "rect": {
                        "x": 560,
                        "y": 1300,
                        "w": 500,
                        "h": 300
                      }
                    },
                    {
                      "id": "c",
                      "rect": {
                        "x": 1080,
                        "y": 1300,
                        "w": 500,
                        "h": 300
                      }
                    }
                  ]
                }
              },
              {
                "event": "RASM_SCRUB",
                "payload": {
                  "id": "g",
                  "paints": [
                    "a",
                    "b",
                    "c",
                    "m"
                  ],
                  "from": 1000,
                  "to": 3000,
                  "keyframes": [
                    {
                      "at": 0,
                      "offsetX": 0,
                      "offsetY": 0
                    },
                    {
                      "at": 0.1,
                      "offsetX": 0,
                      "offsetY": 200
                    },
                    {
                      "at": 0.9,
                      "offsetX": -620,
                      "offsetY": 1800
                    },
                    {
                      "at": 1,
                      "offsetX": -620,
                      "offsetY": 2000
                    }
                  ]
                }
              },
              {
                "event": "RASM_SCRUB",
                "payload": {
                  "id": "g:hold",
                  "paints": [
                    "h"
                  ],
                  "from": 1000,
                  "to": 3000,
                  "keyframes": [
                    {
                      "at": 0,
                      "offsetY": 0
                    },
                    {
                      "at": 1,
                      "offsetY": 2000
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
