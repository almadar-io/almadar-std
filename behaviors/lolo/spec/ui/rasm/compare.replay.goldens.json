  "trait": "RasmCompare",
  "cases": [
    {
      "id": "placing-the-comparison-paints-it",
      "config": {
        "id": "cmp",
        "label": "l",
        "beforeLabel": "b",
        "afterLabel": "a",
        "beforeUrl": "https://x/b.jpg",
        "afterUrl": "https://x/a.jpg"
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "cmp",
                "rect": {
                  "x": 100,
                  "y": 0,
                  "w": 400,
                  "h": 300
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "RASM_PAINT": 1
            }
          }
        }
      ]
    },
