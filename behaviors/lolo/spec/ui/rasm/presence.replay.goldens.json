       {
        "event": "RASM_ENTER",
        "payload": {
         "order": [
          "h"
         ],
         "staggerMs": 40
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "with-a-style-each-entering-id-gets-the-signature-keyframes-delayed-by-its-place",
   "config": {
    "order": [
     "a",
     "b"
    ],
    "staggerMs": 40
   },
   "entity": {
    "id": "p",
    "motion": {
     "signature": "rise",
     "stiffness": 170,
     "damping": 20,
     "stagger": 100,
     "enterMs": 400,
     "keyframes": [
      {
       "at": 0,
       "opacity": 0,
       "offsetX": 0,
       "offsetY": 18
      },
      {
       "at": 1,
       "opacity": 1,
       "offsetX": 0,
       "offsetY": 0
      }
     ]
    }
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_PRESENCE_PLAY",
     "payload": {
      "order": [
       "a",
       "b"
      ]
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_ENTER",
        "payload": {
         "order": [
          "a",
          "b"
         ],
         "staggerMs": 100,
         "entries": [
          {
           "id": "a",
           "durationMs": 400,
           "keyframes": [
            {
             "at": 0,
             "opacity": 0,
             "offsetX": 0,
             "offsetY": 18
            },
            {
             "at": 0,
             "opacity": 0,
             "offsetX": 0,
             "offsetY": 18
            },
            {
             "at": 1,
             "opacity": 1,
             "offsetX": 0,
             "offsetY": 0
            }
           ]
          },
          {
           "id": "b",
           "durationMs": 500,
           "keyframes": [
            {
             "at": 0,
             "opacity": 0,
             "offsetX": 0,
             "offsetY": 18
            },
            {
             "at": 0.2,
             "opacity": 0,
             "offsetX": 0,
             "offsetY": 18
            },
            {
             "at": 1,
             "opacity": 1,
             "offsetX": 0,
             "offsetY": 0
            }
           ]
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
