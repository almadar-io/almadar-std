app theme-cycle-example [
  version: "0.1.0",
  theme: "gazette-light",
  themes: ["gazette-light", "memphis-light", "neon-dark"],
  description: "Three art directions on std-rasm-theme-cycle: the fixture the theme-cycle goldens replay.",
  locales: [en, ar, sl]
]
uses Cycle from "std/behaviors/std-rasm-theme-cycle"

orbital ThemeCycleExample = Cycle.orbitals.RasmThemeCycleOrbital {
  traits {
    RasmThemeCycle {
      config {
        themes: ["gazette-light", "memphis-light", "neon-dark", "gone-light"]
        styles: ["gazette", "memphis", "neon", "wabi-sabi"]
        labels: ["theme.gazette", "theme.memphis", "theme.neon", "theme.wabi"]
        start: "gazette"
        refused: "theme.refused"
      }
    }
  }
}
