{
  "atom": "../ui/rasm/atoms/std-rasm-anchor.lolo",
  "trait": "RasmAnchor",
  "cases": [
    {
      "id": "a-popup-anchored-to-a-control-inside-an-origin-is-placed-under-its-page-position",
      "config": {
        "gap": 4
      },
      "entity": {
        "id": "anchor",
        "viewW": 800,
        "viewH": 600
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_ANCHOR",
          "payload": {
            "id": "menu",
            "anchor": "btn",
            "side": "below",
            "width": 100,
            "height": 40
          },
          "entity": {
            "id": "anchor",
            "viewW": 800,
            "viewH": 600,
            "rects": {
              "btn": {
                "x": 10,
                "y": 20,
                "w": 60,
                "h": 30
              }
            },
            "placedIn": {
              "btn": "card"
            },
            "pageOrigins": {
              "card": {
                "x": 200,
                "y": 100
              }
            }
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_PLACE",
                "payload": {
                  "placed": [
                    {
                      "id": "menu",
                      "origin": "",
                      "rect": {
                        "x": 210,
                        "y": 154,
                        "w": 100,
                        "h": 40
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control-a-popup-anchored-to-a-page-control-keeps-its-rect",
      "config": {
        "gap": 4
      },
      "entity": {
        "id": "anchor",
        "viewW": 800,
        "viewH": 600
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_ANCHOR",
          "payload": {
            "id": "menu",
            "anchor": "btn",
            "side": "below",
            "width": 100,
            "height": 40
          },
          "entity": {
            "id": "anchor",
            "viewW": 800,
            "viewH": 600,
            "rects": {
              "btn": {
                "x": 10,
                "y": 20,
                "w": 60,
                "h": 30
              }
            },
            "placedIn": {
              "btn": ""
            },
            "pageOrigins": {
              "card": {
                "x": 200,
                "y": 100
              }
            }
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_PLACE",
                "payload": {
                  "placed": [
                    {
                      "id": "menu",
                      "origin": "",
                      "rect": {
                        "x": 10,
                        "y": 54,
                        "w": 100,
                        "h": 40
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "the-anchor-keeps-the-origin-each-control-was-placed-in-and-the-page-offsets",
      "config": {
        "gap": 4
      },
      "entity": {
        "id": "anchor"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "btn",
                "rect": {
                  "x": 1,
                  "y": 2,
                  "w": 3,
                  "h": 4
                },
                "origin": "card"
              },
              {
                "id": "top",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 1,
                  "h": 1
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "entity": {
              "placedIn": {
                "btn": "card",
                "top": ""
              }
            }
          }
        },
        {
          "from": "ready",
          "event": "RASM_PAGE_ORIGINS",
          "payload": {
            "offsets": {
              "card": {
                "x": 5,
                "y": 6
              }
            }
          },
          "expect": {
            "state": "ready",
            "entity": {
              "pageOrigins": {
                "card": {
                  "x": 5,
                  "y": 6
                }
              }
            }
          }
        }
      ]
    }
  ]
}
