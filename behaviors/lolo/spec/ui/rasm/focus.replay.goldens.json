{
 "atom": "../ui/rasm/atoms/std-rasm-focus.lolo",
 "trait": "RasmFocus",
 "cases": [
  {
   "id": "tab-moves-focus-forward-and-shift-tab-wraps-backward",
   "config": {
    "order": [
     "a",
     "b",
     "c"
    ]
   },
   "entity": {
    "id": "f"
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_KEY",
     "payload": {
      "key": "next"
     },
     "expect": {
      "emits": [
       {
        "event": "RASM_FOCUS",
        "payload": {
         "id": "a"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "RASM_KEY",
     "payload": {
      "key": "previous"
     },
     "expect": {
      "emits": [
       {
        "event": "RASM_FOCUS",
        "payload": {
         "id": "c"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "RASM_KEY",
     "payload": {
      "key": "activate"
     },
     "expect": {
      "emits": [
       {
        "event": "RASM_ACTIVATE",
        "payload": {
         "id": "c"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "RASM_KEY",
     "payload": {
      "key": "decrease"
     },
     "expect": {
      "emits": [
       {
        "event": "RASM_STEP",
        "payload": {
         "id": "c",
         "delta": -1
        }
       }
      ]
     }
    }
   ]
  }
 ]
}