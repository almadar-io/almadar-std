{
  "atom": "../ui/rasm/atoms/std-rasm-stepper.lolo",
  "trait": "RasmStepper",
  "cases": [
    {
      "id": "a-placed-stepper-paints",
      "config": {
        "id": "st",
        "steps": [
          {
            "label": "s.crawl",
            "number": "s.n1",
            "on": ""
          },
          {
            "label": "s.pages",
            "number": "s.n2",
            "on": "a2"
          },
          {
            "label": "s.checks",
            "number": "s.n3",
            "on": "a3"
          }
        ],
        "start": 0
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "st",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 600,
                  "h": 80
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "STEPPER_PAINT": 1
            }
          }
        }
      ]
    },
    {
      "id": "a-step-entry-makes-that-step-current",
      "config": {
        "id": "st",
        "steps": [
          {
            "label": "s.crawl",
            "number": "s.n1",
            "on": ""
          },
          {
