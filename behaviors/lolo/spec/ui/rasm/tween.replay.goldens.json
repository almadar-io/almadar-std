{
 "atom": "../ui/rasm/atoms/std-rasm-tween.lolo",
 "trait": "RasmTween",
 "cases": [
  {
   "id": "a-linear-run-steps-evenly-and-lands-on-the-target-with-done",
   "config": {
    "id": "t"
   },
   "entity": {
    "id": "t"
   },
   "steps": [
    {
     "from": "idle",
     "event": "RASM_TWEEN_START",
     "payload": {
      "id": "t",
      "from": 0,
      "to": 100,
      "durationMs": 100
     },
     "expect": {
      "state": "running",
      "emits": [
       {
        "event": "RASM_TWEEN_STEP",
        "payload": {
         "id": "t",
         "value": 0,
         "t": 0
        }
       }
      ]
     }
    },
    {
     "from": "running",
     "event": "RASM_TWEEN_FRAME",
     "payload": {
      "dtMs": 25
     },
     "expect": {
      "state": "running",
      "entity": {
       "value": 25
      },
      "emits": [
       {
        "event": "RASM_TWEEN_STEP",
        "payload": {
         "id": "t",
         "value": 25,
         "t": 0.25
        }
       }
      ]
     }
    },
    {
     "from": "running",
     "event": "RASM_TWEEN_FRAME",
     "payload": {
      "dtMs": 25
     },
     "expect": {
      "entity": {
       "value": 50
      }
     }
    },
    {
     "from": "running",
     "event": "RASM_TWEEN_FRAME",
     "payload": {
      "dtMs": 60
     },
     "expect": {
      "state": "idle",
      "entity": {
       "value": 100
      },
      "emits": [
       {
        "event": "RASM_TWEEN_STEP",
        "payload": {
         "id": "t",
         "value": 100,
         "t": 1
        }
       },
       {
        "event": "RASM_TWEEN_DONE",
        "payload": {
         "id": "t",
         "value": 100
        }
       }
      ]
     }
    }
   ]
  },
  {
