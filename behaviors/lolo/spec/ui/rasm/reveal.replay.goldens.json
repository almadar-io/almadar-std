{
  "atom": "../ui/rasm/atoms/std-rasm-reveal.lolo",
  "trait": "RasmReveal",
  "cases": [
    {
      "id": "placing-the-cover-paints-it",
      "config": {
        "id": "cov",
        "lift": [
          {
            "id": "btn",
            "region": "a"
          }
        ]
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "cov",
                "rect": {
                  "x": 0,
                  "y": 100,
                  "w": 400,
                  "h": 300
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "RASM_PAINT": 1
            }
          }
        }
      ]
    },
    {
