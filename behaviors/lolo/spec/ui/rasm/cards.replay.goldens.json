{
 "atom": "../ui/rasm/atoms/std-rasm-cards.lolo",
 "trait": "RasmCards",
 "cases": [
  {
   "id": "cards-below-the-view-wait-unseen-until-the-grid-reaches-the-view-line",
   "config": {
    "id": "menu",
    "cols": 3
   },
   "entity": {
    "id": "c",
    "looks": {
     "stack/card/idle": {
      "fill": "#111"
     },
     "text/title/idle": {
      "textColor": "#fff",
      "font": "400 20px serif"
     },
     "text/body/idle": {
      "textColor": "#ccc",
      "font": "400 15px serif"
     },
     "text/eyebrow/idle": {
      "textColor": "#f80",
      "font": "600 12px serif"
     }
    },
    "viewH": 800,
    "rect": {
     "x": 0,
     "y": 1000,
     "w": 900,
     "h": 340
    }
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_CARDS",
     "payload": {
      "id": "menu",
      "cards": [
       {
        "title": "A",
        "body": "one",
        "badge": "x"
       },
       {
        "title": "B",
        "body": "two",
        "badge": "y"
       }
      ]
     },
     "expect": {
      "state": "ready",
      "emitCounts": {
       "RASM_PAINT": 1
      }
     }
    },
    {
     "from": "ready",
     "event": "RASM_PAGE_SCROLLED",
     "payload": {
      "offset": 100,
      "max": 3000
     },
     "expect": {
      "state": "ready",
      "emitCounts": {
       "RASM_PAINT": 1
      }
     }
    }
   ]
  },
  {
   "id": "control-records-for-another-grid-paint-nothing",
   "config": {
    "id": "menu"
   },
   "entity": {
    "id": "c",
    "looks": {
     "stack/card/idle": {
      "fill": "#111"
     },
     "text/title/idle": {
      "textColor": "#fff",
      "font": "400 20px serif"
     },
     "text/body/idle": {
      "textColor": "#ccc",
      "font": "400 15px serif"
     },
     "text/eyebrow/idle": {
      "textColor": "#f80",
      "font": "600 12px serif"
     }
    },
    "viewH": 800,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 900,
     "h": 340
    }
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_CARDS",
     "payload": {
      "id": "other",
      "cards": [
       {
        "title": "A",
        "body": "one",
        "badge": "x"
       },
       {
        "title": "B",
        "body": "two",
        "badge": "y"
       }
      ]
     },
     "expect": {
      "state": "ready",
      "neverEmits": [
       "RASM_PAINT"
      ]
     }
    }
   ]
  },
  {
   "id": "control-no-records-paint-nothing",
   "config": {
    "id": "menu"
   },
   "entity": {
    "id": "c",
    "looks": {
     "stack/card/idle": {
      "fill": "#111"
     },
     "text/title/idle": {
      "textColor": "#fff",
      "font": "400 20px serif"
     },
     "text/body/idle": {
      "textColor": "#ccc",
      "font": "400 15px serif"
     },
     "text/eyebrow/idle": {
      "textColor": "#f80",
      "font": "600 12px serif"
     }
    },
    "viewH": 800,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 900,
     "h": 340
    }
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_RESIZE",
     "payload": {
      "width": 900,
      "height": 800
     },
     "expect": {
      "state": "ready",
      "neverEmits": [
       "RASM_PAINT"
      ]
     }
    }
   ]
  }
 ]
}
