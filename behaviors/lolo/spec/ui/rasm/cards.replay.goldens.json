  {
   "id": "with-turn-on-entering-a-card-turns-it-and-leaving-turns-it-back",
   "config": {
    "id": "menu",
    "turn": true
   },
   "entity": {
    "id": "c",
    "looks": {
     "stack/card/idle": {
      "fill": "#111"
     }
    },
    "viewH": 800,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 900,
     "h": 340
    },
    "arrivedMs": 1,
    "cards": [
     {
      "title": "A",
      "body": "one",
      "badge": "x",
      "back": "Pairs with the bream"
     },
     {
      "title": "B",
      "body": "two",
      "badge": "y"
     }
    ]
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "enter",
      "id": "menu:card:0:plate",
      "x": 10,
      "y": 10
     },
     "expect": {
      "state": "ready",
      "emitCounts": {
       "RASM_PAINT": 1
      },
      "entity": {
       "turned": 0,
       "was": -1
      }
     }
    },
    {
     "from": "ready",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "leave",
      "id": "menu:card:0:plate",
      "x": 10,
      "y": 10
     },
     "expect": {
      "state": "ready",
      "emitCounts": {
       "RASM_PAINT": 1
      },
      "entity": {
       "turned": -1,
       "was": 0
      }
     }
    }
   ]
  },
