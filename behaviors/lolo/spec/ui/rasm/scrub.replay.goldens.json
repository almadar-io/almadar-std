    {
      "id": "a-dashOffset-keyframe-passes-through-unscaled",
      "config": {
        "id": "draw",
        "anchor": "sec",
        "paints": [
          "route"
        ],
        "enter": 1,
        "exit": 0,
        "relativeTo": "plan",
        "keyframes": [
          {
            "at": 0,
            "dashOffset": 1000
          },
          {
            "at": 1,
            "dashOffset": 0
          }
        ]
      },
      "entity": {
        "id": "x"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_RESIZE",
          "payload": {
            "width": 400,
            "height": 300
          },
          "expect": {
            "state": "ready",
            "neverEmits": [
              "RASM_SCRUB"
            ]
          }
        },
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "sec",
                "rect": {
                  "x": 0,
                  "y": 1000,
                  "w": 400,
                  "h": 200
                }
              },
              {
                "id": "plan",
                "rect": {
                  "x": 500,
                  "y": 0,
                  "w": 600,
                  "h": 800
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_SCRUB",
                "payload": {
                  "id": "draw",
                  "paints": [
                    "route"
                  ],
                  "from": 700,
                  "to": 1200,
                  "keyframes": [
                    {
                      "at": 0,
                      "dashOffset": 1000
                    },
                    {
                      "at": 1,
                      "dashOffset": 0
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ]
