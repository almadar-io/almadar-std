 "cases": [
  {
   "id": "a-drag-sets-a-snapped-value-and-the-release-reports-it-clamped",
   "config": {
    "id": "w",
    "label": "Warmth",
    "min": 0,
    "max": 100,
    "step": 5,
    "value": 60,
    "z": 2
   },
   "entity": {
    "id": "w"
   },
   "steps": [
    {
     "from": "idle",
     "event": "INIT",
     "payload": {},
     "expect": {
      "entity": {
       "value": 60
      }
     }
    },
    {
     "from": "idle",
     "event": "RASM_PLACE",
     "payload": {
      "placed": [
       {
        "id": "w",
        "rect": {
         "x": 100,
         "y": 0,
         "w": 200,
         "h": 56
        }
       }
      ]
     },
     "expect": {
      "entity": {
       "value": 60
      }
     }
    },
    {
     "from": "idle",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "down",
      "id": "w",
      "x": 150,
      "y": 40
     },
     "expect": {
      "state": "dragging",
      "entity": {
       "value": 20
      }
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "move",
      "id": "w",
      "x": 233,
      "y": 40
     },
     "expect": {
      "entity": {
       "value": 70
      }
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "move",
      "id": "w",
      "x": 900,
      "y": 40
     },
     "expect": {
      "entity": {
       "value": 100
      }
     }
    },
    {
     "from": "dragging",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "up",
      "id": "w",
      "x": 900,
      "y": 40
     },
     "expect": {
      "emits": [
       {
        "event": "RASM_RANGE_CHANGED",
        "payload": {
         "value": 100
        }
       }
      ]
     }
    }
   ]
  },
