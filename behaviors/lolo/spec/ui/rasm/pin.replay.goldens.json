{
  "atom": "../ui/rasm/atoms/std-rasm-pin.lolo",
  "trait": "RasmPin",
  "cases": [
    {
      "id": "ltr-pins-the-child-to-the-right-edge",
      "config": {
        "anchor": "page",
        "child": "bar",
        "width": 300,
        "height": 48,
        "margin": 12
      },
      "entity": {
        "id": "p"
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "page",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 1280,
                  "h": 800
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emits": [
              {
                "event": "RASM_PLACE",
                "payload": {
                  "placed": [
                    {
                      "id": "bar",
                      "rect": {
                        "x": 968,
                        "y": 12,
                        "w": 300,
                        "h": 48
                      },
                      "origin": ""
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    },
