    {
      "id": "the-view-sized-and-the-stage-placed-it-paints",
      "config": {
        "id": "ap",
        "url": "https://x/p.jpg",
        "mask": "M 0 0 L 100 0 L 100 100 Z",
        "boxWidth": 100,
        "boxHeight": 100,
        "anchor": "scene"
      },
      "entity": {
        "id": "x",
        "viewH": 800
      },
      "steps": [
        {
          "from": "ready",
          "event": "RASM_PLACE",
          "payload": {
            "placed": [
              {
                "id": "ap",
                "rect": {
                  "x": 0,
                  "y": 0,
                  "w": 1000,
                  "h": 800
                }
              }
            ]
          },
          "expect": {
            "state": "ready",
            "emitCounts": {
              "RASM_PAINT": 1
            }
          }
