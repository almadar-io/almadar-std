{
 "atom": "../ui/rasm/atoms/std-rasm-machine.lolo",
 "trait": "RasmMachine",
 "cases": [
  {
   "id": "fit-both-shrinks-the-layout-to-the-placed-height-too",
   "config": {
    "fit": "both"
   },
   "entity": {
    "id": "m"
   },
   "steps": [
    {
     "from": "showing",
     "event": "MACHINE_PAINT",
     "payload": {
      "n": 1
     },
     "entity": {
      "id": "m",
      "rect": {
       "x": 0,
       "y": 0,
       "w": 400,
       "h": 100
      },
      "layoutW": 200,
      "layoutH": 400,
      "extentH": 0
     },
     "expect": {
      "state": "showing",
      "emits": [
       {
        "event": "RASM_EXTENT",
        "payload": {
         "n": 1,
         "id": "machine",
         "w": 400,
         "h": 100
        }
       },
       {
        "event": "MACHINE_DRAW",
        "payload": {
         "s": 0.25,
         "ox": 175,
         "oy": 0,
         "rtl": false
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-fit-width-keeps-the-width-scale-and-reports-the-height-it-needs",
   "config": {},
   "entity": {
    "id": "m"
   },
   "steps": [
    {
     "from": "showing",
     "event": "MACHINE_PAINT",
     "payload": {
      "n": 1
     },
     "entity": {
      "id": "m",
      "rect": {
       "x": 0,
       "y": 0,
       "w": 400,
       "h": 100
      },
      "layoutW": 200,
      "layoutH": 400,
      "extentH": 0
     },
     "expect": {
      "state": "showing",
      "emits": [
       {
        "event": "RASM_EXTENT",
        "payload": {
         "n": 1,
         "id": "machine",
         "w": 400,
         "h": 500
        }
       },
       {
        "event": "MACHINE_DRAW",
        "payload": {
         "s": 1.25,
         "ox": 75,
         "oy": 0,
         "rtl": false
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
