  {
   "id": "open-places-a-centered-dialog-and-its-content-inset-by-the-padding",
   "config": {
    "id": "dlg",
    "placement": "center",
    "width": 300,
    "height": 200,
    "padding": 10,
    "content": "body",
    "contents": [
     "body",
     "ok"
    ],
    "z": 100,
    "label": "Confirm"
   },
   "entity": {
    "id": "dlg"
   },
   "steps": [
    {
     "from": "closed",
     "event": "INIT",
     "payload": {},
     "expect": {
      "state": "closed",
      "emits": [
       {
        "event": "RASM_VISIBLE",
        "payload": {
         "owner": "dlg",
         "shown": [],
         "hidden": [
          "body",
          "ok"
         ]
        }
       }
      ]
     }
    },
    {
     "from": "closed",
     "event": "RASM_OVERLAY_OPEN",
     "payload": {
      "id": "dlg"
     },
     "expect": {
      "state": "open",
      "emits": [
       {
        "event": "RASM_VISIBLE",
        "payload": {
         "owner": "dlg",
         "shown": [
          "body",
          "ok"
         ],
         "hidden": []
        }
       },
       {
        "event": "RASM_PLACE",
        "payload": {
         "placed": [
          {
           "id": "body",
           "rect": {
            "x": 220,
            "y": 170,
            "w": 280,
            "h": 180
           }
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
