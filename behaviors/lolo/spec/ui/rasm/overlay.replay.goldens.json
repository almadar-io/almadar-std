       },
       {
        "event": "RASM_VISIBLE",
        "payload": {
         "owner": "dlg",
         "shown": [],
         "hidden": [
          "body",
          "ok"
         ]
        }
       },
       {
        "event": "RASM_OVERLAY_DISMISSED",
        "payload": {
         "id": "dlg",
         "reason": "scrim"
        }
       }
      ]
     }
    }
   ]
