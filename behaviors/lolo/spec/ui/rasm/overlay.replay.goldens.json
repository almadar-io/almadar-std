   "entity": {
    "id": "dlg"
   },
   "steps": [
    {
     "from": "open",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "up",
      "id": "dlg:scrim",
      "x": 5,
      "y": 5
     },
     "expect": {
      "state": "closed",
      "emits": [
       {
        "event": "RASM_PAINT",
        "payload": {
         "id": "dlg",
         "z": 100,
         "nodes": []
