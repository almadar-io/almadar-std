   "id": "a-press-released-over-the-button-emits-its-action",
   "config": {
    "id": "b",
    "label": "Go",
    "intent": "primary",
    "action": "GO",
    "z": 3
   },
   "entity": {
    "id": "b"
   },
   "steps": [
    {
     "from": "idle",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "enter",
      "id": "b",
      "x": 10,
      "y": 10
     },
     "expect": {
      "state": "hovered"
     }
    },
    {
     "from": "hovered",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "down",
      "id": "b",
      "x": 10,
      "y": 10
     },
     "expect": {
      "state": "pressed"
     }
    },
    {
     "from": "pressed",
     "event": "RASM_POINTER",
     "payload": {
      "kind": "up",
      "id": "b",
      "x": 10,
      "y": 10
     },
     "expect": {
      "state": "hovered",
      "emits": [
       {
        "event": "GO",
        "payload": {}
       }
      ]
     }
    }
   ]
  },
