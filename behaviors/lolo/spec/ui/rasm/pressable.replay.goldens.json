  {
   "id": "focus-then-keyboard-activation-emits-the-action",
   "config": {
    "id": "b",
    "label": "Go",
    "intent": "primary",
    "action": "GO",
    "z": 3
   },
   "entity": {
    "id": "b"
   },
   "steps": [
    {
     "from": "idle",
     "event": "RASM_FOCUS",
     "payload": {
      "id": "b"
     },
     "expect": {
      "state": "focused"
     }
    },
    {
     "from": "focused",
     "event": "RASM_ACTIVATE",
     "payload": {
      "id": "b"
     },
     "expect": {
      "state": "focused",
      "emits": [
       {
        "event": "GO",
        "payload": {}
       }
      ]
     }
    },
    {
     "from": "focused",
     "event": "RASM_FOCUS",
     "payload": {
      "id": "next"
     },
     "expect": {
      "state": "idle"
     }
    }
   ]
  },
