{
 "atom": "../ui/rasm/atoms/std-rasm-surface.lolo",
 "trait": "RasmSurface",
 "cases": [
  {
   "id": "a-paint-listed-in-a-target-leaves-the-frame-and-paints-in-the-target-group",
   "config": {
    "targets": [
     {
      "id": "blur",
      "fragments": [
       "a"
      ]
     }
    ]
   },
   "entity": {
    "id": "s"
   },
   "steps": [
    {
     "from": "ready",
     "event": "RASM_PAINT",
     "payload": {
      "id": "a",
      "z": 1,
      "nodes": [
       {
        "type": "draw-shape",
        "shape": "rect",
        "id": "a",
        "position": {
         "x": 0,
         "y": 0
        },
        "width": 10,
        "height": 10
       }
      ]
     },
     "expect": {
      "state": "dirty",
      "neverEmits": [
       "SURFACE_REPAINT"
      ]
     }
    },
    {
     "from": "dirty",
     "event": "RASM_PAINT",
     "payload": {
      "id": "b",
      "z": 2,
      "nodes": [
       {
        "type": "draw-shape",
        "shape": "rect",
        "id": "b",
        "position": {
         "x": 0,
         "y": 0
        },
        "width": 10,
        "height": 10
       }
      ]
     },
     "expect": {
      "state": "dirty",
      "neverEmits": [
       "SURFACE_REPAINT"
      ]
     }
    },
    {
     "from": "dirty",
     "event": "SURFACE_REPAINT",
     "payload": {
      "n": 3
     },
     "expect": {
      "state": "ready",
      "rendered": [
       {
        "slot": "main",
        "props": {
         "drawables.0.type": "draw-group",
         "drawables.0.target.id": "blur",
         "drawables.0.target.width": 720,
         "drawables.0.target.height": 520,
         "drawables.0.items.0.id": "a",
         "drawables.0.items.1": null,
         "drawables.1.id": "b",
         "drawables.2": null
        }
       }
      ]
     },
     "options": {
      "render": true,
      "renderProps": true
     },
     "entity": {
      "id": "s",
      "paints": {
       "a": {
        "id": "a",
        "z": 1,
        "nodes": [
         {
          "type": "draw-shape",
          "shape": "rect",
          "id": "a",
          "position": {
           "x": 0,
           "y": 0
          },
          "width": 10,
          "height": 10
         }
        ],
        "texts": []
       },
       "b": {
        "id": "b",
        "z": 2,
        "nodes": [
         {
          "type": "draw-shape",
          "shape": "rect",
          "id": "b",
          "position": {
           "x": 0,
           "y": 0
          },
          "width": 10,
          "height": 10
         }
        ],
        "texts": []
       }
      }
     }
    }
   ]
