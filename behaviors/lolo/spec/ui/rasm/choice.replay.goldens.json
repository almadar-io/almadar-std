{
 "atom": "../ui/rasm/atoms/std-rasm-choice.lolo",
 "trait": "RasmChoice",
 "cases": [
  {
   "id": "enter-on-the-focused-choice-opens-it-and-arrows-then-enter-pick",
   "config": {
    "id": "season",
    "options": [
     "Spring",
     "Summer",
     "Autumn"
    ],
    "value": "Spring"
   },
   "entity": {
    "id": "c",
    "selected": 0,
    "active": 0,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 200,
     "h": 40
    }
   },
   "steps": [
    {
     "from": "focused",
     "event": "RASM_KEYPRESS",
     "payload": {
      "target": "season",
      "key": "Enter",
      "shift": false,
      "alt": false,
      "ctrl": false,
      "meta": false
     },
     "expect": {
      "state": "open",
      "emits": [
       {
        "event": "RASM_ANCHOR",
        "payload": {
         "id": "season:popup",
         "anchor": "season",
         "side": "below"
        }
       }
      ]
     }
    },
    {
     "from": "open",
     "event": "RASM_KEYPRESS",
     "payload": {
      "target": "season",
      "key": "ArrowDown",
      "shift": false,
      "alt": false,
      "ctrl": false,
      "meta": false
     },
     "expect": {
      "state": "open"
     }
    },
    {
     "from": "open",
     "event": "RASM_KEYPRESS",
     "payload": {
      "target": "season",
      "key": "Enter",
      "shift": false,
      "alt": false,
      "ctrl": false,
      "meta": false
     },
     "expect": {
      "state": "focused",
      "emits": [
       {
        "event": "RASM_CHOICE_CHANGED",
        "payload": {
         "value": "Summer"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "arrow-down-on-the-focused-choice-opens-it",
   "config": {
    "id": "season",
    "options": [
     "Spring",
     "Summer",
     "Autumn"
    ],
    "value": "Spring"
   },
   "entity": {
    "id": "c",
    "selected": 0,
    "active": 0,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 200,
     "h": 40
    }
   },
   "steps": [
    {
     "from": "focused",
     "event": "RASM_KEYPRESS",
     "payload": {
      "target": "season",
      "key": "ArrowDown",
      "shift": false,
      "alt": false,
      "ctrl": false,
      "meta": false
     },
     "expect": {
      "state": "open",
      "emits": [
       {
        "event": "RASM_ANCHOR",
        "payload": {
         "id": "season:popup",
         "anchor": "season",
         "side": "below"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-key-for-another-target-leaves-the-choice-closed",
   "config": {
    "id": "season",
    "options": [
     "Spring",
     "Summer",
     "Autumn"
    ],
    "value": "Spring"
   },
   "entity": {
    "id": "c",
    "selected": 0,
    "active": 0,
    "rect": {
     "x": 0,
     "y": 0,
     "w": 200,
     "h": 40
    }
   },
   "steps": [
    {
     "from": "focused",
     "event": "RASM_KEYPRESS",
     "payload": {
      "target": "name",
      "key": "Enter",
      "shift": false,
      "alt": false,
      "ctrl": false,
      "meta": false
     },
     "expect": {
      "state": "focused"
     }
    },
    {
     "from": "focused",
     "event": "RASM_KEYPRESS",
     "payload": {
      "target": "season",
      "key": "Tab",
      "shift": false,
      "alt": false,
      "ctrl": false,
      "meta": false
     },
     "expect": {
      "state": "focused"
     }
    }
   ]
  }
 ]
}