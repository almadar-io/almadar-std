          "from": "ready",
          "event": "SETTLE_EXTENT",
          "payload": {
            "id": "a",
            "w": 1000,
            "h": 320
          },
          "expect": {
            "state": "waiting",
            "emitCounts": {
              "RASM_MEASURED": 0
            }
          }
        }
      ]
    }
  ]
}
