  {
   "id": "a-multi-touch-pointer-event-also-relays-the-touches-and-a-single-pointer-does-not",
   "config": {},
   "entity": {
    "id": "s"
   },
   "steps": [
    {
     "from": "ready",
     "event": "POINTER_DOWN",
     "payload": {
      "target": "c",
      "x": 10,
      "y": 20,
      "touches": [
       {
        "pointerId": 0,
        "x": 10,
        "y": 20
       },
       {
        "pointerId": 1,
        "x": 50,
        "y": 60
       }
      ]
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_POINTER",
        "payload": {
         "kind": "down",
         "id": "c",
         "x": 10,
         "y": 20,
         "index": -1
        }
       },
       {
        "event": "RASM_TOUCHES",
        "payload": {
         "kind": "down",
         "touches": [
          {
           "pointerId": 0,
           "x": 10,
           "y": 20
          },
          {
           "pointerId": 1,
           "x": 50,
           "y": 60
          }
         ]
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "POINTER_MOVE",
     "payload": {
      "target": "c",
      "x": 50,
      "y": 60,
      "touches": [
       {
        "pointerId": 0,
        "x": 10,
        "y": 20
       },
       {
        "pointerId": 1,
        "x": 50,
        "y": 60
       }
      ]
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_POINTER",
        "payload": {
         "kind": "move",
         "id": "c",
         "x": 50,
         "y": 60
        }
       },
       {
        "event": "RASM_TOUCHES",
        "payload": {
         "kind": "move",
         "touches": [
          {
           "pointerId": 0,
           "x": 10,
           "y": 20
          },
          {
           "pointerId": 1,
           "x": 50,
           "y": 60
          }
         ]
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "POINTER_UP",
     "payload": {
      "target": "c",
      "x": 10,
      "y": 20,
      "touches": [
       {
        "pointerId": 0,
        "x": 10,
        "y": 20
       },
       {
        "pointerId": 1,
        "x": 50,
        "y": 60
       }
      ]
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_POINTER",
        "payload": {
         "kind": "up",
         "id": "c",
         "x": 10,
         "y": 20
        }
       },
       {
        "event": "RASM_TOUCHES",
        "payload": {
         "kind": "up",
         "touches": [
          {
           "pointerId": 0,
           "x": 10,
           "y": 20
          },
          {
           "pointerId": 1,
           "x": 50,
           "y": 60
          }
         ]
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "POINTER_MOVE",
     "payload": {
      "target": "c",
      "x": 5,
      "y": 5
     },
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_POINTER",
        "payload": {
         "kind": "move",
         "id": "c",
         "x": 5,
         "y": 5
        }
       }
      ]
     }
    }
   ]
  },
