  {
   "id": "the-key-map-carries-escape-page-keys-home-and-end",
   "config": {},
   "entity": {
    "id": "s"
   },
   "steps": [
    {
     "from": "ready",
     "event": "SURFACE_REPAINT",
     "payload": {
      "n": 1
     },
     "expect": {
      "state": "ready",
      "rendered": [
       {
        "slot": "main",
        "props": {
         "keyMap.Escape": "KEY_ESCAPE",
         "keyMap.PageUp": "KEY_PAGE_UP",
         "keyMap.PageDown": "KEY_PAGE_DOWN",
         "keyMap.Home": "KEY_HOME",
         "keyMap.End": "KEY_END"
        }
       }
      ]
     },
     "options": {
      "render": true,
      "renderProps": true
     }
    },
    {
     "from": "ready",
     "event": "KEY_ESCAPE",
     "payload": {},
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_KEY",
        "payload": {
         "key": "escape"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "KEY_PAGE_UP",
     "payload": {},
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_KEY",
        "payload": {
         "key": "pageUp"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "KEY_PAGE_DOWN",
     "payload": {},
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_KEY",
        "payload": {
         "key": "pageDown"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "KEY_HOME",
     "payload": {},
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_KEY",
        "payload": {
         "key": "home"
        }
       }
      ]
     }
    },
    {
     "from": "ready",
     "event": "KEY_END",
     "payload": {},
     "expect": {
      "state": "ready",
      "emits": [
       {
        "event": "RASM_KEY",
        "payload": {
         "key": "end"
        }
       }
      ]
     }
    }
   ]
