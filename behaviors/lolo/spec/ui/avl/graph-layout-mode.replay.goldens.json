{
  "atom": "../ui/avl/atoms/std-graph-layout.lolo",
  "trait": "GraphLayout",
  "cases": [
    {
      "id": "a-mode-with-a-direction-of-its-own-lays-the-next-request-out-in-it",
      "config": {
        "direction": "right",
        "directionIn": {
          "phone": "down"
        }
      },
      "entity": {
        "id": "l"
      },
      "steps": [
        {
          "from": "ready",
          "event": "LAYOUT_MODE",
          "payload": {
            "name": "phone"
          },
          "expect": {
            "state": "ready",
            "entity": {
              "mode": "phone"
            },
            "neverEmits": [
              "LAYOUT_READY",
              "LAYOUT_ORDER"
            ]
          }
        },
        {
          "from": "ready",
          "event": "LAYOUT_REQUEST",
          "payload": {
            "nodes": [
              {
                "id": "a",
                "label": "a",
                "width": 70,
                "height": 40
              },
              {
                "id": "b",
                "label": "b",
                "width": 60,
                "height": 40
              }
            ],
            "edges": [
              {
                "id": "a>b",
                "source": "a",
                "target": "b",
                "label": "a>b",
                "labelWidth": 50,
                "labelHeight": 20
              }
            ]
          },
          "expect": {
            "state": "ready",
            "entity": {
              "nodes": [
                {
                  "id": "a",
                  "label": "a",
                  "width": 70,
                  "height": 40
                },
                {
                  "id": "b",
                  "label": "b",
                  "width": 60,
                  "height": 40
                }
              ]
            }
          }
        }
      ]
    },
    {
      "id": "control-a-mode-with-no-direction-of-its-own-keeps-the-configured-direction",
