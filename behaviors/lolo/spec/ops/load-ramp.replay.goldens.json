            "thinkMs": 0,
            "journey": [
              {
                "label": "p",
                "method": "POST",
                "path": "/x/{client}",
                "body": "{\"c\":\"{client}\"}"
              }
            ],
            "prefix": "",
            "stream": false,
            "identities": []
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "LOAD_FAILED",
                "payload": {
                  "key": "r"
