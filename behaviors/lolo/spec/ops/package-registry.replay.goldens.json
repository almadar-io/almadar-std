{
 "atom": "ops/atoms/std-package-registry.lolo",
 "trait": "PackageRegistry",
 "source": "python3 hashlib.sha256",
 "note": "Only the publish integrity path is pinned here. Digests are fed as steps, so these cases do not depend on hash/sha accepting bytes (lane HB1). The publish reads the package/package.json entry through tar/entries over the gunzipped tarball (ustar vectors built with python3 tarfile and gzip; the corrupt vector has its header checksum zeroed); a gzip or tar that fails records an empty range.",
 "cases": [
  {
   "id": "new-version-is-hashed-stored-and-published",
   "steps": [
    {
     "event": "REGISTRY_MISSING",
     "payload": {
      "error": "x",
      "code": "not-found"
     },
     "from": "serving",
     "entity": {
      "id": "r",
      "busy": true,
      "queue": [],
      "tarball": "YWJj",
      "current": {
       "requestId": 7,
       "op": "publish",
       "name": "pkg-a",
       "version": "1.0.0",
       "integrity": ""
      }
     },
     "expect": {
      "emits": [
       {
        "event": "REG_HASH",
        "payload": {
         "requestId": "7",
         "data": "YWJj",
         "encoding": "hex"
        }
       },
       {
        "event": "PACKAGE_PUBLISHED",
        "payload": {
         "requestId": 7,
         "name": "pkg-a",
         "version": "1.0.0"
        }
       }
      ],
      "neverEmits": [
       "PACKAGE_REFUSED"
      ]
     }
    }
   ]
  },
