{
  "atom": "ops/atoms/std-ci-status.lolo",
  "trait": "CiStatus",
  "note": "Complete the actual composed GitHub client and observe its routed board result, rather than injecting CI_GQL_ANSWERED or CI_GQL_FAILED directly. CiStatus is a client trait on a route page, so a server-role step does not deliver the composed traits' emits to it (EXEC-DIST-1, EXEC-DIST-4): each hop into CiStatus is its own step, fed with exactly the payload the previous step emitted.",
  "cases": [
    {
      "id": "malformed-github-success-makes-the-board-stale",
      "defaults": [
        "CiRetry"
      ],
      "steps": [
        {
          "event": "CI_STATUS_LOAD",
          "payload": {}
        },
        {
          "event": "CI_ATTEMPT",
          "payload": {
            "key": "ci-status:2",
            "attempt": 1
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "CI_GQL"
              }
            ],
            "neverEmits": [
              "GITHUB_GRAPHQL_ANSWERED",
              "GITHUB_GRAPHQL_FAILED"
            ]
          }
        },
        {
          "trait": "CiGithub",
          "event": "GITHUB_GRAPHQL_REPLIED",
          "payload": {
            "status": 200,
            "body": "<html>upstream unavailable</html>"
          },
          "expect": {
            "emits": [
              {
                "event": "GITHUB_GRAPHQL_FAILED",
                "payload": {
                  "status": 200,
                  "code": "PARSE_ERROR"
                }
              }
            ],
            "neverEmits": [
              "GITHUB_GRAPHQL_ANSWERED"
            ]
          }
        },
        {
          "event": "CI_GQL_FAILED",
          "payload": {
            "status": 200,
            "code": "PARSE_ERROR",
            "message": "GitHub answered a GraphQL body that is not JSON"
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "CI_STATUS",
                "payload": {
                  "runs": [],
                  "stale": true
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "valid-empty-github-success-makes-the-board-fresh",
      "defaults": [
        "CiRetry"
      ],
      "steps": [
        {
          "event": "CI_STATUS_LOAD",
          "payload": {}
        },
        {
          "event": "CI_ATTEMPT",
          "payload": {
            "key": "ci-status:2",
            "attempt": 1
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "CI_GQL"
              }
            ],
            "neverEmits": [
              "GITHUB_GRAPHQL_ANSWERED",
              "GITHUB_GRAPHQL_FAILED"
            ]
          }
        },
        {
          "trait": "CiGithub",
          "event": "GITHUB_GRAPHQL_REPLIED",
          "payload": {
            "status": 200,
            "body": "{\"data\":{\"organization\":{\"repositories\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":\"\"}}}}}"
          },
          "expect": {
            "emits": [
              {
                "event": "GITHUB_GRAPHQL_ANSWERED",
                "payload": {
                  "body": "{\"data\":{\"organization\":{\"repositories\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":\"\"}}}}}"
                }
              }
            ],
            "neverEmits": [
              "GITHUB_GRAPHQL_FAILED"
            ]
          }
        },
        {
          "event": "CI_GQL_ANSWERED",
          "payload": {
            "body": "{\"data\":{\"organization\":{\"repositories\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":\"\"}}}}}"
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "CI_STATUS",
                "payload": {
                  "runs": [],
                  "stale": false
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
