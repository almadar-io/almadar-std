  {
   "id": "load-lists-running-gpu-instances",
   "config": {
    "region": "us-east-1",
    "instanceTypes": [
     "g4dn.*",
     "g5.*",
     "p3.*",
     "p4d.*"
    ]
   },
   "steps": [
    {
     "event": "TRAINING_LOAD",
     "payload": {},
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "TR_AWS",
        "payload": {
         "stage": "list",
         "argv": [
          "ec2",
          "describe-instances",
          "--region",
          "us-east-1",
          "--filters",
          "Name=instance-state-name,Values=running",
          "Name=instance-type,Values=g4dn.*,g5.*,p3.*,p4d.*",
          "--query",
          "Reservations[].Instances[].{Id:InstanceId,Type:InstanceType,IP:PublicIpAddress,Launch:LaunchTime}",
          "--output",
          "json"
         ]
        }
       }
      ]
     }
    }
   ]
  },
