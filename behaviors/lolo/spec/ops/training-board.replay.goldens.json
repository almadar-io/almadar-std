    "region": "us-east-1",
    "instanceTypes": [
     "g4dn.*",
     "g5.*",
     "p3.*",
     "p4d.*"
    ]
   },
   "steps": [
    {
     "event": "TRAINING_LOAD",
     "payload": {}
    },
    {
     "event": "TR_RAN",
     "payload": {
      "stage": "list",
      "exitCode": 0,
      "signal": 0,
      "stdout": "[{\"Id\":\"i-1\",\"Type\":\"g5.xlarge\",\"IP\":\"3.4.5.6\",\"Launch\":\"2026-10-15T00:00:00Z\"}]",
      "stderr": "",
      "stdoutBytes": ""
     },
     "from": "reading",
     "expect": {
      "emits": [
       {
        "event": "TR_NEXT",
        "payload": {}
       }
      ]
     }
    }
   ]
  },
  {
   "id": "aws-not-installed-shows-a-named-error-and-stops",
   "steps": [
    {
     "event": "TRAINING_LOAD",
     "payload": {}
    },
    {
     "event": "TR_CLI_FAILED",
     "payload": {
      "stage": "list",
      "error": "No such file or directory (os error 2)",
      "code": "cli_spawn_failed"
     },
     "from": "reading",
     "expect": {
      "fired": true,
      "state": "idle",
      "effects": [
       {
        "type": "set"
       },
       {
        "type": "render-ui"
       }
      ],
      "neverEmits": [
       "TR_NEXT"
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
