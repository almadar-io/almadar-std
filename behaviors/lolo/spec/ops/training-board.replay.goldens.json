   "id": "aws-not-installed-shows-a-named-error-and-stops",
   "steps": [
    {
     "event": "TRAINING_LOAD",
     "payload": {}
    },
    {
     "event": "TR_CLI_FAILED",
     "payload": {
      "stage": "list",
      "error": "No such file or directory (os error 2)",
      "code": "cli_spawn_failed"
     },
     "from": "reading",
     "expect": {
      "fired": true,
      "state": "idle",
      "effects": [
       {
        "type": "set"
       },
       {
        "type": "emit"
       }
      ],
      "neverEmits": [
       "TR_NEXT"
      ],
      "emits": [
       {
        "event": "TR_BOARD_FAILED",
        "payload": {
         "error": "aws is not installed or could not run: No such file or directory (os error 2)"
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678,
   "defaults": [
    "TrAws"
   ]
  },
