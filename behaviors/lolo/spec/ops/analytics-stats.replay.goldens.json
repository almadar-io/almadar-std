    {
      "id": "a-read-over-the-cap-is-refused",
      "note": "a partial read would count wrong totals",
      "steps": [
        {
          "trait": "AnalyticsStatsRead",
          "from": "ready",
          "event": "AS_LOADED",
          "entity": {
            "id": "r",
            "phase": "idle",
            "windowDays": 30,
            "from": 0,
            "to": 0,
            "domain": "",
            "sites": [],
            "events": 0,
