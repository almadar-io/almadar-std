            "readFrom": 0,
            "readTo": 0,
            "readStart": 200,
            "readDomain": ""
          },
          "payload": {
            "data": [
              {
                "id": "p1",
                "ts": 100,
                "name": "pageview",
                "domain": "almadar.io",
                "path": "/",
                "visitorId": "v1"
              }
            ],
            "totalCount": 4
          },
          "expect": {
