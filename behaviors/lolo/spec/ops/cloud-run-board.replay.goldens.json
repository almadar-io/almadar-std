 "cases": [
  {
   "id": "load-ensures-the-google-token-before-the-monitoring-read",
   "now": 1792067445678,
   "steps": [
    {
     "event": "CLOUD_RUN_LOAD",
     "payload": {},
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "CR_TOKEN_ENSURE",
        "payload": {}
       }
      ],
      "neverEmits": [
       "CR_MONITOR",
       "CR_HTTP_SEND"
      ]
     }
    }
   ],
   "defaults": [
    "CloudRunStatus",
    "CrToken"
   ]
  },
  {
   "id": "a-held-token-starts-the-monitoring-read",
   "now": 1792067445678,
   "steps": [
    {
     "event": "CR_TOKEN_READY",
     "payload": {},
     "from": "reading",
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "CR_MONITOR",
        "payload": {}
       },
       {
        "event": "CR_HTTP_SEND",
        "payload": {
         "key": "time",
         "method": "GET"
        }
       }
      ],
      "emitCounts": {
       "CR_COST": 0,
       "CR_GCLOUD": 0
      }
     }
    }
   ],
   "note": "G-STD-381: the token only starts the monitoring read; the cost and services reads follow its replies, never beside it."
  },
  {
   "id": "a-token-that-cannot-be-made-skips-monitoring-and-goes-on-to-cost",
   "now": 1792067445678,
   "steps": [
    {
     "event": "CLOUD_RUN_LOAD",
     "payload": {}
    },
    {
     "event": "CR_TOKEN_MISSING",
     "payload": {
      "message": "Google access not configured: credential `GCLOUD_ADC_REFRESH_TOKEN` (the refresh token) is not stored"
     },
     "from": "reading",
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "CR_COST",
        "payload": {}
       },
       {
        "event": "CR_GCLOUD",
        "payload": {
         "stage": "services"
        }
       }
      ],
      "neverEmits": [
       "CR_HTTP_SEND"
      ]
     }
    }
   ],
   "defaults": [
    "CloudRunStatus",
    "CrToken"
   ]
  },
