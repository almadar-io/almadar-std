{
 "atom": "ops/atoms/std-ci-run-logs.lolo",
 "trait": "CiRunLogs",
 "cases": [
  {
   "id": "failed-jobs-first-log-read-then-next",
   "steps": [
    {
     "event": "CI_LOGS_LOAD",
     "payload": {
      "owner": "almadar-io",
      "repo": "almadar-core",
      "runId": "777"
     },
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_GH",
        "payload": {
         "stage": "jobs",
         "argv": [
          "api",
          "repos/almadar-io/almadar-core/actions/runs/777/jobs"
         ]
        }
       }
      ]
     }
    },
    {
     "event": "CI_LOGS_RAN",
     "payload": {
      "stage": "jobs",
      "exitCode": 0,
      "signal": 0,
      "stdout": "{\"total_count\": 4, \"jobs\": [{\"id\": 1, \"name\": \"build\", \"status\": \"completed\", \"conclusion\": \"failure\"}, {\"id\": 2, \"name\": \"lint\", \"status\": \"completed\", \"conclusion\": \"success\"}, {\"id\": 3, \"name\": \"test\", \"status\": \"completed\", \"conclusion\": \"failure\"}, {\"id\": 4, \"name\": \"e2e\", \"status\": \"completed\", \"conclusion\": \"failure\"}]}",
      "stderr": "",
      "stdoutBytes": ""
     },
     "from": "reading",
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_GH",
        "payload": {
         "stage": "log",
         "argv": [
          "api",
          "repos/almadar-io/almadar-core/actions/jobs/1/logs"
         ]
        }
       }
      ]
     }
    },
    {
     "event": "CI_LOGS_RAN",
     "payload": {
      "stage": "log",
      "exitCode": 0,
      "signal": 0,
      "stdout": "2026-10-19T10:00:00.1234567Z ##[group]Run pnpm test\n2026-10-19T10:00:01.0000000Z   npm warn deprecated\n\n2026-10-19T10:00:02.5Z ##[error]Process completed with exit code 1.\n2026-10-19T10:00:03Z ##[warning]Node 18 is deprecated\n2026-10-19T10:00:04.000Z [ERROR] Tests failed: 3\n2026-10-19T10:00:05.000Z see ##[error] in the middle\n   \nno timestamp line\n2026-10-19T10:00:06.000Z \n",
      "stderr": "",
      "stdoutBytes": ""
     },
     "from": "reading",
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_NEXT",
        "payload": {}
       }
      ]
     }
    }
   ]
  },
  {
   "id": "no-failed-job-run-summary-lines",
   "steps": [
    {
     "event": "CI_LOGS_LOAD",
     "payload": {
      "owner": "almadar-io",
      "repo": "almadar-core",
      "runId": "777"
     },
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_GH",
        "payload": {
         "stage": "jobs",
         "argv": [
          "api",
          "repos/almadar-io/almadar-core/actions/runs/777/jobs"
         ]
        }
       }
      ]
     }
    },
    {
     "event": "CI_LOGS_RAN",
     "payload": {
      "stage": "jobs",
      "exitCode": 0,
      "signal": 0,
      "stdout": "{\"total_count\": 2, \"jobs\": [{\"id\": 1, \"name\": \"build\", \"status\": \"completed\", \"conclusion\": \"success\"}, {\"id\": 2, \"name\": \"deploy\", \"status\": \"completed\", \"conclusion\": \"cancelled\"}]}",
      "stderr": "",
      "stdoutBytes": ""
     },
     "from": "reading",
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_GH",
        "payload": {
         "stage": "view",
         "argv": [
          "run",
          "view",
          "777",
          "--repo",
          "almadar-io/almadar-core"
         ]
        }
       }
      ]
     }
    },
    {
     "event": "CI_LOGS_RAN",
     "payload": {
      "stage": "view",
      "exitCode": 0,
      "signal": 0,
      "stdout": "X main CI · 777\nTriggered via push about 1 hour ago\n\nJOBS\nX build in 2m (ID 1)\n  failed step: error in setup\n",
      "stderr": "",
      "stdoutBytes": ""
     },
     "from": "reading",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "CI_LOGS",
        "payload": {
         "repo": "almadar-core",
         "runId": "777",
         "lines": [
          {
           "job": "",
           "step": "",
           "msg": "X main CI · 777",
           "level": "info"
          },
          {
           "job": "",
           "step": "",
           "msg": "Triggered via push about 1 hour ago",
           "level": "info"
          },
          {
           "job": "",
           "step": "",
           "msg": "JOBS",
           "level": "info"
          },
          {
           "job": "",
           "step": "",
           "msg": "X build in 2m (ID 1)",
           "level": "info"
          },
          {
           "job": "",
           "step": "",
           "msg": "failed step: error in setup",
           "level": "info"
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
