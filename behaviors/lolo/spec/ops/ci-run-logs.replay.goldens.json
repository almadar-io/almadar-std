     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_GH",
        "payload": {
         "stage": "jobs",
         "argv": [
          "api",
          "repos/almadar-io/almadar-core/actions/runs/777/jobs"
         ]
        }
       }
      ]
     }
    },
    {
     "event": "CLI_EXITED",
     "payload": {
      "code": 0,
      "signal": 0,
      "key": "wait"
     },
     "from": "running",
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_GH",
        "payload": {
         "stage": "log",
         "argv": [
          "api",
          "repos/almadar-io/almadar-core/actions/jobs/1/logs"
         ]
        }
       }
      ],
      "neverEmits": [
       "CLI_FAILED"
      ]
     },
     "trait": "CiLogsGh",
     "entity": {
      "stage": "jobs",
      "out": "",
      "err": ""
     }
    },
    {
     "event": "CLI_EXITED",
     "payload": {
      "code": 0,
      "signal": 0,
      "key": "wait"
     },
     "from": "running",
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_NEXT",
        "payload": {}
       }
      ],
      "neverEmits": [
       "CLI_FAILED"
      ]
     },
     "trait": "CiLogsGh",
     "entity": {
      "stage": "log",
      "out": "",
      "err": ""
     }
    }
   ],
   "note": "Complete the composed CLI runner with captured bytes so its next request starts idle; assert no CLI_FAILED cascade."
