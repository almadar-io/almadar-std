  {
   "id": "busy-read-refused",
   "steps": [
    {
     "event": "CI_LOGS_LOAD",
     "payload": {
      "owner": "almadar-io",
      "repo": "almadar-core",
      "runId": "777"
     }
    },
    {
     "event": "CI_LOGS_LOAD",
     "payload": {
      "owner": "almadar-io",
      "repo": "almadar-core",
      "runId": "777"
     },
     "from": "reading",
     "expect": {
      "emits": [
       {
        "event": "CI_LOGS_FAILED",
        "payload": {
         "runId": "777",
         "error": "the log of run 777 is being read",
         "code": "ci_logs_busy"
        }
       }
      ]
     }
    }
