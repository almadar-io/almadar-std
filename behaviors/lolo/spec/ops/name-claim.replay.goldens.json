    {
     "event": "LOCK_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "x"
     }
    },
    {
     "event": "NAME_NOT_WRITTEN",
     "payload": {
      "code": "duplicate-id",
      "error": "dup"
     },
     "expect": {
      "emits": [
       {
        "event": "NAME_CLAIM_FAILED",
        "payload": {
         "code": "taken",
         "value": "acme"
        }
       }
      ],
      "neverEmits": [
       "NAME_CLAIMED"
      ]
     }
    }
   ]
  },
  {
   "id": "reclaiming-own-name-is-fine",
   "steps": [
    {
     "event": "CLAIM_NAME",
     "payload": {
      "name": "kept-one",
      "holder": "user:u1"
     }
