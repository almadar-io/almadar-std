    {
     "event": "LOCK_LOADED",
     "payload": {
      "data": {
       "id": "kept-one",
       "holder": "user:u1"
      }
     },
     "expect": {
      "emits": [
       {
        "event": "NAME_CLAIMED",
        "payload": {
         "name": "kept-one",
         "holder": "user:u1"
        }
       }
      ],
      "neverEmits": [
       "NAME_CLAIM_FAILED"
      ]
     }
    }
   ]
  },
