    {
     "event": "LOCK_LOADED",
     "payload": {
      "data": {
       "id": "acme",
       "holder": "team:t1"
      }
     },
     "expect": {
      "emits": [
       {
        "event": "NAME_CLAIM_FAILED",
        "payload": {
         "code": "taken",
         "value": "acme"
        }
       }
      ],
      "neverEmits": [
       "NAME_CLAIMED"
      ]
     }
    }
   ]
  },
  {
   "id": "lost-write-race-is-taken",
   "steps": [
    {
     "event": "CLAIM_NAME",
     "payload": {
      "name": "acme",
      "holder": "user:u1"
     }
    },
    {
     "event": "HOLDER_ABSENT",
     "payload": {
      "code": "not-found",
