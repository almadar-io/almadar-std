    },
    {
     "event": "NAME_CHECK",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "NAME_CLAIM_FAILED",
        "payload": {
         "code": "kept",
         "value": "kept-one"
        }
       }
      ],
      "neverEmits": [
       "NAME_CLAIMED"
      ]
     }
    }
   ]
