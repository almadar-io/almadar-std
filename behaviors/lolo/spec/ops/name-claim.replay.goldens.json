{
 "atom": "ops/atoms/std-name-claim.lolo",
 "trait": "NameClaimer",
 "cases": [
  {
   "id": "fresh-claim-writes-and-claims",
   "steps": [
    {
     "event": "CLAIM_NAME",
     "payload": {
      "name": "osama",
      "holder": "user:u1"
     }
    },
    {
     "event": "HOLDER_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "x"
     },
     "expect": {
      "emits": [
       {
        "event": "NAME_CHECK",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "NAME_CHECK",
     "payload": {}
    },
    {
     "event": "LOCK_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "x"
     }
    },
    {
     "event": "NAME_WRITTEN",
     "payload": {
      "completedCount": 2,
      "totalCount": 2
     },
     "expect": {
      "emits": [
       {
        "event": "NAME_CLAIMED",
        "payload": {
         "name": "osama",
         "holder": "user:u1"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "malformed-name-invalid",
   "steps": [
    {
     "event": "CLAIM_NAME",
     "payload": {
      "name": "X",
      "holder": "user:u1"
     },
     "expect": {
      "emits": [
       {
        "event": "NAME_CLAIM_FAILED",
        "payload": {
         "code": "invalid",
         "value": "X"
        }
       }
      ],
      "neverEmits": [
       "NAME_CLAIMED",
       "NAME_CHECK"
      ]
     }
    }
   ]
  },
  {
   "id": "taken-by-other-holder",
   "steps": [
    {
     "event": "CLAIM_NAME",
     "payload": {
      "name": "acme",
      "holder": "user:u1"
     }
    },
    {
     "event": "HOLDER_ABSENT",
     "payload": {
