{
 "atom": "ops/atoms/std-daemon.lolo",
 "trait": "Daemon",
 "note": "Host ports are faked: each effect is asserted and the host's answer is played as the next step's event. The one-tick background poll is not played.",
 "cases": [
  {
   "id": "start-probes-the-ready-port-first",
   "note": "a start from idle moves to starting and asks for the probe, never a spawn",
   "steps": [
    {
     "trait": "Daemon",
     "event": "DAEMON_START",
     "from": "idle",
     "payload": {
      "argv": [
       "emulators:start"
      ]
     },
     "entity": {
      "id": "d",
      "pid": 0,
      "reused": false,
      "spawned": false,
      "argv": [
       "a"
      ],
      "env": {},
      "cmdCursor": 0,
      "pollDueAt": null,
      "deadline": null
     },
     "expect": {
      "state": "starting",
      "emits": [
       {
        "event": "DAEMON_PROBE"
       }
      ],
      "entity": {
       "argv": [
        "emulators:start"
       ],
       "spawned": false
      }
     }
    }
   ],
   "config": {
    "commands": [
     "firebase"
    ],
    "readyHost": "127.0.0.1",
    "readyPort": 8080,
    "readyTimeoutMs": 120000,
    "pollMs": 500
   }
  },
  {
   "id": "probe-connects-to-the-configured-port",
   "note": "the probe is an os/tcp-connect to the readyHost and readyPort knobs",
   "steps": [
    {
     "trait": "Daemon",
     "event": "DAEMON_PROBE",
     "from": "starting",
     "payload": {},
     "entity": {
      "id": "d",
      "pid": 0,
      "reused": false,
      "spawned": false,
      "argv": [
       "a"
      ],
      "env": {},
      "cmdCursor": 0,
      "pollDueAt": null,
      "deadline": null
     },
     "expect": {
      "state": "starting",
      "effects": [
       {
        "type": "os/tcp-connect"
       }
      ]
     }
    }
   ],
   "config": {
    "commands": [
     "firebase"
    ],
    "readyHost": "127.0.0.1",
    "readyPort": 8080,
    "readyTimeoutMs": 120000,
    "pollMs": 500
   }
  },
  {
   "id": "a-port-already-listening-is-reused",
   "note": "nothing was spawned and the port accepts: ready with pid 0 and reused true",
   "steps": [
    {
     "trait": "Daemon",
     "event": "DAEMON_PORT_UP",
     "from": "starting",
     "payload": {
      "sock": 7
     },
     "entity": {
      "id": "d",
      "pid": 0,
      "reused": false,
      "spawned": false,
      "argv": [
       "a"
      ],
      "env": {},
      "cmdCursor": 0,
      "pollDueAt": null,
      "deadline": null
     },
     "expect": {
      "state": "running",
      "effects": [
       {
        "type": "os/close"
       }
      ],
      "emits": [
       {
        "event": "DAEMON_READY",
        "payload": {
         "pid": 0,
         "reused": true
        }
       }
      ],
      "entity": {
       "reused": true
      }
     }
    }
   ],
   "config": {
    "commands": [
     "firebase"
    ],
    "readyHost": "127.0.0.1",
    "readyPort": 8080,
    "readyTimeoutMs": 120000,
    "pollMs": 500
   }
  },
  {
