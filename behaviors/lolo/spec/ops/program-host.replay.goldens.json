    {
      "id": "an-opened-guest-with-a-route-is-navigated-keyed-by-the-route",
      "note": "G-STD-319: after the guest opens, the host asks program/navigate for the route, keyed by the route string, answered like a HOST_NAVIGATE; no guest session exists in a step, so the kernel's refusal shows the ask reached program/navigate",
      "steps": [
        {
          "trait": "ProgramHost",
          "from": "reading",
          "event": "HOST_GUEST_OPENED",
          "payload": {
            "result": {
              "guest": "guest-1"
            }
          },
          "expect": {
            "state": "hosting",
            "effects": [
              {
                "type": "program/navigate",
                "arg0": {
                  "guest": "@payload.result.guest",
                  "route": "@entity.route",
                  "key": "@entity.route",
                  "emit": {
                    "success": "HOST_GUEST_ANSWERED",
                    "failure": "HOST_GUEST_FAILED"
                  }
                },
                "status": "failed",
                "error": "program/navigate: no open guest 'guest-1' (it was never opened or is closed)"
              }
            ]
          },
          "entity": {
            "id": "host",
            "path": "guest.lolo",
            "cwd": "/w",
