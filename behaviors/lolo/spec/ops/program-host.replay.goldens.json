          "expect": {
            "state": "waiting",
            "emits": [
              {
                "event": "HOST_REFUSED",
                "payload": {
                  "reason": "usage: orb host <shell> <program.lolo> [--grant=<kind>] [--route=<path>]"
                }
              },
              {
                "event": "HOST_COMMAND_ANSWERED",
                "payload": {
                  "status": 400,
                  "body": "usage: orb host <shell> <program.lolo> [--grant=<kind>] [--route=<path>]"
                }
              }
            ]
          },
          "entity": {
            "id": "host",
