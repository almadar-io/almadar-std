    {
      "id": "control-an-unknown-flag-is-still-a-usage-refusal",
      "note": "control: the parser's error for an unknown flag refuses the command, a route flag does not excuse it",
      "steps": [
        {
          "trait": "ProgramHost",
          "from": "parsing",
          "event": "HOST_ARGS_DONE",
          "payload": {
            "stage": "host",
            "flags": {
              "route": [
                "/x"
              ]
            },
            "positionals": [
              "guest.lolo"
            ],
            "errors": [
              "unknown flag --bogus"
