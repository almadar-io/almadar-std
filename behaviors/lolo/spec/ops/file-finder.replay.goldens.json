{
  "atom": "ops/atoms/std-file-finder.lolo",
  "trait": "FileFinder",
  "cases": [
    {
      "id": "open-lists-the-root-with-ripgrep",
      "steps": [
        {
          "event": "FINDER_OPEN",
          "payload": {
            "root": "/w"
          },
          "expect": {
            "emits": [
              {
                "event": "FINDER_LIST",
                "payload": {
                  "stage": "list",
                  "argv": [
                    "--files",
                    "--hidden",
                    "--glob",
                    "!.git",
                    "/w"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "listed-files-are-relative-to-the-root",
      "steps": [
        {
          "event": "FINDER_OPEN",
          "payload": {
            "root": "/w"
          }
        },
        {
          "event": "CLI_DONE",
          "payload": {
            "stage": "list",
            "exitCode": 0,
            "signal": 0,
            "stdout": "/w/src/app.lolo\n/w/src/apple/pie.ts\n/w/docs/a-p-p.md\n/w/lib/zap.lolo\n",
            "stdoutBytes": "",
            "stderr": ""
          },
          "expect": {
            "entity": {
              "files": [
                "src/app.lolo",
                "src/apple/pie.ts",
                "docs/a-p-p.md",
                "lib/zap.lolo"
              ]
            },
            "emits": [
              {
                "event": "FINDER_READY",
                "payload": {
                  "root": "/w",
                  "count": 4
                }
              }
            ]
          }
        }
      ]
    },
