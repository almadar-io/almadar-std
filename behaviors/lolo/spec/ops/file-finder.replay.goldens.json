            "stdout": "/w/src/app.lolo\n/w/src/apple/pie.ts\n/w/docs/a-p-p.md\n/w/lib/zap.lolo\n",
            "stdoutBytes": "",
            "stderr": ""
          }
        },
        {
          "event": "FINDER_GREP",
          "payload": {
            "query": "x"
          }
        },
        {
          "event": "CLI_DONE",
          "payload": {
            "stage": "grep",
            "exitCode": 0,
            "signal": 0,
            "stdout": "/w/src/a.lolo:3:5:  x: y\n/w/lib/b.ts:1:1:x\n",
            "stdoutBytes": "",
            "stderr": ""
          },
          "expect": {
            "emits": [
              {
                "event": "GREP_RESULTS",
                "payload": {
                  "query": "x",
                  "hits": [
                    {
                      "path": "src/a.lolo",
                      "row": 2,
                      "col": 4,
                      "text": "  x: y"
                    },
                    {
                      "path": "lib/b.ts",
                      "row": 0,
                      "col": 0,
                      "text": "x"
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
