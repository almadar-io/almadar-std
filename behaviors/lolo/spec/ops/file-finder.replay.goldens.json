    {
      "id": "grep-hits-are-relative-zero-based-and-keep-colons-in-text",
      "steps": [
        {
          "event": "FINDER_OPEN",
          "payload": {
            "root": "/w"
          }
        },
        {
          "event": "CLI_DONE",
          "payload": {
            "stage": "list",
            "exitCode": 0,
