app cli-spec [
  version: "1.0.0",
  description: "Design contract for running one command-line program as a child process: a run takes the arguments, collects everything the child writes to stdout and stderr, waits for its exit and answers once with the exit code and both streams. The streams are piped and collected by default; an explicit stdio setting of inherit instead hands the child the terminal, keeping prompts and live output, and the run answers with the exit code alone. One run at a time; a run asked for while another is in flight is refused, never queued or dropped silently. The program is an ordered list of candidates (a plain name, a path beside the running binary, or one named by an environment variable): a candidate that is absent is skipped for the next, any other start failure or an exhausted list fails the run."
]

type AnchoredEnv = { anchor : { env : string! }! }
type AnchoredPath = { anchor : string!, path : string! }
type CliCommand = string | AnchoredEnv | AnchoredPath

orbital CliSpec {
  expects entity CliCall [runtime] {
    id : string!
    stage : string
    exitCode : number
  }
  expects trait CliRunner {
    state idle {
      CLI_RUN -> running
    }
    state running {
      CLI_RUN -> running
      CLI_SPAWN_FAILED -> running
    }
    emits {
      CLI_DONE { stage : string!  exitCode : number!  stdout : string!  stderr : string! }
      CLI_FAILED { stage : string!  error : string!  code : string! }
    }
  }
  expects config { stdio : string = "pipe"  commands : [CliCommand] = ["echo"] }
  expects page "/cli" -> CliRunner
}
