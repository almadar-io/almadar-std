                "body": "{\"c\":\"{client}\"}"
              }
            ],
            "prefix": "/apps/a",
            "stream": false,
            "thinkMs": 0
          },
          "expect": {
            "state": "sending",
            "emits": [
              {
                "event": "VU_NEXT",
                "payload": {
                  "vu": "vu0"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "the ticket opens the live stream on the user's own stream key",
      "entity": {
        "clientId": "c0",
        "journey": [
          {
            "label": "p",
            "method": "POST",
            "path": "/x/{client}",
            "body": "{\"c\":\"{client}\"}"
          },
          {
            "label": "q",
            "method": "GET",
            "path": "/y",
            "body": ""
          }
        ],
        "prefix": "/apps/a",
        "thinkMs": 0,
        "stream": true,
        "headers": [
          {
            "name": "authorization",
            "value": "Bearer t0"
          }
        ],
        "label": "ticket"
      },
      "steps": [
        {
          "trait": "LoadVu",
          "from": "ticketing",
          "event": "VU_REPLIED",
          "payload": {
            "key": "vu0",
            "status": 200,
            "body": "{\"ticket\":\"t1\"}"
          },
          "expect": {
            "state": "sending",
            "emits": [
              {
                "event": "LOAD_SAMPLE",
                "payload": {
                  "label": "ticket",
                  "status": 200
                }
              },
              {
                "event": "LOAD_HTTP_SEND",
                "payload": {
                  "key": "vu0/s",
                  "method": "GET",
                  "target": "/apps/a/api/events?ticket=t1",
                  "headers": [
                    {
                      "name": "authorization",
                      "value": "Bearer t0"
                    }
                  ],
                  "stream": "sse"
                }
              },
              {
                "event": "VU_NEXT",
                "payload": {
                  "vu": "vu0"
                }
              }
            ]
          }
        }
      ]
    },
    {
