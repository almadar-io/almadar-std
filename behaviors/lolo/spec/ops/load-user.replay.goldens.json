{
  "atom": "ops/atoms/std-load-user.lolo",
  "trait": "LoadVu",
  "cases": [
    {
      "id": "a user with a stream mints its ticket first, with its headers",
      "steps": [
        {
          "trait": "LoadVu",
          "from": "idle",
          "event": "VU_START",
          "payload": {
            "vu": "vu0",
            "clientId": "c0",
            "headers": [
              {
                "name": "authorization",
                "value": "Bearer t0"
              }
            ],
            "journey": [
              {
                "label": "p",
                "method": "POST",
                "path": "/x/{client}",
                "body": "{\"c\":\"{client}\"}"
              }
            ],
            "prefix": "/apps/a",
            "stream": true,
            "thinkMs": 0
          },
          "expect": {
            "state": "ticketing",
            "emits": [
              {
                "event": "LOAD_HTTP_SEND",
                "payload": {
                  "key": "vu0",
                  "method": "POST",
                  "target": "/apps/a/api/events/ticket?clientId=c0",
                  "headers": [
                    {
                      "name": "content-type",
                      "value": "application/json"
                    },
                    {
                      "name": "authorization",
                      "value": "Bearer t0"
                    }
                  ],
                  "stream": "none"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "control: a user without a stream sends its first request",
      "steps": [
        {
          "trait": "LoadVu",
          "from": "idle",
          "event": "VU_START",
          "payload": {
            "vu": "vu0",
