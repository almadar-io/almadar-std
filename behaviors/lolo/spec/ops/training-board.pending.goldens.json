{
 "pendingOn": "PS1 config (instanceTypes knob is not applied by program/step) and entity seeding of the found-instances array; ssh visit chain from fixtures/training-board/recorded.json",
 "atom": "ops/atoms/std-training-board.lolo",
 "trait": "TrainingStatus",
 "cases": [
  {
   "id": "load-lists-running-gpu-instances",
   "config": {
    "region": "us-east-1",
    "instanceTypes": [
     "g4dn.*",
     "g5.*",
     "p3.*",
     "p4d.*"
    ]
   },
   "steps": [
    {
     "event": "TRAINING_LOAD",
     "payload": {},
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "TR_AWS",
        "payload": {
         "stage": "list",
         "argv": [
          "ec2",
          "describe-instances",
          "--region",
          "us-east-1",
          "--filters",
          "Name=instance-state-name,Values=running",
          "Name=instance-type,Values=g4dn.*,g5.*,p3.*,p4d.*",
          "--query",
          "Reservations[].Instances[].{Id:InstanceId,Type:InstanceType,IP:PublicIpAddress,Launch:LaunchTime}",
          "--output",
          "json"
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "refresh-lists-again",
   "config": {
    "region": "us-east-1",
    "instanceTypes": [
     "g4dn.*",
     "g5.*",
     "p3.*",
     "p4d.*"
    ]
   },
   "steps": [
    {
     "event": "TRAINING_REFRESH",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "TR_AWS",
        "payload": {
         "stage": "list",
         "argv": [
          "ec2",
          "describe-instances",
          "--region",
          "us-east-1",
          "--filters",
          "Name=instance-state-name,Values=running",
          "Name=instance-type,Values=g4dn.*,g5.*,p3.*,p4d.*",
          "--query",
          "Reservations[].Instances[].{Id:InstanceId,Type:InstanceType,IP:PublicIpAddress,Launch:LaunchTime}",
          "--output",
          "json"
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "instance-without-public-ip-skipped",
   "note": "seed found=[{instanceId,publicIp:''}], cursor 0; TR_NEXT emits TR_SKIP",
   "entity": {
    "found": [
     {
      "instanceId": "i-2",
      "instanceType": "g5.xlarge",
      "publicIp": "",
      "launchTime": "2026-10-15T00:00:00Z"
     }
    ],
    "cursor": 0
   },
   "steps": [
    {
     "event": "TR_NEXT",
     "payload": {},
     "from": "reading",
     "expect": {
      "emits": [
       {
        "event": "TR_SKIP",
        "payload": {}
       }
      ]
     }
    }
   ]
  }
 ]
}