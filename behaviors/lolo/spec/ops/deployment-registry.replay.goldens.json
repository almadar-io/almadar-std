  {
   "id": "history-oldest-first",
   "steps": [
    {
     "event": "HISTORY",
     "payload": {
      "artifact": "acme/shop"
     }
    },
    {
     "event": "HISTORY_LOADED",
     "payload": {
      "data": [
       {
        "id": "acme/shop#2",
        "artifact": "acme/shop",
        "version": 2,
        "activates": false
       },
       {
        "id": "acme/shop#1",
        "artifact": "acme/shop",
        "version": 1,
        "activates": true
       }
      ]
     },
     "expect": {
      "emits": [
       {
        "event": "HISTORY_ANSWERED",
        "payload": {
         "artifact": "acme/shop",
         "deployments": [
          {
           "id": "acme/shop#1",
           "artifact": "acme/shop",
           "version": 1,
           "activates": true
          },
          {
           "id": "acme/shop#2",
           "artifact": "acme/shop",
           "version": 2,
           "activates": false
          }
         ]
        }
       }
      ]
     }
    }
   ]
