  {
   "id": "rollback-to-earlier-activatable-version",
   "steps": [
    {
     "event": "ROLLBACK",
     "payload": {
      "artifact": "acme/shop",
      "version": 1
     }
    },
    {
     "event": "ROLLBACK_LOADED",
     "payload": {
      "data": {
       "id": "acme/shop#1",
       "artifact": "acme/shop",
       "version": 1,
       "activates": true,
       "details": {
        "commit": "c1"
       }
      }
     },
     "expect": {
      "neverEmits": [
       "ROLLBACK_FAILED"
      ]
     }
    },
    {
     "event": "ROLLBACK_ACTIVE_LOADED",
     "payload": {
      "data": {
       "id": "acme/shop",
       "version": 2
      }
     }
    },
    {
     "event": "ROLLBACK_WRITTEN",
     "payload": {
      "id": "acme/shop"
     },
     "expect": {
      "emits": [
       {
        "event": "ROLLED_BACK",
        "payload": {
         "artifact": "acme/shop",
         "version": 1
        }
       }
      ]
     }
    }
   ]
  },
