  {
   "id": "resolve-answers-active-deployment",
   "steps": [
    {
     "event": "RESOLVE",
     "payload": {
      "artifact": "acme/shop"
     }
    },
    {
     "event": "RESOLVE_LOADED",
     "payload": {
      "data": {
       "id": "acme/shop",
       "version": 2,
       "recordedAt": 5,
       "details": {
        "commit": "c2"
       }
      }
     },
     "expect": {
      "emits": [
       {
        "event": "RESOLVED",
        "payload": {
         "artifact": "acme/shop",
         "found": true,
         "version": 2,
         "recordedAt": 5,
         "details": {
          "commit": "c2"
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "resolve-unpublished-answers-not-found",
   "steps": [
