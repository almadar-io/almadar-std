{
 "atom": "ops/atoms/std-deployment-registry.lolo",
 "trait": "DeploymentRegistrar",
 "cases": [
  {
   "id": "first-deploy-reads-counter-then-active-then-writes",
   "steps": [
    {
     "event": "DEPLOY",
     "payload": {
      "artifact": "acme/shop",
      "activates": true,
      "details": {
       "commit": "c1"
      }
     },
     "expect": {
      "emits": [
       {
        "event": "DEPLOY_NEXT",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "COUNTER_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "x"
     },
     "expect": {
      "emits": [
       {
        "event": "DEPLOY_ACTIVE_CHECK",
        "payload": {}
       }
      ]
     }
    },
    {
     "event": "DEPLOY_ACTIVE_ABSENT",
     "payload": {
      "code": "not-found",
      "error": "x"
     },
     "expect": {
      "emits": [
       {
        "event": "DEPLOY_WRITE",
        "payload": {}
       }
      ],
      "neverEmits": [
       "DEPLOY_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "later-deploy-reads-existing-counter-and-active",
