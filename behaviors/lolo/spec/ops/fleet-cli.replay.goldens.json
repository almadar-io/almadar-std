    {
      "id": "--runtime builds the target's runtime before any app",
      "config": {
        "apps": [
          {
            "name": "shop",
            "program": "p/shop.lolo",
            "site": "shop-site",
            "staticDir": "",
            "env": {
              "FIRESTORE_DATABASE_ID": "shopdb",
              "X": "1"
            },
            "firestoreDatabase": "shopdb"
