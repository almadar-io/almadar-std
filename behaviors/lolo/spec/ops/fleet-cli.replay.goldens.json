    {
      "id": "the results answer one line per app and fail when one failed",
      "config": {
        "apps": [
          {
            "name": "shop",
            "program": "p/shop.lolo",
            "site": "shop-site",
            "staticDir": "",
            "env": {
              "FIRESTORE_DATABASE_ID": "shopdb",
              "X": "1"
            },
            "firestoreDatabase": "shopdb"
          },
          {
            "name": "blog",
            "program": "p/blog.lolo",
            "site": "",
            "staticDir": "",
            "env": {},
            "firestoreDatabase": ""
          }
        ],
        "targets": [
          {
            "name": "box",
            "env": {},
            "indexes": true
          },
          {
            "name": "local",
            "env": {
              "FIRESTORE_AUTH": "emulator",
              "FIRESTORE_DATABASE_ID": "(default)"
            },
            "indexes": false
