{
  "atom": "ops/atoms/std-fleet-cli.lolo",
  "trait": "FleetCli",
  "note": "The deploy command over std-deploy-host fleets.",
  "cases": [
    {
      "id": "a deploy call parses its words",
      "config": {
        "apps": [
          {
            "name": "shop",
            "program": "p/shop.lolo",
            "site": "shop-site",
            "staticDir": "",
            "env": {
              "FIRESTORE_DATABASE_ID": "shopdb",
              "X": "1"
            },
            "firestoreDatabase": "shopdb"
          },
          {
            "name": "blog",
            "program": "p/blog.lolo",
            "site": "",
            "staticDir": "",
            "env": {},
            "firestoreDatabase": ""
          }
        ],
        "targets": [
          {
            "name": "box",
            "env": {},
            "indexes": true
          },
          {
            "name": "local",
            "env": {
              "FIRESTORE_AUTH": "emulator",
              "FIRESTORE_DATABASE_ID": "(default)"
            },
            "indexes": false
          }
        ],
        "defaultTarget": "local"
      },
      "defaults": [
        "FleetArgs"
      ],
      "steps": [
        {
          "event": "FLEET_CALLED",
          "from": "ready",
          "payload": {
            "headers": {},
            "rawBody": "{\"argv\": [\"deploy\", \"--target\", \"box\"], \"cwd\": \"/w\"}"
          },
          "expect": {
            "emits": [
              {
                "event": "FLEET_ARGS_PARSE",
                "payload": {
                  "stage": "fleet",
                  "argv": [
                    "deploy",
                    "--target",
                    "box"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "the local target lays its env over every app and deploys no indexes",
      "config": {
        "apps": [
          {
            "name": "shop",
            "program": "p/shop.lolo",
            "site": "shop-site",
            "staticDir": "",
            "env": {
              "FIRESTORE_DATABASE_ID": "shopdb",
              "X": "1"
            },
            "firestoreDatabase": "shopdb"
