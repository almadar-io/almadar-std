        ],
        "defaultTarget": "local"
      },
      "steps": [
        {
          "event": "FLEET_RESULTS",
          "from": "ready",
          "entity": {
            "id": "c",
            "busy": true
          },
          "payload": {
            "results": [
              {
                "app": "shop",
                "version": 4,
                "ok": true,
                "failures": []
              },
              {
                "app": "blog",
                "version": 0,
                "ok": false,
                "failures": [
                  "resolve: x",
                  "client: y"
                ]
              }
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "FLEET_ANSWERED",
                "payload": {
                  "status": 500,
                  "body": "ok shop release 4\nfailed blog: resolve: x; client: y"
                }
              }
            ],
            "entity": {
              "busy": false
            }
          }
        }
      ]
