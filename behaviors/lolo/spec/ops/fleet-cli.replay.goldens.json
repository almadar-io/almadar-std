      "steps": [
        {
          "event": "FLEET_ARGS_DONE",
          "from": "ready",
          "payload": {
            "stage": "fleet",
            "flags": {},
            "positionals": [
              "deploy"
            ],
            "errors": [],
            "words": []
          },
          "expect": {
            "emits": [
              {
                "event": "FLEET_DEPLOY",
                "payload": {
                  "target": "local",
                  "only": [],
                  "apps": [
                    {
                      "name": "shop",
                      "program": "p/shop.lolo",
                      "site": "shop-site",
                      "staticDir": "",
                      "env": {
                        "FIRESTORE_DATABASE_ID": "(default)",
                        "X": "1",
                        "FIRESTORE_AUTH": "emulator"
                      },
                      "firestoreDatabase": ""
                    },
                    {
                      "name": "blog",
                      "program": "p/blog.lolo",
                      "site": "",
                      "staticDir": "",
                      "env": {
                        "FIRESTORE_AUTH": "emulator",
                        "FIRESTORE_DATABASE_ID": "(default)"
                      },
                      "firestoreDatabase": ""
                    }
                  ]
                }
              }
            ],
            "entity": {
              "busy": true
            }
          }
        }
      ]
    },
