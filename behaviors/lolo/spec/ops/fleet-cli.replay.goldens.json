            "env": {},
            "firestoreDatabase": ""
          }
        ],
        "targets": [
          {
            "name": "box",
            "env": {},
            "indexes": true,
            "runtime": {
              "steps": [
                "date +%Y",
                "echo built"
              ],
              "context": "/w/ctx",
              "stack": "/w/stack"
            }
          },
          {
            "name": "local",
            "env": {
              "FIRESTORE_AUTH": "emulator",
              "FIRESTORE_DATABASE_ID": "(default)"
            },
            "indexes": false
          }
        ],
        "defaultTarget": "local"
      },
      "steps": [
        {
          "event": "FLEET_ARGS_DONE",
          "from": "ready",
          "payload": {
            "stage": "fleet",
            "flags": {
              "target": [
                "box"
              ],
              "runtime": [
                "true"
              ]
            },
            "positionals": [
              "deploy"
            ],
            "errors": [],
            "words": []
          },
          "expect": {
            "emits": [
              {
                "event": "FLEET_RUNTIME_BUILD",
                "payload": {
                  "requestId": "runtime-box",
                  "steps": [
                    {
                      "scope": "root",
                      "args": [
                        "-c",
                        "date +%Y"
                      ],
                      "stdin": "",
                      "feed": false,
                      "tolerate": false,
                      "raw": false
                    },
                    {
                      "scope": "root",
                      "args": [
                        "-c",
                        "echo built"
                      ],
                      "stdin": "",
                      "feed": false,
                      "tolerate": false,
                      "raw": false
                    }
                  ]
                }
              }
            ],
            "neverEmits": [
              "FLEET_DEPLOY"
            ],
            "entity": {
              "busy": true,
              "target": "box"
            }
          }
        },
        {
          "event": "FLEET_RUNTIME_BUILT",
          "from": "ready",
          "payload": {
            "requestId": "runtime-box",
            "outputs": [
              "2026\n",
              "built\n"
            ],
            "rawOuts": [
              "",
              ""
            ],
            "codes": [
              0,
              0
            ],
            "failures": [
              "",
              ""
            ]
          },
          "expect": {
            "emits": [
              {
                "event": "FLEET_RUNTIME_DEPLOY",
                "payload": {
                  "target": "box",
                  "contextDir": "/w/ctx",
                  "stackDir": "/w/stack",
                  "tag": "2026"
                }
              }
            ],
            "neverEmits": [
              "FLEET_DEPLOY"
            ]
          }
        },
        {
          "event": "FLEET_RUNTIME_UP",
          "from": "ready",
          "payload": {
            "image": "almadar-central-orb:2026"
          },
          "expect": {
            "emits": [
              {
                "event": "FLEET_DEPLOY",
                "payload": {
                  "target": "box",
                  "only": []
                }
              }
            ]
          }
        }
      ]
    },
