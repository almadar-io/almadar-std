    {
     "event": "AH_STATUS_LOAD",
     "payload": {
      "backendId": "b1"
     },
     "expect": {
      "emits": [
       {
        "event": "AH_PUMP",
        "payload": {}
       }
      ]
     }
    }
   ]
  },
  {
   "id": "refresh-all-with-no-backends-pumps",
   "steps": [
    {
     "event": "AH_REFRESH_ALL",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "AH_PUMP",
        "payload": {}
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-pump-on-empty-queue-stays-idle",
   "steps": [
    {
     "event": "AH_PUMP",
     "payload": {},
     "expect": {
      "state": "idle",
      "neverEmits": [
       "AH_START"
      ]
     }
    }
   ]
  },
  {
   "id": "start-of-a-status-read-asks-the-rollouts-with-no-token-step",
   "now": 1760531445678,
   "steps": [
    {
     "event": "AH_START",
     "payload": {},
     "from": "reading",
     "entity": {
      "id": "b",
      "current": {
       "kind": "status",
       "backendId": "b1",
       "force": true,
       "cloudBuildId": "",
       "region": ""
      },
      "statusCache": []
     },
     "expect": {
      "state": "reading",
      "emits": [
       {
        "event": "AH_ROLLOUTS",
        "payload": {}
       }
      ],
      "neverEmits": [
       "AH_GCLOUD"
      ]
     }
    }
   ]
  },
  {
   "id": "rollouts-sends-the-rest-read-carrying-no-credential-header",
   "now": 1760531445678,
   "steps": [
    {
     "event": "AH_ROLLOUTS",
     "payload": {},
     "from": "reading",
     "entity": {
      "id": "b",
      "current": {
       "kind": "status",
       "backendId": "b1",
       "force": true,
       "cloudBuildId": "",
       "region": ""
      }
     },
     "expect": {
      "emits": [
       {
        "event": "AH_HTTP_SEND",
        "payload": {
         "key": "rollouts",
         "method": "GET",
         "headers": [],
         "stream": "none"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-refused-rollouts-read-answers-unknown",
   "now": 1760531445678,
   "steps": [
    {
     "event": "AH_FAILED",
     "payload": {
      "key": "rollouts",
      "error": "credential not held",
      "kind": "denied"
     },
     "from": "reading",
     "entity": {
      "id": "b",
      "current": {
       "kind": "status",
       "backendId": "b1",
       "force": true,
       "cloudBuildId": "",
       "region": ""
      }
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "AH_PUMP",
        "payload": {}
       }
      ]
