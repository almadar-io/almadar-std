{
 "atom": "ops/atoms/std-ci-status.lolo",
 "trait": "CiStatus",
 "note": "from std-ci-status-program.test.ts; GraphQL pages and the retry ticks are host answers",
 "cases": [
  {
   "id": "load-starts-the-retry-keyed-ci-status",
   "steps": [
    {
     "event": "CI_STATUS_LOAD",
     "payload": {},
     "expect": {
      "state": "loading",
      "emits": [
       {
        "event": "CI_RETRY_START",
        "payload": {
         "key": "ci-status:2"
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "refresh-restarts-the-retry",
   "steps": [
    {
     "event": "CI_STATUS_REFRESH",
     "payload": {},
     "expect": {
      "state": "loading",
      "emits": [
       {
        "event": "CI_RETRY_START",
        "payload": {
         "key": "ci-status:2"
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "attempt-for-its-key-asks-github",
   "steps": [
    {
     "event": "CI_STATUS_LOAD",
     "payload": {}
    },
    {
     "event": "CI_ATTEMPT",
     "payload": {
      "key": "ci-status:2",
      "attempt": 1
     },
     "from": "loading",
     "expect": {
      "emits": [
       {
        "event": "CI_GQL"
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "control-attempt-for-another-key-asks-nothing",
   "steps": [
    {
     "event": "CI_STATUS_LOAD",
     "payload": {}
    },
    {
     "event": "CI_ATTEMPT",
     "payload": {
      "key": "other",
      "attempt": 1
     },
     "from": "loading",
     "expect": {
      "neverEmits": [
       "CI_GQL"
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "transient-failure-502-reports-retry-failed",
   "steps": [
    {
     "event": "CI_STATUS_LOAD",
     "payload": {}
    },
    {
     "event": "CI_GQL_FAILED",
     "payload": {
      "status": 502,
      "message": "bad gateway"
     },
     "from": "loading",
     "expect": {
      "state": "loading",
      "emits": [
       {
        "event": "CI_RETRY_FAILED",
        "payload": {
         "key": "ci-status:2",
         "error": "bad gateway"
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "permanent-failure-401-goes-idle-with-empty-stale-board",
   "steps": [
    {
     "event": "CI_STATUS_LOAD",
     "payload": {}
    },
    {
     "event": "CI_GQL_FAILED",
     "payload": {
      "status": 401,
      "message": "bad credentials"
     },
     "from": "loading",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "CI_STATUS",
        "payload": {
         "runs": [],
         "stale": true
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "retry-gave-up-goes-idle-with-stale-board",
   "steps": [
    {
     "event": "CI_STATUS_LOAD",
     "payload": {}
    },
    {
     "event": "CI_GAVE_UP",
     "payload": {
      "key": "ci-status:2",
      "attempts": 3,
      "error": "x"
     },
     "from": "loading",
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "CI_STATUS",
        "payload": {
         "runs": [],
         "stale": true
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "a-failing-row-click-emits-its-run-for-the-log-reader",
   "steps": [
    {
     "event": "CI_RUN_OPEN",
     "payload": {
      "id": "almadar-io/kflow",
      "row": {
       "id": "almadar-io/kflow",
       "repo": "kflow",
       "name": "CI",
       "status": "completed",
       "conclusion": "failure",
       "createdAt": "2026-10-26T10:00:00Z",
       "runId": 4242
      }
     },
     "expect": {
      "fired": true,
      "emits": [
       {
        "event": "CI_RUN_SELECTED",
        "payload": {
         "owner": "almadar-io",
         "repo": "kflow",
         "runId": "4242"
        }
       }
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "control-a-passing-row-click-emits-nothing",
   "steps": [
    {
     "event": "CI_RUN_OPEN",
     "payload": {
      "id": "almadar-io/kflow",
      "row": {
       "id": "almadar-io/kflow",
       "repo": "kflow",
       "name": "CI",
       "status": "completed",
       "conclusion": "success",
       "createdAt": "2026-10-26T10:00:00Z",
       "runId": 4242
      }
     },
     "expect": {
      "neverEmits": [
       "CI_RUN_SELECTED"
      ]
     }
    }
   ],
   "now": 1760531445678
  },
  {
   "id": "unreadable-graphql-answer-goes-to-the-retry-failure-route",
   "steps": [
    {
     "event": "CI_GQL_ANSWERED",
     "payload": {
      "body": "<html>bad gateway</html>"
     },
     "from": "loading",
     "entity": {
      "id": "b",
      "key": "ci-status:2",
      "page": 1
     },
     "expect": {
      "emits": [
       {
        "event": "CI_RETRY_FAILED"
       }
      ],
      "neverEmits": [
       "CI_RETRY_SUCCEEDED"
      ]
     }
    }
   ]
  },
  {
   "id": "control-a-readable-graphql-answer-succeeds-the-retry",
   "steps": [
    {
     "event": "CI_GQL_ANSWERED",
     "payload": {
      "body": "{\"data\":{\"organization\":{\"repositories\":{\"nodes\":[],\"pageInfo\":{\"hasNextPage\":false,\"endCursor\":\"\"}}}}}"
     },
     "from": "loading",
     "entity": {
      "id": "b",
      "key": "ci-status:2",
      "page": 1
     },
     "expect": {
      "emits": [
       {
        "event": "CI_RETRY_SUCCEEDED"
       }
      ],
      "neverEmits": [
       "CI_RETRY_FAILED"
      ]
     }
    }
   ]
  }
 ]
}