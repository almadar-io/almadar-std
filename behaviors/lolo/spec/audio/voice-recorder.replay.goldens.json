      "defaults": [
        "VoiceWav"
      ]
    },
    {
      "id": "a microphone that stops on its own pauses the take",
      "steps": [
        {
          "from": "recording",
          "event": "MIC_FAILED",
          "payload": {
            "error": "device removed",
            "kind": "unavailable",
            "key": "recorder"
          },
          "entity": {
            "id": "r",
            "phase": "recording",
            "rate": 1000,
            "channels": 1,
            "samples": 4,
            "levels": [
              0.5
            ],
            "bucketSquares": 0,
            "bucketReads": 0,
            "bucketSamples": 0,
            "take": "",
            "takeMs": 0
          },
          "expect": {
            "state": "pausing",
            "emits": [
