    },
    {
      "id": "a microphone that cannot open says why and stays idle",
      "steps": [
        {
          "from": "opening",
          "event": "MIC_FAILED",
          "payload": {
            "error": "Permission denied",
            "kind": "denied",
            "key": "recorder"
          },
          "entity": {
            "id": "r",
            "phase": "opening",
            "rate": 0,
            "channels": 0,
            "samples": 0,
            "levels": [],
            "bucketSquares": 0,
            "bucketReads": 0,
            "bucketSamples": 0,
            "take": "",
            "takeMs": 0
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "RECORDER_FAILED",
                "payload": {
