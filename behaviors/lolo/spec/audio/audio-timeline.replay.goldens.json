{
 "atom": "audio/atoms/std-audio-timeline.lolo",
 "trait": "AudioTimelinePlayback",
 "cases": [
  {
   "id": "play reads the host clock first",
   "steps": [
    {
     "from": "idle",
     "event": "TIMELINE_PLAY",
     "payload": {
      "clips": [
       {
        "key": "a",
        "source": "/tracks/a.wav",
        "at": 0,
        "offset": 0,
        "duration": 8,
        "rate": 1,
        "gain": 1,
        "fadeIn": 1,
        "fadeOut": 1
       }
      ]
     },
     "expect": {
      "fired": true,
      "state": "starting",
      "effects": [
       {
        "type": "audio/clock"
       }
      ],
      "emits": [
       {
        "event": "TIMELINE_STARTED",
        "payload": {
         "origin": 10.5
        }
       }
      ]
     },
     "entity": {
      "id": "t",
      "clips": [],
      "pending": [],
      "origin": 0,
      "position": 0,
      "wall": 0,
      "playing": false
     },
     "answers": [
      {
       "operator": "audio/clock",
       "ok": {
        "audio": 10,
        "wall": 1000
       }
      }
     ]
    }
   ]
  },
  {
   "id": "the clock read places timeline zero leadSeconds after it and schedules the clips",
