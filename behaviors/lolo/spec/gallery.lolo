app gallery-spec [
  version: "1.0.0",
  description: "Design contract for an image gallery: items live in the session only and are shared by every viewer of the page. Shows the [runtime, shared] storage tags and an event payload."
]

orbital GallerySpec {
  expects entity GalleryItem [runtime, shared] { id : string! }
  expects trait GalleryItemGallery { emits { GalleryItemLoaded } }
  expects page "/galleryitems/gallery" -> GalleryItemGallery
}
