    {
      "id": "the-clients-reply-for-the-sms-key-reaches-the-sms-reply-route",
      "steps": [
        {
          "trait": "TwilioHttp",
          "event": "HC_READ",
          "from": "reading",
          "entity": {
            "key": "sms",
            "stage": "head",
            "stream": "none"
          },
          "payload": {
            "data": "SFRUUC8xLjEgMjAxIFgNCmNvbnRlbnQtbGVuZ3RoOiAyOQ0KDQp7InNpZCI6IlNNOSIsInN0YXR1cyI6InNlbnQifQ==",
            "eof": false,
            "key": "read"
          },
          "expect": {
            "emits": [
              {
                "event": "HTTP_REPLIED",
                "payload": {
                  "key": "sms",
                  "status": 201
                }
              },
              {
                "event": "TWILIO_SMS_RESULT",
                "payload": {
                  "sid": "SM9",
                  "status": "sent"
                }
              }
            ],
            "neverEmits": [
              "TWILIO_WHATSAPP_RESULT",
              "TWILIO_SMS_FAILED"
            ]
          }
        }
      ],
      "config": {
        "accountSid": "ACabc",
        "phoneNumber": "+15550001"
      },
      "defaults": [
        "TwilioHttp"
      ]
    },
