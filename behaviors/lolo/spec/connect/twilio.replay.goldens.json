{
  "atom": "connect/atoms/std-twilio.lolo",
  "trait": "TwilioClient",
  "note": "std-twilio over the composed std-http-client: the Messages form post is one TWILIO_HTTP_SEND (basic auth rides the client's TWILIO_BASIC_AUTH credential, never the event), replies and failures return by call key, and every failure answers TWILIO_SMS_FAILED or TWILIO_WHATSAPP_FAILED.",
  "cases": [
    {
      "id": "sms-send-asks-the-http-client-for-one-form-post-to-the-messages-resource",
      "steps": [
        {
          "event": "TWILIO_SEND_SMS",
          "payload": {
            "to": "+15551234",
            "body": "Hi there!"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "TWILIO_HTTP_SEND",
                "payload": {
                  "key": "sms",
                  "method": "POST",
                  "target": "/2010-04-01/Accounts/ACabc/Messages.json",
                  "headers": [
                    {
                      "name": "content-type",
                      "value": "application/x-www-form-urlencoded"
                    },
                    {
                      "name": "accept",
                      "value": "application/json"
                    }
                  ],
                  "body": "VG89JTJCMTU1NTEyMzQmRnJvbT0lMkIxNTU1MDAwMSZCb2R5PUhpJTIwdGhlcmUlMjE=",
                  "stream": "none"
                }
              }
            ],
            "neverEmits": [
              "TWILIO_WHATSAPP_HTTP_FAILED"
            ]
          }
        }
      ],
      "config": {
        "accountSid": "ACabc",
        "phoneNumber": "+15550001"
      },
      "defaults": [
        "TwilioHttp"
      ]
    },
    {
      "id": "control-sms-send-with-its-own-sender-uses-it-instead-of-the-configured-number",
