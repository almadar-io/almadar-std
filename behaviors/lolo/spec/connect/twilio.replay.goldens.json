                    },
                    {
                      "name": "accept",
                      "value": "application/json"
                    }
                  ],
                  "body": "VG89JTJCMTU1NTEyMzQmRnJvbT0lMkIxNTU1OTk5OSZCb2R5PXg=",
                  "stream": "none"
                }
