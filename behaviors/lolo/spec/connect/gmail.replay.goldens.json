{
 "atom": "connect/atoms/std-gmail.lolo",
 "trait": "GmailClient",
 "note": "std-gmail over one keyed std-http-client trait (std-http-keyed): the user token is a refresh_token grant (credential-connect) the host credential store mints and renews, carried by the GmailHttp credential, never by an event; every call is a row of GmailCall under its own key; a not-held token mints once and sends again, a second not-held answer asks credential-status about the refresh token and answers NOT_CONFIGURED when none is held; inbox reads retry under keyed std-retry (4 attempts, 100 x 5^(n-1) ms capped at 1500) and each message read starts when std-retry completes the run of the one before; the draft POST is never retried; the raw RFC 2822 message is built and base64url-encoded in .lolo. Self-handled internal events (declared -> internal) are consumed by the trait and not listed.",
 "cases": [
  {
   "id": "list-inbox-defaults-to-in-inbox-newer-than-1d-and-20-results",
   "steps": [
    {
     "event": "LIST_INBOX",
     "payload": {},
     "expect": {
      "emits": [
       {
        "event": "GMAIL_RETRY_START",
        "payload": {
         "key": "inbox:in:inbox newer_than:1d|20#1"
        }
       },
       {
        "event": "GMAIL_HTTP_SEND",
        "payload": {
         "key": "inbox:in:inbox newer_than:1d|20#1",
         "method": "GET",
         "target": "/gmail/v1/users/me/messages?q=in%3Ainbox%20newer_than%3A1d&maxResults=20",
         "headers": [
          {
           "name": "accept",
           "value": "*/*"
          }
         ],
         "body": "",
         "stream": "none"
        }
       }
      ]
     }
    }
   ],
   "config": {},
   "defaults": [
    "GmailClient",
    "GmailCall",
    "GmailKeyed",
    "GmailHttp",
    "GmailRetry"
   ]
  },
  {
   "id": "control-list-inbox-with-a-query-and-a-limit-sends-them",
   "steps": [
    {
     "event": "LIST_INBOX",
     "payload": {
      "query": "from:ann is:unread",
      "maxResults": 5
     },
     "expect": {
      "emits": [
       {
        "event": "GMAIL_RETRY_START",
        "payload": {
         "key": "inbox:from:ann is:unread|5#1"
        }
       },
       {
        "event": "GMAIL_HTTP_SEND",
        "payload": {
         "key": "inbox:from:ann is:unread|5#1",
         "method": "GET",
         "target": "/gmail/v1/users/me/messages?q=from%3Aann%20is%3Aunread&maxResults=5",
         "headers": [
          {
           "name": "accept",
           "value": "*/*"
          }
         ],
         "body": "",
         "stream": "none"
        }
       }
      ],
      "neverEmits": [
       "GMAIL_HTTP_SEND_X"
      ]
     }
    }
   ],
   "config": {},
   "defaults": [
    "GmailClient",
    "GmailCall",
    "GmailKeyed",
    "GmailHttp",
    "GmailRetry"
   ]
  },
