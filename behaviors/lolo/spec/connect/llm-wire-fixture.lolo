app llm-wire-fixture [
  version: "1.0.0",
  net: { "api.anthropic.com:443": [tcp], "127.0.0.1:1234": [tcp] },
  description: "Replay fixture for std-llm on the wire: an anthropic chat (x-api-key credential, Messages body, sse stream) and a keyless LM Studio chat (no authorization header), each composed with std-http-request and std-http-client the way a consumer composes them."
]
uses Llm from "std/behaviors/std-llm"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"
uses Frame from "std/behaviors/std-http-frame"

orbital LlmWireFixtureOrbital {
  entity WireCall [runtime] {
    id : string!
    text : string = ""
    failure : string = ""
  }

  trait WireDriver -> WireCall [client] {
    initial: idle

    state idle {
      INIT -> idle
      ASK_ANTHROPIC -> idle
        (emit LLM_GENERATE_ANTHROPIC { userPrompt: ?prompt, key: ?key, stream: ?stream })
      ASK_LOCAL -> idle
        (emit LLM_GENERATE_LOCAL { userPrompt: ?prompt, key: ?key })
      ASK_LOCAL_QUIET -> idle
        (emit LLM_GENERATE_LOCAL_QUIET { userPrompt: ?prompt, key: ?key })
      CANCEL_CALL -> idle
        (emit LLM_CANCEL_ANTHROPIC { key: ?key })
      ANSWERED -> idle
        (set @entity.text ?content)
      FAILED -> idle
        (set @entity.failure ?message)
      CANCELLED -> idle
      CHUNK -> idle
    }

    emits {
      LLM_GENERATE_ANTHROPIC -> external {
        userPrompt : string!
        key : string
        stream : boolean
      }
        @description "Ask the anthropic chat."
        @tier "secondary"
      LLM_GENERATE_LOCAL -> external {
        userPrompt : string!
        key : string
      }
        @description "Ask the local chat."
        @tier "secondary"
      LLM_GENERATE_LOCAL_QUIET -> external {
        userPrompt : string!
        key : string
      }
        @description "Ask the local chat whose reasoningEffort knob turns thinking off."
        @tier "secondary"
      LLM_CANCEL_ANTHROPIC -> external {
        key : string!
      }
        @description "Cancel the keyed anthropic chat."
        @tier "secondary"
    }

    listens {
      AnthropicLlm.LLM_GENERATE_RESULT -> ANSWERED
      LocalLlm.LLM_GENERATE_RESULT -> ANSWERED
      LocalQuietLlm.LLM_GENERATE_RESULT -> ANSWERED
      AnthropicLlm.LLM_FAILED -> FAILED
      LocalLlm.LLM_FAILED -> FAILED
      AnthropicLlm.LLM_CANCELLED -> CANCELLED
      AnthropicLlm.LLM_GENERATE_DELTA -> CHUNK
      ASK_ANTHROPIC {
        prompt : string!
        key : string
        stream : boolean
      }
      ASK_LOCAL {
        prompt : string!
        key : string
      }
      ASK_LOCAL_QUIET {
        prompt : string!
        key : string
      }
      CANCEL_CALL {
        key : string!
      }
      ANSWERED {
        content : string!
      }
      FAILED {
        code : string
        message : string!
        key : string
      }
      CANCELLED {
        key : string!
      }
      CHUNK {
        key : string
        delta : string
      }
    }
  }

  trait AnthropicLlm = Llm.traits.LlmClient {
    config {
      provider: anthropic
      basePath: "/v1"
      model: "claude-sonnet-4-5"
    }
    events {
      LLM_GENERATE: LLM_GENERATE_ANTHROPIC
      LLM_CANCEL: LLM_CANCEL_ANTHROPIC
    }
    listens {
      WireDriver.LLM_GENERATE_ANTHROPIC -> LLM_GENERATE_ANTHROPIC
      WireDriver.LLM_CANCEL_ANTHROPIC -> LLM_CANCEL_ANTHROPIC
      AnthropicRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      AnthropicRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      AnthropicRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      AnthropicHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait AnthropicRequest = Req.traits.HttpRequest {
    listens {
      AnthropicRequestDelay.ELAPSED -> RETRY_ELAPSED
      AnthropicRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      AnthropicLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      AnthropicLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      AnthropicHttp.HTTP_REPLIED -> HTTP_REPLIED
      AnthropicHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait AnthropicRequestDelay = Req.traits.RequestDelay {
    listens {
      AnthropicRequest.RETRY_WAIT -> START
      AnthropicRequest.RETRY_STOP -> CANCEL
    }
  }

  trait AnthropicRequestDeadline = Req.traits.RequestDeadline {
    listens {
      AnthropicRequest.TIMEOUT_START -> START
      AnthropicRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait AnthropicHttpFrame = Frame.traits.HttpFrame {
    listens {
      AnthropicHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait AnthropicHttp = Http.traits.HttpClient {
    config {
      host: "api.anthropic.com"
      port: 443
      tls: true
      serverName: "api.anthropic.com"
      credential: "ANTHROPIC_API_KEY"
      credentialHeader: "x-api-key"
    }
    listens {
      AnthropicRequest.HTTP_SEND -> HTTP_SEND
      AnthropicRequest.HTTP_CANCEL -> HTTP_CANCEL
      AnthropicHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      AnthropicHttpFrame.FRAME_DRAINED -> HC_DRAINED
      AnthropicHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait LocalLlm = Llm.traits.LlmClient {
    config {
      provider: lmstudio
      basePath: "/v1"
      model: "qwen3-30b-a3b"
    }
    events {
      LLM_GENERATE: LLM_GENERATE_LOCAL
    }
    listens {
      WireDriver.LLM_GENERATE_LOCAL -> LLM_GENERATE_LOCAL
      LocalRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      LocalRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      LocalRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      LocalHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait LocalRequest = Req.traits.HttpRequest {
    listens {
      LocalRequestDelay.ELAPSED -> RETRY_ELAPSED
      LocalRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      LocalLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      LocalLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      LocalHttp.HTTP_REPLIED -> HTTP_REPLIED
      LocalHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait LocalRequestDelay = Req.traits.RequestDelay {
    listens {
      LocalRequest.RETRY_WAIT -> START
      LocalRequest.RETRY_STOP -> CANCEL
    }
  }

  trait LocalRequestDeadline = Req.traits.RequestDeadline {
    listens {
      LocalRequest.TIMEOUT_START -> START
      LocalRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait LocalHttpFrame = Frame.traits.HttpFrame {
    listens {
      LocalHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait LocalHttp = Http.traits.HttpClient {
    config {
      host: "127.0.0.1"
      port: 1234
      tls: false
      serverName: "127.0.0.1"
    }
    listens {
      LocalRequest.HTTP_SEND -> HTTP_SEND
      LocalRequest.HTTP_CANCEL -> HTTP_CANCEL
      LocalHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      LocalHttpFrame.FRAME_DRAINED -> HC_DRAINED
      LocalHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  trait LocalQuietLlm = Llm.traits.LlmClient {
    config {
      provider: lmstudio
      basePath: "/v1"
      model: "qwen3-30b-a3b"
      reasoningEffort: "none"
    }
    events {
      LLM_GENERATE: LLM_GENERATE_LOCAL_QUIET
    }
    listens {
      WireDriver.LLM_GENERATE_LOCAL_QUIET -> LLM_GENERATE_LOCAL_QUIET
      LocalQuietRequest.HTTP_RESULT -> LLM_CHAT_WIRE_RESULT
      LocalQuietRequest.HTTP_REQUEST_FAILED -> LLM_CHAT_WIRE_FAILED
      LocalQuietRequest.HTTP_REQUEST_REFUSED -> LLM_CHAT_WIRE_REFUSED
      LocalQuietHttp.HTTP_STREAM_EVENT -> LLM_CHAT_WIRE_STREAM
    }
  }

  trait LocalQuietRequest = Req.traits.HttpRequest {
    listens {
      LocalQuietRequestDelay.ELAPSED -> RETRY_ELAPSED
      LocalQuietRequestDeadline.ELAPSED -> TIMEOUT_ELAPSED
      LocalQuietLlm.LLM_CHAT_WIRE -> HTTP_REQUEST
      LocalQuietLlm.LLM_CHAT_WIRE_CANCEL -> HTTP_REQUEST_CANCEL
      LocalQuietHttp.HTTP_REPLIED -> HTTP_REPLIED
      LocalQuietHttp.HTTP_FAILED -> HTTP_FAILED
    }
  }

  trait LocalQuietRequestDelay = Req.traits.RequestDelay {
    listens {
      LocalQuietRequest.RETRY_WAIT -> START
      LocalQuietRequest.RETRY_STOP -> CANCEL
    }
  }

  trait LocalQuietRequestDeadline = Req.traits.RequestDeadline {
    listens {
      LocalQuietRequest.TIMEOUT_START -> START
      LocalQuietRequest.TIMEOUT_STOP -> CANCEL
    }
  }

  trait LocalQuietHttpFrame = Frame.traits.HttpFrame {
    listens {
      LocalQuietHttp.HC_FRAME -> FRAME_RUN
    }
  }

  trait LocalQuietHttp = Http.traits.HttpClient {
    config {
      host: "127.0.0.1"
      port: 1234
      tls: false
      serverName: "127.0.0.1"
    }
    listens {
      LocalQuietRequest.HTTP_SEND -> HTTP_SEND
      LocalQuietRequest.HTTP_CANCEL -> HTTP_CANCEL
      LocalQuietHttpFrame.FRAME_EVENT -> HC_FRAME_EVENT
      LocalQuietHttpFrame.FRAME_DRAINED -> HC_DRAINED
      LocalQuietHttpFrame.FRAME_FAILED -> HC_FRAME_FAILED
    }
  }

  page boot as LlmWireFixturePage -> WireDriver, AnthropicLlm, AnthropicRequest, AnthropicRequestDelay, AnthropicRequestDeadline, AnthropicHttp, AnthropicHttpFrame, LocalLlm, LocalRequest, LocalRequestDelay, LocalRequestDeadline, LocalHttp, LocalHttpFrame, LocalQuietLlm, LocalQuietRequest, LocalQuietRequestDelay, LocalQuietRequestDeadline, LocalQuietHttp, LocalQuietHttpFrame
}
