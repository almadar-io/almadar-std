        {
          "event": "STRIPE_GET_SUBSCRIPTION",
          "payload": {
            "subscriptionId": "sub_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_HTTP_FAILED",
          "payload": {
            "error": "connect timeout",
            "kind": "timeout",
            "key": "stripe-0"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "connect timeout"
                }
              }
            ]
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "key": "stripe-0",
            "body": "{\"id\":\"pi_1\",\"object\":\"payment_intent\",\"amount\":500,\"currency\":\"usd\",\"status\":\"requires_payment_method\",\"client_secret\":\"pi_1_secret\",\"metadata\":{\"order\":\"7\"}}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "Stripe answered a request that is not pending"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-failed-random-draw-answers-stripe-failed",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_RANDOM_FAILED",
          "payload": {
            "error": "no entropy",
            "key": "stripe-0"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "no entropy"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-drawn-key-for-a-request-nothing-is-waiting-on-is-answered-as-a-failure",
      "steps": [
        {
          "event": "STRIPE_KEY_DRAWN",
          "payload": {
            "value": "AAAA",
            "key": "stripe-9"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "Stripe drew an idempotency key for a request that is not pending"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "a-refund-reply-reaches-its-result-by-key",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1",
            "amount": 200
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "key": "stripe-0",
            "body": "{\"id\":\"re_1\",\"object\":\"refund\",\"amount\":200,\"status\":\"succeeded\"}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_OK",
                "payload": {
                  "key": "stripe-0"
                }
              },
              {
                "event": "STRIPE_REFUND_RESULT",
                "payload": {
                  "id": "re_1",
                  "object": "refund",
                  "amount": 200,
                  "status": "succeeded"
                }
              }
            ],
            "neverEmits": [
              "STRIPE_FAILED"
            ]
          }
        }
      ]
    },
    {
      "id": "two-requests-in-flight-are-matched-to-their-own-answers",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_CONFIRM_PAYMENT",
          "payload": {
            "paymentIntentId": "pi_2"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_OK",
          "payload": {
            "key": "stripe-1",
            "body": "{\"id\":\"pi_1\",\"object\":\"payment_intent\",\"amount\":500,\"currency\":\"usd\",\"status\":\"requires_payment_method\",\"client_secret\":\"pi_1_secret\",\"metadata\":{\"order\":\"7\"}}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_CONFIRM_PAYMENT_RESULT",
                "payload": {
                  "id": "pi_1",
                  "status": "requires_payment_method",
                  "client_secret": "pi_1_secret",
                  "metadata": {
                    "order": "7"
                  }
                }
              }
            ],
            "neverEmits": [
              "STRIPE_REFUND_RESULT",
              "STRIPE_FAILED"
            ]
          }
        },
        {
          "event": "STRIPE_OK",
          "payload": {
            "key": "stripe-0",
            "body": "{\"id\":\"re_1\",\"object\":\"refund\",\"amount\":200,\"status\":\"succeeded\"}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_REFUND_RESULT",
                "payload": {
                  "id": "re_1"
                }
              }
            ],
            "neverEmits": [
              "STRIPE_CONFIRM_PAYMENT_RESULT",
              "STRIPE_FAILED"
            ]
          }
        }
      ]
    },
    {
