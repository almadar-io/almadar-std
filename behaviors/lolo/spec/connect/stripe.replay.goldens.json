{
  "atom": "connect/atoms/std-stripe.lolo",
  "trait": "StripeClient",
  "note": "std-stripe typed events and keyed pending [{key, job}]: every request is tracked under a counter key, answers are matched by key, and a real Stripe error body reaches STRIPE_FAILED with its code and message (G-STD-198).",
  "cases": [
    {
      "id": "a-stripe-error-body-answers-stripe-failed-with-its-code-and-message",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 402,
            "headers": {},
            "key": "stripe-0",
            "body": "{\"error\":{\"type\":\"card_error\",\"code\":\"card_declined\",\"message\":\"Your card was declined.\"}}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "code": "card_declined",
                  "message": "Your card was declined."
                }
              }
            ],
            "neverEmits": [
              "STRIPE_OK"
            ]
          }
        }
      ]
    },
    {
      "id": "control-a-stripe-error-body-without-a-code-answers-its-message-alone",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 500,
            "headers": {},
            "key": "stripe-0",
            "body": "{\"error\":{\"type\":\"api_error\",\"message\":\"An error occurred with our API.\"}}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "An error occurred with our API."
                }
              }
            ],
            "neverEmits": [
              "STRIPE_OK"
            ]
          }
        }
      ]
    },
    {
      "id": "an-oauth-style-error-body-answers-its-description",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 401,
            "headers": {},
            "key": "stripe-0",
            "body": "{\"error\":\"invalid_request\",\"error_description\":\"Bad key\"}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "Bad key"
                }
              }
            ],
            "neverEmits": [
              "STRIPE_OK"
            ]
          }
        }
      ]
    },
    {
      "id": "a-reply-that-is-not-json-answers-invalid-json",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "key": "stripe-0",
            "body": "<html>bad gateway</html>"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "Invalid JSON received from the Stripe API"
                }
              }
            ],
            "neverEmits": [
              "STRIPE_OK"
            ]
          }
        }
      ]
    },
    {
      "id": "control-a-non-success-status-without-an-error-body-answers-the-status",
      "steps": [
        {
          "event": "STRIPE_REFUND",
          "payload": {
            "paymentIntentId": "pi_1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 503,
            "headers": {},
            "key": "stripe-0",
            "body": "{}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "Stripe answered HTTP 503"
                }
              }
            ],
            "neverEmits": [
              "STRIPE_OK"
            ]
          }
        }
      ]
    },
    {
      "id": "a-reply-for-a-key-nothing-is-waiting-on-is-answered-as-a-failure",
      "steps": [
        {
          "event": "STRIPE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "key": "stripe-9",
            "body": "{\"id\":\"pi_1\",\"object\":\"payment_intent\",\"amount\":500,\"currency\":\"usd\",\"status\":\"requires_payment_method\",\"client_secret\":\"pi_1_secret\",\"metadata\":{\"order\":\"7\"}}"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "STRIPE_FAILED",
                "payload": {
                  "message": "Stripe answered a request that is not pending"
                }
              }
            ],
            "neverEmits": [
              "STRIPE_OK"
            ]
          }
        }
      ]
    },
    {
      "id": "a-failed-http-call-answers-stripe-failed-and-frees-its-key",
