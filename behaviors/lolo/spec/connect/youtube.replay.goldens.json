{
  "atom": "connect/atoms/std-youtube.lolo",
  "trait": "YoutubeClient",
  "note": "std-youtube typed events and keyed pending [{key, job}]: each attempt is tracked under a counter key, a reply or unreachable answer is matched by key, and a reply for a key nothing waits on is dropped. The api-key-in-query http path is G-STD-191 and is unchanged.",
  "cases": [
    {
      "id": "search-reply-lists-whichever-fields-the-api-returned",
      "steps": [
        {
          "event": "YOUTUBE_REQUEST",
          "payload": {
            "kind": "search",
            "attempt": 0,
            "query": "cats",
            "maxResults": 10,
            "type": "",
            "id": ""
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "YOUTUBE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "{\"items\":[{\"id\":{\"videoId\":\"v1\"},\"snippet\":{\"title\":\"Cats\",\"description\":\"Funny\",\"thumbnails\":{\"default\":{\"url\":\"https://i/1.jpg\"}}}},{\"id\":{\"videoId\":\"v2\"},\"snippet\":{\"title\":\"Dogs\"}}]}",
            "key": "youtube-0"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "YOUTUBE_SEARCH_RESULT",
                "payload": {
                  "items": [
                    {
                      "videoId": "v1",
                      "title": "Cats",
                      "thumbnail": "https://i/1.jpg",
                      "description": "Funny"
                    },
                    {
                      "videoId": "v2",
                      "title": "Dogs"
                    }
                  ]
                }
              }
            ],
            "neverEmits": [
              "YOUTUBE_SEARCH_FAILED"
            ]
          }
        }
      ]
    },
    {
      "id": "search-reply-that-is-not-json-is-a-malformed-reply",
      "steps": [
        {
          "event": "YOUTUBE_REQUEST",
          "payload": {
            "kind": "search",
            "attempt": 0,
            "query": "cats",
            "maxResults": 10,
            "type": "",
            "id": ""
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "YOUTUBE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "<html>",
            "key": "youtube-0"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "YOUTUBE_SEARCH_FAILED",
                "payload": {
                  "code": "MALFORMED_REPLY",
                  "message": "YouTube API replied with a body that is not valid JSON"
                }
              }
            ],
            "neverEmits": [
              "YOUTUBE_SEARCH_RESULT"
            ]
          }
        }
      ]
    },
