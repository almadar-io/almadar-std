{
  "atom": "connect/atoms/std-youtube.lolo",
  "trait": "YoutubeClient",
  "note": "std-youtube typed events and keyed pending [{key, job}]: each attempt is tracked under a counter key, a reply or unreachable answer is matched by key, and a reply for a key nothing waits on is dropped. The call rides the composed std-http-client (api key as its query credential, never in an event); the request shape is pinned as YOUTUBE_HTTP_SEND, a denied call is rejected without retry and any other transport failure is retried.",
  "cases": [
    {
      "id": "search-reply-lists-whichever-fields-the-api-returned",
      "steps": [
        {
          "event": "YOUTUBE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "{\"items\":[{\"id\":{\"videoId\":\"v1\"},\"snippet\":{\"title\":\"Cats\",\"description\":\"Funny\",\"thumbnails\":{\"default\":{\"url\":\"https://i/1.jpg\"}}}},{\"id\":{\"videoId\":\"v2\"},\"snippet\":{\"title\":\"Dogs\"}}]}",
            "key": "youtube-0"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "YOUTUBE_SEARCH_RESULT",
                "payload": {
                  "items": [
                    {
                      "videoId": "v1",
                      "title": "Cats",
                      "thumbnail": "https://i/1.jpg",
                      "description": "Funny"
                    },
                    {
                      "videoId": "v2",
                      "title": "Dogs"
                    }
                  ]
                }
              }
            ],
            "neverEmits": [
              "YOUTUBE_SEARCH_FAILED"
            ]
          },
          "entity": {
            "pending": [
              {
                "key": "youtube-0",
                "job": {
                  "kind": "search",
                  "attempt": 0,
                  "query": "cats",
                  "maxResults": 10,
                  "type": "",
                  "id": ""
                }
              }
            ],
            "seq": 1
          }
        }
      ]
    },
    {
