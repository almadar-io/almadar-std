      "id": "two-calls-in-flight-are-answered-by-their-own-key",
      "steps": [
        {
          "event": "YOUTUBE_REQUEST",
          "payload": {
            "kind": "search",
            "attempt": 0,
            "query": "cats",
            "maxResults": 10,
            "type": "",
            "id": ""
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "YOUTUBE_REQUEST",
          "payload": {
            "kind": "video",
            "attempt": 0,
            "query": "",
            "maxResults": 0,
            "type": "",
            "id": "v1"
          },
          "expect": {
            "state": "idle"
          }
        },
        {
          "event": "YOUTUBE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "{\"items\":[{\"snippet\":{\"title\":\"T\",\"description\":\"D\"},\"statistics\":{\"viewCount\":\"10\",\"likeCount\":\"2\"}}]}",
            "key": "youtube-1"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "YOUTUBE_VIDEO_RESULT",
                "payload": {
                  "title": "T",
                  "description": "D",
                  "viewCount": "10",
                  "likeCount": "2"
                }
              }
            ],
            "neverEmits": [
              "YOUTUBE_SEARCH_RESULT"
            ]
          }
        },
        {
          "event": "YOUTUBE_REPLIED",
          "payload": {
            "status": 200,
            "headers": {},
            "body": "{\"items\":[]}",
            "key": "youtube-0"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "YOUTUBE_SEARCH_RESULT",
                "payload": {
                  "items": []
                }
              }
            ],
            "neverEmits": [
              "YOUTUBE_VIDEO_RESULT"
            ]
          }
        }
      ]
    },
    {
      "id": "search-with-a-type-reaches-the-request",
      "steps": [
        {
          "event": "YOUTUBE_SEARCH",
          "payload": {
            "query": "cats",
            "type": "video"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "YOUTUBE_REQUEST",
                "payload": {
                  "kind": "search",
                  "attempt": 0,
                  "query": "cats",
                  "maxResults": 10,
                  "type": "video",
                  "id": ""
                }
              }
            ]
          }
        }
      ]
    }
  ]
