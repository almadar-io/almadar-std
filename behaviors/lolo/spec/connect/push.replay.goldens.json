{
 "atom": "connect/atoms/std-push.lolo",
 "trait": "PushClient",
 "note": "Pins std-push's observable behaviour before it moves off the http effect: the subscription pre-checks, the reply mapping and the failure mapping. The RFC 8291 section 5 byte-level vector (spec/connect/push.vectors.json) joins once the bytes-message hmac op lands.",
 "cases": [
  {
   "id": "pin-a-subscription-without-keys-is-refused",
   "config": {
    "vapidPublicKey": "BPubKey",
    "vapidSubject": "mailto:ops@example.test"
   },
   "steps": [
    {
     "event": "PUSH_SEND",
     "payload": {
      "subscription": {
       "endpoint": "https://push.example.test/x"
      },
      "title": "Hi",
      "body": "There"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PUSH_SEND_FAILED",
        "payload": {
         "message": "push.send: subscription must be { endpoint, keys: { p256dh, auth } }"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "pin-an-empty-endpoint-is-refused",
   "config": {
    "vapidPublicKey": "BPubKey",
    "vapidSubject": "mailto:ops@example.test"
   },
   "steps": [
    {
     "event": "PUSH_SEND",
     "payload": {
      "subscription": {
       "endpoint": "",
       "keys": {
        "p256dh": "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",
        "auth": "BTBZMqHH6r4Tts7J_aSIgg"
       }
      },
      "title": "Hi",
      "body": "There"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PUSH_SEND_FAILED",
        "payload": {
         "message": "You must pass in a subscription with at least an endpoint."
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "pin-empty-keys-are-refused",
   "config": {
    "vapidPublicKey": "BPubKey",
    "vapidSubject": "mailto:ops@example.test"
   },
   "steps": [
    {
     "event": "PUSH_SEND",
     "payload": {
      "subscription": {
       "endpoint": "https://push.example.test/x",
       "keys": {
        "p256dh": "",
        "auth": ""
       }
      },
      "title": "Hi",
      "body": "There"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PUSH_SEND_FAILED",
        "payload": {
         "message": "To send a message with a payload, the subscription must have 'auth' and 'p256dh' keys."
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "pin-a-short-p256dh-is-refused",
   "config": {
    "vapidPublicKey": "BPubKey",
    "vapidSubject": "mailto:ops@example.test"
   },
   "steps": [
    {
     "event": "PUSH_SEND",
     "payload": {
      "subscription": {
       "endpoint": "https://push.example.test/x",
       "keys": {
        "p256dh": "AAAA",
        "auth": "BTBZMqHH6r4Tts7J_aSIgg"
       }
      },
      "title": "Hi",
      "body": "There"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PUSH_SEND_FAILED",
        "payload": {
         "message": "The subscription p256dh value should be 65 bytes long."
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "pin-a-valid-subscription-asks-the-push-service",
   "config": {
    "vapidPublicKey": "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",
    "vapidSubject": "mailto:ops@example.test"
   },
   "steps": [
    {
     "event": "PUSH_SEND",
     "payload": {
      "subscription": {
       "endpoint": "https://push.example.test/x",
       "keys": {
        "p256dh": "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4",
        "auth": "AAAAAAAAAAAAAAAAAAAAAA"
       }
      },
      "title": "Hi",
      "body": "There"
     },
     "expect": {
      "state": "idle",
      "effects": [
       {
        "type": "http"
       }
      ],
      "neverEmits": [
       "PUSH_SEND_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "pin-a-201-reply-answers-ok-true-expired-false",
   "config": {
    "vapidPublicKey": "BPubKey",
    "vapidSubject": "mailto:ops@example.test"
   },
   "steps": [
    {
     "event": "PUSH_SEND_REPLIED",
     "payload": {
      "status": 201,
      "headers": {},
      "body": ""
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "PUSH_SEND_RESULT",
        "payload": {
         "statusCode": 201,
         "ok": true,
         "expired": false
        }
       }
      ]
     }
    }
   ]
  },
