{
  "atom": "connect/atoms/std-iconify.lolo",
  "trait": "IconifyClient",
  "note": "Converted from orbital-integration-tests fixtures/iconify (service parity); validation and unknown-action cases belong to the retired service layer and are not carried. The request is the atom's HTTP fetch send; the reply is the composed fetch's answer.",
  "cases": [
    {
      "id": "get-icon-body-collection-missing",
      "steps": [
        {
          "event": "ICONIFY_GET_ICON_BODY",
          "payload": {
            "iconId": "nope:thing"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "ICONIFY_HTTP_SEND",
                "payload": {
                  "key": "body|nope:thing",
                  "method": "GET",
                  "target": "/nope.json?icons=thing",
                  "stream": "none"
                }
              }
            ]
          }
        },
        {
          "event": "ICONIFY_REPLIED",
          "payload": {
            "key": "body|nope:thing",
            "status": 404,
            "headers": {},
            "body": "eyJlcnJvciI6Im5vdCBmb3VuZCJ9"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "ICONIFY_ICON_BODY_RESULT",
                "payload": {
                  "body": null
                }
              }
            ]
          }
        }
      ]
    },
