{
  "atom": "connect/atoms/std-maps.lolo",
  "trait": "MapsClient",
  "note": "Converted from orbital-integration-tests fixtures/maps (service parity); validation and unknown-action cases belong to the retired service layer and are not carried. The request is the atom's HTTP fetch send; the reply is the composed fetch's answer.",
  "cases": [
    {
      "id": "distance-paris-london",
      "steps": [
        {
          "event": "DISTANCE",
          "payload": {
            "fromLat": 48.8566,
            "fromLng": 2.3522,
            "toLat": 51.5074,
            "toLng": -0.1278
          },
          "expect": {
            "state": "idle",
            "neverEmits": [
              "MAPS_HTTP_SEND"
            ],
            "emits": [
              {
                "event": "DISTANCE_COMPUTED",
                "payload": {
                  "distanceKm": 343.557
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "geocode-blank-address-sends-nothing",
      "steps": [
        {
          "event": "GEOCODE",
          "payload": {
            "address": "   "
          },
          "expect": {
            "state": "idle",
            "neverEmits": [
              "MAPS_HTTP_SEND"
            ]
          }
        }
      ]
    },
    {
      "id": "geocode-not-found",
      "steps": [
        {
          "event": "GEOCODE",
          "payload": {
            "address": "zzqqxxnotaplace"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "MAPS_HTTP_SEND",
                "payload": {
                  "key": "geocode",
                  "method": "GET",
                  "target": "/search?format=json&limit=1&q=zzqqxxnotaplace",
                  "stream": "none"
                }
              }
            ]
          }
        },
        {
          "event": "MAPS_REPLIED",
          "payload": {
            "key": "geocode",
            "status": 200,
            "headers": {},
            "body": "W10="
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "MAPS_FAILURE",
                "payload": {}
              }
            ]
          }
        }
      ]
    },
    {
      "id": "geocode",
      "steps": [
        {
          "event": "GEOCODE",
          "payload": {
            "address": "10 Downing Street, London"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "MAPS_HTTP_SEND",
                "payload": {
                  "key": "geocode",
                  "method": "GET",
                  "target": "/search?format=json&limit=1&q=10%20Downing%20Street%2C%20London",
                  "stream": "none"
                }
              }
            ]
          }
        },
        {
          "event": "MAPS_REPLIED",
          "payload": {
            "key": "geocode",
            "status": 200,
            "headers": {},
            "body": ""
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "GEOCODED",
                "payload": {
                  "lat": 51.5034878,
                  "lng": -0.1276965,
                  "formattedAddress": "10 Downing Street, 10, Downing Street, Westminster, Covent Garden, City of Westminster, Greater London, England, SW1A 2AA, United Kingdom"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "reverse-geocode",
      "steps": [
        {
          "event": "REVERSE_GEOCODE",
          "payload": {
            "lat": 51.5034878,
            "lng": -0.1276965
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "MAPS_HTTP_SEND",
                "payload": {
                  "key": "reverse",
                  "method": "GET",
                  "target": "/reverse?format=json&lat=51.5034878&lon=-0.1276965",
                  "stream": "none"
                }
              }
            ]
          }
        },
        {
          "event": "MAPS_REPLIED",
          "payload": {
            "key": "reverse",
            "status": 200,
            "headers": {},
            "body": ""
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "REVERSE_GEOCODED",
                "payload": {
                  "address": "10 Downing Street, 10, Downing Street, Westminster, Covent Garden, City of Westminster, Greater London, England, SW1A 2AA, United Kingdom",
                  "formattedAddress": "10 Downing Street, 10, Downing Street, Westminster, Covent Garden, City of Westminster, Greater London, England, SW1A 2AA, United Kingdom"
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
