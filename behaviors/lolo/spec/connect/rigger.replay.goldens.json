{
  "atom": "connect/atoms/std-rigger.lolo",
  "trait": "RiggerClient",
  "cases": [
    {
      "id": "build-mesh-error-with-a-body-that-is-not-json-reports-the-status-alone",
      "steps": [{
        "event": "RIGGER_REPLIED",
        "payload": { "key": "build_mesh", "status": 502, "headers": {}, "body": "QmFkIEdhdGV3YXk=" },
        "expect": {
          "emits": [{ "event": "RIGGER_BUILD_MESH_FAILED", "payload": { "message": "Rigger /mesh/build returned 502" } }]
        }
      }]
    },
    {
      "id": "build-mesh-error-with-a-string-detail-reports-it",
      "steps": [{
        "event": "RIGGER_REPLIED",
        "payload": { "key": "build_mesh", "status": 422, "headers": {}, "body": "eyJkZXRhaWwiOiJubyBza2VsZXRvbiJ9" },
        "expect": {
          "emits": [{ "event": "RIGGER_BUILD_MESH_FAILED", "payload": { "message": "Rigger /mesh/build returned 422: no skeleton" } }]
        }
      }]
    }
  ]
}
