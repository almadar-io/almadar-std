      },
      "rawBody": "{\"id\":\"evt_001\",\"object\":\"event\",\"type\":\"customer.subscription.updated\",\"data\":{\"object\":{\"id\":\"sub_123\",\"object\":\"subscription\",\"customer\":\"cus_456\",\"status\":\"active\",\"cancel_at_period_end\":true,\"metadata\":{\"almadarUid\":\"u1\"},\"items\":{\"data\":[{\"id\":\"si_1\",\"price\":{\"id\":\"price_789\"}}]}}}}"
     },
     "expect": {
      "state": "idle",
      "emits": [
