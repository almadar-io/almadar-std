{
 "atom": "connect/atoms/std-stripe.lolo",
 "trait": "StripeWebhook",
 "note": "std-stripe inbound webhook: Stripe's t=<unix>,v1=<hex> signature over <t>.<rawBody> is checked in .lolo with HMAC-SHA256 over the STRIPE_WEBHOOK_SECRET credential slot and a replay tolerance; an accepted subscription event is reported as STRIPE_SUBSCRIPTION_CHANGED, every call is answered exactly once.",
 "cases": [
  {
   "id": "a signed subscription update is accepted and reported",
   "now": 1700000000000,
   "credentials": {
    "STRIPE_WEBHOOK_SECRET": "whsec_test_secret"
   },
   "steps": [
    {
     "event": "STRIPE_WEBHOOK_CALLED",
     "payload": {
      "headers": {
       "stripe-signature": "t=1700000000,v1=f7665bdedf2c4913f0ec2c774fe8daee0ce6dac3721a2d24494b442021ef476f"
      },
      "rawBody": "{\"id\":\"evt_001\",\"object\":\"event\",\"type\":\"customer.subscription.updated\",\"data\":{\"object\":{\"id\":\"sub_123\",\"object\":\"subscription\",\"customer\":\"cus_456\",\"status\":\"past_due\",\"cancel_at_period_end\":true,\"metadata\":{\"almadarUid\":\"u1\"},\"items\":{\"data\":[{\"id\":\"si_1\",\"price\":{\"id\":\"price_789\"}}]}}}}"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "STRIPE_WEBHOOK_ANSWERED",
        "payload": {
         "status": 200,
         "body": "{\"received\":true}"
        }
       },
       {
        "event": "STRIPE_SUBSCRIPTION_CHANGED",
        "payload": {
         "eventId": "evt_001",
         "eventType": "customer.subscription.updated",
         "subscriptionId": "sub_123",
         "customerId": "cus_456",
         "status": "past_due",
         "priceId": "price_789",
         "cancelAtPeriodEnd": true,
         "metadata": {
          "almadarUid": "u1"
         }
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a signed event of another type is accepted and reports nothing more",
   "now": 1700000000000,
   "credentials": {
    "STRIPE_WEBHOOK_SECRET": "whsec_test_secret"
   },
   "steps": [
    {
     "event": "STRIPE_WEBHOOK_CALLED",
     "payload": {
      "headers": {
       "stripe-signature": "t=1700000000,v1=45a6be93454b221f3b13816f638d67031ef4859f293e8d3a95f06229f893102d"
      },
      "rawBody": "{\"id\":\"evt_002\",\"type\":\"invoice.paid\",\"data\":{\"object\":{\"id\":\"in_1\"}}}"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "STRIPE_WEBHOOK_ANSWERED",
        "payload": {
         "status": 200,
         "body": "{\"received\":true}"
        }
       }
      ],
      "neverEmits": [
       "STRIPE_SUBSCRIPTION_CHANGED"
      ]
     }
    }
   ]
  },
  {
   "id": "control: a body changed after signing is refused",
