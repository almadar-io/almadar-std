{
  "atom": "connect/atoms/std-microsoft-graph.lolo",
  "trait": "GraphClient",
  "note": "std-microsoft-graph over one keyed std-http-client trait: every call is a row of GraphCall under its own key; reads (key read:…) run under std-retry, writes (key write:…) are sent once. The answers here are canned Microsoft Graph bodies; no tenant was reached.",
  "cases": [
    {
      "id": "list-mail-with-no-query-reads-the-newest-inbox-messages",
      "steps": [
        {
          "event": "LIST_MAIL",
          "payload": {},
          "expect": {
            "emits": [
              {
                "event": "GRAPH_RETRY_START",
                "payload": {
                  "key": "read:mail:|20#1"
                }
              },
              {
                "event": "GRAPH_HTTP_SEND",
                "payload": {
                  "key": "read:mail:|20#1",
                  "method": "GET",
                  "target": "/v1.0/me/mailFolders/inbox/messages?$orderby=receivedDateTime%20desc&$top=20&$select=id,conversationId,subject,bodyPreview,receivedDateTime,internetMessageId,webLink,from,toRecipients,body",
                  "headers": [
                    {
                      "name": "accept",
                      "value": "application/json"
                    },
                    {
                      "name": "prefer",
                      "value": "outlook.body-content-type=\"text\""
                    }
                  ],
                  "body": "",
                  "stream": "none"
                }
              }
            ]
          }
        }
      ],
      "config": {},
      "defaults": [
        "GraphClient",
        "GraphCall",
        "GraphKeyed",
        "GraphHttp",
        "GraphRetry"
      ]
    },
