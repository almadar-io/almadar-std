{
  "atom": "connect/atoms/std-arxiv.lolo",
  "trait": "ArxivClient",
  "note": "Converted from orbital-integration-tests fixtures/arxiv (service parity); validation and unknown-action cases belong to the retired service layer and are not carried. The arXiv request writes every word as all:<word> joined with AND, which the older fixture url did not; the golden pins the atom. The request is the atom's HTTP fetch send; the reply is the composed fetch's answer.",
  "cases": [
    {
      "id": "search-blank-query-sends-nothing",
      "steps": [
        {
          "event": "ARXIV_SEARCH",
          "payload": {
            "query": "   "
          },
          "expect": {
            "state": "idle",
            "neverEmits": [
              "ARXIV_HTTP_SEND"
            ],
            "emits": [
              {
                "event": "ARXIV_SEARCH_RESULT",
                "payload": {
                  "results": []
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "search-empty-feed",
      "steps": [
        {
          "event": "ARXIV_SEARCH",
          "payload": {
            "query": "zzzzqqqq"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "ARXIV_HTTP_SEND",
                "payload": {
                  "key": "search",
                  "method": "GET",
                  "target": "/api/query?search_query=all%3Azzzzqqqq&start=0&max_results=8&sortBy=relevance",
                  "stream": "none"
                }
              }
            ]
          }
        },
        {
          "event": "ARXIV_SEARCH_REPLIED",
          "payload": {
            "key": "search",
            "status": 200,
            "headers": {},
            "body": "PD94bWwgdmVyc2lvbj0iMS4wIiBlbmNvZGluZz0iVVRGLTgiPz4KPGZlZWQgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDUvQXRvbSI+CiAgPGlkPmh0dHA6Ly9hcnhpdi5vcmcvYXBpL2ZlZWQ8L2lkPgogIDx0aXRsZT5BclhpdiBRdWVyeTwvdGl0bGU+CjwvZmVlZD4K"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "ARXIV_SEARCH_RESULT",
                "payload": {
                  "results": []
                }
              }
            ]
          }
        }
      ]
    },
