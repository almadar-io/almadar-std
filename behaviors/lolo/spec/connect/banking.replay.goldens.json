{
 "atom": "connect/atoms/std-banking.lolo",
 "trait": "BankingClient",
 "note": "std-banking over the composed std-http-client: the access token is a json-token grant (credential-connect) held by the host credential store and carried by the BankingHttp credential, never the event; a not-held token mints once and retries once; every failure answers BANKING_FAILED. Self-handled internal events (declared -> internal) are consumed by the trait and not listed, as in the firestore twin goldens.",
 "cases": [
  {
   "id": "a-requisition-with-a-reference-asks-the-http-client-for-one-json-post",
   "steps": [
    {
     "event": "BANKING_CREATE_REQUISITION",
     "payload": {
      "institutionId": "SANDBOXFINANCE_SFIN0000",
      "redirectUrl": "https://app.example/back",
      "reference": "ref-1"
     },
     "expect": {
      "state": "idle",
      "emits": [
       {
        "event": "BANKING_HTTP_SEND",
        "payload": {
         "key": "requisition",
         "method": "POST",
         "target": "/api/v2/requisitions/",
         "headers": [
          {
           "name": "accept",
           "value": "application/json"
          },
          {
           "name": "content-type",
           "value": "application/json"
          }
         ],
         "body": "eyJpbnN0aXR1dGlvbl9pZCI6IlNBTkRCT1hGSU5BTkNFX1NGSU4wMDAwIiwicmVkaXJlY3QiOiJodHRwczovL2FwcC5leGFtcGxlL2JhY2siLCJyZWZlcmVuY2UiOiJyZWYtMSJ9",
         "stream": "none"
        }
       }
      ]
     }
    }
   ],
   "config": {},
   "defaults": [
    "BankingHttp",
    "BankingTimeout"
   ]
  },
  {
