  {
   "id": "a-not-held-token-mints-once-through-the-json-token-grant",
   "steps": [
    {
     "event": "BANKING_LIST_ACCOUNTS",
     "payload": {
      "requisitionId": "r1"
     },
     "expect": {
      "state": "idle"
     }
    },
    {
     "event": "BANKING_HTTP_FAILED",
     "payload": {
      "error": "credential GOCARDLESS_ACCESS is not held",
      "kind": "unconfigured"
     },
     "expect": {
      "state": "idle",
      "effects": [
       {
        "type": "credential-connect",
        "arg0": {
         "credential": "@config.accessCredential",
         "scope": "app",
         "tokenEndpoint": "https://bankaccountdata.gocardless.com/api/v2/token/new/",
         "grant": "json-token",
         "clientId": "@config.secretIdCredential",
         "clientSecret": "@config.secretKeyCredential",
         "clientIdField": "secret_id",
         "clientSecretField": "secret_key",
         "accessField": "access",
         "refreshField": "refresh",
         "expiresInField": "access_expires",
         "refreshEndpoint": "https://bankaccountdata.gocardless.com/api/v2/token/refresh/",
         "refreshBodyField": "refresh"
        }
       }
      ]
     }
    }
   ],
   "config": {},
   "defaults": [
    "BankingHttp",
    "BankingTimeout"
   ]
  },
