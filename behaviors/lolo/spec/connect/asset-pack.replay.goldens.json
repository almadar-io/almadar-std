{
  "atom": "connect/atoms/std-asset-pack.lolo",
  "trait": "AssetPackLoader",
  "note": "Runs the real std-asset-pack loader with case-level config (assetPack kflow/x, transport http, three expected keys). no-pack-declared is covered by the atom default and has no case here.",
  "cases": [
    {
      "id": "loading-state",
      "steps": [
        {
          "event": "INIT",
          "payload": {},
          "from": "idle",
          "expect": {
            "state": "loading",
            "neverEmits": [
              "ASSET_PACK_MISSING",
              "ASSET_PACK_FAILED"
            ],
            "emits": [
              {
                "event": "PACK_HTTP_SEND",
                "payload": {
                  "key": "pack",
                  "method": "GET",
                  "target": "/shared/x/assets.json",
                  "stream": "none"
                }
              }
            ]
          }
        }
      ],
      "note": "INIT sets every expected key to a loading placeholder in assetByKey/assetManifest and asks the composed AssetPackFetch for the pack manifest (PACK_HTTP_SEND, key pack, GET packPath)",
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "load-answered",
      "steps": [
        {
          "event": "PACK_HTTP_REPLIED",
          "payload": {
            "status": 200,
            "body": "",
            "key": "pack",
            "headers": {}
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "PACK_TEXT",
                "payload": {
                  "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\", \"role\": \"npc\"}, {\"key\": \"units/b\", \"url\": \"/u/b.png\", \"role\": \"npc\"}, {\"key\": \"ui/c\", \"url\": \"/ui/c.png\", \"role\": \"ui\"}]}"
                }
              }
            ],
            "state": "loading"
          }
        },
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\", \"role\": \"npc\"}, {\"key\": \"units/b\", \"url\": \"/u/b.png\", \"role\": \"npc\"}, {\"key\": \"ui/c\", \"url\": \"/ui/c.png\", \"role\": \"ui\"}]}"
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 0
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 0
          },
          "expect": {
            "neverEmits": [
              "ASSET_PACK_MISSING"
            ],
            "state": "ready",
            "emits": [
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "ready"
                }
              }
            ]
          },
          "from": "reporting"
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "load-failed-http-404",
      "steps": [
        {
          "event": "PACK_HTTP_REPLIED",
          "payload": {
            "status": 404,
            "body": "bm9wZQ==",
            "key": "pack",
            "headers": {}
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "HTTP 404 or invalid JSON at /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              }
            ],
            "state": "failed"
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "missing-key",
      "note": "units/b is absent: reported once",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\", \"role\": \"npc\"}, {\"key\": \"ui/c\", \"url\": \"/ui/c.png\", \"role\": \"ui\"}]}"
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 0
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 0
          },
          "from": "reporting",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_MISSING",
                "payload": {
                  "pack": "kflow/x",
                  "key": "units/b"
                }
              },
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 1
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 1
          },
          "from": "reporting",
          "expect": {
            "neverEmits": [
              "ASSET_PACK_MISSING"
            ],
            "state": "ready",
            "emits": [
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "partial"
                }
              }
            ]
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "load-failed-network",
      "note": "every expected key is a placeholder and reported once",
      "steps": [
        {
          "event": "PACK_LOAD_FAILED",
          "payload": {
            "error": "boom",
            "kind": "network"
          },
          "from": "loading",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "boom"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              }
            ],
            "state": "failed"
          }
        },
        {
          "event": "ASSET_PACK_PUBLISH",
          "payload": {},
          "from": "failed",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 0
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 0
          },
          "from": "reporting",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_MISSING",
                "payload": {
                  "pack": "kflow/x",
                  "key": "units/a"
                }
              },
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 1
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 1
          },
          "from": "reporting",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_MISSING",
                "payload": {
                  "pack": "kflow/x",
                  "key": "units/b"
                }
              },
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 2
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 2
          },
          "from": "reporting",
          "expect": {
            "emits": [
              {
                "event": "ASSET_PACK_MISSING",
                "payload": {
                  "pack": "kflow/x",
                  "key": "ui/c"
                }
              },
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 3
                }
              }
            ],
            "state": "reporting"
          }
        },
        {
          "event": "ASSET_PACK_REPORT_NEXT",
          "payload": {
            "cursor": 3
          },
          "from": "reporting",
          "expect": {
            "neverEmits": [
              "ASSET_PACK_MISSING"
            ],
            "state": "ready",
            "emits": [
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "duplicate-key",
      "note": "two rows share units/a: the whole pack is refused",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\"}, {\"key\": \"units/a\", \"url\": \"/u/a2.png\"}]}"
          },
          "from": "loading",
          "expect": {
            "state": "failed",
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "duplicate asset key in /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              },
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "empty-key-row-is-refused-by-the-key-guard",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\"}, {\"key\": \"\", \"url\": \"/u/b.png\"}]}"
          },
          "from": "loading",
          "expect": {
            "state": "failed",
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "asset row without key in /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              },
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "note": "an empty key fits the type and is refused by the key guard",
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "good-rows-control-a-listed-style-loads",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\", \"style\": \"pixel\"}]}"
          },
          "from": "loading",
          "expect": {
            "state": "reporting",
            "emits": [
              {
                "event": "ASSET_PACK_REPORT_NEXT",
                "payload": {
                  "cursor": 0
                }
              }
            ]
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "bad-style-row-is-refused-by-the-parse",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\", \"style\": \"watercolor\"}]}"
          },
          "from": "loading",
          "expect": {
            "state": "failed",
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "invalid asset pack manifest in /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              },
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "note": "style is the Asset.style union: the typed parse answers null",
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "bad-row-missing-key-field-is-refused-by-the-parse",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": \"units/a\", \"url\": \"/u/a.png\"}, {\"url\": \"/u/b.png\"}]}"
          },
          "from": "loading",
          "expect": {
            "state": "failed",
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "invalid asset pack manifest in /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              },
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "note": "key is required in Asset",
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "bad-row-key-of-the-wrong-type-is-refused-by-the-parse",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": [{\"key\": 7, \"url\": \"/u/a.png\"}]}"
          },
          "from": "loading",
          "expect": {
            "state": "failed",
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "invalid asset pack manifest in /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              },
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    },
    {
      "id": "bad-manifest-without-a-base-is-refused-by-the-parse",
      "steps": [
        {
          "event": "PACK_TEXT",
          "payload": {
            "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"assets\": []}"
          },
          "from": "loading",
          "expect": {
            "state": "failed",
            "emits": [
              {
                "event": "ASSET_PACK_FAILED",
                "payload": {
                  "pack": "kflow/x",
                  "message": "invalid asset pack manifest in /shared/x/assets.json"
                }
              },
              {
                "event": "ASSET_PACK_PUBLISH",
                "payload": {}
              },
              {
                "event": "ASSET_PACK_SETTLED",
                "payload": {
                  "pack": "kflow/x",
                  "status": "failed"
                }
              }
            ]
          }
        }
      ],
      "config": {
        "assetPack": "kflow/x",
        "transport": "http",
        "packPath": "/shared/x/assets.json",
        "expectedKeys": [
          "units/a",
          "units/b",
          "ui/c"
        ]
      }
    }
  ]
}