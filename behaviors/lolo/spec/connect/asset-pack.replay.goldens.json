{
 "atom": "spec/connect/asset-pack.fixture.lolo",
 "trait": "AssetPack",
 "note": "Runs the loader through spec/connect/asset-pack.fixture.lolo (the runner does not apply per-case config). no-pack-declared is covered by the atom default and has no case here.",
 "cases": [
  {
   "id": "loading-state",
   "steps": [
    {
     "event": "INIT",
     "payload": {},
     "from": "idle",
     "expect": {
      "state": "loading",
      "neverEmits": [
       "ASSET_PACK_MISSING",
       "ASSET_PACK_FAILED"
      ]
     }
    }
   ],
   "note": "INIT issues (http GET origin packPath) and sets every expected key to a loading placeholder in assetByKey/assetManifest; the replay does not observe the effect args"
  },
  {
   "id": "load-answered",
   "steps": [
    {
     "event": "PACK_HTTP_REPLIED",
     "payload": {
      "status": 200,
      "body": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": {\"units/a\": {\"url\": \"/u/a.png\", \"role\": \"npc\"}, \"units/b\": {\"url\": \"/u/b.png\", \"role\": \"npc\"}, \"ui/c\": {\"url\": \"/ui/c.png\", \"role\": \"ui\"}}}"
     },
     "from": "loading",
     "expect": {
      "emits": [
       {
        "event": "PACK_TEXT",
        "payload": {
         "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": {\"units/a\": {\"url\": \"/u/a.png\", \"role\": \"npc\"}, \"units/b\": {\"url\": \"/u/b.png\", \"role\": \"npc\"}, \"ui/c\": {\"url\": \"/ui/c.png\", \"role\": \"ui\"}}}"
        }
       }
      ],
      "state": "loading"
     }
    },
    {
     "event": "PACK_TEXT",
     "payload": {
      "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": {\"units/a\": {\"url\": \"/u/a.png\", \"role\": \"npc\"}, \"units/b\": {\"url\": \"/u/b.png\", \"role\": \"npc\"}, \"ui/c\": {\"url\": \"/ui/c.png\", \"role\": \"ui\"}}}"
     },
     "from": "loading",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 0
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 0
     },
     "expect": {
      "neverEmits": [
       "ASSET_PACK_MISSING"
      ],
      "state": "ready",
      "emits": [
       {
        "event": "ASSET_PACK_SETTLED",
        "payload": {
         "pack": "kflow/x",
         "status": "ready"
        }
       }
      ]
     },
     "from": "reporting"
    }
   ]
  },
  {
   "id": "load-failed-http-404",
   "steps": [
    {
     "event": "PACK_HTTP_REPLIED",
     "payload": {
      "status": 404,
      "body": "nope"
     },
     "from": "loading",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_FAILED",
        "payload": {
         "pack": "kflow/x",
         "message": "HTTP 404 or invalid JSON at /shared/x/assets.json"
        }
       },
       {
        "event": "ASSET_PACK_PUBLISH",
        "payload": {}
       }
      ],
      "state": "failed"
     }
    }
   ]
  },
  {
   "id": "missing-key",
   "note": "units/b is absent: reported once",
   "steps": [
    {
     "event": "PACK_TEXT",
     "payload": {
      "text": "{\"pack\": \"kflow/x\", \"version\": 1, \"base\": \"https://h\", \"assets\": {\"units/a\": {\"url\": \"/u/a.png\", \"role\": \"npc\"}, \"ui/c\": {\"url\": \"/ui/c.png\", \"role\": \"ui\"}}}"
     },
     "from": "loading",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 0
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 0
     },
     "from": "reporting",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_MISSING",
        "payload": {
         "pack": "kflow/x",
         "key": "units/b"
        }
       },
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 1
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 1
     },
     "from": "reporting",
     "expect": {
      "neverEmits": [
       "ASSET_PACK_MISSING"
      ],
      "state": "ready",
      "emits": [
       {
        "event": "ASSET_PACK_SETTLED",
        "payload": {
         "pack": "kflow/x",
         "status": "partial"
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "load-failed-network",
   "note": "every expected key is a placeholder and reported once",
   "steps": [
    {
     "event": "PACK_LOAD_FAILED",
     "payload": {
      "error": "boom",
      "kind": "network"
     },
     "from": "loading",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_FAILED",
        "payload": {
         "pack": "kflow/x",
         "message": "boom"
        }
       },
       {
        "event": "ASSET_PACK_PUBLISH",
        "payload": {}
       }
      ],
      "state": "failed"
     }
    },
    {
     "event": "ASSET_PACK_PUBLISH",
     "payload": {},
     "from": "failed",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 0
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 0
     },
     "from": "reporting",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_MISSING",
        "payload": {
         "pack": "kflow/x",
         "key": "units/a"
        }
       },
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 1
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 1
     },
     "from": "reporting",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_MISSING",
        "payload": {
         "pack": "kflow/x",
         "key": "units/b"
        }
       },
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 2
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 2
     },
     "from": "reporting",
     "expect": {
      "emits": [
       {
        "event": "ASSET_PACK_MISSING",
        "payload": {
         "pack": "kflow/x",
         "key": "ui/c"
        }
       },
       {
        "event": "ASSET_PACK_REPORT_NEXT",
        "payload": {
         "cursor": 3
        }
       }
      ],
      "state": "reporting"
     }
    },
    {
     "event": "ASSET_PACK_REPORT_NEXT",
     "payload": {
      "cursor": 3
     },
     "from": "reporting",
     "expect": {
      "neverEmits": [
       "ASSET_PACK_MISSING"
      ],
      "state": "ready",
      "emits": [
       {
        "event": "ASSET_PACK_SETTLED",
        "payload": {
         "pack": "kflow/x",
         "status": "failed"
        }
       }
      ]
     }
    }
   ]
  }
 ]
}
