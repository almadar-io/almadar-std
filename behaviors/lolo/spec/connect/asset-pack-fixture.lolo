app asset-pack-fixture [
  version: "1.0.0",
  description: "Replay fixture for std-asset-pack: composes the loader with a declared pack and three expected keys so asset-pack.replay.goldens.json runs against real config.",
  egress: ["https://almadar-kflow-assets.web.app"]
]
orbital AssetPackFixtureOrbital {
  uses Pack from "std/behaviors/std-asset-pack"

  type PackAsset = {
    key : string!
    url : asset
    atlas : asset
    sprite : string
    role : string
    category : string
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric" | "lowpoly"
    fxKind : "slash" | "puff" | "heal" | "trap" | "burst"
    dimension : string
    aspect : string
    name : string
    thumbnailUrl : string
  }

  entity GameState [runtime, shared] {
    id : string!
    assetByKey : Map string PackAsset = {}
    assetManifest : Map string Map string PackAsset = {}
    assetPackStatus : string = "idle"
    assetPackMissing : [string] = []
    assetPackCursor : number = 0
  }

  trait AssetPack = Pack.traits.AssetPackLoader -> GameState {
    config {
      assetPack: "kflow/x"
      transport: "http"
      packPath: "/shared/x/assets.json"
      expectedKeys: ["units/a", "units/b", "ui/c"]
    }
  }

  page "/asset-pack-fixture" as AssetPackFixturePage -> AssetPack
}
