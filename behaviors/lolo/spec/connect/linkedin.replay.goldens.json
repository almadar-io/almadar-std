{
 "atom": "connect/atoms/std-linkedin.lolo",
 "trait": "LinkedinPublisher",
 "note": "std-linkedin over one keyed std-http-client (std-http-keyed): every post is a row of LinkedinCall under its own key; the access token is a refresh_token grant (credential-connect) the host credential store mints and renews, carried by the LinkedinHttp credential, never by an event; a not-held token mints once and sends again, a second not-held answer fails NOT_CONFIGURED. The post URN is read from the x-restli-id reply header. LinkedIn has no scheduling API, so none is exercised.",
 "cases": [
  {
   "id": "a-plain-post-builds-the-posts-api-body-for-its-row",
   "steps": [
    {
     "event": "PUBLISH_POST",
     "payload": {
      "author": "urn:li:organization:123",
      "text": "Hello LinkedIn"
     },
     "expect": {
      "emits": [
       {
        "event": "LINKEDIN_READY",
        "payload": {
         "key": "post#1",
         "callerKey": "",
         "hasKey": false,
         "version": "202405",
         "body": ""
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "LinkedinPublisher",
    "LinkedinCall",
    "LinkedinKeyed",
    "LinkedinHttp"
   ]
  },
  {
   "id": "control-a-member-author-is-accepted-too",
   "steps": [
    {
     "event": "PUBLISH_POST",
     "payload": {
      "author": "urn:li:person:abc",
      "text": "Hi"
     },
     "expect": {
      "emits": [
       {
        "event": "LINKEDIN_READY",
        "payload": {
         "key": "post#1",
         "callerKey": "",
         "hasKey": false,
         "version": "202405",
         "body": ""
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "LinkedinPublisher",
    "LinkedinCall",
    "LinkedinKeyed",
    "LinkedinHttp"
   ]
  },
