    {
      "id": "http-create-pr-asks-the-http-client-for-one-post",
      "config": {
        "owner": "o",
        "repo": "r"
      },
      "defaults": [
        "GithubHttp",
        "GithubTimeout"
      ],
      "steps": [
        {
          "event": "GITHUB_CREATE_PR",
          "payload": {
            "title": "t",
            "body": "b",
            "baseBranch": "main",
            "headBranch": "feat"
          },
          "expect": {
            "emits": [
              {
                "event": "GITHUB_HTTP_SEND",
                "payload": {
                  "key": "create-pr",
                  "method": "POST",
                  "target": "/repos/o/r/pulls"
                }
              }
            ]
          }
        }
      ]
    },
    {
      "id": "http-create-pr-client-that-cannot-open-answers-the-failure",
      "config": {
        "owner": "o",
        "repo": "r"
