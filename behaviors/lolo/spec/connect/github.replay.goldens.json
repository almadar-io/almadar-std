            "title": "t",
            "body": "b",
            "baseBranch": "main",
            "headBranch": "feat"
          },
          "expect": {
            "emits": [
              {
                "event": "HTTP_FAILED",
                "payload": {
                  "key": "create-pr",
                  "kind": "unsupported"
                }
              },
              {
                "event": "GITHUB_CREATE_PR_FAILED",
                "payload": {
                  "code": "NETWORK_ERROR",
                  "message": "GitHub API request failed: os/tcp-connect: no os host configured"
                }
              }
            ]
          }
        }
      ]
