{
  "atom": "connect/atoms/std-github.lolo",
  "trait": "GithubClient",
  "cases": [
    {
      "id": "graphql-valid-json-retains-the-response-text",
      "steps": [{
        "event": "GITHUB_GRAPHQL_REPLIED",
        "payload": { "status": 200, "body": "{\"data\":{\"organization\":null},\"errors\":[{\"message\":\"not found\"}]}" },
        "expect": {
          "emits": [{ "event": "GITHUB_GRAPHQL_ANSWERED", "payload": { "body": "{\"data\":{\"organization\":null},\"errors\":[{\"message\":\"not found\"}]}" } }],
          "neverEmits": ["GITHUB_GRAPHQL_FAILED"]
        }
      }]
    },
    {
      "id": "graphql-success-with-html-is-a-parse-failure",
      "steps": [{
        "event": "GITHUB_GRAPHQL_REPLIED",
        "payload": { "status": 200, "body": "<html>upstream unavailable</html>" },
        "expect": {
          "emits": [{ "event": "GITHUB_GRAPHQL_FAILED", "payload": { "status": 200, "code": "PARSE_ERROR", "message": "GitHub answered a GraphQL body that is not JSON" } }],
          "neverEmits": ["GITHUB_GRAPHQL_ANSWERED"]
        }
      }]
    },
    {
      "id": "graphql-html-auth-error-still-answers-failure",
      "steps": [{
        "event": "GITHUB_GRAPHQL_REPLIED",
        "payload": { "status": 401, "body": "<html>unauthorized</html>" },
        "expect": {
          "emits": [{ "event": "GITHUB_GRAPHQL_FAILED", "payload": { "status": 401, "code": "AUTH_ERROR" } }],
          "neverEmits": ["GITHUB_GRAPHQL_ANSWERED"]
        }
      }]
    }
  ]
}
