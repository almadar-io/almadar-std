{
 "atom": "connect/atoms/std-google-calendar.lolo",
 "trait": "CalendarCall",
 "cases": [
  {
   "id": "list-maps-timed-and-all-day-events",
   "steps": [
    {
     "event": "CALENDAR_REPLIED",
     "payload": {
      "status": 200,
      "body": "{\"items\":[{\"id\":\"a\",\"summary\":\"S\",\"start\":{\"dateTime\":\"2026-10-30T09:00:00Z\"},\"end\":{\"dateTime\":\"2026-10-30T10:00:00Z\"},\"status\":\"confirmed\",\"updated\":\"u\"},{\"id\":\"b\",\"summary\":\"AllDay\",\"start\":{\"date\":\"2026-10-31\"},\"end\":{\"date\":\"2026-11-01\"}}],\"nextSyncToken\":\"tok\"}",
      "key": "list"
     },
     "expect": {
      "emits": [
       {
        "event": "CALENDAR_EVENTS_LISTED",
        "payload": {
         "events": [
          {
           "id": "a",
           "summary": "S",
           "description": "",
           "location": "",
           "start": "2026-10-30T09:00:00Z",
           "end": "2026-10-30T10:00:00Z",
           "status": "confirmed",
           "updated": "u"
          },
          {
           "id": "b",
           "summary": "AllDay",
           "description": "",
           "location": "",
           "start": "2026-10-31",
           "end": "2026-11-01",
           "status": "",
           "updated": ""
          }
         ],
         "nextSyncToken": "tok"
        }
       }
      ]
     }
    }
   ],
   "defaults": [
    "CalendarClient",
    "CalendarKeyed",
    "CalendarHttp",
    "CalendarTimeout",
    "CalendarRetry"
   ]
  },
