    {
      "id": "the-clients-reply-for-the-spend-key-reaches-the-spend-route",
      "steps": [
        {
          "trait": "MetaAdsHttp",
          "event": "HC_READ",
          "from": "reading",
          "entity": {
            "key": "spend",
            "stage": "head",
            "stream": "none"
          },
          "payload": {
            "data": "SFRUUC8xLjEgMjAwIFgNCmNvbnRlbnQtbGVuZ3RoOiA4MA0KDQp7ImRhdGEiOlt7InNwZW5kIjoiMSIsImltcHJlc3Npb25zIjoiMiIsImNsaWNrcyI6IjMiLCJhY2NvdW50X2N1cnJlbmN5IjoiRVVSIn1dfQ==",
            "eof": false,
            "key": "read"
          },
          "expect": {
            "emits": [
              {
                "event": "HTTP_REPLIED",
                "payload": {
                  "key": "spend",
                  "status": 200
                }
              },
              {
                "event": "META_ADS_SPEND_RESULT",
                "payload": {
                  "spend": 1,
                  "currency": "EUR",
                  "impressions": 2,
                  "clicks": 3
                }
              }
            ],
            "neverEmits": [
              "META_ADS_CAMPAIGNS_RESULT",
              "META_ADS_FAILED"
            ]
          }
        }
      ],
      "config": {
        "defaultAccountId": "123"
      },
      "defaults": [
        "MetaAdsHttp"
      ]
    },
    {
      "id": "control-the-clients-reply-for-the-campaigns-key-reaches-the-campaigns-route-only",
