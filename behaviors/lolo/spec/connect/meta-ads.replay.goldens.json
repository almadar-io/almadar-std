{
  "atom": "connect/atoms/std-meta-ads.lolo",
  "trait": "MetaAdsClient",
  "note": "std-meta-ads over the composed std-http-client: each Graph call is one META_ADS_HTTP_SEND (the access token is the client's query credential access_token, never in an event), replies and failures return by call key, and every failure answers META_ADS_FAILED.",
  "cases": [
    {
      "id": "spend-request-is-one-get-on-the-insights-edge-with-the-range",
      "steps": [
        {
          "event": "META_ADS_GET_SPEND",
          "payload": {
            "accountId": "999",
            "since": "2024-01-01",
            "until": "2024-01-31"
          },
          "expect": {
            "state": "idle",
            "emits": [
              {
                "event": "META_ADS_HTTP_SEND",
                "payload": {
                  "key": "spend",
                  "method": "GET",
                  "target": "/v21.0/act_999/insights?fields=spend%2Cimpressions%2Cclicks%2Caccount_currency&time_range=%7B%22since%22%3A%222024-01-01%22%2C%22until%22%3A%222024-01-31%22%7D&level=account",
                  "headers": [
                    {
                      "name": "accept",
                      "value": "*/*"
                    }
                  ],
                  "body": "",
                  "stream": "none"
                }
              }
            ]
          }
        }
      ],
      "config": {
        "defaultAccountId": "123"
      },
      "defaults": [
        "MetaAdsHttp"
      ]
    },
    {
      "id": "control-spend-request-with-an-act-prefixed-id-does-not-double-the-prefix",
