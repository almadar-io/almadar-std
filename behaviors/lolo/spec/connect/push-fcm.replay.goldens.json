{
 "atom": "connect/atoms/std-push.lolo",
 "trait": "FcmClient",
 "note": "FCM HTTP v1 sending with a minted service-account token.",
 "cases": [
  {
   "id": "a-send-posts-the-http-v1-message-and-a-2xx-answers-ok",
   "config": {
    "fcmProject": "family-test"
   },
   "defaults": [
    "FcmHttp",
    "FcmHttpFrame"
   ],
   "steps": [
    {
     "event": "FCM_SEND",
     "payload": {
      "token": "tok-1",
      "title": "Mama",
      "body": "Hi",
      "url": "/"
     },
     "expect": {
      "emits": [
       {
        "event": "FCM_HTTP_SEND",
        "payload": {
         "key": "fcm",
         "method": "POST",
         "target": "/v1/projects/family-test/messages:send",
         "body": "eyJtZXNzYWdlIjp7InRva2VuIjoidG9rLTEiLCJub3RpZmljYXRpb24iOnsidGl0bGUiOiJNYW1hIiwiYm9keSI6IkhpIn0sImRhdGEiOnsidXJsIjoiLyJ9fX0="
        }
       }
      ]
     }
    },
    {
     "event": "FCM_REPLIED",
     "payload": {
      "status": 200,
      "body": ""
     },
     "expect": {
      "emits": [
       {
        "event": "FCM_SEND_RESULT",
        "payload": {
         "statusCode": 200,
         "ok": true,
         "expired": false
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-401-asks-the-credential-store-for-a-token-and-fails-with-its-reason-when-none-is-held",
   "config": {
    "fcmProject": "family-test"
   },
   "defaults": [
    "FcmHttp",
    "FcmHttpFrame"
   ],
   "steps": [
    {
     "event": "FCM_SEND",
     "payload": {
      "token": "tok-1",
      "title": "Mama",
      "body": "Hi",
      "url": "/"
     },
     "expect": {
      "emits": [
       {
        "event": "FCM_HTTP_SEND",
        "payload": {
         "key": "fcm",
         "method": "POST",
         "target": "/v1/projects/family-test/messages:send",
         "body": "eyJtZXNzYWdlIjp7InRva2VuIjoidG9rLTEiLCJub3RpZmljYXRpb24iOnsidGl0bGUiOiJNYW1hIiwiYm9keSI6IkhpIn0sImRhdGEiOnsidXJsIjoiLyJ9fX0="
        }
       }
      ]
     }
    },
    {
     "event": "FCM_REPLIED",
     "payload": {
      "status": 401,
      "body": ""
     },
     "expect": {
      "emits": [
       {
        "event": "FCM_SEND_FAILED",
        "payload": {
         "message": "The FCM access token could not be minted: this host holds no credential store that can connect"
        }
       }
      ],
      "neverEmits": [
       "FCM_HTTP_SEND"
      ]
     }
    }
   ]
  },
  {
