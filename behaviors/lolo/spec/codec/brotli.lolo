app brotli-spec [
  version: "1.0.0",
  description: "Crate-backed brotli compression. BROTLI answers BROTLI_ANSWERED { data, size, packed }. quality 0–11 and window 10–24 replace the former stored-block blockMax; defaults are quality 11 and window 22. Native crate vectors decode byte-equal through system brotli -d -c."
]

orbital BrotliSpec {
  expects entity BrotliRun [runtime] {
    id : string!
    size : number
    packed : number
    @invariant (>= @entity.size 0)
  }
  expects trait Brotli {
    state idle {
      BROTLI -> idle
    }
    emits {
      BROTLI_ANSWERED { data : bytes!  size : number!  packed : number! }
    }
  }
  expects page "/brotli" -> Brotli
}
