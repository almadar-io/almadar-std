{
 "atom": "codec/atoms/std-document-text.lolo",
 "trait": "DocumentText",
 "note": "the composed readers' answers (std-pdf-text's PDF_TEXT / PDF_NO_TEXT / PDF_FAILED, std-ocr's OCR_TEXT / OCR_NO_TEXT / OCR_FAILED, the os/read-file answer) are played as each step's event",
 "cases": [
  {
   "id": "a PDF path goes to the PDF text layer reader, matched case-insensitively",
   "steps": [
    {
     "trait": "DocumentText",
     "event": "DOC_TEXT_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "/s/A.PDF"
     },
     "entity": {
      "id": "d",
      "key": "",
      "path": ""
     },
     "expect": {
      "fired": true,
      "state": "pdf",
      "entity": {
       "key": "k1",
       "path": "/s/A.PDF"
      },
      "emits": [
       {
        "event": "DOC_PDF_REQUEST",
        "payload": {
         "key": "k1",
         "path": "/s/A.PDF"
        }
       }
      ],
      "neverEmits": [
       "DOC_OCR_REQUEST",
       "DOC_TEXT_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "an image path goes to OCR",
   "steps": [
    {
     "trait": "DocumentText",
     "event": "DOC_TEXT_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "/s/scan.Jpeg"
     },
     "entity": {
      "id": "d",
      "key": "",
      "path": ""
     },
     "expect": {
      "fired": true,
      "state": "ocr",
      "emits": [
       {
        "event": "DOC_OCR_REQUEST",
        "payload": {
         "key": "k1",
         "path": "/s/scan.Jpeg"
        }
       }
      ],
      "neverEmits": [
       "DOC_PDF_REQUEST",
       "DOC_TEXT_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "a text path is read as a file",
   "steps": [
    {
     "trait": "DocumentText",
     "event": "DOC_TEXT_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "notes/mail.EML"
     },
     "entity": {
      "id": "d",
      "key": "",
      "path": ""
     },
     "expect": {
      "fired": true,
      "state": "reading",
      "effects": [
       {
        "type": "os/read-file"
       }
      ],
      "neverEmits": [
       "DOC_PDF_REQUEST",
       "DOC_OCR_REQUEST",
       "DOC_TEXT_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "a path in no list answers doc_unsupported",
   "steps": [
    {
     "trait": "DocumentText",
     "event": "DOC_TEXT_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "/s/a.docx"
     },
     "entity": {
      "id": "d",
      "key": "",
      "path": ""
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "DOC_TEXT_FAILED",
        "payload": {
         "key": "k1",
         "error": "the file extension is in none of the pdf, image or text lists",
         "code": "doc_unsupported"
        }
       }
      ],
      "neverEmits": [
       "DOC_PDF_REQUEST",
       "DOC_OCR_REQUEST"
      ]
     }
    }
   ]
  },
  {
   "id": "control: a declared extension moves a path from unsupported to the text reader",
   "steps": [
    {
     "trait": "DocumentText",
     "event": "DOC_TEXT_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "a.docx"
