  {
   "id": "a PDF with a text layer answers its pages with method pdftotext",
   "steps": [
    {
     "trait": "DocumentText",
     "event": "DOC_PDF_TEXT",
     "from": "pdf",
     "payload": {
      "key": "k1",
      "pages": [
       {
        "page": 1,
        "text": "Hello page one\n"
       },
       {
        "page": 2,
        "text": "Second page here\n"
       }
      ]
     },
     "entity": {
      "id": "d",
      "key": "k1",
      "path": "/s/a.pdf"
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "DOC_TEXT",
        "payload": {
         "key": "k1",
