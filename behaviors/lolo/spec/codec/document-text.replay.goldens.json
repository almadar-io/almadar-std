     "entity": {
      "id": "d",
      "key": "",
      "path": ""
     },
     "expect": {
      "fired": true,
      "state": "reading",
      "neverEmits": [
       "DOC_TEXT_FAILED"
      ]
     }
    }
   ],
   "config": {
    "textExtensions": [
     ".docx"
    ]
   }
  },
