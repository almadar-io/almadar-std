          {
           "page": 1,
           "text": "Hello page one\n"
          },
          {
           "page": 2,
           "text": "Second page here\n"
          }
         ],
         "method": "pdftotext"
        }
       }
      ],
      "neverEmits": [
       "DOC_OCR_REQUEST"
      ]
     }
    }
   ]
