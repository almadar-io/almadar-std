{
 "atom": "codec/atoms/std-ocr.lolo",
 "trait": "OcrReader",
 "note": "host answers (os/mkdir, os/realpath, os/list-dir, os/write-file, os/remove, std-cli's CLI_DONE) are played as each step's event; stdout shapes taken from tesseract 5 on a two-page list file: pages joined by a form feed, no trailing form feed after the last page, the last page ends with a newline; a single image answers one page with no form feed",
 "cases": [
  {
   "id": "an image starts tesseract on the path with the default languages and waits",
   "steps": [
    {
     "trait": "OcrReader",
     "event": "OCR_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "/s/a.png"
     },
     "entity": {
      "id": "r",
      "key": "",
      "path": "",
      "prefix": "",
      "realDir": "",
      "cleanup": [],
      "cursor": 0,
      "failed": false,
      "error": "",
      "code": "",
      "recognized": ""
     },
     "expect": {
      "fired": true,
      "state": "recognizing",
      "emits": [
       {
        "event": "OCR_EXEC",
        "payload": {
         "stage": "k1",
         "argv": [
          "/s/a.png",
          "-",
          "-l",
          "slv+eng"
         ]
        }
       }
      ],
      "neverEmits": [
       "OCR_FAILED"
      ]
     }
    }
   ]
  },
  {
   "id": "control: the image extension is matched case-insensitively and the languages knob is used",
   "steps": [
    {
     "trait": "OcrReader",
     "event": "OCR_READ",
     "from": "ready",
     "payload": {
      "key": "k1",
      "path": "/s/SCAN.JPG"
     },
     "entity": {
      "id": "r",
      "key": "",
      "path": "",
      "prefix": "",
      "realDir": "",
      "cleanup": [],
      "cursor": 0,
      "failed": false,
      "error": "",
      "code": "",
      "recognized": ""
     },
     "expect": {
      "fired": true,
      "state": "recognizing",
      "emits": [
       {
        "event": "OCR_EXEC",
        "payload": {
         "stage": "k1",
         "argv": [
          "/s/SCAN.JPG",
          "-",
          "-l",
          "eng"
         ]
        }
       }
      ]
     }
    }
   ],
   "config": {
    "languages": "eng"
   }
  },
  {
   "id": "control: an image extension taken out of the knob is unsupported",
   "steps": [
    {
