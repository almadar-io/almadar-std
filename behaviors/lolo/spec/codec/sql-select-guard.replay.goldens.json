{
 "atom": "codec/atoms/std-sql-select-guard.lolo",
 "trait": "SqlSelectGuard",
 "source": "Mirrors the Rust tests of orbital-core base contract/sql_guard.rs and the postgres statement cases of orbital-compiler tests/host_effects_validation.rs.",
 "note": "Each case sends one SQL_GUARD_CHECK and pins the verdicts; reason texts are the Rust guard's.",
 "cases": [
  {
   "id": "a-select-with-a-trailing-semicolon-is-accepted",
   "steps": [
    {
     "trait": "SqlSelectGuard",
     "event": "SQL_GUARD_CHECK",
     "from": "ready",
     "payload": {
      "requestId": "r",
      "statements": [
       "SELECT 1;"
      ]
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "SQL_GUARD_CHECKED",
        "payload": {
         "requestId": "r",
         "results": [
          {
           "ok": true,
           "reason": ""
          }
         ]
        }
       }
      ]
     }
    }
   ]
  },
  {
   "id": "a-second-statement-is-refused",
   "steps": [
    {
     "trait": "SqlSelectGuard",
     "event": "SQL_GUARD_CHECK",
     "from": "ready",
     "payload": {
      "requestId": "r",
      "statements": [
       "SELECT 1; SELECT 2"
      ]
     },
     "expect": {
      "fired": true,
      "state": "ready",
      "emits": [
       {
        "event": "SQL_GUARD_CHECKED",
