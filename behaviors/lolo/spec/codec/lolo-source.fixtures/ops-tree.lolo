app ops-tree [
  version: "1.0.0",
  description: "Native renderers operator fixture: the tree family's pure operators on literal inputs, with edge cases."
]
type Cell = { x : number!, y : number! }
type Hit = { at : number!, path : string!, node : SExpr }
type Tree = string | boolean | number | [Tree]
orbital OpsOrbital {
  entity Ops [runtime] {
    id : string!
    idxA : [Hit] = []
    idxB : [Hit] = []
    idxC : [Hit] = []
    idxD : [string] = []
    idxE : [Hit] = []
    idxF : [Hit] = []
  }
  trait Probe -> Ops {
    initial: idle
    state idle {
      INIT -> idle
        (set @entity.idxA (object/get (let ((t : Tree ["do" ["emit" "A"] ["if" true ["emit" "B"]]])) (tree/index @t ["emit"])) "emit" []))
        (set @entity.idxB (object/get (let ((t : Tree ["do" ["emit" "A"] ["if" true ["emit" "B"]]])) (tree/index @t ["emit" "if"])) "if" []))
        (set @entity.idxC (object/get (let ((t : Tree ["do" ["emit" "A"] ["if" true ["emit" "B"]]])) (tree/index @t ["navigate"])) "navigate" []))
        (set @entity.idxD (object/keys (let ((t : Tree ["do" ["emit" "A"] ["if" true ["emit" "B"]]])) (tree/index @t ["emit" "if" "do"]))))
        (set @entity.idxE (object/get (let ((t : Tree ["do" ["emit" "A"] ["if" true ["emit" "B"]]])) (tree/index @t ["emit"] {objects: ["emit"]})) "emit" []))
        (set @entity.idxF (object/get (let ((t : Tree ["set" "count" 1])) (tree/index @t ["set"])) "set" []))
    }
  }
  page boot as OpsStart -> Probe
}
