app nth-raw [
  version: "1.0.0",
  description: "Fixture for the native source renderers: array/nth without a default, assigned to a nullable number field."
]
orbital Fx {
  entity Rec [runtime] {
    id : string!
    v : number? 
  }
  trait T -> Rec [client] {
    initial: idle
    state idle {
      INIT -> idle
      GO -> idle
        (set @entity.v (array/nth ?xs ?i))
        (emit DONE { v: @entity.v })
    }
    emits {
      DONE -> external { v : number? }
    }
    listens {
      GO { xs : [number]!  i : number! }
    }
  }
  page boot as FxStart -> T
}
