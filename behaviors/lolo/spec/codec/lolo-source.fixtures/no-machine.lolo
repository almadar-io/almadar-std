app no-machine [
  version: "1.0.0",
  description: "Fixture for the native source renderers: a trait with no states beyond its initial one and only an emit declaration, so the renderer handles an empty machine."
]
orbital Fx {
  entity Rec [runtime] {
    id : string!
  }
  trait Bare -> Rec [client] {
    initial: idle
    emits {
      DONE -> external { }
    }
  }
  page boot as FxStart -> Bare
}
