app ops-math [
  version: "1.0.0",
  description: "Native renderers operator fixture: the math family's pure operators on literal inputs, with edge cases."
]
orbital OpsOrbital {
  entity Ops [runtime] {
    id : string!
    absA : number = 0
    absB : number = 0
    absC : number = 0
    absD : number = 0
    acosA : number?
    acosB : number?
    acosC : number?
    acosD : number?
    appA : number = 0
    appB : number = 0
    appC : number = 0
    appD : number = 0
    asinA : number?
    asinB : number?
    asinC : number?
    atanA : number = 0
    atanB : number = 0
    atanC : number = 0
    at2A : number = 0
    at2B : number = 0
    at2C : number = 0
    at2D : number = 0
    ceilA : number = 0
    ceilB : number = 0
    ceilC : number = 0
    ceilD : number = 0
    clampA : number = 0
    clampB : number = 0
    clampC : number = 0
    clampD : number = 0
    cosA : number = 0
    cosB : number = 0
    cosC : number = 0
    degA : number = 0
    degB : number = 0
    degC : number = 0
    floorA : number = 0
    floorB : number = 0
    floorC : number = 0
    floorD : number = 0
    hypA : number = 0
    hypB : number = 0
    hypC : number = 0
    lerpA : number = 0
    lerpB : number = 0
    lerpC : number = 0
    lerpD : number = 0
    lnA : number?
    lnB : number?
    lnC : number?
    lnD : number?
    logA : number?
    logB : number?
    logC : number?
    logD : number?
    mapA : number = 0
    mapB : number = 0
    mapC : number = 0
    mapD : number = 0
    maxA : number = 0
    maxB : number = 0
    minA : number = 0
    minB : number = 0
    modA : number?
    modB : number?
    modC : number?
    modD : number?
    modE : number?
    powA : number?
    powB : number?
    powC : number?
    powD : number?
    powE : number?
    radA : number = 0
    radB : number = 0
    radC : number = 0
    roundA : number = 0
    roundB : number = 0
    roundC : number = 0
    roundD : number = 0
    roundE : number = 0
    roundF : number = 0
    signA : number = 0
    signB : number = 0
    signC : number = 0
    sinA : number = 0
    sinB : number = 0
    sinC : number = 0
    sqrtA : number?
    sqrtB : number?
    sqrtC : number?
    sqrtD : number?
    tanA : number = 0
    tanB : number = 0
    tanC : number = 0
    wrapA : number = 0
    wrapB : number = 0
    wrapC : number = 0
    wrapD : number = 0
    wrapE : number = 0
  }
  trait Probe -> Ops {
    initial: idle
    state idle {
      INIT -> idle
        (set @entity.absA (math/abs -3))
        (set @entity.absB (math/abs 0))
        (set @entity.absC (math/abs 2.5))
        (set @entity.absD (math/abs -0.5))
        (set @entity.acosA (math/acos 0.5))
        (set @entity.acosB (math/acos 1))
        (set @entity.acosC (math/acos 2))
        (set @entity.acosD (math/acos -1))
        (set @entity.appA (math/approach 10 20 3))
        (set @entity.appB (math/approach 10 5 3))
        (set @entity.appC (math/approach 10 12 5))
        (set @entity.appD (math/approach 10 10 3))
        (set @entity.asinA (math/asin 0.5))
        (set @entity.asinB (math/asin 0))
        (set @entity.asinC (math/asin 2))
        (set @entity.atanA (math/atan 1))
        (set @entity.atanB (math/atan 0))
        (set @entity.atanC (math/atan -1000000))
        (set @entity.at2A (math/atan2 1 1))
        (set @entity.at2B (math/atan2 0 -1))
        (set @entity.at2C (math/atan2 0 0))
        (set @entity.at2D (math/atan2 -1 0))
        (set @entity.ceilA (math/ceil 3.2))
        (set @entity.ceilB (math/ceil -3.2))
        (set @entity.ceilC (math/ceil 4))
        (set @entity.ceilD (math/ceil 0))
        (set @entity.clampA (math/clamp 150 0 100))
        (set @entity.clampB (math/clamp -5 0 100))
        (set @entity.clampC (math/clamp 50 0 100))
        (set @entity.clampD (math/clamp 5 10 0))
        (set @entity.cosA (math/cos 0))
        (set @entity.cosB (math/cos 3.141592653589793))
        (set @entity.cosC (math/cos 1))
        (set @entity.degA (math/deg-rad 180))
        (set @entity.degB (math/deg-rad 0))
        (set @entity.degC (math/deg-rad -90))
        (set @entity.floorA (math/floor 3.7))
        (set @entity.floorB (math/floor -3.2))
        (set @entity.floorC (math/floor 5))
        (set @entity.floorD (math/floor -0.5))
        (set @entity.hypA (math/hypot 3 4))
        (set @entity.hypB (math/hypot 0 0))
        (set @entity.hypC (math/hypot -5 12))
        (set @entity.lerpA (math/lerp 0 100 0.5))
        (set @entity.lerpB (math/lerp 10 20 0))
        (set @entity.lerpC (math/lerp 10 20 1.5))
        (set @entity.lerpD (math/lerp 10 20 -1))
        (set @entity.lnA (math/ln 2.718281828459045))
        (set @entity.lnB (math/ln 1))
        (set @entity.lnC (math/ln 0))
        (set @entity.lnD (math/ln -1))
        (set @entity.logA (math/log10 100))
        (set @entity.logB (math/log10 1))
        (set @entity.logC (math/log10 0))
        (set @entity.logD (math/log10 -10))
        (set @entity.mapA (math/map 5 0 10 0 100))
        (set @entity.mapB (math/map 15 0 10 0 100))
        (set @entity.mapC (math/map 5 0 0 0 100))
        (set @entity.mapD (math/map 0 -1 1 10 20))
        (set @entity.maxA (math/max 3 1 4))
        (set @entity.maxB (math/max -1 -2))
        (set @entity.minA (math/min 3 1 4))
        (set @entity.minB (math/min -1 -2))
        (set @entity.modA (math/mod 7 3))
        (set @entity.modB (math/mod -7 3))
        (set @entity.modC (math/mod 7 0))
        (set @entity.modD (math/mod 7.5 2))
        (set @entity.modE (math/mod 7 -3))
        (set @entity.powA (math/pow 2 8))
        (set @entity.powB (math/pow 2 -1))
        (set @entity.powC (math/pow 0 0))
        (set @entity.powD (math/pow -8 0.5))
        (set @entity.powE (math/pow 9 0.5))
        (set @entity.radA (math/rad-deg 3.141592653589793))
        (set @entity.radB (math/rad-deg 0))
        (set @entity.radC (math/rad-deg 1))
        (set @entity.roundA (math/round 3.456 2))
        (set @entity.roundB (math/round 2.5 0))
        (set @entity.roundC (math/round -2.5 0))
        (set @entity.roundD (math/round 1234.5678 -2))
        (set @entity.roundE (math/round 0.1 0))
        (set @entity.roundF (math/round 3.456 1))
        (set @entity.signA (math/sign -42))
        (set @entity.signB (math/sign 0))
        (set @entity.signC (math/sign 3.5))
        (set @entity.sinA (math/sin 0))
        (set @entity.sinB (math/sin 1.5707963267948966))
        (set @entity.sinC (math/sin -1))
        (set @entity.sqrtA (math/sqrt 16))
        (set @entity.sqrtB (math/sqrt 2))
        (set @entity.sqrtC (math/sqrt 0))
        (set @entity.sqrtD (math/sqrt -4))
        (set @entity.tanA (math/tan 0))
        (set @entity.tanB (math/tan 0.7853981633974483))
        (set @entity.tanC (math/tan -1))
        (set @entity.wrapA (math/wrap 15 0 10))
        (set @entity.wrapB (math/wrap -3 0 10))
        (set @entity.wrapC (math/wrap 5 0 10))
        (set @entity.wrapD (math/wrap 10 0 10))
        (set @entity.wrapE (math/wrap 5 3 3))
    }
  }
  page boot as OpsStart -> Probe
}
