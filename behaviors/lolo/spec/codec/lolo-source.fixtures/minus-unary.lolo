app minus-unary [
  version: "1.0.0",
  description: "Fixture for the native source renderers: the minus operator applied to a single operand (negation)."
]
orbital Fx {
  entity Rec [runtime] {
    id : string!
    v : number = 0
  }
  trait T -> Rec [client] {
    initial: idle
    state idle {
      INIT -> idle
      GO -> idle
        (set @entity.v (- ?a))
        (emit DONE { v: @entity.v })
    }
    emits {
      DONE -> external { v : number! }
    }
    listens {
      GO { a : number! }
    }
  }
  page boot as FxStart -> T
}
