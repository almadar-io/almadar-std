app ops-bare [
  version: "1.0.0",
  description: "Native renderers operator fixture: the bare family's pure operators on literal inputs, with edge cases."
]
type Pt = { x : number!, y : number! }
orbital OpsOrbital {
  entity Ops [runtime] {
    id : string!
    neA : boolean = false
    neB : boolean = false
    neC : boolean = false
    neD : boolean = false
    neE : boolean = false
    neF : boolean = false
    modA : number?
    modB : number?
    modC : number?
    modD : number?
    modE : number?
    mulA : number = 0
    mulB : number = 0
    mulC : number = 0
    mulD : number = 0
    mulE : number = 0
    addA : number = 0
    addB : number = 0
    addC : number = 0
    addD : number = 0
    subA : number = 0
    subB : number = 0
    subC : number = 0
    subD : number = 0
    divA : number?
    divB : number?
    divC : number?
    divD : number?
    divE : number?
    ltA : boolean = false
    ltB : boolean = false
    ltC : boolean = false
    ltD : boolean = false
    ltE : boolean = false
    ltF : boolean = false
    leA : boolean = false
    leB : boolean = false
    leC : boolean = false
    leD : boolean = false
    eqA : boolean = false
    eqB : boolean = false
    eqC : boolean = false
    eqD : boolean = false
    eqE : boolean = false
    eqF : boolean = false
    eqG : boolean = false
    eqH : boolean = false
    deqA : boolean = false
    deqB : boolean = false
    deqC : boolean = false
    deqD : boolean = false
    deqE : boolean = false
    gtA : boolean = false
    gtB : boolean = false
    gtC : boolean = false
    gtD : boolean = false
    gtE : boolean = false
    geA : boolean = false
    geB : boolean = false
    geC : boolean = false
    geD : boolean = false
    andA : boolean = false
    andB : boolean = false
    andC : boolean = false
    andD : boolean = false
    andE : boolean = false
    asA : Pt?
    asB : Pt?
    asC : Pt?
    asD : Pt?
    defA : string = ""
    defB : string = ""
    defC : string = ""
    defD : number = 0
    defE : number = 0
    defF : number = 0
    listA : [number] = []
    listB : [number] = []
    listC : [string] = []
    listD : [number] = []
    listE : [[number]] = []
    notA : boolean = false
    notB : boolean = false
    notC : boolean = false
    orA : boolean = false
    orB : boolean = false
    orC : boolean = false
    orD : boolean = false
    orE : boolean = false
  }
  trait Probe -> Ops {
    initial: idle
    state idle {
      INIT -> idle
        (set @entity.neA (!= 5 3))
        (set @entity.neB (!= 5 5))
        (set @entity.neC (!= "a" "b"))
        (set @entity.neD (!= "" ""))
        (set @entity.neE (!= [1 2] [1 2]))
        (set @entity.neF (!= true false))
        (set @entity.modA (% 10 3))
        (set @entity.modB (% -10 3))
        (set @entity.modC (% 10 0))
        (set @entity.modD (% 5.5 2))
        (set @entity.modE (% 10 -3))
        (set @entity.mulA (* 3 4))
        (set @entity.mulB (* 3 0))
        (set @entity.mulC (* -2 3.5))
        (set @entity.mulD (* 2 3 4))
        (set @entity.mulE (* 0.1 3))
        (set @entity.addA (+ 2 3))
        (set @entity.addB (+ -2 -3))
        (set @entity.addC (+ 0.1 0.2))
        (set @entity.addD (+ 1 2 3 4))
        (set @entity.subA (- 5))
        (set @entity.subB (- 5 8))
        (set @entity.subC (- 0))
        (set @entity.subD (- 0.5 0.25))
        (set @entity.divA (/ 10 2))
        (set @entity.divB (/ 1 3))
        (set @entity.divC (/ 1 0))
        (set @entity.divD (/ 0 5))
        (set @entity.divE (/ -7 2))
        (set @entity.ltA (< 3 5))
        (set @entity.ltB (< 5 5))
        (set @entity.ltC (< "a" "b"))
        (set @entity.ltD (< "b" "a"))
        (set @entity.ltE (< "" "a"))
        (set @entity.ltF (< "Z" "a"))
        (set @entity.leA (<= 5 5))
        (set @entity.leB (<= 6 5))
        (set @entity.leC (<= "a" "a"))
        (set @entity.leD (<= -1 0))
        (set @entity.eqA (= 5 5))
        (set @entity.eqB (= 5 6))
        (set @entity.eqC (= "a" "a"))
        (set @entity.eqD (= [1 2] [1 2]))
        (set @entity.eqE (= [1 2] [2 1]))
        (set @entity.eqF (= 1 1.0))
        (set @entity.eqG (= "" ""))
        (set @entity.eqH (= (list) (list)))
        (set @entity.deqA (== 5 5))
        (set @entity.deqB (== "a" "b"))
        (set @entity.deqC (== [1 [2]] [1 [2]]))
        (set @entity.deqD (== null null))
        (set @entity.deqE (== true true))
        (set @entity.gtA (> 5 3))
        (set @entity.gtB (> 3 5))
        (set @entity.gtC (> "b" "a"))
        (set @entity.gtD (> 5 5))
        (set @entity.gtE (> "é" "z"))
        (set @entity.geA (>= 5 5))
        (set @entity.geB (>= 4 5))
        (set @entity.geC (>= "b" "a"))
        (set @entity.geD (>= 0 -1))
        (set @entity.andA (and true true))
        (set @entity.andB (and true false))
        (set @entity.andC (and false true))
        (set @entity.andD (and true true true))
        (set @entity.andE (and true true false))
        (set @entity.asA (as {x: 1, y: 2} Pt))
        (set @entity.asB (as {x: 1} Pt))
        (set @entity.asC (as {x: 1, y: 2, z: 3} Pt))
        (set @entity.asD (as {x: "a", y: 2} Pt))
        (set @entity.defA (default null "N/A"))
        (set @entity.defB (default "set" "N/A"))
        (set @entity.defC (default "" "N/A"))
        (set @entity.defD (default 0 5))
        (set @entity.defE (default (/ 1 0) 7))
        (set @entity.defF (default (/ 6 3) 7))
        (set @entity.listA (list 1 2 3))
        (set @entity.listB (list))
        (set @entity.listC (list "a" "é" "😀"))
        (set @entity.listD (list 1))
        (set @entity.listE (list (list 1 2) (list) (list 3)))
        (set @entity.notA (not true))
        (set @entity.notB (not false))
        (set @entity.notC (not (= 1 2)))
        (set @entity.orA (or false true))
        (set @entity.orB (or false false))
        (set @entity.orC (or true false))
        (set @entity.orD (or false false true))
        (set @entity.orE (or false false false))
    }
  }
  page boot as OpsStart -> Probe
}
