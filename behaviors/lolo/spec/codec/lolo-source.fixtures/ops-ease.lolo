app ops-ease [
  version: "1.0.0",
  description: "Native renderers operator fixture: the ease family's pure operators on literal inputs, with edge cases."
]
orbital OpsOrbital {
  entity Ops [runtime] {
    id : string!
    applyA : number = 0
    applyB : number = 0
    applyC : number = 0
    applyD : number = 0
    applyE : number = 0
    applyF : number = 0
    applyG : number = 0
    applyN : number = 0
    applyO : number = 0
    applyP : number = 0
    applyQ : number = 0
    applyH : number = 0
    applyI : number = 0
    applyJ : number = 0
    applyK : number = 0
    applyL : number = 0
    applyM : number = 0
    applyR : number = 0
    applyS : number = 0
    applyT : number = 0
    applyU : number = 0
    applyV : number = 0
    applyW : number = 0
    ssA : number = 0
    ssB : number = 0
    ssC : number = 0
    ssD : number = 0
    ssE : number = 0
    ssF : number = 0
    ssG : number = 0
  }
  trait Probe -> Ops {
    initial: idle
    state idle {
      INIT -> idle
        (set @entity.applyA (ease/apply "in-quad" 0.5))
        (set @entity.applyB (ease/apply "linear" 0.3))
        (set @entity.applyC (ease/apply "out-quad" 0.5))
        (set @entity.applyD (ease/apply "in-out-quad" 0.25))
        (set @entity.applyE (ease/apply "in-cubic" 0.5))
        (set @entity.applyF (ease/apply "out-cubic" 0.5))
        (set @entity.applyG (ease/apply "in-out-cubic" 0.75))
        (set @entity.applyN (ease/apply "in-quad" 0))
        (set @entity.applyO (ease/apply "in-quad" 1))
        (set @entity.applyP (ease/apply "in-quad" 1.5))
        (set @entity.applyQ (ease/apply "in-quad" -0.5))
        (set @entity.applyH (ease/apply "elastic-out" 0.5))
        (set @entity.applyI (ease/apply "elastic-out" 0.25))
        (set @entity.applyJ (ease/apply "elastic-out" 0))
        (set @entity.applyK (ease/apply "elastic-out" 1))
        (set @entity.applyL (ease/apply "bounce-out" 0.5))
        (set @entity.applyM (ease/apply "bounce-out" 0.9))
        (set @entity.applyR (ease/apply "bounce-out" 0.2))
        (set @entity.applyS (ease/apply "in-sine" 0.5))
        (set @entity.applyT (ease/apply "" 0.5))
        (set @entity.applyU (ease/apply "in-out-cubic" 0.25))
        (set @entity.applyV (ease/apply "in-out-quad" 0.75))
        (set @entity.applyW (ease/apply "out-quad" 1.5))
        (set @entity.ssA (ease/smoothstep 0.5 0 1))
        (set @entity.ssB (ease/smoothstep 0 1 0.5))
        (set @entity.ssC (ease/smoothstep 0 1 -1))
        (set @entity.ssD (ease/smoothstep 0 1 2))
        (set @entity.ssE (ease/smoothstep 0 1 0.25))
        (set @entity.ssF (ease/smoothstep 1 1 1))
        (set @entity.ssG (ease/smoothstep 2 4 3))
    }
  }
  page boot as OpsStart -> Probe
}
