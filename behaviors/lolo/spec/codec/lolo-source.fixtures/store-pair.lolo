app store-pair [
  version: "1.0.0",
  description: "Fixture for the native renderers' typed ports: a trait that persists a row and fetches rows back through their success and failure routes, so a native store must answer what the kernel's store answers."
]

orbital StoreOrbital {
  entity Note [runtime] {
    id : string!
    text : string = ""
    kind : string = ""
    seen : number = 0
    last : string = ""
  }

  trait Notes -> Note {
    initial: idle

    state idle {
      INIT -> idle
      ADD -> idle
        (persist create Note { text: ?text, kind: ?kind } { emit: { success: ADDED, failure: ADD_FAILED } })
      ADDED -> idle
        (set @entity.last ?text)
        (fetch Note { filter: (= (object/get @entity "kind") "todo"), emit: { success: LOADED, failure: LOAD_FAILED } })
      LOADED -> idle
        (set @entity.seen (array/len ?data))
      ADD_FAILED -> idle
        (set @entity.last "failed")
      LOAD_FAILED -> idle
        (set @entity.last "load failed")
      EDIT -> idle
        (persist update Note { id: ?id, text: ?text } { emit: { success: EDITED, failure: EDIT_FAILED } })
      EDITED -> idle
        (set @entity.last (str/concat "edited " ?text))
      EDIT_FAILED -> idle
        (set @entity.last (str/concat "edit failed " ?error))
      DROP -> idle
        (persist delete Note ?id { emit: { success: DROPPED, failure: DROP_FAILED } })
      DROPPED -> idle
        (set @entity.last (str/concat "dropped " ?id))
        (fetch Note { emit: { success: LOADED, failure: LOAD_FAILED } })
      DROP_FAILED -> idle
        (set @entity.last (str/concat "drop failed " ?error))
    }

    listens {
      ADD { text : string!, kind : string! }
      ADDED { id : string!, text : string!, kind : string! }
      LOADED { data : [Note]!, totalCount : number! }
      ADD_FAILED { error : string! }
      LOAD_FAILED { error : string! }
      EDIT { id : string!, text : string! }
      EDITED { id : string!, text : string!, kind : string! }
      EDIT_FAILED { error : string!, code : string }
      DROP { id : string! }
      DROPPED { id : string!, deleted : boolean! }
      DROP_FAILED { error : string!, code : string }
    }
  }

  page boot as StoreStart -> Notes
}
