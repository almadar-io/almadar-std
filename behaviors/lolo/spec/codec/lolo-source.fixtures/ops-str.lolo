app ops-str [
  version: "1.0.0",
  description: "Native renderers operator fixture: the str family's pure operators on literal inputs, with edge cases."
]
orbital OpsOrbital {
  entity Ops [runtime] {
    id : string!
    camelA : string = ""
    camelB : string = ""
    camelC : string = ""
    capA : string = ""
    capB : string = ""
    capC : string = ""
    capD : string = ""
    catA : string = ""
    catB : string = ""
    catC : string = ""
    catD : string = ""
    catE : string = ""
    decA : string?
    decB : string?
    decC : string?
    decD : string?
    encA : string = ""
    encB : string = ""
    encC : string = ""
    encD : string = ""
    endA : boolean = false
    endB : boolean = false
    endC : boolean = false
    endD : boolean = false
    inclA : boolean = false
    inclB : boolean = false
    inclC : boolean = false
    inclD : boolean = false
    joinA : string = ""
    joinB : string = ""
    joinC : string = ""
    joinD : string = ""
    kebA : string = ""
    kebB : string = ""
    kebC : string = ""
    lenA : number = 0
    lenB : number = 0
    lenC : number = 0
    lenD : number = 0
    lenE : number = 0
    lowA : string = ""
    lowB : string = ""
    lowC : string = ""
    lowD : string = ""
    padeA : string = ""
    padeB : string = ""
    padeC : string = ""
    padeD : string = ""
    padsA : string = ""
    padsB : string = ""
    padsC : string = ""
    padsD : string = ""
    repA : string = ""
    repB : string = ""
    repC : string = ""
    repD : string = ""
    replA : string = ""
    replB : string = ""
    replC : string = ""
    replD : string = ""
    rpatA : string?
    rpatB : string?
    rpatC : string?
    rpatD : string?
    ralA : string = ""
    ralB : string = ""
    ralC : string = ""
    ralD : string = ""
    revA : string = ""
    revB : string = ""
    revC : string = ""
    revD : string = ""
    sliceA : string = ""
    sliceB : string = ""
    sliceC : string = ""
    sliceD : string = ""
    sliceE : string = ""
    sliceF : string = ""
    snakeA : string = ""
    snakeB : string = ""
    snakeC : string = ""
    splitA : [string] = []
    splitB : [string] = []
    splitC : [string] = []
    splitD : [string] = []
    splitE : [string] = []
    startA : boolean = false
    startB : boolean = false
    startC : boolean = false
    startD : boolean = false
    tmplA : string = ""
    tmplB : string = ""
    tmplC : string = ""
    tmplD : string = ""
    titleA : string = ""
    titleB : string = ""
    titleC : string = ""
    toiA : number?
    toiB : number?
    toiC : number?
    toiD : number?
    toiE : number?
    tonA : number?
    tonB : number?
    tonC : number?
    tonD : number?
    tonE : number?
    trimA : string = ""
    trimB : string = ""
    trimC : string = ""
    trimD : string = ""
    trimeA : string = ""
    trimeB : string = ""
    trimeC : string = ""
    trimsA : string = ""
    trimsB : string = ""
    trimsC : string = ""
    truncA : string = ""
    truncB : string = ""
    truncC : string = ""
    truncD : string = ""
    truncE : string = ""
    upA : string = ""
    upB : string = ""
    upC : string = ""
    upD : string = ""
    uriA : boolean = false
    uriB : boolean = false
    uriC : boolean = false
    uriD : boolean = false
  }
  trait Probe -> Ops {
    initial: idle
    state idle {
      INIT -> idle
        (set @entity.camelA (str/camelCase "hello world"))
        (set @entity.camelB (str/camelCase ""))
        (set @entity.camelC (str/camelCase "Foo-bar_baz qux"))
        (set @entity.capA (str/capitalize "hello"))
        (set @entity.capB (str/capitalize ""))
        (set @entity.capC (str/capitalize "éclair"))
        (set @entity.capD (str/capitalize "HELLO"))
        (set @entity.catA (str/concat "Hello" " " "World"))
        (set @entity.catB (str/concat "n=" 42 " ok=" true))
        (set @entity.catC (str/concat "" ""))
        (set @entity.catD (str/concat "é" "😀"))
        (set @entity.catE (str/concat "x" 1.5 -0.25))
        (set @entity.decA (str/decode-uri-component "a%20b%26c"))
        (set @entity.decB (str/decode-uri-component ""))
        (set @entity.decC (str/decode-uri-component "%"))
        (set @entity.decD (str/decode-uri-component "%C3%A9%F0%9F%98%80"))
        (set @entity.encA (str/encode-uri-component "a b&c"))
        (set @entity.encB (str/encode-uri-component ""))
        (set @entity.encC (str/encode-uri-component "é😀"))
        (set @entity.encD (str/encode-uri-component "A-Za-z0-9-_.!~*'()"))
        (set @entity.endA (str/endsWith "hello" "lo"))
        (set @entity.endB (str/endsWith "hello" ""))
        (set @entity.endC (str/endsWith "" "a"))
        (set @entity.endD (str/endsWith "hello" "hello!"))
        (set @entity.inclA (str/includes "hello world" "world"))
        (set @entity.inclB (str/includes "hello" ""))
        (set @entity.inclC (str/includes "" "a"))
        (set @entity.inclD (str/includes "Hello" "hello"))
        (set @entity.joinA (str/join ["a" "b" "c"] ", "))
        (set @entity.joinB (str/join [] ","))
        (set @entity.joinC (str/join ["x"] "-"))
        (set @entity.joinD (str/join [1 2.5 3] "+"))
        (set @entity.kebA (str/kebabCase "Hello World"))
        (set @entity.kebB (str/kebabCase ""))
        (set @entity.kebC (str/kebabCase "fooBarBaz_qux"))
        (set @entity.lenA (str/len "hello"))
        (set @entity.lenB (str/len ""))
        (set @entity.lenC (str/len "é"))
        (set @entity.lenD (str/len "😀"))
        (set @entity.lenE (str/len "a😀b"))
        (set @entity.lowA (str/lower "HELLO"))
        (set @entity.lowB (str/lower ""))
        (set @entity.lowC (str/lower "ÉCLAIR"))
        (set @entity.lowD (str/lower "Mixed 123"))
        (set @entity.padeA (str/padEnd "5" 3 "0"))
        (set @entity.padeB (str/padEnd "hello" 3 "0"))
        (set @entity.padeC (str/padEnd "" 2 "a"))
        (set @entity.padeD (str/padEnd "é" 3 "x"))
        (set @entity.padsA (str/padStart "5" 3 "0"))
        (set @entity.padsB (str/padStart "hello" 3 "0"))
        (set @entity.padsC (str/padStart "x" 6 "a"))
        (set @entity.padsD (str/padStart "é" 3 "😀"))
        (set @entity.repA (str/repeat "ab" 3))
        (set @entity.repB (str/repeat "ab" 0))
        (set @entity.repC (str/repeat "" 5))
        (set @entity.repD (str/repeat "é" 2))
        (set @entity.replA (str/replace "hello world" "world" "there"))
        (set @entity.replB (str/replace "a-b-a" "a" "x"))
        (set @entity.replC (str/replace "abc" "z" "y"))
        (set @entity.replD (str/replace "abc" "" "-"))
        (set @entity.rpatA (str/replace-pattern "a1, b2!" "[^\\p{L}\\p{N}]" ""))
        (set @entity.rpatB (str/replace-pattern "abc" "(" "x"))
        (set @entity.rpatC (str/replace-pattern "a  b   c" "\\s+" " "))
        (set @entity.rpatD (str/replace-pattern "" "a*" "x"))
        (set @entity.ralA (str/replaceAll "a-b-c" "-" "_"))
        (set @entity.ralB (str/replaceAll "aaa" "aa" "b"))
        (set @entity.ralC (str/replaceAll "abc" "" "-"))
        (set @entity.ralD (str/replaceAll "" "a" "b"))
        (set @entity.revA (str/reverse "hello"))
        (set @entity.revB (str/reverse ""))
        (set @entity.revC (str/reverse "a😀b"))
        (set @entity.revD (str/reverse "éa"))
        (set @entity.sliceA (str/slice "hello" 1 4))
        (set @entity.sliceB (str/slice "hello" 0 0))
        (set @entity.sliceC (str/slice "hello" 3 100))
        (set @entity.sliceD (str/slice "hello" -2 5))
        (set @entity.sliceE (str/slice "hello" 4 2))
        (set @entity.sliceF (str/slice "a😀b" 1 2))
        (set @entity.snakeA (str/snakeCase "Hello World"))
        (set @entity.snakeB (str/snakeCase ""))
        (set @entity.snakeC (str/snakeCase "fooBar-baz"))
        (set @entity.splitA (str/split "a,b,c" ","))
        (set @entity.splitB (str/split "" ","))
        (set @entity.splitC (str/split "abc" ""))
        (set @entity.splitD (str/split "a,,b," ","))
        (set @entity.splitE (str/split "a😀b" ""))
        (set @entity.startA (str/startsWith "hello" "hel"))
        (set @entity.startB (str/startsWith "hello" ""))
        (set @entity.startC (str/startsWith "" "a"))
        (set @entity.startD (str/startsWith "hello" "Hel"))
        (set @entity.tmplA (str/template "Hello, {{name}}!" {name: "World"}))
        (set @entity.tmplB (str/template "no vars" {name: "x"}))
        (set @entity.tmplC (str/template "{{a}}{{b}}" {a: 1, b: true}))
        (set @entity.tmplD (str/template "{{missing}}" {a: 1}))
        (set @entity.titleA (str/titleCase "hello world"))
        (set @entity.titleB (str/titleCase ""))
        (set @entity.titleC (str/titleCase "fOO bAR-baz"))
        (set @entity.toiA (str/to-int "-42"))
        (set @entity.toiB (str/to-int ""))
        (set @entity.toiC (str/to-int "3.7"))
        (set @entity.toiD (str/to-int "abc"))
        (set @entity.toiE (str/to-int " 12 "))
        (set @entity.tonA (str/to-number "0x10"))
        (set @entity.tonB (str/to-number "3.5"))
        (set @entity.tonC (str/to-number ""))
        (set @entity.tonD (str/to-number "1e3"))
        (set @entity.tonE (str/to-number "abc"))
        (set @entity.trimA (str/trim " hello "))
        (set @entity.trimB (str/trim ""))
        (set @entity.trimC (str/trim "  \t\n x \n"))
        (set @entity.trimD (str/trim " é "))
        (set @entity.trimeA (str/trimEnd "hello "))
        (set @entity.trimeB (str/trimEnd ""))
        (set @entity.trimeC (str/trimEnd " a b  "))
        (set @entity.trimsA (str/trimStart " hello"))
        (set @entity.trimsB (str/trimStart ""))
        (set @entity.trimsC (str/trimStart "  a b "))
        (set @entity.truncA (str/truncate "Hello World" 8 "..."))
        (set @entity.truncB (str/truncate "Hi" 8 "..."))
        (set @entity.truncC (str/truncate "Hello" 5 "..."))
        (set @entity.truncD (str/truncate "Hello World" 2 "..."))
        (set @entity.truncE (str/truncate "" 0 ""))
        (set @entity.upA (str/upper "hello"))
        (set @entity.upB (str/upper ""))
        (set @entity.upC (str/upper "éclair"))
        (set @entity.upD (str/upper "straße"))
        (set @entity.uriA (str/uri-component-valid "a%20b"))
        (set @entity.uriB (str/uri-component-valid "%"))
        (set @entity.uriC (str/uri-component-valid ""))
        (set @entity.uriD (str/uri-component-valid "%C3%A9"))
    }
  }
  page boot as OpsStart -> Probe
}
