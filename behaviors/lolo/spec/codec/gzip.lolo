app gzip-spec [
  version: "1.0.0",
  description: "Crate-backed flate2 gzip. GZIP answers GZIP_ANSWERED { data, size, crc }. GUNZIP checks all concatenated members, with an explicit maxBytes cap from the request or configuration, and answers GUNZIP_ANSWERED { data, size, crc } or GZIP_REFUSED. All original refusal codes remain, with output-limit added. Compression uses level 0–9 (default 6) in place of the former chain bound; data vectors come from the native crate and decode byte-equal through system gzip -dc."
]

orbital GzipSpec {
  expects entity GzipRun [runtime] {
    id : string!
    size : number
    crc : number
    @invariant (>= @entity.size 0)
  }
  expects trait Gunzip {
    state idle {
      GUNZIP -> idle
      GZIP -> idle
    }
    emits {
      GUNZIP_ANSWERED { data : bytes!  size : number!  crc : number! }
      GZIP_ANSWERED { data : bytes!  size : number!  crc : number! }
      GZIP_REFUSED { reason : string! }
    }
  }
  expects page boot -> Gunzip
}
