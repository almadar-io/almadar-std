{
  "atom": "codec/lolo-source.fixtures/compose-pair.lolo",
  "trait": "Arena",
  "orbital": "ArenaOrbital",
  "note": "kernel answers for the composed-mode fixture: a local trait's emit drives a composed std atom with call-site config; each step's ordered emits and its trait's row",
  "cases": [
    {
      "id": "compose-pair",
      "steps": [
        {
          "trait": "Arena",
          "event": "INIT",
          "payload": {},
          "expect": {
            "exactEmits": [],
            "entity": {}
          }
        },
        {
          "trait": "Score",
          "event": "INIT",
          "payload": {},
          "expect": {
            "exactEmits": [],
            "entity": {
              "score": 0,
              "scoreBaseline": 3
            }
          }
        },
        {
          "trait": "Arena",
          "event": "HIT",
          "payload": {
            "n": 1
          },
          "expect": {
            "exactEmits": [
              {
                "event": "WAVE",
                "payload": {
                  "enemiesAlive": 2,
                  "playersAlive": 1
                }
              }
            ],
            "entity": {
              "enemies": 2
            }
          }
        },
        {
          "trait": "Arena",
          "event": "HIT",
          "payload": {
            "n": 2
          },
          "expect": {
            "exactEmits": [
              {
                "event": "WAVE",
                "payload": {
                  "enemiesAlive": 0,
                  "playersAlive": 1
                }
              }
            ],
            "entity": {
              "enemies": 0
            }
          }
        },
        {
          "trait": "Score",
          "event": "UNITS_CHANGED",
          "payload": {
            "enemiesAlive": 0,
            "playersAlive": 1
          },
          "expect": {
            "exactEmits": [],
            "entity": {
              "score": 15,
              "scoreBaseline": 0
            }
          }
        }
      ]
    }
  ]
}
