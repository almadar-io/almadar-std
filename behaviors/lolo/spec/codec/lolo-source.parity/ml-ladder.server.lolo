app ml-ladder-example [
  version: "1.0.0",
  net: { "127.0.0.1:4999": [listen] }
]
uses Server from "std/behaviors/std-http-server"
uses Ladder from "std/behaviors/std-ml-ladder"

orbital HttpServerOrbital = Server.orbitals.HttpServerOrbital {
  config {
    host: "127.0.0.1"
    port: 4999
    portFromEnv: false
  }
}
orbital MlLadderOrbital = Ladder.orbitals.MlLadderOrbital {}
