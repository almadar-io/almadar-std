{
 "atom": "codec/lolo-source.parity/agent-step.lolo",
 "trait": "Loop",
 "cases": [
  {
   "id": "agent-step",
   "steps": [
    {
     "event": "TOOL_CHOSEN",
     "payload": {
      "name": "s",
      "input": "q"
     },
     "expect": {
      "emits": [
       {
        "event": "CALL_TOOL",
        "payload": {
         "name": "s",
         "input": "q"
        }
       }
      ]
     }
    },
    {
     "event": "TOOL_RESULT",
     "payload": {
      "output": "o"
     },
     "expect": {
      "emits": [
       {
        "event": "OBSERVED",
        "payload": {
         "output": "o"
        }
       }
      ]
     }
    },
    {
     "event": "FINAL",
     "payload": {
      "text": "done"
     },
     "expect": {
      "emits": [
       {
        "event": "ANSWERED",
        "payload": {
         "answer": "done"
        }
       }
      ]
     }
    }
   ]
  }
 ],
 "note": "kernel answers for the course example; lolo-source-parity.sh compares each shell run to these emits"
}