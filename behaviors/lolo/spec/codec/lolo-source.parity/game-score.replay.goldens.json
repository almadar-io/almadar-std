{
  "atom": "../ui/game/atoms/std-score.lolo",
  "trait": "ScoreKeeper",
  "orbital": "ScoreOrbital",
  "note": "kernel answers for std-score rendered live from its atom; lolo-source-parity.sh compares each shell run's row after every step to these entity rows",
  "cases": [
    {
      "id": "game-score",
      "config": { "pointsPerKill": 7, "startScore": 2, "initialEnemies": 4 },
      "entity": { "id": "1" },
      "steps": [
        { "from": "active", "event": "INIT", "payload": {}, "expect": { "emits": [], "entity": { "id": "1", "score": 2, "scoreBaseline": 4 } } },
        { "from": "active", "event": "UNITS_CHANGED", "payload": { "enemiesAlive": 2 }, "expect": { "emits": [], "entity": { "id": "1", "score": 16, "scoreBaseline": 2 } } },
        { "from": "active", "event": "UNITS_CHANGED", "payload": { "enemiesAlive": 2 }, "expect": { "emits": [], "entity": { "id": "1", "score": 16, "scoreBaseline": 2 } } },
        { "from": "active", "event": "UNITS_CHANGED", "payload": { "playersAlive": 1 }, "expect": { "emits": [], "entity": { "id": "1", "score": 16, "scoreBaseline": 2 } } },
        { "from": "active", "event": "UNITS_CHANGED", "payload": { "enemiesAlive": 5 }, "expect": { "emits": [], "entity": { "id": "1", "score": 16, "scoreBaseline": 5 } } },
        { "from": "active", "event": "UNITS_CHANGED", "payload": { "enemiesAlive": 0 }, "expect": { "emits": [], "entity": { "id": "1", "score": 51, "scoreBaseline": 0 } } }
      ]
    }
  ]
}
