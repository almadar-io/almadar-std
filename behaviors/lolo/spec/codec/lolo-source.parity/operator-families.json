{
  "note": "The native renderers' operator scope (owner ruling 2026-11-08). Every pure operator of the installed operator table whose namespace is in `inScope`, or that is listed in `inScopeBare`, must have a template in every language atom (lolo-source-parity.py coverage). `structural` operators are rendered by std-lolo-source's fold itself. An excluded family stays a named unsupported render with the reason given here.",
  "inScope": [
    "array",
    "str",
    "math",
    "object",
    "validate",
    "time",
    "format",
    "vec",
    "grid",
    "geo",
    "prob",
    "bit",
    "json",
    "base64",
    "path",
    "tree",
    "noise",
    "ease",
    "anim"
  ],
  "inScopeBare": [
    "!=",
    "%",
    "*",
    "+",
    "-",
    "/",
    "<",
    "<=",
    "=",
    "==",
    ">",
    ">=",
    "and",
    "as",
    "default",
    "list",
    "not",
    "or"
  ],
  "structural": [
    "do",
    "fn",
    "if",
    "let",
    "when"
  ],
  "excluded": {
    "crypto and codecs, a native library per language waits on a dependency ruling": [
      "hash",
      "hmac",
      "ecdsa",
      "ecdh",
      "ed25519",
      "rsa",
      "rsa-pss",
      "aes-gcm",
      "gzip",
      "brotli",
      "xml",
      "yaml",
      "csv",
      "tar",
      "jws",
      "bytes"
    ],
    "kernel introspection, a standalone program has no kernel to answer": [
      "behavior",
      "workspace",
      "session",
      "kernel",
      "mem",
      "llm",
      "credential",
      "row",
      "i18n",
      "value",
      "os"
    ]
  },
  "excludedBare": {
    "program metaprogramming, the native program is already lowered": [
      "path",
      "quasiquote",
      "quote",
      "unquote"
    ]
  },
  "excludedOps": {
    "collation, the ICU4X CLDR collator needs a native library per language and waits on a dependency ruling": [
      "str/collate",
      "str/collate-key"
    ]
  }
}
