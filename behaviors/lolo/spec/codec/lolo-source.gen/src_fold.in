(fn (n k)
  (let ((nullR : SrcRender REC{ expr => @config.nullLit ## stmt => [@config.nullLit] ## body => @config.nullLit ## params => [] ## items => [] ## keys => [] ## stmts => [] ## pairVals => [] ## warns => [] ## uses => [] })
        (none : [string] [])
        (noneL : [[string]] [])
        (term : string @config.terminator)
        (at (str/slice "x@" 1 2))
        (typed : boolean @entity.typed))
    (if (= @n null)
      REC{ expr => @config.nullLit ## stmt => [(str/concat @config.nullLit @term)] }
    (if (validate/array @n)
      (let ((h0 (array/nth @n 0))
            (argc (- (array/len @n) 1))
            (hd : string (if (validate/string @h0) @h0 "")))
        (let ((isCall (and (!= @hd "")
                           (or (array/includes @entity.operatorNames @hd) (array/includes ["match", "invoke"] @hd)))))
          (let ((rs : [SrcRender] (if @typed
                      (array/map (array/range 0 (array/len @n)) (fn i
                        (let ((rr : SrcRender (default (array/nth @k @i) @nullR))
                              (sg (if (not @isCall) (str/concat "[" @i "]")
                                    (if (or (= @hd "let") (= @hd "fn")) (if (>= @i 2) (str/concat ".body[" (- @i 2) "]") (str/concat "[" @i "]"))
                                      (if (= @hd "if") (if (= @i 2) ".then" (if (= @i 3) ".else" (str/concat "[" @i "]")))
                                        (if (= @hd "when") (if (>= @i 2) (str/concat ".then[" (- @i 2) "]") (str/concat "[" @i "]"))
                                          (if (= @hd "do") (if (>= @i 1) (str/concat ".do[" (- @i 1) "]") (str/concat "[" @i "]"))
                                            (str/concat "[" @i "]"))))))))
                          (let ((m (str/concat "" @sg)))
                            REC{ expr => (str/replaceAll (object/get @rr "expr") "" @m) ## stmt => (array/map (object/get @rr "stmt") (fn l (str/replaceAll @l "" @m))) ## params => (object/get @rr "params") ## body => (str/replaceAll (object/get @rr "body") "" @m) ## items => (array/map (object/get @rr "items") (fn l (str/replaceAll @l "" @m))) ## keys => (object/get @rr "keys") ## stmts => (array/map (object/get @rr "stmts") (fn ls (array/map @ls (fn l (str/replaceAll @l "" @m))))) ## pairVals => (array/map (object/get @rr "pairVals") (fn l (str/replaceAll @l "" @m))) ## warns => (object/get @rr "warns") ## uses => (object/get @rr "uses") }))))
                      (array/map (array/range 0 (array/len @n)) (fn i (default (array/nth @k @i) @nullR))))))
            (let ((ex (array/map @rs (fn r (object/get @r "expr"))))
                  (ws (array/flatten (array/map @rs (fn r (object/get @r "warns")))))
                  (us (array/flatten (array/map @rs (fn r (object/get @r "uses"))))))
              (if (not @isCall)
                REC{ expr => FILL{@config.listForm ## "*" => (str/join @ex ", ")} ## stmt => [(str/concat FILL{@config.listForm ## "*" => (str/join @ex ", ")} @term)] ## items => @ex ## stmts => (array/map @rs (fn r (object/get @r "stmt"))) ## pairVals => (array/map @rs (fn r (default (array/nth (object/get @r "items") 1) ""))) ## warns => @ws ## uses => @us }
              (if (= @hd "fn")
                (let ((names (array/map (if (validate/string (array/nth @n 1)) [(array/nth @n 1)] (default (as (array/nth @n 1) SrcList) [])) (fn x CASE{(if (validate/string @x) @x "") ## @config.localCase})))
                      (bodyE (object/get (default (array/nth @rs (- (array/len @rs) 1)) @nullR) "expr")))
                  (let ((txt FILL{@config.lambdaForm ## params => (str/join @names ", ") ## body => @bodyE}))
                    REC{ expr => @txt ## stmt => [(str/concat @txt @term)] ## params => @names ## body => @bodyE ## warns => @ws ## uses => @us }))
              (if (= @hd "let")
                (let ((pairs (array/map (default (as (array/nth @n 1) SrcLists) []) (fn pr CASE{(let ((nm (array/nth @pr 0))) (if (validate/string @nm) @nm "")) ## @config.localCase})))
                      (bvals (object/get (default (array/nth @rs 1) @nullR) "pairVals"))
                      (bodyRs (array/drop @rs 2)))
                  (let ((lastE (if (= (array/len @bodyRs) 0) @config.nullLit (object/get (default (array/nth @bodyRs (- (array/len @bodyRs) 1)) @nullR) "expr"))))
                    REC{ expr => (array/reduce (array/reverse (array/range 0 (array/len @pairs))) @lastE (fn acc i FILL{@config.letExpr ## name => (default (array/nth @pairs @i) "") ## value => (default (array/nth @bvals @i) "") ## body => @acc ## type => (str/concat "[1][" @i "][1]")}))
                      ## stmt => (array/concat
                           (array/map (array/range 0 (array/len @pairs)) (fn i (str/concat FILL{@config.letStmt ## name => (default (array/nth @pairs @i) "") ## value => (default (array/nth @bvals @i) "") ## type => (str/concat "[1][" @i "][1]")} @term)))
                           (array/flatten (array/map @bodyRs (fn r (object/get @r "stmt")))))
                      ## warns => @ws ## uses => @us }))
              (if (= @hd "if")
                (let ((a : SrcRender (default (array/nth @rs 2) @nullR))
                      (b : SrcRender (default (array/nth @rs 3) @nullR))
                      (hasB (> @argc 2))
                      (c (default (array/nth @ex 1) @config.nullLit)))
                  (let ((aS (if (= (array/len (object/get @a "stmt")) 0) (if (!= @config.emptyBody "") [@config.emptyBody] []) (object/get @a "stmt")))
                        (bS (if (= (array/len (object/get @b "stmt")) 0) (if (!= @config.emptyBody "") [@config.emptyBody] []) (object/get @b "stmt"))))
                    REC{ expr => FILL{@config.condExpr ## cond => @c ## then => (object/get @a "expr") ## else => (if @hasB (object/get @b "expr") @config.nullLit)}
                      ## stmt => (array/concat [FILL{@config.ifOpen ## cond => @c}]
                           (array/map @aS (fn l (str/concat @config.indent @l)))
                           (if @hasB (array/concat [@config.elseOpen] (array/map @bS (fn l (str/concat @config.indent @l)))) [])
                           (if (!= @config.blockClose "") [@config.blockClose] []))
                      ## warns => @ws ## uses => @us }))
              (if (= @hd "when")
                (let ((bodyRs (array/drop @rs 2))
                      (c (default (array/nth @ex 1) @config.nullLit)))
                  (let ((lines (array/flatten (array/map @bodyRs (fn r (object/get @r "stmt"))))))
                    (let ((bS (if (= (array/len @lines) 0) (if (!= @config.emptyBody "") [@config.emptyBody] []) @lines)))
                      REC{ expr => FILL{@config.condExpr ## cond => @c ## then => (if (= (array/len @bodyRs) 0) @config.nullLit (object/get (default (array/nth @bodyRs (- (array/len @bodyRs) 1)) @nullR) "expr")) ## else => @config.nullLit}
                        ## stmt => (array/concat [FILL{@config.ifOpen ## cond => @c}] (array/map @bS (fn l (str/concat @config.indent @l))) (if (!= @config.blockClose "") [@config.blockClose] []))
                        ## warns => @ws ## uses => @us })))
              (if (= @hd "do")
                (let ((bodyRs (array/drop @rs 1)))
                  REC{ expr => (if (= (array/len @bodyRs) 0) @config.nullLit (object/get (default (array/nth @bodyRs (- (array/len @bodyRs) 1)) @nullR) "expr"))
                    ## stmt => (array/flatten (array/map @bodyRs (fn r (object/get @r "stmt"))))
                    ## warns => @ws ## uses => @us })
              (if (= @hd "set")
                (let ((r0 (array/nth @n 1))
                      (raw : string (if (validate/string @r0) @r0 ""))
                      (value (default (array/nth @ex 2) @config.nullLit))
                      (tr : SrcRender (default (array/nth @rs 1) @nullR)))
                  (let ((target (if (!= (object/get @tr "body") "") (object/get @tr "body") (default (array/nth @ex 1) @config.nullLit)))
                        (parts (str/split (str/slice @raw 1 (str/len @raw)) ".")))
                    (let ((copyOk (and (= @config.setStyle "copy") (= (array/len @parts) 2)))
                          (copyBad (and (= @config.setStyle "copy") (!= (array/len @parts) 2)))
                          (root (object/get @config.attributeRoots (default (array/nth @parts 0) "") "")))
                      (let ((line (if @copyOk FILL{@config.setCopy ## root => @root ## field => CASE{(default (array/nth @parts 1) "") ## @config.fieldCase} ## value => @value}
                                    (if @copyBad FILL{@config.unsupportedForm ## op => "set"} FILL{@config.setAssign ## target => @target ## value => @value}))))
                        REC{ expr => @config.nullLit ## stmt => [(str/concat @line @term)]
                          ## warns => (array/concat @ws (if @copyBad [(str/concat "set path " @raw " is deeper than one field, which this target cannot assign")] []))
                          ## uses => (array/concat @us (if @copyBad ["unsupported"] [])) }))))
              (if (= @hd "emit")
                (let ((e1 (array/nth @n 1))
                      (ev : string (if (validate/string @e1) @e1 ""))
                      (pl (array/nth @n 2))
                      (prs : SrcRender (default (array/nth @rs 2) @nullR)))
                  (let ((ptype LOOKUP{@ctx.emitTypes ## @ev})
                        (isObj (validate/object @pl)))
                    (let ((fieldsText (str/join (array/map (array/range 0 (array/len (object/get @prs "keys"))) (fn i FILL{@config.payloadField ## name => CASE{(default (array/nth (object/get @prs "keys") @i) "") ## @config.fieldCase} ## value => (default (array/nth (object/get @prs "items") @i) "")})) @config.payloadSep)))
                      (let ((pld (if (and (!= @ptype "") @isObj) FILL{@config.payloadCtor ## type => @ptype ## fields => @fieldsText}
                                       (if (!= @ptype "") (if (= (array/len @n) 2) FILL{@config.payloadCtor ## type => @ptype ## fields => ""} (default (array/nth @ex 2) @config.nullLit))
                                         (if (= (array/len @n) 2) @config.nullLit (default (array/nth @ex 2) @config.nullLit)))))
                            (warn (if (and (= @ptype "") (> (array/len @n) 2)) [(str/concat "emit " @ev " carries a payload the trait does not declare")]
                                    (if (and (!= @ptype "") (> (array/len @n) 2) (not @isObj)) [(str/concat "emit " @ev " passes a payload that is not an object literal, so it is not built as " @ptype)] []))))
                        (let ((call FILL{@config.emitForm ## event => (default (array/nth @ex 1) "") ## payload => @pld}))
                          REC{ expr => @call ## stmt => [(str/concat @call @term)] ## warns => (array/concat @ws @warn) ## uses => @us })))))
              (if (= @hd "render-ui")
                (let ((kind : string (let ((pr (if (> @argc 1) (array/nth @n 2) null))) (if (validate/object @pr) (let ((tv (object/get @pr "type" "ui"))) (if (validate/string @tv) @tv "ui")) "ui"))))
                  REC{ expr => @config.nullLit ## stmt => [FILL{@config.commentForm ## text => (str/concat "render: " @kind)}] ## warns => @ws ## uses => @us })
              (if (array/includes @config.portEffects @hd)
                (let ((args (array/drop @ex 1)))
                  (let ((txt FILL{@config.portCall ## name => CASE{@hd ## @config.portCase} ## "*" => (str/join @args ", ")}))
                    REC{ expr => @txt ## stmt => [(str/concat @txt @term)] ## items => @ex ## warns => (array/concat @ws [FILL{@config.portWarn ## op => @hd}]) ## uses => @us }))
              (let ((args (array/drop @ex 1))
                    (tmplU (if (= @argc 1) (object/get @config.unary @hd "") ""))
                    (sym (if (> @argc 1) (object/get @config.infix @hd "") ""))
                    (tmplA (object/get @config.operators (str/concat @hd "#" @argc) ""))
                    (tmplP (object/get @config.operators @hd ""))
                    (callee (object/get @config.callees @hd ""))
                    (lamT (object/get @config.lambdaOperators @hd ""))
                    (fnArg : SrcRender (default (array/nth @rs 2) @nullR)))
                (let ((fnVars (object/get @fnArg "params"))
                      (hasFn (and (!= @lamT "") (> (array/len (object/get @fnArg "params")) 0)))
                      (tmpl (if (!= @tmplU "") @tmplU (if (!= @tmplA "") @tmplA @tmplP)))
                      (joined (str/join @args ", ")))
                  (let ((mode (if @hasFn "lambda" (if (!= @tmplU "") "template" (if (!= @sym "") "infix" (if (!= @tmpl "") "template" (if (!= @callee "") "callee" "none"))))))
                        (opv : SrcVars (object/fromEntries (array/concat
                           (array/map (array/range 0 @argc) (fn i [(str/concat "" @i) (default (array/nth @args @i) "")]))
                           (array/map (array/range 0 @argc) (fn i [(str/concat "type" @i) (str/concat "" (if (or (= @hd "let") (= @hd "fn")) (str/concat ".body[" (- (+ @i 1) 2) "]") (if (= @hd "if") (if (= (+ @i 1) 2) ".then" (if (= (+ @i 1) 3) ".else" (str/concat "[" (+ @i 1) "]"))) (str/concat "[" (+ @i 1) "]"))) "")]))
                           [["*" @joined] ["type" ""]])))
                        (vs (if (> (array/len @fnVars) 1) FILL{@config.indexedVars ## index => (default (array/nth @fnVars 1) "_") ## item => (default (array/nth @fnVars 0) "_")} (default (array/nth @fnVars 0) "_")))
                        (src (if (> (array/len @fnVars) 1) FILL{@config.indexedSource ## src => (default (array/nth @args 0) "")} (default (array/nth @args 0) ""))))
                    (let ((txt (if (= @mode "lambda") FILL{@lamT ## body => (object/get @fnArg "body") ## vars => @vs ## src => @src ## item => (default (array/nth @fnVars 0) "_")}
                                 (if (= @mode "infix") FILL{@config.infixForm ## "*" => (str/join @args (str/concat " " @sym " "))}
                                   (if (= @mode "template") FILLV{@tmpl ## @opv}
                                     (if (= @mode "callee") FILL{@config.calleeForm ## callee => @callee ## "*" => @joined}
                                       FILL{@config.unsupportedForm ## op => FILL{@config.stringForm ## json => (json/stringify @hd)}})))))
                          (warn (if (= @mode "none") [FILL{@config.unsupportedWarn ## language => @config.language ## op => @hd}] [])))
                      REC{ expr => @txt ## stmt => [(str/concat @txt @term)] ## items => @ex ## warns => (array/concat @ws @warn) ## uses => (array/concat @us [@hd] (if (= @mode "none") ["unsupported"] [])) }))))))))))))))))))
    (if (validate/object @n)
      (let ((es (object/entries @k)))
        (let ((typedEs (if @typed (array/map @es (fn e (let ((rr (default (array/nth @e 1) @nullR)) (m (str/concat "." (default (array/nth @e 0) "")))) [(array/nth @e 0) REC{ expr => (str/replaceAll (object/get @rr "expr") "" @m) ## stmt => (object/get @rr "stmt") ## params => (object/get @rr "params") ## body => (object/get @rr "body") ## items => (object/get @rr "items") ## keys => (object/get @rr "keys") ## stmts => (object/get @rr "stmts") ## pairVals => (object/get @rr "pairVals") ## warns => (object/get @rr "warns") ## uses => (object/get @rr "uses") }]))) @es)))
          (let ((pairsText (str/join (array/map @typedEs (fn e FILL{@config.mapPair ## key => FILL{@config.stringForm ## json => (json/stringify (array/nth @e 0))} ## value => (object/get (default (array/nth @e 1) @nullR) "expr")})) @config.mapSep)))
            (let ((txt (str/concat @config.mapOpen @pairsText @config.mapClose)))
              REC{ expr => @txt ## stmt => [(str/concat @txt @term)]
                ## items => (array/map @typedEs (fn e (object/get (default (array/nth @e 1) @nullR) "expr")))
                ## keys => (object/keys @k)
                ## warns => (array/flatten (array/map @typedEs (fn e (object/get (default (array/nth @e 1) @nullR) "warns"))))
                ## uses => (array/flatten (array/map @typedEs (fn e (object/get (default (array/nth @e 1) @nullR) "uses")))) }))))
      (if (validate/string @n)
        (let ((sv : string @n))
          (if (str/startsWith @sv @at)
            (let ((path (str/split (str/slice @sv 1 (str/len @sv)) ".")))
 (let ((root (default (array/nth @path 0) "")) (rest (array/drop @path 1)))
  (let ((attrBase (object/get @config.attributeRoots @root "")) (itemBase (object/get @config.itemRoots @root "")))
   (let ((kind (if (!= @attrBase "") "attr" (if (!= @itemBase "") "item" @config.localAccess)))
         (base (if (!= @attrBase "") @attrBase (if (!= @itemBase "") @itemBase CASE{@root ## @config.localCase}))))
    (let ((tail (str/join (array/map @rest (fn x (if (and (> (str/len @x) 0) (= (str/replace-pattern @x "[0-9]" "") "")) FILL{@config.indexAccess ## "0" => @x} (if (= @kind "attr") FILL{@config.attrAccess ## name => CASE{@x ## @config.fieldCase}} FILL{@config.itemAccess ## key => FILL{@config.stringForm ## json => (json/stringify @x)}})))) "")))
     (let ((plain (str/concat @base @tail))
           (dtext (if (and (= @root "entity") (= (array/len @rest) 1)) LOOKUP{@ctx.defaults ## (default (array/nth @rest 0) "")} "")))
      (let ((txt (if (and (!= @config.entityReadDefault "") (!= @dtext "")) FILL{@config.entityReadDefault ## read => @plain ## default => @dtext} @plain)))
        REC{ expr => @txt ## stmt => [(str/concat @txt @term)] ## body => @plain })))))))
            (let ((txt FILL{@config.stringForm ## json => (json/stringify @sv)}))
              REC{ expr => @txt ## stmt => [(str/concat @txt @term)] })))
        (let ((txt (if (validate/boolean @n) (if (= @n true) @config.trueLit @config.falseLit) (json/stringify @n))))
          REC{ expr => @txt ## stmt => [(str/concat @txt @term)] }))))))
  )
