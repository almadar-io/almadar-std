                                          [(str/concat @pre FILL{@config.stateAssign ## state => STR{(object/get @tr "to")}} @config.terminator)])
                                        (fn l RESOLVE{@l ## @base})))))))))
                            (if (!= @config.branchClose "") [FILL{@config.branchClose ## i => @ind}] [])
