                                  { line: FILL{@config.modelField ## i => @ind ## name => CASE{(default (object/get @f "name") "") ## @config.fieldCase} ## type => @ty ## default => @dpart}, plain: (= @dpart ""), typeText: @tt }))))))))
                    (if (object/get @c "alias")
