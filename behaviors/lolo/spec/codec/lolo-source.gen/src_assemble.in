                    (rs (default (array/nth @entity.renders (+ @nC @ti)) []))
                    (cn : string CASE{(default (object/get (default (array/nth @entity.traits @ti) { name: "" }) "name") "") ## @config.classCase}))
                (if (not (object/get @t "hasMachine"))
