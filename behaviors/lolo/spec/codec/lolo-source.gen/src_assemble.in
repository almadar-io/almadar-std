                      (if (!= @config.classClose "") [FILL{@config.classClose ## i => @ind}] []))))))))))
        (set @entity.blocks (let ((nC (if @config.renderModels (array/len @entity.containers) 0))
                                  (ind : string @config.indent)
                                  (nullR : SrcRender RECL{ expr => @config.nullLit ## stmt => [@config.nullLit] ## body => @config.nullLit }))
          (let ((rows (array/flatten (array/map (array/range 0 (array/len @entity.traits)) (fn ti
                  (array/map (array/range 0 (array/len (object/get (default (array/nth @entity.traits @ti) { name: "", path: "", entity: "", initial: "", hasMachine: false, knobs: [], transitions: [], events: [], listenTypes: {}, emitTypes: {}, emitVoid: [], configType: "", orbital: "", listenRows: [] }) "listenRows"))) (fn li { ti: @ti, li: @li })))))))
            (if (or (= (array/len @config.programOpen) 0) (= (array/len @rows) 0))
              @entity.blocks
              (array/concat @entity.blocks [(array/concat
                (array/map @config.programOpen (fn l FILL{@l ## i => @ind ## entities => (str/join (array/map @entity.traits (fn t FILL{@config.programEntity ## key => STR{(str/concat (object/get @t "orbital") "." (object/get @t "name"))} ## entity => ENT{(object/get @t "entity")}})) @config.programEntitySep)}))
                (array/map @entity.traits (fn t FILL{@config.programTrait ## i => @ind ## key => STR{(str/concat (object/get @t "orbital") "." (object/get @t "name"))} ## class => CASE{(object/get @t "name") ## @config.classCase} ## entity => ENT{(object/get @t "entity")}}))
                (array/map @entity.traits (fn t
