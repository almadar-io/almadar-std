{
 "atom": "codec/atoms/std-gzip.lolo",
 "trait": "Gunzip",
 "source": "python model of the same greedy LZ77 + fixed-Huffman encoder, crc from zlib; every member decoded byte-equal by the system gzip -dc, and each case replays the member through GUNZIP",
 "note": "data is standard base64 of the bytes.",
 "cases": [
  {
   "id": "empty",
   "steps": [
    {
     "event": "GZIP",
     "payload": {
      "data": ""
     },
     "expect": {
      "emits": [
       {
        "event": "GZIP_ANSWERED",
        "payload": {
         "data": "H4sIAAAAAAAA/wMAAAAAAAAAAAA=",
         "size": 0,
         "crc": 0
        }
       }
      ],
      "neverEmits": [
       "GZIP_REFUSED"
      ]
     }
    },
    {
     "event": "GUNZIP",
     "payload": {
      "data": "H4sIAAAAAAAA/wMAAAAAAAAAAAA="
     },
     "expect": {
      "emits": [
       {
        "event": "GUNZIP_ANSWERED",
        "payload": {
         "data": "",
         "size": 0,
         "crc": 0
        }
       }
      ],
      "neverEmits": [
       "GZIP_REFUSED"
      ]
     }
    }
   ]
