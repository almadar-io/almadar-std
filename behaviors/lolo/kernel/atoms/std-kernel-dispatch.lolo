app std-kernel-dispatch [
  version: "0.1.0",
  kernel: { "guest": [step] },
  description: "std-kernel-dispatch — the .lolo kernel's dispatch (P-044): a program's worklist run in .lolo over kernel/step, beside the native kernel and never replacing it. KERNEL_LOAD { program } takes a resolved program (what program/read { resolve } answers), opens it as a guest that only steps (program/open), reads its transition rows and delivery facts from std-machine, and answers KERNEL_OPENED { initial } with each trait's initial state, or KERNEL_FAILED { error }. KERNEL_MOUNT { route } mounts a page: the traits the page at that path lists and those they embed (std-machine mounts; route boot mounts the boot pages) that handle INIT from their current state get INIT in that order as one dispatch (EXEC-SEED-4), and a delivery to a seed whose INIT has not run yet is held and queued again behind it (EXEC-SEED-2). KERNEL_DISPATCH { trait, event, payload } runs one dispatch from that trait; an event other than INIT, LOAD and $MOUNT also runs on each trait that embeds it, innermost first (std-machine hosts, EXEC-SEED-3), and every one of those steps runs before any own emit or listener they queue, own emits first; a listen that would hand the event back to one of those traits as itself is skipped. Both answer KERNEL_DISPATCHED { outcomes, emitted, collapsed, cut } and keep each trait's state and frame. A step that reorders the worklist (kernel/queue-front, kernel/queue-back) answers its directives (kernel/step's queue), and the kernel moves every queued delivery of each named event to the front or the back, in written order, after that step's own emits and listeners are queued; the steps of a dispatch's own scopes hold theirs until the last of them has run and the main queue forms (EXEC-QUEUE-2, EXEC-METAL-5). A dispatch is one fold of at most 2000 deliveries; the queue left after them is reported as cut, never dropped silently. Each delivery is one step, its own round of the kernel's KERNEL_NEXT loop: kernel/step on a guest the kernel only dry-runs, kernel/commit on an attached guest, a leg or \"self\" (a refused step ends the run with KERNEL_FAILED and the reason). the step's own emits that its trait handles from its new state go to the front in written order, and every listener of each emit, and of a dispatch's own seed event, goes to the back (EXEC-QUEUE-2), a listener hearing an emit when its route's source as written matches (any, or the emitting trait in the source orbital, EXEC-QUEUE-6 and 7), in declaration order; a listen's when, per and with run in the guest through kernel/step's delivery (EXEC-QUEUE-3); a delivery whose trait, event, from state, payload and frame were already processed in the dispatch is skipped and reported as collapsed, except a completion (the reply or failure an effect's declared route fired), which is never skipped, and a delivery its listen's guard held back is not counted as processed (EXEC-QUEUE-4). Each outcome is { trait, event, from, to, fired }, as a native guest dispatch reports it. A listen with a per key steps the row it names (EXEC-STEP-1a): the row is made on first use from the trait's initial state and its INIT runs on it first, and its state and frame are kept apart from the trait's own. A guest with no host answers its asks in place, as a native dispatch into it does. KERNEL_TICK { ticks: [{ trait, tick, rows }] } runs ticks the host's clock found due, each as its own run, once per row the host named (program/tick answers them: every row of the trait's entity, once on no row for an empty [runtime] entity; a keyed trait's state held per row, another's on the trait; EXEC-TICK-5); a tick outside its states, or whose guard fails, runs nothing. Not yet carried: a hosted guest's asks, distribution, callsite capture (a mount seed that waits for its composer's paint)."
]
;; @capabilities "lolo kernel, dispatch worklist, kernel step fold, parallel kernel"

type KFrame = { row : SExpr? }
type KItem = { trait : string!, event : string!, payload : SExpr, at : number!, seed : boolean!, row : string!, completion : boolean!, src : string!, run : string?, runRow : string?, seen : SExpr }
type KCollapsed = { trait : string!, event : string!, payload : SExpr }
type KSettledRun = { run : string!, trait : string!, event : string!, payload : SExpr, entityId : string! }
type KSettled = { runs : [KSettledRun]! }
type KOutcome = { trait : string!, event : string!, from : string!, to : string!, fired : boolean! }
type KEmit = { trait : string!, event : string!, payload : SExpr }
type KRoute = { orbital : string!, trait : string!, at : number!, trigger : string!, event : string!, sourceKind : "any" | "trait" | "orbital", sourceOrbital : string!, sourceTrait : string!, keyed : boolean!, guarded : boolean!, mapped : boolean! }
type KMountAsk = { route : string! }
type KHost = { trait : string!, chain : [string]! }
type KMount = { orbital : string!, page : string!, path : string!, protocol : string!, listed : [string]!, embedded : [string]! }
type KSlot = { name : string!, type : string!, required : boolean!, values : [string], entity : string }
type KRow = { orbital : string!, trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, payload : [KSlot]! }
type KState = { name : string!, isInitial : boolean }
type KGraph = { states : [KState] }
type KTrait = { name : string!, linkedEntity : string, stateMachine : KGraph }
type KEntField = { name : string!, intrinsic : boolean }
type KEntity = { name : string!, shared : boolean, fields : [KEntField] }
type KOrbital = { name : string!, traits : [KTrait], entity : KEntity, auxiliaryEntities : [KEntity] }
type KShare = { key : string!, intrinsic : [string]! }
type KRowMap = Map string SExpr
type KProgram = { orbitals : [KOrbital]! }
type KReadAnswer = { program : SExpr!, guest : string?, route : string? }
type KNav = { trait : string!, path : string! }
type KPaint = { slot : string!, trait : string!, orbital : string?, embedded : boolean!, content : node? }
type KSeed = { trait : string!, event : string! }
type KHeldProgram = { orbitals : [orbital] }
type KLoloOpen = { guest : string!, seeds : [KSeed]!, route : string? }
type KLegRun = { kind : "targeted" | "mount" | "discover" | "completion" | "tick", trait : string?, event : string?, payload : SExpr?, entityId : string!, seeds : [KSeed]?, route : string?, traits : [string]?, failure : string?, key : string?, tick : string?, rows : [string]? }
type KOpenAnswer = { guest : string!, outcomes : [KNativeOutcome]! }
type KRun = { q : [KItem]!, states : Map string string!, frames : Map string KFrame!, outcomes : [KOutcome]!, emitted : [KEmit]!, collapsed : [KCollapsed]!, seen : [string]!, pending : [string]!, later : [KItem]!, scopes : [string]!, refused : string!, next : [KItem]!, nextPending : [string]!, held : [KItem]!, paints : [KPaint]!, navs : [KNav]!, directives : [KDirective]! }
type KStepEmit = { event : string!, payload : SExpr?, completion : boolean?, seen : SExpr? }
type KScriptStep = { trait : string!, event : string!, payload : SExpr, tickPass : boolean? }
type KTickRan = { trait : string!, tick : string!, rows : [string]! }
type KNativeTick = { states : Map string string!, outcomes : [KNativeOutcome]!, emitted : [KNativeEmit], ran : [KTickRan]! }
type KNativeOutcome = { trait : string!, event : string, from : string!, to : string!, fired : boolean! }
type KNative = { states : Map string string!, outcomes : [KNativeOutcome]!, emitted : [KNativeEmit] }
type KNativeOpen = { guest : string!, states : Map string string!, outcomes : [KNativeOutcome]!, emitted : [KNativeEmit] }
type KNativeEmit = { event : string!, payload : SExpr? }
type KRowOut = { trait : string!, row : string!, entity : SExpr? }
type KNativeRow = { trait : string!, entityId : string!, state : string!, entity : SExpr? }
type KNativeState = { orbital : string!, traits : [KNativeRow]! }
type KNativeReflect = { state : KNativeState! }
type KCompare = { step : number!, trait : string!, event : string!, equal : boolean!, differs : [string]!, nativeStates : Map string string!, loloStates : Map string string!, nativeOutcomes : [KNativeOutcome]!, loloOutcomes : [KOutcome]!, nativeEmitted : [KNativeEmit]!, loloEmitted : [KEmit]!, nativeRows : [KNativeRow]!, loloRows : [KRowOut]!, nativeRefused : string!, loloRefused : string! }
type KStep = { fired : boolean!, to : string!, before : SExpr?, entity : SExpr?, emits : [KStepEmit]!, delivered : boolean!, key : string?, keyRequired : boolean?, rejected : string?, deliveryRejected : SExpr?, quiet : boolean?, rendered : [KPaint]?, navigations : [KNav]?, failure : string?, queue : [KDirective]? }
type KDirective = { event : string!, front : boolean! }
type KAskAt = { at : number! }
type KStepAsk = { trait : string!, from : string, event : string, payload : SExpr, entity : SExpr, entityId : string, entry : boolean, delivery : KAskAt, mount : KMountAsk, emitter : string, tick : string, leg : string, run : string }
type KAsk = { wait : boolean!, request : KStepAsk!, acc : KRun! }

orbital KernelDispatchOrbital {
  uses Machine from "std/behaviors/std-machine"

  entity KernelRun [runtime] {
    id : string!
    guest : string! = ""
    got : number! = 0
    runs : number! = 0
    bootSeeds : [string]! = []
    rows : [KRow]! = []
    routes : [KRoute]! = []
    mounts : [KMount]! = []
    states : Map string string! = {}
    initial : Map string string! = {}
    orbitals : Map string string! = {}
    frames : Map string KFrame! = {}
    last : KRun = { q: [], states: {}, frames: {}, outcomes: [], emitted: [], collapsed: [], seen: [], pending: [], later: [], scopes: [], refused: "", next: [], nextPending: [], held: [], paints: [], navs: [], directives: [] }
    runLeft : number! = 0
    hosts : [KHost]! = []
    shares : Map string KShare! = {}
    leg : string! = ""
    legSettle : boolean! @description "A mount leg's $MOUNT work is still to settle on its host before its first seed (EXEC-SEED-7)." = false
    legRow : string! = ""
    legTrait : string! = ""
    legEvent : string! = ""
    legFallback : string! = ""
    legKey : string! = ""
    attached : boolean! = false
    browser : [string]! = []
  }

  trait KernelMachine = Machine.traits.Machine {
    listens {
      KernelDispatch.KERNEL_MACHINE_READ -> MACHINE_READ
      KernelDispatch.KERNEL_FACTS_READ -> MACHINE_FACTS_READ
    }
  }

  trait KernelDispatch -> KernelRun [server] {
    initial: idle

    state idle {
      INIT -> idle
      KERNEL_LOAD -> reading
        (set @entity.attached false)
        (set @entity.browser [])
        (if (= ?route null) (emit KERNEL_READ { result: { program: ?program } }) (emit KERNEL_READ { result: { program: ?program, route: ?route } }))
      KERNEL_ATTACH -> reading
        (set @entity.attached true)
        (set @entity.browser (default ?browser []))
        (emit KERNEL_READ { result: { program: ?program, guest: ?guest } })
      KERNEL_MOUNT_SEEDS -> idle
        (emit KERNEL_FAILED { error: "no program is open" })
      KERNEL_MOUNT -> idle
        (emit KERNEL_FAILED { error: "no program is open" })
      KERNEL_DISPATCH -> idle
        (emit KERNEL_FAILED { error: "no program is open" })
      KERNEL_TICK -> idle
        (emit KERNEL_FAILED { error: "no program is open" })
      KERNEL_LEG -> idle
        (emit KERNEL_FAILED { error: "no program is open" })
      KERNEL_FRAMES_READ -> idle
        (emit KERNEL_FAILED { error: "no program is open" })
    }

    state reading {
      INIT -> reading
      KERNEL_READ -> reading
        (set @entity.got 0)
        (set @entity.orbitals (object/fromEntries (array/flatten (array/map (object/get (default (as ?result.program KProgram) { orbitals: [] }) "orbitals") (fn o
          (array/map (object/get @o "traits" []) (fn t [(object/get @t "name") (object/get @o "name")])))))))
        (set @entity.states (object/fromEntries (array/flatten (array/map (object/get (default (as ?result.program KProgram) { orbitals: [] }) "orbitals") (fn o
          (array/map (object/get @o "traits" []) (fn t
            [(object/get @t "name") (object/get (default (array/find (object/get (object/get @t "stateMachine" { states: [] }) "states" []) (fn s (object/get @s "isInitial" false))) { name: "", isInitial: false }) "name")])))))))
        (set @entity.initial @entity.states)
        (set @entity.shares (object/fromEntries (array/flatten (array/map (object/get (default (as ?result.program KProgram) { orbitals: [] }) "orbitals") (fn o
          (let ((ents : [KEntity] (array/concat (if (= (object/get @o "entity" null) null) [] [(default (as (object/get @o "entity") KEntity) { name: "" })]) (object/get @o "auxiliaryEntities" []))))
            (array/flatten (array/map (object/get @o "traits" []) (fn t
              (let ((e : KEntity (default (array/find @ents (fn x (and (= @x.name (object/get @t "linkedEntity" "")) (default @x.shared false)))) { name: "" })))
                (if (= @e.name "") []
                  [[(object/get @t "name") { key: (str/concat "$shared::" @e.name), intrinsic: (array/map (array/filter (default @e.fields []) (fn f (default @f.intrinsic false))) (fn f @f.name)) }]])))))))))))
        (emit KERNEL_MACHINE_READ { program: ?result.program })
        (emit KERNEL_FACTS_READ { program: ?result.program })
        (if (= (default ?result.guest "") "")
          (if (= ?result.route null) (emit KERNEL_OPEN_ASK { program: ?result.program }) (emit KERNEL_OPEN_ASK { program: ?result.program, route: ?result.route }))
          (emit KERNEL_GUEST { result: { guest: (default ?result.guest ""), outcomes: [] } }))
      KERNEL_GUEST -> reading
        (set @entity.guest ?result.guest)
        (set @entity.bootSeeds (array/unique (array/map (array/filter ?result.outcomes (fn o (array/includes ["INIT", "LOAD", "$MOUNT"] (default @o.event "")))) (fn o @o.trait))))
        (set @entity.got (+ @entity.got 1))
        (emit KERNEL_CHECK { })
      KERNEL_ROWS -> reading
        (set @entity.rows ?rows)
        (set @entity.got (+ @entity.got 1))
        (emit KERNEL_CHECK { })
      KERNEL_FACTS -> reading
        (set @entity.routes ?routes)
        (set @entity.mounts ?mounts)
        (set @entity.hosts ?hosts)
        (set @entity.got (+ @entity.got 1))
        (emit KERNEL_CHECK { })
      KERNEL_CHECK -> reading when (< @entity.got 3)
      KERNEL_CHECK -> ready when (>= @entity.got 3)
        (emit KERNEL_OPENED { initial: @entity.states })
      KERNEL_OPEN_FAILED -> idle
        (emit KERNEL_FAILED { error: (default ?error "the program could not be read or opened") })
      KERNEL_MACHINE_UNREAD -> idle
        (emit KERNEL_FAILED { error: "the program has no orbitals" })
    }

    state ready {
      INIT -> ready
      KERNEL_LOAD -> reading
        (set @entity.frames {})
        (set @entity.attached false)
        (set @entity.browser [])
        (if (= ?route null) (emit KERNEL_READ { result: { program: ?program } }) (emit KERNEL_READ { result: { program: ?program, route: ?route } }))
      KERNEL_ATTACH -> reading
        (set @entity.frames {})
        (set @entity.attached true)
        (set @entity.browser (default ?browser []))
        (emit KERNEL_READ { result: { program: ?program, guest: ?guest } })
      KERNEL_MOUNT -> ready
        (set @entity.runs (+ @entity.runs 1))
        (let ((seeds : [string] (array/filter
                (array/unique (array/concat
                  (if (or (= ?route "boot") ?boot) @entity.bootSeeds [])
                  (array/flatten (array/map (array/filter @entity.mounts (fn m (and (!= ?route "boot") (= (object/get @m "path") ?route))))
                    (fn m (array/concat (object/get @m "listed") (object/get @m "embedded")))))))
                (fn n (array/some @entity.rows (fn r (and (= (object/get @r "trait") @n) (array/includes ["INIT", "LOAD", "$MOUNT"] (object/get @r "event")) (= (object/get @r "from") (object/get @entity.states @n "")))))))))
          (emit KERNEL_RUN {
            items: (if (= ?route "boot") []
                     (array/map (array/filter @entity.routes (fn rt (and (= (object/get @rt "event") "$MOUNT") (= (object/get @rt "sourceKind") "any"))))
                       (fn rt { trait: (object/get @rt "trait"), event: "$MOUNT", payload: { route: ?route }, seen: { route: ?route }, at: (object/get @rt "at"), seed: false, row: "", completion: false, src: "" }))),
            next: (array/map @seeds (fn n { trait: @n, event: (default (array/find ["INIT", "LOAD", "$MOUNT"] (fn ev (array/some @entity.rows (fn r (and (= (object/get @r "trait") @n) (= (object/get @r "event") @ev) (= (object/get @r "from") (object/get @entity.states @n ""))))))) "INIT"), payload: {}, seen: {}, at: -1, seed: false, row: "", completion: false, src: "" })),
            pending: @seeds }))
      KERNEL_MOUNT_SEEDS -> ready
        (set @entity.runs (+ @entity.runs 1))
        (emit KERNEL_RUN {
          items: (if (= (default ?route "") "") []
                   (array/map (array/filter @entity.routes (fn rt (and (= (object/get @rt "event") "$MOUNT") (= (object/get @rt "sourceKind") "any"))))
                     (fn rt { trait: (object/get @rt "trait"), event: "$MOUNT", payload: { route: (default ?route "") }, seen: { route: (default ?route "") }, at: (object/get @rt "at"), seed: false, row: "", completion: false, src: "" }))),
          next: (array/map ?seeds (fn n { trait: @n.trait, event: @n.event, payload: {}, seen: {}, at: -1, seed: false, row: "", completion: false, src: "" })),
          pending: (array/map ?seeds (fn n @n.trait)) })
      KERNEL_TICK -> ready
        (set @entity.runs (+ @entity.runs 1))
        (emit KERNEL_RUN { items: [], pending: [],
          next: (array/flatten (array/map ?ticks (fn t
                  (array/map @t.rows (fn row { trait: @t.trait, event: @t.tick, payload: {}, seen: {}, at: -2, seed: false, row: @row, completion: false, src: "" }))))) })
      KERNEL_LEG -> ready
        (set @entity.runs (+ @entity.runs 1))
        (set @entity.leg ?leg)
        (set @entity.legSettle (and (= ?run.kind "mount") (!= (default ?run.route "") "")))
        (set @entity.legRow ?run.entityId)
        (set @entity.legTrait (default ?run.trait ""))
        (set @entity.legEvent (default ?run.event ""))
        (set @entity.legFallback (if (= ?run.kind "completion") (default ?run.failure "") ""))
        (set @entity.legKey (default ?run.key ""))
        (set @entity.states (object/merge @entity.states ?states))
        (emit KERNEL_RUN {
          items: (if (= ?run.kind "mount")
                   (if (= (default ?run.route "") "") []
                     (array/map (array/filter @entity.routes (fn rt (and (= (object/get @rt "event") "$MOUNT") (= (object/get @rt "sourceKind") "any"))))
                       (fn rt { trait: (object/get @rt "trait"), event: "$MOUNT", payload: { route: (default ?run.route "") }, seen: { route: (default ?run.route "") }, at: (object/get @rt "at"), seed: false, row: "", completion: false, src: "" })))
                 (if (= ?run.kind "completion")
                   [{ trait: (default ?run.trait ""), event: (default ?run.event ""), payload: (default ?run.payload {}), seen: (default ?run.payload {}), at: -1, seed: true, row: "", completion: true, src: "" }]
                 (if (= ?run.kind "targeted")
                   (array/map (array/concat [(default ?run.trait "")] (if (array/includes ["INIT", "LOAD", "$MOUNT"] (default ?run.event "")) [] (object/get (default (array/find @entity.hosts (fn h (= @h.trait (default ?run.trait "")))) { trait: (default ?run.trait ""), chain: [] }) "chain")))
                     (fn n { trait: @n, event: (default ?run.event ""), payload: (default ?run.payload {}), seen: (default ?run.payload {}), at: -1, seed: true, row: "", completion: false, src: "" }))
                   (array/map (default ?run.traits [])
                     (fn n { trait: @n, event: (default ?run.event ""), payload: (default ?run.payload {}), seen: (default ?run.payload {}), at: -1, seed: true, row: "", completion: false, src: "" }))))),
          next: (if (= ?run.kind "mount") (array/map (default ?run.seeds []) (fn n { trait: @n.trait, event: @n.event, payload: (default ?run.payload {}), seen: (default ?run.payload {}), at: -1, seed: false, row: "", completion: false, src: "" }))
                  (if (= ?run.kind "tick") (array/map (default ?run.rows []) (fn row { trait: (default ?run.trait ""), event: (default ?run.tick ""), payload: {}, seen: {}, at: -2, seed: false, row: @row, completion: false, src: "" })) [])),
          pending: (if (= ?run.kind "mount") (array/map (default ?run.seeds []) (fn n @n.trait)) []) })
      KERNEL_DISPATCH -> ready
        (set @entity.runs (+ @entity.runs 1))
        (emit KERNEL_RUN { next: [], items: (array/map (array/concat [?trait] (if (array/includes ["INIT", "LOAD", "$MOUNT"] ?event) [] (object/get (default (array/find @entity.hosts (fn h (= @h.trait ?trait))) { trait: ?trait, chain: [] }) "chain")))
                                   (fn n { trait: @n, event: ?event, payload: ?payload, seen: ?payload, at: -1, seed: true, row: "", completion: false, src: "" })), pending: [] })
      KERNEL_FRAMES_READ -> ready
        (emit KERNEL_FRAMES { rows: (array/flatten (array/map (object/keys @entity.states) (fn slot
          (let ((parts : [string] (str/split @slot "#")))
           (let ((t : string (default (array/first @parts) ""))
                 (r : string (str/join (array/drop @parts 1) "#")))
            (let ((share : KShare (object/get @entity.shares @t { key: "", intrinsic: [] })))
             (let ((fslot : string (if (= @share.key "") @slot (if (= @r "") @share.key (str/concat @share.key "#" @r))))
                   (oslot : string (str/concat "own::" @slot)))
              (if (object/has @entity.frames @fslot)
                [{ trait: @t, row: @r, entity: (if (or (= @share.key "") (= (array/len @share.intrinsic) 0))
                                                 (object/get (object/get @entity.frames @fslot { row: {} }) "row")
                                                 (object/merge (default (as (object/get (object/get @entity.frames @fslot { row: {} }) "row") KRowMap) {}) (default (as (object/get (object/get @entity.frames @oslot { row: {} }) "row") KRowMap) {}))) }]
                [])))))))) })
      KERNEL_RUN -> ready
        (set @entity.last { q: ?items, states: @entity.states, frames: @entity.frames, outcomes: [], emitted: [], collapsed: [], seen: [], pending: (if (= (array/len ?next) 0) ?pending []), later: [], scopes: (array/map (array/filter ?items (fn x @x.seed)) (fn x @x.trait)), refused: "", next: ?next, nextPending: ?pending, held: [], paints: [], navs: [], directives: [] })
        (set @entity.runLeft 2000)
        (emit KERNEL_NEXT { left: @entity.runLeft })
      KERNEL_NEXT -> ready when (or (<= @entity.runLeft 0) (and (= (array/len @entity.last.q) 0) (= (array/len @entity.last.next) 0)))
        (set @entity.states @entity.last.states)
        (set @entity.frames @entity.last.frames)
        (if (and (!= @entity.legFallback "") (!= @entity.last.refused ""))
          (do
            (emit KERNEL_RUN { next: [], pending: [], items: [{ trait: @entity.legTrait, event: @entity.legFallback, payload: { error: (str/concat @entity.legEvent " was refused: " @entity.last.refused), kind: "invalid", key: @entity.legKey }, seen: {}, at: -1, seed: true, row: "", completion: true, src: "" }] })
            (set @entity.legFallback ""))
          (do
            (set @entity.leg "")
            (set @entity.legSettle false)
            (set @entity.legRow "")
            (set @entity.legFallback "")
            (emit KERNEL_DISPATCHED { states: (let ((held : Map string string @entity.states)) (array/reduce @entity.last.outcomes @held (fn (acc o) (object/set @acc @o.trait @o.to)))), outcomes: @entity.last.outcomes, emitted: @entity.last.emitted, collapsed: @entity.last.collapsed, cut: (> (+ (array/len @entity.last.q) (array/len @entity.last.later)) 0), refused: @entity.last.refused, rendered: @entity.last.paints, navigations: @entity.last.navs })))
      KERNEL_NEXT -> ready when (and (> @entity.runLeft 0) (= (array/len @entity.last.q) 0) (> (array/len @entity.last.next) 0) @entity.legSettle (!= @entity.leg ""))
        (program/dispatch "" {} { guest: @entity.guest, lolo: "settle", leg: @entity.leg } { emit: { success: KERNEL_SETTLED, failure: KERNEL_SETTLE_FAILED } })
      KERNEL_SETTLED -> ready when (= (array/len (object/get (default (as ?result KSettled) { runs: [] }) "runs")) 0)
        (set @entity.legSettle false)
        (emit KERNEL_NEXT { left: @entity.runLeft })
      KERNEL_SETTLED -> ready when (> (array/len (object/get (default (as ?result KSettled) { runs: [] }) "runs")) 0)
        (let ((settled : KSettled (default (as ?result KSettled) { runs: [] })))
          (set @entity.last (object/set @entity.last "q" (array/map @settled.runs (fn r { trait: @r.trait, event: @r.event, payload: (default @r.payload {}), seen: (default @r.payload {}), at: -1, seed: false, row: "", completion: true, src: "", run: @r.run, runRow: @r.entityId })))))
        (emit KERNEL_NEXT { left: @entity.runLeft })
      KERNEL_SETTLE_FAILED -> ready
        (set @entity.legSettle false)
        (set @entity.leg "")
        (set @entity.legRow "")
        (emit KERNEL_FAILED { error: (str/concat "The leg's $MOUNT work could not settle: " (default ?error "")) })
      KERNEL_NEXT -> ready when (and (> @entity.runLeft 0) (or (> (array/len @entity.last.q) 0) (> (array/len @entity.last.next) 0)) (not (and (= (array/len @entity.last.q) 0) (> (array/len @entity.last.next) 0) @entity.legSettle (!= @entity.leg ""))))
        (set @entity.runLeft (- @entity.runLeft 1))
        (let ((acc : KRun @entity.last))
         (let ((ask : KAsk
                (if (and (= (array/len @acc.q) 0) (> (array/len @acc.next) 0))
                  { wait: false, request: { trait: "" }, acc: { q: (array/take @acc.next 1), states: @acc.states, frames: @acc.frames, outcomes: @acc.outcomes, emitted: @acc.emitted, collapsed: @acc.collapsed, seen: [], pending: (array/concat @acc.pending @acc.nextPending), later: @acc.later, scopes: @acc.scopes, refused: @acc.refused, next: (array/drop @acc.next 1), nextPending: [], held: @acc.held, paints: @acc.paints, navs: @acc.navs, directives: @acc.directives } }
                (if (= (array/len @acc.q) 0)
                  { wait: false, request: { trait: "" }, acc: { q: @acc.q, states: @acc.states, frames: @acc.frames, outcomes: @acc.outcomes, emitted: @acc.emitted, collapsed: @acc.collapsed, seen: @acc.seen, pending: @acc.pending, later: @acc.later, scopes: @acc.scopes, refused: @acc.refused, next: @acc.next, nextPending: @acc.nextPending, held: @acc.held, paints: @acc.paints, navs: @acc.navs, directives: @acc.directives } }
                  (let ((it : KItem (default (array/first @acc.q) { trait: "", event: "", payload: {}, seen: {}, at: -1, seed: false, row: "", completion: false, src: "" }))
                        (rest : [KItem] (array/drop @acc.q 1)))
                    (if (and (>= @it.at 0) (array/includes @entity.browser @it.trait)) { wait: false, request: { trait: "" }, acc: { q: @rest, states: @acc.states, frames: @acc.frames, outcomes: @acc.outcomes, emitted: @acc.emitted, collapsed: @acc.collapsed, seen: @acc.seen, pending: @acc.pending, later: @acc.later, scopes: @acc.scopes, refused: @acc.refused, next: @acc.next, nextPending: @acc.nextPending, held: @acc.held, paints: @acc.paints, navs: @acc.navs, directives: @acc.directives } } (if (and (array/includes @acc.pending @it.trait) (not (and (< @it.at 0) (array/includes ["INIT", "LOAD", "$MOUNT"] @it.event))))
                      { wait: false, request: { trait: "" }, acc: { q: @rest, states: @acc.states, frames: @acc.frames, outcomes: @acc.outcomes, emitted: @acc.emitted, collapsed: @acc.collapsed, seen: @acc.seen, pending: @acc.pending, later: @acc.later, scopes: @acc.scopes, refused: @acc.refused, next: @acc.next, nextPending: @acc.nextPending, held: (array/concat @acc.held [@it]), paints: @acc.paints, navs: @acc.navs, directives: @acc.directives } }
                      (let ((slot : string (if (or (= @it.row "") (and (= @it.at -2) (not (array/some @entity.routes (fn rt (and (= @rt.trait @it.trait) @rt.keyed)))))) @it.trait (str/concat @it.trait "#" @it.row))))
                       (let ((from : string (object/get @acc.states @slot (object/get @entity.initial @it.trait "")))
                            (entry : boolean (and @it.seed (= @it.trait (default (array/first @acc.scopes) ""))))
                            (share : KShare (object/get @entity.shares @it.trait { key: "", intrinsic: [] })))
                       (let ((fslot : string (if (= @share.key "") @slot (if (= @it.row "") @share.key (str/concat @share.key "#" @it.row))))
                             (oslot : string (str/concat "own::" @slot)))
                       (let ((framed : boolean (object/has @acc.frames @fslot))
                             (frame : SExpr (if (or (= @share.key "") (= (array/len @share.intrinsic) 0))
                                              (object/get (object/get @acc.frames @fslot { row: {} }) "row")
                                              (object/merge (default (as (object/get (object/get @acc.frames @fslot { row: {} }) "row") KRowMap) {}) (default (as (object/get (object/get @acc.frames @oslot { row: {} }) "row") KRowMap) {})))))
                        (if (and (not @it.completion) (array/includes @acc.seen (if @framed (value/key [@slot @it.event @from @it.payload @frame]) (value/key [@slot @it.event @from @it.payload "!unframed"]))))
                          (let ((flush : boolean (and @it.seed (not (array/some @rest (fn x @x.seed))))))
                            { wait: false, request: { trait: "" }, acc: { q: (let ((q0 : [KItem] (if @flush (array/concat @rest @acc.later) @rest)) (ds : [KDirective] (if @flush @acc.directives []))) (array/reduce @ds @q0 (fn (moved d) (if @d.front (array/concat (array/filter @moved (fn x (= @x.event @d.event))) (array/filter @moved (fn x (!= @x.event @d.event)))) (array/concat (array/filter @moved (fn x (!= @x.event @d.event))) (array/filter @moved (fn x (= @x.event @d.event)))))))), states: @acc.states, frames: @acc.frames, outcomes: @acc.outcomes, emitted: @acc.emitted, collapsed: (array/concat @acc.collapsed [{ trait: @it.trait, event: @it.event, payload: (default @it.seen {}) }]), seen: @acc.seen, pending: @acc.pending, later: (if @flush [] @acc.later), scopes: @acc.scopes, refused: @acc.refused, next: @acc.next, nextPending: @acc.nextPending, held: @acc.held, paints: @acc.paints, navs: @acc.navs, directives: (if @flush [] @acc.directives) } })
                          { wait: true, request: (object/merge (if (= @it.at -2) (if @framed (if (= @it.row "") { trait: @it.trait, from: @from, tick: @it.event, entity: @frame } { trait: @it.trait, from: @from, tick: @it.event, entity: @frame, entityId: @it.row }) (if (= @it.row "") { trait: @it.trait, from: @from, tick: @it.event } { trait: @it.trait, from: @from, tick: @it.event, entityId: @it.row })) (if @framed
                                                  (if (< @it.at 0)
                                                    (if (= @it.row "")
                                                      { trait: @it.trait, from: @from, event: @it.event, payload: @it.payload, entity: @frame, entry: @entry }
                                                      { trait: @it.trait, from: @from, event: @it.event, payload: @it.payload, entity: @frame, entityId: @it.row, entry: @entry })
                                                    (if (= @it.event "$MOUNT")
                                                      (if (= @it.row "")
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, mount: { route: (object/get (default (as @it.payload KMountAsk) { route: "" }) "route") }, entity: @frame }
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, mount: { route: (object/get (default (as @it.payload KMountAsk) { route: "" }) "route") }, entity: @frame, entityId: @it.row })
                                                      (if (= @it.row "")
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, emitter: @it.src, payload: @it.payload, entity: @frame }
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, emitter: @it.src, payload: @it.payload, entity: @frame, entityId: @it.row })))
                                                  (if (< @it.at 0)
                                                    (if (= @it.row "")
                                                      { trait: @it.trait, from: @from, event: @it.event, payload: @it.payload, entry: @entry }
                                                      { trait: @it.trait, from: @from, event: @it.event, payload: @it.payload, entityId: @it.row, entry: @entry })
                                                    (if (= @it.event "$MOUNT")
                                                      (if (= @it.row "")
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, mount: { route: (object/get (default (as @it.payload KMountAsk) { route: "" }) "route") } }
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, mount: { route: (object/get (default (as @it.payload KMountAsk) { route: "" }) "route") }, entityId: @it.row })
                                                      (if (= @it.row "")
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, emitter: @it.src, payload: @it.payload }
                                                        { trait: @it.trait, from: @from, delivery: { at: @it.at }, emitter: @it.src, payload: @it.payload, entityId: @it.row }))))) (if (= @entity.leg "") {} (if (!= (default @it.run "") "") { leg: @entity.leg, run: (default @it.run ""), entityId: (default @it.runRow "") } (if (= @it.row "") { leg: @entity.leg, entityId: @entity.legRow } { leg: @entity.leg })))), acc: @acc }))))))))))))
          (if @ask.wait
            (if (or @entity.attached (!= @entity.leg ""))
              (kernel/commit @entity.guest @ask.request { emit: { success: KERNEL_STEPPED, failure: KERNEL_STEP_REFUSED } })
              (emit KERNEL_STEPPED { step: (kernel/step @entity.guest @ask.request) }))
            (do
              (set @entity.last @ask.acc)
              (emit KERNEL_NEXT { left: @entity.runLeft })))))
      KERNEL_STEP_REFUSED -> ready
        (set @entity.states @entity.last.states)
        (set @entity.frames @entity.last.frames)
        (set @entity.leg "")
        (set @entity.legRow "")
        (set @entity.legFallback "")
        (emit KERNEL_FAILED { error: (str/concat "A step was refused: " ?error) })
      KERNEL_STEPPED -> ready
        (let ((acc : KRun @entity.last)
              (r : KStep (default (as ?step KStep) { fired: false, to: "!kernel/step answer did not fit KStep", before: {}, entity: {}, emits: [], delivered: true, key: "", keyRequired: false })))
         (if (and (not @r.delivered) (!= (default @r.failure "") ""))
          (do
           (set @entity.states @entity.last.states)
           (set @entity.frames @entity.last.frames)
           (set @entity.leg "")
           (set @entity.legRow "")
           (set @entity.legFallback "")
           (emit KERNEL_FAILED { error: (str/concat "A step was refused: " (default @r.failure "")) }))
         (let ((it : KItem (default (array/first @acc.q) { trait: "", event: "", payload: {}, seen: {}, at: -1, seed: false, row: "", completion: false, src: "" }))
               (rest : [KItem] (array/drop @acc.q 1)))
                      (let ((slot : string (if (or (= @it.row "") (and (= @it.at -2) (not (array/some @entity.routes (fn rt (and (= @rt.trait @it.trait) @rt.keyed)))))) @it.trait (str/concat @it.trait "#" @it.row))))
                       (let ((from : string (object/get @acc.states @slot (object/get @entity.initial @it.trait "")))
                            (entry : boolean (and @it.seed (= @it.trait (default (array/first @acc.scopes) ""))))
                            (share : KShare (object/get @entity.shares @it.trait { key: "", intrinsic: [] })))
                       (let ((fslot : string (if (= @share.key "") @slot (if (= @it.row "") @share.key (str/concat @share.key "#" @it.row))))
                             (oslot : string (str/concat "own::" @slot)))
                       (let ((orbital : string (object/get @entity.orbitals @it.trait "")))
                        (let ((after : KRun (array/reduce [@r] @acc (fn (acc r)
                            (if (default @r.keyRequired false)
                              (let ((row : string (default @r.key ""))
                                    (fresh : boolean (not (object/has @acc.states (str/concat @it.trait "#" (default @r.key ""))))))
                                { q: (array/concat
                                       (if (and @fresh (array/some @entity.rows (fn w (and (= (object/get @w "trait") @it.trait) (= (object/get @w "event") "INIT") (= (object/get @w "from") (object/get @entity.initial @it.trait ""))))))
                                         [{ trait: @it.trait, event: "INIT", payload: {}, seen: {}, at: -1, seed: false, row: @row, completion: false, src: "" }]
                                         [])
                                       [{ trait: @it.trait, event: @it.event, payload: @it.payload, seen: @it.seen, at: @it.at, seed: false, row: @row, completion: @it.completion, src: @it.src }]
                                       @rest),
                                  states: (if @fresh (object/set @acc.states (str/concat @it.trait "#" @row) (object/get @entity.initial @it.trait "")) @acc.states),
                                  frames: @acc.frames, outcomes: @acc.outcomes, emitted: @acc.emitted, collapsed: @acc.collapsed, seen: @acc.seen, pending: @acc.pending, later: @acc.later, scopes: @acc.scopes, refused: @acc.refused, next: @acc.next, nextPending: @acc.nextPending, held: @acc.held, paints: @acc.paints, navs: @acc.navs, directives: @acc.directives })
                              (let ((heard : [KStepEmit] @r.emits)
                                    (more : boolean (and @it.seed (array/some @rest (fn x @x.seed)))))
                               (let ((own : [KItem] (array/map (array/filter @r.emits (fn e (array/some @entity.rows (fn w (and (= (object/get @w "trait") @it.trait) (= (object/get @w "from") @r.to) (= (object/get @w "event") @e.event))))))
                                                      (fn e { trait: @it.trait, event: @e.event, payload: (default @e.payload {}), seen: (default @e.seen {}), at: -1, seed: false, row: @it.row, completion: (default @e.completion false), src: "" })))
                                     (seedFan : [KItem]
                                         (array/map (array/filter @entity.routes (fn rt (and @it.seed (= (object/get @rt "event") @it.event)
                                                                                           (or (!= (object/get @rt "trigger") @it.event) (not (array/includes @acc.scopes (object/get @rt "trait"))))
                                                                                           (or (= (object/get @rt "sourceKind") "any")
                                                                                               (and (= (object/get @rt "sourceTrait") @it.trait) (= (object/get @rt "sourceOrbital") @orbital))))))
                                           (fn rt { trait: (object/get @rt "trait"), event: (object/get @rt "trigger"), payload: (default @it.payload {}), seen: (default @it.seen {}), at: (object/get @rt "at"), seed: false, row: "", completion: false, src: @it.trait })))
                                     (emitFan : [KItem]
                                       (array/flatten (array/map @heard (fn e
                                         (array/map (array/filter @entity.routes (fn rt (and (= (object/get @rt "event") @e.event)
                                                                                           (or (= (object/get @rt "sourceKind") "any")
                                                                                               (and (= (object/get @rt "sourceTrait") @it.trait) (= (object/get @rt "sourceOrbital") @orbital))))))
                                           (fn rt { trait: (object/get @rt "trait"), event: (object/get @rt "trigger"), payload: (default @e.payload {}), seen: (default @e.seen {}), at: (object/get @rt "at"), seed: false, row: "", completion: (default @e.completion false), src: @it.trait })))))))
                               (let ((lifecycle : boolean (and (< @it.at 0) (array/includes @acc.pending @it.trait) (array/includes ["INIT", "LOAD", "$MOUNT"] @it.event))))
                               (let ((rejectFan : [KItem]
                                       (array/map (array/filter @entity.routes (fn rt (and (!= (default @r.deliveryRejected null) null) (= (object/get @rt "event") "DELIVERY_REJECTED")
                                                                                         (or (= (object/get @rt "sourceKind") "any")
                                                                                             (and (= (object/get @rt "sourceTrait") @it.src) (= (object/get @rt "sourceOrbital") (object/get @entity.orbitals @it.src "")))))))
                                         (fn rt { trait: (object/get @rt "trait"), event: (object/get @rt "trigger"), payload: (default @r.deliveryRejected {}), seen: (default @r.deliveryRejected {}), at: (object/get @rt "at"), seed: false, row: "", completion: false, src: @it.src }))))
                               (let ((fanned : [KItem] (array/concat (if @lifecycle (array/filter @acc.held (fn h (= @h.trait @it.trait))) []) @seedFan @emitFan @rejectFan)))
                               (let ((dropRow : boolean (and (default @r.quiet false) (!= @it.row "")
                                                             (not (array/some (array/concat @own @rest @fanned @acc.later @acc.held) (fn x (and (= @x.trait @it.trait) (= @x.row @it.row))))))))
                                { q: (let ((q0 : [KItem] (if (!= (default @r.rejected "") "") []
                                       (if @it.seed
                                         (if @more (array/concat @rest @own) (array/concat @rest @own @acc.later @fanned))
                                         (array/concat @own @rest @fanned)))) (ds : [KDirective] (if @it.seed (if @more [] (array/concat @acc.directives (default @r.queue []))) (default @r.queue [])))) (array/reduce @ds @q0 (fn (moved d) (if @d.front (array/concat (array/filter @moved (fn x (= @x.event @d.event))) (array/filter @moved (fn x (!= @x.event @d.event)))) (array/concat (array/filter @moved (fn x (!= @x.event @d.event))) (array/filter @moved (fn x (= @x.event @d.event)))))))),
                                  directives: (if @it.seed (if @more (array/concat @acc.directives (default @r.queue [])) []) @acc.directives),
                                  later: (if (!= (default @r.rejected "") "") [] (if @it.seed (if @more (array/concat @acc.later @fanned) []) @acc.later)),
                                  scopes: @acc.scopes,
                                  refused: (default @r.rejected ""),
                                  next: @acc.next, nextPending: @acc.nextPending,
                                  held: (if @lifecycle (array/filter @acc.held (fn h (!= @h.trait @it.trait))) @acc.held),
                                  states: (if @dropRow (object/omit @acc.states [@slot]) (if @r.delivered (object/set @acc.states @slot @r.to) @acc.states)),
                                  frames: (if @dropRow (object/omit @acc.frames [@fslot @oslot]) (if @r.delivered
                                              (if (= (default @r.entity null) null) @acc.frames (if (or (= @share.key "") (= (array/len @share.intrinsic) 0))
                                                (object/set @acc.frames @fslot { row: @r.entity })
                                                (object/set (object/set @acc.frames @fslot { row: (object/omit (default (as @r.entity KRowMap) {}) @share.intrinsic) }) @oslot { row: (object/pick (default (as @r.entity KRowMap) {}) @share.intrinsic) })))
                                            @acc.frames)),
                                  outcomes: (if @r.delivered (array/concat @acc.outcomes [{ trait: @it.trait, event: (if (= @it.at -2) "" (if (= @it.event "$MOUNT") (object/get (default (array/find @entity.routes (fn rt (and (= @rt.trait @it.trait) (= @rt.at @it.at)))) { orbital: "", trait: "", at: -1, trigger: "", event: "", sourceKind: "any", sourceOrbital: "", sourceTrait: "", keyed: false, guarded: false, mapped: false }) "trigger") @it.event)), from: @from, to: @r.to, fired: @r.fired }]) @acc.outcomes),
                                  emitted: (array/concat @acc.emitted (array/map @r.emits (fn e { trait: @it.trait, event: @e.event, payload: (default @e.seen {}) }))),
                                  paints: (array/concat @acc.paints (default @r.rendered [])),
                                  navs: (array/concat @acc.navs (default @r.navigations [])),
                                  collapsed: @acc.collapsed,
                                  seen: (if (and @r.delivered (not @it.completion)) (array/concat @acc.seen [(value/key [@slot @it.event @from @it.payload (default @r.before {})])] (if (object/has @acc.frames @fslot) [] [(value/key [@slot @it.event @from @it.payload "!unframed"])])) @acc.seen),
                                  pending: (array/filter @acc.pending (fn p (or (!= @p @it.trait) (not (and (< @it.at 0) (array/includes ["INIT", "LOAD", "$MOUNT"] @it.event)))))) })))))))
                          ))))
                         (do
                          (set @entity.last @after)
                          (emit KERNEL_NEXT { left: @entity.runLeft }))))))))))
    }

    emits {
      KERNEL_MACHINE_READ -> internal { program : SExpr! }
      KERNEL_OPEN_ASK -> internal { program : SExpr!, route : string? }
      KERNEL_FACTS_READ -> internal { program : SExpr! }
      KERNEL_RUN -> internal { items : [KItem]!, next : [KItem]!, pending : [string]! }
      KERNEL_NEXT -> internal { left : number! }
      KERNEL_STEPPED -> internal { step : SExpr! }
      KERNEL_STEP_REFUSED -> internal { error : string!, kind : string! }
      KERNEL_READ -> internal { result : KReadAnswer! }
      KERNEL_CHECK -> internal { }
      KERNEL_GUEST -> internal { result : KOpenAnswer! }
      KERNEL_FRAMES -> external { rows : [KRowOut]! }
        @description "The row each trait and keyed row the .lolo kernel has stepped holds now (a trait on a shared entity: the shared row with its own intrinsic fields), for a parity check to compare with the native kernel's rows."
        @tier "domain"
      KERNEL_OPENED -> external { initial : Map string string! }
        @description "The program is open on the .lolo kernel: each trait's initial state."
        @tier "domain"
      KERNEL_FAILED -> external { error : string! }
        @description "The program could not be read, opened or read as a machine."
        @tier "domain"
      KERNEL_DISPATCHED -> external { states : Map string string!, outcomes : [KOutcome]!, emitted : [KEmit]!, collapsed : [KCollapsed]!, cut : boolean!, refused : string!, rendered : [KPaint]!, navigations : [KNav]! }
        @description "One dispatch ran: every delivery considered in order, what was emitted, what was collapsed, whether the cap cut it, and the refusal that stopped it (empty when none): an entry payload that breaks its declared event, or an emit that breaks its emitter's declaration."
        @tier "domain"
    }

    listens {
      KERNEL_LOAD -> input { program : SExpr!, route : string? }
        @description "Load a resolved program (.orb IR, as program/read { resolve } answers it) on the .lolo kernel. route is the route its guest opens on (program/open { route }), so the boot seeds the kernel reads from that open are the ones a native open on the same route runs; absent, the guest opens as program/open does with no route (the [initial] page, else the first route page)."
      KERNEL_MOUNT -> input { route : string!, boot : boolean! }
        @description "Mount a page by its path, or boot for the boot pages; boot true mounts the boot pages in the same batch, as opening a program on a route does."
      KERNEL_DISPATCH -> input { trait : string!, event : string!, payload : SExpr? }
        @description "Dispatch one event to a trait."
      KERNEL_ATTACH -> input { program : SExpr!, guest : string!, browser : [string]? }
        @description "Adopt a hosted guest already opened with program/open { mount: false } for the .lolo kernel to run: read its program as KERNEL_LOAD does, without opening another; from then on every step commits (kernel/commit), so the guest keeps what the kernel runs. browser names the traits the guest's viewer runs (program/open's browserRuns): no listener delivery goes to them on this kernel, as a split guest's own kernel leaves them to the browser (EXEC-ENDPOINT-3a)."
      KERNEL_MOUNT_SEEDS -> input { route : string, seeds : [KSeed]! }
        @description "Run a mount the guest's open named (program/open { mount: false } answers its seeds and route): the route's $MOUNT deliveries first, then each seed's lifecycle event in order, one at a time."
      KERNEL_LEG -> input { guest : string!, leg : string!, run : KLegRun!, states : Map string string! }
        @description "Run a split guest's server leg (what program/dispatch { lolo: \"begin\" } answered for the attached guest): its states first, then the run as KERNEL_DISPATCH (targeted), KERNEL_MOUNT_SEEDS (mount), one seed per trait (discover), or a completion the guest's host held (completion: its route event as a seed that is never collapsed; a run its kernel refuses, by the payload or by an emit, runs the completion's failure route instead with { error, kind: invalid, key }, EXEC-QUEUE-10), or a tick the guest's host held (tick: one run per row its begin named, as KERNEL_TICK runs one), every step committed into the leg (kernel/commit { leg }); answers KERNEL_DISPATCHED, and program/dispatch { lolo: \"finish\", leg } answers the leg."
      KERNEL_TICK -> input { ticks : [KTickRan]! }
        @description "Run ticks: each named tick of its trait, in order, each as its own run, once per row the host named in rows (an empty id runs on no row); a keyed trait's state is held per row, another's on the trait; the host's clock decides which ticks are due (EXEC-TICK-5)."
      KERNEL_FRAMES_READ -> input { }
        @description "Answer KERNEL_FRAMES: the rows the .lolo kernel holds."
      KERNEL_READ { result : KReadAnswer! }
      KERNEL_GUEST { result : KOpenAnswer! }
      KERNEL_OPEN_FAILED { error : string }
      KERNEL_ROWS { rows : [KRow]! }
      KERNEL_FACTS { routes : [KRoute]!, mounts : [KMount]!, hosts : [KHost]! }
      KERNEL_MACHINE_UNREAD { }
      KERNEL_SETTLED { result : SExpr }
      KERNEL_SETTLE_FAILED { error : string }
      KernelParity.KERNEL_ATTACH -> KERNEL_ATTACH
      KernelParity.KERNEL_MOUNT_SEEDS -> KERNEL_MOUNT_SEEDS
      KernelParity.KERNEL_DISPATCH -> KERNEL_DISPATCH
      KernelParity.KERNEL_TICK -> KERNEL_TICK
      KernelParity.KERNEL_FRAMES_READ -> KERNEL_FRAMES_READ
      KernelMachine.MACHINE_ANSWERED -> KERNEL_ROWS
      KernelMachine.MACHINE_FACTS -> KERNEL_FACTS
      KernelMachine.MACHINE_UNREAD -> KERNEL_MACHINE_UNREAD
      KernelOpener.KERNEL_OPENER_GUEST -> KERNEL_GUEST
      KernelOpener.KERNEL_OPENER_FAILED -> KERNEL_OPEN_FAILED
    }
  }

  trait KernelOpener -> KernelRun [server] {
    initial: ready

    state ready {
      INIT -> ready
      KERNEL_OPEN_ASK -> ready when (= ?route null)
        (program/open ?program {} { emit: { success: KERNEL_OPENER_OPENED, failure: KERNEL_OPENER_REFUSED } })
      KERNEL_OPEN_ASK -> ready when (!= ?route null)
        (program/open ?program { route: ?route } { emit: { success: KERNEL_OPENER_OPENED, failure: KERNEL_OPENER_REFUSED } })
      KERNEL_OPENER_OPENED -> ready
        (emit KERNEL_OPENER_GUEST { result: ?result })
      KERNEL_OPENER_REFUSED -> ready
        (emit KERNEL_OPENER_FAILED { error: (default ?error "the program could not be opened") })
    }

    emits {
      KERNEL_OPENER_GUEST -> internal { result : KOpenAnswer! }
        @description "The guest KERNEL_LOAD's program opened as, for the kernel to step."
      KERNEL_OPENER_FAILED -> internal { error : string! }
        @description "The program could not be opened as a guest."
    }

    listens {
      KernelDispatch.KERNEL_OPEN_ASK -> KERNEL_OPEN_ASK
      KERNEL_OPEN_ASK {
        program : SExpr!
        route : string?
      }
      KERNEL_OPENER_OPENED {
        result : KOpenAnswer!
      }
      KERNEL_OPENER_REFUSED {
        error : string
      }
    }
  }


  entity ParityRun [runtime] {
    id : string!
    native : string! = ""
    route : string! = ""
    program : KHeldProgram?
    loloSeeds : [KSeed]! = []
    loloRoute : string! = ""
    script : [KScriptStep]! = []
    at : number! = 0
    judging : number! @description "The step being judged: -1 the mount, else the script step." = -1
    orbitals : [string]! = []
    orbitalAt : number! = 0
    nativeStates : Map string string! = {}
    nativeOutcomes : [KNativeOutcome]! = []
    nativeEmitted : [KNativeEmit]! = []
    nativeRows : [KNativeRow]! = []
    nativeRefused : string! = ""
    loloStates : Map string string! = {}
    loloOutcomes : [KOutcome]! = []
    loloEmitted : [KEmit]! = []
    loloRefused : string! = ""
    results : [KCompare]! = []
  }

  trait KernelParity -> ParityRun [server] {
    initial: idle

    state idle {
      INIT -> idle
      PARITY_RUN -> opening
        (set @entity.route (default ?route ""))
        (set @entity.script ?script)
        (set @entity.at 0)
        (set @entity.results [])
        (set @entity.orbitals (array/map (object/get (default (as ?program KProgram) { orbitals: [] }) "orbitals") (fn o (object/get @o "name"))))
        (set @entity.program (as ?program KHeldProgram))
        (if (= ?route null)
          (program/open ?program { drawSeed: "parity" } { emit: { success: PARITY_NATIVE_OPENED, failure: PARITY_FAILED_IN } })
          (program/open ?program { route: ?route, drawSeed: "parity" } { emit: { success: PARITY_NATIVE_OPENED, failure: PARITY_FAILED_IN } }))
    }

    state opening {
      INIT -> opening
      PARITY_NATIVE_OPENED -> opening
        (set @entity.native ?result.guest)
        (set @entity.nativeStates ?result.states)
        (set @entity.nativeOutcomes ?result.outcomes)
        (set @entity.nativeEmitted (default ?result.emitted []))
        (set @entity.nativeRefused "")
        (if (= @entity.route "")
          (program/open @entity.program { mount: false, drawSeed: "parity" } { emit: { success: PARITY_LOLO_OPENED, failure: PARITY_FAILED_IN } })
          (program/open @entity.program { mount: false, route: @entity.route, drawSeed: "parity" } { emit: { success: PARITY_LOLO_OPENED, failure: PARITY_FAILED_IN } }))
      PARITY_LOLO_OPENED -> opening
        (set @entity.loloSeeds ?result.seeds)
        (set @entity.loloRoute (default ?result.route ""))
        (emit KERNEL_ATTACH { program: (default @entity.program { orbitals: [] }), guest: ?result.guest, browser: [] })
      PARITY_LOADED -> mounting
        (emit KERNEL_MOUNT_SEEDS { route: @entity.loloRoute, seeds: @entity.loloSeeds })
      PARITY_FAILED_IN -> idle
        (emit PARITY_FAILED { error: (default ?error "the program could not be opened") })
    }

    state mounting {
      INIT -> mounting
      PARITY_KERNEL_DONE -> judging
        (set @entity.judging -1)
        (set @entity.loloStates ?states)
        (set @entity.loloOutcomes ?outcomes)
        (set @entity.loloEmitted ?emitted)
        (set @entity.loloRefused ?refused)
        (set @entity.nativeRows [])
        (set @entity.orbitalAt 0)
        (emit PARITY_ROWS_NEXT { })
    }

    state judging {
      INIT -> judging
      PARITY_ROWS_NEXT -> judging when (and (= @entity.nativeRefused "") (< @entity.orbitalAt (array/len @entity.orbitals)))
        (program/inputs { state: (default (array/nth @entity.orbitals @entity.orbitalAt) ""), frames: true, guest: @entity.native, emit: { success: PARITY_NATIVE_ROWS, failure: PARITY_FAILED_IN } })
      PARITY_NATIVE_ROWS -> judging
        (set @entity.nativeRows (array/concat @entity.nativeRows (object/get (object/get (default (as ?result KNativeReflect) { state: { orbital: "", traits: [] } }) "state") "traits")))
        (set @entity.orbitalAt (+ @entity.orbitalAt 1))
        (emit PARITY_ROWS_NEXT { })
      PARITY_ROWS_NEXT -> judging when (or (!= @entity.nativeRefused "") (>= @entity.orbitalAt (array/len @entity.orbitals)))
        (emit KERNEL_FRAMES_READ { })
      PARITY_LOLO_ROWS -> stepping
        (let ((s : KScriptStep (if (< @entity.judging 0) { trait: "", event: "mount", payload: {} } (default (array/nth @entity.script @entity.judging) { trait: "", event: "", payload: {} })))
              (statesEqual : boolean (= (value/key (object/fromEntries (array/map (object/keys @entity.nativeStates) (fn k [@k (object/get @entity.loloStates @k "")])))) (value/key @entity.nativeStates)))
              (outcomesEqual : boolean (= (value/key (array/map @entity.nativeOutcomes (fn o (value/key [@o.trait (if @o.fired (default @o.event "") "") @o.from @o.to @o.fired])))) (value/key (array/map @entity.loloOutcomes (fn o (value/key [@o.trait (if @o.fired (default @o.event "") "") @o.from @o.to @o.fired]))))))
              (emitsEqual : boolean (= (value/key (array/map @entity.nativeEmitted (fn e (value/key [@e.event (default @e.payload {})]))))
                                       (value/key (array/map @entity.loloEmitted (fn e (value/key [@e.event (default @e.payload {})]))))))
              (rowsOff : [KRowOut] (array/filter ?rows (fn l
                (let ((n : KNativeRow (default (array/find @entity.nativeRows (fn x (and (= @x.trait @l.trait) (= @x.entityId (if (= @l.row "") "singleton" @l.row))))) { trait: "", entityId: "", state: "" })))
                  (or (= @n.trait "") (!= (value/key (default @n.entity {})) (value/key (default @l.entity {})))))))))
          (let ((differs : [string] (if (!= @entity.nativeRefused "")
                                      (if (= @entity.nativeRefused (str/concat "program/dispatch: " @entity.loloRefused)) [] ["refusal"])
                                      (array/concat
                                        (if (= @entity.loloRefused "") [] ["refusal"])
                                        (if @statesEqual [] ["states"])
                                        (if @outcomesEqual [] ["outcomes"])
                                        (if @emitsEqual [] ["emits"])
                                        (array/map @rowsOff (fn l (str/concat "row " @l.trait (if (= @l.row "") "" (str/concat "#" @l.row)))))))))
            (set @entity.results (array/concat @entity.results [{ step: @entity.judging, trait: @s.trait, event: @s.event,
              equal: (= (array/len @differs) 0), differs: @differs,
              nativeStates: @entity.nativeStates, loloStates: @entity.loloStates, nativeOutcomes: @entity.nativeOutcomes, loloOutcomes: @entity.loloOutcomes,
              nativeEmitted: @entity.nativeEmitted, loloEmitted: @entity.loloEmitted,
              nativeRows: (array/filter @entity.nativeRows (fn x (array/some @rowsOff (fn l (and (= @x.trait @l.trait) (= @x.entityId (if (= @l.row "") "singleton" @l.row))))))),
              loloRows: @rowsOff,
              nativeRefused: @entity.nativeRefused, loloRefused: @entity.loloRefused }]))))
        (set @entity.at (+ @entity.judging 1))
        (emit PARITY_NEXT { })
      PARITY_FAILED_IN -> idle
        (emit PARITY_FAILED { error: (default ?error "the native rows could not be read") })
    }

    state stepping {
      INIT -> stepping
      PARITY_NEXT -> idle when (>= @entity.at (array/len @entity.script))
        (emit PARITY_ANSWERED { equal: (array/every @entity.results (fn c (object/get @c "equal"))), results: @entity.results })
      PARITY_NEXT -> stepping when (and (< @entity.at (array/len @entity.script)) (default (object/get (default (array/nth @entity.script @entity.at) { trait: "", event: "", payload: {} }) "tickPass") false))
        (program/tick { guest: @entity.native, emit: { success: PARITY_NATIVE_TICKED, failure: PARITY_NATIVE_REFUSED } })
      PARITY_NATIVE_TICKED -> stepping
        (set @entity.nativeStates ?result.states)
        (set @entity.nativeOutcomes ?result.outcomes)
        (set @entity.nativeEmitted (default ?result.emitted []))
        (set @entity.nativeRefused "")
        (emit KERNEL_TICK { ticks: ?result.ran })
      PARITY_NEXT -> stepping when (and (< @entity.at (array/len @entity.script)) (not (default (object/get (default (array/nth @entity.script @entity.at) { trait: "", event: "", payload: {} }) "tickPass") false)))
        (let ((s : KScriptStep (default (array/nth @entity.script @entity.at) { trait: "", event: "", payload: {} })))
          (program/dispatch (str/concat @s.trait "." @s.event) @s.payload { guest: @entity.native, emit: { success: PARITY_NATIVE_DONE, failure: PARITY_NATIVE_REFUSED } }))
      PARITY_NATIVE_DONE -> stepping
        (set @entity.nativeStates ?result.states)
        (set @entity.nativeOutcomes ?result.outcomes)
        (set @entity.nativeEmitted (default ?result.emitted []))
        (set @entity.nativeRefused "")
        (let ((s : KScriptStep (default (array/nth @entity.script @entity.at) { trait: "", event: "", payload: {} })))
          (emit KERNEL_DISPATCH { trait: @s.trait, event: @s.event, payload: @s.payload }))
      PARITY_NATIVE_REFUSED -> stepping
        (set @entity.nativeOutcomes [])
        (set @entity.nativeEmitted [])
        (set @entity.nativeRefused (default ?error "the native dispatch failed"))
        (let ((s : KScriptStep (default (array/nth @entity.script @entity.at) { trait: "", event: "", payload: {} })))
          (emit KERNEL_DISPATCH { trait: @s.trait, event: @s.event, payload: @s.payload }))
      PARITY_KERNEL_DONE -> judging
        (set @entity.judging @entity.at)
        (set @entity.loloStates ?states)
        (set @entity.loloOutcomes ?outcomes)
        (set @entity.loloEmitted ?emitted)
        (set @entity.loloRefused ?refused)
        (set @entity.nativeRows [])
        (set @entity.orbitalAt 0)
        (emit PARITY_ROWS_NEXT { })
      PARITY_FAILED_IN -> idle
        (emit PARITY_FAILED { error: (default ?error "a native dispatch failed") })
    }

    emits {
      KERNEL_ATTACH -> internal { program : KHeldProgram!, guest : string!, browser : [string]? }
      KERNEL_MOUNT_SEEDS -> internal { route : string, seeds : [KSeed]! }
      KERNEL_DISPATCH -> internal { trait : string!, event : string!, payload : SExpr! }
      KERNEL_TICK -> internal { ticks : [KTickRan]! }
      KERNEL_FRAMES_READ -> internal { }
      PARITY_NEXT -> internal { }
      PARITY_ROWS_NEXT -> internal { }
      PARITY_ANSWERED -> external { equal : boolean!, results : [KCompare]! }
        @description "The program ran on both kernels: equal when, after the mount and after each step, every trait the native answer reports is in the same state on the .lolo kernel, the outcome lists match, the emits match in order with their payloads, and every row the .lolo kernel holds equals the native kernel's row of that trait; each result is the mount (step -1) or one script step, and differs names what did not match (states, outcomes, emits, refusal, row <Trait>[#<row>])."
        @tier "domain"
      PARITY_FAILED -> external { error : string! }
        @description "A native open, dispatch or row read failed, so parity could not be judged."
        @tier "domain"
    }

    listens {
      PARITY_RUN -> input { program : SExpr!, route : string?, script : [KScriptStep]! }
        @description "Run a resolved program on the native kernel and the .lolo kernel side by side: open it on route (absent: as program/open opens with no route), then play the script, comparing states, outcomes, emits and rows after the mount and after each step."
      PARITY_NATIVE_OPENED { result : KNativeOpen! }
      PARITY_LOLO_OPENED { result : KLoloOpen! }
      PARITY_NATIVE_DONE { result : KNative! }
      PARITY_FAILED_IN { error : string }
      PARITY_NATIVE_REFUSED { error : string }
      PARITY_NATIVE_TICKED { result : KNativeTick! }
      PARITY_NATIVE_ROWS { result : SExpr }
      PARITY_LOADED { initial : Map string string! }
      PARITY_KERNEL_DONE { states : Map string string!, outcomes : [KOutcome]!, emitted : [KEmit]!, collapsed : [KCollapsed]!, cut : boolean!, refused : string!, rendered : [KPaint]!, navigations : [KNav]! }
      PARITY_LOLO_ROWS { rows : [KRowOut]! }
      KernelDispatch.KERNEL_OPENED -> PARITY_LOADED
      KernelDispatch.KERNEL_DISPATCHED -> PARITY_KERNEL_DONE
      KernelDispatch.KERNEL_FRAMES -> PARITY_LOLO_ROWS
    }
  }

  page boot as KernelDispatchStart -> KernelDispatch, KernelMachine, KernelOpener, KernelParity
}
