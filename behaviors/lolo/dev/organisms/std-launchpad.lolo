app std-launchpad [
  version: "4.0.0",
  theme: "linear-clean-light",
  themes: ["game-sci-fi-dark"],
  exec: ["orb", "aws", "bq", "gcloud", "gh", "ssh"],
  env: ["PATH", "HOME", "NODE_ENV", "AUTH_PROVIDER", "OIDC_ISSUER_URL", "OIDC_AUDIENCE", "FIREBASE_PROJECT_ID", "FIREBASE_SERVICE_ACCOUNT_PATH", "FIREBASE_AUTH_EMULATOR_HOST", "FIRESTORE_EMULATOR_HOST", "ALMADAR_INTEGRATIONS_MODE"],
  sys: [memory, cpu],
  fs: { "~/.almadar/launchpad": [create], "~/.almadar/launchpad/**": [read, write, create] },
  description: "std-launchpad — the dashboard of orb's own operations that bare `orb` (orb launchpad) opens in the browser, always on production credentials. It composes its apps statically: the ops boards std-ci-status, std-aws-board, std-ci-run-logs, std-app-hosting-board, std-cloud-run-board, std-training-board and std-llm-spend-board, and the dev playground std-behavior-playground, each with every trait of its page, so each board's server traits run on the launchpad's own server under the launchpad's grants. Its tab bar is Home (the dashboard) plus one tab per opened app: Open on a tile or a recent adds the tab and shows the board's own view in it, with `@trait.X` embedding; switching tabs switches the view and every open board keeps its state; closing a tab removes the board's view (its trait keeps its state, as any trait does when its view is not shown). A board is inert until its Load is pressed: its INIT only draws its view (the loadOnInit knobs stay false), so opening the launchpad reads nothing from GitHub, AWS or Google. No program is spawned and no port is taken. Home holds Recent (the opens remembered per machine in ~/.almadar/launchpad/recents.json by std-launchpad-recents, those of the boards knob's apps shown, each reopening its tab), Open now (the tabs, with Open and Close; a click on a failing row of the CI status tab opens or focuses the CI run logs tab and reads that run), the tiles of the boards knob (id, label, topic and a one-line description, in the sections the sections knob names), the Orb view (std-launchpad-orb: this machine as one orb with its CPU and memory, one star of the same size for each open tab, coloured by its topic, the recent ones not open dimmed on an outer ring; a click on a star opens, closes or reopens its tab), the machine's memory, CPU, load and uptime (std-system-stats) and the orb's own version, uptime and kernel counters (std-orb-stats). The top bar holds AUTH_PROVIDER and the problems std-boot-env-check reports for this machine. The app header grants exactly what the composed boards and the stats use, one line per key: exec is orb (the version) and the CLIs the boards run (aws and ssh for the AWS and training boards, gcloud and bq for Cloud Run and App Hosting, gh for CI run logs); env is the variables the boot gate reads (std-http-boot-gate reads ALMADAR_INTEGRATIONS_MODE too, and the launchpad ignores a mock value there) with PATH and HOME for the CLIs; egress lists the GitHub, App Hosting, Cloud Monitoring, OpenRouter, DeepSeek, Moonshot, local kernel-server (127.0.0.1:3000) and OpenAI hosts the boards and the playground call, the LLM spend board's four taken from its own header. std-analytics-collector is deliberately not composed: it would add an unauthenticated `analytics` beacon endpoint to the launchpad's server. Serve it with `orb launchpad`.",
  egress: ["https://api.github.com", "https://firebaseapphosting.googleapis.com", "https://monitoring.googleapis.com", "https://openrouter.ai", "https://api.deepseek.com", "https://api.moonshot.ai", "http://127.0.0.1:3000", "https://api.openai.com"]
]
;; @capabilities "open an orb operations board or the behavior playground as a tab and run it live, switch between open apps, close an app, see the memory and cpu of this machine, see the orb's version and kernel counters, remember recent opens"

uses Layout from "std/behaviors/std-workspace-layout"
uses Recents from "std/behaviors/std-launchpad-recents"
uses Orb from "std/behaviors/std-launchpad-orb"
uses Stats from "std/behaviors/std-system-stats"
uses OrbStats from "std/behaviors/std-orb-stats"
uses Gate from "std/behaviors/std-http-boot-gate"
uses EnvCheck from "std/behaviors/std-boot-env-check"
uses Ci from "std/behaviors/std-ci-status"
uses Aws from "std/behaviors/std-aws-board"
uses Logs from "std/behaviors/std-ci-run-logs"
uses Ah from "std/behaviors/std-app-hosting-board"
uses Cr from "std/behaviors/std-cloud-run-board"
uses Tr from "std/behaviors/std-training-board"
uses Llm from "std/behaviors/std-llm-spend-board"
uses Play from "std/behaviors/std-behavior-playground"

type LaunchpadSection = { topic : string!, title : string!, run : string! }
type LaunchpadBoard = { id : string!, label : string!, topic : string!, description : string! }
type LaunchpadTab = { id : string!, label : string!, topic : string! }
type LaunchpadProcess = { pid : number!, rssKb : number! }
type LaunchpadRecent = { behavior : string!, label : string!, kind : string!, command : string!, route : string!, at : number! }
type LaunchpadGateEnv = { authProvider : string, oidcIssuerUrl : string, oidcAudience : string, firebaseProjectId : string, firebaseServiceAccountPath : string, firebaseAuthEmulatorHost : string, firestoreEmulatorHost : string, integrationsMock : boolean }
type OrbMachine = { label : string!, detail : string! }
type OrbStar = { id : string!, label : string!, kind : string!, state : "starting" | "running" | "stopped"!, weight : number!, detail : string! }
type OrbClicked = { id : string!, label : string, group : string, size : number, color : string }

orbital Launchpad {
  entity LaunchpadView [runtime] {
    id : string!
    tabs : [LaunchpadTab] = []
    active : string @description "The id of the open tab in front; empty is Home." = ""
    openTabs : [LaunchpadTab] = []
    recents : [LaunchpadRecent] = []
    authProvider : string = ""
    problems : [string] = []
    envChecked : boolean = false
    envMock : boolean = false
    orbUptimeMs : number = 0
    statsReady : boolean = false
    memoryTotal : number = 0
    memoryUsed : number = 0
    memoryPercent : number = 0
    cpuPercent : number = 0
    load1 : number = 0
    machineUptime : number = 0
    statsUnavailable : [string] = []
    statsErrors : Map string string = {}
    orbVersion : string = ""
    kernelReady : boolean = false
    registeredSchemas : number = 0
    registeredTraits : number = 0
    activeInstances : number = 0
    cachedEntities : number = 0
  }

  config {
    boards : [LaunchpadBoard] = [{ id: "almadar-std/std-ci-status", label: "std-ci-status", topic: "ops", description: "The latest GitHub Actions run of every repository of an organization, as one board; Load reads it from GitHub." }, { id: "almadar-std/std-aws-board", label: "std-aws-board", topic: "ops", description: "One AWS region at a glance: instances, volumes, buckets, quotas and cost, read through the aws CLI." }, { id: "almadar-std/std-ci-run-logs", label: "std-ci-run-logs", topic: "ops", description: "The failed-job log of one GitHub Actions run, read through the gh CLI." }, { id: "almadar-std/std-app-hosting-board", label: "std-app-hosting-board", topic: "ops", description: "A Firebase App Hosting project's backends, rollouts and logs, read through the App Hosting API and the gcloud CLI." }, { id: "almadar-std/std-cloud-run-board", label: "std-cloud-run-board", topic: "ops", description: "A Google Cloud project's Cloud Run services and this month's cost, read through the gcloud and bq CLIs." }, { id: "almadar-std/std-training-board", label: "std-training-board", topic: "ops", description: "The model-training instances of one AWS region, read through the aws and ssh CLIs." }, { id: "almadar-std/std-llm-spend-board", label: "std-llm-spend-board", topic: "ops", description: "What LLM providers cost: the OpenRouter key's usage and limit, the DeepSeek and Moonshot balances, and the token spend a kernel server reports." }, { id: "almadar-std/std-behavior-playground", label: "std-behavior-playground", topic: "dev", description: "Browse every installed behavior by package and topic, run one live, explore its state machines and read its source." }]
      @label "Boards"
      @description "The composed apps the launchpad offers, in order: id (the behavior name), label, topic and a one-line description. Each id must be one of the apps the launchpad composes; an id not composed has no view to show."
    sections : [LaunchpadSection] = [{ topic: "ops", title: "Ops", run: "Open" }, { topic: "dev", title: "Tools", run: "Open" }]
      @label "Sections"
      @description "The topics shown as tile sections, in order, with each section's heading and the text of its Open button."
    title : string = "Orb"
      @label "Title"
  }

  trait LaunchpadFrame = Layout.traits.WorkspaceLayout -> LaunchpadView {
    config {
      mainTrait: @trait.LaunchpadStage
      showSidebar: false
      showBottomPanel: false
      showStatusBar: false
      showTopBar: true
      topBarTrait: @trait.LaunchpadTopBar
    }
  }
  trait CiStatus = Ci.traits.CiStatus {
    config {
      org: "almadar-io"
    }
  }
  trait CiGithub = Ci.traits.CiGithub {}
  trait CiRetry = Ci.traits.CiRetry {}
  trait AwsStatus = Aws.traits.AwsStatus {}
  trait AwsCli = Aws.traits.AwsCli {}
  trait CiRunLogs = Logs.traits.CiRunLogs {
    listens {
      LaunchpadStage.RUN_LOGS_LOAD -> CI_LOGS_LOAD
      CiLogsGh.CLI_DONE -> CI_LOGS_RAN
      CiLogsGh.CLI_FAILED -> CI_LOGS_GH_FAILED
    }
  }
  trait CiLogsGh = Logs.traits.CiLogsGh {}
  trait AppHostingStatus = Ah.traits.AppHostingStatus {
    config {
      project: "kflow-b3a39"
      region: "europe-west4"
      backends: ["almadar-analytics", "almadar-builder-server", "almadar-kflow-server", "kflow-server", "almadar-inspection-server", "almadar-iram-server", "almadar-kekec-server", "almadar-trait-wars-server", "almadar-alummaalraqamia-server", "almadar-blaz-klemenc-server"]
    }
  }
  trait AhGcloud = Ah.traits.AhGcloud {}
  trait CloudRunStatus = Cr.traits.CloudRunStatus {
    config {
      project: "kflow-b3a39"
    }
  }
  trait CrGcloud = Cr.traits.CrGcloud {}
  trait CrBq = Cr.traits.CrBq {}
  trait TrainingStatus = Tr.traits.TrainingStatus {}
  trait TrAws = Tr.traits.TrAws {}
  trait TrSsh = Tr.traits.TrSsh {}
  trait LlmSpend = Llm.traits.LlmSpend {}
  trait PlaygroundFrame = Play.traits.PlaygroundFrame {}
  trait PlaygroundTopBar = Play.traits.PlaygroundTopBar {
    config {
      heading: "Behavior playground"
    }
  }
  trait PlaygroundTopics = Play.traits.PlaygroundTopics {}
  trait PlaygroundStage = Play.traits.PlaygroundStage {}
  trait PlaygroundLoader = Play.traits.PlaygroundLoader {}
  trait BehaviorCatalog = Play.traits.BehaviorCatalog {
    config {
      loadOnInit: false
    }
    listens {
      BehaviorCatalogLlm.LLM_EMBED_RESULT -> EMBEDDED
      BehaviorCatalogLlm.LLM_FAILED -> SEARCH_FAILED
      PlaygroundTopics.TOPIC_PICKED -> TOPIC
      LaunchpadStage.PLAYGROUND_OPENED -> CATALOG_LOAD
      EMBEDDED {
        embeddings : [[number]]!
      }
      SEARCH_FAILED {
        code : string
        message : string!
      }
      SEARCH {
        searchTerm : string!
      }
      PICK {
        behavior : string!
      }
      DESCRIBE {
        behavior : string!
      }
      TOGGLE {
        behavior : string!
        checked : boolean!
      }
      SELECTION {
        behaviors : [string]!
      }
      TOPIC {
        package : string!
        topic : string!
      }
      RETRY
      CATALOG_LOAD
    }
  }
  trait BehaviorCatalogLlm = Play.traits.BehaviorCatalogLlm {}
  trait PlaygroundCosmic = Play.traits.PlaygroundCosmic {}
  trait PlaygroundInspector = Play.traits.PlaygroundInspector {}
  trait PlaygroundStatus = Play.traits.PlaygroundStatus {}
  trait PlaygroundRuntime = Play.traits.PlaygroundRuntime {}

  trait RecentsStore = Recents.traits.RecentsStore {
    listens {
      LaunchpadHome.RECENTS_LOAD -> RECENTS_LOAD
      LaunchpadHome.RECENT_ADD -> RECENT_ADD
    }
  }

  trait SystemStatsMeter = Stats.traits.SystemStatsMeter {
    listens {
      LaunchpadHome.STATS_START -> STATS_START
    }
  }

  trait OrbStatsReader = OrbStats.traits.OrbStatsReader {
    listens {
      LaunchpadHome.ORB_STATS_ASK -> ORB_STATS_ASK
      SystemStatsMeter.STATS_READ -> ORB_STATS_ASK
      OrbVersionRunner.CLI_DONE -> ORB_VERSION_DONE
      OrbVersionRunner.CLI_FAILED -> ORB_VERSION_FAILED
    }
  }
  trait OrbVersionRunner = OrbStats.traits.OrbVersionRunner {}

  trait SystemOrb = Orb.traits.SystemOrb {
    config {
      hint: "Each star is an open app, coloured by its topic; all stars are the same size because nothing in-process measures an app honestly. Click one to open, close or reopen its tab."
      colors: { ops: "var(--color-success)", dev: "var(--color-info)" }
    }
    listens {
      LaunchpadHome.ORB_STATE -> ORB_STATE
      NODE_CLICK {
        node : OrbClicked!
      }
      STAR_OPEN {
        id : string!
      }
      STAR_STOP {
        id : string!
      }
      STAR_RELAUNCH {
        id : string!
      }
    }
  }

  trait BootGuard = Gate.traits.BootGate {
    config {
      mock: false
      calledServices: []
    }
    listens {
      BootCheck.ENV_CHECKED -> ENV_CHECKED
    }
  }
  trait BootCheck = EnvCheck.traits.BootEnvCheck {
    listens {
      BootGuard.ENV_CHECK -> ENV_CHECK
    }
  }

  trait LaunchpadTopBar -> LaunchpadView [client] {
    config {
      heading : string = @config.title
        @label "Title"
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (emit LAUNCHPAD_BAR_SHOWN {})
      LAUNCHPAD_BAR_SHOWN -> idle
        (render-ui main { type: stack, direction: horizontal, align: center, justify: between, gap: md, className: "px-4 py-2 flex-wrap", children: [
          { type: stack, direction: horizontal, align: center, gap: sm, children: [
            { type: icon, name: orbit, size: md },
            { type: typography, content: @config.heading, variant: h4, weight: semibold }
          ] },
          { type: stack, direction: horizontal, align: center, gap: md, className: "flex-wrap", children: [
            { type: badge, label: (if (= @entity.authProvider "") "AUTH_PROVIDER not set" (str/concat "AUTH_PROVIDER " @entity.authProvider)), variant: (if (= @entity.authProvider "") warning default) },
            { type: badge, label: (if (not @entity.envChecked) "Checking the environment" (if @entity.envMock "ALMADAR_INTEGRATIONS_MODE=mock is set: the check is skipped" (if (= (array/len @entity.problems) 0) "Credentials present" (str/concat (array/len @entity.problems) " environment problems")))), variant: (if (not @entity.envChecked) default (if @entity.envMock warning (if (= (array/len @entity.problems) 0) success warning))) }
          ] }
        ] })
      GATE_ENV -> idle
        (set @entity.authProvider (or ?env.authProvider ""))
        (set @entity.envMock ?mock)
        (emit LAUNCHPAD_BAR_SHOWN {})
        (emit ENV_CHANGED { authProvider: @entity.authProvider, problems: @entity.problems, envChecked: @entity.envChecked, envMock: @entity.envMock })
      GATE_CHECKED -> idle
        (set @entity.problems ?problems)
        (set @entity.envChecked true)
        (emit LAUNCHPAD_BAR_SHOWN {})
        (emit ENV_CHANGED { authProvider: @entity.authProvider, problems: @entity.problems, envChecked: @entity.envChecked, envMock: @entity.envMock })
    }

    emits {
      LAUNCHPAD_BAR_SHOWN
      ENV_CHANGED -> external {
        authProvider : string!
        problems : [string]!
        envChecked : boolean!
        envMock : boolean!
      }
        @description "The environment check or the gate's variables changed."
    }

    listens {
      BootGuard.ENV_CHECK -> GATE_ENV
      BootCheck.ENV_CHECKED -> GATE_CHECKED
      GATE_ENV {
        env : LaunchpadGateEnv!
        production : boolean!
        mock : boolean!
        missingCredentials : [string]
        catalogError : string
      }
      GATE_CHECKED {
        requestId : number
        problems : [string]!
        ok : boolean!
      }
    }
  }

  trait LaunchpadStage -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit TABS_SHOWN {})
      TABS_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: none, className: "h-full min-h-0", children: [
          { type: stack, direction: horizontal, align: center, gap: sm, className: "px-4 py-2 border-b flex-nowrap overflow-x-auto", children: [
            { type: button, label: "Home", icon: home, variant: (if (= @entity.active "") primary ghost), size: sm, action: TAB_HOME },
            { type: stack, direction: horizontal, align: center, gap: sm, className: "flex-nowrap", children: (array/map @entity.tabs (fn t { type: stack, direction: horizontal, align: center, gap: none, children: [{ type: button, label: @t.label, variant: (if (= @t.id @entity.active) primary ghost), size: sm, className: "whitespace-nowrap", action: TAB_SELECT, actionPayload: { id: @t.id } }, { type: button, icon: x, variant: ghost, size: sm, aria-label: (str/concat "Close " @t.label), action: TAB_CLOSE, actionPayload: { id: @t.id } }] })) }
          ] },
          { type: box, className: (if (= @entity.active "") "flex-1 min-h-0" "hidden"), children: [@trait.LaunchpadHome] },
          { type: box, className: (if (= @entity.active "almadar-std/std-ci-status") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-status"))) [@trait.CiStatus] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-aws-board") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-aws-board"))) [@trait.AwsStatus] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-ci-run-logs") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-run-logs"))) [@trait.CiRunLogs] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-app-hosting-board") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-app-hosting-board"))) [@trait.AppHostingStatus] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-cloud-run-board") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-cloud-run-board"))) [@trait.CloudRunStatus] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-training-board") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-training-board"))) [@trait.TrainingStatus] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-llm-spend-board") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-llm-spend-board"))) [@trait.LlmSpend] []) },
          { type: box, className: (if (= @entity.active "almadar-std/std-behavior-playground") "flex-1 min-h-0 overflow-auto" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-behavior-playground"))) [@trait.PlaygroundFrame] []) }
        ] })
      TAB_OPEN -> ready when (array/some @entity.tabs (fn t (= @t.id ?behavior)))
        (set @entity.active ?behavior)
        (when (= ?behavior "almadar-std/std-behavior-playground") (emit PLAYGROUND_OPENED {}))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_OPEN -> ready when (not (array/some @entity.tabs (fn t (= @t.id ?behavior))))
        (set @entity.tabs (array/append @entity.tabs { id: ?behavior, label: ?label, topic: ?topic }))
        (set @entity.active ?behavior)
        (when (= ?behavior "almadar-std/std-behavior-playground") (emit PLAYGROUND_OPENED {}))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      LOGS_OPEN -> ready when (and (array/some @config.boardList (fn b (= @b.id "almadar-std/std-ci-run-logs"))) (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-run-logs"))))
        (set @entity.active "almadar-std/std-ci-run-logs")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit RUN_LOGS_LOAD { owner: ?owner, repo: ?repo, runId: ?runId })
      LOGS_OPEN -> ready when (and (array/some @config.boardList (fn b (= @b.id "almadar-std/std-ci-run-logs"))) (not (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-run-logs")))))
        (let ((b (array/find @config.boardList (fn x (= @x.id "almadar-std/std-ci-run-logs"))))) (set @entity.tabs (array/append @entity.tabs { id: "almadar-std/std-ci-run-logs", label: @b.label, topic: @b.topic })))
        (set @entity.active "almadar-std/std-ci-run-logs")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit RUN_LOGS_LOAD { owner: ?owner, repo: ?repo, runId: ?runId })
      TAB_HOME -> ready
        (set @entity.active "")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_SELECT -> ready when (array/some @entity.tabs (fn t (= @t.id ?id)))
        (set @entity.active ?id)
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_CLOSE -> ready
        (set @entity.tabs (array/filter @entity.tabs (fn t (!= @t.id ?id))))
        (set @entity.active (if (= @entity.active ?id) "" @entity.active))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TABS_PUSH -> ready
        (emit TABS_CHANGED { tabs: @entity.tabs, active: @entity.active })
    }

    emits {
      TABS_SHOWN
      TABS_PUSH { }
        @description "Internal: hand Home the tabs as they stand."
        @tier "internal"
      PLAYGROUND_OPENED -> external {
      }
        @description "The playground tab was opened: its catalog starts listing the installed behaviors."
      TABS_CHANGED -> external {
        tabs : [LaunchpadTab]!
        active : string!
      }
        @description "The open tabs and the one in front (empty is Home)."
      RUN_LOGS_LOAD -> external {
        owner : string!
        repo : string!
        runId : string!
      }
        @description "The run whose log the run-logs tab reads: sent after that tab is open and in front."
    }

    listens {
      LaunchpadHome.TAB_OPEN -> TAB_OPEN
      LaunchpadHome.HOME_FOCUS -> TAB_SELECT
      LaunchpadHome.HOME_CLOSE -> TAB_CLOSE
      CiStatus.CI_RUN_SELECTED -> LOGS_OPEN
      LOGS_OPEN {
        owner : string!
        repo : string!
        runId : string!
      }
      TABS_SHOWN { }
      TABS_PUSH { }
      PLAYGROUND_OPENED { }
      TAB_OPEN {
        behavior : string!
        label : string!
        topic : string!
      }
      TAB_HOME { }
      TAB_SELECT {
        id : string!
      }
      TAB_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadHome -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
      sectionList : [LaunchpadSection] = @config.sections
        @label "Sections"
        @tier "presentation"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit RECENTS_LOAD {})
        (emit STATS_START {})
        (emit ORB_STATS_ASK {})
        (emit HOME_SHOWN {})
      HOME_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: lg, className: "h-full overflow-y-auto p-6", children: [
          { type: stack, direction: vertical, gap: xs, className: (if (= (array/len @entity.recents) 0) "hidden" ""), children: [
            { type: typography, content: "Recent", variant: overline, color: muted },
            { type: stack, direction: horizontal, gap: sm, className: "flex-wrap", children: (array/map @entity.recents (fn r { type: button, label: (str/concat @r.label " · " (time/relative @r.at)), variant: secondary, size: sm, className: "rounded-full", action: APP_OPEN, actionPayload: { behavior: @r.behavior } })) }
          ] },
          { type: simple-grid, cols: 2, minChildWidth: 420, gap: lg, children: [
            { type: stack, direction: vertical, gap: lg, children: [
              { type: stack, direction: vertical, gap: xs, children: [
                { type: typography, content: "Open now", variant: overline, color: muted },
                { type: typography, content: "Nothing is open. Open an app below and it gets a tab.", variant: body, color: muted, className: (if (= (array/len @entity.openTabs) 0) "" hidden) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @entity.openTabs (fn t { type: card, padding: sm, children: [
                  { type: stack, direction: horizontal, align: center, justify: between, gap: md, className: "flex-wrap", children: [
                    { type: stack, direction: horizontal, align: center, gap: sm, className: "flex-wrap", children: [
                      { type: typography, content: @t.label, variant: body, weight: medium },
                      { type: badge, label: @t.topic, variant: default }
                    ] },
                    { type: stack, direction: horizontal, align: center, gap: sm, children: [
                      { type: button, label: "Open", variant: secondary, size: sm, action: TAB_FOCUS_PICK, actionPayload: { id: @t.id } },
                      { type: button, label: "Close", variant: ghost, size: sm, action: TAB_CLOSE_PICK, actionPayload: { id: @t.id } }
                    ] }
                  ] }
                ] })) }
              ] },
              { type: stack, direction: vertical, gap: lg, children: (array/map @config.sectionList (fn sec { type: stack, direction: vertical, gap: xs, children: [
                { type: typography, content: @sec.title, variant: overline, color: muted },
                { type: typography, content: "Nothing to open here.", variant: body, color: muted, className: (if (= (array/count @config.boardList (fn a (= @a.topic @sec.topic))) 0) "" hidden) },
                { type: simple-grid, minChildWidth: 240, gap: md, children: (array/map (array/filter @config.boardList (fn a (= @a.topic @sec.topic))) (fn a { type: card, padding: md, children: [
                  { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, content: @a.label, variant: h5, weight: semibold },
                    { type: typography, content: @a.description, variant: caption, color: muted, overflow: clamp-3 },
                    { type: stack, direction: horizontal, align: center, gap: sm, children: [
                      { type: button, label: @sec.run, variant: primary, size: sm, action: APP_OPEN, actionPayload: { behavior: @a.id } },
                      { type: button, label: "Close", variant: ghost, size: sm, action: TAB_CLOSE_PICK, actionPayload: { id: @a.id }, className: (if (array/some @entity.openTabs (fn t (= @t.id @a.id))) "" hidden) },
                      { type: badge, label: "open", variant: success, className: (if (array/some @entity.openTabs (fn t (= @t.id @a.id))) "" hidden) }
                    ] }
                  ] }
                ] })) }
              ] })) }
            ] },
            { type: stack, direction: vertical, gap: lg, children: [
              { type: box, children: [@trait.SystemOrb] },
              { type: card, padding: md, children: [
                { type: stack, direction: vertical, gap: sm, children: [
                  { type: typography, content: "This machine", variant: overline, color: muted },
                  { type: simple-grid, minChildWidth: 110, gap: sm, children: [
                    { type: stat-display, label: "CPU", value: (if @entity.statsReady (str/concat (math/round @entity.cpuPercent 0) "%") "…"), size: sm },
                    { type: stat-display, label: "Memory", value: (if @entity.statsReady (str/concat (math/round @entity.memoryPercent 0) "%") "…"), size: sm },
                    { type: stat-display, label: "Used", value: (if @entity.statsReady (format/bytes @entity.memoryUsed) "…"), size: sm },
                    { type: stat-display, label: "Load", value: (if @entity.statsReady (math/round @entity.load1 2) "…"), size: sm },
                    { type: stat-display, label: "Up", value: (if @entity.statsReady (time/duration (* 1000 @entity.machineUptime)) "…"), size: sm }
                  ] },
                  { type: typography, content: (str/concat "Not available: " (str/join (array/map @entity.statsUnavailable (fn u (str/concat @u " (" (object/get @entity.statsErrors @u "") ")"))) "; ")), variant: caption, color: muted, className: (if (= (array/len @entity.statsUnavailable) 0) "hidden" "") },
                  { type: typography, content: "Orb", variant: overline, color: muted },
                  { type: simple-grid, minChildWidth: 110, gap: sm, children: [
                    { type: stat-display, label: "Version", value: (if (= @entity.orbVersion "") "…" @entity.orbVersion), size: sm },
                    { type: stat-display, label: "Orb up", value: (if @entity.kernelReady (time/duration @entity.orbUptimeMs) "…"), size: sm },
                    { type: stat-display, label: "Kernel traits", value: (if @entity.kernelReady @entity.registeredTraits "…"), size: sm },
                    { type: stat-display, label: "Kernel instances", value: (if @entity.kernelReady @entity.activeInstances "…"), size: sm }
                  ] },
                  { type: typography, content: (str/concat "Not read: " (str/join (array/map (array/filter ["version", "kernel"] (fn k (object/has @entity.statsErrors @k))) (fn k (str/concat @k " (" (object/get @entity.statsErrors @k "") ")"))) "; ")), variant: caption, color: muted, className: (if (= (array/count ["version", "kernel"] (fn k (object/has @entity.statsErrors @k))) 0) "hidden" "") }
                ] }
              ] }
            ] }
          ] },
          { type: alert, variant: warning, title: "Environment problems", message: (str/join @entity.problems "; "), className: (if (or @entity.envMock (not @entity.envChecked) (= (array/len @entity.problems) 0)) "hidden" "") },
          { type: typography, content: (str/concat (if (= @entity.authProvider "") "AUTH_PROVIDER not set" (str/concat "AUTH_PROVIDER " @entity.authProvider)) " · " (if @entity.envChecked (str/concat (array/len @entity.problems) " environment problems") "checking the environment")), variant: caption, color: muted }
        ] })
      TABS_CHANGED -> ready
        (set @entity.openTabs ?tabs)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_LOADED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_CHANGED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_FAILED -> ready
        (render-ui toast { type: alert, variant: error, message: (str/concat "Recent opens: " ?error) })
      ENV_CHANGED -> ready
        (set @entity.authProvider ?authProvider)
        (set @entity.problems ?problems)
        (set @entity.envChecked ?envChecked)
        (set @entity.envMock ?envMock)
        (emit HOME_SHOWN {})
      STATS_READ -> ready
        (set @entity.statsReady true)
        (set @entity.memoryTotal ?memoryTotal)
        (set @entity.memoryUsed ?memoryUsed)
        (set @entity.memoryPercent ?memoryPercent)
        (set @entity.cpuPercent ?cpuPercent)
        (set @entity.load1 ?load1)
        (set @entity.machineUptime ?uptimeSeconds)
        (set @entity.statsUnavailable ?unavailable)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
      ORB_KERNEL_READ -> ready
        (set @entity.kernelReady true)
        (set @entity.registeredSchemas ?registeredSchemas)
        (set @entity.registeredTraits ?registeredTraits)
        (set @entity.activeInstances ?activeInstances)
        (set @entity.cachedEntities ?cachedEntities)
        (set @entity.orbUptimeMs ?uptimeMs)
      ORB_VERSION_READ -> ready
        (set @entity.orbVersion ?version)
        (emit HOME_SHOWN {})
      ORB_STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
        (emit HOME_SHOWN {})
      ORB_PUSH -> ready
        (emit ORB_STATE { machine: { label: (if @entity.statsReady (str/concat "CPU " (math/round @entity.cpuPercent 0) "% · RAM " (math/round @entity.memoryPercent 0) "%") "This machine"), detail: (if @entity.statsReady (str/concat (format/bytes @entity.memoryUsed) " of " (format/bytes @entity.memoryTotal) " in use · load " (math/round @entity.load1 2)) "Reading the machine") }, stars: (array/concat (array/map @entity.openTabs (fn t { id: @t.id, label: @t.label, kind: @t.topic, state: "running", weight: 0, detail: (str/concat @t.topic " · open") })) (array/map (array/filter @entity.recents (fn c (not (array/some @entity.openTabs (fn t (= @t.id @c.behavior)))))) (fn c { id: @c.behavior, label: @c.label, kind: "recent", state: "stopped", weight: 0, detail: (str/concat "not open · last opened " (time/relative @c.at)) }))) })
      APP_OPEN -> ready when (and (array/some @config.boardList (fn a (= @a.id ?behavior))) (array/some @entity.openTabs (fn t (= @t.id ?behavior))))
        (emit HOME_FOCUS { id: ?behavior })
      APP_OPEN -> ready when (and (array/some @config.boardList (fn a (= @a.id ?behavior))) (not (array/some @entity.openTabs (fn t (= @t.id ?behavior)))))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit TAB_OPEN { behavior: ?behavior, label: @a.label, topic: @a.topic }))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit RECENT_ADD { behavior: ?behavior, label: @a.label, kind: "route", command: "", route: "" }))
      TAB_FOCUS_PICK -> ready
        (emit HOME_FOCUS { id: ?id })
      TAB_CLOSE_PICK -> ready
        (emit HOME_CLOSE { id: ?id })
      ORB_OPENED -> ready
        (emit HOME_FOCUS { id: ?id })
      ORB_STOPPED -> ready
        (emit HOME_CLOSE { id: ?id })
      ORB_RELAUNCHED -> ready
        (emit APP_OPEN { behavior: ?id })
    }

    emits {
      HOME_SHOWN
      ORB_PUSH { }
        @description "Internal: hand the orb view the machine and the open tabs as they stand."
        @tier "internal"
      APP_OPEN {
        behavior : string!
      }
        @description "Internal: open a listed app as a tab, or bring its tab to the front."
        @tier "internal"
      RECENTS_LOAD -> external {
      }
        @description "Read the remembered opens."
      RECENT_ADD -> external {
        behavior : string!
        label : string!
        kind : string!
        command : string!
        route : string!
      }
        @description "Remember an open."
      TAB_OPEN -> external {
        behavior : string!
        label : string!
        topic : string!
      }
        @description "Open an app as a tab."
      HOME_FOCUS -> external {
        id : string!
      }
        @description "Bring an open tab to the front."
      HOME_CLOSE -> external {
        id : string!
      }
        @description "Close a tab, which unmounts the app."
      STATS_START -> external {
      }
        @description "Begin sampling the machine."
      ORB_STATS_ASK -> external {
      }
        @description "Read the orb's kernel counters (and its version, the first time)."
      ORB_STATE -> external {
        machine : OrbMachine!
        stars : [OrbStar]!
      }
        @description "The machine and the open tabs around it, for the orb view."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RecentsStore.RECENTS_LOADED -> RECENTS_LOADED
      RecentsStore.RECENTS_CHANGED -> RECENTS_CHANGED
      RecentsStore.RECENTS_FAILED -> RECENTS_FAILED
      LaunchpadTopBar.ENV_CHANGED -> ENV_CHANGED
      SystemStatsMeter.STATS_READ -> STATS_READ
      SystemStatsMeter.STATS_FAILED -> STATS_FAILED
      OrbStatsReader.ORB_KERNEL_READ -> ORB_KERNEL_READ
      OrbStatsReader.ORB_VERSION_READ -> ORB_VERSION_READ
      OrbStatsReader.ORB_STATS_FAILED -> ORB_STATS_FAILED
      SystemOrb.ORB_OPEN -> ORB_OPENED
      SystemOrb.ORB_STOP -> ORB_STOPPED
      SystemOrb.ORB_RELAUNCH -> ORB_RELAUNCHED
      HOME_SHOWN { }
      ORB_PUSH { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RECENTS_LOADED {
        items : [LaunchpadRecent]!
      }
      RECENTS_CHANGED {
        items : [LaunchpadRecent]!
      }
      RECENTS_FAILED {
        error : string!
      }
      ENV_CHANGED {
        authProvider : string!
        problems : [string]!
        envChecked : boolean!
        envMock : boolean!
      }
      STATS_READ {
        memoryTotal : number!
        memoryUsed : number!
        memoryAvailable : number!
        memoryPercent : number!
        cpuPercent : number!
        load1 : number!
        load5 : number!
        load15 : number!
        uptimeSeconds : number!
        processes : [LaunchpadProcess]!
        missing : [number]!
        unavailable : [string]!
        at : number!
      }
      STATS_FAILED {
        stat : "memory" | "cpu" | "load" | "uptime" | "processes"!
        code : string!
        error : string!
      }
      ORB_KERNEL_READ {
        registeredSchemas : number!
        registeredTraits : number!
        activeInstances : number!
        cachedEntities : number!
        uptimeMs : number!
      }
      ORB_VERSION_READ {
        version : string!
      }
      ORB_STATS_FAILED {
        stat : "kernel" | "version"!
        code : string!
        error : string!
      }
      ORB_OPENED {
        id : string!
      }
      ORB_STOPPED {
        id : string!
      }
      ORB_RELAUNCHED {
        id : string!
      }
      APP_OPEN {
        behavior : string!
      }
      TAB_FOCUS_PICK {
        id : string!
      }
      TAB_CLOSE_PICK {
        id : string!
      }
    }
  }

  page "/" as LaunchpadPage -> LaunchpadFrame, LaunchpadTopBar, LaunchpadStage, LaunchpadHome, RecentsStore, BootGuard, BootCheck, SystemOrb, SystemStatsMeter, OrbStatsReader, OrbVersionRunner, CiStatus, CiGithub, CiRetry, AwsStatus, AwsCli, CiRunLogs, CiLogsGh, AppHostingStatus, AhGcloud, CloudRunStatus, CrGcloud, CrBq, TrainingStatus, TrAws, TrSsh, LlmSpend, PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, BehaviorCatalog, BehaviorCatalogLlm, PlaygroundCosmic, PlaygroundInspector, PlaygroundStatus, PlaygroundRuntime
}
