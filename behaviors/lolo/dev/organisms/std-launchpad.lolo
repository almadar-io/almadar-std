app std-launchpad [
  version: "5.0.0",
  theme: "almadar-dark",
  locales: [en, ar, sl],
  themes: ["almadar-heritage-light", "almadar-heritage-dark", "almadar-website-light", "almadar-website-dark", "almadar-light", "aqua-light", "aqua-dark", "arabesque-light", "arabesque-dark", "art-deco-light", "art-deco-dark", "art-nouveau-light", "art-nouveau-dark", "atelier-light", "atelier-dark", "bauhaus-light", "bauhaus-dark", "bloomberg-dense-light", "bloomberg-dense-dark", "blueprint-light", "blueprint-dark", "clay-light", "clay-dark", "comic-light", "comic-dark", "constructivist-light", "constructivist-dark", "corporate-light", "corporate-dark", "cyberpunk-light", "cyberpunk-dark", "frutiger-aero-light", "frutiger-aero-dark", "game-adventure-dark", "game-rpg-dark", "game-sci-fi-dark", "game-ui-pack-dark", "gazette-light", "gazette-dark", "glass-light", "glass-dark", "gothic-light", "gothic-dark", "ink-wash-light", "ink-wash-dark", "kawaii-light", "kawaii-dark", "kflow-light", "kflow-dark", "kiosk-light", "kiosk-dark", "linear-clean-light", "linear-clean-dark", "luxury-light", "luxury-dark", "mac-classic-light", "mac-classic-dark", "material-light", "material-dark", "memphis-light", "memphis-dark", "mid-century-light", "mid-century-dark", "minimalist-light", "minimalist-dark", "mudcloth-light", "mudcloth-dark", "nata-light", "nata-dark", "neon-light", "neon-dark", "neumorphic-light", "neumorphic-dark", "newsprint-light", "newsprint-dark", "notion-editorial-light", "notion-editorial-dark", "orb-light", "orb-dark", "pixel-light", "pixel-dark", "prism-light", "prism-dark", "rawi-light", "rawi-dark", "retro-light", "retro-dark", "risograph-light", "risograph-dark", "scandi-light", "scandi-dark", "sketch-light", "sketch-dark", "solarpunk-light", "solarpunk-dark", "steampunk-light", "steampunk-dark", "swiss-light", "swiss-dark", "terminal-light", "terminal-dark", "trait-wars-light", "trait-wars-dark", "ukiyo-e-light", "ukiyo-e-dark", "vaporwave-light", "vaporwave-dark", "victorian-light", "victorian-dark", "wabi-sabi-light", "wabi-sabi-dark", "win95-light", "win95-dark", "wireframe-light", "wireframe-dark", "zine-light", "zine-dark"],
  exec: [exe, "orb", "ps", "aws", "bq", "gcloud", "gh", "ssh", "kill"],
  kernel: { "guest": [spawn] },
  env: ["PATH", "HOME", "FIREBASE_AUTH_EMULATOR_HOST", "ALMADAR_PERSONA_OWNS", "ALMADAR_VECTORS_DIR", "EMBEDDING_PROVIDER", "EMBEDDING_API_KEY", "OPENAI_API_KEY", "OPEN_ROUTER_API_KEY", "EMBEDDING_MODEL", "LMSTUDIO_EMBEDDING_MODEL"],
  sys: [memory, cpu, self-signal],
  fs: { "~/.almadar/launchpad": [create], "~/.almadar/launchpad/**": [read, write, create], "~/.orb/.update-check.json": [read], cwd: "node_modules/**": [read], "~/.almadar/sidecars/**": [read], "~/.almadar/vectors/**": [read, write, remove, create], env ALMADAR_VECTORS_DIR: "**": [read, write, remove, create] },
  description: "std-launchpad — the dashboard of orb's own operations that bare `orb` (orb launchpad) opens in the browser, always on production credentials. It composes its apps statically: the ops boards std-ci-status (with std-ci-run-logs reading the failing logs its rows open), std-aws-board, std-app-hosting-board, std-cloud-run-board, std-training-board, std-llm-spend-board and std-analytics-board, and the dev playground std-behavior-playground, each with every trait of its page, so each board's server traits run on the launchpad's own server under the launchpad's grants. The frame is std-app-layout in its drawer mode (the navigation behind a menu button): its header carries a State machine button and the theme picker (std-theme-picker over the app's themes list); the button opens a drawer with std-live-machine's whole-page view: every trait mounted on this page (program/self { mounted: true }, EXEC-DIST-15) drawn as a box nested in the trait that embeds it, the non-rendering ones in a background lane, each from its current state and moved live by program/live traces of the page (one per site, EXEC-DIST-14), with the source of the trait that moved last beside it; closing it closes the traces. The frame's drawer lists Home and every program of the boards knob under its section's heading, the one in front highlighted and each open app with its own Close button. Picking a program in the drawer opens it (or brings its view to the front) and shows the board's own view in the stage, with `@trait.X` embedding; picking a sidebar item switches the view and every open board keeps its state; closing an app removes its sidebar item (its trait keeps its state, as any trait does when its view is not shown). Every board is drawn by std-status-board and reads the first time its app is brought to the front (the stage sends APP_SHOWN, which each board view takes as BOARD_OPEN), so opening the launchpad itself reads nothing from GitHub, AWS or Google. No program is spawned and no port is taken. Home is centred at a readable width: the Orb view card beside two stat cards, (std-launchpad-orb: this machine as one orb with its CPU and memory, one star of the same size for each open app, coloured by its topic, the recent ones not open dimmed on an outer ring; a click on a star opens, closes or reopens its app) and the stat cards This machine (memory, CPU, load and uptime, std-system-stats) and Orb runtime (the orb's own version, uptime and kernel counters, std-orb-stats), each with its own note of what it could not read. Home opens with the update banner (std-launchpad-updates: the update record orb keeps in ~/.orb/.update-check.json, read when the launchpad opens and each time Home is shown; Update and Retry run `orb update`). The launchpad has no sign-in and composes no boot gate. Opening a CI row shows its jobs and the failing job's log inline. The app header grants exactly what the composed boards and the stats use, one line per key: exec is orb (the version), ps (the orb process's uptime, which std-orb-stats reads with its pid) and the CLIs the boards run (aws and ssh for the AWS and training boards, gcloud and bq for Cloud Run and App Hosting, gh for CI run logs); env is PATH and HOME for the CLIs; egress is the Google OAuth token endpoint the Google boards connect through (std-gcloud-token); net lists the GitHub, App Hosting, Cloud Monitoring, OpenRouter, DeepSeek, Moonshot, local kernel-server (127.0.0.1:3000) and OpenAI hosts the boards and the playground call, the LLM spend board's four taken from its own header. std-analytics-collector is deliberately not composed: it would add an unauthenticated `analytics` beacon endpoint to the launchpad's server. A path names an app by meaning: /<words> (local.almadar.io/ci, /launch, /cloud-run) mounts the same launchpad with std-vector-match, which matches the words against each board's label, synonyms and description and the homeTexts (the launchpad itself) through the vector store; a confident board opens as its tab, and the launchpad itself, no confident match or a failed match (named in a toast) leaves Home in front. The embedding grants (env, the vector store and package folders, the OpenAI and LM Studio hosts, kill) are std-vector-match's. Serve it with `orb launchpad`.",
  egress: ["https://oauth2.googleapis.com"],
  net: { "api.github.com:443": [tcp], "api.deepseek.com:443": [tcp], "api.moonshot.ai:443": [tcp], "127.0.0.1:3000": [tcp], "openrouter.ai:443": [tcp], "firebaseapphosting.googleapis.com:443": [tcp], "monitoring.googleapis.com:443": [tcp], "api.openai.com:443": [tcp], "127.0.0.1:1234": [tcp], "firestore.googleapis.com:443": [tcp] },
]
uses NotFound from "std/behaviors/std-not-found"
;; @capabilities "open an orb operations board or the behavior playground and run it live, search the programs, switch between open apps from the rail, close an app, see the memory and cpu of this machine, see the orb's version and kernel counters, remember recent opens"

uses Shell from "std/behaviors/std-app-layout"
uses Picker from "std/behaviors/std-theme-picker"
uses Recents from "std/behaviors/std-launchpad-recents"
uses Orb from "std/behaviors/std-launchpad-orb"
uses Stats from "std/behaviors/std-system-stats"
uses OrbStats from "std/behaviors/std-orb-stats"
uses Updates from "std/behaviors/std-launchpad-updates"
uses Ci from "std/behaviors/std-ci-status"
uses Aws from "std/behaviors/std-aws-board"
uses Ah from "std/behaviors/std-app-hosting-board"
uses Cr from "std/behaviors/std-cloud-run-board"
uses Tr from "std/behaviors/std-training-board"
uses Llm from "std/behaviors/std-llm-spend-board"
uses Analytics from "std/behaviors/std-analytics-board"
uses Play from "std/behaviors/std-behavior-playground"
uses Match from "std/behaviors/std-vector-match"
uses Live from "std/behaviors/std-live-machine"

type LaunchpadSection = { topic : string!, title : string!, run : string! }
type LaunchpadBoard = { id : string!, label : string!, icon : string!, topic : string!, description : string!, synonyms : [string]! }
type LaunchpadTab = { id : string!, label : string!, icon : string!, topic : string! }
type LaunchpadProcess = { pid : number!, rssKb : number! }
type LaunchpadRecent = { behavior : string!, label : string!, kind : string!, command : string!, route : string!, at : instant! }
type OrbMachine = { label : string!, detail : string! }
type OrbStar = { id : string!, label : string!, kind : string!, state : "starting" | "running" | "stopped"!, weight : number!, detail : string! }
type OrbClicked = { id : string!, label : string, group : string, size : number, color : string }

orbital Launchpad {
  entity LaunchpadView [runtime] {
    id : string!
    tabs : [LaunchpadTab] = []
    active : string @description "The id of the open app in front; empty is Home." = ""
    openTabs : [LaunchpadTab] = []
    recents : [LaunchpadRecent] = []
    orbUptimeMs : number = 0
    statsReady : boolean = false
    memoryTotal : number = 0
    memoryUsed : number = 0
    memoryPercent : number = 0
    cpuPercent : number = 0
    load1 : number = 0
    machineUptime : number = 0
    statsUnavailable : [string] = []
    statsErrors : Map string string = {}
    orbVersion : string = ""
    kernelReady : boolean = false
    orbUptimeReady : boolean = false
    registeredSchemas : number = 0
    registeredTraits : number = 0
    activeInstances : number = 0
    cachedEntities : number = 0
    cpuHistory : [number] = []
    loadHistory : [number] = []
  }

  config {
    boards : [LaunchpadBoard] = [{ id: "almadar-std/std-ci-status", label: "CI status", icon: "activity", topic: "ops", description: "The CI of the active repositories as one board, failing first; open a row for its jobs and the failing log.", synonyms: ["ci", "continuous integration", "builds", "pipelines", "github actions", "workflows", "tests"] }, { id: "almadar-std/std-aws-board", label: "AWS", icon: "cloud", topic: "ops", description: "One AWS region at a glance: instances, volumes, buckets, quotas and cost, read through the aws CLI.", synonyms: ["aws", "amazon web services", "ec2", "s3", "instances", "buckets"] }, { id: "almadar-std/std-app-hosting-board", label: "App Hosting", icon: "rocket", topic: "ops", description: "A Firebase App Hosting project's backends, rollouts and logs, read through the App Hosting API and the gcloud CLI.", synonyms: ["app hosting", "firebase", "rollouts", "backends", "deploys"] }, { id: "almadar-std/std-cloud-run-board", label: "Cloud Run", icon: "server", topic: "ops", description: "A Google Cloud project's Cloud Run services and this month's cost, read through the gcloud and bq CLIs.", synonyms: ["cloud run", "gcp", "google cloud", "services", "containers"] }, { id: "almadar-std/std-training-board", label: "Training", icon: "brain", topic: "ops", description: "The model-training instances of one AWS region, read through the aws and ssh CLIs.", synonyms: ["training", "model training", "gpu", "machine learning", "fine tuning"] }, { id: "almadar-std/std-llm-spend-board", label: "LLM spend", icon: "wallet", topic: "ops", description: "What LLM providers cost: the OpenRouter key's usage and limit, the DeepSeek and Moonshot balances, and the token spend a kernel server reports.", synonyms: ["llm spend", "llm cost", "openrouter", "tokens", "usage", "billing"] }, { id: "almadar-std/std-analytics-board", label: "Analytics", icon: "bar-chart-3", topic: "ops", description: "The Almadar sites' traffic over the last 30 days: pageviews, unique visitors, top pages and referrers, read from the production collector.", synonyms: ["analytics", "traffic", "visitors", "pageviews", "page views", "referrers", "site stats"] }, { id: "almadar-std/std-behavior-playground", label: "Behavior playground", icon: "flask-conical", topic: "dev", description: "Browse every installed behavior by package and topic, run one live, explore its state machines and read its source.", synonyms: ["playground", "behaviors", "catalog", "behavior catalog", "try a behavior"] }]
      @label "Boards"
      @description "The composed apps the launchpad offers, in order: id (the behavior name), label, icon name, topic, a one-line description. Each id must be one of the apps the launchpad composes; an id not composed has no view to show."
    sections : [LaunchpadSection] = [{ topic: "ops", title: "Ops", run: "Open" }, { topic: "dev", title: "Tools", run: "Open" }]
      @label "Sections"
      @description "The topics the menu groups its programs under, in order, with each group's heading."
    title : string = "Launchpad"
      @label "Title"
    homeTexts : [string] = ["launchpad", "launch", "home", "dashboard", "start"]
      @label "Home words"
      @description "The words that name the launchpad itself in a path: matching one of them by meaning keeps Home in front."
    matchFloor : float = 0.82
      @label "Match floor"
      @description "Minimum cosine score a path's words must reach against an app's texts to open it."
      @tier "policy"
    matchMargin : float = 0.05
      @label "Match margin"
      @description "Minimum gap between the best app and the next one for a path to open it."
      @tier "policy"
  }

  trait LaunchpadFrame = Shell.traits.AppLayout -> LaunchpadView {
    config {
      appName: @config.title
      navItems: []
      contentTrait: @trait.LaunchpadStage
      sidebarTrait: @trait.LaunchpadRail
      headerTrait: @trait.LaunchpadHeader
      layoutMode: drawer
      fullBleed: true
      contentClassName: "w-full h-full"
      showSearch: false
      showNotifications: false
      notifications: []
      showThemeToggle: false
    }
  }
  trait LaunchpadTheme = Picker.traits.ThemePicker {
    config {
      pickerContent: { type: stack, direction: vertical, gap: xs, children: [
        { type: select, aria-label: "Theme", className: "w-44", options: (array/concat [{ value: "", label: @config.defaultLabel }] @config.themes), value: @entity.current, action: THEME_PICKED },
        { type: typography, variant: caption, color: error, className: (if (== @entity.problem "") hidden ""), content: @entity.problem }
      ] }
      themes: [{ value: "almadar-heritage-light", label: "Almadar Heritage light" }, { value: "almadar-heritage-dark", label: "Almadar Heritage dark" }, { value: "almadar-website-light", label: "Almadar Website light" }, { value: "almadar-website-dark", label: "Almadar Website dark" }, { value: "almadar-light", label: "Almadar light" }, { value: "almadar-dark", label: "Almadar dark" }, { value: "aqua-light", label: "Aqua Gel light" }, { value: "aqua-dark", label: "Aqua Gel dark" }, { value: "arabesque-light", label: "Arabesque light" }, { value: "arabesque-dark", label: "Arabesque dark" }, { value: "art-deco-light", label: "Art Deco 1925 light" }, { value: "art-deco-dark", label: "Art Deco 1925 dark" }, { value: "art-nouveau-light", label: "Art Nouveau light" }, { value: "art-nouveau-dark", label: "Art Nouveau dark" }, { value: "atelier-light", label: "Atelier light" }, { value: "atelier-dark", label: "Atelier dark" }, { value: "bauhaus-light", label: "Bauhaus light" }, { value: "bauhaus-dark", label: "Bauhaus dark" }, { value: "bloomberg-dense-light", label: "Bloomberg Dense light" }, { value: "bloomberg-dense-dark", label: "Bloomberg Dense dark" }, { value: "blueprint-light", label: "Blueprint light" }, { value: "blueprint-dark", label: "Blueprint dark" }, { value: "clay-light", label: "Clay light" }, { value: "clay-dark", label: "Clay dark" }, { value: "comic-light", label: "Comic Studio light" }, { value: "comic-dark", label: "Comic Studio dark" }, { value: "constructivist-light", label: "Constructivist light" }, { value: "constructivist-dark", label: "Constructivist dark" }, { value: "corporate-light", label: "Corporate light" }, { value: "corporate-dark", label: "Corporate dark" }, { value: "cyberpunk-light", label: "Cyberpunk HUD light" }, { value: "cyberpunk-dark", label: "Cyberpunk HUD dark" }, { value: "frutiger-aero-light", label: "Frutiger Aero light" }, { value: "frutiger-aero-dark", label: "Frutiger Aero dark" }, { value: "game-adventure-dark", label: "Game: Adventure dark" }, { value: "game-rpg-dark", label: "Game: RPG dark" }, { value: "game-sci-fi-dark", label: "Game: Sci-Fi dark" }, { value: "game-ui-pack-dark", label: "Game: Flat UI dark" }, { value: "gazette-light", label: "Gazette light" }, { value: "gazette-dark", label: "Gazette dark" }, { value: "glass-light", label: "Glass light" }, { value: "glass-dark", label: "Glass dark" }, { value: "gothic-light", label: "Gothic Manuscript light" }, { value: "gothic-dark", label: "Gothic Manuscript dark" }, { value: "ink-wash-light", label: "Ink Wash light" }, { value: "ink-wash-dark", label: "Ink Wash dark" }, { value: "kawaii-light", label: "Kawaii light" }, { value: "kawaii-dark", label: "Kawaii dark" }, { value: "kflow-light", label: "KFlow light" }, { value: "kflow-dark", label: "KFlow dark" }, { value: "kiosk-light", label: "Kiosk light" }, { value: "kiosk-dark", label: "Kiosk dark" }, { value: "linear-clean-light", label: "Linear Clean light" }, { value: "linear-clean-dark", label: "Linear Clean dark" }, { value: "luxury-light", label: "Haute Luxe light" }, { value: "luxury-dark", label: "Haute Luxe dark" }, { value: "mac-classic-light", label: "Classic Mac OS light" }, { value: "mac-classic-dark", label: "Classic Mac OS dark" }, { value: "material-light", label: "Material 3 light" }, { value: "material-dark", label: "Material 3 dark" }, { value: "memphis-light", label: "Memphis 80s light" }, { value: "memphis-dark", label: "Memphis 80s dark" }, { value: "mid-century-light", label: "Mid-Century Modern light" }, { value: "mid-century-dark", label: "Mid-Century Modern dark" }, { value: "minimalist-light", label: "Minimalist light" }, { value: "minimalist-dark", label: "Minimalist dark" }, { value: "mudcloth-light", label: "Mudcloth light" }, { value: "mudcloth-dark", label: "Mudcloth dark" }, { value: "nata-light", label: "Nata light" }, { value: "nata-dark", label: "Nata dark" }, { value: "neon-light", label: "Neon light" }, { value: "neon-dark", label: "Neon dark" }, { value: "neumorphic-light", label: "Neumorphic light" }, { value: "neumorphic-dark", label: "Neumorphic dark" }, { value: "newsprint-light", label: "Newsprint light" }, { value: "newsprint-dark", label: "Newsprint dark" }, { value: "notion-editorial-light", label: "Notion Editorial light" }, { value: "notion-editorial-dark", label: "Notion Editorial dark" }, { value: "orb-light", label: "Orb light" }, { value: "orb-dark", label: "Orb dark" }, { value: "pixel-light", label: "Pixel Quest light" }, { value: "pixel-dark", label: "Pixel Quest dark" }, { value: "prism-light", label: "Prism light" }, { value: "prism-dark", label: "Prism dark" }, { value: "rawi-light", label: "Rawi light" }, { value: "rawi-dark", label: "Rawi dark" }, { value: "retro-light", label: "Retro light" }, { value: "retro-dark", label: "Retro dark" }, { value: "risograph-light", label: "Risograph light" }, { value: "risograph-dark", label: "Risograph dark" }, { value: "scandi-light", label: "Scandinavian light" }, { value: "scandi-dark", label: "Scandinavian dark" }, { value: "sketch-light", label: "Sketchbook light" }, { value: "sketch-dark", label: "Sketchbook dark" }, { value: "solarpunk-light", label: "Solarpunk light" }, { value: "solarpunk-dark", label: "Solarpunk dark" }, { value: "steampunk-light", label: "Steampunk light" }, { value: "steampunk-dark", label: "Steampunk dark" }, { value: "swiss-light", label: "Swiss International light" }, { value: "swiss-dark", label: "Swiss International dark" }, { value: "terminal-light", label: "Terminal light" }, { value: "terminal-dark", label: "Terminal dark" }, { value: "trait-wars-light", label: "Trait Wars light" }, { value: "trait-wars-dark", label: "Trait Wars dark" }, { value: "ukiyo-e-light", label: "Ukiyo-e light" }, { value: "ukiyo-e-dark", label: "Ukiyo-e dark" }, { value: "vaporwave-light", label: "Vaporwave light" }, { value: "vaporwave-dark", label: "Vaporwave dark" }, { value: "victorian-light", label: "Victorian light" }, { value: "victorian-dark", label: "Victorian dark" }, { value: "wabi-sabi-light", label: "Wabi-Sabi light" }, { value: "wabi-sabi-dark", label: "Wabi-Sabi dark" }, { value: "win95-light", label: "Windows 95 light" }, { value: "win95-dark", label: "Windows 95 dark" }, { value: "wireframe-light", label: "Wireframe light" }, { value: "wireframe-dark", label: "Wireframe dark" }, { value: "zine-light", label: "Punk Zine light" }, { value: "zine-dark", label: "Punk Zine dark" }]
    }
  }
  trait LaunchpadHeader -> LaunchpadView [client] {
    initial: closed

    state closed {
      INIT -> closed
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      MACHINE_TOGGLE -> open
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: primary, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme,
          { type: drawer, isOpen: true, modal: false, title: "State machine · this page", position: right, width: "min(1100px, 62vw)", headerActions: { type: button, label: "Full screen", icon: maximize-2, variant: ghost, size: sm, action: MACHINE_SIZE }, closeEvent: CLOSE, children: [@trait.LaunchpadLive] }
        ] })
        (emit MACHINE_OPEN { behavior: "almadar-std/std-launchpad" })
    }

    state open {
      INIT -> closed
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      MACHINE_TOGGLE -> closed
        (emit MACHINE_CLOSE { })
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      CLOSE -> closed
        (emit MACHINE_CLOSE { })
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      MACHINE_SIZE -> full
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: primary, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme,
          { type: drawer, isOpen: true, modal: false, title: "State machine · this page", position: right, width: "100vw", headerActions: { type: button, label: "Side panel", icon: minimize-2, variant: ghost, size: sm, action: MACHINE_SIZE }, closeEvent: CLOSE, children: [@trait.LaunchpadLive] }
        ] })
    }

    state full {
      INIT -> closed
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      MACHINE_TOGGLE -> closed
        (emit MACHINE_CLOSE { })
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      CLOSE -> closed
        (emit MACHINE_CLOSE { })
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      MACHINE_SIZE -> open
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: primary, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme,
          { type: drawer, isOpen: true, modal: false, title: "State machine · this page", position: right, width: "min(1100px, 62vw)", headerActions: { type: button, label: "Full screen", icon: maximize-2, variant: ghost, size: sm, action: MACHINE_SIZE }, closeEvent: CLOSE, children: [@trait.LaunchpadLive] }
        ] })
    }

    emits {
      MACHINE_OPEN -> external {
        behavior : string!
      }
        @description "The State machine view opened: draw this page whole and follow it."
      MACHINE_CLOSE -> external { }
        @description "The State machine view closed: stop following the page."
    }

    listens {
      MACHINE_TOGGLE { }
        @description "The header's State machine button: open the view of this page, or close it."
      CLOSE { }
        @description "The drawer was closed."
      MACHINE_SIZE { }
        @description "The drawer's size button: fill the screen with the view, or go back to a side panel."
    }
  }

