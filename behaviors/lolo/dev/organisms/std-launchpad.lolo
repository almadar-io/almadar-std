app std-launchpad [
  version: "5.0.0",
  theme: "linear-clean-light",
  themes: ["linear-clean-dark", "almadar-light", "almadar-dark", "minimalist-light", "minimalist-dark", "notion-editorial-light", "swiss-light", "bloomberg-dense-dark", "terminal-dark", "game-sci-fi-dark"],
  exec: ["orb", "aws", "bq", "gcloud", "gh", "ssh"],
  env: ["PATH", "HOME"],
  sys: [memory, cpu],
  fs: { "~/.almadar/launchpad": [create], "~/.almadar/launchpad/**": [read, write, create] },
  description: "std-launchpad — the dashboard of orb's own operations that bare `orb` (orb launchpad) opens in the browser, always on production credentials. It composes its apps statically: the ops boards std-ci-status (with std-ci-run-logs reading the failing logs its rows open), std-aws-board, std-app-hosting-board, std-cloud-run-board, std-training-board and std-llm-spend-board, and the dev playground std-behavior-playground, each with every trait of its page, so each board's server traits run on the launchpad's own server under the launchpad's grants. The frame is std-app-layout in its drawer mode (the navigation behind a menu button): its header carries the theme picker (std-theme-picker over the app's themes list), and its drawer lists Home plus one item per opened app, the current one highlighted, each open app with its own Close button. Open on a program card or a recent adds the app to the sidebar and shows the board's own view in the stage, with `@trait.X` embedding; picking a sidebar item switches the view and every open board keeps its state; closing an app removes its sidebar item (its trait keeps its state, as any trait does when its view is not shown). Every board is drawn by std-status-board and reads the first time its app is brought to the front (the stage sends APP_SHOWN, which each board view takes as BOARD_OPEN), so opening the launchpad itself reads nothing from GitHub, AWS or Google. No program is spawned and no port is taken. Home is search-first: the page header, a search box that filters the programs by name and description, Recent (the opens remembered per machine in ~/.almadar/launchpad/recents.json by std-launchpad-recents, those of the boards knob's apps shown, each reopening its app), one section per topic of the sections knob with a card per program of the boards knob (icon, label, one-line description, one Open button), and a side column with the Orb view (std-launchpad-orb: this machine as one orb with its CPU and memory, one star of the same size for each open app, coloured by its topic, the recent ones not open dimmed on an outer ring; a click on a star opens, closes or reopens its app) and one card for the machine's memory, CPU, load and uptime (std-system-stats), the orb's own version, uptime and kernel counters (std-orb-stats). The launchpad has no sign-in and composes no boot gate. Opening a CI row shows its jobs and the failing job's log inline. The app header grants exactly what the composed boards and the stats use, one line per key: exec is orb (the version) and the CLIs the boards run (aws and ssh for the AWS and training boards, gcloud and bq for Cloud Run and App Hosting, gh for CI run logs); env is PATH and HOME for the CLIs; egress is the Google OAuth token endpoint the Google boards connect through (std-gcloud-token); net lists the GitHub, App Hosting, Cloud Monitoring, OpenRouter, DeepSeek, Moonshot, local kernel-server (127.0.0.1:3000) and OpenAI hosts the boards and the playground call, the LLM spend board's four taken from its own header. std-analytics-collector is deliberately not composed: it would add an unauthenticated `analytics` beacon endpoint to the launchpad's server. Serve it with `orb launchpad`.",
  egress: ["https://oauth2.googleapis.com"],
  net: { "api.github.com:443": [tcp], "api.deepseek.com:443": [tcp], "api.moonshot.ai:443": [tcp], "127.0.0.1:3000": [tcp], "openrouter.ai:443": [tcp], "firebaseapphosting.googleapis.com:443": [tcp], "monitoring.googleapis.com:443": [tcp] },
]
;; @capabilities "open an orb operations board or the behavior playground and run it live, search the programs, switch between open apps from the rail, close an app, see the memory and cpu of this machine, see the orb's version and kernel counters, remember recent opens"

uses Shell from "std/behaviors/std-app-layout"
uses Picker from "std/behaviors/std-theme-picker"
uses Recents from "std/behaviors/std-launchpad-recents"
uses Orb from "std/behaviors/std-launchpad-orb"
uses Stats from "std/behaviors/std-system-stats"
uses OrbStats from "std/behaviors/std-orb-stats"
uses Ci from "std/behaviors/std-ci-status"
uses Aws from "std/behaviors/std-aws-board"
uses Ah from "std/behaviors/std-app-hosting-board"
uses Cr from "std/behaviors/std-cloud-run-board"
uses Tr from "std/behaviors/std-training-board"
uses Llm from "std/behaviors/std-llm-spend-board"
uses Play from "std/behaviors/std-behavior-playground"

type LaunchpadSection = { topic : string!, title : string!, run : string! }
type LaunchpadBoard = { id : string!, label : string!, icon : string!, topic : string!, description : string! }
type LaunchpadTab = { id : string!, label : string!, icon : string!, topic : string! }
type LaunchpadProcess = { pid : number!, rssKb : number! }
type LaunchpadRecent = { behavior : string!, label : string!, kind : string!, command : string!, route : string!, at : instant! }
type OrbMachine = { label : string!, detail : string! }
type OrbStar = { id : string!, label : string!, kind : string!, state : "starting" | "running" | "stopped"!, weight : number!, detail : string! }
type OrbClicked = { id : string!, label : string, group : string, size : number, color : string }

orbital Launchpad {
  entity LaunchpadView [runtime] {
    id : string!
    tabs : [LaunchpadTab] = []
    active : string @description "The id of the open app in front; empty is Home." = ""
    query : string = ""
    openTabs : [LaunchpadTab] = []
    recents : [LaunchpadRecent] = []
    orbUptimeMs : number = 0
    statsReady : boolean = false
    memoryTotal : number = 0
    memoryUsed : number = 0
    memoryPercent : number = 0
    cpuPercent : number = 0
    load1 : number = 0
    machineUptime : number = 0
    statsUnavailable : [string] = []
    statsErrors : Map string string = {}
    orbVersion : string = ""
    kernelReady : boolean = false
    registeredSchemas : number = 0
    registeredTraits : number = 0
    activeInstances : number = 0
    cachedEntities : number = 0
  }

  config {
    boards : [LaunchpadBoard] = [{ id: "almadar-std/std-ci-status", label: "CI status", icon: "activity", topic: "ops", description: "The CI of the active repositories as one board, failing first; open a row for its jobs and the failing log." }, { id: "almadar-std/std-aws-board", label: "AWS", icon: "cloud", topic: "ops", description: "One AWS region at a glance: instances, volumes, buckets, quotas and cost, read through the aws CLI." }, { id: "almadar-std/std-app-hosting-board", label: "App Hosting", icon: "rocket", topic: "ops", description: "A Firebase App Hosting project's backends, rollouts and logs, read through the App Hosting API and the gcloud CLI." }, { id: "almadar-std/std-cloud-run-board", label: "Cloud Run", icon: "server", topic: "ops", description: "A Google Cloud project's Cloud Run services and this month's cost, read through the gcloud and bq CLIs." }, { id: "almadar-std/std-training-board", label: "Training", icon: "brain", topic: "ops", description: "The model-training instances of one AWS region, read through the aws and ssh CLIs." }, { id: "almadar-std/std-llm-spend-board", label: "LLM spend", icon: "wallet", topic: "ops", description: "What LLM providers cost: the OpenRouter key's usage and limit, the DeepSeek and Moonshot balances, and the token spend a kernel server reports." }, { id: "almadar-std/std-behavior-playground", label: "Behavior playground", icon: "flask-conical", topic: "dev", description: "Browse every installed behavior by package and topic, run one live, explore its state machines and read its source." }]
      @label "Boards"
      @description "The composed apps the launchpad offers, in order: id (the behavior name), label, icon name, topic and a one-line description. Each id must be one of the apps the launchpad composes; an id not composed has no view to show."
    sections : [LaunchpadSection] = [{ topic: "ops", title: "Ops", run: "Open" }, { topic: "dev", title: "Tools", run: "Open" }]
      @label "Sections"
      @description "The topics shown as card sections, in order, with each section's heading and the text of its Open button."
    title : string = "Launchpad"
      @label "Title"
  }

  trait LaunchpadFrame = Shell.traits.AppLayout -> LaunchpadView {
    config {
      appName: @config.title
      navItems: []
      contentTrait: @trait.LaunchpadStage
      sidebarTrait: @trait.LaunchpadRail
      headerTrait: @trait.LaunchpadTheme
      layoutMode: drawer
      contentClassName: "w-full"
      showSearch: false
      showNotifications: false
      notifications: []
      showThemeToggle: false
    }
  }
  trait LaunchpadTheme = Picker.traits.ThemePicker {
    config {
      themes: [{ value: "linear-clean-light", label: "Linear light" }, { value: "linear-clean-dark", label: "Linear dark" }, { value: "almadar-light", label: "Almadar light" }, { value: "almadar-dark", label: "Almadar dark" }, { value: "minimalist-light", label: "Minimalist light" }, { value: "minimalist-dark", label: "Minimalist dark" }, { value: "notion-editorial-light", label: "Editorial" }, { value: "swiss-light", label: "Swiss" }, { value: "bloomberg-dense-dark", label: "Terminal dense" }, { value: "terminal-dark", label: "Terminal" }, { value: "game-sci-fi-dark", label: "Sci-fi" }]
    }
  }
  trait CiStatus = Ci.traits.CiStatus {
    config {
      repos: [{ owner: "almadar-io", name: "almadar-std" }, { owner: "almadar-io", name: "behaviors" }, { owner: "almadar-io", name: "lolo-ar" }, { owner: "almadar-io", name: "lolo-sl" }, { owner: "almadar-io", name: "orbital-rust" }, { owner: "almadar-io", name: "orbital-core" }, { owner: "almadar-io", name: "orbital-canvas" }, { owner: "almadar-io", name: "orbital-ffi" }, { owner: "almadar-io", name: "orbital-wasm" }, { owner: "almadar-io", name: "orbital-shell-typescript" }, { owner: "almadar-io", name: "orbital-shell-python" }, { owner: "almadar-io", name: "orbital-shell-rust" }, { owner: "almadar-io", name: "orbital-shell-ios" }, { owner: "almadar-io", name: "orbital-shell-android" }, { owner: "almadar-io", name: "orb" }, { owner: "almadar-io", name: "almadar" }]
    }
  }
  trait CiBoard = Ci.traits.CiBoard {
    listens {
      CiStatus.CI_BOARD_LOADING -> BOARD_LOADING
      CiStatus.CI_BOARD_SHOW -> BOARD_SHOW
      CiStatus.CI_BOARD_FAILED -> BOARD_FAILED
      CiDetail.CI_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-ci-status")
    }
  }
  trait CiDetail = Ci.traits.CiDetail {}
  trait CiGithub = Ci.traits.CiGithub {}
  trait CiGhHttp = Ci.traits.CiGhHttp {}
  trait CiGhTimeout = Ci.traits.CiGhTimeout {}
  trait CiRetry = Ci.traits.CiRetry {}
  trait AwsStatus = Aws.traits.AwsStatus {}
  trait AwsCli = Aws.traits.AwsCli {}
  trait AwsView = Aws.traits.AwsView {
    listens {
      AwsStatus.AWS_BOARD_LOADING -> BOARD_LOADING
      AwsStatus.AWS_BOARD_SHOW -> BOARD_SHOW
      AwsStatus.AWS_BOARD_FAILED -> BOARD_FAILED
      AwsStatus.AWS_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-aws-board")
    }
  }
  trait CiRunLogs = Ci.traits.CiRunLogs {}
  trait CiLogsGh = Ci.traits.CiLogsGh {}
  trait AppHostingStatus = Ah.traits.AppHostingStatus {
    config {
      project: "kflow-b3a39"
      region: "europe-west4"
      backends: ["almadar-analytics", "almadar-builder-server", "almadar-kflow-server", "kflow-server", "almadar-inspection-server", "almadar-iram-server", "almadar-kekec-server", "almadar-trait-wars-server", "almadar-alummaalraqamia-server", "almadar-blaz-klemenc-server"]
    }
  }
  trait AhApi = Ah.traits.AhApi {
    listens {
      AppHostingStatus.AH_HTTP_SEND -> HTTP_SEND
      CatEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL when (array/includes ["rollouts", "build"] @payload.key)
    }
  }
  trait AhToken = Ah.traits.AhToken {}
  trait AhGcloud = Ah.traits.AhGcloud {}
  trait AhView = Ah.traits.AhView {
    listens {
      AppHostingStatus.AH_BOARD_LOADING -> BOARD_LOADING
      AppHostingStatus.AH_BOARD_SHOW -> BOARD_SHOW
      AppHostingStatus.AH_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-app-hosting-board")
    }
  }
  trait CloudRunStatus = Cr.traits.CloudRunStatus {
    config {
      project: "kflow-b3a39"
    }
  }
  trait CrMonitoring = Cr.traits.CrMonitoring {
    listens {
      CloudRunStatus.CR_HTTP_SEND -> HTTP_SEND
      CatEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL when (array/includes ["time", "requests"] @payload.key)
    }
  }
  trait CrToken = Cr.traits.CrToken {}
  trait CrGcloud = Cr.traits.CrGcloud {}
  trait CrBq = Cr.traits.CrBq {}
  trait CloudRunView = Cr.traits.CloudRunView {
    listens {
      CloudRunStatus.CR_BOARD_LOADING -> BOARD_LOADING
      CloudRunStatus.CR_BOARD_SHOW -> BOARD_SHOW
      CloudRunStatus.CR_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-cloud-run-board")
    }
  }
  trait TrainingStatus = Tr.traits.TrainingStatus {}
  trait TrAws = Tr.traits.TrAws {}
  trait TrSsh = Tr.traits.TrSsh {}
  trait TrainingView = Tr.traits.TrainingView {
    listens {
      TrainingStatus.TR_BOARD_LOADING -> BOARD_LOADING
      TrainingStatus.TR_BOARD_SHOW -> BOARD_SHOW
      TrainingStatus.TR_BOARD_FAILED -> BOARD_FAILED
      TrainingStatus.TR_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-training-board")
    }
  }
  trait LlmSpend = Llm.traits.LlmSpend {}
  trait LsOrHttp = Llm.traits.LsOrHttp {}
  trait LsDsHttp = Llm.traits.LsDsHttp {}
  trait LsKmHttp = Llm.traits.LsKmHttp {}
  trait LsTraceHttp = Llm.traits.LsTraceHttp {}
  trait LsTimeout = Llm.traits.LsTimeout {}
  trait LlmSpendView = Llm.traits.LlmSpendView {
    listens {
      LlmSpend.LS_BOARD_LOADING -> BOARD_LOADING
      LlmSpend.LS_BOARD_SHOW -> BOARD_SHOW
      LlmSpend.LS_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-llm-spend-board")
    }
  }
  trait PlaygroundFrame = Play.traits.PlaygroundFrame {}
  trait PlaygroundTopBar = Play.traits.PlaygroundTopBar {
    config {
      heading: "Behavior playground"
    }
  }
  trait PlaygroundTopics = Play.traits.PlaygroundTopics {}
  trait PlaygroundStage = Play.traits.PlaygroundStage {}
  trait PlaygroundLoader = Play.traits.PlaygroundLoader {}
  trait BehaviorCatalog = Play.traits.BehaviorCatalog {
    config {
      loadOnInit: false
    }
    listens {
      BehaviorCatalogLlm.LLM_EMBED_RESULT -> EMBEDDED
      BehaviorCatalogLlm.LLM_FAILED -> SEARCH_FAILED
      PlaygroundTopics.TOPIC_PICKED -> TOPIC
      LaunchpadStage.PLAYGROUND_OPENED -> CATALOG_LOAD
      EMBEDDED {
        embeddings : [[number]]!
      }
      SEARCH_FAILED {
        code : string
        message : string!
      }
      SEARCH {
        searchTerm : string!
      }
      PICK {
        behavior : string!
        description : string
        trait : string
        value : behavior
      }
      DESCRIBE {
        behavior : string!
      }
      TOGGLE {
        behavior : string!
        checked : boolean!
        topic : string
        value : behavior
      }
      SELECTION {
        behaviors : [string]!
      }
      TOPIC {
        package : string!
        topic : string!
      }
      RETRY
      CATALOG_LOAD
    }
  }
  trait BehaviorCatalogLlm = Play.traits.BehaviorCatalogLlm {}
  trait CatEmbedWait = Play.traits.CatEmbedWait {}
  trait CatEmbedRequest = Play.traits.CatEmbedRequest {}
  trait CatEmbedHttp = Play.traits.CatEmbedHttp {}
  trait PlaygroundCosmic = Play.traits.PlaygroundCosmic {}
  trait PlaygroundInspector = Play.traits.PlaygroundInspector {}
  trait PlaygroundStatus = Play.traits.PlaygroundStatus {}
  trait PlaygroundRuntime = Play.traits.PlaygroundRuntime {}

  trait RecentsStore = Recents.traits.RecentsStore {
    listens {
      LaunchpadHome.RECENTS_LOAD -> RECENTS_LOAD
      LaunchpadHome.RECENT_ADD -> RECENT_ADD
    }
  }

  trait SystemStatsMeter = Stats.traits.SystemStatsMeter {
    listens {
      LaunchpadHome.STATS_START -> STATS_START
    }
  }

  trait OrbStatsReader = OrbStats.traits.OrbStatsReader {
    listens {
      LaunchpadHome.ORB_STATS_ASK -> ORB_STATS_ASK
      SystemStatsMeter.STATS_READ -> ORB_STATS_ASK
      OrbVersionRunner.CLI_DONE -> ORB_VERSION_DONE
      OrbVersionRunner.CLI_FAILED -> ORB_VERSION_FAILED
    }
  }
  trait OrbVersionRunner = OrbStats.traits.OrbVersionRunner {}

  trait SystemOrb = Orb.traits.SystemOrb {
    config {
      hint: "Each star is an open app, coloured by its topic; all stars are the same size because nothing in-process measures an app honestly. Click one to open, close or reopen its tab."
      colors: { ops: "var(--color-success)", dev: "var(--color-info)" }
      graphHeight: 280
    }
    listens {
      LaunchpadHome.ORB_STATE -> ORB_STATE
      NODE_CLICK {
        node : OrbClicked!
      }
      STAR_OPEN {
        id : string!
      }
      STAR_STOP {
        id : string!
      }
      STAR_RELAUNCH {
        id : string!
      }
    }
  }

  trait LaunchpadRail -> LaunchpadView [client] {
    initial: idle

    state idle {
      INIT -> idle
        (emit RAIL_SHOWN {})
      RAIL_SHOWN -> idle
        (render-ui main { type: stack, direction: vertical, gap: xs, children: (array/concat
          [{ type: button, label: "Home", icon: home, variant: (if (= @entity.active "") primary ghost), size: sm, action: RAIL_PICKED, actionPayload: { id: "home" } }]
          (array/map @entity.openTabs (fn t { type: stack, direction: horizontal, align: center, justify: between, gap: xs, children: [
            { type: button, label: @t.label, icon: @t.icon, variant: (if (= @t.id @entity.active) primary ghost), size: sm, action: RAIL_PICKED, actionPayload: { id: @t.id } },
            { type: icon-button, icon: x, label: (str/concat "Close " @t.label), variant: ghost, size: sm, action: RAIL_CLOSE, actionPayload: { id: @t.id } }
          ] }))) })
      TABS_CHANGED -> idle
        (set @entity.openTabs ?tabs)
        (set @entity.active ?active)
        (emit RAIL_SHOWN {})
      RAIL_PICKED -> idle when (= ?id "home")
        (emit RAIL_HOME {})
      RAIL_PICKED -> idle when (!= ?id "home")
        (emit RAIL_SELECT { id: ?id })
      RAIL_CLOSE -> idle
        (emit RAIL_CLOSE_ASKED { id: ?id })
    }

    emits {
      RAIL_SHOWN
      RAIL_HOME -> external {
      }
        @description "The Home item of the rail was picked."
      RAIL_SELECT -> external {
        id : string!
      }
        @description "An open app's rail item was picked."
      RAIL_CLOSE_ASKED -> external {
        id : string!
      }
        @description "An open app's Close button in the sidebar was pressed."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RAIL_SHOWN { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RAIL_PICKED {
        id : string!
      }
      RAIL_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadStage -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit TABS_SHOWN {})
      TABS_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: none, flex: true, children: [
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "") "" "hidden"), children: [@trait.LaunchpadHome] },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-ci-status") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-status"))) [@trait.CiBoard] []) },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-aws-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-aws-board"))) [@trait.AwsView] []) },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-app-hosting-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-app-hosting-board"))) [@trait.AhView] []) },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-cloud-run-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-cloud-run-board"))) [@trait.CloudRunView] []) },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-training-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-training-board"))) [@trait.TrainingView] []) },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-llm-spend-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-llm-spend-board"))) [@trait.LlmSpendView] []) },
          { type: box, fullHeight: true, overflow: auto, className: (if (= @entity.active "almadar-std/std-behavior-playground") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-behavior-playground"))) [@trait.PlaygroundFrame] []) }
        ] })
      TAB_OPEN -> ready when (array/some @entity.tabs (fn t (= @t.id ?behavior)))
        (set @entity.active ?behavior)
        (when (= ?behavior "almadar-std/std-behavior-playground") (emit PLAYGROUND_OPENED {}))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (not (array/some @entity.tabs (fn t (= @t.id ?behavior))))
        (set @entity.tabs (array/append @entity.tabs { id: ?behavior, label: ?label, icon: ?icon, topic: ?topic }))
        (set @entity.active ?behavior)
        (when (= ?behavior "almadar-std/std-behavior-playground") (emit PLAYGROUND_OPENED {}))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_HOME -> ready
        (set @entity.active "")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_SELECT -> ready when (array/some @entity.tabs (fn t (= @t.id ?id)))
        (set @entity.active ?id)
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?id })
      TAB_CLOSE -> ready
        (set @entity.tabs (array/filter @entity.tabs (fn t (!= @t.id ?id))))
        (set @entity.active (if (= @entity.active ?id) "" @entity.active))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TABS_PUSH -> ready
        (emit TABS_CHANGED { tabs: @entity.tabs, active: @entity.active })
    }

    emits {
      TABS_SHOWN
      TABS_PUSH { }
        @description "Internal: hand Home the tabs as they stand."
        @tier "internal"
      PLAYGROUND_OPENED -> external {
      }
        @description "The playground tab was opened: its catalog starts listing the installed behaviors."
      TABS_CHANGED -> external {
        tabs : [LaunchpadTab]!
        active : string!
      }
        @description "The open tabs and the one in front (empty is Home)."
      APP_SHOWN -> external {
        id : string!
      }
        @description "An app was brought to the front: its board reads once, the first time."
    }

    listens {
      LaunchpadHome.TAB_OPEN -> TAB_OPEN
      LaunchpadHome.HOME_FOCUS -> TAB_SELECT
      LaunchpadHome.HOME_CLOSE -> TAB_CLOSE
      LaunchpadRail.RAIL_HOME -> TAB_HOME
      LaunchpadRail.RAIL_SELECT -> TAB_SELECT
      LaunchpadRail.RAIL_CLOSE_ASKED -> TAB_CLOSE
      TABS_SHOWN { }
      TABS_PUSH { }
      PLAYGROUND_OPENED { }
      TAB_OPEN {
        behavior : string!
        label : string!
        icon : string!
        topic : string!
      }
      TAB_HOME { }
      TAB_SELECT {
        id : string!
      }
      TAB_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadHome -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
      sectionList : [LaunchpadSection] = @config.sections
        @label "Sections"
        @tier "presentation"
      heading : string = @config.title
        @label "Title"
        @tier "presentation"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit RECENTS_LOAD {})
        (emit STATS_START {})
        (emit ORB_STATS_ASK {})
        (emit HOME_SHOWN {})
      HOME_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: lg, children: [
            { type: page-header, icon: layout-dashboard, title: @config.heading, subtitle: (str/concat (array/len @config.boardList) " programs") },
            { type: search-input, placeholder: "Search programs", event: HOME_SEARCHED, value: @entity.query, debounceMs: 200, clearable: true },
            { type: split, ratio: "3:1", gap: lg, align: start, children: [
              { type: stack, direction: vertical, gap: lg, children: (let ((matches (array/filter @config.boardList (fn a (or (= @entity.query "") (str/includes (str/lower (str/concat @a.label " " @a.description)) (str/lower @entity.query))))))) (array/concat [(if (and (> (array/len @entity.recents) 0) (= @entity.query "")) { type: section, title: "Recent", children: [{ type: stack, direction: horizontal, wrap: true, gap: sm, children: (array/map @entity.recents (fn r { type: button, label: (str/concat @r.label " · " (time/relative @r.at)), variant: secondary, size: sm, action: APP_OPEN, actionPayload: { behavior: @r.behavior } })) }] } null)] (array/concat (array/map @config.sectionList (fn sec (if (= (array/count @matches (fn a (= @a.topic @sec.topic))) 0) null { type: section, title: @sec.title, children: [
                { type: simple-grid, minChildWidth: 260, gap: md, children: (array/map (array/filter @matches (fn a (= @a.topic @sec.topic))) (fn a { type: card, variant: bordered, padding: md, children: [
                  { type: stack, direction: vertical, gap: sm, children: [
                    { type: stack, direction: horizontal, align: center, gap: sm, children: [
                      { type: icon, name: @a.icon, size: md },
                      { type: typography, content: @a.label, variant: h5, weight: semibold }
                    ] },
                    { type: typography, content: @a.description, variant: caption, color: muted, overflow: clamp-3 },
                    { type: stack, direction: horizontal, justify: end, children: [
                      { type: button, label: @sec.run, variant: primary, size: sm, action: APP_OPEN, actionPayload: { behavior: @a.id } }
                    ] }
                  ] }
                ] })) }
              ] }))) [(if (= (array/len @matches) 0) { type: empty-state, icon: search, title: "No program matches", description: (str/concat "Nothing is named or described like \"" @entity.query "\". Clear the search to see every program.") } null)]))) },
              { type: stack, direction: vertical, gap: lg, children: [
                { type: card, variant: bordered, padding: md, children: [@trait.SystemOrb] },
                { type: card, variant: bordered, padding: md, title: "This machine", children: [
                  { type: stack, direction: vertical, gap: md, children: [
                    { type: simple-grid, minChildWidth: 110, gap: sm, children: [
                      { type: stat-display, label: "CPU", value: (if @entity.statsReady (str/concat (math/round @entity.cpuPercent 0) "%") ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Memory", value: (if @entity.statsReady (str/concat (math/round @entity.memoryPercent 0) "%") ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Used", value: (if @entity.statsReady (format/bytes @entity.memoryUsed) ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Load", value: (if @entity.statsReady (str/concat (math/round @entity.load1 2)) ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Up", value: (if @entity.statsReady (time/duration (* 1000 @entity.machineUptime)) ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Version", value: @entity.orbVersion, isLoading: (= @entity.orbVersion ""), size: sm },
                      { type: stat-display, label: "Orb up", value: (if @entity.kernelReady (time/duration @entity.orbUptimeMs) ""), isLoading: (not @entity.kernelReady), size: sm },
                      { type: stat-display, label: "Kernel traits", value: (if @entity.kernelReady (str/concat @entity.registeredTraits) ""), isLoading: (not @entity.kernelReady), size: sm },
                      { type: stat-display, label: "Kernel instances", value: (if @entity.kernelReady (str/concat @entity.activeInstances) ""), isLoading: (not @entity.kernelReady), size: sm }
                    ] },
                    (if (= (array/len @entity.statsUnavailable) 0) null { type: typography, content: (str/concat "Not available: " (str/join (array/map @entity.statsUnavailable (fn u (str/concat @u " (" (object/get @entity.statsErrors @u "") ")"))) "; ")), variant: caption, color: muted }),
                    (if (= (array/count ["version", "kernel"] (fn k (object/has @entity.statsErrors @k))) 0) null { type: typography, content: (str/concat "Not read: " (str/join (array/map (array/filter ["version", "kernel"] (fn k (object/has @entity.statsErrors @k))) (fn k (str/concat @k " (" (object/get @entity.statsErrors @k "") ")"))) "; ")), variant: caption, color: muted })
                  ] }
                ] }
              ] }
            ] }
        ] })
      HOME_SEARCHED -> ready
        (set @entity.query ?searchTerm)
        (emit HOME_SHOWN {})
      TABS_CHANGED -> ready
        (set @entity.openTabs ?tabs)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_LOADED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_CHANGED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_FAILED -> ready
        (render-ui toast { type: alert, variant: error, message: (str/concat "Recent opens: " ?error) })
      STATS_READ -> ready
        (set @entity.statsReady true)
        (set @entity.memoryTotal ?memoryTotal)
        (set @entity.memoryUsed ?memoryUsed)
        (set @entity.memoryPercent ?memoryPercent)
        (set @entity.cpuPercent ?cpuPercent)
        (set @entity.load1 ?load1)
        (set @entity.machineUptime ?uptimeSeconds)
        (set @entity.statsUnavailable ?unavailable)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
      ORB_KERNEL_READ -> ready
        (set @entity.kernelReady true)
        (set @entity.registeredSchemas ?registeredSchemas)
        (set @entity.registeredTraits ?registeredTraits)
        (set @entity.activeInstances ?activeInstances)
        (set @entity.cachedEntities ?cachedEntities)
        (set @entity.orbUptimeMs ?uptimeMs)
      ORB_VERSION_READ -> ready
        (set @entity.orbVersion ?version)
        (emit HOME_SHOWN {})
      ORB_STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
        (emit HOME_SHOWN {})
      ORB_PUSH -> ready
        (emit ORB_STATE { machine: { label: (if @entity.statsReady (str/concat "CPU " (math/round @entity.cpuPercent 0) "% · RAM " (math/round @entity.memoryPercent 0) "%") "This machine"), detail: (let ((used (format/bytes @entity.memoryUsed)) (total (format/bytes @entity.memoryTotal))) (if (and @entity.statsReady (!= @used null) (!= @total null)) (str/concat @used " of " @total " in use · load " (math/round @entity.load1 2)) "Reading the machine")) }, stars: (array/concat (array/map @entity.openTabs (fn t { id: @t.id, label: @t.label, kind: @t.topic, state: "running", weight: 0, detail: (str/concat @t.topic " · open") })) (array/map (array/filter @entity.recents (fn c (not (array/some @entity.openTabs (fn t (= @t.id @c.behavior)))))) (fn c { id: @c.behavior, label: @c.label, kind: "recent", state: "stopped", weight: 0, detail: (str/concat "not open · last opened " (time/relative @c.at)) }))) })
      APP_OPEN -> ready when (and (array/some @config.boardList (fn a (= @a.id ?behavior))) (array/some @entity.openTabs (fn t (= @t.id ?behavior))))
        (emit HOME_FOCUS { id: ?behavior })
      APP_OPEN -> ready when (and (array/some @config.boardList (fn a (= @a.id ?behavior))) (not (array/some @entity.openTabs (fn t (= @t.id ?behavior)))))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit TAB_OPEN { behavior: ?behavior, label: @a.label, icon: @a.icon, topic: @a.topic }))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit RECENT_ADD { behavior: ?behavior, label: @a.label, kind: "route", command: "", route: "" }))
      ORB_OPENED -> ready
        (emit HOME_FOCUS { id: ?id })
      ORB_STOPPED -> ready
        (emit HOME_CLOSE { id: ?id })
      ORB_RELAUNCHED -> ready
        (emit APP_OPEN { behavior: ?id })
    }

    emits {
      HOME_SHOWN
      ORB_PUSH { }
        @description "Internal: hand the orb view the machine and the open tabs as they stand."
        @tier "internal"
      APP_OPEN {
        behavior : string!
      }
        @description "Internal: open a listed app as a tab, or bring its tab to the front."
        @tier "internal"
      RECENTS_LOAD -> external {
      }
        @description "Read the remembered opens."
      RECENT_ADD -> external {
        behavior : string!
        label : string!
        kind : string!
        command : string!
        route : string!
      }
        @description "Remember an open."
      TAB_OPEN -> external {
        behavior : string!
        label : string!
        icon : string!
        topic : string!
      }
        @description "Open an app and put it in the rail."
      HOME_FOCUS -> external {
        id : string!
      }
        @description "Bring an open tab to the front."
      HOME_CLOSE -> external {
        id : string!
      }
        @description "Close a tab, which unmounts the app."
      STATS_START -> external {
      }
        @description "Begin sampling the machine."
      ORB_STATS_ASK -> external {
      }
        @description "Read the orb's kernel counters (and its version, the first time)."
      ORB_STATE -> external {
        machine : OrbMachine!
        stars : [OrbStar]!
      }
        @description "The machine and the open tabs around it, for the orb view."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RecentsStore.RECENTS_LOADED -> RECENTS_LOADED
      RecentsStore.RECENTS_CHANGED -> RECENTS_CHANGED
      RecentsStore.RECENTS_FAILED -> RECENTS_FAILED
      SystemStatsMeter.STATS_READ -> STATS_READ
      SystemStatsMeter.STATS_FAILED -> STATS_FAILED
      OrbStatsReader.ORB_KERNEL_READ -> ORB_KERNEL_READ
      OrbStatsReader.ORB_VERSION_READ -> ORB_VERSION_READ
      OrbStatsReader.ORB_STATS_FAILED -> ORB_STATS_FAILED
      SystemOrb.ORB_OPEN -> ORB_OPENED
      SystemOrb.ORB_STOP -> ORB_STOPPED
      SystemOrb.ORB_RELAUNCH -> ORB_RELAUNCHED
      HOME_SHOWN { }
      ORB_PUSH { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RECENTS_LOADED {
        items : [LaunchpadRecent]!
      }
      RECENTS_CHANGED {
        items : [LaunchpadRecent]!
      }
      RECENTS_FAILED {
        error : string!
      }
      STATS_READ {
        memoryTotal : number!
        memoryUsed : number!
        memoryAvailable : number!
        memoryPercent : number!
        cpuPercent : number!
        load1 : number!
        load5 : number!
        load15 : number!
        uptimeSeconds : number!
        processes : [LaunchpadProcess]!
        missing : [number]!
        unavailable : [string]!
        at : number!
      }
      STATS_FAILED {
        stat : "memory" | "cpu" | "load" | "uptime" | "processes"!
        code : string!
        error : string!
      }
      ORB_KERNEL_READ {
        registeredSchemas : number!
        registeredTraits : number!
        activeInstances : number!
        cachedEntities : number!
        uptimeMs : number!
      }
      ORB_VERSION_READ {
        version : string!
      }
      ORB_STATS_FAILED {
        stat : "kernel" | "version"!
        code : string!
        error : string!
      }
      ORB_OPENED {
        id : string!
      }
      ORB_STOPPED {
        id : string!
      }
      ORB_RELAUNCHED {
        id : string!
      }
      APP_OPEN {
        behavior : string!
      }
      HOME_SEARCHED {
        searchTerm : string!
      }
    }
  }

  page "/" as LaunchpadPage -> LaunchpadFrame, LaunchpadTheme, LaunchpadRail, LaunchpadStage, LaunchpadHome, RecentsStore, SystemOrb, SystemStatsMeter, OrbStatsReader, OrbVersionRunner, CiStatus, CiBoard, CiDetail, CiGithub, CiGhHttp, CiGhTimeout, CiRetry, AwsStatus, AwsCli, AwsView, CiRunLogs, CiLogsGh, AppHostingStatus, AhToken, AhGcloud, AhView, CloudRunStatus, CrToken, CrGcloud, CrBq, CloudRunView, TrainingStatus, TrAws, TrSsh, TrainingView, LlmSpend, LlmSpendView, LsOrHttp, LsDsHttp, LsKmHttp, LsTraceHttp, LsTimeout, PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, BehaviorCatalog, BehaviorCatalogLlm, CatEmbedWait, CatEmbedRequest, CatEmbedHttp, PlaygroundCosmic, PlaygroundInspector, PlaygroundStatus, PlaygroundRuntime, AhApi, CrMonitoring
}
