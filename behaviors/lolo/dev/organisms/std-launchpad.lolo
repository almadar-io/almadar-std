  trait SystemOrb = Orb.traits.SystemOrb {
    config {
      hint: "Each star is an open app, coloured by its topic; all stars are the same size because nothing in-process measures an app honestly. Click one to open, close or reopen its tab."
      colors: { ops: "var(--color-success)", dev: "var(--color-info)" }
      graphHeight: 340
      hubLabel: "Closed"
      openOnClick: true
    }
    listens {
      LaunchpadHome.ORB_STATE -> ORB_STATE
      NODE_CLICK {
        node : OrbClicked!
      }
      STAR_OPEN {
        id : string!
      }
      STAR_STOP {
        id : string!
      }
      STAR_RELAUNCH {
        id : string!
      }
    }
  }

  trait LaunchpadRail -> LaunchpadView [client] {
    config {
      menuBoards : [LaunchpadBoard] = @config.boards
        @label "Programs"
        @tier "domain"
      menuSections : [LaunchpadSection] = @config.sections
        @label "Groups"
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (emit RAIL_SHOWN {})
      RAIL_SHOWN -> idle
        (render-ui main { type: stack, direction: vertical, gap: md, children: (array/concat
          [{ type: button, label: "Home", icon: home, variant: (if (= @entity.active "") primary ghost), size: sm, action: RAIL_PICKED, actionPayload: { id: "home" } }]
          (array/map (array/filter @config.menuSections (fn sec (array/some @config.menuBoards (fn a (= @a.topic @sec.topic))))) (fn sec { type: stack, direction: vertical, gap: xs, children: (array/concat
            [{ type: typography, content: @sec.title, variant: overline, color: muted }]
            (array/map (array/filter @config.menuBoards (fn a (= @a.topic @sec.topic))) (fn a { type: stack, direction: horizontal, align: center, justify: between, gap: xs, children: (array/concat
              [{ type: button, label: @a.label, icon: @a.icon, variant: (if (= @a.id @entity.active) primary ghost), size: sm, action: RAIL_PICKED, actionPayload: { id: @a.id } }]
              (if (array/some @entity.openTabs (fn t (= @t.id @a.id))) [{ type: icon-button, icon: x, label: (str/concat "Close " @a.label), variant: ghost, size: sm, action: RAIL_CLOSE, actionPayload: { id: @a.id } }] [])) }))) }))) })
      TABS_CHANGED -> idle
        (set @entity.openTabs ?tabs)
        (set @entity.active ?active)
        (emit RAIL_SHOWN {})
      RAIL_PICKED -> idle when (= ?id "home")
        (emit RAIL_HOME {})
      RAIL_PICKED -> idle when (!= ?id "home")
        (emit RAIL_OPEN { behavior: ?id })
      RAIL_CLOSE -> idle
        (emit RAIL_CLOSE_ASKED { id: ?id })
    }

    emits {
      RAIL_SHOWN
      RAIL_HOME -> external {
      }
        @description "The Home item of the rail was picked."
      RAIL_OPEN -> external {
        behavior : string!
      }
        @description "A program in the menu was picked: it opens, or comes to the front when it is open."
      RAIL_CLOSE_ASKED -> external {
        id : string!
      }
        @description "An open app's Close button in the sidebar was pressed."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RAIL_SHOWN { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RAIL_PICKED {
        id : string!
      }
      RAIL_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadStage -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit TABS_SHOWN {})
      TABS_SHOWN -> ready
        (render-ui main { type: box, fullHeight: true, overflow: hidden, children: [
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "") "" "hidden"), children: [@trait.LaunchpadHome] },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-ci-status") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-status"))) [@trait.CiBoard] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-aws-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-aws-board"))) [@trait.AwsView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-app-hosting-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-app-hosting-board"))) [@trait.AhView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-cloud-run-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-cloud-run-board"))) [@trait.CloudRunView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-training-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-training-board"))) [@trait.TrainingView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-llm-spend-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-llm-spend-board"))) [@trait.LlmSpendView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-analytics-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-analytics-board"))) [@trait.AnalyticsBoard] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-behavior-playground") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-behavior-playground"))) [@trait.PlaygroundFrame] []) }
        ] })
      TAB_OPEN -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?behavior))) (= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.active ?behavior)
        (emit PLAYGROUND_OPENED {})
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?behavior))) (!= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.active ?behavior)
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (and (not (array/some @entity.tabs (fn t (= @t.id ?behavior)))) (= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.tabs (array/append @entity.tabs { id: ?behavior, label: ?label, icon: ?icon, topic: ?topic }))
        (set @entity.active ?behavior)
        (emit PLAYGROUND_OPENED {})
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (and (not (array/some @entity.tabs (fn t (= @t.id ?behavior)))) (!= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.tabs (array/append @entity.tabs { id: ?behavior, label: ?label, icon: ?icon, topic: ?topic }))
        (set @entity.active ?behavior)
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_HOME -> ready
        (set @entity.active "")
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_SELECT -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?id))) (= ?id "almadar-std/std-behavior-playground"))
        (set @entity.active ?id)
        (emit PLAYGROUND_OPENED {})
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?id })
      TAB_SELECT -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?id))) (!= ?id "almadar-std/std-behavior-playground"))
        (set @entity.active ?id)
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?id })
      TAB_CLOSE -> ready when (= ?id "almadar-std/std-behavior-playground")
        (set @entity.tabs (array/filter @entity.tabs (fn t (!= @t.id ?id))))
        (set @entity.active (if (= @entity.active ?id) "" @entity.active))
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_CLOSE -> ready when (!= ?id "almadar-std/std-behavior-playground")
        (set @entity.tabs (array/filter @entity.tabs (fn t (!= @t.id ?id))))
        (set @entity.active (if (= @entity.active ?id) "" @entity.active))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TABS_PUSH -> ready
        (emit TABS_CHANGED { tabs: @entity.tabs, active: @entity.active })
    }

    emits {
      TABS_SHOWN
      TABS_PUSH { }
        @description "Internal: hand Home the tabs as they stand."
        @tier "internal"
      PLAYGROUND_OPENED -> external {
      }
        @description "The playground tab was opened: its catalog starts listing the installed behaviors."
      TABS_CHANGED -> external {
        tabs : [LaunchpadTab]!
        active : string!
      }
        @description "The open tabs and the one in front (empty is Home)."
      APP_SHOWN -> external {
        id : string!
      }
        @description "An app was brought to the front: its board reads once, the first time."
    }

    listens {
      LaunchpadHome.TAB_OPEN -> TAB_OPEN
      LaunchpadHome.HOME_CLOSE -> TAB_CLOSE
      LaunchpadRail.RAIL_HOME -> TAB_HOME
      LaunchpadRail.RAIL_CLOSE_ASKED -> TAB_CLOSE
      TABS_SHOWN { }
      TABS_PUSH { }
      PLAYGROUND_OPENED { }
      TAB_OPEN {
        behavior : string!
        label : string!
        icon : string!
        topic : string!
      }
      TAB_HOME { }
      TAB_SELECT {
        id : string!
      }
      TAB_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadHome -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
      eyebrow : string = "Almadar · المدار"
        @label "Eyebrow"
        @tier "presentation"
      headline : string = "Launchpad"
        @label "Headline"
        @tier "presentation"
      lede : string = "Every program this machine runs, in one orbit: open a board, watch the kernel, and pick up where you left off."
        @label "Lede"
        @tier "presentation"
      heroApps : [string] = ["almadar-std/std-behavior-playground", "almadar-std/std-ci-status"]
        @label "Hero apps"
        @description "The boards the hero offers as buttons, the first as the primary one."
        @tier "presentation"
      trendSamples : number = 30
        @label "Trend samples"
        @description "How many of the latest machine samples the CPU and load sparklines draw."
        @tier "presentation"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit RECENTS_LOAD {})
        (emit STATS_START {})
        (emit ORB_STATS_ASK {})
        (emit HOME_SHOWN {})
      HOME_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: xl, className: "mx-auto w-full max-w-7xl pb-12", children: [
            @trait.UpdatesBanner,
            { type: box, position: relative, overflow: hidden, rounded: "2xl", border: true, bg: gradient, texture: true, className: "border-primary/25 shadow-elevation-card", children: [
              { type: geometric-pattern, variant: khatam, mode: background, opacity: 0.08, scale: 1.4 },
              { type: box, position: relative, padding: lg, className: "md:p-10", children: [
                { type: box, className: "grid gap-8 items-center lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]", children: [
                  { type: stack, direction: vertical, gap: lg, justify: center, children: [
                    { type: stack, direction: horizontal, gap: sm, align: center, wrap: true, children: [
                      { type: status-dot, status: (if @entity.kernelReady online away), pulse: true, size: sm, label: (if @entity.kernelReady "Kernel live" "Starting") },
                      { type: badge, variant: primary, size: md, label: (if (= @entity.orbVersion "") "orb" @entity.orbVersion) },
                      { type: badge, variant: neutral, size: md, label: (str/concat (array/len @entity.openTabs) " open · " (array/len @config.boardList) " apps") }
                    ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: overline, color: primary, className: "uppercase tracking-[0.3em]", content: @config.eyebrow },
                      { type: typography, variant: h1, size: "3xl", weight: bold, className: "tracking-tight", content: @config.headline },
                      { type: typography, variant: body, color: muted, className: "max-w-xl text-lg", content: @config.lede }
                    ] },
                    { type: stack, direction: horizontal, gap: sm, wrap: true, children: (array/map (array/filter @config.heroApps (fn id (array/some @config.boardList (fn a (= @a.id @id))))) (fn id (let ((a (array/find @config.boardList (fn x (= @x.id @id))))) { type: button, variant: (if (= @id (array/first @config.heroApps)) primary secondary), size: lg, icon: @a.icon, label: @a.label, action: APP_OPEN, actionPayload: { behavior: @id } }))) }
                  ] },
                  { type: box, rounded: xl, padding: md, className: "min-w-0 bg-background/50 backdrop-blur border border-primary/20", children: [@trait.SystemOrb] }
                ] }
              ] }
            ] },
            { type: stack, direction: vertical, gap: sm, children: [
              { type: simple-grid, minChildWidth: 230, gap: md, children: [
                { type: box, rounded: xl, border: true, padding: lg, className: "bg-card/70 border-border hover:border-primary/40 transition-colors", children: [{ type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: stack, direction: horizontal, gap: sm, align: center, children: [{ type: box, rounded: lg, className: "w-9 h-9 flex items-center justify-center bg-primary/10", children: [{ type: icon, name: cpu, size: sm, color: primary }] }, { type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "CPU" }] }, { type: status-dot, status: (if (> @entity.cpuPercent 85) critical (if (> @entity.cpuPercent 60) warning online)), pulse: true, size: sm }] }, (if @entity.statsReady { type: stack, direction: vertical, gap: sm, children: [{ type: animated-counter, value: (math/round @entity.cpuPercent 0), suffix: "%", className: "text-4xl font-semibold tabular-nums tracking-tight" }, { type: sparkline, data: @entity.cpuHistory, color: primary, fill: true, height: 44, strokeWidth: 2, className: "w-full" }] } { type: skeleton, variant: text, rows: 2 })] }] },
                { type: box, rounded: xl, border: true, padding: lg, className: "bg-card/70 border-border hover:border-primary/40 transition-colors", children: [{ type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: stack, direction: horizontal, gap: sm, align: center, children: [{ type: box, rounded: lg, className: "w-9 h-9 flex items-center justify-center bg-primary/10", children: [{ type: icon, name: memory-stick, size: sm, color: primary }] }, { type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Memory" }] }, { type: typography, variant: caption, color: muted, content: (let ((used (format/bytes @entity.memoryUsed)) (total (format/bytes @entity.memoryTotal))) (if (and @entity.statsReady (!= @used null) (!= @total null)) (str/concat @used " of " @total) "")) }] }, (if @entity.statsReady { type: stack, direction: vertical, gap: sm, children: [{ type: animated-counter, value: (math/round @entity.memoryPercent 0), suffix: "%", className: "text-4xl font-semibold tabular-nums tracking-tight" }, { type: progress-bar, value: @entity.memoryPercent, max: 100, size: sm, color: (if (> @entity.memoryPercent 85) warning primary) }] } { type: skeleton, variant: text, rows: 2 })] }] },
                { type: box, rounded: xl, border: true, padding: lg, className: "bg-card/70 border-border hover:border-primary/40 transition-colors", children: [{ type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: stack, direction: horizontal, gap: sm, align: center, children: [{ type: box, rounded: lg, className: "w-9 h-9 flex items-center justify-center bg-primary/10", children: [{ type: icon, name: gauge, size: sm, color: primary }] }, { type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Load" }] }, { type: typography, variant: caption, color: muted, content: "1-minute average" }] }, (if @entity.statsReady { type: stack, direction: vertical, gap: sm, children: [{ type: typography, variant: h2, weight: semibold, className: "text-4xl tabular-nums tracking-tight", content: (str/concat (math/round @entity.load1 2)) }, { type: sparkline, data: @entity.loadHistory, color: info, fill: true, height: 44, strokeWidth: 2, className: "w-full" }] } { type: skeleton, variant: text, rows: 2 })] }] },
                { type: box, rounded: xl, border: true, padding: lg, className: "bg-card/70 border-border hover:border-primary/40 transition-colors", children: [{ type: stack, direction: vertical, gap: md, children: [{ type: stack, direction: horizontal, justify: between, align: center, children: [{ type: stack, direction: horizontal, gap: sm, align: center, children: [{ type: box, rounded: lg, className: "w-9 h-9 flex items-center justify-center bg-primary/10", children: [{ type: icon, name: clock, size: sm, color: primary }] }, { type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Uptime" }] }, { type: typography, variant: caption, color: muted, content: "this machine" }] }, (if @entity.statsReady { type: stack, direction: vertical, gap: xs, children: [{ type: typography, variant: h3, size: xl, weight: semibold, className: "tracking-tight", content: (time/duration (* 1000 @entity.machineUptime)) }, { type: typography, variant: caption, color: muted, content: (str/concat "orb " (if @entity.orbUptimeReady (str/concat "up " (time/duration @entity.orbUptimeMs)) "starting")) }] } { type: skeleton, variant: text, rows: 2 })] }] }
              ] },
              (if (= (array/len @entity.statsUnavailable) 0) null { type: typography, content: (str/concat "Not available: " (str/join (array/map @entity.statsUnavailable (fn u (str/concat @u " (" (object/get @entity.statsErrors @u "") ")"))) "; ")), variant: caption, color: muted })
            ] },
            { type: box, rounded: xl, border: true, padding: lg, className: "bg-card/40 border-border", children: [
              { type: stack, direction: vertical, gap: md, children: [
                { type: stack, direction: horizontal, gap: sm, align: center, children: [
                  { type: icon, name: orbit, size: sm, color: primary },
                  { type: typography, variant: h4, weight: semibold, content: "Orb runtime" },
                  { type: status-dot, status: (if @entity.kernelReady online offline), size: sm }
                ] },
                { type: simple-grid, minChildWidth: 160, gap: lg, children: [
                  { type: stack, direction: vertical, gap: xs, children: [{ type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Version" }, { type: typography, variant: h4, weight: semibold, className: "tabular-nums", content: (if (= @entity.orbVersion "") "…" @entity.orbVersion) }] },
                  { type: stack, direction: vertical, gap: xs, children: [{ type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Running for" }, { type: typography, variant: h4, weight: semibold, className: "tabular-nums", content: (if @entity.orbUptimeReady (time/duration @entity.orbUptimeMs) "…") }] },
                  { type: stack, direction: vertical, gap: xs, children: [{ type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Kernel traits" }, (if @entity.kernelReady { type: animated-counter, value: @entity.registeredTraits, className: "self-start text-left text-2xl font-semibold tabular-nums text-primary" } { type: typography, variant: h4, content: "…" })] },
                  { type: stack, direction: vertical, gap: xs, children: [{ type: typography, variant: overline, color: muted, className: "uppercase tracking-widest", content: "Live instances" }, (if @entity.kernelReady { type: animated-counter, value: @entity.activeInstances, className: "self-start text-left text-2xl font-semibold tabular-nums text-primary" } { type: typography, variant: h4, content: "…" })] }
                ] },
                (if (= (array/count ["version", "kernel", "process-uptime"] (fn k (object/has @entity.statsErrors @k))) 0) null { type: typography, content: (str/concat "Not read: " (str/join (array/map (array/filter ["version", "kernel", "process-uptime"] (fn k (object/has @entity.statsErrors @k))) (fn k (str/concat @k " (" (object/get @entity.statsErrors @k "") ")"))) "; ")), variant: caption, color: muted })
              ] }
            ] },
            { type: box, className: "grid gap-6 lg:grid-cols-[minmax(0,1fr)_320px]", children: [
              { type: stack, direction: vertical, gap: md, children: [
                { type: stack, direction: horizontal, justify: between, align: end, children: [
                  { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: overline, color: primary, className: "uppercase tracking-widest", content: "Apps" },
                    { type: typography, variant: h3, weight: bold, content: "Everything you run, one click away" }
                  ] },
                  { type: typography, variant: caption, color: muted, content: (str/concat (array/len @entity.openTabs) " of " (array/len @config.boardList) " open") }
                ] },
                { type: simple-grid, minChildWidth: 260, gap: md, children: (array/map @config.boardList (fn b { type: box, action: APP_OPEN, actionPayload: { behavior: @b.id }, rounded: xl, border: true, padding: lg, className: "group cursor-pointer bg-card/60 border-border hover:bg-card hover:border-primary/50 hover:-translate-y-0.5 hover:shadow-elevation-card transition-all", children: [
                  { type: stack, direction: vertical, gap: md, children: [
                    { type: stack, direction: horizontal, justify: between, align: center, children: [
                      { type: box, rounded: lg, className: "w-11 h-11 flex items-center justify-center bg-primary/10 group-hover:bg-primary/20 transition-colors", children: [{ type: icon, name: @b.icon, size: md, color: primary }] },
                      (if (array/some @entity.openTabs (fn t (= @t.id @b.id))) { type: status-dot, status: online, pulse: true, size: sm, label: "Open" } { type: badge, variant: neutral, size: sm, label: @b.topic })
                    ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: h4, weight: semibold, content: @b.label },
                      { type: typography, variant: small, color: muted, className: "line-clamp-2", content: @b.description }
                    ] },
                    { type: stack, direction: horizontal, gap: xs, align: center, className: "text-primary opacity-70 group-hover:opacity-100 transition-opacity", children: [
                      { type: typography, variant: caption, weight: semibold, content: (if (array/some @entity.openTabs (fn t (= @t.id @b.id))) "Bring to front" "Open") },
                      { type: icon, name: arrow-right, size: xs }
                    ] }
                  ] }
                ] })) }
              ] },
              { type: box, rounded: xl, border: true, padding: lg, className: "bg-card/40 border-border self-start", children: [
                { type: stack, direction: vertical, gap: md, children: [
                  { type: stack, direction: horizontal, gap: sm, align: center, children: [
                    { type: icon, name: history, size: sm, color: primary },
                    { type: typography, variant: h4, weight: semibold, content: "Recently opened" }
                  ] },
                  (if (= (array/len @entity.recents) 0)
                    { type: typography, variant: small, color: muted, content: "Apps you open show up here." }
                    { type: stack, direction: vertical, gap: xs, children: (array/map @entity.recents (fn r { type: box, action: APP_OPEN, actionPayload: { behavior: @r.behavior }, rounded: lg, padding: sm, className: "cursor-pointer hover:bg-primary/10 transition-colors", children: [
                      { type: stack, direction: horizontal, gap: sm, align: center, children: [
                        { type: box, rounded: md, className: "w-8 h-8 shrink-0 flex items-center justify-center bg-primary/10", children: [{ type: icon, name: (let ((a (array/find @config.boardList (fn x (= @x.id @r.behavior))))) (if (= @a null) "app-window" @a.icon)), size: xs, color: primary }] },
                        { type: stack, direction: vertical, gap: none, className: "min-w-0", children: [
                          { type: typography, variant: small, weight: semibold, className: "truncate", content: @r.label },
                          { type: typography, variant: caption, color: muted, content: (time/relative @r.at) }
                        ] }
                      ] }
                    ] })) })
                ] }
              ] }
            ] }
        ] })
      TABS_CHANGED -> ready
        (set @entity.openTabs ?tabs)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_LOADED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_CHANGED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_FAILED -> ready
        (render-ui toast { type: alert, variant: error, message: (str/concat "Recent opens: " ?error) })
      STATS_READ -> ready
        (set @entity.statsReady true)
        (set @entity.memoryTotal ?memoryTotal)
        (set @entity.memoryUsed ?memoryUsed)
        (set @entity.memoryPercent ?memoryPercent)
        (set @entity.cpuPercent ?cpuPercent)
        (set @entity.load1 ?load1)
        (set @entity.cpuHistory (array/takeLast (array/append @entity.cpuHistory ?cpuPercent) @config.trendSamples))
        (set @entity.loadHistory (array/takeLast (array/append @entity.loadHistory ?load1) @config.trendSamples))
        (set @entity.machineUptime ?uptimeSeconds)
        (set @entity.statsUnavailable ?unavailable)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
      ORB_KERNEL_READ -> ready
        (set @entity.kernelReady true)
        (set @entity.registeredSchemas ?registeredSchemas)
        (set @entity.registeredTraits ?registeredTraits)
        (set @entity.activeInstances ?activeInstances)
        (set @entity.cachedEntities ?cachedEntities)
      ORB_UPTIME_READ -> ready
        (set @entity.orbUptimeReady true)
        (set @entity.orbUptimeMs ?uptimeMs)
      ORB_VERSION_READ -> ready
        (set @entity.orbVersion ?version)
        (emit HOME_SHOWN {})
      ORB_STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
        (emit HOME_SHOWN {})
      ORB_PUSH -> ready
        (emit ORB_STATE { machine: { label: (if @entity.statsReady (str/concat "CPU " (math/round @entity.cpuPercent 0) "% · RAM " (math/round @entity.memoryPercent 0) "%") "This machine"), detail: (let ((used (format/bytes @entity.memoryUsed)) (total (format/bytes @entity.memoryTotal))) (if (and @entity.statsReady (!= @used null) (!= @total null)) (str/concat @used " of " @total " in use · load " (math/round @entity.load1 2)) "Reading the machine")) }, stars: (array/concat (array/map @entity.openTabs (fn t { id: @t.id, label: @t.label, kind: @t.topic, state: "running", weight: 0, detail: (str/concat @t.topic " · open") })) (array/map (array/filter @entity.recents (fn c (not (array/some @entity.openTabs (fn t (= @t.id @c.behavior)))))) (fn c { id: @c.behavior, label: @c.label, kind: "recent", state: "stopped", weight: 0, detail: (str/concat "not open · last opened " (time/relative @c.at)) }))) })
      APP_OPEN -> ready when (array/some @config.boardList (fn a (= @a.id ?behavior)))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit TAB_OPEN { behavior: ?behavior, label: @a.label, icon: @a.icon, topic: @a.topic }))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit RECENT_ADD { behavior: ?behavior, label: @a.label, kind: "route", command: "", route: "" }))
      ORB_OPENED -> ready when (array/some @config.boardList (fn a (= @a.id ?id)))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?id))))) (emit TAB_OPEN { behavior: ?id, label: @a.label, icon: @a.icon, topic: @a.topic }))
      ORB_OPENED -> ready when (not (array/some @config.boardList (fn a (= @a.id ?id))))
      ORB_STOPPED -> ready
        (emit HOME_CLOSE { id: ?id })
      ORB_RELAUNCHED -> ready
        (emit APP_OPEN { behavior: ?id })
    }

    emits {
      HOME_SHOWN
      ORB_PUSH { }
        @description "Internal: hand the orb view the machine and the open tabs as they stand."
        @tier "internal"
      APP_OPEN {
        behavior : string!
      }
        @description "Internal: open a listed app as a tab, or bring its tab to the front."
        @tier "internal"
      RECENTS_LOAD -> external {
      }
        @description "Read the remembered opens."
      RECENT_ADD -> external {
        behavior : string!
        label : string!
        kind : string!
        command : string!
        route : string!
      }
        @description "Remember an open."
      TAB_OPEN -> external {
        behavior : string!
        label : string!
        icon : string!
        topic : string!
      }
        @description "Open an app and put it in the rail."
      HOME_CLOSE -> external {
        id : string!
      }
        @description "Close a tab, which unmounts the app."
      STATS_START -> external {
      }
        @description "Begin sampling the machine."
      ORB_STATS_ASK -> external {
      }
        @description "Read the orb's kernel counters (and its version, the first time)."
      ORB_STATE -> external {
        machine : OrbMachine!
        stars : [OrbStar]!
      }
        @description "The machine and the open tabs around it, for the orb view."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RecentsStore.RECENTS_LOADED -> RECENTS_LOADED
      RecentsStore.RECENTS_CHANGED -> RECENTS_CHANGED
      RecentsStore.RECENTS_FAILED -> RECENTS_FAILED
      SystemStatsMeter.STATS_READ -> STATS_READ
      SystemStatsMeter.STATS_FAILED -> STATS_FAILED
      OrbStatsReader.ORB_KERNEL_READ -> ORB_KERNEL_READ
      OrbStatsReader.ORB_UPTIME_READ -> ORB_UPTIME_READ
      OrbStatsReader.ORB_VERSION_READ -> ORB_VERSION_READ
      OrbStatsReader.ORB_STATS_FAILED -> ORB_STATS_FAILED
      SystemOrb.ORB_OPEN -> ORB_OPENED
      SystemOrb.ORB_STOP -> ORB_STOPPED
      SystemOrb.ORB_RELAUNCH -> ORB_RELAUNCHED
      LaunchpadRail.RAIL_OPEN -> APP_OPEN
      FindMatch.MATCH_FOUND -> APP_OPEN when (!= ?id "home")
        with { behavior: ?id }
      LaunchpadBehaviorRoute.BEHAVIOR_LINKED -> APP_OPEN
        with { behavior: "almadar-std/std-behavior-playground" }
      HOME_SHOWN { }
      ORB_PUSH { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RECENTS_LOADED {
        items : [LaunchpadRecent]!
      }
      RECENTS_CHANGED {
        items : [LaunchpadRecent]!
      }
      RECENTS_FAILED {
        error : string!
      }
      STATS_READ {
        memoryTotal : number!
        memoryUsed : number!
        memoryAvailable : number!
        memoryPercent : number!
        cpuPercent : number!
        load1 : number!
        load5 : number!
        load15 : number!
        uptimeSeconds : number!
        processes : [LaunchpadProcess]!
        missing : [number]!
        unavailable : [string]!
        at : instant!
      }
      STATS_FAILED {
        stat : "memory" | "cpu" | "load" | "uptime" | "processes"!
        code : string!
        error : string!
      }
      ORB_KERNEL_READ {
        registeredSchemas : number!
        registeredTraits : number!
        activeInstances : number!
        cachedEntities : number!
      }
      ORB_UPTIME_READ {
        uptimeMs : number!
      }
      ORB_VERSION_READ {
        version : string!
      }
      ORB_STATS_FAILED {
        stat : "kernel" | "version" | "process-uptime"!
        code : string!
        error : string!
      }
      ORB_OPENED {
        id : string!
      }
      ORB_STOPPED {
        id : string!
      }
      ORB_RELAUNCHED {
        id : string!
      }
      APP_OPEN {
        behavior : string!
      }
    }
  }


  trait LaunchpadBehaviorRoute -> LaunchpadView [client] {
    initial: ready

    state ready {
      INIT -> ready
        (emit BEHAVIOR_LINKED {})
    }

    emits {
      BEHAVIOR_LINKED -> external {
      }
        @description "A link to /<package>/<behavior> was opened: the playground tab opens, and its route trait opens the behavior once the catalog is listed."
    }

    listens {
      INIT {
        package : string!
        name : string!
      }
    }
  }

  trait LaunchpadFind -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
      home : [string] = @config.homeTexts
        @label "Home words"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit MATCH { query: (str/replaceAll (default (str/decode-uri-component (default ?query "")) "") "-" " "), candidates: (array/append (array/map @config.boardList (fn a { id: @a.id, texts: (array/concat [@a.label, @a.description] @a.synonyms) })) { id: "home", texts: @config.home }) })
      FIND_FAILED -> ready
        (notify error (str/concat "Could not match \"" ?query "\" to an app (" ?code "): " ?detail))
    }

    emits {
      MATCH -> external {
        query : string!
        candidates : [{ id : string!, texts : [string]! }]!
      }
        @description "Match the path's words against the apps and the launchpad itself."
    }

    listens {
      INIT {
        query : string
      }
      FindMatch.MATCH_FAILED -> FIND_FAILED
      FIND_FAILED {
        query : string!
        code : string!
        detail : string!
      }
    }
  }

  trait FindMatch = Match.traits.VectorMatch [server] {
    listens {
      LaunchpadFind.MATCH -> MATCH
      FindSources.SOURCES_READY -> SOURCES_READY
      FindSources.SOURCES_REFUSED -> SOURCES_REFUSED
      VectorResolve.VECTORS_ANSWERED -> VECTORS_ANSWERED
      VectorResolve.VECTORS_REFUSED -> VECTORS_REFUSED
      MatchGate.SIMILARITY_MATCHED -> SIMILARITY_MATCHED
      MatchGate.SIMILARITY_ABSTAINED -> SIMILARITY_ABSTAINED
    }
  }
  trait MatchGate = Match.traits.MatchGate {
    config {
      floor: @config.matchFloor
      margin: @config.matchMargin
    }
    listens {
      FindMatch.VM_COMPARE -> COMPARE_VECTORS
    }
  }
  trait FindSources = Match.traits.MatchSources {
    listens {
      FindMatch.VM_SOURCES -> SOURCES
      VectorResolve.USER_STORE_NEEDED -> USER_STORE_NEEDED
    }
  }
  trait VectorResolve = Match.traits.VectorResolve {
    listens {
      FindMatch.VM_RESOLVE -> RESOLVE
      FindSources.USER_STORE_READ -> USER_STORE_READ
      ResolveStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      ResolveStore.VECTOR_REFUSED -> VECTOR_REFUSED
      ResolveLlmOrShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrShared.LLM_FAILED -> LLM_FAILED
