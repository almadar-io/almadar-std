app std-launchpad [
  version: "2.0.0",
  theme: "linear-clean-light",
  themes: ["game-sci-fi-dark"],
  exec: ["orb", "open", "ps"],
  env: ["PATH", "HOME", "NODE_ENV", "AUTH_PROVIDER", "OIDC_ISSUER_URL", "OIDC_AUDIENCE", "FIREBASE_PROJECT_ID", "FIREBASE_SERVICE_ACCOUNT_PATH", "FIREBASE_AUTH_EMULATOR_HOST", "FIRESTORE_EMULATOR_HOST", "ALMADAR_INTEGRATIONS_MODE"],
  sys: [memory, cpu],
  fs: { "~/.almadar/launchpad": [create], "~/.almadar/launchpad/**": [read, write, create] },
  description: "std-launchpad — the dashboard of orb's own operations that bare `orb` (orb launchpad) opens in the browser. It lists the route apps of the topics its apps knob names (the ops boards and the dev playground that hosts the behavior catalog), read with std-launchpad-kinds restricted to those package and topic pairs, as tiles under the title each section gives, each with Run (the app is started in the background with `orb serve <file> --port <port>` and the browser opened on it by std-launchpad-programs); the launchpad itself is left out by the exclude knob. Above them sit Recent, the launches remembered per machine in ~/.almadar/launchpad/recents.json (std-launchpad-recents) with how long ago, each relaunching or opening the app, and Running now: every program the launchpad holds with its port, mock or production, its resident memory (std-system-stats reading `ps` for the programs' pids), Open and Stop. Beside them the Orb view (std-launchpad-orb) draws this machine as one orb with its CPU and memory and the running programs as stars sized by memory and coloured mock or production, the stopped recent ones dimmed on an outer ring, and a click on a star opens, stops or relaunches it; under it the machine's memory, CPU, load and uptime (std-system-stats) and the orb's own version, the launchpad's uptime, the behaviors indexed per topic and the kernel's counters (std-orb-stats). The top bar holds the production/mock switch (mock starts every program with ALMADAR_INTEGRATIONS_MODE=mock; production leaves it unset) beside AUTH_PROVIDER and the problems std-http-boot-gate's environment check reports for this machine. Serve it with `orb launchpad`.",
  egress: []
]
;; @capabilities "run an orb operations app in the background, stop a running program, open a running program, see the memory and cpu of this machine and of each running program, see the orb's version and kernel counters, switch integrations between production and mock, remember recent launches"

uses Layout from "std/behaviors/std-workspace-layout"
uses Kinds from "std/behaviors/std-launchpad-kinds"
uses Programs from "std/behaviors/std-launchpad-programs"
uses Recents from "std/behaviors/std-launchpad-recents"
uses Orb from "std/behaviors/std-launchpad-orb"
uses Stats from "std/behaviors/std-system-stats"
uses OrbStats from "std/behaviors/std-orb-stats"
uses Gate from "std/behaviors/std-http-boot-gate"
uses EnvCheck from "std/behaviors/std-boot-env-check"

type LaunchpadScope = { package : string!, topic : string! }
type LaunchpadSection = { topic : string!, title : string!, run : string! }
type LaunchpadLeaf = { behavior : string!, kind : string!, description : string!, route : string! }
type LaunchpadApp = { behavior : string!, label : string!, description : string!, topic : string!, kind : string!, route : string! }
type LaunchpadProcess = { pid : number!, rssKb : number! }
type LaunchpadRunning = { id : string!, behavior : string!, label : string!, kind : string!, verb : string!, file : string!, port : number!, url : string!, pid : number!, mock : boolean!, status : "starting" | "running"! }
type LaunchpadRecent = { behavior : string!, label : string!, kind : string!, command : string!, route : string!, at : number! }
type LaunchpadSkipped = { package : string!, error : string! }
type LaunchpadTopicCount = { package : string!, topic : string!, count : number! }
type LaunchpadGateEnv = { authProvider : string, oidcIssuerUrl : string, oidcAudience : string, firebaseProjectId : string, firebaseServiceAccountPath : string, firebaseAuthEmulatorHost : string, firestoreEmulatorHost : string, integrationsMock : boolean }
type OrbMachine = { label : string!, detail : string! }
type OrbStar = { id : string!, label : string!, kind : string!, state : "starting" | "running" | "stopped"!, weight : number!, detail : string! }
type OrbClicked = { id : string!, label : string, group : string, size : number, color : string }

orbital Launchpad {
  entity LaunchpadView [runtime] {
    id : string!
    apps : [LaunchpadApp] = []
    appsStatus : "loading" | "ready" | "failed" = loading
    appsError : string = ""
    skipped : [LaunchpadSkipped] = []
    indexed : [LaunchpadTopicCount] = []
    running : [LaunchpadRunning] = []
    recents : [LaunchpadRecent] = []
    mock : boolean @description "Programs start with ALMADAR_INTEGRATIONS_MODE=mock when on; with it unset (production) when off." = false
    authProvider : string = ""
    problems : [string] = []
    envChecked : boolean = false
    orbUptimeMs : number = 0
    statsReady : boolean = false
    memoryTotal : number = 0
    memoryUsed : number = 0
    memoryPercent : number = 0
    cpuPercent : number = 0
    load1 : number = 0
    machineUptime : number = 0
    procs : [LaunchpadProcess] = []
    statsUnavailable : [string] = []
    statsErrors : Map string string = {}
    orbVersion : string = ""
    kernelReady : boolean = false
    registeredSchemas : number = 0
    registeredTraits : number = 0
    activeInstances : number = 0
    cachedEntities : number = 0
  }

  config {
    apps : [LaunchpadScope] = [{ package: (quote "@almadar/std"), topic: "ops" }, { package: (quote "@almadar/std"), topic: "dev" }]
      @label "Apps"
      @description "The package and topic pairs whose apps the launchpad lists, in the order they are read; std-launchpad-kinds indexes only these."
    appKind : string = "route"
      @label "App kind"
      @description "The kind of behavior listed: a route app serves a page of its own."
    exclude : [string] = ["almadar-std/std-launchpad", "almadar-std/std-launchpad-orb"]
      @label "Left out"
      @description "Behaviors not listed even when they match: the launchpad itself and its Orb view, which has a page of its own."
    sections : [LaunchpadSection] = [{ topic: "ops", title: "Ops", run: "Run" }, { topic: "dev", title: "Tools", run: "Open" }]
      @label "Sections"
      @description "The topics shown as tile sections, in order, with each section's heading and the text of its Run button."
    title : string = "Orb"
      @label "Title"
  }

  trait LaunchpadFrame = Layout.traits.WorkspaceLayout -> LaunchpadView {
    config {
      mainTrait: @trait.LaunchpadStage
      showSidebar: false
      showBottomPanel: false
      showStatusBar: false
      showTopBar: true
      topBarTrait: @trait.LaunchpadTopBar
    }
  }

  trait KindsScopeLoader = Kinds.traits.KindsScopeLoader {
    config {
      scope: @config.apps
    }
    listens {
      LaunchpadStage.KINDS_SCOPE_LOAD -> KINDS_SCOPE_LOAD
      KindsRows.KINDS_LEAVES -> KINDS_LEAVES
      KindsTopic.KINDS_FAILED -> KINDS_FAILED
      KindsRows.KINDS_FAILED -> KINDS_FAILED
    }
  }
  trait KindsTopic = Kinds.traits.KindsTopic {
    listens {
      KindsScopeLoader.KINDS_LOAD -> KINDS_LOAD
      KindsClassifier.KINDS_CLASSIFIED -> KINDS_CLASSIFIED
      KindsIndex.KINDS_ENTRIES -> KINDS_ENTRIES
    }
  }
  trait KindsRows = Kinds.traits.KindsRows {
    listens {
      KindsTopic.KINDS_READY -> KINDS_READY
    }
  }
  trait KindsIndex = Kinds.traits.KindsIndex {
    config {
      scope: @config.apps
    }
    listens {
      KindsTopic.KINDS_REFRESH -> KINDS_REFRESH
      KindsTopic.KINDS_REFRESH_FAILED -> KINDS_REFRESH_FAILED
    }
  }
  trait KindsClassifier = Kinds.traits.KindsClassifier {
    listens {
      KindsTopic.KIND_CLASSIFY -> KIND_CLASSIFY
    }
  }

  trait ProgramRunner = Programs.traits.ProgramRunner {
    listens {
      LaunchpadStage.PROGRAM_LAUNCH -> PROGRAM_LAUNCH
      LaunchpadStage.PROGRAM_STOP -> PROGRAM_STOP
      LaunchpadStage.PROGRAM_OPEN -> PROGRAM_OPEN
      LaunchpadStage.PROGRAMS_LIST -> PROGRAMS_LIST
      SystemOrb.ORB_OPEN -> PROGRAM_OPEN
      SystemOrb.ORB_STOP -> PROGRAM_STOP
    }
  }

  trait RecentsStore = Recents.traits.RecentsStore {
    listens {
      LaunchpadStage.RECENTS_LOAD -> RECENTS_LOAD
      LaunchpadStage.RECENT_ADD -> RECENT_ADD
    }
  }

  trait SystemStatsMeter = Stats.traits.SystemStatsMeter {
    listens {
      LaunchpadStage.STATS_START -> STATS_START
      StatsWatch.STATS_WATCH -> STATS_WATCH
      ProcessReader.CLI_DONE -> PS_DONE
      ProcessReader.CLI_FAILED -> PS_FAILED
    }
  }
  trait ProcessReader = Stats.traits.ProcessReader {}

  trait OrbStatsReader = OrbStats.traits.OrbStatsReader {
    listens {
      LaunchpadStage.ORB_STATS_ASK -> ORB_STATS_ASK
      SystemStatsMeter.STATS_READ -> ORB_STATS_ASK
      OrbVersionRunner.CLI_DONE -> ORB_VERSION_DONE
      OrbVersionRunner.CLI_FAILED -> ORB_VERSION_FAILED
    }
  }
  trait OrbVersionRunner = OrbStats.traits.OrbVersionRunner {}

  trait SystemOrb = Orb.traits.SystemOrb {
    listens {
      LaunchpadStage.ORB_STATE -> ORB_STATE
      NODE_CLICK {
        node : OrbClicked!
      }
      STAR_OPEN {
        id : string!
      }
      STAR_STOP {
        id : string!
      }
      STAR_RELAUNCH {
        id : string!
      }
    }
  }

  trait StatsWatch -> LaunchpadView {
    initial: ready

    state ready {
      INIT -> ready
      PROGRAMS_CHANGED -> ready
        (emit STATS_WATCH { pids: (array/map (array/filter ?running (fn r (> @r.pid 0))) (fn r @r.pid)) })
    }

    emits {
      STATS_WATCH -> external {
        pids : [number]!
      }
        @description "The processes of the programs the launchpad holds, whose memory is read."
    }

    listens {
      ProgramRunner.PROGRAMS_CHANGED -> PROGRAMS_CHANGED
      PROGRAMS_CHANGED {
        running : [LaunchpadRunning]!
      }
    }
  }

  trait BootGuard = Gate.traits.BootGate {
    config {
      mock: false
      calledServices: []
    }
    listens {
      BootCheck.ENV_CHECKED -> ENV_CHECKED
    }
  }
  trait BootCheck = EnvCheck.traits.BootEnvCheck {
    listens {
      BootGuard.ENV_CHECK -> ENV_CHECK
    }
  }

  trait LaunchpadTopBar -> LaunchpadView [client] {
    config {
      heading : string = @config.title
        @label "Title"
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (emit BAR_SHOWN {})
      BAR_SHOWN -> idle
        (render-ui main { type: stack, direction: horizontal, align: center, justify: between, gap: md, className: "px-4 py-2 flex-wrap", children: [
          { type: stack, direction: horizontal, align: center, gap: sm, children: [
            { type: icon, name: orbit, size: md },
            { type: typography, content: @config.heading, variant: h4, weight: semibold }
          ] },
          { type: stack, direction: horizontal, align: center, gap: md, className: "flex-wrap", children: [
            { type: badge, label: (if (= @entity.authProvider "") "AUTH_PROVIDER not set" (str/concat "AUTH_PROVIDER " @entity.authProvider)), variant: (if (= @entity.authProvider "") warning default) },
            { type: badge, label: (if (not @entity.envChecked) "Checking the environment" (if @entity.mock "Mock: no credentials needed" (if (= (array/len @entity.problems) 0) "Credentials present" (str/concat (array/len @entity.problems) " environment problems")))), variant: (if (not @entity.envChecked) default (if @entity.mock info (if (= (array/len @entity.problems) 0) success warning))) },
            { type: switch, label: "Mock integrations", checked: @entity.mock, action: MODE_TOGGLED }
          ] }
        ] })
      GATE_ENV -> idle
        (set @entity.authProvider (or ?env.authProvider ""))
        (emit BAR_SHOWN {})
        (emit INTEGRATIONS_CHANGED { mock: @entity.mock, authProvider: @entity.authProvider, problems: @entity.problems, envChecked: @entity.envChecked })
      GATE_CHECKED -> idle
        (set @entity.problems ?problems)
        (set @entity.envChecked true)
        (emit BAR_SHOWN {})
        (emit INTEGRATIONS_CHANGED { mock: @entity.mock, authProvider: @entity.authProvider, problems: @entity.problems, envChecked: @entity.envChecked })
      MODE_TOGGLED -> idle
        (set @entity.mock ?checked)
        (emit BAR_SHOWN {})
        (emit INTEGRATIONS_CHANGED { mock: @entity.mock, authProvider: @entity.authProvider, problems: @entity.problems, envChecked: @entity.envChecked })
    }

    emits {
      BAR_SHOWN
      INTEGRATIONS_CHANGED -> external {
        mock : boolean!
        authProvider : string!
        problems : [string]!
        envChecked : boolean!
      }
        @description "The mock switch or the environment check changed."
    }

    listens {
      BootGuard.ENV_CHECK -> GATE_ENV
      BootCheck.ENV_CHECKED -> GATE_CHECKED
      GATE_ENV {
        env : LaunchpadGateEnv!
        production : boolean!
        mock : boolean!
        missingCredentials : [string]
        catalogError : string
      }
      GATE_CHECKED {
        requestId : number
        problems : [string]!
        ok : boolean!
      }
      MODE_TOGGLED {
        checked : boolean
      }
    }
  }

  trait LaunchpadStage -> LaunchpadView [client] {
    config {
      listedKind : string = @config.appKind
        @label "App kind"
        @tier "domain"
      leftOut : [string] = @config.exclude
        @label "Left out"
        @tier "domain"
      sectionList : [LaunchpadSection] = @config.sections
        @label "Sections"
        @tier "presentation"
    }
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.appsStatus loading)
        (emit KINDS_SCOPE_LOAD {})
        (emit RECENTS_LOAD {})
        (emit PROGRAMS_LIST {})
        (emit STATS_START {})
        (emit ORB_STATS_ASK {})
        (emit STAGE_SHOWN {})
      STAGE_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: lg, className: "h-full overflow-y-auto p-6", children: [
          { type: stack, direction: vertical, gap: xs, className: (if (= (array/len @entity.recents) 0) "hidden" ""), children: [
            { type: typography, content: "Recent", variant: overline, color: muted },
            { type: stack, direction: horizontal, gap: sm, className: "flex-wrap", children: (array/map @entity.recents (fn r { type: button, label: (str/concat @r.label " · " (time/relative @r.at)), variant: secondary, size: sm, className: "rounded-full", action: RECENT_PICK, actionPayload: { behavior: @r.behavior } })) }
          ] },
          { type: simple-grid, cols: 2, minChildWidth: 420, gap: lg, children: [
            { type: stack, direction: vertical, gap: lg, children: [
              { type: stack, direction: vertical, gap: xs, children: [
                { type: typography, content: "Running now", variant: overline, color: muted },
                { type: typography, content: "Nothing is running. Run an app below and it shows up here.", variant: body, color: muted, className: (if (= (array/len @entity.running) 0) "" hidden) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @entity.running (fn r { type: card, padding: sm, children: [
                  { type: stack, direction: horizontal, align: center, justify: between, gap: md, className: "flex-wrap", children: [
                    { type: stack, direction: horizontal, align: center, gap: sm, className: "flex-wrap", children: [
                      { type: typography, content: @r.label, variant: body, weight: medium },
                      { type: badge, label: (if (> @r.port 0) (str/concat "port " @r.port) "port set in the program"), variant: default },
                      { type: badge, label: (if @r.mock "mock" "production"), variant: (if @r.mock info success) },
                      { type: badge, label: (if (array/some @entity.procs (fn q (= @q.pid @r.pid))) (format/bytes (* 1024 (object/get (array/find @entity.procs (fn q (= @q.pid @r.pid))) "rssKb" 0))) (if (= @r.status starting) "starting" "memory not read yet")), variant: (if (= @r.status starting) warning default) }
                    ] },
                    { type: stack, direction: horizontal, align: center, gap: sm, children: [
                      { type: button, label: "Open", variant: secondary, size: sm, action: RUNNING_OPEN, actionPayload: { id: @r.id }, className: (if (= @r.url "") hidden "") },
                      { type: button, label: "Stop", variant: ghost, size: sm, action: RUNNING_STOP, actionPayload: { id: @r.id } }
                    ] }
                  ] }
                ] })) }
              ] },
              { type: skeleton, variant: list, rows: 3, className: (if (= @entity.appsStatus loading) "" hidden) },
              { type: alert, variant: error, title: "The apps could not be listed", message: @entity.appsError, className: (if (= @entity.appsStatus failed) "" hidden) },
              { type: alert, variant: warning, title: "Packages skipped", message: (str/join (array/map @entity.skipped (fn k (str/concat @k.package ": " @k.error))) "; "), className: (if (= (array/len @entity.skipped) 0) "hidden" "") },
              { type: stack, direction: vertical, gap: lg, children: (array/map @config.sectionList (fn sec { type: stack, direction: vertical, gap: xs, children: [
                { type: typography, content: @sec.title, variant: overline, color: muted },
                { type: typography, content: "Nothing to run here.", variant: body, color: muted, className: (if (and (= @entity.appsStatus ready) (= (array/count @entity.apps (fn a (= @a.topic @sec.topic))) 0)) "" hidden) },
                { type: simple-grid, minChildWidth: 240, gap: md, children: (array/map (array/filter @entity.apps (fn a (= @a.topic @sec.topic))) (fn a { type: card, padding: md, children: [
                  { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, content: @a.label, variant: h5, weight: semibold },
                    { type: typography, content: @a.description, variant: caption, color: muted, overflow: clamp-3 },
                    { type: stack, direction: horizontal, align: center, gap: sm, children: [
                      { type: button, label: @sec.run, variant: primary, size: sm, action: RUN_APP, actionPayload: { behavior: @a.behavior }, className: (if (array/some @entity.running (fn r (= @r.id @a.behavior))) hidden "") },
                      { type: button, label: "Open", variant: secondary, size: sm, action: RUNNING_OPEN, actionPayload: { id: @a.behavior }, className: (if (array/some @entity.running (fn r (and (= @r.id @a.behavior) (!= @r.url "")))) "" hidden) },
                      { type: button, label: "Stop", variant: ghost, size: sm, action: RUNNING_STOP, actionPayload: { id: @a.behavior }, className: (if (array/some @entity.running (fn r (= @r.id @a.behavior))) "" hidden) },
                      { type: badge, label: "running", variant: success, className: (if (array/some @entity.running (fn r (= @r.id @a.behavior))) "" hidden) }
                    ] }
                  ] }
                ] })) }
              ] })) }
            ] },
            { type: stack, direction: vertical, gap: lg, children: [
              { type: box, children: [@trait.SystemOrb] },
              { type: card, padding: md, children: [
                { type: stack, direction: vertical, gap: sm, children: [
                  { type: typography, content: "This machine", variant: overline, color: muted },
                  { type: simple-grid, minChildWidth: 110, gap: sm, children: [
                    { type: stat-display, label: "CPU", value: (if @entity.statsReady (str/concat (math/round @entity.cpuPercent 0) "%") "…"), size: sm },
                    { type: stat-display, label: "Memory", value: (if @entity.statsReady (str/concat (math/round @entity.memoryPercent 0) "%") "…"), size: sm },
                    { type: stat-display, label: "Used", value: (if @entity.statsReady (format/bytes @entity.memoryUsed) "…"), size: sm },
                    { type: stat-display, label: "Load", value: (if @entity.statsReady (math/round @entity.load1 2) "…"), size: sm },
                    { type: stat-display, label: "Up", value: (if @entity.statsReady (time/duration (* 1000 @entity.machineUptime)) "…"), size: sm }
                  ] },
                  { type: typography, content: (str/concat "Not available: " (str/join (array/map @entity.statsUnavailable (fn u (str/concat @u " (" (object/get @entity.statsErrors @u "") ")"))) "; ")), variant: caption, color: muted, className: (if (= (array/len @entity.statsUnavailable) 0) "hidden" "") },
                  { type: typography, content: "Orb", variant: overline, color: muted },
                  { type: simple-grid, minChildWidth: 110, gap: sm, children: [
                    { type: stat-display, label: "Version", value: (if (= @entity.orbVersion "") "…" @entity.orbVersion), size: sm },
                    { type: stat-display, label: "Orb up", value: (if @entity.kernelReady (time/duration @entity.orbUptimeMs) "…"), size: sm },
                    { type: stat-display, label: "Behaviors indexed", value: (array/sum (array/map @entity.indexed (fn t @t.count))), size: sm },
                    { type: stat-display, label: "Kernel traits", value: (if @entity.kernelReady @entity.registeredTraits "…"), size: sm },
                    { type: stat-display, label: "Kernel instances", value: (if @entity.kernelReady @entity.activeInstances "…"), size: sm }
                  ] },
                  { type: typography, content: (str/join (array/map @entity.indexed (fn t (str/concat @t.topic " " @t.count))) " · "), variant: caption, color: muted, className: (if (= (array/len @entity.indexed) 0) "hidden" "") },
                  { type: typography, content: (str/concat "Not read: " (str/join (array/map (array/filter ["version", "kernel"] (fn k (object/has @entity.statsErrors @k))) (fn k (str/concat @k " (" (object/get @entity.statsErrors @k "") ")"))) "; ")), variant: caption, color: muted, className: (if (= (array/count ["version", "kernel"] (fn k (object/has @entity.statsErrors @k))) 0) "hidden" "") }
                ] }
              ] }
            ] }
          ] },
          { type: alert, variant: warning, title: "Environment problems", message: (str/join @entity.problems "; "), className: (if (or @entity.mock (not @entity.envChecked) (= (array/len @entity.problems) 0)) "hidden" "") },
          { type: typography, content: (str/concat (if (= @entity.authProvider "") "AUTH_PROVIDER not set" (str/concat "AUTH_PROVIDER " @entity.authProvider)) " · " (if @entity.envChecked (str/concat (array/len @entity.problems) " environment problems") "checking the environment") (if @entity.mock " · integrations are mocked" "")), variant: caption, color: muted }
        ] })
      KINDS_LEAVES -> ready
        (set @entity.apps (array/concat @entity.apps (array/map (array/filter ?data (fn l (and (= @l.kind @config.listedKind) (not (array/includes @config.leftOut @l.behavior))))) (fn l { behavior: @l.behavior, label: (array/last (str/split @l.behavior "/")), description: @l.description, topic: ?topic, kind: @l.kind, route: @l.route }))))
        (emit STAGE_SHOWN {})
      KINDS_SCOPE_READY -> ready
        (set @entity.appsStatus ready)
        (emit STAGE_SHOWN {})
      KINDS_FAILED -> ready
        (set @entity.appsStatus failed)
        (set @entity.appsError (str/concat ?package " / " ?topic " could not be read: " ?error))
        (emit STAGE_SHOWN {})
      INDEX_READY -> ready
        (set @entity.skipped ?skipped)
        (set @entity.indexed ?topics)
        (emit STAGE_SHOWN {})
      PROGRAMS_CHANGED -> ready
        (set @entity.running ?running)
        (emit ORB_PUSH {})
        (emit STAGE_SHOWN {})
      PROGRAM_STARTED -> ready
        (render-ui toast { type: alert, variant: success, message: (str/concat ?id (if (> ?port 0) (str/concat " is starting on port " ?port) " is starting")) })
      PROGRAM_ENDED -> ready when (= ?code 0)
        (render-ui toast { type: alert, variant: info, message: (str/concat ?id " ended") })
      PROGRAM_ENDED -> ready when (!= ?code 0)
        (render-ui toast { type: alert, variant: error, message: (str/concat ?id " ended with code " ?code) })
      PROGRAM_FAILED -> ready
        (render-ui toast { type: alert, variant: error, message: (str/concat ?behavior ": " ?error) })
      RECENTS_LOADED -> ready
        (set @entity.recents ?items)
        (emit ORB_PUSH {})
        (emit STAGE_SHOWN {})
      RECENTS_CHANGED -> ready
        (set @entity.recents ?items)
        (emit ORB_PUSH {})
        (emit STAGE_SHOWN {})
      RECENTS_FAILED -> ready
        (render-ui toast { type: alert, variant: error, message: (str/concat "Recent launches: " ?error) })
      INTEGRATIONS_CHANGED -> ready
        (set @entity.mock ?mock)
        (set @entity.authProvider ?authProvider)
        (set @entity.problems ?problems)
        (set @entity.envChecked ?envChecked)
        (emit STAGE_SHOWN {})
      STATS_READ -> ready
        (set @entity.statsReady true)
        (set @entity.memoryTotal ?memoryTotal)
        (set @entity.memoryUsed ?memoryUsed)
        (set @entity.memoryPercent ?memoryPercent)
        (set @entity.cpuPercent ?cpuPercent)
        (set @entity.load1 ?load1)
        (set @entity.machineUptime ?uptimeSeconds)
        (set @entity.procs ?processes)
        (set @entity.statsUnavailable ?unavailable)
        (emit ORB_PUSH {})
        (emit STAGE_SHOWN {})
      STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
      ORB_KERNEL_READ -> ready
        (set @entity.kernelReady true)
        (set @entity.registeredSchemas ?registeredSchemas)
        (set @entity.registeredTraits ?registeredTraits)
        (set @entity.activeInstances ?activeInstances)
        (set @entity.cachedEntities ?cachedEntities)
        (set @entity.orbUptimeMs ?uptimeMs)
      ORB_VERSION_READ -> ready
        (set @entity.orbVersion ?version)
        (emit STAGE_SHOWN {})
      ORB_STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
        (emit STAGE_SHOWN {})
      ORB_PUSH -> ready
        (emit ORB_STATE { machine: { label: (if @entity.statsReady (str/concat "CPU " (math/round @entity.cpuPercent 0) "% · RAM " (math/round @entity.memoryPercent 0) "%") "This machine"), detail: (if @entity.statsReady (str/concat (format/bytes @entity.memoryUsed) " of " (format/bytes @entity.memoryTotal) " in use · load " (math/round @entity.load1 2)) "Reading the machine") }, stars: (array/concat (array/map @entity.running (fn r { id: @r.id, label: @r.label, kind: (if @r.mock "mock" "production"), state: @r.status, weight: (* 1024 (object/get (array/find @entity.procs (fn q (= @q.pid @r.pid))) "rssKb" 0)), detail: (str/concat (if (> @r.port 0) (str/concat "port " @r.port) "no port") " · " (if (array/some @entity.procs (fn q (= @q.pid @r.pid))) (format/bytes (* 1024 (object/get (array/find @entity.procs (fn q (= @q.pid @r.pid))) "rssKb" 0))) "memory not read yet")) })) (array/map (array/filter @entity.recents (fn c (not (array/some @entity.running (fn r (= @r.id @c.behavior)))))) (fn c { id: @c.behavior, label: @c.label, kind: "recent", state: "stopped", weight: 0, detail: (str/concat "stopped · last run " (time/relative @c.at)) }))) })
      RUN_APP -> ready when (array/some @entity.apps (fn a (= @a.behavior ?behavior)))
        (emit PROGRAM_LAUNCH { behavior: ?behavior, label: (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "label" ""), kind: (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "kind" ""), verb: (if (or (= (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "kind" "") route) (= (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "kind" "") http)) "serve" "run"), ported: (= (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "kind" "") route), open: (= (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "kind" "") route), route: (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "route" ""), mock: @entity.mock })
        (emit RECENT_ADD { behavior: ?behavior, label: (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "label" ""), kind: (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "kind" ""), command: "", route: (object/get (array/find @entity.apps (fn a (= @a.behavior ?behavior))) "route" "") })
      RECENT_PICK -> ready when (array/some @entity.running (fn r (= @r.id ?behavior)))
        (emit PROGRAM_OPEN { id: ?behavior })
      RECENT_PICK -> ready when (and (not (array/some @entity.running (fn r (= @r.id ?behavior)))) (array/some @entity.recents (fn c (= @c.behavior ?behavior))))
        (emit PROGRAM_LAUNCH { behavior: ?behavior, label: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "label" ""), kind: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "kind" ""), verb: (if (or (= (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "kind" "") route) (= (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "kind" "") http)) "serve" "run"), ported: (= (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "kind" "") route), open: (= (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "kind" "") route), route: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "route" ""), mock: @entity.mock })
        (emit RECENT_ADD { behavior: ?behavior, label: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "label" ""), kind: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "kind" ""), command: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "command" ""), route: (object/get (array/find @entity.recents (fn c (= @c.behavior ?behavior))) "route" "") })
      ORB_RELAUNCHED -> ready
        (emit RECENT_PICK { behavior: ?id })
      RUNNING_OPEN -> ready
        (emit PROGRAM_OPEN { id: ?id })
      RUNNING_STOP -> ready
        (emit PROGRAM_STOP { id: ?id })
    }

    emits {
      STAGE_SHOWN
      ORB_PUSH { }
        @description "Internal: hand the orb view the machine and the programs as they stand."
        @tier "internal"
      RECENT_PICK {
        behavior : string!
      }
        @description "Internal: relaunch or open a remembered launch."
        @tier "internal"
      KINDS_SCOPE_LOAD -> external {
      }
        @description "Read how the behaviors of every listed package and topic run."
      RECENTS_LOAD -> external {
      }
        @description "Read the remembered launches."
      RECENT_ADD -> external {
        behavior : string!
        label : string!
        kind : string!
        command : string!
        route : string!
      }
        @description "Remember a launch."
      PROGRAMS_LIST -> external {
      }
        @description "Ask for the programs the launchpad holds."
      PROGRAM_LAUNCH -> external {
        behavior : string!
        label : string!
        kind : string!
        verb : "serve" | "run"!
        ported : boolean!
        open : boolean!
        route : string!
        mock : boolean!
      }
        @description "Start a behavior as a background program."
      PROGRAM_STOP -> external {
        id : string!
      }
        @description "Stop a running program."
      PROGRAM_OPEN -> external {
        id : string!
      }
        @description "Open a running program in the browser."
      STATS_START -> external {
      }
        @description "Begin sampling the machine."
      ORB_STATS_ASK -> external {
      }
        @description "Read the orb's kernel counters (and its version, the first time)."
      ORB_STATE -> external {
        machine : OrbMachine!
        stars : [OrbStar]!
      }
        @description "The machine and the programs around it, for the orb view."
    }

    listens {
      KindsRows.KINDS_LEAVES -> KINDS_LEAVES
      KindsScopeLoader.KINDS_SCOPE_READY -> KINDS_SCOPE_READY
      KindsTopic.KINDS_FAILED -> KINDS_FAILED
      KindsRows.KINDS_FAILED -> KINDS_FAILED
      KindsIndex.KINDS_INDEXED -> INDEX_READY
      ProgramRunner.PROGRAMS_CHANGED -> PROGRAMS_CHANGED
      ProgramRunner.PROGRAM_STARTED -> PROGRAM_STARTED
      ProgramRunner.PROGRAM_ENDED -> PROGRAM_ENDED
      ProgramRunner.PROGRAM_FAILED -> PROGRAM_FAILED
      RecentsStore.RECENTS_LOADED -> RECENTS_LOADED
      RecentsStore.RECENTS_CHANGED -> RECENTS_CHANGED
      RecentsStore.RECENTS_FAILED -> RECENTS_FAILED
      SystemStatsMeter.STATS_READ -> STATS_READ
      SystemStatsMeter.STATS_FAILED -> STATS_FAILED
      OrbStatsReader.ORB_KERNEL_READ -> ORB_KERNEL_READ
      OrbStatsReader.ORB_VERSION_READ -> ORB_VERSION_READ
      OrbStatsReader.ORB_STATS_FAILED -> ORB_STATS_FAILED
      SystemOrb.ORB_RELAUNCH -> ORB_RELAUNCHED
      LaunchpadTopBar.INTEGRATIONS_CHANGED -> INTEGRATIONS_CHANGED
      STAGE_SHOWN { }
      ORB_PUSH { }
      KINDS_LEAVES {
        package : string!
        topic : string!
        totalCount : number!
        data : [LaunchpadLeaf]!
      }
      KINDS_SCOPE_READY { }
      KINDS_FAILED {
        package : string!
        topic : string!
        error : string!
      }
      INDEX_READY {
        topics : [LaunchpadTopicCount]!
        skipped : [LaunchpadSkipped]!
      }
      PROGRAMS_CHANGED {
        running : [LaunchpadRunning]!
      }
      PROGRAM_STARTED {
        id : string!
        pid : number!
        port : number!
      }
      PROGRAM_ENDED {
        id : string!
        code : number!
        signal : number!
      }
      PROGRAM_FAILED {
        behavior : string!
        code : string!
        error : string!
      }
      RECENTS_LOADED {
        items : [LaunchpadRecent]!
      }
      RECENTS_CHANGED {
        items : [LaunchpadRecent]!
      }
      RECENTS_FAILED {
        error : string!
      }
      INTEGRATIONS_CHANGED {
        mock : boolean!
        authProvider : string!
        problems : [string]!
        envChecked : boolean!
      }
      STATS_READ {
        memoryTotal : number!
        memoryUsed : number!
        memoryAvailable : number!
        memoryPercent : number!
        cpuPercent : number!
        load1 : number!
        load5 : number!
        load15 : number!
        uptimeSeconds : number!
        processes : [LaunchpadProcess]!
        missing : [number]!
        unavailable : [string]!
        at : number!
      }
      STATS_FAILED {
        stat : "memory" | "cpu" | "load" | "uptime" | "processes"!
        code : string!
        error : string!
      }
      ORB_KERNEL_READ {
        registeredSchemas : number!
        registeredTraits : number!
        activeInstances : number!
        cachedEntities : number!
        uptimeMs : number!
      }
      ORB_VERSION_READ {
        version : string!
      }
      ORB_STATS_FAILED {
        stat : "kernel" | "version"!
        code : string!
        error : string!
      }
      ORB_RELAUNCHED {
        id : string!
      }
      RUN_APP {
        behavior : string!
      }
      RECENT_PICK {
        behavior : string!
      }
      RUNNING_OPEN {
        id : string!
      }
      RUNNING_STOP {
        id : string!
      }
    }
  }

  page "/" as LaunchpadPage -> LaunchpadFrame, LaunchpadTopBar, LaunchpadStage, RecentsStore, BootGuard, BootCheck, SystemOrb, KindsTopic, KindsRows, KindsScopeLoader, KindsIndex, KindsClassifier, ProgramRunner, StatsWatch, SystemStatsMeter, ProcessReader, OrbStatsReader, OrbVersionRunner
}
