app std-launchpad [
  version: "5.0.0",
  theme: "linear-clean-light",
  locales: [en, ar, sl],
  themes: ["linear-clean-dark", "almadar-light", "almadar-dark", "minimalist-light", "minimalist-dark", "notion-editorial-light", "swiss-light", "bloomberg-dense-dark", "terminal-dark", "game-sci-fi-dark"],
  exec: ["orb", "ps", "aws", "bq", "gcloud", "gh", "ssh", "kill"],
  kernel: { "guest": [spawn] },
  env: ["PATH", "HOME", "FIREBASE_AUTH_EMULATOR_HOST", "ALMADAR_PERSONA_OWNS", "ALMADAR_VECTORS_DIR", "EMBEDDING_PROVIDER", "EMBEDDING_API_KEY", "OPENAI_API_KEY", "OPEN_ROUTER_API_KEY", "EMBEDDING_MODEL", "LMSTUDIO_EMBEDDING_MODEL"],
  sys: [memory, cpu, self-signal],
  fs: { "~/.almadar/launchpad": [create], "~/.almadar/launchpad/**": [read, write, create], "~/.orb/.update-check.json": [read], cwd: "node_modules/**": [read], "~/.almadar/sidecars/**": [read], "~/.almadar/vectors/**": [read, write, remove, create], env ALMADAR_VECTORS_DIR: "**": [read, write, remove, create] },
  description: "std-launchpad — the dashboard of orb's own operations that bare `orb` (orb launchpad) opens in the browser, always on production credentials. It composes its apps statically: the ops boards std-ci-status (with std-ci-run-logs reading the failing logs its rows open), std-aws-board, std-app-hosting-board, std-cloud-run-board, std-training-board and std-llm-spend-board, and the dev playground std-behavior-playground, each with every trait of its page, so each board's server traits run on the launchpad's own server under the launchpad's grants. The frame is std-app-layout in its drawer mode (the navigation behind a menu button): its header carries a State machine button and the theme picker (std-theme-picker over the app's themes list); the button opens a drawer with std-live-machine on the page-root trait of the app in front (each board's machineTrait, homeMachine on Home), described from the launchpad itself and moved live by a program/live trace of that trait (EXEC-DIST-14, streamed by whichever kernel runs it), and while it is open it follows the app brought to the front; closing it cancels the trace, and its drawer lists Home and every program of the boards knob under its section's heading, the one in front highlighted and each open app with its own Close button. Picking a program in the drawer opens it (or brings its view to the front) and shows the board's own view in the stage, with `@trait.X` embedding; picking a sidebar item switches the view and every open board keeps its state; closing an app removes its sidebar item (its trait keeps its state, as any trait does when its view is not shown). Every board is drawn by std-status-board and reads the first time its app is brought to the front (the stage sends APP_SHOWN, which each board view takes as BOARD_OPEN), so opening the launchpad itself reads nothing from GitHub, AWS or Google. No program is spawned and no port is taken. Home is centred at a readable width: the Orb view card beside two stat cards, (std-launchpad-orb: this machine as one orb with its CPU and memory, one star of the same size for each open app, coloured by its topic, the recent ones not open dimmed on an outer ring; a click on a star opens, closes or reopens its app) and the stat cards This machine (memory, CPU, load and uptime, std-system-stats) and Orb runtime (the orb's own version, uptime and kernel counters, std-orb-stats), each with its own note of what it could not read. Home opens with the update banner (std-launchpad-updates: the update record orb keeps in ~/.orb/.update-check.json, read when the launchpad opens and each time Home is shown; Update and Retry run `orb update`). The launchpad has no sign-in and composes no boot gate. Opening a CI row shows its jobs and the failing job's log inline. The app header grants exactly what the composed boards and the stats use, one line per key: exec is orb (the version), ps (the orb process's uptime, which std-orb-stats reads with its pid) and the CLIs the boards run (aws and ssh for the AWS and training boards, gcloud and bq for Cloud Run and App Hosting, gh for CI run logs); env is PATH and HOME for the CLIs; egress is the Google OAuth token endpoint the Google boards connect through (std-gcloud-token); net lists the GitHub, App Hosting, Cloud Monitoring, OpenRouter, DeepSeek, Moonshot, local kernel-server (127.0.0.1:3000) and OpenAI hosts the boards and the playground call, the LLM spend board's four taken from its own header. std-analytics-collector is deliberately not composed: it would add an unauthenticated `analytics` beacon endpoint to the launchpad's server. A path names an app by meaning: /<words> (local.almadar.io/ci, /launch, /cloud-run) mounts the same launchpad with std-vector-match, which matches the words against each board's label, synonyms and description and the homeTexts (the launchpad itself) through the vector store; a confident board opens as its tab, and the launchpad itself, no confident match or a failed match (named in a toast) leaves Home in front. The embedding grants (env, the vector store and package folders, the OpenAI and LM Studio hosts, kill) are std-vector-match's. Serve it with `orb launchpad`.",
  egress: ["https://oauth2.googleapis.com"],
  net: { "api.github.com:443": [tcp], "api.deepseek.com:443": [tcp], "api.moonshot.ai:443": [tcp], "127.0.0.1:3000": [tcp], "openrouter.ai:443": [tcp], "firebaseapphosting.googleapis.com:443": [tcp], "monitoring.googleapis.com:443": [tcp], "api.openai.com:443": [tcp], "127.0.0.1:1234": [tcp] },
]
uses NotFound from "std/behaviors/std-not-found"
;; @capabilities "open an orb operations board or the behavior playground and run it live, search the programs, switch between open apps from the rail, close an app, see the memory and cpu of this machine, see the orb's version and kernel counters, remember recent opens"

uses Shell from "std/behaviors/std-app-layout"
uses Picker from "std/behaviors/std-theme-picker"
uses Recents from "std/behaviors/std-launchpad-recents"
uses Orb from "std/behaviors/std-launchpad-orb"
uses Stats from "std/behaviors/std-system-stats"
uses OrbStats from "std/behaviors/std-orb-stats"
uses Updates from "std/behaviors/std-launchpad-updates"
uses Ci from "std/behaviors/std-ci-status"
uses Aws from "std/behaviors/std-aws-board"
uses Ah from "std/behaviors/std-app-hosting-board"
uses Cr from "std/behaviors/std-cloud-run-board"
uses Tr from "std/behaviors/std-training-board"
uses Llm from "std/behaviors/std-llm-spend-board"
uses Play from "std/behaviors/std-behavior-playground"
uses Match from "std/behaviors/std-vector-match"
uses Live from "std/behaviors/std-live-machine"

type LaunchpadSection = { topic : string!, title : string!, run : string! }
type LaunchpadBoard = { id : string!, label : string!, icon : string!, topic : string!, description : string!, synonyms : [string]!, machineTrait : string! }
type TraceMove = { trait : string!, from : string!, to : string!, event : string?, executed : boolean! }
type TraceDispatch = { seq : number!, outcomes : [TraceMove]! }
type LaunchpadMove = { trait : string!, event : string!, from : string!, to : string!, fired : boolean! }
type LaunchpadTab = { id : string!, label : string!, icon : string!, topic : string! }
type LaunchpadProcess = { pid : number!, rssKb : number! }
type LaunchpadRecent = { behavior : string!, label : string!, kind : string!, command : string!, route : string!, at : instant! }
type OrbMachine = { label : string!, detail : string! }
type OrbStar = { id : string!, label : string!, kind : string!, state : "starting" | "running" | "stopped"!, weight : number!, detail : string! }
type OrbClicked = { id : string!, label : string, group : string, size : number, color : string }

orbital Launchpad {
  entity LaunchpadView [runtime] {
    id : string!
    tabs : [LaunchpadTab] = []
    active : string @description "The id of the open app in front; empty is Home." = ""
    openTabs : [LaunchpadTab] = []
    recents : [LaunchpadRecent] = []
    orbUptimeMs : number = 0
    statsReady : boolean = false
    memoryTotal : number = 0
    memoryUsed : number = 0
    memoryPercent : number = 0
    cpuPercent : number = 0
    load1 : number = 0
    machineUptime : number = 0
    statsUnavailable : [string] = []
    statsErrors : Map string string = {}
    orbVersion : string = ""
    kernelReady : boolean = false
    orbUptimeReady : boolean = false
    registeredSchemas : number = 0
    registeredTraits : number = 0
    activeInstances : number = 0
    cachedEntities : number = 0
    machineTrait : string @description "The trait the State machine view draws and traces." = ""
  }

  entity LaunchpadMachineView [runtime] {
    id : string!
    active : string
    fired : number
    visited : [string] = []
  }

  config {
    boards : [LaunchpadBoard] = [{ id: "almadar-std/std-ci-status", machineTrait: "CiStatus", label: "CI status", icon: "activity", topic: "ops", description: "The CI of the active repositories as one board, failing first; open a row for its jobs and the failing log.", synonyms: ["ci", "continuous integration", "builds", "pipelines", "github actions", "workflows", "tests"] }, { id: "almadar-std/std-aws-board", machineTrait: "AwsStatus", label: "AWS", icon: "cloud", topic: "ops", description: "One AWS region at a glance: instances, volumes, buckets, quotas and cost, read through the aws CLI.", synonyms: ["aws", "amazon web services", "ec2", "s3", "instances", "buckets"] }, { id: "almadar-std/std-app-hosting-board", machineTrait: "AppHostingStatus", label: "App Hosting", icon: "rocket", topic: "ops", description: "A Firebase App Hosting project's backends, rollouts and logs, read through the App Hosting API and the gcloud CLI.", synonyms: ["app hosting", "firebase", "rollouts", "backends", "deploys"] }, { id: "almadar-std/std-cloud-run-board", machineTrait: "CloudRunStatus", label: "Cloud Run", icon: "server", topic: "ops", description: "A Google Cloud project's Cloud Run services and this month's cost, read through the gcloud and bq CLIs.", synonyms: ["cloud run", "gcp", "google cloud", "services", "containers"] }, { id: "almadar-std/std-training-board", machineTrait: "TrainingStatus", label: "Training", icon: "brain", topic: "ops", description: "The model-training instances of one AWS region, read through the aws and ssh CLIs.", synonyms: ["training", "model training", "gpu", "machine learning", "fine tuning"] }, { id: "almadar-std/std-llm-spend-board", machineTrait: "LlmSpend", label: "LLM spend", icon: "wallet", topic: "ops", description: "What LLM providers cost: the OpenRouter key's usage and limit, the DeepSeek and Moonshot balances, and the token spend a kernel server reports.", synonyms: ["llm spend", "llm cost", "openrouter", "tokens", "usage", "billing"] }, { id: "almadar-std/std-behavior-playground", machineTrait: "PlaygroundFrame", label: "Behavior playground", icon: "flask-conical", topic: "dev", description: "Browse every installed behavior by package and topic, run one live, explore its state machines and read its source.", synonyms: ["playground", "behaviors", "catalog", "behavior catalog", "try a behavior"] }]
      @label "Boards"
      @description "The composed apps the launchpad offers, in order: id (the behavior name), label, icon name, topic, a one-line description and machineTrait (the app's page-root trait, whose state machine the header's State machine view draws while it is in front). Each id must be one of the apps the launchpad composes; an id not composed has no view to show."
    sections : [LaunchpadSection] = [{ topic: "ops", title: "Ops", run: "Open" }, { topic: "dev", title: "Tools", run: "Open" }]
      @label "Sections"
      @description "The topics the menu groups its programs under, in order, with each group's heading."
    homeMachine : string = "LaunchpadHome"
      @label "Home machine"
      @description "The trait whose state machine the header's State machine view draws while Home is in front; each board names its own in machineTrait."
    title : string = "Launchpad"
      @label "Title"
    homeTexts : [string] = ["launchpad", "launch", "home", "dashboard", "start"]
      @label "Home words"
      @description "The words that name the launchpad itself in a path: matching one of them by meaning keeps Home in front."
    matchFloor : float = 0.82
      @label "Match floor"
      @description "Minimum cosine score a path's words must reach against an app's texts to open it."
      @tier "policy"
    matchMargin : float = 0.05
      @label "Match margin"
      @description "Minimum gap between the best app and the next one for a path to open it."
      @tier "policy"
  }

  trait LaunchpadFrame = Shell.traits.AppLayout -> LaunchpadView {
    config {
      appName: @config.title
      navItems: []
      contentTrait: @trait.LaunchpadStage
      sidebarTrait: @trait.LaunchpadRail
      headerTrait: @trait.LaunchpadHeader
      layoutMode: drawer
      fullBleed: true
      contentClassName: "w-full h-full"
      showSearch: false
      showNotifications: false
      notifications: []
      showThemeToggle: false
    }
  }
  trait LaunchpadTheme = Picker.traits.ThemePicker {
    config {
      pickerContent: { type: stack, direction: vertical, gap: xs, children: [
        { type: select, aria-label: "Theme", className: "w-44", options: (array/concat [{ value: "", label: @config.defaultLabel }] @config.themes), value: @entity.current, action: THEME_PICKED },
        { type: typography, variant: caption, color: error, className: (if (== @entity.problem "") hidden ""), content: @entity.problem }
      ] }
      themes: [{ value: "linear-clean-light", label: "Linear light" }, { value: "linear-clean-dark", label: "Linear dark" }, { value: "almadar-light", label: "Almadar light" }, { value: "almadar-dark", label: "Almadar dark" }, { value: "minimalist-light", label: "Minimalist light" }, { value: "minimalist-dark", label: "Minimalist dark" }, { value: "notion-editorial-light", label: "Editorial" }, { value: "swiss-light", label: "Swiss" }, { value: "bloomberg-dense-dark", label: "Terminal dense" }, { value: "terminal-dark", label: "Terminal" }, { value: "game-sci-fi-dark", label: "Sci-fi" }]
    }
  }
  trait LaunchpadHeader -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
      homeTrait : string = @config.homeMachine
        @label "Home machine"
        @tier "domain"
    }
    initial: closed

    state closed {
      INIT -> closed
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      TABS_CHANGED -> closed
        (set @entity.active ?active)
      MACHINE_TOGGLE -> open
        (set @entity.machineTrait (default (array/nth (array/concat (array/map (array/filter @config.boardList (fn b (= @b.id @entity.active))) (fn b @b.machineTrait)) [@config.homeTrait]) 0) @config.homeTrait))
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: primary, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme,
          { type: drawer, isOpen: true, title: (str/concat "State machine · " @entity.machineTrait), position: right, width: "min(1100px, 92vw)", closeEvent: CLOSE, children: [@trait.LaunchpadLive] }
        ] })
        (emit MACHINE_SUBJECT { behavior: "almadar-std/std-launchpad", trait: @entity.machineTrait })
        (program/live { kind: "trace", traits: [@entity.machineTrait] } { key: (str/concat "machine-" @entity.machineTrait), emit: { onMessage: MACHINE_TRACE, failure: MACHINE_TRACE_FAILED } })
    }

    state open {
      INIT -> closed
        (cancel-call (str/concat "machine-" @entity.machineTrait))
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      MACHINE_TOGGLE -> closed
        (cancel-call (str/concat "machine-" @entity.machineTrait))
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      CLOSE -> closed
        (cancel-call (str/concat "machine-" @entity.machineTrait))
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: ghost, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme
        ] })
      TABS_CHANGED -> open when (= (default (array/nth (array/concat (array/map (array/filter @config.boardList (fn b (= @b.id ?active))) (fn b @b.machineTrait)) [@config.homeTrait]) 0) @config.homeTrait) @entity.machineTrait)
        (set @entity.active ?active)
      TABS_CHANGED -> open when (!= (default (array/nth (array/concat (array/map (array/filter @config.boardList (fn b (= @b.id ?active))) (fn b @b.machineTrait)) [@config.homeTrait]) 0) @config.homeTrait) @entity.machineTrait)
        (cancel-call (str/concat "machine-" @entity.machineTrait))
        (set @entity.active ?active)
        (set @entity.machineTrait (default (array/nth (array/concat (array/map (array/filter @config.boardList (fn b (= @b.id ?active))) (fn b @b.machineTrait)) [@config.homeTrait]) 0) @config.homeTrait))
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: primary, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme,
          { type: drawer, isOpen: true, title: (str/concat "State machine · " @entity.machineTrait), position: right, width: "min(1100px, 92vw)", closeEvent: CLOSE, children: [@trait.LaunchpadLive] }
        ] })
        (emit MACHINE_SUBJECT { behavior: "almadar-std/std-launchpad", trait: @entity.machineTrait })
        (program/live { kind: "trace", traits: [@entity.machineTrait] } { key: (str/concat "machine-" @entity.machineTrait), emit: { onMessage: MACHINE_TRACE, failure: MACHINE_TRACE_FAILED } })
      MACHINE_TRACE -> open when (and (= ?type "trace") (= ?key (str/concat "machine-" @entity.machineTrait)))
        (emit MACHINE_MOVES { moves: (array/map (default ?dispatch.outcomes []) (fn o { trait: @o.trait, event: (default @o.event ""), from: @o.from, to: @o.to, fired: @o.executed })) })
      MACHINE_TRACE -> open when (not (and (= ?type "trace") (= ?key (str/concat "machine-" @entity.machineTrait))))
      MACHINE_TRACE_FAILED -> open
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, children: [
          { type: button, label: "State machine", icon: workflow, variant: primary, size: sm, action: MACHINE_TOGGLE },
          @trait.LaunchpadTheme,
          { type: drawer, isOpen: true, title: (str/concat "State machine · " @entity.machineTrait), position: right, width: "min(1100px, 92vw)", closeEvent: CLOSE, children: [{ type: alert, variant: error, message: (str/concat "The live trace could not open: " ?error) }, @trait.LaunchpadLive] }
        ] })
    }

    emits {
      MACHINE_SUBJECT -> external {
        behavior : string!
        trait : string!
      }
        @description "The trait the State machine view now draws: the main trait of the app in front."
      MACHINE_MOVES -> external {
        moves : [LaunchpadMove]!
      }
        @description "The transitions one dispatch took, for the State machine view to follow."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      MACHINE_TOGGLE { }
        @description "The header's State machine button: open the view of the app in front, or close it."
      CLOSE { }
        @description "The drawer was closed."
      MACHINE_TRACE {
        type : string!
        dispatch : TraceDispatch
        key : string!
      }
        @description "One dispatch of the traced trait, from the kernel's trace stream (EXEC-DIST-14)."
        @tier "internal"
      MACHINE_TRACE_FAILED {
        error : string!
        key : string!
      }
        @tier "internal"
    }
  }

  trait LaunchpadLive = Live.traits.LiveMachine -> LaunchpadMachineView {
    listens {
      LaunchpadHeader.MACHINE_SUBJECT -> SUBJECT
      LaunchpadHeader.MACHINE_MOVES -> MOVES
    }
  }
  trait CiStatus = Ci.traits.CiStatus {
    config {
      repos: [{ owner: "almadar-io", name: "almadar-std" }, { owner: "almadar-io", name: "behaviors" }, { owner: "almadar-io", name: "lolo-ar" }, { owner: "almadar-io", name: "lolo-sl" }, { owner: "almadar-io", name: "orbital-rust" }, { owner: "almadar-io", name: "orbital-core" }, { owner: "almadar-io", name: "orbital-canvas" }, { owner: "almadar-io", name: "orbital-ffi" }, { owner: "almadar-io", name: "orbital-wasm" }, { owner: "almadar-io", name: "orbital-shell-typescript" }, { owner: "almadar-io", name: "orbital-shell-python" }, { owner: "almadar-io", name: "orbital-shell-rust" }, { owner: "almadar-io", name: "orbital-shell-ios" }, { owner: "almadar-io", name: "orbital-shell-android" }, { owner: "almadar-io", name: "orb" }, { owner: "almadar-io", name: "almadar" }]
    }
  }
  trait CiBoard = Ci.traits.CiBoard {
    listens {
      CiStatus.CI_BOARD_LOADING -> BOARD_LOADING
      CiStatus.CI_BOARD_SHOW -> BOARD_SHOW
      CiStatus.CI_BOARD_FAILED -> BOARD_FAILED
      CiDetail.CI_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-ci-status")
    }
  }
  trait CiDetail = Ci.traits.CiDetail {}
  trait CiGithub = Ci.traits.CiGithub {}
  trait CiGhHttp = Ci.traits.CiGhHttp {}
  trait CiGhTimeout = Ci.traits.CiGhTimeout {}
  trait CiRetry = Ci.traits.CiRetry {}
  trait AwsStatus = Aws.traits.AwsStatus {}
  trait AwsCli = Aws.traits.AwsCli {}
  trait AwsView = Aws.traits.AwsView {
    listens {
      AwsStatus.AWS_BOARD_LOADING -> BOARD_LOADING
      AwsStatus.AWS_BOARD_SHOW -> BOARD_SHOW
      AwsStatus.AWS_BOARD_FAILED -> BOARD_FAILED
      AwsStatus.AWS_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-aws-board")
    }
  }
  trait CiRunLogs = Ci.traits.CiRunLogs {}
  trait CiLogsGh = Ci.traits.CiLogsGh {}
  trait AppHostingStatus = Ah.traits.AppHostingStatus {
    config {
      project: "kflow-b3a39"
      region: "europe-west4"
      backends: ["almadar-analytics", "almadar-builder-server", "almadar-kflow-server", "kflow-server", "almadar-inspection-server", "almadar-iram-server", "almadar-kekec-server", "almadar-trait-wars-server", "almadar-alummaalraqamia-server", "almadar-blaz-klemenc-server"]
    }
  }
  trait AhApi = Ah.traits.AhApi {
    listens {
      AppHostingStatus.AH_HTTP_SEND -> HTTP_SEND
      CatEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL when (array/includes ["rollouts", "build"] @payload.key)
    }
  }
  trait AhToken = Ah.traits.AhToken {}
  trait AhGcloud = Ah.traits.AhGcloud {}
  trait AhView = Ah.traits.AhView {
    listens {
      AppHostingStatus.AH_BOARD_LOADING -> BOARD_LOADING
      AppHostingStatus.AH_BOARD_SHOW -> BOARD_SHOW
      AppHostingStatus.AH_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-app-hosting-board")
    }
  }
  trait CloudRunStatus = Cr.traits.CloudRunStatus {
    config {
      project: "kflow-b3a39"
    }
  }
  trait CrMonitoring = Cr.traits.CrMonitoring {
    listens {
      CloudRunStatus.CR_HTTP_SEND -> HTTP_SEND
      CatEmbedRequest.HTTP_CANCEL -> HTTP_CANCEL when (array/includes ["time", "requests"] @payload.key)
    }
  }
  trait CrToken = Cr.traits.CrToken {}
  trait CrGcloud = Cr.traits.CrGcloud {}
  trait CrBq = Cr.traits.CrBq {}
  trait CloudRunView = Cr.traits.CloudRunView {
    listens {
      CloudRunStatus.CR_BOARD_LOADING -> BOARD_LOADING
      CloudRunStatus.CR_BOARD_SHOW -> BOARD_SHOW
      CloudRunStatus.CR_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-cloud-run-board")
    }
  }
  trait TrainingStatus = Tr.traits.TrainingStatus {}
  trait TrAws = Tr.traits.TrAws {}
  trait TrSsh = Tr.traits.TrSsh {}
  trait TrainingView = Tr.traits.TrainingView {
    listens {
      TrainingStatus.TR_BOARD_LOADING -> BOARD_LOADING
      TrainingStatus.TR_BOARD_SHOW -> BOARD_SHOW
      TrainingStatus.TR_BOARD_FAILED -> BOARD_FAILED
      TrainingStatus.TR_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-training-board")
    }
  }
  trait LlmSpend = Llm.traits.LlmSpend {}
  trait LsOrHttp = Llm.traits.LsOrHttp {}
  trait LsDsHttp = Llm.traits.LsDsHttp {}
  trait LsKmHttp = Llm.traits.LsKmHttp {}
  trait LsTraceHttp = Llm.traits.LsTraceHttp {}
  trait LsTimeout = Llm.traits.LsTimeout {}
  trait LlmSpendView = Llm.traits.LlmSpendView {
    listens {
      LlmSpend.LS_BOARD_LOADING -> BOARD_LOADING
      LlmSpend.LS_BOARD_SHOW -> BOARD_SHOW
      LlmSpend.LS_BOARD_DETAIL -> BOARD_DETAIL
      LOAD_CLICKED { }
      REFRESH_CLICKED { }
      ROW_TOGGLED {
        itemId : string!
        isOpen : boolean!
      }
      SEARCHED {
        searchTerm : string!
      }
      SECTION_PICKED {
        key : string!
      }
      LaunchpadStage.APP_SHOWN -> BOARD_OPEN when (= ?id "almadar-std/std-llm-spend-board")
    }
  }
  trait PlaygroundFrame = Play.traits.PlaygroundFrame {}
  trait PlaygroundTopBar = Play.traits.PlaygroundTopBar {
    config {
      heading: "Behavior playground"
    }
  }
  trait PlaygroundTopics = Play.traits.PlaygroundTopics {}
  trait PlaygroundStage = Play.traits.PlaygroundStage {}
  trait PlaygroundLoader = Play.traits.PlaygroundLoader {}
  trait PlaygroundOpen = Play.traits.PlaygroundOpen {}
  trait GuestSession = Play.traits.GuestSession {}
  trait GuestStage = Play.traits.GuestStage {}
  trait BehaviorCatalogData = Play.traits.BehaviorCatalogData {
    config {
      loadOnInit: false
    }
    listens {
      BehaviorCatalogLlm.LLM_EMBED_RESULT -> EMBEDDED
      BehaviorCatalogLlm.LLM_FAILED -> SEARCH_FAILED
      PlaygroundTopics.TOPIC_PICKED -> TOPIC
      LaunchpadStage.PLAYGROUND_OPENED -> CATALOG_LOAD
      EMBEDDED {
        embeddings : [[number]]!
      }
      SEARCH_FAILED {
        code : string
        message : string!
      }
      TOPIC {
        package : string!
        topic : string!
      }
      CATALOG_LOAD
    }
  }
  trait BehaviorCatalogLlm = Play.traits.BehaviorCatalogLlm {}
  trait CatEmbedWait = Play.traits.CatEmbedWait {}
  trait CatEmbedRequest = Play.traits.CatEmbedRequest {}
  trait CatEmbedHttp = Play.traits.CatEmbedHttp {}
  trait PlaygroundMachine = Play.traits.PlaygroundMachine {}
  trait PlaygroundLive = Play.traits.PlaygroundLive {}
  trait PlaygroundStatus = Play.traits.PlaygroundStatus {}
  trait PlaygroundRoute = Play.traits.PlaygroundRoute {}

  trait RecentsStore = Recents.traits.RecentsStore {
    listens {
      LaunchpadHome.RECENTS_LOAD -> RECENTS_LOAD
      LaunchpadHome.RECENT_ADD -> RECENT_ADD
    }
  }

  trait SystemStatsMeter = Stats.traits.SystemStatsMeter {
    listens {
      LaunchpadHome.STATS_START -> STATS_START
    }
  }

  trait OrbStatsReader = OrbStats.traits.OrbStatsReader {
    listens {
      LaunchpadHome.ORB_STATS_ASK -> ORB_STATS_ASK
      SystemStatsMeter.STATS_READ -> ORB_STATS_ASK
      OrbVersionRunner.CLI_DONE -> ORB_VERSION_DONE
      OrbVersionRunner.CLI_FAILED -> ORB_VERSION_FAILED
      OrbUptimeRunner.CLI_DONE -> ORB_UPTIME_DONE
      OrbUptimeRunner.CLI_FAILED -> ORB_UPTIME_FAILED
    }
  }
  trait OrbVersionRunner = OrbStats.traits.OrbVersionRunner {}

  trait OrbUptimeRunner = OrbStats.traits.OrbUptimeRunner {}

  trait UpdatesStore = Updates.traits.UpdatesStore {}

  trait UpdateRecord = Updates.traits.UpdateRecord {}
  trait UpdatesCli = Updates.traits.UpdatesCli {}
  trait UpdatesBanner = Updates.traits.UpdatesBanner {
    listens {
      UpdatesStore.UPDATES_LOADED -> UPDATES_LOADED
      UpdatesStore.UPDATES_UNCHECKED -> UPDATES_UNCHECKED
      UpdatesStore.UPDATES_FAILED -> UPDATES_FAILED
      UpdatesStore.UPDATES_RAN -> UPDATES_RAN
      UpdatesStore.UPDATES_RUN_FAILED -> UPDATES_RUN_FAILED
      LaunchpadStage.TABS_CHANGED -> UPDATES_REFRESH when (= ?active "")
    }
  }

  trait SystemOrb = Orb.traits.SystemOrb {
    config {
      hint: "Each star is an open app, coloured by its topic; all stars are the same size because nothing in-process measures an app honestly. Click one to open, close or reopen its tab."
      colors: { ops: "var(--color-success)", dev: "var(--color-info)" }
      graphHeight: 280
      openOnClick: true
    }
    listens {
      LaunchpadHome.ORB_STATE -> ORB_STATE
      NODE_CLICK {
        node : OrbClicked!
      }
      STAR_OPEN {
        id : string!
      }
      STAR_STOP {
        id : string!
      }
      STAR_RELAUNCH {
        id : string!
      }
    }
  }

  trait LaunchpadRail -> LaunchpadView [client] {
    config {
      menuBoards : [LaunchpadBoard] = @config.boards
        @label "Programs"
        @tier "domain"
      menuSections : [LaunchpadSection] = @config.sections
        @label "Groups"
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (emit RAIL_SHOWN {})
      RAIL_SHOWN -> idle
        (render-ui main { type: stack, direction: vertical, gap: md, children: (array/concat
          [{ type: button, label: "Home", icon: home, variant: (if (= @entity.active "") primary ghost), size: sm, action: RAIL_PICKED, actionPayload: { id: "home" } }]
          (array/map (array/filter @config.menuSections (fn sec (array/some @config.menuBoards (fn a (= @a.topic @sec.topic))))) (fn sec { type: stack, direction: vertical, gap: xs, children: (array/concat
            [{ type: typography, content: @sec.title, variant: overline, color: muted }]
            (array/map (array/filter @config.menuBoards (fn a (= @a.topic @sec.topic))) (fn a { type: stack, direction: horizontal, align: center, justify: between, gap: xs, children: (array/concat
              [{ type: button, label: @a.label, icon: @a.icon, variant: (if (= @a.id @entity.active) primary ghost), size: sm, action: RAIL_PICKED, actionPayload: { id: @a.id } }]
              (if (array/some @entity.openTabs (fn t (= @t.id @a.id))) [{ type: icon-button, icon: x, label: (str/concat "Close " @a.label), variant: ghost, size: sm, action: RAIL_CLOSE, actionPayload: { id: @a.id } }] [])) }))) }))) })
      TABS_CHANGED -> idle
        (set @entity.openTabs ?tabs)
        (set @entity.active ?active)
        (emit RAIL_SHOWN {})
      RAIL_PICKED -> idle when (= ?id "home")
        (emit RAIL_HOME {})
      RAIL_PICKED -> idle when (!= ?id "home")
        (emit RAIL_OPEN { behavior: ?id })
      RAIL_CLOSE -> idle
        (emit RAIL_CLOSE_ASKED { id: ?id })
    }

    emits {
      RAIL_SHOWN
      RAIL_HOME -> external {
      }
        @description "The Home item of the rail was picked."
      RAIL_OPEN -> external {
        behavior : string!
      }
        @description "A program in the menu was picked: it opens, or comes to the front when it is open."
      RAIL_CLOSE_ASKED -> external {
        id : string!
      }
        @description "An open app's Close button in the sidebar was pressed."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RAIL_SHOWN { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RAIL_PICKED {
        id : string!
      }
      RAIL_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadStage -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit TABS_SHOWN {})
      TABS_SHOWN -> ready
        (render-ui main { type: box, fullHeight: true, overflow: hidden, children: [
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "") "" "hidden"), children: [@trait.LaunchpadHome] },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-ci-status") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-ci-status"))) [@trait.CiBoard] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-aws-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-aws-board"))) [@trait.AwsView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-app-hosting-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-app-hosting-board"))) [@trait.AhView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-cloud-run-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-cloud-run-board"))) [@trait.CloudRunView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-training-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-training-board"))) [@trait.TrainingView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-llm-spend-board") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-llm-spend-board"))) [@trait.LlmSpendView] []) },
          { type: box, fullHeight: true, overflow: auto, padding: lg, className: (if (= @entity.active "almadar-std/std-behavior-playground") "" "hidden"), children: (if (array/some @entity.tabs (fn t (= @t.id "almadar-std/std-behavior-playground"))) [@trait.PlaygroundFrame] []) }
        ] })
      TAB_OPEN -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?behavior))) (= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.active ?behavior)
        (emit PLAYGROUND_OPENED {})
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?behavior))) (!= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.active ?behavior)
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (and (not (array/some @entity.tabs (fn t (= @t.id ?behavior)))) (= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.tabs (array/append @entity.tabs { id: ?behavior, label: ?label, icon: ?icon, topic: ?topic }))
        (set @entity.active ?behavior)
        (emit PLAYGROUND_OPENED {})
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_OPEN -> ready when (and (not (array/some @entity.tabs (fn t (= @t.id ?behavior)))) (!= ?behavior "almadar-std/std-behavior-playground"))
        (set @entity.tabs (array/append @entity.tabs { id: ?behavior, label: ?label, icon: ?icon, topic: ?topic }))
        (set @entity.active ?behavior)
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?behavior })
      TAB_HOME -> ready
        (set @entity.active "")
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_SELECT -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?id))) (= ?id "almadar-std/std-behavior-playground"))
        (set @entity.active ?id)
        (emit PLAYGROUND_OPENED {})
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?id })
      TAB_SELECT -> ready when (and (array/some @entity.tabs (fn t (= @t.id ?id))) (!= ?id "almadar-std/std-behavior-playground"))
        (set @entity.active ?id)
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
        (emit APP_SHOWN { id: ?id })
      TAB_CLOSE -> ready when (= ?id "almadar-std/std-behavior-playground")
        (set @entity.tabs (array/filter @entity.tabs (fn t (!= @t.id ?id))))
        (set @entity.active (if (= @entity.active ?id) "" @entity.active))
        (navigate "/")
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TAB_CLOSE -> ready when (!= ?id "almadar-std/std-behavior-playground")
        (set @entity.tabs (array/filter @entity.tabs (fn t (!= @t.id ?id))))
        (set @entity.active (if (= @entity.active ?id) "" @entity.active))
        (emit TABS_PUSH {})
        (emit TABS_SHOWN {})
      TABS_PUSH -> ready
        (emit TABS_CHANGED { tabs: @entity.tabs, active: @entity.active })
    }

    emits {
      TABS_SHOWN
      TABS_PUSH { }
        @description "Internal: hand Home the tabs as they stand."
        @tier "internal"
      PLAYGROUND_OPENED -> external {
      }
        @description "The playground tab was opened: its catalog starts listing the installed behaviors."
      TABS_CHANGED -> external {
        tabs : [LaunchpadTab]!
        active : string!
      }
        @description "The open tabs and the one in front (empty is Home)."
      APP_SHOWN -> external {
        id : string!
      }
        @description "An app was brought to the front: its board reads once, the first time."
    }

    listens {
      LaunchpadHome.TAB_OPEN -> TAB_OPEN
      LaunchpadHome.HOME_CLOSE -> TAB_CLOSE
      LaunchpadRail.RAIL_HOME -> TAB_HOME
      LaunchpadRail.RAIL_CLOSE_ASKED -> TAB_CLOSE
      TABS_SHOWN { }
      TABS_PUSH { }
      PLAYGROUND_OPENED { }
      TAB_OPEN {
        behavior : string!
        label : string!
        icon : string!
        topic : string!
      }
      TAB_HOME { }
      TAB_SELECT {
        id : string!
      }
      TAB_CLOSE {
        id : string!
      }
    }
  }

  trait LaunchpadHome -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit RECENTS_LOAD {})
        (emit STATS_START {})
        (emit ORB_STATS_ASK {})
        (emit HOME_SHOWN {})
      HOME_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: lg, className: "mx-auto w-full max-w-6xl", children: [
            @trait.UpdatesBanner,
            { type: simple-grid, minChildWidth: 420, gap: lg, children: [
                { type: card, variant: bordered, padding: lg, children: [@trait.SystemOrb] },
                { type: stack, direction: vertical, gap: lg, children: [
                  { type: card, variant: bordered, padding: lg, title: "This machine", children: [
                    { type: stack, direction: vertical, gap: md, children: [
                      { type: simple-grid, minChildWidth: 140, gap: md, children: [
                      { type: stat-display, label: "CPU", value: (if @entity.statsReady (str/concat (math/round @entity.cpuPercent 0) "%") ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Memory", value: (if @entity.statsReady (str/concat (math/round @entity.memoryPercent 0) "%") ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Memory used", value: (if @entity.statsReady (format/bytes @entity.memoryUsed) ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Load (1 min)", value: (if @entity.statsReady (str/concat (math/round @entity.load1 2)) ""), isLoading: (not @entity.statsReady), size: sm },
                      { type: stat-display, label: "Uptime", value: (if @entity.statsReady (time/duration (* 1000 @entity.machineUptime)) ""), isLoading: (not @entity.statsReady), size: sm }
                      ] },
                      (if (= (array/len @entity.statsUnavailable) 0) null { type: typography, content: (str/concat "Not available: " (str/join (array/map @entity.statsUnavailable (fn u (str/concat @u " (" (object/get @entity.statsErrors @u "") ")"))) "; ")), variant: caption, color: muted })
                    ] }
                  ] },
                  { type: card, variant: bordered, padding: lg, title: "Orb runtime", children: [
                    { type: stack, direction: vertical, gap: md, children: [
                      { type: simple-grid, minChildWidth: 160, gap: md, children: [
                      { type: stat-display, label: "Version", value: @entity.orbVersion, isLoading: (= @entity.orbVersion ""), size: sm },
                      { type: stat-display, label: "Running for", value: (if @entity.orbUptimeReady (time/duration @entity.orbUptimeMs) ""), isLoading: (not @entity.orbUptimeReady), size: sm },
                      { type: stat-display, label: "Kernel traits", value: (if @entity.kernelReady (str/concat @entity.registeredTraits) ""), isLoading: (not @entity.kernelReady), size: sm },
                      { type: stat-display, label: "Kernel instances", value: (if @entity.kernelReady (str/concat @entity.activeInstances) ""), isLoading: (not @entity.kernelReady), size: sm }
                      ] },
                      (if (= (array/count ["version", "kernel", "process-uptime"] (fn k (object/has @entity.statsErrors @k))) 0) null { type: typography, content: (str/concat "Not read: " (str/join (array/map (array/filter ["version", "kernel", "process-uptime"] (fn k (object/has @entity.statsErrors @k))) (fn k (str/concat @k " (" (object/get @entity.statsErrors @k "") ")"))) "; ")), variant: caption, color: muted })
                    ] }
                  ] }
                ] }
            ] }
        ] })
      TABS_CHANGED -> ready
        (set @entity.openTabs ?tabs)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_LOADED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_CHANGED -> ready
        (set @entity.recents (array/filter ?items (fn r (array/some @config.boardList (fn a (= @a.id @r.behavior))))))
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      RECENTS_FAILED -> ready
        (render-ui toast { type: alert, variant: error, message: (str/concat "Recent opens: " ?error) })
      STATS_READ -> ready
        (set @entity.statsReady true)
        (set @entity.memoryTotal ?memoryTotal)
        (set @entity.memoryUsed ?memoryUsed)
        (set @entity.memoryPercent ?memoryPercent)
        (set @entity.cpuPercent ?cpuPercent)
        (set @entity.load1 ?load1)
        (set @entity.machineUptime ?uptimeSeconds)
        (set @entity.statsUnavailable ?unavailable)
        (emit ORB_PUSH {})
        (emit HOME_SHOWN {})
      STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
      ORB_KERNEL_READ -> ready
        (set @entity.kernelReady true)
        (set @entity.registeredSchemas ?registeredSchemas)
        (set @entity.registeredTraits ?registeredTraits)
        (set @entity.activeInstances ?activeInstances)
        (set @entity.cachedEntities ?cachedEntities)
      ORB_UPTIME_READ -> ready
        (set @entity.orbUptimeReady true)
        (set @entity.orbUptimeMs ?uptimeMs)
      ORB_VERSION_READ -> ready
        (set @entity.orbVersion ?version)
        (emit HOME_SHOWN {})
      ORB_STATS_FAILED -> ready
        (set @entity.statsErrors (object/set @entity.statsErrors ?stat (str/concat ?code ": " ?error)))
        (emit HOME_SHOWN {})
      ORB_PUSH -> ready
        (emit ORB_STATE { machine: { label: (if @entity.statsReady (str/concat "CPU " (math/round @entity.cpuPercent 0) "% · RAM " (math/round @entity.memoryPercent 0) "%") "This machine"), detail: (let ((used (format/bytes @entity.memoryUsed)) (total (format/bytes @entity.memoryTotal))) (if (and @entity.statsReady (!= @used null) (!= @total null)) (str/concat @used " of " @total " in use · load " (math/round @entity.load1 2)) "Reading the machine")) }, stars: (array/concat (array/map @entity.openTabs (fn t { id: @t.id, label: @t.label, kind: @t.topic, state: "running", weight: 0, detail: (str/concat @t.topic " · open") })) (array/map (array/filter @entity.recents (fn c (not (array/some @entity.openTabs (fn t (= @t.id @c.behavior)))))) (fn c { id: @c.behavior, label: @c.label, kind: "recent", state: "stopped", weight: 0, detail: (str/concat "not open · last opened " (time/relative @c.at)) }))) })
      APP_OPEN -> ready when (array/some @config.boardList (fn a (= @a.id ?behavior)))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit TAB_OPEN { behavior: ?behavior, label: @a.label, icon: @a.icon, topic: @a.topic }))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?behavior))))) (emit RECENT_ADD { behavior: ?behavior, label: @a.label, kind: "route", command: "", route: "" }))
      ORB_OPENED -> ready when (array/some @config.boardList (fn a (= @a.id ?id)))
        (let ((a (array/find @config.boardList (fn x (= @x.id ?id))))) (emit TAB_OPEN { behavior: ?id, label: @a.label, icon: @a.icon, topic: @a.topic }))
      ORB_OPENED -> ready when (not (array/some @config.boardList (fn a (= @a.id ?id))))
      ORB_STOPPED -> ready
        (emit HOME_CLOSE { id: ?id })
      ORB_RELAUNCHED -> ready
        (emit APP_OPEN { behavior: ?id })
    }

    emits {
      HOME_SHOWN
      ORB_PUSH { }
        @description "Internal: hand the orb view the machine and the open tabs as they stand."
        @tier "internal"
      APP_OPEN {
        behavior : string!
      }
        @description "Internal: open a listed app as a tab, or bring its tab to the front."
        @tier "internal"
      RECENTS_LOAD -> external {
      }
        @description "Read the remembered opens."
      RECENT_ADD -> external {
        behavior : string!
        label : string!
        kind : string!
        command : string!
        route : string!
      }
        @description "Remember an open."
      TAB_OPEN -> external {
        behavior : string!
        label : string!
        icon : string!
        topic : string!
      }
        @description "Open an app and put it in the rail."
      HOME_CLOSE -> external {
        id : string!
      }
        @description "Close a tab, which unmounts the app."
      STATS_START -> external {
      }
        @description "Begin sampling the machine."
      ORB_STATS_ASK -> external {
      }
        @description "Read the orb's kernel counters (and its version, the first time)."
      ORB_STATE -> external {
        machine : OrbMachine!
        stars : [OrbStar]!
      }
        @description "The machine and the open tabs around it, for the orb view."
    }

    listens {
      LaunchpadStage.TABS_CHANGED -> TABS_CHANGED
      RecentsStore.RECENTS_LOADED -> RECENTS_LOADED
      RecentsStore.RECENTS_CHANGED -> RECENTS_CHANGED
      RecentsStore.RECENTS_FAILED -> RECENTS_FAILED
      SystemStatsMeter.STATS_READ -> STATS_READ
      SystemStatsMeter.STATS_FAILED -> STATS_FAILED
      OrbStatsReader.ORB_KERNEL_READ -> ORB_KERNEL_READ
      OrbStatsReader.ORB_UPTIME_READ -> ORB_UPTIME_READ
      OrbStatsReader.ORB_VERSION_READ -> ORB_VERSION_READ
      OrbStatsReader.ORB_STATS_FAILED -> ORB_STATS_FAILED
      SystemOrb.ORB_OPEN -> ORB_OPENED
      SystemOrb.ORB_STOP -> ORB_STOPPED
      SystemOrb.ORB_RELAUNCH -> ORB_RELAUNCHED
      LaunchpadRail.RAIL_OPEN -> APP_OPEN
      FindMatch.MATCH_FOUND -> APP_OPEN when (!= ?id "home")
        with { behavior: ?id }
      LaunchpadBehaviorRoute.BEHAVIOR_LINKED -> APP_OPEN
        with { behavior: "almadar-std/std-behavior-playground" }
      HOME_SHOWN { }
      ORB_PUSH { }
      TABS_CHANGED {
        tabs : [LaunchpadTab]!
        active : string!
      }
      RECENTS_LOADED {
        items : [LaunchpadRecent]!
      }
      RECENTS_CHANGED {
        items : [LaunchpadRecent]!
      }
      RECENTS_FAILED {
        error : string!
      }
      STATS_READ {
        memoryTotal : number!
        memoryUsed : number!
        memoryAvailable : number!
        memoryPercent : number!
        cpuPercent : number!
        load1 : number!
        load5 : number!
        load15 : number!
        uptimeSeconds : number!
        processes : [LaunchpadProcess]!
        missing : [number]!
        unavailable : [string]!
        at : number!
      }
      STATS_FAILED {
        stat : "memory" | "cpu" | "load" | "uptime" | "processes"!
        code : string!
        error : string!
      }
      ORB_KERNEL_READ {
        registeredSchemas : number!
        registeredTraits : number!
        activeInstances : number!
        cachedEntities : number!
      }
      ORB_UPTIME_READ {
        uptimeMs : number!
      }
      ORB_VERSION_READ {
        version : string!
      }
      ORB_STATS_FAILED {
        stat : "kernel" | "version" | "process-uptime"!
        code : string!
        error : string!
      }
      ORB_OPENED {
        id : string!
      }
      ORB_STOPPED {
        id : string!
      }
      ORB_RELAUNCHED {
        id : string!
      }
      APP_OPEN {
        behavior : string!
      }
    }
  }


  trait LaunchpadBehaviorRoute -> LaunchpadView [client] {
    initial: ready

    state ready {
      INIT -> ready
        (emit BEHAVIOR_LINKED {})
    }

    emits {
      BEHAVIOR_LINKED -> external {
      }
        @description "A link to /<package>/<behavior> was opened: the playground tab opens, and its route trait opens the behavior once the catalog is listed."
    }

    listens {
      INIT {
        package : string!
        name : string!
      }
    }
  }

  trait LaunchpadFind -> LaunchpadView [client] {
    config {
      boardList : [LaunchpadBoard] = @config.boards
        @label "Boards"
        @tier "domain"
      home : [string] = @config.homeTexts
        @label "Home words"
        @tier "domain"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit MATCH { query: (str/replaceAll (default (str/decode-uri-component (default ?query "")) "") "-" " "), candidates: (array/append (array/map @config.boardList (fn a { id: @a.id, texts: (array/concat [@a.label, @a.description] @a.synonyms) })) { id: "home", texts: @config.home }) })
      FIND_FAILED -> ready
        (notify error (str/concat "Could not match \"" ?query "\" to an app (" ?code "): " ?detail))
    }

    emits {
      MATCH -> external {
        query : string!
        candidates : [{ id : string!, texts : [string]! }]!
      }
        @description "Match the path's words against the apps and the launchpad itself."
    }

    listens {
      INIT {
        query : string
      }
      FindMatch.MATCH_FAILED -> FIND_FAILED
      FIND_FAILED {
        query : string!
        code : string!
        detail : string!
      }
    }
  }

  trait FindMatch = Match.traits.VectorMatch [server] {
    listens {
      LaunchpadFind.MATCH -> MATCH
      FindSources.SOURCES_READY -> SOURCES_READY
      FindSources.SOURCES_REFUSED -> SOURCES_REFUSED
      VectorResolve.VECTORS_ANSWERED -> VECTORS_ANSWERED
      VectorResolve.VECTORS_REFUSED -> VECTORS_REFUSED
      MatchGate.SIMILARITY_MATCHED -> SIMILARITY_MATCHED
      MatchGate.SIMILARITY_ABSTAINED -> SIMILARITY_ABSTAINED
    }
  }
  trait MatchGate = Match.traits.MatchGate {
    config {
      floor: @config.matchFloor
      margin: @config.matchMargin
    }
    listens {
      FindMatch.VM_COMPARE -> COMPARE_VECTORS
    }
  }
  trait FindSources = Match.traits.MatchSources {
    listens {
      FindMatch.VM_SOURCES -> SOURCES
      VectorResolve.USER_STORE_NEEDED -> USER_STORE_NEEDED
    }
  }
  trait VectorResolve = Match.traits.VectorResolve {
    listens {
      FindMatch.VM_RESOLVE -> RESOLVE
      FindSources.USER_STORE_READ -> USER_STORE_READ
      ResolveStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      ResolveStore.VECTOR_REFUSED -> VECTOR_REFUSED
      ResolveLlmOrShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrShared.LLM_FAILED -> LLM_FAILED
      ResolveLlmOrOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrOwn.LLM_FAILED -> LLM_FAILED
      ResolveLlmOaShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOaShared.LLM_FAILED -> LLM_FAILED
      ResolveLlmOaOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOaOwn.LLM_FAILED -> LLM_FAILED
      ResolveLlmLm.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmLm.LLM_FAILED -> LLM_FAILED
      ResolveWrite.VECTOR_WRITTEN -> VECTOR_WRITTEN
      ResolveWrite.VECTOR_WRITE_REFUSED -> VECTOR_WRITE_REFUSED
    }
  }
  trait ResolveStore = Match.traits.ResolveStore {}
  trait ResolveWrite = Match.traits.ResolveWrite {}
  trait ResolveQuantize = Match.traits.ResolveQuantize {}
  trait ResolveF32 = Match.traits.ResolveF32 {}
  trait ResolveSig6 = Match.traits.ResolveSig6 {}
  trait ResolveBigCmp = Match.traits.ResolveBigCmp {}
  trait ResolveDelay = Match.traits.ResolveDelay {}
  trait ResolveLlmOrShared = Match.traits.ResolveLlmOrShared {}
  trait ResolveLlmOrOwn = Match.traits.ResolveLlmOrOwn {}
  trait ResolveLlmOaShared = Match.traits.ResolveLlmOaShared {}
  trait ResolveLlmOaOwn = Match.traits.ResolveLlmOaOwn {}
  trait ResolveLlmLm = Match.traits.ResolveLlmLm {}
  trait ResolveOrSharedWait = Match.traits.ResolveOrSharedWait {}
  trait ResolveOrSharedRequest = Match.traits.ResolveOrSharedRequest {}
  trait ResolveOrSharedHttp = Match.traits.ResolveOrSharedHttp {}
  trait ResolveOrOwnWait = Match.traits.ResolveOrOwnWait {}
  trait ResolveOrOwnRequest = Match.traits.ResolveOrOwnRequest {}
  trait ResolveOrOwnHttp = Match.traits.ResolveOrOwnHttp {}
  trait ResolveOaSharedWait = Match.traits.ResolveOaSharedWait {}
  trait ResolveOaSharedRequest = Match.traits.ResolveOaSharedRequest {}
  trait ResolveOaSharedHttp = Match.traits.ResolveOaSharedHttp {}
  trait ResolveOaOwnWait = Match.traits.ResolveOaOwnWait {}
  trait ResolveOaOwnRequest = Match.traits.ResolveOaOwnRequest {}
  trait ResolveOaOwnHttp = Match.traits.ResolveOaOwnHttp {}
  trait ResolveLmWait = Match.traits.ResolveLmWait {}
  trait ResolveLmRequest = Match.traits.ResolveLmRequest {}
  trait ResolveLmHttp = Match.traits.ResolveLmHttp {}

  page "/" as LaunchpadPage -> LaunchpadFrame, LaunchpadTheme, LaunchpadHeader, LaunchpadLive, LaunchpadRail, LaunchpadStage, LaunchpadHome, RecentsStore, SystemOrb, SystemStatsMeter, OrbStatsReader, OrbVersionRunner, OrbUptimeRunner, UpdatesStore, UpdateRecord, UpdatesCli, UpdatesBanner, CiStatus, CiBoard, CiDetail, CiGithub, CiGhHttp, CiGhTimeout, CiRetry, AwsStatus, AwsCli, AwsView, CiRunLogs, CiLogsGh, AppHostingStatus, AhToken, AhGcloud, AhView, CloudRunStatus, CrToken, CrGcloud, CrBq, CloudRunView, TrainingStatus, TrAws, TrSsh, TrainingView, LlmSpend, LlmSpendView, LsOrHttp, LsDsHttp, LsKmHttp, LsTraceHttp, LsTimeout, PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, PlaygroundOpen, GuestSession, BehaviorCatalogData, BehaviorCatalogLlm, CatEmbedWait, CatEmbedRequest, CatEmbedHttp, PlaygroundMachine, PlaygroundLive, PlaygroundStatus, AhApi, CrMonitoring
  page "/:query" as LaunchpadFindPage -> LaunchpadFrame, LaunchpadTheme, LaunchpadHeader, LaunchpadLive, LaunchpadRail, LaunchpadStage, LaunchpadHome, RecentsStore, SystemOrb, SystemStatsMeter, OrbStatsReader, OrbVersionRunner, OrbUptimeRunner, UpdatesStore, UpdateRecord, UpdatesCli, UpdatesBanner, CiStatus, CiBoard, CiDetail, CiGithub, CiGhHttp, CiGhTimeout, CiRetry, AwsStatus, AwsCli, AwsView, CiRunLogs, CiLogsGh, AppHostingStatus, AhToken, AhGcloud, AhView, CloudRunStatus, CrToken, CrGcloud, CrBq, CloudRunView, TrainingStatus, TrAws, TrSsh, TrainingView, LlmSpend, LlmSpendView, LsOrHttp, LsDsHttp, LsKmHttp, LsTraceHttp, LsTimeout, PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, PlaygroundOpen, GuestSession, BehaviorCatalogData, BehaviorCatalogLlm, CatEmbedWait, CatEmbedRequest, CatEmbedHttp, PlaygroundMachine, PlaygroundLive, PlaygroundStatus, AhApi, CrMonitoring, LaunchpadFind, FindMatch, MatchGate, FindSources, VectorResolve, ResolveStore, ResolveWrite, ResolveQuantize, ResolveF32, ResolveSig6, ResolveBigCmp, ResolveDelay, ResolveLlmOrShared, ResolveLlmOrOwn, ResolveLlmOaShared, ResolveLlmOaOwn, ResolveLlmLm, ResolveOrSharedWait, ResolveOrSharedRequest, ResolveOrSharedHttp, ResolveOrOwnWait, ResolveOrOwnRequest, ResolveOrOwnHttp, ResolveOaSharedWait, ResolveOaSharedRequest, ResolveOaSharedHttp, ResolveOaOwnWait, ResolveOaOwnRequest, ResolveOaOwnHttp, ResolveLmWait, ResolveLmRequest, ResolveLmHttp
  page "/:package/:name" as LaunchpadBehaviorPage -> LaunchpadFrame, LaunchpadTheme, LaunchpadHeader, LaunchpadLive, LaunchpadRail, LaunchpadStage, LaunchpadHome, RecentsStore, SystemOrb, SystemStatsMeter, OrbStatsReader, OrbVersionRunner, OrbUptimeRunner, UpdatesStore, UpdateRecord, UpdatesCli, UpdatesBanner, CiStatus, CiBoard, CiDetail, CiGithub, CiGhHttp, CiGhTimeout, CiRetry, AwsStatus, AwsCli, AwsView, CiRunLogs, CiLogsGh, AppHostingStatus, AhToken, AhGcloud, AhView, CloudRunStatus, CrToken, CrGcloud, CrBq, CloudRunView, TrainingStatus, TrAws, TrSsh, TrainingView, LlmSpend, LlmSpendView, LsOrHttp, LsDsHttp, LsKmHttp, LsTraceHttp, LsTimeout, PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, PlaygroundOpen, GuestSession, BehaviorCatalogData, BehaviorCatalogLlm, CatEmbedWait, CatEmbedRequest, CatEmbedHttp, PlaygroundMachine, PlaygroundLive, PlaygroundStatus, AhApi, CrMonitoring, PlaygroundRoute, LaunchpadBehaviorRoute
