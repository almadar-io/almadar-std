app std-behavior-playground [
  version: "1.0.0",
  theme: "linear-clean-light",
  locales: [en, ar, sl],
  description: "std-behavior-playground — browse every installed behavior by package and topic, open one and play with it: it runs live in place (the behavior value embedded, as a page would mount it), its .lolo source file reads in a code view, and the right dock draws the state machine of the guest's current page with std-live-machine (the page-root trait's source beside its machine, moved by the transitions the running guest takes; it follows the guest as it navigates). The guest's entities, [runtime] ones included, are filled with sampled rows before it mounts. The tree lists each package's topics and, as a topic opens, its behaviors from std-behavior-catalog's data trait, prefetched whole in one listing (scope, starting topic and labels are knobs); a click on a behavior opens it and moves the URL to /<package>/<behavior> (a link to that route opens the playground with it loaded), and the stage shows a prompt until one is open; the frame is std-workspace-layout with the live machine dock on the right. It runs as a tab of std-launchpad.",
  net: { "openrouter.ai:443": [tcp] },
]
uses NotFound from "std/behaviors/std-not-found"
;; @capabilities "browse installed behaviors by topic, run a behavior live, explore a behavior's state machines, read a behavior's source"

uses Layout from "std/behaviors/std-workspace-layout"
uses Catalog from "std/behaviors/std-behavior-catalog"
uses Live from "std/behaviors/std-live-machine"
uses Loader from "std/behaviors/std-behavior-loader"
uses Guest from "std/behaviors/std-guest-session"

type PlaygroundProgram = { name : string, orbitals : [orbital] }
type PlaygroundTopic = { package : string!, topic : string!, count : number! }
type PlaygroundPackageLabel = { package : string!, label : string! }
type PlaygroundLeaf = { package : string!, topic : string!, behavior : string!, kind : string!, value : behavior! }
type PlaygroundPaint = { slot : string!, trait : string!, embedded : boolean!, content : node! }
type PlaygroundLeafIcon = { kind : string!, icon : string! }
type PlaygroundKnob = { name : string!, type : string!, label : string, description : string }

orbital BehaviorPlayground {
  entity PlaygroundView [runtime] {
    id : string!
    topics : [PlaygroundTopic] = []
    leaves : [PlaygroundLeaf] = []
    leafSelected : string = ""
    expanded : [string] @description "The topics opened in the tree, by `<package> <topic>`." = []
    routePending : boolean @description "On a route page, the tree waits for the route's behavior instead of opening the start topic." = false
    routeBehavior : string @description "The behavior the route names; empty when the page has none or it was opened." = ""
    topicPackage : string = ""
    topic : string = ""
    behavior : string = ""
    description : string = ""
    value : behavior?
    machineBehavior : string @description "The behavior whose page-root trait the dock draws." = ""
    machineTrait : string @description "The guest's page-root trait the dock draws." = ""
    error : string = ""
    status : "browsing" | "opening" | "open" | "failed" = browsing
  }

  config {
    scope : [string] = ["almadar-std", "almadar-behaviors"]
      @label "Where to look"
      @description "Registry folders the playground lists (`<prefix>[/<topic>[/<tier>]]`); every installed behavior by default."
    startPackage : string = (quote "@almadar/std")
      @label "Starting package"
      @description "The package of the topic the playground opens on."
    startTopic : string = "ui/core"
      @label "Starting topic"
      @description "The topic the playground opens on."
    packageLabels : [PlaygroundPackageLabel] = [{ package: (quote "@almadar/std"), label: "Standard library" }, { package: (quote "@almadar-io/behaviors"), label: "Behaviors" }]
      @label "Package names"
      @description "How each package is named in the topic tree; a package not listed shows its npm name."
    title : string = "Behavior playground"
      @label "Title"
  }

  trait PlaygroundFrame = Layout.traits.WorkspaceLayout -> PlaygroundView {
    config {
      mainTrait: @trait.PlaygroundStage
      showSidebar: true
      sidebarTrait: @trait.PlaygroundTopics
      sidebarWidth: 18
      sidebarMinSize: 220
      showSecondarySidebar: true
      secondarySidebarTrait: @trait.PlaygroundMachine
      secondarySidebarLabel: "State machine"
      secondarySidebarWidth: 55
      secondarySidebarMinSize: 360
      showBottomPanel: false
      showStatusBar: true
      statusBarTrait: @trait.PlaygroundStatus
      showTopBar: true
      topBarTrait: @trait.PlaygroundTopBar
    }
    listens {
      PlaygroundTopics.LEAF_PICKED -> SIDEBAR_DOCK
      PlaygroundRoute.ROUTE_OPEN -> SIDEBAR_DOCK
      SIDEBAR_TOGGLED {
        collapsed : boolean!
      }
      SIDEBAR_DOCK { }
      SIDEBAR_RESIZED {
        width : number!
      }
      SECONDARY_RESIZED {
        width : number!
      }
      SECONDARY_TOGGLED {
        collapsed : boolean!
      }
    }
  }

  trait BehaviorCatalogData = Catalog.traits.BehaviorCatalogData {
    config {
      scope: @config.scope
      startPackage: @config.startPackage
      startTopic: @config.startTopic
      prefetch: true
    }
    listens {
      BehaviorCatalogLlm.LLM_EMBED_RESULT -> EMBEDDED
      BehaviorCatalogLlm.LLM_FAILED -> SEARCH_FAILED
      PlaygroundTopics.TOPIC_PICKED -> TOPIC
      EMBEDDED {
        embeddings : [[number]]!
      }
      SEARCH_FAILED {
        code : string
        message : string!
      }
      TOPIC {
        package : string!
        topic : string!
      }
    }
  }
  trait BehaviorCatalogLlm = Catalog.traits.BehaviorCatalogLlm {}
  trait CatEmbedWait = Catalog.traits.CatEmbedWait {}
  trait CatEmbedRequest = Catalog.traits.CatEmbedRequest {}
  trait CatEmbedHttp = Catalog.traits.CatEmbedHttp {}

  trait PlaygroundLive = Live.traits.LiveMachine {
    listens {
      PlaygroundMachine.SUBJECT -> SUBJECT
      GuestSession.GUEST_MOVED -> MOVES
    }
  }

  trait PlaygroundMachine -> PlaygroundView [client] {
    config {
      slot : string = "main"
        @label "Guest slot"
        @description "The slot whose page-root paint names the trait the dock draws."
    }

    initial: idle

    state idle {
      INIT -> idle
        (render-ui main { type: stack, direction: vertical, gap: sm, className: "h-full p-2", children: [@trait.PlaygroundLive] })
      BEHAVIOR_LOADED -> idle
        (set @entity.machineBehavior ?behavior)
        (set @entity.machineTrait "")
      GUEST_PAINTS -> idle when (let ((root (default (object/get (default (array/find ?paints (fn p (and (= @p.slot @config.slot) (= @p.embedded false)))) { trait: "" }) trait) ""))) (and (!= @entity.machineBehavior "") (!= @root "") (!= @root @entity.machineTrait)))
        (set @entity.machineTrait (default (object/get (default (array/find ?paints (fn p (and (= @p.slot @config.slot) (= @p.embedded false)))) { trait: "" }) trait) ""))
        (emit SUBJECT { behavior: @entity.machineBehavior, trait: @entity.machineTrait })
      GUEST_PAINTS -> idle when (let ((root (default (object/get (default (array/find ?paints (fn p (and (= @p.slot @config.slot) (= @p.embedded false)))) { trait: "" }) trait) ""))) (or (= @entity.machineBehavior "") (= @root "") (= @root @entity.machineTrait)))
    }

    emits {
      SUBJECT -> external {
        behavior : string!
        trait : string!
      }
        @description "The trait, by behavior and trait name, whose machine the dock draws."
    }

    listens {
      PlaygroundLoader.BEHAVIOR_LOADED -> BEHAVIOR_LOADED
      GuestSession.GUEST_PAINTS -> GUEST_PAINTS
      BEHAVIOR_LOADED {
        behavior : string!
      }
      GUEST_PAINTS {
        guest : string!
        paints : [PlaygroundPaint]!
      }
        @description "The guest's paints; the non-embedded one of the configured slot names the page-root trait the dock draws, and a later paint set (the guest navigated) redraws."
    }
  }
  trait PlaygroundTopics -> PlaygroundView [client] {
    config {
      openPackage : string = @config.startPackage
        @label "Starting package"
        @tier "domain"
      openTopic : string = @config.startTopic
        @label "Starting topic"
        @tier "domain"
      labels : [PlaygroundPackageLabel] = @config.packageLabels
        @label "Package names"
        @tier "presentation"
      leaves : boolean = true
        @label "Behaviors in the tree"
        @description "List each topic's behaviors under it, as TREE_LOADED names them; a click on one answers LEAF_PICKED."
        @tier "presentation"
      leafIcons : [PlaygroundLeafIcon] = []
        @label "Behavior icons"
        @description "The icon of a behavior in the tree by its kind; a kind not listed shows a file."
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.routePending (validate/required ?name))
        (render-ui main { type: stack, direction: vertical, gap: sm, className: "p-3", children: [{ type: skeleton, variant: list, rows: 8 }] })
      TOPICS_LOADED -> idle when @entity.routePending
        (set @entity.topics ?topics)
        (emit TOPICS_SHOWN {})
      TOPICS_LOADED -> idle when (not @entity.routePending)
        (set @entity.expanded (array/unique (array/append @entity.expanded (str/concat (if (= @entity.topic "") @config.openPackage @entity.topicPackage) " " (if (= @entity.topic "") @config.openTopic @entity.topic)))))
        (set @entity.topics ?topics)
        (set @entity.topicPackage (if (= @entity.topic "") @config.openPackage @entity.topicPackage))
        (set @entity.topic (if (= @entity.topic "") @config.openTopic @entity.topic))
        (emit TOPICS_SHOWN {})
      TOPICS_SHOWN -> idle
        (render-ui main { type: stack, direction: vertical, gap: xs, className: "h-full overflow-y-auto p-2", children: [
          { type: typography, content: "Topics", variant: overline, color: muted, className: "px-2 pt-1" },
          { type: file-tree, selectedId: (if (= @entity.leafSelected "") (str/concat @entity.topicPackage " " @entity.topic) @entity.leafSelected), expandedPaths: (array/concat (array/concat (array/unique (array/map @entity.topics (fn t @t.package))) (array/unique (array/flatten (array/map @entity.expanded (fn e (let ((pkg (default (array/first (str/split @e " ")) "")) (segs (str/split (default (array/last (str/split @e " ")) "") "/"))) (array/map (array/range (array/len @segs)) (fn i (str/concat @pkg " " (str/join (array/slice @segs 0 (+ @i 1)) "/")))))))))) (array/unique (array/map (array/filter @entity.leaves (fn l (array/includes @entity.expanded (str/concat @l.package " " @l.topic)))) (fn l (str/concat @l.package " " @l.topic "/" @l.kind "s"))))), onNodeSelect: NODE_SELECTED, items: (array/concat (array/concat (array/concat
            (array/concat
              (array/map (array/filter @config.labels (fn l (array/some @entity.topics (fn t (= @t.package @l.package))))) (fn l { id: @l.package, label: @l.label, icon: package }))
              (array/map (array/filter (array/unique (array/map @entity.topics (fn t @t.package))) (fn pkg (not (array/some @config.labels (fn l (= @l.package @pkg)))))) (fn pkg { id: @pkg, label: @pkg, icon: package })))
            (array/map (array/unique (array/flatten (array/map (array/sort @entity.topics "topic" "asc") (fn t (let ((segs (str/split @t.topic "/"))) (array/map (array/range (array/len @segs)) (fn i (str/concat @t.package " " (str/join (array/slice @segs 0 (+ @i 1)) "/"))))))))) (fn key (let ((pkg (default (array/first (str/split @key " ")) "")) (segs (str/split (default (array/last (str/split @key " ")) "") "/")) (topic (array/find @entity.topics (fn t (= (str/concat @t.package " " @t.topic) @key))))) { id: @key, label: (if (= @topic null) (default (array/last @segs) "") (str/concat (default (array/last @segs) "") "  ·  " (object/get @topic "count" 0))), parentId: (if (= (array/len @segs) 1) @pkg (str/concat @pkg " " (str/join (array/slice @segs 0 (- (array/len @segs) 1)) "/"))), icon: folder }))))
            (if @config.leaves (array/map (array/unique (array/map (array/sort @entity.leaves "topic" "asc") (fn l (str/concat @l.package " " @l.topic "/" @l.kind "s")))) (fn key { id: @key, label: (default (array/last (str/split @key "/")) ""), parentId: (str/join (array/slice (str/split @key "/") 0 (- (array/len (str/split @key "/")) 1)) "/"), icon: folder })) []))
            (if @config.leaves (array/map (array/sort @entity.leaves "behavior" "asc") (fn l { id: @l.behavior, label: (array/last (str/split @l.behavior "/")), parentId: (str/concat @l.package " " @l.topic "/" @l.kind "s"), icon: (let ((ic (array/find @config.leafIcons (fn i (= @i.kind @l.kind))))) (if (= @ic null) "file" (object/get @ic "icon" "file"))) })) [])) }
        ] })
      NODE_SELECTED -> idle when (array/some @entity.topics (fn t (= (str/concat @t.package " " @t.topic) ?id)))
        (let ((picked (array/find @entity.topics (fn t (= (str/concat @t.package " " @t.topic) ?id)))))
          (do
            (set @entity.topicPackage @picked.package)
            (set @entity.topic @picked.topic)
            (set @entity.leafSelected "")
            (set @entity.expanded (array/unique (array/append @entity.expanded ?id)))
            (emit TOPIC_PICKED { package: @picked.package, topic: @picked.topic, count: @picked.count })
            (emit TOPICS_SHOWN {})))
      NODE_SELECTED -> idle when (and (not (array/some @entity.topics (fn t (= (str/concat @t.package " " @t.topic) ?id)))) (array/some @entity.leaves (fn l (= @l.behavior ?id))))
        (set @entity.leafSelected ?id)
        (let ((leaf (array/find @entity.leaves (fn l (= @l.behavior ?id))))) (when (!= @leaf null) (emit LEAF_PICKED { behavior: ?id, value: (object/get @leaf "value") })))
        (navigate (str/concat "/" ?id))
        (emit TOPICS_SHOWN {})
      NODE_SELECTED -> idle when (and (not (array/some @entity.topics (fn t (= (str/concat @t.package " " @t.topic) ?id)))) (not (array/some @entity.leaves (fn l (= @l.behavior ?id)))))
      TREE_LOADED -> idle
        (set @entity.leaves ?data)
        (emit TOPICS_SHOWN {})
      ROUTE_OPENED -> idle
        (set @entity.routePending false)
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (set @entity.leafSelected ?behavior)
        (set @entity.expanded (array/unique (array/append @entity.expanded (str/concat ?package " " ?topic))))
        (emit TOPICS_SHOWN {})
    }

    emits {
      TOPIC_PICKED -> external {
        package : string!
        topic : string!
        count : number!
      }
        @description "A topic was chosen in the tree."
      LEAF_PICKED -> external {
        behavior : string!
        value : behavior!
      }
        @description "A behavior was chosen in the tree."
      TOPICS_SHOWN
    }

    listens {
      BehaviorCatalogData.CATALOG_TOPICS -> TOPICS_LOADED
      BehaviorCatalogData.CATALOG_TREE -> TREE_LOADED
      PlaygroundRoute.ROUTE_OPEN -> ROUTE_OPENED
      INIT {
        name : string
      }
        @description "The page's mount; on a behavior route it carries the route's name."
      TOPICS_LOADED {
        topics : [PlaygroundTopic]!
      }
      NODE_SELECTED {
        id : string!
      }
      TREE_LOADED {
        data : [PlaygroundLeaf]!
      }
        @description "Every behavior of the catalog, listed under its topic when the leaves knob is on; a tree heard again replaces the last."
      ROUTE_OPENED {
        behavior : string!
        package : string!
        topic : string!
        value : behavior!
      }
        @description "The route named a behavior: its topic opens in the tree and it shows selected."
    }
  }

  trait PlaygroundRoute -> PlaygroundView [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.routeBehavior (str/concat ?package "/" ?name))
      TREE_LOADED -> idle when (and (!= @entity.routeBehavior "") (array/some ?data (fn l (= @l.behavior @entity.routeBehavior))))
        (let ((leaf (array/find ?data (fn l (= @l.behavior @entity.routeBehavior)))))
          (do
            (set @entity.routeBehavior "")
            (emit ROUTE_OPEN { behavior: @leaf.behavior, package: @leaf.package, topic: @leaf.topic, value: @leaf.value })))
      TREE_LOADED -> idle when (and (!= @entity.routeBehavior "") (not (array/some ?data (fn l (= @l.behavior @entity.routeBehavior)))))
        (notify error (str/concat @entity.routeBehavior " is not an installed behavior."))
        (set @entity.routeBehavior "")
      TREE_LOADED -> idle when (= @entity.routeBehavior "")
    }

    emits {
      ROUTE_OPEN -> external {
        behavior : string!
        package : string!
        topic : string!
        value : behavior!
      }
        @description "The route's behavior is in the catalog: open it."
    }

    listens {
      BehaviorCatalogData.CATALOG_TREE -> TREE_LOADED
      INIT {
        package : string!
        name : string!
      }
      TREE_LOADED {
        data : [PlaygroundLeaf]!
      }
    }
  }

  trait PlaygroundStage -> PlaygroundView [client] {
    config {
      openPackage : string = @config.startPackage
        @label "Starting package"
        @tier "domain"
      openTopic : string = @config.startTopic
        @label "Starting topic"
        @tier "domain"
      labels : [PlaygroundPackageLabel] = @config.packageLabels
        @label "Package names"
        @tier "presentation"
    }
    initial: browsing

    state browsing {
      INIT -> browsing
      STAGE_SHOWN -> browsing
        (render-ui main { type: stack, direction: vertical, gap: md, className: "h-full overflow-y-auto p-6", children: [
          { type: stack, direction: vertical, gap: xs, children: [
            { type: typography, content: (let ((hit (array/find @config.labels (fn l (= @l.package @entity.topicPackage))))) (if (= @hit null) @entity.topicPackage (object/get @hit "label"))), variant: overline, color: muted },
            { type: typography, content: @entity.topic, variant: h2, weight: bold },
          ] },
          { type: empty-state, icon: mouse-pointer-click, title: "Pick a behavior in the tree", description: "Open a topic in the tree on the left and click a behavior: it runs live here, with its state machines and source a tab away." }
        ] })
        (emit STATUS { behavior: "", topic: @entity.topic })
      TOPIC_PICKED -> browsing
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (emit STAGE_SHOWN {})
      OPEN -> opening
        (emit GUEST_RESET {})
        (set @entity.behavior ?behavior)
        (set @entity.topicPackage (default ?package @entity.topicPackage))
        (set @entity.topic (default ?topic @entity.topic))
        (set @entity.description (default ?description ""))
        (set @entity.value ?value)
        (set @entity.status opening)
        (render-ui main { type: container, size: full, padding: md, children: [{ type: skeleton, variant: detail, rows: 4 }] })
        (emit LOAD_BEHAVIOR { behavior: ?behavior, value: ?value })
    }

    state opening {
      INIT -> browsing
        (emit STAGE_SHOWN {})
      OPEN -> opening
        (emit GUEST_RESET {})
        (set @entity.behavior ?behavior)
        (set @entity.topicPackage (default ?package @entity.topicPackage))
        (set @entity.topic (default ?topic @entity.topic))
        (set @entity.description (default ?description ""))
        (set @entity.value ?value)
        (set @entity.status opening)
        (render-ui main { type: container, size: full, padding: md, children: [{ type: skeleton, variant: detail, rows: 4 }] })
        (emit LOAD_BEHAVIOR { behavior: ?behavior, value: ?value })
      BEHAVIOR_LOADED -> open when (= ?behavior @entity.behavior)
        (set @entity.status open)
        (emit STAGE_SHOWN {})
      BEHAVIOR_LOADED -> opening when (!= ?behavior @entity.behavior)
      BEHAVIOR_FAILED -> failed when (= ?behavior @entity.behavior)
        (set @entity.error ?error)
        (set @entity.status failed)
        (render-ui main { type: container, size: md, padding: lg, children: [{ type: stack, direction: vertical, gap: md, children: [
          { type: alert, variant: error, title: (str/concat @entity.behavior " could not be opened"), message: @entity.error }
        ] }] })
      BEHAVIOR_FAILED -> opening when (!= ?behavior @entity.behavior)
      TOPIC_PICKED -> browsing
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (emit STAGE_SHOWN {})
    }

    state open {
      INIT -> browsing
        (emit STAGE_SHOWN {})
      STAGE_SHOWN -> open
        (when (validate/required @entity.value)
        (render-ui main { type: box, className: "h-full min-h-0 overflow-auto", children: [@trait.GuestStage] }))
        (emit STATUS { behavior: @entity.behavior, topic: @entity.topic })
      TOPIC_PICKED -> browsing
        (emit GUEST_RESET {})
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (set @entity.behavior "")
        (set @entity.value null)
        (set @entity.status browsing)
        (emit STAGE_SHOWN {})
      OPEN -> opening
        (emit GUEST_RESET {})
        (set @entity.behavior ?behavior)
        (set @entity.topicPackage (default ?package @entity.topicPackage))
        (set @entity.topic (default ?topic @entity.topic))
        (set @entity.description (default ?description ""))
        (set @entity.value ?value)
        (set @entity.status opening)
        (render-ui main { type: container, size: full, padding: md, children: [{ type: skeleton, variant: detail, rows: 4 }] })
        (emit LOAD_BEHAVIOR { behavior: ?behavior, value: ?value })
    }

    state failed {
      INIT -> browsing
        (emit STAGE_SHOWN {})
      OPEN -> opening
        (emit GUEST_RESET {})
        (set @entity.behavior ?behavior)
        (set @entity.topicPackage (default ?package @entity.topicPackage))
        (set @entity.topic (default ?topic @entity.topic))
        (set @entity.description (default ?description ""))
        (set @entity.value ?value)
        (set @entity.status opening)
        (render-ui main { type: container, size: full, padding: md, children: [{ type: skeleton, variant: detail, rows: 4 }] })
        (emit LOAD_BEHAVIOR { behavior: ?behavior, value: ?value })
      TOPIC_PICKED -> browsing
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (set @entity.status browsing)
        (emit STAGE_SHOWN {})
    }

    emits {
      STAGE_SHOWN
        @description "Internal: decide from the opened program's render-ui effects whether it draws in the page, only in overlay slots, or nowhere."
        @tier "internal"
      LOAD_BEHAVIOR -> external {
        behavior : string!
        value : behavior
      }
        @description "Ask the loader for the opened behavior's source, resolved program, knobs and validation."
      STATUS -> external {
        behavior : string!
        topic : string!
      }
        @description "What the status strip shows."
      GUEST_RESET -> external { }
        @description "The opened behavior is replaced or closed: the guest session ends."
    }

    listens {
      PlaygroundTopics.TOPIC_PICKED -> TOPIC_PICKED
      PlaygroundTopics.LEAF_PICKED -> OPEN
      PlaygroundRoute.ROUTE_OPEN -> OPEN
      PlaygroundLoader.BEHAVIOR_LOADED -> BEHAVIOR_LOADED
      PlaygroundLoader.BEHAVIOR_FAILED -> BEHAVIOR_FAILED
      OPEN {
        behavior : string!
        description : string
        trait : trait
        value : behavior
        package : string
        topic : string
      }
      TOPIC_PICKED {
        package : string!
        topic : string!
        count : number!
      }
      BEHAVIOR_LOADED {
        behavior : string!
        program : PlaygroundProgram!
        knobs : [PlaygroundKnob]!
      }
      BEHAVIOR_FAILED {
        behavior : string!
        error : string!
      }
    }
  }

  trait PlaygroundLoader = Loader.traits.BehaviorLoader {
    listens {
      PlaygroundStage.LOAD_BEHAVIOR -> LOAD_BEHAVIOR
    }
  }

  trait PlaygroundOpen -> PlaygroundView {
    initial: idle

    state idle {
      INIT -> idle
      BEHAVIOR_LOADED -> idle
        (emit GUEST_OPEN { program: ?program })
    }

    emits {
      GUEST_OPEN -> external {
        program : PlaygroundProgram!
      }
        @description "The opened behavior's resolved program, for the guest session to run."
    }

    listens {
      PlaygroundLoader.BEHAVIOR_LOADED -> BEHAVIOR_LOADED
      BEHAVIOR_LOADED {
        behavior : string!
        program : PlaygroundProgram!
      }
    }
  }

  trait GuestSession = Guest.traits.GuestSession {
    listens {
      PlaygroundOpen.GUEST_OPEN -> GUEST_OPEN
      PlaygroundStage.GUEST_RESET -> GUEST_RESET
      GuestStage.GUEST_SEND -> GUEST_SEND
      GuestStage.GUEST_NAVIGATE -> GUEST_NAVIGATE
      MockSeed.DATASET_PLANNED -> DATASET_PLANNED
      MockSeed.DATASET_FAILED -> DATASET_FAILED
    }
  }

  trait MockSeed = Guest.traits.MockSeed {
    config {
      seedOrbital: "BehaviorPlayground"
    }
  }

  trait MockStream = Guest.traits.MockStream {}

  trait GuestStage = Guest.traits.GuestStage {
    config {
      className: "h-full"
      errorTitle: "The behavior could not be run"
      pending: detail
      pendingRows: 4
    }
  }

  trait PlaygroundStatus -> PlaygroundView [client] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main { type: typography, content: "Loading the catalog", variant: caption, color: muted, className: "px-3" })
      TOPICS_COUNTED -> idle
        (set @entity.topics ?topics)
      STATUS -> idle
        (render-ui main { type: stack, direction: horizontal, gap: md, align: center, className: "px-3", children: [
          { type: typography, content: (str/concat (array/sum (array/map @entity.topics (fn t @t.count))) " behaviors · " (array/len @entity.topics) " topics"), variant: caption, color: muted },
          { type: typography, content: (if (= ?behavior "") ?topic (str/concat ?topic " / " ?behavior)), variant: caption }
        ] })
    }

    listens {
      BehaviorCatalogData.CATALOG_TOPICS -> TOPICS_COUNTED
      PlaygroundStage.STATUS -> STATUS
      TOPICS_COUNTED {
        topics : [PlaygroundTopic]!
      }
      STATUS {
        behavior : string!
        topic : string!
      }
    }
  }

  trait PlaygroundTopBar -> PlaygroundView [client] {
    config {
      heading : string = @config.title
        @label "Title"
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main { type: stack, direction: horizontal, align: center, gap: sm, className: "px-4 py-2", children: [
          { type: icon, name: blocks, size: md },
          { type: typography, content: @config.heading, variant: h4, weight: semibold }
        ] })
    }
  }

  page "/" as PlaygroundPage -> PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, PlaygroundOpen, GuestSession, BehaviorCatalogData, BehaviorCatalogLlm, CatEmbedWait, CatEmbedRequest, CatEmbedHttp, PlaygroundMachine, PlaygroundLive, PlaygroundStatus
  page "/:package/:name" as PlaygroundBehaviorPage -> PlaygroundFrame, PlaygroundTopBar, PlaygroundTopics, PlaygroundStage, PlaygroundLoader, PlaygroundOpen, GuestSession, BehaviorCatalogData, BehaviorCatalogLlm, CatEmbedWait, CatEmbedRequest, CatEmbedHttp, PlaygroundMachine, PlaygroundLive, PlaygroundStatus, PlaygroundRoute
  page boot as PlaygroundSeed -> MockStream, MockSeed
}

orbital NotFound = NotFound.orbitals.NotFoundOrbital {
  config { primaryHref: "/" }
}
