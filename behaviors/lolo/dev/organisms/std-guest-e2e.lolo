app std-guest-e2e [
  version: "1.0.0",
  description: "std-guest-e2e — drives the behavior catalog's guest sessions in a real headless Chrome and reports what a viewer would hit. For each scenario of the scenarios knob it opens baseUrl/<behavior>, loads the app again in a same-origin frame with a React commit counter installed before it starts, runs the scenario's steps as real clicks (each step clicks the control with that exact text, as soon as it exists, then waits for the text it expects or for a dialog, which it cancels), and then fails on a crashed page, a missing persona picker when the scenario asks for one, and more React commits in an idle second than the scenario allows (idleMax: a late answer settling is a commit or two, a render loop is dozens). It writes { ok, scenarios } to reportFile and stops Chrome. Run: ORB_CHROME=<chrome binary> orb-dev run std-guest-e2e.lolo with the launchpad up; read reportFile.",
  exec: [env ORB_CHROME],
  env: ["ORB_CHROME"],
  fs: { cwd: ".orbital/guest-e2e/**": [read, write, create], cwd: ".orbital/guest-e2e": [create] },
  net: { "127.0.0.1:9333": [tcp] }
]
;; @capabilities "end-to-end check of catalog guest sessions in a real browser: crashes, render loops, navigation, dialogs, persona picker"

uses ChromeA from "std/behaviors/std-chrome"
uses ReadPlan from "std/behaviors/std-guest-read-plan"

type E2eStep = { click : string!, see : string?, dialog : boolean?, times : number? }
type E2eScenario = { behavior : string!, persona : boolean!, idleMax : number!, steps : [E2eStep]!, real : boolean?, routes : [string]?, expectDenied : boolean? }
type ReadTarget = { behavior : string!, routes : [string]! }
type ReadClosed = { behavior : string!, at : string!, writes : [string]! }
type ReadSkippedPage = { route : string!, writes : [string]! }
type ReadSkippedRoutes = { behavior : string!, skipped : [ReadSkippedPage]!, paramRoutes : [string]! }
type ReadFailed = { behavior : string!, error : string! }
type ReadSignInPages = { behavior : string!, opening : boolean!, routes : [string]! }
type ReadCoverage = { closed : [ReadClosed]!, needsSignIn : [ReadSignInPages]!, noPage : [string]!, skippedRoutes : [ReadSkippedRoutes]!, unresolved : [ReadFailed]! }
type E2eOutcome = { behavior : string!, ok : boolean!, failures : [string]!, persona : boolean!, idle : number!, startedAt : number?, endedAt : number?, visited : number? }

orbital GuestE2eOrbital {
  entity GuestE2eRun [runtime] {
    id : string!
    at : number @description "The scenario being run." = 0
    scenarios : [E2eScenario] @description "The scenarios of this run: the knob, or what the planner found." = []
    coverage : ReadCoverage? @description "What a planned run left out and why." = null
    error : string @description "Why the run stopped early, when it did." = ""
    outcomes : [E2eOutcome] @description "What each finished scenario found." = []
    allOk : boolean @description "Whether every scenario finished clean so far." = true
  }

  trait GuestE2e -> GuestE2eRun {
    config {
      baseUrl : string = "http://127.0.0.1:4790"
        @label "Catalog address"
        @tier "domain"
      reportFile : string = ".orbital/guest-e2e/report.json"
        @label "Report file"
        @tier "domain"
      scenarios : [E2eScenario] = [
        { behavior: "almadar-behaviors/std-crm", persona: true, idleMax: 5, steps: [{ click: "Add a deal", see: "New Deal", dialog: false, times: 1 }, { click: "New Deal", see: "", dialog: true, times: 3 }] },
        { behavior: "almadar-behaviors/std-accounting", persona: true, idleMax: 5, steps: [{ click: "Journal", see: "New Period", dialog: false, times: 1 }, { click: "New Period", see: "", dialog: true, times: 2 }, { click: "Entries", see: "New transaction", dialog: false, times: 1 }, { click: "New transaction", see: "", dialog: true, times: 2 }, { click: "Recurring Invoices", see: "Customer", dialog: false, times: 1 }] },
        { behavior: "almadar-behaviors/project-friday", persona: true, idleMax: 5, steps: [{ click: "Delivery", see: "", dialog: false, times: 1 }, { click: "Projects", see: "Client", dialog: false, times: 1 }, { click: "Tasks", see: "Backlog", dialog: false, times: 1 }, { click: "Finance", see: "", dialog: false, times: 1 }, { click: "Budgets", see: "Limit", dialog: false, times: 1 }] },
        { behavior: "almadar-behaviors/std-kflow", persona: false, idleMax: 5, steps: [{ click: "Sign in", see: "Welcome back", dialog: false, times: 1 }] }
      ]
        @label "Scenarios"
        @tier "domain"
      plan : boolean = false
        @label "Plan the scenarios from the catalog"
        @tier "domain"
      sweepIdleMax : number = 500
        @label "Commits allowed in an idle second of a planned run"
        @tier "domain"
      controls : [E2eScenario] = [{ behavior: "almadar-std/std-guest-denial-probe", persona: false, idleMax: 500, steps: [], real: true, routes: ["/probe"], expectDenied: true }]
        @label "Scenarios that prove a planned run can fail"
        @tier "domain"
      flowScript : string = "async (s) => { const html = await (await fetch(location.href)).text(); document.body.innerHTML = ''; const ifr = document.createElement('iframe'); ifr.style.cssText = 'position:fixed;inset:0;width:1280px;height:800px;border:0'; document.body.appendChild(ifr); const w = ifr.contentWindow; w.__n = 0; const reqs = []; const of = w.fetch.bind(w); w.fetch = (u, o) => { let ev = ''; try { ev = JSON.parse(o.body).event || ''; } catch (e) {} const q = { u: String(u && u.url || u), ev, at: Date.now(), ms: null, st: null }; reqs.push(q); return of(u, o).then((x) => { q.ms = Date.now() - q.at; q.st = x.status; return x; }, (e) => { q.ms = Date.now() - q.at; q.st = String(e); throw e; }); }; w.__REACT_DEVTOOLS_GLOBAL_HOOK__ = { supportsFiber: true, isDisabled: false, renderers: new Map(), checkDCE() {}, inject() { return 1; }, onCommitFiberUnmount() {}, onPostCommitFiberRoot() {}, onCommitFiberRoot() { w.__n++; } }; const d = ifr.contentDocument; d.open(); d.write(html); d.close(); const wait = (m) => new Promise((r) => setTimeout(r, m)); const until = async (f, ms) => { const t = Date.now(); while (Date.now() - t < ms) { const v = f(); if (v) return v; await wait(60); } return null; }; const text = () => { const f = ifr.contentDocument.querySelector('[data-guest-frame]'); return f ? f.innerText : ''; }; const find = (q) => [...ifr.contentDocument.querySelectorAll('a,button')].find((e) => e.textContent.trim() === q); const dialog = () => ifr.contentDocument.querySelector('[role=dialog]'); const r = { behavior: s.behavior, ok: true, failures: [], persona: false, idle: 0, startedAt: Date.now(), endedAt: 0, visited: 0 }; const fail = (m) => { r.ok = false; r.failures.push(m); }; let up = null; if (s.real) { const sw = () => ifr.contentDocument.querySelector('[role=switch]'); up = await until(() => sw() && text().length > 0, 90000); if (!up) fail('the guest never opened before the switch'); else { const before = reqs.length; sw().click(); const answered = await until(() => reqs.slice(before).some((q) => q.ev === 'LOAD_BEHAVIOR' && q.ms !== null), 30000); if (!answered) fail('the Real integrations switch reached no server: ' + JSON.stringify(reqs.slice(before))); await until(() => text().length > 0, 90000); await wait(2500); const back = await until(sw, 30000); if (!back) fail('the Real integrations switch is gone after reopening'); else if (back.getAttribute('aria-checked') !== 'true') fail('the Real integrations switch did not stay on'); if (ifr.contentDocument.body.innerText.includes('could not be run')) fail('the behavior could not be run in Real mode: ' + ifr.contentDocument.body.innerText); } } if (s.routes && up) { const run = () => w.__orbitalVerification.getTraitSnapshots().find((x) => x.traitName === 'GuestStage').data.GuestStageRun[0]; for (const route of s.routes) { w.__kflowEventBus.emit('UI:Launchpad.GuestStage.GUEST_ROUTE', { guest: run().guestHandle, route }); if (!(await until(() => run().guestRoute === route, 30000))) { fail('the route never opened: ' + route); continue; } await wait(1200); r.visited++; if (text().includes('Something went wrong')) fail('the page crashed: ' + route); } } for (const step of s.steps) { for (let i = 0; i < (step.times || 1); i++) { const el = await until(() => find(step.click), 90000); if (!el) { fail('no control: ' + step.click + ' | frame: ' + text() + ' | page: ' + ifr.contentDocument.body.innerText.length + ' | requests: ' + JSON.stringify(reqs)); continue; } el.click(); if (step.see && !(await until(() => text().includes(step.see), 30000))) fail('after ' + step.click + ' never saw: ' + step.see); if (step.dialog) { const dl = await until(dialog, 8000); if (!dl) { fail('no dialog after: ' + step.click); continue; } const c = [...dl.querySelectorAll('button')].find((b) => b.textContent.trim() === 'Cancel'); if (c) c.click(); await until(() => !dialog(), 5000); await wait(300); } } } await wait(4500); const a = w.__n; await wait(1000); r.idle = w.__n - a; r.persona = ifr.contentDocument.body.innerText.includes('Viewing as'); if (s.real && up) { const trace = [...ifr.contentDocument.querySelectorAll('button')].find((b) => b.getAttribute('aria-label') === 'Trace'); if (!trace) fail('no Trace button'); else { trace.click(); const list = await until(() => ifr.contentDocument.getElementById('guest-denials'), 15000); if (!list) fail('the trace never answered'); else { const denied = [...list.children].slice(1); if (s.expectDenied) { if (denied.length === 0) fail('the denial control reported no denial'); } else for (const row of denied) fail('denied: ' + row.textContent); } } } if (text().includes('Something went wrong')) fail('the page crashed'); const frame = ifr.contentDocument.querySelector('[data-guest-frame]'); if (frame) { const box = frame.getBoundingClientRect(); for (const el of frame.querySelectorAll('button')) { if (ifr.contentWindow.getComputedStyle(el.parentElement).position !== 'fixed') continue; const b = el.getBoundingClientRect(); if (b.left < box.left || b.right > box.right || b.top < box.top || b.bottom > box.bottom) fail('a fixed control left the preview: ' + (el.getAttribute('aria-label') || el.textContent)); } } if (text().includes('Cancelled')) fail('a Cancelled toast is still showing after the last step'); if (s.persona && !r.persona) fail('no persona picker'); if (r.idle > s.idleMax) fail('render loop: ' + r.idle + ' commits in an idle second'); r.endedAt = Date.now(); return JSON.stringify(r); }"
        @label "Browser flow"
        @tier "internal"
    }

    initial: starting

    state starting {
      INIT -> starting when (not @config.plan)
        (set @entity.scenarios @config.scenarios)
        (emit CHROME_START {})
      INIT -> planning when @config.plan
        (emit SWEEP_PLAN {})
      CHROME_READY -> running
        (emit E2E_NEXT {})
      CHROME_FAILED -> finishing
        (set @entity.allOk false)
        (emit E2E_FINISH { error: ?message })
    }

    state planning {
      INIT -> planning
      SWEEP_PLANNED -> starting
        (set @entity.scenarios (array/concat @config.controls (array/map ?targets (fn t { behavior: @t.behavior, persona: false, idleMax: @config.sweepIdleMax, steps: [], real: true, routes: @t.routes }))))
        (set @entity.coverage ?coverage)
        (emit CHROME_START {})
      SWEEP_PLAN_FAILED -> finishing
        (set @entity.allOk false)
        (emit E2E_FINISH { error: ?error })
    }

    state running {
      INIT -> running
      E2E_NEXT -> running when (>= @entity.at (array/len @entity.scenarios))
        (emit E2E_FINISH { error: "" })
      E2E_NEXT -> running when (< @entity.at (array/len @entity.scenarios))
        (let ((scenario (let ((none : E2eScenario { behavior: "", persona: false, idleMax: 5, steps: [] })) (default (as (array/nth @entity.scenarios @entity.at) E2eScenario) @none)))) (emit PAGE_NAVIGATE { key: "e2e", url: (str/concat @config.baseUrl "/" (object/get @scenario "behavior" "")) }))
      PAGE_LOADED -> running
        (let ((scenario (let ((none : E2eScenario { behavior: "", persona: false, idleMax: 5, steps: [] })) (default (as (array/nth @entity.scenarios @entity.at) E2eScenario) @none)))) (emit PAGE_MEASURE { key: "e2e", expression: (str/concat "(" @config.flowScript ")(" (json/stringify @scenario) ")") }))
      PAGE_MEASURED -> running
        (let ((outcome (as (default (json/parse ?json E2eOutcome) { behavior: "", ok: false, failures: ["the flow answered no outcome"], persona: false, idle: 0 }) E2eOutcome))) (do
          (set @entity.outcomes (array/append @entity.outcomes @outcome))
          (set @entity.allOk (and @entity.allOk (object/get @outcome "ok" false)))))
        (set @entity.at (+ @entity.at 1))
        (emit E2E_NEXT {})
      PAGE_FAILED -> running
        (set @entity.outcomes (array/append @entity.outcomes { behavior: (object/get (let ((none : E2eScenario { behavior: "", persona: false, idleMax: 5, steps: [] })) (default (as (array/nth @entity.scenarios @entity.at) E2eScenario) @none)) "behavior" ""), ok: false, failures: [?error], persona: false, idle: 0 }))
        (set @entity.allOk false)
        (set @entity.at (+ @entity.at 1))
        (emit E2E_NEXT {})
      CHROME_FAILED -> finishing
        (set @entity.allOk false)
        (emit E2E_FINISH { error: ?message })
      E2E_FINISH -> finishing
        (set @entity.error ?error)
        (os/mkdir { anchor: "cwd", path: ".orbital/guest-e2e" } true { emit: { success: E2E_DIR_READY, failure: E2E_WRITE_FAILED } })
    }

    state finishing {
      INIT -> finishing
      E2E_FINISH -> finishing
        (set @entity.error ?error)
        (os/mkdir { anchor: "cwd", path: ".orbital/guest-e2e" } true { emit: { success: E2E_DIR_READY, failure: E2E_WRITE_FAILED } })
      E2E_DIR_READY -> finishing
        (os/write-file { anchor: "cwd", path: @config.reportFile } (bytes/from-string (json/stringify { ok: (and @entity.allOk (> (array/len @entity.scenarios) 0)), error: @entity.error, scenarios: @entity.outcomes, coverage: @entity.coverage })) { emit: { success: E2E_WRITTEN, failure: E2E_WRITE_FAILED } })
      E2E_WRITTEN -> finishing
        (emit CHROME_STOP {})
      E2E_WRITE_FAILED -> finishing
        (emit CHROME_STOP {})
      CHROME_STOPPED -> done
      CHROME_FAILED -> finishing
      PAGE_LOADED -> finishing
      PAGE_MEASURED -> finishing
      PAGE_FAILED -> finishing
      E2E_NEXT -> finishing
    }

    state done {
      INIT -> done
    }

    ticks {
      keepRunning every 500ms in starting, running, finishing [background]
        (set @entity.at @entity.at)
    }

    emits {
      SWEEP_PLAN -> external { }
      CHROME_START -> external { }
      CHROME_STOP -> external { }
      PAGE_NAVIGATE -> external {
        key : string!
        url : string!
      }
      PAGE_MEASURE -> external {
        key : string!
        expression : string!
      }
      E2E_NEXT { }
      E2E_FINISH {
        error : string!
      }
      E2E_DIR_READY { }
      E2E_WRITTEN { }
      E2E_WRITE_FAILED { }
    }

    listens {
      E2ePlan.GuestReadPlan.READ_PLAN_READY -> SWEEP_PLANNED
      E2ePlan.GuestReadPlan.READ_PLAN_FAILED -> SWEEP_PLAN_FAILED
      SWEEP_PLANNED {
        targets : [ReadTarget]!
        coverage : ReadCoverage!
      }
      SWEEP_PLAN_FAILED {
        error : string!
      }
      E2eChrome.Chrome.CHROME_READY -> CHROME_READY
      E2eChrome.Chrome.CHROME_FAILED -> CHROME_FAILED
      E2eChrome.Chrome.CHROME_STOPPED -> CHROME_STOPPED
      E2eChrome.Chrome.PAGE_LOADED -> PAGE_LOADED
      E2eChrome.Chrome.PAGE_MEASURED -> PAGE_MEASURED
      E2eChrome.Chrome.PAGE_FAILED -> PAGE_FAILED
      CHROME_READY {
        browser : string!
      }
      CHROME_FAILED {
        code : string!
        message : string!
      }
      CHROME_STOPPED { }
      PAGE_LOADED {
        key : string!
        url : string!
        title : string!
      }
      PAGE_MEASURED {
        key : string!
        json : string!
      }
      PAGE_FAILED {
        key : string!
        error : string!
        code : string!
      }
    }
  }

  page boot as GuestE2eBoot -> GuestE2e
}

orbital E2ePlan = ReadPlan.orbitals.GuestReadPlanOrbital {
  listens {
    GuestE2eOrbital.GuestE2e.SWEEP_PLAN -> GuestReadPlan.READ_PLAN_START
  }
}

orbital E2eChrome = ChromeA.orbitals.ChromeOrbital {
  traits {
    ChromeDaemon {
      config { readyPort: 9333 }
    }
    CdpHttp {
      config { port: 9333 }
    }
    CdpWs {
      config { port: 9333 }
    }
    Cdp {
      config { timeoutMs: 120000 }
    }
    Chrome {
      config {
        port: 9333
        profileDir: { anchor: "cwd" path: ".orbital/guest-e2e/profile" }
        downloadDir: { anchor: "cwd" path: ".orbital/guest-e2e/downloads" }
        preferencesDir: { anchor: "cwd" path: ".orbital/guest-e2e/profile/Default" }
        preferencesFile: { anchor: "cwd" path: ".orbital/guest-e2e/profile/Default/Preferences" }
      }
    }
  }
  listens {
    GuestE2eOrbital.GuestE2e.CHROME_START -> Chrome.CHROME_START
    GuestE2eOrbital.GuestE2e.CHROME_STOP -> Chrome.CHROME_STOP
    GuestE2eOrbital.GuestE2e.PAGE_NAVIGATE -> Chrome.PAGE_NAVIGATE
    GuestE2eOrbital.GuestE2e.PAGE_MEASURE -> Chrome.PAGE_MEASURE
  }
}
