app std-review-pins [
  version: "1.0.0",
  locales: [en, ar, sl],
  fs: { "/srv/orb/apps/**": [read] },
  description: "std-review-pins — reviewers leave feedback and questions pinned on a live view. ReviewPinsBoard wraps the trait its contentTrait knob names in the annotated-media pattern's content mode, so the view stays usable, and puts a Feedback tab on the right edge, collapsed to its icon until hovered, with the subject's total comment count. The tab opens a side drawer that lists every comment of the subject on every route (resolved ones only when shown), each naming its route. Add comment closes the drawer and waits for one click on the view: the click drops a pin there (x and y as percentages of the view) on the route the view shows and opens the drawer on its text; Cancel on the tab ends the wait. Pins are not drawn on the view until one is opened: opening a comment draws only its pin, and when the comment is on another route the board emits GUEST_NAVIGATE { guest, route } so the guest that shows the view goes there (ROUTE_SEEN { route, guest } names the view's route and guest). An open comment shows its replies, takes a reply, and resolves or reopens it. A pin is one ReviewPin row: the subject it belongs to (REVIEW_OPEN { subject } names it, for example a review name and its version), the route, x, y, its kind (feedback or question), the text, its author (the signed-in viewer) and whether it is open or resolved; a reply is a row whose parentId names its pin. The atom states no access policy of its own: the composing program declares who may read and write ReviewPin rows."
]
;; @capabilities "pin feedback on a live app, review comments on a prototype, client questions on a page, design review pins, annotate a running screen"

type ReviewPinRow = { id : string!, subject : string!, route : string!, x : number!, y : number!, kind : "feedback" | "question"!, body : string!, authorId : string!, authorName : string!, status : "open" | "resolved"!, parentId : string!, createdAt : string! }
type ReviewLink = { name : string!, version : string!, behavior : string!, label : string!, route : string!, path : string? }
type ReviewProgram = { name : string, orbitals : [orbital] }
type ReviewProgramRead = { program : ReviewProgram! }
type ReviewLeaf = { package : string!, topic : string!, behavior : string!, kind : string!, value : behavior! }
type ReviewMediaPin = { id : string!, x : number, y : number, time : number, label : string, resolved : boolean }

orbital ReviewPinsOrbital {
  entity ReviewPin [persistent: review_pins] {
    @create none "A substrate atom: the composing program decides who may leave a pin, so this atom states no creator of its own."
    @read none "A substrate atom: the composing program scopes who reads the pins of a subject."
    id : string!
    subject : string! @description "What the pin is about, as REVIEW_OPEN named it (for example a behavior and its version)." @synonyms "review subject, prototype, version"
    route : string! @description "The route of the reviewed view the pin was left on." @synonyms "page, screen, path" = ""
    x : number! @description "Horizontal position of the pin, as a percentage of the view's width." = 0
    y : number! @description "Vertical position of the pin, as a percentage of the view's height." = 0
    kind : "feedback" | "question"! @description "Whether the pin is feedback or a question." @synonyms "type, category" = feedback
    body : string! @description "The text the reviewer wrote." @synonyms "comment, text, message" = ""
    authorId : string! @description "The signed-in viewer who wrote it." @synonyms "author, reviewer, user id" = ""
    authorName : string! @description "The author's display name." @synonyms "author name, reviewer name" = ""
    status : "open" | "resolved"! @description "Whether the pin still needs an answer." @synonyms "state, resolved" = open
    parentId : string! @description "The pin a reply answers; empty on a pin itself." @synonyms "thread, reply to" = ""
    createdAt : string! @description "When it was written." = ""
    rows : [ReviewPinRow] @intrinsic @description "The subject's pins and replies, as last read." = []
    viewSubject : string @intrinsic @description "The subject the board shows." = ""
    viewRoute : string @intrinsic @description "The route the reviewed view is on." = ""
    viewGuest : string @intrinsic @description "The guest that shows the reviewed view, as ROUTE_SEEN named it; a pin on another route asks it to go there." = ""
    placing : boolean @intrinsic @description "Waiting for one click on the view to drop a new pin; the click ends it." = false
    showResolved : boolean @intrinsic @description "Whether resolved pins are listed and drawn." = false
    panelOpen : boolean @intrinsic @description "Whether the comment drawer over the view is open; closed leaves only the feedback tab on the right edge." = false
    draftOpen : boolean @intrinsic @description "A dropped pin waits for its text." = false
    draftX : number @intrinsic = 0
    draftY : number @intrinsic = 0
    draftKind : "feedback" | "question" @intrinsic = feedback
    draftBody : string @intrinsic = ""
    activeId : string @intrinsic @description "The pin opened in the side panel; empty lists the pins." = ""
    replyBody : string @intrinsic = ""
    problem : string @intrinsic @description "The last read or write that failed, shown in the panel." = ""
  }

  trait ReviewPinsBoard -> @rebindable ReviewPin {
    initial: idle

    state idle {
      INIT -> idle
      REVIEW_REFUSED -> idle
        (render-ui main { type: container, size: md, padding: lg, children: [{ type: stack, direction: vertical, gap: md, children: [{ type: alert, variant: error, title: ?title, message: ?message }, { type: button, variant: secondary, icon: list, label: @config.indexLabel, action: REVIEWS_SHOW }] }] })
      REVIEWS_SHOW -> idle
        (navigate "/review")
      REVIEW_OPEN -> ready
        (set @entity.viewSubject ?subject)
        (fetch ReviewPin { filter: (= (object/get @entity subject) ?subject), limit: @config.pinLimit, emit: { success: PINS_READ, failure: PINS_READ_FAILED } })
    }

    state ready {
      INIT -> ready
        (emit PINS_PAINT {})
      REVIEW_OPEN -> ready
        (set @entity.viewSubject ?subject)
        (set @entity.activeId "")
        (fetch ReviewPin { filter: (= (object/get @entity subject) ?subject), limit: @config.pinLimit, emit: { success: PINS_READ, failure: PINS_READ_FAILED } })
      ROUTE_SEEN -> ready when (= ?route @entity.viewRoute)
        (set @entity.viewGuest (default ?guest @entity.viewGuest))
      ROUTE_SEEN -> ready when (!= ?route @entity.viewRoute)
        (set @entity.viewGuest (default ?guest @entity.viewGuest))
        (set @entity.viewRoute ?route)
        (set @entity.draftOpen false)
        (emit PINS_PAINT {})
      PINS_READ -> ready
        (set @entity.rows ?data)
        (set @entity.problem "")
        (emit PINS_PAINT {})
      PINS_READ_FAILED -> ready
        (set @entity.problem ?error)
        (emit PINS_PAINT {})
      PLACE_TOGGLE -> ready when @entity.placing
        (set @entity.placing false)
        (emit PINS_PAINT {})
      PLACE_TOGGLE -> ready when (not @entity.placing)
        (set @entity.placing true)
        (set @entity.panelOpen false)
        (set @entity.draftOpen false)
        (set @entity.activeId "")
        (emit PINS_PAINT {})
      RESOLVED_TOGGLE -> ready
        (set @entity.showResolved (not @entity.showResolved))
        (emit PINS_PAINT {})
      PANEL_TOGGLE -> ready
        (set @entity.panelOpen (not @entity.panelOpen))
        (emit PINS_PAINT {})
      PANEL_CLOSE -> ready when (not @entity.panelOpen)
      PANEL_CLOSE -> ready when @entity.panelOpen
        (set @entity.panelOpen false)
        (emit PINS_PAINT {})
      PIN_PLACE -> ready
        (set @entity.placing false)
        (set @entity.panelOpen true)
        (set @entity.draftOpen true)
        (set @entity.draftX ?x)
        (set @entity.draftY ?y)
        (set @entity.draftBody "")
        (set @entity.draftKind feedback)
        (set @entity.activeId "")
        (emit PINS_PAINT {})
      DRAFT_KIND -> ready
        (set @entity.draftKind ?value)
        (emit PINS_PAINT {})
      DRAFT_BODY -> ready
        (set @entity.draftBody ?value)
      DRAFT_CANCEL -> ready
        (set @entity.draftOpen false)
        (set @entity.placing false)
        (emit PINS_PAINT {})
      DRAFT_SAVE -> ready when (= (str/trim @entity.draftBody) "")
        (set @entity.problem @config.emptyText)
        (emit PINS_PAINT {})
      DRAFT_SAVE -> ready when (!= (str/trim @entity.draftBody) "")
        (persist create ReviewPin { subject: @entity.viewSubject, route: @entity.viewRoute, x: @entity.draftX, y: @entity.draftY, kind: @entity.draftKind, body: (str/trim @entity.draftBody), authorId: @user.id, authorName: (default @user.name ""), status: open, parentId: "", createdAt: (str/concat "" @now) } { emit: { success: PIN_WRITTEN, failure: PIN_WRITE_FAILED } })
      PIN_WRITTEN -> ready
        (set @entity.draftOpen false)
        (set @entity.draftBody "")
        (set @entity.placing false)
        (emit PIN_LEFT { id: ?id, subject: @entity.viewSubject, route: @entity.viewRoute })
        (fetch ReviewPin { filter: (= (object/get @entity subject) @entity.viewSubject), limit: @config.pinLimit, emit: { success: PINS_READ, failure: PINS_READ_FAILED } })
      PIN_WRITE_FAILED -> ready
        (set @entity.problem ?error)
        (emit PINS_PAINT {})
      PIN_SELECT -> ready when (= ?id "draft")
      PIN_SELECT -> ready when (and (!= ?id "draft") (or (= (default ?route "") "") (= ?route @entity.viewRoute) (= @entity.viewGuest "")))
        (set @entity.panelOpen true)
        (set @entity.activeId ?id)
        (set @entity.draftOpen false)
        (set @entity.replyBody "")
        (emit PINS_PAINT {})
      PIN_SELECT -> ready when (and (!= ?id "draft") (!= (default ?route "") "") (!= ?route @entity.viewRoute) (!= @entity.viewGuest ""))
        (set @entity.panelOpen true)
        (set @entity.activeId ?id)
        (set @entity.draftOpen false)
        (set @entity.replyBody "")
        (emit GUEST_NAVIGATE { guest: @entity.viewGuest, route: ?route })
        (emit PINS_PAINT {})
      PIN_CLOSE -> ready
        (set @entity.activeId "")
        (emit PINS_PAINT {})
      REPLY_BODY -> ready
        (set @entity.replyBody ?value)
      REPLY_SAVE -> ready when (or (= @entity.activeId "") (= (str/trim @entity.replyBody) ""))
      REPLY_SAVE -> ready when (and (!= @entity.activeId "") (!= (str/trim @entity.replyBody) ""))
        (persist create ReviewPin { subject: @entity.viewSubject, route: @entity.viewRoute, x: 0, y: 0, kind: feedback, body: (str/trim @entity.replyBody), authorId: @user.id, authorName: (default @user.name ""), status: open, parentId: @entity.activeId, createdAt: (str/concat "" @now) } { emit: { success: REPLY_WRITTEN, failure: PIN_WRITE_FAILED } })
      REPLY_WRITTEN -> ready
        (set @entity.replyBody "")
        (fetch ReviewPin { filter: (= (object/get @entity subject) @entity.viewSubject), limit: @config.pinLimit, emit: { success: PINS_READ, failure: PINS_READ_FAILED } })
      PIN_STATUS -> ready
        (persist update ReviewPin { id: ?id, status: ?status } { emit: { success: STATUS_WRITTEN, failure: PIN_WRITE_FAILED } })
      STATUS_WRITTEN -> ready
        (fetch ReviewPin { filter: (= (object/get @entity subject) @entity.viewSubject), limit: @config.pinLimit, emit: { success: PINS_READ, failure: PINS_READ_FAILED } })

      PINS_PAINT -> ready
        (let ((all (array/filter @entity.rows (fn p (and (= @p.parentId "") (or @entity.showResolved (= @p.status "open"))))))
              (active (array/find @entity.rows (fn p (= @p.id @entity.activeId))))
              (shown (array/filter @all (fn p (and (= @p.id @entity.activeId) (= @p.route @entity.viewRoute))))))
          (render-ui main { type: box, position: relative, className: "h-full min-h-0 w-full", children: [
            { type: annotated-media, mediaType: content, children: @config.contentTrait, title: @config.title,
              pins: (array/concat
                (array/map @shown (fn p { id: @p.id, x: @p.x, y: @p.y, time: 0, label: @p.body, resolved: (= @p.status "resolved") }))
                (if @entity.draftOpen [{ id: "draft", x: @entity.draftX, y: @entity.draftY, time: 0, label: @config.newPinTitle, resolved: false }] [])),
              activePinId: (if @entity.draftOpen "draft" @entity.activeId), placing: @entity.placing, placeEvent: PIN_PLACE, pinSelectEvent: PIN_SELECT, className: "h-full w-full overflow-auto" },
            { type: box, position: fixed, className: (if @entity.panelOpen hidden (if @entity.placing "right-0 top-1/2 -translate-y-1/2 z-40" "right-0 top-1/2 -translate-y-1/2 z-40 w-10 hover:w-auto overflow-hidden")), children: [
              { type: button, icon: (if @entity.placing x message-square), variant: primary, size: sm, className: "rounded-l-md rounded-r-none shadow-lg whitespace-nowrap justify-start",
                label: (if @entity.placing @config.placingTabLabel (str/concat @config.tabLabel " · " (array/len @all))),
                action: (if @entity.placing PLACE_TOGGLE PANEL_TOGGLE) }
            ] },
            { type: drawer, isOpen: @entity.panelOpen, modal: false, position: right, width: "min(340px, 90vw)", title: (str/concat @config.panelTitle " · " (array/len @all)), closeEvent: PANEL_CLOSE, children: [{ type: stack, direction: vertical, gap: sm, children: [
              { type: stack, direction: horizontal, gap: xs, align: center, children: [
                { type: button, label: @config.placeLabel, icon: message-square-plus, variant: primary, size: sm, action: PLACE_TOGGLE },
                { type: button, label: (if @entity.showResolved @config.hideResolvedLabel @config.showResolvedLabel), variant: ghost, size: sm, action: RESOLVED_TOGGLE }
              ] },
              { type: alert, variant: error, message: @entity.problem, className: (if (= @entity.problem "") hidden "") },
              (if @entity.draftOpen
                { type: stack, direction: vertical, gap: sm, children: [
                  { type: typography, variant: h4, content: @config.newPinTitle },
                  { type: select, aria-label: @config.kindLabel, value: @entity.draftKind, action: DRAFT_KIND, options: [{ value: feedback, label: @config.feedbackLabel }, { value: question, label: @config.questionLabel }] },
                  { type: textarea, aria-label: @config.bodyLabel, placeholder: @config.bodyPlaceholder, value: @entity.draftBody, onChange: DRAFT_BODY },
                  { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, label: @config.saveLabel, icon: send, variant: primary, size: sm, action: DRAFT_SAVE },
                    { type: button, label: @config.cancelLabel, variant: secondary, size: sm, action: DRAFT_CANCEL }
                  ] }
                ] }
                (if (= @active null)
                  { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: body2, color: muted, content: @config.emptyListText, className: (if (= (array/len @all) 0) "" hidden) },
                    { type: stack, direction: vertical, gap: xs, children: (array/map @all (fn p { type: button, variant: ghost, size: sm, className: "justify-start text-left h-auto py-2 whitespace-normal",
                      label: (str/concat (if (= @p.kind "question") "? " "• ") @p.authorName ": " @p.body " — " @p.route),
                      action: PIN_SELECT, actionPayload: { id: @p.id, route: @p.route } })) }
                  ] }
                  { type: stack, direction: vertical, gap: sm, children: (array/concat
                    [{ type: stack, direction: horizontal, gap: xs, align: center, children: [
                        { type: button, label: @config.backLabel, icon: arrow-left, variant: ghost, size: sm, action: PIN_CLOSE },
                        { type: badge, label: (if (= @active.kind "question") @config.questionLabel @config.feedbackLabel) },
                        { type: badge, label: (if (= @active.status "resolved") @config.resolvedLabel @config.openLabel) }
                      ] },
                     { type: typography, variant: caption, color: muted, content: (str/concat @active.authorName " — " @active.route) },
                     { type: typography, variant: body1, content: @active.body }]
                    (array/map (array/filter @entity.rows (fn r (= @r.parentId @active.id))) (fn r { type: stack, direction: vertical, gap: none, className: "border-l-2 pl-2", children: [{ type: typography, variant: caption, color: muted, content: @r.authorName }, { type: typography, variant: body2, content: @r.body }] }))
                    [{ type: textarea, aria-label: @config.replyLabel, placeholder: @config.replyPlaceholder, value: @entity.replyBody, onChange: REPLY_BODY },
                     { type: stack, direction: horizontal, gap: sm, children: [
                       { type: button, label: @config.replyLabel, icon: reply, variant: primary, size: sm, action: REPLY_SAVE },
                       { type: button, label: (if (= @active.status "resolved") @config.reopenLabel @config.resolveLabel), icon: (if (= @active.status "resolved") rotate-ccw check), variant: secondary, size: sm, action: PIN_STATUS, actionPayload: { id: @active.id, status: (if (= @active.status "resolved") open resolved) } }
                     ] }]) }))
            ] }] }
          ] }))
    }

    emits {
      PINS_PAINT
        @description "Internal: draw the view with the current route's pins and the side panel."
        @tier "internal"
      PINS_READ
        @tier "internal"
      PINS_READ_FAILED
        @tier "internal"
      PIN_WRITTEN
        @tier "internal"
      REPLY_WRITTEN
        @tier "internal"
      STATUS_WRITTEN
        @tier "internal"
      PIN_WRITE_FAILED
        @tier "internal"
      PIN_LEFT -> external {
        id : string!
        subject : string!
        route : string!
      }
        @description "A reviewer left a new pin on the subject's route."
        @tier "essential"
      GUEST_NAVIGATE -> external {
        guest : string!
        route : string!
      }
        @description "A pin on another route was opened: the guest showing the view goes to that route."
    }

    listens {
      ReviewOpener.REVIEW_OPEN -> REVIEW_OPEN
      ReviewOpener.REVIEW_REFUSED -> REVIEW_REFUSED
      REVIEW_REFUSED {
        title : string!
        message : string!
      }
      REVIEWS_SHOW { }
      REVIEW_OPEN {
        subject : string!
        route : string
      }
        @description "Show the pins of this subject. route is the page the link asks the view to start on, not the page it shows: only ROUTE_SEEN sets that."
      ROUTE_SEEN {
        route : string!
        guest : string
      }
        @description "The reviewed view is on this route now."
      PIN_PLACE {
        x : number!
        y : number!
        time : number!
      }
      PIN_SELECT {
        id : string!
        route : string
      }
      PANEL_TOGGLE { }
      PANEL_CLOSE { }
        @description "The drawer asked to close (its close button, Escape or a click outside it); a closed drawer stays closed."
      DRAFT_KIND {
        value : "feedback" | "question"!
      }
      DRAFT_BODY {
        value : string!
      }
      REPLY_BODY {
        value : string!
      }
      PIN_STATUS {
        id : string!
        status : "open" | "resolved"!
      }
      PINS_READ {
        data : [ReviewPinRow]!
      }
      PINS_READ_FAILED {
        error : string!
      }
      PIN_WRITTEN {
        id : string!
      }
      PIN_WRITE_FAILED {
        error : string!
      }
    }

    config {
      pinLimit : number = 1000
        @label "Most pins read"
        @description "The most pins and replies of one subject the board reads."
        @tier "policy"
      contentTrait : trait
        @label "Reviewed view"
        @description "The trait whose view reviewers pin feedback on."
        @tier "domain"
      indexLabel : string = "All reviews"
        @tier "presentation"
      tabLabel : string = "Feedback"
        @label "Feedback tab"
        @description "The tab on the right edge that opens the comments; the total count follows it."
        @tier "presentation"
      placingTabLabel : string = "Click where it belongs · Cancel"
        @tier "presentation"
      panelTitle : string = "Comments"
        @tier "presentation"
      title : string = "Reviewed view"
        @label "Title"
        @description "Accessible name of the reviewed view."
        @tier "presentation"
      placeLabel : string = "Add comment"
        @tier "presentation"
      showResolvedLabel : string = "Show resolved"
        @tier "presentation"
      hideResolvedLabel : string = "Hide resolved"
        @tier "presentation"
      newPinTitle : string = "New comment"
        @tier "presentation"
      kindLabel : string = "Kind"
        @tier "presentation"
      feedbackLabel : string = "Feedback"
        @tier "presentation"
      questionLabel : string = "Question"
        @tier "presentation"
      bodyLabel : string = "Comment"
        @tier "presentation"
      bodyPlaceholder : string = "What should change, or what would you like to ask?"
        @tier "presentation"
      saveLabel : string = "Save"
        @tier "presentation"
      cancelLabel : string = "Cancel"
        @tier "presentation"
      emptyText : string = "Write something before saving."
        @tier "presentation"
      emptyListText : string = "No comments yet."
        @tier "presentation"
      backLabel : string = "All comments"
        @tier "presentation"
      openLabel : string = "Open"
        @tier "presentation"
      resolvedLabel : string = "Resolved"
        @tier "presentation"
      resolveLabel : string = "Resolve"
        @tier "presentation"
      reopenLabel : string = "Reopen"
        @tier "presentation"
      replyLabel : string = "Reply"
        @tier "presentation"
      replyPlaceholder : string = "Write a reply…"
        @tier "presentation"
    }
  }

  entity ReviewOpenerView [runtime] {
    id : string!
    wanted : string @description "The behavior the review link names, until the catalog lists it." = ""
    leaves : [ReviewLeaf] @description "The catalog tree, as last listed." = []
    listed : boolean @description "Whether the catalog has listed its tree at least once." = false
    openedBehavior : string @description "The behavior the review link opened, kept so a lost guest can be opened again." = ""
    openedRoute : string @description "The route the review link opened the guest on." = ""
    openedPath : string @description "The prebuilt program file the review link opened, when its row names one." = ""
  }

  trait ReviewOpener -> ReviewOpenerView [client] {
    initial: idle

    state idle {
      INIT -> idle when (or (= (default ?version "") "") (not (array/some @config.reviews (fn r (and (= @r.name (default ?name "")) (= @r.version (default ?version "")))))))
        (emit REVIEW_REFUSED { title: @config.unknownTitle, message: (str/concat (default ?name "") " " (default ?version "")) })
      INIT -> idle when (and (!= (default ?version "") "") (array/some @config.reviews (fn r (and (= @r.name (default ?name "")) (= @r.version (default ?version "")) (!= (default @r.path "") "")))))
        (let ((link (array/find @config.reviews (fn r (and (= @r.name ?name) (= @r.version ?version))))))
          (do
            (set @entity.openedPath (default @link.path ""))
            (set @entity.openedRoute @link.route)
            (emit GUEST_START_ROUTE { route: @link.route })
            (emit REVIEW_OPEN { subject: (str/concat @link.name "/" ?version), route: @link.route })
            (emit LOAD_PROGRAM_FILE { path: (default @link.path "") })))
      INIT -> idle when (and (!= (default ?version "") "") (array/some @config.reviews (fn r (and (= @r.name (default ?name "")) (= @r.version (default ?version "")) (= (default @r.path "") "")))))
        (let ((link (array/find @config.reviews (fn r (and (= @r.name ?name) (= @r.version ?version))))))
          (do
            (set @entity.openedBehavior @link.behavior)
            (set @entity.openedRoute @link.route)
            (emit GUEST_START_ROUTE { route: @link.route })
            (emit REVIEW_OPEN { subject: (str/concat @link.name "/" ?version), route: @link.route })
            (if (array/some @entity.leaves (fn l (= @l.behavior @link.behavior)))
              (let ((leaf (array/find @entity.leaves (fn l (= @l.behavior @link.behavior)))))
                (do
                  (set @entity.wanted "")
                  (emit LOAD_BEHAVIOR { behavior: @leaf.behavior, value: @leaf.value })))
              (if @entity.listed
                (emit REVIEW_REFUSED { title: @config.missingTitle, message: @link.behavior })
                (set @entity.wanted @link.behavior)))))
      REOPEN -> idle when (!= @entity.openedPath "")
        (emit GUEST_START_ROUTE { route: @entity.openedRoute })
        (emit LOAD_PROGRAM_FILE { path: @entity.openedPath })
      REOPEN -> idle when (and (= @entity.openedPath "") (!= @entity.openedBehavior "") (array/some @entity.leaves (fn l (= @l.behavior @entity.openedBehavior))))
        (let ((leaf (array/find @entity.leaves (fn l (= @l.behavior @entity.openedBehavior)))))
          (do
            (emit GUEST_START_ROUTE { route: @entity.openedRoute })
            (emit LOAD_BEHAVIOR { behavior: @leaf.behavior, value: @leaf.value })))
      REOPEN -> idle when (and (= @entity.openedPath "") (not (and (!= @entity.openedBehavior "") (array/some @entity.leaves (fn l (= @l.behavior @entity.openedBehavior))))))
      TREE_LISTED -> idle when (and (!= @entity.wanted "") (array/some ?data (fn l (= @l.behavior @entity.wanted))))
        (set @entity.leaves ?data)
        (set @entity.listed true)
        (let ((leaf (array/find ?data (fn l (= @l.behavior @entity.wanted)))))
          (do
            (set @entity.wanted "")
            (emit LOAD_BEHAVIOR { behavior: @leaf.behavior, value: @leaf.value })))
      TREE_LISTED -> idle when (and (!= @entity.wanted "") (not (array/some ?data (fn l (= @l.behavior @entity.wanted)))))
        (set @entity.leaves ?data)
        (set @entity.listed true)
        (emit REVIEW_REFUSED { title: @config.missingTitle, message: @entity.wanted })
        (set @entity.wanted "")
      TREE_LISTED -> idle when (= @entity.wanted "")
        (set @entity.leaves ?data)
        (set @entity.listed true)
    }

    emits {
      REVIEW_OPEN -> external {
        subject : string!
        route : string!
      }
        @description "A review link was opened: its subject is the name and the version the link passes, so each version keeps its own pins."
      LOAD_BEHAVIOR -> external {
        behavior : string!
        value : behavior!
      }
        @description "Ask the loader for the behavior of the review link, as the catalog lists it."
      LOAD_PROGRAM_FILE -> external {
        path : string!
      }
        @description "Ask for the prebuilt program file the review link names, instead of looking the behavior up in the catalog."
      GUEST_START_ROUTE -> external {
        route : string!
      }
        @description "The page of the reviewed behavior the guest opens on: the route of the review row."
      REVIEW_REFUSED -> external {
        title : string!
        message : string!
      }
        @description "The review link names no review row, or its behavior is not installed."
    }

    listens {
      INIT {
        name : string
        version : string
      }
        @description "The review page mounted with the name and version of the link."
      TREE_LISTED {
        data : [ReviewLeaf]!
      }
        @description "The catalog listed its tree."
      REOPEN {
        guest : string?
      }
        @description "The open review must be opened again: its guest was lost (the server restarted) or the guest session asked for a reopen (the integrations switch changed). Opens the same link again."
    }

    config {
      reviews : [ReviewLink] = []
        @label "Review links"
        @description "The reviews this program serves: /review/<name>/<version> opens the behavior the row of that name names, starting on its route, and the pins are kept under <name>/<version>, so every version keeps its own review history. version on the row is the current version the review list links to. A name no row lists is refused."
        @tier "domain"
      unknownTitle : string = "This review is not known"
        @tier "presentation"
      missingTitle : string = "The reviewed behavior is not installed"
        @tier "presentation"
    }
  }

  entity ReviewProgramFileView [runtime] {
    id : string!
    programPath : string @description "The program file being read." = ""
    programEnv : Map string string @description "The NAME=value lines of the app.env beside the program file; empty when it has none." = {}
  }

  ;; Reads a review link's prebuilt program file (program/read resolve on its path) so the stage opens it without listing the catalog.
  trait ReviewProgramFile -> ReviewProgramFileView [server] {
    config {
      appsDir : string = "/srv/orb/apps"
        @label "Apps folder"
        @description "The folder every review program file lives under; the app.env beside a program file is read from its folder (a composer that moves it grants fs read on its own folder)."
        @tier "policy"
      integrations : "mock" | "live" = "mock"
        @label "Integrations"
        @description "How the review's program reaches real services when it opens: mock keeps its rows in its own store, live uses its declared store drivers."
        @tier "policy"
    }

    initial: idle

    state idle {
      LOAD_PROGRAM_FILE -> idle when (not (str/startsWith ?path (str/concat @config.appsDir "/")))
        (emit REVIEW_REFUSED { title: "This review could not be opened", message: (str/concat ?path " is not under " @config.appsDir) })
      LOAD_PROGRAM_FILE -> idle when (str/startsWith ?path (str/concat @config.appsDir "/"))
        (set @entity.programPath ?path)
        (set @entity.programEnv {})
        (os/read-file (str/concat @config.appsDir "/" (str/replace (str/join (array/dropLast (str/split ?path "/") 1) "/") (str/concat @config.appsDir "/") "") "/app.env") { emit: { success: PROGRAM_ENV_READ, failure: PROGRAM_ENV_UNREAD } })
      PROGRAM_ENV_READ -> idle
        (let ((lines (str/split (default (bytes/to-string ?data) "") "\n")))
          (set @entity.programEnv (object/fromEntries (array/map (array/filter (array/map @lines (fn l (str/trim @l))) (fn l (and (!= @l "") (not (str/startsWith @l "#")) (str/includes @l "=")))) (fn l (let ((parts (str/split @l "="))) [(str/trim (default (array/first @parts) "")) (str/join (array/drop @parts 1) "=")]))))))
        (program/read "" { resolve: true, text: false, path: @entity.programPath } { emit: { success: PROGRAM_FILE_READ, failure: PROGRAM_FILE_FAILED } })
      PROGRAM_ENV_UNREAD -> idle when (= (default ?kind "") "not-found")
        (program/read "" { resolve: true, text: false, path: @entity.programPath } { emit: { success: PROGRAM_FILE_READ, failure: PROGRAM_FILE_FAILED } })
      PROGRAM_ENV_UNREAD -> idle when (!= (default ?kind "") "not-found")
        (emit REVIEW_REFUSED { title: "This review could not be opened", message: (str/concat "app.env could not be read: " (default ?error "")) })
      PROGRAM_FILE_READ -> idle
        (emit REVIEW_PROGRAM { program: ?result.program, integrations: @config.integrations, env: @entity.programEnv })
      PROGRAM_FILE_FAILED -> idle
        (emit REVIEW_REFUSED { title: "This review could not be opened", message: (default ?error "") })
    }

    emits {
      REVIEW_PROGRAM -> external {
        program : ReviewProgram!
        integrations : "mock" | "live"!
        env : Map string string!
      }
        @description "The review link's prebuilt program, read and ready to open on the stage, with the env its app.env beside it declares (empty when it has none)."
      REVIEW_REFUSED -> external {
        title : string!
        message : string!
      }
        @description "The prebuilt program file could not be read."
    }

    listens {
      LOAD_PROGRAM_FILE -> input {
        path : string!
      }
        @description "Read this prebuilt program file."
      PROGRAM_ENV_READ {
        data : bytes!
      }
        @tier "internal"
      PROGRAM_ENV_UNREAD {
        error : string
        kind : string
      }
        @tier "internal"
      PROGRAM_FILE_READ {
        result : ReviewProgramRead!
      }
        @tier "internal"
      PROGRAM_FILE_FAILED {
        error : string
      }
        @tier "internal"
    }
  }

  trait ReviewIndex -> ReviewOpenerView [client] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main { type: container, size: md, padding: lg, children: [{ type: stack, direction: vertical, gap: md, children: (array/concat
          [{ type: typography, variant: h2, weight: bold, content: @config.title }]
          (array/map @config.reviews (fn r { type: button, variant: secondary, className: "justify-start", label: (str/concat @r.label " · " @r.version), icon: message-square, action: REVIEW_GO, actionPayload: { path: (str/concat "/review/" @r.name "/" @r.version) } }))) }] })
      REVIEW_GO -> idle
        (navigate ?path)
    }

    listens {
      REVIEW_GO {
        path : string!
      }
    }

    config {
      reviews : [ReviewLink] = []
        @label "Review links"
        @description "The review links listed."
        @tier "domain"
      title : string = "Reviews"
        @tier "presentation"
    }
  }

  page "/review/:name/:version" as ReviewPage -> ReviewOpener, ReviewPinsBoard
  page "/review" as ReviewIndexPage -> ReviewIndex
}
