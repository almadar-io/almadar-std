app std-orb-stats [
  version: "1.0.0",
  exec: ["orb", "ps"],
  env: ["PATH", "HOME"],
  description: "std-orb-stats — what the orb running this program reports about itself. ORB_STATS_ASK reads the kernel's counters with program/inputs { stats: true } (registeredSchemas, registeredTraits, activeInstances, cachedEntities) and answers ORB_KERNEL_READ { registeredSchemas, registeredTraits, activeInstances, cachedEntities }; every ask also reads the uptime of the orb process: os/pid gives the host process id and `ps -o etime= -p <pid>` runs through std-cli (the ps on PATH), its [[dd-]hh:]mm:ss answer is parsed to milliseconds and answered as ORB_UPTIME_READ { uptimeMs }, so the figure is the process's, not the session's or the first ask's; the first ask also runs `orb --version` through std-cli (the orb on PATH) and answers ORB_VERSION_READ { version } with the output trimmed; the version is read once per mount, and every later ask answers ORB_VERSION_READ again with it, so a client that joined later still gets it. A kernel read that the host refuses, a version run that exits non-zero or cannot start, a pid the host cannot give, a ps run that exits non-zero or cannot start, or an elapsed time that is not that format, answers ORB_STATS_FAILED { stat, code, error } (stat kernel, version or process-uptime) and the other stats are still answered. Subject-agnostic: it knows nothing of who asks.",
  egress: []
]
;; @capabilities "read the kernel counters, the process uptime and the version of the running orb"
uses Cli from "std/behaviors/std-cli"

type OrbKernelCounters = { registeredSchemas : number!, registeredTraits : number!, activeInstances : number!, cachedEntities : number! }
type OrbInputsRead = { stats : OrbKernelCounters! }

orbital OrbStatsOrbital {
  entity OrbStatsRun [runtime] {
    id : string!
    version : string = ""
    versionAsked : boolean = false
    uptimeSec : number? = null
  }

  trait OrbStatsReader -> OrbStatsRun {
    initial: ready

    state ready {
      INIT -> ready
      ORB_STATS_ASK -> ready when (not @entity.versionAsked)
        (set @entity.versionAsked true)
        (emit ORB_VERSION_RUN { stage: "version", argv: ["--version"] })
        (program/inputs { stats: true } { emit: { success: ORB_INPUTS, failure: ORB_INPUTS_FAILED } })
        (os/pid { key: "orb", emit: { success: ORB_PID, failure: ORB_PID_FAILED } })
      ORB_STATS_ASK -> ready when (and @entity.versionAsked (= @entity.version ""))
        (program/inputs { stats: true } { emit: { success: ORB_INPUTS, failure: ORB_INPUTS_FAILED } })
        (os/pid { key: "orb", emit: { success: ORB_PID, failure: ORB_PID_FAILED } })
      ORB_STATS_ASK -> ready when (!= @entity.version "")
        (emit ORB_VERSION_READ { version: @entity.version })
        (program/inputs { stats: true } { emit: { success: ORB_INPUTS, failure: ORB_INPUTS_FAILED } })
        (os/pid { key: "orb", emit: { success: ORB_PID, failure: ORB_PID_FAILED } })
      ORB_INPUTS -> ready
        (emit ORB_KERNEL_READ { registeredSchemas: ?result.stats.registeredSchemas, registeredTraits: ?result.stats.registeredTraits, activeInstances: ?result.stats.activeInstances, cachedEntities: ?result.stats.cachedEntities })
      ORB_INPUTS_FAILED -> ready
        (emit ORB_STATS_FAILED { stat: "kernel", code: "inputs_refused", error: ?error })
      ORB_PID -> ready
        (emit ORB_UPTIME_RUN { stage: "uptime", argv: ["-o", "etime=", "-p", (str/concat ?pid)] })
      ORB_PID_FAILED -> ready
        (emit ORB_STATS_FAILED { stat: "process-uptime", code: ?kind, error: ?error })
      ORB_UPTIME_DONE -> ready when (!= ?exitCode 0)
        (emit ORB_STATS_FAILED { stat: "process-uptime", code: "ps_exit", error: (str/concat "ps exited with code " ?exitCode ": " ?stderr) })
      ORB_UPTIME_DONE -> ready when (= ?exitCode 0)
        (set @entity.uptimeSec (let ((dp (str/split (str/trim ?stdout) "-"))) (let ((parts (str/split (default (array/last @dp) "") ":"))) (if (or (> (array/len @dp) 2) (> (array/len @parts) 3) (< (array/len @parts) 2) (array/some @parts (fn p (or (= (str/trim @p) "") (== (str/to-number @p) null))))) null (+ (* 86400 (if (= (array/len @dp) 2) (default (str/to-number (default (array/first @dp) "")) 0) 0)) (array/reduce @parts 0 (fn acc p (+ (* @acc 60) (default (str/to-number @p) 0)))))))))
        (emit ORB_UPTIME_PARSED {})
      ORB_UPTIME_PARSED -> ready when (= @entity.uptimeSec null)
        (emit ORB_STATS_FAILED { stat: "process-uptime", code: "unparsable", error: "the elapsed time ps printed is not [[dd-]hh:]mm:ss" })
      ORB_UPTIME_PARSED -> ready when (!= @entity.uptimeSec null)
        (emit ORB_UPTIME_READ { uptimeMs: (* 1000 @entity.uptimeSec) })
      ORB_UPTIME_FAILED -> ready
        (emit ORB_STATS_FAILED { stat: "process-uptime", code: ?code, error: ?error })
      ORB_VERSION_DONE -> ready when (= ?exitCode 0)
        (set @entity.version (str/trim ?stdout))
        (emit ORB_VERSION_READ { version: @entity.version })
      ORB_VERSION_DONE -> ready when (!= ?exitCode 0)
        (set @entity.versionAsked false)
        (emit ORB_STATS_FAILED { stat: "version", code: "orb_exit", error: (str/concat "orb --version exited with code " ?exitCode ": " ?stderr) })
      ORB_VERSION_FAILED -> ready
        (set @entity.versionAsked false)
        (emit ORB_STATS_FAILED { stat: "version", code: ?code, error: ?error })
    }

    emits {
      ORB_KERNEL_READ -> external {
        registeredSchemas : number!
        registeredTraits : number!
        activeInstances : number!
        cachedEntities : number!
      }
        @description "The kernel's counters: the schemas and traits registered, the trait instances running and the entities cached."
        @tier "domain"
      ORB_UPTIME_READ -> external {
        uptimeMs : number!
      }
        @description "How long the orb process has been running, from ps's elapsed time for its pid."
        @tier "domain"
      ORB_VERSION_READ -> external {
        version : string!
      }
        @description "What `orb --version` printed, trimmed."
        @tier "domain"
      ORB_STATS_FAILED -> external {
        stat : "kernel" | "version" | "process-uptime"!
        code : string!
        error : string!
      }
        @description "One stat could not be read: code is inputs_refused for the kernel read, orb_exit or ps_exit for a non-zero exit, unparsable for an elapsed time that is not [[dd-]hh:]mm:ss, or the host's or std-cli's failure code."
        @tier "domain"
      ORB_VERSION_RUN -> external {
        stage : string!
        argv : [string]!
      }
        @description "The `orb --version` run, handed to std-cli."
        @tier "internal"
      ORB_UPTIME_RUN -> external {
        stage : string!
        argv : [string]!
      }
        @description "The ps run for the orb process's elapsed time, handed to std-cli."
        @tier "internal"
      ORB_UPTIME_PARSED { }
        @description "Internal: the elapsed time was parsed."
        @tier "internal"
      ORB_INPUTS {
        result : OrbInputsRead!
      }
        @description "Internal: program/inputs' success."
        @tier "internal"
      ORB_INPUTS_FAILED {
        error : string!
      }
        @description "Internal: program/inputs' failure."
        @tier "internal"
    }

    listens {
      ORB_STATS_ASK -> input {
      }
        @description "Read the kernel counters, and the orb version the first time."
        @synonyms "orb stats, kernel counters, orb version"
      OrbVersionRunner.CLI_DONE -> ORB_VERSION_DONE
      OrbVersionRunner.CLI_FAILED -> ORB_VERSION_FAILED
      ORB_VERSION_DONE {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "std-cli's answer for the version run."
      ORB_VERSION_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "std-cli's failure for the version run."
      OrbUptimeRunner.CLI_DONE -> ORB_UPTIME_DONE
      OrbUptimeRunner.CLI_FAILED -> ORB_UPTIME_FAILED
      ORB_UPTIME_DONE {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stdoutBytes : bytes!
        stderr : string!
      }
        @description "std-cli's answer for the uptime run."
      ORB_UPTIME_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "std-cli's failure for the uptime run."
      ORB_PID {
        pid : number!
      }
        @description "os/pid's success."
      ORB_PID_FAILED {
        error : string!
        kind : string
      }
        @description "os/pid's failure."
      ORB_UPTIME_PARSED { }
        @description "The elapsed time was parsed."
      ORB_INPUTS {
        result : OrbInputsRead!
      }
        @description "program/inputs' success."
      ORB_INPUTS_FAILED {
        error : string!
      }
        @description "program/inputs' failure."
    }
  }

  trait OrbVersionRunner = Cli.traits.CliRunner {
    config {
      commands: ["orb"]
      passEnv: ["PATH", "HOME"]
    }
    listens {
      OrbStatsReader.ORB_VERSION_RUN -> CLI_RUN
    }
  }

  trait OrbUptimeRunner = Cli.traits.CliRunner {
    config {
      commands: ["ps"]
      passEnv: ["PATH"]
    }
    listens {
      OrbStatsReader.ORB_UPTIME_RUN -> CLI_RUN
    }
  }

  page boot as OrbStatsOrbitalStart -> OrbStatsReader, OrbVersionRunner, OrbUptimeRunner
}
