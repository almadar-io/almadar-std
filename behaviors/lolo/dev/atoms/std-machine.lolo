app std-machine [
  version: "1.0.0",
  description: "std-machine — a program's state machine as data. MACHINE_READ carries a resolved program (the .orb IR program/read answers once its imports are inlined) and MACHINE_ANSWERED returns one row per transition of every inline trait, orbital by orbital in declaration order. Transitions sharing a (from, event) are one group: with no guard anywhere in the group there is one row per distinct target and guarded is false; with any guard there is one row per arm and guarded says whether that arm carries its own. A transition whose from is a list of states joins the group of each listed state, in the listed order, and a trait with no transitions has no rows. Each row carries the payload slots its event declares (name, type, required, optional values and entity). The walk is bounded array maps in one event, no cascade."
]
;; @capabilities "state machine as data, transition rows, program machine, guarded transitions, payload slots"
uses Spec from "almadar-std/machine"

type MachineField = { name : string!, type : string!, required : boolean, values : [string], entity : string }
type MachineEventDecl = { key : string!, payloadSchema : [MachineField] }
type MachineArm = { from : (string | [string])!, event : string!, to : string!, guard : SExpr }
type MachineSources = [string]
type MachineGraph = { events : [MachineEventDecl], transitions : [MachineArm] }
type MachineTrait = { name : string!, stateMachine : MachineGraph }
type MachineOrbital = { name : string!, traits : [MachineTrait] }
type MachineProgram = { orbitals : [MachineOrbital]! }
type MachineSlot = { name : string!, type : string!, required : boolean!, values : [string], entity : string }
type MachineRow = { orbital : string!, trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, payload : [MachineSlot]! }

orbital MachineOrbital {
  entity MachineRun [runtime] {
    id : string!
    rows : [MachineRow]! = []
  }

  trait Machine -> MachineRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      MACHINE_READ -> ready when (= (json/parse (json/stringify @payload.program) MachineProgram) null)
        (emit MACHINE_UNREAD { })
      MACHINE_READ -> ready when (!= (json/parse (json/stringify @payload.program) MachineProgram) null)
        (set @entity.rows (array/flatten (array/map (object/get (json/parse (json/stringify @payload.program) MachineProgram) "orbitals") (fn o
          (array/flatten (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t
            (let ((sm (object/get @t "stateMachine")))
             (if (= @sm null) []
            (let ((arms (array/flatten (array/map (object/get @sm "transitions" []) (fn a
                          (array/map (let ((raw (object/get @a "from"))) (if (validate/array @raw) @raw [@raw])) (fn f
                            { from: @f, event: (object/get @a "event"), to: (object/get @a "to"), guarded: (object/has @a "guard") }))))))
                  (events (object/get @sm "events" [])))
              (array/flatten (array/map (array/unique (array/map @arms (fn a (str/concat (object/get @a "from") "\n" (object/get @a "event")))))
                (fn k
                  (let ((group (array/filter @arms (fn a (= (str/concat (object/get @a "from") "\n" (object/get @a "event")) @k)))))
                    (let ((picked (if (array/some @group (fn a (object/get @a "guarded")))
                                    @group
                                    (array/map (array/unique (array/map @group (fn a (object/get @a "to")))) (fn to (array/find @group (fn a (= (object/get @a "to") @to))))))))
                      (array/map @picked (fn a
                        { orbital: (object/get @o "name"), trait: (object/get @t "name"), from: (object/get @a "from"), event: (object/get @a "event"), to: (object/get @a "to"), guarded: (and (object/get @a "guarded") (array/some @group (fn g (object/get @g "guarded")))),
                          payload: (array/map (let ((decl (array/find @events (fn e (= (object/get @e "key") (object/get @a "event")))))) (if (= @decl null) [] (object/get @decl "payloadSchema" [])))
                            (fn p (let ((slot { name: (object/get @p "name"), type: (object/get @p "type"), required: (object/get @p "required" false) }))
                              (let ((withValues (if (object/has @p "values") (object/set @slot "values" (object/get @p "values")) @slot)))
                                (if (object/has @p "entity") (object/set @withValues "entity" (object/get @p "entity")) @withValues))))) })))))))))))))))))
        (emit MACHINE_ANSWERED { rows: @entity.rows })
    }

    emits {
      MACHINE_ANSWERED -> external { rows : [MachineRow]! }
        @description "The program's transition rows."
        @tier "domain"
      MACHINE_UNREAD -> external { }
        @description "The program did not have the shape of a resolved program, so no rows were read."
        @tier "domain"
    }

    listens {
      MACHINE_READ -> input { program : SExpr! }
        @description "Read a resolved program's state machine as rows."
        @synonyms "program machine, transitions of a program, state machine rows"
    }
  }

  page boot as MachineOrbitalStart -> Machine
}
