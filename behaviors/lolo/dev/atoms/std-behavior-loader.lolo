app std-behavior-loader [
  version: "1.0.0",
  description: "std-behavior-loader — opens one installed behavior to run it live: LOAD_BEHAVIOR { behavior, value } asks the substrate for its resolved program (behavior/resolve) and its knobs and trait names (behavior/describe), and answers BEHAVIOR_LOADED { behavior, program, knobs, traits } once both have answered, or BEHAVIOR_FAILED { behavior, error } when the resolved program could not be read. A refused describe does not fail the load: the knobs and trait names are empty. Opening never validates: a behavior that cannot run on its own fails when the host opens it, with the kernel's own reason.",
  egress: []
]
;; @capabilities "load an installed behavior's resolved program and knobs so it can run live"

type LoaderKnob = { name : string!, type : string!, label : string, description : string }
type LoaderTraitName = { trait : string! }
type LoaderOrbitalTraits = { traits : [LoaderTraitName]! }
type LoaderDescription = { behavior : string!, knobs : [LoaderKnob]!, orbitals : [LoaderOrbitalTraits]! }
type LoaderProgram = { name : string, orbitals : [orbital] }

orbital BehaviorLoaderOrbital {
  entity BehaviorLoad [runtime] {
    id : string!
    behavior : string = ""
    program : LoaderProgram? @description "The resolved program, as behavior/resolve answered it." = null
    knobs : [LoaderKnob] = []
    traits : [string] @description "The names of the behavior's traits, every orbital's in order, from behavior/describe." = []
    waiting : number @description "How many of the two answers (resolve, describe) are still to come." = 0
  }

  trait BehaviorLoader -> BehaviorLoad {
    initial: idle

    state idle {
      INIT -> idle
      LOAD_BEHAVIOR -> loading
        (set @entity.behavior ?behavior)
        (set @entity.program null)
        (set @entity.knobs [])
        (set @entity.traits [])
        (set @entity.waiting 2)
        (behavior/resolve ?value { emit: { success: RESOLVED, failure: LOAD_FAILED } })
        (behavior/describe { behavior: ?behavior } { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
    }

    state loading {
      INIT -> idle
      LOAD_BEHAVIOR -> loading
        (set @entity.behavior ?behavior)
        (set @entity.traits [])
        (set @entity.waiting 2)
        (behavior/resolve ?value { emit: { success: RESOLVED, failure: LOAD_FAILED } })
        (behavior/describe { behavior: ?behavior } { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
      RESOLVED -> loading
        (set @entity.program ?result)
        (emit LOAD_STEP {})
      DESCRIBED -> loading
        (set @entity.knobs (object/get ?result knobs []))
        (set @entity.traits (array/flatten (array/map ?result.orbitals (fn o (array/map @o.traits (fn t @t.trait))))))
        (emit LOAD_STEP {})
      DESCRIBE_FAILED -> loading
        (emit LOAD_STEP {})
      LOAD_STEP -> loading when (> @entity.waiting 1)
        (set @entity.waiting (- @entity.waiting 1))
      LOAD_STEP -> idle when (<= @entity.waiting 1)
        (set @entity.waiting 0)
        (let ((resolved @entity.program)) (if (= @resolved null) (emit BEHAVIOR_FAILED { behavior: @entity.behavior, error: "The resolved program did not arrive." }) (emit BEHAVIOR_LOADED { behavior: @entity.behavior, program: @resolved, knobs: @entity.knobs, traits: @entity.traits })))
      LOAD_FAILED -> idle
        (emit BEHAVIOR_FAILED { behavior: @entity.behavior, error: ?error })
    }

    emits {
      BEHAVIOR_LOADED -> external {
        behavior : string!
        program : LoaderProgram!
        knobs : [LoaderKnob]!
        traits : [string]!
      }
        @description "The opened behavior's resolved program, knobs and trait names."
      BEHAVIOR_FAILED -> external {
        behavior : string!
        error : string!
      }
        @description "The behavior could not be read or resolved."
      LOAD_STEP
      RESOLVED {
        result : LoaderProgram!
      }
      DESCRIBED {
        result : LoaderDescription!
      }
      DESCRIBE_FAILED {
        error : string!
      }
      LOAD_FAILED {
        error : string!
      }
    }

    listens {
      LOAD_BEHAVIOR -> input {
        behavior : string!
        value : behavior
      }
        @description "Load an installed behavior: its resolved program, knobs and trait names."
        @synonyms "open a behavior, load a behavior to run it live"
    }
  }

  page boot as BehaviorLoaderStart -> BehaviorLoader
}
