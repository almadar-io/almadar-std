app std-verify-judge [
  version: "1.0.0",
  description: "std-verify-judge — the kernel's verdict logic (orbital-core verify/observers.rs) as data. JUDGE_REQUEST carries one PlannedStep (std-verify-plan), the PlayedResult program/step answered for it, and the resolved program; JUDGE_ANSWERED returns the verdicts as the Rust Verdict {name, passed, detail} plus the classes not yet ported with their Rust reason. effects_fired mirrors the Rust rule: every effect of the played arm that failed is an offender, detail 'N offender(s): trait:event type(target) failed: error', and a step the planner left unplanned is not evidence. Ported-not-yet, listed in unported and never passed: proposition_held (judge_propositions evaluates each @ensures over entityBefore/entityAfter through the Rust Evaluator; .lolo has no expression-evaluate operator), entity_data_bound (a Layer 2 render-probe verdict over the rendered tree, not a step verdict), and the routed-http exemption of effects_fired (PlayedEffect carries no routed event)."
]
;; @capabilities "verify judge, verdicts, effects fired, proposition held, verifier verdict"
uses Spec from "almadar-std/verify-judge"

type JudgeText = { v : string }
type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type PlannedStep = { trait : string!, linkedEntity : string, from : string!, event : string!, to : string!, toStates : [string]!, variant : string!, payload : Map string JsonValue, guarded : boolean!, arm : number, solved : boolean!, payloadCase : string!, guardCase : string, unplanned : string }
type PlayedEffect = { type : string!, args : [JsonValue]!, status : string!, error : string }
type PlayedResult = { trait : string!, event : string!, transitionFired : boolean!, guard : string!, firedArm : number, effects : [PlayedEffect]!, emitted : [SExpr]!, guards : [SExpr]!, state : Map string JsonValue }
type Verdict = { name : string!, passed : boolean!, detail : string! }
type Unported = { name : string!, reason : string! }

orbital VerifyJudgeOrbital {
  entity JudgeRun [runtime] {
    id : string!
    verdicts : [Verdict]! = []
    unported : [Unported]! = []
  }

  trait Judge -> JudgeRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      JUDGE_REQUEST -> ready
        (let ((evidence (not (object/has @payload.step "unplanned")))
              (failed (array/filter (object/get @payload.played "effects" []) (fn e (= (object/get @e "status") "failed")))))
          (let ((offenders (array/map (array/filter @failed (fn e @evidence)) (fn e (str/concat (object/get @payload.played "trait") ":" (object/get @payload.played "event") " " (object/get @e "type") "(" (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth (object/get @e "args" []) (if (= (object/get @e "type") "persist") 1 0))) "}") JudgeText) "v") ") failed: " (object/get @e "error" "?"))))))
            (do (set @entity.verdicts [{ name: "effects_fired", passed: (= (array/len @offenders) 0), detail: (if (= (array/len @offenders) 0) "" (str/concat (array/len @offenders) " offender(s): " (str/join @offenders "; "))) }])
                (set @entity.unported [{ name: "proposition_held", reason: "judge_propositions evaluates each @ensures over entityBefore/entityAfter through the Rust Evaluator; .lolo has no expression-evaluate operator" }, { name: "entity_data_bound", reason: "Layer 2 render_probe verdict over the rendered tree (client/render_probe.rs), not a function of a program/step result" }, { name: "effects_fired.routed", reason: "Rust exempts an http failure routed to its declared emit.failure; PlayedEffect carries no routed event" }])
                (emit JUDGE_ANSWERED { verdicts: @entity.verdicts, unported: @entity.unported }))))
    }

    emits {
      JUDGE_ANSWERED -> external { verdicts : [Verdict]!, unported : [Unported]! }
        @description "The verdicts for one played step, and the classes not yet ported."
        @tier "domain"
    }

    listens {
      JUDGE_REQUEST -> external { step : PlannedStep!, played : PlayedResult!, program : SExpr }
        @description "Judge one played step against its planned step."
        @synonyms "verify judge, step verdict, effects fired, proposition held"
    }
  }

  page "/verify-judge" as VerifyJudgePage -> Judge
}
