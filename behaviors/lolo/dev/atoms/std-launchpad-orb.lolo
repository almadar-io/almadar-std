app std-launchpad-orb [
  version: "2.0.0",
  description: "std-launchpad-orb — the launchpad's Orb view: this machine as one orb with the programs around it as stars, redrawn each time ORB_STATE { machine, stars } arrives. The machine is the centre node, labelled with its own label (the host puts its CPU and memory there); a running or starting star sits on the first ring and its size grows with its weight in bytes (minSize plus scale times the square root of the megabytes, held between minSize and maxSize); its colour is the one the colours knob names for its kind (the host's mock and production), or the freshColor knob while it is starting, and a kind the knob does not name takes the graph's own palette; a stopped star hangs on the outer ring from a hub node labelled by the hubLabel knob, dimmed to stoppedColor at minSize. Clicking a star selects it and shows its actions: Open and Stop for a running or starting one (ORB_OPEN { id }, ORB_STOP { id }), Relaunch for a stopped one (ORB_RELAUNCH { id }); clicking the machine or the hub clears the selection, and a state that no longer holds the selected star clears it too. The layout is the graph view's radial one, so the rings are fixed by depth from the machine. The look comes from the theme's own tokens.",
  egress: []
]
;; @capabilities "draw this machine as an orb with the running programs as stars sized by memory, open stop or relaunch a program from its star"

type OrbMachine = { label : string!, detail : string! }
type OrbStar = { id : string!, label : string!, kind : string!, state : "starting" | "running" | "stopped"!, weight : number!, detail : string! }
type OrbNode = { id : string!, label : string!, group : string!, color : string!, size : number! }
type OrbEdge = { source : string!, target : string! }
type OrbClicked = { id : string!, label : string, group : string, size : number, color : string }

orbital LaunchpadOrbOrbital {
  entity OrbRun [runtime] {
    id : string!
    machine : OrbMachine?
    stars : [OrbStar] = []
    nodes : [OrbNode] = []
    edges : [OrbEdge] = []
    selected : string = ""
  }

  trait SystemOrb -> OrbRun {
    config {
      title : string = "Orb"
        @label "Title"
        @tier "presentation"
      hint : string = "Each star is a program: larger for more memory, coloured by how it runs. Click one to open, stop or relaunch it."
        @label "Hint"
        @tier "presentation"
      graphHeight : number = 380
        @label "Orb height"
        @description "Height of the orb in pixels."
        @tier "presentation"
      hubLabel : string = "recent"
        @label "Outer ring label"
        @description "The label of the node the stopped stars hang from."
        @tier "presentation"
      machineSize : number = 26
        @label "Machine size"
        @description "Radius of the centre node in pixels."
        @tier "presentation"
      minSize : number = 9
        @label "Smallest star"
        @description "Radius in pixels of a star with no weight, and of every stopped star."
        @tier "presentation"
      maxSize : number = 28
        @label "Largest star"
        @description "Radius in pixels no star grows past."
        @tier "presentation"
      scale : number = 1.4
        @label "Growth per square-root megabyte"
        @description "Pixels of radius added per square root of the megabytes of a star's weight."
        @tier "presentation"
      colors : Map string string = { production: "var(--color-success)", mock: "var(--color-info)" }
        @label "Colour of each kind"
        @description "The colour of a running star by its kind; a kind not named here takes the graph's own palette."
        @tier "presentation"
      freshColor : string = "var(--color-warning)"
        @label "Starting colour"
        @description "The colour of a star that is still starting."
        @tier "presentation"
      stoppedColor : string = "var(--color-muted-foreground)"
        @label "Stopped colour"
        @description "The colour of a stopped star and of the machine's outer ring."
        @tier "presentation"
      machineColor : string = "var(--color-primary)"
        @label "Machine colour"
        @tier "presentation"
    }
    initial: ready

    state ready {
      INIT -> ready
        (emit ORB_SHOWN {})
      ORB_SHOWN -> ready
        (render-ui main { type: stack, direction: vertical, gap: sm, children: [
          { type: stack, direction: horizontal, align: center, gap: sm, children: [
            { type: icon, name: orbit, size: md },
            { type: typography, content: @config.title, variant: h4, weight: semibold },
            { type: typography, content: (if (= @entity.machine null) "Reading the machine" @entity.machine.detail), variant: caption, color: muted }
          ] },
          { type: box, className: (if (= @entity.machine null) "hidden" ""), children: [{
            type: graph-view
            nodes: (array/map @entity.nodes (fn n { id: @n.id, label: @n.label, group: (if (= @n.id @entity.selected) "selected" @n.group), color: @n.color, size: @n.size }))
            edges: @entity.edges
            layout: radial
            height: @config.graphHeight
            showLabels: true
            zoomToFit: true
            onNodeClick: NODE_CLICK
          }] },
          { type: skeleton, variant: detail, rows: 4, className: (if (= @entity.machine null) "" hidden) },
          { type: stack, direction: horizontal, align: center, justify: between, gap: sm, className: (if (= @entity.selected "") "hidden" "flex-wrap"), children: [
            { type: typography, content: (if (= @entity.selected "") "" (str/concat (object/get (array/find @entity.stars (fn s (= @s.id @entity.selected))) "label" "") ": " (object/get (array/find @entity.stars (fn s (= @s.id @entity.selected))) "detail" ""))), variant: body, weight: medium },
            { type: stack, direction: horizontal, align: center, gap: sm, children: [
              { type: button, label: "Open", variant: secondary, size: sm, action: STAR_OPEN, actionPayload: { id: @entity.selected }, className: (if (array/some @entity.stars (fn s (and (= @s.id @entity.selected) (!= @s.state "stopped")))) "" hidden) },
              { type: button, label: "Stop", variant: ghost, size: sm, action: STAR_STOP, actionPayload: { id: @entity.selected }, className: (if (array/some @entity.stars (fn s (and (= @s.id @entity.selected) (!= @s.state "stopped")))) "" hidden) },
              { type: button, label: "Relaunch", variant: secondary, size: sm, action: STAR_RELAUNCH, actionPayload: { id: @entity.selected }, className: (if (array/some @entity.stars (fn s (and (= @s.id @entity.selected) (= @s.state "stopped")))) "" hidden) }
            ] }
          ] },
          { type: typography, content: @config.hint, variant: caption, color: muted }
        ] })
      ORB_STATE -> ready
        (set @entity.machine ?machine)
        (set @entity.stars ?stars)
        (set @entity.selected (if (array/some ?stars (fn s (= @s.id @entity.selected))) @entity.selected ""))
        (set @entity.nodes (array/concat [{ id: "machine", label: ?machine.label, group: "machine", color: @config.machineColor, size: @config.machineSize }] (array/concat (array/map ?stars (fn s { id: @s.id, label: @s.label, group: @s.kind, color: (if (= @s.state "stopped") @config.stoppedColor (if (= @s.state "starting") @config.freshColor (object/get @config.colors @s.kind ""))), size: (if (= @s.state "stopped") @config.minSize (math/clamp (+ @config.minSize (* @config.scale (or (math/sqrt (/ @s.weight 1048576)) 0))) @config.minSize @config.maxSize)) })) (if (array/some ?stars (fn s (= @s.state "stopped"))) [{ id: "hub", label: @config.hubLabel, group: "hub", color: @config.stoppedColor, size: @config.minSize }] []))))
        (set @entity.edges (array/concat (array/map (array/filter ?stars (fn s (!= @s.state "stopped"))) (fn s { source: "machine", target: @s.id })) (array/concat (if (array/some ?stars (fn s (= @s.state "stopped"))) [{ source: "machine", target: "hub" }] []) (array/map (array/filter ?stars (fn s (= @s.state "stopped"))) (fn s { source: "hub", target: @s.id })))))
        (emit ORB_SHOWN {})
      NODE_CLICK -> ready when (array/some @entity.stars (fn s (= @s.id ?node.id)))
        (set @entity.selected ?node.id)
        (emit ORB_SHOWN {})
      NODE_CLICK -> ready when (not (array/some @entity.stars (fn s (= @s.id ?node.id))))
        (set @entity.selected "")
        (emit ORB_SHOWN {})
      STAR_OPEN -> ready
        (emit ORB_OPEN { id: ?id })
      STAR_STOP -> ready
        (emit ORB_STOP { id: ?id })
      STAR_RELAUNCH -> ready
        (emit ORB_RELAUNCH { id: ?id })
    }

    emits {
      ORB_SHOWN { }
        @description "Internal: draw the orb."
        @tier "internal"
      ORB_OPEN -> external {
        id : string!
      }
        @description "A running star's Open was pressed."
        @tier "domain"
      ORB_STOP -> external {
        id : string!
      }
        @description "A running star's Stop was pressed."
        @tier "domain"
      ORB_RELAUNCH -> external {
        id : string!
      }
        @description "A stopped star's Relaunch was pressed."
        @tier "domain"
    }

    listens {
      ORB_STATE -> input {
        machine : OrbMachine!
        stars : [OrbStar]!
      }
        @description "Redraw the orb: the machine and the stars around it."
        @synonyms "draw the machine, show the running programs as stars"
      ORB_SHOWN { }
        @description "Self: draw the orb."
      NODE_CLICK {
        node : OrbClicked!
      }
        @description "A node of the graph was clicked."
      STAR_OPEN {
        id : string!
      }
      STAR_STOP {
        id : string!
      }
      STAR_RELAUNCH {
        id : string!
      }
    }
  }

  page "/orb" as LaunchpadOrbPage -> SystemOrb
}
