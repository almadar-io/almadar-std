app std-guest-session [
  version: "1.0.0",
  description: "std-guest-session — runs a program picked at run time as a guest session on the kernel, and paints it. GuestSession (server) resolves std-mock-page-seed as it mounts, and takes GUEST_OPEN { program } (a resolved program value, closing any guest already open), resolves std-mock-page-seed once, composes it with the program (program/compose, unless the program already declares the mock_seed_marks store) and opens the composed program with program/open, so the guest seeds each routed page's entities on its first visit inside its own kernel (EXEC-SEED-7), keeps the latest paint of every trait per slot (embedded children included) and emits GUEST_PAINTS { guest, paints } and GUEST_MOVED { guest, moves } (the transitions its traits took); a failed open is GUEST_ERROR { message }, a failed step is GUEST_NOTICE { message }, and GUEST_FAIL { message } lets the host that could not obtain a program say so the same way. GUEST_NAVIGATE { guest, route } opens that route in the guest with program/navigate. GUEST_SEND { guest, address, event, payload } steps the guest with program/dispatch when guest is the open one and is ignored for any other; GUEST_RESET closes it. GUEST_CLEARED tells the painter the guest is gone. GuestStage (client) keeps the paint, shows one guest-view for the configured slot holding the paint of every page-root trait in paint order (never an embedded child's; its source is the first root), and hands it every paint of the guest so an embedded @trait.X resolves to the guest's trait (a skeleton until the guest has painted, an alert when it failed) and turns a control of the guest it shows into GUEST_SEND. The host composes both traits under these names, supplies the program value, and embeds GuestStage inside its own chrome with @trait.GuestStage.",
  egress: [],
  kernel: { "guest": [spawn, declared] },
  env: ["FIREBASE_AUTH_EMULATOR_HOST", "FIREBASE_PROJECT_ID", "AUTH_PROVIDER", "ALMADAR_PERSONA_OWNS", "ORB_LAUNCHPAD_HOST"],
  fs: { "~/.almadar/launchpad/live/**": [read, write, create, remove, meta], cwd: "node_modules": [read] }
]
;; @capabilities "run a program chosen at run time as a live guest, paint it, forward its controls, close it"

uses Spec from "almadar-std/behavior-stage"
uses Marks from "std/behaviors/std-mock-seed-marks"

type GuestFsGrant = { glob : string!, modes : [string]! }
type GuestNetGrant = { target : string!, kinds : [string]! }
type GuestAnchorEnv = { env : string! }
type GuestAnchorRef = string | GuestAnchorNode
type GuestAnchorNode = { env : string?, literal : string?, anchor : GuestAnchorInner? }
type GuestAnchorInner = string | GuestAnchorEnv
type GuestAnchoredGrant = { anchor : GuestAnchorRef?, glob : string?, modes : [string]?, host : GuestAnchorRef?, port : GuestAnchorRef?, kinds : [string]? }
type GuestAnchoredGrants = { fs : [GuestAnchoredGrant]?, exec : [GuestAnchoredGrant]?, net : [GuestAnchoredGrant]? }
type GuestGrants = { fs : [GuestFsGrant]?, exec : [string]?, net : [GuestNetGrant]?, env : [string]?, sys : [string]?, stdio : [string]?, desktop : [string]?, kernel : [GuestNetGrant]?, anchored : GuestAnchoredGrants? }
type TokDensitySpacing = { space0 : string?, space1 : string?, space2 : string?, space3 : string?, space4 : string?, space5 : string?, space6 : string?, space7 : string?, space8 : string?, space9 : string?, space10 : string?, space11 : string?, space12 : string? }
type TokDensity = { spacing : TokDensitySpacing?, buttonHeightSm : string?, buttonHeightMd : string?, buttonHeightLg : string?, inputHeightSm : string?, inputHeightMd : string?, inputHeightLg : string?, rowHeightCompact : string?, rowHeightNormal : string?, rowHeightSpacious : string?, cardPaddingSm : string?, cardPaddingMd : string?, cardPaddingLg : string?, dialogPadding : string?, sectionGap : string? }
type TokTypeScaleScaleXs = { size : string?, lineHeight : string? }
type TokTypeScaleScaleSm = { size : string?, lineHeight : string? }
type TokTypeScaleScaleBase = { size : string?, lineHeight : string? }
type TokTypeScaleScaleLg = { size : string?, lineHeight : string? }
type TokTypeScaleScaleXl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN2xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN3xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN4xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleDisplay1 = { size : string?, lineHeight : string? }
type TokTypeScaleScaleDisplay2 = { size : string?, lineHeight : string? }
type TokTypeScaleScale = { xs : TokTypeScaleScaleXs?, sm : TokTypeScaleScaleSm?, base : TokTypeScaleScaleBase?, lg : TokTypeScaleScaleLg?, xl : TokTypeScaleScaleXl?, "2xl" : TokTypeScaleScaleN2xl?, "3xl" : TokTypeScaleScaleN3xl?, "4xl" : TokTypeScaleScaleN4xl?, display-1 : TokTypeScaleScaleDisplay1?, display-2 : TokTypeScaleScaleDisplay2? }
type TokTypeScaleIntentsHeadingMajor = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsHeadingMinor = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyEmphasis = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyDefault = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyQuiet = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsCaption = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsNumeric = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntents = { headingMajor : TokTypeScaleIntentsHeadingMajor?, headingMinor : TokTypeScaleIntentsHeadingMinor?, bodyEmphasis : TokTypeScaleIntentsBodyEmphasis?, bodyDefault : TokTypeScaleIntentsBodyDefault?, bodyQuiet : TokTypeScaleIntentsBodyQuiet?, caption : TokTypeScaleIntentsCaption?, numeric : TokTypeScaleIntentsNumeric? }
type TokTypeScale = { displayFamily : string?, bodyFamily : string?, monoFamily : string?, headingWeight : string?, headingTransform : string?, headingTracking : string?, headingStyle : string?, headingShadow : string?, scale : TokTypeScaleScale?, intents : TokTypeScaleIntents?, fontImport : string? }
type TokMotionDurations = { instant : string?, fast : string?, normal : string?, slow : string?, dramatic : string? }
type TokMotionEasings = { linear : string?, standard : string?, emphasized : string?, spring : string? }
type TokMotionIntentsEnter = { duration : string?, easing : string? }
type TokMotionIntentsExit = { duration : string?, easing : string? }
type TokMotionIntentsHover = { duration : string?, easing : string? }
type TokMotionIntentsPress = { duration : string?, easing : string? }
type TokMotionIntentsExpand = { duration : string?, easing : string? }
type TokMotionIntentsTransition = { duration : string?, easing : string? }
type TokMotionIntents = { enter : TokMotionIntentsEnter?, exit : TokMotionIntentsExit?, hover : TokMotionIntentsHover?, press : TokMotionIntentsPress?, expand : TokMotionIntentsExpand?, transition : TokMotionIntentsTransition? }
type TokMotionShapes = { modalEnter : string?, modalExit : string?, popoverEnter : string?, popoverExit : string?, toastEnter : string?, toastExit : string?, pageEnter : string?, enterRise : string?, enterScale : string?, enterSlide : string? }
type TokMotionEntry = { default : string?, stagger : string? }
type TokMotion = { durations : TokMotionDurations?, easings : TokMotionEasings?, intents : TokMotionIntents?, shapes : TokMotionShapes?, entry : TokMotionEntry?, busyDelay : string?, awaitingSkeleton : boolean? }
type TokIconography = { family : string?, strokeWidth : string?, defaultSize : string? }
type TokElevation = { cardElevation : string?, popoverElevation : string?, dialogElevation : string?, toastElevation : string?, interactiveElevation : string?, pressedElevation : string? }
type TokGeometry = { radiusContainer : string?, radiusInteractive : string?, radiusPill : string?, borderHairline : string?, borderStandard : string?, borderHeavy : string?, cornerShape : string?, cornerShapePill : string?, cornerShapeInteractive : string?, borderStyle : string?, borderStyleInteractive : string? }
type TokIllustration = { loadingAsset : string?, style : string? }
type TokSurface = { backdrop : string?, cardImage : string?, pageImage : string?, pageImageSize : string?, diagram : string?, edgeMask : string?, edgeHeight : string?, textureMask : string?, textureSize : string?, accentImage : string?, scrim : string? }
type TokDiagram = { strokeThin : string?, strokeNormal : string?, strokeBold : string?, lineCap : string?, lineJoin : string?, dash : string?, dot : string?, fillStyle : string?, fillOpacity : string?, roughness : string?, glow : string?, shadow : string?, marker : string?, labelFont : string?, labelSize : string?, labelWeight : string?, labelCase : string?, corner : string? }
type TokScene = { materialRoughness : string?, materialMetalness : string?, materialFlat : string?, materialOutline : string?, lightAmbient : string?, lightKey : string?, lightKeyColor : string?, fog : string? }
type ThemeTokens = { color : (Map string string)?, colors : (Map string string)?, radii : (Map string string)?, spacing : (Map string string)?, typography : (Map string string)?, shadows : (Map string string)?, density : TokDensity?, typeScale : TokTypeScale?, motion : TokMotion?, iconography : TokIconography?, elevation : TokElevation?, geometry : TokGeometry?, illustration : TokIllustration?, surface : TokSurface?, diagram : TokDiagram?, scene : TokScene? }
type GuestThemeDefinition = { name : string!, displayName : string?, tokens : ThemeTokens!, variants : (Map string ThemeTokens)? }
type GuestTheme = string | GuestThemeDefinition
type GuestProgram = { name : string, version : string?, description : string?, store : string?, inbound : [string]?, egress : [string]?, osGrants : GuestGrants?, schemaVersion : number?, theme : GuestTheme?, orbitals : [orbital] }
type GuestHeader = { name : string!, version : string?, description : string?, store : string?, inbound : [string]?, egress : [string]?, osGrants : GuestGrants?, schemaVersion : number? }
type GuestEnvStatus = { name : string!, set : boolean!, tail : string! }
type GuestEnvValue = { name : string!, value : string? }
type GuestCredentialStatus = { name : string!, set : boolean!, tail : string! }
type GuestDenial = { message : string!, count : number! }
type GuestRevealSource = "environment" | "credentials"
type GuestReach = "mock" | "live"
type GuestGrantRow = { kind : string!, declared : [string]!, effective : [string]!, missing : [string]! }
type GuestRevealed = { name : string!, via : GuestRevealSource!, value : string? }
type GuestTraceInputs = { environment : [GuestEnvStatus]!, grants : GuestGrants?, credentials : [GuestCredentialStatus]?, computedCredentials : [string]?, denials : [GuestDenial]?, inputs : [GuestInput]? }
type GuestInputField = { name : string!, type : string }
type GuestInput = { address : string!, event : string!, payloadSchema : [GuestInputField] }
type GuestRevealInputs = { environment : GuestEnvValue?, credentials : GuestEnvValue? }
type GuestPaint = { slot : string!, trait : string!, orbital : string?, embedded : boolean!, content : node? }
type GuestMove = { trait : string!, event : string?, from : string!, to : string!, fired : boolean! }
type GuestOpened = { guest : string!, page : [string]!, route : string, rendered : [GuestPaint]!, outcomes : [GuestMove]! }
type GuestAccess = { verdict : string!, signIn : string, returnTo : string, viewer : string }
type GuestNavigated = { page : [string]!, route : string, rendered : [GuestPaint]!, outcomes : [GuestMove]!, access : GuestAccess }
type GuestStepped = { rendered : [GuestPaint]!, outcomes : [GuestMove]! }
type GuestClosed = { closed : boolean! }
type GuestPersonaOption = { id : string!, name : string, role : string }
type GuestPersonasReply = { success : boolean, personas : [GuestPersonaOption] }
type GuestEmittedPayload = { reason : string }
type GuestTextPayload = { body : string, subject : string, error : string }
type GuestEmitted = { event : string!, payload : GuestEmittedPayload? }
type GuestAnswered = { emitted : [GuestEmitted]?, outcomes : [GuestMove]? }

orbital GuestSessionOrbital {
  entity GuestRun [runtime] {
    id : string!
    guestHandle : string = ""
    guestPaints : [GuestPaint] = []
    guestRoute : string @description "The route the guest shows, as program/open or program/navigate resolved it; empty when no page matched." = ""
    guestPage : [string] @description "The traits of the page the guest shows: its page-root paints are the ones drawn." = []
    guestError : string = ""
    guestSigningIn : boolean @description "A credential was handed to the guest and its CREDENTIAL_BOUND or CREDENTIAL_REFUSED has not arrived yet." = false
    guestReturnTo : string @description "The page a denied guest asked for, opened again once it has signed in." = ""
    guestProgram : GuestProgram? @description "The program value being opened, held only until program/compose or program/open takes it: the entity rides every request a stateless host's client posts."
    guestSeed : behavior?
    guestSeeded : boolean @description "Whether the catalog composed std-mock-page-seed into the open guest, so its seeder answers the personas it wrote." = false
    guestPersonaTrait : string @description "The guest's trait that lists personas and signs its session in as one (std-mock-seed-marks personaTrait); persona asks name it, since it may sit on a page the guest has not mounted." = ""
    guestDefaultRole : string @description "The role the open guest is signed in as when it opens: the first declared value of its [identity] entity's role field (std-mock-seed-marks defaultRole); empty without one." = ""
    guestPersona : string @description "The persona the guest's session was last signed in as by a pick: an identity row id; empty until one is picked." = ""
    guestPersonas : [GuestPersonaOption] @description "The personas the guest's std-dev-personas listed, shown by the stage as its picker." = []
    guestPaintSeq : number @description "How many paints the session has handed on, so the stage keeps the newest when concurrent answers fold out of order (EXEC-CONC-8)." = 0
    guestPick : "mock" | "live" @description "The integrations the viewer just picked, held while the server checks it may honour them." = "mock"
    guestPickFor : string @description "The guest the pending integrations pick is for." = ""
    guestHeader : GuestHeader? @description "The open program's app header (everything but its orbitals), kept at GUEST_OPEN so the trace sidebar can show what the program declares."
    guestTraceFor : string @description "The guest the pending trace read is for." = ""
    guestRevealName : string @description "The environment name the pending reveal is for." = ""
    guestRevealFor : string @description "The guest the pending reveal is for." = ""
    guestRevealSource : GuestRevealSource @description "Whether the pending reveal reads an environment name or a credential." = environment
    guestIntegrations : "mock" | "live" @description "How the guest reaches real services: mock opens it with no credentials and every row in its own store, live with the opener's credentials and its declared store drivers (program/open integrations)." = mock
  }

  entity GuestStageRun [runtime] {
    id : string!
    guestSignInAsked : boolean @description "The guest asked its viewer to sign in and the stage's sign-in button has not been pressed since." = false
    guestHandle : string = ""
    guestPaints : [GuestPaint] = []
    guestRoute : string @description "The route the guest shows, as program/open or program/navigate resolved it; empty when no page matched." = ""
    guestPage : [string] @description "The traits of the page the guest shows: its page-root paints are the ones drawn." = []
    guestError : string = ""
    guestPersonas : [GuestPersonaOption] @description "The personas the guest's std-dev-personas listed, shown by the stage as its picker." = []
    guestPersona : string @description "The persona the guest's session was last signed in as by a pick: an identity row id; empty until one is picked." = ""
    guestPaintSeq : number @description "How many paints the session has handed on, so the stage keeps the newest when concurrent answers fold out of order (EXEC-CONC-8)." = 0
    guestIntegrations : "mock" | "live" @description "How the guest reaches real services: mock opens it with no credentials and every row in its own store, live with the opener's credentials and its declared store drivers (program/open integrations)." = mock
    guestHeader : GuestHeader? @description "The app header the session answered (everything but its orbitals), the trace sidebar shows it."
    guestTheme : GuestTheme? @description "The theme the open program declares (its app theme: a key or an inline definition); the guest paints inside it, never in the opener's theme."
    guestTraceOpen : boolean @description "Whether the stage shows the trace sidebar." = false
    guestWorkdir : string @description "The folder the live guest runs in; empty while its rows live in its own memory." = ""
    guestEnvironment : [GuestEnvStatus] @description "The environment names the guest holds, whether each is set and its last four characters; never a value." = []
    guestCredentials : [GuestCredentialStatus] @description "The credential slots the guest's program declares, whether each is set and its last four characters; never a value." = []
    guestComputedCredentials : [string] @description "The credential slots whose names are only known at run time." = []
    guestTraceAnswered : boolean @description "Whether the trace on show is the kernel's answer for this guest, not the state before it arrived." = false
    guestDenials : [GuestDenial] @description "What the guest was refused, each message with how many times." = []
    guestGrantRows : [GuestGrantRow] @description "Per grant kind, what the program declares and what the guest really holds." = []
    guestInputs : [GuestInput] @description "The external inputs the open guest declares, for the trace sidebar's Inputs list." = []
    guestInputPick : string @description "The address of the input the viewer is composing a payload for." = ""
    guestInputText : string @description "The payload text, JSON, of the input being composed." = ""
    guestRevealed : [GuestRevealed] @description "The values the viewer revealed, held by the stage until the sidebar closes or the guest changes." = []
  }

  trait GuestMarks = Marks.traits.MarksCheck {
    listens {
      GuestSession.GUEST_SEED_ASK -> MARKS_CHECK
    }
  }

  trait GuestSession -> GuestRun {
    config {
      seedTrait : string = "MockDataMockSeed"
        @label "Seeder trait"
        @description "The composed std-mock-page-seed trait (MockData's MockSeed) the guest asks for the personas it seeded."
        @tier "internal"
      integrationsRefused : string = "Real integrations are only available when the launchpad runs on this machine."
        @label "Real integrations refused"
        @description "Shown when the viewer asks for real integrations on a launchpad bound beyond loopback."
        @tier "domain"
      revealRefused : string = "Revealing values is only available when the launchpad runs on this machine."
        @label "Reveal refused"
        @description "Shown when the viewer asks to reveal an environment value on a launchpad bound beyond loopback."
        @tier "domain"
      mockAuthHost : string = "127.0.0.1:9099"
        @label "Auth emulator a mocked guest signs its personas in through"
        @tier "policy"
      liveAuthProvider : string = "firebase"
        @label "Sign-in provider a live guest verifies its viewers against (AUTH_PROVIDER)"
        @tier "policy"
      mockAuthProject : string = "demo-almadar"
        @label "Auth project of a mocked guest"
        @tier "policy"
      signInNeeded : string = "This page needs a signed-in viewer. Pick a persona to open it."
        @label "Notice when a mocked guest is denied a page"
        @tier "domain"
      signInRefused : string = "That sign-in was not accepted by this behavior."
        @label "Notice when a guest refuses a signed-in credential"
        @tier "policy"
      signInReason : string = "Reason:"
        @label "Prefix of the reason a guest gives for refusing a credential"
        @tier "policy"
      liveRoot : string = "~/.almadar/launchpad/live"
        @label "Live guest folders"
        @description "The directory holding one folder per program opened with real integrations; that folder is the guest's working directory, so its relative file stores never meet another program's."
        @tier "policy"
      guestEnv : [string] = ["FIREBASE_AUTH_EMULATOR_HOST", "FIREBASE_PROJECT_ID", "ALMADAR_PERSONA_OWNS"]
        @label "Guest environment"
        @description "The environment variables a guest may read, passed as its env grant at program/open: the Auth emulator host its persona sign-in checks and the persona-owns list its seeder reads. The orbital's own env grant covers them."
        @tier "policy"
    }

    initial: idle

    state idle {
      INIT -> idle when (= @entity.guestSeed null)
        (behavior/resolve { behavior: "std/behaviors/std-mock-page-seed" } {} { emit: { success: GUEST_SEED_RESOLVED, failure: GUEST_SEED_FAILED } })
      INIT -> idle when (!= @entity.guestSeed null)
      GUEST_OPEN -> opening
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
        (set @entity.guestProgram ?program)
        (set @entity.guestHeader (as (object/omit ?program ["orbitals"]) GuestHeader))
        (when (!= ?program.theme null) (emit GUEST_THEME { theme: ?program.theme }))
        (set @entity.guestPersona "")
        (emit GUEST_PREPARE {})
      GUEST_FAIL -> idle
        (emit GUEST_ERROR { message: ?message })
      GUEST_RESET -> idle
        (emit GUEST_CLEARED {})
      GUEST_REACH -> idle
        (set @entity.guestIntegrations ?integrations)
      GUEST_OPENED -> idle
        (program/close ?result.guest { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
      GUEST_FAILED -> idle
      GUEST_TICKED -> idle
      GUEST_TICKS_FAILED -> idle
      GUEST_CLOSED -> idle
      GUEST_CLOSE_FAILED -> idle
      GUEST_PREPARE -> idle
      GUEST_SEED_RESOLVED -> idle
        (set @entity.guestSeed ?result)
      GUEST_SEED_FAILED -> idle
      GUEST_SEED_MARKED -> idle
      GUEST_PERSONAS_RESOLVED -> idle
      GUEST_COMPOSED -> idle
      GUEST_LIVE_DIR_READY -> idle
      GUEST_LIVE_CHECKED -> idle
      GUEST_LIVE_TARGET -> idle
      GUEST_LIVE_LINKED -> idle
      GUEST_PERSONAS_ASK -> idle
      GUEST_NAVIGATE -> idle
        (program/navigate { guest: ?guest, route: ?route } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_SEND -> idle
        (program/dispatch ?address ?payload { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_INPUT_SEND -> idle
        (program/dispatch ?address ?text { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_PERSONA_PICK -> idle
        (program/dispatch (if (= @entity.guestPersonaTrait "") "PERSONA_ACT_AS" (str/concat @entity.guestPersonaTrait ".PERSONA_ACT_AS")) { persona: ?persona } { guest: ?guest, emit: { success: GUEST_PERSONA_ACTED, failure: GUEST_STEP_FAILED } })
      GUEST_NAVIGATED -> idle
      GUEST_NAVIGATE_FAILED -> idle
      GUEST_STEPPED -> idle
      GUEST_STEP_FAILED -> idle
      GUEST_INTEGRATIONS_PICK -> idle
        (set @entity.guestPick ?integrations)
        (set @entity.guestPickFor ?guest)
        (os/getenv "ORB_LAUNCHPAD_HOST" { key: "guest-pick", emit: { success: GUEST_PICK_READ, failure: GUEST_PICK_FAILED } })
      GUEST_PICK_READ -> idle when (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value "")))
        (set @entity.guestIntegrations @entity.guestPick)
        (emit GUEST_INTEGRATIONS { guest: "", integrations: @entity.guestIntegrations })
      GUEST_PICK_READ -> idle when (not (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value ""))))
        (emit GUEST_NOTICE { message: @config.integrationsRefused })
      GUEST_PICK_FAILED -> idle
        (emit GUEST_NOTICE { message: @config.integrationsRefused })
      GUEST_TRACE_ASK -> idle
        (set @entity.guestTraceFor ?guest)
        (program/inputs { guest: ?guest, environment: true, credentials: true, denials: true } { emit: { success: GUEST_TRACE_READ, failure: GUEST_TRACE_FAILED } })
      GUEST_TRACE_READ -> idle
      GUEST_TRACE_FAILED -> idle
      GUEST_TRACE_REVEAL -> idle
        (set @entity.guestRevealName ?name)
        (set @entity.guestRevealSource ?via)
        (set @entity.guestRevealFor ?guest)
        (os/getenv "ORB_LAUNCHPAD_HOST" { key: "guest-reveal", emit: { success: GUEST_REVEAL_READ, failure: GUEST_REVEAL_FAILED } })
      GUEST_REVEAL_READ -> idle
      GUEST_REVEAL_FAILED -> idle
      GUEST_REVEAL_ANSWERED -> idle
      GUEST_REVEAL_DENIED -> idle
    }

    state opening {
      INIT -> idle
      GUEST_OPEN -> opening
        (emit GUEST_CLEARED {})
        (set @entity.guestProgram ?program)
        (set @entity.guestHeader (as (object/omit ?program ["orbitals"]) GuestHeader))
        (when (!= ?program.theme null) (emit GUEST_THEME { theme: ?program.theme }))
        (set @entity.guestPersona "")
        (emit GUEST_PREPARE {})
      GUEST_OPENED -> live
        (set @entity.guestHandle ?result.guest)
        (set @entity.guestPage ?result.page)
        (set @entity.guestRoute (default ?result.route ""))
        (set @entity.guestPaints (array/reduce ?result.rendered [] (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (set @entity.guestPaintSeq (+ @entity.guestPaintSeq 1))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints, seq: @entity.guestPaintSeq })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
        (emit GUEST_PERSONAS_ASK {})
        (emit GUEST_INTEGRATIONS { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (emit GUEST_READY { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (program/live { kind: "guest", guest: ?result.guest } { key: (str/concat "guest-ticks-" ?result.guest), emit: { onMessage: GUEST_TICKED, failure: GUEST_TICKS_FAILED } })
      GUEST_FAILED -> idle
        (emit GUEST_ERROR { message: ?error })
      GUEST_PREPARE -> opening when (= @entity.guestIntegrations "live")
        (os/mkdir (str/concat @config.liveRoot "/" (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest")) true { key: "guest-live-dir", emit: { success: GUEST_LIVE_DIR_READY, failure: GUEST_FAILED } })
      GUEST_LIVE_DIR_READY -> opening
        (os/exists (str/concat @config.liveRoot "/" (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest") "/node_modules") { key: "guest-live-link", emit: { success: GUEST_LIVE_CHECKED, failure: GUEST_FAILED } })
      GUEST_LIVE_CHECKED -> opening when (not @payload.ok)
        (os/realpath { anchor: "cwd", path: "node_modules" } { key: "guest-live-target", emit: { success: GUEST_LIVE_TARGET, failure: GUEST_FAILED } })
      GUEST_LIVE_TARGET -> opening
        (os/symlink @payload.path (str/concat @config.liveRoot "/" (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest") "/node_modules") { key: "guest-live-link", emit: { success: GUEST_LIVE_LINKED, failure: GUEST_FAILED } })
      GUEST_LIVE_CHECKED -> opening when @payload.ok
        (set @entity.guestSeeded false)
        (program/open @entity.guestProgram { declared: true, integrations: "live", env: { AUTH_PROVIDER: @config.liveAuthProvider }, cwd: (str/concat @config.liveRoot "/" (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest")) } { emit: { success: GUEST_OPENED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_LIVE_LINKED -> opening
        (set @entity.guestSeeded false)
        (program/open @entity.guestProgram { declared: true, integrations: "live", env: { AUTH_PROVIDER: @config.liveAuthProvider }, cwd: (str/concat @config.liveRoot "/" (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest")) } { emit: { success: GUEST_OPENED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_PREPARE -> opening when (and (= @entity.guestIntegrations "mock") (= @entity.guestSeed null))
        (behavior/resolve { behavior: "std/behaviors/std-mock-page-seed" } {} { emit: { success: GUEST_SEED_RESOLVED, failure: GUEST_FAILED } })
      GUEST_SEED_RESOLVED -> opening when (= @entity.guestSeed null)
        (set @entity.guestSeed ?result)
        (emit GUEST_PREPARE {})
      GUEST_SEED_RESOLVED -> opening when (!= @entity.guestSeed null)
      GUEST_SEED_FAILED -> opening
      GUEST_PREPARE -> opening when (and (= @entity.guestIntegrations "mock") (!= @entity.guestSeed null))
        (emit GUEST_SEED_ASK { program: @entity.guestProgram })
      GUEST_SEED_MARKED -> opening when @payload.marked
        (set @entity.guestSeeded false)
        (set @entity.guestDefaultRole (default @payload.defaultRole ""))
        (set @entity.guestPersonaTrait (default @payload.personaTrait ""))
        (program/open @entity.guestProgram { grants: { env: @config.guestEnv }, env: { FIREBASE_AUTH_EMULATOR_HOST: @config.mockAuthHost, FIREBASE_PROJECT_ID: @config.mockAuthProject }, declared: true, integrations: @entity.guestIntegrations } { emit: { success: GUEST_OPENED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_SEED_MARKED -> opening when (and (not @payload.marked) (!= @payload.personasCollection ""))
        (set @entity.guestSeeded true)
        (set @entity.guestDefaultRole (default @payload.defaultRole ""))
        (set @entity.guestPersonaTrait (default @payload.personaTrait ""))
        (behavior/resolve (behavior/apply { behavior: "std/behaviors/std-dev-personas", orbital: "DevPersonasOrbital" } { entity: "DevPersona", persistence: "persistent", collection: @payload.personasCollection, traits: { DevPersonas: { config: { autoSignIn: @payload.personasSignIn } } } }) {} { emit: { success: GUEST_PERSONAS_RESOLVED, failure: GUEST_FAILED } })
      GUEST_PERSONAS_RESOLVED -> opening
        (program/compose [@entity.guestProgram, @entity.guestSeed, ?result] { appName: (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest") } { emit: { success: GUEST_COMPOSED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_SEED_MARKED -> opening when (and (not @payload.marked) (= @payload.personasCollection ""))
        (set @entity.guestSeeded true)
        (set @entity.guestDefaultRole (default @payload.defaultRole ""))
        (set @entity.guestPersonaTrait (default @payload.personaTrait ""))
        (program/compose [@entity.guestProgram, @entity.guestSeed] { appName: (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest") } { emit: { success: GUEST_COMPOSED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_COMPOSED -> opening
        (program/open ?result { grants: { env: @config.guestEnv }, env: { FIREBASE_AUTH_EMULATOR_HOST: @config.mockAuthHost, FIREBASE_PROJECT_ID: @config.mockAuthProject }, declared: true, integrations: @entity.guestIntegrations } { emit: { success: GUEST_OPENED, failure: GUEST_FAILED } })
      GUEST_FAIL -> idle
        (emit GUEST_ERROR { message: ?message })
      GUEST_RESET -> idle
        (emit GUEST_CLEARED {})
      GUEST_REACH -> opening
        (set @entity.guestIntegrations ?integrations)
      GUEST_TICKED -> opening
      GUEST_TICKS_FAILED -> opening
      GUEST_CLOSED -> opening
      GUEST_CLOSE_FAILED -> opening
      GUEST_PERSONAS_STEPPED -> opening
      GUEST_PERSONAS_FAILED -> opening
      GUEST_PERSONA_ACTED -> opening
      GUEST_NAVIGATE -> opening
        (program/navigate { guest: ?guest, route: ?route } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_SEND -> opening
        (program/dispatch ?address ?payload { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_INPUT_SEND -> opening
        (program/dispatch ?address ?text { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_PERSONA_PICK -> opening
        (program/dispatch (if (= @entity.guestPersonaTrait "") "PERSONA_ACT_AS" (str/concat @entity.guestPersonaTrait ".PERSONA_ACT_AS")) { persona: ?persona } { guest: ?guest, emit: { success: GUEST_PERSONA_ACTED, failure: GUEST_STEP_FAILED } })
      GUEST_NAVIGATED -> opening
      GUEST_NAVIGATE_FAILED -> opening
      GUEST_STEPPED -> opening
      GUEST_STEP_FAILED -> opening
      GUEST_INTEGRATIONS_PICK -> opening
        (set @entity.guestPick ?integrations)
        (set @entity.guestPickFor ?guest)
        (os/getenv "ORB_LAUNCHPAD_HOST" { key: "guest-pick", emit: { success: GUEST_PICK_READ, failure: GUEST_PICK_FAILED } })
      GUEST_PICK_READ -> opening when (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value "")))
        (set @entity.guestIntegrations @entity.guestPick)
        (emit GUEST_INTEGRATIONS { guest: "", integrations: @entity.guestIntegrations })
      GUEST_PICK_READ -> opening when (not (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value ""))))
        (emit GUEST_NOTICE { message: @config.integrationsRefused })
      GUEST_PICK_FAILED -> opening
        (emit GUEST_NOTICE { message: @config.integrationsRefused })
      GUEST_TRACE_ASK -> opening
        (set @entity.guestTraceFor ?guest)
        (program/inputs { guest: ?guest, environment: true, credentials: true, denials: true } { emit: { success: GUEST_TRACE_READ, failure: GUEST_TRACE_FAILED } })
      GUEST_TRACE_READ -> opening
      GUEST_TRACE_FAILED -> opening
      GUEST_TRACE_REVEAL -> opening
        (set @entity.guestRevealName ?name)
        (set @entity.guestRevealSource ?via)
        (set @entity.guestRevealFor ?guest)
        (os/getenv "ORB_LAUNCHPAD_HOST" { key: "guest-reveal", emit: { success: GUEST_REVEAL_READ, failure: GUEST_REVEAL_FAILED } })
      GUEST_REVEAL_READ -> opening
      GUEST_REVEAL_FAILED -> opening
      GUEST_REVEAL_ANSWERED -> opening
      GUEST_REVEAL_DENIED -> opening
    }

    state live {
      INIT -> idle
      GUEST_OPEN -> opening
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle "")
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
        (set @entity.guestProgram ?program)
        (set @entity.guestHeader (as (object/omit ?program ["orbitals"]) GuestHeader))
        (when (!= ?program.theme null) (emit GUEST_THEME { theme: ?program.theme }))
        (set @entity.guestPersona "")
        (emit GUEST_PREPARE {})
      GUEST_OPENED -> live
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle ?result.guest)
        (set @entity.guestPage ?result.page)
        (set @entity.guestRoute (default ?result.route ""))
        (set @entity.guestPaints (array/reduce ?result.rendered [] (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (set @entity.guestPaintSeq (+ @entity.guestPaintSeq 1))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints, seq: @entity.guestPaintSeq })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
        (emit GUEST_PERSONAS_ASK {})
        (emit GUEST_INTEGRATIONS { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (emit GUEST_READY { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (program/live { kind: "guest", guest: ?result.guest } { key: (str/concat "guest-ticks-" ?result.guest), emit: { onMessage: GUEST_TICKED, failure: GUEST_TICKS_FAILED } })
      GUEST_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_PREPARE -> live
      GUEST_SEED_RESOLVED -> live
      GUEST_SEED_FAILED -> live
      GUEST_SEED_MARKED -> live
      GUEST_PERSONAS_RESOLVED -> live
      GUEST_COMPOSED -> live
      GUEST_LIVE_DIR_READY -> live
      GUEST_LIVE_CHECKED -> live
      GUEST_LIVE_TARGET -> live
      GUEST_LIVE_LINKED -> live
      GUEST_PERSONAS_ASK -> live
        (program/dispatch (if @entity.guestSeeded (str/concat @config.seedTrait ".SEED_PERSONAS_ASK") (if (= @entity.guestPersonaTrait "") "PERSONAS_REQUESTED" (str/concat @entity.guestPersonaTrait ".PERSONAS_REQUESTED"))) {} { guest: @entity.guestHandle, emit: { success: GUEST_PERSONAS_STEPPED, failure: GUEST_PERSONAS_FAILED } })
      GUEST_PERSONAS_STEPPED -> live when (and (= @entity.guestPersona "") (!= @entity.guestDefaultRole "") (array/some (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (as (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") GuestTextPayload) {}) "body") "") GuestPersonasReply) {}) "personas") []))) (fn r (= (object/get @r "role" "") @entity.guestDefaultRole))))
        (set @entity.guestPersonas (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (as (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") GuestTextPayload) {}) "body") "") GuestPersonasReply) {}) "personas") []))))
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: @entity.guestPersonas, current: @entity.guestPersona })
        (program/dispatch (if (= @entity.guestPersonaTrait "") "PERSONA_ACT_AS" (str/concat @entity.guestPersonaTrait ".PERSONA_ACT_AS")) { persona: (object/get (default (array/find @entity.guestPersonas (fn r (= (object/get @r "role" "") @entity.guestDefaultRole))) { id: "" }) "id" "") } { guest: @entity.guestHandle, emit: { success: GUEST_PERSONA_ACTED, failure: GUEST_STEP_FAILED } })
      GUEST_PERSONAS_STEPPED -> live when (not (and (= @entity.guestPersona "") (!= @entity.guestDefaultRole "") (array/some (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (as (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") GuestTextPayload) {}) "body") "") GuestPersonasReply) {}) "personas") []))) (fn r (= (object/get @r "role" "") @entity.guestDefaultRole)))))
        (set @entity.guestPersonas (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (as (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") GuestTextPayload) {}) "body") "") GuestPersonasReply) {}) "personas") []))))
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: @entity.guestPersonas, current: @entity.guestPersona })
      GUEST_PERSONAS_FAILED -> live
        (set @entity.guestPersonas [])
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: [], current: @entity.guestPersona })
      GUEST_PERSONA_PICK -> live when (= ?guest @entity.guestHandle)
        (program/dispatch (if (= @entity.guestPersonaTrait "") "PERSONA_ACT_AS" (str/concat @entity.guestPersonaTrait ".PERSONA_ACT_AS")) { persona: ?persona } { guest: ?guest, emit: { success: GUEST_PERSONA_ACTED, failure: GUEST_STEP_FAILED } })
      GUEST_PERSONA_PICK -> live when (!= ?guest @entity.guestHandle)
      GUEST_INTEGRATIONS_PICK -> live
        (set @entity.guestPick ?integrations)
        (set @entity.guestPickFor ?guest)
        (os/getenv "ORB_LAUNCHPAD_HOST" { key: "guest-pick", emit: { success: GUEST_PICK_READ, failure: GUEST_PICK_FAILED } })
      GUEST_PICK_READ -> live when (and (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value ""))) (= @entity.guestPickFor @entity.guestHandle) (!= @entity.guestPick @entity.guestIntegrations))
        (set @entity.guestIntegrations @entity.guestPick)
        (emit GUEST_INTEGRATIONS { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (emit GUEST_REOPEN {})
      GUEST_PICK_READ -> live when (and (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value ""))) (or (!= @entity.guestPickFor @entity.guestHandle) (= @entity.guestPick @entity.guestIntegrations)))
      GUEST_PICK_READ -> live when (not (or (= @entity.guestPick "mock") (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value ""))))
        (emit GUEST_NOTICE { message: @config.integrationsRefused })
      GUEST_PICK_FAILED -> live
        (emit GUEST_NOTICE { message: @config.integrationsRefused })
      GUEST_TRACE_ASK -> live when (= ?guest @entity.guestHandle)
        (set @entity.guestTraceFor ?guest)
        (program/inputs { guest: ?guest, environment: true, credentials: true, denials: true } { emit: { success: GUEST_TRACE_READ, failure: GUEST_TRACE_FAILED } })
      GUEST_TRACE_ASK -> live when (!= ?guest @entity.guestHandle)
      GUEST_TRACE_READ -> live when (= @entity.guestTraceFor @entity.guestHandle)
        (let ((none : GuestGrants {}) (head (default @entity.guestHeader { name: "guest" })))
          (let ((dg (default (object/get @head "osGrants") @none)) (hg (default ?result.grants @none)))
            (emit GUEST_TRACE { guest: @entity.guestHandle, header: @entity.guestHeader, workdir: (if (= @entity.guestIntegrations "live") (str/concat @config.liveRoot "/" (object/get @head "name" "guest")) ""), environment: ?result.environment, credentials: (default ?result.credentials []), computedCredentials: (default ?result.computedCredentials []), denials: (default ?result.denials []), inputs: (default ?result.inputs []), rows: [{ kind: "fs", declared: (array/map (default (object/get @dg "fs") []) (fn e (str/concat @e.glob " [" (str/join @e.modes ", ") "]"))), effective: (array/map (default (object/get @hg "fs") []) (fn e (str/concat @e.glob " [" (str/join @e.modes ", ") "]"))), missing: (array/map (array/filter (default (object/get @dg "fs") []) (fn d (not (array/some (default (object/get @hg "fs") []) (fn h (and (= @h.glob @d.glob) (array/every @d.modes (fn m (array/includes @h.modes @m))))))))) (fn e (str/concat @e.glob " [" (str/join @e.modes ", ") "]"))) }, { kind: "exec", declared: (default (object/get @dg "exec") []), effective: (default (object/get @hg "exec") []), missing: (array/filter (default (object/get @dg "exec") []) (fn d (not (array/includes (default (object/get @hg "exec") []) @d)))) }, { kind: "net", declared: (array/map (default (object/get @dg "net") []) (fn e (str/concat @e.target " [" (str/join @e.kinds ", ") "]"))), effective: (array/map (default (object/get @hg "net") []) (fn e (str/concat @e.target " [" (str/join @e.kinds ", ") "]"))), missing: (array/map (array/filter (default (object/get @dg "net") []) (fn d (not (array/some (default (object/get @hg "net") []) (fn h (and (= @h.target @d.target) (array/every @d.kinds (fn m (array/includes @h.kinds @m))))))))) (fn e (str/concat @e.target " [" (str/join @e.kinds ", ") "]"))) }, { kind: "env", declared: (default (object/get @dg "env") []), effective: (default (object/get @hg "env") []), missing: (array/filter (default (object/get @dg "env") []) (fn d (not (array/includes (default (object/get @hg "env") []) @d)))) }, { kind: "sys", declared: (default (object/get @dg "sys") []), effective: (default (object/get @hg "sys") []), missing: (array/filter (default (object/get @dg "sys") []) (fn d (not (array/includes (default (object/get @hg "sys") []) @d)))) }, { kind: "stdio", declared: (default (object/get @dg "stdio") []), effective: (default (object/get @hg "stdio") []), missing: (array/filter (default (object/get @dg "stdio") []) (fn d (not (array/includes (default (object/get @hg "stdio") []) @d)))) }, { kind: "desktop", declared: (default (object/get @dg "desktop") []), effective: (default (object/get @hg "desktop") []), missing: (array/filter (default (object/get @dg "desktop") []) (fn d (not (array/includes (default (object/get @hg "desktop") []) @d)))) }, { kind: "kernel", declared: (array/map (default (object/get @dg "kernel") []) (fn e (str/concat @e.target " [" (str/join @e.kinds ", ") "]"))), effective: (array/map (default (object/get @hg "kernel") []) (fn e (str/concat @e.target " [" (str/join @e.kinds ", ") "]"))), missing: (array/map (array/filter (default (object/get @dg "kernel") []) (fn d (not (array/some (default (object/get @hg "kernel") []) (fn h (and (= @h.target @d.target) (array/every @d.kinds (fn m (array/includes @h.kinds @m))))))))) (fn e (str/concat @e.target " [" (str/join @e.kinds ", ") "]"))) }, { kind: "anchored fs", declared: (array/map (default (object/get @dg "anchored.fs") []) (fn e (json/stringify @e))), effective: (array/map (default (object/get @hg "anchored.fs") []) (fn e (json/stringify @e))), missing: (array/map (array/filter (default (object/get @dg "anchored.fs") []) (fn d (not (array/some (default (object/get @hg "anchored.fs") []) (fn h (and (= (json/stringify @h.anchor) (json/stringify @d.anchor)) (= @h.glob @d.glob) (array/every (default @d.modes []) (fn m (array/includes (default @h.modes []) @m))))))))) (fn e (json/stringify @e))) }, { kind: "anchored exec", declared: (array/map (default (object/get @dg "anchored.exec") []) (fn e (json/stringify @e))), effective: (array/map (default (object/get @hg "anchored.exec") []) (fn e (json/stringify @e))), missing: (array/map (array/filter (default (object/get @dg "anchored.exec") []) (fn d (not (array/some (default (object/get @hg "anchored.exec") []) (fn h (= (json/stringify @h) (json/stringify @d))))))) (fn e (json/stringify @e))) }, { kind: "anchored net", declared: (array/map (default (object/get @dg "anchored.net") []) (fn e (json/stringify @e))), effective: (array/map (default (object/get @hg "anchored.net") []) (fn e (json/stringify @e))), missing: (array/map (array/filter (default (object/get @dg "anchored.net") []) (fn d (not (array/some (default (object/get @hg "anchored.net") []) (fn h (and (= (json/stringify @h.host) (json/stringify @d.host)) (= (json/stringify @h.port) (json/stringify @d.port)) (array/every (default @d.kinds []) (fn m (array/includes (default @h.kinds []) @m))))))))) (fn e (json/stringify @e))) }] })))
      GUEST_TRACE_READ -> live when (!= @entity.guestTraceFor @entity.guestHandle)
      GUEST_TRACE_FAILED -> live when (= @entity.guestTraceFor @entity.guestHandle)
        (emit GUEST_NOTICE { message: ?error })
      GUEST_TRACE_FAILED -> live when (!= @entity.guestTraceFor @entity.guestHandle)
      GUEST_TRACE_REVEAL -> live when (= ?guest @entity.guestHandle)
        (set @entity.guestRevealName ?name)
        (set @entity.guestRevealSource ?via)
        (set @entity.guestRevealFor ?guest)
        (os/getenv "ORB_LAUNCHPAD_HOST" { key: "guest-reveal", emit: { success: GUEST_REVEAL_READ, failure: GUEST_REVEAL_FAILED } })
      GUEST_TRACE_REVEAL -> live when (!= ?guest @entity.guestHandle)
      GUEST_REVEAL_READ -> live when (and (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value "")) (= @entity.guestRevealFor @entity.guestHandle) (= @entity.guestRevealSource "environment"))
        (program/inputs { guest: @entity.guestHandle, environment: @entity.guestRevealName } { emit: { success: GUEST_REVEAL_ANSWERED, failure: GUEST_REVEAL_DENIED } })
      GUEST_REVEAL_READ -> live when (and (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value "")) (= @entity.guestRevealFor @entity.guestHandle) (= @entity.guestRevealSource "credentials"))
        (program/inputs { guest: @entity.guestHandle, credentials: @entity.guestRevealName } { emit: { success: GUEST_REVEAL_ANSWERED, failure: GUEST_REVEAL_DENIED } })
      GUEST_REVEAL_READ -> live when (and (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value "")) (!= @entity.guestRevealFor @entity.guestHandle))
      GUEST_REVEAL_READ -> live when (not (array/includes ["127.0.0.1", "localhost", "::1"] (default @payload.value "")))
        (emit GUEST_NOTICE { message: @config.revealRefused })
      GUEST_REVEAL_FAILED -> live
        (emit GUEST_NOTICE { message: @config.revealRefused })
      GUEST_REVEAL_ANSWERED -> live when (= @entity.guestRevealFor @entity.guestHandle)
        (emit GUEST_TRACE_REVEALED { guest: @entity.guestHandle, name: @entity.guestRevealName, via: @entity.guestRevealSource, value: (let ((blank : GuestEnvValue { name: "" })) (if (= @entity.guestRevealSource "credentials") (object/get (default ?result.credentials @blank) "value") (object/get (default ?result.environment @blank) "value"))) })
      GUEST_REVEAL_ANSWERED -> live when (!= @entity.guestRevealFor @entity.guestHandle)
      GUEST_REVEAL_DENIED -> live when (= @entity.guestRevealFor @entity.guestHandle)
        (emit GUEST_NOTICE { message: ?error })
      GUEST_REVEAL_DENIED -> live when (!= @entity.guestRevealFor @entity.guestHandle)
      GUEST_PERSONA_ACTED -> live when (array/some (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGNED_IN")))
        (set @entity.guestPersona (default (object/get (default (as (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGNED_IN"))) {}) "payload") GuestTextPayload) {}) "subject") ""))
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: @entity.guestPersonas, current: @entity.guestPersona })
        (program/navigate { guest: @entity.guestHandle, route: @entity.guestRoute, remount: true } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_PERSONA_ACTED -> live when (not (array/some (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGNED_IN"))))
        (emit GUEST_NOTICE { message: (default (object/get (default (as (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGN_IN_REFUSED"))) {}) "payload") GuestTextPayload) {}) "error") "The persona could not be signed in") })
      GUEST_SEND -> live when (= ?guest @entity.guestHandle)
        (program/dispatch ?address ?payload { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_SEND -> live when (!= ?guest @entity.guestHandle)
      GUEST_INPUT_SEND -> live when (= ?guest @entity.guestHandle)
        (program/dispatch ?address ?text { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_INPUT_SEND -> live when (!= ?guest @entity.guestHandle)
      GUEST_STEPPED -> live
        (set @entity.guestPaints (array/reduce ?result.rendered (array/filter @entity.guestPaints (fn q (!= @q.slot "toast"))) (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (set @entity.guestPaintSeq (+ @entity.guestPaintSeq 1))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints, seq: @entity.guestPaintSeq })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
      GUEST_STEP_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_TICKED -> live when (= ?guest @entity.guestHandle)
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: (default ?outcomes []) })
        (set @entity.guestPaints (array/reduce ?rendered (array/filter @entity.guestPaints (fn q (!= @q.slot "toast"))) (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (set @entity.guestPaintSeq (+ @entity.guestPaintSeq 1))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints, seq: @entity.guestPaintSeq })
        (when (and @entity.guestSigningIn (array/some (default ?emitted []) (fn e (= @e.event "CREDENTIAL_BOUND")))) (do (set @entity.guestSigningIn false) (program/navigate { guest: @entity.guestHandle, route: @entity.guestReturnTo, remount: true } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })))
        (when (and @entity.guestSigningIn (not (array/some (default ?emitted []) (fn e (= @e.event "CREDENTIAL_BOUND")))) (array/some (default ?emitted []) (fn e (= @e.event "CREDENTIAL_REFUSED")))) (do (set @entity.guestSigningIn false) (emit GUEST_NOTICE { message: (str/concat @config.signInRefused " " @config.signInReason " " (default (object/get (default (array/find (default ?emitted []) (fn e (= @e.event "CREDENTIAL_REFUSED"))) { event: "", payload: { reason: "" } }) "payload.reason") "")) })))
      GUEST_TICKED -> live when (!= ?guest @entity.guestHandle)
      GUEST_TICKS_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_NAVIGATE -> live when (= ?guest @entity.guestHandle)
        (program/navigate { guest: ?guest, route: ?route } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_NAVIGATE -> live when (!= ?guest @entity.guestHandle)
      GUEST_NAVIGATED -> live when (and (= (default ?result.access.verdict "") "denied") (= @entity.guestIntegrations "live"))
        (set @entity.guestReturnTo (default ?result.access.returnTo ""))
        (emit GUEST_SIGN_IN { guest: @entity.guestHandle })
      GUEST_NAVIGATED -> live when (and (= (default ?result.access.verdict "") "denied") (= @entity.guestIntegrations "mock"))
        (emit GUEST_NOTICE { message: @config.signInNeeded })
      GUEST_CREDENTIAL -> live when (= ?guest @entity.guestHandle)
        (set @entity.guestSigningIn true)
        (program/dispatch "CREDENTIAL_PRESENTED" { requestId: 0, authorization: (str/concat "Bearer " ?token) } { guest: ?guest, emit: { success: GUEST_CREDENTIAL_ANSWERED, failure: GUEST_CREDENTIAL_FAILED } })
      GUEST_CREDENTIAL -> live when (!= ?guest @entity.guestHandle)
      GUEST_CREDENTIAL_ANSWERED -> live when (array/some (default ?result.emitted []) (fn e (= @e.event "CREDENTIAL_BOUND")))
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: (default ?result.outcomes []) })
        (set @entity.guestSigningIn false)
        (program/navigate { guest: @entity.guestHandle, route: @entity.guestReturnTo, remount: true } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_CREDENTIAL_ANSWERED -> live when (and (not (array/some (default ?result.emitted []) (fn e (= @e.event "CREDENTIAL_BOUND")))) (array/some (default ?result.emitted []) (fn e (= @e.event "CREDENTIAL_REFUSED"))))
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: (default ?result.outcomes []) })
        (set @entity.guestSigningIn false)
        (emit GUEST_NOTICE { message: (str/concat @config.signInRefused " " @config.signInReason " " (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "CREDENTIAL_REFUSED"))) { event: "", payload: { reason: "" } }) "payload.reason") "")) })
      GUEST_CREDENTIAL_ANSWERED -> live when (and (not (array/some (default ?result.emitted []) (fn e (= @e.event "CREDENTIAL_BOUND")))) (not (array/some (default ?result.emitted []) (fn e (= @e.event "CREDENTIAL_REFUSED")))))
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: (default ?result.outcomes []) })
      GUEST_CREDENTIAL_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_NAVIGATED -> live when (!= (default ?result.access.verdict "") "denied")
        (set @entity.guestPage ?result.page)
        (set @entity.guestRoute (default ?result.route ""))
        (set @entity.guestPaints (array/reduce ?result.rendered (array/filter @entity.guestPaints (fn q (!= @q.slot "toast"))) (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (set @entity.guestPaintSeq (+ @entity.guestPaintSeq 1))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints, seq: @entity.guestPaintSeq })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
        (emit GUEST_PERSONAS_ASK {})
      GUEST_NAVIGATE_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_FAIL -> idle
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle "")
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
        (emit GUEST_ERROR { message: ?message })
      GUEST_RESET -> idle
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle "")
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
      GUEST_REACH -> live
        (set @entity.guestIntegrations ?integrations)
      GUEST_CLOSED -> live
      GUEST_CLOSE_FAILED -> live
    }

    emits {
      GUEST_PAINTS -> external {
        guest : string!
        route : string!
        page : [string]!
        paints : [GuestPaint]!
        seq : number!
      }
        @description "The guest's current paint of every trait for every slot it draws into, each saying whether its trait is embedded on the guest's page."
      GUEST_ERROR -> external {
        message : string!
      }
        @description "The guest could not be opened, or the host could not supply its program."
      GUEST_READY -> external {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "A guest opened: its session id, the `guest` option program/inputs and program/dispatch take to operate it, and the reach it opened with."
      GUEST_MOVED -> external {
        guest : string!
        moves : [GuestMove]!
      }
        @description "The transitions the guest's traits took while opening or on a step, in order."
      GUEST_SIGN_IN -> external {
        guest : string!
      }
      GUEST_NOTICE -> external {
        message : string!
      }
        @description "A step of the guest failed, or a second guest could not replace the open one."
      GUEST_CLEARED -> external { }
      GUEST_THEME -> external {
        theme : GuestTheme!
      }
        @description "The previous guest is gone: a new one is opening or the session was reset."
      GUEST_PERSONAS -> external {
        guest : string!
        personas : [GuestPersonaOption]!
        current : string!
      }
        @description "The development personas the open guest lists (its std-dev-personas answers PERSONAS_REQUESTED, which a program without one or outside the Auth emulator answers with none), and the persona picked as the guest's viewer; empty current while the default persona is."
      GUEST_INTEGRATIONS -> external {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "How the guest reaches real services now (mock or live); guest is empty while none is open."
      GUEST_TRACE -> external {
        guest : string!
        header : GuestHeader?
        workdir : string!
        environment : [GuestEnvStatus]!
        credentials : [GuestCredentialStatus]!
        computedCredentials : [string]!
        denials : [GuestDenial]!
        inputs : [GuestInput]!
        rows : [GuestGrantRow]!
      }
        @description "What the open guest declares and holds, for the trace sidebar: its app header, its working folder, the environment names it holds (set or missing, last four characters, never a value) and per grant kind what the program declares next to what the guest really holds."
      GUEST_TRACE_REVEALED -> external {
        guest : string!
        name : string!
        via : "environment" | "credentials"!
        value : string?
      }
        @description "The value of one environment name the viewer asked to reveal, answered only when the launchpad is bound to loopback."
      GUEST_REOPEN -> external { }
        @description "The open guest must be opened again (its integrations changed): the host sends GUEST_OPEN with the same program."
      GUEST_OPENED {
        result : GuestOpened!
      }
      GUEST_FAILED {
        error : string!
      }
      GUEST_STEPPED {
        result : GuestStepped!
      }
      GUEST_STEP_FAILED {
        error : string!
      }
      GUEST_TICKED {
        guest : string!
        rendered : [GuestPaint]!
        emitted : [GuestEmitted]
        outcomes : [GuestMove]
        key : string
      }
        @description "One pass of the open guest's own tick clock that painted something (program/live { kind: guest }): its page traits' ticks, [client] ones included, since a guest has no browser."
      GUEST_TICKS_FAILED {
        error : string!
      }
      GUEST_CREDENTIAL {
        guest : string!
        token : string!
      }
      GUEST_CREDENTIAL_ANSWERED {
        result : GuestAnswered!
      }
      GUEST_CREDENTIAL_FAILED {
        error : string!
      }
      GUEST_NAVIGATED {
        result : GuestNavigated!
      }
      GUEST_NAVIGATE_FAILED {
        error : string!
      }
      GUEST_CLOSED {
        result : GuestClosed!
      }
      GUEST_CLOSE_FAILED {
        error : string!
      }
      GUEST_PREPARE { }
      GUEST_SEED_ASK {
        program : GuestProgram?
      }
      GUEST_PERSONAS_ASK { }
      GUEST_PERSONAS_STEPPED {
        result : GuestAnswered!
      }
      GUEST_PERSONAS_FAILED {
        error : string!
      }
      GUEST_PERSONA_ACTED {
        result : GuestAnswered!
      }
      GUEST_PERSONAS_RESOLVED {
        result : behavior!
      }
      GUEST_SEED_RESOLVED {
        result : behavior!
      }
      GUEST_SEED_FAILED {
        error : string!
      }
      GUEST_LIVE_DIR_READY {
        key : string
      }
        @description "os/mkdir: the live guest's own folder exists."
      GUEST_LIVE_CHECKED {
        ok : boolean!
      }
        @description "os/exists: whether the folder already links node_modules."
      GUEST_LIVE_TARGET {
        key : string
        path : string!
      }
        @description "os/realpath: the absolute path of the working directory's node_modules."
      GUEST_LIVE_LINKED {
        key : string
      }
        @description "os/symlink: the folder links the working directory's node_modules."
      GUEST_PICK_READ {
        value : string
      }
        @description "os/getenv: the host the launchpad is bound to."
      GUEST_PICK_FAILED {
        error : string!
      }
        @description "The launchpad's bound host could not be read."
      GUEST_COMPOSED {
        result : behavior!
      }
      GUEST_TRACE_READ {
        result : GuestTraceInputs!
      }
        @description "program/inputs: the environment names the guest holds and the grants it really holds."
      GUEST_TRACE_FAILED {
        error : string!
      }
      GUEST_REVEAL_READ {
        value : string
      }
        @description "os/getenv: the host the launchpad is bound to, read before a value is revealed."
      GUEST_REVEAL_FAILED {
        error : string!
      }
        @description "The launchpad's bound host could not be read."
      GUEST_REVEAL_ANSWERED {
        result : GuestRevealInputs!
      }
        @description "program/inputs: the value of the one environment name asked."
      GUEST_REVEAL_DENIED {
        error : string!
      }
        @description "The guest refused the value: it does not declare that name."
    }

    listens {
      GuestOpener.GUEST_OPEN -> GUEST_OPEN
      GuestOpener.GUEST_FAIL -> GUEST_FAIL
      GuestOpener.GUEST_RESET -> GUEST_RESET
      GuestOpener.GUEST_REACH -> GUEST_REACH
      GUEST_REACH {
        integrations : "mock" | "live"!
      }
        @description "The composer chose how the next guest reaches real services; the guest already open is not reopened."
      GuestMarks.MARKS_CHECKED -> GUEST_SEED_MARKED
      GUEST_SEED_MARKED {
        marked : boolean!
        personas : string!
        personasCollection : string!
        personasSignIn : string!
        defaultRole : string!
        personaTrait : string!
      }
      GuestStage.GUEST_INTEGRATIONS_PICK -> GUEST_INTEGRATIONS_PICK
      GUEST_INTEGRATIONS_PICK {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "The viewer switched the guest between mocked and live integrations: the guest is opened again that way."
      GuestStage.GUEST_TRACE_ASK -> GUEST_TRACE_ASK
      GUEST_TRACE_ASK {
        guest : string!
      }
        @description "The trace sidebar asks what the open guest declares and holds."
      GuestStage.GUEST_TRACE_REVEAL -> GUEST_TRACE_REVEAL
      GuestStage.GUEST_CREDENTIAL -> GUEST_CREDENTIAL
      GUEST_TRACE_REVEAL {
        guest : string!
        name : string!
        via : "environment" | "credentials"!
      }
        @description "The viewer asked to reveal one environment value of the open guest."
      GuestStage.GUEST_PERSONA_PICK -> GUEST_PERSONA_PICK
      GUEST_PERSONA_PICK {
        guest : string!
        persona : string!
      }
        @description "A persona was picked for the open guest: its session is signed in as that persona (PERSONA_ACT_AS into the guest's std-dev-personas), then every mounted trait of the guest runs its INIT again so its lists fetch as the new viewer."
      GUEST_OPEN -> input {
        program : GuestProgram!
      }
        @description "Open a resolved program as the guest, closing the one already open."
        @synonyms "run a program live, mount a behavior at run time, open a guest session"
      GUEST_FAIL -> input {
        message : string!
      }
        @description "The host could not obtain a program to open: report it as the guest's error."
      GuestStage.GUEST_SEND -> GUEST_SEND
      GuestStage.GUEST_NAVIGATE -> GUEST_NAVIGATE
      GuestStage.GUEST_INPUT_SEND -> GUEST_INPUT_SEND
      GUEST_INPUT_SEND {
        guest : string!
        address : string!
        text : string!
      }
        @description "The trace sidebar sends one declared input of the guest, its payload as the JSON text the viewer typed; the kernel parses and checks it against the guest event."
      GUEST_NAVIGATE {
        guest : string!
        route : string!
      }
      GUEST_SEND {
        guest : string!
        address : string!
        event : event!
        payload : @payload event?
      }
      GUEST_RESET { }
        @description "Close the open guest and clear the paint."
    }
  }

  trait GuestOpener -> GuestRun {
    initial: idle

    state idle {
      INIT -> idle
      STAGE_OPEN -> idle
        (emit GUEST_RESET {})
        (when (!= ?integrations null) (emit GUEST_REACH { integrations: ?integrations }))
        (behavior/resolve ?behavior { emit: { success: STAGE_RESOLVED, failure: STAGE_RESOLVE_FAILED } })
      STAGE_SHOW -> idle
        (when (!= ?integrations null) (emit GUEST_REACH { integrations: ?integrations }))
        (emit GUEST_OPEN { program: ?program })
      STAGE_CLOSE -> idle
        (emit GUEST_RESET {})
      STAGE_RESOLVED -> idle
        (emit GUEST_OPEN { program: ?result })
      STAGE_RESOLVE_FAILED -> idle
        (emit GUEST_FAIL { message: ?error })
    }

    emits {
      GUEST_OPEN -> internal {
        program : GuestProgram!
      }
        @description "The program to open, for the guest session; internal, so the program stays on the server."
      GUEST_FAIL -> internal {
        message : string!
      }
        @description "The behavior did not resolve into a program."
      GUEST_RESET -> internal { }
      GUEST_REACH -> internal {
        integrations : "mock" | "live"!
      }
      STAGE_RESOLVED {
        result : GuestProgram!
      }
      STAGE_RESOLVE_FAILED {
        error : string!
      }
    }

    listens {
      STAGE_OPEN {
        behavior : behavior!
        integrations : GuestReach?
      }
        @description "Open a behavior value on the stage: it the stage is cleared at once (the guest already open is closed), then the value is resolved into a program and opened as the guest. `integrations` is the composer's choice of reach for this open; absent keeps the session's."
      STAGE_SHOW {
        program : GuestProgram!
        integrations : GuestReach?
      }
        @description "Open an already resolved program on the stage."
      STAGE_CLOSE { }
        @description "Close the open guest and clear the stage."
    }
  }

  trait GuestStage -> GuestStageRun [client] {
    config {
      slot : string = "main"
        @label "Guest slot"
        @description "The slot of the guest's page-root paint this stage shows."
        @tier "domain"
      className : string = ""
        @label "Class name"
        @description "Classes of the box that holds the guest's paint."
        @tier "presentation"
      errorTitle : string = ""
        @label "Error title"
        @description "Title of the alert shown when the guest could not be run; none when empty."
        @tier "presentation"
      pending : "card" | "detail" = card
        @label "Placeholder"
        @description "The skeleton shown until the guest has painted."
        @tier "presentation"
      pendingRows : number = 2
        @label "Placeholder rows"
        @tier "presentation"
      unpaintedTitle : string = "Nothing to show here on its own"
        @label "Unpainted title"
        @description "The title shown when the opened guest painted nothing into the configured slot."
        @tier "presentation"
      unpaintedNothing : string = "The behavior painted nothing when it opened; it draws in answer to an event a host sends it."
        @label "Nothing painted"
        @description "The message when the opened guest painted no slot at all."
        @tier "presentation"
      unpaintedOthers : string = "It paints only into these slots, which a host page opens: "
        @label "Other slots painted"
        @description "The message before the list of slots the opened guest did paint."
        @tier "presentation"
      personasLabel : string = "Viewing as"
        @label "Personas label"
        @description "The caption before the personas the guest lists, which the viewer picks to open the guest as that persona."
        @tier "presentation"
      integrationsLabel : string = "Real integrations"
        @label "Integrations label"
        @description "The label of the switch beside the persona picker that opens the guest again with live integrations (on) or mocked ones (off)."
        @tier "presentation"
      signInLabel : string = "Sign in with Google"
        @label "Sign-in button"
        @description "The button the stage shows when the guest asks its viewer to sign in; the Google sign-in runs on its click."
      traceLabel : string = "Trace"
        @label "Trace label"
        @description "The accessible name of the button beside the integrations switch that opens the trace sidebar."
        @tier "presentation"
      traceTitle : string = "Trace · this behavior"
        @label "Trace title"
        @description "The title of the trace sidebar."
        @tier "presentation"
      traceOwnMemory : string = "own memory"
        @label "Own memory"
        @description "What the sidebar shows as the working directory of a guest whose rows live in its own memory."
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (emit GUEST_SHOWN {})
      GUEST_PAINTS -> idle when (<= ?seq @entity.guestPaintSeq)
      GUEST_PAINTS -> idle when (> ?seq @entity.guestPaintSeq)
        (set @entity.guestPaintSeq ?seq)
        (if (and @entity.guestTraceOpen (!= ?guest @entity.guestHandle))
          (do
            (set @entity.guestRevealed [])
            (set @entity.guestTraceAnswered false)
            (emit GUEST_TRACE_ASK { guest: ?guest }))
          null)
        (set @entity.guestHandle ?guest)
        (set @entity.guestError "")
        (set @entity.guestPage ?page)
        (set @entity.guestRoute ?route)
        (set @entity.guestPaints ?paints)
        (emit GUEST_SHOWN {})
      GUEST_ERROR -> idle
        (set @entity.guestError ?message)
        (emit GUEST_SHOWN {})
      GUEST_SIGN_IN -> idle
        (set @entity.guestSignInAsked true)
        (emit GUEST_SHOWN {})
      GUEST_SIGN_IN_CHOSEN -> idle
        (set @entity.guestSignInAsked false)
        (auth/sign-in { method: "google", viewer: false } { emit: { success: GUEST_GOOGLE_IN, failure: GUEST_GOOGLE_FAILED } })
        (emit GUEST_SHOWN {})
      GUEST_GOOGLE_IN -> idle
        (emit GUEST_CREDENTIAL { guest: @entity.guestHandle, token: (default ?idToken "") })
      GUEST_GOOGLE_FAILED -> idle
        (notify error ?error)
      GUEST_NOTICE -> idle
        (notify error ?message)
      GUEST_PERSONAS -> idle when (= ?guest @entity.guestHandle)
        (set @entity.guestPersonas ?personas)
        (set @entity.guestPersona ?current)
        (emit GUEST_SHOWN {})
      GUEST_PERSONAS -> idle when (!= ?guest @entity.guestHandle)
      GUEST_INTEGRATIONS -> idle when (or (= ?guest "") (= ?guest @entity.guestHandle))
        (set @entity.guestIntegrations ?integrations)
        (emit GUEST_SHOWN {})
      GUEST_INTEGRATIONS -> idle when (and (!= ?guest "") (!= ?guest @entity.guestHandle))
      GUEST_INTEGRATIONS_CHOSEN -> idle when (!= @entity.guestHandle "")
        (emit GUEST_INTEGRATIONS_PICK { guest: @entity.guestHandle, integrations: (if ?checked live mock) })
      GUEST_INTEGRATIONS_CHOSEN -> idle when (= @entity.guestHandle "")
      GUEST_PERSONA_CHOSEN -> idle when (and (!= @entity.guestHandle "") (!= @payload.itemId @entity.guestPersona))
        (emit GUEST_PERSONA_PICK { guest: @entity.guestHandle, persona: @payload.itemId })
      GUEST_PERSONA_CHOSEN -> idle when (or (= @entity.guestHandle "") (= @payload.itemId @entity.guestPersona))
      GUEST_TRACE_TOGGLED -> idle when (and (not @entity.guestTraceOpen) (!= @entity.guestHandle ""))
        (set @entity.guestTraceOpen true)
        (set @entity.guestTraceAnswered false)
        (emit GUEST_TRACE_ASK { guest: @entity.guestHandle })
        (emit GUEST_SHOWN {})
      GUEST_TRACE_TOGGLED -> idle when (and (not @entity.guestTraceOpen) (= @entity.guestHandle ""))
        (set @entity.guestTraceOpen true)
        (emit GUEST_SHOWN {})
      GUEST_TRACE_TOGGLED -> idle when @entity.guestTraceOpen
        (set @entity.guestTraceOpen false)
        (set @entity.guestRevealed [])
        (emit GUEST_SHOWN {})
      GUEST_TRACE_CLOSED -> idle
        (set @entity.guestTraceOpen false)
        (set @entity.guestRevealed [])
        (emit GUEST_SHOWN {})
      GUEST_TRACE -> idle when (= ?guest @entity.guestHandle)
        (set @entity.guestHeader ?header)
        (set @entity.guestWorkdir ?workdir)
        (set @entity.guestEnvironment ?environment)
        (set @entity.guestCredentials ?credentials)
        (set @entity.guestComputedCredentials ?computedCredentials)
        (set @entity.guestDenials ?denials)
        (set @entity.guestInputs ?inputs)
        (set @entity.guestTraceAnswered true)
        (set @entity.guestGrantRows ?rows)
        (emit GUEST_SHOWN {})
      GUEST_TRACE -> idle when (!= ?guest @entity.guestHandle)
      GUEST_TRACE_REVEAL_CHOSEN -> idle when (!= @entity.guestHandle "")
        (emit GUEST_TRACE_REVEAL { guest: @entity.guestHandle, name: ?name, via: ?via })
      GUEST_TRACE_REVEAL_CHOSEN -> idle when (= @entity.guestHandle "")
      GUEST_TRACE_REVEALED -> idle when (= ?guest @entity.guestHandle)
        (set @entity.guestRevealed (array/concat (array/filter @entity.guestRevealed (fn r (not (and (= @r.name ?name) (= @r.via ?via))))) [{ name: ?name, via: ?via, value: ?value }]))
        (emit GUEST_SHOWN {})
      GUEST_TRACE_REVEALED -> idle when (!= ?guest @entity.guestHandle)
      GUEST_THEME -> idle
        (set @entity.guestTheme ?theme)
        (emit GUEST_SHOWN {})
      GUEST_CLEARED -> idle
        (set @entity.guestPaintSeq 0)
        (set @entity.guestHeader null)
        (set @entity.guestTheme null)
        (set @entity.guestWorkdir "")
        (set @entity.guestEnvironment [])
        (set @entity.guestCredentials [])
        (set @entity.guestComputedCredentials [])
        (set @entity.guestDenials [])
        (set @entity.guestTraceAnswered false)
        (set @entity.guestGrantRows [])
        (set @entity.guestRevealed [])
        (set @entity.guestHandle "")
        (set @entity.guestPersonas [])
        (set @entity.guestPaints [])
        (set @entity.guestPage [])
        (set @entity.guestRoute "")
        (set @entity.guestError "")
        (emit GUEST_SHOWN {})
      GUEST_INPUT_PICKED -> idle
        (set @entity.guestInputPick ?address)
        (set @entity.guestInputText "")
        (emit GUEST_SHOWN {})
      GUEST_INPUT_TYPED -> idle
        (set @entity.guestInputText ?value)
      GUEST_INPUT_SENT -> idle when (and (!= @entity.guestHandle "") (!= @entity.guestInputPick ""))
        (emit GUEST_INPUT_SEND { guest: @entity.guestHandle, address: @entity.guestInputPick, text: @entity.guestInputText })
      GUEST_INPUT_SENT -> idle when (or (= @entity.guestHandle "") (= @entity.guestInputPick ""))
      GUEST_CONTROL -> idle when (= ?guest @entity.guestHandle)
        (emit GUEST_SEND { guest: ?guest, address: ?address, event: ?event, payload: ?payload })
      GUEST_CONTROL -> idle when (!= ?guest @entity.guestHandle)
      GUEST_ROUTE -> idle when (= ?guest @entity.guestHandle)
        (emit GUEST_NAVIGATE { guest: ?guest, route: ?route })
      GUEST_ROUTE -> idle when (!= ?guest @entity.guestHandle)
      GUEST_SHOWN -> idle
        (render-ui main { type: box, className: @config.className, children: (array/concat (array/concat (if (and (= @entity.guestError "") (!= @entity.guestHandle "")) (let ((current (default (array/find @entity.guestPersonas (fn p (= @p.id @entity.guestPersona))) (default (array/first @entity.guestPersonas) { id: "", name: "", role: "" }))) (currentRole (default @current.role "")) (currentName (default @current.name ""))) [{ type: stack, direction: horizontal, justify: end, align: center, gap: md, className: "px-4 py-2 border-b border-border", children: (array/concat [
            { type: button, icon: activity, variant: (if @entity.guestTraceOpen primary ghost), size: sm, action: GUEST_TRACE_TOGGLED, aria-label: @config.traceLabel },
            { type: switch, label: @config.integrationsLabel, checked: (= @entity.guestIntegrations live), action: GUEST_INTEGRATIONS_CHOSEN }
          ] (if @entity.guestSignInAsked [{ type: button, icon: log-in, variant: primary, size: sm, label: @config.signInLabel, action: GUEST_SIGN_IN_CHOSEN }] []) (if (= (array/len @entity.guestPersonas) 0) [] [
            { type: menu, position: bottom-end, trigger: { type: button, variant: ghost, size: sm, rightIcon: chevron-down, children: [{ type: stack, direction: horizontal, align: center, gap: sm, children: [
              { type: icon, name: user-round, size: sm },
              { type: stack, direction: vertical, gap: none, align: start, children: [
                { type: typography, variant: caption, color: muted, content: @config.personasLabel },
                { type: typography, variant: body, weight: semibold, content: (if (= @currentRole "") (if (= @currentName "") @current.id @currentName) @currentRole) },
                (if (or (= @currentRole "") (= @currentName "")) null { type: typography, variant: caption, color: muted, content: @currentName })
              ] }
            ] }] }, items: (array/map @entity.guestPersonas (fn p { id: @p.id, label: (if (= (default @p.role "") "") (default @p.name @p.id) (default @p.role "")), description: (if (= (default @p.role "") "") "" (default @p.name "")), icon: (if (= @p.id @current.id) "check" "user-round"), event: GUEST_PERSONA_CHOSEN })) }
          ])) }]) []) [
          (if (!= @entity.guestError "")
            { type: container, size: md, padding: lg, children: [(if (= @config.errorTitle "") { type: alert, variant: error, message: @entity.guestError } { type: alert, variant: error, title: @config.errorTitle, message: @entity.guestError })] }
            (let ((slotRoots (array/filter @entity.guestPaints (fn p (and (= @p.slot @config.slot) (= @p.embedded false) (array/includes @entity.guestPage @p.trait))))) (paint (array/first (array/filter @entity.guestPaints (fn p (and (= @p.slot @config.slot) (= @p.embedded false) (array/includes @entity.guestPage @p.trait)))))))
              (if (= @paint null)
                (if (= @entity.guestHandle "")
                  { type: container, size: full, padding: md, children: [{ type: skeleton, variant: @config.pending, rows: @config.pendingRows }] }
                  (let ((roots (array/filter @entity.guestPaints (fn p (= @p.embedded false)))) (notice { type: container, size: md, padding: lg, children: [{ type: alert, variant: info, title: @config.unpaintedTitle, message: (if (= (array/len @roots) 0) @config.unpaintedNothing (str/concat @config.unpaintedOthers (str/join (array/map @roots (fn p @p.slot)) ", "))) }] }))
                    (if (= (array/len @roots) 0) @notice { type: stack, direction: vertical, gap: none, children: [@notice, { type: guest-view, guest: @entity.guestHandle, source: (object/get (default (array/first @roots) { slot: "", trait: "", embedded: false }) "trait"), deliver: GUEST_CONTROL, navigate: GUEST_ROUTE, route: @entity.guestRoute, paints: @entity.guestPaints, theme: @entity.guestTheme, children: [] }] })))
                { type: guest-view, guest: @entity.guestHandle, source: @paint.trait, deliver: GUEST_CONTROL, navigate: GUEST_ROUTE, route: @entity.guestRoute, paints: @entity.guestPaints, theme: @entity.guestTheme, children: (array/map @slotRoots (fn p @p.content)) })))
        ]) (if @entity.guestTraceOpen [{ type: drawer, isOpen: true, modal: false, title: @config.traceTitle, position: right, width: "min(520px, 92vw)", closeEvent: GUEST_TRACE_CLOSED, children: [(let ((none : GuestGrants {}) (head (default @entity.guestHeader { name: "" }))) (let ((dg (default (object/get @head "osGrants") @none))) { type: stack, direction: vertical, gap: lg, className: "p-4", children: [{ type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Header" }] (array/map [["Name", @head.name], ["Version", (default @head.version "")], ["Description", (default @head.description "")], ["Store", (default @head.store "")], ["Inbound", (str/join (default @head.inbound []) ", ")], ["Egress", (str/join (default @head.egress []) ", ")]] (fn p { type: stack, direction: horizontal, gap: sm, align: start, children: [{ type: typography, variant: caption, color: muted, className: "w-28 shrink-0", content: (array/nth @p 0) }, { type: typography, variant: body, className: "break-all", content: (array/nth @p 1) }] }))) }, { type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Runtime" }] (array/map [["Integrations", @entity.guestIntegrations], ["Working directory", (if (= @entity.guestWorkdir "") @config.traceOwnMemory @entity.guestWorkdir)]] (fn p { type: stack, direction: horizontal, gap: sm, align: start, children: [{ type: typography, variant: caption, color: muted, className: "w-28 shrink-0", content: (array/nth @p 0) }, { type: typography, variant: body, className: "break-all", content: (array/nth @p 1) }] }))) }, { type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Environment" }] (array/concat (if (= (array/len @entity.guestEnvironment) 0) [{ type: typography, variant: caption, color: muted, content: "No environment variables" }] []) (array/map @entity.guestEnvironment (fn e (let ((shown (array/find @entity.guestRevealed (fn r (and (= @r.name @e.name) (= @r.via "environment")))))) { type: stack, direction: horizontal, align: center, gap: sm, children: [ { type: icon, name: (if @e.set "check" "x"), size: sm }, { type: typography, variant: body, weight: medium, className: "break-all", content: @e.name }, { type: badge, variant: (if @e.set "success" "danger"), size: sm, label: (if @e.set "set" "missing") }, { type: typography, variant: caption, color: muted, className: "break-all", content: (if (= @shown null) (if (and @e.set (!= @e.tail "")) (str/concat "••••" @e.tail) "") (default @shown.value "")) }, (if (and (= @entity.guestIntegrations "live") @e.set (= @shown null)) { type: button, label: "Reveal", icon: eye, variant: ghost, size: sm, action: GUEST_TRACE_REVEAL_CHOSEN, actionPayload: { name: @e.name, via: "environment" } } null)] }))))) }, { type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Credentials" }] (array/concat (if (and (= (array/len @entity.guestCredentials) 0) (= (array/len @entity.guestComputedCredentials) 0)) [{ type: typography, variant: caption, color: muted, content: "No credentials" }] []) (array/map @entity.guestCredentials (fn e (let ((shown (array/find @entity.guestRevealed (fn r (and (= @r.name @e.name) (= @r.via "credentials")))))) { type: stack, direction: horizontal, align: center, gap: sm, children: [ { type: icon, name: (if @e.set "check" "x"), size: sm }, { type: typography, variant: body, weight: medium, className: "break-all", content: @e.name }, { type: badge, variant: (if @e.set "success" "danger"), size: sm, label: (if @e.set "set" "missing") }, { type: typography, variant: caption, color: muted, className: "break-all", content: (if (= @shown null) (if (and @e.set (!= @e.tail "")) (str/concat "••••" @e.tail) "") (default @shown.value "")) }, (if (and (= @entity.guestIntegrations "live") @e.set (= @shown null)) { type: button, label: "Reveal", icon: eye, variant: ghost, size: sm, action: GUEST_TRACE_REVEAL_CHOSEN, actionPayload: { name: @e.name, via: "credentials" } } null)] })))) (array/map @entity.guestComputedCredentials (fn n { type: typography, variant: caption, color: muted, content: (str/concat @n " — its name is only known at run time") }))) }, { type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Inputs" }] (array/concat (if (= (array/len @entity.guestInputs) 0) [{ type: typography, variant: caption, color: muted, content: "No declared inputs" }] []) (array/map @entity.guestInputs (fn i { type: stack, direction: vertical, gap: xs, children: [{ type: stack, direction: horizontal, align: center, gap: sm, children: [{ type: typography, variant: body, weight: medium, className: "break-all", content: @i.address }, { type: button, label: "Send…", variant: ghost, size: sm, action: GUEST_INPUT_PICKED, actionPayload: { address: @i.address } }] }, { type: typography, variant: caption, color: muted, className: "break-all", content: (str/join (array/map (default @i.payloadSchema []) (fn f (str/concat @f.name ": " (default @f.type "")))) ", ") }, (if (= @entity.guestInputPick @i.address) { type: stack, direction: vertical, gap: xs, children: [{ type: input, inputType: textarea, rows: 4, label: "Payload", value: @entity.guestInputText, onChange: GUEST_INPUT_TYPED, placeholder: "Payload as JSON" }, { type: button, label: "Send", icon: play, variant: primary, size: sm, action: GUEST_INPUT_SENT }] } null)] })))) }, { type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Grants" }] (array/map @entity.guestGrantRows (fn r { type: stack, direction: vertical, gap: xs, children: [{ type: typography, variant: body, weight: medium, content: @r.kind }, { type: stack, direction: horizontal, gap: md, align: start, children: [{ type: stack, direction: vertical, gap: xs, className: "min-w-0 flex-1", children: (array/concat [{ type: typography, variant: caption, color: muted, content: "Declared" }] (array/concat (if (= (array/len @r.declared) 0) [{ type: typography, variant: caption, color: muted, content: "none" }] []) (array/map @r.declared (fn d { type: stack, direction: horizontal, align: center, gap: xs, children: [{ type: typography, variant: caption, className: "break-all", content: @d }, (if (array/includes @r.missing @d) { type: badge, variant: "danger", size: sm, label: "not held" } null)] })))) }, { type: stack, direction: vertical, gap: xs, className: "min-w-0 flex-1", children: (array/concat [{ type: typography, variant: caption, color: muted, content: "Held" }] (array/concat (if (= (array/len @r.effective) 0) [{ type: typography, variant: caption, color: muted, content: "none" }] []) (array/map @r.effective (fn d { type: typography, variant: caption, className: "break-all", content: @d })))) }] }] }))) }, { type: stack, direction: vertical, gap: sm, children: (if @entity.guestTraceAnswered (array/concat [{ type: stack, id: "guest-denials", direction: vertical, gap: xs, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Denied operations" }] (array/map @entity.guestDenials (fn d { type: stack, direction: horizontal, align: start, gap: sm, children: [{ type: typography, variant: caption, className: "break-all", content: @d.message }, (if (> @d.count 1) { type: badge, variant: "neutral", size: sm, label: (str/concat "×" @d.count) } null)] }))) }] (if (= (array/len @entity.guestDenials) 0) [{ type: typography, variant: caption, color: muted, content: "None" }] [])) [{ type: typography, variant: caption, color: muted, content: "Reading what the guest was refused" }]) }, { type: stack, direction: vertical, gap: sm, children: (array/concat [{ type: typography, variant: label, weight: semibold, content: "Integrations" }] [{ type: stack, direction: horizontal, gap: md, align: start, children: [{ type: stack, direction: vertical, gap: xs, className: "min-w-0 flex-1", children: (array/concat [{ type: typography, variant: caption, color: muted, content: "Hosts (tcp)" }] (let ((hosts (array/filter (default (object/get @dg "net") []) (fn n (array/includes @n.kinds "tcp"))))) (array/concat (if (= (array/len @hosts) 0) [{ type: typography, variant: caption, color: muted, content: "none" }] []) (array/map @hosts (fn n { type: typography, variant: caption, className: "break-all", content: (str/concat @n.target " [tcp]") }))))) }, { type: stack, direction: vertical, gap: xs, className: "min-w-0 flex-1", children: (array/concat [{ type: typography, variant: caption, color: muted, content: "Environment names" }] (array/concat (if (= (array/len @entity.guestEnvironment) 0) [{ type: typography, variant: caption, color: muted, content: "none" }] []) (array/map @entity.guestEnvironment (fn e { type: typography, variant: caption, className: "break-all", content: @e.name })))) }] }]) }] }))] }] [])) })
    }

    emits {
      GUEST_SHOWN
      GUEST_SEND -> external {
        guest : string!
        address : string!
        event : event!
        payload : @payload event?
      }
        @description "A control of the guest was used: the session steps it."
      GUEST_NAVIGATE -> external {
        guest : string!
        route : string!
      }
        @description "A link inside the guest was followed: the session opens that route in the guest."
      GUEST_PERSONA_PICK -> external {
        guest : string!
        persona : string!
      }
        @description "A persona of the picker was chosen: the session signs the guest's session in as that persona and runs its pages again."
      GUEST_INTEGRATIONS_PICK -> external {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "The integrations switch was flipped: the session opens the guest again with live or mocked integrations."
      GUEST_TRACE_ASK -> external {
        guest : string!
      }
        @description "The trace sidebar opened, or the guest it shows changed: the session answers what the guest declares and holds."
      GUEST_CREDENTIAL -> external {
        guest : string!
        token : string!
      }
      GUEST_INPUT_SEND -> external {
        guest : string!
        address : string!
        text : string!
      }
        @description "Send one declared input to the open guest, its payload as JSON text."
      GUEST_TRACE_REVEAL -> external {
        guest : string!
        name : string!
        via : "environment" | "credentials"!
      }
        @description "A Reveal button of the trace sidebar was pressed: the session answers that environment value when the launchpad is bound to loopback."
    }

    listens {
      GuestSession.GUEST_PAINTS -> GUEST_PAINTS
      GuestSession.GUEST_ERROR -> GUEST_ERROR
      GuestSession.GUEST_NOTICE -> GUEST_NOTICE
      GuestSession.GUEST_SIGN_IN -> GUEST_SIGN_IN
      GUEST_SIGN_IN {
        guest : string!
      }
      GUEST_GOOGLE_IN {
        uid : string
        email : string
        displayName : string
        idToken : string
      }
      GUEST_GOOGLE_FAILED {
        error : string!
        kind : string
      }
      GuestSession.GUEST_CLEARED -> GUEST_CLEARED
      GuestSession.GUEST_THEME -> GUEST_THEME
      GuestSession.GUEST_PERSONAS -> GUEST_PERSONAS
      GuestSession.GUEST_INTEGRATIONS -> GUEST_INTEGRATIONS
      GuestSession.GUEST_TRACE -> GUEST_TRACE
      GuestSession.GUEST_TRACE_REVEALED -> GUEST_TRACE_REVEALED
      GUEST_TRACE {
        guest : string!
        header : GuestHeader?
        workdir : string!
        environment : [GuestEnvStatus]!
        credentials : [GuestCredentialStatus]!
        computedCredentials : [string]!
        denials : [GuestDenial]!
        inputs : [GuestInput]!
        rows : [GuestGrantRow]!
      }
      GUEST_TRACE_REVEALED {
        guest : string!
        name : string!
        via : "environment" | "credentials"!
        value : string?
      }
      GUEST_TRACE_TOGGLED { }
        @description "The trace button was pressed: the sidebar opens or closes."
      GUEST_SIGN_IN_CHOSEN { }
        @description "The sign-in button was pressed: the Google sign-in runs."
      GUEST_TRACE_CLOSED { }
        @description "The sidebar's close control was used."
      GUEST_TRACE_REVEAL_CHOSEN {
        name : string!
        via : "environment" | "credentials"!
      }
        @description "A Reveal button of the environment table was pressed."
      GUEST_INPUT_PICKED {
        address : string!
      }
        @description "An input of the trace sidebar's Inputs list was chosen to send."
      GUEST_INPUT_TYPED {
        value : string!
      }
        @description "The payload text of the chosen input changed."
      GUEST_INPUT_SENT { }
        @description "The Send button of the chosen input was pressed."
      GUEST_INTEGRATIONS {
        guest : string!
        integrations : "mock" | "live"!
      }
      GUEST_INTEGRATIONS_CHOSEN {
        checked : boolean!
      }
        @description "The viewer flipped the integrations switch: on is live, off is mock."
      GUEST_PERSONAS {
        guest : string!
        personas : [GuestPersonaOption]!
        current : string!
      }
      GUEST_PERSONA_CHOSEN {
        itemId : string!
        label : string
      }
        @description "The viewer chose a persona of the picker."
      GUEST_PAINTS {
        guest : string!
        route : string!
        page : [string]!
        paints : [GuestPaint]!
        seq : number!
      }
      GUEST_ERROR {
        message : string!
      }
      GUEST_NOTICE {
        message : string!
      }
      GUEST_CLEARED { }
      GUEST_THEME { theme : GuestTheme! }
        @description "The theme the program being opened declares; sent only when it declares one, after GUEST_CLEARED."
        @tier "internal"
      GUEST_CONTROL {
        guest : string!
        address : string!
        event : event!
        payload : @payload event?
      }
      GUEST_ROUTE {
        guest : string!
        route : string!
      }
    }
  }

  page "/" as GuestSessionPage -> GuestSession, GuestOpener, GuestMarks, GuestStage
}
