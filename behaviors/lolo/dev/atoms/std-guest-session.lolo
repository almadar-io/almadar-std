app std-guest-session [
  version: "1.0.0",
  description: "std-guest-session — runs a program picked at run time as a guest session on the kernel, and paints it. GuestSession (server) resolves std-mock-page-seed as it mounts, and takes GUEST_OPEN { program } (a resolved program value, closing any guest already open), resolves std-mock-page-seed once, composes it with the program (program/compose, unless the program already declares the mock_seed_marks store) and opens the composed program with program/open, so the guest seeds each routed page's entities on its first visit inside its own kernel (EXEC-SEED-7), keeps the latest paint of every trait per slot (embedded children included) and emits GUEST_PAINTS { guest, paints } and GUEST_MOVED { guest, moves } (the transitions its traits took); a failed open is GUEST_ERROR { message }, a failed step is GUEST_NOTICE { message }, and GUEST_FAIL { message } lets the host that could not obtain a program say so the same way. GUEST_NAVIGATE { guest, route } opens that route in the guest with program/navigate. GUEST_SEND { guest, address, event, payload } steps the guest with program/dispatch when guest is the open one and is ignored for any other; GUEST_RESET closes it. GUEST_CLEARED tells the painter the guest is gone. GuestStage (client) keeps the paint, shows one guest-view for the configured slot holding the paint of every page-root trait in paint order (never an embedded child's; its source is the first root), and hands it every paint of the guest so an embedded @trait.X resolves to the guest's trait (a skeleton until the guest has painted, an alert when it failed) and turns a control of the guest it shows into GUEST_SEND. The host composes both traits under these names, supplies the program value, and embeds GuestStage inside its own chrome with @trait.GuestStage.",
  egress: [],
  kernel: { "guest": [spawn] },
  env: ["FIREBASE_AUTH_EMULATOR_HOST", "ALMADAR_PERSONA_OWNS"]
]
;; @capabilities "run a program chosen at run time as a live guest, paint it, forward its controls, close it"

uses Marks from "std/behaviors/std-mock-seed-marks"

type GuestProgram = { name : string, orbitals : [orbital] }
type GuestPaint = { slot : string!, trait : string!, orbital : string?, embedded : boolean!, content : node? }
type GuestMove = { trait : string!, event : string?, from : string!, to : string!, fired : boolean! }
type GuestOpened = { guest : string!, page : [string]!, route : string, rendered : [GuestPaint]!, outcomes : [GuestMove]! }
type GuestNavigated = { page : [string]!, route : string, rendered : [GuestPaint]!, outcomes : [GuestMove]! }
type GuestStepped = { rendered : [GuestPaint]!, outcomes : [GuestMove]! }
type GuestClosed = { closed : boolean! }
type GuestPersonaOption = { id : string!, name : string, role : string }
type GuestPersonasReply = { success : boolean, personas : [GuestPersonaOption] }
type GuestAnswer = { status : number, body : string, subject : string, error : string }
type GuestEmitted = { event : string!, payload : GuestAnswer? }
type GuestAnswered = { emitted : [GuestEmitted]? }

orbital GuestSessionOrbital {
  entity GuestRun [runtime] {
    id : string!
    guestHandle : string = ""
    guestPaints : [GuestPaint] = []
    guestRoute : string @description "The route the guest shows, as program/open or program/navigate resolved it; empty when no page matched." = ""
    guestPage : [string] @description "The traits of the page the guest shows: its page-root paints are the ones drawn." = []
    guestError : string = ""
    guestProgram : GuestProgram? @description "The program value being opened, held only until program/compose or program/open takes it: the entity rides every request a stateless host's client posts."
    guestSeed : behavior?
    guestSeeded : boolean @description "Whether the catalog composed std-mock-page-seed into the open guest, so its seeder answers the personas it wrote." = false
    guestPersonaTrait : string @description "The guest's trait that lists personas and signs its session in as one (std-mock-seed-marks personaTrait); persona asks name it, since it may sit on a page the guest has not mounted." = ""
    guestDefaultRole : string @description "The role the open guest is signed in as when it opens: the first declared value of its [identity] entity's role field (std-mock-seed-marks defaultRole); empty without one." = ""
    guestPersona : string @description "The persona the guest's session was last signed in as by a pick: an identity row id; empty until one is picked." = ""
    guestPersonas : [GuestPersonaOption] @description "The personas the guest's std-dev-personas listed, shown by the stage as its picker." = []
    guestIntegrations : "mock" | "live" @description "How the guest reaches real services: mock opens it with no credentials and every row in its own store, live with the opener's credentials and its declared store drivers (program/open integrations)." = mock
  }

  trait GuestMarks = Marks.traits.MarksCheck {
    listens {
      GuestSession.GUEST_SEED_ASK -> MARKS_CHECK
    }
  }

  trait GuestSession -> GuestRun {
    config {
      seedTrait : string = "MockDataMockSeed"
        @label "Seeder trait"
        @description "The composed std-mock-page-seed trait (MockData's MockSeed) the guest asks for the personas it seeded."
        @tier "internal"
      guestEnv : [string] = ["FIREBASE_AUTH_EMULATOR_HOST", "ALMADAR_PERSONA_OWNS"]
        @label "Guest environment"
        @description "The environment variables a guest may read, passed as its env grant at program/open: the Auth emulator host its persona sign-in checks and the persona-owns list its seeder reads. The orbital's own env grant covers them."
        @tier "policy"
    }

    initial: idle

    state idle {
      INIT -> idle when (= @entity.guestSeed null)
        (behavior/resolve { behavior: "std/behaviors/std-mock-page-seed" } {} { emit: { success: GUEST_SEED_RESOLVED, failure: GUEST_SEED_FAILED } })
      INIT -> idle when (!= @entity.guestSeed null)
      GUEST_OPEN -> opening
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
        (set @entity.guestProgram ?program)
        (set @entity.guestPersona "")
        (emit GUEST_PREPARE {})
      GUEST_FAIL -> idle
        (emit GUEST_ERROR { message: ?message })
      GUEST_RESET -> idle
        (emit GUEST_CLEARED {})
      GUEST_OPENED -> idle
        (program/close ?result.guest { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
      GUEST_FAILED -> idle
      GUEST_TICKED -> idle
      GUEST_TICKS_FAILED -> idle
      GUEST_CLOSED -> idle
      GUEST_CLOSE_FAILED -> idle
      GUEST_PREPARE -> idle
      GUEST_SEED_RESOLVED -> idle
        (set @entity.guestSeed ?result)
      GUEST_SEED_FAILED -> idle
      GUEST_SEED_MARKED -> idle
      GUEST_PERSONAS_RESOLVED -> idle
      GUEST_COMPOSED -> idle
      GUEST_PERSONAS_ASK -> idle
      GUEST_INTEGRATIONS_PICK -> idle
        (set @entity.guestIntegrations ?integrations)
        (emit GUEST_INTEGRATIONS { guest: "", integrations: @entity.guestIntegrations })
    }

    state opening {
      INIT -> idle
      GUEST_OPEN -> opening
        (emit GUEST_CLEARED {})
        (set @entity.guestProgram ?program)
        (set @entity.guestPersona "")
        (emit GUEST_PREPARE {})
      GUEST_OPENED -> live
        (set @entity.guestHandle ?result.guest)
        (set @entity.guestPage ?result.page)
        (set @entity.guestRoute (default ?result.route ""))
        (set @entity.guestPaints (array/reduce ?result.rendered [] (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
        (emit GUEST_PERSONAS_ASK {})
        (emit GUEST_INTEGRATIONS { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (program/live { kind: "guest", guest: ?result.guest } { key: (str/concat "guest-ticks-" ?result.guest), emit: { onMessage: GUEST_TICKED, failure: GUEST_TICKS_FAILED } })
      GUEST_FAILED -> idle
        (emit GUEST_ERROR { message: ?error })
      GUEST_PREPARE -> opening when (= @entity.guestSeed null)
        (behavior/resolve { behavior: "std/behaviors/std-mock-page-seed" } {} { emit: { success: GUEST_SEED_RESOLVED, failure: GUEST_FAILED } })
      GUEST_SEED_RESOLVED -> opening when (= @entity.guestSeed null)
        (set @entity.guestSeed ?result)
        (emit GUEST_PREPARE {})
      GUEST_SEED_RESOLVED -> opening when (!= @entity.guestSeed null)
      GUEST_SEED_FAILED -> opening
      GUEST_PREPARE -> opening when (!= @entity.guestSeed null)
        (emit GUEST_SEED_ASK { program: @entity.guestProgram })
      GUEST_SEED_MARKED -> opening when @payload.marked
        (set @entity.guestSeeded false)
        (set @entity.guestDefaultRole (default @payload.defaultRole ""))
        (set @entity.guestPersonaTrait (default @payload.personaTrait ""))
        (program/open @entity.guestProgram { grants: { env: @config.guestEnv }, declared: true, integrations: @entity.guestIntegrations } { emit: { success: GUEST_OPENED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_SEED_MARKED -> opening when (and (not @payload.marked) (!= @payload.personasCollection ""))
        (set @entity.guestSeeded true)
        (set @entity.guestDefaultRole (default @payload.defaultRole ""))
        (set @entity.guestPersonaTrait (default @payload.personaTrait ""))
        (behavior/resolve (behavior/apply { behavior: "std/behaviors/std-dev-personas", orbital: "DevPersonasOrbital" } { entity: "DevPersona", persistence: "persistent", collection: @payload.personasCollection, traits: { DevPersonas: { config: { autoSignIn: @payload.personasSignIn } } } }) {} { emit: { success: GUEST_PERSONAS_RESOLVED, failure: GUEST_FAILED } })
      GUEST_PERSONAS_RESOLVED -> opening
        (program/compose [@entity.guestProgram, @entity.guestSeed, ?result] { appName: (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest") } { emit: { success: GUEST_COMPOSED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_SEED_MARKED -> opening when (and (not @payload.marked) (= @payload.personasCollection ""))
        (set @entity.guestSeeded true)
        (set @entity.guestDefaultRole (default @payload.defaultRole ""))
        (set @entity.guestPersonaTrait (default @payload.personaTrait ""))
        (program/compose [@entity.guestProgram, @entity.guestSeed] { appName: (object/get (default @entity.guestProgram { name: "guest", orbitals: [] }) "name" "guest") } { emit: { success: GUEST_COMPOSED, failure: GUEST_FAILED } })
        (set @entity.guestProgram null)
      GUEST_COMPOSED -> opening
        (program/open ?result { grants: { env: @config.guestEnv }, declared: true, integrations: @entity.guestIntegrations } { emit: { success: GUEST_OPENED, failure: GUEST_FAILED } })
      GUEST_FAIL -> idle
        (emit GUEST_ERROR { message: ?message })
      GUEST_RESET -> idle
        (emit GUEST_CLEARED {})
      GUEST_TICKED -> opening
      GUEST_TICKS_FAILED -> opening
      GUEST_CLOSED -> opening
      GUEST_CLOSE_FAILED -> opening
      GUEST_PERSONAS_STEPPED -> opening
      GUEST_PERSONAS_FAILED -> opening
      GUEST_PERSONA_ACTED -> opening
      GUEST_INTEGRATIONS_PICK -> opening
        (set @entity.guestIntegrations ?integrations)
        (emit GUEST_INTEGRATIONS { guest: "", integrations: @entity.guestIntegrations })
    }

    state live {
      INIT -> idle
      GUEST_OPEN -> opening
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle "")
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
        (set @entity.guestProgram ?program)
        (set @entity.guestPersona "")
        (emit GUEST_PREPARE {})
      GUEST_OPENED -> live
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle ?result.guest)
        (set @entity.guestPage ?result.page)
        (set @entity.guestRoute (default ?result.route ""))
        (set @entity.guestPaints (array/reduce ?result.rendered [] (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
        (emit GUEST_PERSONAS_ASK {})
        (emit GUEST_INTEGRATIONS { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (program/live { kind: "guest", guest: ?result.guest } { key: (str/concat "guest-ticks-" ?result.guest), emit: { onMessage: GUEST_TICKED, failure: GUEST_TICKS_FAILED } })
      GUEST_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_PREPARE -> live
      GUEST_SEED_RESOLVED -> live
      GUEST_SEED_FAILED -> live
      GUEST_SEED_MARKED -> live
      GUEST_PERSONAS_RESOLVED -> live
      GUEST_COMPOSED -> live
      GUEST_PERSONAS_ASK -> live
        (program/dispatch (if @entity.guestSeeded (str/concat @config.seedTrait ".SEED_PERSONAS_ASK") (if (= @entity.guestPersonaTrait "") "PERSONAS_REQUESTED" (str/concat @entity.guestPersonaTrait ".PERSONAS_REQUESTED"))) {} { guest: @entity.guestHandle, emit: { success: GUEST_PERSONAS_STEPPED, failure: GUEST_PERSONAS_FAILED } })
      GUEST_PERSONAS_STEPPED -> live when (and (= @entity.guestPersona "") (!= @entity.guestDefaultRole "") (array/some (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") {}) "body") "") GuestPersonasReply) {}) "personas") []))) (fn r (= (object/get @r "role" "") @entity.guestDefaultRole))))
        (set @entity.guestPersonas (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") {}) "body") "") GuestPersonasReply) {}) "personas") []))))
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: @entity.guestPersonas, current: @entity.guestPersona })
        (program/dispatch (if (= @entity.guestPersonaTrait "") "PERSONA_ACT_AS" (str/concat @entity.guestPersonaTrait ".PERSONA_ACT_AS")) { persona: (object/get (default (array/find @entity.guestPersonas (fn r (= (object/get @r "role" "") @entity.guestDefaultRole))) { id: "" }) "id" "") } { guest: @entity.guestHandle, emit: { success: GUEST_PERSONA_ACTED, failure: GUEST_STEP_FAILED } })
      GUEST_PERSONAS_STEPPED -> live when (not (and (= @entity.guestPersona "") (!= @entity.guestDefaultRole "") (array/some (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") {}) "body") "") GuestPersonasReply) {}) "personas") []))) (fn r (= (object/get @r "role" "") @entity.guestDefaultRole)))))
        (set @entity.guestPersonas (let ((seeded (array/find (default ?result.emitted []) (fn e (= @e.event "SEED_PERSONAS"))))) (if (!= @seeded null) (let ((none : [GuestPersonaOption] [])) (default (object/get (default (as (object/get @seeded "payload") GuestPersonasReply) { success: true, personas: @none }) "personas") @none)) (default (object/get (default (json/parse (default (object/get (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONAS_ANSWERED"))) {}) "payload") {}) "body") "") GuestPersonasReply) {}) "personas") []))))
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: @entity.guestPersonas, current: @entity.guestPersona })
      GUEST_PERSONAS_FAILED -> live
        (set @entity.guestPersonas [])
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: [], current: @entity.guestPersona })
      GUEST_PERSONA_PICK -> live when (= ?guest @entity.guestHandle)
        (program/dispatch (if (= @entity.guestPersonaTrait "") "PERSONA_ACT_AS" (str/concat @entity.guestPersonaTrait ".PERSONA_ACT_AS")) { persona: ?persona } { guest: ?guest, emit: { success: GUEST_PERSONA_ACTED, failure: GUEST_STEP_FAILED } })
      GUEST_PERSONA_PICK -> live when (!= ?guest @entity.guestHandle)
      GUEST_INTEGRATIONS_PICK -> live when (and (= ?guest @entity.guestHandle) (!= ?integrations @entity.guestIntegrations))
        (set @entity.guestIntegrations ?integrations)
        (emit GUEST_INTEGRATIONS { guest: @entity.guestHandle, integrations: @entity.guestIntegrations })
        (emit GUEST_REOPEN {})
      GUEST_INTEGRATIONS_PICK -> live when (or (!= ?guest @entity.guestHandle) (= ?integrations @entity.guestIntegrations))
      GUEST_PERSONA_ACTED -> live when (array/some (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGNED_IN")))
        (set @entity.guestPersona (default (object/get (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGNED_IN"))) {}) "payload") {}) "subject") ""))
        (emit GUEST_PERSONAS { guest: @entity.guestHandle, personas: @entity.guestPersonas, current: @entity.guestPersona })
        (program/navigate { guest: @entity.guestHandle, route: @entity.guestRoute, remount: true } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_PERSONA_ACTED -> live when (not (array/some (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGNED_IN"))))
        (emit GUEST_NOTICE { message: (default (object/get (default (object/get (default (array/find (default ?result.emitted []) (fn e (= @e.event "PERSONA_SIGN_IN_REFUSED"))) {}) "payload") {}) "error") "The persona could not be signed in") })
      GUEST_SEND -> live when (= ?guest @entity.guestHandle)
        (program/dispatch ?address ?payload { guest: ?guest, emit: { success: GUEST_STEPPED, failure: GUEST_STEP_FAILED } })
      GUEST_SEND -> live when (!= ?guest @entity.guestHandle)
      GUEST_STEPPED -> live
        (set @entity.guestPaints (array/reduce ?result.rendered @entity.guestPaints (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
      GUEST_STEP_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_TICKED -> live when (= ?guest @entity.guestHandle)
        (set @entity.guestPaints (array/reduce ?rendered @entity.guestPaints (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints })
      GUEST_TICKED -> live when (!= ?guest @entity.guestHandle)
      GUEST_TICKS_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_NAVIGATE -> live when (= ?guest @entity.guestHandle)
        (program/navigate { guest: ?guest, route: ?route } { emit: { success: GUEST_NAVIGATED, failure: GUEST_NAVIGATE_FAILED } })
      GUEST_NAVIGATE -> live when (!= ?guest @entity.guestHandle)
      GUEST_NAVIGATED -> live
        (set @entity.guestPage ?result.page)
        (set @entity.guestRoute (default ?result.route ""))
        (set @entity.guestPaints (array/reduce ?result.rendered @entity.guestPaints (fn acc p (array/concat (array/filter @acc (fn q (or (!= @q.trait @p.trait) (!= @q.slot @p.slot)))) (array/filter [@p] (fn x (!= @x.content null)))))))
        (emit GUEST_PAINTS { guest: @entity.guestHandle, route: @entity.guestRoute, page: @entity.guestPage, paints: @entity.guestPaints })
        (emit GUEST_MOVED { guest: @entity.guestHandle, moves: ?result.outcomes })
      GUEST_NAVIGATE_FAILED -> live
        (emit GUEST_NOTICE { message: ?error })
      GUEST_FAIL -> idle
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle "")
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
        (emit GUEST_ERROR { message: ?message })
      GUEST_RESET -> idle
        (program/close @entity.guestHandle { emit: { success: GUEST_CLOSED, failure: GUEST_CLOSE_FAILED } })
        (set @entity.guestHandle "")
        (set @entity.guestPaints [])
        (emit GUEST_CLEARED {})
      GUEST_CLOSED -> live
      GUEST_CLOSE_FAILED -> live
    }

    emits {
      GUEST_PAINTS -> external {
        guest : string!
        route : string!
        page : [string]!
        paints : [GuestPaint]!
      }
        @description "The guest's current paint of every trait for every slot it draws into, each saying whether its trait is embedded on the guest's page."
      GUEST_ERROR -> external {
        message : string!
      }
        @description "The guest could not be opened, or the host could not supply its program."
      GUEST_MOVED -> external {
        guest : string!
        moves : [GuestMove]!
      }
        @description "The transitions the guest's traits took while opening or on a step, in order."
      GUEST_NOTICE -> external {
        message : string!
      }
        @description "A step of the guest failed, or a second guest could not replace the open one."
      GUEST_CLEARED -> external { }
        @description "The previous guest is gone: a new one is opening or the session was reset."
      GUEST_PERSONAS -> external {
        guest : string!
        personas : [GuestPersonaOption]!
        current : string!
      }
        @description "The development personas the open guest lists (its std-dev-personas answers PERSONAS_REQUESTED, which a program without one or outside the Auth emulator answers with none), and the persona picked as the guest's viewer; empty current while the default persona is."
      GUEST_INTEGRATIONS -> external {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "How the guest reaches real services now (mock or live); guest is empty while none is open."
      GUEST_REOPEN -> external { }
        @description "The open guest must be opened again (its integrations changed): the host sends GUEST_OPEN with the same program."
      GUEST_OPENED {
        result : GuestOpened!
      }
      GUEST_FAILED {
        error : string!
      }
      GUEST_STEPPED {
        result : GuestStepped!
      }
      GUEST_STEP_FAILED {
        error : string!
      }
      GUEST_TICKED {
        guest : string!
        rendered : [GuestPaint]!
        key : string
      }
        @description "One pass of the open guest's own tick clock that painted something (program/live { kind: guest }): its page traits' ticks, [client] ones included, since a guest has no browser."
      GUEST_TICKS_FAILED {
        error : string!
      }
      GUEST_NAVIGATED {
        result : GuestNavigated!
      }
      GUEST_NAVIGATE_FAILED {
        error : string!
      }
      GUEST_CLOSED {
        result : GuestClosed!
      }
      GUEST_CLOSE_FAILED {
        error : string!
      }
      GUEST_PREPARE { }
      GUEST_SEED_ASK {
        program : GuestProgram?
      }
      GUEST_PERSONAS_ASK { }
      GUEST_PERSONAS_STEPPED {
        result : GuestAnswered!
      }
      GUEST_PERSONAS_FAILED {
        error : string!
      }
      GUEST_PERSONA_ACTED {
        result : GuestAnswered!
      }
      GUEST_PERSONAS_RESOLVED {
        result : behavior!
      }
      GUEST_SEED_RESOLVED {
        result : behavior!
      }
      GUEST_SEED_FAILED {
        error : string!
      }
      GUEST_COMPOSED {
        result : behavior!
      }
    }

    listens {
      GuestMarks.MARKS_CHECKED -> GUEST_SEED_MARKED
      GUEST_SEED_MARKED {
        marked : boolean!
        personas : string!
        personasCollection : string!
        personasSignIn : string!
        defaultRole : string!
        personaTrait : string!
      }
      GuestStage.GUEST_INTEGRATIONS_PICK -> GUEST_INTEGRATIONS_PICK
      GUEST_INTEGRATIONS_PICK {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "The viewer switched the guest between mocked and live integrations: the guest is opened again that way."
      GuestStage.GUEST_PERSONA_PICK -> GUEST_PERSONA_PICK
      GUEST_PERSONA_PICK {
        guest : string!
        persona : string!
      }
        @description "A persona was picked for the open guest: its session is signed in as that persona (PERSONA_ACT_AS into the guest's std-dev-personas), then every mounted trait of the guest runs its INIT again so its lists fetch as the new viewer."
      GUEST_OPEN -> input {
        program : GuestProgram!
      }
        @description "Open a resolved program as the guest, closing the one already open."
        @synonyms "run a program live, mount a behavior at run time, open a guest session"
      GUEST_FAIL -> input {
        message : string!
      }
        @description "The host could not obtain a program to open: report it as the guest's error."
      GuestStage.GUEST_SEND -> GUEST_SEND
      GuestStage.GUEST_NAVIGATE -> GUEST_NAVIGATE
      GUEST_NAVIGATE {
        guest : string!
        route : string!
      }
      GUEST_SEND {
        guest : string!
        address : string!
        event : event!
        payload : @payload event?
      }
      GUEST_RESET { }
        @description "Close the open guest and clear the paint."
    }
  }

  trait GuestStage -> GuestRun [client] {
    config {
      slot : string = "main"
        @label "Guest slot"
        @description "The slot of the guest's page-root paint this stage shows."
        @tier "domain"
      className : string = ""
        @label "Class name"
        @description "Classes of the box that holds the guest's paint."
        @tier "presentation"
      errorTitle : string = ""
        @label "Error title"
        @description "Title of the alert shown when the guest could not be run; none when empty."
        @tier "presentation"
      pending : "card" | "detail" = card
        @label "Placeholder"
        @description "The skeleton shown until the guest has painted."
        @tier "presentation"
      pendingRows : number = 2
        @label "Placeholder rows"
        @tier "presentation"
      unpaintedTitle : string = "Nothing to show here on its own"
        @label "Unpainted title"
        @description "The title shown when the opened guest painted nothing into the configured slot."
        @tier "presentation"
      unpaintedNothing : string = "The behavior painted nothing when it opened; it draws in answer to an event a host sends it."
        @label "Nothing painted"
        @description "The message when the opened guest painted no slot at all."
        @tier "presentation"
      unpaintedOthers : string = "It paints only into these slots, which a host page opens: "
        @label "Other slots painted"
        @description "The message before the list of slots the opened guest did paint."
        @tier "presentation"
      personasLabel : string = "Viewing as"
        @label "Personas label"
        @description "The caption before the personas the guest lists, which the viewer picks to open the guest as that persona."
        @tier "presentation"
      integrationsLabel : string = "Real integrations"
        @label "Integrations label"
        @description "The label of the switch beside the persona picker that opens the guest again with live integrations (on) or mocked ones (off)."
        @tier "presentation"
    }
    initial: idle

    state idle {
      INIT -> idle
        (emit GUEST_SHOWN {})
      GUEST_PAINTS -> idle
        (set @entity.guestHandle ?guest)
        (set @entity.guestError "")
        (set @entity.guestPage ?page)
        (set @entity.guestRoute ?route)
        (set @entity.guestPaints ?paints)
        (emit GUEST_SHOWN {})
      GUEST_ERROR -> idle
        (set @entity.guestError ?message)
        (emit GUEST_SHOWN {})
      GUEST_NOTICE -> idle
        (notify error ?message)
      GUEST_PERSONAS -> idle when (= ?guest @entity.guestHandle)
        (set @entity.guestPersonas ?personas)
        (set @entity.guestPersona ?current)
        (emit GUEST_SHOWN {})
      GUEST_PERSONAS -> idle when (!= ?guest @entity.guestHandle)
      GUEST_INTEGRATIONS -> idle when (or (= ?guest "") (= ?guest @entity.guestHandle))
        (set @entity.guestIntegrations ?integrations)
        (emit GUEST_SHOWN {})
      GUEST_INTEGRATIONS -> idle when (and (!= ?guest "") (!= ?guest @entity.guestHandle))
      GUEST_INTEGRATIONS_CHOSEN -> idle when (!= @entity.guestHandle "")
        (emit GUEST_INTEGRATIONS_PICK { guest: @entity.guestHandle, integrations: (if ?checked live mock) })
      GUEST_INTEGRATIONS_CHOSEN -> idle when (= @entity.guestHandle "")
      GUEST_PERSONA_CHOSEN -> idle when (and (!= @entity.guestHandle "") (!= @payload.itemId @entity.guestPersona))
        (emit GUEST_PERSONA_PICK { guest: @entity.guestHandle, persona: @payload.itemId })
      GUEST_PERSONA_CHOSEN -> idle when (or (= @entity.guestHandle "") (= @payload.itemId @entity.guestPersona))
      GUEST_CLEARED -> idle
        (set @entity.guestHandle "")
        (set @entity.guestPersonas [])
        (set @entity.guestPaints [])
        (set @entity.guestPage [])
        (set @entity.guestRoute "")
        (set @entity.guestError "")
        (emit GUEST_SHOWN {})
      GUEST_CONTROL -> idle when (= ?guest @entity.guestHandle)
        (emit GUEST_SEND { guest: ?guest, address: ?address, event: ?event, payload: ?payload })
      GUEST_CONTROL -> idle when (!= ?guest @entity.guestHandle)
      GUEST_ROUTE -> idle when (= ?guest @entity.guestHandle)
        (emit GUEST_NAVIGATE { guest: ?guest, route: ?route })
      GUEST_ROUTE -> idle when (!= ?guest @entity.guestHandle)
      GUEST_SHOWN -> idle
        (render-ui main { type: box, className: @config.className, children: (array/concat (if (and (= @entity.guestError "") (!= @entity.guestHandle "")) (let ((current (default (array/find @entity.guestPersonas (fn p (= @p.id @entity.guestPersona))) (default (array/first @entity.guestPersonas) { id: "", name: "", role: "" }))) (currentRole (default @current.role "")) (currentName (default @current.name ""))) [{ type: stack, direction: horizontal, justify: end, align: center, gap: md, className: "px-4 py-2 border-b border-border", children: (array/concat [
            { type: switch, label: @config.integrationsLabel, checked: (= @entity.guestIntegrations live), action: GUEST_INTEGRATIONS_CHOSEN }
          ] (if (= (array/len @entity.guestPersonas) 0) [] [
            { type: menu, position: bottom-end, trigger: { type: button, variant: ghost, size: sm, rightIcon: chevron-down, children: [{ type: stack, direction: horizontal, align: center, gap: sm, children: [
              { type: icon, name: user-round, size: sm },
              { type: stack, direction: vertical, gap: none, align: start, children: [
                { type: typography, variant: caption, color: muted, content: @config.personasLabel },
                { type: typography, variant: body, weight: semibold, content: (if (= @currentRole "") (if (= @currentName "") @current.id @currentName) @currentRole) },
                (if (or (= @currentRole "") (= @currentName "")) null { type: typography, variant: caption, color: muted, content: @currentName })
              ] }
            ] }] }, items: (array/map @entity.guestPersonas (fn p { id: @p.id, label: (if (= (default @p.role "") "") (default @p.name @p.id) (default @p.role "")), description: (if (= (default @p.role "") "") "" (default @p.name "")), icon: (if (= @p.id @current.id) "check" "user-round"), event: GUEST_PERSONA_CHOSEN })) }
          ])) }]) []) [
          (if (!= @entity.guestError "")
            { type: container, size: md, padding: lg, children: [(if (= @config.errorTitle "") { type: alert, variant: error, message: @entity.guestError } { type: alert, variant: error, title: @config.errorTitle, message: @entity.guestError })] }
            (let ((slotRoots (array/filter @entity.guestPaints (fn p (and (= @p.slot @config.slot) (= @p.embedded false) (array/includes @entity.guestPage @p.trait))))) (paint (array/first (array/filter @entity.guestPaints (fn p (and (= @p.slot @config.slot) (= @p.embedded false) (array/includes @entity.guestPage @p.trait)))))))
              (if (= @paint null)
                (if (= @entity.guestHandle "")
                  { type: container, size: full, padding: md, children: [{ type: skeleton, variant: @config.pending, rows: @config.pendingRows }] }
                  { type: container, size: md, padding: lg, children: [{ type: alert, variant: info, title: @config.unpaintedTitle, message: (let ((roots (array/filter @entity.guestPaints (fn p (= @p.embedded false))))) (if (= (array/len @roots) 0) @config.unpaintedNothing (str/concat @config.unpaintedOthers (str/join (array/map @roots (fn p @p.slot)) ", ")))) }] })
                { type: guest-view, guest: @entity.guestHandle, source: @paint.trait, deliver: GUEST_CONTROL, navigate: GUEST_ROUTE, route: @entity.guestRoute, paints: @entity.guestPaints, children: (array/map @slotRoots (fn p @p.content)) })))
        ]) })
    }

    emits {
      GUEST_SHOWN
      GUEST_SEND -> external {
        guest : string!
        address : string!
        event : event!
        payload : @payload event?
      }
        @description "A control of the guest was used: the session steps it."
      GUEST_NAVIGATE -> external {
        guest : string!
        route : string!
      }
        @description "A link inside the guest was followed: the session opens that route in the guest."
      GUEST_PERSONA_PICK -> external {
        guest : string!
        persona : string!
      }
        @description "A persona of the picker was chosen: the session signs the guest's session in as that persona and runs its pages again."
      GUEST_INTEGRATIONS_PICK -> external {
        guest : string!
        integrations : "mock" | "live"!
      }
        @description "The integrations switch was flipped: the session opens the guest again with live or mocked integrations."
    }

    listens {
      GuestSession.GUEST_PAINTS -> GUEST_PAINTS
      GuestSession.GUEST_ERROR -> GUEST_ERROR
      GuestSession.GUEST_NOTICE -> GUEST_NOTICE
      GuestSession.GUEST_CLEARED -> GUEST_CLEARED
      GuestSession.GUEST_PERSONAS -> GUEST_PERSONAS
      GuestSession.GUEST_INTEGRATIONS -> GUEST_INTEGRATIONS
      GUEST_INTEGRATIONS {
        guest : string!
        integrations : "mock" | "live"!
      }
      GUEST_INTEGRATIONS_CHOSEN {
        checked : boolean!
      }
        @description "The viewer flipped the integrations switch: on is live, off is mock."
      GUEST_PERSONAS {
        guest : string!
        personas : [GuestPersonaOption]!
        current : string!
      }
      GUEST_PERSONA_CHOSEN {
        itemId : string!
        label : string
      }
        @description "The viewer chose a persona of the picker."
      GUEST_PAINTS {
        guest : string!
        route : string!
        page : [string]!
        paints : [GuestPaint]!
      }
      GUEST_ERROR {
        message : string!
      }
      GUEST_NOTICE {
        message : string!
      }
      GUEST_CLEARED { }
      GUEST_CONTROL {
        guest : string!
        address : string!
        event : event!
        payload : @payload event?
      }
      GUEST_ROUTE {
        guest : string!
        route : string!
      }
    }
  }

  page "/" as GuestSessionPage -> GuestSession, GuestMarks, GuestStage
}
