    seededAt : number @description "When the composed seed wrote its dataset, in epoch milliseconds." = 0
  }

  trait MockStream = Rand.traits.MockRandom -> MockCell {
    listens {
      MockSeed.CORPUS_ASK -> CORPUS_ASK
