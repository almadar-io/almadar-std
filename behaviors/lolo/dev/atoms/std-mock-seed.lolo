        (emit OWNERS_DERIVED { owners: (object/fromEntries (array/map (array/filter @entity.dsRegsAll (fn r (> (array/len (object/get @r "ownerCols")) 0))) (fn r [(str/lower (object/get @r "label")), (object/get @r "ownerCols")]))) })
    }

    emits {
      WALKED -> external {
        cells : [MockWalkCell]
        value : MockValue?
      }
        @description "A field or row walk finished: the sampled cells in pre-order and the assembled value."
        @tier "domain"
      ROWS_DONE -> external {
        rows : [Map string MockValue?]
      }
        @description "The sampled rows of an entity, each with its Name-n id."
        @tier "domain"
      ROW_WALKED -> internal { row : Map string MockValue? }
        @description "A declared row root assembled once for the row collection callback."
        @tier "internal"
      SEED_ROW_DONE -> external {
        row : Map string MockValue?
      }
        @description "A seeded store row: its Name Id n id, created and updated stamps drawn from the stream, then its fields."
        @tier "domain"
      STREAM_SEEDED -> external {
        seed : number
        nowMs : number
      }
        @description "The stream was reset to a seed and clock."
        @tier "domain"
      RESTAMP_DONE -> external {
        journal : SeedOwnerJournal!
        changes : [SeedOwnerChange]!
      }
        @description "The updated owner journal and ordered owner-cell writes or row-key moves, each with an explicit row target (singleton for a runtime entity, else the changed row key), with no reseeding."
        @tier "domain"
      DATASET_DONE -> external {
        stores : Map string [Map string MockValue?]
        journal : SeedOwnerJournal!
        defaultPersona : string
      }
        @description "The whole seeded dataset: every store rows, identity first, owner columns stamped and relations linked."
        @tier "domain"
      OWNERS_DERIVED -> external {
        owners : Map string [string]
      }
        @description "The owner columns of each entity, by lower-case entity name."
        @tier "domain"
      DS_STAMP { at : number }
        @description "Internal: the next owner stamp"
        @tier "internal"
      DS_OLINK { at : number }
        @description "Internal: the next owner link"
        @tier "internal"
      DS_PROJS { at : number }
        @description "Internal: the projected fields"
        @tier "internal"
      DS_WRITTEN {  }
        @description "Internal: the seeded rows were written"
        @tier "internal"
      DS_RESTAMPED {  }
        @description "Internal: the owner changes were written"
        @tier "internal"
      DS_WRITE_FAILED { error : string }
        @description "Internal: a seed write failed"
        @tier "internal"
      DS_WRITE_NEXT { at : number }
        @description "Internal: the next owner chunk"
        @tier "internal"
      DS_CHUNK_WRITTEN {  }
        @description "Internal: an owner chunk was written"
        @tier "internal"
      DS_CHUNK_REFUSED { error : string }
        @description "Internal: an owner chunk was refused"
        @tier "internal"
      DS_WRITER { at : number }
        @description "Internal: the next row writer"
        @tier "internal"
      DS_SELF_READ { result : SeedProgram }
        @description "Internal: the running app program was read"
        @tier "internal"
      DS_MARK_FOUND { data : MockSeedMark! }
        @description "Internal: the seed marker exists"
        @tier "internal"
      DS_MARK_ABSENT { error : string  code : string }
        @description "Internal: no seed marker, or the store failed"
        @tier "internal"
      AC_ASK { at : number }
        @description "Internal: ask the next access check"
        @tier "internal"
      AC_ANSWER { allowed : boolean }
        @description "Internal: an access check verdict"
        @tier "internal"
      AC_FAILED { error : string }
        @description "Internal: an access check could not be evaluated"
        @tier "internal"
      AC_DONE { at : number }
        @description "Internal: all checks answered"
        @tier "internal"
      DATASET_FAILED -> external {
        error : string
      }
        @description "The program could not be read or a consumed identity ID was not a primitive; the request stops without a success journal."
        @tier "domain"
      CORPUS_ASK { }
        @description "Internal: ask the stream for its word corpus."
        @tier "internal"
      ROWS_NEXT { at : number }
        @description "Internal: sample the next row."
        @tier "internal"
      DS_STORE { at : number }
        @description "Internal: run the next store registration."
        @tier "internal"
      WALK_ROW { fields : [MockFieldSpec]!  entityName : string  index : number  seeded : boolean  identity : boolean  runtime : boolean  nowMs : number }
        @description "Internal: sample one row of fields."
        @tier "internal"
      DS_OWNS_ENV { value : string }
        @description "Internal: the owner environment variable answered."
        @tier "internal"
      DS_OWNS_ENV_FAILED { error : string }
        @description "Internal: the owner environment variable could not be read."
        @tier "internal"
      DS_PROGRAM_READ { result : SeedProgram }
        @description "Internal: the program was lowered."
        @tier "internal"
      DS_PROGRAM_FAILED { error : string }
        @description "Internal: the program could not be lowered."
        @tier "internal"
      DS_LINKS { at : number }
        @description "Internal: fill the relation links."
        @tier "internal"
    }

    listens {
      WALK_START { spec : MockFieldSpec!  name : string!  entityName : string!  index : number!  seeded : boolean!  runtime : boolean!  nowMs : number! }
        @description "Sample one field by walking its declared field tree with the seeded stream or the row ordinal."
        @synonyms "sample field, field tree"
      WALK_ROW { fields : [MockFieldSpec]!  entityName : string  index : number  seeded : boolean  identity : boolean  runtime : boolean  nowMs : number }
        @description "Sample one row of an entity fields: reserved keys skipped, optional undefaulted fields left unset on even seeded rows."
        @synonyms "sample row"
      SAMPLE_ROWS { fields : [MockFieldSpec]!  name : string!  count : number!  runtime : boolean!  identity : boolean! }
        @description "Sample an entity rows by the index strategy: one row for a runtime singleton, else count rows, each with its Name-n id."
        @synonyms "sample rows, mock rows"
      ROWS_NEXT { at : number }
        @description "Sample the next row."
        @synonyms "next row"
      ROW_WALKED { row : Map string MockValue? }
        @description "Internal: a declared row root completed the shared assembler."
        @synonyms "row sampled"
      SEED_STREAM { seed : number!  nowMs : number! }
        @description "Start a store stream: reset it to a seed and the clock the stamps and relative dates draw against."
        @synonyms "start stream"
      SEED_ROW { fields : [MockFieldSpec]!  label : string!  n : number!  index : number!  identity : boolean!  runtime : boolean!  nowMs : number! }
        @description "Seed one row of a mock store the way the kernel does: the Label Id n id, createdAt and updatedAt drawn first from the stream, then the seeded fields."
        @synonyms "seed row, mock store row"
      RESTAMP_INPUT { program : SeedProgram!  stores : Map string [Map string MockValue?]!  journal : SeedOwnerJournal!  viewer : Viewer  firstOwner : boolean }
        @description "Restamp only retained seed-owner cells against current rows and the full current viewer, retaining legacy fallback and rekey behavior."
        @synonyms "restamp seed owners, switch seed persona"
      DATASET_INPUT { program : SeedProgram!  count : number  seed : number  nowMs : number!  viewerId : string!  ownerPairs : [SeedOwnerPair]!  locale : string }
        @description "Seed an already-resolved program with explicit owner pairs and optional locale, without reading program text or environment variables."
        @synonyms "seed resolved dataset, embedded mock dataset"
      DATASET_START { source : string!  count : number!  seed : number!  nowMs : number!  viewerId : string! }
        @description "Seed a whole mock dataset from a program the way the kernel does: read the program, derive the store order, owner columns and relation links from it, seed the identity store first, then each store with stamps drawn from one stream, owner columns stamped for the viewer, later registrants backfilled, and relations and projected fields linked."
        @synonyms "seed dataset, mock dataset"
      DS_OWNS_ENV { value : string }
        @description "The ALMADAR_PERSONA_OWNS value."
        @synonyms "owner env"
      DS_OWNS_ENV_FAILED { error : string }
        @description "The owner environment variable could not be read."
        @synonyms "owner env failed"
      DS_PROGRAM_READ { result : SeedProgram }
        @description "The program lowered by program/read."
        @synonyms "program read"
      DS_PROGRAM_FAILED { error : string }
        @description "The program could not be read."
        @synonyms "program failed"
      DS_STORE { at : number }
        @description "Run the next store registration."
        @synonyms "next store"
      DS_LINKS { at : number }
        @description "Fill the relation links and projected fields."
        @synonyms "links"
      DERIVE_OWNERS { result : SeedProgram! }
        @description "Derive the owner columns of a lowered program: identity-typed relations, a self-identity id, columns an update, delete or read policy compares to the viewer id, and same-collection siblings by name."
        @synonyms "owner columns, owner fields"
      DS_STAMP { at : number }
        @description "Stamp the next owner column the access checks decide."
        @synonyms "owner stamp"
      DS_OLINK { at : number }
        @description "Fill the next owner relation the access checks decide."
        @synonyms "owner link"
      DS_PROJS { at : number }
        @description "Fill the projected fields."
        @synonyms "projections"
      DS_WRITTEN {  }
        @description "The seeded rows were written through the kernel."
        @synonyms "dataset written"
      DS_WRITER { at : number }
        @description "Find the writer of the next seeded row: its owner when the create policy admits the owner, else the first admitted identity."
        @synonyms "seed writer"
      DS_WRITE_NEXT { at : number }
        @description "Write the next owner chunk of the seeded rows."
        @synonyms "next seed write"
      DS_CHUNK_DONE { result : SeedDispatchOutcome!  text : string  key : string }
        @description "An owner chunk dispatch answered: taken, or refused with its error."
        @synonyms "seed chunk written"
      DS_RESUME {  }
        @description "Internal: a no-op dispatch of its own, so a long seed continues under a fresh step budget."
        @synonyms "seed resume"
      DS_RESUMED { result : SeedDispatchOutcome!  text : string  key : string }
        @description "The seed resume dispatch answered; the seed continues where it stopped."
        @synonyms "seed resumed"
      DS_CHUNK_WRITTEN {  }
        @description "Internal: the owner chunk was written; the asking dispatch reads it from the dispatch answer."
        @synonyms "seed chunk taken"
      DS_CHUNK_REFUSED { error : string }
        @description "Internal: the owner chunk was refused; the asking dispatch reads the error from the dispatch answer."
        @synonyms "seed chunk refused"
      DS_WRITE_CHUNK { ops : [[MockValue?]]! }
        @description "Write one owner chunk of seeded rows, dispatched as that owner."
        @synonyms "seed chunk"
      DS_RESTAMPED {  }
        @description "The owner changes were written through the kernel."
        @synonyms "restamp written"
      DS_MARK_FOUND { data : MockSeedMark! }
        @description "The seed marker exists: the app was seeded before."
        @synonyms "seed marker found"
      DS_MARK_ABSENT { error : string  code : string }
        @description "No seed marker (not-found), or the store failed."
        @synonyms "seed marker absent"
      DS_SELF_READ { result : SeedProgram }
        @description "The running app program, read by program/self."
        @synonyms "self program read"
      DS_WRITE_FAILED { error : string }
        @description "Writing the seeded rows or owner changes failed."
        @synonyms "seed write failed"
      AC_ASK { at : number }
        @description "Ask the next access check."
        @synonyms "access ask"
      AC_FAILED { error : string }
        @description "An access check could not be evaluated, which counts as denied and is reported."
        @synonyms "access failed"
      AC_ANSWER { allowed : boolean }
        @description "An access check was answered: allowed or denied."
        @synonyms "access verdict"
      AC_DONE { at : number }
        @description "Every queued access check was answered."
        @synonyms "access done"
      CORPUS_IS { words : [string] }
        @description "The stream word corpus."
        @synonyms "corpus"
      MockStream.CORPUS_IS -> CORPUS_IS
    }
  }

  page "/mock-seed" as MockSeedPage -> MockSeed, MockStream
}
