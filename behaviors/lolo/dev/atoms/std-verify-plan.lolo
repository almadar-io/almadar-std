app std-verify-plan [
  version: "1.0.0",
  env: ["ALMADAR_PERSONA_OWNS"],
  description: "std-verify-plan — the kernel's verify planner (orbital-core planner.rs plan_trait) as data. PLAN_REQUEST carries a resolved program (.orb IR) and std-machine rows; PLAN_ANSWERED returns one PlannedStep per row in row order. Planned: the payload of every unguarded row from its declared slots (row-key slot and id slot = the seed row id, values slot = first declared value, entity slot or bound @entity slot = a full sample row of that entity from the composed std-mock-seed (SAMPLE_ROWS) carrying the seed id (a one-row array for an array slot), number 1, boolean true, email, url, image, phone, uuid, array [], other string 'verify', capitalised non-entity named type null). Unplanned with the Rust reason code: guard-unsolved (guarded row, the symbolic guard solver is not ported) and object-slot-unplanned (object or [object] slot, its properties are not on the row). The walk is bounded array maps in one event, no cascade."
]
;; @capabilities "verify planner, payload synthesis, seed row id, plan a transition, guard payload"
uses Spec from "almadar-std/verify-plan"

type PlanSlot = { name : string!, type : string!, required : boolean!, values : [string], entity : string }
type PlanRow = { orbital : string!, trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, payload : [PlanSlot]! }
type PlanText = { v : string }
type PlanFroms = { v : [string] }
type PlanForm = [SExpr]
type PlanArm = { event : string!, from : (string | [string]), to : string!, guard : SExpr, effects : [SExpr] }
type PlanTick = { effects : [SExpr] }
type PlanEmit = { success : string, cancelled : string, onMessage : string, failure : string }
type PlanRoute = { emitter : string!, event : string!, kind : string! }
type PlanRoutes = [PlanRoute]
type PlanListenSource = { kind : string, trait : string }
type PlanListen = { event : string!, triggers : string, source : PlanListenSource }
type PlanOpts = { emit : PlanEmit }
type PlanSteps = [VerifyPlanPlannedStep]
type PlanState = { name : string!, isInitial : boolean }
type PlanGraph = { states : [PlanState], transitions : [PlanArm] }
type PlanTrait = { name : string!, orbital : string, linkedEntity : string, stateMachine : PlanGraph, ticks : [PlanTick], listens : [PlanListen] }
type PlanEntField = { name : string!, default : SExpr }
type PlanEntity = { name : string, fields : [PlanEntField] }
type PlanOrbital = { name : string!, entity : PlanEntity, traits : [PlanTrait] }
type PlanProgram = { orbitals : [PlanOrbital] }
type PlanFull = { orbitals : [orbital] }
type PlanProbe = { idx : number!, r : PlanRow! }
type PlanProbes = [PlanProbe]
type PlanResult = { guard : string!, transitionFired : boolean! }
type PlanPlayed = { idx : number!, baseNE : boolean!, result : PlanResult! }
type PlanPrecondition = { kind : string!, trait : string, event : string, fields : [string], proof : string!, reason : string }
type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type PlanPayload = Map string JsonValue
type PlanMockValue = string | number | boolean | [PlanMockValue?] | Map string PlanMockValue?
type PlanRelation = { entity : string, cardinality : string }
type PlanSeedField = { name : string!, type : string, required : boolean, values : [string], default : PlanMockValue?, intrinsic : boolean, relation : PlanRelation }
type PlanSeedEntity = { name : string, persistence : string, identity : boolean, fields : [PlanSeedField] }
type PlanSeedOrbital = { entity : PlanSeedEntity, auxiliaryEntities : [PlanSeedEntity] }
type PlanSeedProgram = { orbitals : [PlanSeedOrbital] }
type PlanMockField = { name : string, type : string!, values : [string], default : PlanMockValue?, intrinsic : boolean, required : boolean, relation : PlanRelation }
type PlanRowRef = { idx : number!, key : string!, entity : string!, array : boolean!, seed : string! }
type PlanRowJob = { entity : string!, fields : [PlanMockField]!, runtime : boolean!, identity : boolean! }
type PlanRowRefs = [PlanRowRef]
type PlanRowJobs = [PlanRowJob]
type PlanSeedEntities = [PlanSeedEntity]
type VerifyPlanPlannedStep = { trait : string!, linkedEntity : string, from : string!, event : string!, to : string!, toStates : [string]!, variant : string!, payload : PlanPayload!, guarded : boolean!, arm : number, solved : boolean!, payloadCase : string!, guardCase : string, unplanned : string, precondition : PlanPrecondition, reply : string }

orbital VerifyPlanOrbital {
  entity PlanRun [runtime] {
    id : string!
    steps : [VerifyPlanPlannedStep]! = []
    program : string = ""
    probes : [PlanProbe] = []
    rowRefs : [PlanRowRef] = []
    rowJobs : [PlanRowJob] = []
    createdOnly : [[string]] = []
    viewer : Map string PlanMockValue?
    owners : Map string [string] = {}
    seedIds : Map string string = {}
    newIds : Map string string = {}
  }

  uses Seed from "std/behaviors/std-mock-seed"

  trait MockSeed = Seed.traits.MockSeed {
    listens {
      MockStream.CORPUS_IS -> CORPUS_IS
      Plan.SAMPLE_ROWS -> SAMPLE_ROWS
    }
  }

  trait MockStream = Seed.traits.MockStream {
  }

  trait Plan -> PlanRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      PLAN_REQUEST -> ready
        (set @entity.program (json/stringify @payload.program))
        (set @entity.viewer (object/get @payload "viewer" null))
        (set @entity.owners (object/get @payload "owners" {}))
        (let ((names (array/unique (array/map (array/reduce (object/get (json/parse @entity.program PlanSeedProgram) "orbitals" []) (json/parse "[]" PlanSeedEntities) (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" [])))) (fn e (object/get @e "name" ""))))))
          (do
            (set @entity.seedIds (object/fromEntries (array/map @names (fn name [@name, (if (and (object/has @entity.viewer "id") (array/includes (object/get @entity.owners (str/lower @name) []) "id")) (str/template "{{v}}" { v: (object/get @entity.viewer "id") }) (str/concat @name "-verify-seed-1"))]))))
            (set @entity.newIds (object/fromEntries (array/map @names (fn name [@name, (if (and (object/has @entity.viewer "id") (array/includes (object/get @entity.owners (str/lower @name) []) "id")) (str/template "{{v}}" { v: (object/get @entity.viewer "id") }) (str/concat @name "-verify-new-1"))]))))))
        (let ((progTraits (array/flatten (array/map (object/get (json/parse (json/stringify @payload.program) PlanProgram) "orbitals") (fn o (array/map (object/get @o "traits" []) (fn t (object/set @t "orbital" (object/get @o "name")))))))))
          (do (set @entity.steps (array/map @payload.rows (fn r
            (let ((tr (array/find @progTraits (fn t (and (= (object/get @t "name") (object/get @r "trait")) (= (object/get @t "orbital") (object/get @r "orbital")))))))
              (let ((ent (object/get @tr "linkedEntity" "")))
                (let ((seed (if (= @ent "") "" (object/get @entity.seedIds @ent (str/concat @ent "-verify-seed-1"))))
                      (keys (array/map (array/filter (array/map (array/filter (array/reduce (array/filter (object/get (object/get @tr "stateMachine") "transitions" []) (fn a (= (object/get @a "event") (object/get @r "event")))) [] (fn (acc a) (array/concat @acc (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (str/startsWith (json/stringify @n) "["))) (fn n (json/parse (json/stringify @n) PlanForm)))
                                         (fn f (and (> (array/len @f) 2) (= (json/stringify (array/take @f 2)) (json/stringify (quote ["set", "@entity.id"]))) (str/startsWith (json/stringify (array/nth @f 2)) (str/concat "\"" (quote "@payload."))))))
                                       (fn f (str/slice (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @f 2)) "}") PlanText) "v") 9)))))
                  (let ((planned (array/reduce (object/get @r "payload") {}
                                   (fn (acc s)
                                     (object/set @acc (object/get @s "name") (json/parse
                                       (if (and (!= @seed "") (or (array/includes @keys (object/get @s "name")) (= (object/get @s "name") "id"))) (json/stringify @seed)
                                       (if (object/has @s "values") (json/stringify (array/nth (object/get @s "values" []) 0))
                                       (if (or (object/has @s "entity") (= (object/get @s "type") (quote "@entity")) (= (object/get @s "type") "[@entity]")) (if (str/startsWith (object/get @s "type") "[") (json/stringify [{ id: @seed }]) (json/stringify { id: @seed }))
                                       (if (array/includes ["number" "int" "integer" "float"] (object/get @s "type")) "1"
                                       (if (array/includes ["boolean" "bool"] (object/get @s "type")) "true"
                                       (if (= (object/get @s "type") "email") "\"verify@example.com\""
                                       (if (array/includes ["url" "image"] (object/get @s "type")) "\"https://example.com/verify\""
                                       (if (= (object/get @s "type") "phone") "\"+1-555-0100\""
                                       (if (= (object/get @s "type") "uuid") "\"00000000-0000-4000-8000-000000000001\""
                                       (if (str/startsWith (object/get @s "type") "[") "[]" "\"verify\"")))))))))) JsonValue)))))
                        (objectSlot (array/some (object/get @r "payload") (fn s (array/includes ["object" "[object]"] (object/get @s "type"))))))
                    (let ((arms (object/get (object/get @tr "stateMachine") "transitions" []))
                          (guarded (object/get @r "guarded")))
                      (let ((arm (array/find @arms (fn a (and (= (object/get @a "event") (object/get @r "event")) (= (object/get @a "to") (object/get @r "to")) (= (object/has @a "guard") @guarded) (array/includes (object/get (json/parse (str/concat "{\"v\":" (if (str/startsWith (json/stringify (object/get @a "from")) "[") (json/stringify (object/get @a "from")) (str/concat "[" (json/stringify (object/get @a "from")) "]")) "}") PlanFroms) "v") (object/get @r "from")))))))
                        (let ((bindTexts (if @guarded (array/map (array/filter (json/nodes (object/get @arm "guard")) (fn n (str/startsWith (json/stringify @n) "\"@"))) (fn n (object/get (json/parse (str/concat "{\"v\":" (json/stringify @n) "}") PlanText) "v"))) [])))
                          (let ((payloadBinds (array/filter @bindTexts (fn b (str/startsWith (str/slice @b 1) "payload."))))
                                (entityFields (array/unique (array/map (array/filter @bindTexts (fn b (and (str/startsWith (str/slice @b 1) "entity.") (!= (str/slice @b 1) "entity.id")))) (fn b (str/slice @b 8)))))
                                (gform (if @guarded (if (str/startsWith (json/stringify (object/get @arm "guard")) "[") (json/parse (json/stringify (object/get @arm "guard")) PlanForm) []) [])))
                            (let ((head (if (> (array/len @gform) 0) (if (str/startsWith (json/stringify (array/nth @gform 0)) "\"") (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @gform 0)) "}") PlanText) "v") "") ""))
                                  (guardExpr (if @guarded (object/get @arm "guard") "")))
(let ((n1 (and (= (array/len @gform) 2) (= @head "not"))))
(let ((g1 (if @n1 (if (str/startsWith (json/stringify (array/nth @gform 1)) "[") (json/parse (json/stringify (array/nth @gform 1)) PlanForm) []) @gform)))
(let ((h1 (if (and (> (array/len @g1) 0) (str/startsWith (json/stringify (array/nth @g1 0)) "\"")) (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @g1 0)) "}") PlanText) "v") "")))
(let ((n2 (and @n1 (= (array/len @g1) 2) (= @h1 "not"))))
(let ((g2 (if @n2 (if (str/startsWith (json/stringify (array/nth @g1 1)) "[") (json/parse (json/stringify (array/nth @g1 1)) PlanForm) []) @g1)) (w2 (if @n2 true (not @n1))))
(let ((h2 (if (and (> (array/len @g2) 0) (str/startsWith (json/stringify (array/nth @g2 0)) "\"")) (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @g2 0)) "}") PlanText) "v") "")))
(let ((comb (array/includes ["and","or"] @h2)))
(let ((allMode (or (not @comb) (= (= @h2 "and") @w2))) (forms (if @comb (array/map (array/drop @g2 1) (fn e (if (str/startsWith (json/stringify @e) "[") (json/parse (json/stringify @e) PlanForm) []))) [@g2])))
(let ((units (array/map @forms (fn f (if (and (= (array/len @f) 2) (= (if (and (> (array/len @f) 0) (str/startsWith (json/stringify (array/nth @f 0)) "\"")) (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @f 0)) "}") PlanText) "v") "") "not")) { f: (if (str/startsWith (json/stringify (array/nth @f 1)) "[") (json/parse (json/stringify (array/nth @f 1)) PlanForm) []), w: (not @w2) } { f: @f, w: @w2 })))))
(let ((descs (array/map @units (fn u (let ((f (object/get @u "f")) (w (object/get @u "w"))) (let ((n (array/len @f)) (fh (if (and (> (array/len @f) 0) (str/startsWith (json/stringify (array/nth @f 0)) "\"")) (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @f 0)) "}") PlanText) "v") "")))
  (let ((sa (if (= @n 3) (json/stringify (array/nth @f 1)) "")) (sb (if (= @n 3) (json/stringify (array/nth @f 2)) "")))
    (let ((ka (if (= @sa "") "none" (if (str/startsWith @sa "\"@payload.") (if (> (str/len @sa) 11) "path" "bind") (if (str/startsWith @sa "\"@") "bind" (if (str/startsWith @sa "\"") "string" (if (or (= @sa "true") (= @sa "false")) "bool" (if (= @sa "null") "null" (if (or (str/startsWith @sa "[") (str/startsWith @sa "{")) "struct" "number")))))))) (kb (if (= @sb "") "none" (if (str/startsWith @sb "\"@payload.") (if (> (str/len @sb) 11) "path" "bind") (if (str/startsWith @sb "\"@") "bind" (if (str/startsWith @sb "\"") "string" (if (or (= @sb "true") (= @sb "false")) "bool" (if (= @sb "null") "null" (if (or (str/startsWith @sb "[") (str/startsWith @sb "{")) "struct" "number")))))))))
      (let ((isCmp (and (= @n 3) (array/includes ["=","==","!=","<","<=",">",">="] @fh))) (isInc (and (= @n 3) (= @fh "array/includes"))) (litA (array/includes ["string","bool","null","number"] @ka)) (litB (array/includes ["string","bool","null","number"] @kb)))
        (let ((cmpA (and @isCmp (= @ka "path") @litB)) (cmpB (and @isCmp (= @kb "path") @litA)) (incA (and @isInc (= @ka "path") (str/startsWith @sb "["))) (incB (and @isInc (= @kb "path") (str/startsWith @sa "["))))
          (let ((constCmp (and @isCmp @litA @litB (array/includes ["=","==","!="] @fh))) (litS (if @cmpA @sb @sa)) (litKind (if @cmpA @kb @ka)) (list (if (or @incA @incB) (json/parse (if @incA @sb @sa) PlanForm) [])))
            (let ((op2 (if (array/includes ["=","=="] @fh) (if @w "=" "!=") (if (= @fh "!=") (if @w "!=" "=") (if (= @fh "<") (if @w "<" ">=") (if (= @fh "<=") (if @w "<=" ">") (if (= @fh ">") (if @w ">" "<=") (if @w ">=" "<")))))))
                  (firstS (if (> (array/len @list) 0) (json/stringify (array/nth @list 0)) "")))
              (let ((op3 (if @cmpB (if (= @op2 "<") ">" (if (= @op2 "<=") ">=" (if (= @op2 ">") "<" (if (= @op2 ">=") "<=" @op2)))) @op2))
                    (fk (if (= @firstS "") "none" (if (str/startsWith @firstS "\"@payload.") (if (> (str/len @firstS) 11) "path" "bind") (if (str/startsWith @firstS "\"@") "bind" (if (str/startsWith @firstS "\"") "string" (if (or (= @firstS "true") (= @firstS "false")) "bool" (if (= @firstS "null") "null" (if (or (str/startsWith @firstS "[") (str/startsWith @firstS "{")) "struct" "number")))))))))
                (let ((cvt (if (array/includes ["=","<=",">="] @op3) @litS (if (= @op3 "<") (if (= @litKind "number") (json/stringify (- (str/to-number @litS) 1)) "") (if (= @op3 ">") (if (= @litKind "number") (json/stringify (+ (str/to-number @litS) 1)) "") (if (= @litKind "number") (json/stringify (+ (str/to-number @litS) 1)) (if (= @litKind "bool") (if (= @litS "true") "false" "true") (if (= @litKind "string") (json/stringify (str/concat (object/get (json/parse (str/concat "{\"v\":" @litS "}") PlanText) "v") "-other")) (if (= @litKind "null") "true" ""))))))))
                      (incV (if (array/includes ["string","bool","null","number"] @fk) (if @w @firstS (if (= @fk "string") (json/stringify (str/concat (object/get (json/parse (str/concat "{\"v\":" @firstS "}") PlanText) "v") "-not-in-list")) "\"not-in-list\"")) "")))
                  (let ((vt (if (or @cmpA @cmpB) @cvt (if (or @incA @incB) @incV "")))
                        (key (if (or @cmpA @incA) (str/slice (object/get (json/parse (str/concat "{\"v\":" @sa "}") PlanText) "v") 9) (if (or @cmpB @incB) (str/slice (object/get (json/parse (str/concat "{\"v\":" @sb "}") PlanText) "v") 9) ""))))
                    (let ((cv (if (= @fh "!=") (not (= @sa @sb)) (= @sa @sb))))
                      { kind: (if @constCmp "const" (if (and (!= @vt "") (!= @key "")) "set" "bad")), key: @key, vt: @vt, cv: @cv, w: @w, ck: (if (and (= @fh "=") @cmpA (= @litKind "string") @w) @key (if (and (array/includes ["=","=="] @fh) @cmpB (= @litKind "string") @w) @key (if (and (= @fh "==") @cmpA (= @litKind "string") @w) @key ""))), cl: (if @cmpA @sb @sa) }))))))))))))))))
(let ((constHit (array/some @descs (fn d (and (= (object/get @d "kind") "const") (= (object/get @d "cv") (object/get @d "w")))))))
(let ((res (array/reduce @descs { ok: (and @allMode (> (array/len @descs) 0)), p: @planned } (fn (acc d) (if @allMode (if (and (object/get @acc "ok") (= (object/get @d "kind") "set")) { ok: true, p: (object/set (object/get @acc "p") (object/get @d "key") (json/parse (object/get @d "vt") JsonValue)) } { ok: false, p: (object/get @acc "p") }) (if (or (object/get @acc "ok") (!= (object/get @d "kind") "set")) @acc { ok: true, p: (object/set (object/get @acc "p") (object/get @d "key") (json/parse (object/get @d "vt") JsonValue)) }))))))
(let ((sol0 (if (and (not @allMode) @constHit) { ok: true, p: @planned } @res)) (cks (array/unique (array/filter (array/map @descs (fn d (object/get @d "ck"))) (fn k (!= @k ""))))))
(let ((sol (if (and @comb (= @h2 "and") @w2 (object/get @sol0 "ok")) { ok: true, p: (array/reduce @cks (object/get @sol0 "p") (fn (acc k) (let ((grp (array/filter @descs (fn d (= (object/get @d "ck") @k))))) (if (< (array/len @grp) 2) @acc (let ((vals (array/unique (array/map @grp (fn d (object/get @d "cl")))))) (if (= (array/len @vals) 1) (object/set @acc @k (json/parse (array/nth @vals 0) JsonValue)) (array/reduce (array/filter (object/keys @acc) (fn x (!= @x @k))) {} (fn (a2 x) (object/set @a2 @x (object/get @acc @x)))))))))) } @sol0)))
(let ((ok (or (not @guarded) (object/get @sol "ok"))))
(let ((solvedPayload (if (and @guarded (> (array/len @payloadBinds) 0) @ok) (object/get @sol "p") @planned))
                                        (sameHit (array/some (array/filter @arms (fn a (!= (object/get @a "event") "INIT"))) (fn a (array/some (array/map (array/filter (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (str/startsWith (json/stringify @n) "["))) (fn n (json/parse (json/stringify @n) PlanForm))) (fn f (array/some @entityFields (fn fld (= (json/stringify (array/take @f 2)) (json/stringify ["set", (str/concat (quote "@entity.") @fld)])))))))))
                                        (tickHit (array/some @entityFields (fn fld (array/some (array/map (array/filter (array/reduce (object/get @tr "ticks" []) [] (fn (acc3 tk) (array/concat @acc3 (array/reduce (object/get @tk "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (str/startsWith (json/stringify @n) "["))) (fn n (json/parse (json/stringify @n) PlanForm))) (fn f (= (json/stringify (array/take @f 2)) (json/stringify ["set", (str/concat (quote "@entity.") @fld)])))))))
                                        (cands (array/reduce @progTraits [] (fn (acc t) (if (and (!= (object/get @t "name") (object/get @r "trait")) (!= @ent "") (= (object/get @t "linkedEntity" "") @ent)) (array/concat @acc (array/map (array/filter (object/get (object/get @t "stateMachine") "transitions" []) (fn a (and (!= (object/get @a "event") "INIT") (array/some (array/map (array/filter (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (str/startsWith (json/stringify @n) "["))) (fn n (json/parse (json/stringify @n) PlanForm))) (fn f (array/some @entityFields (fn fld (= (json/stringify (array/take @f 2)) (json/stringify ["set", (str/concat (quote "@entity.") @fld)]))))))))) (fn a { trait: (object/get @t "name"), event: (object/get @a "event") }))) @acc)))))
                                    (let ((why (if (not @ok) "guard-unsolved" (if @objectSlot "object-slot-unplanned" ""))))
                                      (let ((pre (if (and @guarded (> (array/len @entityFields) 0)) (if (> (array/len @cands) 0) { kind: "established", trait: (object/get (array/nth @cands 0) "trait"), event: (object/get (array/nth @cands 0) "event"), fields: @entityFields, proof: "unproven", reason: "setter-value-unresolved" } (if (or @sameHit @tickHit) { kind: "same-trait-setter", trait: "", event: "", fields: @entityFields, proof: "unproven", reason: "setter-not-on-replay-path" } { kind: "unreachable", trait: "", event: "", fields: @entityFields, proof: "unproven", reason: "unreachable" })) { kind: "none", trait: "", event: "", fields: [], proof: "proven", reason: "" })))
                                        (let ((step { trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"), to: (object/get @r "to"), toStates: [(object/get @r "to")], variant: (if (= (object/get @r "from") (object/get (array/find (object/get (object/get @tr "stateMachine") "states" []) (fn st (object/get @st "isInitial" false))) "name" "")) "auto-init" "success"), payload: @solvedPayload, guarded: @guarded, solved: (= @why ""), payloadCase: "success" }))
                                          (let ((withEntity (if (= @ent "") @step (object/set @step "linkedEntity" @ent))))
                                            (let ((withGuard (if @guarded (object/set @withEntity "guardCase" "pass") @withEntity)))
                                              (let ((withPre (if (= (object/get @pre "kind") "none") @withGuard (object/set @withGuard "precondition" @pre))))
                                                (if (= @why "") @withPre (object/set @withPre "unplanned" @why))))))))))))))))))))))))))))))))))))
        (set @entity.steps (let ((routes (array/reduce @progTraits (json/parse "[]" PlanRoutes) (fn (ra t)
            (let ((forms (array/map (array/filter (array/reduce (object/get (object/get @t "stateMachine") "transitions" []) [] (fn (a2 arm) (array/concat @a2 (array/reduce (object/get @arm "effects" []) [] (fn (a3 e) (array/concat @a3 (json/nodes @e))))))) (fn n (or (str/startsWith (json/stringify @n) "[\"http\"") (str/startsWith (json/stringify @n) "[\"redis\"") (str/startsWith (json/stringify @n) "[\"postgres\"")))) (fn n (json/parse (json/stringify @n) PlanForm)))))
              (let ((emits (array/map (array/filter @forms (fn f (str/startsWith (json/stringify (array/nth @f (- (array/len @f) 1))) "{"))) (fn f (object/get (json/parse (json/stringify (array/nth @f (- (array/len @f) 1))) PlanOpts) "emit" (json/parse "{}" PlanEmit))))))
                (array/concat @ra (array/reduce @emits (json/parse "[]" PlanRoutes) (fn (rb m) (array/concat (array/concat (array/concat (array/concat @rb (if (!= (object/get @m "success" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "success"), kind: "other" }] (json/parse "[]" PlanRoutes))) (if (!= (object/get @m "cancelled" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "cancelled"), kind: "other" }] (json/parse "[]" PlanRoutes))) (if (!= (object/get @m "onMessage" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "onMessage"), kind: "other" }] (json/parse "[]" PlanRoutes))) (if (!= (object/get @m "failure" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "failure"), kind: "failure" }] (json/parse "[]" PlanRoutes))))))))))))
          (array/reduce @entity.steps (json/parse "[]" PlanSteps) (fn (acc st)
            (let ((row (array/nth @payload.rows (array/len @acc))))
              (let ((tr (array/find @progTraits (fn t (and (= (object/get @t "name") (object/get @row "trait")) (= (object/get @t "orbital") (object/get @row "orbital")))))))
                (let ((isOther (array/some @routes (fn r (and (= (object/get @r "kind") "other") (or (and (= (object/get @r "emitter") (object/get @row "trait")) (= (object/get @r "event") (object/get @row "event"))) (array/some (object/get @tr "listens" []) (fn l (and (= (object/get @l "event") (object/get @r "event")) (or (not (object/has @l "source")) (= (object/get (object/get @l "source" (json/parse "{}" PlanListenSource)) "kind" "") "any") (= (object/get (object/get @l "source" (json/parse "{}" PlanListenSource)) "trait" "") (object/get @r "emitter"))) (= (object/get @l "triggers" (object/get @l "event")) (object/get @row "event"))))))))) )
                      (isFail (array/some @routes (fn r (and (= (object/get @r "kind") "failure") (or (and (= (object/get @r "emitter") (object/get @row "trait")) (= (object/get @r "event") (object/get @row "event"))) (array/some (object/get @tr "listens" []) (fn l (and (= (object/get @l "event") (object/get @r "event")) (or (not (object/has @l "source")) (= (object/get (object/get @l "source" (json/parse "{}" PlanListenSource)) "kind" "") "any") (= (object/get (object/get @l "source" (json/parse "{}" PlanListenSource)) "trait" "") (object/get @r "emitter"))) (= (object/get @l "triggers" (object/get @l "event")) (object/get @row "event"))))))))) ))
                  (array/concat @acc [(if @isOther (object/set @st "reply" "other") (if @isFail (object/set @st "reply" "failure") @st))]))))))))
        (set @entity.probes (array/filter (array/reduce @payload.rows (json/parse "[]" PlanProbes) (fn (acc r) (array/concat @acc [{ idx: (array/len @acc), r: @r }]))) (fn p (object/has (array/nth @entity.steps (object/get @p "idx")) "precondition"))))
        (set @entity.createdOnly (array/map (array/range (array/len @payload.rows)) (fn i
          (let ((r (array/nth @payload.rows @i)))
            (let ((tr (array/find @progTraits (fn t (and (= (object/get @t "name") (object/get @r "trait")) (= (object/get @t "orbital") (object/get @r "orbital")))))))
              (let ((pers (array/filter (array/map (array/filter (array/reduce (array/filter (object/get (object/get @tr "stateMachine") "transitions" []) (fn a (= (object/get @a "event") (object/get @r "event")))) [] (fn (acc a) (array/concat @acc (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (str/startsWith (json/stringify @n) "["))) (fn n (json/parse (json/stringify @n) PlanForm))) (fn f (and (> (array/len @f) 2) (= (json/stringify (array/nth @f 0)) "\"persist\"") (str/startsWith (json/stringify (array/nth @f 2)) "\""))))))
                (let ((named (array/map @pers (fn f { op: (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @f 1)) "}") PlanText) "v"), entity: (object/get (json/parse (str/concat "{\"v\":" (json/stringify (array/nth @f 2)) "}") PlanText) "v") }))))
                  (array/filter (array/unique (array/map @named (fn n (object/get @n "entity")))) (fn e (array/every (array/filter @named (fn n (= (object/get @n "entity") @e))) (fn n (= (object/get @n "op") "create"))))))))))))
        (set @entity.rowRefs (array/reduce (array/range (array/len @payload.rows)) (json/parse "[]" PlanRowRefs) (fn (acc i)
          (let ((r (array/nth @payload.rows @i)) (st (array/nth @entity.steps @i)))
            (let ((seed (object/get @entity.seedIds (object/get @st "linkedEntity" "") (str/concat (object/get @st "linkedEntity" "") "-verify-seed-1"))))
              (array/concat @acc (array/map (array/filter (object/get @r "payload")
                  (fn sl (and (!= (object/get @st "linkedEntity" "") "") (not (object/has @sl "values")) (or (object/has @sl "entity") (= (object/get @sl "type") (quote "@entity")) (= (object/get @sl "type") "[@entity]"))
                    (or (= (json/stringify (object/get (object/get @st "payload") (object/get @sl "name"))) (json/stringify { id: @seed })) (= (json/stringify (object/get (object/get @st "payload") (object/get @sl "name"))) (json/stringify [{ id: @seed }]))))))
                (fn sl { idx: @i, key: (object/get @sl "name"), entity: (object/get @sl "entity" (object/get @st "linkedEntity" "")), array: (str/startsWith (object/get @sl "type") "["), seed: (let ((name (object/get @sl "entity" (object/get @st "linkedEntity" "")))) (if (array/includes (array/nth @entity.createdOnly @i) @name) (object/get @entity.newIds @name (str/concat @name "-verify-new-1")) (object/get @entity.seedIds @name (str/concat @name "-verify-seed-1")))) }))))))))
        (set @entity.steps (array/map (array/range (array/len @entity.steps)) (fn i
          (let ((st (array/nth @entity.steps @i)) (only (array/nth @entity.createdOnly @i)))
            (if (= (array/len @only) 0) @st
              (object/set @st "payload" (array/reduce (object/keys (object/get @st "payload")) (object/get @st "payload") (fn (acc k)
                (let ((hit (array/find @only (fn e (= (json/stringify (object/get @acc @k)) (json/stringify (object/get @entity.seedIds @e (str/concat @e "-verify-seed-1"))))))))
                  (if (= (str/default @hit "") "") @acc (object/set @acc @k (object/get @entity.newIds @hit (str/concat @hit "-verify-new-1")))))))))))))
        (set @entity.rowJobs (let ((ents (array/reduce (object/get (json/parse (json/stringify @payload.program) PlanSeedProgram) "orbitals" []) (json/parse "[]" PlanSeedEntities) (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" []))))))
          (array/reduce (array/unique (array/map @entity.rowRefs (fn rf (object/get @rf "entity")))) (json/parse "[]" PlanRowJobs) (fn (acc name)
            (let ((def (array/find @ents (fn e (= (object/get @e "name" "") @name)))))
              (if (= (object/get @def "name" "") "") @acc
                (array/concat @acc [{ entity: @name, runtime: (= (object/get @def "persistence" "") "runtime"), identity: (object/get @def "identity" false),
                  fields: (array/map (object/get @def "fields" []) (fn f
                    (let ((base { name: (object/get @f "name"), type: (object/get @f "type" "string"), required: (object/get @f "required" false), intrinsic: (object/get @f "intrinsic" false) }))
                      (let ((withCard (if (object/has @f "relation") (object/set @base "relation" (object/get @f "relation")) @base)))
                        (let ((withValues (if (object/has @f "values") (object/set @withCard "values" (object/get @f "values")) @withCard)))
                          (if (object/has @f "default") (object/set @withValues "default" (object/get @f "default")) @withValues)))))) }])))))))
        (emit PLAN_COMPUTED { count: (array/len @entity.steps) })))
      PLAN_COMPUTED -> ready when (> (array/len @entity.rowJobs) 0)
        (emit SAMPLE_ROWS { fields: (object/get (array/first @entity.rowJobs) "fields"), name: (object/get (array/first @entity.rowJobs) "entity"), count: 1, runtime: (object/get (array/first @entity.rowJobs) "runtime"), identity: (object/get (array/first @entity.rowJobs) "identity") })
      ROWS_DONE -> ready
        (let ((job (object/get (array/first @entity.rowJobs) "entity")) (row (array/first @payload.rows)))
          (do
            (set @entity.steps (array/map (array/range (array/len @entity.steps)) (fn i
              (array/reduce (array/filter @entity.rowRefs (fn rf (and (= (object/get @rf "idx") @i) (= (object/get @rf "entity") @job)))) (array/nth @entity.steps @i) (fn (st rf)
                (let ((full (array/reduce (if (object/has @entity.viewer "id") (object/get @entity.owners (str/lower @job) []) []) (object/set @row "id" (object/get @rf "seed")) (fn (acc field) (object/set @acc @field (object/get @entity.viewer "id"))))))
                  (object/set @st "payload" (object/set (object/get @st "payload") (object/get @rf "key") (json/parse (if (object/get @rf "array") (json/stringify [@full]) (json/stringify @full)) PlanMockValue)))))))))
            (set @entity.rowJobs (array/drop @entity.rowJobs 1))
            (emit PLAN_COMPUTED { count: (array/len @entity.steps) })))
      PLAN_COMPUTED -> ready when (and (= (array/len @entity.rowJobs) 0) (= (array/len @entity.probes) 0))
        (emit PLAN_ANSWERED { steps: @entity.steps })
      PLAN_COMPUTED -> ready when (and (= (array/len @entity.rowJobs) 0) (> (array/len @entity.probes) 0))
        (let ((orbs (object/get (json/parse @entity.program PlanProgram) "orbitals" [])))
          (program/step (json/parse @entity.program PlanFull) (array/reduce @entity.probes [] (fn (acc p)
            (let ((r (object/get @p "r")))
              (let ((o (array/find @orbs (fn o (= (object/get @o "name") (object/get @r "orbital"))))))
                (let ((tr (array/find (object/get @o "traits" []) (fn t (= (object/get @t "name") (object/get @r "trait"))))))
                  (let ((inits (array/filter (object/get (object/get @tr "stateMachine") "transitions" []) (fn a (= (object/get @a "event") "INIT"))))
                        (fields (object/get (object/get (array/nth @entity.steps (object/get @p "idx")) "precondition") "fields" [])))
                    (let ((hasInit (> (array/len @inits) 0)))
                      (let ((initFrom (if @hasInit (array/nth (object/get (json/parse (str/concat "{\"v\":" (if (str/startsWith (json/stringify (object/get (array/nth @inits 0) "from")) "[") (json/stringify (object/get (array/nth @inits 0) "from")) (str/concat "[" (json/stringify (object/get (array/nth @inits 0) "from")) "]")) "}") PlanFroms) "v") 0) ""))
                            (entFields (object/get (object/get @o "entity" {}) "fields" []))
                            (initSet (and @hasInit (array/some (array/map (array/filter (array/reduce (object/get (array/nth @inits 0) "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (str/startsWith (json/stringify @n) "["))) (fn n (json/parse (json/stringify @n) PlanForm))) (fn f (array/some @fields (fn fld (= (json/stringify (array/take @f 2)) (json/stringify ["set", (str/concat (quote "@entity.") @fld)])))))))))
                        (let ((baseNE (or @initSet (array/some @fields (fn fld (array/some @entFields (fn e (and (= (object/get @e "name") @fld) (object/has @e "default")))))))))
                          (array/concat @acc (array/concat
                            (if @hasInit [{ orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (if (= @initFrom "*") (object/get @r "from") @initFrom), event: "INIT", viewer: @entity.viewer, payload: {}, idx: (- 0 1), baseNE: false }] [])
                            [{ orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"), viewer: @entity.viewer, payload: (object/get (array/nth @entity.steps (object/get @p "idx")) "payload"), idx: (object/get @p "idx"), baseNE: @baseNE }]))))))))))) { key: "steps" emit: { success: PLAN_STEPPED, failure: PLAN_FAILED } }))
      PLAN_STEPPED -> ready
        (set @entity.steps (array/reduce @entity.steps [] (fn (acc s)
          (let ((hit (array/filter @payload.result (fn q (= (object/get @q "idx") (array/len @acc))))))
            (array/concat @acc [(if (and (> (array/len @hit) 0) (= (object/get (object/get (array/nth @hit 0) "result") "guard") "pass") (object/get (array/nth @hit 0) "baseNE"))
              (array/reduce (array/filter (object/keys @s) (fn k (!= @k "precondition"))) {} (fn (a2 k) (object/set @a2 @k (object/get @s @k))))
              @s)])))))
        (emit PLAN_ANSWERED { steps: @entity.steps })
      PLAN_FAILED -> ready
        (emit PLAN_ANSWERED { steps: @entity.steps })
    }

    emits {
      PLAN_COMPUTED -> internal { count : number! }
        @description "Internal: the plan is computed; the baseline probe runs next when rows need it."
        @tier "internal"
      PLAN_STEPPED -> internal { result : [PlanPlayed]! }
        @description "Internal: the baseline probe played."
        @tier "internal"
      PLAN_FAILED -> internal { error : string }
        @description "Internal: the baseline probe failed; the computed plan stands."
        @tier "internal"
      SAMPLE_ROWS -> external { fields : [PlanMockField]!, name : string!, count : number!, runtime : boolean!, identity : boolean! }
        @description "Internal: ask the composed mock seed for one sample row of an entity slot's entity."
        @tier "internal"
      PLAN_ANSWERED -> external { steps : [VerifyPlanPlannedStep]! }
        @description "One planned step per row, in row order."
        @tier "domain"
    }

    listens {
      MockSeed.ROWS_DONE -> ROWS_DONE
      ROWS_DONE { rows : [Map string PlanMockValue?]! }
        @description "Internal: the composed mock seed answered the sample row."
        @tier "internal"
      PLAN_REQUEST -> input { program : SExpr!, rows : [PlanRow]!, viewer : Map string PlanMockValue?, owners : Map string [string] }
        @description "Plan a payload for each machine row of a resolved program."
        @synonyms "verify plan, plan transitions, synthesize payloads, seed row id"
    }
  }

  page "/verify-plan" as VerifyPlanPage -> Plan, MockSeed, MockStream
}
