                (let ((tr (array/find (object/get @o "traits" []) (fn t (= (object/get @t "name") (object/get @r "trait"))))))
                 (if (= @tr null) @acc
                  (let ((sp (let ((nxi (object/get @p "idx"))) (if (>= @nxi 0) (array/nth @entity.steps @nxi) null))))
                   (if (= @sp null) @acc
                  (let ((inits (array/filter (object/get (object/get @tr "stateMachine" @noGraph) "transitions" []) (fn a (= (object/get @a "event") "INIT"))))
                        (fields (let ((pc (object/get @sp "precondition"))) (if (= @pc null) [] (object/get @pc "fields" [])))))
                   (let ((i0 (array/first @inits)))
                    (let ((hasInit (!= @i0 null)))
                      (let ((initFrom (if (= @i0 null) "" (default (array/nth (let ((fr (object/get @i0 "from"))) (if (validate/string @fr) [@fr] @fr)) 0) "")))
                            (entFields (object/get (object/get @o "entity" {}) "fields" []))
                            (initSet (and @hasInit (array/some (array/map (array/filter (array/reduce (if (= @i0 null) [] (object/get @i0 "effects" [])) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (array/some @fields (fn fld (= (array/take @f 2) ["set", (str/concat (quote "@entity.") @fld)]))))))))
                        (let ((baseNE (or @initSet (array/some @fields (fn fld (array/some @entFields (fn e (and (= (object/get @e "name") @fld) (object/has @e "default")))))))))
                          (array/concat @acc (array/concat
                            (if @hasInit [{ orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (if (= @initFrom "*") (object/get @r "from") @initFrom), event: "INIT", identity: @entity.viewer, payload: {}, idx: (- 0 1), baseNE: false }] [])
                            [{ orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"), identity: @entity.viewer, payload: (object/get @sp "payload"), idx: (object/get @p "idx"), baseNE: @baseNE }]))))))))))))))))))
            (do
              (set @entity.reqs @reqs)
              (program/step @entity.fullProgram (array/map @reqs (fn q { orbital: @q.orbital, trait: @q.trait, from: @q.from, event: @q.event, identity: @q.identity, payload: @q.payload })) { key: "steps" emit: { success: PLAN_STEPPED, failure: PLAN_FAILED } })))))
      PLAN_STEPPED -> ready when (!= (array/len @payload.result) (array/len @entity.reqs))
        (emit PLAN_FAILED { error: "verify-plan: the step answer does not match the baseline probes sent" })
      PLAN_STEPPED -> ready when (= (array/len @payload.result) (array/len @entity.reqs))
        (set @entity.steps (let ((byStep (array/groupBy (array/map (array/zip @entity.reqs @payload.result) (fn z (let ((rq (array/nth @z 0)) (an (array/nth @z 1))) { idx: @rq.idx, baseNE: @rq.baseNE, result: @an.result }))) (fn q (str/concat (object/get @q "idx"))))))
          (array/map (array/range (array/len @entity.steps)) (fn i
            (let ((s : VerifyPlanPlannedStep (array/nth @entity.steps @i)) (hit (array/first (object/get @byStep (str/concat @i) []))))
              (if (and (!= @hit null) (= (object/get (object/get @hit "result") "guard") "pass") (object/get @hit "baseNE"))
                (object/omit @s ["precondition"])
                @s))))))
        (emit PLAN_ANSWERED { steps: @entity.steps, viewer: @entity.viewer })
      PLAN_FAILED -> ready
        (emit PLAN_REFUSED { error: (default @payload.error "verify-plan: the plan failed with no error") })
    }

    emits {
      PLAN_READ -> internal { }
        @description "Internal: the program is kept; the entity ids and traits are read next."
        @tier "internal"
      PLAN_ROWS -> internal { }
        @description "Internal: plan each row."
        @tier "internal"
      PLAN_PLANNED -> internal { }
        @description "Internal: every row is planned; replies, probes and sample rows are read next."
        @tier "internal"
      PLAN_COMPUTED -> internal { count : number! }
        @description "Internal: the plan is computed; the baseline probe runs next when rows need it."
        @tier "internal"
      PLAN_STEPPED -> internal { result : [PlanStepped]! }
        @description "Internal: the baseline probe played."
        @tier "internal"
      PLAN_FAILED -> internal { error : string }
        @description "Internal: the baseline probe failed; the computed plan stands."
        @tier "internal"
      SAMPLE_BATCH -> external { jobs : [PlanSampleJob]! }
        @description "Internal: ask the composed mock seed for one sample row of each pending entity slot's entity, all in one batch."
        @tier "internal"
      PLAN_REFUSED -> external { error : string! }
        @description "The program cannot be planned: a planned trait declares no initial state."
        @tier "domain"
      PLAN_ANSWERED -> external { steps : [VerifyPlanPlannedStep]!, viewer : (Map string PlanMockValue?)? }
        @description "One planned step per row, in row order."
        @tier "domain"
    }

    listens {
      MockSeed.ROWS_BATCH_DONE -> ROWS_BATCH_DONE
      ROWS_BATCH_DONE { rows : [[Map string PlanMockValue?]]! }
        @description "Internal: the composed mock seed answered the sample batch, one row list per pending entity in order."
        @tier "internal"
      PLAN_REQUEST -> input { program : SExpr!, rows : [PlanRow]!, viewer : (Map string PlanMockValue?)?, role : string?, owners : (Map string [string])? }
        @description "Plan a payload for each machine row of a resolved program."
        @synonyms "verify plan, plan transitions, synthesize payloads, seed row id"
    }
  }

  page boot as VerifyPlanBoot -> Plan, MockSeed, MockStream
}
