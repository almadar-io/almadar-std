app std-verify-plan [
  version: "1.0.0",
  env: ["ALMADAR_PERSONA_OWNS"],
  description: "std-verify-plan — the kernel's verify planner (orbital-core planner.rs plan_trait) as data. PLAN_REQUEST carries a resolved program (.orb IR) and std-machine rows; PLAN_ANSWERED returns one PlannedStep per row in row order. Planned: the payload of every unguarded row from its declared slots (row-key slot and id slot = the seed row id, values slot = first declared value, entity slot or bound @entity slot = a full sample row of that entity from the composed std-mock-seed (one SAMPLE_BATCH for every pending entity, so a plan costs a fixed number of deliveries however many entities it samples) carrying the seed id (a one-row array for an array slot), number and money 1, date 2026-01-01, datetime, timestamp and instant 2026-01-01T00:00:00Z, a Map slot {}, boolean true, email, url, image, phone, uuid, array [], other string 'verify', a slot of a declared record type (a key of the program's or an orbital's types) is left out when optional; a required one makes the row object-slot-unplanned). Unplanned with the Rust reason code: guard-unsolved (guarded row, the symbolic guard solver is not ported) and object-slot-unplanned (object or [object] slot, its properties are not on the row). Each planned step also carries `entity`: its linked row seeded with the seed id and a full std-mock-seed sample, so a transition played alone runs on a row with the fields an earlier transition would have set. With no viewer the planner samples one row of the program's one identity entity (with that entity's seed id) as the viewer, runs the baseline probes as it and returns it as PLAN_ANSWERED's viewer; with no identity entity the viewer stays anonymous, and several identity entities with no viewer are refused (which roster is the viewer is never picked by order). The walk is bounded array maps in one event, no cascade."
]
;; @capabilities "verify planner, payload synthesis, seed row id, plan a transition, guard payload"
uses Spec from "almadar-std/verify-plan"

type PlanSlot = { name : string!, type : string!, required : boolean!, values : [string], entity : string }
type PlanRow = { orbital : string!, trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, payload : [PlanSlot]! }
type PlanText = { v : string! }
type PlanStr = string
type PlanNum = number
type PlanIds = Map string string
type PlanFroms = { v : [string] }
type PlanForm = [SExpr]
type PlanArm = { event : string!, from : (string | [string])!, to : string!, guard : SExpr, effects : [SExpr] }
type PlanTick = { effects : [SExpr] }
type PlanEmit = { success : string, cancelled : string, onMessage : string, failure : string }
type PlanRoute = { emitter : string!, event : string!, kind : string! }
type PlanRoutes = [PlanRoute]
type PlanListenSource = { kind : string, trait : string }
type PlanListen = { event : string!, triggers : string, source : PlanListenSource }
type PlanOpts = { emit : PlanEmit }
type PlanSteps = [VerifyPlanPlannedStep]
type PlanState = { name : string!, isInitial : boolean }
type PlanGraph = { states : [PlanState], transitions : [PlanArm] }
type PlanTrait = { name : string!, orbital : string, linkedEntity : string, stateMachine : PlanGraph, ticks : [PlanTick], listens : [PlanListen] }
type PlanEntField = { name : string!, default : SExpr? }
type PlanEntity = { name : string, fields : [PlanEntField] }
type PlanOrbital = { name : string!, entity : PlanEntity, traits : [PlanTrait], types : Map string SExpr }
type PlanProgram = { orbitals : [PlanOrbital]!, types : Map string SExpr }
type PlanFull = { orbitals : [orbital] }
type PlanProbe = { idx : number!, r : PlanRow! }
type PlanProbes = [PlanProbe]
type PlanResult = { guard : string!, transitionFired : boolean! }
type PlanReq = { orbital : string!, trait : string!, from : string!, event : string!, identity : (Map string PlanMockValue?)?, payload : PlanPayload!, idx : number!, baseNE : boolean! }
type PlanStepped = { orbital : string, trait : string!, from : string, event : string!, result : PlanResult! }
type PlanPlayed = { idx : number!, baseNE : boolean!, result : PlanResult! }
type PlanPrecondition = { kind : string!, trait : string, event : string, fields : [string], proof : string!, reason : string }
type JsonValue = string | number | boolean | [JsonValue?] | Map string JsonValue?
type PlanPayload = Map string JsonValue
type PlanMockValue = string | number | boolean | [PlanMockValue?] | Map string PlanMockValue?
type PlanRelation = { entity : string, cardinality : string }
type PlanSeedField = { name : string!, type : string, required : boolean, values : [string], default : PlanMockValue?, intrinsic : boolean, relation : PlanRelation }
type PlanSeedEntity = { name : string, persistence : string, identity : boolean, fields : [PlanSeedField] }
type PlanSeedOrbital = { entity : PlanSeedEntity, auxiliaryEntities : [PlanSeedEntity] }
type PlanSeedProgram = { orbitals : [PlanSeedOrbital] }
type PlanMockField = { name : string, type : string!, values : [string], default : PlanMockValue?, intrinsic : boolean, required : boolean, relation : PlanRelation }
type PlanRowRef = { idx : number!, key : string!, entity : string!, array : boolean!, seed : string!, row : boolean }
type PlanRowJob = { entity : string!, fields : [PlanMockField]!, runtime : boolean!, identity : boolean!, viewer : boolean }
type PlanRowRefs = [PlanRowRef]
type PlanRowJobs = [PlanRowJob]
type PlanSampleJob = { fields : [PlanMockField]!, name : string!, count : number!, runtime : boolean!, identity : boolean! }
type PlanViewerStep = { before : string!, hasAfter : boolean! }
type PlanViewerAcc = { v : (Map string PlanMockValue?)?, seq : [PlanViewerStep]! }
type PlanSeedEntities = [PlanSeedEntity]
type VerifyPlanPlannedStep = { trait : string!, linkedEntity : string, from : string!, event : string!, to : string!, toStates : [string]!, variant : string!, payload : PlanPayload!, guarded : boolean!, arm : number, solved : boolean!, payloadCase : string!, guardCase : string, unplanned : string, precondition : PlanPrecondition, reply : string, entity : (Map string PlanMockValue?)? }

type PlanSetter = { k : string!, ent : string!, trait : string!, event : string!, fields : [string]! }
type PlanTickSetter = { k : string!, fields : [string]! }
orbital VerifyPlanOrbital {
  entity PlanRun [runtime] {
    id : string!
    steps : [VerifyPlanPlannedStep]! = []
    program : PlanProgram?
    seedProgram : PlanSeedProgram?
    fullProgram : PlanFull?
    rows : [PlanRow] = []
    reqs : [PlanReq] = []
    progTraits : [PlanTrait] = []
    probes : [PlanProbe] = []
    rowRefs : [PlanRowRef] = []
    rowJobs : [PlanRowJob] = []
    createdOnly : [[string]] = []
    viewer : (Map string PlanMockValue?)?
    role : string?
    owners : Map string [string] = {}
    seedIds : Map string string = {}
    newIds : Map string string = {}
  }

  uses Seed from "std/behaviors/std-mock-seed"

  trait MockSeed = Seed.traits.MockSeed {
    listens {
      MockStream.CORPUS_IS -> CORPUS_IS
      Plan.SAMPLE_BATCH -> SAMPLE_BATCH
    }
  }

  trait MockStream = Seed.traits.MockStream {
  }

  trait Plan -> PlanRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      PLAN_REQUEST -> ready when (= (as @payload.program PlanProgram) null)
        (set @entity.steps [])
        (emit PLAN_FAILED { error: "verify-plan: the program to plan is not a program" })
      PLAN_REQUEST -> ready when (!= (as @payload.program PlanProgram) null)
        (set @entity.program (as @payload.program PlanProgram))
        (set @entity.seedProgram (as @payload.program PlanSeedProgram))
        (set @entity.fullProgram (as @payload.program PlanFull))
        (set @entity.role (object/get @payload "role" null))
        (set @entity.viewer (let ((v (object/get @payload "viewer" null)) (r (object/get @payload "role" null))) (if (or (= @v null) (= @r null)) @v (object/set @v "role" @r))))
        (set @entity.owners (object/get @payload "owners" {}))
        (set @entity.rows @payload.rows)
        (emit PLAN_READ {})
      PLAN_READ -> ready when (or (= @entity.seedProgram null) (= @entity.fullProgram null))
        (set @entity.steps [])
        (emit PLAN_FAILED { error: "verify-plan: the program could not be read for planning" })
      PLAN_READ -> ready when (and (!= @entity.program null) (!= @entity.seedProgram null) (!= @entity.fullProgram null))
        (let ((noIds : PlanIds {}) (names (array/unique (array/map (array/reduce (object/get @entity.seedProgram "orbitals" []) [] (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" [])))) (fn e (if (== @e null) "" (object/get @e "name" "")))))))
          (do
            (set @entity.seedIds (array/reduce @names @noIds (fn (acc name) (object/set @acc @name (if (and (and (!= @entity.viewer null) (object/has @entity.viewer "id")) (array/includes (object/get @entity.owners (str/lower @name) []) "id")) (default (str/template "{{v}}" { v: (object/get @entity.viewer "id") }) "") (str/concat @name "-verify-seed-1"))))))
            (set @entity.newIds (array/reduce @names @noIds (fn (acc name) (object/set @acc @name (if (and (and (!= @entity.viewer null) (object/has @entity.viewer "id")) (array/includes (object/get @entity.owners (str/lower @name) []) "id")) (default (str/template "{{v}}" { v: (object/get @entity.viewer "id") }) "") (str/concat @name "-verify-new-1"))))))))
        (set @entity.progTraits (array/flatten (array/map (object/get @entity.program "orbitals") (fn o (array/map (object/get @o "traits" []) (fn t (object/set @t "orbital" (object/get @o "name"))))))))
        (let ((idents (array/unique (array/map (array/filter (array/reduce (object/get @entity.seedProgram "orbitals" []) [] (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" [])))) (fn e (and (!= @e null) (object/get @e "identity" false)))) (fn e (if (== @e null) "" (object/get @e "name" "")))))) (noGraph : PlanGraph {}) (noInitial (let ((initBy (array/groupBy (array/filter @entity.progTraits (fn t (array/some (object/get (object/get @t "stateMachine" @noGraph) "states" []) (fn st (object/get @st "isInitial" false))))) (fn t (str/concat (object/get @t "orbital" "") "|" (object/get @t "name")))))) (array/unique (array/map (array/filter @entity.rows (fn r (not (object/has @initBy (str/concat (object/get @r "orbital") "|" (object/get @r "trait")))))) (fn r (str/concat (object/get @r "orbital") "." (object/get @r "trait"))))))))
          (if (> (array/len @noInitial) 0)
            (do (set @entity.steps [])
              (emit PLAN_REFUSED { error: (str/concat "verify-plan: no initial state declared for trait " (str/join @noInitial ", ")) }))
            (let ((roles (let ((idDef (array/find (array/reduce (object/get @entity.seedProgram "orbitals" []) [] (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" [])))) (fn e (and (!= @e null) (object/get @e "identity" false)))))) (if (= @idDef null) [] (let ((rf (array/find (object/get @idDef "fields" []) (fn f (= (object/get @f "name") "role"))))) (if (= @rf null) [] (object/get @rf "values" [])))))))
            (if (and (= @entity.viewer null) (> (array/len @idents) 1))
              (do (set @entity.steps [])
                (emit PLAN_REFUSED { error: (str/concat "verify-plan: the program declares several identity entities (" (str/join @idents ", ") "); pass the viewer to walk as") }))
            (if (and (!= @entity.role null) (= @entity.viewer null) (= (array/len @idents) 0))
              (do (set @entity.steps [])
                (emit PLAN_REFUSED { error: (str/concat "verify-plan: role " (default @entity.role "") " needs an identity entity or a viewer to walk as") }))
            (if (and (!= @entity.role null) (= (array/len @idents) 1) (> (array/len @roles) 0) (not (array/includes @roles (default @entity.role ""))))
              (do (set @entity.steps [])
                (emit PLAN_REFUSED { error: (str/concat "verify-plan: role " (default @entity.role "") " is not a declared role of " (default (array/first @idents) "") " (" (str/join @roles ", ") ")") }))
              (emit PLAN_ROWS {})))))))
      PLAN_ROWS -> ready
        (let ((noForm : PlanForm []) (noGraph : PlanGraph {}) (noPay : PlanPayload {})
              (named (let ((pg (default @entity.program { orbitals: [] }))) (array/concat (object/keys (default (object/get @pg "types") {})) (array/flatten (array/map (object/get @pg "orbitals") (fn o (object/keys (default (object/get @o "types") {})))))))))
         (do (set @entity.steps (let ((traitBy (array/groupBy @entity.progTraits (fn t (str/concat (object/get @t "orbital" "") "|" (object/get @t "name")))))
               (setters : [PlanSetter] (array/filter (array/flatten (array/map @entity.progTraits (fn t (array/map (array/filter (object/get (object/get @t "stateMachine" @noGraph) "transitions" []) (fn a (!= (object/get @a "event") "INIT"))) (fn a { k: (str/concat (object/get @t "orbital" "") "|" (object/get @t "name")), ent: (object/get @t "linkedEntity" ""), trait: (object/get @t "name"), event: (object/get @a "event"), fields: (array/map (array/filter (array/map (array/filter (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (and (> (array/len @f) 1) (= (array/nth @f 0) "set") (validate/string (array/nth @f 1)) (str/startsWith (default (as (array/nth @f 1) PlanStr) "") (quote "@entity."))))) (fn f (str/slice (default (as (array/nth @f 1) PlanStr) "") 8))) }))))) (fn sx (> (array/len (object/get @sx "fields")) 0))))
               (tickBy : Map string [PlanTickSetter] (array/groupBy (array/map @entity.progTraits (fn t { k: (str/concat (object/get @t "orbital" "") "|" (object/get @t "name")), fields: (array/map (array/filter (array/map (array/filter (array/reduce (array/reduce (object/get @t "ticks" []) [] (fn (acc3 tk) (array/concat @acc3 (object/get @tk "effects" [])))) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (and (> (array/len @f) 1) (= (array/nth @f 0) "set") (validate/string (array/nth @f 1)) (str/startsWith (default (as (array/nth @f 1) PlanStr) "") (quote "@entity."))))) (fn f (str/slice (default (as (array/nth @f 1) PlanStr) "") 8))) })) (fn tx (object/get @tx "k"))))
               (armsBy (array/groupBy (array/flatten (array/map @entity.progTraits (fn t (array/map (object/get (object/get @t "stateMachine" @noGraph) "transitions" []) (fn a { k: (str/concat (object/get @t "orbital" "") "|" (object/get @t "name") "|" (object/get @a "event")), a: @a }))))) (fn x (object/get @x "k")))))
          (let ((setBy : Map string [PlanSetter] (array/groupBy @setters (fn sx (object/get @sx "k")))) (setByEnt : Map string [PlanSetter] (array/groupBy @setters (fn sx (object/get @sx "ent"))))) (array/flatten (array/map @entity.rows (fn r
            (let ((tr (array/first (object/get @traitBy (str/concat (object/get @r "orbital") "|" (object/get @r "trait")) []))))
 (if (= @tr null) []
              (let ((ent (object/get @tr "linkedEntity" "")) (evArms (array/map (object/get @armsBy (str/concat (object/get @r "orbital") "|" (object/get @r "trait") "|" (object/get @r "event")) []) (fn x (object/get @x "a")))))
                (let ((seed (if (= @ent "") "" (object/get @entity.seedIds @ent (str/concat @ent "-verify-seed-1"))))
                      (keyNodes (array/filter (array/map (array/filter (array/reduce @evArms [] (fn (acc a) (array/concat @acc (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm)))
                                         (fn f (and (> (array/len @f) 2) (= (array/take @f 2) (quote ["set", "@entity.id"])) (and (validate/string (array/nth @f 2)) (str/startsWith (default (as (array/nth @f 2) PlanStr) "") (quote "@payload."))))))))
                  (let ((keys (array/flatten (array/map @keyNodes (fn f (let ((k (array/nth @f 2))) (if (validate/string @k) [(str/slice (default (as @k PlanStr) "") 9)] [])))))))
                  (let ((keysShort (!= (array/len @keys) (array/len @keyNodes))))
                  (let ((planned (array/reduce (object/get @r "payload") @noPay
                                   (fn (acc s)
                                     (let ((noArr : [JsonValue] []) (pv
                                       (if (and (!= @seed "") (or (array/includes @keys (object/get @s "name")) (= (object/get @s "name") "id"))) (as @seed JsonValue)
                                       (if (object/has @s "values") (as (array/nth (object/get @s "values" []) 0) JsonValue)
                                       (if (or (object/has @s "entity") (= (object/get @s "type") (quote "@entity")) (= (object/get @s "type") "[@entity]")) (if (str/startsWith (object/get @s "type") "[") (as [{ id: @seed }] JsonValue) (as { id: @seed } JsonValue))
                                       (if (array/includes @named (object/get @s "type")) null
                                       (if (array/includes ["number" "int" "integer" "float" "money"] (object/get @s "type")) (as 1 JsonValue)
                                       (if (= (object/get @s "type") "date") (as "2026-01-01" JsonValue)
                                       (if (array/includes ["datetime" "timestamp" "instant"] (object/get @s "type")) (as "2026-01-01T00:00:00Z" JsonValue)
                                       (if (str/startsWith (object/get @s "type") "Map<") (as {} JsonValue)
                                       (if (array/includes ["boolean" "bool"] (object/get @s "type")) (as true JsonValue)
                                       (if (= (object/get @s "type") "email") (as "verify@example.com" JsonValue)
                                       (if (array/includes ["url" "image"] (object/get @s "type")) (as "https://example.com/verify" JsonValue)
                                       (if (= (object/get @s "type") "phone") (as "+1-555-0100" JsonValue)
                                       (if (= (object/get @s "type") "uuid") (as "00000000-0000-4000-8000-000000000001" JsonValue)
                                       (if (= (object/get @s "type") "bytes") (as "dmVyaWZ5" JsonValue)
                                       (if (str/startsWith (object/get @s "type") "[") (as @noArr JsonValue) (as "verify" JsonValue)))))))))))))))))) (if (= @pv null) @acc (object/set @acc (object/get @s "name") @pv))))))
                        (objectSlot (array/some (object/get @r "payload") (fn s (or (array/includes ["object" "[object]"] (object/get @s "type")) (and (object/get @s "required") (array/includes @named (object/get @s "type"))))))))
                    (let ((arms (object/get (object/get @tr "stateMachine" @noGraph) "transitions" []))
                          (guarded (object/get @r "guarded")))
                      (let ((arm (array/find @evArms (fn a (and (= (object/get @a "event") (object/get @r "event")) (= (object/get @a "to") (object/get @r "to")) (= (object/has @a "guard") @guarded) (array/includes (let ((fr (object/get @a "from"))) (if (validate/string @fr) [@fr] @fr)) (object/get @r "from")))))))
                        (let ((guardOf (if (= @arm null) "" (object/get @arm "guard" ""))))
(if (and @guarded (= @arm null)) []
(let ((bindTexts (if @guarded (array/map (array/filter (json/nodes @guardOf) (fn n (and (validate/string @n) (str/startsWith (default (as @n PlanStr) "") (quote "@"))))) (fn n (default (as @n PlanStr) ""))) [])))
                          (let ((payloadBinds (array/filter @bindTexts (fn b (str/startsWith (str/slice @b 1) "payload."))))
                                (entityFields (array/unique (array/map (array/filter @bindTexts (fn b (and (str/startsWith (str/slice @b 1) "entity.") (!= (str/slice @b 1) "entity.id")))) (fn b (str/slice @b 8)))))
                                (gform (if @guarded (if (validate/array @guardOf) (default (as @guardOf PlanForm) @noForm) []) [])))
                            (let ((head (if (> (array/len @gform) 0) (if (validate/string (array/nth @gform 0)) (default (as (array/nth @gform 0) PlanStr) "") "") ""))
                                  (guardExpr (if @guarded @guardOf "")))
(let ((n1 (and (= (array/len @gform) 2) (= @head "not"))))
(let ((g1 (if @n1 (if (validate/array (array/nth @gform 1)) (default (as (array/nth @gform 1) PlanForm) @noForm) []) @gform)))
(let ((h1 (if (and (> (array/len @g1) 0) (validate/string (array/nth @g1 0))) (default (as (array/nth @g1 0) PlanStr) "") "")))
(let ((n2 (and @n1 (= (array/len @g1) 2) (= @h1 "not"))))
(let ((g2 (if @n2 (if (validate/array (array/nth @g1 1)) (default (as (array/nth @g1 1) PlanForm) @noForm) []) @g1)) (w2 (if @n2 true (not @n1))))
(let ((h2 (if (and (> (array/len @g2) 0) (validate/string (array/nth @g2 0))) (default (as (array/nth @g2 0) PlanStr) "") "")))
(let ((comb (array/includes ["and","or"] @h2)))
(let ((allMode (or (not @comb) (= (= @h2 "and") @w2))) (forms (if @comb (array/map (array/drop @g2 1) (fn e (if (validate/array @e) (default (as @e PlanForm) @noForm) []))) [@g2])))
(let ((units (array/map @forms (fn f (if (and (= (array/len @f) 2) (= (if (and (> (array/len @f) 0) (validate/string (array/nth @f 0))) (default (as (array/nth @f 0) PlanStr) "") "") "not")) { f: (if (validate/array (array/nth @f 1)) (default (as (array/nth @f 1) PlanForm) @noForm) []), w: (not @w2) } { f: @f, w: @w2 })))))
(let ((descs (array/map @units (fn u (let ((f (object/get @u "f")) (w (object/get @u "w"))) (let ((n (array/len @f)) (fh (if (and (> (array/len @f) 0) (validate/string (array/nth @f 0))) (default (as (array/nth @f 0) PlanStr) "") "")))
  (let ((na (array/nth @f 1)) (nb (array/nth @f 2)))
    (let ((ka (if (= @n 3) (if (validate/string @na) (let ((s0 (default (as @na PlanStr) ""))) (if (str/startsWith @s0 (quote "@payload.")) (if (> (str/len @s0) 9) "path" "bind") (if (str/startsWith @s0 (quote "@")) "bind" "string"))) (if (validate/boolean @na) "bool" (if (= @na null) "null" (if (or (validate/array @na) (validate/object @na)) "struct" "number")))) "none")) (kb (if (= @n 3) (if (validate/string @nb) (let ((s0 (default (as @nb PlanStr) ""))) (if (str/startsWith @s0 (quote "@payload.")) (if (> (str/len @s0) 9) "path" "bind") (if (str/startsWith @s0 (quote "@")) "bind" "string"))) (if (validate/boolean @nb) "bool" (if (= @nb null) "null" (if (or (validate/array @nb) (validate/object @nb)) "struct" "number")))) "none")))
      (let ((isCmp (and (= @n 3) (array/includes ["=","==","!=","<","<=",">",">="] @fh))) (isInc (and (= @n 3) (= @fh "array/includes"))) (litA (array/includes ["string","bool","null","number"] @ka)) (litB (array/includes ["string","bool","null","number"] @kb)))
        (let ((cmpA (and @isCmp (= @ka "path") @litB)) (cmpB (and @isCmp (= @kb "path") @litA)) (incA (and @isInc (= @ka "path") (validate/array @nb))) (incB (and @isInc (= @kb "path") (validate/array @na))))
          (let ((constCmp (and @isCmp @litA @litB (array/includes ["=","==","!="] @fh))) (litV (if @cmpA @nb @na)) (litKind (if @cmpA @kb @ka)) (list (if (or @incA @incB) (default (as (if @incA @nb @na) PlanForm) @noForm) [])))
            (let ((op2 (if (array/includes ["=","=="] @fh) (if @w "=" "!=") (if (= @fh "!=") (if @w "!=" "=") (if (= @fh "<") (if @w "<" ">=") (if (= @fh "<=") (if @w "<=" ">") (if (= @fh ">") (if @w ">" "<=") (if @w ">=" "<")))))))
                  (first0 (array/nth @list 0)))
