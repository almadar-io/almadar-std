app std-verify-plan [
  version: "1.0.0",
  env: ["ALMADAR_PERSONA_OWNS"],
  description: "std-verify-plan — the kernel's verify planner (orbital-core planner.rs plan_trait) as data. PLAN_REQUEST carries a resolved program (.orb IR) and std-machine rows; PLAN_ANSWERED returns one PlannedStep per row in row order. Planned: the payload of every unguarded row from its declared slots (row-key slot and id slot = the seed row id, values slot = first declared value, entity slot or bound @entity slot = a full sample row of that entity from the composed std-mock-seed (SAMPLE_ROWS) carrying the seed id (a one-row array for an array slot), number 1, boolean true, email, url, image, phone, uuid, array [], other string 'verify', capitalised non-entity named type null). Unplanned with the Rust reason code: guard-unsolved (guarded row, the symbolic guard solver is not ported) and object-slot-unplanned (object or [object] slot, its properties are not on the row). The walk is bounded array maps in one event, no cascade."
]
;; @capabilities "verify planner, payload synthesis, seed row id, plan a transition, guard payload"
uses Spec from "almadar-std/verify-plan"

type PlanSlot = { name : string!, type : string!, required : boolean!, values : [string], entity : string }
type PlanRow = { orbital : string!, trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, payload : [PlanSlot]! }
type PlanText = { v : string! }
type PlanStr = string
type PlanNum = number
type PlanIds = Map string string
type PlanFroms = { v : [string] }
type PlanForm = [SExpr]
type PlanArm = { event : string!, from : (string | [string])!, to : string!, guard : SExpr, effects : [SExpr] }
type PlanTick = { effects : [SExpr] }
type PlanEmit = { success : string, cancelled : string, onMessage : string, failure : string }
type PlanRoute = { emitter : string!, event : string!, kind : string! }
type PlanRoutes = [PlanRoute]
type PlanListenSource = { kind : string, trait : string }
type PlanListen = { event : string!, triggers : string, source : PlanListenSource }
type PlanOpts = { emit : PlanEmit }
type PlanSteps = [VerifyPlanPlannedStep]
type PlanState = { name : string!, isInitial : boolean }
type PlanGraph = { states : [PlanState], transitions : [PlanArm] }
type PlanTrait = { name : string!, orbital : string, linkedEntity : string, stateMachine : PlanGraph, ticks : [PlanTick], listens : [PlanListen] }
type PlanEntField = { name : string!, default : SExpr }
type PlanEntity = { name : string, fields : [PlanEntField] }
type PlanOrbital = { name : string!, entity : PlanEntity, traits : [PlanTrait] }
type PlanProgram = { orbitals : [PlanOrbital]! }
type PlanFull = { orbitals : [orbital] }
type PlanProbe = { idx : number!, r : PlanRow! }
type PlanProbes = [PlanProbe]
type PlanResult = { guard : string!, transitionFired : boolean! }
type PlanPlayed = { idx : number!, baseNE : boolean!, result : PlanResult! }
type PlanPrecondition = { kind : string!, trait : string, event : string, fields : [string], proof : string!, reason : string }
type JsonValue = string | number | boolean | [JsonValue] | Map string JsonValue
type PlanPayload = Map string JsonValue
type PlanMockValue = string | number | boolean | [PlanMockValue?] | Map string PlanMockValue?
type PlanRelation = { entity : string, cardinality : string }
type PlanSeedField = { name : string!, type : string, required : boolean, values : [string], default : PlanMockValue?, intrinsic : boolean, relation : PlanRelation }
type PlanSeedEntity = { name : string, persistence : string, identity : boolean, fields : [PlanSeedField] }
type PlanSeedOrbital = { entity : PlanSeedEntity, auxiliaryEntities : [PlanSeedEntity] }
type PlanSeedProgram = { orbitals : [PlanSeedOrbital] }
type PlanMockField = { name : string, type : string!, values : [string], default : PlanMockValue?, intrinsic : boolean, required : boolean, relation : PlanRelation }
type PlanRowRef = { idx : number!, key : string!, entity : string!, array : boolean!, seed : string! }
type PlanRowJob = { entity : string!, fields : [PlanMockField]!, runtime : boolean!, identity : boolean! }
type PlanRowRefs = [PlanRowRef]
type PlanRowJobs = [PlanRowJob]
type PlanSeedEntities = [PlanSeedEntity]
type VerifyPlanPlannedStep = { trait : string!, linkedEntity : string, from : string!, event : string!, to : string!, toStates : [string]!, variant : string!, payload : PlanPayload!, guarded : boolean!, arm : number, solved : boolean!, payloadCase : string!, guardCase : string, unplanned : string, precondition : PlanPrecondition, reply : string }

orbital VerifyPlanOrbital {
  entity PlanRun [runtime] {
    id : string!
    steps : [VerifyPlanPlannedStep]! = []
    program : PlanProgram?
    seedProgram : PlanSeedProgram?
    fullProgram : PlanFull?
    rows : [PlanRow] = []
    progTraits : [PlanTrait] = []
    probes : [PlanProbe] = []
    rowRefs : [PlanRowRef] = []
    rowJobs : [PlanRowJob] = []
    createdOnly : [[string]] = []
    viewer : (Map string PlanMockValue)?
    owners : Map string [string] = {}
    seedIds : Map string string = {}
    newIds : Map string string = {}
  }

  uses Seed from "std/behaviors/std-mock-seed"

  trait MockSeed = Seed.traits.MockSeed {
    listens {
      MockStream.CORPUS_IS -> CORPUS_IS
      Plan.SAMPLE_ROWS -> SAMPLE_ROWS
    }
  }

  trait MockStream = Seed.traits.MockStream {
  }

  trait Plan -> PlanRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      PLAN_REQUEST -> ready when (= (as @payload.program PlanProgram) null)
        (set @entity.steps [])
        (emit PLAN_FAILED { error: "verify-plan: the program to plan is not a program" })
      PLAN_REQUEST -> ready when (!= (as @payload.program PlanProgram) null)
        (set @entity.program (as @payload.program PlanProgram))
        (set @entity.seedProgram (as @payload.program PlanSeedProgram))
        (set @entity.fullProgram (as @payload.program PlanFull))
        (set @entity.viewer (object/get @payload "viewer" null))
        (set @entity.owners (object/get @payload "owners" {}))
        (set @entity.rows @payload.rows)
        (emit PLAN_READ {})
      PLAN_READ -> ready when (or (= @entity.seedProgram null) (= @entity.fullProgram null))
        (set @entity.steps [])
        (emit PLAN_FAILED { error: "verify-plan: the program could not be read for planning" })
      PLAN_READ -> ready when (and (!= @entity.program null) (!= @entity.seedProgram null) (!= @entity.fullProgram null))
        (let ((noIds : PlanIds {}) (names (array/unique (array/map (array/reduce (object/get @entity.seedProgram "orbitals" []) [] (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" [])))) (fn e (object/get @e "name" ""))))))
          (do
            (set @entity.seedIds (array/reduce @names @noIds (fn (acc name) (object/set @acc @name (if (and (and (!= @entity.viewer null) (object/has @entity.viewer "id")) (array/includes (object/get @entity.owners (str/lower @name) []) "id")) (default (str/template "{{v}}" { v: (object/get @entity.viewer "id") }) "") (str/concat @name "-verify-seed-1"))))))
            (set @entity.newIds (array/reduce @names @noIds (fn (acc name) (object/set @acc @name (if (and (and (!= @entity.viewer null) (object/has @entity.viewer "id")) (array/includes (object/get @entity.owners (str/lower @name) []) "id")) (default (str/template "{{v}}" { v: (object/get @entity.viewer "id") }) "") (str/concat @name "-verify-new-1"))))))))
        (set @entity.progTraits (array/flatten (array/map (object/get @entity.program "orbitals") (fn o (array/map (object/get @o "traits" []) (fn t (object/set @t "orbital" (object/get @o "name"))))))))
        (let ((noGraph : PlanGraph {}) (noInitial (array/unique (array/map (array/filter @entity.rows (fn r (not (array/some @entity.progTraits (fn t (and (= (object/get @t "name") (object/get @r "trait")) (= (object/get @t "orbital") (object/get @r "orbital")) (array/some (object/get (object/get @t "stateMachine" @noGraph) "states" []) (fn st (object/get @st "isInitial" false))))))))) (fn r (str/concat (object/get @r "orbital") "." (object/get @r "trait")))))))
          (if (> (array/len @noInitial) 0)
            (do (set @entity.steps [])
              (emit PLAN_REFUSED { error: (str/concat "verify-plan: no initial state declared for trait " (str/join @noInitial ", ")) }))
            (emit PLAN_ROWS {})))
      PLAN_ROWS -> ready
        (let ((noForm : PlanForm []) (noGraph : PlanGraph {}) (noPay : PlanPayload {}))
         (do (set @entity.steps (array/flatten (array/map @entity.rows (fn r
            (let ((tr (array/find @entity.progTraits (fn t (and (= (object/get @t "name") (object/get @r "trait")) (= (object/get @t "orbital") (object/get @r "orbital")))))))
 (if (= @tr null) []
              (let ((ent (object/get @tr "linkedEntity" "")))
                (let ((seed (if (= @ent "") "" (object/get @entity.seedIds @ent (str/concat @ent "-verify-seed-1"))))
                      (keyNodes (array/filter (array/map (array/filter (array/reduce (array/filter (object/get (object/get @tr "stateMachine" @noGraph) "transitions" []) (fn a (= (object/get @a "event") (object/get @r "event")))) [] (fn (acc a) (array/concat @acc (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm)))
                                         (fn f (and (> (array/len @f) 2) (= (array/take @f 2) (quote ["set", "@entity.id"])) (and (validate/string (array/nth @f 2)) (str/startsWith (default (as (array/nth @f 2) PlanStr) "") (quote "@payload."))))))))
                  (let ((keys (array/flatten (array/map @keyNodes (fn f (let ((k (array/nth @f 2))) (if (validate/string @k) [(str/slice (default (as @k PlanStr) "") 9)] [])))))))
                  (let ((keysShort (!= (array/len @keys) (array/len @keyNodes))))
                  (let ((planned (array/reduce (object/get @r "payload") @noPay
                                   (fn (acc s)
                                     (let ((noArr : [JsonValue] []) (pv
                                       (if (and (!= @seed "") (or (array/includes @keys (object/get @s "name")) (= (object/get @s "name") "id"))) (as @seed JsonValue)
                                       (if (object/has @s "values") (as (array/nth (object/get @s "values" []) 0) JsonValue)
                                       (if (or (object/has @s "entity") (= (object/get @s "type") (quote "@entity")) (= (object/get @s "type") "[@entity]")) (if (str/startsWith (object/get @s "type") "[") (as [{ id: @seed }] JsonValue) (as { id: @seed } JsonValue))
                                       (if (array/includes ["number" "int" "integer" "float"] (object/get @s "type")) (as 1 JsonValue)
                                       (if (array/includes ["boolean" "bool"] (object/get @s "type")) (as true JsonValue)
                                       (if (= (object/get @s "type") "email") (as "verify@example.com" JsonValue)
                                       (if (array/includes ["url" "image"] (object/get @s "type")) (as "https://example.com/verify" JsonValue)
                                       (if (= (object/get @s "type") "phone") (as "+1-555-0100" JsonValue)
                                       (if (= (object/get @s "type") "uuid") (as "00000000-0000-4000-8000-000000000001" JsonValue)
                                       (if (= (object/get @s "type") "bytes") (as "dmVyaWZ5" JsonValue)
                                       (if (str/startsWith (object/get @s "type") "[") (as @noArr JsonValue) (as "verify" JsonValue)))))))))))))) (if (= @pv null) @acc (object/set @acc (object/get @s "name") @pv))))))
                        (objectSlot (array/some (object/get @r "payload") (fn s (array/includes ["object" "[object]"] (object/get @s "type"))))))
                    (let ((arms (object/get (object/get @tr "stateMachine" @noGraph) "transitions" []))
                          (guarded (object/get @r "guarded")))
                      (let ((arm (array/find @arms (fn a (and (= (object/get @a "event") (object/get @r "event")) (= (object/get @a "to") (object/get @r "to")) (= (object/has @a "guard") @guarded) (array/includes (let ((fr (object/get @a "from"))) (if (validate/string @fr) [@fr] @fr)) (object/get @r "from")))))))
                        (let ((guardOf (if (= @arm null) "" (object/get @arm "guard" ""))))
(if (and @guarded (= @arm null)) []
(let ((bindTexts (if @guarded (array/map (array/filter (json/nodes @guardOf) (fn n (and (validate/string @n) (str/startsWith (default (as @n PlanStr) "") (quote "@"))))) (fn n (default (as @n PlanStr) ""))) [])))
                          (let ((payloadBinds (array/filter @bindTexts (fn b (str/startsWith (str/slice @b 1) "payload."))))
                                (entityFields (array/unique (array/map (array/filter @bindTexts (fn b (and (str/startsWith (str/slice @b 1) "entity.") (!= (str/slice @b 1) "entity.id")))) (fn b (str/slice @b 8)))))
                                (gform (if @guarded (if (validate/array @guardOf) (default (as @guardOf PlanForm) @noForm) []) [])))
                            (let ((head (if (> (array/len @gform) 0) (if (validate/string (array/nth @gform 0)) (default (as (array/nth @gform 0) PlanStr) "") "") ""))
                                  (guardExpr (if @guarded @guardOf "")))
(let ((n1 (and (= (array/len @gform) 2) (= @head "not"))))
(let ((g1 (if @n1 (if (validate/array (array/nth @gform 1)) (default (as (array/nth @gform 1) PlanForm) @noForm) []) @gform)))
(let ((h1 (if (and (> (array/len @g1) 0) (validate/string (array/nth @g1 0))) (default (as (array/nth @g1 0) PlanStr) "") "")))
(let ((n2 (and @n1 (= (array/len @g1) 2) (= @h1 "not"))))
(let ((g2 (if @n2 (if (validate/array (array/nth @g1 1)) (default (as (array/nth @g1 1) PlanForm) @noForm) []) @g1)) (w2 (if @n2 true (not @n1))))
(let ((h2 (if (and (> (array/len @g2) 0) (validate/string (array/nth @g2 0))) (default (as (array/nth @g2 0) PlanStr) "") "")))
(let ((comb (array/includes ["and","or"] @h2)))
(let ((allMode (or (not @comb) (= (= @h2 "and") @w2))) (forms (if @comb (array/map (array/drop @g2 1) (fn e (if (validate/array @e) (default (as @e PlanForm) @noForm) []))) [@g2])))
(let ((units (array/map @forms (fn f (if (and (= (array/len @f) 2) (= (if (and (> (array/len @f) 0) (validate/string (array/nth @f 0))) (default (as (array/nth @f 0) PlanStr) "") "") "not")) { f: (if (validate/array (array/nth @f 1)) (default (as (array/nth @f 1) PlanForm) @noForm) []), w: (not @w2) } { f: @f, w: @w2 })))))
(let ((descs (array/map @units (fn u (let ((f (object/get @u "f")) (w (object/get @u "w"))) (let ((n (array/len @f)) (fh (if (and (> (array/len @f) 0) (validate/string (array/nth @f 0))) (default (as (array/nth @f 0) PlanStr) "") "")))
  (let ((na (array/nth @f 1)) (nb (array/nth @f 2)))
    (let ((ka (if (= @n 3) (if (validate/string @na) (let ((s0 (default (as @na PlanStr) ""))) (if (str/startsWith @s0 (quote "@payload.")) (if (> (str/len @s0) 9) "path" "bind") (if (str/startsWith @s0 (quote "@")) "bind" "string"))) (if (validate/boolean @na) "bool" (if (= @na null) "null" (if (or (validate/array @na) (validate/object @na)) "struct" "number")))) "none")) (kb (if (= @n 3) (if (validate/string @nb) (let ((s0 (default (as @nb PlanStr) ""))) (if (str/startsWith @s0 (quote "@payload.")) (if (> (str/len @s0) 9) "path" "bind") (if (str/startsWith @s0 (quote "@")) "bind" "string"))) (if (validate/boolean @nb) "bool" (if (= @nb null) "null" (if (or (validate/array @nb) (validate/object @nb)) "struct" "number")))) "none")))
      (let ((isCmp (and (= @n 3) (array/includes ["=","==","!=","<","<=",">",">="] @fh))) (isInc (and (= @n 3) (= @fh "array/includes"))) (litA (array/includes ["string","bool","null","number"] @ka)) (litB (array/includes ["string","bool","null","number"] @kb)))
        (let ((cmpA (and @isCmp (= @ka "path") @litB)) (cmpB (and @isCmp (= @kb "path") @litA)) (incA (and @isInc (= @ka "path") (validate/array @nb))) (incB (and @isInc (= @kb "path") (validate/array @na))))
          (let ((constCmp (and @isCmp @litA @litB (array/includes ["=","==","!="] @fh))) (litV (if @cmpA @nb @na)) (litKind (if @cmpA @kb @ka)) (list (if (or @incA @incB) (default (as (if @incA @nb @na) PlanForm) @noForm) [])))
            (let ((op2 (if (array/includes ["=","=="] @fh) (if @w "=" "!=") (if (= @fh "!=") (if @w "!=" "=") (if (= @fh "<") (if @w "<" ">=") (if (= @fh "<=") (if @w "<=" ">") (if (= @fh ">") (if @w ">" "<=") (if @w ">=" "<")))))))
                  (first0 (array/nth @list 0)))
              (let ((op3 (if @cmpB (if (= @op2 "<") ">" (if (= @op2 "<=") ">=" (if (= @op2 ">") "<" (if (= @op2 ">=") "<=" @op2)))) @op2))
                    (fk (if (> (array/len @list) 0) (if (validate/string @first0) (let ((s0 (default (as @first0 PlanStr) ""))) (if (str/startsWith @s0 (quote "@payload.")) (if (> (str/len @s0) 9) "path" "bind") (if (str/startsWith @s0 (quote "@")) "bind" "string"))) (if (validate/boolean @first0) "bool" (if (= @first0 null) "null" (if (or (validate/array @first0) (validate/object @first0)) "struct" "number")))) "none")))
                (let ((cvt (if (array/includes ["=","<=",">="] @op3) (as @litV JsonValue) (if (= @op3 "<") (if (= @litKind "number") (as (- (default (as @litV PlanNum) 0) 1) JsonValue) null) (if (= @op3 ">") (if (= @litKind "number") (as (+ (default (as @litV PlanNum) 0) 1) JsonValue) null) (if (= @litKind "number") (as (+ (default (as @litV PlanNum) 0) 1) JsonValue) (if (= @litKind "bool") (as (not (= @litV true)) JsonValue) (if (= @litKind "string") (let ((ln (if @cmpA @nb @na))) (if (validate/string @ln) (as (str/concat (default (as @ln PlanStr) "") "-other") JsonValue) null)) (if (= @litKind "null") (as true JsonValue) null))))))))
                      (incV (if (array/includes ["string","bool","null","number"] @fk) (if @w (as (array/nth @list 0) JsonValue) (if (= @fk "string") (let ((f0 (array/nth @list 0))) (if (validate/string @f0) (as (str/concat (default (as @f0 PlanStr) "") "-not-in-list") JsonValue) null)) (as "not-in-list" JsonValue))) null))
                      (short (or (and (or @cmpA @incA) (not (validate/string @na))) (and (not (or @cmpA @incA)) (or @cmpB @incB) (not (validate/string @nb))) (and (or @cmpA @cmpB) (= @op3 "!=") (= @litKind "string") (not (validate/string (if @cmpA @nb @na)))) (and (or @incA @incB) (not @w) (= @fk "string") (not (validate/string (array/nth @list 0)))))))
                  (let ((vt (if (or @cmpA @cmpB) @cvt (if (or @incA @incB) @incV null)))
                        (key (if (or @cmpA @incA) (if (validate/string @na) (str/slice (default (as @na PlanStr) "") 9) "") (if (or @cmpB @incB) (if (validate/string @nb) (str/slice (default (as @nb PlanStr) "") 9) "") ""))))
                    (let ((cv (if (= @fh "!=") (not (= @na @nb)) (= @na @nb))))
                      { kind: (if @constCmp "const" (if (and (!= @vt null) (!= @key "")) "set" "bad")), key: @key, vt: @vt, cv: @cv, w: @w, ck: (if (and (= @fh "=") @cmpA (= @litKind "string") @w) @key (if (and (array/includes ["=","=="] @fh) @cmpB (= @litKind "string") @w) @key (if (and (= @fh "==") @cmpA (= @litKind "string") @w) @key ""))), cl: (if @cmpA @nb @na), short: @short }))))))))))))))))
(let ((constHit (array/some @descs (fn d (and (= (object/get @d "kind") "const") (= (object/get @d "cv") (object/get @d "w")))))))
(let ((res (array/reduce @descs { ok: (and @allMode (> (array/len @descs) 0)), p: @planned } (fn (acc d) (if @allMode (if (and (object/get @acc "ok") (= (object/get @d "kind") "set")) (let ((v (object/get @d "vt"))) (if (= @v null) { ok: false, p: (object/get @acc "p") } { ok: true, p: (object/set (object/get @acc "p") (object/get @d "key") @v) })) { ok: false, p: (object/get @acc "p") }) (if (or (object/get @acc "ok") (!= (object/get @d "kind") "set")) @acc (let ((v (object/get @d "vt"))) (if (= @v null) { ok: false, p: (object/get @acc "p") } { ok: true, p: (object/set (object/get @acc "p") (object/get @d "key") @v) }))))))))
(let ((sol0 (if (and (not @allMode) @constHit) { ok: true, p: @planned } @res)) (cks (array/unique (array/filter (array/map @descs (fn d (object/get @d "ck"))) (fn k (!= @k ""))))))
(let ((sol (if (and @comb (= @h2 "and") @w2 (object/get @sol0 "ok")) { ok: true, p: (array/reduce @cks (object/get @sol0 "p") (fn (acc k) (let ((grp (array/filter @descs (fn d (= (object/get @d "ck") @k))))) (if (< (array/len @grp) 2) @acc (let ((vals (array/unique (array/map @grp (fn d (object/get @d "cl")))))) (let ((one (if (= (array/len @vals) 1) (as (array/nth @vals 0) JsonValue) null))) (if (= @one null) (array/reduce (array/filter (object/keys @acc) (fn x (!= @x @k))) @noPay (fn (a2 x) (object/set @a2 @x (object/get @acc @x)))) (object/set @acc @k @one)))))))) } @sol0)))
(let ((ok (or (not @guarded) (object/get @sol "ok"))))
(let ((solvedPayload (if (and @guarded (> (array/len @payloadBinds) 0) @ok) (object/get @sol "p") @planned))
                                        (sameHit (array/some (array/filter @arms (fn a (!= (object/get @a "event") "INIT"))) (fn a (array/some (array/map (array/filter (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (array/some @entityFields (fn fld (= (array/take @f 2) ["set", (str/concat (quote "@entity.") @fld)]))))))))
                                        (tickHit (array/some @entityFields (fn fld (array/some (array/map (array/filter (array/reduce (object/get @tr "ticks" []) [] (fn (acc3 tk) (array/concat @acc3 (array/reduce (object/get @tk "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (= (array/take @f 2) ["set", (str/concat (quote "@entity.") @fld)]))))))
                                        (cands (array/reduce @entity.progTraits [] (fn (acc t) (if (and (!= (object/get @t "name") (object/get @r "trait")) (!= @ent "") (= (object/get @t "linkedEntity" "") @ent)) (array/concat @acc (array/map (array/filter (object/get (object/get @t "stateMachine" @noGraph) "transitions" []) (fn a (and (!= (object/get @a "event") "INIT") (array/some (array/map (array/filter (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (array/some @entityFields (fn fld (= (array/take @f 2) ["set", (str/concat (quote "@entity.") @fld)])))))))) (fn a { trait: (object/get @t "name"), event: (object/get @a "event") }))) @acc)))))
                                    (let ((why (if (not @ok) "guard-unsolved" (if @objectSlot "object-slot-unplanned" ""))))
                                      (let ((pre (if (and @guarded (> (array/len @entityFields) 0)) (let ((c0 (array/nth @cands 0))) (if (!= @c0 null) { kind: "established", trait: (object/get @c0 "trait"), event: (object/get @c0 "event"), fields: @entityFields, proof: "unproven", reason: "setter-value-unresolved" } (if (or @sameHit @tickHit) { kind: "same-trait-setter", trait: "", event: "", fields: @entityFields, proof: "unproven", reason: "setter-not-on-replay-path" } { kind: "unreachable", trait: "", event: "", fields: @entityFields, proof: "unproven", reason: "unreachable" }))) { kind: "none", trait: "", event: "", fields: [], proof: "proven", reason: "" })))
                                        (let ((step { trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"), to: (object/get @r "to"), toStates: [(object/get @r "to")], variant: (if (array/some (array/filter (object/get (object/get @tr "stateMachine" @noGraph) "states" []) (fn st (object/get @st "isInitial" false))) (fn st (= (object/get @st "name") (object/get @r "from")))) "auto-init" "success"), payload: @solvedPayload, guarded: @guarded, solved: (= @why ""), payloadCase: "success" }))
                                          (let ((withEntity (if (= @ent "") @step (object/set @step "linkedEntity" @ent))))
                                            (let ((withGuard (if @guarded (object/set @withEntity "guardCase" "pass") @withEntity)))
                                              (let ((withPre (if (= (object/get @pre "kind") "none") @withGuard (object/set @withGuard "precondition" @pre))))
                                                (if (or @keysShort (array/some @descs (fn d (object/get @d "short")))) [] [(if (= @why "") @withPre (object/set @withPre "unplanned" @why))])))))))))))))))))))))))))))))))))))))))))
          (emit PLAN_PLANNED {})))
      PLAN_PLANNED -> ready when (!= (array/len @entity.steps) (array/len @entity.rows))
        (set @entity.steps [])
        (emit PLAN_FAILED { error: "verify-plan: a guard or set node the plan reads as text is not text" })
      PLAN_PLANNED -> ready when (and (= (array/len @entity.steps) (array/len @entity.rows)) (= @entity.seedProgram null))
        (set @entity.steps [])
        (emit PLAN_FAILED { error: "verify-plan: the program's entities could not be read for planning" })
      PLAN_PLANNED -> ready when (and (= (array/len @entity.steps) (array/len @entity.rows)) (!= @entity.seedProgram null))
        (let ((noForm : PlanForm []) (noGraph : PlanGraph {}) (noOpts : PlanOpts {}))
         (do
        (let ((noForm : PlanForm []) (noEmit : PlanEmit {}) (noRoutes : PlanRoutes []) (noSrc : PlanListenSource {}) (noGraph : PlanGraph {}) (noOpts : PlanOpts {}))
          (set @entity.steps (let ((routes (array/reduce @entity.progTraits @noRoutes (fn (ra t)
            (let ((forms (array/map (array/filter (array/reduce (object/get (object/get @t "stateMachine" @noGraph) "transitions" []) [] (fn (a2 arm) (array/concat @a2 (array/reduce (object/get @arm "effects" []) [] (fn (a3 e) (array/concat @a3 (json/nodes @e))))))) (fn n (and (validate/array @n) (let ((hf (default (as @n PlanForm) @noForm))) (and (> (array/len @hf) 0) (array/includes ["http", "postgres"] (default (as (array/first @hf) PlanStr) ""))))))) (fn n (default (as @n PlanForm) @noForm)))))
              (let ((emits (array/map (array/filter @forms (fn f (validate/object (array/nth @f (- (array/len @f) 1))))) (fn f (object/get (default (as (array/nth @f (- (array/len @f) 1)) PlanOpts) @noOpts) "emit" @noEmit)))))
                (array/concat @ra (array/reduce @emits @noRoutes (fn (rb m) (array/concat (array/concat (array/concat (array/concat @rb (if (!= (object/get @m "success" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "success"), kind: "other" }] @noRoutes)) (if (!= (object/get @m "cancelled" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "cancelled"), kind: "other" }] @noRoutes)) (if (!= (object/get @m "onMessage" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "onMessage"), kind: "other" }] @noRoutes)) (if (!= (object/get @m "failure" "") "") [{ emitter: (object/get @t "name"), event: (object/get @m "failure"), kind: "failure" }] @noRoutes)))))))))))
          (array/reduce @entity.steps [] (fn (acc st)
            (let ((row (array/nth @entity.rows (array/len @acc))))
 (if (= @row null) @acc
              (let ((tr (array/find @entity.progTraits (fn t (and (= (object/get @t "name") (object/get @row "trait")) (= (object/get @t "orbital") (object/get @row "orbital")))))))
 (if (= @tr null) @acc
                (let ((isOther (array/some @routes (fn r (and (= (object/get @r "kind") "other") (or (and (= (object/get @r "emitter") (object/get @row "trait")) (= (object/get @r "event") (object/get @row "event"))) (array/some (object/get @tr "listens" []) (fn l (and (= (object/get @l "event") (object/get @r "event")) (or (not (object/has @l "source")) (= (object/get (object/get @l "source" @noSrc) "kind" "") "any") (= (object/get (object/get @l "source" @noSrc) "trait" "") (object/get @r "emitter"))) (= (object/get @l "triggers" (object/get @l "event")) (object/get @row "event"))))))))) )
                      (isFail (array/some @routes (fn r (and (= (object/get @r "kind") "failure") (or (and (= (object/get @r "emitter") (object/get @row "trait")) (= (object/get @r "event") (object/get @row "event"))) (array/some (object/get @tr "listens" []) (fn l (and (= (object/get @l "event") (object/get @r "event")) (or (not (object/has @l "source")) (= (object/get (object/get @l "source" @noSrc) "kind" "") "any") (= (object/get (object/get @l "source" @noSrc) "trait" "") (object/get @r "emitter"))) (= (object/get @l "triggers" (object/get @l "event")) (object/get @row "event"))))))))) ))
                  (array/concat @acc [(if @isOther (object/set @st "reply" "other") (if @isFail (object/set @st "reply" "failure") @st))])))))))))))
        (set @entity.probes (array/filter (array/reduce @entity.rows [] (fn (acc r) (array/concat @acc [{ idx: (array/len @acc), r: @r }]))) (fn p (let ((ps (array/nth @entity.steps (object/get @p "idx")))) (if (= @ps null) false (object/has @ps "precondition"))))))
        (set @entity.createdOnly (array/map (array/range (array/len @entity.rows)) (fn i
          (let ((r (array/nth @entity.rows @i)))
 (if (= @r null) []
            (let ((tr (array/find @entity.progTraits (fn t (and (= (object/get @t "name") (object/get @r "trait")) (= (object/get @t "orbital") (object/get @r "orbital")))))))
 (if (= @tr null) []
              (let ((pers (array/filter (array/map (array/filter (array/reduce (array/filter (object/get (object/get @tr "stateMachine" @noGraph) "transitions" []) (fn a (= (object/get @a "event") (object/get @r "event")))) [] (fn (acc a) (array/concat @acc (array/reduce (object/get @a "effects" []) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e))))))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (and (> (array/len @f) 2) (= (array/nth @f 0) "persist") (validate/string (array/nth @f 2)))))))
                (let ((named (array/map @pers (fn f { op: (default (as (array/nth @f 1) PlanStr) ""), entity: (default (as (array/nth @f 2) PlanStr) "") }))))
                  (array/filter (array/unique (array/map @named (fn n (object/get @n "entity")))) (fn e (array/every (array/filter @named (fn n (= (object/get @n "entity") @e))) (fn n (= (object/get @n "op") "create"))))))))))))))
        (set @entity.rowRefs (array/reduce (array/range (array/len @entity.rows)) [] (fn (acc i)
          (let ((r (array/nth @entity.rows @i)) (st (array/nth @entity.steps @i)))
 (if (= @r null) @acc (if (= @st null) @acc
            (let ((seed (object/get @entity.seedIds (object/get @st "linkedEntity" "") (str/concat (object/get @st "linkedEntity" "") "-verify-seed-1"))))
              (array/concat @acc (array/map (array/filter (object/get @r "payload")
                  (fn sl (and (!= (object/get @st "linkedEntity" "") "") (not (object/has @sl "values")) (or (object/has @sl "entity") (= (object/get @sl "type") (quote "@entity")) (= (object/get @sl "type") "[@entity]"))
                    (or (= (object/get (object/get @st "payload") (object/get @sl "name")) { id: @seed }) (= (object/get (object/get @st "payload") (object/get @sl "name")) [{ id: @seed }])))))
                (fn sl { idx: @i, key: (object/get @sl "name"), entity: (object/get @sl "entity" (object/get @st "linkedEntity" "")), array: (str/startsWith (object/get @sl "type") "["), seed: (let ((name (object/get @sl "entity" (object/get @st "linkedEntity" "")))) (if (array/includes (default (array/nth @entity.createdOnly @i) []) @name) (object/get @entity.newIds @name (str/concat @name "-verify-new-1")) (object/get @entity.seedIds @name (str/concat @name "-verify-seed-1")))) }))))))))))
        (set @entity.steps (array/reduce @entity.steps [] (fn (acc st)
          (let ((only (default (array/nth @entity.createdOnly (array/len @acc)) [])))
            (array/concat @acc [(if (= (array/len @only) 0) @st
              (object/set @st "payload" (array/reduce (object/keys (object/get @st "payload")) (object/get @st "payload") (fn (acc2 k)
                (let ((hit (array/find @only (fn e (= (object/get @acc2 @k) (object/get @entity.seedIds @e (str/concat @e "-verify-seed-1")))))))
                  (if (or (= @hit null) (= @hit "")) @acc2 (object/set @acc2 @k (object/get @entity.newIds @hit (str/concat @hit "-verify-new-1")))))))))])))))
        (set @entity.rowJobs (let ((ents (array/reduce (object/get @entity.seedProgram "orbitals" []) [] (fn (acc o) (array/concat (array/concat @acc [(object/get @o "entity")]) (object/get @o "auxiliaryEntities" []))))))
          (array/reduce (array/unique (array/map @entity.rowRefs (fn rf (object/get @rf "entity")))) [] (fn (acc name)
            (let ((def (array/find @ents (fn e (= (object/get @e "name" "") @name)))))
             (if (= @def null) @acc (if (= (object/get @def "name" "") "") @acc
                (array/concat @acc [{ entity: @name, runtime: (= (object/get @def "persistence" "") "runtime"), identity: (object/get @def "identity" false),
                  fields: (array/map (object/get @def "fields" []) (fn f
                    (let ((base { name: (object/get @f "name"), type: (object/get @f "type" "string"), required: (object/get @f "required" false), intrinsic: (object/get @f "intrinsic" false) }))
                      (let ((withCard (if (object/has @f "relation") (object/set @base "relation" (object/get @f "relation")) @base)))
                        (let ((withValues (if (object/has @f "values") (object/set @withCard "values" (object/get @f "values")) @withCard)))
                          (if (object/has @f "default") (object/set @withValues "default" (object/get @f "default")) @withValues)))))) }]))))))))
        (emit PLAN_COMPUTED { count: (array/len @entity.steps) })))
      PLAN_COMPUTED -> ready when (> (array/len @entity.rowJobs) 0)
        (let ((job (array/first @entity.rowJobs)))
          (if (= @job null) (emit PLAN_FAILED { error: "verify-plan: no entity is pending a sample row" })
            (emit SAMPLE_ROWS { fields: (object/get @job "fields"), name: (object/get @job "entity"), count: 1, runtime: (object/get @job "runtime"), identity: (object/get @job "identity") })))
      ROWS_DONE -> ready
        (let ((jobRec (array/first @entity.rowJobs)) (row (array/first @payload.rows)) (vid (if (= @entity.viewer null) "" (object/get @entity.viewer "id" ""))))
         (if (= @jobRec null) (emit PLAN_FAILED { error: "verify-plan: a sample row arrived with no entity pending" })
          (if (= @row null) (emit PLAN_FAILED { error: "verify-plan: the sample row is empty" })
          (let ((job (object/get @jobRec "entity")))
          (do
            (set @entity.steps (array/reduce @entity.steps [] (fn (acc0 st0)
              (let ((i (array/len @acc0))) (array/concat @acc0 [(array/reduce (array/filter @entity.rowRefs (fn rf (and (= (object/get @rf "idx") @i) (= (object/get @rf "entity") @job)))) @st0 (fn (st rf)
                (let ((seeded (object/set @row "id" (object/get @rf "seed"))))
                  (if (= @seeded null) @st
                    (let ((full (array/reduce (if (and (!= @entity.viewer null) (object/has @entity.viewer "id")) (object/get @entity.owners (str/lower @job) []) []) @seeded (fn (acc field) (object/set @acc @field @vid)))))
                      (let ((pay (if (object/get @rf "array") (object/set (object/get @st "payload") (object/get @rf "key") [@full]) (object/set (object/get @st "payload") (object/get @rf "key") @full))))
                        (if (= @pay null) @st (object/set @st "payload" @pay))))))))])))))
            (set @entity.rowJobs (array/drop @entity.rowJobs 1))
            (emit PLAN_COMPUTED { count: (array/len @entity.steps) }))))))
      PLAN_COMPUTED -> ready when (and (= (array/len @entity.rowJobs) 0) (= (array/len @entity.probes) 0))
        (emit PLAN_ANSWERED { steps: @entity.steps })
      PLAN_COMPUTED -> ready when (and (= (array/len @entity.rowJobs) 0) (> (array/len @entity.probes) 0) (or (= @entity.program null) (= @entity.fullProgram null)))
        (emit PLAN_FAILED { error: "verify-plan: the program was not kept for the baseline probe" })
      PLAN_COMPUTED -> ready when (and (= (array/len @entity.rowJobs) 0) (> (array/len @entity.probes) 0) (!= @entity.program null) (!= @entity.fullProgram null))
        (let ((noForm : PlanForm []) (orbs (object/get @entity.program "orbitals")) (noGraph : PlanGraph {}))
          (program/step @entity.fullProgram (array/reduce @entity.probes [] (fn (acc p)
            (let ((r (object/get @p "r")))
              (let ((o (array/find @orbs (fn o (= (object/get @o "name") (object/get @r "orbital"))))))
               (if (= @o null) @acc
                (let ((tr (array/find (object/get @o "traits" []) (fn t (= (object/get @t "name") (object/get @r "trait"))))))
                 (if (= @tr null) @acc
                  (let ((sp (array/nth @entity.steps (object/get @p "idx"))))
                   (if (= @sp null) @acc
                  (let ((inits (array/filter (object/get (object/get @tr "stateMachine" @noGraph) "transitions" []) (fn a (= (object/get @a "event") "INIT"))))
                        (fields (let ((pc (object/get @sp "precondition"))) (if (= @pc null) [] (object/get @pc "fields" [])))))
                   (let ((i0 (array/first @inits)))
                    (let ((hasInit (!= @i0 null)))
                      (let ((initFrom (if (= @i0 null) "" (default (array/nth (let ((fr (object/get @i0 "from"))) (if (validate/string @fr) [@fr] @fr)) 0) "")))
                            (entFields (object/get (object/get @o "entity" {}) "fields" []))
                            (initSet (and @hasInit (array/some (array/map (array/filter (array/reduce (if (= @i0 null) [] (object/get @i0 "effects" [])) [] (fn (acc2 e) (array/concat @acc2 (json/nodes @e)))) (fn n (validate/array @n))) (fn n (default (as @n PlanForm) @noForm))) (fn f (array/some @fields (fn fld (= (array/take @f 2) ["set", (str/concat (quote "@entity.") @fld)]))))))))
                        (let ((baseNE (or @initSet (array/some @fields (fn fld (array/some @entFields (fn e (and (= (object/get @e "name") @fld) (object/has @e "default")))))))))
                          (array/concat @acc (array/concat
                            (if @hasInit [{ orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (if (= @initFrom "*") (object/get @r "from") @initFrom), event: "INIT", viewer: @entity.viewer, payload: {}, idx: (- 0 1), baseNE: false }] [])
                            [{ orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"), viewer: @entity.viewer, payload: (object/get @sp "payload"), idx: (object/get @p "idx"), baseNE: @baseNE }])))))))))))))))) { key: "steps" emit: { success: PLAN_STEPPED, failure: PLAN_FAILED } }))
      PLAN_STEPPED -> ready
        (set @entity.steps (array/reduce @entity.steps [] (fn (acc s)
          (let ((hit (array/first (array/filter @payload.result (fn q (= (object/get @q "idx") (array/len @acc)))))))
            (array/concat @acc [(if (and (!= @hit null) (= (object/get (object/get @hit "result") "guard") "pass") (object/get @hit "baseNE"))
              (object/omit @s ["precondition"])
              @s)])))))
        (emit PLAN_ANSWERED { steps: @entity.steps })
      PLAN_FAILED -> ready
        (emit PLAN_ANSWERED { steps: @entity.steps })
    }

    emits {
      PLAN_READ -> internal { }
        @description "Internal: the program is kept; the entity ids and traits are read next."
        @tier "internal"
      PLAN_ROWS -> internal { }
        @description "Internal: plan each row."
        @tier "internal"
      PLAN_PLANNED -> internal { }
        @description "Internal: every row is planned; replies, probes and sample rows are read next."
        @tier "internal"
      PLAN_COMPUTED -> internal { count : number! }
        @description "Internal: the plan is computed; the baseline probe runs next when rows need it."
        @tier "internal"
      PLAN_STEPPED -> internal { result : [PlanPlayed]! }
        @description "Internal: the baseline probe played."
        @tier "internal"
      PLAN_FAILED -> internal { error : string }
        @description "Internal: the baseline probe failed; the computed plan stands."
        @tier "internal"
      SAMPLE_ROWS -> external { fields : [PlanMockField]!, name : string!, count : number!, runtime : boolean!, identity : boolean! }
        @description "Internal: ask the composed mock seed for one sample row of an entity slot's entity."
        @tier "internal"
      PLAN_REFUSED -> external { error : string! }
        @description "The program cannot be planned: a planned trait declares no initial state."
        @tier "domain"
      PLAN_ANSWERED -> external { steps : [VerifyPlanPlannedStep]! }
        @description "One planned step per row, in row order."
        @tier "domain"
    }

    listens {
      MockSeed.ROWS_DONE -> ROWS_DONE
      ROWS_DONE { rows : [Map string PlanMockValue?]! }
        @description "Internal: the composed mock seed answered the sample row."
        @tier "internal"
      PLAN_REQUEST -> input { program : SExpr!, rows : [PlanRow]!, viewer : (Map string PlanMockValue)?, owners : Map string [string] }
        @description "Plan a payload for each machine row of a resolved program."
        @synonyms "verify plan, plan transitions, synthesize payloads, seed row id"
    }
  }

  page boot as VerifyPlanBoot -> Plan, MockSeed, MockStream
}
