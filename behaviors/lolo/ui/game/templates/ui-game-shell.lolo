app ui-game-shell "1.0.0"
"GameShell — UI factory (1:1 with the @almadar/ui game-shell pattern)."
orbital GameShellOrbital {
  type GameShellBackgroundAsset = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type GameShellHudBackgroundAsset = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }

  entity GameShellItem [runtime] {
    id : string!
  }

  trait GameShellRender -> @rebindable GameShellItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          appName: @config.appName
          hud: @config.hud
          addons: @config.addons
          controls: @config.controls
          overlay: @config.overlay
          className: @config.className
          showTopBar: @config.showTopBar
          children: @config.children
          backgroundAsset: @config.backgroundAsset
          hudBackgroundAsset: @config.hudBackgroundAsset
          fontFamily: @config.fontFamily
          data-theme: @config.theme
          type: game-shell
        })
    }

    config {
      appName : string = Game
        @label "App Name"
        @description "Application / game title shown as a floating chip"
        @tier "presentation"
      hud : node
        @label "Hud"
        @description "Stat chips row — floats along the top edge. Legacy chrome surface: new behaviors emit HUD chrome via render-ui \"hud-top\" instead."
        @tier "presentation"
      addons : node
        @label "Addons"
        @description "Action cluster — floats bottom-right (End Turn, Fire, Reset, …). Legacy chrome surface: new behaviors emit action chrome via render-ui \"hud-bottom\" or \"floating\" instead."
        @tier "presentation"
      controls : node
        @label "Controls"
        @description "Movement controls — floats bottom-left (d-pad / control-grid). Legacy chrome surface: new behaviors emit movement controls via render-ui \"hud-bottom\" instead."
        @tier "presentation"
      overlay : node
        @label "Overlay"
        @description "Centered overlay layer (victory/defeat banners, dialogs). Legacy chrome surface: new behaviors emit overlays via render-ui \"overlay\" (clear with render-ui \"overlay\" null on every exit) instead."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Extra class name on the root container"
        @tier "presentation"
      showTopBar : boolean = true
        @label "Show Top Bar"
        @description "Whether to show the title chip (default: true)"
        @tier "presentation"
      children : node = [{ type: canvas-2d }]
        @label "Children"
        @description "Game content — fills the whole surface underneath the overlays"
        @tier "presentation"
      backgroundAsset : GameShellBackgroundAsset
        @label "Background Asset"
        @description "Pattern slice tiled at low opacity across the surface (never cover-stretched)."
        @tier "presentation"
      hudBackgroundAsset : GameShellHudBackgroundAsset
        @label "Hud Background Asset"
        @description "Per-call-site 9-sliced panel override. Chrome normally comes from the active theme (see the theme config knob); most callers leave this unset."
        @tier "presentation"
      fontFamily : string = future
        @label "Font Family"
        @description "Game display-font key (future | future-narrow | pixel | blocks | mini) or a CSS font-family. Scoped override of the theme contract's --font-family-display slot: titles and numerics take this face, body text follows the active theme."
        @tier "presentation"
      theme : string = ""
        @label "Theme"
        @description "Scopes an @almadar/ui theme (e.g. game-sci-fi-dark) to this shell's subtree. Empty = inherit the ambient theme."
        @tier "presentation"
    }
  }

  page "/game-shell" as GameShellPage -> GameShellRender
}
