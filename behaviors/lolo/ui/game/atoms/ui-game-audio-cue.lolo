app ui-game-audio-cue [
  version: "1.0.0",
  description: "GameAudioCue — UI factory (1:1 with the @almadar/ui game-audio-cue pattern)."
]
;; @pattern "game-audio-cue"
orbital GameAudioCueOrbital {

  type GameAudioCuePlay = {
    key : string!
    source : string!
    volume : number!
    loop : boolean!
    poolSize : number!
    fadeMs : number!
  }

  entity GameAudioCueItem [runtime] {
    id : string!
  }

  trait GameAudioCueRender -> @rebindable GameAudioCueItem {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          cueSeq: @config.cueSeq
          cuePlay: @config.cuePlay
          musicPlay: @config.musicPlay
          autostart: @config.autostart
          muted: @config.muted
          volume: @config.volume
          type: game-audio-cue
        })
    }

    config {
      cueSeq : number
        @label "Cue Seq"
        @description "Monotonically increasing counter — bumping it plays `cuePlay` once; never fires on mount."
        @tier "presentation"
      cuePlay : GameAudioCuePlay = { key: "", source: "", volume: 0, loop: false, poolSize: 1, fadeMs: 0 }
        @label "Cue Play"
        @description "The resolved one-shot to play on the next `cueSeq` bump: full source, entry volume, loop, pool size."
        @tier "presentation"
      musicPlay : GameAudioCuePlay = { key: "", source: "", volume: 0, loop: true, poolSize: 1, fadeMs: 0 }
        @label "Music Play"
        @description "The resolved looping track; a new key crossfades over `fadeMs`, an empty key fades the current track out over `fadeMs`."
        @tier "presentation"
      autostart : [GameAudioCuePlay] = []
        @label "Autostart"
        @description "Resolved sounds started on the first user gesture while unmuted."
        @tier "presentation"
      muted : boolean
        @label "Muted"
        @description "Muted state, owned externally and mirrored into the hook."
        @tier "presentation"
      volume : number
        @label "Volume"
        @description "Master volume 0-1, owned externally and mirrored into the hook."
        @tier "presentation"
    }
  }

  page "/game-audio-cue" as GameAudioCuePage -> GameAudioCueRender
}
