app std-platformer-body "1.0.0"
"Headless run/jump platformer-physics authority: the SOLE writer of body + fell + hazardId + goalId on side-view boards. Where std-motion-body owns free 2D drift (no collision), this atom owns the platformer contract: every 33ms physics tick it integrates gravity into the body's vertical velocity, steps position in per-second units, and collides the body rect against the config platforms with one-way semantics — a body moving in the gravity direction that overlaps a ground/platform tile lands on its anti-gravity face (vy zeroed, grounded set), while a body moving against gravity passes through, so jumping up through a platform and walking up a staircase both just work. The sign of gravity IS the vertical convention: positive pulls toward +y (screen boards, y down — sprite canvases), negative toward −y (math canvases, y up); jumps always fire against it. Intents: STEER sets horizontal velocity (dir −1/0/1 × moveSpeed, hold-to-run: keydown steers, keyup steers 0), JUMP kicks vertical velocity when grounded, PLACE teleports (spawns, hazard respawns), RESTART reseeds. Emits BODY_MOVED every tick for the render layer (boards that don't subscribe pay nothing), plus the sparse rule signals a board needs to score: BODY_JUMPED, BODY_LANDED (with impact speed), BODY_HAZARD (once per hazard entry, re-arms on exit), BODY_GOAL (same arming), BODY_FELL (once per fall past killY, re-armed by PLACE/RESTART). Drift regions: config.driftRegions lists axis-aligned rects each carrying a constant acceleration (ax, ay) applied with the same 0.033s dt whenever the body's center is inside (empty list = zero behavior change). Curve skating: when config.skate is on and the grounded body comes within skateSnap of the config.skateCurve surface, the body rides the curve — y snaps to the interpolated surface and tangential gravity (g·slope/(1+slope²)) accelerates vx, and the vertical velocity is the tangential projection (s = vx·cos θ, vy = s·sin θ — no discontinuous jumps at sample boundaries), so the body slides downhill along the graph itself and launches ballistically off its ends; jumping kicks free. Sparse BODY_SKATE_START/BODY_SKATE_END signals fire on engage/disengage so boards can layer fx. Lives, score, and win/lose stay downstream — this atom simulates, it never judges. Renders nothing."
orbital PlatformerBodyOrbital {
  type PlatformerBody = {
    x : number!
    y : number!
    width : number!
    height : number!
    vx : number
    vy : number
    grounded : boolean
    facingRight : boolean
  }
  type PlatformerPlatform = {
    id : string
    x : number!
    y : number!
    width : number!
    height : number!
    type : "ground" | "platform" | "hazard" | "goal"
  }
  type PlatformerCurveSample = {
    x : number!
    y : number!
  }
  type BodyDriftRegion = {
    id : string!
    x0 : number!
    x1 : number!
    y0 : number!
    y1 : number!
    ax : number!
    ay : number!
  }
  type CurveMod = {
    x0 : number!
    x1 : number!
    a : number!
    h : number!
    k : number!
  }
  type PlatformerTuning = {
    jumpStrength : number
    moveSpeed : number
    gravity : number
  }

  entity PlatformerBodyData [runtime, shared] {
    id : string!
    body : PlatformerBody = { x: 0, y: 0, width: 1, height: 1, vx: 0, vy: 0, grounded: false, facingRight: true }
    fell : boolean = false
    hazardId : string = ""
    curveMods : [CurveMod] = []
    goalId : string = ""
    skating : boolean = false
    tuning : PlatformerTuning = {}
  }

  trait PlatformerBody -> @rebindable PlatformerBodyData [lifecycle] {
    initial: active

    state active {
      INIT -> active
        (set @entity.body @config.spawn)
        (set @entity.fell false)
        (set @entity.hazardId "")
        (set @entity.goalId "")
        (set @entity.skating false)

      STEER -> active when @config.running
        (set @entity.body (object/merge @entity.body { vx: (* @payload.dir (if (== (object/get @entity.tuning moveSpeed null) null) @config.moveSpeed (object/get @entity.tuning moveSpeed null))), facingRight: (if (!= @payload.dir 0) (> @payload.dir 0) @entity.body.facingRight) }))

      JUMP -> active when (and @config.running (== @entity.body.grounded true))
        (set @entity.body (object/merge @entity.body { vy: (if (> (if (== (object/get @entity.tuning gravity null) null) @config.gravity (object/get @entity.tuning gravity null)) 0) (- 0 (if (== (object/get @entity.tuning jumpStrength null) null) @config.jumpStrength (object/get @entity.tuning jumpStrength null))) (if (== (object/get @entity.tuning jumpStrength null) null) @config.jumpStrength (object/get @entity.tuning jumpStrength null))), grounded: false }))
        (emit BODY_JUMPED { x: @entity.body.x, y: @entity.body.y })

      PLACE -> active
        (set @entity.body (object/merge @entity.body { x: @payload.x, y: @payload.y, vx: 0, vy: 0, grounded: false }))
        (set @entity.fell false)
        (set @entity.hazardId "")
        (set @entity.skating false)

      CURVE_MOD_ADD -> active when @config.curveModsEnabled
        (set @entity.curveMods (array/append @entity.curveMods { x0: @payload.x0, x1: @payload.x1, a: @payload.a, h: @payload.h, k: @payload.k }))

      SET_TUNING -> active
        (set @entity.tuning (object/merge @entity.tuning (if (== @payload.jumpStrength null) {} { jumpStrength: @payload.jumpStrength })))
        (set @entity.tuning (object/merge @entity.tuning (if (== @payload.moveSpeed null) {} { moveSpeed: @payload.moveSpeed })))
        (set @entity.tuning (object/merge @entity.tuning (if (== @payload.gravity null) {} { gravity: @payload.gravity })))

      RESTART -> active
        (set @entity.body @config.spawn)
        (set @entity.curveMods [])
        (set @entity.fell false)
        (set @entity.hazardId "")
        (set @entity.goalId "")
        (set @entity.skating false)
        (set @entity.tuning {})
    }

    ticks {
      physicsTick every 33ms
        when (and @config.running (> @entity.body.width 0))
        (let ((eg (if (== (object/get @entity.tuning gravity null) null) @config.gravity (object/get @entity.tuning gravity null))))
        (let ((gdir (if (> @eg 0) 1 -1)))
        (let ((bcx (+ (object/get @entity.body x) (/ (object/get @entity.body width) 2))) (bcy (+ (object/get @entity.body y) (/ (object/get @entity.body height) 2))))
        (let ((drift (array/find @config.driftRegions (fn r (and (>= @bcx (object/get @r x0)) (and (<= @bcx (object/get @r x1)) (and (>= @bcy (object/get @r y0)) (<= @bcy (object/get @r y1)))))))))
        (let ((dax (if (== @drift null) 0 (object/get @drift ax))) (day (if (== @drift null) 0 (object/get @drift ay))))
        (let ((vy1 (math/clamp (+ @entity.body.vy (* (+ @eg @day) 0.033)) (- 0 @config.maxFallSpeed) @config.maxFallSpeed)))
        (let ((bw (object/get @entity.body width)) (bh (object/get @entity.body height)))
        (let ((nx (math/clamp (+ @entity.body.x (* @entity.body.vx 0.033)) @config.xMin @config.xMax)))
        (let ((ny (+ @entity.body.y (* @vy1 0.033))))
        (let ((rect { x: @nx, y: @ny, w: @bw, h: @bh }))
        (let ((hit (array/find @config.platforms (fn p (and (or (== (object/get @p type) "ground") (== (object/get @p type) "platform")) (geo/aabb-overlap @rect { x: @p.x, y: @p.y, w: @p.width, h: @p.height }))))))
        (let ((landed (and (!= @hit null) (> (* @vy1 @gdir) 0))))
        (let ((ny2 (if @landed (if (> @gdir 0) (- (object/get @hit y) @bh) (+ (object/get @hit y) (object/get @hit height))) @ny)) (vy2 (if @landed 0 @vy1)))
        (let ((cx (+ @nx (/ @bw 2))))
        (let ((inRange (and @config.skate (and (> (array/len @config.skateCurve) 1) (and (>= @cx (object/get (array/first @config.skateCurve) x)) (< @cx (object/get (array/last @config.skateCurve) x)))))))
        (let ((leftSamp (if @inRange (array/last (array/filter @config.skateCurve (fn s (<= (object/get @s x) @cx)))) { x: 0, y: 0 })))
        (let ((rightSamp (if @inRange (array/first (array/filter @config.skateCurve (fn s (> (object/get @s x) @cx)))) { x: 1, y: 0 })))
        (let ((slope (if @inRange (/ (- (object/get @rightSamp y) (object/get @leftSamp y)) (- (object/get @rightSamp x) (object/get @leftSamp x))) 0)))
        (let ((curveY (if @inRange (+ (object/get @leftSamp y) (* @slope (- @cx (object/get @leftSamp x)))) 0)))
        (let ((gapBreak (and (> @config.skateMaxGap 0) (> (- (object/get @rightSamp x) (object/get @leftSamp x)) @config.skateMaxGap))))
        (let ((mods (if (and @config.curveModsEnabled @inRange) (array/filter @entity.curveMods (fn m (and (>= @cx (object/get @m x0)) (<= @cx (object/get @m x1))))) [])))
        (let ((modded (array/reduce @mods { y: @curveY, s: @slope } (fn (acc m)
          (let ((modX (- @cx (object/get @m h))))
          (let ((modInRange (and (>= @modX (object/get (array/first @config.skateCurve) x)) (< @modX (object/get (array/last @config.skateCurve) x)))))
          (let ((modLeft (if @modInRange (array/last (array/filter @config.skateCurve (fn s (<= (object/get @s x) @modX)))) null)))
          (let ((modRight (if @modInRange (array/first (array/filter @config.skateCurve (fn s (> (object/get @s x) @modX)))) null)))
          (let ((modOK (and @modInRange (and (!= @modLeft null) (!= @modRight null)))))
          (let ((modSlope (if @modOK (/ (- (object/get @modRight y) (object/get @modLeft y)) (- (object/get @modRight x) (object/get @modLeft x))) 0)))
          (let ((modCurveY (if @modOK (+ (object/get @modLeft y) (* @modSlope (- @modX (object/get @modLeft x)))) 0)))
          (if @modOK
            { y: (+ (object/get @acc y) (- (+ (* (object/get @m a) @modCurveY) (object/get @m k)) @curveY)), s: (+ (object/get @acc s) (- (* (object/get @m a) @modSlope) @slope)) }
            @acc))))))))))))
        (let ((slope (object/get @modded s)))
        (let ((curveY (object/get @modded y)))
        (let ((aboveCurve (< (* (- @ny2 @curveY) @gdir) 0)))
        (let ((movingUp (< (* @vy1 @gdir) -0.01)))
        (let ((skateNow (and @inRange (and (not @gapBreak) (and (<= (math/abs (- @ny2 @curveY)) @config.skateSnap) (and (or @landed (or @entity.skating (and (not @movingUp) @aboveCurve))) (or @entity.body.grounded (not @movingUp))))))))
        (let ((vx2 (if @skateNow (math/clamp (+ @entity.body.vx (* (/ (* @eg @slope) (+ 1 (* @slope @slope))) 0.033)) (- 0 @config.maxFallSpeed) @config.maxFallSpeed) @entity.body.vx)))
        (let ((vx3 (if (== @drift null) @vx2 (math/clamp (+ @vx2 (* @dax 0.033)) (- 0 @config.maxFallSpeed) @config.maxFallSpeed))))
        (let ((fy (if @skateNow @curveY @ny2)) (fvy (if @skateNow (* (* @vx2 (math/cos (math/atan @slope))) (math/sin (math/atan @slope))) @vy2)) (fgrounded (or @landed @skateNow)))
        (let ((hazardHit (array/find @config.platforms (fn p (and (== (object/get @p type) "hazard") (geo/aabb-overlap @rect { x: @p.x, y: @p.y, w: @p.width, h: @p.height }))))))
        (let ((goalHit (array/find @config.platforms (fn p (and (== (object/get @p type) "goal") (geo/aabb-overlap @rect { x: @p.x, y: @p.y, w: @p.width, h: @p.height }))))))
        (let ((fellNow (if (> @gdir 0) (> @fy @config.killY) (< @fy @config.killY))))
          (do
            (set @entity.body (object/merge @entity.body { x: @nx, y: @fy, vx: (if (or (== @nx @config.xMin) (== @nx @config.xMax)) 0 @vx3), vy: @fvy, grounded: @fgrounded }))
            (set @entity.skating @skateNow)
            (if (and @skateNow (== @entity.skating false))
              (emit BODY_SKATE_START { x: @nx, y: @fy, slope: @slope })
              null)
            (if (and (== @skateNow false) (== @entity.skating true))
              (emit BODY_SKATE_END { x: @nx, y: @fy })
              null)
            (if (and @landed (== @entity.body.grounded false))
              (emit BODY_LANDED { x: @nx, y: @fy, impact: (* @vy1 @gdir) })
              null)
            (if (!= @hazardHit null)
              (if (!= @entity.hazardId (object/get @hazardHit "id" ""))
                (do
                  (set @entity.hazardId (object/get @hazardHit "id" ""))
                  (emit BODY_HAZARD { id: (object/get @hazardHit "id" ""), x: @nx, y: @fy }))
                null)
              (set @entity.hazardId ""))
            (if (!= @goalHit null)
              (if (!= @entity.goalId (object/get @goalHit "id" ""))
                (do
                  (set @entity.goalId (object/get @goalHit "id" ""))
                  (emit BODY_GOAL { id: (object/get @goalHit "id" ""), x: @nx, y: @fy }))
                null)
              (set @entity.goalId ""))
            (if (and @fellNow (== @entity.fell false))
              (do
                (set @entity.fell true)
                (emit BODY_FELL { x: @nx, y: @fy }))
              null)
            (emit BODY_MOVED { x: @nx, y: @fy, vx: @entity.body.vx, vy: @fvy, grounded: @fgrounded, skating: @skateNow, speed: (math/hypot @entity.body.vx @fvy) })))))))))))))))))))))))))))))))))))
    }

    emits {
      BODY_MOVED -> external {
        x : number!
        y : number!
        vx : number!
        vy : number!
        grounded : boolean!
        skating : boolean!
        speed : number!
      }
        @description "The body after this physics tick: position, velocity, grounded and skating flags, and scalar speed; render layers subscribe (or read the shared entity), rule layers stay on the sparse signals"
        @tier "domain"
      BODY_SKATE_START -> external {
        x : number!
        y : number!
        slope : number!
      }
        @description "Body engaged curve skating this tick (grounded, landing, or falling within skateSnap above the skateCurve surface); slope is the local dy/dx — boards layer fx and equation readouts"
        @tier "domain"
      BODY_SKATE_END -> external {
        x : number!
        y : number!
      }
        @description "Body left the curve surface (jumped, walked past an end, or drifted beyond skateSnap); boards tear down skate fx"
        @tier "domain"
      BODY_JUMPED -> external {
        x : number!
        y : number!
      }
        @description "Jump accepted (grounded at intent time) and vertical velocity kicked against gravity; boards layer squash/sound fx"
        @tier "domain"
      BODY_LANDED -> external {
        x : number!
        y : number!
        impact : number!
      }
        @description "Body transitioned airborne → standing on a ground/platform tile this tick; impact is the pre-landing fall speed in units/s so boards can scale dust or damage"
        @tier "domain"
      BODY_HAZARD -> external {
        id : string!
        x : number!
        y : number!
      }
        @description "Body entered overlap with a hazard tile; fires once per entry and re-arms only after the body leaves, so damage rules stay sparse"
        @tier "domain"
      BODY_GOAL -> external {
        id : string!
        x : number!
        y : number!
      }
        @description "Body entered overlap with a goal tile; fires once per entry and re-arms only after the body leaves — the board's win-rule trigger"
        @tier "domain"
      BODY_FELL -> external {
        x : number!
        y : number!
      }
        @description "Body crossed killY in the gravity direction (pit fall); fires once per fall and re-arms on PLACE/RESTART, leaving the respawn rule to the board"
        @tier "domain"
    }

    listens {
      STEER { dir : number! }
      JUMP { id : string }
      PLACE { x : number!, y : number! }
      CURVE_MOD_ADD { x0 : number!, x1 : number!, a : number!, h : number!, k : number! }
      SET_TUNING { jumpStrength : number, moveSpeed : number, gravity : number }
      RESTART { id : string }
    }

    config {
      running : boolean = true
        @label "Running"
        @description "When true the 33ms physics tick integrates and collides; toggle to freeze the body"
        @tier "domain"
      spawn : PlatformerBody = { x: 2, y: 8, width: 0.6, height: 0.6, vx: 0, vy: 0, grounded: false, facingRight: true }
        @label "Spawn Body"
        @description "Initial body rect (min-corner x/y plus width/height) seeded on INIT/RESTART; width/height also define the collision box"
        @tier "domain"
      platforms : [PlatformerPlatform] = []
        @label "Platforms"
        @description "Level geometry as min-corner rects: ground/platform tiles are solid one-way landing surfaces, hazard tiles emit BODY_HAZARD on touch, goal tiles emit BODY_GOAL"
        @tier "domain"
      gravity : number = 24
        @label "Gravity"
        @description "Units/s² added to vertical velocity; the SIGN is the vertical convention — positive pulls toward +y (screen boards, y down), negative toward −y (math canvases, y up) — and jumps always fire against it"
        @tier "domain"
      curveModsEnabled : boolean = false
        @label "Curve Mods Enabled"
        @description "When true, entity.curveMods reshape the skate surface inside each mod's x-range: the road samples the base curve at (x − h) and applies a·y + k (slope scales by a) — coefficient pads lift/tilt the segment the player is riding. Multiple overlapping mods stack by summing each mod's delta from the base surface; a mod whose shifted sample leaves the curve range is skipped. Default off: boards without coef pads pay nothing."
        @tier "domain"
      jumpStrength : number = 11
        @label "Jump Strength"
        @description "Vertical speed in units/s imparted by JUMP, directed against gravity; apex height ≈ jumpStrength² / (2·|gravity|)"
        @tier "domain"
      moveSpeed : number = 5
        @label "Move Speed"
        @description "Horizontal run speed in units/s applied by STEER dir ±1"
        @tier "domain"
      maxFallSpeed : number = 14
        @label "Max Fall Speed"
        @description "Terminal velocity cap in units/s applied to vertical speed each tick"
        @tier "presentation"
      xMin : number = -1000000
        @label "Left Wall"
        @description "Smallest x the body's min corner may hold (world bounds, not level geometry)"
        @tier "presentation"
      xMax : number = 1000000
        @label "Right Wall"
        @description "Largest x the body's min corner may hold (world bounds, not level geometry)"
        @tier "presentation"
      killY : number = 1000000
        @description "Fall line: crossing it in the gravity direction fires BODY_FELL once (past it downward on y-down boards, below it on y-up canvases); y-up consumers must set a value below their world floor"
        @label "Kill Y"
        @tier "domain"
      skate : boolean = false
        @label "Curve Skating"
        @description "When true, a grounded body within skateSnap of the skateCurve surface rides the curve: y snaps to the interpolated surface and tangential gravity (g·slope/(1+slope²)) accelerates vx, so the body slides downhill along the graph and launches off its ends; JUMP kicks free. Engages when grounded, when landing on a tile, or when a falling (not rising) body passes within skateSnap above the surface."
        @tier "domain"
      skateCurve : [PlatformerCurveSample] = []
        @label "Skate Curve"
        @description "Surface samples (x strictly increasing) the body skates when skate is on; y is the surface height for the body's MIN corner, linearly interpolated between bracketing samples — mirror the render-side curve so what you see is what you ride"
        @tier "domain"
      skateMaxGap : number = 0
        @label "Skate Max Gap"
        @description "Largest x-gap between consecutive skateCurve samples that still counts as surface. 0 = unlimited (sparse two-sample lines skate fine). Dense resampled curves with real gaps between segments (stitched worlds) MUST set this — otherwise the sampler invents a skatable chord across every gap (an invisible line above the bridge/terrain that the body snaps to and glides along)."
        @tier "domain"
      skateSnap : number = 0.75
        @label "Skate Snap"
        @description "Max vertical gap (world units) between the body's min corner and the curve surface for skating to engage or stay engaged; larger values grab earlier on landing, smaller values release sooner on bumps"
        @tier "domain"
      driftRegions : [BodyDriftRegion] = []
        @label "Drift Regions"
        @description "Axis-aligned rects (x0..x1, y0..y1 in world units) each carrying a constant acceleration (ax, ay in units/s²) applied with the physics dt whenever the body's center is inside — winds, currents, gradient pushes. Empty list = zero behavior change."
        @tier "domain"
    }
  }

  page "/platformer-body" as PlatformerBodyPage -> PlatformerBody
}
