app std-curve-fog "1.0.0"
"Headless prediction-fog mechanic for graph-riding boards: in configured world regions the road ahead is only partially REVEALED — the atom listens BODY_MOVED and stamps fogX (the reveal horizon = player x + the region's lookAhead) onto the shared entity, and the board's render layer clips or ghosts every road sample past it, so the player must commit to jumps before the landing is visible and internalize where the function GOES (blowup, flattening, slow growth, divergence). Outside every region fogX sits at a large sentinel, i.e. fully revealed. Physics is untouched: the collider keeps the whole curve — the fog is purely visual. Renders nothing; boards clip their own curve/region samples against @entity.fogX (the render authority)."
orbital CurveFogOrbital {
  type CurveFogRegion = {
    x0 : number!
    x1 : number!
    lookAhead : number!
  }

  entity CurveFogData [runtime, shared] {
    id : string!
    fogX : number = 99999
  }

  trait CurveFog -> @rebindable CurveFogData [lifecycle] {
    initial: active

    state active {
      INIT -> active
        (set @entity.fogX 99999)

      BODY_MOVED -> active when @config.running
        (let ((rmatch (array/filter @config.regions (fn r (and (>= @payload.x (object/get @r x0)) (< @payload.x (object/get @r x1)))))))
        (if (> (array/len @rmatch) 0)
          (set @entity.fogX (+ @payload.x (object/get (array/first @rmatch) lookAhead)))
          (set @entity.fogX 99999)))

      RESTART -> active
        (set @entity.fogX 99999)
    }

    listens {
      BODY_MOVED { x : number!, y : number!, vx : number!, vy : number!, grounded : boolean!, skating : boolean!, speed : number! }
      RESTART { id : string }
    }

    config {
      running : boolean = true
        @label "Running"
        @description "When true, BODY_MOVED tracks the reveal horizon; toggle to freeze the fog where it is."
        @tier "domain"
      regions : [CurveFogRegion] = []
        @label "Fog Regions"
        @description "One row per fogged world span: x-range (x0..x1) and lookAhead — how far past the player the road stays revealed while inside. Small values force prediction (blowups), large values suit slow tail lessons. Empty list = no fog anywhere."
        @tier "domain"
    }
  }

  page "/curve-fog" as CurveFogPage -> CurveFog
}
