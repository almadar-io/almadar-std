app ui-canvas "1.0.0"
"Canvas — UI factory (1:1 with the @almadar/ui canvas pattern)."
orbital CanvasOrbital {
  type CanvasCamera = {
    pos : CanvasCameraPos
    target : CanvasCameraTarget
    zoom : number
    fov : number
    mode : "isometric" | "perspective" | "top-down" | "front" | "follow" | "chase"
    azimuth : number
    elevation : number
  }
  type CanvasCameraPos = {
    x : number!
    y : number!
    z : number
  }
  type CanvasCameraTarget = {
    x : number!
    y : number!
    z : number
  }
  type CanvasLighting = {
    ambient : CanvasLightingAmbient
    directional : CanvasLightingDirectional
    hemisphere : CanvasLightingHemisphere
    points : [CanvasLightingPointsItem]
    environment : "room" | "none"
    toneMapping : "aces" | "none"
  }
  type CanvasLightingAmbient = {
    intensity : number
    color : string
    position : [number]
  }
  type CanvasLightingDirectional = {
    intensity : number
    color : string
    position : [number]
  }
  type CanvasLightingHemisphere = {
    intensity : number
    color : string
    groundColor : string
  }
  type CanvasLightingPointsItem = {
    intensity : number
    color : string
    position : [number]!
    distance : number
    decay : number
  }
  type CanvasPost = {
    bloom : CanvasPostBloom
    vignette : CanvasPostVignette
  }
  type CanvasPostBloom = {
    intensity : number
    threshold : number
    smoothing : number
  }
  type CanvasPostVignette = {
    offset : number
    darkness : number
  }

  entity CanvasItem [runtime] {
    id : string!
  }

  trait CanvasRender -> @rebindable CanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          mode: @config.mode
          drawables: @config.drawables
          camera: @config.camera
          projection: @config.projection
          className: @config.className
          isLoading: @config.isLoading
          unitScale: @config.unitScale
          showMinimap: @config.showMinimap
          fit: @config.fit
          tileWidth: @config.tileWidth
          backgroundImage: @config.backgroundImage
          backgroundColor: @config.backgroundColor
          worldWidth: @config.worldWidth
          worldHeight: @config.worldHeight
          pixelsPerUnit: @config.pixelsPerUnit
          showGrid: @config.showGrid
          shadows: @config.shadows
          showCoordinates: @config.showCoordinates
          showTileInfo: @config.showTileInfo
          fogOfWar: @config.fogOfWar
          lighting: @config.lighting
          post: @config.post
          tileClickEvent: @config.tileClickEvent
          unitClickEvent: @config.unitClickEvent
          tileHoverEvent: @config.tileHoverEvent
          tileLeaveEvent: @config.tileLeaveEvent
          featureClickEvent: @config.featureClickEvent
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          editable: @config.editable
          selectedId: @config.selectedId
          onSelect: @config.onSelect
          onMove: @config.onMove
          selectEvent: @config.selectEvent
          moveEvent: @config.moveEvent
          children: @config.children
          type: canvas
        })
    }

    emits {
      @config.tileClickEvent -> external {
        x : number
        y : number
        tileId : string
        z : number
      }
        @description "--- Shared interaction (LOLO-owned). The painter emitted at runtime depends on"
        @tier "essential"
      @config.unitClickEvent -> external {
        unitId : string
        x : number
        z : number
      }
        @description "unitClickEvent prop"
        @tier "essential"
      @config.tileHoverEvent -> external {
        x : number
        y : number
        tileId : string
        z : number
      }
        @description "tileHoverEvent prop"
        @tier "essential"
      @config.tileLeaveEvent -> external { }
        @description "tileLeaveEvent prop"
        @tier "essential"
      @config.featureClickEvent -> external {
        featureId : string!
        x : number!
        z : number!
        elevation : number
      }
        @description "Feature-click event (3D only)."
        @tier "essential"
      @config.onSelect -> external {
        id : string
      }
        @description "Fired on a click that changes selection — before `selectEvent`."
        @tier "essential"
      @config.onMove -> external {
        id : string
        x : number
        y : number
      }
        @description "Fired once per drag gesture, on drop — before `moveEvent`."
        @tier "essential"
    }

    config {
      mode : "2d" | "3d" = "2d"
        @label "Mode"
        @description "Painter: 2D sprite/shape/text raster, or 3D mesh. Default '2d'."
        @tier "presentation"
      drawables : [node] = []
        @label "Drawables"
        @description "Neutral drawable descriptors — the `draw-*` children. Routed to the host's painter."
        @tier "presentation"
      camera : CanvasCamera
        @label "Camera"
        @description "Neutral camera pose. Mapped to the underlying host's framing + zoom."
        @tier "presentation"
      projection : "isometric" | "hex" | "flat" | "free" | "side" = isometric
        @label "Projection"
        @description "2D grid layout (2D mode only): isometric / hex / flat / free / side."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "--- Shared view config ---"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      unitScale : number
        @label "Unit Scale"
        @description "Unit draw-size multiplier (both painters)."
        @tier "presentation"
      showMinimap : boolean
        @label "Show Minimap"
        @description "Minimap overlay (2D)."
        @tier "presentation"
      fit : boolean
        @label "Fit"
        @description "Auto-fit the board's grid extent to the viewport (2D grid layouts; default false — boards render at their authored `camera.zoom` scale)."
        @tier "presentation"
      tileWidth : number
        @label "Tile Width"
        @description "Native tile/cell width in source px of the board's asset (2D grid layouts; defaults to the detected atlas tile width, else 256)."
        @tier "presentation"
      backgroundImage : asset
        @label "Background Image"
        @description "Backdrop image (2D iso/hex/flat/free/side)."
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "Solid backdrop colour — 2D `side` fill and 3D scene clear colour."
        @tier "presentation"
      worldWidth : number
        @label "World Width"
        @description "Side/free world bounds (2D `side`) and 3D world extent."
        @tier "presentation"
      worldHeight : number
        @label "World Height"
        @description "worldHeight prop"
        @tier "presentation"
      pixelsPerUnit : number
        @label "Pixels Per Unit"
        @description "3D world-unit → pixel scale (perspective/side depth). 3D only."
        @tier "presentation"
      showGrid : boolean
        @label "Show Grid"
        @description "3D-only presentation."
        @tier "presentation"
      shadows : boolean
        @label "Shadows"
        @description "shadows prop"
        @tier "presentation"
      showCoordinates : boolean
        @label "Show Coordinates"
        @description "showCoordinates prop"
        @tier "presentation"
      showTileInfo : boolean
        @label "Show Tile Info"
        @description "showTileInfo prop"
        @tier "presentation"
      fogOfWar : [[boolean]] = []
        @label "Fog Of War"
        @description "fogOfWar prop"
        @tier "presentation"
      lighting : CanvasLighting
        @label "Lighting"
        @description "3D scene light rig as data — ambient/directional/hemisphere/point lights + optional 'room' environment for PBR reflections. Omitted → the standard fixed rig."
        @tier "presentation"
      post : CanvasPost
        @label "Post"
        @description "3D post-processing stack — bloom (emissive glow / neon) and vignette. Omitted → no post pass."
        @tier "presentation"
      tileClickEvent : event = "TILE_CLICK"
        @label "Tile Click Event"
        @description "--- Shared interaction (LOLO-owned). The painter emitted at runtime depends on"
        @tier "presentation"
      unitClickEvent : event = "UNIT_CLICK"
        @label "Unit Click Event"
        @description "unitClickEvent prop"
        @tier "presentation"
      tileHoverEvent : event = "TILE_HOVER"
        @label "Tile Hover Event"
        @description "tileHoverEvent prop"
        @tier "presentation"
      tileLeaveEvent : event = "TILE_LEAVE"
        @label "Tile Leave Event"
        @description "tileLeaveEvent prop"
        @tier "presentation"
      featureClickEvent : event = "FEATURE_CLICK"
        @label "Feature Click Event"
        @description "Feature-click event (3D only)."
        @tier "presentation"
      keyMap : Map string string = { item: "Item" }
        @label "Key Map"
        @description "keyMap prop"
        @tier "presentation"
      keyUpMap : Map string string = { item: "Item" }
        @label "Key Up Map"
        @description "keyUpMap prop"
        @tier "presentation"
      editable : boolean
        @label "Editable"
        @description "--- Scene-edit mode (a game studio selecting/dragging drawables). Purely"
        @tier "presentation"
      selectedId : string
        @label "Selected Id"
        @description "The currently-selected drawable id (controlled); `null`/undefined = none."
        @tier "presentation"
      onSelect : event = "SELECT"
        @label "On Select"
        @description "Fired on a click that changes selection — before `selectEvent`."
        @tier "presentation"
      onMove : event = "MOVE"
        @label "On Move"
        @description "Fired once per drag gesture, on drop — before `moveEvent`."
        @tier "presentation"
      selectEvent : event = "SELECT"
        @label "Select Event"
        @description "Declarative selection event, `UI:{selectEvent} { id }`."
        @tier "presentation"
      moveEvent : event = "MOVE"
        @label "Move Event"
        @description "Declarative move event, `UI:{moveEvent} { id, x, y }` — fired once on drop."
        @tier "presentation"
      children : node
        @label "Children"
        @description "Declarative JSX drawable children (`<DrawShape .../>` composed in paint order). Forwarded to the 2D host, which collects them via drawable registry context."
        @tier "presentation"
    }
  }

  page "/canvas" as CanvasPage -> CanvasRender
}
