app ui-sequence-bar "1.0.0"
"SequenceBar — UI factory (1:1 with the @almadar/ui sequence-bar pattern)."
;; @pattern "sequence-bar"
orbital SequenceBarOrbital {
  type SequenceBarSlotsItem = {
    id : string!
    name : string!
    category : string!
    description : string
    iconEmoji : string
    iconUrl : SequenceBarSlotsItemIconUrl
    stateMachine : SequenceBarSlotsItemStateMachine
  }
  type SequenceBarSlotsItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type SequenceBarSlotsItemStateMachine = {
    name : string!
    states : [string]!
    currentState : string!
    transitions : [SequenceBarSlotsItemStateMachineTransitionsItem]!
    description : string
  }
  type SequenceBarSlotsItemStateMachineTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guardHint : string
  }
  type SequenceBarCategoryColorsValue = {
    bg : string!
    border : string!
  }
  type SequenceBarSLOTDROPItem = {
    id : string!
    name : string!
    category : string!
    description : string
    iconEmoji : string
    iconUrl : SequenceBarSLOTDROPItemIconUrl
    stateMachine : SequenceBarSLOTDROPItemStateMachine
  }
  type SequenceBarSLOTDROPItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type SequenceBarSLOTDROPItemStateMachine = {
    name : string!
    states : [string]!
    currentState : string!
    transitions : [SequenceBarSLOTDROPItemStateMachineTransitionsItem]!
    description : string
  }
  type SequenceBarSLOTDROPItemStateMachineTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guardHint : string
  }

  entity SequenceBarItem [runtime] {
    id : string!
  }

  trait SequenceBarRender -> @rebindable SequenceBarItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          slots: @config.slots
          maxSlots: @config.maxSlots
          onSlotDrop: @config.onSlotDrop
          onSlotRemove: @config.onSlotRemove
          slotDropEvent: @config.slotDropEvent
          slotRemoveEvent: @config.slotRemoveEvent
          playing: @config.playing
          currentStep: @config.currentStep
          categoryColors: @config.categoryColors
          slotFeedback: @config.slotFeedback
          size: @config.size
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: sequence-bar
        })
    }

    emits {
      @config.onSlotDrop -> external {
        index : number
        item : SequenceBarSLOTDROPItem
        slotNumber : number!
        itemId : string!
      }
        @description "Called when an item is dropped into slot at index (callback path)"
        @tier "essential"
      @config.onSlotRemove -> external {
        index : number
        slotNumber : number!
      }
        @description "Called when a slot is cleared (callback path)"
        @tier "essential"
    }

    config {
      slots : [SequenceBarSlotsItem] = [{ id: "Id", name: "Name", category: "Category", description: "Description", iconEmoji: "Icon Emoji", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png", role: "ui", category: "iconUrl", animations: ["static"], style: "pixel", dimension: "2d", aspect: "1:1", name: "iconUrl", thumbnailUrl: "" }, stateMachine: { name: "Name", states: ["Item", "Item 2"], currentState: "Current State", transitions: [{ from: "From", to: "To", event: "Event", guardHint: "Guard Hint" }, { from: "From 2", to: "To 2", event: "Event 2", guardHint: "Guard Hint 2" }], description: "Description" } }, { id: "Id 2", name: "Name 2", category: "Category 2", description: "Description 2", iconEmoji: "Icon Emoji 2", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-battle-board/default/ui/star.png", role: "ui", category: "iconUrl", animations: ["static"], style: "pixel", dimension: "2d", aspect: "1:1", name: "iconUrl", thumbnailUrl: "" }, stateMachine: { name: "Name 2", states: ["Item", "Item 2"], currentState: "Current State 2", transitions: [{ from: "From", to: "To", event: "Event", guardHint: "Guard Hint" }, { from: "From 2", to: "To 2", event: "Event 2", guardHint: "Guard Hint 2" }], description: "Description 2" } }]
        @label "Slots"
        @description "The current sequence (sparse — undefined means empty slot)"
        @tier "presentation"
      maxSlots : number = 1
        @label "Max Slots"
        @description "Max number of slots"
        @tier "presentation"
      onSlotDrop : event = "SLOT_DROP"
        @label "On Slot Drop"
        @description "Called when an item is dropped into slot at index (callback path)"
        @tier "presentation"
      onSlotRemove : event = "SLOT_REMOVE"
        @label "On Slot Remove"
        @description "Called when a slot is cleared (callback path)"
        @tier "presentation"
      slotDropEvent : event = "SLOT_DROP"
        @label "Slot Drop Event"
        @description "Emits UI:{slotDropEvent} with { slotNumber, itemId } when an item is dropped (declarative path)"
        @tier "presentation"
      slotRemoveEvent : event = "SLOT_REMOVE"
        @label "Slot Remove Event"
        @description "Emits UI:{slotRemoveEvent} with { slotNumber } when a slot is cleared (declarative path)"
        @tier "presentation"
      playing : boolean = false
        @label "Playing"
        @description "Whether the sequence is currently playing (disable interaction)"
        @tier "presentation"
      currentStep : number = -1
        @label "Current Step"
        @description "Current step index during playback (-1 = not playing)"
        @tier "presentation"
      categoryColors : Map string SequenceBarCategoryColorsValue = {}
        @label "Category Colors"
        @description "Category → color mapping"
        @tier "presentation"
      slotFeedback : ["correct" | "wrong"] = []
        @label "Slot Feedback"
        @description "Per-slot correctness feedback shown after a failed attempt"
        @tier "presentation"
      size : "sm" | "md" | "lg" = lg
        @label "Size"
        @description "Size variant"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/sequence-bar" as SequenceBarPage -> SequenceBarRender
}
