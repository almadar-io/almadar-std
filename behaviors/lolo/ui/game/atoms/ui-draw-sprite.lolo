app ui-draw-sprite "1.0.0"
"DrawSprite — UI factory (1:1 with the @almadar/ui draw-sprite pattern)."
orbital DrawSpriteOrbital {
  type DrawSpritePosition = {
    x : number!
    y : number!
    z : number
  }
  type DrawSpriteAsset = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type DrawSpriteFrame = {
    x : number!
    y : number!
    w : number!
    h : number!
  }
  type DrawSpriteShadow = {
    color : string!
    blur : number!
  }

  entity DrawSpriteItem [runtime] {
    id : string!
  }

  trait DrawSpriteRender -> @rebindable DrawSpriteItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          position: @config.position
          asset: @config.asset
          anchor: @config.anchor
          width: @config.width
          height: @config.height
          frame: @config.frame
          animation: @config.animation
          loop: @config.loop
          clockMs: @config.clockMs
          flipX: @config.flipX
          rotation: @config.rotation
          opacity: @config.opacity
          shadow: @config.shadow
          type: draw-sprite
        })
    }

    config {
      position : DrawSpritePosition = { x: 1, y: 1, z: 1 }
        @label "Position"
        @description "Logical scene position; the projector maps it to pixels / world."
        @tier "presentation"
      asset : DrawSpriteAsset
        @label "Asset"
        @description "The image / atlas reference to blit."
        @tier "presentation"
      anchor : "top-left" | "ground" | "center" = "top-left"
        @label "Anchor"
        @description "How the sprite aligns to its projected position. Default `'top-left'`."
        @tier "presentation"
      width : number
        @label "Width"
        @description "Draw width in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`."
        @tier "presentation"
      height : number
        @label "Height"
        @description "Draw height in world units (fractions of `projector.tileWidth`). Omitted → one cell on tile grids (`flat`/`iso`/`hex`); native source px on `free`/`side`."
        @tier "presentation"
      frame : DrawSpriteFrame
        @label "Frame"
        @description "Explicit atlas sub-rect override (px); omitted → resolved from `asset.atlas`/`asset.sprite`."
        @tier "presentation"
      animation : string
        @label "Animation"
        @description "Animation to play. 3D backend: a named GLB clip (matched case-insensitively). 2D painter: when `asset.atlas` resolves to a `SpriteSheetAtlas` manifest, the canonical row of that name (idle/walk/attack/hit/death) plays off the host paint clock; an explicit `frame` rect overrides."
        @tier "presentation"
      loop : boolean
        @label "Loop"
        @description "Override the sheet row's loop flag. The paint clock is wall-time, so one-shot rows hold their final frame — preview pages set `true` to cycle attack/hit/death continuously."
        @tier "presentation"
      clockMs : number
        @label "Clock Ms"
        @description "Animation clock override in ms (e.g. an fx entry's age since spawn). Omitted → the host paint clock; one-shot rows anchored to wall-time would otherwise sit on their final frame."
        @tier "presentation"
      flipX : boolean
        @label "Flip X"
        @description "Mirror horizontally (facing)."
        @tier "presentation"
      rotation : number
        @label "Rotation"
        @description "Rotation in radians about the sprite's center."
        @tier "presentation"
      opacity : number
        @label "Opacity"
        @description "0..1 opacity."
        @tier "presentation"
      shadow : DrawSpriteShadow
        @label "Shadow"
        @description "Drop shadow (e.g. a team-colored glow)."
        @tier "presentation"
    }
  }

  page "/draw-sprite" as DrawSpritePage -> DrawSpriteRender
}
