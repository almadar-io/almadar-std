app std-fx-particles "1.1.0"
"Headless transient-fx mechanic serving BOTH game boards and learning shells: appends spawned particles on BURST — stamping maxTtl (fade envelope) and bornAt (epoch ms, smooth render interpolation) when absent — decays each entry's ttl every tick, drops the dead ones, and clears on RESTART. Name-blind mechanism: the effect-kind vocabulary is consumer-declared (FxPreset tables at the render call sites). Composed onto a [runtime, shared] entity; renders nothing — the board/shell owns the single render authority (draw-fx-layer for space \"world\", fx-overlay for space \"screen\"). Corresponds to the design-sheet field(s): feedback, rewards."
orbital FxParticlesOrbital {
  type Fx = {
    id : string!
    type : string!
    x : number!
    z : number
    y : number
    message : string
    ttl : number!
    maxTtl : number
    bornAt : number
    space : string
    effect : string
    color : string
    size : number
    vx : number
    vy : number
    vz : number
    particleCount : number
    animation : string
  }

  entity FxState [runtime, shared] {
    id : string!
    fx : [Fx] = []
  }

  trait FxParticles -> @rebindable FxState [lifecycle] {
    initial: active

    state active {
      INIT -> active
        (set @entity.fx (array/map @config.fx (fn p (object/merge @p {
          maxTtl: (if (object/get @p maxTtl) (object/get @p maxTtl) (object/get @p ttl))
          bornAt: (if (object/get @p bornAt) (object/get @p bornAt) (time/now))
        }))))
      BURST -> active
        (set @entity.fx (array/concat @entity.fx (array/map @payload.particles (fn p (object/merge @p {
          maxTtl: (if (object/get @p maxTtl) (object/get @p maxTtl) (object/get @p ttl))
          bornAt: (if (object/get @p bornAt) (object/get @p bornAt) (time/now))
        })))))
      RESTART -> active
        (set @entity.fx [])
    }

    ticks {
      fxTick every 500ms
        when (and @config.running (> (array/len @entity.fx) 0))
        (set @entity.fx (array/filter
          (array/map @entity.fx (fn e (object/merge @e { ttl: (- (object/get @e ttl) @config.decayRate) })))
          (fn e (> (object/get @e ttl) 0))))
    }

    listens {
      BURST { particles : [Fx] }
      RESTART { }
    }

    config {
      decayRate : number = 1
        @label "Decay Rate"
        @description "Ttl units removed from every fx entry each tick; higher fades particles faster."
        @tier "domain"
      running : boolean = true
        @label "Running"
        @description "When true the decay tick runs; toggle to freeze effects."
        @tier "domain"
      fx : [Fx] = []
        @label "Initial Fx"
        @description "Seed particles rendered before the first BURST; usually empty."
        @tier "domain"
    }
  }

  page "/fx-particles" as FxParticlesPage -> FxParticles
}
