app std-audio-cue [
  version: "1.0.0",
  description: "Headless-ish sound driver: the SOLE writer of cue/cueSeq/music/muted/volume, rendered through the game-audio-cue atom which mounts @almadar/ui's useGameAudio hook. Intents: CUE plays a one-shot SFX by manifest key (cueSeq increments so the same key can re-fire), MUSIC crossfades to a looping track by key, STOP_MUSIC fades it out, MUTE/UNMUTE/TOGGLE_MUTE flip playback and emit AUDIO_MUTED, SET_VOLUME sets master volume, RESTART reseeds from config. The manifest and baseUrl are config, not runtime state — swap them per game by rebinding this atom's config, never by hand-authoring a second audio layer."
]
orbital AudioCueOrbital {
  type SoundEntry = {
    path : string!
    volume : number
    loop : boolean
    poolSize : number
    autostart : boolean
    crossfade : boolean
    crossfadeDurationMs : number
  }

  entity AudioState [runtime, shared] {
    id : string!
    cue : string = ""
    cueSeq : number = 0
    music : string = ""
    muted : boolean = false
    volume : number = 1
  }

  trait AudioCue -> @rebindable AudioState [client] {
    initial: active

    state active {
      INIT -> active
        (set @entity.cue "")
        (set @entity.cueSeq 0)
        (set @entity.music @config.initialMusic)
        (set @entity.muted @config.initialMuted)
        (set @entity.volume (math/clamp @config.initialVolume 0 1))
        (render-ui main {
          cueSeq: @entity.cueSeq
          cuePlay: (if (object/has @config.manifest @entity.cue) (let ((e (object/get @config.manifest @entity.cue))) { key: @entity.cue, source: (str/concat @config.baseUrl @e.path), volume: (default @e.volume 1), loop: (default @e.loop false), poolSize: (math/max (default @e.poolSize 1) 1), fadeMs: 0 }) { key: "", source: "", volume: 0, loop: false, poolSize: 1, fadeMs: 0 })
          musicPlay: (if (object/has @config.manifest @entity.music) (let ((e (object/get @config.manifest @entity.music))) { key: @entity.music, source: (str/concat @config.baseUrl @e.path), volume: (default @e.volume 1), loop: true, poolSize: 1, fadeMs: (if (= @e.crossfade false) 0 (default @e.crossfadeDurationMs 1500)) }) { key: "", source: "", volume: 0, loop: true, poolSize: 1, fadeMs: @config.stopFadeMs })
          autostart: (array/map (array/filter (object/keys @config.manifest) (fn k (default (object/get (object/get @config.manifest @k) "autostart") false))) (fn k (let ((e (object/get @config.manifest @k))) { key: @k, source: (str/concat @config.baseUrl @e.path), volume: (default @e.volume 1), loop: (default @e.loop false), poolSize: (math/max (default @e.poolSize 1) 1), fadeMs: 0 })))
          muted: @entity.muted
          volume: @entity.volume
          manifest: @config.manifest
          baseUrl: @config.baseUrl
          type: game-audio-cue
        })

      CUE -> active when (and (not @entity.muted) (object/has @config.manifest ?key))
        (set @entity.cue ?key)
        (set @entity.cueSeq (+ @entity.cueSeq 1))

      MUSIC -> active when (object/has @config.manifest ?key)
        (set @entity.music ?key)

      STOP_MUSIC -> active
        (set @entity.music "")

      MUTE -> active
        (set @entity.muted true)
        (emit AUDIO_MUTED { muted: true })

      UNMUTE -> active
        (set @entity.muted false)
        (emit AUDIO_MUTED { muted: false })

      TOGGLE_MUTE -> active
        (set @entity.muted (not @entity.muted))
        (emit AUDIO_MUTED { muted: @entity.muted })

      SET_VOLUME -> active
        (set @entity.volume (math/clamp ?volume 0 1))

      RESTART -> active
        (set @entity.cue "")
        (set @entity.cueSeq 0)
        (set @entity.music @config.initialMusic)
        (set @entity.muted @config.initialMuted)
        (set @entity.volume (math/clamp @config.initialVolume 0 1))
    }

    emits {
      AUDIO_MUTED -> external {
        muted : boolean!
      }
        @description "Mute state changed via MUTE/UNMUTE/TOGGLE_MUTE."
        @synonyms "mute-changed, sound-toggled"
        @tier "domain"
    }

    listens {
      CUE { key : string! }
        @description "Play a one-shot SFX by manifest key; re-fires even when key repeats."
        @tier "domain"
      MUSIC { key : string! }
        @description "Crossfade to a looping background track by manifest key."
        @tier "domain"
      STOP_MUSIC
        @description "Fade out and stop the current music."
        @tier "domain"
      MUTE
        @description "Mute all playback."
        @tier "domain"
      UNMUTE
        @description "Unmute playback."
        @tier "domain"
      TOGGLE_MUTE
        @description "Flip the current mute state."
        @tier "domain"
      SET_VOLUME { volume : number! }
        @description "Set master volume 0-1."
        @tier "domain"
      RESTART
        @description "Reseed cue/music/muted/volume from config."
        @tier "domain"
    }

    config {
      manifest : Map string SoundEntry = {}
        @label "Manifest"
        @description "Sound definitions keyed by logical name — path(s), volume, loop, pooling, autostart, crossfade."
        @tier "domain"
      baseUrl : string = ""
        @label "Base Url"
        @description "Prefix prepended to every manifest path."
        @tier "infra"
      initialMuted : boolean = false
        @label "Initial Muted"
        @description "Muted state seeded on INIT/RESTART."
        @tier "presentation"
      initialVolume : number = 1
        @label "Initial Volume"
        @description "Master volume 0-1 seeded on INIT/RESTART."
        @tier "presentation"
      stopFadeMs : number = 1000
        @label "Stop Fade Ms"
        @description "Fade-out length in milliseconds when music stops."
        @tier "presentation"
      initialMusic : string = ""
        @label "Initial Music"
        @description "Manifest key auto-played as looping music on INIT/RESTART; empty plays none."
        @tier "presentation"
    }
  }

  page "/audio-cue" as AudioCuePage -> AudioCue
}
