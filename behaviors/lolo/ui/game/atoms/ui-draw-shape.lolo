app ui-draw-shape "1.0.0"
"DrawShape — UI factory (1:1 with the @almadar/ui draw-shape pattern)."
orbital DrawShapeOrbital {
  type DrawShapePosition = {
    x : number!
    y : number!
    z : number
  }
  type DrawShapePointsItem = {
    x : number!
    y : number!
  }
  type DrawShapeGradient = {
    kind : "linear" | "radial" | "conic"!
    from : DrawShapeGradientFrom
    to : DrawShapeGradientTo
    center : DrawShapeGradientCenter
    radius : number
    angle : number
    stops : [DrawShapeGradientStopsItem]!
  }
  type DrawShapeGradientFrom = {
    x : number!
    y : number!
  }
  type DrawShapeGradientTo = {
    x : number!
    y : number!
  }
  type DrawShapeGradientCenter = {
    x : number!
    y : number!
  }
  type DrawShapeGradientStopsItem = {
    offset : number!
    color : string!
  }
  type DrawShapeFillPattern = {
    kind : "noise" | "image"!
    url : string
    scale : number
    alpha : number
    color : string
  }
  type DrawShapeStrokeGradient = {
    kind : "linear" | "radial" | "conic"!
    from : DrawShapeStrokeGradientFrom
    to : DrawShapeStrokeGradientTo
    center : DrawShapeStrokeGradientCenter
    radius : number
    angle : number
    stops : [DrawShapeStrokeGradientStopsItem]!
  }
  type DrawShapeStrokeGradientFrom = {
    x : number!
    y : number!
  }
  type DrawShapeStrokeGradientTo = {
    x : number!
    y : number!
  }
  type DrawShapeStrokeGradientCenter = {
    x : number!
    y : number!
  }
  type DrawShapeStrokeGradientStopsItem = {
    offset : number!
    color : string!
  }
  type DrawShapePivot = {
    x : number!
    y : number!
  }
  type DrawShapeShadow = {
    color : string!
    blur : number!
  }
  type DrawShapeAnimation = {
    durationMs : number!
    loop : boolean
    keyframes : [DrawShapeAnimationKeyframesItem]!
  }
  type DrawShapeAnimationKeyframesItem = {
    at : number!
    offsetX : number
    offsetY : number
    rotate : number
    opacity : number
    radiusX : number
    radiusY : number
    width : number
    height : number
    strokeWidth : number
    strokeDashOffset : number
    blur : number
    fill : string
    stroke : string
    shadow : DrawShapeAnimationKeyframesItemShadow
  }
  type DrawShapeAnimationKeyframesItemShadow = {
    color : string!
    blur : number!
  }

  entity DrawShapeItem [runtime] {
    id : string!
  }

  trait DrawShapeRender -> @rebindable DrawShapeItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          shape: @config.shape
          position: @config.position
          anchor: @config.anchor
          width: @config.width
          height: @config.height
          radiusX: @config.radiusX
          radiusY: @config.radiusY
          offsetX: @config.offsetX
          offsetY: @config.offsetY
          points: @config.points
          d: @config.d
          fill: @config.fill
          gradient: @config.gradient
          fillPattern: @config.fillPattern
          stroke: @config.stroke
          strokeWidth: @config.strokeWidth
          strokeGradient: @config.strokeGradient
          strokeDash: @config.strokeDash
          strokeDashOffset: @config.strokeDashOffset
          blendMode: @config.blendMode
          blur: @config.blur
          rotate: @config.rotate
          pivot: @config.pivot
          shadow: @config.shadow
          animation: @config.animation
          opacity: @config.opacity
          type: draw-shape
        })
    }

    config {
      shape : "cell" | "rect" | "ellipse" | "poly" | "path" = cell
        @label "Shape"
        @description "shape prop"
        @tier "presentation"
      position : DrawShapePosition = { x: 1, y: 1, z: 1 }
        @label "Position"
        @description "Logical scene position; the projector maps it to pixels / world."
        @tier "presentation"
      anchor : "top-left" | "ground" | "center" = "top-left"
        @label "Anchor"
        @description "How the shape aligns to its projected position. Default varies by `shape`."
        @tier "presentation"
      width : number
        @label "Width"
        @description "Rect width in world units (fractions of `projector.tileWidth`)."
        @tier "presentation"
      height : number
        @label "Height"
        @description "Rect height in world units (fractions of `projector.tileWidth`)."
        @tier "presentation"
      radiusX : number
        @label "Radius X"
        @description "Ellipse horizontal radius in world units (fractions of `projector.tileWidth`)."
        @tier "presentation"
      radiusY : number
        @label "Radius Y"
        @description "Ellipse vertical radius in world units; omitted → `radiusX` (a circle)."
        @tier "presentation"
      offsetX : number
        @label "Offset X"
        @description "Fine nudge in world units — applies to every shape kind except `cell` (rect/ellipse from their anchor point; poly/path from the projected top-left)."
        @tier "presentation"
      offsetY : number
        @label "Offset Y"
        @description "offsetY prop"
        @tier "presentation"
      points : [DrawShapePointsItem] = []
        @label "Points"
        @description "Poly vertices as world-unit offsets relative to the cell's projected top-left."
        @tier "presentation"
      d : string
        @label "D"
        @description "SVG path data in world units relative to the cell's projected top-left — same coordinate convention as `points`."
        @tier "presentation"
      fill : string
        @label "Fill"
        @description "fill prop"
        @tier "presentation"
      gradient : DrawShapeGradient
        @label "Gradient"
        @description "Gradient fill in world units; overrides `fill` when present."
        @tier "presentation"
      fillPattern : DrawShapeFillPattern
        @label "Fill Pattern"
        @description "Repeating texture painted over the fill (grain / tiling image)."
        @tier "presentation"
      stroke : string
        @label "Stroke"
        @description "stroke prop"
        @tier "presentation"
      strokeWidth : number
        @label "Stroke Width"
        @description "strokeWidth prop"
        @tier "presentation"
      strokeGradient : DrawShapeStrokeGradient
        @label "Stroke Gradient"
        @description "Gradient stroke in world units; overrides `stroke` when present."
        @tier "presentation"
      strokeDash : [number] = []
        @label "Stroke Dash"
        @description "Dash pattern in painter-px (constant under group scale, like `strokeWidth`)."
        @tier "presentation"
      strokeDashOffset : number
        @label "Stroke Dash Offset"
        @description "Dash phase offset in painter-px; animatable (marching ants)."
        @tier "presentation"
      blendMode : "source-over" | "lighter" | "multiply" | "screen" | "overlay" | "darken" | "lighten" | "color-dodge" | "color-burn" | "hard-light" | "soft-light" | "difference" | "exclusion" | "hue" | "saturation" | "color" | "luminosity" | "source-atop" | "destination-over" | "destination-out" | "xor" = "source-over"
        @label "Blend Mode"
        @description "Composite/blend mode for this shape's draws (`lighter`, `multiply`, `screen`, …)."
        @tier "presentation"
      blur : number
        @label "Blur"
        @description "Gaussian blur in painter-px. Expensive — forces an intermediate raster; use sparingly."
        @tier "presentation"
      rotate : number
        @label "Rotate"
        @description "Rotation in radians (painter units, same as `draw-group`), about `pivot`."
        @tier "presentation"
      pivot : DrawShapePivot
        @label "Pivot"
        @description "Rotation pivot in world units relative to the cell's projected top-left; default `{x:0.5, y:0.5}` (cell center)."
        @tier "presentation"
      shadow : DrawShapeShadow
        @label "Shadow"
        @description "Soft glow / drop-shadow behind the shape; `blur` in world units."
        @tier "presentation"
      animation : DrawShapeAnimation
        @label "Animation"
        @description "Keyframe animation over this shape's props; the host runs a paint clock while present."
        @tier "presentation"
      opacity : number
        @label "Opacity"
        @description "0..1 opacity."
        @tier "presentation"
    }
  }

  page "/draw-shape" as DrawShapePage -> DrawShapeRender
}
