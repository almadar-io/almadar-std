app ui-timer-display [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "TimerDisplay — counts down every second while running; re-renders on each tick."
]
orbital TimerDisplayOrbital {
  type TimerDisplayIconAsset = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type TimerDisplaySkeletonShape = {
    variant : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text"!
    rows : number
    columns : number
    fields : number
  }
  type TimerDisplaySkeleton = "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none" | TimerDisplaySkeletonShape

  entity TimerDisplayItem [runtime] {
    id      : string!
    seconds : number = 90
    running : boolean = true
  }

  trait TimerDisplayRender -> @rebindable TimerDisplayItem [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.seconds @config.seconds)
        (set @entity.running @config.running)
        (render-ui main {
          seconds: @entity.seconds
          displayText: (let ((s (if (> @entity.seconds 0) (math/floor @entity.seconds) 0)))
            (if (== @config.format "ss")
              (i18n/t "seconds" { count: @s })
              (let ((m (math/floor (/ @s 60))) (r (math/mod @s 60)))
                (if (== @config.format "countdown")
                  (if (> @m 0)
                    (str/concat @m ":" (str/padStart (str/concat "" @r) 2 "0"))
                    (str/concat "" @r))
                  (str/concat (str/padStart (str/concat "" @m) 2 "0") ":" (str/padStart (str/concat "" @r) 2 "0"))))))
          running: @entity.running
          format: @config.format
          size: @config.size
          className: @config.className
          lowThreshold: @config.lowThreshold
          iconAsset: @config.iconAsset
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: timer-display
        })
    }

    ticks {
      timerTick every 1s
        when (and (== @entity.running true) (> @entity.seconds 0))
        (set @entity.seconds (- @entity.seconds 1))
        (render-ui main {
          seconds: @entity.seconds
          displayText: (let ((s (if (> @entity.seconds 0) (math/floor @entity.seconds) 0)))
            (if (== @config.format "ss")
              (i18n/t "seconds" { count: @s })
              (let ((m (math/floor (/ @s 60))) (r (math/mod @s 60)))
                (if (== @config.format "countdown")
                  (if (> @m 0)
                    (str/concat @m ":" (str/padStart (str/concat "" @r) 2 "0"))
                    (str/concat "" @r))
                  (str/concat (str/padStart (str/concat "" @m) 2 "0") ":" (str/padStart (str/concat "" @r) 2 "0"))))))
          running: @entity.running
          format: @config.format
          size: @config.size
          className: @config.className
          lowThreshold: @config.lowThreshold
          iconAsset: @config.iconAsset
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: timer-display
        })
    }

    config {
      seconds : number = 90
        @label "Seconds"
        @description "Time in seconds"
        @tier "presentation"
      running : boolean = true
        @label "Running"
        @description "Whether the timer is running"
        @tier "presentation"
      format : "mm:ss" | "ss" | "countdown" = "mm:ss"
        @label "Format"
        @description "Display format"
        @tier "presentation"
      size : "sm" | "md" | "lg" = md
        @label "Size"
        @description "Size variant"
        @tier "presentation"
      className : string = ""
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      lowThreshold : number = 0
        @label "Low Threshold"
        @description "Seconds below which to pulse red"
        @tier "presentation"
      iconAsset : TimerDisplayIconAsset
        @label "Icon Asset"
        @description "Icon asset rendered to the left of the time value. Falls back to no icon."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : TimerDisplaySkeleton
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/timer-display" as TimerDisplayPage -> TimerDisplayRender
}
