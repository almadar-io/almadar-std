app std-svg-asset-art "1.0.0"
"SvgAssetArtCollector — SOLE writer of @entity.svgAssetArt: collects vector asset catalogs published on the bus (SVG_ASSET_PUBLISH { kind, states }) into one kind → (state → draw-group items) map that board frames select per-row per anim state. INIT seeds from config and emits SVG_ASSET_SYNC so already-mounted catalogs republish regardless of mount order; the SYNC self-hop re-applies the seed after sibling canvas stashes exist (Almadar_Runtime_Gaps.md R-INIT-SEED-REPAINT-RACE). Renders nothing — render authority stays with the frame."
orbital StdSvgAssetArtOrbital {
  entity StdSvgAssetArt [runtime, shared] {
    id : string!
    svgAssetArt : json = {}
  }

  trait SvgAssetArtCollector -> @rebindable StdSvgAssetArt [lifecycle] {
    initial: collecting

    state collecting {
      INIT -> collecting
        (set @entity.svgAssetArt @config.seedArt)
        (emit SVG_ASSET_SYNC { })

      SVG_ASSET_SYNC -> collecting
        (set @entity.svgAssetArt (object/merge @config.seedArt @entity.svgAssetArt))

      SVG_ASSET_PUBLISH -> collecting
        (set @entity.svgAssetArt (object/merge @entity.svgAssetArt (object/fromEntries [[?kind, ?states]])))
    }

    emits {
      SVG_ASSET_SYNC -> external { }
        @description "Asks mounted svg asset catalogs to (re)publish their states; also the collector's own seed re-apply hop"
        @tier "domain"
    }

    listens {
      SVG_ASSET_SYNC { }
      SVG_ASSET_PUBLISH { kind : string, states : json }
    }

    config {
      seedArt : json = {}
        @label "Seed Art"
        @description "Initial kind → (state → draw-group items) catalog merged under bus-published entries (published entries win). Lets a board ship vector art with zero asset imports."
        @tier "presentation"
    }
  }

  page "/std-svg-asset-art" as StdSvgAssetArtPage -> SvgAssetArtCollector
}
