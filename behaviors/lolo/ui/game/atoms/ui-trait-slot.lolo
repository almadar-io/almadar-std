app ui-trait-slot "1.0.0"
"TraitSlot — UI factory (1:1 with the @almadar/ui trait-slot pattern)."
;; @pattern "trait-slot"
orbital TraitSlotOrbital {
  type TraitSlotEquippedItem = {
    id : string!
    name : string!
    category : string!
    description : string
    iconEmoji : string
    iconUrl : TraitSlotEquippedItemIconUrl
    stateMachine : TraitSlotEquippedItemStateMachine
  }
  type TraitSlotEquippedItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type TraitSlotEquippedItemStateMachine = {
    name : string!
    states : [string]!
    currentState : string!
    transitions : [TraitSlotEquippedItemStateMachineTransitionsItem]!
    description : string
  }
  type TraitSlotEquippedItemStateMachineTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guardHint : string
  }
  type TraitSlotCategoryColorsValue = {
    bg : string!
    border : string!
  }
  type TraitSlotTooltipFrameUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type TraitSlotError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type TraitSlotITEMDROPItem = {
    id : string!
    name : string!
    category : string!
    description : string
    iconEmoji : string
    iconUrl : TraitSlotITEMDROPItemIconUrl
    stateMachine : TraitSlotITEMDROPItemStateMachine
  }
  type TraitSlotITEMDROPItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type TraitSlotITEMDROPItemStateMachine = {
    name : string!
    states : [string]!
    currentState : string!
    transitions : [TraitSlotITEMDROPItemStateMachineTransitionsItem]!
    description : string
  }
  type TraitSlotITEMDROPItemStateMachineTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guardHint : string
  }
  type TraitSlotDRAGSTARTItem = {
    id : string!
    name : string!
    category : string!
    description : string
    iconEmoji : string
    iconUrl : TraitSlotDRAGSTARTItemIconUrl
    stateMachine : TraitSlotDRAGSTARTItemStateMachine
  }
  type TraitSlotDRAGSTARTItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type TraitSlotDRAGSTARTItemStateMachine = {
    name : string!
    states : [string]!
    currentState : string!
    transitions : [TraitSlotDRAGSTARTItemStateMachineTransitionsItem]!
    description : string
  }
  type TraitSlotDRAGSTARTItemStateMachineTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guardHint : string
  }

  entity TraitSlotItem [runtime] {
    id : string!
    slotNumber : number @intrinsic = 1
  }

  trait TraitSlotRender -> @rebindable TraitSlotItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.slotNumber @config.slotNumber)
        (render-ui main {
          slotNumber: @entity.slotNumber
          equippedItem: @config.equippedItem
          locked: @config.locked
          lockLabel: @config.lockLabel
          selected: @config.selected
          size: @config.size
          showTooltip: @config.showTooltip
          categoryColors: @config.categoryColors
          tooltipFrameUrl: @config.tooltipFrameUrl
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          onItemDrop: @config.onItemDrop
          draggable: @config.draggable
          onDragStart: @config.onDragStart
          feedback: @config.feedback
          onClick: @config.onClick
          onRemove: @config.onRemove
          clickEvent: @config.clickEvent
          removeEvent: @config.removeEvent
          dropEvent: @config.dropEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: trait-slot
        })
      CLICK -> idle
        (set @entity.slotNumber ?slotNumber)
        (render-ui main {
          slotNumber: @entity.slotNumber
          equippedItem: @config.equippedItem
          locked: @config.locked
          lockLabel: @config.lockLabel
          selected: @config.selected
          size: @config.size
          showTooltip: @config.showTooltip
          categoryColors: @config.categoryColors
          tooltipFrameUrl: @config.tooltipFrameUrl
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          onItemDrop: @config.onItemDrop
          draggable: @config.draggable
          onDragStart: @config.onDragStart
          feedback: @config.feedback
          onClick: @config.onClick
          onRemove: @config.onRemove
          clickEvent: @config.clickEvent
          removeEvent: @config.removeEvent
          dropEvent: @config.dropEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: trait-slot
        })
      DROP -> idle
        (set @entity.slotNumber ?slotNumber)
        (render-ui main {
          slotNumber: @entity.slotNumber
          equippedItem: @config.equippedItem
          locked: @config.locked
          lockLabel: @config.lockLabel
          selected: @config.selected
          size: @config.size
          showTooltip: @config.showTooltip
          categoryColors: @config.categoryColors
          tooltipFrameUrl: @config.tooltipFrameUrl
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          onItemDrop: @config.onItemDrop
          draggable: @config.draggable
          onDragStart: @config.onDragStart
          feedback: @config.feedback
          onClick: @config.onClick
          onRemove: @config.onRemove
          clickEvent: @config.clickEvent
          removeEvent: @config.removeEvent
          dropEvent: @config.dropEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: trait-slot
        })
    }

    emits {
      @config.onItemDrop -> external {
        item : TraitSlotITEMDROPItem
      }
        @description "-- Drag and drop --"
        @tier "essential"
      @config.onDragStart -> external {
        item : TraitSlotDRAGSTARTItem
      }
        @description "Called when drag starts from this slot"
        @tier "essential"
      @config.onClick -> external {
        slotNumber : number!
      }
        @description "-- Callbacks --"
        @tier "essential"
      @config.dropEvent -> external {
        slotNumber : number!
        itemId : string!
      }
        @description "Emits UI:{dropEvent} with { slotNumber, itemId } when an item is dropped into this slot"
        @tier "essential"
    }

    listens {
      CLICK {
        slotNumber : number!
      }
      DROP {
        slotNumber : number!
        itemId : string!
      }
    }

    config {
      slotNumber : number = 1
        @label "Slot Number"
        @description "Slot index (1-based)"
        @tier "presentation"
      equippedItem : TraitSlotEquippedItem
        @label "Equipped Item"
        @description "Currently equipped item, if any"
        @tier "presentation"
      locked : boolean = false
        @label "Locked"
        @description "Whether slot is locked"
        @tier "presentation"
      lockLabel : string
        @label "Lock Label"
        @description "Label shown when locked"
        @tier "presentation"
      selected : boolean = false
        @label "Selected"
        @description "Whether slot is selected"
        @tier "presentation"
      size : "sm" | "md" | "lg" = md
        @label "Size"
        @description "Size variant"
        @tier "presentation"
      showTooltip : boolean = true
        @label "Show Tooltip"
        @description "Show tooltip on hover"
        @tier "presentation"
      categoryColors : Map string TraitSlotCategoryColorsValue = {}
        @label "Category Colors"
        @description "Category → color mapping"
        @tier "presentation"
      tooltipFrameUrl : TraitSlotTooltipFrameUrl
        @label "Tooltip Frame Url"
        @description "Optional tooltip frame image asset"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : TraitSlotError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      onItemDrop : event = "ITEM_DROP"
        @label "On Item Drop"
        @description "-- Drag and drop --"
        @tier "presentation"
      draggable : boolean = false
        @label "Draggable"
        @description "Whether this slot's equipped item is draggable"
        @tier "presentation"
      onDragStart : event = "DRAG_START"
        @label "On Drag Start"
        @description "Called when drag starts from this slot"
        @tier "presentation"
      feedback : "correct" | "wrong"
        @label "Feedback"
        @description "Per-slot correctness feedback after a failed attempt"
        @tier "presentation"
      onClick : event = "CLICK"
        @label "On Click"
        @description "-- Callbacks --"
        @tier "presentation"
      onRemove : event = ""
        @label "On Remove"
        @description "Remove handler"
        @tier "presentation"
      clickEvent : event = "CLICK"
        @label "Click Event"
        @description "-- Declarative events --"
        @tier "presentation"
      removeEvent : event = ""
        @label "Remove Event"
        @description "Emits UI:{removeEvent} with { slotNumber }"
        @tier "presentation"
      dropEvent : event = "DROP"
        @label "Drop Event"
        @description "Emits UI:{dropEvent} with { slotNumber, itemId } when an item is dropped into this slot"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/trait-slot" as TraitSlotPage -> TraitSlotRender
}
