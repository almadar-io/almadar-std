app std-game-design-sheet "1.0.0"
"Headless game-design metadata authority: every game or level in the std library MUST compose this atom and fill its design sheet before declaring mechanics. The sheet forces the author to state the core loop, challenge, goals, feedback, agency, mechanics, dynamics, engagement drivers, rewards, math target, and grade level. The atom owns no rendering and no rules; it is the single source of truth for intent metadata. Future game atoms (platformer-body, objective-flow, fx-narrative, pickup, gate-lock, etc.) correspond to fields here, and level organisms bind those atoms together while declaring how each field is realized."

orbital GameDesignSheetOrbital {
  type GameDesign = {
    coreLoop : string!
    challenge : string!
    goals : [string]!
    feedback : string!
    agency : string!
    mechanics : [string]!
    dynamics : [string]!
    engagement : [string]!
    rewards : [string]!
    mathTarget : string!
    gradeLevel : string!
  }

  entity GameDesignState [runtime, shared] {
    id : string!
    design : GameDesign = {}
    declared : boolean = false
  }

  trait GameDesignSheet -> @rebindable GameDesignState [lifecycle] {
    initial: active

    state active {
      INIT -> active
        (set @entity.design @config.design)
        (set @entity.declared true)
        (emit DESIGN_DECLARED { design: @entity.design })

      RESTART -> active
        (set @entity.design @config.design)
        (set @entity.declared true)
        (emit DESIGN_DECLARED { design: @entity.design })
    }

    emits {
      DESIGN_DECLARED -> external {
        design : GameDesign!
      }
        @description "The compiled game-design sheet is emitted once on INIT and again on RESTART so organism-level authorities, analytics, or tutorial overlays can react to it."
        @tier "domain"
    }

    listens {
      RESTART { id : string }
    }

    config {
      design : GameDesign = {
        coreLoop: "",
        challenge: "",
        goals: [],
        feedback: "",
        agency: "",
        mechanics: [],
        dynamics: [],
        engagement: [],
        rewards: [],
        mathTarget: "",
        gradeLevel: ""
      }
        @label "Design Sheet"
        @description "Required game-design metadata. All string/array fields must be non-empty for a finished level; empty defaults fail validation until the author fills them in."
        @tier "domain"
    }
  }

  page "/game-design-sheet" as GameDesignSheetPage -> GameDesignSheet
}
