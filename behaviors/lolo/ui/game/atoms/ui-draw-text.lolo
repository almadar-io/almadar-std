app ui-draw-text [
  version: "1.0.0",
  description: "DrawText — UI factory (1:1 with the @almadar/ui draw-text pattern)."
]
;; @pattern "draw-text"
orbital DrawTextOrbital {
  type DrawTextSemantic = {
    role : string!
    name : string!
    value : string
    checked : boolean
    disabled : boolean
    order : number
    focused : boolean
    caret : number
    selectionStart : number
    selectionEnd : number
    multiline : boolean
  }
  type DrawTextSpring = {
    stiffness : number!
    damping : number!
  }
  type DrawTextAnimation = {
    durationMs : number!
    loop : boolean
    keyframes : [DrawTextAnimationKeyframesItem]!
  }
  type DrawTextAnimationKeyframesItem = {
    at : number!
    opacity : number
    offsetX : number
    offsetY : number
  }
  type DrawTextPosition = {
    x : number!
    y : number!
    z : number
  }

  entity DrawTextItem [runtime] {
    id : string!
  }

  trait DrawTextRender -> @rebindable DrawTextItem {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          text: @config.text
          position: @config.position
          anchor: @config.anchor
          offsetX: @config.offsetX
          offsetY: @config.offsetY
          color: @config.color
          font: @config.font
          align: @config.align
          baseline: @config.baseline
          opacity: @config.opacity
          width: @config.width
          wrap: @config.wrap
          maxLines: @config.maxLines
          truncate: @config.truncate
          lineHeight: @config.lineHeight
          measure: @config.measure
          animation: @config.animation
          hit: @config.hit
          semantic: @config.semantic
          spring: @config.spring
          caret: @config.caret
          caretColor: @config.caretColor
          selectionStart: @config.selectionStart
          selectionEnd: @config.selectionEnd
          selectionColor: @config.selectionColor
          preedit: @config.preedit
          type: draw-text
        })
    }

    config {
      text : string = ""
        @label "Text"
        @description "text prop"
        @tier "presentation"
      position : DrawTextPosition = { x: 1, y: 1, z: 1 }
        @label "Position"
        @description "Logical scene position; the projector maps it to pixels / world."
        @tier "presentation"
      anchor : "top-left" | "ground" | "center"
        @label "Anchor"
        @description "anchor prop"
        @tier "presentation"
      offsetX : number
        @label "Offset X"
        @description "offsetX prop"
        @tier "presentation"
      offsetY : number
        @label "Offset Y"
        @description "offsetY prop"
        @tier "presentation"
      color : string = ""
        @label "Color"
        @description "color prop"
        @tier "presentation"
      font : string
        @label "Font"
        @description "font prop"
        @tier "presentation"
      align : "center" | "end" | "left" | "right" | "start"
        @label "Align"
        @description "align prop"
        @tier "presentation"
      baseline : "alphabetic" | "bottom" | "hanging" | "ideographic" | "middle" | "top"
        @label "Baseline"
        @description "baseline prop"
        @tier "presentation"
      opacity : number
        @label "Opacity"
        @description "opacity prop"
        @tier "presentation"
      width : number
        @label "Width"
        @description "Line width in px; with it the text lays out as a paragraph from `position` (top-left anchor). Orbital painter."
        @tier "presentation"
      wrap : boolean
        @label "Wrap"
        @description "Break at line opportunities within `width` (default true when `width` is set)."
        @tier "presentation"
      maxLines : number
        @label "Max Lines"
        @description "Maximum number of lines; the last kept line ends in an ellipsis when `truncate` is true."
        @tier "presentation"
      truncate : boolean
        @label "Truncate"
        @description "Ellipsis instead of overflow."
        @tier "presentation"
      lineHeight : number
        @label "Line Height"
        @description "Line height as a multiple of the font size (default 1.3)."
        @tier "presentation"
      measure : boolean
        @label "Measure"
        @description "Report this text's size in `measureEvent` (needs `id`)."
        @tier "presentation"
      animation : DrawTextAnimation
        @label "Animation"
        @description "Keyframe animation over this text's opacity, offsetX and offsetY; the host runs a paint clock while present."
        @tier "presentation"
      hit : boolean
        @label "Hit"
        @description "With an `id`, the drawable is a pointer region (its painted bounds, rotation applied); the orbital canvas emits the pointer events for it."
        @tier "presentation"
      semantic : DrawTextSemantic
        @label "Semantic"
        @description "Accessibility node for this drawable."
        @tier "presentation"
      spring : DrawTextSpring
        @label "Spring"
        @description "With an `id`: when a repaint changes this drawable's animatable fields, the canvas moves them to the new values by this spring."
        @tier "presentation"
      caret : number
        @label "Caret"
        @description "Draw a caret before this character index (-1 or absent: none), blinking on the renderer clock."
        @tier "presentation"
      caretColor : string
        @label "Caret Color"
        @description "Caret colour (theme tone or colour)."
        @tier "presentation"
      selectionStart : number
        @label "Selection Start"
        @description "Start of the selection band, in characters."
        @tier "presentation"
      selectionEnd : number
        @label "Selection End"
        @description "End of the selection band, in characters."
        @tier "presentation"
      selectionColor : string
        @label "Selection Color"
        @description "Selection band colour."
        @tier "presentation"
      preedit : string
        @label "Preedit"
        @description "Input-method text shown at the caret, underlined, not part of `text`."
        @tier "presentation"
    }
  }

  page "/draw-text" as DrawTextPage -> DrawTextRender
}
