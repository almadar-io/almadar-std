app ui-draw-text-layer "1.0.0"
"DrawTextLayer — UI factory (1:1 with the @almadar/ui draw-text-layer pattern)."
orbital DrawTextLayerOrbital {
  type DrawTextLayerItemsItem = {
    type : "draw-text"!
    text : string!
    position : DrawTextLayerItemsItemPosition!
    anchor : "top-left" | "ground" | "center"
    offsetX : number
    offsetY : number
    color : string!
    font : string
    align : "center" | "end" | "left" | "right" | "start"
    baseline : "alphabetic" | "bottom" | "hanging" | "ideographic" | "middle" | "top"
    opacity : number
  }
  type DrawTextLayerItemsItemPosition = {
    x : number!
    y : number!
    z : number
  }

  entity DrawTextLayerItem [runtime] {
    id : string!
  }

  trait DrawTextLayerRender -> @rebindable DrawTextLayerItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          items: @config.items
          type: draw-text-layer
        })
    }

    config {
      items : [DrawTextLayerItemsItem] = [{ type: "draw-text", text: "Text", position: { x: 1, y: 1, z: 1 }, anchor: "top-left", offsetX: 1, offsetY: 1, color: "Color", font: "Font", align: center, baseline: alphabetic, opacity: 1 }, { type: "draw-text", text: "Text 2", position: { x: 2, y: 2, z: 2 }, anchor: ground, offsetX: 2, offsetY: 2, color: "Color 2", font: "Font 2", align: end, baseline: bottom, opacity: 2 }]
        @label "Items"
        @description "items prop"
        @tier "presentation"
    }
  }

  page "/draw-text-layer" as DrawTextLayerPage -> DrawTextLayerRender
}
