app ui-draw-text-layer [
  version: "1.0.0",
  description: "DrawTextLayer — UI factory (1:1 with the @almadar/ui draw-text-layer pattern)."
]
;; @pattern "draw-text-layer"
orbital DrawTextLayerOrbital {
  type DrawTextLayerSemantic = {
    role : string!
    name : string!
    value : string
    checked : boolean
    disabled : boolean
  }
  type DrawTextLayerSpring = {
    stiffness : number!
    damping : number!
  }
  type DrawTextLayerItemsItem = {
    type : "draw-text"!
    id : string
    text : string!
    position : DrawTextLayerItemsItemPosition!
    anchor : "top-left" | "ground" | "center"
    offsetX : number
    offsetY : number
    color : string!
    font : string
    align : "center" | "end" | "left" | "right" | "start"
    baseline : "alphabetic" | "bottom" | "hanging" | "ideographic" | "middle" | "top"
    opacity : number
  }
  type DrawTextLayerItemsItemPosition = {
    x : number!
    y : number!
    z : number
  }

  entity DrawTextLayerItem [runtime] {
    id : string!
  }

  trait DrawTextLayerRender -> @rebindable DrawTextLayerItem {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          items: @config.items
          hit: @config.hit
          semantic: @config.semantic
          spring: @config.spring
          type: draw-text-layer
        })
    }

    config {
      items : [DrawTextLayerItemsItem] = [{ type: "draw-text", id: "Id", text: "Text", position: { x: 1, y: 1, z: 1 }, anchor: "top-left", offsetX: 1, offsetY: 1, color: "Color", font: "Font", align: center, baseline: alphabetic, opacity: 1 }, { type: "draw-text", id: "Id 2", text: "Text 2", position: { x: 2, y: 2, z: 2 }, anchor: ground, offsetX: 2, offsetY: 2, color: "Color 2", font: "Font 2", align: end, baseline: bottom, opacity: 2 }]
        @label "Items"
        @description "items prop"
        @tier "presentation"
      hit : boolean
        @label "Hit"
        @description "With an `id`, the drawable is a pointer region (its painted bounds, rotation applied); the orbital canvas emits the pointer events for it."
        @tier "presentation"
      semantic : DrawTextLayerSemantic
        @label "Semantic"
        @description "Accessibility node for this drawable."
        @tier "presentation"
      spring : DrawTextLayerSpring
        @label "Spring"
        @description "With an `id`: when a repaint changes this drawable's animatable fields, the canvas moves them to the new values by this spring."
        @tier "presentation"
    }
  }

  page "/draw-text-layer" as DrawTextLayerPage -> DrawTextLayerRender
}
