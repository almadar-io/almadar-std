app ui-canvas-2d [
  version: "1.0.0",
  description: "Canvas2d — UI factory (1:1 with the @almadar/ui canvas-2d pattern)."
]
;; @pattern "canvas-2d"
orbital Canvas2dOrbital {
  type Canvas2dError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type Canvas2dFollowTarget = {
    x : number!
    y : number!
    z : number
  }
  type Canvas2dCameraPos = {
    x : number!
    y : number!
    z : number
  }

  entity Canvas2dItem [runtime] {
    id : string!
  }

  trait Canvas2dRender -> @rebindable Canvas2dItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          description: @config.description
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          projection: @config.projection
          drawables: @config.drawables
          backgroundImage: @config.backgroundImage
          tileClickEvent: @config.tileClickEvent
          unitClickEvent: @config.unitClickEvent
          tileHoverEvent: @config.tileHoverEvent
          tileLeaveEvent: @config.tileLeaveEvent
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          editable: @config.editable
          selectedId: @config.selectedId
          onSelect: @config.onSelect
          onMove: @config.onMove
          selectEvent: @config.selectEvent
          moveEvent: @config.moveEvent
          camera: @config.camera
          scale: @config.scale
          tileWidth: @config.tileWidth
          fit: @config.fit
          showMinimap: @config.showMinimap
          followTarget: @config.followTarget
          cameraPos: @config.cameraPos
          bgColor: @config.bgColor
          children: @config.children
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: canvas-2d
        })
    }

    emits {
      @config.tileClickEvent -> external {
        x : number!
        y : number!
      }
        @description "--- Declarative events back to LOLO ---"
        @tier "essential"
      @config.unitClickEvent -> external {
        unitId : string!
      }
        @description "Unit-click event. The neutral drawable host cannot resolve a click to a per-entity id (descriptors carry only a `ScenePos`, no id), so this prop is accepted but not yet emitted — the id-hit-test is a tracked fork (docs/Almadar_Std_Game_V2_PLAN.md)."
        @tier "essential"
      @config.tileHoverEvent -> external {
        x : number!
        y : number!
      }
        @description "Emits UI:{tileHoverEvent} with the unprojected scene { x, y } on hover."
        @tier "essential"
      @config.tileLeaveEvent -> external { }
        @description "Emits UI:{tileLeaveEvent} with {} on pointer leave."
        @tier "essential"
      @config.onSelect -> external {
        id : string
      }
        @description "Fired on a click that changes selection — before `selectEvent`."
        @tier "essential"
      @config.onMove -> external {
        id : string
        x : number
        y : number
      }
        @description "Fired once per drag gesture, on drop — before `moveEvent`."
        @tier "essential"
    }

    config {
      description : string
        @label "Description"
        @description "Text alternative for the scene, rendered as visually hidden text and linked by aria-describedby."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "--- Closed-circuit ---"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : Canvas2dError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      projection : "isometric" | "hex" | "flat" | "free" | "side" = isometric
        @label "Projection"
        @description "--- Projection ---"
        @tier "presentation"
      drawables : [node] = []
        @label "Drawables"
        @description "--- Scene ---"
        @tier "presentation"
      backgroundImage : asset
        @label "Background Image"
        @description "Background image (tiled behind iso/hex/flat/free; cover-scaled for atlas slices). A bare URL string is accepted as shorthand for a standalone backdrop."
        @tier "presentation"
      tileClickEvent : event = "TILE_CLICK"
        @label "Tile Click Event"
        @description "--- Declarative events back to LOLO ---"
        @tier "presentation"
      unitClickEvent : event = "UNIT_CLICK"
        @label "Unit Click Event"
        @description "Unit-click event. The neutral drawable host cannot resolve a click to a per-entity id (descriptors carry only a `ScenePos`, no id), so this prop is accepted but not yet emitted — the id-hit-test is a tracked fork (docs/Almadar_Std_Game_V2_PLAN.md)."
        @tier "presentation"
      tileHoverEvent : event = "TILE_HOVER"
        @label "Tile Hover Event"
        @description "Emits UI:{tileHoverEvent} with the unprojected scene { x, y } on hover."
        @tier "presentation"
      tileLeaveEvent : event = "TILE_LEAVE"
        @label "Tile Leave Event"
        @description "Emits UI:{tileLeaveEvent} with {} on pointer leave."
        @tier "presentation"
      keyMap : Map string string = { item: "INIT" }
        @label "Key Map"
        @description "Maps a keydown `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event (device-agnostic input), emitted as `UI:{event}`; keystrokes inside inputs/textareas never route."
        @tier "presentation"
      keyUpMap : Map string string = { item: "INIT" }
        @label "Key Up Map"
        @description "Maps a keyup `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` in that order — to the board's SEMANTIC event, emitted as `UI:{event}`; keystrokes inside inputs/textareas never route."
        @tier "presentation"
      editable : boolean = false
        @label "Editable"
        @description "--- Scene-edit mode (a game studio selecting/dragging drawables). Purely"
        @tier "presentation"
      selectedId : string
        @label "Selected Id"
        @description "The currently-selected drawable id (controlled); `null`/undefined = none."
        @tier "presentation"
      onSelect : event = "SELECT"
        @label "On Select"
        @description "Fired on a click that changes selection — before `selectEvent`."
        @tier "presentation"
      onMove : event = "MOVE"
        @label "On Move"
        @description "Fired once per drag gesture, on drop — before `moveEvent`."
        @tier "presentation"
      selectEvent : event = "SELECT"
        @label "Select Event"
        @description "Declarative selection event, `UI:{selectEvent} { id }`."
        @tier "presentation"
      moveEvent : event = "MOVE"
        @label "Move Event"
        @description "Declarative move event, `UI:{moveEvent} { id, x, y }` — fired once on drop."
        @tier "presentation"
      camera : "pan-zoom" | "follow" | "fixed" = "pan-zoom"
        @label "Camera"
        @description "--- View config (pure render) ---"
        @tier "presentation"
      scale : number = 0.4
        @label "Scale"
        @description "Render scale, legacy-squared semantics: on-screen cell ≈ `256 × scale²` px (the authored contract every board tuned its value for). Converted internally to the single camera zoom against the board's native tile width, so the cell pitch follows the asset while the on-screen size stays as authored. Ignored when `fit` is on; passed through raw for `free`/`side` (world-pixel-direct)."
        @tier "presentation"
      tileWidth : number
        @label "Tile Width"
        @description "Native tile/cell width in source px for this board's asset (e.g. 16 for Kenney tiny-dungeon, ~128 for iso blocks). The grid cell pitch follows the asset, so tile textures map 1:1 (crisp, no stretch). Defaults to the detected atlas tile width, else 256."
        @tier "presentation"
      fit : boolean = false
        @label "Fit"
        @description "Auto-fit the board's grid extent to the viewport (default false — boards render at their authored `scale` and overflow → pan). Opt in for whole-board-overview boards. User wheel/pinch zoom always wins after the initial fit."
        @tier "presentation"
      showMinimap : boolean = true
        @label "Show Minimap"
        @description "Toggle minimap overlay."
        @tier "presentation"
      followTarget : Canvas2dFollowTarget
        @label "Follow Target"
        @description "Follow-camera target in scene space (the neutral core `Camera.target`). When `camera:'follow'` the host lerps to keep this point centered."
        @tier "presentation"
      cameraPos : Canvas2dCameraPos
        @label "Camera Pos"
        @description "Initial camera position in scene space (the neutral core `Camera.pos`). The host projects this to screen space and centers the viewport on it for the first render; ignored once the user pans or a follow target takes over."
        @tier "presentation"
      bgColor : string
        @label "Bg Color"
        @description "Solid backdrop colour — the base layer under any `backgroundImage`."
        @tier "presentation"
      children : node
        @label "Children"
        @description "Declarative JSX drawable children (`<DrawShape .../>` composed in paint order). When `drawables` is empty, each child registers its descriptor via the drawable registry context and the host paints them."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/canvas-2d" as Canvas2dPage -> Canvas2dRender
}
