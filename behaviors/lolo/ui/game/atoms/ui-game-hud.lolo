app ui-game-hud "1.0.0"
"GameHud — UI factory (1:1 with the @almadar/ui game-hud pattern)."
;; @pattern "game-hud"
orbital GameHudOrbital {
  type GameHudStatsItem = {
    assetUrl : GameHudStatsItemAssetUrl
    iconUrl : GameHudStatsItemIconUrl
    label : string!
    value : string
    max : number
    source : string
    field : string
    format : string
    icon : icon
    variant : string
    className : string
  }
  type GameHudStatsItemAssetUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type GameHudStatsItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type GameHudItemsItem = {
    assetUrl : GameHudItemsItemAssetUrl
    iconUrl : GameHudItemsItemIconUrl
    label : string!
    value : string
    max : number
    source : string
    field : string
    format : string
    icon : icon
    variant : string
    className : string
  }
  type GameHudItemsItemAssetUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type GameHudItemsItemIconUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }
  type GameHudElementsItem = {
    type : string
    bind : string
    position : string
    label : string
    value : string
    icon : icon
    assetUrl : GameHudElementsItemAssetUrl
    format : string
    max : number
  }
  type GameHudElementsItemAssetUrl = {
    url : asset!
    role : string!
    category : string!
    animations : [string]
    style : "pixel" | "vector" | "hd" | "1-bit" | "isometric"
    variant : string
    dimension : "2d" | "3d"
    aspect : "1:1" | "16:9" | "5:7" | "8:1" | "4:1" | "5:3" | "1:2"
    atlas : asset
    sprite : string
    name : string
    thumbnailUrl : string
  }

  entity GameHudItem [runtime] {
    id : string!
  }

  trait GameHudRender -> @rebindable GameHudItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          position: @config.position
          stats: @config.stats
          items: @config.items
          elements: @config.elements
          size: @config.size
          variant: @config.variant
          className: @config.className
          transparent: @config.transparent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: game-hud
        })
    }

    config {
      position : string
        @label "Position"
        @description "Position of the HUD"
        @tier "presentation"
      stats : [GameHudStatsItem] = []
        @label "Stats"
        @description "Stats to display - accepts readonly for compatibility with generated const arrays"
        @tier "presentation"
      items : [GameHudItemsItem] = []
        @label "Items"
        @description "Alias for stats (schema compatibility)"
        @tier "presentation"
      elements : [GameHudElementsItem] = []
        @label "Elements"
        @description "Schema-style elements array (alternative to stats). Converted to stats internally for backwards compatibility."
        @tier "presentation"
      size : "sm" | "md" | "lg" = md
        @label "Size"
        @description "Size variant"
        @tier "presentation"
      variant : "floating" | "bar" = floating
        @label "Variant"
        @description "Layout variant: 'floating' (default) renders a compact pill cluster that hugs its content width; 'bar' preserves the legacy full-width split bar."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      transparent : boolean = true
        @label "Transparent"
        @description "Whether to use a semi-transparent background"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/game-hud" as GameHudPage -> GameHudRender
}
