        @label "Tiles"
        @description "Sea/island grid tiles"
        @tier "presentation"
      units : [PirateBoardUnitsItem] = [{ id: "u1", position: { x: 1, y: 4 }, unitType: "ship", name: "Galleon", team: player, health: 10, maxHealth: 10, modelUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/units/ship.svg", role: "npc", category: "ship", animations: ["idle", "walk", "attack", "hit", "death"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "ship", thumbnailUrl: "" }, animation: "idle", frame: 0 }, { id: "u2", position: { x: 6, y: 2 }, unitType: "ship", name: "Corsair", team: enemy, health: 8, maxHealth: 10, modelUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/units/ship.svg", role: "npc", category: "ship", animations: ["idle", "walk", "attack", "hit", "death"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "ship", thumbnailUrl: "" }, animation: "idle", frame: 0 }, { id: "u3", position: { x: 4, y: 0 }, unitType: "ship", name: "Scout", team: neutral, health: 6, maxHealth: 6, modelUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/units/ship.svg", role: "npc", category: "ship", animations: ["idle", "walk", "attack", "hit", "death"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "ship", thumbnailUrl: "" }, animation: "idle", frame: 0 }]
        @label "Units"
        @description "Ship units on the board"
        @tier "presentation"
      features : [PirateBoardFeaturesItem] = [{ id: "f1", x: 4, y: 1, type: "port", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/features/port.svg", role: "decoration", category: "port", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "port", thumbnailUrl: "" } }, { id: "f2", x: 5, y: 5, type: "treasure", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/features/treasure.svg", role: "decoration", category: "treasure", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "treasure", thumbnailUrl: "" } }]
        @label "Features"
        @description "Features (ports, treasures) on the board"
        @tier "presentation"
      assetManifest : PirateBoardAssetManifest = { terrains: { sea: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/terrain/sea.svg", role: "tile", category: "sea", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "sea", thumbnailUrl: "" }, island: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/terrain/island.svg", role: "tile", category: "island", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "island", thumbnailUrl: "" } }, units: { ship: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/units/ship.svg", role: "npc", category: "ship", animations: ["idle", "walk", "attack", "hit", "death"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "ship", thumbnailUrl: "" } }, features: { port: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/features/port.svg", role: "decoration", category: "port", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "port", thumbnailUrl: "" }, treasure: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/features/treasure.svg", role: "decoration", category: "treasure", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "treasure", thumbnailUrl: "" } }, effects: { explosion: { url: "https://almadar-kflow-assets.web.app/shared/ui-pirate-board/svg/isometric/effects/explosion.svg", role: "effect", category: "explosion", animations: ["static"], style: "", variant: "", dimension: "2d", aspect: "1:1", name: "explosion", thumbnailUrl: "" } } }
        @label "Asset Manifest"
        @description "Asset sprite manifest"
        @tier "presentation"
      scale : number = 0.45
        @label "Scale"
        @description "Render scale"
        @tier "presentation"
      unitScale : number = 1
        @label "Unit Scale"
        @description "Unit draw-size multiplier"
        @tier "presentation"
    }
  }

page "/pirate-board" as PirateBoardPage -> PirateBoardRender
}
