app ui-topdown-dungeon-board "1.0.0"
"TopdownDungeonBoard -- key-move dungeon crawl on a Tiny Dungeon grid: bump-attack monsters, reach the chest to win, composes the std dungeon-board-2d frame."
;; ============================================================================
;; PERSONAS + USER STORIES
;;
;; Genre: top-down dungeon-crawl on a square grid. The player expects to step
;; the hero with keys or a d-pad, bump-attack monsters, avoid or outlast enemy
;; contact, reach the chest, and win/lose based on HP and objectives.
;; Round loop: input → move or bump → enemies react → check win/lose → repeat.
;; Read these before changing anything here, and walk them end to end after.
;; ============================================================================
;;
;; PERSONA — "The Adventurer": a lone hero who explores a monster-filled dungeon
;; one tile at a time, fighting only when necessary and racing to the exit chest.
;;
;;   1. I start a run and the board shows walls, floors, the hero, three monsters
;;      and a chest, plus HP and score in the HUD.
;;        WORKS. The page composes Frame traits; canvas draws tiles, units,
;;        features and HUD from the organism config.
;;   2. I press an arrow key (or tap the d-pad) and the hero moves one floor tile.
;;        WORKS. DungeonIntent emits MOVE; HeroNav updates position and decrements
;;        movesLeft; HERO_STEPPED is broadcast.
;;   3. I bump into a monster and the hero attacks it for one damage.
;;        BROKEN. The frame implements only adjacent "bump-attack" from the cell
;;        before moving; there is no separate attack action from the new cell and
;;        no attackRange config. Requires std-dungeon-board-2d / std-dungeon-combat
;;        fix (see Almadar_Std_Game_Gaps.md).
;;   4. I reach the chest and a victory overlay appears.
;;        WORKS. HERO_STEPPED triggers ObjectiveReach; PROGRESS reaches zero
;;        objectives; ObjectiveFlow sets result="won" and the overlay renders.
;;   5. My HP drops to zero from monster contact and a defeat overlay appears.
;;        WORKS. MONSTER_TICK deals contact damage; at hp<=0 DungeonCombat sets
;;        combatResult="lost" and the overlay renders.
;;   6. I press Play Again after winning or losing and the board fully resets.
;;        WORKS. PLAY_AGAIN emits RESTART; all lifecycle traits re-seed units,
;;        enemies, HP, score and result flags.
;;   7. I walk into a wall and the hero stays in place without spending a move.
;;        WORKS. DungeonIntent checks tile passability before emitting MOVE.
;;   8. I try to move after the hero has already acted and the spent hero dims
;;      and refuses input.
;;        BROKEN. The shared frame uses a per-round moveBudget, not per-turn
;;        movedIds/actedIds, and never dims the sprite. Requires frame fix.
;;   9. I attack a monster that is one tile away after moving, without needing to
;;      step onto its tile.
;;        BROKEN. No post-move attack range or direct enemy-click handler exists
;;        in the frame; attack is only the bump-attack emitted during MOVE_*.        Requires std-dungeon-board-2d interaction extension.
;;  10. The score value in the HUD displays as plain text instead of being parsed
;;      as a number.
;;        BROKEN. The frame renders { label: "Score", value: ... } without
;;        format:"text"; game-hud defaults to number formatting. Requires frame
;;        render fix.
;;  11. The floor/wall SVGs fill each cell edge-to-edge with no gaps.
;;        BROKEN. The frame renders draw-sprite anchor:"center" width:1 height:1
;;        under projection:"flat" and does not align isometric cell art to the
;;        grid. Requires frame render / projection fix.
;;  12. I see idle animations playing while the hero and monsters are standing.
;;        WORKS (for static SVG assets). The generated isometric assets declare a
;;        single "static" state; the renderer continuously draws that state.
;;        Animated idle cycles require an AnimClock port in the frame.

orbital TopdownDungeonBoardOrbital {
  uses Frame from "std/behaviors/std-dungeon-board-2d"

  type Asset = {
    url : asset
    atlas : asset
    sprite : string
    role : string
    category : string
    animations : [string]
    style : string
    variant : string
    dimension : string
    aspect : string
    name : string
    thumbnailUrl : string
  }
  type Unit = {
    id : string!
    position : { x : number!  y : number! }
    x : number
    y : number
    z : number
    team : string
    health : number
    maxHealth : number
    unitType : string
    name : string
    animation : string
    frame : number
    sprite : Asset
  }
  type Tile = {
    id : string
    x : number!
    y : number!
    terrain : string
    passable : boolean
    terrainSprite : Asset
  }
  type Feature = {
    id : string
    x : number!
    y : number!
    type : string!
    sprite : Asset
    done : boolean
  }
  type Fx = {
    id : string!
    type : string!
    x : number!
    z : number
    y : number
    message : string
    ttl : number!
  }
  type AssetManifest = {
    terrains : Map string Asset
    units : Map string Asset
    features : Map string Asset
    effects : Map string Asset
  }

  entity GameState [runtime, shared] {
    id : string!
    units : [Unit] = []
    enemies : [Unit] = []
    tiles : [Tile] = []
    features : [Feature] = []
    fx : [Fx] = []
    movesLeft : number = 0
    score : number = 0
    combatScore : number = 0
    objectivesLeft : number = 0
    hp : number = 5
    maxHp : number = 5
    result : string = "none"
    combatResult : string = "none"
  }

  trait HeroAuthority = Frame.traits.HeroAuthority -> GameState {
    config {
      running: true
      gridWidth: 12
      gridHeight: 9
      moveBudget: 999999
      units: [ { id: "hero", position: { x: 2, y: 1 }, x: 2, y: 1, z: 0, unitType: "hero", name: "Hero", team: "player", health: 5, maxHealth: 5, animation: "idle", frame: 0, sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/units/knight.svg", role: "npc", category: "knight", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "knight", thumbnailUrl: "" } } ]
      tiles: [{ x: 0, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 1, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 2, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 3, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 4, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 5, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 6, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 7, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 8, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 9, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 10, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 11, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { x: 0, y: 1, terrain: "wall", passable: false, terrainSprit