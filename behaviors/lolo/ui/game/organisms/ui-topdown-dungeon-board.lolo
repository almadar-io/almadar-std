  trait Collector = Frame.traits.Collector -> GameState {
    config {
      running: true
      targetType: "chest"
      pointsPerTarget: 200
      removeOnReach: false
      reachRadius: 0
      features: [{ id: "f1", x: 10, y: 7, type: "chest", sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/features/chest.svg", role: "decoration", category: "chest", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "chest", thumbnailUrl: "" } }, { id: "f2", x: 4, y: 3, type: "prop", sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/features/barrel.svg", role: "decoration", category: "barrel", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "barrel", thumbnailUrl: "" } }, { id: "f3", x: 2, y: 7, type: "prop", sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-topdown-dungeon-board/svg/isometric/features/barrel.svg", role: "decoration", category: "barrel", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "barrel", thumbnailUrl: "" } }]
    }
