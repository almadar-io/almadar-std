 dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, { x: 1, y: 3, terrain: "ground", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, { x: 2, y: 3, terrain: "ground", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, { x: 3, y: 3, terrain: "ground", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, { x: 4, y: 3, terrain: "ground", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, { x: 5, y: 3, terrain: "ground", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, { x: 6, y: 3, terrain: "ground", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1",