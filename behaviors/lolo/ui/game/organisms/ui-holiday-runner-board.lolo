app ui-holiday-runner-board "1.0.0"
"HolidayRunnerBoard — endless runner on a flat tiled scene, composed via game-shell."
;; @capabilities "endless runner, tiled scene traversal, obstacle dodging, distance scoring"

;; ============================================================================
;; PERSONA + USER STORIES
;;
;; Read these before changing anything here, and walk them end to end after.
;; One persona: the PLAYER, a holiday commuter trying to keep a gift-laden runner
;; moving through a snowy side-scrolling strip. Statuses verified 2026-07-31 by
;; `orb validate` 0/0 + `orb emit` + `runtime-verify` guard-truth probes. The
;; organism was originally a bare scaffold (auto-run + jump input) and is being
;; migrated to hand-authored flat SVG assets; several genre mechanics (collision,
;; scoring, win/lose) are still missing and recorded as gaps below.
;;
;; THE GENRE (what an endless-runner player expects): the runner moves right on
;; its own, the world scrolls, and the only direct control is a well-timed jump
;; over obstacles. A good run rewards distance and a clean dodge; a bad run ends
;; when health runs out. The round loop is: boot → runner auto-advances →
;; obstacle approaches → jump → land → repeat → reach a distance goal (win) or
;; take one too many hits (lose) → Play Again.
;; ============================================================================
;;
;; PLAYER — "I jump at the right moment and see how far I can get."
;;
;;   1. I open the board and see the whole scene framed — sky above, snow ground
;;      under every cell, the runner on the left, obstacles ahead, and the HUD
;;      showing Distance and Score.
;;        WORKS. Boot renders flat terrain tiles (sky/ground SVG, full-cell),
;;      runner + obstacle unit sprites (SVG url descriptors), name labels and
;;      health bars; HUD Distance 0 / Score 0 (verified by runtime-verify boot
;;      probe).
;;   2. The runner starts moving right automatically as soon as the board loads.
;;        WORKS. The renderTick increments entity.distance every 100ms while
;;      result=="none"; the runner sprite cycles walk-0 / walk-1 frames.
;;   3. I tap/click the Jump button (or press Space/Up/W) and the runner jumps
;;      over the next obstacle.
;;        PARTIAL. JUMP fires and sets animation="attack" for one cycle, but the
;;      runner has no vertical position change or collision bypass yet — the
;;      jump is visual-only (gap STD-RUNNER-JUMP-NO-MOTION).
;;   4. The HUD updates live — Distance ticks up and Score reflects dodges.
;;        PARTIAL. Distance ticks up every renderTick. Score never changes
;;      because there is no scoring event wired (gap STD-RUNNER-SCORE-UNWIRED).
;;   5. I clear a long run and reach the distance goal, triggering a win screen.
;;        BROKEN. No distance-goal win condition exists; result stays "none"
;;      indefinitely (gap STD-RUNNER-WIN-CONDITION-MISSING).
;;   6. I mistime a jump, hit an obstacle, lose health, and eventually die.
;;        BROKEN. No collision detection between runner and obstacles; health
;;      never decreases (gap STD-RUNNER-COLLISION-MISSING).
;;   7. When the runner falls, the board tells me and offers Play Again.
;;        BROKEN. Depends on story 6; no gameover state or Play Again path
;;      (gap STD-RUNNER-GAMEOVER-MISSING).
;;   8. I spam the Jump button and the runner does not benefit from it — one
;;      action per obstacle, not a cheat code.
;;        BROKEN. JUMP is unguarded except result=="none"; there is no jump
;;      cooldown or per-obstacle activation model for this genre
;;      (gap STD-RUNNER-ACTION-STAMINA-MISSING).
;;   9. I click an obstacle to inspect it; the selection ring follows it as it
;;      scrolls toward the runner.
;;        WORKS. UNIT_CLICK sets selectedUnitId and the cyan ellipse is drawn at
;;      the unit's current cell in every renderTick.
;;  10. The runner and obstacles keep animating while the game is running and
;;      freeze when the round ends.
;;        PARTIAL. Idle/walk frames cycle via the inline SVG url-rewrite while
;;      result=="none"; a result guard would be needed to freeze, but result
;;      never leaves "none" today.
;;
;; ASSET INVENTORY (hand-authored svg, almadar-kflow-assets.web.app
;; /shared/ui-holiday-runner-board/svg/flat/)
;;
;;   Terrain   terrain/{sky,ground}.svg — full-cell flat tiles.
;;   Units     units/{runner,obstacle}.svg + animation frames
;;             .{idle-0..3, walk-0..1, attack-0, hit-0, death-0}.svg.
;;   Background / UI chrome  Still on Kenney pending shared-ui-pack migration;
;;             see `;; TODO: shared-ui-pack` markers in the config/render blocks.
;; ============================================================================
orbital HolidayRunnerBoardOrbital {
  uses AnimTick from "std/behaviors/std-anim-tick"

  type HolidayRunnerBoardError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type Asset = {
      url : asset
      role : string
      category : string
      animations : [string]
      style : string
      variant : string
      dimension : string
      aspect : string
      name : string
      thumbnailUrl : string
    }
  type HolidayRunnerBoardTilesItem = {
    id : string
    x : number!
    y : number!
    terrain : string
    type : string
    terrainSprite : Asset
    passable : boolean
    movementCost : number
    tileType : string
    elevation : number
  }
  type HolidayRunnerBoardUnitsItem = {
    id : string!
    position : HolidayRunnerBoardUnitsItemPosition
    x : number
    y : number
    sprite : Asset
    unitType : string
    name : string
    team : "player" | "enemy" | "neutral"
    health : number
    maxHealth : number
    animation : string
    frame : number
  }
  type HolidayRunnerBoardUnitsItemPosition = {
    x : number!
    y : number!
  }
  type HolidayRunnerBoardFeaturesItem = {
    id : string
    x : number!
    y : number!
    type : string!
    sprite : Asset
    color : string
  }
  type HolidayRunnerBoardEffectItem = {
    key : string!
    x : number!
    y : number!
    ttl : number!
  }
  type HolidayRunnerBoardAssetManifest = {
    terrains : Map string Asset
    units : Map string Asset
    features : Map string Asset
    effects : Map string Asset
  }

  entity HolidayRunnerBoardItem [runtime, shared] {
    id : string!
    units : [HolidayRunnerBoardUnitsItem]
    distance : number = 0
    score : number = 0
    result : string = ""
    effects : [HolidayRunnerBoardEffectItem] = []
    selectedUnitId : string = ""
    validMoves : [HolidayRunnerBoardUnitsItemPosition] = []
    animCounter : number = 0
    frameName : string = "alienBeige_walk1.png"
  }

  trait HolidayRunnerBoardRender -> @rebindable HolidayRunnerBoardItem [interaction, instance] {
    initial: running

    state running {
      INIT -> running
        (set @entity.units @config.units)
        (set @entity.distance 0)
        (set @entity.score 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (set @entity.selectedUnitId "")
        (set @entity.validMoves [])
        ;; TODO: shared-ui-pack — game-shell background/hud/icon assets still use kenney-platformer-assets-base/ui (no SVG chrome generated for this board)
        (render-ui main {
          type: game-shell, backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }, hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" },
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [
            { type: game-hud, stats: [ { label: "Distance", value: @entity.distance, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_coins.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-distance", thumbnailUrl: "" } }, { label: "Score", value: @entity.score, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_gem_yellow.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } } ] },
            { type: score-display, value: @entity.score, label: "Score" },
            { type: timer-display, value: @entity.distance, label: "Distance" },
            { type: button, action: JUMP, label: "Jump", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_keyGreen.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-jump", thumbnailUrl: "" }, variant: primary }
          ] }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, keyMap: { Space: "JUMP", ArrowUp: "JUMP", KeyW: "JUMP" }, backgroundImage: @config.backgroundImage, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f sprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitAsset (object/get @u sprite)) (unitUrl (object/get @unitAsset url)) (unitAnim (object/get @u animation)) (unitFrame (if (== @unitAnim "walk") (% @entity.animCounter 2) (if (== @unitAnim "idle") (% (math/floor (/ @entity.animCounter 3)) 4) 0)))) (if (and @unitUrl (str/includes @unitUrl ".svg")) (object/merge @unitAsset { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat "." (str/concat @unitAnim (str/concat "-" (str/concat @unitFrame ".svg"))))) }) @unitAsset)), id: (object/get @u id) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), anchor: "center", offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })

      TILE_CLICK -> running
        (set @entity.selectedUnitId "")
        (render-ui main {
          type: game-shell, backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }, hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" },
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [
            { type: game-hud, stats: [ { label: "Distance", value: @entity.distance, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_coins.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-distance", thumbnailUrl: "" } }, { label: "Score", value: @entity.score, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_gem_yellow.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } } ] },
            { type: score-display, value: @entity.score, label: "Score" },
            { type: timer-display, value: @entity.distance, label: "Distance" },
            { type: button, action: JUMP, label: "Jump", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_keyGreen.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-jump", thumbnailUrl: "" }, variant: primary }
          ] }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, keyMap: { Space: "JUMP", ArrowUp: "JUMP", KeyW: "JUMP" }, backgroundImage: @config.backgroundImage, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f sprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitAsset (object/get @u sprite)) (unitUrl (object/get @unitAsset url)) (unitAnim (object/get @u animation)) (unitFrame (if (== @unitAnim "walk") (% @entity.animCounter 2) (if (== @unitAnim "idle") (% (math/floor (/ @entity.animCounter 3)) 4) 0)))) (if (and @unitUrl (str/includes @unitUrl ".svg")) (object/merge @unitAsset { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat "." (str/concat @unitAnim (str/concat "-" (str/concat @unitFrame ".svg"))))) }) @unitAsset)), id: (object/get @u id) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), anchor: "center", offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })

      UNIT_CLICK -> running
        (set @entity.selectedUnitId ?unitId)
        (set @entity.validMoves [])
        ;; TODO: shared-ui-pack — game-shell background/hud/icon assets still use kenney-platformer-assets-base/ui (no SVG chrome generated for this board)
        (render-ui main {
          type: game-shell, backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }, hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" },
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [
            { type: game-hud, stats: [ { label: "Distance", value: @entity.distance, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_coins.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-distance", thumbnailUrl: "" } }, { label: "Score", value: @entity.score, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_gem_yellow.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } } ] },
            { type: score-display, value: @entity.score, label: "Score" },
            { type: timer-display, value: @entity.distance, label: "Distance" },
            { type: button, action: JUMP, label: "Jump", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_keyGreen.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-jump", thumbnailUrl: "" }, variant: primary }
          ] }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, keyMap: { Space: "JUMP", ArrowUp: "JUMP", KeyW: "JUMP" }, backgroundImage: @config.backgroundImage, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f sprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitAsset (object/get @u sprite)) (unitUrl (object/get @unitAsset url)) (unitAnim (object/get @u animation)) (unitFrame (if (== @unitAnim "walk") (% @entity.animCounter 2) (if (== @unitAnim "idle") (% (math/floor (/ @entity.animCounter 3)) 4) 0)))) (if (and @unitUrl (str/includes @unitUrl ".svg")) (object/merge @unitAsset { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat "." (str/concat @unitAnim (str/concat "-" (str/concat @unitFrame ".svg"))))) }) @unitAsset)), id: (object/get @u id) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), anchor: "center", offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })

      JUMP -> running when (== @entity.result "none")
        (set @entity.units (array/map @entity.units (fn u (if (== @u.unitType "runner") (object/merge @u { animation: "attack" }) @u))))
        (render-ui main {
          type: game-shell, backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }, hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" },
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [
            { type: game-hud, stats: [ { label: "Distance", value: @entity.distance, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_coins.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-distance", thumbnailUrl: "" } }, { label: "Score", value: @entity.score, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_gem_yellow.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } } ] },
            { type: score-display, value: @entity.score, label: "Score" },
            { type: timer-display, value: @entity.distance, label: "Distance" },
            { type: button, action: JUMP, label: "Jump", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_keyGreen.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-jump", thumbnailUrl: "" }, variant: primary }
          ] }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, keyMap: { Space: "JUMP", ArrowUp: "JUMP", KeyW: "JUMP" }, backgroundImage: @config.backgroundImage, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f sprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitAsset (object/get @u sprite)) (unitUrl (object/get @unitAsset url)) (unitAnim (object/get @u animation)) (unitFrame (if (== @unitAnim "walk") (% @entity.animCounter 2) (if (== @unitAnim "idle") (% (math/floor (/ @entity.animCounter 3)) 4) 0)))) (if (and @unitUrl (str/includes @unitUrl ".svg")) (object/merge @unitAsset { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat "." (str/concat @unitAnim (str/concat "-" (str/concat @unitFrame ".svg"))))) }) @unitAsset)), id: (object/get @u id) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), anchor: "center", offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })
    }

    ticks {
      renderTick every 100ms
        (set @entity.effects (array/filter (array/map @entity.effects (fn e (object/merge @e { ttl: (- (object/get @e ttl) 1) }))) (fn e (> (object/get @e ttl) 0))))
        (set @entity.distance (+ @entity.distance 1))
        (render-ui main {
          type: game-shell, backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }, hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_p1.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" },
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [
            { type: game-hud, stats: [ { label: "Distance", value: @entity.distance, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_coins.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-distance", thumbnailUrl: "" } }, { label: "Score", value: @entity.score, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_gem_yellow.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } } ] },
            { type: score-display, value: @entity.score, label: "Score" },
            { type: timer-display, value: @entity.distance, label: "Distance" },
            { type: button, action: JUMP, label: "Jump", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-platformer-assets-base/ui/hud_sheet.json", sprite: "hud_keyGreen.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-jump", thumbnailUrl: "" }, variant: primary }
          ] }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, keyMap: { Space: "JUMP", ArrowUp: "JUMP", KeyW: "JUMP" }, backgroundImage: @config.backgroundImage, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f sprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitAsset (object/get @u sprite)) (unitUrl (object/get @unitAsset url)) (unitAnim (object/get @u animation)) (unitFrame (if (== @unitAnim "walk") (% @entity.animCounter 2) (if (== @unitAnim "idle") (% (math/floor (/ @entity.animCounter 3)) 4) 0)))) (if (and @unitUrl (str/includes @unitUrl ".svg")) (object/merge @unitAsset { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat "." (str/concat @unitAnim (str/concat "-" (str/concat @unitFrame ".svg"))))) }) @unitAsset)), id: (object/get @u id) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), anchor: "center", offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), anchor: "center", offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })
    }

    emits {
      TILE_CLICK -> external {
        x : number!
        y : number!
      }
        @description "Declarative event: emits UI:{tileClickEvent} with { x, y } on tile click"
        @tier "domain"
      UNIT_CLICK -> external {
        unitId : string!
      }
        @description "Declarative event: emits UI:{unitClickEvent} with { unitId } on unit click"
        @tier "domain"
      JUMP -> external {
        id : string
      }
        @description "Jump input — tap/click to jump over obstacles"
        @tier "domain"
    }

    config {
      className : string = ""
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : HolidayRunnerBoardError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      tiles : [HolidayRunnerBoardTilesItem] = [{ x: 0, y: 0, terrain: "sky", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" } }, { x: 1, y: 0, terrain: "sky", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" } }, { x: 2, y: 0, terrain: "sky", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" } }, { x: 3, y: 0, terrain: "sky", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" } }, { x: 4, y: 0, terrain: "sky", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" } }, { x: 5, y: 0, terrain: "sky", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" } }, { x: 6, y: 0, terrain: "sky", passable: false, terr