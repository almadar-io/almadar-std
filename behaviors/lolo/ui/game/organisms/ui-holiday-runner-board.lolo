        @label "Tiles"
        @description "Side-scroll strip: rows 0–1 sky, rows 2–3 snow ground"
        @tier "presentation"
      units : [HolidayRunnerBoardUnitsItem] = [{ id: "runner1", position: { x: 1, y: 2 }, unitType: "runner", name: "Holiday Runner", team: player, health: 3, maxHealth: 3, sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/units/runner.svg", role: "npc", category: "runner", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "runner", thumbnailUrl: "" }, animation: "walk", frame: 0 }, { id: "obs1", position: { x: 4, y: 2 }, unitType: "obstacle", name: "Obstacle", team: neutral, health: 1, maxHealth: 1, sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/units/obstacle.svg", role: "npc", category: "obstacle", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "obstacle", thumbnailUrl: "" }, animation: "idle", frame: 0 }, { id: "obs2", position: { x: 6, y: 2 }, unitType: "obstacle", name: "Obstacle", team: neutral, health: 1, maxHealth: 1, sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/units/obstacle.svg", role: "npc", category: "obstacle", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "obstacle", thumbnailUrl: "" }, animation: "idle", frame: 0 }]
        @label "Units"
        @description "Runner (animation:walk) plus obstacles on the ground row"
        @tier "presentation"
      features : [HolidayRunnerBoardFeaturesItem] = []
        @label "Features"
        @description "Static features on the board"
        @tier "presentation"
      assetManifest : HolidayRunnerBoardAssetManifest = { terrains: { sky: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/sky.svg", role: "tile", category: "sky", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "sky", thumbnailUrl: "" }, ground: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/terrain/ground.svg", role: "tile", category: "ground", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "ground", thumbnailUrl: "" } }, units: { runner: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/units/runner.svg", role: "npc", category: "runner", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "runner", thumbnailUrl: "" }, obstacle: { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/svg/flat/units/obstacle.svg", role: "npc", category: "obstacle", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "obstacle", thumbnailUrl: "" } }, features: {}, effects: {} }
        @label "Asset Manifest"
        @description "Asset sprite manifest"
        @tier "presentation"
      backgroundImage : Asset = { url: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-tappy-plane/backgrounds/sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-holiday-runner-board/kenney-tappy-plane/backgrounds/sheet.json", sprite: "background.png", role: "decoration", category: "background", animations: ["static"], style: "pixel", variant: "", dimension: "2d", aspect: "16:9", name: "winter", thumbnailUrl: "" } ;; TODO: shared-ui-pack — no flat/backgrounds/winter.svg generated
        @label "Background Image"
        @description "Scrolling winter background"
        @tier "presentation"
      scale : number = 0.45
        @label "Scale"
        @description "Render scale"
        @tier "presentation"
    }
  }

  trait AnimClock = AnimTick.traits.AnimTick -> HolidayRunnerBoardItem {
    config {
      frames: ["alienBeige_walk1.png", "alienBeige_walk2.png"]
    }
  }

  page "/holiday-runner-board" as HolidayRunnerBoardPage -> HolidayRunnerBoardRender, AnimClock
}
