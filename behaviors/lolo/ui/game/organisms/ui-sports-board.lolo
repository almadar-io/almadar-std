            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })
    }

    emits {
      TILE_CLICK -> external {
        x : number!
        y : number!
      }
        @description "Emits UI:{tileClickEvent} with { x, y } on tile click"
        @tier "domain"
      UNIT_CLICK -> external {
        unitId : string!
      }
        @description "Emits UI:{unitClickEvent} with { unitId } on unit click"
        @tier "domain"
      GOAL -> external {
        team : string!
      }
        @description "Fired when a goal is scored; team is 'player' or 'enemy'"
        @tier "domain"
      RESET -> external {
        id : string
      }
        @description "Resets the match to initial state"
        @tier "domain"
    }

    config {
      className : string = ""
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : SportsBoardError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      tiles : [SportsBoardTilesItem] = [{ x: 0, y: 0, terrain: "court", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sports-board/svg/flat/terrain/court.svg", role: "tile", category: "court", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "court", thumbnailUrl: "" } }, { x: 1, y: 0, terrain: "court", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sports-board/svg/flat/terrain/court.svg", role: "tile", category: "court", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "court", thumbnailUrl: "" } }, { x: 2, y: 0, terrain: "court", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sports-board/svg/flat/terrain/court.svg", role: "tile", category: "court", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "court", thumbnailUrl: "" } }, { x: 3, y: 0, terrain: "court", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sports-board/svg/flat/terrain/court.svg", role: "tile", category: "court", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "court", thumbnailUrl: "" } }, { x: 4, y: 0, terrain: "court", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sports-board/svg/flat/terrain/court.svg", role: "tile", category: "court", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "court", thumbnailUrl: "" } }, { x: 5, y: 0, terrain: "court", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sports-board/svg/flat/terrain/court.svg", role: "tile", category: "court", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "court", thumbnailUrl: "" } }, { x: 6, y: 0, terrain: "court", passable: true, terrainSprite: {