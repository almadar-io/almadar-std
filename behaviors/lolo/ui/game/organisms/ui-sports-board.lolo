app ui-sports-board "1.0.0"
"SportsBoard — top-down soccer/sports game: select units, move them to tiles, score goals. game-shell + canvas-2d with live input wiring (TILE_CLICK/UNIT_CLICK + selectedUnitId/validMoves) and a RESET HUD control."
;; @capabilities "top-down soccer, unit selection, tile movement, goal scoring, reset control"

;; ============================================================================
;; PERSONA + USER STORIES
;;
;; Read these before changing anything here, and walk them end to end after.
;; ============================================================================
;;
;; Persona: A casual player who wants a quick top-down soccer match: pick a
;; green home player, move into space, and score in the opponent's goal.
;; Stories:
;; 1. I open the board and see the pitch, both goals, the ball, both teams,
;;    and a HUD showing Home/Away scores plus the current phase. WORKS.
;; 2. I click one of my green players; a selection ring appears and reachable
;;    empty cells highlight green. WORKS.
;; 3. I click a highlighted cell and my player walks there, then is marked
;;    spent and cannot be moved again until the match is reset. WORKS.
;; 4. I move a green player onto the opponent's goal tile and score for the
;;    home team; the HUD updates. WORKS.
;; 5. I try to select a spent player and nothing happens; spent players are
;;    dimmed on the canvas. WORKS.
;; 6. I click Reset and the match returns to kickoff — scores zeroed, players
;;    back in formation, no one spent. WORKS.
;; 7. I move a blue player into my own goal, conceding a goal to the away
;;    team; this is the lose path for the home side. WORKS.
;; 8. I click the currently selected player again and the selection clears,
;;    removing the highlights. WORKS.
;; 9. I click a tile outside the highlighted move range and the selected
;;    player does not move. WORKS.
;; 10. The players idle-animate on the pitch so the board feels alive. WORKS.
;;
;; ASSET INVENTORY (hand-authored svg, almadar-kflow-assets.web.app
;; /shared/ui-sports-board/svg/flat/)
;;   Terrain   terrain/court.svg full-cell flat tiles.
;;   Units     units/{characterGreen,characterBlue}.svg + animation frames
;;             .{idle-0..3, walk-0..1, attack-0, hit-0, death-0}.svg.
;;   Features  features/{goal,ball}.svg static sprites.
;;   UI chrome TODO: shared-ui-pack — still uses kenney-ui-pack / kenney-mobile-controls
;;             chrome assets; do not create new _shared assets.
;; ============================================================================
orbital SportsBoardOrbital {
  type SportsBoardError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type Asset = {
      url : asset
      role : string
      category : string
      animations : [string]
      style : string
      variant : string
      dimension : string
      aspect : string
      name : string
      thumbnailUrl : string
    }
  type SportsBoardTilesItem = {
    id : string
    x : number!
    y : number!
    z : number
    terrain : string
    type : string
    terrainSprite : Asset
    passable : boolean
    movementCost : number
    tileType : string
    elevation : number
    modelUrl : Asset
  }
  type SportsBoardUnitsItem = {
    id : string!
    position : SportsBoardUnitsItemPosition
    x : number
    y : number
    z : number
    sprite : Asset
    spriteSheet : Asset
    modelUrl : Asset
    unitType : string
    heroId : string
    name : string
    team : "player" | "enemy" | "neutral"
    faction : "player" | "enemy" | "neutral"
    health : number
    maxHealth : number
    traits : [SportsBoardUnitsItemTraitsItem]
    previousPosition : SportsBoardUnitsItemPreviousPosition
    elevation : number
    animation : string
    frame : number
  }
  type SportsBoardEffectItem = {
    key : string!
    x : number!
    y : number!
    ttl : number!
  }
  type SportsBoardUnitsItemPosition = {
    x : number!
    y : number!
  }
  type SportsBoardUnitsItemTraitsItem = {
    name : string!
    currentState : string!
    states : [string]!
    cooldown : number!
  }
  type SportsBoardUnitsItemPreviousPosition = {
    x : number!
    y : number!
  }
  type SportsBoardFeaturesItem = {
    id : string
    x : number!
    y : number!
    z : number
    type : string!
    sprite : Asset
    assetUrl : Asset
    color : string
    elevation : number
  }
  type SportsBoardAssetManifest = {
    terrains : Map string Asset
    units : Map string Asset
    features : Map string Asset
    effects : Map string Asset
  }

  entity SportsBoardItem [runtime] {
    id : string!
    units : [SportsBoardUnitsItem]
    selectedUnitId : string = ""
    validMoves : [SportsBoardUnitsItemPosition] = []
    homeScore : number = 0
    awayScore : number = 0
    phase : string = "kickoff"
    effects : [SportsBoardEffectItem] = []
    movedIds : [string] = []
    actedIds : [string] = []
    animCounter : number = 0
  }

  trait SportsBoardRender -> @rebindable SportsBoardItem [interaction, instance] {
    initial: playing

    state playing {
      INIT -> playing
        (set @entity.units @config.units)
        (set @entity.selectedUnitId "")
        (set @entity.validMoves [])
        (set @entity.homeScore 0)
        (set @entity.awayScore 0)
        (set @entity.phase "kickoff")
        (set @entity.effects [])
        (set @entity.movedIds [])
        (set @entity.actedIds [])
        (set @entity.animCounter 0)
        (render-ui main {
          type: game-shell
          backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [ { type: game-hud, stats: [ { label: "Home", value: @entity.homeScore, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_button_a", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-home", thumbnailUrl: "" } }, { label: "Away", value: @entity.awayScore, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_button_b", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-away", thumbnailUrl: "" } } ] }, { type: game-icon, label: "Phase", value: @entity.phase, format: "text", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_cog", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-phase", thumbnailUrl: "" } }, { type: button, action: RESET, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: secondary } ] }
          children: [ { type: canvas, fit: true, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f assetUrl) })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/filter (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u previousPosition), asset: (object/get @u sprite), opacity: 0.25 })) (fn s (object/get @s position))) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitUrl (object/get (object/get @u sprite) url))) (object/merge (object/get @u sprite) { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat ".idle-" (str/concat (% (math/floor (/ @entity.animCounter 3)) 4) ".svg"))) })), id: (object/get @u id), anchor: "ground", width: 0.5, height: 0.5, opacity: (if (> (array/len (array/filter @entity.movedIds (fn mid (== @mid (object/get @u id))))) 0) 0.45 1) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })

      UNIT_CLICK -> playing when (== @entity.selectedUnitId ?unitId)
        (set @entity.selectedUnitId "")
        (set @entity.validMoves [])
        (set @entity.phase "kickoff")
        (render-ui main {
          type: game-shell
          backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [ { type: game-hud, stats: [ { label: "Home", value: @entity.homeScore, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_button_a", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-home", thumbnailUrl: "" } }, { label: "Away", value: @entity.awayScore, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_button_b", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-away", thumbnailUrl: "" } } ] }, { type: game-icon, label: "Phase", value: @entity.phase, format: "text", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_cog", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-phase", thumbnailUrl: "" } }, { type: button, action: RESET, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: secondary } ] }
          children: [ { type: canvas, fit: true, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f assetUrl) })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/filter (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u previousPosition), asset: (object/get @u sprite), opacity: 0.25 })) (fn s (object/get @s position))) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitUrl (object/get (object/get @u sprite) url))) (object/merge (object/get @u sprite) { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat ".idle-" (str/concat (% (math/floor (/ @entity.animCounter 3)) 4) ".svg"))) })), id: (object/get @u id), anchor: "ground", width: 0.5, height: 0.5, opacity: (if (> (array/len (array/filter @entity.movedIds (fn mid (== @mid (object/get @u id))))) 0) 0.45 1) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })

      UNIT_CLICK -> playing when (and (== (array/len (array/filter @entity.movedIds (fn mid (== @mid ?unitId)))) 0) (== (array/len (array/filter @entity.actedIds (fn aid (== @aid ?unitId)))) 0))
        (set @entity.selectedUnitId ?unitId)
        (set @entity.validMoves [])
        (set @entity.phase "selected")
        (render-ui main {
          type: game-shell
          backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: stack, direction: horizontal, gap: md, justify: between, children: [ { type: game-hud, stats: [ { label: "Home", value: @entity.homeScore, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_button_a", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-home", thumbnailUrl: "" } }, { label: "Away", value: @entity.awayScore, iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_button_b", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-away", thumbnailUrl: "" } } ] }, { type: game-icon, label: "Phase", value: @entity.phase, format: "text", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_cog", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-phase", thumbnailUrl: "" } }, { type: button, action: RESET, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: secondary } ] }
          children: [ { type: canvas, fit: true, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, tileClickEvent: TILE_CLICK, unitClickEvent: UNIT_CLICK, children: [
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.features (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get @f assetUrl) })) }
            { type: draw-shape-layer, items: (array/map @entity.validMoves (fn m { type: draw-shape, shape: "cell", position: { x: (object/get @m x), y: (object/get @m y) }, fill: "rgba(74,222,128,0.4)" })) }
            { type: draw-shape-layer, items: (array/map (array/filter @entity.units (fn u (== (object/get @u id) @entity.selectedUnitId))) (fn u { type: draw-shape, shape: "ellipse", position: (object/get @u position), radiusX: 0.5, radiusY: 0.2, stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
            { type: draw-sprite-layer, items: (array/filter (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u previousPosition), asset: (object/get @u sprite), opacity: 0.25 })) (fn s (object/get @s position))) }
            { type: draw-sprite-layer, items: (array/map @entity.units (fn u { type: draw-sprite, position: (object/get @u position), asset: (let ((unitUrl (object/get (object/get @u sprite) url))) (object/merge (object/get @u sprite) { url: (str/concat (array/nth (str/split @unitUrl ".svg") 0) (str/concat ".idle-" (str/concat (% (math/floor (/ @entity.animCounter 3)) 4) ".svg"))) })), id: (object/get @u id), anchor: "ground", width: 0.5, height: 0.5, opacity: (if (> (array/len (array/filter @entity.movedIds (fn mid (== @mid (object/get @u id))))) 0) 0.45 1) })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: 0.8, height: 0.12, fill: "rgba(0,0,0,0.6)" })) }
            { type: draw-shape-layer, items: (array/map @entity.units (fn u { type: draw-shape, shape: "rect", position: (object/get @u position), offsetY: -0.6, width: (* 0.8 (/ (object/get @u health) (object/get @u maxHealth))), height: 0.12, fill: "#22c55e" })) }
            { type: draw-text-layer, items: (array/map @entity.units (fn u { type: draw-text, text: (object/get @u name), position: (object/get @u position), offsetY: -0.85, color: "#ffffff" })) }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
          ] } ]
        })

      TILE_CLICK -> playing when (and (!= @entity.selectedUnitId "") (== (array/len (array/filter @entity.movedIds (fn mid (== @mid @entity.selectedUnitId)))) 0))
        (set @entity.units (array/map @entity.units (fn u (if (== @u.id @entity.selectedUnitId) (object/merge @u { position: { x: ?x, y: ?y }, animation: "walk" }) @u))))
        (set @entity.movedIds (array/append @entity.movedIds @entity.selectedUnitId))
        (set @entity.selectedUnitId "")
        (set @entity.validMoves [])
        (set @entity.phase "kickoff")
        (render-ui main {
          type: game-shell
          backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-pack/ui/greySheet.json", sprite: "grey_panel.png", role: "ui", category: "ui", animations: [], style: "generic", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
