app ui-match-puzzle-board "2.0.0"
"MatchPuzzleBoard — real match-3: swap adjacent gems, clear runs of 3+, gravity refills the 5x5 grid."
;; @capabilities "match-3 gem swapping, run clearing, gravity grid refill, 5x5 puzzle grid"
;; ============================================================================
;; PERSONA + USER STORIES
;;
;; Genre: a casual match-3 board — swap adjacent gems to make runs of 3+,
;; clear them, let gravity refill the 5x5 grid, and score before moves run out.
;;
;; Persona
;;   A casual puzzle player who wants quick, satisfying matches, visible combo
;;   growth, and a clear end-state (win by target score or lose by running out
;;   of moves).
;;
;; Stories
;;   1. I open the board and see a 5x5 grid of colored gems with a Score,
;;      Moves, and Combo HUD.
;;        WORKS. The canvas renders tile sprites and gem sprites; game-hud
;;        shows the three stats as text.
;;   2. I tap a gem to select it; a highlight appears on its cell.
;;        WORKS. UNIT_CLICK sets selectedGemId and the selection layer draws
;;        a cell-sized rect behind the gem.
;;   3. I tap an adjacent gem to swap them; if the swap creates a run of 3+,
;;      the matched gems disappear, score rises, combo increments, and moves
;;      decrease by one.
;;        WORKS. The guarded UNIT_CLICK swap arm computes matches after the
;;        swap, filters matched gems, updates score/combo/moves, and spawns
;;        spark effects.
;;   4. After a match, gems above fall and new random gems spawn from the top
;;      until the board refills; cascades continue automatically.
;;        WORKS. settleTick runs every 200ms, applies gravity, spawns missing
;;        top-row gems, and clears new matches when settled.
;;   5. I build a combo by chaining matches across multiple ticks; the combo
;;      counter resets after a settled board with no new matches.
;;        WORKS. combo increments on a match and resets to 0 once settled and
;;        no matches remain.
;;   6. I reach a target score and the board declares a win with a Play Again
;;      overlay.
;;        BROKEN. The organism has no target-score win condition; the only
;;        end-state is running out of moves (see STD-MATCH-PUZZLE-WIN-PATH).
;;   7. I use all 20 moves without reaching the target score and the board
;;      shows an out-of-moves overlay.
;;        WORKS. After a match when moves <= 0, result becomes "over" and
;;        GAME_END triggers the "OUT OF MOVES" overlay.
;;   8. I tap a non-adjacent gem while one is selected; the selection moves to
;;      the new gem instead of swapping.
;;        WORKS. The swap guard requires manhattan-distance 1; a click outside
;;        that range falls through to the select arm.
;;   9. I try to swap two adjacent gems that do not create a run; nothing is
;;      removed and no move is spent.
;;        WORKS. The swap arm only mutates gems when matched length > 0.
;;  10. I click Restart at any time and the board resets to the authored 5x5
;;      layout with score/moves/combo zeroed.
;;        WORKS. PLAY_AGAIN reinitializes entity fields from config and
;;        returns to the playing state.
;; ============================================================================
orbital MatchPuzzleBoardOrbital {
  type Asset = {
      url : asset
      atlas : asset
      sprite : string
      role : string
      category : string
      animations : [string]
      style : string
      variant : string
      dimension : string
      aspect : string
      name : string
      thumbnailUrl : string
    }
  type MatchPuzzleGemItem = {
    id : string!
    x : number!
    y : number!
    color : string!
  }
  type MatchPuzzleBoardTilesItem = {
    id : string
    x : number!
    y : number!
    terrain : string
    terrainSprite : Asset
    passable : boolean
    tileType : string
  }
  type MatchPuzzleEffectItem = {
    key : string!
    x : number!
    y : number!
    ttl : number!
  }
  type MatchPuzzleBoardAssetManifest = {
    terrains : Map string Asset
    units : Map string Asset
    features : Map string Asset
    effects : Map string Asset
  }

  entity MatchPuzzleBoardItem [runtime] {
    id : string!
    gems : [MatchPuzzleGemItem] = []
    selectedGemId : string = ""
    score : number = 0
    moves : number = 20
    combo : number = 0
    result : "none" | "over" = none
    effects : [MatchPuzzleEffectItem] = []
    tick : number = 0
  }

  trait MatchPuzzleBoardRender -> @rebindable MatchPuzzleBoardItem [interaction, instance] {
    initial: playing

    state playing {
      INIT -> playing
        (set @entity.gems @config.gems)
        (set @entity.selectedGemId "")
        (set @entity.score 0)
        (set @entity.moves 20)
        (set @entity.combo 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (set @entity.tick 0)
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })

      UNIT_CLICK -> playing when (let ((sel (array/find @entity.gems (fn g (== @g.id @entity.selectedGemId))))) (let ((clk (array/find @entity.gems (fn g (== @g.id ?unitId))))) (and (== @entity.result "none") (and (> @entity.moves 0) (and (!= @entity.selectedGemId "") (and (!= @entity.selectedGemId ?unitId) (and (!= @sel null) (and (!= @clk null) (== (grid/manhattan-distance { x: @sel.x, y: @sel.y } { x: @clk.x, y: @clk.y }) 1)))))))))
        (let ((sel (array/find @entity.gems (fn g (== @g.id @entity.selectedGemId))))) (let ((clk (array/find @entity.gems (fn g (== @g.id ?unitId))))) (let ((swapped (array/map @entity.gems (fn g (if (== @g.id @entity.selectedGemId) (object/merge @g { x: @clk.x, y: @clk.y }) (if (== @g.id ?unitId) (object/merge @g { x: @sel.x, y: @sel.y }) @g)))))) (let ((matched (array/filter @swapped (fn g (let ((r1 (array/find @swapped (fn n (and (== @n.x (+ @g.x 1)) (== @n.y @g.y))))) (r2 (array/find @swapped (fn n (and (== @n.x (+ @g.x 2)) (== @n.y @g.y))))) (l1 (array/find @swapped (fn n (and (== @n.x (- @g.x 1)) (== @n.y @g.y))))) (l2 (array/find @swapped (fn n (and (== @n.x (- @g.x 2)) (== @n.y @g.y))))) (d1 (array/find @swapped (fn n (and (== @n.x @g.x) (== @n.y (+ @g.y 1)))))) (d2 (array/find @swapped (fn n (and (== @n.x @g.x) (== @n.y (+ @g.y 2)))))) (u1 (array/find @swapped (fn n (and (== @n.x @g.x) (== @n.y (- @g.y 1)))))) (u2 (array/find @swapped (fn n (and (== @n.x @g.x) (== @n.y (- @g.y 2))))))) (or (or (and (!= @r1 null) (and (!= @r2 null) (and (== @r1.color @g.color) (== @r2.color @g.color)))) (or (and (!= @l1 null) (and (!= @r1 null) (and (== @l1.color @g.color) (== @r1.color @g.color)))) (and (!= @l2 null) (and (!= @l1 null) (and (== @l2.color @g.color) (== @l1.color @g.color)))))) (or (and (!= @d1 null) (and (!= @d2 null) (and (== @d1.color @g.color) (== @d2.color @g.color)))) (or (and (!= @u1 null) (and (!= @d1 null) (and (== @u1.color @g.color) (== @d1.color @g.color)))) (and (!= @u2 null) (and (!= @u1 null) (and (== @u2.color @g.color) (== @u1.color @g.color)))))))))))) (let ((matchedIds (array/map @matched (fn g @g.id)))) (do (set @entity.gems (if (> (array/len @matched) 0) (array/filter @swapped (fn g (not (array/includes @matchedIds @g.id)))) @entity.gems)) (set @entity.score (if (> (array/len @matched) 0) (+ @entity.score (* 10 (array/len @matched))) @entity.score)) (set @entity.combo (if (> (array/len @matched) 0) (+ @entity.combo 1) 0)) (set @entity.effects (if (> (array/len @matched) 0) (array/concat @entity.effects (array/map @matched (fn g { key: "spark", x: @g.x, y: @g.y, ttl: 6 }))) @entity.effects)) (set @entity.moves (if (> (array/len @matched) 0) (- @entity.moves 1) @entity.moves)) (set @entity.selectedGemId "") (set @entity.result (if (<= @entity.moves 0) "over" @entity.result)) (if (== @entity.result "over") (emit GAME_END) true) 
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })))))))

      UNIT_CLICK -> playing
        (set @entity.selectedGemId ?unitId)
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })

      PLAY_AGAIN -> playing
        (set @entity.gems @config.gems)
        (set @entity.selectedGemId "")
        (set @entity.score 0)
        (set @entity.moves 20)
        (set @entity.combo 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (set @entity.tick 0)
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })

      GAME_END -> gameover
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          overlay: { type: game-menu, title: "OUT OF MOVES", subtitle: (str/concat "Final score: " @entity.score), options: [ { id: "again", label: "Play Again", event: "PLAY_AGAIN", variant: "primary" } ] }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })
    }

    state gameover {
      PLAY_AGAIN -> playing
        (set @entity.gems @config.gems)
        (set @entity.selectedGemId "")
        (set @entity.score 0)
        (set @entity.moves 20)
        (set @entity.combo 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (set @entity.tick 0)
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })
    }

    ticks {

      settleTick every 200ms when (== @entity.result "none")
        (let ((fallen (array/map @entity.gems (fn g (let ((below (array/find @entity.gems (fn n (and (== @n.x @g.x) (== @n.y (+ @g.y 1))))))) (if (and (< (+ @g.y 1) @config.gridHeight) (== @below null)) (object/merge @g { y: (+ @g.y 1) }) @g)))))) (let ((missingCols (array/filter @config.columns (fn cx (== (array/find @fallen (fn n (and (== @n.x @cx) (== @n.y 0)))) null))))) (let ((spawns (array/map @missingCols (fn cx { id: (str/concat "gs" (str/concat @entity.tick (str/concat "-" @cx))), x: @cx, y: 0, color: (array/nth @config.colors (math/floor (* (math/random) 5))) })))) (let ((merged (array/concat @fallen @spawns))) (let ((unsettled (array/filter @merged (fn g (and (< (+ @g.y 1) @config.gridHeight) (== (array/find @merged (fn n (and (== @n.x @g.x) (== @n.y (+ @g.y 1))))) null)))))) (let ((settled (and (== (array/len @unsettled) 0) (== (array/len @merged) 25)))) (let ((matched (if @settled (array/filter @merged (fn g (let ((r1 (array/find @merged (fn n (and (== @n.x (+ @g.x 1)) (== @n.y @g.y))))) (r2 (array/find @merged (fn n (and (== @n.x (+ @g.x 2)) (== @n.y @g.y))))) (l1 (array/find @merged (fn n (and (== @n.x (- @g.x 1)) (== @n.y @g.y))))) (l2 (array/find @merged (fn n (and (== @n.x (- @g.x 2)) (== @n.y @g.y))))) (d1 (array/find @merged (fn n (and (== @n.x @g.x) (== @n.y (+ @g.y 1)))))) (d2 (array/find @merged (fn n (and (== @n.x @g.x) (== @n.y (+ @g.y 2)))))) (u1 (array/find @merged (fn n (and (== @n.x @g.x) (== @n.y (- @g.y 1)))))) (u2 (array/find @merged (fn n (and (== @n.x @g.x) (== @n.y (- @g.y 2))))))) (or (or (and (!= @r1 null) (and (!= @r2 null) (and (== @r1.color @g.color) (== @r2.color @g.color)))) (or (and (!= @l1 null) (and (!= @r1 null) (and (== @l1.color @g.color) (== @r1.color @g.color)))) (and (!= @l2 null) (and (!= @l1 null) (and (== @l2.color @g.color) (== @l1.color @g.color)))))) (or (and (!= @d1 null) (and (!= @d2 null) (and (== @d1.color @g.color) (== @d2.color @g.color)))) (or (and (!= @u1 null) (and (!= @d1 null) (and (== @u1.color @g.color) (== @d1.color @g.color)))) (and (!= @u2 null) (and (!= @u1 null) (and (== @u2.color @g.color) (== @u1.color @g.color)))))))))) []))) (let ((matchedIds (array/map @matched (fn g @g.id)))) (do (set @entity.gems (if (> (array/len @matched) 0) (array/filter @merged (fn g (not (array/includes @matchedIds @g.id)))) @merged)) (set @entity.score (if (> (array/len @matched) 0) (+ @entity.score (* 10 (array/len @matched))) @entity.score)) (set @entity.combo (if (> (array/len @matched) 0) (+ @entity.combo 1) (if @settled 0 @entity.combo))) (set @entity.effects (if (> (array/len @matched) 0) (array/concat @entity.effects (array/map @matched (fn g { key: "spark", x: @g.x, y: @g.y, ttl: 6 }))) @entity.effects)) (set @entity.tick (+ @entity.tick 1)) 
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        }))))))))))

      animTick every 100ms when (== @entity.result "none")
        (set @entity.effects (array/filter (array/map @entity.effects (fn e (object/merge @e { ttl: (- @e.ttl 1) }))) (fn e (> @e.ttl 0))))
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          ;; TODO: shared-ui-pack
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Score", value: @entity.score, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-match-puzzle-board/svg/flat/units/gem_yellow.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-score", thumbnailUrl: "" } }, { label: "Moves", value: @entity.moves, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Combo", value: @entity.combo, format: "text",
            ;; TODO: shared-ui-pack
            iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-emote-pack/ui/pixel_style1.json", sprite: "emote_star.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-combo", thumbnailUrl: "" } } ] }
          ;; TODO: shared-ui-pack
          addons: { type: button, action: PLAY_AGAIN, label: "Restart", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-restart", thumbnailUrl: "" }, variant: secondary }
          children: [ { type: canvas, camera: { zoom: @config.scale }, projection: "flat", showMinimap: false, unitClickEvent: UNIT_CLICK, children: [
    { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, width: 1, height: 1, asset: (object/get @t terrainSprite) })) }
    { type: draw-shape-layer, items: (array/map (array/filter @entity.gems (fn g (== (object/get @g id) @entity.selectedGemId))) (fn g { type: draw-shape, shape: "rect", position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, fill: "rgba(0,200,255,0.15)", stroke: "rgba(0,200,255,0.8)", strokeWidth: 3 })) }
    { type: draw-sprite-layer, items: (array/map @entity.gems (fn g { type: draw-sprite, id: (object/get @g id), position: { x: (object/get @g x), y: (object/get @g y) }, width: 1, height: 1, asset: (if (!= @g.color "red") (if (!= @g.color "blue") (if (!= @g.color "green") (if (!= @g.color "yellow") (object/get (object/get @config.assetManifest units) gem_pink) (object/get (object/get @config.assetManifest units) gem_yellow)) (object/get (object/get @config.assetManifest units) gem_green)) (object/get (object/get @config.assetManifest units) gem_blue)) (object/get (object/get @config.assetManifest units) gem_red)) })) }
    { type: draw-sprite-layer, items: (array/map @entity.effects (fn e { type: draw-sprite, position: { x: (object/get @e x), y: (object/get @e y) }, width: 1, height: 1, asset: (object/get (object/get @config.assetManifest effects) (object/get @e key)) })) }
  ] } ]
        })
    }

    emits {
      UNIT_CLICK -> external {
        unitId : string!
      }
        @description "Emits UI:{unitClickEvent} with { unitId } when a gem is clicked"
        @tier "domain"
      PLAY_AGAIN -> external {
        id : string
      }
        @description "Resets gems, score, moves, and combo to the authored layout"
        @tier "domain"
      GAME_END -> external {
        result : string
      }
        @description "Emitted when moves reach zero (result over)"
        @tier "domain"
    }

