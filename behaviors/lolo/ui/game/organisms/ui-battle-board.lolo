  trait FxDecay = Frame.traits.FxDecay -> GameState {
    config { running: true }
  }

  trait RoundLogic = Frame.traits.RoundLogic -> GameState {
    config { running: true }
  }

  trait ScoreKeeper = Score.traits.ScoreKeeper -> GameState {
    config { running: true, pointsPerKill: 10, startScore: 0, initialEnemies: 4 }
  }

  trait XpKeeper = Xp.traits.XpProgression -> GameState {
    config { running: true, xpPerKill: 25, startXp: 0, baseXpToNext: 100, xpToNextIncrement: 50, levelUpHeal: 2, healTeam: "player", initialEnemies: 4 }
  }

  trait AnimClock = Frame.traits.AnimClock -> GameState {
    config { frames: [] }
  }

  trait Player = Frame.traits.PlayerIntent -> GameState {
    config {
      gridWidth: 16
      gridHeight: 16
      movementRange: 2
      projection: "isometric"
      showMinimap: true
      scale: 1
