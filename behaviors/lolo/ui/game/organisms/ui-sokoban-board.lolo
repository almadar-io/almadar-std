  { x: 5, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" }, tileType: "wall" },
