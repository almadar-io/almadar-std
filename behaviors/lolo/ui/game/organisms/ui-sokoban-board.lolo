  { x: 1, y: 1, terrain: "target", passable: true, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/terrain/target.svg", role: "tile", category: "target", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "target", thumbnailUrl: "" }, tileType: "target" },
