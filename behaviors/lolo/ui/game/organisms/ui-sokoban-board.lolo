        @description "Canvas render scale"
        @tier "presentation"
      player : SokobanBoardPos = { x: 3, y: 3 }
        @label "Pusher Start"
        @description "Pusher starting position"
        @tier "presentation"
      crates : [SokobanCrateItem] = [{ id: "c1", x: 2, y: 1 }, { id: "c2", x: 2, y: 3 }, { id: "c3", x: 2, y: 5 }]
        @label "Crates"
        @description "Crate starting positions"
        @tier "presentation"
      targets : [SokobanBoardPos] = [{ x: 1, y: 1 }, { x: 1, y: 3 }, { x: 1, y: 5 }]
        @label "Targets"
        @description "Target cells every crate must reach"
        @tier "presentation"
      tiles : [SokobanBoardTilesItem] = [
  { x: 0, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" }, tileType: "wall" },
  { x: 1, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" }, tileType: "wall" },
  { x: 2, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" }, tileType: "wall" },
  { x: 3, y: 0, terrain: "wall", passable: false, terrainSprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/terrain/wall.svg", role: "tile", category: "wall", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" }, tileType: "wall" },
