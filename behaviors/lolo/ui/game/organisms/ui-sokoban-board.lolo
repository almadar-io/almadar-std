app ui-sokoban-board "1.0.0"
"SokobanBoard — push every crate onto a diamond target: arrows/WASD or d-pad, authored solvable 7x7 warehouse."
;; @capabilities "crate pushing puzzle, target tiles, grid movement, authored solvable levels"

;; ============================================================================
;; PERSONA + USER STORIES
;;
;; Read these before changing anything here, and walk them end to end after.
;; Genre: classic crate-pushing puzzle. The player sees a warehouse grid, one
;; pusher, several crates, and matching target tiles. The core loop is a single
;; deterministic action — move one cell — which may push an adjacent crate when
;; the cell beyond the crate is free. The win condition is every crate on a
;; target; there is no combat, no turns, and no randomness.
;; ============================================================================
;;
;; PERSONA — A puzzle player who wants a clean, solvable sokoban level they can
;; finish with arrow keys or the on-screen d-pad, and restart instantly if they
;; get stuck.
;;
;;   1. I open the board and see the 7x7 warehouse, the pusher, the crates, and
;;      the three diamond targets.
;;        WORKS. Canvas renders terrain tiles, targets, crates, and pusher from
;;        the flat SVG asset tree on first paint.
;;   2. I press ArrowUp / KeyW or tap the d-pad up button and the pusher steps
;;      one cell north onto a floor tile.
;;        WORKS. MOVE_UP fires through keyMap and directionEvents; guard checks
;;      passable target cell and updates entity.player.
;;   3. I walk the pusher into a crate and it slides one cell in the same
;;      direction, landing on a free floor tile.
;;        WORKS. MOVE_* detects adjacent crate, checks beyond cell is passable
;;      and unoccupied, then updates both crate and player positions.
;;   4. I push the last crate onto its target and a "SOLVED!" overlay appears
;;      with my total move count.
;;        WORKS. boxesDone reaches target count → result "solved" → GAME_END
;;      transition renders the win overlay and emits GAME_END.
;;   5. I push a crate into a corner against two walls and can no longer move it
;;      onto any target; the board stays playable but unwinnable.
;;        WORKS. Movement rules still allow walking, but crate can no longer be
;;      pushed out of the corner; Reset is the recovery path.
;;   6. I try to push two adjacent crates in a line; neither moves because the
;;      beyond cell is occupied.
;;        WORKS. MOVE_* guard requires beyond-crate cell to be free of crates.
;;   7. I walk into a wall tile and nothing happens — no move counter increments.
;;        WORKS. MOVE_* guard checks target tile passable before moving player.
;;   8. I tap the Reset button in the middle of a game and the board returns to
;;      the authored starting positions with counters zeroed.
;;        WORKS. PLAY_AGAIN resets crates, player, moves, boxesDone, result, and
;;      effects, then re-renders the playing shell.
;;   9. After winning, I tap Play Again on the overlay and the game restarts.
;;        WORKS. PLAY_AGAIN in gameover state transitions back to playing and
;;      resets the entity.
;;  10. I try to move after the puzzle is solved; all MOVE_* events are ignored.
;;        WORKS. MOVE_* guards require result == "none".
;;  11. A crate that is already sitting on a target stays marked as done until
;;      the level is reset.
;;        WORKS. boxesDone is recomputed after every push; done crates render
;;      the crate_done asset.
;;
;; TODO: shared-ui-pack — hudBackgroundAsset, icon-moves, icon-reset, and the
;; four d-pad key assets still point at _shared/kenney-* packs; replace them
;; when the shared UI asset tree is generated.

orbital SokobanBoardOrbital {
  type SokobanBoardError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type Asset = {
      url : asset
      atlas : asset
      sprite : string
      role : string
      category : string
      animations : [string]
      style : string
      variant : string
      dimension : string
      aspect : string
      name : string
      thumbnailUrl : string
    }
  type SokobanBoardTilesItem = {
    id : string
    x : number!
    y : number!
    terrain : string
    terrainSprite : Asset
    passable : boolean
    tileType : string
  }
  type SokobanBoardPos = {
    x : number!
    y : number!
  }
  type SokobanCrateItem = {
    id : string!
    x : number!
    y : number!
  }
  type SokobanEffectItem = {
    key : string!
    x : number!
    y : number!
    ttl : number!
  }
  type SokobanBoardAssetManifest = {
    terrains : Map string Asset
    units : Map string Asset
    features : Map string Asset
    effects : Map string Asset
  }

  entity SokobanBoardItem [runtime] {
    id : string!
    player : SokobanBoardPos = { x: 3, y: 3 }
    crates : [SokobanCrateItem] = [{ id: "c1", x: 2, y: 1 }, { id: "c2", x: 2, y: 3 }, { id: "c3", x: 2, y: 5 }]
    moves : number = 0
    boxesDone : number = 0
    result : "none" | "solved" = none
    effects : [SokobanEffectItem] = []
  }

  trait SokobanBoardRender -> @rebindable SokobanBoardItem [interaction, instance] {
    initial: playing

    state playing {
      INIT -> playing
        (set @entity.crates @config.crates)
        (set @entity.player @config.player)
        (set @entity.moves 0)
        (set @entity.boxesDone 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Moves", value: @entity.moves, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Boxes", value: @entity.boxesDone, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/features/crate.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-boxes", thumbnailUrl: "" } } ] }
          addons: { type: button, action: PLAY_AGAIN, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: primary }
          controls: { type: control-grid, kind: "dpad", directionEvents: { up: "MOVE_UP", down: "MOVE_DOWN", left: "MOVE_LEFT", right: "MOVE_RIGHT" }, directionAssets: { up: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "30,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-up", thumbnailUrl: "" }, down: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "32,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-down", thumbnailUrl: "" }, left: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "33,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-left", thumbnailUrl: "" }, right: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "31,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-right", thumbnailUrl: "" } } }
          children: [ { type: canvas, camera: { zoom: (math/min 1 (/ 5 (+ 1 (math/max (array/max @config.tiles "x") (array/max @config.tiles "y"))))), pos: { x: (/ (+ (array/min @config.tiles "x") (array/max @config.tiles "x")) 2), y: (/ (+ (array/min @config.tiles "y") (array/max @config.tiles "y")) 2) } }, projection: "flat", showMinimap: false, keyMap: { ArrowUp: "MOVE_UP", KeyW: "MOVE_UP", ArrowDown: "MOVE_DOWN", KeyS: "MOVE_DOWN", ArrowLeft: "MOVE_LEFT", KeyA: "MOVE_LEFT", ArrowRight: "MOVE_RIGHT", KeyD: "MOVE_RIGHT" }, children: [
            { type: draw-shape-layer, items: (array/map @config.tiles (fn t { type: draw-shape, shape: "cell", position: { x: (object/get @t x), y: (object/get @t y) }, fill: "#5c94fc", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @entity.crates (fn c { type: draw-sprite, position: { x: (object/get @c x), y: (object/get @c y) }, asset: (if (!= (array/find @config.targets (fn t (and (== (object/get @t x) (object/get @c x)) (== (object/get @t y) (object/get @c y))))) null) (object/get (object/get @config.assetManifest features) crate_done) (object/get (object/get @config.assetManifest features) crate)), anchor: "center", width: 0.5, height: 0.5 })) }
            { type: draw-sprite-layer, items: [ { type: draw-sprite, position: { x: (object/get @entity.player x), y: (object/get @entity.player y) }, asset: (object/get (object/get @config.assetManifest units) pusher), anchor: "ground", width: 0.5, height: 0.5 } ] }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @f key)) })) }
          ] } ]
        })

      MOVE_UP -> playing when (== @entity.result "none")
        (let ((nx (object/get @entity.player x)) (ny (- (object/get @entity.player y) 1)) (bx (object/get @entity.player x)) (by (- (object/get @entity.player y) 2)))
          (let ((ntile (array/find @config.tiles (fn t (and (== (object/get @t x) @nx) (== (object/get @t y) @ny)))))
                (btile (array/find @config.tiles (fn t (and (== (object/get @t x) @bx) (== (object/get @t y) @by)))))
                (ncrate (array/find @entity.crates (fn c (and (== @c.x @nx) (== @c.y @ny)))))
                (bcrate (array/find @entity.crates (fn c (and (== @c.x @bx) (== @c.y @by))))))
            (if (!= @ncrate null)
              (if (and (and (!= @btile null) (== (object/get @btile passable) true)) (== @bcrate null))
                (do
                  (set @entity.crates (array/map @entity.crates (fn c (if (== @c.id (object/get @ncrate id)) (object/merge @c { x: @bx, y: @by }) @c))))
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1))
                  (set @entity.boxesDone (array/len (array/filter @entity.crates (fn c (!= (array/find @config.targets (fn t (and (== (object/get @t x) @c.x) (== (object/get @t y) @c.y)))) null)))))
                  (if (>= @entity.boxesDone (array/len @config.targets)) (do (set @entity.result "solved") (emit GAME_END)) true))
                true)
              (if (and (!= @ntile null) (== (object/get @ntile passable) true))
                (do
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1)))
                true))))

      MOVE_DOWN -> playing when (== @entity.result "none")
        (let ((nx (object/get @entity.player x)) (ny (+ (object/get @entity.player y) 1)) (bx (object/get @entity.player x)) (by (+ (object/get @entity.player y) 2)))
          (let ((ntile (array/find @config.tiles (fn t (and (== (object/get @t x) @nx) (== (object/get @t y) @ny)))))
                (btile (array/find @config.tiles (fn t (and (== (object/get @t x) @bx) (== (object/get @t y) @by)))))
                (ncrate (array/find @entity.crates (fn c (and (== @c.x @nx) (== @c.y @ny)))))
                (bcrate (array/find @entity.crates (fn c (and (== @c.x @bx) (== @c.y @by))))))
            (if (!= @ncrate null)
              (if (and (and (!= @btile null) (== (object/get @btile passable) true)) (== @bcrate null))
                (do
                  (set @entity.crates (array/map @entity.crates (fn c (if (== @c.id (object/get @ncrate id)) (object/merge @c { x: @bx, y: @by }) @c))))
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1))
                  (set @entity.boxesDone (array/len (array/filter @entity.crates (fn c (!= (array/find @config.targets (fn t (and (== (object/get @t x) @c.x) (== (object/get @t y) @c.y)))) null)))))
                  (if (>= @entity.boxesDone (array/len @config.targets)) (do (set @entity.result "solved") (emit GAME_END)) true))
                true)
              (if (and (!= @ntile null) (== (object/get @ntile passable) true))
                (do
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1)))
                true))))

      MOVE_LEFT -> playing when (== @entity.result "none")
        (let ((nx (- (object/get @entity.player x) 1)) (ny (object/get @entity.player y)) (bx (- (object/get @entity.player x) 2)) (by (object/get @entity.player y)))
          (let ((ntile (array/find @config.tiles (fn t (and (== (object/get @t x) @nx) (== (object/get @t y) @ny)))))
                (btile (array/find @config.tiles (fn t (and (== (object/get @t x) @bx) (== (object/get @t y) @by)))))
                (ncrate (array/find @entity.crates (fn c (and (== @c.x @nx) (== @c.y @ny)))))
                (bcrate (array/find @entity.crates (fn c (and (== @c.x @bx) (== @c.y @by))))))
            (if (!= @ncrate null)
              (if (and (and (!= @btile null) (== (object/get @btile passable) true)) (== @bcrate null))
                (do
                  (set @entity.crates (array/map @entity.crates (fn c (if (== @c.id (object/get @ncrate id)) (object/merge @c { x: @bx, y: @by }) @c))))
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1))
                  (set @entity.boxesDone (array/len (array/filter @entity.crates (fn c (!= (array/find @config.targets (fn t (and (== (object/get @t x) @c.x) (== (object/get @t y) @c.y)))) null)))))
                  (if (>= @entity.boxesDone (array/len @config.targets)) (do (set @entity.result "solved") (emit GAME_END)) true))
                true)
              (if (and (!= @ntile null) (== (object/get @ntile passable) true))
                (do
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1)))
                true))))

      MOVE_RIGHT -> playing when (== @entity.result "none")
        (let ((nx (+ (object/get @entity.player x) 1)) (ny (object/get @entity.player y)) (bx (+ (object/get @entity.player x) 2)) (by (object/get @entity.player y)))
          (let ((ntile (array/find @config.tiles (fn t (and (== (object/get @t x) @nx) (== (object/get @t y) @ny)))))
                (btile (array/find @config.tiles (fn t (and (== (object/get @t x) @bx) (== (object/get @t y) @by)))))
                (ncrate (array/find @entity.crates (fn c (and (== @c.x @nx) (== @c.y @ny)))))
                (bcrate (array/find @entity.crates (fn c (and (== @c.x @bx) (== @c.y @by))))))
            (if (!= @ncrate null)
              (if (and (and (!= @btile null) (== (object/get @btile passable) true)) (== @bcrate null))
                (do
                  (set @entity.crates (array/map @entity.crates (fn c (if (== @c.id (object/get @ncrate id)) (object/merge @c { x: @bx, y: @by }) @c))))
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1))
                  (set @entity.boxesDone (array/len (array/filter @entity.crates (fn c (!= (array/find @config.targets (fn t (and (== (object/get @t x) @c.x) (== (object/get @t y) @c.y)))) null)))))
                  (if (>= @entity.boxesDone (array/len @config.targets)) (do (set @entity.result "solved") (emit GAME_END)) true))
                true)
              (if (and (!= @ntile null) (== (object/get @ntile passable) true))
                (do
                  (set @entity.player { x: @nx, y: @ny })
                  (set @entity.moves (+ @entity.moves 1)))
                true))))

      PLAY_AGAIN -> playing
        (set @entity.crates @config.crates)
        (set @entity.player @config.player)
        (set @entity.moves 0)
        (set @entity.boxesDone 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Moves", value: @entity.moves, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Boxes", value: @entity.boxesDone, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/features/crate.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-boxes", thumbnailUrl: "" } } ] }
          addons: { type: button, action: PLAY_AGAIN, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: primary }
          controls: { type: control-grid, kind: "dpad", directionEvents: { up: "MOVE_UP", down: "MOVE_DOWN", left: "MOVE_LEFT", right: "MOVE_RIGHT" }, directionAssets: { up: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "30,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-up", thumbnailUrl: "" }, down: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "32,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-down", thumbnailUrl: "" }, left: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "33,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-left", thumbnailUrl: "" }, right: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "31,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-right", thumbnailUrl: "" } } }
          children: [ { type: canvas, camera: { zoom: (math/min 1 (/ 5 (+ 1 (math/max (array/max @config.tiles "x") (array/max @config.tiles "y"))))), pos: { x: (/ (+ (array/min @config.tiles "x") (array/max @config.tiles "x")) 2), y: (/ (+ (array/min @config.tiles "y") (array/max @config.tiles "y")) 2) } }, projection: "flat", showMinimap: false, keyMap: { ArrowUp: "MOVE_UP", KeyW: "MOVE_UP", ArrowDown: "MOVE_DOWN", KeyS: "MOVE_DOWN", ArrowLeft: "MOVE_LEFT", KeyA: "MOVE_LEFT", ArrowRight: "MOVE_RIGHT", KeyD: "MOVE_RIGHT" }, children: [
            { type: draw-shape-layer, items: (array/map @config.tiles (fn t { type: draw-shape, shape: "cell", position: { x: (object/get @t x), y: (object/get @t y) }, fill: "#5c94fc", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @entity.crates (fn c { type: draw-sprite, position: { x: (object/get @c x), y: (object/get @c y) }, asset: (if (!= (array/find @config.targets (fn t (and (== (object/get @t x) (object/get @c x)) (== (object/get @t y) (object/get @c y))))) null) (object/get (object/get @config.assetManifest features) crate_done) (object/get (object/get @config.assetManifest features) crate)), anchor: "center", width: 0.5, height: 0.5 })) }
            { type: draw-sprite-layer, items: [ { type: draw-sprite, position: { x: (object/get @entity.player x), y: (object/get @entity.player y) }, asset: (object/get (object/get @config.assetManifest units) pusher), anchor: "ground", width: 0.5, height: 0.5 } ] }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @f key)) })) }
          ] } ]
        })

      GAME_END -> gameover when (== @entity.result "solved")
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Moves", value: @entity.moves, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Boxes", value: @entity.boxesDone, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/features/crate.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-boxes", thumbnailUrl: "" } } ] }
          addons: { type: button, action: PLAY_AGAIN, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: primary }
          controls: { type: control-grid, kind: "dpad", directionEvents: { up: "MOVE_UP", down: "MOVE_DOWN", left: "MOVE_LEFT", right: "MOVE_RIGHT" }, directionAssets: { up: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "30,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-up", thumbnailUrl: "" }, down: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "32,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-down", thumbnailUrl: "" }, left: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "33,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-left", thumbnailUrl: "" }, right: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "31,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-right", thumbnailUrl: "" } } }
          overlay: { type: game-menu, title: "SOLVED!", subtitle: (str/concat "All crates home in " (str/concat @entity.moves " moves")), options: [ { id: "again", label: "Play Again", event: "PLAY_AGAIN", variant: "primary" } ] }
          children: [ { type: canvas, camera: { zoom: (math/min 1 (/ 5 (+ 1 (math/max (array/max @config.tiles "x") (array/max @config.tiles "y"))))), pos: { x: (/ (+ (array/min @config.tiles "x") (array/max @config.tiles "x")) 2), y: (/ (+ (array/min @config.tiles "y") (array/max @config.tiles "y")) 2) } }, projection: "flat", showMinimap: false, keyMap: { ArrowUp: "MOVE_UP", KeyW: "MOVE_UP", ArrowDown: "MOVE_DOWN", KeyS: "MOVE_DOWN", ArrowLeft: "MOVE_LEFT", KeyA: "MOVE_LEFT", ArrowRight: "MOVE_RIGHT", KeyD: "MOVE_RIGHT" }, children: [
            { type: draw-shape-layer, items: (array/map @config.tiles (fn t { type: draw-shape, shape: "cell", position: { x: (object/get @t x), y: (object/get @t y) }, fill: "#5c94fc", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @entity.crates (fn c { type: draw-sprite, position: { x: (object/get @c x), y: (object/get @c y) }, asset: (if (!= (array/find @config.targets (fn t (and (== (object/get @t x) (object/get @c x)) (== (object/get @t y) (object/get @c y))))) null) (object/get (object/get @config.assetManifest features) crate_done) (object/get (object/get @config.assetManifest features) crate)), anchor: "center", width: 0.5, height: 0.5 })) }
            { type: draw-sprite-layer, items: [ { type: draw-sprite, position: { x: (object/get @entity.player x), y: (object/get @entity.player y) }, asset: (object/get (object/get @config.assetManifest units) pusher), anchor: "ground", width: 0.5, height: 0.5 } ] }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @f key)) })) }
          ] } ]
        })
    }

    state gameover {
      PLAY_AGAIN -> playing
        (set @entity.crates @config.crates)
        (set @entity.player @config.player)
        (set @entity.moves 0)
        (set @entity.boxesDone 0)
        (set @entity.result "none")
        (set @entity.effects [])
        (render-ui main {
          type: game-shell
          fontFamily: "pixel"
          hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-fantasy-ui-borders/ui/kenney-fantasy-ui-borders.generated.json", sprite: "panel-border-010.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
          hud: { type: game-hud, stats: [ { label: "Moves", value: @entity.moves, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-cursor-pack/ui/kenney-cursor-pack.generated.json", sprite: "arrow_e.png", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-moves", thumbnailUrl: "" } }, { label: "Boxes", value: @entity.boxesDone, format: "text", iconUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-sokoban-board/svg/flat/features/crate.svg", role: "ui", category: "ui", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "icon-boxes", thumbnailUrl: "" } } ] }
          addons: { type: button, action: PLAY_AGAIN, label: "Reset", iconAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-mobile-controls/ui/icons-default.json", sprite: "icon_arrow_rotate", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "icon-reset", thumbnailUrl: "" }, variant: primary }
          controls: { type: control-grid, kind: "dpad", directionEvents: { up: "MOVE_UP", down: "MOVE_DOWN", left: "MOVE_LEFT", right: "MOVE_RIGHT" }, directionAssets: { up: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "30,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-up", thumbnailUrl: "" }, down: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "32,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-down", thumbnailUrl: "" }, left: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "33,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-left", thumbnailUrl: "" }, right: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/tilemap_packed.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-input-prompts-pixel-16/terrain/Tilemap_tilemap_packed.tiles.json", sprite: "31,4", role: "ui", category: "ui", animations: [], style: "pixel", variant: "", dimension: "2d", aspect: "1:1", name: "key-right", thumbnailUrl: "" } } }
          children: [ { type: canvas, camera: { zoom: (math/min 1 (/ 5 (+ 1 (math/max (array/max @config.tiles "x") (array/max @config.tiles "y"))))), pos: { x: (/ (+ (array/min @config.tiles "x") (array/max @config.tiles "x")) 2), y: (/ (+ (array/min @config.tiles "y") (array/max @config.tiles "y")) 2) } }, projection: "flat", showMinimap: false, keyMap: { ArrowUp: "MOVE_UP", KeyW: "MOVE_UP", ArrowDown: "MOVE_DOWN", KeyS: "MOVE_DOWN", ArrowLeft: "MOVE_LEFT", KeyA: "MOVE_LEFT", ArrowRight: "MOVE_RIGHT", KeyD: "MOVE_RIGHT" }, children: [
            { type: draw-shape-layer, items: (array/map @config.tiles (fn t { type: draw-shape, shape: "cell", position: { x: (object/get @t x), y: (object/get @t y) }, fill: "#5c94fc", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1 })) }
            { type: draw-sprite-layer, items: (array/map @config.tiles (fn t { type: draw-sprite, position: { x: (object/get @t x), y: (object/get @t y) }, asset: (object/get @t terrainSprite), anchor: "center", width: 1, height: 1 })) }
            { type: draw-sprite-layer, items: (array/map @entity.crates (fn c { type: draw-sprite, position: { x: (object/get @c x), y: (object/get @c y) }, asset: (if (!= (array/find @config.targets (fn t (and (== (object/get @t x) (object/get @c x)) (== (object/get @t y) (object/get @c y))))) null) (object/get (object/get @config.assetManifest features) crate_done) (object/get (object/get @config.assetManifest features) crate)), anchor: "center", width: 0.5, height: 0.5 })) }
            { type: draw-sprite-layer, items: [ { type: draw-sprite, position: { x: (object/get @entity.player x), y: (object/get @entity.player y) }, asset: (object/get (object/get @config.assetManifest units) pusher), anchor: "ground", width: 0.5, height: 0.5 } ] }
            { type: draw-sprite-layer, items: (array/map @entity.effects (fn f { type: draw-sprite, position: { x: (object/get @f x), y: (object/get @f y) }, asset: (object/get (object/get @config.assetManifest effects) (object/get @f key)) })) }
          ] } ]
        })
    }


    emits {
      MOVE_UP -> external {
        id : string
      }
        @description "Step north (keyboard keyMap or d-pad directionEvents); pushes an adjacent crate when the cell beyond is free"
        @tier "domain"
      MOVE_DOWN -> external {
        id : string
      }
        @description "Step south (keyboard keyMap or d-pad directionEvents); pushes an adjacent crate when the cell beyond is free"
        @tier "domain"
      MOVE_LEFT -> external {
        id : string
      }
        @description "Step west (keyboard keyMap or d-pad directionEvents); pushes an adjacent crate when the cell beyond is free"
        @tier "domain"
      MOVE_RIGHT -> external {
        id : string
      }
        @description "Step east (keyboard keyMap or d-pad directionEvents); pushes an adjacent crate when the cell beyond is free"
        @tier "domain"
      PLAY_AGAIN -> external {
        id : string
      }
        @description "Resets crates, pusher, and counters to the authored level"
        @tier "domain"
      GAME_END -> external {
        result : string
      }
        @description "Emitted when every crate sits on a target (result solved)"
        @tier "domain"
    }

    config {
      className : string = ""
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : SokobanBoardError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      scale : number = 0.5
