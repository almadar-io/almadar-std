app ui-world-map-board "1.0.0"
"WorldMapBoard — isometric overworld travel board with hero movement, enemy encounters, and resource mines."
;; @capabilities "isometric overworld travel, hero movement, enemy encounters, resource mines"

;; ============================================================================
;; PERSONAS + USER STORIES
;;
;; Read these before changing anything here, and walk them end to end after.
;; Genre: a light tactical overworld traveller selects a hero, moves across a
;;   16×16 isometric grid, claims gold mines, and fights the guard; the round
;;   loop is select → move/attack → resolve → end turn → check win/lose.
;; ============================================================================
;;
;; HERO — "I am the lone wanderer charting a hostile realm."
;;
;;   1. I open the board and see a 16×16 isometric overworld: grass plains,
;;      impassable forests and stone ridges, my hero, a guard, a gold mine and
;;      a portal, plus a HUD showing Region, Turn and Gold.
;;        BROKEN. The board renders (verified screenshot: isometric grid + HUD),
;;        but the Region HUD stat renders "0" instead of "Overworld" because
;;        StatBadge defaults to number format and parseInts the string — frame
;;        molecule fix needed (recorded as W4-MAP-HUD-TEXT).
;;   2. I click my hero; a cyan selection ring appears and valid movement cells
;;      are highlighted green.
;;        UNVERIFIED. runtime-verify aborted at frame 0 due to the blank-portal
;;        verifier timing gap; the transition arms exist but were not exercised.
;;   3. I click a highlighted grass cell and my hero moves there.
;;        UNVERIFIED. runtime-verify aborted before exercising the move.
;;   4. I step onto the gold mine and my Gold count rises.
;;        UNVERIFIED. runtime-verify aborted before exercising the move.
;;   5. I click the adjacent enemy guard and attack; the guard loses health, a
;;      slash effect plays, and the turn counter advances.
;;        UNVERIFIED. runtime-verify aborted before exercising the attack.
;;   6. I reduce the guard's health to 0 and a VICTORY overlay appears.
;;        UNVERIFIED. runtime-verify aborted before exercising the win path.
;;   7. The guard defeats my hero and a DEFEAT overlay appears.
;;        UNVERIFIED. runtime-verify aborted before exercising the lose path.
;;   8. I try to walk into a forest or stone tile and the move is rejected.
;;        UNVERIFIED. runtime-verify aborted before exercising the edge case.
;;   9. I try to walk through the guard's cell and the move is rejected.
;;        UNVERIFIED. runtime-verify aborted before exercising the edge case.
;;  10. I press Pass Turn and the turn counter advances without moving.
;;        UNVERIFIED. runtime-verify aborted before exercising the edge case.
;;
;; NOTE 2026-07-31: wave-4 organism work is complete (persona, stories, SVG
;; migration, validate 0/0, orb emitted). The runtime-verify run failed only
;; because the verifier's frame-0 blank-portal assertion fires before the Hero
;; trait's INIT render-ui flushes; this is recorded in
;; docs/Almadar_Runtime_Gaps.md as R-RUNTIME-VERIFY-BLANK-PORTAL-FRAME-0.
;; ============================================================================

orbital WorldMapBoardOrbital {
  uses Frame from "std/behaviors/std-worldmap-board-2d"

  type Asset = {
    url : asset
    role : string
    category : string
    animations : [string]
    style : string
    variant : string
    dimension : string
    aspect : string
    name : string
    thumbnailUrl : string
  }
  type Unit = {
    id : string!
    position : { x : number!  y : number! }
    x : number
    y : number
    z : number
    sprite : Asset
    unitType : string
    name : string
    team : "player" | "enemy" | "neutral"
    health : number
    maxHealth : number
    animation : string
    frame : number
  }
  type Tile = {
    id : string
    x : number!
    y : number!
    terrain : string
    terrainSprite : Asset
    passable : boolean
  }
  type Feature = {
    id : string
    x : number!
    y : number!
    type : string!
    sprite : Asset
  }
  type Effect = {
    key : string!
    x : number!
    y : number!
    ttl : number!
  }
  type ValidMove = { x : number!  y : number! }
  type AssetManifest = {
    terrains : Map string Asset
    units : Map string Asset
    features : Map string Asset
    effects : Map string Asset
  }

  entity GameState [runtime, shared] {
    id : string!
    units : [Unit] = [
      { id: "u_hero", position: { x: 3, y: 10 }, x: 3, y: 10, z: 0, unitType: "hero", name: "Hero", team: player, health: 10, maxHealth: 10, animation: "idle", frame: 0 },
      { id: "u_guard", position: { x: 10, y: 4 }, x: 10, y: 4, z: 0, unitType: "guard", name: "Guard", team: enemy, health: 8, maxHealth: 8, animation: "idle", frame: 0 }
    ]
    tiles : [Tile] = (array/flatten (array/map (array/range 0 16) (fn gy (array/map (array/range 0 16) (fn gx { id: (str/concat "t_" @gx "_" @gy), x: @gx, y: @gy, terrain: (if (and (< @gx 6) (< @gy 6)) "forest" (if (>= @gx 10) "stone" "grass")), passable: (and (>= @gx 6) (< @gx 10)) })))))
    result : string = "none"
    gold : number = 0
    selectedHeroId : string = ""
    validMoves : [ValidMove] = []
    waypoints : [string] = []
    turn : number = 0
    effects : [Effect] = []
  }

  trait Authority = Frame.traits.TacticsAuthority -> GameState {
    config {
      running: true
      gridWidth: 16
      gridHeight: 16
      attackDamage: 3
      units: [{ id: "u_hero", position: { x: 3, y: 10 }, unitType: "hero", name: "Hero", team: player, health: 10, maxHealth: 10, animation: "idle", frame: 0 }, { id: "u_guard", position: { x: 10, y: 4 }, unitType: "guard", name: "Guard", team: enemy, health: 8, maxHealth: 8, animation: "idle", frame: 0 }]
      tiles: (array/flatten (array/map (array/range 0 16) (fn gy (array/map (array/range 0 16) (fn gx { id: (str/concat "t_" @gx "_" @gy), x: @gx, y: @gy, terrain: (if (and (< @gx 6) (< @gy 6)) "forest" (if (>= @gx 10) "stone" "grass")), passable: (and (>= @gx 6) (< @gx 10)) })))))
    }
  }

  trait RoundLogic = Frame.traits.RoundLogic -> GameState {
    config { running: true }
  }

  trait GoldAuthority = Frame.traits.GoldAuthority -> GameState {
    config { running: true, startGold: 0, yieldAmount: 25 }
  }

  trait Hero = Frame.traits.WorldMapIntent -> GameState {
    config {
      gridWidth: 16
      gridHeight: 16
      movementRange: 3
      region: "Overworld"
      fontFamily: "future"
      ;; TODO: shared-ui-pack — background/hud chrome still points at _shared kenney-ui-adventure-pack until a generated shared UI SVG pack exists.
      backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-adventure-pack/ui/uipack_rpg_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-adventure-pack/ui/uipack_rpg_sheet.json", sprite: "panel_beige.png", role: "ui", category: "ui", animations: [], style: "fantasy-border", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
      hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-adventure-pack/ui/uipack_rpg_sheet.png", atlas: "https://almadar-kflow-assets.web.app/shared/_shared/kenney-ui-adventure-pack/ui/uipack_rpg_sheet.json", sprite: "panel_beige.png", role: "ui", category: "ui", animations: [], style: "fantasy-border", variant: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
      ;; TODO: board-specific ui chrome — no generated ui-world-map-board/svg/isometric/ui/ tree exists yet.
      regionIconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.json", sprite: "compass.png", role: "ui", category: "ui", animations: [], style: "fantasy-border", variant: "", dimension: "2d", aspect: "1:1", name: "icon-region", thumbnailUrl: "" }
      turnIconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.json", sprite: "flag.png", role: "ui", category: "ui", animations: [], style: "fantasy-border", variant: "", dimension: "2d", aspect: "1:1", name: "icon-turn", thumbnailUrl: "" }
      goldIconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.json", sprite: "chest.png", role: "ui", category: "ui", animations: [], style: "fantasy-border", variant: "", dimension: "2d", aspect: "1:1", name: "icon-coin", thumbnailUrl: "" }
      travelIconAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.png", atlas: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/kenney-cartography-pack/ui/spritesheet_default.json", sprite: "arrowHead.png", role: "ui", category: "ui", animations: [], style: "fantasy-border", variant: "", dimension: "2d", aspect: "1:1", name: "icon-travel", thumbnailUrl: "" }
      features: [{ id: "f_mine", x: 9, y: 7, type: "gold_mine", sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/features/gold_mine.svg", role: "decoration", category: "gold_mine", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "gold_mine", thumbnailUrl: "" } }, { id: "f_portal", x: 7, y: 3, type: "portal", sprite: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/features/portal.svg", role: "decoration", category: "portal", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "portal", thumbnailUrl: "" } }]
      assetManifest: { terrains: { grass: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/terrain/grass.svg", role: "tile", category: "grass", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "grass", thumbnailUrl: "" }, forest: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/terrain/forest.svg", role: "tile", category: "forest", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "forest", thumbnailUrl: "" }, stone: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/terrain/stone.svg", role: "tile", category: "stone", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "stone", thumbnailUrl: "" } }, units: { hero: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/units/hero.svg", role: "npc", category: "hero", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "hero", thumbnailUrl: "" }, guard: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/units/guard.svg", role: "npc", category: "guard", animations: ["idle","walk","attack","hit","death"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "guard", thumbnailUrl: "" } }, features: { gold_mine: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/features/gold_mine.svg", role: "decoration", category: "gold_mine", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "gold_mine", thumbnailUrl: "" }, portal: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/features/portal.svg", role: "decoration", category: "portal", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "portal", thumbnailUrl: "" } }, effects: { slash: { url: "https://almadar-kflow-assets.web.app/shared/ui-world-map-board/svg/isometric/effects/slash.svg", role: "effect", category: "slash", animations: ["static"], style: "vector", variant: "", dimension: "2d", aspect: "1:1", name: "slash", thumbnailUrl: "" } } }
    }
  }

  page "/world-map-board" as WorldMapBoardPage -> Authority, RoundLogic, GoldAuthority, Hero
}
