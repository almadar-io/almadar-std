      tiles: [ { id: "t-0-0", x: 0, y: 0, terrain: "stone", passable: false }, { id: "t-1-0", x: 1, y: 0, terrain: "stone", passable: false }, { id: "t-2-0", x: 2, y: 0, terrain: "stone", passable: false }, { id: "t-3-0", x: 3, y: 0, terrain: "stone", passable: false }, { id: "t-4-0", x: 4, y: 0, terrain: "stone", passable: false }, { id: "t-5-0", x: 5, y: 0, terrain: "stone", passable: false }, { id: "t-6-0", x: 6, y: 0, terrain: "stone", passable: false }, { id: "t-7-0", x: 7, y: 0, terrain: "stone", passable: false }, { id: "t-8-0", x: 8, y: 0, terrain: "stone", passable: false }, { id: "t-0-1", x: 0, y: 1, terrain: "stone", passable: false }, { id: "t-1-1", x: 1, y: 1, terrain: "stone", passable: false }, { id: "t-2-1", x: 2, y: 1, terrain: "stone", passable: false }, { id: "t-3-1", x: 3, y: 1, terrain: "stone", passable: false }, { id: "t-4-1", x: 4, y: 1, terrain: "stone", passable: false }, { id: "t-5-1", x: 5, y: 1, terrain: "stone", passable: false }, { id: "t-6-1", x: 6, y: 1, terrain: "stone", passable: false }, { id: "t-7-1", x: 7, y: 1, terrain: "stone", passable: false }, { id: "t-8-1", x: 8, y: 1, terrain: "stone", passable: false }, { id: "t-0-2", x: 0, y: 2, terrain: "stone", passable: false }, { id: "t-1-2", x: 1, y: 2, terrain: "stone", passable: false }, { id: "t-2-2", x: 2, y: 2, terrain: "grass", passable: true }, { id: "t-3-2", x: 3, y: 2, terrain: "grass", passable: true }, { id: "t-4-2", x: 4, y: 2, terrain: "planks", passable: true }, { id: "t-5-2", x: 5, y: 2, terrain: "grass", passable: true }, { id: "t-6-2", x: 6, y: 2, terrain: "grass", passable: true }, { id: "t-7-2", x: 7, y: 2, terrain: "stone", passable: false }, { id: "t-8-2", x: 8, y: 2, terrain: "stone", passable: false }, { id: "t-0-3", x: 0, y: 3, terrain: "stone", passable: false }, { id: "t-1-3", x: 1, y: 3, terrain: "stone", passable: false }, { id: "t-2-3", x: 2, y: 3, terrain: "grass", passable: true }, { id: "t-3-3", x: 3, y: 3, terrain: "grass", passable: true }, { id: "t-4-3", x: 4, y: 3, terrain: "planks", passable: true }, { id: "t-5-3", x: 5, y: 3, terrain: "grass", passable: true }, { id: "t-6-3", x: 6, y: 3, terrain: "grass", passable: true }, { id: "t-7-3", x: 7, y: 3, terrain: "stone", passable: false }, { id: "t-8-3", x: 8, y: 3, terrain: "stone", passable: false }, { id: "t-0-4", x: 0, y: 4, terrain: "stone", passable: false }, { id: "t-1-4", x: 1, y: 4, terrain: "stone", passable: false }, { id: "t-2-4", x: 2, y: 4, terrain: "grass", passable: true }, { id: "t-3-4", x: 3, y: 4, terrain: "grass", passable: true }, { id: "t-4-4", x: 4, y: 4, terrain: "planks", passable: true }, { id: "t-5-4", x: 5, y: 4, terrain: "grass", passable: true }, { id: "t-6-4", x: 6, y: 4, terrain: "grass", passable: true }, { id: "t-7-4", x: 7, y: 4, terrain: "stone", passable: false }, { id: "t-8-4", x: 8, y: 4, terrain: "stone", passable: false }, { id: "t-0-5", x: 0, y: 5, terrain: "stone", passable: false }, { id: "t-1-5", x: 1, y: 5, terrain: "stone", passable: false }, { id: "t-2-5", x: 2, y: 5, terrain: "grass", passable: true }, { id: "t-3-5", x: 3, y: 5, terrain: "grass", passable: true }, { id: "t-4-5", x: 4, y: 5, terrain: "planks", passable: true }, { id: "t-5-5", x: 5, y: 5, terrain: "grass", passable: true }, { id: "t-6-5", x: 6, y: 5, terrain: "grass", passable: true }, { id: "t-7-5", x: 7, y: 5, terrain: "stone", passable: false }, { id: "t-8-5", x: 8, y: 5, terrain: "stone", passable: false }, { id: "t-0-6", x: 0, y: 6, terrain: "stone", passable: false }, { id: "t-1-6", x: 1, y: 6, terrain: "stone", passable: false }, { id: "t-2-6", x: 2, y: 6, terrain: "grass", passable: true }, { id: "t-3-6", x: 3, y: 6, terrain: "grass", passable: true }, { id: "t-4-6", x: 4, y: 6, terrain: "planks", passable: true }, { id: "t-5-6", x: 5, y: 6, terrain: "grass", passable: true }, { id: "t-6-6", x: 6, y: 6, terrain: "grass", passable: true }, { id: "t-7-6", x: 7, y: 6, terrain: "stone", passable: false }, { id: "t-8-6", x: 8, y: 6, terrain: "stone", passable: false }, { id: "t-0-7", x: 0, y: 7, terrain: "stone", passable: false }, { id: "t-1-7", x: 1, y: 7, terrain: "stone", passable: false }, { id: "t-2-7", x: 2, y: 7, terrain: "stone", passable: false }, { id: "t-3-7", x: 3, y: 7, terrain: "stone", passable: false }, { id: "t-4-7", x: 4, y: 7, terrain: "planks", passable: true }, { id: "t-5-7", x: 5, y: 7, terrain: "stone", passable: false }, { id: "t-6-7", x: 6, y: 7, terrain: "stone", passable: false }, { id: "t-7-7", x: 7, y: 7, terrain: "stone", passable: false }, { id: "t-8-7", x: 8, y: 7, terrain: "stone", passable: false }, { id: "t-0-8", x: 0, y: 8, terrain: "stone", passable: false }, { id: "t-1-8", x: 1, y: 8, terrain: "stone", passable: false }, { id: "t-2-8", x: 2, y: 8, terrain: "stone", passable: false }, { id: "t-3-8", x: 3, y: 8, terrain: "stone", passable: false }, { id: "t-4-8", x: 4, y: 8, terrain: "stone", passable: false }, { id: "t-5-8", x: 5, y: 8, terrain: "stone", passable: false }, { id: "t-6-8", x: 6, y: 8, terrain: "stone", passable: false }, { id: "t-7-8", x: 7, y: 8, terrain: "stone", passable: false }, { id: "t-8-8", x: 8, y: 8, terrain: "stone", passable: false } ]
    }
  }

  trait FxDecay = Frame.traits.FxDecay -> GameState {
    config { running: true }
  }

  trait RoundLogic = Frame.traits.RoundLogic -> GameState {
    config { running: true }
  }

  trait ScoreKeeper = Score.traits.ScoreKeeper -> GameState {
    config { running: true, pointsPerKill: 10, startScore: 0, initialEnemies: 1 }
  }

  trait AnimClock = Frame.traits.AnimClock -> GameState {
    config { frames: [] }
  }

  trait CastleClock -> @rebindable GameState [lifecycle] {
    initial: running

    state running {
      INIT -> running
        (set @entity.clockTicks 0)
    }

    ticks {
      turnTick every 2000ms when (== @entity.result "none")
        (set @entity.clockTicks (+ @entity.clockTicks 1))
        (emit END_TURN { id: "clock" })
    }

    emits {
      END_TURN -> external {
        id : string
      }
        @description "Real-time round advance; the frame's PlayerIntent treats it exactly like the End Turn button (turn bump, activation reset, AI_TURN)"
        @tier "domain"
    }
  }

  trait CastleEconomy -> @rebindable GameState [lifecycle] {
    initial: active

    state active {
      INIT -> active
        (set @entity.gold @config.startGold)
        (set @entity.ecoSpawnCount 0)

      BUILD_TOWER -> active when (and @config.running (and (== @entity.result "none") (and (>= @entity.gold @config.towerCost) (or (== (array/len (array/filter @entity.units (fn u (and (> @u.health 0) (and (== (object/get (object/get @u position) x) @config.plot1X) (== (object/get (object/get @u position) y) @config.plot1Y)))))) 0) (== (array/len (array/filter @entity.units (fn u (and (> @u.health 0) (and (== (object/get (object/get @u position) x) @config.plot2X) (== (object/get (object/get @u position) y) @config.plot2Y)))))) 0)))))
        (set @entity.gold (- @entity.gold @config.towerCost))
        (emit SPAWN { id: (str/concat "castle-t-" @entity.ecoSpawnCount), x: (if (== (array/len (array/filter @entity.units (fn u (and (> @u.health 0) (and (== (object/get (object/get @u position) x) @config.plot1X) (== (object/get (object/get @u position) y) @config.plot1Y)))))) 0) @config.plot1X @config.plot2X), y: (if (== (array/len (array/filter @entity.units (fn u (and (> @u.health 0) (and (== (object/get (object/get @u position) x) @config.plot1X) (== (object/get (object/get @u position) y) @config.plot1Y)))))) 0) @config.plot1Y @config.plot2Y), team: "player", health: @config.towerHealth, maxHealth: @config.towerHealth, unitType: "watchtower" })
        (set @entity.ecoSpawnCount (+ @entity.ecoSpawnCount 1))
    }

    ticks {
      harvestTick every 2000ms when (and @config.running (== @entity.result "none"))
        (set @entity.gold (+ @entity.gold (* (array/len (array/filter @entity.units (fn u (and (== @u.team "player") (and (> @u.health 0) (and (== @u.unitType "worker") (or (<= (grid/manhattan-distance (object/get @u position) { x: @config.mine1X, y: @config.mine1Y }) 1) (<= (grid/manhattan-distance (object/get @u position) { x: @config.mine2X, y: @config.mine2Y }) 1)))))))) @config.goldPerWorkerTick)))
    }

    emits {
      SPAWN -> external {
        id : string!
        x : number!
        y : number!
        team : string!
        health : number!
        maxHealth : number!
        unitType : string!
      }
        @description "Raised-watchtower intent applied by the grid-tactics authority (the sole units writer)"
        @tier "domain"
    }

    listens {
      BUILD_TOWER { id : string }
    }

    config {
      running : boolean = true
        @label "Running"
        @description "When true, workers harvest and BUILD_TOWER raises watchtowers; toggle to freeze the economy."
        @tier "domain"
      startGold : number = 25
        @label "Start Gold"
        @description "Gold stockpile set on INIT — exactly one watchtower."
        @tier "domain"
      goldPerWorkerTick : number = 2
        @label "Gold Per Worker Tick"
        @description "Gold each living worker at a gold mine harvests every 2s cycle."
        @tier "domain"
      towerCost : number = 25
        @label "Tower Cost"
        @description "Gold spent per raised watchtower; BUILD_TOWER only fires when affordable and a plot is free."
        @tier "domain"
      towerHealth : number = 12
        @label "Tower Health"
        @description "Health/maxHealth of raised watchtowers."
        @tier "domain"
      mine1X : number = 2
        @label "West Mine X"
        @description "Grid column of the west gold-mine harvest anchor."
        @tier "domain"
      mine1Y : number = 2
        @label "West Mine Y"
        @description "Grid row of the west gold-mine harvest anchor."
        @tier "domain"
      mine2X : number = 6
        @label "East Mine X"
        @description "Grid column of the east gold-mine harvest anchor."
        @tier "domain"
      mine2Y : number = 2
        @label "East Mine Y"
        @description "Grid row of the east gold-mine harvest anchor."
        @tier "domain"
      plot1X : number = 2
        @label "West Plot X"
        @description "Grid column of the west tower plot (the west mine cell)."
        @tier "domain"
      plot1Y : number = 2
        @label "West Plot Y"
        @description "Grid row of the west tower plot (the west mine cell)."
        @tier "domain"
      plot2X : number = 6
        @label "East Plot X"
        @description "Grid column of the east tower plot (the east mine cell)."
        @tier "domain"
      plot2Y : number = 2
        @label "East Plot Y"
        @description "Grid row of the east tower plot (the east mine cell)."
        @tier "domain"
    }
  }

  trait CastleWaves -> @rebindable GameState [lifecycle] {
    initial: active

    state active {
      INIT -> active
        (set @entity.waveCount 0)
    }

    ticks {
      waveTick every 12000ms when (and @config.running (and (== @entity.result "none") (and (> (array/len (array/filter @entity.units (fn u (and (== @u.unitType "portal") (> @u.health 0))))) 0) (== (array/len (array/filter @entity.units (fn u (and (> @u.health 0) (and (== (object/get (object/get @u position) x) @config.waveSpawnX) (== (object/get (object/get @u position) y) @config.waveSpawnY)))))) 0))))
        (emit SPAWN { id: (str/concat "castle-w-" @entity.waveCount), x: @config.waveSpawnX, y: @config.waveSpawnY, team: "enemy", health: (+ @config.waveBaseHealth @entity.waveCount), maxHealth: (+ @config.waveBaseHealth @entity.waveCount), unitType: "raider" })
        (set @entity.waveCount (+ @entity.waveCount 1))
    }

    emits {
      SPAWN -> external {
        id : string!
        x : number!
        y : number!
        team : string!
        health : number!
        maxHealth : number!
        unitType : string!
      }
        @description "Raider-wave intent applied by the grid-tactics authority (the sole units writer)"
        @tier "domain"
    }

    config {
      running : boolean = true
        @label "Running"
        @description "When true, raider waves muster every 12s while the portal stands; toggle to freeze the waves."
        @tier "domain"
      waveSpawnX : number = 4
        @label "Wave Spawn X"
        @description "Grid column of the corridor-mouth muster cell where raiders stream in."
        @tier "domain"
      waveSpawnY : number = 2
        @label "Wave Spawn Y"
        @description "Grid row of the corridor-mouth muster cell where raiders stream in."
        @tier "domain"
      waveBaseHealth : number = 6
        @label "Wave Base Health"
        @description "Health of the first raider wave; each later wave adds +1."
        @tier "domain"
    }
  }

  trait Player = Frame.traits.PlayerIntent -> GameState {
    config {
      gridWidth: 9
      gridHeight: 9
      movementRange: 2
      attackRange: 2
      projection: "isometric"
      showMinimap: true
      scale: 0.45
      backgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/ui/panel-frame.svg", role: "ui", category: "ui", animations: [], style: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
      hudBackgroundAsset: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/ui/panel-frame.svg", role: "ui", category: "ui", animations: [], style: "", dimension: "2d", aspect: "1:1", name: "panel-frame", thumbnailUrl: "" }
      extraStats: [ { label: "Gold", value: @entity.gold }, { label: "Wave", value: @entity.waveCount } ]
      extraAddonEvent: "BUILD_TOWER"
      extraAddons: [ { type: "button", action: BUILD_TOWER, label: "Tower (25g)", variant: "secondary" } ]
      features: [ { id: "mine1", x: 2, y: 2, type: "gold_mine", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/gold_mine.svg", role: "decoration", category: "gold_mine", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "gold_mine", thumbnailUrl: "" } }, { id: "mine2", x: 6, y: 2, type: "gold_mine", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/gold_mine.svg", role: "decoration", category: "gold_mine", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "gold_mine", thumbnailUrl: "" } }, { id: "wall1", x: 3, y: 1, type: "wall", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/wall.svg", role: "decoration", category: "wall", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { id: "wall2", x: 4, y: 1, type: "wall", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/wall.svg", role: "decoration", category: "wall", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, { id: "wall3", x: 5, y: 1, type: "wall", assetUrl: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/wall.svg", role: "decoration", category: "wall", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } } ]
      assetManifest: { terrains: { stone: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/terrain/stone.svg", role: "tile", category: "stone", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "stone", thumbnailUrl: "" }, grass: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/terrain/grass.svg", role: "tile", category: "grass", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "grass", thumbnailUrl: "" }, planks: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/terrain/planks.svg", role: "tile", category: "planks", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "planks", thumbnailUrl: "" } }, units: { guardian: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/units/guardian.svg", role: "npc", category: "guardian", animations: ["idle","walk","attack","hit","death"], style: "", dimension: "2d", aspect: "1:1", name: "guardian", thumbnailUrl: "" }, worker: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/units/worker.svg", role: "npc", category: "worker", animations: ["idle","walk","attack","hit","death"], style: "", dimension: "2d", aspect: "1:1", name: "worker", thumbnailUrl: "" }, keep: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/units/keep.svg", role: "npc", category: "keep", animations: ["idle","walk","attack","hit","death"], style: "", dimension: "2d", aspect: "1:1", name: "keep", thumbnailUrl: "" }, watchtower: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/units/watchtower.svg", role: "npc", category: "watchtower", animations: ["idle","walk","attack","hit","death"], style: "", dimension: "2d", aspect: "1:1", name: "watchtower", thumbnailUrl: "" }, portal: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/units/portal.svg", role: "npc", category: "portal", animations: ["idle","walk","attack","hit","death"], style: "", dimension: "2d", aspect: "1:1", name: "portal", thumbnailUrl: "" }, raider: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/units/raider.svg", role: "npc", category: "raider", animations: ["idle","walk","attack","hit","death"], style: "", dimension: "2d", aspect: "1:1", name: "raider", thumbnailUrl: "" } }, features: { gold_mine: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/gold_mine.svg", role: "decoration", category: "gold_mine", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "gold_mine", thumbnailUrl: "" }, wall: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/features/wall.svg", role: "decoration", category: "wall", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "wall", thumbnailUrl: "" } }, effects: { hit: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/effects/hit.svg", role: "effect", category: "hit", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "hit", thumbnailUrl: "" }, explosion: { url: "https://almadar-kflow-assets.web.app/shared/ui-castle-board/svg/isometric/effects/explosion.svg", role: "effect", category: "explosion", animations: ["static"], style: "", dimension: "2d", aspect: "1:1", name: "explosion", thumbnailUrl: "" } } }
    }
  }

  page "/castle-board" as CastleBoardPage -> Authority, FxDecay, RoundLogic, ScoreKeeper, Player, AnimClock, CastleClock, CastleEconomy, CastleWaves
}
