app ui-module-card "1.0.0"
"ModuleCard — a card summarizing one course module or lesson with progress and entry point. — UI factory (1:1 with the @almadar/ui module-card pattern)."
;; @capabilities "course module card, lesson card, curriculum unit card, learning-path step card"
orbital ModuleCardOrbital {
  type ModuleCardData = {
    orbitalName : string!
    entityName : string!
    persistence : string!
    fields : [object]!
    traits : [object]!
    pages : [object]!
    traitDetails : object!
    externalLinks : [object]!
  }

  entity ModuleCardItem [runtime] {
    id : string!
  }

  trait ModuleCardRender -> @rebindable ModuleCardItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          data: @config.data
          type: module-card
        })
    }

    config {
      data : ModuleCardData = { orbitalName: "Orbital Name", entityName: "Entity Name", persistence: "Persistence", fields: [], traits: [], pages: [], traitDetails: {}, externalLinks: [] }
        @label "Data"
        @description "data prop"
        @tier "presentation"
    }
  }

  page "/module-card" as ModuleCardPage -> ModuleCardRender
}
