app ui-module-card "1.0.0"
"ModuleCard — a compact summary card for one orbital module: its entity and fields, a mini state machine per trait, and its pages. — UI factory (1:1 with the @almadar/ui module-card pattern)."
;; @capabilities "orbital module summary card, entity and trait overview card, app architecture node card"
;; @pattern "module-card"
orbital ModuleCardOrbital {
  type ModuleCardData = {
    orbitalName : string!
    entityName : string!
    fields : [ModuleCardDataFieldsItem]!
    traits : [ModuleCardDataTraitsItem]!
    pages : [ModuleCardDataPagesItem]!
    traitDetails : Map string ModuleCardDataTraitDetailsValue!
    externalLinks : [ModuleCardDataExternalLinksItem]!
  }
  type ModuleCardDataFieldsItem = {
    name : string!
    type : string!
    required : boolean!
    hasDefault : boolean!
  }
  type ModuleCardDataTraitsItem = {
    name : string!
    stateCount : number!
    eventCount : number!
    transitionCount : number!
    emits : [string]!
    listens : [string]!
  }
  type ModuleCardDataPagesItem = {
    name : string!
    route : string!
  }
  type ModuleCardDataTraitDetailsValue = {
    name : string!
    linkedEntity : string!
    states : [ModuleCardDataTraitDetailsValueStatesItem]!
    transitions : [ModuleCardDataTraitDetailsValueTransitionsItem]!
    emittedEvents : [string]!
    listenedEvents : [string]!
  }
  type ModuleCardDataTraitDetailsValueStatesItem = {
    name : string!
    isInitial : boolean
    isTerminal : boolean
  }
  type ModuleCardDataTraitDetailsValueTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guard : SExpr
    effects : [ModuleCardDataTraitDetailsValueTransitionsItemEffectsItem]!
    index : number!
  }
  type ModuleCardDataTraitDetailsValueTransitionsItemEffectsItem = {
    type : string!
    args : [SExpr]!
  }
  type ModuleCardDataExternalLinksItem = {
    targetOrbital : string!
    eventName : string!
    direction : string!
    traitName : string!
  }
  type ModuleCardAnnotationsValue = {
    states : Map string ModuleCardAnnotationsValueStatesValue
    transitions : Map string ModuleCardAnnotationsValueTransitionsValue
    effects : Map string ModuleCardAnnotationsValueEffectsValue
  }
  type ModuleCardAnnotationsValueStatesValue = {
    title : string
    body : string!
  }
  type ModuleCardAnnotationsValueTransitionsValue = {
    title : string
    body : string!
  }
  type ModuleCardAnnotationsValueEffectsValue = {
    title : string
    body : string!
  }

  entity ModuleCardItem [runtime] {
    id : string!
  }

  trait ModuleCardRender -> @rebindable ModuleCardItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          data: @config.data
          annotations: @config.annotations
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: module-card
        })
    }

    config {
      data : ModuleCardData = { orbitalName: "OrderOrbital", entityName: "Order", persistence: "persistent", fields: [{ name: "customer", type: "string", required: true, hasDefault: false }, { name: "qty", type: "number", required: true, hasDefault: true }, { name: "status", type: "string", required: false, hasDefault: true }], traits: [{ name: "OrderFlow", stateCount: 5, eventCount: 7, transitionCount: 7, emits: ["ORDER_SAVED"], listens: ["PAYMENT_OK"] }], pages: [{ name: "Orders", route: "/orders" }], traitDetails: { OrderFlow: { name: "OrderFlow", linkedEntity: "Order", states: [{ name: "browsing", isInitial: true, isTerminal: false }, { name: "editing", isInitial: false, isTerminal: false }, { name: "saving", isInitial: false, isTerminal: false }, { name: "confirmed", isInitial: false, isTerminal: true }, { name: "failed", isInitial: false, isTerminal: false }], transitions: [{ from: "browsing", to: "editing", event: "EDIT", effects: [{ type: "render-ui", args: [] }], index: 0 }, { from: "editing", to: "saving", event: "SAVE", effects: [{ type: "persist", args: [] }, { type: "notify", args: [] }], index: 1 }, { from: "saving", to: "confirmed", event: "SAVED", effects: [{ type: "emit", args: [] }, { type: "render-ui", args: [] }], index: 2 }, { from: "saving", to: "failed", event: "SAVE_FAILED", effects: [{ type: "notify", args: [] }], index: 3 }, { from: "failed", to: "editing", event: "RETRY", effects: [], index: 4 }, { from: "editing", to: "browsing", event: "CANCEL", effects: [{ type: "render-ui", args: [] }], index: 5 }, { from: "confirmed", to: "browsing", event: "DONE", effects: [{ type: "navigate", args: [] }], index: 6 }], emittedEvents: ["ORDER_SAVED"], listenedEvents: ["PAYMENT_OK"] } }, externalLinks: [{ targetOrbital: "PaymentOrbital", eventName: "PAYMENT_OK", direction: "in", traitName: "OrderFlow" }] }
        @label "Data"
        @description "The orbital to summarize."
        @tier "presentation"
      annotations : Map string ModuleCardAnnotationsValue = { item: {} }
        @label "Annotations"
        @description "Author explanations per trait name (states, transition events, effect types), shown in a popover on hover."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/module-card" as ModuleCardPage -> ModuleCardRender
}
