app ui-avl-state-machine [
  version: "1.0.0",
  description: "AvlStateMachine — UI factory (1:1 with the @almadar/ui avl-state-machine pattern)."
]
;; @pattern "avl-state-machine"
orbital AvlStateMachineOrbital {
  type AvlStateMachineTrait = {
    name : string!
    linkedEntity : string!
    states : [AvlStateMachineTraitStatesItem]!
    transitions : [AvlStateMachineTraitTransitionsItem]!
    emittedEvents : [string]!
    listenedEvents : [string]!
  }
  type AvlStateMachineTraitStatesItem = {
    name : string!
    isInitial : boolean
    isTerminal : boolean
  }
  type AvlStateMachineTraitTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guard : SExpr
    effects : [AvlStateMachineTraitTransitionsItemEffectsItem]!
    index : number!
  }
  type AvlStateMachineTraitTransitionsItemEffectsItem = {
    type : string!
    args : [SExpr]!
  }
  type AvlStateMachineAnnotations = {
    states : Map string AvlStateMachineAnnotationsStatesValue
    transitions : Map string AvlStateMachineAnnotationsTransitionsValue
    effects : Map string AvlStateMachineAnnotationsEffectsValue
  }
  type AvlStateMachineAnnotationsStatesValue = {
    title : string
    body : string!
  }
  type AvlStateMachineAnnotationsTransitionsValue = {
    title : string
    body : string!
  }
  type AvlStateMachineAnnotationsEffectsValue = {
    title : string
    body : string!
  }
  type AvlStateMachineTRANSITIONCLICKTransition = {
    index : number!
    event : string!
    from : string!
    to : string!
  }

  entity AvlStateMachineItem [runtime] {
    id : string!
  }

  trait AvlStateMachineRender -> @rebindable AvlStateMachineItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          trait: @config.traitProp
          activeState: @config.activeState
          activeTransition: @config.activeTransition
          visitedStates: @config.visitedStates
          stateClickEvent: @config.stateClickEvent
          transitionClickEvent: @config.transitionClickEvent
          onTransitionClick: @config.onTransitionClick
          selectedState: @config.selectedState
          pendingSourceState: @config.pendingSourceState
          nodeShape: @config.nodeShape
          entityFields: @config.entityFields
          direction: @config.direction
          showHeader: @config.showHeader
          annotations: @config.annotations
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: avl-state-machine
        })
    }

    emits {
      @config.stateClickEvent -> external {
        stateId : string!
      }
        @description "Emits UI:{stateClickEvent} with { stateId } when a state is clicked."
        @tier "essential"
      @config.transitionClickEvent -> external {
        index : number!
        event : string!
        from : string!
        to : string!
        transition : AvlStateMachineTRANSITIONCLICKTransition
      }
        @description "Emits UI:{transitionClickEvent} with { index, event, from, to } when a transition label is clicked."
        @tier "essential"
    }

    config {
      traitProp : AvlStateMachineTrait = { name: "OrderFlow", linkedEntity: "Order", states: [{ name: "browsing", isInitial: true, isTerminal: false }, { name: "editing", isInitial: false, isTerminal: false }, { name: "saving", isInitial: false, isTerminal: false }, { name: "confirmed", isInitial: false, isTerminal: true }, { name: "failed", isInitial: false, isTerminal: false }], transitions: [{ from: "browsing", to: "editing", event: "EDIT", effects: [{ type: "render-ui", args: [] }], index: 0 }, { from: "editing", to: "saving", event: "SAVE", effects: [{ type: "persist", args: [] }, { type: "notify", args: [] }], index: 1 }, { from: "saving", to: "confirmed", event: "SAVED", effects: [{ type: "emit", args: [] }, { type: "render-ui", args: [] }], index: 2 }, { from: "saving", to: "failed", event: "SAVE_FAILED", effects: [{ type: "notify", args: [] }], index: 3 }, { from: "failed", to: "editing", event: "RETRY", effects: [], index: 4 }, { from: "editing", to: "browsing", event: "CANCEL", effects: [{ type: "render-ui", args: [] }], index: 5 }, { from: "confirmed", to: "browsing", event: "DONE", effects: [{ type: "navigate", args: [] }], index: 6 }], emittedEvents: ["ORDER_SAVED"], listenedEvents: ["PAYMENT_OK"] }
        @label "Trait"
        @description "The trait to draw (see `parseTraitLevel`)."
        @synonyms "trait"
        @tier "presentation"
      activeState : string
        @label "Active State"
        @description "State execution is currently in."
        @tier "presentation"
      activeTransition : number
        @label "Active Transition"
        @description "`index` of the transition that just fired."
        @tier "presentation"
      visitedStates : [string] = []
        @label "Visited States"
        @description "States already passed through, in order."
        @tier "presentation"
      stateClickEvent : event = "STATE_CLICK"
        @label "State Click Event"
        @description "Emits UI:{stateClickEvent} with { stateId } when a state is clicked."
        @tier "presentation"
      transitionClickEvent : event = "TRANSITION_CLICK"
        @label "Transition Click Event"
        @description "Emits UI:{transitionClickEvent} with { index, event, from, to } when a transition label is clicked."
        @tier "presentation"
      onTransitionClick : event = "TRANSITION_CLICK"
        @label "On Transition Click"
        @description "Direct transition-click callback, for React hosts (e.g. a canvas node)."
        @tier "presentation"
      selectedState : string
        @label "Selected State"
        @description "State picked in an editor (first click)."
        @tier "presentation"
      pendingSourceState : string
        @label "Pending Source State"
        @description "Source of a transition being drawn — the next state click picks its target."
        @tier "presentation"
      nodeShape : "pill" | "gear" = pill
        @label "Node Shape"
        @description "Node silhouette. @default 'pill'"
        @tier "presentation"
      entityFields : [string] = []
        @label "Entity Fields"
        @description "Entity field names listed in the header."
        @tier "presentation"
      direction : "ltr" | "rtl" = ltr
        @label "Direction"
        @description "Flow direction. @default 'ltr'"
        @tier "presentation"
      showHeader : boolean = true
        @label "Show Header"
        @description "Show the trait header (name, entity, listens/emits). @default true"
        @tier "presentation"
      annotations : AvlStateMachineAnnotations = { states: { pending: { title: "Unpaid", body: "Every order starts here." } }, transitions: { PAY: { body: "Only fires when the amount is positive." } }, effects: { persist: { body: "Saves the order." } } }
        @label "Annotations"
        @description "Author explanations shown in a popover on hover: a note per state name, per transition event and per effect type."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/avl-state-machine" as AvlStateMachinePage -> AvlStateMachineRender
}
