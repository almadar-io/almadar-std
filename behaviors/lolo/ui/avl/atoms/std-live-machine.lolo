app std-live-machine [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-live-machine — a running machine drawn beside its own source and moved by it: reads a trait with behavior/describe, then shows the trait's state machine (active state, fired transition, visited states) first, its .lolo source after it (the lines of the transition that fired are highlighted), so a narrow view stacks the machine on top. A running demo reports each move as ADVANCE { event, to? } (`to` picks the arm when one event leaves a state more than one way); an event with no transition from the active state is ignored. SUBJECT { behavior, trait } re-describes another trait by name and resets the view; the `subject` knob is the initial trait. On a page with no host the build answers behavior/describe, so guards and effects are the program's own code. LiveMachineOrbit draws the running page whole instead: ORBITAL_SUBJECT { behavior } to LiveMachineTrace reads the asking session's mounted orbital (program/self { mounted: true }), and every trait is drawn as a box nested in the trait that embeds it, starting from its current state. LiveMachineTrace follows the page through the composed std-page-trace, which opens one trace subscription for the traits that step in the browser and one for those on the server (EXEC-DIST-14), leaving out the observer traits (the tracer and the views it feeds) so it never traces its own work. Each move lights its fired transition, and LiveMachineSource describes the trait that moved last for the source column. ORBITAL_CLOSE closes the subscriptions. GUEST_ORBIT { behavior, guest } to LiveMachineOrbit draws a guest session (program/open) the same way: LiveMachineSource reads the guest's mounted orbital on the server (program/self { mounted: true, guest }), and the composer routes the guest's moves to MOVES."
]
;; @capabilities "live state machine view, trait source beside diagram, running machine diagram, highlight fired transition, describe a trait"
uses Spec from "almadar-std/live-machine"
uses PageTrace from "std/behaviors/std-page-trace"

type DescribedState = { name : string!, isInitial : boolean }
type DescribedTransition = { from : string!, to : string!, event : string! }
type DescribedStateMachine = { states : [DescribedState]!, transitions : [DescribedTransition]! }
type DescribedMachine = { stateMachine : DescribedStateMachine! }
type TransitionLines = { index : number!, start : number!, end : number! }
type DescribedSource = { text : string!, transitions : [TransitionLines]! }
type TraitRef = { behavior : string, trait : string! }
type MachineMove = { trait : string!, event : string?, from : string!, to : string!, fired : boolean! }
type SubjectExpr = SExpr
type DescribedSubject = { machine : DescribedMachine!, source : DescribedSource! }
type CodeHighlight = { start : number!, end : number! }
type DiagramNote = { title : string, body : string! }
type DiagramNotes = { states : Map string DiagramNote, transitions : Map string DiagramNote, effects : Map string DiagramNote }
type MountedState = { name : string!, isInitial : boolean!, isTerminal : boolean! }
type MountedTransition = { index : number!, from : [string]!, to : string!, event : string!, guarded : boolean!, emits : [string]! }
type MountedListen = { event : string!, triggers : string? }
type MountedInstance = { entityId : string!, state : string! }
type MountedTrait = { trait : string!, orbital : string?, parent : string?, depth : number!, embeddedIn : [string]!, renders : boolean!, linked : boolean!, observer : boolean!, stepsIn : string!, linkedEntity : string?, instances : [MountedInstance]!, states : [MountedState]!, transitions : [MountedTransition]!, emits : [string]!, listens : [MountedListen]! }
type MountedWire = { from : string!, to : string!, event : string!, triggers : string? }
type MountedOrbital = { page : string!, traits : [MountedTrait]!, wires : [MountedWire]! }
type TraitState = { trait : string!, state : string! }
type FiredMove = { trait : string!, index : number! }
type FocusMove = { trait : string!, event : string!, from : string!, to : string!, nonce : number! }
type TraceMove = { trait : string!, from : string!, to : string!, event : string?, executed : boolean! }
type TraceDispatch = { seq : number!, outcomes : [TraceMove]! }
type DescribedValue = { behavior : string, trait : string! }
type DescribedSourceOf = { value : DescribedValue!, source : DescribedSource! }

orbital LiveMachineOrbital {
  entity LiveMachineView [runtime] {
    id : string!
    subject : DescribedSubject
    current : TraitRef?
    title : string = ""
    transitions : [DescribedTransition] = []
    sourceText : string = ""
    sourceLines : [TransitionLines] = []
    highlight : CodeHighlight?
    active : string
    fired : number
    visited : [string] = []
  }

  entity LiveMachineOrbitView [runtime] {
    id : string!
    behavior : string = ""
    tree : MountedOrbital?
    actives : [TraitState] = []
    firedMove : FiredMove?
    title : string = ""
    sourceText : string = ""
    sourceLines : [TransitionLines] = []
    highlight : CodeHighlight?
    guest : string = ""
    pinned : boolean = false
    route : [FiredMove] = []
    focus : FocusMove?
  }

  entity LiveMachineSourceView [runtime] {
    id : string!
  }

  entity LiveMachineTraceView [runtime] {
    id : string!
    behavior : string = ""
  }


  trait LiveMachine -> @rebindable LiveMachineView [optimistic] {
    initial: describing

    ;; a trait value always has its name, a described machine an initial state and the guard finds the fired index, so the empty fallbacks are never read
    state describing {
      INIT -> describing when (validate/required @config.subject)
        (set @entity.current (as @config.subject TraitRef))
        (set @entity.title (object/get (default (as @config.subject TraitRef) { trait: "" }) trait))
        (render-ui main { type: state-machine-view, isLoading: true })
        (behavior/describe @config.subject { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
      INIT -> idle when (not (validate/required @config.subject))
        (render-ui main { type: empty-state, title: (i18n/t "diagram.empty") })
      DESCRIBED -> idle
        (set @entity.subject ?result)
        (set @entity.transitions ?result.machine.stateMachine.transitions)
        (set @entity.sourceText ?result.source.text)
        (set @entity.sourceLines ?result.source.transitions)
        (set @entity.highlight null)
        (set @entity.active (object/get (default (array/find ?result.machine.stateMachine.states (fn s (= @s.isInitial true))) { name: "", isInitial: true }) name))
        (set @entity.fired -1)
        (set @entity.visited [(object/get (default (array/find ?result.machine.stateMachine.states (fn s (= @s.isInitial true))) { name: "", isInitial: true }) name)])
        (render-ui main @config.view)
      SUBJECT -> describing
        (set @entity.current { behavior: ?behavior, trait: ?trait })
        (set @entity.title ?trait)
        (render-ui main { type: state-machine-view, isLoading: true })
        (behavior/describe { behavior: ?behavior, trait: ?trait } { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
      DESCRIBE_FAILED -> describing
        (render-ui main { type: error-state, title: (i18n/t "diagram.failed"), message: ?error, retryEvent: RETRY })
      MOVES -> describing
      RETRY -> describing
        (if (validate/required @entity.current) (behavior/describe @entity.current { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } }) null)
    }

    state idle {
      INIT -> describing when (validate/required @config.subject)
        (set @entity.current (as @config.subject TraitRef))
        (set @entity.title (object/get (default (as @config.subject TraitRef) { trait: "" }) trait))
        (render-ui main { type: state-machine-view, isLoading: true })
        (behavior/describe @config.subject { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
      INIT -> idle when (not (validate/required @config.subject))
        (render-ui main { type: empty-state, title: (i18n/t "diagram.empty") })
      SUBJECT -> describing
        (set @entity.current { behavior: ?behavior, trait: ?trait })
        (set @entity.title ?trait)
        (render-ui main { type: state-machine-view, isLoading: true })
        (behavior/describe { behavior: ?behavior, trait: ?trait } { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
      ADVANCE -> idle when (array/some @entity.transitions (fn t (and (== @t.event ?event) (== @t.from @entity.active) (or (== ?to null) (== @t.to ?to)))))
        (let ((fired (array/findIndex @entity.transitions (fn t (and (== @t.event ?event) (== @t.from @entity.active) (or (== ?to null) (== @t.to ?to)))))))
          (let ((target (object/get (default (if (>= @fired 0) (array/nth @entity.transitions @fired) null) { from: "", to: "", event: "" }) to)))
            (do
              (set @entity.highlight (let ((at (array/find @entity.sourceLines (fn l (== @l.index @fired))))) { start: @at.start, end: @at.end }))
              (set @entity.fired @fired)
              (set @entity.visited (if (== (array/nth @entity.visited 0) @target) [@target] (array/append @entity.visited @target)))
              (set @entity.active @target))))
        (render-ui main @config.view)
      MOVES -> idle when (> (array/len (array/filter ?moves (fn m (and @m.fired (== @m.trait (object/get (default (as @entity.current TraitRef) { trait: "" }) trait)))))) 0)
        (let ((mine (array/filter ?moves (fn m (and @m.fired (== @m.trait (object/get (default (as @entity.current TraitRef) { trait: "" }) trait)))))))
          (let ((last (let ((nxi (- (array/len @mine) 1))) (if (>= @nxi 0) (array/nth @mine @nxi) null))))
            (let ((fired (array/findIndex @entity.transitions (fn t (and (== @t.event @last.event) (== @t.from @last.from) (== @t.to @last.to))))))
              (do
                (set @entity.highlight (let ((at (array/find @entity.sourceLines (fn l (== @l.index @fired))))) (if (== @at null) null { start: @at.start, end: @at.end })))
                (set @entity.fired @fired)
                (set @entity.visited (array/reduce @mine @entity.visited (fn acc m (if (== (array/nth @acc 0) @m.to) [@m.to] (array/append @acc @m.to)))))
                (set @entity.active @last.to)))))
        (render-ui main @config.view)
      MOVES -> idle when (== (array/len (array/filter ?moves (fn m (and @m.fired (== @m.trait (object/get (default (as @entity.current TraitRef) { trait: "" }) trait)))))) 0)
    }

    emits {
      DESCRIBED {
        result : DescribedSubject!
      }
        @tier "internal"
      DESCRIBE_FAILED {
        error : string!
      }
        @tier "internal"
    }

    listens {
      ADVANCE {
        event : string!
        to : string
      }
        @description "The demo took the transition named by this event from the current state; `to` names the target when the event has more than one arm from that state."
        @tier "internal"
      SUBJECT {
        behavior : string!
        trait : string!
      }
        @description "Describe another trait, named by its behavior and trait name, in place of the current one; the view resets to that trait's initial state."
      MOVES {
        moves : [MachineMove]!
        follow : boolean
      }
        @description "Transitions a running program took, in order, by trait name; the ones of the drawn trait that fired move the view to the last one's target."
      DESCRIBED {
        result : DescribedSubject!
      }
        @tier "internal"
      DESCRIBE_FAILED {
        error : string!
      }
        @tier "internal"
      RETRY
        @description "Try reading the diagram again."
        @tier "internal"
    }

    config {
      subject : trait
        @label "Trait"
        @description "The initial trait whose state machine is drawn: its states, transitions, guards and effects, exactly as the program runs them; without one the view waits for SUBJECT."
      showHeader : boolean = false
        @label "Show header"
        @description "Show the machine's name, entity, and what it listens to and emits above the diagram."
      codeShare : number = 1
        @label "Code share"
        @description "The code column's share at rest."
      diagramShare : number = 1
        @label "Diagram share"
        @description "The diagram column's share at rest."
      focusShare : number = 3
        @label "Hovered share"
        @description "The share the hovered or focused column grows to; the other keeps its own, so it shrinks."
      annotations : DiagramNotes = { states: {}, transitions: {}, effects: {} }
        @label "Notes"
        @description "Plain-language notes on the diagram's states, transitions and effects, shown on hover."
      view : render-ui = {
        type: split
        ratio: "1:1"
        gap: md
        stackBreakpoint: sm
        leftClassName: (str/concat "min-w-0 @sm:w-auto @sm:basis-0 transition-[flex-grow] duration-500 ease-out motion-reduce:transition-none @sm:grow-[" @config.diagramShare "] @sm:hover:grow-[" @config.focusShare "] @sm:focus-within:grow-[" @config.focusShare "]")
        rightClassName: (str/concat "min-w-0 @sm:w-auto @sm:basis-0 transition-[flex-grow] duration-500 ease-out motion-reduce:transition-none @sm:grow-[" @config.codeShare "] @sm:hover:grow-[" @config.focusShare "] @sm:focus-within:grow-[" @config.focusShare "]")
        children: [{
        type: state-machine-view
        description: (as @entity.subject SubjectExpr)
        showHeader: @config.showHeader
        annotations: @config.annotations
        activeState: @entity.active
        activeTransition: @entity.fired
        visitedStates: @entity.visited
        followActive: true
        direction: (i18n/direction)
        aria-label: (str/concat @entity.title " — " (i18n/t "diagram.label"))
        }, {
        type: code-block
        className: "p-0"
        code: @entity.sourceText
        language: "lolo"
        title: (str/concat @entity.title ".lolo")
        highlightLines: @entity.highlight
        maxHeight: "26rem"
        showCopyButton: true
        }]
      }
        @label "Diagram view"
        @tier "internal"
    }
  }

  ;; the whole-page view runs in the browser, so its state is always the client's (EXEC-DIST-4)
  trait LiveMachineOrbit -> @rebindable LiveMachineOrbitView [client] {
    initial: waiting

    state waiting {
      INIT -> waiting
        (render-ui main { type: state-machine-view, isLoading: true })
      ORBIT -> showing
        (set @entity.tree ?tree)
        (set @entity.behavior ?behavior)
        (set @entity.actives (array/flatten (array/map ?tree.traits (fn t (array/map @t.instances (fn i { trait: @t.trait, state: @i.state }))))))
        (set @entity.firedMove null)
        (set @entity.route [])
        (set @entity.focus null)
        (set @entity.title (default (array/nth (array/map (array/filter ?tree.traits (fn t (and (== @t.parent null) @t.renders (not @t.linked)))) (fn t @t.trait)) 0) ""))
        (set @entity.pinned false)
        (set @entity.sourceText "")
        (set @entity.sourceLines [])
        (set @entity.highlight null)
        (if (!= @entity.title "") (emit SOURCE_WANTED { behavior: @entity.behavior, trait: @entity.title }) null)
        (render-ui main @config.view)
      ORBIT_FAILED -> waiting
        (set @entity.behavior ?behavior)
        (render-ui main { type: error-state, title: (i18n/t "diagram.orbitFailed"), message: ?error, retryEvent: ORBIT_RETRY })
      ORBIT_RETRY -> waiting when (== @entity.guest "")
        (emit ORBIT_AGAIN { behavior: @entity.behavior })
      ORBIT_RETRY -> waiting when (!= @entity.guest "")
        (emit TREE_WANTED { guest: @entity.guest })
      GUEST_ORBIT -> waiting
        (set @entity.behavior ?behavior)
        (set @entity.guest ?guest)
        (set @entity.tree null)
        (set @entity.actives [])
        (set @entity.firedMove null)
        (set @entity.route [])
        (set @entity.focus null)
        (set @entity.title "")
        (set @entity.pinned false)
        (set @entity.sourceText "")
        (set @entity.sourceLines [])
        (set @entity.highlight null)
        (render-ui main { type: state-machine-view, isLoading: true })
        (emit TREE_WANTED { guest: ?guest })
      GUEST_TREE -> showing
        (set @entity.tree ?tree)
        (set @entity.actives (array/flatten (array/map ?tree.traits (fn t (array/map @t.instances (fn i { trait: @t.trait, state: @i.state }))))))
        (set @entity.firedMove null)
        (set @entity.route [])
        (set @entity.focus null)
        (set @entity.title (default (array/nth (array/map (array/filter ?tree.traits (fn t (and (== @t.parent null) @t.renders (not @t.linked)))) (fn t @t.trait)) 0) ""))
        (if (!= @entity.title "") (emit SOURCE_WANTED { behavior: @entity.behavior, trait: @entity.title }) null)
        (render-ui main @config.view)
      TREE_FAILED -> waiting
        (render-ui main { type: error-state, title: (i18n/t "diagram.orbitFailed"), message: ?error, retryEvent: ORBIT_RETRY })
      SELECT_TRAIT -> waiting
      PICK_TRAIT -> waiting
      FOCUS_MOVE -> waiting
      MOVES -> waiting
      SOURCE -> waiting
      SOURCE_FAILED -> waiting
    }

    state showing {
      INIT -> showing
        (render-ui main @config.view)
      FOCUS_MOVE -> showing
        (set @entity.focus { trait: ?trait, event: ?event, from: ?from, to: ?to, nonce: ?nonce })
        (render-ui main @config.view)
      ORBIT -> showing
        (set @entity.tree ?tree)
        (set @entity.behavior ?behavior)
        (set @entity.actives (array/flatten (array/map ?tree.traits (fn t (array/map @t.instances (fn i { trait: @t.trait, state: @i.state }))))))
        (set @entity.firedMove null)
        (set @entity.route [])
        (set @entity.focus null)
        (render-ui main @config.view)
      MOVES -> showing when (and (> (array/len (array/filter ?moves (fn m @m.fired))) 0) (== (object/get (default (let ((nxi (- (array/len (array/filter ?moves (fn m @m.fired))) 1))) (if (>= @nxi 0) (array/nth (array/filter ?moves (fn m @m.fired)) @nxi) null)) { trait: "", event: "", from: "", to: "", fired: false }) trait) @entity.title))
        (let ((last (default (let ((nxi (- (array/len (array/filter ?moves (fn m @m.fired))) 1))) (if (>= @nxi 0) (array/nth (array/filter ?moves (fn m @m.fired)) @nxi) null)) { trait: "", event: "", from: "", to: "", fired: false })))
          (let ((machine (array/find (object/get (default @entity.tree { page: "", traits: [], wires: [] }) traits) (fn t (== @t.trait @last.trait)))))
            (let ((index (if (== @machine null) -1 (array/findIndex @machine.transitions (fn x (and (== @x.event @last.event) (array/includes @x.from @last.from) (== @x.to @last.to)))))))
              (do
                (set @entity.actives (array/reduce (array/filter ?moves (fn m @m.fired)) @entity.actives (fn (acc m) (if (array/some @acc (fn a (and (== @a.trait @m.trait) (== @a.state @m.from)))) (array/map @acc (fn a (if (and (== @a.trait @m.trait) (== @a.state @m.from)) { trait: @m.trait, state: @m.to } @a))) (array/append @acc { trait: @m.trait, state: @m.to })))))
                (set @entity.firedMove { trait: @last.trait, index: @index })
                (set @entity.route (array/map (array/filter ?moves (fn m @m.fired)) (fn m (let ((machine (array/find (object/get (default @entity.tree { page: "", traits: [], wires: [] }) traits) (fn t (== @t.trait @m.trait))))) { trait: @m.trait, index: (if (== @machine null) -1 (array/findIndex @machine.transitions (fn x (and (== @x.event @m.event) (array/includes @x.from @m.from) (== @x.to @m.to))))) }))))
                (set @entity.highlight (let ((at (array/find @entity.sourceLines (fn l (== @l.index @index))))) (if (== @at null) null { start: @at.start, end: @at.end })))))))
        (render-ui main @config.view)
      MOVES -> showing when (and (> (array/len (array/filter ?moves (fn m @m.fired))) 0) (!= (object/get (default (let ((nxi (- (array/len (array/filter ?moves (fn m @m.fired))) 1))) (if (>= @nxi 0) (array/nth (array/filter ?moves (fn m @m.fired)) @nxi) null)) { trait: "", event: "", from: "", to: "", fired: false }) trait) @entity.title) (not @entity.pinned) (!= ?follow false))
        (let ((last (default (let ((nxi (- (array/len (array/filter ?moves (fn m @m.fired))) 1))) (if (>= @nxi 0) (array/nth (array/filter ?moves (fn m @m.fired)) @nxi) null)) { trait: "", event: "", from: "", to: "", fired: false })))
          (let ((machine (array/find (object/get (default @entity.tree { page: "", traits: [], wires: [] }) traits) (fn t (== @t.trait @last.trait)))))
            (let ((index (if (== @machine null) -1 (array/findIndex @machine.transitions (fn x (and (== @x.event @last.event) (array/includes @x.from @last.from) (== @x.to @last.to)))))))
              (do
                (set @entity.actives (array/reduce (array/filter ?moves (fn m @m.fired)) @entity.actives (fn (acc m) (if (array/some @acc (fn a (and (== @a.trait @m.trait) (== @a.state @m.from)))) (array/map @acc (fn a (if (and (== @a.trait @m.trait) (== @a.state @m.from)) { trait: @m.trait, state: @m.to } @a))) (array/append @acc { trait: @m.trait, state: @m.to })))))
                (set @entity.firedMove { trait: @last.trait, index: @index })
                (set @entity.route (array/map (array/filter ?moves (fn m @m.fired)) (fn m (let ((machine (array/find (object/get (default @entity.tree { page: "", traits: [], wires: [] }) traits) (fn t (== @t.trait @m.trait))))) { trait: @m.trait, index: (if (== @machine null) -1 (array/findIndex @machine.transitions (fn x (and (== @x.event @m.event) (array/includes @x.from @m.from) (== @x.to @m.to))))) }))))
                (do (set @entity.title @last.trait) (set @entity.sourceText "") (set @entity.sourceLines []) (set @entity.highlight null))))))
        (emit SOURCE_WANTED { behavior: @entity.behavior, trait: @entity.title })
        (render-ui main @config.view)
      MOVES -> showing when (and (> (array/len (array/filter ?moves (fn m @m.fired))) 0) (!= (object/get (default (let ((nxi (- (array/len (array/filter ?moves (fn m @m.fired))) 1))) (if (>= @nxi 0) (array/nth (array/filter ?moves (fn m @m.fired)) @nxi) null)) { trait: "", event: "", from: "", to: "", fired: false }) trait) @entity.title) (or @entity.pinned (= ?follow false)))
        (let ((last (default (let ((nxi (- (array/len (array/filter ?moves (fn m @m.fired))) 1))) (if (>= @nxi 0) (array/nth (array/filter ?moves (fn m @m.fired)) @nxi) null)) { trait: "", event: "", from: "", to: "", fired: false })))
          (let ((machine (array/find (object/get (default @entity.tree { page: "", traits: [], wires: [] }) traits) (fn t (== @t.trait @last.trait)))))
            (let ((index (if (== @machine null) -1 (array/findIndex @machine.transitions (fn x (and (== @x.event @last.event) (array/includes @x.from @last.from) (== @x.to @last.to)))))))
              (do
                (set @entity.actives (array/reduce (array/filter ?moves (fn m @m.fired)) @entity.actives (fn (acc m) (if (array/some @acc (fn a (and (== @a.trait @m.trait) (== @a.state @m.from)))) (array/map @acc (fn a (if (and (== @a.trait @m.trait) (== @a.state @m.from)) { trait: @m.trait, state: @m.to } @a))) (array/append @acc { trait: @m.trait, state: @m.to })))))
                (set @entity.firedMove { trait: @last.trait, index: @index })
                (set @entity.route (array/map (array/filter ?moves (fn m @m.fired)) (fn m (let ((machine (array/find (object/get (default @entity.tree { page: "", traits: [], wires: [] }) traits) (fn t (== @t.trait @m.trait))))) { trait: @m.trait, index: (if (== @machine null) -1 (array/findIndex @machine.transitions (fn x (and (== @x.event @m.event) (array/includes @x.from @m.from) (== @x.to @m.to))))) }))))
                (set @entity.highlight null)))))
        (render-ui main @config.view)
      MOVES -> showing when (== (array/len (array/filter ?moves (fn m @m.fired))) 0)
      SOURCE -> showing when (== ?trait @entity.title)
        (set @entity.sourceText ?text)
        (set @entity.sourceLines ?lines)
        (set @entity.highlight (let ((move (default @entity.firedMove { trait: "", index: -1 }))) (if (!= @move.trait ?trait) null (let ((at (array/find ?lines (fn l (== @l.index @move.index))))) (if (== @at null) null { start: @at.start, end: @at.end })))))
        (render-ui main @config.view)
      SOURCE -> showing when (!= ?trait @entity.title)
      SELECT_TRAIT -> showing when (and @entity.pinned (== ?trait @entity.title))
        (set @entity.pinned false)
        (render-ui main @config.view)
      SELECT_TRAIT -> showing when (or (not @entity.pinned) (!= ?trait @entity.title))
        (set @entity.pinned true)
        (set @entity.title ?trait)
        (set @entity.sourceText "")
        (set @entity.sourceLines [])
        (set @entity.highlight null)
        (emit SOURCE_WANTED { behavior: @entity.behavior, trait: ?trait })
        (render-ui main @config.view)
      PICK_TRAIT -> showing when (== ?trait @entity.title)
        (set @entity.pinned true)
        (render-ui main @config.view)
      PICK_TRAIT -> showing when (!= ?trait @entity.title)
        (set @entity.pinned true)
        (set @entity.title ?trait)
        (set @entity.sourceText "")
        (set @entity.sourceLines [])
        (set @entity.highlight null)
        (emit SOURCE_WANTED { behavior: @entity.behavior, trait: ?trait })
        (render-ui main @config.view)
      SOURCE_FAILED -> showing
        (set @entity.sourceText (str/concat ";; " ?error))
        (set @entity.sourceLines [])
        (set @entity.highlight null)
        (render-ui main @config.view)
      ORBIT_FAILED -> waiting
        (set @entity.behavior ?behavior)
        (render-ui main { type: error-state, title: (i18n/t "diagram.orbitFailed"), message: ?error, retryEvent: ORBIT_RETRY })
      ORBIT_RETRY -> showing
      GUEST_ORBIT -> waiting
        (set @entity.behavior ?behavior)
        (set @entity.guest ?guest)
        (set @entity.tree null)
        (set @entity.actives [])
        (set @entity.firedMove null)
        (set @entity.route [])
        (set @entity.focus null)
        (set @entity.title "")
        (set @entity.pinned false)
        (set @entity.sourceText "")
        (set @entity.sourceLines [])
        (set @entity.highlight null)
        (render-ui main { type: state-machine-view, isLoading: true })
        (emit TREE_WANTED { guest: ?guest })
      GUEST_TREE -> showing
        (set @entity.tree ?tree)
        (set @entity.actives (array/flatten (array/map ?tree.traits (fn t (array/map @t.instances (fn i { trait: @t.trait, state: @i.state }))))))
        (set @entity.firedMove null)
        (set @entity.route [])
        (set @entity.focus null)
        (render-ui main @config.view)
      TREE_FAILED -> waiting
        (render-ui main { type: error-state, title: (i18n/t "diagram.orbitFailed"), message: ?error, retryEvent: ORBIT_RETRY })
    }

    emits {
      ORBIT_AGAIN {
        behavior : string!
      }
        @description "Read the page again for its whole-page view."
        @tier "internal"
      SOURCE_WANTED {
        behavior : string!
        trait : string!
      }
        @description "The whole-page view needs the source of this trait: the page's root at first, then the chosen one or the one that moved last."
        @tier "internal"
      TREE_WANTED {
        guest : string!
      }
        @description "The whole-page view needs the mounted orbital of this guest session."
        @tier "internal"
    }

    listens {
      LiveMachineTrace.ORBIT -> ORBIT
      LiveMachineTrace.ORBIT_MOVES -> MOVES
      LiveMachineTrace.ORBIT_FAILED -> ORBIT_FAILED
      LiveMachineSource.SOURCE -> SOURCE
      LiveMachineSource.SOURCE_FAILED -> SOURCE_FAILED
      LiveMachineSource.GUEST_TREE -> GUEST_TREE
      LiveMachineSource.TREE_FAILED -> TREE_FAILED
      GUEST_ORBIT {
        behavior : string!
        guest : string!
      }
        @description "Draw a guest session (a handle program/open answered) whole and follow it: its mounted orbital is read on the server, and its moves arrive as MOVES."
        @synonyms "show the guest's whole page machine"
      GUEST_TREE {
        tree : MountedOrbital!
      }
        @tier "internal"
      TREE_FAILED {
        error : string!
      }
        @tier "internal"
      ORBIT {
        behavior : string!
        tree : MountedOrbital!
      }
        @description "The asking session's mounted orbital arrived: draw every trait of it, nested by where it is embedded, from its current state."
        @tier "internal"
      MOVES {
        moves : [MachineMove]!
        follow : boolean
      }
        @description "Transitions the page took, in order; the fired ones light their transition and move their trait's active state."
        @tier "internal"
      ORBIT_FAILED {
        behavior : string!
        error : string!
      }
        @tier "internal"
      ORBIT_RETRY
        @description "Try reading the page again."
        @tier "internal"
      FOCUS_MOVE {
        trait : string!
        event : string!
        from : string!
        to : string!
        nonce : number!
      }
        @description "Scroll the diagram to this trait's transition (its event from `from` to `to`), opening its box; the nonce changes with each request so asking for the same transition again scrolls again."
        @synonyms "scroll to a transition, show where an event fired in the diagram"
      SELECT_TRAIT {
        trait : string!
      }
        @description "Show this trait's source and keep it while other traits move; choosing it again lets the source follow the trait that moves."
        @synonyms "pin a trait's code, show this trait's source"
      PICK_TRAIT {
        trait : string!
      }
        @description "The trait picked from its output on the page with the inspect toggle: show its source and keep it, even when it is already the one shown."
        @synonyms "inspect an element, find the trait that drew this"
      SOURCE {
        trait : string!
        text : string!
        lines : [TransitionLines]!
      }
        @tier "internal"
      SOURCE_FAILED {
        error : string!
      }
        @tier "internal"
    }

    config {
      expandDepth : number = 1
        @label "Expand depth"
        @description "Traits shallower than this show their machine; deeper ones show as a box that opens in place."
      view : render-ui = {
        type: split
        ratio: "3:2"
        gap: md
        stackBreakpoint: md
        leftClassName: "min-w-0"
        rightClassName: "min-w-0"
        children: [{
        type: state-machine-view
        orbital: @entity.tree
        activeStates: @entity.actives
        firedTransition: @entity.firedMove
        route: @entity.route
        expandDepth: @config.expandDepth
        selectedTrait: @entity.title
        focusTarget: @entity.focus
        selectEvent: SELECT_TRAIT
        pickEvent: PICK_TRAIT
        ;; side by side both columns fill the panel; stacked they share it (the code under its 2.875rem title bar)
        className: "[--live-machine-diagram:45dvh] @md:[--live-machine-diagram:calc(100dvh_-_7rem)]"
        maxHeight: "var(--live-machine-diagram)"
        direction: (i18n/direction)
        aria-label: (i18n/t "diagram.orbitLabel")
        }, {
        type: code-block
        className: "p-0 [--live-machine-code:calc(55dvh_-_11rem)] @md:[--live-machine-code:calc(100dvh_-_10rem)]"
        code: @entity.sourceText
        isLoading: (and (!= @entity.title "") (== @entity.sourceText ""))
        language: "lolo"
        title: (if (== @entity.title "") (i18n/t "diagram.orbitNoSource") (str/concat @entity.title ".lolo"))
        highlightLines: @entity.highlight
        maxHeight: "var(--live-machine-code)"
        showCopyButton: true
        }]
      }
        @label "Whole-page view"
        @tier "internal"
    }
  }

  ;; one state, so its server copy always takes DESCRIBE whatever the client-run view has seen
  trait LiveMachineSource -> LiveMachineSourceView [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      DESCRIBE -> idle
        (behavior/describe { behavior: ?behavior, trait: ?trait } { emit: { success: DESCRIBED, failure: DESCRIBE_FAILED } })
      DESCRIBED -> idle
        (emit SOURCE { trait: ?result.value.trait, text: ?result.source.text, lines: ?result.source.transitions })
      DESCRIBE_FAILED -> idle
        (emit SOURCE_FAILED { error: ?error })
      READ_TREE -> idle
        (program/self { mounted: true, guest: ?guest, emit: { success: GUEST_MOUNTED, failure: GUEST_MOUNT_FAILED } })
      GUEST_MOUNTED -> idle
        (emit GUEST_TREE { tree: ?result })
      GUEST_MOUNT_FAILED -> idle
        (emit TREE_FAILED { error: ?error })
    }

    emits {
      SOURCE {
        trait : string!
        text : string!
        lines : [TransitionLines]!
      }
        @tier "internal"
      SOURCE_FAILED {
        error : string!
      }
        @tier "internal"
      GUEST_TREE {
        tree : MountedOrbital!
      }
        @tier "internal"
      TREE_FAILED {
        error : string!
      }
        @tier "internal"
      GUEST_MOUNTED -> internal {
        result : MountedOrbital!
      }
        @tier "internal"
      GUEST_MOUNT_FAILED -> internal {
        error : string!
      }
        @tier "internal"
    }

    listens {
      LiveMachineOrbit.SOURCE_WANTED -> DESCRIBE
      LiveMachineOrbit.TREE_WANTED -> READ_TREE
      DESCRIBE {
        behavior : string!
        trait : string!
      }
        @tier "internal"
      DESCRIBED {
        result : DescribedSourceOf!
      }
        @tier "internal"
      DESCRIBE_FAILED {
        error : string!
      }
        @tier "internal"
      READ_TREE {
        guest : string!
      }
        @tier "internal"
      GUEST_MOUNTED {
        result : MountedOrbital!
      }
        @tier "internal"
      GUEST_MOUNT_FAILED {
        error : string!
      }
        @tier "internal"
    }
  }


  ;; following the page is std-page-trace's: one subscription per site, observers left out (EXEC-DIST-14)
  trait LiveMachineTrace -> LiveMachineTraceView [client] {
    initial: closed

    state closed {
      INIT -> closed
      ORBITAL_SUBJECT -> following
        (set @entity.behavior ?behavior)
        (emit TRACE_OPEN { key: "live-machine" })
      ORBITAL_CLOSE -> closed
    }

    state following {
      INIT -> closed
      PAGE_READY -> following
        (emit ORBIT { behavior: @entity.behavior, tree: ?tree })
      PAGE_MOVED -> following
        (emit ORBIT_MOVES { moves: (array/map (default ?dispatch.outcomes []) (fn o { trait: @o.trait, event: (default @o.event ""), from: @o.from, to: @o.to, fired: @o.executed })) })
      PAGE_FAILED -> closed
        (emit ORBIT_FAILED { behavior: @entity.behavior, error: ?error })
      ORBITAL_CLOSE -> closed
        (emit TRACE_CLOSE {})
      ORBITAL_SUBJECT -> following
        (set @entity.behavior ?behavior)
        (emit TRACE_OPEN { key: "live-machine" })
    }

    emits {
      ORBIT {
        behavior : string!
        tree : MountedOrbital!
      }
        @tier "internal"
      ORBIT_MOVES {
        moves : [MachineMove]!
      }
        @tier "internal"
      ORBIT_FAILED {
        behavior : string!
        error : string!
      }
        @tier "internal"
      TRACE_OPEN {
        key : string!
      }
        @tier "internal"
      TRACE_CLOSE {
      }
        @tier "internal"
    }

    listens {
      LiveMachineOrbit.ORBIT_AGAIN -> ORBITAL_SUBJECT
      ORBITAL_SUBJECT {
        behavior : string!
      }
        @description "Draw the running page of this behavior whole and follow it: read the asking session's mounted orbital, then trace every trait in it."
        @synonyms "show the whole page machine, trace the page"
      ORBITAL_CLOSE
        @description "Stop following the page: close its trace subscriptions."
      LiveMachinePageTrace.PAGE_TRACE_READY -> PAGE_READY
      LiveMachinePageTrace.PAGE_TRACED -> PAGE_MOVED
      LiveMachinePageTrace.PAGE_TRACE_FAILED -> PAGE_FAILED
      PAGE_READY {
        key : string!
        tree : MountedOrbital!
      }
        @tier "internal"
      PAGE_MOVED {
        key : string!
        dispatch : TraceDispatch!
      }
        @description "One dispatch of the page, with each trait's move."
        @tier "internal"
      PAGE_FAILED {
        key : string!
        error : string!
      }
        @tier "internal"
    }
  }

  trait LiveMachinePageTrace = PageTrace.traits.PageTrace {
    listens {
      LiveMachineTrace.TRACE_OPEN -> PAGE_TRACE_OPEN
      LiveMachineTrace.TRACE_CLOSE -> PAGE_TRACE_CLOSE
    }
  }


  page "/live-machine" as LiveMachinePage -> LiveMachine
  page "/live-machine/:view" as LiveOrbitPage -> LiveMachineOrbit, LiveMachineTrace, LiveMachinePageTrace, LiveMachineSource
}
