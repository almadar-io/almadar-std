app std-rasm-hscroll [
  version: "0.1.0",
  description: "std-rasm-hscroll — a strip of items that travels sideways while the page scrolls down, then lets go. Its anchor is a tall section placed by the page: while the anchor's top is above the view's top and its bottom below the view's bottom, the strip's paints stay in the view (the page scroll is cancelled for them) and slide along the reading direction until the last item is in view; scrolling on releases them and the section leaves. The atom places the items itself, one equal card per id in `items` along a row inside the anchor (card width a fraction of the anchor's width, centred in the view below the `lead` space kept for a heading), and sends the surface two RASM_SCRUBs, `<id>` for the paints that travel (`moves`) and `<id>:hold` for the paints that only stay (`holds`, a heading or a progress bar), with a `dwell` fraction of the scroll at each end where the strip rests. On the breakpoints in `stackOn` nothing is pinned or moved: the items are placed one under another at the anchor's width and the scrubs are neutral, so a phone reads the cards as a column. The page scroll drives everything, so the keyboard, the wheel and touch all move it, and nothing loops."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmScrubFrame = { at : number!, opacity : number, offsetX : number, offsetY : number, scale : number, rotate : number, dashOffset : number }

orbital RasmHscrollOrbital {
  entity RasmHscrollRun [runtime] {
    id : string!
    rect : RasmRect? @description "The anchor's rect from RASM_PLACE, null until it is placed." = null
    viewH : number @description "The canvas height from RASM_RESIZE." = 0
    bp : string @description "The current breakpoint name." = "desktop"
    dir : "ltr" | "rtl" @description "The surface's reading direction." = "ltr"
    sends : number @description "Counts sends, so each send in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmHscroll -> RasmHscrollRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.sends (+ @entity.sends 1))
        (emit HSCROLL_SEND { n: @entity.sends })
      RASM_BREAKPOINT -> ready
        (set @entity.bp ?name)
        (set @entity.sends (+ @entity.sends 1))
        (emit HSCROLL_SEND { n: @entity.sends })
      RASM_RESIZE -> ready when (= ?height @entity.viewH)
      RASM_RESIZE -> ready when (!= ?height @entity.viewH)
        (set @entity.viewH ?height)
        (set @entity.sends (+ @entity.sends 1))
        (emit HSCROLL_SEND { n: @entity.sends })
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.anchor))) (let ((mine (array/find ?placed (fn p (= @p.id @config.anchor)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h))))
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.anchor))) (not (let ((mine (array/find ?placed (fn p (= @p.id @config.anchor)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h)))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.anchor))))) (if (= @mine null) @entity.rect @mine.rect)))
        (set @entity.sends (+ @entity.sends 1))
        (emit HSCROLL_SEND { n: @entity.sends })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.anchor))))
      HSCROLL_SEND -> ready when (and (!= @entity.rect null) (> @entity.viewH 0))
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (n (array/len @config.items)) (rtl (= @entity.dir "rtl")) (stacked (array/includes @config.stackOn @entity.bp)) (stage (if (> @config.height 0) @config.height @entity.viewH)))
          (let ((cw (* @r.w (if (= @entity.bp "tablet") @config.cardWidthTablet @config.cardWidth))) (ch (math/min @config.cardH (- @stage @config.lead))))
            (let ((step (+ @cw @config.gap)) (travel (math/max 0 (- (+ (+ (* 2 @config.pad) (* @n @cw)) (* (math/max 0 (- @n 1)) @config.gap)) @r.w))) (range (math/max 0 (- @r.h @entity.viewH))))
              (do
                (emit RASM_PLACE { n: @entity.sends, placed: (array/map @config.items (fn id (let ((i (array/indexOf @config.items @id))) (if @stacked { id: @id, rect: { x: (+ @r.x @config.pad), y: (+ (+ @r.y @config.lead) (* @i (+ @config.phoneCardH @config.gap))), w: (- @r.w (* 2 @config.pad)), h: @config.phoneCardH } } { id: @id, rect: { x: (if @rtl (- (- (- (+ @r.x @r.w) @config.pad) @cw) (* @i @step)) (+ (+ @r.x @config.pad) (* @i @step))), y: (+ (+ @r.y @config.lead) (/ (- (- @stage @config.lead) @ch) 2)), w: @cw, h: @ch } })))) })
                (emit RASM_SCRUB { id: @config.id, paints: (array/concat @config.items @config.moves), from: @r.y, to: (+ @r.y (math/max 1 @range)), keyframes: (if (or @stacked (= @range 0)) [{ at: 0, offsetX: 0, offsetY: 0 }, { at: 1, offsetX: 0, offsetY: 0 }] [{ at: 0, offsetX: 0, offsetY: 0 }, { at: @config.dwell, offsetX: 0, offsetY: (* @config.dwell @range) }, { at: (- 1 @config.dwell), offsetX: (* (if @rtl 1 -1) @travel), offsetY: (* (- 1 @config.dwell) @range) }, { at: 1, offsetX: (* (if @rtl 1 -1) @travel), offsetY: @range }]) })
                (emit HSCROLL_HOLD { n: @entity.sends })))))
      HSCROLL_SEND -> ready when (not (and (!= @entity.rect null) (> @entity.viewH 0)))
      HSCROLL_HOLD -> ready when (!= @entity.rect null)
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (stacked (array/includes @config.stackOn @entity.bp)))
          (let ((range (math/max 0 (- @r.h @entity.viewH))))
            (emit RASM_SCRUB { id: (str/concat @config.id ":hold"), paints: @config.holds, from: @r.y, to: (+ @r.y (math/max 1 @range)), keyframes: (if (or @stacked (= @range 0)) [{ at: 0, offsetY: 0 }, { at: 1, offsetY: 0 }] [{ at: 0, offsetY: 0 }, { at: 1, offsetY: @range }]) })))
      HSCROLL_HOLD -> ready when (= @entity.rect null)
    }

    emits {
      HSCROLL_SEND -> internal {
        n : number!
      }
        @description "Place the items and send the travelling scrub once the anchor is placed and the canvas sized."
        @tier "internal"
      HSCROLL_HOLD -> internal {
        n : number!
      }
        @description "Send the scrub of the paints that only stay in the view."
        @tier "internal"
      RASM_PLACE -> external {
        n : number!
        placed : [RasmPlaced]!
      }
        @description "The rects of the items: one row inside the anchor, or one column on a stacked breakpoint."
        @tier "primary"
      RASM_SCRUB -> external {
        id : string!
        paints : [string]!
        from : number!
        to : number!
        keyframes : [RasmScrubFrame]!
      }
        @description "The strip's travelling paints, and (id suffixed :hold) the held paints, with the scroll range of the pin and their keyframes."
        @tier "primary"
    }

    listens {
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the anchor's rect when it is placed."
      RASM_RESIZE { width : number!  height : number! }
        @description "Take the canvas height, the view the pin is measured in."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction: under rtl the strip starts at the right edge and travels right."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "The current breakpoint: the ones in stackOn stack the items instead of pinning the strip."
    }

    config {
      id : string = "hscroll"
        @label "Id"
        @description "The travelling scrub's id; the held paints' scrub is this id suffixed :hold."
        @tier "presentation"
      anchor : string = ""
        @label "Anchor"
        @description "The placed id of the tall section the pin lasts across; its height beyond the view is the scroll the strip travels for."
        @tier "presentation"
      items : [string] = []
        @label "Items"
        @description "The ids of the cards, in reading order; each is placed as a card and travels with the strip."
        @tier "presentation"
      moves : [string] = []
        @label "Moving paints"
        @description "Other paint ids that travel with the strip, such as the children painted inside the cards."
        @tier "presentation"
      holds : [string] = []
        @label "Held paints"
        @description "The paint ids that stay in the view while the section is pinned and do not travel (a heading, a progress mark)."
        @tier "presentation"
      height : number = 0
        @label "Stage height"
        @description "The height in px of the pinned stage the cards are centred in; 0 uses the canvas height."
        @tier "presentation"
      lead : number = 0
        @label "Lead"
        @description "Space in px kept at the top of the stage (and of the stacked column) for the held heading."
        @tier "presentation"
      cardWidth : number = 0.34
        @label "Card width"
        @description "A card's width as a fraction of the anchor's width on the desktop and wide breakpoints."
        @tier "presentation"
      cardWidthTablet : number = 0.56
        @label "Card width on tablet"
        @description "A card's width as a fraction of the anchor's width on the tablet breakpoint."
        @tier "presentation"
      cardH : number = 420
        @label "Card height"
        @description "A card's height in px in the row, narrowed to fit the stage below the lead."
        @tier "presentation"
      phoneCardH : number = 320
        @label "Stacked card height"
        @description "A card's height in px when the items are stacked in a column."
        @tier "presentation"
      gap : number = 24
        @label "Gap"
        @description "Space in px between cards, in the row and in the stacked column."
        @tier "presentation"
      pad : number = 32
        @label "Padding"
        @description "Space in px before the first and after the last card, and at the sides of a stacked column."
        @tier "presentation"
      dwell : number = 0.08
        @label "Dwell"
        @description "The fraction of the pinned scroll, at the start and at the end, where the strip rests before it travels and after it has arrived."
        @tier "presentation"
      stackOn : [string] = ["phone"]
        @label "Stack on"
        @description "The breakpoints where nothing is pinned and the items are placed in a column."
        @tier "presentation"
    }
  }

  page boot as RasmHscrollStart -> RasmHscroll
}
