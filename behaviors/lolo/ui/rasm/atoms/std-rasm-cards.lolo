app std-rasm-cards [
  version: "0.1.0",
  description: "std-rasm-cards — a grid of cards on the Rasm canvas, painted from the records RASM_CARDS hands it: each card a title (kept to `titleLines` lines, its font size shrinking to `titleMinSize` before it would run into the body), an optional body and an optional badge (literal text, or `badgeKey`, a message key the surface paints in the visitor's language), in the card/surface/<state> (falling back to stack/card/idle), text/card/idle, text/body/idle and text/eyebrow/idle looks. With `interactive` each card is a focusable, activatable control (idle, hovered, focused and pressed surfaces, role and name for assistive technology, an `action` event carrying its index, a 24px minimum hit region); otherwise it is a named group. Optional parts: `media` (an image field, cover-cropped at the card top), `header` (the badge in a band), `divider` (a rule between title and body) and `meta` (a bottom line). It holds no rows of its own: a program reads its data and sends the records. With `turn` on each card is a pointer region: entering it turns the card over (its face fades up and away and its `back` text rises in under its title) and leaving turns it back. With variantBy breakpoint and `variants` the column count, gap and card height change per breakpoint. With `scatter` card i is tilted and shifted by scatter[i mod n]; a card shifted down makes its row that much taller, so the next row never runs into it. With `groupBy` set the cards are laid out in one column per value in `groups`, in that order, each column holding only its group's records in arrival order; a record whose value is not in `groups` is not shown. Under rtl each row starts at the right edge and the text aligns right. Once placed it fits as many rows of `cols` cards as its rect holds. On a std-rasm-surface with pageScroll on the cards arrive the first time the grid's top crosses the `viewAt` line of the view: each rises and fades in, `staggerMs` after the one before; until then they wait unseen."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmInset = { stroke : string!, strokeWidth : number!, gap : number! }
type RasmLook = { inset : RasmInset, fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop, on : string, backing : "none" | "halo" | "plate" }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]!, startMs : number }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation?, rotate : number?, pivotX : number?, pivotY : number? }
type RasmMeter = { lo : number!, hi : number!, at : number!, ref : number?, loText : string, hiText : string }
type RasmCard = { title : string!, body : string, badge : string, badgeKey : MessageKey, back : string, meter : RasmMeter }
type RasmScatter = { offsetX : number!, offsetY : number!, rotate : number! }
type RasmCardsShape = { columns : number, gap : number, cardH : number, groupBy : string }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmGeo = { band : number!, bdgH : number!, badgeRel : number!, titleRel : number!, titleH : number!, bodyRel : number!, metaH : number!, own : number! }
type RasmCell = { c : RasmCard!, col : number!, row : number! }
type KeyedCard = { title : string!, badgeKey : MessageKey! }

orbital RasmCardsOrbital {
  entity RasmCardsRun [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The grid's rect from RASM_PLACE, null until placed." = null
    cards : [RasmCard] @description "The records the last RASM_CARDS sent." = []
    viewH : number @description "The canvas height from RASM_RESIZE." = 0
    offset : number @description "The page scroll from RASM_PAGE_SCROLLED." = 0
    arrivedMs : number @description "The epoch-ms instant the cards began to arrive, 0 before they have been seen." = 0
    dir : "ltr" | "rtl" @description "The reading direction the surface announced; rtl starts each row at the right edge." = "ltr"
    variant : string @description "The key of `variants` the announced breakpoint chose, empty for the configured shape." = ""
    hot : number @description "The card the pointer is over, -1 for none; with turn or interactive on." = -1
    focus : number @description "The interactive card RASM_FOCUS last named, -1 for none." = -1
    pressing : number @description "The interactive card a pointer press began on, -1 for none." = -1
    turned : number @description "The card the pointer has turned over, -1 for none." = -1
    was : number @description "The card last turned back, -1 for none; its back face fades away." = -1
    turnedMs : number @description "The epoch-ms instant of the last turn either way." = 0
    measured : Map string RasmMeasureItem @description "The latest measured size of each card text, by text id." = {}
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmCards -> RasmCardsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) @entity.rect @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_BREAKPOINT -> ready when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_BREAKPOINT -> ready when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_RESIZE -> ready
        (set @entity.viewH ?height)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_PAGE_SCROLLED -> ready
        (set @entity.offset ?offset)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_POINTER -> ready
        (let ((plates (array/map (array/range (array/len @entity.cards)) (fn i (str/concat @config.id ":card:" @i ":plate")))))
          (let ((idx (array/indexOf @plates ?id)))
            (let ((hoverOn (and (or @config.turn @config.interactive) (= ?kind "enter") (>= @idx 0))) (hoverOff (and (or @config.turn @config.interactive) (= ?kind "leave") (>= @idx 0) (= @idx @entity.hot))) (press (and @config.interactive (= ?kind "down") (>= @idx 0))) (release (and @config.interactive (= ?kind "up") (>= @entity.pressing 0))))
              (do
                (when (and @release (= @idx @entity.pressing))
                  (emit @config.action { index: @idx }))
                (when (or @hoverOn @hoverOff @press @release)
                  (do
                    (set @entity.hot (if @hoverOn @idx (if @hoverOff -1 @entity.hot)))
                    (when (and @config.turn (or @hoverOn @hoverOff))
                      (do
                        (set @entity.was @entity.turned)
                        (set @entity.turned (if @hoverOn @idx -1))
                        (set @entity.turnedMs (time/epoch-ms @now))))
                    (set @entity.pressing (if @press @idx -1))
                    (set @entity.paints (+ @entity.paints 1))
                    (emit CARDS_PAINT { n: @entity.paints })))))))
      RASM_FOCUS -> ready
        (let ((idx (if @config.interactive (array/indexOf (array/map (array/range (array/len @entity.cards)) (fn i (str/concat @config.id ":card:" @i ":plate"))) ?id) -1)))
          (when (!= @idx @entity.focus)
            (do
              (set @entity.focus @idx)
              (set @entity.paints (+ @entity.paints 1))
              (emit CARDS_PAINT { n: @entity.paints }))))
      RASM_ACTIVATE -> ready
        (let ((idx (if @config.interactive (array/indexOf (array/map (array/range (array/len @entity.cards)) (fn i (str/concat @config.id ":card:" @i ":plate"))) ?id) -1)))
          (when (>= @idx 0)
            (emit @config.action { index: @idx })))
      RASM_CARDS -> ready when (= ?id @config.id)
        (set @entity.cards ?cards)
        (set @entity.turned -1)
        (set @entity.was -1)
        (set @entity.hot -1)
        (set @entity.pressing -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_CARDS -> ready when (!= ?id @config.id)
      RASM_MEASURED -> ready when (array/some ?items (fn it (and (str/startsWith @it.id (str/concat @config.id ":card:")) (let ((m (object/get @entity.measured @it.id null))) (or (= @m null) (!= @m.height @it.height) (!= @m.lines @it.lines))))))
        (set @entity.measured (array/reduce ?items @entity.measured (fn acc it (if (str/startsWith @it.id (str/concat @config.id ":card:")) (object/set @acc @it.id @it) @acc))))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_MEASURED -> ready when (not (array/some ?items (fn it (and (str/startsWith @it.id (str/concat @config.id ":card:")) (let ((m (object/get @entity.measured @it.id null))) (or (= @m null) (!= @m.height @it.height) (!= @m.lines @it.lines)))))))
      CARDS_PAINT -> ready when (and (!= @entity.rect null) (> (array/len @entity.cards) 0))
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (sh (object/get @config.variants @entity.variant null)))
          (do
            (when (and (= @entity.arrivedMs 0) (> @entity.viewH 0) (< @r.y (+ @entity.offset (* @entity.viewH @config.viewAt))))
              (set @entity.arrivedMs (time/epoch-ms @now)))
            (let ((gb (default (if (= @sh null) null @sh.groupBy) @config.groupBy)) (gapPx (default (if (= @sh null) null @sh.gap) @config.gap)) (cardHt (default (if (= @sh null) null @sh.cardH) @config.cardH)) (colsCfg (default (if (= @sh null) null @sh.columns) @config.cols)) (card (default (object/get @entity.looks "card/surface/idle" null) (default (object/get @entity.looks "stack/card/idle" null) {}))) (title (default (object/get @entity.looks "text/card/idle" null) {})) (body (default (object/get @entity.looks (if (= @config.bodyLook "meta") "card/meta/idle" "text/body/idle") null) {})) (badge (default (object/get @entity.looks "text/eyebrow/idle" null) {})) (hdr (default (object/get @entity.looks "card/header/idle" null) {})) (med (default (object/get @entity.looks "card/media/idle" null) {})) (dvd (default (object/get @entity.looks "card/divider/idle" null) {})) (meta (default (object/get @entity.looks "card/meta/idle" null) {})) (cols (math/max 1 (if (!= @gb "") (array/len @config.groups) @colsCfg))))
              (let ((cw (/ (- @r.w (* @gapPx (- @cols 1))) @cols)))
                (let ((cells : [RasmCell] (if (= @gb "") (array/map (array/range (array/len @entity.cards)) (fn i (let ((blank : RasmCard { title: "" })) { c: (default (array/nth @entity.cards @i) @blank), col: (math/mod @i @cols), row: (math/floor (/ @i @cols)) }))) (let ((member (array/filter @entity.cards (fn c (array/includes @config.groups (object/get @c @gb "")))))) (array/map (array/range (array/len @member)) (fn k (let ((blank : RasmCard { title: "" }) (mine (default (array/nth @member @k) @blank))) { c: @mine, col: (array/indexOf @config.groups (object/get @mine @gb "")), row: (array/len (array/filter (array/take @member @k) (fn d (= (object/get @d @gb "") (object/get @mine @gb ""))))) }))))))
                      (pad @config.padding) (mediaPx (if (or (!= @config.media "") @config.meter) @config.mediaH 0)) (hdrPx (if @config.header @config.headerH 0)) (tt (if @config.header 0 @config.titleTop)) (titleBlock (* @config.titleLines @config.titleLineH)) (dvdSw (default @dvd.strokeWidth 1)) (out { durationMs: @config.turnMs, loop: false, startMs: @entity.turnedMs, keyframes: [{ at: 0, opacity: 1, offsetY: 0 }, { at: 1, opacity: 0, offsetY: -12 }] }) (inn { durationMs: @config.turnMs, loop: false, startMs: @entity.turnedMs, keyframes: [{ at: 0, opacity: 0, offsetY: 12 }, { at: 1, opacity: 1, offsetY: 0 }] }))
                  (let ((blankGeo : RasmGeo { band: 0, bdgH: 0, badgeRel: 0, titleRel: 0, titleH: 0, bodyRel: 0, metaH: 0, own: @cardHt }) (blankRc : RasmCard { title: "" }) (blankCl : RasmCell { c: @blankRc, col: 0, row: 0 }) (geo : [RasmGeo] (array/map (array/range (array/len @cells)) (fn i (let ((blank : RasmCard { title: "" }) (blankCell : RasmCell { c: @blank, col: 0, row: 0 })) (let ((c (let ((cell (default (array/nth @cells @i) @blankCell))) @cell.c))) (let ((hasBadge (or (!= @c.badgeKey null) (!= (default @c.badge "") ""))) (bdgM (object/get @entity.measured (str/concat @config.id ":card:" @i (if (!= @c.badgeKey null) ":badge" ":tag")) null)) (ttlM (object/get @entity.measured (str/concat @config.id ":card:" @i ":title") null)) (bodyM (object/get @entity.measured (str/concat @config.id ":card:" @i ":body") null)) (metaM (object/get @entity.measured (str/concat @config.id ":card:" @i ":meta") null)) (backM (object/get @entity.measured (str/concat @config.id ":card:" @i ":back") null)) (metaText (if (!= @config.meta "") (object/get @c @config.meta "") "")))
                    (let ((bdgH (if (and @hasBadge (!= @bdgM null)) @bdgM.height 0)) (titleH (math/max @titleBlock (if (and (!= @c.title "") (!= @ttlM null)) @ttlM.height 0))) (bodyH (if (and (!= (default @c.body "") "") (!= @bodyM null)) @bodyM.height 0)) (metaH (if (and (!= @metaText "") (!= @metaM null)) @metaM.height 0)) (backH (if (and (!= (default @c.back "") "") (!= @backM null)) @backM.height 0)))
                      (let ((band (if @config.header (math/max @hdrPx (if @hasBadge (+ @bdgH @pad) 0)) 0)))
                        (let ((titleRel (+ (+ (+ @mediaPx @band) @pad) (if @config.header 0 (math/max @tt @bdgH)))))
                          (let ((bodyRel (+ (+ @titleRel @titleH) (if @config.divider (+ (* 2 @config.dividerGap) @dvdSw) 0))))
                            { band: @band, bdgH: @bdgH, badgeRel: (if @config.header (+ @mediaPx (/ (- @band @bdgH) 2)) (+ (+ @mediaPx @band) @pad)), titleRel: @titleRel, titleH: @titleH, bodyRel: @bodyRel, metaH: @metaH, own: (math/max @cardHt (+ (math/max (+ (+ @bodyRel @bodyH) (if (> @metaH 0) (+ @config.dividerGap @metaH) 0)) (+ @titleRel @backH)) @pad)) })))))))))))
                    (let ((nrows (array/reduce @cells 0 (fn a x (math/max @a (+ @x.row 1))))))
                      (let ((rowHs (array/map (array/range @nrows) (fn rr (array/reduce (array/filter (array/range (array/len @cells)) (fn k (let ((ck (default (array/nth @cells @k) @blankCl))) (= @ck.row @rr)))) @cardHt (fn a k (let ((gk (default (array/nth @geo @k) @blankGeo))) (math/max @a @gk.own))))))) (rowDrops (array/map (array/range @nrows) (fn rr (array/reduce (array/filter (array/range (array/len @cells)) (fn k (let ((ck (default (array/nth @cells @k) @blankCl))) (= @ck.row @rr)))) 0 (fn a k (math/max @a (math/max 0 (let ((sk (if (= (array/len @config.scatter) 0) { offsetX: 0, offsetY: 0, rotate: 0 } (default (array/nth @config.scatter (math/mod @k (array/len @config.scatter))) { offsetX: 0, offsetY: 0, rotate: 0 })))) @sk.offsetY)))))))))
                        (let ((laid (array/map (array/range (array/len @cells)) (fn i (let ((blank : RasmCard { title: "" }) (blankCell : RasmCell { c: @blank, col: 0, row: 0 }) (cell (default (array/nth @cells @i) @blankCell)) (c @cell.c) (g (default (array/nth @geo @i) @blankGeo)) (sc (if (= (array/len @config.scatter) 0) { offsetX: 0, offsetY: 0, rotate: 0 } (default (array/nth @config.scatter (math/mod @i (array/len @config.scatter))) { offsetX: 0, offsetY: 0, rotate: 0 })))) { i: @i, c: @c, g: @g, ox: @sc.offsetX, oy: @sc.offsetY, rot: @sc.rotate, h: (if (= @gb "") (default (array/nth @rowHs @cell.row) @cardHt) @g.own), x: (+ @r.x (* (if (= @entity.dir "rtl") (- (- @cols 1) @cell.col) @cell.col) (+ @cw @gapPx))), y: (+ @r.y (if (= @gb "") (array/reduce (array/range @cell.row) 0 (fn a rr (+ (+ (+ @a (default (array/nth @rowHs @rr) 0)) (default (array/nth @rowDrops @rr) 0)) @gapPx))) (array/reduce (array/filter (array/range (array/len @cells)) (fn k (let ((ck (default (array/nth @cells @k) @blankCell))) (and (= @ck.col @cell.col) (< @ck.row @cell.row))))) 0 (fn a k (let ((gk (default (array/nth @geo @k) @blankGeo))) (+ (+ (+ @a @gk.own) (math/max 0 (let ((sk (if (= (array/len @config.scatter) 0) { offsetX: 0, offsetY: 0, rotate: 0 } (default (array/nth @config.scatter (math/mod @k (array/len @config.scatter))) { offsetX: 0, offsetY: 0, rotate: 0 })))) @sk.offsetY))) @gapPx)))))), st: (if (= @entity.turned @i) "on" (if (= @entity.was @i) "off" "rest")), ls: (if (= @entity.pressing @i) "pressed" (if (= @entity.focus @i) "focused" (if (= @entity.hot @i) "hovered" "idle"))), anim: (if (= @entity.arrivedMs 0) { durationMs: 1, loop: false, startMs: 0, keyframes: [{ at: 0, opacity: 0, offsetY: 24 }, { at: 1, opacity: 0, offsetY: 24 }] } { durationMs: @config.arriveMs, startMs: (+ @entity.arrivedMs (* @i @config.staggerMs)), loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 24 }, { at: 1, opacity: 1, offsetY: 0 }] }) })))))
                          (do
                            (emit RASM_EXTENT { n: ?n, id: @config.id, w: @r.w, h: (- (array/reduce @laid 0 (fn a l (math/max @a (+ @l.y @l.h)))) @r.y) })
                            (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: (array/map (array/filter @laid (fn l (!= @l.c.badgeKey null))) (fn l { id: (str/concat @config.id ":card:" @l.i ":badge"), key: (let ((k (as @l.c KeyedCard))) @k.badgeKey), x: (+ (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad)) @l.ox), y: (+ (+ @l.y @l.g.badgeRel) @l.oy), z: @config.z, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "top", color: (if @config.header @hdr.textColor @badge.textColor), font: (if @config.header @hdr.font @badge.font), width: (- @cw (* 2 @pad)), wrap: true, measure: true, animation: (if (= @l.st "on") @out (if (= @l.st "off") @inn @l.anim)), rotate: @l.rot, pivotX: (+ (+ @l.x (/ @cw 2)) @l.ox), pivotY: (+ (+ @l.y (/ @l.h 2)) @l.oy) })), nodes: (array/map @laid (fn l (let ((tx (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad))) (al (if (= @entity.dir "rtl") "right" "left")) (tw (- @cw (* 2 @pad))) (surf (default (object/get @entity.looks (str/concat "card/surface/" @l.ls) null) @card)) (pid (str/concat @config.id ":card:" @l.i ":plate")) (tid (str/concat @config.id ":card:" @l.i ":title")) (url (object/get @l.c @config.media "")) (titleY (+ @l.y @l.g.titleRel)) (bodyY (+ @l.y @l.g.bodyRel)) (metaText (if (!= @config.meta "") (object/get @l.c @config.meta "") "")) (small (and @config.interactive (or (< @cw @config.minTarget) (< @l.h @config.minTarget)))))
                        (let ((front : [node] (array/concat [{ type: draw-text, id: (str/concat @config.id ":card:" @l.i ":tag"), text: (if (= @l.c.badgeKey null) (default @l.c.badge "") ""), anchor: "top-left", position: { x: @tx, y: (+ @l.y @l.g.badgeRel), z: @config.z }, align: @al, baseline: "top", color: (if @config.header @hdr.textColor @badge.textColor), font: (if @config.header @hdr.font @badge.font), width: @tw, wrap: true, measure: (and (= @l.c.badgeKey null) (!= (default @l.c.badge "") "")), hit: false }, { type: draw-text, id: @tid, text: @l.c.title, anchor: "top-left", position: { x: @tx, y: @titleY, z: @config.z }, align: @al, baseline: "top", color: @title.textColor, font: @title.font, width: @tw, height: @titleBlock, fit: "shrink", minSize: @config.titleMinSize, wrap: true, measure: (!= @l.c.title ""), hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":body"), text: (default @l.c.body ""), anchor: "top-left", position: { x: @tx, y: @bodyY, z: @config.z }, align: @al, baseline: "top", color: @body.textColor, font: @body.font, width: @tw, wrap: true, measure: (!= (default @l.c.body "") ""), hit: false }] (if @config.divider [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":divider"), anchor: "top-left", position: { x: (+ @l.x @pad), y: (+ @titleY (+ @l.g.titleH @config.dividerGap)), z: @config.z }, width: @tw, height: @dvdSw, fill: @dvd.stroke, hit: false }] []) (if (!= @config.meta "") [{ type: draw-text, id: (str/concat @config.id ":card:" @l.i ":meta"), text: (object/get @l.c @config.meta ""), anchor: "top-left", position: { x: @tx, y: (- (+ @l.y @l.h) (+ @pad @l.g.metaH)), z: @config.z }, align: @al, baseline: "top", color: @meta.textColor, font: @meta.font, width: @tw, wrap: true, measure: (!= @metaText ""), hit: false }] []))) (backs : [node] [{ type: draw-text, id: (str/concat @config.id ":card:" @l.i ":backTitle"), text: @l.c.title, anchor: "top-left", position: { x: @tx, y: (+ @l.y (+ @mediaPx (+ @l.g.band @pad))), z: @config.z }, align: @al, baseline: "top", color: @badge.textColor, font: @badge.font, width: @tw, wrap: false, hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":back"), text: (default @l.c.back ""), anchor: "top-left", position: { x: @tx, y: @titleY, z: @config.z }, align: @al, baseline: "top", color: @title.textColor, font: @body.font, width: @tw, wrap: true, measure: (!= (default @l.c.back "") ""), hit: false }]) (plate : node { type: draw-shape, shape: "rect", id: @pid, anchor: "top-left", position: { x: @l.x, y: @l.y, z: @config.z }, width: @cw, height: @l.h, fill: @surf.fill, stroke: @surf.stroke, strokeWidth: @surf.strokeWidth, inset: @surf.inset, corners: @surf.corners, shadow: @surf.shadow, material: @surf.material, spring: @surf.spring, hit: (or @config.turn @config.interactive), semantic: (if @config.interactive { role: @config.role, labelledBy: @tid, disabled: false, order: (+ @config.order @l.i), focused: (= @entity.focus @l.i) } { role: "group", labelledBy: @tid }) }) (target : [node] (if @small [{ type: draw-shape, shape: "rect", id: @pid, anchor: "top-left", position: { x: (- @l.x (/ (math/max 0 (- @config.minTarget @cw)) 2)), y: (- @l.y (/ (math/max 0 (- @config.minTarget @l.h)) 2)), z: @config.z }, width: (math/max @cw @config.minTarget), height: (math/max @l.h @config.minTarget), fill: "rgba(0,0,0,0)", hit: true }] [])) (mediaNodes : [node] (if @config.meter (let ((m @l.c.meter) (trk (default (object/get @entity.looks "card/meter/track" null) { fill: "muted" })) (fil (default (object/get @entity.looks "card/meter/fill" null) { fill: "primary" })) (cap (default (object/get @entity.looks "text/caption/idle" null) { textColor: "muted-foreground", font: "400 13px body" }))) (if (= @m null) [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":mediaSlot"), anchor: "top-left", position: { x: @l.x, y: @l.y, z: @config.z }, width: @cw, height: @config.mediaH, fill: @med.fill, corners: @med.corners, hit: false }] (let ((x0 (+ @l.x @config.padding)) (mw (- @cw (* 2 @config.padding))) (ty (+ @l.y (/ @config.mediaH 2))) (span (math/max 0.000001 (- @m.hi @m.lo)))) (let ((fx (* @mw (math/min 1 (math/max 0 (/ (- @m.at @m.lo) @span))))) (rx (if (= @m.ref null) -1 (* @mw (math/min 1 (math/max 0 (/ (- (default @m.ref 0) @m.lo) @span))))))) (array/concat [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":mediaSlot"), anchor: "top-left", position: { x: @l.x, y: @l.y, z: @config.z }, width: @cw, height: @config.mediaH, fill: @med.fill, corners: @med.corners, hit: false }, { type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":meterTrack"), anchor: "top-left", position: { x: @x0, y: @ty, z: @config.z }, width: @mw, height: 6, fill: @trk.fill, corners: { radius: [3, 3, 3, 3], kind: "round" }, hit: false }, { type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":meterFill"), anchor: "top-left", position: { x: @x0, y: @ty, z: @config.z }, width: (math/max 6 @fx), height: 6, fill: @fil.fill, corners: { radius: [3, 3, 3, 3], kind: "round" }, hit: false }, { type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":meterAt"), anchor: "top-left", position: { x: (- (+ @x0 @fx) 2), y: (- @ty 9), z: @config.z }, width: 4, height: 24, fill: @fil.fill, corners: { radius: [2, 2, 2, 2], kind: "round" }, hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":meterLo"), text: (default @m.loText ""), anchor: "top-left", position: { x: @x0, y: (+ @ty 22), z: @config.z }, align: "left", baseline: "top", color: @cap.textColor, font: @cap.font, hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":meterHi"), text: (default @m.hiText ""), anchor: "top-left", position: { x: (+ @x0 @mw), y: (+ @ty 22), z: @config.z }, align: "right", baseline: "top", color: @cap.textColor, font: @cap.font, hit: false }] (if (< @rx 0) [] [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":meterRef"), anchor: "top-left", position: { x: (- (+ @x0 @rx) 1), y: (- @ty 5), z: @config.z }, width: 2, height: 16, fill: @trk.fill, hit: false }])))))) (if (= @config.media "") [] (array/concat [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":mediaSlot"), anchor: "top-left", position: { x: @l.x, y: @l.y, z: @config.z }, width: @cw, height: @config.mediaH, fill: @med.fill, corners: @med.corners, hit: false }] (if (= @url "") [] (let ((mr (default (array/first (default @med.corners.radius [0])) 0))) [{ type: draw-group, id: (str/concat @config.id ":card:" @l.i ":mediaClip"), position: { x: 0, y: 0 }, clip: (str/concat "M " @l.x " " (+ @l.y @config.mediaH) " L " @l.x " " (+ @l.y @mr) " A " @mr " " @mr " 0 0 1 " (+ @l.x @mr) " " @l.y " L " (- (+ @l.x @cw) @mr) " " @l.y " A " @mr " " @mr " 0 0 1 " (+ @l.x @cw) " " (+ @l.y @mr) " L " (+ @l.x @cw) " " (+ @l.y @config.mediaH) " Z"), items: [{ type: draw-sprite, id: (str/concat @config.id ":card:" @l.i ":media"), asset: { url: @url }, fit: "cover", anchor: "top-left", position: { x: @l.x, y: @l.y, z: @config.z }, width: @cw, height: @config.mediaH }] }])))))) (headerNodes : [node] (if @config.header [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":header"), anchor: "top-left", position: { x: @l.x, y: (+ @l.y @mediaPx), z: @config.z }, width: @cw, height: @l.g.band, fill: @hdr.fill, stroke: @hdr.stroke, strokeWidth: @hdr.strokeWidth, corners: (if (> @mediaPx 0) { radius: [0, 0, 0, 0], kind: "round" } @hdr.corners), hit: false }] [])))
                          (let ((cardg : node { type: draw-group, id: (str/concat @config.id ":card:" @l.i), position: { x: 0, y: 0 }, animation: @l.anim, items: (array/concat [@plate] @target @mediaNodes @headerNodes (if (= @l.st "rest") @front [{ type: draw-group, id: (str/concat @config.id ":card:" @l.i ":front"), position: { x: 0, y: 0 }, animation: (if (= @l.st "on") @out @inn), items: @front }, { type: draw-group, id: (str/concat @config.id ":card:" @l.i ":backFace"), position: { x: 0, y: 0 }, animation: (if (= @l.st "on") @inn @out), items: @backs }])) })) (if (= (array/len @config.scatter) 0) @cardg (let ((cx (+ @l.x (/ @cw 2))) (cy (+ @l.y (/ @l.h 2)))) { type: draw-group, id: (str/concat @config.id ":card:" @l.i ":scatter"), position: { x: (+ @cx @l.ox), y: (+ @cy @l.oy) }, rotate: @l.rot, items: [{ type: draw-group, id: (str/concat @config.id ":card:" @l.i ":origin"), position: { x: (- 0 @cx), y: (- 0 @cy) }, items: [@cardg] }] }))))))) })))))))))))
      CARDS_PAINT -> ready when (not (and (!= @entity.rect null) (> (array/len @entity.cards) 0)))
    }

    emits {
      CARDS_PAINT -> internal {
        n : number!
      }
        @description "Repaint the grid from the stored rect, looks, records and scroll."
        @tier "internal"
      @config.action -> external {
        index : number!
      }
        @description "An interactive card was released over itself or activated from the keyboard; index is its position in the records."
        @tier "domain"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The cards: one group per card (plate, badge, title, body) carrying its arrival."
        @tier "primary"
      RASM_EXTENT -> external {
        n : number!
        id : string!
        w : number!
        h : number!
      }
        @description "The grid's content height after each paint: every row as tall as its tallest card, each card as tall as its measured text needs and never shorter than cardH, plus the gaps. A parent stack measures the grid by it and grows."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the grid's rect when it is placed."
      RASM_RESIZE { width : number!  height : number! }
        @description "Take the canvas height, the view arrival is measured against."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the variant is the first name of chain (the announced breakpoint, then each smaller declared one, stopping at desktop) that `variants` holds, none of them keeping the configured shape, which is the desktop composition; the grid repaints when the variant changes. With any other variantBy it is ignored."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "Take the reading direction: rtl starts each row at the right edge and aligns the text right."
      RASM_PAGE_SCROLLED { offset : number!  max : number! }
        @description "Take the page scroll; the cards arrive the first time the grid reaches the view line."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "With `turn` on, the pointer entering a card turns it over and leaving turns it back."
      RASM_FOCUS { id : string! }
        @description "With interactive on, the card whose plate id this is takes the focused look; any other id clears it."
      RASM_ACTIVATE { id : string! }
        @description "With interactive on, keyboard activation of the card whose plate id this is emits action with its index."
      RASM_CARDS { id : string!  cards : [RasmCard]! }
        @description "The records to paint, for the grid with this id."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Canvas text measurements, wired from the surface's RASM_MEASURED: the badge, title, body, meta and back texts of this grid's cards. The cards lay out again from them when one changes."
    }

    config {
      id : string = "cards"
        @label "Id"
        @description "The grid's RASM_PLACE key, paint id and RASM_CARDS address."
        @tier "presentation"
      z : number = 2
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      cols : number = 3
        @label "Columns"
        @description "Cards per row."
        @tier "presentation"
      gap : number = 18
        @label "Gap"
        @description "Space between cards in px."
        @tier "presentation"
      cardH : number = 170
        @label "Card height"
        @description "Each card's height in px; the grid shows as many rows as its rect holds."
        @tier "presentation"
      padding : number = 18
        @label "Padding"
        @description "Space inside a card in px."
        @tier "presentation"
      titleTop : number = 24
        @label "Title offset"
        @description "The title's distance below the badge line in px."
        @tier "presentation"
      titleLines : number = 2
        @label "Title lines"
        @description "The lines kept for a title, so a title that wraps never runs into the body."
        @tier "presentation"
      titleMinSize : number = 12
        @label "Title smallest size"
        @description "A title is kept to titleLines lines: when it needs more, its font size steps down to this many px (fit shrink); at that size a longer title ends in an ellipsis."
        @tier "presentation"
      scatter : [RasmScatter] = []
        @label "Scatter"
        @description "A tilt and shift per card, applied to card i as scatter[i mod n] (offsetX and offsetY in px, rotate in radians; its badge, title and body move with it); empty leaves the grid square."
        @tier "presentation"
      groupBy : string = ""
        @label "Group by"
        @description "The name of the record field whose value picks each card's column. Set, the grid has one column per value in groups, in that order (cols is ignored), each holding only its group's cards in arrival order, top down; a card whose value is not in groups is not shown. Empty lays the cards out in rows as before."
        @tier "presentation"
      groups : [string] = []
        @label "Groups"
        @description "With groupBy, the ordered values of that field, one column each: a kanban lists To do, Doing and Done."
        @tier "presentation"
      variantBy : "" | "breakpoint" = ""
        @label "Variant by"
        @description "\"breakpoint\" picks a shape from `variants` by the surface's breakpoint name, falling back to the next smaller declared variant (desktop and wide stop at desktop), then to the configured shape; empty keeps the configured shape."
        @tier "presentation"
      variants : Map string RasmCardsShape = {}
        @label "Variants"
        @description "Shapes by breakpoint name (phone, tablet, desktop, wide): the columns, gap, cardH and groupBy a variant names replace cols, gap, cardH and groupBy while that breakpoint is current; one it leaves out keeps the configured value. A phone variant with an empty groupBy lays a kanban out as one plain list."
        @tier "presentation"
      titleLineH : number = 26
        @label "Title line height"
        @description "The height of one title line in px."
        @tier "presentation"
      turn : boolean = false
        @label "Turn on hover"
        @description "Each card is a pointer region: entering one turns it over to its `back` text under its title, leaving turns it back."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Each card is a control: it takes focus in the focus order (its id is `<id>:card:<index>:plate`), paints card/surface/hovered, focused and pressed, announces `role` with its title as its name, and a release over it or keyboard activation emits `action` with `{ index }`, the card's index. Off, a card announces a group named by its title."
        @tier "presentation"
      role : "button" | "link" = "button"
        @label "Role"
        @description "What an interactive card announces to assistive technology."
        @tier "presentation"
      order : number = 0
        @label "Order"
        @description "Reading order of the first interactive card's semantic node; card i takes order + i."
        @tier "domain"
      action : event = RASM_ACTION
        @label "Action"
        @description "The event an interactive card emits, with `{ index }`, when it is released over itself or activated from the keyboard."
        @tier "domain"
      minTarget : number = 24
        @label "Smallest hit target"
        @description "An interactive card placed smaller than this many px in width or height keeps its painted size and gets a transparent hit region of at least this size, centred on it. 0 turns it off."
        @tier "presentation"
      meter : boolean = false
        @label "Meter"
        @description "On, the media slot shows each record's meter, a range { lo, hi, at, ref?, loText, hiText }: the media slot (mediaH tall) shows a horizontal meter instead of a picture: a track from lo to hi in card/meter/track, filled to at with a marker in card/meter/fill, a tick at ref when given, and loText and hiText under its ends in text/caption/idle; a record without a meter shows the empty slot. It takes precedence over media. Off paints no meter."
        @tier "presentation"
      media : string = ""
        @label "Media field"
        @description "The name of the record field holding an image URL. Set, each card has a media slot at its top, mediaH tall, painted in card/media/idle, with the image cropped to cover it when the record has a URL; the header, title and body sit below it. Empty paints no media."
        @tier "presentation"
      mediaH : number = 96
        @label "Media height"
        @description "With media, the media slot's height in px."
        @tier "presentation"
      header : boolean = false
        @label "Header band"
        @description "The badge is set in a band across the card's top (below any media), painted in card/header/idle with that look's text colour and font, instead of on the first line."
        @tier "presentation"
      headerH : number = 36
        @label "Header height"
        @description "With header, the band's height in px."
        @tier "presentation"
      divider : boolean = false
        @label "Divider"
        @description "A rule in card/divider/idle between the title and the body, dividerGap below the title block, the body starting dividerGap below the rule."
        @tier "presentation"
      dividerGap : number = 8
        @label "Divider gap"
        @description "With divider, the space in px above and below the rule."
        @tier "presentation"
      meta : string = ""
        @label "Meta field"
        @description "The name of the record field holding a meta line, painted in card/meta/idle along the card's bottom edge. Empty paints none."
        @tier "presentation"
      bodyLook : "body" | "meta" = "body"
        @label "Body look"
        @description "body paints the body text in text/body/idle; meta paints it in card/meta/idle, the quieter secondary look."
        @tier "presentation"
      turnMs : number = 360
        @label "Turn"
        @description "How long a card takes to turn either way, in ms."
        @tier "presentation"
      viewAt : number = 0.85
        @label "View line"
        @description "Where in the view, as a fraction of its height from the top, the grid's top must pass for the cards to arrive."
        @tier "presentation"
      arriveMs : number = 620
        @label "Arrival"
        @description "How long one card takes to rise and fade in, in ms."
        @tier "presentation"
      staggerMs : number = 70
        @label "Stagger"
        @description "The delay between one card's arrival and the next, in ms."
        @tier "presentation"
    }
  }

  page boot as RasmCardsStart -> RasmCards
}
