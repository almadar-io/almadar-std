app std-rasm-cards [
  version: "0.1.0",
  description: "std-rasm-cards — a grid of cards on the Rasm canvas, painted from the records RASM_CARDS hands it: each card a title (kept to `titleLines` lines, its font size shrinking to `titleMinSize` before it would run into the body), an optional body and an optional badge (literal text, or `badgeKey`, a message key the surface paints in the visitor's language), in the stack/card/idle, text/card/idle, text/body/idle and text/eyebrow/idle looks. It holds no rows of its own: a program reads its data and sends the records. With `turn` on each card is a pointer region: entering it turns the card over (its face fades up and away and its `back` text rises in under its title) and leaving turns it back. With variantBy breakpoint and `variants` the column count, gap and card height change per breakpoint. With `scatter` card i is tilted and shifted by scatter[i mod n]. With `groupBy` set the cards are laid out in one column per value in `groups`, in that order, each column holding only its group's records in arrival order; a record whose value is not in `groups` is not shown. Under rtl each row starts at the right edge and the text aligns right. Once placed it fits as many rows of `cols` cards as its rect holds. On a std-rasm-surface with pageScroll on the cards arrive the first time the grid's top crosses the `viewAt` line of the view: each rises and fades in, `staggerMs` after the one before; until then they wait unseen."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]!, startMs : number }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation?, rotate : number?, pivotX : number?, pivotY : number? }
type RasmCard = { title : string!, body : string, badge : string, badgeKey : MessageKey, back : string }
type RasmScatter = { offsetX : number!, offsetY : number!, rotate : number! }
type RasmCardsShape = { columns : number, gap : number, cardH : number, groupBy : string }
type RasmCell = { c : RasmCard!, col : number!, row : number! }
type KeyedCard = { title : string!, badgeKey : MessageKey! }

orbital RasmCardsOrbital {
  entity RasmCardsRun [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The grid's rect from RASM_PLACE, null until placed." = null
    cards : [RasmCard] @description "The records the last RASM_CARDS sent." = []
    viewH : number @description "The canvas height from RASM_RESIZE." = 0
    offset : number @description "The page scroll from RASM_PAGE_SCROLLED." = 0
    arrivedMs : number @description "The epoch-ms instant the cards began to arrive, 0 before they have been seen." = 0
    dir : "ltr" | "rtl" @description "The reading direction the surface announced; rtl starts each row at the right edge." = "ltr"
    variant : string @description "The key of `variants` the announced breakpoint chose, empty for the configured shape." = ""
    turned : number @description "The card the pointer has turned over, -1 for none." = -1
    was : number @description "The card last turned back, -1 for none; its back face fades away." = -1
    turnedMs : number @description "The epoch-ms instant of the last turn either way." = 0
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmCards -> RasmCardsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) @entity.rect @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_BREAKPOINT -> ready when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_BREAKPOINT -> ready when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_RESIZE -> ready
        (set @entity.viewH ?height)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_PAGE_SCROLLED -> ready
        (set @entity.offset ?offset)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_POINTER -> ready when (and @config.turn (= ?kind "enter") (array/includes (array/map (array/range (array/len @entity.cards)) (fn i (str/concat @config.id ":card:" @i ":plate"))) ?id))
        (set @entity.was @entity.turned)
        (set @entity.turned (array/indexOf (array/map (array/range (array/len @entity.cards)) (fn i (str/concat @config.id ":card:" @i ":plate"))) ?id))
        (set @entity.turnedMs (time/epoch-ms @now))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_POINTER -> ready when (and @config.turn (= ?kind "leave") (> @entity.turned -1) (= ?id (str/concat @config.id ":card:" @entity.turned ":plate")))
        (set @entity.was @entity.turned)
        (set @entity.turned -1)
        (set @entity.turnedMs (time/epoch-ms @now))
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_POINTER -> ready when (not (or (and @config.turn (= ?kind "enter") (array/includes (array/map (array/range (array/len @entity.cards)) (fn i (str/concat @config.id ":card:" @i ":plate"))) ?id)) (and @config.turn (= ?kind "leave") (> @entity.turned -1) (= ?id (str/concat @config.id ":card:" @entity.turned ":plate")))))
      RASM_CARDS -> ready when (= ?id @config.id)
        (set @entity.cards ?cards)
        (set @entity.turned -1)
        (set @entity.was -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit CARDS_PAINT { n: @entity.paints })
      RASM_CARDS -> ready when (!= ?id @config.id)
      CARDS_PAINT -> ready when (and (!= @entity.rect null) (> (array/len @entity.cards) 0))
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (sh (object/get @config.variants @entity.variant null)))
          (do
            (when (and (= @entity.arrivedMs 0) (> @entity.viewH 0) (< @r.y (+ @entity.offset (* @entity.viewH @config.viewAt))))
              (set @entity.arrivedMs (time/epoch-ms @now)))
            (let ((gb (default (if (= @sh null) null @sh.groupBy) @config.groupBy)) (gapPx (default (if (= @sh null) null @sh.gap) @config.gap)) (cardHt (default (if (= @sh null) null @sh.cardH) @config.cardH)) (colsCfg (default (if (= @sh null) null @sh.columns) @config.cols)) (card (default (object/get @entity.looks "stack/card/idle" null) {})) (title (default (object/get @entity.looks "text/card/idle" null) {})) (body (default (object/get @entity.looks "text/body/idle" null) {})) (badge (default (object/get @entity.looks "text/eyebrow/idle" null) {})) (cols (math/max 1 (if (!= @gb "") (array/len @config.groups) @colsCfg))))
              (let ((cw (/ (- @r.w (* @gapPx (- @cols 1))) @cols)) (rows (math/max 1 (math/floor (default (/ (+ @r.h @gapPx) (+ @cardHt @gapPx)) 0)))))
                (let ((cells : [RasmCell] (if (= @gb "") (let ((taken (array/take @entity.cards (* @rows @cols)))) (array/map (array/range (array/len @taken)) (fn i (let ((blank : RasmCard { title: "" })) { c: (default (array/nth @taken @i) @blank), col: (math/mod @i @cols), row: (math/floor (/ @i @cols)) })))) (let ((member (array/filter @entity.cards (fn c (array/includes @config.groups (object/get @c @gb ""))))))  (array/filter (array/map (array/range (array/len @member)) (fn k (let ((blank : RasmCard { title: "" }) (mine (default (array/nth @member @k) @blank))) { c: @mine, col: (array/indexOf @config.groups (object/get @mine @gb "")), row: (array/len (array/filter (array/take @member @k) (fn d (= (object/get @d @gb "") (object/get @mine @gb ""))))) }))) (fn x (< @x.row @rows)))))) (pad @config.padding) (out { durationMs: @config.turnMs, loop: false, startMs: @entity.turnedMs, keyframes: [{ at: 0, opacity: 1, offsetY: 0 }, { at: 1, opacity: 0, offsetY: -12 }] }) (inn { durationMs: @config.turnMs, loop: false, startMs: @entity.turnedMs, keyframes: [{ at: 0, opacity: 0, offsetY: 12 }, { at: 1, opacity: 1, offsetY: 0 }] }))
                  (let ((laid (array/map (array/range (array/len @cells)) (fn i (let ((blank : RasmCard { title: "" }) (blankCell : RasmCell { c: @blank, col: 0, row: 0 }) (cell (default (array/nth @cells @i) @blankCell)) (c @cell.c) (sc (if (= (array/len @config.scatter) 0) { offsetX: 0, offsetY: 0, rotate: 0 } (default (array/nth @config.scatter (math/mod @i (array/len @config.scatter))) { offsetX: 0, offsetY: 0, rotate: 0 })))) { i: @i, c: @c, ox: @sc.offsetX, oy: @sc.offsetY, rot: @sc.rotate, x: (+ @r.x (* (if (= @entity.dir "rtl") (- (- @cols 1) @cell.col) @cell.col) (+ @cw @gapPx))), y: (+ @r.y (* @cell.row (+ @cardHt @gapPx))), st: (if (= @entity.turned @i) "on" (if (= @entity.was @i) "off" "rest")), anim: (if (= @entity.arrivedMs 0) { durationMs: 1, loop: false, startMs: 0, keyframes: [{ at: 0, opacity: 0, offsetY: 24 }, { at: 1, opacity: 0, offsetY: 24 }] } { durationMs: @config.arriveMs, loop: false, startMs: (+ @entity.arrivedMs (* @i @config.staggerMs)), keyframes: [{ at: 0, opacity: 0, offsetY: 24 }, { at: 1, opacity: 1, offsetY: 0 }] }) })))))
                    (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: (array/map (array/filter @laid (fn l (!= @l.c.badgeKey null))) (fn l { id: (str/concat @config.id ":card:" @l.i ":badge"), key: (let ((k (as @l.c KeyedCard))) @k.badgeKey), x: (+ (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad)) @l.ox), y: (+ (+ @l.y @pad) @l.oy), z: @config.z, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "top", color: @badge.textColor, font: @badge.font, width: (- @cw (* 2 @pad)), wrap: false, animation: (if (= @l.st "on") @out (if (= @l.st "off") @inn @l.anim)), rotate: @l.rot, pivotX: (+ (+ @l.x (/ @cw 2)) @l.ox), pivotY: (+ (+ @l.y (/ @cardHt 2)) @l.oy) })), nodes: (array/map @laid (fn l (let ((tx (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad))) (al (if (= @entity.dir "rtl") "right" "left")) (tw (- @cw (* 2 @pad)))) (let ((front : [node] [{ type: draw-text, id: (str/concat @config.id ":card:" @l.i ":tag"), text: (if (= @l.c.badgeKey null) (default @l.c.badge "") ""), anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad)), y: (+ @l.y @pad), z: @config.z }, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "top", color: @badge.textColor, font: @badge.font, width: (- @cw (* 2 @pad)), wrap: false, hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":title"), text: @l.c.title, anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad)), y: (+ @l.y (+ @pad @config.titleTop)), z: @config.z }, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "top", color: @title.textColor, font: @title.font, width: (- @cw (* 2 @pad)), height: (* @config.titleLines @config.titleLineH), fit: "shrink", minSize: @config.titleMinSize, maxLines: @config.titleLines, truncate: true, wrap: true, hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":body"), text: (default @l.c.body ""), anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (- (+ @l.x @cw) @pad) (+ @l.x @pad)), y: (+ @l.y (+ @pad (+ @config.titleTop (* @config.titleLines @config.titleLineH)))), z: @config.z }, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "top", color: @body.textColor, font: @body.font, width: (- @cw (* 2 @pad)), wrap: true, hit: false }]) (backs : [node] [{ type: draw-text, id: (str/concat @config.id ":card:" @l.i ":backTitle"), text: @l.c.title, anchor: "top-left", position: { x: @tx, y: (+ @l.y @pad), z: @config.z }, align: @al, baseline: "top", color: @badge.textColor, font: @badge.font, width: @tw, wrap: false, hit: false }, { type: draw-text, id: (str/concat @config.id ":card:" @l.i ":back"), text: (default @l.c.back ""), anchor: "top-left", position: { x: @tx, y: (+ @l.y (+ @pad @config.titleTop)), z: @config.z }, align: @al, baseline: "top", color: @title.textColor, font: @body.font, width: @tw, wrap: true, hit: false }])) (let ((cardg : node { type: draw-group, id: (str/concat @config.id ":card:" @l.i), position: { x: 0, y: 0 }, animation: @l.anim, items: (array/concat [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":card:" @l.i ":plate"), anchor: "top-left", position: { x: @l.x, y: @l.y, z: @config.z }, width: @cw, height: @cardHt, fill: @card.fill, stroke: @card.stroke, strokeWidth: @card.strokeWidth, corners: @card.corners, shadow: @card.shadow, material: @card.material, hit: @config.turn }] (if (= @l.st "rest") @front [{ type: draw-group, id: (str/concat @config.id ":card:" @l.i ":front"), position: { x: 0, y: 0 }, animation: (if (= @l.st "on") @out @inn), items: @front }, { type: draw-group, id: (str/concat @config.id ":card:" @l.i ":backFace"), position: { x: 0, y: 0 }, animation: (if (= @l.st "on") @inn @out), items: @backs }])) })) (if (= (array/len @config.scatter) 0) @cardg (let ((cx (+ @l.x (/ @cw 2))) (cy (+ @l.y (/ @cardHt 2)))) { type: draw-group, id: (str/concat @config.id ":card:" @l.i ":scatter"), position: { x: (+ @cx @l.ox), y: (+ @cy @l.oy) }, rotate: @l.rot, items: [{ type: draw-group, id: (str/concat @config.id ":card:" @l.i ":origin"), position: { x: (- 0 @cx), y: (- 0 @cy) }, items: [@cardg] }] }))))))) })))))))
      CARDS_PAINT -> ready when (not (and (!= @entity.rect null) (> (array/len @entity.cards) 0)))
    }

    emits {
      CARDS_PAINT -> internal {
        n : number!
      }
        @description "Repaint the grid from the stored rect, looks, records and scroll."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The cards: one group per card (plate, badge, title, body) carrying its arrival."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the grid's rect when it is placed."
      RASM_RESIZE { width : number!  height : number! }
        @description "Take the canvas height, the view arrival is measured against."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the variant is the first name of chain (the announced breakpoint, then each smaller declared one, stopping at desktop) that `variants` holds, none of them keeping the configured shape, which is the desktop composition; the grid repaints when the variant changes. With any other variantBy it is ignored."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "Take the reading direction: rtl starts each row at the right edge and aligns the text right."
      RASM_PAGE_SCROLLED { offset : number!  max : number! }
        @description "Take the page scroll; the cards arrive the first time the grid reaches the view line."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "With `turn` on, the pointer entering a card turns it over and leaving turns it back."
      RASM_CARDS { id : string!  cards : [RasmCard]! }
        @description "The records to paint, for the grid with this id."
    }

    config {
      id : string = "cards"
        @label "Id"
        @description "The grid's RASM_PLACE key, paint id and RASM_CARDS address."
        @tier "presentation"
      z : number = 2
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      cols : number = 3
        @label "Columns"
        @description "Cards per row."
        @tier "presentation"
      gap : number = 18
        @label "Gap"
        @description "Space between cards in px."
        @tier "presentation"
      cardH : number = 170
        @label "Card height"
        @description "Each card's height in px; the grid shows as many rows as its rect holds."
        @tier "presentation"
      padding : number = 18
        @label "Padding"
        @description "Space inside a card in px."
        @tier "presentation"
      titleTop : number = 24
        @label "Title offset"
        @description "The title's distance below the badge line in px."
        @tier "presentation"
      titleLines : number = 2
        @label "Title lines"
        @description "The lines kept for a title, so a title that wraps never runs into the body."
        @tier "presentation"
      titleMinSize : number = 12
        @label "Title smallest size"
        @description "A title is kept to titleLines lines: when it needs more, its font size steps down to this many px (fit shrink); at that size a longer title ends in an ellipsis."
        @tier "presentation"
      scatter : [RasmScatter] = []
        @label "Scatter"
        @description "A tilt and shift per card, applied to card i as scatter[i mod n] (offsetX and offsetY in px, rotate in radians; its badge, title and body move with it); empty leaves the grid square."
        @tier "presentation"
      groupBy : string = ""
        @label "Group by"
        @description "The name of the record field whose value picks each card's column. Set, the grid has one column per value in groups, in that order (cols is ignored), each holding only its group's cards in arrival order, top down; a card whose value is not in groups is not shown. Empty lays the cards out in rows as before."
        @tier "presentation"
      groups : [string] = []
        @label "Groups"
        @description "With groupBy, the ordered values of that field, one column each: a kanban lists To do, Doing and Done."
        @tier "presentation"
      variantBy : "" | "breakpoint" = ""
        @label "Variant by"
        @description "\"breakpoint\" picks a shape from `variants` by the surface's breakpoint name, falling back to the next smaller declared variant (desktop and wide stop at desktop), then to the configured shape; empty keeps the configured shape."
        @tier "presentation"
      variants : Map string RasmCardsShape = {}
        @label "Variants"
        @description "Shapes by breakpoint name (phone, tablet, desktop, wide): the columns, gap, cardH and groupBy a variant names replace cols, gap, cardH and groupBy while that breakpoint is current; one it leaves out keeps the configured value. A phone variant with an empty groupBy lays a kanban out as one plain list."
        @tier "presentation"
      titleLineH : number = 26
        @label "Title line height"
        @description "The height of one title line in px."
        @tier "presentation"
      turn : boolean = false
        @label "Turn on hover"
        @description "Each card is a pointer region: entering one turns it over to its `back` text under its title, leaving turns it back."
        @tier "presentation"
      turnMs : number = 360
        @label "Turn"
        @description "How long a card takes to turn either way, in ms."
        @tier "presentation"
      viewAt : number = 0.85
        @label "View line"
        @description "Where in the view, as a fraction of its height from the top, the grid's top must pass for the cards to arrive."
        @tier "presentation"
      arriveMs : number = 620
        @label "Arrival"
        @description "How long one card takes to rise and fade in, in ms."
        @tier "presentation"
      staggerMs : number = 70
        @label "Stagger"
        @description "The delay between one card's arrival and the next, in ms."
        @tier "presentation"
    }
  }

  page boot as RasmCardsStart -> RasmCards
}
