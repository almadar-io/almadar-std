app std-rasm-image [
  version: "0.1.0",
  description: "std-rasm-image — one photograph or artwork filling its placed rect, treated in the announced style. The image (a URL the canvas fetches, cropped centred to the rect's aspect) is painted into a render target <id>:target, and a rect over the placed rect shows that target through the material of the look image/<treatment>/idle: the treatment is the `treatment` knob, or, when that is empty, none for a photo and the announced style's layout imageTreatment for art (the `kind` knob) (duotone, halftone, riso, engraving, glow, grain, scanline, none). RASM_IMAGE { id, url } swaps the picture, so a program that owns the rows chooses it; the `clip` knob cuts it to a rect, arch, circle, ellipse or diamond; the `alt` key (unless `decorative` is on) makes it an image announced to assistive technology, through a transparent keyed text; with no URL or an empty rect it paints nothing, clearing what it showed."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmLayout = { hero : "centered" | "split" | "offset" | "full-bleed" | "poster" | "editorial" | "collage"!, columns : number!, asymmetry : number!, ornament : "none" | "rule" | "double-rule" | "frame" | "stamp"!, align : "start" | "center"!, imageTreatment : "none" | "duotone" | "halftone" | "riso" | "engraving" | "glow" | "grain" | "scanline"!, sectionGap : number!, gutter : number! }
type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number! }
type RasmMotion = { signature : "rise" | "print-pass" | "fan" | "glitch" | "ink-bleed" | "paper-drop" | "kinetic" | "float" | "snap"!, stiffness : number!, damping : number!, stagger : number!, enterMs : number, keyframes : [RasmEntryKey] }
type RasmText = { id : string!, key : MessageKey?, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string? }

orbital RasmImageOrbital {
  entity RasmImageView [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The rect RASM_PLACE gave this image, null until placed." = null
    rotate : number @description "The rotation in radians RASM_PLACE gave this image, 0 when none." = 0
    url : string @description "The picture shown: the url knob until RASM_IMAGE names another." = ""
    styled : string @description "The announced style's image treatment, empty before a style is announced." = ""
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmImage -> RasmImageView [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.url @config.url)
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit IMAGE_PAINT { n: @entity.paints })
      RASM_STYLE -> ready
        (set @entity.styled ?layout.imageTreatment)
        (set @entity.paints (+ @entity.paints 1))
        (emit IMAGE_PAINT { n: @entity.paints })
      RASM_IMAGE -> ready when (= ?id @config.id)
        (set @entity.url ?url)
        (set @entity.paints (+ @entity.paints 1))
        (emit IMAGE_PAINT { n: @entity.paints })
      RASM_IMAGE -> ready when (!= ?id @config.id)
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.rotate (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) 0 (default @mine.rotate 0))))
        (set @entity.paints (+ @entity.paints 1))
        (emit IMAGE_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      IMAGE_PAINT -> ready
        (let ((r @entity.rect)
              (treatment (if (!= @config.treatment "") @config.treatment (if (and (= @config.kind "art") (!= @entity.styled "")) @entity.styled "none")))
              (target (str/concat @config.id ":target")))
          (let ((look (default (object/get @entity.looks (str/concat "image/" @treatment "/idle") null) (default (object/get @entity.looks "image/none/idle" null) {}))))
            (when (!= @r null)
              (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: (let ((none : [RasmText] []) (given : MessageKey? @config.alt)) (if (and (!= @given null) (not @config.decorative)) [{ id: (str/concat @config.id ":alt"), key: @given, x: @r.x, y: @r.y, z: @config.z, align: "left", baseline: "top", color: "transparent", font: "400 1px body" }] @none)), nodes: (let ((none : [node] []) (rot @entity.rotate) (cx (+ @r.x (/ @r.w 2))) (cy (+ @r.y (/ @r.h 2)))) (let ((base : [node] (if (or (= @entity.url "") (<= @r.w 0) (<= @r.h 0)) @none [{ type: draw-group, id: (str/concat @config.id ":source"), position: { x: @r.x, y: @r.y, z: @config.z }, target: { id: @target, width: (math/round @r.w), height: (math/round @r.h) }, items: [{ type: draw-sprite, id: (str/concat @config.id ":photo"), asset: { url: @entity.url }, fit: "cover", anchor: "top-left", position: { x: 0, y: 0, z: 0 }, width: (math/round @r.w), height: (math/round @r.h) }] }, { type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: (default @look.fill "primary"), stroke: @look.stroke, strokeWidth: @look.strokeWidth, corners: @look.corners, shadow: @look.shadow, material: (object/merge (default @look.material { wgsl: "fn shade(px: Pixel) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv, 0.0); }\n", params: [0, 0, 0, 0], live: false }) { targets: [@target] }), spring: @look.spring, semantic: (if (and (let ((given : MessageKey? @config.alt)) (!= @given null)) (not @config.decorative)) { role: "img", labelledBy: (str/concat @config.id ":alt"), order: (+ @r.y (/ @r.x 10000)) } null) }]))) (let ((shaped : [node] (if (= @config.clip "rect") @base [{ type: draw-group, id: (str/concat @config.id ":clip"), position: { x: 0, y: 0 }, clip: (let ((x @r.x) (y @r.y) (w @r.w) (h @r.h)) (let ((cx (+ @x (/ @w 2))) (cy (+ @y (/ @h 2))) (rr (math/min (/ @w 2) @h)) (cr (/ (math/min @w @h) 2))) (if (= @config.clip "arch") (str/concat "M " @x " " (+ @y @h) " L " @x " " (+ @y @rr) " A " @rr " " @rr " 0 0 1 " (+ @x @w) " " (+ @y @rr) " L " (+ @x @w) " " (+ @y @h) " Z") (if (= @config.clip "circle") (str/concat "M " (- @cx @cr) " " @cy " A " @cr " " @cr " 0 1 1 " (+ @cx @cr) " " @cy " A " @cr " " @cr " 0 1 1 " (- @cx @cr) " " @cy " Z") (if (= @config.clip "ellipse") (str/concat "M " @x " " @cy " A " (/ @w 2) " " (/ @h 2) " 0 1 1 " (+ @x @w) " " @cy " A " (/ @w 2) " " (/ @h 2) " 0 1 1 " @x " " @cy " Z") (str/concat "M " @cx " " @y " L " (+ @x @w) " " @cy " L " @cx " " (+ @y @h) " L " @x " " @cy " Z")))))), items: @base }]))) (if (= @rot 0) @shaped [{ type: draw-group, id: (str/concat @config.id ":rotate"), position: { x: @cx, y: @cy }, rotate: @rot, items: [{ type: draw-group, id: (str/concat @config.id ":origin"), position: { x: (- 0 @cx), y: (- 0 @cy) }, items: @shaped }] }])))) }))))
    }

    emits {
      IMAGE_PAINT -> internal {
        n : number!
      }
        @description "Repaint from the stored rect, picture, look and treatment."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The group that paints the picture into the render target, then the rect that shows the target through the treatment material."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_STYLE { name : string!  layout : RasmLayout!  motion : RasmMotion! }
        @description "Take the style's image treatment and repaint."
      RASM_IMAGE { id : string!  url : string! }
        @description "Show another picture, for this image's id."
        @synonyms "set image, change picture"
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take this image's rect when it is placed and repaint."
    }

    config {
      id : string = "image"
        @label "Id"
        @description "The image's RASM_PLACE key, RASM_IMAGE key and paint id; its render target is named <id>:target."
        @tier "presentation"
      url : string = ""
        @label "Picture"
        @description "The picture's URL until RASM_IMAGE names another; empty paints nothing."
        @tier "domain"
      treatment : "" | "none" | "duotone" | "halftone" | "riso" | "engraving" | "glow" | "grain" | "scanline" = ""
        @label "Treatment"
        @description "The look image/<treatment>/idle the picture is shown through; empty follows the announced style's imageTreatment."
        @tier "presentation"
      kind : "photo" | "art" = "photo"
        @label "Kind"
        @description "photo shows the picture as it was taken (image/none/idle) unless treatment names one; art (an engraving, a poster, a print) follows the announced style's imageTreatment when treatment is empty."
        @tier "presentation"
      clip : "rect" | "arch" | "circle" | "ellipse" | "diamond" = "rect"
        @label "Clip"
        @description "The shape the picture is cut to, in the placed rect: rect leaves it square; arch is the rectangle with a semicircular top; circle is the circle of the rect's shorter side, centred; ellipse fills the rect; diamond joins the midpoints of its sides. The clip turns with a placed rotate."
        @tier "presentation"
      alt : MessageKey?
        @label "Alt text"
        @description "The catalog key of the picture's text alternative, announced as an image in the active locale. Give every meaningful picture one; a picture with neither alt nor decorative on announces nothing, which hides its meaning from assistive technology."
        @tier "presentation"
      decorative : boolean = false
        @label "Decorative"
        @description "On, the picture is purely ornamental: it announces nothing even when an alt key is given. Off (the default) announces the alt key."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
    }
  }

  page boot as RasmImageStart -> RasmImage
}
