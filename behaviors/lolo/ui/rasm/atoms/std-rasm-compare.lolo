app std-rasm-compare [
  version: "0.1.0",
  description: "std-rasm-compare — a before and after in one placed rect, split by a draggable divider. The after picture fills the rect; the before picture is laid over it and clipped to the side of the divider that leads the reading direction, so moving the divider uncovers one and covers the other with no layout. A press anywhere in the rect puts the divider under the pointer and starts a drag, moves carry it while the press holds, and the release ends it and emits the configured changed event with { value } in percent; the focus mover's RASM_STEP for its id moves it by `step` per key, so the arrow keys work once the id is in the focus order. It paints a divider line, a handle with two chevrons and a tag for each side, and is announced as a slider named by `label` whose value is the percentage of the before side shown. Each side is a picture (`beforeUrl`, `afterUrl`) or, when `before` or `after` hold nodes, a drawing in a sourceWidth by sourceHeight box scaled to cover the rect."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmText = { id : string!, key : MessageKey?, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string? }

orbital RasmCompareOrbital {
  entity RasmCompareRun [runtime] {
    id : string!
    rect : RasmRect? @description "The rect RASM_PLACE gave this comparison, null until it is placed." = null
    pos : number @description "How much of the rect the before side shows, 0 to 100 percent, from the reading start." = 50
    dragging : boolean @description "True from the press until the release." = false
    dir : "ltr" | "rtl" @description "The reading direction the surface announced; rtl puts the before side on the right." = "ltr"
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmCompare -> RasmCompareRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.pos @config.start)
      RASM_BOOT -> ready
        (set @entity.pos @config.start)
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_POINTER -> ready when (and (= ?id @config.id) (= ?kind "down") (!= @entity.rect null))
        (set @entity.dragging true)
        (set @entity.pos (let ((r (default @entity.rect { x: 0, y: 0, w: 1, h: 1 }))) (math/clamp (* 100 (/ (if (= @entity.dir "rtl") (- (+ @r.x @r.w) ?x) (- ?x @r.x)) (math/max 1 @r.w))) 0 100)))
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
      RASM_POINTER -> ready when (and (= ?id @config.id) (= ?kind "move") @entity.dragging (!= @entity.rect null))
        (set @entity.pos (let ((r (default @entity.rect { x: 0, y: 0, w: 1, h: 1 }))) (math/clamp (* 100 (/ (if (= @entity.dir "rtl") (- (+ @r.x @r.w) ?x) (- ?x @r.x)) (math/max 1 @r.w))) 0 100)))
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
      RASM_POINTER -> ready when (and (= ?id @config.id) (= ?kind "up") @entity.dragging)
        (set @entity.dragging false)
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
        (emit @config.changed { value: @entity.pos })
      RASM_POINTER -> ready when (not (and (= ?id @config.id) (or (and (= ?kind "down") (!= @entity.rect null)) (and @entity.dragging (or (= ?kind "move") (= ?kind "up"))))))
      RASM_STEP -> ready when (= ?id @config.id)
        (set @entity.pos (math/clamp (+ @entity.pos (* ?delta @config.step)) 0 100))
        (set @entity.paints (+ @entity.paints 1))
        (emit COMPARE_PAINT { n: @entity.paints })
        (emit @config.changed { value: @entity.pos })
      RASM_STEP -> ready when (!= ?id @config.id)
      COMPARE_PAINT -> ready when (= @entity.rect null)
      COMPARE_PAINT -> ready when (!= @entity.rect null)
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (rtl (= @entity.dir "rtl")))
          (let ((k (math/max (/ @r.w @config.sourceWidth) (/ @r.h @config.sourceHeight))) (frac (/ @entity.pos 100)) (ox (+ @r.x (/ (- @r.w (* @config.sourceWidth @k)) 2))) (oy (+ @r.y (/ (- @r.h (* @config.sourceHeight @k)) 2))) (midY (+ @r.y (/ @r.h 2))))
            (let ((divX (if @rtl (- (+ @r.x @r.w) (* @r.w @frac)) (+ @r.x (* @r.w @frac)))) (lead (if @rtl (+ @r.x @r.w) @r.x)))
              (let ((cut (if @rtl (str/concat "M " @divX " " @r.y " L " (+ @r.x @r.w) " " @r.y " L " (+ @r.x @r.w) " " (+ @r.y @r.h) " L " @divX " " (+ @r.y @r.h) " Z") (str/concat "M " @r.x " " @r.y " L " @divX " " @r.y " L " @divX " " (+ @r.y @r.h) " L " @r.x " " (+ @r.y @r.h) " Z")))
                    (frame (str/concat "M " @r.x " " @r.y " L " (+ @r.x @r.w) " " @r.y " L " (+ @r.x @r.w) " " (+ @r.y @r.h) " L " @r.x " " (+ @r.y @r.h) " Z"))
                    (beforeItems : [node] (if (> (array/len @config.before) 0) @config.before [{ type: draw-sprite, id: (str/concat @config.id ":beforephoto"), asset: { url: @config.beforeUrl }, fit: "cover", anchor: "top-left", position: { x: 0, y: 0, z: 0 }, width: @config.sourceWidth, height: @config.sourceHeight }]))
                    (afterItems : [node] (if (> (array/len @config.after) 0) @config.after [{ type: draw-sprite, id: (str/concat @config.id ":afterphoto"), asset: { url: @config.afterUrl }, fit: "cover", anchor: "top-left", position: { x: 0, y: 0, z: 0 }, width: @config.sourceWidth, height: @config.sourceHeight }]))
                    (tagY (+ @r.y 12)) (tagW @config.tagWidth) (tagH 34))
                (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: [{ id: (str/concat @config.id ":name"), key: @config.label, x: @r.x, y: @r.y, z: @config.z, align: "left", baseline: "top", color: "transparent", font: "400 1px body" }, { id: (str/concat @config.id ":beforeTag"), key: @config.beforeLabel, x: (if @rtl (- @lead (+ 12 (/ @tagW 2))) (+ @lead 12 (/ @tagW 2))), y: (+ @tagY 8), z: (+ @config.z 4), align: "center", baseline: "top", color: "card-foreground", font: "700 14px body" }, { id: (str/concat @config.id ":afterTag"), key: @config.afterLabel, x: (if @rtl (+ @r.x 12 (/ @tagW 2)) (- (+ @r.x @r.w) (+ 12 (/ @tagW 2)))), y: (+ @tagY 8), z: (+ @config.z 4), align: "center", baseline: "top", color: "card-foreground", font: "700 14px body" }], nodes: [
                  { type: draw-group, id: (str/concat @config.id ":frame"), position: { x: 0, y: 0 }, clip: @frame, items: [
                    { type: draw-group, id: (str/concat @config.id ":after"), position: { x: @ox, y: @oy, z: @config.z }, scale: @k, items: @afterItems },
                    { type: draw-group, id: (str/concat @config.id ":cut"), position: { x: 0, y: 0 }, clip: @cut, items: [{ type: draw-group, id: (str/concat @config.id ":before"), position: { x: @ox, y: @oy, z: @config.z }, scale: @k, items: @beforeItems }] }] },
                  { type: draw-shape, id: (str/concat @config.id ":beforePlate"), shape: rect, anchor: "top-left", position: { x: (if @rtl (- @lead (+ 12 @tagW)) (+ @lead 12)), y: @tagY, z: (+ @config.z 3) }, width: @tagW, height: @tagH, fill: "card", stroke: "foreground", strokeWidth: 2, hit: false },
                  { type: draw-shape, id: (str/concat @config.id ":afterPlate"), shape: rect, anchor: "top-left", position: { x: (if @rtl (+ @r.x 12) (- (+ @r.x @r.w) (+ 12 @tagW))), y: @tagY, z: (+ @config.z 3) }, width: @tagW, height: @tagH, fill: "card", stroke: "foreground", strokeWidth: 2, hit: false },
                  { type: draw-shape, id: (str/concat @config.id ":line"), shape: rect, anchor: "top-left", position: { x: (- @divX 2), y: @r.y, z: (+ @config.z 2) }, width: 4, height: @r.h, fill: "card", stroke: "foreground", strokeWidth: 1, hit: false },
                  { type: draw-shape, id: (str/concat @config.id ":handle"), shape: ellipse, anchor: center, position: { x: @divX, y: @midY, z: (+ @config.z 3) }, radiusX: 24, radiusY: 24, fill: "primary", stroke: "foreground", strokeWidth: 3, hit: false },
                  { type: draw-shape, id: (str/concat @config.id ":chevrons"), shape: path, position: { x: 0, y: 0, z: (+ @config.z 4) }, d: (str/concat "M " (- @divX 7) " " (- @midY 7) " L " (- @divX 14) " " @midY " L " (- @divX 7) " " (+ @midY 7) " M " (+ @divX 7) " " (- @midY 7) " L " (+ @divX 14) " " @midY " L " (+ @divX 7) " " (+ @midY 7)), stroke: "primary-foreground", strokeWidth: 3, fill: "", hit: false },
                  { type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: (+ @config.z 5) }, width: @r.w, height: @r.h, fill: "transparent", hit: true, semantic: { role: "slider", labelledBy: (str/concat @config.id ":name"), value: (str/concat (math/round @entity.pos)), order: @config.order, focused: false } }] })))))
    }

    emits {
      COMPARE_PAINT -> internal {
        n : number!
      }
        @description "Repaint from the stored rect, divider position and direction."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The two sides in a clipped frame, the divider with its handle, the two tags and the slider hit region."
        @tier "primary"
      @config.changed -> external {
        value : number!
      }
        @description "The divider was released or stepped: the percentage of the before side shown."
        @tier "domain"
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: take the starting position."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction: rtl puts the before side, its tag and the drag origin on the right."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take this comparison's rect when its id is placed."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "A press puts the divider under the pointer and starts the drag; moves carry it while the press holds; the release ends it."
      RASM_STEP { id : string!  delta : number! }
        @description "A keyboard step of `step` percent per delta for the focused comparison."
    }

    config {
      id : string = "compare"
        @label "Id"
        @description "The comparison's RASM_PLACE key, hit and paint id; put it in the focus order for the keyboard."
        @tier "presentation"
      z : number = 2
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      label : MessageKey
        @label "Label"
        @description "The catalog key of the slider's accessible name."
        @tier "domain"
      beforeLabel : MessageKey
        @label "Before tag"
        @description "The catalog key of the tag on the before side."
        @tier "domain"
      afterLabel : MessageKey
        @label "After tag"
        @description "The catalog key of the tag on the after side."
        @tier "domain"
      beforeUrl : string = ""
        @label "Before picture"
        @description "The before side's picture, used when `before` holds no nodes."
        @tier "domain"
      afterUrl : string = ""
        @label "After picture"
        @description "The after side's picture, used when `after` holds no nodes."
        @tier "domain"
      before : [node] = []
        @label "Before drawing"
        @description "Drawables for the before side in a sourceWidth by sourceHeight box, from its top-left corner; they replace the picture."
        @tier "domain"
      after : [node] = []
        @label "After drawing"
        @description "Drawables for the after side in the same box; they replace the picture."
        @tier "domain"
      sourceWidth : number = 1200
        @label "Source width"
        @description "The width of the box each side is drawn in; the box is scaled to cover the rect, centred."
        @tier "presentation"
      sourceHeight : number = 700
        @label "Source height"
        @description "The height of the box each side is drawn in."
        @tier "presentation"
      start : number = 50
        @label "Start"
        @description "How much of the rect the before side shows at first, 0 to 100 percent."
        @tier "presentation"
      step : number = 5
        @label "Step"
        @description "Percent moved by one arrow key."
        @tier "presentation"
      tagWidth : number = 128
        @label "Tag width"
        @description "The width in px of each side's tag plate."
        @tier "presentation"
      changed : event = RASM_COMPARE_CHANGED
        @label "Changed"
        @description "The event emitted with the committed percentage."
        @tier "domain"
      order : number = 0
        @label "Order"
        @description "Reading and tab order of the slider's semantic node."
        @tier "domain"
    }
  }

  page boot as RasmCompareStart -> RasmCompare
}
