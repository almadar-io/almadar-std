app std-rasm-stack [
  version: "0.1.0",
  description: "std-rasm-stack — the Rasm kit's layout node. On RASM_PLACE for its own id it stores its rect and places its children along one axis (fixed px, measured text size, or an equal share of what is left), emitting RASM_PLACE for them and RASM_EXTENT with its content size; RASM_MEASURED updates the measured children and re-places. A non-empty `look` also paints the stack's body (a card) with that look's decor, and RASM_ENTER plays its entry choreography."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmChild = { id : string!, size : "fixed" | "fill" | "measure"!, main : number, cross : number, min : number, measureId : string }
type RasmStackShape = { axis : "vertical" | "horizontal" | "layer"!, gap : number!, padding : number!, look : string!, children : [RasmChild]! }
type RasmLayout = { hero : "centered" | "split" | "offset" | "full-bleed" | "poster" | "editorial" | "collage"!, columns : number!, asymmetry : number!, ornament : "none" | "rule" | "double-rule" | "frame" | "stamp"!, align : "start" | "center"!, imageTreatment : "none" | "duotone" | "halftone" | "riso" | "engraving" | "glow" | "grain" | "scanline"!, sectionGap : number!, gutter : number! }
type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number! }
type RasmEntryItem = { id : string!, durationMs : number!, keyframes : [RasmEntryKey]! }
type RasmMotion = { signature : "rise" | "print-pass" | "fan" | "glitch" | "ink-bleed" | "paper-drop" | "kinetic" | "float" | "snap"!, stiffness : number!, damping : number!, stagger : number!, enterMs : number, keyframes : [RasmEntryKey] }

orbital RasmStackOrbital {
  entity RasmStackRun [runtime] {
    id : string!
    entry : RasmEntryItem? @description "This control's entry from the announced style's choreography, null for the built-in one." = null
    rect : RasmRect? @description "The rect RASM_PLACE gave this stack, null until placed." = null
    rotate : number @description "The rotation in radians RASM_PLACE gave this stack, 0 when none; only its own body is painted rotated, its children are not." = 0
    looks : Map string RasmLook @description "The announced look table." = {}
    measured : Map string RasmMeasureItem @description "The latest measured size of each child, by id." = {}
    dir : "ltr" | "rtl" @description "The direction the surface announced; rtl starts a horizontal stack at the right edge and keeps a narrower vertical child at the right edge." = "ltr"
    enterIndex : number @description "This stack's position in the RASM_ENTER order, -1 when it is not in it." = -1
    enteredMs : number @description "The epoch-ms instant the entry animation started, 0 before it." = 0
    staggerMs : number = 70
    hot : string @description "The id of the child the pointer is over, with hoverGrow on; empty when over none." = ""
    last : [RasmPlaced] @description "The rects of the last layout, read to tell which child the pointer is over." = []
    layouts : number @description "Counts layouts, so each layout in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    variant : string @description "The key of `variants` the announced style chose, empty for the configured shape." = ""
  }

  trait RasmStack -> RasmStackRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
      RASM_STYLE -> ready
        (set @entity.variant (if (= @config.variantBy "breakpoint") @entity.variant (let ((v (if (= @config.variantBy "hero") ?layout.hero (if (= @config.variantBy "ornament") ?layout.ornament (if (= @config.variantBy "align") ?layout.align (if (= @config.variantBy "imageTreatment") ?layout.imageTreatment "")))))) (if (object/has @config.variants @v) @v ""))))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      RASM_BREAKPOINT -> ready when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      RASM_BREAKPOINT -> ready when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h) (= (default @mine.rotate 0) @entity.rotate))))
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (not (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h) (= (default @mine.rotate 0) @entity.rotate)))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.rotate (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) 0 (default @mine.rotate 0))))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_MEASURED -> ready when (not (array/some ?items (fn it (and (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh @sh.children)))) (fn c (or (= @c.id @it.id) (= (default @c.measureId "") @it.id)))) (let ((m (object/get @entity.measured @it.id null))) (or (= @m null) (!= @m.width @it.width) (!= @m.height @it.height) (!= @m.lines @it.lines)))))))
      RASM_MEASURED -> ready when (array/some ?items (fn it (and (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh @sh.children)))) (fn c (or (= @c.id @it.id) (= (default @c.measureId "") @it.id)))) (let ((m (object/get @entity.measured @it.id null))) (or (= @m null) (!= @m.width @it.width) (!= @m.height @it.height) (!= @m.lines @it.lines))))))
        (set @entity.measured (array/reduce ?items @entity.measured (fn acc it (if (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh @sh.children)))) (fn c (or (= @c.id @it.id) (= (default @c.measureId "") @it.id)))) (object/set @acc @it.id @it) @acc))))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
      RASM_EXTENT -> ready when (and (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh @sh.children)))) (fn c (= @c.id ?id))) (let ((m (object/get @entity.measured ?id null))) (or (= @m null) (!= @m.height ?h))))
        (set @entity.measured (object/set @entity.measured ?id { id: ?id, width: ?w, height: ?h, lines: 0 }))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
      RASM_EXTENT -> ready when (not (and (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh @sh.children)))) (fn c (= @c.id ?id))) (let ((m (object/get @entity.measured ?id null))) (or (= @m null) (!= @m.height ?h)))))
      RASM_POINTER -> ready when (and (> @config.hoverGrow 0) (array/includes ["enter", "leave"] ?kind) (!= (let ((h (array/find @entity.last (fn p (and (or (= (array/len @config.hoverChildren) 0) (array/includes @config.hoverChildren @p.id)) (>= ?x @p.rect.x) (< ?x (+ @p.rect.x @p.rect.w)) (>= ?y @p.rect.y) (< ?y (+ @p.rect.y @p.rect.h))))))) (if (= @h null) "" @h.id)) @entity.hot))
        (set @entity.hot (let ((h (array/find @entity.last (fn p (and (or (= (array/len @config.hoverChildren) 0) (array/includes @config.hoverChildren @p.id)) (>= ?x @p.rect.x) (< ?x (+ @p.rect.x @p.rect.w)) (>= ?y @p.rect.y) (< ?y (+ @p.rect.y @p.rect.h))))))) (if (= @h null) "" @h.id)))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
      RASM_POINTER -> ready when (not (and (> @config.hoverGrow 0) (array/includes ["enter", "leave"] ?kind) (!= (let ((h (array/find @entity.last (fn p (and (or (= (array/len @config.hoverChildren) 0) (array/includes @config.hoverChildren @p.id)) (>= ?x @p.rect.x) (< ?x (+ @p.rect.x @p.rect.w)) (>= ?y @p.rect.y) (< ?y (+ @p.rect.y @p.rect.h))))))) (if (= @h null) "" @h.id)) @entity.hot)))
      RASM_ENTER -> ready
        (set @entity.entry (array/find (default ?entries []) (fn e (= @e.id @config.id))))
        (set @entity.enterIndex (array/indexOf ?order @config.id))
        (set @entity.enteredMs (if (array/includes ?order @config.id) (time/epoch-ms @now) @entity.enteredMs))
        (set @entity.staggerMs ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      STACK_LAYOUT -> ready when (and (!= @entity.rect null) (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.axis)) @config.axis) "layer"))
        (emit RASM_PLACE { n: ?n, placed: (let ((r @entity.rect) (pad (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.padding)) @config.padding))) (array/map (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn c { id: @c.id, rect: { x: (+ @r.x @pad), y: (+ @r.y @pad), w: (math/max 0 (- @r.w (* 2 @pad))), h: (math/max 0 (- @r.h (* 2 @pad))) } }))) })
        (emit RASM_EXTENT { n: ?n, id: @config.id, w: @entity.rect.w, h: (let ((heights (array/map (array/filter (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn c (!= (object/get @entity.measured (default @c.measureId @c.id) null) null))) (fn c (let ((m (object/get @entity.measured (default @c.measureId @c.id) null))) (if (= @m null) 0 @m.height)))))) (+ (* 2 (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.padding)) @config.padding)) (array/reduce @heights (array/reduce (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) 0 (fn acc c (math/max @acc (default @c.min 0)))) (fn acc x (math/max @acc @x))))) })
      STACK_LAYOUT -> ready when (and (!= @entity.rect null) (!= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.axis)) @config.axis) "layer"))
        (set @entity.last (let ((r @entity.rect) (pad (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.padding)) @config.padding)) (vert (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.axis)) @config.axis) "vertical")) (rtl (= @entity.dir "rtl"))) (let ((mainExt (if @vert (- @r.h (* 2 @pad)) (- @r.w (* 2 @pad)))) (crossExt (if @vert (- @r.w (* 2 @pad)) (- @r.h (* 2 @pad))))) (let ((raw (array/map (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn c { id: @c.id, fill: (= @c.size "fill"), s: (if (= @c.size "fixed") (+ (default @c.main 0) (if (or (= @entity.hot "") (<= @config.hoverGrow 0)) 0 (if (= @c.id @entity.hot) @config.hoverGrow (if (array/some (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn h (and (= @h.id @entity.hot) (= @h.size "fill")))) (- 0 (/ @config.hoverGrow (math/max 1 (array/len (array/filter (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn k (= @k.size "fixed"))))))) 0)))) (if (= @c.size "measure") (let ((m (object/get @entity.measured (default @c.measureId @c.id) null))) (if (= @m null) 0 (if @vert @m.height @m.width))) 0)), cross: (default @c.cross 0), least: (if (= @c.size "fill") (math/max (default @c.min 0) (if @vert (let ((m (object/get @entity.measured (default @c.measureId @c.id) null))) (if (= @m null) 0 @m.height)) 0)) 0) })))) (let ((fixedTotal (array/reduce @raw 0 (fn acc x (+ @acc @x.s)))) (fills (array/len (array/filter @raw (fn x @x.fill))))) (let ((share (if (> @fills 0) (math/max 0 (/ (- (- @mainExt @fixedTotal) (* (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.gap)) @config.gap) (- (array/len @raw) 1))) @fills)) 0))) (let ((laid (array/reduce @raw { at: (if @vert (+ @r.y @pad) (+ @r.x @pad)), placed: [] } (fn acc x (let ((s (if @x.fill (math/max @share @x.least) @x.s)) (cr (if (> @x.cross 0) @x.cross @crossExt))) { at: (+ (+ @acc.at @s) (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.gap)) @config.gap)), placed: (array/append @acc.placed { id: @x.id, rect: (if @vert { x: (if @rtl (- (- (+ @r.x @r.w) @pad) @cr) (+ @r.x @pad)), y: @acc.at, w: @cr, h: @s } { x: (if @rtl (- (- (+ (* 2 @r.x) @r.w) @acc.at) @s) @acc.at), y: (+ @r.y @pad), w: @s, h: @cr }) }) }))))) @laid.placed)))))))
        (emit RASM_PLACE { n: ?n, placed: @entity.last })
        (when (> @config.hoverGrow 0)
          (emit RASM_PAINT { n: ?n, id: (str/concat @config.id ":hover"), z: @config.z, nodes: (array/map (array/filter @entity.last (fn p (or (= (array/len @config.hoverChildren) 0) (array/includes @config.hoverChildren @p.id)))) (fn p { type: draw-shape, shape: "rect", id: (str/concat @config.id ":hover:" @p.id), position: { x: @p.rect.x, y: @p.rect.y }, anchor: "top-left", width: @p.rect.w, height: @p.rect.h, fill: "rgba(0,0,0,0)", hit: true })) }))
        (emit RASM_EXTENT { n: ?n, id: @config.id, w: @entity.rect.w, h: (let ((r @entity.rect) (n (array/len (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children))) (heights (array/map (array/filter (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn c (!= (object/get @entity.measured (default @c.measureId @c.id) null) null))) (fn c (let ((m (object/get @entity.measured (default @c.measureId @c.id) null))) (if (= @m null) 0 @m.height)))))) (if (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.axis)) @config.axis) "vertical") (+ (+ (* 2 (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.padding)) @config.padding)) (* (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.gap)) @config.gap) (math/max 0 (- @n 1)))) (array/reduce (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) 0 (fn acc c (+ @acc (if (= @c.size "fixed") (default @c.main 0) (let ((mh (let ((m (object/get @entity.measured (default @c.measureId @c.id) null))) (if (= @m null) 0 @m.height)))) (if (= @c.size "measure") @mh (math/max (default @c.min 0) @mh)))))))) (if (= (array/len @heights) 0) @r.h (+ (* 2 (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.padding)) @config.padding)) (array/reduce @heights 0 (fn acc x (math/max @acc @x))))))) })
      STACK_LAYOUT -> ready when (= @entity.rect null)
      STACK_PAINT -> ready
        (let ((l (object/get @entity.looks (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.look)) @config.look) null)) (r @entity.rect)) (when (and (!= @l null) (!= @r null) (!= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.look)) @config.look) "")) (let ((idx @entity.enterIndex) (stag @entity.staggerMs) (framed (= @l.decor "naqsh-stars")) (perim (* 2 (+ @r.w @r.h)))) (let ((entry (+ 520 (* @idx @stag)))) (let ((dur (if @framed (math/max 1400 @entry) @entry))) (let ((anim (if (>= @idx 0) (if (= @entity.entry null) { durationMs: @dur, startMs: @entity.enteredMs, loop: false, keyframes: (if @framed [{ at: 0, opacity: 0, offsetY: 14, strokeDashOffset: @perim }, { at: (/ (* @idx @stag) @dur), opacity: 0, offsetY: 14, strokeDashOffset: @perim }, { at: (/ @entry @dur), opacity: 1, offsetY: 0, strokeDashOffset: (* @perim (- 1 (default (/ @entry @dur) 1))) }, { at: 1, opacity: 1, offsetY: 0, strokeDashOffset: 0 }] [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @idx @stag) @dur), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }]) } { durationMs: @entity.entry.durationMs, startMs: @entity.enteredMs, loop: false, keyframes: @entity.entry.keyframes }) null)) (decorAnim (if (>= @idx 0) (if (= @entity.entry null) { durationMs: @entry, startMs: @entity.enteredMs, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @idx @stag) @entry), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } { durationMs: @entity.entry.durationMs, startMs: @entity.enteredMs, loop: false, keyframes: @entity.entry.keyframes }) null))) (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: (let ((rot @entity.rotate) (cx (+ @r.x (/ @r.w 2))) (cy (+ @r.y (/ @r.h 2)))) (let ((base : [node] (array/concat (array/concat [{ type: draw-shape, shape: "rect", id: @config.id, position: { x: @r.x, y: @r.y }, anchor: "top-left", width: @r.w, height: @r.h, fill: @l.fill, backdrop: @l.backdrop, stroke: @l.stroke, strokeWidth: @l.strokeWidth, strokeDash: (if (and @framed (>= @idx 0)) [@perim, @perim] []), corners: @l.corners, shadow: @l.shadow, material: @l.material, spring: @l.spring, animation: @anim, hit: false }] (if (= @l.decor "glass-rim") [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":rim"), position: { x: (+ @r.x 1), y: (+ @r.y 1) }, anchor: "top-left", width: (- @r.w 2), height: (- @r.h 2), stroke: "rgba(255,255,255,0.18)", strokeWidth: 1, corners: (let ((c (default @l.corners { radius: [0, 0, 0, 0], kind: "round" }))) { radius: (array/map @c.radius (fn v (math/max 0 (- @v 1)))), kind: @c.kind }), spring: @l.spring, animation: @decorAnim, hit: false }] [])) (if (= @l.decor "naqsh-stars") (array/map [0, 1, 2, 3] (fn i { type: draw-shape, shape: "polygon", id: (str/concat @config.id ":star:" @i), position: { x: (- (+ @r.x (if (or (= @i 1) (= @i 2)) @r.w 0)) 6), y: (- (+ @r.y (if (>= @i 2) @r.h 0)) 6) }, anchor: "top-left", width: 12, height: 12, sides: 8, starRatio: 0.55, fill: @l.stroke, spring: @l.spring, animation: @decorAnim, hit: false })) []))))  (if (= @rot 0) @base [{ type: draw-group, id: (str/concat @config.id ":rotate"), position: { x: @cx, y: @cy }, rotate: @rot, items: [{ type: draw-group, id: (str/concat @config.id ":origin"), position: { x: (- 0 @cx), y: (- 0 @cy) }, items: @base }] }]))) })))))))
    }

    emits {
      STACK_LAYOUT -> internal {
        n : number!
      }
        @description "Place the children from the stored rect and measured sizes."
        @tier "internal"
      STACK_PAINT -> internal {
        n : number!
      }
        @description "Repaint the body from the stored rect and look."
        @tier "internal"
      RASM_PLACE -> external {
        n : number!
        placed : [RasmPlaced]!
      }
        @description "The children's rects."
        @tier "primary"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
      }
        @description "The body's nodes at its z."
        @tier "primary"
      RASM_EXTENT -> external {
        n : number!
        id : string!
        w : number!
        h : number!
      }
        @description "The stack's content size after each layout: a vertical stack with no fill child reports its children, gaps and padding; a horizontal stack with measured children reports the tallest plus padding; any other stack reports its rect. A parent stack measures a child by it, and the surface sizes its canvas to the root's."
        @tier "primary"
    }

    listens {
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The surface's reading direction; once announced it replaces this atom's direction knob and the layout is redone."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the variant is the first name of chain (the announced breakpoint, then each smaller declared one) that `variants` holds, and none of them keeps the configured shape; the stack lays out and paints again when the variant changes. With any other variantBy it is ignored."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_STYLE { name : string!  layout : RasmLayout!  motion : RasmMotion! }
        @description "A style was announced: the variant its layout names under `variantBy` replaces the configured shape (none named: the configured shape), and the stack lays out and paints again."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take this stack's rect when it is placed, then place the children."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Update the measured children and place them again."
      RASM_EXTENT { id : string!  w : number!  h : number!  n : number }
        @description "A child stack's content size: a measure child takes its height like measured text, and the stack lays out again when it changes."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "With hoverGrow on, an enter or leave says where the pointer is: the child under it grows and the layout is redone."
      RASM_ENTER { order : [string]!  staggerMs : number!  entries : [RasmEntryItem] }
        @description "Play the entry choreography when this stack's id is in the order."
    }

    config {
      id : string = "stack"
        @label "Id"
        @description "The stack's id: its RASM_PLACE key and its body paint id."
        @tier "presentation"
      axis : "vertical" | "horizontal" | "layer" = "vertical"
        @label "Axis"
        @description "The main axis the children run along; layer gives every child the whole content rect, one over another."
        @tier "presentation"
      gap : number = 0
        @label "Gap"
        @description "Space between children in px."
        @tier "presentation"
      padding : number = 0
        @label "Padding"
        @description "Space between the rect and its children on every side in px."
        @tier "presentation"
      look : string = ""
        @label "Look"
        @description "The look key painted as the body (for example stack/panel/idle); empty paints no body."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      hoverGrow : number = 0
        @label "Hover growth"
        @description "Above 0, on a horizontal or vertical stack: the fixed child under the pointer is laid out this many px longer (a fill sibling gives the room), and when the child under the pointer is a fill child the fixed children give up this many px between them. The stack paints an invisible pointer region over each growing child (paint id `<id>:hover`) so the pointer is seen anywhere in it."
        @tier "presentation"
      hoverChildren : [string] = []
        @label "Hover children"
        @description "The ids of the children that grow under the pointer; empty means every child."
        @tier "presentation"
      children : [RasmChild] = []
        @label "Children"
        @description "In order: fixed uses main px, measure uses the measured height (vertical) or width (horizontal) of a text (the text whose id is `measureId` when the child names one, else its own id: a pressable's wrapped label is `<id>:label`), or a child stack's reported extent, and is 0 until measured, fill shares the rest equally. A cross of 0 or absent is the full cross extent minus padding."
        @tier "presentation"
      variantBy : "" | "hero" | "ornament" | "align" | "imageTreatment" | "breakpoint" = ""
        @label "Variant by"
        @description "What picks a shape from `variants`: a style layout field (its value), or \"breakpoint\" (the surface's breakpoint name, falling back to the next smaller declared variant, then to the configured shape, which is the desktop composition); empty keeps the configured shape."
        @tier "presentation"
      variants : Map string RasmStackShape = {}
        @label "Variants"
        @description "Shapes by layout value (a hero arrangement, an ornament, …) or by breakpoint name (phone, tablet, desktop, wide): axis, gap, padding, look and children replacing the configured ones while a style naming that value is announced."
        @tier "presentation"
    }
  }

  page boot as RasmStackStart -> RasmStack
}
