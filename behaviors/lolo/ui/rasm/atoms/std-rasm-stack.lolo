app std-rasm-stack [
  version: "0.1.0",
  description: "std-rasm-stack — the Rasm kit's layout node. On RASM_PLACE for its own id it stores its rect and places its children along one axis (fixed px, measured text size, or an equal share of what is left), emitting RASM_PLACE for them; RASM_MEASURED updates the measured children and re-places. A non-empty `look` also paints the stack's body (a card) with that look's decor, and RASM_ENTER plays its entry choreography."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number! }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmChild = { id : string!, size : "fixed" | "fill" | "measure"!, main : number, cross : number }

orbital RasmStackOrbital {
  entity RasmStackRun [runtime] {
    id : string!
    rect : RasmRect? @description "The rect RASM_PLACE gave this stack, null until placed." = null
    looks : Map string RasmLook @description "The announced look table." = {}
    measured : Map string RasmMeasureItem @description "The latest measured size of each child, by id." = {}
    dir : "ltr" | "rtl" @description "The direction the surface announced; rtl starts a horizontal stack at the right edge and keeps a narrower vertical child at the right edge." = "ltr"
    enterIndex : number @description "This stack's position in the RASM_ENTER order, -1 when it is not in it." = -1
    staggerMs : number = 70
    layouts : number @description "Counts layouts, so each layout in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmStack -> RasmStackRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_MEASURED -> ready
        (set @entity.measured (array/reduce ?items @entity.measured (fn acc it (if (array/some @config.children (fn c (= @c.id @it.id))) (object/set @acc @it.id @it) @acc))))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit STACK_LAYOUT { n: @entity.layouts })
      RASM_ENTER -> ready
        (set @entity.enterIndex (array/indexOf ?order @config.id))
        (set @entity.staggerMs ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit STACK_PAINT { n: @entity.paints })
      STACK_LAYOUT -> ready when (!= @entity.rect null)
        (emit RASM_PLACE { placed: (let ((r @entity.rect) (pad @config.padding) (vert (= @config.axis "vertical")) (rtl (= @entity.dir "rtl"))) (let ((mainExt (if @vert (- @r.h (* 2 @pad)) (- @r.w (* 2 @pad)))) (crossExt (if @vert (- @r.w (* 2 @pad)) (- @r.h (* 2 @pad))))) (let ((raw (array/map @config.children (fn c { id: @c.id, fill: (= @c.size "fill"), s: (if (= @c.size "fixed") (default @c.main 0) (if (= @c.size "measure") (let ((m (object/get @entity.measured @c.id null))) (if (= @m null) 0 (if @vert @m.height @m.width))) 0)), cross: (default @c.cross 0) })))) (let ((fixedTotal (array/reduce @raw 0 (fn acc x (+ @acc @x.s)))) (fills (array/len (array/filter @raw (fn x @x.fill))))) (let ((share (if (> @fills 0) (math/max 0 (/ (- (- @mainExt @fixedTotal) (* @config.gap (- (array/len @raw) 1))) @fills)) 0))) (let ((laid (array/reduce @raw { at: (if @vert (+ @r.y @pad) (+ @r.x @pad)), placed: [] } (fn acc x (let ((s (if @x.fill @share @x.s)) (cr (if (> @x.cross 0) @x.cross @crossExt))) { at: (+ (+ @acc.at @s) @config.gap), placed: (array/append @acc.placed { id: @x.id, rect: (if @vert { x: (if @rtl (- (- (+ @r.x @r.w) @pad) @cr) (+ @r.x @pad)), y: @acc.at, w: @cr, h: @s } { x: (if @rtl (- (- (+ (* 2 @r.x) @r.w) @acc.at) @s) @acc.at), y: (+ @r.y @pad), w: @s, h: @cr }) }) }))))) @laid.placed)))))) })
      STACK_LAYOUT -> ready when (= @entity.rect null)
      STACK_PAINT -> ready
        (let ((l (object/get @entity.looks @config.look null)) (r @entity.rect)) (when (and (!= @l null) (!= @r null) (!= @config.look "")) (let ((idx @entity.enterIndex) (stag @entity.staggerMs) (framed (= @l.decor "naqsh-stars")) (perim (* 2 (+ @r.w @r.h)))) (let ((entry (+ 520 (* @idx @stag)))) (let ((dur (if @framed (math/max 1400 @entry) @entry))) (let ((anim (if (>= @idx 0) { durationMs: @dur, loop: false, keyframes: (if @framed [{ at: 0, opacity: 0, offsetY: 14, strokeDashOffset: @perim }, { at: (/ (* @idx @stag) @dur), opacity: 0, offsetY: 14, strokeDashOffset: @perim }, { at: (/ @entry @dur), opacity: 1, offsetY: 0, strokeDashOffset: (* @perim (- 1 (default (/ @entry @dur) 1))) }, { at: 1, opacity: 1, offsetY: 0, strokeDashOffset: 0 }] [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @idx @stag) @dur), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }]) } null)) (decorAnim (if (>= @idx 0) { durationMs: @entry, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @idx @stag) @entry), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } null))) (emit RASM_PAINT { id: @config.id, z: @config.z, nodes: (array/concat (array/concat [{ type: draw-shape, shape: "rect", id: @config.id, position: { x: @r.x, y: @r.y }, anchor: "top-left", width: @r.w, height: @r.h, fill: @l.fill, stroke: @l.stroke, strokeWidth: @l.strokeWidth, strokeDash: (if (and @framed (>= @idx 0)) [@perim, @perim] []), corners: @l.corners, shadow: @l.shadow, material: @l.material, spring: @l.spring, animation: @anim, hit: false }] (if (= @l.decor "glass-rim") [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":rim"), position: { x: (+ @r.x 1), y: (+ @r.y 1) }, anchor: "top-left", width: (- @r.w 2), height: (- @r.h 2), stroke: "rgba(255,255,255,0.18)", strokeWidth: 1, corners: (let ((c (default @l.corners { radius: [0, 0, 0, 0], kind: "round" }))) { radius: (array/map @c.radius (fn v (math/max 0 (- @v 1)))), kind: @c.kind }), spring: @l.spring, animation: @decorAnim, hit: false }] [])) (if (= @l.decor "naqsh-stars") (array/map [0, 1, 2, 3] (fn i { type: draw-shape, shape: "polygon", id: (str/concat @config.id ":star:" @i), position: { x: (- (+ @r.x (if (or (= @i 1) (= @i 2)) @r.w 0)) 6), y: (- (+ @r.y (if (>= @i 2) @r.h 0)) 6) }, anchor: "top-left", width: 12, height: 12, sides: 8, starRatio: 0.55, fill: @l.stroke, spring: @l.spring, animation: @decorAnim, hit: false })) [])) })))))))
    }

    emits {
      STACK_LAYOUT -> internal {
        n : number!
      }
        @description "Place the children from the stored rect and measured sizes."
        @tier "internal"
      STACK_PAINT -> internal {
        n : number!
      }
        @description "Repaint the body from the stored rect and look."
        @tier "internal"
      RASM_PLACE -> external {
        placed : [RasmPlaced]!
      }
        @description "The children's rects."
        @tier "primary"
      RASM_PAINT -> external {
        id : string!
        z : number!
        nodes : [node]!
      }
        @description "The body's nodes at its z."
        @tier "primary"
    }

    listens {
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The surface's reading direction; once announced it replaces this atom's direction knob and the layout is redone."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_PLACE { placed : [RasmPlaced]! }
        @description "Take this stack's rect when it is placed, then place the children."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Update the measured children and place them again."
      RASM_ENTER { order : [string]!  staggerMs : number! }
        @description "Play the entry choreography when this stack's id is in the order."
    }

    config {
      id : string = "stack"
        @label "Id"
        @description "The stack's id: its RASM_PLACE key and its body paint id."
        @tier "presentation"
      axis : "vertical" | "horizontal" = "vertical"
        @label "Axis"
        @description "The main axis the children run along."
        @tier "presentation"
      gap : number = 0
        @label "Gap"
        @description "Space between children in px."
        @tier "presentation"
      padding : number = 0
        @label "Padding"
        @description "Space between the rect and its children on every side in px."
        @tier "presentation"
      look : string = ""
        @label "Look"
        @description "The look key painted as the body (for example stack/panel/idle); empty paints no body."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      children : [RasmChild] = []
        @label "Children"
        @description "In order: fixed uses main px, measure uses the measured height (vertical) or width (horizontal) and is 0 until measured, fill shares the rest equally. A cross of 0 or absent is the full cross extent minus padding."
        @tier "presentation"
    }
  }

  page boot as RasmStackStart -> RasmStack
}
