app std-rasm-progress [
  version: "0.1.0",
  description: "std-rasm-progress — a bar bound to the page scroll: the fraction the reader has scrolled through the page, painted as a track with a fill from the reading start to that fraction of the placed rect (the right end under rtl). It reads the offset and the scroll range RASM_PAGE_SCROLLED reports (so the surface needs pageScroll on) and repaints on every report; a page that does not scroll paints an empty track. Place it in a grid or stack cell and list its id in the page's `fixed` knob to keep it in view as a reading-progress bar. Looks are range/default/track and range/default/fill unless the knobs name others."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation? }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }

orbital RasmProgressOrbital {
  entity RasmProgressRun [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The rect RASM_PLACE gave the bar, null until placed." = null
    offset : number @description "The page scroll offset in px the last RASM_PAGE_SCROLLED reported." = 0
    range : number @description "The page's scroll range in px the last RASM_PAGE_SCROLLED reported, 0 when the page does not scroll." = 0
    dir : "ltr" | "rtl" @description "The reading direction the surface announced: the fill grows from the reading start." = "ltr"
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmProgress -> RasmProgressRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit PROGRESS_PAINT { n: @entity.paints })
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit PROGRESS_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit PROGRESS_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_PAGE_SCROLLED -> ready
        (set @entity.offset ?offset)
        (set @entity.range ?max)
        (set @entity.paints (+ @entity.paints 1))
        (emit PROGRESS_PAINT { n: @entity.paints })
      PROGRESS_PAINT -> ready when (!= @entity.rect null)
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (tl (default (object/get @entity.looks @config.trackLook null) {})) (fl (default (object/get @entity.looks @config.fillLook null) {})) (frac (if (> @entity.range 0) (math/clamp (/ @entity.offset @entity.range) 0 1) 0)))
          (let ((fw (* @r.w @frac)))
            (emit RASM_PAINT {
              id: @config.id,
              z: @config.z,
              texts: [],
              nodes: (let ((bar : [node] (array/concat [{ type: draw-shape, id: (str/concat @config.id ":track"), shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: @tl.fill, corners: @tl.corners, hit: false }] (if (> @fw 0) [{ type: draw-shape, id: (str/concat @config.id ":fill"), shape: rect, anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) @fw) @r.x), y: @r.y, z: (+ @config.z 1) }, width: @fw, height: @r.h, fill: @fl.fill, corners: @fl.corners, spring: @fl.spring, hit: false }] [])))) @bar)
            })))
      PROGRESS_PAINT -> ready when (= @entity.rect null)
    }

    emits {
      PROGRESS_PAINT -> internal {
        n : number!
      }
        @description "Repaint the bar from the stored rect, looks and scroll fraction."
        @tier "internal"
      RASM_PAINT -> external {
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The track and the fill as drawables for the surface to collect."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction: the fill grows from its start."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the bar's rect when it is placed."
      RASM_PAGE_SCROLLED { offset : number!  max : number! }
        @description "Take the page scroll offset and range; the fill is their quotient."
    }

    config {
      id : string = "progress"
        @label "Id"
        @description "The bar's RASM_PLACE key and paint id."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface; the fill paints one above."
        @tier "presentation"
      trackLook : string = "range/default/track"
        @label "Track look"
        @description "The theme look key whose fill and corners paint the empty bar."
        @tier "presentation"
      fillLook : string = "range/default/fill"
        @label "Fill look"
        @description "The theme look key whose fill, corners and spring paint the read part."
        @tier "presentation"
    }
  }

  page boot as RasmProgressStart -> RasmProgress
}
