app std-rasm-window [
  version: "0.1.0",
  description: "std-rasm-window — an operating-system window as a Rasm layout and ornament node (Win95, Mac classic, Aqua, Vaporwave, Frutiger Aero, a pixel RPG dialog). It paints no text and no image: it paints the chrome from the theme's looks and places two named slots that the composing program fills with text, image, grid or pressable atoms. Looks: `window/frame/idle` paints the frame over the whole rect (paint id `<id>`), `window/titlebar/idle` the title bar across the top (`<id>:titlebar`), `window/control/idle` each control (`<id>:control:<i>`, a square of titleBar minus 8 px inset 4 px, `controlCount` of them from the `controls` side inward); with `stripes` on, horizontal pinstripes in the title bar look's stroke run across the title area (`<id>:stripes`). A look the theme does not announce paints nothing for that part. Slots: `<id>:title` (or `titleSlot`) is the title bar's text area between the controls, `<id>:body` (or `bodySlot`) is the rect under the bar inset by the frame look's strokeWidth plus 6 px. The controls sit on the `controls` side, mirrored under rtl. A non-zero placed rotation turns the chrome about the rect centre and the slots with it. RASM_ENTER plays the entry choreography on the chrome."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmInset = { stroke : string!, strokeWidth : number!, gap : number! }
type RasmLook = { inset : RasmInset, fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number! }
type RasmEntryItem = { id : string!, durationMs : number!, keyframes : [RasmEntryKey]! }

type RasmWindowShape = { titleBar : number, controls : "right" | "left" | "none", controlCount : number, stripes : boolean }

orbital RasmWindowOrbital {
  entity RasmWindowRun [runtime] {
    id : string!
    entry : RasmEntryItem? @description "This node's entry from the announced style's choreography, null for the built-in one." = null
    rect : RasmRect? @description "The rect RASM_PLACE gave this node, null until placed." = null
    rotate : number @description "The rotation in radians RASM_PLACE gave this node; the chrome and the slots it places turn about the rect centre." = 0
    looks : Map string RasmLook @description "The announced look table." = {}
    dir : "ltr" | "rtl" @description "The direction the surface announced." = "ltr"
    enterIndex : number @description "This node's position in the RASM_ENTER order, -1 when it is not in it." = -1
    enteredMs : number @description "The epoch-ms instant the entry animation started, 0 before it." = 0
    staggerMs : number = 70
    variant : string @description "The key of `variants` the announced breakpoint chose, empty for the configured shape." = ""
    layouts : number @description "Counts layouts, so each layout in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmWindow -> RasmWindowRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.layouts (+ @entity.layouts 1))
        (emit WINDOW_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit WINDOW_PAINT { n: @entity.paints })
      RASM_BREAKPOINT -> ready when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit WINDOW_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit WINDOW_PAINT { n: @entity.paints })
      RASM_BREAKPOINT -> ready when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit WINDOW_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h) (= (default @mine.rotate 0) @entity.rotate))))
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (not (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h) (= (default @mine.rotate 0) @entity.rotate)))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.rotate (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) 0 (default @mine.rotate 0))))
        (set @entity.layouts (+ @entity.layouts 1))
        (emit WINDOW_LAYOUT { n: @entity.layouts })
        (set @entity.paints (+ @entity.paints 1))
        (emit WINDOW_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_ENTER -> ready
        (set @entity.entry (array/find (default ?entries []) (fn e (= @e.id @config.id))))
        (set @entity.enterIndex (array/indexOf ?order @config.id))
        (set @entity.enteredMs (if (array/includes ?order @config.id) (time/epoch-ms @now) @entity.enteredMs))
        (set @entity.staggerMs ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit WINDOW_PAINT { n: @entity.paints })
      WINDOW_LAYOUT -> ready when (= @entity.rect null)
      WINDOW_PAINT -> ready when (= @entity.rect null)
      WINDOW_LAYOUT -> ready when (!= @entity.rect null)
        (emit RASM_PLACE { n: ?n, placed: (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (bar (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.titleBar)) @config.titleBar)) (rtl (= @entity.dir "rtl")) (rot @entity.rotate) (fr (object/get @entity.looks "window/frame/idle" null))) (let ((n (if (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.controls)) @config.controls) "none") 0 (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.controlCount)) @config.controlCount))) (leftSide (if (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.controls)) @config.controls) "left") (not @rtl) @rtl)) (inset (+ (if (= @fr null) 0 (default @fr.strokeWidth 0)) 6)) (cx (+ @r.x (/ @r.w 2))) (cy (+ @r.y (/ @r.h 2)))) (let ((ctw (math/max 8 (if (<= @n 0) 0 (+ (* @n (+ (- @bar 8) 4)) 4)))) (co (math/cos @rot)) (si (math/sin @rot))) (let ((raw [{ id: (if (= @config.titleSlot "") (str/concat @config.id ":title") @config.titleSlot), x: (if @leftSide (+ @r.x @ctw) (+ @r.x 8)), y: @r.y, w: (math/max 0 (- @r.w (+ 8 @ctw))), h: @bar }, { id: (if (= @config.bodySlot "") (str/concat @config.id ":body") @config.bodySlot), x: (+ @r.x @inset), y: (+ (+ @r.y @bar) @inset), w: (math/max 0 (- @r.w (* 2 @inset))), h: (math/max 0 (- (- @r.h @bar) (* 2 @inset))) }])) (array/map @raw (fn s (let ((dx (- (+ @s.x (/ @s.w 2)) @cx)) (dy (- (+ @s.y (/ @s.h 2)) @cy))) { id: @s.id, rotate: @rot, rect: { x: (- (+ @cx (- (* @dx @co) (* @dy @si))) (/ @s.w 2)), y: (- (+ @cy (+ (* @dx @si) (* @dy @co))) (/ @s.h 2)), w: @s.w, h: @s.h } }))))))) })
      WINDOW_PAINT -> ready when (!= @entity.rect null)
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (none : [node] []) (fr (object/get @entity.looks "window/frame/idle" null)) (tb (object/get @entity.looks "window/titlebar/idle" null)) (ct (object/get @entity.looks "window/control/idle" null)) (rtl (= @entity.dir "rtl")) (rot @entity.rotate) (idx @entity.enterIndex) (stag @entity.staggerMs) (bar (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.titleBar)) @config.titleBar)))
          (let ((cx (+ @r.x (/ @r.w 2))) (cy (+ @r.y (/ @r.h 2))) (n (if (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.controls)) @config.controls) "none") 0 (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.controlCount)) @config.controlCount))) (leftSide (if (= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.controls)) @config.controls) "left") (not @rtl) @rtl)) (entry (+ 520 (* @idx @stag))) (cs (- @bar 8)))
            (let ((ctw (math/max 8 (if (<= @n 0) 0 (+ (* @n (+ @cs 4)) 4))))
                  (anim (if (>= @idx 0) (if (= @entity.entry null) { durationMs: @entry, startMs: @entity.enteredMs, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @idx @stag) @entry), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } { durationMs: @entity.entry.durationMs, startMs: @entity.enteredMs, loop: false, keyframes: @entity.entry.keyframes }) null)))
              (let ((tx (if @leftSide (+ @r.x @ctw) (+ @r.x 8))) (tw (math/max 0 (- @r.w (+ 8 @ctw)))) (lines (math/max 0 (+ (math/floor (/ (- @bar 12) 4)) 1))))
                (let ((frame (if (= @fr null) @none [{ type: draw-shape, shape: "rect", id: @config.id, position: { x: @r.x, y: @r.y }, anchor: "top-left", width: @r.w, height: @r.h, fill: @fr.fill, backdrop: @fr.backdrop, stroke: @fr.stroke, strokeWidth: @fr.strokeWidth, inset: @fr.inset, corners: @fr.corners, shadow: @fr.shadow, material: @fr.material, spring: @fr.spring, animation: @anim, hit: false }]))
                      (titlebar (if (= @tb null) @none [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":titlebar"), position: { x: @r.x, y: @r.y }, anchor: "top-left", width: @r.w, height: @bar, fill: @tb.fill, backdrop: @tb.backdrop, stroke: @tb.stroke, strokeWidth: @tb.strokeWidth, inset: @tb.inset, corners: @tb.corners, shadow: @tb.shadow, material: @tb.material, spring: @tb.spring, animation: @anim, hit: false }]))
                      (stripes (if (or (not (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.stripes)) @config.stripes)) (= @tb null) (<= @lines 0)) @none [{ type: draw-shape, shape: "path", id: (str/concat @config.id ":stripes"), position: { x: 0, y: 0 }, anchor: "top-left", d: (array/reduce (array/range @lines) "" (fn acc j (str/concat @acc "M" @tx " " (+ (+ @r.y 6) (* @j 4)) " L" (+ @tx @tw) " " (+ (+ @r.y 6) (* @j 4)) " "))), fill: "", stroke: @tb.stroke, strokeWidth: 1, spring: @tb.spring, animation: @anim, hit: false }]))
                      (controls (if (or (= @ct null) (<= @n 0)) @none (array/map (array/range @n) (fn i { type: draw-shape, shape: "rect", id: (str/concat @config.id ":control:" @i), position: { x: (if @leftSide (+ (+ @r.x 4) (* @i (+ @cs 4))) (- (- (+ @r.x @r.w) (+ 4 @cs)) (* @i (+ @cs 4)))), y: (+ @r.y 4) }, anchor: "top-left", width: @cs, height: @cs, fill: @ct.fill, backdrop: @ct.backdrop, stroke: @ct.stroke, strokeWidth: @ct.strokeWidth, corners: @ct.corners, shadow: @ct.shadow, material: @ct.material, spring: @ct.spring, animation: @anim, hit: false })))))
                  (let ((parts (array/concat (array/concat (array/concat @frame @titlebar) @stripes) @controls)))
                    (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: (if (= @rot 0) @parts [{ type: draw-group, id: (str/concat @config.id ":turn"), position: { x: @cx, y: @cy }, rotate: @rot, items: [{ type: draw-group, id: (str/concat @config.id ":turned"), position: { x: (- 0 @cx), y: (- 0 @cy) }, items: @parts }] }]) })))))))
    }

    emits {
      WINDOW_LAYOUT -> internal {
        n : number!
      }
        @description "Place the slots from the stored rect, rotation and direction."
        @tier "internal"
      WINDOW_PAINT -> internal {
        n : number!
      }
        @description "Repaint the chrome from the stored rect, rotation, looks and direction."
        @tier "internal"
      RASM_PLACE -> external {
        n : number!
        placed : [RasmPlaced]!
      }
        @description "The slots' rects, each carrying this node's rotation."
        @tier "primary"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
      }
        @description "The chrome's nodes at its z; a non-zero rotation wraps them in a group turned about the rect centre."
        @tier "primary"
    }

    listens {
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The surface's reading direction; the mirrored side is redone."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the variant is the first name of chain (the announced breakpoint, then each smaller declared one, stopping at desktop) that `variants` holds, none of them keeping the configured shape, which is the desktop composition; it lays out and paints again when the variant changes. With any other variantBy it is ignored."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take this node's rect and rotation when its own id is placed, then place the slots; a placement for any other id is ignored."
      RASM_ENTER { order : [string]!  staggerMs : number!  entries : [RasmEntryItem] }
        @description "Play the entry choreography on the chrome when this node's id is in the order."
    }

    config {
      variantBy : "" | "breakpoint" = ""
        @label "Variant by"
        @description "\"breakpoint\" picks a shape from `variants` by the surface's breakpoint name, falling back to the next smaller declared variant (desktop and wide stop at desktop), then to the configured shape; empty keeps the configured shape."
        @tier "presentation"
      variants : Map string RasmWindowShape = {}
        @label "Variants"
        @description "Shapes by breakpoint name (phone, tablet, desktop, wide): the title bar height, the controls side and count and the stripes a variant names replace the configured ones while that breakpoint is current; one it leaves out keeps the configured value."
        @tier "presentation"
      id : string = "window"
        @label "Id"
        @description "The window's id: its RASM_PLACE key, its frame paint id and the prefix of its slot and part ids."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      titleBar : number = 28
        @label "Title bar"
        @description "The title bar's height in px; each control is a square of this minus 8 px."
        @tier "presentation"
      controls : "right" | "left" | "none" = "right"
        @label "Controls"
        @description "The side the controls sit on in a left-to-right reading (right for Win95 minimise, maximise and close; left for the Mac classic close box); rtl mirrors it; none paints no controls."
        @tier "presentation"
      controlCount : number = 3
        @label "Control count"
        @description "How many controls the title bar paints, from the controls side inward."
        @tier "presentation"
      stripes : boolean = false
        @label "Stripes"
        @description "Paint horizontal pinstripes across the title area in the title bar look's stroke (Mac classic)."
        @tier "presentation"
      titleSlot : string = ""
        @label "Title slot"
        @description "The id placed for the title text area; empty uses `<id>:title`."
        @tier "presentation"
      bodySlot : string = ""
        @label "Body slot"
        @description "The id placed for the body area; empty uses `<id>:body`."
        @tier "presentation"
    }
  }

  page boot as RasmWindowStart -> RasmWindow
}
