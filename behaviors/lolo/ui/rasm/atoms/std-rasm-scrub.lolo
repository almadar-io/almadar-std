app std-rasm-scrub [
  version: "0.1.0",
  description: "std-rasm-scrub — motion that follows the page scroll on a std-rasm-surface with pageScroll on. It reads where its anchor is placed and how tall the canvas is, and sends the surface RASM_SCRUB with the paints it moves, the scroll range and the keyframes: progress is 0 when the anchor's top reaches the `enter` fraction of the view (1 is the bottom edge) and 1 when its bottom reaches the `exit` fraction (0 is the top edge). The canvas plays the keyframes at the scroll position every frame, so scrolling back plays them backwards and nothing is re-laid-out or repainted while the page moves. Keyframes carry at, opacity, offsetX, offsetY, scale, rotate and dashOffset (the stroke dash moved along a dashed path, so a route draws itself in). With `relativeTo` naming a placed id, offsetX and offsetY are fractions of that rect's width and height, so a walk across a drawing keeps its course at every size."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmScrubFrame = { at : number!, opacity : number, offsetX : number, offsetY : number, scale : number, rotate : number, dashOffset : number }

orbital RasmScrubOrbital {
  entity RasmScrubRun [runtime] {
    id : string!
    rect : RasmRect? @description "The anchor's rect from RASM_PLACE, null until it is placed." = null
    ref : RasmRect? @description "The rect of the relativeTo id from RASM_PLACE, null until it is placed." = null
    viewH : number @description "The canvas height from RASM_RESIZE." = 0
    sends : number @description "Counts sends, so each send in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmScrub -> RasmScrubRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_PLACE -> ready when (array/some ?placed (fn p (or (= @p.id @config.anchor) (and (!= @config.relativeTo "") (= @p.id @config.relativeTo)))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.anchor))))) (if (= @mine null) @entity.rect @mine.rect)))
        (set @entity.ref (let ((it (array/find ?placed (fn p (and (!= @config.relativeTo "") (= @p.id @config.relativeTo)))))) (if (= @it null) @entity.ref @it.rect)))
        (set @entity.sends (+ @entity.sends 1))
        (emit SCRUB_SEND { n: @entity.sends })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (or (= @p.id @config.anchor) (and (!= @config.relativeTo "") (= @p.id @config.relativeTo))))))
      RASM_RESIZE -> ready
        (set @entity.viewH ?height)
        (set @entity.sends (+ @entity.sends 1))
        (emit SCRUB_SEND { n: @entity.sends })
      SCRUB_SEND -> ready when (and (!= @entity.rect null) (> @entity.viewH 0) (or (= @config.relativeTo "") (!= @entity.ref null)))
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (f (default @entity.ref { x: 0, y: 0, w: 1, h: 1 })))
          (emit RASM_SCRUB { id: @config.id, paints: @config.paints, from: (- @r.y (* @entity.viewH @config.enter)), to: (- (+ @r.y @r.h) (* @entity.viewH @config.exit)), keyframes: (if (= @config.relativeTo "") @config.keyframes (array/map @config.keyframes (fn k (let ((sx : RasmScrubFrame (if (= @k.offsetX null) @k (object/set @k "offsetX" (* @k.offsetX @f.w))))) (if (= @sx.offsetY null) @sx (object/set @sx "offsetY" (* @sx.offsetY @f.h))))))) }))
      SCRUB_SEND -> ready when (not (and (!= @entity.rect null) (> @entity.viewH 0) (or (= @config.relativeTo "") (!= @entity.ref null))))
    }

    emits {
      SCRUB_SEND -> internal {
        n : number!
      }
        @description "Send the surface the scroll range once the anchor is placed and the canvas sized."
        @tier "internal"
      RASM_SCRUB -> external {
        id : string!
        paints : [string]!
        from : number!
        to : number!
        keyframes : [RasmScrubFrame]!
      }
        @description "The paints this scrub moves, the scroll offsets in px where it starts and ends, and its keyframes."
        @tier "primary"
    }

    listens {
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the anchor's rect, and the relativeTo id's rect, when they are placed."
      RASM_RESIZE { width : number!  height : number! }
        @description "Take the canvas height, the view the range is measured in."
    }

    config {
      id : string = "scrub"
        @label "Id"
        @description "The scrub's id; a later RASM_SCRUB with the same id replaces it on the surface."
        @tier "presentation"
      anchor : string = ""
        @label "Anchor"
        @description "The placed id whose rect the scroll range follows (a section)."
        @tier "presentation"
      paints : [string] = []
        @label "Paints"
        @description "The paint ids that move with the scroll."
        @tier "presentation"
      enter : number = 1
        @label "Enter at"
        @description "Where in the view, as a fraction of its height from the top, the anchor's top is when the motion starts: 1 as it comes in at the bottom."
        @tier "presentation"
      exit : number = 0
        @label "Exit at"
        @description "Where in the view the anchor's bottom is when the motion ends: 0 as it leaves at the top."
        @tier "presentation"
      relativeTo : string = ""
        @label "Relative to"
        @description "A placed id; when set, keyframe offsetX and offsetY are fractions of its rect's width and height instead of px, and the scrub waits until it is placed. Empty keeps px."
        @tier "presentation"
      keyframes : [RasmScrubFrame] = [{ at: 0, opacity: 0, offsetY: 24 }, { at: 0.3, opacity: 1, offsetY: 0 }]
        @label "Keyframes"
        @description "The motion along the range: at (0 to 1) with any of opacity, offsetX and offsetY (px), scale, rotate (degrees) and dashOffset (px along a dashed stroke); a property no keyframe names keeps its painted value."
        @tier "presentation"
    }
  }

  page boot as RasmScrubStart -> RasmScrub
}
