        (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe"))))))
          (do
            (set @entity.wrapped (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))))
            (set @entity.labelH 0)
            (set @entity.paints (+ @entity.paints 1))
            (emit REPAINT { n: @entity.paints })))
      RASM_MEASURED -> hovered when (and (not (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe")))))) (and (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly)) (!= @p null) (!= (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))) @entity.wrapped)))) (let ((l (array/find ?items (fn it (= @it.id (str/concat @config.id ":label")))))) (and @entity.wrapped (!= @l null) (!= @l.height @entity.labelH))))
        (let ((l (array/find ?items (fn it (= @it.id (str/concat @config.id ":label"))))))
