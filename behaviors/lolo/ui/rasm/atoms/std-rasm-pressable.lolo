app std-rasm-pressable [
  version: "1.0.0",
  description: "std-rasm-pressable — a Rasm button painted on the orbital canvas. It stores the theme looks and its placed rect, and paints a body, a centred label and the look's decor as one RASM_PAINT. States idle, hovered, pressed, focused and disabled (disabled from config); a release over the control while pressed emits the configured action, a release after the pointer left does not, and RASM_ACTIVATE for its id emits it from the keyboard. Looks are keyed pressable/<intent>/<state>."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, startMs : number, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation?, maxWidth : number?, rotate : number?, pivotX : number?, pivotY : number? }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }

type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number!, scale : number, rotate : number }
type RasmEntryItem = { id : string!, durationMs : number!, keyframes : [RasmEntryKey]! }
type RasmPressShape = { iconOnly : boolean, icon : string, chrome : boolean }

orbital RasmPressableOrbital {
  entity RasmPressableItem [runtime] {
    id : string!
    entry : RasmEntryItem? @description "This control's entry from the announced style's choreography, null for the built-in one." = null
    looks : Map string RasmLook = {}
    hasLooks : boolean = false
    rect : RasmRect = { x: 0, y: 0, w: 0, h: 0 }
    rotate : number @description "The rotation in radians RASM_PLACE gave this control, 0 when none." = 0
    dir : "ltr" | "rtl" @description "The surface's reading direction; under rtl a directional icon draws its iconRtl path." = "ltr"
    hasRect : boolean = false
    entering : number = -1
    enteredMs : number @description "The epoch-ms instant the entry animation started, 0 before it." = 0
    stagger : number = 70
    wrapped : boolean @description "True once the canvas measured the label wider than the room the button leaves it: the label then wraps in that width instead of shrinking to fit." = false
    labelH : number @description "The height in px the canvas measured for the wrapped label, 0 until it did." = 0
    paints : number = 0
    variant : string @description "The key of `variants` the announced breakpoint chose, empty for the configured button." = ""
  }

  trait RasmPressable -> RasmPressableItem [client] {
    initial: idle

    state idle {
      INIT -> disabled when @config.disabled
      RASM_BOOT -> disabled when @config.disabled
      INIT -> idle when (not @config.disabled)
      RASM_BOOT -> idle when (not @config.disabled)
      RASM_DIRECTION -> idle
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_THEME -> idle
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_BREAKPOINT -> idle when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_BREAKPOINT -> idle when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_PLACE -> idle when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @mine.rect))
        (set @entity.rotate (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) 0 (default @mine.rotate 0))))
        (set @entity.hasRect true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_ENTER -> idle when (array/includes ?order @config.id)
        (set @entity.entry (array/find (default ?entries []) (fn e (= @e.id @config.id))))
        (set @entity.entering (array/indexOf ?order @config.id))
        (set @entity.enteredMs (time/epoch-ms @now))
        (set @entity.stagger ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> hovered when (and (= ?id @config.id) (= ?kind "enter"))
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> pressed when (and (= ?id @config.id) (= ?kind "down"))
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_FOCUS -> focused when (= ?id @config.id)
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_ACTIVATE -> idle when (= ?id @config.id)
        (emit @config.action { })
        (when @config.link (navigate @config.href))
      RASM_MEASURED -> idle when (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe")))))) (and (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly)) (!= @p null) (!= (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))) @entity.wrapped)))
        (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe"))))))
          (do
            (set @entity.wrapped (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))))
            (set @entity.labelH 0)
            (set @entity.paints (+ @entity.paints 1))
            (emit REPAINT { n: @entity.paints })))
      RASM_MEASURED -> idle when (and (not (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe")))))) (and (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly)) (!= @p null) (!= (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))) @entity.wrapped)))) (let ((l (array/find ?items (fn it (= @it.id (str/concat @config.id ":label")))))) (and @entity.wrapped (!= @l null) (!= @l.height @entity.labelH))))
        (let ((l (array/find ?items (fn it (= @it.id (str/concat @config.id ":label"))))))
          (do
            (set @entity.labelH @l.height)
            (set @entity.paints (+ @entity.paints 1))
            (emit REPAINT { n: @entity.paints })))
      RASM_MEASURED -> idle when (not (or (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe")))))) (and (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly)) (!= @p null) (!= (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))) @entity.wrapped))) (let ((l (array/find ?items (fn it (= @it.id (str/concat @config.id ":label")))))) (and @entity.wrapped (!= @l null) (!= @l.height @entity.labelH)))))
      REPAINT -> idle when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (anim (if (>= @entity.entering 0) (if (= @entity.entry null) { durationMs: (+ 520 (* @entity.entering @entity.stagger)), startMs: @entity.enteredMs, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @entity.entering @entity.stagger) (+ 520 (* @entity.entering @entity.stagger))), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } { durationMs: @entity.entry.durationMs, startMs: @entity.enteredMs, loop: false, keyframes: @entity.entry.keyframes }) null))
            (look (default (object/get @entity.looks (str/concat "pressable/" @config.intent "/idle")) {}))
          )
          (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: [(object/merge { id: (str/concat @config.id ":label"), key: @config.label, x: (if (and @entity.wrapped (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly))) (+ (+ @r.x 12) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)) (if (and (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly))) (+ (+ @r.x (* @r.w 0.5)) (* 0.5 (+ @config.iconSize 4))) (+ @r.x (* @r.w 0.5)))), y: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly) (+ (+ @r.y @r.h) 14) (if @entity.wrapped (+ @r.y (/ (- @r.h @entity.labelH) 2)) (+ @r.y (* @r.h 0.5)))), z: @config.z, align: "center", baseline: (if (or (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly) @entity.wrapped) "top" "middle"), color: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly) "rgba(0,0,0,0)" @look.textColor), font: @look.font, spring: @look.spring, maxWidth: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly) @config.tooltipWidth (if @entity.wrapped null (math/max 1 (- (- @r.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0))))), width: (if (and @entity.wrapped (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly))) (math/max 1 (- (- @r.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0))) null), wrap: (if (and @entity.wrapped (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly))) true null), measure: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly) null true) } (if (= @entity.rotate 0) {} { rotate: @entity.rotate, pivotX: (+ @r.x (/ @r.w 2)), pivotY: (+ @r.y (/ @r.h 2)) })), { id: (str/concat @config.id ":probe"), key: @config.label, x: @r.x, y: @r.y, z: @config.z, align: "left", baseline: "top", color: "rgba(0,0,0,0)", font: @look.font, measure: true }], nodes: (let ((rot @entity.rotate) (cx (+ @r.x (/ @r.w 2))) (cy (+ @r.y (/ @r.h 2)))) (let ((base : [node] (array/concat [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.fill null), backdrop: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.backdrop null), stroke: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.stroke null), strokeWidth: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.strokeWidth null), corners: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.corners null), shadow: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.shadow null), material: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.chrome)) @config.chrome) @look.material null), spring: @look.spring, animation: @anim, hit: true, semantic: { role: (if @config.link "link" "button"), labelledBy: (str/concat @config.id ":label"), disabled: false , order: (if (= @config.order 0) (+ @r.y (/ (if (= @entity.dir "rtl") (- 0 @r.x) @r.x) 10000)) @config.order), href: (if @config.link @config.href null), focused: false } }] (if (or (< @r.w @config.minTarget) (< @r.h @config.minTarget)) [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: (- @r.x (/ (math/max 0 (- @config.minTarget @r.w)) 2)), y: (- @r.y (/ (math/max 0 (- @config.minTarget @r.h)) 2)), z: @config.z }, width: (math/max @r.w @config.minTarget), height: (math/max @r.h @config.minTarget), fill: "rgba(0,0,0,0)", hit: true }] []) (if (= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") [] [{ type: draw-shape, id: (str/concat @config.id ":icon"), shape: "path", anchor: "top-left", position: { x: (if (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly) (+ @r.x (* (- @r.w @config.iconSize) 0.5)) (+ @r.x 16)), y: (+ @r.y (* (- @r.h @config.iconSize) 0.5)), z: @config.z }, d: (if (and (= @entity.dir "rtl") (!= @config.iconRtl "")) @config.iconRtl (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon)), scale: (* @config.iconSize 0.041666666666666664), fill: "rgba(0,0,0,0)", stroke: @look.textColor, strokeWidth: 1.8, hit: false }]) (array/map (if (= @look.decor "naqsh-stars") [0, 1, 2, 3] []) (fn i { type: draw-shape, id: (str/concat @config.id ":star:" @i), shape: polygon, anchor: "top-left", position: { x: (- (+ @r.x (if (or (= @i 1) (= @i 2)) @r.w 0)) 6), y: (- (+ @r.y (if (>= @i 2) @r.h 0)) 6), z: @config.z }, width: 12, height: 12, sides: 8, starRatio: 0.55, fill: @look.stroke, spring: @look.spring, animation: @anim })) (array/map (if (= @look.decor "glass-rim") [0] []) (fn i { type: draw-shape, id: (str/concat @config.id ":rim"), shape: rect, anchor: "top-left", position: { x: (+ @r.x 1), y: (+ @r.y 1), z: @config.z }, width: (- @r.w 2), height: (- @r.h 2), stroke: "rgba(255,255,255,0.18)", strokeWidth: 1, corners: { radius: (array/map (default @look.corners.radius [0, 0, 0, 0]) (fn v (math/max 0 (- @v 1)))), kind: (default @look.corners.kind "round") }, spring: @look.spring, animation: @anim })))))  (if (= @rot 0) @base [{ type: draw-group, id: (str/concat @config.id ":rotate"), position: { x: @cx, y: @cy }, rotate: @rot, items: [{ type: draw-group, id: (str/concat @config.id ":origin"), position: { x: (- 0 @cx), y: (- 0 @cy) }, items: @base }] }]))) }))
    }

    state hovered {
      INIT -> disabled when @config.disabled
      RASM_BOOT -> disabled when @config.disabled
      INIT -> idle when (not @config.disabled)
      RASM_BOOT -> idle when (not @config.disabled)
      RASM_DIRECTION -> hovered
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_THEME -> hovered
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_BREAKPOINT -> hovered when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_BREAKPOINT -> hovered when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_PLACE -> hovered when (array/some ?placed (fn p (= @p.id @config.id)))
