        @description "The surface's reading direction: under rtl the icon is drawn from iconRtl when one is given."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "The theme's looks; the control repaints with them."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the variant is the first name of chain (the announced breakpoint, then each smaller declared one) that `variants` holds, none of them keeps the configured button; a change repaints."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Placed rects; the control takes the entry whose id is its own."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Canvas text measurements, wired from the surface's RASM_MEASURED. The invisible one-line probe `<id>:probe` gives the label's natural width: wider than the room the button leaves it (its rect minus 24 px and the icon), the label wraps to as many lines as it needs in that room, centred vertically by its measured height (`<id>:label`); narrower, it is one line again. Unwired, the label stays one line and shrinks to fit."
      RASM_ENTER { order : [string]!  staggerMs : number!  entries : [RasmEntryItem] }
        @description "The entry choreography; a control in the order paints with its stagger."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "A pointer event from the surface; the control acts on its own id."
      RASM_FOCUS { id : string! }
        @description "Focus moved; the control with that id is focused, the others clear."
      RASM_ACTIVATE { id : string! }
        @description "Keyboard activation of the focused control."
    }

    config {
      id : string = ""
        @label "Id"
        @description "The region and paint id of the control."
        @tier "domain"
      label : MessageKey
        @label "Label"
        @description "The catalog key of the text on the button, which also names it to assistive technology."
        @tier "domain"
      intent : "primary" | "secondary" = "primary"
        @label "Intent"
        @description "Which look family the button paints with."
        @tier "presentation"
      disabled : boolean = false
        @label "Disabled"
        @description "A disabled button paints its disabled look and takes no pointer or keyboard action."
        @tier "presentation"
      icon : string = ""
        @label "Icon"
        @description "An SVG path on a 24-unit grid, stroked in the label colour: before the label, or alone with iconOnly."
        @tier "presentation"
      iconRtl : string = ""
        @label "Icon under rtl"
        @description "The icon's path for a right-to-left page, for a directional icon (a chevron, an arrow); empty draws the same icon in both directions."
        @tier "presentation"
      iconOnly : boolean = false
        @label "Icon only"
        @description "Show only the icon; the label stays the button's accessible name and shows under it as a tooltip on hover and focus."
        @tier "presentation"
      iconSize : number = 18
        @label "Icon size"
        @description "The icon's size in px."
        @tier "presentation"
      tooltipWidth : number = 200
        @label "Tooltip width"
        @description "The widest an icon-only button's tooltip label is drawn, in px."
        @tier "presentation"
      action : event = RASM_ACTION
        @label "Action"
        @description "The event emitted when the button is released over itself or activated."
        @tier "domain"
      link : boolean = false
        @label "Link"
        @description "On, activating the control also navigates to `href`, and assistive technology reads it as a link."
        @tier "presentation"
      href : string = "/"
        @label "Address"
        @description "Where a link control navigates: a path, or an https: or mailto: URL."
        @tier "presentation"
      order : number = 0
        @label "Order"
        @description "Where the control sits in the reading and tab order. 0 takes it from the layout: the control's vertical position on the page, then its position along the reading direction, the same scale every Rasm text, image and icon uses. Any other value is an explicit place on that scale."
        @tier "domain"
      chrome : boolean = true
        @label "Chrome"
        @description "Paint the button's plate (fill, border, shadow, material, backdrop). False paints no plate in any state: only the label, icon and decor remain, while the hit region, the press behaviour, the accessible name and the focused look's border ring are unchanged."
        @tier "presentation"
      variantBy : "" | "breakpoint" = ""
        @label "Variant by"
        @description "\"breakpoint\" picks iconOnly, icon and chrome from `variants` by the surface's breakpoint name, falling back to the next smaller declared variant, then to the configured ones; empty never switches."
        @tier "presentation"
      variants : Map string RasmPressShape = {}
        @label "Variants"
        @description "By breakpoint name (phone, tablet, desktop, wide): the iconOnly, icon and chrome a variant names replace the configured ones while that breakpoint is current; one it leaves out keeps the configured value. A phone variant with an icon, iconOnly and no chrome turns a labelled step button into a dot."
        @tier "presentation"
      minTarget : number = 24
        @label "Smallest hit target"
        @description "The smallest width and height in px of the pointer region: a control placed smaller keeps its painted size and gets a transparent hit region of at least this size, centred on it. A disabled control takes no pointer, so it gets none. 0 turns the expansion off."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order."
        @tier "presentation"
    }
  }

  page boot as RasmPressableStart -> RasmPressable
}
