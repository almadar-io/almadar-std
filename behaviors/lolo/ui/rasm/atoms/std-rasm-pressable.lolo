      RASM_MEASURED -> hovered when (not (or (let ((p (array/find ?items (fn it (= @it.id (str/concat @config.id ":probe")))))) (and (not (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.iconOnly)) @config.iconOnly)) (!= @p null) (!= (> @p.width (math/max 1 (- (- @entity.rect.w 24) (if (!= (default (let ((pv (object/get @config.variants @entity.variant null))) (if (= @pv null) null @pv.icon)) @config.icon) "") (+ @config.iconSize 4) 0)))) @entity.wrapped))) (let ((l (array/find ?items (fn it (= @it.id (str/concat @config.id ":label")))))) (and @entity.wrapped (!= @l null) (!= @l.height @entity.labelH)))))
      REPAINT -> hovered when (and @entity.hasLooks @entity.hasRect)
