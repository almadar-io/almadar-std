app std-rasm-drag [
  version: "1.0.0",
  description: "std-rasm-drag — a Rasm item the pointer can drag, with drop targets named by id. It paints its rect as a labelled button-role shape (looks drag/default/idle and drag/default/dragging); a press starts a drag, moves carry the item by the pointer's travel and emit the over event { id, target } when the target under the pointer changes (target is empty when none), and the release emits the dropped event { id, target, x, y } when the pointer is inside a target's placed rect, else the released event { id, x, y }. The item then returns to its placed rect: the program decides where it lives next. Targets are the ids in the targets knob; their rects arrive in RASM_PLACE, and the first listed target that contains the pointer wins. The dragged item paints at dragZ so it rides above the rest."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number! }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }

orbital RasmDragOrbital {
  entity RasmDragItem [runtime] {
    id : string!
    looks : Map string RasmLook = {}
    hasLooks : boolean = false
    rect : RasmRect = { x: 0, y: 0, w: 0, h: 0 }
    hasRect : boolean = false
    targetRects : [RasmPlaced] = []
    grabX : number = 0
    grabY : number = 0
    dx : number = 0
    dy : number = 0
    over : string = ""
    paints : number = 0
  }

  trait RasmDrag -> RasmDragItem [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
      RASM_BOOT -> idle
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
      RASM_THEME -> idle
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_PLACE -> idle
        (set @entity.targetRects (array/concat (array/filter @entity.targetRects (fn t (not (array/some ?placed (fn p (= @p.id @t.id)))))) (array/filter ?placed (fn p (array/includes @config.targets @p.id)))))
        (set @entity.hasRect (or @entity.hasRect (array/some ?placed (fn p (= @p.id @config.id)))))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: @entity.rect }))) @mine.rect))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      REPAINT -> idle when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (look (default (object/get @entity.looks "drag/default/idle") {}))
            (x (+ @r.x @entity.dx))
            (y (+ @r.y @entity.dy))
          )
          (emit RASM_PAINT { id: @config.id, z: @config.z, nodes: (array/concat [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @x, y: @y, z: @config.z }, width: @r.w, height: @r.h, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, corners: @look.corners, shadow: @look.shadow, spring: @look.spring, hit: true, semantic: { role: "button", name: @config.label, order: @config.order, focused: false } }] (if (and (!= @look.textColor null) (!= @look.font null)) [{ type: draw-text, id: (str/concat @config.id ":label"), text: @config.label, anchor: "top-left", position: { x: (+ @x 8), y: (+ @y 6), z: @config.z }, align: left, baseline: top, color: @look.textColor, font: @look.font, spring: @look.spring }] [])) }))
      RASM_POINTER -> dragging when (and (= ?id @config.id) (= ?kind "down"))
        (set @entity.grabX ?x)
        (set @entity.grabY ?y)
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
    }

    state dragging {
      INIT -> idle
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
      RASM_BOOT -> idle
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
      RASM_THEME -> dragging
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_PLACE -> dragging
        (set @entity.targetRects (array/concat (array/filter @entity.targetRects (fn t (not (array/some ?placed (fn p (= @p.id @t.id)))))) (array/filter ?placed (fn p (array/includes @config.targets @p.id)))))
        (set @entity.hasRect (or @entity.hasRect (array/some ?placed (fn p (= @p.id @config.id)))))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: @entity.rect }))) @mine.rect))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      REPAINT -> dragging when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (look (default (object/get @entity.looks "drag/default/dragging") {}))
            (x (+ @r.x @entity.dx))
            (y (+ @r.y @entity.dy))
          )
          (emit RASM_PAINT { id: @config.id, z: @config.dragZ, nodes: (array/concat [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @x, y: @y, z: @config.dragZ }, width: @r.w, height: @r.h, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, corners: @look.corners, shadow: @look.shadow, spring: @look.spring, hit: true, semantic: { role: "button", name: @config.label, order: @config.order, focused: false } }] (if (and (!= @look.textColor null) (!= @look.font null)) [{ type: draw-text, id: (str/concat @config.id ":label"), text: @config.label, anchor: "top-left", position: { x: (+ @x 8), y: (+ @y 6), z: @config.dragZ }, align: left, baseline: top, color: @look.textColor, font: @look.font, spring: @look.spring }] [])) }))
      RASM_POINTER -> dragging when (and (and (= ?id @config.id) (= ?kind "move")) (!= (let ((hit (default (array/find @entity.targetRects (fn t (and (and (>= ?x @t.rect.x) (<= ?x (+ @t.rect.x @t.rect.w))) (and (>= ?y @t.rect.y) (<= ?y (+ @t.rect.y @t.rect.h)))))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @hit.id) @entity.over))
        (set @entity.dx (- ?x @entity.grabX))
        (set @entity.dy (- ?y @entity.grabY))
        (set @entity.over (let ((hit (default (array/find @entity.targetRects (fn t (and (and (>= ?x @t.rect.x) (<= ?x (+ @t.rect.x @t.rect.w))) (and (>= ?y @t.rect.y) (<= ?y (+ @t.rect.y @t.rect.h)))))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @hit.id))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
        (emit @config.overEvent { id: @config.id, target: @entity.over })
      RASM_POINTER -> dragging when (and (and (= ?id @config.id) (= ?kind "move")) (= (let ((hit (default (array/find @entity.targetRects (fn t (and (and (>= ?x @t.rect.x) (<= ?x (+ @t.rect.x @t.rect.w))) (and (>= ?y @t.rect.y) (<= ?y (+ @t.rect.y @t.rect.h)))))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @hit.id) @entity.over))
        (set @entity.dx (- ?x @entity.grabX))
        (set @entity.dy (- ?y @entity.grabY))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> idle when (and (and (= ?id @config.id) (= ?kind "up")) (!= (let ((hit (default (array/find @entity.targetRects (fn t (and (and (>= ?x @t.rect.x) (<= ?x (+ @t.rect.x @t.rect.w))) (and (>= ?y @t.rect.y) (<= ?y (+ @t.rect.y @t.rect.h)))))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @hit.id) ""))
        (emit @config.dropped { id: @config.id, target: (let ((hit (default (array/find @entity.targetRects (fn t (and (and (>= ?x @t.rect.x) (<= ?x (+ @t.rect.x @t.rect.w))) (and (>= ?y @t.rect.y) (<= ?y (+ @t.rect.y @t.rect.h)))))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @hit.id), x: ?x, y: ?y })
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> idle when (and (and (= ?id @config.id) (= ?kind "up")) (= (let ((hit (default (array/find @entity.targetRects (fn t (and (and (>= ?x @t.rect.x) (<= ?x (+ @t.rect.x @t.rect.w))) (and (>= ?y @t.rect.y) (<= ?y (+ @t.rect.y @t.rect.h)))))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @hit.id) ""))
        (emit @config.released { id: @config.id, x: ?x, y: ?y })
        (set @entity.dx 0)
        (set @entity.dy 0)
        (set @entity.over "")
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: take the starting state."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "The theme's looks; the item repaints with them."
      RASM_PLACE { placed : [RasmPlaced]! }
        @description "Placed rects; the item takes its own and keeps the rects of its targets."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "A pointer event from the surface; the item acts on its own id, and the captured moves and release arrive with it."
    }

    emits {
      RASM_PAINT -> external {
        id : string!
        z : number!
        nodes : [node]!
      }
        @description "The item's whole paint, for the surface to collect."
        @tier "domain"
      REPAINT -> internal {
        n : number!
      }
        @tier "internal"
      @config.overEvent -> external {
        id : string!
        target : string!
      }
        @description "The target under the dragged item changed; target is empty when none."
        @tier "domain"
      @config.dropped -> external {
        id : string!
        target : string!
        x : number!
        y : number!
      }
        @description "The item was released over a target."
        @tier "domain"
      @config.released -> external {
        id : string!
        x : number!
        y : number!
      }
        @description "The item was released over no target."
        @tier "domain"
    }

    config {
      id : string = ""
        @label "Id"
        @description "The region and paint id of the item."
        @tier "domain"
      label : string = ""
        @label "Label"
        @description "The text on the item and its accessible name."
        @tier "domain"
      targets : [string] = []
        @label "Targets"
        @description "Ids of the placed rects the item can be dropped on."
        @tier "domain"
      overEvent : event = RASM_DRAG_OVER
        @label "Over"
        @description "The event emitted when the target under the item changes."
        @tier "domain"
      dropped : event = RASM_DRAG_DROPPED
        @label "Dropped"
        @description "The event emitted when the item is released over a target."
        @tier "domain"
      released : event = RASM_DRAG_RELEASED
        @label "Released"
        @description "The event emitted when the item is released over no target."
        @tier "domain"
      order : number = 0
        @label "Order"
        @description "Reading and tab order of the item's semantic node."
        @tier "domain"
      z : number = 0
        @label "Z"
        @description "Paint order at rest."
        @tier "presentation"
      dragZ : number = 100
        @label "Drag Z"
        @description "Paint order while dragged."
        @tier "presentation"
    }
  }

  page boot as RasmDragStart -> RasmDrag
}
