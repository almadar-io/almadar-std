app std-rasm-chat [
  version: "0.1.0",
  description: "std-rasm-chat — a conversation panel painted by one trait: a header with the assistant's name, the conversation as bubbles (the person's on the reading end, the assistant's on the reading start), and an input box at the foot. The composer declares the messages in order, each with its side, its message key and the id whose RASM_ENTER (from a std-rasm-stream line or a std-rasm-presence group) makes it appear; a message with an empty id is there from the start. Bubble heights come from the canvas's text measurements (RASM_MEASURED, wired from the surface), and when the conversation outgrows the panel the newest bubbles stay in view, as in a chat that scrolls to the bottom; the live conversation scrolls back by the wheel over it or a press and drag on it (a hit region <id>:list over the messages), clamped to its content, and shows only the bubbles that fit whole between the header and the foot. The newest bubble fades in. A live conversation arrives as RASM_CHAT_MESSAGES { id, messages } (records of literal text, side, sender, time, ticks and an image URL, oldest first, as a program reads its rows): from then on the panel paints those records instead of the declared messages, with the sender above the other side's bubbles when `showSender` is on, the image above the text, a voice record's bubble tappable (CHAT_AUDIO { id, url } on tap, for the program to play its audio), and the time and ticks at the bubble's foot in the chat/meta/idle look; a record's status shows a clock at that foot while it is `sending`, and a round alert (chat/alert/idle) beside a `failed` bubble that emits CHAT_RETRY { id } on tap; with `skeleton` on, pulsing placeholder bubbles (chat/skeleton/idle) show until records arrive and again after RASM_CHAT_LOADING; `paintInput` off leaves the foot free for a std-rasm-textfield the program places there. Mirrored under rtl. Looks (prefix `lookSet`, default chat): chat/panel/idle, chat/header/idle (title colour and font, divider stroke), chat/user/idle and chat/agent/idle (bubble fill, corners, text colour and font), chat/input/idle (box fill, stroke, corners, placeholder colour and font).",
  locales: [en, ar, sl]
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation? }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmChatMessage = { on : string!, side : "user" | "agent", key : MessageKey! }
type RasmChatRecord = { id : string!, side : "user" | "agent"!, text : string!, sender : string, at : string, image : string, ticks : string, audio : string, status : "sent" | "sending" | "failed", batch : string }
type RasmChatUnit = { i : number!, members : [number]!, batch : string!, side : string! }

orbital RasmChatOrbital {
  entity RasmChatRun [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The rect RASM_PLACE gave the panel, null until placed." = null
    dir : "ltr" | "rtl" @description "The reading direction the surface announced: the person's bubbles sit at its end." = "ltr"
    entered : [string] @description "The message ids that have entered so far." = []
    newest : number @description "The index of the message that appeared last, faded in; -1 before any entered." = -1
    heights : Map string number @description "Measured text heights by text id." = {}
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    live : boolean @description "True once RASM_CHAT_MESSAGES handed this panel records: it paints them instead of the configured messages." = false
    records : [RasmChatRecord] @description "The conversation RASM_CHAT_MESSAGES handed this panel, oldest first." = []
    back : number @description "How far the live conversation is scrolled up from its newest message, in px; 0 follows the newest." = 0
    maxBack : number @description "The furthest the live conversation can scroll up, from the last paint: its content height past the panel's." = 0
    dragging : boolean @description "A press on the conversation is dragging it." = false
    dragY : number @description "Where the drag began." = 0
    dragBack : number @description "The scroll offset when the drag began." = 0
    heading : string @description "A literal header RASM_CHAT_TITLE set, painted instead of the `title` key; empty paints the key." = ""
    pressImage : string @description "The photo a press on the conversation began on, empty for none: a release near it opens the photos." = ""
  }

  trait RasmChat -> RasmChatRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_ENTER -> ready when (and (!= @config.resetOn "") (array/includes ?order @config.resetOn))
        (set @entity.entered [])
        (set @entity.newest -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_ENTER -> ready when (and (not (and (!= @config.resetOn "") (array/includes ?order @config.resetOn))) (array/some @config.messages (fn m (and (!= @m.on "") (array/includes ?order @m.on) (not (array/includes @entity.entered @m.on))))))
        (set @entity.newest (array/reduce (array/range (array/len @config.messages)) @entity.newest (fn acc i (let ((m (array/nth @config.messages @i))) (if (and (!= @m.on "") (array/includes ?order @m.on)) @i @acc)))))
        (set @entity.entered (array/concat @entity.entered (array/map (array/filter @config.messages (fn m (and (!= @m.on "") (array/includes ?order @m.on) (not (array/includes @entity.entered @m.on))))) (fn m @m.on))))
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_ENTER -> ready when (and (not (and (!= @config.resetOn "") (array/includes ?order @config.resetOn))) (not (array/some @config.messages (fn m (and (!= @m.on "") (array/includes ?order @m.on) (not (array/includes @entity.entered @m.on)))))))
      RASM_MEASURED -> ready when (array/some ?items (fn it (and (str/startsWith @it.id (str/concat @config.id ":msg:")) (!= (object/get @entity.heights @it.id -1) @it.height))))
        (set @entity.heights (array/reduce ?items @entity.heights (fn acc it (if (str/startsWith @it.id (str/concat @config.id ":msg:")) (object/set @acc @it.id @it.height) @acc))))
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_MEASURED -> ready when (not (array/some ?items (fn it (and (str/startsWith @it.id (str/concat @config.id ":msg:")) (!= (object/get @entity.heights @it.id -1) @it.height)))))
      RASM_CHAT_MESSAGES -> ready when (= ?id @config.id)
        (set @entity.newest (if (> (array/len ?messages) (array/len @entity.records)) (- (array/len ?messages) 1) -1))
        (set @entity.records ?messages)
        (set @entity.live true)
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_CHAT_MESSAGES -> ready when (!= ?id @config.id)
      RASM_CHAT_LOADING -> ready when (= ?id @config.id)
        (set @entity.live false)
        (set @entity.records [])
        (set @entity.back 0)
        (set @entity.newest -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_CHAT_LOADING -> ready when (!= ?id @config.id)
      RASM_CHAT_TITLE -> ready when (= ?id @config.id)
        (set @entity.heading ?title)
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_CHAT_TITLE -> ready when (!= ?id @config.id)
      CHAT_PAINT -> ready when (and (!= @entity.rect null) @entity.live)
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (pn (default (object/get @entity.looks (str/concat @config.lookSet "/panel/idle") null) {})) (hd (default (object/get @entity.looks (str/concat @config.lookSet "/header/idle") null) {})) (us (default (object/get @entity.looks (str/concat @config.lookSet "/user/idle") null) {})) (ag (default (object/get @entity.looks (str/concat @config.lookSet "/agent/idle") null) {})) (mt (default (object/get @entity.looks (str/concat @config.lookSet "/meta/idle") null) (default (object/get @entity.looks (str/concat @config.lookSet "/agent/idle") null) {}))) (ip (default (object/get @entity.looks (str/concat @config.lookSet "/input/idle") null) {})) (bad (default (object/get @entity.looks (str/concat @config.lookSet "/alert/idle") null) {})) (fade { durationMs: 380, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 10 }, { at: 1, opacity: 1, offsetY: 0 }] }))
          (let ((top (+ @r.y (+ @config.headerH @config.gap))) (bottom (- (+ @r.y @r.h) (if @config.paintInput (+ @config.inputH (* 2 @config.gap)) @config.gap))) (bw (* (- @r.w (* 2 @config.padX)) @config.bubbleShare)) (n (array/len @entity.records)))
            (let ((units (array/reduce (array/range @n) (let ((none : [RasmChatUnit] [])) @none) (fn acc i (let ((m (default (array/nth @entity.records @i) { id: "", side: "agent", text: "" })) (prev (if (= (array/len @acc) 0) { i: -1, members: [], batch: "", side: "" } (default (array/nth @acc (- (array/len @acc) 1)) { i: -1, members: [], batch: "", side: "" })))) (if (and (>= @prev.i 0) (!= @prev.batch "") (!= (default @m.image "") "") (= @prev.batch (default @m.batch "")) (= @prev.side @m.side)) (array/append (array/dropLast @acc 1) { i: @i, members: (array/append @prev.members @i), batch: @prev.batch, side: @prev.side }) (array/append @acc { i: @i, members: [@i], batch: (if (!= (default @m.image "") "") (default @m.batch "") ""), side: @m.side })))))))
            (let ((parts (array/map @units (fn u (let ((m (default (array/nth @entity.records @u.i) { id: "", side: "agent", text: "" })) (picIx (array/filter @u.members (fn q (!= (default (let ((r (default (array/nth @entity.records @q) { id: "", side: "agent", text: "" }))) @r.image) "") ""))))) (let ((sending (array/some @u.members (fn q (= (default (let ((r (default (array/nth @entity.records @q) { id: "", side: "agent", text: "" }))) @r.status) "sent") "sending"))))) { i: @u.i, picIx: @picIx, named: (and @config.showSender (= @m.side "agent") (!= (default @m.sender "") "")), pictured: (> (array/len @picIx) 0), sending: @sending, failed: (array/reduce @u.members -1 (fn a q (if (and (< @a 0) (= (default (let ((r (default (array/nth @entity.records @q) { id: "", side: "agent", text: "" }))) @r.status) "sent") "failed")) @q @a))), meta: (or (!= (default @m.at "") "") (!= (default @m.ticks "") "") @sending) }))))))
              (let ((hs (array/map @parts (fn p (+ (+ (+ (default (object/get @entity.heights (str/concat @config.id ":msg:" @p.i) null) @config.lineH) (* 2 @config.padY)) (if @p.named @config.metaH 0)) (+ (if @p.pictured (+ @config.imageH @config.gap) 0) (if @p.meta @config.metaH 0)))))))
                (let ((total (array/reduce @hs 0 (fn acc h (+ @acc (+ @h @config.gap))))))
                  (let ((laid (array/map (array/range (array/len @parts)) (fn j { i: (default (let ((pj (array/nth @parts @j))) @pj.i) 0), k: @j, h: (default (array/nth @hs @j) 0), y: (+ (+ (math/min @top (- @bottom @total)) (math/max 0 (math/min @entity.back (math/max 0 (- @total (- @bottom @top)))))) (array/reduce (array/filter (array/range (array/len @parts)) (fn q (< @q @j))) 0 (fn acc q (+ @acc (+ (default (array/nth @hs @q) 0) @config.gap))))) }))))
                    (let ((shown (array/filter @laid (fn l (and (>= @l.y @top) (<= (+ @l.y @l.h) @bottom))))))
                      (do (set @entity.maxBack (math/max 0 (- @total (- @bottom @top)))) (emit RASM_PAINT {
                        id: @config.id,
                        z: @config.z,
                        texts: (array/concat (if (= @entity.heading "") [{ id: (str/concat @config.id ":title"), key: @config.title, x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) @config.padX) (+ @r.x @config.padX)), y: (+ @r.y (/ @config.headerH 2)), z: (+ @config.z 2), align: (if (= @entity.dir "rtl") "right" "left"), baseline: "middle", color: @hd.textColor, font: @hd.font, width: (- @r.w (* 2 @config.padX)), wrap: false }] [])
                          (array/map (array/filter @shown (fn l (>= (let ((pf (default (array/nth @parts @l.k) { i: 0, picIx: [], named: false, pictured: false, sending: false, failed: -1, meta: false }))) @pf.failed) 0))) (fn l (let ((m (default (array/nth @entity.records @l.i) { id: "", side: "agent", text: "" })) (fi (let ((pf (default (array/nth @parts @l.k) { i: 0, picIx: [], named: false, pictured: false, sending: false, failed: -1, meta: false }))) @pf.failed))) (let ((atEnd (if (= @entity.dir "rtl") (not (= @m.side "user")) (= @m.side "user")))) (let ((ax (if @atEnd (- (- (+ @r.x @r.w) (+ @config.padX @bw)) (+ @config.alertSize 8)) (+ (+ (+ @r.x @config.padX) @bw) 8)))) { id: (str/concat @config.id ":retry:" @fi ":label"), key: @config.retryLabel, x: (+ @ax (/ @config.alertSize 2)), y: (+ @l.y (/ @l.h 2)), z: (+ @config.z 5), align: "center", baseline: "middle", color: "rgba(0,0,0,0)", font: @mt.font, wrap: false })))))),
                        nodes: (array/concat
                          [{ type: draw-shape, id: (str/concat @config.id ":panel"), shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: @pn.fill, stroke: @pn.stroke, strokeWidth: @pn.strokeWidth, corners: @pn.corners, hit: false },
                           { type: draw-shape, id: (str/concat @config.id ":rule"), shape: rect, anchor: "top-left", position: { x: @r.x, y: (+ @r.y @config.headerH), z: (+ @config.z 1) }, width: @r.w, height: (default @hd.strokeWidth 1), fill: @hd.stroke, hit: false },
                           { type: draw-shape, id: (str/concat @config.id ":list"), shape: rect, anchor: "top-left", position: { x: @r.x, y: @top, z: (+ @config.z 2) }, width: @r.w, height: (math/max 0 (- @bottom @top)), fill: "rgba(0,0,0,0)", hit: true, wheel: true }]
                          (if (= @entity.heading "") [] (let ((heading : [node] [{ type: draw-text, id: (str/concat @config.id ":heading"), text: @entity.heading, anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) @config.padX) (+ @r.x @config.padX)), y: (+ @r.y (/ @config.headerH 2)), z: (+ @config.z 2) }, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "middle", color: @hd.textColor, font: @hd.font, width: (- @r.w (* 2 @config.padX)), wrap: false, hit: false }])) @heading))
                          (if @config.paintInput [{ type: draw-shape, id: (str/concat @config.id ":input"), shape: rect, anchor: "top-left", position: { x: (+ @r.x @config.padX), y: (- (+ @r.y @r.h) (+ @config.gap @config.inputH)), z: (+ @config.z 1) }, width: (- @r.w (* 2 @config.padX)), height: @config.inputH, fill: @ip.fill, stroke: @ip.stroke, strokeWidth: @ip.strokeWidth, corners: @ip.corners, hit: false }] [])
                          (array/flatten (array/map @shown (fn l (let ((m (default (array/nth @entity.records @l.i) { id: "", side: "agent", text: "" })) (p (default (array/nth @parts @l.k) { i: 0, picIx: [], named: false, pictured: false, sending: false, failed: -1, meta: false }))) (let ((lk (if (= @m.side "user") @us @ag)) (atEnd (if (= @entity.dir "rtl") (not (= @m.side "user")) (= @m.side "user")))) (let ((bx (if @atEnd (- (+ @r.x @r.w) (+ @config.padX @bw)) (+ @r.x @config.padX))) (tx (if (= @entity.dir "rtl") (- (+ (if @atEnd (- (+ @r.x @r.w) (+ @config.padX @bw)) (+ @r.x @config.padX)) @bw) @config.padX) (+ (if @atEnd (- (+ @r.x @r.w) (+ @config.padX @bw)) (+ @r.x @config.padX)) @config.padX))) (al (if (= @entity.dir "rtl") "right" "left")) (anim (if (= @l.i @entity.newest) @fade null)) (nameH (if @p.named @config.metaH 0)) (picH (if @p.pictured (+ @config.imageH @config.gap) 0)))
                            (array/concat
                              [{ type: draw-shape, id: (str/concat @config.id ":bubble:" @l.i), shape: rect, anchor: "top-left", position: { x: @bx, y: @l.y, z: (+ @config.z 3) }, width: @bw, height: @l.h, fill: @lk.fill, stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, corners: @lk.corners, animation: @anim, hit: (!= (default @m.audio "") "") }]
                              (if @p.named [{ type: draw-text, id: (str/concat @config.id ":sender:" @l.i), text: (default @m.sender ""), anchor: "top-left", position: { x: @tx, y: (+ @l.y @config.padY), z: (+ @config.z 4) }, align: @al, baseline: "top", color: @mt.textColor, font: @mt.font, width: (- @bw (* 2 @config.padX)), wrap: false, animation: @anim, hit: false }] [])
                              (if @p.pictured (let ((W (- @bw (* 2 @config.padX))) (H @config.imageH) (c (array/len @p.picIx)) (x0 (+ @bx @config.padX)) (y0 (+ (+ @l.y @config.padY) @nameH)) (g 4)) (let ((w2 (/ (- @W @g) 2)) (h2 (/ (- @H @g) 2))) (let ((cells : [RasmRect] (if (= @c 1) [{ x: 0, y: 0, w: @W, h: @H }] (if (= @c 2) [{ x: 0, y: 0, w: @w2, h: @H }, { x: (+ @w2 @g), y: 0, w: @w2, h: @H }] (if (= @c 3) [{ x: 0, y: 0, w: @w2, h: @H }, { x: (+ @w2 @g), y: 0, w: @w2, h: @h2 }, { x: (+ @w2 @g), y: (+ @h2 @g), w: @w2, h: @h2 }] [{ x: 0, y: 0, w: @w2, h: @h2 }, { x: (+ @w2 @g), y: 0, w: @w2, h: @h2 }, { x: 0, y: (+ @h2 @g), w: @w2, h: @h2 }, { x: (+ @w2 @g), y: (+ @h2 @g), w: @w2, h: @h2 }]))))) (let ((tiles : [node] (array/map (array/range (array/len @cells)) (fn q (let ((cell (default (array/nth @cells @q) { x: 0, y: 0, w: 0, h: 0 })) (ri (default (array/nth @p.picIx @q) 0))) { type: draw-sprite, id: (str/concat @config.id ":image:" @ri), asset: { url: (default (let ((r (default (array/nth @entity.records @ri) { id: "", side: "agent", text: "" }))) @r.image) "") }, fit: (if (= @c 1) "contain" "cover"), anchor: "top-left", position: { x: (+ @x0 @cell.x), y: (+ @y0 @cell.y), z: (+ @config.z 4) }, width: @cell.w, height: @cell.h, alt: @config.imageAlt, hit: true })))) (more : [node] (if (<= @c 4) [] [{ type: draw-shape, id: (str/concat @config.id ":more:" @l.i), shape: rect, anchor: "top-left", position: { x: (+ (+ @x0 @w2) @g), y: (+ (+ @y0 @h2) @g), z: (+ @config.z 5) }, width: @w2, height: @h2, fill: "rgba(0,0,0,0.45)", hit: false }, { type: draw-text, id: (str/concat @config.id ":more:" @l.i ":count"), text: (str/concat "+" (- @c 3)), anchor: "top-left", position: { x: (+ (+ (+ @x0 @w2) @g) (/ @w2 2)), y: (+ (+ (+ @y0 @h2) @g) (/ @h2 2)), z: (+ @config.z 6) }, align: "center", baseline: "middle", color: "#ffffff", font: @lk.font, wrap: false, hit: false }]))) (array/concat @tiles @more))))) [])
                              [{ type: draw-text, id: (str/concat @config.id ":msg:" @l.i), text: @m.text, anchor: "top-left", position: { x: @tx, y: (+ (+ (+ @l.y @config.padY) @nameH) @picH), z: (+ @config.z 4) }, align: @al, baseline: "top", color: @lk.textColor, font: @lk.font, width: (- @bw (* 2 @config.padX)), wrap: true, measure: true, animation: @anim, hit: false }]
                              (if @p.meta [{ type: draw-text, id: (str/concat @config.id ":meta:" @l.i), text: (str/trim (str/concat (default @m.at "") " " (default @m.ticks ""))), anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (+ (+ @bx @config.padX) (if @p.sending 18 0)) (- (- (+ @bx @bw) @config.padX) (if @p.sending 18 0))), y: (- (+ @l.y @l.h) (+ @config.padY @config.metaH)), z: (+ @config.z 4) }, align: (if (= @entity.dir "rtl") "left" "right"), baseline: "top", color: @mt.textColor, font: @mt.font, wrap: false, animation: @anim, hit: false }] [])
                              (if @p.sending [{ type: draw-shape, id: (str/concat @config.id ":clock:" @l.i), shape: "path", anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (+ @bx @config.padX) (- (+ @bx @bw) (+ @config.padX 14))), y: (- (+ @l.y @l.h) (+ @config.padY @config.metaH)), z: (+ @config.z 4) }, d: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18Z M12 7 L12 12 L15.5 14", scale: 0.5833333333333334, fill: "rgba(0,0,0,0)", stroke: @mt.textColor, strokeWidth: 2, hit: false }] [])
                              (if (>= @p.failed 0) (let ((ax (if @atEnd (- @bx (+ @config.alertSize 8)) (+ (+ @bx @bw) 8))) (ay (- (+ @l.y (/ @l.h 2)) (/ @config.alertSize 2)))) (let ((alert : [node] [{ type: draw-shape, id: (str/concat @config.id ":retry:" @p.failed), shape: rect, anchor: "top-left", position: { x: @ax, y: @ay, z: (+ @config.z 5) }, width: @config.alertSize, height: @config.alertSize, fill: @bad.fill, corners: { radius: [999, 999, 999, 999], kind: "round" }, hit: true, semantic: { role: "button", labelledBy: (str/concat @config.id ":retry:" @p.failed ":label"), disabled: false, order: 0, focused: false } }, { type: draw-text, id: (str/concat @config.id ":retry:" @p.failed ":mark"), text: "!", anchor: "top-left", position: { x: (+ @ax (/ @config.alertSize 2)), y: (+ @ay (/ @config.alertSize 2)), z: (+ @config.z 6) }, align: "center", baseline: "middle", color: @bad.textColor, font: @bad.font, wrap: false, hit: false }])) @alert)) [])))))))))
                      }))))))))))
      CHAT_PAINT -> ready when (and (!= @entity.rect null) (not @entity.live) @config.skeleton)
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (pn (default (object/get @entity.looks (str/concat @config.lookSet "/panel/idle") null) {})) (hd (default (object/get @entity.looks (str/concat @config.lookSet "/header/idle") null) {})) (us (default (object/get @entity.looks (str/concat @config.lookSet "/user/idle") null) {})) (ag (default (object/get @entity.looks (str/concat @config.lookSet "/agent/idle") null) {})) (sk (default (object/get @entity.looks (str/concat @config.lookSet "/skeleton/idle") null) {})) (ip (default (object/get @entity.looks (str/concat @config.lookSet "/input/idle") null) {})) (pulse { durationMs: 1200, loop: true, keyframes: [{ at: 0, opacity: 0.45, offsetY: 0 }, { at: 0.5, opacity: 1, offsetY: 0 }, { at: 1, opacity: 0.45, offsetY: 0 }] }))
          (let ((top (+ @r.y (+ @config.headerH @config.gap))) (iw (- @r.w (* 2 @config.padX))))
            (emit RASM_PAINT {
              id: @config.id,
              z: @config.z,
              texts: (if (= @entity.heading "") [{ id: (str/concat @config.id ":title"), key: @config.title, x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) @config.padX) (+ @r.x @config.padX)), y: (+ @r.y (/ @config.headerH 2)), z: (+ @config.z 2), align: (if (= @entity.dir "rtl") "right" "left"), baseline: "middle", color: @hd.textColor, font: @hd.font, width: (- @r.w (* 2 @config.padX)), wrap: false }] []),
              nodes: (array/concat
                [{ type: draw-shape, id: (str/concat @config.id ":panel"), shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: @pn.fill, stroke: @pn.stroke, strokeWidth: @pn.strokeWidth, corners: @pn.corners, hit: false },
                 { type: draw-shape, id: (str/concat @config.id ":rule"), shape: rect, anchor: "top-left", position: { x: @r.x, y: (+ @r.y @config.headerH), z: (+ @config.z 1) }, width: @r.w, height: (default @hd.strokeWidth 1), fill: @hd.stroke, hit: false }]
                (if (= @entity.heading "") [] (let ((heading : [node] [{ type: draw-text, id: (str/concat @config.id ":heading"), text: @entity.heading, anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) @config.padX) (+ @r.x @config.padX)), y: (+ @r.y (/ @config.headerH 2)), z: (+ @config.z 2) }, align: (if (= @entity.dir "rtl") "right" "left"), baseline: "middle", color: @hd.textColor, font: @hd.font, width: (- @r.w (* 2 @config.padX)), wrap: false, hit: false }])) @heading))
                (if @config.paintInput [{ type: draw-shape, id: (str/concat @config.id ":input"), shape: rect, anchor: "top-left", position: { x: (+ @r.x @config.padX), y: (- (+ @r.y @r.h) (+ @config.gap @config.inputH)), z: (+ @config.z 1) }, width: (- @r.w (* 2 @config.padX)), height: @config.inputH, fill: @ip.fill, stroke: @ip.stroke, strokeWidth: @ip.strokeWidth, corners: @ip.corners, hit: false }] [])
                (array/map (array/range 4) (fn i (let ((b (default (array/nth [{ mine: false, w: 0.55, h: 44, o: 0 }, { mine: true, w: 0.7, h: 64, o: 44 }, { mine: false, w: 0.45, h: 44, o: 108 }, { mine: true, w: 0.6, h: 84, o: 152 }] @i) { mine: false, w: 0.5, h: 44, o: 0 }))) (let ((atEnd (if (= @entity.dir "rtl") (not @b.mine) @b.mine))) { type: draw-shape, id: (str/concat @config.id ":skeleton:" @i), shape: rect, anchor: "top-left", position: { x: (if @atEnd (- (+ @r.x @r.w) (+ @config.padX (* @iw @b.w))) (+ @r.x @config.padX)), y: (+ (+ @top @b.o) (* @i @config.gap)), z: (+ @config.z 3) }, width: (* @iw @b.w), height: @b.h, fill: @sk.fill, corners: (if @b.mine @us.corners @ag.corners), animation: @pulse, hit: false })))))
            })))
      CHAT_PAINT -> ready when (and (!= @entity.rect null) (not @entity.live) (not @config.skeleton))
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (pn (default (object/get @entity.looks (str/concat @config.lookSet "/panel/idle") null) {})) (hd (default (object/get @entity.looks (str/concat @config.lookSet "/header/idle") null) {})) (us (default (object/get @entity.looks (str/concat @config.lookSet "/user/idle") null) {})) (ag (default (object/get @entity.looks (str/concat @config.lookSet "/agent/idle") null) {})) (ip (default (object/get @entity.looks (str/concat @config.lookSet "/input/idle") null) {})) (fade { durationMs: 380, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 10 }, { at: 1, opacity: 1, offsetY: 0 }] }))
          (let ((top (+ @r.y (+ @config.headerH @config.gap))) (bottom (- (+ @r.y @r.h) (+ @config.inputH (* 2 @config.gap)))) (bw (* (- @r.w (* 2 @config.padX)) @config.bubbleShare)) (vis (array/filter (array/range (array/len @config.messages)) (fn i (let ((m (array/nth @config.messages @i))) (and true (or (= @m.on "") (array/includes @entity.entered @m.on))))))))
            (let ((hs (array/map @vis (fn i (+ (default (object/get @entity.heights (str/concat @config.id ":msg:" @i) null) @config.lineH) (* 2 @config.padY))))))
              (let ((total (array/reduce @hs 0 (fn acc h (+ @acc (+ @h @config.gap))))))
                (let ((start (math/min @top (- @bottom @total))) (laid (array/map (array/range (array/len @vis)) (fn j { i: (default (array/nth @vis @j) 0), h: (default (array/nth @hs @j) 0), y: (array/reduce (array/filter (array/range (array/len @vis)) (fn q (< @q @j))) 0 (fn acc q (+ @acc (+ (default (array/nth @hs @q) 0) @config.gap)))) }))))
                  (let ((shown (array/filter (array/map @laid (fn l { i: @l.i, h: @l.h, y: (+ (math/min @top (- @bottom @total)) @l.y) })) (fn l (>= @l.y @top)))))
                    (emit RASM_PAINT {
                      id: @config.id,
                      z: @config.z,
                      texts: (array/concat
                        [{ id: (str/concat @config.id ":title"), key: @config.title, x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) @config.padX) (+ @r.x @config.padX)), y: (+ @r.y (/ @config.headerH 2)), z: (+ @config.z 2), align: (if (= @entity.dir "rtl") "right" "left"), baseline: "middle", color: @hd.textColor, font: @hd.font, width: (- @r.w (* 2 @config.padX)), wrap: false },
                         { id: (str/concat @config.id ":placeholder"), key: @config.placeholder, x: (if (= @entity.dir "rtl") (- (+ @r.x @r.w) (+ @config.padX 14)) (+ @r.x (+ @config.padX 14))), y: (- (+ @r.y @r.h) (+ @config.gap (/ @config.inputH 2))), z: (+ @config.z 2), align: (if (= @entity.dir "rtl") "right" "left"), baseline: "middle", color: @ip.textColor, font: @ip.font, width: (- @r.w (* 2 (+ @config.padX 14))), wrap: false }]
                        (array/map @shown (fn l (let ((m (array/nth @config.messages @l.i))) (let ((mine (= (default @m.side "agent") "user")) (lk (if (= (default @m.side "agent") "user") @us @ag))) (let ((atEnd (if (= @entity.dir "rtl") (not @mine) @mine))) { id: (str/concat @config.id ":msg:" @l.i), key: @m.key, x: (if @atEnd (- (+ @r.x @r.w) (+ @config.padX (- @bw @config.padX))) (+ @r.x (* 2 @config.padX))), y: (+ @l.y @config.padY), z: (+ @config.z 4), align: (if (= @entity.dir "rtl") "right" "left"), baseline: "top", color: @lk.textColor, font: @lk.font, width: (- @bw (* 2 @config.padX)), wrap: true, measure: true, animation: (if (= @l.i @entity.newest) @fade null) })))))),
                      nodes: (array/concat
                        [{ type: draw-shape, id: (str/concat @config.id ":panel"), shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: @pn.fill, stroke: @pn.stroke, strokeWidth: @pn.strokeWidth, corners: @pn.corners, hit: false },
                         { type: draw-shape, id: (str/concat @config.id ":rule"), shape: rect, anchor: "top-left", position: { x: @r.x, y: (+ @r.y @config.headerH), z: (+ @config.z 1) }, width: @r.w, height: (default @hd.strokeWidth 1), fill: @hd.stroke, hit: false },
                         { type: draw-shape, id: (str/concat @config.id ":input"), shape: rect, anchor: "top-left", position: { x: (+ @r.x @config.padX), y: (- (+ @r.y @r.h) (+ @config.gap @config.inputH)), z: (+ @config.z 1) }, width: (- @r.w (* 2 @config.padX)), height: @config.inputH, fill: @ip.fill, stroke: @ip.stroke, strokeWidth: @ip.strokeWidth, corners: @ip.corners, hit: false }]
                        (array/map @shown (fn l (let ((m (array/nth @config.messages @l.i))) (let ((mine (= (default @m.side "agent") "user")) (lk (if (= (default @m.side "agent") "user") @us @ag))) (let ((atEnd (if (= @entity.dir "rtl") (not @mine) @mine))) { type: draw-shape, id: (str/concat @config.id ":bubble:" @l.i), shape: rect, anchor: "top-left", position: { x: (if @atEnd (- (+ @r.x @r.w) (+ @config.padX @bw)) (+ @r.x @config.padX)), y: @l.y, z: (+ @config.z 3) }, width: @bw, height: @l.h, fill: @lk.fill, stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, corners: @lk.corners, animation: (if (= @l.i @entity.newest) @fade null), hit: false }))))))
                    })))))))
      RASM_WHEEL -> ready when (and @entity.live (= ?target (str/concat @config.id ":list")))
        (set @entity.back (math/max 0 (math/min @entity.maxBack (- @entity.back ?dy))))
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_WHEEL -> ready when (not (and @entity.live (= ?target (str/concat @config.id ":list"))))
      RASM_POINTER -> ready when (and @entity.live (= ?kind "down") (= ?id (str/concat @config.id ":list")))
        (set @entity.dragging true)
        (set @entity.dragY ?y)
        (set @entity.dragBack @entity.back)
      RASM_POINTER -> ready when (and @entity.dragging (= ?kind "move"))
        (set @entity.back (math/max 0 (math/min @entity.maxBack (+ @entity.dragBack (- ?y @entity.dragY)))))
        (set @entity.paints (+ @entity.paints 1))
        (emit CHAT_PAINT { n: @entity.paints })
      RASM_POINTER -> ready when (and @entity.live (not @entity.dragging) (= ?kind "down") (str/startsWith ?id (str/concat @config.id ":image:")))
        (set @entity.dragging true)
        (set @entity.dragY ?y)
        (set @entity.dragBack @entity.back)
        (set @entity.pressImage ?id)
      RASM_POINTER -> ready when (and @entity.dragging (= ?kind "up") (!= @entity.pressImage "") (< (math/abs (- ?y @entity.dragY)) 8))
        (let ((ri (default (str/to-number (str/slice @entity.pressImage (str/len (str/concat @config.id ":image:")))) -1)))
          (let ((r (default (array/nth @entity.records @ri) { id: "", side: "agent", text: "" })))
            (let ((same (array/filter (array/range (array/len @entity.records)) (fn q (let ((o (default (array/nth @entity.records @q) { id: "", side: "agent", text: "" }))) (and (!= (default @o.image "") "") (if (= (default @r.batch "") "") (= @q @ri) (= (default @o.batch "") (default @r.batch "")))))))))
              (emit CHAT_IMAGE_OPENED { urls: (array/map @same (fn q (default (let ((o (default (array/nth @entity.records @q) { id: "", side: "agent", text: "" }))) @o.image) ""))), index: (array/len (array/filter @same (fn q (< @q @ri)))) }))))
        (set @entity.dragging false)
        (set @entity.pressImage "")
      RASM_POINTER -> ready when (and @entity.dragging (= ?kind "up") (not (and (!= @entity.pressImage "") (< (math/abs (- ?y @entity.dragY)) 8))))
        (set @entity.dragging false)
        (set @entity.pressImage "")
      RASM_POINTER -> ready when (and (not @entity.dragging) (= ?kind "up") (str/startsWith ?id (str/concat @config.id ":bubble:")) (!= (default (object/get (default (array/nth @entity.records (default (str/to-number (str/slice ?id (str/len (str/concat @config.id ":bubble:")))) -1)) { id: "", side: "agent", text: "" }) "audio") "") ""))
        (let ((m (default (array/nth @entity.records (default (str/to-number (str/slice ?id (str/len (str/concat @config.id ":bubble:")))) -1)) { id: "", side: "agent", text: "", audio: "" })))
          (emit CHAT_AUDIO { id: @m.id, url: (default @m.audio "") }))
      RASM_POINTER -> ready when (and (not @entity.dragging) (= ?kind "up") (str/startsWith ?id (str/concat @config.id ":retry:")))
        (let ((m (default (array/nth @entity.records (default (str/to-number (str/slice ?id (str/len (str/concat @config.id ":retry:")))) -1)) { id: "", side: "agent", text: "" })))
          (when (= (default @m.status "sent") "failed") (emit CHAT_RETRY { id: @m.id })))
      RASM_POINTER -> ready when (and (not @entity.dragging) (not (and (= ?kind "up") (str/startsWith ?id (str/concat @config.id ":retry:")))) (not (and @entity.live (= ?kind "down") (= ?id (str/concat @config.id ":list")))) (not (and @entity.live (= ?kind "down") (str/startsWith ?id (str/concat @config.id ":image:")))) (not (and (= ?kind "up") (str/startsWith ?id (str/concat @config.id ":bubble:")) (!= (default (object/get (default (array/nth @entity.records (default (str/to-number (str/slice ?id (str/len (str/concat @config.id ":bubble:")))) -1)) { id: "", side: "agent", text: "" }) "audio") "") ""))))
      CHAT_PAINT -> ready when (= @entity.rect null)
    }

    emits {
      CHAT_PAINT -> internal {
        n : number!
      }
        @description "Repaint the panel from the stored rect, looks, entered messages and measured heights."
        @tier "internal"
      RASM_PAINT -> external {
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
      CHAT_AUDIO -> external {
        id : string!
        url : string!
      }
      CHAT_RETRY -> external {
        id : string!
      }
      CHAT_IMAGE_OPENED -> external {
        urls : [string]!
        index : number!
      }
        @description "A photo was tapped without dragging: every photo sent with it (its batch, or just that photo), oldest first, and the tapped one's place among them, for the program to show them."
        @tier "domain"
        @description "The alert beside a failed message was tapped: the record's id, for the program to send it again."
        @tier "domain"
        @description "A voice bubble was tapped: the record's id and its audio address, for the program to play."
        @description "The panel, header rule, input box, every visible bubble and their texts for the surface to collect."
        @tier "primary"
    }

    listens {
      RASM_WHEEL { target : string!  x : number!  y : number!  dx : number!  dy : number! }
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction: the person's bubbles sit at its end."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the panel's rect when it is placed."
      RASM_ENTER { order : [string]!  staggerMs : number }
        @description "An entry naming a message's `on` id makes that message appear, newest faded in."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Canvas text measurements of this panel's bubble texts, wired from the surface; bubbles lay out again when a height changes."
      RASM_CHAT_MESSAGES { id : string!  messages : [RasmChatRecord]! }
        @description "The live conversation for the panel `id` names, oldest first: from then on the panel paints these records (literal text, sender, time, ticks, an image) instead of the configured messages; a longer list fades its newest bubble in."
      RASM_CHAT_LOADING { id : string! }
        @description "The panel `id` names is loading a conversation: it drops its records and, with `skeleton` on, shows placeholder bubbles until RASM_CHAT_MESSAGES arrives."
      RASM_CHAT_TITLE { id : string!  title : string! }
        @description "A literal header for the panel `id` names, such as the person a conversation is with; an empty title paints the `title` key again."
    }

    config {
      id : string = "chat"
        @label "Id"
        @description "The panel's RASM_PLACE key and paint id."
        @tier "presentation"
      resetOn : string = ""
        @label "Reset on"
        @description "An entry id that clears every applied step and repaints, so a looping demonstration starts each run clean; empty never resets."
        @tier "presentation"
      lookSet : string = "chat"
        @label "Look set"
        @description "The prefix of this widget's look keys (`<lookSet>/frame/idle` and the rest), so two widgets on one page can wear different looks."
        @tier "presentation"
      z : number = 2
        @label "Z"
        @description "Paint order on the surface; bubbles and texts paint above."
        @tier "presentation"
      title : MessageKey = "chat.title"
        @label "Title"
        @description "The assistant's name in the header."
        @tier "domain"
      placeholder : MessageKey = "chat.placeholder"
        @label "Placeholder"
        @description "The hint in the input box at the foot."
        @tier "domain"
      messages : [RasmChatMessage] = []
        @label "Messages"
        @description "The conversation in order: the entry id that shows each one (empty for from the start), its side and its message key."
        @tier "domain"
      headerH : number = 48
        @label "Header height"
        @description "The header's height in px."
        @tier "presentation"
      inputH : number = 44
        @label "Input height"
        @description "The input box's height in px."
        @tier "presentation"
      padX : number = 14
        @label "Side padding"
        @description "Space in px at the panel's sides and inside a bubble."
        @tier "presentation"
      padY : number = 10
        @label "Bubble padding"
        @description "Space in px above and below a bubble's text."
        @tier "presentation"
      gap : number = 12
        @label "Gap"
        @description "Space in px between bubbles and around the header and input."
        @tier "presentation"
      lineH : number = 22
        @label "Line height"
        @description "A bubble text's height in px before the canvas has measured it."
        @tier "presentation"
      bubbleShare : number = 0.84
        @label "Bubble width"
        @description "A bubble's width as a share of the panel's inner width."
        @tier "presentation"
      paintInput : boolean = true
        @label "Paint the input box"
        @description "Paint the input box at the foot; off when the program places its own std-rasm-textfield there."
        @tier "presentation"
      showSender : boolean = false
        @label "Show senders"
        @description "Paint each record's sender above the other side's bubbles (a group conversation)."
        @tier "presentation"
      metaH : number = 16
        @label "Meta line height"
        @description "Height in px of a bubble's sender line and its time-and-ticks line."
        @tier "presentation"
      imageH : number = 180
        @label "Image height"
        @description "Height in px of a record's image inside its bubble."
        @tier "presentation"
      skeleton : boolean = false
        @label "Skeleton while loading"
        @description "Before the live records arrive (and after RASM_CHAT_LOADING), paint pulsing placeholder bubbles in the chat/skeleton/idle look instead of the configured messages."
        @tier "presentation"
      retryLabel : MessageKey = "chat.retry"
        @label "Resend label"
        @description "What assistive technology announces for the alert beside a failed message."
        @tier "domain"
      alertSize : number = 26
        @label "Alert size"
        @description "The diameter in px of the alert beside a failed message, set in the chat/alert/idle look."
        @tier "presentation"
      imageAlt : string = ""
        @label "Image description"
        @description "What assistive technology announces for a record's image; empty marks the image decorative."
        @tier "presentation"
    }
  }

  page boot as RasmChatStart -> RasmChat
}
