app std-rasm-diagram [
  version: "0.1.0",
  description: "std-rasm-diagram — a diagram of boxes and labelled arrows on the Rasm surface, for explaining how something works: a pipeline, a queue, a call and its answer. The composer declares the boxes (`nodes`: a catalog-keyed label, an optional note under it, an optional kind that picks its look) and the arrows (`edges`: source, target, an optional catalog-keyed label). It translates and measures every label on the canvas (RASM_MEASURED), asks a sibling std-graph-layout for the layout (LAYOUT_REQUEST, answered by LAYOUT_READY; the call site picks the layout's direction and routing), then scales the layout to fit its placed rect, centred. `steps` is the order the diagram is read in: a list of steps, each the ids of boxes and arrows that light together; when a RASM_ENTER names one of `playOn` (or the diagram's own id when `playOn` is empty) the steps light one after another `stepMs` apart, a token runs along each arrow as it lights, and everything stays lit. Before that nothing is lit; under reduced motion everything a step names is lit at once with no motion. With rtl the layout mirrors. Looks are diagram/node/<kind>, diagram/node/idle, diagram/node/lit, diagram/note/idle, diagram/edge/idle, diagram/edge/lit, diagram/label/idle, diagram/pill/idle and diagram/token/idle; each role a system leaves out reads the std-rasm-machine look of the same role (machine/state/idle, machine/state/active, machine/event/idle, machine/edge/idle, machine/edge/lit, machine/event/idle, machine/pill/idle, machine/token/idle), so every system that styles machines draws diagrams. It paints no state machine and takes no input."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmKeyframe = { at : number!, opacity : number, offsetX : number, offsetY : number }
type RasmAnimation = { durationMs : number!, startMs : number, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation?, maxWidth : number? }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type DiagramNode = { id : string!, label : MessageKey!, note : MessageKey?, kind : string?, group : string?, at : number?, from : "start" | "end"? }
type DiagramEdge = { id : string!, source : string!, target : string!, label : MessageKey? }
type NotedNode = { id : string!, note : MessageKey! }
type LabelledEdge = { id : string!, label : MessageKey! }
type LayoutPoint = { x : number!, y : number! }
type LayoutNode = { id : string!, label : string!, width : number!, height : number! }
type LayoutEdge = { id : string!, source : string!, target : string!, label : string!, labelWidth : number!, labelHeight : number! }
type LayoutPlacedNode = { id : string!, label : string!, width : number!, height : number!, x : number!, y : number!, rank : number! }
type LayoutRoutedEdge = { id : string!, source : string!, target : string!, label : string!, labelWidth : number!, labelHeight : number!, points : [LayoutPoint]!, labelX : number!, labelY : number!, reversed : boolean! }
type DiagramWidths = Map string number

orbital RasmDiagramOrbital {
  entity RasmDiagramRun [runtime] {
    id : string!
    rect : RasmRect? @description "The rect RASM_PLACE gave the diagram, null until placed." = null
    looks : Map string RasmLook @description "The announced look table." = {}
    direction : "ltr" | "rtl" = "ltr"
    reduced : boolean = false
    widths : DiagramWidths @description "Measured label widths by measure id." = {}
    boxW : DiagramWidths @description "Each box's width in layout units: its widest label plus the padding on both sides." = {}
    nodes : [LayoutPlacedNode] @description "The placed boxes, in layout units." = []
    edges : [LayoutRoutedEdge] @description "The routed arrows, in layout units." = []
    layoutW : number = 0
    layoutH : number = 0
    playMs : number @description "The epoch-ms instant the steps started lighting; 0 before the diagram entered." = 0
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    error : string @description "Why the layout failed." = ""
  }

  trait RasmDiagram -> RasmDiagramRun [client] {
    initial: measuring

    state measuring {
      INIT -> measuring
        (set @entity.widths {})
      DIAGRAM_PAINT -> measuring when (and (!= @entity.rect null) (!= (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null)) null))
        (let ((r @entity.rect)
              (ol (default (object/get @entity.looks "diagram/note/idle" null) (object/get @entity.looks "machine/event/idle" null)))
              (al (default (object/get @entity.looks "diagram/label/idle" null) (object/get @entity.looks "machine/event/idle" null))))
          (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: [],
            texts: (array/concat
              (array/map @config.nodes (fn nd { id: (str/concat @config.id "-m-n-" @nd.id), key: @nd.label, x: @r.x, y: @r.y, z: @config.z, align: "left", baseline: "top", color: "rgba(0,0,0,0)", font: (let ((l (default (object/get @entity.looks (str/concat "diagram/node/" (default @nd.kind "idle")) null) (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null))))) (if (= @l null) "" @l.font)), measure: true }))
              (array/map (array/filter @config.nodes (fn nd (!= @nd.note null))) (fn nd { id: (str/concat @config.id "-m-o-" @nd.id), key: (let ((kn (as @nd NotedNode))) @kn.note), x: @r.x, y: @r.y, z: @config.z, align: "left", baseline: "top", color: "rgba(0,0,0,0)", font: (if (= @ol null) "" @ol.font), measure: true }))
              (array/map (array/filter @config.edges (fn ed (!= @ed.label null))) (fn ed { id: (str/concat @config.id "-m-e-" @ed.id), key: (let ((ke (as @ed LabelledEdge))) @ke.label), x: @r.x, y: @r.y, z: @config.z, align: "left", baseline: "top", color: "rgba(0,0,0,0)", font: (if (= @al null) "" @al.font), measure: true }))) }))
      DIAGRAM_PAINT -> measuring when (not (and (!= @entity.rect null) (!= (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null)) null)))
      RASM_MEASURED -> laying when (and (= @config.form "flow") (let ((wm (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width)))))
          (and (array/every @config.nodes (fn nd (and (object/has @wm (str/concat @config.id "-m-n-" @nd.id)) (or (= @nd.note null) (object/has @wm (str/concat @config.id "-m-o-" @nd.id))))))
               (array/every @config.edges (fn ed (or (= @ed.label null) (object/has @wm (str/concat @config.id "-m-e-" @ed.id))))))))
        (set @entity.widths (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width))))
        (set @entity.boxW (array/reduce @config.nodes @entity.boxW (fn (acc nd) (object/set @acc @nd.id (+ (* 2 @config.nodePad) (math/max (object/get @entity.widths (str/concat @config.id "-m-n-" @nd.id) 0) (if (= @nd.note null) 0 (object/get @entity.widths (str/concat @config.id "-m-o-" @nd.id) 0))))))))
        (emit LAYOUT_REQUEST {
          nodes: (array/map @config.nodes (fn nd { id: @nd.id, label: @nd.id,
            width: (+ (* 2 @config.nodePad) (math/max (default (object/get @entity.widths (str/concat @config.id "-m-n-" @nd.id)) 0) (if (= @nd.note null) 0 (default (object/get @entity.widths (str/concat @config.id "-m-o-" @nd.id)) 0)))),
            height: (if (= @nd.note null) @config.nodeHeight (+ @config.nodeHeight @config.noteHeight)) })),
          edges: (array/map @config.edges (fn ed { id: @ed.id, source: @ed.source, target: @ed.target, label: @ed.id,
            labelWidth: (if (= @ed.label null) 0 (+ (* 2 @config.labelPad) (default (object/get @entity.widths (str/concat @config.id "-m-e-" @ed.id)) 0))),
            labelHeight: (if (= @ed.label null) 0 @config.labelHeight) })) })
      RASM_MEASURED -> showing when (and (!= @config.form "flow") (let ((wm (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width)))))
          (and (array/every @config.nodes (fn nd (and (object/has @wm (str/concat @config.id "-m-n-" @nd.id)) (or (= @nd.note null) (object/has @wm (str/concat @config.id "-m-o-" @nd.id))))))
               (array/every @config.edges (fn ed (or (= @ed.label null) (object/has @wm (str/concat @config.id "-m-e-" @ed.id))))))))
        (set @entity.widths (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width))))
        (set @entity.boxW (array/reduce @config.nodes @entity.boxW (fn (acc nd) (object/set @acc @nd.id (+ (* 2 @config.nodePad) (math/max (object/get @entity.widths (str/concat @config.id "-m-n-" @nd.id) 0) (if (= @nd.note null) 0 (object/get @entity.widths (str/concat @config.id "-m-o-" @nd.id) 0))))))))
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_MEASURED -> measuring when (not (let ((wm (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width)))))
          (and (array/every @config.nodes (fn nd (and (object/has @wm (str/concat @config.id "-m-n-" @nd.id)) (or (= @nd.note null) (object/has @wm (str/concat @config.id "-m-o-" @nd.id))))))
               (array/every @config.edges (fn ed (or (= @ed.label null) (object/has @wm (str/concat @config.id "-m-e-" @ed.id))))))))
        (set @entity.widths (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width))))
      RASM_THEME -> measuring
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_PLACE -> measuring when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_PLACE -> measuring when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_DIRECTION -> measuring
        (set @entity.direction ?direction)
      RASM_MOTION -> measuring
        (set @entity.reduced ?reduced)
      RASM_ENTER -> measuring when (and (= @entity.playMs 0) (array/some ?order (fn o (array/includes (if (= (array/len @config.playOn) 0) [@config.id] @config.playOn) @o))))
        (set @entity.playMs (time/epoch-ms @now))
      RASM_ENTER -> measuring when (not (and (= @entity.playMs 0) (array/some ?order (fn o (array/includes (if (= (array/len @config.playOn) 0) [@config.id] @config.playOn) @o)))))
    }

    state laying {
      INIT -> measuring
        (set @entity.widths {})
      LAYOUT_READY -> showing
        (set @entity.nodes ?nodes)
        (set @entity.edges ?edges)
        (set @entity.layoutW ?width)
        (set @entity.layoutH ?height)
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      LAYOUT_REJECTED -> laying
        (set @entity.error ?reason)
      RASM_THEME -> measuring
        (set @entity.looks ?looks)
        (set @entity.widths {})
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_PLACE -> laying when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
      RASM_PLACE -> laying when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_DIRECTION -> laying
        (set @entity.direction ?direction)
      RASM_MOTION -> laying
        (set @entity.reduced ?reduced)
      RASM_MEASURED -> laying
      RASM_ENTER -> laying when (and (= @entity.playMs 0) (array/some ?order (fn o (array/includes (if (= (array/len @config.playOn) 0) [@config.id] @config.playOn) @o))))
        (set @entity.playMs (time/epoch-ms @now))
      RASM_ENTER -> laying when (not (and (= @entity.playMs 0) (array/some ?order (fn o (array/includes (if (= (array/len @config.playOn) 0) [@config.id] @config.playOn) @o)))))
    }

    state showing {
      INIT -> measuring
        (set @entity.widths {})
      RASM_THEME -> measuring
        (set @entity.looks ?looks)
        (set @entity.widths {})
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_PLACE -> showing when (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (or (= @entity.rect null) (!= @mine.rect.x @entity.rect.x) (!= @mine.rect.y @entity.rect.y) (!= @mine.rect.w @entity.rect.w) (!= @mine.rect.h @entity.rect.h))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_PLACE -> showing when (not (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (or (= @entity.rect null) (!= @mine.rect.x @entity.rect.x) (!= @mine.rect.y @entity.rect.y) (!= @mine.rect.w @entity.rect.w) (!= @mine.rect.h @entity.rect.h)))))
      RASM_DIRECTION -> showing
        (set @entity.direction ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_MOTION -> showing
        (set @entity.reduced ?reduced)
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_MEASURED -> showing
      RASM_ENTER -> showing when (and (= @entity.playMs 0) (array/some ?order (fn o (array/includes (if (= (array/len @config.playOn) 0) [@config.id] @config.playOn) @o))))
        (set @entity.playMs (time/epoch-ms @now))
        (set @entity.paints (+ @entity.paints 1))
        (emit DIAGRAM_PAINT { n: @entity.paints })
      RASM_ENTER -> showing when (not (and (= @entity.playMs 0) (array/some ?order (fn o (array/includes (if (= (array/len @config.playOn) 0) [@config.id] @config.playOn) @o)))))
      DIAGRAM_PAINT -> showing when (= @entity.rect null)
      DIAGRAM_PAINT -> showing when (and (!= @entity.rect null) (= @config.form "flow"))
        (let ((r @entity.rect) (lw (math/max 1 @entity.layoutW)) (lh (math/max 1 @entity.layoutH)))
          (let ((s (if (> @r.h 0) (math/min @config.maxScale (/ @r.w @lw) (/ @r.h @lh)) (math/min @config.maxScale (/ @r.w @lw)))))
            (let ((ox (+ @r.x (/ (- @r.w (* @lw @s)) 2)))
                  (oy (+ @r.y (if (> @r.h 0) (/ (- @r.h (* @lh @s)) 2) 0)))
                  (rtl (= @entity.direction "rtl"))
                  (dur (* @config.stepMs (+ (array/len @config.steps) 1)))
                  (lit (and (> @entity.playMs 0) (not @entity.reduced)))
                  (done (and (> @entity.playMs 0) @entity.reduced))
                  (nlit (default (object/get @entity.looks "diagram/node/lit" null) (object/get @entity.looks "machine/state/active" null)))
                  (ol (default (object/get @entity.looks "diagram/note/idle" null) (object/get @entity.looks "machine/event/idle" null)))
                  (el (default (object/get @entity.looks "diagram/edge/idle" null) (object/get @entity.looks "machine/edge/idle" null)))
                  (elit (default (object/get @entity.looks "diagram/edge/lit" null) (object/get @entity.looks "machine/edge/lit" null)))
                  (al (default (object/get @entity.looks "diagram/label/idle" null) (object/get @entity.looks "machine/event/idle" null)))
                  (pl (default (object/get @entity.looks "diagram/pill/idle" null) (object/get @entity.looks "machine/pill/idle" null)))
                  (tl (default (object/get @entity.looks "diagram/token/idle" null) (object/get @entity.looks "machine/token/idle" null))))
            (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z,
              texts: (array/concat
                (array/flatten (array/map (array/filter @entity.edges (fn e (and (> @e.labelWidth 0) (!= @al null) (array/some @config.edges (fn c (and (= @c.id @e.id) (!= @c.label null))))))) (fn e
                  (let ((ke (as (array/find @config.edges (fn c (= @c.id @e.id))) LabelledEdge))
                        (lx (if @rtl (- @lw (+ @e.labelX @e.labelWidth)) @e.labelX)))
                    [{ id: (str/concat @config.id "-l-" @e.id), key: @ke.label, x: (+ @ox (* @s (+ @lx (/ @e.labelWidth 2)))), y: (+ @oy (* @s (+ @e.labelY (/ @e.labelHeight 2)))), z: (+ @config.z 3), align: "center", baseline: "middle", color: @al.textColor, font: @al.font, maxWidth: (math/max 1 (* @s (- @e.labelWidth @config.labelPad))) }]))))
                (array/flatten (array/map (array/filter @entity.nodes (fn n (array/some @config.nodes (fn c (= @c.id @n.id))))) (fn n
                  (let ((cfg (array/find @config.nodes (fn c (= @c.id @n.id)))))
                    (let ((look (default (object/get @entity.looks (str/concat "diagram/node/" (default @cfg.kind "idle")) null) (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null))))
                          (k (array/findIndex @config.steps (fn st (array/includes @st @n.id))))
                          (nx (if @rtl (- @lw (+ @n.x @n.width)) @n.x))
                          (hasNote (!= @cfg.note null)))
                      (let ((tx (+ @ox (* @s (+ @nx (/ @n.width 2)))))
                            (ty (+ @oy (* @s (if @hasNote (+ @n.y (/ @config.nodeHeight 2) 2) (+ @n.y (/ @n.height 2))))))
                            (mw (math/max 1 (* @s (- @n.width @config.nodePad)))))
                        (array/concat
                          [{ id: (str/concat @config.id "-nt-" @n.id), key: @cfg.label, x: @tx, y: @ty, z: (+ @config.z 3), align: "center", baseline: "middle", color: @look.textColor, font: @look.font, maxWidth: @mw }]
                          (if (or (< @k 0) (= @nlit null) (not (or @lit @done))) []
                            [{ id: (str/concat @config.id "-nlt-" @n.id), key: @cfg.label, x: @tx, y: @ty, z: (+ @config.z 4), align: "center", baseline: "middle", color: @nlit.textColor, font: @look.font, maxWidth: @mw, animation: (if @lit { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: (math/max 0 (/ (* @k @config.stepMs) @dur)), opacity: 0 }, { at: (math/max 0 (/ (+ (* @k @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 1 }, { at: 1, opacity: 1 }] } null) }])
                          (if (or (not @hasNote) (= @ol null)) []
                            [{ id: (str/concat @config.id "-no-" @n.id), key: (let ((kn (as @cfg NotedNode))) @kn.note), x: @tx, y: (+ @oy (* @s (+ @n.y @config.nodeHeight 2))), z: (+ @config.z 4), align: "center", baseline: "middle", color: @ol.textColor, font: @ol.font, maxWidth: @mw }]))))))))),
              nodes: [{ type: draw-group, id: (str/concat @config.id "-g"), position: { x: @ox, y: @oy, z: @config.z }, scale: @s, items: (array/concat
                (array/flatten (array/map @entity.edges (fn e
                  (let ((pts (array/map @e.points (fn p { x: (if @rtl (- @lw @p.x) @p.x), y: @p.y })))
                        (k (array/findIndex @config.steps (fn st (array/includes @st @e.id)))))
                    (let ((d (str/concat "M" (str/join (array/map @pts (fn p (str/concat @p.x " " @p.y))) " L")))
                          (last (array/nth @pts (- (array/len @pts) 1)))
                          (prev (array/nth @pts (- (array/len @pts) 2)))
                          (p0 (array/nth @pts 0)))
                      (let ((len (math/max 0.001 (math/sqrt (+ (* (- @last.x @prev.x) (- @last.x @prev.x)) (* (- @last.y @prev.y) (- @last.y @prev.y)))))))
                        (let ((ux (/ (- @last.x @prev.x) @len)) (uy (/ (- @last.y @prev.y) @len)))
                          (let ((head (str/concat "M" @last.x " " @last.y " L" (- (- @last.x (* 9 @ux)) (* 4.5 @uy)) " " (+ (- @last.y (* 9 @uy)) (* 4.5 @ux)) " L" (+ (- @last.x (* 9 @ux)) (* 4.5 @uy)) " " (- (- @last.y (* 9 @uy)) (* 4.5 @ux)) " Z")))
                            (array/concat
                              [{ type: draw-shape, id: (str/concat @config.id "-e-" @e.id), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: @d, fill: "", stroke: @el.stroke, strokeWidth: @el.strokeWidth, opacity: 1, hit: false },
                               { type: draw-shape, id: (str/concat @config.id "-h-" @e.id), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: @head, fill: @el.stroke, opacity: 1, hit: false }]
                              (if (or (< @k 0) (= @elit null) (not (or @lit @done))) []
                                [{ type: draw-shape, id: (str/concat @config.id "-el-" @e.id), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: (+ @config.z 1) }, d: @d, fill: "", stroke: @elit.stroke, strokeWidth: @elit.strokeWidth, opacity: (if (and @done (>= @k 0)) 1 0), hit: false, animation: (if @lit { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: (math/max 0 (/ (* @k @config.stepMs) @dur)), opacity: 0 }, { at: (math/max 0 (/ (+ (* @k @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 1 }, { at: 1, opacity: 1 }] } null) },
