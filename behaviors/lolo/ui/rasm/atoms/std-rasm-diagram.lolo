                                      (let ((lk (default (object/get @entity.looks (str/concat "diagram/node/" (default @c.kind "idle")) null) (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null)))) (tx (+ @ox (* @s (+ @bx (/ @w 2))))) (ty (+ @oy (* @s (if (= @c.note null) (+ @by (/ @bh 2)) (+ @by (/ @nh 2) 2))))) (mw (math/max 1 (* @s (- @w @pad))))) (array/concat [{ id: (str/concat @config.id "-nt-" @c.id), key: @c.label, x: @tx, y: @ty, z: (+ @config.z 3), align: "center", baseline: "middle", color: @lk.textColor, font: @lk.font, maxWidth: @mw }] (if (or (< @k 0) (= @nlit null) (not (or @lit @done))) [] [{ id: (str/concat @config.id "-nlt-" @c.id), key: @c.label, x: @tx, y: @ty, z: (+ @config.z 4), align: "center", baseline: "middle", color: @nlit.textColor, font: @lk.font, maxWidth: @mw, animation: (if @lit { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: (math/max 0 (/ (* @k @config.stepMs) @dur)), opacity: 0 }, { at: (math/max 0 (/ (+ (* @k @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 1 }, { at: 1, opacity: 1 }] } null) }]) (if (or (= @c.note null) (= @ol null)) [] [{ id: (str/concat @config.id "-no-" @c.id), key: (let ((kn (as @c NotedNode))) @kn.note), x: @tx, y: (+ @oy (* @s (+ @by @nh 2))), z: (+ @config.z 4), align: "center", baseline: "middle", color: @ol.textColor, font: @ol.font, maxWidth: @mw }])))))))))
                              (array/flatten (array/map (array/range 0 (array/len @cards)) (fn i
                                (let ((c (array/nth @cards @i)))
                                  (let ((w @cmw) (bh @cmh) (k (if (= @i 0) -1 @kAfter)) (bx (- @ccx (/ @cmw 2))) (by @pad))
                                    (if (or (and (= @i 1) (not (or @lit @done))) (and (= @i 0) @done (>= @kAfter 0))) []
                                      (let ((lk (default (object/get @entity.looks (str/concat "diagram/node/" (default @c.kind "idle")) null) (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null)))) (mw (math/max 1 (* @s (- @cmw @pad)))))
                                        [{ id: (str/concat @config.id "-ct-" @c.id), key: @c.label, x: (+ @ox (* @s @ccx)), y: (+ @oy (* @s (+ @pad (/ @cmh 2)))), z: (+ @config.z 4), align: "center", baseline: "middle", color: @lk.textColor, font: @lk.font, maxWidth: @mw,
                                          animation: (if (and (= @i 0) @lit (>= @kAfter 0)) { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 1 }, { at: (math/max 0 (/ (* @kAfter @config.stepMs) @dur)), opacity: 1 }, { at: (math/max 0 (/ (+ (* @kAfter @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 0 }, { at: 1, opacity: 0 }] } (if (and (= @i 1) @lit) (if @lit { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: (math/max 0 (/ (* @kAfter @config.stepMs) @dur)), opacity: 0 }, { at: (math/max 0 (/ (+ (* @kAfter @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 1 }, { at: 1, opacity: 1 }] } null) null)) }])))))))),
                            nodes: [{ type: draw-group, id: (str/concat @config.id "-g"), position: { x: @ox, y: @oy, z: @config.z }, scale: @s, items: (array/concat
                              [{ type: draw-shape, id: (str/concat @config.id "-ruler"), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: (str/concat "M" @pad " " @ry " L" (- @lw @pad) " " @ry), fill: "", stroke: @el.stroke, strokeWidth: @el.strokeWidth, opacity: 1, hit: false },
                               { type: draw-shape, id: (str/concat @config.id "-link"), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: (str/concat "M" @ccx " " (+ @pad @cmh) " L" @ccx " " (- @ry 8)), fill: "", stroke: @el.stroke, strokeWidth: 1.5, strokeDash: [4, 4], opacity: 1, hit: false }]
                              (array/flatten (array/map (array/range 0 @nb) (fn i
                                (let ((c (array/nth @beats @i)))
                                  (let ((w (object/get @entity.boxW @c.id 0)) (bh (if (= @c.note null) @nh (+ @nh @oh))) (k (array/findIndex @config.steps (fn st (array/includes @st @c.id)))) (tx (let ((x (+ @pad (* @gap (+ @i 0.5))))) (if @rtl (- @lw @x) @x))))
                                    (let ((bx (- @tx (/ @w 2))) (by (+ @ry 18)))
                                      (array/concat
                                        [{ type: draw-shape, id: (str/concat @config.id "-tick-" @c.id), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: (str/concat "M" @tx " " (- @ry 8) " L" @tx " " (+ @ry 8)), fill: "", stroke: @el.stroke, strokeWidth: @el.strokeWidth, opacity: 1, hit: false }]
                                        (let ((lk (default (object/get @entity.looks (str/concat "diagram/node/" (default @c.kind "idle")) null) (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null))))) (array/concat [{ type: draw-shape, id: (str/concat @config.id "-n-" @c.id), shape: "rect", anchor: "top-left", position: { x: @bx, y: @by, z: (+ @config.z 1) }, width: @w, height: @bh, fill: @lk.fill, stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, corners: @lk.corners, shadow: @lk.shadow, opacity: 1, hit: false }] (if (or (< @k 0) (= @nlit null) (not (or @lit @done))) [] [{ type: draw-shape, id: (str/concat @config.id "-nl-" @c.id), shape: "rect", anchor: "top-left", position: { x: @bx, y: @by, z: (+ @config.z 2) }, width: @w, height: @bh, fill: @nlit.fill, stroke: @nlit.stroke, strokeWidth: @nlit.strokeWidth, corners: @nlit.corners, opacity: (if (and @done (>= @k 0)) 1 0), hit: false, animation: (if @lit { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: (math/max 0 (/ (* @k @config.stepMs) @dur)), opacity: 0 }, { at: (math/max 0 (/ (+ (* @k @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 1 }, { at: 1, opacity: 1 }] } null) }]))))))))))
                              (array/flatten (array/map (array/range 0 (array/len @cards)) (fn i
                                (let ((c (array/nth @cards @i)))
                                  (let ((lk (default (object/get @entity.looks (str/concat "diagram/node/" (default @c.kind "idle")) null) (default (object/get @entity.looks "diagram/node/idle" null) (object/get @entity.looks "machine/state/idle" null)))) (bx (- @ccx (/ @cmw 2))))
                                    (if (and (= @i 1) (not (or @lit @done))) []
                                      [{ type: draw-shape, id: (str/concat @config.id "-card-" @c.id), shape: "rect", anchor: "top-left", position: { x: @bx, y: @pad, z: (+ @config.z 1) }, width: @cmw, height: @cmh, fill: (if (= @i 1) (if (= @nlit null) @lk.fill @nlit.fill) @lk.fill), stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, corners: @lk.corners, shadow: @lk.shadow, opacity: (if (and @done (= @i 0) (>= @kAfter 0)) 0 1), hit: false,
                                        animation: (if (and (= @i 0) @lit (>= @kAfter 0)) { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 1 }, { at: (math/max 0 (/ (* @kAfter @config.stepMs) @dur)), opacity: 1 }, { at: (math/max 0 (/ (+ (* @kAfter @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 0 }, { at: 1, opacity: 0 }] } (if (and (= @i 1) @lit) (if @lit { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: (math/max 0 (/ (* @kAfter @config.stepMs) @dur)), opacity: 0 }, { at: (math/max 0 (/ (+ (* @kAfter @config.stepMs) (* 0.35 @config.stepMs)) @dur)), opacity: 1 }, { at: 1, opacity: 1 }] } null) null)) }]))))))
                              (if (or (not @lit) (= @tl null) (= @nb 0)) []
                                (let ((x0 (let ((x (+ @pad (* @gap 0.5)))) (if @rtl (- @lw @x) @x))))
                                  [{ type: draw-shape, id: (str/concat @config.id "-head"), shape: "rect", anchor: "top-left", position: { x: (- @x0 3), y: (- @ry 18), z: (+ @config.z 3) }, width: 6, height: 36, fill: @tl.fill, stroke: @tl.stroke, strokeWidth: @tl.strokeWidth, corners: { radius: [3, 3, 3, 3], kind: "round" }, opacity: 1, hit: false,
                                    animation: { durationMs: @dur, startMs: @entity.playMs, loop: false, keyframes: (array/concat [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0 }]
                                      (array/flatten (array/map (array/range 0 @nb) (fn i (let ((c (array/nth @beats @i))) (let ((k (array/findIndex @config.steps (fn st (array/includes @st @c.id)))) (x (let ((xx (+ @pad (* @gap (+ @i 0.5))))) (if @rtl (- @lw @xx) @xx))))
                                        (if (< @k 0) [] [{ at: (math/max 0 (/ (* @k @config.stepMs) @dur)), opacity: 1, offsetX: (- @x @x0), offsetY: 0 }, { at: (math/max 0 (/ (+ (* @k @config.stepMs) (* 0.4 @config.stepMs)) @dur)), opacity: 1, offsetX: (- @x @x0), offsetY: 0 }]))))))
                                      [{ at: 1, opacity: 1, offsetX: (- (let ((xx (+ @pad (* @gap (- @nb 0.5))))) (if @rtl (- @lw @xx) @xx)) @x0), offsetY: 0 }]) } }]))) }] }))))))))))
    }

    emits {
      DIAGRAM_PAINT -> internal {
        n : number!
      }
        @description "Paint what the current state shows."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        texts : [RasmText]!
        nodes : [node]!
      }
        @description "The diagram's boxes, arrows and labels as one scaled draw group (or its hidden measuring labels)."
        @tier "primary"
      LAYOUT_REQUEST -> external {
        nodes : [LayoutNode]!
        edges : [LayoutEdge]!
      }
        @description "Ask the sibling std-graph-layout to lay the measured boxes and arrows out."
        @tier "domain"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Keep the looks; fonts may have changed, so labels are measured and laid out again."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the rect of this diagram's id; an unchanged rect or another id is ignored."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction; rtl mirrors the layout."
      RASM_MOTION { reduced : boolean! }
        @description "Reduced motion: once entered, every step is lit at once with no motion."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Measured labels: once every label of this diagram is measured, ask for the layout."
      LAYOUT_READY { nodes : [LayoutPlacedNode]!  edges : [LayoutRoutedEdge]!  width : number!  height : number! }
        @description "The layout: keep it and paint."
      LAYOUT_REJECTED { reason : string!  ids : [string]! }
        @description "The layout refused the request: keep the reason; nothing is painted."
      RASM_ENTER { order : [string]! }
        @description "Ids that just entered the view: when one of them is in `playOn` (or is this diagram's id), the steps start lighting, once."
    }

    config {
      id : string = "diagram"
        @label "Id"
        @description "The placed id this diagram paints in."
        @tier "presentation"
      z : number = 3
        @label "Z"
        @description "The paint order of the diagram on the surface."
        @tier "presentation"
      nodes : [DiagramNode] = []
        @label "Boxes"
        @description "The boxes: an id, a catalog-keyed label, an optional catalog-keyed note shown under the label, and an optional kind whose look diagram/node/<kind> styles the box."
        @tier "domain"
      edges : [DiagramEdge] = []
        @label "Arrows"
        @description "The arrows between box ids, each with an optional catalog-keyed label."
        @tier "domain"
      form : "flow" | "rings" | "beats" | "queue" | "nest" | "plugs" | "lanes" | "conveyor" = "flow"
        @label "Form"
        @description "How the diagram is drawn. flow: boxes and arrows laid out by std-graph-layout. rings: an exploded orbital, the box in group core at the centre, each box in group ring an ellipse around it (inner first), the boxes in group around in a row under it joined to the outer ring. beats: the boxes in group beat on a ruler with a playhead that sweeps to each as its step lights, and the first box in group card above the beat its `at` names, replaced by the second card at that card's step. queue: the boxes in group ticket in the slots their `at` names, front first, each sliding in from its `from` end at its step and, at the step `leaves` names it in, carried down to the box in group desk; the boxes in group end caption the front and the back; a box in group done appears under the row. nest: the boxes in group frame, outer first, drawn one inside the next, with each box's note as a value chip under it that appears at its step. plugs: the box in group plug, the box in group socket and the box in group stamp, with a mismatched tab and slot and the stamp laid over the gap at its step. lanes: the boxes in group lane as lifelines across, and the arrows as messages down the page in order. conveyor: the boxes in group station along a belt, with a sheet that rides to each station as its step lights."
        @tier "presentation"
      leaves : [[string]] = []
        @label "Leaves"
        @description "For the queue form: by step index, the ticket ids that leave the line at that step."
        @tier "domain"
      steps : [[string]] = []
        @label "Steps"
        @description "The reading order: each step lists the box and arrow ids that light together. An id in no step is never lit."
        @tier "domain"
      playOn : [string] = []
        @label "Play on"
        @description "The ids whose RASM_ENTER starts the steps; empty means this diagram's own id."
        @tier "presentation"
      stepMs : number = 700
        @label "Step time"
        @description "Milliseconds between one step lighting and the next."
        @tier "presentation"
      maxScale : number = 1.4
        @label "Largest scale"
        @description "The diagram is scaled to fit its rect, never above this."
        @tier "presentation"
      nodeHeight : number = 48
        @label "Box height"
        @description "A box's height in layout units, without a note."
        @tier "presentation"
      noteHeight : number = 22
        @label "Note height"
        @description "The extra height in layout units a box with a note gets."
        @tier "presentation"
      nodePad : number = 20
        @label "Box padding"
        @description "Space in layout units on each side of a box's widest label."
        @tier "presentation"
      labelPad : number = 8
        @label "Arrow label padding"
        @description "Space in layout units on each side of an arrow's label."
        @tier "presentation"
      labelHeight : number = 24
        @label "Arrow label height"
        @description "An arrow label's height in layout units."
        @tier "presentation"
    }
  }

  page boot as RasmDiagramStart -> RasmDiagram
}
