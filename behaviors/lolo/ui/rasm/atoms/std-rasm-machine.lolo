app std-rasm-machine [
  version: "0.1.0",
  description: "std-rasm-machine — paints a described trait's state machine on the Rasm surface the way a reader follows it: states in ranks from the initial one, one wire per pair of states carrying a label of that pair's events, each with a guard mark when one of its arms is guarded and one glyph per effect in order. It describes its subject (behavior/describe) and leaves out the transitions of the events its `omit` knob names, measures the state and event names on the canvas (RASM_MEASURED), asks a sibling std-graph-layout for the layout (LAYOUT_REQUEST, answered by LAYOUT_READY; the call site composes the layout with routing direct), then scales the layout to its placed rect and reports its height (RASM_EXTENT). MACHINE_AT { state, event } says the subject moved: the current state takes the now badge, visited states keep their order number, and the move plays five beats along the wire it took (a token leaves the source, crosses the guard, the wire draws behind it, the effect glyphs strike in order, the target blooms). MACHINE_REFUSED { event } says a guarded event was refused at the current state: the token stops at the guard, which shakes, and nothing moves. An event of a wire leaving the current state is a button that emits MACHINE_PICK { event, from, to }, except INIT, which only the kernel sends. Looks are keyed machine/<part>/<state>; an effect glyph is the operator's own glyph from the std operator table (behavior/describe answers it as machine.glyphs), colored by the look machine/effect/other, whose decor is the mark of an operator with no glyph. With rtl the layout mirrors. Reduced motion keeps the final frame with an opacity crossfade only."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmKeyframe = { at : number!, opacity : number }
type RasmAnimation = { durationMs : number!, startMs : number, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation? }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type DescribedState = { name : string!, isInitial : boolean }
type DescribedTransition = { from : string!, to : string!, event : string!, guard : SExpr?, effects : [SExpr] }
type DescribedStateMachine = { states : [DescribedState]!, transitions : [DescribedTransition]! }
type MachineGlyphs = Map string string
type DescribedMachine = { stateMachine : DescribedStateMachine!, glyphs : MachineGlyphs }
type TransitionLines = { index : number!, start : number!, end : number! }
type DescribedSource = { text : string!, transitions : [TransitionLines]! }
type DescribedSubject = { machine : DescribedMachine!, source : DescribedSource }
type MachineSeg = { event : string!, guarded : boolean!, heads : [string]!, notes : [string]! }
type MachineGroup = { id : string!, from : string!, to : string!, segs : [MachineSeg]! }
type LayoutPoint = { x : number!, y : number! }
type LayoutNode = { id : string!, label : string!, width : number!, height : number! }
type LayoutEdge = { id : string!, source : string!, target : string!, label : string!, labelWidth : number!, labelHeight : number! }
type LayoutPlacedNode = { id : string!, label : string!, width : number!, height : number!, x : number!, y : number!, rank : number! }
type LayoutRoutedEdge = { id : string!, source : string!, target : string!, label : string!, labelWidth : number!, labelHeight : number!, points : [LayoutPoint]!, labelX : number!, labelY : number!, reversed : boolean! }
type MachineWidths = Map string number

orbital RasmMachineOrbital {
  entity RasmMachineRun [runtime] {
    id : string!
    rect : RasmRect? @description "The rect RASM_PLACE gave the machine, null until placed." = null
    looks : Map string RasmLook @description "The announced look table." = {}
    direction : "ltr" | "rtl" = "ltr"
    reduced : boolean = false
    states : [DescribedState] @description "The described states, in the order behavior/describe lists them." = []
    groups : [MachineGroup] @description "One group per ordered pair of states that has a transition, in first-appearance order, with that pair's events." = []
    widths : MachineWidths @description "Measured text widths by measure id." = {}
    glyphs : MachineGlyphs @description "The std glyph of each effect operator the subject runs, as behavior/describe answers it." = {}
    nodes : [LayoutPlacedNode] @description "The placed states, in layout units." = []
    edges : [LayoutRoutedEdge] @description "The routed groups, in layout units; an edge id is its group id." = []
    layoutW : number = 0
    layoutH : number = 0
    extentH : number @description "The height last reported with RASM_EXTENT, -1 before any." = -1
    active : string @description "The current state." = ""
    from : string @description "The state the last move left." = ""
    fired : string @description "The event of the last move." = ""
    firedMs : number @description "The epoch-ms instant of the last move, the start of its beats; 0 before any." = 0
    refused : string @description "The event of the last refusal." = ""
    refusedMs : number @description "The epoch-ms instant of the last refusal; 0 before any." = 0
    visited : [string] @description "States passed through, in order." = []
    hovered : string @description "The id of the event button under the pointer." = ""
    error : string @description "Why describing or laying out failed." = ""
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    trans : [DescribedTransition] @description "Every described transition, in describe order: the index the source ranges name." = []
    srcLines : [string] @description "The subject's .lolo source, one entry per line." = []
    srcRanges : [TransitionLines] @description "Where each transition sits in the source, by its index in trans." = []
    maxLines : number @description "The most lines any one shown transition takes, for the strip's reserved height." = 0
    firedLines : [string] @description "The .lolo lines of the transition the last move ran, its common indent cut." = []
  }

  trait RasmMachine -> RasmMachineRun [client] {
    initial: describing

    state describing {
      INIT -> describing
        (behavior/describe @config.subject { emit: { success: MACHINE_DESCRIBED, failure: MACHINE_DESCRIBE_FAILED } })
      RASM_BOOT -> describing
        (behavior/describe @config.subject { emit: { success: MACHINE_DESCRIBED, failure: MACHINE_DESCRIBE_FAILED } })
      MACHINE_DESCRIBED -> measuring
        (let ((ts (array/filter ?result.machine.stateMachine.transitions (fn t (not (array/includes @config.omit @t.event))))))
          (let ((keys (array/unique (array/map @ts (fn t (str/concat @t.from " " @t.to))))))
            (set @entity.groups (array/map (array/range 0 (array/len @keys)) (fn i
              (let ((k (array/nth @keys @i)))
                (let ((mine (array/filter @ts (fn t (= (str/concat @t.from " " @t.to) @k)))))
                  (let ((none : DescribedTransition { from: "", to: "", event: "", guard: null, effects: [] }))
                  (let ((first (default (array/nth @mine 0) @none)))
                    { id: (str/concat "g" @i), from: @first.from, to: @first.to,
                      segs: (array/map (array/unique (array/map @mine (fn t @t.event))) (fn ev
                        (let ((arms (array/filter @mine (fn t (= @t.event @ev)))))
                          (let ((arm (default (array/nth @arms 0) @none)))
                            { event: @ev, guarded: (array/some @arms (fn a (!= @a.guard null))),
                              heads: (array/map (default @arm.effects []) (fn fx (default (as (array/nth (json/nodes @fx) 1) string) ""))),
                              notes: (array/map (default @arm.effects []) (fn fx (str/trim (str/concat (default (as (array/nth (json/nodes @fx) 1) string) "") " " (default (as (array/nth (json/nodes @fx) 2) string) ""))))) })))) })))))))))
        (set @entity.states ?result.machine.stateMachine.states)
        (set @entity.trans ?result.machine.stateMachine.transitions)
        (set @entity.srcLines (if (= ?result.source null) [] (str/split ?result.source.text "\n")))
        (set @entity.srcRanges (if (= ?result.source null) [] ?result.source.transitions))
        (set @entity.maxLines (if (= ?result.source null) 0 (array/reduce (array/filter ?result.source.transitions (fn rg (let ((t (array/nth ?result.machine.stateMachine.transitions @rg.index))) (and (!= @t null) (not (array/includes @config.omit @t.event)))))) 0 (fn acc rg (math/max @acc (+ 1 (- @rg.end @rg.start)))))))
        (set @entity.firedLines [])
        (set @entity.glyphs (default ?result.machine.glyphs {}))
        (set @entity.active (let ((ini (array/find ?result.machine.stateMachine.states (fn s (= @s.isInitial true))))) (if (= @ini null) "" @ini.name)))
        (set @entity.visited (let ((ini (array/find ?result.machine.stateMachine.states (fn s (= @s.isInitial true))))) (if (= @ini null) [] [@ini.name])))
        (set @entity.widths {})
        (set @entity.error "")
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      MACHINE_DESCRIBE_FAILED -> describing
        (set @entity.error ?error)
      RASM_THEME -> describing
        (set @entity.looks ?looks)
      RASM_PLACE -> describing when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
      RASM_PLACE -> describing when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_DIRECTION -> describing
        (set @entity.direction ?direction)
      RASM_MOTION -> describing
        (set @entity.reduced ?reduced)
    }

    state measuring {
      INIT -> describing
        (set @entity.widths {})
        (behavior/describe @config.subject { emit: { success: MACHINE_DESCRIBED, failure: MACHINE_DESCRIBE_FAILED } })
      MACHINE_PAINT -> measuring when (and (!= @entity.rect null) (!= (object/get @entity.looks "machine/state/idle" null) null) (!= (object/get @entity.looks "machine/event/idle" null) null))
        (let ((r @entity.rect) (sl (object/get @entity.looks "machine/state/idle" null)) (el (object/get @entity.looks "machine/event/idle" null)))
          (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: [],
            nodes: (array/concat
              (array/map @entity.states (fn s { type: draw-text, id: (str/concat @config.id "-m-s-" @s.name), text: @s.name, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, align: "left", baseline: "top", color: "rgba(0,0,0,0)", font: @sl.font, measure: true, hit: false }))
              (array/map (array/unique (array/flatten (array/map @entity.groups (fn g (array/map @g.segs (fn sg @sg.event)))))) (fn ev { type: draw-text, id: (str/concat @config.id "-m-e-" @ev), text: @ev, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, align: "left", baseline: "top", color: "rgba(0,0,0,0)", font: @el.font, measure: true, hit: false }))) }))
      MACHINE_PAINT -> measuring when (not (and (!= @entity.rect null) (!= (object/get @entity.looks "machine/state/idle" null) null) (!= (object/get @entity.looks "machine/event/idle" null) null)))
      RASM_MEASURED -> laying when (let ((wm (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width)))))
          (and (array/every @entity.states (fn s (object/has @wm (str/concat @config.id "-m-s-" @s.name))))
               (array/every @entity.groups (fn g (array/every @g.segs (fn sg (object/has @wm (str/concat @config.id "-m-e-" @sg.event))))))))
        (set @entity.widths (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width))))
        (emit LAYOUT_REQUEST {
          nodes: (array/map @entity.states (fn s { id: @s.name, label: @s.name, width: (+ (* 2 @config.statePad) (default (object/get @entity.widths (str/concat @config.id "-m-s-" @s.name)) 0) (if (= (object/get @config.stateIcons @s.name null) null) 0 (+ @config.stateIconSize 8))), height: @config.stateHeight })),
          edges: (array/map @entity.groups (fn g { id: @g.id, source: @g.from, target: @g.to, label: @g.id,
            labelWidth: (+ (* 2 @config.pillPad) (* (- (array/len @g.segs) 1) @config.segGap)
              (array/reduce @g.segs 0 (fn (sum sg) (+ @sum (if @sg.guarded (+ (* 2 @config.guardRadius) @config.chipGap) 0) (default (object/get @entity.widths (str/concat @config.id "-m-e-" @sg.event)) 0) (if (= (array/len @sg.heads) 0) 0 (+ @config.chipGap (* (array/len @sg.heads) (+ (* 2 @config.chipRadius) @config.chipGap)))))))),
            labelHeight: @config.pillHeight })) })
      RASM_MEASURED -> measuring when (not (let ((wm (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width)))))
          (and (array/every @entity.states (fn s (object/has @wm (str/concat @config.id "-m-s-" @s.name))))
               (array/every @entity.groups (fn g (array/every @g.segs (fn sg (object/has @wm (str/concat @config.id "-m-e-" @sg.event)))))))))
        (set @entity.widths (array/reduce (array/filter ?items (fn it (str/startsWith @it.id (str/concat @config.id "-m-")))) @entity.widths (fn (acc it) (object/set @acc @it.id @it.width))))
      RASM_THEME -> measuring
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_PLACE -> measuring when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_PLACE -> measuring when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_DIRECTION -> measuring
        (set @entity.direction ?direction)
      RASM_MOTION -> measuring
        (set @entity.reduced ?reduced)
    }

    state laying {
      INIT -> describing
        (set @entity.widths {})
        (behavior/describe @config.subject { emit: { success: MACHINE_DESCRIBED, failure: MACHINE_DESCRIBE_FAILED } })
      LAYOUT_READY -> showing
        (set @entity.nodes ?nodes)
        (set @entity.edges ?edges)
        (set @entity.layoutW ?width)
        (set @entity.layoutH ?height)
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      LAYOUT_REJECTED -> laying
        (set @entity.error ?reason)
      RASM_THEME -> measuring
        (set @entity.looks ?looks)
        (set @entity.widths {})
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_PLACE -> laying when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
      RASM_PLACE -> laying when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_DIRECTION -> laying
        (set @entity.direction ?direction)
      RASM_MOTION -> laying
        (set @entity.reduced ?reduced)
      RASM_MEASURED -> laying
    }

    state showing {
      INIT -> describing
        (set @entity.widths {})
        (behavior/describe @config.subject { emit: { success: MACHINE_DESCRIBED, failure: MACHINE_DESCRIBE_FAILED } })
      RASM_THEME -> measuring
        (set @entity.looks ?looks)
        (set @entity.widths {})
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_PLACE -> showing when (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (or (= @entity.rect null) (!= @mine.rect.x @entity.rect.x) (!= @mine.rect.y @entity.rect.y) (!= @mine.rect.w @entity.rect.w) (!= @mine.rect.h @entity.rect.h))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_PLACE -> showing when (not (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (or (= @entity.rect null) (!= @mine.rect.x @entity.rect.x) (!= @mine.rect.y @entity.rect.y) (!= @mine.rect.w @entity.rect.w) (!= @mine.rect.h @entity.rect.h)))))
      RASM_DIRECTION -> showing
        (set @entity.direction ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_MOTION -> showing
        (set @entity.reduced ?reduced)
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_MEASURED -> showing
      MACHINE_AT -> showing when (and (array/some @entity.states (fn s (= @s.name ?state))) (array/some @entity.groups (fn g (and (= @g.from @entity.active) (= @g.to ?state) (array/some @g.segs (fn sg (= @sg.event ?event)))))))
        (set @entity.firedLines (let ((ix (array/filter (array/range 0 (array/len @entity.trans)) (fn i (let ((t (array/nth @entity.trans @i))) (and (= @t.from @entity.active) (= @t.event ?event) (= @t.to ?state))))))) (let ((rg (if (= (array/len @ix) 0) null (array/find @entity.srcRanges (fn l (= @l.index (array/nth @ix 0))))))) (if (= @rg null) [] (let ((ls (array/slice @entity.srcLines (- @rg.start 1) @rg.end))) (let ((ind (array/reduce (array/filter @ls (fn l (> (str/len (str/trim @l)) 0))) 100000 (fn acc l (math/min @acc (- (str/len @l) (str/len (str/trim @l)))))))) (array/map @ls (fn l (str/slice @l (if (= @ind 100000) 0 @ind))))))))))
        (set @entity.from @entity.active)
        (set @entity.active ?state)
        (set @entity.fired ?event)
        (set @entity.firedMs (time/epoch-ms @now))
        (set @entity.refusedMs 0)
        (set @entity.visited (if (= (array/nth @entity.visited 0) ?state) [?state] (array/append @entity.visited ?state)))
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      MACHINE_AT -> showing when (and (array/some @entity.states (fn s (= @s.name ?state))) (not (array/some @entity.groups (fn g (and (= @g.from @entity.active) (= @g.to ?state) (array/some @g.segs (fn sg (= @sg.event ?event))))))))
        (set @entity.from "")
        (set @entity.active ?state)
        (set @entity.fired "")
        (set @entity.firedMs 0)
        (set @entity.refusedMs 0)
        (set @entity.visited [?state])
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      MACHINE_AT -> showing when (not (array/some @entity.states (fn s (= @s.name ?state))))
      MACHINE_REFUSED -> showing when (array/some @entity.groups (fn g (and (= @g.from @entity.active) (array/some @g.segs (fn sg (and (= @sg.event ?event) @sg.guarded))))))
        (set @entity.refused ?event)
        (set @entity.refusedMs (time/epoch-ms @now))
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      MACHINE_REFUSED -> showing when (not (array/some @entity.groups (fn g (and (= @g.from @entity.active) (array/some @g.segs (fn sg (and (= @sg.event ?event) @sg.guarded)))))))
      RASM_POINTER -> showing when (and (= ?kind "down") (str/startsWith ?id (str/concat @config.id "-ev-")))
        (let ((hit (array/find (array/flatten (array/map (array/filter @entity.groups (fn g (= @g.from @entity.active))) (fn g (array/map (array/filter @g.segs (fn sg (!= @sg.event "INIT"))) (fn sg { id: (str/concat @config.id "-ev-" @g.id "-" @sg.event), event: @sg.event, from: @g.from, to: @g.to }))))) (fn b (= @b.id ?id)))))
          (if (= @hit null) null (emit MACHINE_PICK { event: @hit.event, from: @hit.from, to: @hit.to })))
      RASM_POINTER -> showing when (and (= ?kind "enter") (str/startsWith ?id (str/concat @config.id "-ev-")))
        (set @entity.hovered ?id)
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_POINTER -> showing when (and (= ?kind "leave") (= ?id @entity.hovered))
        (set @entity.hovered "")
        (set @entity.paints (+ @entity.paints 1))
        (emit MACHINE_PAINT { n: @entity.paints })
      RASM_POINTER -> showing when (not (or (and (= ?kind "down") (str/startsWith ?id (str/concat @config.id "-ev-"))) (and (= ?kind "enter") (str/startsWith ?id (str/concat @config.id "-ev-"))) (and (= ?kind "leave") (= ?id @entity.hovered))))
      RASM_ACCESS -> showing when (and (= ?action "activate") (str/startsWith ?target (str/concat @config.id "-ev-")))
        (let ((hit (array/find (array/flatten (array/map (array/filter @entity.groups (fn g (= @g.from @entity.active))) (fn g (array/map (array/filter @g.segs (fn sg (!= @sg.event "INIT"))) (fn sg { id: (str/concat @config.id "-ev-" @g.id "-" @sg.event), event: @sg.event, from: @g.from, to: @g.to }))))) (fn b (= @b.id ?target)))))
          (if (= @hit null) null (emit MACHINE_PICK { event: @hit.event, from: @hit.from, to: @hit.to })))
      RASM_ACCESS -> showing when (not (and (= ?action "activate") (str/startsWith ?target (str/concat @config.id "-ev-"))))
      MACHINE_PAINT -> showing when (= @entity.rect null)
      MACHINE_PAINT -> showing when (!= @entity.rect null)
        (let ((r @entity.rect) (lw (math/max 1 @entity.layoutW)) (lh @entity.layoutH) (strip (if @config.showEffects (+ 30 (* 24 (if @config.showLines @entity.maxLines (array/reduce @entity.groups 0 (fn (m g) (array/reduce @g.segs @m (fn (m2 sg) (math/max @m2 (array/len @sg.notes))))))))) 0)))
          (let ((s (if (and (= @config.fit "both") (> @r.h 0) (> @lh 0)) (math/min @config.maxScale (/ @r.w @lw) (/ (math/max 1 (- @r.h @strip)) @lh)) (math/min @config.maxScale (/ @r.w @lw)))))
            (let ((ox (+ @r.x (/ (- @r.w (* @lw @s)) 2))) (oy @r.y) (rtl (= @entity.direction "rtl")) (h (+ (math/ceil (* @lh @s)) @strip)))
              (do
                (when (!= @h @entity.extentH) (do (set @entity.extentH @h) (emit RASM_EXTENT { n: ?n, id: @config.id, w: @r.w, h: @h })))
                (emit MACHINE_DRAW { s: @s, ox: @ox, oy: @oy, rtl: @rtl, rx: @r.x, rw: @r.w })))))
      MACHINE_DRAW -> showing
        (let (
            (s ?s) (ox ?ox) (oy ?oy) (rtl ?rtl) (lw @entity.layoutW)
            (wIdle (default (object/get @entity.looks "machine/wire/idle") {}))
            (wNext (default (object/get @entity.looks "machine/wire/next") {}))
            (wLit (default (object/get @entity.looks "machine/wire/lit") {}))
            (pIdle (default (object/get @entity.looks "machine/pill/idle") {}))
            (pNext (default (object/get @entity.looks "machine/pill/next") {}))
            (pLit (default (object/get @entity.looks "machine/pill/lit") {}))
