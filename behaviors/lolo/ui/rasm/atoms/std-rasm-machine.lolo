                          (let ((p0 (array/nth @pts 0)))
                            [{ type: draw-shape, id: (str/concat @config.id "-token-refused"), shape: "ellipse", anchor: "top-left", position: { x: @p0.x, y: @p0.y, z: (+ @config.z 4) }, radiusX: @config.tokenRadius, radiusY: @config.tokenRadius, fill: @gRef.fill, stroke: @token.stroke, strokeWidth: @token.strokeWidth, opacity: 0, hit: false,
                               animation: { durationMs: @dur, startMs: @rm, loop: false, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0 }, { at: 0.15, opacity: 1, offsetX: 0, offsetY: 0 }, { at: 0.5, opacity: 1, offsetX: (- @gxy.x @p0.x), offsetY: (- @gxy.y @p0.y) }, { at: 0.75, opacity: 1, offsetX: (- @gxy.x @p0.x), offsetY: (- @gxy.y @p0.y) }, { at: 1, opacity: 0, offsetX: (- @gxy.x @p0.x), offsetY: (- @gxy.y @p0.y) }] } }])))))) }]
                  (array/flatten (array/map @entity.edges (fn e
                    (let ((g (array/find @entity.groups (fn g (= @g.id @e.id)))))
                      (if (or (= @g null) (!= @g.from @entity.active)) @nothing
                        (array/flatten (array/map (array/range 0 (array/len @g.segs)) (fn k
                          (let ((sg (array/nth @g.segs @k))
                                (before (array/reduce (array/take @g.segs @k) 0 (fn (sum q) (+ @sum @config.segGap (if @q.guarded (+ (* 2 @config.guardRadius) @config.chipGap) 0) (default (object/get @entity.widths (str/concat @config.id "-m-e-" @q.event)) 0) (if (= (array/len @q.heads) 0) 0 (+ @config.chipGap (* (array/len @q.heads) (+ (* 2 @config.chipRadius) @config.chipGap)))))))))
                            (let ((ew (default (object/get @entity.widths (str/concat @config.id "-m-e-" @sg.event)) 0))
                                  (x0 (+ @config.pillPad @before))
                                  (bid (str/concat @config.id "-ev-" @g.id "-" @sg.event)))
                              (let ((segW (+ (if @sg.guarded (+ (* 2 @config.guardRadius) @config.chipGap) 0) @ew (if (= (array/len @sg.heads) 0) 0 (+ @config.chipGap (* (array/len @sg.heads) (+ (* 2 @config.chipRadius) @config.chipGap)))))))
                                (if (= @sg.event "INIT") @nothing
                                  [{ type: draw-shape, id: @bid, shape: "rect", anchor: "top-left", position: { x: (+ @ox (* @s (if @rtl (- (- @lw @e.labelX) (+ @x0 @segW)) (+ @e.labelX @x0)))), y: (+ @oy (* @s @e.labelY)), z: (+ @config.z 5) }, width: (* @s @segW), height: (* @s @e.labelHeight), fill: "rgba(0,0,0,0)", opacity: 1, hit: true,
                                     semantic: { role: "button", labelledBy: (str/concat @bid "-text"), disabled: false, order: @k, focused: false } }]))))))))))))) }))))
    }

    emits {
      MACHINE_PAINT -> internal {
        n : number!
      }
        @description "Paint from the stored description, measures, layout, rect, looks and last move."
        @tier "internal"
      MACHINE_DRAW -> internal {
        s : number!
        ox : number!
        oy : number!
        rtl : boolean!
        rx : number!
        rw : number!
      }
        @description "Draw the machine at a scale and origin."
        @tier "internal"
      MACHINE_DESCRIBED -> internal {
        result : DescribedSubject!
      }
        @description "The describe answer, delivered to the trait itself."
        @tier "internal"
      MACHINE_DESCRIBE_FAILED -> internal {
        error : string!
      }
        @description "The describe failure, delivered to the trait itself."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "Measuring: the state and event names, invisible, to be measured. Showing: the wires, labels, guard marks, effect glyphs, states, now badge, visit numbers and the beats of the last move or refusal."
        @tier "primary"
      RASM_EXTENT -> external {
        n : number!
        id : string!
        w : number!
        h : number!
      }
        @description "The height the scaled machine needs at its placed width."
        @tier "primary"
      LAYOUT_REQUEST -> external {
        nodes : [LayoutNode]!
        edges : [LayoutEdge]!
      }
        @description "Lay out the states (measured name plus padding) and one edge per pair of states (its label sized from its events, guard marks and effect glyphs)."
        @tier "primary"
      MACHINE_PICK -> external {
        event : string!
        from : string!
        to : string!
      }
        @description "An event leaving the current state was pressed or activated: ask the subject to take it."
        @tier "domain"
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: describe the subject."
      MACHINE_DESCRIBED { result : DescribedSubject! }
        @description "The description answered: group the transitions by pair of states, sit at the initial state and measure the names."
      MACHINE_DESCRIBE_FAILED { error : string! }
        @description "The description failed: keep the reason; nothing is painted."
      MACHINE_PAINT { n : number! }
        @description "Paint what the current state shows."
      MACHINE_DRAW { s : number!  ox : number!  oy : number!  rtl : boolean!  rx : number!  rw : number! }
        @description "Draw at the computed scale and origin."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Keep the looks; fonts may have changed, so names are measured again and the machine laid out again."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the rect of this machine's id; an unchanged rect or another id is ignored."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction; rtl mirrors the layout."
      RASM_MOTION { reduced : boolean! }
        @description "Reduced motion: the final frame with an opacity crossfade only."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Measured names: once every state and event name of this machine is measured, ask for the layout."
      LAYOUT_READY { nodes : [LayoutPlacedNode]!  edges : [LayoutRoutedEdge]!  width : number!  height : number! }
        @description "The layout answered: keep it and paint."
      LAYOUT_REJECTED { reason : string!  ids : [string]! }
        @description "The layout refused the graph: keep the reason."
      MACHINE_AT { state : string!  event : string! }
        @description "The subject moved to a described state by an event. Along a described wire from the current state the move plays its beats; otherwise the machine sits at the state without beats; an undescribed state changes nothing."
      MACHINE_REFUSED { event : string! }
        @description "A guarded event of the current state was refused: the token stops at its guard; an event with no guarded arm here changes nothing."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number!  index : number }
        @description "Pointer events on an event button: down picks it, enter and leave set and clear its hover."
      RASM_ACCESS { target : string!  action : "focus" | "activate" | "increment" | "decrement"! }
        @description "Assistive activation of an event button picks it."
    }

    config {
      id : string = "machine"
        @label "Id"
        @description "The machine's id: its RASM_PLACE key and the prefix of every node id."
        @tier "presentation"
      z : number = 3
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      subject : trait = std/behaviors/std-slide-deck.traits.SlideDeckPresenter
        @label "Subject"
        @description "The trait whose state machine is painted."
        @tier "presentation"
      omit : [string] = []
        @label "Left out"
        @description "Events whose transitions the drawing leaves out, named by the call site (a reset every state answers, say); the subject still takes them."
        @tier "presentation"
      nowLabel : MessageKey
        @label "Now label"
        @description "The catalog key of the badge on the current state."
        @tier "presentation"
      maxScale : number = 1.25
        @label "Largest scale"
        @description "The largest scale the layout is drawn at; it shrinks to fit the placed width."
        @tier "presentation"
      showEffects : boolean = false
        @label "Show effects firing"
        @description "On, a strip under the machine names the event that just fired and lists that transition's effects (operator and first argument) on a rail, each igniting one beat after the last, after the token arrives; it stays until the next move, and its room is reserved in the height."
        @tier "presentation"
      fit : "width" | "both" = "width"
        @label "Fit"
        @description "width shrinks the layout to the placed width and reports the height it needs; both also shrinks it to the placed height, for a parent that fixes the height."
        @tier "presentation"
      stateIcons : Map string string = {}
        @label "State icons"
        @description "An icon for a state, by state name: a 24 by 24 path drawn inside that state's tile before its name, outlined, and filled while the state is current (a lamp's bulb, a door, a gate)."
        @tier "presentation"
      stateIconSize : number = 22
        @label "State icon size"
        @description "The size of a state icon, in px at scale 1."
        @tier "presentation"
      showLines : boolean = false
        @label "Show lines"
        @description "With showEffects on, the strip under the machine shows the .lolo lines of the transition that just ran (from behavior/describe), each line igniting one beat after the last once the token arrives, instead of the list of its effects."
        @tier "presentation"
      stateHeight : number = 44
        @label "State height"
        @description "The height of a state, in px at scale 1."
        @tier "presentation"
      statePad : number = 22
        @label "State padding"
        @description "The space each side of a state's name."
        @tier "presentation"
      pillHeight : number = 24
        @label "Label height"
        @description "The height of a wire's label."
        @tier "presentation"
      pillPad : number = 8
        @label "Label padding"
        @description "The space each side inside a label."
        @tier "presentation"
      segGap : number = 12
        @label "Event gap"
        @description "The space between the events of one label."
        @tier "presentation"
      guardRadius : number = 5
        @label "Guard size"
        @description "The half size of a guard mark."
        @tier "presentation"
      chipRadius : number = 5
        @label "Glyph size"
        @description "The half size of an effect glyph."
        @tier "presentation"
      chipGap : number = 3
        @label "Glyph gap"
        @description "The space around guard marks and between effect glyphs."
        @tier "presentation"
      tokenRadius : number = 6
        @label "Token size"
        @description "The radius of the token that carries an event along its wire."
        @tier "presentation"
      beatMs : number = 220
        @label "Beat time"
        @description "How long each of the five beats lasts in ms."
        @tier "presentation"
    }
  }

  page boot as RasmMachineStart -> RasmMachine
}
