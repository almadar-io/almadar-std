app std-rasm-archimate [
  version: "0.1.0",
  locales: [en, ar, sl],
  description: "std-rasm-archimate — one architecture drawing in ArchiMate notation that changes as a std-rasm-slides deck moves. The composer declares the drawing once on a grid of `cols` by `rows` cells over the placed rect: `layers` (the business, application and technology bands, each a labelled band across the rect), `elements` (each a kind, a label and a cell: component, service, interface, actor, role, process, function or data, drawn as the notation's box with its kind mark in the corner; a service is the rounded box; a block is a plain box with no mark, for a drawing that wants no notation), `groups` (dashed groupings with a label) and `relations` between two elements (serving: a line with an open head; triggering: a filled head; flow: a dashed line with a filled head; realization: a dashed line with a hollow head; composition: a filled diamond at the whole; access: a dotted line; association: a plain line). `views` are the states of the drawing: the ids each shows, the ids set in the accent and the ids dimmed, and any cell an element moves to in that view. `cues` say which view a slide and step of the deck named by `deck` show; RASM_SLIDE picks the cue of that slide with the greatest step not past the deck's, and a slide with no cue paints nothing. From one view to the next an element that stays glides to its new cell on the spring, an element that arrives fades in, and the accent moves with the ids the view names, so one drawing can follow one idea across a whole talk. Under reduced motion nothing fades. Looks: archi/layer/idle, archi/element/idle, accent and dim, archi/group/idle and accent, archi/relation/idle, accent and dim, and surface/ground/idle for the hollow head."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, strokeDash : [number], corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmKeyframe = { at : number!, opacity : number, offsetX : number, offsetY : number }
type RasmAnimation = { durationMs : number!, startMs : number, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, height : number?, fit : "none" | "shrink"?, minSize : number?, animation : RasmAnimation? }
type ArchiCell = { col : number!, row : number!, w : number!, h : number! }
type ArchiLayer = { id : string!, label : MessageKey, row : number!, h : number! }
type ArchiElement = { id : string!, kind : "block" | "component" | "service" | "interface" | "actor" | "role" | "process" | "function" | "data"!, label : MessageKey, col : number!, row : number!, w : number!, h : number! }
type ArchiGroup = { id : string!, label : MessageKey, col : number!, row : number!, w : number!, h : number! }
type ArchiRelation = { id : string!, from : string!, to : string!, kind : "serving" | "triggering" | "flow" | "realization" | "composition" | "access" | "association"! }
type ArchiView = { show : [string]!, accent : [string], dim : [string], at : Map string ArchiCell, tokens : [string] }
type ArchiCue = { slide : number!, step : number!, view : number! }

orbital RasmArchimateOrbital {
  entity RasmArchimateRun [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The rect RASM_PLACE gave the drawing, null until placed." = null
    view : number @description "The view on show, -1 when the slide has no cue." = -1
    prev : number @description "The view shown before this one, -1 when none: an id it did not show fades in." = -1
    cuedMs : number @description "The epoch-ms instant the view changed, 0 before any change." = 0
    reduced : boolean @description "The viewer's reduced-motion preference." = false
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmArchimate -> RasmArchimateRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.view (let ((hit (array/filter @config.cues (fn c (and (= @c.slide 0) (<= @c.step 0)))))) (let ((c (array/last @hit))) (if (= @c null) -1 @c.view))))
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit ARCHI_PAINT { n: @entity.paints })
      RASM_MOTION -> ready
        (set @entity.reduced ?reduced)
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) @entity.rect @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit ARCHI_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_SLIDE -> ready when (= ?id @config.deck)
        (let ((hit (array/filter @config.cues (fn c (and (= @c.slide ?index) (<= @c.step (default ?step 0)))))))
          (let ((c (array/last @hit)))
            (let ((next (if (= @c null) -1 @c.view)))
              (when (!= @next @entity.view)
                (do
                  (set @entity.prev @entity.view)
                  (set @entity.view @next)
                  (set @entity.cuedMs (time/epoch-ms @now)))))))
        (set @entity.paints (+ @entity.paints 1))
        (emit ARCHI_PAINT { n: @entity.paints })
      RASM_SLIDE -> ready when (!= ?id @config.deck)
      ARCHI_PAINT -> ready when (and (!= @entity.rect null) (>= @entity.view 0) (> (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 }))) @r.w) 0))
        (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 })) (L @entity.looks) (noIds : [string] []) (blankV : ArchiView { show: [] }) (noAt : Map string ArchiCell {}) (z @config.z) (blankL : ArchiLayer { id: "", row: 0, h: 0 }) (blankG : ArchiGroup { id: "", col: 0, row: 0, w: 0, h: 0 }) (blankE : ArchiElement { id: "", kind: "component", col: 0, row: 0, w: 0, h: 0 }))
          (let ((v (default (array/nth @config.views @entity.view) @blankV)) (pv (if (>= @entity.prev 0) (default (array/nth @config.views @entity.prev) @blankV) @blankV)) (cw (/ @r.w @config.cols)) (ch (/ @r.h @config.rows)) (g @config.gap) (ground (default (object/get @L "surface/ground/idle" null) {})))
            (let ((show @v.show) (acc (default @v.accent @noIds)) (dim (default @v.dim @noIds)) (tok (default @v.tokens @noIds)) (at (default @v.at @noAt)) (was @pv.show) (anim : RasmAnimation? (if (or @entity.reduced (= @entity.cuedMs 0)) null { durationMs: @config.fadeMs, startMs: @entity.cuedMs, loop: false, keyframes: [{ at: 0, opacity: 0 }, { at: 1, opacity: 1 }] })))
              (let ((els (array/filter (array/range 0 (array/len @config.elements)) (fn i (let ((e (default (array/nth @config.elements @i) @blankE))) (array/includes @show @e.id))))))
                (emit RASM_PAINT { n: ?n, id: @config.id, z: @z,
                  texts: (array/concat
                    (array/flatten (array/map (array/filter (array/range 0 (array/len @config.layers)) (fn i (let ((l (default (array/nth @config.layers @i) @blankL))) (array/includes @show @l.id)))) (fn i (let ((l (default (array/nth @config.layers @i) @blankL))) (let ((lk (default (object/get @L "archi/layer/idle" null) {})))
                      (let ((k : MessageKey? (default @l.label null)) (none : [RasmText] [])) (if (= @k null) @none [{ id: (str/concat @config.id ":layer:" @l.id ":label"), key: @k, x: (+ @r.x 14), y: (+ (+ @r.y (* @l.row @ch)) 10), z: (+ @z 1), align: "left", baseline: "top", color: @lk.textColor, font: @lk.font, width: (- @r.w 28), wrap: false, animation: (if (array/includes @was @l.id) null @anim) }])))))))
                    (array/flatten (array/map (array/filter (array/range 0 (array/len @config.groups)) (fn i (let ((gr (default (array/nth @config.groups @i) @blankG))) (array/includes @show @gr.id)))) (fn i (let ((gr (default (array/nth @config.groups @i) @blankG))) (let ((lk (default (object/get @L (if (array/includes @acc @gr.id) "archi/group/accent" "archi/group/idle") null) {})))
                      (let ((k : MessageKey? (default @gr.label null)) (none : [RasmText] [])) (if (= @k null) @none [{ id: (str/concat @config.id ":group:" @gr.id ":label"), key: @k, x: (+ (+ @r.x (* @gr.col @cw)) 12), y: (+ (+ @r.y (* @gr.row @ch)) 8), z: (+ @z 2), align: "left", baseline: "top", color: @lk.textColor, font: @lk.font, width: (- (* @gr.w @cw) 24), wrap: false, animation: (if (array/includes @was @gr.id) null @anim) }])))))))
                    (array/flatten (array/map @els (fn i (let ((e (default (array/nth @config.elements @i) @blankE))) (let ((c (default (object/get @at @e.id null) { col: @e.col, row: @e.row, w: @e.w, h: @e.h })) (lk (default (object/get @L (if (array/includes @acc @e.id) "archi/element/accent" (if (array/includes @dim @e.id) "archi/element/dim" "archi/element/idle")) null) {})))
                      (let ((k : MessageKey? (default @e.label null)) (none : [RasmText] [])) (if (= @k null) @none [{ id: (str/concat @config.id ":el:" @e.id ":label"), key: @k, x: (+ (+ @r.x (* @c.col @cw)) (/ (* @c.w @cw) 2)), y: (+ (+ @r.y (* @c.row @ch)) (/ (* @c.h @ch) 2)), z: (+ @z 5), align: "center", baseline: "middle", color: @lk.textColor, font: @lk.font, spring: @config.spring, animation: (if (array/includes @was @e.id) null @anim) }])))))))),
                  nodes: (array/concat
                    (array/map (array/filter (array/range 0 (array/len @config.layers)) (fn i (let ((l (default (array/nth @config.layers @i) @blankL))) (array/includes @show @l.id)))) (fn i (let ((l (default (array/nth @config.layers @i) @blankL))) (let ((lk (default (object/get @L "archi/layer/idle" null) {})))
                      { type: draw-shape, id: (str/concat @config.id ":layer:" @l.id), shape: rect, anchor: "top-left", position: { x: @r.x, y: (+ (+ @r.y (* @l.row @ch)) 2), z: @z }, width: @r.w, height: (- (* @l.h @ch) 4), fill: @lk.fill, stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, corners: @lk.corners, animation: (if (array/includes @was @l.id) null @anim), hit: false }))))
                    (array/map (array/filter (array/range 0 (array/len @config.groups)) (fn i (let ((gr (default (array/nth @config.groups @i) @blankG))) (array/includes @show @gr.id)))) (fn i (let ((gr (default (array/nth @config.groups @i) @blankG))) (let ((lk (default (object/get @L (if (array/includes @acc @gr.id) "archi/group/accent" "archi/group/idle") null) {})))
                      { type: draw-shape, id: (str/concat @config.id ":group:" @gr.id), shape: rect, anchor: "top-left", position: { x: (+ (+ @r.x (* @gr.col @cw)) 2), y: (+ (+ @r.y (* @gr.row @ch)) 2), z: (+ @z 2) }, width: (- (* @gr.w @cw) 4), height: (- (* @gr.h @ch) 4), fill: "", stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, strokeDash: @lk.strokeDash, corners: @lk.corners, spring: @config.spring, animation: (if (array/includes @was @gr.id) null @anim), hit: false }))))
                    (array/flatten (array/map (array/filter @config.relations (fn rl (and (array/includes @show @rl.id) (array/includes @show @rl.from) (array/includes @show @rl.to)))) (fn rl
                      (let ((fe (array/find @config.elements (fn e (= @e.id @rl.from)))) (te (array/find @config.elements (fn e (= @e.id @rl.to)))) (none : [node] []) (lk (default (object/get @L (if (array/includes @acc @rl.id) "archi/relation/accent" (if (array/includes @dim @rl.id) "archi/relation/dim" "archi/relation/idle")) null) {})))
                        (if (or (= @fe null) (= @te null)) @none
                          (let ((fc (default (object/get @at @fe.id null) { col: @fe.col, row: @fe.row, w: @fe.w, h: @fe.h })) (tc (default (object/get @at @te.id null) { col: @te.col, row: @te.row, w: @te.w, h: @te.h })))
                            (let ((fx (+ (+ @r.x (* @fc.col @cw)) @g)) (fy (+ (+ @r.y (* @fc.row @ch)) @g)) (fw (- (* @fc.w @cw) (* 2 @g))) (fh (- (* @fc.h @ch) (* 2 @g))) (tx (+ (+ @r.x (* @tc.col @cw)) @g)) (ty (+ (+ @r.y (* @tc.row @ch)) @g)) (tw (- (* @tc.w @cw) (* 2 @g))) (th (- (* @tc.h @ch) (* 2 @g))))
                              (let ((dx (- (+ @tx (/ @tw 2)) (+ @fx (/ @fw 2)))) (dy (- (+ @ty (/ @th 2)) (+ @fy (/ @fh 2)))))
                                (let ((across (>= (math/abs @dx) (math/abs @dy))))
                                  (let ((sx (if @across (if (> @dx 0) (+ @fx @fw) @fx) (+ @fx (/ @fw 2)))) (sy (if @across (+ @fy (/ @fh 2)) (if (> @dy 0) (+ @fy @fh) @fy))) (ex (if @across (if (> @dx 0) @tx (+ @tx @tw)) (+ @tx (/ @tw 2)))) (ey (if @across (+ @ty (/ @th 2)) (if (> @dy 0) @ty (+ @ty @th)))))
                                    (let ((len (math/max 1 (math/hypot (- @ex @sx) (- @ey @sy)))))
                                      (let ((ux (/ (- @ex @sx) @len)) (uy (/ (- @ey @sy) @len)) (hl @config.head) (hw (* @config.head 0.5)) (closed (or (= @rl.kind "triggering") (= @rl.kind "flow") (= @rl.kind "realization"))))
                                        (let ((bx (- @ex (* @ux @hl))) (by (- @ey (* @uy @hl))) (lsx (if (= @rl.kind "composition") (+ @sx (* @ux (* 2 @hl))) @sx)) (lsy (if (= @rl.kind "composition") (+ @sy (* @uy (* 2 @hl))) @sy)))
                                          (array/concat
                                            [{ type: draw-shape, id: (str/concat @config.id ":rel:" @rl.id), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: (+ @z 3) }, d: (str/concat "M" @lsx " " @lsy " L" (if @closed @bx @ex) " " (if @closed @by @ey)), fill: "", stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, strokeDash: (if (or (= @rl.kind "flow") (= @rl.kind "realization")) [8, 6] (if (= @rl.kind "access") [2, 5] null)), animation: (if (array/includes @was @rl.id) null @anim), hit: false }]
                                            (let ((tl (default (object/get @L "archi/token/idle" null) {})))
                                              (if (or @entity.reduced (not (array/includes @tok @rl.id))) @none
                                                [{ type: draw-shape, id: (str/concat @config.id ":rel:" @rl.id ":token"), shape: "ellipse", anchor: "center", position: { x: @sx, y: @sy, z: (+ @z 6) }, radiusX: @config.tokenR, radiusY: @config.tokenR, fill: @tl.fill, shadow: @tl.shadow, animation: { durationMs: @config.tokenMs, startMs: @entity.cuedMs, loop: true, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0 }, { at: 0.12, opacity: 1, offsetX: (* 0.12 (- @ex @sx)), offsetY: (* 0.12 (- @ey @sy)) }, { at: 0.78, opacity: 1, offsetX: (* 0.9 (- @ex @sx)), offsetY: (* 0.9 (- @ey @sy)) }, { at: 0.9, opacity: 0, offsetX: (- @ex @sx), offsetY: (- @ey @sy) }, { at: 1, opacity: 0, offsetX: (- @ex @sx), offsetY: (- @ey @sy) }] }, hit: false }]))
                                            (if (or (= @rl.kind "association") (= @rl.kind "composition")) @none
                                              [{ type: draw-shape, id: (str/concat @config.id ":rel:" @rl.id ":head"), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: (+ @z 4) }, d: (str/concat "M" (- @bx (* @uy @hw)) " " (+ @by (* @ux @hw)) " L" @ex " " @ey " L" (+ @bx (* @uy @hw)) " " (- @by (* @ux @hw)) (if @closed " Z" "")), fill: (if (or (= @rl.kind "triggering") (= @rl.kind "flow")) @lk.stroke (if (= @rl.kind "realization") @ground.fill "")), stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, animation: (if (array/includes @was @rl.id) null @anim), hit: false }])
                                            (if (!= @rl.kind "composition") @none
                                              [{ type: draw-shape, id: (str/concat @config.id ":rel:" @rl.id ":whole"), shape: "path", anchor: "top-left", position: { x: 0, y: 0, z: (+ @z 4) }, d: (str/concat "M" @sx " " @sy " L" (- (+ @sx (* @ux @hl)) (* @uy @hw)) " " (+ (+ @sy (* @uy @hl)) (* @ux @hw)) " L" (+ @sx (* @ux (* 2 @hl))) " " (+ @sy (* @uy (* 2 @hl))) " L" (+ (+ @sx (* @ux @hl)) (* @uy @hw)) " " (- (+ @sy (* @uy @hl)) (* @ux @hw)) " Z"), fill: @lk.stroke, stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, animation: (if (array/includes @was @rl.id) null @anim), hit: false }])))))))))))))))
                    (array/flatten (array/map @els (fn i (let ((e (default (array/nth @config.elements @i) @blankE))) (let ((c (default (object/get @at @e.id null) { col: @e.col, row: @e.row, w: @e.w, h: @e.h })) (none : [node] []) (lk (default (object/get @L (if (array/includes @acc @e.id) "archi/element/accent" (if (array/includes @dim @e.id) "archi/element/dim" "archi/element/idle")) null) {})) (mark (object/get { component: "M4 2 H15 V14 H4 Z M1 4 H7 V7 H1 Z M1 9 H7 V12 H1 Z", interface: "M1 8 H6 M6 8 a4.5 4.5 0 1 0 9 0 a4.5 4.5 0 1 0 -9 0", actor: "M8 1 a2.2 2.2 0 1 0 0.01 0 M8 5.6 V10.6 M4 7.6 H12 M8 10.6 L5 15 M8 10.6 L11 15", role: "M4 3 H11 a3 5 0 1 1 0 10 H4 a3 5 0 1 1 0 -10 Z", process: "M1 6 H9 V3 L15 8 L9 13 V10 H1 Z", function: "M2 14 V6 L8 2 L14 6 V14 L8 10 Z", data: "M2 2 H14 V14 H2 Z M2 6 H14", service: "", block: "" } @e.kind "")))
                      (let ((x (+ (+ @r.x (* @c.col @cw)) @g)) (y (+ (+ @r.y (* @c.row @ch)) @g)) (w (- (* @c.w @cw) (* 2 @g))) (h (- (* @c.h @ch) (* 2 @g))))
                        (array/concat
                          [{ type: draw-shape, id: (str/concat @config.id ":el:" @e.id), shape: rect, anchor: "top-left", position: { x: @x, y: @y, z: (+ @z 4) }, width: @w, height: @h, fill: @lk.fill, stroke: @lk.stroke, strokeWidth: @lk.strokeWidth, strokeDash: @lk.strokeDash, corners: (if (= @e.kind "service") { radius: [(/ @h 2), (/ @h 2), (/ @h 2), (/ @h 2)], kind: "round" } @lk.corners), spring: @config.spring, animation: (if (array/includes @was @e.id) null @anim), hit: false }]
                          (if (= @mark "") @none
                            [{ type: draw-shape, id: (str/concat @config.id ":el:" @e.id ":mark"), shape: "path", anchor: "top-left", position: { x: (- (+ @x @w) (+ (* 16 @config.markScale) 8)), y: (+ @y 8), z: (+ @z 5) }, d: @mark, scale: @config.markScale, fill: "", stroke: @lk.textColor, strokeWidth: 1.4, spring: @config.spring, animation: (if (array/includes @was @e.id) null @anim), hit: false }]))))))))) })))))
      ARCHI_PAINT -> ready when (not (and (!= @entity.rect null) (>= @entity.view 0) (> (let ((r (default @entity.rect { x: 0, y: 0, w: 0, h: 0 }))) @r.w) 0)))
        (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: [], nodes: [] })
    }

    emits {
      ARCHI_PAINT -> internal {
        n : number!
      }
        @description "Repaint the drawing."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The view on show: its layers, groups, elements and relations."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks the drawing is painted in."
      RASM_MOTION { reduced : boolean! }
        @description "The viewer's reduced-motion preference: reduced, nothing fades."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the drawing's rect."
      RASM_SLIDE { id : string!  index : number!  step : number }
        @description "The deck moved: show the view its cue names."
    }

    config {
      id : string = "archi"
        @label "Id"
        @description "The drawing's placed id and paint id."
        @tier "domain"
      deck : string = "slides"
        @label "Deck"
        @description "The id of the std-rasm-slides deck whose RASM_SLIDE picks the view."
        @tier "domain"
      cols : number = 12
        @label "Columns"
        @description "How many cells the rect is divided into across."
        @tier "presentation"
      rows : number = 8
        @label "Rows"
        @description "How many cells the rect is divided into down."
        @tier "presentation"
      layers : [ArchiLayer] = []
        @label "Layers"
        @description "The bands across the rect, each with its label, its first row and its height in rows."
        @tier "domain"
      elements : [ArchiElement] = []
        @label "Elements"
        @description "The elements of the drawing: id, kind, label and home cell."
        @tier "domain"
      groups : [ArchiGroup] = []
        @label "Groups"
        @description "Dashed groupings, each with its label and cell."
        @tier "domain"
      relations : [ArchiRelation] = []
        @label "Relations"
        @description "The relations between two elements, each with its kind; one is drawn while a view shows it and both its ends."
        @tier "domain"
      views : [ArchiView] = []
        @label "Views"
        @description "The states of the drawing: the ids shown, the ids in the accent, the ids dimmed, and the cells elements move to."
        @tier "domain"
      cues : [ArchiCue] = []
        @label "Cues"
        @description "Which view a slide and step show, in step order within a slide."
        @tier "domain"
      gap : number = 8
        @label "Gap"
        @description "The space in px kept round each element inside its cell."
        @tier "presentation"
      head : number = 12
        @label "Head"
        @description "The length in px of a relation's head."
        @tier "presentation"
      markScale : number = 1.2
        @label "Mark scale"
        @description "The scale of the kind mark in an element's corner; 1 draws it 16px."
        @tier "presentation"
      tokenMs : number = 1800
        @label "Token travel time"
        @description "How long, in milliseconds, a token takes to travel a relation a view names in `tokens`; it then starts again."
        @tier "presentation"
      tokenR : number = 7
        @label "Token radius"
        @description "The radius, in pixels, of a travelling token."
        @tier "presentation"
      fadeMs : number = 480
        @label "Fade"
        @description "How long an arriving part takes to fade in, in ms."
        @tier "presentation"
      spring : RasmSpring = { stiffness: 120, damping: 20 }
        @label "Spring"
        @description "The spring an element glides on when a view moves it."
        @tier "presentation"
      z : number = 20
        @label "Z"
        @description "Paint order of the drawing."
        @tier "presentation"
    }
  }

  page boot as RasmArchimateStart -> RasmArchimate
}
