app std-rasm-surface [
  version: "0.1.0",
  description: "std-rasm-surface — the Rasm kit's one canvas. It paints the ground look, then every control's RASM_PAINT nodes ordered by z, on an orbital-painter canvas, and turns the canvas's pointer, measure and key events into the kit's RASM_POINTER, RASM_MEASURED and RASM_KEY. It emits the root RASM_PLACE so layout can start."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number! }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmTouch = { pointerId : number!, x : number!, y : number! }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation? }
type RasmPaintEntry = { id : string!, z : number!, nodes : [node]!, texts : [RasmText]! }

orbital RasmSurfaceOrbital {
  entity RasmSurfaceRun [runtime] {
    id : string!
    paints : Map string RasmPaintEntry @description "Every control's latest paint by control id." = {}
    looks : Map string RasmLook @description "The announced look table." = {}
    viewW : number @description "The canvas width the layout uses: the config width, then the container's width." = 720
    viewH : number @description "The canvas height: the root's content height plus the margins, or the container's height when fill is on." = 520
    contentH : number @description "The root's content height: the rootRect height until the root reports its extent." = 520
    root : RasmRect @description "The rect handed to the root child." = { x: 0, y: 0, w: 720, h: 520 }
    dir : "ltr" | "rtl" @description "The reading direction the canvas reported from the page locale." = "ltr"
    hidden : [string] @description "The paint ids RASM_VISIBLE hid: their paints are kept and not drawn." = []
    repaints : number @description "Counts repaints, so each repaint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmSurface -> RasmSurfaceRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.viewW @config.width)
        (set @entity.viewH @config.height)
        (set @entity.root @config.rootRect)
        (set @entity.contentH @config.rootRect.h)
        (emit RASM_BOOT { })
        (emit RASM_PLACE { placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (emit RASM_PLACE { placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_RESIZE -> ready when @config.fill
        (set @entity.viewW ?width)
        (set @entity.viewH ?height)
        (set @entity.root (let ((w (math/max 0 (- ?width (* 2 @config.margin)))) (h (math/max 0 (- ?height (* 2 @config.margin))))) (if (= @config.align "center") { x: (/ (- ?width (math/min @config.rootRect.w @w)) 2), y: (/ (- ?height (math/min @config.rootRect.h @h)) 2), w: (math/min @config.rootRect.w @w), h: (math/min @config.rootRect.h @h) } { x: @config.margin, y: @config.margin, w: @w, h: @h })))
        (emit RASM_PLACE { placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_RESIZE -> ready when (not @config.fill)
        (set @entity.viewW ?width)
        (set @entity.viewH (+ @entity.contentH (* 2 @config.margin)))
        (set @entity.root (let ((w (math/max 0 (- ?width (* 2 @config.margin))))) (let ((rw (if (= @config.align "center") (math/min @config.rootRect.w @w) @w))) { x: (if (= @config.align "center") (/ (- ?width @rw) 2) @config.margin), y: @config.margin, w: @rw, h: @entity.contentH })))
        (emit RASM_PLACE { placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> ready when (and (not @config.fill) (= ?id @config.rootChild) (!= ?h @entity.contentH))
        (set @entity.contentH ?h)
        (set @entity.viewH (+ ?h (* 2 @config.margin)))
        (set @entity.root { x: @entity.root.x, y: @entity.root.y, w: @entity.root.w, h: ?h })
        (emit RASM_PLACE { placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> ready when (or @config.fill (or (!= ?id @config.rootChild) (= ?h @entity.contentH)))
      SURFACE_RESIZE -> ready
        (emit RASM_RESIZE { width: ?width, height: ?height })
      SURFACE_TEXT -> ready
        (emit RASM_TEXT { target: ?target, text: ?text, composing: ?composing })
      SURFACE_KEY -> ready when (and (= ?key "Tab") (not ?shift))
        (emit RASM_KEY { key: "next" })
      SURFACE_KEY -> ready when (and (= ?key "Tab") ?shift)
        (emit RASM_KEY { key: "previous" })
      SURFACE_KEY -> ready when (!= ?key "Tab")
        (emit RASM_KEYPRESS { target: ?target, key: ?key, shift: ?shift, alt: ?alt, ctrl: ?ctrl, meta: ?meta })
      SURFACE_ACCESS -> ready
        (emit RASM_ACCESS { target: ?target, action: ?action })
      SURFACE_DIRECTION -> ready
        (set @entity.dir ?direction)
        (emit RASM_DIRECTION { direction: ?direction })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      SURFACE_WHEEL -> ready
        (emit RASM_WHEEL { target: ?target, x: ?x, y: ?y, dx: ?dx, dy: ?dy })
      RASM_PAINT -> ready
        (set @entity.paints (object/set @entity.paints ?id { id: ?id, z: ?z, nodes: ?nodes, texts: (default ?texts []) }))
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_VISIBLE -> ready
        (set @entity.hidden (array/concat (array/filter @entity.hidden (fn h (not (array/includes ?shown @h)))) (array/filter ?hidden (fn h (not (array/includes @entity.hidden @h))))))
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      SURFACE_REPAINT -> ready
        (render-ui main {
          type: canvas
          mode: "2d"
          projection: "free"
          painter: "orbital"
          camera: { mode: "top-down", zoom: 1 }
          pointerMoves: "captured"
          fillContainer: (if @config.fill true "width")
          worldWidth: @entity.viewW
          worldHeight: @entity.viewH
          resizeEvent: "SURFACE_RESIZE"
          textInputEvent: "SURFACE_TEXT"
          keyEvent: "SURFACE_KEY"
          accessEvent: "SURFACE_ACCESS"
          wheelEvent: "SURFACE_WHEEL"
          direction: (i18n/direction)
          directionEvent: "SURFACE_DIRECTION"
          pointerDownEvent: "POINTER_DOWN"
          pointerUpEvent: "POINTER_UP"
          pointerEnterEvent: "POINTER_ENTER"
          pointerLeaveEvent: "POINTER_LEAVE"
          pointerMoveEvent: "POINTER_MOVE"
          measureEvent: "SURFACE_MEASURED"
          keyMap: { Tab: "KEY_NEXT", "Shift+Tab": "KEY_PREVIOUS", Enter: "KEY_ACTIVATE", Space: "KEY_ACTIVATE", ArrowRight: (if (= @entity.dir "rtl") "KEY_DECREASE" "KEY_INCREASE"), ArrowUp: "KEY_INCREASE", ArrowLeft: (if (= @entity.dir "rtl") "KEY_INCREASE" "KEY_DECREASE"), ArrowDown: "KEY_DECREASE", Escape: "KEY_ESCAPE", PageUp: "KEY_PAGE_UP", PageDown: "KEY_PAGE_DOWN", Home: "KEY_HOME", End: "KEY_END" }
          drawables: (let ((g (object/get @entity.looks "surface/ground/idle" null))) (array/concat (if (= @g null) [] [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":ground"), position: { x: 0, y: 0 }, anchor: "top-left", width: @entity.viewW, height: @entity.viewH, fill: @g.fill, material: @g.material, spring: @g.spring, hit: false }]) (array/flatten (array/map (array/filter (array/sort (object/values @entity.paints) "z" "asc") (fn e (not (array/includes @entity.hidden @e.id)))) (fn e (array/concat @e.nodes (array/map @e.texts (fn t (let ((said (default (i18n/t @t.key) ""))) { type: draw-text, id: @t.id, text: @said, anchor: "top-left", position: { x: @t.x, y: @t.y, z: @t.z }, align: @t.align, baseline: @t.baseline, color: @t.color, font: @t.font, spring: @t.spring, width: @t.width, wrap: @t.wrap, measure: @t.measure, animation: @t.animation, hit: false, semantic: (if (= @t.role null) null { role: @t.role, name: @said }) })))))))))
        })
      POINTER_DOWN -> ready
        (emit RASM_POINTER { kind: "down", id: ?target, x: ?x, y: ?y, index: (default ?index -1) })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "down", id: ?target, touches: ?touches }))
      POINTER_UP -> ready
        (emit RASM_POINTER { kind: "up", id: ?target, x: ?x, y: ?y })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "up", id: ?target, touches: ?touches }))
      POINTER_ENTER -> ready
        (emit RASM_POINTER { kind: "enter", id: ?target, x: ?x, y: ?y })
      POINTER_LEAVE -> ready
        (emit RASM_POINTER { kind: "leave", id: ?target, x: ?x, y: ?y })
      POINTER_MOVE -> ready
        (emit RASM_POINTER { kind: "move", id: ?target, x: ?x, y: ?y })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "move", id: ?target, touches: ?touches }))
      SURFACE_MEASURED -> ready
        (emit RASM_MEASURED { items: ?items })
      KEY_NEXT -> ready
        (emit RASM_KEY { key: "next" })
      KEY_PREVIOUS -> ready
        (emit RASM_KEY { key: "previous" })
      KEY_ACTIVATE -> ready
        (emit RASM_KEY { key: "activate" })
      KEY_INCREASE -> ready
        (emit RASM_KEY { key: "increase" })
      KEY_DECREASE -> ready
        (emit RASM_KEY { key: "decrease" })
      KEY_ESCAPE -> ready
        (emit RASM_KEY { key: "escape" })
      KEY_PAGE_UP -> ready
        (emit RASM_KEY { key: "pageUp" })
      KEY_PAGE_DOWN -> ready
        (emit RASM_KEY { key: "pageDown" })
      KEY_HOME -> ready
        (emit RASM_KEY { key: "home" })
      KEY_END -> ready
        (emit RASM_KEY { key: "end" })
    }

    emits {
      RASM_BOOT -> external { }
        @description "The surface mounted: the theme and the entry choreography start from it."
        @tier "domain"
      SURFACE_REPAINT -> internal {
        n : number!
      }
        @description "Repaint the canvas from the collected paints."
        @tier "internal"
      RASM_PLACE -> external {
        placed : [RasmPlaced]!
      }
        @description "The root rect for the layout tree."
        @tier "primary"
      RASM_POINTER -> external {
        kind : "down" | "up" | "enter" | "leave" | "move"!
        id : string!
        x : number!
        y : number!
        index : number
      }
        @description "A canvas pointer event for the control that owns the id; a press on a text carries the caret index nearest it, -1 elsewhere."
        @tier "primary"
      RASM_MEASURED -> external {
        items : [RasmMeasureItem]!
      }
        @description "Sizes of the measured texts."
        @tier "primary"
      RASM_RESIZE -> external {
        width : number!
        height : number!
      }
        @description "The canvas size in CSS pixels; the root rect is placed from it."
        @tier "primary"
      RASM_TEXT -> external {
        target : string!
        text : string!
        composing : boolean!
      }
        @description "Committed or preedit text for the focused text field."
        @tier "primary"
      RASM_KEYPRESS -> external {
        target : string!
        key : string!
        shift : boolean!
        alt : boolean!
        ctrl : boolean!
        meta : boolean!
      }
        @description "An editing key for the focused text field or Choice."
        @tier "primary"
      RASM_TOUCHES -> external {
        kind : "down" | "up" | "move"!
        id : string!
        touches : [RasmTouch]!
      }
        @description "The pointers held down while a multi-touch gesture is in progress, in ascending pointerId, with the hit region they started on; a single pointer never sends it."
        @tier "primary"
      RASM_WHEEL -> external {
        target : string!
        x : number!
        y : number!
        dx : number!
        dy : number!
      }
        @description "The wheel turned over the surface: the topmost hit region under the pointer (empty for none), the point, and the scroll in px."
        @tier "primary"
      RASM_ACCESS -> external {
        target : string!
        action : "focus" | "activate" | "increment" | "decrement"!
      }
        @description "An assistive technology acted on a node of the semantic tree."
        @tier "primary"
      RASM_KEY -> external {
        key : "next" | "previous" | "activate" | "increase" | "decrease" | "escape" | "pageUp" | "pageDown" | "home" | "end"!
      }
        @description "A keyboard intent from the canvas key map; a key a focused text field or combobox handled never reaches it."
        @tier "primary"
      RASM_DIRECTION -> external {
        direction : "ltr" | "rtl"!
      }
        @description "The surface's reading direction, announced once before the root is placed."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks, paint the ground and place the root."
      RASM_PAINT { id : string!  z : number!  nodes : [node]!  texts : [RasmText] }
        @description "Keep one control's nodes and its catalog-keyed texts at its z and repaint; each text is painted in the active locale."
      RASM_VISIBLE { owner : string!  shown : [string]!  hidden : [string]! }
        @description "Stop drawing the paints of the hidden ids and draw the shown ids again; the paints are kept."
      RASM_RESIZE { width : number!  height : number! }
        @description "Re-place the root from the new size."
      RASM_EXTENT { id : string!  w : number!  h : number! }
        @description "The root's content size: unless fill is on, the canvas height follows it so the page scrolls past a long surface."
      SURFACE_RESIZE { width : number!  height : number! }
        @description "Canvas size in CSS pixels."
      SURFACE_TEXT { target : string!  text : string!  composing : boolean! }
        @description "Text for the focused text field."
      SURFACE_KEY { target : string!  key : string!  shift : boolean!  alt : boolean!  ctrl : boolean!  meta : boolean! }
        @description "An editing key for the focused text field."
      SURFACE_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The page locale's reading direction, reported by the canvas once and on change."
      SURFACE_WHEEL { target : string!  x : number!  y : number!  dx : number!  dy : number! }
        @description "The canvas wheel, in CSS pixels."
      SURFACE_ACCESS { target : string!  action : "focus" | "activate" | "increment" | "decrement"! }
        @description "An assistive-technology action on a semantic node."
      POINTER_DOWN { target : string!  x : number!  y : number!  index : number  touches : [RasmTouch] }
        @description "Canvas press on a hit drawable."
      POINTER_UP { target : string!  x : number!  y : number!  touches : [RasmTouch] }
        @description "Canvas release, sent to the drawable that took the press."
      POINTER_ENTER { target : string!  x : number!  y : number! }
        @description "Canvas pointer entered a hit drawable."
      POINTER_LEAVE { target : string!  x : number!  y : number! }
        @description "Canvas pointer left a hit drawable."
      POINTER_MOVE { target : string!  x : number!  y : number!  touches : [RasmTouch] }
        @description "Canvas pointer moved over a hit drawable or under capture."
      SURFACE_MEASURED { items : [RasmMeasureItem]! }
        @description "Canvas text measurements."
      KEY_NEXT { }
        @description "Tab pressed."
      KEY_PREVIOUS { }
        @description "Shift+Tab pressed."
      KEY_ACTIVATE { }
        @description "Enter or Space pressed."
      KEY_INCREASE { }
        @description "ArrowRight or ArrowUp pressed."
      KEY_DECREASE { }
        @description "ArrowLeft or ArrowDown pressed."
      KEY_ESCAPE { }
        @description "Escape pressed."
      KEY_PAGE_UP { }
        @description "PageUp pressed."
      KEY_PAGE_DOWN { }
        @description "PageDown pressed."
      KEY_HOME { }
        @description "Home pressed."
      KEY_END { }
        @description "End pressed."
    }

    config {
      id : string = "rasm"
        @label "Id"
        @description "The surface's id; the ground drawable is `<id>:ground`."
        @tier "presentation"
      width : number = 720
        @label "Width"
        @description "Canvas width in px until the container reports its width."
        @tier "presentation"
      height : number = 520
        @label "Height"
        @description "Canvas height in px until the root reports its content height (or, with fill on, the container its height)."
        @tier "presentation"
      rootChild : string = "root"
        @label "Root child"
        @description "The id that receives the whole canvas as its rect."
        @tier "presentation"
      rootRect : RasmRect = { x: 0, y: 0, w: 720, h: 520 }
        @label "Root rect"
        @description "The rect handed to the root child until the canvas is sized: its w is the most the root takes (align center), its h the starting content height."
        @tier "presentation"
      fill : boolean = false
        @label "Fill"
        @description "On, the canvas takes its container's whole box and the root fits inside it. Off (the default), the canvas takes its container's width and the root's content height, so the page scrolls past a long surface."
        @tier "presentation"
      margin : number = 0
        @label "Margin"
        @description "The gap in px kept on every side between the surface and the root rect."
        @tier "presentation"
      align : "stretch" | "center" = "stretch"
        @label "Align"
        @description "Stretch gives the root the surface width minus the margin; center gives it its rootRect width (capped to the surface minus the margin) centred, and with fill on its rootRect height centred too."
        @tier "presentation"
    }
  }

  page "/rasm-surface" as RasmSurfacePage -> RasmSurface
}
