app std-rasm-surface [
  version: "0.1.0",
  description: "std-rasm-surface — the Rasm kit's one canvas. It paints the ground look, then every control's RASM_PAINT nodes ordered by z, on an orbital-painter canvas, and turns the canvas's pointer, measure and key events into the kit's RASM_POINTER, RASM_MEASURED and RASM_KEY. It emits the root RASM_PLACE so layout can start."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmTouch = { pointerId : number!, x : number!, y : number! }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]!, startMs : number }
type RasmReveal = { startMs : number!, perGlyphMs : number!, durationMs : number!, offsetY : number }
type RasmBreakpoint = { name : "phone" | "tablet" | "desktop" | "wide"!, min : number! }
type RasmClip = { x : number!, y : number!, width : number!, height : number! }
type RasmTravelKey = { at : number!, opacity : number, offsetX : number, offsetY : number }
type RasmTravel = { durationMs : number, startMs : number, loop : boolean, clock : "scroll", from : number, to : number, keyframes : [RasmTravelKey]! }
type RasmHalo = { color : string!, width : number! }
type RasmText = { id : string!, key : MessageKey!, params : RasmTextParams?, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, level : number?, animation : RasmAnimation?, reveal : RasmReveal?, height : number?, fit : "none" | "shrink"?, minSize : number?, clip : RasmClip?, travel : RasmTravel?, locale : string?, maxWidth : number?, rotate : number?, vertical : boolean?, pivotX : number?, pivotY : number?, halo : RasmHalo? }
type RasmTarget = { id : string!, fragments : [string]! }
type RasmTransition = { durationMs : number!, distance : number!, staggerMs : number!, owners : [string]!, still : [string]! }
type RasmRingPos = { x : number!, y : number!, z : number! }
type RasmRingBox = { id : string!, position : RasmRingPos!, width : number?, height : number?, corners : RasmCorners? }
type RasmTextParams = Map string string
type RasmFont = { family : string!, file : string!, generic : "serif" | "sans-serif" | "monospace"! }
type RasmThemeLayer = { palette : Map string string!, fonts : Map string RasmFont! }
type RasmPaintEntry = { id : string!, z : number!, nodes : [node]!, texts : [RasmText]! }
type RasmScrubFrame = { at : number!, opacity : number, offsetX : number, offsetY : number, scale : number, rotate : number, dashOffset : number }
type RasmScrubEntry = { id : string!, paints : [string]!, from : number!, to : number!, keyframes : [RasmScrubFrame]! }

orbital RasmSurfaceOrbital {
  entity RasmSurfaceRun [runtime] {
    id : string!
    paints : Map string RasmPaintEntry @description "Every control's latest paint by control id." = {}
    looks : Map string RasmLook @description "The announced look table." = {}
    layer : RasmThemeLayer @description "The palette and fonts the announced theme lays over the host theme on the canvas." = { palette: {}, fonts: {} }
    viewW : number @description "The canvas width the layout uses: the config width, then the container's width." = 720
    viewH : number @description "The canvas height: the root's content height plus the margins, or with fill on the largest of the container's height, minHeight and the root's content height, as the canvas itself grows." = 520
    fillMin : number @description "With fill on, the root's content height: the canvas stays at least this tall, so the page scrolls instead of squeezing the content." = 0
    containerH : number @description "With fill on, the container height the last RASM_RESIZE reported." = 0
    contentH : number @description "The root's content height: the rootRect height until the root reports its extent." = 520
    root : RasmRect @description "The rect handed to the root child." = { x: 0, y: 0, w: 720, h: 520 }
    dir : "ltr" | "rtl" @description "The reading direction the canvas reported from the page locale." = "ltr"
    scrollTo : number @description "The page offset the last RASM_SCROLL_TO asked for." = 0
    scrollToN : number @description "Counts RASM_SCROLL_TO requests, so the canvas moves the page once per request." = 0
    hidden : [string] @description "The paint ids RASM_VISIBLE hid: their paints are kept and not drawn." = []
    leaving : [string] @description "The paint ids the last transitioning RASM_VISIBLE hid: drawn once more while they fade and slide out." = []
    entering : [string] @description "The paint ids the last transitioning RASM_VISIBLE showed: drawn fading and sliding in." = []
    movedMs : number @description "The epoch-ms instant the last RASM_VISIBLE arrived: the transition's start." = 0
    moveSign : number @description "1 when content travels toward the reading start (forward), -1 backward; flipped under rtl." = 1
    scrubs : Map string RasmScrubEntry @description "The scrubs RASM_SCRUB announced, by id: their paints play their keyframes at the page scroll." = {}
    scrollY : number @description "With pageScroll on, the offset the canvas last reported, in px." = 0
    breakpoints : [RasmBreakpoint] @description "The breakpoint table RASM_THEME announced, ascending by min." = []
    breakpoint : string @description "The breakpoint the last announced size is in, empty before the first size and the table are known." = ""
    sizedW : number @description "The width the canvas last reported, 0 before it did." = 0
    repaints : number @description "Counts repaints, so each repaint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    laidOut : boolean @description "True once the root child reports the extent it already has: the layout reached its fixed point, its sections placed and painted, and the canvas says so (ready)." = false
    focused : string @description "The control id the last RASM_FOCUS named, empty for none: the surface draws the two-tone focus ring around the paint node of that id." = ""
  }

  trait RasmSurface -> RasmSurfaceRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.viewW @config.width)
        (set @entity.viewH @config.height)
        (set @entity.root @config.rootRect)
        (set @entity.contentH @config.rootRect.h)
        (emit RASM_BOOT { })
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.layer (default ?layer { palette: {}, fonts: {} }))
        (set @entity.breakpoints (default ?breakpoints []))
        (when (> @entity.sizedW 0) (let ((hit (array/filter @entity.breakpoints (fn b (<= @b.min @entity.sizedW)))) (floor (let ((d (array/find @entity.breakpoints (fn b (= @b.name "desktop"))))) (if (= @d null) 0 @d.min)))) (when (and (> (array/len @hit) 0) (!= (object/get (array/last @hit) "name") @entity.breakpoint)) (do (set @entity.breakpoint (object/get (array/last @hit) "name")) (emit RASM_BREAKPOINT { name: (object/get (array/last @hit) "name"), width: @entity.sizedW, chain: (array/reverse (array/map (array/filter @hit (fn b (or (< (object/get (array/last @hit) "min") @floor) (>= @b.min @floor)))) (fn b @b.name))) })))))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_RESIZE -> ready when @config.fill
        (set @entity.viewW ?width)
        (set @entity.containerH ?height)
        (set @entity.viewH (if @config.pageScroll ?height (math/max ?height @config.minHeight @entity.fillMin)))
        (set @entity.root (let ((w (math/max 0 (- ?width (* 2 @config.margin)))) (h (math/max 0 (- ?height (* 2 @config.margin))))) (if (= @config.align "center") { x: (/ (- ?width (math/min @config.rootRect.w @w)) 2), y: (/ (- ?height (math/min @config.rootRect.h @h)) 2), w: (math/min @config.rootRect.w @w), h: (math/min @config.rootRect.h @h) } { x: @config.margin, y: @config.margin, w: @w, h: (math/max @h @entity.fillMin) })))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_RESIZE -> ready when (not @config.fill)
        (set @entity.viewW ?width)
        (set @entity.viewH (+ @entity.contentH (* 2 @config.margin)))
        (set @entity.root (let ((w (math/max 0 (- ?width (* 2 @config.margin))))) (let ((rw (if (= @config.align "center") (math/min @config.rootRect.w @w) @w))) { x: (if (= @config.align "center") (/ (- ?width @rw) 2) @config.margin), y: @config.margin, w: @rw, h: @entity.contentH })))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> ready when (and (not @config.fill) (= ?id @config.rootChild) (!= ?h @entity.contentH))
        (set @entity.contentH ?h)
        (set @entity.viewH (+ ?h (* 2 @config.margin)))
        (set @entity.root { x: @entity.root.x, y: @entity.root.y, w: @entity.root.w, h: ?h })
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> ready when (and @config.fill (= ?id @config.rootChild) (> (math/abs (- ?h @entity.fillMin)) 1))
        (set @entity.fillMin ?h)
        (set @entity.viewH (if @config.pageScroll @entity.containerH (math/max @entity.containerH @config.minHeight ?h)))
        (set @entity.root (if (= @config.align "center") @entity.root { x: @entity.root.x, y: @entity.root.y, w: @entity.root.w, h: (math/max (math/max 0 (- @entity.containerH (* 2 @config.margin))) ?h) }))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> ready when (not (or (and (not @config.fill) (= ?id @config.rootChild) (!= ?h @entity.contentH)) (and @config.fill (= ?id @config.rootChild) (> (math/abs (- ?h @entity.fillMin)) 1))))
        (set @entity.laidOut (or @entity.laidOut (= ?id @config.rootChild)))
      SURFACE_RESIZE -> ready
        (set @entity.sizedW ?width)
        (let ((hit (array/filter @entity.breakpoints (fn b (<= @b.min ?width)))) (floor (let ((d (array/find @entity.breakpoints (fn b (= @b.name "desktop"))))) (if (= @d null) 0 @d.min)))) (when (and (> (array/len @hit) 0) (!= (object/get (array/last @hit) "name") @entity.breakpoint)) (do (set @entity.breakpoint (object/get (array/last @hit) "name")) (emit RASM_BREAKPOINT { name: (object/get (array/last @hit) "name"), width: ?width, chain: (array/reverse (array/map (array/filter @hit (fn b (or (< (object/get (array/last @hit) "min") @floor) (>= @b.min @floor)))) (fn b @b.name))) }))))
        (emit RASM_RESIZE { width: ?width, height: ?height })
      SURFACE_TEXT -> ready
        (emit RASM_TEXT { target: ?target, text: ?text, composing: ?composing })
      SURFACE_KEY -> ready when (and (= ?key "Tab") (not ?shift))
        (emit RASM_KEY { key: "next" })
      SURFACE_KEY -> ready when (and (= ?key "Tab") ?shift)
        (emit RASM_KEY { key: "previous" })
      SURFACE_KEY -> ready when (!= ?key "Tab")
        (emit RASM_KEYPRESS { target: ?target, key: ?key, shift: ?shift, alt: ?alt, ctrl: ?ctrl, meta: ?meta })
      SURFACE_ACCESS -> ready
        (emit RASM_ACCESS { target: ?target, action: ?action })
      SURFACE_MOTION -> ready
        (emit RASM_MOTION { reduced: ?reduced })
      SURFACE_DIRECTION -> ready
        (set @entity.dir ?direction)
        (emit RASM_DIRECTION { direction: ?direction })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      SURFACE_WHEEL -> ready
        (emit RASM_WHEEL { target: ?target, x: ?x, y: ?y, dx: ?dx, dy: ?dy })
      SURFACE_SCROLLED -> ready
        (set @entity.scrollY ?offset)
        (emit RASM_PAGE_SCROLLED { offset: ?offset, max: ?max })
      RASM_FOCUS -> dirty
        (set @entity.focused ?id)
      RASM_PAINT -> dirty
        (set @entity.paints (object/set @entity.paints ?id { id: ?id, z: ?z, nodes: ?nodes, texts: (default ?texts []) }))
      RASM_SCRUB -> dirty
        (set @entity.scrubs (object/set @entity.scrubs ?id { id: ?id, paints: ?paints, from: ?from, to: ?to, keyframes: ?keyframes }))
      RASM_SCROLL_TO -> dirty
        (set @entity.scrollTo (math/max 0 ?y))
        (set @entity.scrollToN (+ @entity.scrollToN 1))
      RASM_VISIBLE -> dirty
        (let ((moves (and (> @config.transition.durationMs 0) (array/includes @config.transition.owners ?owner))) (in (array/filter ?shown (fn h (and (array/includes @entity.hidden @h) (not (array/includes @config.transition.still @h)))))) (out (array/filter ?hidden (fn h (not (or (array/includes @entity.hidden @h) (array/includes @config.transition.still @h)))))))
          (do
            (set @entity.entering (if (and @moves (> (array/len @out) 0)) @in []))
            (set @entity.leaving (if (and @moves (> (array/len @in) 0)) @out []))
            (set @entity.movedMs (time/epoch-ms @now))
            (set @entity.moveSign (* (if (= ?forward false) -1 1) (if (= @entity.dir "rtl") -1 1)))))
        (set @entity.hidden (array/concat (array/filter @entity.hidden (fn h (not (array/includes ?shown @h)))) (array/filter ?hidden (fn h (not (array/includes @entity.hidden @h))))))
        (emit RASM_HIDDEN { ids: @entity.hidden })
      SURFACE_REPAINT -> ready
        (render-ui main {
          type: canvas
          role: @config.landmark
          ready: @entity.laidOut
          mode: "2d"
          projection: "free"
          painter: "orbital"
          themeLayer: @entity.layer
          camera: { mode: "top-down", zoom: 1 }
          pointerMoves: "captured"
          fillContainer: (if @config.fill true "width")
          minHeight: (if @config.pageScroll 0 (math/max @config.minHeight @entity.fillMin))
          scroll: (if @config.pageScroll { height: (math/max @entity.viewH @entity.fillMin), event: "SURFACE_SCROLLED", reportMs: @config.scrollReportMs, to: { y: @entity.scrollTo, n: @entity.scrollToN } } null)
          worldWidth: @entity.viewW
          worldHeight: @entity.viewH
          resizeEvent: "SURFACE_RESIZE"
          textInputEvent: "SURFACE_TEXT"
          keyEvent: "SURFACE_KEY"
          accessEvent: "SURFACE_ACCESS"
          wheelEvent: "SURFACE_WHEEL"
          direction: (i18n/direction)
          directionEvent: "SURFACE_DIRECTION"
          motionEvent: "SURFACE_MOTION"
          pointerDownEvent: "POINTER_DOWN"
          pointerUpEvent: "POINTER_UP"
          pointerEnterEvent: "POINTER_ENTER"
          pointerLeaveEvent: "POINTER_LEAVE"
          pointerMoveEvent: "POINTER_MOVE"
          measureEvent: "SURFACE_MEASURED"
          keyMap: (object/merge { Tab: "KEY_NEXT", "Shift+Tab": "KEY_PREVIOUS", Enter: "KEY_ACTIVATE", Space: "KEY_ACTIVATE", ArrowRight: (if (= @entity.dir "rtl") "KEY_DECREASE" "KEY_INCREASE"), ArrowUp: "KEY_INCREASE", ArrowLeft: (if (= @entity.dir "rtl") "KEY_INCREASE" "KEY_DECREASE"), ArrowDown: "KEY_DECREASE", Escape: "KEY_ESCAPE", PageUp: "KEY_PAGE_UP", PageDown: "KEY_PAGE_DOWN", Home: "KEY_HOME", End: "KEY_END" } (array/reduce (array/range 0 (math/min 6 (array/len @config.hotkeys))) {} (fn acc i (object/set @acc (default (array/nth @config.hotkeys @i) "") (default (array/nth ["KEY_HOT_0", "KEY_HOT_1", "KEY_HOT_2", "KEY_HOT_3", "KEY_HOT_4", "KEY_HOT_5"] @i) "KEY_HOT_0")))))
          drawables: (array/concat (let ((g (object/get @entity.looks "surface/ground/idle" null))) (let ((made (array/map (array/filter (array/sort (object/values @entity.paints) "z" "asc") (fn e (or (not (array/includes @entity.hidden @e.id)) (array/includes @entity.leaving @e.id)))) (fn e { id: @e.id, items: (let ((raw (array/concat @e.nodes (array/map @e.texts (fn t (let ((said (default (let ((own (as (default @t.params {}) RasmTextParams))) (i18n/t @t.key (as (if (= @t.locale null) @own (object/set @own "locale" (default @t.locale ""))) RasmTextParams))) ""))) (let ((shown (if (= @t.vertical true) (str/join (array/map (array/range 0 (str/len @said)) (fn i (str/slice @said @i (+ @i 1)))) "\n") @said))) (let ((made : node { type: draw-text, id: @t.id, text: @shown, anchor: "top-left", position: { x: @t.x, y: @t.y, z: @t.z }, align: @t.align, baseline: @t.baseline, color: @t.color, font: @t.font, spring: @t.spring, width: @t.width, wrap: @t.wrap, measure: @t.measure, animation: @t.animation, reveal: @t.reveal, maxWidth: @t.maxWidth, height: @t.height, fit: @t.fit, minSize: @t.minSize, halo: @t.halo, hit: false, semantic: (if (= @t.role null) null { role: @t.role, name: @said, level: @t.level, order: (+ @t.y (/ (if (= @entity.dir "rtl") (- 0 @t.x) @t.x) 10000)) }) })) (let ((inner : node (if (or (= @t.rotate null) (= @t.rotate 0)) @made { type: draw-group, id: (str/concat @t.id ":rotate"), position: { x: (default @t.pivotX @t.x), y: (default @t.pivotY @t.y) }, rotate: @t.rotate, items: [{ type: draw-group, id: (str/concat @t.id ":origin"), position: { x: (- 0 (default @t.pivotX @t.x)), y: (- 0 (default @t.pivotY @t.y)) }, items: [@made] }] }))) (if (and (= @t.clip null) (= @t.travel null)) @inner { type: draw-group, id: (str/concat @t.id ":frame"), position: { x: 0, y: 0 }, clip: @t.clip, items: [(if (= @t.travel null) @inner { type: draw-group, id: (str/concat @t.id ":travel"), position: { x: 0, y: 0 }, animation: @t.travel, items: [@inner] })] }))))))))) (far (* @entity.moveSign @config.transition.distance)) (dur @config.transition.durationMs)) (if (array/includes @entity.leaving @e.id) [{ type: draw-group, id: (str/concat @config.id ":leave:" @e.id), position: { x: 0, y: 0 }, animation: { startMs: @entity.movedMs, durationMs: @dur, loop: false, keyframes: [{ at: 0, opacity: 1, offsetX: 0 }, { at: 0.98, opacity: 0, offsetX: (- 0 @far) }, { at: 1, opacity: 0, offsetX: (- 0 (* @entity.moveSign (* 4 @entity.viewW))) }] }, items: @raw }] (if (array/includes @entity.entering @e.id) (let ((wait (* (array/indexOf @entity.entering @e.id) @config.transition.staggerMs))) [{ type: draw-group, id: (str/concat @config.id ":enter:" @e.id), position: { x: 0, y: 0 }, animation: { startMs: @entity.movedMs, durationMs: (+ @dur @wait), loop: false, keyframes: [{ at: 0, opacity: 0, offsetX: @far }, { at: (/ @wait (+ @dur @wait)), opacity: 0, offsetX: @far }, { at: 1, opacity: 1, offsetX: 0 }] }, items: @raw }]) @raw))) }))) (tid (array/flatten (array/map @config.targets (fn t @t.fragments))))) (array/concat (array/map @config.targets (fn t { type: draw-group, id: (str/concat @config.id ":target:" @t.id), position: { x: 0, y: 0 }, target: { id: @t.id, width: (math/max 1 (math/ceil @entity.viewW)), height: (math/max 1 (math/ceil (if @config.pageScroll (math/max @entity.viewH @entity.fillMin) @entity.viewH))) }, items: (array/flatten (array/map (array/filter @made (fn m (array/includes @t.fragments @m.id))) (fn m @m.items))) })) (if (= @g null) [] [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":ground"), position: { x: 0, y: 0 }, anchor: "top-left", width: @entity.viewW, height: @entity.viewH, fill: @g.fill, material: @g.material, spring: @g.spring, hit: false, fixed: @config.pageScroll }]) (array/flatten (array/map (array/filter @made (fn m (not (array/includes @tid @m.id)))) (fn m (let ((sc (array/find (object/values @entity.scrubs) (fn s (array/includes @s.paints @m.id))))) (let ((its (if (= @sc null) @m.items (let ((moved : [node] [{ type: draw-group, id: (str/concat @config.id ":scrub:" @m.id), position: { x: 0, y: 0 }, animation: { clock: "scroll", from: (default @sc.from 0), to: (default @sc.to 0), keyframes: (default @sc.keyframes []) }, items: @m.items }])) @moved)))) (if (and (array/includes @config.fixed @m.id) (or (= (array/len @config.fixedOn) 0) (array/includes @config.fixedOn @entity.breakpoint))) (let ((pinned : [node] [{ type: draw-group, id: (str/concat @config.id ":fixed:" @m.id), position: { x: 0, y: 0 }, fixed: true, items: @its }])) @pinned) @its))))))))) (let ((fe (array/find (array/flatten (array/map (array/filter (object/values @entity.paints) (fn e (not (array/includes @entity.hidden @e.id)))) (fn e @e.nodes))) (fn n (= (let ((b (as @n RasmRingBox))) @b.id) @entity.focused)))) (ro (object/get @entity.looks "focus/ring/outer" null)) (ri (object/get @entity.looks "focus/ring/inner" null))) (if (or (= @fe null) (= @ro null) (= @ri null)) [] (let ((b (as @fe RasmRingBox))) (let ((cn (default @b.corners { radius: [0, 0, 0, 0], kind: "round" }))) (array/map [{ d: 4, l: @ro, k: "outer" }, { d: 2, l: @ri, k: "inner" }] (fn s { type: draw-shape, id: (str/concat @config.id ":focus:" @s.k), shape: "rect", anchor: "top-left", position: { x: (- @b.position.x @s.d), y: (- @b.position.y @s.d), z: @b.position.z }, width: (+ (default @b.width 0) (* 2 @s.d)), height: (+ (default @b.height 0) (* 2 @s.d)), stroke: @s.l.stroke, strokeWidth: @s.l.strokeWidth, corners: { radius: (array/map (default @cn.radius [0, 0, 0, 0]) (fn r (+ @r @s.d))), kind: (default @cn.kind "round") }, hit: false })))))))
        })
      POINTER_DOWN -> ready
        (emit RASM_POINTER { kind: "down", id: ?target, x: ?x, y: ?y, index: (default ?index -1) })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "down", id: ?target, touches: ?touches }))
      POINTER_UP -> ready
        (emit RASM_POINTER { kind: "up", id: ?target, x: ?x, y: ?y })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "up", id: ?target, touches: ?touches }))
      POINTER_ENTER -> ready
        (emit RASM_POINTER { kind: "enter", id: ?target, x: ?x, y: ?y })
      POINTER_LEAVE -> ready
        (emit RASM_POINTER { kind: "leave", id: ?target, x: ?x, y: ?y })
      POINTER_MOVE -> ready
        (emit RASM_POINTER { kind: "move", id: ?target, x: ?x, y: ?y })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "move", id: ?target, touches: ?touches }))
      SURFACE_MEASURED -> ready
        (emit RASM_MEASURED { items: ?items })
      KEY_NEXT -> ready
        (emit RASM_KEY { key: "next" })
      KEY_PREVIOUS -> ready
        (emit RASM_KEY { key: "previous" })
      KEY_ACTIVATE -> ready
        (emit RASM_KEY { key: "activate" })
      KEY_INCREASE -> ready
        (emit RASM_KEY { key: "increase" })
      KEY_DECREASE -> ready
        (emit RASM_KEY { key: "decrease" })
      KEY_ESCAPE -> ready
        (emit RASM_KEY { key: "escape" })
      KEY_PAGE_UP -> ready
        (emit RASM_KEY { key: "pageUp" })
      KEY_PAGE_DOWN -> ready
        (emit RASM_KEY { key: "pageDown" })
      KEY_HOME -> ready
        (emit RASM_KEY { key: "home" })
      KEY_END -> ready
        (emit RASM_KEY { key: "end" })
      KEY_HOT_0 -> ready
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 0) "") })
      KEY_HOT_1 -> ready
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 1) "") })
      KEY_HOT_2 -> ready
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 2) "") })
      KEY_HOT_3 -> ready
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 3) "") })
      KEY_HOT_4 -> ready
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 4) "") })
      KEY_HOT_5 -> ready
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 5) "") })
    }

    state dirty {
      INIT -> dirty
        (set @entity.viewW @config.width)
        (set @entity.viewH @config.height)
        (set @entity.root @config.rootRect)
        (set @entity.contentH @config.rootRect.h)
        (emit RASM_BOOT { })
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_THEME -> dirty
        (set @entity.looks ?looks)
        (set @entity.layer (default ?layer { palette: {}, fonts: {} }))
        (set @entity.breakpoints (default ?breakpoints []))
        (when (> @entity.sizedW 0) (let ((hit (array/filter @entity.breakpoints (fn b (<= @b.min @entity.sizedW)))) (floor (let ((d (array/find @entity.breakpoints (fn b (= @b.name "desktop"))))) (if (= @d null) 0 @d.min)))) (when (and (> (array/len @hit) 0) (!= (object/get (array/last @hit) "name") @entity.breakpoint)) (do (set @entity.breakpoint (object/get (array/last @hit) "name")) (emit RASM_BREAKPOINT { name: (object/get (array/last @hit) "name"), width: @entity.sizedW, chain: (array/reverse (array/map (array/filter @hit (fn b (or (< (object/get (array/last @hit) "min") @floor) (>= @b.min @floor)))) (fn b @b.name))) })))))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_RESIZE -> dirty when @config.fill
        (set @entity.viewW ?width)
        (set @entity.containerH ?height)
        (set @entity.viewH (if @config.pageScroll ?height (math/max ?height @config.minHeight @entity.fillMin)))
        (set @entity.root (let ((w (math/max 0 (- ?width (* 2 @config.margin)))) (h (math/max 0 (- ?height (* 2 @config.margin))))) (if (= @config.align "center") { x: (/ (- ?width (math/min @config.rootRect.w @w)) 2), y: (/ (- ?height (math/min @config.rootRect.h @h)) 2), w: (math/min @config.rootRect.w @w), h: (math/min @config.rootRect.h @h) } { x: @config.margin, y: @config.margin, w: @w, h: (math/max @h @entity.fillMin) })))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_RESIZE -> dirty when (not @config.fill)
        (set @entity.viewW ?width)
        (set @entity.viewH (+ @entity.contentH (* 2 @config.margin)))
        (set @entity.root (let ((w (math/max 0 (- ?width (* 2 @config.margin))))) (let ((rw (if (= @config.align "center") (math/min @config.rootRect.w @w) @w))) { x: (if (= @config.align "center") (/ (- ?width @rw) 2) @config.margin), y: @config.margin, w: @rw, h: @entity.contentH })))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> dirty when (and (not @config.fill) (= ?id @config.rootChild) (!= ?h @entity.contentH))
        (set @entity.contentH ?h)
        (set @entity.viewH (+ ?h (* 2 @config.margin)))
        (set @entity.root { x: @entity.root.x, y: @entity.root.y, w: @entity.root.w, h: ?h })
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> dirty when (and @config.fill (= ?id @config.rootChild) (> (math/abs (- ?h @entity.fillMin)) 1))
        (set @entity.fillMin ?h)
        (set @entity.viewH (if @config.pageScroll @entity.containerH (math/max @entity.containerH @config.minHeight ?h)))
        (set @entity.root (if (= @config.align "center") @entity.root { x: @entity.root.x, y: @entity.root.y, w: @entity.root.w, h: (math/max (math/max 0 (- @entity.containerH (* 2 @config.margin))) ?h) }))
        (emit RASM_PLACE { n: @entity.repaints, placed: [{ id: @config.rootChild, rect: @entity.root }] })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      RASM_EXTENT -> dirty when (not (or (and (not @config.fill) (= ?id @config.rootChild) (!= ?h @entity.contentH)) (and @config.fill (= ?id @config.rootChild) (> (math/abs (- ?h @entity.fillMin)) 1))))
        (set @entity.laidOut (or @entity.laidOut (= ?id @config.rootChild)))
      SURFACE_RESIZE -> dirty
        (set @entity.sizedW ?width)
        (let ((hit (array/filter @entity.breakpoints (fn b (<= @b.min ?width)))) (floor (let ((d (array/find @entity.breakpoints (fn b (= @b.name "desktop"))))) (if (= @d null) 0 @d.min)))) (when (and (> (array/len @hit) 0) (!= (object/get (array/last @hit) "name") @entity.breakpoint)) (do (set @entity.breakpoint (object/get (array/last @hit) "name")) (emit RASM_BREAKPOINT { name: (object/get (array/last @hit) "name"), width: ?width, chain: (array/reverse (array/map (array/filter @hit (fn b (or (< (object/get (array/last @hit) "min") @floor) (>= @b.min @floor)))) (fn b @b.name))) }))))
        (emit RASM_RESIZE { width: ?width, height: ?height })
      SURFACE_TEXT -> dirty
        (emit RASM_TEXT { target: ?target, text: ?text, composing: ?composing })
      SURFACE_KEY -> dirty when (and (= ?key "Tab") (not ?shift))
        (emit RASM_KEY { key: "next" })
      SURFACE_KEY -> dirty when (and (= ?key "Tab") ?shift)
        (emit RASM_KEY { key: "previous" })
      SURFACE_KEY -> dirty when (!= ?key "Tab")
        (emit RASM_KEYPRESS { target: ?target, key: ?key, shift: ?shift, alt: ?alt, ctrl: ?ctrl, meta: ?meta })
      SURFACE_ACCESS -> dirty
        (emit RASM_ACCESS { target: ?target, action: ?action })
      SURFACE_MOTION -> dirty
        (emit RASM_MOTION { reduced: ?reduced })
      SURFACE_DIRECTION -> dirty
        (set @entity.dir ?direction)
        (emit RASM_DIRECTION { direction: ?direction })
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
      SURFACE_WHEEL -> dirty
        (emit RASM_WHEEL { target: ?target, x: ?x, y: ?y, dx: ?dx, dy: ?dy })
      SURFACE_SCROLLED -> dirty
        (set @entity.scrollY ?offset)
        (emit RASM_PAGE_SCROLLED { offset: ?offset, max: ?max })
      RASM_FOCUS -> dirty
        (set @entity.focused ?id)
      RASM_PAINT -> dirty
        (set @entity.paints (object/set @entity.paints ?id { id: ?id, z: ?z, nodes: ?nodes, texts: (default ?texts []) }))
      RASM_SCRUB -> dirty
        (set @entity.scrubs (object/set @entity.scrubs ?id { id: ?id, paints: ?paints, from: ?from, to: ?to, keyframes: ?keyframes }))
      RASM_SCROLL_TO -> dirty
        (set @entity.scrollTo (math/max 0 ?y))
        (set @entity.scrollToN (+ @entity.scrollToN 1))
      RASM_VISIBLE -> dirty
        (let ((moves (and (> @config.transition.durationMs 0) (array/includes @config.transition.owners ?owner))) (in (array/filter ?shown (fn h (and (array/includes @entity.hidden @h) (not (array/includes @config.transition.still @h)))))) (out (array/filter ?hidden (fn h (not (or (array/includes @entity.hidden @h) (array/includes @config.transition.still @h)))))))
          (do
            (set @entity.entering (if (and @moves (> (array/len @out) 0)) @in []))
            (set @entity.leaving (if (and @moves (> (array/len @in) 0)) @out []))
            (set @entity.movedMs (time/epoch-ms @now))
            (set @entity.moveSign (* (if (= ?forward false) -1 1) (if (= @entity.dir "rtl") -1 1)))))
        (set @entity.hidden (array/concat (array/filter @entity.hidden (fn h (not (array/includes ?shown @h)))) (array/filter ?hidden (fn h (not (array/includes @entity.hidden @h))))))
        (emit RASM_HIDDEN { ids: @entity.hidden })
      SURFACE_REPAINT -> ready
        (render-ui main {
          type: canvas
          role: @config.landmark
          ready: @entity.laidOut
          mode: "2d"
          projection: "free"
          painter: "orbital"
          themeLayer: @entity.layer
          camera: { mode: "top-down", zoom: 1 }
          pointerMoves: "captured"
          fillContainer: (if @config.fill true "width")
          minHeight: (if @config.pageScroll 0 (math/max @config.minHeight @entity.fillMin))
          scroll: (if @config.pageScroll { height: (math/max @entity.viewH @entity.fillMin), event: "SURFACE_SCROLLED", reportMs: @config.scrollReportMs, to: { y: @entity.scrollTo, n: @entity.scrollToN } } null)
          worldWidth: @entity.viewW
          worldHeight: @entity.viewH
          resizeEvent: "SURFACE_RESIZE"
          textInputEvent: "SURFACE_TEXT"
          keyEvent: "SURFACE_KEY"
          accessEvent: "SURFACE_ACCESS"
          wheelEvent: "SURFACE_WHEEL"
          direction: (i18n/direction)
          directionEvent: "SURFACE_DIRECTION"
          motionEvent: "SURFACE_MOTION"
          pointerDownEvent: "POINTER_DOWN"
          pointerUpEvent: "POINTER_UP"
          pointerEnterEvent: "POINTER_ENTER"
          pointerLeaveEvent: "POINTER_LEAVE"
          pointerMoveEvent: "POINTER_MOVE"
          measureEvent: "SURFACE_MEASURED"
          keyMap: (object/merge { Tab: "KEY_NEXT", "Shift+Tab": "KEY_PREVIOUS", Enter: "KEY_ACTIVATE", Space: "KEY_ACTIVATE", ArrowRight: (if (= @entity.dir "rtl") "KEY_DECREASE" "KEY_INCREASE"), ArrowUp: "KEY_INCREASE", ArrowLeft: (if (= @entity.dir "rtl") "KEY_INCREASE" "KEY_DECREASE"), ArrowDown: "KEY_DECREASE", Escape: "KEY_ESCAPE", PageUp: "KEY_PAGE_UP", PageDown: "KEY_PAGE_DOWN", Home: "KEY_HOME", End: "KEY_END" } (array/reduce (array/range 0 (math/min 6 (array/len @config.hotkeys))) {} (fn acc i (object/set @acc (default (array/nth @config.hotkeys @i) "") (default (array/nth ["KEY_HOT_0", "KEY_HOT_1", "KEY_HOT_2", "KEY_HOT_3", "KEY_HOT_4", "KEY_HOT_5"] @i) "KEY_HOT_0")))))
          drawables: (array/concat (let ((g (object/get @entity.looks "surface/ground/idle" null))) (let ((made (array/map (array/filter (array/sort (object/values @entity.paints) "z" "asc") (fn e (or (not (array/includes @entity.hidden @e.id)) (array/includes @entity.leaving @e.id)))) (fn e { id: @e.id, items: (let ((raw (array/concat @e.nodes (array/map @e.texts (fn t (let ((said (default (let ((own (as (default @t.params {}) RasmTextParams))) (i18n/t @t.key (as (if (= @t.locale null) @own (object/set @own "locale" (default @t.locale ""))) RasmTextParams))) ""))) (let ((shown (if (= @t.vertical true) (str/join (array/map (array/range 0 (str/len @said)) (fn i (str/slice @said @i (+ @i 1)))) "\n") @said))) (let ((made : node { type: draw-text, id: @t.id, text: @shown, anchor: "top-left", position: { x: @t.x, y: @t.y, z: @t.z }, align: @t.align, baseline: @t.baseline, color: @t.color, font: @t.font, spring: @t.spring, width: @t.width, wrap: @t.wrap, measure: @t.measure, animation: @t.animation, reveal: @t.reveal, maxWidth: @t.maxWidth, height: @t.height, fit: @t.fit, minSize: @t.minSize, halo: @t.halo, hit: false, semantic: (if (= @t.role null) null { role: @t.role, name: @said, level: @t.level, order: (+ @t.y (/ (if (= @entity.dir "rtl") (- 0 @t.x) @t.x) 10000)) }) })) (let ((inner : node (if (or (= @t.rotate null) (= @t.rotate 0)) @made { type: draw-group, id: (str/concat @t.id ":rotate"), position: { x: (default @t.pivotX @t.x), y: (default @t.pivotY @t.y) }, rotate: @t.rotate, items: [{ type: draw-group, id: (str/concat @t.id ":origin"), position: { x: (- 0 (default @t.pivotX @t.x)), y: (- 0 (default @t.pivotY @t.y)) }, items: [@made] }] }))) (if (and (= @t.clip null) (= @t.travel null)) @inner { type: draw-group, id: (str/concat @t.id ":frame"), position: { x: 0, y: 0 }, clip: @t.clip, items: [(if (= @t.travel null) @inner { type: draw-group, id: (str/concat @t.id ":travel"), position: { x: 0, y: 0 }, animation: @t.travel, items: [@inner] })] }))))))))) (far (* @entity.moveSign @config.transition.distance)) (dur @config.transition.durationMs)) (if (array/includes @entity.leaving @e.id) [{ type: draw-group, id: (str/concat @config.id ":leave:" @e.id), position: { x: 0, y: 0 }, animation: { startMs: @entity.movedMs, durationMs: @dur, loop: false, keyframes: [{ at: 0, opacity: 1, offsetX: 0 }, { at: 0.98, opacity: 0, offsetX: (- 0 @far) }, { at: 1, opacity: 0, offsetX: (- 0 (* @entity.moveSign (* 4 @entity.viewW))) }] }, items: @raw }] (if (array/includes @entity.entering @e.id) (let ((wait (* (array/indexOf @entity.entering @e.id) @config.transition.staggerMs))) [{ type: draw-group, id: (str/concat @config.id ":enter:" @e.id), position: { x: 0, y: 0 }, animation: { startMs: @entity.movedMs, durationMs: (+ @dur @wait), loop: false, keyframes: [{ at: 0, opacity: 0, offsetX: @far }, { at: (/ @wait (+ @dur @wait)), opacity: 0, offsetX: @far }, { at: 1, opacity: 1, offsetX: 0 }] }, items: @raw }]) @raw))) }))) (tid (array/flatten (array/map @config.targets (fn t @t.fragments))))) (array/concat (array/map @config.targets (fn t { type: draw-group, id: (str/concat @config.id ":target:" @t.id), position: { x: 0, y: 0 }, target: { id: @t.id, width: (math/max 1 (math/ceil @entity.viewW)), height: (math/max 1 (math/ceil (if @config.pageScroll (math/max @entity.viewH @entity.fillMin) @entity.viewH))) }, items: (array/flatten (array/map (array/filter @made (fn m (array/includes @t.fragments @m.id))) (fn m @m.items))) })) (if (= @g null) [] [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":ground"), position: { x: 0, y: 0 }, anchor: "top-left", width: @entity.viewW, height: @entity.viewH, fill: @g.fill, material: @g.material, spring: @g.spring, hit: false, fixed: @config.pageScroll }]) (array/flatten (array/map (array/filter @made (fn m (not (array/includes @tid @m.id)))) (fn m (let ((sc (array/find (object/values @entity.scrubs) (fn s (array/includes @s.paints @m.id))))) (let ((its (if (= @sc null) @m.items (let ((moved : [node] [{ type: draw-group, id: (str/concat @config.id ":scrub:" @m.id), position: { x: 0, y: 0 }, animation: { clock: "scroll", from: (default @sc.from 0), to: (default @sc.to 0), keyframes: (default @sc.keyframes []) }, items: @m.items }])) @moved)))) (if (and (array/includes @config.fixed @m.id) (or (= (array/len @config.fixedOn) 0) (array/includes @config.fixedOn @entity.breakpoint))) (let ((pinned : [node] [{ type: draw-group, id: (str/concat @config.id ":fixed:" @m.id), position: { x: 0, y: 0 }, fixed: true, items: @its }])) @pinned) @its))))))))) (let ((fe (array/find (array/flatten (array/map (array/filter (object/values @entity.paints) (fn e (not (array/includes @entity.hidden @e.id)))) (fn e @e.nodes))) (fn n (= (let ((b (as @n RasmRingBox))) @b.id) @entity.focused)))) (ro (object/get @entity.looks "focus/ring/outer" null)) (ri (object/get @entity.looks "focus/ring/inner" null))) (if (or (= @fe null) (= @ro null) (= @ri null)) [] (let ((b (as @fe RasmRingBox))) (let ((cn (default @b.corners { radius: [0, 0, 0, 0], kind: "round" }))) (array/map [{ d: 4, l: @ro, k: "outer" }, { d: 2, l: @ri, k: "inner" }] (fn s { type: draw-shape, id: (str/concat @config.id ":focus:" @s.k), shape: "rect", anchor: "top-left", position: { x: (- @b.position.x @s.d), y: (- @b.position.y @s.d), z: @b.position.z }, width: (+ (default @b.width 0) (* 2 @s.d)), height: (+ (default @b.height 0) (* 2 @s.d)), stroke: @s.l.stroke, strokeWidth: @s.l.strokeWidth, corners: { radius: (array/map (default @cn.radius [0, 0, 0, 0]) (fn r (+ @r @s.d))), kind: (default @cn.kind "round") }, hit: false })))))))
        })
      POINTER_DOWN -> dirty
        (emit RASM_POINTER { kind: "down", id: ?target, x: ?x, y: ?y, index: (default ?index -1) })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "down", id: ?target, touches: ?touches }))
      POINTER_UP -> dirty
        (emit RASM_POINTER { kind: "up", id: ?target, x: ?x, y: ?y })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "up", id: ?target, touches: ?touches }))
      POINTER_ENTER -> dirty
        (emit RASM_POINTER { kind: "enter", id: ?target, x: ?x, y: ?y })
      POINTER_LEAVE -> dirty
        (emit RASM_POINTER { kind: "leave", id: ?target, x: ?x, y: ?y })
      POINTER_MOVE -> dirty
        (emit RASM_POINTER { kind: "move", id: ?target, x: ?x, y: ?y })
        (when (> (array/len (default ?touches [])) 0) (emit RASM_TOUCHES { kind: "move", id: ?target, touches: ?touches }))
      SURFACE_MEASURED -> dirty
        (emit RASM_MEASURED { items: ?items })
      KEY_NEXT -> dirty
        (emit RASM_KEY { key: "next" })
      KEY_PREVIOUS -> dirty
        (emit RASM_KEY { key: "previous" })
      KEY_ACTIVATE -> dirty
        (emit RASM_KEY { key: "activate" })
      KEY_INCREASE -> dirty
        (emit RASM_KEY { key: "increase" })
      KEY_DECREASE -> dirty
        (emit RASM_KEY { key: "decrease" })
      KEY_ESCAPE -> dirty
        (emit RASM_KEY { key: "escape" })
      KEY_PAGE_UP -> dirty
        (emit RASM_KEY { key: "pageUp" })
      KEY_PAGE_DOWN -> dirty
        (emit RASM_KEY { key: "pageDown" })
      KEY_HOME -> dirty
        (emit RASM_KEY { key: "home" })
      KEY_END -> dirty
        (emit RASM_KEY { key: "end" })
      KEY_HOT_0 -> dirty
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 0) "") })
      KEY_HOT_1 -> dirty
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 1) "") })
      KEY_HOT_2 -> dirty
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 2) "") })
      KEY_HOT_3 -> dirty
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 3) "") })
      KEY_HOT_4 -> dirty
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 4) "") })
      KEY_HOT_5 -> dirty
        (emit RASM_HOTKEY { code: (default (array/nth @config.hotkeys 5) "") })
    }

    ticks {
      flush every "frame" in dirty
        (set @entity.repaints (+ @entity.repaints 1))
        (emit SURFACE_REPAINT { n: @entity.repaints })
    }

    emits {
      RASM_HIDDEN -> external {
        ids : [string]!
      }
        @description "After each RASM_VISIBLE: every paint id now hidden, so keyboard focus can skip controls that are not drawn."
        @tier "domain"
      RASM_BOOT -> external { }
        @description "The surface mounted: the theme and the entry choreography start from it."
        @tier "domain"
      SURFACE_REPAINT -> internal {
        n : number!
      }
        @description "Repaint the canvas from the collected paints."
        @tier "internal"
      RASM_PLACE -> external {
        n : number!
        placed : [RasmPlaced]!
      }
        @description "The root rect for the layout tree."
        @tier "primary"
      RASM_POINTER -> external {
        kind : "down" | "up" | "enter" | "leave" | "move"!
        id : string!
        x : number!
        y : number!
        index : number
      }
        @description "A canvas pointer event for the control that owns the id; a press on a text carries the caret index nearest it, -1 elsewhere."
        @tier "primary"
      RASM_MEASURED -> external {
        items : [RasmMeasureItem]!
      }
        @description "Sizes of the measured texts."
        @tier "primary"
      RASM_RESIZE -> external {
        width : number!
        height : number!
      }
        @description "The canvas size in CSS pixels; the root rect is placed from it."
        @tier "primary"
      RASM_TEXT -> external {
        target : string!
        text : string!
        composing : boolean!
      }
        @description "Committed or preedit text for the focused text field."
        @tier "primary"
      RASM_KEYPRESS -> external {
        target : string!
        key : string!
        shift : boolean!
        alt : boolean!
        ctrl : boolean!
        meta : boolean!
      }
        @description "An editing key for the focused text field or Choice."
        @tier "primary"
      RASM_TOUCHES -> external {
        kind : "down" | "up" | "move"!
        id : string!
        touches : [RasmTouch]!
      }
        @description "The pointers held down while a multi-touch gesture is in progress, in ascending pointerId, with the hit region they started on; a single pointer never sends it."
        @tier "primary"
      RASM_WHEEL -> external {
        target : string!
        x : number!
        y : number!
        dx : number!
        dy : number!
      }
        @description "The wheel turned over the surface: the topmost hit region under the pointer (empty for none), the point, and the scroll in px."
        @tier "primary"
      RASM_ACCESS -> external {
        target : string!
        action : "focus" | "activate" | "increment" | "decrement"!
      }
        @description "An assistive technology acted on a node of the semantic tree."
        @tier "primary"
      RASM_KEY -> external {
        key : "next" | "previous" | "activate" | "increase" | "decrease" | "escape" | "pageUp" | "pageDown" | "home" | "end"!
      }
        @description "A keyboard intent from the canvas key map; a key a focused text field or combobox handled never reaches it."
        @tier "primary"
      RASM_HOTKEY -> external {
        code : string!
      }
        @description "One of the page's `hotkeys` was pressed, named by its key code."
        @tier "primary"
      RASM_BREAKPOINT -> external {
        name : "phone" | "tablet" | "desktop" | "wide"!
        width : number!
        chain : [string]!
      }
        @description "The canvas entered a breakpoint of the theme's table: the entry with the greatest min not above its width. Sent on the first size (or the first table, if later) and only when the name changes, never on a resize that stays inside one. chain lists this name, then each smaller declared name, so a layout atom without a variant for the name takes the next smaller one; at desktop and wide it stops at desktop (the desktop composition is the configured one, a wide surface never takes the phone or tablet variant). With no desktop entry in the table it runs down to the smallest."
        @tier "primary"
      RASM_DIRECTION -> external {
        direction : "ltr" | "rtl"!
      }
        @description "The surface's reading direction, announced once before the root is placed."
        @tier "primary"
      RASM_MOTION -> external {
        reduced : boolean!
      }
        @description "The viewer's reduced-motion preference, relayed from the canvas once and on change, for atoms whose motion runs in logic (a tween, a typed reveal)."
        @tier "primary"
      RASM_PAGE_SCROLLED -> external {
        offset : number!
        max : number!
      }
        @description "With pageScroll on, how far the page is scrolled in px and the furthest it goes: at most once per scrollReportMs while it moves, and once when it rests."
        @tier "primary"
    }

    listens {
      RASM_THEME { name : string!  looks : Map string RasmLook!  breakpoints : [RasmBreakpoint]  layer : RasmThemeLayer }
        @description "Store the looks and the breakpoint table, paint the ground and place the root; with a canvas size known, announce the breakpoint the new table puts it in."
      RASM_FOCUS { id : string! }
        @description "Take the focused control id; the surface draws the focus ring (focus/ring/outer then focus/ring/inner, 4px and 2px outside the control rect, the corner radius grown by the offset) around the paint node whose id it is, above every other drawable."
      RASM_PAINT { id : string!  z : number!  nodes : [node]!  texts : [RasmText]  n : number }
        @description "Keep one control's nodes and its catalog-keyed texts at its z and repaint; each text is painted in the active locale."
      RASM_SCRUB { id : string!  paints : [string]!  from : number!  to : number!  keyframes : [RasmScrubFrame]! }
        @description "Play these paints' keyframes at the page scroll between from and to (px); the same id replaces an earlier scrub."
      RASM_VISIBLE { owner : string!  shown : [string]!  hidden : [string]!  forward : boolean }
        @description "Stop drawing the paints of the hidden ids and draw the shown ids again; the paints are kept. When the owner is listed in `transition.owners` and the call swaps shown content for hidden content, the hidden ids fade and slide out and the shown ids fade and slide in, one after another, toward the reading start (or away from it when forward is false)."
      RASM_SCROLL_TO { y : number! }
        @description "Move the page to this offset in px (a contents link, a tab, a section link); clamped to the content by the canvas."
      RASM_RESIZE { width : number!  height : number! }
        @description "Re-place the root from the new size."
      RASM_EXTENT { id : string!  w : number!  h : number!  n : number }
        @description "The root's content size: unless fill is on, the canvas height follows it so the page scrolls past a long surface; with fill on, the canvas is at least that tall."
      SURFACE_RESIZE { width : number!  height : number! }
        @description "Canvas size in CSS pixels."
      SURFACE_TEXT { target : string!  text : string!  composing : boolean! }
        @description "Text for the focused text field."
      SURFACE_KEY { target : string!  key : string!  shift : boolean!  alt : boolean!  ctrl : boolean!  meta : boolean! }
        @description "An editing key for the focused text field."
      SURFACE_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The page locale's reading direction, reported by the canvas once and on change."
      SURFACE_MOTION { reduced : boolean! }
        @description "The viewer's reduced-motion preference (the OS or browser setting), reported by the canvas once and on change."
      SURFACE_WHEEL { target : string!  x : number!  y : number!  dx : number!  dy : number! }
        @description "The canvas wheel, in CSS pixels."
      SURFACE_SCROLLED { offset : number!  max : number! }
        @description "The canvas page scroll, reported by the canvas."
      SURFACE_ACCESS { target : string!  action : "focus" | "activate" | "increment" | "decrement"! }
        @description "An assistive-technology action on a semantic node."
      POINTER_DOWN { target : string!  x : number!  y : number!  index : number  touches : [RasmTouch] }
        @description "Canvas press on a hit drawable."
      POINTER_UP { target : string!  x : number!  y : number!  touches : [RasmTouch] }
        @description "Canvas release, sent to the drawable that took the press."
      POINTER_ENTER { target : string!  x : number!  y : number! }
        @description "Canvas pointer entered a hit drawable."
      POINTER_LEAVE { target : string!  x : number!  y : number! }
        @description "Canvas pointer left a hit drawable."
      POINTER_MOVE { target : string!  x : number!  y : number!  touches : [RasmTouch] }
        @description "Canvas pointer moved over a hit drawable or under capture."
      SURFACE_MEASURED { items : [RasmMeasureItem]! }
        @description "Canvas text measurements."
      KEY_NEXT { }
        @description "Tab pressed."
      KEY_PREVIOUS { }
        @description "Shift+Tab pressed."
      KEY_ACTIVATE { }
        @description "Enter or Space pressed."
      KEY_INCREASE { }
        @description "ArrowRight or ArrowUp pressed."
      KEY_DECREASE { }
        @description "ArrowLeft or ArrowDown pressed."
      KEY_ESCAPE { }
        @description "Escape pressed."
      KEY_PAGE_UP { }
        @description "PageUp pressed."
      KEY_PAGE_DOWN { }
        @description "PageDown pressed."
      KEY_HOME { }
        @description "Home pressed."
      KEY_END { }
        @description "End pressed."
      KEY_HOT_0 { }
        @description "The hot key in place 0 of `hotkeys` was pressed."
      KEY_HOT_1 { }
        @description "The hot key in place 1 of `hotkeys` was pressed."
      KEY_HOT_2 { }
        @description "The hot key in place 2 of `hotkeys` was pressed."
      KEY_HOT_3 { }
        @description "The hot key in place 3 of `hotkeys` was pressed."
      KEY_HOT_4 { }
        @description "The hot key in place 4 of `hotkeys` was pressed."
      KEY_HOT_5 { }
        @description "The hot key in place 5 of `hotkeys` was pressed."
    }

    config {
      id : string = "rasm"
        @label "Id"
        @description "The surface's id; the ground drawable is `<id>:ground`."
        @tier "presentation"
      width : number = 720
        @label "Width"
        @description "Canvas width in px until the container reports its width."
        @tier "presentation"
      height : number = 520
        @label "Height"
        @description "Canvas height in px until the root reports its content height (or, with fill on, the container its height)."
        @tier "presentation"
      rootChild : string = "root"
        @label "Root child"
        @description "The id that receives the whole canvas as its rect."
        @tier "presentation"
      rootRect : RasmRect = { x: 0, y: 0, w: 720, h: 520 }
        @label "Root rect"
        @description "The rect handed to the root child until the canvas is sized: its w is the most the root takes (align center), its h the starting content height."
        @tier "presentation"
      fill : boolean = false
        @label "Fill"
        @description "On, the canvas takes its container's whole box and the root fits inside it. Off (the default), the canvas takes its container's width and the root's content height, so the page scrolls past a long surface."
        @tier "presentation"
      minHeight : number = 0
        @label "Least height"
        @description "With fill on, the least height in px: a shorter container scrolls instead of squeezing the surface (a stage that needs room for its header, card and stepper)."
        @tier "presentation"
      margin : number = 0
        @label "Margin"
        @description "The gap in px kept on every side between the surface and the root rect."
        @tier "presentation"
      align : "stretch" | "center" = "stretch"
        @label "Align"
        @description "Stretch gives the root the surface width minus the margin; center gives it its rootRect width (capped to the surface minus the margin) centred, and with fill on its rootRect height centred too."
        @tier "presentation"
      transition : RasmTransition = { durationMs: 0, distance: 0, staggerMs: 0, owners: [], still: [] }
        @label "Content transition"
        @description "How content swapped by RASM_VISIBLE moves: the duration of the fade and slide, the slide distance in px, the delay between one arriving paint and the next, the owners whose calls transition, and the paint ids that always swap in place (a marker that changes with the content). A duration of 0 swaps at once."
        @tier "presentation"
      targets : [RasmTarget] = []
        @label "Render targets"
        @description "Each entry names a render target and the paint ids painted into it: those paints leave the frame and paint, ordered by z, as the children of one offscreen texture the surface's size, placed before everything else so a material that declares `targets` samples this frame's texture. A paint listed in no target paints in the frame. Children of a target take no pointer hits."
        @tier "presentation"
      pageScroll : boolean = false
        @label "Page scroll"
        @description "With fill on, the canvas keeps its container's height and the page scrolls inside it: the wheel, a touch that travels and its glide move every paint except the ground and the `fixed` paints, with no layout or repaint, and RASM_PAGE_SCROLLED reports the offset. Off, the canvas grows with its content and the document scrolls it."
        @tier "presentation"
      hotkeys : [string] = []
        @label "Hot keys"
        @description "Up to six key codes (the keyboard's `code`, such as KeyB) the page listens for anywhere in the window; a press emits RASM_HOTKEY with the code. A key typed into a text field never counts."
        @tier "presentation"
      fixed : [string] = []
        @label "Fixed paints"
        @description "With pageScroll on, the paint ids that stay where they are drawn while the page scrolls (a header, a rail)."
        @tier "presentation"
      fixedOn : [string] = []
        @label "Fixed on"
        @description "The breakpoints where the fixed paints stay put; empty fixes them at every breakpoint. A map pinned beside the copy on a wide screen scrolls with the page on a phone, where pinning it would cover the reading space."
        @tier "presentation"
      scrollReportMs : number = 100
        @label "Scroll report interval"
        @description "With pageScroll on, the least time in ms between two RASM_PAGE_SCROLLED while the page moves; the resting offset is always reported."
        @tier "presentation"
      landmark : "main" | "region" = main
        @label "Landmark"
        @description "The landmark role the canvas region takes: main for a surface that is the page's content, region for one inside another page's main."
        @tier "presentation"
    }
  }

  page "/rasm-surface" as RasmSurfacePage -> RasmSurface
}
