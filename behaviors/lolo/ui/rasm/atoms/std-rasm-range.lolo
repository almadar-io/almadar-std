app std-rasm-range [
  version: "1.0.0",
  description: "std-rasm-range — a Rasm slider painted on the orbital canvas. States idle, hovered, dragging and focused. A press on the thumb or track starts a drag and sets the value from the pointer x, moves while dragging update it clamped and stepped, and the release ends the drag and emits the configured changed event with { value }; RASM_STEP for its id changes the value by step times delta. Paints a label, track, fill to the value and a thumb (an eight-point star when the look's decor is star8, else a circle). A read-only range is a meter. Looks are range/default/track, fill and thumb-<state>."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number! }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }

orbital RasmRangeOrbital {
  entity RasmRangeItem [runtime] {
    id : string!
    looks : Map string RasmLook = {}
    hasLooks : boolean = false
    rect : RasmRect = { x: 0, y: 0, w: 0, h: 0 }
    hasRect : boolean = false
    entering : number = -1
    stagger : number = 70
    paints : number = 0
    value : number = 0
    over : boolean = true
  }

  trait RasmRange -> RasmRangeItem [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_BOOT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_THEME -> idle
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_PLACE -> idle when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @mine.rect))
        (set @entity.hasRect true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_ENTER -> idle when (array/includes ?order @config.id)
        (set @entity.entering (array/indexOf ?order @config.id))
        (set @entity.stagger ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> dragging when (and (and (= ?id @config.id) (= ?kind "down")) (not @config.readOnly))
        (set @entity.entering -1)
        (set @entity.value (let (
            (frac (math/clamp (/ (- ?x (+ @entity.rect.x 10)) (math/max 1 (- @entity.rect.w 20))) 0 1))
          )
          (math/clamp (+ @config.min (* (math/round (/ (* @frac (- @config.max @config.min)) @config.step)) @config.step)) @config.min @config.max)))
        (set @entity.over true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> hovered when (and (= ?id @config.id) (= ?kind "enter"))
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_FOCUS -> focused when (= ?id @config.id)
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      REPAINT -> idle when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (anim (if (>= @entity.entering 0) { durationMs: (+ 520 (* @entity.entering @entity.stagger)), loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @entity.entering @entity.stagger) (+ 520 (* @entity.entering @entity.stagger))), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } null))
            (track (default (object/get @entity.looks "range/default/track") {}))
            (fillLook (default (object/get @entity.looks "range/default/fill") {}))
            (look (default (object/get @entity.looks "range/default/thumb-idle") {}))
            (cy (- (+ @r.y @r.h) 14))
            (tx (+ @r.x 10))
            (tw (- @r.w 20))
            (frac (math/clamp (/ (- @entity.value @config.min) (math/max 0.0001 (- @config.max @config.min))) 0 1))
            (star (= @look.decor "star8"))
          )
          (emit RASM_PAINT { id: @config.id, z: @config.z, nodes: (array/concat (if (and (!= @track.textColor null) (!= @track.font null)) [{ type: draw-text, id: (str/concat @config.id ":label"), text: @config.label, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, align: left, baseline: top, color: @track.textColor, font: @track.font, spring: @track.spring }] []) [{ type: draw-shape, id: (str/concat @config.id ":track"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: @tw, height: 6, fill: @track.fill, corners: @track.corners, spring: @track.spring, animation: @anim }, { type: draw-shape, id: (str/concat @config.id ":fill"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: (* @frac @tw), height: 6, fill: @fillLook.fill, corners: @fillLook.corners, spring: @fillLook.spring, animation: @anim }] (array/map (if @star [0] []) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: polygon, anchor: "top-left", position: { x: (- (+ @tx (* @frac @tw)) 10), y: (- @cy 10), z: @config.z }, width: 20, height: 20, sides: 8, starRatio: 0.62, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) (array/map (if @star [] [0]) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: ellipse, anchor: center, position: { x: (+ @tx (* @frac @tw)), y: @cy, z: @config.z }, radiusX: 10, radiusY: 10, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: (- @cy 14), z: @config.z }, width: @r.w, height: 28, hit: (not @config.readOnly), semantic: { role: "slider", name: @config.label, value: (str/concat @entity.value) } }]) }))
    }

    state hovered {
      INIT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_BOOT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_THEME -> hovered
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_PLACE -> hovered when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @mine.rect))
        (set @entity.hasRect true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_ENTER -> hovered when (array/includes ?order @config.id)
        (set @entity.entering (array/indexOf ?order @config.id))
        (set @entity.stagger ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> dragging when (and (and (= ?id @config.id) (= ?kind "down")) (not @config.readOnly))
        (set @entity.entering -1)
        (set @entity.value (let (
            (frac (math/clamp (/ (- ?x (+ @entity.rect.x 10)) (math/max 1 (- @entity.rect.w 20))) 0 1))
          )
          (math/clamp (+ @config.min (* (math/round (/ (* @frac (- @config.max @config.min)) @config.step)) @config.step)) @config.min @config.max)))
        (set @entity.over true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> idle when (and (= ?id @config.id) (= ?kind "leave"))
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_FOCUS -> focused when (= ?id @config.id)
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      REPAINT -> hovered when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (anim (if (>= @entity.entering 0) { durationMs: (+ 520 (* @entity.entering @entity.stagger)), loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @entity.entering @entity.stagger) (+ 520 (* @entity.entering @entity.stagger))), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } null))
            (track (default (object/get @entity.looks "range/default/track") {}))
            (fillLook (default (object/get @entity.looks "range/default/fill") {}))
            (look (default (object/get @entity.looks "range/default/thumb-hovered") {}))
            (cy (- (+ @r.y @r.h) 14))
            (tx (+ @r.x 10))
            (tw (- @r.w 20))
            (frac (math/clamp (/ (- @entity.value @config.min) (math/max 0.0001 (- @config.max @config.min))) 0 1))
            (star (= @look.decor "star8"))
          )
          (emit RASM_PAINT { id: @config.id, z: @config.z, nodes: (array/concat (if (and (!= @track.textColor null) (!= @track.font null)) [{ type: draw-text, id: (str/concat @config.id ":label"), text: @config.label, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, align: left, baseline: top, color: @track.textColor, font: @track.font, spring: @track.spring }] []) [{ type: draw-shape, id: (str/concat @config.id ":track"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: @tw, height: 6, fill: @track.fill, corners: @track.corners, spring: @track.spring, animation: @anim }, { type: draw-shape, id: (str/concat @config.id ":fill"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: (* @frac @tw), height: 6, fill: @fillLook.fill, corners: @fillLook.corners, spring: @fillLook.spring, animation: @anim }] (array/map (if @star [0] []) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: polygon, anchor: "top-left", position: { x: (- (+ @tx (* @frac @tw)) 10), y: (- @cy 10), z: @config.z }, width: 20, height: 20, sides: 8, starRatio: 0.62, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) (array/map (if @star [] [0]) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: ellipse, anchor: center, position: { x: (+ @tx (* @frac @tw)), y: @cy, z: @config.z }, radiusX: 10, radiusY: 10, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: (- @cy 14), z: @config.z }, width: @r.w, height: 28, hit: (not @config.readOnly), semantic: { role: "slider", name: @config.label, value: (str/concat @entity.value) } }]) }))
    }

    state dragging {
      INIT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_BOOT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_THEME -> dragging
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_PLACE -> dragging when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @mine.rect))
        (set @entity.hasRect true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_ENTER -> dragging when (array/includes ?order @config.id)
        (set @entity.entering (array/indexOf ?order @config.id))
        (set @entity.stagger ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> dragging when (and (= ?id @config.id) (= ?kind "move"))
        (set @entity.value (let (
            (frac (math/clamp (/ (- ?x (+ @entity.rect.x 10)) (math/max 1 (- @entity.rect.w 20))) 0 1))
          )
          (math/clamp (+ @config.min (* (math/round (/ (* @frac (- @config.max @config.min)) @config.step)) @config.step)) @config.min @config.max)))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> dragging when (and (= ?id @config.id) (= ?kind "leave"))
        (set @entity.over false)
      RASM_POINTER -> dragging when (and (= ?id @config.id) (= ?kind "enter"))
        (set @entity.over true)
      RASM_POINTER -> hovered when (and (and (= ?id @config.id) (= ?kind "up")) @entity.over)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
        (emit @config.changed { value: @entity.value })
      RASM_POINTER -> idle when (and (and (= ?id @config.id) (= ?kind "up")) (not @entity.over))
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
        (emit @config.changed { value: @entity.value })
      REPAINT -> dragging when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (anim (if (>= @entity.entering 0) { durationMs: (+ 520 (* @entity.entering @entity.stagger)), loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @entity.entering @entity.stagger) (+ 520 (* @entity.entering @entity.stagger))), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } null))
            (track (default (object/get @entity.looks "range/default/track") {}))
            (fillLook (default (object/get @entity.looks "range/default/fill") {}))
            (look (default (object/get @entity.looks "range/default/thumb-dragging") {}))
            (cy (- (+ @r.y @r.h) 14))
            (tx (+ @r.x 10))
            (tw (- @r.w 20))
            (frac (math/clamp (/ (- @entity.value @config.min) (math/max 0.0001 (- @config.max @config.min))) 0 1))
            (star (= @look.decor "star8"))
          )
          (emit RASM_PAINT { id: @config.id, z: @config.z, nodes: (array/concat (if (and (!= @track.textColor null) (!= @track.font null)) [{ type: draw-text, id: (str/concat @config.id ":label"), text: @config.label, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, align: left, baseline: top, color: @track.textColor, font: @track.font, spring: @track.spring }] []) [{ type: draw-shape, id: (str/concat @config.id ":track"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: @tw, height: 6, fill: @track.fill, corners: @track.corners, spring: @track.spring, animation: @anim }, { type: draw-shape, id: (str/concat @config.id ":fill"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: (* @frac @tw), height: 6, fill: @fillLook.fill, corners: @fillLook.corners, spring: @fillLook.spring, animation: @anim }] (array/map (if @star [0] []) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: polygon, anchor: "top-left", position: { x: (- (+ @tx (* @frac @tw)) 12.5), y: (- @cy 12.5), z: @config.z }, width: 25, height: 25, sides: 8, starRatio: 0.62, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) (array/map (if @star [] [0]) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: ellipse, anchor: center, position: { x: (+ @tx (* @frac @tw)), y: @cy, z: @config.z }, radiusX: 12, radiusY: 12, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: (- @cy 14), z: @config.z }, width: @r.w, height: 28, hit: (not @config.readOnly), semantic: { role: "slider", name: @config.label, value: (str/concat @entity.value) } }]) }))
    }

    state focused {
      INIT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_BOOT -> idle
        (set @entity.value (math/clamp @config.value @config.min @config.max))
        (set @entity.over true)
      RASM_THEME -> focused
        (set @entity.looks ?looks)
        (set @entity.hasLooks true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_PLACE -> focused when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (default (array/find ?placed (fn p (= @p.id @config.id))) { id: "", rect: { x: 0, y: 0, w: 0, h: 0 } }))) @mine.rect))
        (set @entity.hasRect true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_ENTER -> focused when (array/includes ?order @config.id)
        (set @entity.entering (array/indexOf ?order @config.id))
        (set @entity.stagger ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_POINTER -> dragging when (and (and (= ?id @config.id) (= ?kind "down")) (not @config.readOnly))
        (set @entity.entering -1)
        (set @entity.value (let (
            (frac (math/clamp (/ (- ?x (+ @entity.rect.x 10)) (math/max 1 (- @entity.rect.w 20))) 0 1))
          )
          (math/clamp (+ @config.min (* (math/round (/ (* @frac (- @config.max @config.min)) @config.step)) @config.step)) @config.min @config.max)))
        (set @entity.over true)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_FOCUS -> idle when (!= ?id @config.id)
        (set @entity.entering -1)
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      RASM_STEP -> focused when (and (= ?id @config.id) (not @config.readOnly))
        (set @entity.entering -1)
        (set @entity.value (math/clamp (+ @entity.value (* @config.step ?delta)) @config.min @config.max))
        (emit @config.changed { value: @entity.value })
        (set @entity.paints (+ @entity.paints 1))
        (emit REPAINT { n: @entity.paints })
      REPAINT -> focused when (and @entity.hasLooks @entity.hasRect)
        (let (
            (r @entity.rect)
            (anim (if (>= @entity.entering 0) { durationMs: (+ 520 (* @entity.entering @entity.stagger)), loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (/ (* @entity.entering @entity.stagger) (+ 520 (* @entity.entering @entity.stagger))), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } null))
            (track (default (object/get @entity.looks "range/default/track") {}))
            (fillLook (default (object/get @entity.looks "range/default/fill") {}))
            (look (default (object/get @entity.looks "range/default/thumb-focused") {}))
            (cy (- (+ @r.y @r.h) 14))
            (tx (+ @r.x 10))
            (tw (- @r.w 20))
            (frac (math/clamp (/ (- @entity.value @config.min) (math/max 0.0001 (- @config.max @config.min))) 0 1))
            (star (= @look.decor "star8"))
          )
          (emit RASM_PAINT { id: @config.id, z: @config.z, nodes: (array/concat (if (and (!= @track.textColor null) (!= @track.font null)) [{ type: draw-text, id: (str/concat @config.id ":label"), text: @config.label, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, align: left, baseline: top, color: @track.textColor, font: @track.font, spring: @track.spring }] []) [{ type: draw-shape, id: (str/concat @config.id ":track"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: @tw, height: 6, fill: @track.fill, corners: @track.corners, spring: @track.spring, animation: @anim }, { type: draw-shape, id: (str/concat @config.id ":fill"), shape: rect, anchor: "top-left", position: { x: @tx, y: (- @cy 3), z: @config.z }, width: (* @frac @tw), height: 6, fill: @fillLook.fill, corners: @fillLook.corners, spring: @fillLook.spring, animation: @anim }] (array/map (if @star [0] []) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: polygon, anchor: "top-left", position: { x: (- (+ @tx (* @frac @tw)) 10), y: (- @cy 10), z: @config.z }, width: 20, height: 20, sides: 8, starRatio: 0.62, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) (array/map (if @star [] [0]) (fn i { type: draw-shape, id: (str/concat @config.id ":thumb"), shape: ellipse, anchor: center, position: { x: (+ @tx (* @frac @tw)), y: @cy, z: @config.z }, radiusX: 10, radiusY: 10, fill: @look.fill, stroke: @look.stroke, strokeWidth: @look.strokeWidth, shadow: @look.shadow, spring: @look.spring, animation: @anim })) [{ type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: (- @cy 14), z: @config.z }, width: @r.w, height: 28, hit: (not @config.readOnly), semantic: { role: "slider", name: @config.label, value: (str/concat @entity.value) } }]) }))
    }

    emits {
      RASM_PAINT -> external {
        id : string!
        z : number!
        nodes : [node]!
      }
        @description "The control's whole paint: its drawables, in order, for the surface to collect."
        @tier "domain"
      REPAINT -> internal {
        n : number!
      }
        @tier "internal"
      @config.changed -> external {
        value : number!
      }
        @description "The value was committed: a drag ended or a keyboard step landed."
        @tier "domain"
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: take the configured starting state."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "The theme's looks; the control repaints with them."
      RASM_PLACE { placed : [RasmPlaced]! }
        @description "Placed rects; the control takes the entry whose id is its own."
      RASM_ENTER { order : [string]!  staggerMs : number! }
        @description "The entry choreography; a control in the order paints with its stagger."
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "A pointer event from the surface; the control acts on its own id."
      RASM_FOCUS { id : string! }
        @description "Focus moved; the control with that id is focused, the others clear."
      RASM_STEP { id : string!  delta : number! }
        @description "A keyboard step for the focused range."
    }

    config {
      id : string = ""
        @label "Id"
        @description "The region and paint id of the control."
        @tier "domain"
      label : string = ""
        @label "Label"
        @description "The text above the track and its accessible name."
        @tier "domain"
      min : number = 0
        @label "Min"
        @description "The lowest value."
        @tier "domain"
      max : number = 100
        @label "Max"
        @description "The highest value."
        @tier "domain"
      step : number = 1
        @label "Step"
        @description "The increment a drag snaps to and a keyboard step moves by."
        @tier "domain"
      value : number = 0
        @label "Value"
        @description "The starting value."
        @tier "domain"
      readOnly : boolean = false
        @label "Read only"
        @description "A read-only range paints as a meter and takes no drag or keyboard step."
        @tier "policy"
      changed : event = RASM_RANGE_CHANGED
        @label "Changed"
        @description "The event emitted with the committed value."
        @tier "domain"
      z : number = 0
        @label "Z"
        @description "Paint order."
        @tier "presentation"
    }
  }

  page boot as RasmRangeStart -> RasmRange
}
