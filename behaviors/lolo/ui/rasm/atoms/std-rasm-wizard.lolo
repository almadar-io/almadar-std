app std-rasm-wizard [
  version: "0.1.0",
  description: "std-rasm-wizard — one step at a time: a list of steps, each the paint ids it shows, swapped with RASM_VISIBLE (so a std-rasm-surface whose `transition` names this wizard's id as an owner slides one step out and the next in, toward the reading start going forward and away from it going back). RASM_WIZARD_NEXT, RASM_WIZARD_BACK and RASM_WIZARD_RESET move the step; a press and release on one of the `picks` controls (or RASM_ACTIVATE for it from the keyboard) jumps to that pick's step, which makes the same atom a tab strip. On every step it sends the step counter's catalog key to `markId`, asks std-rasm-focus to trap keyboard focus on that step's controls plus `focusRest` (RASM_FOCUS_TRAP, so a hidden step's controls cannot be reached), and starts a std-rasm-tween named `tween` toward the share of steps reached (RASM_TWEEN_START); each step of that tween (RASM_WIZARD_FILL) repaints the progress bar this atom draws in its own placed rect from the looks `range/default/track` and `range/default/fill`. Under reduced motion the tween lands at once and the bar jumps."
]
;; @capabilities "step wizard, quiz, tabs, progress bar, multi-step form, one question at a time"

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, startMs : number, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmReveal = { startMs : number!, perGlyphMs : number!, durationMs : number! }
type RasmHalo = { color : string!, width : number! }
type RasmTextParams = Map string string
type RasmText = { id : string!, key : MessageKey!, params : RasmTextParams?, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, level : number?, animation : RasmAnimation?, reveal : RasmReveal?, height : number?, fit : "none" | "shrink"?, minSize : number?, rotate : number?, vertical : boolean?, pivotX : number?, pivotY : number?, halo : RasmHalo? }
type RasmWizardStep = { shows : [string]!, focus : [string] }
type RasmWizardPick = { id : string!, step : number! }

orbital RasmWizardOrbital {
  entity RasmWizardRun [runtime] {
    id : string!
    step : number @description "The position of the step shown." = 0
    fill : number @description "The progress bar's current fill from 0 to 1, as the tween last stepped it." = 0
    armed : string @description "The pick a press began on, empty when none." = ""
    rect : RasmRect? @description "The rect RASM_PLACE gave the bar, null until placed." = null
    looks : Map string RasmLook @description "The announced look table." = {}
    dir : "ltr" | "rtl" = "ltr"
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmWizard -> RasmWizardRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.step 0)
        (set @entity.fill 0)
        (set @entity.armed "")
        (emit WIZARD_SHOW { forward: true })
      RASM_BOOT -> ready
        (set @entity.step 0)
        (set @entity.fill 0)
        (set @entity.armed "")
        (emit WIZARD_SHOW { forward: true })
      RASM_WIZARD_NEXT -> ready when (< (+ @entity.step 1) (array/len @config.steps))
        (set @entity.step (+ @entity.step 1))
        (emit WIZARD_SHOW { forward: true })
      RASM_WIZARD_NEXT -> ready when (not (< (+ @entity.step 1) (array/len @config.steps)))
      RASM_WIZARD_BACK -> ready when (> @entity.step 0)
        (set @entity.step (- @entity.step 1))
        (emit WIZARD_SHOW { forward: false })
      RASM_WIZARD_BACK -> ready when (not (> @entity.step 0))
      RASM_WIZARD_RESET -> ready
        (set @entity.step 0)
        (emit WIZARD_SHOW { forward: false })
      RASM_POINTER -> ready when (and (= ?kind "down") (array/some @config.picks (fn p (= @p.id ?id))))
        (set @entity.armed ?id)
      RASM_POINTER -> ready when (and (= ?kind "down") (not (array/some @config.picks (fn p (= @p.id ?id)))))
        (set @entity.armed "")
      RASM_POINTER -> ready when (and (= ?kind "up") (!= @entity.armed "") (= @entity.armed ?id) (array/some @config.picks (fn p (= @p.id ?id))))
        (let ((pick (default (array/find @config.picks (fn p (= @p.id ?id))) { id: "", step: 0 })))
          (do
            (emit WIZARD_SHOW { forward: (> @pick.step @entity.step) })
            (set @entity.step (math/clamp @pick.step 0 (math/max 0 (- (array/len @config.steps) 1))))
            (set @entity.armed "")))
      RASM_POINTER -> ready when (and (= ?kind "up") (not (and (!= @entity.armed "") (= @entity.armed ?id) (array/some @config.picks (fn p (= @p.id ?id))))))
        (set @entity.armed "")
      RASM_POINTER -> ready when (and (!= ?kind "down") (!= ?kind "up"))
      RASM_ACTIVATE -> ready when (array/some @config.picks (fn p (= @p.id ?id)))
        (let ((pick (default (array/find @config.picks (fn p (= @p.id ?id))) { id: "", step: 0 })))
          (do
            (emit WIZARD_SHOW { forward: (> @pick.step @entity.step) })
            (set @entity.step (math/clamp @pick.step 0 (math/max 0 (- (array/len @config.steps) 1))))))
      RASM_ACTIVATE -> ready when (not (array/some @config.picks (fn p (= @p.id ?id))))
      WIZARD_SHOW -> ready
        (let ((none : RasmWizardStep { shows: [], focus: [] }) (ks : [MessageKey] @config.marks))
          (let ((cur (default (array/nth @config.steps @entity.step) @none)))
            (do
              (emit RASM_VISIBLE { owner: @config.id, shown: @cur.shows, hidden: (array/filter (array/flatten (array/map @config.steps (fn s @s.shows))) (fn x (not (array/includes @cur.shows @x)))), forward: ?forward })
              (when (!= @config.markId "") (emit RASM_TEXT_KEY { id: @config.markId, key: (default (array/nth @ks @entity.step) @config.empty) }))
              (when (> (array/len (array/concat (default @cur.focus []) @config.focusRest)) 0) (emit RASM_FOCUS_TRAP { owner: @config.id, order: (array/concat (default @cur.focus []) @config.focusRest) }))
              (when (!= @config.tween "") (emit RASM_TWEEN_START { id: @config.tween, from: @entity.fill, to: (/ (+ @entity.step 1) (math/max 1 (array/len @config.steps))), durationMs: @config.fillMs })))))
      RASM_WIZARD_FILL -> ready when (= ?id @config.tween)
        (set @entity.fill ?value)
        (set @entity.paints (+ @entity.paints 1))
        (emit WIZARD_PAINT { n: @entity.paints })
      RASM_WIZARD_FILL -> ready when (!= ?id @config.tween)
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit WIZARD_PAINT { n: @entity.paints })
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit WIZARD_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit WIZARD_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      WIZARD_PAINT -> ready
        (let ((t (object/get @entity.looks "range/default/track" null)) (f (object/get @entity.looks "range/default/fill" null)) (r @entity.rect))
          (when (and (!= @t null) (!= @f null) (!= @r null) @config.bar)
            (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, texts: [], nodes: [
              { type: draw-shape, id: (str/concat @config.id ":track"), shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: @t.fill, corners: @t.corners, hit: false },
              { type: draw-shape, id: (str/concat @config.id ":fill"), shape: rect, anchor: "top-left", position: { x: (if (= @entity.dir "rtl") (+ @r.x (- @r.w (* @r.w @entity.fill))) @r.x), y: @r.y, z: (+ @config.z 1) }, width: (* @r.w @entity.fill), height: @r.h, fill: @f.fill, corners: @f.corners, hit: false }
            ] })))
    }

    emits {
      WIZARD_SHOW -> internal {
        forward : boolean!
      }
        @description "Show the step now current."
        @tier "internal"
      WIZARD_PAINT -> internal {
        n : number!
      }
        @description "Repaint the progress bar."
        @tier "internal"
      RASM_VISIBLE -> external {
        owner : string!
        shown : [string]!
        hidden : [string]!
        forward : boolean
      }
        @description "Show the paints of the current step and hide those of the others; forward is false when the step moved back."
        @tier "primary"
      RASM_TEXT_KEY -> external {
        id : string!
        key : MessageKey!
      }
        @description "The step counter's catalog key for the current step, sent to the text named by `markId`."
        @tier "domain"
      RASM_FOCUS_TRAP -> external {
        owner : string!
        order : [string]!
      }
        @description "Keyboard focus cycles only the current step's controls and `focusRest`."
        @tier "domain"
      RASM_TWEEN_START -> external {
        id : string!
        from : number!
        to : number!
        durationMs : number!
      }
        @description "Fill the progress bar from where it is to the share of steps reached."
        @tier "domain"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The progress bar: a track and its fill."
        @tier "domain"
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: show the first step."
      RASM_WIZARD_NEXT { }
        @description "Move to the next step; on the last step nothing moves."
        @synonyms "next, continue, advance"
      RASM_WIZARD_BACK { }
        @description "Move to the previous step; on the first step nothing moves."
        @synonyms "back, previous"
      RASM_WIZARD_RESET { }
        @description "Return to the first step."
        @synonyms "restart, start over"
      RASM_POINTER { kind : "down" | "up" | "enter" | "leave" | "move"!  id : string!  x : number!  y : number! }
        @description "A press then a release on the same pick jumps to its step."
      RASM_ACTIVATE { id : string! }
        @description "Keyboard activation of a pick jumps to its step."
      RASM_WIZARD_FILL { id : string!  value : number!  t : number! }
        @description "One step of the progress tween: take the fill and repaint."
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The reading direction: rtl fills the bar from the right."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint the bar."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the bar's rect when it is placed."
    }

    config {
      id : string = "wizard"
        @label "Id"
        @description "The wizard's id: the RASM_VISIBLE owner, the progress bar's placed id and its paint id."
        @tier "presentation"
      steps : [RasmWizardStep] = []
        @label "Steps"
        @description "In order: the paint ids a step shows and the control ids a keyboard can reach on it."
        @tier "domain"
      picks : [RasmWizardPick] = []
        @label "Picks"
        @description "Controls that jump to a step when pressed (a tab strip): the control id and the step it opens."
        @tier "domain"
      focusRest : [string] = []
        @label "Focus rest"
        @description "The control ids outside the wizard that keyboard focus keeps reaching while a step is trapped."
        @tier "presentation"
      marks : [MessageKey] = []
        @label "Step counters"
        @description "The catalog key of each step's counter, in the order of `steps`."
        @tier "presentation"
      markId : string = ""
        @label "Counter id"
        @description "The id of the std-rasm-text that shows the step counter; empty sends none."
        @tier "presentation"
      empty : MessageKey
        @label "Empty text"
        @description "The catalog key shown when a step has no counter."
        @tier "presentation"
      tween : string = ""
        @label "Tween"
        @description "The id of the std-rasm-tween that animates the bar's fill; empty starts none and the bar stays empty."
        @tier "presentation"
      fillMs : number = 400
        @label "Fill time"
        @description "How long the bar takes to reach a new step's share."
        @tier "presentation"
      bar : boolean = true
        @label "Progress bar"
        @description "On, the wizard paints a progress bar in its placed rect; off, it only swaps steps (a tab strip)."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order of the bar."
        @tier "presentation"
    }
  }

  page boot as RasmWizardStart -> RasmWizard
}
