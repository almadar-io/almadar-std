app std-rasm-grid [
  version: "0.2.0",
  kernel: { "queue": [reorder] },
  description: "std-rasm-grid — the Rasm kit's two-axis layout node. On RASM_PLACE for its own id it stores its rect and places its children in the cells of a declared grid: columns and rows are fixed px, an equal share (fill) or a weighted share (fr, weight in main, default 1) of what is left, a child names its column, row and optional spans, and RASM_PLACE carries each child's rect. A child may carry rotate (radians, forwarded in its placed entry), and offsetX and offsetY (px nudges applied after the cell is computed). Children may name overlapping cells: a collage, a headline running over a picture; each leaf's own z decides which paints on top. With direction rtl the columns run from the right edge. The knob rules paints a hairline in every gutter between tracks (look grid/rule/idle) and border paints a frame on the grid's rect (look grid/border/idle); with no such look nothing is painted. A child whose cell lies outside the declared tracks is not placed. A measure row is as tall as its tallest single-row child that reports RASM_EXTENT or is a measured text; a fill or fr row may name a min and is never shorter than it or than that child, and a row held at that floor is taken out of the room the other rows share. After each layout the grid reports RASM_EXTENT with its content height (fixed rows at main, measure rows at their child, fill and fr rows at their floor), so a measure parent sizes it. A child declared in another breakpoint shape but not in the active one is placed at zero size, so it paints nothing there. A placement at the rect it already holds changes nothing."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmTrack = { size : "fixed" | "fill" | "fr" | "measure"!, main : number, min : number }
type RasmMeasureItem = { id : string!, width : number!, height : number!, lines : number! }
type RasmGridShape = { columns : [RasmTrack], rows : [RasmTrack], gap : number, rowGap : number, padding : number, rules : "none" | "columns" | "rows" | "both", border : boolean, children : [RasmGridChild] }
type RasmGridChild = { id : string!, col : number!, row : number!, colSpan : number, rowSpan : number, rotate : number, offsetX : number, offsetY : number, align : "stretch" | "start" | "center" | "end" }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }

orbital RasmGridOrbital {
  entity RasmGridRun [runtime] {
    id : string!
    rect : RasmRect? @description "The rect RASM_PLACE gave this grid, null until placed." = null
    looks : Map string RasmLook @description "The announced look table." = {}
    dir : "ltr" | "rtl" @description "The direction the surface announced." = "ltr"
    announced : boolean @description "True once the surface announced a direction, which then replaces the config knob." = false
    colW : [number] @description "The column widths of the last layout in px." = []
    colAt : [number] @description "Each column's offset from the content edge in px, at the last layout." = []
    rowH : [number] @description "The row heights of the last layout in px." = []
    measured : Map string RasmMeasureItem @description "The latest measured height of each child, by id: a child that reports RASM_EXTENT or whose text RASM_MEASURED measured." = {}
    rowAt : [number] @description "Each row's offset from the content edge in px, at the last layout." = []
    variant : string @description "The key of `variants` the announced breakpoint chose, empty for the configured shape." = ""
    layouts : number @description "Counts layouts, so each layout in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    due : boolean @description "True while a layout is queued at the back of the worklist: later changes in the dispatch only record what they change, so the grid lays out once for all of them." = false
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    painted : boolean @description "True while this grid has rules or a border on the surface, so a variant that drops them clears what it painted." = false
    space : Map string number @description "The spacing scale the theme last announced (tight, stack, group, gutter, section, measure), empty before it did." = {}
    viewH : number @description "The view height the surface last reported, for fold." = 0
    gapNow : number @description "The column gap of the last layout in px: the gapBy step of the announced scale, else the shape's gap." = 0
    rowGapNow : number @description "The row gap of the last layout in px: the rowGapBy step of the announced scale, else the shape's rowGap." = 0
    padX : number @description "The left and right padding of the last layout in px: the padding, widened with contain so the tracks are no wider than the scale's measure." = 0
    padY : number @description "The top and bottom padding of the last layout in px: the paddingBy step of the announced scale, else the shape's padding." = 0
  }

  trait RasmGrid -> RasmGridRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.announced true)
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_BREAKPOINT -> ready when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_BREAKPOINT -> ready when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      RASM_SPACE -> ready
        (set @entity.space ?space)
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_RESIZE -> ready when (and (> @config.fold 0) (!= ?height @entity.viewH))
        (set @entity.viewH ?height)
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_RESIZE -> ready when (not (and (> @config.fold 0) (!= ?height @entity.viewH)))
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit GRID_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h))))
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (not (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h)))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_EXTENT -> ready when (and (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh (default @sh.children []))))) (fn c (= @c.id ?id))) (let ((m (object/get @entity.measured ?id null))) (or (= @m null) (!= @m.height ?h))))
        (set @entity.measured (object/set @entity.measured ?id { id: ?id, width: ?w, height: ?h, lines: 0 }))
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_EXTENT -> ready when (not (and (array/some (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh (default @sh.children []))))) (fn c (= @c.id ?id))) (let ((m (object/get @entity.measured ?id null))) (or (= @m null) (!= @m.height ?h)))))
      RASM_MEASURED -> ready when (let ((kids (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh (default @sh.children []))))))) (array/some ?items (fn it (and (array/some @kids (fn c (= @c.id @it.id))) (let ((m (object/get @entity.measured @it.id null))) (or (= @m null) (!= @m.height @it.height)))))))
        (set @entity.measured (let ((kids (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh (default @sh.children []))))))) (array/reduce ?items @entity.measured (fn acc it (if (array/some @kids (fn c (= @c.id @it.id))) (object/set @acc @it.id @it) @acc)))))
        (when (not @entity.due) (do (set @entity.due true) (set @entity.layouts (+ @entity.layouts 1)) (emit GRID_LAYOUT { n: @entity.layouts }) (kernel/queue-back "GRID_LAYOUT")))
      RASM_MEASURED -> ready when (let ((kids (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh (default @sh.children []))))))) (not (array/some ?items (fn it (and (array/some @kids (fn c (= @c.id @it.id))) (let ((m (object/get @entity.measured @it.id null))) (or (= @m null) (!= @m.height @it.height))))))))
      GRID_LAYOUT -> ready when (!= @entity.rect null)
        (set @entity.due false)
        (set @entity.gapNow (object/get @entity.space @config.gapBy (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.gap)) @config.gap)))
        (set @entity.rowGapNow (object/get @entity.space @config.rowGapBy (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rowGap)) @config.rowGap)))
        (set @entity.padY (object/get @entity.space @config.paddingBy (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.padding)) @config.padding)))
        (set @entity.padX (let ((m (object/get @entity.space "measure" 0)) (side (object/get @entity.space @config.paddingXBy @entity.padY))) (if (and @config.contain (> @m 0)) (math/max @side (/ (- @entity.rect.w @m) 2)) @side)))
        (set @entity.colW (let ((r @entity.rect) (pad @entity.padX) (padV @entity.padY) (cols (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.columns)) @config.columns))) (let ((ext (- @r.w (* 2 @pad))) (fixed (array/reduce @cols 0 (fn a t (+ @a (if (= @t.size "fixed") (default @t.main 0) 0))))) (weights (array/reduce @cols 0 (fn a t (+ @a (if (= @t.size "fill") 1 (if (= @t.size "fr") (default @t.main 1) 0))))))) (let ((share (if (> @weights 0) (math/max 0 (/ (- (- @ext @fixed) (* @entity.gapNow (math/max 0 (- (array/len @cols) 1)))) @weights)) 0))) (array/map @cols (fn t (if (= @t.size "fixed") (default @t.main 0) (* @share (if (= @t.size "fr") (default @t.main 1) 1)))))))))
        (set @entity.rowH (let ((r @entity.rect) (pad @entity.padX) (padV @entity.padY) (rows (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rows)) @config.rows)) (leasts (array/map (array/range (array/len (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rows)) @config.rows))) (fn ri (array/reduce (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) 0 (fn a c (if (and (= @c.row @ri) (<= (default @c.rowSpan 1) 1)) (math/max @a (let ((m (object/get @entity.measured @c.id null))) (if (= @m null) 0 @m.height))) @a))))))) (let ((ext (- @r.h (* 2 @padV))) (fixed (array/reduce (array/range (array/len @rows)) 0 (fn a ri (let ((t (default (array/nth @rows @ri) { size: "fixed", main: 0 }))) (+ @a (if (= @t.size "fixed") (default @t.main 0) (if (= @t.size "measure") (default (array/nth @leasts @ri) 0) 0))))))) (weights (array/reduce @rows 0 (fn a t (+ @a (if (= @t.size "fill") 1 (if (= @t.size "fr") (default @t.main 1) 0)))))))
          (let ((avail (- (- @ext @fixed) (* @entity.rowGapNow (math/max 0 (- (array/len @rows) 1)))))) (let ((share (if (> @weights 0) (array/reduce (array/range (array/len @rows)) (math/max 0 (/ @avail @weights)) (fn s k (let ((held (array/reduce (array/range (array/len @rows)) { h: 0, w: 0 } (fn a ri (let ((t (default (array/nth @rows @ri) { size: "fixed", main: 0 }))) (if (and (or (= @t.size "fill") (= @t.size "fr")) (> (math/max (default @t.min 0) (default (array/nth @leasts @ri) 0)) (* @s (if (= @t.size "fill") 1 (if (= @t.size "fr") (default @t.main 1) 0))))) { h: (+ @a.h (math/max (default @t.min 0) (default (array/nth @leasts @ri) 0))), w: (+ @a.w (if (= @t.size "fill") 1 (if (= @t.size "fr") (default @t.main 1) 0))) } @a)))))) (if (> (- @weights @held.w) 0) (math/max 0 (/ (- @avail @held.h) (- @weights @held.w))) @s)))) 0)))
            (array/reduce (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (array/map (array/range (array/len @rows)) (fn ri (let ((t (default (array/nth @rows @ri) { size: "fixed", main: 0 })) (least (default (array/nth @leasts @ri) 0))) (if (= @t.size "fixed") (default @t.main 0) (if (= @t.size "measure") @least (math/max (* @share (if (= @t.size "fr") (default @t.main 1) 1)) (math/max (default @t.min 0) @least))))))) (fn hs c (let ((m (object/get @entity.measured @c.id null)) (sp (default @c.rowSpan 1))) (if (or (<= @sp 1) (= @m null)) @hs (let ((have (+ (* @entity.rowGapNow (- @sp 1)) (array/reduce (array/range @sp) 0 (fn a k (+ @a (default (array/nth @hs (+ @c.row @k)) 0)))))) (gi (array/reduce (array/range @sp) (- 0 1) (fn gg k (let ((t (default (array/nth (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rows)) @config.rows) (+ @c.row @k)) { size: "fixed", main: 0 }))) (if (or (= @t.size "fr") (or (= @t.size "fill") (= @t.size "measure"))) (+ @c.row @k) @gg)))))) (let ((g (if (< @gi 0) (- (+ @c.row @sp) 1) @gi))) (if (> @m.height @have) (array/map (array/range (array/len @hs)) (fn ri (if (= @ri @g) (+ (default (array/nth @hs @ri) 0) (- @m.height @have)) (default (array/nth @hs @ri) 0)))) @hs))))))))))))
        (set @entity.colAt (let ((acc (array/reduce @entity.colW { at: 0, xs: [] } (fn a w { at: (+ (+ @a.at @w) @entity.gapNow), xs: (array/append @a.xs @a.at) })))) @acc.xs))
        (set @entity.rowAt (let ((acc (array/reduce @entity.rowH { at: 0, ys: [] } (fn a h { at: (+ (+ @a.at @h) @entity.rowGapNow), ys: (array/append @a.ys @a.at) })))) @acc.ys))
        (emit RASM_PLACE { n: ?n, placed: (array/concat (let ((r @entity.rect) (pad @entity.padX) (padV @entity.padY) (rtl (= (if @entity.announced @entity.dir @config.direction) "rtl")) (cols (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.columns)) @config.columns)) (rows (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rows)) @config.rows)) (colW @entity.colW) (colAt @entity.colAt) (rowH @entity.rowH) (rowAt @entity.rowAt)) (array/map (array/filter (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn c (and (and (>= @c.col 0) (>= @c.row 0)) (and (<= (+ @c.col (default @c.colSpan 1)) (array/len @cols)) (<= (+ @c.row (default @c.rowSpan 1)) (array/len @rows)))))) (fn c (let ((c1 (- (+ @c.col (default @c.colSpan 1)) 1)) (r1 (- (+ @c.row (default @c.rowSpan 1)) 1))) (let ((x0 (default (array/nth @colAt @c.col) 0)) (w (- (+ (default (array/nth @colAt @c1) 0) (default (array/nth @colW @c1) 0)) (default (array/nth @colAt @c.col) 0))) (y0 (default (array/nth @rowAt @c.row) 0)) (h (- (+ (default (array/nth @rowAt @r1) 0) (default (array/nth @rowH @r1) 0)) (default (array/nth @rowAt @c.row) 0))) (dx (default @c.offsetX 0)) (dy (default @c.offsetY 0))) (object/merge { id: @c.id, rect: { x: (+ (if @rtl (- (- (+ @r.x @r.w) @pad) (+ @x0 @w)) (+ (+ @r.x @pad) @x0)) @dx), y: (+ (+ (+ (+ @r.y @padV) @y0) @dy) (let ((m (object/get @entity.measured @c.id null)) (al (default @c.align "stretch"))) (if (or (= @al "stretch") (= @m null) (>= @m.height @h)) 0 (if (= @al "center") (/ (- @h @m.height) 2) (if (= @al "end") (- @h @m.height) 0))))), w: @w, h: (let ((m (object/get @entity.measured @c.id null)) (al (default @c.align "stretch"))) (if (or (= @al "stretch") (= @m null) (>= @m.height @h)) @h @m.height)) } } (if (= (default @c.rotate 0) 0) {} { rotate: @c.rotate }))))))) (array/map (array/filter (array/concat @config.children (array/flatten (array/map (object/values @config.variants) (fn sh (default @sh.children []))))) (fn c (not (array/some (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (fn k (= @k.id @c.id)))))) (fn c { id: @c.id, rect: { x: @entity.rect.x, y: @entity.rect.y, w: 0, h: 0 } }))) })
        (emit RASM_EXTENT { n: ?n, id: @config.id, w: @entity.rect.w, h: (math/max (* @config.fold @entity.viewH) (let ((rows (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rows)) @config.rows)) (kids (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children))) (+ (* 2 @entity.padY) (+ (* @entity.rowGapNow (math/max 0 (- (array/len @rows) 1))) (array/reduce (array/reduce (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children) (array/map (array/range (array/len @rows)) (fn ri (let ((t (default (array/nth @rows @ri) { size: "fixed", main: 0 })) (least (array/reduce @kids 0 (fn b c (if (and (= @c.row @ri) (<= (default @c.rowSpan 1) 1)) (math/max @b (let ((m (object/get @entity.measured @c.id null))) (if (= @m null) 0 @m.height))) @b))))) (if (= @t.size "fixed") (default @t.main 0) (if (= @t.size "measure") @least (math/max (default @t.min 0) @least)))))) (fn hs c (let ((m (object/get @entity.measured @c.id null)) (sp (default @c.rowSpan 1))) (if (or (<= @sp 1) (= @m null)) @hs (let ((have (+ (* @entity.rowGapNow (- @sp 1)) (array/reduce (array/range @sp) 0 (fn a k (+ @a (default (array/nth @hs (+ @c.row @k)) 0)))))) (gi (array/reduce (array/range @sp) (- 0 1) (fn gg k (let ((t (default (array/nth (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rows)) @config.rows) (+ @c.row @k)) { size: "fixed", main: 0 }))) (if (or (= @t.size "fr") (or (= @t.size "fill") (= @t.size "measure"))) (+ @c.row @k) @gg)))))) (let ((g (if (< @gi 0) (- (+ @c.row @sp) 1) @gi))) (if (> @m.height @have) (array/map (array/range (array/len @hs)) (fn ri (if (= @ri @g) (+ (default (array/nth @hs @ri) 0) (- @m.height @have)) (default (array/nth @hs @ri) 0)))) @hs))))))) 0 (fn a h (+ @a @h))))))) })
        (set @entity.paints (+ @entity.paints 1))
        (emit GRID_PAINT { n: @entity.paints })
      GRID_LAYOUT -> ready when (= @entity.rect null)
        (set @entity.due false)
      GRID_PAINT -> ready when (and (!= @entity.rect null) (or (!= @config.look "") (!= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rules)) @config.rules) "none") (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.border)) @config.border)))
        (set @entity.painted true)
        (let ((r @entity.rect) (pad @entity.padX) (padV @entity.padY) (rtl (= (if @entity.announced @entity.dir @config.direction) "rtl")) (rule (object/get @entity.looks "grid/rule/idle" null)) (frame (object/get @entity.looks "grid/border/idle" null)))
          (let ((top (+ @r.y @padV)) (bottom (- (+ @r.y @r.h) @padV)) (colN (array/len @entity.colW)) (rowN (array/len @entity.rowH)) (kids : [RasmGridChild] (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.children)) @config.children)))
            (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: (array/concat (let ((body (object/get @entity.looks @config.look null))) (if (or (= @config.look "") (= @body null)) [] [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":body"), anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: @body.fill, stroke: @body.stroke, strokeWidth: @body.strokeWidth, corners: @body.corners, shadow: @body.shadow, material: @body.material, hit: false }])) (array/concat (array/concat (if (and (!= @rule null) (array/includes ["columns", "both"] (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rules)) @config.rules))) (array/map (array/range (math/max 0 (- @colN 1))) (fn i (let ((pos (+ (+ (default (array/nth @entity.colAt @i) 0) (default (array/nth @entity.colW @i) 0)) (/ @entity.gapNow 2)))) (let ((x (if @rtl (- (- (+ @r.x @r.w) @pad) @pos) (+ (+ @r.x @pad) @pos)))) { type: draw-shape, shape: "path", id: (str/concat @config.id ":rule:col:" @i), anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: (if (= @rowN 0) (str/concat "M " @x " " @top " L " @x " " @bottom) (array/reduce (array/range @rowN) "" (fn acc k (if (array/some @kids (fn c (and (<= @c.col @i) (>= (+ @c.col (default @c.colSpan 1)) (+ @i 2)) (<= @c.row @k) (> (+ @c.row (default @c.rowSpan 1)) @k)))) @acc (str/concat @acc (if (= @acc "") "" " ") "M " @x " " (+ @top (if (= @k 0) 0 (- (default (array/nth @entity.rowAt @k) 0) (/ @entity.rowGapNow 2)))) " L " @x " " (if (= @k (- @rowN 1)) @bottom (+ @top (+ (+ (default (array/nth @entity.rowAt @k) 0) (default (array/nth @entity.rowH @k) 0)) (/ @entity.rowGapNow 2))))))))), fill: "", stroke: @rule.stroke, strokeWidth: (default @rule.strokeWidth 1), hit: false })))) []) (if (and (!= @rule null) (array/includes ["rows", "both"] (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rules)) @config.rules))) (array/map (array/range (math/max 0 (- @rowN 1))) (fn i (let ((y (+ (+ @top (+ (default (array/nth @entity.rowAt @i) 0) (default (array/nth @entity.rowH @i) 0))) (/ @entity.rowGapNow 2)))) { type: draw-shape, shape: "path", id: (str/concat @config.id ":rule:row:" @i), anchor: "top-left", position: { x: 0, y: 0, z: @config.z }, d: (if (= @colN 0) (str/concat "M " (+ @r.x @pad) " " @y " L " (- (+ @r.x @r.w) @pad) " " @y) (array/reduce (array/range @colN) "" (fn acc j (if (array/some @kids (fn c (and (<= @c.row @i) (>= (+ @c.row (default @c.rowSpan 1)) (+ @i 2)) (<= @c.col @j) (> (+ @c.col (default @c.colSpan 1)) @j)))) @acc (let ((a (if (= @j 0) 0 (- (default (array/nth @entity.colAt @j) 0) (/ @entity.gapNow 2)))) (b (if (= @j (- @colN 1)) (- @r.w (* 2 @pad)) (+ (+ (default (array/nth @entity.colAt @j) 0) (default (array/nth @entity.colW @j) 0)) (/ @entity.gapNow 2))))) (str/concat @acc (if (= @acc "") "" " ") "M " (if @rtl (- (- (+ @r.x @r.w) @pad) @a) (+ (+ @r.x @pad) @a)) " " @y " L " (if @rtl (- (- (+ @r.x @r.w) @pad) @b) (+ (+ @r.x @pad) @b)) " " @y)))))), fill: "", stroke: @rule.stroke, strokeWidth: (default @rule.strokeWidth 1), hit: false }))) [])) (if (and (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.border)) @config.border) (!= @frame null)) [{ type: draw-shape, shape: "rect", id: (str/concat @config.id ":border"), anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: "rgba(0,0,0,0)", stroke: @frame.stroke, strokeWidth: (default @frame.strokeWidth 1), corners: @frame.corners, hit: false }] []))) })))
      GRID_PAINT -> ready when (and (not (and (!= @entity.rect null) (or (!= @config.look "") (!= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rules)) @config.rules) "none") (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.border)) @config.border)))) @entity.painted)
        (set @entity.painted false)
        (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: [] })
      GRID_PAINT -> ready when (and (not (and (!= @entity.rect null) (or (!= @config.look "") (!= (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.rules)) @config.rules) "none") (default (let ((sh (object/get @config.variants @entity.variant null))) (if (= @sh null) null @sh.border)) @config.border)))) (not @entity.painted))
    }

    emits {
      GRID_LAYOUT -> internal {
        n : number!
      }
        @description "Place the children from the stored rect."
        @tier "internal"
      GRID_PAINT -> internal {
        n : number!
      }
        @description "Repaint the rules and border from the stored rect, tracks and looks."
        @tier "internal"
      RASM_PLACE -> external {
        n : number!
        placed : [RasmPlaced]!
      }
        @description "The children's cell rects, each with its rotate when the child set one."
        @tier "primary"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
      }
        @description "The gutter hairlines and the frame at the grid's z; emitted only with rules or border on."
        @tier "primary"
      RASM_EXTENT -> external {
        n : number!
        id : string!
        w : number!
        h : number!
      }
        @description "The grid's content height after each layout: the padding, the row gaps and each row's height, a fixed row at its main, a measure row at its tallest child, a fill or fr row at the larger of its min and its tallest child. A parent stack or grid measures this grid by it and grows."
        @tier "primary"
    }

    listens {
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The surface's reading direction; once announced it replaces this atom's direction knob and the layout is redone."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the variant is the first name of chain (the announced breakpoint, then each smaller declared one, stopping at desktop) that `variants` holds, none of them keeping the configured shape, which is the desktop composition; the grid lays out again when the variant changes. With any other variantBy it is ignored."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint the rules and border."
      RASM_SPACE { space : Map string number! }
        @description "The theme's spacing scale for the current breakpoint: gapBy, rowGapBy and paddingBy name its steps, contain caps the tracks at its measure; the layout is redone."
      RASM_RESIZE { width : number!  height : number! }
        @description "The view's size: with fold above 0 the grid is at least fold of the view's height tall."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take this grid's rect when it is placed, then place the children."
      RASM_EXTENT { id : string!  w : number!  h : number!  n : number }
        @description "A child's content height: a measure row is as tall as its tallest child, a fill or fr row at least that tall, and the grid lays out again when it changes."
      RASM_MEASURED { items : [RasmMeasureItem]! }
        @description "Canvas text measurements: a child that is a measured text sizes its row the way a child that reports RASM_EXTENT does."
    }

    config {
      id : string = "grid"
        @label "Id"
        @description "The grid's id: its RASM_PLACE key and its paint id."
        @tier "presentation"
      columns : [RasmTrack] = []
        @label "Columns"
        @description "Column tracks in order: fixed uses main px, fill shares the width left after fixed tracks and gaps equally, fr takes a share weighted by main (default 1): fr 2, fr 1, fr 1 is 2:1:1."
        @tier "presentation"
      rows : [RasmTrack] = []
        @label "Rows"
        @description "Row tracks in order: fixed uses main px, measure is as tall as its tallest single-row child (a child that reports RASM_EXTENT or is a measured text), fill shares the height left after fixed and measure tracks and gaps equally, fr takes a share weighted by main (default 1); a fill or fr row is never shorter than its min or its tallest child; a child spanning rows that needs more than they give (with their gaps) grows the last fr, fill or measure row of its span, or its last row when none is."
        @tier "presentation"
      gap : number = 0
        @label "Column gap"
        @description "Space between columns in px."
        @tier "presentation"
      rowGap : number = 0
        @label "Row gap"
        @description "Space between rows in px."
        @tier "presentation"
      padding : number = 0
        @label "Padding"
        @description "Space between the rect and the tracks on every side in px."
        @tier "presentation"
      gapBy : "" | "tight" | "stack" | "group" | "gutter" | "section" = ""
        @label "Column gap step"
        @description "A step of the theme's spacing scale (RASM_SPACE) used as the column gap instead of gap; empty, or before the scale is announced, uses gap."
        @tier "presentation"
      rowGapBy : "" | "tight" | "stack" | "group" | "gutter" | "section" = ""
        @label "Row gap step"
        @description "A step of the theme's spacing scale used as the row gap instead of rowGap; empty uses rowGap."
        @tier "presentation"
      paddingBy : "" | "tight" | "stack" | "group" | "gutter" | "section" = ""
        @label "Padding step"
        @description "A step of the theme's spacing scale used as the padding instead of padding; empty uses padding."
        @tier "presentation"
      paddingXBy : "" | "tight" | "stack" | "group" | "gutter" | "section" = ""
        @label "Side padding step"
        @description "A step of the theme's spacing scale used for the left and right padding only, so a section can breathe by section top and bottom and by gutter at the sides; empty uses the top and bottom padding."
        @tier "presentation"
      contain : boolean = false
        @label "Contain"
        @description "On, the tracks are no wider than the scale's measure: the left and right padding grow so the content column is centred at that width. Off, or with no measure, the tracks span the rect."
        @tier "presentation"
      fold : number = 0
        @label "Fold"
        @description "0 to 1: the grid reports at least this fraction of the view's height, so a hero holds the first view and its fr rows share it. 0 sizes it by its content alone."
        @tier "presentation"
      direction : "ltr" | "rtl" = "ltr"
        @label "Direction"
        @description "ltr starts column 0 at the left edge, rtl at the right edge; a surface RASM_DIRECTION replaces it."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order of the rules and border on the surface."
        @tier "presentation"
      rules : "none" | "columns" | "rows" | "both" = "none"
        @label "Rules"
        @description "Paint a hairline in the middle of every gutter between columns, rows or both, in the look grid/rule/idle; nothing is painted while the look is absent."
        @tier "presentation"
      look : string = ""
        @label "Look"
        @description "The look key painted as a body under the grid's whole rect (for example a section band in its chapter colour); empty paints no body."
        @tier "presentation"
      border : boolean = false
        @label "Border"
        @description "Paint a frame on the grid's rect in the look grid/border/idle; nothing is painted while the look is absent."
        @tier "presentation"
      variantBy : "" | "breakpoint" = ""
        @label "Variant by"
        @description "\"breakpoint\" picks a shape from `variants` by the surface's breakpoint name, falling back to the next smaller declared variant (desktop and wide stop at desktop), then to the configured shape; empty keeps the configured shape."
        @tier "presentation"
      variants : Map string RasmGridShape = {}
        @label "Variants"
        @description "Shapes by breakpoint name (phone, tablet, desktop, wide): the columns, rows, gap, rowGap, padding, rules, border and children a variant names replace the configured ones while that breakpoint is current; one it leaves out keeps the configured value."
        @tier "presentation"
      children : [RasmGridChild] = []
        @label "Children"
        @description "Each child's column and row (zero-based), optional colSpan and rowSpan (default 1), rotate (radians) and offsetX and offsetY (px, after the cell is computed). align (stretch, the default, fills the cell; start, center or end give a child that reported a smaller height that height, at the top, middle or bottom of its cell, so a frame hugs its content instead of stretching). Cells may overlap; a child whose cell is outside the tracks is not placed."
        @tier "presentation"
    }
  }

  page boot as RasmGridStart -> RasmGrid
}
