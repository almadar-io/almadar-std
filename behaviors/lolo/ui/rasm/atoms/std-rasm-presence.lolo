app std-rasm-presence [
  version: "1.1.0",
  description: "std-rasm-presence — the Rasm entry choreography. On INIT it emits RASM_ENTER { order, staggerMs }: every control whose id is in the order paints with an entry animation staggered by its index. RASM_PRESENCE_PLAY { order } plays the choreography again for the ids it names, for a page that swaps one set of content for another. On a std-rasm-surface with pageScroll on, each `onView` group plays once, the first time its anchor's top crosses the `viewAt` line of the view as the page scrolls (or at once when it is already in view), so content arrives as the reader reaches it."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmPresenceView = { anchor : string!, order : [string]! }
type RasmLayout = { hero : "centered" | "split" | "offset" | "full-bleed" | "poster" | "editorial" | "collage"!, columns : number!, asymmetry : number!, ornament : "none" | "rule" | "double-rule" | "frame" | "stamp"!, align : "start" | "center"!, imageTreatment : "none" | "duotone" | "halftone" | "riso" | "engraving" | "glow" | "grain" | "scanline"!, sectionGap : number!, gutter : number! }
type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number!, scale : number, rotate : number }
type RasmMotion = { signature : string!, stiffness : number!, damping : number!, stagger : number!, enterMs : number, keyframes : [RasmEntryKey] }
type RasmEntryItem = { id : string!, durationMs : number!, keyframes : [RasmEntryKey]! }

orbital RasmPresenceOrbital {
  entity RasmPresenceItem [runtime] {
    id : string!
    anchors : Map string RasmRect @description "The placed rect of every onView anchor seen so far." = {}
    viewH : number @description "The canvas height from RASM_RESIZE." = 0
    offset : number @description "The page scroll from RASM_PAGE_SCROLLED." = 0
    played : [string] @description "The onView anchors whose group has entered." = []
    checks : number @description "Counts checks, so each check in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
    motion : RasmMotion? @description "The announced style's motion, null before a style." = null
  }

  trait RasmPresence -> RasmPresenceItem [client] {
    initial: ready

    state ready {
      INIT -> ready
        (emit PRESENCE_GO { order: @config.order })
      RASM_BOOT -> ready
        (emit PRESENCE_GO { order: @config.order })
      RASM_PRESENCE_PLAY -> ready
        (emit PRESENCE_GO { order: ?order })
      RASM_PLACE -> ready when (array/some ?placed (fn p (array/some @config.onView (fn v (= @v.anchor @p.id)))))
        (set @entity.anchors (array/reduce (array/filter ?placed (fn p (array/some @config.onView (fn v (= @v.anchor @p.id))))) @entity.anchors (fn acc p (object/set @acc @p.id @p.rect))))
        (set @entity.checks (+ @entity.checks 1))
        (emit PRESENCE_CHECK { n: @entity.checks })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (array/some @config.onView (fn v (= @v.anchor @p.id))))))
      RASM_RESIZE -> ready
        (set @entity.viewH ?height)
        (set @entity.checks (+ @entity.checks 1))
        (emit PRESENCE_CHECK { n: @entity.checks })
      RASM_PAGE_SCROLLED -> ready
        (set @entity.offset ?offset)
        (set @entity.checks (+ @entity.checks 1))
        (emit PRESENCE_CHECK { n: @entity.checks })
      PRESENCE_CHECK -> ready when (> @entity.viewH 0)
        (let ((due (array/filter @config.onView (fn v (and (not (array/includes @entity.played @v.anchor)) (object/has @entity.anchors @v.anchor) (let ((a (default (object/get @entity.anchors @v.anchor null) { x: 0, y: 0, w: 0, h: 0 }))) (< @a.y (+ @entity.offset (* @entity.viewH @config.viewAt)))))))))
          (when (> (array/len @due) 0)
            (do
              (set @entity.played (array/concat @entity.played (array/map @due (fn v @v.anchor))))
              (emit PRESENCE_GO { order: (array/flatten (array/map @due (fn v @v.order))) }))))
      PRESENCE_CHECK -> ready when (<= @entity.viewH 0)
      RASM_TREND -> ready
        (set @entity.motion ?motion)
      PRESENCE_GO -> ready
        (emit RASM_ENTER { order: ?order, staggerMs: (if (= @entity.motion null) @config.staggerMs @entity.motion.stagger), entries: (let ((mo @entity.motion)) (if (or (= @mo null) (= @mo.keyframes null)) [] (let ((ks (default @mo.keyframes [])) (ms (default @mo.enterMs 520))) (array/map (array/range 0 (array/len ?order)) (fn i (let ((delay (* @i @mo.stagger))) (let ((dur (+ @ms @delay))) (let ((d (default (/ @delay @dur) 0)) (first (default (array/first @ks) { at: 0, opacity: 1, offsetX: 0, offsetY: 0 }))) { id: (default (array/nth ?order @i) ""), durationMs: @dur, keyframes: (array/concat [{ at: 0, opacity: @first.opacity, offsetX: @first.offsetX, offsetY: @first.offsetY, scale: (default @first.scale 1), rotate: (default @first.rotate 0) }] (array/map @ks (fn k { at: (+ @d (* @k.at (- 1 @d))), opacity: @k.opacity, offsetX: @k.offsetX, offsetY: @k.offsetY, scale: (default @k.scale 1), rotate: (default @k.rotate 0) }))) })))))))) })
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: start the entry choreography."
      RASM_PRESENCE_PLAY { order : [string]! }
        @description "Play the entry choreography again for these control ids, in this order; controls outside it rest in place."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the onView anchors' rects as they are placed."
      RASM_RESIZE { width : number!  height : number! }
        @description "Take the canvas height, the view the anchors are measured against."
      RASM_TREND { name : string!  layout : RasmLayout!  motion : RasmMotion! }
        @description "Take the style's motion: its stagger and its signature's entry keyframes shape every entry from now on."
      RASM_PAGE_SCROLLED { offset : number!  max : number! }
        @description "Take the page scroll and play the onView groups it brought into view."
    }

    emits {
      PRESENCE_GO -> internal {
        order : [string]!
      }
        @description "Play the entry choreography for these ids, in this order."
        @tier "internal"
      PRESENCE_CHECK -> internal {
        n : number!
      }
        @description "Play the onView groups whose anchor is now in view."
        @tier "internal"
      RASM_ENTER -> external {
        order : [string]!
        staggerMs : number!
        entries : [RasmEntryItem]!
      }
        @description "Start the entry choreography: controls in the order enter one after another."
        @tier "domain"
    }

    config {
      order : [string] = []
        @label "Order"
        @description "Control ids in entry order."
        @tier "domain"
      staggerMs : number = 70
        @label "Stagger"
        @description "Milliseconds between one control's entry and the next."
        @tier "presentation"
      onView : [RasmPresenceView] = []
        @label "On view"
        @description "Groups that enter as the page scrolls to them: an anchor (a placed id, a section) and the control ids that enter, in order, the first time the anchor's top crosses the viewAt line."
        @tier "presentation"
      viewAt : number = 0.85
        @label "View line"
        @description "Where in the view, as a fraction of its height from the top, an onView anchor's top must pass for its group to enter."
        @tier "presentation"
    }
  }

  page boot as RasmPresenceStart -> RasmPresence
}
