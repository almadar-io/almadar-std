app std-rasm-anchor [
  version: "1.0.0",
  description: "std-rasm-anchor — pure placement for popups in the Rasm kit. It keeps the rect of every control that RASM_PLACE announced and the surface size from RASM_RESIZE; RASM_ANCHOR { id, anchor, side, width, height } places the popup id on the named side of the anchor's rect (below, above, start or end), flipped to the opposite side when it would leave the surface and the opposite side fits, and clamped inside the surface, then emits RASM_PLACE for that id."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number, origin : string }
type RasmPoint = { x : number!, y : number! }

orbital RasmAnchorOrbital {
  entity RasmAnchorItem [runtime] {
    id : string!
    rects : Map string RasmRect @description "The latest rect announced for each control id, in the origin it was placed in." = {}
    placedIn : Map string string @description "The origin each control's rect is in, by control id, empty for the page." = {}
    pageOrigins : Map string RasmPoint @description "Every origin's page offset from the last RASM_PAGE_ORIGINS: an anchor's page rect is its rect plus its origin's offset." = {}
    viewW : number @description "The surface width popups must stay inside." = 720
    viewH : number @description "The surface height popups must stay inside." = 520
    layouts : number @description "Counts layouts, so each layout in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmAnchor -> RasmAnchorItem [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.viewW @config.width)
        (set @entity.viewH @config.height)
      RASM_PLACE -> ready
        (set @entity.rects (array/reduce ?placed @entity.rects (fn acc p (object/set @acc @p.id @p.rect))))
        (set @entity.placedIn (array/reduce ?placed @entity.placedIn (fn acc p (object/set @acc @p.id (default @p.origin "")))))
      RASM_PAGE_ORIGINS -> ready
        (set @entity.pageOrigins ?offsets)
      RASM_RESIZE -> ready
        (set @entity.viewW ?width)
        (set @entity.viewH ?height)
      RASM_ANCHOR -> ready when (object/has @entity.rects ?anchor)
        (set @entity.layouts (+ @entity.layouts 1))
        (let (
            (a (let ((r (object/get @entity.rects ?anchor { x: 0, y: 0, w: 0, h: 0 })) (o (object/get @entity.pageOrigins (object/get @entity.placedIn ?anchor "") { x: 0, y: 0 }))) { x: (+ @r.x @o.x), y: (+ @r.y @o.y), w: @r.w, h: @r.h }))
            (gap @config.gap)
          )
          (let (
              (vertical (or (= ?side "below") (= ?side "above")))
              (below (+ (+ @a.y @a.h) @gap))
              (above (- (- @a.y @gap) ?height))
              (endX (+ (+ @a.x @a.w) @gap))
              (startX (- (- @a.x @gap) ?width))
            )
            (let (
                (fitsBelow (<= (+ @below ?height) @entity.viewH))
                (fitsAbove (>= @above 0))
                (fitsEnd (<= (+ @endX ?width) @entity.viewW))
                (fitsStart (>= @startX 0))
              )
              (let (
                  (placeBelow (if (= ?side "below") (or @fitsBelow (not @fitsAbove)) (and (not @fitsAbove) @fitsBelow)))
                  (placeEnd (if (= ?side "end") (or @fitsEnd (not @fitsStart)) (and (not @fitsStart) @fitsEnd)))
                )
                (emit RASM_PLACE { n: @entity.layouts, placed: [{ id: ?id, origin: "", rect: { x: (if @vertical (math/max 0 (math/min @a.x (- @entity.viewW ?width))) (if @placeEnd @endX @startX)), y: (if @vertical (if @placeBelow @below @above) (math/max 0 (math/min @a.y (- @entity.viewH ?height)))), w: ?width, h: ?height } }] })))))
    }

    emits {
      RASM_PLACE -> external {
        n : number!
        placed : [RasmPlaced]!
      }
        @description "The popup's placed rect."
        @tier "domain"
    }

    listens {
      RASM_PAGE_ORIGINS { offsets : Map string RasmPoint! }
        @description "Every origin's page offset: an anchor placed in an origin is read at its page position, and the popup is placed on the page."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Placed rects of the controls; the anchor keeps the latest for each id."
      RASM_RESIZE { width : number!  height : number! }
        @description "The surface size popups are kept inside."
      RASM_ANCHOR { id : string!  anchor : string!  side : "below" | "above" | "start" | "end"!  width : number!  height : number! }
        @description "Place popup id next to the anchor's rect."
    }

    config {
      width : number = 720
        @label "Width"
        @description "The surface width before the first resize."
        @tier "presentation"
      height : number = 520
        @label "Height"
        @description "The surface height before the first resize."
        @tier "presentation"
      gap : number = 4
        @label "Gap"
        @description "Px between the anchor and the popup."
        @tier "presentation"
    }
  }

  page boot as RasmAnchorStart -> RasmAnchor
}
