        },
        "astrolabe": {
          "surface/ground/idle": { fill: "#070d22", material: { wgsl: "fn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = max(px.size, vec2<f32>(1.0, 1.0));\n  let q = px.local / sz;\n  var col = mix(vec3<f32>(0.035, 0.06, 0.15), vec3<f32>(0.016, 0.028, 0.075), q.y);\n  let d = length((q - vec2<f32>(0.5, 0.38)) * vec2<f32>(sz.x / sz.y, 1.0));\n  col = col + vec3<f32>(0.05, 0.065, 0.13) * (1.0 - smoothstep(0.0, 0.95, d));\n  let cell = floor(px.local / 23.0);\n  let h = al_hash(cell);\n  let off = vec2<f32>(al_hash(cell + vec2<f32>(3.1, 7.7)), al_hash(cell + vec2<f32>(9.2, 1.3))) - vec2<f32>(0.5, 0.5);\n  let f = fract(px.local / 23.0) - vec2<f32>(0.5, 0.5) - off * 0.7;\n  let r = length(f) * 23.0;\n  let tw = 0.55 + 0.45 * sin(px.time * (0.5 + h * 1.6) + h * 40.0);\n  let star = step(0.93, h) * (1.0 - smoothstep(0.0, 1.2 + h, r)) * tw;\n  col = col + vec3<f32>(0.98, 0.9, 0.72) * star * 0.85;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "stack/panel/idle": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [18, 18, 18, 18], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "text/title/idle": { textColor: "#f3e7c6", font: "600 30px serif", spring: { stiffness: 210, damping: 22 } },
          "text/body/idle": { textColor: "#b4bdd6", font: "400 16px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/idle": { fill: "#c9a35c", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sheen = 0.5 + 0.5 * cos((px.uv.x * 2.2 - px.uv.y) * 3.1 - px.time * 0.15);\n  let brush = (al_hash(vec2<f32>(floor(px.local.y * 1.5), 2.0)) - 0.5) * 0.06;\n  var col = al_brass(0.45 + 0.4 * sheen + 0.12 * px.a.x - 0.2 * px.a.y) + vec3<f32>(brush, brush, brush);\n  let bevel = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = col + vec3<f32>(1.0, 0.95, 0.8) * bevel * 0.25;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1d1407", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/hovered": { fill: "#c9a35c", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sheen = 0.5 + 0.5 * cos((px.uv.x * 2.2 - px.uv.y) * 3.1 - px.time * 0.15);\n  let brush = (al_hash(vec2<f32>(floor(px.local.y * 1.5), 2.0)) - 0.5) * 0.06;\n  var col = al_brass(0.45 + 0.4 * sheen + 0.12 * px.a.x - 0.2 * px.a.y) + vec3<f32>(brush, brush, brush);\n  let bevel = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = col + vec3<f32>(1.0, 0.95, 0.8) * bevel * 0.25;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1d1407", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/pressed": { fill: "#c9a35c", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sheen = 0.5 + 0.5 * cos((px.uv.x * 2.2 - px.uv.y) * 3.1 - px.time * 0.15);\n  let brush = (al_hash(vec2<f32>(floor(px.local.y * 1.5), 2.0)) - 0.5) * 0.06;\n  var col = al_brass(0.45 + 0.4 * sheen + 0.12 * px.a.x - 0.2 * px.a.y) + vec3<f32>(brush, brush, brush);\n  let bevel = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = col + vec3<f32>(1.0, 0.95, 0.8) * bevel * 0.25;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1d1407", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/focused": { fill: "#c9a35c", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sheen = 0.5 + 0.5 * cos((px.uv.x * 2.2 - px.uv.y) * 3.1 - px.time * 0.15);\n  let brush = (al_hash(vec2<f32>(floor(px.local.y * 1.5), 2.0)) - 0.5) * 0.06;\n  var col = al_brass(0.45 + 0.4 * sheen + 0.12 * px.a.x - 0.2 * px.a.y) + vec3<f32>(brush, brush, brush);\n  let bevel = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = col + vec3<f32>(1.0, 0.95, 0.8) * bevel * 0.25;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1d1407", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 }, stroke: "#fff2cc", strokeWidth: 2 },
          "pressable/primary/disabled": { fill: "rgba(201,163,92,0.35)", corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "rgba(29,20,7,0.6)", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/idle": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/hovered": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/pressed": { fill: "rgba(6,12,30,0.92)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/focused": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 }, stroke: "#fff2cc", strokeWidth: 2 },
