          "morph/default/idle": { fill: "rgba(212,175,106,0.9)" },
          "text/display/idle": { textColor: "#f4ead8", font: "400 60px serif", spring: { stiffness: 200, damping: 18 } },
          "text/eyebrow/idle": { textColor: "#d4af6a", font: "600 12px sans-serif", spring: { stiffness: 200, damping: 18 } },
          "stack/card/idle": { fill: "rgba(40,22,42,0.9)", stroke: "rgba(212,175,106,0.30)", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(0,0,0,0.5)", blur: 26 }, spring: { stiffness: 200, damping: 18 } }
        },
        "signal": {
          "surface/ground/idle": { fill: "#0b0f0d", material: { wgsl: "fn sg_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn sg_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = sg_hash(i);\n  let b = sg_hash(i + vec2<f32>(1.0, 0.0));\n  let c = sg_hash(i + vec2<f32>(0.0, 1.0));\n  let d = sg_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = vec3<f32>(0.043, 0.059, 0.051);\n  let near = 1.0 - smoothstep(0.0, 200.0, length(px.local - px.pointer));\n  let gp = vec2<f32>(px.local.x, px.local.y + px.scroll * 0.1);\n  let gx = abs(fract(gp.x / 48.0) - 0.5) * 48.0;\n  let gy = abs(fract(gp.y / 48.0) - 0.5) * 48.0;\n  let grid = max(1.0 - smoothstep(0.0, 1.2, gx), 1.0 - smoothstep(0.0, 1.2, gy));\n  col = col + vec3<f32>(0.008, 0.03, 0.018) * grid * (0.55 + 0.9 * near);\n  let xs = px.local.x + px.time * 20.0;\n  let wave = sin(xs * 0.011) * 0.7 + sin(xs * 0.027 + 1.3) * 0.25 + (sg_noise(vec2<f32>(xs * 0.04, 3.0)) - 0.5) * 0.5;\n  let cy = px.size.y * 0.5 - px.scroll * 0.1;\n  let ty = cy + wave * px.a.x * px.size.y * 0.25;\n  let dd = abs(px.local.y - ty);\n  let line = 1.0 - smoothstep(0.0, 1.4, dd);\n  let glow = exp(-dd / 9.0);\n  col = col + vec3<f32>(0.01, 0.06, 0.03) * (line * 0.9 + glow * 0.3);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0.3, 0, 0, 0], live: true } },
