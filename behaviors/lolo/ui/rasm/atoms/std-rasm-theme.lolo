            "pressable/secondary/pressed": { fill: "secondary", stroke: "primary", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "secondary-foreground", font: "500 16px body", spring: { stiffness: 130, damping: 20 } },
            "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 130, damping: 20 } },
