          "surface/ground/idle": { fill: "#120d0a", material: { wgsl: "fn he_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = max(px.size, vec2<f32>(1.0, 1.0));\n  var col = vec3<f32>(0.0706, 0.051, 0.0392);\n  let warm = smoothstep(0.55, 1.0, px.local.y / sz.y);\n  col = col + vec3<f32>(0.012, 0.006, 0.0) * warm;\n  let q = px.local + vec2<f32>(0.0, px.scroll * 0.15);\n  let cell = floor(q / 120.0);\n  let h = he_hash(cell);\n  if (h < 0.3) {\n    let h2 = he_hash(cell + vec2<f32>(11.0, 3.0));\n    let h3 = he_hash(cell + vec2<f32>(5.0, 17.0));\n    let h4 = he_hash(cell + vec2<f32>(29.0, 7.0));\n    let fy = fract(h3 + px.time * 10.0 / 120.0);\n    let ep = vec2<f32>(10.0 + h2 * 100.0, 120.0 - fy * 120.0);\n    let within = (q - cell * 120.0) - ep;\n    let r = 1.5 + 1.5 * h4;\n    let d = length(within);\n    let dot = 1.0 - smoothstep(r * 0.4, r + 1.0, d);\n    let halo = (1.0 - smoothstep(r, r * 3.0, d)) * 0.25;\n    let life = sin(3.14159 * fy);\n    let flick = 0.75 + 0.25 * sin(px.time * 0.9 + h * 60.0);\n    let dp = length(px.local - px.pointer);\n    let boost = 1.0 + 0.8 * (1.0 - smoothstep(0.0, 180.0, dp));\n    let a = (dot + halo) * life * flick * boost * 0.12;\n    col = mix(col, vec3<f32>(1.0, 0.6, 0.33), clamp(a, 0.0, 0.2));\n  }\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
