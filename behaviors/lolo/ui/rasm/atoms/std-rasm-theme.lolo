        "toggle/switch/off-focused": { fill: "rgba(42,36,51,0.10)", stroke: "#b03a2e", strokeWidth: 2.6, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w fibre scale in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = max(px.a.w, 1.0);\n  let fib = pp_noise(vec2<f32>(px.local.x / (s * 6.0), px.local.y / (s * 0.4)));\n  let tooth = pp_noise(px.local / s);\n  var col = px.color.rgb * (0.96 + 0.05 * tooth) - vec3<f32>(0.03) * smoothstep(0.65, 0.9, fib);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.05, 0.04, 0.02) * exp(-d * d / (2.0 * 80.0 * 80.0)) * (0.4 + px.a.x);\n  let ink = smoothstep(-1.4, 0.0, px.sdf) * (0.35 + 0.35 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.14, 0.12, 0.16), ink);\n  let bleed = smoothstep(-6.0, -1.4, px.sdf) * (1.0 - smoothstep(-1.4, 0.0, px.sdf)) * 0.06 * (0.6 + 0.4 * pp_noise(px.local / 3.0));\n  col = col - vec3<f32>(bleed);\n  col = col * (1.0 - 0.07 * px.a.y);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 4], live: true }, textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
