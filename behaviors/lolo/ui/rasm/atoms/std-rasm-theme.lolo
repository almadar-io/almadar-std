          "choice/popup/idle": { fill: "rgba(246,236,212,0.96)", stroke: "rgba(43,27,15,0.85)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#2b1b0f", font: "500 15px serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/active": { fill: "rgba(192,138,30,0.22)", textColor: "#2b1b0f", font: "500 15px serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "stack/hero/idle": { fill: "rgba(246,236,212,0.96)", corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let grain = jz_noise(px.local * vec2<f32>(0.8, 0.07)) - 0.5;\n  var col = mix(px.behind.rgb, vec3<f32>(0.96, 0.92, 0.82), 0.9) + vec3<f32>(0.025, 0.02, 0.012) * grain + vec3<f32>(0.02, 0.016, 0.006) * px.a.x;\n  let outer = 1.0 - smoothstep(0.45, 1.2, abs(e - 1.0));\n  let inner = 1.0 - smoothstep(0.3, 0.8, abs(e - 5.0));\n  col = mix(col, vec3<f32>(0.17, 0.11, 0.06), outer * (0.85 + 0.15 * px.a.z));\n  col = mix(col, vec3<f32>(0.71, 0.2, 0.12), inner * 0.8);\n  return vec4<f32>(col, 0.98);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 210, damping: 22 } },
          "overlay/scrim/idle": { fill: "rgba(20,12,4,0.45)", spring: { stiffness: 210, damping: 22 } },
          "overlay/dialog/idle": { fill: "rgba(246,236,212,0.96)", corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let grain = jz_noise(px.local * vec2<f32>(0.8, 0.07)) - 0.5;\n  var col = mix(px.behind.rgb, vec3<f32>(0.96, 0.92, 0.82), 0.9) + vec3<f32>(0.025, 0.02, 0.012) * grain + vec3<f32>(0.02, 0.016, 0.006) * px.a.x;\n  let outer = 1.0 - smoothstep(0.45, 1.2, abs(e - 1.0));\n  let inner = 1.0 - smoothstep(0.3, 0.8, abs(e - 5.0));\n  col = mix(col, vec3<f32>(0.17, 0.11, 0.06), outer * (0.85 + 0.15 * px.a.z));\n  col = mix(col, vec3<f32>(0.71, 0.2, 0.12), inner * 0.8);\n  return vec4<f32>(col, 0.98);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 210, damping: 22 } },
