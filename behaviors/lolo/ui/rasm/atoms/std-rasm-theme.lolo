          "drag/default/idle": { fill: "rgba(16,22,52,0.94)", stroke: "rgba(239,226,196,0.4)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "#cdbf9f", font: "500 15px serif", spring: { stiffness: 210, damping: 22 } },
