        "material": {
          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let p = px.uv * vec2<f32>(asp, 1.0);\n  let sh = px.scroll * 0.15;\n  let plane = p.x * 0.55 + p.y - 0.55 - sh;\n  let a = step(0.0, plane) * (1.0 - step(0.5, plane));\n  let edge = smoothstep(0.0, 0.03, plane) * (1.0 - smoothstep(0.03, 0.08, plane));\n  let circ = length(p - vec2<f32>(asp * 0.86, 0.2 - sh)) - 0.3;\n  let cm = 1.0 - step(0.0, circ);\n  let prim = vec3<f32>(0.40, 0.31, 0.64);\n  let tert = vec3<f32>(0.49, 0.32, 0.38);\n  var col = mix(px.color.rgb, prim, a * 0.07);\n  col = mix(col, tert, cm * 0.08);\n  col = col - vec3<f32>(edge * 0.025, edge * 0.025, edge * 0.025);\n  let sd = smoothstep(0.0, 0.08, circ) * (1.0 - smoothstep(0.08, 0.2, circ)) * (1.0 - cm);\n  col = col - vec3<f32>(sd * 0.02, sd * 0.02, sd * 0.02);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
