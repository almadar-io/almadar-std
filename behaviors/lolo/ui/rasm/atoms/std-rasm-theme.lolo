          "mirror/primary/idle": { fill: "rgba(16,22,52,0.94)", corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let grain = jz_noise(px.local * vec2<f32>(0.8, 0.07)) - 0.5;\n  var col = mix(px.behind.rgb, vec3<f32>(0.09, 0.11, 0.24), 0.9) + vec3<f32>(0.025, 0.02, 0.012) * grain + vec3<f32>(0.02, 0.016, 0.006) * px.a.x;\n  let outer = 1.0 - smoothstep(0.45, 1.2, abs(e - 1.0));\n  let inner = 1.0 - smoothstep(0.3, 0.8, abs(e - 5.0));\n  col = mix(col, vec3<f32>(0.94, 0.89, 0.77), outer * (0.85 + 0.15 * px.a.z));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), inner * 0.8);\n  return vec4<f32>(col, 0.98);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 210, damping: 22 } },
          "particles/primary/idle": { fill: "#c08a1e" },
          "orbit/ring/idle": { stroke: "rgba(239,226,196,0.8)", strokeWidth: 2 },
          "orbit/arc/lit": { stroke: "#c08a1e", strokeWidth: 4, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let t = px.uv.x * 2.0 - px.uv.y;\n  let glint = pow(0.5 + 0.5 * cos(t * 6.0 - px.time * 2.4), 6.0);\n  let col = mix(vec3<f32>(0.62, 0.42, 0.08), vec3<f32>(1.0, 0.86, 0.45), 0.35 + 0.65 * glint);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/idle": { fill: "rgba(16,22,52,0.9)", stroke: "rgba(239,226,196,0.8)", strokeWidth: 1.5, spring: { stiffness: 210, damping: 22 } },
          "orbit/station/hovered": { fill: "rgba(16,22,52,0.9)", stroke: "#c08a1e", strokeWidth: 1.5, spring: { stiffness: 210, damping: 22 } },
          "orbit/station/focused": { fill: "rgba(16,22,52,0.9)", stroke: "#c08a1e", strokeWidth: 2.5, spring: { stiffness: 210, damping: 22 } },
          "orbit/station/active": { fill: "#1c3378", stroke: "#c08a1e", strokeWidth: 2, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
          "orbit/beat/idle": { fill: "#c08a1e", stroke: "#c08a1e", strokeWidth: 2 },
          "orbit/label/idle": { textColor: "#cdbf9f", font: "500 15px serif" },
          "orbit/label/active": { textColor: "#efe2c4", font: "700 18px serif" },
          "orbit/core/idle": { fill: "rgba(16,22,52,0.9)", stroke: "rgba(239,226,196,0.4)", strokeWidth: 1 },
          "machine/state/idle": { fill: "rgba(16,22,52,0.9)", stroke: "rgba(239,226,196,0.8)", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  var col = mix(vec3<f32>(0.1, 0.13, 0.28), vec3<f32>(0.1, 0.13, 0.28) * 0.82, smoothstep(0.0, 0.75, length(c)));\n  let rim1 = 1.0 - smoothstep(0.4, 1.2, abs(e - 1.0));\n  let rim2 = 1.0 - smoothstep(0.3, 0.8, abs(e - 4.0));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), clamp(rim1 + rim2 * 0.7, 0.0, 1.0));\n  col = col + vec3<f32>(1.0, 0.9, 0.6) * px.a.x * 0.12;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#efe2c4", font: "600 16px serif" },
          "machine/state/active": { fill: "#1c3378", stroke: "#c08a1e", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f6ecd2", font: "700 16px serif" },
          "machine/state/visited": { fill: "rgba(16,22,52,0.9)", stroke: "#c08a1e", strokeWidth: 1.6, corners: { radius: [10, 10, 10, 10], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  var col = mix(vec3<f32>(0.1, 0.13, 0.28), vec3<f32>(0.1, 0.13, 0.28) * 0.82, smoothstep(0.0, 0.75, length(c)));\n  let rim1 = 1.0 - smoothstep(0.4, 1.2, abs(e - 1.0));\n  let rim2 = 1.0 - smoothstep(0.3, 0.8, abs(e - 4.0));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), clamp(rim1 + rim2 * 0.7, 0.0, 1.0));\n  col = col + vec3<f32>(1.0, 0.9, 0.6) * px.a.x * 0.12;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#efe2c4", font: "600 16px serif" },
          "machine/wire/idle": { stroke: "rgba(239,226,196,0.4)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(239,226,196,0.8)", strokeWidth: 1.6 },
          "machine/wire/lit": { stroke: "#c08a1e", strokeWidth: 3, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let t = px.uv.x * 2.0 - px.uv.y;\n  let glint = pow(0.5 + 0.5 * cos(t * 6.0 - px.time * 2.4), 6.0);\n  let col = mix(vec3<f32>(0.62, 0.42, 0.08), vec3<f32>(1.0, 0.86, 0.45), 0.35 + 0.65 * glint);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(16,22,52,0.9)", stroke: "rgba(239,226,196,0.4)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(16,22,52,0.9)", stroke: "rgba(239,226,196,0.8)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(16,22,52,0.9)", stroke: "#c08a1e", strokeWidth: 1.6, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(192,138,30,0.18)" },
