        },
        "tide": {
          "surface/ground/idle": { fill: "#eef6f5", material: { wgsl: "fn ti_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn ti_layer(p: vec2<f32>, t: f32, ph: f32) -> f32 {\n  let a = sin(p.x * 0.011 + sin(p.y * 0.013 + t * 0.6) * 2.0 + ph);\n  let b = sin(p.y * 0.017 + sin(p.x * 0.009 - t * 0.5) * 2.0 - ph);\n  return 1.0 - abs(a * b);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let base = vec3<f32>(0.9333, 0.9647, 0.9608);\n  let ph = px.scroll * 0.1 * 0.01;\n  let c1 = ti_layer(px.local, px.time, ph);\n  let c2 = ti_layer(px.local * 1.7 + vec2<f32>(40.0, 90.0), px.time * 0.8 + 3.0, -ph);\n  let caustic = pow(max(c1 * c2, 0.0), 2.0);\n  var lum = (caustic - 0.35) * 0.04;\n  let d = length(px.local - px.pointer);\n  let ring = sin(d * 0.045 - px.time * 0.7);\n  let fade = 1.0 - smoothstep(40.0, 200.0, d);\n  lum = lum + ring * fade * 0.012;\n  let col = base + vec3<f32>(lum, lum * 0.9, lum * 0.8);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
