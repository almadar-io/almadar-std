          "drag/default/idle": { fill: "rgba(227,184,120,0.14)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "rgba(255,241,214,0.82)", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
