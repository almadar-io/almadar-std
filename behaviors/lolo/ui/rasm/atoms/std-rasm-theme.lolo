        "range/default/thumb-focused": { fill: "#ffffff", stroke: "#2a2433", strokeWidth: 1, shadow: { color: "rgba(60,45,30,0.4)", blur: 8 }, textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 }, decor: "ink-dot" },
        "textfield/default/idle": { fill: "rgba(42,36,51,0.05)", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [5, 5, 5, 5], kind: "round" }, textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
