        "ledger": {
          "surface/ground/idle": { fill: "#f3efe6", material: { wgsl: "fn lg_line(g: f32, s: f32) -> f32 {\n  let d = abs(fract(g / s + 0.5) - 0.5) * s;\n  return 1.0 - smoothstep(0.25, 1.1, d);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let base = vec3<f32>(0.9529, 0.9373, 0.9020);\n  let p = px.local;\n  let sz = max(px.size, vec2<f32>(1.0, 1.0));\n  let ph = px.scroll * 0.002;\n  let f1 = lg_line(p.y + 18.0 * sin(p.x * 0.021 + ph * 6.0), 7.0);\n  let f2 = lg_line(p.y + 11.0 * sin(p.x * 0.037 - ph * 9.0 + 1.3) + 0.3 * p.x, 11.0);\n  let c = vec2<f32>(sz.x * 0.82, sz.y * 0.28 - px.scroll * 0.002 * 60.0);\n  let q = p - c;\n  let ang = atan2(q.y, q.x);\n  let ros = lg_line(length(q) + 16.0 * sin(ang * 9.0 + ph * 8.0), 8.0) * (1.0 - smoothstep(180.0, 380.0, length(q)));\n  let ink = clamp(f1 * 0.5 + f2 * 0.5 + ros * 0.9, 0.0, 1.0);\n  let d = length(p - px.pointer);\n  let near = 1.0 - smoothstep(0.0, 200.0, d);\n  let k = 0.032 + 0.018 * near;\n  let col = base * (1.0 - k * ink) - vec3<f32>(0.0, 0.004, 0.012) * ink * near;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
