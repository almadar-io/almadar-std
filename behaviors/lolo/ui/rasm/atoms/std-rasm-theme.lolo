          "toggle/switch/on-idle": { fill: "#2f6282", stroke: "#f2a03a", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
