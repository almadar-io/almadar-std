        "scandi": {
          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn sc_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let q = px.local;\n  let warp = sc_h(floor(q / 3.0)) * 0.5;\n  let wx = 0.5 + 0.5 * sin(q.x * 2.1 + warp * 6.0);\n  let wy = 0.5 + 0.5 * sin(q.y * 2.1 + warp * 6.0);\n  let linen = (wx * wy - 0.25) * 0.022;\n  let birch = sin(q.x * 0.05 + sin(q.y * 0.004 + px.scroll * 1.5) * 3.0) * smoothstep(0.78, 1.0, px.uv.x);\n  let streak = max(birch, 0.0) * 0.03;\n  let tint = vec3<f32>(0.96, 0.93, 0.86);\n  var col = mix(px.color.rgb, px.color.rgb * tint, 0.35);\n  col = col - vec3<f32>(linen, linen, linen) - vec3<f32>(streak * 0.9, streak, streak * 1.2);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
