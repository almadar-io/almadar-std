        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/on-focused": { on: "surface/ground/idle", fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", stroke: "ring", strokeWidth: 2 },
        "toggle/switch/on-hovered": { on: "surface/ground/idle", fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
