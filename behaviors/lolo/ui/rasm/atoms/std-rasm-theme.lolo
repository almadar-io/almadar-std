            "surface/ground/idle": { fill: "background", material: { wgsl: "fn bd_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(12.9898, 78.233))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let lum = dot(c, vec3<f32>(0.33, 0.33, 0.33));\n let amb = vec3<f32>(0.96, 0.65, 0.14);\n let blu = vec3<f32>(0.35, 0.69, 0.85);\n let cell = vec2<f32>(48.0, 18.0);\n let id = floor(px.local / cell);\n let f = fract(px.local / cell);\n let gl = max(step(f.x, 0.02), step(f.y, 0.04));\n let ink = select(vec3<f32>(0.1, 0.2, 0.43), vec3<f32>(0.5, 0.6, 0.8), lum < 0.5);\n c = mix(c, ink, gl * 0.1);\n let tk = floor(px.time * 0.25);\n let hv = bd_h(id + vec2<f32>(tk, 0.0));\n let bar = step(f.x, 0.12 + hv * 0.4) * step(0.55, f.y) * step(0.62, bd_h(id));\n let up = step(0.5, bd_h(id + vec2<f32>(7.0, 3.0)));\n c = mix(c, mix(blu, amb, up), bar * 0.12);\n let rule = step(px.local.y, 2.0);\n c = mix(c, amb, rule * 0.5);\n let head = step(px.local.y, 20.0) * step(2.0, px.local.y);\n c = mix(c, amb, head * 0.05);\n let sc = fract(px.local.x / 1200.0 + px.time * 0.02 + px.scroll * 0.3);\n c = mix(c, amb, step(abs(px.local.y - 11.0), 1.0) * step(0.4, fract(px.local.x / 6.0)) * 0.05 * step(sc, 0.9));\n let dp = length(px.local - px.pointer);\n c = mix(c, amb, 0.04 * exp(-dp / 90.0));\n return vec4<f32>(c, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: false } },
            "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(0,0,0,0.55)", blur: 28, offsetX: 0, offsetY: 14 }, spring: { stiffness: 380, damping: 36 } },
