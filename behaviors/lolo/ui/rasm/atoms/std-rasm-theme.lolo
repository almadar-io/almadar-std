            "pressable/primary/idle": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(40,34,24,0.22)", blur: 18, offsetX: 0, offsetY: 8 }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 90, damping: 24 } },
