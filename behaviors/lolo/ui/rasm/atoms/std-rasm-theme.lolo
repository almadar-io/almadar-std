            "pressable/primary/idle": { fill: "primary", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 16px display", shadow: { color: "rgba(0,80,180,0.4)", blur: 8, offsetY: 3 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n let v = px.uv.y;\n let top = smoothstep(0.3, 0.0, v);\n let gel = vec3<f32>(1.0, 1.0, 1.0) * top * 0.38;\n let low = smoothstep(0.5, 1.0, v) * 0.12;\n let rgb = px.color.rgb + gel + vec3<f32>(low, low, low) * 0.5;\n return vec4<f32>(rgb, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: false }, spring: { stiffness: 240, damping: 20 } },
            "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 16px display", shadow: { color: "rgba(0,80,180,0.5)", blur: 12, offsetY: 4 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n let v = px.uv.y;\n let top = smoothstep(0.3, 0.0, v);\n let rgb = px.color.rgb + vec3<f32>(1.0, 1.0, 1.0) * top * 0.45;\n return vec4<f32>(rgb, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: false }, spring: { stiffness: 240, damping: 20 } },
            "pressable/primary/pressed": { fill: "primary", stroke: "primary-hover", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 16px display", spring: { stiffness: 280, damping: 20 } },
