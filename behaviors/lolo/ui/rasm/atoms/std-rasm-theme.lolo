        "textfield/default/disabled": { fill: "rgba(42,36,51,0.02)", strokeWidth: 0, corners: { radius: [5, 5, 5, 5], kind: "round" }, textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
