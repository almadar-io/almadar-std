          "orbit/beat/idle": { stroke: "#5fd3c6", fill: "rgba(95,211,198,0.4)" },
          "orbit/label/idle": { textColor: "rgba(243,232,207,0.92)", font: "400 13px Cairo, sans-serif" },
          "orbit/label/active": { textColor: "#f4cf72", font: "600 13px Cairo, sans-serif" },
          "orbit/core/idle": { fill: "rgba(13,15,34,0.97)", stroke: "rgba(233,185,73,0.65)", strokeWidth: 1.2, backdrop: { blur: 8, tint: "rgba(95,211,198,0.4)", saturate: 1.1 } },
          "machine/state/idle": { fill: "rgba(13,15,34,0.82)", stroke: "rgba(233,185,73,0.6)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(243,232,207,0.92)", font: "400 16px Cairo, sans-serif" },
          "machine/state/active": { fill: "#183a78", stroke: "#e9b949", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fbf1d6", font: "600 15px Cairo, sans-serif", material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(13,15,34,0.82)", stroke: "#e9b949", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(243,232,207,0.92)", font: "400 16px Cairo, sans-serif" },
