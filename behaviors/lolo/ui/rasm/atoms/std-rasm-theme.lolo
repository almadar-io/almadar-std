            "card/header/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px display", on: "card/header/idle", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n let v = px.uv.y;\n let rgb = px.color.rgb + vec3<f32>(0.05, 0.05, 0.05) * (1.0 - v) - vec3<f32>(0.05, 0.05, 0.05) * v;\n return vec4<f32>(rgb, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: false } },
