          "range/default/thumb-hovered": { fill: "#eef0f7", stroke: "rgba(238,240,247,0.4)", strokeWidth: 1.2, shadow: { color: "rgba(143,107,255,0.5)", blur: 20 }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 }, decor: "" },
