        "card/surface/pressed": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(0,0,0,0.08)", blur: 8, offsetY: 2 }, spring: { stiffness: 220, damping: 24 } },
