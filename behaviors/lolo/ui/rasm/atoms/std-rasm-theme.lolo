          "orbit/label/idle": { textColor: "rgba(230,236,255,0.75)", font: "400 13px sans-serif" },
          "orbit/label/active": { textColor: "#f4f7ff", font: "600 13px sans-serif" },
          "orbit/core/idle": { fill: "rgba(40,52,92,0.58)", stroke: "rgba(255,255,255,0.40)", strokeWidth: 1.2, backdrop: { blur: 16, tint: "rgba(255,255,255,0.08)", saturate: 1.4 } },
          "machine/state/idle": { fill: "rgba(255,255,255,0.10)", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(230,236,255,0.75)", font: "400 15px sans-serif" },
          "machine/state/active": { fill: "rgba(120,160,255,0.55)", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#ffffff", font: "600 15px sans-serif", material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(255,255,255,0.10)", stroke: "rgba(160,195,255,0.95)", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(230,236,255,0.75)", font: "400 15px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(230,236,255,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(230,236,255,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "rgba(160,195,255,0.95)", strokeWidth: 2.5 },
          "machine/pill/idle": { fill: "rgba(40,52,92,0.58)", stroke: "rgba(230,236,255,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(40,52,92,0.58)", stroke: "rgba(230,236,255,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(40,52,92,0.58)", stroke: "rgba(160,195,255,0.95)", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(255,255,255,0.22)" },
          "machine/event/idle": { textColor: "rgba(244,247,255,0.85)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#ffffff", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(255,255,255,0.10)", stroke: "rgba(244,247,255,0.85)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "rgba(120,160,255,0.55)", textColor: "#ffffff", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "rgba(120,160,255,0.55)", stroke: "rgba(160,195,255,0.95)", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "rgba(160,195,255,0.95)", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(244,247,255,0.85)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(40,52,92,0.58)", stroke: "rgba(255,255,255,0.4)", strokeWidth: 1.2, corners: { radius: [26, 26, 26, 26], kind: "round" }, backdrop: { blur: 22, tint: "rgba(40,52,92,0.25)", saturate: 1.5 } },
          "text/code/idle": { textColor: "rgba(244,247,255,0.85)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#ffffff", font: "700 14px monospace" }
        },
        "sand": {
          "surface/ground/idle": { fill: "#6b4a2a", material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// dune ridges drifting on the wind, grain glitter, a warm lamp under the pointer\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = px.time * 9.0;\n  let p = px.local + vec2<f32>(wind, wind * 0.35);\n  let ridge = sin(p.x * 0.012 + 2.4 * sd_noise(p * 0.004) + px.uv.y * 5.0) * 0.5 + 0.5;\n  let crest = smoothstep(0.55, 0.9, ridge) - smoothstep(0.9, 1.0, ridge) * 0.6;\n  var col = mix(vec3<f32>(0.36, 0.24, 0.13), vec3<f32>(0.62, 0.45, 0.26), px.uv.y);\n  col = col + vec3<f32>(0.30, 0.20, 0.09) * crest * 0.55;\n  col = col - vec3<f32>(0.10, 0.08, 0.05) * (1.0 - ridge) * 0.35;\n  let g = sd_hash(floor(px.local / 1.5) + floor(px.time * 2.0));\n  col = col + vec3<f32>(0.9, 0.75, 0.5) * step(0.985, g) * 0.35;\n  let streak = sd_noise(vec2<f32>(p.x * 0.02, p.y * 0.4));\n  col = col + vec3<f32>(0.08, 0.06, 0.03) * streak * (0.5 + 0.5 * sin(px.time * 0.4));\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.78, 0.45) * exp(-d * d / (2.0 * 170.0 * 170.0)) * 0.32;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 14 } },
          "stack/panel/idle": { fill: "rgba(88,60,34,0.88)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [30, 30, 30, 30], kind: "round" }, shadow: { color: "rgba(40,22,8,0.5)", blur: 34 }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, spring: { stiffness: 120, damping: 14 }, decor: "dune-ripple" },
          "text/title/idle": { textColor: "#fff1d6", font: "600 28px serif", spring: { stiffness: 120, damping: 14 } },
          "text/body/idle": { textColor: "rgba(255,241,214,0.82)", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "pressable/primary/idle": { fill: "#b8662a", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, textColor: "#fff6e4", font: "600 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "pressable/primary/hovered": { fill: "#cc7a3a", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(40,22,8,0.45)", blur: 14 }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, textColor: "#fff6e4", font: "600 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "pressable/primary/pressed": { fill: "#9a5220", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, textColor: "#fff6e4", font: "600 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "pressable/primary/focused": { fill: "#b8662a", stroke: "#ffe2a6", strokeWidth: 2.4, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 2.5], live: true }, textColor: "#fff6e4", font: "600 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "pressable/primary/disabled": { fill: "rgba(184,102,42,0.35)", stroke: "rgba(227,184,120,0.35)", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, textColor: "rgba(255,246,228,0.4)", font: "600 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
