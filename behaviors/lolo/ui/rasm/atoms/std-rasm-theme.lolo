          "orbit/station/focused": { fill: "rgba(88,60,34,0.88)", stroke: "#ffe2a6", strokeWidth: 2.4, shadow: { color: "rgba(40,22,8,0.5)", blur: 10 }, spring: { stiffness: 120, damping: 14 } },
