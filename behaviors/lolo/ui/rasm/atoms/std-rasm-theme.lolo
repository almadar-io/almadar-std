        "choice/option/idle": { fill: "rgba(0,0,0,0)", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
        "choice/option/active": { fill: "#2a2433", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#fbf7ec", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } }
