        "toggle/switch/on-idle": { fill: "#14753a", stroke: "#8dffb2", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "toggle/switch/on-hovered": { fill: "#14753a", stroke: "#8dffb2", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "toggle/switch/on-focused": { fill: "#14753a", stroke: "#8dffb2", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "range/default/track": { fill: "rgba(47,209,106,0.2)", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
