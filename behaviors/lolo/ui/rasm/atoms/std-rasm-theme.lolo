          "textfield/default/disabled": { fill: "rgba(8,14,36,0.9)", stroke: "rgba(201,163,92,0.55)", strokeWidth: 0, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "rgba(243,231,198,0.45)", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/idle": { fill: "rgba(8,14,36,0.9)", stroke: "rgba(201,163,92,0.55)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/hovered": { fill: "rgba(8,14,36,0.9)", stroke: "#c9a35c", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/focused": { fill: "rgba(8,14,36,0.9)", stroke: "#fff2cc", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/open": { fill: "rgba(8,14,36,0.9)", stroke: "#f0d58f", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/label": { textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/label": { textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/placeholder": { textColor: "#7d87a6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/selection": { fill: "rgba(201,163,92,0.32)", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/caret": { fill: "#f0d58f", spring: { stiffness: 210, damping: 22 } },
          "choice/popup/idle": { fill: "rgba(8,14,36,0.97)", stroke: "rgba(201,163,92,0.6)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#f3e7c6", font: "500 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/active": { fill: "rgba(201,163,92,0.22)", textColor: "#fff3cf", font: "500 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "stack/hero/idle": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [18, 18, 18, 18], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "overlay/scrim/idle": { fill: "rgba(4,8,22,0.6)", backdrop: { blur: 8, tint: "rgba(4,8,22,0.2)", saturate: 1.0 }, spring: { stiffness: 210, damping: 22 } },
          "overlay/dialog/idle": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/body": { fill: "rgba(0,0,0,0)", strokeWidth: 0, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/track": { fill: "rgba(201,163,92,0.1)", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/thumb": { fill: "rgba(201,163,92,0.6)", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/thumb-dragging": { fill: "#f0d58f", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "drag/default/idle": { fill: "rgba(10,18,44,0.7)", stroke: "rgba(201,163,92,0.4)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "#b4bdd6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "drag/default/dragging": { fill: "rgba(14,24,56,0.9)", stroke: "#f0d58f", strokeWidth: 1.5, corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "#f3e7c6", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "mirror/primary/idle": { fill: "rgba(10,18,44,0.86)", backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 }, corners: { radius: [18, 18, 18, 18], kind: "round" }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let base = mix(px.behind.rgb, vec3<f32>(0.035, 0.06, 0.15), 0.8) + vec3<f32>(0.03, 0.025, 0.01) * px.a.x;\n  let outer = 1.0 - smoothstep(0.5, 1.3, abs(e - 1.2));\n  let inner = 1.0 - smoothstep(0.35, 0.9, abs(e - 5.5));\n  let frame = outer * (0.85 + 0.15 * px.a.z) + inner * 0.4;\n  let sheen = 0.5 + 0.5 * cos((px.uv.x - px.uv.y) * 3.0 - px.time * 0.1);\n  let col = mix(base, al_brass(0.4 + 0.55 * sheen), clamp(frame, 0.0, 1.0));\n  return vec4<f32>(col, 0.97);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "particles/primary/idle": { fill: "#f0d58f" },
          "orbit/ring/idle": { stroke: "#c9a35c", strokeWidth: 26, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn al_tick(u: f32, n: f32, circ: f32) -> f32 {\n  let x = fract(u * n);\n  return min(x, 1.0 - x) * circ / n;\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.local - px.size * 0.5;\n  let r = length(c);\n  let ang = atan2(c.y, c.x);\n  let u = ang / 6.2831853 + 0.5;\n  let fromOuter = px.size.x * 0.5 - r;\n  let circ = 6.2831853 * max(r, 1.0);\n  let minor = (1.0 - smoothstep(0.25, 0.85, al_tick(u, 180.0, circ))) * (1.0 - step(5.0, fromOuter));\n  let mid = (1.0 - smoothstep(0.35, 1.0, al_tick(u, 36.0, circ))) * (1.0 - step(9.0, fromOuter));\n  let major = (1.0 - smoothstep(0.5, 1.3, al_tick(u, 12.0, circ))) * (1.0 - step(15.0, fromOuter));\n  let groove = 1.0 - smoothstep(0.3, 0.9, abs(fromOuter - 16.5));\n  let eng = max(max(minor, mid), max(major, groove));\n  let sheen = 0.5 + 0.5 * cos(2.0 * ang - px.time * 0.12);\n  let brush = (al_hash(vec2<f32>(floor(r * 1.7), 1.0)) - 0.5) * 0.08;\n  var col = al_brass(0.28 + 0.62 * sheen * sheen) + vec3<f32>(brush, brush, brush);\n  col = mix(col, vec3<f32>(0.16, 0.10, 0.04), eng * 0.85);\n  let bevel = 1.0 - smoothstep(0.0, 1.8, -px.sdf);\n  col = col + vec3<f32>(1.0, 0.93, 0.72) * bevel * 0.3;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/arc/lit": { stroke: "#eaf6ff", strokeWidth: 6, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let c = px.local - px.size * 0.5;\n  let ang = atan2(c.y, c.x);\n  let core = 1.0 - smoothstep(0.0, 2.6, abs(px.sdf + 3.0));\n  let g = 0.8 + 0.2 * sin(ang * 14.0 - px.time * 5.0);\n  let col = mix(vec3<f32>(0.55, 0.78, 1.0), vec3<f32>(1.0, 1.0, 1.0), core) * g;\n  return vec4<f32>(col, 0.75 + 0.25 * core);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/idle": { fill: "#0c1531", stroke: "#c9a35c", strokeWidth: 2, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = abs((px.uv - vec2<f32>(0.5, 0.5)) * 2.0);\n  let k = max(p.x * 0.28 + p.y, p.x + p.y * 0.28);\n  let s = 1.0 - smoothstep(0.5, 0.58, k);\n  let enamel = vec3<f32>(0.05, 0.085, 0.2);\n  var col = mix(enamel, al_brass(0.55 + 0.35 * px.a.x), s);\n  let rim = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = mix(col, al_brass(0.85), rim * 0.8);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
          "orbit/station/hovered": { fill: "#121d40", stroke: "#f0d58f", strokeWidth: 2, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = abs((px.uv - vec2<f32>(0.5, 0.5)) * 2.0);\n  let k = max(p.x * 0.28 + p.y, p.x + p.y * 0.28);\n  let s = 1.0 - smoothstep(0.5, 0.58, k);\n  let enamel = vec3<f32>(0.05, 0.085, 0.2);\n  var col = mix(enamel, al_brass(0.55 + 0.35 * px.a.x), s);\n  let rim = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = mix(col, al_brass(0.85), rim * 0.8);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
          "orbit/station/focused": { fill: "#121d40", stroke: "#fff2cc", strokeWidth: 3, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = abs((px.uv - vec2<f32>(0.5, 0.5)) * 2.0);\n  let k = max(p.x * 0.28 + p.y, p.x + p.y * 0.28);\n  let s = 1.0 - smoothstep(0.5, 0.58, k);\n  let enamel = vec3<f32>(0.05, 0.085, 0.2);\n  var col = mix(enamel, al_brass(0.55 + 0.35 * px.a.x), s);\n  let rim = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = mix(col, al_brass(0.85), rim * 0.8);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
          "orbit/station/active": { fill: "#f0d58f", stroke: "#fff6dc", strokeWidth: 2, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = abs((px.uv - vec2<f32>(0.5, 0.5)) * 2.0);\n  let k = max(p.x * 0.28 + p.y, p.x + p.y * 0.28);\n  let s = 1.0 - smoothstep(0.5, 0.58, k);\n  let enamel = vec3<f32>(0.62, 0.45, 0.18);\n  var col = mix(vec3<f32>(0.95, 0.78, 0.42), vec3<f32>(1.0, 0.98, 0.9), s);\n  col = col + vec3<f32>(1.0, 0.85, 0.5) * (0.12 + 0.1 * sin(px.time * 2.4));\n  let rim = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = mix(col, al_brass(0.85), rim * 0.8);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/beat/idle": { fill: "#f4fbff", stroke: "#bfe2ff", strokeWidth: 2 },
          "orbit/label/idle": { textColor: "#c9b37e", font: "600 15px serif" },
          "orbit/label/active": { textColor: "#fff3cf", font: "700 19px serif" },
          "orbit/core/idle": { fill: "#0b1432", stroke: "#c9a35c", strokeWidth: 1.5, material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_line(d: f32, w: f32) -> f32 {\n  return 1.0 - smoothstep(w * 0.5, w * 0.5 + 0.012, abs(d));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.local - px.size * 0.5;\n  let R = max(px.size.x * 0.5, 1.0);\n  let p = c / R;\n  let r = length(p);\n  let t = px.time * 0.025;\n  let ca = cos(t);\n  let sa = sin(t);\n  let p1 = vec2<f32>(p.x * ca - p.y * sa, p.x * sa + p.y * ca);\n  let p2 = vec2<f32>((p1.x - p1.y) * 0.70710678, (p1.x + p1.y) * 0.70710678);\n  let sq1 = max(abs(p1.x), abs(p1.y));\n  let sq2 = max(abs(p2.x), abs(p2.y));\n  let khatam = max(al_line(sq1 - 0.5, 0.018), al_line(sq2 - 0.5, 0.018));\n  let ang = atan2(p1.y, p1.x);\n  let x = fract(ang / 6.2831853 * 12.0);\n  let spoke = (1.0 - smoothstep(0.004, 0.016, min(x, 1.0 - x) * 6.2831853 * r / 12.0)) * step(0.72, r) * step(r, 0.9);\n  let rings = max(max(al_line(r - 0.92, 0.014), al_line(r - 0.72, 0.01)), al_line(r - 0.16, 0.012));\n  let eng = max(max(khatam, spoke), rings);\n  let enamel = mix(vec3<f32>(0.07, 0.11, 0.25), vec3<f32>(0.025, 0.045, 0.12), r);\n  let sheen = 0.55 + 0.45 * cos(2.0 * atan2(p.y, p.x) - px.time * 0.12);\n  let col = mix(enamel, al_brass(0.35 + 0.6 * sheen), eng);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/idle": { fill: "rgba(10,18,44,0.86)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#b4bdd6", font: "400 16px sans-serif" },
          "machine/state/active": { fill: "#c9a35c", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#1d1407", font: "600 15px sans-serif", material: { wgsl: "fn al_brass(t: f32) -> vec3<f32> {\n  return mix(vec3<f32>(0.40, 0.28, 0.12), vec3<f32>(0.96, 0.83, 0.52), clamp(t, 0.0, 1.0));\n}\nfn al_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sheen = 0.5 + 0.5 * cos((px.uv.x * 2.2 - px.uv.y) * 3.1 - px.time * 0.15);\n  let brush = (al_hash(vec2<f32>(floor(px.local.y * 1.5), 2.0)) - 0.5) * 0.06;\n  var col = al_brass(0.45 + 0.4 * sheen + 0.12 * px.a.x - 0.2 * px.a.y) + vec3<f32>(brush, brush, brush);\n  let bevel = 1.0 - smoothstep(0.0, 1.6, -px.sdf);\n  col = col + vec3<f32>(1.0, 0.95, 0.8) * bevel * 0.25;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(10,18,44,0.86)", stroke: "#eaf6ff", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#b4bdd6", font: "400 16px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(180,189,214,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(180,189,214,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#eaf6ff", strokeWidth: 2.5, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let c = px.local - px.size * 0.5;\n  let ang = atan2(c.y, c.x);\n  let core = 1.0 - smoothstep(0.0, 2.6, abs(px.sdf + 3.0));\n  let g = 0.8 + 0.2 * sin(ang * 14.0 - px.time * 5.0);\n  let col = mix(vec3<f32>(0.55, 0.78, 1.0), vec3<f32>(1.0, 1.0, 1.0), core) * g;\n  return vec4<f32>(col, 0.75 + 0.25 * core);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(5,10,26,0.95)", stroke: "rgba(180,189,214,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(5,10,26,0.95)", stroke: "rgba(180,189,214,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(5,10,26,0.95)", stroke: "#eaf6ff", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(10,18,44,0.86)" },
          "machine/event/idle": { textColor: "#c3cbe2", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#ffe7ad", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(10,18,44,0.86)", stroke: "#c3cbe2", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#c9a35c", textColor: "#1d1407", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "#f0d58f", stroke: "#eaf6ff", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#eaf6ff", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "#c3cbe2", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(5,10,26,0.95)", stroke: "rgba(201,163,92,0.55)", strokeWidth: 1, corners: { radius: [18, 18, 18, 18], kind: "round" }, backdrop: { blur: 16, tint: "rgba(6,12,32,0.35)", saturate: 1.1 } },
          "text/code/idle": { textColor: "#c3cbe2", font: "400 14px monospace" },
          "text/code/active": { textColor: "#ffe7ad", font: "700 14px monospace", fill: "rgba(201,163,92,0.16)", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let g = 0.12 + 0.05 * sin(px.uv.x * 6.0 - px.time * 1.5);\n  return vec4<f32>(vec3<f32>(0.85, 0.66, 0.3), g);\n}\n", params: [0, 0, 0, 0], live: true } }
        },
        "prism": {
          "surface/ground/idle": { fill: "#f7f6f2", material: { wgsl: "// white light parted into faint slow caustic bands and gathered back to white; the hue phase follows the pointer\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = vec2<f32>(max(px.size.x, 1.0), max(px.size.y, 1.0));\n  let q = px.local / sz.x;\n  let pm = px.pointer / sz;\n  let t = px.time * 0.03;\n  let w = q.x * 1.1 + q.y * 0.7 + 0.35 * sin(q.y * 5.0 + t * 6.0) + 0.25 * sin(q.x * 3.0 - t * 4.0);\n  let band = 0.5 + 0.5 * sin(w * 9.0 + t * 8.0);\n  let spec = pr_hue(fract(w * 0.35 + t + pm.x * 0.25 + pm.y * 0.15));\n  var col = vec3<f32>(0.969, 0.965, 0.949);\n  col = mix(col, spec, 0.05 * band);\n  col = col + vec3<f32>(0.018, 0.018, 0.018) * (1.0 - band);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "stack/panel/idle": { fill: "rgba(255,255,255,0.62)", backdrop: { blur: 22, tint: "rgba(255,255,255,0.35)", saturate: 1.2 }, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(60,70,150,0.14)", blur: 36 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "text/title/idle": { textColor: "#1b1d2a", font: "600 26px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "text/body/idle": { textColor: "#454861", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/idle": { fill: "rgba(255,255,255,0.94)", corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(60,70,150,0.14)", blur: 10 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/hovered": { fill: "#ffffff", corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(60,70,150,0.26)", blur: 22 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/pressed": { fill: "rgba(244,244,250,0.96)", corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(60,70,150,0.12)", blur: 6 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
