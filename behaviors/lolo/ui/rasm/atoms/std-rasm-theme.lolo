        "range/default/thumb-dragging": { fill: "#d4ffe2", stroke: "#0a421f", strokeWidth: 1, shadow: { color: "rgba(47,209,106,0.6)", blur: 10 }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 }, decor: "block" },
        "range/default/thumb-focused": { fill: "#d4ffe2", stroke: "#0a421f", strokeWidth: 1, shadow: { color: "rgba(47,209,106,0.6)", blur: 10 }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 }, decor: "block" },
        "textfield/default/idle": { fill: "rgba(47,209,106,0.06)", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "textfield/default/hovered": { fill: "rgba(47,209,106,0.14)", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "textfield/default/focused": { fill: "rgba(47,209,106,0.06)", stroke: "#8dffb2", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "textfield/default/disabled": { fill: "rgba(47,209,106,0.03)", strokeWidth: 0, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "choice/default/idle": { fill: "rgba(47,209,106,0.06)", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "choice/default/hovered": { fill: "rgba(47,209,106,0.14)", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "choice/default/focused": { fill: "rgba(47,209,106,0.06)", stroke: "#8dffb2", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "choice/default/open": { fill: "rgba(47,209,106,0.14)", stroke: "#8dffb2", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "textfield/default/label": { textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
