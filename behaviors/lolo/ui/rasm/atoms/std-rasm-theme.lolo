          "overlay/scrim/idle": { fill: "rgba(15,16,24,0.6)", backdrop: { blur: 8, tint: "rgba(15,16,24,0.2)", saturate: 1.1 }, spring: { stiffness: 210, damping: 22 } },
          "overlay/dialog/idle": { fill: "rgba(35,38,55,0.92)", backdrop: { blur: 28, tint: "rgba(255,255,255,0.03)", saturate: 1.1 }, stroke: "rgba(238,240,247,0.18)", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(0,0,0,0.6)", blur: 56 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
