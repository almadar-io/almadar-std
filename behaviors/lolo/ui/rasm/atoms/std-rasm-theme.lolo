          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn rt_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(12.9898, 78.233))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let c = vec2<f32>(0.5 * asp, 0.78 + px.scroll * 0.08);\n  let p = vec2<f32>(px.uv.x * asp, px.uv.y);\n  let r = length(p - c);\n  let sun = 1.0 - smoothstep(0.30, 0.31, r);\n  let slit = smoothstep(0.35, 0.50, fract((px.uv.y - c.y) * 22.0 + 0.0) * select(0.0, 1.0, px.uv.y > c.y));\n  let band = floor(clamp((r - 0.02) / 0.075, 0.0, 6.0));\n  var tint = mix(vec3<f32>(0.95, 0.75, 0.20), vec3<f32>(0.85, 0.22, 0.20), clamp(band / 4.0 + (p.y - c.y) * 0.0, 0.0, 1.0));\n  tint = mix(tint, vec3<f32>(0.70, 0.30, 0.45), clamp((band - 4.0) / 2.0, 0.0, 1.0));\n  let stripe = floor((px.uv.y - 0.55) * 14.0);\n  let hs = (1.0 - smoothstep(0.02, 0.06, abs(fract((px.uv.y - 0.55) * 14.0) - 0.5) - 0.28)) * step(0.0, px.uv.y - 0.55) * step(0.3, r);\n  let scol = mix(vec3<f32>(0.90, 0.50, 0.15), vec3<f32>(0.55, 0.25, 0.40), clamp(stripe / 6.0, 0.0, 1.0));\n  var col = px.color.rgb;\n  col = mix(col, scol, hs * 0.07 * smoothstep(0.0, 0.5, px.uv.y - 0.55));\n  col = mix(col, tint, sun * (1.0 - slit * 0.0) * 0.16 * (1.0 - step(0.5, slit) * 0.0));\n  let n = rt_h(floor(px.local * 0.5) + floor(px.time * 3.0)) - 0.5;\n  col = col + n * 0.045;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
