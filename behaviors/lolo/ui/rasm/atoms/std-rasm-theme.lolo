          "pressable/primary/focused": { fill: "#4dff9a", corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "#06110b", font: "600 15px sans-serif", spring: { stiffness: 300, damping: 30 }, stroke: "#4dff9a", strokeWidth: 2 },
