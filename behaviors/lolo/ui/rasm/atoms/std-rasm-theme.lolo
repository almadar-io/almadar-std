            "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "primary", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "500 15px display", shadow: { color: "rgba(0,0,0,0.28)", blur: 10 }, spring: { stiffness: 240, damping: 20 } },
            "text/display/idle": { textColor: "foreground", font: "300 76px display" },
            "text/title/idle": { textColor: "foreground", font: "500 36px display" },
            "text/eyebrow/idle": { textColor: "accent", font: "600 13px display" },
            "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
            "text/card/idle": { textColor: "card-foreground", font: "600 20px display" },
            "morph/default/idle": { fill: "primary" },
            "ornament/signature/idle": { fill: "primary", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_bubble(p: vec2<f32>, r: f32) -> vec2<f32> { let ring = sg_line(length(p) - r, 1.3) * 0.9; let body = sg_fill(length(p) - r) * 0.2; let hl = sg_fill(length((p - vec2<f32>(-0.35 * r, -0.4 * r)) / vec2<f32>(1.6, 1.0)) - 0.16 * r); return vec2<f32>(max(ring, body), hl); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nvar col = px.color.rgb;\nvar a = 0.0;\nfor (var i = 0; i < 3; i = i + 1) {\n  let f = f32(i);\n  let pos = vec2<f32>(s.x * (0.25 + 0.25 * f), c.y + sin(f * 2.1) * m * 0.1);\n  let b = sg_bubble(p - pos, m * (0.34 - 0.07 * f));\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), b.y * 0.9);\n  a = max(a, max(b.x, b.y));\n}\nreturn sg_out(px, col, a);\n}\n", params: [0, 0, 0, 0], live: false } },
            "window/frame/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(0,0,0,0.3)", blur: 22, offsetY: 8 } },
            "window/titlebar/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px display" },
            "window/control/idle": { fill: "primary", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n let v = px.uv.y;\n let top = smoothstep(0.5, 0.0, v);\n let gel = vec3<f32>(1.0, 1.0, 1.0) * top * 0.38;\n let low = smoothstep(0.5, 1.0, v) * 0.12;\n let rgb = px.color.rgb + gel + vec3<f32>(low, low, low) * 0.5;\n return vec4<f32>(rgb, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: false } }
