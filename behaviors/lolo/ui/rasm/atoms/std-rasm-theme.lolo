          "toggle/switch/on-focused": { fill: "#1c3378", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#2b1b0f", font: "500 15px serif", stroke: "#c08a1e", strokeWidth: 2 },
