          "textfield/default/focused": { fill: "rgba(255,255,255,0.9)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "#2b3a9e", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/disabled": { fill: "rgba(255,255,255,0.35)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, strokeWidth: 0, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/idle": { fill: "rgba(255,255,255,0.7)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "rgba(27,29,42,0.3)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/hovered": { fill: "rgba(255,255,255,0.85)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "rgba(27,29,42,0.5)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/focused": { fill: "rgba(255,255,255,0.9)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "#2b3a9e", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/open": { fill: "rgba(255,255,255,0.9)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "#2b3a9e", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/label": { textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "choice/default/label": { textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/placeholder": { textColor: "#6a6d82", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/selection": { fill: "rgba(120,130,255,0.30)", spring: { stiffness: 210, damping: 22 } },
          "textfield/default/caret": { fill: "#2b3a9e", spring: { stiffness: 210, damping: 22 } },
          "choice/popup/idle": { fill: "rgba(255,255,255,0.88)", backdrop: { blur: 24, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "rgba(27,29,42,0.14)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(40,50,110,0.22)", blur: 28 }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#1b1d2a", font: "400 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/active": { fill: "rgba(143,107,255,0.14)", textColor: "#1b1d2a", font: "400 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "stack/hero/idle": { fill: "rgba(255,255,255,0.62)", backdrop: { blur: 22, tint: "rgba(255,255,255,0.35)", saturate: 1.2 }, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(60,70,150,0.14)", blur: 36 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "overlay/scrim/idle": { fill: "rgba(247,246,242,0.55)", backdrop: { blur: 8, tint: "rgba(247,246,242,0.2)", saturate: 1.1 }, spring: { stiffness: 210, damping: 22 } },
          "overlay/dialog/idle": { fill: "rgba(255,255,255,0.84)", backdrop: { blur: 28, tint: "rgba(255,255,255,0.35)", saturate: 1.2 }, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(40,50,110,0.26)", blur: 56 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/body": { fill: "rgba(0,0,0,0)", strokeWidth: 0, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/track": { fill: "rgba(27,29,42,0.08)", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/thumb": { fill: "rgba(60,70,150,0.55)", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(60,70,150,0.25)", blur: 12 }, spring: { stiffness: 210, damping: 22 } },
          "scroll/default/thumb-dragging": { fill: "#2b3a9e", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(60,70,150,0.25)", blur: 20 }, spring: { stiffness: 210, damping: 22 } },
          "drag/default/idle": { fill: "rgba(255,255,255,0.5)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "#454861", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "drag/default/dragging": { fill: "rgba(255,255,255,0.8)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "#454861", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 }, shadow: { color: "rgba(60,70,150,0.22)", blur: 36 } },
          "mirror/primary/idle": { fill: "rgba(255,255,255,0.62)", backdrop: { blur: 22, tint: "rgba(255,255,255,0.35)", saturate: 1.2 }, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(60,70,150,0.14)", blur: 36 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "particles/primary/idle": { fill: "#6b6fe8" },
          "orbit/ring/idle": { stroke: "rgba(60,70,150,0.5)", strokeWidth: 1.2, material: { wgsl: "// a hairline whose hue runs the whole spectrum once around the circle\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let spec = pr_hue(ang + px.time * 0.01);\n  return vec4<f32>(spec, 0.85);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/arc/lit": { stroke: "#6b6fe8", strokeWidth: 3, material: { wgsl: "// the travelled arc: the same spectrum, brighter\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let spec = pr_hue(ang + px.time * 0.04);\n  return vec4<f32>(mix(spec, vec3<f32>(1.0, 1.0, 1.0), 0.12), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/idle": { fill: "#ffffff", stroke: "rgba(27,29,42,0.28)", strokeWidth: 1.2, shadow: { color: "rgba(60,70,150,0.14)", blur: 10 }, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/hovered": { fill: "#ffffff", stroke: "rgba(27,29,42,0.5)", strokeWidth: 1.4, shadow: { color: "rgba(143,107,255,0.4)", blur: 16 }, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/focused": { fill: "#ffffff", stroke: "#2b3a9e", strokeWidth: 2.4, shadow: { color: "rgba(60,70,150,0.14)", blur: 10 }, spring: { stiffness: 210, damping: 22 } },
          "orbit/station/active": { fill: "#ffffff", stroke: "rgba(27,29,42,0.5)", strokeWidth: 1.6, shadow: { color: "rgba(143,107,255,0.4)", blur: 22 }, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/beat/idle": { stroke: "#6b6fe8", fill: "rgba(143,107,255,0.3)" },
          "orbit/label/idle": { textColor: "#454861", font: "400 13px sans-serif" },
          "orbit/label/active": { textColor: "#1b1d2a", font: "600 13px sans-serif" },
          "orbit/core/idle": { fill: "rgba(255,255,255,0.7)", stroke: "rgba(27,29,42,0.2)", strokeWidth: 1.2, backdrop: { blur: 16, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/idle": { fill: "rgba(255,255,255,0.62)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#454861", font: "400 15px sans-serif" },
          "machine/state/active": { fill: "rgba(255,255,255,0.94)", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#1b1d2a", font: "600 15px sans-serif", material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(255,255,255,0.62)", stroke: "#6b6fe8", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#454861", font: "400 15px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(69,72,97,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(69,72,97,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#6b6fe8", strokeWidth: 2.5, material: { wgsl: "// the travelled arc: the same spectrum, brighter\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let spec = pr_hue(ang + px.time * 0.04);\n  return vec4<f32>(mix(spec, vec3<f32>(1.0, 1.0, 1.0), 0.12), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(252,252,250,0.88)", stroke: "rgba(69,72,97,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(252,252,250,0.88)", stroke: "rgba(69,72,97,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(252,252,250,0.88)", stroke: "#6b6fe8", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(255,255,255,0.72)" },
          "machine/event/idle": { textColor: "#2f3248", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#1b1d2a", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(255,255,255,0.62)", stroke: "#2f3248", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "rgba(255,255,255,0.94)", textColor: "#1b1d2a", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "#ffffff", stroke: "#6b6fe8", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#6b6fe8", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "#2f3248", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(252,252,250,0.88)", stroke: "rgba(27,29,42,0.14)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, backdrop: { blur: 18, tint: "rgba(255,255,255,0.35)", saturate: 1.2 } },
          "text/code/idle": { textColor: "#2f3248", font: "400 14px monospace" },
          "text/code/active": { textColor: "#1b1d2a", font: "700 14px monospace", fill: "rgba(143,107,255,0.10)", material: { wgsl: "// a pale spectral band behind the active source line\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let spec = pr_hue(px.uv.x * 0.9 + px.time * 0.03);\n  return vec4<f32>(mix(vec3<f32>(1.0, 1.0, 1.0), spec, 0.22), 0.55);\n}\n", params: [0, 0, 0, 0], live: true } }
        },
        "prism-ink": {
          "surface/ground/idle": { fill: "#0f1018", material: { wgsl: "// the spectrum glowing faintly on tinted ink; the hue phase follows the pointer\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = vec2<f32>(max(px.size.x, 1.0), max(px.size.y, 1.0));\n  let q = px.local / sz.x;\n  let pm = px.pointer / sz;\n  let t = px.time * 0.03;\n  let w = q.x * 1.1 + q.y * 0.7 + 0.35 * sin(q.y * 5.0 + t * 6.0) + 0.25 * sin(q.x * 3.0 - t * 4.0);\n  let band = 0.5 + 0.5 * sin(w * 9.0 + t * 8.0);\n  let spec = pr_hue(fract(w * 0.35 + t + pm.x * 0.25 + pm.y * 0.15));\n  var col = vec3<f32>(0.059, 0.063, 0.094);\n  col = col + spec * 0.05 * band;\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.03, 0.03, 0.04) * exp(-d * d / 90000.0);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "stack/panel/idle": { fill: "rgba(23,25,37,0.78)", backdrop: { blur: 20, tint: "rgba(255,255,255,0.03)", saturate: 1.1 }, stroke: "rgba(238,240,247,0.14)", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(0,0,0,0.5)", blur: 36 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "text/title/idle": { textColor: "#eef0f7", font: "600 26px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "text/body/idle": { textColor: "rgba(238,240,247,0.74)", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/idle": { fill: "#1f2234", stroke: "rgba(238,240,247,0.18)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/hovered": { fill: "#262a3f", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(143,107,255,0.3)", blur: 18 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/pressed": { fill: "#2e3249", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/focused": { fill: "#1f2234", stroke: "#8fb4ff", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/disabled": { fill: "rgba(31,34,52,0.5)", stroke: "rgba(238,240,247,0.08)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "rgba(238,240,247,0.38)", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/idle": { fill: "rgba(23,25,37,0.6)", stroke: "rgba(238,240,247,0.14)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/hovered": { fill: "rgba(31,34,52,0.8)", stroke: "rgba(238,240,247,0.28)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/pressed": { fill: "rgba(38,42,63,0.9)", stroke: "rgba(238,240,247,0.28)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "500 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
