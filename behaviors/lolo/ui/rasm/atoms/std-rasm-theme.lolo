          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(243,232,207,0.9)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(13,15,34,0.97)", stroke: "rgba(233,185,73,0.6)", strokeWidth: 1.2, corners: { radius: [18, 18, 18, 18], kind: "notch" }, backdrop: { blur: 10, tint: "rgba(95,211,198,0.4)", saturate: 1.1 } },
          "text/code/idle": { textColor: "rgba(243,232,207,0.9)", font: "400 14px monospace" },
