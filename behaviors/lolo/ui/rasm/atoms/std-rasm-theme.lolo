          "scroll/default/track": { fill: "rgba(20,20,20,0.1)", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 90, damping: 18 } },
          "scroll/default/thumb": { fill: "#141414", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(20,20,20,0.15)", blur: 12 }, spring: { stiffness: 90, damping: 18 } },
          "scroll/default/thumb-dragging": { fill: "#c9a14a", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(20,20,20,0.15)", blur: 20 }, spring: { stiffness: 90, damping: 18 } },
          "drag/default/idle": { fill: "rgba(247,243,232,0.7)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(20,20,20,0.86)", font: "400 15px serif", spring: { stiffness: 90, damping: 18 } },
          "drag/default/dragging": { fill: "rgba(247,243,232,0.95)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(20,20,20,0.86)", font: "400 15px serif", spring: { stiffness: 90, damping: 18 }, shadow: { color: "rgba(20,20,20,0.25)", blur: 28 } },
          "mirror/primary/idle": { fill: "rgba(247,243,232,0.97)", backdrop: { blur: 0, tint: "rgba(247,243,232,0)", saturate: 1.0 }, stroke: "#141414", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(20,20,20,0.12)", blur: 18 }, spring: { stiffness: 90, damping: 18 } },
          "particles/primary/idle": { fill: "#c9a14a" },
          "orbit/ring/idle": { stroke: "rgba(20,20,20,0.7)", strokeWidth: 1.1 },
          "orbit/arc/lit": { stroke: "#c9a14a", strokeWidth: 3, material: { wgsl: "// the travelled arc: gold leaf with a moving glint\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let g = pow(max(0.0, sin(atan2(c.y, c.x) * 3.0 - px.time * 0.8)), 8.0);\n  return vec4<f32>(mix(vec3<f32>(0.788, 0.631, 0.290), vec3<f32>(1.0, 0.92, 0.6), g * 0.6), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/idle": { fill: "rgba(247,243,232,0.97)", stroke: "#141414", strokeWidth: 1.2, shadow: { color: "rgba(20,20,20,0.15)", blur: 10 }, spring: { stiffness: 90, damping: 18 } },
          "orbit/station/hovered": { fill: "#ffffff", stroke: "#141414", strokeWidth: 1.4, shadow: { color: "rgba(201,161,74,0.5)", blur: 16 }, spring: { stiffness: 90, damping: 18 } },
          "orbit/station/focused": { fill: "rgba(247,243,232,0.97)", stroke: "#141414", strokeWidth: 2.4, shadow: { color: "rgba(20,20,20,0.15)", blur: 10 }, spring: { stiffness: 90, damping: 18 } },
          "orbit/station/active": { fill: "#c9a14a", stroke: "#141414", strokeWidth: 1.6, shadow: { color: "rgba(201,161,74,0.5)", blur: 22 }, spring: { stiffness: 90, damping: 18 }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/beat/idle": { stroke: "#c9a14a", fill: "rgba(201,161,74,0.35)" },
          "orbit/label/idle": { textColor: "rgba(20,20,20,0.78)", font: "400 13px serif" },
          "orbit/label/active": { textColor: "#141414", font: "600 13px serif" },
          "orbit/core/idle": { fill: "rgba(247,243,232,0.97)", stroke: "#141414", strokeWidth: 1.2, backdrop: { blur: 0, tint: "rgba(247,243,232,0)", saturate: 1.0 } },
          "machine/state/idle": { fill: "rgba(247,243,232,0.97)", stroke: "#141414", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(20,20,20,0.86)", font: "400 15px serif" },
          "machine/state/active": { fill: "#c9a14a", stroke: "#141414", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#141414", font: "600 15px serif", material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(247,243,232,0.97)", stroke: "#c9a14a", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(20,20,20,0.86)", font: "400 15px serif" },
          "machine/wire/idle": { stroke: "rgba(20,20,20,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(20,20,20,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#c9a14a", strokeWidth: 2.5, material: { wgsl: "// the travelled arc: gold leaf with a moving glint\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let g = pow(max(0.0, sin(atan2(c.y, c.x) * 3.0 - px.time * 0.8)), 8.0);\n  return vec4<f32>(mix(vec3<f32>(0.788, 0.631, 0.290), vec3<f32>(1.0, 0.92, 0.6), g * 0.6), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(247,243,232,0.99)", stroke: "rgba(20,20,20,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(247,243,232,0.99)", stroke: "rgba(20,20,20,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(247,243,232,0.99)", stroke: "#c9a14a", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(20,20,20,0.07)" },
          "machine/event/idle": { textColor: "rgba(20,20,20,0.86)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#141414", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(247,243,232,0.97)", stroke: "rgba(20,20,20,0.86)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#c9a14a", stroke: "#141414", textColor: "#141414", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px serif" },
          "machine/token/idle": { fill: "#c9a14a", stroke: "#c9a14a", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#c9a14a", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(20,20,20,0.86)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(247,243,232,0.99)", stroke: "#141414", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, backdrop: { blur: 0, tint: "rgba(247,243,232,0)", saturate: 1.0 } },
          "text/code/idle": { textColor: "rgba(20,20,20,0.86)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#141414", font: "700 14px monospace", fill: "rgba(201,161,74,0.35)" }
        },
        "aurora": {
          "surface/ground/idle": { fill: "#070b18", material: { wgsl: "// a sparse static star field and three slow ribbons of light that drift with time and bend toward the pointer\nfn au_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn au_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(au_hash(i), au_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(au_hash(i + vec2<f32>(0.0, 1.0)), au_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn au_ribbon(uv: vec2<f32>, pm: vec2<f32>, t: f32, k: f32) -> f32 {\n  var y0 = 0.26 + 0.17 * k + 0.07 * sin(uv.x * (3.0 + k) + t * (2.0 + k) + k * 2.1) + 0.04 * sin(uv.x * 7.0 - t * 3.0 + k);\n  let pull = exp(-(uv.x - pm.x) * (uv.x - pm.x) * 10.0);\n  y0 = y0 + (pm.y - y0) * 0.30 * pull;\n  let d = uv.y - y0;\n  let fall = exp(-d * d * 55.0);\n  let curtain = 0.6 + 0.4 * sin(uv.x * 11.0 + k * 3.0 + t * 4.0);\n  return fall * curtain;\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = vec2<f32>(max(px.size.x, 1.0), max(px.size.y, 1.0));\n  let uv = px.local / sz;\n  let pm = px.pointer / sz;\n  let t = px.time * 0.05;\n  var col = mix(vec3<f32>(0.020, 0.035, 0.080), vec3<f32>(0.027, 0.043, 0.094), uv.y);\n  let cell = floor(px.local / 3.0);\n  let h = au_hash(cell);\n  let star = step(0.9985, h) * (0.5 + 0.5 * au_hash(cell + vec2<f32>(7.0, 3.0)));\n  let green = au_ribbon(uv, pm, t, 0.0);\n  let violet = au_ribbon(uv, pm, t * 0.8 + 1.7, 1.0);\n  let teal = au_ribbon(uv, pm, t * 1.2 + 3.1, 2.0);\n  col = col + vec3<f32>(0.36, 0.95, 0.69) * green * 0.20;\n  col = col + vec3<f32>(0.56, 0.42, 1.0) * violet * 0.18;\n  col = col + vec3<f32>(0.22, 0.77, 0.84) * teal * 0.16;\n  col = col + vec3<f32>(0.8, 0.85, 1.0) * star * 0.8 * (1.0 - clamp(green + violet + teal, 0.0, 1.0) * 0.6);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 18 } },
          "stack/panel/idle": { fill: "rgba(14,20,40,0.62)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.28)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(0,0,0,0.5)", blur: 36 }, material: { wgsl: "// dark frosted glass with a cool hairline rim and a faint sheen of the ribbons; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let rim = smoothstep(-1.8, -0.6, px.sdf);\n  let sheen = 0.5 + 0.5 * sin(px.local.x * 0.01 + px.time * 0.1 + px.local.y * 0.006);\n  var col = px.color.rgb + mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), sheen) * (0.025 + 0.02 * px.a.x);\n  col = mix(col, vec3<f32>(0.55, 0.85, 0.95), rim * (0.30 + 0.25 * px.a.x + 0.3 * px.a.z));\n  return vec4<f32>(col, max(px.color.a, rim * 0.4));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 18 } },
          "text/title/idle": { textColor: "#eaf1ff", font: "600 26px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "text/body/idle": { textColor: "rgba(234,241,255,0.8)", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/primary/idle": { fill: "rgba(14,22,44,0.85)", stroke: "rgba(150,205,235,0.45)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f2fbff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/primary/hovered": { fill: "rgba(18,28,54,0.9)", stroke: "rgba(150,205,235,0.7)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(92,242,176,0.35)", blur: 18 }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f2fbff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/primary/pressed": { fill: "rgba(10,16,34,0.95)", stroke: "rgba(150,205,235,0.7)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f2fbff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/primary/focused": { fill: "rgba(14,22,44,0.85)", stroke: "#8ff7d0", strokeWidth: 2.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f2fbff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/primary/disabled": { fill: "rgba(14,22,44,0.4)", stroke: "rgba(150,205,235,0.15)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "rgba(242,251,255,0.4)", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/secondary/idle": { fill: "rgba(255,255,255,0.05)", stroke: "rgba(150,205,235,0.35)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/secondary/hovered": { fill: "rgba(255,255,255,0.1)", stroke: "rgba(150,205,235,0.55)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/secondary/pressed": { fill: "rgba(255,255,255,0.16)", stroke: "rgba(150,205,235,0.55)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/secondary/focused": { fill: "rgba(255,255,255,0.05)", stroke: "#8ff7d0", strokeWidth: 2.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "pressable/secondary/disabled": { fill: "rgba(255,255,255,0.03)", stroke: "rgba(150,205,235,0.12)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "rgba(234,241,255,0.4)", font: "500 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/check/off-idle": { fill: "rgba(255,255,255,0.06)", stroke: "rgba(150,205,235,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/check/off-hovered": { fill: "rgba(255,255,255,0.06)", stroke: "rgba(150,205,235,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/check/off-focused": { fill: "rgba(255,255,255,0.06)", stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/check/on-idle": { fill: "rgba(14,22,44,0.9)", stroke: "#5cf2b0", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// a switched-on control: the ribbons gathered, green to violet; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  let col = mix(px.color.rgb, wash, 0.7 + 0.1 * px.a.x);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/check/on-hovered": { fill: "rgba(14,22,44,0.9)", stroke: "#5cf2b0", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// a switched-on control: the ribbons gathered, green to violet; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  let col = mix(px.color.rgb, wash, 0.7 + 0.1 * px.a.x);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/check/on-focused": { fill: "rgba(14,22,44,0.9)", stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// a switched-on control: the ribbons gathered, green to violet; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  let col = mix(px.color.rgb, wash, 0.7 + 0.1 * px.a.x);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/switch/off-idle": { fill: "rgba(255,255,255,0.06)", stroke: "rgba(150,205,235,0.45)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/switch/off-hovered": { fill: "rgba(255,255,255,0.06)", stroke: "rgba(150,205,235,0.45)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/switch/off-focused": { fill: "rgba(255,255,255,0.06)", stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/switch/on-idle": { fill: "rgba(14,22,44,0.9)", stroke: "#5cf2b0", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// a switched-on control: the ribbons gathered, green to violet; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  let col = mix(px.color.rgb, wash, 0.7 + 0.1 * px.a.x);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/switch/on-hovered": { fill: "rgba(14,22,44,0.9)", stroke: "#5cf2b0", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// a switched-on control: the ribbons gathered, green to violet; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  let col = mix(px.color.rgb, wash, 0.7 + 0.1 * px.a.x);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "toggle/switch/on-focused": { fill: "rgba(14,22,44,0.9)", stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// a switched-on control: the ribbons gathered, green to violet; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  let col = mix(px.color.rgb, wash, 0.7 + 0.1 * px.a.x);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "range/default/track": { fill: "rgba(234,241,255,0.14)", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "range/default/fill": { fill: "#5cf2b0", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "range/default/thumb-idle": { fill: "#eaf1ff", stroke: "rgba(150,205,235,0.5)", strokeWidth: 1.2, shadow: { color: "rgba(92,242,176,0.5)", blur: 12 }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 }, decor: "" },
          "range/default/thumb-hovered": { fill: "#eaf1ff", stroke: "rgba(150,205,235,0.5)", strokeWidth: 1.2, shadow: { color: "rgba(92,242,176,0.5)", blur: 20 }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 }, decor: "" },
          "range/default/thumb-dragging": { fill: "#eaf1ff", stroke: "rgba(150,205,235,0.5)", strokeWidth: 1.2, shadow: { color: "rgba(92,242,176,0.5)", blur: 20 }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 }, decor: "" },
          "range/default/thumb-focused": { fill: "#eaf1ff", stroke: "#8ff7d0", strokeWidth: 2, shadow: { color: "rgba(92,242,176,0.5)", blur: 20 }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 }, decor: "" },
          "textfield/default/idle": { fill: "rgba(14,20,40,0.6)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.32)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/hovered": { fill: "rgba(14,20,40,0.72)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.5)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/focused": { fill: "rgba(14,20,40,0.78)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/disabled": { fill: "rgba(14,20,40,0.35)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, strokeWidth: 0, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "choice/default/idle": { fill: "rgba(14,20,40,0.6)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.32)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "choice/default/hovered": { fill: "rgba(14,20,40,0.72)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.5)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "choice/default/focused": { fill: "rgba(14,20,40,0.78)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "choice/default/open": { fill: "rgba(14,20,40,0.8)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "#8ff7d0", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/label": { textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "choice/default/label": { textColor: "#eaf1ff", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/placeholder": { textColor: "rgba(234,241,255,0.5)", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/selection": { fill: "rgba(143,107,255,0.4)", spring: { stiffness: 120, damping: 18 } },
          "textfield/default/caret": { fill: "#8ff7d0", spring: { stiffness: 120, damping: 18 } },
          "choice/popup/idle": { fill: "rgba(12,18,36,0.93)", backdrop: { blur: 22, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.3)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(0,0,0,0.55)", blur: 26 }, spring: { stiffness: 120, damping: 18 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#eaf1ff", font: "300 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 120, damping: 18 } },
          "choice/option/active": { fill: "rgba(92,242,176,0.18)", textColor: "#eaf1ff", font: "300 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 120, damping: 18 } },
          "stack/hero/idle": { fill: "rgba(14,20,40,0.62)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.28)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(0,0,0,0.5)", blur: 40 }, material: { wgsl: "// dark frosted glass with a cool hairline rim and a faint sheen of the ribbons; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let rim = smoothstep(-1.8, -0.6, px.sdf);\n  let sheen = 0.5 + 0.5 * sin(px.local.x * 0.01 + px.time * 0.1 + px.local.y * 0.006);\n  var col = px.color.rgb + mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), sheen) * (0.025 + 0.02 * px.a.x);\n  col = mix(col, vec3<f32>(0.55, 0.85, 0.95), rim * (0.30 + 0.25 * px.a.x + 0.3 * px.a.z));\n  return vec4<f32>(col, max(px.color.a, rim * 0.4));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 18 } },
          "overlay/scrim/idle": { fill: "rgba(4,7,16,0.6)", backdrop: { blur: 8, tint: "rgba(4,7,16,0.2)", saturate: 1.1 }, spring: { stiffness: 120, damping: 18 } },
          "overlay/dialog/idle": { fill: "rgba(12,18,36,0.9)", backdrop: { blur: 26, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.3)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(0,0,0,0.6)", blur: 56 }, material: { wgsl: "// dark frosted glass with a cool hairline rim and a faint sheen of the ribbons; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let rim = smoothstep(-1.8, -0.6, px.sdf);\n  let sheen = 0.5 + 0.5 * sin(px.local.x * 0.01 + px.time * 0.1 + px.local.y * 0.006);\n  var col = px.color.rgb + mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), sheen) * (0.025 + 0.02 * px.a.x);\n  col = mix(col, vec3<f32>(0.55, 0.85, 0.95), rim * (0.30 + 0.25 * px.a.x + 0.3 * px.a.z));\n  return vec4<f32>(col, max(px.color.a, rim * 0.4));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 18 } },
          "scroll/default/body": { fill: "rgba(0,0,0,0)", strokeWidth: 0, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 120, damping: 18 } },
          "scroll/default/track": { fill: "rgba(234,241,255,0.1)", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 120, damping: 18 } },
          "scroll/default/thumb": { fill: "rgba(92,242,176,0.7)", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(92,242,176,0.4)", blur: 12 }, spring: { stiffness: 120, damping: 18 } },
          "scroll/default/thumb-dragging": { fill: "#8f6bff", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(92,242,176,0.4)", blur: 20 }, spring: { stiffness: 120, damping: 18 } },
          "drag/default/idle": { fill: "rgba(255,255,255,0.06)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(234,241,255,0.8)", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 } },
          "drag/default/dragging": { fill: "rgba(255,255,255,0.14)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(234,241,255,0.8)", font: "300 15px sans-serif", spring: { stiffness: 120, damping: 18 }, shadow: { color: "rgba(0,0,0,0.5)", blur: 36 } },
          "mirror/primary/idle": { fill: "rgba(14,20,40,0.62)", backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 }, stroke: "rgba(150,205,235,0.28)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(0,0,0,0.5)", blur: 36 }, material: { wgsl: "// dark frosted glass with a cool hairline rim and a faint sheen of the ribbons; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let rim = smoothstep(-1.8, -0.6, px.sdf);\n  let sheen = 0.5 + 0.5 * sin(px.local.x * 0.01 + px.time * 0.1 + px.local.y * 0.006);\n  var col = px.color.rgb + mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), sheen) * (0.025 + 0.02 * px.a.x);\n  col = mix(col, vec3<f32>(0.55, 0.85, 0.95), rim * (0.30 + 0.25 * px.a.x + 0.3 * px.a.z));\n  return vec4<f32>(col, max(px.color.a, rim * 0.4));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 18 } },
          "particles/primary/idle": { fill: "#8ff7d0" },
          "orbit/ring/idle": { stroke: "rgba(150,205,235,0.45)", strokeWidth: 1.2, material: { wgsl: "// a quiet cool track with a trace of the ribbons\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let k = abs(fract(atan2(c.y, c.x) / 6.2831853 + 0.5) * 2.0 - 1.0);\n  return vec4<f32>(mix(vec3<f32>(0.22, 0.77, 0.84), vec3<f32>(0.56, 0.42, 1.0), k), 0.5);\n}\n", params: [0, 0, 0, 0], live: false } },
          "orbit/arc/lit": { stroke: "#5cf2b0", strokeWidth: 3, material: { wgsl: "// the travelled arc: aurora green into violet and back around the circle\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let k = abs(fract(atan2(c.y, c.x) / 6.2831853 + 0.5 + px.time * 0.03) * 2.0 - 1.0);\n  return vec4<f32>(mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), k), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, shadow: { color: "rgba(92,242,176,0.55)", blur: 14 } },
          "orbit/station/idle": { fill: "rgba(14,22,44,0.9)", stroke: "rgba(150,205,235,0.5)", strokeWidth: 1.2, shadow: { color: "rgba(0,0,0,0.5)", blur: 10 }, spring: { stiffness: 120, damping: 18 } },
          "orbit/station/hovered": { fill: "rgba(18,28,54,0.95)", stroke: "rgba(150,205,235,0.8)", strokeWidth: 1.4, shadow: { color: "rgba(92,242,176,0.45)", blur: 16 }, spring: { stiffness: 120, damping: 18 } },
          "orbit/station/focused": { fill: "rgba(14,22,44,0.9)", stroke: "#8ff7d0", strokeWidth: 2.4, shadow: { color: "rgba(0,0,0,0.5)", blur: 10 }, spring: { stiffness: 120, damping: 18 } },
          "orbit/station/active": { fill: "rgba(14,22,44,0.95)", stroke: "#5cf2b0", strokeWidth: 1.6, shadow: { color: "rgba(92,242,176,0.45)", blur: 22 }, spring: { stiffness: 120, damping: 18 } },
          "orbit/beat/idle": { stroke: "#8f6bff", fill: "rgba(143,107,255,0.35)" },
          "orbit/label/idle": { textColor: "rgba(234,241,255,0.74)", font: "400 13px sans-serif" },
          "orbit/label/active": { textColor: "#eaf1ff", font: "600 13px sans-serif" },
          "orbit/core/idle": { fill: "rgba(12,18,36,0.8)", stroke: "rgba(150,205,235,0.35)", strokeWidth: 1.2, backdrop: { blur: 16, tint: "rgba(60,90,160,0.08)", saturate: 1.15 } },
          "machine/state/idle": { fill: "rgba(14,20,40,0.62)", stroke: "rgba(150,205,235,0.28)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(234,241,255,0.8)", font: "300 15px sans-serif" },
          "machine/state/active": { fill: "rgba(14,22,44,0.85)", stroke: "rgba(150,205,235,0.45)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#f2fbff", font: "500 15px sans-serif", material: { wgsl: "// a night tile washed green to violet along its width, a cool rim; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  let wash = mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x);\n  var col = px.color.rgb + wash * (0.16 + 0.12 * px.a.x - 0.05 * px.a.y);\n  let rim = smoothstep(-1.6, -0.6, px.sdf);\n  col = mix(col, wash, rim * (0.55 + 0.35 * px.a.x));\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * 0.7));\n}\n", params: [0, 0, 0, 0], live: false } },
          "machine/state/visited": { fill: "rgba(14,20,40,0.62)", stroke: "#5cf2b0", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(234,241,255,0.8)", font: "300 15px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(234,241,255,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(234,241,255,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#5cf2b0", strokeWidth: 2.5, material: { wgsl: "// the travelled arc: aurora green into violet and back around the circle\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let k = abs(fract(atan2(c.y, c.x) / 6.2831853 + 0.5 + px.time * 0.03) * 2.0 - 1.0);\n  return vec4<f32>(mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), k), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(12,18,36,0.92)", stroke: "rgba(234,241,255,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(12,18,36,0.92)", stroke: "rgba(234,241,255,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(12,18,36,0.92)", stroke: "#5cf2b0", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(255,255,255,0.1)" },
          "machine/event/idle": { textColor: "rgba(234,241,255,0.84)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#8ff7d0", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(14,20,40,0.62)", stroke: "rgba(234,241,255,0.84)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "rgba(14,22,44,0.85)", stroke: "rgba(150,205,235,0.45)", textColor: "#f2fbff", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "rgba(14,22,44,0.95)", stroke: "#5cf2b0", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#5cf2b0", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(234,241,255,0.84)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(12,18,36,0.92)", stroke: "rgba(150,205,235,0.3)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, backdrop: { blur: 20, tint: "rgba(60,90,160,0.08)", saturate: 1.15 } },
          "text/code/idle": { textColor: "rgba(234,241,255,0.84)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#8ff7d0", font: "700 14px monospace", fill: "rgba(92,242,176,0.10)", material: { wgsl: "// a faint aurora band behind the active source line\nfn shade(px: Pixel) -> vec4<f32> {\n  return vec4<f32>(mix(vec3<f32>(0.36, 0.95, 0.69), vec3<f32>(0.56, 0.42, 1.0), px.uv.x) * 0.6, 0.22);\n}\n", params: [0, 0, 0, 0], live: false } }
        }
      }
        @label "Presets"
        @description "Every preset's look table by name, each keyed component/intent/state with the same key set: naqsh (warm night, gold), glass (cool frost), sand (dune grain), instrument (engraved hairlines), terminal (phosphor), paper (fibrous ink), taif-day and taif-night (the arabesque lattice by day and night), observatory (hairlines of pale light on a near-black sky, sharp corners, one teal accent, slow damped motion), print (ink and one coral accent on off-white stock, flat fills, a dark code plate, snappy motion), pulse (teal and magenta light on violet-black, pill corners, springy motion), astrolabe (an engraved brass instrument on a night-blue sky: a degree-scaled limb, a turning khatam rete at the centre, star pointers, no shadows), prism (white light parted into a spectrum), prism-ink (the spectrum on ink), dawn (the horizon where night meets day), ink-gold (sumi ink and gold leaf on paper) and aurora (ribbons of light over a night sky)."
        @tier "presentation"
    }
  }

  page boot as RasmThemeStart -> RasmTheme
}
