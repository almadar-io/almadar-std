            "pressable/secondary/hovered": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 90, damping: 24 } },
            "text/display/idle": { textColor: "foreground", font: "400 64px display" },
            "text/title/idle": { textColor: "foreground", font: "400 36px display" },
            "text/eyebrow/idle": { textColor: "accent", font: "500 14px body" },
            "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" },
            "text/card/idle": { textColor: "card-foreground", font: "400 26px display", on: "card/surface/idle" },
            "morph/default/idle": { fill: "accent" },
            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet q = p - c;\nlet r = length(q);\nlet rad = m * 0.34;\nlet u = fract(atan2(q.x, -q.y) * 0.159155);\nlet t = fract(u - 0.12);\nlet thick = mix(7.0, 1.2, t);\nlet gap = step(t, 0.9);\nlet dry = step(sg_hash(vec2<f32>(floor(r / 1.3), 5.0)), 1.0 - 0.7 * smoothstep(0.55, 1.0, t));\nreturn sg_out(px, px.color.rgb, sg_fill(abs(r - rad) - thick * 0.5) * gap * dry);\n}\n", params: [0, 0, 0, 0], live: false } },
            "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 90, damping: 24 } },
            "pressable/secondary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 90, damping: 24 } },
