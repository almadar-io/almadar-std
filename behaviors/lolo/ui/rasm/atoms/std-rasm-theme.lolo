          "drag/default/idle": { fill: "rgba(31,34,52,0.7)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(238,240,247,0.74)", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "drag/default/dragging": { fill: "rgba(38,42,63,0.9)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(238,240,247,0.74)", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 }, shadow: { color: "rgba(0,0,0,0.5)", blur: 36 } },
          "mirror/primary/idle": { fill: "rgba(23,25,37,0.78)", backdrop: { blur: 20, tint: "rgba(255,255,255,0.03)", saturate: 1.1 }, stroke: "rgba(238,240,247,0.14)", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(0,0,0,0.5)", blur: 36 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 210, damping: 22 } },
          "particles/primary/idle": { fill: "#b9a2ff" },
          "orbit/ring/idle": { stroke: "rgba(238,240,247,0.4)", strokeWidth: 1.2, material: { wgsl: "// a hairline whose hue runs the whole spectrum once around the circle\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let spec = pr_hue(ang + px.time * 0.01);\n  return vec4<f32>(spec, 0.85);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/arc/lit": { stroke: "#8f6bff", strokeWidth: 3, material: { wgsl: "// the travelled arc: the same spectrum, glowing\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let spec = pr_hue(ang + px.time * 0.04);\n  return vec4<f32>(mix(spec, vec3<f32>(1.0, 1.0, 1.0), 0.25), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, shadow: { color: "rgba(143,107,255,0.5)", blur: 14 } },
          "orbit/station/idle": { fill: "#1f2234", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1.2, shadow: { color: "rgba(0,0,0,0.5)", blur: 10 }, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/hovered": { fill: "#262a3f", stroke: "rgba(238,240,247,0.5)", strokeWidth: 1.4, shadow: { color: "rgba(143,107,255,0.5)", blur: 16 }, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/focused": { fill: "#1f2234", stroke: "#8fb4ff", strokeWidth: 2.4, shadow: { color: "rgba(0,0,0,0.5)", blur: 10 }, spring: { stiffness: 210, damping: 22 } },
          "orbit/station/active": { fill: "#262a3f", stroke: "rgba(238,240,247,0.6)", strokeWidth: 1.6, shadow: { color: "rgba(143,107,255,0.5)", blur: 22 }, spring: { stiffness: 210, damping: 22 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/beat/idle": { stroke: "#b9a2ff", fill: "rgba(143,107,255,0.35)" },
          "orbit/label/idle": { textColor: "rgba(238,240,247,0.74)", font: "400 13px sans-serif" },
          "orbit/label/active": { textColor: "#eef0f7", font: "600 13px sans-serif" },
          "orbit/core/idle": { fill: "rgba(23,25,37,0.82)", stroke: "rgba(238,240,247,0.2)", strokeWidth: 1.2, backdrop: { blur: 16, tint: "rgba(255,255,255,0.03)", saturate: 1.1 }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/idle": { fill: "rgba(23,25,37,0.78)", stroke: "rgba(238,240,247,0.14)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(238,240,247,0.74)", font: "300 15px sans-serif" },
          "machine/state/active": { fill: "#1f2234", stroke: "rgba(238,240,247,0.18)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#eef0f7", font: "500 15px sans-serif", material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(23,25,37,0.78)", stroke: "#8f6bff", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(238,240,247,0.74)", font: "300 15px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(238,240,247,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(238,240,247,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#8f6bff", strokeWidth: 2.5, material: { wgsl: "// the travelled arc: the same spectrum, glowing\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let spec = pr_hue(ang + px.time * 0.04);\n  return vec4<f32>(mix(spec, vec3<f32>(1.0, 1.0, 1.0), 0.25), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(23,25,37,0.92)", stroke: "rgba(238,240,247,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(23,25,37,0.92)", stroke: "rgba(238,240,247,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(23,25,37,0.92)", stroke: "#8f6bff", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(31,34,52,0.8)" },
          "machine/event/idle": { textColor: "rgba(238,240,247,0.82)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#eef0f7", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(23,25,37,0.78)", stroke: "rgba(238,240,247,0.82)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#1f2234", stroke: "rgba(238,240,247,0.18)", textColor: "#eef0f7", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "#262a3f", stroke: "#8f6bff", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#8f6bff", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(238,240,247,0.82)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(23,25,37,0.92)", stroke: "rgba(238,240,247,0.16)", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, backdrop: { blur: 18, tint: "rgba(255,255,255,0.03)", saturate: 1.1 } },
          "text/code/idle": { textColor: "rgba(238,240,247,0.82)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#eef0f7", font: "700 14px monospace", fill: "rgba(143,107,255,0.14)", material: { wgsl: "// a faint spectral band behind the active source line\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let spec = pr_hue(px.uv.x * 0.9 + px.time * 0.03);\n  return vec4<f32>(spec * 0.5, 0.28);\n}\n", params: [0, 0, 0, 0], live: true } }
        },
        "dawn": {
          "surface/ground/idle": { fill: "#c86a7e", material: { wgsl: "// the moment night meets day: indigo into rose into apricot at the horizon, a thin luminous line, static film grain\nfn dw_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn dw_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(dw_hash(i), dw_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(dw_hash(i + vec2<f32>(0.0, 1.0)), dw_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let indigo = vec3<f32>(0.110, 0.122, 0.290);\n  let rose = vec3<f32>(0.784, 0.416, 0.494);\n  let apricot = vec3<f32>(0.965, 0.725, 0.541);\n  let dusk = vec3<f32>(0.42, 0.24, 0.35);\n  let y = px.uv.y;\n  var col = mix(indigo, rose, smoothstep(0.0, 0.42, y));\n  col = mix(col, apricot, smoothstep(0.38, 0.65, y));\n  col = mix(col, dusk, smoothstep(0.66, 1.0, y));\n  let dy = abs(px.local.y - px.size.y * 0.65);\n  let breath = 0.5 + 0.5 * sin(px.time * 0.25);\n  col = col + vec3<f32>(1.0, 0.84, 0.55) * exp(-dy / 46.0) * (0.10 + 0.04 * breath);\n  col = col + vec3<f32>(1.0, 0.94, 0.78) * (1.0 - smoothstep(0.0, 1.6, dy)) * 0.55;\n  let g = dw_hash(floor(px.local)) - 0.5;\n  col = col + vec3<f32>(g, g, g) * 0.045;\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 150, damping: 20 } },
          "stack/panel/idle": { fill: "rgba(255,246,236,0.9)", backdrop: { blur: 16, tint: "rgba(255,240,220,0.18)", saturate: 1.1 }, stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(42,30,51,0.28)", blur: 36 }, material: { wgsl: "// warm cream glass with a gold inlay line inside its edge; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = mix(px.color.rgb, vec3<f32>(0.99, 0.92, 0.84), px.uv.y * 0.35);\n  let inlay = 1.0 - smoothstep(0.3, 1.0, abs(px.sdf + 5.0));\n  col = mix(col, vec3<f32>(0.902, 0.761, 0.478), inlay * (0.5 + 0.3 * px.a.z));\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.85, 0.6) * exp(-d * d / 30000.0) * 0.05;\n  return vec4<f32>(col, max(px.color.a, inlay * 0.5));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 150, damping: 20 } },
          "text/title/idle": { textColor: "#2a1e33", font: "600 28px serif", spring: { stiffness: 150, damping: 20 } },
          "text/body/idle": { textColor: "rgba(42,30,51,0.86)", font: "400 15px sans-serif", spring: { stiffness: 150, damping: 20 } },
          "pressable/primary/idle": { fill: "#2a1e33", stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "// a plum tile edged in gold, lit from the horizon; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.12 - 0.22 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.78, 0.55) * exp(-d * d / 6000.0) * (0.04 + 0.12 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 3.5));\n  col = mix(col, vec3<f32>(0.902, 0.761, 0.478), inlay * (0.35 + 0.35 * px.a.x));\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.6));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#fff6ec", font: "600 15px sans-serif", spring: { stiffness: 150, damping: 20 } },
