        },
        "lamp": {
          "surface/ground/idle": { fill: "#0f141c", material: { wgsl: "fn la_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn la_star(c: vec2<f32>) -> vec3<f32> {\n  let h = la_hash(c);\n  let x = 0.2 + 0.6 * la_hash(c + vec2<f32>(11.3, 5.7));\n  let y = 0.2 + 0.6 * la_hash(c + vec2<f32>(2.9, 17.1));\n  let occ = select(0.0, 1.0, h < 0.3);\n  return vec3<f32>((c.x + x) * 90.0, (c.y + y) * 90.0, occ);\n}\nfn la_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 {\n  let pa = p - a;\n  let ba = b - a;\n  let t = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0);\n  return length(pa - ba * t);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c0 = floor(px.local / 90.0);\n  let thr = clamp(px.scroll / 4000.0, 0.15, 0.8);\n  let pc = floor(px.pointer / 90.0);\n  var nst = vec2<f32>(-100000.0, -100000.0);\n  var nd = 100000.0;\n  for (var j = -1; j <= 1; j = j + 1) {\n    for (var i = -1; i <= 1; i = i + 1) {\n      let s = la_star(pc + vec2<f32>(f32(i), f32(j)));\n      let dd = distance(s.xy, px.pointer);\n      if (s.z > 0.5 && dd < nd) {\n        nd = dd;\n        nst = s.xy;\n      }\n    }\n  }\n  let pk = 1.0 - smoothstep(0.0, 200.0, nd);\n  var col = vec3<f32>(0.059, 0.078, 0.11);\n  let chalk = vec3<f32>(0.945, 0.918, 0.847);\n  let amber = vec3<f32>(0.949, 0.71, 0.267);\n  for (var j = -1; j <= 1; j = j + 1) {\n    for (var i = -1; i <= 1; i = i + 1) {\n      let a = c0 + vec2<f32>(f32(i), f32(j));\n      let s = la_star(a);\n      if (s.z > 0.5) {\n        let hh = la_hash(a + vec2<f32>(4.0, 9.0));\n        let tw = 0.65 + 0.35 * sin(px.time * 0.9 + hh * 6.2831);\n        let d = distance(px.local, s.xy);\n        let isn = 1.0 - smoothstep(0.0, 1.0, distance(s.xy, nst));\n        let k = isn * pk;\n        let r = 0.9 + 0.9 * hh;\n        let dot0 = 1.0 - smoothstep(r - 0.5, r + 0.9, d);\n        let gl = exp(-d * d / 162.0) * 0.3 * k;\n        col = mix(col, chalk, dot0 * 0.3 * tw);\n        col = mix(col, amber, clamp(dot0 * 0.85 * k + gl, 0.0, 1.0));\n        for (var m = 0; m < 4; m = m + 1) {\n          var dv = vec2<f32>(1.0, 0.0);\n          if (m == 1) { dv = vec2<f32>(0.0, 1.0); }\n          if (m == 2) { dv = vec2<f32>(1.0, 1.0); }\n          if (m == 3) { dv = vec2<f32>(-1.0, 1.0); }\n          let b = la_star(a + dv);\n          if (b.z > 0.5 && la_hash(a * 1.7 + vec2<f32>(f32(m) * 3.3, 1.1)) < thr) {\n            let ld = la_seg(px.local, s.xy, b.xy);\n            let ln = 1.0 - smoothstep(0.3, 1.1, ld);\n            col = mix(col, chalk, ln * 0.1);\n          }\n        }\n      }\n    }\n  }\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 170, damping: 24 } },
