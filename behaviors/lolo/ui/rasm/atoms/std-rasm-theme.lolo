          "machine/pill/next": { fill: "rgba(28,24,40,0.97)", stroke: "rgba(243,230,200,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(28,24,40,0.97)", stroke: "#f2d38a", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(201,164,92,0.20)" },
          "machine/event/idle": { textColor: "rgba(243,230,200,0.85)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#f2d38a", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(28,24,40,0.92)", stroke: "rgba(243,230,200,0.85)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#7a4a1c", stroke: "#c9a45c", textColor: "#fbeed2", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "#7a4a1c", stroke: "#f2d38a", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#f2d38a", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(243,230,200,0.85)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(28,24,40,0.97)", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [18, 18, 18, 18], kind: "notch" }, backdrop: { blur: 10, tint: "rgba(242,211,138,0.45)", saturate: 1.1 } },
          "text/code/idle": { textColor: "rgba(243,230,200,0.85)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#f2d38a", font: "700 14px monospace" }
        },
        "glass": {
          "surface/ground/idle": { fill: "#060812", material: { wgsl: "// slow aurora: three light pools drifting, a soft lamp where the pointer is\nfn gl_blob(p: vec2<f32>, c: vec2<f32>, r: f32) -> f32 { let d = distance(p, c); return exp(-d * d / (r * r)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let t = px.time * 0.15;\n  let s = px.size;\n  var col = vec3<f32>(0.04, 0.05, 0.09);\n  col = col + vec3<f32>(0.20, 0.35, 0.95) * gl_blob(px.local, s * vec2<f32>(0.3 + 0.15 * sin(t), 0.35 + 0.1 * cos(t * 1.3)), s.x * 0.45);\n  col = col + vec3<f32>(0.75, 0.25, 0.85) * gl_blob(px.local, s * vec2<f32>(0.75 + 0.1 * cos(t * 0.8), 0.6 + 0.15 * sin(t * 1.1)), s.x * 0.4);\n  col = col + vec3<f32>(0.15, 0.85, 0.75) * gl_blob(px.local, s * vec2<f32>(0.5 + 0.2 * sin(t * 0.6), 0.9), s.x * 0.35) * 0.6;\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.25, 0.25, 0.25) * exp(-d * d / (2.0 * 200.0 * 200.0));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 320, damping: 15 } },
          "stack/panel/idle": { fill: "rgba(255,255,255,0.10)", backdrop: { blur: 24, tint: "rgba(255,255,255,0.08)", saturate: 1.5 }, stroke: "rgba(255,255,255,0.35)", strokeWidth: 1, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "rgba(10,20,60,0.45)", blur: 40 }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 320, damping: 15 }, decor: "glass-rim" },
          "text/title/idle": { textColor: "#f4f7ff", font: "600 26px sans-serif", spring: { stiffness: 320, damping: 15 } },
          "text/body/idle": { textColor: "rgba(230,236,255,0.75)", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
          "pressable/primary/idle": { fill: "rgba(120,160,255,0.55)", backdrop: { blur: 14, tint: "rgba(120,160,255,0.10)", saturate: 1.4 }, corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#ffffff", font: "600 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
          "pressable/primary/hovered": { fill: "rgba(140,180,255,0.70)", backdrop: { blur: 14, tint: "rgba(120,160,255,0.10)", saturate: 1.4 }, corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#ffffff", font: "600 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
          "pressable/primary/pressed": { fill: "rgba(100,140,240,0.80)", backdrop: { blur: 14, tint: "rgba(120,160,255,0.10)", saturate: 1.4 }, corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [1, 1, 0, 0], live: true }, textColor: "#ffffff", font: "600 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
