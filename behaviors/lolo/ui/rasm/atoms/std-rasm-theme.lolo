          "overlay/dialog/idle": { fill: "rgba(28,24,40,0.97)", stroke: "#c9a45c", strokeWidth: 1.5, corners: { radius: [18, 18, 18, 18], kind: "notch" }, shadow: { color: "rgba(0,0,0,0.55)", blur: 44 }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, spring: { stiffness: 170, damping: 20 }, decor: "naqsh-stars" },
