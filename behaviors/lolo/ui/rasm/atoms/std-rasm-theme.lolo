          "stack/hero/idle": { fill: "rgba(247,243,232,0.97)", backdrop: { blur: 0, tint: "rgba(247,243,232,0)", saturate: 1.0 }, stroke: "#141414", strokeWidth: 1.4, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(20,20,20,0.12)", blur: 22 }, spring: { stiffness: 90, damping: 18 } },
          "overlay/scrim/idle": { fill: "rgba(20,20,20,0.35)", spring: { stiffness: 90, damping: 18 } },
          "overlay/dialog/idle": { fill: "rgba(247,243,232,0.99)", backdrop: { blur: 0, tint: "rgba(247,243,232,0)", saturate: 1.0 }, stroke: "#141414", strokeWidth: 1.4, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(20,20,20,0.3)", blur: 44 }, spring: { stiffness: 90, damping: 18 } },
