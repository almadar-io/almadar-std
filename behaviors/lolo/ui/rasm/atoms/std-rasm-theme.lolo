            "text/display/idle": { textColor: "primary", font: "700 56px display" },
            "text/title/idle": { textColor: "foreground", font: "700 34px display" },
            "text/eyebrow/idle": { textColor: "accent", font: "600 13px mono" },
            "text/body/idle": { textColor: "foreground", font: "400 16px body" },
            "text/card/idle": { textColor: "primary", font: "700 15px mono", on: "card/surface/idle" },
            "morph/default/idle": { fill: "primary" },
            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet cell = vec2<f32>(48.0, 14.0);\nlet g = fract(p / cell);\nlet ci = floor(p / cell);\nlet hline = 1.0 - smoothstep(0.3, 1.2, min(g.y, 1.0 - g.y) * cell.y);\nlet vline = 1.0 - smoothstep(0.3, 1.2, min(g.x, 1.0 - g.x) * cell.x);\nlet bar = step(g.x, 0.15 + 0.7 * sg_hash(ci)) * step(0.3, g.y) * step(g.y, 0.7) * step(0.45, sg_hash(ci + vec2<f32>(3.0, 9.0)));\nreturn sg_out(px, px.color.rgb, max(max(hline, vline) * 0.45, bar * 0.9));\n}\n", params: [0, 0, 0, 0], live: false } }
          },
