            "text/display/idle": { textColor: "foreground", font: "700 84px display" },
            "text/numeral/idle": { textColor: "primary", font: "700 52px display" },
            "text/title/idle": { textColor: "foreground", font: "600 36px display" },
            "text/eyebrow/idle": { textColor: "accent", font: "700 14px body" },
            "text/body/idle": { textColor: "foreground", font: "400 18px body" },
            "text/card/idle": { textColor: "card-foreground", font: "600 22px display", on: "card/surface/idle" },
            "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 1.5 },
            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet cell = 48.0;\nlet q = (fract(p / cell) - vec2<f32>(0.5, 0.5)) * cell;\nlet s1 = max(abs(q.x), abs(q.y)) - cell * 0.3;\nlet r = vec2<f32>(q.x + q.y, q.x - q.y) * 0.70711;\nlet s2 = max(abs(r.x), abs(r.y)) - cell * 0.3;\nlet st = max(sg_line(s1, 0.6), sg_line(s2, 0.6));\nlet ring = sg_line(length(q) - cell * 0.16, 0.6);\nlet g = sg_line(max(abs(q.x), abs(q.y)) - cell * 0.5, 0.6) * 0.7;\nreturn sg_out(px, px.color.rgb, max(max(st, ring), g));\n}\n", params: [0, 0, 0, 0], live: false } },
