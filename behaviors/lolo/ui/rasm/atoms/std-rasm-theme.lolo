        "choice/option/idle": { fill: "rgba(0,0,0,0)", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
        "choice/option/active": { fill: "#b8662a", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fff6e4", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } }
      }
        @label "Sand looks"
        @description "Dune grain, warm wind-drift motion, slow settling springs. Every look keyed component/intent/state."
        @tier "presentation"
      instrument : Map string RasmLook = {
        "surface/ground/idle": { fill: "#0d1117", material: { wgsl: "// engraved dial plate: hairline grid, major ticks, a sweeping gauge arc, crosshair at the pointer\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = mix(vec3<f32>(0.075, 0.085, 0.10), vec3<f32>(0.05, 0.058, 0.07), px.uv.y);\n  let g1 = abs(fract(px.local / 16.0 - vec2<f32>(0.5, 0.5)) - vec2<f32>(0.5, 0.5)) * 16.0;\n  let minor = 1.0 - smoothstep(0.0, 0.7, min(g1.x, g1.y));\n  let g2 = abs(fract(px.local / 80.0 - vec2<f32>(0.5, 0.5)) - vec2<f32>(0.5, 0.5)) * 80.0;\n  let major = 1.0 - smoothstep(0.0, 0.9, min(g2.x, g2.y));\n  col = col + vec3<f32>(0.55, 0.70, 0.78) * (minor * 0.035 + major * 0.09);\n  let c = px.size * 0.5;\n  let r = distance(px.local, c);\n  let rad = min(px.size.x, px.size.y) * 0.42;\n  let ring = 1.0 - smoothstep(0.0, 0.9, abs(r - rad));\n  let ang = atan2(px.local.y - c.y, px.local.x - c.x);\n  let sweep = fract((ang / 6.2831853) - px.time * 0.08);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * ring * (0.10 + 0.5 * pow(1.0 - sweep, 6.0));\n  let ticks = step(0.5, fract(ang * 36.0 / 6.2831853)) * (1.0 - smoothstep(0.0, 0.6, abs(r - rad * 0.94)));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * ticks * 0.18;\n  let cx = 1.0 - smoothstep(0.0, 0.8, abs(px.local.x - px.pointer.x));\n  let cy = 1.0 - smoothstep(0.0, 0.8, abs(px.local.y - px.pointer.y));\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * (cx + cy) * 0.22 * exp(-distance(px.local, px.pointer) * 0.004);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 420, damping: 34 } },
        "stack/panel/idle": { fill: "rgba(16,21,28,0.95)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "notch" }, shadow: { color: "rgba(0,0,0,0.6)", blur: 16 }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, spring: { stiffness: 420, damping: 34 }, decor: "engraved-border" },
        "text/title/idle": { textColor: "#dce8ee", font: "500 24px monospace", spring: { stiffness: 420, damping: 34 } },
        "text/body/idle": { textColor: "rgba(206,222,230,0.78)", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/idle": { fill: "#27506a", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/hovered": { fill: "#2f6282", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/pressed": { fill: "#1c3b4f", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/focused": { fill: "#27506a", stroke: "#f2a03a", strokeWidth: 1.6, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/disabled": { fill: "rgba(39,80,106,0.35)", stroke: "rgba(127,152,168,0.3)", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "rgba(232,242,247,0.35)", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/idle": { fill: "rgba(127,152,168,0.10)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/hovered": { fill: "rgba(127,152,168,0.20)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/pressed": { fill: "rgba(127,152,168,0.30)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/focused": { fill: "rgba(127,152,168,0.10)", stroke: "#f2a03a", strokeWidth: 1.6, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 14], live: true }, textColor: "#e8f2f7", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/disabled": { fill: "rgba(127,152,168,0.05)", stroke: "rgba(127,152,168,0.3)", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 14], live: true }, textColor: "rgba(232,242,247,0.35)", font: "600 13px monospace", spring: { stiffness: 420, damping: 34 } },
