          "choice/popup/idle": { fill: "rgba(35,38,55,0.94)", backdrop: { blur: 24, tint: "rgba(255,255,255,0.03)", saturate: 1.1 }, stroke: "rgba(238,240,247,0.16)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(0,0,0,0.55)", blur: 28 }, spring: { stiffness: 210, damping: 22 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#eef0f7", font: "300 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 210, damping: 22 } },
