          "scroll/default/thumb": { fill: "#2a2433", stroke: "#2a2433", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(60,45,30,0.4)", blur: 8 }, spring: { stiffness: 70, damping: 16 } },
          "scroll/default/thumb-dragging": { fill: "#ffffff", stroke: "#2a2433", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(60,45,30,0.4)", blur: 8 }, spring: { stiffness: 70, damping: 16 } },
          "drag/default/idle": { fill: "rgba(42,36,51,0.06)", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [5, 5, 5, 5], kind: "round" }, textColor: "rgba(31,26,38,0.82)", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
          "drag/default/dragging": { fill: "rgba(42,36,51,0.12)", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [5, 5, 5, 5], kind: "round" }, shadow: { color: "rgba(60,45,30,0.28)", blur: 30 }, textColor: "rgba(31,26,38,0.82)", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
          "mirror/primary/idle": { fill: "rgba(250,246,236,0.96)", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(60,45,30,0.28)", blur: 30 }, material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w fibre scale in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = max(px.a.w, 1.0);\n  let fib = pp_noise(vec2<f32>(px.local.x / (s * 6.0), px.local.y / (s * 0.4)));\n  let tooth = pp_noise(px.local / s);\n  var col = px.color.rgb * (0.96 + 0.05 * tooth) - vec3<f32>(0.03) * smoothstep(0.65, 0.9, fib);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.05, 0.04, 0.02) * exp(-d * d / (2.0 * 80.0 * 80.0)) * (0.4 + px.a.x);\n  let ink = smoothstep(-1.4, 0.0, px.sdf) * (0.35 + 0.35 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.14, 0.12, 0.16), ink);\n  let bleed = smoothstep(-6.0, -1.4, px.sdf) * (1.0 - smoothstep(-1.4, 0.0, px.sdf)) * 0.06 * (0.6 + 0.4 * pp_noise(px.local / 3.0));\n  col = col - vec3<f32>(bleed);\n  col = col * (1.0 - 0.07 * px.a.y);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 4], live: true }, spring: { stiffness: 70, damping: 16 }, decor: "deckle-edge" },
          "particles/primary/idle": { fill: "#2a2433" },
          "orbit/ring/idle": { stroke: "rgba(42,36,51,0.55)", strokeWidth: 1.2 },
          "orbit/arc/lit": { stroke: "#b03a2e", strokeWidth: 2.6 },
          "orbit/station/idle": { fill: "rgba(250,246,236,0.96)", stroke: "rgba(42,36,51,0.55)", strokeWidth: 1.2, shadow: { color: "rgba(60,45,30,0.25)", blur: 10 }, spring: { stiffness: 70, damping: 16 } },
          "orbit/station/hovered": { fill: "rgba(240,233,216,0.98)", stroke: "#b03a2e", strokeWidth: 1.4, shadow: { color: "rgba(176,58,46,0.28)", blur: 16 }, spring: { stiffness: 70, damping: 16 } },
          "orbit/station/focused": { fill: "rgba(250,246,236,0.96)", stroke: "#b03a2e", strokeWidth: 2.4, shadow: { color: "rgba(60,45,30,0.25)", blur: 10 }, spring: { stiffness: 70, damping: 16 } },
          "orbit/station/active": { fill: "#2a2433", stroke: "#b03a2e", strokeWidth: 1.6, shadow: { color: "rgba(176,58,46,0.28)", blur: 22 }, spring: { stiffness: 70, damping: 16 } },
          "orbit/beat/idle": { stroke: "#b03a2e", fill: "rgba(176,58,46,0.28)" },
          "orbit/label/idle": { textColor: "rgba(31,26,38,0.82)", font: "400 13px serif" },
          "orbit/label/active": { textColor: "#1f1a26", font: "600 13px serif" },
          "orbit/core/idle": { fill: "rgba(250,246,236,0.98)", stroke: "rgba(42,36,51,0.55)", strokeWidth: 1.2, backdrop: { blur: 8, tint: "rgba(176,58,46,0.28)", saturate: 1.1 } },
          "machine/state/idle": { fill: "rgba(250,246,236,0.96)", stroke: "#2a2433", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(31,26,38,0.82)", font: "400 15px serif" },
          "machine/state/active": { fill: "#2a2433", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fbf7ec", font: "600 15px serif", material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w fibre scale in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = max(px.a.w, 1.0);\n  let fib = pp_noise(vec2<f32>(px.local.x / (s * 6.0), px.local.y / (s * 0.4)));\n  let tooth = pp_noise(px.local / s);\n  var col = px.color.rgb * (0.96 + 0.05 * tooth) - vec3<f32>(0.03) * smoothstep(0.65, 0.9, fib);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.05, 0.04, 0.02) * exp(-d * d / (2.0 * 80.0 * 80.0)) * (0.4 + px.a.x);\n  let ink = smoothstep(-1.4, 0.0, px.sdf) * (0.35 + 0.35 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.14, 0.12, 0.16), ink);\n  let bleed = smoothstep(-6.0, -1.4, px.sdf) * (1.0 - smoothstep(-1.4, 0.0, px.sdf)) * 0.06 * (0.6 + 0.4 * pp_noise(px.local / 3.0));\n  col = col - vec3<f32>(bleed);\n  col = col * (1.0 - 0.07 * px.a.y);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 4], live: true } },
          "machine/state/visited": { fill: "rgba(250,246,236,0.96)", stroke: "#b03a2e", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(31,26,38,0.82)", font: "400 15px serif" },
          "machine/wire/idle": { stroke: "rgba(31,26,38,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(31,26,38,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#b03a2e", strokeWidth: 2.5 },
          "machine/pill/idle": { fill: "rgba(250,246,236,0.98)", stroke: "rgba(31,26,38,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(250,246,236,0.98)", stroke: "rgba(31,26,38,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(250,246,236,0.98)", stroke: "#b03a2e", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(42,36,51,0.12)" },
          "machine/event/idle": { textColor: "rgba(31,26,38,0.85)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#b03a2e", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(250,246,236,0.96)", stroke: "rgba(31,26,38,0.85)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#2a2433", stroke: "#2a2433", textColor: "#fbf7ec", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px serif" },
          "machine/token/idle": { fill: "#2a2433", stroke: "#b03a2e", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#b03a2e", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(31,26,38,0.85)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(250,246,236,0.98)", stroke: "#2a2433", strokeWidth: 1.2, corners: { radius: [6, 6, 6, 6], kind: "round" }, backdrop: { blur: 10, tint: "rgba(176,58,46,0.28)", saturate: 1.1 } },
          "text/code/idle": { textColor: "rgba(31,26,38,0.85)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#b03a2e", font: "700 14px monospace" }
        },
        "taif-day": {
          "surface/ground/idle": { fill: "#000000", material: { wgsl: "// a quiet eight-point star lattice over sand or night, fixed in place\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 72.0;\n  let cell = fract(p) - vec2<f32>(0.5, 0.5);\n  let ang = atan2(cell.y, cell.x);\n  let r = length(cell);\n  let star = abs(cos(ang * 4.0)) * 0.12 + 0.18;\n  let ln = 1.0 - smoothstep(0.0, 0.02, abs(r - star));\n  var col = mix(vec3<f32>(0.94, 0.89, 0.80), vec3<f32>(0.90, 0.83, 0.70), px.uv.y);\n  col = mix(col, vec3<f32>(0.17, 0.29, 0.63), ln * 0.13);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 170, damping: 20 } },
          "stack/panel/idle": { fill: "rgba(251,246,234,0.90)", backdrop: { blur: 14, tint: "rgba(255,240,210,0.08)", saturate: 1.05 }, stroke: "rgba(184,132,28,0.7)", strokeWidth: 1, corners: { radius: [18, 18, 18, 18], kind: "notch" }, shadow: { color: "rgba(80,60,20,0.2)", blur: 32 }, material: { wgsl: "// a glass card: a gold inlay line inside its edge and a faint star lattice that gathers in the corners\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb;\n  let cell = fract(px.local / 48.0) - vec2<f32>(0.5, 0.5);\n  let star = abs(cos(atan2(cell.y, cell.x) * 4.0)) * 0.12 + 0.2;\n  let ln = 1.0 - smoothstep(0.0, 0.025, abs(length(cell) - star));\n  let corner = 1.0 - smoothstep(0.0, 0.22, min(min(px.uv.x, 1.0 - px.uv.x), min(px.uv.y, 1.0 - px.uv.y)));\n  col = mix(col, vec3<f32>(0.12, 0.31, 0.60), ln * (0.03 + 0.14 * corner));\n  let inlay = 1.0 - smoothstep(0.3, 1.0, abs(px.sdf + 7.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * 0.55);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 40000.0) * 0.05;\n  return vec4<f32>(col, max(px.color.a, inlay * 0.55));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 170, damping: 20 }, decor: "naqsh-stars" },
          "text/title/idle": { textColor: "#1c3578", font: "700 28px 'Reem Kufi', serif", spring: { stiffness: 170, damping: 20 } },
          "text/body/idle": { textColor: "rgba(44,37,24,0.92)", font: "400 16px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/idle": { fill: "#1f4f9a", stroke: "#b8841c", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#fbf5e6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/hovered": { fill: "#2a5fb4", stroke: "#b8841c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#fbf5e6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/pressed": { fill: "#183d78", stroke: "#b8841c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 1, 0, 0], live: true }, textColor: "#fbf5e6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/focused": { fill: "#1f4f9a", stroke: "#17807a", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 1, 0], live: true }, textColor: "#fbf5e6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/disabled": { fill: "rgba(31,79,154,0.35)", stroke: "#b8841c59", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#fbf5e6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/idle": { fill: "rgba(31,79,154,0.06)", stroke: "#b8841c", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1c3578", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/hovered": { fill: "rgba(31,79,154,0.12)", stroke: "#b8841c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#1c3578", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/pressed": { fill: "rgba(31,79,154,0.20)", stroke: "#b8841c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 1, 0, 0], live: true }, textColor: "#1c3578", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/focused": { fill: "rgba(31,79,154,0.06)", stroke: "#17807a", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 1, 0], live: true }, textColor: "#1c3578", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/disabled": { fill: "rgba(31,79,154,0.06)", stroke: "#b8841c59", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1c3578", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/off-idle": { fill: "rgba(200,146,26,0.12)", stroke: "#c8921a", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#2c2518", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/off-hovered": { fill: "rgba(200,146,26,0.12)", stroke: "#c8921a", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#2c2518", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/off-focused": { fill: "rgba(200,146,26,0.12)", stroke: "#c8456a", strokeWidth: 2.4, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#2c2518", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/on-idle": { fill: "#c8921a", stroke: "#1a1208", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#2c2518", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/on-hovered": { fill: "#c8921a", stroke: "#1a1208", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#2c2518", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/on-focused": { fill: "#c8921a", stroke: "#1a1208", strokeWidth: 2.4, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#2c2518", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
