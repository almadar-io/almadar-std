            "pressable/primary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 90, damping: 24 } },
