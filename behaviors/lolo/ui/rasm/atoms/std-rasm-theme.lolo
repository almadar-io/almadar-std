          "toggle/check/off-idle": { fill: "#1f2234", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/off-hovered": { fill: "#1f2234", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/off-focused": { fill: "#1f2234", stroke: "#8fb4ff", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/on-idle": { fill: "#262a3f", stroke: "rgba(238,240,247,0.4)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// the spectrum glowing inside an ink control, for a switched-on state; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(px.color.rgb, spec, 0.55 + 0.1 * px.a.x);\n  col = mix(col, spec, rim * 0.6);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/on-hovered": { fill: "#262a3f", stroke: "rgba(238,240,247,0.4)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// the spectrum glowing inside an ink control, for a switched-on state; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(px.color.rgb, spec, 0.55 + 0.1 * px.a.x);\n  col = mix(col, spec, rim * 0.6);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/on-focused": { fill: "#262a3f", stroke: "#8fb4ff", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// the spectrum glowing inside an ink control, for a switched-on state; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(px.color.rgb, spec, 0.55 + 0.1 * px.a.x);\n  col = mix(col, spec, rim * 0.6);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/switch/off-idle": { fill: "#1f2234", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/switch/off-hovered": { fill: "#1f2234", stroke: "rgba(238,240,247,0.3)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/switch/off-focused": { fill: "#1f2234", stroke: "#8fb4ff", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// ink glass edged by a softly glowing spectral hairline, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let glow = smoothstep(-10.0, 0.0, px.sdf) * (0.08 + 0.10 * px.a.x);\n  let strength = clamp(0.72 + 0.28 * px.a.x, 0.0, 1.0);\n  var col = px.color.rgb + spec * glow;\n  col = mix(col, spec, rim * strength);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/switch/on-idle": { fill: "#262a3f", stroke: "rgba(238,240,247,0.4)", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// the spectrum glowing inside an ink control, for a switched-on state; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(px.color.rgb, spec, 0.55 + 0.1 * px.a.x);\n  col = mix(col, spec, rim * 0.6);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#eef0f7", font: "300 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
