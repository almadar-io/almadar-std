        },
        "wabi-sabi": {
          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn ws_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ws_n(p: vec2<f32>) -> f32 {\n  let i = floor(p); let f = fract(p); let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ws_h(i), ws_h(i + vec2<f32>(1.0, 0.0)), u.x), mix(ws_h(i + vec2<f32>(0.0, 1.0)), ws_h(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let t = px.time * 0.02;\n  let q = px.uv * vec2<f32>(px.size.x / px.size.y, 1.0) * 2.2;\n  var f = 0.0; var a = 0.5; var s = q;\n  for (var i = 0; i < 4; i = i + 1) { f = f + a * ws_n(s + vec2<f32>(t, -t)); s = s * 2.03; a = a * 0.5; }\n  let wash = smoothstep(0.35, 0.8, f);\n  let fib = ws_n(px.local * vec2<f32>(0.9, 0.06)) * ws_n(px.local * vec2<f32>(0.05, 0.8));\n  let grain = ws_h(px.local) - 0.5;\n  let ring = abs(length((px.uv - vec2<f32>(0.78, 0.3)) * vec2<f32>(px.size.x / px.size.y, 1.0)) - 0.34);\n  let ink = (1.0 - smoothstep(0.0, 0.012, ring)) * ws_n(px.local * 0.03) * 0.07;\n  var col = px.color.rgb * (1.0 - wash * 0.06) - vec3<f32>(fib * 0.035 + ink);\n  col = col + vec3<f32>(grain * 0.014, grain * 0.014, grain * 0.014);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
            "stack/card/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(40,34,24,0.10)", blur: 36, offsetX: 0, offsetY: 14 } },
            "stack/panel/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(40,34,24,0.10)", blur: 36, offsetX: 0, offsetY: 14 } },
