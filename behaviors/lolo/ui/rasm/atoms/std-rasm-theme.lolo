        "toggle/switch/off-hovered": { fill: "rgba(201,164,92,0.15)", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "toggle/switch/off-focused": { fill: "rgba(201,164,92,0.15)", stroke: "#f2d38a", strokeWidth: 2.4, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "toggle/switch/on-idle": { fill: "#946024", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "toggle/switch/on-hovered": { fill: "#946024", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "toggle/switch/on-focused": { fill: "#946024", stroke: "#f2d38a", strokeWidth: 2.4, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "range/default/track": { fill: "rgba(201,164,92,0.18)", corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "range/default/fill": { fill: "#c9a45c", corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "range/default/thumb-idle": { fill: "#f2d38a", stroke: "#7a4a1c", strokeWidth: 1, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 }, decor: "star8" },
        "range/default/thumb-hovered": { fill: "#ffe6a8", stroke: "#7a4a1c", strokeWidth: 1, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 }, decor: "star8" },
        "range/default/thumb-dragging": { fill: "#ffe6a8", stroke: "#7a4a1c", strokeWidth: 1, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 }, decor: "star8" },
        "range/default/thumb-focused": { fill: "#ffe6a8", stroke: "#7a4a1c", strokeWidth: 1, textColor: "#f3e6c8", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 }, decor: "star8" }
      }
        @label "Naqsh looks"
        @description "Warm night, gold, weighty springs: every look keyed component/intent/state."
        @tier "presentation"
      glass : Map string RasmLook = {
        "surface/ground/idle": { fill: "#060812", material: { wgsl: "// slow aurora: three light pools drifting, a soft lamp where the pointer is\nfn gl_blob(p: vec2<f32>, c: vec2<f32>, r: f32) -> f32 { let d = distance(p, c); return exp(-d * d / (r * r)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let t = px.time * 0.15;\n  let s = px.size;\n  var col = vec3<f32>(0.04, 0.05, 0.09);\n  col = col + vec3<f32>(0.20, 0.35, 0.95) * gl_blob(px.local, s * vec2<f32>(0.3 + 0.15 * sin(t), 0.35 + 0.1 * cos(t * 1.3)), s.x * 0.45);\n  col = col + vec3<f32>(0.75, 0.25, 0.85) * gl_blob(px.local, s * vec2<f32>(0.75 + 0.1 * cos(t * 0.8), 0.6 + 0.15 * sin(t * 1.1)), s.x * 0.4);\n  col = col + vec3<f32>(0.15, 0.85, 0.75) * gl_blob(px.local, s * vec2<f32>(0.5 + 0.2 * sin(t * 0.6), 0.9), s.x * 0.35) * 0.6;\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.25, 0.25, 0.25) * exp(-d * d / (2.0 * 200.0 * 200.0));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 320, damping: 15 } },
        "stack/panel/idle": { fill: "rgba(255,255,255,0.10)", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "rgba(10,20,60,0.45)", blur: 40 }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 320, damping: 15 }, decor: "glass-rim" },
        "text/title/idle": { textColor: "#f4f7ff", font: "600 26px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "text/body/idle": { textColor: "rgba(230,236,255,0.75)", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "pressable/primary/idle": { fill: "rgba(120,160,255,0.55)", corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#ffffff", font: "600 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "pressable/primary/hovered": { fill: "rgba(140,180,255,0.70)", corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#ffffff", font: "600 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "pressable/primary/pressed": { fill: "rgba(100,140,240,0.80)", corners: { radius: [22, 22, 22, 22], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [1, 1, 0, 0], live: true }, textColor: "#ffffff", font: "600 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
