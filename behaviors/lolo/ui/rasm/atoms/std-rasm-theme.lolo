        "choice/default/open": { fill: "rgba(42,36,51,0.10)", stroke: "#b03a2e", strokeWidth: 2.6, corners: { radius: [5, 5, 5, 5], kind: "round" }, textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
        "textfield/default/label": { textColor: "#1f1a26", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
