        },
        "jazari": {
          "surface/ground/idle": { fill: "#2b1b0f", material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = max(px.size, vec2<f32>(1.0, 1.0));\n  let q = px.local / sz;\n  let grain = jz_noise(px.local * vec2<f32>(0.9, 0.06)) * 0.55 + jz_noise(px.local * 0.35) * 0.45;\n  var col = vec3<f32>(0.93, 0.87, 0.74) + vec3<f32>(0.06, 0.05, 0.03) * (grain - 0.5);\n  let foxing = smoothstep(0.9, 0.99, jz_noise(px.local * 0.02 + vec2<f32>(7.0, 3.0)));\n  col = mix(col, vec3<f32>(0.72, 0.56, 0.36), foxing * 0.12);\n  let side = min(px.local.x, sz.x - px.local.x);\n  col = mix(vec3<f32>(0.78, 0.66, 0.47), col, smoothstep(0.0, 60.0, side));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
          "stack/panel/idle": { fill: "rgba(246,236,212,0.96)", corners: { radius: [16, 16, 16, 16], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let grain = jz_noise(px.local * vec2<f32>(0.8, 0.07)) - 0.5;\n  var col = mix(px.behind.rgb, vec3<f32>(0.96, 0.92, 0.82), 0.9) + vec3<f32>(0.025, 0.02, 0.012) * grain + vec3<f32>(0.02, 0.016, 0.006) * px.a.x;\n  let outer = 1.0 - smoothstep(0.45, 1.2, abs(e - 1.0));\n  let inner = 1.0 - smoothstep(0.3, 0.8, abs(e - 5.0));\n  col = mix(col, vec3<f32>(0.17, 0.11, 0.06), outer * (0.85 + 0.15 * px.a.z));\n  col = mix(col, vec3<f32>(0.71, 0.2, 0.12), inner * 0.8);\n  return vec4<f32>(col, 0.98);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 210, damping: 22 } },
          "text/title/idle": { textColor: "#2b1b0f", font: "600 34px serif", spring: { stiffness: 210, damping: 22 } },
          "text/body/idle": { textColor: "#4a3826", font: "400 17px serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/idle": { fill: "#1c3378", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f6ecd2", font: "600 15px serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/hovered": { fill: "#1c3378", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f6ecd2", font: "600 15px serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/pressed": { fill: "#1c3378", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f6ecd2", font: "600 15px serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/primary/focused": { fill: "#1c3378", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let grain = jz_noise(px.local * 0.6) - 0.5;\n  var col = vec3<f32>(0.11, 0.2, 0.47) + vec3<f32>(0.04, 0.05, 0.08) * grain + vec3<f32>(0.05, 0.06, 0.1) * px.a.x - vec3<f32>(0.04, 0.04, 0.06) * px.a.y;\n  let rim = 1.0 - smoothstep(0.4, 1.4, abs(-px.sdf - 1.2));\n  col = mix(col, vec3<f32>(0.86, 0.66, 0.22), rim * 0.9);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#f6ecd2", font: "600 15px serif", spring: { stiffness: 210, damping: 22 }, stroke: "#c08a1e", strokeWidth: 2 },
          "pressable/primary/disabled": { fill: "rgba(28,51,120,0.35)", corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "rgba(246,236,210,0.6)", font: "600 15px serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/idle": { fill: "rgba(246,236,212,0.96)", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "fn jz_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn jz_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (vec2<f32>(3.0, 3.0) - 2.0 * f);\n  let a = jz_hash(i);\n  let b = jz_hash(i + vec2<f32>(1.0, 0.0));\n  let c = jz_hash(i + vec2<f32>(0.0, 1.0));\n  let d = jz_hash(i + vec2<f32>(1.0, 1.0));\n  return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let e = -px.sdf;\n  let grain = jz_noise(px.local * vec2<f32>(0.8, 0.07)) - 0.5;\n  var col = mix(px.behind.rgb, vec3<f32>(0.96, 0.92, 0.82), 0.9) + vec3<f32>(0.025, 0.02, 0.012) * grain + vec3<f32>(0.02, 0.016, 0.006) * px.a.x;\n  let outer = 1.0 - smoothstep(0.45, 1.2, abs(e - 1.0));\n  let inner = 1.0 - smoothstep(0.3, 0.8, abs(e - 5.0));\n  col = mix(col, vec3<f32>(0.17, 0.11, 0.06), outer * (0.85 + 0.15 * px.a.z));\n  col = mix(col, vec3<f32>(0.71, 0.2, 0.12), inner * 0.8);\n  return vec4<f32>(col, 0.98);\n}\n", params: [0, 0, 0, 0], live: false }, textColor: "#2b1b0f", font: "500 15px serif", spring: { stiffness: 210, damping: 22 } },
