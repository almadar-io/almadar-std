          "orbit/station/hovered": { fill: "rgba(24,28,58,0.95)", stroke: "#5fd3c6", strokeWidth: 1.4, shadow: { color: "rgba(95,211,198,0.4)", blur: 16 }, spring: { stiffness: 170, damping: 20 } },
