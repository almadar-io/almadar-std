        "toggle/switch/on-focused": { fill: "#2f6282", stroke: "#f2a03a", strokeWidth: 1.6, corners: { radius: [3, 3, 3, 3], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus, a.w line pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let pitch = max(px.a.w, 1.0);\n  let brush = 0.5 + 0.5 * sin(px.local.y * 6.2831853 / pitch);\n  var col = px.color.rgb * (0.94 + 0.06 * brush);\n  col = col + vec3<f32>(0.10) * (1.0 - px.uv.y) * (0.6 + 0.4 * px.a.x);\n  let tick = step(0.5, fract(px.local.x / 10.0)) * (1.0 - smoothstep(0.0, 5.0, px.local.y));\n  col = col + vec3<f32>(0.6, 0.72, 0.8) * tick * 0.22;\n  let inner = 1.0 - smoothstep(0.0, 0.8, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.62, 0.74, 0.82), inner * 0.38);\n  let rim = smoothstep(-1.2, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(0.95, 0.62, 0.20), rim * (0.2 + 0.5 * px.a.z + 0.3 * px.a.x));\n  col = col * (1.0 - 0.16 * px.a.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.95, 0.62, 0.20) * exp(-d * d / (2.0 * 36.0 * 36.0)) * 0.10 * px.a.x;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 14], live: true }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "range/default/track": { fill: "rgba(127,152,168,0.25)", corners: { radius: [1, 1, 1, 1], kind: "round" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "range/default/fill": { fill: "#f2a03a", corners: { radius: [1, 1, 1, 1], kind: "round" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "range/default/thumb-idle": { fill: "#dce8ee", stroke: "#f2a03a", strokeWidth: 1, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 }, decor: "hairline-notch" },
        "range/default/thumb-hovered": { fill: "#ffffff", stroke: "#f2a03a", strokeWidth: 1, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 }, decor: "hairline-notch" },
        "range/default/thumb-dragging": { fill: "#ffffff", stroke: "#f2a03a", strokeWidth: 1, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 }, decor: "hairline-notch" },
        "range/default/thumb-focused": { fill: "#ffffff", stroke: "#f2a03a", strokeWidth: 1, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 }, decor: "hairline-notch" },
        "textfield/default/idle": { fill: "rgba(127,152,168,0.07)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/hovered": { fill: "rgba(127,152,168,0.14)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/focused": { fill: "rgba(127,152,168,0.07)", stroke: "#f2a03a", strokeWidth: 1.6, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/disabled": { fill: "rgba(127,152,168,0.03)", strokeWidth: 0, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "choice/default/idle": { fill: "rgba(127,152,168,0.07)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "choice/default/hovered": { fill: "rgba(127,152,168,0.14)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "choice/default/focused": { fill: "rgba(127,152,168,0.07)", stroke: "#f2a03a", strokeWidth: 1.6, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "choice/default/open": { fill: "rgba(127,152,168,0.14)", stroke: "#f2a03a", strokeWidth: 1.6, corners: { radius: [3, 3, 3, 3], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/label": { textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "choice/default/label": { textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/placeholder": { textColor: "rgba(206,222,230,0.38)", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/selection": { fill: "rgba(242,160,58,0.35)", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/caret": { fill: "#f2a03a", spring: { stiffness: 420, damping: 34 } },
        "choice/popup/idle": { fill: "rgba(12,16,22,0.98)", stroke: "#7f98a8", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "notch" }, shadow: { color: "rgba(0,0,0,0.6)", blur: 14 }, spring: { stiffness: 420, damping: 34 } },
        "choice/option/idle": { fill: "rgba(0,0,0,0)", corners: { radius: [2, 2, 2, 2], kind: "notch" }, textColor: "#cfdde6", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } },
        "choice/option/active": { fill: "#27506a", corners: { radius: [2, 2, 2, 2], kind: "notch" }, textColor: "#ffffff", font: "400 14px monospace", spring: { stiffness: 420, damping: 34 } }
      }
        @label "Instrument looks"
        @description "Engraved hairlines, gauge arcs, tight springs. Every look keyed component/intent/state."
        @tier "presentation"
      terminal : Map string RasmLook = {
        "surface/ground/idle": { fill: "#020805", material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// phosphor on black: scanlines, 12 fps flicker, a slow roll bar, bloom under the pointer\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  var col = vec3<f32>(0.01, 0.025, 0.015);\n  let scan = 0.5 + 0.5 * sin(px.local.y * 3.14159265);\n  col = col + vec3<f32>(0.0, 0.05, 0.02) * scan;\n  let roll = fract(px.uv.y - step_t * 0.012);\n  col = col + vec3<f32>(0.0, 0.07, 0.03) * smoothstep(0.9, 1.0, roll);\n  let grain = tm_hash(px.local + vec2<f32>(step_t * 7.0, step_t * 3.0));\n  col = col + vec3<f32>(0.0, 0.03, 0.01) * grain;\n  let flick = 0.96 + 0.04 * tm_hash(vec2<f32>(step_t, 1.0));\n  let v = px.uv - vec2<f32>(0.5, 0.5);\n  col = col * flick * (1.0 - dot(v, v) * 0.9);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.15, 0.9, 0.4) * exp(-d * d / (2.0 * 90.0 * 90.0)) * 0.10;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 900, damping: 70 } },
        "stack/panel/idle": { fill: "rgba(3,14,8,0.94)", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, shadow: { color: "rgba(47,209,106,0.28)", blur: 22 }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, spring: { stiffness: 900, damping: 70 }, decor: "crt-frame" },
        "text/title/idle": { textColor: "#5dff95", font: "700 24px monospace", spring: { stiffness: 900, damping: 70 } },
        "text/body/idle": { textColor: "rgba(93,255,149,0.8)", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "pressable/primary/idle": { fill: "#0e5a2c", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#c8ffd9", font: "700 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "pressable/primary/hovered": { fill: "#14753a", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, shadow: { color: "rgba(47,209,106,0.4)", blur: 12 }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#c8ffd9", font: "700 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "pressable/primary/pressed": { fill: "#0a421f", stroke: "#2fd16a", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "notch" }, material: { wgsl: "fn tm_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn tm_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(tm_hash(i), tm_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(tm_hash(i + vec2<f32>(0.0, 1.0)), tm_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w scanline pitch in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let step_t = floor(px.time * 12.0);\n  let pitch = max(px.a.w, 1.0);\n  let scan = 0.78 + 0.22 * step(0.5, fract(px.local.y / pitch));\n  var col = px.color.rgb * scan;\n  col = col * (0.95 + 0.05 * tm_hash(vec2<f32>(step_t, floor(px.local.y / pitch))));\n  col = col + vec3<f32>(0.1, 0.8, 0.35) * 0.12 * px.a.x;\n  let edge = 1.0 - smoothstep(0.0, 1.5, abs(px.sdf + 1.0));\n  col = mix(col, vec3<f32>(0.35, 1.0, 0.55), edge * (0.35 + 0.4 * px.a.x + 0.4 * px.a.z));\n  let blink = step(0.5, fract(px.time * 1.6));\n  let cursor = step(px.size.x - 10.0, px.local.x) * step(px.local.x, px.size.x - 4.0) * step(4.0, px.local.y) * step(px.local.y, px.size.y - 4.0);\n  col = col + vec3<f32>(0.3, 1.0, 0.5) * cursor * blink * px.a.z * 0.6;\n  col = mix(col, vec3<f32>(0.4, 1.0, 0.6), px.a.y * 0.3);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#c8ffd9", font: "700 14px monospace", spring: { stiffness: 900, damping: 70 } },
