        "ukiyo-e": {
          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn uk_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(12.9898, 78.233))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let indigo = vec3<f32>(0.14, 0.26, 0.45);\n  let red = vec3<f32>(0.78, 0.20, 0.16);\n  let lum = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114));\n  let W = 84.0;\n  let off = vec2<f32>(px.time * 3.0 + px.scroll * 60.0, 0.0);\n  let p = px.local + off;\n  let pa = p / vec2<f32>(W, W * 0.5);\n  let ca = (floor(pa) + vec2<f32>(0.5, 0.0)) * vec2<f32>(W, W * 0.5);\n  let pb = (p - vec2<f32>(W * 0.5, W * 0.25)) / vec2<f32>(W, W * 0.5);\n  let cb = (floor(pb) + vec2<f32>(0.5, 0.0)) * vec2<f32>(W, W * 0.5) + vec2<f32>(W * 0.5, W * 0.25);\n  let da = length(p - ca - vec2<f32>(0.0, W * 0.25));\n  let db = length(p - cb - vec2<f32>(0.0, W * 0.25));\n  let r = min(da, db);\n  let rings = 1.0 - smoothstep(0.0, 0.18, abs(fract(r / (W * 0.5) * 3.0) - 0.5) - 0.38);\n  let fade = smoothstep(0.0, 0.85, px.uv.y) * 0.8 + 0.2;\n  let sun = 1.0 - smoothstep(0.0, 1.5, length((px.local - vec2<f32>(px.size.x * 0.82, px.size.y * 0.16))) - 54.0);\n  let n = uk_h(floor(px.local)) - 0.5;\n  var col = mix(px.color.rgb, select(indigo, indigo * 1.6, lum < 0.5), rings * 0.09 * fade);\n  col = mix(col, red, sun * 0.10);\n  return vec4<f32>(col + n * 0.015, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
