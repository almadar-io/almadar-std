          "machine/guard/idle": { fill: "rgba(16,22,52,0.9)", stroke: "#efe2c4", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#b8341f", stroke: "#b8341f", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#b8341f", stroke: "#b8341f", corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "#f6ecd2", font: "600 11px serif" },
          "machine/token/idle": { fill: "#c08a1e", stroke: "#7a4f05", strokeWidth: 1, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.36, 0.32);\n  let spec = pow(max(0.0, 1.0 - length(c) * 2.6), 3.0);\n  let body = mix(vec3<f32>(0.95, 0.74, 0.25), vec3<f32>(0.55, 0.36, 0.05), smoothstep(0.0, 0.7, length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(body + vec3<f32>(1.0, 0.97, 0.85) * spec, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
          "machine/bloom/idle": { stroke: "#c08a1e", strokeWidth: 2 },
