          "overlay/scrim/idle": { fill: "rgba(44,37,24,0.45)", spring: { stiffness: 170, damping: 20 } },
          "overlay/dialog/idle": { fill: "rgba(251,246,234,0.98)", stroke: "#c8921a", strokeWidth: 1.5, corners: { radius: [18, 18, 18, 18], kind: "notch" }, shadow: { color: "rgba(80,60,20,0.22)", blur: 44 }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, spring: { stiffness: 170, damping: 20 }, decor: "naqsh-stars" },
          "scroll/default/body": { fill: "rgba(0,0,0,0)", strokeWidth: 0, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, spring: { stiffness: 170, damping: 20 } },
          "scroll/default/track": { fill: "rgba(200,146,26,0.18)", corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 170, damping: 20 } },
          "scroll/default/thumb": { fill: "#c8921a", stroke: "#17807a", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 170, damping: 20 } },
          "scroll/default/thumb-dragging": { fill: "#ffffff", stroke: "#17807a", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 170, damping: 20 } },
          "drag/default/idle": { fill: "rgba(43,74,160,0.08)", stroke: "#2b4aa0", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "rgba(44,37,24,0.92)", font: "400 16px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "drag/default/dragging": { fill: "rgba(43,74,160,0.16)", stroke: "#2b4aa0", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "rgba(44,37,24,0.92)", font: "400 16px sans-serif", spring: { stiffness: 170, damping: 20 }, shadow: { color: "rgba(80,60,20,0.22)", blur: 28 } },
          "mirror/primary/idle": { fill: "rgba(251,246,234,0.94)", stroke: "#c8921a", strokeWidth: 1.5, corners: { radius: [18, 18, 18, 18], kind: "notch" }, shadow: { color: "rgba(80,60,20,0.22)", blur: 28 }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, spring: { stiffness: 170, damping: 20 }, decor: "naqsh-stars" },
          "particles/primary/idle": { fill: "#c8921a" },
          "orbit/ring/idle": { stroke: "rgba(184,132,28,0.7)", strokeWidth: 1.2 },
          "orbit/arc/lit": { stroke: "#1f4f9a", strokeWidth: 2.6 },
          "orbit/station/idle": { fill: "rgba(251,246,234,0.95)", stroke: "rgba(184,132,28,0.7)", strokeWidth: 1.2, shadow: { color: "rgba(80,60,20,0.2)", blur: 10 }, spring: { stiffness: 170, damping: 20 } },
          "orbit/station/hovered": { fill: "rgba(255,250,238,0.98)", stroke: "#17807a", strokeWidth: 1.4, shadow: { color: "rgba(23,128,122,0.35)", blur: 16 }, spring: { stiffness: 170, damping: 20 } },
          "orbit/station/focused": { fill: "rgba(251,246,234,0.95)", stroke: "#17807a", strokeWidth: 2.4, shadow: { color: "rgba(80,60,20,0.2)", blur: 10 }, spring: { stiffness: 170, damping: 20 } },
          "orbit/station/active": { fill: "#1f4f9a", stroke: "#b8841c", strokeWidth: 1.6, shadow: { color: "rgba(23,128,122,0.35)", blur: 22 }, spring: { stiffness: 170, damping: 20 } },
          "orbit/beat/idle": { stroke: "#17807a", fill: "rgba(23,128,122,0.35)" },
          "orbit/label/idle": { textColor: "rgba(44,37,24,0.92)", font: "400 13px Cairo, sans-serif" },
          "orbit/label/active": { textColor: "#1c3578", font: "600 13px Cairo, sans-serif" },
          "orbit/core/idle": { fill: "rgba(251,246,234,0.96)", stroke: "rgba(184,132,28,0.7)", strokeWidth: 1.2, backdrop: { blur: 8, tint: "rgba(23,128,122,0.35)", saturate: 1.1 } },
          "machine/state/idle": { fill: "rgba(251,246,234,0.90)", stroke: "rgba(184,132,28,0.7)", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(44,37,24,0.92)", font: "400 16px Cairo, sans-serif" },
          "machine/state/active": { fill: "#1f4f9a", stroke: "#b8841c", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fbf5e6", font: "600 15px Cairo, sans-serif", material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(251,246,234,0.90)", stroke: "#1f4f9a", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(44,37,24,0.92)", font: "400 16px Cairo, sans-serif" },
          "machine/wire/idle": { stroke: "rgba(44,37,24,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(44,37,24,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#1f4f9a", strokeWidth: 2.5 },
          "machine/pill/idle": { fill: "rgba(251,246,234,0.96)", stroke: "rgba(44,37,24,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(251,246,234,0.96)", stroke: "rgba(44,37,24,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(251,246,234,0.96)", stroke: "#1f4f9a", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(31,79,154,0.12)" },
          "machine/event/idle": { textColor: "rgba(44,37,24,0.9)", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#1f4f9a", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(251,246,234,0.90)", stroke: "rgba(44,37,24,0.9)", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#1f4f9a", stroke: "#b8841c", textColor: "#fbf5e6", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px Cairo, sans-serif" },
          "machine/token/idle": { fill: "#1f4f9a", stroke: "#1f4f9a", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#1f4f9a", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "rgba(44,37,24,0.9)", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(251,246,234,0.96)", stroke: "rgba(184,132,28,0.7)", strokeWidth: 1.2, corners: { radius: [18, 18, 18, 18], kind: "notch" }, backdrop: { blur: 10, tint: "rgba(23,128,122,0.35)", saturate: 1.1 } },
          "text/code/idle": { textColor: "rgba(44,37,24,0.9)", font: "400 14px monospace" },
          "text/code/active": { textColor: "#1f4f9a", font: "700 14px monospace" }
        },
        "taif-night": {
          "surface/ground/idle": { fill: "#000000", material: { wgsl: "// a quiet eight-point star lattice over sand or night, fixed in place\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 72.0;\n  let cell = fract(p) - vec2<f32>(0.5, 0.5);\n  let ang = atan2(cell.y, cell.x);\n  let r = length(cell);\n  let star = abs(cos(ang * 4.0)) * 0.12 + 0.18;\n  let ln = 1.0 - smoothstep(0.0, 0.02, abs(r - star));\n  var col = mix(vec3<f32>(0.07, 0.07, 0.12), vec3<f32>(0.10, 0.09, 0.16), px.uv.y);\n  col = mix(col, vec3<f32>(0.94, 0.72, 0.23), ln * 0.10);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 170, damping: 20 } },
          "stack/panel/idle": { fill: "rgba(13,15,34,0.82)", backdrop: { blur: 14, tint: "rgba(127,155,255,0.05)", saturate: 1.15 }, stroke: "rgba(233,185,73,0.6)", strokeWidth: 1, corners: { radius: [18, 18, 18, 18], kind: "notch" }, shadow: { color: "rgba(0,0,0,0.55)", blur: 32 }, material: { wgsl: "// a glass card: a gold inlay line inside its edge and a faint star lattice that gathers in the corners\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb;\n  let cell = fract(px.local / 48.0) - vec2<f32>(0.5, 0.5);\n  let star = abs(cos(atan2(cell.y, cell.x) * 4.0)) * 0.12 + 0.2;\n  let ln = 1.0 - smoothstep(0.0, 0.025, abs(length(cell) - star));\n  let corner = 1.0 - smoothstep(0.0, 0.22, min(min(px.uv.x, 1.0 - px.uv.x), min(px.uv.y, 1.0 - px.uv.y)));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), ln * (0.03 + 0.14 * corner));\n  let inlay = 1.0 - smoothstep(0.3, 1.0, abs(px.sdf + 7.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * 0.55);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 40000.0) * 0.05;\n  return vec4<f32>(col, max(px.color.a, inlay * 0.55));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 170, damping: 20 }, decor: "naqsh-stars" },
          "text/title/idle": { textColor: "#f4cf72", font: "700 28px 'Reem Kufi', serif", spring: { stiffness: 170, damping: 20 } },
          "text/body/idle": { textColor: "rgba(243,232,207,0.92)", font: "400 16px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/idle": { fill: "#183a78", stroke: "#e9b949", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#fbf1d6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/hovered": { fill: "#1f4b98", stroke: "#e9b949", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#fbf1d6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/pressed": { fill: "#13305f", stroke: "#e9b949", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 1, 0, 0], live: true }, textColor: "#fbf1d6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/focused": { fill: "#183a78", stroke: "#5fd3c6", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 1, 0], live: true }, textColor: "#fbf1d6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/primary/disabled": { fill: "rgba(24,58,120,0.35)", stroke: "#e9b94959", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#fbf1d6", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/idle": { fill: "rgba(233,185,73,0.06)", stroke: "#e9b949", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#f4cf72", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/hovered": { fill: "rgba(233,185,73,0.14)", stroke: "#e9b949", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#f4cf72", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/pressed": { fill: "rgba(233,185,73,0.22)", stroke: "#e9b949", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [1, 1, 0, 0], live: true }, textColor: "#f4cf72", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/focused": { fill: "rgba(233,185,73,0.06)", stroke: "#5fd3c6", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 1, 0], live: true }, textColor: "#f4cf72", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "pressable/secondary/disabled": { fill: "rgba(233,185,73,0.06)", stroke: "#e9b94959", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.93, 0.73, 0.30), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#f4cf72", font: "600 15px Cairo, sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/off-idle": { fill: "rgba(240,183,58,0.12)", stroke: "#f0b73a", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#f3e8cf", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/off-hovered": { fill: "rgba(240,183,58,0.12)", stroke: "#f0b73a", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#f3e8cf", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/off-focused": { fill: "rgba(240,183,58,0.12)", stroke: "#f08fa6", strokeWidth: 2.4, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#f3e8cf", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
          "toggle/check/on-idle": { fill: "#f0b73a", stroke: "#1a1208", strokeWidth: 1.2, corners: { radius: [4, 4, 4, 4], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#f3e8cf", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
