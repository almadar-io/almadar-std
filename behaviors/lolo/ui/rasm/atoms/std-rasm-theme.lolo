          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#f3e6c8", font: "400 15px sans-serif", corners: { radius: [4, 4, 4, 4], kind: "bevel" }, spring: { stiffness: 170, damping: 20 } },
