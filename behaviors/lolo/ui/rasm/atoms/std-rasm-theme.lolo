          "textfield/default/idle": { fill: "rgba(255,255,255,0.7)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "rgba(27,29,42,0.3)", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
