            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet stem = c.x + sin(p.y * 0.025) * 6.0;\nvar a = sg_line(p.x - stem, 0.8) * step(10.0, p.y) * step(p.y, s.y - 6.0);\nfor (var i = 0; i < 4; i = i + 1) {\n  let f = f32(i);\n  let yk = s.y * 0.78 - f * s.y * 0.18;\n  let side = select(1.0, -1.0, fract(f * 0.5) > 0.25);\n  let lp = sg_rot(p - vec2<f32>(c.x + sin(yk * 0.025) * 6.0 + side * 13.0, yk - 6.0), side * -0.7);\n  a = max(a, sg_line((length(lp / vec2<f32>(14.0, 5.5)) - 1.0) * 5.5, 0.8));\n}\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } }
