          "toggle/switch/on-idle": { fill: "#c9a14a", stroke: "#141414", strokeWidth: 1.2, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#141414", font: "400 15px serif", spring: { stiffness: 90, damping: 18 } },
          "toggle/switch/on-hovered": { fill: "#c9a14a", stroke: "#141414", strokeWidth: 1.2, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#141414", font: "400 15px serif", spring: { stiffness: 90, damping: 18 } },
          "toggle/switch/on-focused": { fill: "#c9a14a", stroke: "#141414", strokeWidth: 2, corners: { radius: [12, 12, 12, 12], kind: "round" }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#141414", font: "400 15px serif", spring: { stiffness: 90, damping: 18 } },
