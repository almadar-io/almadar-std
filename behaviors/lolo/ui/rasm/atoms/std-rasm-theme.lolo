        "toggle/switch/on-hovered": { fill: "rgba(120,220,200,0.75)", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [1, 0, 0, 0], live: true }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "toggle/switch/on-focused": { fill: "rgba(120,220,200,0.75)", stroke: "rgba(255,255,255,0.9)", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 1, 0], live: true }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "range/default/track": { fill: "rgba(255,255,255,0.16)", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "range/default/fill": { fill: "rgba(140,180,255,0.9)", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "range/default/thumb-idle": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 16 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "range/default/thumb-hovered": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 24 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "range/default/thumb-dragging": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 24 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "range/default/thumb-focused": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 24 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" }
      }
        @label "Glass looks"
        @description "Cool aurora, frost, liquid springs: every look keyed component/intent/state."
