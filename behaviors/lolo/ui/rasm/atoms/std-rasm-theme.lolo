          "pressable/secondary/focused": { fill: "rgba(255,255,255,0.5)", backdrop: { blur: 14, tint: "rgba(255,255,255,0.3)", saturate: 1.2 }, stroke: "#2b3a9e", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "pressable/secondary/disabled": { fill: "rgba(255,255,255,0.3)", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "rgba(69,72,97,0.5)", font: "600 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/off-idle": { fill: "rgba(255,255,255,0.85)", corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/off-hovered": { fill: "rgba(255,255,255,0.85)", corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/off-focused": { fill: "rgba(255,255,255,0.85)", stroke: "#2b3a9e", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/on-idle": { fill: "#ffffff", corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// the spectrum gathered inside a white rim, for a switched-on control; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(vec3<f32>(1.0, 1.0, 1.0), spec, 0.8);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * 0.7);\n  col = col * (1.0 + 0.08 * px.a.x);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/on-hovered": { fill: "#ffffff", corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// the spectrum gathered inside a white rim, for a switched-on control; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(vec3<f32>(1.0, 1.0, 1.0), spec, 0.8);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * 0.7);\n  col = col * (1.0 + 0.08 * px.a.x);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/check/on-focused": { fill: "#ffffff", stroke: "#2b3a9e", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, material: { wgsl: "// the spectrum gathered inside a white rim, for a switched-on control; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let phase = px.uv.x * 0.85 + px.time * 0.03 + px.a.y * 0.3;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  var col = mix(vec3<f32>(1.0, 1.0, 1.0), spec, 0.8);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * 0.7);\n  col = col * (1.0 + 0.08 * px.a.x);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
          "toggle/switch/off-idle": { fill: "rgba(255,255,255,0.85)", corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// frosted white glass edged by a hairline of the whole spectrum, hue by angle around the shape; a.x hover, a.y press (turns the hue), a.z focus\nfn pr_hue(h: f32) -> vec3<f32> {\n  let k = vec3<f32>(1.0, 0.6667, 0.3333);\n  return clamp(abs(fract(vec3<f32>(h) + k) * 6.0 - vec3<f32>(3.0, 3.0, 3.0)) - vec3<f32>(1.0, 1.0, 1.0), vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let ang = atan2(c.y, c.x) / 6.2831853 + 0.5;\n  let phase = ang + px.time * 0.02 + px.a.y * 0.3 + px.pointer.x / max(px.size.x, 1.0) * 0.12;\n  let spec = pr_hue(phase);\n  let rim = smoothstep(-1.6, -0.7, px.sdf);\n  let strength = clamp(0.78 + 0.22 * px.a.x, 0.0, 1.0);\n  let lit = min(spec * (1.0 + 0.25 * px.a.x), vec3<f32>(1.0, 1.0, 1.0));\n  var col = mix(px.color.rgb, spec, 0.03 * (1.0 - rim));\n  col = mix(col, lit, rim * strength);\n  return vec4<f32>(col, max(px.color.a, rim * strength));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#1b1d2a", font: "400 15px sans-serif", spring: { stiffness: 210, damping: 22 } },
