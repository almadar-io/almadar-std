        "toggle/switch/on-focused": { fill: "rgba(120,220,200,0.75)", stroke: "rgba(255,255,255,0.9)", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, material: { wgsl: "// a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb + vec3<f32>(0.10, 0.10, 0.10) * (1.0 - px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * exp(-d * d / (2.0 * 60.0 * 60.0)) * (0.16 + 0.34 * px.a.x);\n  let t = px.time * 0.6;\n  col = col + vec3<f32>(0.04 * sin(px.local.x * 0.05 + t) * sin(px.local.y * 0.07 - t * 1.3));\n  let rim = smoothstep(-2.5, 0.0, px.sdf);\n  col = mix(col, vec3<f32>(1.0, 1.0, 1.0), rim * (0.45 + 0.4 * px.a.z));\n  col = col * (1.0 - 0.12 * px.a.y * (1.0 - length(px.uv - vec2<f32>(0.5, 0.5))));\n  return vec4<f32>(col, px.color.a * (0.55 + 0.25 * px.a.x + 0.2 * rim));\n}\n", params: [0, 0, 1, 0], live: true }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "range/default/track": { fill: "rgba(255,255,255,0.16)", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "range/default/fill": { fill: "rgba(140,180,255,0.9)", corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "range/default/thumb-idle": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 16 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "range/default/thumb-hovered": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 24 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "range/default/thumb-dragging": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 24 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "range/default/thumb-focused": { fill: "#ffffff", shadow: { color: "rgba(120,160,255,0.6)", blur: 24 }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 }, decor: "" },
        "textfield/default/idle": { fill: "rgba(255,255,255,0.14)", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/hovered": { fill: "rgba(255,255,255,0.22)", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/focused": { fill: "rgba(255,255,255,0.14)", stroke: "rgba(255,255,255,0.9)", strokeWidth: 2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/disabled": { fill: "rgba(255,255,255,0.07)", strokeWidth: 0, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "choice/default/idle": { fill: "rgba(255,255,255,0.14)", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "choice/default/hovered": { fill: "rgba(255,255,255,0.22)", stroke: "rgba(255,255,255,0.35)", strokeWidth: 1.2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "choice/default/focused": { fill: "rgba(255,255,255,0.14)", stroke: "rgba(255,255,255,0.9)", strokeWidth: 2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "choice/default/open": { fill: "rgba(255,255,255,0.22)", stroke: "rgba(255,255,255,0.9)", strokeWidth: 2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/label": { textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "choice/default/label": { textColor: "#f4f7ff", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/placeholder": { textColor: "rgba(244,247,255,0.5)", font: "400 15px sans-serif", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/selection": { fill: "rgba(140,180,255,0.45)", spring: { stiffness: 320, damping: 15 } },
        "textfield/default/caret": { fill: "#ffffff", spring: { stiffness: 320, damping: 15 } },
        "choice/popup/idle": { fill: "rgba(40,52,92,0.92)", stroke: "rgba(255,255,255,0.4)", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(20,30,70,0.5)", blur: 24 }, spring: { stiffness: 320, damping: 15 } },
        "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#f4f7ff", font: "400 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 320, damping: 15 } },
        "choice/option/active": { fill: "rgba(140,180,255,0.55)", textColor: "#ffffff", font: "400 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 320, damping: 15 } }
      }
        @label "Glass looks"
        @description "Cool aurora, frost, liquid springs: every look keyed component/intent/state."
        @tier "presentation"
      sand : Map string RasmLook = {
        "surface/ground/idle": { fill: "#6b4a2a", material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// dune ridges drifting on the wind, grain glitter, a warm lamp under the pointer\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = px.time * 9.0;\n  let p = px.local + vec2<f32>(wind, wind * 0.35);\n  let ridge = sin(p.x * 0.012 + 2.4 * sd_noise(p * 0.004) + px.uv.y * 5.0) * 0.5 + 0.5;\n  let crest = smoothstep(0.55, 0.9, ridge) - smoothstep(0.9, 1.0, ridge) * 0.6;\n  var col = mix(vec3<f32>(0.36, 0.24, 0.13), vec3<f32>(0.62, 0.45, 0.26), px.uv.y);\n  col = col + vec3<f32>(0.30, 0.20, 0.09) * crest * 0.55;\n  col = col - vec3<f32>(0.10, 0.08, 0.05) * (1.0 - ridge) * 0.35;\n  let g = sd_hash(floor(px.local / 1.5) + floor(px.time * 2.0));\n  col = col + vec3<f32>(0.9, 0.75, 0.5) * step(0.985, g) * 0.35;\n  let streak = sd_noise(vec2<f32>(p.x * 0.02, p.y * 0.4));\n  col = col + vec3<f32>(0.08, 0.06, 0.03) * streak * (0.5 + 0.5 * sin(px.time * 0.4));\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.78, 0.45) * exp(-d * d / (2.0 * 170.0 * 170.0)) * 0.32;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 14 } },
        "stack/panel/idle": { fill: "rgba(88,60,34,0.88)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [30, 30, 30, 30], kind: "round" }, shadow: { color: "rgba(40,22,8,0.5)", blur: 34 }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, spring: { stiffness: 120, damping: 14 }, decor: "dune-ripple" },
        "text/title/idle": { textColor: "#fff1d6", font: "600 28px serif", spring: { stiffness: 120, damping: 14 } },
