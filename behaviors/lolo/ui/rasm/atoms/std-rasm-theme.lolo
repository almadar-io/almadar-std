          "orbit/core/idle": { fill: "rgba(88,60,34,0.96)", stroke: "rgba(227,184,120,0.6)", strokeWidth: 1.2, backdrop: { blur: 8, tint: "rgba(255,226,166,0.4)", saturate: 1.1 } },
          "machine/state/idle": { fill: "rgba(88,60,34,0.88)", stroke: "#e3b878", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(255,241,214,0.82)", font: "400 15px sans-serif" },
          "machine/state/active": { fill: "#b8662a", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fff6e4", font: "600 15px sans-serif", material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true } },
          "machine/state/visited": { fill: "rgba(88,60,34,0.88)", stroke: "#ffe2a6", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(255,241,214,0.82)", font: "400 15px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(255,241,214,0.45)", strokeWidth: 1.5 },
