        "section/band/idle": { fill: "muted" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 4 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(0,0,0,0.35)", blur: 20 }, spring: { stiffness: 140, damping: 22 } },
        "image/none/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> { return im_px(px, vec2<f32>(0.0, 0.0)) * px.color.a; }\n", params: [0, 0, 0, 0], live: false } },
        "image/duotone/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let l = smoothstep(0.08, 0.92, im_luma(c.rgb / max(c.a, 0.001)));\n  let col = mix(px.color.rgb * 0.16, mix(px.color.rgb, vec3<f32>(1.0, 1.0, 1.0), 0.78), l);\n  return vec4<f32>(col * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } },
        "image/halftone/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let l = im_luma(c.rgb / max(c.a, 0.001));\n  let r = mat2x2<f32>(0.7071, -0.7071, 0.7071, 0.7071) * px.local;\n  let cell = fract(r / 7.0) - vec2<f32>(0.5, 0.5);\n  let dot_r = sqrt(1.0 - l) * 0.62;\n  let ink = 1.0 - smoothstep(dot_r - 0.08, dot_r + 0.08, length(cell));\n  let paper = mix(px.color.rgb, vec3<f32>(1.0, 1.0, 1.0), 0.9);\n  return vec4<f32>(mix(paper, px.color.rgb * 0.35, ink) * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } },
        "image/riso/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let a = im_px(px, vec2<f32>(1.5, -1.0));\n  let b = im_px(px, vec2<f32>(-1.5, 1.0));\n  let la = 1.0 - im_luma(a.rgb / max(a.a, 0.001));\n  let lb = 1.0 - im_luma(b.rgb / max(b.a, 0.001));\n  let grain = im_hash(floor(px.local / 1.5)) * 0.18;\n  let paper = vec3<f32>(0.97, 0.95, 0.9);\n  let ink_a = px.color.rgb;\n  let ink_b = vec3<f32>(1.0, 0.28, 0.69);\n  var col = paper * (1.0 - clamp(la - grain, 0.0, 1.0) * (vec3<f32>(1.0, 1.0, 1.0) - ink_a));\n  col = col * (1.0 - clamp(lb * 0.55 - grain, 0.0, 1.0) * (vec3<f32>(1.0, 1.0, 1.0) - ink_b));\n  let al = max(a.a, b.a);\n  return vec4<f32>(col * al, al) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } },
        "image/engraving/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let l = im_luma(c.rgb / max(c.a, 0.001));\n  let line = abs(fract((px.local.x * 0.35 + px.local.y) / 4.0) - 0.5) * 2.0;\n  let ink = 1.0 - smoothstep(l * 0.9, l * 0.9 + 0.12, line);\n  let paper = mix(px.color.rgb, vec3<f32>(1.0, 1.0, 1.0), 0.88);\n  return vec4<f32>(mix(paper, px.color.rgb * 0.25, ink) * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } },
        "image/glow/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  var bloom = vec3<f32>(0.0, 0.0, 0.0);\n  for (var i = 0; i < 8; i = i + 1) {\n    let ang = f32(i) * 0.785398;\n    let s = im_px(px, vec2<f32>(cos(ang), sin(ang)) * 6.0);\n    bloom = bloom + s.rgb;\n  }\n  let col = c.rgb + bloom / 8.0 * 0.55 * px.color.rgb + px.color.rgb * 0.06 * (0.5 + 0.5 * sin(px.local.y * 1.6));\n  return vec4<f32>(col, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } },
        "image/grain/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let n = im_hash(px.local + vec2<f32>(floor(px.time * 12.0) * 13.0, 0.0)) - 0.5;\n  let warm = mix(c.rgb, c.rgb * px.color.rgb * 1.6, 0.18);\n  let v = 1.0 - 0.35 * length(px.uv - vec2<f32>(0.5, 0.5));\n  return vec4<f32>((warm * v + n * 0.07) * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: true } },
        "image/scanline/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let r = im_px(px, vec2<f32>(1.2, 0.0)).r;\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let b = im_px(px, vec2<f32>(-1.2, 0.0)).b;\n  let scan = 0.82 + 0.18 * sin(px.local.y * 3.14159);\n  let col = vec3<f32>(r, c.g, b) * scan + px.color.rgb * 0.05;\n  return vec4<f32>(col, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } },
        "text/poster/idle": { textColor: "foreground", font: "700 150px display" },
        "text/numeral/idle": { textColor: "primary", font: "700 200px display" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px body" },
        "text/label/idle": { textColor: "foreground", font: "600 13px body" },
        "text/inverse/idle": { on: "pressable/primary/idle", textColor: "primary-foreground", font: "700 14px body" },
        "icon/default/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "primary" },
        "icon/inverse/idle": { on: "pressable/primary/idle", textColor: "primary-foreground" },
        "object/default/idle": { lighting: { ambient: { color: "#ffffff", intensity: 0.55 }, directional: { color: "#ffffff", intensity: 1.6, position: [-4, 6, 8] }, hemisphere: { color: "accent", intensity: 0.4 } } },
        "text/quote/idle": { textColor: "foreground", font: "400 34px display" },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 2, fill: "" },
        "window/frame/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "window/titlebar/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px body" },
        "window/control/idle": { fill: "accent", stroke: "border", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "ticket/body/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [14, 14, 14, 14], kind: "scoop" } },
        "ticket/stub/idle": { fill: "muted", stroke: "border", strokeWidth: 1.5, corners: { radius: [14, 14, 14, 14], kind: "scoop" } },
        "ticket/perforation/idle": { stroke: "border", strokeWidth: 2, strokeDash: [6, 6] },
        "balloon/body/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [18, 18, 18, 18], kind: "round" } },
        "balloon/shout/idle": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "notch" } },
        "ornament/rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = sg_line(p.y - c.y, 1.0);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/double-rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = max(sg_line(p.y - (c.y - 3.5), 1.5), sg_line(p.y - (c.y + 3.5), 0.5));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/frame/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet h = c - vec2<f32>(6.0, 6.0);\nlet a = max(sg_line(sg_box(p - c, h), 1.0), sg_line(sg_box(p - c, h - vec2<f32>(6.0, 6.0)), 0.5));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/corners/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet q = min(p, s - p);\nlet arm = clamp(m * 0.25, 14.0, 48.0);\nlet v = sg_line(q.x - 6.0, 1.0) * (1.0 - smoothstep(arm - 1.0, arm, q.y)) * smoothstep(4.0, 5.0, q.y);\nlet h = sg_line(q.y - 6.0, 1.0) * (1.0 - smoothstep(arm - 1.0, arm, q.x)) * smoothstep(4.0, 5.0, q.x);\nlet a = max(v, h);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/sunburst/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet o = vec2<f32>(c.x, s.y);\nlet d = p - o;\nlet r = length(d);\nlet ang = atan2(d.x, max(-d.y, 0.0001));\nlet rmax = min(s.y, c.x);\nlet w = abs(fract(ang * 5.7296) - 0.5) * 2.0;\nlet ray = (1.0 - smoothstep(0.35, 0.5, w)) * smoothstep(rmax * 0.14, rmax * 0.16, r) * (1.0 - smoothstep(rmax - 1.5, rmax, r));\nlet a = max(ray, sg_fill(r - rmax * 0.09));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/chevron/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet x = abs(p.x - c.x);\nlet v = abs(fract((p.y + x * 0.6) / 20.0) - 0.5) * 20.0;\nlet a = 1.0 - smoothstep(2.3, 3.3, v);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/halftone/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn sg_halftone(p: vec2<f32>, cell: f32, ang: f32, rad: f32) -> f32 { let q = sg_rot(p, ang) / cell; let c = fract(q) - vec2<f32>(0.5, 0.5); return (1.0 - smoothstep(rad - 0.08, rad + 0.08, length(c))) * step(0.03, rad); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = sg_halftone(p, 9.0, 0.7854, (1.0 - px.uv.x) * 0.62);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/stripes/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet v = abs(fract((p.x + p.y) / 14.0) - 0.5) * 14.0;\nlet a = 1.0 - smoothstep(2.8, 3.8, v);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/dots/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet q = fract(p / 16.0) - vec2<f32>(0.5, 0.5);\nlet a = 1.0 - smoothstep(2.4, 3.4, length(q) * 16.0);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/wave/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet k = 6.28318 / 36.0;\nlet amp = clamp(s.y * 0.3, 3.0, 9.0);\nlet y0 = c.y + amp * sin(p.x * k);\nlet slope = amp * k * cos(p.x * k);\nlet a = sg_line((p.y - y0) / sqrt(1.0 + slope * slope), 1.1);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/circle/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = sg_line(length(p - c) - (m * 0.5 - 3.0), 1.2);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/block/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = sg_fill(sg_box(p - c, c - vec2<f32>(0.5, 0.5)));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/star/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_star(p: vec2<f32>, ro: f32, ri: f32) -> f32 { let r = length(p); let u = atan2(p.x, -p.y) * 0.795775; let f = abs(fract(u) - 0.5) * 2.0; return (r - mix(ri, ro, f)) * 0.8; }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = sg_fill(sg_star(p - c, m * 0.48, m * 0.2));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/arch-solid/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet hw = min(c.x * 0.9, s.y * 0.45);\nlet ys = hw + 4.0;\nlet q = vec2<f32>(abs(p.x - c.x), p.y);\nlet d = select(q.x - hw, length(q - vec2<f32>(0.0, ys)) - hw, q.y < ys);\nlet a = (1.0 - smoothstep(-0.7, 0.7, d)) * step(q.y, s.y - 4.0);\nreturn vec4<f32>(px.color.rgb, clamp(a, 0.0, 1.0) * px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/arch/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_arch(q: vec2<f32>, hw: f32, ys: f32) -> f32 { return select(abs(q.x - hw), abs(length(q - vec2<f32>(0.0, ys)) - hw), q.y < ys); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet hw = min(c.x * 0.9, s.y * 0.45);\nlet ys = hw + 4.0;\nlet q = vec2<f32>(abs(p.x - c.x), p.y);\nlet inside = step(q.y, s.y - 4.0);\nlet a = max(sg_line(sg_arch(q, hw, ys), 1.2), sg_line(sg_arch(q, hw - 7.0, ys), 0.6)) * inside;\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/tile/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet cell = 44.0;\nlet q = (fract(p / cell) - vec2<f32>(0.5, 0.5)) * cell;\nlet s1 = max(abs(q.x), abs(q.y)) - cell * 0.27;\nlet r = vec2<f32>(q.x + q.y, q.x - q.y) * 0.70711;\nlet s2 = max(abs(r.x), abs(r.y)) - cell * 0.27;\nlet a = max(sg_line(s1, 0.7), sg_line(s2, 0.7));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/grain/idle": { fill: "foreground", material: { wgsl: "fn sg_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet cell = floor(p / 1.5);\nlet n = sg_hash(cell);\nlet a = step(0.78, n) * (0.25 + 0.5 * sg_hash(cell + vec2<f32>(7.0, 3.0)));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/frieze/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn fr_mark(p: vec2<f32>, h: f32) -> f32 {\nlet per = h * 2.0;\nlet cell = floor(p.x / per);\nlet k = i32(cell) % 4;\nlet lx = p.x - cell * per;\nlet wd = max(1.0, h * 0.09);\nvar a = max(sg_line(p.y, wd), sg_line(p.y - h, wd));\nif (k == 0) {\nlet tri = abs(fract(lx / per * 2.0) - 0.5) * 2.0;\na = max(a, sg_line(p.y - h * (0.28 + 0.44 * tri), wd));\n} else if (k == 1) {\nlet q = min(length(vec2<f32>(lx - per * 0.2, p.y - h * 0.5)), min(length(vec2<f32>(lx - per * 0.5, p.y - h * 0.5)), length(vec2<f32>(lx - per * 0.8, p.y - h * 0.5))));\nlet r = h * 0.14;\na = max(a, 1.0 - smoothstep(r - 0.7, r + 0.7, q));\n} else if (k == 2) {\nlet dx = lx - per * 0.5;\nlet dy = p.y - h * 0.5;\nlet cross = max(sg_line((dy - dx * 0.6) * 0.86, wd), sg_line((dy + dx * 0.6) * 0.86, wd));\na = max(a, cross * step(abs(dx), per * 0.25) * step(abs(dy), h * 0.3));\n} else {\nlet sp = per / 4.0;\nlet d = (fract(lx / sp) - 0.5) * sp;\nlet rung = sg_line(abs(d) - sp * 0.5, wd) * step(abs(p.y - h * 0.5), h * 0.2);\na = max(a, max(rung, max(sg_line(p.y - h * 0.3, wd), sg_line(p.y - h * 0.7, wd))));\n}\nreturn a;\n}\nfn shade(px: Pixel) -> vec4<f32> {\nlet a = fr_mark(px.local, max(px.size.y, 8.0));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/scribble/idle": { fill: "foreground", material: { wgsl: "fn sg_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet w = p + vec2<f32>(sin(p.y * 0.21) * 2.0, sin(p.x * 0.13 + 1.3) * 2.2);\nlet v = abs(fract((w.y + w.x * 0.35) / 9.0) - 0.5) * 9.0;\nlet a = (1.0 - smoothstep(0.6, 1.6, v)) * (0.6 + 0.4 * step(0.2, sg_hash(vec2<f32>(floor(w.x / 14.0), 1.0))));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet a = sg_line(p.y - c.y, 1.0);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
        @label "Base looks"
        @description "Every look a style starts from, in theme palette names (background, card, foreground, primary, border, …) and the theme families (display, body, mono), which the canvas resolves from the program's theme. A style replaces only the looks it names."
        @tier "presentation"
      space : Map string RasmSpaceStep = { phone: { tight: 8, stack: 12, group: 24, scale: 0.45, measure: 0 }, tablet: { tight: 8, stack: 16, group: 28, scale: 0.7, measure: 0 }, desktop: { tight: 8, stack: 16, group: 32, scale: 1, measure: 1160 }, wide: { tight: 8, stack: 20, group: 40, scale: 1, measure: 1240 } }
        @label "Spacing scale"
        @description "The spacing steps by breakpoint name, on the 4/8 grid: tight (inside a group), stack (between the lines of a block), group (between groups), scale (what the style's gutter and sectionGap are multiplied by) and measure (the widest a contained content column runs, 0 for full width). A breakpoint with no entry uses desktop."
        @tier "presentation"
      gutter : number = 24
        @label "Preset gutter"
        @description "The gutter a preset (which has no style layout) announces at scale 1."
        @tier "presentation"
      section : number = 96
        @label "Preset section gap"
        @description "The section spacing a preset announces at scale 1."
        @tier "presentation"
      breakpoints : [RasmBreakpoint] = [{ name: "phone", min: 0 }, { name: "tablet", min: 640 }, { name: "desktop", min: 1024 }, { name: "wide", min: 1440 }]
        @label "Breakpoints"
        @description "The breakpoint table, ascending by min (px): a surface at least `min` wide and narrower than the next entry is in that breakpoint. Announced in RASM_THEME; the surface alone turns its width into a breakpoint, and layout atoms select a variant by the name."
        @tier "presentation"
      breakpointLooks : Map string (Map string RasmLook) = {
        "phone": {
          "text/poster/idle": { textColor: "foreground", font: "700 56px display" },
          "text/numeral/idle": { textColor: "primary", font: "700 72px display" },
          "text/display/idle": { textColor: "foreground", font: "500 36px display" },
          "text/title/idle": { textColor: "foreground", font: "500 28px display" },
          "text/quote/idle": { textColor: "foreground", font: "400 24px display" },
          "text/card/idle": { textColor: "foreground", font: "500 18px display" },
          "text/body/idle": { textColor: "muted-foreground", font: "400 16px body" }
        },
        "tablet": {
          "text/poster/idle": { textColor: "foreground", font: "700 96px display" },
          "text/numeral/idle": { textColor: "primary", font: "700 120px display" },
          "text/display/idle": { textColor: "foreground", font: "500 48px display" },
          "text/title/idle": { textColor: "foreground", font: "500 36px display" },
          "text/quote/idle": { textColor: "foreground", font: "400 28px display" }
        }
      }
        @label "Breakpoint looks"
        @description "The looks that differ below the desktop breakpoint, by breakpoint name then look key, over the style's looks: smaller poster, numeral, display, title, quote and card text. `base` and a style's own looks are the desktop look; a style names its own `breakpointLooks` when its type is extreme. A look listed here replaces only the fields it gives (a font string carries weight and size together, so the weight listed here replaces the style's)."
        @tier "presentation"
      signatures : Map string RasmEntry = {
        "rise": { enterMs: 520, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 18 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "print-pass": { enterMs: 760, keyframes: [{ at: 0, opacity: 0, offsetX: 7, offsetY: -5 }, { at: 0.34, opacity: 0.55, offsetX: 7, offsetY: -5 }, { at: 0.35, opacity: 0.55, offsetX: -4, offsetY: 3 }, { at: 0.68, opacity: 0.85, offsetX: -4, offsetY: 3 }, { at: 0.69, opacity: 1, offsetX: 0, offsetY: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "fan": { enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: -28, offsetY: 28 }, { at: 0.6, opacity: 0.8, offsetX: -4, offsetY: 4 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "glitch": { enterMs: 620, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0 }, { at: 0.12, opacity: 1, offsetX: -14, offsetY: 0 }, { at: 0.22, opacity: 0.35, offsetX: 11, offsetY: 0 }, { at: 0.32, opacity: 1, offsetX: -7, offsetY: 0 }, { at: 0.42, opacity: 0.7, offsetX: 4, offsetY: 0 }, { at: 0.52, opacity: 1, offsetX: 0, offsetY: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "ink-bleed": { enterMs: 1400, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0 }, { at: 0.45, opacity: 0.35, offsetX: 0, offsetY: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "paper-drop": { enterMs: 820, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -64 }, { at: 0.62, opacity: 1, offsetX: 0, offsetY: 8 }, { at: 0.82, opacity: 1, offsetX: 0, offsetY: -3 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "kinetic": { enterMs: 640, keyframes: [{ at: 0, opacity: 0, offsetX: -90, offsetY: 0 }, { at: 0.7, opacity: 1, offsetX: 6, offsetY: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "float": { enterMs: 1600, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 34 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] },
        "snap": { enterMs: 1, keyframes: [{ at: 0, opacity: 1, offsetX: 0, offsetY: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0 }] }
      }
        @label "Motion signatures"
        @description "Each motion signature's entry: its duration in ms and the keyframes an element plays as it enters (0 to 1 of its own window; opacity and offsets in px). RASM_STYLE's motion carries the style's signature's entry, which the entry choreography staggers."
        @tier "presentation"
      styles : Map string RasmStyle = {
        "aqua": {
          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let lum = dot(c, vec3<f32>(0.33, 0.33, 0.33));\n let s = step(2.0, fract(px.local.y / 4.0) * 4.0);\n let dir = select(1.0, -1.0, lum < 0.5);\n c = c + vec3<f32>(0.03, 0.03, 0.035) * s * (-dir);\n c = c + vec3<f32>(0.06, 0.07, 0.09) * (1.0 - smoothstep(0.0, 0.35, px.uv.y)) * dir;\n let gl = exp(-length((px.uv - vec2<f32>(0.5, 0.0)) * vec2<f32>(px.size.x / px.size.y, 1.0)) * 1.8);\n c = c + vec3<f32>(0.1, 0.18, 0.35) * 0.18 * gl;\n let dp = length(px.local - px.pointer);\n c = c + vec3<f32>(0.1, 0.15, 0.25) * 0.05 * exp(-dp / 160.0);\n return vec4<f32>(c, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: true } },
            "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(0,0,0,0.28)", blur: 18 }, spring: { stiffness: 220, damping: 22 } },
            "stack/panel/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, shadow: { color: "rgba(0,0,0,0.18)", blur: 12 }, spring: { stiffness: 220, damping: 22 } },
            "stack/hero/idle": { fill: "card", stroke: "border-hover", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(0,0,0,0.35)", blur: 36 }, spring: { stiffness: 220, damping: 22 } },
            "stack/bar/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.2)", blur: 8 } },
            "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(0,0,0,0.14)", blur: 20, offsetY: 8 }, spring: { stiffness: 220, damping: 22 } },
            "card/surface/hovered": { fill: "card", stroke: "border-hover", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(0,80,180,0.30)", blur: 28, offsetY: 12 }, spring: { stiffness: 220, damping: 22 } },
            "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(0,80,180,0.28)", blur: 16, offsetY: 6 }, spring: { stiffness: 220, damping: 22 } },
