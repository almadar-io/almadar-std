app std-rasm-theme [
  version: "0.1.0",
  description: "std-rasm-theme — the Rasm kit's look tables. Nineteen presets (naqsh, glass, sand, instrument, terminal, paper, taif-day, taif-night, jazari, jazari-night, observatory, print, pulse, astrolabe, prism, prism-ink, dawn, ink-gold, aurora), one table in `presets`, hold every look the kit paints, keyed component/intent/state, including the orbit/*, machine/*, stack/source and text/code keys the state-machine ring and its source card read. RASM_THEME { name, looks } is emitted on INIT, on RASM_THEME_SET { name } and on RASM_THEME_TOGGLE (the other preset of the declared toggleA/toggleB pair, naqsh and glass by default), so every control repaints from the other preset's looks."
]

type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLayout = { hero : "centered" | "split" | "offset" | "full-bleed" | "poster" | "editorial" | "collage"!, columns : number!, asymmetry : number!, ornament : "none" | "rule" | "double-rule" | "frame" | "stamp"!, align : "start" | "center"!, imageTreatment : "none" | "duotone" | "halftone" | "riso" | "engraving" | "glow" | "grain" | "scanline"!, sectionGap : number!, gutter : number! }
type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number! }
type RasmMotion = { signature : "rise" | "print-pass" | "fan" | "glitch" | "ink-bleed" | "paper-drop" | "kinetic" | "float" | "snap"!, stiffness : number!, damping : number!, stagger : number!, enterMs : number, keyframes : [RasmEntryKey] }
type RasmInset = { stroke : string!, strokeWidth : number!, gap : number! }
type RasmLight = { color : string!, intensity : number! }
type RasmKeyLight = { color : string!, intensity : number!, position : [number]! }
type RasmLighting = { ambient : RasmLight!, directional : RasmKeyLight!, hemisphere : RasmLight! }
type RasmLook = { lighting : RasmLighting, inset : RasmInset, fill : string, stroke : string, strokeWidth : number, strokeDash : [number], corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop, on : string, backing : "none" | "halo" | "plate" }
type RasmEntry = { enterMs : number!, keyframes : [RasmEntryKey]! }
type RasmSpaceStep = { tight : number!, stack : number!, group : number!, scale : number!, measure : number! }
type RasmBreakpoint = { name : "phone" | "tablet" | "desktop" | "wide"!, min : number! }
type RasmStyle = { looks : Map string RasmLook!, layout : RasmLayout!, motion : RasmMotion!, breakpointLooks : Map string (Map string RasmLook), palette : "installed" | "inline" }

orbital RasmThemeOrbital {
  entity RasmThemeRun [runtime] {
    id : string!
    active : string @description "The preset whose looks were last announced." = "naqsh"
    isStyle : boolean @description "True when `active` names a style: only a style carries breakpoint looks." = false
    breakpoint : string @description "The breakpoint name the surface last announced, empty before it did: the looks of a style are merged for it." = ""
  }

  trait RasmTheme -> RasmThemeRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (if (!= @config.style "")
          (when (!= (object/get @config.styles @config.style null) null)
            (do
              (set @entity.active @config.style)
              (set @entity.isStyle true)
              (emit THEME_ANNOUNCE { restyle: true })))
          (do
            (set @entity.active @config.preset)
            (set @entity.isStyle false)
            (emit THEME_ANNOUNCE { restyle: true })))
      RASM_BOOT -> ready
        (if (!= @config.style "")
          (when (!= (object/get @config.styles @config.style null) null)
            (do
              (set @entity.active @config.style)
              (set @entity.isStyle true)
              (emit THEME_ANNOUNCE { restyle: true })))
          (do
            (set @entity.active @config.preset)
            (set @entity.isStyle false)
            (emit THEME_ANNOUNCE { restyle: true })))
      RASM_THEME_SET -> ready
        (if (!= (object/get @config.presets ?name null) null)
          (do
            (set @entity.active ?name)
            (set @entity.isStyle false)
            (emit THEME_ANNOUNCE { restyle: true }))
          (when (!= (object/get @config.styles ?name null) null)
            (do
              (set @entity.active ?name)
              (set @entity.isStyle true)
              (emit THEME_ANNOUNCE { restyle: true }))))
      RASM_THEME_TOGGLE -> ready
        (set @entity.active (if (= @entity.active @config.toggleA) @config.toggleB @config.toggleA))
        (set @entity.isStyle false)
        (emit THEME_ANNOUNCE { restyle: false })
      RASM_BREAKPOINT -> ready when (and @entity.isStyle (!= ?name @entity.breakpoint))
        (set @entity.breakpoint ?name)
        (emit THEME_ANNOUNCE { restyle: false })
      RASM_BREAKPOINT -> ready when (not (and @entity.isStyle (!= ?name @entity.breakpoint)))
        (set @entity.breakpoint ?name)
        (emit SPACE_ANNOUNCE)
      THEME_ANNOUNCE -> ready when (not @entity.isStyle)
        (emit RASM_THEME { name: @entity.active, looks: (object/get @config.presets @entity.active {}), breakpoints: @config.breakpoints })
        (emit SPACE_ANNOUNCE)
      THEME_ANNOUNCE -> ready when @entity.isStyle
        (let ((style (object/get @config.styles @entity.active null)))
          (do
            (emit RASM_THEME { name: @entity.active, looks: (array/reduce [(object/get @config.breakpointLooks @entity.breakpoint {}), (object/get (default @style.breakpointLooks {}) @entity.breakpoint {})] (object/merge @config.base @style.looks) (fn acc layer (array/reduce (object/keys @layer) @acc (fn a k (object/set @a @k (object/merge (object/get @a @k {}) (object/get @layer @k {}))))))), breakpoints: @config.breakpoints })
            (when ?restyle
              (emit RASM_STYLE { name: @entity.active, layout: @style.layout, motion: (let ((s (object/get @config.signatures @style.motion.signature null))) (if (= @s null) @style.motion (object/merge @style.motion { enterMs: @s.enterMs, keyframes: @s.keyframes }))) }))
            (emit SPACE_ANNOUNCE)))
      SPACE_ANNOUNCE -> ready
        (let ((step : RasmSpaceStep? (object/get @config.space (if (= @entity.breakpoint "") "desktop" @entity.breakpoint) (object/get @config.space "desktop" null)))
              (style (if @entity.isStyle (object/get @config.styles @entity.active null) null)))
          (when (!= @step null)
            (emit RASM_SPACE { space: { tight: @step.tight, stack: @step.stack, group: @step.group, gutter: (math/round (* @step.scale (if (= @style null) @config.gutter @style.layout.gutter))), section: (math/round (* @step.scale (if (= @style null) @config.section @style.layout.sectionGap))), measure: @step.measure } })))
    }

    emits {
      THEME_ANNOUNCE -> internal {
        restyle : boolean!
      }
        @description "Announce the active preset or style: its looks (and, when restyle is on, a style layout and motion)."
        @tier "internal"
      SPACE_ANNOUNCE -> internal
        @description "Announce the spacing scale for the current breakpoint."
        @tier "internal"
      RASM_SPACE -> external {
        space : Map string number!
      }
        @description "The spacing scale for the current breakpoint, in px: tight, stack and group from the space table, gutter and section the active style's gutter and sectionGap (a preset's the gutter and section knobs) times the breakpoint's scale, and measure, the widest a contained content column runs (0 for none). Announced with every look announcement and on every breakpoint; layout atoms take their gaps and padding from it by step name."
        @tier "primary"
      RASM_THEME -> external {
        name : string!
        looks : Map string RasmLook!
        breakpoints : [RasmBreakpoint]!
      }
        @description "The announced preset and its look table, with the breakpoint table every layout atom selects by. For a style the looks are merged lowest first: `base`, the style looks, `breakpointLooks[<current breakpoint>]` of the theme, then the style own `breakpointLooks[<current breakpoint>]` (a later layer wins per look key and per field of a look; a breakpoint with no entry adds no layer). A preset carries no breakpoint looks. It is announced again when the surface announces another breakpoint."
        @tier "primary"
      RASM_STYLE -> external {
        name : string!
        layout : RasmLayout!
        motion : RasmMotion!
      }
        @description "A style was announced: its layout grammar (hero arrangement, columns, ornament, image treatment, rhythm) and motion signature, for the landing and the motion atoms."
        @tier "primary"
    }

    listens {
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "The surface entered a breakpoint: when a style is active its looks are announced again for it."
      RASM_BOOT { }
        @description "The surface mounted: announce the configured preset."
      RASM_THEME_TOGGLE { }
        @description "Switch to the other preset and announce its looks."
        @synonyms "flip theme"
      RASM_THEME_SET { name : string! }
        @description "Switch to the named preset (any name in `presets`) and announce its looks; an unknown name announces nothing."
        @synonyms "switch theme, toggle preset"
    }

    config {
      preset : "naqsh" | "glass" | "sand" | "instrument" | "terminal" | "paper" | "taif-day" | "taif-night" | "jazari" | "jazari-night" | "observatory" | "print" | "pulse" | "astrolabe" | "prism" | "prism-ink" | "dawn" | "ink-gold" | "aurora" = "naqsh"
        @label "Preset"
        @description "The preset announced on INIT."
        @tier "presentation"
      toggleA : "naqsh" | "glass" | "sand" | "instrument" | "terminal" | "paper" | "taif-day" | "taif-night" | "jazari" | "jazari-night" | "observatory" | "print" | "pulse" | "astrolabe" | "prism" | "prism-ink" | "dawn" | "ink-gold" | "aurora" = "naqsh"
        @label "Toggle from"
        @description "One preset of the pair RASM_THEME_TOGGLE alternates."
        @tier "presentation"
      style : string = ""
        @label "Style"
        @description "A theme style announced on INIT instead of the preset: a key of `styles`, named after the theme base whose palette and fonts the canvas draws it in (gazette, risograph, art-deco, …). Empty announces the preset."
        @tier "presentation"
      base : Map string RasmLook = {
        "text/card/idle": { textColor: "card-foreground", font: "500 21px display", on: "card/surface/idle" },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "choice/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "ring", strokeWidth: 2 },
        "choice/default/hovered": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "input", strokeWidth: 1.2 },
        "choice/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "input", strokeWidth: 1.2 },
        "choice/default/label": { textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "choice/default/open": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "input", strokeWidth: 2 },
        "choice/option/active": { fill: "primary", textColor: "primary-foreground", font: "500 15px body", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "choice/option/idle": { fill: "card", textColor: "foreground", font: "500 15px body", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "choice/popup/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "drag/default/dragging": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "drag/default/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "machine/badge/idle": { fill: "card", stroke: "border", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 13px body" },
        "machine/bloom/idle": { stroke: "border", strokeWidth: 2 },
        "machine/effect/other": { fill: "card", stroke: "border", strokeWidth: 1.2 },
        "machine/event/idle": { textColor: "foreground", font: "600 13px mono" },
        "machine/event/lit": { textColor: "primary", font: "600 13px mono" },
        "machine/guard/idle": { fill: "card", stroke: "border", strokeWidth: 1.2 },
        "machine/guard/refused": { fill: "card", stroke: "border", strokeWidth: 1.2 },
        "machine/pill/hovered": { fill: "card" },
        "machine/pill/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "machine/pill/lit": { fill: "primary", stroke: "primary", strokeWidth: 1.6, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "machine/pill/next": { fill: "card", stroke: "primary", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "machine/state/active": { fill: "primary", stroke: "border", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "700 16px body" },
        "machine/state/idle": { fill: "card", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 16px body" },
        "machine/state/visited": { fill: "card", stroke: "border", strokeWidth: 1.6, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 16px body" },
        "machine/token/idle": { fill: "card", stroke: "border", strokeWidth: 1 },
        "machine/wire/idle": { stroke: "border", strokeWidth: 1.5 },
        "machine/wire/lit": { stroke: "primary", strokeWidth: 3 },
        "machine/wire/next": { stroke: "primary", strokeWidth: 1.6 },
        "mirror/primary/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "orbit/arc/lit": { stroke: "primary", strokeWidth: 4 },
        "orbit/beat/idle": { fill: "card", stroke: "border", strokeWidth: 2 },
        "orbit/core/idle": { fill: "card", stroke: "border", strokeWidth: 1 },
        "orbit/label/active": { textColor: "primary", font: "700 18px body" },
        "orbit/label/idle": { textColor: "muted-foreground", font: "500 15px body" },
        "orbit/ring/idle": { stroke: "border", strokeWidth: 2 },
        "orbit/station/active": { fill: "primary", stroke: "border", strokeWidth: 2, spring: { stiffness: 140, damping: 22 } },
        "orbit/station/focused": { fill: "card", stroke: "ring", strokeWidth: 2.5, spring: { stiffness: 140, damping: 22 } },
        "orbit/station/hovered": { fill: "card", stroke: "border", strokeWidth: 1.5, spring: { stiffness: 140, damping: 22 } },
        "orbit/station/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, spring: { stiffness: 140, damping: 22 } },
        "overlay/dialog/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "overlay/scrim/idle": { fill: "rgba(0,0,0,0.55)", spring: { stiffness: 140, damping: 22 } },
        "particles/primary/idle": { fill: "accent" },
        "pressable/primary/disabled": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/primary/focused": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "ring", strokeWidth: 2 },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "border", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/primary/pressed": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/secondary/disabled": { fill: "secondary", stroke: "input", strokeWidth: 1, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/secondary/focused": { fill: "secondary", textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "ring", strokeWidth: 2 },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "border", strokeWidth: 2, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/secondary/idle": { fill: "secondary", stroke: "input", strokeWidth: 1, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "pressable/secondary/pressed": { fill: "secondary", stroke: "input", strokeWidth: 1, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "range/default/fill": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "range/default/thumb-dragging": { fill: "primary", stroke: "input", strokeWidth: 1.2, spring: { stiffness: 140, damping: 22 } },
        "range/default/thumb-focused": { fill: "muted", stroke: "ring", strokeWidth: 2, spring: { stiffness: 140, damping: 22 } },
        "range/default/thumb-hovered": { fill: "muted", stroke: "input", strokeWidth: 1.2, spring: { stiffness: 140, damping: 22 } },
        "range/default/thumb-idle": { fill: "muted", stroke: "input", strokeWidth: 1.2, spring: { stiffness: 140, damping: 22 } },
        "range/default/track": { fill: "muted", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "scroll/default/body": { fill: "muted", strokeWidth: 0, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "scroll/default/thumb": { fill: "muted", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "scroll/default/thumb-dragging": { fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "scroll/default/track": { fill: "muted", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "stack/hero/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "stack/source/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "surface/ground/idle": { fill: "background" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 17px body", spring: { stiffness: 140, damping: 22 } },
        "text/code-comment/idle": { textColor: "muted-foreground" },
        "text/code-function/idle": { textColor: "muted-foreground" },
        "text/code-keyword/idle": { textColor: "muted-foreground" },
        "text/code-number/idle": { textColor: "muted-foreground" },
        "text/code-operator/idle": { textColor: "muted-foreground" },
        "text/code-punctuation/idle": { textColor: "muted-foreground" },
        "text/code-string/idle": { textColor: "muted-foreground" },
        "text/code-type/idle": { textColor: "muted-foreground" },
        "text/code-variable/idle": { textColor: "muted-foreground" },
        "text/code/active": { textColor: "foreground", font: "700 14px mono", fill: "muted" },
        "text/code/idle": { textColor: "foreground", font: "400 14px mono" },
        "text/title/idle": { textColor: "foreground", font: "300 44px display", spring: { stiffness: 140, damping: 22 } },
        "textfield/default/caret": { fill: "primary", spring: { stiffness: 140, damping: 22 } },
        "textfield/default/disabled": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "muted-foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "input", strokeWidth: 0 },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "ring", strokeWidth: 2 },
        "textfield/default/hovered": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "input", strokeWidth: 1.2 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 }, stroke: "input", strokeWidth: 1.2 },
        "textfield/default/label": { textColor: "foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "500 15px body", spring: { stiffness: 140, damping: 22 } },
        "textfield/default/selection": { fill: "primary", spring: { stiffness: 140, damping: 22 } },
        "toggle/check/off-focused": { on: "surface/ground/idle", fill: "muted", stroke: "ring", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/on-focused": { on: "surface/ground/idle", fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body", stroke: "ring", strokeWidth: 2 },
        "toggle/check/on-hovered": { on: "surface/ground/idle", fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/on-idle": { on: "surface/ground/idle", fill: "primary", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-focused": { on: "surface/ground/idle", fill: "muted", stroke: "ring", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
