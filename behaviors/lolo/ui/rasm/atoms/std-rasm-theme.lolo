          "stack/panel/idle": { fill: "rgba(40,22,42,0.9)", stroke: "rgba(212,175,106,0.30)", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, spring: { stiffness: 200, damping: 18 } },
          "stack/source/idle": { fill: "rgba(18,9,20,0.96)", stroke: "rgba(244,234,216,0.55)", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" } },
          "surface/ground/idle": { fill: "#1c0f1e", material: { wgsl: "fn so_band(x: f32, w: f32) -> f32 {\n  let f = fract(x) - 0.5;\n  return exp(-(f * f) / (w * w));\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let sz = max(px.size, vec2<f32>(1.0, 1.0));\n  var col = vec3<f32>(0.1098, 0.0588, 0.1176);\n  let s = px.local.x * 0.8 + px.local.y * 0.6;\n  let sc = px.scroll * 0.2;\n  let p1 = s / 1100.0 - px.time / 16.0 - sc / 1100.0;\n  let p2 = s / 1700.0 + px.time / 22.0 - sc / 1700.0 + 0.37;\n  let p3 = s / 800.0 - px.time / 13.0 - sc / 800.0 + 0.71;\n  let sweep = so_band(p1, 0.10) * 0.8 + so_band(p2, 0.14) * 0.6 + so_band(p3, 0.06) * 0.4;\n  col = mix(col, vec3<f32>(1.0, 0.93, 0.86), clamp(sweep * 0.04, 0.0, 0.05));\n  let c = (px.local / sz) - vec2<f32>(0.5, 0.5);\n  let vig = smoothstep(0.35, 0.85, length(c));\n  col = col * (1.0 - 0.3 * vig);\n  let dp = length(px.local - px.pointer);\n  let glow = 1.0 - smoothstep(0.0, 220.0, dp);\n  col = mix(col, vec3<f32>(0.83, 0.69, 0.42), glow * glow * 0.05);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
