        "vaporwave": {
          looks: {
            "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let hz = 0.62;\n let uv = px.uv;\n let asp = px.size.x / px.size.y;\n let p = vec2<f32>((uv.x - 0.5) * asp, uv.y - 0.42);\n let d = length(p);\n let sun = 1.0 - smoothstep(0.15, 0.153, d);\n let cut = select(1.0, step(0.35, fract(p.y * 30.0 - px.time * 0.05)), p.y > 0.02);\n let scol = mix(vec3<f32>(1.0, 0.85, 0.3), vec3<f32>(1.0, 0.24, 0.8), clamp((p.y + 0.15) / 0.3, 0.0, 1.0));\n c = mix(c, scol, sun * cut * 0.3);\n c = c + vec3<f32>(1.0, 0.24, 0.8) * 0.06 * exp(-d * 5.0);\n if (uv.y > hz) {\n  let dy = uv.y - hz;\n  let z = 0.1 / dy;\n  let gx = abs(fract((uv.x - 0.5 + (px.pointer.x / px.size.x - 0.5) * 0.1) * asp * z * 1.5 + 0.5) - 0.5);\n  let gz = abs(fract(z * 0.8 - px.time * 0.12 + px.scroll) - 0.5);\n  let w = 0.03 * z;\n  let l = max(1.0 - smoothstep(0.0, w, gx), 1.0 - smoothstep(0.0, 0.05, gz));\n  c = mix(c, vec3<f32>(0.0, 0.94, 1.0), l * 0.2 * smoothstep(0.0, 0.2, dy));\n }\n c = c + vec3<f32>(0.4, 0.1, 0.5) * 0.08 * smoothstep(0.45, hz, uv.y) * (1.0 - step(hz, uv.y));\n return vec4<f32>(c, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: false } },
