            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet r = 22.0;\nlet rowH = r * 0.5;\nlet row = floor(p.y / rowH);\nlet xo = (row - 2.0 * floor(row * 0.5)) * r * 0.5;\nlet lx = (fract((p.x + xo) / r) - 0.5) * r;\nlet ly = p.y - (row + 1.0) * rowH;\nlet d = length(vec2<f32>(lx, ly));\nlet arcs = max(sg_line(d - rowH + 0.5, 0.7), max(sg_line(d - rowH * 0.7, 0.7), sg_line(d - rowH * 0.4, 0.7)));\nreturn sg_out(px, px.color.rgb, arcs * step(ly, 0.0));\n}\n", params: [0, 0, 0, 0], live: false } }
