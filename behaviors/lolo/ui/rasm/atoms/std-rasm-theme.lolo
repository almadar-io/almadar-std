          "textfield/default/selection": { fill: "rgba(200,106,126,0.35)", spring: { stiffness: 150, damping: 20 } },
          "textfield/default/caret": { fill: "#7a2f56", spring: { stiffness: 150, damping: 20 } },
          "choice/popup/idle": { fill: "rgba(255,246,236,0.96)", backdrop: { blur: 16, tint: "rgba(255,240,220,0.18)", saturate: 1.1 }, stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(42,30,51,0.32)", blur: 28 }, spring: { stiffness: 150, damping: 20 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", textColor: "#2a1e33", font: "400 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 150, damping: 20 } },
          "choice/option/active": { fill: "rgba(200,106,126,0.2)", textColor: "#2a1e33", font: "400 15px sans-serif", corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 150, damping: 20 } },
          "stack/hero/idle": { fill: "rgba(255,246,236,0.9)", backdrop: { blur: 16, tint: "rgba(255,240,220,0.18)", saturate: 1.1 }, stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(42,30,51,0.28)", blur: 40 }, material: { wgsl: "// warm cream glass with a gold inlay line inside its edge; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = mix(px.color.rgb, vec3<f32>(0.99, 0.92, 0.84), px.uv.y * 0.35);\n  let inlay = 1.0 - smoothstep(0.3, 1.0, abs(px.sdf + 5.0));\n  col = mix(col, vec3<f32>(0.902, 0.761, 0.478), inlay * (0.5 + 0.3 * px.a.z));\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.85, 0.6) * exp(-d * d / 30000.0) * 0.05;\n  return vec4<f32>(col, max(px.color.a, inlay * 0.5));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 150, damping: 20 } },
          "overlay/scrim/idle": { fill: "rgba(28,31,74,0.5)", backdrop: { blur: 8, tint: "rgba(28,31,74,0.15)", saturate: 1.1 }, spring: { stiffness: 150, damping: 20 } },
          "overlay/dialog/idle": { fill: "rgba(255,246,236,0.96)", backdrop: { blur: 20, tint: "rgba(255,240,220,0.18)", saturate: 1.1 }, stroke: "#e6c27a", strokeWidth: 1.2, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(42,30,51,0.4)", blur: 56 }, material: { wgsl: "// warm cream glass with a gold inlay line inside its edge; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = mix(px.color.rgb, vec3<f32>(0.99, 0.92, 0.84), px.uv.y * 0.35);\n  let inlay = 1.0 - smoothstep(0.3, 1.0, abs(px.sdf + 5.0));\n  col = mix(col, vec3<f32>(0.902, 0.761, 0.478), inlay * (0.5 + 0.3 * px.a.z));\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.85, 0.6) * exp(-d * d / 30000.0) * 0.05;\n  return vec4<f32>(col, max(px.color.a, inlay * 0.5));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 150, damping: 20 } },
          "scroll/default/body": { fill: "rgba(0,0,0,0)", strokeWidth: 0, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 150, damping: 20 } },
