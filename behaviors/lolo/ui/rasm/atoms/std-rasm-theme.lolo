            "text/title/idle": { textColor: "foreground", font: "500 40px display", spring: { stiffness: 260, damping: 24 } },
            "text/eyebrow/idle": { textColor: "primary", font: "600 13px body", spring: { stiffness: 260, damping: 24 } },
            "text/body/idle": { textColor: "muted-foreground", font: "400 18px body", spring: { stiffness: 260, damping: 24 } },
            "text/card/idle": { textColor: "card-foreground", font: "500 22px display" },
            "morph/default/idle": { fill: "accent" },
            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet cc = vec2<f32>(c.x, c.y - m * 0.03);\nlet r = m * 0.28;\nlet sh = (1.0 - smoothstep(-r * 0.1, r * 0.35, length(p - cc - vec2<f32>(0.0, r * 0.18)) - r)) * 0.3;\nlet body = sg_fill(length(p - cc) - r);\nlet ripple = sg_line(length(p - cc) - r * 0.62, 1.0) * 0.35;\nlet pl = max(sg_line(sg_seg(p, cc - vec2<f32>(r * 0.35, 0.0), cc + vec2<f32>(r * 0.35, 0.0)), 1.6), sg_line(sg_seg(p, cc - vec2<f32>(0.0, r * 0.35), cc + vec2<f32>(0.0, r * 0.35)), 1.6));\nvar col = mix(vec3<f32>(0.0, 0.0, 0.0), px.color.rgb, body);\ncol = mix(col, vec3<f32>(1.0, 1.0, 1.0), max(pl, ripple));\nreturn sg_out(px, col, max(max(body, sh), pl));\n}\n", params: [0, 0, 0, 0], live: false } }
          },
          layout: { hero: "full-bleed", columns: 12, asymmetry: 0.15, ornament: "none", align: "start", imageTreatment: "duotone", sectionGap: 96, gutter: 32 },
          motion: { signature: "snap", stiffness: 260, damping: 24, stagger: 40 }
