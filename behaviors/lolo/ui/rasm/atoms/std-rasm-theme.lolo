          "range/default/thumb-focused": { fill: "#ffffff", stroke: "#9a5220", strokeWidth: 1, shadow: { color: "rgba(40,22,8,0.45)", blur: 10 }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 }, decor: "dune-crest" },
          "textfield/default/idle": { fill: "rgba(227,184,120,0.12)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/hovered": { fill: "rgba(227,184,120,0.22)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/focused": { fill: "rgba(227,184,120,0.12)", stroke: "#ffe2a6", strokeWidth: 2.4, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/disabled": { fill: "rgba(227,184,120,0.05)", strokeWidth: 0, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "choice/default/idle": { fill: "rgba(227,184,120,0.12)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "choice/default/hovered": { fill: "rgba(227,184,120,0.22)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "choice/default/focused": { fill: "rgba(227,184,120,0.12)", stroke: "#ffe2a6", strokeWidth: 2.4, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "choice/default/open": { fill: "rgba(227,184,120,0.22)", stroke: "#ffe2a6", strokeWidth: 2.4, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/label": { textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "choice/default/label": { textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/placeholder": { textColor: "rgba(255,241,214,0.45)", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/selection": { fill: "rgba(255,206,130,0.42)", spring: { stiffness: 120, damping: 14 } },
          "textfield/default/caret": { fill: "#ffe2a6", spring: { stiffness: 120, damping: 14 } },
          "choice/popup/idle": { fill: "rgba(76,50,28,0.97)", stroke: "#e3b878", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(40,22,8,0.55)", blur: 26 }, spring: { stiffness: 120, damping: 14 } },
          "choice/option/idle": { fill: "rgba(0,0,0,0)", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fff1d6", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "choice/option/active": { fill: "#b8662a", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fff6e4", font: "400 15px sans-serif", spring: { stiffness: 120, damping: 14 } },
          "stack/hero/idle": { fill: "rgba(88,60,34,0.88)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [30, 30, 30, 30], kind: "round" }, shadow: { color: "rgba(40,22,8,0.5)", blur: 34 }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, spring: { stiffness: 120, damping: 14 }, decor: "dune-ripple" },
          "overlay/scrim/idle": { fill: "rgba(40,22,8,0.55)", spring: { stiffness: 120, damping: 14 } },
          "overlay/dialog/idle": { fill: "rgba(76,50,28,0.97)", stroke: "#e3b878", strokeWidth: 1.2, corners: { radius: [30, 30, 30, 30], kind: "round" }, shadow: { color: "rgba(40,22,8,0.5)", blur: 50 }, material: { wgsl: "fn sd_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn sd_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(sd_hash(i), sd_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(sd_hash(i + vec2<f32>(0.0, 1.0)), sd_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let wind = vec2<f32>(px.time * 6.0, px.time * 2.0);\n  let size = max(px.a.w, 1.0);\n  let grain = sd_noise((px.local + wind) / size) * 0.6 + sd_hash(floor(px.local / size)) * 0.4;\n  var col = px.color.rgb * (0.88 + 0.2 * grain);\n  let drift = sin(px.local.x * 0.03 - px.time * 1.2 + px.local.y * 0.01) * 0.5 + 0.5;\n  col = col + vec3<f32>(0.10, 0.07, 0.03) * drift * (0.4 + px.a.x);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.8, 0.5) * exp(-d * d / (2.0 * 70.0 * 70.0)) * (0.05 + 0.2 * px.a.x);\n  let rim = smoothstep(-2.5, 0.0, px.sdf) * (0.25 + 0.3 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.98, 0.86, 0.62), rim);\n  let kick = exp(-d * 0.02) * px.a.y * 0.14 * (0.5 + 0.5 * sin(d * 0.05 - px.time * 6.0));\n  col = col - vec3<f32>(kick);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 2.5], live: true }, spring: { stiffness: 120, damping: 14 }, decor: "dune-ripple" },
          "scroll/default/body": { fill: "rgba(0,0,0,0)", strokeWidth: 0, corners: { radius: [14, 14, 14, 14], kind: "round" }, spring: { stiffness: 120, damping: 14 } },
