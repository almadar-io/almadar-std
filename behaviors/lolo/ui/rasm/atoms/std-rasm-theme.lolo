        "festival": {
          "surface/ground/idle": { fill: "#0d0a1f", material: { wgsl: "fn fe_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = vec3<f32>(0.051, 0.039, 0.122);\n  let off = vec2<f32>(px.time * 5.0, px.time * 3.0 + px.scroll * 0.25);\n  let p = px.local + off;\n  let cell = floor(p / 160.0);\n  for (var j: i32 = -1; j <= 1; j = j + 1) {\n    for (var i: i32 = -1; i <= 1; i = i + 1) {\n      let c = cell + vec2<f32>(f32(i), f32(j));\n      let h = fe_hash(c);\n      if (h < 0.4) {\n        let ctr = (c + vec2<f32>(0.2 + 0.6 * fe_hash(c + vec2<f32>(3.1, 7.7)), 0.2 + 0.6 * fe_hash(c + vec2<f32>(9.3, 1.9)))) * 160.0 - off;\n        let swell = 1.0 + 0.25 * (1.0 - smoothstep(0.0, 200.0, length(ctr - px.pointer)));\n        let r = (10.0 + 26.0 * fe_hash(c + vec2<f32>(5.5, 2.2))) * swell;\n        let d = length(px.local - ctr);\n        let a = (1.0 - smoothstep(r * 0.6, r, d)) * 0.07;\n        let k = fe_hash(c + vec2<f32>(8.8, 4.4));\n        var tint = vec3<f32>(1.0, 0.77, 0.47);\n        if (k > 0.33) { tint = vec3<f32>(1.0, 0.4, 0.62); }\n        if (k > 0.66) { tint = vec3<f32>(0.62, 0.45, 1.0); }\n        col = mix(col, tint, a);\n      }\n    }\n  }\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "stack/panel/idle": { fill: "rgba(24,18,48,0.9)", stroke: "rgba(255,196,120,0.20)", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" }, spring: { stiffness: 220, damping: 14 } },
