        "choice/option/idle": { fill: "rgba(0,0,0,0)", corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#5dff95", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } },
        "choice/option/active": { fill: "#14753a", corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "#e0ffe9", font: "400 14px monospace", spring: { stiffness: 900, damping: 70 } }
      }
        @label "Terminal looks"
        @description "Phosphor on black, scanline and flicker, monospace, stepped motion. Every look keyed component/intent/state."
        @tier "presentation"
      paper : Map string RasmLook = {
        "surface/ground/idle": { fill: "#ece6d8", material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// handmade paper: long fibres, mottled tooth, a soft vignette, a lamp that follows the pointer\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = mix(vec3<f32>(0.95, 0.92, 0.85), vec3<f32>(0.90, 0.86, 0.78), px.uv.y);\n  let f1 = pp_noise(vec2<f32>(px.local.x * 0.9, px.local.y * 0.05) + vec2<f32>(11.0, 3.0));\n  let f2 = pp_noise(vec2<f32>(px.local.x * 0.04, px.local.y * 0.8) + vec2<f32>(5.0, 17.0));\n  col = col - vec3<f32>(0.05, 0.05, 0.06) * smoothstep(0.62, 0.9, f1) * 0.7;\n  col = col - vec3<f32>(0.04, 0.045, 0.05) * smoothstep(0.65, 0.9, f2) * 0.7;\n  let tooth = pp_noise(px.local / 2.2);\n  col = col * (0.96 + 0.06 * tooth);\n  let mottle = pp_noise(px.local / 90.0 + vec2<f32>(px.time * 0.01, 0.0));\n  col = col - vec3<f32>(0.04, 0.045, 0.05) * mottle;\n  let v = px.uv - vec2<f32>(0.5, 0.5);\n  col = col * (1.0 - dot(v, v) * 0.22);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.06, 0.05, 0.02) * exp(-d * d / (2.0 * 220.0 * 220.0));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 70, damping: 16 } },
        "stack/panel/idle": { fill: "rgba(250,246,236,0.96)", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(60,45,30,0.28)", blur: 30 }, material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w fibre scale in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = max(px.a.w, 1.0);\n  let fib = pp_noise(vec2<f32>(px.local.x / (s * 6.0), px.local.y / (s * 0.4)));\n  let tooth = pp_noise(px.local / s);\n  var col = px.color.rgb * (0.96 + 0.05 * tooth) - vec3<f32>(0.03) * smoothstep(0.65, 0.9, fib);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.05, 0.04, 0.02) * exp(-d * d / (2.0 * 80.0 * 80.0)) * (0.4 + px.a.x);\n  let ink = smoothstep(-1.4, 0.0, px.sdf) * (0.35 + 0.35 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.14, 0.12, 0.16), ink);\n  let bleed = smoothstep(-6.0, -1.4, px.sdf) * (1.0 - smoothstep(-1.4, 0.0, px.sdf)) * 0.06 * (0.6 + 0.4 * pp_noise(px.local / 3.0));\n  col = col - vec3<f32>(bleed);\n  col = col * (1.0 - 0.07 * px.a.y);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 4], live: true }, spring: { stiffness: 70, damping: 16 }, decor: "deckle-edge" },
        "text/title/idle": { textColor: "#1f1a26", font: "600 28px serif", spring: { stiffness: 70, damping: 16 } },
        "text/body/idle": { textColor: "rgba(31,26,38,0.82)", font: "400 15px serif", spring: { stiffness: 70, damping: 16 } },
        "pressable/primary/idle": { fill: "#2a2433", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [5, 5, 5, 5], kind: "round" }, material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w fibre scale in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = max(px.a.w, 1.0);\n  let fib = pp_noise(vec2<f32>(px.local.x / (s * 6.0), px.local.y / (s * 0.4)));\n  let tooth = pp_noise(px.local / s);\n  var col = px.color.rgb * (0.96 + 0.05 * tooth) - vec3<f32>(0.03) * smoothstep(0.65, 0.9, fib);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.05, 0.04, 0.02) * exp(-d * d / (2.0 * 80.0 * 80.0)) * (0.4 + px.a.x);\n  let ink = smoothstep(-1.4, 0.0, px.sdf) * (0.35 + 0.35 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.14, 0.12, 0.16), ink);\n  let bleed = smoothstep(-6.0, -1.4, px.sdf) * (1.0 - smoothstep(-1.4, 0.0, px.sdf)) * 0.06 * (0.6 + 0.4 * pp_noise(px.local / 3.0));\n  col = col - vec3<f32>(bleed);\n  col = col * (1.0 - 0.07 * px.a.y);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 4], live: true }, textColor: "#fbf7ec", font: "600 15px serif", spring: { stiffness: 70, damping: 16 } },
        "pressable/primary/hovered": { fill: "#3c3448", stroke: "#2a2433", strokeWidth: 1.4, corners: { radius: [5, 5, 5, 5], kind: "round" }, shadow: { color: "rgba(60,45,30,0.3)", blur: 12 }, material: { wgsl: "fn pp_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn pp_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(pp_hash(i), pp_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(pp_hash(i + vec2<f32>(0.0, 1.0)), pp_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w fibre scale in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = max(px.a.w, 1.0);\n  let fib = pp_noise(vec2<f32>(px.local.x / (s * 6.0), px.local.y / (s * 0.4)));\n  let tooth = pp_noise(px.local / s);\n  var col = px.color.rgb * (0.96 + 0.05 * tooth) - vec3<f32>(0.03) * smoothstep(0.65, 0.9, fib);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.05, 0.04, 0.02) * exp(-d * d / (2.0 * 80.0 * 80.0)) * (0.4 + px.a.x);\n  let ink = smoothstep(-1.4, 0.0, px.sdf) * (0.35 + 0.35 * px.a.x + 0.3 * px.a.z);\n  col = mix(col, vec3<f32>(0.14, 0.12, 0.16), ink);\n  let bleed = smoothstep(-6.0, -1.4, px.sdf) * (1.0 - smoothstep(-1.4, 0.0, px.sdf)) * 0.06 * (0.6 + 0.4 * pp_noise(px.local / 3.0));\n  col = col - vec3<f32>(bleed);\n  col = col * (1.0 - 0.07 * px.a.y);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 4], live: true }, textColor: "#fbf7ec", font: "600 15px serif", spring: { stiffness: 70, damping: 16 } },
