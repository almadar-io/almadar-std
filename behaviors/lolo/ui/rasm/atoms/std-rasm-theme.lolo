app std-rasm-theme [
  version: "0.1.0",
  description: "std-rasm-theme — the Rasm kit's look tables. Two presets (naqsh, glass) hold every look the kit paints, keyed component/intent/state. RASM_THEME { name, looks } is emitted on INIT, on RASM_THEME_SET { name } and on RASM_THEME_TOGGLE (the other preset), so every control repaints from the other preset's looks."
]

type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number! }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }

orbital RasmThemeOrbital {
  entity RasmThemeRun [runtime] {
    id : string!
    active : string @description "The preset whose looks were last announced." = "naqsh"
  }

  trait RasmTheme -> RasmThemeRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.active @config.preset)
        (emit RASM_THEME { name: @config.preset, looks: (if (= @config.preset "glass") @config.glass @config.naqsh) })
      RASM_BOOT -> ready
        (set @entity.active @config.preset)
        (emit RASM_THEME { name: @config.preset, looks: (if (= @config.preset "glass") @config.glass @config.naqsh) })
      RASM_THEME_SET -> ready when (or (= ?name "naqsh") (= ?name "glass"))
        (set @entity.active ?name)
        (emit RASM_THEME { name: ?name, looks: (if (= ?name "glass") @config.glass @config.naqsh) })
      RASM_THEME_TOGGLE -> ready
        (set @entity.active (if (= @entity.active "naqsh") "glass" "naqsh"))
        (emit RASM_THEME { name: @entity.active, looks: (if (= @entity.active "glass") @config.glass @config.naqsh) })
      RASM_THEME_SET -> ready when (not (or (= ?name "naqsh") (= ?name "glass")))
    }

    emits {
      RASM_THEME -> external {
        name : string!
        looks : Map string RasmLook!
      }
        @description "The announced preset and its look table."
        @tier "primary"
    }

    listens {
      RASM_BOOT { }
        @description "The surface mounted: announce the configured preset."
      RASM_THEME_TOGGLE { }
        @description "Switch to the other preset and announce its looks."
        @synonyms "flip theme"
      RASM_THEME_SET { name : string! }
        @description "Switch to the named preset (naqsh or glass) and announce its looks."
        @synonyms "switch theme, toggle preset"
    }

    config {
      preset : "naqsh" | "glass" = "naqsh"
        @label "Preset"
        @description "The preset announced on INIT."
        @tier "presentation"
      naqsh : Map string RasmLook = {
        "surface/ground/idle": { fill: "#0d0f1e", material: { wgsl: "// an eight-point star lattice that breathes, gathering gold under the pointer\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 64.0;\n  let cell = fract(p) - vec2<f32>(0.5, 0.5);\n  let ang = atan2(cell.y, cell.x);\n  let r = length(cell);\n  let star = abs(cos(ang * 4.0)) * 0.12 + 0.18;\n  let line = 1.0 - smoothstep(0.0, 0.02, abs(r - star));\n  let pulse = 0.5 + 0.5 * sin(px.time * 0.6 + dot(floor(p), vec2<f32>(1.7, 2.3)));\n  var col = mix(vec3<f32>(0.05, 0.06, 0.12), vec3<f32>(0.09, 0.08, 0.16), px.uv.y);\n  col = col + vec3<f32>(0.85, 0.66, 0.32) * line * (0.10 + 0.12 * pulse);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.9, 0.7, 0.35) * line * exp(-d * d / (2.0 * 160.0 * 160.0)) * 0.5;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 170, damping: 20 } },
        "stack/panel/idle": { fill: "rgba(28,24,40,0.92)", stroke: "#c9a45c", strokeWidth: 1.5, corners: { radius: [18, 18, 18, 18], kind: "notch" }, shadow: { color: "rgba(0,0,0,0.55)", blur: 28 }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, spring: { stiffness: 170, damping: 20 }, decor: "naqsh-stars" },
        "text/title/idle": { textColor: "#f3e6c8", font: "600 26px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "text/body/idle": { textColor: "rgba(243,230,200,0.78)", font: "400 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/primary/idle": { fill: "#7a4a1c", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#fbeed2", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/primary/hovered": { fill: "#946024", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#fbeed2", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/primary/pressed": { fill: "#5e3814", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 1, 0, 3], live: true }, textColor: "#fbeed2", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/primary/focused": { fill: "#7a4a1c", stroke: "#f2d38a", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 1, 3], live: true }, textColor: "#fbeed2", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/primary/disabled": { fill: "rgba(122,74,28,0.35)", stroke: "rgba(201,164,92,0.35)", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "rgba(251,238,210,0.4)", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/secondary/idle": { fill: "rgba(201,164,92,0.10)", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 3], live: true }, textColor: "#f3e6c8", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/secondary/hovered": { fill: "rgba(201,164,92,0.20)", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 0, 0, 3], live: true }, textColor: "#f3e6c8", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
        "pressable/secondary/pressed": { fill: "rgba(201,164,92,0.28)", stroke: "#c9a45c", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "fn nq_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn nq_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(nq_hash(i), nq_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(nq_hash(i + vec2<f32>(0.0, 1.0)), nq_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\n// a.x hover, a.y press, a.z focus, a.w grain size in px\nfn shade(px: Pixel) -> vec4<f32> {\n  let drift = vec2<f32>(px.time * 3.0, px.time * 1.3);\n  let size = max(px.a.w, 1.0);\n  let grain = 0.5 * nq_noise((px.local + drift) / size) + 0.5 * nq_noise((px.local - drift * 0.5) / (size * 0.37));\n  var col = px.color.rgb * (0.9 + 0.14 * grain);\n  let d = distance(px.local, px.pointer);\n  let warm = exp(-d * d / (2.0 * 90.0 * 90.0)) * (0.08 + 0.22 * px.a.x);\n  col = col + vec3<f32>(0.95, 0.78, 0.42) * warm;\n  let rim = smoothstep(-3.0, 0.0, px.sdf) * (0.3 + 0.45 * px.a.x + 0.25 * px.a.z);\n  col = mix(col, vec3<f32>(0.96, 0.83, 0.58), rim);\n  let ripple = sin(d * 0.08 - px.time * 9.0) * exp(-d * 0.012) * px.a.y * 0.15;\n  col = col + vec3<f32>(ripple);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [1, 1, 0, 3], live: true }, textColor: "#f3e6c8", font: "600 15px sans-serif", spring: { stiffness: 170, damping: 20 } },
