          "scroll/default/thumb-dragging": { fill: "#fff6ec", corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(230,194,122,0.5)", blur: 20 }, spring: { stiffness: 150, damping: 20 } },
          "drag/default/idle": { fill: "rgba(255,246,236,0.5)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(42,30,51,0.86)", font: "400 15px sans-serif", spring: { stiffness: 150, damping: 20 } },
          "drag/default/dragging": { fill: "rgba(255,246,236,0.8)", corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "rgba(42,30,51,0.86)", font: "400 15px sans-serif", spring: { stiffness: 150, damping: 20 }, shadow: { color: "rgba(42,30,51,0.3)", blur: 36 } },
          "mirror/primary/idle": { fill: "rgba(255,246,236,0.9)", backdrop: { blur: 16, tint: "rgba(255,240,220,0.18)", saturate: 1.1 }, stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(42,30,51,0.28)", blur: 36 }, material: { wgsl: "// warm cream glass with a gold inlay line inside its edge; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = mix(px.color.rgb, vec3<f32>(0.99, 0.92, 0.84), px.uv.y * 0.35);\n  let inlay = 1.0 - smoothstep(0.3, 1.0, abs(px.sdf + 5.0));\n  col = mix(col, vec3<f32>(0.902, 0.761, 0.478), inlay * (0.5 + 0.3 * px.a.z));\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.85, 0.6) * exp(-d * d / 30000.0) * 0.05;\n  return vec4<f32>(col, max(px.color.a, inlay * 0.5));\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 150, damping: 20 } },
          "particles/primary/idle": { fill: "#fff0cf" },
          "orbit/ring/idle": { stroke: "rgba(230,194,122,0.85)", strokeWidth: 1.2 },
          "orbit/arc/lit": { stroke: "#f6b98a", strokeWidth: 3, material: { wgsl: "// the travelled arc: gold warming to rose\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let k = 0.5 + 0.5 * sin(atan2(c.y, c.x) + px.time * 0.3);\n  return vec4<f32>(mix(vec3<f32>(0.902, 0.761, 0.478), vec3<f32>(0.784, 0.416, 0.494), k), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "orbit/station/idle": { fill: "rgba(255,246,236,0.92)", stroke: "#e6c27a", strokeWidth: 1.2, shadow: { color: "rgba(42,30,51,0.25)", blur: 10 }, spring: { stiffness: 150, damping: 20 } },
          "orbit/station/hovered": { fill: "#ffffff", stroke: "#f6b98a", strokeWidth: 1.4, shadow: { color: "rgba(246,185,138,0.55)", blur: 16 }, spring: { stiffness: 150, damping: 20 } },
          "orbit/station/focused": { fill: "rgba(255,246,236,0.92)", stroke: "#7a2f56", strokeWidth: 2.4, shadow: { color: "rgba(42,30,51,0.25)", blur: 10 }, spring: { stiffness: 150, damping: 20 } },
          "orbit/station/active": { fill: "#fff0cf", stroke: "#c86a7e", strokeWidth: 1.6, shadow: { color: "rgba(246,185,138,0.55)", blur: 22 }, spring: { stiffness: 150, damping: 20 } },
          "orbit/beat/idle": { stroke: "#f6b98a", fill: "rgba(246,185,138,0.4)" },
          "orbit/label/idle": { textColor: "rgba(255,246,236,0.8)", font: "400 13px sans-serif" },
          "orbit/label/active": { textColor: "#fff6ec", font: "600 13px sans-serif" },
          "orbit/core/idle": { fill: "rgba(255,246,236,0.9)", stroke: "#e6c27a", strokeWidth: 1.2, backdrop: { blur: 14, tint: "rgba(255,240,220,0.18)", saturate: 1.1 } },
          "machine/state/idle": { fill: "rgba(255,246,236,0.9)", stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(42,30,51,0.86)", font: "400 15px sans-serif" },
          "machine/state/active": { fill: "#2a1e33", stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "#fff6ec", font: "600 15px sans-serif", material: { wgsl: "// a plum tile edged in gold, lit from the horizon; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.12 - 0.22 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(1.0, 0.78, 0.55) * exp(-d * d / 6000.0) * (0.04 + 0.12 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 3.5));\n  col = mix(col, vec3<f32>(0.902, 0.761, 0.478), inlay * (0.35 + 0.35 * px.a.x));\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.6));\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/state/visited": { fill: "rgba(255,246,236,0.9)", stroke: "#f6b98a", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "rgba(42,30,51,0.86)", font: "400 15px sans-serif" },
          "machine/wire/idle": { stroke: "rgba(42,30,51,0.45)", strokeWidth: 1.5 },
          "machine/wire/next": { stroke: "rgba(42,30,51,0.75)", strokeWidth: 1.5 },
          "machine/wire/lit": { stroke: "#f6b98a", strokeWidth: 2.5, material: { wgsl: "// the travelled arc: gold warming to rose\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.uv - vec2<f32>(0.5, 0.5);\n  let k = 0.5 + 0.5 * sin(atan2(c.y, c.x) + px.time * 0.3);\n  return vec4<f32>(mix(vec3<f32>(0.902, 0.761, 0.478), vec3<f32>(0.784, 0.416, 0.494), k), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
          "machine/pill/idle": { fill: "rgba(255,246,236,0.95)", stroke: "rgba(42,30,51,0.45)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/next": { fill: "rgba(255,246,236,0.95)", stroke: "rgba(42,30,51,0.75)", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/lit": { fill: "rgba(255,246,236,0.95)", stroke: "#f6b98a", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "round" } },
          "machine/pill/hovered": { fill: "rgba(230,194,122,0.30)" },
          "machine/event/idle": { textColor: "#3a2a45", font: "400 14px monospace" },
          "machine/event/lit": { textColor: "#2a1e33", font: "400 14px monospace" },
          "machine/guard/idle": { fill: "rgba(255,246,236,0.9)", stroke: "#3a2a45", strokeWidth: 1.2 },
          "machine/guard/refused": { fill: "#e5484d", stroke: "#e5484d", strokeWidth: 1.2 },
          "machine/badge/idle": { fill: "#2a1e33", stroke: "#e6c27a", textColor: "#fff6ec", corners: { radius: [8, 8, 8, 8], kind: "round" }, font: "600 11px sans-serif" },
          "machine/token/idle": { fill: "#fff0cf", stroke: "#f6b98a", strokeWidth: 1 },
          "machine/bloom/idle": { stroke: "#f6b98a", strokeWidth: 2 },
          "machine/effect/other": { fill: "rgba(0,0,0,0)", stroke: "#3a2a45", strokeWidth: 1.2, decor: "M-0.5 0 A0.5 0.5 0 1 0 0.5 0 A0.5 0.5 0 1 0 -0.5 0 Z" },
          "stack/source/idle": { fill: "rgba(255,246,236,0.95)", stroke: "#e6c27a", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, backdrop: { blur: 16, tint: "rgba(255,240,220,0.18)", saturate: 1.1 } },
          "text/code/idle": { textColor: "#3a2a45", font: "400 14px monospace" },
          "text/code/active": { textColor: "#2a1e33", font: "700 14px monospace", fill: "rgba(246,185,138,0.35)" }
        },
        "ink-gold": {
          "surface/ground/idle": { fill: "#f4efe4", material: { wgsl: "// manuscript paper: long fibres in two directions and a fine tooth, all static\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let f1 = ig_noise(vec2<f32>(p.x * 0.9, p.y * 0.06));\n  let f2 = ig_noise(vec2<f32>(p.y * 0.8 + 41.0, p.x * 0.05));\n  let tooth = ig_hash(floor(p)) - 0.5;\n  var col = vec3<f32>(0.957, 0.937, 0.894);\n  col = col * (1.0 - 0.05 * f1 - 0.04 * f2);\n  col = col + vec3<f32>(tooth, tooth, tooth) * 0.018;\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 90, damping: 18 } },
          "stack/panel/idle": { fill: "rgba(247,243,232,0.97)", backdrop: { blur: 0, tint: "rgba(247,243,232,0)", saturate: 1.0 }, stroke: "#141414", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(20,20,20,0.12)", blur: 18 }, spring: { stiffness: 90, damping: 18 } },
          "text/title/idle": { textColor: "#141414", font: "600 28px serif", spring: { stiffness: 90, damping: 18 } },
          "text/body/idle": { textColor: "rgba(20,20,20,0.86)", font: "400 15px serif", spring: { stiffness: 90, damping: 18 } },
          "pressable/primary/idle": { fill: "#c9a14a", stroke: "#141414", strokeWidth: 1.2, corners: { radius: [3, 3, 3, 3], kind: "round" }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#141414", font: "600 15px serif", spring: { stiffness: 90, damping: 18 } },
          "pressable/primary/hovered": { fill: "#d6ae56", stroke: "#141414", strokeWidth: 1.2, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(201,161,74,0.45)", blur: 14 }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#141414", font: "600 15px serif", spring: { stiffness: 90, damping: 18 } },
          "pressable/primary/pressed": { fill: "#b8923f", stroke: "#141414", strokeWidth: 1.2, corners: { radius: [3, 3, 3, 3], kind: "round" }, material: { wgsl: "// gold leaf: a crinkled foil with a highlight that follows the pointer; a.x hover, a.y press, a.z focus\nfn ig_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn ig_noise(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(ig_hash(i), ig_hash(i + vec2<f32>(1.0, 0.0)), u.x), mix(ig_hash(i + vec2<f32>(0.0, 1.0)), ig_hash(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let crinkle = ig_noise(px.local * 0.35 + vec2<f32>(3.1, 7.7));\n  let fine = ig_noise(px.local * 1.3);\n  var col = px.color.rgb * (0.88 + 0.18 * crinkle + 0.06 * fine);\n  let d = distance(px.local, px.pointer);\n  let hl = exp(-d * d / 9800.0);\n  col = col + vec3<f32>(1.0, 0.93, 0.65) * hl * (0.20 + 0.25 * px.a.x) * (0.6 + 0.8 * crinkle);\n  let sweep = pow(max(0.0, sin((px.local.x - px.local.y * 0.5) * 0.02 - px.time * 0.5)), 24.0);\n  col = col + vec3<f32>(1.0, 0.95, 0.75) * sweep * 0.10;\n  col = col * (1.0 - 0.12 * px.a.y);\n  return vec4<f32>(clamp(col, vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "#141414", font: "600 15px serif", spring: { stiffness: 90, damping: 18 } },
