        "majlis": {
          "surface/ground/idle": { fill: "#f1e4d0", material: { wgsl: "fn mj_hash(p: vec2<f32>) -> f32 {\n  return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let cellpx = 64.0;\n  let q = (px.local + vec2<f32>(px.scroll * 0.1, 0.0)) / cellpx;\n  let cid = floor(q);\n  let f = fract(q) - vec2<f32>(0.5, 0.5);\n  let ax = abs(f.x);\n  let ay = abs(f.y);\n  let sq = (max(ax, ay) - 0.27) * cellpx;\n  let dm = ((ax + ay) - 0.40) * 0.70711 * cellpx;\n  let sd = min(sq, dm);\n  let eg = (0.5 - max(ax, ay)) * cellpx;\n  let d = distance(px.local, px.pointer);\n  let nr = 1.0 - smoothstep(0.0, 200.0, d);\n  let w = mix(1.5, 0.4, nr);\n  let g1 = 1.0 - smoothstep(w - 0.6, w + 0.6, abs(sd));\n  let g2 = 1.0 - smoothstep(w - 0.6, w + 0.6, eg);\n  let grout = max(g1, g2);\n  let h = mj_hash(cid);\n  let ins = 1.0 - smoothstep(-0.7, 0.7, sd);\n  let terra = vec3<f32>(0.706, 0.329, 0.227);\n  let indigo = vec3<f32>(0.173, 0.18, 0.42);\n  let tn = select(indigo, terra, h > 0.5);\n  let tn2 = select(terra, indigo, h > 0.5);\n  var col = vec3<f32>(0.945, 0.894, 0.816);\n  col = mix(col, tn, ins * 0.03);\n  col = mix(col, tn2, (1.0 - ins) * 0.015);\n  col = mix(col, vec3<f32>(1.0, 0.975, 0.93), grout * 0.08);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 150, damping: 20 } },
