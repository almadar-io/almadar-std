            "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_rbox(p: vec2<f32>, h: vec2<f32>, r: f32) -> f32 { let q = abs(p) - h + vec2<f32>(r, r); return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r; }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet w = min(s.x * 0.28, m * 0.9);\nlet hy = min(w * 0.5, c.y - 5.0);\nvar a = 0.0;\nfor (var i = 0; i < 3; i = i + 1) {\n  let f = f32(i);\n  let bc = vec2<f32>(c.x + (f - 1.0) * w * 1.15, c.y);\n  a = max(a, sg_line(sg_rbox(p - bc, vec2<f32>(w * 0.5, hy), 14.0), 1.8));\n}\nlet rp = length(p - c);\na = max(a, max(sg_line(rp - 10.0, 1.0) * 0.8, max(sg_line(rp - 20.0, 1.0) * 0.4, sg_fill(rp - 4.0))));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } }
