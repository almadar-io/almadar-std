        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 140, damping: 22 } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body" },
