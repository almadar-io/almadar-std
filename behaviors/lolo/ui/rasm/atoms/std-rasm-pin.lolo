app std-rasm-pin [
  version: "0.2.0",
  description: "std-rasm-pin — pins one placed child to the top corner at the reading end (or, with `side` start, the reading start) of a placed rect, or with `edge` bottom to the bottom corner of the view (the surface height RASM_RESIZE reports; a fixed child stays there as the page scrolls). On RASM_PLACE for `anchor` it stores that rect and, when `enabled`, emits RASM_PLACE for `child` with the declared size inside the margin, narrowed to fit the anchor; RASM_DIRECTION moves the corner (right under ltr, left under rtl) and places again."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number, origin : string }
type RasmPinShape = { width : number?, height : number?, margin : number? }

orbital RasmPinOrbital {
  entity RasmPinRun [runtime] {
    id : string!
    rect : RasmRect? @description "The anchor's rect RASM_PLACE gave, null until placed." = null
    origin : string @description "The origin the anchor was placed in, empty for the page: the child is pinned in that same origin." = ""
    dir : "ltr" | "rtl" @description "The surface's reading direction." = "ltr"
    viewH : number @description "The surface height RASM_RESIZE reported, 0 before it did." = 0
    variant : string @description "The key of `variants` the announced breakpoint chose, empty for the configured size." = ""
  }

  trait RasmPin -> RasmPinRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (emit PIN_PLACE { })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.anchor)))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.anchor))))) @mine.rect))
        (set @entity.origin (let ((mine (array/find ?placed (fn p (= @p.id @config.anchor))))) (default @mine.origin "")))
        (emit PIN_PLACE { })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.anchor))))
      RASM_RESIZE -> ready
        (set @entity.viewH ?height)
        (emit PIN_PLACE { })
      RASM_BREAKPOINT -> ready when (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant))
        (set @entity.variant (default (array/find ?chain (fn n (object/has @config.variants @n))) ""))
        (emit PIN_PLACE { })
      RASM_BREAKPOINT -> ready when (not (and (= @config.variantBy "breakpoint") (!= (default (array/find ?chain (fn n (object/has @config.variants @n))) "") @entity.variant)))
      PIN_PLACE -> ready when (and @config.enabled (!= @entity.rect null) (or (= @config.edge "top") (> @entity.viewH 0)))
        (let ((sh (object/get @config.variants @entity.variant null))) (let ((cw (default (if (= @sh null) null @sh.width) @config.width)) (ch (default (if (= @sh null) null @sh.height) @config.height)) (cm (default (if (= @sh null) null @sh.margin) @config.margin))) (let ((r @entity.rect) (w (math/min @cw (- @entity.rect.w (+ (* 2 @cm) @config.inset)))))
          (emit RASM_PLACE { placed: [{ id: @config.child, origin: @entity.origin, rect: { x: (if (= (= @entity.dir "rtl") (= @config.side "end")) (+ @r.x (+ @cm @config.inset)) (- (+ @r.x @r.w) (+ @w (+ @cm @config.inset)))), y: (if (= @config.edge "bottom") (- (+ @r.y @entity.viewH) (+ @ch @cm)) (+ @r.y @cm)), w: @w, h: @ch } }] }))))
      PIN_PLACE -> ready when (not (and @config.enabled (!= @entity.rect null) (or (= @config.edge "top") (> @entity.viewH 0))))
    }

    emits {
      RASM_PLACE -> external {
        placed : [RasmPlaced]!
      }
        @description "The pinned child's rect."
        @tier "domain"
      PIN_PLACE -> internal { }
        @tier "internal"
    }

    listens {
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The surface's reading direction: the pinned corner follows the reading end."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take the anchor's rect when it is placed and place the child."
      RASM_RESIZE { width : number!  height : number! }
        @description "Take the surface height: a bottom-edge child sits that far down from the anchor's top."
      RASM_BREAKPOINT { name : "phone" | "tablet" | "desktop" | "wide"!  width : number!  chain : [string]! }
        @description "With variantBy \"breakpoint\": the size is the first name of chain (the announced breakpoint, then each smaller declared one) that `variants` holds; none keeps the configured width, height and margin."
    }

    config {
      anchor : string = "page"
        @label "Anchor"
        @description "The id of the placed rect the child is pinned inside."
        @tier "presentation"
      child : string = ""
        @label "Child"
        @description "The id of the placed child to pin."
        @tier "presentation"
      enabled : boolean = true
        @label "Enabled"
        @description "Off places nothing."
        @tier "presentation"
      width : number = 280
        @label "Width"
        @description "The child's width in px, narrowed to fit the anchor minus the margins."
        @tier "presentation"
      height : number = 48
        @label "Height"
        @description "The child's height in px."
        @tier "presentation"
      edge : "top" | "bottom" = "top"
        @label "Edge"
        @description "Which corner at the reading end: the anchor's top, or the bottom of the view (the surface height)."
        @tier "presentation"
      side : "end" | "start" = "end"
        @label "Side"
        @description "Which top corner: the reading end (right under ltr, left under rtl) or the reading start, for a logo that leads the page."
        @tier "presentation"
      margin : number = 12
        @label "Margin"
        @description "The space in px between the anchor's top and end edges and the child."
        @tier "presentation"
      inset : number = 0
        @label "Inset"
        @description "Extra space in px between the anchor's end edge and the child, added to the margin along the reading direction only, so two pinned children can sit side by side."
        @tier "presentation"
      variantBy : "" | "breakpoint" = ""
        @label "Vary by"
        @description "breakpoint picks a size from `variants` on each RASM_BREAKPOINT; empty keeps the configured size."
        @tier "presentation"
      variants : Map string RasmPinShape = {}
        @label "Variants"
        @description "Sizes by breakpoint name (phone, tablet, desktop, wide); a field left out keeps the configured width, height or margin."
        @tier "presentation"
    }
  }

  page boot as RasmPinStart -> RasmPin
}
