app std-rasm-material [
  version: "0.1.0",
  description: "std-rasm-material — one placed rect painted by a WGSL material. Once placed it paints one draw-shape rect over its rect whose fill is the material from config (wgsl, live, params, targets) or from a theme look key: the placement instant is the material's anchor, so the canvas runs the shader on its own clock and the logic runs only at event rate. RASM_MATERIAL_SET replaces the params and RASM_MATERIAL_PARAM sets one by index, each for its id; with a spring the params animate to the new values. This is the one owner of the placed-material mechanism the themed atoms compose."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation? }
type RasmShadow = { color : string!, blur : number! }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string }

orbital RasmMaterialOrbital {
  entity RasmMaterialRun [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The rect RASM_PLACE gave this material, null until placed." = null
    anchorMs : number @description "The first placement instant on the canvas epoch clock: the material's anchor." = 0
    params : [number] @description "The current material params, at most eight." = []
    wgsl : string @description "The shader source the last RASM_MATERIAL_SET carried; when not empty it is painted in preference to the look's material and the config." = ""
    settled : boolean @description "True once the first RASM_MATERIAL_SET has landed; with awaitParams nothing is painted before." = false
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmMaterial -> RasmMaterialRun [client] {
    initial: ready

    state ready {
      INIT -> ready
        (set @entity.params @config.params)
      RASM_BOOT -> ready
        (set @entity.params @config.params)
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit MATERIAL_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id @config.id)))
        (set @entity.anchorMs (if (= @entity.rect null) (time/epoch-ms @now) @entity.anchorMs))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit MATERIAL_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_MATERIAL_SET -> ready when (= ?id @config.id)
        (set @entity.params ?params)
        (set @entity.settled true)
        (set @entity.wgsl (if (= ?wgsl null) @entity.wgsl ?wgsl))
        (set @entity.anchorMs (if (= ?anchor true) (time/epoch-ms @now) @entity.anchorMs))
        (set @entity.paints (+ @entity.paints 1))
        (emit MATERIAL_PAINT { n: @entity.paints })
      RASM_MATERIAL_SET -> ready when (!= ?id @config.id)
      RASM_MATERIAL_PARAM -> ready when (= ?id @config.id)
        (set @entity.params (array/map (array/range (math/max (array/len @entity.params) (+ ?index 1))) (fn i (if (= @i ?index) ?value (default (array/nth @entity.params @i) 0)))))
        (set @entity.paints (+ @entity.paints 1))
        (emit MATERIAL_PAINT { n: @entity.paints })
      RASM_MATERIAL_PARAM -> ready when (!= ?id @config.id)
      MATERIAL_PAINT -> ready
        (let ((r @entity.rect) (l (if (= @config.look "") null (object/get @entity.looks @config.look null))))
          (let ((lm (if (= @l null) null @l.material)))
            (let ((src (if (and (!= @lm null) (!= @lm.wgsl "")) @lm null)))
              (when (and (!= @r null) (or (not @config.awaitParams) @entity.settled) (or (!= @src null) (!= @config.wgsl "") (!= @entity.wgsl "")))
                (emit RASM_PAINT { id: @config.id, z: @config.z, texts: [], nodes: [(object/merge { type: draw-shape, id: @config.id, shape: rect, anchor: "top-left", position: { x: @r.x, y: @r.y, z: @config.z }, width: @r.w, height: @r.h, fill: (if (or (= @l null) (= @l.fill null)) @config.fill @l.fill), hit: @config.hit, wheel: @config.wheel, material: (object/merge { wgsl: (if (!= @entity.wgsl "") @entity.wgsl (if (= @src null) @config.wgsl @src.wgsl)), params: @entity.params, live: (if (= @src null) @config.live @src.live), anchor: @entity.anchorMs } (if (> (array/len @config.targets) 0) { targets: @config.targets } {})) } (if (> @config.spring.stiffness 0) { spring: @config.spring } {}))] })))))
    }

    emits {
      MATERIAL_PAINT -> internal {
        n : number!
      }
        @description "Repaint from the stored rect, looks and params."
        @tier "internal"
      RASM_PAINT -> external {
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The material as one draw-shape rect at its z; the canvas runs the shader on its own clock."
        @tier "primary"
    }

    listens {
      RASM_BOOT { }
        @description "Reset the params to the configured start."
        @tier "domain"
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
        @tier "domain"
      RASM_PLACE { placed : [RasmPlaced]! }
        @description "Take this material's rect when it is placed; the first placement is the anchor instant."
        @tier "domain"
      RASM_MATERIAL_SET { id : string!  params : [number]!  anchor : boolean?  wgsl : string? }
        @description "Replace the params of the material with this id and repaint; anchor true re-stamps the anchor instant first."
        @tier "domain"
      RASM_MATERIAL_PARAM { id : string!  index : number!  value : number! }
        @description "Set one param of the material with this id by index, padding with zeros, and repaint."
        @tier "domain"
    }

    config {
      id : string = "material"
        @label "Id"
        @description "The material's RASM_PLACE key, paint id and message key."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
      look : string = ""
        @label "Look"
        @description "A theme look key; the announced look supplies the fill when it has one, and its material (WGSL and live flag) when it carries one, in place of the knobs below."
        @tier "presentation"
      wgsl : string = ""
        @label "Material"
        @description "The WGSL material source; nothing is painted while this and the look are both empty."
        @tier "domain"
      live : boolean = false
        @label "Live"
        @description "Whether the canvas redraws the material every frame."
        @tier "domain"
      fill : string = "#000000"
        @label "Fill"
        @description "The colour under the material."
        @tier "presentation"
      params : [number] = []
        @label "Params"
        @description "The starting material params, at most eight."
        @tier "domain"
      targets : [string] = []
        @label "Render targets"
        @description "Render-target ids the material samples, passed through as material.targets; omitted when empty."
        @tier "domain"
      spring : RasmSpring = { stiffness: 0, damping: 0 }
        @label "Spring"
        @description "No spring while stiffness is 0; otherwise the node carries it so param changes spring to their new values."
        @tier "presentation"
      awaitParams : boolean = false
        @label "Await params"
        @description "When true nothing is painted until the first RASM_MATERIAL_SET: placement and theme only store, so the first paint carries the real params and not the starting ones."
        @tier "domain"
      hit : boolean = false
        @label "Hit"
        @description "Whether the rect takes pointer hits."
        @tier "domain"
      wheel : boolean = false
        @label "Wheel"
        @description "Whether the rect takes wheel input."
        @tier "domain"
    }
  }

  page boot as RasmMaterialStart -> RasmMaterial
}
