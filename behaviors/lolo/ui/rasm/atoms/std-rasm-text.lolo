app std-rasm-text [
  version: "0.1.0",
  description: "std-rasm-text — the Rasm kit's paragraph. Once it has a rect wider than zero and looks it paints one measured, wrapping draw-text in the text/<intent>/idle look (text/<intent>/inverse with tone inverse), so its parent stack can size it from RASM_MEASURED. RASM_ENTER plays its entry choreography. A title, display or poster paragraph is a heading node (level 1 for display and poster, 2 for title, or `headingLevel`). With `maxChars` the paragraph is capped at that many average characters wide. A look whose `backing` is `plate` paints a rounded rect of its fill, padded 8px, behind the paragraph. A numeral stays on one line. With fit shrink the paragraph steps its font size down until it fits its placed rect; with reveal type it types out glyph by glyph. A zero-width rect (a child the active shape leaves out) paints an empty layer, so what it painted before is cleared."
]

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect!, rotate : number }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, startMs : number, loop : boolean!, keyframes : [RasmKeyframe]! }
type RasmReveal = { startMs : number!, perGlyphMs : number!, durationMs : number! }
type RasmHalo = { color : string!, width : number! }
type RasmTextParams = Map string string
type RasmText = { id : string!, key : MessageKey!, params : RasmTextParams?, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, level : number?, animation : RasmAnimation?, reveal : RasmReveal?, height : number?, fit : "none" | "shrink"?, minSize : number?, rotate : number?, vertical : boolean?, pivotX : number?, pivotY : number?, halo : RasmHalo? }
type RasmShadow = { color : string!, blur : number!, offsetX : number, offsetY : number }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop, on : string, backing : "none" | "halo" | "plate" }

type RasmEntryKey = { at : number!, opacity : number!, offsetX : number!, offsetY : number!, scale : number, rotate : number }
type RasmLayout = { hero : "centered" | "split" | "offset" | "full-bleed" | "poster" | "editorial" | "collage"!, columns : number!, asymmetry : number!, ornament : "none" | "rule" | "double-rule" | "frame" | "stamp"!, align : "start" | "center"!, imageTreatment : "none" | "duotone" | "halftone" | "riso" | "engraving" | "glow" | "grain" | "scanline"!, sectionGap : number!, gutter : number! }
type RasmMotion = { signature : string!, stiffness : number!, damping : number!, stagger : number!, enterMs : number, keyframes : [RasmEntryKey] }
type RasmEntryItem = { id : string!, durationMs : number!, keyframes : [RasmEntryKey]! }

orbital RasmTextOrbital {
  entity RasmTextRun [runtime] {
    id : string!
    entry : RasmEntryItem? @description "This control's entry from the announced style's choreography, null for the built-in one." = null
    rect : RasmRect? @description "The rect RASM_PLACE gave this text, null until placed." = null
    rotate : number @description "The rotation in radians RASM_PLACE gave this text, 0 when none." = 0
    looks : Map string RasmLook @description "The announced look table." = {}
    dir : "ltr" | "rtl" @description "The direction the surface announced; rtl aligns the paragraph to the right edge." = "ltr"
    centered : boolean @description "The announced style centres this paragraph (followAlign on and the layout aligns to the centre)." = false
    enterIndex : number @description "This text's position in the RASM_ENTER order, -1 when it is not in it." = -1
    enteredMs : number @description "The epoch-ms instant the entry animation started, 0 before it." = 0
    placedMs : number @description "The epoch-ms instant this text was first placed, 0 before it; the typed reveal starts here when the text has no entry." = 0
    key : MessageKey? @description "The catalog key RASM_TEXT_KEY gave this text, null while the configured text shows." = null
    value : number? @description "The number RASM_TEXT_VALUE gave this text, null while the configured value shows." = null
    params : RasmTextParams @description "The named placeholder values RASM_TEXT_PARAMS gave this text." = {}
    staggerMs : number = 70
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait RasmText -> RasmTextRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      RASM_DIRECTION -> ready
        (set @entity.dir ?direction)
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_TREND -> ready
        (set @entity.centered (and @config.followAlign (= ?layout.align "center")))
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h) (= (default @mine.rotate 0) @entity.rotate))))
      RASM_PLACE -> ready when (and (array/some ?placed (fn p (= @p.id @config.id))) (not (let ((mine (array/find ?placed (fn p (= @p.id @config.id)))) (cur @entity.rect)) (and (!= @mine null) (!= @cur null) (= @mine.rect.x @cur.x) (= @mine.rect.y @cur.y) (= @mine.rect.w @cur.w) (= @mine.rect.h @cur.h) (= (default @mine.rotate 0) @entity.rotate)))))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) null @mine.rect)))
        (set @entity.rotate (let ((mine (array/find ?placed (fn p (= @p.id @config.id))))) (if (= @mine null) 0 (default @mine.rotate 0))))
        (set @entity.placedMs (if (= @entity.placedMs 0) (time/epoch-ms @now) @entity.placedMs))
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_TEXT_KEY -> ready when (= ?id @config.id)
        (set @entity.key ?key)
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_TEXT_KEY -> ready when (!= ?id @config.id)
      RASM_TEXT_VALUE -> ready when (= ?id @config.id)
        (set @entity.value ?value)
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_TEXT_VALUE -> ready when (!= ?id @config.id)
      RASM_TEXT_PARAMS -> ready when (= ?id @config.id)
        (set @entity.params ?params)
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_TEXT_PARAMS -> ready when (!= ?id @config.id)
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id @config.id))))
      RASM_ENTER -> ready when (array/includes ?order @config.id)
        (set @entity.entry (array/find (default ?entries []) (fn e (= @e.id @config.id))))
        (set @entity.enterIndex (array/indexOf ?order @config.id))
        (set @entity.enteredMs (if (array/includes ?order @config.id) (time/epoch-ms @now) @entity.enteredMs))
        (set @entity.staggerMs ?staggerMs)
        (set @entity.paints (+ @entity.paints 1))
        (emit TEXT_PAINT { n: @entity.paints })
      RASM_ENTER -> ready when (not (array/includes ?order @config.id))
      TEXT_PAINT -> ready
        (let ((l (object/get @entity.looks (if (= @config.look "") (str/concat "text/" @config.intent (if (= @config.tone "inverse") "/inverse" "/idle")) @config.look) null)) (r @entity.rect)) (when (and (!= @l null) (!= @r null)) (if (> @r.w 0) (let ((idx @entity.enterIndex) (stag @entity.staggerMs)) (let ((dur (+ 520 (* @idx @stag)))) (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: (if (= @l.backing "plate") [{ type: draw-shape, id: (str/concat @config.id ":plate"), shape: "rect", anchor: "top-left", position: { x: (- @r.x 8), y: (- @r.y 8), z: @config.z }, width: (+ @r.w 16), height: (+ @r.h 16), fill: @l.fill, corners: { radius: [6, 6, 6, 6], kind: "round" }, hit: false }] []), texts: [(object/merge (object/merge (object/merge (object/merge (object/merge { id: @config.id, key: (default @entity.key @config.text), x: @r.x, y: @r.y, z: @config.z, baseline: "top", width: (if (> @config.maxChars 0) (math/min @r.w (* (* @config.maxChars 0.5) (default (str/to-number (str/replace (default (array/find (str/split (default @l.font "") " ") (fn q (str/includes @q "px"))) "") "px" "")) 16))) @r.w), wrap: (!= @config.intent "numeral"), align: (if @entity.centered "center" (if (= @entity.dir "rtl") "right" "left")), measure: true, color: @l.textColor, font: @l.font, spring: @l.spring, role: (if (array/includes ["poster", "display", "title"] @config.intent) "heading" "text"), level: (if (array/includes ["poster", "display", "title"] @config.intent) (if (> @config.headingLevel 0) @config.headingLevel (if (= @config.intent "title") 2 1)) null), animation: (if (>= @idx 0) (if (= @entity.entry null) { durationMs: @dur, startMs: @entity.enteredMs, loop: false, keyframes: [{ at: 0, opacity: 0, offsetY: 14 }, { at: (default (/ (* @idx @stag) @dur) 0), opacity: 0, offsetY: 14 }, { at: 1, opacity: 1, offsetY: 0 }] } { durationMs: @entity.entry.durationMs, startMs: @entity.enteredMs, loop: false, keyframes: @entity.entry.keyframes }) null) } (if (or @config.vertical (!= @entity.rotate 0)) { rotate: @entity.rotate, vertical: @config.vertical, pivotX: (+ @r.x (/ @r.w 2)), pivotY: (+ @r.y (/ @r.h 2)) } {})) (if (and (= @config.fit "shrink") (> @r.h 0)) { height: @r.h, fit: "shrink", minSize: @config.minSize } {})) (if (= @config.reveal "type") { reveal: { startMs: (if (> @entity.enteredMs 0) @entity.enteredMs @entity.placedMs), perGlyphMs: @config.revealMs, durationMs: @config.revealMs } } {})) (if (= @l.backing "halo") { halo: { color: (default @l.fill ""), width: 4 } } {})) (let ((pm (object/merge (if (= @config.param "") {} (object/set {} @config.param (default (format/number (default @entity.value @config.value) { decimals: @config.decimals }) ""))) @entity.params))) (if (= (array/len (object/keys @pm)) 0) {} { params: @pm })))] }))) (emit RASM_PAINT { n: ?n, id: @config.id, z: @config.z, nodes: [], texts: [] }))))
    }

    emits {
      TEXT_PAINT -> internal {
        n : number!
      }
        @description "Repaint from the stored rect and look."
        @tier "internal"
      RASM_PAINT -> external {
        n : number!
        id : string!
        z : number!
        nodes : [node]!
        texts : [RasmText]!
      }
        @description "The paragraph as a catalog-keyed text at its z; the surface paints it in the active locale."
        @tier "primary"
    }

    listens {
      RASM_DIRECTION { direction : "ltr" | "rtl"! }
        @description "The surface's reading direction: rtl aligns the paragraph to the right edge."
      RASM_TREND { name : string!  layout : RasmLayout!  motion : RasmMotion! }
        @description "With followAlign on, a layout that aligns to the centre centres the paragraph; any other alignment keeps it on the reading edge."
        @description "The surface's reading direction; once announced it replaces this atom's direction knob and the layout is redone."
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint."
      RASM_TEXT_KEY { id : string!  key : MessageKey! }
        @description "Show this catalog key in place of the configured text when the id is this text's, and repaint."
      RASM_TEXT_VALUE { id : string!  value : number! }
        @description "Fill the param placeholder with this number (rounded), for this id; a std-rasm-tween step drives a count-up."
      RASM_TEXT_PARAMS { id : string!  params : RasmTextParams! }
        @description "Fill these named placeholders of the text's catalog message with these strings, for this id, beside the param's number, and repaint: a running time shown as minutes and seconds."
      RASM_PLACE { placed : [RasmPlaced]!  n : number }
        @description "Take this text's rect when it is placed and repaint."
      RASM_ENTER { order : [string]!  staggerMs : number!  entries : [RasmEntryItem] }
        @description "Play the entry choreography when this text's id is in the order."
    }

    config {
      id : string = "text"
        @label "Id"
        @description "The text's id: its RASM_PLACE key, measure id and paint id."
        @tier "presentation"
      text : MessageKey
        @label "Text"
        @description "The catalog key of the paragraph."
        @tier "presentation"
      intent : "display" | "title" | "card" | "eyebrow" | "body" | "poster" | "numeral" | "caption" | "label" | "quote" | "inverse" = "body"
        @label "Intent"
        @description "Selects the look text/<intent>/idle. display and eyebrow are the landing headline and the line above it; card is a title inside a card; poster is oversized display type, numeral a large figure, caption a small line under a picture, label a short tag, quote a pulled quotation, inverse a line set on a primary-filled shape (a ticket stub, a band) in the primary foreground colour."
        @tier "presentation"
      tone : "default" | "inverse" = "default"
        @label "Tone"
        @description "default reads text/<intent>/idle; inverse reads text/<intent>/inverse, the same role set light on a dark or saturated field (a coloured section band), so a style gives every role an inverse size and colour."
        @tier "presentation"
      look : string = ""
        @label "Look"
        @description "A look key read in place of text/<intent>/<tone>; the intent still sets the heading level (for example text/eyebrow-insurance/idle, a role a page lays over its system). Empty reads the intent's own look."
        @tier "presentation"
      vertical : boolean = false
        @label "Vertical"
        @description "Paints one character per line, top to bottom: a vertical cartouche for CJK-style or decorative vertical labels. Only the paint is split, the message stays one key. A vertical text, like a rotated one, is painted as a canvas text node in the active locale at paint time."
        @tier "presentation"
      followAlign : boolean = false
        @label "Follow the style's alignment"
        @description "Centre this paragraph when the announced style's layout aligns to the centre (a centred hero); off keeps it on the reading edge whatever the style."
        @tier "presentation"
      fit : "none" | "shrink" = "none"
        @label "Fit"
        @description "none wraps the paragraph at its rect width and lets it grow downward. shrink steps the font size down, to minSize, until the wrapped paragraph fits the placed rect (its width and height); at minSize it paints at that size and may overflow."
        @tier "presentation"
      minSize : number = 12
        @label "Smallest size"
        @description "With fit shrink, the smallest font size in px the paragraph steps down to."
        @tier "presentation"
      reveal : "none" | "type" = "none"
        @label "Reveal"
        @description "none paints the paragraph at once. type shows it glyph by glyph like a typewriter or boot log, starting when its entry starts (RASM_ENTER) or, with no entry, when it is first placed."
        @tier "presentation"
      revealMs : number = 40
        @label "Reveal step"
        @description "With reveal type, the ms between one glyph and the next; each glyph also takes this long to settle in."
        @tier "presentation"
      maxChars : number = 0
        @label "Measure"
        @description "With a value above 0, the paragraph is no wider than about maxChars x 0.5 x its font size in px (the width of that many average characters), so a long line keeps a readable measure; 0 leaves the paragraph the width of its placed rect."
        @tier "presentation"
      headingLevel : number = 0
        @label "Heading level"
        @description "The heading level 1 to 6 a poster, display or title paragraph announces to assistive technology. 0 takes the intent's own level: poster and display 1, title 2. Other intents are plain text and announce no heading."
        @tier "presentation"
      param : string = ""
        @label "Param"
        @description "The {{placeholder}} in the text's message this text fills with a number: the configured value at rest, then each RASM_TEXT_VALUE, formatted with `decimals` fraction digits (rounded half away from zero). Empty fills nothing."
        @tier "presentation"
      value : number = 0
        @label "Value"
        @description "The number the param shows at rest, before any RASM_TEXT_VALUE: the final figure, so the page reads complete before a count-up runs."
        @tier "presentation"
      decimals : number = 0
        @label "Decimals"
        @description "How many fraction digits the param shows (0 rounds to a whole number), so a count-up can land on 99.98 or 18.4."
        @tier "presentation"
      z : number = 0
        @label "Z"
        @description "Paint order on the surface."
        @tier "presentation"
    }
  }

  page boot as RasmTextStart -> RasmText
}
