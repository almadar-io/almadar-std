app std-rasm-system-lustig-modern [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-lustig-modern — the Lustig Modern design system for a Rasm page, anchored on Alvin Lustig's New Directions book covers (1940s) (https://en.wikipedia.org/wiki/Alvin_Lustig). Colour: #F2E8D5 ground, #2B2118 ink, #E2572B accent. Type: Bricolage Grotesque over Karla. Grid: asymmetric 5-column grid with free floating shapes. Motion: the mid-hop easing (cubic-bezier 0.34,1.56,0.64,1.00); entrance: flat shapes drop then letters, a small overshoot. Interaction: shape behind the card shifts colour. Imagery: flat cut-paper shapes, no photographs. Voice: warm, curious, plainspoken. Components: buttons are pill + circle pairs; cards have one abstract shape corner. Data: dot plots in flat colour. Sound: wooden block knock on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "lustig-modern"
    palette: {background: "#F2E8D5", foreground: "#2B2118", card: "#F9F5EC", "card-foreground": "#2B2118", surface: "#ECE2CF", muted: "#E2D8C6", "muted-foreground": "#5E5448", border: "#7A7062", input: "#70665A", primary: "#E2572B", "primary-hover": "#EE6F45", "primary-foreground": "#120C06", secondary: "#F9F5EC", "secondary-foreground": "#2B2118", "secondary-hover": "#DAD0BE", accent: "#E2572B", "accent-foreground": "#120C06", ring: "#E2572B", "series-1": "#E2572B", "series-2": "#903F22", "series-3": "#2E7D7B", "series-4": "#675D51", "series-5": "#B16B55"}
    fonts: { display: { family: "Bricolage Grotesque", file: "https://almadar-kflow-assets.web.app/fonts/bricolagegrotesque/BricolageGrotesque%5Bopsz%2Cwdth%2Cwght%5D.ttf", generic: "sans-serif" }, body: { family: "Karla", file: "https://almadar-kflow-assets.web.app/fonts/karla/Karla%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn lu_disc(p: vec2<f32>, c: vec2<f32>, r: f32) -> f32 { return 1.0 - smoothstep(r - 1.0, r + 1.0, length(p - c)); }\nfn lu_box(p: vec2<f32>, c: vec2<f32>, h: vec2<f32>) -> f32 { let d = abs(p - c) - h; return 1.0 - smoothstep(-1.0, 1.0, max(d.x, d.y)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = px.size;\n  let m = min(s.x, s.y);\n  let tile = 1500.0;\n  let raw = px.local - vec2<f32>(0.0, px.scroll * 70.0);\n  let p = vec2<f32>(raw.x, raw.y - tile * floor(raw.y / tile));\n  let orange = vec3<f32>(0.886, 0.341, 0.169);\n  let teal = vec3<f32>(0.18, 0.49, 0.48);\n  let ink = vec3<f32>(0.169, 0.129, 0.094);\n  let a = lu_disc(p, vec2<f32>(s.x * 0.88, 260.0), m * 0.2);\n  let b = lu_disc(p, vec2<f32>(s.x * 0.04, 980.0), m * 0.3) * step(p.x, s.x * 0.04);\n  let rot = vec2<f32>(p.x * 0.8 - p.y * 0.6, p.x * 0.6 + p.y * 0.8);\n  let c = lu_box(rot, vec2<f32>(s.x * 0.5 + 300.0, 500.0), vec2<f32>(m * 0.5, 7.0));\n  let d = lu_box(p, vec2<f32>(s.x * 0.12, 420.0), vec2<f32>(m * 0.05, m * 0.05));\n  var col = px.color.rgb;\n  col = mix(col, orange, 0.17 * a);\n  col = mix(col, teal, 0.13 * b);\n  col = mix(col, ink, 0.07 * c);\n  col = mix(col, teal, 0.16 * d);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#2E7D7B", blur: 0, offsetX: 10, offsetY: 10 }, spring: { stiffness: 240, damping: 14 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#2E7D7B", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 240, damping: 14 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px body", shadow: { color: "#2B2118", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px body", shadow: { color: "#2E7D7B", blur: 0, offsetX: 7, offsetY: 7 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px body", shadow: { color: "#2B2118", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px body", shadow: { color: "#2B2118", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/secondary/idle": { fill: "card", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "600 18px body", shadow: { color: "#E2572B", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/secondary/hovered": { fill: "muted", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "600 18px body", shadow: { color: "#2E7D7B", blur: 0, offsetX: 7, offsetY: 7 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/secondary/pressed": { fill: "muted", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "600 18px body", shadow: { color: "#E2572B", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/secondary/disabled": { fill: "surface", textColor: "muted-foreground", stroke: "border", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "600 18px body", shadow: { color: "#E2572B", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 240, damping: 14 } },
        "pressable/secondary/focused": { fill: "card", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "600 18px body", shadow: { color: "#E2572B", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 240, damping: 14 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "foreground", textColor: "primary-foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#2E7D7B", blur: 0, offsetX: 10, offsetY: 10 }, spring: { stiffness: 240, damping: 14 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#E2572B", blur: 0, offsetX: 14, offsetY: 14 }, spring: { stiffness: 240, damping: 14 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#2E7D7B", blur: 0, offsetX: 10, offsetY: 10 }, spring: { stiffness: 240, damping: 14 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#E2572B", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 240, damping: 14 } },
        "card/header/idle": { fill: "accent", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "700 20px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 56], kind: "scoop" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 56], kind: "scoop" }, shadow: { color: "#2E7D7B", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 240, damping: 14 } },
        "panel/header/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "700 20px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "muted" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "text/display/idle": { textColor: "foreground", font: "800 76px display" },
        "text/title/idle": { textColor: "foreground", font: "700 38px display" },
        "text/eyebrow/idle": { textColor: "series-3", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 23px display" },
        "text/inverse/idle": { textColor: "foreground", font: "700 28px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px body" },
        "text/label/idle": { textColor: "foreground", font: "700 14px body" },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet o = vec2<f32>(s.x * 0.72, c.y);\nvar a = 0.0;\nfor (var i = 0; i < 8; i = i + 1) {\n  let f = f32(i);\n  let ang = f * 0.7854;\n  let dir = vec2<f32>(cos(ang), sin(ang));\n  let alt = f * 0.5 - floor(f * 0.5);\n  let l = m * (0.3 + 0.2 * alt);\n  a = max(a, max(sg_line(sg_seg(p - o, vec2<f32>(0.0, 0.0), dir * l), 0.9), sg_fill(length(p - o - dir * l) - 3.5)));\n}\nlet cc = vec2<f32>(s.x * 0.3, c.y);\nlet rr = m * 0.4;\nlet dA = length(p - cc) - rr;\nlet dB = length(p - cc - vec2<f32>(rr * 0.28, rr * 0.34)) - rr * 0.92;\nlet boom = sg_fill(max(dA, -dB));\nlet col = mix(vec3<f32>(0.1, 0.55, 0.55), px.color.rgb, boom);\nreturn sg_out(px, col, max(a, boom));\n}\n", params: [0, 0, 0, 0], live: false } },
        "image/duotone/idle": { fill: "primary", material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let l = dot(c.rgb / max(c.a, 0.001), vec3<f32>(0.299, 0.587, 0.114));\n  let ink = vec3<f32>(0.169, 0.129, 0.094);\n  let teal = vec3<f32>(0.18, 0.49, 0.48);\n  let paper = vec3<f32>(0.949, 0.91, 0.835);\n  var col = ink;\n  col = select(col, teal, l > 0.28);\n  col = select(col, px.color.rgb, l > 0.52);\n  col = select(col, paper, l > 0.78);\n  return vec4<f32>(col * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 5, asymmetry: 0.4, ornament: "none", align: "start", imageTreatment: "duotone", sectionGap: 104, gutter: 36 }
    motion: { signature: "mid-hop", stiffness: 240, damping: 14, stagger: 70, enterMs: 760, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -56, scale: 1, rotate: -2 }, { at: 0.1, opacity: 0.404, offsetX: 0, offsetY: -33.38, scale: 1, rotate: -1.192 }, { at: 0.2, opacity: 0.703, offsetX: 0, offsetY: -16.63, scale: 1, rotate: -0.594 }, { at: 0.3, opacity: 0.907, offsetX: 0, offsetY: -5.188, scale: 1, rotate: -0.185 }, { at: 0.4, opacity: 1, offsetX: 0, offsetY: 1.69, scale: 1, rotate: 0.06 }, { at: 0.5, opacity: 1, offsetX: 0, offsetY: 4.894, scale: 1, rotate: 0.175 }, { at: 0.6, opacity: 1, offsetX: 0, offsetY: 5.408, scale: 1, rotate: 0.193 }, { at: 0.7, opacity: 1, offsetX: 0, offsetY: 4.243, scale: 1, rotate: 0.152 }, { at: 0.8, opacity: 1, offsetX: 0, offsetY: 2.379, scale: 1, rotate: 0.085 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0.706, scale: 1, rotate: 0.025 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/careers/"
  }
}
