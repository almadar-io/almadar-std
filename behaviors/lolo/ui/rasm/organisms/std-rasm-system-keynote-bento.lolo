app std-rasm-system-keynote-bento [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-keynote-bento — the Keynote Bento design system for a Rasm page, anchored on Apple WWDC keynote bento slides (https://www.apple.com/apple-events/). Colour: #F5F5F7 ground, #1D1D1F ink, #0071E3 accent. Type: Plus Jakarta Sans over DM Sans. Grid: bento modular grid 4x3 with spans. Motion: the keynote easing (cubic-bezier 0.32,0.72,0.00,1.00); entrance: tiles scale up from 92% in a reading wave. Interaction: tile zooms 2% with a glossy sheen. Imagery: product renders on soft gradients. Voice: polished, benefit-first, short. Components: buttons are rounded 22px pills; cards are large-radius tiles. Data: big single numbers per tile. Sound: glass tap on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "keynote-bento"
    palette: {background: "#F5F5F7", foreground: "#1D1D1F", card: "#FBFBFB", "card-foreground": "#1D1D1F", surface: "#EFEFF1", muted: "#E4E4E6", "muted-foreground": "#626264", border: "#86868B", input: "#7C7C80", primary: "#0071E3", "primary-hover": "#0060C1", "primary-foreground": "#FFFFFF", secondary: "#FBFBFB", "secondary-foreground": "#1D1D1F", "secondary-hover": "#DBDBDD", accent: "#0071E3", "accent-foreground": "#FFFFFF", ring: "#0071E3", "series-1": "#0071E3", "series-2": "#0D4B8B", "series-3": "#6EACEC", "series-4": "#5E5E60", "series-5": "#4078B1"}
    fonts: { display: { family: "Plus Jakarta Sans", file: "https://almadar-kflow-assets.web.app/fonts/plusjakartasans/PlusJakartaSans%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "DM Sans", file: "https://almadar-kflow-assets.web.app/fonts/dmsans/DMSans%5Bopsz%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "stack/card/idle": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.07)", blur: 36, offsetX: 0, offsetY: 12 }, spring: { stiffness: 150, damping: 22 } },
        "stack/panel/idle": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.07)", blur: 36, offsetX: 0, offsetY: 12 }, spring: { stiffness: 150, damping: 22 } },
        "stack/well/idle": { fill: "surface", corners: { radius: [22, 22, 22, 22], kind: "round" }, inset: { stroke: "card", strokeWidth: 2, gap: 4 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [28, 28, 28, 28], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, backdrop: { blur: 24 } },
        "pulse/default/idle": { fill: "foreground", stroke: "card", strokeWidth: 2, textColor: "background", font: "600 13px body" },
        "pulse/hot/idle": { fill: "primary", stroke: "card", strokeWidth: 2, textColor: "primary-foreground", font: "600 13px body" },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 150, damping: 22 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 150, damping: 22 }, shadow: { color: "rgba(0,113,227,0.35)", blur: 22, offsetX: 0, offsetY: 8 }, inset: { stroke: "primary", strokeWidth: 1, gap: 2 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 220, damping: 24 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 150, damping: 22 }, stroke: "ring", strokeWidth: 3 },
        "pressable/secondary/idle": { fill: "muted", textColor: "secondary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 150, damping: 22 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 150, damping: 22 }, shadow: { color: "rgba(0,0,0,0.1)", blur: 20, offsetX: 0, offsetY: 7 } },
        "pressable/secondary/pressed": { fill: "muted", textColor: "secondary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 220, damping: 24 } },
        "pressable/secondary/focused": { fill: "muted", textColor: "secondary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "600 17px body", spring: { stiffness: 150, damping: 22 }, stroke: "ring", strokeWidth: 3 },
        "card/surface/idle": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.07)", blur: 36, offsetX: 0, offsetY: 12 }, spring: { stiffness: 150, damping: 22 } },
        "card/surface/hovered": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.14)", blur: 56, offsetX: 0, offsetY: 19 }, inset: { stroke: "background", strokeWidth: 2, gap: 2 }, spring: { stiffness: 150, damping: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.07)", blur: 36, offsetX: 0, offsetY: 12 }, spring: { stiffness: 150, damping: 22 } },
        "card/surface/pressed": { fill: "surface", corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.05)", blur: 14, offsetX: 0, offsetY: 5 }, spring: { stiffness: 220, damping: 24 } },
        "card/header/idle": { fill: "surface", corners: { radius: [28, 28, 0, 0], kind: "round" }, textColor: "foreground", font: "600 15px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [28, 28, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(0,0,0,0.07)", blur: 36, offsetX: 0, offsetY: 12 } },
        "panel/header/idle": { fill: "surface", corners: { radius: [28, 28, 0, 0], kind: "round" }, textColor: "foreground", font: "600 15px body" },
        "panel/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "section/band/idle": { fill: "background" },
        "section/rule/idle": { stroke: "muted", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "400 17px body" },
        "text/inverse/idle": { textColor: "foreground", font: "700 28px display", on: "section/band/idle" },
        "text/card/idle": { textColor: "card-foreground", font: "700 26px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "primary" },
        "text/display/idle": { textColor: "foreground", font: "700 76px display" },
        "text/title/idle": { textColor: "foreground", font: "700 44px display" },
        "text/eyebrow/idle": { textColor: "primary-hover", font: "600 14px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 19px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/label/idle": { textColor: "foreground", font: "500 15px body" },
        "ornament/signature/idle": { fill: "primary" },
        "surface/ground/idle": { fill: "background" }
      }
    layout: { hero: "split", columns: 4, asymmetry: 0, ornament: "none", align: "start", imageTreatment: "glow", sectionGap: 96, gutter: 20 }
    motion: { signature: "keynote", stiffness: 150, damping: 22, stagger: 70, enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 24, scale: 0.92, rotate: 0 }, { at: 0.1, opacity: 0.27, offsetX: 0, offsetY: 17.524, scale: 0.942, rotate: 0 }, { at: 0.2, opacity: 0.656, offsetX: 0, offsetY: 8.263, scale: 0.972, rotate: 0 }, { at: 0.3, opacity: 0.847, offsetX: 0, offsetY: 3.668, scale: 0.988, rotate: 0 }, { at: 0.4, opacity: 0.918, offsetX: 0, offsetY: 1.958, scale: 0.993, rotate: 0 }, { at: 0.5, opacity: 0.955, offsetX: 0, offsetY: 1.085, scale: 0.996, rotate: 0 }, { at: 0.6, opacity: 0.976, offsetX: 0, offsetY: 0.581, scale: 0.998, rotate: 0 }, { at: 0.7, opacity: 0.988, offsetX: 0, offsetY: 0.282, scale: 0.999, rotate: 0 }, { at: 0.8, opacity: 0.995, offsetX: 0, offsetY: 0.111, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.999, offsetX: 0, offsetY: 0.025, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/hr-self-service/"
  }
}
