app std-rasm-system-spectrum-flow [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-spectrum-flow — the Spectrum Flow design system for a Rasm page, anchored on Stripe.com gradient mesh header (2020) (https://stripe.com). Colour: #F6F9FC ground, #0A2540 ink, #635BFF accent. Type: Sora over Figtree. Grid: 12-column grid with a sticky 5-column chart rail. Motion: the silk easing (cubic-bezier 0.16,1.00,0.30,1.00); entrance: gradients flow in, then text rises softly. Interaction: gradient shifts hue under the pointer. Imagery: gradient mesh fields. Voice: ambitious, growth numbers, crisp. Components: buttons are gradient pills; cards are white glass with violet shadow. Data: smooth spline charts. Sound: silk swish on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "spectrum-flow"
    palette: {background: "#F6F9FC", foreground: "#0A2540", card: "#FBFCFE", "card-foreground": "#0A2540", surface: "#EFF3F6", muted: "#E3E8ED", "muted-foreground": "#56697C", border: "#8C9AA7", input: "#808F9E", primary: "#635BFF", "primary-hover": "#544DD9", "primary-foreground": "#F6F9FC", secondary: "#FBFCFE", "secondary-foreground": "#0A2540", "secondary-hover": "#DAE0E5", accent: "#635BFF", "accent-foreground": "#F6F9FC", ring: "#635BFF", "series-1": "#635BFF", "series-2": "#3B43A9", "series-3": "#A5A2FE", "series-4": "#516578", "series-5": "#716DBF"}
    fonts: { display: { family: "Sora", file: "https://almadar-kflow-assets.web.app/fonts/sora/Sora%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Figtree", file: "https://almadar-kflow-assets.web.app/fonts/figtree/Figtree%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn pr_pal(t: f32) -> vec3<f32> { return vec3<f32>(0.5, 0.5, 0.5) + vec3<f32>(0.5, 0.5, 0.5) * cos(6.28318 * (vec3<f32>(1.0, 1.0, 1.0) * t + vec3<f32>(0.0, 0.33, 0.67))); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0));\n  let o = vec2<f32>(0.34 + (p.x - 0.5) * 0.04, 0.46 - px.scroll * 0.1);\n  let d = (px.uv - o) * vec2<f32>(asp, 1.0);\n  let ang = atan2(d.y, d.x);\n  let along = clamp(d.x * 1.4, 0.0, 1.0);\n  let fan = smoothstep(-0.05, 0.0, d.x) * smoothstep(0.55, 0.1, abs(ang - 0.18 - sin(px.time * 0.1) * 0.02));\n  let spec = pr_pal(ang * 1.8 + px.time * 0.03);\n  let incoming = exp(-abs(d.y + d.x * 0.35) * 110.0) * step(d.x, 0.0) * 0.5;\n  var col = mix(px.color.rgb, spec, fan * along * 0.13);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * incoming * 0.05;\n  col = mix(col, vec3<f32>(0.55, 0.4, 0.95), exp(-length(d) * 3.0) * 0.05);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", corners: { radius: [18, 18, 18, 18], kind: "round" }, stroke: "border", strokeWidth: 1, shadow: { color: "rgba(109,63,214,0.16)", blur: 40, offsetX: 0, offsetY: 16 } },
        "stack/panel/idle": { fill: "card", corners: { radius: [18, 18, 18, 18], kind: "round" }, stroke: "border", strokeWidth: 1, shadow: { color: "rgba(109,63,214,0.18)", blur: 48, offsetX: 0, offsetY: 20 } },
        "text/numeral/idle": { textColor: "primary", font: "800 120px display" },
        "stack/hero/idle": { fill: "background", corners: { radius: [14, 14, 14, 14], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 120, damping: 20 }, shadow: { color: "rgba(109,63,214,0.35)", blur: 22 } },
        "pressable/primary/hovered": { fill: "primary-hover", corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 120, damping: 20 }, shadow: { color: "rgba(109,63,214,0.35)", blur: 22 } },
        "pressable/primary/pressed": { fill: "primary-hover", corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 120, damping: 20 } },
        "text/display/idle": { textColor: "foreground", font: "800 80px display", spring: { stiffness: 120, damping: 20 } },
        "text/title/idle": { textColor: "foreground", font: "600 38px display", spring: { stiffness: 120, damping: 20 } },
        "text/eyebrow/idle": { textColor: "primary", font: "700 13px body", spring: { stiffness: 120, damping: 20 } },
        "text/body/idle": { textColor: "muted-foreground", font: "400 17px body", spring: { stiffness: 120, damping: 20 } },
        "text/card/idle": { textColor: "card-foreground", font: "600 21px display" },
        "card/surface/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(15,23,42,0.07)", blur: 24, offsetY: 8 }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/hovered": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(109,63,214,0.16)", blur: 32, offsetY: 12 }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(109,63,214,0.16)", blur: 32, offsetY: 12 }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/pressed": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(15,23,42,0.05)", blur: 8, offsetY: 2 }, spring: { stiffness: 200, damping: 24 } },
        "card/header/idle": { fill: "muted", corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "foreground", font: "700 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [12, 12, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(15,23,42,0.06)", blur: 24, offsetY: 8 } },
        "panel/header/idle": { fill: "secondary", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "secondary-foreground", font: "700 14px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "card" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 9 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "input", strokeWidth: 1.5 },
        "textfield/default/hovered": { fill: "card", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "foreground", strokeWidth: 1.5 },
        "textfield/default/focused": { fill: "card", corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "ring", strokeWidth: 3 },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "500 16px body" },
        "morph/default/idle": { fill: "accent" },
        "morph/crm/idle": { stroke: "series-1", strokeWidth: 3.5 },
        "morph/bill/idle": { stroke: "series-2", strokeWidth: 3.5 },
        "morph/use/idle": { stroke: "series-3", strokeWidth: 3.5 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_tri(p: vec2<f32>, r: f32) -> f32 { return max(p.y - 0.5 * r, max(dot(p, vec2<f32>(0.866, -0.5)), dot(p, vec2<f32>(-0.866, -0.5))) - 0.5 * r); }\nfn sg_rainbow(t: f32) -> vec3<f32> { return vec3<f32>(0.5, 0.5, 0.5) + vec3<f32>(0.5, 0.5, 0.5) * cos(6.28318 * (vec3<f32>(t, t, t) + vec3<f32>(0.0, 0.33, 0.67))); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet pc = vec2<f32>(s.x * 0.28, c.y);\nlet r = m * 0.38;\nlet outline = sg_line(sg_tri(p - pc, r), 1.4);\nlet x0 = pc.x + r * 0.4;\nlet t = clamp((p.x - x0) / max(s.x - x0, 1.0), 0.0, 1.0);\nlet hgt = m * 0.04 + m * 0.4 * t;\nlet u = (p.y - c.y) / max(hgt, 1.0);\nlet inside = (1.0 - smoothstep(0.97, 1.0, abs(u))) * step(x0, p.x);\nlet beam = sg_line(p.y - c.y, 0.7) * step(p.x, pc.x - r * 0.1) * step(8.0, p.x);\nlet col = mix(px.color.rgb, sg_rainbow(u * 0.4 + 0.4), inside);\nreturn sg_out(px, col, max(max(outline, beam), inside * 0.85));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.15, ornament: "none", align: "start", imageTreatment: "glow", sectionGap: 120, gutter: 48 }
    motion: { signature: "silk", stiffness: 120, damping: 20, stagger: 90, enterMs: 411, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 12, scale: 0.94, rotate: 2 }, { at: 0.1, opacity: 0.494, offsetX: 0, offsetY: 6.067, scale: 0.97, rotate: 1.011 }, { at: 0.2, opacity: 0.752, offsetX: 0, offsetY: 2.974, scale: 0.985, rotate: 0.496 }, { at: 0.3, opacity: 0.877, offsetX: 0, offsetY: 1.474, scale: 0.993, rotate: 0.246 }, { at: 0.4, opacity: 0.94, offsetX: 0, offsetY: 0.723, scale: 0.996, rotate: 0.12 }, { at: 0.5, opacity: 0.972, offsetX: 0, offsetY: 0.339, scale: 0.998, rotate: 0.056 }, { at: 0.6, opacity: 0.988, offsetX: 0, offsetY: 0.144, scale: 0.999, rotate: 0.024 }, { at: 0.7, opacity: 0.996, offsetX: 0, offsetY: 0.052, scale: 1, rotate: 0.009 }, { at: 0.8, opacity: 0.999, offsetX: 0, offsetY: 0.013, scale: 1, rotate: 0.002 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0.001, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/lead-capture/"
  }
}
