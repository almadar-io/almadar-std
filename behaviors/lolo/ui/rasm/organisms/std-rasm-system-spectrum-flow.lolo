app std-rasm-system-spectrum-flow [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-spectrum-flow — the Spectrum Flow design system for a Rasm page, anchored on Stripe.com gradient mesh header (2020) (https://stripe.com). Colour: #F6F9FC ground, #0A2540 ink, #635BFF accent. Type: Sora over Figtree. Grid: 12-column grid with a sticky 5-column chart rail. Motion: the silk easing (cubic-bezier 0.16,1.00,0.30,1.00); entrance: gradients flow in, then text rises softly. Interaction: gradient shifts hue under the pointer. Imagery: gradient mesh fields. Voice: ambitious, growth numbers, crisp. Components: buttons are gradient pills; cards are white glass with violet shadow. Data: smooth spline charts. Sound: silk swish on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "spectrum-flow"
    palette: {background: "#F6F9FC", foreground: "#0A2540", card: "#FBFCFE", "card-foreground": "#0A2540", surface: "#EFF3F6", muted: "#E3E8ED", "muted-foreground": "#56697C", border: "#8C9AA7", input: "#808F9E", primary: "#635BFF", "primary-hover": "#544DD9", "primary-foreground": "#F6F9FC", secondary: "#FBFCFE", "secondary-foreground": "#0A2540", "secondary-hover": "#DAE0E5", accent: "#635BFF", "accent-foreground": "#F6F9FC", ring: "#635BFF", "series-1": "#635BFF", "series-2": "#3B43A9", "series-3": "#A5A2FE", "series-4": "#516578", "series-5": "#716DBF"}
    fonts: { display: { family: "Sora", file: "https://almadar-kflow-assets.web.app/fonts/sora/Sora%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Figtree", file: "https://almadar-kflow-assets.web.app/fonts/figtree/Figtree%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn pr_pal(t: f32) -> vec3<f32> { return vec3<f32>(0.5, 0.5, 0.5) + vec3<f32>(0.5, 0.5, 0.5) * cos(6.28318 * (vec3<f32>(1.0, 1.0, 1.0) * t + vec3<f32>(0.0, 0.33, 0.67))); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0));\n  let o = vec2<f32>(0.34 + (p.x - 0.5) * 0.04, 0.46 - px.scroll * 0.1);\n  let d = (px.uv - o) * vec2<f32>(asp, 1.0);\n  let ang = atan2(d.y, d.x);\n  let along = clamp(d.x * 1.4, 0.0, 1.0);\n  let fan = smoothstep(-0.05, 0.0, d.x) * smoothstep(0.55, 0.1, abs(ang - 0.18 - sin(px.time * 0.1) * 0.02));\n  let spec = pr_pal(ang * 1.8 + px.time * 0.03);\n  let incoming = exp(-abs(d.y + d.x * 0.35) * 110.0) * step(d.x, 0.0) * 0.5;\n  var col = mix(px.color.rgb, spec, fan * along * 0.13);\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * incoming * 0.05;\n  col = mix(col, vec3<f32>(0.55, 0.4, 0.95), exp(-length(d) * 3.0) * 0.05);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [22, 22, 22, 22], kind: "round" }, backdrop: { blur: 20, tint: "card", saturate: 1.4 }, shadow: { color: "rgba(99,91,255,0.18)", blur: 44, offsetX: 0, offsetY: 20 } },
        "stack/panel/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, backdrop: { blur: 20, tint: "card", saturate: 1.4 }, shadow: { color: "rgba(99,91,255,0.20)", blur: 56, offsetX: 0, offsetY: 26 } },
        "text/numeral/idle": { textColor: "foreground", font: "700 96px display" },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, backdrop: { blur: 20, tint: "card", saturate: 1.4 } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0)); let t = clamp(px.uv.x * 0.7 + p.x * 0.3, 0.0, 1.0); let a = vec3<f32>(0.388, 0.357, 1.0); let b = vec3<f32>(0.60, 0.22, 0.80); return vec4<f32>(mix(a, b, t), px.color.a); }", params: [0, 0, 0, 0], live: true }, shadow: { color: "rgba(99,91,255,0.40)", blur: 22, offsetX: 0, offsetY: 10 }, spring: { stiffness: 120, damping: 20 } },
        "pressable/primary/hovered": { fill: "primary-hover", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0)); let t = clamp(px.uv.x * 0.7 + p.x * 0.3, 0.0, 1.0); let a = vec3<f32>(0.45, 0.25, 0.95); let b = vec3<f32>(0.66, 0.22, 0.60); return vec4<f32>(mix(a, b, t), px.color.a); }", params: [0, 0, 0, 0], live: true }, shadow: { color: "rgba(99,91,255,0.50)", blur: 32, offsetX: 0, offsetY: 14 }, spring: { stiffness: 120, damping: 20 } },
        "pressable/primary/pressed": { fill: "primary-hover", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0)); let t = clamp(px.uv.x * 0.7 + p.x * 0.3, 0.0, 1.0); let a = vec3<f32>(0.30, 0.28, 0.85); let b = vec3<f32>(0.50, 0.18, 0.60); return vec4<f32>(mix(a, b, t), px.color.a); }", params: [0, 0, 0, 0], live: true }, shadow: { color: "rgba(99,91,255,0.30)", blur: 12, offsetX: 0, offsetY: 4 }, spring: { stiffness: 220, damping: 26 } },
        "pressable/secondary/idle": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "600 15px body", shadow: { color: "rgba(99,91,255,0.12)", blur: 16, offsetX: 0, offsetY: 6 }, spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "primary", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "600 15px body", shadow: { color: "rgba(99,91,255,0.22)", blur: 26, offsetX: 0, offsetY: 10 }, spring: { stiffness: 120, damping: 20 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0)); let t = clamp(px.uv.x * 0.7 + p.x * 0.3, 0.0, 1.0); let a = vec3<f32>(0.388, 0.357, 1.0); let b = vec3<f32>(0.60, 0.22, 0.80); return vec4<f32>(mix(a, b, t), px.color.a); }", params: [0, 0, 0, 0], live: true }, spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "600 15px body", spring: { stiffness: 120, damping: 20 } },
        "text/display/idle": { textColor: "foreground", font: "700 72px display" },
        "text/title/idle": { textColor: "foreground", font: "700 40px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 13px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 20px display", on: "card/surface/idle" },
        "card/surface/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" }, backdrop: { blur: 20, tint: "card", saturate: 1.4 }, shadow: { color: "rgba(99,91,255,0.16)", blur: 40, offsetX: 0, offsetY: 18 }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" }, backdrop: { blur: 20, tint: "card", saturate: 1.4 }, shadow: { color: "rgba(99,91,255,0.28)", blur: 56, offsetX: 0, offsetY: 26 }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [20, 20, 20, 20], kind: "round" }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" }, shadow: { color: "rgba(99,91,255,0.14)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 220, damping: 26 } },
        "card/header/idle": { fill: "surface", corners: { radius: [20, 20, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [20, 20, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, backdrop: { blur: 20, tint: "card", saturate: 1.4 }, shadow: { color: "rgba(99,91,255,0.20)", blur: 56, offsetX: 0, offsetY: 26 } },
        "panel/header/idle": { fill: "surface", corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "section/band/idle": { fill: "background" },
        "section/rule/idle": { stroke: "muted", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "foreground", font: "400 16px body", shadow: { color: "rgba(99,91,255,0.08)", blur: 12, offsetX: 0, offsetY: 4 }, spring: { stiffness: 120, damping: 20 } },
        "textfield/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "foreground", font: "400 16px body", shadow: { color: "rgba(99,91,255,0.16)", blur: 18, offsetX: 0, offsetY: 6 }, spring: { stiffness: 120, damping: 20 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "round" }, textColor: "foreground", font: "400 16px body", shadow: { color: "rgba(99,91,255,0.22)", blur: 22, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 20 } },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "500 16px body" },
        "mirror/primary/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(99,91,255,0.20)", blur: 56, offsetX: 0, offsetY: 26 } },
        "morph/default/idle": { fill: "accent" },
        "morph/crm/idle": { stroke: "series-1", strokeWidth: 3 },
        "morph/bill/idle": { stroke: "series-2", strokeWidth: 3 },
        "morph/use/idle": { stroke: "series-3", strokeWidth: 3 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_tri(p: vec2<f32>, r: f32) -> f32 { return max(p.y - 0.5 * r, max(dot(p, vec2<f32>(0.866, -0.5)), dot(p, vec2<f32>(-0.866, -0.5))) - 0.5 * r); }\nfn sg_rainbow(t: f32) -> vec3<f32> { return vec3<f32>(0.5, 0.5, 0.5) + vec3<f32>(0.5, 0.5, 0.5) * cos(6.28318 * (vec3<f32>(t, t, t) + vec3<f32>(0.0, 0.33, 0.67))); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet pc = vec2<f32>(s.x * 0.28, c.y);\nlet r = m * 0.38;\nlet outline = sg_line(sg_tri(p - pc, r), 1.4);\nlet x0 = pc.x + r * 0.4;\nlet t = clamp((p.x - x0) / max(s.x - x0, 1.0), 0.0, 1.0);\nlet hgt = m * 0.04 + m * 0.4 * t;\nlet u = (p.y - c.y) / max(hgt, 1.0);\nlet inside = (1.0 - smoothstep(0.97, 1.0, abs(u))) * step(x0, p.x);\nlet beam = sg_line(p.y - c.y, 0.7) * step(p.x, pc.x - r * 0.1) * step(8.0, p.x);\nlet col = mix(px.color.rgb, sg_rainbow(u * 0.4 + 0.4), inside);\nreturn sg_out(px, col, max(max(outline, beam), inside * 0.85));\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/circle/idle": { fill: "primary", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let c = px.size * 0.5; let d = length((px.local - c) / (min(px.size.x, px.size.y) * 0.5)); let a = (1.0 - smoothstep(0.0, 1.0, d)) * 0.55; let t = clamp(px.uv.x * 0.8 + px.uv.y * 0.5, 0.0, 1.0); let col = mix(vec3<f32>(0.388, 0.357, 1.0), vec3<f32>(0.0, 0.7, 0.95), t); return vec4<f32>(col, a * px.color.a); }", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.3, ornament: "none", align: "start", imageTreatment: "glow", sectionGap: 128, gutter: 40 }
    motion: { signature: "silk", stiffness: 120, damping: 20, stagger: 90, enterMs: 820, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 26, scale: 0.985, rotate: 0 }, { at: 0.1, opacity: 0.494, offsetX: 0, offsetY: 13.146, scale: 0.992, rotate: 0 }, { at: 0.2, opacity: 0.752, offsetX: 0, offsetY: 6.445, scale: 0.996, rotate: 0 }, { at: 0.3, opacity: 0.877, offsetX: 0, offsetY: 3.193, scale: 0.998, rotate: 0 }, { at: 0.4, opacity: 0.94, offsetX: 0, offsetY: 1.566, scale: 0.999, rotate: 0 }, { at: 0.5, opacity: 0.972, offsetX: 0, offsetY: 0.734, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.988, offsetX: 0, offsetY: 0.313, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.996, offsetX: 0, offsetY: 0.112, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.999, offsetX: 0, offsetY: 0.029, scale: 1, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0.003, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/lead-capture/"
  }
}
