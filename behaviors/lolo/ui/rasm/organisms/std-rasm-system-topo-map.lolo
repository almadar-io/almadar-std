app std-rasm-system-topo-map [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-topo-map — the Topo Map design system for a Rasm page, anchored on swisstopo national maps (Eduard Imhof relief shading) (https://www.swisstopo.admin.ch). Colour: #F1EEE3 ground, #2E2A24 ink, #E4572E accent. Type: Big Shoulders Display over Mulish. Grid: map coordinate grid (graticule) with pins. Motion: the pan easing (cubic-bezier 0.25,0.46,0.45,0.94); entrance: map pans into place, then pins drop. Interaction: pin grows and shows its label. Imagery: relief shading and contour lines. Voice: local, specific places, neighbourly. Components: buttons are map pins and legend chips; cards are map callouts. Data: contour heat maps. Sound: map pin drop on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "topo-map"
    palette: { background: "#F1EEE3", foreground: "#2E2A24", card: "#FBF9F3", "card-foreground": "#2E2A24", surface: "#E9E4D4", muted: "#DDD8C6", "muted-foreground": "#58544A", border: "#8A8576", input: "#7F7A6C", primary: "#E4572E", "primary-hover": "#F07A4B", "primary-foreground": "#120F0B", secondary: "#FBF9F3", "secondary-foreground": "#2E2A24", "secondary-hover": "#F3E4C2", accent: "#E4572E", "accent-foreground": "#120F0B", ring: "#2E2A24", "series-1": "#E4572E", "series-2": "#9A4F24", "series-3": "#7A8F5A", "series-4": "#5E8CA8", "series-5": "#C9B98F" }
    fonts: { display: { family: "Big Shoulders Display", file: "https://almadar-kflow-assets.web.app/fonts/bigshouldersdisplay/BigShouldersDisplay%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Mulish", file: "https://almadar-kflow-assets.web.app/fonts/mulish/Mulish%5Bwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Mulish", file: "https://almadar-kflow-assets.web.app/fonts/mulish/Mulish%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn hsh(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn vn(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(hsh(i), hsh(i + vec2<f32>(1.0, 0.0)), u.x), mix(hsh(i + vec2<f32>(0.0, 1.0)), hsh(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn ht(p: vec2<f32>) -> f32 { return 0.6 * vn(p / 300.0) + 0.3 * vn(p / 120.0) + 0.1 * vn(p / 48.0); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let e = 4.0;\n  let dx = ht(p + vec2<f32>(e, 0.0)) - ht(p - vec2<f32>(e, 0.0));\n  let dy = ht(p + vec2<f32>(0.0, e)) - ht(p - vec2<f32>(0.0, e));\n  let s = (dx + dy) * 3.2;\n  let h = ht(p);\n  let gm = length(vec2<f32>(dx, dy)) / (2.0 * e) + 0.00001;\n  let n = 22.0;\n  let t = abs(fract(h * n) - 0.5);\n  let cd = (0.5 - t) / (n * gm);\n  let cl = 1.0 - smoothstep(0.5, 1.3, cd);\n  let ti = abs(fract(h * n / 5.0) - 0.5);\n  let ci = 1.0 - smoothstep(0.5, 1.6, (0.5 - ti) / (n * gm / 5.0));\n  var col = px.color.rgb + vec3<f32>(0.05, 0.045, 0.02) * max(s, 0.0) * 4.0 - vec3<f32>(0.05, 0.04, 0.02) * max(-s, 0.0) * 4.0;\n  col = mix(col, vec3<f32>(0.6, 0.35, 0.18), cl * 0.2 + ci * 0.18);\n  let gx = fract(p.x / 160.0) * 160.0;\n  let gy = fract(p.y / 160.0) * 160.0;\n  let g = max(1.0 - smoothstep(0.4, 1.2, min(gx, 160.0 - gx)), 1.0 - smoothstep(0.4, 1.2, min(gy, 160.0 - gy)));\n  col = mix(col, vec3<f32>(0.18, 0.16, 0.14), g * 0.2);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 14, offsetX: 2, offsetY: 6 }, spring: { stiffness: 200, damping: 20 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 14, offsetX: 2, offsetY: 6 }, spring: { stiffness: 200, damping: 20 } },
        "stack/hero/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [22, 22, 22, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 22, offsetX: 3, offsetY: 10 } },
        "stack/bar/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "text/poster/idle": { textColor: "foreground", font: "800 160px display" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 14, offsetX: 2, offsetY: 6 }, spring: { stiffness: 200, damping: 20 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 24, offsetX: 3, offsetY: 14 }, spring: { stiffness: 240, damping: 13 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 14, offsetX: 2, offsetY: 6 }, spring: { stiffness: 200, damping: 20 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 4, offsetX: 0, offsetY: 1 }, spring: { stiffness: 240, damping: 13 } },
        "card/header/idle": { fill: "surface", textColor: "foreground", font: "800 24px display", corners: { radius: [14, 14, 0, 0], kind: "round" }, on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [1, 5] },
        "card/media/idle": { fill: "muted", corners: { radius: [14, 14, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, shadow: { color: "rgba(46,42,36,0.26)", blur: 14, offsetX: 2, offsetY: 6 }, spring: { stiffness: 200, damping: 20 } },
        "panel/header/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 0, 0], kind: "round" }, textColor: "foreground", font: "800 22px display", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [1, 5] },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1 },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1, strokeDash: [1, 5] },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 1.5, fill: "" },
        "focus/ring/outer": { stroke: "card", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [26, 26, 26, 3], kind: "round" }, font: "700 20px display", shadow: { color: "rgba(46,42,36,0.26)", blur: 10, offsetX: 0, offsetY: 6 }, spring: { stiffness: 240, damping: 13 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [26, 26, 26, 3], kind: "round" }, font: "700 20px display", shadow: { color: "rgba(46,42,36,0.26)", blur: 20, offsetX: 0, offsetY: 12 }, spring: { stiffness: 240, damping: 13 } },
        "pressable/primary/pressed": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [26, 26, 26, 3], kind: "round" }, font: "700 20px display", shadow: { color: "rgba(46,42,36,0.26)", blur: 3, offsetX: 0, offsetY: 1 }, spring: { stiffness: 240, damping: 13 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [26, 26, 26, 3], kind: "round" }, font: "700 20px display", shadow: { color: "rgba(46,42,36,0.26)", blur: 10, offsetX: 0, offsetY: 6 }, spring: { stiffness: 240, damping: 13 } },
        "pressable/secondary/idle": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px display", spring: { stiffness: 200, damping: 20 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px display", spring: { stiffness: 200, damping: 20 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px display", spring: { stiffness: 200, damping: 20 } },
        "pressable/secondary/focused": { fill: "secondary", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px display", spring: { stiffness: 200, damping: 20 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "muted-foreground", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 18px display", spring: { stiffness: 200, damping: 20 }, strokeDash: [2, 3] },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [12, 12, 12, 0], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/hovered": { fill: "surface", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [12, 12, 12, 0], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 0], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "400 17px body" },
        "text/display/idle": { textColor: "foreground", font: "800 88px display" },
        "text/title/idle": { textColor: "foreground", font: "800 38px display" },
        "text/eyebrow/idle": { textColor: "series-2", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "800 24px display", on: "card/surface/idle" },
        "text/label/idle": { textColor: "foreground", font: "700 13px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px body" },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 1.5 },
        "image/none/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1.25, corners: { radius: [14, 14, 14, 0], kind: "round" }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn shade(px: Pixel) -> vec4<f32> { return im_px(px, vec2<f32>(0.0, 0.0)) * px.color.a; }\n", params: [0, 0, 0, 0], live: false } },
        "ornament/rule/idle": { fill: "foreground", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let y = abs(px.local.y - px.size.y * 0.5);\n  let line = 1.0 - smoothstep(0.5, 1.5, y);\n  let tx = abs(fract(px.local.x / 16.0) * 16.0 - 8.0);\n  let tick = (1.0 - smoothstep(0.5, 1.5, tx)) * (1.0 - smoothstep(3.0, 5.0, y));\n  return vec4<f32>(px.color.rgb, px.color.a * max(line, tick));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "full-bleed", columns: 12, asymmetry: 0.35, ornament: "frame", align: "start", imageTreatment: "engraving", sectionGap: 80, gutter: 24 }
    motion: { signature: "pan", stiffness: 240, damping: 13, stagger: 120, enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: -48, offsetY: 18, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.187, offsetX: -39.012, offsetY: 14.63, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.369, offsetX: -30.274, offsetY: 11.353, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.531, offsetX: -22.509, offsetY: 8.441, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.665, offsetX: -16.071, offsetY: 6.026, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.771, offsetX: -10.976, offsetY: 4.116, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.853, offsetX: -7.079, offsetY: 2.654, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.913, offsetX: -4.19, offsetY: 1.571, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.955, offsetX: -2.139, offsetY: 0.802, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.984, offsetX: -0.78, offsetY: 0.293, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/listings/"
  }
}
