app std-rasm-system-topo-map [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-topo-map — the Topo Map design system for a Rasm page, anchored on swisstopo national maps (Eduard Imhof relief shading) (https://www.swisstopo.admin.ch). Colour: #F1EEE3 ground, #2E2A24 ink, #E4572E accent. Type: Big Shoulders Display over Mulish. Grid: map coordinate grid (graticule) with pins. Motion: the pan easing (cubic-bezier 0.25,0.46,0.45,0.94); entrance: map pans into place, then pins drop. Interaction: pin grows and shows its label. Imagery: relief shading and contour lines. Voice: local, specific places, neighbourly. Components: buttons are map pins and legend chips; cards are map callouts. Data: contour heat maps. Sound: map pin drop on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "topo-map"
    palette: {background: "#F1EEE3", foreground: "#2E2A24", card: "#F9F7F2", "card-foreground": "#2E2A24", surface: "#EBE8DD", muted: "#E1DED4", "muted-foreground": "#6C6961", border: "#99968D", input: "#908C84", primary: "#E4572E", "primary-hover": "#C24A27", "primary-foreground": "#2E2A24", secondary: "#F9F7F2", "secondary-foreground": "#2E2A24", "secondary-hover": "#DAD6CC", accent: "#E4572E", "accent-foreground": "#2E2A24", ring: "#E4572E", "series-1": "#E4572E", "series-2": "#92432A", "series-3": "#EA9B7F", "series-4": "#69655D", "series-5": "#B26B57"}
    fonts: { display: { family: "Big Shoulders Display", file: "https://almadar-kflow-assets.web.app/fonts/bigshouldersdisplay/BigShouldersDisplay%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Mulish", file: "https://almadar-kflow-assets.web.app/fonts/mulish/Mulish%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn np_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(12.9898, 78.233))) * 43758.5453); } fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let r = vec2<f32>((p.x + p.y) * 0.7071, (p.y - p.x) * 0.7071); let q = fract(r / 8.0) - 0.5; let id = floor(r / 8.0); let big = 0.5 + 0.5 * sin(id.x * 0.07 + px.time * 0.05) * sin(id.y * 0.06); let rad = 0.1 + 0.3 * big * (1.0 - px.uv.y * 0.6); let dt = 1.0 - smoothstep(rad - 0.07, rad + 0.07, length(q)); var d = dt * 0.07; let cw = px.size.x / 4.0; let fx = fract(p.x / cw); let dl = min(fx, 1.0 - fx) * cw; d = d + (1.0 - smoothstep(0.4, 1.0, dl)) * 0.07 + (1.0 - smoothstep(0.4, 1.0, abs(dl - 4.0))) * 0.045; d = d + (np_h(floor(p)) - 0.5) * 0.04; let tint = mix(vec3<f32>(1.0), vec3<f32>(1.0, 0.975, 0.9), 0.5 * (1.0 - px.uv.y)); return vec4<f32>(px.color.rgb * tint + vec3<f32>(s * d), px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(24,18,10,0.16)", blur: 26, offsetX: 0, offsetY: 10 } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(24,18,10,0.16)", blur: 26, offsetX: 0, offsetY: 10 } },
        "text/poster/idle": { textColor: "foreground", font: "900 168px display" },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "800 15px body", spring: { stiffness: 260, damping: 28 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "800 15px body", spring: { stiffness: 260, damping: 28 } },
        "pressable/primary/pressed": { fill: "foreground", textColor: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "800 15px body", spring: { stiffness: 320, damping: 30 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, textColor: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "700 15px body", spring: { stiffness: 260, damping: 28 } },
        "pressable/secondary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 3, textColor: "background", corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "700 15px body", spring: { stiffness: 260, damping: 28 } },
        "text/display/idle": { textColor: "foreground", font: "900 80px display" },
        "text/title/idle": { textColor: "foreground", font: "800 34px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "700 13px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "800 24px display" },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "800 15px body", spring: { stiffness: 260, damping: 28 } },
        "pressable/secondary/focused": { fill: "background", textColor: "foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "700 15px body", spring: { stiffness: 260, damping: 28 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(24,18,10,0.14)", blur: 22, offsetX: 0, offsetY: 8 }, spring: { stiffness: 260, damping: 28 } },
        "card/surface/hovered": { fill: "card", stroke: "accent", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(24,18,10,0.24)", blur: 32, offsetX: 0, offsetY: 14 }, spring: { stiffness: 260, damping: 28 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 260, damping: 28 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 320, damping: 30 } },
        "card/header/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "800 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 1 },
        "card/media/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "800 13px body" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 1 },
        "section/band/idle": { fill: "muted" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 17px body", stroke: "input", strokeWidth: 1.5 },
        "textfield/default/hovered": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 17px body", stroke: "input", strokeWidth: 2 },
        "textfield/default/focused": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 17px body", stroke: "ring", strokeWidth: 3 },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 17px body" },
        "morph/default/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 2 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn sg_halftone(p: vec2<f32>, cell: f32, ang: f32, rad: f32) -> f32 { let q = sg_rot(p, ang) / cell; let c = fract(q) - vec2<f32>(0.5, 0.5); return (1.0 - smoothstep(rad - 0.08, rad + 0.08, length(c))) * step(0.03, rad); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet top = max(sg_line(p.y - 5.0, 2.0), sg_line(p.y - 11.0, 0.5));\nlet gut = sg_line(p.x - s.x * 0.5, 0.5) * step(fract(p.y / 6.0), 0.5) * step(16.0, p.y);\nlet ht = sg_halftone(p, 7.0, 0.7854, 0.5 * (1.0 - px.uv.y)) * step(p.x, s.x * 0.28) * step(20.0, p.y);\nreturn sg_out(px, px.color.rgb, max(max(top, gut), ht));\n}\n", params: [0, 0, 0, 0], live: false } },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 0.75 }
      }
    layout: { hero: "editorial", columns: 12, asymmetry: 0.1, ornament: "double-rule", align: "start", imageTreatment: "halftone", sectionGap: 72, gutter: 28 }
    motion: { signature: "pan", stiffness: 260, damping: 28, stagger: 40, enterMs: 508, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 22, scale: 1.04, rotate: 0 }, { at: 0.1, opacity: 0.187, offsetX: 0, offsetY: 17.881, scale: 1.033, rotate: 0 }, { at: 0.2, opacity: 0.369, offsetX: 0, offsetY: 13.876, scale: 1.025, rotate: 0 }, { at: 0.3, opacity: 0.531, offsetX: 0, offsetY: 10.317, scale: 1.019, rotate: 0 }, { at: 0.4, opacity: 0.665, offsetX: 0, offsetY: 7.366, scale: 1.013, rotate: 0 }, { at: 0.5, opacity: 0.771, offsetX: 0, offsetY: 5.031, scale: 1.009, rotate: 0 }, { at: 0.6, opacity: 0.853, offsetX: 0, offsetY: 3.244, scale: 1.006, rotate: 0 }, { at: 0.7, opacity: 0.913, offsetX: 0, offsetY: 1.92, scale: 1.003, rotate: 0 }, { at: 0.8, opacity: 0.955, offsetX: 0, offsetY: 0.98, scale: 1.002, rotate: 0 }, { at: 0.9, opacity: 0.984, offsetX: 0, offsetY: 0.358, scale: 1.001, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/listings/"
  }
}
