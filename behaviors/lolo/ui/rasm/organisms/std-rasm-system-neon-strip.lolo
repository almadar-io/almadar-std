app std-rasm-system-neon-strip [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-neon-strip — the Neon Strip design system for a Rasm page, anchored on Las Vegas Strip neon signs (Young Electric Sign Company) and Tokyo Shibuya at night (https://en.wikipedia.org/wiki/Neon_Museum). Colour: #0A0614 ground, #F8E9FF ink, #FF2BD6 accent. Type: Monoton over Chakra Petch. Grid: overlapping layered grid, 3 depth planes. Motion: the neon-flicker easing (cubic-bezier 0.10,0.90,0.20,1.00); entrance: signs flicker on with two failed sparks. Interaction: glow intensifies and buzzes. Imagery: neon tube glow on night photos. Voice: loud, nightlife, short bursts. Components: buttons are tube outlines; cards are light boxes. Data: glowing line charts. Sound: neon buzz on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "neon-strip"
    palette: {background: "#0A0614", foreground: "#F8E9FF", card: "#181422", "card-foreground": "#F8E9FF", surface: "#110D1B", muted: "#1D1827", "muted-foreground": "#ACA0B4", border: "#756C7E", input: "#81788A", primary: "#FF2BD6", "primary-hover": "#FF4BDC", "primary-foreground": "#0A0614", secondary: "#181422", "secondary-foreground": "#F8E9FF", "secondary-hover": "#272130", accent: "#FF2BD6", "accent-foreground": "#0A0614", ring: "#FF2BD6", "series-1": "#FF2BD6", "series-2": "#FC81E8", "series-3": "#911A7F", "series-4": "#B1A5B9", "series-5": "#BF55AB"}
    fonts: { display: { family: "Monoton", file: "https://almadar-kflow-assets.web.app/fonts/monoton/Monoton-Regular.ttf", generic: "monospace" }, body: { family: "Chakra Petch", file: "https://almadar-kflow-assets.web.app/fonts/chakrapetch/ChakraPetch-Regular.ttf", generic: "sans-serif" }, mono: { family: "Monoton", file: "https://almadar-kflow-assets.web.app/fonts/monoton/Monoton-Regular.ttf", generic: "monospace" } }
    looks: {
        "card/surface/idle": { fill: "card", stroke: "accent", strokeWidth: 2.5, inset: { stroke: "#2BE8FF", strokeWidth: 1.5, gap: 6 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.5)", blur: 22, offsetX: 0, offsetY: 0 }, spring: { stiffness: 160, damping: 14 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "accent", strokeWidth: 2, gap: 6 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.95)", blur: 46, offsetX: 0, offsetY: 0 }, spring: { stiffness: 380, damping: 7 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "foreground", strokeWidth: 2, gap: 6 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.6)", blur: 26, offsetX: 0, offsetY: 0 }, spring: { stiffness: 160, damping: 14 } },
        "card/surface/pressed": { fill: "surface", stroke: "accent", strokeWidth: 3, inset: { stroke: "#2BE8FF", strokeWidth: 2, gap: 5 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.4)", blur: 12, offsetX: 0, offsetY: 0 }, spring: { stiffness: 440, damping: 12 } },
        "card/header/idle": { fill: "muted", stroke: "#2BE8FF", strokeWidth: 1.5, corners: { radius: [3, 3, 0, 0], kind: "round" }, textColor: "#2BE8FF", font: "700 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "accent", strokeWidth: 1.5, shadow: { color: "rgba(255,43,214,0.6)", blur: 8, offsetX: 0, offsetY: 0 } },
        "card/media/idle": { fill: "muted", stroke: "#2BE8FF", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "#2BE8FF", strokeWidth: 2, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(43,232,255,0.45)", blur: 22, offsetX: 0, offsetY: 0 } },
        "panel/header/idle": { fill: "muted", stroke: "#2BE8FF", strokeWidth: 1.5, corners: { radius: [3, 3, 0, 0], kind: "round" }, textColor: "#2BE8FF", font: "700 13px body" },
        "panel/divider/idle": { stroke: "#2BE8FF", strokeWidth: 1.5, shadow: { color: "rgba(43,232,255,0.6)", blur: 8, offsetX: 0, offsetY: 0 } },
        "section/band/idle": { fill: "surface", stroke: "accent", strokeWidth: 2, shadow: { color: "rgba(255,43,214,0.45)", blur: 20, offsetX: 0, offsetY: 0 } },
        "section/rule/idle": { stroke: "accent", strokeWidth: 2, shadow: { color: "rgba(255,43,214,0.6)", blur: 10, offsetX: 0, offsetY: 0 } },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "foreground", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "#2BE8FF", font: "700 18px body", on: "section/band/idle" },
        "icon/inverse/idle": { textColor: "#2BE8FF", on: "section/band/idle" },
        "pressable/primary/focused": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "primary", font: "700 16px body", shadow: { color: "rgba(255,43,214,0.75)", blur: 24, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 10 } },
        "pressable/secondary/focused": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "#2BE8FF", font: "700 16px body", shadow: { color: "rgba(43,232,255,0.7)", blur: 22, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 10 } },
        "textfield/default/idle": { fill: "background", stroke: "input", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, textColor: "foreground", font: "500 16px body" },
        "textfield/default/hovered": { fill: "background", stroke: "#2BE8FF", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, textColor: "foreground", font: "500 16px body" },
        "textfield/default/focused": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, textColor: "foreground", font: "500 16px body", shadow: { color: "rgba(43,232,255,0.7)", blur: 20, offsetX: 0, offsetY: 0 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn ne_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(12.9898, 78.233))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let row = floor(px.local.y / 26.0);\n let off = 0.5 * (row - 2.0 * floor(row * 0.5));\n let bx = px.local.x / 64.0 + off;\n let by = fract(px.local.y / 26.0);\n let mortar = clamp(step(fract(bx), 0.04) + step(by, 0.08), 0.0, 1.0);\n let tone = ne_h(vec2<f32>(floor(bx), row));\n c = c * (1.0 + (tone - 0.5) * 0.7) + vec3<f32>(0.02, 0.012, 0.015) * mortar;\n let pk = vec3<f32>(1.0, 0.2, 0.6);\n let cy = vec3<f32>(0.1, 0.85, 1.0);\n let br = 0.9 + 0.1 * sin(px.time * 0.5);\n let d1 = length((px.uv - vec2<f32>(0.2, 0.35)) * vec2<f32>(px.size.x / px.size.y, 1.0));\n let d2 = length((px.uv - vec2<f32>(0.8, 0.62)) * vec2<f32>(px.size.x / px.size.y, 1.0));\n c = c + pk * 0.11 * br * exp(-d1 * 3.0) * (0.6 + 0.4 * (1.0 - mortar));\n c = c + cy * 0.10 * br * exp(-d2 * 3.0) * (0.6 + 0.4 * (1.0 - mortar));\n let dp = length(px.local - px.pointer);\n c = c + cy * 0.04 * exp(-dp / 180.0);\n return vec4<f32>(c, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "accent", strokeWidth: 2.5, inset: { stroke: "#2BE8FF", strokeWidth: 1.5, gap: 6 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.55)", blur: 26, offsetX: 0, offsetY: 0 }, spring: { stiffness: 160, damping: 14 } },
        "stack/panel/idle": { fill: "card", stroke: "#2BE8FF", strokeWidth: 2.5, inset: { stroke: "accent", strokeWidth: 1.5, gap: 6 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(43,232,255,0.5)", blur: 24, offsetX: 0, offsetY: 0 }, spring: { stiffness: 160, damping: 14 } },
        "stack/hero/idle": { fill: "background", stroke: "accent", strokeWidth: 3.5, inset: { stroke: "#2BE8FF", strokeWidth: 2, gap: 8 }, corners: { radius: [30, 30, 30, 30], kind: "bevel" }, shadow: { color: "rgba(255,43,214,0.6)", blur: 48, offsetX: 0, offsetY: 0 }, spring: { stiffness: 160, damping: 14 } },
        "stack/bar/idle": { fill: "background", stroke: "#2BE8FF", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(43,232,255,0.45)", blur: 18, offsetX: 0, offsetY: 0 } },
        "pressable/primary/idle": { fill: "background", stroke: "accent", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "primary", font: "700 16px body", shadow: { color: "rgba(255,43,214,0.75)", blur: 24, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 10 } },
        "pressable/primary/hovered": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "foreground", font: "700 16px body", shadow: { color: "rgba(255,43,214,0.95)", blur: 46, offsetX: 0, offsetY: 0 }, spring: { stiffness: 380, damping: 7 } },
        "pressable/primary/pressed": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "background", font: "700 16px body", shadow: { color: "rgba(255,43,214,0.6)", blur: 12, offsetX: 0, offsetY: 0 }, spring: { stiffness: 440, damping: 12 } },
        "pressable/secondary/idle": { fill: "background", stroke: "#2BE8FF", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "#2BE8FF", font: "700 16px body", shadow: { color: "rgba(43,232,255,0.7)", blur: 22, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 10 } },
        "pressable/secondary/hovered": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "foreground", font: "700 16px body", shadow: { color: "rgba(43,232,255,0.95)", blur: 44, offsetX: 0, offsetY: 0 }, spring: { stiffness: 380, damping: 7 } },
        "text/display/idle": { textColor: "accent", font: "400 92px display" },
        "text/title/idle": { textColor: "#2BE8FF", font: "400 46px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 18px body" },
        "text/card/idle": { textColor: "#2BE8FF", font: "400 26px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_rbox(p: vec2<f32>, h: vec2<f32>, r: f32) -> f32 { let q = abs(p) - h + vec2<f32>(r, r); return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r; }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet rb = sg_rbox(p - c, c - vec2<f32>(16.0, 16.0), min(22.0, m * 0.3));\nlet cr = length(p - c) - m * 0.2;\nlet d = min(abs(rb), abs(cr));\nlet flick = 0.92 + 0.08 * sin(px.time * 9.0 + floor(px.time * 2.0) * 7.0);\nlet core = 1.0 - smoothstep(0.6, 1.8, d);\nlet glow = exp(-d / 9.0) * 0.55 * flick;\nlet col = mix(px.color.rgb, vec3<f32>(1.0, 1.0, 1.0), core * 0.7);\nreturn sg_out(px, col, max(core, glow));\n}\n", params: [0, 0, 0, 0], live: true } },
        "ticket/body/idle": { fill: "background", stroke: "accent", strokeWidth: 2.5, corners: { radius: [12, 12, 12, 12], kind: "bevel" }, shadow: { color: "rgba(255,43,214,0.6)", blur: 18, offsetX: 0, offsetY: 0 } },
        "ticket/stub/idle": { fill: "background", stroke: "#2BE8FF", strokeWidth: 2.5, corners: { radius: [12, 12, 12, 12], kind: "bevel" }, shadow: { color: "rgba(43,232,255,0.6)", blur: 18, offsetX: 0, offsetY: 0 } },
        "ticket/perforation/idle": { stroke: "#2BE8FF", strokeWidth: 2, strokeDash: [3, 6], shadow: { color: "rgba(43,232,255,0.6)", blur: 8, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/pressed": { fill: "#2BE8FF", stroke: "foreground", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "background", font: "700 16px body", shadow: { color: "rgba(43,232,255,0.6)", blur: 12, offsetX: 0, offsetY: 0 }, spring: { stiffness: 440, damping: 12 } },
        "pressable/secondary/disabled": { fill: "background", stroke: "border", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "bevel" }, textColor: "muted-foreground", font: "700 16px body" },
        "grid/rule/idle": { stroke: "accent", strokeWidth: 1.5, shadow: { color: "rgba(255,43,214,0.6)", blur: 8, offsetX: 0, offsetY: 0 } },
        "grid/border/idle": { stroke: "#2BE8FF", strokeWidth: 2, shadow: { color: "rgba(43,232,255,0.5)", blur: 14, offsetX: 0, offsetY: 0 } },
        "image/none/idle": { fill: "accent", stroke: "accent", strokeWidth: 2, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.5)", blur: 22, offsetX: 0, offsetY: 0 }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> { return im_px(px, vec2<f32>(0.0, 0.0)) * px.color.a; }\n", params: [0, 0, 0, 0], live: false } },
        "image/glow/idle": { fill: "accent", stroke: "accent", strokeWidth: 2, inset: { stroke: "#2BE8FF", strokeWidth: 1, gap: 5 }, corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,43,214,0.55)", blur: 26, offsetX: 0, offsetY: 0 }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  var bloom = vec3<f32>(0.0, 0.0, 0.0);\n  for (var i = 0; i < 8; i = i + 1) {\n    let ang = f32(i) * 0.785398;\n    let s = im_px(px, vec2<f32>(cos(ang), sin(ang)) * 7.0);\n    bloom = bloom + s.rgb;\n  }\n  let l = im_luma(c.rgb / max(c.a, 0.001));\n  let night = mix(vec3<f32>(0.03, 0.0, 0.09), c.rgb * vec3<f32>(1.2, 0.75, 1.35), smoothstep(0.0, 0.8, l));\n  let col = night + bloom / 8.0 * 0.5 * px.color.rgb + vec3<f32>(0.0, 0.18, 0.22) * smoothstep(0.55, 1.0, l);\n  return vec4<f32>(col * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.3, ornament: "none", align: "start", imageTreatment: "glow", sectionGap: 72, gutter: 24 }
    motion: { signature: "neon-flicker", stiffness: 300, damping: 9, stagger: 60, enterMs: 560, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0, scale: 1.06, rotate: 0 }, { at: 0.1, opacity: 0.7, offsetX: 0, offsetY: 0, scale: 1.025, rotate: 0 }, { at: 0.2, opacity: 0.05, offsetX: 0, offsetY: 0, scale: 1.012, rotate: 0 }, { at: 0.3, opacity: 0.85, offsetX: 0, offsetY: 0, scale: 1.007, rotate: 0 }, { at: 0.4, opacity: 0.12, offsetX: 0, offsetY: 0, scale: 1.004, rotate: 0 }, { at: 0.5, opacity: 0.966, offsetX: 0, offsetY: 0, scale: 1.002, rotate: 0 }, { at: 0.6, opacity: 0.983, offsetX: 0, offsetY: 0, scale: 1.001, rotate: 0 }, { at: 0.7, opacity: 0.992, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.997, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.999, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/event/"
  }
}
