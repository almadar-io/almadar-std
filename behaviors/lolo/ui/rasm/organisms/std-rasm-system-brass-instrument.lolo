app std-rasm-system-brass-instrument [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-brass-instrument — the Brass Instrument design system for a Rasm page, anchored on Victorian brass scientific instruments (Science Museum collection) (https://collection.sciencemuseumgroup.org.uk). Colour: #1B1512 ground, #E9D8B4 ink, #C08B3A accent. Type: Rye over Merriweather. Grid: circular dial grid with bezel rings. Motion: the gear easing (cubic-bezier 0.60,0.04,0.98,0.34); entrance: a curtain lifts, dials spin up to value. Interaction: gear rotates 15 degrees. Imagery: engraved brass and gauges. Voice: confident, period, measured. Components: buttons are riveted brass plates; cards are gauge faces. Data: dial gauges and ticker tape. Sound: gear ratchet on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "brass-instrument"
    palette: {background: "#1B1512", foreground: "#E9D8B4", card: "#27211C", "card-foreground": "#E9D8B4", surface: "#211B17", muted: "#2B251F", "muted-foreground": "#A79A80", border: "#786D5B", input: "#827763", primary: "#C08B3A", "primary-hover": "#C99C58", "primary-foreground": "#1B1512", secondary: "#27211C", "secondary-foreground": "#E9D8B4", "secondary-hover": "#342C25", accent: "#C08B3A", "accent-foreground": "#1B1512", ring: "#C08B3A", "series-1": "#C08B3A", "series-2": "#D2AE71", "series-3": "#9A6F31", "series-4": "#AB9E83", "series-5": "#A0855D"}
    fonts: { display: { family: "Rye", file: "https://almadar-kflow-assets.web.app/fonts/rye/Rye-Regular.ttf", generic: "serif" }, body: { family: "Merriweather", file: "https://almadar-kflow-assets.web.app/fonts/merriweather/Merriweather%5Bopsz%2Cwdth%2Cwght%5D.ttf", generic: "serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn sp_gear(p: vec2<f32>, c: vec2<f32>, r: f32, teeth: f32, rot: f32) -> f32 {\n  let d = p - c;\n  let a = atan2(d.y, d.x) + rot;\n  let rr = r + 5.0 * smoothstep(-0.2, 0.2, sin(a * teeth));\n  let ring = 1.0 - smoothstep(0.0, 1.4, abs(length(d) - rr));\n  let hub = 1.0 - smoothstep(0.0, 1.4, abs(length(d) - r * 0.55));\n  let spoke = 1.0 - smoothstep(0.0, 1.2, abs(sin((a * 3.0)) * length(d)) - 1.0);\n  return ring + hub * 0.7 + spoke * 0.4 * step(length(d), r * 0.55);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let brass = vec3<f32>(0.72, 0.52, 0.22);\n  let lum = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114));\n  let line = select(brass, brass * 0.75, lum > 0.5);\n  let g = px.local;\n  let gx = 1.0 - smoothstep(0.0, 1.0, abs(fract(g.x / 32.0) - 0.5) * 32.0 - 15.0);\n  let gy = 1.0 - smoothstep(0.0, 1.0, abs(fract(g.y / 32.0) - 0.5) * 32.0 - 15.0);\n  let major = 1.0 - smoothstep(0.0, 1.0, abs(fract(g.x / 160.0) - 0.5) * 160.0 - 79.0);\n  var a = (gx + gy) * 0.05 + major * 0.06;\n  let t = px.time * 0.15 + px.scroll * 2.0;\n  let big = vec2<f32>(px.size.x * 0.88, px.size.y * 0.28);\n  a = a + sp_gear(g, big, 120.0, 14.0, t) * 0.13;\n  a = a + sp_gear(g, big + vec2<f32>(-150.0, 112.0), 56.0, 8.0, -t * 2.0 + 0.2) * 0.12;\n  a = a + sp_gear(g, vec2<f32>(px.size.x * 0.06, px.size.y * 0.8), 80.0, 11.0, -t) * 0.10;\n  let tick = abs(fract(atan2(g.y - big.y, g.x - big.x) * 24.0 / 6.2832) - 0.5);\n  let gauge = (1.0 - smoothstep(0.0, 0.06, tick - 0.44)) * (1.0 - smoothstep(0.0, 1.5, abs(length(g - big) - 150.0 - 6.0 * 0.0)));\n  a = a + gauge * 0.09;\n  return vec4<f32>(mix(px.color.rgb, line, clamp(a, 0.0, 0.4)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [30, 30, 30, 30], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 7 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 24, offsetX: 0, offsetY: 10 }, decor: "engraved-border" },
        "stack/panel/idle": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [22, 22, 22, 22], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 7 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 22, offsetX: 0, offsetY: 10 }, decor: "engraved-border" },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/surface/idle": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [30, 30, 30, 30], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 7 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 26, offsetX: 0, offsetY: 12 }, spring: { stiffness: 130, damping: 16 }, decor: "engraved-border" },
        "card/surface/hovered": { fill: "card", stroke: "series-2", strokeWidth: 3.5, corners: { radius: [30, 30, 30, 30], kind: "round" }, inset: { stroke: "series-2", strokeWidth: 2, gap: 12 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 34, offsetX: 0, offsetY: 16 }, spring: { stiffness: 90, damping: 10 }, decor: "engraved-border" },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [30, 30, 30, 30], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 7 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 130, damping: 16 }, decor: "engraved-border" },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 3, corners: { radius: [30, 30, 30, 30], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 3 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 6, offsetX: 0, offsetY: 1 }, spring: { stiffness: 260, damping: 24 }, decor: "engraved-border" },
        "card/header/idle": { fill: "primary", stroke: "series-3", strokeWidth: 2, corners: { radius: [10, 10, 0, 0], kind: "bevel" }, textColor: "primary-foreground", font: "700 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "series-3", strokeWidth: 2, strokeDash: [1, 6] },
        "card/media/idle": { fill: "muted", stroke: "primary", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "300 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [22, 22, 22, 22], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 7 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 22, offsetX: 0, offsetY: 10 } },
        "panel/header/idle": { fill: "muted", stroke: "primary", strokeWidth: 2, corners: { radius: [10, 10, 0, 0], kind: "bevel" }, textColor: "foreground", font: "700 13px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "series-3", strokeWidth: 2, strokeDash: [1, 6] },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "primary", strokeWidth: 2, strokeDash: [1, 7] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "stack/bar/idle": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 1, gap: 4 } },
        "pressable/primary/idle": { fill: "primary", stroke: "series-3", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 5 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 10, offsetX: 0, offsetY: 4 }, textColor: "primary-foreground", font: "700 15px body", spring: { stiffness: 130, damping: 16 }, decor: "engraved-border" },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "series-2", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 3 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 14, offsetX: 0, offsetY: 6 }, textColor: "primary-foreground", font: "700 15px body", spring: { stiffness: 90, damping: 9 }, decor: "engraved-border" },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "series-3", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 2 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 2, offsetX: 0, offsetY: 0 }, textColor: "primary-foreground", font: "700 15px body", spring: { stiffness: 260, damping: 24 } },
        "pressable/secondary/idle": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 1.5, gap: 5 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 8, offsetX: 0, offsetY: 3 }, textColor: "foreground", font: "400 15px body", spring: { stiffness: 130, damping: 16 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "series-2", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-2", strokeWidth: 1.5, gap: 3 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 12, offsetX: 0, offsetY: 5 }, textColor: "secondary-foreground", font: "400 15px body", spring: { stiffness: 90, damping: 9 } },
        "text/display/idle": { fill: "background", textColor: "foreground", font: "400 60px display", backing: "halo" },
        "text/title/idle": { fill: "background", textColor: "foreground", font: "400 32px display", backing: "halo" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 12px body" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 22px display" },
        "mirror/primary/idle": { corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 2 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet gc = vec2<f32>(s.x * 0.3, c.y);\nlet r0 = m * 0.3;\nlet q = p - gc;\nlet r = length(q);\nlet u = atan2(q.x, -q.y) * 1.591549;\nlet f = abs(fract(u) - 0.5) * 2.0;\nlet rr = r0 * (1.0 + 0.17 * smoothstep(0.3, 0.6, f));\nlet body = sg_fill(r - rr) * (1.0 - sg_fill(r - r0 * 0.5));\nlet hub = sg_fill(r - r0 * 0.18);\nlet ring = sg_line(r - r0 * 0.7, 0.8);\nlet rv = sg_fill(length(vec2<f32>(fract(p.x / 14.0) * 14.0 - 7.0, p.y - (s.y - 8.0))) - 2.2) * step(s.x * 0.55, p.x);\nreturn sg_out(px, px.color.rgb, max(max(body, hub), max(ring, rv)));\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/frame/idle": { stroke: "primary", strokeWidth: 3, corners: { radius: [26, 26, 26, 26], kind: "round" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 9 } },
        "ornament/corners/idle": { fill: "primary", stroke: "series-3", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 2, gap: 5 }, shadow: { color: "rgba(0,0,0,0.55)", blur: 10, offsetX: 0, offsetY: 4 }, textColor: "primary-foreground", font: "700 15px body", spring: { stiffness: 130, damping: 16 } },
        "pressable/secondary/focused": { fill: "surface", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 1.5, gap: 5 }, textColor: "foreground", font: "400 15px body", spring: { stiffness: 130, damping: 16 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 1.5, gap: 2 }, textColor: "foreground", font: "400 15px body", spring: { stiffness: 260, damping: 24 } },
        "text/caption/idle": { textColor: "muted-foreground", font: "300 14px body" },
        "text/label/idle": { textColor: "muted-foreground", font: "700 12px body" },
        "text/accent/idle": { textColor: "primary", font: "700 15px body" },
        "text/default/idle": { textColor: "foreground", font: "400 17px body" },
        "text/numeral/idle": { textColor: "primary", font: "400 96px display" },
        "textfield/default/idle": { fill: "surface", stroke: "input", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 1.5, gap: 4 }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/hovered": { fill: "surface", stroke: "series-2", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-2", strokeWidth: 1.5, gap: 4 }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/focused": { fill: "surface", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "bevel" }, inset: { stroke: "series-3", strokeWidth: 1.5, gap: 4 }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px body" },
        "grid/rule/idle": { stroke: "series-3", strokeWidth: 1.5, strokeDash: [1, 5] },
        "grid/border/idle": { stroke: "primary", strokeWidth: 3 }
      }
    layout: { hero: "centered", columns: 12, asymmetry: 0.0, ornament: "frame", align: "center", imageTreatment: "engraving", sectionGap: 120, gutter: 48 }
    motion: { signature: "gear", stiffness: 130, damping: 16, stagger: 90, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 48, scale: 0.92, rotate: -15 }, { at: 0.1, opacity: 0.009, offsetX: 0, offsetY: 47.552, scale: 0.921, rotate: -14.86 }, { at: 0.2, opacity: 0.025, offsetX: 0, offsetY: 46.818, scale: 0.922, rotate: -14.631 }, { at: 0.3, opacity: 0.047, offsetX: 0, offsetY: 45.745, scale: 0.924, rotate: -14.295 }, { at: 0.4, opacity: 0.078, offsetX: 0, offsetY: 44.259, scale: 0.926, rotate: -13.831 }, { at: 0.5, opacity: 0.12, offsetX: 0, offsetY: 42.255, scale: 0.93, rotate: -13.205 }, { at: 0.6, opacity: 0.176, offsetX: 0, offsetY: 39.569, scale: 0.934, rotate: -12.365 }, { at: 0.7, opacity: 0.251, offsetX: 0, offsetY: 35.928, scale: 0.94, rotate: -11.228 }, { at: 0.8, opacity: 0.358, offsetX: 0, offsetY: 30.801, scale: 0.949, rotate: -9.625 }, { at: 0.9, opacity: 0.525, offsetX: 0, offsetY: 22.821, scale: 0.962, rotate: -7.132 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/trading/"
  }
}
