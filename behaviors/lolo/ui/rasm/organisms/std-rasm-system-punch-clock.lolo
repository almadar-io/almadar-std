app std-rasm-system-punch-clock [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-punch-clock — the Punch Clock design system for a Rasm page, anchored on Simplex time recorders and paper time cards (https://en.wikipedia.org/wiki/Time_clock). Colour: #EFE9DA ground, #2A2A2A ink, #C1272D accent. Type: Cutive Mono over Instrument Sans. Grid: time card grid of day rows and IN/OUT columns. Motion: the punch easing (cubic-bezier 0.95,0.05,0.80,0.04); entrance: rows punch in one per beat. Interaction: row gets a punched stamp. Imagery: time cards and clock faces. Voice: matter-of-fact, hours and days. Components: buttons are punch card slots; cards are time cards. Data: hours stamped in rows. Sound: time clock punch on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "punch-clock"
    palette: {background: "#EFE9DA", foreground: "#2A2A2A", card: "#F8F5EE", "card-foreground": "#2A2A2A", surface: "#E9E3D5", muted: "#DFDACC", "muted-foreground": "#696762", border: "#96938B", input: "#8D8A82", primary: "#C1272D", "primary-hover": "#A42126", "primary-foreground": "#EFE9DA", secondary: "#F8F5EE", "secondary-foreground": "#2A2A2A", "secondary-hover": "#D7D2C5", accent: "#C1272D", "accent-foreground": "#EFE9DA", ring: "#C1272D", "series-1": "#C1272D", "series-2": "#7D282C", "series-3": "#D67E7B", "series-4": "#65635F", "series-5": "#A05356"}
    fonts: { display: { family: "Cutive Mono", file: "https://almadar-kflow-assets.web.app/fonts/cutivemono/CutiveMono-Regular.ttf", generic: "monospace" }, body: { family: "Instrument Sans", file: "https://almadar-kflow-assets.web.app/fonts/instrumentsans/InstrumentSans%5Bwdth%2Cwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Cutive Mono", file: "https://almadar-kflow-assets.web.app/fonts/cutivemono/CutiveMono-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(26,34,51,0.16)", blur: 28, offsetX: 0, offsetY: 12 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(26,34,51,0.16)", blur: 28, offsetX: 0, offsetY: 12 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" }, shadow: { color: "rgba(26,34,51,0.2)", blur: 40, offsetX: 0, offsetY: 18 } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", shadow: { color: "rgba(29,63,168,0.35)", blur: 14, offsetX: 0, offsetY: 6 }, spring: { stiffness: 380, damping: 34 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", shadow: { color: "rgba(29,63,168,0.4)", blur: 18, offsetX: 0, offsetY: 8 }, spring: { stiffness: 380, damping: 34 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 480, damping: 40 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 380, damping: 34 } },
        "pressable/secondary/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "foreground", font: "600 16px body", shadow: { color: "rgba(26,34,51,0.12)", blur: 10, offsetX: 0, offsetY: 4 }, spring: { stiffness: 380, damping: 34 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 380, damping: 34 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 480, damping: 40 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 380, damping: 34 } },
        "text/display/idle": { textColor: "foreground", font: "800 84px display" },
        "text/title/idle": { textColor: "foreground", font: "800 48px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 13px mono" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 17px body", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "primary", font: "800 132px display" },
        "text/label/idle": { textColor: "foreground", font: "600 13px mono" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px mono" },
        "text/inverse/idle": { textColor: "background", font: "500 14px mono", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(26,34,51,0.14)", blur: 22, offsetX: 0, offsetY: 10 }, spring: { stiffness: 380, damping: 34 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(26,34,51,0.22)", blur: 30, offsetX: 0, offsetY: 14 }, spring: { stiffness: 380, damping: 34 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [14, 14, 14, 14], kind: "round" }, spring: { stiffness: 380, damping: 34 } },
        "card/surface/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, corners: { radius: [14, 14, 14, 14], kind: "round" }, spring: { stiffness: 480, damping: 40 } },
        "card/header/idle": { fill: "muted", corners: { radius: [14, 14, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px mono" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [4, 4] },
        "card/media/idle": { fill: "muted", corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 13px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(26,34,51,0.16)", blur: 28, offsetX: 0, offsetY: 12 } },
        "panel/header/idle": { fill: "muted", corners: { radius: [16, 16, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px mono" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "mirror/default/idle": { fill: "card", corners: { radius: [18, 18, 18, 18], kind: "round" }, shadow: { color: "rgba(26,34,51,0.22)", blur: 48, offsetX: 0, offsetY: 24 } },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pulse/default/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "600 14px mono" },
        "pulse/sub/idle": { fill: "foreground", stroke: "foreground", textColor: "muted-foreground", font: "500 13px mono" },
        "pulse/stamp/idle": { fill: "accent", stroke: "accent", textColor: "accent", font: "700 22px mono" },
        "pulse/lock/idle": { fill: "background", stroke: "background", textColor: "background", font: "700 14px mono" },
        "pulse/link/idle": { stroke: "border", strokeWidth: 2 },
        "material/floor/idle": { fill: "card" },
        "textfield/default/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "card-foreground", font: "400 16px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "card-foreground", font: "400 16px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, textColor: "card-foreground", font: "400 16px body" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.1, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 32 }
    motion: { signature: "punch", stiffness: 380, damping: 34, stagger: 60, enterMs: 1445, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 30, scale: 0.97, rotate: -3 }, { at: 0.1, opacity: 0.005, offsetX: 0, offsetY: 29.841, scale: 0.97, rotate: -2.984 }, { at: 0.2, opacity: 0.011, offsetX: 0, offsetY: 29.672, scale: 0.97, rotate: -2.967 }, { at: 0.3, opacity: 0.017, offsetX: 0, offsetY: 29.478, scale: 0.971, rotate: -2.948 }, { at: 0.4, opacity: 0.026, offsetX: 0, offsetY: 29.228, scale: 0.971, rotate: -2.923 }, { at: 0.5, opacity: 0.038, offsetX: 0, offsetY: 28.868, scale: 0.971, rotate: -2.887 }, { at: 0.6, opacity: 0.057, offsetX: 0, offsetY: 28.28, scale: 0.972, rotate: -2.828 }, { at: 0.7, opacity: 0.095, offsetX: 0, offsetY: 27.164, scale: 0.973, rotate: -2.716 }, { at: 0.8, opacity: 0.183, offsetX: 0, offsetY: 24.506, scale: 0.975, rotate: -2.451 }, { at: 0.9, opacity: 0.479, offsetX: 0, offsetY: 15.615, scale: 0.984, rotate: -1.562 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/time-approval/"
  }
}
