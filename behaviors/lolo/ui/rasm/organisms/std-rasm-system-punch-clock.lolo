app std-rasm-system-punch-clock [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-punch-clock — the Punch Clock design system for a Rasm page, anchored on Simplex time recorders and paper time cards (https://en.wikipedia.org/wiki/Time_clock). Colour: #EFE9DA ground, #2A2A2A ink, #C1272D accent. Type: Cutive Mono over Instrument Sans. Grid: time card grid of day rows and IN/OUT columns. Motion: the punch easing (cubic-bezier 0.95,0.05,0.80,0.04); entrance: rows punch in one per beat. Interaction: row gets a punched stamp. Imagery: time cards and clock faces. Voice: matter-of-fact, hours and days. Components: buttons are punch card slots; cards are time cards. Data: hours stamped in rows. Sound: time clock punch on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "punch-clock"
    palette: {background: "#EFE9DA", foreground: "#2A2A2A", card: "#F8F5EE", "card-foreground": "#2A2A2A", surface: "#E9E3D5", muted: "#DFDACC", "muted-foreground": "#5C5A56", border: "#7C7970", input: "#7C7970", primary: "#C1272D", "primary-hover": "#A42126", "primary-foreground": "#EFE9DA", secondary: "#F8F5EE", "secondary-foreground": "#2A2A2A", "secondary-hover": "#D7D2C5", accent: "#C1272D", "accent-foreground": "#EFE9DA", ring: "#C1272D", "series-1": "#C1272D", "series-2": "#7D282C", "series-3": "#D67E7B", "series-4": "#65635F", "series-5": "#A05356"}
    fonts: { display: { family: "Cutive Mono", file: "https://almadar-kflow-assets.web.app/fonts/cutivemono/CutiveMono-Regular.ttf", generic: "monospace" }, body: { family: "Instrument Sans", file: "https://almadar-kflow-assets.web.app/fonts/instrumentsans/InstrumentSans%5Bwdth%2Cwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Cutive Mono", file: "https://almadar-kflow-assets.web.app/fonts/cutivemono/CutiveMono-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let gl = px.local - vec2<f32>(0.0, px.scroll * 30.0);\n  let row = abs(fract(gl.y / 36.0) - 0.5);\n  let rule = 1.0 - smoothstep(0.0, 0.02, 0.5 - row);\n  let colA = 1.0 - smoothstep(0.0, 1.2, abs(gl.x - px.size.x * 0.12));\n  let colB = 1.0 - smoothstep(0.0, 1.2, abs(gl.x - px.size.x * 0.88));\n  let red = vec3<f32>(0.757, 0.153, 0.176);\n  let ink = vec3<f32>(0.165, 0.165, 0.165);\n  var col = mix(px.color.rgb, ink, rule * 0.07);\n  col = mix(col, red, max(colA, colB) * 0.22);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "primary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "primary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "primary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "primary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "secondary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "secondary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "secondary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "secondary-foreground", font: "400 15px display", spring: { stiffness: 900, damping: 60 } },
        "text/display/idle": { textColor: "foreground", font: "400 60px display" },
        "text/title/idle": { textColor: "foreground", font: "400 36px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "400 13px display" },
        "text/body/idle": { textColor: "muted-foreground", font: "500 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "500 17px body", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "primary", font: "400 120px display" },
        "text/label/idle": { textColor: "foreground", font: "400 13px display" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px display" },
        "text/inverse/idle": { textColor: "background", font: "400 14px display", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "card/surface/pressed": { fill: "muted", stroke: "primary", strokeWidth: 3, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "card/header/idle": { fill: "muted", corners: { radius: [18, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "400 13px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 1, strokeDash: [6, 3] },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px display", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, shadow: { color: "rgba(42,42,42,0.0)", blur: 0, offsetX: 0, offsetY: 0 } },
        "panel/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "400 13px display", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 1, strokeDash: [6, 3] },
        "mirror/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [18, 0, 0, 0], kind: "bevel" } },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pulse/default/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "400 14px display" },
        "pulse/sub/idle": { fill: "foreground", stroke: "foreground", textColor: "muted-foreground", font: "400 13px display" },
        "pulse/stamp/idle": { fill: "accent", stroke: "accent", textColor: "accent", font: "400 22px display" },
        "pulse/lock/idle": { fill: "background", stroke: "background", textColor: "background", font: "400 14px display" },
                "pulse/link/idle": { stroke: "border", strokeWidth: 2 },
                "material/floor/idle": { fill: "card" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body" },
        "pressable/secondary/disabled": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "notch" }, textColor: "muted-foreground", font: "400 15px display" }
      }
    layout: { hero: "split", columns: 4, asymmetry: 0, ornament: "rule", align: "start", imageTreatment: "grain", sectionGap: 72, gutter: 16 }
    motion: { signature: "punch", stiffness: 900, damping: 60, stagger: 220, enterMs: 380, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -20, scale: 1.07, rotate: -1 }, { at: 0.1, opacity: 0.005, offsetX: 0, offsetY: -19.894, scale: 1.07, rotate: -0.995 }, { at: 0.2, opacity: 0.011, offsetX: 0, offsetY: -19.782, scale: 1.069, rotate: -0.989 }, { at: 0.3, opacity: 0.017, offsetX: 0, offsetY: -19.652, scale: 1.069, rotate: -0.983 }, { at: 0.4, opacity: 0.026, offsetX: 0, offsetY: -19.486, scale: 1.068, rotate: -0.974 }, { at: 0.5, opacity: 0.038, offsetX: 0, offsetY: -19.246, scale: 1.067, rotate: -0.962 }, { at: 0.6, opacity: 0.057, offsetX: 0, offsetY: -18.853, scale: 1.066, rotate: -0.943 }, { at: 0.7, opacity: 0.095, offsetX: 0, offsetY: -18.11, scale: 1.063, rotate: -0.905 }, { at: 0.8, opacity: 0.183, offsetX: 0, offsetY: -16.337, scale: 1.057, rotate: -0.817 }, { at: 0.9, opacity: 0.479, offsetX: 0, offsetY: -10.41, scale: 1.036, rotate: -0.521 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/time-approval/"
  }
}
