app std-rasm-system-arts-and-crafts [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-arts-and-crafts — the Arts and Crafts design system for a Rasm page, anchored on William Morris and the Kelmscott Press (https://en.wikipedia.org/wiki/Kelmscott_Press). Colour: #F3ECE0 ground, #2F2A24 ink, #7A3E2B accent. Type: Gilda Display over Alegreya Sans. Grid: masonry 4 lanes with woven border. Motion: the loom easing (cubic-bezier 0.40,0.20,0.20,1.00); entrance: tiles weave in alternating lanes. Interaction: vine border grows around the tile. Imagery: botanical patterns and craft photos. Voice: maker's voice, material and hand. Components: buttons are woven labels; cards are tiles with patterned borders. Data: stitched bar charts. Sound: loom shuttle clack on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "arts-and-crafts"
    palette: {background: "#F3ECE0", foreground: "#2F2A24", card: "#FAF6F1", "card-foreground": "#2F2A24", surface: "#EDE6DA", muted: "#E3DCD1", "muted-foreground": "#5F5A52", border: "#7D776D", input: "#77716A", primary: "#7A3E2B", "primary-hover": "#683525", "primary-foreground": "#F3ECE0", secondary: "#FAF6F1", "secondary-foreground": "#2F2A24", "secondary-hover": "#DBD5C9", accent: "#7A3E2B", "accent-foreground": "#F3ECE0", ring: "#7A3E2B", "series-1": "#7A3E2B", "series-2": "#583528", "series-3": "#B08C7C", "series-4": "#6A645C", "series-5": "#7D5F55"}
    fonts: { display: { family: "Gilda Display", file: "https://almadar-kflow-assets.web.app/fonts/gildadisplay/GildaDisplay-Regular.ttf", generic: "serif" }, body: { family: "Alegreya Sans", file: "https://almadar-kflow-assets.web.app/fonts/alegreyasans/AlegreyaSans-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn at_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = at_h(floor(px.local)) - 0.5;\n  let asp = px.size.x / px.size.y;\n  let p = (px.uv - vec2<f32>(0.18, 0.62 - px.scroll * 0.1)) * vec2<f32>(asp, 1.0);\n  let ring = 1.0 - smoothstep(0.0, 0.004, abs(length(p) - 0.42));\n  let mark = vec2<f32>(abs(px.local.x - 48.0), abs(px.local.y - 48.0));\n  let reg = (1.0 - smoothstep(0.5, 1.5, min(mark.x, mark.y))) * (1.0 - smoothstep(10.0, 12.0, max(mark.x, mark.y)));\n  var col = px.color.rgb - vec3<f32>(g * 0.03, g * 0.03, g * 0.03) - vec3<f32>(ring * 0.05 + reg * 0.12);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(47,42,36,0.22)", blur: 0, offsetX: 4, offsetY: 4 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(47,42,36,0.22)", blur: 0, offsetX: 4, offsetY: 4 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 3 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 5 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 2 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/idle": { fill: "card", stroke: "primary", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 1, gap: 3 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "foreground", font: "600 17px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "primary", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 1.5, gap: 5 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "secondary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 20 } },
        "text/display/idle": { textColor: "foreground", font: "400 92px display" },
        "text/title/idle": { textColor: "foreground", font: "400 46px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 14px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 26px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet r = m * 0.3;\nlet ex = 1.0 - smoothstep(r * 1.4, r * 1.4 + 1.0, abs(p.x - c.x));\nlet ey = 1.0 - smoothstep(r * 1.4, r * 1.4 + 1.0, abs(p.y - c.y));\nlet crs = max(sg_line(p.y - c.y, 0.5) * ex, sg_line(p.x - c.x, 0.5) * ey);\nlet a = max(max(sg_line(length(p - c) - r, 0.7), crs), sg_fill(length(p - c) - 2.0));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/primary/focused": { fill: "primary", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 3 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 20 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 1, gap: 2 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "secondary-foreground", font: "600 17px body", spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 1, gap: 3 }, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "foreground", font: "600 17px body", spring: { stiffness: 120, damping: 20 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(47,42,36,0.22)", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 2.5, inset: { stroke: "primary", strokeWidth: 3, gap: 3 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(47,42,36,0.26)", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 110, damping: 18 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, spring: { stiffness: 120, damping: 20 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 2, inset: { stroke: "primary", strokeWidth: 3, gap: 3 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(47,42,36,0.12)", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 200, damping: 26 } },
        "card/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "primary", strokeWidth: 1.5 },
        "card/media/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "primary", strokeWidth: 1.5 },
        "section/band/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 5 } },
        "section/rule/idle": { stroke: "primary", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "primary-foreground", font: "400 28px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/label/idle": { textColor: "foreground", font: "600 14px body" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 120, damping: 20 } },
        "textfield/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 120, damping: 20 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 120, damping: 20 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "pressable/secondary/disabled": { fill: "background", stroke: "input", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "scoop" }, textColor: "muted-foreground", font: "600 17px body" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "grid/rule/idle": { stroke: "primary", strokeWidth: 1.5 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 2, gap: 4 } },
        "image/none/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 2, 2, 2], kind: "round" }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> { return im_px(px, vec2<f32>(0.0, 0.0)) * px.color.a; }\n", params: [0, 0, 0, 0], live: false } },
        "image/grain/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [2, 2, 2, 2], kind: "round" }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let l = im_luma(c.rgb / max(c.a, 0.001));\n  let paper = vec3<f32>(0.95, 0.91, 0.84);\n  let ink = px.color.rgb * 0.55;\n  let hatch = abs(fract((px.local.x + px.local.y) / 5.0) - 0.5) * 2.0;\n  let cut = 1.0 - smoothstep(l * 0.55, l * 0.55 + 0.14, hatch);\n  let warm = mix(c.rgb, c.rgb * vec3<f32>(1.08, 0.98, 0.86), 0.6);\n  let n = im_hash(px.local) - 0.5;\n  let col = mix(warm, mix(paper, ink, cut), 0.32) + n * 0.05;\n  return vec4<f32>(col * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "editorial", columns: 4, asymmetry: 0.15, ornament: "double-rule", align: "start", imageTreatment: "grain", sectionGap: 96, gutter: 28 }
    motion: { signature: "loom", stiffness: 120, damping: 20, stagger: 70, enterMs: 820, keyframes: [{ at: 0, opacity: 0, offsetX: -30, offsetY: 20, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.073, offsetX: -27.812, offsetY: 18.542, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.216, offsetX: -23.529, offsetY: 15.686, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.453, offsetX: -16.414, offsetY: 10.942, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.676, offsetX: -9.73, offsetY: 6.487, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.815, offsetX: -5.56, offsetY: 3.706, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.899, offsetX: -3.041, offsetY: 2.027, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.95, offsetX: -1.503, offsetY: 1.002, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.98, offsetX: -0.599, offsetY: 0.399, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.995, offsetX: -0.136, offsetY: 0.091, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/marketplace/"
  }
}
