app std-rasm-system-dada-cutout [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-dada-cutout — the Dada Cutout design system for a Rasm page, anchored on Hannah Hoch photomontage (Cut with the Kitchen Knife, 1919) (https://en.wikipedia.org/wiki/Hannah_H%C3%B6ch). Colour: #F1E7D0 ground, #1C1C1C ink, #3D5AFE accent. Type: Permanent Marker over Anybody. Grid: broken collage grid, no shared baselines. Motion: the scissor easing (cubic-bezier 0.30,-0.40,0.70,1.40); entrance: cutouts fly in from off-board and stick. Interaction: cutout peels at the corner. Imagery: cut photographs and type fragments. Voice: playful, irreverent, mixed type sizes. Components: buttons are cut paper labels; cards are scissored photos. Data: collage stickers counts. Sound: scissor snip on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "dada-cutout"
    palette: { background: "#F1E7D0", foreground: "#1C1C1C", card: "#F9F4EA", "card-foreground": "#1C1C1C", surface: "#EBE1CB", muted: "#E0D7C2", "muted-foreground": "#4F4C46", border: "#7B776C", input: "#706C61", primary: "#3D5AFE", "primary-hover": "#2D47DB", "primary-foreground": "#FFFFFF", secondary: "#F9F4EA", "secondary-foreground": "#1C1C1C", "secondary-hover": "#E8DCC0", accent: "#3D5AFE", "accent-foreground": "#FFFFFF", ring: "#3D5AFE", "series-1": "#3D5AFE", "series-2": "#E0301E", "series-3": "#F2C21B", "series-4": "#1C1C1C", "series-5": "#7B776C" }
    fonts: { display: { family: "Permanent Marker", file: "https://almadar-kflow-assets.web.app/fonts/permanentmarker/PermanentMarker-Regular.ttf", generic: "sans-serif" }, body: { family: "Anybody", file: "https://almadar-kflow-assets.web.app/fonts/anybody/Anybody%5Bwdth%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn dh(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let fib = dh(floor(px.local / 3.0)) * 0.06;\n  let cell = fract(px.local / 9.0) - vec2<f32>(0.5, 0.5);\n  let ramp = smoothstep(0.1, 1.0, px.uv.y);\n  let ht = (1.0 - smoothstep(0.1, 0.3 + ramp * 0.25, length(cell))) * ramp * 0.07;\n  let col = px.color.rgb - vec3<f32>(fib + ht);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", corners: { radius: [14, 3, 24, 0], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 } },
        "stack/panel/idle": { fill: "surface", corners: { radius: [0, 12, 3, 18], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 } },
        "stack/hero/idle": { corners: { radius: [16, 0, 30, 0], kind: "bevel" } },
        "stack/coupon/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, strokeDash: [12, 8], corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 } },
        "stack/clipping/idle": { fill: "card", corners: { radius: [3, 0, 8, 0], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.42)", blur: 4, offsetX: 4, offsetY: 7 }, decor: "deckle-edge" },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [0, 12, 3, 18], kind: "bevel" }, textColor: "primary-foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 }, spring: { stiffness: 420, damping: 14 } },
        "pressable/primary/hovered": { fill: "primary", corners: { radius: [0, 12, 3, 40], kind: "bevel" }, textColor: "primary-foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 6, offsetY: 7 }, spring: { stiffness: 420, damping: 14 } },
        "pressable/primary/pressed": { fill: "primary-hover", corners: { radius: [0, 12, 3, 18], kind: "bevel" }, textColor: "primary-foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 1, offsetY: 1 }, spring: { stiffness: 520, damping: 18 } },
        "pressable/primary/focused": { fill: "primary", corners: { radius: [0, 12, 3, 18], kind: "bevel" }, textColor: "primary-foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 }, spring: { stiffness: 420, damping: 14 }, stroke: "foreground", strokeWidth: 3 },
        "pressable/secondary/idle": { fill: "card", corners: { radius: [4, 0, 10, 0], kind: "bevel" }, textColor: "foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 }, spring: { stiffness: 420, damping: 14 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", corners: { radius: [4, 0, 36, 0], kind: "bevel" }, textColor: "foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 6, offsetY: 7 }, spring: { stiffness: 420, damping: 14 } },
        "pressable/secondary/pressed": { fill: "muted", corners: { radius: [4, 0, 10, 0], kind: "bevel" }, textColor: "foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 1, offsetY: 1 }, spring: { stiffness: 520, damping: 18 } },
        "pressable/secondary/focused": { fill: "card", corners: { radius: [4, 0, 10, 0], kind: "bevel" }, textColor: "foreground", font: "400 22px display", shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 }, spring: { stiffness: 420, damping: 14 }, stroke: "foreground", strokeWidth: 3 },
        "pressable/secondary/disabled": { fill: "background", corners: { radius: [4, 0, 10, 0], kind: "bevel" }, textColor: "muted-foreground", font: "400 22px display", spring: { stiffness: 420, damping: 14 } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 2, strokeDash: [8, 5], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 420, damping: 14 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, strokeDash: [8, 5], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 420, damping: 14 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, strokeDash: [], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 420, damping: 14 } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "foreground" },
        "card/surface/idle": { fill: "card", corners: { radius: [14, 3, 24, 0], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 }, decor: "deckle-edge", spring: { stiffness: 420, damping: 14 } },
        "card/surface/hovered": { fill: "card", corners: { radius: [14, 3, 56, 0], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 6, offsetY: 9 }, decor: "deckle-edge", spring: { stiffness: 420, damping: 14 } },
        "card/surface/focused": { fill: "card", corners: { radius: [14, 3, 24, 0], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 }, decor: "deckle-edge", spring: { stiffness: 420, damping: 14 }, stroke: "ring", strokeWidth: 3 },
        "card/surface/pressed": { fill: "muted", corners: { radius: [14, 3, 24, 0], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 1, offsetY: 1 }, decor: "deckle-edge", spring: { stiffness: 520, damping: 18 } },
        "card/header/idle": { fill: "series-3", corners: { radius: [14, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "400 20px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [6, 4] },
        "card/media/idle": { fill: "surface", corners: { radius: [14, 3, 0, 0], kind: "bevel" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", corners: { radius: [0, 12, 3, 18], kind: "bevel" }, shadow: { color: "rgba(28,28,28,0.38)", blur: 3, offsetX: 3, offsetY: 5 } },
        "panel/header/idle": { fill: "foreground", corners: { radius: [0, 10, 0, 0], kind: "bevel" }, textColor: "background", font: "400 20px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [10, 6] },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [10, 6] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "foreground", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "400 108px display" },
        "text/title/idle": { textColor: "foreground", font: "400 44px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "600 15px body" },
        "text/body/idle": { textColor: "foreground", font: "500 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 30px display" },
        "text/inverse/idle": { textColor: "background", font: "400 30px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 15px body" },
        "text/label/idle": { textColor: "foreground", font: "700 15px body" },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [10, 6] },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [12, 8] },
        "morph/default/idle": { fill: "series-2", corners: { radius: [6, 0, 14, 0], kind: "bevel" } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.size * 0.5;\n  let zig = 0.5 + 0.22 * sin(px.local.x / 9.0) * step(0.5, fract(px.local.x / 90.0));\n  let line = sg_line(px.local.y - px.size.y * zig, 1.2);\n  return sg_out(px, px.color.rgb, line);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.6, ornament: "stamp", align: "start", imageTreatment: "halftone", sectionGap: 56, gutter: 20 }
    motion: { signature: "scissor", stiffness: 420, damping: 14, stagger: 40, enterMs: 520, keyframes: [{ at: 0, opacity: 0, offsetX: 120, offsetY: -90, scale: 1.15, rotate: 14 }, { at: 0.1, opacity: 0, offsetX: 126.983, offsetY: -95.237, scale: 1.159, rotate: 14.815 }, { at: 0.2, opacity: 0, offsetX: 120.247, offsetY: -90.186, scale: 1.15, rotate: 14.029 }, { at: 0.3, opacity: 0.128, offsetX: 104.612, offsetY: -78.459, scale: 1.131, rotate: 12.205 }, { at: 0.4, opacity: 0.303, offsetX: 83.583, offsetY: -62.687, scale: 1.104, rotate: 9.751 }, { at: 0.5, opacity: 0.5, offsetX: 60, offsetY: -45, scale: 1.075, rotate: 7 }, { at: 0.6, opacity: 0.697, offsetX: 36.417, offsetY: -27.313, scale: 1.046, rotate: 4.249 }, { at: 0.7, opacity: 0.872, offsetX: 15.388, offsetY: -11.541, scale: 1.019, rotate: 1.795 }, { at: 0.8, opacity: 1, offsetX: -0.247, offsetY: 0.186, scale: 1, rotate: -0.029 }, { at: 0.9, opacity: 1, offsetX: -6.983, offsetY: 5.237, scale: 0.991, rotate: -0.815 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/social/"
  }
}
