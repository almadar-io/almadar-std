app std-rasm-system-dada-cutout [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-dada-cutout — the Dada Cutout design system for a Rasm page, anchored on Hannah Hoch photomontage (Cut with the Kitchen Knife, 1919) (https://en.wikipedia.org/wiki/Hannah_H%C3%B6ch). Colour: #F1E7D0 ground, #1C1C1C ink, #3D5AFE accent. Type: Permanent Marker over Anybody. Grid: broken collage grid, no shared baselines. Motion: the scissor easing (cubic-bezier 0.30,-0.40,0.70,1.40); entrance: cutouts fly in from off-board and stick. Interaction: cutout peels at the corner. Imagery: cut photographs and type fragments. Voice: playful, irreverent, mixed type sizes. Components: buttons are cut paper labels; cards are scissored photos. Data: collage stickers counts. Sound: scissor snip on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "dada-cutout"
    palette: {background: "#F1E7D0", foreground: "#1C1C1C", card: "#F9F4EA", "card-foreground": "#1C1C1C", surface: "#EBE1CB", muted: "#E0D7C2", "muted-foreground": "#605D56", border: "#918C7F", input: "#878276", primary: "#3D5AFE", "primary-hover": "#344DD8", "primary-foreground": "#F1E7D0", secondary: "#F9F4EA", "secondary-foreground": "#1C1C1C", "secondary-hover": "#D7CFBA", accent: "#3D5AFE", "accent-foreground": "#F1E7D0", ring: "#3D5AFE", "series-1": "#3D5AFE", "series-2": "#2E3E98", "series-3": "#8E99E9", "series-4": "#5C5952", "series-5": "#5E6DBF"}
    fonts: { display: { family: "Permanent Marker", file: "https://almadar-kflow-assets.web.app/fonts/permanentmarker/PermanentMarker-Regular.ttf", generic: "sans-serif" }, body: { family: "Anybody", file: "https://almadar-kflow-assets.web.app/fonts/anybody/Anybody%5Bwdth%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn zn_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); } fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let edge = smoothstep(0.0, 0.06, px.uv.x) * smoothstep(1.0, 0.94, px.uv.x); var d = (1.0 - edge) * 0.08; d = d + step(0.9955, zn_h(floor(p / 1.5))) * 0.16; d = d + step(0.5, zn_h(vec2<f32>(floor(p.x / 3.0), 0.0))) * 0.012; let e = min(min(p.x, px.size.x - p.x), min(p.y, px.size.y - p.y)); d = d + (1.0 - smoothstep(0.5, 1.3, abs(e - 16.0))) * step(0.5, fract((p.x + p.y) / 18.0)) * 0.12; let tp = p - vec2<f32>(px.size.x * 0.1, 80.0); let tq = vec2<f32>(tp.x * cos(-0.35) - tp.y * sin(-0.35), tp.x * sin(-0.35) + tp.y * cos(-0.35)); let tape = step(abs(tq.x), 70.0) * step(abs(tq.y), 18.0); let c = mix(px.color.rgb + vec3<f32>(s * d), vec3<f32>(0.95, 0.88, 0.5), tape * 0.14); return vec4<f32>(c, px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [10, 0, 10, 0], kind: "bevel" } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 10, 0, 10], kind: "bevel" } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 3, corners: { radius: [12, 0, 12, 0], kind: "bevel" } },
        "stack/coupon/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, strokeDash: [12, 8], corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/clipping/idle": { fill: "card", corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(10,10,10,0.28)", blur: 30, offsetX: 0, offsetY: 14 } },
        "stack/bar/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "accent", textColor: "accent-foreground", stroke: "accent-foreground", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, font: "400 20px display", shadow: { color: "#0a0a0a", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/primary/hovered": { fill: "primary", textColor: "primary-foreground", stroke: "card", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, font: "400 20px display", shadow: { color: "#ff2d95", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/primary/pressed": { fill: "foreground", textColor: "background", stroke: "card", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, font: "400 20px display", spring: { stiffness: 480, damping: 22 } },
        "pressable/primary/focused": { stroke: "accent-foreground", strokeWidth: 3 },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, shadow: { color: "#0a0a0a", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 380, damping: 18 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, shadow: { color: "#ff2d95", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 380, damping: 18 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, shadow: { color: "#0a0a0a", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 380, damping: 18 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, shadow: { color: "#0a0a0a", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 480, damping: 22 } },
        "card/header/idle": { fill: "accent", corners: { radius: [6, 0, 0, 0], kind: "bevel" }, textColor: "accent-foreground", font: "400 18px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [6, 4] },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "bevel" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 6, 0, 6], kind: "bevel" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 6, 0, 0], kind: "bevel" }, textColor: "background", font: "400 18px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [10, 6] },
        "focus/ring/outer": { stroke: "accent", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "foreground", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "background", font: "400 28px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/label/idle": { textColor: "foreground", font: "400 15px body" },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, font: "400 20px display", spring: { stiffness: 380, damping: 18 } },
        "pressable/secondary/hovered": { fill: "muted", textColor: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 0, 6, 0], kind: "bevel" }, font: "400 20px display", spring: { stiffness: 380, damping: 18 } },
        "text/display/idle": { textColor: "foreground", font: "400 104px display" },
        "text/title/idle": { textColor: "foreground", font: "400 40px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 14px mono" },
        "text/body/idle": { textColor: "foreground", font: "500 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 28px display" },
        "morph/default/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet hx = min(s.x * 0.22, 60.0);\nlet qa = sg_rot(p - vec2<f32>(s.x * 0.3, c.y * 0.8), 0.14);\nlet da = max(abs(qa.y) - 11.0, abs(qa.x) - hx + abs(fract(qa.y / 5.0) - 0.5) * 4.0);\nlet qb = sg_rot(p - vec2<f32>(s.x * 0.7, c.y * 1.2), -0.12);\nlet db = max(abs(qb.y) - 11.0, abs(qb.x) - hx + abs(fract(qb.y / 5.0) - 0.5) * 4.0);\nlet ta = sg_fill(da) * 0.8;\nlet tb = sg_fill(db) * 0.85;\nlet col = mix(px.color.rgb * (0.9 + 0.1 * step(0.5, fract(qa.x / 6.0))), vec3<f32>(0.98, 0.86, 0.45), tb);\nreturn sg_out(px, col, max(ta, tb));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.3, ornament: "stamp", align: "start", imageTreatment: "grain", sectionGap: 80, gutter: 32 }
    motion: { signature: "scissor", stiffness: 380, damping: 18, stagger: 50, enterMs: 669, keyframes: [{ at: 0, opacity: 0, offsetX: -24, offsetY: 0, scale: 0.9, rotate: -1.5 }, { at: 0.1, opacity: 0, offsetX: -25.397, offsetY: 0, scale: 0.894, rotate: -1.587 }, { at: 0.2, opacity: 0, offsetX: -24.049, offsetY: 0, scale: 0.9, rotate: -1.503 }, { at: 0.3, opacity: 0.128, offsetX: -20.922, offsetY: 0, scale: 0.913, rotate: -1.308 }, { at: 0.4, opacity: 0.303, offsetX: -16.717, offsetY: 0, scale: 0.93, rotate: -1.045 }, { at: 0.5, opacity: 0.5, offsetX: -12, offsetY: 0, scale: 0.95, rotate: -0.75 }, { at: 0.6, opacity: 0.697, offsetX: -7.283, offsetY: 0, scale: 0.97, rotate: -0.455 }, { at: 0.7, opacity: 0.872, offsetX: -3.078, offsetY: 0, scale: 0.987, rotate: -0.192 }, { at: 0.8, opacity: 1, offsetX: 0.049, offsetY: 0, scale: 1, rotate: 0.003 }, { at: 0.9, opacity: 1, offsetX: 1.397, offsetY: 0, scale: 1.006, rotate: 0.087 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/social/"
  }
}
