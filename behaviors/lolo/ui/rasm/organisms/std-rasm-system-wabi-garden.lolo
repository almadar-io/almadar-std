app std-rasm-system-wabi-garden [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-wabi-garden — the Wabi Garden design system for a Rasm page, anchored on Muji retail graphics and Japanese wabi-sabi (https://en.wikipedia.org/wiki/Wabi-sabi). Colour: #F7F4EC ground, #2F2D2A ink, #8C6A43 accent. Type: Shippori Mincho over Zen Kaku Gothic New. Grid: asymmetric ma (empty space) grid, rule of thirds. Motion: the breath easing (cubic-bezier 0.37,0.00,0.63,1.00); entrance: content appears slowly with long pauses. Interaction: ink wash appears under the item. Imagery: ink wash and natural paper. Voice: quiet, few words, unhurried. Components: buttons are thin outlined tags; cards are unbordered paper. Data: single ink dots. Sound: singing bowl on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "wabi-garden"
    palette: {background: "#F7F4EC", foreground: "#2F2D2A", card: "#FBFAF6", "card-foreground": "#2F2D2A", surface: "#F1EEE6", muted: "#E7E4DC", "muted-foreground": "#5F5D58", border: "#8A8782", input: "#85827C", primary: "#7E5E38", "primary-hover": "#664B2C", "primary-foreground": "#F7F4EC", secondary: "#FBFAF6", "secondary-foreground": "#2F2D2A", "secondary-hover": "#E7E4DC", accent: "#8C6A43", "accent-foreground": "#FFFFFF", ring: "#664B2C", "series-1": "#2F2D2A", "series-2": "#8C6A43", "series-3": "#BCA88F", "series-4": "#6B6964", "series-5": "#624F38"}
    fonts: { display: { family: "Shippori Mincho", file: "https://almadar-kflow-assets.web.app/fonts/shipporimincho/ShipporiMincho-Regular.ttf", generic: "serif" }, body: { family: "Zen Kaku Gothic New", file: "https://almadar-kflow-assets.web.app/fonts/zenkakugothicnew/ZenKakuGothicNew-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn wb_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn wb_n(p: vec2<f32>) -> f32 { let i = floor(p); let f = fract(p); let u = f * f * (3.0 - 2.0 * f); return mix(mix(wb_h(i), wb_h(i + vec2<f32>(1.0, 0.0)), u.x), mix(wb_h(i + vec2<f32>(0.0, 1.0)), wb_h(i + vec2<f32>(1.0, 1.0)), u.x), u.y); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let gl = px.local - vec2<f32>(0.0, px.scroll * 20.0);\n  let grain = wb_n(gl * 0.8) * 0.6 + wb_n(gl * 0.17) * 0.4;\n  let fibre = wb_n(vec2<f32>(gl.x * 0.015, gl.y * 1.1));\n  var col = px.color.rgb - vec3<f32>((grain - 0.5) * 0.04 + (fibre - 0.5) * 0.012);\n  let c = vec2<f32>(0.78, 0.2);\n  let d = (px.uv - c) * vec2<f32>(asp, 1.0);\n  let edge = wb_n(gl * 0.05) * 0.18;\n  let wash = (1.0 - smoothstep(0.1, 0.34 + edge, length(d))) * (0.65 + 0.35 * wb_n(gl * 0.03));\n  col = mix(col, vec3<f32>(0.18, 0.17, 0.16), wash * 0.055);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let s = px.size;\n  let c = s * 0.5;\n  let m = min(s.x, s.y);\n  let d = p - c;\n  let r = length(d);\n  let t = (atan2(d.y, d.x) + 3.14159) / 6.28318;\n  let w = 1.2 + 6.0 * (1.0 - t);\n  let ring = 1.0 - smoothstep(w * 0.5 - 0.8, w * 0.5 + 0.8, abs(r - m * 0.3));\n  let dry = 0.62 + 0.38 * fract(sin(floor(p.x * 0.7) * 12.9 + floor(p.y * 0.7) * 78.2) * 43758.5);\n  let arc = ring * step(0.06, t) * step(t, 0.95) * mix(1.0, dry, smoothstep(0.55, 1.0, t));\n  return sg_out(px, px.color.rgb, arc);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", corners: { radius: [1, 1, 1, 1], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 34, offsetX: 0, offsetY: 4 } },
        "stack/panel/idle": { fill: "surface", corners: { radius: [1, 1, 1, 1], kind: "round" } },
        "stack/hero/idle": { corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "pressable/primary/hovered": { fill: "muted", textColor: "foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "pressable/primary/pressed": { fill: "muted", textColor: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 90, damping: 22 } },
        "pressable/primary/focused": { fill: "background", textColor: "foreground", stroke: "ring", strokeWidth: 2, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "pressable/secondary/idle": { fill: "background", textColor: "secondary-foreground", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "pressable/secondary/pressed": { fill: "muted", textColor: "secondary-foreground", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 90, damping: 22 } },
        "pressable/secondary/disabled": { fill: "background", textColor: "muted-foreground", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "pressable/secondary/focused": { fill: "background", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 2, corners: { radius: [2, 2, 2, 2], kind: "round" }, font: "400 14px body", spring: { stiffness: 70, damping: 20 } },
        "card/surface/idle": { fill: "card", corners: { radius: [1, 1, 1, 1], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 34, offsetX: 0, offsetY: 4 }, spring: { stiffness: 70, damping: 20 } },
        "card/surface/hovered": { fill: "surface", corners: { radius: [1, 1, 1, 1], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 52, offsetX: 0, offsetY: 8 }, spring: { stiffness: 70, damping: 20 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [1, 1, 1, 1], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 34, offsetX: 0, offsetY: 4 }, spring: { stiffness: 70, damping: 20 } },
        "card/surface/pressed": { fill: "muted", corners: { radius: [1, 1, 1, 1], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 20, offsetX: 0, offsetY: 2 }, spring: { stiffness: 90, damping: 22 } },
        "card/header/idle": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 0.5 },
        "card/media/idle": { fill: "surface", corners: { radius: [1, 1, 1, 1], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", corners: { radius: [1, 1, 1, 1], kind: "round" } },
        "panel/header/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 14px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 0.5 },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "border", strokeWidth: 0.5 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "text/display/idle": { textColor: "foreground", font: "400 72px display" },
        "text/title/idle": { textColor: "foreground", font: "400 34px display" },
        "text/eyebrow/idle": { textColor: "primary-hover", font: "400 13px body" },
        "text/body/idle": { textColor: "foreground", font: "400 16px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 20px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "foreground", font: "400 20px display", on: "section/band/idle" },
        "textfield/default/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/hovered": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/focused": { fill: "background", stroke: "ring", strokeWidth: 2, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px body" },
        "morph/default/idle": { fill: "muted" },
        "window/frame/idle": { fill: "card", stroke: "border", strokeWidth: 0.5, corners: { radius: [1, 1, 1, 1], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 40, offsetX: 0, offsetY: 6 } },
        "window/titlebar/idle": { fill: "surface", textColor: "foreground", font: "400 14px body", corners: { radius: [1, 1, 0, 0], kind: "round" } },
        "window/control/idle": { fill: "muted", stroke: "border", strokeWidth: 0.5, corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "material/water1/idle": { fill: "muted", corners: { radius: [20, 20, 20, 20], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 30, offsetX: 0, offsetY: 6 } },
        "material/water2/idle": { fill: "secondary", stroke: "border", strokeWidth: 0.5, corners: { radius: [20, 20, 20, 20], kind: "round" }, shadow: { color: "rgba(47,45,42,0.08)", blur: 30, offsetX: 0, offsetY: 6 } },
        "material/water3/idle": { fill: "accent", corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "material/water4/idle": { fill: "primary", corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" }
      }
    layout: { hero: "offset", columns: 12, asymmetry: 0.34, ornament: "none", align: "start", imageTreatment: "grain", sectionGap: 168, gutter: 56 }
    motion: { signature: "breath", stiffness: 60, damping: 22, stagger: 240, enterMs: 1700, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 14, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.024, offsetX: 0, offsetY: 13.663, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.094, offsetX: 0, offsetY: 12.682, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.204, offsetX: 0, offsetY: 11.142, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.344, offsetX: 0, offsetY: 9.184, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 7, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.656, offsetX: 0, offsetY: 4.816, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.796, offsetX: 0, offsetY: 2.858, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.906, offsetX: 0, offsetY: 1.318, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.976, offsetX: 0, offsetY: 0.337, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/notes/"
  }
}
