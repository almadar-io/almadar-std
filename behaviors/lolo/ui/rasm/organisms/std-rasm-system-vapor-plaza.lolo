app std-rasm-system-vapor-plaza [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-vapor-plaza — the Vapor Plaza design system for a Rasm page, anchored on Vaporwave aesthetic and Windows 95 UI (https://en.wikipedia.org/wiki/Vaporwave). Colour: #2B1055 ground, #FCE4FF ink, #00F0FF accent. Type: Audiowide over Varela Round. Grid: perspective floor grid with vanishing point. Motion: the vhs-drift easing (cubic-bezier 0.40,0.00,0.60,1.00); entrance: columns drift in opposite directions. Interaction: chromatic aberration on the card. Imagery: sunset gradients, marble busts, grid floors. Voice: ironic, dreamy, lower-case. Components: buttons are beveled 95-style; cards are windows with title bars. Data: gradient area charts. Sound: dial-up chirp on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "vapor-plaza"
    palette: {background: "#2B1055", foreground: "#FCE4FF", card: "#381D5F", "card-foreground": "#FCE4FF", surface: "#31165A", muted: "#3C2163", "muted-foreground": "#B9A0C9", border: "#896FA2", input: "#947AAA", primary: "#00F0FF", "primary-hover": "#26F2FF", "primary-foreground": "#2B1055", secondary: "#381D5F", "secondary-foreground": "#FCE4FF", "secondary-hover": "#442969", accent: "#00F0FF", "accent-foreground": "#2B1055", ring: "#00F0FF", "series-1": "#00F0FF", "series-2": "#71EBFF", "series-3": "#138BB3", "series-4": "#BDA4CC", "series-5": "#40B8BF"}
    fonts: { display: { family: "Audiowide", file: "https://almadar-kflow-assets.web.app/fonts/audiowide/Audiowide-Regular.ttf", generic: "sans-serif" }, body: { family: "Varela Round", file: "https://almadar-kflow-assets.web.app/fonts/varelaround/VarelaRound-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let hz = 0.62;\n let uv = px.uv;\n let asp = px.size.x / px.size.y;\n let p = vec2<f32>((uv.x - 0.5) * asp, uv.y - 0.42);\n let d = length(p);\n let sun = 1.0 - smoothstep(0.15, 0.153, d);\n let cut = select(1.0, step(0.35, fract(p.y * 30.0 - px.time * 0.05)), p.y > 0.02);\n let scol = mix(vec3<f32>(1.0, 0.85, 0.3), vec3<f32>(1.0, 0.24, 0.8), clamp((p.y + 0.15) / 0.3, 0.0, 1.0));\n c = mix(c, scol, sun * cut * 0.3);\n c = c + vec3<f32>(1.0, 0.24, 0.8) * 0.06 * exp(-d * 5.0);\n if (uv.y > hz) {\n  let dy = uv.y - hz;\n  let z = 0.1 / dy;\n  let gx = abs(fract((uv.x - 0.5 + (px.pointer.x / px.size.x - 0.5) * 0.1) * asp * z * 1.5 + 0.5) - 0.5);\n  let gz = abs(fract(z * 0.8 - px.time * 0.12 + px.scroll) - 0.5);\n  let w = 0.03 * z;\n  let l = max(1.0 - smoothstep(0.0, w, gx), 1.0 - smoothstep(0.0, 0.05, gz));\n  c = mix(c, vec3<f32>(0.0, 0.94, 1.0), l * 0.2 * smoothstep(0.0, 0.2, dy));\n }\n c = c + vec3<f32>(0.4, 0.1, 0.5) * 0.08 * smoothstep(0.45, hz, uv.y) * (1.0 - step(hz, uv.y));\n return vec4<f32>(c, px.color.a);\n}", params: [1, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "stack/closing/idle": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 120, damping: 24 } },
        "mirror/default/idle": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "pulse/title/idle": { fill: "primary", stroke: "primary", textColor: "primary-foreground", font: "700 14px mono" },
        "pulse/sub/idle": { fill: "card", stroke: "card", textColor: "muted-foreground", font: "500 13px mono" },
        "pulse/code/idle": { fill: "muted", stroke: "muted", textColor: "foreground", font: "500 15px mono" },
        "stack/code/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#00F0FF", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 120, damping: 24 } },
        "text/quote/idle": { textColor: "foreground", font: "500 16px mono", on: "stack/code/idle" },
        "material/rail/idle": { fill: "primary", corners: { radius: [3, 3, 3, 3], kind: "round" }, shadow: { color: "rgba(255,61,203,0.45)", blur: 14 } },
        "material/accept/idle": { fill: "primary", stroke: "secondary", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, shadow: { color: "rgba(255,61,203,0.5)", blur: 22, offsetX: 0, offsetY: 8 } },
        "stack/panel/idle": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#0B0320", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#FF3DCB", blur: 0, offsetX: -4, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#0B0320", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/idle": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#0B0320", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "#FF3DCB", strokeWidth: 2, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#00F0FF", blur: 0, offsetX: -4, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#0B0320", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/focused": { fill: "secondary", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [5, 5, 5, 5], kind: "bevel" }, font: "400 16px display", shadow: { color: "#0B0320", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "text/display/idle": { textColor: "foreground", font: "400 60px display" },
        "text/title/idle": { textColor: "foreground", font: "400 30px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "400 14px display" },
        "text/label/idle": { textColor: "primary-foreground", font: "400 14px display", on: "window/titlebar/idle" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 19px display", on: "card/surface/idle" },
        "card/surface/idle": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/hovered": { fill: "card", stroke: "#FF3DCB", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#00F0FF", blur: 0, offsetX: -6, offsetY: 3 }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 120, damping: 24 } },
        "card/header/idle": { fill: "primary", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "400 16px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "primary", strokeWidth: 2 },
        "card/media/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "panel/header/idle": { fill: "primary", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "400 16px display" },
        "panel/divider/idle": { stroke: "primary", strokeWidth: 2 },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "primary", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", stroke: "input", strokeWidth: 2, shadow: { color: "#0B0320", blur: 0, offsetX: -2, offsetY: -2 } },
        "textfield/default/hovered": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", stroke: "primary", strokeWidth: 2, shadow: { color: "#0B0320", blur: 0, offsetX: -2, offsetY: -2 } },
        "textfield/default/focused": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", stroke: "ring", strokeWidth: 3, shadow: { color: "#0B0320", blur: 0, offsetX: -2, offsetY: -2 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px body" },
        "morph/default/idle": { fill: "primary" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet hor = s.y * 0.58;\nlet below = step(hor, p.y);\nlet yn = max((p.y - hor) / max(s.y - hor, 1.0), 0.0001);\nlet z = 1.0 / (yn + 0.06);\nlet f = fract(z * 0.7);\nlet hl = (1.0 - smoothstep(0.03, 0.09, min(f, 1.0 - f))) * smoothstep(0.02, 0.1, yn);\nlet k = yn * 0.9 + 0.08;\nlet vx = (p.x - c.x) / k;\nlet f2 = fract(vx / 70.0);\nlet lv = 1.0 - smoothstep(0.8 / k, 1.8 / k, min(f2, 1.0 - f2) * 70.0);\nlet rs = min(s.y * 0.36, c.x * 0.8);\nlet sc = vec2<f32>(c.x, hor - rs * 0.55);\nlet sunk = clamp((p.y - (sc.y - rs * 0.1)) / max(rs * 1.2, 1.0), 0.0, 1.0);\nlet vis = step(sunk * 0.8, fract(p.y / 7.0));\nlet sun = sg_fill(length(p - sc) - rs) * step(p.y, hor) * vis;\nlet sunc = mix(vec3<f32>(1.0, 0.82, 0.3), vec3<f32>(1.0, 0.2, 0.6), clamp((p.y - (sc.y - rs)) / max(2.0 * rs, 1.0), 0.0, 1.0));\nlet grid = below * max(hl, lv) * 0.9;\nlet hz = sg_line(p.y - hor, 1.0);\nlet col = mix(vec3<f32>(0.3, 0.85, 1.0), sunc, sun);\nreturn sg_out(px, col, max(max(sun, grid), hz));\n}\n", params: [0, 0, 0, 0], live: false } },
        "window/frame/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF3DCB", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 120, damping: 24 } },
        "window/titlebar/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "400 14px display" },
        "window/control/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#0B0320", blur: 0, offsetX: 1, offsetY: 1 } },
        "stack/well/idle": { fill: "background", stroke: "input", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#0B0320", blur: 0, offsetX: -3, offsetY: -3 } }
      }
    layout: { hero: "full-bleed", columns: 4, asymmetry: 0.1, ornament: "frame", align: "center", imageTreatment: "scanline", sectionGap: 120, gutter: 40 }
    motion: { signature: "vhs-drift", stiffness: 120, damping: 24, stagger: 110, enterMs: 920, keyframes: [{ at: 0, opacity: 0, offsetX: 44, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.021, offsetX: 43.061, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.086, offsetX: 40.194, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.194, offsetX: 35.457, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.337, offsetX: 29.175, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 22, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.663, offsetX: 14.825, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.806, offsetX: 8.543, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.914, offsetX: 3.806, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.979, offsetX: 0.939, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/forum/"
  }
}
