app std-rasm-system-ledger-ruled [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-ledger-ruled — the Ledger Ruled design system for a Rasm page, anchored on Double-entry ledger paper (Pacioli, Summa 1494) and Boorum & Pease account books (https://en.wikipedia.org/wiki/Double-entry_bookkeeping). Colour: #F4F1E4 ground, #1E2A3A ink, #B3261E accent. Type: Spectral over IBM Plex Sans Condensed. Grid: baseline grid, 24px ruled lines, 4 money columns. Motion: the ledger-settle easing (cubic-bezier 0.30,0.00,0.20,1.00); entrance: rows ink in top to bottom along the ruling, left column first. Interaction: double underline appears under the row. Imagery: none: ruled columns only. Voice: dry, exact, numbers first, short declaratives. Components: buttons are ruled boxes with a stamped corner; cards are ledger pages with a red margin rule. Data: tabular figures, double-ruled totals. Sound: pencil tick on paper on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "ledger-ruled"
    palette: {background: "#F4F1E4", foreground: "#1E2A3A", card: "#FAF9F3", "card-foreground": "#1E2A3A", surface: "#EEEBDF", muted: "#E3E1D6", "muted-foreground": "#626A70", border: "#949798", input: "#898E8F", primary: "#B3261E", "primary-hover": "#98201A", "primary-foreground": "#F4F1E4", secondary: "#FAF9F3", "secondary-foreground": "#1E2A3A", "secondary-hover": "#DAD9D0", accent: "#B3261E", "accent-foreground": "#F4F1E4", ring: "#B3261E", "series-1": "#B3261E", "series-2": "#70282B", "series-3": "#D08177", "series-4": "#5E666D", "series-5": "#99534F"}
    fonts: { display: { family: "Spectral", file: "https://almadar-kflow-assets.web.app/fonts/spectral/Spectral-Regular.ttf", generic: "serif" }, body: { family: "IBM Plex Sans Condensed", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexsanscondensed/IBMPlexSansCondensed-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let navy = vec3<f32>(0.1, 0.25, 0.7);\n  let dots = 1.0 - smoothstep(0.7, 1.1, length(fract(px.local / 28.0) * 28.0 - vec2<f32>(14.0, 14.0)));\n  let band = smoothstep(0.55, 1.0, px.uv.x + (1.0 - px.uv.y) * 0.35 + px.scroll * 0.05);\n  let diag = abs(fract((px.local.x + px.local.y) / 90.0) - 0.5);\n  let hair = (1.0 - smoothstep(0.0, 0.006, 0.5 - diag)) * band;\n  var col = mix(px.color.rgb, navy, band * 0.05);\n  col = col - vec3<f32>(dots * 0.025 * band, dots * 0.025 * band, dots * 0.02 * band);\n  col = col - vec3<f32>(hair * 0.03, hair * 0.025, hair * 0.015);\n  let base = smoothstep(0.88, 1.0, px.uv.y);\n  col = mix(col, navy, base * 0.04);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", corners: { radius: [8, 8, 8, 8], kind: "round" }, stroke: "border", strokeWidth: 1, shadow: { color: "rgba(30,41,59,0.10)", blur: 22, offsetY: 8 } },
        "stack/panel/idle": { fill: "card", corners: { radius: [10, 10, 10, 10], kind: "round" }, stroke: "border", strokeWidth: 1, shadow: { color: "rgba(30,41,59,0.16)", blur: 40, offsetY: 16 } },
        "stack/closing/idle": { fill: "card", corners: { radius: [10, 10, 10, 10], kind: "round" }, stroke: "primary", strokeWidth: 2, shadow: { color: "rgba(30,41,59,0.16)", blur: 40, offsetY: 16 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", shadow: { color: "#1e3a8a", blur: 0, offsetY: 2 }, spring: { stiffness: 180, damping: 26 } },
        "pressable/primary/hovered": { fill: "primary-hover", corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", shadow: { color: "#172554", blur: 0, offsetY: 2 }, spring: { stiffness: 180, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary-hover", corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 180, damping: 26 } },
        "pressable/primary/focused": { stroke: "primary-foreground", strokeWidth: 2 },
        "pressable/secondary/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 180, damping: 26 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 180, damping: 26 } },
        "pressable/secondary/pressed": { stroke: "input", strokeWidth: 2 },
        "pressable/secondary/disabled": { stroke: "input" },
        "textfield/default/idle": { corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "textfield/default/hovered": { corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "toggle/check/off-idle": { stroke: "input" },
        "toggle/check/off-hovered": { stroke: "input" },
        "toggle/switch/off-idle": { stroke: "input" },
        "toggle/switch/off-hovered": { stroke: "input" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-hovered": { stroke: "input" },
        "range/default/thumb-idle": { stroke: "input" },
        "card/surface/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(30,41,59,0.07)", blur: 10, offsetY: 2 }, spring: { stiffness: 180, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(30,41,59,0.12)", blur: 18, offsetY: 4 }, spring: { stiffness: 180, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(30,41,59,0.12)", blur: 18, offsetY: 4 }, spring: { stiffness: 180, damping: 26 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(30,41,59,0.05)", blur: 4, offsetY: 1 }, spring: { stiffness: 240, damping: 28 } },
        "card/header/idle": { fill: "muted", corners: { radius: [4, 4, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [4, 4, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "700 96px display", spring: { stiffness: 180, damping: 26 } },
        "text/numeral/idle": { textColor: "primary", font: "700 120px display" },
        "ornament/rule/idle": { fill: "foreground" },
        "text/title/idle": { textColor: "foreground", font: "400 34px display", spring: { stiffness: 180, damping: 26 } },
        "text/eyebrow/idle": { textColor: "primary", font: "600 13px body", spring: { stiffness: 180, damping: 26 } },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body", spring: { stiffness: 180, damping: 26 } },
        "text/card/idle": { textColor: "card-foreground", font: "600 20px display" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "600 16px body", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px body" },
        "text/label/idle": { textColor: "foreground", font: "600 14px body" },
        "text/quote/idle": { textColor: "foreground", font: "400 34px display" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nvar a = 0.0;\nlet bw = min(s.x * 0.1, 28.0);\nfor (var i = 0; i < 5; i = i + 1) {\n  let f = f32(i);\n  let bx = c.x + (f - 2.0) * bw * 1.6;\n  let bh = s.y * (0.22 + 0.13 * f);\n  let d = sg_box(p - vec2<f32>(bx, s.y - 8.0 - bh * 0.5), vec2<f32>(bw * 0.5, bh * 0.5));\n  a = max(a, sg_fill(d) * (0.4 + 0.15 * f));\n}\na = max(a, sg_line(p.y - (s.y - 6.0), 0.8));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.0, ornament: "rule", align: "start", imageTreatment: "duotone", sectionGap: 96, gutter: 48 }
    motion: { signature: "ledger-settle", stiffness: 180, damping: 26, stagger: 60, enterMs: 380, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 22, scale: 1.04, rotate: 0 }, { at: 0.1, opacity: 0.047, offsetX: 0, offsetY: 20.972, scale: 1.038, rotate: 0 }, { at: 0.2, opacity: 0.223, offsetX: 0, offsetY: 17.096, scale: 1.031, rotate: 0 }, { at: 0.3, opacity: 0.472, offsetX: 0, offsetY: 11.623, scale: 1.021, rotate: 0 }, { at: 0.4, opacity: 0.666, offsetX: 0, offsetY: 7.342, scale: 1.013, rotate: 0 }, { at: 0.5, opacity: 0.797, offsetX: 0, offsetY: 4.463, scale: 1.008, rotate: 0 }, { at: 0.6, opacity: 0.884, offsetX: 0, offsetY: 2.55, scale: 1.005, rotate: 0 }, { at: 0.7, opacity: 0.941, offsetX: 0, offsetY: 1.3, scale: 1.002, rotate: 0 }, { at: 0.8, opacity: 0.976, offsetX: 0, offsetY: 0.53, scale: 1.001, rotate: 0 }, { at: 0.9, opacity: 0.994, offsetX: 0, offsetY: 0.123, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/accounting/"
  }
}
