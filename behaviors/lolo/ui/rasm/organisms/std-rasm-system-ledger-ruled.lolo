app std-rasm-system-ledger-ruled [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-ledger-ruled — the Ledger Ruled design system for a Rasm page, anchored on Double-entry ledger paper (Pacioli, Summa 1494) and Boorum & Pease account books (https://en.wikipedia.org/wiki/Double-entry_bookkeeping). Colour: #F4F1E4 ground, #1E2A3A ink, #B3261E accent. Type: Spectral over IBM Plex Sans Condensed. Grid: baseline grid, 24px ruled lines, 4 money columns. Motion: the ledger-settle easing (cubic-bezier 0.30,0.00,0.20,1.00); entrance: rows ink in top to bottom along the ruling, left column first. Interaction: double underline appears under the row. Imagery: none: ruled columns only. Voice: dry, exact, numbers first, short declaratives. Components: buttons are ruled boxes with a stamped corner; cards are ledger pages with a red margin rule. Data: tabular figures, double-ruled totals. Sound: pencil tick on paper on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "ledger-ruled"
    palette: { background: "#F4F1E4", foreground: "#1E2A3A", card: "#FAF9F3", "card-foreground": "#1E2A3A", surface: "#EEEBDF", muted: "#E3E1D6", "muted-foreground": "#4F5860", border: "#7F8486", input: "#767B7D", primary: "#B3261E", "primary-hover": "#98201A", "primary-foreground": "#F4F1E4", secondary: "#FAF9F3", "secondary-foreground": "#1E2A3A", "secondary-hover": "#DAD9D0", accent: "#B3261E", "accent-foreground": "#F4F1E4", ring: "#B3261E", "series-1": "#B3261E", "series-2": "#1E2A3A", "series-3": "#5C7894", "series-4": "#8A7A4A", "series-5": "#6B6F72" }
    fonts: { display: { family: "Spectral", file: "https://almadar-kflow-assets.web.app/fonts/spectral/Spectral-Regular.ttf", generic: "serif" }, body: { family: "IBM Plex Sans Condensed", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexsanscondensed/IBMPlexSansCondensed-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let y = px.local.y - px.scroll * 40.0;\n  let ly = abs(fract(y / 24.0) - 0.5);\n  let line = 1.0 - smoothstep(0.0, 0.03, 0.5 - ly);\n  let mx = abs(px.local.x - 72.0);\n  let margin = 1.0 - smoothstep(0.5, 1.5, mx);\n  let col = mix(mix(px.color.rgb, vec3<f32>(0.42, 0.52, 0.68), line * 0.26), vec3<f32>(0.70, 0.15, 0.12), margin * 0.5);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, inset: { stroke: "primary", strokeWidth: 1, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 4 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "card", stroke: "primary", strokeWidth: 2, inset: { stroke: "primary", strokeWidth: 1, gap: 5 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 200, damping: 30 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 1, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 200, damping: 30 }, shadow: { color: "rgba(179,38,30,1)", blur: 0, offsetY: 3 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 1, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 5 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 260, damping: 34 } },
        "pressable/primary/focused": { fill: "primary", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 200, damping: 30 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 200, damping: 30 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 200, damping: 30 }, shadow: { color: "rgba(179,38,30,1)", blur: 0, offsetY: 3 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 260, damping: 34 } },
        "pressable/secondary/focused": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "secondary-foreground", font: "500 15px body", spring: { stiffness: 200, damping: 30 } },
        "pressable/secondary/disabled": { fill: "background", stroke: "input", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 8, 0], kind: "notch" }, textColor: "muted-foreground", font: "500 15px body", spring: { stiffness: 200, damping: 30 } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 200, damping: 30 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 200, damping: 30 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 200, damping: 30 } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-hovered": { stroke: "foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, inset: { stroke: "primary", strokeWidth: 1, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "hairline-notch", spring: { stiffness: 200, damping: 30 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1, inset: { stroke: "primary", strokeWidth: 1, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "hairline-notch", spring: { stiffness: 200, damping: 30 }, shadow: { color: "rgba(179,38,30,1)", blur: 0, offsetY: 3 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 1, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "hairline-notch", spring: { stiffness: 200, damping: 30 } },
        "card/surface/pressed": { fill: "surface", stroke: "border", strokeWidth: 1, inset: { stroke: "primary", strokeWidth: 1, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "hairline-notch", spring: { stiffness: 260, damping: 34 } },
        "card/header/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 4 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 14px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "600 88px display", spring: { stiffness: 200, damping: 30 } },
        "text/numeral/idle": { textColor: "primary", font: "400 112px display" },
        "text/title/idle": { textColor: "foreground", font: "600 34px display", spring: { stiffness: 200, damping: 30 } },
        "text/eyebrow/idle": { textColor: "primary", font: "600 13px body", spring: { stiffness: 200, damping: 30 } },
        "text/body/idle": { textColor: "foreground", font: "400 18px body", spring: { stiffness: 200, damping: 30 } },
        "text/card/idle": { textColor: "card-foreground", font: "600 20px display" },
        "text/inverse/idle": { textColor: "background", font: "600 16px body", on: "section/band/idle" },
        "text/caption/idle": { textColor: "foreground", font: "400 14px body" },
        "text/label/idle": { textColor: "foreground", font: "600 14px body" },
        "text/quote/idle": { textColor: "foreground", font: "400 32px display" },
        "ornament/rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> { let c = px.size.y * 0.5; let a = max(sg_line(px.local.y - c + 2.5, 0.5), sg_line(px.local.y - c - 2.5, 0.5)); return sg_out(px, px.color.rgb, a); }\n", params: [0, 0, 0, 0], live: false } },
        "ornament/double-rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> { let c = px.size.y * 0.5; let a = max(sg_line(px.local.y - c + 2.5, 0.5), sg_line(px.local.y - c - 2.5, 0.5)); return sg_out(px, px.color.rgb, a); }\n", params: [0, 0, 0, 0], live: false } },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 1 },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = px.size.y * 0.5;\n  let col = floor(px.local.x / max(px.size.x / 4.0, 1.0));\n  let colEdge = sg_line(px.local.x - (col + 1.0) * px.size.x / 4.0, 0.5) * step(col, 2.5);\n  let rows = abs(fract(px.local.y / 24.0) - 0.5);\n  let tick = (1.0 - smoothstep(0.0, 0.04, 0.5 - rows)) * 0.25;\n  let top = sg_line(px.local.y - c + 2.5, 0.5);\n  let bot = sg_line(px.local.y - c - 2.5, 0.5);\n  return sg_out(px, px.color.rgb, max(max(colEdge * 0.6, tick), max(top, bot)));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0, ornament: "double-rule", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 24 }
    motion: { signature: "ledger-settle", stiffness: 200, damping: 30, stagger: 72, enterMs: 420, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -14, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.047, offsetX: 0, offsetY: -13.346, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.223, offsetX: 0, offsetY: -10.879, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.472, offsetX: 0, offsetY: -7.397, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.666, offsetX: 0, offsetY: -4.672, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.797, offsetX: 0, offsetY: -2.84, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.884, offsetX: 0, offsetY: -1.622, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.941, offsetX: 0, offsetY: -0.827, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.976, offsetX: 0, offsetY: -0.337, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.994, offsetX: 0, offsetY: -0.078, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/accounting/"
  }
}
