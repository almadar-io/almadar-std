app std-rasm-system-memphis-pulse [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-memphis-pulse — the Memphis Pulse design system for a Rasm page, anchored on Memphis Group (Ettore Sottsass, 1981) (https://en.wikipedia.org/wiki/Memphis_Group). Colour: #FFF6E9 ground, #1B1B1B ink, #00B8A9 accent. Type: Bungee over Poppins. Grid: tilted collage grid, 15 degree offsets. Motion: the jump easing (cubic-bezier 0.50,-0.60,0.50,1.60); entrance: shapes jump in with anticipation. Interaction: squiggle wiggles. Imagery: squiggles, confetti, terrazzo. Voice: energetic, coach voice, imperative. Components: buttons are bold pills with offset patterns; cards are tilted panels. Data: chunky pie charts. Sound: gym whistle chirp on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "memphis-pulse"
    palette: {background: "#FFF6E9", foreground: "#1B1B1B", card: "#FFFBF5", "card-foreground": "#1B1B1B", surface: "#F8EFE3", muted: "#EDE4D9", "muted-foreground": "#5A5753", border: "#6E6A64", input: "#6A665F", primary: "#00B8A9", "primary-hover": "#009C90", "primary-foreground": "#1B1B1B", secondary: "#FFFBF5", "secondary-foreground": "#1B1B1B", "secondary-hover": "#FFE3F0", accent: "#00B8A9", "accent-foreground": "#1B1B1B", ring: "#B0125E", "series-1": "#00B8A9", "series-2": "#FF5CA8", "series-3": "#FFC93C", "series-4": "#6A4CC9", "series-5": "#1B1B1B"}
    fonts: { display: { family: "Bungee", file: "https://almadar-kflow-assets.web.app/fonts/bungee/Bungee-Regular.ttf", generic: "sans-serif" }, body: { family: "Poppins", file: "https://almadar-kflow-assets.web.app/fonts/poppins/Poppins-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [30, 6, 30, 6], kind: "bevel" }, shadow: { color: "#00B8A9", blur: 0, offsetX: 9, offsetY: 9 } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 30, 6, 30], kind: "bevel" }, shadow: { color: "#FF5CA8", blur: 0, offsetX: 8, offsetY: 8 } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 3, corners: { radius: [44, 8, 44, 8], kind: "bevel" } },
        "stack/bar/idle": { fill: "#FF5CA8", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" } },
        "stack/closing/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [44, 8, 44, 8], kind: "bevel" }, shadow: { color: "#FFC93C", blur: 0, offsetX: 12, offsetY: 12 } },
        "mirror/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [30, 6, 30, 6], kind: "bevel" }, shadow: { color: "#FF5CA8", blur: 0, offsetX: 10, offsetY: 10 } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 260, damping: 9 }, shadow: { color: "#FF5CA8", blur: 0, offsetX: 6, offsetY: 6 } },
        "pressable/primary/hovered": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 300, damping: 7 }, shadow: { color: "#FF5CA8", blur: 0, offsetX: -6, offsetY: 6 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 420, damping: 10 }, shadow: { color: "#FF5CA8", blur: 0, offsetX: 1, offsetY: 1 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 5, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 260, damping: 9 }, shadow: { color: "#FF5CA8", blur: 0, offsetX: 6, offsetY: 6 } },
        "pressable/secondary/idle": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 260, damping: 9 }, shadow: { color: "#FFC93C", blur: 0, offsetX: 6, offsetY: 6 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 300, damping: 7 }, shadow: { color: "#FFC93C", blur: 0, offsetX: -6, offsetY: 6 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 420, damping: 10 }, shadow: { color: "#FFC93C", blur: 0, offsetX: 1, offsetY: 1 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "input", strokeWidth: 2, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 260, damping: 9 } },
        "pressable/secondary/focused": { fill: "secondary", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 5, corners: { radius: [40, 40, 40, 40], kind: "round" }, font: "400 17px display", spring: { stiffness: 260, damping: 9 }, shadow: { color: "#FFC93C", blur: 0, offsetX: 6, offsetY: 6 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [28, 6, 28, 6], kind: "bevel" }, shadow: { color: "#00B8A9", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 260, damping: 9 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 28, 6, 28], kind: "bevel" }, shadow: { color: "#FF5CA8", blur: 0, offsetX: -8, offsetY: 8 }, spring: { stiffness: 300, damping: 7 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 5, corners: { radius: [28, 6, 28, 6], kind: "bevel" }, shadow: { color: "#00B8A9", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 260, damping: 9 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [28, 6, 28, 6], kind: "bevel" }, shadow: { color: "#00B8A9", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 420, damping: 10 } },
        "card/header/idle": { fill: "#FF5CA8", corners: { radius: [28, 0, 28, 0], kind: "bevel" }, textColor: "foreground", font: "400 15px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [2, 9] },
        "card/media/idle": { fill: "surface", corners: { radius: [28, 0, 28, 0], kind: "bevel" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 28, 6, 28], kind: "bevel" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 28, 6, 28], kind: "bevel" }, textColor: "card", font: "400 15px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [2, 9] },
        "section/band/idle": { fill: "#FF5CA8" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [2, 9] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "text/display/idle": { textColor: "foreground", font: "400 80px display" },
        "text/title/idle": { textColor: "foreground", font: "400 38px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "600 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 24px display" },
        "text/numeral/idle": { textColor: "foreground", font: "400 104px display" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 14px body" },
        "textfield/default/idle": { fill: "card", corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "foreground", strokeWidth: 3, spring: { stiffness: 260, damping: 9 } },
        "textfield/default/hovered": { fill: "card", corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "primary-hover", strokeWidth: 3, spring: { stiffness: 300, damping: 7 } },
        "textfield/default/focused": { fill: "card", corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "ring", strokeWidth: 4, spring: { stiffness: 260, damping: 9 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "500 16px body" },
        "morph/default/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [30, 30, 30, 30], kind: "round" } },
        "material/tile0/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [20, 4, 20, 4], kind: "bevel" }, shadow: { color: "#1B1B1B", blur: 0, offsetX: 5, offsetY: 5 } },
        "material/tile1/idle": { fill: "#FF5CA8", stroke: "foreground", strokeWidth: 3, corners: { radius: [4, 20, 4, 20], kind: "bevel" }, shadow: { color: "#1B1B1B", blur: 0, offsetX: 5, offsetY: 5 } },
        "material/tile2/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [20, 4, 20, 4], kind: "bevel" }, shadow: { color: "#1B1B1B", blur: 0, offsetX: 5, offsetY: 5 } },
        "material/tile3/idle": { fill: "#FFC93C", stroke: "foreground", strokeWidth: 3, corners: { radius: [4, 20, 4, 20], kind: "bevel" }, shadow: { color: "#1B1B1B", blur: 0, offsetX: 5, offsetY: 5 } },
        "material/slot/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" }, strokeDash: [3, 6] },
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn mp_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); } fn shade(px: Pixel) -> vec4<f32> { let p = px.local + vec2<f32>(px.time * 3.0, px.time * 1.5); let id = floor(p / 120.0); var q = fract(p / 120.0) - 0.5; let h1 = mp_h(id); let h2 = mp_h(id + vec2<f32>(7.3, 1.9)); let h3 = mp_h(id + vec2<f32>(3.1, 9.7)); let ang = h2 * 6.2832 + px.time * 0.15 * (h2 - 0.5); q = vec2<f32>(q.x * cos(ang) - q.y * sin(ang), q.x * sin(ang) + q.y * cos(ang)); let kind = floor(h1 * 5.0); let ring = 1.0 - smoothstep(0.012, 0.03, abs(length(q) - 0.17)); let dotm = 1.0 - smoothstep(0.07, 0.09, length(q)); let squig = (1.0 - smoothstep(0.015, 0.03, abs(q.y - 0.07 * sin(q.x * 28.0)))) * (1.0 - smoothstep(0.28, 0.3, abs(q.x))); let plus = max((1.0 - smoothstep(0.015, 0.03, abs(q.x))) * (1.0 - smoothstep(0.2, 0.22, abs(q.y))), (1.0 - smoothstep(0.015, 0.03, abs(q.y))) * (1.0 - smoothstep(0.2, 0.22, abs(q.x)))); let zz = (1.0 - smoothstep(0.015, 0.03, abs(q.y - 0.1 * (abs(fract(q.x * 4.0) - 0.5) * 4.0 - 1.0)))) * (1.0 - smoothstep(0.28, 0.3, abs(q.x))); var m = select(0.0, ring, kind < 0.5); m = m + select(0.0, dotm, kind > 0.5 && kind < 1.5); m = m + select(0.0, squig, kind > 1.5 && kind < 2.5); m = m + select(0.0, plus, kind > 2.5 && kind < 3.5); m = m + select(0.0, zz, kind > 3.5); let k = floor(mp_h(id + vec2<f32>(5.5, 2.2)) * 4.0); let col = select(select(select(vec3<f32>(1.0, 0.4, 0.7), vec3<f32>(0.1, 0.8, 0.75), k > 0.5), vec3<f32>(1.0, 0.85, 0.2), k > 1.5), vec3<f32>(0.5, 0.35, 0.9), k > 2.5); let has = step(0.45, h3); return vec4<f32>(mix(px.color.rgb, col, clamp(m, 0.0, 1.0) * has * 0.16), px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn sg_tri(p: vec2<f32>, r: f32) -> f32 { return max(p.y - 0.5 * r, max(dot(p, vec2<f32>(0.866, -0.5)), dot(p, vec2<f32>(-0.866, -0.5))) - 0.5 * r); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nvar col = px.color.rgb;\nvar a = 0.0;\nlet y0 = s.y * 0.7 + sin(p.x * 0.22) * 5.0;\na = max(a, sg_line(p.y - y0, 2.0) * step(s.x * 0.1, p.x) * step(p.x, s.x * 0.5));\nlet t1 = sg_fill(sg_tri(p - vec2<f32>(s.x * 0.72, s.y * 0.35), m * 0.2));\ncol = mix(col, vec3<f32>(1.0, 0.4, 0.7), t1);\na = max(a, t1);\nlet t2 = sg_fill(sg_tri(sg_rot(p - vec2<f32>(s.x * 0.85, s.y * 0.7), 0.6), m * 0.12));\ncol = mix(col, vec3<f32>(0.1, 0.8, 0.75), t2);\na = max(a, t2);\nlet qd = fract(p / 12.0) - vec2<f32>(0.5, 0.5);\nlet region = step(abs(p.x - s.x * 0.2), 30.0) * step(abs(p.y - s.y * 0.3), 20.0);\na = max(a, sg_fill(length(qd) * 12.0 - 2.5) * region);\nlet cr = sg_line(length(p - vec2<f32>(s.x * 0.45, s.y * 0.3)) - m * 0.14, 2.5);\ncol = mix(col, vec3<f32>(1.0, 0.85, 0.2), cr);\na = max(a, cr);\nreturn sg_out(px, col, a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.45, ornament: "none", align: "start", imageTreatment: "grain", sectionGap: 80, gutter: 28 }
    motion: { signature: "jump", stiffness: 300, damping: 7, stagger: 55, enterMs: 780, keyframes: [{ at: 0, opacity: 0, offsetX: -18, offsetY: 64, scale: 0.62, rotate: 14 }, { at: 0.1, opacity: 0, offsetX: -19.581, offsetY: 69.621, scale: 0.587, rotate: 15.23 }, { at: 0.2, opacity: 0, offsetX: -19.766, offsetY: 70.279, scale: 0.583, rotate: 15.374 }, { at: 0.3, opacity: 0, offsetX: -18.143, offsetY: 64.508, scale: 0.617, rotate: 14.111 }, { at: 0.4, opacity: 0.2, offsetX: -14.409, offsetY: 51.232, scale: 0.696, rotate: 11.207 }, { at: 0.5, opacity: 0.5, offsetX: -9, offsetY: 32, scale: 0.81, rotate: 7 }, { at: 0.6, opacity: 0.8, offsetX: -3.591, offsetY: 12.768, scale: 0.924, rotate: 2.793 }, { at: 0.7, opacity: 1, offsetX: 0.143, offsetY: -0.508, scale: 1.003, rotate: -0.111 }, { at: 0.8, opacity: 1, offsetX: 1.766, offsetY: -6.279, scale: 1.037, rotate: -1.374 }, { at: 0.9, opacity: 1, offsetX: 1.581, offsetY: -5.621, scale: 1.033, rotate: -1.23 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/fitness/"
  }
}
