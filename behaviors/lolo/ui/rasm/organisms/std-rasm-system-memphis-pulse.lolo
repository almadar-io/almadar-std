app std-rasm-system-memphis-pulse [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-memphis-pulse — the Memphis Pulse design system for a Rasm page, anchored on Memphis Group (Ettore Sottsass, 1981) (https://en.wikipedia.org/wiki/Memphis_Group). Colour: #FFF6E9 ground, #1B1B1B ink, #00B8A9 accent. Type: Bungee over Poppins. Grid: tilted collage grid, 15 degree offsets. Motion: the jump easing (cubic-bezier 0.50,-0.60,0.50,1.60); entrance: shapes jump in with anticipation. Interaction: squiggle wiggles. Imagery: squiggles, confetti, terrazzo. Voice: energetic, coach voice, imperative. Components: buttons are bold pills with offset patterns; cards are tilted panels. Data: chunky pie charts. Sound: gym whistle chirp on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "memphis-pulse"
    palette: {background: "#FFF6E9", foreground: "#1B1B1B", card: "#FFFBF5", "card-foreground": "#1B1B1B", surface: "#F8EFE3", muted: "#EDE4D9", "muted-foreground": "#64615D", border: "#98938C", input: "#8D8982", primary: "#00B8A9", "primary-hover": "#009C90", "primary-foreground": "#1B1B1B", secondary: "#FFFBF5", "secondary-foreground": "#1B1B1B", "secondary-hover": "#E4DCD0", accent: "#00B8A9", "accent-foreground": "#1B1B1B", ring: "#00B8A9", "series-1": "#00B8A9", "series-2": "#0C7169", "series-3": "#73D4C6", "series-4": "#5F5D59", "series-5": "#409C94"}
    fonts: { display: { family: "Bungee", file: "https://almadar-kflow-assets.web.app/fonts/bungee/Bungee-Regular.ttf", generic: "sans-serif" }, body: { family: "Poppins", file: "https://almadar-kflow-assets.web.app/fonts/poppins/Poppins-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn mp_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); } fn shade(px: Pixel) -> vec4<f32> { let p = px.local + vec2<f32>(px.time * 3.0, px.time * 1.5); let id = floor(p / 120.0); var q = fract(p / 120.0) - 0.5; let h1 = mp_h(id); let h2 = mp_h(id + vec2<f32>(7.3, 1.9)); let h3 = mp_h(id + vec2<f32>(3.1, 9.7)); let ang = h2 * 6.2832 + px.time * 0.15 * (h2 - 0.5); q = vec2<f32>(q.x * cos(ang) - q.y * sin(ang), q.x * sin(ang) + q.y * cos(ang)); let kind = floor(h1 * 5.0); let ring = 1.0 - smoothstep(0.012, 0.03, abs(length(q) - 0.17)); let dotm = 1.0 - smoothstep(0.07, 0.09, length(q)); let squig = (1.0 - smoothstep(0.015, 0.03, abs(q.y - 0.07 * sin(q.x * 28.0)))) * (1.0 - smoothstep(0.28, 0.3, abs(q.x))); let plus = max((1.0 - smoothstep(0.015, 0.03, abs(q.x))) * (1.0 - smoothstep(0.2, 0.22, abs(q.y))), (1.0 - smoothstep(0.015, 0.03, abs(q.y))) * (1.0 - smoothstep(0.2, 0.22, abs(q.x)))); let zz = (1.0 - smoothstep(0.015, 0.03, abs(q.y - 0.1 * (abs(fract(q.x * 4.0) - 0.5) * 4.0 - 1.0)))) * (1.0 - smoothstep(0.28, 0.3, abs(q.x))); var m = select(0.0, ring, kind < 0.5); m = m + select(0.0, dotm, kind > 0.5 && kind < 1.5); m = m + select(0.0, squig, kind > 1.5 && kind < 2.5); m = m + select(0.0, plus, kind > 2.5 && kind < 3.5); m = m + select(0.0, zz, kind > 3.5); let k = floor(mp_h(id + vec2<f32>(5.5, 2.2)) * 4.0); let col = select(select(select(vec3<f32>(1.0, 0.4, 0.7), vec3<f32>(0.1, 0.8, 0.75), k > 0.5), vec3<f32>(1.0, 0.85, 0.2), k > 1.5), vec3<f32>(0.5, 0.35, 0.9), k > 2.5); let has = step(0.45, h3); return vec4<f32>(mix(px.color.rgb, col, clamp(m, 0.0, 1.0) * has * 0.16), px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [18, 18, 18, 18], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 7, offsetY: 7 } },
        "stack/closing/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 10, offsetY: 10 } },
        "mirror/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [22, 22, 22, 22], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 10, offsetY: 10 } },
        "text/numeral/idle": { textColor: "primary", font: "400 96px display" },
        "material/slot/idle": { fill: "background", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "material/tile0/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 4, offsetY: 4 } },
        "material/tile1/idle": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 4, offsetY: 4 } },
        "material/tile2/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 4, offsetY: 4 } },
        "material/tile3/idle": { fill: "ring", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, shadow: { color: "rgba(20,16,31,0.9)", blur: 0, offsetX: 4, offsetY: 4 } },
        "text/caption/idle": { textColor: "foreground", font: "500 14px body" },
        "stack/panel/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.85)", blur: 0, offsetX: 6, offsetY: 6 } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", shadow: { color: "rgba(0,0,0,0.85)", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 260, damping: 9 } },
        "pressable/primary/hovered": { fill: "accent", textColor: "accent-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", shadow: { color: "rgba(0,0,0,0.85)", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 260, damping: 9 } },
        "pressable/primary/pressed": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", spring: { stiffness: 340, damping: 12 } },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", spring: { stiffness: 260, damping: 9 } },
        "pressable/secondary/hovered": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", spring: { stiffness: 260, damping: 9 } },
        "text/display/idle": { textColor: "foreground", font: "400 84px display" },
        "text/title/idle": { textColor: "primary", font: "400 32px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "500 13px body" },
        "text/body/idle": { textColor: "foreground", font: "500 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 22px display" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#14101f", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 260, damping: 9 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#d81b7a", blur: 0, offsetX: 9, offsetY: 9 }, spring: { stiffness: 260, damping: 9 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#14101f", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 260, damping: 9 } },
        "card/surface/pressed": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#14101f", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 340, damping: 12 } },
        "card/header/idle": { fill: "accent", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "400 15px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "card/media/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#14101f", blur: 0, offsetX: 6, offsetY: 6 } },
        "panel/header/idle": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "400 15px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "section/band/idle": { fill: "accent" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", shadow: { color: "#14101f", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 260, damping: 9 } },
        "pressable/secondary/focused": { fill: "background", textColor: "foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "400 16px display", spring: { stiffness: 260, damping: 9 } },
        "textfield/default/idle": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "input", strokeWidth: 3, spring: { stiffness: 260, damping: 9 } },
        "textfield/default/hovered": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "primary", strokeWidth: 3, spring: { stiffness: 260, damping: 9 } },
        "textfield/default/focused": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", stroke: "ring", strokeWidth: 3, spring: { stiffness: 260, damping: 9 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "500 16px body" },
        "morph/default/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn sg_tri(p: vec2<f32>, r: f32) -> f32 { return max(p.y - 0.5 * r, max(dot(p, vec2<f32>(0.866, -0.5)), dot(p, vec2<f32>(-0.866, -0.5))) - 0.5 * r); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nvar col = px.color.rgb;\nvar a = 0.0;\nlet y0 = s.y * 0.7 + sin(p.x * 0.22) * 5.0;\na = max(a, sg_line(p.y - y0, 2.0) * step(s.x * 0.1, p.x) * step(p.x, s.x * 0.5));\nlet t1 = sg_fill(sg_tri(p - vec2<f32>(s.x * 0.72, s.y * 0.35), m * 0.2));\ncol = mix(col, vec3<f32>(1.0, 0.4, 0.7), t1);\na = max(a, t1);\nlet t2 = sg_fill(sg_tri(sg_rot(p - vec2<f32>(s.x * 0.85, s.y * 0.7), 0.6), m * 0.12));\ncol = mix(col, vec3<f32>(0.1, 0.8, 0.75), t2);\na = max(a, t2);\nlet qd = fract(p / 12.0) - vec2<f32>(0.5, 0.5);\nlet region = step(abs(p.x - s.x * 0.2), 30.0) * step(abs(p.y - s.y * 0.3), 20.0);\na = max(a, sg_fill(length(qd) * 12.0 - 2.5) * region);\nlet cr = sg_line(length(p - vec2<f32>(s.x * 0.45, s.y * 0.3)) - m * 0.14, 2.5);\ncol = mix(col, vec3<f32>(1.0, 0.85, 0.2), cr);\na = max(a, cr);\nreturn sg_out(px, col, a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.35, ornament: "none", align: "start", imageTreatment: "duotone", sectionGap: 88, gutter: 36 }
    motion: { signature: "jump", stiffness: 260, damping: 9, stagger: 45, enterMs: 832, keyframes: [{ at: 0, opacity: 0, offsetX: 32, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0, offsetX: 34.811, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0, offsetX: 35.14, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0, offsetX: 32.254, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.2, offsetX: 25.616, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 16, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.8, offsetX: 6.384, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 1, offsetX: -0.254, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 1, offsetX: -3.14, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: -2.811, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/fitness/"
  }
}
