app std-rasm-system-pocket-synth [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-pocket-synth — the Pocket Synth design system for a Rasm page, anchored on Teenage Engineering OP-1 interface (https://teenage.engineering). Colour: #ECECEC ground, #141414 ink, #00B2FF accent. Type: Gabarito over Be Vietnam Pro. Grid: conversation column with a control strip. Motion: the synth-blip easing (cubic-bezier 0.20,1.20,0.40,1.00); entrance: messages bubble in with a tiny bounce. Interaction: key lights in its colour. Imagery: tiny pixel icons and colour keys. Voice: casual, quick replies, emoji ok. Components: buttons are colour-coded round keys; cards are chat bubbles. Data: waveform meters. Modes: day (the light ground above) and night (#141414 ground, #ECECEC ink, the same accent), stepped by the page's mode toggle. Sound: synth blip on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "pocket-synth"
    palette: {background: "#ECECEC", foreground: "#141414", card: "#F6F6F6", "card-foreground": "#141414", surface: "#E6E6E6", muted: "#DBDBDB", "muted-foreground": "#595959", border: "#8B8B8B", input: "#808080", primary: "#00B2FF", "primary-hover": "#4DCBFF", "primary-foreground": "#141414", secondary: "#F6F6F6", "secondary-foreground": "#141414", "secondary-hover": "#D2D2D2", accent: "#00B2FF", "accent-foreground": "#141414", ring: "#005C8A", "series-1": "#00B2FF", "series-2": "#D93C00", "series-3": "#0B7A4B", "series-4": "#1B1B1B", "series-5": "#4099BF"}
    modes: {
      day: { palette: {}, looks: { "surface/ground/idle": { fill: "background" } } }
      night: { palette: { background: "#141414", foreground: "#ECECEC", card: "#1F1F1F", "card-foreground": "#ECECEC", surface: "#1A1A1A", muted: "#2A2A2A", "muted-foreground": "#A8A8A8", border: "#7A7A7A", input: "#8A8A8A", primary: "#00B2FF", "primary-hover": "#4DCBFF", "primary-foreground": "#141414", secondary: "#1F1F1F", "secondary-foreground": "#ECECEC", "secondary-hover": "#333333", accent: "#00B2FF", "accent-foreground": "#141414", ring: "#7FD8FF", "series-1": "#00B2FF", "series-2": "#FF6A33", "series-3": "#2DBE7E", "series-4": "#ECECEC", "series-5": "#4099BF" }, looks: {
        "surface/ground/idle": { fill: "background" },
        "card/surface/hovered": { fill: "#0E3A4D", stroke: "foreground", strokeWidth: 3, corners: { radius: [26, 26, 26, 6], kind: "round" }, shadow: { color: "rgba(0,178,255,0.55)", blur: 22, offsetY: 0 }, spring: { stiffness: 420, damping: 18 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 }, shadow: { color: "rgba(0,178,255,0.65)", blur: 24, offsetY: 0 } },
        "textfield/default/hovered": { fill: "#0E3A4D", stroke: "foreground", strokeWidth: 3, corners: { radius: [26, 26, 26, 6], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "text/numeral/idle": { textColor: "foreground", font: "800 220px display" }
      } }
    }
    mode: "day"
    fonts: { display: { family: "Gabarito", file: "https://almadar-kflow-assets.web.app/fonts/gabarito/Gabarito%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Be Vietnam Pro", file: "https://almadar-kflow-assets.web.app/fonts/bevietnampro/BeVietnamPro-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 6], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [34, 34, 34, 34], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/ruler/idle": { fill: "background", corners: { radius: [32, 32, 32, 32], kind: "round" } },
        "material/sun/idle": { fill: "series-5", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.local - px.size * 0.5; let r = length(p); let m = min(px.size.x, px.size.y) * 0.5 - 1.0; let disc = 1.0 - smoothstep(m - 1.0, m, r); let ring = smoothstep(m - 4.0, m - 3.0, r); let col = mix(px.color.rgb, vec3<f32>(0.086, 0.075, 0.059), ring); return vec4<f32>(col, disc * px.color.a); }", params: [0, 0, 0, 0], live: false } },
        "stack/sgp/idle": { fill: "series-1", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/dub/idle": { fill: "series-2", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/aus/idle": { fill: "series-3", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/close/idle": { fill: "series-4", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 6], kind: "round" }, spring: { stiffness: 420, damping: 18 } },
        "card/surface/hovered": { fill: "#DDF4FF", stroke: "foreground", strokeWidth: 3, corners: { radius: [26, 26, 26, 6], kind: "round" }, shadow: { color: "rgba(0,178,255,0.55)", blur: 22, offsetY: 0 }, spring: { stiffness: 420, damping: 18 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 5, corners: { radius: [26, 26, 26, 6], kind: "round" }, spring: { stiffness: 420, damping: 18 } },
        "card/surface/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 3, corners: { radius: [26, 26, 26, 6], kind: "round" }, spring: { stiffness: 520, damping: 24 } },
        "card/header/idle": { fill: "foreground", corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "background", font: "700 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [2, 5] },
        "card/media/idle": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [34, 34, 34, 34], kind: "round" } },
        "panel/header/idle": { fill: "foreground", corners: { radius: [32, 32, 0, 0], kind: "round" }, textColor: "background", font: "700 14px body" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [2, 5] },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 8 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 }, shadow: { color: "#141414", blur: 0, offsetY: 5 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 }, shadow: { color: "rgba(0,178,255,0.65)", blur: 24, offsetY: 0 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px body", spring: { stiffness: 520, damping: 24 }, shadow: { color: "#141414", blur: 0, offsetY: 1 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 }, shadow: { color: "#141414", blur: 0, offsetY: 5 } },
        "pressable/secondary/hovered": { fill: "series-3", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 }, shadow: { color: "rgba(0,178,255,0.65)", blur: 24, offsetY: 0 } },
        "pressable/secondary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px body", spring: { stiffness: 520, damping: 24 }, shadow: { color: "#141414", blur: 0, offsetY: 1 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px body", spring: { stiffness: 420, damping: 18 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "muted-foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "muted-foreground", font: "700 17px body" },
        "text/display/idle": { textColor: "foreground", font: "800 88px display" },
        "text/title/idle": { textColor: "foreground", font: "800 56px display" },
        "text/title/inverse": { textColor: "#FFFFFF", font: "800 56px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 14px body" },
        "text/eyebrow/inverse": { textColor: "#FFFFFF", font: "700 15px body" },
        "text/body/idle": { textColor: "foreground", font: "500 19px body" },
        "text/body/inverse": { textColor: "#FFFFFF", font: "500 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "800 22px display" },
        "text/label/idle": { textColor: "foreground", font: "700 15px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 14px body" },
        "text/inverse/idle": { textColor: "background", font: "700 15px body", on: "section/band/idle" },
        "text/numeral/idle": { textColor: "#16130F", font: "800 220px display" },
        "text/numeral/inverse": { textColor: "#FFFFFF", font: "800 220px display" },
        "balloon/body/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 6], kind: "round" }, spring: { stiffness: 420, damping: 18 } },
        "balloon/shout/idle": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 6], kind: "round" }, spring: { stiffness: 420, damping: 18 } },
        "window/frame/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [36, 36, 36, 36], kind: "round" } },
        "window/titlebar/idle": { fill: "foreground", corners: { radius: [34, 34, 0, 0], kind: "round" }, textColor: "background", font: "700 13px body" },
        "window/control/idle": { fill: "primary", stroke: "background", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "image/none/idle": { corners: { radius: [24, 24, 24, 24], kind: "round" } },
        "morph/default/idle": { stroke: "foreground", strokeWidth: 3 },
        "ornament/signature/idle": { fill: "series-5", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let c = px.size * 0.5; let p = px.local - c; let r = length(p); let m = min(px.size.x, px.size.y) * 0.5; let disc = 1.0 - smoothstep(m * 0.42 - 1.0, m * 0.42 + 1.0, r); let a = atan2(p.y, p.x); let ray = step(0.5, fract(a * 12.0 / 6.2831853)) * (1.0 - smoothstep(m * 0.96 - 1.0, m * 0.96 + 1.0, r)) * smoothstep(m * 0.54 - 1.0, m * 0.54 + 1.0, r); return vec4<f32>(px.color.rgb, max(disc, ray) * px.color.a); }", params: [0, 0, 0, 0], live: false } },
        "pulse/default/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, textColor: "foreground", font: "700 13px body" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 6], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "textfield/default/hovered": { fill: "#DDF4FF", stroke: "foreground", strokeWidth: 3, corners: { radius: [26, 26, 26, 6], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [26, 26, 26, 6], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "500 17px body" }
      }
    systemBreakpointLooks: { phone: { "text/label/idle": { textColor: "foreground", font: "700 13px body" }, "text/caption/idle": { textColor: "muted-foreground", font: "500 13px body" }, "text/numeral/idle": { textColor: "#16130F", font: "800 112px display" }, "text/numeral/inverse": { textColor: "#FFFFFF", font: "800 112px display" }, "text/display/idle": { textColor: "foreground", font: "800 46px display" }, "text/title/idle": { textColor: "foreground", font: "800 36px display" }, "text/title/inverse": { textColor: "#FFFFFF", font: "800 36px display" } }, tablet: { "text/numeral/idle": { textColor: "#16130F", font: "800 160px display" }, "text/numeral/inverse": { textColor: "#FFFFFF", font: "800 160px display" }, "text/display/idle": { textColor: "foreground", font: "800 64px display" } } }
    layout: { hero: "split", columns: 6, asymmetry: 0.25, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 0, gutter: 24 }
    motion: { signature: "synth-blip", stiffness: 420, damping: 18, stagger: 70, enterMs: 520, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 18, scale: 0.8, rotate: 0 }, { at: 0.1, opacity: 0.484, offsetX: 0, offsetY: 9.29, scale: 0.897, rotate: 0 }, { at: 0.2, opacity: 0.764, offsetX: 0, offsetY: 4.243, scale: 0.953, rotate: 0 }, { at: 0.3, opacity: 0.909, offsetX: 0, offsetY: 1.636, scale: 0.982, rotate: 0 }, { at: 0.4, opacity: 0.977, offsetX: 0, offsetY: 0.41, scale: 0.995, rotate: 0 }, { at: 0.5, opacity: 1, offsetX: 0, offsetY: -0.089, scale: 1.001, rotate: 0 }, { at: 0.6, opacity: 1, offsetX: 0, offsetY: -0.223, scale: 1.002, rotate: 0 }, { at: 0.7, opacity: 1, offsetX: 0, offsetY: -0.191, scale: 1.002, rotate: 0 }, { at: 0.8, opacity: 1, offsetX: 0, offsetY: -0.106, scale: 1.001, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: -0.03, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/support-chat/"
  }
}
