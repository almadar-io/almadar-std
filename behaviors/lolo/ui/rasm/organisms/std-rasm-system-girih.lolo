app std-rasm-system-girih [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-girih — the Girih design system for a Rasm page: the Blueprint system's construction-drawing language worn in an Arabesque layer, anchored on girih, the strapwork of Islamic architecture drawn with compass and straightedge from circles and squares (https://en.wikipedia.org/wiki/Girih). Colour: lapis night #0E1330 with gold construction ink #E9B949 and turquoise #5FD3C6. Type: IBM Plex Sans Arabic, SemiBold for display over Regular for text, one highly legible family drawing both Arabic and Latin. Grid: a drafting grid of 16 and 80 pixel squares, with one compass construction (a circle, two crossed squares and the eight-point star they make) drifting with the scroll and a dimension line along the foot. Shape: title-block panels and dimensioned buttons with notched corners and a gold inlay rule inside the edge. Motion: the pen-stroke easing; entrance: each piece is drawn in from its leading side, no turning. Interaction: dimension lines extend to the hovered element. Imagery: gold linework construction drawings, no photos. Voice: measured, specific, plain. Sound: a compass scratch on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "girih"
    palette: { background: "#0E1330", foreground: "#F3E8CF", card: "#161C42", "card-foreground": "#F3E8CF", surface: "#121838", muted: "#1E2550", "muted-foreground": "#C2B79C", border: "#8C6E2E", input: "#A88436", primary: "#E9B949", "primary-hover": "#F4CF72", "primary-foreground": "#10142E", secondary: "#161C42", "secondary-foreground": "#F3E8CF", "secondary-hover": "#252D66", accent: "#5FD3C6", "accent-foreground": "#0E1330", ring: "#5FD3C6", placeholder: "#8F8670", "series-1": "#E9B949", "series-2": "#5FD3C6", "series-3": "#E07A8F", "series-4": "#7F9BFF", "series-5": "#F3E8CF" }
    fonts: { display: { family: "IBM Plex Sans Arabic SemiBold", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexsansarabic/IBMPlexSansArabic-SemiBold.ttf", generic: "sans-serif" }, body: { family: "IBM Plex Sans Arabic", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexsansarabic/IBMPlexSansArabic-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 5 }, spring: { stiffness: 170, damping: 32 } },
        "card/surface/hovered": { fill: "card", stroke: "accent", strokeWidth: 1.5, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "accent", strokeWidth: 1, gap: 12 }, spring: { stiffness: 170, damping: 32 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2.5, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "ring", strokeWidth: 1.5, gap: 6 }, spring: { stiffness: 170, damping: 32 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 2 }, spring: { stiffness: 230, damping: 34 } },
        "card/header/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, textColor: "foreground", font: "600 12px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", stroke: "border", strokeWidth: 1, strokeDash: [6, 3], corners: { radius: [8, 8, 8, 8], kind: "notch" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "background", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 6 } },
        "panel/header/idle": { fill: "surface", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, textColor: "foreground", font: "600 12px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [6, 3] },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1, strokeDash: [12, 4, 2, 4] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2.5 },
        "text/inverse/idle": { textColor: "foreground", font: "500 16px body", on: "section/band/idle" },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 4 }, textColor: "primary-foreground", font: "600 14px body", spring: { stiffness: 170, damping: 32 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 4 }, textColor: "foreground", font: "600 14px body", spring: { stiffness: 170, damping: 32 } },
        "textfield/default/idle": { fill: "background", stroke: "input", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/hovered": { fill: "background", stroke: "accent", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "accent", strokeWidth: 1, gap: 6 }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/focused": { fill: "background", stroke: "ring", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "ring", strokeWidth: 1, gap: 3 }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "surface/ground/idle": { fill: "background", material: { wgsl: "// the girih construction sheet: a faint drafting grid, and one compass construction (circle, two squares, the eight-point star they make) that drifts with the scroll\nfn shade(px: Pixel) -> vec4<f32> {\n  var c = px.color.rgb;\n  let ink = vec3<f32>(0.91, 0.72, 0.29);\n  let q1 = abs(fract(px.local / 16.0) - vec2<f32>(0.5, 0.5));\n  let q2 = abs(fract(px.local / 80.0) - vec2<f32>(0.5, 0.5));\n  c = mix(c, ink, step(0.485, max(q1.x, q1.y)) * 0.025);\n  c = mix(c, ink, step(0.4938, max(q2.x, q2.y)) * 0.06);\n  let ctr = vec2<f32>(px.size.x * 0.74, px.size.y * 0.42 - px.scroll * 40.0);\n  let p = px.local - ctr;\n  let r = px.size.y * 0.3;\n  let a = abs(p);\n  let circ = step(abs(length(p) - r), 0.7);\n  let sq1 = step(abs(max(a.x, a.y) - r * 0.7071), 0.7) * step(length(p), r * 1.01);\n  let sq2 = step(abs((a.x + a.y) * 0.70710678 - r * 0.7071), 0.7) * step(length(p), r * 1.01);\n  let ax = step(min(abs(p.x), abs(p.y)), 0.5) * step(length(p), r * 1.15) * step(0.5, fract(max(a.x, a.y) / 12.0));\n  let dg = step(min(abs(p.x - p.y), abs(p.x + p.y)) * 0.70710678, 0.5) * step(length(p), r * 1.15) * step(0.5, fract(length(p) / 12.0));\n  c = mix(c, ink, circ * 0.1 + (sq1 + sq2) * 0.13 + (ax + dg) * 0.06);\n  let dy = px.local.y - (px.size.y - 36.0);\n  let dl = step(abs(dy), 0.6) * step(32.0, px.local.x) * step(px.local.x, px.size.x - 32.0);\n  let tk = step(abs(dy), 7.0) * step(min(fract((px.local.x - 32.0) / 240.0), 1.0 - fract((px.local.x - 32.0) / 240.0)), 0.004) * step(32.0, px.local.x);\n  c = mix(c, ink, (dl + tk) * 0.16);\n  let dp = length(px.local - px.pointer);\n  c = mix(c, ink, 0.05 * exp(-dp / 100.0) * step(0.4, fract(px.local.x / 4.0)));\n  return vec4<f32>(c, px.color.a);\n}\n", params: [1.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 5 }, spring: { stiffness: 170, damping: 32 } },
        "stack/panel/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 5 }, spring: { stiffness: 170, damping: 32 } },
        "stack/hero/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [14, 14, 14, 14], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 8 }, spring: { stiffness: 170, damping: 32 } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 4 }, textColor: "primary-foreground", font: "600 14px body", spring: { stiffness: 170, damping: 32 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 10 }, textColor: "primary-foreground", font: "600 14px body", spring: { stiffness: 170, damping: 32 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 2 }, textColor: "primary-foreground", font: "600 14px body", spring: { stiffness: 230, damping: 34 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 4 }, textColor: "foreground", font: "600 14px body", spring: { stiffness: 170, damping: 32 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "accent", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "accent", strokeWidth: 1, gap: 10 }, textColor: "foreground", font: "600 14px body", spring: { stiffness: 170, damping: 32 } },
        "text/display/idle": { textColor: "foreground", font: "600 64px display" },
        "text/title/idle": { textColor: "foreground", font: "600 34px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 12px body" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "foreground", font: "600 22px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet gx = min(fract(p.x / 16.0), 1.0 - fract(p.x / 16.0)) * 16.0;\nlet gy = min(fract(p.y / 16.0), 1.0 - fract(p.y / 16.0)) * 16.0;\nlet mx = min(fract(p.x / 80.0), 1.0 - fract(p.x / 80.0)) * 80.0;\nlet my = min(fract(p.y / 80.0), 1.0 - fract(p.y / 80.0)) * 80.0;\nlet minor = max(1.0 - smoothstep(0.2, 1.0, gx), 1.0 - smoothstep(0.2, 1.0, gy)) * 0.22;\nlet major = max(1.0 - smoothstep(0.2, 1.0, mx), 1.0 - smoothstep(0.2, 1.0, my)) * 0.45;\nlet yd = s.y - 14.0;\nlet dl = sg_line(p.y - yd, 0.5) * step(8.0, p.x) * step(p.x, s.x - 8.0);\nlet tk = max(sg_line(p.x - 8.0, 0.5), sg_line(p.x - (s.x - 8.0), 0.5)) * step(abs(p.y - yd), 6.0);\nlet ar = max(sg_line(sg_seg(p, vec2<f32>(8.0, yd), vec2<f32>(16.0, yd - 4.0)), 0.5), sg_line(sg_seg(p, vec2<f32>(8.0, yd), vec2<f32>(16.0, yd + 4.0)), 0.5));\nlet ar2 = max(sg_line(sg_seg(p, vec2<f32>(s.x - 8.0, yd), vec2<f32>(s.x - 16.0, yd - 4.0)), 0.5), sg_line(sg_seg(p, vec2<f32>(s.x - 8.0, yd), vec2<f32>(s.x - 16.0, yd + 4.0)), 0.5));\nreturn sg_out(px, px.color.rgb, max(max(minor, major), max(max(dl, tk), max(ar, ar2))));\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/secondary/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 2 }, textColor: "foreground", font: "600 14px body" },
        "pressable/secondary/disabled": { fill: "background", stroke: "border", strokeWidth: 1, strokeDash: [4, 4], corners: { radius: [8, 8, 8, 8], kind: "notch" }, textColor: "muted-foreground", font: "600 14px body" },
        "text/label/idle": { textColor: "muted-foreground", font: "600 12px body" },
        "text/numeral/idle": { textColor: "primary", font: "600 72px display" },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1, strokeDash: [4, 4] },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 1.5 }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.0, ornament: "double-rule", align: "start", imageTreatment: "engraving", sectionGap: 80, gutter: 40 }
    motion: { signature: "draft-pen", stiffness: 170, damping: 32, stagger: 80, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: -56, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.095, offsetX: -50.691, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.295, offsetX: -39.466, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.513, offsetX: -27.254, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.683, offsetX: -17.778, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.802, offsetX: -11.065, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.885, offsetX: -6.427, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.941, offsetX: -3.317, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.976, offsetX: -1.365, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.994, offsetX: -0.318, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/construction/"
  }
}
