app std-rasm-gallery [
  version: "0.1.0",
  description: "std-rasm-gallery — every Rasm atom on one orbital canvas, switchable across the eight look presets (naqsh, glass, sand, instrument, terminal, paper, taif-day, taif-night). Controls: a pressable, a disabled pressable, a switch, a range, a text field and a choice. Layout: a stack and a grid. Containers: an overlay opened by a button and a scroll over twelve items. Motion: the staggered entry, a tween-driven bar, a gesture area reporting swipe and fling, and a drag chip with two drop targets. Life: a button that bursts sparks from its edge and a mirrored card painted through a render target. Variants: every option of the controls (secondary and disabled buttons, check boxes and switches on and off, a stepped and a read-only range, prefilled, disabled and multiline text fields, a horizontal stack, a horizontal scroll with a partial edge, end and start side panels and an anchored popover, a secondary particle stream and an unflipped mirror). The gallery trait Readout turns the choice, button and motion events into the commands the atoms listen to and paints the readout.",
  locales: [en]
]

uses ThemeAtom from "std/behaviors/std-rasm-theme"
uses SurfaceAtom from "std/behaviors/std-rasm-surface"
uses StackAtom from "std/behaviors/std-rasm-stack"
uses GridAtom from "std/behaviors/std-rasm-grid"
uses TextAtom from "std/behaviors/std-rasm-text"
uses PressAtom from "std/behaviors/std-rasm-pressable"
uses ToggleAtom from "std/behaviors/std-rasm-toggle"
uses RangeAtom from "std/behaviors/std-rasm-range"
uses PresenceAtom from "std/behaviors/std-rasm-presence"
uses FocusAtom from "std/behaviors/std-rasm-focus"
uses TextFieldAtom from "std/behaviors/std-rasm-textfield"
uses ChoiceAtom from "std/behaviors/std-rasm-choice"
uses AnchorAtom from "std/behaviors/std-rasm-anchor"
uses OverlayAtom from "std/behaviors/std-rasm-overlay"
uses ScrollAtom from "std/behaviors/std-rasm-scroll"
uses TweenAtom from "std/behaviors/std-rasm-tween"
uses GestureAtom from "std/behaviors/std-rasm-gesture"
uses DragAtom from "std/behaviors/std-rasm-drag"
uses BufAtom from "std/behaviors/std-text-buffer"
uses ParticlesAtom from "std/behaviors/std-rasm-particles"
uses MirrorAtom from "std/behaviors/std-rasm-mirror"

type RasmRect = { x : number!, y : number!, w : number!, h : number! }
type RasmPlaced = { id : string!, rect : RasmRect! }
type RasmMaterial = { wgsl : string!, params : [number]!, live : boolean! }
type RasmCorners = { radius : [number]!, kind : "round" | "bevel" | "notch" | "scoop" }
type RasmSpring = { stiffness : number!, damping : number! }
type RasmShadow = { color : string!, blur : number! }
type RasmKeyframe = { at : number!, opacity : number, offsetY : number }
type RasmAnimation = { durationMs : number!, loop : boolean!, keyframes : [RasmKeyframe]! }
type ReadoutDirections = { none : MessageKey!, left : MessageKey!, right : MessageKey!, up : MessageKey!, down : MessageKey! }
type ReadoutDrops = { none : MessageKey!, on : MessageKey!, outside : MessageKey! }
type RasmText = { id : string!, key : MessageKey!, x : number!, y : number!, z : number!, align : string!, baseline : string!, color : string?, font : string?, spring : RasmSpring?, width : number?, wrap : boolean?, measure : boolean?, role : string?, animation : RasmAnimation? }
type RasmBackdrop = { blur : number!, tint : string, saturate : number }
type RasmLook = { fill : string, stroke : string, strokeWidth : number, corners : RasmCorners, shadow : RasmShadow, material : RasmMaterial, textColor : string, font : string, spring : RasmSpring, decor : string, backdrop : RasmBackdrop }

orbital RasmGallery {
  entity RasmGalleryView [runtime] {
    id : string!
    looks : Map string RasmLook @description "The announced look table." = {}
    rect : RasmRect? @description "The rect the readout was placed in, null until placed." = null
    tweenValue : number @description "The tween's latest value." = 0
    tweenUp : boolean @description "True when the next run goes down, false when it goes up." = false
    swipeDir : string @description "The last swipe's direction, none before the first." = "none"
    swipeDx : number @description "The last swipe's horizontal distance in pixels." = 0
    flingDir : string @description "The last fling's direction, none before the first." = "none"
    flingSpeed : number @description "The last fling's horizontal speed in pixels per 100 ms." = 0
    dropKind : string @description "The last drag result: none, on or outside." = "none"
    dropTarget : string @description "The target the chip was last dropped on, empty otherwise." = ""
    paints : number @description "Counts paints, so each paint in one dispatch is a distinct delivery (EXEC-QUEUE-4)." = 0
  }

  trait Readout -> RasmGalleryView [client] {
    initial: ready

    state ready {
      INIT -> ready
      TWEEN_PRESSED -> ready
        (emit RASM_TWEEN_START { id: "tween", from: @entity.tweenValue, to: (if @entity.tweenUp 0 100), durationMs: 1200 })
        (set @entity.tweenUp (not @entity.tweenUp))
      TWEEN_STEPPED -> ready
        (set @entity.tweenValue ?value)
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      SWIPED -> ready
        (set @entity.swipeDir ?direction)
        (set @entity.swipeDx (math/round ?dx))
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      FLUNG -> ready
        (set @entity.flingDir ?direction)
        (set @entity.flingSpeed (math/round (* ?vx 100)))
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      DRAG_DROPPED -> ready
        (set @entity.dropKind "on")
        (set @entity.dropTarget ?target)
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      DRAG_RELEASED -> ready
        (set @entity.dropKind "outside")
        (set @entity.dropTarget "")
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      RASM_THEME -> ready
        (set @entity.looks ?looks)
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (array/some ?placed (fn p (= @p.id "readout")))
        (set @entity.rect (let ((mine (array/find ?placed (fn p (= @p.id "readout"))))) (if (= @mine null) null @mine.rect)))
        (set @entity.paints (+ @entity.paints 1))
        (emit READOUT_PAINT { n: @entity.paints })
      RASM_PLACE -> ready when (not (array/some ?placed (fn p (= @p.id "readout"))))
      READOUT_PAINT -> ready
        (let ((l (object/get @entity.looks "text/body/idle" null)) (r @entity.rect) (sk : MessageKey (if (= @entity.swipeDir "left") @config.directions.left (if (= @entity.swipeDir "right") @config.directions.right (if (= @entity.swipeDir "up") @config.directions.up (if (= @entity.swipeDir "down") @config.directions.down @config.directions.none))))) (fk : MessageKey (if (= @entity.flingDir "left") @config.directions.left (if (= @entity.flingDir "right") @config.directions.right (if (= @entity.flingDir "up") @config.directions.up (if (= @entity.flingDir "down") @config.directions.down @config.directions.none))))) (dk : MessageKey (if (= @entity.dropKind "on") @config.drops.on (if (= @entity.dropKind "outside") @config.drops.outside @config.drops.none))))
          (when (and (!= @l null) (!= @r null))
            (emit RASM_PAINT { id: "readout", z: 2, texts: [
              { id: "readout:tween:label", key: @config.tweenLabel, x: (+ @r.x 0), y: (+ @r.y 0), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:swipe:label", key: @config.swipeLabel, x: (+ @r.x 0), y: (+ @r.y 38), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:swipe:dir", key: @sk, x: (+ @r.x 0), y: (+ @r.y 56), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:swipe:unit", key: @config.pxUnit, x: (+ @r.x 62), y: (+ @r.y 56), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:fling:label", key: @config.flingLabel, x: (+ @r.x 0), y: (+ @r.y 78), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:fling:dir", key: @fk, x: (+ @r.x 0), y: (+ @r.y 96), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:fling:unit", key: @config.flingUnit, x: (+ @r.x 62), y: (+ @r.y 96), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:drop:label", key: @config.dropLabel, x: (+ @r.x 0), y: (+ @r.y 118), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring },
              { id: "readout:drop:kind", key: @dk, x: (+ @r.x 0), y: (+ @r.y 136), z: 2, align: "left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring }
            ], nodes: [
              { type: draw-text, id: "readout:tween:value", text: (str/concat "" (math/round @entity.tweenValue)), position: { x: (+ @r.x 100), y: (+ @r.y 0) }, anchor: "top-left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring, hit: false },
              { type: draw-shape, id: "readout:bar", shape: rect, anchor: "top-left", position: { x: @r.x, y: (+ @r.y 22) }, width: (/ (* @r.w @entity.tweenValue) 100), height: 6, fill: @l.textColor, hit: false },
              { type: draw-text, id: "readout:swipe:dx", text: (str/concat "" @entity.swipeDx), position: { x: (+ @r.x 40), y: (+ @r.y 56) }, anchor: "top-left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring, hit: false },
              { type: draw-text, id: "readout:fling:speed", text: (str/concat "" @entity.flingSpeed), position: { x: (+ @r.x 40), y: (+ @r.y 96) }, anchor: "top-left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring, hit: false },
              { type: draw-text, id: "readout:drop:target", text: (str/concat "" @entity.dropTarget), position: { x: (+ @r.x 28), y: (+ @r.y 136) }, anchor: "top-left", baseline: "top", color: @l.textColor, font: @l.font, spring: @l.spring, hit: false }
            ] })))
    }

    config {
      tweenLabel : MessageKey = "readout-tween"
        @label "Tween label"
        @description "The catalog key of the tween line's label."
        @tier "presentation"
      swipeLabel : MessageKey = "readout-swipe"
        @label "Swipe label"
        @description "The catalog key of the swipe line's label."
        @tier "presentation"
      flingLabel : MessageKey = "readout-fling"
        @label "Fling label"
        @description "The catalog key of the fling line's label."
        @tier "presentation"
      dropLabel : MessageKey = "readout-drop"
        @label "Drop label"
        @description "The catalog key of the drag line's label."
        @tier "presentation"
      pxUnit : MessageKey = "readout-px"
        @label "Pixel unit"
        @description "The catalog key of the swipe distance's unit."
        @tier "presentation"
      flingUnit : MessageKey = "readout-fling-unit"
        @label "Fling unit"
        @description "The catalog key of the fling speed's unit."
        @tier "presentation"
      directions : ReadoutDirections = { none: "readout-dir-none", left: "readout-dir-left", right: "readout-dir-right", up: "readout-dir-up", down: "readout-dir-down" }
        @label "Directions"
        @description "The catalog key painted for each swipe or fling direction."
        @tier "presentation"
      drops : ReadoutDrops = { none: "readout-drop-none", on: "readout-drop-on", outside: "readout-drop-outside" }
        @label "Drop results"
        @description "The catalog key painted for each drag result."
        @tier "presentation"
    }

    emits {
      READOUT_PAINT -> internal { n : number! }
        @description "Repaint the readout from the stored rect and look."
        @tier "internal"
      RASM_PAINT -> external { id : string!  z : number!  texts : [RasmText]!  nodes : [node]! }
        @description "The readout's tween bar and its swipe, fling and drop lines."
        @tier "primary"
      RASM_TWEEN_START -> external { id : string!  from : number!  to : number!  durationMs : number! }
        @description "Run the tween from its latest value to the other end of the bar."
        @tier "domain"
    }

    listens {
      TweenBtn.RASM_TWEEN_PRESSED -> TWEEN_PRESSED
      TWEEN_PRESSED { }
        @description "The Play tween button was pressed."
        @tier "domain"
      Tween.RASM_TWEEN_STEP -> TWEEN_STEPPED
      TWEEN_STEPPED { id : string!  value : number!  t : number! }
        @description "The tween advanced to a value."
        @tier "domain"
      Swipe.RASM_SWIPE -> SWIPED
      SWIPED { id : string!  direction : "left" | "right" | "up" | "down"!  dx : number!  dy : number! }
        @description "The gesture area saw a swipe."
        @tier "domain"
      Swipe.RASM_FLING -> FLUNG
      FLUNG { id : string!  direction : "left" | "right" | "up" | "down"!  dx : number!  dy : number!  vx : number!  vy : number! }
        @description "The gesture area saw a fling."
        @tier "domain"
      Chip.RASM_DRAG_DROPPED -> DRAG_DROPPED
      DRAG_DROPPED { id : string!  target : string!  x : number!  y : number! }
        @description "The chip was released inside a target."
        @tier "domain"
      Chip.RASM_DRAG_RELEASED -> DRAG_RELEASED
      DRAG_RELEASED { id : string!  x : number!  y : number! }
        @description "The chip was released outside every target."
        @tier "domain"
      Theme.RASM_THEME -> RASM_THEME
      RASM_THEME { name : string!  looks : Map string RasmLook! }
        @description "Store the looks and repaint the readout."
        @tier "domain"
      TweenCol.RASM_PLACE -> RASM_PLACE
      RASM_PLACE { placed : [RasmPlaced]! }
        @description "Take the readout's rect when it is placed."
        @tier "domain"
    }
  }

  trait Surface = SurfaceAtom.traits.RasmSurface {
    config {
      id: "rasm"
      width: 900
      height: 2240
      rootChild: "root"
      rootRect: { x: 0, y: 0, w: 900, h: 2240 }
      margin: 24
      align: "center"
    }
    listens {
      LayoutRow.RASM_EXTENT -> RASM_EXTENT
      LStack.RASM_EXTENT -> RASM_EXTENT
      ContRow.RASM_EXTENT -> RASM_EXTENT
      OpenCol.RASM_EXTENT -> RASM_EXTENT
      DlgStack.RASM_EXTENT -> RASM_EXTENT
      MotionRow.RASM_EXTENT -> RASM_EXTENT
      TweenCol.RASM_EXTENT -> RASM_EXTENT
      SwipeBox.RASM_EXTENT -> RASM_EXTENT
      DragCol.RASM_EXTENT -> RASM_EXTENT
      Bins.RASM_EXTENT -> RASM_EXTENT
      LifeRow.RASM_EXTENT -> RASM_EXTENT
      VRow.RASM_EXTENT -> RASM_EXTENT
      HStackPanel.RASM_EXTENT -> RASM_EXTENT
      OverRow.RASM_EXTENT -> RASM_EXTENT
      LifeRow2.RASM_EXTENT -> RASM_EXTENT
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_RESIZE -> RASM_RESIZE
      RootStack.RASM_EXTENT -> RASM_EXTENT
      List.RASM_VISIBLE -> RASM_VISIBLE
      Dialog.RASM_VISIBLE -> RASM_VISIBLE
      RootStack.RASM_PAINT -> RASM_PAINT
      LayoutRow.RASM_PAINT -> RASM_PAINT
      LStack.RASM_PAINT -> RASM_PAINT
      ContRow.RASM_PAINT -> RASM_PAINT
      OpenCol.RASM_PAINT -> RASM_PAINT
      DlgStack.RASM_PAINT -> RASM_PAINT
      MotionRow.RASM_PAINT -> RASM_PAINT
      TweenCol.RASM_PAINT -> RASM_PAINT
      SwipeBox.RASM_PAINT -> RASM_PAINT
      DragCol.RASM_PAINT -> RASM_PAINT
      Bins.RASM_PAINT -> RASM_PAINT
      LifeRow.RASM_PAINT -> RASM_PAINT
      HLife.RASM_PAINT -> RASM_PAINT
      LifeBtn.RASM_PAINT -> RASM_PAINT
      Sparks.RASM_PAINT -> RASM_PAINT
      Reflection.RASM_PAINT -> RASM_PAINT
      TitleText.RASM_PAINT -> RASM_PAINT
      HControls.RASM_PAINT -> RASM_PAINT
      HLayout.RASM_PAINT -> RASM_PAINT
      HContainers.RASM_PAINT -> RASM_PAINT
      HMotion.RASM_PAINT -> RASM_PAINT
      S1.RASM_PAINT -> RASM_PAINT
      S2.RASM_PAINT -> RASM_PAINT
      S3.RASM_PAINT -> RASM_PAINT
      OpenHint.RASM_PAINT -> RASM_PAINT
      DlgText.RASM_PAINT -> RASM_PAINT
      Item0.RASM_PAINT -> RASM_PAINT
      Item1.RASM_PAINT -> RASM_PAINT
      Item2.RASM_PAINT -> RASM_PAINT
      Item3.RASM_PAINT -> RASM_PAINT
      Item4.RASM_PAINT -> RASM_PAINT
      Item5.RASM_PAINT -> RASM_PAINT
      Item6.RASM_PAINT -> RASM_PAINT
      Item7.RASM_PAINT -> RASM_PAINT
      Item8.RASM_PAINT -> RASM_PAINT
      Item9.RASM_PAINT -> RASM_PAINT
      Item10.RASM_PAINT -> RASM_PAINT
      Item11.RASM_PAINT -> RASM_PAINT
      ThemeChoice.RASM_PAINT -> RASM_PAINT
      PressCtl.RASM_PAINT -> RASM_PAINT
      ToggleCtl.RASM_PAINT -> RASM_PAINT
      RangeCtl.RASM_PAINT -> RASM_PAINT
      FieldCtl.RASM_PAINT -> RASM_PAINT
      ChoiceCtl.RASM_PAINT -> RASM_PAINT
      LockedBtn.RASM_PAINT -> RASM_PAINT
      G1.RASM_PAINT -> RASM_PAINT
      G2.RASM_PAINT -> RASM_PAINT
      G3.RASM_PAINT -> RASM_PAINT
      G4.RASM_PAINT -> RASM_PAINT
      OpenBtn.RASM_PAINT -> RASM_PAINT
      DlgClose.RASM_PAINT -> RASM_PAINT
      TweenBtn.RASM_PAINT -> RASM_PAINT
      BinA.RASM_PAINT -> RASM_PAINT
      BinB.RASM_PAINT -> RASM_PAINT
      List.RASM_PAINT -> RASM_PAINT
      Dialog.RASM_PAINT -> RASM_PAINT
      Swipe.RASM_PAINT -> RASM_PAINT
      Chip.RASM_PAINT -> RASM_PAINT
      Readout.RASM_PAINT -> RASM_PAINT
      HVariants.RASM_PAINT -> RASM_PAINT
      HScrollX.RASM_PAINT -> RASM_PAINT
      HOverlays.RASM_PAINT -> RASM_PAINT
      HLife2.RASM_PAINT -> RASM_PAINT
      VSec.RASM_PAINT -> RASM_PAINT
      VPrimOff.RASM_PAINT -> RASM_PAINT
      VCheck.RASM_PAINT -> RASM_PAINT
      VCheckOn.RASM_PAINT -> RASM_PAINT
      VSwitchOn.RASM_PAINT -> RASM_PAINT
      VRangeStep.RASM_PAINT -> RASM_PAINT
      VRangeRo.RASM_PAINT -> RASM_PAINT
      VFieldVal.RASM_PAINT -> RASM_PAINT
      VFieldOff.RASM_PAINT -> RASM_PAINT
      VRow.RASM_PAINT -> RASM_PAINT
      VMulti.RASM_PAINT -> RASM_PAINT
      HStackPanel.RASM_PAINT -> RASM_PAINT
      HS1.RASM_PAINT -> RASM_PAINT
      HS2.RASM_PAINT -> RASM_PAINT
      HS3.RASM_PAINT -> RASM_PAINT
      XList.RASM_PAINT -> RASM_PAINT
      X0.RASM_PAINT -> RASM_PAINT
      X1.RASM_PAINT -> RASM_PAINT
      X2.RASM_PAINT -> RASM_PAINT
      X3.RASM_PAINT -> RASM_PAINT
      X4.RASM_PAINT -> RASM_PAINT
      X5.RASM_PAINT -> RASM_PAINT
      X6.RASM_PAINT -> RASM_PAINT
      X7.RASM_PAINT -> RASM_PAINT
      X8.RASM_PAINT -> RASM_PAINT
      X9.RASM_PAINT -> RASM_PAINT
      OverRow.RASM_PAINT -> RASM_PAINT
      OpenEnd.RASM_PAINT -> RASM_PAINT
      OpenStart.RASM_PAINT -> RASM_PAINT
      OpenPop.RASM_PAINT -> RASM_PAINT
      EndPanel.RASM_PAINT -> RASM_PAINT
      StartPanel.RASM_PAINT -> RASM_PAINT
      Popover.RASM_PAINT -> RASM_PAINT
      EndText.RASM_PAINT -> RASM_PAINT
      StartText.RASM_PAINT -> RASM_PAINT
      PopText.RASM_PAINT -> RASM_PAINT
      LifeRow2.RASM_PAINT -> RASM_PAINT
      Stream.RASM_PAINT -> RASM_PAINT
      PlainMirror.RASM_PAINT -> RASM_PAINT
      XList.RASM_VISIBLE -> RASM_VISIBLE
      EndPanel.RASM_VISIBLE -> RASM_VISIBLE
      StartPanel.RASM_VISIBLE -> RASM_VISIBLE
      Popover.RASM_VISIBLE -> RASM_VISIBLE
    }
  }

  trait Theme = ThemeAtom.traits.RasmTheme {
    listens {
      ThemeChoice.RASM_THEME_CHOSEN -> RASM_THEME_SET with { name: ?value }
      Surface.RASM_BOOT -> RASM_BOOT
    }
  }
  trait NameBuffer = BufAtom.traits.Buffer {
    config {
      slot: sidebar
      headless: true
    }
    listens {
      FieldCtl.LOAD_TEXT -> LOAD_TEXT
      FieldCtl.INSERT_TEXT -> INSERT_TEXT
      FieldCtl.BACKSPACE -> BACKSPACE
      FieldCtl.MOTION -> MOTION
      FieldCtl.OPERATE -> OPERATE
      FieldCtl.CURSOR_SET -> CURSOR_SET
    }
  }
  trait RootStack = StackAtom.traits.RasmStack {
    config {
      id: "root"
      axis: "vertical"
      gap: 14
      padding: 24
      look: ""
      z: 1
      children: [{ id: "title", size: "measure" }, { id: "theme", size: "fixed", main: 66 }, { id: "hcontrols", size: "measure" }, { id: "controls", size: "fixed", main: 226 }, { id: "hlayout", size: "measure" }, { id: "layoutrow", size: "fixed", main: 110 }, { id: "hcontainers", size: "measure" }, { id: "controw", size: "fixed", main: 170 }, { id: "hmotion", size: "measure" }, { id: "motionrow", size: "fixed", main: 250 }, { id: "hlife", size: "measure" }, { id: "liferow", size: "fixed", main: 150 }, { id: "hvariants", size: "measure" }, { id: "vgrid", size: "fixed", main: 226 }, { id: "vrow", size: "fixed", main: 130 }, { id: "hscrollx", size: "measure" }, { id: "xlist", size: "fixed", main: 56 }, { id: "hoverlays", size: "measure" }, { id: "overrow", size: "fixed", main: 46 }, { id: "hlife2", size: "measure" }, { id: "liferow2", size: "fixed", main: 150 }]
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_PLACE -> RASM_PLACE
      Surface.RASM_MEASURED -> RASM_MEASURED
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_DIRECTION -> RASM_DIRECTION
    }
  }
  trait LayoutRow = StackAtom.traits.RasmStack {
    config {
      id: "layoutrow"
      axis: "horizontal"
      gap: 14
      padding: 0
      look: ""
      z: 1
      children: [{ id: "lstack", size: "fill" }, { id: "lgrid", size: "fill" }]
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      RootStack.RASM_PLACE -> RASM_PLACE
      Surface.RASM_MEASURED -> RASM_MEASURED
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_DIRECTION -> RASM_DIRECTION
    }
  }
  trait LStack = StackAtom.traits.RasmStack {
    config {
      id: "lstack"
      axis: "vertical"
      gap: 8
      padding: 12
