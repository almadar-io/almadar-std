app std-rasm-system-new-alphabet [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-new-alphabet — the New Alphabet design system for a Rasm page, anchored on Wim Crouwel's New Alphabet (1967) and Vormgevers poster (https://en.wikipedia.org/wiki/New_Alphabet). Colour: #EDEDED ground, #0D0D0D ink, #FF5500 accent. Type: Syncopate over Space Mono. Grid: strict square module grid 1:1. Motion: the modular-step easing (cubic-bezier 0.85,0.00,0.15,1.00); entrance: type builds stroke by stroke on the module. Interaction: module fills solid. Imagery: grid-built letterforms only. Voice: functional, numbered, impersonal. Components: buttons are square modules; cards are module-aligned blocks. Data: square unit charts. Sound: digital blip on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "new-alphabet"
    palette: {background: "#EDEDED", foreground: "#0D0D0D", card: "#F7F7F7", "card-foreground": "#0D0D0D", surface: "#E6E6E6", muted: "#DBDBDB", "muted-foreground": "#555555", border: "#888888", input: "#7D7D7D", primary: "#FF5500", "primary-hover": "#D94800", "primary-foreground": "#0D0D0D", secondary: "#F7F7F7", "secondary-foreground": "#0D0D0D", "secondary-hover": "#D2D2D2", accent: "#FF5500", "accent-foreground": "#0D0D0D", ring: "#FF5500", "series-1": "#FF5500", "series-2": "#923506", "series-3": "#F7996B", "series-4": "#505050", "series-5": "#BF6A40"}
    fonts: { display: { family: "Syncopate", file: "https://almadar-kflow-assets.web.app/fonts/syncopate/Syncopate-Regular.ttf", generic: "sans-serif" }, body: { family: "Space Mono", file: "https://almadar-kflow-assets.web.app/fonts/spacemono/SpaceMono-Regular.ttf", generic: "monospace" }, mono: { family: "Space Mono", file: "https://almadar-kflow-assets.web.app/fonts/spacemono/SpaceMono-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn bh_edge(a: vec2<f32>, b: vec2<f32>, p: vec2<f32>) -> f32 { return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x); } fn shade(px: Pixel) -> vec4<f32> { let p = px.local; let m = min(px.size.x, px.size.y * 1.5); let off = (px.pointer - px.size * 0.5) * 0.02; let cc = vec2<f32>(px.size.x * 0.8, px.size.y * 0.22 + px.scroll * 80.0) + off; let circ = 1.0 - smoothstep(m * 0.16 - 1.0, m * 0.16 + 1.0, length(p - cc)); let sq = step(abs(p.x - px.size.x * 0.12), m * 0.1) * step(abs(p.y - px.size.y * 0.6 - px.scroll * 40.0), m * 0.1); let a = vec2<f32>(px.size.x * 0.62, px.size.y * 0.72 - m * 0.18); let b = vec2<f32>(px.size.x * 0.62 - m * 0.18, px.size.y * 0.72 + m * 0.12); let c3 = vec2<f32>(px.size.x * 0.62 + m * 0.18, px.size.y * 0.72 + m * 0.12); let e1 = bh_edge(a, b, p); let e2 = bh_edge(b, c3, p); let e3 = bh_edge(c3, a, p); let tri = max(step(0.0, e1) * step(0.0, e2) * step(0.0, e3), step(e1, 0.0) * step(e2, 0.0) * step(e3, 0.0)); let red = vec3<f32>(0.87, 0.15, 0.1); let yel = vec3<f32>(0.98, 0.78, 0.1); let blu = vec3<f32>(0.1, 0.25, 0.7); var col = mix(px.color.rgb, red, circ * 0.11); col = mix(col, blu, sq * 0.1); col = mix(col, yel, tri * 0.13); return vec4<f32>(col, px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.22)", blur: 30, offsetX: 0, offsetY: 14 } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.26)", blur: 36, offsetX: 0, offsetY: 18 } },
        "text/numeral/idle": { textColor: "foreground", font: "800 110px display" },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/primary/hovered": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, shadow: { color: "rgba(0,0,0,0.95)", blur: 0, offsetX: 4, offsetY: 4 }, textColor: "accent-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/primary/pressed": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "700 16px body", spring: { stiffness: 380, damping: 28 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "text/display/idle": { textColor: "foreground", font: "800 100px display" },
        "text/title/idle": { textColor: "foreground", font: "800 40px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "800 24px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_tri(p: vec2<f32>, r: f32) -> f32 { return max(p.y - 0.5 * r, max(dot(p, vec2<f32>(0.866, -0.5)), dot(p, vec2<f32>(-0.866, -0.5))) - 0.5 * r); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet u = min(s.x * 0.31, m * 0.95);\nlet r = u * 0.38;\nvar col = px.color.rgb;\nvar a = 0.0;\nlet k1 = sg_fill(length(p - vec2<f32>(c.x - u, c.y)) - r);\ncol = mix(col, vec3<f32>(0.87, 0.13, 0.13), k1);\na = max(a, k1);\nlet k2 = sg_fill(sg_box(p - c, vec2<f32>(r, r)));\ncol = mix(col, vec3<f32>(0.1, 0.25, 0.65), k2);\na = max(a, k2);\nlet k3 = sg_fill(sg_tri(p - vec2<f32>(c.x + u, c.y), r * 1.15));\ncol = mix(col, vec3<f32>(0.97, 0.78, 0.08), k3);\na = max(a, k3);\nreturn sg_out(px, col, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/pressed": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.24)", blur: 32, offsetX: 0, offsetY: 16 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "secondary", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.95)", blur: 0, offsetX: 9, offsetY: 9 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.95)", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(0,0,0,0.95)", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 380, damping: 28 } },
        "card/header/idle": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "700 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "card/media/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 14px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "section/band/idle": { fill: "accent" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 4 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "accent-foreground", font: "800 22px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 14px body" },
        "text/label/idle": { textColor: "foreground", font: "700 14px body" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 26 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "pressable/secondary/disabled": { stroke: "input" },
        "toggle/check/off-idle": { stroke: "input" },
        "toggle/check/off-hovered": { stroke: "input" },
        "toggle/switch/off-idle": { stroke: "input" },
        "toggle/switch/off-hovered": { stroke: "input" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.2, ornament: "rule", align: "start", imageTreatment: "duotone", sectionGap: 112, gutter: 32 }
    motion: { signature: "modular-step", stiffness: 300, damping: 26, stagger: 70, enterMs: 475, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 12, scale: 0.94, rotate: 2 }, { at: 0.1, opacity: 0.005, offsetX: 0, offsetY: 11.937, scale: 0.94, rotate: 1.99 }, { at: 0.2, opacity: 0.025, offsetX: 0, offsetY: 11.706, scale: 0.941, rotate: 1.951 }, { at: 0.3, opacity: 0.068, offsetX: 0, offsetY: 11.189, scale: 0.944, rotate: 1.865 }, { at: 0.4, opacity: 0.163, offsetX: 0, offsetY: 10.045, scale: 0.95, rotate: 1.674 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 6, scale: 0.97, rotate: 1 }, { at: 0.6, opacity: 0.837, offsetX: 0, offsetY: 1.955, scale: 0.99, rotate: 0.326 }, { at: 0.7, opacity: 0.932, offsetX: 0, offsetY: 0.811, scale: 0.996, rotate: 0.135 }, { at: 0.8, opacity: 0.975, offsetX: 0, offsetY: 0.294, scale: 0.999, rotate: 0.049 }, { at: 0.9, opacity: 0.995, offsetX: 0, offsetY: 0.063, scale: 1, rotate: 0.01 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/service-request/"
  }
}
