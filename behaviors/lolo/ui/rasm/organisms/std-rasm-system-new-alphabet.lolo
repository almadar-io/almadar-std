app std-rasm-system-new-alphabet [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-new-alphabet — the New Alphabet design system for a Rasm page, anchored on Wim Crouwel's New Alphabet (1967) and Vormgevers poster (https://en.wikipedia.org/wiki/New_Alphabet). Colour: #EDEDED ground, #0D0D0D ink, #FF5500 accent. Type: Syncopate over Space Mono. Grid: strict square module grid 1:1. Motion: the modular-step easing (cubic-bezier 0.85,0.00,0.15,1.00); entrance: type builds stroke by stroke on the module. Interaction: module fills solid. Imagery: grid-built letterforms only. Voice: functional, numbered, impersonal. Components: buttons are square modules; cards are module-aligned blocks. Data: square unit charts. Sound: digital blip on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "new-alphabet"
    palette: {background: "#EDEDED", foreground: "#0D0D0D", card: "#F7F7F7", "card-foreground": "#0D0D0D", surface: "#E6E6E6", muted: "#DBDBDB", "muted-foreground": "#555555", border: "#888888", input: "#7D7D7D", primary: "#FF5500", "primary-hover": "#D94800", "primary-foreground": "#0D0D0D", secondary: "#F7F7F7", "secondary-foreground": "#0D0D0D", "secondary-hover": "#D2D2D2", accent: "#FF5500", "accent-foreground": "#0D0D0D", ring: "#FF5500", "series-1": "#FF5500", "series-2": "#923506", "series-3": "#F7996B", "series-4": "#505050", "series-5": "#BF6A40"}
    fonts: { display: { family: "Syncopate", file: "https://almadar-kflow-assets.web.app/fonts/syncopate/Syncopate-Regular.ttf", generic: "sans-serif" }, body: { family: "Space Mono", file: "https://almadar-kflow-assets.web.app/fonts/spacemono/SpaceMono-Regular.ttf", generic: "monospace" }, mono: { family: "Space Mono", file: "https://almadar-kflow-assets.web.app/fonts/spacemono/SpaceMono-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let gl = px.local - vec2<f32>(0.0, px.scroll * 40.0); let gx = abs(fract(gl.x / 48.0) - 0.5); let gy = abs(fract(gl.y / 48.0) - 0.5); let line = max(1.0 - smoothstep(0.0, 0.015, 0.5 - gx), 1.0 - smoothstep(0.0, 0.015, 0.5 - gy)); return vec4<f32>(px.color.rgb - vec3<f32>(line * 0.09), px.color.a); }", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "text/numeral/idle": { textColor: "foreground", font: "700 88px display" },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "700 13px display", spring: { stiffness: 300, damping: 26 } },
        "pressable/primary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary", font: "700 13px display", spring: { stiffness: 300, damping: 26 } },
        "pressable/primary/pressed": { fill: "foreground", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary", font: "700 13px display", spring: { stiffness: 420, damping: 32 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 13px display", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 13px display", spring: { stiffness: 300, damping: 26 } },
        "text/display/idle": { textColor: "foreground", font: "700 56px display" },
        "text/title/idle": { textColor: "foreground", font: "700 30px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "400 13px mono" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 18px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); } fn shade(px: Pixel) -> vec4<f32> { let p = px.local; let c = px.size * 0.5; let rule = 1.0 - smoothstep(0.7, 1.7, abs(p.y - c.y)); let u = fract(p.x / 24.0) * 24.0; let d = min(u, 24.0 - u); let tick = (1.0 - smoothstep(0.5, 1.5, d)) * (1.0 - smoothstep(6.0, 7.0, abs(p.y - c.y))); return sg_out(px, px.color.rgb, max(rule, tick)); }", params: [0, 0, 0, 0], live: false } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "700 13px display", inset: { stroke: "foreground", strokeWidth: 2, gap: 3 }, spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/pressed": { fill: "foreground", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 13px display", spring: { stiffness: 420, damping: 32 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 13px display", inset: { stroke: "foreground", strokeWidth: 2, gap: 3 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "border", strokeWidth: 1, gap: 6 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/hovered": { fill: "muted", stroke: "primary", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 420, damping: 32 } },
        "card/header/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 12px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 12px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 12px mono", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "text/inverse/idle": { textColor: "accent-foreground", font: "700 16px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 12px mono" },
        "text/label/idle": { textColor: "foreground", font: "700 12px mono" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 15px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/hovered": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 15px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 15px body", spring: { stiffness: 300, damping: 26 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "pressable/secondary/disabled": { stroke: "border" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" }
      }
    layout: { hero: "poster", columns: 12, asymmetry: 0.0, ornament: "rule", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 16 }
    motion: { signature: "modular-step", stiffness: 300, damping: 26, stagger: 60, enterMs: 560, keyframes: [{ at: 0, opacity: 0, offsetX: -36, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.005, offsetX: -35.811, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.025, offsetX: -35.118, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.068, offsetX: -33.567, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.163, offsetX: -30.134, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: -18, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.837, offsetX: -5.866, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.932, offsetX: -2.433, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.975, offsetX: -0.882, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.995, offsetX: -0.189, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/service-request/"
  }
}
