app std-rasm-system-redline-docs [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-redline-docs — the Redline Docs design system for a Rasm page, anchored on Stripe API docs and MDN Web Docs (https://docs.stripe.com). Colour: #F3F0E8 ground, #16181D ink, #BE1E2D accent. Type: Literata over Fira Sans. Grid: three-pane docs grid 1:3:1. Motion: the doc-slide easing (cubic-bezier 0.20,0.00,0.10,1.00); entrance: panes slide in from their edges. Interaction: link gains a redline underline. Imagery: code blocks and diagrams. Voice: instructional, reference, second person. Components: buttons are text links; cards are callout boxes. Data: inline tables. Sound: soft page tick on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "redline-docs"
    palette: {background: "#F3F0E8", foreground: "#16181D", card: "#FAF8F5", "card-foreground": "#16181D", surface: "#ECEAE2", muted: "#E1DFD8", "muted-foreground": "#5D5D5E", border: "#908F8D", input: "#858483", primary: "#BE1E2D", "primary-hover": "#A21A26", "primary-foreground": "#F3F0E8", secondary: "#FAF8F5", "secondary-foreground": "#16181D", "secondary-hover": "#D8D6D0", accent: "#BE1E2D", "accent-foreground": "#F3F0E8", ring: "#BE1E2D", "series-1": "#BE1E2D", "series-2": "#721B26", "series-3": "#D67D81", "series-4": "#58595A", "series-5": "#9F4F56"}
    fonts: { display: { family: "Literata", file: "https://almadar-kflow-assets.web.app/fonts/literata/Literata%5Bopsz%2Cwght%5D.ttf", generic: "serif" }, body: { family: "Fira Sans", file: "https://almadar-kflow-assets.web.app/fonts/firasans/FiraSans-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "foreground", corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "pressable/primary/idle": { textColor: "primary", font: "600 16px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 160, damping: 24 } },
        "pressable/primary/hovered": { fill: "surface", stroke: "primary", strokeWidth: 1.5, strokeDash: [3, 3], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-hover", font: "600 16px body", spring: { stiffness: 160, damping: 24 } },
        "pressable/primary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, strokeDash: [3, 3], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-hover", font: "600 16px body", spring: { stiffness: 260, damping: 30 } },
        "pressable/primary/focused": { stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary", font: "600 16px body", spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/idle": { textColor: "foreground", font: "600 16px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/hovered": { fill: "surface", stroke: "primary", strokeWidth: 1.5, strokeDash: [3, 3], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, strokeDash: [3, 3], corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 260, damping: 30 } },
        "pressable/secondary/focused": { stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/disabled": { stroke: "border" },
        "text/display/idle": { textColor: "foreground", font: "600 60px display" },
        "text/title/idle": { textColor: "foreground", font: "600 34px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 12px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 19px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "foreground", font: "600 72px display" },
        "text/label/idle": { textColor: "foreground", font: "600 13px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px body" },
        "text/quote/idle": { textColor: "foreground", font: "500 40px display" },
        "text/inverse/idle": { textColor: "background", font: "500 13px body", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 160, damping: 24 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 160, damping: 24 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 160, damping: 24 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, spring: { stiffness: 260, damping: 30 } },
        "card/header/idle": { fill: "surface", corners: { radius: [3, 3, 0, 0], kind: "round" }, textColor: "foreground", font: "600 12px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "panel/header/idle": { fill: "surface", corners: { radius: [3, 3, 0, 0], kind: "round" }, textColor: "foreground", font: "600 12px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "muted" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "material/sheet/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "material/insert/idle": { fill: "muted", corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "material/delete/idle": { fill: "series-3", corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "material/band/idle": { fill: "muted" },
        "material/rail/idle": { fill: "border", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "material/closing/idle": { fill: "foreground", corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "pulse/default/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "600 13px body" },
        "pulse/hot/idle": { fill: "primary", stroke: "card", strokeWidth: 3, textColor: "foreground", font: "600 13px body" },
        "pulse/link/idle": { stroke: "border", strokeWidth: 2 },
        "textfield/default/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 160, damping: 24 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 160, damping: 24 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 160, damping: 24 } },
        "range/default/thumb-idle": { stroke: "border" },
        "range/default/thumb-hovered": { stroke: "border" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" }
      }
    layout: { hero: "editorial", columns: 5, asymmetry: 0.2, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 40 }
    motion: { signature: "doc-slide", stiffness: 160, damping: 24, stagger: 70, enterMs: 560, keyframes: [{ at: 0, opacity: 0, offsetX: -44, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.118, offsetX: -38.809, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.409, offsetX: -25.999, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.621, offsetX: -16.683, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.758, offsetX: -10.663, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.85, offsetX: -6.611, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.913, offsetX: -3.845, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.955, offsetX: -1.99, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.981, offsetX: -0.822, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.996, offsetX: -0.192, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/wiki/"
  }
}
