app std-rasm-system-brutal-relay [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-brutal-relay — the Brutal Relay design system for a Rasm page, anchored on Gumroad 2021 neo-brutalist redesign (https://gumroad.com). Colour: #FFE45E ground, #000000 ink, #FF5C8A accent. Type: Archivo Black over Space Grotesk. Grid: visible 12-column grid with exposed gutters drawn. Motion: the hard-cut easing (cubic-bezier 1.00,0.00,0.00,1.00); entrance: blocks appear with no tween, one per beat. Interaction: block shifts 4px down-right onto its shadow. Imagery: flat screenshots in thick black frames. Voice: blunt, funny, developer slang. Components: buttons are thick-outlined blocks with offset shadow; cards are raw boxes. Data: chunky bar charts with black outlines. Sound: keyboard clack on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "brutal-relay"
    palette: {background: "#FFE45E", foreground: "#000000", card: "#FFF3B7", "card-foreground": "#000000", surface: "#F7DD5B", muted: "#EBD256", "muted-foreground": "#52491E", border: "#8C7D34", input: "#80722F", primary: "#FF5C8A", "primary-hover": "#D94E75", "primary-foreground": "#000000", secondary: "#FFF3B7", "secondary-foreground": "#000000", "secondary-hover": "#E0C953", accent: "#FF5C8A", "accent-foreground": "#000000", ring: "#FF5C8A", "series-1": "#FF5C8A", "series-2": "#8C334C", "series-3": "#FF9976", "series-4": "#4D441C", "series-5": "#BF6E85"}
    fonts: { display: { family: "Archivo Black", file: "https://almadar-kflow-assets.web.app/fonts/archivoblack/ArchivoBlack-Regular.ttf", generic: "sans-serif" }, body: { family: "Space Grotesk", file: "https://almadar-kflow-assets.web.app/fonts/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let corner = vec2<f32>(px.size.x, 0.0); let dd = length(p - corner) / length(px.size); let r = vec2<f32>((p.x + p.y) * 0.7071, (p.y - p.x) * 0.7071); let q = fract(r / 12.0) - 0.5; let rad = 0.4 * (1.0 - dd) + 0.04 * sin(px.time * 0.5); let dt = 1.0 - smoothstep(rad - 0.05, rad + 0.05, length(q)); let ink = vec3<f32>(0.95, 0.25, 0.25); let a = atan2(p.y - corner.y, p.x - corner.x); let ray = smoothstep(0.92, 1.0, sin(a * 40.0)) * smoothstep(0.9, 0.2, dd) * 0.04; let e = min(min(p.x, px.size.x - p.x), min(p.y, px.size.y - p.y)); let panel = (1.0 - smoothstep(1.5, 2.5, abs(e - 12.0))) * 0.14; let c = mix(px.color.rgb, ink, dt * 0.13); return vec4<f32>(c + vec3<f32>(s * (ray + panel)), px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [14, 14, 14, 14], kind: "round" }, shadow: { color: "rgba(0,0,0,0.8)", blur: 0, offsetX: 5, offsetY: 5 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, shadow: { color: "#1c1c28", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 480, damping: 18 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, shadow: { color: "#c2301b", blur: 0, offsetX: 7, offsetY: 7 }, spring: { stiffness: 480, damping: 18 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [8, 8, 8, 8], kind: "round" }, shadow: { color: "#1c1c28", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 480, damping: 18 } },
        "card/surface/pressed": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, shadow: { color: "#1c1c28", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 560, damping: 20 } },
        "card/header/idle": { fill: "secondary", textColor: "secondary-foreground", font: "400 24px display", corners: { radius: [8, 8, 0, 0], kind: "round" }, on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "card/media/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 8, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "#1c1c28", blur: 0, offsetX: 6, offsetY: 6 } },
        "panel/header/idle": { fill: "primary", textColor: "primary-foreground", font: "400 24px display", stroke: "foreground", strokeWidth: 3, corners: { radius: [4, 4, 0, 0], kind: "round" }, on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "section/band/idle": { fill: "#f8e6e4" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 4 },
        "focus/ring/outer": { stroke: "#ffffff", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 480, damping: 18 } },
        "pressable/secondary/focused": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 480, damping: 18 } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/bar/idle": { fill: "accent", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 480, damping: 18 } },
        "pressable/primary/hovered": { fill: "accent", textColor: "accent-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 480, damping: 18 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 560, damping: 20 } },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 480, damping: 18 } },
        "pressable/secondary/hovered": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "400 24px display", shadow: { color: "#1c1c28", blur: 0, offsetX: 6, offsetY: 6 }, spring: { stiffness: 480, damping: 18 } },
        "text/display/idle": { textColor: "foreground", font: "400 92px display" },
        "text/title/idle": { textColor: "primary", font: "400 38px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "600 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 26px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 4 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn sg_halftone(p: vec2<f32>, cell: f32, ang: f32, rad: f32) -> f32 { let q = sg_rot(p, ang) / cell; let c = fract(q) - vec2<f32>(0.5, 0.5); return (1.0 - smoothstep(rad - 0.08, rad + 0.08, length(c))) * step(0.03, rad); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet q = p - c;\nlet r = length(q);\nlet u = atan2(q.x, -q.y) * 2.228169;\nlet f = abs(fract(u) - 0.5) * 2.0;\nlet rr = m * 0.46 * mix(0.55, 1.0, f);\nlet d = r - rr;\nlet body = sg_fill(d);\nlet edge = sg_line(d + 2.0, 2.0);\nlet dots = sg_halftone(p, 8.0, 0.7854, 0.12 + 0.5 * clamp(r / max(rr, 1.0), 0.0, 1.0));\nlet col = mix(px.color.rgb, vec3<f32>(0.04, 0.04, 0.04), edge);\nreturn sg_out(px, col, max(body * dots, edge));\n}\n", params: [0, 0, 0, 0], live: false } },
        "balloon/body/idle": { fill: "card", stroke: "foreground", strokeWidth: 3.5, corners: { radius: [22, 22, 22, 22], kind: "round" } },
        "balloon/shout/idle": { fill: "accent", stroke: "foreground", strokeWidth: 4, corners: { radius: [8, 8, 8, 8], kind: "notch" } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.2, ornament: "frame", align: "start", imageTreatment: "halftone", sectionGap: 72, gutter: 28 }
    motion: { signature: "hard-cut", stiffness: 480, damping: 18, stagger: 90, enterMs: 1447, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 12, scale: 0.94, rotate: 2 }, { at: 0.1, opacity: 0.004, offsetX: 0, offsetY: 11.955, scale: 0.94, rotate: 1.992 }, { at: 0.2, opacity: 0.017, offsetX: 0, offsetY: 11.791, scale: 0.941, rotate: 1.965 }, { at: 0.3, opacity: 0.047, offsetX: 0, offsetY: 11.431, scale: 0.943, rotate: 1.905 }, { at: 0.4, opacity: 0.111, offsetX: 0, offsetY: 10.663, scale: 0.947, rotate: 1.777 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 6, scale: 0.97, rotate: 1 }, { at: 0.6, opacity: 0.889, offsetX: 0, offsetY: 1.337, scale: 0.993, rotate: 0.223 }, { at: 0.7, opacity: 0.953, offsetX: 0, offsetY: 0.569, scale: 0.997, rotate: 0.095 }, { at: 0.8, opacity: 0.983, offsetX: 0, offsetY: 0.209, scale: 0.999, rotate: 0.035 }, { at: 0.9, opacity: 0.996, offsetX: 0, offsetY: 0.045, scale: 1, rotate: 0.008 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/developer/"
  }
}
