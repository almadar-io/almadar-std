app std-rasm-system-brutal-relay [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-brutal-relay — the Brutal Relay design system for a Rasm page, anchored on Gumroad 2021 neo-brutalist redesign (https://gumroad.com). Colour: #FFE45E ground, #000000 ink, #FF5C8A accent. Type: Archivo Black over Space Grotesk. Grid: visible 12-column grid with exposed gutters drawn. Motion: the hard-cut easing (cubic-bezier 1.00,0.00,0.00,1.00); entrance: blocks appear with no tween, one per beat. Interaction: block shifts 4px down-right onto its shadow. Imagery: flat screenshots in thick black frames. Voice: blunt, funny, developer slang. Components: buttons are thick-outlined blocks with offset shadow; cards are raw boxes. Data: chunky bar charts with black outlines. Sound: keyboard clack on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "brutal-relay"
    palette: { background: "#FFE45E", foreground: "#000000", card: "#FFFFFF", "card-foreground": "#000000", surface: "#FFF3B7", muted: "#F2D94A", "muted-foreground": "#3B3410", border: "#000000", input: "#000000", primary: "#FF5C8A", "primary-hover": "#E64A78", "primary-foreground": "#000000", secondary: "#FFFFFF", "secondary-foreground": "#000000", "secondary-hover": "#FFF3B7", accent: "#FF5C8A", "accent-foreground": "#000000", ring: "#000000", "series-1": "#FF5C8A", "series-2": "#FFFFFF", "series-3": "#7CE0C3", "series-4": "#6FA8FF", "series-5": "#000000" }
    fonts: { display: { family: "Archivo Black", file: "https://almadar-kflow-assets.web.app/fonts/archivoblack/ArchivoBlack-Regular.ttf", generic: "sans-serif" }, body: { family: "Space Grotesk", file: "https://almadar-kflow-assets.web.app/fonts/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Space Grotesk", file: "https://almadar-kflow-assets.web.app/fonts/spacegrotesk/SpaceGrotesk%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let w = px.size.x;\n  let g = clamp(w * 0.022, 6.0, 28.0);\n  let cw = (w - 11.0 * g) / 12.0;\n  let pitch = cw + g;\n  let m = fract(px.local.x / pitch) * pitch;\n  let gut = step(cw, m);\n  let e0 = 1.0 - smoothstep(0.5, 1.5, m);\n  let e1 = 1.0 - smoothstep(0.5, 1.5, abs(m - cw));\n  let a = gut * 0.06 + max(e0, e1) * 0.2;\n  return vec4<f32>(mix(px.color.rgb, vec3<f32>(0.0, 0.0, 0.0), a), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 900, damping: 60 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 900, damping: 60 } },
        "stack/hero/idle": { fill: "surface", stroke: "foreground", strokeWidth: 6, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 12, offsetY: 12 } },
        "stack/bar/idle": { fill: "accent", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 900, damping: 60 } },
        "card/surface/hovered": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 900, damping: 60 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 6, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 900, damping: 60 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "card/header/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, font: "400 24px display", corners: { radius: [0, 0, 0, 0], kind: "round" }, on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 4 },
        "card/media/idle": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 10, offsetY: 10 }, spring: { stiffness: 900, damping: 60 } },
        "panel/header/idle": { fill: "accent", textColor: "accent-foreground", stroke: "foreground", strokeWidth: 4, font: "400 22px display", corners: { radius: [0, 0, 0, 0], kind: "round" }, on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 4 },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 5 },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 3 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 5, fill: "" },
        "focus/ring/outer": { stroke: "card", strokeWidth: 9 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 6, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/idle": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/focused": { fill: "secondary", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 6, corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display", shadow: { color: "#000000", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 900, damping: 60 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "muted-foreground", strokeWidth: 3, strokeDash: [6, 4], corners: { radius: [0, 0, 0, 0], kind: "round" }, font: "400 22px display" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 17px body", shadow: { color: "#000000", blur: 0, offsetX: 4, offsetY: 4 } },
        "textfield/default/hovered": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 17px body", shadow: { color: "#000000", blur: 0, offsetX: 2, offsetY: 2 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 6, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 17px body", shadow: { color: "#000000", blur: 0, offsetX: 4, offsetY: 4 } },
        "text/display/idle": { textColor: "foreground", font: "400 96px display" },
        "text/title/idle": { textColor: "foreground", font: "400 40px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 26px display", on: "card/surface/idle" },
        "text/code/idle": { textColor: "foreground", font: "500 15px mono" },
        "text/label/idle": { textColor: "foreground", font: "700 13px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px body" },
        "text/inverse/idle": { on: "pressable/primary/idle", textColor: "primary-foreground", font: "400 22px display" },
        "icon/default/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "primary" },
        "morph/default/idle": { fill: "accent", stroke: "foreground", strokeWidth: 4 },
        "image/none/idle": { fill: "primary", stroke: "foreground", strokeWidth: 8, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#000000", blur: 0, offsetX: 10, offsetY: 10 }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn shade(px: Pixel) -> vec4<f32> { return im_px(px, vec2<f32>(0.0, 0.0)) * px.color.a; }\n", params: [0, 0, 0, 0], live: false } },
        "ornament/block/idle": { fill: "primary", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let e = smoothstep(-5.0, -4.0, px.sdf);\n  return vec4<f32>(mix(px.color.rgb, vec3<f32>(0.0, 0.0, 0.0), e), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/rule/idle": { fill: "foreground" },
        "ornament/signature/idle": { fill: "accent", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet q = p - c;\nlet m = min(s.x, s.y) * 0.44;\nlet d = max(abs(q.x), abs(q.y)) - m;\nlet body = sg_fill(d);\nlet edge = sg_line(d + 2.5, 2.5);\nlet st = 1.0 - step(0.5, fract((p.x - p.y) / 14.0));\nlet col = mix(px.color.rgb, vec3<f32>(0.0, 0.0, 0.0), edge);\nreturn sg_out(px, col, max(body * max(st, edge), edge));\n}\n", params: [0, 0, 0, 0], live: false } },
        "balloon/body/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "balloon/shout/idle": { fill: "accent", stroke: "foreground", strokeWidth: 4, corners: { radius: [10, 10, 10, 10], kind: "notch" } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.25, ornament: "frame", align: "start", imageTreatment: "none", sectionGap: 64, gutter: 28 }
    motion: { signature: "hard-cut", stiffness: 900, damping: 60, stagger: 140, enterMs: 380, keyframes: [{ at: 0, opacity: 0, offsetX: 6, offsetY: 6, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.004, offsetX: 5.977, offsetY: 5.977, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.017, offsetX: 5.895, offsetY: 5.895, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.047, offsetX: 5.716, offsetY: 5.716, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.111, offsetX: 5.332, offsetY: 5.332, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 3, offsetY: 3, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.889, offsetX: 0.668, offsetY: 0.668, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.953, offsetX: 0.284, offsetY: 0.284, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.983, offsetX: 0.105, offsetY: 0.105, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.996, offsetX: 0.023, offsetY: 0.023, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/developer/"
  }
}
