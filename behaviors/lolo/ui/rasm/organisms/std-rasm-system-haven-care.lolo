app std-rasm-system-haven-care [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-haven-care — the Haven Care design system for a Rasm page, anchored on NHS digital service manual and Headspace illustration (https://service-manual.nhs.uk). Colour: #F3F7F5 ground, #1F3B36 ink, #2E8B6E accent. Type: Lora over Atkinson Hyperlegible. Grid: single-column care grid with a side rail, generous 1.6 line height. Motion: the calm easing (cubic-bezier 0.45,0.00,0.40,1.00); entrance: layers drift in slowly at different depths. Interaction: card warms with a soft glow. Imagery: soft layered illustration, no clinical photos. Voice: reassuring, plain, short sentences. Components: buttons are large 52px targets; cards are rounded with a calm tint. Data: simple progress rings. Sound: soft chime on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "haven-care"
    palette: {background: "#F3F7F5", foreground: "#1F3B36", card: "#FAFBFB", "card-foreground": "#1F3B36", surface: "#EDF1EF", muted: "#E2E8E6", "muted-foreground": "#637773", border: "#94A29F", input: "#899996", primary: "#2E8B6E", "primary-hover": "#27765E", "primary-foreground": "#F3F7F5", secondary: "#FAFBFB", "secondary-foreground": "#1F3B36", "secondary-hover": "#DAE0DE", accent: "#2E8B6E", "accent-foreground": "#F3F7F5", ring: "#2E8B6E", "series-1": "#2E8B6E", "series-2": "#276755", "series-3": "#87BCAB", "series-4": "#5F736F", "series-5": "#578577"}
    fonts: { display: { family: "Lora", file: "https://almadar-kflow-assets.web.app/fonts/lora/Lora%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Atkinson Hyperlegible", file: "https://almadar-kflow-assets.web.app/fonts/atkinsonhyperlegible/AtkinsonHyperlegible-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(22,48,47,0.14)", blur: 36, offsetX: 0, offsetY: 14 }, spring: { stiffness: 120, damping: 22 } },
        "stack/panel/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" }, shadow: { color: "rgba(22,48,47,0.12)", blur: 28, offsetX: 0, offsetY: 10 }, spring: { stiffness: 120, damping: 22 } },
        "stack/slip/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [28, 28, 28, 28], kind: "scoop" }, shadow: { color: "rgba(22,48,47,0.18)", blur: 48, offsetX: 0, offsetY: 22 } },
        "stack/inset/idle": { fill: "muted", corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [32, 32, 32, 32], kind: "round" }, shadow: { color: "rgba(22,48,47,0.16)", blur: 44, offsetX: 0, offsetY: 18 } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 18px body", shadow: { color: "rgba(11,107,99,0.34)", blur: 22, offsetX: 0, offsetY: 8 }, spring: { stiffness: 160, damping: 24 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 18px body", shadow: { color: "rgba(11,107,99,0.42)", blur: 28, offsetX: 0, offsetY: 10 }, spring: { stiffness: 160, damping: 24 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 18px body", spring: { stiffness: 200, damping: 28 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 18px body", spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 18px body", shadow: { color: "rgba(22,48,47,0.12)", blur: 16, offsetX: 0, offsetY: 6 }, spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "primary", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 18px body", shadow: { color: "rgba(22,48,47,0.18)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 18px body", spring: { stiffness: 200, damping: 28 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 18px body", spring: { stiffness: 160, damping: 24 } },
        "pressable/secondary/disabled": { stroke: "border" },
        "text/display/idle": { textColor: "foreground", font: "600 76px display" },
        "text/title/idle": { textColor: "foreground", font: "600 44px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 15px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 20px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 24px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "primary", font: "600 120px display" },
        "text/label/idle": { textColor: "foreground", font: "700 17px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "600 22px display", on: "section/band/idle" },
        "icon/inverse/idle": { textColor: "primary-foreground", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(22,48,47,0.14)", blur: 32, offsetX: 0, offsetY: 12 }, spring: { stiffness: 120, damping: 22 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(22,48,47,0.2)", blur: 40, offsetX: 0, offsetY: 16 }, spring: { stiffness: 120, damping: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [24, 24, 24, 24], kind: "round" }, spring: { stiffness: 120, damping: 22 } },
        "card/surface/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, corners: { radius: [24, 24, 24, 24], kind: "round" }, spring: { stiffness: 160, damping: 26 } },
        "card/header/idle": { fill: "muted", corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [24, 24, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 16px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(22,48,47,0.14)", blur: 32, offsetX: 0, offsetY: 12 } },
        "panel/header/idle": { fill: "muted", corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "muted", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 160, damping: 24 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 160, damping: 24 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 160, damping: 24 } },
        "range/default/thumb-idle": { stroke: "border" },
        "range/default/thumb-hovered": { stroke: "border" },
        "toggle/check/off-idle": { stroke: "border" },
        "toggle/check/off-hovered": { stroke: "border" },
        "toggle/switch/off-idle": { stroke: "border" },
        "toggle/switch/off-hovered": { stroke: "border" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.1, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 112, gutter: 48 }
    motion: { signature: "calm", stiffness: 120, damping: 22, stagger: 90, enterMs: 993, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 12, scale: 0.94, rotate: 2 }, { at: 0.1, opacity: 0.019, offsetX: 0, offsetY: 11.777, scale: 0.941, rotate: 1.963 }, { at: 0.2, opacity: 0.084, offsetX: 0, offsetY: 10.986, scale: 0.945, rotate: 1.831 }, { at: 0.3, opacity: 0.214, offsetX: 0, offsetY: 9.429, scale: 0.953, rotate: 1.571 }, { at: 0.4, opacity: 0.407, offsetX: 0, offsetY: 7.114, scale: 0.964, rotate: 1.186 }, { at: 0.5, opacity: 0.614, offsetX: 0, offsetY: 4.636, scale: 0.977, rotate: 0.773 }, { at: 0.6, opacity: 0.778, offsetX: 0, offsetY: 2.664, scale: 0.987, rotate: 0.444 }, { at: 0.7, opacity: 0.889, offsetX: 0, offsetY: 1.338, scale: 0.993, rotate: 0.223 }, { at: 0.8, opacity: 0.955, offsetX: 0, offsetY: 0.534, scale: 0.997, rotate: 0.089 }, { at: 0.9, opacity: 0.99, offsetX: 0, offsetY: 0.121, scale: 0.999, rotate: 0.02 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/patient/"
  }
}
