app std-rasm-system-haven-care [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-haven-care — the Haven Care design system for a Rasm page, anchored on NHS digital service manual and Headspace illustration (https://service-manual.nhs.uk). Colour: #F3F7F5 ground, #1F3B36 ink, #2E8B6E accent. Type: Lora over Atkinson Hyperlegible. Grid: single-column care grid with a side rail, generous 1.6 line height. Motion: the calm easing (cubic-bezier 0.45,0.00,0.40,1.00); entrance: layers drift in slowly at different depths. Interaction: card warms with a soft glow. Imagery: soft layered illustration, no clinical photos. Voice: reassuring, plain, short sentences. Components: buttons are large 52px targets; cards are rounded with a calm tint. Data: simple progress rings. Sound: soft chime on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "haven-care"
    palette: {background: "#F3F7F5", foreground: "#1F3B36", card: "#FAFBFB", "card-foreground": "#1F3B36", surface: "#EDF1EF", muted: "#E2E8E6", "muted-foreground": "#4F6560", border: "#6F807C", input: "#6F807C", primary: "#1F7A5C", "primary-hover": "#186349", "primary-foreground": "#FFFFFF", secondary: "#FAFBFB", "secondary-foreground": "#1F3B36", "secondary-hover": "#DAE0DE", accent: "#2E8B6E", "accent-foreground": "#020807", ring: "#2E8B6E", "series-1": "#2E8B6E", "series-2": "#276755", "series-3": "#5E8F80", "series-4": "#5F736F", "series-5": "#578577"}
    fonts: { display: { family: "Lora", file: "https://almadar-kflow-assets.web.app/fonts/lora/Lora%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Atkinson Hyperlegible", file: "https://almadar-kflow-assets.web.app/fonts/atkinsonhyperlegible/AtkinsonHyperlegible-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 36, offsetX: 0, offsetY: 12 }, spring: { stiffness: 80, damping: 20 } },
        "stack/panel/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 36, offsetX: 0, offsetY: 12 }, spring: { stiffness: 80, damping: 20 } },
        "stack/slip/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 48, offsetX: 0, offsetY: 18 }, spring: { stiffness: 80, damping: 20 } },
        "stack/inset/idle": { fill: "muted", corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "muted", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "surface", stroke: "muted", strokeWidth: 1, corners: { radius: [32, 32, 32, 32], kind: "round" }, shadow: { color: "rgba(31,59,54,0.16)", blur: 44, offsetX: 0, offsetY: 16 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "primary", strokeWidth: 0, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(31,122,92,0.28)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "primary-hover", strokeWidth: 0, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(240,176,92,0.42)", blur: 30, offsetX: 0, offsetY: 8 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "primary-hover", strokeWidth: 0, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(31,122,92,0.2)", blur: 10, offsetX: 0, offsetY: 2 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(31,122,92,0.28)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/secondary/idle": { fill: "card", textColor: "secondary-foreground", stroke: "border", strokeWidth: 2, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(31,59,54,0.08)", blur: 16, offsetX: 0, offsetY: 6 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/secondary/hovered": { fill: "#FFF8EA", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(240,176,92,0.42)", blur: 28, offsetX: 0, offsetY: 8 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(31,59,54,0.08)", blur: 8, offsetX: 0, offsetY: 2 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/secondary/focused": { fill: "card", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(31,59,54,0.08)", blur: 16, offsetX: 0, offsetY: 6 }, spring: { stiffness: 80, damping: 20 } },
        "pressable/secondary/disabled": { fill: "surface", textColor: "muted-foreground", stroke: "border", strokeWidth: 1, corners: { radius: [26, 26, 26, 26], kind: "round" }, font: "700 19px body", shadow: { color: "rgba(0,0,0,0)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 80, damping: 20 } },
        "text/display/idle": { textColor: "foreground", font: "500 56px display" },
        "text/title/idle": { textColor: "foreground", font: "500 34px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 15px body" },
        "text/body/idle": { textColor: "foreground", font: "400 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "500 24px display" },
        "text/numeral/idle": { textColor: "primary", font: "500 120px display" },
        "text/label/idle": { textColor: "foreground", font: "700 18px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 16px body" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "500 24px display", on: "section/band/idle" },
        "icon/inverse/idle": { textColor: "primary-foreground", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 32, offsetX: 0, offsetY: 10 }, spring: { stiffness: 80, damping: 20 } },
        "card/surface/hovered": { fill: "#FFFAF0", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(240,176,92,0.42)", blur: 44, offsetX: 0, offsetY: 14 }, spring: { stiffness: 80, damping: 20 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 32, offsetX: 0, offsetY: 10 }, spring: { stiffness: 80, damping: 20 } },
        "card/surface/pressed": { fill: "surface", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 16, offsetX: 0, offsetY: 4 }, spring: { stiffness: 80, damping: 20 } },
        "card/header/idle": { fill: "muted", corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "foreground", font: "700 17px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "muted", strokeWidth: 1.5 },
        "card/media/idle": { fill: "muted", corners: { radius: [24, 24, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 16px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 24, 24], kind: "round" }, shadow: { color: "rgba(31,59,54,0.14)", blur: 32, offsetX: 0, offsetY: 10 }, spring: { stiffness: 80, damping: 20 } },
        "panel/header/idle": { fill: "muted", stroke: "muted", strokeWidth: 1, corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "foreground", font: "700 17px body" },
        "panel/divider/idle": { stroke: "muted", strokeWidth: 1.5 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "muted", strokeWidth: 1.5 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 80, damping: 20 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 80, damping: 20 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 80, damping: 20 } },
        "range/default/thumb-idle": { stroke: "border" },
        "range/default/thumb-hovered": { stroke: "border" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "border", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" }
      }
    layout: { hero: "editorial", columns: 8, asymmetry: 0.2, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 128, gutter: 56 }
    motion: { signature: "calm", stiffness: 80, damping: 20, stagger: 140, enterMs: 1120, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 30, scale: 0.99, rotate: 0 }, { at: 0.1, opacity: 0.019, offsetX: 0, offsetY: 29.443, scale: 0.99, rotate: 0 }, { at: 0.2, opacity: 0.084, offsetX: 0, offsetY: 27.466, scale: 0.991, rotate: 0 }, { at: 0.3, opacity: 0.214, offsetX: 0, offsetY: 23.572, scale: 0.992, rotate: 0 }, { at: 0.4, opacity: 0.407, offsetX: 0, offsetY: 17.786, scale: 0.994, rotate: 0 }, { at: 0.5, opacity: 0.614, offsetX: 0, offsetY: 11.589, scale: 0.996, rotate: 0 }, { at: 0.6, opacity: 0.778, offsetX: 0, offsetY: 6.66, scale: 0.998, rotate: 0 }, { at: 0.7, opacity: 0.889, offsetX: 0, offsetY: 3.344, scale: 0.999, rotate: 0 }, { at: 0.8, opacity: 0.955, offsetX: 0, offsetY: 1.336, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.99, offsetX: 0, offsetY: 0.303, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/patient/"
  }
}
