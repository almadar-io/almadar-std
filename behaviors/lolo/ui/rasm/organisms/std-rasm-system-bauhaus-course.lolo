app std-rasm-system-bauhaus-course [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-bauhaus-course — the Bauhaus Course design system for a Rasm page, anchored on Herbert Bayer's Universal alphabet and Bauhaus Dessau course charts (https://en.wikipedia.org/wiki/Herbert_Bayer). Colour: #F1EDE4 ground, #1A1A1A ink, #1F4E9E accent. Type: Jost over Outfit. Grid: strict 6-column constructive grid with circle/square/triangle modules. Motion: the constructive easing (cubic-bezier 0.60,0.00,0.40,1.00); entrance: primary shapes assemble, then text. Interaction: shape rotates 90 degrees. Imagery: primary geometric figures. Voice: instructive, step by step. Components: buttons are circle and square tokens; cards are colour-blocked panels. Data: geometric pie and square-area charts. Sound: wood block tap on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "bauhaus-course"
    palette: { background: "#F1EDE4", foreground: "#1A1A1A", card: "#F9F7F3", "card-foreground": "#1A1A1A", surface: "#EBE7DE", muted: "#E0DCD4", "muted-foreground": "#4C4B48", border: "#7A7873", input: "#6F6D68", primary: "#1F4E9E", "primary-hover": "#17407F", "primary-foreground": "#F9F7F3", secondary: "#F9F7F3", "secondary-foreground": "#1A1A1A", "secondary-hover": "#D7D4CC", accent: "#1F4E9E", "accent-foreground": "#F9F7F3", ring: "#1F4E9E", "series-1": "#1F4E9E", "series-2": "#C8281E", "series-3": "#F2B705", "series-4": "#1A1A1A", "series-5": "#7A7873" }
    fonts: { display: { family: "Jost", file: "https://almadar-kflow-assets.web.app/fonts/jost/Jost%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Outfit", file: "https://almadar-kflow-assets.web.app/fonts/outfit/Outfit%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let w = px.size.x / 6.0;\n  let gx = abs(fract(px.local.x / max(w, 1.0)) - 0.5);\n  let line = 1.0 - smoothstep(0.0, 0.004, 0.5 - gx);\n  let col = mix(px.color.rgb, vec3<f32>(0.1, 0.1, 0.1), line * 0.08);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#1F4E9E", blur: 0, offsetX: 8, offsetY: 8 } },
        "stack/panel/idle": { fill: "series-3", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#1A1A1A", blur: 0, offsetX: 6, offsetY: 6 } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/primary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 16px body", spring: { stiffness: 300, damping: 26 }, shadow: { color: "#1F4E9E", blur: 0, offsetX: 8, offsetY: 8 } },
        "pressable/primary/pressed": { fill: "series-2", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "card", font: "700 16px body", spring: { stiffness: 380, damping: 30 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/hovered": { fill: "series-3", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/pressed": { fill: "accent", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "accent-foreground", font: "700 16px body", spring: { stiffness: 380, damping: 30 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/disabled": { fill: "background", stroke: "input", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "muted-foreground", font: "700 16px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 26 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 26 } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#1F4E9E", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#1F4E9E", blur: 0, offsetX: 12, offsetY: 12 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 5, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#1F4E9E", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 300, damping: 26 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#1F4E9E", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 380, damping: 30 } },
        "card/header/idle": { fill: "series-2", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "card", font: "700 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "card/media/idle": { fill: "series-3", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 14px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "section/band/idle": { fill: "accent" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 4 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "text/display/idle": { textColor: "foreground", font: "800 100px display" },
        "text/numeral/idle": { textColor: "foreground", font: "800 120px display" },
        "text/title/idle": { textColor: "foreground", font: "700 42px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 26px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "accent-foreground", font: "700 24px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 14px body" },
        "text/label/idle": { textColor: "foreground", font: "700 14px body" },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 4 },
        "morph/default/idle": { fill: "series-3", stroke: "foreground", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let h = px.size.y;\n  let u = min(h, px.size.x / 3.4);\n  let p = px.local - vec2<f32>(0.0, (h - u) * 0.5);\n  let cc = p - vec2<f32>(u * 0.5, u * 0.5);\n  let circle = 1.0 - smoothstep(u * 0.5 - 1.0, u * 0.5, length(cc));\n  let q = p - vec2<f32>(u * 1.2, 0.0);\n  let sq = step(0.0, q.x) * step(q.x, u) * step(0.0, q.y) * step(q.y, u);\n  let r = p - vec2<f32>(u * 2.4, 0.0);\n  let inside = step(0.0, r.x) * step(r.x, u) * step(0.0, r.y) * step(r.y, u);\n  let tri = inside * step(abs(r.x - u * 0.5) * 2.0, r.y);\n  let col = circle * vec3<f32>(0.78, 0.16, 0.12) + sq * vec3<f32>(0.12, 0.31, 0.62) + tri * vec3<f32>(0.95, 0.72, 0.02);\n  let a = clamp(circle + sq + tri, 0.0, 1.0);\n  return vec4<f32>(col, a * px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 6, asymmetry: 0, ornament: "none", align: "start", imageTreatment: "riso", sectionGap: 96, gutter: 24 }
    motion: { signature: "constructive", stiffness: 260, damping: 24, stagger: 90, enterMs: 640, keyframes: [{ at: 0, opacity: 0, offsetX: -48, offsetY: 0, scale: 0.55, rotate: -90 }, { at: 0.1, opacity: 0.01, offsetX: -47.499, offsetY: 0, scale: 0.555, rotate: -89.061 }, { at: 0.2, opacity: 0.048, offsetX: -45.698, offsetY: 0, scale: 0.572, rotate: -85.683 }, { at: 0.3, opacity: 0.127, offsetX: -41.893, offsetY: 0, scale: 0.607, rotate: -78.549 }, { at: 0.4, opacity: 0.273, offsetX: -34.897, offsetY: 0, scale: 0.673, rotate: -65.432 }, { at: 0.5, opacity: 0.5, offsetX: -24, offsetY: 0, scale: 0.775, rotate: -45 }, { at: 0.6, opacity: 0.727, offsetX: -13.103, offsetY: 0, scale: 0.877, rotate: -24.568 }, { at: 0.7, opacity: 0.873, offsetX: -6.107, offsetY: 0, scale: 0.943, rotate: -11.451 }, { at: 0.8, opacity: 0.952, offsetX: -2.302, offsetY: 0, scale: 0.978, rotate: -4.317 }, { at: 0.9, opacity: 0.99, offsetX: -0.501, offsetY: 0, scale: 0.995, rotate: -0.939 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/lms/"
  }
}
