app std-rasm-system-gazette-feature [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-gazette-feature — the Gazette Feature design system for a Rasm page, anchored on The New Yorker magazine layout and the Caslon headline tradition (https://www.newyorker.com). Colour: #FBF8F1 newsprint ground, #141414 ink, #8E1B1B oxblood accent. Type: Playfair Display over Source Serif 4. Grid: three-column magazine grid with a two-column feature span and drop caps. Motion: the page-turn easing (cubic-bezier 0.45,0.05,0.25,1.00); entrance: columns fade in left to right. Interaction: the headline gains a hairline underline. Imagery: engravings and spot illustration. Voice: literate, measured, third person. Components: buttons are small-caps text links with a rule; cards are bylined article blocks. Data: small multiples in black ink. Sound: a page-turn rustle on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "gazette-feature"
    palette: {background: "#FBF8F1", foreground: "#141414", card: "#FDFCF9", "card-foreground": "#141414", surface: "#F4F1EA", muted: "#E9E6DF", "muted-foreground": "#5E5D5B", border: "#8A8884", input: "#7F7D79", primary: "#8E1B1B", "primary-hover": "#701515", "primary-foreground": "#FBF8F1", secondary: "#FDFCF9", "secondary-foreground": "#141414", "secondary-hover": "#E9E6DF", accent: "#8E1B1B", "accent-foreground": "#FBF8F1", ring: "#8E1B1B", "series-1": "#141414", "series-2": "#4A4846", "series-3": "#8A8884", "series-4": "#8E1B1B", "series-5": "#BDB9B1"}
    fonts: { display: { family: "Playfair Display", file: "https://almadar-kflow-assets.web.app/fonts/playfairdisplay/PlayfairDisplay%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Source Serif 4", file: "https://almadar-kflow-assets.web.app/fonts/sourceserif4/SourceSerif4%5Bopsz%2Cwght%5D.ttf", generic: "serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn gz_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); } fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let cw = px.size.x / 6.0; let fx = fract(p.x / cw); let dl = min(fx, 1.0 - fx) * cw; var d = (1.0 - smoothstep(0.4, 1.1, dl)) * 0.05; d = d + (1.0 - smoothstep(0.4, 1.1, abs(dl - 5.0))) * 0.03; let hy = fract(p.y / 760.0) * 760.0; d = d + (1.0 - smoothstep(0.4, 1.1, abs(hy - 36.0))) * 0.05 + (1.0 - smoothstep(0.4, 1.1, abs(hy - 41.0))) * 0.03; let hatch = smoothstep(0.35, 0.5, abs(fract((p.x + p.y + px.scroll * 120.0) / 3.5) - 0.5)); d = d + hatch * 0.012 * (1.0 - px.uv.y); d = d + (gz_h(floor(p)) - 0.5) * 0.03; return vec4<f32>(px.color.rgb + vec3<f32>(s * d), px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 } },
        "stack/panel/idle": { fill: "surface", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/hero/idle": { corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { textColor: "primary", font: "700 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 } },
        "pressable/primary/hovered": { fill: "muted", stroke: "primary", strokeWidth: 1, textColor: "primary-hover", font: "700 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary", textColor: "primary-foreground", font: "700 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 220, damping: 28 } },
        "pressable/primary/focused": { stroke: "ring", strokeWidth: 2, textColor: "primary", font: "700 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/secondary/idle": { textColor: "foreground", font: "600 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "foreground", strokeWidth: 1, textColor: "foreground", font: "600 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 } },
        "pressable/secondary/pressed": { fill: "foreground", textColor: "background", font: "600 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/secondary/disabled": { textColor: "muted-foreground", font: "600 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/secondary/focused": { stroke: "ring", strokeWidth: 2, textColor: "foreground", font: "600 14px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "range/default/thumb-hovered": { stroke: "input" },
        "range/default/thumb-idle": { stroke: "input" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 }, decor: "engraved-border" },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 }, decor: "engraved-border" },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 140, damping: 26 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 220, damping: 28 } },
        "card/header/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 12px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 0.75 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "background", stroke: "foreground", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 12px body" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 0.75 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 17px body" },
        "material/fold/idle": { fill: "border" },
        "morph/default/idle": { fill: "accent" },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 0.5 },
        "ornament/double-rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet a = max(sg_line(p.y - (c.y - 3.5), 1.5), sg_line(p.y - (c.y + 3.5), 0.5));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet a = sg_line(p.y - c.y, 1);\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "text/display/idle": { textColor: "foreground", font: "700 64px display" },
        "text/poster/idle": { textColor: "foreground", font: "800 84px display" },
        "text/numeral/idle": { textColor: "foreground", font: "700 96px display" },
        "text/quote/idle": { textColor: "primary", font: "400 36px display" },
        "text/title/idle": { textColor: "foreground", font: "700 30px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 12px body" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 22px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "700 22px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px body" },
        "text/label/idle": { textColor: "foreground", font: "700 12px body" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet top = max(sg_line(p.y - 6.0, 1.5), sg_line(p.y - 11.0, 0.5));\nlet vr = max(sg_line(p.x - s.x / 3.0, 0.5), sg_line(p.x - s.x * 2.0 / 3.0, 0.5)) * step(16.0, p.y);\nlet q = p - c;\nlet dg = max(sg_line(abs(q.x) + abs(q.y) - 9.0, 1.0), max(sg_fill(length(q) - 2.5), sg_fill(length(vec2<f32>(abs(q.x) - 17.0, q.y)) - 2.0)));\nreturn sg_out(px, px.color.rgb, max(max(top, vr), dg));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    systemBreakpointLooks: { phone: { "text/poster/idle": { textColor: "foreground", font: "800 44px display" }, "text/display/idle": { textColor: "foreground", font: "700 40px display" }, "text/quote/idle": { textColor: "primary", font: "400 26px display" }, "text/title/idle": { textColor: "foreground", font: "700 24px display" }, "text/numeral/idle": { textColor: "foreground", font: "700 64px display" } }, tablet: { "text/poster/idle": { textColor: "foreground", font: "800 64px display" }, "text/display/idle": { textColor: "foreground", font: "700 52px display" } } }
    layout: { hero: "editorial", columns: 3, asymmetry: 0.33, ornament: "double-rule", align: "start", imageTreatment: "engraving", sectionGap: 88, gutter: 32 }
    motion: { signature: "page-turn", stiffness: 140, damping: 26, stagger: 140, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: -26, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.03, offsetX: -25.214, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.117, offsetX: -22.959, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.299, offsetX: -18.235, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.549, offsetX: -11.734, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.741, offsetX: -6.737, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.86, offsetX: -3.652, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.931, offsetX: -1.789, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.973, offsetX: -0.708, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.994, offsetX: -0.16, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/client-case/"
  }
}
