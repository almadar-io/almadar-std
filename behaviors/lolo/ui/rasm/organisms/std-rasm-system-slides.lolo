        "slides/rail/idle:q5": { fill: "series-5" },
        "slides/progress/idle:q5": { fill: "series-5" },
        "text/mark/idle": { textColor: "muted", font: "800 150px display" },
        "slides/rail/idle": { fill: "muted" },
