e": { textColor: "primary", font: "500 14px mono" }, "text/label/idle": { textColor: "foreground", font: "500 16px body" }, "text/mark/idle": { textColor: "muted", font: "800 110px display" } },
      phone: { "text/display/idle": { textColor: "foreground", font: "700 34px display" }, "text/title/idle": { textColor: "foreground", font: "600 24px display" }, "text/statement/idle": { textColor: "foreground", font: "600 24px display" }, "text/statement/accent": { textColor: "primary", font: "600 24px display" }, "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" }, "text/body/strong": { textColor: "foreground", font: "500 17px body" }, "text/note/idle": { textColor: "foreground", font: "400 19px body" }, "text/note/cue": { textColor: "primary", font: "600 19px body" }, "text/clock/idle": { textColor: "foreground", font: "600 36px mono" }, "text/clock/late": { textColor: "primary", font: "600 36px mono" }, "archi/element/accent": { fill: "primary", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "primary-foreground", font: "600 11px body" }, "archi/element/dim": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "input", font: "500 11px body" }, "archi/element/idle": { fill: "surface", stroke: "muted-foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 11px body" }, "archi/element/refused": { fill: "surface", stroke: "foreground", strokeWidth: 2, strokeDash: [6, 6], corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 11px body" }, "archi/group/accent": { stroke: "primary", strokeWidth: 2, strokeDash: [8, 6], corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary", font: "500 12px mono" }, "archi/group/idle": { stroke: "muted-foreground", strokeWidth: 1, strokeDash: [8, 6], corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "muted-foreground", font: "500 12px mono" }, "archi/layer/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "muted-foreground", font: "500 12px mono" }, "archi/legend/idle": { textColor: "muted-foreground", font: "400 12px mono" }, "slides/counter/idle": { textColor: "input", font: "500 12px mono" }, "text/caption/idle": { textColor: "muted-foreground", font: "400 13px body" }, "text/eyebrow/idle": { textColor: "primary", font: "500 12px mono" }, "text/label/idle": { textColor: "foreground", font: "500 13px body" }, "text/mark/idle": { textColor: "muted", font: "800 64px display" } }
    }
    layout: { hero: "centered", columns: 1, asymmetry: 0, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 0, gutter: 32 }
    motion: { signature: "settle", stiffness: 170, damping: 26, stagger: 90, enterMs: 520, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 16, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.48, offsetX: 0, offsetY: 7.6, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.8, offsetX: 0, offsetY: 3.1, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.94, offsetX: 0, offsetY: 1, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.99, offsetX: 0, offsetY: 0.2, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
  }
}
