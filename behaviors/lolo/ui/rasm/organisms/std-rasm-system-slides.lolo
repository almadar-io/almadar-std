        "slides/progress/idle": { fill: "primary" },
        "slides/track/idle": { fill: "muted" },
        "slides/pointer/idle": { fill: "primary", shadow: { color: "rgba(255,176,0,0.55)", blur: 24, offsetX: 0, offsetY: 0 } },
        "slides/blank/idle": { fill: "#000000" },
        "slides/tile/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "muted-foreground", font: "500 14px mono" },
        "slides/tile/current": { fill: "surface", stroke: "primary", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "primary", font: "600 14px mono" },
        "slides/counter/idle": { textColor: "input", font: "500 17px mono" }
      }
    systemBreakpointLooks: {
      wide: { "text/display/idle": { textColor: "foreground", font: "700 100px display" }, "text/title/idle": { textColor: "foreground", font: "600 72px display" }, "text/statement/idle": { textColor: "foreground", font: "600 72px display" }, "text/statement/accent": { textColor: "primary", font: "600 72px display" }, "text/body/idle": { textColor: "muted-foreground", font: "400 40px body" }, "text/body/strong": { textColor: "foreground", font: "500 40px body" }, "text/eyebrow/idle": { textColor: "primary", font: "500 24px mono" }, "text/caption/idle": { textColor: "muted-foreground", font: "400 28px body" }, "archi/element/idle": { fill: "surface", stroke: "muted-foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 28px body" }, "archi/element/accent": { fill: "primary", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "primary-foreground", font: "600 28px body" }, "archi/element/dim": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "input", font: "500 28px body" }, "archi/element/refused": { fill: "surface", stroke: "foreground", strokeWidth: 2, strokeDash: [6, 6], corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 28px body" }, "archi/layer/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "muted-foreground", font: "500 24px mono" }, "archi/group/accent": { stroke: "primary", strokeWidth: 2, strokeDash: [8, 6], corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary", font: "500 24px mono" }, "archi/group/idle": { stroke: "muted-foreground", strokeWidth: 1, strokeDash: [8, 6], corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "muted-foreground", font: "500 24px mono" }, "archi/legend/idle": { textColor: "muted-foreground", font: "400 24px mono" }, "slides/counter/id