app std-rasm-system-slides [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-slides — the Slides design system for a Rasm page shown on a projector, anchored on the dark stage of a conference keynote. Colour: #0D0E11 ground, #F1EEE7 ink, one accent #FFB000 that a deck keeps for the one thing its story follows. Colour per chapter: five chapter hues (#FF6B5E, #4CC2FF, #5EE6A8, #B49CFF, #FF8AD0) a deck gives its parts through a slide's `tone`, in the looks named `<look>:q1` to `<look>:q5`. Type: Bricolage Grotesque over Geist, Geist Mono for markers; sizes are set for a desktop projector and step up at wide and down at tablet and phone. Grid: one centred stage, wide margins, one idea per slide. Motion: a slow settle (cubic-bezier 0.22,1.00,0.36,1.00); entrance: content rises 16px and fades in, one part at a time. Interaction: quiet, a key or a clicker moves it. Imagery: line diagrams in ink on the ground, the accent filled. Voice: short declarative sentences. Components: plates are hairline-stroked panels with 10px corners. Data: one figure per slide. Looks beyond the base set: text/statement, text/note, archi/<part>/<state> for architecture views and slides/<part>/idle for the deck's own marks. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  traits {
    Theme {
      config { breakpoints: [{ name: "phone", min: 0 }, { name: "tablet", min: 640 }, { name: "desktop", min: 1024 }, { name: "wide", min: 1800 }] }
    }
  }
  config {
    system: "slides"
    palette: {background: "#0D0E11", foreground: "#F1EEE7", card: "#16181D", "card-foreground": "#F1EEE7", surface: "#1C1F26", muted: "#262A33", "muted-foreground": "#A4A9B3", border: "#474D5A", input: "#6B7280", primary: "#FFB000", "primary-hover": "#FFC233", "primary-foreground": "#0D0E11", secondary: "#1C1F26", "secondary-foreground": "#F1EEE7", "secondary-hover": "#262A33", accent: "#FFB000", "accent-foreground": "#0D0E11", ring: "#FFB000", "series-1": "#FF6B5E", "series-2": "#4CC2FF", "series-3": "#5EE6A8", "series-4": "#B49CFF", "series-5": "#FF8AD0"}
    fonts: { display: { family: "Bricolage Grotesque", file: "https://almadar-kflow-assets.web.app/fonts/bricolagegrotesque/BricolageGrotesque%5Bopsz%2Cwdth%2Cwght%5D.ttf", generic: "sans-serif" }, body: { family: "Geist", file: "https://almadar-kflow-assets.web.app/fonts/geist/Geist%5Bwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Geist Mono", file: "https://almadar-kflow-assets.web.app/fonts/geistmono/GeistMono%5Bwght%5D.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "section/band/idle": { fill: "background" },
        "section/rule/idle": { stroke: "muted", strokeWidth: 1 },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "stack/well/idle": { fill: "surface", corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "stack/hero/idle": { fill: "background" },
        "stack/bar/idle": { fill: "background", stroke: "muted", strokeWidth: 1 },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "panel/header/idle": { fill: "surface", corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "500 15px mono" },
        "panel/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "card/surface/hovered": { fill: "surface", stroke: "muted-foreground", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "card/surface/pressed": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "card/header/idle": { fill: "surface", corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "500 15px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "muted", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [10, 10, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 18px body", on: "card/surface/idle" },
        "pulse/default/idle": { fill: "foreground", stroke: "background", strokeWidth: 2, textColor: "background", font: "600 14px mono" },
        "pulse/hot/idle": { fill: "primary", stroke: "background", strokeWidth: 2, textColor: "primary-foreground", font: "600 14px mono" },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", spring: { stiffness: 170, damping: 26 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", spring: { stiffness: 170, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", spring: { stiffness: 240, damping: 28 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", stroke: "foreground", strokeWidth: 3 },
        "pressable/secondary/idle": { fill: "surface", stroke: "border", strokeWidth: 1, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", spring: { stiffness: 170, damping: 26 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "muted-foreground", strokeWidth: 1, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", spring: { stiffness: 170, damping: 26 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "border", strokeWidth: 1, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body", spring: { stiffness: 240, damping: 28 } },
        "pressable/secondary/focused": { fill: "surface", stroke: "ring", strokeWidth: 3, textColor: "secondary-foreground", corners: { radius: [10, 10, 10, 10], kind: "round" }, font: "600 18px body" },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "400 20px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "400 20px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "400 20px body" },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "400 20px body" },
        "morph/default/idle": { fill: "primary" },
        "ornament/signature/idle": { fill: "primary" },
        "text/display/idle": { textColor: "foreground", font: "700 76px display" },
        "text/title/idle": { textColor: "foreground", font: "600 46px display" },
        "text/statement/idle": { textColor: "foreground", font: "600 46px display" },
        "text/statement/accent": { textColor: "primary", font: "600 46px display" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 29px body" },
        "text/body/strong": { textColor: "foreground", font: "500 29px body" },
        "text/eyebrow/idle": { textColor: "primary", font: "500 17px mono" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 19px body" },
        "text/label/idle": { textColor: "foreground", font: "500 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 28px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "foreground", font: "600 32px display", on: "section/band/idle" },
        "text/code/idle": { textColor: "muted-foreground", font: "400 20px mono" },
        "text/code/active": { textColor: "primary", font: "500 20px mono" },
        "text/note/idle": { textColor: "foreground", font: "400 24px body" },
        "text/note/cue": { textColor: "primary", font: "600 24px body" },
        "text/clock/idle": { textColor: "foreground", font: "600 56px mono" },
        "text/clock/late": { textColor: "primary", font: "600 56px mono" },
        "archi/layer/idle": { fill: "card", stroke: "muted", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "muted-foreground", font: "500 17px mono" },
        "archi/element/idle": { fill: "surface", stroke: "muted-foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 20px body" },
        "archi/element/accent": { fill: "primary", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "primary-foreground", font: "600 20px body" },
        "archi/element/dim": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "input", font: "500 20px body" },
        "archi/element/refused": { fill: "surface", stroke: "foreground", strokeWidth: 2, strokeDash: [6, 6], corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "500 20px body" },
        "archi/group/idle": { stroke: "muted-foreground", strokeWidth: 1, strokeDash: [8, 6], corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "muted-foreground", font: "500 17px mono" },
        "archi/group/accent": { stroke: "primary", strokeWidth: 2, strokeDash: [8, 6], corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary", font: "500 17px mono" },
        "archi/relation/idle": { stroke: "muted-foreground", strokeWidth: 2, fill: "muted-foreground", textColor: "muted-foreground", font: "400 15px mono" },
        "archi/relation/accent": { stroke: "primary", strokeWidth: 3, fill: "primary", textColor: "primary", font: "500 15px mono" },
        "archi/relation/dim": { stroke: "border", strokeWidth: 1, fill: "border", textColor: "input", font: "400 15px mono" },
        "archi/legend/idle": { textColor: "muted-foreground", font: "400 17px mono" },
        "text/eyebrow/idle:q1": { textColor: "series-1" },
        "text/statement/accent:q1": { textColor: "series-1" },
        "text/mark/idle:q1": { textColor: "series-1" },
