app std-rasm-system-bogolan-cloth [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-bogolan-cloth — the Bogolan Cloth design system for a Rasm page, anchored on Bògòlanfini mudcloth of Mali (https://en.wikipedia.org/wiki/B%C3%B2g%C3%B2lanfini). Colour: #E6D3B3 ground, #2B1D14 ink, #7F3B1C accent. Type: Yeseva One over Mukta. Grid: woven cloth grid of pattern rows. Motion: the hand-dye easing (cubic-bezier 0.33,0.00,0.20,1.00); entrance: pattern rows print one by one like dye. Interaction: pattern row shifts by one motif. Imagery: mudcloth motifs and textile photos. Voice: storyteller, maker names, provenance. Components: buttons are cloth tabs with stitched edge; cards are cloth swatches. Data: dotted progress rows. Sound: djembe tap on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "bogolan-cloth"
    palette: {background: "#E6D3B3", foreground: "#2B1D14", card: "#F4EBDD", "card-foreground": "#2B1D14", surface: "#E0CEAE", muted: "#D7C4A6", "muted-foreground": "#5C4D3E", border: "#7A6A55", input: "#75654F", primary: "#7F3B1C", "primary-hover": "#6C3218", "primary-foreground": "#E6D3B3", secondary: "#F4EBDD", "secondary-foreground": "#2B1D14", "secondary-hover": "#D0BDA0", accent: "#7F3B1C", "accent-foreground": "#E6D3B3", ring: "#7F3B1C", "series-1": "#7F3B1C", "series-2": "#592E18", "series-3": "#AD7F60", "series-4": "#635444", "series-5": "#7F5D4E"}
    fonts: { display: { family: "Yeseva One", file: "https://almadar-kflow-assets.web.app/fonts/yesevaone/YesevaOne-Regular.ttf", generic: "serif" }, body: { family: "Mukta", file: "https://almadar-kflow-assets.web.app/fonts/mukta/Mukta-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn mu_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn mu_n(p: vec2<f32>) -> f32 {\n  let i = floor(p);\n  let f = fract(p);\n  let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(mu_h(i), mu_h(i + vec2<f32>(1.0, 0.0)), u.x), mix(mu_h(i + vec2<f32>(0.0, 1.0)), mu_h(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let lum = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114));\n  let ink = select(vec3<f32>(0.90, 0.84, 0.70), vec3<f32>(0.16, 0.10, 0.06), lum > 0.5);\n  let B = 56.0;\n  let row = floor(px.local.y / B);\n  let w = (mu_n(px.local * 0.05) - 0.5) * 5.0;\n  let x = px.local.x + w + mu_h(vec2<f32>(row, 1.0)) * 40.0;\n  let y = px.local.y + (mu_n(vec2<f32>(x * 0.04, row)) - 0.5) * 5.0;\n  let ly = fract(y / B) * B;\n  let kind = floor(mu_h(vec2<f32>(row, 7.0)) * 4.0);\n  let zig = abs(fract(x / 40.0) - 0.5) * 40.0;\n  let chev = 1.0 - smoothstep(0.0, 1.6, abs(ly - 14.0 - zig * 1.0) - 1.6);\n  let chev2 = 1.0 - smoothstep(0.0, 1.6, abs(ly - 34.0 - zig) - 1.6);\n  let dash = step(fract(x / 16.0), 0.45) * (1.0 - smoothstep(0.0, 1.0, abs(ly - 28.0) - 2.0));\n  let bar = 1.0 - smoothstep(0.0, 1.5, abs(ly - 3.0) - 1.4);\n  let dots = 1.0 - smoothstep(0.0, 1.0, length(vec2<f32>(fract(x / 28.0) - 0.5, (ly - 28.0) / 28.0)) * 28.0 - 4.0);\n  var a = bar * 0.7;\n  a = a + select(0.0, chev + chev2, kind < 1.0) + select(0.0, dash, kind >= 1.0 && kind < 2.0);\n  a = a + select(0.0, dots, kind >= 2.0 && kind < 3.0) + select(0.0, chev * 0.8, kind >= 3.0);\n  let fray = 0.8 + 0.4 * mu_n(px.local * 0.7);\n  let rise = 0.9 + 0.1 * sin(px.time * 0.2 + row);\n  return vec4<f32>(mix(px.color.rgb, ink, clamp(a * 0.11 * fray * rise, 0.0, 0.2)), 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "text/numeral/idle": { textColor: "primary", font: "400 56px display" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 200, damping: 14 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 3, gap: 10 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 200, damping: 14 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "foreground", strokeWidth: 2, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 200, damping: 14 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 4 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 260, damping: 18 } },
        "card/header/idle": { fill: "foreground", textColor: "card", font: "400 15px display", corners: { radius: [0, 0, 0, 0], kind: "round" }, on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [8, 5] },
        "card/media/idle": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "primary", textColor: "primary-foreground", font: "400 15px display", corners: { radius: [0, 0, 0, 0], kind: "round" }, on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [8, 5] },
        "section/band/idle": { fill: "surface", material: { wgsl: "fn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn fr_mark(p: vec2<f32>, h: f32) -> f32 {\nlet per = h * 2.0;\nlet cell = floor(p.x / per);\nlet k = i32(cell) % 4;\nlet lx = p.x - cell * per;\nlet wd = max(1.0, h * 0.09);\nvar a = max(sg_line(p.y, wd), sg_line(p.y - h, wd));\nif (k == 0) {\nlet tri = abs(fract(lx / per * 2.0) - 0.5) * 2.0;\na = max(a, sg_line(p.y - h * (0.28 + 0.44 * tri), wd));\n} else if (k == 1) {\nlet q = min(length(vec2<f32>(lx - per * 0.2, p.y - h * 0.5)), min(length(vec2<f32>(lx - per * 0.5, p.y - h * 0.5)), length(vec2<f32>(lx - per * 0.8, p.y - h * 0.5))));\nlet r = h * 0.14;\na = max(a, 1.0 - smoothstep(r - 0.7, r + 0.7, q));\n} else if (k == 2) {\nlet dx = lx - per * 0.5;\nlet dy = p.y - h * 0.5;\nlet cross = max(sg_line((dy - dx * 0.6) * 0.86, wd), sg_line((dy + dx * 0.6) * 0.86, wd));\na = max(a, cross * step(abs(dx), per * 0.25) * step(abs(dy), h * 0.3));\n} else {\nlet sp = per / 4.0;\nlet d = (fract(lx / sp) - 0.5) * sp;\nlet rung = sg_line(abs(d) - sp * 0.5, wd) * step(abs(p.y - h * 0.5), h * 0.2);\na = max(a, max(rung, max(sg_line(p.y - h * 0.3, wd), sg_line(p.y - h * 0.7, wd))));\n}\nreturn a;\n}\nfn shade(px: Pixel) -> vec4<f32> {\nlet a = fr_mark(px.local, 14.0) * step(px.local.y, 14.0);\nreturn vec4<f32>(mix(px.color.rgb, px.color.rgb * 0.4, a), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "section/rule/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn fr_mark(p: vec2<f32>, h: f32) -> f32 {\nlet per = h * 2.0;\nlet cell = floor(p.x / per);\nlet k = i32(cell) % 4;\nlet lx = p.x - cell * per;\nlet wd = max(1.0, h * 0.09);\nvar a = max(sg_line(p.y, wd), sg_line(p.y - h, wd));\nif (k == 0) {\nlet tri = abs(fract(lx / per * 2.0) - 0.5) * 2.0;\na = max(a, sg_line(p.y - h * (0.28 + 0.44 * tri), wd));\n} else if (k == 1) {\nlet q = min(length(vec2<f32>(lx - per * 0.2, p.y - h * 0.5)), min(length(vec2<f32>(lx - per * 0.5, p.y - h * 0.5)), length(vec2<f32>(lx - per * 0.8, p.y - h * 0.5))));\nlet r = h * 0.14;\na = max(a, 1.0 - smoothstep(r - 0.7, r + 0.7, q));\n} else if (k == 2) {\nlet dx = lx - per * 0.5;\nlet dy = p.y - h * 0.5;\nlet cross = max(sg_line((dy - dx * 0.6) * 0.86, wd), sg_line((dy + dx * 0.6) * 0.86, wd));\na = max(a, cross * step(abs(dx), per * 0.25) * step(abs(dy), h * 0.3));\n} else {\nlet sp = per / 4.0;\nlet d = (fract(lx / sp) - 0.5) * sp;\nlet rung = sg_line(abs(d) - sp * 0.5, wd) * step(abs(p.y - h * 0.5), h * 0.2);\na = max(a, max(rung, max(sg_line(p.y - h * 0.3, wd), sg_line(p.y - h * 0.7, wd))));\n}\nreturn a;\n}\nfn shade(px: Pixel) -> vec4<f32> {\nlet a = fr_mark(px.local, max(px.size.y, 8.0));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/focused": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, strokeDash: [14, 3], inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 4 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 2.5, strokeDash: [14, 3], inset: { stroke: "foreground", strokeWidth: 1, gap: 4 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 6 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, strokeDash: [9, 5], inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 4 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2.5, strokeDash: [9, 5], inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 8 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2.5, strokeDash: [5, 4], inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 3 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, strokeDash: [9, 5], inset: { stroke: "foreground", strokeWidth: 1, gap: 4 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2.5, strokeDash: [9, 5], inset: { stroke: "foreground", strokeWidth: 1.5, gap: 8 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "secondary-foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "text/display/idle": { textColor: "foreground", font: "400 72px display" },
        "text/title/idle": { textColor: "foreground", font: "400 38px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 13px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 23px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 3 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet rowH = 26.0;\nlet row = floor(p.y / rowH);\nlet kind = row - 3.0 * floor(row / 3.0);\nlet q = vec2<f32>(p.x, (p.y - row * rowH) - rowH * 0.5);\nlet dots = sg_fill(length(vec2<f32>(fract(q.x / 16.0) * 16.0 - 8.0, q.y)) - 3.0);\nlet zz = sg_line((q.y - (abs(fract(q.x / 20.0) - 0.5) * 20.0 - 5.0)) * 0.7, 1.2);\nlet fx = fract(q.x / 20.0) * 20.0 - 10.0;\nlet cr = max(sg_line(fx, 1.0) * step(abs(q.y), 6.0), sg_line(q.y, 1.0) * step(abs(fx), 6.0));\nlet pick = select(select(cr, zz, kind > 0.5 && kind < 1.5), dots, kind < 0.5);\nlet sep = sg_line(p.y - row * rowH, 0.8) * 0.8;\nreturn sg_out(px, px.color.rgb, max(pick, sep));\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/secondary/pressed": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2.5, strokeDash: [5, 4], inset: { stroke: "foreground", strokeWidth: 1.5, gap: 3 }, corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "secondary-foreground", font: "600 16px body", spring: { stiffness: 200, damping: 14 } },
        "pressable/secondary/disabled": { fill: "card", stroke: "input", strokeWidth: 2, strokeDash: [9, 5], corners: { radius: [0, 0, 14, 14], kind: "bevel" }, textColor: "muted-foreground", font: "600 16px body" },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [10, 6] },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 5 } },
        "image/none/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> { return im_px(px, vec2<f32>(0.0, 0.0)) * px.color.a; }\n", params: [0, 0, 0, 0], live: false } },
        "image/duotone/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn im_px(px: Pixel, off: vec2<f32>) -> vec4<f32> { return textureSampleLevel(target_a, target_sampler, px.uv + off / max(px.size, vec2<f32>(1.0, 1.0)), 0.0); }\nfn im_luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }\nfn im_hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let c = im_px(px, vec2<f32>(0.0, 0.0));\n  let l = smoothstep(0.1, 0.9, im_luma(c.rgb / max(c.a, 0.001)));\n  let cloth = vec3<f32>(0.90, 0.83, 0.70);\n  let weave = 0.93 + 0.07 * sin(px.local.x * 1.9) * sin(px.local.y * 1.9);\n  let col = mix(px.color.rgb * 1.1, cloth, l) * weave;\n  return vec4<f32>(col * c.a, c.a) * px.color.a;\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "offset", columns: 12, asymmetry: 0.2, ornament: "rule", align: "start", imageTreatment: "duotone", sectionGap: 56, gutter: 20 }
    motion: { signature: "hand-dye", stiffness: 200, damping: 14, stagger: 140, enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 14, scale: 1.04, rotate: 0 }, { at: 0.1, opacity: 0.039, offsetX: 0, offsetY: 13.46, scale: 1.038, rotate: 0 }, { at: 0.2, opacity: 0.192, offsetX: 0, offsetY: 11.307, scale: 1.032, rotate: 0 }, { at: 0.3, opacity: 0.443, offsetX: 0, offsetY: 7.793, scale: 1.022, rotate: 0 }, { at: 0.4, opacity: 0.652, offsetX: 0, offsetY: 4.867, scale: 1.014, rotate: 0 }, { at: 0.5, opacity: 0.791, offsetX: 0, offsetY: 2.922, scale: 1.008, rotate: 0 }, { at: 0.6, opacity: 0.882, offsetX: 0, offsetY: 1.655, scale: 1.005, rotate: 0 }, { at: 0.7, opacity: 0.94, offsetX: 0, offsetY: 0.838, scale: 1.002, rotate: 0 }, { at: 0.8, opacity: 0.976, offsetX: 0, offsetY: 0.34, scale: 1.001, rotate: 0 }, { at: 0.9, opacity: 0.994, offsetX: 0, offsetY: 0.078, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/storefront/"
  }
}
