app std-rasm-system-olympic-signal [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-olympic-signal — the Olympic Signal design system for a Rasm page, anchored on Otl Aicher's Munich 1972 Olympics design system (https://en.wikipedia.org/wiki/Otl_Aicher). Colour: #E8F1F2 ground, #1B2F3A ink, #38A169 accent. Type: Archivo Narrow over Overpass Mono. Grid: pictogram 45/90 degree grid. Motion: the signal easing (cubic-bezier 0.15,0.00,0.05,1.00); entrance: numbers count up on their grid cells. Interaction: colour band slides under the stat. Imagery: pictograms on 45/90 degree grid. Voice: neutral, operational, uptime numbers. Components: buttons are colour band tabs; cards are stat tiles with a band. Data: stat bands and uptime bars. Sound: stopwatch tick on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "olympic-signal"
    palette: {background: "#E8F1F2", foreground: "#1B2F3A", card: "#F5F9F9", "card-foreground": "#1B2F3A", surface: "#E2EBEC", muted: "#D8E1E3", "muted-foreground": "#4A5A62", border: "#6B7B81", input: "#62727A", primary: "#38A169", "primary-hover": "#52B880", "primary-foreground": "#0C1A21", secondary: "#F5F9F9", "secondary-foreground": "#1B2F3A", "secondary-hover": "#CFDADC", accent: "#38A169", "accent-foreground": "#0C1A21", ring: "#1B2F3A", "series-1": "#38A169", "series-2": "#2B6E54", "series-3": "#87C5A7", "series-4": "#596971", "series-5": "#5C9074"}
    fonts: { display: { family: "Archivo Narrow", file: "https://almadar-kflow-assets.web.app/fonts/archivonarrow/ArchivoNarrow%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Overpass Mono", file: "https://almadar-kflow-assets.web.app/fonts/overpassmono/OverpassMono%5Bwght%5D.ttf", generic: "monospace" }, mono: { family: "Overpass Mono", file: "https://almadar-kflow-assets.web.app/fonts/overpassmono/OverpassMono%5Bwght%5D.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let gl = px.local - vec2<f32>(0.0, px.scroll * 40.0);\n  let gx = abs(fract(gl.x / 32.0) - 0.5) * 32.0;\n  let gy = abs(fract(gl.y / 32.0) - 0.5) * 32.0;\n  let line = max(1.0 - smoothstep(0.0, 0.9, 16.0 - gx), 1.0 - smoothstep(0.0, 0.9, 16.0 - gy));\n  let col = px.color.rgb - vec3<f32>(line * 0.035);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 8 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 8 } },
        "stack/hero/idle": { corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "primary-foreground", font: "500 15px mono", spring: { stiffness: 500, damping: 46 }, shadow: { color: "foreground", blur: 0, offsetX: 0, offsetY: 4 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "primary-foreground", font: "500 15px mono", spring: { stiffness: 500, damping: 46 }, shadow: { color: "foreground", blur: 0, offsetX: 0, offsetY: 8 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "primary-foreground", font: "500 15px mono", spring: { stiffness: 600, damping: 50 }, shadow: { color: "foreground", blur: 0, offsetX: 0, offsetY: 0 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "primary-foreground", font: "500 15px mono", spring: { stiffness: 500, damping: 46 }, shadow: { color: "foreground", blur: 0, offsetX: 0, offsetY: 4 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "secondary-foreground", font: "500 15px mono", spring: { stiffness: 500, damping: 46 }, shadow: { color: "series-2", blur: 0, offsetX: 0, offsetY: 4 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "secondary-foreground", font: "500 15px mono", spring: { stiffness: 500, damping: 46 }, shadow: { color: "series-2", blur: 0, offsetX: 0, offsetY: 8 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "secondary-foreground", font: "500 15px mono", spring: { stiffness: 600, damping: 50 }, shadow: { color: "series-2", blur: 0, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "secondary-foreground", font: "500 15px mono", spring: { stiffness: 500, damping: 46 }, shadow: { color: "series-2", blur: 0, offsetX: 0, offsetY: 4 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "muted-foreground", font: "500 15px mono" },
        "text/display/idle": { textColor: "foreground", font: "700 104px display" },
        "text/poster/idle": { textColor: "foreground", font: "700 150px display" },
        "text/title/idle": { textColor: "foreground", font: "700 46px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "500 13px mono" },
        "text/body/idle": { textColor: "foreground", font: "400 15px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 24px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "foreground", font: "700 196px display" },
        "text/label/idle": { textColor: "foreground", font: "500 13px mono" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px mono" },
        "text/inverse/idle": { textColor: "background", font: "500 14px mono", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 8 }, spring: { stiffness: 500, damping: 46 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 14 }, spring: { stiffness: 500, damping: 46 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 8 }, spring: { stiffness: 500, damping: 46 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 2 }, spring: { stiffness: 600, damping: 50 } },
        "card/header/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "500 13px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "card/media/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 20], kind: "bevel" }, shadow: { color: "primary", blur: 0, offsetX: 0, offsetY: 8 } },
        "panel/header/idle": { fill: "foreground", textColor: "background", font: "500 13px mono", corners: { radius: [0, 0, 0, 0], kind: "round" }, on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 8 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "morph/default/idle": { fill: "primary" },
        "ornament/signature/idle": { fill: "primary", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet bandA = sg_fill(abs(p.y - c.y) - 5.0);\nlet d = abs(fract((p.x + p.y) / 24.0) - 0.5) * 24.0;\nlet diag = sg_fill(d - 2.0) * step(c.y - 16.0, p.y) * step(p.y, c.y + 16.0);\nreturn sg_out(px, px.color.rgb, max(bandA, diag * 0.7));\n}\n", params: [0, 0, 0, 0], live: false } },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "400 15px mono", spring: { stiffness: 500, damping: 46 } },
        "textfield/default/hovered": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "400 15px mono", spring: { stiffness: 500, damping: 46 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "400 15px mono", spring: { stiffness: 500, damping: 46 } }
      }
    systemBreakpointLooks: { phone: { "text/display/idle": { textColor: "foreground", font: "700 52px display" }, "text/poster/idle": { textColor: "foreground", font: "700 68px display" }, "text/title/idle": { textColor: "foreground", font: "700 30px display" }, "text/numeral/idle": { textColor: "foreground", font: "700 96px display" } }, tablet: { "text/display/idle": { textColor: "foreground", font: "700 76px display" }, "text/poster/idle": { textColor: "foreground", font: "700 108px display" }, "text/numeral/idle": { textColor: "foreground", font: "700 140px display" } } }
    layout: { hero: "split", columns: 8, asymmetry: 0, ornament: "double-rule", align: "start", imageTreatment: "duotone", sectionGap: 72, gutter: 16 }
    motion: { signature: "signal", stiffness: 500, damping: 46, stagger: 70, enterMs: 480, keyframes: [{ at: 0, opacity: 0, offsetX: -24, offsetY: 24, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.207, offsetX: -19.04, offsetY: 19.04, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.5, offsetX: -12, offsetY: 12, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.676, offsetX: -7.78, offsetY: 7.78, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.79, offsetX: -5.034, offsetY: 5.034, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.869, offsetX: -3.151, offsetY: 3.151, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.923, offsetX: -1.847, offsetY: 1.847, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.96, offsetX: -0.962, offsetY: 0.962, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.983, offsetX: -0.399, offsetY: 0.399, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.996, offsetX: -0.094, offsetY: 0.094, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/status/"
  }
}
