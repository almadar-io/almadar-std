app std-rasm-system-harbour-ledger [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-harbour-ledger — the Harbour Ledger design system for a Rasm page, anchored on Lloyd's of London marine policies and Admiralty harbour charts (https://en.wikipedia.org/wiki/Lloyd%27s_of_London). Colour: #E9EEF0 ground, #0C2D48 ink, #C8102E accent. Type: Old Standard TT over Libre Franklin. Grid: chart grid with compass rose and soundings. Motion: the tide easing (cubic-bezier 0.45,0.00,0.55,1.00); entrance: sections wash in like a tide line. Interaction: card rises like a buoy. Imagery: chart soundings and rhumb lines. Voice: steady, reassuring, plain facts. Components: buttons are signal flags; cards are policy slips with a wax seal. Data: tide-line area charts. Sound: ship bell on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "harbour-ledger"
    palette: {background: "#E9EEF0", foreground: "#0C2D48", card: "#F5F7F8", "card-foreground": "#0C2D48", surface: "#E2E8EB", muted: "#D7DFE3", "muted-foreground": "#46606F", border: "#6F8190", input: "#6F8190", primary: "#C8102E", "primary-hover": "#AA0E27", "primary-foreground": "#E9EEF0", secondary: "#F5F7F8", "secondary-foreground": "#0C2D48", "secondary-hover": "#CED7DC", accent: "#C8102E", "accent-foreground": "#E9EEF0", ring: "#C8102E", "series-1": "#C8102E", "series-2": "#731D3A", "series-3": "#D77485", "series-4": "#4E677A", "series-5": "#A44857"}
    fonts: { display: { family: "Old Standard TT", file: "https://almadar-kflow-assets.web.app/fonts/oldstandardtt/OldStandard-Regular.ttf", generic: "serif" }, body: { family: "Libre Franklin", file: "https://almadar-kflow-assets.web.app/fonts/librefranklin/LibreFranklin%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let gl = px.local - vec2<f32>(0.0, px.scroll * 30.0);\n  let gx = abs(fract(gl.x / 64.0) - 0.5);\n  let gy = abs(fract(gl.y / 64.0) - 0.5);\n  let grid = max(1.0 - smoothstep(0.0, 0.012, 0.5 - gx), 1.0 - smoothstep(0.0, 0.012, 0.5 - gy));\n  let d1 = abs(fract((gl.x + gl.y) / 192.0) - 0.5);\n  let rhumb = 1.0 - smoothstep(0.0, 0.006, 0.5 - d1);\n  let q = fract(gl / 64.0) - vec2<f32>(0.5, 0.5);\n  let seed = floor(gl / 64.0);\n  let h = fract(sin(dot(seed, vec2<f32>(127.1, 311.7))) * 43758.5453);\n  let sound = select(0.0, 1.0 - smoothstep(0.9, 1.7, length(q * 64.0)), h > 0.82);\n  let navy = vec3<f32>(0.047, 0.176, 0.282);\n  let a = max(max(grid * 0.07, rhumb * 0.05), sound * 0.12);\n  return vec4<f32>(mix(px.color.rgb, navy, a), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/sheet/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 30, offsetX: 0, offsetY: 14 } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 14, offsetX: 0, offsetY: 4 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 14, offsetX: 0, offsetY: 4 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 14 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 14 }, shadow: { color: "rgba(12,45,72,0.18)", blur: 10, offsetX: 0, offsetY: 6 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 300, damping: 30 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 14 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "secondary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 14 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "secondary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 14 }, shadow: { color: "rgba(12,45,72,0.18)", blur: 10, offsetX: 0, offsetY: 6 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "secondary-foreground", font: "600 15px body", spring: { stiffness: 300, damping: 30 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "secondary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 14 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "border", strokeWidth: 1.5, corners: { radius: [4, 16, 16, 4], kind: "notch" }, textColor: "muted-foreground", font: "600 15px body" },
        "text/display/idle": { textColor: "foreground", font: "700 80px display" },
        "text/title/idle": { textColor: "foreground", font: "700 42px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 12px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 25px display" },
        "text/numeral/idle": { textColor: "foreground", font: "700 96px display" },
        "text/label/idle": { textColor: "foreground", font: "600 13px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px body" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "600 13px body", on: "section/band/idle" },
                "icon/accent/idle": { on: "surface/ground/idle", textColor: "accent" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 14, offsetX: 0, offsetY: 4 }, spring: { stiffness: 90, damping: 14 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 36, offsetX: 0, offsetY: 22 }, spring: { stiffness: 90, damping: 14 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 14, offsetX: 0, offsetY: 4 }, spring: { stiffness: 90, damping: 14 } },
        "card/surface/pressed": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 6, offsetX: 0, offsetY: 1 }, spring: { stiffness: 300, damping: 30 } },
        "card/header/idle": { fill: "muted", corners: { radius: [2, 2, 0, 0], kind: "bevel" }, textColor: "foreground", font: "600 12px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, shadow: { color: "rgba(12,45,72,0.18)", blur: 14, offsetX: 0, offsetY: 4 } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [2, 2, 0, 0], kind: "bevel" }, textColor: "foreground", font: "600 12px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 1 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "material/flag/idle": { fill: "primary", corners: { radius: [0, 0, 14, 14], kind: "notch" }, shadow: { color: "rgba(200,16,46,0.30)", blur: 10, offsetX: 0, offsetY: 4 } },
        "material/initials/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "material/stamp/idle": { stroke: "primary", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, textColor: "foreground", font: "500 15px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, textColor: "foreground", font: "500 15px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [2, 2, 2, 2], kind: "bevel" }, textColor: "foreground", font: "500 15px body" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.2, ornament: "double-rule", align: "start", imageTreatment: "engraving", sectionGap: 88, gutter: 24 }
    motion: { signature: "tide", stiffness: 90, damping: 22, stagger: 140, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 44, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.018, offsetX: 0, offsetY: 43.227, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.075, offsetX: 0, offsetY: 40.709, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.177, offsetX: 0, offsetY: 36.205, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.324, offsetX: 0, offsetY: 29.753, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 22, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.676, offsetX: 0, offsetY: 14.247, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.823, offsetX: 0, offsetY: 7.795, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.925, offsetX: 0, offsetY: 3.291, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.982, offsetX: 0, offsetY: 0.773, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/insurance-claims/"
  }
}
