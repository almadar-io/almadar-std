app std-rasm-system-photocopy-zine [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-photocopy-zine — the Photocopy Zine design system for a Rasm page, anchored on 1990s riot grrrl photocopied zines (Bikini Kill zine) (https://en.wikipedia.org/wiki/Riot_grrrl). Colour: #EDEDE8 ground, #141414 ink, #FF2E88 accent. Type: Special Elite over Courier Prime. Grid: free pasteboard grid with 8px snap. Motion: the paste-slap easing (cubic-bezier 0.20,1.40,0.50,1.00); entrance: scraps drop and land with a slight rotation. Interaction: scrap lifts and casts a toner shadow. Imagery: high-contrast photocopy halftone. Voice: DIY, loud lower-case, personal 'I'. Components: buttons are taped labels; cards are torn-edge paper scraps. Data: hand-counted tally marks. Sound: photocopier whirr on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "photocopy-zine"
    palette: {background: "#EDEDE8", foreground: "#141414", card: "#F7F7F5", "card-foreground": "#141414", surface: "#E6E6E2", muted: "#DCDCD7", "muted-foreground": "#595958", border: "#767674", input: "#6B6B69", primary: "#FF2E88", "primary-hover": "#FF5BA3", "primary-foreground": "#141414", secondary: "#F7F7F5", "secondary-foreground": "#141414", "secondary-hover": "#D3D3CF", accent: "#FF2E88", "accent-foreground": "#141414", ring: "#E0126F", "series-1": "#FF2E88", "series-2": "#952254", "series-3": "#F784B3", "series-4": "#555554", "series-5": "#BF5784"}
    fonts: { display: { family: "Special Elite", file: "https://almadar-kflow-assets.web.app/fonts/specialelite/SpecialElite-Regular.ttf", generic: "serif" }, body: { family: "Courier Prime", file: "https://almadar-kflow-assets.web.app/fonts/courierprime/CourierPrime-Regular.ttf", generic: "monospace" }, mono: { family: "Courier Prime", file: "https://almadar-kflow-assets.web.app/fonts/courierprime/CourierPrime-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn zn_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); } fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let edge = smoothstep(0.0, 0.06, px.uv.x) * smoothstep(1.0, 0.94, px.uv.x); var d = (1.0 - edge) * 0.08; d = d + step(0.9955, zn_h(floor(p / 1.5))) * 0.16; d = d + step(0.5, zn_h(vec2<f32>(floor(p.x / 3.0), 0.0))) * 0.012; let e = min(min(p.x, px.size.x - p.x), min(p.y, px.size.y - p.y)); d = d + (1.0 - smoothstep(0.5, 1.3, abs(e - 16.0))) * step(0.5, fract((p.x + p.y) / 18.0)) * 0.12; let tp = p - vec2<f32>(px.size.x * 0.1, 80.0); let tq = vec2<f32>(tp.x * cos(-0.35) - tp.y * sin(-0.35), tp.x * sin(-0.35) + tp.y * cos(-0.35)); let tape = step(abs(tq.x), 70.0) * step(abs(tq.y), 18.0); let c = mix(px.color.rgb + vec3<f32>(s * d), vec3<f32>(0.95, 0.88, 0.5), tape * 0.14); return vec4<f32>(c, px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet hx = min(s.x * 0.22, 60.0);\nlet qa = sg_rot(p - vec2<f32>(s.x * 0.3, c.y * 0.8), 0.14);\nlet da = max(abs(qa.y) - 11.0, abs(qa.x) - hx + abs(fract(qa.y / 5.0) - 0.5) * 4.0);\nlet qb = sg_rot(p - vec2<f32>(s.x * 0.7, c.y * 1.2), -0.12);\nlet db = max(abs(qb.y) - 11.0, abs(qb.x) - hx + abs(fract(qb.y / 5.0) - 0.5) * 4.0);\nlet ta = sg_fill(da) * 0.8;\nlet tb = sg_fill(db) * 0.85;\nlet col = mix(px.color.rgb * (0.9 + 0.1 * step(0.5, fract(qa.x / 6.0))), vec3<f32>(0.98, 0.86, 0.45), tb);\nreturn sg_out(px, col, max(ta, tb));\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [9, 3, 11, 4], kind: "notch" }, shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 380, damping: 18 } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, strokeDash: [14, 5], corners: { radius: [4, 10, 4, 12], kind: "notch" } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 3, corners: { radius: [12, 0, 12, 0], kind: "notch" } },
        "stack/coupon/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, strokeDash: [12, 8], corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/clipping/idle": { fill: "card", corners: { radius: [9, 3, 11, 4], kind: "notch" }, shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 4, offsetY: 6 }, spring: { stiffness: 380, damping: 18 } },
        "stack/bar/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "ornament/stripes/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2, strokeDash: [4, 6], corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "accent", textColor: "accent-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 6, offsetY: 7 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/primary/pressed": { fill: "foreground", textColor: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 480, damping: 22 } },
        "pressable/primary/focused": { fill: "accent", textColor: "accent-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/secondary/hovered": { fill: "muted", textColor: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/secondary/pressed": { fill: "surface", textColor: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 480, damping: 22 } },
        "pressable/secondary/focused": { fill: "background", textColor: "foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 380, damping: 18 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 0, 2, 0], kind: "notch" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 3 }, font: "400 21px display", shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 380, damping: 18 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [9, 3, 11, 4], kind: "notch" }, shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 380, damping: 18 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [9, 3, 11, 4], kind: "notch" }, shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 7, offsetY: 9 }, spring: { stiffness: 380, damping: 18 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [9, 3, 11, 4], kind: "notch" }, shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 380, damping: 18 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [9, 3, 11, 4], kind: "notch" }, shadow: { color: "rgba(20,20,20,0.42)", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 480, damping: 22 } },
        "card/header/idle": { fill: "foreground", corners: { radius: [9, 3, 0, 0], kind: "notch" }, textColor: "background", font: "400 18px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [3, 5] },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 10, 4, 12], kind: "notch" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 10, 0, 0], kind: "notch" }, textColor: "background", font: "400 18px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2, strokeDash: [3, 5] },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3, strokeDash: [3, 7] },
        "focus/ring/outer": { stroke: "accent", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "foreground", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "background", font: "400 30px display", on: "section/band/idle" },
        "text/card/idle": { textColor: "card-foreground", font: "400 28px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "400 96px display" },
        "text/title/idle": { textColor: "foreground", font: "400 44px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 14px mono" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/label/idle": { textColor: "foreground", font: "400 15px body" }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.4, ornament: "stamp", align: "start", imageTreatment: "halftone", sectionGap: 72, gutter: 24 }
    motion: { signature: "paste-slap", stiffness: 380, damping: 18, stagger: 90, enterMs: 760, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -40, scale: 1.06, rotate: -4 }, { at: 0.1, opacity: 0.527, offsetX: 0, offsetY: -18.911, scale: 1.028, rotate: -1.891 }, { at: 0.2, opacity: 0.814, offsetX: 0, offsetY: -7.436, scale: 1.011, rotate: -0.744 }, { at: 0.3, opacity: 0.963, offsetX: 0, offsetY: -1.497, scale: 1.002, rotate: -0.15 }, { at: 0.4, opacity: 1, offsetX: 0, offsetY: 1.216, scale: 0.998, rotate: 0.122 }, { at: 0.5, opacity: 1, offsetX: 0, offsetY: 2.08, scale: 0.997, rotate: 0.208 }, { at: 0.6, opacity: 1, offsetX: 0, offsetY: 1.95, scale: 0.997, rotate: 0.195 }, { at: 0.7, opacity: 1, offsetX: 0, offsetY: 1.373, scale: 0.998, rotate: 0.137 }, { at: 0.8, opacity: 1, offsetX: 0, offsetY: 0.709, scale: 0.999, rotate: 0.071 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0.197, scale: 1, rotate: 0.02 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/cms/"
  }
}
