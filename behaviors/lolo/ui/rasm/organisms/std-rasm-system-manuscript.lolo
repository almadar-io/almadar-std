app std-rasm-system-manuscript [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-manuscript — the Manuscript design system for a Rasm page, anchored on Book of Kells and Gothic textura manuscripts (https://en.wikipedia.org/wiki/Book_of_Kells). Colour: #EFE3C2 ground, #2A1A0E ink, #9B1C1C accent. Type: UnifrakturMaguntia over EB Garamond. Grid: Van de Graaf canon manuscript page grid. Motion: the quill easing (cubic-bezier 0.70,0.10,0.30,0.90); entrance: illuminated initial first, then text bleeds in. Interaction: gold leaf glints on the hovered initial. Imagery: illuminated initials and vellum texture. Voice: archival, solemn, old register. Components: buttons are rubricated red labels; cards are folios with margins. Data: marginal tick counts. Sound: vellum page whisper on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "manuscript"
    palette: {background: "#EFE3C2", foreground: "#2A1A0E", card: "#F8F2E4", "card-foreground": "#2A1A0E", surface: "#E9DDBD", muted: "#DFD3B4", "muted-foreground": "#695A48", border: "#968971", input: "#8D7F68", primary: "#9B1C1C", "primary-hover": "#841818", "primary-foreground": "#EFE3C2", secondary: "#F8F2E4", "secondary-foreground": "#2A1A0E", "secondary-hover": "#D7CBAC", accent: "#9B1C1C", "accent-foreground": "#EFE3C2", ring: "#9B1C1C", "series-1": "#9B1C1C", "series-2": "#681B16", "series-3": "#C17667", "series-4": "#655644", "series-5": "#8D4E4E"}
    fonts: { display: { family: "UnifrakturMaguntia", file: "https://almadar-kflow-assets.web.app/fonts/unifrakturmaguntia/UnifrakturMaguntia-Book.ttf", generic: "serif" }, body: { family: "EB Garamond", file: "https://almadar-kflow-assets.web.app/fonts/ebgaramond/EBGaramond%5Bwght%5D.ttf", generic: "serif" } }
    looks: {
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [12, 12, 12, 12], kind: "notch" }, shadow: { color: "rgba(20,8,6,0.3)", blur: 30, offsetY: 12 }, spring: { stiffness: 90, damping: 18 } },
        "card/surface/hovered": { fill: "card", stroke: "accent", strokeWidth: 2, corners: { radius: [12, 12, 12, 12], kind: "notch" }, shadow: { color: "rgba(20,8,6,0.4)", blur: 40, offsetY: 18 }, spring: { stiffness: 90, damping: 18 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "notch" }, shadow: { color: "rgba(20,8,6,0.3)", blur: 30, offsetY: 12 }, spring: { stiffness: 90, damping: 18 } },
        "card/surface/pressed": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [12, 12, 12, 12], kind: "notch" }, shadow: { color: "rgba(20,8,6,0.2)", blur: 10, offsetY: 3 }, spring: { stiffness: 120, damping: 20 } },
        "card/header/idle": { fill: "primary", corners: { radius: [10, 10, 0, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "accent", strokeWidth: 1.5 },
        "card/media/idle": { fill: "muted", corners: { radius: [10, 10, 0, 0], kind: "notch" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "notch" } },
        "panel/header/idle": { fill: "primary", stroke: "border", strokeWidth: 2, corners: { radius: [10, 10, 0, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body" },
        "panel/divider/idle": { stroke: "accent", strokeWidth: 1.5 },
        "section/band/idle": { fill: "#2a1410" },
        "section/rule/idle": { stroke: "accent", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "#f5e9cf", font: "400 24px display", on: "section/band/idle" },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", spring: { stiffness: 90, damping: 18 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "notch" }, textColor: "foreground", font: "500 15px body" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/hovered": { fill: "card", stroke: "accent", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 17px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "machine/event/lit": { textColor: "accent", font: "600 13px mono" },
        "orbit/label/active": { textColor: "accent", font: "700 18px body" },
        "text/numeral/idle": { textColor: "accent", font: "700 200px display" },
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let lum = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114));\n  let ink = select(vec3<f32>(0.62, 0.20, 0.16), vec3<f32>(0.28, 0.08, 0.06), lum > 0.5);\n  let W = 96.0;\n  let H = W * 1.5;\n  let u = fract(px.local.x / W);\n  let v = (fract(px.local.y / H)) * 1.5;\n  let c1 = abs(length(vec2<f32>(u - 1.0, v)) - 1.0);\n  let c2 = abs(length(vec2<f32>(u, v)) - 1.0);\n  let arch = 1.0 - smoothstep(0.0, 0.025, min(c1, c2));\n  let c3 = abs(length(vec2<f32>(u - 1.0, v)) - 0.62);\n  let c4 = abs(length(vec2<f32>(u, v)) - 0.62);\n  let inner = 1.0 - smoothstep(0.0, 0.02, min(c3, c4));\n  let mull = 1.0 - smoothstep(0.0, 0.015, abs(u - 0.5));\n  let mu = mull * step(v, 0.55) * 0.7;\n  let rose = 1.0 - smoothstep(0.0, 0.02, abs(length(vec2<f32>(u - 0.5, v - 1.08)) - 0.16));\n  let top = smoothstep(0.0, 0.6, px.uv.y) * (1.0 - px.uv.y * 0.3);\n  let fade = smoothstep(0.55, 0.0, abs(px.uv.x - 0.5) * 0.6) * 0.5 + 0.5;\n  let flick = 0.9 + 0.1 * sin(px.time * 0.7 + px.uv.x * 4.0);\n  let a = (arch * 0.08 + inner * 0.05 + mu * 0.05 + rose * 0.04) * fade * flick * (0.5 + top);\n  let vig = smoothstep(1.2, 0.3, length(px.uv - vec2<f32>(0.5, 0.45)));\n  var col = mix(px.color.rgb, ink, clamp(a, 0.0, 0.3));\n  col = mix(col * 0.82, col, vig);\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "notch" }, shadow: { color: "rgba(20,8,6,0.32)", blur: 32, offsetY: 12 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "notch" }, shadow: { color: "rgba(20,8,6,0.24)", blur: 36, offsetY: 14 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "accent", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "notch" }, font: "600 15px body", spring: { stiffness: 90, damping: 18 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "ring", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "notch" }, font: "600 15px body", shadow: { color: "rgba(0,0,0,0.45)", blur: 16 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "accent", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "notch" }, font: "600 15px body" },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", stroke: "border", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "notch" }, font: "500 15px body" },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "accent", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "notch" }, font: "500 15px body" },
        "text/display/idle": { textColor: "foreground", font: "400 84px display" },
        "text/title/idle": { textColor: "foreground", font: "400 40px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "600 13px body" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "text/card/idle": { textColor: "card-foreground", font: "400 22px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 1.5 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_goth(q: vec2<f32>, hw: f32, ys: f32) -> f32 { return select(abs(q.x - hw), abs(length(q - vec2<f32>(-hw, ys)) - 2.0 * hw), q.y < ys); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet hw = min(c.x * 0.8, s.y * 0.4);\nlet ys = 4.0 + 1.732 * hw;\nlet q = vec2<f32>(abs(p.x - c.x), p.y);\nlet inside = step(q.y, s.y - 4.0);\nlet arches = max(sg_line(sg_goth(q, hw, ys), 1.2), sg_line(sg_goth(q, hw * 0.72, ys), 0.7)) * inside;\nlet tref = max(sg_line(length(vec2<f32>(q.x, q.y - (ys - hw * 0.55))) - hw * 0.22, 0.8), sg_fill(length(vec2<f32>(q.x, q.y - (ys + hw * 0.5))) - 2.0));\nreturn sg_out(px, px.color.rgb, max(arches, tref));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "centered", columns: 8, asymmetry: 0, ornament: "frame", align: "center", imageTreatment: "duotone", sectionGap: 128, gutter: 56 }
    motion: { signature: "quill", stiffness: 90, damping: 18, stagger: 140, enterMs: 444, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 22, scale: 1.04, rotate: 0 }, { at: 0.1, opacity: 0.021, offsetX: 0, offsetY: 21.54, scale: 1.039, rotate: 0 }, { at: 0.2, opacity: 0.06, offsetX: 0, offsetY: 20.69, scale: 1.038, rotate: 0 }, { at: 0.3, opacity: 0.128, offsetX: 0, offsetY: 19.191, scale: 1.035, rotate: 0 }, { at: 0.4, opacity: 0.254, offsetX: 0, offsetY: 16.409, scale: 1.03, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 11, scale: 1.02, rotate: 0 }, { at: 0.6, opacity: 0.746, offsetX: 0, offsetY: 5.591, scale: 1.01, rotate: 0 }, { at: 0.7, opacity: 0.872, offsetX: 0, offsetY: 2.809, scale: 1.005, rotate: 0 }, { at: 0.8, opacity: 0.94, offsetX: 0, offsetY: 1.31, scale: 1.002, rotate: 0 }, { at: 0.9, opacity: 0.979, offsetX: 0, offsetY: 0.46, scale: 1.001, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/document/"
  }
}
