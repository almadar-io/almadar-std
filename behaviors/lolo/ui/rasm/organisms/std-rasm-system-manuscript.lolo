app std-rasm-system-manuscript [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-manuscript — the Manuscript design system for a Rasm page, anchored on Book of Kells and Gothic textura manuscripts (https://en.wikipedia.org/wiki/Book_of_Kells). Colour: #EFE3C2 ground, #2A1A0E ink, #9B1C1C accent. Type: UnifrakturMaguntia over EB Garamond. Grid: Van de Graaf canon manuscript page grid. Motion: the quill easing (cubic-bezier 0.70,0.10,0.30,0.90); entrance: illuminated initial first, then text bleeds in. Interaction: gold leaf glints on the hovered initial. Imagery: illuminated initials and vellum texture. Voice: archival, solemn, old register. Components: buttons are rubricated red labels; cards are folios with margins. Data: marginal tick counts. Sound: vellum page whisper on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "manuscript"
    palette: { background: "#EFE3C2", foreground: "#2A1A0E", card: "#F8F2E4", "card-foreground": "#2A1A0E", surface: "#E9DDBD", muted: "#DFD3B4", "muted-foreground": "#5C4D3B", border: "#7D705A", input: "#756850", primary: "#9B1C1C", "primary-hover": "#841818", "primary-foreground": "#F8F2E4", secondary: "#F8F2E4", "secondary-foreground": "#2A1A0E", "secondary-hover": "#D7CBAC", accent: "#9B1C1C", "accent-foreground": "#F8F2E4", ring: "#9B1C1C", "series-1": "#9B1C1C", "series-2": "#2A1A0E", "series-3": "#8A6A12", "series-4": "#4F6B52", "series-5": "#6B5B45" }
    fonts: { display: { family: "UnifrakturMaguntia", file: "https://almadar-kflow-assets.web.app/fonts/unifrakturmaguntia/UnifrakturMaguntia-Book.ttf", generic: "serif" }, body: { family: "EB Garamond", file: "https://almadar-kflow-assets.web.app/fonts/ebgaramond/EBGaramond%5Bwght%5D.ttf", generic: "serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn mh(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn vn(p: vec2<f32>) -> f32 {\n  let i = floor(p); let f = fract(p); let u = f * f * (3.0 - 2.0 * f);\n  return mix(mix(mh(i), mh(i + vec2<f32>(1.0, 0.0)), u.x), mix(mh(i + vec2<f32>(0.0, 1.0)), mh(i + vec2<f32>(1.0, 1.0)), u.x), u.y);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 90.0;\n  let n = vn(p) * 0.55 + vn(p * 2.3) * 0.3 + vn(p * 5.1) * 0.15;\n  let stain = smoothstep(0.35, 0.8, n);\n  let m = 56.0;\n  let edge = 1.0 - smoothstep(0.0, 0.6, abs(px.local.x - m) - 0.4);\n  let col = mix(px.color.rgb, px.color.rgb * vec3<f32>(0.93, 0.88, 0.78), stain * 0.45);\n  return vec4<f32>(mix(col, vec3<f32>(0.45, 0.35, 0.22), (edge * 0.22)), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 14 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 10 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 18px body", spring: { stiffness: 70, damping: 18 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "#8A6A12", strokeWidth: 2, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 18px body", spring: { stiffness: 70, damping: 18 }, shadow: { color: "rgba(201,160,48,0.85)", blur: 16 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 18px body", spring: { stiffness: 70, damping: 18 } },
        "pressable/primary/focused": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "primary-foreground", font: "600 18px body", spring: { stiffness: 70, damping: 18 } },
        "pressable/secondary/idle": { fill: "background", stroke: "primary", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 70, damping: 18 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "#8A6A12", strokeWidth: 2, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 70, damping: 18 }, shadow: { color: "rgba(201,160,48,0.85)", blur: 16 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 70, damping: 18 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "foreground", font: "500 18px body", spring: { stiffness: 70, damping: 18 } },
        "pressable/secondary/disabled": { fill: "background", stroke: "input", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, textColor: "muted-foreground", font: "500 18px body", spring: { stiffness: 70, damping: 18 } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 18px body", spring: { stiffness: 70, damping: 18 } },
        "textfield/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 18px body", spring: { stiffness: 70, damping: 18 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "border", strokeWidth: 1, gap: 3 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 18px body", spring: { stiffness: 70, damping: 18 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 18px body" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 14 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "engraved-border", spring: { stiffness: 70, damping: 18 } },
        "card/surface/hovered": { fill: "card", stroke: "#8A6A12", strokeWidth: 2, inset: { stroke: "border", strokeWidth: 1, gap: 14 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "engraved-border", spring: { stiffness: 70, damping: 18 }, shadow: { color: "rgba(201,160,48,0.85)", blur: 16 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, inset: { stroke: "border", strokeWidth: 1, gap: 14 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "engraved-border", spring: { stiffness: 70, damping: 18 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 14 }, corners: { radius: [0, 0, 0, 0], kind: "round" }, decor: "engraved-border", spring: { stiffness: 70, damping: 18 } },
        "card/header/idle": { fill: "primary", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 17px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 1, gap: 10 }, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "600 17px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "400 92px display" },
        "text/numeral/idle": { textColor: "primary", font: "400 132px display" },
        "text/title/idle": { textColor: "foreground", font: "400 44px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 16px body" },
        "text/body/idle": { textColor: "foreground", font: "400 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 26px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "background", font: "600 18px body", on: "section/band/idle" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "machine/event/lit": { textColor: "accent", font: "600 13px mono" },
        "orbit/label/active": { textColor: "accent", font: "700 18px body" },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 1 },
        "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "ornament/frame/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = px.size; let p = px.local;\n  let o = min(sg_line(p.x - 1.0, 1.0), 1.0) + sg_line(p.x - s.x + 1.0, 1.0) + sg_line(p.y - 1.0, 1.0) + sg_line(p.y - s.y + 1.0, 1.0);\n  let i = sg_line(p.x - 7.0, 0.5) + sg_line(p.x - s.x + 7.0, 0.5) + sg_line(p.y - 7.0, 0.5) + sg_line(p.y - s.y + 7.0, 0.5);\n  let inside = step(7.0, p.x) * step(p.x, s.x - 7.0) * step(7.0, p.y) * step(p.y, s.y - 7.0);\n  return sg_out(px, px.color.rgb, clamp(o + i * inside, 0.0, 1.0));\n}\n", params: [0, 0, 0, 0], live: false } },
        "ornament/signature/idle": { fill: "primary", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = px.size; let c = s * 0.5;\n  let d = abs(px.local.x - c.x) + abs(px.local.y - c.y) * 2.4;\n  let dia = 1.0 - smoothstep(5.0, 6.5, d);\n  let rule = sg_line(px.local.y - c.y, 0.5) * step(14.0, abs(px.local.x - c.x));\n  let fade = 1.0 - smoothstep(0.3, 0.5, abs(px.uv.x - 0.5));\n  return sg_out(px, px.color.rgb, max(dia, rule * fade));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "editorial", columns: 9, asymmetry: 0.22, ornament: "frame", align: "start", imageTreatment: "grain", sectionGap: 144, gutter: 36 }
    motion: { signature: "quill", stiffness: 70, damping: 18, stagger: 220, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 8, scale: 1.05, rotate: 0 }, { at: 0.1, opacity: 0.021, offsetX: 0, offsetY: 7.833, scale: 1.049, rotate: 0 }, { at: 0.2, opacity: 0.06, offsetX: 0, offsetY: 7.524, scale: 1.047, rotate: 0 }, { at: 0.3, opacity: 0.128, offsetX: 0, offsetY: 6.979, scale: 1.044, rotate: 0 }, { at: 0.4, opacity: 0.254, offsetX: 0, offsetY: 5.967, scale: 1.037, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 4, scale: 1.025, rotate: 0 }, { at: 0.6, opacity: 0.746, offsetX: 0, offsetY: 2.033, scale: 1.013, rotate: 0 }, { at: 0.7, opacity: 0.872, offsetX: 0, offsetY: 1.021, scale: 1.006, rotate: 0 }, { at: 0.8, opacity: 0.94, offsetX: 0, offsetY: 0.476, scale: 1.003, rotate: 0 }, { at: 0.9, opacity: 0.979, offsetX: 0, offsetY: 0.167, scale: 1.001, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/document/"
  }
}
