      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      CtaCard.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait CtaText = TextAtom.traits.RasmText {
    config {
      id: "ctaText"
      text: "cta.text"
      intent: "body"
      z: 3
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      CtaCard.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait FootBrand = TextAtom.traits.RasmText {
    config {
      id: "footBrand"
      text: "brand"
      intent: "eyebrow"
      z: 3
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Footer.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait FootNote = TextAtom.traits.RasmText {
    config {
      id: "footNote"
      text: "footer.note"
      intent: "body"
      z: 3
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Footer.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait BarCta = PressAtom.traits.RasmPressable {
    config {
      id: "barCta"
      label: "bar.cta"
      intent: "primary"
      action: LANDING_BAR_PRESSED
      link: @config.barLink
      href: @config.barHref
      order: 1
      z: 4
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Theme.RASM_THEME -> RASM_THEME
      Bar.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait HeroPrimary = PressAtom.traits.RasmPressable {
    config {
      id: "heroPrimary"
      label: "hero.primary"
      intent: "primary"
      action: LANDING_PRIMARY_PRESSED
      link: @config.primaryLink
      href: @config.primaryHref
      order: 2
      z: 4
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Theme.RASM_THEME -> RASM_THEME
      HeroBtns.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait HeroSecondary = PressAtom.traits.RasmPressable {
    config {
      id: "heroSecondary"
      label: "hero.secondary"
      intent: "secondary"
      action: LANDING_SECONDARY_PRESSED
      link: @config.secondaryLink
      href: @config.secondaryHref
      order: 3
      z: 4
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Theme.RASM_THEME -> RASM_THEME
      HeroBtns.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait CtaBtn = PressAtom.traits.RasmPressable {
    config {
      id: "ctaBtn"
      label: "cta.label"
      intent: "primary"
      action: LANDING_CTA_PRESSED
      link: @config.ctaLink
      href: @config.ctaHref
      order: 4
      z: 4
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Theme.RASM_THEME -> RASM_THEME
      CtaCard.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait Emblem = MorphAtom.traits.RasmMorph {
    config {
      id: "emblem"
      z: 2
      box: 100
      focus: 0.45
      stops: @config.emblemStops
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Hero.RASM_PLACE -> RASM_PLACE
      Page.RASM_PLACE -> RASM_PLACE
      Surface.RASM_RESIZE -> RASM_RESIZE
    }
  }

  trait HeroLift = ScrubAtom.traits.RasmScrub {
    config {
      id: "heroLift"
      anchor: "hero"
      paints: ["eyebrow", "display", "lede", "heroPrimary", "heroSecondary"]
      enter: 0
      exit: 0
      keyframes: [{ at: 0, opacity: 1, offsetY: 0 }, { at: 0.35, opacity: 1, offsetY: 0 }, { at: 1, opacity: 0, offsetY: -80 }]
    }
    listens {
      Page.RASM_PLACE -> RASM_PLACE
      Surface.RASM_RESIZE -> RASM_RESIZE
    }
  }

  trait StoryArrive = ScrubAtom.traits.RasmScrub {
    config {
      id: "storyArrive"
      anchor: "story"
      paints: ["storyTitle", "storyText"]
      enter: 1
      exit: 0
      keyframes: [{ at: 0, opacity: 0, offsetY: 60, scale: 0.96 }, { at: 0.4, opacity: 1, offsetY: 0, scale: 1 }, { at: 0.8, opacity: 1, offsetY: 0 }, { at: 1, opacity: 0.25, offsetY: -30 }]
    }
    listens {
      Page.RASM_PLACE -> RASM_PLACE
      Surface.RASM_RESIZE -> RASM_RESIZE
    }
  }

  trait Enter = PresenceAtom.traits.RasmPresence {
    config {
      order: ["bar", "barBrand", "barCta", "eyebrow", "display", "lede", "heroPrimary", "heroSecondary"]
      staggerMs: 60
      onView: [{ anchor: "pillars", order: ["pillarsTitle", "p1", "p1Title", "p1Body", "p2", "p2Title", "p2Body", "p3", "p3Title", "p3Body"] }, { anchor: "rows", order: ["rowsTitle", "rowsLede"] }, { anchor: "cta", order: ["ctaCard", "ctaTitle", "ctaText", "ctaBtn"] }]
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Surface.RASM_PAGE_SCROLLED -> RASM_PAGE_SCROLLED
      Surface.RASM_RESIZE -> RASM_RESIZE
      Page.RASM_PLACE -> RASM_PLACE
    }
  }

  config {
    preset : string = "hearth"
      @label "Theme"
      @description "The std-rasm-theme preset the page wears, one of its family presets for a landing."
      @tier "presentation"
    sections : [RasmChild] = [{ id: "bar", size: "fixed", main: 72 }, { id: "hero", size: "fixed", main: 640 }, { id: "pillars", size: "fixed", main: 520 }, { id: "rows", size: "fixed", main: 720 }, { id: "story", size: "fixed", main: 560 }, { id: "cta", size: "fixed", main: 440 }, { id: "footer", size: "fixed", main: 120 }]
      @label "Sections"
      @description "The page from the top, as the root stack's children: bar first, then any of hero, pillars, rows, story, cta and footer in the order and heights wanted; a section left out is never placed or painted."
      @tier "presentation"
    emblemStops : [RasmMorphStop] = [{ anchor: "hero", d: "M50 6 L94 50 L50 94 L6 50 Z" }, { anchor: "pillars", d: "M50 4 L61 39 L96 39 L68 61 L79 96 L50 74 L21 96 L32 61 L4 39 L39 39 Z" }, { anchor: "rows", d: "M10 10 L90 10 L90 90 L10 90 Z" }, { anchor: "story", d: "M50 4 C76 4 96 24 96 50 C96 76 76 96 50 96 C24 96 4 76 4 50 C4 24 24 4 50 4 Z" }, { anchor: "cta", d: "M50 6 L94 50 L50 94 L6 50 Z" }]
      @label "Emblem stops"
      @description "The emblem's outline per section, in page order, each an SVG path in a 100-unit square with one subpath; the emblem blends between them as the page scrolls."
      @tier "presentation"
    barLink : boolean = false
      @label "Bar action is a link"
      @description "On, the bar's action navigates to barHref."
      @tier "presentation"
    barHref : string = "/"
      @label "Bar action address"
      @description "Where the bar's action navigates."
      @tier "presentation"
    primaryLink : boolean = false
      @label "Primary action is a link"
      @description "On, the primary action navigates to primaryHref."
      @tier "presentation"
    primaryHref : string = "/"
      @label "Primary action address"
      @description "Where the primary action navigates."
      @tier "presentation"
    secondaryLink : boolean = false
      @label "Secondary action is a link"
      @description "On, the secondary action navigates to secondaryHref."
      @tier "presentation"
    secondaryHref : string = "/"
      @label "Secondary action address"
      @description "Where the secondary action navigates."
      @tier "presentation"
    ctaLink : boolean = false
      @label "Call to action is a link"
      @description "On, the call to action navigates to ctaHref."
      @tier "presentation"
    ctaHref : string = "/"
      @label "Call to action address"
      @description "Where the call to action navigates."
      @tier "presentation"
  }

  page "/landing" as RasmLandingPage -> Theme, Surface, Focus, Page, Bar, Hero, HeroBody, HeroBtns, Pillars, PillarsBody, PillarRow, P1, P2, P3, Rows, RowsBody, Story, StoryBody, Cta, CtaBody, CtaCard, Footer, BarBrand, Eyebrow, Display, Lede, PillarsTitle, P1Title, P1Body, P2Title, P2Body, P3Title, P3Body, RowsTitle, RowsLede, StoryTitle, StoryText, CtaTitle, CtaText, FootBrand, FootNote, BarCta, HeroPrimary, HeroSecondary, CtaBtn, Emblem, HeroLift, StoryArrive, Enter
}
