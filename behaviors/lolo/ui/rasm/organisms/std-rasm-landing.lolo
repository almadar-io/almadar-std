app std-rasm-landing [
  version: "0.1.0",
  description: "std-rasm-landing — a one-page landing on one Rasm canvas that scrolls inside itself (std-rasm-surface pageScroll): a fixed top bar with the brand and a call to action, then sections in the order the `sections` knob lists them, each placed only when listed: hero (eyebrow, display headline, lede, two calls to action), pillars (three cards), rows (a title, a lede and the `rowsSlot` region a composing program fills with its own rows), story, a call-to-action card and a footer. An emblem (std-rasm-morph) stays beside the content and changes shape as each section reaches it; the hero lifts away and the story arrives as the page scrolls (std-rasm-scrub), and the pillars, rows and call to action enter as the reader reaches them (std-rasm-presence onView). Every word is a message key a composing program overrides, the look is a std-rasm-theme preset (`preset`), and a press leaves as LANDING_BAR_PRESSED, LANDING_PRIMARY_PRESSED, LANDING_SECONDARY_PRESSED or LANDING_CTA_PRESSED, navigating as well when its link knob is on.",
  locales: [en, ar, sl]
]

type RasmChild = { id : string!, size : "fixed" | "fill" | "measure"!, main : number, cross : number, min : number }
type RasmMorphStop = { anchor : string!, d : string! }

uses ThemeAtom from "std/behaviors/std-rasm-theme"
uses SurfaceAtom from "std/behaviors/std-rasm-surface"
uses StackAtom from "std/behaviors/std-rasm-stack"
uses TextAtom from "std/behaviors/std-rasm-text"
uses PressAtom from "std/behaviors/std-rasm-pressable"
uses FocusAtom from "std/behaviors/std-rasm-focus"
uses PresenceAtom from "std/behaviors/std-rasm-presence"
uses ScrubAtom from "std/behaviors/std-rasm-scrub"
uses MorphAtom from "std/behaviors/std-rasm-morph"

orbital RasmLanding {
  entity RasmLandingView [runtime] {
    id : string!
  }

  trait Theme = ThemeAtom.traits.RasmTheme {
    config {
      preset: @config.preset
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
    }
  }

  trait Surface = SurfaceAtom.traits.RasmSurface {
    config {
      id: "rasm"
      width: 1280
      height: 800
      rootChild: "page"
      rootRect: { x: 0, y: 0, w: 1280, h: 800 }
      fill: true
      pageScroll: true
      fixed: ["bar", "barBrand", "barCta", "emblem"]
      scrollReportMs: 120
      margin: 0
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_RESIZE -> RASM_RESIZE
      Page.RASM_EXTENT -> RASM_EXTENT
      Page.RASM_PAINT -> RASM_PAINT
      Bar.RASM_PAINT -> RASM_PAINT
      Hero.RASM_PAINT -> RASM_PAINT
      HeroBody.RASM_PAINT -> RASM_PAINT
      HeroBtns.RASM_PAINT -> RASM_PAINT
      Pillars.RASM_PAINT -> RASM_PAINT
      PillarsBody.RASM_PAINT -> RASM_PAINT
      PillarRow.RASM_PAINT -> RASM_PAINT
      P1.RASM_PAINT -> RASM_PAINT
      P2.RASM_PAINT -> RASM_PAINT
      P3.RASM_PAINT -> RASM_PAINT
      Rows.RASM_PAINT -> RASM_PAINT
      RowsBody.RASM_PAINT -> RASM_PAINT
      Story.RASM_PAINT -> RASM_PAINT
      StoryBody.RASM_PAINT -> RASM_PAINT
      Cta.RASM_PAINT -> RASM_PAINT
      CtaBody.RASM_PAINT -> RASM_PAINT
      CtaCard.RASM_PAINT -> RASM_PAINT
      Footer.RASM_PAINT -> RASM_PAINT
      BarBrand.RASM_PAINT -> RASM_PAINT
      Eyebrow.RASM_PAINT -> RASM_PAINT
      Display.RASM_PAINT -> RASM_PAINT
      Lede.RASM_PAINT -> RASM_PAINT
      PillarsTitle.RASM_PAINT -> RASM_PAINT
      P1Title.RASM_PAINT -> RASM_PAINT
      P1Body.RASM_PAINT -> RASM_PAINT
      P2Title.RASM_PAINT -> RASM_PAINT
      P2Body.RASM_PAINT -> RASM_PAINT
      P3Title.RASM_PAINT -> RASM_PAINT
      P3Body.RASM_PAINT -> RASM_PAINT
      RowsTitle.RASM_PAINT -> RASM_PAINT
      RowsLede.RASM_PAINT -> RASM_PAINT
      StoryTitle.RASM_PAINT -> RASM_PAINT
      StoryText.RASM_PAINT -> RASM_PAINT
      CtaTitle.RASM_PAINT -> RASM_PAINT
      CtaText.RASM_PAINT -> RASM_PAINT
      FootBrand.RASM_PAINT -> RASM_PAINT
      FootNote.RASM_PAINT -> RASM_PAINT
      BarCta.RASM_PAINT -> RASM_PAINT
      HeroPrimary.RASM_PAINT -> RASM_PAINT
      HeroSecondary.RASM_PAINT -> RASM_PAINT
      CtaBtn.RASM_PAINT -> RASM_PAINT
      Emblem.RASM_PAINT -> RASM_PAINT
      HeroLift.RASM_SCRUB -> RASM_SCRUB
      StoryArrive.RASM_SCRUB -> RASM_SCRUB
    }
  }

  trait Focus = FocusAtom.traits.RasmFocus {
