app std-rasm-system-supermarket-signs [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-supermarket-signs — the Supermarket Signs design system for a Rasm page, anchored on Supermarket price cards and Figma Config 2024 vibrant brand (https://config.figma.com). Colour: #FFFFFF ground, #1A1A1A ink, #FF3B30 accent. Type: Bowlby One SC over Rubik. Grid: stacked full-width bands with ticker rows. Motion: the ticker easing (cubic-bezier 0.00,0.00,0.58,1.00); entrance: bands scroll in like price tickers. Interaction: price tag swings. Imagery: cut-out product photos on flat colour. Voice: cheap and cheerful, prices, offers. Components: buttons are price-tag shapes; cards are shelf talkers. Data: big price numbers. Sound: scanner beep on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "supermarket-signs"
    palette: {background: "#FFFFFF", foreground: "#1A1A1A", card: "#FFFFFF", "card-foreground": "#1A1A1A", surface: "#F8F8F8", muted: "#EDEDED", "muted-foreground": "#636363", border: "#989898", input: "#8D8D8D", primary: "#FF3B30", "primary-hover": "#D93229", "primary-foreground": "#1A1A1A", secondary: "#FFFFFF", "secondary-foreground": "#1A1A1A", "secondary-hover": "#E4E4E4", accent: "#FF3B30", "accent-foreground": "#1A1A1A", ring: "#FF3B30", "series-1": "#FF3B30", "series-2": "#982C26", "series-3": "#FF938D", "series-4": "#5F5F5F", "series-5": "#BF5D58"}
    fonts: { display: { family: "Bowlby One SC", file: "https://almadar-kflow-assets.web.app/fonts/bowlbyonesc/BowlbyOneSC-Regular.ttf", generic: "sans-serif" }, body: { family: "Rubik", file: "https://almadar-kflow-assets.web.app/fonts/rubik/Rubik%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" } },
        "stack/panel/idle": { fill: "card", corners: { radius: [32, 32, 32, 32], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/ruler/idle": { fill: "background", corners: { radius: [32, 32, 32, 32], kind: "round" } },
        "material/sun/idle": { fill: "series-5", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.local - px.size * 0.5; let r = length(p); let m = min(px.size.x, px.size.y) * 0.5 - 1.0; let disc = 1.0 - smoothstep(m - 1.0, m, r); let ring = smoothstep(m - 4.0, m - 3.0, r); let col = mix(px.color.rgb, vec3<f32>(0.086, 0.075, 0.059), ring); return vec4<f32>(col, disc * px.color.a); }", params: [0, 0, 0, 0], live: false } },
        "stack/sgp/idle": { fill: "series-1", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/dub/idle": { fill: "series-2", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/aus/idle": { fill: "series-3", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/close/idle": { fill: "series-4", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/surface/idle": { fill: "card", corners: { radius: [28, 28, 28, 28], kind: "round" }, spring: { stiffness: 320, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, spring: { stiffness: 320, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [28, 28, 28, 28], kind: "round" } },
        "card/surface/pressed": { fill: "muted", corners: { radius: [28, 28, 28, 28], kind: "round" } },
        "card/header/idle": { fill: "muted", corners: { radius: [28, 28, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px body" },
        "card/divider/idle": { stroke: "muted", strokeWidth: 2 },
        "card/media/idle": { fill: "muted", corners: { radius: [18, 18, 18, 18], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", corners: { radius: [32, 32, 32, 32], kind: "round" } },
        "panel/header/idle": { fill: "muted", corners: { radius: [32, 32, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px body" },
        "panel/divider/idle": { stroke: "muted", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "#FFFFFF", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "#16130F", strokeWidth: 4 },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", spring: { stiffness: 380, damping: 26 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", spring: { stiffness: 380, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", spring: { stiffness: 460, damping: 30 } },
        "pressable/primary/focused": { stroke: "#FFFFFF", strokeWidth: 4 },
        "pressable/secondary/idle": { stroke: "foreground", strokeWidth: 3, textColor: "foreground", corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", spring: { stiffness: 380, damping: 26 } },
        "pressable/secondary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 3, textColor: "background", corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", spring: { stiffness: 380, damping: 26 } },
        "pressable/secondary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 3, textColor: "background", corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body" },
        "pressable/secondary/focused": { stroke: "foreground", strokeWidth: 4 },
        "pressable/secondary/disabled": { stroke: "muted-foreground" },
        "text/display/idle": { textColor: "foreground", font: "800 84px display" },
        "text/title/idle": { textColor: "foreground", font: "800 56px display" },
        "text/title/inverse": { textColor: "#FFFFFF", font: "800 56px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 15px body" },
        "text/eyebrow/inverse": { textColor: "#FFFFFF", font: "700 15px body" },
        "text/body/idle": { textColor: "foreground", font: "500 19px body" },
        "text/body/inverse": { textColor: "#FFFFFF", font: "500 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "800 22px display" },
        "text/label/idle": { textColor: "foreground", font: "700 15px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 14px body" },
        "text/inverse/idle": { textColor: "background", font: "700 15px body", on: "section/band/idle" },
        "text/numeral/idle": { textColor: "#16130F", font: "800 220px display" },
        "text/numeral/inverse": { textColor: "#FFFFFF", font: "800 220px display" },
        "balloon/body/idle": { fill: "card", corners: { radius: [26, 26, 26, 26], kind: "round" } },
        "balloon/shout/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [26, 26, 26, 26], kind: "round" } },
        "window/frame/idle": { fill: "background", corners: { radius: [32, 32, 32, 32], kind: "round" } },
        "window/titlebar/idle": { fill: "background", corners: { radius: [32, 32, 0, 0], kind: "round" }, textColor: "muted-foreground", font: "700 13px body" },
        "window/control/idle": { fill: "foreground", corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "image/none/idle": { corners: { radius: [24, 24, 24, 24], kind: "round" } },
        "morph/default/idle": { stroke: "foreground", strokeWidth: 3 },
        "ornament/signature/idle": { fill: "series-5", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let c = px.size * 0.5; let p = px.local - c; let r = length(p); let m = min(px.size.x, px.size.y) * 0.5; let disc = 1.0 - smoothstep(m * 0.42 - 1.0, m * 0.42 + 1.0, r); let a = atan2(p.y, p.x); let ray = step(0.5, fract(a * 12.0 / 6.2831853)) * (1.0 - smoothstep(m * 0.96 - 1.0, m * 0.96 + 1.0, r)) * smoothstep(m * 0.54 - 1.0, m * 0.54 + 1.0, r); return vec4<f32>(px.color.rgb, max(disc, ray) * px.color.a); }", params: [0, 0, 0, 0], live: false } },
        "pulse/default/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "700 13px body" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [16, 16, 16, 16], kind: "round" }, textColor: "foreground", font: "500 17px body" }
      }
    systemBreakpointLooks: { phone: { "text/label/idle": { textColor: "foreground", font: "700 13px body" }, "text/caption/idle": { textColor: "muted-foreground", font: "500 13px body" }, "text/numeral/idle": { textColor: "#16130F", font: "800 112px display" }, "text/numeral/inverse": { textColor: "#FFFFFF", font: "800 112px display" }, "text/display/idle": { textColor: "foreground", font: "800 46px display" }, "text/title/idle": { textColor: "foreground", font: "800 36px display" }, "text/title/inverse": { textColor: "#FFFFFF", font: "800 36px display" } }, tablet: { "text/numeral/idle": { textColor: "#16130F", font: "800 160px display" }, "text/numeral/inverse": { textColor: "#FFFFFF", font: "800 160px display" }, "text/display/idle": { textColor: "foreground", font: "800 64px display" } } }
    layout: { hero: "split", columns: 12, asymmetry: 0.1, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 0, gutter: 40 }
    motion: { signature: "ticker", stiffness: 300, damping: 26, stagger: 90, enterMs: 1478, keyframes: [{ at: 0, opacity: 0, offsetX: 32, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.161, offsetX: 26.862, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.308, offsetX: 22.132, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.445, offsetX: 17.754, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.571, offsetX: 13.732, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.685, offsetX: 10.091, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.785, offsetX: 6.876, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.87, offsetX: 4.146, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.938, offsetX: 1.993, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.983, offsetX: 0.545, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/retail-store/"
  }
}
