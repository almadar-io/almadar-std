app std-rasm-system-typeform-flow [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-typeform-flow — the Typeform Flow design system for a Rasm page, anchored on Typeform's conversational form design (https://www.typeform.com). Colour: #FAF6F0 ground, #262627 ink, #0445AF accent. Type: Bitter over Nunito Sans. Grid: one centred question grid, one thing at a time. Motion: the question easing (cubic-bezier 0.33,0.00,0.00,1.00); entrance: each question slides up as the last leaves. Interaction: option shows a keyboard letter key. Imagery: none: type only. Voice: conversational, one question at a time. Components: buttons are lettered options (A, B, C); cards are question screens. Data: single progress line. Sound: soft pop on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "typeform-flow"
    palette: {background: "#FAF6F0", foreground: "#262627", card: "#FDFBF8", "card-foreground": "#262627", surface: "#F4F0EA", muted: "#E9E5E0", "muted-foreground": "#6A6967", border: "#9B9896", input: "#908E8C", primary: "#0445AF", "primary-hover": "#033B95", "primary-foreground": "#FAF6F0", secondary: "#FDFBF8", "secondary-foreground": "#262627", "secondary-hover": "#E1DDD8", accent: "#0445AF", "accent-foreground": "#FAF6F0", ring: "#0445AF", "series-1": "#0445AF", "series-2": "#133772", "series-3": "#7395CC", "series-4": "#666463", "series-5": "#426297"}
    fonts: { display: { family: "Bitter", file: "https://almadar-kflow-assets.web.app/fonts/bitter/Bitter%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Nunito Sans", file: "https://almadar-kflow-assets.web.app/fonts/nunitosans/NunitoSans%5BYTLC%2Copsz%2Cwdth%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0));\n  let c = vec2<f32>(0.5 + (p.x - 0.5) * 0.06, 0.32 + px.scroll * 0.12);\n  let d = length((px.uv - c) * vec2<f32>(1.0, 1.35));\n  let halo = exp(-d * d * 5.0);\n  var col = px.color.rgb + vec3<f32>(1.0, 1.0, 1.0) * halo * 0.05;\n  col = col - vec3<f32>(0.012, 0.012, 0.012) * px.uv.y;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [12, 12, 12, 12], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "pressable/primary/hovered": { fill: "primary-hover", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "pressable/secondary/idle": { fill: "background", stroke: "input", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "text/display/idle": { textColor: "foreground", font: "600 64px display" },
        "text/title/idle": { textColor: "foreground", font: "600 40px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 13px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 22px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet d = sg_fill(length(p - vec2<f32>(12.0, c.y)) - 4.0);\nlet l = sg_line(p.y - c.y, 0.5) * step(28.0, p.x);\nreturn sg_out(px, px.color.rgb, max(d, l));\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "card/surface/idle": { fill: "card", stroke: "input", strokeWidth: 0, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(24,24,27,0.09)", blur: 30, offsetX: 0, offsetY: 12 }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/hovered": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(24,24,27,0.16)", blur: 44, offsetX: 0, offsetY: 20 }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/pressed": { fill: "surface", stroke: "input", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, spring: { stiffness: 180, damping: 26 } },
        "card/header/idle": { fill: "surface", corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "foreground", font: "500 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [12, 12, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" } },
        "panel/header/idle": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "foreground", font: "500 14px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "text/inverse/idle": { textColor: "background", font: "600 22px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px body" },
        "text/label/idle": { textColor: "foreground", font: "500 13px body" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 120, damping: 24 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "pressable/secondary/disabled": { stroke: "input" },
        "toggle/check/off-idle": { stroke: "input" },
        "toggle/check/off-hovered": { stroke: "input" },
        "toggle/switch/off-idle": { stroke: "input" },
        "toggle/switch/off-hovered": { stroke: "input" }
      }
    layout: { hero: "centered", columns: 12, asymmetry: 0.0, ornament: "none", align: "center", imageTreatment: "none", sectionGap: 160, gutter: 48 }
    motion: { signature: "question", stiffness: 120, damping: 24, stagger: 110, enterMs: 1251, keyframes: [{ at: 0, opacity: 0, offsetX: -24, offsetY: 0, scale: 0.9, rotate: -1.5 }, { at: 0.1, opacity: 0.047, offsetX: -22.878, offsetY: 0, scale: 0.905, rotate: -1.43 }, { at: 0.2, opacity: 0.326, offsetX: -16.187, offsetY: 0, scale: 0.933, rotate: -1.012 }, { at: 0.3, opacity: 0.626, offsetX: -8.967, offsetY: 0, scale: 0.963, rotate: -0.56 }, { at: 0.4, opacity: 0.778, offsetX: -5.328, offsetY: 0, scale: 0.978, rotate: -0.333 }, { at: 0.5, opacity: 0.868, offsetX: -3.171, offsetY: 0, scale: 0.987, rotate: -0.198 }, { at: 0.6, opacity: 0.925, offsetX: -1.795, offsetY: 0, scale: 0.993, rotate: -0.112 }, { at: 0.7, opacity: 0.962, offsetX: -0.912, offsetY: 0, scale: 0.996, rotate: -0.057 }, { at: 0.8, opacity: 0.985, offsetX: -0.371, offsetY: 0, scale: 0.998, rotate: -0.023 }, { at: 0.9, opacity: 0.996, offsetX: -0.086, offsetY: 0, scale: 1, rotate: -0.005 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/survey/"
  }
}
