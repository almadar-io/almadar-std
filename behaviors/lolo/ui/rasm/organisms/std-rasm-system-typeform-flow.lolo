app std-rasm-system-typeform-flow [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-typeform-flow — the Typeform Flow design system for a Rasm page, anchored on Typeform's conversational form design (https://www.typeform.com). Colour: #FAF6F0 ground, #262627 ink, #0445AF accent. Type: Bitter over Nunito Sans. Grid: one centred question grid, one thing at a time. Motion: the question easing (cubic-bezier 0.33,0.00,0.00,1.00); entrance: each question slides up as the last leaves. Interaction: an option shows a keyboard letter key. Imagery: none, type only. Voice: conversational, one question at a time. Components: buttons are lettered options (A, B, C); cards are question screens. Data: a single progress line. Sound: a soft pop on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "typeform-flow"
    palette: {background: "#FAF6F0", foreground: "#262627", card: "#FFFFFF", "card-foreground": "#262627", surface: "#F2EDE6", muted: "#E7E1D8", "muted-foreground": "#5F5E5C", border: "#8C8A87", input: "#807E7B", primary: "#0445AF", "primary-hover": "#033590", "primary-foreground": "#FAF6F0", secondary: "#FFFFFF", "secondary-foreground": "#0445AF", "secondary-hover": "#E3EAF6", accent: "#0445AF", "accent-foreground": "#FAF6F0", ring: "#0445AF", "series-1": "#0445AF", "series-2": "#262627", "series-3": "#7395CC", "series-4": "#8C8A87", "series-5": "#B7C7E3"}
    fonts: { display: { family: "Bitter", file: "https://almadar-kflow-assets.web.app/fonts/bitter/Bitter%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Nunito Sans", file: "https://almadar-kflow-assets.web.app/fonts/nunitosans/NunitoSans%5BYTLC%2Copsz%2Cwdth%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(38,38,39,0.08)", blur: 24, offsetX: 0, offsetY: 6 }, spring: { stiffness: 300, damping: 22 } },
        "stack/closing/idle": { fill: "card", corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(38,38,39,0.08)", blur: 24, offsetX: 0, offsetY: 6 }, spring: { stiffness: 300, damping: 22 } },
        "stack/panel/idle": { fill: "card", corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 300, damping: 22 } },
        "stack/hero/idle": { corners: { radius: [16, 16, 16, 16], kind: "round" } },
        "stack/bar/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", font: "700 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 300, damping: 22 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", font: "700 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 300, damping: 22 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", font: "700 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 380, damping: 20 } },
        "pressable/primary/focused": { fill: "primary", stroke: "foreground", strokeWidth: 2, textColor: "primary-foreground", font: "700 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" } },
        "pressable/secondary/idle": { fill: "rgba(4,69,175,0.07)", stroke: "primary", strokeWidth: 1, textColor: "secondary-foreground", font: "600 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 300, damping: 22 } },
        "pressable/secondary/hovered": { fill: "rgba(4,69,175,0.16)", stroke: "primary", strokeWidth: 2, textColor: "secondary-foreground", font: "600 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 300, damping: 22 } },
        "pressable/secondary/pressed": { fill: "primary", stroke: "primary", strokeWidth: 2, textColor: "primary-foreground", font: "600 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 380, damping: 20 } },
        "pressable/secondary/disabled": { fill: "rgba(4,69,175,0.04)", stroke: "border", strokeWidth: 1, textColor: "muted-foreground", font: "600 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" } },
        "pressable/secondary/focused": { fill: "rgba(4,69,175,0.07)", stroke: "foreground", strokeWidth: 2, textColor: "secondary-foreground", font: "600 18px body", corners: { radius: [6, 6, 6, 6], kind: "round" } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "range/default/thumb-hovered": { stroke: "primary" },
        "range/default/thumb-idle": { stroke: "primary" },
        "card/surface/idle": { fill: "card", corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(38,38,39,0.08)", blur: 24, offsetX: 0, offsetY: 6 }, spring: { stiffness: 300, damping: 22 } },
        "card/surface/hovered": { fill: "card", corners: { radius: [16, 16, 16, 16], kind: "round" }, shadow: { color: "rgba(4,69,175,0.16)", blur: 32, offsetX: 0, offsetY: 10 }, spring: { stiffness: 300, damping: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 300, damping: 22 } },
        "card/surface/pressed": { fill: "surface", corners: { radius: [16, 16, 16, 16], kind: "round" }, spring: { stiffness: 380, damping: 20 } },
        "card/header/idle": { fill: "card", corners: { radius: [16, 16, 0, 0], kind: "round" }, textColor: "foreground", font: "700 16px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [16, 16, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", corners: { radius: [16, 16, 16, 16], kind: "round" } },
        "panel/header/idle": { fill: "card", corners: { radius: [16, 16, 0, 0], kind: "round" }, textColor: "foreground", font: "700 16px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "primary", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 4 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "foreground", font: "400 20px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "foreground", font: "400 20px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "foreground", font: "400 20px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 20px body" },
        "morph/default/idle": { fill: "accent" },
        "text/display/idle": { textColor: "foreground", font: "700 52px display" },
        "text/poster/idle": { textColor: "foreground", font: "700 64px display" },
        "text/numeral/idle": { textColor: "foreground", font: "700 56px display" },
        "text/quote/idle": { textColor: "foreground", font: "400 28px display" },
        "text/title/idle": { textColor: "foreground", font: "700 34px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 28px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "700 28px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px body" },
        "text/label/idle": { textColor: "foreground", font: "700 14px body" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet d = sg_fill(length(p - vec2<f32>(12.0, c.y)) - 4.0);\nlet l = sg_line(p.y - c.y, 0.5) * step(28.0, p.x);\nreturn sg_out(px, px.color.rgb, max(d, l));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    systemBreakpointLooks: { phone: { "text/display/idle": { textColor: "foreground", font: "700 36px display" }, "text/title/idle": { textColor: "foreground", font: "700 26px display" }, "text/card/idle": { textColor: "card-foreground", font: "700 22px display", on: "card/surface/idle" }, "text/numeral/idle": { textColor: "foreground", font: "700 40px display" } } }
    layout: { hero: "centered", columns: 1, asymmetry: 0, ornament: "none", align: "center", imageTreatment: "none", sectionGap: 96, gutter: 24 }
    motion: { signature: "question", stiffness: 300, damping: 22, stagger: 90, enterMs: 560, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 56, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.047, offsetX: 0, offsetY: 53.381, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.326, offsetX: 0, offsetY: 37.769, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.626, offsetX: 0, offsetY: 20.923, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.778, offsetX: 0, offsetY: 12.432, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.868, offsetX: 0, offsetY: 7.399, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.925, offsetX: 0, offsetY: 4.189, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.962, offsetX: 0, offsetY: 2.127, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.985, offsetX: 0, offsetY: 0.866, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.996, offsetX: 0, offsetY: 0.2, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/survey/"
  }
}
