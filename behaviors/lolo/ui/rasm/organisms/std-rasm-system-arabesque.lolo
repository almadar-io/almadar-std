app std-rasm-system-arabesque [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-arabesque — the Arabesque design system for a Rasm page, in two modes, night (the default) and day, anchored on Islamic geometric pattern: the eight-point khatam star of zellige tilework and the Alhambra's dados (https://en.wikipedia.org/wiki/Islamic_geometric_patterns). Colour: night is lapis-indigo #0E1330 with gold #E9B949 and turquoise #5FD3C6; day is sand #F4EAD5 with lapis #1F4F9A and teal #17807A. Type: Reem Kufi (a geometric Kufic) over Cairo, both drawing Arabic and Latin. Grid: a 16-column centred field, symmetric about its axis like a tiled panel. Shape: notched corners and a double gold inlay line on every card, bevelled glazed-tile buttons. Imagery: the khatam lattice ground, a star divider. Motion: khatam-unfold, a slight turn and swell into place, staggered outward. Interaction: a gold glint follows the pointer across a tile. Voice: measured, generous, plain. Sound: a soft plucked note on press."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "arabesque"
    palette: { background: "#0E1330", foreground: "#F3E8CF", card: "#161C42", "card-foreground": "#F3E8CF", surface: "#121838", muted: "#1E2550", "muted-foreground": "#C2B79C", border: "#8C6E2E", input: "#A88436", primary: "#E9B949", "primary-hover": "#F4CF72", "primary-foreground": "#10142E", secondary: "#1A2150", "secondary-foreground": "#F3E8CF", "secondary-hover": "#252D66", accent: "#5FD3C6", "accent-foreground": "#0E1330", ring: "#5FD3C6", placeholder: "#8F8670", "series-1": "#E9B949", "series-2": "#5FD3C6", "series-3": "#C8456A", "series-4": "#7F9BFF", "series-5": "#F3E8CF" }
    modes: {
      night: { palette: {}, looks: { "surface/ground/idle": { fill: "background", material: { wgsl: "// an eight-point khatam lattice: two squares crossed in every cell, small stars between, threads on the diagonals\nfn kh(q: vec2<f32>, s: f32) -> f32 {\n  let a = abs(q);\n  return min(max(a.x, a.y) - s, (a.x + a.y) * 0.70710678 - s);\n}\nfn ln(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w * 0.5, w * 1.5, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 112.0;\n  let q = fract(p) - vec2<f32>(0.5, 0.5);\n  let r = fract(p + vec2<f32>(0.5, 0.5)) - vec2<f32>(0.5, 0.5);\n  let w = 1.4 / 112.0;\n  let star = ln(kh(q, 0.21), w);\n  let core = ln(kh(q, 0.11), w * 0.7);\n  let small = ln(kh(r, 0.09), w * 0.7);\n  let thread = ln(min(abs(q.x - q.y), abs(q.x + q.y)) * 0.70710678, w * 0.6) * step(0.30, length(q)) * step(0.16, length(r));\n  var col = mix(vec3<f32>(0.055, 0.075, 0.19), vec3<f32>(0.035, 0.045, 0.13), px.uv.y);\n  col = mix(col, vec3<f32>(0.91, 0.72, 0.29), clamp((star * 0.9 + core * 0.45 + small * 0.6 + thread * 0.35) * 0.16, 0.0, 1.0));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 120, damping: 17 } } } },
      day: { palette: { background: "#F4EAD5", foreground: "#1F1A12", card: "#FBF6EA", "card-foreground": "#1F1A12", surface: "#EFE2C6", muted: "#E6D7B6", "muted-foreground": "#54472F", border: "#B8841C", input: "#9C7016", primary: "#1F4F9A", "primary-hover": "#2A5FB4", "primary-foreground": "#FBF6EA", secondary: "#FBF6EA", "secondary-foreground": "#1F1A12", "secondary-hover": "#EADBB9", accent: "#17807A", "accent-foreground": "#FBF6EA", ring: "#17807A", placeholder: "#7A6C52", "series-1": "#1F4F9A", "series-2": "#17807A", "series-3": "#B8841C", "series-4": "#C8456A", "series-5": "#1F1A12" }, looks: { "surface/ground/idle": { fill: "background", material: { wgsl: "// an eight-point khatam lattice: two squares crossed in every cell, small stars between, threads on the diagonals\nfn kh(q: vec2<f32>, s: f32) -> f32 {\n  let a = abs(q);\n  return min(max(a.x, a.y) - s, (a.x + a.y) * 0.70710678 - s);\n}\nfn ln(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w * 0.5, w * 1.5, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 112.0;\n  let q = fract(p) - vec2<f32>(0.5, 0.5);\n  let r = fract(p + vec2<f32>(0.5, 0.5)) - vec2<f32>(0.5, 0.5);\n  let w = 1.4 / 112.0;\n  let star = ln(kh(q, 0.21), w);\n  let core = ln(kh(q, 0.11), w * 0.7);\n  let small = ln(kh(r, 0.09), w * 0.7);\n  let thread = ln(min(abs(q.x - q.y), abs(q.x + q.y)) * 0.70710678, w * 0.6) * step(0.30, length(q)) * step(0.16, length(r));\n  var col = mix(vec3<f32>(0.957, 0.918, 0.835), vec3<f32>(0.925, 0.871, 0.757), px.uv.y);\n  col = mix(col, vec3<f32>(0.12, 0.31, 0.60), clamp((star * 0.9 + core * 0.45 + small * 0.6 + thread * 0.35) * 0.12, 0.0, 1.0));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 120, damping: 17 } } } }
    }
    mode: "night"
    fonts: { display: { family: "Reem Kufi", file: "https://almadar-kflow-assets.web.app/fonts/reemkufi/ReemKufi%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Cairo", file: "https://almadar-kflow-assets.web.app/fonts/cairo/Cairo%5Bslnt%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "// an eight-point khatam lattice: two squares crossed in every cell, small stars between, threads on the diagonals\nfn kh(q: vec2<f32>, s: f32) -> f32 {\n  let a = abs(q);\n  return min(max(a.x, a.y) - s, (a.x + a.y) * 0.70710678 - s);\n}\nfn ln(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w * 0.5, w * 1.5, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local / 112.0;\n  let q = fract(p) - vec2<f32>(0.5, 0.5);\n  let r = fract(p + vec2<f32>(0.5, 0.5)) - vec2<f32>(0.5, 0.5);\n  let w = 1.4 / 112.0;\n  let star = ln(kh(q, 0.21), w);\n  let core = ln(kh(q, 0.11), w * 0.7);\n  let small = ln(kh(r, 0.09), w * 0.7);\n  let thread = ln(min(abs(q.x - q.y), abs(q.x + q.y)) * 0.70710678, w * 0.6) * step(0.30, length(q)) * step(0.16, length(r));\n  var col = mix(vec3<f32>(0.055, 0.075, 0.19), vec3<f32>(0.035, 0.045, 0.13), px.uv.y);\n  col = mix(col, vec3<f32>(0.91, 0.72, 0.29), clamp((star * 0.9 + core * 0.45 + small * 0.6 + thread * 0.35) * 0.16, 0.0, 1.0));\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 120, damping: 17 } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 0.6, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" } },
        "stack/panel/idle": { fill: "surface", stroke: "border", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 0.6, gap: 5 }, corners: { radius: [14, 14, 14, 14], kind: "notch" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/accent/idle": { fill: "muted", stroke: "primary", strokeWidth: 1.6, inset: { stroke: "primary", strokeWidth: 0.8, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" }, shadow: { color: "rgba(233,185,73,0.18)", blur: 28 } },
        "pressable/primary/idle": { fill: "primary", stroke: "border", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "border", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 17 }, shadow: { color: "rgba(233,185,73,0.45)", blur: 22 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "border", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, material: { wgsl: "// a glazed zellige tile: lit from above, a gold inlay line inside its edge, a slow glint; a.x hover, a.y press, a.z focus\nfn shade(px: Pixel) -> vec4<f32> {\n  var col = px.color.rgb * (1.14 - 0.30 * px.uv.y);\n  let d = distance(px.local, px.pointer);\n  col = col + vec3<f32>(0.98, 0.82, 0.48) * exp(-d * d / 7000.0) * (0.04 + 0.16 * px.a.x);\n  let inlay = 1.0 - smoothstep(0.35, 1.1, abs(px.sdf + 4.0));\n  col = mix(col, vec3<f32>(0.72, 0.52, 0.11), inlay * (0.45 + 0.35 * px.a.x + 0.2 * px.a.z));\n  let band = (px.local.x - px.local.y * 0.6) * 0.012 - px.time * 0.35;\n  col = col + vec3<f32>(pow(max(0.0, sin(band)), 40.0) * 0.12);\n  col = col * (1.0 - 0.14 * px.a.y);\n  return vec4<f32>(col, max(px.color.a, inlay * 0.7));\n}\n", params: [0, 0, 0, 0], live: true }, textColor: "primary-foreground", font: "600 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/secondary/idle": { fill: "secondary", stroke: "primary", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 120, damping: 17 }, shadow: { color: "rgba(233,185,73,0.45)", blur: 22 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/secondary/focused": { fill: "secondary", stroke: "ring", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/secondary/disabled": { fill: "secondary", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "muted-foreground", font: "500 17px body", spring: { stiffness: 120, damping: 17 } },
        "pressable/ghost/idle": { fill: "rgba(0,0,0,0)", textColor: "foreground", font: "500 16px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 120, damping: 17 } },
        "pressable/ghost/hovered": { fill: "muted", textColor: "primary", font: "500 16px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 120, damping: 17 } },
        "pressable/ghost/pressed": { fill: "muted", textColor: "primary", font: "500 16px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 120, damping: 17 } },
        "pressable/ghost/focused": { fill: "rgba(0,0,0,0)", stroke: "ring", strokeWidth: 2.4, textColor: "foreground", font: "500 16px body", corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 120, damping: 17 } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "400 17px body", spring: { stiffness: 120, damping: 17 } },
        "textfield/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "400 17px body", spring: { stiffness: 120, damping: 17 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "400 17px body", spring: { stiffness: 120, damping: 17 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 17px body" },
        "choice/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 120, damping: 17 } },
        "choice/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.2, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 120, damping: 17 } },
        "choice/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 120, damping: 17 } },
        "choice/default/open": { fill: "card", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "bevel" }, textColor: "foreground", font: "500 15px body", spring: { stiffness: 120, damping: 17 } },
        "choice/default/label": { textColor: "foreground", font: "500 15px body", spring: { stiffness: 120, damping: 17 } },
        "choice/popup/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "notch" }, spring: { stiffness: 120, damping: 17 } },
        "choice/option/idle": { fill: "card", textColor: "foreground", font: "500 15px body", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 120, damping: 17 } },
        "choice/option/active": { fill: "primary", textColor: "primary-foreground", font: "600 15px body", corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 120, damping: 17 } },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 0.6, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" }, spring: { stiffness: 120, damping: 17 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.4, inset: { stroke: "primary", strokeWidth: 0.6, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" }, spring: { stiffness: 120, damping: 17 }, shadow: { color: "rgba(233,185,73,0.45)", blur: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2.4, inset: { stroke: "border", strokeWidth: 0.6, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" }, spring: { stiffness: 120, damping: 17 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 1.2, inset: { stroke: "border", strokeWidth: 0.6, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" }, spring: { stiffness: 120, damping: 17 } },
        "card/header/idle": { fill: "primary", corners: { radius: [14, 14, 0, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 15px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 0.8 },
        "card/media/idle": { fill: "surface", corners: { radius: [14, 14, 14, 14], kind: "notch" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "border", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 0.6, gap: 5 }, corners: { radius: [14, 14, 14, 14], kind: "notch" } },
        "panel/header/idle": { fill: "primary", corners: { radius: [14, 14, 0, 0], kind: "notch" }, textColor: "primary-foreground", font: "600 16px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 0.8 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "border", strokeWidth: 0.8 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2.4 },
        "text/display/idle": { textColor: "foreground", font: "600 72px display" },
        "text/numeral/idle": { textColor: "primary", font: "600 96px display" },
        "text/title/idle": { textColor: "foreground", font: "600 38px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "600 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 22px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "600 18px body", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/label/idle": { textColor: "muted-foreground", font: "600 13px body" },
        "text/quote/idle": { textColor: "foreground", font: "500 26px display" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "accent" },
        "image/none/idle": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [14, 14, 14, 14], kind: "notch" } },
        "machine/event/lit": { textColor: "accent", font: "600 13px body" },
        "orbit/label/active": { textColor: "primary", font: "600 16px body" },
        "grid/rule/idle": { stroke: "border", strokeWidth: 0.8 },
        "grid/border/idle": { stroke: "border", strokeWidth: 1 },
        "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "bevel" } },
        "ornament/frame/idle": { fill: "border", stroke: "border", strokeWidth: 1, inset: { stroke: "border", strokeWidth: 0.6, gap: 6 }, corners: { radius: [14, 14, 14, 14], kind: "notch" } },
        "ornament/signature/idle": { fill: "primary", material: { wgsl: "// one khatam star on a hairline, the section divider\nfn kh(q: vec2<f32>, s: f32) -> f32 {\n  let a = abs(q);\n  return min(max(a.x, a.y) - s, (a.x + a.y) * 0.70710678 - s);\n}\nfn shade(px: Pixel) -> vec4<f32> {\n  let s = px.size; let c = s * 0.5;\n  let q = (px.local - c) / s.y;\n  let star = 1.0 - smoothstep(-0.01, 0.02, kh(q, 0.22));\n  let hole = 1.0 - smoothstep(-0.01, 0.02, kh(q, 0.09));\n  let rule = (1.0 - smoothstep(0.4, 1.2, abs(px.local.y - c.y))) * step(s.y * 0.42, abs(px.local.x - c.x)) * (1.0 - smoothstep(s.x * 0.3, s.x * 0.5, abs(px.local.x - c.x)));\n  let k = max(star - hole * 0.85, rule);\n  return vec4<f32>(px.color.rgb, k * px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "centered", columns: 16, asymmetry: 0, ornament: "double-rule", align: "center", imageTreatment: "duotone", sectionGap: 64, gutter: 40 }
    motion: { signature: "khatam-unfold", stiffness: 120, damping: 17, stagger: 90, enterMs: 760, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0, scale: 0.9, rotate: -7 }, { at: 0.1, opacity: 0.12, offsetX: 0, offsetY: 0, scale: 0.918, rotate: -5.6 }, { at: 0.2, opacity: 0.3, offsetX: 0, offsetY: 0, scale: 0.94, rotate: -4.1 }, { at: 0.3, opacity: 0.5, offsetX: 0, offsetY: 0, scale: 0.962, rotate: -2.7 }, { at: 0.4, opacity: 0.68, offsetX: 0, offsetY: 0, scale: 0.98, rotate: -1.5 }, { at: 0.5, opacity: 0.82, offsetX: 0, offsetY: 0, scale: 0.994, rotate: -0.6 }, { at: 0.6, opacity: 0.91, offsetX: 0, offsetY: 0, scale: 1.006, rotate: 0.1 }, { at: 0.7, opacity: 0.96, offsetX: 0, offsetY: 0, scale: 1.01, rotate: 0.4 }, { at: 0.8, opacity: 0.99, offsetX: 0, offsetY: 0, scale: 1.006, rotate: 0.3 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0, scale: 1.002, rotate: 0.1 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.45 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/almadar-io/"
  }
