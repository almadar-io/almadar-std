app std-rasm-system-run-sheet [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-run-sheet — the Run Sheet design system for a Rasm page, anchored on the stage manager's run sheet and prompt book (https://en.wikipedia.org/wiki/Prompt_book), the cockpit checklist (https://en.wikipedia.org/wiki/Checklist) and the Braille Institute's Atkinson Hyperlegible typeface (https://www.brailleinstitute.org/freefont/), and built to WCAG 2.2 AA (https://www.w3.org/TR/WCAG22/). Colour: #F4EDDF warm paper ground, #1A1713 ink, one #B23A0A signal for the primary action and the selected or current thing, #1B6B34 check green for done, #8A5A00 hold amber for waiting on a person, #A8201A red for failed; every text pair reaches 4.5:1 and every control edge 3:1. Type: Big Shoulders Display over Atkinson Hyperlegible, IBM Plex Mono for code, body 17px or more. Grid: 10 columns, an editorial hero, a ruled section break, no texture. Motion: the tick-off easing; items settle in sequence like lines being checked off, a short run from the left, a slight overshoot, then rest. Interaction: a card or node takes the signal edge on hover; focus is a two-ring outline. Imagery: diagrams are the pictures: a flow canvas of paper nodes on a dotted ground with an accent strip per kind, a state machine of ruled pills, a stepper of checked circles, and a ruled source listing. Voice: plain, imperative, one step at a time. Components: buttons are square-cornered ink-edged blocks; cards are run-sheet cues. Data: ruled rows. Sound: none. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "run-sheet"
    palette: { background: "#F4EDDF", foreground: "#1A1713", card: "#FBF7EE", "card-foreground": "#1A1713", surface: "#EFE6D3", muted: "#E6DCC6", "muted-foreground": "#4E4639", border: "#6B6150", input: "#6B6150", primary: "#B23A0A", "primary-hover": "#8F2D06", "primary-foreground": "#FFFFFF", secondary: "#FBF7EE", "secondary-foreground": "#1A1713", "secondary-hover": "#E9DFCA", accent: "#B23A0A", "accent-foreground": "#FFFFFF", ring: "#1D4ED8", placeholder: "#5E5543", "series-1": "#B23A0A", "series-2": "#1D4ED8", "series-3": "#8A5A00", "series-4": "#1B6B34", "series-5": "#6D28D9" }
    fonts: { display: { family: "Big Shoulders Display", file: "https://almadar-kflow-assets.web.app/fonts/bigshouldersdisplay/BigShouldersDisplay%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Atkinson Hyperlegible", file: "https://almadar-kflow-assets.web.app/fonts/atkinsonhyperlegible/AtkinsonHyperlegible-Regular.ttf", generic: "sans-serif" }, mono: { family: "IBM Plex Mono", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexmono/IBMPlexMono-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 220, damping: 22 } },
        "stack/slip/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "stack/inset/idle": { fill: "muted", corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/closing/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, spring: { stiffness: 220, damping: 22 } },
        "stack/source/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.3)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.3)", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.3)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 26 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.3)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/secondary/idle": { fill: "card", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "primary", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 26 } },
        "pressable/secondary/focused": { fill: "card", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body", shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "pressable/secondary/disabled": { fill: "surface", textColor: "muted-foreground", stroke: "border", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, font: "700 18px body" },
        "text/display/idle": { textColor: "foreground", font: "700 72px display" },
        "text/title/idle": { textColor: "foreground", font: "700 40px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 17px body" },
        "text/body/idle": { textColor: "foreground", font: "400 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 26px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "primary", font: "700 120px display" },
        "text/label/idle": { textColor: "foreground", font: "700 17px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 17px body" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "700 26px display", on: "section/band/idle" },
        "text/code/idle": { textColor: "muted-foreground", font: "400 17px mono" },
        "text/code/active": { textColor: "foreground", font: "500 17px mono" },
        "icon/inverse/idle": { textColor: "primary-foreground", on: "section/band/idle" },
        "morph/default/idle": { fill: "primary" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 220, damping: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 3, offsetY: 4 }, spring: { stiffness: 220, damping: 22 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 26 } },
        "card/header/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 0, 0], kind: "round" }, textColor: "foreground", font: "700 17px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 1.5 },
        "card/media/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 17px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "panel/header/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 0, 0], kind: "round" }, textColor: "foreground", font: "700 17px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1.5 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 18px body", spring: { stiffness: 220, damping: 22 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 18px body", spring: { stiffness: 220, damping: 22 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 18px body", spring: { stiffness: 220, damping: 22 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 18px body" },
        "range/default/track": { fill: "muted", corners: { radius: [3, 3, 3, 3], kind: "round" } },
        "range/default/fill": { fill: "primary", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "foreground" },
        "range/default/thumb-hovered": { stroke: "primary" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "400 17px body" },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1.5 },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 2 },
        "overlay/scrim/idle": { fill: "rgba(26,23,19,0.62)" },
        "overlay/dialog/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.35)", blur: 0, offsetX: 6, offsetY: 8 } },
        "stepper/done/idle": { fill: "#1B6B34", textColor: "#FFFFFF", font: "700 17px body" },
        "stepper/current/idle": { fill: "primary", textColor: "primary-foreground", font: "700 17px body" },
        "stepper/todo/idle": { stroke: "foreground", textColor: "foreground", font: "700 17px body" },
        "stepper/line/idle": { stroke: "#1B6B34", strokeWidth: 3 },
        "stepper/line-todo/idle": { stroke: "border", strokeWidth: 2 },
        "stepper/label/idle": { textColor: "foreground", font: "600 17px body" },
        "machine/state/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "700 17px body" },
        "machine/state/active": { fill: "#FFE9DB", stroke: "primary", strokeWidth: 3.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "700 17px body" },
        "machine/state/visited": { fill: "#E3F2E5", stroke: "#1B6B34", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "700 17px body" },
        "machine/pill/idle": { fill: "surface", stroke: "border", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "machine/pill/hovered": { fill: "#FFE9DB", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "machine/pill/next": { fill: "card", stroke: "primary", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "machine/pill/lit": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "machine/wire/idle": { stroke: "border", strokeWidth: 2 },
        "machine/wire/next": { stroke: "primary", strokeWidth: 2.5 },
        "machine/wire/lit": { stroke: "#1B6B34", strokeWidth: 3.5 },
        "machine/event/idle": { textColor: "muted-foreground", font: "400 17px mono" },
        "machine/event/lit": { textColor: "primary-foreground", font: "700 17px mono" },
        "machine/guard/idle": { fill: "#FFF1CC", stroke: "#8A5A00", strokeWidth: 2 },
        "machine/guard/refused": { fill: "#FBE1DE", stroke: "#A8201A", strokeWidth: 3 },
        "machine/badge/idle": { fill: "foreground", stroke: "background", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "background", font: "700 17px body" },
        "machine/token/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2 },
        "machine/bloom/idle": { stroke: "primary", strokeWidth: 3 },
        "machine/effect/other": { fill: "foreground", stroke: "foreground", strokeWidth: 1.5, decor: "tick" },
        "flow/ground/idle": { fill: "surface", stroke: "foreground", strokeWidth: 2, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let q = abs(fract(px.local / 24.0) - vec2<f32>(0.5, 0.5));\n let d = length(q * 24.0);\n c = mix(c, vec3<f32>(0.42, 0.38, 0.31), (1.0 - smoothstep(0.9, 1.7, d)) * 0.55);\n return vec4<f32>(c, px.color.a);\n}", params: [], live: false } },
        "flow/node/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 2, offsetY: 3 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/node/hovered": { fill: "card", stroke: "primary", strokeWidth: 2.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 4, offsetY: 5 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/node/selected": { fill: "card", stroke: "primary", strokeWidth: 4, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(178,58,10,0.35)", blur: 0, offsetX: 4, offsetY: 5 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/node/running": { fill: "#FFE9DB", stroke: "primary", strokeWidth: 2.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 2, offsetY: 3 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/node/waiting": { fill: "#FFF1CC", stroke: "#8A5A00", strokeWidth: 2.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 2, offsetY: 3 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/node/done": { fill: "#E3F2E5", stroke: "#1B6B34", strokeWidth: 2.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 2, offsetY: 3 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/node/failed": { fill: "#FBE1DE", stroke: "#A8201A", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(26,23,19,0.18)", blur: 0, offsetX: 2, offsetY: 3 }, spring: { stiffness: 220, damping: 22 }, textColor: "foreground" },
        "flow/kind-input/idle": { fill: "#1D4ED8" },
        "flow/kind-agent/idle": { fill: "#6D28D9" },
        "flow/kind-person/idle": { fill: "#BE185D" },
        "flow/kind-module/idle": { fill: "#0F766E" },
        "flow/kind-output/idle": { fill: "#475569" },
        "flow/kind-data/idle": { fill: "#4D7C0F" },
        "flow/kind-rule/idle": { fill: "#7A4B12" },
        "flow/kind-action/idle": { fill: "#A21CAF" },
        "flow/kind-effect/idle": { fill: "#B45309" },
        "flow/kind-state/idle": { fill: "#0E7490" },
        "flow/handle/idle": { fill: "foreground", stroke: "background", strokeWidth: 2 },
        "flow/edge/idle": { stroke: "border", strokeWidth: 2 },
        "flow/edge/live": { stroke: "primary", strokeWidth: 3 },
        "flow/note/idle": { textColor: "muted-foreground" },
        "flow/mark/idle": { textColor: "foreground" },
        "flow/control/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "700 20px body" },
        "flow/control/hovered": { fill: "#FFE9DB", stroke: "primary", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, textColor: "foreground", font: "700 20px body" }
      }
    layout: { hero: "editorial", columns: 10, asymmetry: 0.18, ornament: "rule", align: "start", imageTreatment: "none", sectionGap: 72, gutter: 32 }
    motion: { signature: "tick-off", stiffness: 220, damping: 16, stagger: 110, enterMs: 680, keyframes: [{ at: 0, opacity: 0, offsetX: -32, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.62, offsetX: -15, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 1, offsetX: 2, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.55, opacity: 1, offsetX: 5, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.75, opacity: 1, offsetX: 1.5, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: {}
    soundBase: ""
  }
}
