app std-rasm-system-field-notes [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-field-notes — the Field Notes design system for a Rasm page, anchored on Field Notes memo books and architects' sketchbooks (https://fieldnotesbrand.com). Colour: #F7F3E8 ground, #2B2B2B ink, #E2725B accent. Type: Caveat over Red Hat Text. Grid: dot grid notebook 5mm. Motion: the sketch easing (cubic-bezier 0.45,0.25,0.25,1.00); entrance: the line draws itself, notes appear along it. Interaction: scribble circle draws around the item. Imagery: hand sketches and taped photos. Voice: collaborative, informal, first names. Components: buttons are scribbled boxes; cards are notebook pages. Data: hand-drawn bar sketches. Sound: pencil scribble on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "field-notes"
    palette: {background: "#F7F3E8", foreground: "#2B2B2B", card: "#FBFAF5", "card-foreground": "#2B2B2B", surface: "#F1EDE2", muted: "#E7E3D9", "muted-foreground": "#5E5D59", border: "#9B9993", input: "#85837E", primary: "#E2725B", "primary-hover": "#EA8A75", "primary-foreground": "#2B2B2B", secondary: "#FBFAF5", "secondary-foreground": "#2B2B2B", "secondary-hover": "#DFDBD1", accent: "#E2725B", "accent-foreground": "#2B2B2B", ring: "#C2492F", "series-1": "#E2725B", "series-2": "#905245", "series-3": "#EBAC9A", "series-4": "#686764", "series-5": "#B1796D"}
    fonts: { display: { family: "Caveat", file: "https://almadar-kflow-assets.web.app/fonts/caveat/Caveat%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Red Hat Text", file: "https://almadar-kflow-assets.web.app/fonts/redhattext/RedHatText%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let q = fract(px.local / 19.0) - vec2<f32>(0.5, 0.5); let d = length(q) * 19.0; let dt = 1.0 - smoothstep(0.9, 1.7, d); let ink = vec3<f32>(0.17, 0.17, 0.17); return vec4<f32>(mix(px.color.rgb, ink, dt * 0.3), px.color.a); }\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "border", strokeWidth: 1, gap: 7 }, corners: { radius: [2, 3, 2, 3], kind: "round" }, shadow: { color: "rgba(43,43,43,0.16)", blur: 8, offsetX: 2, offsetY: 4 }, spring: { stiffness: 260, damping: 30 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 3, 2, 3], kind: "round" }, shadow: { color: "rgba(43,43,43,0.16)", blur: 8, offsetX: 2, offsetY: 4 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [5, 9, 4, 8], kind: "round" }, textColor: "primary-foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 }, shadow: { color: "#2B2B2B", blur: 0, offsetX: 3, offsetY: 3 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 3.5, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "primary-foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 }, shadow: { color: "#2B2B2B", blur: 0, offsetX: 3, offsetY: 3 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 3.5, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "primary-foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 }, shadow: { color: "#2B2B2B", blur: 0, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [5, 9, 4, 8], kind: "round" }, textColor: "foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 }, shadow: { color: "#2B2B2B", blur: 0, offsetX: 2, offsetY: 2 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "foreground", strokeWidth: 3.5, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 }, shadow: { color: "#2B2B2B", blur: 0, offsetX: 2, offsetY: 2 } },
        "text/display/idle": { textColor: "foreground", font: "700 96px display" },
        "text/title/idle": { textColor: "foreground", font: "700 54px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "600 22px display" },
        "text/body/idle": { textColor: "foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 28px display", on: "card/surface/idle" },
        "morph/default/idle": { stroke: "foreground", strokeWidth: 1.5 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet h = c - vec2<f32>(6.0, 6.0);\nlet bx = sg_line(sg_box(p - c, h), 0.6);\nlet d1 = sg_line(sg_seg(p, c - h, c + h), 0.5);\nlet d2 = sg_line(sg_seg(p, vec2<f32>(c.x - h.x, c.y + h.y), vec2<f32>(c.x + h.x, c.y - h.y)), 0.5);\nreturn sg_out(px, px.color.rgb, max(bx, max(d1, d2)));\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "primary-foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 } },
        "pressable/secondary/pressed": { fill: "foreground", stroke: "foreground", strokeWidth: 3.5, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "background", font: "700 24px display", spring: { stiffness: 260, damping: 30 }, shadow: { color: "#2B2B2B", blur: 0, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 4, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "700 24px display", spring: { stiffness: 260, damping: 30 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, inset: { stroke: "border", strokeWidth: 1, gap: 7 }, corners: { radius: [2, 3, 2, 3], kind: "round" }, shadow: { color: "rgba(43,43,43,0.16)", blur: 8, offsetX: 2, offsetY: 4 }, spring: { stiffness: 260, damping: 30 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, inset: { stroke: "ring", strokeWidth: 1.5, gap: 9 }, corners: { radius: [2, 3, 2, 3], kind: "round" }, shadow: { color: "rgba(43,43,43,0.24)", blur: 14, offsetX: 3, offsetY: 7 }, spring: { stiffness: 260, damping: 30 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [2, 3, 2, 3], kind: "round" }, spring: { stiffness: 260, damping: 30 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 3, inset: { stroke: "border", strokeWidth: 1, gap: 7 }, corners: { radius: [2, 3, 2, 3], kind: "round" }, spring: { stiffness: 260, damping: 30 } },
        "card/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 3, 0, 0], kind: "round" }, textColor: "foreground", font: "700 24px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 1.5, strokeDash: [9, 4] },
        "card/media/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 3, 2, 3], kind: "round" }, shadow: { color: "rgba(43,43,43,0.2)", blur: 6, offsetX: 2, offsetY: 3 } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 3, 2, 3], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [2, 3, 0, 0], kind: "round" }, textColor: "foreground", font: "700 24px display", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 1.5, strokeDash: [9, 4] },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1.5, strokeDash: [14, 5] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "background", font: "700 26px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px body" },
        "text/label/idle": { textColor: "foreground", font: "600 20px display" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [2, 3, 2, 3], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 260, damping: 30 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [2, 3, 2, 3], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 260, damping: 30 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [2, 3, 2, 3], kind: "round" }, textColor: "foreground", font: "500 17px body", spring: { stiffness: 260, damping: 30 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "pressable/secondary/disabled": { fill: "background", stroke: "input", strokeWidth: 2, corners: { radius: [5, 9, 4, 8], kind: "round" }, textColor: "muted-foreground", font: "700 24px display" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "grid/rule/idle": { stroke: "foreground", strokeWidth: 1, strokeDash: [9, 5] },
        "image/none/idle": { stroke: "foreground", strokeWidth: 6, corners: { radius: [2, 3, 2, 3], kind: "round" }, shadow: { color: "rgba(43,43,43,0.28)", blur: 10, offsetX: 3, offsetY: 6 } }
      }
    layout: { hero: "offset", columns: 12, asymmetry: 0.2, ornament: "rule", align: "start", imageTreatment: "grain", sectionGap: 76, gutter: 38 }
    motion: { signature: "sketch", stiffness: 260, damping: 30, stagger: 140, enterMs: 1300, keyframes: [{ at: 0, opacity: 0, offsetX: -40, offsetY: 8, scale: 1, rotate: -2.5 }, { at: 0.1, opacity: 0.072, offsetX: -37.108, offsetY: 7.422, scale: 1, rotate: -2.319 }, { at: 0.2, opacity: 0.193, offsetX: -32.299, offsetY: 6.46, scale: 1, rotate: -2.019 }, { at: 0.3, opacity: 0.387, offsetX: -24.501, offsetY: 4.9, scale: 1, rotate: -1.531 }, { at: 0.4, opacity: 0.62, offsetX: -15.181, offsetY: 3.036, scale: 1, rotate: -0.949 }, { at: 0.5, opacity: 0.787, offsetX: -8.519, offsetY: 1.704, scale: 1, rotate: -0.532 }, { at: 0.6, opacity: 0.886, offsetX: -4.554, offsetY: 0.911, scale: 1, rotate: -0.285 }, { at: 0.7, opacity: 0.945, offsetX: -2.211, offsetY: 0.442, scale: 1, rotate: -0.138 }, { at: 0.8, opacity: 0.978, offsetX: -0.868, offsetY: 0.174, scale: 1, rotate: -0.054 }, { at: 0.9, opacity: 0.995, offsetX: -0.195, offsetY: 0.039, scale: 1, rotate: -0.012 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/project/"
  }
}
