app std-rasm-system-field-notes [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-field-notes — the Field Notes design system for a Rasm page, anchored on Field Notes memo books and architects' sketchbooks (https://fieldnotesbrand.com). Colour: #F7F3E8 ground, #2B2B2B ink, #E2725B accent. Type: Caveat over Red Hat Text. Grid: dot grid notebook 5mm. Motion: the sketch easing (cubic-bezier 0.45,0.25,0.25,1.00); entrance: the line draws itself, notes appear along it. Interaction: scribble circle draws around the item. Imagery: hand sketches and taped photos. Voice: collaborative, informal, first names. Components: buttons are scribbled boxes; cards are notebook pages. Data: hand-drawn bar sketches. Sound: pencil scribble on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "field-notes"
    palette: {background: "#F7F3E8", foreground: "#2B2B2B", card: "#FBFAF5", "card-foreground": "#2B2B2B", surface: "#F1EDE2", muted: "#E7E3D9", "muted-foreground": "#6C6B67", border: "#9B9993", input: "#918F8A", primary: "#E2725B", "primary-hover": "#C0614D", "primary-foreground": "#2B2B2B", secondary: "#FBFAF5", "secondary-foreground": "#2B2B2B", "secondary-hover": "#DFDBD1", accent: "#E2725B", "accent-foreground": "#2B2B2B", ring: "#E2725B", "series-1": "#E2725B", "series-2": "#905245", "series-3": "#EBAC9A", "series-4": "#686764", "series-5": "#B1796D"}
    fonts: { display: { family: "Caveat", file: "https://almadar-kflow-assets.web.app/fonts/caveat/Caveat%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Red Hat Text", file: "https://almadar-kflow-assets.web.app/fonts/redhattext/RedHatText%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.local; let gx = min(fract(p.x / 16.0), 1.0 - fract(p.x / 16.0)) * 16.0; let gy = min(fract(p.y / 16.0), 1.0 - fract(p.y / 16.0)) * 16.0; let mx = min(fract(p.x / 80.0), 1.0 - fract(p.x / 80.0)) * 80.0; let my = min(fract(p.y / 80.0), 1.0 - fract(p.y / 80.0)) * 80.0; var d = max(1.0 - smoothstep(0.3, 0.9, gx), 1.0 - smoothstep(0.3, 0.9, gy)) * 0.05; d = d + max(1.0 - smoothstep(0.3, 1.0, mx), 1.0 - smoothstep(0.3, 1.0, my)) * 0.08; d = d + ((1.0 - smoothstep(0.4, 1.0, abs(p.x - px.pointer.x))) + (1.0 - smoothstep(0.4, 1.0, abs(p.y - px.pointer.y)))) * 0.04; let blue = vec3<f32>(0.3, 0.55, 0.95); return vec4<f32>(mix(px.color.rgb, blue, clamp(d, 0.0, 0.4)), px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(0,0,0,0.14)", blur: 20, offsetX: 0, offsetY: 8 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(0,0,0,0.14)", blur: 20, offsetX: 0, offsetY: 8 } },
        "stack/hero/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(0,0,0,0.20)", blur: 14, offsetX: 0, offsetY: 6 }, textColor: "primary-foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "text/display/idle": { textColor: "foreground", font: "700 96px display" },
        "text/title/idle": { textColor: "foreground", font: "700 40px display" },
        "text/eyebrow/idle": { textColor: "foreground", font: "700 13px mono" },
        "text/body/idle": { textColor: "foreground", font: "400 16px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 20px body", on: "card/surface/idle" },
        "morph/default/idle": { stroke: "foreground", strokeWidth: 1.5 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet h = c - vec2<f32>(6.0, 6.0);\nlet bx = sg_line(sg_box(p - c, h), 0.6);\nlet d1 = sg_line(sg_seg(p, c - h, c + h), 0.5);\nlet d2 = sg_line(sg_seg(p, vec2<f32>(c.x - h.x, c.y + h.y), vec2<f32>(c.x + h.x, c.y - h.y)), 0.5);\nreturn sg_out(px, px.color.rgb, max(bx, max(d1, d2)));\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "pressable/secondary/pressed": { fill: "foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 15px mono", spring: { stiffness: 500, damping: 40 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(0,0,0,0.14)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 500, damping: 40 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(0,0,0,0.22)", blur: 28, offsetX: 0, offsetY: 14 }, spring: { stiffness: 500, damping: 40 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 500, damping: 40 } },
        "card/surface/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 500, damping: 40 } },
        "card/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 14px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "card/media/idle": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let s = px.size;\n  let n = length(s);\n  let d1 = abs(p.x * s.y - p.y * s.x) / n;\n  let d2 = abs((s.x - p.x) * s.y - p.y * s.x) / n;\n  let ln = 1.0 - smoothstep(0.6, 1.4, min(d1, d2));\n  let lum = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114));\n  let ink = select(vec3<f32>(0.0, 0.0, 0.0), vec3<f32>(1.0, 1.0, 1.0), lum < 0.5);\n  return vec4<f32>(mix(px.color.rgb, ink, ln), px.color.a);\n}", params: [0, 0, 0, 0], live: false } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 14px mono", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "background", font: "700 20px body", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px mono" },
        "text/label/idle": { textColor: "foreground", font: "700 14px mono" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 500, damping: 40 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 500, damping: 40 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 500, damping: 40 } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "pressable/secondary/disabled": { stroke: "input" },
        "toggle/check/off-idle": { stroke: "input" },
        "toggle/check/off-hovered": { stroke: "input" },
        "toggle/switch/off-idle": { stroke: "input" },
        "toggle/switch/off-hovered": { stroke: "input" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.1, ornament: "frame", align: "start", imageTreatment: "none", sectionGap: 72, gutter: 32 }
    motion: { signature: "sketch", stiffness: 500, damping: 40, stagger: 40, enterMs: 1090, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 22, scale: 1.04, rotate: 0 }, { at: 0.1, opacity: 0.072, offsetX: 0, offsetY: 20.409, scale: 1.037, rotate: 0 }, { at: 0.2, opacity: 0.193, offsetX: 0, offsetY: 17.764, scale: 1.032, rotate: 0 }, { at: 0.3, opacity: 0.387, offsetX: 0, offsetY: 13.476, scale: 1.025, rotate: 0 }, { at: 0.4, opacity: 0.62, offsetX: 0, offsetY: 8.349, scale: 1.015, rotate: 0 }, { at: 0.5, opacity: 0.787, offsetX: 0, offsetY: 4.685, scale: 1.009, rotate: 0 }, { at: 0.6, opacity: 0.886, offsetX: 0, offsetY: 2.505, scale: 1.005, rotate: 0 }, { at: 0.7, opacity: 0.945, offsetX: 0, offsetY: 1.216, scale: 1.002, rotate: 0 }, { at: 0.8, opacity: 0.978, offsetX: 0, offsetY: 0.478, scale: 1.001, rotate: 0 }, { at: 0.9, opacity: 0.995, offsetX: 0, offsetY: 0.107, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/project/"
  }
}
