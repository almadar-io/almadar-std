app std-rasm-system-solar-commons [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-solar-commons — the Solar Commons design system for a Rasm page, anchored on Solarpunk movement and Studio Ghibli's Nausicaa landscapes (https://en.wikipedia.org/wiki/Solarpunk). Colour: #F6F1DE ground, #183A2B ink, #F2A541 accent. Type: Young Serif over Lexend. Grid: organic rows of rounded plots (community garden beds). Motion: the sprout easing (cubic-bezier 0.20,0.80,0.20,1.00); entrance: content grows upward from the baseline like shoots. Interaction: leaf tint deepens and card rounds more. Imagery: sunlit illustrations, greenery. Voice: hopeful, communal, concrete impact. Components: buttons are seed-shaped pills; cards are garden beds with soft soil edge. Data: growth bars rising like plants. Sound: wind chime on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "solar-commons"
    palette: {background: "#F6F1DE", foreground: "#183A2B", card: "#FBF9F0", "card-foreground": "#183A2B", surface: "#EFECD9", muted: "#E4E2D0", "muted-foreground": "#4A6150", border: "#6C826D", input: "#62785F", primary: "#F2A541", "primary-hover": "#F7B95F", "primary-foreground": "#183A2B", secondary: "#FBF9F0", "secondary-foreground": "#183A2B", "secondary-hover": "#DBDBC9", accent: "#F2A541", "accent-foreground": "#183A2B", ring: "#2E7D4F", "series-1": "#F2A541", "series-2": "#907537", "series-3": "#F4C788", "series-4": "#5B7161", "series-5": "#B99260"}
    fonts: { display: { family: "Young Serif", file: "https://almadar-kflow-assets.web.app/fonts/youngserif/YoungSerif-Regular.ttf", generic: "serif" }, body: { family: "Lexend", file: "https://almadar-kflow-assets.web.app/fonts/lexend/Lexend%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let sun = exp(-length((px.uv - vec2<f32>(0.92, -0.04)) * vec2<f32>(1.0, 1.4)) * 2.4);\n  let col = mix(px.color.rgb, vec3<f32>(1.0, 0.86, 0.52), sun * 0.2);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [30, 30, 22, 22], kind: "round" }, inset: { stroke: "series-5", strokeWidth: 2, gap: 6 }, shadow: { color: "rgba(24,58,43,0.12)", blur: 30, offsetX: 0, offsetY: 12 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [30, 30, 22, 22], kind: "round" }, inset: { stroke: "series-5", strokeWidth: 2, gap: 6 }, shadow: { color: "rgba(24,58,43,0.12)", blur: 30, offsetX: 0, offsetY: 12 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [36, 36, 36, 36], kind: "round" } },
        "stack/bar/idle": { fill: "surface", stroke: "border", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [30, 8, 30, 8], kind: "round" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 140, damping: 15 }, shadow: { color: "rgba(24,58,43,0.2)", blur: 16, offsetX: 0, offsetY: 6 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [34, 10, 34, 10], kind: "round" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 140, damping: 15 }, shadow: { color: "rgba(24,58,43,0.28)", blur: 22, offsetX: 0, offsetY: 9 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 2, corners: { radius: [36, 12, 36, 12], kind: "round" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 180, damping: 14 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [30, 8, 30, 8], kind: "round" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 140, damping: 15 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [30, 8, 30, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 140, damping: 15 } },
        "pressable/secondary/hovered": { fill: "#DDE8C6", stroke: "foreground", strokeWidth: 2, corners: { radius: [34, 10, 34, 10], kind: "round" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 140, damping: 15 } },
        "pressable/secondary/pressed": { fill: "#CBDDAE", stroke: "foreground", strokeWidth: 2, corners: { radius: [36, 12, 36, 12], kind: "round" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 180, damping: 14 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [30, 8, 30, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 140, damping: 15 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "border", strokeWidth: 1.5, corners: { radius: [30, 8, 30, 8], kind: "round" }, textColor: "muted-foreground", font: "500 17px body" },
        "text/display/idle": { textColor: "foreground", font: "400 84px display" },
        "text/title/idle": { textColor: "foreground", font: "400 42px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 13px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 22px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "ring", font: "400 150px display" },
        "text/label/idle": { textColor: "foreground", font: "500 14px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 14px body" },
        "text/inverse/idle": { textColor: "background", font: "400 20px display", on: "section/band/idle" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [30, 30, 22, 22], kind: "round" }, inset: { stroke: "series-5", strokeWidth: 2, gap: 6 }, shadow: { color: "rgba(24,58,43,0.12)", blur: 30, offsetX: 0, offsetY: 12 }, spring: { stiffness: 140, damping: 15 } },
        "card/surface/hovered": { fill: "#E9F0D2", stroke: "ring", strokeWidth: 2.5, corners: { radius: [44, 44, 30, 30], kind: "round" }, inset: { stroke: "series-4", strokeWidth: 2, gap: 6 }, shadow: { color: "rgba(24,58,43,0.2)", blur: 34, offsetX: 0, offsetY: 14 }, spring: { stiffness: 140, damping: 15 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [30, 30, 22, 22], kind: "round" }, inset: { stroke: "series-5", strokeWidth: 2, gap: 6 }, spring: { stiffness: 140, damping: 15 } },
        "card/surface/pressed": { fill: "#DDE8C6", stroke: "ring", strokeWidth: 2.5, corners: { radius: [44, 44, 30, 30], kind: "round" }, inset: { stroke: "series-4", strokeWidth: 2, gap: 6 }, spring: { stiffness: 180, damping: 14 } },
        "card/header/idle": { fill: "surface", corners: { radius: [30, 30, 0, 0], kind: "round" }, textColor: "foreground", font: "500 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 2 },
        "card/media/idle": { fill: "series-3", corners: { radius: [30, 30, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [30, 30, 22, 22], kind: "round" }, shadow: { color: "rgba(24,58,43,0.12)", blur: 30, offsetX: 0, offsetY: 12 } },
        "panel/header/idle": { fill: "surface", stroke: "border", strokeWidth: 2.5, corners: { radius: [30, 30, 0, 0], kind: "round" }, textColor: "foreground", font: "500 14px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "border", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 4 },
        "morph/default/idle": { fill: "accent" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "400 17px body", spring: { stiffness: 140, damping: 15 } },
        "textfield/default/hovered": { fill: "#E9F0D2", stroke: "foreground", strokeWidth: 2, corners: { radius: [28, 28, 28, 28], kind: "round" }, textColor: "foreground", font: "400 17px body", spring: { stiffness: 140, damping: 15 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "400 17px body", spring: { stiffness: 140, damping: 15 } },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 17px body" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "ring", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "ring", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "ring" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" }
      }
    systemBreakpointLooks: { phone: { "text/display/idle": { textColor: "foreground", font: "400 46px display" }, "text/title/idle": { textColor: "foreground", font: "400 30px display" }, "text/numeral/idle": { textColor: "ring", font: "400 84px display" }, "text/body/idle": { textColor: "muted-foreground", font: "400 16px body" } }, tablet: { "text/display/idle": { textColor: "foreground", font: "400 62px display" }, "text/title/idle": { textColor: "foreground", font: "400 36px display" }, "text/numeral/idle": { textColor: "ring", font: "400 112px display" } } }
    layout: { hero: "collage", columns: 6, asymmetry: 0.15, ornament: "none", align: "center", imageTreatment: "grain", sectionGap: 88, gutter: 40 }
    motion: { signature: "sprout", stiffness: 140, damping: 15, stagger: 110, enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 38, scale: 0.94, rotate: 0 }, { at: 0.1, opacity: 0.397, offsetX: 0, offsetY: 22.926, scale: 0.964, rotate: 0 }, { at: 0.2, opacity: 0.682, offsetX: 0, offsetY: 12.092, scale: 0.981, rotate: 0 }, { at: 0.3, opacity: 0.828, offsetX: 0, offsetY: 6.55, scale: 0.99, rotate: 0 }, { at: 0.4, opacity: 0.903, offsetX: 0, offsetY: 3.672, scale: 0.994, rotate: 0 }, { at: 0.5, opacity: 0.946, offsetX: 0, offsetY: 2.049, scale: 0.997, rotate: 0 }, { at: 0.6, opacity: 0.971, offsetX: 0, offsetY: 1.091, scale: 0.998, rotate: 0 }, { at: 0.7, opacity: 0.986, offsetX: 0, offsetY: 0.523, scale: 0.999, rotate: 0 }, { at: 0.8, opacity: 0.995, offsetX: 0, offsetY: 0.202, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.999, offsetX: 0, offsetY: 0.044, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/donate/"
  }
}
