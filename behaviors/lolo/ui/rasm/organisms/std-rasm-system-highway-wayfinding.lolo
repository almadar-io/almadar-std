app std-rasm-system-highway-wayfinding [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-highway-wayfinding — the Highway Wayfinding design system for a Rasm page, anchored on FHWA Standard Highway Signs (Series E Modified) and the Interstate shield system (https://mutcd.fhwa.dot.gov/ser-shs_millennium.htm). Colour: #0B5E3B ground, #FFFFFF ink, #FFC72C accent. Type: Overpass over Public Sans. Grid: axial grid along one route line with exits. Motion: the merge-lane easing (cubic-bezier 0.20,0.70,0.30,1.00); entrance: signs slide in from the reading end like approaching overhead gantries. Interaction: sign plate brightens like retroreflective sheeting. Imagery: pictograms on reflective plates. Voice: imperative, terse, distance first ('Aisle 4, 30 m'). Components: buttons are sign plates with a thin inset border; cards are exit panels with arrows. Data: distance bars like exit countdown ticks. Sound: turn-signal click on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "highway-wayfinding"
    palette: {background: "#0B5E3B", foreground: "#FFFFFF", card: "#1A6847", "card-foreground": "#FFFFFF", surface: "#126341", muted: "#1F6B4B", "muted-foreground": "#B1CBC0", border: "#79A693", input: "#85AF9D", primary: "#FFC72C", "primary-hover": "#FFCF4C", "primary-foreground": "#0B5E3B", secondary: "#1A6847", "secondary-foreground": "#FFFFFF", "secondary-hover": "#287153", accent: "#FFC72C", "accent-foreground": "#0B5E3B", ring: "#FFC72C", "series-1": "#FFC72C", "series-2": "#FFE08B", "series-3": "#919833", "series-4": "#B6CFC4", "series-5": "#BFA356"}
    fonts: { display: { family: "Overpass", file: "https://almadar-kflow-assets.web.app/fonts/overpass/Overpass%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Public Sans", file: "https://almadar-kflow-assets.web.app/fonts/publicsans/PublicSans%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/plan/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/closing/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "pressable/primary/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "background", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/hovered": { fill: "foreground", stroke: "primary", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "background", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "primary", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 520, damping: 40 } },
        "pressable/primary/focused": { fill: "foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "background", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/hovered": { fill: "foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "background", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/pressed": { fill: "foreground", stroke: "primary", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "background", font: "600 16px body", spring: { stiffness: 520, damping: 40 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/disabled": { stroke: "border" },
        "text/display/idle": { textColor: "foreground", font: "800 104px display" },
        "text/title/idle": { textColor: "foreground", font: "700 56px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 13px mono" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 16px body", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "foreground", font: "800 180px display" },
        "text/label/idle": { textColor: "foreground", font: "600 13px mono" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px mono" },
        "text/inverse/idle": { textColor: "background", font: "500 14px mono", on: "section/band/idle" },
        "text/plan/idle": { textColor: "foreground", font: "600 13px mono", on: "stack/plan/idle" },
        "card/surface/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 420, damping: 34 } },
        "card/surface/hovered": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 420, damping: 34 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 420, damping: 34 } },
        "card/surface/pressed": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 520, damping: 40 } },
        "card/header/idle": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 13px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "panel/header/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [4, 4, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px mono", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "morph/default/idle": { stroke: "primary", strokeWidth: 4 },
        "morph/route/idle": { stroke: "primary", strokeWidth: 4 },
        "morph/aisle/idle": { stroke: "border", strokeWidth: 2 },
        "morph/wall/idle": { stroke: "foreground", strokeWidth: 6 },
        "pulse/default/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "600 13px mono" },
        "pulse/pin/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "600 13px mono" },
        "pulse/hot/idle": { fill: "primary", stroke: "primary", textColor: "foreground", font: "600 13px mono" },
        "pulse/route/idle": { fill: "primary", stroke: "primary", textColor: "foreground", font: "600 13px mono" },
        "pulse/link/idle": { stroke: "border", strokeWidth: 2 },
        "material/zone-furniture/idle": { fill: "series-1", stroke: "foreground", strokeWidth: 1.2 },
        "material/zone-lighting/idle": { fill: "series-2", stroke: "foreground", strokeWidth: 1.2 },
        "material/zone-kitchen/idle": { fill: "series-3", stroke: "foreground", strokeWidth: 1.2 },
        "material/zone-textiles/idle": { fill: "series-4", stroke: "foreground", strokeWidth: 1.2 },
        "material/zone-storage/idle": { fill: "series-5", stroke: "foreground", strokeWidth: 1.2 },
        "material/shelf/idle": { fill: "card", stroke: "foreground", strokeWidth: 1 },
        "material/fixture/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5 },
        "material/floor/idle": { fill: "card" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "500 15px mono", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "500 15px mono", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "500 15px mono", spring: { stiffness: 420, damping: 34 } },
        "range/default/thumb-idle": { stroke: "border" },
        "range/default/thumb-hovered": { stroke: "border" },
        "toggle/check/off-idle": { stroke: "border" },
        "toggle/check/off-hovered": { stroke: "border" },
        "toggle/switch/off-idle": { stroke: "border" },
        "toggle/switch/off-hovered": { stroke: "border" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.1, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 32 }
    motion: { signature: "merge-lane", stiffness: 420, damping: 34, stagger: 60, enterMs: 477, keyframes: [{ at: 0, opacity: 0, offsetX: -24, offsetY: 0, scale: 0.9, rotate: -1.5 }, { at: 0.1, opacity: 0.333, offsetX: -16.018, offsetY: 0, scale: 0.933, rotate: -1.001 }, { at: 0.2, opacity: 0.586, offsetX: -9.943, offsetY: 0, scale: 0.959, rotate: -0.621 }, { at: 0.3, opacity: 0.747, offsetX: -6.065, offsetY: 0, scale: 0.975, rotate: -0.379 }, { at: 0.4, opacity: 0.847, offsetX: -3.669, offsetY: 0, scale: 0.985, rotate: -0.229 }, { at: 0.5, opacity: 0.91, offsetX: -2.161, offsetY: 0, scale: 0.991, rotate: -0.135 }, { at: 0.6, opacity: 0.95, offsetX: -1.2, offsetY: 0, scale: 0.995, rotate: -0.075 }, { at: 0.7, opacity: 0.975, offsetX: -0.596, offsetY: 0, scale: 0.998, rotate: -0.037 }, { at: 0.8, opacity: 0.99, offsetX: -0.237, offsetY: 0, scale: 0.999, rotate: -0.015 }, { at: 0.9, opacity: 0.998, offsetX: -0.054, offsetY: 0, scale: 1, rotate: -0.003 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/availability/"
  }
}
