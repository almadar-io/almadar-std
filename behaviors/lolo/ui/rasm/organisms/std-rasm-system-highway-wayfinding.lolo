app std-rasm-system-highway-wayfinding [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-highway-wayfinding — the Highway Wayfinding design system for a Rasm page, anchored on FHWA Standard Highway Signs (Series E Modified) and the Interstate shield system (https://mutcd.fhwa.dot.gov/ser-shs_millennium.htm). Colour: #0B5E3B ground, #FFFFFF ink, #FFC72C accent. Type: Overpass over Public Sans. Grid: axial grid along one route line with exits. Motion: the merge-lane easing (cubic-bezier 0.20,0.70,0.30,1.00); entrance: signs slide in from the reading end like approaching overhead gantries. Interaction: sign plate brightens like retroreflective sheeting. Imagery: pictograms on reflective plates. Voice: imperative, terse, distance first ('Aisle 4, 30 m'). Components: buttons are sign plates with a thin inset border; cards are exit panels with arrows. Data: distance bars like exit countdown ticks. Sound: turn-signal click on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "highway-wayfinding"
    palette: {background: "#0B5E3B", foreground: "#FFFFFF", card: "#14613F", "card-foreground": "#FFFFFF", surface: "#0F6039", muted: "#176544", "muted-foreground": "#D3E3DB", border: "#9CC4B2", input: "#A9CDBB", primary: "#FFC72C", "primary-hover": "#FFCF4C", "primary-foreground": "#0B5E3B", secondary: "#14613F", "secondary-foreground": "#FFFFFF", "secondary-hover": "#1E7048", accent: "#FFC72C", "accent-foreground": "#0B5E3B", ring: "#FFC72C", "series-1": "#FFC72C", "series-2": "#FFE08B", "series-3": "#919833", "series-4": "#B6CFC4", "series-5": "#BFA356"}
    fonts: { display: { family: "Overpass", file: "https://almadar-kflow-assets.web.app/fonts/overpass/Overpass%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Public Sans", file: "https://almadar-kflow-assets.web.app/fonts/publicsans/PublicSans%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/plan/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 } },
        "stack/closing/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "primary", strokeWidth: 2, gap: 8 } },
        "pressable/primary/idle": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "primary", stroke: "primary-foreground", strokeWidth: 1, textColor: "primary-foreground", inset: { stroke: "primary-foreground", strokeWidth: 2, gap: 4 } },
        "pressable/primary/hovered": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "primary-hover", stroke: "primary-foreground", strokeWidth: 1, textColor: "primary-foreground", inset: { stroke: "primary-foreground", strokeWidth: 2, gap: 4 }, shadow: { color: "rgba(255,224,139,0.55)", blur: 22, offsetX: 0, offsetY: 0 } },
        "pressable/primary/pressed": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 420, damping: 36 }, fill: "primary-hover", stroke: "primary-foreground", strokeWidth: 1, textColor: "primary-foreground", inset: { stroke: "primary-foreground", strokeWidth: 2, gap: 6 } },
        "pressable/primary/focused": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "primary", stroke: "foreground", strokeWidth: 3, textColor: "primary-foreground", inset: { stroke: "primary-foreground", strokeWidth: 2, gap: 4 } },
        "pressable/secondary/idle": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "foreground", stroke: "background", strokeWidth: 1, textColor: "background", inset: { stroke: "background", strokeWidth: 2, gap: 4 } },
        "pressable/secondary/hovered": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "#EEF6F1", stroke: "background", strokeWidth: 1, textColor: "background", inset: { stroke: "background", strokeWidth: 2, gap: 4 }, shadow: { color: "rgba(255,255,255,0.5)", blur: 22, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/pressed": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 420, damping: 36 }, fill: "#EEF6F1", stroke: "background", strokeWidth: 1, textColor: "background", inset: { stroke: "background", strokeWidth: 2, gap: 6 } },
        "pressable/secondary/focused": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "foreground", stroke: "ring", strokeWidth: 3, textColor: "background", inset: { stroke: "background", strokeWidth: 2, gap: 4 } },
        "pressable/secondary/disabled": { corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "700 17px body", spring: { stiffness: 300, damping: 30 }, fill: "muted", stroke: "border", strokeWidth: 1, textColor: "muted-foreground" },
        "text/display/idle": { textColor: "foreground", font: "700 92px display" },
        "text/title/idle": { textColor: "foreground", font: "700 48px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 14px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 17px body", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "primary", font: "700 168px display" },
        "text/label/idle": { textColor: "foreground", font: "700 14px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px body" },
        "text/inverse/idle": { textColor: "background", font: "600 15px body", on: "section/band/idle" },
        "text/plan/idle": { textColor: "foreground", font: "700 13px body", on: "stack/plan/idle" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 }, spring: { stiffness: 300, damping: 30 } },
        "card/surface/hovered": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "primary", strokeWidth: 1, gap: 6 }, shadow: { color: "rgba(255,199,44,0.4)", blur: 22, offsetX: 0, offsetY: 0 }, spring: { stiffness: 300, damping: 30 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 }, spring: { stiffness: 300, damping: 30 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 3, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "primary", strokeWidth: 2, gap: 8 }, spring: { stiffness: 420, damping: 36 } },
        "card/header/idle": { fill: "foreground", corners: { radius: [8, 8, 0, 0], kind: "round" }, textColor: "background", font: "700 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 } },
        "panel/header/idle": { fill: "foreground", corners: { radius: [8, 8, 0, 0], kind: "round" }, textColor: "background", font: "700 13px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "morph/default/idle": { stroke: "primary", strokeWidth: 5 },
        "morph/route/idle": { stroke: "primary", strokeWidth: 6 },
        "morph/aisle/idle": { stroke: "border", strokeWidth: 3 },
        "morph/wall/idle": { stroke: "foreground", strokeWidth: 6 },
        "pulse/default/idle": { fill: "foreground", stroke: "background", strokeWidth: 2, textColor: "background", font: "700 13px body" },
        "pulse/pin/idle": { fill: "foreground", stroke: "background", strokeWidth: 2, textColor: "background", font: "700 13px body" },
        "pulse/hot/idle": { fill: "primary", stroke: "primary-foreground", strokeWidth: 2, textColor: "primary-foreground", font: "700 13px body" },
        "pulse/route/idle": { fill: "primary", stroke: "primary-foreground", strokeWidth: 2, textColor: "primary-foreground", font: "700 13px body" },
        "pulse/link/idle": { stroke: "border", strokeWidth: 3 },
        "material/zone-furniture/idle": { fill: "series-1", stroke: "foreground", strokeWidth: 2 },
        "material/zone-lighting/idle": { fill: "series-2", stroke: "foreground", strokeWidth: 2 },
        "material/zone-kitchen/idle": { fill: "series-3", stroke: "foreground", strokeWidth: 2 },
        "material/zone-textiles/idle": { fill: "series-4", stroke: "foreground", strokeWidth: 2 },
        "material/zone-storage/idle": { fill: "series-5", stroke: "foreground", strokeWidth: 2 },
        "material/shelf/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.5 },
        "material/fixture/idle": { fill: "card", stroke: "foreground", strokeWidth: 2 },
        "material/floor/idle": { fill: "card" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 4 }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 30 } },
        "textfield/default/hovered": { fill: "surface", stroke: "primary", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, inset: { stroke: "primary", strokeWidth: 1, gap: 4 }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 30 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 4 }, textColor: "foreground", font: "500 16px body", spring: { stiffness: 300, damping: 30 } },
        "range/default/thumb-idle": { stroke: "foreground" },
        "range/default/thumb-hovered": { stroke: "primary" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "primary", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" }
      }
    systemBreakpointLooks: { phone: { "text/display/idle": { textColor: "foreground", font: "700 46px display" }, "text/title/idle": { textColor: "foreground", font: "700 30px display" }, "text/numeral/idle": { textColor: "primary", font: "700 88px display" }, "text/body/idle": { textColor: "muted-foreground", font: "400 16px body" } }, tablet: { "text/display/idle": { textColor: "foreground", font: "700 68px display" }, "text/title/idle": { textColor: "foreground", font: "700 38px display" }, "text/numeral/idle": { textColor: "primary", font: "700 120px display" } } }
    layout: { hero: "split", columns: 6, asymmetry: 0, ornament: "frame", align: "start", imageTreatment: "none", sectionGap: 80, gutter: 24 }
    motion: { signature: "merge-lane", stiffness: 300, damping: 30, stagger: 90, enterMs: 560, keyframes: [{ at: 0, opacity: 0, offsetX: 56, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.333, offsetX: 37.374, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.586, offsetX: 23.201, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.747, offsetX: 14.153, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.847, offsetX: 8.562, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.91, offsetX: 5.042, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.95, offsetX: 2.799, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.975, offsetX: 1.39, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.99, offsetX: 0.553, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.998, offsetX: 0.125, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/availability/"
  }
}
