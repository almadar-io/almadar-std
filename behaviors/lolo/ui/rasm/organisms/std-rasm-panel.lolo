app std-rasm-panel [
  version: "0.1.0",
  description: "std-rasm-panel — the Rasm kit composed into a panel centred on a single orbital canvas that fills its container: a framed card holding a title, a paragraph, a Your name text field, a Season choice, Begin / Theme / Later buttons, a Sound switch and a Warmth range, with keyboard focus, assistive-technology actions and a staggered entry. Theme flips between the naqsh and glass presets. RASM_BEGIN, RASM_SOUND_CHANGED { checked }, RASM_WARMTH_CHANGED { value }, RASM_NAME_CHANGED { value }, RASM_NAME_SUBMITTED { value } and RASM_SEASON_CHANGED { value } leave the panel.",
  locales: [en, ar, sl]
]

uses ThemeAtom from "std/behaviors/std-rasm-theme"
uses SurfaceAtom from "std/behaviors/std-rasm-surface"
uses StackAtom from "std/behaviors/std-rasm-stack"
uses TextAtom from "std/behaviors/std-rasm-text"
uses PressAtom from "std/behaviors/std-rasm-pressable"
uses ToggleAtom from "std/behaviors/std-rasm-toggle"
uses RangeAtom from "std/behaviors/std-rasm-range"
uses PresenceAtom from "std/behaviors/std-rasm-presence"
uses FocusAtom from "std/behaviors/std-rasm-focus"
uses TextFieldAtom from "std/behaviors/std-rasm-textfield"
uses ChoiceAtom from "std/behaviors/std-rasm-choice"
uses AnchorAtom from "std/behaviors/std-rasm-anchor"
uses BufAtom from "std/behaviors/std-text-buffer"

orbital RasmPanel {
  entity RasmPanelView [runtime] {
    id : string!
  }

  trait Theme = ThemeAtom.traits.RasmTheme {
    listens {
      ThemeBtn.RASM_THEME_PRESSED -> RASM_THEME_TOGGLE
      Surface.RASM_BOOT -> RASM_BOOT
    }
  }

  trait Surface = SurfaceAtom.traits.RasmSurface {
    config {
      id: "rasm"
      width: 720
      height: 700
      rootChild: "panel"
      rootRect: { x: 120, y: 40, w: 480, h: 620 }
      fill: true
      margin: 24
      align: "center"
    }
    listens {
      PanelStack.RASM_EXTENT -> RASM_EXTENT
      ActionsStack.RASM_EXTENT -> RASM_EXTENT
      Theme.RASM_THEME -> RASM_THEME
      PanelStack.RASM_PAINT -> RASM_PAINT
      ActionsStack.RASM_PAINT -> RASM_PAINT
      TitleText.RASM_PAINT -> RASM_PAINT
      BodyText.RASM_PAINT -> RASM_PAINT
      BeginBtn.RASM_PAINT -> RASM_PAINT
      ThemeBtn.RASM_PAINT -> RASM_PAINT
      LaterBtn.RASM_PAINT -> RASM_PAINT
      SoundToggle.RASM_PAINT -> RASM_PAINT
      WarmthRange.RASM_PAINT -> RASM_PAINT
      NameField.RASM_PAINT -> RASM_PAINT
      SeasonChoice.RASM_PAINT -> RASM_PAINT
      Surface.RASM_RESIZE -> RASM_RESIZE
    }
  }

  trait NameBuffer = BufAtom.traits.Buffer {
    config {
      slot: sidebar
      headless: true
    }
    listens {
      NameField.LOAD_TEXT -> LOAD_TEXT
      NameField.INSERT_TEXT -> INSERT_TEXT
      NameField.BACKSPACE -> BACKSPACE
      NameField.MOTION -> MOTION
      NameField.OPERATE -> OPERATE
      NameField.CURSOR_SET -> CURSOR_SET
    }
  }

  trait PanelStack = StackAtom.traits.RasmStack {
    config {
      id: "panel"
      axis: "vertical"
      gap: 18
      padding: 36
      look: "stack/panel/idle"
      z: 1
      children: [{ id: "title", size: "measure" }, { id: "body", size: "measure" }, { id: "name", size: "fixed", main: 66 }, { id: "season", size: "fixed", main: 66 }, { id: "actions", size: "fixed", main: 46 }, { id: "sound", size: "fixed", main: 28 }, { id: "warmth", size: "fixed", main: 56 }]
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Surface.RASM_PLACE -> RASM_PLACE
      Surface.RASM_MEASURED -> RASM_MEASURED
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait ActionsStack = StackAtom.traits.RasmStack {
    config {
      id: "actions"
      axis: "horizontal"
      gap: 12
      padding: 0
      look: ""
      z: 1
      children: [{ id: "begin", size: "fill" }, { id: "theme", size: "fill" }, { id: "later", size: "fill" }]
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      PanelStack.RASM_PLACE -> RASM_PLACE
      Surface.RASM_MEASURED -> RASM_MEASURED
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait TitleText = TextAtom.traits.RasmText {
    config {
      id: "title"
      text: "title"
      intent: "title"
      z: 2
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      PanelStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait BodyText = TextAtom.traits.RasmText {
    config {
      id: "body"
      text: "body"
      intent: "body"
      z: 2
    }
    listens {
      Theme.RASM_THEME -> RASM_THEME
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      PanelStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
    }
  }

  trait BeginBtn = PressAtom.traits.RasmPressable {
    config {
      id: "begin"
      label: "begin"
      intent: "primary"
      action: RASM_BEGIN
      order: 3
      z: 2
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      ActionsStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait ThemeBtn = PressAtom.traits.RasmPressable {
    config {
      id: "theme"
      label: "theme"
      intent: "secondary"
      action: RASM_THEME_PRESSED
      order: 4
      z: 2
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      ActionsStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait LaterBtn = PressAtom.traits.RasmPressable {
    config {
      id: "later"
      label: "later"
      intent: "secondary"
      disabled: true
      order: 5
      z: 2
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      ActionsStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait SoundToggle = ToggleAtom.traits.RasmToggle {
    config {
      id: "sound"
      label: "sound"
      kind: "switch"
      changed: RASM_SOUND_CHANGED
      order: 6
      z: 2
    }
    listens {
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      PanelStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
    }
  }

  trait WarmthRange = RangeAtom.traits.RasmRange {
    config {
      id: "warmth"
      label: "warmth"
      min: 0
      max: 100
      value: 60
      changed: RASM_WARMTH_CHANGED
      order: 7
      z: 2
    }
    listens {
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      PanelStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_STEP -> RASM_STEP
    }
  }

  trait Enter = PresenceAtom.traits.RasmPresence {
    config {
      order: ["panel", "title", "body", "name", "season", "begin", "theme", "later", "sound", "warmth"]
      staggerMs: 70
    }
    listens {
      Surface.RASM_BOOT -> RASM_BOOT
    }
  }

  trait Focus = FocusAtom.traits.RasmFocus {
    config {
      order: ["name", "season", "begin", "theme", "sound", "warmth"]
    }
    listens {
      Surface.RASM_KEY -> RASM_KEY
      Surface.RASM_ACCESS -> RASM_ACCESS
      Surface.RASM_POINTER -> RASM_POINTER
    }
  }

  trait NameField = TextFieldAtom.traits.RasmTextField {
    config {
      id: "name"
      label: "name"
      placeholder: "name-hint"
      changed: RASM_NAME_CHANGED
      submitted: RASM_NAME_SUBMITTED
      order: 1
      z: 2
    }
    listens {
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      NameBuffer.KEY -> BUFFER_KEY
      NameBuffer.EDITOR_HOVER -> BUFFER_HOVER
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      PanelStack.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Surface.RASM_TEXT -> RASM_TEXT
      Surface.RASM_KEYPRESS -> RASM_KEYPRESS
      Focus.RASM_KEYPRESS -> RASM_KEYPRESS
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
      NameBuffer.BUFFER_EDITED -> BUFFER_EDITED
      NameBuffer.CURSOR_MOVED -> CURSOR_MOVED
    }
  }

  trait SeasonChoice = ChoiceAtom.traits.RasmChoice {
    config {
      id: "season"
      label: "season"
      options: [{ value: "Spring", label: "season.spring" }, { value: "Summer", label: "season.summer" }, { value: "Autumn", label: "season.autumn" }, { value: "Winter", label: "season.winter" }]
      value: "Spring"
      changed: RASM_SEASON_CHANGED
      order: 2
      z: 2
    }
    listens {
      Surface.RASM_DIRECTION -> RASM_DIRECTION
      Surface.RASM_BOOT -> RASM_BOOT
      Theme.RASM_THEME -> RASM_THEME
      PanelStack.RASM_PLACE -> RASM_PLACE
      Anchor.RASM_PLACE -> RASM_PLACE
      Enter.RASM_ENTER -> RASM_ENTER
      Surface.RASM_POINTER -> RASM_POINTER
      Surface.RASM_KEYPRESS -> RASM_KEYPRESS
      Focus.RASM_KEYPRESS -> RASM_KEYPRESS
      Focus.RASM_FOCUS -> RASM_FOCUS
      Focus.RASM_ACTIVATE -> RASM_ACTIVATE
      Focus.RASM_STEP -> RASM_STEP
    }
  }

  trait Anchor = AnchorAtom.traits.RasmAnchor {
    listens {
      PanelStack.RASM_PLACE -> RASM_PLACE
      Surface.RASM_RESIZE -> RASM_RESIZE
      SeasonChoice.RASM_ANCHOR -> RASM_ANCHOR
    }
  }

  page "/rasm-panel" as RasmPanelPage -> Theme, Surface, NameBuffer, PanelStack, ActionsStack, TitleText, BodyText, BeginBtn, ThemeBtn, LaterBtn, SoundToggle, WarmthRange, Enter, Focus, NameField, SeasonChoice, Anchor
}
