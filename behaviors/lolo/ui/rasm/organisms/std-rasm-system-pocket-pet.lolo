app std-rasm-system-pocket-pet [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-pocket-pet — the Pocket Pet design system for a Rasm page, anchored on Tamagotchi and Nintendo DS menu UI (https://en.wikipedia.org/wiki/Tamagotchi). Colour: #FFF3FA ground, #3A2350 ink, #FF6FB5 accent. Type: Press Start 2P over Nunito. Grid: 8px pixel grid with chunky 3-column cards. Motion: the bounce-pop easing (cubic-bezier 0.18,1.80,0.40,1.00); entrance: tiles pop in with a squash and stretch. Interaction: tile bobs up 4px. Imagery: pixel sprites and pastel stickers. Voice: cheerful, encouraging, levels and streaks. Components: buttons are pixel pills with a 2px drop; cards are bubbly frames. Data: progress hearts and XP bars. Sound: 8-bit coin blip on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "pocket-pet"
    palette: {background: "#FFF3FA", foreground: "#3A2350", card: "#FFFAFD", "card-foreground": "#3A2350", surface: "#F9EDF5", muted: "#EFE2EC", "muted-foreground": "#796686", border: "#A695AE", input: "#9D8BA5", primary: "#FF6FB5", "primary-hover": "#D95E9A", "primary-foreground": "#3A2350", secondary: "#FFFAFD", "secondary-foreground": "#3A2350", "secondary-hover": "#E7DAE6", accent: "#FF6FB5", "accent-foreground": "#3A2350", ring: "#FF6FB5", "series-1": "#FF6FB5", "series-2": "#A64D88", "series-3": "#FFAAD4", "series-4": "#756183", "series-5": "#BF779A"}
    fonts: { display: { family: "Press Start 2P", file: "https://almadar-kflow-assets.web.app/fonts/pressstart2p/PressStart2P-Regular.ttf", generic: "sans-serif" }, body: { family: "Nunito", file: "https://almadar-kflow-assets.web.app/fonts/nunito/Nunito%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let cell = 56.0;\n  var q = px.local + vec2<f32>(0.0, px.time * 6.0);\n  let row = floor(q.y / cell);\n  q.x = q.x + select(0.0, cell * 0.5, fract(row * 0.5) > 0.25);\n  let g = fract(q / cell) - vec2<f32>(0.5, 0.5);\n  let bob = sin(px.time * 0.8 + row + floor(q.x / cell)) * 1.5;\n  let dots = 1.0 - smoothstep(6.0, 7.5, length(g * cell + vec2<f32>(0.0, bob)));\n  let s = abs(g.x) + abs(g.y);\n  let spark = (1.0 - smoothstep(0.0, 0.04, abs(g.x) * abs(g.y) * 6.0 - 0.0)) * (1.0 - smoothstep(0.18, 0.3, s));\n  let pink = vec3<f32>(1.0, 0.72, 0.84);\n  let sky = vec3<f32>(0.72, 0.86, 1.0);\n  var col = mix(px.color.rgb, pink, dots * 0.2);\n  col = mix(col, sky, spark * 0.05 * step(0.6, fract(row * 0.37)));\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", corners: { radius: [26, 26, 26, 26], kind: "round" }, stroke: "border", strokeWidth: 3, shadow: { color: "rgba(194,69,127,0.20)", blur: 34, offsetY: 12 } },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(194,69,127,0.24)", blur: 34, offsetY: 14 }, spring: { stiffness: 140, damping: 12 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(194,69,127,0.36)", blur: 46, offsetY: 22 }, spring: { stiffness: 140, damping: 12 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(194,69,127,0.30)", blur: 26, offsetY: 10 }, spring: { stiffness: 140, damping: 12 } },
        "card/surface/pressed": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "rgba(194,69,127,0.14)", blur: 8, offsetY: 2 }, spring: { stiffness: 200, damping: 14 } },
        "card/header/idle": { fill: "muted", corners: { radius: [28, 28, 0, 0], kind: "round" }, textColor: "foreground", font: "800 15px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 2, strokeDash: [2, 8] },
        "card/media/idle": { fill: "secondary", corners: { radius: [28, 28, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "600 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [24, 24, 24, 24], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "foreground", font: "800 15px display", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 2, strokeDash: [2, 8] },
        "section/band/idle": { fill: "muted" },
        "section/rule/idle": { stroke: "border", strokeWidth: 2, strokeDash: [2, 8] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/focused": { fill: "primary", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "800 17px display", stroke: "foreground", strokeWidth: 2, spring: { stiffness: 140, damping: 12 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px display", spring: { stiffness: 140, damping: 12 } },
        "stack/panel/idle": { fill: "card", corners: { radius: [26, 26, 26, 26], kind: "round" }, stroke: "border", strokeWidth: 3, shadow: { color: "rgba(194,69,127,0.18)", blur: 18 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [26, 26, 26, 26], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "800 17px display", spring: { stiffness: 140, damping: 12 }, shadow: { color: "rgba(194,69,127,0.28)", blur: 12 } },
        "pressable/primary/hovered": { fill: "primary-hover", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "800 17px display", spring: { stiffness: 140, damping: 12 }, shadow: { color: "rgba(194,69,127,0.28)", blur: 12 } },
        "pressable/primary/pressed": { fill: "primary-hover", corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "800 17px display", spring: { stiffness: 140, damping: 12 } },
        "pressable/secondary/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 17px display", spring: { stiffness: 140, damping: 12 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "700 17px display", spring: { stiffness: 140, damping: 12 } },
        "text/display/idle": { textColor: "foreground", font: "800 66px display", spring: { stiffness: 140, damping: 12 } },
        "text/title/idle": { textColor: "foreground", font: "800 38px display", spring: { stiffness: 140, damping: 12 } },
        "text/eyebrow/idle": { textColor: "primary-hover", font: "800 14px display", spring: { stiffness: 140, damping: 12 } },
        "text/body/idle": { textColor: "muted-foreground", font: "600 18px body", spring: { stiffness: 140, damping: 12 } },
        "text/card/idle": { textColor: "card-foreground", font: "800 22px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_star(p: vec2<f32>, ro: f32, ri: f32) -> f32 { let r = length(p); let u = atan2(p.x, -p.y) * 0.795775; let f = abs(fract(u) - 0.5) * 2.0; return (r - mix(ri, ro, f)) * 0.8; }\nfn sg_heart(p: vec2<f32>, r: f32) -> f32 { let q = vec2<f32>(p.x, -p.y + r * 0.1) / (r * 1.1); let t = q.x * q.x + q.y * q.y - 1.0; let v = t * t * t - q.x * q.x * q.y * q.y * q.y; return v * r * 0.33; }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nvar col = px.color.rgb;\nvar a = 0.0;\nlet h1 = sg_fill(sg_heart(p - vec2<f32>(s.x * 0.3, c.y), m * 0.3));\ncol = mix(col, vec3<f32>(1.0, 0.45, 0.68), h1);\na = max(a, h1);\nlet h2 = sg_fill(sg_heart(p - vec2<f32>(s.x * 0.62, c.y * 1.15), m * 0.2));\na = max(a, h2);\nlet st = sg_fill(sg_star(p - vec2<f32>(s.x * 0.78, c.y * 0.7), m * 0.16, m * 0.07));\ncol = mix(col, vec3<f32>(1.0, 0.85, 0.35), st);\na = max(a, st);\nlet dt = sg_fill(length(p - vec2<f32>(s.x * 0.5, c.y * 0.45)) - 3.0);\na = max(a, dt);\nreturn sg_out(px, col, a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "collage", columns: 12, asymmetry: 0.15, ornament: "stamp", align: "center", imageTreatment: "none", sectionGap: 96, gutter: 36 }
    motion: { signature: "bounce-pop", stiffness: 140, damping: 12, stagger: 80, enterMs: 1156, keyframes: [{ at: 0, opacity: 0, offsetX: 18, offsetY: -16, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.724, offsetX: 4.962, offsetY: -4.41, scale: 1, rotate: 0 }, { at: 0.2, opacity: 1, offsetX: -0.866, offsetY: 0.77, scale: 1, rotate: 0 }, { at: 0.3, opacity: 1, offsetX: -2.902, offsetY: 2.579, scale: 1, rotate: 0 }, { at: 0.4, opacity: 1, offsetX: -3.15, offsetY: 2.8, scale: 1, rotate: 0 }, { at: 0.5, opacity: 1, offsetX: -2.634, offsetY: 2.341, scale: 1, rotate: 0 }, { at: 0.6, opacity: 1, offsetX: -1.869, offsetY: 1.661, scale: 1, rotate: 0 }, { at: 0.7, opacity: 1, offsetX: -1.118, offsetY: 0.993, scale: 1, rotate: 0 }, { at: 0.8, opacity: 1, offsetX: -0.515, offsetY: 0.458, scale: 1, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: -0.132, offsetY: 0.117, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/coding-academy/"
  }
}
