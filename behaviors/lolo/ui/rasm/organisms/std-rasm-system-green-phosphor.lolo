app std-rasm-system-green-phosphor [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-green-phosphor — the Green Phosphor design system for a Rasm page, anchored on DEC VT100 terminal and IBM 3270 green screen (https://vt100.net/docs/vt100-ug/). Colour: #06140A ground, #33FF66 ink, #B6FF3B accent. Type: VT323 over IBM Plex Mono. Grid: monospace character cell grid, 80 columns. Motion: the cursor-step easing (cubic-bezier 0.00,0.00,1.00,1.00); entrance: lines type out character by character, cursor blink. Interaction: inverse video block. Imagery: scanlines and phosphor glow, no photos. Voice: command voice, lower case, exit codes. Components: buttons are [ bracketed ] commands; cards are framed with box-drawing characters. Data: ASCII sparklines. Sound: relay click on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "green-phosphor"
    palette: {background: "#06140A", foreground: "#33FF66", card: "#092210", "card-foreground": "#33FF66", surface: "#071B0D", muted: "#0A2711", "muted-foreground": "#25B449", border: "#1A7E33", input: "#1D8A38", primary: "#B6FF3B", "primary-hover": "#C1FF58", "primary-foreground": "#06140A", secondary: "#092210", "secondary-foreground": "#33FF66", "secondary-hover": "#0B3015", accent: "#B6FF3B", "accent-foreground": "#06140A", ring: "#B6FF3B", "series-1": "#B6FF3B", "series-2": "#7BFF4E", "series-3": "#679525", "series-4": "#26B94A", "series-5": "#9BBF5D"}
    fonts: { display: { family: "VT323", file: "https://almadar-kflow-assets.web.app/fonts/vt323/VT323-Regular.ttf", generic: "monospace" }, body: { family: "IBM Plex Mono", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexmono/IBMPlexMono-Regular.ttf", generic: "monospace" }, mono: { family: "VT323", file: "https://almadar-kflow-assets.web.app/fonts/vt323/VT323-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let ph = vec3<f32>(0.2, 1.0, 0.4);\n let sl = 0.5 + 0.5 * sin(px.local.y * 2.094);\n c = c * (0.9 + 0.1 * sl) + ph * 0.018;\n let cell = vec2<f32>(10.0, 20.0);\n let g = abs(fract(px.local / cell) - vec2<f32>(0.5, 0.5));\n c = c + ph * step(0.47, g.x) * step(0.45, g.y) * 0.05;\n let roll = fract(px.time * 0.05 + px.scroll * 0.5);\n let rb = exp(-abs(px.uv.y - roll) * 24.0);\n c = c + ph * 0.04 * rb;\n let v = length((px.uv - vec2<f32>(0.5, 0.5)) * vec2<f32>(1.0, 0.8));\n c = c * (1.0 - 0.4 * smoothstep(0.35, 0.8, v));\n let dp = length(px.local - px.pointer);\n c = c + ph * 0.03 * exp(-dp / 150.0);\n let cur = step(0.5, fract(px.time * 0.8)) * step(abs(px.local.x - 24.0), 5.0) * step(abs(px.local.y - 36.0), 9.0);\n c = c + ph * cur * 0.25;\n return vec4<f32>(c, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 400, damping: 40 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 400, damping: 40 } },
        "stack/hero/idle": { fill: "background", stroke: "primary", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "notch" }, spring: { stiffness: 400, damping: 40 } },
        "stack/bar/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "background", stroke: "primary", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary", font: "700 15px mono", spring: { stiffness: 400, damping: 40 } },
        "pressable/primary/hovered": { fill: "primary", stroke: "card", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 15px mono", spring: { stiffness: 400, damping: 40 } },
        "pressable/primary/pressed": { fill: "foreground", stroke: "card", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 15px mono", spring: { stiffness: 400, damping: 40 } },
        "pressable/primary/focused": { stroke: "card", strokeWidth: 2 },
        "pressable/secondary/idle": { fill: "background", stroke: "input", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 14px mono", spring: { stiffness: 400, damping: 40 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "primary", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary", font: "500 14px mono", spring: { stiffness: 400, damping: 40 } },
        "pressable/secondary/pressed": { stroke: "secondary-foreground" },
        "pressable/secondary/disabled": { stroke: "secondary-foreground" },
        "pressable/secondary/focused": { stroke: "secondary-foreground", strokeWidth: 2 },
        "toggle/check/off-idle": { stroke: "input" },
        "toggle/check/off-hovered": { stroke: "input" },
        "toggle/switch/off-idle": { stroke: "input" },
        "toggle/switch/off-hovered": { stroke: "input" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "card", textColor: "primary-foreground" },
        "range/default/thumb-hovered": { stroke: "input" },
        "range/default/thumb-idle": { stroke: "input" },
        "card/surface/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(0,0,0,0.45)", blur: 26, offsetX: 0, offsetY: 10 }, spring: { stiffness: 400, damping: 40 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 1.5, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(0,0,0,0.6)", blur: 36, offsetX: 0, offsetY: 16 }, spring: { stiffness: 400, damping: 40 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 400, damping: 40 } },
        "card/surface/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 500, damping: 44 } },
        "card/header/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 13px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "input", strokeWidth: 1, strokeDash: [4, 4] },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "muted", stroke: "input", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "700 13px mono" },
        "panel/divider/idle": { stroke: "input", strokeWidth: 1 },
        "section/band/idle": { fill: "secondary" },
        "section/rule/idle": { stroke: "input", strokeWidth: 1, strokeDash: [4, 4] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/display/idle": { textColor: "primary", font: "700 72px display" },
        "text/title/idle": { textColor: "foreground", font: "700 34px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "500 13px mono" },
        "text/body/idle": { textColor: "foreground", font: "400 16px body" },
        "text/card/idle": { textColor: "primary", font: "700 19px mono" },
        "text/inverse/idle": { textColor: "secondary-foreground", font: "700 16px mono", on: "section/band/idle" },
        "icon/inverse/idle": { textColor: "secondary-foreground", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 13px mono" },
        "text/label/idle": { textColor: "foreground", font: "600 13px mono" },
        "morph/default/idle": { fill: "primary" },
        "ornament/signature/idle": { fill: "primary", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet blink = 1.0 - step(0.5, fract(px.time));\nlet blk = sg_fill(sg_box(p - vec2<f32>(44.0, c.y), vec2<f32>(7.0, 11.0))) * blink;\nlet chev = max(sg_line(sg_seg(p, vec2<f32>(10.0, c.y - 8.0), vec2<f32>(20.0, c.y)), 1.3), sg_line(sg_seg(p, vec2<f32>(20.0, c.y), vec2<f32>(10.0, c.y + 8.0)), 1.3));\nlet scan = step(fract(p.y / 3.0), 0.33) * 0.12;\nreturn sg_out(px, px.color.rgb, max(max(chev, blk), scan));\n}\n", params: [0, 0, 0, 0], live: true } }
      }
    layout: { hero: "offset", columns: 12, asymmetry: 0.0, ornament: "rule", align: "start", imageTreatment: "scanline", sectionGap: 80, gutter: 32 }
    motion: { signature: "cursor-step", stiffness: 400, damping: 40, stagger: 30, enterMs: 865, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 12, scale: 0.94, rotate: 2 }, { at: 0.1, opacity: 0.1, offsetX: 0, offsetY: 10.8, scale: 0.946, rotate: 1.8 }, { at: 0.2, opacity: 0.2, offsetX: 0, offsetY: 9.6, scale: 0.952, rotate: 1.6 }, { at: 0.3, opacity: 0.3, offsetX: 0, offsetY: 8.4, scale: 0.958, rotate: 1.4 }, { at: 0.4, opacity: 0.4, offsetX: 0, offsetY: 7.2, scale: 0.964, rotate: 1.2 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 6, scale: 0.97, rotate: 1 }, { at: 0.6, opacity: 0.6, offsetX: 0, offsetY: 4.8, scale: 0.976, rotate: 0.8 }, { at: 0.7, opacity: 0.7, offsetX: 0, offsetY: 3.6, scale: 0.982, rotate: 0.6 }, { at: 0.8, opacity: 0.8, offsetX: 0, offsetY: 2.4, scale: 0.988, rotate: 0.4 }, { at: 0.9, opacity: 0.9, offsetX: 0, offsetY: 1.2, scale: 0.994, rotate: 0.2 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/cicd/"
  }
}
