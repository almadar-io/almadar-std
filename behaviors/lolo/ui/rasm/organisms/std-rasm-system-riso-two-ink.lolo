app std-rasm-system-riso-two-ink [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-riso-two-ink — the Riso Two Ink design system for a Rasm page, anchored on Risograph print culture (Hato Press, Colorama) (https://hatopress.org). Colour: #F6F0E6 ground, #2A3F7A ink, #FF4F79 accent. Type: Bagel Fat One over Rethink Sans. Grid: misregistered 2-layer grid, 3px offset. Motion: the riso-pass easing (cubic-bezier 0.40,0.00,0.20,1.00); entrance: two ink layers pass in, slightly off register. Interaction: ink layers re-register. Imagery: two-colour grain prints. Voice: friendly, customer stories in quotes. Components: buttons are two-ink pills; cards are print sheets with grain. Data: overprinted bar charts. Sound: drum printer roll on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "riso-two-ink"
    palette: {background: "#F6F0E6", foreground: "#2A3F7A", card: "#FBF8F4", "card-foreground": "#2A3F7A", surface: "#F0EBE3", muted: "#E6E2DD", "muted-foreground": "#4A5780", border: "#6B7A8F", input: "#6B7A8F", primary: "#FF4F79", "primary-hover": "#FF6F90", "primary-foreground": "#14204A", secondary: "#FBF8F4", "secondary-foreground": "#2A3F7A", "secondary-hover": "#DEDBD9", accent: "#FF4F79", "accent-foreground": "#14204A", ring: "#2A3F7A", "series-1": "#2A3F7A", "series-2": "#D1204E", "series-3": "#6B7A8F", "series-4": "#4A5780", "series-5": "#B0365F"}
    fonts: { display: { family: "Bagel Fat One", file: "https://almadar-kflow-assets.web.app/fonts/bagelfatone/BagelFatOne-Regular.ttf", generic: "sans-serif" }, body: { family: "Rethink Sans", file: "https://almadar-kflow-assets.web.app/fonts/rethinksans/RethinkSans%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); } fn rg_dots(p: vec2<f32>, cell: f32, ang: f32, k: f32) -> f32 { let c = cos(ang); let sn = sin(ang); let r = vec2<f32>(p.x * c - p.y * sn, p.x * sn + p.y * c); let q = fract(r / cell) - 0.5; let id = floor(r / cell); let rad = 0.14 + k * (0.5 + 0.5 * sin(id.x * 0.11 + id.y * 0.07)); return 1.0 - smoothstep(rad - 0.06, rad + 0.06, length(q)); } fn shade(px: Pixel) -> vec4<f32> { let p = px.local; let off = vec2<f32>(3.0, -2.0) + vec2<f32>(sin(px.time * 0.2), cos(px.time * 0.17)) + vec2<f32>(px.scroll * 5.0); let pink = vec3<f32>(1.0, 0.28, 0.55); let blue = vec3<f32>(0.0, 0.5, 0.8); let m1 = smoothstep(0.2, 1.0, px.uv.x); let m2 = smoothstep(0.8, 0.0, px.uv.x) * (1.0 - px.uv.y * 0.5); let a1 = rg_dots(p, 9.0, 0.26, 0.28) * m1; let a2 = rg_dots(p + off, 9.0, 0.79, 0.28) * m2; var c = mix(px.color.rgb, pink, a1 * 0.14); c = mix(c, blue, a2 * 0.12); let g = (rg_h(floor(p)) - 0.5) * 0.05; return vec4<f32>(c + vec3<f32>(g), px.color.a); }", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 3, offsetY: 3 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 3, offsetY: 3 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 3, offsetY: 3 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 0, offsetY: 0 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 3, offsetY: 3 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 0, offsetY: 0 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "card/header/idle": { fill: "accent", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "400 22px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "card/media/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "#FF4F79", blur: 0, offsetX: 3, offsetY: 3 }, material: { wgsl: "fn rg_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let g = (rg_h(floor(px.local / 1.5)) - 0.5) * 0.07;\n  let speck = step(0.992, rg_h(floor(px.local / 2.0) + vec2<f32>(7.0, 3.0))) * 0.08;\n  return vec4<f32>(px.color.rgb + vec3<f32>(g - speck), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, spring: { stiffness: 200, damping: 26 } },
        "panel/header/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "400 22px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "muted" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 2 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", shadow: { color: "#2A3F7A", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", shadow: { color: "#2A3F7A", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", shadow: { color: "#2A3F7A", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", shadow: { color: "#2A3F7A", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/idle": { fill: "card", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", shadow: { color: "#FF4F79", blur: 0, offsetX: 3, offsetY: 3 }, spring: { stiffness: 200, damping: 26 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, font: "700 17px body", shadow: { color: "#FF4F79", blur: 0, offsetX: 0, offsetY: 0 }, spring: { stiffness: 200, damping: 26 } },
        "text/display/idle": { textColor: "foreground", font: "400 84px display" },
        "text/title/idle": { textColor: "foreground", font: "400 40px display" },
        "text/eyebrow/idle": { textColor: "series-2", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 18px body" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "text/card/idle": { textColor: "card-foreground", font: "400 25px display" },
        "machine/event/lit": { textColor: "ring", font: "600 13px mono" },
        "orbit/label/active": { textColor: "ring", font: "700 18px body" },
        "text/numeral/idle": { textColor: "ring", font: "400 200px display" },
        "morph/default/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 2 },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_rot(p: vec2<f32>, a: f32) -> vec2<f32> { let c = cos(a); let s = sin(a); return vec2<f32>(c * p.x - s * p.y, s * p.x + c * p.y); }\nfn sg_halftone(p: vec2<f32>, cell: f32, ang: f32, rad: f32) -> f32 { let q = sg_rot(p, ang) / cell; let c = fract(q) - vec2<f32>(0.5, 0.5); return (1.0 - smoothstep(rad - 0.08, rad + 0.08, length(c))) * step(0.03, rad); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet r = clamp(1.0 - length(p - c) / (m * 0.55), 0.0, 1.0);\nlet aa = sg_halftone(p, 9.0, 0.2618, r * 0.62);\nlet ab = sg_halftone(p + vec2<f32>(4.0, -3.0), 9.0, 1.309, r * 0.62);\nlet col = mix(vec3<f32>(1.0, 0.28, 0.69), px.color.rgb, aa / (aa + ab + 0.0001));\nreturn sg_out(px, col, max(aa, ab));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "poster", columns: 12, asymmetry: 0, ornament: "stamp", align: "start", imageTreatment: "riso", sectionGap: 88, gutter: 36 }
    motion: { signature: "riso-pass", stiffness: 200, damping: 26, stagger: 80, enterMs: 640, keyframes: [{ at: 0, opacity: 0, offsetX: -18, offsetY: 3, scale: 1, rotate: -0.6 }, { at: 0.1, opacity: 0.026, offsetX: -17.534, offsetY: 2.922, scale: 1, rotate: -0.584 }, { at: 0.2, opacity: 0.134, offsetX: -15.589, offsetY: 2.598, scale: 1, rotate: -0.52 }, { at: 0.3, opacity: 0.367, offsetX: -11.389, offsetY: 1.898, scale: 1, rotate: -0.38 }, { at: 0.4, opacity: 0.614, offsetX: -6.955, offsetY: 1.159, scale: 1, rotate: -0.232 }, { at: 0.5, opacity: 0.776, offsetX: -4.04, offsetY: 0.673, scale: 1, rotate: -0.135 }, { at: 0.6, opacity: 0.876, offsetX: -2.233, offsetY: 0.372, scale: 1, rotate: -0.074 }, { at: 0.7, opacity: 0.938, offsetX: -1.112, offsetY: 0.185, scale: 1, rotate: -0.037 }, { at: 0.8, opacity: 0.975, offsetX: -0.445, offsetY: 0.074, scale: 1, rotate: -0.015 }, { at: 0.9, opacity: 0.994, offsetX: -0.102, offsetY: 0.017, scale: 1, rotate: -0.003 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/success/"
  }
}
