app std-rasm-system-clay-desk [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-clay-desk — the Clay Desk design system for a Rasm page, anchored on Claymorphism and Aardman stop-motion (https://en.wikipedia.org/wiki/Aardman_Animations). Colour: #EEF1FA ground, #2C2F48 ink, #7B61FF accent. Type: Fredoka over Quicksand. Grid: soft 3-column grid with generous 32px gaps. Motion: the squish easing (cubic-bezier 0.30,1.30,0.60,1.00); entrance: cards squish down onto the desk. Interaction: card puffs and lifts. Imagery: soft clay 3D objects. Voice: friendly, patient, plain help. Components: buttons are puffy pills; cards are clay pillows with inner highlights. Data: rounded bar charts. Sound: soft squeak on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "clay-desk"
    palette: {background: "#EEF1FA", foreground: "#2C2F48", card: "#F7F9FD", "card-foreground": "#2C2F48", surface: "#E8EBF5", muted: "#DEE1EC", "muted-foreground": "#585B70", border: "#979AAA", input: "#7B7E94", primary: "#6247F0", "primary-hover": "#5A41E0", "primary-foreground": "#EEF1FA", secondary: "#F7F9FD", "secondary-foreground": "#2C2F48", "secondary-hover": "#D7DAE5", accent: "#7B61FF", "accent-foreground": "#0B0820", ring: "#7B61FF", "series-1": "#7B61FF", "series-2": "#574BAD", "series-3": "#AFA2FD", "series-4": "#66697D", "series-5": "#7D70BF"}
    fonts: { display: { family: "Fredoka", file: "https://almadar-kflow-assets.web.app/fonts/fredoka/Fredoka%5Bwdth%2Cwght%5D.ttf", generic: "sans-serif" }, body: { family: "Quicksand", file: "https://almadar-kflow-assets.web.app/fonts/quicksand/Quicksand%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn cl_blob(p: vec2<f32>, c: vec2<f32>, r: f32) -> f32 { return r - length(p - c); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / px.size.y;\n  let p = px.uv * vec2<f32>(asp, 1.0);\n  let t = px.time * 0.25;\n  let y = px.scroll * 0.2;\n  let b1 = cl_blob(p, vec2<f32>(0.25 * asp, 0.25 + sin(t) * 0.03 - y), 0.2);\n  let b2 = cl_blob(p, vec2<f32>(0.8 * asp, 0.6 + sin(t * 0.8 + 2.0) * 0.04 - y), 0.26);\n  let b3 = cl_blob(p, vec2<f32>(0.45 * asp, 0.9 + sin(t * 1.1 + 4.0) * 0.03 - y), 0.17);\n  var col = px.color.rgb;\n  col = mix(col, vec3<f32>(0.78, 0.6, 0.9), smoothstep(-0.01, 0.01, b1) * 0.16);\n  col = mix(col, vec3<f32>(1.0, 0.72, 0.55), smoothstep(-0.01, 0.01, b2) * 0.16);\n  col = mix(col, vec3<f32>(0.62, 0.85, 0.82), smoothstep(-0.01, 0.01, b3) * 0.16);\n  let rim = smoothstep(0.0, 0.05, b1) * (1.0 - smoothstep(0.05, 0.12, b1));\n  col = col + vec3<f32>(1.0, 1.0, 1.0) * rim * 0.03;\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "#FFFFFF", strokeWidth: 3, inset: { stroke: "#FFFFFF", strokeWidth: 3, gap: 8 }, corners: { radius: [40, 40, 40, 40], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 30, offsetY: 14 }, spring: { stiffness: 90, damping: 10 } },
        "stack/panel/idle": { fill: "card", stroke: "#FFFFFF", strokeWidth: 3, inset: { stroke: "#FFFFFF", strokeWidth: 3, gap: 8 }, corners: { radius: [40, 40, 40, 40], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 30, offsetY: 14 }, spring: { stiffness: 90, damping: 10 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [40, 40, 40, 40], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "none", strokeWidth: 0, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#3B2A9C", blur: 0, offsetY: 7 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "none", strokeWidth: 0, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#3B2A9C", blur: 0, offsetY: 11 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "none", strokeWidth: 0, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#3B2A9C", blur: 0, offsetY: 2 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#3B2A9C", blur: 0, offsetY: 7 } },
        "pressable/secondary/idle": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#B4B8D0", blur: 0, offsetY: 7 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "input", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#B4B8D0", blur: 0, offsetY: 11 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#B4B8D0", blur: 0, offsetY: 7 } },
        "text/display/idle": { textColor: "foreground", font: "700 76px display", spring: { stiffness: 90, damping: 10 } },
        "text/title/idle": { textColor: "foreground", font: "600 44px display", spring: { stiffness: 90, damping: 10 } },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 14px display", spring: { stiffness: 90, damping: 10 } },
        "text/body/idle": { textColor: "muted-foreground", font: "500 19px body", spring: { stiffness: 90, damping: 10 } },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "text/card/idle": { textColor: "card-foreground", font: "600 26px display" },
        "card/surface/idle": { fill: "card", stroke: "#FFFFFF", strokeWidth: 3, inset: { stroke: "#FFFFFF", strokeWidth: 3, gap: 8 }, corners: { radius: [34, 34, 34, 34], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 30, offsetY: 14 }, spring: { stiffness: 90, damping: 10 } },
        "card/surface/hovered": { fill: "card", stroke: "#FFFFFF", strokeWidth: 3, inset: { stroke: "#FFFFFF", strokeWidth: 3, gap: 8 }, corners: { radius: [34, 34, 34, 34], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 46, offsetY: 26 }, spring: { stiffness: 90, damping: 10 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, inset: { stroke: "#FFFFFF", strokeWidth: 3, gap: 8 }, corners: { radius: [34, 34, 34, 34], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 46, offsetY: 26 }, spring: { stiffness: 90, damping: 10 } },
        "card/surface/pressed": { fill: "card", stroke: "#FFFFFF", strokeWidth: 3, inset: { stroke: "#FFFFFF", strokeWidth: 3, gap: 12 }, corners: { radius: [34, 34, 34, 34], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 10, offsetY: 3 }, spring: { stiffness: 140, damping: 12 } },
        "card/header/idle": { fill: "accent", corners: { radius: [32, 32, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "600 15px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 2 },
        "card/media/idle": { fill: "secondary", corners: { radius: [26, 26, 26, 26], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "#FFFFFF", strokeWidth: 3, corners: { radius: [40, 40, 40, 40], kind: "round" }, shadow: { color: "rgba(62,48,130,0.28)", blur: 24, offsetY: 10 } },
        "panel/header/idle": { fill: "secondary", stroke: "#FFFFFF", strokeWidth: 3, corners: { radius: [38, 38, 0, 0], kind: "round" }, textColor: "secondary-foreground", font: "600 16px display" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 2 },
        "section/band/idle": { fill: "secondary" },
        "section/rule/idle": { stroke: "border", strokeWidth: 2 },
        "machine/event/lit": { textColor: "input", font: "600 13px mono" },
        "orbit/label/active": { textColor: "input", font: "700 18px body" },
        "text/numeral/idle": { textColor: "border", font: "700 200px display" },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "500 17px body", stroke: "input", strokeWidth: 2 },
        "textfield/default/hovered": { fill: "card", corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "500 17px body", stroke: "input", strokeWidth: 3 },
        "textfield/default/focused": { fill: "card", corners: { radius: [24, 24, 24, 24], kind: "round" }, textColor: "foreground", font: "500 17px body", stroke: "ring", strokeWidth: 4 },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "500 17px body" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_smin(a: f32, b: f32, k: f32) -> f32 { let h = clamp(0.5 + 0.5 * (b - a) / k, 0.0, 1.0); return mix(b, a, h) - k * h * (1.0 - h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet b1 = length(p - vec2<f32>(s.x * 0.3, c.y * 1.05)) - m * 0.3;\nlet b2 = length(p - vec2<f32>(s.x * 0.52, c.y * 0.9)) - m * 0.38;\nlet b3 = length(p - vec2<f32>(s.x * 0.72, c.y * 1.1)) - m * 0.26;\nlet d = sg_smin(sg_smin(b1, b2, m * 0.15), b3, m * 0.15);\nlet cov = 1.0 - smoothstep(-2.0, 2.0, d);\nlet col = px.color.rgb * (0.78 + 0.4 * (1.0 - px.uv.y)) * (0.9 + 0.1 * smoothstep(0.0, m * 0.2, -d));\nreturn sg_out(px, col, cov);\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/secondary/pressed": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 18px display", spring: { stiffness: 90, damping: 10 }, shadow: { color: "#B4B8D0", blur: 0, offsetY: 2 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "input", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "muted-foreground", font: "600 18px display" },
        "image/none/idle": { stroke: "#FFFFFF", strokeWidth: 5, corners: { radius: [44, 44, 44, 44], kind: "round" }, shadow: { color: "rgba(62,48,130,0.3)", blur: 34, offsetY: 16 } }
      }
    layout: { hero: "split", columns: 3, asymmetry: 0.1, ornament: "none", align: "center", imageTreatment: "glow", sectionGap: 96, gutter: 32 }
    motion: { signature: "squish", stiffness: 90, damping: 10, stagger: 90, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -48, scale: 1.18, rotate: 0 }, { at: 0.1, opacity: 0.376, offsetX: 0, offsetY: -29.941, scale: 1.112, rotate: 0 }, { at: 0.2, opacity: 0.648, offsetX: 0, offsetY: -16.895, scale: 1.063, rotate: 0 }, { at: 0.3, opacity: 0.832, offsetX: 0, offsetY: -8.078, scale: 1.03, rotate: 0 }, { at: 0.4, opacity: 0.945, offsetX: 0, offsetY: -2.648, scale: 1.01, rotate: 0 }, { at: 0.5, opacity: 1, offsetX: 0, offsetY: 0.232, scale: 0.999, rotate: 0 }, { at: 0.6, opacity: 1, offsetX: 0, offsetY: 1.334, scale: 0.995, rotate: 0 }, { at: 0.7, opacity: 1, offsetX: 0, offsetY: 1.341, scale: 0.995, rotate: 0 }, { at: 0.8, opacity: 1, offsetX: 0, offsetY: 0.826, scale: 0.997, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0.257, scale: 0.999, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/help-center/"
  }
}
