app std-rasm-system-signing-desk [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-signing-desk — the Signing Desk design system for a Rasm page, anchored on Legal pleading paper and the fountain pen signature line (https://en.wikipedia.org/wiki/Pleading). Colour: #E7E1D3 ground, #14213D ink, #1F4FD8 accent. Type: Cormorant over Hanken Grotesk. Grid: single sheet grid with numbered line margin (28 lines). Motion: the pen-stroke easing (cubic-bezier 0.55,0.00,0.15,1.00); entrance: the sheet slides up, then lines number in. Interaction: signature line inks in. Imagery: paper sheet on linen, no photos. Voice: formal plain English, defined terms in capitals. Components: buttons are sign-here tabs; cards are clauses with numbered margins. Data: clause count tallies. Sound: nib scratch on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "signing-desk"
    palette: {background: "#E7E1D3", foreground: "#14213D", card: "#F4F2EB", "card-foreground": "#14213D", surface: "#E1DBCF", muted: "#D6D2C7", "muted-foreground": "#585E6D", border: "#888B90", input: "#7E8188", primary: "#1F4FD8", "primary-hover": "#1A43B8", "primary-foreground": "#E7E1D3", secondary: "#F4F2EB", "secondary-foreground": "#14213D", "secondary-hover": "#CECAC1", accent: "#1F4FD8", "accent-foreground": "#E7E1D3", ring: "#1F4FD8", "series-1": "#1F4FD8", "series-2": "#1A3A92", "series-3": "#7991D6", "series-4": "#535B6A", "series-5": "#4F67AC"}
    fonts: { display: { family: "Cormorant", file: "https://almadar-kflow-assets.web.app/fonts/cormorant/Cormorant%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Hanken Grotesk", file: "https://almadar-kflow-assets.web.app/fonts/hankengrotesk/HankenGrotesk%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let p = px.local; let w = sin(p.x * 2.4) * sin(p.y * 2.4); let h = sin(p.x * 0.35 + sin(p.y * 0.9) * 0.6); let v = w * 0.012 + h * 0.008; return vec4<f32>(px.color.rgb + vec3<f32>(v), px.color.a); }", params: [0, 0, 0, 0], live: false } },
        "stack/sheet/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [2, 2, 2, 2], kind: "round" }, shadow: { color: "rgba(20,33,61,0.22)", blur: 54, offsetX: 0, offsetY: 26 }, inset: { stroke: "border", strokeWidth: 1, gap: 8 } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(20,33,61,0.12)", blur: 18, offsetX: 0, offsetY: 8 }, inset: { stroke: "muted", strokeWidth: 1, gap: 5 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(20,33,61,0.10)", blur: 14, offsetX: 0, offsetY: 6 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 5 }, spring: { stiffness: 260, damping: 30 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", inset: { stroke: "primary-foreground", strokeWidth: 2, gap: 5 }, shadow: { color: "rgba(20,33,61,0.30)", blur: 10, offsetX: 0, offsetY: 4 }, spring: { stiffness: 340, damping: 28 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", inset: { stroke: "primary-foreground", strokeWidth: 2, gap: 5 }, spring: { stiffness: 380, damping: 36 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "600 15px body", inset: { stroke: "primary-foreground", strokeWidth: 1, gap: 5 }, spring: { stiffness: 260, damping: 30 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 15px body", spring: { stiffness: 260, damping: 30 } },
        "pressable/secondary/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 15px body", inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, spring: { stiffness: 340, damping: 28 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 15px body", inset: { stroke: "primary", strokeWidth: 2, gap: 5 }, spring: { stiffness: 380, damping: 36 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "600 15px body", spring: { stiffness: 260, damping: 30 } },
        "pressable/secondary/disabled": { stroke: "border" },
        "text/display/idle": { textColor: "foreground", font: "500 88px display" },
        "text/title/idle": { textColor: "foreground", font: "600 44px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 12px body" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 26px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "foreground", font: "500 104px display" },
        "text/label/idle": { textColor: "foreground", font: "600 13px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 12px body" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "600 13px body", on: "section/band/idle" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "accent" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "muted", strokeWidth: 1, gap: 5 }, shadow: { color: "rgba(20,33,61,0.10)", blur: 14, offsetX: 0, offsetY: 6 }, spring: { stiffness: 260, damping: 30 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "primary", strokeWidth: 1, gap: 5 }, shadow: { color: "rgba(20,33,61,0.16)", blur: 20, offsetX: 0, offsetY: 9 }, spring: { stiffness: 260, damping: 30 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 260, damping: 30 } },
        "card/surface/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 380, damping: 36 } },
        "card/header/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 12px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [1, 3] },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 12px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, shadow: { color: "rgba(20,33,61,0.10)", blur: 14, offsetX: 0, offsetY: 6 } },
        "panel/header/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "600 12px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [1, 3] },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1, strokeDash: [1, 4] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "material/flag/idle": { fill: "primary", corners: { radius: [0, 8, 8, 0], kind: "round" }, shadow: { color: "rgba(20,33,61,0.28)", blur: 10, offsetX: 0, offsetY: 4 } },
        "material/initials/idle": { fill: "card", stroke: "accent", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "accent", strokeWidth: 1, gap: 4 } },
        "material/stamp/idle": { stroke: "primary", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "primary", strokeWidth: 1, gap: 4 } },
        "textfield/default/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 260, damping: 30 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 260, damping: 30 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body", spring: { stiffness: 260, damping: 30 } }
      }
    layout: { hero: "editorial", columns: 12, asymmetry: 0.06, ornament: "double-rule", align: "start", imageTreatment: "none", sectionGap: 88, gutter: 28 }
    motion: { signature: "pen-stroke", stiffness: 260, damping: 30, stagger: 90, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 44, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.013, offsetX: 0, offsetY: 43.414, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.069, offsetX: 0, offsetY: 40.983, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.221, offsetX: 0, offsetY: 34.276, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.54, offsetX: 0, offsetY: 20.223, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.765, offsetX: 0, offsetY: 10.353, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.879, offsetX: 0, offsetY: 5.344, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.942, offsetX: 0, offsetY: 2.556, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.977, offsetX: 0, offsetY: 0.997, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.995, offsetX: 0, offsetY: 0.223, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/contract/"
  }
}
