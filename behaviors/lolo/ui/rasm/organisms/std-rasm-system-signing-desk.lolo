app std-rasm-system-signing-desk [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-signing-desk — the Signing Desk design system for a Rasm page, anchored on Legal pleading paper and the fountain pen signature line (https://en.wikipedia.org/wiki/Pleading). Colour: #E7E1D3 ground, #14213D ink, #1F4FD8 accent. Type: Cormorant over Hanken Grotesk. Grid: single sheet grid with numbered line margin (28 lines). Motion: the pen-stroke easing (cubic-bezier 0.55,0.00,0.15,1.00); entrance: the sheet slides up, then lines number in. Interaction: signature line inks in. Imagery: paper sheet on linen, no photos. Voice: formal plain English, defined terms in capitals. Components: buttons are sign-here tabs; cards are clauses with numbered margins. Data: clause count tallies. Sound: nib scratch on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "signing-desk"
    palette: {background: "#E7E1D3", foreground: "#14213D", card: "#F4F2EB", "card-foreground": "#14213D", surface: "#E1DBCF", muted: "#D6D2C7", "muted-foreground": "#585E6D", border: "#888B90", input: "#7E8188", primary: "#1F4FD8", "primary-hover": "#1A43B8", "primary-foreground": "#E7E1D3", secondary: "#F4F2EB", "secondary-foreground": "#14213D", "secondary-hover": "#CECAC1", accent: "#1F4FD8", "accent-foreground": "#E7E1D3", ring: "#1F4FD8", "series-1": "#1F4FD8", "series-2": "#1A3A92", "series-3": "#7991D6", "series-4": "#535B6A", "series-5": "#4F67AC"}
    fonts: { display: { family: "Cormorant", file: "https://almadar-kflow-assets.web.app/fonts/cormorant/Cormorant%5Bwght%5D.ttf", generic: "serif" }, body: { family: "Hanken Grotesk", file: "https://almadar-kflow-assets.web.app/fonts/hankengrotesk/HankenGrotesk%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/sheet/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, shadow: { color: "rgba(22,32,46,0.20)", blur: 48, offsetX: 0, offsetY: 22 } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(22,32,46,0.16)", blur: 28, offsetX: 0, offsetY: 12 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(22,32,46,0.14)", blur: 20, offsetX: 0, offsetY: 8 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", shadow: { color: "rgba(190,52,24,0.35)", blur: 18, offsetX: 0, offsetY: 8 }, spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", shadow: { color: "rgba(190,52,24,0.45)", blur: 26, offsetX: 0, offsetY: 12 }, spring: { stiffness: 420, damping: 34 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 520, damping: 40 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "primary-foreground", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 16px body", shadow: { color: "rgba(22,32,46,0.14)", blur: 14, offsetX: 0, offsetY: 6 }, spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 16px body", shadow: { color: "rgba(22,32,46,0.2)", blur: 20, offsetX: 0, offsetY: 8 }, spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 520, damping: 40 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "600 16px body", spring: { stiffness: 420, damping: 34 } },
        "pressable/secondary/disabled": { stroke: "border" },
        "text/display/idle": { textColor: "foreground", font: "800 92px display" },
        "text/title/idle": { textColor: "foreground", font: "700 44px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 13px mono" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "700 26px display" },
        "text/numeral/idle": { textColor: "foreground", font: "800 96px display" },
        "text/label/idle": { textColor: "foreground", font: "600 14px mono" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px mono" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "600 14px mono", on: "section/band/idle" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "accent" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(22,32,46,0.14)", blur: 24, offsetX: 0, offsetY: 10 }, spring: { stiffness: 420, damping: 34 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(22,32,46,0.22)", blur: 34, offsetX: 0, offsetY: 16 }, spring: { stiffness: 420, damping: 34 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [12, 12, 12, 12], kind: "round" }, spring: { stiffness: 420, damping: 34 } },
        "card/surface/pressed": { fill: "muted", stroke: "primary", strokeWidth: 1.5, corners: { radius: [12, 12, 12, 12], kind: "round" }, spring: { stiffness: 520, damping: 40 } },
        "card/header/idle": { fill: "muted", corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [8, 8, 8, 8], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 13px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [12, 12, 12, 12], kind: "round" }, shadow: { color: "rgba(22,32,46,0.14)", blur: 24, offsetX: 0, offsetY: 10 } },
        "panel/header/idle": { fill: "muted", corners: { radius: [12, 12, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px mono", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 1.5 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "material/flag/idle": { fill: "primary", corners: { radius: [6, 0, 0, 6], kind: "round" }, shadow: { color: "rgba(190,52,24,0.35)", blur: 14, offsetX: 0, offsetY: 6 } },
        "material/initials/idle": { fill: "muted", stroke: "accent", strokeWidth: 2, corners: { radius: [12, 12, 12, 12], kind: "round" } },
        "material/stamp/idle": { stroke: "primary", strokeWidth: 5, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "textfield/default/idle": { fill: "card", stroke: "border", strokeWidth: 1.5, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px mono", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px mono", spring: { stiffness: 420, damping: 34 } },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px mono", spring: { stiffness: 420, damping: 34 } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.1, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 32 }
    motion: { signature: "pen-stroke", stiffness: 260, damping: 30, stagger: 80, enterMs: 1350, keyframes: [{ at: 0, opacity: 0, offsetX: 32, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.013, offsetX: 31.574, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.069, offsetX: 29.806, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.221, offsetX: 24.928, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.54, offsetX: 14.707, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.765, offsetX: 7.529, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.879, offsetX: 3.887, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.942, offsetX: 1.859, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.977, offsetX: 0.725, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.995, offsetX: 0.162, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/contract/"
  }
}
