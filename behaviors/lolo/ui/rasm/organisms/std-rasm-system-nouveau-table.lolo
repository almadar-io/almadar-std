app std-rasm-system-nouveau-table [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-nouveau-table — the Nouveau Table design system for a Rasm page, anchored on Hector Guimard's Paris Metro entrances and Alphonse Mucha posters (https://en.wikipedia.org/wiki/Hector_Guimard). Colour: #16302B ground, #F2E6CF ink, #D98E04 accent. Type: Federo over Crimson Pro. Grid: arched window grid with whiplash curves. Motion: the whiplash easing (cubic-bezier 0.68,-0.30,0.32,1.30); entrance: slides unveil through arched masks. Interaction: vine curl frames the item. Imagery: ornamental plant forms and food photography. Voice: sensual, seasonal, ingredient-led. Components: buttons are arch-topped; cards are scooped frames. Data: none: menu prices only. Sound: glass clink on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "nouveau-table"
    palette: {background: "#16302B", foreground: "#F2E6CF", card: "#233B35", "card-foreground": "#F2E6CF", surface: "#1D3530", muted: "#283F38", "muted-foreground": "#ACAC9B", border: "#798275", input: "#848B7D", primary: "#D98E04", "primary-hover": "#DF9F2A", "primary-foreground": "#16302B", secondary: "#233B35", "secondary-foreground": "#F2E6CF", "secondary-hover": "#30463F", accent: "#D98E04", "accent-foreground": "#16302B", ring: "#D98E04", "series-1": "#D98E04", "series-2": "#E4B65F", "series-3": "#816416", "series-4": "#B0AF9E", "series-5": "#AC8742"}
    fonts: { display: { family: "Federo", file: "https://almadar-kflow-assets.web.app/fonts/federo/Federo-Regular.ttf", generic: "serif" }, body: { family: "Crimson Pro", file: "https://almadar-kflow-assets.web.app/fonts/crimsonpro/CrimsonPro%5Bwght%5D.ttf", generic: "serif" } }
    looks: {
                "surface/ground/idle": { fill: "background", material: { wgsl: "fn an_h(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(127.1, 311.7))) * 43758.5453); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let sage = vec3<f32>(0.42, 0.52, 0.36);\n  let gold = vec3<f32>(0.74, 0.58, 0.26);\n  let t = px.time * 0.04;\n  let u = px.uv;\n  let w1 = u.y * 7.0 + sin(u.x * 3.2 + t) * 0.9 + sin(u.x * 8.0 - t * 2.0) * 0.18 + px.scroll * 1.5;\n  let w2 = u.y * 5.0 + sin(u.x * 2.4 - t * 1.3 + 1.7) * 1.2 + cos(u.x * 5.5 + t) * 0.25;\n  let l1 = 1.0 - smoothstep(0.0, 0.035, abs(fract(w1) - 0.5) - 0.44);\n  let l2 = 1.0 - smoothstep(0.0, 0.03, abs(fract(w2) - 0.5) - 0.46);\n  let ex = abs(u.x - 0.5) * 2.0;\n  let arch = 1.0 - smoothstep(0.0, 0.012, abs(ex - 0.94 + 0.10 * pow(u.y, 2.0) * 0.0 - 0.5 * pow(1.0 - u.y, 3.0) * 0.1));\n  let edge = smoothstep(0.55, 1.0, ex);\n  var col = px.color.rgb;\n  col = mix(col, sage, l1 * 0.10 * (0.4 + edge));\n  col = mix(col, gold, l2 * 0.09 * (0.4 + edge));\n  col = mix(col, gold, arch * 0.20);\n  let n = an_h(floor(px.local / 2.0)) - 0.5;\n  col = col + n * 0.012;\n  return vec4<f32>(col, 1.0);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(0,0,0,0.30)", blur: 24, offsetX: 0, offsetY: 10 } },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(0,0,0,0.30)", blur: 24, offsetX: 0, offsetY: 10 }, spring: { stiffness: 90, damping: 16 } },
        "card/surface/hovered": { fill: "card", stroke: "accent", strokeWidth: 3, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(217,142,4,0.38)", blur: 34, offsetX: 0, offsetY: 0 }, spring: { stiffness: 90, damping: 16 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(0,0,0,0.30)", blur: 24, offsetX: 0, offsetY: 10 }, spring: { stiffness: 90, damping: 16 } },
        "card/surface/pressed": { fill: "muted", stroke: "accent", strokeWidth: 2, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(217,142,4,0.38)", blur: 10, offsetX: 0, offsetY: 0 }, spring: { stiffness: 90, damping: 16 } },
        "card/header/idle": { fill: "muted", corners: { radius: [46, 46, 0, 0], kind: "scoop" }, textColor: "foreground", font: "500 14px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "accent", strokeWidth: 1, strokeDash: [1, 5] },
        "card/media/idle": { fill: "muted", corners: { radius: [46, 46, 0, 0], kind: "scoop" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(0,0,0,0.30)", blur: 24, offsetX: 0, offsetY: 10 } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [46, 46, 0, 0], kind: "scoop" }, textColor: "foreground", font: "500 14px body", on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "accent", strokeWidth: 1, strokeDash: [1, 5] },
        "section/band/idle": { fill: "card" },
        "section/rule/idle": { stroke: "accent", strokeWidth: 1.5 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [46, 46, 12, 12], kind: "scoop" }, shadow: { color: "rgba(0,0,0,0.30)", blur: 24, offsetX: 0, offsetY: 10 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "accent", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "accent", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 }, shadow: { color: "rgba(217,142,4,0.38)", blur: 26, offsetX: 0, offsetY: 0 } },
        "pressable/primary/pressed": { fill: "primary-hover", stroke: "primary", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 3, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "primary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 } },
        "pressable/secondary/idle": { fill: "card", stroke: "border", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "accent", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 }, shadow: { color: "rgba(217,142,4,0.38)", blur: 26, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 } },
        "text/display/idle": { textColor: "foreground", font: "400 64px display" },
        "text/title/idle": { textColor: "foreground", font: "400 34px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "500 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 19px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 24px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent", stroke: "primary", strokeWidth: 2 },
                "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet k = 0.018;\nlet x = p.x;\nlet y1 = c.y + sin(x * k) * m * 0.28 + sin(x * k * 2.3 + 1.0) * m * 0.08;\nlet y2 = c.y + sin(x * k + 3.14159) * m * 0.28 + sin(x * k * 2.3 + 4.1) * m * 0.08;\nlet t = 0.5 + 0.5 * sin(x * 0.011);\nlet a = max(sg_line(p.y - y1, 0.8 + 2.6 * t), sg_line(p.y - y2, 0.8 + 2.6 * (1.0 - t)));\nreturn sg_out(px, px.color.rgb, a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "pressable/secondary/pressed": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "secondary-foreground", font: "500 17px body", spring: { stiffness: 90, damping: 16 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [30, 30, 6, 6], kind: "scoop" }, textColor: "muted-foreground", font: "500 17px body" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 2, corners: { radius: [20, 20, 6, 6], kind: "scoop" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [20, 20, 6, 6], kind: "scoop" }, textColor: "foreground", font: "400 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [20, 20, 6, 6], kind: "scoop" }, textColor: "foreground", font: "400 17px body" }
      }
    layout: { hero: "poster", columns: 5, asymmetry: 0.2, ornament: "frame", align: "center", imageTreatment: "none", sectionGap: 128, gutter: 48 }
    motion: { signature: "whiplash", stiffness: 90, damping: 14, stagger: 120, enterMs: 1200, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 52, scale: 0.93, rotate: 0 }, { at: 0.1, opacity: 0, offsetX: 0, offsetY: 53.681, scale: 0.928, rotate: 0 }, { at: 0.2, opacity: 0, offsetX: 0, offsetY: 53.727, scale: 0.928, rotate: 0 }, { at: 0.3, opacity: 0.018, offsetX: 0, offsetY: 51.077, scale: 0.931, rotate: 0 }, { at: 0.4, opacity: 0.168, offsetX: 0, offsetY: 43.276, scale: 0.942, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 26, scale: 0.965, rotate: 0 }, { at: 0.6, opacity: 0.832, offsetX: 0, offsetY: 8.724, scale: 0.988, rotate: 0 }, { at: 0.7, opacity: 0.982, offsetX: 0, offsetY: 0.923, scale: 0.999, rotate: 0 }, { at: 0.8, opacity: 1, offsetX: 0, offsetY: -1.727, scale: 1.002, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: -1.681, scale: 1.002, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/restaurant/"
  }
}
