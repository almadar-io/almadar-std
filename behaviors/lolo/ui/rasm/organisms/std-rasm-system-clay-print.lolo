app std-rasm-system-clay-print [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-clay-print — the Clay Print design system for a Rasm page: soft clay forms printed in two riso inks on warm newsprint, anchored on Risograph children's picture books and the clay figures of stop-motion (https://en.wikipedia.org/wiki/Risograph). Colour: #F7F0E3 paper ground, #1F1D2B ink, #FF5B3A riso tomato with #2F5BEA riso blue. Type: Unbounded over Varela Round. Grid: a centred 7-column page whose blocks sit slightly off register. Motion: the orbit-plop easing (cubic-bezier 0.34,1.56,0.64,1.00); entrance: shapes plop down like wet clay, squash and settle with a small turn. Interaction: a card lifts off its printed shadow; a press stamps it flat. Imagery: halftone dots. Voice: warm, curious, a friend explaining a toy. Components: buttons are inked clay pills on a hard offset shadow; cards are clay tiles outlined in ink. Data: chunky ink bars. Sound: a soft clay pop on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "clay-print"
    palette: {background: "#F7F0E3", foreground: "#1F1D2B", card: "#FFFBF3", "card-foreground": "#1F1D2B", surface: "#F0E6D3", muted: "#E7DCC7", "muted-foreground": "#55505F", border: "#1F1D2B", input: "#1F1D2B", primary: "#FF5B3A", "primary-hover": "#F24C2B", "primary-foreground": "#1F1D2B", secondary: "#FFFBF3", "secondary-foreground": "#1F1D2B", "secondary-hover": "#F3E7D2", accent: "#2F5BEA", "accent-foreground": "#FFFBF3", ring: "#2F5BEA", "series-1": "#FF5B3A", "series-2": "#2F5BEA", "series-3": "#FFC93C", "series-4": "#2BB58C", "series-5": "#B45CE0"}
    fonts: { display: { family: "Unbounded", file: "https://almadar-kflow-assets.web.app/fonts/unbounded/Unbounded%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Varela Round", file: "https://almadar-kflow-assets.web.app/fonts/varelaround/VarelaRound-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn cp_blob(p: vec2<f32>, c: vec2<f32>, r: f32) -> f32 { return r - length(p - c); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let asp = px.size.x / max(px.size.y, 1.0);\n  let p = px.uv * vec2<f32>(asp, 1.0);\n  let t = px.time * 0.18;\n  let y = px.scroll * 0.15;\n  var col = px.color.rgb;\n  let b1 = cp_blob(p, vec2<f32>(0.12 * asp, 0.22 + sin(t) * 0.02 - y), 0.17);\n  let b2 = cp_blob(p, vec2<f32>(0.9 * asp, 0.7 + sin(t * 0.7 + 2.0) * 0.03 - y), 0.22);\n  col = mix(col, vec3<f32>(1.0, 0.36, 0.23), smoothstep(-0.004, 0.004, b1) * 0.1);\n  col = mix(col, vec3<f32>(0.18, 0.36, 0.92), smoothstep(-0.004, 0.004, cp_blob(p, vec2<f32>(0.9 * asp + 0.006, 0.7 + sin(t * 0.7 + 2.0) * 0.03 - y + 0.004), 0.22)) * 0.09);\n  let cell = px.local / 9.0;\n  let g = fract(cell) - vec2<f32>(0.5, 0.5);\n  let hd = 1.0 - smoothstep(0.1, 0.16, length(g));\n  col = col - vec3<f32>(0.06, 0.06, 0.05) * hd * 0.35;\n  let grain = fract(sin(dot(floor(px.local), vec2<f32>(12.9898, 78.233))) * 43758.5453);\n  col = col - vec3<f32>(grain * 0.025);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 120, damping: 11 } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 120, damping: 11 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 2.5, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/tomato/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 } },
        "stack/blue/idle": { fill: "accent", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 } },
        "pressable/primary/idle": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px display", spring: { stiffness: 120, damping: 11 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 4, offsetY: 5 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px display", spring: { stiffness: 120, damping: 11 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 6, offsetY: 8 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px display", spring: { stiffness: 160, damping: 12 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 1, offsetY: 1 } },
        "pressable/primary/focused": { fill: "primary", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 17px display", spring: { stiffness: 120, damping: 11 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 4, offsetY: 5 } },
        "pressable/secondary/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 16px display", spring: { stiffness: 120, damping: 11 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 3, offsetY: 4 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 16px display", spring: { stiffness: 120, damping: 11 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 } },
        "pressable/secondary/pressed": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 16px display", spring: { stiffness: 160, damping: 12 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 1, offsetY: 1 } },
        "pressable/secondary/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "secondary-foreground", font: "600 16px display", spring: { stiffness: 120, damping: 11 }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 3, offsetY: 4 } },
        "pressable/secondary/disabled": { fill: "muted", stroke: "muted-foreground", strokeWidth: 2, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "muted-foreground", font: "600 16px display" },
        "pressable/ghost/idle": { textColor: "foreground", font: "600 15px display", corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "pressable/ghost/hovered": { fill: "muted", textColor: "foreground", font: "600 15px display", corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "pressable/ghost/focused": { stroke: "ring", strokeWidth: 3, textColor: "foreground", font: "600 15px display", corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "pressable/ghost/pressed": { fill: "muted", textColor: "foreground", font: "600 15px display", corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "text/display/idle": { textColor: "foreground", font: "800 72px display", spring: { stiffness: 120, damping: 11 } },
        "text/title/idle": { textColor: "foreground", font: "700 40px display", spring: { stiffness: 120, damping: 11 } },
        "text/eyebrow/idle": { textColor: "accent", font: "700 14px display", spring: { stiffness: 120, damping: 11 } },
        "text/body/idle": { textColor: "muted-foreground", font: "400 19px body", spring: { stiffness: 120, damping: 11 } },
        "text/card/idle": { textColor: "card-foreground", font: "700 22px display" },
        "text/numeral/idle": { textColor: "primary", font: "800 180px display" },
        "icon/accent/idle": { on: "surface/ground/idle", textColor: "foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 }, spring: { stiffness: 120, damping: 11 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 8, offsetY: 10 }, spring: { stiffness: 120, damping: 11 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 8, offsetY: 10 }, spring: { stiffness: 120, damping: 11 } },
        "card/surface/pressed": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 160, damping: 12 } },
        "card/header/idle": { fill: "accent", corners: { radius: [24, 24, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "700 14px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 2 },
        "card/media/idle": { fill: "surface", corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 } },
        "panel/header/idle": { fill: "secondary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 0, 0], kind: "round" }, textColor: "secondary-foreground", font: "700 15px display" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 2 },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "border", strokeWidth: 2.5, strokeDash: [2, 8] },
        "machine/state/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "foreground", font: "700 14px display", shadow: { color: "#1F1D2B", blur: 0, offsetX: 3, offsetY: 4 } },
        "machine/state/active": { fill: "primary", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [999, 999, 999, 999], kind: "round" }, textColor: "primary-foreground", font: "700 14px display", shadow: { color: "#1F1D2B", blur: 0, offsetX: 3, offsetY: 4 } },
        "machine/edge/idle": { stroke: "foreground", strokeWidth: 2.5 },
        "machine/edge/lit": { stroke: "accent", strokeWidth: 3.5 },
        "machine/event/idle": { textColor: "muted-foreground", font: "400 13px mono" },
        "machine/event/lit": { textColor: "accent", font: "700 13px mono" },
        "orbit/label/active": { textColor: "accent", font: "700 18px display" },
        "source/code/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [22, 22, 22, 22], kind: "round" }, textColor: "foreground", font: "400 14px mono", shadow: { color: "#1F1D2B", blur: 0, offsetX: 4, offsetY: 5 } },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "textfield/default/idle": { fill: "card", corners: { radius: [18, 18, 18, 18], kind: "round" }, textColor: "foreground", font: "400 17px body", stroke: "input", strokeWidth: 2.5 },
        "textfield/default/hovered": { fill: "card", corners: { radius: [18, 18, 18, 18], kind: "round" }, textColor: "foreground", font: "400 17px body", stroke: "input", strokeWidth: 3 },
        "textfield/default/focused": { fill: "card", corners: { radius: [18, 18, 18, 18], kind: "round" }, textColor: "foreground", font: "400 17px body", stroke: "ring", strokeWidth: 4 },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "400 17px body" },
        "morph/default/idle": { fill: "primary" },
        "image/none/idle": { stroke: "foreground", strokeWidth: 2.5, corners: { radius: [26, 26, 26, 26], kind: "round" }, shadow: { color: "#1F1D2B", blur: 0, offsetX: 5, offsetY: 6 } }
      }
    systemBreakpointLooks: {
        phone: {
          "text/display/idle": { textColor: "foreground", font: "800 40px display" },
          "text/title/idle": { textColor: "foreground", font: "700 28px display" },
          "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" },
          "text/numeral/idle": { textColor: "primary", font: "800 96px display" }
        },
        tablet: {
          "text/display/idle": { textColor: "foreground", font: "800 56px display" },
          "text/title/idle": { textColor: "foreground", font: "700 34px display" }
        }
      }
    layout: { hero: "centered", columns: 7, asymmetry: 0.06, ornament: "stamp", align: "center", imageTreatment: "halftone", sectionGap: 128, gutter: 28 }
    motion: { signature: "orbit-plop", stiffness: 120, damping: 11, stagger: 80, enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -40, scale: 0.6, rotate: -6 }, { at: 0.35, opacity: 1, offsetX: 0, offsetY: 6, scale: 1.12, rotate: 2 }, { at: 0.55, opacity: 1, offsetX: 0, offsetY: -3, scale: 0.94, rotate: -1 }, { at: 0.75, opacity: 1, offsetX: 0, offsetY: 1, scale: 1.03, rotate: 0.5 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
  }
}
