app std-rasm-system-container-stencil [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-container-stencil — the Container Stencil design system for a Rasm page, anchored on Maersk containers and freight stencil marking (https://en.wikipedia.org/wiki/Intermodal_container). Colour: #1F3A4D ground, #F0F0EB ink, #F28C28 accent. Type: Saira Stencil One over Chivo. Grid: corrugated vertical timeline with container slots. Motion: the freight easing (cubic-bezier 0.40,0.00,0.90,1.00); entrance: containers stack along the timeline. Interaction: stencil paint brightens. Imagery: corrugated steel and stencils. Voice: logistical, timestamped, status words. Components: buttons are stencilled plates; cards are container doors. Data: timeline with milestone markers. Sound: container clang on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "container-stencil"
    palette: { background: "#1F3A4D", foreground: "#F0F0EB", card: "#29495E", "card-foreground": "#F0F0EB", surface: "#234156", muted: "#34546A", "muted-foreground": "#C3CCCF", border: "#8FA1AD", input: "#97A8B3", primary: "#F28C28", "primary-hover": "#F8A650", "primary-foreground": "#10202B", secondary: "#29495E", "secondary-foreground": "#F0F0EB", "secondary-hover": "#37586F", accent: "#F28C28", "accent-foreground": "#10202B", ring: "#F28C28", "series-1": "#F28C28", "series-2": "#C8553A", "series-3": "#D3C6A0", "series-4": "#4FA39B", "series-5": "#8FA6B5" }
    fonts: { display: { family: "Saira Stencil One", file: "https://almadar-kflow-assets.web.app/fonts/sairastencilone/SairaStencilOne-Regular.ttf", generic: "sans-serif" }, body: { family: "Chivo", file: "https://almadar-kflow-assets.web.app/fonts/chivo/Chivo%5Bwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Chivo", file: "https://almadar-kflow-assets.web.app/fonts/chivo/Chivo%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let rib = 0.5 + 0.5 * cos(p.x * 0.5236);\n  let wear = fract(sin(dot(floor(p / vec2<f32>(3.0, 40.0)), vec2<f32>(12.9, 78.2))) * 43758.5);\n  let k = 0.9 + 0.12 * rib - 0.025 * wear;\n  let seam = 1.0 - smoothstep(0.5, 2.0, abs(fract(p.y / 480.0) * 480.0 - 2.0));\n  return vec4<f32>(px.color.rgb * k * (1.0 - seam * 0.3), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "stack/plan/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "stack/closing/idle": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "stack/hero/idle": { fill: "surface", stroke: "border", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 8 } },
        "stack/bar/idle": { fill: "surface", stroke: "border", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "primary", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "card/surface/pressed": { fill: "surface", stroke: "primary", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.4)", blur: 4, offsetX: 0, offsetY: 2 }, spring: { stiffness: 120, damping: 26 } },
        "card/header/idle": { fill: "muted", textColor: "foreground", font: "400 24px display", corners: { radius: [3, 3, 0, 0], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 2 },
        "card/media/idle": { fill: "surface", stroke: "border", strokeWidth: 2, corners: { radius: [3, 3, 0, 0], kind: "round" }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "card/meta/idle": { textColor: "muted-foreground", font: "600 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 2.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, inset: { stroke: "border", strokeWidth: 1.5, gap: 6 }, material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, shadow: { color: "rgba(5,14,20,0.55)", blur: 14, offsetX: 0, offsetY: 8 }, spring: { stiffness: 120, damping: 26 } },
        "panel/header/idle": { fill: "muted", stroke: "border", strokeWidth: 2, corners: { radius: [3, 3, 0, 0], kind: "round" }, textColor: "foreground", font: "400 22px display", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false }, on: "panel/header/idle" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 2 },
        "section/band/idle": { fill: "surface", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let rib = 0.5 + 0.5 * cos(px.local.x * 0.5236);\n  return vec4<f32>(px.color.rgb * (0.95 + 0.07 * rib), px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "section/rule/idle": { stroke: "border", strokeWidth: 3, strokeDash: [18, 6] },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1.5, strokeDash: [18, 6] },
        "grid/border/idle": { stroke: "border", strokeWidth: 2.5, fill: "" },
        "focus/ring/outer": { stroke: "background", strokeWidth: 8 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "primary-foreground", strokeWidth: 2, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "primary-foreground", strokeWidth: 2, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "primary-foreground", strokeWidth: 3, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/primary/focused": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "primary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/secondary/idle": { fill: "background", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "secondary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "primary", strokeWidth: 2.5, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "secondary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "primary", strokeWidth: 3, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "secondary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/secondary/focused": { fill: "background", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "secondary-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "muted-foreground", strokeWidth: 2, corners: { radius: [9, 9, 9, 9], kind: "notch" }, inset: { stroke: "muted-foreground", strokeWidth: 1.5, gap: 4 }, font: "400 22px display", spring: { stiffness: 120, damping: 26 }, strokeDash: [10, 5] },
        "text/display/idle": { textColor: "foreground", font: "400 104px display" },
        "text/title/idle": { textColor: "foreground", font: "400 52px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 24px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "primary", font: "400 180px display" },
        "text/label/idle": { textColor: "primary", font: "700 14px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "600 13px body" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "400 22px display", on: "pressable/primary/idle" },
        "text/plan/idle": { textColor: "foreground", font: "600 14px body", on: "stack/plan/idle" },
        "textfield/default/idle": { fill: "surface", stroke: "input", strokeWidth: 2, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "textfield/default/focused": { fill: "surface", stroke: "ring", strokeWidth: 3, corners: { radius: [3, 3, 3, 3], kind: "round" }, textColor: "foreground", font: "500 17px body" },
        "morph/default/idle": { stroke: "primary", strokeWidth: 4 },
        "morph/route/idle": { stroke: "primary", strokeWidth: 10 },
        "morph/aisle/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3 },
        "morph/wall/idle": { stroke: "foreground", strokeWidth: 6 },
        "pulse/default/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "600 13px body" },
        "pulse/pin/idle": { fill: "foreground", stroke: "foreground", textColor: "foreground", font: "600 13px body" },
        "pulse/hot/idle": { fill: "primary", stroke: "foreground", textColor: "foreground", font: "700 13px body" },
        "pulse/route/idle": { fill: "primary", stroke: "foreground", textColor: "foreground", font: "700 13px body" },
        "pulse/link/idle": { stroke: "border", strokeWidth: 2 },
        "material/door/idle": { fill: "series-1", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [3, 3, 3, 3], kind: "round" }, material: { wgsl: "fn bx(p: vec2<f32>, lo: vec2<f32>, hi: vec2<f32>) -> f32 { let a = step(lo, p) * step(p, hi); return a.x * a.y; }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let s = px.size;\n  let rib = 0.5 + 0.5 * cos(p.x * 0.5236);\n  var col = px.color.rgb * (0.82 + 0.2 * rib);\n  let frame = 1.0 - bx(p, vec2<f32>(12.0, 12.0), s - vec2<f32>(12.0, 12.0));\n  col = mix(col, px.color.rgb * 0.62, frame);\n  let seam = 1.0 - smoothstep(0.5, 2.0, abs(p.x - s.x * 0.5));\n  col = mix(col, vec3<f32>(0.04, 0.07, 0.09), seam * 0.8);\n  let b1 = bx(p, vec2<f32>(s.x * 0.25 - 4.0, 18.0), vec2<f32>(s.x * 0.25 + 4.0, s.y - 18.0));\n  let b2 = bx(p, vec2<f32>(s.x * 0.75 - 4.0, 18.0), vec2<f32>(s.x * 0.75 + 4.0, s.y - 18.0));\n  col = mix(col, vec3<f32>(0.72, 0.74, 0.75), max(b1, b2) * 0.9);\n  let h1 = bx(p, vec2<f32>(s.x * 0.25 - 9.0, s.y * 0.5 - 7.0), vec2<f32>(s.x * 0.25 + 9.0, s.y * 0.5 + 7.0));\n  let h2 = bx(p, vec2<f32>(s.x * 0.75 - 9.0, s.y * 0.5 - 7.0), vec2<f32>(s.x * 0.75 + 9.0, s.y * 0.5 + 7.0));\n  col = mix(col, vec3<f32>(0.2, 0.22, 0.24), max(h1, h2));\n  let cx = fract((p.x - s.x * 0.08) / 22.0) * 22.0;\n  let st = bx(vec2<f32>(p.x, p.y), vec2<f32>(s.x * 0.08, s.y * 0.12), vec2<f32>(s.x * 0.44, s.y * 0.22)) * step(cx, 16.0);\n  let bridge = 1.0 - bx(p, vec2<f32>(0.0, s.y * 0.165), vec2<f32>(s.x, s.y * 0.175));\n  col = mix(col, vec3<f32>(0.94, 0.94, 0.92), st * bridge * 0.95);\n  let rv = 1.0 - smoothstep(2.0, 3.5, length(fract(p / 36.0) * 36.0 - vec2<f32>(18.0, 18.0)));\n  col = mix(col, px.color.rgb * 1.2, rv * frame * 0.5);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.15, ornament: "stamp", align: "start", imageTreatment: "grain", sectionGap: 72, gutter: 24 }
    motion: { signature: "freight", stiffness: 120, damping: 26, stagger: 160, enterMs: 760, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: -56, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.019, offsetX: 0, offsetY: -54.935, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.07, offsetX: 0, offsetY: -52.073, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.147, offsetX: 0, offsetY: -47.792, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.243, offsetX: 0, offsetY: -42.368, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.357, offsetX: 0, offsetY: -36.019, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.483, offsetX: 0, offsetY: -28.929, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.62, offsetX: 0, offsetY: -21.287, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.762, offsetX: 0, offsetY: -13.334, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.901, offsetX: 0, offsetY: -5.526, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/shipment-tracking/"
  }
}
