app std-rasm-system-rams-device [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-rams-device — the Rams Device design system for a Rasm page, anchored on Dieter Rams for Braun (ET66 calculator, SK4) (https://en.wikipedia.org/wiki/Dieter_Rams). Colour: #E9E8E4 ground, #222222 ink, #E85D1A accent. Type: Albert Sans over Onest. Grid: instrument grid of round controls on a plate. Motion: the detent easing (cubic-bezier 0.50,0.00,0.10,1.00); entrance: sections slide up like a tray with a detent. Interaction: control depresses 1px. Imagery: product-like objects, no photos. Voice: less but better, short honest claims. Components: buttons are round keys with a coloured function key; cards are plates. Data: segmented meter bars. Sound: switch detent on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "rams-device"
    palette: {background: "#E9E8E4", foreground: "#222222", card: "#F5F5F3", "card-foreground": "#222222", surface: "#E3E2DE", muted: "#D4D3CF", "muted-foreground": "#585755", border: "#807F7D", input: "#7A7977", primary: "#E85D1A", "primary-hover": "#F27F44", "primary-foreground": "#222222", secondary: "#F5F5F3", "secondary-foreground": "#222222", "secondary-hover": "#D9D8D4", accent: "#E85D1A", "accent-foreground": "#222222", ring: "#B8430C", "series-1": "#E85D1A", "series-2": "#222222", "series-3": "#E89C75", "series-4": "#5E5D5C", "series-5": "#9A9895"}
    fonts: { display: { family: "Albert Sans", file: "https://almadar-kflow-assets.web.app/fonts/albertsans/AlbertSans%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Onest", file: "https://almadar-kflow-assets.web.app/fonts/onest/Onest%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let gl = px.local - vec2<f32>(0.0, px.scroll * 0.0);\n  let q = fract(gl / 10.0) - vec2<f32>(0.5, 0.5);\n  let dotm = 1.0 - smoothstep(1.1, 1.9, length(q) * 10.0);\n  let zone = smoothstep(0.0, 0.3, px.uv.x) * (1.0 - smoothstep(0.7, 1.0, px.uv.x));\n  let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114));\n  let ink = select(1.0, -1.0, l > 0.5);\n  let col = px.color.rgb - vec3<f32>(ink * dotm * 0.035 * (1.0 - zone * 0.6));\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "material/device/idle": { fill: "card", material: { wgsl: "fn dv_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn dv_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let s = px.size;\n  let m = min(s.x, s.y);\n  let ink = vec3<f32>(0.133, 0.133, 0.133);\n  let org = vec3<f32>(0.91, 0.365, 0.102);\n  let q = abs(p - s * 0.5) - s * 0.5 + vec2<f32>(10.0, 10.0);\n  let dp = length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - 10.0;\n  var col = vec3<f32>(0.93, 0.93, 0.91);\n  col = mix(col, ink, 1.0 - smoothstep(0.5, 1.5, abs(dp + 1.0)));\n  let c = vec2<f32>(s.x * 0.5, s.y * 0.43);\n  let d = p - c;\n  let r = length(d);\n  let rad = m * 0.3;\n  col = mix(col, ink, dv_fill(r - rad));\n  col = mix(col, vec3<f32>(0.2, 0.2, 0.2), dv_fill(r - rad * 0.8));\n  var u = atan2(d.y, d.x) - 2.356;\n  if (u < 0.0) { u = u + 6.2832; }\n  let arc = step(u, 4.712);\n  let tk = 1.0 - smoothstep(0.03, 0.08, abs(fract(u / 0.2356 + 0.5) - 0.5));\n  let band = step(rad * 1.14, r) * step(r, rad * 1.3);\n  let used = step(u, 0.68 * 4.712);\n  col = mix(col, mix(ink, org, used), tk * band * arc);\n  let ang = 2.356 + 0.68 * 4.712;\n  let dir = vec2<f32>(cos(ang), sin(ang));\n  let nd = dv_seg(p, c + dir * rad * 0.35, c + dir * rad * 0.82) - 2.5;\n  col = mix(col, org, dv_fill(nd));\n  let fk = dv_fill(length(p - vec2<f32>(s.x * 0.82, s.y * 0.88)) - m * 0.075);\n  col = mix(col, org, fk);\n  col = mix(col, ink, (1.0 - smoothstep(0.5, 1.5, abs(length(p - vec2<f32>(s.x * 0.82, s.y * 0.88)) - m * 0.075))));\n  for (var i = 0; i < 3; i = i + 1) {\n    let kc = vec2<f32>(s.x * (0.18 + 0.12 * f32(i)), s.y * 0.88);\n    let kr = length(p - kc) - m * 0.05;\n    col = mix(col, vec3<f32>(0.85, 0.85, 0.83), dv_fill(kr));\n    col = mix(col, ink, 1.0 - smoothstep(0.5, 1.5, abs(kr)));\n  }\n  return vec4<f32>(col, dv_fill(dp) * px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 2 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 2 } },
        "stack/hero/idle": { corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 3 } },
        "pressable/primary/hovered": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 2 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 260, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 0 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 3 } },
        "pressable/secondary/idle": { fill: "secondary", textColor: "secondary-foreground", stroke: "input", strokeWidth: 1.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 3 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 2 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 260, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 0 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "input", strokeWidth: 1, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 } },
        "pressable/secondary/focused": { fill: "secondary", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 3, corners: { radius: [28, 28, 28, 28], kind: "round" }, font: "600 15px body", spring: { stiffness: 180, damping: 30 }, shadow: { color: "rgba(34,34,34,0.38)", blur: 0, offsetX: 0, offsetY: 3 } },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 2 }, spring: { stiffness: 180, damping: 30 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 1 }, spring: { stiffness: 180, damping: 30 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 3, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 2 }, spring: { stiffness: 180, damping: 30 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 0 }, spring: { stiffness: 260, damping: 30 } },
        "card/header/idle": { fill: "surface", corners: { radius: [4, 4, 0, 0], kind: "round" }, textColor: "foreground", font: "600 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [4, 4, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "card/meter/track": { fill: "muted", corners: { radius: [1, 1, 1, 1], kind: "round" } },
        "card/meter/fill": { fill: "primary", corners: { radius: [1, 1, 1, 1], kind: "round" } },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "600 64px display" },
        "text/title/idle": { textColor: "foreground", font: "600 32px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "600 12px body" },
        "text/body/idle": { textColor: "foreground", font: "400 16px body" },
        "text/card/idle": { textColor: "card-foreground", font: "600 20px display", on: "card/surface/idle" },
        "text/numeral/idle": { textColor: "foreground", font: "700 168px display" },
        "text/label/idle": { textColor: "foreground", font: "600 13px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 13px body" },
        "text/inverse/idle": { textColor: "background", font: "600 15px body", on: "section/band/idle" },
        "ticket/body/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 2 } },
        "ticket/stub/idle": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [4, 4, 4, 4], kind: "round" } },
        "ticket/perforation/idle": { stroke: "border", strokeWidth: 3, strokeDash: [1, 6] },
        "material/cell-on/idle": { fill: "primary", corners: { radius: [1, 1, 1, 1], kind: "round" } },
        "material/cal-panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, shadow: { color: "rgba(34,34,34,0.16)", blur: 2, offsetX: 0, offsetY: 3 } },
        "material/day/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "material/day-used/idle": { fill: "primary", stroke: "foreground", strokeWidth: 1, corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "material/day-today/idle": { stroke: "ring", strokeWidth: 3, corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "material/day-renew/idle": { fill: "foreground", corners: { radius: [20, 20, 20, 20], kind: "round" } },
        "material/cell-track/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [1, 1, 1, 1], kind: "round" } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0, ornament: "frame", align: "start", imageTreatment: "none", sectionGap: 96, gutter: 24 }
    motion: { signature: "detent", stiffness: 180, damping: 30, stagger: 90, enterMs: 720, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 44, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.017, offsetX: 0, offsetY: 43.266, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.091, offsetX: 0, offsetY: 39.986, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.321, offsetX: 0, offsetY: 29.898, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.641, offsetX: 0, offsetY: 15.811, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.807, offsetX: 0, offsetY: 8.493, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.897, offsetX: 0, offsetY: 4.528, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.95, offsetX: 0, offsetY: 2.21, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.98, offsetX: 0, offsetY: 0.874, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.996, offsetX: 0, offsetY: 0.198, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/subscription/"
  }
}
