app std-rasm-system-transit-report [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-transit-report — the Transit Report design system for a Rasm page, anchored on Massimo Vignelli's NYC Transit Graphic Standards Manual (1970) (https://standardsmanual.com). Colour: #F2F2F2 ground, #121212 ink, #EE352E accent. Type: Familjen Grotesk over IBM Plex Sans. Grid: modular grid of black bands with white type (Vignelli). Motion: the line-run easing (cubic-bezier 0.50,0.00,0.50,1.00); entrance: chapters advance like a train arriving on a band. Interaction: route bullet fills. Imagery: route bullets and line diagrams. Voice: civic, factual, accountable. Components: buttons are route bullets; cards are signage bands. Data: line route charts. Sound: subway chime on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "transit-report"
    palette: {background: "#F2F2F2", foreground: "#121212", card: "#F9F9F9", "card-foreground": "#121212", surface: "#EBEBEB", muted: "#E0E0E0", "muted-foreground": "#5A5A5A", border: "#7A7A7A", input: "#6E6E6E", primary: "#EE352E", "primary-hover": "#F4605A", "primary-foreground": "#121212", secondary: "#F9F9F9", "secondary-foreground": "#121212", "secondary-hover": "#D7D7D7", accent: "#EE352E", "accent-foreground": "#121212", ring: "#EE352E", "series-1": "#EE352E", "series-2": "#8B2521", "series-3": "#F08A86", "series-4": "#555555", "series-5": "#B75A57"}
    fonts: { display: { family: "Familjen Grotesk", file: "https://almadar-kflow-assets.web.app/fonts/familjengrotesk/FamiljenGrotesk%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "IBM Plex Sans", file: "https://almadar-kflow-assets.web.app/fonts/ibmplexsans/IBMPlexSans%5Bwdth%2Cwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet d = sg_fill(length(p - vec2<f32>(12.0, c.y)) - 4.0);\nlet l = sg_line(p.y - c.y, 0.5) * step(28.0, p.x);\nreturn sg_out(px, px.color.rgb, max(d, l));\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/panel/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 6 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 } },
        "pressable/primary/hovered": { fill: "foreground", textColor: "background", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 } },
        "pressable/primary/pressed": { fill: "foreground", textColor: "background", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 160, damping: 26 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 }, stroke: "foreground", strokeWidth: 4 },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 }, stroke: "foreground", strokeWidth: 3 },
        "pressable/secondary/hovered": { fill: "primary", textColor: "primary-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 }, stroke: "foreground", strokeWidth: 3 },
        "pressable/secondary/pressed": { fill: "foreground", textColor: "background", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 }, stroke: "foreground", strokeWidth: 3 },
        "pressable/secondary/focused": { fill: "background", textColor: "foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 }, stroke: "ring", strokeWidth: 4 },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", corners: { radius: [22, 22, 22, 22], kind: "round" }, font: "700 17px display", spring: { stiffness: 120, damping: 24 }, stroke: "border", strokeWidth: 2 },
        "card/surface/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/hovered": { fill: "foreground", stroke: "primary", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/focused": { fill: "foreground", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 120, damping: 24 } },
        "card/surface/pressed": { fill: "foreground", stroke: "primary", strokeWidth: 6, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 160, damping: 26 } },
        "card/header/idle": { fill: "primary", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "primary-foreground", font: "700 16px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "background", strokeWidth: 1 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "#C9C9C9", font: "400 15px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "foreground", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "700 16px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 2 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 4 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 3 },
        "text/inverse/idle": { textColor: "background", font: "700 32px display", on: "section/band/idle" },
        "text/card/idle": { textColor: "background", font: "700 26px display", on: "card/surface/idle" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "range/default/thumb-idle": { stroke: "foreground" },
        "range/default/thumb-hovered": { stroke: "foreground" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "morph/default/idle": { fill: "primary" },
        "text/display/idle": { textColor: "foreground", font: "700 92px display" },
        "text/title/idle": { textColor: "foreground", font: "700 46px display" },
        "text/eyebrow/idle": { textColor: "#C42B25", font: "600 14px body" },
        "text/body/idle": { textColor: "foreground", font: "400 18px body" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/label/idle": { textColor: "foreground", font: "500 15px body" },
        "surface/ground/idle": { fill: "background" }
      }
    layout: { hero: "full-bleed", columns: 6, asymmetry: 0, ornament: "rule", align: "start", imageTreatment: "none", sectionGap: 64, gutter: 24 }
    motion: { signature: "line-run", stiffness: 120, damping: 24, stagger: 140, enterMs: 1100, keyframes: [{ at: 0, opacity: 0, offsetX: -120, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.015, offsetX: -118.245, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.064, offsetX: -112.261, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.16, offsetX: -100.797, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.309, offsetX: -82.936, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: -60, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.691, offsetX: -37.064, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.84, offsetX: -19.203, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.936, offsetX: -7.739, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.985, offsetX: -1.755, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/public-report/"
  }
}
