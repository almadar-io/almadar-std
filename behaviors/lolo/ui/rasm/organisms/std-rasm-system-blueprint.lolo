app std-rasm-system-blueprint [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-blueprint — the Blueprint design system for a Rasm page, anchored on Architectural cyanotype blueprints and ISO 3098 technical lettering (https://en.wikipedia.org/wiki/Blueprint). Colour: #0E3A6E ground, #EAF2FF ink, #FFD23F accent. Type: Architects Daughter over Barlow. Grid: modular drafting grid, 10mm squares with dimension lines. Motion: the draft-pen easing (cubic-bezier 0.25,0.10,0.25,1.00); entrance: linework draws itself then labels appear. Interaction: dimension lines extend to the hovered element. Imagery: white linework drawings, no photos. Voice: technical, specific, metric units. Components: buttons are dimensioned boxes; cards are title blocks. Data: section-cut bar charts with hatching. Sound: drafting compass scratch on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "blueprint"
    palette: {background: "#0E3A6E", foreground: "#EAF2FF", card: "#1B4577", "card-foreground": "#EAF2FF", surface: "#154072", muted: "#20497A", "muted-foreground": "#A4B7D1", border: "#718DAF", input: "#7C96B7", primary: "#FFD23F", "primary-hover": "#FFD95C", "primary-foreground": "#0E3A6E", secondary: "#1B4577", "secondary-foreground": "#EAF2FF", "secondary-hover": "#28507F", accent: "#FFD23F", "accent-foreground": "#0E3A6E", ring: "#FFD23F", "series-1": "#FFD23F", "series-2": "#F6E095", "series-3": "#938E54", "series-4": "#A8BBD4", "series-5": "#BFA95F"}
    fonts: { display: { family: "Architects Daughter", file: "https://almadar-kflow-assets.web.app/fonts/architectsdaughter/ArchitectsDaughter-Regular.ttf", generic: "sans-serif" }, body: { family: "Barlow", file: "https://almadar-kflow-assets.web.app/fonts/barlow/Barlow-Regular.ttf", generic: "sans-serif" } }
    looks: {
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1.2, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 190, damping: 28 } },
        "card/surface/hovered": { fill: "card", stroke: "accent", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 190, damping: 28 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 190, damping: 28 } },
        "card/surface/pressed": { fill: "muted", stroke: "border", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 240, damping: 30 } },
        "card/header/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 13px mono", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 13px mono" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [2, 4] },
        "section/band/idle": { fill: "#143a70" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1, strokeDash: [8, 4] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 4 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "text/inverse/idle": { textColor: "#ffffff", font: "500 16px mono", on: "section/band/idle" },
        "pressable/primary/focused": { fill: "foreground", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "500 14px mono", spring: { stiffness: 190, damping: 28 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 14px mono", spring: { stiffness: 190, damping: 28 } },
        "textfield/default/idle": { fill: "background", stroke: "input", strokeWidth: 1.2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px mono" },
        "textfield/default/hovered": { fill: "background", stroke: "accent", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px mono" },
        "textfield/default/focused": { fill: "background", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 16px mono" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px mono" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n var c = px.color.rgb;\n let lum = dot(c, vec3<f32>(0.33, 0.33, 0.33));\n let ink = select(vec3<f32>(0.1, 0.29, 0.54), vec3<f32>(1.0, 1.0, 1.0), lum < 0.5);\n let q1 = abs(fract(px.local / 16.0) - vec2<f32>(0.5, 0.5));\n let q2 = abs(fract(px.local / 80.0) - vec2<f32>(0.5, 0.5));\n c = mix(c, ink, step(0.485, max(q1.x, q1.y)) * 0.05);\n c = mix(c, ink, step(0.4938, max(q2.x, q2.y)) * 0.1);\n let ctr = vec2<f32>(px.size.x * 0.72, px.size.y * 0.45 - px.scroll * 40.0);\n let p = px.local - ctr;\n let r = px.size.y * 0.28;\n let ring = step(abs(length(p) - r), 0.8) + step(abs(length(p) - r * 0.62), 0.6);\n let cl = step(min(abs(p.x), abs(p.y)), 0.6) * step(length(p), r * 1.15) * step(0.5, fract(max(p.x, p.y) / 14.0 + 0.0));\n c = mix(c, ink, (ring * 0.14 + cl * 0.12));\n let dy = px.local.y - (px.size.y - 36.0);\n let dl = step(abs(dy), 0.6) * step(32.0, px.local.x) * step(px.local.x, px.size.x - 32.0);\n let tk = step(abs(dy), 7.0) * step(min(fract((px.local.x - 32.0) / 240.0), 1.0 - fract((px.local.x - 32.0) / 240.0)), 0.004) * step(32.0, px.local.x);\n c = mix(c, ink, (dl + tk) * 0.2);\n let cm = step(min(px.local.x, px.size.x - px.local.x), 24.0) * step(min(px.local.y, px.size.y - px.local.y), 1.0);\n c = mix(c, ink, cm * 0.3);\n let dp = length(px.local - px.pointer);\n c = mix(c, ink, 0.05 * exp(-dp / 100.0) * step(0.4, fract(px.local.x / 4.0)));\n return vec4<f32>(c, px.color.a);\n}", params: [1.0, 0.0, 0.0, 0.0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 1.2, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 190, damping: 28 } },
        "stack/panel/idle": { fill: "muted", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 190, damping: 28 } },
        "stack/hero/idle": { fill: "background", stroke: "foreground", strokeWidth: 2.5, corners: { radius: [0, 0, 0, 0], kind: "notch" }, spring: { stiffness: 190, damping: 28 } },
        "stack/bar/idle": { fill: "background", stroke: "foreground", strokeWidth: 1.2, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "500 14px mono", spring: { stiffness: 190, damping: 28 } },
        "pressable/primary/hovered": { fill: "accent", stroke: "foreground", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "accent-foreground", font: "500 14px mono", spring: { stiffness: 190, damping: 28 } },
        "pressable/primary/pressed": { fill: "muted-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "background", font: "500 14px mono", spring: { stiffness: 190, damping: 28 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 14px mono", spring: { stiffness: 190, damping: 28 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "accent", strokeWidth: 1.5, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "400 14px mono", spring: { stiffness: 190, damping: 28 } },
        "text/display/idle": { textColor: "foreground", font: "500 64px display" },
        "text/title/idle": { textColor: "foreground", font: "500 30px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "400 13px mono" },
        "text/body/idle": { textColor: "foreground", font: "400 16px mono" },
        "text/card/idle": { textColor: "foreground", font: "500 18px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn sg_seg(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 { let pa = p - a; let ba = b - a; let h = clamp(dot(pa, ba) / max(dot(ba, ba), 0.0001), 0.0, 1.0); return length(pa - ba * h); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet gx = min(fract(p.x / 16.0), 1.0 - fract(p.x / 16.0)) * 16.0;\nlet gy = min(fract(p.y / 16.0), 1.0 - fract(p.y / 16.0)) * 16.0;\nlet mx = min(fract(p.x / 80.0), 1.0 - fract(p.x / 80.0)) * 80.0;\nlet my = min(fract(p.y / 80.0), 1.0 - fract(p.y / 80.0)) * 80.0;\nlet minor = max(1.0 - smoothstep(0.2, 1.0, gx), 1.0 - smoothstep(0.2, 1.0, gy)) * 0.22;\nlet major = max(1.0 - smoothstep(0.2, 1.0, mx), 1.0 - smoothstep(0.2, 1.0, my)) * 0.45;\nlet yd = s.y - 14.0;\nlet dl = sg_line(p.y - yd, 0.5) * step(8.0, p.x) * step(p.x, s.x - 8.0);\nlet tk = max(sg_line(p.x - 8.0, 0.5), sg_line(p.x - (s.x - 8.0), 0.5)) * step(abs(p.y - yd), 6.0);\nlet ar = max(sg_line(sg_seg(p, vec2<f32>(8.0, yd), vec2<f32>(16.0, yd - 4.0)), 0.5), sg_line(sg_seg(p, vec2<f32>(8.0, yd), vec2<f32>(16.0, yd + 4.0)), 0.5));\nlet ar2 = max(sg_line(sg_seg(p, vec2<f32>(s.x - 8.0, yd), vec2<f32>(s.x - 16.0, yd - 4.0)), 0.5), sg_line(sg_seg(p, vec2<f32>(s.x - 8.0, yd), vec2<f32>(s.x - 16.0, yd + 4.0)), 0.5));\nreturn sg_out(px, px.color.rgb, max(max(minor, major), max(max(dl, tk), max(ar, ar2))));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.2, ornament: "double-rule", align: "start", imageTreatment: "engraving", sectionGap: 96, gutter: 40 }
    motion: { signature: "draft-pen", stiffness: 190, damping: 28, stagger: 60, enterMs: 1253, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 30, scale: 0.97, rotate: -3 }, { at: 0.1, opacity: 0.095, offsetX: 0, offsetY: 27.156, scale: 0.973, rotate: -2.716 }, { at: 0.2, opacity: 0.295, offsetX: 0, offsetY: 21.143, scale: 0.979, rotate: -2.114 }, { at: 0.3, opacity: 0.513, offsetX: 0, offsetY: 14.601, scale: 0.985, rotate: -1.46 }, { at: 0.4, opacity: 0.683, offsetX: 0, offsetY: 9.524, scale: 0.99, rotate: -0.952 }, { at: 0.5, opacity: 0.802, offsetX: 0, offsetY: 5.928, scale: 0.994, rotate: -0.593 }, { at: 0.6, opacity: 0.885, offsetX: 0, offsetY: 3.443, scale: 0.997, rotate: -0.344 }, { at: 0.7, opacity: 0.941, offsetX: 0, offsetY: 1.777, scale: 0.998, rotate: -0.178 }, { at: 0.8, opacity: 0.976, offsetX: 0, offsetY: 0.731, scale: 0.999, rotate: -0.073 }, { at: 0.9, opacity: 0.994, offsetX: 0, offsetY: 0.171, scale: 1, rotate: -0.017 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/construction/"
  }
}
