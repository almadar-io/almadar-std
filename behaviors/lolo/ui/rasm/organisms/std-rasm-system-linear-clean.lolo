app std-rasm-system-linear-clean [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-linear-clean — the Linear Clean design system for a Rasm page, anchored on Linear.app product design and its changelog (https://linear.app). Colour: #0D0E12 ground, #E6E7EB ink, #5E6AD2 accent. Type: Geist over Geist Mono. Grid: dense 8px app grid, sidebar plus content. Motion: the snappy easing (cubic-bezier 0.25,1.00,0.50,1.00); entrance: panels fade and scale from 98%. Interaction: subtle border lightens, no motion. Imagery: product screenshots only. Voice: confident, precise, product nouns. Components: buttons are compact 28px chips; cards are hairline panels. Data: thin line charts with muted area. Sound: soft UI tap on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "linear-clean"
    palette: { background: "#0D0E12", foreground: "#E6E7EB", card: "#15161B", "card-foreground": "#E6E7EB", surface: "#111217", muted: "#1D1E24", "muted-foreground": "#A3A5AD", border: "#6F7078", input: "#7B7C85", primary: "#5E6AD2", "primary-hover": "#4D59C2", "primary-foreground": "#FFFFFF", secondary: "#15161B", "secondary-foreground": "#E6E7EB", "secondary-hover": "#1D1E24", accent: "#5E6AD2", "accent-foreground": "#FFFFFF", ring: "#8E98EC", "series-1": "#5E6AD2", "series-2": "#9BA2DD", "series-3": "#3A417C", "series-4": "#A5A6AA", "series-5": "#6F75A9" }
    fonts: { display: { family: "Geist", file: "https://almadar-kflow-assets.web.app/fonts/geist/Geist%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Geist", file: "https://almadar-kflow-assets.web.app/fonts/geist/Geist%5Bwght%5D.ttf", generic: "sans-serif" }, mono: { family: "Geist Mono", file: "https://almadar-kflow-assets.web.app/fonts/geistmono/GeistMono%5Bwght%5D.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let p = px.local;\n  let d = length(fract(p / 8.0) * 8.0 - vec2<f32>(4.0, 4.0));\n  let dot = 1.0 - smoothstep(0.4, 0.9, d);\n  let gx = min(fract(p.x / 64.0) * 64.0, 64.0 - fract(p.x / 64.0) * 64.0);\n  let gy = min(fract(p.y / 64.0) * 64.0, 64.0 - fract(p.y / 64.0) * 64.0);\n  let ln = max(1.0 - smoothstep(0.3, 1.0, gx), 1.0 - smoothstep(0.3, 1.0, gy));\n  let col = px.color.rgb + vec3<f32>(dot * 0.006 + ln * 0.010);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "stack/panel/idle": { fill: "card", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "stack/closing/idle": { fill: "card", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [6, 6, 6, 6], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/surface/idle": { fill: "card", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "card/surface/hovered": { fill: "card", stroke: "#4B4C55", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "card/surface/pressed": { fill: "surface", stroke: "#4B4C55", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "card/header/idle": { fill: "surface", corners: { radius: [6, 6, 0, 0], kind: "round" }, textColor: "foreground", font: "500 13px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "#2A2B31", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [6, 6, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "panel/header/idle": { fill: "surface", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [6, 6, 0, 0], kind: "round" }, textColor: "foreground", font: "500 13px display" },
        "panel/divider/idle": { stroke: "#2A2B31", strokeWidth: 1 },
        "window/frame/idle": { fill: "card", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, spring: { stiffness: 620, damping: 50 } },
        "window/titlebar/idle": { fill: "surface", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [8, 8, 0, 0], kind: "round" }, textColor: "muted-foreground", font: "500 12px mono" },
        "window/control/idle": { fill: "muted", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [999, 999, 999, 999], kind: "round" } },
        "section/band/idle": { fill: "background" },
        "section/rule/idle": { stroke: "#2A2B31", strokeWidth: 1 },
        "grid/rule/idle": { stroke: "#2A2B31", strokeWidth: 1 },
        "grid/border/idle": { stroke: "#2A2B31", strokeWidth: 1, fill: "" },
        "focus/ring/outer": { stroke: "background", strokeWidth: 4 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "primary", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/primary/hovered": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/secondary/idle": { fill: "background", textColor: "secondary-foreground", stroke: "input", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/secondary/hovered": { fill: "background", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "secondary-foreground", stroke: "foreground", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/secondary/focused": { fill: "background", textColor: "secondary-foreground", stroke: "ring", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "pressable/secondary/disabled": { fill: "background", textColor: "muted-foreground", stroke: "#2A2B31", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, font: "500 13px display", spring: { stiffness: 620, damping: 50 } },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "foreground", font: "400 14px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "foreground", font: "400 14px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [6, 6, 6, 6], kind: "round" }, textColor: "foreground", font: "400 14px body" },
        "textfield/default/placeholder": { textColor: "muted-foreground", font: "400 14px body" },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "foreground", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/track": { fill: "muted", corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "range/default/fill": { fill: "primary", corners: { radius: [2, 2, 2, 2], kind: "round" } },
        "range/default/thumb-idle": { fill: "foreground", stroke: "input", strokeWidth: 1 },
        "range/default/thumb-hovered": { fill: "foreground", stroke: "primary", strokeWidth: 1 },
        "range/default/thumb-dragging": { fill: "foreground", stroke: "primary", strokeWidth: 2 },
        "text/display/idle": { textColor: "foreground", font: "600 64px display" },
        "text/title/idle": { textColor: "foreground", font: "600 32px display" },
        "text/eyebrow/idle": { textColor: "series-2", font: "500 12px mono" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 15px body" },
        "text/card/idle": { textColor: "card-foreground", font: "500 16px display", on: "card/surface/idle" },
        "text/label/idle": { textColor: "foreground", font: "500 12px body" },
        "text/numeral/idle": { textColor: "primary", font: "600 40px mono" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 12px body" },
        "text/inverse/idle": { on: "pressable/primary/idle", textColor: "primary-foreground", font: "500 13px display" },
        "morph/default/idle": { fill: "accent" }
      }
    layout: { hero: "split", columns: 12, asymmetry: 0.25, ornament: "none", align: "start", imageTreatment: "none", sectionGap: 64, gutter: 16 }
    motion: { signature: "snappy", stiffness: 620, damping: 50, stagger: 40, enterMs: 320, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0, scale: 0.98, rotate: 0 }, { at: 0.1, opacity: 0.347, offsetX: 0, offsetY: 0, scale: 0.987, rotate: 0 }, { at: 0.2, opacity: 0.596, offsetX: 0, offsetY: 0, scale: 0.992, rotate: 0 }, { at: 0.3, opacity: 0.763, offsetX: 0, offsetY: 0, scale: 0.995, rotate: 0 }, { at: 0.4, opacity: 0.87, offsetX: 0, offsetY: 0, scale: 0.997, rotate: 0 }, { at: 0.5, opacity: 0.934, offsetX: 0, offsetY: 0, scale: 0.999, rotate: 0 }, { at: 0.6, opacity: 0.97, offsetX: 0, offsetY: 0, scale: 0.999, rotate: 0 }, { at: 0.7, opacity: 0.989, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.997, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/finance/"
  }
}
