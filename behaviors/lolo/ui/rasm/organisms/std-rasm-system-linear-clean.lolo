app std-rasm-system-linear-clean [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-linear-clean — the Linear Clean design system for a Rasm page, anchored on Linear.app product design and its changelog (https://linear.app). Colour: #0D0E12 ground, #E6E7EB ink, #5E6AD2 accent. Type: Geist over Geist Mono. Grid: dense 8px app grid, sidebar plus content. Motion: the snappy easing (cubic-bezier 0.25,1.00,0.50,1.00); entrance: panels fade and scale from 98%. Interaction: subtle border lightens, no motion. Imagery: product screenshots only. Voice: confident, precise, product nouns. Components: buttons are compact 28px chips; cards are hairline panels. Data: thin line charts with muted area. Sound: soft UI tap on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "linear-clean"
    palette: {background: "#0D0E12", foreground: "#E6E7EB", card: "#1A1B1F", "card-foreground": "#E6E7EB", surface: "#141519", muted: "#1E1F23", "muted-foreground": "#A1A2A6", border: "#6F7074", input: "#7A7B7F", primary: "#5E6AD2", "primary-hover": "#7680D9", "primary-foreground": "#0D0E12", secondary: "#1A1B1F", "secondary-foreground": "#E6E7EB", "secondary-hover": "#27282C", accent: "#5E6AD2", "accent-foreground": "#0D0E12", ring: "#5E6AD2", "series-1": "#5E6AD2", "series-2": "#9BA2DD", "series-3": "#3A417C", "series-4": "#A5A6AA", "series-5": "#6F75A9"}
    fonts: { display: { family: "Geist", file: "https://almadar-kflow-assets.web.app/fonts/geist/Geist%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Geist Mono", file: "https://almadar-kflow-assets.web.app/fonts/geistmono/GeistMono%5Bwght%5D.ttf", generic: "monospace" }, mono: { family: "Geist Mono", file: "https://almadar-kflow-assets.web.app/fonts/geistmono/GeistMono%5Bwght%5D.ttf", generic: "monospace" } }
    looks: {
        "card/surface/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 220, damping: 26 } },
        "card/surface/hovered": { fill: "card", stroke: "muted-foreground", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 220, damping: 26 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 220, damping: 26 } },
        "card/surface/pressed": { fill: "surface", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" }, spring: { stiffness: 260, damping: 28 } },
        "card/header/idle": { fill: "surface", corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "500 13px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1 },
        "card/media/idle": { fill: "surface", corners: { radius: [10, 10, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 10, 10], kind: "round" } },
        "panel/header/idle": { fill: "surface", stroke: "input", strokeWidth: 1, corners: { radius: [10, 10, 0, 0], kind: "round" }, textColor: "foreground", font: "500 14px body" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1 },
        "section/band/idle": { fill: "background" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 4 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "text/inverse/idle": { textColor: "foreground", font: "600 16px body", on: "section/band/idle" },
        "pressable/primary/focused": { fill: "primary", corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary-foreground", font: "500 14px body", stroke: "ring", strokeWidth: 2, spring: { stiffness: 220, damping: 26 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 14px body", spring: { stiffness: 220, damping: 26 } },
        "pressable/secondary/pressed": { fill: "surface", stroke: "input", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 14px body" },
        "pressable/secondary/disabled": { fill: "background", stroke: "input", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 14px body" },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/hovered": { fill: "card", stroke: "muted-foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "foreground", font: "400 16px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px body" },
        "toggle/check/off-idle": { stroke: "input" },
        "toggle/check/off-hovered": { stroke: "input" },
        "toggle/switch/off-idle": { stroke: "input" },
        "toggle/switch/off-hovered": { stroke: "input" },
        "range/default/thumb-idle": { stroke: "input" },
        "range/default/thumb-hovered": { stroke: "input" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let p = px.pointer / max(px.size, vec2<f32>(1.0, 1.0));\n  let gl = px.local - vec2<f32>(0.0, px.scroll * 40.0);\n  let gx = abs(fract(gl.x / 48.0) - 0.5);\n  let gy = abs(fract(gl.y / 48.0) - 0.5);\n  let line = max(1.0 - smoothstep(0.0, 0.012, 0.5 - gx), 1.0 - smoothstep(0.0, 0.012, 0.5 - gy));\n  let fade = smoothstep(1.0, 0.1, px.uv.y);\n  let ind = vec3<f32>(0.37, 0.42, 0.82);\n  let beam = exp(-abs(px.uv.y - 0.08) * 90.0) * smoothstep(0.0, 0.5, px.uv.x) * smoothstep(1.0, 0.5, px.uv.x);\n  let glow = exp(-length((px.uv - p) * vec2<f32>(1.6, 1.0)) * 4.0);\n  let top = exp(-length((px.uv - vec2<f32>(0.5, -0.1)) * vec2<f32>(0.8, 1.6)) * 2.2);\n  var col = px.color.rgb - vec3<f32>(line * fade * 0.03);\n  col = mix(col, ind, top * 0.08 + glow * 0.04 + beam * 0.14);\n  return vec4<f32>(col, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", corners: { radius: [8, 8, 8, 8], kind: "round" }, stroke: "border", strokeWidth: 1, shadow: { color: "rgba(94,106,210,0.18)", blur: 24 } },
        "stack/panel/idle": { fill: "card", corners: { radius: [8, 8, 8, 8], kind: "round" }, stroke: "border", strokeWidth: 1, shadow: { color: "rgba(94,106,210,0.18)", blur: 24 } },
        "stack/hero/idle": { fill: "background", corners: { radius: [8, 8, 8, 8], kind: "round" } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary-foreground", font: "500 14px body", spring: { stiffness: 220, damping: 26 }, shadow: { color: "rgba(94,106,210,0.45)", blur: 18 } },
        "pressable/primary/hovered": { fill: "primary-hover", corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary-foreground", font: "500 14px body", spring: { stiffness: 220, damping: 26 }, shadow: { color: "rgba(94,106,210,0.45)", blur: 18 } },
        "pressable/primary/pressed": { fill: "primary-hover", corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "primary-foreground", font: "500 14px body", spring: { stiffness: 220, damping: 26 } },
        "pressable/secondary/idle": { fill: "background", stroke: "input", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 14px body", spring: { stiffness: 220, damping: 26 } },
        "pressable/secondary/hovered": { fill: "secondary-hover", stroke: "foreground", strokeWidth: 1, corners: { radius: [8, 8, 8, 8], kind: "round" }, textColor: "secondary-foreground", font: "500 14px body", spring: { stiffness: 220, damping: 26 } },
        "text/display/idle": { textColor: "foreground", font: "600 64px display", spring: { stiffness: 220, damping: 26 } },
        "text/title/idle": { textColor: "foreground", font: "600 36px display", spring: { stiffness: 220, damping: 26 } },
        "text/eyebrow/idle": { textColor: "primary", font: "500 13px mono", spring: { stiffness: 220, damping: 26 } },
        "text/body/idle": { textColor: "muted-foreground", font: "400 16px body", spring: { stiffness: 220, damping: 26 } },
        "text/card/idle": { textColor: "card-foreground", font: "500 18px display", on: "card/surface/idle" },
        "morph/default/idle": { fill: "accent" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet gx = (p.x - s.x * 0.7) / (s.x * 0.25);\nlet g = exp(-gx * gx);\nlet rule = sg_line(p.y - c.y, 0.5) * (0.25 + 0.75 * g);\nlet q = fract(p / 24.0) - vec2<f32>(0.5, 0.5);\nlet dots = (1.0 - smoothstep(0.8, 1.6, length(q) * 24.0)) * 0.3;\nlet glow = exp(-abs(p.y - c.y) / 10.0) * g * 0.35;\nreturn sg_out(px, px.color.rgb, max(max(rule, dots), glow));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "centered", columns: 12, asymmetry: 0.0, ornament: "rule", align: "center", imageTreatment: "glow", sectionGap: 112, gutter: 32 }
    motion: { signature: "snappy", stiffness: 220, damping: 26, stagger: 50, enterMs: 735, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 30, scale: 0.97, rotate: -3 }, { at: 0.1, opacity: 0.347, offsetX: 0, offsetY: 19.581, scale: 0.98, rotate: -1.958 }, { at: 0.2, opacity: 0.596, offsetX: 0, offsetY: 12.119, scale: 0.988, rotate: -1.212 }, { at: 0.3, opacity: 0.763, offsetX: 0, offsetY: 7.098, scale: 0.993, rotate: -0.71 }, { at: 0.4, opacity: 0.87, offsetX: 0, offsetY: 3.902, scale: 0.996, rotate: -0.39 }, { at: 0.5, opacity: 0.934, offsetX: 0, offsetY: 1.977, scale: 0.998, rotate: -0.198 }, { at: 0.6, opacity: 0.97, offsetX: 0, offsetY: 0.891, scale: 0.999, rotate: -0.089 }, { at: 0.7, opacity: 0.989, offsetX: 0, offsetY: 0.333, scale: 1, rotate: -0.033 }, { at: 0.8, opacity: 0.997, offsetX: 0, offsetY: 0.088, scale: 1, rotate: -0.009 }, { at: 0.9, opacity: 1, offsetX: 0, offsetY: 0.01, scale: 1, rotate: -0.001 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/finance/"
  }
}
