app std-rasm-system-agitprop [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-agitprop — the Agitprop design system for a Rasm page, anchored on El Lissitzky, Beat the Whites with the Red Wedge (1919) and Rodchenko's LENGIZ poster (https://en.wikipedia.org/wiki/Beat_the_Whites_with_the_Red_Wedge). Colour: #EFE6D8 ground, #111111 ink, #D7261E accent. Type: Unbounded over Golos Text. Grid: diagonal grid at 22 degrees. Motion: the wedge-strike easing (cubic-bezier 0.90,0.00,0.10,1.00); entrance: type slams in on the diagonal, red wedge first. Interaction: element skews 4 degrees toward the pointer. Imagery: photomontage halves in red and black. Voice: slogans, exclamations, collective 'we'. Components: buttons are wedges; cards are tilted slabs with hard offset. Data: angled bar charts on the diagonal. Sound: rubber stamp thump on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "agitprop"
    palette: {background: "#EFE6D8", foreground: "#111111", card: "#F8F4ED", "card-foreground": "#111111", surface: "#E8E0D2", muted: "#DDD5C8", "muted-foreground": "#4F4C48", border: "#6F6A63", input: "#6B675F", primary: "#D7261E", "primary-hover": "#B7201A", "primary-foreground": "#F8F4ED", secondary: "#F8F4ED", "secondary-foreground": "#111111", "secondary-hover": "#D4CCC0", accent: "#D7261E", "accent-foreground": "#F8F4ED", ring: "#111111", "series-1": "#D7261E", "series-2": "#111111", "series-3": "#E27C72", "series-4": "#54514D", "series-5": "#8C1913"}
    fonts: { display: { family: "Unbounded", file: "https://almadar-kflow-assets.web.app/fonts/unbounded/Unbounded%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Golos Text", file: "https://almadar-kflow-assets.web.app/fonts/golostext/GolosText%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 28, 0, 28], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 10, offsetY: 10 } },
        "stack/panel/idle": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [28, 0, 28, 0], kind: "notch" }, shadow: { color: "#D7261E", blur: 0, offsetX: 8, offsetY: 8 } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 5, corners: { radius: [0, 40, 0, 40], kind: "notch" } },
        "stack/bar/idle": { fill: "primary", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 18, 0, 18], kind: "bevel" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#111111", blur: 0, offsetX: 6, offsetY: 6 } },
        "pressable/primary/hovered": { fill: "foreground", textColor: "background", stroke: "primary", strokeWidth: 4, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#D7261E", blur: 0, offsetX: 10, offsetY: 10 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#111111", blur: 0, offsetX: 1, offsetY: 1 } },
        "pressable/primary/focused": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 5, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#111111", blur: 0, offsetX: 6, offsetY: 6 } },
        "pressable/secondary/idle": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#111111", blur: 0, offsetX: 6, offsetY: 6 } },
        "pressable/secondary/hovered": { fill: "foreground", textColor: "background", stroke: "primary", strokeWidth: 4, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#D7261E", blur: 0, offsetX: 10, offsetY: 10 } },
        "pressable/secondary/pressed": { fill: "secondary-hover", textColor: "foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#111111", blur: 0, offsetX: 1, offsetY: 1 } },
        "pressable/secondary/disabled": { fill: "muted", textColor: "muted-foreground", stroke: "input", strokeWidth: 2, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 } },
        "pressable/secondary/focused": { fill: "background", textColor: "foreground", stroke: "foreground", strokeWidth: 5, corners: { radius: [0, 26, 0, 26], kind: "bevel" }, font: "800 17px display", spring: { stiffness: 420, damping: 30 }, shadow: { color: "#111111", blur: 0, offsetX: 6, offsetY: 6 } },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 24, 0, 24], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 10, offsetY: 10 }, spring: { stiffness: 420, damping: 30 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 24, 0, 24], kind: "notch" }, shadow: { color: "#D7261E", blur: 0, offsetX: 16, offsetY: 6 }, spring: { stiffness: 300, damping: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 5, corners: { radius: [0, 24, 0, 24], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 10, offsetY: 10 }, spring: { stiffness: 420, damping: 30 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 24, 0, 24], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 2, offsetY: 2 }, spring: { stiffness: 520, damping: 32 } },
        "card/header/idle": { fill: "primary", corners: { radius: [0, 0, 0, 0], kind: "notch" }, textColor: "primary-foreground", font: "800 15px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 4 },
        "card/media/idle": { fill: "primary", corners: { radius: [0, 0, 0, 0], kind: "bevel" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "600 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [24, 0, 24, 0], kind: "notch" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [24, 0, 24, 0], kind: "notch" }, textColor: "card", font: "800 15px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 4 },
        "section/band/idle": { fill: "primary" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 5 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 7 },
        "focus/ring/inner": { stroke: "foreground", strokeWidth: 4 },
        "text/display/idle": { textColor: "foreground", font: "900 92px display" },
        "text/title/idle": { textColor: "primary-hover", font: "900 40px display" },
        "text/eyebrow/idle": { textColor: "primary-hover", font: "800 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 18px body" },
        "text/card/idle": { textColor: "card-foreground", font: "800 24px display" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "900 28px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "600 14px body" },
        "text/label/idle": { textColor: "foreground", font: "800 14px body" },
        "textfield/default/idle": { fill: "card", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 14, 0, 14], kind: "notch" }, textColor: "foreground", font: "600 17px body" },
        "textfield/default/hovered": { fill: "card", stroke: "primary", strokeWidth: 4, corners: { radius: [0, 14, 0, 14], kind: "notch" }, textColor: "foreground", font: "600 17px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 5, corners: { radius: [0, 14, 0, 14], kind: "notch" }, textColor: "foreground", font: "600 17px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "500 17px body" },
        "morph/default/idle": { fill: "primary", stroke: "foreground", strokeWidth: 4, corners: { radius: [0, 20, 0, 20], kind: "bevel" } },
        "ornament/bar/idle": { fill: "primary", stroke: "foreground", strokeWidth: 4 },
        "ornament/daycell/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, shadow: { color: "#111111", blur: 0, offsetX: 5, offsetY: 5 } },
        "ornament/launch/idle": { fill: "foreground", stroke: "primary", strokeWidth: 6, shadow: { color: "#D7261E", blur: 0, offsetX: 8, offsetY: 8 } },
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let ang = 0.384 + (px.pointer.x / px.size.x - 0.5) * 0.05 + px.scroll * 0.05; let u = dot(p - vec2<f32>(px.size.x * 0.55, px.size.y * 0.5), vec2<f32>(-sin(ang), cos(ang))); let red = vec3<f32>(0.8, 0.1, 0.08); let band = 1.0 - smoothstep(89.0, 91.0, abs(u)); let wedge = smoothstep(-1.0, 1.0, p.y - (px.size.y - p.x * 0.6)) * (1.0 - smoothstep(px.size.x * 0.4 - 1.0, px.size.x * 0.4 + 1.0, p.x)); let hl = smoothstep(0.44, 0.5, abs(fract(u / 26.0) - 0.5)); let ln = 1.0 - smoothstep(0.5, 1.6, abs(abs(u) - 112.0)); var c = mix(px.color.rgb, red, band * 0.09); c = mix(c, red, wedge * 0.1); c = c + vec3<f32>(s * (hl * 0.03 + ln * 0.09)); return vec4<f32>(c, px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet apex = vec2<f32>(s.x * 0.78, c.y);\nlet k = clamp((apex.x - p.x) / max(apex.x, 1.0), 0.0, 1.0);\nlet wedge = sg_fill((abs(p.y - c.y) - c.y * k) * 0.85) * step(p.x, apex.x);\nlet v = abs(fract((p.x - p.y) / 22.0) - 0.5) * 22.0;\nlet bar = (1.0 - smoothstep(4.0, 5.0, v)) * step(apex.x + 6.0, p.x);\nlet col = mix(px.color.rgb, vec3<f32>(0.82, 0.1, 0.1), wedge);\nreturn sg_out(px, col, max(wedge, bar));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "poster", columns: 12, asymmetry: 0.55, ornament: "stamp", align: "start", imageTreatment: "duotone", sectionGap: 72, gutter: 24 }
    motion: { signature: "wedge-strike", stiffness: 420, damping: 30, stagger: 40, enterMs: 540, keyframes: [{ at: 0, opacity: 0, offsetX: -84, offsetY: 34, scale: 1.1, rotate: -5 }, { at: 0.1, opacity: 0.005, offsetX: -83.608, offsetY: 33.841, scale: 1.1, rotate: -4.977 }, { at: 0.2, opacity: 0.022, offsetX: -82.172, offsetY: 33.26, scale: 1.098, rotate: -4.891 }, { at: 0.3, opacity: 0.06, offsetX: -78.976, offsetY: 31.966, scale: 1.094, rotate: -4.701 }, { at: 0.4, opacity: 0.144, offsetX: -71.942, offsetY: 29.119, scale: 1.086, rotate: -4.282 }, { at: 0.5, opacity: 0.5, offsetX: -42, offsetY: 17, scale: 1.05, rotate: -2.5 }, { at: 0.6, opacity: 0.856, offsetX: -12.058, offsetY: 4.881, scale: 1.014, rotate: -0.718 }, { at: 0.7, opacity: 0.94, offsetX: -5.024, offsetY: 2.034, scale: 1.006, rotate: -0.299 }, { at: 0.8, opacity: 0.978, offsetX: -1.828, offsetY: 0.74, scale: 1.002, rotate: -0.109 }, { at: 0.9, opacity: 0.995, offsetX: -0.392, offsetY: 0.159, scale: 1, rotate: -0.023 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/campaign-rasm/"
  }
}
