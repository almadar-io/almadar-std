app std-rasm-system-agitprop [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-agitprop — the Agitprop design system for a Rasm page, anchored on El Lissitzky, Beat the Whites with the Red Wedge (1919) and Rodchenko's LENGIZ poster (https://en.wikipedia.org/wiki/Beat_the_Whites_with_the_Red_Wedge). Colour: #EFE6D8 ground, #111111 ink, #D7261E accent. Type: Unbounded over Golos Text. Grid: diagonal grid at 22 degrees. Motion: the wedge-strike easing (cubic-bezier 0.90,0.00,0.10,1.00); entrance: type slams in on the diagonal, red wedge first. Interaction: element skews 4 degrees toward the pointer. Imagery: photomontage halves in red and black. Voice: slogans, exclamations, collective 'we'. Components: buttons are wedges; cards are tilted slabs with hard offset. Data: angled bar charts on the diagonal. Sound: rubber stamp thump on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "agitprop"
    palette: {background: "#EFE6D8", foreground: "#111111", card: "#F8F4ED", "card-foreground": "#111111", surface: "#E8E0D2", muted: "#DDD5C8", "muted-foreground": "#585551", border: "#8B867E", input: "#807C75", primary: "#D7261E", "primary-hover": "#B7201A", "primary-foreground": "#EFE6D8", secondary: "#F8F4ED", "secondary-foreground": "#111111", "secondary-hover": "#D4CCC0", accent: "#D7261E", "accent-foreground": "#EFE6D8", ring: "#D7261E", "series-1": "#D7261E", "series-2": "#7E1D18", "series-3": "#E27C72", "series-4": "#54514D", "series-5": "#AB534F"}
    fonts: { display: { family: "Unbounded", file: "https://almadar-kflow-assets.web.app/fonts/unbounded/Unbounded%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Golos Text", file: "https://almadar-kflow-assets.web.app/fonts/golostext/GolosText%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> { let l = dot(px.color.rgb, vec3<f32>(0.299, 0.587, 0.114)); let s = select(1.0, -1.0, l > 0.5); let p = px.local; let ang = 0.52 + (px.pointer.x / px.size.x - 0.5) * 0.05 + px.scroll * 0.05; let u = dot(p - vec2<f32>(px.size.x * 0.55, px.size.y * 0.5), vec2<f32>(-sin(ang), cos(ang))); let red = vec3<f32>(0.8, 0.1, 0.08); let band = 1.0 - smoothstep(89.0, 91.0, abs(u)); let wedge = smoothstep(-1.0, 1.0, p.y - (px.size.y - p.x * 0.6)) * (1.0 - smoothstep(px.size.x * 0.4 - 1.0, px.size.x * 0.4 + 1.0, p.x)); let hl = smoothstep(0.44, 0.5, abs(fract(u / 26.0) - 0.5)); let ln = 1.0 - smoothstep(0.5, 1.6, abs(abs(u) - 112.0)); var c = mix(px.color.rgb, red, band * 0.09); c = mix(c, red, wedge * 0.1); c = c + vec3<f32>(s * (hl * 0.03 + ln * 0.09)); return vec4<f32>(c, px.color.a); }", params: [0.0, 0.0, 0.0, 0.0], live: false } },
        "stack/card/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [10, 0, 10, 0], kind: "notch" } },
        "stack/panel/idle": { fill: "surface", stroke: "primary", strokeWidth: 3, corners: { radius: [0, 12, 0, 12], kind: "notch" } },
        "stack/hero/idle": { stroke: "foreground", strokeWidth: 4, corners: { radius: [16, 0, 16, 0], kind: "notch" } },
        "stack/bar/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { fill: "primary", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 0, 8, 0], kind: "notch" }, font: "400 18px display", shadow: { color: "#111111", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 360, damping: 28 } },
        "pressable/primary/hovered": { fill: "foreground", textColor: "background", stroke: "primary", strokeWidth: 3, corners: { radius: [8, 0, 8, 0], kind: "notch" }, font: "400 18px display", shadow: { color: "#b80e1b", blur: 0, offsetX: 4, offsetY: 4 }, spring: { stiffness: 360, damping: 28 } },
        "pressable/primary/pressed": { fill: "primary-hover", textColor: "primary-foreground", stroke: "foreground", strokeWidth: 4, corners: { radius: [8, 0, 8, 0], kind: "notch" }, font: "400 18px display", spring: { stiffness: 440, damping: 30 } },
        "pressable/primary/focused": { stroke: "foreground", strokeWidth: 4 },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 3, textColor: "foreground", corners: { radius: [8, 0, 8, 0], kind: "notch" }, font: "400 18px display", spring: { stiffness: 360, damping: 28 } },
        "pressable/secondary/hovered": { fill: "foreground", stroke: "card", strokeWidth: 3, textColor: "background", corners: { radius: [8, 0, 8, 0], kind: "notch" }, font: "400 18px display", spring: { stiffness: 360, damping: 28 } },
        "pressable/secondary/pressed": { stroke: "secondary-foreground" },
        "pressable/secondary/disabled": { stroke: "secondary-foreground" },
        "pressable/secondary/focused": { stroke: "secondary-foreground", strokeWidth: 3 },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { stroke: "primary-foreground", textColor: "primary-foreground" },
        "card/surface/idle": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 0, 8, 0], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 360, damping: 28 } },
        "card/surface/hovered": { fill: "card", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 0, 8, 0], kind: "notch" }, shadow: { color: "#b80e1b", blur: 0, offsetX: 8, offsetY: 8 }, spring: { stiffness: 360, damping: 28 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 4, corners: { radius: [8, 0, 8, 0], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 5, offsetY: 5 }, spring: { stiffness: 360, damping: 28 } },
        "card/surface/pressed": { fill: "surface", stroke: "foreground", strokeWidth: 4, corners: { radius: [8, 0, 8, 0], kind: "notch" }, shadow: { color: "#111111", blur: 0, offsetX: 1, offsetY: 1 }, spring: { stiffness: 440, damping: 30 } },
        "card/header/idle": { fill: "primary", corners: { radius: [8, 0, 0, 0], kind: "notch" }, textColor: "primary-foreground", font: "400 16px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "card/media/idle": { fill: "accent", corners: { radius: [0, 0, 0, 0], kind: "notch" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "500 14px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "surface", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 8, 0, 8], kind: "notch" } },
        "panel/header/idle": { fill: "foreground", stroke: "foreground", strokeWidth: 3, corners: { radius: [0, 8, 0, 0], kind: "notch" }, textColor: "card", font: "400 16px display" },
        "panel/divider/idle": { stroke: "foreground", strokeWidth: 3 },
        "section/band/idle": { fill: "foreground" },
        "section/rule/idle": { stroke: "foreground", strokeWidth: 3 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 6 },
        "focus/ring/inner": { stroke: "foreground", strokeWidth: 3 },
        "text/display/idle": { textColor: "foreground", font: "400 96px display" },
        "text/title/idle": { textColor: "primary", font: "400 36px display" },
        "text/eyebrow/idle": { textColor: "primary", font: "700 14px body" },
        "text/body/idle": { textColor: "foreground", font: "500 17px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 24px display" },
        "text/inverse/idle": { textColor: "card", font: "400 24px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "500 14px body" },
        "text/label/idle": { textColor: "foreground", font: "700 14px body" },
        "morph/default/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [8, 0, 8, 0], kind: "notch" } },
        "ornament/bar/idle": { fill: "primary", stroke: "foreground", strokeWidth: 3 },
        "ornament/daycell/idle": { fill: "card", stroke: "foreground", strokeWidth: 2.5, shadow: { color: "#111111", blur: 0, offsetX: 4, offsetY: 4 } },
        "ornament/launch/idle": { fill: "foreground", stroke: "primary", strokeWidth: 5, shadow: { color: "#b80e1b", blur: 0, offsetX: 6, offsetY: 6 } },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet apex = vec2<f32>(s.x * 0.78, c.y);\nlet k = clamp((apex.x - p.x) / max(apex.x, 1.0), 0.0, 1.0);\nlet wedge = sg_fill((abs(p.y - c.y) - c.y * k) * 0.85) * step(p.x, apex.x);\nlet v = abs(fract((p.x - p.y) / 22.0) - 0.5) * 22.0;\nlet bar = (1.0 - smoothstep(4.0, 5.0, v)) * step(apex.x + 6.0, p.x);\nlet col = mix(px.color.rgb, vec3<f32>(0.82, 0.1, 0.1), wedge);\nreturn sg_out(px, col, max(wedge, bar));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    layout: { hero: "poster", columns: 12, asymmetry: 0.4, ornament: "none", align: "start", imageTreatment: "duotone", sectionGap: 96, gutter: 32 }
    motion: { signature: "wedge-strike", stiffness: 360, damping: 28, stagger: 50, enterMs: 671, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 30, scale: 0.97, rotate: -3 }, { at: 0.1, opacity: 0.005, offsetX: 0, offsetY: 29.86, scale: 0.97, rotate: -2.986 }, { at: 0.2, opacity: 0.022, offsetX: 0, offsetY: 29.347, scale: 0.971, rotate: -2.935 }, { at: 0.3, opacity: 0.06, offsetX: 0, offsetY: 28.206, scale: 0.972, rotate: -2.821 }, { at: 0.4, opacity: 0.144, offsetX: 0, offsetY: 25.694, scale: 0.974, rotate: -2.569 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 15, scale: 0.985, rotate: -1.5 }, { at: 0.6, opacity: 0.856, offsetX: 0, offsetY: 4.306, scale: 0.996, rotate: -0.431 }, { at: 0.7, opacity: 0.94, offsetX: 0, offsetY: 1.794, scale: 0.998, rotate: -0.179 }, { at: 0.8, opacity: 0.978, offsetX: 0, offsetY: 0.653, scale: 0.999, rotate: -0.065 }, { at: 0.9, opacity: 0.995, offsetX: 0, offsetY: 0.14, scale: 1, rotate: -0.014 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/campaign-rasm/"
  }
}
