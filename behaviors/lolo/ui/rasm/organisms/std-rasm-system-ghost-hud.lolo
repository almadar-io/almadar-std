app std-rasm-system-ghost-hud [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-ghost-hud — the Ghost HUD design system for a Rasm page, anchored on Territory Studio UI for Blade Runner 2049 and Ghost in the Shell HUDs (https://territorystudio.com). Colour: #05080F ground, #A8F3FF ink, #FF3D71 accent. Type: Orbitron over Share Tech Mono. Grid: radial HUD grid around a central reticle. Motion: the scan-lock easing (cubic-bezier 0.70,0.00,0.30,1.00); entrance: panels lock on with a bracket snap. Interaction: reticle brackets close on the hovered item. Imagery: wireframe 3D and data overlays. Voice: telemetric, clipped, values with units. Components: buttons are bracketed HUD cells; cards are angled glass panels. Data: radial gauges and live ticks. Sound: sonar ping on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "ghost-hud"
    palette: {background: "#05080F", foreground: "#A8F3FF", card: "#0F161D", "card-foreground": "#A8F3FF", surface: "#0A0F16", muted: "#121B22", "muted-foreground": "#74A8B2", border: "#4E727B", input: "#577E87", primary: "#FF3D71", "primary-hover": "#FF5A86", "primary-foreground": "#05080F", secondary: "#0F161D", "secondary-foreground": "#A8F3FF", "secondary-hover": "#19242C", accent: "#FF3D71", "accent-foreground": "#05080F", ring: "#FF3D71", "series-1": "#FF3D71", "series-2": "#D88FB1", "series-3": "#C23A64", "series-4": "#77ADB7", "series-5": "#BF5E78"}
    fonts: { display: { family: "Orbitron", file: "https://almadar-kflow-assets.web.app/fonts/orbitron/Orbitron%5Bwght%5D.ttf", generic: "sans-serif" }, body: { family: "Share Tech Mono", file: "https://almadar-kflow-assets.web.app/fonts/sharetechmono/ShareTechMono-Regular.ttf", generic: "monospace" }, mono: { family: "Share Tech Mono", file: "https://almadar-kflow-assets.web.app/fonts/sharetechmono/ShareTechMono-Regular.ttf", generic: "monospace" } }
    looks: {
        "surface/ground/idle": { fill: "background", material: { wgsl: "fn shade(px: Pixel) -> vec4<f32> {\n  let c = vec2<f32>(px.size.x * 0.5, px.size.y * 0.5 - px.scroll * 40.0);\n  let p = px.local - c;\n  let r = length(p);\n  let a = atan2(p.y, p.x);\n  let m = min(px.size.x, px.size.y);\n  let f = fract(r / 120.0);\n  let ring = 1.0 - smoothstep(0.4, 1.4, min(f, 1.0 - f) * 120.0);\n  let t = fract(a * 72.0 / 6.2831853);\n  let tick = (1.0 - smoothstep(0.3, 1.1, min(t, 1.0 - t) * r * 6.2831853 / 72.0)) * step(m * 0.4, r) * step(r, m * 0.44);\n  let cross = (1.0 - smoothstep(0.4, 1.2, abs(p.x))) + (1.0 - smoothstep(0.4, 1.2, abs(p.y)));\n  let fade = exp(-r / (m * 1.1));\n  let sweep = exp(-fract(a / 6.2831853 - px.time * 0.05) * 12.0) * step(r, m * 0.5);\n  let ink = vec3<f32>(0.66, 0.95, 1.0);\n  let k = (ring * 0.05 + tick * 0.22 + cross * 0.05) * fade + sweep * 0.05;\n  return vec4<f32>(px.color.rgb + ink * k, px.color.a);\n}\n", params: [0, 0, 0, 0], live: true } },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [16, 0, 16, 0], kind: "bevel" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 10 }, shadow: { color: "rgba(168,243,255,0.14)", blur: 26, offsetX: 0, offsetY: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 }, spring: { stiffness: 320, damping: 22 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 16, 0, 16], kind: "bevel" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 10 }, shadow: { color: "rgba(168,243,255,0.16)", blur: 26, offsetX: 0, offsetY: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 }, spring: { stiffness: 320, damping: 22 } },
        "stack/hero/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [18, 18, 18, 18], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 16 }, spring: { stiffness: 320, damping: 22 } },
        "stack/bar/idle": { fill: "background", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "bevel" } },
        "pressable/primary/idle": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "background", strokeWidth: 1.5, gap: 5 }, textColor: "primary-foreground", font: "700 14px display", spring: { stiffness: 320, damping: 22 } },
        "pressable/primary/hovered": { fill: "primary-hover", stroke: "primary-hover", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "background", strokeWidth: 1.5, gap: 1 }, shadow: { color: "rgba(255,61,113,0.55)", blur: 22, offsetX: 0, offsetY: 0 }, textColor: "primary-foreground", font: "700 14px display", spring: { stiffness: 320, damping: 22 } },
        "pressable/primary/pressed": { fill: "primary", stroke: "primary", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "background", strokeWidth: 2, gap: 0 }, textColor: "primary-foreground", font: "700 14px display", spring: { stiffness: 400, damping: 20 } },
        "pressable/secondary/idle": { fill: "background", stroke: "foreground", strokeWidth: 1, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 8 }, textColor: "foreground", font: "600 13px display", spring: { stiffness: 320, damping: 22 } },
        "pressable/secondary/hovered": { fill: "muted", stroke: "accent", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "accent", strokeWidth: 1.5, gap: 2 }, shadow: { color: "rgba(168,243,255,0.2)", blur: 26, offsetX: 0, offsetY: 0 }, textColor: "foreground", font: "600 13px display", spring: { stiffness: 320, damping: 22 } },
        "pressable/primary/focused": { fill: "primary", stroke: "foreground", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "background", strokeWidth: 1.5, gap: 5 }, textColor: "primary-foreground", font: "700 14px display", spring: { stiffness: 320, damping: 22 } },
        "pressable/secondary/focused": { fill: "background", stroke: "ring", strokeWidth: 3, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 8 }, textColor: "foreground", font: "600 13px display", spring: { stiffness: 320, damping: 22 } },
        "text/display/idle": { textColor: "foreground", font: "700 72px display" },
        "text/title/idle": { textColor: "foreground", font: "600 34px display" },
        "text/eyebrow/idle": { textColor: "accent", font: "400 13px mono" },
        "text/body/idle": { textColor: "muted-foreground", font: "400 17px body" },
        "text/card/idle": { textColor: "foreground", font: "600 19px display" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [16, 0, 16, 0], kind: "bevel" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 10 }, shadow: { color: "rgba(168,243,255,0.14)", blur: 26, offsetX: 0, offsetY: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 }, spring: { stiffness: 320, damping: 22 }, decor: "glass-rim" },
        "card/surface/hovered": { fill: "card", stroke: "accent", strokeWidth: 1.5, corners: { radius: [16, 0, 16, 0], kind: "bevel" }, inset: { stroke: "accent", strokeWidth: 1.5, gap: 2 }, shadow: { color: "rgba(255,61,113,0.32)", blur: 30, offsetX: 0, offsetY: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 }, spring: { stiffness: 320, damping: 22 }, decor: "glass-rim" },
        "text/numeral/idle": { textColor: "accent", font: "700 88px display" },
        "pulse/call/idle": { on: "surface/ground/idle", fill: "accent", stroke: "accent", textColor: "foreground", font: "700 13px mono" },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2.5, corners: { radius: [16, 0, 16, 0], kind: "bevel" }, inset: { stroke: "ring", strokeWidth: 1.5, gap: 4 }, shadow: { color: "rgba(168,243,255,0.2)", blur: 26, offsetX: 0, offsetY: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 }, spring: { stiffness: 320, damping: 22 }, decor: "glass-rim" },
        "card/surface/pressed": { fill: "surface", stroke: "accent", strokeWidth: 2, corners: { radius: [16, 0, 16, 0], kind: "bevel" }, inset: { stroke: "accent", strokeWidth: 2, gap: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 }, spring: { stiffness: 400, damping: 20 } },
        "card/header/idle": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [16, 0, 0, 0], kind: "bevel" }, textColor: "foreground", font: "600 12px display", on: "card/header/idle" },
        "card/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [2, 5] },
        "card/media/idle": { fill: "muted", stroke: "border", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "bevel" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 13px mono", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 1, corners: { radius: [0, 14, 0, 14], kind: "bevel" }, inset: { stroke: "foreground", strokeWidth: 1, gap: 10 }, shadow: { color: "rgba(168,243,255,0.12)", blur: 26, offsetX: 0, offsetY: 0 }, backdrop: { blur: 16, tint: "rgba(15,22,29,0.62)", saturate: 1.4 } },
        "panel/header/idle": { fill: "surface", stroke: "border", strokeWidth: 1, corners: { radius: [0, 14, 0, 0], kind: "bevel" }, textColor: "foreground", font: "600 12px display" },
        "panel/divider/idle": { stroke: "border", strokeWidth: 1, strokeDash: [2, 5] },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "border", strokeWidth: 1, strokeDash: [2, 6] },
        "focus/ring/outer": { stroke: "background", strokeWidth: 5 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2.5 },
        "textfield/default/idle": { fill: "surface", stroke: "input", strokeWidth: 1, corners: { radius: [5, 5, 5, 5], kind: "notch" }, inset: { stroke: "border", strokeWidth: 1, gap: 5 }, textColor: "foreground", font: "400 16px mono" },
        "textfield/default/hovered": { fill: "surface", stroke: "accent", strokeWidth: 1, corners: { radius: [5, 5, 5, 5], kind: "notch" }, inset: { stroke: "accent", strokeWidth: 1, gap: 3 }, textColor: "foreground", font: "400 16px mono" },
        "textfield/default/focused": { fill: "surface", stroke: "ring", strokeWidth: 2, corners: { radius: [5, 5, 5, 5], kind: "notch" }, inset: { stroke: "ring", strokeWidth: 1.5, gap: 2 }, textColor: "foreground", font: "400 16px mono" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "400 16px mono" },
        "morph/default/idle": { fill: "secondary" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet q = min(p, s - p);\nlet arm = clamp(m * 0.3, 18.0, 56.0);\nlet v = sg_line(q.x - 8.0, 1.4) * (1.0 - smoothstep(arm - 1.0, arm, q.y)) * smoothstep(6.0, 7.0, q.y);\nlet h = sg_line(q.y - 8.0, 1.4) * (1.0 - smoothstep(arm - 1.0, arm, q.x)) * smoothstep(6.0, 7.0, q.x);\nlet scan = step(fract(p.y / 3.0), 0.34) * 0.12;\nlet tk = step(s.x - 90.0, p.x) * step(abs(p.y - 17.0), 3.0) * (1.0 - smoothstep(0.4, 1.2, min(fract(p.x / 9.0), 1.0 - fract(p.x / 9.0)) * 9.0));\nlet col = mix(px.color.rgb, vec3<f32>(1.0, 0.15, 0.55), tk);\nreturn sg_out(px, col, max(max(v, h), max(scan, tk)));\n}\n", params: [0, 0, 0, 0], live: false } },
        "stack/closing/idle": { fill: "surface", stroke: "accent", strokeWidth: 1.5, corners: { radius: [20, 0, 20, 0], kind: "bevel" }, inset: { stroke: "accent", strokeWidth: 1, gap: 8 }, shadow: { color: "rgba(255,61,113,0.28)", blur: 28, offsetX: 0, offsetY: 0 }, spring: { stiffness: 320, damping: 22 } },
        "pressable/secondary/pressed": { fill: "surface", stroke: "accent", strokeWidth: 1.5, corners: { radius: [6, 6, 6, 6], kind: "notch" }, inset: { stroke: "accent", strokeWidth: 2, gap: 0 }, textColor: "foreground", font: "600 13px display" },
        "text/inverse/idle": { textColor: "foreground", font: "400 15px mono", on: "section/band/idle" },
        "grid/rule/idle": { stroke: "border", strokeWidth: 1, strokeDash: [2, 6] },
        "grid/border/idle": { stroke: "foreground", strokeWidth: 1 }
      }
    layout: { hero: "full-bleed", columns: 12, asymmetry: 0.0, ornament: "frame", align: "center", imageTreatment: "scanline", sectionGap: 96, gutter: 32 }
    motion: { signature: "scan-lock", stiffness: 320, damping: 22, stagger: 45, enterMs: 900, keyframes: [{ at: 0, opacity: 0, offsetX: 0, offsetY: 0, scale: 1.18, rotate: 0 }, { at: 0.1, opacity: 0.008, offsetX: 0, offsetY: 0, scale: 1.179, rotate: 0 }, { at: 0.2, opacity: 0.036, offsetX: 0, offsetY: 0, scale: 1.173, rotate: 0 }, { at: 0.3, opacity: 0.099, offsetX: 0, offsetY: 0, scale: 1.162, rotate: 0 }, { at: 0.4, opacity: 0.23, offsetX: 0, offsetY: 0, scale: 1.139, rotate: 0 }, { at: 0.5, opacity: 0.5, offsetX: 0, offsetY: 0, scale: 1.09, rotate: 0 }, { at: 0.6, opacity: 0.77, offsetX: 0, offsetY: 0, scale: 1.041, rotate: 0 }, { at: 0.7, opacity: 0.901, offsetX: 0, offsetY: 0, scale: 1.018, rotate: 0 }, { at: 0.8, opacity: 0.964, offsetX: 0, offsetY: 0, scale: 1.007, rotate: 0 }, { at: 0.9, opacity: 0.992, offsetX: 0, offsetY: 0, scale: 1.001, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/iot/"
  }
}
