app std-rasm-system-maison-luxe [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-rasm-system-maison-luxe — the Maison Luxe design system for a Rasm page, anchored on Aesop store design and Hermes catalogues (https://www.aesop.com). Colour: #F4EFE7 ground, #2A2622 ink, #B08D57 gold accent. Type: Italiana over Raleway. Grid: a wide horizontal strip grid with golden-ratio frames. Motion: the silk-slow easing (cubic-bezier 0.22,0.61,0.36,1.00); entrance: rooms reveal sideways with long fades. Interaction: the image slowly zooms 3%. Imagery: full-bleed architectural photography. Voice: understated, refined, few adjectives. Components: buttons are hairline text with a gold underline; cards are framed photographs. Data: none, no charts. Sound: a soft key turn on press, off until the viewer turns it on. A page extends RasmPage from this file and overrides any layer knob."
]

uses Shell from "std/behaviors/std-rasm-page"

orbital RasmPage = Shell.orbitals.RasmPage {
  config {
    system: "maison-luxe"
    palette: {background: "#F4EFE7", foreground: "#2A2622", card: "#FAF8F4", "card-foreground": "#2A2622", surface: "#EDE7DD", muted: "#E4DDD1", "muted-foreground": "#5F5A54", border: "#8A857D", input: "#85807A", primary: "#B08D57", "primary-hover": "#C4A26B", "primary-foreground": "#241F1A", secondary: "#FAF8F4", "secondary-foreground": "#2A2622", "secondary-hover": "#E4DDD1", accent: "#B08D57", "accent-foreground": "#241F1A", ring: "#7A5C2C", "series-1": "#B08D57", "series-2": "#2A2622", "series-3": "#CFB998", "series-4": "#8F8A82", "series-5": "#745F3F"}
    fonts: { display: { family: "Italiana", file: "https://almadar-kflow-assets.web.app/fonts/italiana/Italiana-Regular.ttf", generic: "serif" }, body: { family: "Raleway", file: "https://almadar-kflow-assets.web.app/fonts/raleway/Raleway%5Bwght%5D.ttf", generic: "sans-serif" } }
    looks: {
        "surface/ground/idle": { fill: "background" },
        "stack/card/idle": { fill: "card", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "primary", strokeWidth: 0.75, gap: 8 }, spring: { stiffness: 70, damping: 22 } },
        "stack/panel/idle": { fill: "card", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "primary", strokeWidth: 0.75, gap: 8 }, spring: { stiffness: 70, damping: 22 } },
        "stack/hero/idle": { corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "stack/bar/idle": { fill: "background", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/primary/idle": { stroke: "ring", strokeWidth: 0.75, textColor: "foreground", font: "500 13px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 70, damping: 22 } },
        "pressable/primary/hovered": { fill: "surface", stroke: "primary", strokeWidth: 0.75, textColor: "foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 70, damping: 22 } },
        "pressable/primary/pressed": { fill: "primary", textColor: "primary-foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 110, damping: 24 } },
        "pressable/primary/focused": { stroke: "ring", strokeWidth: 2, textColor: "foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/secondary/idle": { stroke: "border", strokeWidth: 0.75, textColor: "foreground", font: "500 13px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 70, damping: 22 } },
        "pressable/secondary/hovered": { stroke: "border", strokeWidth: 0.75, textColor: "foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 70, damping: 22 } },
        "pressable/secondary/pressed": { fill: "muted", textColor: "foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/secondary/disabled": { textColor: "muted-foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "pressable/secondary/focused": { stroke: "ring", strokeWidth: 2, textColor: "foreground", font: "500 12px body", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "toggle/check/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/check/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-idle": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "toggle/switch/off-hovered": { on: "surface/ground/idle", fill: "muted", stroke: "input", strokeWidth: 1.4, corners: { radius: [10, 10, 10, 10], kind: "round" }, textColor: "foreground", font: "500 15px body" },
        "range/default/fill": { textColor: "primary-foreground" },
        "range/default/thumb-dragging": { textColor: "primary-foreground" },
        "range/default/thumb-hovered": { stroke: "input" },
        "range/default/thumb-idle": { stroke: "input" },
        "card/surface/idle": { fill: "card", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "primary", strokeWidth: 0.75, gap: 8 }, spring: { stiffness: 70, damping: 22 } },
        "card/surface/hovered": { fill: "card", stroke: "ring", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, inset: { stroke: "primary", strokeWidth: 0.75, gap: 12 }, spring: { stiffness: 70, damping: 22 } },
        "card/surface/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 70, damping: 22 } },
        "card/surface/pressed": { fill: "surface", stroke: "ring", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" }, spring: { stiffness: 110, damping: 24 } },
        "card/header/idle": { fill: "card", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 11px body", on: "card/header/idle" },
        "card/divider/idle": { stroke: "primary", strokeWidth: 0.75 },
        "card/media/idle": { fill: "muted", corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "card/meta/idle": { textColor: "muted-foreground", font: "400 12px body", on: "card/surface/idle" },
        "panel/surface/idle": { fill: "card", stroke: "border", strokeWidth: 0.75, corners: { radius: [0, 0, 0, 0], kind: "round" } },
        "panel/header/idle": { fill: "surface", corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "500 11px body" },
        "panel/divider/idle": { stroke: "primary", strokeWidth: 0.75 },
        "section/band/idle": { fill: "surface" },
        "section/rule/idle": { stroke: "primary", strokeWidth: 0.75 },
        "focus/ring/outer": { stroke: "background", strokeWidth: 4 },
        "focus/ring/inner": { stroke: "ring", strokeWidth: 2 },
        "textfield/default/idle": { fill: "card", stroke: "input", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "300 16px body" },
        "textfield/default/hovered": { fill: "card", stroke: "foreground", strokeWidth: 1, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "300 16px body" },
        "textfield/default/focused": { fill: "card", stroke: "ring", strokeWidth: 2, corners: { radius: [0, 0, 0, 0], kind: "round" }, textColor: "foreground", font: "300 16px body" },
        "textfield/default/placeholder": { textColor: "placeholder", font: "300 16px body" },
        "morph/default/idle": { fill: "accent" },
        "grid/rule/idle": { stroke: "primary", strokeWidth: 0.5 },
        "text/display/idle": { textColor: "foreground", font: "400 64px display" },
        "text/poster/idle": { textColor: "foreground", font: "400 84px display" },
        "text/numeral/idle": { textColor: "foreground", font: "400 56px display" },
        "text/quote/idle": { textColor: "foreground", font: "400 30px display" },
        "text/title/idle": { textColor: "foreground", font: "400 38px display" },
        "text/eyebrow/idle": { textColor: "muted-foreground", font: "500 11px body" },
        "text/body/idle": { textColor: "foreground", font: "300 16px body" },
        "text/card/idle": { textColor: "card-foreground", font: "400 24px display", on: "card/surface/idle" },
        "text/inverse/idle": { textColor: "primary-foreground", font: "400 24px display", on: "section/band/idle" },
        "text/caption/idle": { textColor: "muted-foreground", font: "400 12px body" },
        "text/label/idle": { textColor: "foreground", font: "500 11px body" },
        "ornament/signature/idle": { fill: "foreground", material: { wgsl: "fn sg_out(px: Pixel, col: vec3<f32>, a: f32) -> vec4<f32> { let k = clamp(a, 0.0, 1.0) * px.color.a; return vec4<f32>(col, k); }\nfn sg_box(p: vec2<f32>, h: vec2<f32>) -> f32 { let q = abs(p) - h; return length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0); }\nfn sg_fill(d: f32) -> f32 { return 1.0 - smoothstep(-0.7, 0.7, d); }\nfn sg_line(d: f32, w: f32) -> f32 { return 1.0 - smoothstep(w - 0.7, w + 0.7, abs(d)); }\nfn shade(px: Pixel) -> vec4<f32> {\nlet p = px.local;\nlet s = px.size;\nlet c = s * 0.5;\nlet m = min(s.x, s.y);\nlet gold = vec3<f32>(0.8, 0.66, 0.34);\nlet d1 = sg_box(p - c, c - vec2<f32>(8.0, 8.0));\nlet d2 = sg_box(p - c, c - vec2<f32>(13.0, 13.0));\nlet q = abs(p - c) - (c - vec2<f32>(8.0, 8.0));\nlet dia = sg_fill(abs(q.x) + abs(q.y) - 4.0);\nreturn sg_out(px, gold, max(max(sg_line(d1, 0.5), sg_line(d2, 0.35) * 0.7), dia));\n}\n", params: [0, 0, 0, 0], live: false } }
      }
    systemBreakpointLooks: { phone: { "text/display/idle": { textColor: "foreground", font: "400 40px display" }, "text/title/idle": { textColor: "foreground", font: "400 30px display" }, "text/numeral/idle": { textColor: "foreground", font: "400 44px display" }, "text/poster/idle": { textColor: "foreground", font: "400 44px display" } }, tablet: { "text/display/idle": { textColor: "foreground", font: "400 52px display" } } }
    layout: { hero: "full-bleed", columns: 8, asymmetry: 0.382, ornament: "rule", align: "center", imageTreatment: "none", sectionGap: 160, gutter: 64 }
    motion: { signature: "silk-slow", stiffness: 60, damping: 22, stagger: 240, enterMs: 1600, keyframes: [{ at: 0, opacity: 0, offsetX: 56, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.1, opacity: 0.271, offsetX: 40.851, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.2, opacity: 0.501, offsetX: 27.933, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.3, opacity: 0.673, offsetX: 18.336, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.4, opacity: 0.792, offsetX: 11.663, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.5, opacity: 0.873, offsetX: 7.118, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.6, opacity: 0.927, offsetX: 4.061, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.7, opacity: 0.963, offsetX: 2.061, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.8, opacity: 0.985, offsetX: 0.835, offsetY: 0, scale: 1, rotate: 0 }, { at: 0.9, opacity: 0.997, offsetX: 0.192, offsetY: 0, scale: 1, rotate: 0 }, { at: 1, opacity: 1, offsetX: 0, offsetY: 0, scale: 1, rotate: 0 }] }
    sounds: { down: { path: "press.wav", volume: 0.5 } }
    soundBase: "https://almadar-kflow-assets.web.app/sounds/property/"
  }
}
