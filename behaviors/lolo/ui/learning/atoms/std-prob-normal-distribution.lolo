app std-prob-normal-distribution "1.0.0"
"Normal-distribution engine — draws the Gaussian bell curve on a math-canvas with the mean line and one-standard-deviation band marked; learners drag the mean and standard-deviation sliders and watch the curve shift and flatten while the peak height and 68% interval readouts update. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital NormalDistributionEngineOrbital {
  type MathCanvasCurvesItem = {
    label : string
    color : string
    samples : [MathCanvasCurvesItemSamplesItem]!
  }
  type MathCanvasCurvesItemSamplesItem = {
    x : number!
    y : number!
  }
  type NormalDistShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [NormalDistShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type NormalDistShapePoint = {
    x : number!
    y : number!
  }

  entity NormalDistributionScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    mean : number = 0
    stdDev : number = 1
    peak : number = 0
    yTop : number = 1
    curves : [MathCanvasCurvesItem]
    shapes : [NormalDistShape]
  }

  trait NormalDistributionSim -> @rebindable NormalDistributionScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (let (
            (mu @config.mean)
            (sigma @config.stdDev)
            (peakY (/ 1 (* @sigma (math/sqrt 6.28318530717959))))
            (span (- @config.xMax @config.xMin))
            (samples (array/map (array/range 0 81) (fn (i)
              (let (
                  (x (+ @config.xMin (* @i (/ @span 80))))
                  (z (/ (- @x @mu) @sigma))
                )
                { x: @x, y: (* @peakY (math/pow 2.71828182845905 (* -0.5 (* @z @z)))) }))))
            (yTopV (math/max @config.yMax (* 1.25 @peakY)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (muPx (+ 24 (* (/ (- @mu @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigLoPx (+ 24 (* (/ (- (- @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigHiPx (+ 24 (* (/ (- (+ @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (baseY (- @config.height (+ 24 (* (/ (- 0 @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (peakPxY (- @config.height (+ 24 (* (/ (- @peakY @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (sigPxY (- @config.height (+ 24 (* (/ (- (* 0.6065 @peakY) @config.yMin) (- @yTopV @config.yMin)) @plotH))))
          )
          (do
            (set @entity.active true)
            (set @entity.title @config.title)
            (set @entity.mean @mu)
            (set @entity.stdDev @sigma)
            (set @entity.peak @peakY)
            (set @entity.yTop @yTopV)
            (set @entity.curves [{ label: "f(x)", color: @config.color, samples: @samples }])
            (set @entity.shapes [
              { type: "line", x1: @muPx, y1: @baseY, x2: @muPx, y2: @peakPxY, color: "#0f172a", lineWidth: 2 },
              { type: "line", x1: @sigLoPx, y1: @baseY, x2: @sigLoPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "line", x1: @sigHiPx, y1: @baseY, x2: @sigHiPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "text", x: @muPx, y: (- @peakPxY 8), text: "mean", color: "#0f172a", fontSize: 11, align: "center" }
            ])))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Mean: " (math/round @entity.mean 2) " — slides the whole curve left and right") },
                    { type: range-slider, min: -3, max: 3, step: 0.1, value: @entity.mean, showTooltip: true, action: "SET_MEAN" }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Standard deviation: " (math/round @entity.stdDev 2) " — smaller is taller and narrower, larger is flatter and wider") },
                    { type: range-slider, min: 0.3, max: 2.5, step: 0.05, value: @entity.stdDev, showTooltip: true, action: "SET_STDDEV" }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, title: "", xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @entity.yTop, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Peak height f(mean) = " (math/round @entity.peak 3) " — about 68% of the probability mass lies between " (math/round (- @entity.mean @entity.stdDev) 2) " and " (math/round (+ @entity.mean @entity.stdDev) 2) " (the gray band edges)") }
              ] }
          ]
        })
        (emit DIST_UPDATED { curves: @entity.curves, mean: @entity.mean, stdDev: @entity.stdDev })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (let (
            (mu @config.mean)
            (sigma @config.stdDev)
            (peakY (/ 1 (* @sigma (math/sqrt 6.28318530717959))))
            (span (- @config.xMax @config.xMin))
            (samples (array/map (array/range 0 81) (fn (i)
              (let (
                  (x (+ @config.xMin (* @i (/ @span 80))))
                  (z (/ (- @x @mu) @sigma))
                )
                { x: @x, y: (* @peakY (math/pow 2.71828182845905 (* -0.5 (* @z @z)))) }))))
            (yTopV (math/max @config.yMax (* 1.25 @peakY)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (muPx (+ 24 (* (/ (- @mu @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigLoPx (+ 24 (* (/ (- (- @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigHiPx (+ 24 (* (/ (- (+ @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (baseY (- @config.height (+ 24 (* (/ (- 0 @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (peakPxY (- @config.height (+ 24 (* (/ (- @peakY @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (sigPxY (- @config.height (+ 24 (* (/ (- (* 0.6065 @peakY) @config.yMin) (- @yTopV @config.yMin)) @plotH))))
          )
          (do
            (set @entity.active true)
            (set @entity.title @config.title)
            (set @entity.mean @mu)
            (set @entity.stdDev @sigma)
            (set @entity.peak @peakY)
            (set @entity.yTop @yTopV)
            (set @entity.curves [{ label: "f(x)", color: @config.color, samples: @samples }])
            (set @entity.shapes [
              { type: "line", x1: @muPx, y1: @baseY, x2: @muPx, y2: @peakPxY, color: "#0f172a", lineWidth: 2 },
              { type: "line", x1: @sigLoPx, y1: @baseY, x2: @sigLoPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "line", x1: @sigHiPx, y1: @baseY, x2: @sigHiPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "text", x: @muPx, y: (- @peakPxY 8), text: "mean", color: "#0f172a", fontSize: 11, align: "center" }
            ])))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Mean: " (math/round @entity.mean 2) " — slides the whole curve left and right") },
                    { type: range-slider, min: -3, max: 3, step: 0.1, value: @entity.mean, showTooltip: true, action: "SET_MEAN" }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Standard deviation: " (math/round @entity.stdDev 2) " — smaller is taller and narrower, larger is flatter and wider") },
                    { type: range-slider, min: 0.3, max: 2.5, step: 0.05, value: @entity.stdDev, showTooltip: true, action: "SET_STDDEV" }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, title: "", xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @entity.yTop, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Peak height f(mean) = " (math/round @entity.peak 3) " — about 68% of the probability mass lies between " (math/round (- @entity.mean @entity.stdDev) 2) " and " (math/round (+ @entity.mean @entity.stdDev) 2) " (the gray band edges)") }
              ] }
          ]
        })
        (emit DIST_UPDATED { curves: @entity.curves, mean: @entity.mean, stdDev: @entity.stdDev })

      SET_MEAN -> idle when (== @entity.active true)
        (let (
            (mu (math/clamp ?value -3 3))
            (sigma @entity.stdDev)
            (peakY (/ 1 (* @sigma (math/sqrt 6.28318530717959))))
            (span (- @config.xMax @config.xMin))
            (samples (array/map (array/range 0 81) (fn (i)
              (let (
                  (x (+ @config.xMin (* @i (/ @span 80))))
                  (z (/ (- @x @mu) @sigma))
                )
                { x: @x, y: (* @peakY (math/pow 2.71828182845905 (* -0.5 (* @z @z)))) }))))
            (yTopV (math/max @config.yMax (* 1.25 @peakY)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (muPx (+ 24 (* (/ (- @mu @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigLoPx (+ 24 (* (/ (- (- @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigHiPx (+ 24 (* (/ (- (+ @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (baseY (- @config.height (+ 24 (* (/ (- 0 @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (peakPxY (- @config.height (+ 24 (* (/ (- @peakY @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (sigPxY (- @config.height (+ 24 (* (/ (- (* 0.6065 @peakY) @config.yMin) (- @yTopV @config.yMin)) @plotH))))
          )
          (do
            (set @entity.mean @mu)
            (set @entity.peak @peakY)
            (set @entity.yTop @yTopV)
            (set @entity.curves [{ label: "f(x)", color: @config.color, samples: @samples }])
            (set @entity.shapes [
              { type: "line", x1: @muPx, y1: @baseY, x2: @muPx, y2: @peakPxY, color: "#0f172a", lineWidth: 2 },
              { type: "line", x1: @sigLoPx, y1: @baseY, x2: @sigLoPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "line", x1: @sigHiPx, y1: @baseY, x2: @sigHiPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "text", x: @muPx, y: (- @peakPxY 8), text: "mean", color: "#0f172a", fontSize: 11, align: "center" }
            ])))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Mean: " (math/round @entity.mean 2) " — slides the whole curve left and right") },
                    { type: range-slider, min: -3, max: 3, step: 0.1, value: @entity.mean, showTooltip: true, action: "SET_MEAN" }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Standard deviation: " (math/round @entity.stdDev 2) " — smaller is taller and narrower, larger is flatter and wider") },
                    { type: range-slider, min: 0.3, max: 2.5, step: 0.05, value: @entity.stdDev, showTooltip: true, action: "SET_STDDEV" }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, title: "", xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @entity.yTop, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Peak height f(mean) = " (math/round @entity.peak 3) " — about 68% of the probability mass lies between " (math/round (- @entity.mean @entity.stdDev) 2) " and " (math/round (+ @entity.mean @entity.stdDev) 2) " (the gray band edges)") }
              ] }
          ]
        })
        (emit DIST_UPDATED { curves: @entity.curves, mean: @entity.mean, stdDev: @entity.stdDev })

      SET_STDDEV -> idle when (== @entity.active true)
        (let (
            (mu @entity.mean)
            (sigma (math/clamp ?value 0.3 2.5))
            (peakY (/ 1 (* @sigma (math/sqrt 6.28318530717959))))
            (span (- @config.xMax @config.xMin))
            (samples (array/map (array/range 0 81) (fn (i)
              (let (
                  (x (+ @config.xMin (* @i (/ @span 80))))
                  (z (/ (- @x @mu) @sigma))
                )
                { x: @x, y: (* @peakY (math/pow 2.71828182845905 (* -0.5 (* @z @z)))) }))))
            (yTopV (math/max @config.yMax (* 1.25 @peakY)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (muPx (+ 24 (* (/ (- @mu @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigLoPx (+ 24 (* (/ (- (- @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (sigHiPx (+ 24 (* (/ (- (+ @mu @sigma) @config.xMin) (- @config.xMax @config.xMin)) @plotW)))
            (baseY (- @config.height (+ 24 (* (/ (- 0 @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (peakPxY (- @config.height (+ 24 (* (/ (- @peakY @config.yMin) (- @yTopV @config.yMin)) @plotH))))
            (sigPxY (- @config.height (+ 24 (* (/ (- (* 0.6065 @peakY) @config.yMin) (- @yTopV @config.yMin)) @plotH))))
          )
          (do
            (set @entity.stdDev @sigma)
            (set @entity.peak @peakY)
            (set @entity.yTop @yTopV)
            (set @entity.curves [{ label: "f(x)", color: @config.color, samples: @samples }])
            (set @entity.shapes [
              { type: "line", x1: @muPx, y1: @baseY, x2: @muPx, y2: @peakPxY, color: "#0f172a", lineWidth: 2 },
              { type: "line", x1: @sigLoPx, y1: @baseY, x2: @sigLoPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "line", x1: @sigHiPx, y1: @baseY, x2: @sigHiPx, y2: @sigPxY, color: "#94a3b8", lineWidth: 1.5 },
              { type: "text", x: @muPx, y: (- @peakPxY 8), text: "mean", color: "#0f172a", fontSize: 11, align: "center" }
            ])))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Mean: " (math/round @entity.mean 2) " — slides the whole curve left and right") },
                    { type: range-slider, min: -3, max: 3, step: 0.1, value: @entity.mean, showTooltip: true, action: "SET_MEAN" }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Standard deviation: " (math/round @entity.stdDev 2) " — smaller is taller and narrower, larger is flatter and wider") },
                    { type: range-slider, min: 0.3, max: 2.5, step: 0.05, value: @entity.stdDev, showTooltip: true, action: "SET_STDDEV" }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, title: "", xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @entity.yTop, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Peak height f(mean) = " (math/round @entity.peak 3) " — about 68% of the probability mass lies between " (math/round (- @entity.mean @entity.stdDev) 2) " and " (math/round (+ @entity.mean @entity.stdDev) 2) " (the gray band edges)") }
              ] }
          ]
        })
        (emit DIST_UPDATED { curves: @entity.curves, mean: @entity.mean, stdDev: @entity.stdDev })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_MEAN {
        value : number
      }
        @description "Learner dragged the mean slider — value is the new center of the distribution; the curve recomputes immediately."
        @tier "domain"
      SET_STDDEV {
        value : number
      }
        @description "Learner dragged the standard-deviation slider — value is the new spread; the curve recomputes immediately."
        @tier "domain"
    }

    emits {
      DIST_UPDATED -> external {
        curves : [MathCanvasCurvesItem]
        mean : number
        stdDev : number
      }
        @description "The recomputed curve and parameters after INIT or a slider change — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "normal distribution, gaussian, bell curve, mean, standard deviation"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Normal Distribution"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      mean : number = 0
        @label "Mean"
        @description "Initial center of the distribution; learners move it with the mean slider."
        @synonyms "mu, average, center"
        @tier "domain"
      stdDev : number = 1
        @label "Standard Deviation"
        @description "Initial spread of the distribution; learners move it with the spread slider."
        @synonyms "sigma, spread, standard deviation"
        @tier "domain"
      color : string = "#3b82f6"
        @label "Curve Color"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @tier "presentation"
      xMin : number = -4
        @label "X Min"
        @tier "presentation"
      xMax : number = 4
        @label "X Max"
        @tier "presentation"
      yMin : number = 0
        @label "Y Min"
        @tier "presentation"
      yMax : number = 0.5
        @label "Y Max"
        @description "Minimum top of the y axis; the canvas grows above it automatically when a small standard deviation pushes the peak higher."
        @tier "presentation"
      showAxes : boolean = true
        @label "Show Axes"
        @tier "presentation"
      showGrid : boolean = true
        @label "Show Grid"
        @tier "presentation"
      gridStep : number = 1
        @label "Grid Step"
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @tier "presentation"
    }
  }

  page "/prob-normal-dist" as NormalDistributionEnginePage -> NormalDistributionSim
}
