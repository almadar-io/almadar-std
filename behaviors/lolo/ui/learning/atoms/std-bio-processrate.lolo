app std-bio-processrate "1.0.0"
"Photosynthesis-style process-rate engine — the learner adjusts light, CO₂, and temperature sliders and watches the process rate and its limiting factor recompute live, with input-node radii/colors on a biology-canvas reflecting each factor's saturation. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital BioProcessRateOrbital {
  type BioProcessRateNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
  }
  type BioProcessRateEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type BioProcessRateShapePoint = {
    x : number!
    y : number!
  }
  type BioProcessRateShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [BioProcessRateShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }

  entity BioProcessRateScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [BioProcessRateNode]
    edges : [BioProcessRateEdge]
    shapes : [BioProcessRateShape]
    light : number
    co2 : number
    temperature : number
    rate : number
    limitingFactor : string
  }

  trait BioProcessRateSim -> @rebindable BioProcessRateScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.edges @config.edges)
        (set @entity.shapes @config.shapes)
        (set @entity.light @config.light)
        (set @entity.co2 @config.co2)
        (set @entity.temperature @config.temperature)
        (let (
            (lightFactor (math/clamp (/ @entity.light @config.lightSaturation) 0 1))
            (co2Factor (math/clamp (/ @entity.co2 @config.co2Saturation) 0 1))
            (tempFactor (math/clamp (- 1 (/ (math/abs (- @entity.temperature @config.tempOptimum)) @config.tempTolerance)) 0 1))
          )
          (let (
              (minFactor (math/min @lightFactor @co2Factor @tempFactor))
              (limiting (if (<= @lightFactor @co2Factor) (if (<= @lightFactor @tempFactor) "light" "temperature") (if (<= @co2Factor @tempFactor) "co2" "temperature")))
            )
            (do
              (set @entity.rate (* @config.maxRate @minFactor))
              (set @entity.limitingFactor @limiting)
              (set @entity.nodes (array/map @config.processNodes (fn n
                (let ( (nid (object/get @n id)) )
                  (if (== @nid "light-in")
                    (object/merge @n { radius: (+ 8 (* @lightFactor 16)), color: (if (== @limiting "light") "#f59e0b" (object/get @n color)) })
                    (if (== @nid "co2-in")
                      (object/merge @n { radius: (+ 8 (* @co2Factor 16)), color: (if (== @limiting "co2") "#f59e0b" (object/get @n color)) })
                      (if (== @nid "temp-in")
                        (object/merge @n { radius: (+ 8 (* @tempFactor 16)), color: (if (== @limiting "temperature") "#f59e0b" (object/get @n color)) })
                        (if (== @nid "output")
                          (object/merge @n { radius: (+ 6 (* @minFactor 30)) })
                          @n))))))))
            )
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: (str/concat @config.processLabel ": " (math/floor @entity.rate) "%") },
                    { type: typography, variant: caption, content: (str/concat "Limiting factor: " @entity.limitingFactor) },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Light intensity" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.light, showTooltip: true, onChange: SET_LIGHT }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "CO₂ concentration" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.co2, showTooltip: true, onChange: SET_CO2 }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Temperature (°C)" },
                        { type: range-slider, min: 0, max: 45, step: 1, value: @entity.temperature, showTooltip: true, onChange: SET_TEMP }
                      ] }
                  ] }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.edges @config.edges)
        (set @entity.shapes @config.shapes)
        (set @entity.light @config.light)
        (set @entity.co2 @config.co2)
        (set @entity.temperature @config.temperature)
        (let (
            (lightFactor (math/clamp (/ @entity.light @config.lightSaturation) 0 1))
            (co2Factor (math/clamp (/ @entity.co2 @config.co2Saturation) 0 1))
            (tempFactor (math/clamp (- 1 (/ (math/abs (- @entity.temperature @config.tempOptimum)) @config.tempTolerance)) 0 1))
          )
          (let (
              (minFactor (math/min @lightFactor @co2Factor @tempFactor))
              (limiting (if (<= @lightFactor @co2Factor) (if (<= @lightFactor @tempFactor) "light" "temperature") (if (<= @co2Factor @tempFactor) "co2" "temperature")))
            )
            (do
              (set @entity.rate (* @config.maxRate @minFactor))
              (set @entity.limitingFactor @limiting)
              (set @entity.nodes (array/map @config.processNodes (fn n
                (let ( (nid (object/get @n id)) )
                  (if (== @nid "light-in")
                    (object/merge @n { radius: (+ 8 (* @lightFactor 16)), color: (if (== @limiting "light") "#f59e0b" (object/get @n color)) })
                    (if (== @nid "co2-in")
                      (object/merge @n { radius: (+ 8 (* @co2Factor 16)), color: (if (== @limiting "co2") "#f59e0b" (object/get @n color)) })
                      (if (== @nid "temp-in")
                        (object/merge @n { radius: (+ 8 (* @tempFactor 16)), color: (if (== @limiting "temperature") "#f59e0b" (object/get @n color)) })
                        (if (== @nid "output")
                          (object/merge @n { radius: (+ 6 (* @minFactor 30)) })
                          @n))))))))
            )
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: biology-canvas,
                    width: @config.width,
                    height: @config.height,
                    backgroundColor: @config.backgroundColor,
                    nodes: @entity.nodes,
                    edges: @entity.edges,
                    shapes: @entity.shapes,
                    interactive: @config.interactive,
                    animate: @config.animate
                  },
                  { type: stack, direction: vertical, gap: sm, children: [
                      { type: typography, variant: h4, content: (str/concat @config.processLabel ": " (math/floor @entity.rate) "%") },
                      { type: typography, variant: caption, content: (str/concat "Limiting factor: " @entity.limitingFactor) },
                      { type: stack, direction: vertical, gap: xs, children: [
                          { type: typography, variant: caption, content: "Light intensity" },
                          { type: range-slider, min: 0, max: 100, step: 1, value: @entity.light, showTooltip: true, onChange: SET_LIGHT }
                        ] },
                      { type: stack, direction: vertical, gap: xs, children: [
                          { type: typography, variant: caption, content: "CO₂ concentration" },
                          { type: range-slider, min: 0, max: 100, step: 1, value: @entity.co2, showTooltip: true, onChange: SET_CO2 }
                        ] },
                      { type: stack, direction: vertical, gap: xs, children: [
                          { type: typography, variant: caption, content: "Temperature (°C)" },
                          { type: range-slider, min: 0, max: 45, step: 1, value: @entity.temperature, showTooltip: true, onChange: SET_TEMP }
                        ] }
                    ] }
                ] }
            ]
        })

      SET_LIGHT -> idle when (== @entity.active true)
        (set @entity.light ?value)
        (let (
            (lightFactor (math/clamp (/ @entity.light @config.lightSaturation) 0 1))
            (co2Factor (math/clamp (/ @entity.co2 @config.co2Saturation) 0 1))
            (tempFactor (math/clamp (- 1 (/ (math/abs (- @entity.temperature @config.tempOptimum)) @config.tempTolerance)) 0 1))
          )
          (let (
              (minFactor (math/min @lightFactor @co2Factor @tempFactor))
              (limiting (if (<= @lightFactor @co2Factor) (if (<= @lightFactor @tempFactor) "light" "temperature") (if (<= @co2Factor @tempFactor) "co2" "temperature")))
            )
            (do
              (set @entity.rate (* @config.maxRate @minFactor))
              (set @entity.limitingFactor @limiting)
              (set @entity.nodes (array/map @config.processNodes (fn n
                (let ( (nid (object/get @n id)) )
                  (if (== @nid "light-in")
                    (object/merge @n { radius: (+ 8 (* @lightFactor 16)), color: (if (== @limiting "light") "#f59e0b" (object/get @n color)) })
                    (if (== @nid "co2-in")
                      (object/merge @n { radius: (+ 8 (* @co2Factor 16)), color: (if (== @limiting "co2") "#f59e0b" (object/get @n color)) })
                      (if (== @nid "temp-in")
                        (object/merge @n { radius: (+ 8 (* @tempFactor 16)), color: (if (== @limiting "temperature") "#f59e0b" (object/get @n color)) })
                        (if (== @nid "output")
                          (object/merge @n { radius: (+ 6 (* @minFactor 30)) })
                          @n))))))))
            )
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: (str/concat @config.processLabel ": " (math/floor @entity.rate) "%") },
                    { type: typography, variant: caption, content: (str/concat "Limiting factor: " @entity.limitingFactor) },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Light intensity" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.light, showTooltip: true, onChange: SET_LIGHT }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "CO₂ concentration" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.co2, showTooltip: true, onChange: SET_CO2 }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Temperature (°C)" },
                        { type: range-slider, min: 0, max: 45, step: 1, value: @entity.temperature, showTooltip: true, onChange: SET_TEMP }
                      ] }
                  ] }
              ]
            }
          ]
        })
        (emit PROCESS_RATE_UPDATED { rate: @entity.rate, limitingFactor: @entity.limitingFactor, light: @entity.light, co2: @entity.co2, temperature: @entity.temperature })

      SET_CO2 -> idle when (== @entity.active true)
        (set @entity.co2 ?value)
        (let (
            (lightFactor (math/clamp (/ @entity.light @config.lightSaturation) 0 1))
            (co2Factor (math/clamp (/ @entity.co2 @config.co2Saturation) 0 1))
            (tempFactor (math/clamp (- 1 (/ (math/abs (- @entity.temperature @config.tempOptimum)) @config.tempTolerance)) 0 1))
          )
          (let (
              (minFactor (math/min @lightFactor @co2Factor @tempFactor))
              (limiting (if (<= @lightFactor @co2Factor) (if (<= @lightFactor @tempFactor) "light" "temperature") (if (<= @co2Factor @tempFactor) "co2" "temperature")))
            )
            (do
              (set @entity.rate (* @config.maxRate @minFactor))
              (set @entity.limitingFactor @limiting)
              (set @entity.nodes (array/map @config.processNodes (fn n
                (let ( (nid (object/get @n id)) )
                  (if (== @nid "light-in")
                    (object/merge @n { radius: (+ 8 (* @lightFactor 16)), color: (if (== @limiting "light") "#f59e0b" (object/get @n color)) })
                    (if (== @nid "co2-in")
                      (object/merge @n { radius: (+ 8 (* @co2Factor 16)), color: (if (== @limiting "co2") "#f59e0b" (object/get @n color)) })
                      (if (== @nid "temp-in")
                        (object/merge @n { radius: (+ 8 (* @tempFactor 16)), color: (if (== @limiting "temperature") "#f59e0b" (object/get @n color)) })
                        (if (== @nid "output")
                          (object/merge @n { radius: (+ 6 (* @minFactor 30)) })
                          @n))))))))
            )
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: (str/concat @config.processLabel ": " (math/floor @entity.rate) "%") },
                    { type: typography, variant: caption, content: (str/concat "Limiting factor: " @entity.limitingFactor) },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Light intensity" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.light, showTooltip: true, onChange: SET_LIGHT }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "CO₂ concentration" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.co2, showTooltip: true, onChange: SET_CO2 }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Temperature (°C)" },
                        { type: range-slider, min: 0, max: 45, step: 1, value: @entity.temperature, showTooltip: true, onChange: SET_TEMP }
                      ] }
                  ] }
              ]
            }
          ]
        })
        (emit PROCESS_RATE_UPDATED { rate: @entity.rate, limitingFactor: @entity.limitingFactor, light: @entity.light, co2: @entity.co2, temperature: @entity.temperature })

      SET_TEMP -> idle when (== @entity.active true)
        (set @entity.temperature ?value)
        (let (
            (lightFactor (math/clamp (/ @entity.light @config.lightSaturation) 0 1))
            (co2Factor (math/clamp (/ @entity.co2 @config.co2Saturation) 0 1))
            (tempFactor (math/clamp (- 1 (/ (math/abs (- @entity.temperature @config.tempOptimum)) @config.tempTolerance)) 0 1))
          )
          (let (
              (minFactor (math/min @lightFactor @co2Factor @tempFactor))
              (limiting (if (<= @lightFactor @co2Factor) (if (<= @lightFactor @tempFactor) "light" "temperature") (if (<= @co2Factor @tempFactor) "co2" "temperature")))
            )
            (do
              (set @entity.rate (* @config.maxRate @minFactor))
              (set @entity.limitingFactor @limiting)
              (set @entity.nodes (array/map @config.processNodes (fn n
                (let ( (nid (object/get @n id)) )
                  (if (== @nid "light-in")
                    (object/merge @n { radius: (+ 8 (* @lightFactor 16)), color: (if (== @limiting "light") "#f59e0b" (object/get @n color)) })
                    (if (== @nid "co2-in")
                      (object/merge @n { radius: (+ 8 (* @co2Factor 16)), color: (if (== @limiting "co2") "#f59e0b" (object/get @n color)) })
                      (if (== @nid "temp-in")
                        (object/merge @n { radius: (+ 8 (* @tempFactor 16)), color: (if (== @limiting "temperature") "#f59e0b" (object/get @n color)) })
                        (if (== @nid "output")
                          (object/merge @n { radius: (+ 6 (* @minFactor 30)) })
                          @n))))))))
            )
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: (str/concat @config.processLabel ": " (math/floor @entity.rate) "%") },
                    { type: typography, variant: caption, content: (str/concat "Limiting factor: " @entity.limitingFactor) },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Light intensity" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.light, showTooltip: true, onChange: SET_LIGHT }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "CO₂ concentration" },
                        { type: range-slider, min: 0, max: 100, step: 1, value: @entity.co2, showTooltip: true, onChange: SET_CO2 }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Temperature (°C)" },
                        { type: range-slider, min: 0, max: 45, step: 1, value: @entity.temperature, showTooltip: true, onChange: SET_TEMP }
                      ] }
                  ] }
              ]
            }
          ]
        })
        (emit PROCESS_RATE_UPDATED { rate: @entity.rate, limitingFactor: @entity.limitingFactor, light: @entity.light, co2: @entity.co2, temperature: @entity.temperature })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_LIGHT {
        value : number
      }
        @description "Learner adjusted the light-intensity slider."
        @tier "domain"
      SET_CO2 {
        value : number
      }
        @description "Learner adjusted the CO₂-concentration slider."
        @tier "domain"
      SET_TEMP {
        value : number
      }
        @description "Learner adjusted the temperature slider."
        @tier "domain"
    }

    emits {
      PROCESS_RATE_UPDATED -> external {
        rate : number
        limitingFactor : string
        light : number
        co2 : number
        temperature : number
      }
        @description "The process rate state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "process rate update, limiting factor, photosynthesis rate, reaction rate"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Photosynthesis Rate"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#f0fdf4"
        @label "Background Color"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      edges : [BioProcessRateEdge] = []
        @label "Edges"
        @description "Optional extra relationship links drawn alongside the process nodes."
        @tier "presentation"
      shapes : [BioProcessRateShape] = []
        @label "Shapes"
        @description "Optional extra declarative shapes drawn alongside the process nodes."
        @tier "presentation"
      processLabel : string = "O₂ output"
        @label "Process Output Label"
        @description "Name of the measured output shown on the rate readout — e.g. O₂ output for photosynthesis, CO₂ output for respiration."
        @tier "domain"
      light : number = 50
        @label "Light Intensity"
        @description "Starting light intensity (0-100) for process-rate mode."
        @tier "domain"
      co2 : number = 50
        @label "CO₂ Concentration"
        @description "Starting CO₂ concentration (0-100) for process-rate mode."
        @tier "domain"
      temperature : number = 25
        @label "Temperature"
        @description "Starting temperature in °C for process-rate mode."
        @tier "domain"
      lightSaturation : number = 70
        @label "Light Saturation Point"
        @description "Light intensity beyond which more light stops raising the rate — the point light stops being the limiting factor."
        @tier "domain"
      co2Saturation : number = 60
        @label "CO₂ Saturation Point"
        @description "CO₂ concentration beyond which more CO₂ stops raising the rate."
        @tier "domain"
      tempOptimum : number = 25
        @label "Optimal Temperature"
        @description "Temperature in °C at which the process runs fastest."
        @tier "domain"
      tempTolerance : number = 15
        @label "Temperature Tolerance"
        @description "Degrees away from tempOptimum before temperature alone drives the rate to zero."
        @tier "domain"
      maxRate : number = 100
        @label "Maximum Rate"
        @description "The process rate, in percent, achieved when no factor is limiting."
        @tier "domain"
      processNodes : [BioProcessRateNode] = [
        { id: "leaf", x: 300, y: 200, radius: 60, color: "#16a34a", label: "Leaf", kind: organism },
        { id: "light-in", x: 300, y: 70, radius: 12, color: "#facc15", label: "Light", kind: molecule },
        { id: "co2-in", x: 140, y: 280, radius: 12, color: "#64748b", label: "CO₂", kind: molecule },
        { id: "temp-in", x: 460, y: 280, radius: 12, color: "#dc2626", label: "Temp", kind: molecule },
        { id: "output", x: 300, y: 330, radius: 10, color: "#0ea5e9", label: "O₂ Output", kind: molecule }
      ]
        @label "Process Nodes"
        @description "Seed nodes for process-rate mode: a central process node plus one node per input factor (ids light-in / co2-in / temp-in) and an output node (id output). Radii and colors are recomputed live from the current rate and limiting factor; provide alternate ids/positions to reskin for a different process."
        @tier "presentation"
    }
  }

  page "/bio-processrate" as BioProcessRatePage -> BioProcessRateSim
}
