app std-algo-queue "1.0.0"
"Algorithm-animation engine (algorithm-canvas): Queue engine — performs enqueue and dequeue operations on a collection of elements, visualized as a sliding window of bars; composed by a learning orbital via `uses`."
orbital QueueEngineOrbital {
  type AlgoBar = {
    value : number!
    color : string
    label : string
  }

  entity QueueScene [runtime] {
    id : string!
    bars : [AlgoBar]
    running : boolean = true
    done : boolean = false
    pushing : boolean = false
    popping : boolean = false
  }

  trait QueueSim -> @rebindable QueueScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.bars @config.bars)
        (set @entity.running @config.running)
        (set @entity.done false)
        (set @entity.pushing false)
        (set @entity.popping false)
        (render-ui main {
          type: algorithm-canvas
          width: @config.width
          height: @config.height
          backgroundColor: @config.backgroundColor
          bars: @entity.bars
        })
        (emit QUEUE_UPDATED { bars: @entity.bars })
    }

    ticks {
      queueTick every 1000ms
        when (and @entity.running (not @entity.done))
        (do
          (if (and (== (array/len @entity.bars) 10) (not @entity.pushing))
            (set @entity.done true)
            (set @entity.done false))
          (if @entity.pushing
            (do
              (set @entity.bars (array/map @entity.bars
                (if (== @index 0)
                  (object/merge @item {
                    value: @config.next_value
                    color: "#3b82f6"
                    label: (string @config.next_value)
                  })
                  @item)))
              (set @entity.pushing false))
            (set @entity.pushing false))
          (if @entity.popping
            (do
              (set @entity.bars (array/map @entity.bars
                (if (== @index 0)
                  (object/merge @item { color: "#e2e8f0", label: "" })
                  @item)))
              (set @entity.popping false))
            (set @entity.popping false))
          (render-ui main {
            type: algorithm-canvas
            width: @config.width
            height: @config.height
            backgroundColor: @config.backgroundColor
            bars: @entity.bars
          })
          (emit QUEUE_UPDATED { bars: @entity.bars })
        )
    }

    emits {
      QUEUE_UPDATED -> external {
        bars : [AlgoBar]
      }
        @description "The current queue state each tick."
        @tier "domain"
    }

    config {
      running : boolean = true
        @label "Running"
        @description "Toggle to start/pause the queue operations."
        @tier "domain"
      pushing : boolean = false
        @label "Enqueue"
        @description "Toggle to enqueue an item."
        @tier "domain"
      popping : boolean = false
        @label "Dequeue"
        @description "Toggle to dequeue an item."
        @tier "domain"
      next_value : number = 0
        @label "Next Value"
        @description "The value to enqueue."
        @tier "domain"
      width : number = 600
        @label "Width"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
      bars : [AlgoBar] = [
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" }
      ]
        @label "Queue Slots"
        @description "Pre-allocated slots for the queue elements."
        @tier "presentation"
    }
  }

  page "/algo-queue" as QueueEnginePage -> QueueSim
}
