app std-prob-confidence "1.0.0"
"Confidence-interval capture engine — each draw samples n values, builds a confidence interval for the mean, and stacks it as a segment; intervals missing the true mean turn red while the running capture rate converges to the nominal confidence level, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital ProbConfidenceOrbital {
  type ProbConfidenceInterval = {
    lo : number!
    hi : number!
    captured : boolean!
  }
  type ProbConfidenceShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbConfidenceShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbConfidenceShapePoint = {
    x : number!
    y : number!
  }

  entity ProbConfidenceScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    level : number
    intervals : [ProbConfidenceInterval]
    intervalsDrawn : number
    captures : number
    lastCaptured : boolean = false
    shapes : [ProbConfidenceShape]
  }

  trait ProbConfidenceSim -> @rebindable ProbConfidenceScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.level @config.confidenceLevel)
        (set @entity.intervals [])
        (set @entity.intervalsDrawn 0)
        (set @entity.captures 0)
        (set @entity.lastCaptured false)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_INTERVAL, label: "Draw Interval", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Confidence level: " (math/round (* @entity.level 100)) "% — sample size n: " @config.sampleSize) },
                { type: range-slider, min: 0.5, max: 0.99, step: 0.01, value: @entity.level, showTooltip: true, action: "SET_LEVEL" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: meter, value: (if (> @entity.intervalsDrawn 0) (math/round (* 100 (/ @entity.captures @entity.intervalsDrawn)) 1) 0), min: 0, max: 100, unit: "%", label: "Capture rate", showValue: true },
                { type: typography, variant: body, content: (str/concat @entity.intervalsDrawn " interval(s) — " @entity.captures " captured the true mean " @config.trueMean) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.level @config.confidenceLevel)
        (set @entity.intervals [])
        (set @entity.intervalsDrawn 0)
        (set @entity.captures 0)
        (set @entity.lastCaptured false)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_INTERVAL, label: "Draw Interval", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Confidence level: " (math/round (* @entity.level 100)) "% — sample size n: " @config.sampleSize) },
                { type: range-slider, min: 0.5, max: 0.99, step: 0.01, value: @entity.level, showTooltip: true, action: "SET_LEVEL" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: meter, value: (if (> @entity.intervalsDrawn 0) (math/round (* 100 (/ @entity.captures @entity.intervalsDrawn)) 1) 0), min: 0, max: 100, unit: "%", label: "Capture rate", showValue: true },
                { type: typography, variant: body, content: (str/concat @entity.intervalsDrawn " interval(s) — " @entity.captures " captured the true mean " @config.trueMean) }
              ] }
          ]
        })

      DRAW_INTERVAL -> idle when (== @entity.active true)
        (let (
            (z (if (>= @entity.level 0.99) 2.576 (if (>= @entity.level 0.95) 1.96 (if (>= @entity.level 0.9) 1.645 1.28))))
            (sampleMean (/ (array/reduce (array/range @config.sampleSize) 0 (fn (acc j) (+ @acc (+ @config.trueMean (* @config.populationSD (* 2 (- (+ (math/random) (+ (math/random) (math/random))) 1.5))))))) @config.sampleSize))
            (halfW (* @z (/ @config.populationSD (math/sqrt @config.sampleSize))))
            (ivLo (- @sampleMean @halfW))
            (ivHi (+ @sampleMean @halfW))
            (wasCaptured (and (<= @ivLo @config.trueMean) (>= @ivHi @config.trueMean)))
            (newIntervals (array/append @entity.intervals { lo: @ivLo, hi: @ivHi, captured: @wasCaptured }))
            (newCaptures (if @wasCaptured (+ @entity.captures 1) @entity.captures))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (dataMin (- @config.trueMean (* 3 @config.populationSD)))
            (dataSpan (* 6 @config.populationSD))
            (count (array/len @newIntervals))
            (rowH (/ @plotH (math/max @config.maxRows @count)))
            (intervalShapes (array/map (array/range @count) (fn i
              (let (
                  (iv (array/nth @newIntervals @i))
                  (loPx (+ 24 (* (/ (- (object/get @iv lo) @dataMin) @dataSpan) @plotW)))
                  (hiPx (+ 24 (* (/ (- (object/get @iv hi) @dataMin) @dataSpan) @plotW)))
                  (cy (+ 24 (* (+ @i 0.5) @rowH)))
                )
                { type: "line", x1: @loPx, y1: @cy, x2: @hiPx, y2: @cy, color: (if (object/get @iv captured) "#64748b" "#dc2626"), lineWidth: 3 }))))
            (meanPx (+ 24 (* (/ (- @config.trueMean @dataMin) @dataSpan) @plotW)))
          )
          (do
            (set @entity.intervals @newIntervals)
            (set @entity.intervalsDrawn (+ @entity.intervalsDrawn 1))
            (set @entity.captures @newCaptures)
            (set @entity.lastCaptured @wasCaptured)
            (set @entity.shapes (array/append @intervalShapes { type: "line", x1: @meanPx, y1: 24, x2: @meanPx, y2: (+ 24 @plotH), color: "#0f172a", lineWidth: 2 }))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_INTERVAL, label: "Draw Interval", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Confidence level: " (math/round (* @entity.level 100)) "% — sample size n: " @config.sampleSize) },
                { type: range-slider, min: 0.5, max: 0.99, step: 0.01, value: @entity.level, showTooltip: true, action: "SET_LEVEL" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: meter, value: (if (> @entity.intervalsDrawn 0) (math/round (* 100 (/ @entity.captures @entity.intervalsDrawn)) 1) 0), min: 0, max: 100, unit: "%", label: "Capture rate", showValue: true },
                { type: typography, variant: body, content: (str/concat @entity.intervalsDrawn " interval(s) — " @entity.captures " captured the true mean " @config.trueMean) }
              ] }
          ]
        })
        (emit CONFIDENCE_UPDATED { intervalsDrawn: @entity.intervalsDrawn, captures: @entity.captures, captureRate: (if (> @entity.intervalsDrawn 0) (/ @entity.captures @entity.intervalsDrawn) 0) })

      DRAW_MANY -> idle when (== @entity.active true)
        (let (
            (z (if (>= @entity.level 0.99) 2.576 (if (>= @entity.level 0.95) 1.96 (if (>= @entity.level 0.9) 1.645 1.28))))
            (halfW (* @z (/ @config.populationSD (math/sqrt @config.sampleSize))))
            (batch (array/map (array/range @config.intervalsPerStep) (fn d
              (let (
                  (sampleMean (/ (array/reduce (array/range @config.sampleSize) 0 (fn (acc j) (+ @acc (+ @config.trueMean (* @config.populationSD (* 2 (- (+ (math/random) (+ (math/random) (math/random))) 1.5))))))) @config.sampleSize))
                  (ivLo (- @sampleMean @halfW))
                  (ivHi (+ @sampleMean @halfW))
                )
                { lo: @ivLo, hi: @ivHi, captured: (and (<= @ivLo @config.trueMean) (>= @ivHi @config.trueMean)) }))))
            (newIntervals (array/concat @entity.intervals @batch))
            (batchCaptures (array/len (array/filter @batch (fn iv (object/get @iv captured)))))
            (newCaptures (+ @entity.captures @batchCaptures))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (dataMin (- @config.trueMean (* 3 @config.populationSD)))
            (dataSpan (* 6 @config.populationSD))
            (count (array/len @newIntervals))
            (rowH (/ @plotH (math/max @config.maxRows @count)))
            (intervalShapes (array/map (array/range @count) (fn i
              (let (
                  (iv (array/nth @newIntervals @i))
                  (loPx (+ 24 (* (/ (- (object/get @iv lo) @dataMin) @dataSpan) @plotW)))
                  (hiPx (+ 24 (* (/ (- (object/get @iv hi) @dataMin) @dataSpan) @plotW)))
                  (cy (+ 24 (* (+ @i 0.5) @rowH)))
                )
                { type: "line", x1: @loPx, y1: @cy, x2: @hiPx, y2: @cy, color: (if (object/get @iv captured) "#64748b" "#dc2626"), lineWidth: 3 }))))
            (meanPx (+ 24 (* (/ (- @config.trueMean @dataMin) @dataSpan) @plotW)))
          )
          (do
            (set @entity.intervals @newIntervals)
            (set @entity.intervalsDrawn (+ @entity.intervalsDrawn @config.intervalsPerStep))
            (set @entity.captures @newCaptures)
            (set @entity.lastCaptured (object/get (array/last @batch) captured))
            (set @entity.shapes (array/append @intervalShapes { type: "line", x1: @meanPx, y1: 24, x2: @meanPx, y2: (+ 24 @plotH), color: "#0f172a", lineWidth: 2 }))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_INTERVAL, label: "Draw Interval", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Confidence level: " (math/round (* @entity.level 100)) "% — sample size n: " @config.sampleSize) },
                { type: range-slider, min: 0.5, max: 0.99, step: 0.01, value: @entity.level, showTooltip: true, action: "SET_LEVEL" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: meter, value: (if (> @entity.intervalsDrawn 0) (math/round (* 100 (/ @entity.captures @entity.intervalsDrawn)) 1) 0), min: 0, max: 100, unit: "%", label: "Capture rate", showValue: true },
                { type: typography, variant: body, content: (str/concat @entity.intervalsDrawn " interval(s) — " @entity.captures " captured the true mean " @config.trueMean) }
              ] }
          ]
        })
        (emit CONFIDENCE_UPDATED { intervalsDrawn: @entity.intervalsDrawn, captures: @entity.captures, captureRate: (if (> @entity.intervalsDrawn 0) (/ @entity.captures @entity.intervalsDrawn) 0) })

      SET_LEVEL -> idle when (== @entity.active true)
        (set @entity.level (math/clamp ?value 0.5 0.99))
        (set @entity.intervals [])
        (set @entity.intervalsDrawn 0)
        (set @entity.captures 0)
        (set @entity.lastCaptured false)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_INTERVAL, label: "Draw Interval", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Confidence level: " (math/round (* @entity.level 100)) "% — sample size n: " @config.sampleSize) },
                { type: range-slider, min: 0.5, max: 0.99, step: 0.01, value: @entity.level, showTooltip: true, action: "SET_LEVEL" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: meter, value: (if (> @entity.intervalsDrawn 0) (math/round (* 100 (/ @entity.captures @entity.intervalsDrawn)) 1) 0), min: 0, max: 100, unit: "%", label: "Capture rate", showValue: true },
                { type: typography, variant: body, content: (str/concat @entity.intervalsDrawn " interval(s) — " @entity.captures " captured the true mean " @config.trueMean) }
              ] }
          ]
        })
        (emit CONFIDENCE_UPDATED { intervalsDrawn: @entity.intervalsDrawn, captures: @entity.captures, captureRate: (if (> @entity.intervalsDrawn 0) (/ @entity.captures @entity.intervalsDrawn) 0) })

      RESET -> idle when (== @entity.active true)
        (set @entity.intervals [])
        (set @entity.intervalsDrawn 0)
        (set @entity.captures 0)
        (set @entity.lastCaptured false)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_INTERVAL, label: "Draw Interval", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Confidence level: " (math/round (* @entity.level 100)) "% — sample size n: " @config.sampleSize) },
                { type: range-slider, min: 0.5, max: 0.99, step: 0.01, value: @entity.level, showTooltip: true, action: "SET_LEVEL" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: meter, value: (if (> @entity.intervalsDrawn 0) (math/round (* 100 (/ @entity.captures @entity.intervalsDrawn)) 1) 0), min: 0, max: 100, unit: "%", label: "Capture rate", showValue: true },
                { type: typography, variant: body, content: (str/concat @entity.intervalsDrawn " interval(s) — " @entity.captures " captured the true mean " @config.trueMean) }
              ] }
          ]
        })
        (emit CONFIDENCE_UPDATED { intervalsDrawn: @entity.intervalsDrawn, captures: @entity.captures, captureRate: (if (> @entity.intervalsDrawn 0) (/ @entity.captures @entity.intervalsDrawn) 0) })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_LEVEL {
        value : number
      }
        @description "Learner dragged the confidence-level slider — value is the new nominal level; changing it clears the accumulated intervals."
        @tier "domain"
    }

    emits {
      CONFIDENCE_UPDATED -> external {
        intervalsDrawn : number
        captures : number
        captureRate : number
      }
        @description "The capture state after each draw — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "confidence interval, capture rate, interval estimate, coverage"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Confidence Intervals"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      confidenceLevel : number = 0.95
        @label "Confidence Level"
        @description "Nominal confidence level — the long-run fraction of intervals that should capture the true mean."
        @synonyms "confidence level, coverage probability, 95 percent interval"
        @tier "domain"
      sampleSize : number = 20
        @label "Sample Size"
        @description "Number of draws n per sample; larger n makes every interval narrower."
        @synonyms "n, sample size, draws per sample"
        @tier "domain"
      populationSD : number = 12
        @label "Population SD"
        @description "Standard deviation of the population each sample is drawn from — sets interval width together with n."
        @synonyms "standard deviation, sigma, spread"
        @tier "domain"
      trueMean : number = 50
        @label "True Mean"
        @description "Population mean the intervals try to capture; drawn as the dark vertical line."
        @synonyms "population mean, mu, true value"
        @tier "domain"
      intervalsPerStep : number = 20
        @label "Intervals Per Step"
        @description "How many intervals Draw Many adds per click."
        @tier "domain"
      maxRows : number = 40
        @label "Max Rows"
        @description "Row budget for the stacked intervals; beyond this the rows compress to fit."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
    }
  }

  page "/prob-confidence" as ProbConfidencePage -> ProbConfidenceSim
}
