app std-chem-molecule "1.0.0"
"Declarative molecule/reaction diagram — atoms, bonds, and arrows rendered on a chemistry-canvas with no learner-facing transitions. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital ChemMoleculeOrbital {
  type ChemMoleculeAtom = {
    id : string
    x : number!
    y : number!
    element : string
    radius : number
    color : string
  }
  type ChemMoleculeBond = {
    from : string!
    to : string!
    type : "single" | "double" | "triple"
    color : string
  }
  type ChemMoleculeArrow = {
    x : number!
    y : number!
    angle : number
    length : number
    color : string
    label : string
  }
  type ChemMoleculeShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ChemMoleculeShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ChemMoleculeShapePoint = {
    x : number!
    y : number!
  }

  entity ChemMoleculeScene [runtime] {
    id : string!
    title : string
    atoms : [ChemMoleculeAtom]
    bonds : [ChemMoleculeBond]
    arrows : [ChemMoleculeArrow]
    shapes : [ChemMoleculeShape]
  }

  trait ChemMoleculeSim -> @rebindable ChemMoleculeScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.title @config.title)
        (set @entity.atoms @config.atoms)
        (set @entity.bonds @config.bonds)
        (set @entity.arrows @config.arrows)
        (set @entity.shapes @config.shapes)
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: chemistry-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  atoms: @entity.atoms,
                  bonds: @entity.bonds,
                  arrows: @entity.arrows,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                }
              ]
            }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.title @config.title)
        (set @entity.atoms @config.atoms)
        (set @entity.bonds @config.bonds)
        (set @entity.arrows @config.arrows)
        (set @entity.shapes @config.shapes)
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: chemistry-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  atoms: @entity.atoms,
                  bonds: @entity.bonds,
                  arrows: @entity.arrows,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                }
              ]
            }
          ]
        })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Chemistry Lab"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#fafafa"
        @label "Background Color"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      atoms : [ChemMoleculeAtom] = [
        { id: "C", x: 300, y: 200, element: "C", radius: 22, color: "#374151" },
        { id: "O", x: 380, y: 160, element: "O", radius: 20, color: "#dc2626" },
        { id: "H1", x: 240, y: 160, element: "H", radius: 14, color: "#2563eb" },
        { id: "H2", x: 260, y: 270, element: "H", radius: 14, color: "#2563eb" },
        { id: "H3", x: 340, y: 270, element: "H", radius: 14, color: "#2563eb" }
      ]
        @label "Atoms"
        @description "Atoms to render."
        @tier "domain"
      bonds : [ChemMoleculeBond] = [
        { from: "C", to: "O", type: double, color: "#374151" },
        { from: "C", to: "H1", type: single, color: "#374151" },
        { from: "C", to: "H2", type: single, color: "#374151" },
        { from: "C", to: "H3", type: single, color: "#374151" }
      ]
        @label "Bonds"
        @description "Bonds between atoms."
        @tier "domain"
      arrows : [ChemMoleculeArrow] = []
        @label "Arrows"
        @description "Reaction arrows or directional annotations."
        @tier "domain"
      shapes : [ChemMoleculeShape] = []
        @label "Shapes"
        @description "Extra declarative shapes such as electron orbitals or brackets."
        @tier "presentation"
    }
  }

  page "/chem-molecule" as ChemMoleculePage -> ChemMoleculeSim
}
