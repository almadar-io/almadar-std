app std-prob-clt "1.0.0"
"Central Limit Theorem engine — pick a population shape (uniform, skewed, bimodal); each draw takes a sample of size n and drops the sample mean into a growing means-histogram that visibly normalizes, with an optional true-mean marker, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital ProbCltOrbital {
  type ProbCltShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbCltShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbCltShapePoint = {
    x : number!
    y : number!
  }

  entity ProbCltScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    sampleSize : number
    means : [number]
    drawsRun : number
    lastSampleMean : number
    shapes : [ProbCltShape]
  }

  trait ProbCltSim -> @rebindable ProbCltScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.sampleSize @config.sampleSize)
        (set @entity.means [])
        (set @entity.drawsRun 0)
        (set @entity.lastSampleMean 0)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_SAMPLE, label: "Draw Sample", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Sample size n: " @entity.sampleSize) },
                { type: range-slider, min: 2, max: 100, step: 1, value: @entity.sampleSize, showTooltip: true, action: "SET_N" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.valueMax, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.drawsRun " sample(s) drawn — last sample mean " (math/round @entity.lastSampleMean 1) " (population mean " @config.trueMean ")") }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.sampleSize @config.sampleSize)
        (set @entity.means [])
        (set @entity.drawsRun 0)
        (set @entity.lastSampleMean 0)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_SAMPLE, label: "Draw Sample", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Sample size n: " @entity.sampleSize) },
                { type: range-slider, min: 2, max: 100, step: 1, value: @entity.sampleSize, showTooltip: true, action: "SET_N" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.valueMax, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.drawsRun " sample(s) drawn — last sample mean " (math/round @entity.lastSampleMean 1) " (population mean " @config.trueMean ")") }
              ] }
          ]
        })

      DRAW_SAMPLE -> idle when (== @entity.active true)
        (let (
            (sample (array/map (array/range @entity.sampleSize) (fn j
              (if (== @config.populationKind "skewed")
                (* @config.valueMax (* (math/random) (math/random)))
                (if (== @config.populationKind "bimodal")
                  (if (< (math/random) 0.5)
                    (* @config.valueMax (* 0.5 (math/random)))
                    (* @config.valueMax (+ 0.5 (* 0.5 (math/random)))))
                  (* @config.valueMax (math/random)))))))
            (sampleMean (/ (array/reduce @sample 0 (fn (acc v) (+ @acc @v))) @entity.sampleSize))
            (newMeans (array/append @entity.means @sampleMean))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (binW (/ @config.valueMax @config.bins))
            (counts (array/map (array/range @config.bins) (fn b (array/len (array/filter @newMeans (fn m (and (>= @m (* @b @binW)) (< @m (* (+ @b 1) @binW)))))))))
            (maxCount (math/max 1 (array/reduce @counts 0 (fn (acc c) (math/max @acc @c)))))
            (histShapes (array/map (array/range @config.bins) (fn b
              (let (
                  (barH (* (/ (array/nth @counts @b) @maxCount) @plotH))
                )
                { type: "rect", x: (+ 24 (* @b (/ @plotW @config.bins))), y: (- (+ 24 @plotH) @barH), width: (* (/ @plotW @config.bins) 0.9), height: @barH, fill: "#2563eb", lineWidth: 0 }))))
            (trueMeanX (+ 24 (* @plotW (/ @config.trueMean @config.valueMax))))
            (allShapes (if @config.showTrueMean
              (array/append @histShapes { type: "line", x1: @trueMeanX, y1: 24, x2: @trueMeanX, y2: (+ 24 @plotH), color: "#dc2626", lineWidth: 2 })
              @histShapes))
          )
          (do
            (set @entity.means @newMeans)
            (set @entity.drawsRun (+ @entity.drawsRun 1))
            (set @entity.lastSampleMean @sampleMean)
            (set @entity.shapes @allShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_SAMPLE, label: "Draw Sample", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Sample size n: " @entity.sampleSize) },
                { type: range-slider, min: 2, max: 100, step: 1, value: @entity.sampleSize, showTooltip: true, action: "SET_N" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.valueMax, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.drawsRun " sample(s) drawn — last sample mean " (math/round @entity.lastSampleMean 1) " (population mean " @config.trueMean ")") }
              ] }
          ]
        })
        (emit CLT_UPDATED { drawsRun: @entity.drawsRun, lastSampleMean: @entity.lastSampleMean, means: @entity.means })

      DRAW_MANY -> idle when (== @entity.active true)
        (let (
            (batchMeans (array/map (array/range @config.drawsPerStep) (fn d
              (/ (array/reduce (array/map (array/range @entity.sampleSize) (fn j
                (if (== @config.populationKind "skewed")
                  (* @config.valueMax (* (math/random) (math/random)))
                  (if (== @config.populationKind "bimodal")
                    (if (< (math/random) 0.5)
                      (* @config.valueMax (* 0.5 (math/random)))
                      (* @config.valueMax (+ 0.5 (* 0.5 (math/random)))))
                    (* @config.valueMax (math/random)))))) 0 (fn (acc v) (+ @acc @v))) @entity.sampleSize))))
            (newMeans (array/concat @entity.means @batchMeans))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (binW (/ @config.valueMax @config.bins))
            (counts (array/map (array/range @config.bins) (fn b (array/len (array/filter @newMeans (fn m (and (>= @m (* @b @binW)) (< @m (* (+ @b 1) @binW)))))))))
            (maxCount (math/max 1 (array/reduce @counts 0 (fn (acc c) (math/max @acc @c)))))
            (histShapes (array/map (array/range @config.bins) (fn b
              (let (
                  (barH (* (/ (array/nth @counts @b) @maxCount) @plotH))
                )
                { type: "rect", x: (+ 24 (* @b (/ @plotW @config.bins))), y: (- (+ 24 @plotH) @barH), width: (* (/ @plotW @config.bins) 0.9), height: @barH, fill: "#2563eb", lineWidth: 0 }))))
            (trueMeanX (+ 24 (* @plotW (/ @config.trueMean @config.valueMax))))
            (allShapes (if @config.showTrueMean
              (array/append @histShapes { type: "line", x1: @trueMeanX, y1: 24, x2: @trueMeanX, y2: (+ 24 @plotH), color: "#dc2626", lineWidth: 2 })
              @histShapes))
          )
          (do
            (set @entity.means @newMeans)
            (set @entity.drawsRun (+ @entity.drawsRun @config.drawsPerStep))
            (set @entity.lastSampleMean (array/last @newMeans))
            (set @entity.shapes @allShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_SAMPLE, label: "Draw Sample", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Sample size n: " @entity.sampleSize) },
                { type: range-slider, min: 2, max: 100, step: 1, value: @entity.sampleSize, showTooltip: true, action: "SET_N" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.valueMax, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.drawsRun " sample(s) drawn — last sample mean " (math/round @entity.lastSampleMean 1) " (population mean " @config.trueMean ")") }
              ] }
          ]
        })
        (emit CLT_UPDATED { drawsRun: @entity.drawsRun, lastSampleMean: @entity.lastSampleMean, means: @entity.means })

      SET_N -> idle when (== @entity.active true)
        (set @entity.sampleSize (math/round ?value))
        (set @entity.means [])
        (set @entity.drawsRun 0)
        (set @entity.lastSampleMean 0)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_SAMPLE, label: "Draw Sample", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Sample size n: " @entity.sampleSize) },
                { type: range-slider, min: 2, max: 100, step: 1, value: @entity.sampleSize, showTooltip: true, action: "SET_N" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.valueMax, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.drawsRun " sample(s) drawn — last sample mean " (math/round @entity.lastSampleMean 1) " (population mean " @config.trueMean ")") }
              ] }
          ]
        })
        (emit CLT_UPDATED { drawsRun: @entity.drawsRun, lastSampleMean: @entity.lastSampleMean, means: @entity.means })

      RESET -> idle when (== @entity.active true)
        (set @entity.means [])
        (set @entity.drawsRun 0)
        (set @entity.lastSampleMean 0)
        (set @entity.shapes [])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: DRAW_SAMPLE, label: "Draw Sample", variant: primary },
                    { type: button, action: DRAW_MANY, label: "Draw Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Sample size n: " @entity.sampleSize) },
                { type: range-slider, min: 2, max: 100, step: 1, value: @entity.sampleSize, showTooltip: true, action: "SET_N" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.valueMax, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 10, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.drawsRun " sample(s) drawn — last sample mean " (math/round @entity.lastSampleMean 1) " (population mean " @config.trueMean ")") }
              ] }
          ]
        })
        (emit CLT_UPDATED { drawsRun: @entity.drawsRun, lastSampleMean: @entity.lastSampleMean, means: @entity.means })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_N {
        value : number
      }
        @description "Learner dragged the sample-size slider — value is the new n; changing n clears the accumulated means."
        @tier "domain"
    }

    emits {
      CLT_UPDATED -> external {
        drawsRun : number
        lastSampleMean : number
        means : [number]
      }
        @description "The sampling state after each draw — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "sample drawn, means histogram, central limit theorem, sampling distribution"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Central Limit Theorem"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      populationKind : string = "uniform"
        @label "Population Kind"
        @description "Shape of the population each sample is drawn from: uniform, skewed, or bimodal — the CLT normalizes the means-histogram regardless."
        @synonyms "population distribution, skewed distribution, bimodal, uniform distribution, sampling distribution, central limit theorem"
        @tier "domain"
      sampleSize : number = 30
        @label "Sample Size"
        @description "Number of draws n per sample; larger n makes the means-histogram narrower and more normal."
        @synonyms "n, sample size, draws per sample"
        @tier "domain"
      drawsPerStep : number = 25
        @label "Draws Per Step"
        @description "How many samples Draw Many adds to the means-histogram per click."
        @tier "domain"
      trueMean : number = 50
        @label "True Mean"
        @description "Population mean the sample means converge to; drawn as a marker line when Show True Mean is on."
        @synonyms "population mean, expected value, mu"
        @tier "domain"
      valueMax : number = 100
        @label "Value Max"
        @description "Population values range from 0 to this maximum."
        @tier "domain"
      showTrueMean : boolean = true
        @label "Show True Mean"
        @description "Draw a marker line at the population mean."
        @tier "presentation"
      bins : number = 12
        @label "Bins"
        @description "Number of histogram buckets the sample means are counted into."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
    }
  }

  page "/prob-clt" as ProbCltPage -> ProbCltSim
}
