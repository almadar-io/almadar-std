app std-physics-diagram "1.0.0"
"Generic declarative physics-diagram renderer — a fixed roster of labeled points and shapes (field lines, ray paths, or circuit wiring) drawn once on a physics-canvas with no simulation tick. Shape/point vocabulary is entirely config-declared, so the same mechanism serves any static physics sketch. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital PhysicsDiagramOrbital {
  type PhysicsDiagramBody = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
  }
  type PhysicsDiagramShapePoint = {
    x : number!
    y : number!
  }
  type PhysicsDiagramShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [PhysicsDiagramShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }

  entity PhysicsDiagramScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    bodies : [PhysicsDiagramBody]
    shapes : [PhysicsDiagramShape]
  }

  trait PhysicsDiagramSim -> @rebindable PhysicsDiagramScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.bodies @config.bodies)
        (set @entity.shapes @config.shapes)
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: physics-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, bodies: @entity.bodies, shapes: @entity.shapes, showVelocity: false, showForces: false, interactive: @config.interactive, animate: @config.animate }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.bodies @config.bodies)
        (set @entity.shapes @config.shapes)
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: physics-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, bodies: @entity.bodies, shapes: @entity.shapes, showVelocity: false, showForces: false, interactive: @config.interactive, animate: @config.animate }
                ] }
            ]
        })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Physics Lab"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @tier "presentation"
      bodies : [PhysicsDiagramBody] = [
        { id: "ball-a", x: 90, y: 70, radius: 16, color: "#2563eb", label: "A" },
        { id: "ball-b", x: 320, y: 50, radius: 11, color: "#16a34a", label: "B" },
        { id: "ball-c", x: 500, y: 90, radius: 13, color: "#dc2626", label: "C" }
      ]
        @label "Bodies"
        @description "Labeled static points on the canvas — a field source, a ray endpoint, or a circuit node."
        @tier "presentation"
      shapes : [PhysicsDiagramShape] = []
        @label "Shapes"
        @description "Extra declarative shapes such as field lines, ray paths, or circuit wiring."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
    }
  }

  page "/physics-diagram" as PhysicsDiagramPage -> PhysicsDiagramSim
}
