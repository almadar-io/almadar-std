app std-econ-ppf "1.0.0"
"Production-possibilities frontier engine — the learner drags an allocation slider dividing resources between two goods, reads the marginal opportunity cost, and toggles an idle-resources demo that drops actual output inside the frontier, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EconPpfOrbital {
  type EconPpfSample = {
    x : number!
    y : number!
  }
  type EconPpfCurve = {
    label : string
    color : string
    samples : [EconPpfSample]!
  }
  type EconPpfMarker = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }
  type EconPpfGood = {
    key : "A" | "B"!
    label : string!
    maxOutput : number!
  }

  entity EconPpfScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    goodALabel : string
    goodBLabel : string
    goodAMax : number
    goodBMax : number
    allocationShare : number
    outputA : number
    outputB : number
    marginalOppCost : number
    marginalOppCostLabel : string
    wasteActive : boolean
    actualOutputA : number
    actualOutputB : number
    allocationStatusLabel : string
    curves : [EconPpfCurve]
    points : [EconPpfMarker]
  }

  trait EconPpfSim -> @rebindable EconPpfScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.goodALabel (object/get (array/nth @config.goods 0) label))
        (set @entity.goodBLabel (object/get (array/nth @config.goods 1) label))
        (set @entity.goodAMax (object/get (array/nth @config.goods 0) maxOutput))
        (set @entity.goodBMax (object/get (array/nth @config.goods 1) maxOutput))
        (set @entity.allocationShare @config.initialShare)
        (set @entity.wasteActive false)
        (let (
            (shareFrac (/ @entity.allocationShare 100))
            (outA (* @entity.goodAMax @shareFrac))
            (outB (* @entity.goodBMax (math/sqrt (math/max 0 (- 1 (* @shareFrac @shareFrac))))))
            (mrt (if (<= @outB 0) 999999 (/ (* @outA (* @entity.goodBMax @entity.goodBMax)) (* (* @entity.goodAMax @entity.goodAMax) @outB))))
            (mrtLabel (if (<= @outB 0) (str/concat "Fully specialized in " @entity.goodALabel " — no more " @entity.goodBLabel " to give up") (str/concat (math/round @mrt 2) " " @entity.goodBLabel " per additional " @entity.goodALabel)))
            (frontierSamples (array/map (array/range 41) (fn i (let ( (s (/ @i 40)) ) { x: (* @entity.goodAMax @s), y: (* @entity.goodBMax (math/sqrt (math/max 0 (- 1 (* @s @s))))) }))))
            (allocationCurves [ { label: "Production Possibilities Frontier", color: @config.frontierColor, samples: @frontierSamples } ])
            (allocationPoints [
                { x: @outA, y: @outB, label: "Frontier Point", color: @config.frontierPointColor, radius: 6 },
                { x: @outA, y: @outB, label: "Actual Output", color: @config.actualPointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.outputA @outA)
            (set @entity.outputB @outB)
            (set @entity.marginalOppCost @mrt)
            (set @entity.marginalOppCostLabel @mrtLabel)
            (set @entity.actualOutputA @outA)
            (set @entity.actualOutputB @outB)
            (set @entity.allocationStatusLabel "Efficient — on the frontier")
            (set @entity.curves @allocationCurves)
            (set @entity.points @allocationPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @entity.goodAMax, yMin: 0, yMax: @entity.goodBMax, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Share of resources to " @entity.goodALabel ": " @entity.allocationShare "%") },
                    { type: range-slider, min: 0, max: 100, step: @config.allocationStep, value: @entity.allocationShare, showTooltip: true, onChange: ALLOCATE }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TOGGLE_WASTE, label: (if @entity.wasteActive "Remove Idle Resources" "Show Idle Resources (Waste)"), variant: (if @entity.wasteActive "danger" "ghost") }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat @entity.goodALabel ": " (math/round @entity.outputA 1) " — " @entity.goodBLabel ": " (math/round @entity.outputB 1)) },
                { type: typography, variant: body, content: (str/concat "Marginal opportunity cost of the last unit of " @entity.goodALabel ": " @entity.marginalOppCostLabel) },
                { type: alert, variant: (if @entity.wasteActive "warning" "success"), message: (if @entity.wasteActive (str/concat @entity.allocationStatusLabel " — actual output " (math/round @entity.actualOutputA 1) " " @entity.goodALabel " / " (math/round @entity.actualOutputB 1) " " @entity.goodBLabel) @entity.allocationStatusLabel) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.goodALabel (object/get (array/nth @config.goods 0) label))
        (set @entity.goodBLabel (object/get (array/nth @config.goods 1) label))
        (set @entity.goodAMax (object/get (array/nth @config.goods 0) maxOutput))
        (set @entity.goodBMax (object/get (array/nth @config.goods 1) maxOutput))
        (set @entity.allocationShare @config.initialShare)
        (set @entity.wasteActive false)
        (let (
            (shareFrac (/ @entity.allocationShare 100))
            (outA (* @entity.goodAMax @shareFrac))
            (outB (* @entity.goodBMax (math/sqrt (math/max 0 (- 1 (* @shareFrac @shareFrac))))))
            (mrt (if (<= @outB 0) 999999 (/ (* @outA (* @entity.goodBMax @entity.goodBMax)) (* (* @entity.goodAMax @entity.goodAMax) @outB))))
            (mrtLabel (if (<= @outB 0) (str/concat "Fully specialized in " @entity.goodALabel " — no more " @entity.goodBLabel " to give up") (str/concat (math/round @mrt 2) " " @entity.goodBLabel " per additional " @entity.goodALabel)))
            (frontierSamples (array/map (array/range 41) (fn i (let ( (s (/ @i 40)) ) { x: (* @entity.goodAMax @s), y: (* @entity.goodBMax (math/sqrt (math/max 0 (- 1 (* @s @s))))) }))))
            (allocationCurves [ { label: "Production Possibilities Frontier", color: @config.frontierColor, samples: @frontierSamples } ])
            (allocationPoints [
                { x: @outA, y: @outB, label: "Frontier Point", color: @config.frontierPointColor, radius: 6 },
                { x: @outA, y: @outB, label: "Actual Output", color: @config.actualPointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.outputA @outA)
            (set @entity.outputB @outB)
            (set @entity.marginalOppCost @mrt)
            (set @entity.marginalOppCostLabel @mrtLabel)
            (set @entity.actualOutputA @outA)
            (set @entity.actualOutputB @outB)
            (set @entity.allocationStatusLabel "Efficient — on the frontier")
            (set @entity.curves @allocationCurves)
            (set @entity.points @allocationPoints)
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @entity.goodAMax, yMin: 0, yMax: @entity.goodBMax, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                  { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: caption, content: (str/concat "Share of resources to " @entity.goodALabel ": " @entity.allocationShare "%") },
                      { type: range-slider, min: 0, max: 100, step: @config.allocationStep, value: @entity.allocationShare, showTooltip: true, onChange: ALLOCATE }
                    ] },
                  { type: stack, direction: horizontal, gap: sm, children: [
                      { type: button, action: TOGGLE_WASTE, label: (if @entity.wasteActive "Remove Idle Resources" "Show Idle Resources (Waste)"), variant: (if @entity.wasteActive "danger" "ghost") }
                    ] },
                  { type: divider },
                  { type: typography, variant: body, content: (str/concat @entity.goodALabel ": " (math/round @entity.outputA 1) " — " @entity.goodBLabel ": " (math/round @entity.outputB 1)) },
                  { type: typography, variant: body, content: (str/concat "Marginal opportunity cost of the last unit of " @entity.goodALabel ": " @entity.marginalOppCostLabel) },
                  { type: alert, variant: (if @entity.wasteActive "warning" "success"), message: (if @entity.wasteActive (str/concat @entity.allocationStatusLabel " — actual output " (math/round @entity.actualOutputA 1) " " @entity.goodALabel " / " (math/round @entity.actualOutputB 1) " " @entity.goodBLabel) @entity.allocationStatusLabel) }
                ] }
            ]
        })

      ALLOCATE -> idle when (== @entity.active true)
        (set @entity.allocationShare ?value)
        (let (
            (shareFrac (/ @entity.allocationShare 100))
            (outA (* @entity.goodAMax @shareFrac))
            (outB (* @entity.goodBMax (math/sqrt (math/max 0 (- 1 (* @shareFrac @shareFrac))))))
            (mrt (if (<= @outB 0) 999999 (/ (* @outA (* @entity.goodBMax @entity.goodBMax)) (* (* @entity.goodAMax @entity.goodAMax) @outB))))
            (mrtLabel (if (<= @outB 0) (str/concat "Fully specialized in " @entity.goodALabel " — no more " @entity.goodBLabel " to give up") (str/concat (math/round @mrt 2) " " @entity.goodBLabel " per additional " @entity.goodALabel)))
            (actA (if @entity.wasteActive (* @outA @config.wasteFactor) @outA))
            (actB (if @entity.wasteActive (* @outB @config.wasteFactor) @outB))
            (newPoints [
                { x: @outA, y: @outB, label: "Frontier Point", color: @config.frontierPointColor, radius: 6 },
                { x: @actA, y: @actB, label: "Actual Output", color: @config.actualPointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.outputA @outA)
            (set @entity.outputB @outB)
            (set @entity.marginalOppCost @mrt)
            (set @entity.marginalOppCostLabel @mrtLabel)
            (set @entity.actualOutputA @actA)
            (set @entity.actualOutputB @actB)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @entity.goodAMax, yMin: 0, yMax: @entity.goodBMax, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Share of resources to " @entity.goodALabel ": " @entity.allocationShare "%") },
                    { type: range-slider, min: 0, max: 100, step: @config.allocationStep, value: @entity.allocationShare, showTooltip: true, onChange: ALLOCATE }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TOGGLE_WASTE, label: (if @entity.wasteActive "Remove Idle Resources" "Show Idle Resources (Waste)"), variant: (if @entity.wasteActive "danger" "ghost") }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat @entity.goodALabel ": " (math/round @entity.outputA 1) " — " @entity.goodBLabel ": " (math/round @entity.outputB 1)) },
                { type: typography, variant: body, content: (str/concat "Marginal opportunity cost of the last unit of " @entity.goodALabel ": " @entity.marginalOppCostLabel) },
                { type: alert, variant: (if @entity.wasteActive "warning" "success"), message: (if @entity.wasteActive (str/concat @entity.allocationStatusLabel " — actual output " (math/round @entity.actualOutputA 1) " " @entity.goodALabel " / " (math/round @entity.actualOutputB 1) " " @entity.goodBLabel) @entity.allocationStatusLabel) }
              ] }
          ]
        })
        (emit PPF_UPDATED { outputA: @entity.outputA, outputB: @entity.outputB, marginalOppCost: @entity.marginalOppCost, wasteActive: @entity.wasteActive })

      TOGGLE_WASTE -> idle when (== @entity.active true)
        (set @entity.wasteActive (not @entity.wasteActive))
        (let (
            (actA (if @entity.wasteActive (* @entity.outputA @config.wasteFactor) @entity.outputA))
            (actB (if @entity.wasteActive (* @entity.outputB @config.wasteFactor) @entity.outputB))
            (statusLabel (if @entity.wasteActive "Inefficient — idle resources, inside the frontier" "Efficient — on the frontier"))
            (newPoints [
                { x: @entity.outputA, y: @entity.outputB, label: "Frontier Point", color: @config.frontierPointColor, radius: 6 },
                { x: @actA, y: @actB, label: "Actual Output", color: @config.actualPointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.actualOutputA @actA)
            (set @entity.actualOutputB @actB)
            (set @entity.allocationStatusLabel @statusLabel)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @entity.goodAMax, yMin: 0, yMax: @entity.goodBMax, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Share of resources to " @entity.goodALabel ": " @entity.allocationShare "%") },
                    { type: range-slider, min: 0, max: 100, step: @config.allocationStep, value: @entity.allocationShare, showTooltip: true, onChange: ALLOCATE }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TOGGLE_WASTE, label: (if @entity.wasteActive "Remove Idle Resources" "Show Idle Resources (Waste)"), variant: (if @entity.wasteActive "danger" "ghost") }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat @entity.goodALabel ": " (math/round @entity.outputA 1) " — " @entity.goodBLabel ": " (math/round @entity.outputB 1)) },
                { type: typography, variant: body, content: (str/concat "Marginal opportunity cost of the last unit of " @entity.goodALabel ": " @entity.marginalOppCostLabel) },
                { type: alert, variant: (if @entity.wasteActive "warning" "success"), message: (if @entity.wasteActive (str/concat @entity.allocationStatusLabel " — actual output " (math/round @entity.actualOutputA 1) " " @entity.goodALabel " / " (math/round @entity.actualOutputB 1) " " @entity.goodBLabel) @entity.allocationStatusLabel) }
              ] }
          ]
        })
        (emit PPF_UPDATED { outputA: @entity.outputA, outputB: @entity.outputB, marginalOppCost: @entity.marginalOppCost, wasteActive: @entity.wasteActive })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      ALLOCATE {
        value : number
      }
        @description "Learner dragged the allocation slider to set the share of resources devoted to good A."
        @tier "domain"
      TOGGLE_WASTE {
      }
        @description "Learner toggled the idle-resources demo, dropping actual output inside the frontier."
        @tier "domain"
    }

    emits {
      PPF_UPDATED -> external {
        outputA : number
        outputB : number
        marginalOppCost : number
        wasteActive : boolean
      }
        @description "The allocation state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "allocation update, opportunity cost, frontier point, efficiency"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Production Possibilities Frontier"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 440
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      gridStep : number = 10
        @label "Grid Step"
        @description "Spacing between gridlines on the canvas, in output units."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      goods : [EconPpfGood] = [
        { key: A, label: "Robots", maxOutput: 100 },
        { key: B, label: "Wheat", maxOutput: 100 }
      ]
        @label "Goods"
        @description "The two goods on the production-possibilities frontier — good A (x-axis) and good B (y-axis) — each with a label and the maximum output attainable if all resources went to it."
        @synonyms "goods roster, production possibilities frontier, PPF, guns and butter, two goods, resource allocation"
        @tier "domain"
      initialShare : number = 50
        @label "Initial Allocation Share"
        @description "Starting share (0-100) of resources devoted to good A, before the learner adjusts the slider."
        @tier "domain"
      allocationStep : number = 1
        @label "Allocation Step"
        @description "Slider increment for the resource-allocation share."
        @tier "presentation"
      wasteFactor : number = 0.7
        @label "Waste Factor"
        @description "Fraction of frontier output retained at the inefficient point when idle resources are shown — models unemployment / underused resources leaving the economy inside its frontier."
        @synonyms "unemployment, idle resources, underutilization, production inefficiency, inefficiency"
        @tier "domain"
      frontierColor : string = "#2563eb"
        @label "Frontier Curve Color"
        @tier "presentation"
      frontierPointColor : string = "#16a34a"
        @label "Frontier Point Color"
        @tier "presentation"
      actualPointColor : string = "#dc2626"
        @label "Actual Output Point Color"
        @tier "presentation"
    }
  }

  page "/econ-ppf" as EconPpfPage -> EconPpfSim
}
