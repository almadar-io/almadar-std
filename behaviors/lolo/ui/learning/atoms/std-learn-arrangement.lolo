app std-learn-arrangement "1.0.0"
"Generic build-an-ordering-then-grade instrument — a config-declared roster of items (each with a correct position index and an optional hint) is tapped one at a time from a remaining-items button row onto a growing sequence of ordered slots rendered on a math-canvas; a tapped item becomes unavailable, an Undo button removes the last placement, and once every slot is filled a Check button grades the arrangement with per-slot correct/wrong coloring, a score readout, and a verdict badge. Retry clears the placements and keeps the same roster. Item vocabulary is entirely config-declared, so the same mechanism serves any ordering task (process steps, chronology, procedure, ranking) standalone. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LearnArrangementOrbital {
  type LearnArrangementShapePoint = {
    x : number!
    y : number!
  }
  type LearnArrangementShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LearnArrangementShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type LearnArrangementItem = {
    id : string!
    label : string!
    correctPosition : number!
    hint : string
  }

  entity LearnArrangementScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    totalItems : number
    placedIds : [string]
    checked : boolean = false
    correctCount : number = 0
    verdict : string
    slotShapes : [LearnArrangementShape]
  }

  trait LearnArrangementSim -> @rebindable LearnArrangementScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.totalItems (array/len @config.items))
        (set @entity.placedIds [])
        (set @entity.checked false)
        (set @entity.correctCount 0)
        (set @entity.verdict "")
        (let (
            (placedCount (array/len @entity.placedIds))
            (slotShapes (array/flatten (array/map (array/range @entity.totalItems) (fn i (let (
                    (placedId (if (< @i @placedCount) (array/nth @entity.placedIds @i) ""))
                    (filled (!= @placedId ""))
                    (item (if @filled (array/find @config.items (fn it (== (object/get @it id) @placedId))) null))
                    (label (if @filled (object/get @item label) ""))
                    (correctForSlot (if @filled (== (object/get @item correctPosition) @i) false))
                    (fillColor (if (not @filled) @config.emptySlotColor (if @entity.checked (if @correctForSlot @config.correctColor @config.incorrectColor) @config.pendingColor)))
                    (bx (+ @config.slotLeft (* @i @config.slotSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "slot-" @i), x: @bx, y: @config.slotY, width: @config.slotWidth, height: @config.slotHeight, color: @config.slotBorderColor, fill: @fillColor },
                    { type: "text", id: (str/concat "slot-label-" @i), x: (+ @bx (/ @config.slotWidth 2)), y: (+ @config.slotY (/ @config.slotHeight 2) 5), text: (if @filled @label (str/concat "" (+ @i 1))), fontSize: @config.slotFontSize, align: "center", color: @config.slotTextColor }
                  ]
                )))))
          )
          (set @entity.slotShapes @slotShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Tap items below to build the sequence in order, then press Check." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.slotShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: xs, children: (array/map (array/filter @config.items (fn it (not (array/includes @entity.placedIds (object/get @it id))))) (fn it { type: button, action: PLACE, actionPayload: { itemId: (object/get @it id) }, label: (if (!= (object/get @it hint "") "") (str/concat (object/get @it label) " — " (object/get @it hint "")) (object/get @it label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: UNDO, label: @config.undoLabel, variant: ghost, disabled: (if (> (array/len @entity.placedIds) 0) false true) },
                    { type: button, action: CHECK, label: @config.checkLabel, variant: primary, disabled: (if (>= (array/len @entity.placedIds) @entity.totalItems) false true) },
                    { type: button, action: RETRY, label: @config.retryLabel, variant: ghost }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, variant: (if @entity.checked (if (== @entity.correctCount @entity.totalItems) "success" "danger") "neutral"), label: (if @entity.checked @entity.verdict "Not checked yet") },
                    { type: stat-display, label: "Score", value: @entity.correctCount, max: @entity.totalItems }
                  ] }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.totalItems (array/len @config.items))
        (set @entity.placedIds [])
        (set @entity.checked false)
        (set @entity.correctCount 0)
        (set @entity.verdict "")
        (let (
            (placedCount (array/len @entity.placedIds))
            (slotShapes (array/flatten (array/map (array/range @entity.totalItems) (fn i (let (
                    (placedId (if (< @i @placedCount) (array/nth @entity.placedIds @i) ""))
                    (filled (!= @placedId ""))
                    (item (if @filled (array/find @config.items (fn it (== (object/get @it id) @placedId))) null))
                    (label (if @filled (object/get @item label) ""))
                    (correctForSlot (if @filled (== (object/get @item correctPosition) @i) false))
                    (fillColor (if (not @filled) @config.emptySlotColor (if @entity.checked (if @correctForSlot @config.correctColor @config.incorrectColor) @config.pendingColor)))
                    (bx (+ @config.slotLeft (* @i @config.slotSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "slot-" @i), x: @bx, y: @config.slotY, width: @config.slotWidth, height: @config.slotHeight, color: @config.slotBorderColor, fill: @fillColor },
                    { type: "text", id: (str/concat "slot-label-" @i), x: (+ @bx (/ @config.slotWidth 2)), y: (+ @config.slotY (/ @config.slotHeight 2) 5), text: (if @filled @label (str/concat "" (+ @i 1))), fontSize: @config.slotFontSize, align: "center", color: @config.slotTextColor }
                  ]
                )))))
          )
          (set @entity.slotShapes @slotShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Tap items below to build the sequence in order, then press Check." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.slotShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: xs, children: (array/map (array/filter @config.items (fn it (not (array/includes @entity.placedIds (object/get @it id))))) (fn it { type: button, action: PLACE, actionPayload: { itemId: (object/get @it id) }, label: (if (!= (object/get @it hint "") "") (str/concat (object/get @it label) " — " (object/get @it hint "")) (object/get @it label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: UNDO, label: @config.undoLabel, variant: ghost, disabled: (if (> (array/len @entity.placedIds) 0) false true) },
                    { type: button, action: CHECK, label: @config.checkLabel, variant: primary, disabled: (if (>= (array/len @entity.placedIds) @entity.totalItems) false true) },
                    { type: button, action: RETRY, label: @config.retryLabel, variant: ghost }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, variant: (if @entity.checked (if (== @entity.correctCount @entity.totalItems) "success" "danger") "neutral"), label: (if @entity.checked @entity.verdict "Not checked yet") },
                    { type: stat-display, label: "Score", value: @entity.correctCount, max: @entity.totalItems }
                  ] }
              ] }
          ]
        })

      PLACE -> idle when (and (== @entity.active true) (< (array/len @entity.placedIds) @entity.totalItems))
        (set @entity.placedIds (array/append @entity.placedIds ?itemId))
        (set @entity.checked false)
        (set @entity.correctCount 0)
        (set @entity.verdict "")
        (let (
            (placedCount (array/len @entity.placedIds))
            (slotShapes (array/flatten (array/map (array/range @entity.totalItems) (fn i (let (
                    (placedId (if (< @i @placedCount) (array/nth @entity.placedIds @i) ""))
                    (filled (!= @placedId ""))
                    (item (if @filled (array/find @config.items (fn it (== (object/get @it id) @placedId))) null))
                    (label (if @filled (object/get @item label) ""))
                    (correctForSlot (if @filled (== (object/get @item correctPosition) @i) false))
                    (fillColor (if (not @filled) @config.emptySlotColor (if @entity.checked (if @correctForSlot @config.correctColor @config.incorrectColor) @config.pendingColor)))
                    (bx (+ @config.slotLeft (* @i @config.slotSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "slot-" @i), x: @bx, y: @config.slotY, width: @config.slotWidth, height: @config.slotHeight, color: @config.slotBorderColor, fill: @fillColor },
                    { type: "text", id: (str/concat "slot-label-" @i), x: (+ @bx (/ @config.slotWidth 2)), y: (+ @config.slotY (/ @config.slotHeight 2) 5), text: (if @filled @label (str/concat "" (+ @i 1))), fontSize: @config.slotFontSize, align: "center", color: @config.slotTextColor }
                  ]
                )))))
          )
          (set @entity.slotShapes @slotShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Tap items below to build the sequence in order, then press Check." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.slotShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: xs, children: (array/map (array/filter @config.items (fn it (not (array/includes @entity.placedIds (object/get @it id))))) (fn it { type: button, action: PLACE, actionPayload: { itemId: (object/get @it id) }, label: (if (!= (object/get @it hint "") "") (str/concat (object/get @it label) " — " (object/get @it hint "")) (object/get @it label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: UNDO, label: @config.undoLabel, variant: ghost, disabled: (if (> (array/len @entity.placedIds) 0) false true) },
                    { type: button, action: CHECK, label: @config.checkLabel, variant: primary, disabled: (if (>= (array/len @entity.placedIds) @entity.totalItems) false true) },
                    { type: button, action: RETRY, label: @config.retryLabel, variant: ghost }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, variant: (if @entity.checked (if (== @entity.correctCount @entity.totalItems) "success" "danger") "neutral"), label: (if @entity.checked @entity.verdict "Not checked yet") },
                    { type: stat-display, label: "Score", value: @entity.correctCount, max: @entity.totalItems }
                  ] }
              ] }
          ]
        })

      UNDO -> idle when (and (== @entity.active true) (> (array/len @entity.placedIds) 0))
        (set @entity.placedIds (array/take @entity.placedIds (- (array/len @entity.placedIds) 1)))
        (set @entity.checked false)
        (set @entity.correctCount 0)
        (set @entity.verdict "")
        (let (
            (placedCount (array/len @entity.placedIds))
            (slotShapes (array/flatten (array/map (array/range @entity.totalItems) (fn i (let (
                    (placedId (if (< @i @placedCount) (array/nth @entity.placedIds @i) ""))
                    (filled (!= @placedId ""))
                    (item (if @filled (array/find @config.items (fn it (== (object/get @it id) @placedId))) null))
                    (label (if @filled (object/get @item label) ""))
                    (correctForSlot (if @filled (== (object/get @item correctPosition) @i) false))
                    (fillColor (if (not @filled) @config.emptySlotColor (if @entity.checked (if @correctForSlot @config.correctColor @config.incorrectColor) @config.pendingColor)))
                    (bx (+ @config.slotLeft (* @i @config.slotSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "slot-" @i), x: @bx, y: @config.slotY, width: @config.slotWidth, height: @config.slotHeight, color: @config.slotBorderColor, fill: @fillColor },
                    { type: "text", id: (str/concat "slot-label-" @i), x: (+ @bx (/ @config.slotWidth 2)), y: (+ @config.slotY (/ @config.slotHeight 2) 5), text: (if @filled @label (str/concat "" (+ @i 1))), fontSize: @config.slotFontSize, align: "center", color: @config.slotTextColor }
                  ]
                )))))
          )
          (set @entity.slotShapes @slotShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Tap items below to build the sequence in order, then press Check." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.slotShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: xs, children: (array/map (array/filter @config.items (fn it (not (array/includes @entity.placedIds (object/get @it id))))) (fn it { type: button, action: PLACE, actionPayload: { itemId: (object/get @it id) }, label: (if (!= (object/get @it hint "") "") (str/concat (object/get @it label) " — " (object/get @it hint "")) (object/get @it label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: UNDO, label: @config.undoLabel, variant: ghost, disabled: (if (> (array/len @entity.placedIds) 0) false true) },
                    { type: button, action: CHECK, label: @config.checkLabel, variant: primary, disabled: (if (>= (array/len @entity.placedIds) @entity.totalItems) false true) },
                    { type: button, action: RETRY, label: @config.retryLabel, variant: ghost }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, variant: (if @entity.checked (if (== @entity.correctCount @entity.totalItems) "success" "danger") "neutral"), label: (if @entity.checked @entity.verdict "Not checked yet") },
                    { type: stat-display, label: "Score", value: @entity.correctCount, max: @entity.totalItems }
                  ] }
              ] }
          ]
        })

      CHECK -> idle when (and (== @entity.active true) (>= (array/len @entity.placedIds) @entity.totalItems))
        (let (
            (correctCount (array/reduce (array/range @entity.totalItems) 0 (fn acc i (let (
                    (placedId (array/nth @entity.placedIds @i))
                    (item (array/find @config.items (fn it (== (object/get @it id) @placedId))))
                  )
                  (if (== (object/get @item correctPosition) @i) (+ @acc 1) @acc)))))
            (verdictText (if (== @correctCount @entity.totalItems) "All correct — well done!" (str/concat @correctCount " of " @entity.totalItems " correct — review the highlighted slots.")))
          )
          (do
            (set @entity.checked true)
            (set @entity.correctCount @correctCount)
            (set @entity.verdict @verdictText)
          )
        )
        (let (
            (placedCount (array/len @entity.placedIds))
            (slotShapes (array/flatten (array/map (array/range @entity.totalItems) (fn i (let (
                    (placedId (if (< @i @placedCount) (array/nth @entity.placedIds @i) ""))
                    (filled (!= @placedId ""))
                    (item (if @filled (array/find @config.items (fn it (== (object/get @it id) @placedId))) null))
                    (label (if @filled (object/get @item label) ""))
                    (correctForSlot (if @filled (== (object/get @item correctPosition) @i) false))
                    (fillColor (if (not @filled) @config.emptySlotColor (if @entity.checked (if @correctForSlot @config.correctColor @config.incorrectColor) @config.pendingColor)))
                    (bx (+ @config.slotLeft (* @i @config.slotSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "slot-" @i), x: @bx, y: @config.slotY, width: @config.slotWidth, height: @config.slotHeight, color: @config.slotBorderColor, fill: @fillColor },
                    { type: "text", id: (str/concat "slot-label-" @i), x: (+ @bx (/ @config.slotWidth 2)), y: (+ @config.slotY (/ @config.slotHeight 2) 5), text: (if @filled @label (str/concat "" (+ @i 1))), fontSize: @config.slotFontSize, align: "center", color: @config.slotTextColor }
                  ]
                )))))
          )
          (set @entity.slotShapes @slotShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Tap items below to build the sequence in order, then press Check." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.slotShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: xs, children: (array/map (array/filter @config.items (fn it (not (array/includes @entity.placedIds (object/get @it id))))) (fn it { type: button, action: PLACE, actionPayload: { itemId: (object/get @it id) }, label: (if (!= (object/get @it hint "") "") (str/concat (object/get @it label) " — " (object/get @it hint "")) (object/get @it label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: UNDO, label: @config.undoLabel, variant: ghost, disabled: (if (> (array/len @entity.placedIds) 0) false true) },
                    { type: button, action: CHECK, label: @config.checkLabel, variant: primary, disabled: (if (>= (array/len @entity.placedIds) @entity.totalItems) false true) },
                    { type: button, action: RETRY, label: @config.retryLabel, variant: ghost }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, variant: (if @entity.checked (if (== @entity.correctCount @entity.totalItems) "success" "danger") "neutral"), label: (if @entity.checked @entity.verdict "Not checked yet") },
                    { type: stat-display, label: "Score", value: @entity.correctCount, max: @entity.totalItems }
                  ] }
              ] }
          ]
        })
        (emit ARRANGEMENT_CHECKED { correctCount: @entity.correctCount, total: @entity.totalItems })

      RETRY -> idle when (== @entity.active true)
        (set @entity.placedIds [])
        (set @entity.checked false)
        (set @entity.correctCount 0)
        (set @entity.verdict "")
        (let (
            (placedCount (array/len @entity.placedIds))
            (slotShapes (array/flatten (array/map (array/range @entity.totalItems) (fn i (let (
                    (placedId (if (< @i @placedCount) (array/nth @entity.placedIds @i) ""))
                    (filled (!= @placedId ""))
                    (item (if @filled (array/find @config.items (fn it (== (object/get @it id) @placedId))) null))
                    (label (if @filled (object/get @item label) ""))
                    (correctForSlot (if @filled (== (object/get @item correctPosition) @i) false))
                    (fillColor (if (not @filled) @config.emptySlotColor (if @entity.checked (if @correctForSlot @config.correctColor @config.incorrectColor) @config.pendingColor)))
                    (bx (+ @config.slotLeft (* @i @config.slotSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "slot-" @i), x: @bx, y: @config.slotY, width: @config.slotWidth, height: @config.slotHeight, color: @config.slotBorderColor, fill: @fillColor },
                    { type: "text", id: (str/concat "slot-label-" @i), x: (+ @bx (/ @config.slotWidth 2)), y: (+ @config.slotY (/ @config.slotHeight 2) 5), text: (if @filled @label (str/concat "" (+ @i 1))), fontSize: @config.slotFontSize, align: "center", color: @config.slotTextColor }
                  ]
                )))))
          )
          (set @entity.slotShapes @slotShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Tap items below to build the sequence in order, then press Check." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.slotShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: xs, children: (array/map (array/filter @config.items (fn it (not (array/includes @entity.placedIds (object/get @it id))))) (fn it { type: button, action: PLACE, actionPayload: { itemId: (object/get @it id) }, label: (if (!= (object/get @it hint "") "") (str/concat (object/get @it label) " — " (object/get @it hint "")) (object/get @it label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: UNDO, label: @config.undoLabel, variant: ghost, disabled: (if (> (array/len @entity.placedIds) 0) false true) },
                    { type: button, action: CHECK, label: @config.checkLabel, variant: primary, disabled: (if (>= (array/len @entity.placedIds) @entity.totalItems) false true) },
                    { type: button, action: RETRY, label: @config.retryLabel, variant: ghost }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, variant: (if @entity.checked (if (== @entity.correctCount @entity.totalItems) "success" "danger") "neutral"), label: (if @entity.checked @entity.verdict "Not checked yet") },
                    { type: stat-display, label: "Score", value: @entity.correctCount, max: @entity.totalItems }
                  ] }
              ] }
          ]
        })
        (emit ARRANGEMENT_RESET { })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      PLACE {
        itemId : string
      }
        @description "Learner tapped an unplaced item, appending it to the end of the built sequence; the item becomes unavailable in the remaining-items row."
        @tier "domain"
      UNDO {
      }
        @description "Learner removed the most recently placed item, returning it to the remaining-items row and clearing any prior grading."
        @tier "domain"
      CHECK {
      }
        @description "Learner asked to grade the built sequence once every slot is filled; each slot is verdicted against its item's declared correct position."
        @tier "domain"
      RETRY {
      }
        @description "Learner cleared every placement and restarted the arrangement from an empty sequence, keeping the same item roster."
        @tier "domain"
    }

    emits {
      ARRANGEMENT_CHECKED -> external {
        correctCount : number
        total : number
      }
        @description "The grading result after Check — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "arrangement graded, order checked, score, running score"
        @tier "domain"
      ARRANGEMENT_RESET -> external {
      }
        @description "Signals the arrangement was cleared back to empty by Retry — a composed listener can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "arrangement reset, retry, restart"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Build the Order"
        @label "Title"
        @description "Title shown above the instrument."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 220
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      items : [LearnArrangementItem] = [
        { id: "1", label: "Boil water in a kettle", correctPosition: 0, hint: "What has to happen before anything can be poured?" },
        { id: "2", label: "Place a tea bag in the cup", correctPosition: 1, hint: "The bag goes in before the water does." },
        { id: "3", label: "Pour the hot water over the tea bag", correctPosition: 2, hint: "Now the water and the bag meet." },
        { id: "4", label: "Let it steep for a few minutes", correctPosition: 3, hint: "Flavor needs time to develop." },
        { id: "5", label: "Remove the tea bag and add milk or sugar to taste", correctPosition: 4, hint: "This happens once the tea is strong enough." }
      ]
        @label "Items"
        @description "Roster of items to order; each carries its label, its zero-based correct position in the finished sequence, and an optional hint shown beneath its button while unplaced."
        @synonyms "item, step, stage, sequence, order, ranking, procedure"
        @tier "domain"
      correctColor : string = "#16a34a"
        @label "Correct Slot Color"
        @description "Fill color for a filled slot whose item matches its correct position, once graded."
        @tier "presentation"
      incorrectColor : string = "#dc2626"
        @label "Incorrect Slot Color"
        @description "Fill color for a filled slot whose item does not match its correct position, once graded."
        @tier "presentation"
      pendingColor : string = "#94a3b8"
        @label "Pending Slot Color"
        @description "Fill color for a filled slot before grading."
        @tier "presentation"
      emptySlotColor : string = "#e2e8f0"
        @label "Empty Slot Color"
        @description "Fill color for a slot with no item placed yet."
        @tier "presentation"
      slotLeft : number = 40
        @label "First Slot X (px)"
        @tier "presentation"
      slotSpacing : number = 120
        @label "Slot Spacing (px)"
        @tier "presentation"
      slotWidth : number = 100
        @label "Slot Width (px)"
        @tier "presentation"
      slotHeight : number = 60
        @label "Slot Height (px)"
        @tier "presentation"
      slotY : number = 70
        @label "Slot Row Y (px)"
        @tier "presentation"
      slotFontSize : number = 13
        @label "Slot Font Size"
        @tier "presentation"
      slotBorderColor : string = "#334155"
        @label "Slot Border Color"
        @tier "presentation"
      slotTextColor : string = "#0f172a"
        @label "Slot Text Color"
        @tier "presentation"
      undoLabel : string = "Undo"
        @label "Undo Button Label"
        @tier "presentation"
      checkLabel : string = "Check"
        @label "Check Button Label"
        @tier "presentation"
      retryLabel : string = "Retry"
        @label "Retry Button Label"
        @tier "presentation"
    }
  }

  page "/learn-arrangement" as LearnArrangementPage -> LearnArrangementSim
}
