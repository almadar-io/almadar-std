app std-econ-gdp "1.0.0"
"GDP expenditure-approach engine — the learner raises or lowers consumption, investment, government spending and net exports bars and GDP (= C + I + G + (X − M)) recomputes live on a math-canvas; an optional 'counts in GDP?' classify mini-game quizzes which transactions enter GDP. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EconGdpOrbital {
  type EconGdpItem = {
    label : string!
    counts : boolean!
  }
  type EconGdpSample = {
    x : number!
    y : number!
  }
  type EconGdpCurve = {
    label : string
    color : string
    samples : [EconGdpSample]!
  }
  type EconGdpMarker = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }

  entity EconGdpScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    consumption : number
    investment : number
    government : number
    netExports : number
    gdp : number
    classifyIndex : number
    classifyScore : number
    classifyAttempts : number
    classifyLabel : string
    classifyFeedback : string
    curves : [EconGdpCurve]
    points : [EconGdpMarker]
  }

  trait EconGdpSim -> @rebindable EconGdpScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.consumption (array/nth @config.initialValues 0))
        (set @entity.investment (array/nth @config.initialValues 1))
        (set @entity.government (array/nth @config.initialValues 2))
        (set @entity.netExports (array/nth @config.initialValues 3))
        (set @entity.classifyIndex 0)
        (set @entity.classifyScore 0)
        (set @entity.classifyAttempts 0)
        (set @entity.classifyLabel (object/get (array/nth @config.classifyItems 0) label))
        (set @entity.classifyFeedback "")
        (let (
            (gdpVal (+ (+ @entity.consumption @entity.investment) (+ @entity.government @entity.netExports)))
            (newCurves [
                { label: "C", color: @config.consumptionColor, samples: [ { x: 1, y: 0 }, { x: 1, y: @entity.consumption } ] },
                { label: "I", color: @config.investmentColor, samples: [ { x: 2, y: 0 }, { x: 2, y: @entity.investment } ] },
                { label: "G", color: @config.governmentColor, samples: [ { x: 3, y: 0 }, { x: 3, y: @entity.government } ] },
                { label: "X − M", color: @config.netExportsColor, samples: [ { x: 4, y: 0 }, { x: 4, y: @entity.netExports } ] },
                { label: "GDP", color: @config.gdpColor, samples: [ { x: 5.5, y: 0 }, { x: 5.5, y: @gdpVal } ] }
              ])
            (newPoints [
                { x: 1, y: @entity.consumption, label: (array/nth @config.components 0), color: @config.consumptionColor, radius: 5 },
                { x: 2, y: @entity.investment, label: (array/nth @config.components 1), color: @config.investmentColor, radius: 5 },
                { x: 3, y: @entity.government, label: (array/nth @config.components 2), color: @config.governmentColor, radius: 5 },
                { x: 4, y: @entity.netExports, label: (array/nth @config.components 3), color: @config.netExportsColor, radius: 5 },
                { x: 5.5, y: @gdpVal, label: "GDP", color: @config.gdpColor, radius: 6 }
              ])
          )
          (do
            (set @entity.gdp @gdpVal)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: @config.componentStep }, label: "C +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: (- 0 @config.componentStep) }, label: "C −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: @config.componentStep }, label: "I +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: (- 0 @config.componentStep) }, label: "I −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: @config.componentStep }, label: "G +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: (- 0 @config.componentStep) }, label: "G −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: @config.componentStep }, label: "X−M +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: (- 0 @config.componentStep) }, label: "X−M −", variant: secondary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 7, yMin: @config.minBarValue, yMax: @config.maxBarValue, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "GDP = C " (math/round @entity.consumption 1) " + I " (math/round @entity.investment 1) " + G " (math/round @entity.government 1) " + (X−M) " (math/round @entity.netExports 1) " = " (math/round @entity.gdp 1)) },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Counts in GDP? — " @entity.classifyLabel) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: true }, label: "Counts in GDP", variant: primary, size: sm },
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: false }, label: "Does NOT count", variant: secondary, size: sm }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.classifyScore " / " @entity.classifyAttempts) },
                { type: alert, variant: (if (== @entity.classifyFeedback "") "success" (if (== @entity.classifyScore @entity.classifyAttempts) "success" "warning")), message: (if (== @entity.classifyFeedback "") "Classify each transaction — only production of final goods and services within the period counts in GDP." @entity.classifyFeedback) }
              ] }
          ]
        })
        (emit GDP_UPDATED { consumption: @entity.consumption, investment: @entity.investment, government: @entity.government, netExports: @entity.netExports, gdp: @entity.gdp, classifyScore: @entity.classifyScore, classifyAttempts: @entity.classifyAttempts })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.consumption (array/nth @config.initialValues 0))
        (set @entity.investment (array/nth @config.initialValues 1))
        (set @entity.government (array/nth @config.initialValues 2))
        (set @entity.netExports (array/nth @config.initialValues 3))
        (set @entity.classifyIndex 0)
        (set @entity.classifyScore 0)
        (set @entity.classifyAttempts 0)
        (set @entity.classifyLabel (object/get (array/nth @config.classifyItems 0) label))
        (set @entity.classifyFeedback "")
        (let (
            (gdpVal (+ (+ @entity.consumption @entity.investment) (+ @entity.government @entity.netExports)))
            (newCurves [
                { label: "C", color: @config.consumptionColor, samples: [ { x: 1, y: 0 }, { x: 1, y: @entity.consumption } ] },
                { label: "I", color: @config.investmentColor, samples: [ { x: 2, y: 0 }, { x: 2, y: @entity.investment } ] },
                { label: "G", color: @config.governmentColor, samples: [ { x: 3, y: 0 }, { x: 3, y: @entity.government } ] },
                { label: "X − M", color: @config.netExportsColor, samples: [ { x: 4, y: 0 }, { x: 4, y: @entity.netExports } ] },
                { label: "GDP", color: @config.gdpColor, samples: [ { x: 5.5, y: 0 }, { x: 5.5, y: @gdpVal } ] }
              ])
            (newPoints [
                { x: 1, y: @entity.consumption, label: (array/nth @config.components 0), color: @config.consumptionColor, radius: 5 },
                { x: 2, y: @entity.investment, label: (array/nth @config.components 1), color: @config.investmentColor, radius: 5 },
                { x: 3, y: @entity.government, label: (array/nth @config.components 2), color: @config.governmentColor, radius: 5 },
                { x: 4, y: @entity.netExports, label: (array/nth @config.components 3), color: @config.netExportsColor, radius: 5 },
                { x: 5.5, y: @gdpVal, label: "GDP", color: @config.gdpColor, radius: 6 }
              ])
          )
          (do
            (set @entity.gdp @gdpVal)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: @config.componentStep }, label: "C +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: (- 0 @config.componentStep) }, label: "C −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: @config.componentStep }, label: "I +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: (- 0 @config.componentStep) }, label: "I −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: @config.componentStep }, label: "G +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: (- 0 @config.componentStep) }, label: "G −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: @config.componentStep }, label: "X−M +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: (- 0 @config.componentStep) }, label: "X−M −", variant: secondary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 7, yMin: @config.minBarValue, yMax: @config.maxBarValue, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "GDP = C " (math/round @entity.consumption 1) " + I " (math/round @entity.investment 1) " + G " (math/round @entity.government 1) " + (X−M) " (math/round @entity.netExports 1) " = " (math/round @entity.gdp 1)) },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Counts in GDP? — " @entity.classifyLabel) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: true }, label: "Counts in GDP", variant: primary, size: sm },
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: false }, label: "Does NOT count", variant: secondary, size: sm }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.classifyScore " / " @entity.classifyAttempts) },
                { type: alert, variant: (if (== @entity.classifyFeedback "") "success" (if (== @entity.classifyScore @entity.classifyAttempts) "success" "warning")), message: (if (== @entity.classifyFeedback "") "Classify each transaction — only production of final goods and services within the period counts in GDP." @entity.classifyFeedback) }
              ] }
          ]
        })
        (emit GDP_UPDATED { consumption: @entity.consumption, investment: @entity.investment, government: @entity.government, netExports: @entity.netExports, gdp: @entity.gdp, classifyScore: @entity.classifyScore, classifyAttempts: @entity.classifyAttempts })

      ADJUST_COMPONENT -> idle when (== @entity.active true)
        (let (
            (newC (if (== ?component "C") (math/max 0 (+ @entity.consumption ?delta)) @entity.consumption))
            (newI (if (== ?component "I") (math/max 0 (+ @entity.investment ?delta)) @entity.investment))
            (newG (if (== ?component "G") (math/max 0 (+ @entity.government ?delta)) @entity.government))
            (newNX (if (== ?component "NX") (math/max @config.minBarValue (+ @entity.netExports ?delta)) @entity.netExports))
            (gdpVal (+ (+ @newC @newI) (+ @newG @newNX)))
            (newCurves [
                { label: "C", color: @config.consumptionColor, samples: [ { x: 1, y: 0 }, { x: 1, y: @newC } ] },
                { label: "I", color: @config.investmentColor, samples: [ { x: 2, y: 0 }, { x: 2, y: @newI } ] },
                { label: "G", color: @config.governmentColor, samples: [ { x: 3, y: 0 }, { x: 3, y: @newG } ] },
                { label: "X − M", color: @config.netExportsColor, samples: [ { x: 4, y: 0 }, { x: 4, y: @newNX } ] },
                { label: "GDP", color: @config.gdpColor, samples: [ { x: 5.5, y: 0 }, { x: 5.5, y: @gdpVal } ] }
              ])
            (newPoints [
                { x: 1, y: @newC, label: (array/nth @config.components 0), color: @config.consumptionColor, radius: 5 },
                { x: 2, y: @newI, label: (array/nth @config.components 1), color: @config.investmentColor, radius: 5 },
                { x: 3, y: @newG, label: (array/nth @config.components 2), color: @config.governmentColor, radius: 5 },
                { x: 4, y: @newNX, label: (array/nth @config.components 3), color: @config.netExportsColor, radius: 5 },
                { x: 5.5, y: @gdpVal, label: "GDP", color: @config.gdpColor, radius: 6 }
              ])
          )
          (do
            (set @entity.consumption @newC)
            (set @entity.investment @newI)
            (set @entity.government @newG)
            (set @entity.netExports @newNX)
            (set @entity.gdp @gdpVal)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: @config.componentStep }, label: "C +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: (- 0 @config.componentStep) }, label: "C −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: @config.componentStep }, label: "I +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: (- 0 @config.componentStep) }, label: "I −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: @config.componentStep }, label: "G +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: (- 0 @config.componentStep) }, label: "G −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: @config.componentStep }, label: "X−M +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: (- 0 @config.componentStep) }, label: "X−M −", variant: secondary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 7, yMin: @config.minBarValue, yMax: @config.maxBarValue, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "GDP = C " (math/round @entity.consumption 1) " + I " (math/round @entity.investment 1) " + G " (math/round @entity.government 1) " + (X−M) " (math/round @entity.netExports 1) " = " (math/round @entity.gdp 1)) },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Counts in GDP? — " @entity.classifyLabel) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: true }, label: "Counts in GDP", variant: primary, size: sm },
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: false }, label: "Does NOT count", variant: secondary, size: sm }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.classifyScore " / " @entity.classifyAttempts) },
                { type: alert, variant: (if (== @entity.classifyFeedback "") "success" (if (== @entity.classifyScore @entity.classifyAttempts) "success" "warning")), message: (if (== @entity.classifyFeedback "") "Classify each transaction — only production of final goods and services within the period counts in GDP." @entity.classifyFeedback) }
              ] }
          ]
        })
        (emit GDP_UPDATED { consumption: @entity.consumption, investment: @entity.investment, government: @entity.government, netExports: @entity.netExports, gdp: @entity.gdp, classifyScore: @entity.classifyScore, classifyAttempts: @entity.classifyAttempts })

      CLASSIFY_ITEM -> idle when (== @entity.active true)
        (let (
            (item (array/nth @config.classifyItems @entity.classifyIndex))
            (correct (== ?answer (object/get @item counts)))
            (newScore (if @correct (+ @entity.classifyScore 1) @entity.classifyScore))
            (newAttempts (+ @entity.classifyAttempts 1))
            (feedback (if @correct (str/concat "Correct — \"" (object/get @item label) "\" " (if (object/get @item counts) "counts" "does not count") " in GDP.") (str/concat "Not quite — \"" (object/get @item label) "\" " (if (object/get @item counts) "counts" "does not count") " in GDP.")))
            (total (array/len @config.classifyItems))
            (nextIndex (if (< @entity.classifyIndex (- @total 1)) (+ @entity.classifyIndex 1) 0))
            (nextLabel (object/get (array/nth @config.classifyItems @nextIndex) label))
          )
          (do
            (set @entity.classifyScore @newScore)
            (set @entity.classifyAttempts @newAttempts)
            (set @entity.classifyIndex @nextIndex)
            (set @entity.classifyLabel @nextLabel)
            (set @entity.classifyFeedback @feedback)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: @config.componentStep }, label: "C +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: (- 0 @config.componentStep) }, label: "C −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: @config.componentStep }, label: "I +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: (- 0 @config.componentStep) }, label: "I −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: @config.componentStep }, label: "G +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: (- 0 @config.componentStep) }, label: "G −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: @config.componentStep }, label: "X−M +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: (- 0 @config.componentStep) }, label: "X−M −", variant: secondary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 7, yMin: @config.minBarValue, yMax: @config.maxBarValue, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "GDP = C " (math/round @entity.consumption 1) " + I " (math/round @entity.investment 1) " + G " (math/round @entity.government 1) " + (X−M) " (math/round @entity.netExports 1) " = " (math/round @entity.gdp 1)) },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Counts in GDP? — " @entity.classifyLabel) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: true }, label: "Counts in GDP", variant: primary, size: sm },
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: false }, label: "Does NOT count", variant: secondary, size: sm }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.classifyScore " / " @entity.classifyAttempts) },
                { type: alert, variant: (if (== @entity.classifyFeedback "") "success" (if (== @entity.classifyScore @entity.classifyAttempts) "success" "warning")), message: (if (== @entity.classifyFeedback "") "Classify each transaction — only production of final goods and services within the period counts in GDP." @entity.classifyFeedback) }
              ] }
          ]
        })
        (emit GDP_UPDATED { consumption: @entity.consumption, investment: @entity.investment, government: @entity.government, netExports: @entity.netExports, gdp: @entity.gdp, classifyScore: @entity.classifyScore, classifyAttempts: @entity.classifyAttempts })

      RESET -> idle when (== @entity.active true)
        (let (
            (newC (array/nth @config.initialValues 0))
            (newI (array/nth @config.initialValues 1))
            (newG (array/nth @config.initialValues 2))
            (newNX (array/nth @config.initialValues 3))
            (gdpVal (+ (+ @newC @newI) (+ @newG @newNX)))
            (newCurves [
                { label: "C", color: @config.consumptionColor, samples: [ { x: 1, y: 0 }, { x: 1, y: @newC } ] },
                { label: "I", color: @config.investmentColor, samples: [ { x: 2, y: 0 }, { x: 2, y: @newI } ] },
                { label: "G", color: @config.governmentColor, samples: [ { x: 3, y: 0 }, { x: 3, y: @newG } ] },
                { label: "X − M", color: @config.netExportsColor, samples: [ { x: 4, y: 0 }, { x: 4, y: @newNX } ] },
                { label: "GDP", color: @config.gdpColor, samples: [ { x: 5.5, y: 0 }, { x: 5.5, y: @gdpVal } ] }
              ])
            (newPoints [
                { x: 1, y: @newC, label: (array/nth @config.components 0), color: @config.consumptionColor, radius: 5 },
                { x: 2, y: @newI, label: (array/nth @config.components 1), color: @config.investmentColor, radius: 5 },
                { x: 3, y: @newG, label: (array/nth @config.components 2), color: @config.governmentColor, radius: 5 },
                { x: 4, y: @newNX, label: (array/nth @config.components 3), color: @config.netExportsColor, radius: 5 },
                { x: 5.5, y: @gdpVal, label: "GDP", color: @config.gdpColor, radius: 6 }
              ])
          )
          (do
            (set @entity.consumption @newC)
            (set @entity.investment @newI)
            (set @entity.government @newG)
            (set @entity.netExports @newNX)
            (set @entity.gdp @gdpVal)
            (set @entity.classifyIndex 0)
            (set @entity.classifyScore 0)
            (set @entity.classifyAttempts 0)
            (set @entity.classifyLabel (object/get (array/nth @config.classifyItems 0) label))
            (set @entity.classifyFeedback "")
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: @config.componentStep }, label: "C +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "C", delta: (- 0 @config.componentStep) }, label: "C −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: @config.componentStep }, label: "I +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "I", delta: (- 0 @config.componentStep) }, label: "I −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: @config.componentStep }, label: "G +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "G", delta: (- 0 @config.componentStep) }, label: "G −", variant: secondary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: @config.componentStep }, label: "X−M +", variant: primary, size: sm },
                    { type: button, action: ADJUST_COMPONENT, actionPayload: { component: "NX", delta: (- 0 @config.componentStep) }, label: "X−M −", variant: secondary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 7, yMin: @config.minBarValue, yMax: @config.maxBarValue, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "GDP = C " (math/round @entity.consumption 1) " + I " (math/round @entity.investment 1) " + G " (math/round @entity.government 1) " + (X−M) " (math/round @entity.netExports 1) " = " (math/round @entity.gdp 1)) },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Counts in GDP? — " @entity.classifyLabel) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: true }, label: "Counts in GDP", variant: primary, size: sm },
                    { type: button, action: CLASSIFY_ITEM, actionPayload: { answer: false }, label: "Does NOT count", variant: secondary, size: sm }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.classifyScore " / " @entity.classifyAttempts) },
                { type: alert, variant: (if (== @entity.classifyFeedback "") "success" (if (== @entity.classifyScore @entity.classifyAttempts) "success" "warning")), message: (if (== @entity.classifyFeedback "") "Classify each transaction — only production of final goods and services within the period counts in GDP." @entity.classifyFeedback) }
              ] }
          ]
        })
        (emit GDP_UPDATED { consumption: @entity.consumption, investment: @entity.investment, government: @entity.government, netExports: @entity.netExports, gdp: @entity.gdp, classifyScore: @entity.classifyScore, classifyAttempts: @entity.classifyAttempts })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      ADJUST_COMPONENT {
        component : string
        delta : number
      }
        @description "Learner pressed a component +/- button; component is C, I, G or NX and delta the signed step."
        @tier "domain"
      CLASSIFY_ITEM {
        answer : boolean
      }
        @description "Learner answered the 'counts in GDP?' prompt for the current transaction."
        @tier "domain"
      RESET {
      }
        @description "Learner pressed Reset — restores the configured component values and restarts the classify quiz."
        @tier "domain"
    }

    emits {
      GDP_UPDATED -> external {
        consumption : number
        investment : number
        government : number
        netExports : number
        gdp : number
        classifyScore : number
        classifyAttempts : number
      }
        @description "The GDP stack and quiz state after each learner action — a composed listener (readout, chart, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "GDP, gross domestic product, expenditure approach, consumption, investment, government spending, net exports, aggregate demand, national income accounting"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "GDP: Expenditure Approach"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 440
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      gridStep : number = 10
        @label "Grid Step"
        @description "Spacing between gridlines on the canvas, in currency units."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      components : [string] = ["Consumption", "Investment", "Government", "Net Exports"]
        @label "Components"
        @description "Labels for the four expenditure components, in bar order: C, I, G, (X − M)."
        @synonyms "expenditure components, C I G NX, aggregate expenditure"
        @tier "domain"
      initialValues : [number] = [60, 15, 20, -5]
        @label "Initial Values"
        @description "Starting values of C, I, G and (X − M) before the learner adjusts them."
        @tier "domain"
      componentStep : number = 5
        @label "Component Step"
        @description "How much each component +/- button moves its bar per press."
        @tier "domain"
      classifyItems : [EconGdpItem] = [
        { label: "A household buys a newly built car", counts: true },
        { label: "A used car is resold between households", counts: false },
        { label: "The government paves a new highway", counts: true },
        { label: "A retiree receives a social security payment", counts: false },
        { label: "A firm buys new machinery for its factory", counts: true },
        { label: "An investor buys shares of stock", counts: false },
        { label: "A bakery sells bread baked this week", counts: true },
        { label: "A household buys imported wine", counts: false }
      ]
        @label "Classify Items"
        @description "Transactions for the 'counts in GDP?' quiz; counts marks whether the transaction enters GDP."
        @synonyms "what counts in GDP, GDP quiz, final goods, transfer payments, intermediate goods"
        @tier "domain"
      minBarValue : number = -50
        @label "Min Bar Value (axis)"
        @description "Bottom edge of the value axis (net exports can be negative)."
        @tier "presentation"
      maxBarValue : number = 120
        @label "Max Bar Value (axis)"
        @description "Top edge of the value axis, in currency units."
        @tier "presentation"
      consumptionColor : string = "#2563eb"
        @label "Consumption Bar Color"
        @tier "presentation"
      investmentColor : string = "#7c3aed"
        @label "Investment Bar Color"
        @tier "presentation"
      governmentColor : string = "#dc2626"
        @label "Government Bar Color"
        @tier "presentation"
      netExportsColor : string = "#f59e0b"
        @label "Net Exports Bar Color"
        @tier "presentation"
      gdpColor : string = "#16a34a"
        @label "GDP Bar Color"
        @tier "presentation"
    }
  }

  page "/econ-gdp" as EconGdpPage -> EconGdpSim
}
