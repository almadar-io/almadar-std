app ui-biology-canvas "1.0.0"
"BiologyCanvas — UI factory (1:1 with the @almadar/ui biology-canvas pattern)."
;; @pattern "biology-canvas"
orbital BiologyCanvasOrbital {
  type BiologyCanvasCamera = {
    pos : BiologyCanvasCameraPos
    target : BiologyCanvasCameraTarget
    zoom : number
    fov : number
    mode : "isometric" | "perspective" | "top-down" | "front" | "follow" | "chase"
    azimuth : number
    elevation : number
  }
  type BiologyCanvasCameraPos = {
    x : number!
    y : number!
    z : number
  }
  type BiologyCanvasCameraTarget = {
    x : number!
    y : number!
    z : number
  }
  type BiologyCanvasLighting = {
    ambient : BiologyCanvasLightingAmbient
    directional : BiologyCanvasLightingDirectional
    hemisphere : BiologyCanvasLightingHemisphere
    points : [BiologyCanvasLightingPointsItem]
    environment : "room" | "none"
    toneMapping : "aces" | "none"
  }
  type BiologyCanvasLightingAmbient = {
    intensity : number
    color : string
    position : [number]
  }
  type BiologyCanvasLightingDirectional = {
    intensity : number
    color : string
    position : [number]
  }
  type BiologyCanvasLightingHemisphere = {
    intensity : number
    color : string
    groundColor : string
  }
  type BiologyCanvasLightingPointsItem = {
    intensity : number
    color : string
    position : [number]!
    distance : number
    decay : number
  }
  type BiologyCanvasPost = {
    bloom : BiologyCanvasPostBloom
    vignette : BiologyCanvasPostVignette
  }
  type BiologyCanvasPostBloom = {
    intensity : number
    threshold : number
    smoothing : number
  }
  type BiologyCanvasPostVignette = {
    offset : number
    darkness : number
  }
  type BiologyCanvasNodesItem = {
    id : string
    x : number!
    y : number!
    z : number
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
    shape : "box" | "sphere" | "capsule" | "cylinder" | "cone" | "torus" | "plane" | "circle" | "polyhedron"
    opacity : number
    state : "default" | "highlight" | "muted"
  }
  type BiologyCanvasEdgesItem = {
    from : string!
    to : string!
    color : string
    label : string
    directed : boolean
  }
  type BiologyCanvasCompartmentsItem = {
    x : number!
    y : number!
    width : number!
    height : number!
    label : string
    color : string
    fill : string
    dash : "dashed" | "dotted"
    lineWidth : number
  }
  type BiologyCanvasBandsItem = {
    label : string
    color : string
  }
  type BiologyCanvasStagesItem = {
    label : string!
    state : "pending" | "active" | "done"
    color : string
  }
  type BiologyCanvasHelix = {
    x : number
    y : number
    width : number
    height : number
    rungs : [BiologyCanvasHelixRungsItem]!
    fork : number
    colorA : string
    colorB : string
    rungColor : string
  }
  type BiologyCanvasHelixRungsItem = {
    a : string
    b : string
    state : "paired" | "open" | "new"
    color : string
  }
  type BiologyCanvasHelix3d = {
    count : number
    rungs : [BiologyCanvasHelix3dRungsItem]
    radius : number
    rise : number
    twistDeg : number
    strandAColor : string
    strandBColor : string
    backboneRadius : number
    rungRadius : number
    x : number
    y : number
    z : number
    unwoundCount : number
    unwindSpread : number
  }
  type BiologyCanvasHelix3dRungsItem = {
    id : string
    color : string
    radius : number
    label : string
  }
  type BiologyCanvasShapesItem = {
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [BiologyCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    fontFamily : string
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "solid" | "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type BiologyCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type BiologyCanvasReadoutsItem = {
    label : string!
    value : string!
    color : string
  }
  type BiologyCanvasTracesItem = {
    x : number
    y : number
    width : number
    height : number
    series : [BiologyCanvasTracesItemSeriesItem]!
    xLabel : string
    yLabel : string
    frameColor : string
    backgroundColor : string
    backgroundOpacity : number
  }
  type BiologyCanvasTracesItemSeriesItem = {
    samples : [BiologyCanvasTracesItemSeriesItemSamplesItem]!
    color : string
    label : string
  }
  type BiologyCanvasTracesItemSeriesItemSamplesItem = {
    x : number!
    y : number!
  }
  type BiologyCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type BiologyCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }

  entity BiologyCanvasItem [runtime] {
    id : string!
  }

  trait BiologyCanvasRender -> @rebindable BiologyCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          nodes: @config.nodes
          edges: @config.edges
          compartments: @config.compartments
          bands: @config.bands
          stages: @config.stages
          stageStyle: @config.stageStyle
          helix: @config.helix
          helix3d: @config.helix3d
          shapes: @config.shapes
          readouts: @config.readouts
          traces: @config.traces
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: biology-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          nodes: @payload.nodes
          edges: @payload.edges
          compartments: @payload.compartments
          bands: @payload.bands
          stages: @payload.stages
          stageStyle: @config.stageStyle
          helix: @config.helix
          helix3d: @config.helix3d
          shapes: @payload.shapes
          readouts: @payload.readouts
          traces: @payload.traces
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: biology-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : BiologyCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
    }

    listens {
      UPDATE {
        nodes : [BiologyCanvasNodesItem]
        edges : [BiologyCanvasEdgesItem]
        compartments : [BiologyCanvasCompartmentsItem]
        bands : [BiologyCanvasBandsItem]
        stages : [BiologyCanvasStagesItem]
        shapes : [BiologyCanvasShapesItem]
        readouts : [BiologyCanvasReadoutsItem]
        traces : [BiologyCanvasTracesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "backgroundColor prop"
        @tier "presentation"
      mode : "2d" | "3d" = "2d"
        @label "Mode"
        @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host."
        @tier "presentation"
      camera : BiologyCanvasCamera
        @label "Camera"
        @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })."
        @tier "presentation"
      lighting : BiologyCanvasLighting
        @label "Lighting"
        @description "3D only: scene light rig as data."
        @tier "presentation"
      post : BiologyCanvasPost
        @label "Post"
        @description "3D only: post-processing stack (bloom/vignette)."
        @tier "presentation"
      nodes : [BiologyCanvasNodesItem] = []
        @label "Nodes"
        @description "nodes prop"
        @tier "presentation"
      edges : [BiologyCanvasEdgesItem] = []
        @label "Edges"
        @description "edges prop"
        @tier "presentation"
      compartments : [BiologyCanvasCompartmentsItem] = []
        @label "Compartments"
        @description "Organelle/membrane/cell-boundary ellipses (2D only)."
        @synonyms "membrane, organelle region, cell boundary"
        @tier "presentation"
      bands : [BiologyCanvasBandsItem] = []
        @label "Bands"
        @description "Full-width horizontal background stripes, drawn first (2D only)."
        @synonyms "trophic levels, zones, layers"
        @tier "presentation"
      stages : [BiologyCanvasStagesItem] = []
        @label "Stages"
        @description "Phase/step chips (2D only)."
        @synonyms "phases, timeline, cycle"
        @tier "presentation"
      stageStyle : "timeline" | "ring" = timeline
        @label "Stage Style"
        @description "Layout for `stages`: a bottom timeline strip (default) or a radial ring."
        @tier "presentation"
      helix : BiologyCanvasHelix
        @label "Helix"
        @description "A DNA double-helix ladder panel (2D only)."
        @synonyms "DNA ladder, replication fork, base pairs"
        @tier "presentation"
      helix3d : BiologyCanvasHelix3d
        @label "Helix3d"
        @description "A 3D DNA double-helix ladder. 3D only."
        @tier "presentation"
      shapes : [BiologyCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)."
        @tier "presentation"
      readouts : [BiologyCanvasReadoutsItem] = []
        @label "Readouts"
        @description "Top-right status chip row, forwarded to LearningCanvas verbatim."
        @tier "presentation"
      traces : [BiologyCanvasTracesItem] = []
        @label "Traces"
        @description "Inset sparkline panels, forwarded to LearningCanvas verbatim."
        @tier "presentation"
      showGrid : boolean
        @label "Show Grid"
        @description "3D only: show the ground grid (default off)."
        @tier "presentation"
      shadows : boolean
        @label "Shadows"
        @description "3D only: enable shadows. Omitted → the host default."
        @tier "presentation"
      interactive : boolean
        @label "Interactive"
        @description "2D: pointer interaction (click/hover). 3D: orbit camera controls."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "2D only: continuous redraw loop. 3D motion is entity-state driven."
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : BiologyCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/biology-canvas" as BiologyCanvasPage -> BiologyCanvasRender
}
