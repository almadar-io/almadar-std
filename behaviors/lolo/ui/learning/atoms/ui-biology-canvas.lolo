app ui-biology-canvas "1.0.0"
"BiologyCanvas — UI factory (1:1 with the @almadar/ui biology-canvas pattern)."
orbital BiologyCanvasOrbital {
  type BiologyCanvasNodesItem = {
    id : string
    x : number!
    y : number!
    z : number
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
    shape : "box" | "sphere" | "capsule" | "cylinder" | "cone" | "torus" | "plane" | "circle" | "polyhedron"
    opacity : number
  }
  type BiologyCanvasEdgesItem = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type BiologyCanvasShapesItem = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [BiologyCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type BiologyCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type BiologyCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type BiologyCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }

  entity BiologyCanvasItem [runtime] {
    id : string!
  }

  trait BiologyCanvasRender -> @rebindable BiologyCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          nodes: @config.nodes
          edges: @config.edges
          shapes: @config.shapes
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          type: biology-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          nodes: @payload.nodes
          edges: @payload.edges
          shapes: @payload.shapes
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          type: biology-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : BiologyCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
    }

    listens {
      UPDATE {
        nodes : [BiologyCanvasNodesItem]
        edges : [BiologyCanvasEdgesItem]
        shapes : [BiologyCanvasShapesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "backgroundColor prop"
        @tier "presentation"
      mode : "2d" | "3d" = "2d"
        @label "Mode"
        @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host."
        @tier "presentation"
      camera : json = {}
        @label "Camera"
        @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })."
        @tier "presentation"
      lighting : json = {}
        @label "Lighting"
        @description "3D only: scene light rig as data."
        @tier "presentation"
      post : json = {}
        @label "Post"
        @description "3D only: post-processing stack (bloom/vignette)."
        @tier "presentation"
      nodes : [BiologyCanvasNodesItem] = []
        @label "Nodes"
        @description "nodes prop"
        @tier "presentation"
      edges : [BiologyCanvasEdgesItem] = []
        @label "Edges"
        @description "edges prop"
        @tier "presentation"
      shapes : [BiologyCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)."
        @tier "presentation"
      showGrid : boolean
        @label "Show Grid"
        @description "3D only: show the ground grid (default off)."
        @tier "presentation"
      shadows : boolean
        @label "Shadows"
        @description "3D only: enable shadows. Omitted → the host default."
        @tier "presentation"
      interactive : boolean
        @label "Interactive"
        @description "2D: pointer interaction (click/hover). 3D: orbit camera controls."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "2D only: continuous redraw loop. 3D motion is entity-state driven."
        @tier "presentation"
      onShapeClick : string = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : BiologyCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
    }
  }

  page "/biology-canvas" as BiologyCanvasPage -> BiologyCanvasRender
}
