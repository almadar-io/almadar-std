app std-hist-sourcing "1.0.0"
"HIPP sourcing instrument — the learner classifies each aspect of a historical source (historical situation, intended audience, purpose, point of view, and primary vs secondary) from fixed option rows, scored live against the source's canonical attribution on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital HistSourcingOrbital {
  type HistSourcingShapePoint = {
    x : number!
    y : number!
  }
  type HistSourcingShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [HistSourcingShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type HistSourcingSource = {
    id : string!
    title : string!
    excerpt : string!
    kind : string!
    situation : string!
    audience : string!
    purpose : string!
    pov : string!
  }
  type HistSourcingRubric = {
    aspect : string!
    label : string!
    options : [string]
  }

  entity HistSourcingScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    sourceIndex : number
    picks : [json]
    score : number
    done : boolean = false
    shapes : [HistSourcingShape]
  }

  trait HistSourcingSim -> @rebindable HistSourcingScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.sourceIndex 0)
        (set @entity.picks [])
        (set @entity.score 0)
        (set @entity.done false)
        (let (
            (src (array/nth @config.sources @entity.sourceIndex))
            (cardShapes [
              { type: rect, id: "source-card", x: 40, y: 40, width: (- @config.width 80), height: 150, fill: "#faf5eb", color: "#d6d3d1", opacity: 1, lineWidth: 1 },
              { type: text, id: "source-title", x: 60, y: 80, text: @src.title, fontSize: 15, align: "left", color: "#1c1917" },
              { type: text, id: "source-excerpt", x: 60, y: 115, text: @src.excerpt, fontSize: 12, align: "left", color: "#44403c" },
              { type: text, id: "source-progress", x: 60, y: 160, text: (str/concat "Source " (+ @entity.sourceIndex 1) " of " (array/len @config.sources) " — score " @entity.score " / " @config.scoreCap), fontSize: 12, align: "left", color: "#78350f" }
            ])
          )
          (do
            (set @entity.shapes @cardShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Classify each aspect of the source — historical situation, intended audience, purpose, point of view, and whether it is primary or secondary." },
                { type: stack, direction: vertical, gap: sm, children: (array/map @config.rubricCategories (fn cat { type: stack, direction: vertical, gap: xs, children: [ { type: typography, variant: body, content: @cat.label }, { type: stack, direction: horizontal, gap: xs, children: (array/map @cat.options (fn opt { type: button, action: CLASSIFY_ASPECT, actionPayload: { aspect: @cat.aspect, value: @opt }, label: @opt, variant: (if (== (object/get (array/find @entity.picks (fn p (== @p.aspect @cat.aspect))) value "") @opt) "primary" "ghost"), size: sm })) } ] })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_SOURCE, label: "Next Source", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (if @entity.done (str/concat "All aspects classified — score " @entity.score " of " @config.scoreCap ".") "Classify every aspect to complete this source.") }
              ] }
          ]
        })
        (emit SOURCING_UPDATED { sourceIndex: @entity.sourceIndex, picks: @entity.picks, score: @entity.score, done: @entity.done })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.sourceIndex 0)
        (set @entity.picks [])
        (set @entity.score 0)
        (set @entity.done false)
        (let (
            (src (array/nth @config.sources @entity.sourceIndex))
            (cardShapes [
              { type: rect, id: "source-card", x: 40, y: 40, width: (- @config.width 80), height: 150, fill: "#faf5eb", color: "#d6d3d1", opacity: 1, lineWidth: 1 },
              { type: text, id: "source-title", x: 60, y: 80, text: @src.title, fontSize: 15, align: "left", color: "#1c1917" },
              { type: text, id: "source-excerpt", x: 60, y: 115, text: @src.excerpt, fontSize: 12, align: "left", color: "#44403c" },
              { type: text, id: "source-progress", x: 60, y: 160, text: (str/concat "Source " (+ @entity.sourceIndex 1) " of " (array/len @config.sources) " — score " @entity.score " / " @config.scoreCap), fontSize: 12, align: "left", color: "#78350f" }
            ])
          )
          (do
            (set @entity.shapes @cardShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Classify each aspect of the source — historical situation, intended audience, purpose, point of view, and whether it is primary or secondary." },
                { type: stack, direction: vertical, gap: sm, children: (array/map @config.rubricCategories (fn cat { type: stack, direction: vertical, gap: xs, children: [ { type: typography, variant: body, content: @cat.label }, { type: stack, direction: horizontal, gap: xs, children: (array/map @cat.options (fn opt { type: button, action: CLASSIFY_ASPECT, actionPayload: { aspect: @cat.aspect, value: @opt }, label: @opt, variant: (if (== (object/get (array/find @entity.picks (fn p (== @p.aspect @cat.aspect))) value "") @opt) "primary" "ghost"), size: sm })) } ] })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_SOURCE, label: "Next Source", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (if @entity.done (str/concat "All aspects classified — score " @entity.score " of " @config.scoreCap ".") "Classify every aspect to complete this source.") }
              ] }
          ]
        })
        (emit SOURCING_UPDATED { sourceIndex: @entity.sourceIndex, picks: @entity.picks, score: @entity.score, done: @entity.done })

      CLASSIFY_ASPECT -> idle when (== @entity.active true)
        (set @entity.picks (array/concat (array/filter @entity.picks (fn p (!= @p.aspect ?aspect))) [{ aspect: ?aspect, value: ?value }]))
        (let (
            (src (array/nth @config.sources @entity.sourceIndex))
            (matching (array/len (array/filter @entity.picks (fn p
              (if (== @p.aspect "kind") (== @p.value @src.kind)
              (if (== @p.aspect "situation") (== @p.value @src.situation)
              (if (== @p.aspect "audience") (== @p.value @src.audience)
              (if (== @p.aspect "purpose") (== @p.value @src.purpose)
              (== @p.value @src.pov)))))))))
            (capped (if (> @matching @config.scoreCap) @config.scoreCap @matching))
          )
          (do
            (set @entity.score @capped)
            (set @entity.done (>= (array/len @entity.picks) (array/len @config.rubricCategories)))
          )
        )
        (let (
            (src (array/nth @config.sources @entity.sourceIndex))
            (cardShapes [
              { type: rect, id: "source-card", x: 40, y: 40, width: (- @config.width 80), height: 150, fill: "#faf5eb", color: "#d6d3d1", opacity: 1, lineWidth: 1 },
              { type: text, id: "source-title", x: 60, y: 80, text: @src.title, fontSize: 15, align: "left", color: "#1c1917" },
              { type: text, id: "source-excerpt", x: 60, y: 115, text: @src.excerpt, fontSize: 12, align: "left", color: "#44403c" },
              { type: text, id: "source-progress", x: 60, y: 160, text: (str/concat "Source " (+ @entity.sourceIndex 1) " of " (array/len @config.sources) " — score " @entity.score " / " @config.scoreCap), fontSize: 12, align: "left", color: "#78350f" }
            ])
          )
          (do
            (set @entity.shapes @cardShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Classify each aspect of the source — historical situation, intended audience, purpose, point of view, and whether it is primary or secondary." },
                { type: stack, direction: vertical, gap: sm, children: (array/map @config.rubricCategories (fn cat { type: stack, direction: vertical, gap: xs, children: [ { type: typography, variant: body, content: @cat.label }, { type: stack, direction: horizontal, gap: xs, children: (array/map @cat.options (fn opt { type: button, action: CLASSIFY_ASPECT, actionPayload: { aspect: @cat.aspect, value: @opt }, label: @opt, variant: (if (== (object/get (array/find @entity.picks (fn p (== @p.aspect @cat.aspect))) value "") @opt) "primary" "ghost"), size: sm })) } ] })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_SOURCE, label: "Next Source", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (if @entity.done (str/concat "All aspects classified — score " @entity.score " of " @config.scoreCap ".") "Classify every aspect to complete this source.") }
              ] }
          ]
        })
        (emit SOURCING_UPDATED { sourceIndex: @entity.sourceIndex, picks: @entity.picks, score: @entity.score, done: @entity.done })

      NEXT_SOURCE -> idle when (== @entity.active true)
        (set @entity.sourceIndex (if (>= (+ @entity.sourceIndex 1) (array/len @config.sources)) 0 (+ @entity.sourceIndex 1)))
        (set @entity.picks [])
        (set @entity.score 0)
        (set @entity.done false)
        (let (
            (src (array/nth @config.sources @entity.sourceIndex))
            (cardShapes [
              { type: rect, id: "source-card", x: 40, y: 40, width: (- @config.width 80), height: 150, fill: "#faf5eb", color: "#d6d3d1", opacity: 1, lineWidth: 1 },
              { type: text, id: "source-title", x: 60, y: 80, text: @src.title, fontSize: 15, align: "left", color: "#1c1917" },
              { type: text, id: "source-excerpt", x: 60, y: 115, text: @src.excerpt, fontSize: 12, align: "left", color: "#44403c" },
              { type: text, id: "source-progress", x: 60, y: 160, text: (str/concat "Source " (+ @entity.sourceIndex 1) " of " (array/len @config.sources) " — score " @entity.score " / " @config.scoreCap), fontSize: 12, align: "left", color: "#78350f" }
            ])
          )
          (do
            (set @entity.shapes @cardShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Classify each aspect of the source — historical situation, intended audience, purpose, point of view, and whether it is primary or secondary." },
                { type: stack, direction: vertical, gap: sm, children: (array/map @config.rubricCategories (fn cat { type: stack, direction: vertical, gap: xs, children: [ { type: typography, variant: body, content: @cat.label }, { type: stack, direction: horizontal, gap: xs, children: (array/map @cat.options (fn opt { type: button, action: CLASSIFY_ASPECT, actionPayload: { aspect: @cat.aspect, value: @opt }, label: @opt, variant: (if (== (object/get (array/find @entity.picks (fn p (== @p.aspect @cat.aspect))) value "") @opt) "primary" "ghost"), size: sm })) } ] })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_SOURCE, label: "Next Source", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (if @entity.done (str/concat "All aspects classified — score " @entity.score " of " @config.scoreCap ".") "Classify every aspect to complete this source.") }
              ] }
          ]
        })
        (emit SOURCING_UPDATED { sourceIndex: @entity.sourceIndex, picks: @entity.picks, score: @entity.score, done: @entity.done })

      RESET -> idle when (== @entity.active true)
        (set @entity.sourceIndex 0)
        (set @entity.picks [])
        (set @entity.score 0)
        (set @entity.done false)
        (let (
            (src (array/nth @config.sources @entity.sourceIndex))
            (cardShapes [
              { type: rect, id: "source-card", x: 40, y: 40, width: (- @config.width 80), height: 150, fill: "#faf5eb", color: "#d6d3d1", opacity: 1, lineWidth: 1 },
              { type: text, id: "source-title", x: 60, y: 80, text: @src.title, fontSize: 15, align: "left", color: "#1c1917" },
              { type: text, id: "source-excerpt", x: 60, y: 115, text: @src.excerpt, fontSize: 12, align: "left", color: "#44403c" },
              { type: text, id: "source-progress", x: 60, y: 160, text: (str/concat "Source " (+ @entity.sourceIndex 1) " of " (array/len @config.sources) " — score " @entity.score " / " @config.scoreCap), fontSize: 12, align: "left", color: "#78350f" }
            ])
          )
          (do
            (set @entity.shapes @cardShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Classify each aspect of the source — historical situation, intended audience, purpose, point of view, and whether it is primary or secondary." },
                { type: stack, direction: vertical, gap: sm, children: (array/map @config.rubricCategories (fn cat { type: stack, direction: vertical, gap: xs, children: [ { type: typography, variant: body, content: @cat.label }, { type: stack, direction: horizontal, gap: xs, children: (array/map @cat.options (fn opt { type: button, action: CLASSIFY_ASPECT, actionPayload: { aspect: @cat.aspect, value: @opt }, label: @opt, variant: (if (== (object/get (array/find @entity.picks (fn p (== @p.aspect @cat.aspect))) value "") @opt) "primary" "ghost"), size: sm })) } ] })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_SOURCE, label: "Next Source", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (if @entity.done (str/concat "All aspects classified — score " @entity.score " of " @config.scoreCap ".") "Classify every aspect to complete this source.") }
              ] }
          ]
        })
        (emit SOURCING_UPDATED { sourceIndex: @entity.sourceIndex, picks: @entity.picks, score: @entity.score, done: @entity.done })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      CLASSIFY_ASPECT {
        aspect : string
        value : string
      }
        @description "Learner picked a value for one rubric aspect (kind, situation, audience, purpose, or pov) of the current source."
        @tier "domain"
      NEXT_SOURCE {
      }
        @description "Learner advanced to the next source in the roster, clearing the current picks."
        @tier "domain"
      RESET {
      }
        @description "Learner restarted the exercise from the first source with all picks cleared."
        @tier "domain"
    }

    emits {
      SOURCING_UPDATED -> external {
        sourceIndex : number
        picks : [json]
        score : number
        done : boolean
      }
        @description "The sourcing instrument state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "sourcing update, hipp analysis, source classification, primary source, secondary source, historical situation, intended audience, purpose, point of view"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Source Analysis"
        @label "Title"
        @description "Title shown above the lab."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 260
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      sources : [HistSourcingSource] = [
        { id: "gettysburg-address", title: "The Gettysburg Address (1863)", excerpt: "Four score and seven years ago our fathers brought forth on this continent a new nation...", kind: "primary", situation: "wartime", audience: "public", purpose: "persuade", pov: "elite" },
        { id: "suffragette-poster", title: "Suffragette Poster (1912)", excerpt: "Votes for Women — the surest safeguard for the home and the nation...", kind: "primary", situation: "peacetime", audience: "public", purpose: "persuade", pov: "commoner" },
        { id: "modern-textbook", title: "Modern Textbook Chapter on WWI (2015)", excerpt: "Historians today debate whether the July Crisis made war inevitable...", kind: "secondary", situation: "peacetime", audience: "public", purpose: "inform", pov: "outsider" }
      ]
        @label "Sources"
        @description "Roster of historical sources to analyze; each carries its canonical HIPP attribution (situation, audience, purpose, point of view) plus its primary/secondary kind."
        @synonyms "source roster, primary source, secondary source, document, excerpt, historical document, artifact"
        @tier "domain"
      rubricCategories : [HistSourcingRubric] = [
        { aspect: "kind", label: "Primary or secondary?", options: ["primary", "secondary"] },
        { aspect: "situation", label: "Historical situation", options: ["wartime", "peacetime", "revolution"] },
        { aspect: "audience", label: "Intended audience", options: ["public", "government", "private"] },
        { aspect: "purpose", label: "Purpose", options: ["inform", "persuade", "record"] },
        { aspect: "pov", label: "Point of view", options: ["elite", "commoner", "outsider"] }
      ]
        @label "Rubric Categories"
        @description "The HIPP rubric rows the learner classifies: historical situation, intended audience, purpose, point of view, and primary-vs-secondary kind, each with its fixed option set."
        @synonyms "hipp, rubric, historical situation, intended audience, purpose, point of view, sourcing rubric, document analysis"
        @tier "domain"
      scoreCap : number = 5
        @label "Score Cap"
        @description "Maximum score per source — one point per correctly classified aspect, capped at this value."
        @tier "domain"
    }
  }

  page "/hist-sourcing" as HistSourcingPage -> HistSourcingSim
}
