app std-geo-population "1.0.0"
"Age-sex population pyramid engine — the learner drives birth/death/migration rate dials and steps a five-cohort cohort-component projection, reading the dependency ratio and pyramid shape classification on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital GeoPopulationOrbital {
  type GeoPopulationShapePoint = {
    x : number!
    y : number!
  }
  type GeoPopulationShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [GeoPopulationShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type GeoPopulationCohortSeed = {
    id : string!
    label : string!
    order : number!
    maleShare : number!
    femaleShare : number!
    baseSurvivalRate : number!
    deathSensitivity : number!
  }
  type GeoPopulationClassRule = {
    code : string!
    label : string!
    description : string
    minBaseSharePercent : number!
  }

  entity GeoPopulationScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    birthRate : number
    deathRate : number
    migrationRate : number
    decadeStep : number
    c0Male : number
    c0Female : number
    c1Male : number
    c1Female : number
    c2Male : number
    c2Female : number
    c3Male : number
    c3Female : number
    c4Male : number
    c4Female : number
    totalPopulation : number
    dependencyRatio : number
    baseSharePercent : number
    pyramidClassCode : string
    pyramidClassLabel : string
    pyramidClassReadout : string
    pyramidShapes : [GeoPopulationShape]
  }

  trait GeoPopulationSim -> @rebindable GeoPopulationScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.birthRate @config.birthRate)
        (set @entity.deathRate @config.deathRate)
        (set @entity.migrationRate @config.migrationRate)
        (set @entity.decadeStep 0)
        (let (
            (seed0 (array/nth @config.cohortSeeds 0))
            (seed1 (array/nth @config.cohortSeeds 1))
            (seed2 (array/nth @config.cohortSeeds 2))
            (seed3 (array/nth @config.cohortSeeds 3))
            (seed4 (array/nth @config.cohortSeeds 4))
            (newC0Male (object/get @seed0 maleShare))
            (newC0Female (object/get @seed0 femaleShare))
            (newC1Male (object/get @seed1 maleShare))
            (newC1Female (object/get @seed1 femaleShare))
            (newC2Male (object/get @seed2 maleShare))
            (newC2Female (object/get @seed2 femaleShare))
            (newC3Male (object/get @seed3 maleShare))
            (newC3Female (object/get @seed3 femaleShare))
            (newC4Male (object/get @seed4 maleShare))
            (newC4Female (object/get @seed4 femaleShare))
            (young (+ @newC0Male @newC0Female))
            (old (+ (+ @newC3Male @newC3Female) (+ @newC4Male @newC4Female)))
            (workingAge (+ (+ @newC1Male @newC1Female) (+ @newC2Male @newC2Female)))
            (total (+ (+ @young @old) @workingAge))
            (dependencyRatio (/ (+ @young @old) (math/max @workingAge 0.0001)))
            (baseSharePercent (* (/ @young @total) 100))
            (matchedRule (array/first (array/filter @config.pyramidClassRules (fn r (>= @baseSharePercent (object/get @r minBaseSharePercent))))))
            (matchedRuleFinal (if (== @matchedRule null) (array/last @config.pyramidClassRules) @matchedRule))
            (pyramidClassCode (object/get @matchedRuleFinal code))
            (pyramidClassLabel (object/get @matchedRuleFinal label))
            (pyramidClassReadout (str/concat "Pyramid shape: " @pyramidClassLabel " — youngest cohort is " (math/round @baseSharePercent 1) "% of total population (threshold " (object/get @matchedRuleFinal minBaseSharePercent) "%)"))
            (centerX (/ @config.width 2))
            (bandHeight (/ (- @config.height 60) 5))
            (barThickness (- @bandHeight 8))
            (halfWidth (- (/ @config.width 2) 30))
            (rows [
                { label: (object/get @seed0 label), male: @newC0Male, female: @newC0Female, order: 0 },
                { label: (object/get @seed1 label), male: @newC1Male, female: @newC1Female, order: 1 },
                { label: (object/get @seed2 label), male: @newC2Male, female: @newC2Female, order: 2 },
                { label: (object/get @seed3 label), male: @newC3Male, female: @newC3Female, order: 3 },
                { label: (object/get @seed4 label), male: @newC4Male, female: @newC4Female, order: 4 }
              ])
            (computedRows (array/map @rows (fn r (let (
                    (rowY (+ 30 (* (object/get @r order) @bandHeight)))
                    (malePercent (* (/ (object/get @r male) @total) 100))
                    (femalePercent (* (/ (object/get @r female) @total) 100))
                    (maleBarWidth (math/min @halfWidth (* (/ @malePercent @config.pyramidScaleMaxPercent) @halfWidth)))
                    (femaleBarWidth (math/min @halfWidth (* (/ @femalePercent @config.pyramidScaleMaxPercent) @halfWidth)))
                  )
                  { label: (object/get @r label), rowY: @rowY, malePercent: @malePercent, femalePercent: @femalePercent, maleBarWidth: @maleBarWidth, femaleBarWidth: @femaleBarWidth }))))
            (maleRects (array/map @computedRows (fn cr { type: rect, x: (- @centerX (object/get @cr maleBarWidth)), y: (object/get @cr rowY), width: (object/get @cr maleBarWidth), height: @barThickness, color: @config.maleColor, fill: @config.maleColor })))
            (femaleRects (array/map @computedRows (fn cr { type: rect, x: @centerX, y: (object/get @cr rowY), width: (object/get @cr femaleBarWidth), height: @barThickness, color: @config.femaleColor, fill: @config.femaleColor })))
            (labelTexts (array/map @computedRows (fn cr { type: text, x: @centerX, y: (+ (object/get @cr rowY) (+ (/ @barThickness 2) 4)), text: (str/concat (object/get @cr label) " — " (math/round (object/get @cr malePercent) 1) "% M / " (math/round (object/get @cr femalePercent) 1) "% F"), fontSize: 12, align: "center", color: @config.textColor })))
            (centerLine [ { type: line, x1: @centerX, y1: 20, x2: @centerX, y2: (- @config.height 10), color: @config.axisColor, lineWidth: 1 } ])
            (pyramidShapes (array/concat (array/concat (array/concat @maleRects @femaleRects) @labelTexts) @centerLine))
          )
          (do
            (set @entity.c0Male @newC0Male)
            (set @entity.c0Female @newC0Female)
            (set @entity.c1Male @newC1Male)
            (set @entity.c1Female @newC1Female)
            (set @entity.c2Male @newC2Male)
            (set @entity.c2Female @newC2Female)
            (set @entity.c3Male @newC3Male)
            (set @entity.c3Female @newC3Female)
            (set @entity.c4Male @newC4Male)
            (set @entity.c4Female @newC4Female)
            (set @entity.totalPopulation @total)
            (set @entity.dependencyRatio @dependencyRatio)
            (set @entity.baseSharePercent @baseSharePercent)
            (set @entity.pyramidClassCode @pyramidClassCode)
            (set @entity.pyramidClassLabel @pyramidClassLabel)
            (set @entity.pyramidClassReadout @pyramidClassReadout)
            (set @entity.pyramidShapes @pyramidShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.pyramidShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_BIRTH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_DEATH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Net migration: " @entity.migrationRate "%") },
                    { type: range-slider, min: -30, max: 30, step: 1, value: @entity.migrationRate, showTooltip: true, onChange: SET_MIGRATION }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_DECADE, label: "Step Decade", variant: primary }
                  ] },
                { type: typography, variant: body, content: (str/concat "Generations advanced: " @entity.decadeStep) },
                { type: typography, variant: body, content: (str/concat "Total population index: " (math/round @entity.totalPopulation 1)) },
                { type: typography, variant: body, content: (str/concat "Dependency ratio: " (math/round @entity.dependencyRatio 2)) },
                { type: typography, variant: body, content: @entity.pyramidClassReadout }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.birthRate @config.birthRate)
        (set @entity.deathRate @config.deathRate)
        (set @entity.migrationRate @config.migrationRate)
        (set @entity.decadeStep 0)
        (let (
            (seed0 (array/nth @config.cohortSeeds 0))
            (seed1 (array/nth @config.cohortSeeds 1))
            (seed2 (array/nth @config.cohortSeeds 2))
            (seed3 (array/nth @config.cohortSeeds 3))
            (seed4 (array/nth @config.cohortSeeds 4))
            (newC0Male (object/get @seed0 maleShare))
            (newC0Female (object/get @seed0 femaleShare))
            (newC1Male (object/get @seed1 maleShare))
            (newC1Female (object/get @seed1 femaleShare))
            (newC2Male (object/get @seed2 maleShare))
            (newC2Female (object/get @seed2 femaleShare))
            (newC3Male (object/get @seed3 maleShare))
            (newC3Female (object/get @seed3 femaleShare))
            (newC4Male (object/get @seed4 maleShare))
            (newC4Female (object/get @seed4 femaleShare))
            (young (+ @newC0Male @newC0Female))
            (old (+ (+ @newC3Male @newC3Female) (+ @newC4Male @newC4Female)))
            (workingAge (+ (+ @newC1Male @newC1Female) (+ @newC2Male @newC2Female)))
            (total (+ (+ @young @old) @workingAge))
            (dependencyRatio (/ (+ @young @old) (math/max @workingAge 0.0001)))
            (baseSharePercent (* (/ @young @total) 100))
            (matchedRule (array/first (array/filter @config.pyramidClassRules (fn r (>= @baseSharePercent (object/get @r minBaseSharePercent))))))
            (matchedRuleFinal (if (== @matchedRule null) (array/last @config.pyramidClassRules) @matchedRule))
            (pyramidClassCode (object/get @matchedRuleFinal code))
            (pyramidClassLabel (object/get @matchedRuleFinal label))
            (pyramidClassReadout (str/concat "Pyramid shape: " @pyramidClassLabel " — youngest cohort is " (math/round @baseSharePercent 1) "% of total population (threshold " (object/get @matchedRuleFinal minBaseSharePercent) "%)"))
            (centerX (/ @config.width 2))
            (bandHeight (/ (- @config.height 60) 5))
            (barThickness (- @bandHeight 8))
            (halfWidth (- (/ @config.width 2) 30))
            (rows [
                { label: (object/get @seed0 label), male: @newC0Male, female: @newC0Female, order: 0 },
                { label: (object/get @seed1 label), male: @newC1Male, female: @newC1Female, order: 1 },
                { label: (object/get @seed2 label), male: @newC2Male, female: @newC2Female, order: 2 },
                { label: (object/get @seed3 label), male: @newC3Male, female: @newC3Female, order: 3 },
                { label: (object/get @seed4 label), male: @newC4Male, female: @newC4Female, order: 4 }
              ])
            (computedRows (array/map @rows (fn r (let (
                    (rowY (+ 30 (* (object/get @r order) @bandHeight)))
                    (malePercent (* (/ (object/get @r male) @total) 100))
                    (femalePercent (* (/ (object/get @r female) @total) 100))
                    (maleBarWidth (math/min @halfWidth (* (/ @malePercent @config.pyramidScaleMaxPercent) @halfWidth)))
                    (femaleBarWidth (math/min @halfWidth (* (/ @femalePercent @config.pyramidScaleMaxPercent) @halfWidth)))
                  )
                  { label: (object/get @r label), rowY: @rowY, malePercent: @malePercent, femalePercent: @femalePercent, maleBarWidth: @maleBarWidth, femaleBarWidth: @femaleBarWidth }))))
            (maleRects (array/map @computedRows (fn cr { type: rect, x: (- @centerX (object/get @cr maleBarWidth)), y: (object/get @cr rowY), width: (object/get @cr maleBarWidth), height: @barThickness, color: @config.maleColor, fill: @config.maleColor })))
            (femaleRects (array/map @computedRows (fn cr { type: rect, x: @centerX, y: (object/get @cr rowY), width: (object/get @cr femaleBarWidth), height: @barThickness, color: @config.femaleColor, fill: @config.femaleColor })))
            (labelTexts (array/map @computedRows (fn cr { type: text, x: @centerX, y: (+ (object/get @cr rowY) (+ (/ @barThickness 2) 4)), text: (str/concat (object/get @cr label) " — " (math/round (object/get @cr malePercent) 1) "% M / " (math/round (object/get @cr femalePercent) 1) "% F"), fontSize: 12, align: "center", color: @config.textColor })))
            (centerLine [ { type: line, x1: @centerX, y1: 20, x2: @centerX, y2: (- @config.height 10), color: @config.axisColor, lineWidth: 1 } ])
            (pyramidShapes (array/concat (array/concat (array/concat @maleRects @femaleRects) @labelTexts) @centerLine))
          )
          (do
            (set @entity.c0Male @newC0Male)
            (set @entity.c0Female @newC0Female)
            (set @entity.c1Male @newC1Male)
            (set @entity.c1Female @newC1Female)
            (set @entity.c2Male @newC2Male)
            (set @entity.c2Female @newC2Female)
            (set @entity.c3Male @newC3Male)
            (set @entity.c3Female @newC3Female)
            (set @entity.c4Male @newC4Male)
            (set @entity.c4Female @newC4Female)
            (set @entity.totalPopulation @total)
            (set @entity.dependencyRatio @dependencyRatio)
            (set @entity.baseSharePercent @baseSharePercent)
            (set @entity.pyramidClassCode @pyramidClassCode)
            (set @entity.pyramidClassLabel @pyramidClassLabel)
            (set @entity.pyramidClassReadout @pyramidClassReadout)
            (set @entity.pyramidShapes @pyramidShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.pyramidShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_BIRTH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_DEATH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Net migration: " @entity.migrationRate "%") },
                    { type: range-slider, min: -30, max: 30, step: 1, value: @entity.migrationRate, showTooltip: true, onChange: SET_MIGRATION }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_DECADE, label: "Step Decade", variant: primary }
                  ] },
                { type: typography, variant: body, content: (str/concat "Generations advanced: " @entity.decadeStep) },
                { type: typography, variant: body, content: (str/concat "Total population index: " (math/round @entity.totalPopulation 1)) },
                { type: typography, variant: body, content: (str/concat "Dependency ratio: " (math/round @entity.dependencyRatio 2)) },
                { type: typography, variant: body, content: @entity.pyramidClassReadout }
              ] }
          ]
        })

      SET_BIRTH_RATE -> idle when (== @entity.active true)
        (set @entity.birthRate ?value)
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.pyramidShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_BIRTH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_DEATH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Net migration: " @entity.migrationRate "%") },
                    { type: range-slider, min: -30, max: 30, step: 1, value: @entity.migrationRate, showTooltip: true, onChange: SET_MIGRATION }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_DECADE, label: "Step Decade", variant: primary }
                  ] },
                { type: typography, variant: body, content: (str/concat "Generations advanced: " @entity.decadeStep) },
                { type: typography, variant: body, content: (str/concat "Total population index: " (math/round @entity.totalPopulation 1)) },
                { type: typography, variant: body, content: (str/concat "Dependency ratio: " (math/round @entity.dependencyRatio 2)) },
                { type: typography, variant: body, content: @entity.pyramidClassReadout }
              ] }
          ]
        })
        (emit POPULATION_UPDATED { birthRate: @entity.birthRate, deathRate: @entity.deathRate, migrationRate: @entity.migrationRate, decadeStep: @entity.decadeStep, totalPopulation: @entity.totalPopulation, dependencyRatio: @entity.dependencyRatio, pyramidClassLabel: @entity.pyramidClassLabel })

      SET_DEATH_RATE -> idle when (== @entity.active true)
        (set @entity.deathRate ?value)
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.pyramidShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_BIRTH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_DEATH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Net migration: " @entity.migrationRate "%") },
                    { type: range-slider, min: -30, max: 30, step: 1, value: @entity.migrationRate, showTooltip: true, onChange: SET_MIGRATION }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_DECADE, label: "Step Decade", variant: primary }
                  ] },
                { type: typography, variant: body, content: (str/concat "Generations advanced: " @entity.decadeStep) },
                { type: typography, variant: body, content: (str/concat "Total population index: " (math/round @entity.totalPopulation 1)) },
                { type: typography, variant: body, content: (str/concat "Dependency ratio: " (math/round @entity.dependencyRatio 2)) },
                { type: typography, variant: body, content: @entity.pyramidClassReadout }
              ] }
          ]
        })
        (emit POPULATION_UPDATED { birthRate: @entity.birthRate, deathRate: @entity.deathRate, migrationRate: @entity.migrationRate, decadeStep: @entity.decadeStep, totalPopulation: @entity.totalPopulation, dependencyRatio: @entity.dependencyRatio, pyramidClassLabel: @entity.pyramidClassLabel })

      SET_MIGRATION -> idle when (== @entity.active true)
        (set @entity.migrationRate ?value)
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.pyramidShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_BIRTH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_DEATH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Net migration: " @entity.migrationRate "%") },
                    { type: range-slider, min: -30, max: 30, step: 1, value: @entity.migrationRate, showTooltip: true, onChange: SET_MIGRATION }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_DECADE, label: "Step Decade", variant: primary }
                  ] },
                { type: typography, variant: body, content: (str/concat "Generations advanced: " @entity.decadeStep) },
                { type: typography, variant: body, content: (str/concat "Total population index: " (math/round @entity.totalPopulation 1)) },
                { type: typography, variant: body, content: (str/concat "Dependency ratio: " (math/round @entity.dependencyRatio 2)) },
                { type: typography, variant: body, content: @entity.pyramidClassReadout }
              ] }
          ]
        })
        (emit POPULATION_UPDATED { birthRate: @entity.birthRate, deathRate: @entity.deathRate, migrationRate: @entity.migrationRate, decadeStep: @entity.decadeStep, totalPopulation: @entity.totalPopulation, dependencyRatio: @entity.dependencyRatio, pyramidClassLabel: @entity.pyramidClassLabel })

      STEP_DECADE -> idle when (== @entity.active true)
        (let (
            (seed0 (array/nth @config.cohortSeeds 0))
            (seed1 (array/nth @config.cohortSeeds 1))
            (seed2 (array/nth @config.cohortSeeds 2))
            (seed3 (array/nth @config.cohortSeeds 3))
            (seed4 (array/nth @config.cohortSeeds 4))
            (survivalRate0 (math/max 0 (- (object/get @seed0 baseSurvivalRate) (* (/ @entity.deathRate 100) (object/get @seed0 deathSensitivity)))))
            (survivalRate1 (math/max 0 (- (object/get @seed1 baseSurvivalRate) (* (/ @entity.deathRate 100) (object/get @seed1 deathSensitivity)))))
            (survivalRate2 (math/max 0 (- (object/get @seed2 baseSurvivalRate) (* (/ @entity.deathRate 100) (object/get @seed2 deathSensitivity)))))
            (survivalRate3 (math/max 0 (- (object/get @seed3 baseSurvivalRate) (* (/ @entity.deathRate 100) (object/get @seed3 deathSensitivity)))))
            (survivalRate4 (math/max 0 (- (object/get @seed4 baseSurvivalRate) (* (/ @entity.deathRate 100) (object/get @seed4 deathSensitivity)))))
            (survivorsC0Male (* @entity.c0Male @survivalRate0))
            (survivorsC0Female (* @entity.c0Female @survivalRate0))
            (survivorsC1Male (* @entity.c1Male @survivalRate1))
            (survivorsC1Female (* @entity.c1Female @survivalRate1))
            (survivorsC2Male (* @entity.c2Male @survivalRate2))
            (survivorsC2Female (* @entity.c2Female @survivalRate2))
            (survivorsC3Male (* @entity.c3Male @survivalRate3))
            (survivorsC3Female (* @entity.c3Female @survivalRate3))
            (survivorsC4Male (* @entity.c4Male @survivalRate4))
            (survivorsC4Female (* @entity.c4Female @survivalRate4))
            (births (* (* (/ @entity.birthRate 100) @config.birthRateCoefficient) (+ @entity.c1Male @entity.c1Female)))
            (birthsMale (* @births @config.sexRatioAtBirth))
            (birthsFemale (* @births (- 1 @config.sexRatioAtBirth)))
            (newC0Male @birthsMale)
            (newC0Female @birthsFemale)
            (newC1MalePreMig @survivorsC0Male)
            (newC1FemalePreMig @survivorsC0Female)
            (newC2MalePreMig @survivorsC1Male)
            (newC2FemalePreMig @survivorsC1Female)
            (newC3Male @survivorsC2Male)
            (newC3Female @survivorsC2Female)
            (newC4Male (+ @survivorsC3Male @survivorsC4Male))
            (newC4Female (+ @survivorsC3Female @survivorsC4Female))
            (workingAgePreMig (+ (+ @newC1MalePreMig @newC1FemalePreMig) (+ @newC2MalePreMig @newC2FemalePreMig)))
            (migrationDelta (* (* (/ @entity.migrationRate 100) @config.migrationCoefficient) @workingAgePreMig))
            (c1Delta (* @migrationDelta 0.5))
            (c2Delta (* @migrationDelta 0.5))
            (c1TotalPreMig (math/max (+ @newC1MalePreMig @newC1FemalePreMig) 0.0001))
            (c1MaleRatio (/ @newC1MalePreMig @c1TotalPreMig))
            (newC1Male (math/max 0 (+ @newC1MalePreMig (* @c1Delta @c1MaleRatio))))
            (newC1Female (math/max 0 (+ @newC1FemalePreMig (* @c1Delta (- 1 @c1MaleRatio)))))
            (c2TotalPreMig (math/max (+ @newC2MalePreMig @newC2FemalePreMig) 0.0001))
            (c2MaleRatio (/ @newC2MalePreMig @c2TotalPreMig))
            (newC2Male (math/max 0 (+ @newC2MalePreMig (* @c2Delta @c2MaleRatio))))
            (newC2Female (math/max 0 (+ @newC2FemalePreMig (* @c2Delta (- 1 @c2MaleRatio)))))
            (young (+ @newC0Male @newC0Female))
            (old (+ (+ @newC3Male @newC3Female) (+ @newC4Male @newC4Female)))
            (workingAge (+ (+ @newC1Male @newC1Female) (+ @newC2Male @newC2Female)))
            (total (+ (+ @young @old) @workingAge))
            (dependencyRatio (/ (+ @young @old) (math/max @workingAge 0.0001)))
            (baseSharePercent (* (/ @young @total) 100))
            (matchedRule (array/first (array/filter @config.pyramidClassRules (fn r (>= @baseSharePercent (object/get @r minBaseSharePercent))))))
            (matchedRuleFinal (if (== @matchedRule null) (array/last @config.pyramidClassRules) @matchedRule))
            (pyramidClassCode (object/get @matchedRuleFinal code))
            (pyramidClassLabel (object/get @matchedRuleFinal label))
            (pyramidClassReadout (str/concat "Pyramid shape: " @pyramidClassLabel " — youngest cohort is " (math/round @baseSharePercent 1) "% of total population (threshold " (object/get @matchedRuleFinal minBaseSharePercent) "%)"))
            (centerX (/ @config.width 2))
            (bandHeight (/ (- @config.height 60) 5))
            (barThickness (- @bandHeight 8))
            (halfWidth (- (/ @config.width 2) 30))
            (rows [
                { label: (object/get @seed0 label), male: @newC0Male, female: @newC0Female, order: 0 },
                { label: (object/get @seed1 label), male: @newC1Male, female: @newC1Female, order: 1 },
                { label: (object/get @seed2 label), male: @newC2Male, female: @newC2Female, order: 2 },
                { label: (object/get @seed3 label), male: @newC3Male, female: @newC3Female, order: 3 },
                { label: (object/get @seed4 label), male: @newC4Male, female: @newC4Female, order: 4 }
              ])
            (computedRows (array/map @rows (fn r (let (
                    (rowY (+ 30 (* (object/get @r order) @bandHeight)))
                    (malePercent (* (/ (object/get @r male) @total) 100))
                    (femalePercent (* (/ (object/get @r female) @total) 100))
                    (maleBarWidth (math/min @halfWidth (* (/ @malePercent @config.pyramidScaleMaxPercent) @halfWidth)))
                    (femaleBarWidth (math/min @halfWidth (* (/ @femalePercent @config.pyramidScaleMaxPercent) @halfWidth)))
                  )
                  { label: (object/get @r label), rowY: @rowY, malePercent: @malePercent, femalePercent: @femalePercent, maleBarWidth: @maleBarWidth, femaleBarWidth: @femaleBarWidth }))))
            (maleRects (array/map @computedRows (fn cr { type: rect, x: (- @centerX (object/get @cr maleBarWidth)), y: (object/get @cr rowY), width: (object/get @cr maleBarWidth), height: @barThickness, color: @config.maleColor, fill: @config.maleColor })))
            (femaleRects (array/map @computedRows (fn cr { type: rect, x: @centerX, y: (object/get @cr rowY), width: (object/get @cr femaleBarWidth), height: @barThickness, color: @config.femaleColor, fill: @config.femaleColor })))
            (labelTexts (array/map @computedRows (fn cr { type: text, x: @centerX, y: (+ (object/get @cr rowY) (+ (/ @barThickness 2) 4)), text: (str/concat (object/get @cr label) " — " (math/round (object/get @cr malePercent) 1) "% M / " (math/round (object/get @cr femalePercent) 1) "% F"), fontSize: 12, align: "center", color: @config.textColor })))
            (centerLine [ { type: line, x1: @centerX, y1: 20, x2: @centerX, y2: (- @config.height 10), color: @config.axisColor, lineWidth: 1 } ])
            (pyramidShapes (array/concat (array/concat (array/concat @maleRects @femaleRects) @labelTexts) @centerLine))
          )
          (do
            (set @entity.c0Male @newC0Male)
            (set @entity.c0Female @newC0Female)
            (set @entity.c1Male @newC1Male)
            (set @entity.c1Female @newC1Female)
            (set @entity.c2Male @newC2Male)
            (set @entity.c2Female @newC2Female)
            (set @entity.c3Male @newC3Male)
            (set @entity.c3Female @newC3Female)
            (set @entity.c4Male @newC4Male)
            (set @entity.c4Female @newC4Female)
            (set @entity.totalPopulation @total)
            (set @entity.dependencyRatio @dependencyRatio)
            (set @entity.baseSharePercent @baseSharePercent)
            (set @entity.pyramidClassCode @pyramidClassCode)
            (set @entity.pyramidClassLabel @pyramidClassLabel)
            (set @entity.pyramidClassReadout @pyramidClassReadout)
            (set @entity.pyramidShapes @pyramidShapes)
            (set @entity.decadeStep (+ @entity.decadeStep 1))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.pyramidShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_BIRTH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate "%") },
                    { type: range-slider, min: 0, max: 50, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_DEATH_RATE },
                    { type: typography, variant: caption, content: (str/concat "Net migration: " @entity.migrationRate "%") },
                    { type: range-slider, min: -30, max: 30, step: 1, value: @entity.migrationRate, showTooltip: true, onChange: SET_MIGRATION }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_DECADE, label: "Step Decade", variant: primary }
                  ] },
                { type: typography, variant: body, content: (str/concat "Generations advanced: " @entity.decadeStep) },
                { type: typography, variant: body, content: (str/concat "Total population index: " (math/round @entity.totalPopulation 1)) },
                { type: typography, variant: body, content: (str/concat "Dependency ratio: " (math/round @entity.dependencyRatio 2)) },
                { type: typography, variant: body, content: @entity.pyramidClassReadout }
              ] }
          ]
        })
        (emit POPULATION_UPDATED { birthRate: @entity.birthRate, deathRate: @entity.deathRate, migrationRate: @entity.migrationRate, decadeStep: @entity.decadeStep, totalPopulation: @entity.totalPopulation, dependencyRatio: @entity.dependencyRatio, pyramidClassLabel: @entity.pyramidClassLabel })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_BIRTH_RATE {
        value : number
      }
        @description "Learner dragged the birth-rate dial."
        @tier "domain"
      SET_DEATH_RATE {
        value : number
      }
        @description "Learner dragged the death-rate dial."
        @tier "domain"
      SET_MIGRATION {
        value : number
      }
        @description "Learner dragged the net-migration dial."
        @tier "domain"
      STEP_DECADE {
      }
        @description "Learner pressed Step Decade to advance the cohort-component projection by one generation."
        @tier "domain"
    }

    emits {
      POPULATION_UPDATED -> external {
        birthRate : number
        deathRate : number
        migrationRate : number
        decadeStep : number
        totalPopulation : number
        dependencyRatio : number
        pyramidClassLabel : string
      }
        @description "The population pyramid state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "population update, cohort projection, decade step, dependency ratio, pyramid shape"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Geography Lab"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 460
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      cohortSeeds : [GeoPopulationCohortSeed] = [
        { id: "c0", label: "0–19", order: 0, maleShare: 130, femaleShare: 125, baseSurvivalRate: 0.97, deathSensitivity: 0.15 },
        { id: "c1", label: "20–39", order: 1, maleShare: 120, femaleShare: 118, baseSurvivalRate: 0.96, deathSensitivity: 0.2 },
        { id: "c2", label: "40–59", order: 2, maleShare: 95, femaleShare: 97, baseSurvivalRate: 0.93, deathSensitivity: 0.3 },
        { id: "c3", label: "60–79", order: 3, maleShare: 55, femaleShare: 60, baseSurvivalRate: 0.85, deathSensitivity: 0.5 },
        { id: "c4", label: "80+", order: 4, maleShare: 15, femaleShare: 20, baseSurvivalRate: 0.7, deathSensitivity: 0.6 }
      ]
        @label "Cohort Seeds"
        @description "Roster of the five age cohorts (0–19 through 80+) seeding the starting population pyramid: id/label/order plus starting male/female shares, each cohort's baseline decade survival rate, and its death-rate sensitivity used by the cohort-component Step Decade."
        @synonyms "age cohort, population cohort, age-sex structure, cohort seed, survival rate, mortality sensitivity"
        @tier "domain"
      birthRate : number = 20
        @label "Birth Rate"
        @description "Starting birth-rate dial (0-50), driving how many births the 20-39 cohort produces on each Step Decade."
        @synonyms "birth rate, fertility rate, natality"
        @tier "domain"
      deathRate : number = 15
        @label "Death Rate"
        @description "Starting death-rate dial (0-50), reducing each cohort's decade survival on each Step Decade."
        @synonyms "death rate, mortality rate"
        @tier "domain"
      migrationRate : number = 0
        @label "Net Migration Rate"
        @description "Starting net-migration dial (-30 to 30), adding or removing working-age share on each Step Decade."
        @synonyms "migration, net migration, immigration, emigration"
        @tier "domain"
      birthRateCoefficient : number = 0.4
        @label "Birth Rate Coefficient"
        @description "Scales the birth-rate dial into actual births: births = (birthRate/100) x this coefficient x the 20-39 cohort size."
        @tier "domain"
      sexRatioAtBirth : number = 0.512
        @label "Sex Ratio At Birth"
        @description "Male share of newborns on each Step Decade; the remainder is female."
        @tier "domain"
      migrationCoefficient : number = 0.3
        @label "Migration Coefficient"
        @description "Scales the migration dial into a population delta: delta = (migrationRate/100) x this coefficient x the working-age total, split across the two working-age cohorts."
        @tier "domain"
      pyramidClassRules : [GeoPopulationClassRule] = [
        { code: "expansive", label: "Expansive", description: "Wide base — youngest cohort's share of total population is at or above the expansive threshold, signalling a young, fast-growing population.", minBaseSharePercent: 32 },
        { code: "stationary", label: "Stationary", description: "Youngest cohort's share is at or above the stationary threshold but below the expansive one, signalling a population near replacement level.", minBaseSharePercent: 18 },
        { code: "constrictive", label: "Constrictive", description: "Youngest cohort's share is below the stationary threshold, signalling a narrowing base and an aging population.", minBaseSharePercent: 0 }
      ]
        @label "Pyramid Shape Classification Rules"
        @description "Ordered thresholds (highest first) on the youngest cohort's percent share of total population; the first rule the share meets or exceeds classifies the pyramid as expansive, stationary, or constrictive."
        @synonyms "expansive pyramid, constrictive pyramid, stationary pyramid, pyramid shape, base share"
        @tier "domain"
      pyramidScaleMaxPercent : number = 40
        @label "Pyramid Bar Scale Max"
        @description "The cohort percent-of-total-population that maps to a full-length pyramid bar; larger shares are clamped to full length."
        @tier "presentation"
      maleColor : string = "#2563eb"
        @label "Male Bar Color"
        @tier "presentation"
      femaleColor : string = "#db2777"
        @label "Female Bar Color"
        @tier "presentation"
      axisColor : string = "#94a3b8"
        @label "Axis Color"
        @tier "presentation"
      textColor : string = "#1e293b"
        @label "Text Color"
        @tier "presentation"
    }
  }

  page "/geo-population" as GeoPopulationPage -> GeoPopulationSim
}
