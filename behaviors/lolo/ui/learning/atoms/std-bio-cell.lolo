app std-bio-cell "1.0.0"
"Eukaryotic cell-structure lab — a config-declared organelle roster the learner tours with Prev/Next; the selected organelle enlarges with a highlight ring and its function is narrated, and a progress readout tracks the tour. A plantMode knob adds chloroplast, cell wall, and central vacuole. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital BioCellEngineOrbital {
  type CellOrganelle = {
    id : string!
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
    role : string
  }

  type BioNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
  }

  type BioEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }

  entity BioCellState [runtime] {
    id : string!
    active : boolean = false
    title : string
    organelles : [CellOrganelle]
    edges : [BioEdge]
    selectedIndex : number = 0
    selectedId : string
    visitedIds : [string] = []
    tourComplete : boolean = false
    narration : string
  }

  trait BioCellSim -> @rebindable BioCellState [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.organelles (if @config.plantMode (array/concat @config.plantOrganelles @config.coreOrganelles) @config.coreOrganelles))
        (set @entity.edges (if @config.plantMode (array/concat @config.plantEdges @config.coreEdges) @config.coreEdges))
        (set @entity.selectedIndex 0)
        (set @entity.selectedId (object/get (array/nth @entity.organelles 0) id))
        (set @entity.visitedIds [(object/get (array/nth @entity.organelles 0) id)])
        (set @entity.tourComplete false)
        (set @entity.narration (str/concat (object/get (array/nth @entity.organelles 0) label) " — " (object/get (array/nth @entity.organelles 0) role)))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV, label: "Prev", variant: secondary },
                    { type: button, action: NEXT, label: "Next", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor,
                  nodes: (array/map @entity.organelles (fn n { id: (object/get @n id), x: (object/get @n x), y: (object/get @n y), radius: (if (== (object/get @n id) @entity.selectedId) (* (object/get @n radius) 1.4) (object/get @n radius)), color: (object/get @n color), label: (object/get @n label), kind: (object/get @n kind) })),
                  edges: @entity.edges,
                  shapes: [ { type: circle, x: (object/get (array/nth @entity.organelles @entity.selectedIndex) x), y: (object/get (array/nth @entity.organelles @entity.selectedIndex) y), radius: (+ (object/get (array/nth @entity.organelles @entity.selectedIndex) radius) 10), color: "#f59e0b", lineWidth: 4 } ]
                },
                { type: typography, variant: body, content: @entity.narration },
                { type: typography, variant: caption, content: (str/concat "Explored " (str/concat "" (array/len @entity.visitedIds)) " of " (str/concat "" (array/len @entity.organelles)) (if @entity.tourComplete " — tour complete!" "")) }
              ] }
          ]
        })
        (emit CELL_SELECTED { id: @entity.selectedId, label: (object/get (array/nth @entity.organelles 0) label), role: (object/get (array/nth @entity.organelles 0) role), tourComplete: false })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.organelles (if @config.plantMode (array/concat @config.plantOrganelles @config.coreOrganelles) @config.coreOrganelles))
        (set @entity.edges (if @config.plantMode (array/concat @config.plantEdges @config.coreEdges) @config.coreEdges))
        (set @entity.selectedIndex 0)
        (set @entity.selectedId (object/get (array/nth @entity.organelles 0) id))
        (set @entity.visitedIds [(object/get (array/nth @entity.organelles 0) id)])
        (set @entity.tourComplete false)
        (set @entity.narration (str/concat (object/get (array/nth @entity.organelles 0) label) " — " (object/get (array/nth @entity.organelles 0) role)))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV, label: "Prev", variant: secondary },
                    { type: button, action: NEXT, label: "Next", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor,
                  nodes: (array/map @entity.organelles (fn n { id: (object/get @n id), x: (object/get @n x), y: (object/get @n y), radius: (if (== (object/get @n id) @entity.selectedId) (* (object/get @n radius) 1.4) (object/get @n radius)), color: (object/get @n color), label: (object/get @n label), kind: (object/get @n kind) })),
                  edges: @entity.edges,
                  shapes: [ { type: circle, x: (object/get (array/nth @entity.organelles @entity.selectedIndex) x), y: (object/get (array/nth @entity.organelles @entity.selectedIndex) y), radius: (+ (object/get (array/nth @entity.organelles @entity.selectedIndex) radius) 10), color: "#f59e0b", lineWidth: 4 } ]
                },
                { type: typography, variant: body, content: @entity.narration },
                { type: typography, variant: caption, content: (str/concat "Explored " (str/concat "" (array/len @entity.visitedIds)) " of " (str/concat "" (array/len @entity.organelles)) (if @entity.tourComplete " — tour complete!" "")) }
              ] }
          ]
        })
        (emit CELL_SELECTED { id: @entity.selectedId, label: (object/get (array/nth @entity.organelles 0) label), role: (object/get (array/nth @entity.organelles 0) role), tourComplete: false })

      NEXT -> idle when (== @entity.active true)
        (set @entity.selectedIndex (math/mod (+ @entity.selectedIndex 1) (array/len @entity.organelles)))
        (set @entity.selectedId (object/get (array/nth @entity.organelles @entity.selectedIndex) id))
        (set @entity.visitedIds (if (array/includes @entity.visitedIds @entity.selectedId) @entity.visitedIds (array/append @entity.visitedIds @entity.selectedId)))
        (set @entity.tourComplete (== (array/len @entity.visitedIds) (array/len @entity.organelles)))
        (set @entity.narration (str/concat (object/get (array/nth @entity.organelles @entity.selectedIndex) label) " — " (object/get (array/nth @entity.organelles @entity.selectedIndex) role)))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV, label: "Prev", variant: secondary },
                    { type: button, action: NEXT, label: "Next", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor,
                  nodes: (array/map @entity.organelles (fn n { id: (object/get @n id), x: (object/get @n x), y: (object/get @n y), radius: (if (== (object/get @n id) @entity.selectedId) (* (object/get @n radius) 1.4) (object/get @n radius)), color: (object/get @n color), label: (object/get @n label), kind: (object/get @n kind) })),
                  edges: @entity.edges,
                  shapes: [ { type: circle, x: (object/get (array/nth @entity.organelles @entity.selectedIndex) x), y: (object/get (array/nth @entity.organelles @entity.selectedIndex) y), radius: (+ (object/get (array/nth @entity.organelles @entity.selectedIndex) radius) 10), color: "#f59e0b", lineWidth: 4 } ]
                },
                { type: typography, variant: body, content: @entity.narration },
                { type: typography, variant: caption, content: (str/concat "Explored " (str/concat "" (array/len @entity.visitedIds)) " of " (str/concat "" (array/len @entity.organelles)) (if @entity.tourComplete " — tour complete!" "")) }
              ] }
          ]
        })
        (emit CELL_SELECTED { id: @entity.selectedId, label: (object/get (array/nth @entity.organelles @entity.selectedIndex) label), role: (object/get (array/nth @entity.organelles @entity.selectedIndex) role), tourComplete: @entity.tourComplete })

      PREV -> idle when (== @entity.active true)
        (set @entity.selectedIndex (if (== @entity.selectedIndex 0) (- (array/len @entity.organelles) 1) (- @entity.selectedIndex 1)))
        (set @entity.selectedId (object/get (array/nth @entity.organelles @entity.selectedIndex) id))
        (set @entity.visitedIds (if (array/includes @entity.visitedIds @entity.selectedId) @entity.visitedIds (array/append @entity.visitedIds @entity.selectedId)))
        (set @entity.tourComplete (== (array/len @entity.visitedIds) (array/len @entity.organelles)))
        (set @entity.narration (str/concat (object/get (array/nth @entity.organelles @entity.selectedIndex) label) " — " (object/get (array/nth @entity.organelles @entity.selectedIndex) role)))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV, label: "Prev", variant: secondary },
                    { type: button, action: NEXT, label: "Next", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor,
                  nodes: (array/map @entity.organelles (fn n { id: (object/get @n id), x: (object/get @n x), y: (object/get @n y), radius: (if (== (object/get @n id) @entity.selectedId) (* (object/get @n radius) 1.4) (object/get @n radius)), color: (object/get @n color), label: (object/get @n label), kind: (object/get @n kind) })),
                  edges: @entity.edges,
                  shapes: [ { type: circle, x: (object/get (array/nth @entity.organelles @entity.selectedIndex) x), y: (object/get (array/nth @entity.organelles @entity.selectedIndex) y), radius: (+ (object/get (array/nth @entity.organelles @entity.selectedIndex) radius) 10), color: "#f59e0b", lineWidth: 4 } ]
                },
                { type: typography, variant: body, content: @entity.narration },
                { type: typography, variant: caption, content: (str/concat "Explored " (str/concat "" (array/len @entity.visitedIds)) " of " (str/concat "" (array/len @entity.organelles)) (if @entity.tourComplete " — tour complete!" "")) }
              ] }
          ]
        })
        (emit CELL_SELECTED { id: @entity.selectedId, label: (object/get (array/nth @entity.organelles @entity.selectedIndex) label), role: (object/get (array/nth @entity.organelles @entity.selectedIndex) role), tourComplete: @entity.tourComplete })

      RESET -> idle when (== @entity.active true)
        (set @entity.selectedIndex 0)
        (set @entity.selectedId (object/get (array/nth @entity.organelles 0) id))
        (set @entity.visitedIds [(object/get (array/nth @entity.organelles 0) id)])
        (set @entity.tourComplete false)
        (set @entity.narration (str/concat (object/get (array/nth @entity.organelles 0) label) " — " (object/get (array/nth @entity.organelles 0) role)))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV, label: "Prev", variant: secondary },
                    { type: button, action: NEXT, label: "Next", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor,
                  nodes: (array/map @entity.organelles (fn n { id: (object/get @n id), x: (object/get @n x), y: (object/get @n y), radius: (if (== (object/get @n id) @entity.selectedId) (* (object/get @n radius) 1.4) (object/get @n radius)), color: (object/get @n color), label: (object/get @n label), kind: (object/get @n kind) })),
                  edges: @entity.edges,
                  shapes: [ { type: circle, x: (object/get (array/nth @entity.organelles @entity.selectedIndex) x), y: (object/get (array/nth @entity.organelles @entity.selectedIndex) y), radius: (+ (object/get (array/nth @entity.organelles @entity.selectedIndex) radius) 10), color: "#f59e0b", lineWidth: 4 } ]
                },
                { type: typography, variant: body, content: @entity.narration },
                { type: typography, variant: caption, content: (str/concat "Explored " (str/concat "" (array/len @entity.visitedIds)) " of " (str/concat "" (array/len @entity.organelles)) (if @entity.tourComplete " — tour complete!" "")) }
              ] }
          ]
        })
        (emit CELL_SELECTED { id: @entity.selectedId, label: (object/get (array/nth @entity.organelles 0) label), role: (object/get (array/nth @entity.organelles 0) role), tourComplete: false })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
    }

    emits {
      CELL_SELECTED -> external {
        id : string
        label : string
        role : string
        tourComplete : boolean
      }
        @description "Fires on INIT/MODE_SELECTED/Prev/Next/Reset with the currently selected organelle's id, label, and function text, plus whether every organelle has now been visited — a composed listener (readout, quiz) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "select, choose, organelle, explore, tour, pick"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Cell Structure Explorer"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      plantMode : boolean = false
        @label "Plant Mode"
        @description "When true, adds the chloroplast, cell wall, and central vacuole to the tour alongside the shared animal/plant organelles."
        @synonyms "plant cell, chloroplast, cell wall, vacuole"
        @tier "domain"
      coreOrganelles : [CellOrganelle] = [
        { id: "membrane", x: 300, y: 200, radius: 160, color: "#475569", label: "Cell Membrane", kind: cell, role: "Selectively permeable barrier that controls what enters and exits the cell." },
        { id: "cytoplasm", x: 240, y: 195, radius: 10, color: "#7dd3fc", label: "Cytoplasm", kind: organelle, role: "Gel-like fluid filling the cell where organelles are suspended and metabolic reactions occur." },
        { id: "nucleus", x: 320, y: 180, radius: 46, color: "#2563eb", label: "Nucleus", kind: cell, role: "Houses the cell's DNA and directs protein synthesis and cell division." },
        { id: "mitochondrion", x: 185, y: 145, radius: 20, color: "#dc2626", label: "Mitochondrion", kind: organelle, role: "The powerhouse of the cell — converts nutrients into ATP through cellular respiration." },
        { id: "ribosomes", x: 425, y: 145, radius: 9, color: "#f59e0b", label: "Ribosomes", kind: organelle, role: "Read messenger RNA and assemble amino acids into proteins." },
        { id: "roughER", x: 190, y: 265, radius: 26, color: "#7c3aed", label: "Rough ER", kind: organelle, role: "Ribosome-studded membrane network that folds and processes proteins destined for export." },
        { id: "smoothER", x: 410, y: 265, radius: 22, color: "#a855f7", label: "Smooth ER", kind: organelle, role: "Synthesizes lipids and detoxifies harmful compounds; lacks ribosomes." },
        { id: "golgi", x: 320, y: 318, radius: 17, color: "#0891b2", label: "Golgi Apparatus", kind: organelle, role: "Packages, modifies, and ships proteins and lipids to their destinations." },
        { id: "lysosome", x: 445, y: 205, radius: 11, color: "#eab308", label: "Lysosome", kind: organelle, role: "Contains digestive enzymes that break down waste, debris, and worn-out organelles." }
      ]
        @label "Core Organelles"
        @description "The shared animal/plant organelle roster the tour steps through: membrane, cytoplasm, nucleus, mitochondrion, ribosomes, rough ER, smooth ER, Golgi apparatus, lysosome."
        @tier "domain"
      plantOrganelles : [CellOrganelle] = [
        { id: "cellWall", x: 300, y: 200, radius: 178, color: "#15803d", label: "Cell Wall", kind: cell, role: "Rigid outer layer found in plant cells that provides structural support and protection." },
        { id: "chloroplast", x: 300, y: 338, radius: 15, color: "#16a34a", label: "Chloroplast", kind: organelle, role: "Captures light energy and converts it into sugars through photosynthesis." },
        { id: "vacuole", x: 250, y: 230, radius: 28, color: "#0e7490", label: "Central Vacuole", kind: organelle, role: "Large fluid-filled sac that maintains turgor pressure and stores water, nutrients, and waste." }
      ]
        @label "Plant Organelles"
        @description "Appended to the tour when plantMode is true: cell wall, chloroplast, central vacuole."
        @tier "domain"
      coreEdges : [BioEdge] = [
        { from: "mitochondrion", to: "nucleus", color: "#e2e8f0", label: "" },
        { from: "ribosomes", to: "nucleus", color: "#e2e8f0", label: "" },
        { from: "roughER", to: "nucleus", color: "#e2e8f0", label: "" },
        { from: "smoothER", to: "nucleus", color: "#e2e8f0", label: "" },
        { from: "golgi", to: "nucleus", color: "#e2e8f0", label: "" },
        { from: "lysosome", to: "nucleus", color: "#e2e8f0", label: "" }
      ]
        @label "Core Edges"
        @description "Faint tethers linking each core organelle to the nucleus."
        @tier "presentation"
      plantEdges : [BioEdge] = [
        { from: "chloroplast", to: "nucleus", color: "#e2e8f0", label: "" },
        { from: "vacuole", to: "nucleus", color: "#e2e8f0", label: "" }
      ]
        @label "Plant Edges"
        @description "Faint tethers linking the plant-only organelles to the nucleus."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f0fdf4"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
    }
  }

  page "/bio-cell" as BioCellEnginePage -> BioCellSim
}
