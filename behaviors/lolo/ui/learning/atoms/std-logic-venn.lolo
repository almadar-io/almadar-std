app std-logic-venn "1.0.0"
"Syllogism Venn tester — the learner shades regions and drops ✕ marks on a three-circle diagram for each premise of a categorical syllogism (All M are P, Some S are M), then tests whether the shaded diagram makes the conclusion valid. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LogicVennOrbital {
  type LogicVennCircle = {
    id : string!
    x : number!
    y : number!
    radius : number!
    color : string
  }
  type LogicVennRegion = {
    id : string!
    label : string
    x : number!
    y : number!
  }
  type LogicVennTerm = {
    key : string!
    label : string!
  }
  type LogicVennSolution = {
    shaded : [string]
    marked : [string]
    valid : boolean
    note : string
  }

  entity LogicVennState [runtime] {
    id : string!
    active : boolean = false
    title : string
    shadedRegions : [string]
    markedRegions : [string]
    verdict : string
    shapes : [json]
  }

  trait LogicVennSim -> @rebindable LogicVennState [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.shadedRegions [])
        (set @entity.markedRegions [])
        (set @entity.verdict "")
        (let (
            (circleShapes (array/flatten (array/map @config.circles (fn c [
                { type: circle, id: (object/get @c id), x: (object/get @c x), y: (object/get @c y), radius: (object/get @c radius), color: (object/get @c color), fill: "transparent", lineWidth: 2, opacity: 1 },
                { type: text, id: (str/concat "label-" (object/get @c id)), x: (object/get @c x), y: (- (object/get @c y) (+ (object/get @c radius) 12)), text: (object/get (array/find @config.propositionLabels (fn t (== (object/get @t key) (object/get @c id)))) label), fontSize: 15, align: "center", color: (object/get @c color) }
              ]))))
            (regionShapes (array/map @config.regions (fn r
              { type: circle, id: (object/get @r id), x: (object/get @r x), y: (object/get @r y), radius: 7, color: "#94a3b8", fill: "transparent", lineWidth: 1, opacity: 0.7 })))
          )
          (do
            (set @entity.shapes (array/concat @circleShapes @regionShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat "Premises: " (str/join @config.premiseTypes ". ")) },
                { type: typography, variant: caption, content: (str/concat "Mood " @config.mood " · Figure " @config.figure) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: SHADE_REGION, actionPayload: { region: (object/get @r id) }, label: (str/concat "Shade " (object/get @r label)), variant: (if (array/includes @entity.shadedRegions (object/get @r id)) "primary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: MARK_X, actionPayload: { region: (object/get @r id) }, label: (str/concat "✕ " (object/get @r label)), variant: (if (array/includes @entity.markedRegions (object/get @r id)) "secondary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TEST_VALIDITY, label: "Test Validity", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: learning-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: typography, variant: caption, content: @entity.verdict }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.shadedRegions [])
        (set @entity.markedRegions [])
        (set @entity.verdict "")
        (let (
            (circleShapes (array/flatten (array/map @config.circles (fn c [
                { type: circle, id: (object/get @c id), x: (object/get @c x), y: (object/get @c y), radius: (object/get @c radius), color: (object/get @c color), fill: "transparent", lineWidth: 2, opacity: 1 },
                { type: text, id: (str/concat "label-" (object/get @c id)), x: (object/get @c x), y: (- (object/get @c y) (+ (object/get @c radius) 12)), text: (object/get (array/find @config.propositionLabels (fn t (== (object/get @t key) (object/get @c id)))) label), fontSize: 15, align: "center", color: (object/get @c color) }
              ]))))
            (regionShapes (array/map @config.regions (fn r
              { type: circle, id: (object/get @r id), x: (object/get @r x), y: (object/get @r y), radius: 7, color: "#94a3b8", fill: "transparent", lineWidth: 1, opacity: 0.7 })))
          )
          (do
            (set @entity.shapes (array/concat @circleShapes @regionShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat "Premises: " (str/join @config.premiseTypes ". ")) },
                { type: typography, variant: caption, content: (str/concat "Mood " @config.mood " · Figure " @config.figure) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: SHADE_REGION, actionPayload: { region: (object/get @r id) }, label: (str/concat "Shade " (object/get @r label)), variant: (if (array/includes @entity.shadedRegions (object/get @r id)) "primary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: MARK_X, actionPayload: { region: (object/get @r id) }, label: (str/concat "✕ " (object/get @r label)), variant: (if (array/includes @entity.markedRegions (object/get @r id)) "secondary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TEST_VALIDITY, label: "Test Validity", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: learning-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: typography, variant: caption, content: @entity.verdict }
              ] }
          ]
        })

      SHADE_REGION -> idle when (== @entity.active true)
        (set @entity.shadedRegions (if (array/includes @entity.shadedRegions ?region) (array/filter @entity.shadedRegions (fn r (!= @r ?region))) (array/append @entity.shadedRegions ?region)))
        (set @entity.verdict "")
        (let (
            (circleShapes (array/flatten (array/map @config.circles (fn c [
                { type: circle, id: (object/get @c id), x: (object/get @c x), y: (object/get @c y), radius: (object/get @c radius), color: (object/get @c color), fill: "transparent", lineWidth: 2, opacity: 1 },
                { type: text, id: (str/concat "label-" (object/get @c id)), x: (object/get @c x), y: (- (object/get @c y) (+ (object/get @c radius) 12)), text: (object/get (array/find @config.propositionLabels (fn t (== (object/get @t key) (object/get @c id)))) label), fontSize: 15, align: "center", color: (object/get @c color) }
              ]))))
            (regionShapes (array/map @config.regions (fn r
              (if (array/includes @entity.shadedRegions (object/get @r id))
                { type: rect, id: (object/get @r id), x: (- (object/get @r x) 10), y: (- (object/get @r y) 10), width: 20, height: 20, color: @config.shadedColor, fill: @config.shadedColor, opacity: 0.9 }
                { type: circle, id: (object/get @r id), x: (object/get @r x), y: (object/get @r y), radius: 7, color: "#94a3b8", fill: "transparent", lineWidth: 1, opacity: 0.7 }))))
            (markShapes (array/map (array/filter @config.regions (fn r (array/includes @entity.markedRegions (object/get @r id)))) (fn r
              { type: text, id: (str/concat "x-" (object/get @r id)), x: (object/get @r x), y: (+ (object/get @r y) 5), text: "✕", fontSize: 16, align: "center", color: "#b91c1c" })))
          )
          (do
            (set @entity.shapes (array/concat (array/concat @circleShapes @regionShapes) @markShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat "Premises: " (str/join @config.premiseTypes ". ")) },
                { type: typography, variant: caption, content: (str/concat "Mood " @config.mood " · Figure " @config.figure) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: SHADE_REGION, actionPayload: { region: (object/get @r id) }, label: (str/concat "Shade " (object/get @r label)), variant: (if (array/includes @entity.shadedRegions (object/get @r id)) "primary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: MARK_X, actionPayload: { region: (object/get @r id) }, label: (str/concat "✕ " (object/get @r label)), variant: (if (array/includes @entity.markedRegions (object/get @r id)) "secondary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TEST_VALIDITY, label: "Test Validity", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: learning-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: typography, variant: caption, content: @entity.verdict }
              ] }
          ]
        })
        (emit VENN_UPDATED { shadedRegions: @entity.shadedRegions, markedRegions: @entity.markedRegions, verdict: @entity.verdict })

      MARK_X -> idle when (== @entity.active true)
        (set @entity.markedRegions (if (array/includes @entity.markedRegions ?region) (array/filter @entity.markedRegions (fn r (!= @r ?region))) (array/append @entity.markedRegions ?region)))
        (set @entity.verdict "")
        (let (
            (circleShapes (array/flatten (array/map @config.circles (fn c [
                { type: circle, id: (object/get @c id), x: (object/get @c x), y: (object/get @c y), radius: (object/get @c radius), color: (object/get @c color), fill: "transparent", lineWidth: 2, opacity: 1 },
                { type: text, id: (str/concat "label-" (object/get @c id)), x: (object/get @c x), y: (- (object/get @c y) (+ (object/get @c radius) 12)), text: (object/get (array/find @config.propositionLabels (fn t (== (object/get @t key) (object/get @c id)))) label), fontSize: 15, align: "center", color: (object/get @c color) }
              ]))))
            (regionShapes (array/map @config.regions (fn r
              (if (array/includes @entity.shadedRegions (object/get @r id))
                { type: rect, id: (object/get @r id), x: (- (object/get @r x) 10), y: (- (object/get @r y) 10), width: 20, height: 20, color: @config.shadedColor, fill: @config.shadedColor, opacity: 0.9 }
                { type: circle, id: (object/get @r id), x: (object/get @r x), y: (object/get @r y), radius: 7, color: "#94a3b8", fill: "transparent", lineWidth: 1, opacity: 0.7 }))))
            (markShapes (array/map (array/filter @config.regions (fn r (array/includes @entity.markedRegions (object/get @r id)))) (fn r
              { type: text, id: (str/concat "x-" (object/get @r id)), x: (object/get @r x), y: (+ (object/get @r y) 5), text: "✕", fontSize: 16, align: "center", color: "#b91c1c" })))
          )
          (do
            (set @entity.shapes (array/concat (array/concat @circleShapes @regionShapes) @markShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat "Premises: " (str/join @config.premiseTypes ". ")) },
                { type: typography, variant: caption, content: (str/concat "Mood " @config.mood " · Figure " @config.figure) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: SHADE_REGION, actionPayload: { region: (object/get @r id) }, label: (str/concat "Shade " (object/get @r label)), variant: (if (array/includes @entity.shadedRegions (object/get @r id)) "primary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: MARK_X, actionPayload: { region: (object/get @r id) }, label: (str/concat "✕ " (object/get @r label)), variant: (if (array/includes @entity.markedRegions (object/get @r id)) "secondary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TEST_VALIDITY, label: "Test Validity", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: learning-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: typography, variant: caption, content: @entity.verdict }
              ] }
          ]
        })
        (emit VENN_UPDATED { shadedRegions: @entity.shadedRegions, markedRegions: @entity.markedRegions, verdict: @entity.verdict })

      TEST_VALIDITY -> idle when (== @entity.active true)
        (let (
            (solShaded (object/get @config.solution shaded))
            (solMarked (object/get @config.solution marked))
            (shadedOk (and (== (array/len (array/filter @solShaded (fn r (not (array/includes @entity.shadedRegions @r))))) 0) (== (array/len (array/filter @entity.shadedRegions (fn r (not (array/includes @solShaded @r))))) 0)))
            (markedOk (and (== (array/len (array/filter @solMarked (fn r (not (array/includes @entity.markedRegions @r))))) 0) (== (array/len (array/filter @entity.markedRegions (fn r (not (array/includes @solMarked @r))))) 0)))
            (ok (and @shadedOk (or @markedOk (not @config.strictBoolean))))
          )
          (do
            (set @entity.verdict (if @ok
              (str/concat (if (object/get @config.solution valid) "Correct — the diagram shows the syllogism is valid. " "Correct — the diagram shows the syllogism is invalid. ") (if @config.showSolution (object/get @config.solution note) ""))
              "Not yet — re-check the shading and ✕ marks each premise requires."))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat "Premises: " (str/join @config.premiseTypes ". ")) },
                { type: typography, variant: caption, content: (str/concat "Mood " @config.mood " · Figure " @config.figure) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: SHADE_REGION, actionPayload: { region: (object/get @r id) }, label: (str/concat "Shade " (object/get @r label)), variant: (if (array/includes @entity.shadedRegions (object/get @r id)) "primary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: MARK_X, actionPayload: { region: (object/get @r id) }, label: (str/concat "✕ " (object/get @r label)), variant: (if (array/includes @entity.markedRegions (object/get @r id)) "secondary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TEST_VALIDITY, label: "Test Validity", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: learning-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: typography, variant: caption, content: @entity.verdict }
              ] }
          ]
        })
        (emit VENN_UPDATED { shadedRegions: @entity.shadedRegions, markedRegions: @entity.markedRegions, verdict: @entity.verdict })

      RESET -> idle when (== @entity.active true)
        (set @entity.shadedRegions [])
        (set @entity.markedRegions [])
        (set @entity.verdict "")
        (let (
            (circleShapes (array/flatten (array/map @config.circles (fn c [
                { type: circle, id: (object/get @c id), x: (object/get @c x), y: (object/get @c y), radius: (object/get @c radius), color: (object/get @c color), fill: "transparent", lineWidth: 2, opacity: 1 },
                { type: text, id: (str/concat "label-" (object/get @c id)), x: (object/get @c x), y: (- (object/get @c y) (+ (object/get @c radius) 12)), text: (object/get (array/find @config.propositionLabels (fn t (== (object/get @t key) (object/get @c id)))) label), fontSize: 15, align: "center", color: (object/get @c color) }
              ]))))
            (regionShapes (array/map @config.regions (fn r
              { type: circle, id: (object/get @r id), x: (object/get @r x), y: (object/get @r y), radius: 7, color: "#94a3b8", fill: "transparent", lineWidth: 1, opacity: 0.7 })))
          )
          (do
            (set @entity.shapes (array/concat @circleShapes @regionShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat "Premises: " (str/join @config.premiseTypes ". ")) },
                { type: typography, variant: caption, content: (str/concat "Mood " @config.mood " · Figure " @config.figure) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: SHADE_REGION, actionPayload: { region: (object/get @r id) }, label: (str/concat "Shade " (object/get @r label)), variant: (if (array/includes @entity.shadedRegions (object/get @r id)) "primary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.regions (fn r { type: button, action: MARK_X, actionPayload: { region: (object/get @r id) }, label: (str/concat "✕ " (object/get @r label)), variant: (if (array/includes @entity.markedRegions (object/get @r id)) "secondary" "ghost"), size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TEST_VALIDITY, label: "Test Validity", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: learning-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: typography, variant: caption, content: @entity.verdict }
              ] }
          ]
        })
        (emit VENN_UPDATED { shadedRegions: @entity.shadedRegions, markedRegions: @entity.markedRegions, verdict: @entity.verdict })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SHADE_REGION {
        region : string
      }
        @description "Learner toggled shading on one region of the three-circle diagram (universal-premise step of the Venn test)."
        @tier "domain"
      MARK_X {
        region : string
      }
        @description "Learner toggled an ✕ mark on one region of the diagram (particular-premise step of the Venn test)."
        @tier "domain"
      TEST_VALIDITY {
      }
        @description "Learner asked whether the shaded and marked diagram makes the conclusion follow — the Venn validity test."
        @tier "domain"
      RESET {
      }
        @description "Learner cleared all shading and ✕ marks to start the diagram over."
        @tier "domain"
    }

    emits {
      VENN_UPDATED -> external {
        shadedRegions : [string]
        markedRegions : [string]
        verdict : string
      }
        @description "The diagram state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "venn update, syllogism test, region shaded, existential mark, validity check"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      mood : string = "AII"
        @label "Mood"
        @description "The syllogism's mood — the three-letter sequence of proposition types (A/E/I/O) for premise 1, premise 2, conclusion."
        @synonyms "syllogism mood, proposition types, categorical syllogism, A E I O"
        @tier "domain"
      figure : number = 1
        @label "Figure"
        @description "The syllogism's figure (1-4) — the placement of the middle term in the premises."
        @synonyms "syllogism figure, middle term, syllogistic form"
        @tier "domain"
      premiseTypes : [string] = ["All M are P", "Some S are M"]
        @label "Premises"
        @description "The two premise propositions in categorical form, displayed above the diagram; the learner shades and marks regions for each."
        @synonyms "premise, universal affirmative, particular affirmative, all are, some are, categorical proposition"
        @tier "domain"
      propositionLabels : [LogicVennTerm] = [
        { key: "S", label: "S" },
        { key: "M", label: "M" },
        { key: "P", label: "P" }
      ]
        @label "Term Labels"
        @description "Display label for each term (subject S, middle M, predicate P); keys must match the circle ids."
        @synonyms "subject term, middle term, predicate term, minor term, major term"
        @tier "domain"
      circles : [LogicVennCircle] = [
        { id: "S", x: 240, y: 170, radius: 105, color: "#2563eb" },
        { id: "M", x: 360, y: 170, radius: 105, color: "#15803d" },
        { id: "P", x: 300, y: 275, radius: 105, color: "#b45309" }
      ]
        @label "Circles"
        @description "The three set circles (center, radius, color); ids match the term keys in propositionLabels."
        @tier "domain"
      regions : [LogicVennRegion] = [
        { id: "s-only", label: "S only", x: 175, y: 150 },
        { id: "m-only", label: "M only", x: 425, y: 150 },
        { id: "p-only", label: "P only", x: 300, y: 360 },
        { id: "sm-only", label: "S∩M only", x: 300, y: 140 },
        { id: "sp-only", label: "S∩P only", x: 245, y: 255 },
        { id: "mp-only", label: "M∩P only", x: 355, y: 255 },
        { id: "smp", label: "S∩M∩P", x: 300, y: 210 }
      ]
        @label "Regions"
        @description "The seven interior regions of the three-circle diagram (marker position and button label); the learner shades and marks these."
        @synonyms "venn region, intersection, overlap, lens, venn diagram"
        @tier "domain"
      solution : LogicVennSolution = { shaded: ["m-only", "sm-only"], marked: ["smp"], valid: true, note: "Shading all of M outside P and marking S∩M forces the ✕ into S∩M∩P — so some S are P." }
        @label "Solution"
        @description "The shading and ✕ marks the premises demand, whether the syllogism is valid, and an explanatory note revealed by Show Solution."
        @synonyms "answer key, correct diagram, validity verdict, venn test solution"
        @tier "domain"
      strictBoolean : boolean = true
        @label "Strict Boolean Standpoint"
        @description "Boolean standpoint: universal premises have no existential import, so the ✕ marks must match the solution exactly. When false (Aristotelian), only the shading must match."
        @synonyms "boolean standpoint, aristotelian standpoint, existential import"
        @tier "domain"
      showSolution : boolean = true
        @label "Show Solution"
        @description "Append the solution's explanatory note to the verdict after a correct Test Validity."
        @tier "domain"
      title : string = "Syllogism Venn Tester"
        @label "Title"
        @description "Title shown above the instrument."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 420
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
      shadedColor : string = "#64748b"
        @label "Shaded Region Color"
        @description "Fill color of a region the learner has shaded (claimed empty)."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
    }
  }

  page "/logic-venn" as LogicVennPage -> LogicVennSim
}
