app std-ling-soundchange "1.0.0"
"Historical sound-change stepper — the learner applies ordered Great Vowel Shift rules one at a time and watches every word whose vowel matches strike all at once, rendering the before/after pronunciation on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LingSoundchangeOrbital {
  type LingSoundchangeShapePoint = {
    x : number!
    y : number!
  }
  type LingSoundchangeShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LingSoundchangeShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type LingSoundchangeSoundWord = {
    id : string!
    orthography : string!
    template : string!
    vowel : string!
  }
  type LingSoundchangeRule = {
    name : string!
    from : string!
    to : string!
    explanation : string
  }

  entity LingSoundchangeScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    renderChildren : [json]
    shapes : [LingSoundchangeShape]
    ruleIndex : number
    changedSummary : string
    done : boolean
  }

  trait LingSoundchangeSim -> @rebindable LingSoundchangeScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.ruleIndex 0)
        (let (
            (wordCount (array/len @config.soundWords))
            (totalRules (array/len @config.rules))
            (soundRows (array/map (array/range @wordCount) (fn idx (let (
                    (w0 (array/nth @config.soundWords @idx))
                    (pronNow (str/replace (object/get @w0 template) "{V}" (object/get @w0 vowel)))
                  )
                  { id: (object/get @w0 id), orthography: (object/get @w0 orthography), vowel: (object/get @w0 vowel), pronNow: @pronNow, pronBefore: @pronNow, changed: false }
                ))))
            (soundShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (row (array/nth @soundRows @idx))
                    (rowY (+ @config.topMargin (* @idx @config.rowHeight)))
                  )
                  [
                    { type: "text", id: (str/concat "orth" @idx), x: @config.orthColumnX, y: @rowY, text: (object/get @row orthography), fontSize: @config.soundFontSize, align: "left", color: @config.orthographyColor },
                    { type: "text", id: (str/concat "cur" @idx), x: @config.pronColumnX, y: @rowY, text: (str/concat "/" (object/get @row pronNow) "/"), fontSize: @config.soundFontSize, align: "left", color: @config.pronunciationColor }
                  ]
                )))))
            (nextRuleName (if (> @totalRules 0) (object/get (array/nth @config.rules 0) name) ""))
            (isDone (<= @totalRules 0))
          )
          (do
            (set @entity.shapes @soundShapes)
            (set @entity.changedSummary "none")
            (set @entity.done @isDone)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: caption, content: (str/concat "Next rule: " @nextRuleName) },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: APPLY_CHANGE, label: "Apply Rule", variant: primary, disabled: (if (<= @totalRules 0) true false) },
                  { type: button, action: RESET_CHANGES, label: "Reset Changes", variant: ghost }
                ] },
              { type: typography, variant: body, content: "No rules applied yet — press Apply Rule to begin the Great Vowel Shift." }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.ruleIndex 0)
        (let (
            (wordCount (array/len @config.soundWords))
            (totalRules (array/len @config.rules))
            (soundRows (array/map (array/range @wordCount) (fn idx (let (
                    (w0 (array/nth @config.soundWords @idx))
                    (pronNow (str/replace (object/get @w0 template) "{V}" (object/get @w0 vowel)))
                  )
                  { id: (object/get @w0 id), orthography: (object/get @w0 orthography), vowel: (object/get @w0 vowel), pronNow: @pronNow, pronBefore: @pronNow, changed: false }
                ))))
            (soundShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (row (array/nth @soundRows @idx))
                    (rowY (+ @config.topMargin (* @idx @config.rowHeight)))
                  )
                  [
                    { type: "text", id: (str/concat "orth" @idx), x: @config.orthColumnX, y: @rowY, text: (object/get @row orthography), fontSize: @config.soundFontSize, align: "left", color: @config.orthographyColor },
                    { type: "text", id: (str/concat "cur" @idx), x: @config.pronColumnX, y: @rowY, text: (str/concat "/" (object/get @row pronNow) "/"), fontSize: @config.soundFontSize, align: "left", color: @config.pronunciationColor }
                  ]
                )))))
            (nextRuleName (if (> @totalRules 0) (object/get (array/nth @config.rules 0) name) ""))
            (isDone (<= @totalRules 0))
          )
          (do
            (set @entity.shapes @soundShapes)
            (set @entity.changedSummary "none")
            (set @entity.done @isDone)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: caption, content: (str/concat "Next rule: " @nextRuleName) },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: APPLY_CHANGE, label: "Apply Rule", variant: primary, disabled: (if (<= @totalRules 0) true false) },
                  { type: button, action: RESET_CHANGES, label: "Reset Changes", variant: ghost }
                ] },
              { type: typography, variant: body, content: "No rules applied yet — press Apply Rule to begin the Great Vowel Shift." }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      APPLY_CHANGE -> idle when (== @entity.active true)
        (let (
            (totalRules (array/len @config.rules))
            (nextRuleIndex (math/min (+ @entity.ruleIndex 1) @totalRules))
            (appliedRules (array/take @config.rules @nextRuleIndex))
            (priorRules (array/take @config.rules @entity.ruleIndex))
            (wordCount (array/len @config.soundWords))
            (wordsNow (array/map @config.soundWords (fn w (array/reduce @appliedRules @w (fn acc r (if (== (object/get @acc vowel) (object/get @r from)) (object/merge @acc { vowel: (object/get @r to) }) @acc))))))
            (wordsBefore (array/map @config.soundWords (fn w (array/reduce @priorRules @w (fn acc r (if (== (object/get @acc vowel) (object/get @r from)) (object/merge @acc { vowel: (object/get @r to) }) @acc))))))
            (lastRule (array/nth @config.rules @entity.ruleIndex))
            (soundRows (array/map (array/range @wordCount) (fn idx (let (
                    (w0 (array/nth @config.soundWords @idx))
                    (wNow (array/nth @wordsNow @idx))
                    (wBefore (array/nth @wordsBefore @idx))
                    (pronNow (str/replace (object/get @w0 template) "{V}" (object/get @wNow vowel)))
                    (pronBefore (str/replace (object/get @w0 template) "{V}" (object/get @wBefore vowel)))
                  )
                  { id: (object/get @w0 id), orthography: (object/get @w0 orthography), vowel: (object/get @wNow vowel), pronNow: @pronNow, pronBefore: @pronBefore, changed: (!= (object/get @wNow vowel) (object/get @wBefore vowel)) }
                ))))
            (changedRows (array/filter @soundRows (fn r (object/get @r changed))))
            (unaffectedRows (array/filter @soundRows (fn r (not (object/get @r changed)))))
            (changedStr (if (== (array/len @changedRows) 0) "none" (str/join (array/map @changedRows (fn r (str/concat (object/get @r orthography) " (" (object/get @r pronBefore) "→" (object/get @r pronNow) ")"))) ", ")))
            (unaffectedStr (if (== (array/len @unaffectedRows) 0) "none" (str/join (array/map @unaffectedRows (fn r (str/concat (object/get @r orthography) " (vowel " (object/get @r vowel) " ≠ " (object/get @lastRule from) ")"))) ", ")))
            (readout (str/concat "Applied " (object/get @lastRule name) ". Changed: " @changedStr ". Unaffected: " @unaffectedStr "."))
            (isDone (>= @nextRuleIndex @totalRules))
            (nextRuleName (if @isDone "All rules applied." (str/concat "Next rule: " (object/get (array/nth @config.rules @nextRuleIndex) name))))
            (soundShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (row (array/nth @soundRows @idx))
                    (rowY (+ @config.topMargin (* @idx @config.rowHeight)))
                    (changed (object/get @row changed))
                  )
                  (if @changed
                    [
                      { type: "text", id: (str/concat "orth" @idx), x: @config.orthColumnX, y: @rowY, text: (object/get @row orthography), fontSize: @config.soundFontSize, align: "left", color: @config.orthographyColor },
                      { type: "text", id: (str/concat "old" @idx), x: @config.pronColumnX, y: @rowY, text: (str/concat "/" (object/get @row pronBefore) "/"), fontSize: @config.soundFontSize, align: "left", color: @config.pronunciationColor },
                      { type: "arrow", id: (str/concat "arr" @idx), x1: @config.arrowX1, y1: @rowY, x2: @config.arrowX2, y2: @rowY, color: @config.arrowColor, lineWidth: 2 },
                      { type: "text", id: (str/concat "new" @idx), x: @config.newPronColumnX, y: @rowY, text: (str/concat "/" (object/get @row pronNow) "/"), fontSize: @config.soundFontSize, align: "left", color: @config.changedPronunciationColor }
                    ]
                    [
                      { type: "text", id: (str/concat "orth" @idx), x: @config.orthColumnX, y: @rowY, text: (object/get @row orthography), fontSize: @config.soundFontSize, align: "left", color: @config.orthographyColor },
                      { type: "text", id: (str/concat "cur" @idx), x: @config.pronColumnX, y: @rowY, text: (str/concat "/" (object/get @row pronNow) "/"), fontSize: @config.soundFontSize, align: "left", color: @config.pronunciationColor }
                    ])
                )))))
          )
          (do
            (set @entity.ruleIndex @nextRuleIndex)
            (set @entity.shapes @soundShapes)
            (set @entity.changedSummary @changedStr)
            (set @entity.done @isDone)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: caption, content: @nextRuleName },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: APPLY_CHANGE, label: "Apply Rule", variant: primary, disabled: (if @isDone true false) },
                  { type: button, action: RESET_CHANGES, label: "Reset Changes", variant: ghost }
                ] },
              { type: typography, variant: body, content: @readout }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit SOUNDCHANGE_UPDATED { ruleIndex: @entity.ruleIndex, totalRules: (array/len @config.rules), changed: @entity.changedSummary, done: @entity.done })

      RESET_CHANGES -> idle when (== @entity.active true)
        (set @entity.ruleIndex 0)
        (let (
            (totalRules (array/len @config.rules))
            (wordCount (array/len @config.soundWords))
            (soundRows (array/map (array/range @wordCount) (fn idx (let (
                    (w0 (array/nth @config.soundWords @idx))
                    (pronNow (str/replace (object/get @w0 template) "{V}" (object/get @w0 vowel)))
                  )
                  { id: (object/get @w0 id), orthography: (object/get @w0 orthography), vowel: (object/get @w0 vowel), pronNow: @pronNow, pronBefore: @pronNow, changed: false }
                ))))
            (soundShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (row (array/nth @soundRows @idx))
                    (rowY (+ @config.topMargin (* @idx @config.rowHeight)))
                  )
                  [
                    { type: "text", id: (str/concat "orth" @idx), x: @config.orthColumnX, y: @rowY, text: (object/get @row orthography), fontSize: @config.soundFontSize, align: "left", color: @config.orthographyColor },
                    { type: "text", id: (str/concat "cur" @idx), x: @config.pronColumnX, y: @rowY, text: (str/concat "/" (object/get @row pronNow) "/"), fontSize: @config.soundFontSize, align: "left", color: @config.pronunciationColor }
                  ]
                )))))
            (nextRuleName (if (> @totalRules 0) (str/concat "Next rule: " (object/get (array/nth @config.rules 0) name)) "All rules applied."))
            (isDone (<= @totalRules 0))
          )
          (do
            (set @entity.shapes @soundShapes)
            (set @entity.changedSummary "none")
            (set @entity.done @isDone)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Apply each sound-change rule in order — it strikes every word whose vowel matches, all at once." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: caption, content: @nextRuleName },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: APPLY_CHANGE, label: "Apply Rule", variant: primary, disabled: (if (<= @totalRules 0) true false) },
                  { type: button, action: RESET_CHANGES, label: "Reset Changes", variant: ghost }
                ] },
              { type: typography, variant: body, content: "No rules applied yet — press Apply Rule to begin the Great Vowel Shift." }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit SOUNDCHANGE_UPDATED { ruleIndex: @entity.ruleIndex, totalRules: (array/len @config.rules), changed: @entity.changedSummary, done: @entity.done })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      APPLY_CHANGE {
      }
        @description "Learner applied the next ordered sound-change rule, striking every word whose current vowel matches it."
        @tier "domain"
      RESET_CHANGES {
      }
        @description "Learner reset all words back to their original vowels, undoing every applied rule."
        @tier "domain"
    }

    emits {
      SOUNDCHANGE_UPDATED -> external {
        ruleIndex : number
        totalRules : number
        changed : string
        done : boolean
      }
        @description "The sound-change state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "sound change update, rule applied, vowel shift progress, Great Vowel Shift step"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Sound Change Stepper"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 420
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      soundWords : [LingSoundchangeSoundWord] = [
        { id: "w1", orthography: "bite", template: "b{V}t", vowel: "iː" },
        { id: "w2", orthography: "time", template: "t{V}m", vowel: "iː" },
        { id: "w3", orthography: "mouse", template: "m{V}s", vowel: "uː" },
        { id: "w4", orthography: "house", template: "h{V}s", vowel: "uː" },
        { id: "w5", orthography: "goose", template: "g{V}s", vowel: "oː" },
        { id: "w6", orthography: "feet", template: "f{V}t", vowel: "eː" }
      ]
        @label "Sound-change Words"
        @description "Roster of Middle English words stepped through the sound-change rules. Each word carries its modern spelling (orthography), a pronunciation template with a {V} slot, and its starting long-vowel symbol; the template is substituted with the word's current vowel via str/replace to render its live pronunciation."
        @synonyms "vowel roster, word list, pronunciation template, Middle English word"
        @tier "domain"
      rules : [LingSoundchangeRule] = [
        { name: "Great Vowel Shift — /iː/ diphthongizes", from: "iː", to: "aɪ", explanation: "Middle English long high front vowel /iː/ diphthongizes to /aɪ/, as in modern \"bite\" and \"time\"." },
        { name: "Great Vowel Shift — /uː/ diphthongizes", from: "uː", to: "aʊ", explanation: "Middle English long high back vowel /uː/ diphthongizes to /aʊ/, as in modern \"mouse\" and \"house\"." },
        { name: "Great Vowel Shift — /oː/ raises", from: "oː", to: "uː", explanation: "Middle English long mid back vowel /oː/ raises to /uː/, as in modern \"goose\"." }
      ]
        @label "Sound-change Rules"
        @description "Ordered roster of sound-change rules applied one at a time. Each Apply Rule press applies the NEXT rule in this order to every word whose current vowel equals its \"from\" value, replacing it with \"to\" — demonstrating that sound change is regular (it strikes every matching word, not just some)."
        @synonyms "sound law, rule ordering, regular sound change, phonetic rule, vowel shift rule"
        @tier "domain"
      topMargin : number = 40
        @label "Top Margin (px)"
        @description "Vertical offset of the first word row from the top of the canvas, in pixels."
        @tier "presentation"
      rowHeight : number = 56
        @label "Row Height (px)"
        @description "Vertical distance between successive word rows, in pixels."
        @tier "presentation"
      orthColumnX : number = 40
        @label "Spelling Column X (px)"
        @description "Horizontal position of the orthographic spelling column."
        @tier "presentation"
      pronColumnX : number = 200
        @label "Pronunciation Column X (px)"
        @description "Horizontal position of the current (or pre-change) pronunciation column."
        @tier "presentation"
      newPronColumnX : number = 400
        @label "Shifted Pronunciation Column X (px)"
        @description "Horizontal position of the post-change pronunciation column, shown only for words that just changed."
        @tier "presentation"
      arrowX1 : number = 270
        @label "Change Arrow Start X (px)"
        @description "Horizontal start of the old→new pronunciation arrow."
        @tier "presentation"
      arrowX2 : number = 390
        @label "Change Arrow End X (px)"
        @description "Horizontal end of the old→new pronunciation arrow."
        @tier "presentation"
      soundFontSize : number = 18
        @label "Sound-change Font Size"
        @tier "presentation"
      orthographyColor : string = "#0f172a"
        @label "Spelling Text Color"
        @tier "presentation"
      pronunciationColor : string = "#64748b"
        @label "Pronunciation Text Color"
        @tier "presentation"
      changedPronunciationColor : string = "#dc2626"
        @label "Shifted Pronunciation Color"
        @description "Highlight color for a word's pronunciation the step it just changed."
        @tier "presentation"
      arrowColor : string = "#f97316"
        @label "Change Arrow Color"
        @tier "presentation"
    }
  }

  page "/ling-soundchange" as LingSoundchangePage -> LingSoundchangeSim
}
