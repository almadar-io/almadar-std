app std-soc-conformity "1.0.0"
"Conformity engine — agents on a grid adopt the local majority opinion of their row-ordered neighborhood each step, except a deviance-rate share who deliberately break with it, so the population converges or fragments over repeated steps, on a biology-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital SocConfOrbital {
  type SocConfNode = {
    id : string!
    x : number!
    y : number!
    radius : number
    color : string
    label : string
  }

  entity SocConfScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    opinions : [number]
    devianceRate : number
    stepCount : number
    majorityPct : number
    nodes : [SocConfNode]
  }

  trait SocConfSim -> @rebindable SocConfScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.devianceRate @config.devianceRate)
        (set @entity.stepCount 0)
        (let (
            (n @config.agentCount)
            (opinionsInit (array/map (array/range @n) (fn i (if (== @i (math/floor (/ @n 2))) 1 0))))
            (gridCols @config.gridCols)
            (dx (/ (- @config.width (* 2 @config.gridMargin)) (- @gridCols 1)))
            (rowCount (+ (math/floor (/ (- @n 1) @gridCols)) 1))
            (dy (/ (- @config.height (* 2 @config.gridMargin)) (- @rowCount 1)))
            (renderNodes (array/map (array/range @n) (fn i
              { id: (str/concat "a" @i), x: (+ @config.gridMargin (* (math/mod @i @gridCols) @dx)), y: (+ @config.gridMargin (* (math/floor (/ @i @gridCols)) @dy)), radius: @config.agentRadius, color: (if (== (array/nth @opinionsInit @i) 1) @config.deviantColor @config.normColor), label: "" })))
          )
          (do
            (set @entity.opinions @opinionsInit)
            (set @entity.majorityPct (* 100 (/ (- @n 1) @n)))
            (set @entity.nodes @renderNodes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP, label: "Step", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Step " @entity.stepCount " — majority share: " (math/round @entity.majorityPct 1) "%") },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Deviance rate: " @entity.devianceRate " — each step, every agent adopts the local majority opinion, except this share who deliberately break with it.") },
                    { type: range-slider, min: 0, max: 0.5, step: 0.01, value: @entity.devianceRate, showTooltip: true, onChange: SET_DEVIANCE }
                  ] }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.devianceRate @config.devianceRate)
        (set @entity.stepCount 0)
        (let (
            (n @config.agentCount)
            (opinionsInit (array/map (array/range @n) (fn i (if (== @i (math/floor (/ @n 2))) 1 0))))
            (gridCols @config.gridCols)
            (dx (/ (- @config.width (* 2 @config.gridMargin)) (- @gridCols 1)))
            (rowCount (+ (math/floor (/ (- @n 1) @gridCols)) 1))
            (dy (/ (- @config.height (* 2 @config.gridMargin)) (- @rowCount 1)))
            (renderNodes (array/map (array/range @n) (fn i
              { id: (str/concat "a" @i), x: (+ @config.gridMargin (* (math/mod @i @gridCols) @dx)), y: (+ @config.gridMargin (* (math/floor (/ @i @gridCols)) @dy)), radius: @config.agentRadius, color: (if (== (array/nth @opinionsInit @i) 1) @config.deviantColor @config.normColor), label: "" })))
          )
          (do
            (set @entity.opinions @opinionsInit)
            (set @entity.majorityPct (* 100 (/ (- @n 1) @n)))
            (set @entity.nodes @renderNodes)
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: stack, direction: horizontal, gap: sm, children: [
                      { type: button, action: STEP, label: "Step", variant: primary },
                      { type: button, action: RESET, label: "Reset", variant: ghost }
                    ] },
                  { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                  { type: typography, variant: body, content: (str/concat "Step " @entity.stepCount " — majority share: " (math/round @entity.majorityPct 1) "%") },
                  { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: caption, content: (str/concat "Deviance rate: " @entity.devianceRate " — each step, every agent adopts the local majority opinion, except this share who deliberately break with it.") },
                      { type: range-slider, min: 0, max: 0.5, step: 0.01, value: @entity.devianceRate, showTooltip: true, onChange: SET_DEVIANCE }
                    ] }
                ] }
            ]
        })

      STEP -> idle when (== @entity.active true)
        (let (
            (n @config.agentCount)
            (k @config.neighborhoodSize)
            (newOpinions (array/map (array/range @n) (fn i
              (let (
                  (lo (math/max 0 (- @i @k)))
                  (hi (math/min (- @n 1) (+ @i @k)))
                  (wSum (array/reduce (array/range (+ (- @hi @lo) 1)) 0 (fn (acc j) (+ @acc (array/nth @entity.opinions (+ @lo @j))))))
                  (wLen (+ (- @hi @lo) 1))
                  (localMajority (if (>= (* 2 @wSum) @wLen) 1 0))
                )
                (if (< (math/random) @entity.devianceRate) (- 1 @localMajority) @localMajority)))))
            (ones (array/reduce @newOpinions 0 (fn (acc v) (+ @acc @v))))
            (majPct (* 100 (/ (math/max @ones (- @n @ones)) @n)))
            (gridCols @config.gridCols)
            (dx (/ (- @config.width (* 2 @config.gridMargin)) (- @gridCols 1)))
            (rowCount (+ (math/floor (/ (- @n 1) @gridCols)) 1))
            (dy (/ (- @config.height (* 2 @config.gridMargin)) (- @rowCount 1)))
            (renderNodes (array/map (array/range @n) (fn i
              { id: (str/concat "a" @i), x: (+ @config.gridMargin (* (math/mod @i @gridCols) @dx)), y: (+ @config.gridMargin (* (math/floor (/ @i @gridCols)) @dy)), radius: @config.agentRadius, color: (if (== (array/nth @newOpinions @i) 1) @config.deviantColor @config.normColor), label: "" })))
          )
          (do
            (set @entity.opinions @newOpinions)
            (set @entity.stepCount (+ @entity.stepCount 1))
            (set @entity.majorityPct @majPct)
            (set @entity.nodes @renderNodes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP, label: "Step", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Step " @entity.stepCount " — majority share: " (math/round @entity.majorityPct 1) "%") },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Deviance rate: " @entity.devianceRate " — each step, every agent adopts the local majority opinion, except this share who deliberately break with it.") },
                    { type: range-slider, min: 0, max: 0.5, step: 0.01, value: @entity.devianceRate, showTooltip: true, onChange: SET_DEVIANCE }
                  ] }
              ] }
          ]
        })
        (emit CONFORMITY_UPDATED { stepCount: @entity.stepCount, majorityPct: @entity.majorityPct, devianceRate: @entity.devianceRate, opinions: @entity.opinions })

      SET_DEVIANCE -> idle when (== @entity.active true)
        (set @entity.devianceRate ?value)
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP, label: "Step", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Step " @entity.stepCount " — majority share: " (math/round @entity.majorityPct 1) "%") },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Deviance rate: " @entity.devianceRate " — each step, every agent adopts the local majority opinion, except this share who deliberately break with it.") },
                    { type: range-slider, min: 0, max: 0.5, step: 0.01, value: @entity.devianceRate, showTooltip: true, onChange: SET_DEVIANCE }
                  ] }
              ] }
          ]
        })
        (emit CONFORMITY_UPDATED { stepCount: @entity.stepCount, majorityPct: @entity.majorityPct, devianceRate: @entity.devianceRate, opinions: @entity.opinions })

      RESET -> idle when (== @entity.active true)
        (set @entity.devianceRate @config.devianceRate)
        (set @entity.stepCount 0)
        (let (
            (n @config.agentCount)
            (opinionsInit (array/map (array/range @n) (fn i (if (== @i (math/floor (/ @n 2))) 1 0))))
            (gridCols @config.gridCols)
            (dx (/ (- @config.width (* 2 @config.gridMargin)) (- @gridCols 1)))
            (rowCount (+ (math/floor (/ (- @n 1) @gridCols)) 1))
            (dy (/ (- @config.height (* 2 @config.gridMargin)) (- @rowCount 1)))
            (renderNodes (array/map (array/range @n) (fn i
              { id: (str/concat "a" @i), x: (+ @config.gridMargin (* (math/mod @i @gridCols) @dx)), y: (+ @config.gridMargin (* (math/floor (/ @i @gridCols)) @dy)), radius: @config.agentRadius, color: (if (== (array/nth @opinionsInit @i) 1) @config.deviantColor @config.normColor), label: "" })))
          )
          (do
            (set @entity.opinions @opinionsInit)
            (set @entity.majorityPct (* 100 (/ (- @n 1) @n)))
            (set @entity.nodes @renderNodes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP, label: "Step", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: (str/concat "Step " @entity.stepCount " — majority share: " (math/round @entity.majorityPct 1) "%") },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Deviance rate: " @entity.devianceRate " — each step, every agent adopts the local majority opinion, except this share who deliberately break with it.") },
                    { type: range-slider, min: 0, max: 0.5, step: 0.01, value: @entity.devianceRate, showTooltip: true, onChange: SET_DEVIANCE }
                  ] }
              ] }
          ]
        })
        (emit CONFORMITY_UPDATED { stepCount: @entity.stepCount, majorityPct: @entity.majorityPct, devianceRate: @entity.devianceRate, opinions: @entity.opinions })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      STEP {
      }
        @description "Learner pressed Step to advance the conformity simulation by one round of local-majority adoption."
        @tier "domain"
      SET_DEVIANCE {
        value : number
      }
        @description "Learner dragged the deviance-rate slider."
        @tier "domain"
      RESET {
      }
        @description "Learner pressed Reset to restore the initial population (a lone deviant in a conforming majority)."
        @tier "domain"
    }

    emits {
      CONFORMITY_UPDATED -> external {
        stepCount : number
        majorityPct : number
        devianceRate : number
        opinions : [number]
      }
        @description "The conformity state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "conformity update, step, local majority, deviance rate, convergence"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Conformity & Deviance"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#f1f5f9"
        @label "Background Color"
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 320
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      normColor : string = "#2563eb"
        @label "Norm Color"
        @description "Color of agents holding opinion 0 (the initial norm)."
        @tier "presentation"
      deviantColor : string = "#dc2626"
        @label "Deviant Color"
        @description "Color of agents holding opinion 1 (the initial deviance)."
        @tier "presentation"
      agentRadius : number = 11
        @label "Agent Radius"
        @tier "presentation"
      gridCols : number = 8
        @label "Grid Columns"
        @description "How many agents per row when the population is laid out on the canvas grid."
        @tier "presentation"
      gridMargin : number = 40
        @label "Grid Margin"
        @description "Margin in pixels between the grid of agents and the canvas edge."
        @tier "presentation"
      agentCount : number = 24
        @label "Agent Count"
        @description "Number of agents in the population. At seeding, all hold opinion 0 except one lone deviant in the middle."
        @synonyms "agents, population, actors, conformity, social influence"
        @tier "domain"
      devianceRate : number = 0.05
        @label "Deviance Rate"
        @description "Probability (0-0.5) that an agent deliberately adopts the opposite of its local majority in a step — Merton's nonconformist. Zero drives fast convergence; high values fragment the population."
        @synonyms "deviance, nonconformity, Merton, innovation, rebellion, social deviance"
        @tier "domain"
      neighborhoodSize : number = 1
        @label "Neighborhood Size"
        @description "How many agents on each side (in row order) count as an agent's neighborhood when computing the local majority it conforms to."
        @synonyms "neighborhood, reference group, peer influence, local majority"
        @tier "domain"
    }
  }

  page "/soc-conformity" as SocConfPage -> SocConfSim
}
