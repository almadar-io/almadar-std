app std-bio-dna-replication "1.0.0"
"Biological engine (biology-canvas): DNA replication engine — simulates the unzipping of a DNA double helix and the synthesis of new complementary strands; composed by a learning orbital via `uses`."
orbital DNAReplicationEngineOrbital {
  type BioNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
  }

  entity DNAState [runtime] {
    id : string!
    nodes : [BioNode]
    progress : number = 0
    running : boolean = true
    done : boolean = false
  }

  trait DNAReplicationSim -> @rebindable DNAState [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.nodes @config.initial_nodes)
        (set @entity.progress 0)
        (set @entity.running @config.running)
        (set @entity.done false)
        (render-ui main {
          type: biology-canvas
          width: @config.width
          height: @config.height
          backgroundColor: @config.backgroundColor
          nodes: @entity.nodes
        })
        (emit DNA_UPDATED { nodes: @entity.nodes, progress: @entity.progress })
    }

    ticks {
      replicationTick every 500ms
        when (and @entity.running (not @entity.done))
        (do
          (set @entity.progress (+ @entity.progress 0.1))
          (if (>= @entity.progress 1)
            (set @entity.done true)
            (set @entity.done false))
          (set @entity.nodes (array/map @config.initial_nodes (fn node
            (let (
              (idx @index)
              (target_x (array/nth @config.strand_positions @idx))
              (separation (* @config.max_separation @entity.progress))
              (is_original (if (== (object/get @node kind) "molecule") true false))
            )
            (let (
              (new_x (if @is_original
                (if (< @idx (* 5 @entity.progress))
                  @target_x
                  (- @target_x @separation))
                @target_x))
            )
            (object/merge @node {
              x: @new_x
              y: (object/get @node y)
              color: (if @is_original (if (< @idx (* 5 @entity.progress)) "#3b82f6" "#ef4444") "#3b82f6")
            }))))))
          (render-ui main {
            type: biology-canvas
            width: @config.width
            height: @config.height
            backgroundColor: @config.backgroundColor
            nodes: @entity.nodes
          })
          (emit DNA_UPDATED { nodes: @entity.nodes, progress: @entity.progress })
        )
    }

    emits {
      DNA_UPDATED -> external {
        nodes : [BioNode]
        progress : number
      }
        @description "The current DNA replication scene."
        @tier "domain"
    }

    config {
      running : boolean = true
        @label "Running"
        @description "Toggle simulation."
        @tier "domain"
      max_separation : number = 50
        @label "Max Separation"
        @description "Max distance between strands."
        @tier "domain"
      width : number = 600
        @label "Width"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @tier "presentation"
      backgroundColor : string = "#f0fdf4"
        @label "Background Color"
        @tier "presentation"
      initial_nodes : [BioNode] = [
        { id: "n1", x: 300, y: 150, radius: 10, color: "#3b82f6", label: "A", kind: "molecule" },
        { id: "n2", x: 300, y: 170, radius: 10, color: "#3b82f6", label: "T", kind: "molecule" },
        { id: "n3", x: 300, y: 190, radius: 10, color: "#3b82f6", label: "G", kind: "molecule" },
        { id: "n4", x: 300, y: 210, radius: 10, color: "#3b82f6", label: "C", kind: "molecule" },
        { id: "n5", x: 300, y: 230, radius: 10, color: "#3b82f6", label: "A", kind: "molecule" },
        { id: "n6", x: 300, y: 250, radius: 10, color: "#3b82f6", label: "T", kind: "molecule" },
        { id: "n7", x: 300, y: 270, radius: 10, color: "#3b82f6", label: "G", kind: "molecule" },
        { id: "n8", x: 300, y: 290, radius: 10, color: "#3b82f6", label: "C", kind: "molecule" }
      ]
        @label "Initial Nodes"
        @description "Initial DNA nucleotides."
        @tier "presentation"
      strand_positions : [number] = [300, 300, 300, 300, 300, 300, 300, 300]
        @label "Base X Positions"
        @tier "presentation"
    }
  }

  page "/bio-dna" as DNAReplicationEnginePage -> DNAReplicationSim
}
