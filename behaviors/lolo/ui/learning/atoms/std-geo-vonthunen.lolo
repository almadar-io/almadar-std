app std-geo-vonthunen "1.0.0"
"Von Thünen bid-rent engine — each crop draws a bid-rent line (rent versus distance to market) on a math-canvas; the transport-cost and market-price dials shift every line's slope and intercept, and the concentric ring boundaries (line intersections) redraw live. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital GeoVonThunenOrbital {
  type GeoVonThunenShapePoint = {
    x : number!
    y : number!
  }
  type GeoVonThunenShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [GeoVonThunenShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type GeoVonThunenCurveSample = {
    x : number!
    y : number!
  }
  type GeoVonThunenCurve = {
    label : string
    color : string
    samples : [GeoVonThunenCurveSample]!
  }
  type GeoVonThunenCrop = {
    id : string!
    label : string!
    color : string!
    yieldPerHa : number!
    basePrice : number!
    fixedCost : number!
    transportRate : number!
  }

  entity GeoVonThunenScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    transportCost : number
    marketPrice : number
    ringBoundaries : [number]
    boundariesReadout : string
    rentCurves : [GeoVonThunenCurve]
    vonThunenShapes : [GeoVonThunenShape]
  }

  trait GeoVonThunenSim -> @rebindable GeoVonThunenScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.transportCost @config.transportCosts)
        (set @entity.marketPrice @config.marketPrices)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (cropLines (array/map @config.crops (fn c (let (
                    (intercept (- (* (* (object/get @c basePrice) @entity.marketPrice) (object/get @c yieldPerHa)) (object/get @c fixedCost)))
                    (slope (* (object/get @c transportRate) @entity.transportCost))
                  )
                  { label: (object/get @c label), color: (object/get @c color), intercept: @intercept, slope: @slope }))))
            (rentCurves (array/map @cropLines (fn cl { label: (object/get @cl label), color: (object/get @cl color), samples: [ { x: @plotLeft, y: (- @plotBottom (* (/ (math/max 0 (object/get @cl intercept)) @config.rentAxisMax) @plotHeightPx)) }, { x: @plotRight, y: (- @plotBottom (* (/ (math/max 0 (- (object/get @cl intercept) (* (object/get @cl slope) @config.distanceAxisMax))) @config.rentAxisMax) @plotHeightPx)) } ] })))
            (boundaryRows (array/map (array/range (math/max 0 (- (array/len @cropLines) 1))) (fn i (let (
                    (inner (array/nth @cropLines @i))
                    (outer (array/nth @cropLines (+ @i 1)))
                    (raw (/ (- (object/get @inner intercept) (object/get @outer intercept)) (math/max 0.0001 (- (object/get @inner slope) (object/get @outer slope)))))
                  )
                  (math/clamp @raw 0 @config.distanceAxisMax)))))
            (ringBoundaries @boundaryRows)
            (boundaryShapes (array/map (array/range (array/len @boundaryRows)) (fn i (let (
                    (b (array/nth @boundaryRows @i))
                    (xPos (+ @plotLeft (* (/ @b @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: line, x1: @xPos, y1: @plotTop, x2: @xPos, y2: @plotBottom, color: @config.boundaryColor, lineWidth: 2 }))))
            (cropLabels (array/map (array/range (array/len @cropLines)) (fn i (let (
                    (cl (array/nth @cropLines @i))
                    (leftB (if (== @i 0) 0 (array/nth @boundaryRows (- @i 1))))
                    (rightB (if (== @i (- (array/len @cropLines) 1)) @config.distanceAxisMax (array/nth @boundaryRows @i)))
                    (midX (+ @plotLeft (* (/ (/ (+ @leftB @rightB) 2) @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: text, x: @midX, y: (+ @plotBottom 16), text: (object/get @cl label), fontSize: 11, align: "center", color: (object/get @cl color) }))))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (vonThunenShapes (array/concat (array/concat @axisShapes @boundaryShapes) @cropLabels))
            (boundariesReadout (str/concat "Ring boundaries (km): " (str/join (array/map @boundaryRows (fn b (math/round @b 1))) ", ") " — market price x" @entity.marketPrice ", transport cost x" @entity.transportCost))
          )
          (do
            (set @entity.ringBoundaries @ringBoundaries)
            (set @entity.boundariesReadout @boundariesReadout)
            (set @entity.rentCurves @rentCurves)
            (set @entity.vonThunenShapes @vonThunenShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.rentCurves, points: [], vectors: [], shapes: @entity.vonThunenShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Transport cost multiplier: x" @entity.transportCost) },
                    { type: range-slider, min: 0.5, max: 3, step: 0.1, value: @entity.transportCost, showTooltip: true, onChange: SET_COST },
                    { type: typography, variant: caption, content: (str/concat "Market price multiplier: x" @entity.marketPrice) },
                    { type: range-slider, min: 0.5, max: 2, step: 0.1, value: @entity.marketPrice, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: typography, variant: body, content: @entity.boundariesReadout },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.crops (fn c { type: badge, label: (object/get @c label), variant: neutral })) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.transportCost @config.transportCosts)
        (set @entity.marketPrice @config.marketPrices)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (cropLines (array/map @config.crops (fn c (let (
                    (intercept (- (* (* (object/get @c basePrice) @entity.marketPrice) (object/get @c yieldPerHa)) (object/get @c fixedCost)))
                    (slope (* (object/get @c transportRate) @entity.transportCost))
                  )
                  { label: (object/get @c label), color: (object/get @c color), intercept: @intercept, slope: @slope }))))
            (rentCurves (array/map @cropLines (fn cl { label: (object/get @cl label), color: (object/get @cl color), samples: [ { x: @plotLeft, y: (- @plotBottom (* (/ (math/max 0 (object/get @cl intercept)) @config.rentAxisMax) @plotHeightPx)) }, { x: @plotRight, y: (- @plotBottom (* (/ (math/max 0 (- (object/get @cl intercept) (* (object/get @cl slope) @config.distanceAxisMax))) @config.rentAxisMax) @plotHeightPx)) } ] })))
            (boundaryRows (array/map (array/range (math/max 0 (- (array/len @cropLines) 1))) (fn i (let (
                    (inner (array/nth @cropLines @i))
                    (outer (array/nth @cropLines (+ @i 1)))
                    (raw (/ (- (object/get @inner intercept) (object/get @outer intercept)) (math/max 0.0001 (- (object/get @inner slope) (object/get @outer slope)))))
                  )
                  (math/clamp @raw 0 @config.distanceAxisMax)))))
            (ringBoundaries @boundaryRows)
            (boundaryShapes (array/map (array/range (array/len @boundaryRows)) (fn i (let (
                    (b (array/nth @boundaryRows @i))
                    (xPos (+ @plotLeft (* (/ @b @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: line, x1: @xPos, y1: @plotTop, x2: @xPos, y2: @plotBottom, color: @config.boundaryColor, lineWidth: 2 }))))
            (cropLabels (array/map (array/range (array/len @cropLines)) (fn i (let (
                    (cl (array/nth @cropLines @i))
                    (leftB (if (== @i 0) 0 (array/nth @boundaryRows (- @i 1))))
                    (rightB (if (== @i (- (array/len @cropLines) 1)) @config.distanceAxisMax (array/nth @boundaryRows @i)))
                    (midX (+ @plotLeft (* (/ (/ (+ @leftB @rightB) 2) @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: text, x: @midX, y: (+ @plotBottom 16), text: (object/get @cl label), fontSize: 11, align: "center", color: (object/get @cl color) }))))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (vonThunenShapes (array/concat (array/concat @axisShapes @boundaryShapes) @cropLabels))
            (boundariesReadout (str/concat "Ring boundaries (km): " (str/join (array/map @boundaryRows (fn b (math/round @b 1))) ", ") " — market price x" @entity.marketPrice ", transport cost x" @entity.transportCost))
          )
          (do
            (set @entity.ringBoundaries @ringBoundaries)
            (set @entity.boundariesReadout @boundariesReadout)
            (set @entity.rentCurves @rentCurves)
            (set @entity.vonThunenShapes @vonThunenShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.rentCurves, points: [], vectors: [], shapes: @entity.vonThunenShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Transport cost multiplier: x" @entity.transportCost) },
                    { type: range-slider, min: 0.5, max: 3, step: 0.1, value: @entity.transportCost, showTooltip: true, onChange: SET_COST },
                    { type: typography, variant: caption, content: (str/concat "Market price multiplier: x" @entity.marketPrice) },
                    { type: range-slider, min: 0.5, max: 2, step: 0.1, value: @entity.marketPrice, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: typography, variant: body, content: @entity.boundariesReadout },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.crops (fn c { type: badge, label: (object/get @c label), variant: neutral })) }
              ] }
          ]
        })

      SET_COST -> idle when (== @entity.active true)
        (set @entity.transportCost ?value)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (cropLines (array/map @config.crops (fn c (let (
                    (intercept (- (* (* (object/get @c basePrice) @entity.marketPrice) (object/get @c yieldPerHa)) (object/get @c fixedCost)))
                    (slope (* (object/get @c transportRate) @entity.transportCost))
                  )
                  { label: (object/get @c label), color: (object/get @c color), intercept: @intercept, slope: @slope }))))
            (rentCurves (array/map @cropLines (fn cl { label: (object/get @cl label), color: (object/get @cl color), samples: [ { x: @plotLeft, y: (- @plotBottom (* (/ (math/max 0 (object/get @cl intercept)) @config.rentAxisMax) @plotHeightPx)) }, { x: @plotRight, y: (- @plotBottom (* (/ (math/max 0 (- (object/get @cl intercept) (* (object/get @cl slope) @config.distanceAxisMax))) @config.rentAxisMax) @plotHeightPx)) } ] })))
            (boundaryRows (array/map (array/range (math/max 0 (- (array/len @cropLines) 1))) (fn i (let (
                    (inner (array/nth @cropLines @i))
                    (outer (array/nth @cropLines (+ @i 1)))
                    (raw (/ (- (object/get @inner intercept) (object/get @outer intercept)) (math/max 0.0001 (- (object/get @inner slope) (object/get @outer slope)))))
                  )
                  (math/clamp @raw 0 @config.distanceAxisMax)))))
            (ringBoundaries @boundaryRows)
            (boundaryShapes (array/map (array/range (array/len @boundaryRows)) (fn i (let (
                    (b (array/nth @boundaryRows @i))
                    (xPos (+ @plotLeft (* (/ @b @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: line, x1: @xPos, y1: @plotTop, x2: @xPos, y2: @plotBottom, color: @config.boundaryColor, lineWidth: 2 }))))
            (cropLabels (array/map (array/range (array/len @cropLines)) (fn i (let (
                    (cl (array/nth @cropLines @i))
                    (leftB (if (== @i 0) 0 (array/nth @boundaryRows (- @i 1))))
                    (rightB (if (== @i (- (array/len @cropLines) 1)) @config.distanceAxisMax (array/nth @boundaryRows @i)))
                    (midX (+ @plotLeft (* (/ (/ (+ @leftB @rightB) 2) @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: text, x: @midX, y: (+ @plotBottom 16), text: (object/get @cl label), fontSize: 11, align: "center", color: (object/get @cl color) }))))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (vonThunenShapes (array/concat (array/concat @axisShapes @boundaryShapes) @cropLabels))
            (boundariesReadout (str/concat "Ring boundaries (km): " (str/join (array/map @boundaryRows (fn b (math/round @b 1))) ", ") " — market price x" @entity.marketPrice ", transport cost x" @entity.transportCost))
          )
          (do
            (set @entity.ringBoundaries @ringBoundaries)
            (set @entity.boundariesReadout @boundariesReadout)
            (set @entity.rentCurves @rentCurves)
            (set @entity.vonThunenShapes @vonThunenShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.rentCurves, points: [], vectors: [], shapes: @entity.vonThunenShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Transport cost multiplier: x" @entity.transportCost) },
                    { type: range-slider, min: 0.5, max: 3, step: 0.1, value: @entity.transportCost, showTooltip: true, onChange: SET_COST },
                    { type: typography, variant: caption, content: (str/concat "Market price multiplier: x" @entity.marketPrice) },
                    { type: range-slider, min: 0.5, max: 2, step: 0.1, value: @entity.marketPrice, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: typography, variant: body, content: @entity.boundariesReadout },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.crops (fn c { type: badge, label: (object/get @c label), variant: neutral })) }
              ] }
          ]
        })
        (emit VONTHUNEN_UPDATED { transportCost: @entity.transportCost, marketPrice: @entity.marketPrice, ringBoundaries: @entity.ringBoundaries })

      SET_PRICE -> idle when (== @entity.active true)
        (set @entity.marketPrice ?value)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (cropLines (array/map @config.crops (fn c (let (
                    (intercept (- (* (* (object/get @c basePrice) @entity.marketPrice) (object/get @c yieldPerHa)) (object/get @c fixedCost)))
                    (slope (* (object/get @c transportRate) @entity.transportCost))
                  )
                  { label: (object/get @c label), color: (object/get @c color), intercept: @intercept, slope: @slope }))))
            (rentCurves (array/map @cropLines (fn cl { label: (object/get @cl label), color: (object/get @cl color), samples: [ { x: @plotLeft, y: (- @plotBottom (* (/ (math/max 0 (object/get @cl intercept)) @config.rentAxisMax) @plotHeightPx)) }, { x: @plotRight, y: (- @plotBottom (* (/ (math/max 0 (- (object/get @cl intercept) (* (object/get @cl slope) @config.distanceAxisMax))) @config.rentAxisMax) @plotHeightPx)) } ] })))
            (boundaryRows (array/map (array/range (math/max 0 (- (array/len @cropLines) 1))) (fn i (let (
                    (inner (array/nth @cropLines @i))
                    (outer (array/nth @cropLines (+ @i 1)))
                    (raw (/ (- (object/get @inner intercept) (object/get @outer intercept)) (math/max 0.0001 (- (object/get @inner slope) (object/get @outer slope)))))
                  )
                  (math/clamp @raw 0 @config.distanceAxisMax)))))
            (ringBoundaries @boundaryRows)
            (boundaryShapes (array/map (array/range (array/len @boundaryRows)) (fn i (let (
                    (b (array/nth @boundaryRows @i))
                    (xPos (+ @plotLeft (* (/ @b @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: line, x1: @xPos, y1: @plotTop, x2: @xPos, y2: @plotBottom, color: @config.boundaryColor, lineWidth: 2 }))))
            (cropLabels (array/map (array/range (array/len @cropLines)) (fn i (let (
                    (cl (array/nth @cropLines @i))
                    (leftB (if (== @i 0) 0 (array/nth @boundaryRows (- @i 1))))
                    (rightB (if (== @i (- (array/len @cropLines) 1)) @config.distanceAxisMax (array/nth @boundaryRows @i)))
                    (midX (+ @plotLeft (* (/ (/ (+ @leftB @rightB) 2) @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: text, x: @midX, y: (+ @plotBottom 16), text: (object/get @cl label), fontSize: 11, align: "center", color: (object/get @cl color) }))))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (vonThunenShapes (array/concat (array/concat @axisShapes @boundaryShapes) @cropLabels))
            (boundariesReadout (str/concat "Ring boundaries (km): " (str/join (array/map @boundaryRows (fn b (math/round @b 1))) ", ") " — market price x" @entity.marketPrice ", transport cost x" @entity.transportCost))
          )
          (do
            (set @entity.ringBoundaries @ringBoundaries)
            (set @entity.boundariesReadout @boundariesReadout)
            (set @entity.rentCurves @rentCurves)
            (set @entity.vonThunenShapes @vonThunenShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.rentCurves, points: [], vectors: [], shapes: @entity.vonThunenShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Transport cost multiplier: x" @entity.transportCost) },
                    { type: range-slider, min: 0.5, max: 3, step: 0.1, value: @entity.transportCost, showTooltip: true, onChange: SET_COST },
                    { type: typography, variant: caption, content: (str/concat "Market price multiplier: x" @entity.marketPrice) },
                    { type: range-slider, min: 0.5, max: 2, step: 0.1, value: @entity.marketPrice, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: typography, variant: body, content: @entity.boundariesReadout },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.crops (fn c { type: badge, label: (object/get @c label), variant: neutral })) }
              ] }
          ]
        })
        (emit VONTHUNEN_UPDATED { transportCost: @entity.transportCost, marketPrice: @entity.marketPrice, ringBoundaries: @entity.ringBoundaries })

      RESET -> idle when (== @entity.active true)
        (set @entity.transportCost @config.transportCosts)
        (set @entity.marketPrice @config.marketPrices)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (cropLines (array/map @config.crops (fn c (let (
                    (intercept (- (* (* (object/get @c basePrice) @entity.marketPrice) (object/get @c yieldPerHa)) (object/get @c fixedCost)))
                    (slope (* (object/get @c transportRate) @entity.transportCost))
                  )
                  { label: (object/get @c label), color: (object/get @c color), intercept: @intercept, slope: @slope }))))
            (rentCurves (array/map @cropLines (fn cl { label: (object/get @cl label), color: (object/get @cl color), samples: [ { x: @plotLeft, y: (- @plotBottom (* (/ (math/max 0 (object/get @cl intercept)) @config.rentAxisMax) @plotHeightPx)) }, { x: @plotRight, y: (- @plotBottom (* (/ (math/max 0 (- (object/get @cl intercept) (* (object/get @cl slope) @config.distanceAxisMax))) @config.rentAxisMax) @plotHeightPx)) } ] })))
            (boundaryRows (array/map (array/range (math/max 0 (- (array/len @cropLines) 1))) (fn i (let (
                    (inner (array/nth @cropLines @i))
                    (outer (array/nth @cropLines (+ @i 1)))
                    (raw (/ (- (object/get @inner intercept) (object/get @outer intercept)) (math/max 0.0001 (- (object/get @inner slope) (object/get @outer slope)))))
                  )
                  (math/clamp @raw 0 @config.distanceAxisMax)))))
            (ringBoundaries @boundaryRows)
            (boundaryShapes (array/map (array/range (array/len @boundaryRows)) (fn i (let (
                    (b (array/nth @boundaryRows @i))
                    (xPos (+ @plotLeft (* (/ @b @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: line, x1: @xPos, y1: @plotTop, x2: @xPos, y2: @plotBottom, color: @config.boundaryColor, lineWidth: 2 }))))
            (cropLabels (array/map (array/range (array/len @cropLines)) (fn i (let (
                    (cl (array/nth @cropLines @i))
                    (leftB (if (== @i 0) 0 (array/nth @boundaryRows (- @i 1))))
                    (rightB (if (== @i (- (array/len @cropLines) 1)) @config.distanceAxisMax (array/nth @boundaryRows @i)))
                    (midX (+ @plotLeft (* (/ (/ (+ @leftB @rightB) 2) @config.distanceAxisMax) @plotWidthPx)))
                  )
                  { type: text, x: @midX, y: (+ @plotBottom 16), text: (object/get @cl label), fontSize: 11, align: "center", color: (object/get @cl color) }))))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (vonThunenShapes (array/concat (array/concat @axisShapes @boundaryShapes) @cropLabels))
            (boundariesReadout (str/concat "Ring boundaries (km): " (str/join (array/map @boundaryRows (fn b (math/round @b 1))) ", ") " — market price x" @entity.marketPrice ", transport cost x" @entity.transportCost))
          )
          (do
            (set @entity.ringBoundaries @ringBoundaries)
            (set @entity.boundariesReadout @boundariesReadout)
            (set @entity.rentCurves @rentCurves)
            (set @entity.vonThunenShapes @vonThunenShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.rentCurves, points: [], vectors: [], shapes: @entity.vonThunenShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Transport cost multiplier: x" @entity.transportCost) },
                    { type: range-slider, min: 0.5, max: 3, step: 0.1, value: @entity.transportCost, showTooltip: true, onChange: SET_COST },
                    { type: typography, variant: caption, content: (str/concat "Market price multiplier: x" @entity.marketPrice) },
                    { type: range-slider, min: 0.5, max: 2, step: 0.1, value: @entity.marketPrice, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: typography, variant: body, content: @entity.boundariesReadout },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.crops (fn c { type: badge, label: (object/get @c label), variant: neutral })) }
              ] }
          ]
        })
        (emit VONTHUNEN_UPDATED { transportCost: @entity.transportCost, marketPrice: @entity.marketPrice, ringBoundaries: @entity.ringBoundaries })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_COST {
        value : number
      }
        @description "Learner dragged the transport-cost multiplier dial."
        @tier "domain"
      SET_PRICE {
        value : number
      }
        @description "Learner dragged the market-price multiplier dial."
        @tier "domain"
      RESET {
      }
        @description "Learner reset both dials to the configured starting values."
        @tier "domain"
    }

    emits {
      VONTHUNEN_UPDATED -> external {
        transportCost : number
        marketPrice : number
        ringBoundaries : [number]
      }
        @description "The von Thünen state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "von Thunen, bid-rent, bid rent curve, land rent, transport cost, market price, agricultural rings, concentric rings, ring boundary"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Von Thünen Bid-Rent Rings"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 460
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      crops : [GeoVonThunenCrop] = [
        { id: "horticulture", label: "Market Gardening", color: "#16a34a", yieldPerHa: 10, basePrice: 60, fixedCost: 50, transportRate: 40 },
        { id: "dairy", label: "Dairy", color: "#f59e0b", yieldPerHa: 8, basePrice: 50, fixedCost: 40, transportRate: 25 },
        { id: "grain", label: "Grain", color: "#a16207", yieldPerHa: 6, basePrice: 40, fixedCost: 30, transportRate: 10 },
        { id: "ranching", label: "Ranching", color: "#7c2d12", yieldPerHa: 4, basePrice: 30, fixedCost: 20, transportRate: 3 }
      ]
        @label "Crops"
        @description "Ordered innermost-to-outermost roster of crops; each declares yield per hectare, base market price, fixed production cost, and per-km transport rate. Bid-rent line for a crop: rent(d) = basePrice x priceDial x yield - fixedCost - transportRate x costDial x d."
        @synonyms "crop, land use, bid rent, rent gradient, yield, transport rate, market gardening, dairy, grain, ranching"
        @tier "domain"
      transportCosts : number = 1
        @label "Starting Transport Cost Multiplier"
        @description "Starting transport-cost dial — multiplies every crop's per-km transport rate, steepening or flattening all bid-rent lines."
        @synonyms "transport cost, freight rate, transportation cost, distance decay"
        @tier "domain"
      marketPrices : number = 1
        @label "Starting Market Price Multiplier"
        @description "Starting market-price dial — multiplies every crop's base price, raising or lowering all bid-rent intercepts."
        @synonyms "market price, commodity price, farm gate price"
        @tier "domain"
      distanceAxisMax : number = 30
        @label "Distance Axis Max"
        @description "Upper bound of the distance-from-market axis, in km."
        @tier "presentation"
      rentAxisMax : number = 600
        @label "Rent Axis Max"
        @description "Upper bound of the bid-rent vertical axis."
        @tier "presentation"
      boundaryColor : string = "#7c3aed"
        @label "Boundary Color"
        @tier "presentation"
      axisColor : string = "#94a3b8"
        @label "Axis Color"
        @tier "presentation"
      textColor : string = "#1e293b"
        @label "Text Color"
        @tier "presentation"
    }
  }

  page "/geo-vonthunen" as GeoVonThunenPage -> GeoVonThunenSim
}
