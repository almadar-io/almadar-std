app std-earth-watercycle "1.0.0"
"Water-cycle flux simulator — the learner drives solar input and steps the cycle to watch evaporation, condensation, precipitation, and runoff fluxes rebalance across ocean, atmosphere, and land reservoirs, on a biology-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EarthWatercycleOrbital {
  type EarthWatercycleNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
  }
  type EarthWatercycleEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type EarthWatercycleShapePoint = {
    x : number!
    y : number!
  }
  type EarthWatercycleShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [EarthWatercycleShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type EarthWatercycleReservoir = {
    id : string!
    label : string
    color : string
    radius : number
  }

  entity EarthWatercycleScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [EarthWatercycleNode]
    edges : [EarthWatercycleEdge]
    shapes : [EarthWatercycleShape]
    solarInput : number
    cycleStep : number
    evaporationFlux : number
    condensationFlux : number
    precipitationFlux : number
    runoffFlux : number
    oceanReadout : string
    atmosphereReadout : string
    landReadout : string
  }

  trait EarthWatercycleSim -> @rebindable EarthWatercycleScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.solarInput @config.solarInput)
        (set @entity.cycleStep 0)
        (let (
            (evap (* @config.baseEvaporationFlux (/ @entity.solarInput 100)))
            (condensation (* @evap @config.condensationRatio))
            (precip (* @condensation @config.precipitationRatio))
            (runoff (* @precip @config.runoffRatio))
            (oceanNet (- @runoff @evap))
            (atmosNet (- @evap @precip))
            (landNet (- @precip @runoff))
            (evapW (math/clamp (+ 1 (* @evap @config.fluxWidthScale)) 1 10))
            (condW (math/clamp (+ 1 (* @condensation @config.fluxWidthScale)) 1 10))
            (precipW (math/clamp (+ 1 (* @precip @config.fluxWidthScale)) 1 10))
            (runoffW (math/clamp (+ 1 (* @runoff @config.fluxWidthScale)) 1 10))
            (oceanCfg (array/nth @config.reservoirs 0))
            (atmosphereCfg (array/nth @config.reservoirs 1))
            (landCfg (array/nth @config.reservoirs 2))
            (oceanX (* @config.width 0.25))
            (oceanY (- @config.height 90))
            (atmosphereX (/ @config.width 2))
            (atmosphereY 90)
            (landX (* @config.width 0.78))
            (landY (- @config.height 100))
            (reservoirNodes [
                { id: (object/get @oceanCfg id), x: @oceanX, y: @oceanY, radius: (object/get @oceanCfg radius), color: (object/get @oceanCfg color), label: (object/get @oceanCfg label) },
                { id: (object/get @atmosphereCfg id), x: @atmosphereX, y: @atmosphereY, radius: (object/get @atmosphereCfg radius), color: (object/get @atmosphereCfg color), label: (object/get @atmosphereCfg label) },
                { id: (object/get @landCfg id), x: @landX, y: @landY, radius: (object/get @landCfg radius), color: (object/get @landCfg color), label: (object/get @landCfg label) }
              ])
            (fluxShapes [
                { type: line, x1: @oceanX, y1: (- @oceanY 40), x2: (- @atmosphereX 40), y2: (+ @atmosphereY 50), color: "#0ea5e9", lineWidth: @evapW },
                { type: line, x1: @atmosphereX, y1: (+ @atmosphereY 10), x2: @atmosphereX, y2: (- @atmosphereY 30), color: "#94a3b8", lineWidth: @condW },
                { type: line, x1: (+ @atmosphereX 30), y1: (+ @atmosphereY 40), x2: (- @landX 20), y2: (- @landY 40), color: "#2563eb", lineWidth: @precipW },
                { type: line, x1: @landX, y1: @landY, x2: (+ @oceanX 60), y2: @oceanY, color: "#166534", lineWidth: @runoffW }
              ])
            (oceanReadout (str/concat "Ocean — evaporation out " (math/round @evap 1) ", runoff in " (math/round @runoff 1) ", net " (math/round @oceanNet 1)))
            (atmosphereReadout (str/concat "Atmosphere — evaporation in " (math/round @evap 1) ", condensation " (math/round @condensation 1) ", precipitation out " (math/round @precip 1) ", net " (math/round @atmosNet 1)))
            (landReadout (str/concat "Land — precipitation in " (math/round @precip 1) ", runoff out " (math/round @runoff 1) ", net " (math/round @landNet 1)))
          )
          (do
            (set @entity.evaporationFlux @evap)
            (set @entity.condensationFlux @condensation)
            (set @entity.precipitationFlux @precip)
            (set @entity.runoffFlux @runoff)
            (set @entity.oceanReadout @oceanReadout)
            (set @entity.atmosphereReadout @atmosphereReadout)
            (set @entity.landReadout @landReadout)
            (set @entity.edges [])
            (set @entity.nodes @reservoirNodes)
            (set @entity.shapes @fluxShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Solar input: " @entity.solarInput "%") },
                    { type: range-slider, min: 0, max: 100, step: 1, value: @entity.solarInput, showTooltip: true, onChange: SET_SOLAR }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_CYCLE, label: "Step the Cycle", variant: primary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Cycle step: " @entity.cycleStep) },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: body, content: @entity.oceanReadout },
                    { type: typography, variant: body, content: @entity.atmosphereReadout },
                    { type: typography, variant: body, content: @entity.landReadout }
                  ] }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.solarInput @config.solarInput)
        (set @entity.cycleStep 0)
        (let (
            (evap (* @config.baseEvaporationFlux (/ @entity.solarInput 100)))
            (condensation (* @evap @config.condensationRatio))
            (precip (* @condensation @config.precipitationRatio))
            (runoff (* @precip @config.runoffRatio))
            (oceanNet (- @runoff @evap))
            (atmosNet (- @evap @precip))
            (landNet (- @precip @runoff))
            (evapW (math/clamp (+ 1 (* @evap @config.fluxWidthScale)) 1 10))
            (condW (math/clamp (+ 1 (* @condensation @config.fluxWidthScale)) 1 10))
            (precipW (math/clamp (+ 1 (* @precip @config.fluxWidthScale)) 1 10))
            (runoffW (math/clamp (+ 1 (* @runoff @config.fluxWidthScale)) 1 10))
            (oceanCfg (array/nth @config.reservoirs 0))
            (atmosphereCfg (array/nth @config.reservoirs 1))
            (landCfg (array/nth @config.reservoirs 2))
            (oceanX (* @config.width 0.25))
            (oceanY (- @config.height 90))
            (atmosphereX (/ @config.width 2))
            (atmosphereY 90)
            (landX (* @config.width 0.78))
            (landY (- @config.height 100))
            (reservoirNodes [
                { id: (object/get @oceanCfg id), x: @oceanX, y: @oceanY, radius: (object/get @oceanCfg radius), color: (object/get @oceanCfg color), label: (object/get @oceanCfg label) },
                { id: (object/get @atmosphereCfg id), x: @atmosphereX, y: @atmosphereY, radius: (object/get @atmosphereCfg radius), color: (object/get @atmosphereCfg color), label: (object/get @atmosphereCfg label) },
                { id: (object/get @landCfg id), x: @landX, y: @landY, radius: (object/get @landCfg radius), color: (object/get @landCfg color), label: (object/get @landCfg label) }
              ])
            (fluxShapes [
                { type: line, x1: @oceanX, y1: (- @oceanY 40), x2: (- @atmosphereX 40), y2: (+ @atmosphereY 50), color: "#0ea5e9", lineWidth: @evapW },
                { type: line, x1: @atmosphereX, y1: (+ @atmosphereY 10), x2: @atmosphereX, y2: (- @atmosphereY 30), color: "#94a3b8", lineWidth: @condW },
                { type: line, x1: (+ @atmosphereX 30), y1: (+ @atmosphereY 40), x2: (- @landX 20), y2: (- @landY 40), color: "#2563eb", lineWidth: @precipW },
                { type: line, x1: @landX, y1: @landY, x2: (+ @oceanX 60), y2: @oceanY, color: "#166534", lineWidth: @runoffW }
              ])
            (oceanReadout (str/concat "Ocean — evaporation out " (math/round @evap 1) ", runoff in " (math/round @runoff 1) ", net " (math/round @oceanNet 1)))
            (atmosphereReadout (str/concat "Atmosphere — evaporation in " (math/round @evap 1) ", condensation " (math/round @condensation 1) ", precipitation out " (math/round @precip 1) ", net " (math/round @atmosNet 1)))
            (landReadout (str/concat "Land — precipitation in " (math/round @precip 1) ", runoff out " (math/round @runoff 1) ", net " (math/round @landNet 1)))
          )
          (do
            (set @entity.evaporationFlux @evap)
            (set @entity.condensationFlux @condensation)
            (set @entity.precipitationFlux @precip)
            (set @entity.runoffFlux @runoff)
            (set @entity.oceanReadout @oceanReadout)
            (set @entity.atmosphereReadout @atmosphereReadout)
            (set @entity.landReadout @landReadout)
            (set @entity.edges [])
            (set @entity.nodes @reservoirNodes)
            (set @entity.shapes @fluxShapes)
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                  { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: caption, content: (str/concat "Solar input: " @entity.solarInput "%") },
                      { type: range-slider, min: 0, max: 100, step: 1, value: @entity.solarInput, showTooltip: true, onChange: SET_SOLAR }
                    ] },
                  { type: stack, direction: horizontal, gap: sm, children: [
                      { type: button, action: STEP_CYCLE, label: "Step the Cycle", variant: primary }
                    ] },
                  { type: typography, variant: caption, content: (str/concat "Cycle step: " @entity.cycleStep) },
                  { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: body, content: @entity.oceanReadout },
                      { type: typography, variant: body, content: @entity.atmosphereReadout },
                      { type: typography, variant: body, content: @entity.landReadout }
                    ] }
                ] }
            ]
        })

      SET_SOLAR -> idle when (== @entity.active true)
        (set @entity.solarInput ?value)
        (let (
            (evap (* @config.baseEvaporationFlux (/ @entity.solarInput 100)))
            (condensation (* @evap @config.condensationRatio))
            (precip (* @condensation @config.precipitationRatio))
            (runoff (* @precip @config.runoffRatio))
            (oceanNet (- @runoff @evap))
            (atmosNet (- @evap @precip))
            (landNet (- @precip @runoff))
            (evapW (math/clamp (+ 1 (* @evap @config.fluxWidthScale)) 1 10))
            (condW (math/clamp (+ 1 (* @condensation @config.fluxWidthScale)) 1 10))
            (precipW (math/clamp (+ 1 (* @precip @config.fluxWidthScale)) 1 10))
            (runoffW (math/clamp (+ 1 (* @runoff @config.fluxWidthScale)) 1 10))
            (oceanCfg (array/nth @config.reservoirs 0))
            (atmosphereCfg (array/nth @config.reservoirs 1))
            (landCfg (array/nth @config.reservoirs 2))
            (oceanX (* @config.width 0.25))
            (oceanY (- @config.height 90))
            (atmosphereX (/ @config.width 2))
            (atmosphereY 90)
            (landX (* @config.width 0.78))
            (landY (- @config.height 100))
            (reservoirNodes [
                { id: (object/get @oceanCfg id), x: @oceanX, y: @oceanY, radius: (object/get @oceanCfg radius), color: (object/get @oceanCfg color), label: (object/get @oceanCfg label) },
                { id: (object/get @atmosphereCfg id), x: @atmosphereX, y: @atmosphereY, radius: (object/get @atmosphereCfg radius), color: (object/get @atmosphereCfg color), label: (object/get @atmosphereCfg label) },
                { id: (object/get @landCfg id), x: @landX, y: @landY, radius: (object/get @landCfg radius), color: (object/get @landCfg color), label: (object/get @landCfg label) }
              ])
            (fluxShapes [
                { type: line, x1: @oceanX, y1: (- @oceanY 40), x2: (- @atmosphereX 40), y2: (+ @atmosphereY 50), color: "#0ea5e9", lineWidth: @evapW },
                { type: line, x1: @atmosphereX, y1: (+ @atmosphereY 10), x2: @atmosphereX, y2: (- @atmosphereY 30), color: "#94a3b8", lineWidth: @condW },
                { type: line, x1: (+ @atmosphereX 30), y1: (+ @atmosphereY 40), x2: (- @landX 20), y2: (- @landY 40), color: "#2563eb", lineWidth: @precipW },
                { type: line, x1: @landX, y1: @landY, x2: (+ @oceanX 60), y2: @oceanY, color: "#166534", lineWidth: @runoffW }
              ])
            (oceanReadout (str/concat "Ocean — evaporation out " (math/round @evap 1) ", runoff in " (math/round @runoff 1) ", net " (math/round @oceanNet 1)))
            (atmosphereReadout (str/concat "Atmosphere — evaporation in " (math/round @evap 1) ", condensation " (math/round @condensation 1) ", precipitation out " (math/round @precip 1) ", net " (math/round @atmosNet 1)))
            (landReadout (str/concat "Land — precipitation in " (math/round @precip 1) ", runoff out " (math/round @runoff 1) ", net " (math/round @landNet 1)))
          )
          (do
            (set @entity.evaporationFlux @evap)
            (set @entity.condensationFlux @condensation)
            (set @entity.precipitationFlux @precip)
            (set @entity.runoffFlux @runoff)
            (set @entity.oceanReadout @oceanReadout)
            (set @entity.atmosphereReadout @atmosphereReadout)
            (set @entity.landReadout @landReadout)
            (set @entity.nodes @reservoirNodes)
            (set @entity.edges [])
            (set @entity.shapes @fluxShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Solar input: " @entity.solarInput "%") },
                    { type: range-slider, min: 0, max: 100, step: 1, value: @entity.solarInput, showTooltip: true, onChange: SET_SOLAR }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_CYCLE, label: "Step the Cycle", variant: primary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Cycle step: " @entity.cycleStep) },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: body, content: @entity.oceanReadout },
                    { type: typography, variant: body, content: @entity.atmosphereReadout },
                    { type: typography, variant: body, content: @entity.landReadout }
                  ] }
              ] }
          ]
        })
        (emit WATERCYCLE_UPDATED { solarInput: @entity.solarInput, cycleStep: @entity.cycleStep, evaporationFlux: @entity.evaporationFlux, condensationFlux: @entity.condensationFlux, precipitationFlux: @entity.precipitationFlux, runoffFlux: @entity.runoffFlux })

      STEP_CYCLE -> idle when (== @entity.active true)
        (set @entity.solarInput (math/clamp (+ @entity.solarInput @config.solarStepDelta) 0 100))
        (set @entity.cycleStep (+ @entity.cycleStep 1))
        (let (
            (evap (* @config.baseEvaporationFlux (/ @entity.solarInput 100)))
            (condensation (* @evap @config.condensationRatio))
            (precip (* @condensation @config.precipitationRatio))
            (runoff (* @precip @config.runoffRatio))
            (oceanNet (- @runoff @evap))
            (atmosNet (- @evap @precip))
            (landNet (- @precip @runoff))
            (evapW (math/clamp (+ 1 (* @evap @config.fluxWidthScale)) 1 10))
            (condW (math/clamp (+ 1 (* @condensation @config.fluxWidthScale)) 1 10))
            (precipW (math/clamp (+ 1 (* @precip @config.fluxWidthScale)) 1 10))
            (runoffW (math/clamp (+ 1 (* @runoff @config.fluxWidthScale)) 1 10))
            (oceanCfg (array/nth @config.reservoirs 0))
            (atmosphereCfg (array/nth @config.reservoirs 1))
            (landCfg (array/nth @config.reservoirs 2))
            (oceanX (* @config.width 0.25))
            (oceanY (- @config.height 90))
            (atmosphereX (/ @config.width 2))
            (atmosphereY 90)
            (landX (* @config.width 0.78))
            (landY (- @config.height 100))
            (reservoirNodes [
                { id: (object/get @oceanCfg id), x: @oceanX, y: @oceanY, radius: (object/get @oceanCfg radius), color: (object/get @oceanCfg color), label: (object/get @oceanCfg label) },
                { id: (object/get @atmosphereCfg id), x: @atmosphereX, y: @atmosphereY, radius: (object/get @atmosphereCfg radius), color: (object/get @atmosphereCfg color), label: (object/get @atmosphereCfg label) },
                { id: (object/get @landCfg id), x: @landX, y: @landY, radius: (object/get @landCfg radius), color: (object/get @landCfg color), label: (object/get @landCfg label) }
              ])
            (fluxShapes [
                { type: line, x1: @oceanX, y1: (- @oceanY 40), x2: (- @atmosphereX 40), y2: (+ @atmosphereY 50), color: "#0ea5e9", lineWidth: @evapW },
                { type: line, x1: @atmosphereX, y1: (+ @atmosphereY 10), x2: @atmosphereX, y2: (- @atmosphereY 30), color: "#94a3b8", lineWidth: @condW },
                { type: line, x1: (+ @atmosphereX 30), y1: (+ @atmosphereY 40), x2: (- @landX 20), y2: (- @landY 40), color: "#2563eb", lineWidth: @precipW },
                { type: line, x1: @landX, y1: @landY, x2: (+ @oceanX 60), y2: @oceanY, color: "#166534", lineWidth: @runoffW }
              ])
            (oceanReadout (str/concat "Ocean — evaporation out " (math/round @evap 1) ", runoff in " (math/round @runoff 1) ", net " (math/round @oceanNet 1)))
            (atmosphereReadout (str/concat "Atmosphere — evaporation in " (math/round @evap 1) ", condensation " (math/round @condensation 1) ", precipitation out " (math/round @precip 1) ", net " (math/round @atmosNet 1)))
            (landReadout (str/concat "Land — precipitation in " (math/round @precip 1) ", runoff out " (math/round @runoff 1) ", net " (math/round @landNet 1)))
          )
          (do
            (set @entity.evaporationFlux @evap)
            (set @entity.condensationFlux @condensation)
            (set @entity.precipitationFlux @precip)
            (set @entity.runoffFlux @runoff)
            (set @entity.oceanReadout @oceanReadout)
            (set @entity.atmosphereReadout @atmosphereReadout)
            (set @entity.landReadout @landReadout)
            (set @entity.nodes @reservoirNodes)
            (set @entity.edges [])
            (set @entity.shapes @fluxShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Solar input: " @entity.solarInput "%") },
                    { type: range-slider, min: 0, max: 100, step: 1, value: @entity.solarInput, showTooltip: true, onChange: SET_SOLAR }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: STEP_CYCLE, label: "Step the Cycle", variant: primary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Cycle step: " @entity.cycleStep) },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: body, content: @entity.oceanReadout },
                    { type: typography, variant: body, content: @entity.atmosphereReadout },
                    { type: typography, variant: body, content: @entity.landReadout }
                  ] }
              ] }
          ]
        })
        (emit WATERCYCLE_UPDATED { solarInput: @entity.solarInput, cycleStep: @entity.cycleStep, evaporationFlux: @entity.evaporationFlux, condensationFlux: @entity.condensationFlux, precipitationFlux: @entity.precipitationFlux, runoffFlux: @entity.runoffFlux })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_SOLAR {
        value : number
      }
        @description "Learner adjusted the solar input slider."
        @tier "domain"
      STEP_CYCLE {
      }
        @description "Learner pressed Step the Cycle to advance the water cycle one step, drifting solar input and recomputing fluxes."
        @tier "domain"
    }

    emits {
      WATERCYCLE_UPDATED -> external {
        solarInput : number
        cycleStep : number
        evaporationFlux : number
        condensationFlux : number
        precipitationFlux : number
        runoffFlux : number
      }
        @description "The water-cycle flux state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "water cycle update, hydrologic cycle, evaporation, condensation, precipitation, runoff"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Earth Lab"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#f0f9ff"
        @label "Background Color"
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 420
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      reservoirs : [EarthWatercycleReservoir] = [
        { id: "ocean", label: "Ocean", color: "#0ea5e9", radius: 70 },
        { id: "atmosphere", label: "Atmosphere", color: "#e0f2fe", radius: 55 },
        { id: "land", label: "Land", color: "#65a30d", radius: 50 }
      ]
        @label "Reservoirs"
        @description "Roster of the three water-cycle reservoirs (ocean, atmosphere, land); label/color/radius are re-themeable, positions are computed from width/height."
        @tier "domain"
      solarInput : number = 50
        @label "Solar Input"
        @description "Starting solar input (0-100) driving evaporation."
        @tier "domain"
      solarStepDelta : number = 15
        @label "Solar Step Delta"
        @description "How much solar input changes per Step the Cycle press."
        @tier "domain"
      baseEvaporationFlux : number = 40
        @label "Base Evaporation Flux"
        @description "Evaporation flux at 100% solar input; scales linearly down with solar input."
        @tier "domain"
      condensationRatio : number = 0.9
        @label "Condensation Ratio"
        @description "Fraction of evaporation flux that condenses in the atmosphere."
        @tier "domain"
      precipitationRatio : number = 0.95
        @label "Precipitation Ratio"
        @description "Fraction of condensation flux that falls as precipitation."
        @tier "domain"
      runoffRatio : number = 0.3
        @label "Runoff Ratio"
        @description "Fraction of precipitation flux that runs off land back to the ocean."
        @tier "domain"
      fluxWidthScale : number = 0.15
        @label "Flux Width Scale"
        @description "Pixels of arrow line-width added per unit of flux, for the flux-arrow re-scaling."
        @tier "presentation"
    }
  }

  page "/earth-watercycle" as EarthWatercyclePage -> EarthWatercycleSim
}
