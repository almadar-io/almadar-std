app std-civics-gerrymander "1.0.0"
"Gerrymandering sandbox — assign precincts on a grid to districts, then evaluate seats won and the efficiency gap to see packing and cracking in action, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital CivicsGerrymanderOrbital {
  type CivicsGerryShapePoint = {
    x : number!
    y : number!
  }
  type CivicsGerryShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [CivicsGerryShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type CivicsGerryPrecinct = {
    id : string!
    row : number!
    col : number!
    party : "A" | "B"!
  }
  type CivicsGerryDistrict = {
    index : number!
    label : string!
    color : string!
  }

  entity CivicsGerrymanderScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    assignments : [json]
    evaluated : boolean
    seatsA : number
    seatsB : number
    wastedA : number
    wastedB : number
    efficiencyGap : number
    gapNote : string
    renderChildren : [json]
  }

  trait CivicsGerrymanderSim -> @rebindable CivicsGerrymanderScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.evaluated false)
        (set @entity.seatsA 0)
        (set @entity.seatsB 0)
        (set @entity.wastedA 0)
        (set @entity.wastedB 0)
        (set @entity.efficiencyGap 0)
        (let (
            (assignments (array/map @config.grid (fn p { id: (object/get @p id), district: (+ (object/get @p row) 1) })))
            (gapNote "Assign precincts to districts, then evaluate the map.")
            (cellRects (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
                (dist (array/first (array/filter @config.districts (fn d (== (object/get @d index) @dIndex)))))
                (dColor (object/get @dist color))
                (partyColor (if (== (object/get @p party) "A") @config.partyAColor @config.partyBColor))
              )
              { type: rect, id: (str/concat "cell-" (object/get @p id)), x: (+ 20 (* (object/get @p col) 66)), y: (+ 20 (* (object/get @p row) 66)), width: 60, height: 60, color: @dColor, fill: @partyColor, opacity: 0.9, lineWidth: 4 }))))
            (cellLabels (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
              )
              { type: text, id: (str/concat "cell-label-" (object/get @p id)), x: (+ 50 (* (object/get @p col) 66)), y: (+ 50 (* (object/get @p row) 66)), text: (str/concat (object/get @p id) " · D" @dIndex), fontSize: 11, align: "center", color: "#ffffff" }))))
            (shapes (array/concat @cellRects @cellLabels))
            (rowStacks (array/map (array/range @config.gridSize) (fn r
              { type: stack, direction: horizontal, gap: sm, children: (array/map (array/filter @config.grid (fn p (== (object/get @p row) @r))) (fn p
                { type: button, action: ASSIGN_PRECINCT, actionPayload: { id: (object/get @p id) }, label: (object/get @p id), variant: secondary })) })))
            (children (array/concat (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Each precinct votes A or B. Reassign precincts to districts to pack or crack the vote, then evaluate." }
              ] @rowStacks) [
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "Seats — A " @entity.seatsA " · B " @entity.seatsB), variant: info },
                    { type: badge, label: (str/concat "Efficiency gap " @entity.efficiencyGap " pp"), variant: info },
                    { type: button, action: EVALUATE, label: "Evaluate Map", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: @gapNote }
              ]))
          )
          (do
            (set @entity.assignments @assignments)
            (set @entity.gapNote @gapNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit GERRYMANDER_UPDATED { seatsA: @entity.seatsA, seatsB: @entity.seatsB, wastedA: @entity.wastedA, wastedB: @entity.wastedB, efficiencyGap: @entity.efficiencyGap, evaluated: @entity.evaluated })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.evaluated false)
        (set @entity.seatsA 0)
        (set @entity.seatsB 0)
        (set @entity.wastedA 0)
        (set @entity.wastedB 0)
        (set @entity.efficiencyGap 0)
        (let (
            (assignments (array/map @config.grid (fn p { id: (object/get @p id), district: (+ (object/get @p row) 1) })))
            (gapNote "Assign precincts to districts, then evaluate the map.")
            (cellRects (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
                (dist (array/first (array/filter @config.districts (fn d (== (object/get @d index) @dIndex)))))
                (dColor (object/get @dist color))
                (partyColor (if (== (object/get @p party) "A") @config.partyAColor @config.partyBColor))
              )
              { type: rect, id: (str/concat "cell-" (object/get @p id)), x: (+ 20 (* (object/get @p col) 66)), y: (+ 20 (* (object/get @p row) 66)), width: 60, height: 60, color: @dColor, fill: @partyColor, opacity: 0.9, lineWidth: 4 }))))
            (cellLabels (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
              )
              { type: text, id: (str/concat "cell-label-" (object/get @p id)), x: (+ 50 (* (object/get @p col) 66)), y: (+ 50 (* (object/get @p row) 66)), text: (str/concat (object/get @p id) " · D" @dIndex), fontSize: 11, align: "center", color: "#ffffff" }))))
            (shapes (array/concat @cellRects @cellLabels))
            (rowStacks (array/map (array/range @config.gridSize) (fn r
              { type: stack, direction: horizontal, gap: sm, children: (array/map (array/filter @config.grid (fn p (== (object/get @p row) @r))) (fn p
                { type: button, action: ASSIGN_PRECINCT, actionPayload: { id: (object/get @p id) }, label: (object/get @p id), variant: secondary })) })))
            (children (array/concat (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Each precinct votes A or B. Reassign precincts to districts to pack or crack the vote, then evaluate." }
              ] @rowStacks) [
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "Seats — A " @entity.seatsA " · B " @entity.seatsB), variant: info },
                    { type: badge, label: (str/concat "Efficiency gap " @entity.efficiencyGap " pp"), variant: info },
                    { type: button, action: EVALUATE, label: "Evaluate Map", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: @gapNote }
              ]))
          )
          (do
            (set @entity.assignments @assignments)
            (set @entity.gapNote @gapNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit GERRYMANDER_UPDATED { seatsA: @entity.seatsA, seatsB: @entity.seatsB, wastedA: @entity.wastedA, wastedB: @entity.wastedB, efficiencyGap: @entity.efficiencyGap, evaluated: @entity.evaluated })

      ASSIGN_PRECINCT -> idle when (== @entity.active true)
        (let (
            (curAsg (array/first (array/filter @entity.assignments (fn a (== (object/get @a id) ?id)))))
            (curD (if (== @curAsg null) 1 (object/get @curAsg district)))
            (newD (if (>= @curD @config.districtCount) 1 (+ @curD 1)))
            (assignments (array/map @entity.assignments (fn a (if (== (object/get @a id) ?id) { id: ?id, district: @newD } @a))))
            (gapNote "Map changed — seats and efficiency gap are stale; evaluate again.")
            (cellRects (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
                (dist (array/first (array/filter @config.districts (fn d (== (object/get @d index) @dIndex)))))
                (dColor (object/get @dist color))
                (partyColor (if (== (object/get @p party) "A") @config.partyAColor @config.partyBColor))
              )
              { type: rect, id: (str/concat "cell-" (object/get @p id)), x: (+ 20 (* (object/get @p col) 66)), y: (+ 20 (* (object/get @p row) 66)), width: 60, height: 60, color: @dColor, fill: @partyColor, opacity: 0.9, lineWidth: 4 }))))
            (cellLabels (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
              )
              { type: text, id: (str/concat "cell-label-" (object/get @p id)), x: (+ 50 (* (object/get @p col) 66)), y: (+ 50 (* (object/get @p row) 66)), text: (str/concat (object/get @p id) " · D" @dIndex), fontSize: 11, align: "center", color: "#ffffff" }))))
            (shapes (array/concat @cellRects @cellLabels))
            (rowStacks (array/map (array/range @config.gridSize) (fn r
              { type: stack, direction: horizontal, gap: sm, children: (array/map (array/filter @config.grid (fn p (== (object/get @p row) @r))) (fn p
                { type: button, action: ASSIGN_PRECINCT, actionPayload: { id: (object/get @p id) }, label: (object/get @p id), variant: secondary })) })))
            (children (array/concat (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Each precinct votes A or B. Reassign precincts to districts to pack or crack the vote, then evaluate." }
              ] @rowStacks) [
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "Seats — A " @entity.seatsA " · B " @entity.seatsB), variant: info },
                    { type: badge, label: (str/concat "Efficiency gap " @entity.efficiencyGap " pp"), variant: info },
                    { type: button, action: EVALUATE, label: "Evaluate Map", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: @gapNote }
              ]))
          )
          (do
            (set @entity.assignments @assignments)
            (set @entity.evaluated false)
            (set @entity.gapNote @gapNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit GERRYMANDER_UPDATED { seatsA: @entity.seatsA, seatsB: @entity.seatsB, wastedA: @entity.wastedA, wastedB: @entity.wastedB, efficiencyGap: @entity.efficiencyGap, evaluated: @entity.evaluated })

      EVALUATE -> idle when (== @entity.active true)
        (let (
            (result (array/reduce @config.districts
              { seatsA: 0, seatsB: 0, wastedA: 0, wastedB: 0 }
              (fn (acc d) (let (
                (dIndex (object/get @d index))
                (inD (array/filter @config.grid (fn p (let (
                    (asg (array/first (array/filter @entity.assignments (fn a (== (object/get @a id) (object/get @p id))))))
                  )
                  (== (object/get @asg district) @dIndex)))))
                (total (array/len @inD))
                (aVotes (array/len (array/filter @inD (fn p (== (object/get @p party) "A")))))
                (bVotes (- @total @aVotes))
                (aWins (> @aVotes @bVotes))
                (bWins (> @bVotes @aVotes))
                (needed (+ (math/floor (/ @total 2)) 1))
                (wA (if @aWins (- @aVotes @needed) @aVotes))
                (wB (if @bWins (- @bVotes @needed) @bVotes))
                (seatA (if @aWins 1 0))
                (seatB (if @bWins 1 0))
              )
              { seatsA: (+ (object/get @acc seatsA) @seatA), seatsB: (+ (object/get @acc seatsB) @seatB), wastedA: (+ (object/get @acc wastedA) @wA), wastedB: (+ (object/get @acc wastedB) @wB) }))))
            (seatsA (object/get @result seatsA))
            (seatsB (object/get @result seatsB))
            (wastedA (object/get @result wastedA))
            (wastedB (object/get @result wastedB))
            (totalVotes (array/len @config.grid))
            (efficiencyGap (math/round (* (/ (- @wastedA @wastedB) @totalVotes) 100) 1))
            (gapNote (if (> @efficiencyGap 0) "Positive gap — A's votes are wasted more (packed or cracked): the map favors B." (if (< @efficiencyGap 0) "Negative gap — B's votes are wasted more: the map favors A." "Zero gap — votes are wasted evenly; no seat bias.")))
            (cellRects (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @entity.assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
                (dist (array/first (array/filter @config.districts (fn d (== (object/get @d index) @dIndex)))))
                (dColor (object/get @dist color))
                (partyColor (if (== (object/get @p party) "A") @config.partyAColor @config.partyBColor))
              )
              { type: rect, id: (str/concat "cell-" (object/get @p id)), x: (+ 20 (* (object/get @p col) 66)), y: (+ 20 (* (object/get @p row) 66)), width: 60, height: 60, color: @dColor, fill: @partyColor, opacity: 0.9, lineWidth: 4 }))))
            (cellLabels (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @entity.assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
              )
              { type: text, id: (str/concat "cell-label-" (object/get @p id)), x: (+ 50 (* (object/get @p col) 66)), y: (+ 50 (* (object/get @p row) 66)), text: (str/concat (object/get @p id) " · D" @dIndex), fontSize: 11, align: "center", color: "#ffffff" }))))
            (shapes (array/concat @cellRects @cellLabels))
            (rowStacks (array/map (array/range @config.gridSize) (fn r
              { type: stack, direction: horizontal, gap: sm, children: (array/map (array/filter @config.grid (fn p (== (object/get @p row) @r))) (fn p
                { type: button, action: ASSIGN_PRECINCT, actionPayload: { id: (object/get @p id) }, label: (object/get @p id), variant: secondary })) })))
            (children (array/concat (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Each precinct votes A or B. Reassign precincts to districts to pack or crack the vote, then evaluate." }
              ] @rowStacks) [
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "Seats — A " @seatsA " · B " @seatsB), variant: (if (> @seatsA @seatsB) "success" "info") },
                    { type: badge, label: (str/concat "Efficiency gap " @efficiencyGap " pp"), variant: info },
                    { type: button, action: EVALUATE, label: "Evaluate Map", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: @gapNote }
              ]))
          )
          (do
            (set @entity.evaluated true)
            (set @entity.seatsA @seatsA)
            (set @entity.seatsB @seatsB)
            (set @entity.wastedA @wastedA)
            (set @entity.wastedB @wastedB)
            (set @entity.efficiencyGap @efficiencyGap)
            (set @entity.gapNote @gapNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit GERRYMANDER_UPDATED { seatsA: @entity.seatsA, seatsB: @entity.seatsB, wastedA: @entity.wastedA, wastedB: @entity.wastedB, efficiencyGap: @entity.efficiencyGap, evaluated: @entity.evaluated })

      RESET -> idle when (== @entity.active true)
        (let (
            (assignments (array/map @config.grid (fn p { id: (object/get @p id), district: (+ (object/get @p row) 1) })))
            (gapNote "Assign precincts to districts, then evaluate the map.")
            (cellRects (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
                (dist (array/first (array/filter @config.districts (fn d (== (object/get @d index) @dIndex)))))
                (dColor (object/get @dist color))
                (partyColor (if (== (object/get @p party) "A") @config.partyAColor @config.partyBColor))
              )
              { type: rect, id: (str/concat "cell-" (object/get @p id)), x: (+ 20 (* (object/get @p col) 66)), y: (+ 20 (* (object/get @p row) 66)), width: 60, height: 60, color: @dColor, fill: @partyColor, opacity: 0.9, lineWidth: 4 }))))
            (cellLabels (array/map @config.grid (fn p (let (
                (asg (array/first (array/filter @assignments (fn a (== (object/get @a id) (object/get @p id))))))
                (dIndex (object/get @asg district))
              )
              { type: text, id: (str/concat "cell-label-" (object/get @p id)), x: (+ 50 (* (object/get @p col) 66)), y: (+ 50 (* (object/get @p row) 66)), text: (str/concat (object/get @p id) " · D" @dIndex), fontSize: 11, align: "center", color: "#ffffff" }))))
            (shapes (array/concat @cellRects @cellLabels))
            (rowStacks (array/map (array/range @config.gridSize) (fn r
              { type: stack, direction: horizontal, gap: sm, children: (array/map (array/filter @config.grid (fn p (== (object/get @p row) @r))) (fn p
                { type: button, action: ASSIGN_PRECINCT, actionPayload: { id: (object/get @p id) }, label: (object/get @p id), variant: secondary })) })))
            (children (array/concat (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Each precinct votes A or B. Reassign precincts to districts to pack or crack the vote, then evaluate." }
              ] @rowStacks) [
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: "Seats — A 0 · B 0", variant: info },
                    { type: badge, label: "Efficiency gap 0 pp", variant: info },
                    { type: button, action: EVALUATE, label: "Evaluate Map", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: @gapNote }
              ]))
          )
          (do
            (set @entity.assignments @assignments)
            (set @entity.evaluated false)
            (set @entity.seatsA 0)
            (set @entity.seatsB 0)
            (set @entity.wastedA 0)
            (set @entity.wastedB 0)
            (set @entity.efficiencyGap 0)
            (set @entity.gapNote @gapNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit GERRYMANDER_UPDATED { seatsA: @entity.seatsA, seatsB: @entity.seatsB, wastedA: @entity.wastedA, wastedB: @entity.wastedB, efficiencyGap: @entity.efficiencyGap, evaluated: @entity.evaluated })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      ASSIGN_PRECINCT {
        id : string
      }
        @description "Learner cycled one precinct's district assignment (1..districtCount, wrapping)."
        @tier "domain"
      EVALUATE {
      }
        @description "Learner asked to score the current map: seats per party, wasted votes, and the efficiency gap."
        @tier "domain"
      RESET {
      }
        @description "Learner reset precincts to the baseline row-band districts."
        @tier "domain"
    }

    emits {
      GERRYMANDER_UPDATED -> external {
        seatsA : number
        seatsB : number
        wastedA : number
        wastedB : number
        efficiencyGap : number
        evaluated : boolean
      }
        @description "The districting state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "redistricting, gerrymander, packing, cracking, wasted votes, efficiency gap, seats won, district map"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Civics Lab"
        @label "Title"
        @description "Title shown above the lab."
        @tier "presentation"
      width : number = 420
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      gridSize : number = 5
        @label "Grid Size"
        @description "The precinct grid is gridSize x gridSize; also the number of precinct button rows."
        @tier "domain"
      districtCount : number = 5
        @label "District Count"
        @description "How many districts the precincts are divided into — the number of seats up for grabs."
        @synonyms "districts, seats, congressional districts"
        @tier "domain"
      partyShare : number = 0.44
        @label "Party A Vote Share"
        @description "Share of precincts voting party A in the grid — the minority party the learner tries to pack or crack."
        @synonyms "vote share, party strength, minority party"
        @tier "domain"
      districts : [CivicsGerryDistrict] = [
        { index: 1, label: "District 1", color: "#f97316" },
        { index: 2, label: "District 2", color: "#22c55e" },
        { index: 3, label: "District 3", color: "#a855f7" },
        { index: 4, label: "District 4", color: "#eab308" },
        { index: 5, label: "District 5", color: "#14b8a6" }
      ]
        @label "Districts"
        @description "District roster with palette colors; each precinct's district assignment is drawn as a colored border."
        @tier "domain"
      grid : [CivicsGerryPrecinct] = [
        { id: "P01", row: 0, col: 0, party: A }, { id: "P02", row: 0, col: 1, party: A }, { id: "P03", row: 0, col: 2, party: B }, { id: "P04", row: 0, col: 3, party: B }, { id: "P05", row: 0, col: 4, party: B },
        { id: "P06", row: 1, col: 0, party: A }, { id: "P07", row: 1, col: 1, party: A }, { id: "P08", row: 1, col: 2, party: B }, { id: "P09", row: 1, col: 3, party: B }, { id: "P10", row: 1, col: 4, party: B },
        { id: "P11", row: 2, col: 0, party: B }, { id: "P12", row: 2, col: 1, party: B }, { id: "P13", row: 2, col: 2, party: B }, { id: "P14", row: 2, col: 3, party: B }, { id: "P15", row: 2, col: 4, party: B },
        { id: "P16", row: 3, col: 0, party: A }, { id: "P17", row: 3, col: 1, party: A }, { id: "P18", row: 3, col: 2, party: A }, { id: "P19", row: 3, col: 3, party: B }, { id: "P20", row: 3, col: 4, party: B },
        { id: "P21", row: 4, col: 0, party: A }, { id: "P22", row: 4, col: 1, party: A }, { id: "P23", row: 4, col: 2, party: A }, { id: "P24", row: 4, col: 3, party: A }, { id: "P25", row: 4, col: 4, party: B }
      ]
        @label "Precinct Grid"
        @description "The 5x5 precinct map; each precinct always votes its party. The baseline assigns row bands as districts, giving B a 3-2 seat edge despite A's 44% vote share."
        @synonyms "precincts, ward map, voter grid, packing and cracking board"
        @tier "domain"
      partyAColor : string = "#2563eb"
        @label "Party A Color"
        @description "Fill color for precincts voting party A."
        @tier "presentation"
      partyBColor : string = "#dc2626"
        @label "Party B Color"
        @description "Fill color for precincts voting party B."
        @tier "presentation"
    }
  }

  page "/civics-gerrymander" as CivicsGerrymanderPage -> CivicsGerrymanderSim
}
