app std-algo-bst "1.0.0"
"BST builder — inserts values one by one, each descends left/right by comparison and attaches as a leaf; traversals (in/pre/level-order) replay as a highlighted sweep; renders biology-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital BstEngineOrbital {
  type GraphNode = {
    id : string!
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
  }
  type GraphEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type TreeEntry = {
    id : string!
    value : number!
    x : number!
    path : string
    levelKey : number
  }

  entity BstState [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [GraphNode]
    edges : [GraphEdge]
    entries : [TreeEntry]
    cursor : number = 0
    pending : number = 0
    descending : boolean = false
    curId : string = ""
    curVal : number = 0
    curX : number = 0
    curOffset : number = 0
    depth : number = 0
    maxDepth : number = 0
    count : number = 0
    narration : string
  }

  trait BstSim -> @rebindable BstState [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.nodes [])
        (set @entity.edges [])
        (set @entity.entries [])
        (set @entity.cursor 0)
        (set @entity.descending false)
        (set @entity.depth 0)
        (set @entity.maxDepth 0)
        (set @entity.count 0)
        (set @entity.narration "Press Insert to add the next value; keep pressing to watch it descend.")
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: INSERT_VALUE, label: "Insert", variant: primary },
                    { type: button, action: DELETE_VALUE, label: "Delete", variant: secondary },
                    { type: button, action: RUN_TRAVERSAL, label: "Traverse", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit BST_UPDATED { nodes: @entity.nodes, edges: @entity.edges, count: @entity.count, narration: @entity.narration })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.nodes [])
        (set @entity.edges [])
        (set @entity.entries [])
        (set @entity.cursor 0)
        (set @entity.descending false)
        (set @entity.depth 0)
        (set @entity.maxDepth 0)
        (set @entity.count 0)
        (set @entity.narration "Press Insert to add the next value; keep pressing to watch it descend.")
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: INSERT_VALUE, label: "Insert", variant: primary },
                    { type: button, action: DELETE_VALUE, label: "Delete", variant: secondary },
                    { type: button, action: RUN_TRAVERSAL, label: "Traverse", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit BST_UPDATED { nodes: @entity.nodes, edges: @entity.edges, count: @entity.count, narration: @entity.narration })

      INSERT_VALUE -> idle when (and (== @entity.active true) (or @entity.descending (< @entity.cursor (array/len @config.values))))
        (if (not @entity.descending)
          (let (
              (v (array/nth @config.values @entity.cursor))
            )
            (if (== @entity.count 0)
              (do
                (set @entity.pending @v)
                (set @entity.nodes (array/append @entity.nodes { id: "n0", x: @config.rootX, y: 60, radius: 20, color: "#3b82f6", label: (str/concat "" @v), kind: cell }))
                (set @entity.entries (array/append @entity.entries { id: "n0", value: @v, x: @config.rootX, path: "", levelKey: @config.rootX }))
                (set @entity.count 1)
                (set @entity.cursor 1)
                (set @entity.narration (str/concat "insert " (str/concat "" @v) " — tree empty, becomes root" (if @config.balanced " · height 1 for 1 node" ""))))
              (do
                (set @entity.pending @v)
                (set @entity.descending true)
                (set @entity.curId (object/get (array/first @entity.entries) id))
                (set @entity.curVal (object/get (array/first @entity.entries) value))
                (set @entity.curX @config.rootX)
                (set @entity.curOffset @config.baseOffset)
                (set @entity.depth 0)
                (set @entity.cursor (+ @entity.cursor 1))
                (set @entity.narration (str/concat "insert " (str/concat "" @v) (if @config.showComparisons " — compare at the root" ""))))))
          (let (
              (side (if (< @entity.pending @entity.curVal) "L" "R"))
              (child (array/find @entity.edges (fn e (and (== (object/get @e from) @entity.curId) (== (object/get @e label) @side)))))
              (newX (if (== @side "L") (- @entity.curX @entity.curOffset) (+ @entity.curX @entity.curOffset)))
              (newId (str/concat "n" (str/concat "" @entity.count)))
              (newDepth (+ @entity.depth 1))
              (newCount (+ @entity.count 1))
              (newMax (math/max @entity.maxDepth @newDepth))
              (cmpText (str/concat (str/concat "" @entity.pending) (if (== @side "L") " < " " >= ") (str/concat "" @entity.curVal)))
            )
            (if (== @child null)
              (do
                (set @entity.narration (str/concat (if @config.showComparisons (str/concat @cmpText " — ") "") "attach " (str/concat "" @entity.pending) " as a leaf" (if @config.balanced (str/concat " · height " (str/concat "" (+ @newMax 1)) " for " (str/concat "" @newCount) " nodes") "")))
                (set @entity.nodes (array/append @entity.nodes { id: @newId, x: @newX, y: (+ 60 (* @newDepth @config.levelGap)), radius: 20, color: "#3b82f6", label: (str/concat "" @entity.pending), kind: cell }))
                (set @entity.edges (array/append @entity.edges { from: @entity.curId, to: @newId, color: "#9ca3af", label: @side }))
                (set @entity.entries (array/append @entity.entries { id: @newId, value: @entity.pending, x: @newX, path: (str/concat (object/get (array/find @entity.entries (fn t (== (object/get @t id) @entity.curId))) path) @side), levelKey: (+ (* @newDepth 10000) @newX) }))
                (set @entity.count @newCount)
                (set @entity.maxDepth @newMax)
                (set @entity.descending false))
              (do
                (set @entity.narration (str/concat (if @config.showComparisons (str/concat @cmpText " — ") "") "descend " (if (== @side "L") "left" "right")))
                (set @entity.curId (object/get @child to))
                (set @entity.curVal (object/get (array/find @entity.entries (fn t (== (object/get @t id) (object/get @child to)))) value))
                (set @entity.curX (object/get (array/find @entity.entries (fn t (== (object/get @t id) (object/get @child to)))) x))
                (set @entity.curOffset (/ @entity.curOffset 2))
                (set @entity.depth @newDepth)))))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: INSERT_VALUE, label: "Insert", variant: primary },
                    { type: button, action: DELETE_VALUE, label: "Delete", variant: secondary },
                    { type: button, action: RUN_TRAVERSAL, label: "Traverse", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit BST_UPDATED { nodes: @entity.nodes, edges: @entity.edges, count: @entity.count, narration: @entity.narration })

      DELETE_VALUE -> idle when (and (== @entity.active true) (> @entity.count 0))
        (let (
            (lastId (object/get (array/last @entity.entries) id))
            (lastVal (object/get (array/last @entity.entries) value))
          )
          (do
            (set @entity.nodes (array/filter @entity.nodes (fn n (!= (object/get @n id) @lastId))))
            (set @entity.edges (array/filter @entity.edges (fn e (and (!= (object/get @e to) @lastId) (!= (object/get @e from) @lastId)))))
            (set @entity.entries (array/filter @entity.entries (fn t (!= (object/get @t id) @lastId))))
            (set @entity.count (- @entity.count 1))
            (set @entity.cursor (math/max (- @entity.cursor 1) 0))
            (set @entity.descending false)
            (set @entity.narration (str/concat "remove " (str/concat "" @lastVal) " — the most recently inserted value (undo); press Insert to re-insert"))))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: INSERT_VALUE, label: "Insert", variant: primary },
                    { type: button, action: DELETE_VALUE, label: "Delete", variant: secondary },
                    { type: button, action: RUN_TRAVERSAL, label: "Traverse", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit BST_UPDATED { nodes: @entity.nodes, edges: @entity.edges, count: @entity.count, narration: @entity.narration })

      RUN_TRAVERSAL -> idle when (and (== @entity.active true) (> @entity.count 0))
        (let (
            (sorted (if (== @config.traversalKind "preorder")
                      (array/sort @entity.entries "path" "asc")
                      (if (== @config.traversalKind "levelorder")
                        (array/sort @entity.entries "levelKey" "asc")
                        (array/sort @entity.entries "x" "asc"))))
            (seq (str/join (array/map @sorted (fn t (str/concat "" (object/get @t value)))) " -> "))
          )
          (do
            (set @entity.nodes (array/map @entity.nodes (object/merge @item { color: "#22c55e" })))
            (set @entity.narration (str/concat @config.traversalKind " traversal: " @seq))))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: INSERT_VALUE, label: "Insert", variant: primary },
                    { type: button, action: DELETE_VALUE, label: "Delete", variant: secondary },
                    { type: button, action: RUN_TRAVERSAL, label: "Traverse", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit BST_UPDATED { nodes: @entity.nodes, edges: @entity.edges, count: @entity.count, narration: @entity.narration })

      RESET -> idle when (== @entity.active true)
        (set @entity.nodes [])
        (set @entity.edges [])
        (set @entity.entries [])
        (set @entity.cursor 0)
        (set @entity.descending false)
        (set @entity.depth 0)
        (set @entity.maxDepth 0)
        (set @entity.count 0)
        (set @entity.narration "Press Insert to add the next value; keep pressing to watch it descend.")
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: INSERT_VALUE, label: "Insert", variant: primary },
                    { type: button, action: DELETE_VALUE, label: "Delete", variant: secondary },
                    { type: button, action: RUN_TRAVERSAL, label: "Traverse", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit BST_UPDATED { nodes: @entity.nodes, edges: @entity.edges, count: @entity.count, narration: @entity.narration })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
    }

    emits {
      BST_UPDATED -> external {
        nodes : [GraphNode]
        edges : [GraphEdge]
        count : number
        narration : string
      }
        @description "The tree after each insert/delete/traversal — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "binary search tree, insert, traversal, inorder, preorder, level order"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      values : [number] = [50, 30, 70, 20, 40, 60, 80]
        @label "Values"
        @description "The values INSERT_VALUE feeds into the tree, one per descent, in order."
        @synonyms "keys, nodes to insert, dataset"
        @tier "domain"
      traversalKind : string = "inorder"
        @label "Traversal Kind"
        @description "Which sweep RUN_TRAVERSAL replays — inorder (sorted order, left to right), preorder (root before children), or levelorder (breadth first, top to bottom)."
        @synonyms "traversal, in-order, pre-order, level-order, sweep"
        @tier "domain"
      showComparisons : boolean = true
        @label "Show Comparisons"
        @description "Include each left/right comparison in the narration while a value descends; turn off for a terse attach-only narration."
        @tier "presentation"
      balanced : boolean = false
        @label "Balance Readout"
        @description "When true, each insert's narration reports the tree's current height against its node count so the learner can judge balance; no auto-rotation is performed."
        @synonyms "balance, height, avl readout"
        @tier "domain"
      rootX : number = 300
        @label "Root X"
        @description "Canvas x-position of the root node."
        @tier "presentation"
      baseOffset : number = 150
        @label "Base Offset"
        @description "Horizontal distance between the root and its children; halved at each deeper level."
        @tier "presentation"
      levelGap : number = 70
        @label "Level Gap"
        @description "Vertical distance between tree levels in pixels."
        @tier "presentation"
      title : string = "Binary Search Tree"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
    }
  }

  page "/algo-bst" as BstEnginePage -> BstSim
}
