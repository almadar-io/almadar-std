app std-prob-trials "1.0.0"
"Trials simulator — Roll samples one outcome from a weighted sample space and accumulates it into an observed-frequency histogram overlaid with expected-probability markers on a math-canvas; Run auto-samples on a tick. Default outcomes is a fair six-sided die; a coin flip, a weighted spinner, or any categorical distribution is just a different outcomes config. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital ProbTrialsOrbital {
  type ProbTrialsOutcome = {
    label : string!
    probability : number!
    color : string
  }
  type ProbTrialsShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbTrialsShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbTrialsShapePoint = {
    x : number!
    y : number!
  }

  entity ProbTrialsScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    counts : [number]
    total : number = 0
    running : boolean = false
    narration : string
    shapes : [ProbTrialsShape]
  }

  trait ProbTrialsSim -> @rebindable ProbTrialsScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (let (
            (n (array/len @config.outcomes))
            (sumP (array/sum @config.outcomes probability))
            (expectedProbs (array/map (array/range @n) (fn i (/ (object/get (array/nth @config.outcomes @i) probability) @sumP))))
            (zeroCounts (array/map (array/range @n) (fn i 0)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (observedProps (array/map (array/range @n) (fn i 0)))
            (maxExpected (math/max (array/max @expectedProbs) 0.0001))
            (maxObserved (math/max (array/max @observedProps) 0.0001))
            (maxVal (* (math/max @maxExpected @maxObserved) 1.25))
            (barW (/ @plotW @n))
            (barShapes (array/map (array/range @n) (fn i (let ((barH (* (/ (array/nth @observedProps @i) @maxVal) @plotH)) (outcome (array/nth @config.outcomes @i))) { type: "rect", x: (+ 24 (* @i @barW)), y: (- (+ 24 @plotH) @barH), width: (* @barW 0.6), height: @barH, fill: (object/get @outcome color), opacity: 0.85, lineWidth: 0 }))))
            (expectedShapes (array/map (array/range @n) (fn i { type: "circle", x: (+ 24 (* (+ @i 0.5) @barW)), y: (- (+ 24 @plotH) (* (/ (array/nth @expectedProbs @i) @maxVal) @plotH)), radius: 5, fill: "#111827", lineWidth: 0 })))
            (labelShapes (array/map (array/range @n) (fn i (let ((outcome (array/nth @config.outcomes @i))) { type: "text", x: (+ 24 (* (+ @i 0.5) @barW)), y: (+ (+ 24 @plotH) 16), text: (str/concat (object/get @outcome label) ": " (str/concat "" (array/nth @zeroCounts @i))), fontSize: 11, align: "center", color: "#111827" }))))
            (shapes (array/concat [ { type: "line", x1: 24, y1: (+ 24 @plotH), x2: (+ 24 @plotW), y2: (+ 24 @plotH), color: "#cbd5e1", lineWidth: 1 } ] (array/concat @barShapes (array/concat @expectedShapes @labelShapes))))
          )
          (do
            (set @entity.active true)
            (set @entity.title @config.title)
            (set @entity.counts @zeroCounts)
            (set @entity.total 0)
            (set @entity.running @config.running)
            (set @entity.narration "Press Roll to sample an outcome, or Run to auto-sample.")
            (set @entity.shapes @shapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TRIAL, label: "Roll", variant: primary },
                    { type: button, action: RUN, label: "Run", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Total trials: " (str/concat "" @entity.total)) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: (array/len @config.outcomes), yMin: 0, yMax: 1, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit TRIALS_UPDATED { counts: @entity.counts, total: @entity.total, narration: @entity.narration })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (let (
            (n (array/len @config.outcomes))
            (sumP (array/sum @config.outcomes probability))
            (expectedProbs (array/map (array/range @n) (fn i (/ (object/get (array/nth @config.outcomes @i) probability) @sumP))))
            (zeroCounts (array/map (array/range @n) (fn i 0)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (observedProps (array/map (array/range @n) (fn i 0)))
            (maxExpected (math/max (array/max @expectedProbs) 0.0001))
            (maxObserved (math/max (array/max @observedProps) 0.0001))
            (maxVal (* (math/max @maxExpected @maxObserved) 1.25))
            (barW (/ @plotW @n))
            (barShapes (array/map (array/range @n) (fn i (let ((barH (* (/ (array/nth @observedProps @i) @maxVal) @plotH)) (outcome (array/nth @config.outcomes @i))) { type: "rect", x: (+ 24 (* @i @barW)), y: (- (+ 24 @plotH) @barH), width: (* @barW 0.6), height: @barH, fill: (object/get @outcome color), opacity: 0.85, lineWidth: 0 }))))
            (expectedShapes (array/map (array/range @n) (fn i { type: "circle", x: (+ 24 (* (+ @i 0.5) @barW)), y: (- (+ 24 @plotH) (* (/ (array/nth @expectedProbs @i) @maxVal) @plotH)), radius: 5, fill: "#111827", lineWidth: 0 })))
            (labelShapes (array/map (array/range @n) (fn i (let ((outcome (array/nth @config.outcomes @i))) { type: "text", x: (+ 24 (* (+ @i 0.5) @barW)), y: (+ (+ 24 @plotH) 16), text: (str/concat (object/get @outcome label) ": " (str/concat "" (array/nth @zeroCounts @i))), fontSize: 11, align: "center", color: "#111827" }))))
            (shapes (array/concat [ { type: "line", x1: 24, y1: (+ 24 @plotH), x2: (+ 24 @plotW), y2: (+ 24 @plotH), color: "#cbd5e1", lineWidth: 1 } ] (array/concat @barShapes (array/concat @expectedShapes @labelShapes))))
          )
          (do
            (set @entity.active true)
            (set @entity.title @config.title)
            (set @entity.counts @zeroCounts)
            (set @entity.total 0)
            (set @entity.running @config.running)
            (set @entity.narration "Press Roll to sample an outcome, or Run to auto-sample.")
            (set @entity.shapes @shapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TRIAL, label: "Roll", variant: primary },
                    { type: button, action: RUN, label: "Run", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Total trials: " (str/concat "" @entity.total)) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: (array/len @config.outcomes), yMin: 0, yMax: 1, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit TRIALS_UPDATED { counts: @entity.counts, total: @entity.total, narration: @entity.narration })

      TRIAL -> idle when (== @entity.active true)
        (let (
            (n (array/len @config.outcomes))
            (sumP (array/sum @config.outcomes probability))
            (expectedProbs (array/map (array/range @n) (fn i (/ (object/get (array/nth @config.outcomes @i) probability) @sumP))))
            (cumProbs (array/map (array/range @n) (fn i (array/sum (array/slice @expectedProbs 0 (+ @i 1))))))
            (r (math/random))
            (rolledIdxRaw (array/len (array/filter @cumProbs (fn c (<= @c @r)))))
            (rolledIdx (math/min @rolledIdxRaw (- @n 1)))
            (rolledOutcome (array/nth @config.outcomes @rolledIdx))
            (newCounts (array/map (array/range @n) (fn i (if (== @i @rolledIdx) (+ (array/nth @entity.counts @i) 1) (array/nth @entity.counts @i)))))
            (newTotal (+ @entity.total 1))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (observedProps (array/map (array/range @n) (fn i (/ (array/nth @newCounts @i) @newTotal))))
            (maxExpected (math/max (array/max @expectedProbs) 0.0001))
            (maxObserved (math/max (array/max @observedProps) 0.0001))
            (maxVal (* (math/max @maxExpected @maxObserved) 1.25))
            (barW (/ @plotW @n))
            (barShapes (array/map (array/range @n) (fn i (let ((barH (* (/ (array/nth @observedProps @i) @maxVal) @plotH)) (outcome (array/nth @config.outcomes @i))) { type: "rect", x: (+ 24 (* @i @barW)), y: (- (+ 24 @plotH) @barH), width: (* @barW 0.6), height: @barH, fill: (object/get @outcome color), opacity: 0.85, lineWidth: 0 }))))
            (expectedShapes (array/map (array/range @n) (fn i { type: "circle", x: (+ 24 (* (+ @i 0.5) @barW)), y: (- (+ 24 @plotH) (* (/ (array/nth @expectedProbs @i) @maxVal) @plotH)), radius: 5, fill: "#111827", lineWidth: 0 })))
            (labelShapes (array/map (array/range @n) (fn i (let ((outcome (array/nth @config.outcomes @i))) { type: "text", x: (+ 24 (* (+ @i 0.5) @barW)), y: (+ (+ 24 @plotH) 16), text: (str/concat (object/get @outcome label) ": " (str/concat "" (array/nth @newCounts @i))), fontSize: 11, align: "center", color: "#111827" }))))
            (shapes (array/concat [ { type: "line", x1: 24, y1: (+ 24 @plotH), x2: (+ 24 @plotW), y2: (+ 24 @plotH), color: "#cbd5e1", lineWidth: 1 } ] (array/concat @barShapes (array/concat @expectedShapes @labelShapes))))
            (observedPct (math/round (* (array/nth @observedProps @rolledIdx) 100) 1))
            (expectedPct (math/round (* (array/nth @expectedProbs @rolledIdx) 100) 1))
            (narration (str/concat "trial " (str/concat "" @newTotal) " — rolled " (object/get @rolledOutcome label) "; observed " (str/concat "" @observedPct) "% vs expected " (str/concat "" @expectedPct) "%"))
          )
          (do
            (set @entity.counts @newCounts)
            (set @entity.total @newTotal)
            (set @entity.narration @narration)
            (set @entity.shapes @shapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TRIAL, label: "Roll", variant: primary },
                    { type: button, action: RUN, label: "Run", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Total trials: " (str/concat "" @entity.total)) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: (array/len @config.outcomes), yMin: 0, yMax: 1, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit TRIALS_UPDATED { counts: @entity.counts, total: @entity.total, narration: @entity.narration })

      RUN -> idle when (== @entity.active true)
        (set @entity.running (not @entity.running))
        (set @entity.narration (if @entity.running "Auto-sampling — tick draws a new outcome." "Paused — sample manually with Roll."))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TRIAL, label: "Roll", variant: primary },
                    { type: button, action: RUN, label: "Run", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Total trials: " (str/concat "" @entity.total)) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: (array/len @config.outcomes), yMin: 0, yMax: 1, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit TRIALS_UPDATED { counts: @entity.counts, total: @entity.total, narration: @entity.narration })

      RESET -> idle when (== @entity.active true)
        (let (
            (n (array/len @config.outcomes))
            (sumP (array/sum @config.outcomes probability))
            (expectedProbs (array/map (array/range @n) (fn i (/ (object/get (array/nth @config.outcomes @i) probability) @sumP))))
            (zeroCounts (array/map (array/range @n) (fn i 0)))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (observedProps (array/map (array/range @n) (fn i 0)))
            (maxExpected (math/max (array/max @expectedProbs) 0.0001))
            (maxObserved (math/max (array/max @observedProps) 0.0001))
            (maxVal (* (math/max @maxExpected @maxObserved) 1.25))
            (barW (/ @plotW @n))
            (barShapes (array/map (array/range @n) (fn i (let ((barH (* (/ (array/nth @observedProps @i) @maxVal) @plotH)) (outcome (array/nth @config.outcomes @i))) { type: "rect", x: (+ 24 (* @i @barW)), y: (- (+ 24 @plotH) @barH), width: (* @barW 0.6), height: @barH, fill: (object/get @outcome color), opacity: 0.85, lineWidth: 0 }))))
            (expectedShapes (array/map (array/range @n) (fn i { type: "circle", x: (+ 24 (* (+ @i 0.5) @barW)), y: (- (+ 24 @plotH) (* (/ (array/nth @expectedProbs @i) @maxVal) @plotH)), radius: 5, fill: "#111827", lineWidth: 0 })))
            (labelShapes (array/map (array/range @n) (fn i (let ((outcome (array/nth @config.outcomes @i))) { type: "text", x: (+ 24 (* (+ @i 0.5) @barW)), y: (+ (+ 24 @plotH) 16), text: (str/concat (object/get @outcome label) ": " (str/concat "" (array/nth @zeroCounts @i))), fontSize: 11, align: "center", color: "#111827" }))))
            (shapes (array/concat [ { type: "line", x1: 24, y1: (+ 24 @plotH), x2: (+ 24 @plotW), y2: (+ 24 @plotH), color: "#cbd5e1", lineWidth: 1 } ] (array/concat @barShapes (array/concat @expectedShapes @labelShapes))))
          )
          (do
            (set @entity.counts @zeroCounts)
            (set @entity.total 0)
            (set @entity.running false)
            (set @entity.narration "Press Roll to sample an outcome, or Run to auto-sample.")
            (set @entity.shapes @shapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TRIAL, label: "Roll", variant: primary },
                    { type: button, action: RUN, label: "Run", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Total trials: " (str/concat "" @entity.total)) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: (array/len @config.outcomes), yMin: 0, yMax: 1, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit TRIALS_UPDATED { counts: @entity.counts, total: @entity.total, narration: @entity.narration })
    }

    ticks {
      trialsTick every 500ms
        when (and @entity.active @entity.running)
        (let (
            (n (array/len @config.outcomes))
            (sumP (array/sum @config.outcomes probability))
            (expectedProbs (array/map (array/range @n) (fn i (/ (object/get (array/nth @config.outcomes @i) probability) @sumP))))
            (cumProbs (array/map (array/range @n) (fn i (array/sum (array/slice @expectedProbs 0 (+ @i 1))))))
            (r (math/random))
            (rolledIdxRaw (array/len (array/filter @cumProbs (fn c (<= @c @r)))))
            (rolledIdx (math/min @rolledIdxRaw (- @n 1)))
            (rolledOutcome (array/nth @config.outcomes @rolledIdx))
            (newCounts (array/map (array/range @n) (fn i (if (== @i @rolledIdx) (+ (array/nth @entity.counts @i) 1) (array/nth @entity.counts @i)))))
            (newTotal (+ @entity.total 1))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (observedProps (array/map (array/range @n) (fn i (/ (array/nth @newCounts @i) @newTotal))))
            (maxExpected (math/max (array/max @expectedProbs) 0.0001))
            (maxObserved (math/max (array/max @observedProps) 0.0001))
            (maxVal (* (math/max @maxExpected @maxObserved) 1.25))
            (barW (/ @plotW @n))
            (barShapes (array/map (array/range @n) (fn i (let ((barH (* (/ (array/nth @observedProps @i) @maxVal) @plotH)) (outcome (array/nth @config.outcomes @i))) { type: "rect", x: (+ 24 (* @i @barW)), y: (- (+ 24 @plotH) @barH), width: (* @barW 0.6), height: @barH, fill: (object/get @outcome color), opacity: 0.85, lineWidth: 0 }))))
            (expectedShapes (array/map (array/range @n) (fn i { type: "circle", x: (+ 24 (* (+ @i 0.5) @barW)), y: (- (+ 24 @plotH) (* (/ (array/nth @expectedProbs @i) @maxVal) @plotH)), radius: 5, fill: "#111827", lineWidth: 0 })))
            (labelShapes (array/map (array/range @n) (fn i (let ((outcome (array/nth @config.outcomes @i))) { type: "text", x: (+ 24 (* (+ @i 0.5) @barW)), y: (+ (+ 24 @plotH) 16), text: (str/concat (object/get @outcome label) ": " (str/concat "" (array/nth @newCounts @i))), fontSize: 11, align: "center", color: "#111827" }))))
            (shapes (array/concat [ { type: "line", x1: 24, y1: (+ 24 @plotH), x2: (+ 24 @plotW), y2: (+ 24 @plotH), color: "#cbd5e1", lineWidth: 1 } ] (array/concat @barShapes (array/concat @expectedShapes @labelShapes))))
            (observedPct (math/round (* (array/nth @observedProps @rolledIdx) 100) 1))
            (expectedPct (math/round (* (array/nth @expectedProbs @rolledIdx) 100) 1))
            (narration (str/concat "trial " (str/concat "" @newTotal) " — rolled " (object/get @rolledOutcome label) "; observed " (str/concat "" @observedPct) "% vs expected " (str/concat "" @expectedPct) "%"))
          )
          (do
            (set @entity.counts @newCounts)
            (set @entity.total @newTotal)
            (set @entity.narration @narration)
            (set @entity.shapes @shapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: TRIAL, label: "Roll", variant: primary },
                    { type: button, action: RUN, label: "Run", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Total trials: " (str/concat "" @entity.total)) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: (array/len @config.outcomes), yMin: 0, yMax: 1, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @entity.narration }
              ] }
          ]
        })
        (emit TRIALS_UPDATED { counts: @entity.counts, total: @entity.total, narration: @entity.narration })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
    }

    emits {
      TRIALS_UPDATED -> external {
        counts : [number]
        total : number
        narration : string
      }
        @description "The accumulated per-outcome counts, total draws, and narration after each Roll, Run tick, or Reset — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "dice roll, coin flip, sampling, observed frequency, law of large numbers, trial run"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Probability Trials"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      running : boolean = false
        @label "Running"
        @description "When true the tick auto-samples a new outcome every ~500ms from load; toggle with the Run button."
        @tier "domain"
      outcomes : [ProbTrialsOutcome] = [
        { label: "1", probability: 0.1667, color: "#2563eb" },
        { label: "2", probability: 0.1667, color: "#7c3aed" },
        { label: "3", probability: 0.1667, color: "#db2777" },
        { label: "4", probability: 0.1667, color: "#dc2626" },
        { label: "5", probability: 0.1667, color: "#f59e0b" },
        { label: "6", probability: 0.1667, color: "#16a34a" }
      ]
        @label "Outcomes"
        @description "The sample space each trial draws from — label, relative probability (weights are normalized, needn't sum to 1), and bar color. Default is a fair six-sided die; a coin flip, a weighted spinner, or any categorical distribution is just a different outcomes list."
        @synonyms "dice, coin flip, sampling, distribution, histogram, law of large numbers, expected value, sample space, categorical distribution"
        @tier "domain"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      showAxes : boolean = false
        @label "Show Axes"
        @description "Draw background axes behind the observed-frequency bars."
        @tier "presentation"
      showGrid : boolean = false
        @label "Show Grid"
        @description "Draw a background grid behind the observed-frequency bars."
        @tier "presentation"
      gridStep : number = 1
        @label "Grid Step"
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
    }
  }

  page "/prob-trials" as ProbTrialsPage -> ProbTrialsSim
}
