app std-econ-elasticity "1.0.0"
"Price-elasticity-of-demand engine — the learner moves a price along a configurable linear demand curve (and shifts the curve's intercept) while the instrument computes live point and arc elasticity, shades the total-revenue rectangle, and pronounces an elastic / inelastic / unit-elastic verdict, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EconElasticityOrbital {
  type EconElasticitySample = {
    x : number!
    y : number!
  }
  type EconElasticityCurve = {
    label : string
    color : string
    samples : [EconElasticitySample]!
  }
  type EconElasticityMarker = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }

  entity EconElasticityScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    demandIntercept : number
    demandSlope : number
    price : number
    quantity : number
    revenue : number
    pointElasticity : number
    arcElasticity : number
    verdict : string
    curves : [EconElasticityCurve]
    points : [EconElasticityMarker]
  }

  trait EconElasticitySim -> @rebindable EconElasticityScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.demandIntercept @config.demandIntercept)
        (set @entity.demandSlope @config.demandSlope)
        (set @entity.price @config.priceStart)
        (let (
            (q (math/max 0 (/ (- @entity.demandIntercept @entity.price) @entity.demandSlope)))
            (rev (* @entity.price @q))
            (pe (if (> @q 0.0001) (/ @entity.price (* @entity.demandSlope @q)) 0))
            (p2 (math/min @config.maxPrice (+ @entity.price @config.elasticityStep)))
            (q2 (math/max 0 (/ (- @entity.demandIntercept @p2) @entity.demandSlope)))
            (arc (if (and (> (+ @q @q2) 0.0001) (> (- @p2 @entity.price) 0.0001)) (* (math/abs (/ (- @q2 @q) (- @p2 @entity.price))) (/ (+ @entity.price @p2) (+ @q @q2))) 0))
            (vd (if (> @pe 1.0001) "Elastic" (if (< @pe 0.9999) "Inelastic" "Unit elastic")))
            (demandZeroQ (math/min @config.maxQuantity (/ @entity.demandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @entity.demandIntercept (* @entity.demandSlope @demandZeroQ))))
            (newCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @entity.demandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] },
                { label: "Total Revenue", color: @config.revenueColor, samples: [ { x: 0, y: 0 }, { x: @q, y: 0 }, { x: @q, y: @entity.price }, { x: 0, y: @entity.price }, { x: 0, y: 0 } ] }
              ])
            (newPoints [
                { x: @q, y: @entity.price, label: "P × Q", color: @config.pointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.quantity @q)
            (set @entity.revenue @rev)
            (set @entity.pointElasticity @pe)
            (set @entity.arcElasticity @arc)
            (set @entity.verdict @vd)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: MEASURE_ELASTICITY, label: "Measure Elasticity", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Price $" (math/round @entity.price 2) " — quantity " (math/round @entity.quantity 2) " — total revenue $" (math/round @entity.revenue 2)) },
                { type: typography, variant: body, content: (str/concat "Point elasticity " (math/round @entity.pointElasticity 2) " — arc elasticity " (math/round @entity.arcElasticity 2) " (midpoint over a +" @config.elasticityStep " price move)") },
                { type: alert, variant: (if (== @entity.verdict "Elastic") "success" (if (== @entity.verdict "Inelastic") "warning" "success")), message: (str/concat @entity.verdict " demand here — " (if (== @entity.verdict "Elastic") "quantity responds more than price, so a price cut raises total revenue." (if (== @entity.verdict "Inelastic") "quantity responds less than price, so a price rise raises total revenue." "revenue is (locally) maximized — the price and quantity effects exactly offset."))) }
              ] }
          ]
        })
        (emit ELASTICITY_UPDATED { price: @entity.price, quantity: @entity.quantity, revenue: @entity.revenue, pointElasticity: @entity.pointElasticity, arcElasticity: @entity.arcElasticity, verdict: @entity.verdict })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.demandIntercept @config.demandIntercept)
        (set @entity.demandSlope @config.demandSlope)
        (set @entity.price @config.priceStart)
        (let (
            (q (math/max 0 (/ (- @entity.demandIntercept @entity.price) @entity.demandSlope)))
            (rev (* @entity.price @q))
            (pe (if (> @q 0.0001) (/ @entity.price (* @entity.demandSlope @q)) 0))
            (p2 (math/min @config.maxPrice (+ @entity.price @config.elasticityStep)))
            (q2 (math/max 0 (/ (- @entity.demandIntercept @p2) @entity.demandSlope)))
            (arc (if (and (> (+ @q @q2) 0.0001) (> (- @p2 @entity.price) 0.0001)) (* (math/abs (/ (- @q2 @q) (- @p2 @entity.price))) (/ (+ @entity.price @p2) (+ @q @q2))) 0))
            (vd (if (> @pe 1.0001) "Elastic" (if (< @pe 0.9999) "Inelastic" "Unit elastic")))
            (demandZeroQ (math/min @config.maxQuantity (/ @entity.demandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @entity.demandIntercept (* @entity.demandSlope @demandZeroQ))))
            (newCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @entity.demandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] },
                { label: "Total Revenue", color: @config.revenueColor, samples: [ { x: 0, y: 0 }, { x: @q, y: 0 }, { x: @q, y: @entity.price }, { x: 0, y: @entity.price }, { x: 0, y: 0 } ] }
              ])
            (newPoints [
                { x: @q, y: @entity.price, label: "P × Q", color: @config.pointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.quantity @q)
            (set @entity.revenue @rev)
            (set @entity.pointElasticity @pe)
            (set @entity.arcElasticity @arc)
            (set @entity.verdict @vd)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: MEASURE_ELASTICITY, label: "Measure Elasticity", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Price $" (math/round @entity.price 2) " — quantity " (math/round @entity.quantity 2) " — total revenue $" (math/round @entity.revenue 2)) },
                { type: typography, variant: body, content: (str/concat "Point elasticity " (math/round @entity.pointElasticity 2) " — arc elasticity " (math/round @entity.arcElasticity 2) " (midpoint over a +" @config.elasticityStep " price move)") },
                { type: alert, variant: (if (== @entity.verdict "Elastic") "success" (if (== @entity.verdict "Inelastic") "warning" "success")), message: (str/concat @entity.verdict " demand here — " (if (== @entity.verdict "Elastic") "quantity responds more than price, so a price cut raises total revenue." (if (== @entity.verdict "Inelastic") "quantity responds less than price, so a price rise raises total revenue." "revenue is (locally) maximized — the price and quantity effects exactly offset."))) }
              ] }
          ]
        })
        (emit ELASTICITY_UPDATED { price: @entity.price, quantity: @entity.quantity, revenue: @entity.revenue, pointElasticity: @entity.pointElasticity, arcElasticity: @entity.arcElasticity, verdict: @entity.verdict })

      SET_PRICE -> idle when (== @entity.active true)
        (let (
            (newPrice (math/clamp ?value 0 @config.maxPrice))
            (q (math/max 0 (/ (- @entity.demandIntercept @newPrice) @entity.demandSlope)))
            (rev (* @newPrice @q))
            (pe (if (> @q 0.0001) (/ @newPrice (* @entity.demandSlope @q)) 0))
            (p2 (math/min @config.maxPrice (+ @newPrice @config.elasticityStep)))
            (q2 (math/max 0 (/ (- @entity.demandIntercept @p2) @entity.demandSlope)))
            (arc (if (and (> (+ @q @q2) 0.0001) (> (- @p2 @newPrice) 0.0001)) (* (math/abs (/ (- @q2 @q) (- @p2 @newPrice))) (/ (+ @newPrice @p2) (+ @q @q2))) 0))
            (vd (if (> @pe 1.0001) "Elastic" (if (< @pe 0.9999) "Inelastic" "Unit elastic")))
            (demandCurve (array/nth @entity.curves 0))
            (priceLine { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @newPrice }, { x: @config.maxQuantity, y: @newPrice } ] })
            (revRect { label: "Total Revenue", color: @config.revenueColor, samples: [ { x: 0, y: 0 }, { x: @q, y: 0 }, { x: @q, y: @newPrice }, { x: 0, y: @newPrice }, { x: 0, y: 0 } ] })
            (newCurves [ @demandCurve, @priceLine, @revRect ])
            (newPoints [ { x: @q, y: @newPrice, label: "P × Q", color: @config.pointColor, radius: 6 } ])
          )
          (do
            (set @entity.price @newPrice)
            (set @entity.quantity @q)
            (set @entity.revenue @rev)
            (set @entity.pointElasticity @pe)
            (set @entity.arcElasticity @arc)
            (set @entity.verdict @vd)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: MEASURE_ELASTICITY, label: "Measure Elasticity", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Price $" (math/round @entity.price 2) " — quantity " (math/round @entity.quantity 2) " — total revenue $" (math/round @entity.revenue 2)) },
                { type: typography, variant: body, content: (str/concat "Point elasticity " (math/round @entity.pointElasticity 2) " — arc elasticity " (math/round @entity.arcElasticity 2) " (midpoint over a +" @config.elasticityStep " price move)") },
                { type: alert, variant: (if (== @entity.verdict "Elastic") "success" (if (== @entity.verdict "Inelastic") "warning" "success")), message: (str/concat @entity.verdict " demand here — " (if (== @entity.verdict "Elastic") "quantity responds more than price, so a price cut raises total revenue." (if (== @entity.verdict "Inelastic") "quantity responds less than price, so a price rise raises total revenue." "revenue is (locally) maximized — the price and quantity effects exactly offset."))) }
              ] }
          ]
        })
        (emit ELASTICITY_UPDATED { price: @entity.price, quantity: @entity.quantity, revenue: @entity.revenue, pointElasticity: @entity.pointElasticity, arcElasticity: @entity.arcElasticity, verdict: @entity.verdict })

      SHIFT_DEMAND -> idle when (== @entity.active true)
        (let (
            (newDemandIntercept (math/max @config.elasticityStep (math/min (* @config.maxPrice 3) (+ @entity.demandIntercept ?delta))))
            (q (math/max 0 (/ (- @newDemandIntercept @entity.price) @entity.demandSlope)))
            (rev (* @entity.price @q))
            (pe (if (> @q 0.0001) (/ @entity.price (* @entity.demandSlope @q)) 0))
            (p2 (math/min @config.maxPrice (+ @entity.price @config.elasticityStep)))
            (q2 (math/max 0 (/ (- @newDemandIntercept @p2) @entity.demandSlope)))
            (arc (if (and (> (+ @q @q2) 0.0001) (> (- @p2 @entity.price) 0.0001)) (* (math/abs (/ (- @q2 @q) (- @p2 @entity.price))) (/ (+ @entity.price @p2) (+ @q @q2))) 0))
            (vd (if (> @pe 1.0001) "Elastic" (if (< @pe 0.9999) "Inelastic" "Unit elastic")))
            (demandZeroQ (math/min @config.maxQuantity (/ @newDemandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @newDemandIntercept (* @entity.demandSlope @demandZeroQ))))
            (newCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @newDemandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] },
                { label: "Total Revenue", color: @config.revenueColor, samples: [ { x: 0, y: 0 }, { x: @q, y: 0 }, { x: @q, y: @entity.price }, { x: 0, y: @entity.price }, { x: 0, y: 0 } ] }
              ])
            (newPoints [
                { x: @q, y: @entity.price, label: "P × Q", color: @config.pointColor, radius: 6 }
              ])
          )
          (do
            (set @entity.demandIntercept @newDemandIntercept)
            (set @entity.quantity @q)
            (set @entity.revenue @rev)
            (set @entity.pointElasticity @pe)
            (set @entity.arcElasticity @arc)
            (set @entity.verdict @vd)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: MEASURE_ELASTICITY, label: "Measure Elasticity", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Price $" (math/round @entity.price 2) " — quantity " (math/round @entity.quantity 2) " — total revenue $" (math/round @entity.revenue 2)) },
                { type: typography, variant: body, content: (str/concat "Point elasticity " (math/round @entity.pointElasticity 2) " — arc elasticity " (math/round @entity.arcElasticity 2) " (midpoint over a +" @config.elasticityStep " price move)") },
                { type: alert, variant: (if (== @entity.verdict "Elastic") "success" (if (== @entity.verdict "Inelastic") "warning" "success")), message: (str/concat @entity.verdict " demand here — " (if (== @entity.verdict "Elastic") "quantity responds more than price, so a price cut raises total revenue." (if (== @entity.verdict "Inelastic") "quantity responds less than price, so a price rise raises total revenue." "revenue is (locally) maximized — the price and quantity effects exactly offset."))) }
              ] }
          ]
        })
        (emit ELASTICITY_UPDATED { price: @entity.price, quantity: @entity.quantity, revenue: @entity.revenue, pointElasticity: @entity.pointElasticity, arcElasticity: @entity.arcElasticity, verdict: @entity.verdict })

      MEASURE_ELASTICITY -> idle when (== @entity.active true)
        (let (
            (p2 (math/min @config.maxPrice (+ @entity.price @config.elasticityStep)))
            (q2 (math/max 0 (/ (- @entity.demandIntercept @p2) @entity.demandSlope)))
            (arc (if (and (> (+ @entity.quantity @q2) 0.0001) (> (- @p2 @entity.price) 0.0001)) (* (math/abs (/ (- @q2 @entity.quantity) (- @p2 @entity.price))) (/ (+ @entity.price @p2) (+ @entity.quantity @q2))) 0))
            (pe (if (> @entity.quantity 0.0001) (/ @entity.price (* @entity.demandSlope @entity.quantity)) 0))
            (vd (if (> @pe 1.0001) "Elastic" (if (< @pe 0.9999) "Inelastic" "Unit elastic")))
          )
          (do
            (set @entity.pointElasticity @pe)
            (set @entity.arcElasticity @arc)
            (set @entity.verdict @vd)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: MEASURE_ELASTICITY, label: "Measure Elasticity", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Price $" (math/round @entity.price 2) " — quantity " (math/round @entity.quantity 2) " — total revenue $" (math/round @entity.revenue 2)) },
                { type: typography, variant: body, content: (str/concat "Point elasticity " (math/round @entity.pointElasticity 2) " — arc elasticity " (math/round @entity.arcElasticity 2) " (midpoint over a +" @config.elasticityStep " price move)") },
                { type: alert, variant: (if (== @entity.verdict "Elastic") "success" (if (== @entity.verdict "Inelastic") "warning" "success")), message: (str/concat @entity.verdict " demand here — " (if (== @entity.verdict "Elastic") "quantity responds more than price, so a price cut raises total revenue." (if (== @entity.verdict "Inelastic") "quantity responds less than price, so a price rise raises total revenue." "revenue is (locally) maximized — the price and quantity effects exactly offset."))) }
              ] }
          ]
        })
        (emit ELASTICITY_UPDATED { price: @entity.price, quantity: @entity.quantity, revenue: @entity.revenue, pointElasticity: @entity.pointElasticity, arcElasticity: @entity.arcElasticity, verdict: @entity.verdict })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_PRICE {
        value : number
      }
        @description "Learner dragged the price slider to move along the demand curve."
        @tier "domain"
      SHIFT_DEMAND {
        delta : number
      }
        @description "Learner pressed a Demand +/- button to shift the demand curve's intercept."
        @tier "domain"
      MEASURE_ELASTICITY {
      }
        @description "Learner pressed Measure Elasticity to recompute the point and arc elasticity readout at the current price."
        @tier "domain"
    }

    emits {
      ELASTICITY_UPDATED -> external {
        price : number
        quantity : number
        revenue : number
        pointElasticity : number
        arcElasticity : number
        verdict : string
      }
        @description "The elasticity state after each learner action — a composed listener (readout, chart, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "elasticity, price elasticity of demand, arc elasticity, point elasticity, total revenue test, elastic, inelastic, unit elastic"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Price Elasticity of Demand"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 440
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      gridStep : number = 10
        @label "Grid Step"
        @description "Spacing between gridlines on the canvas, in data units (quantity/price)."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      demandIntercept : number = 100
        @label "Demand Intercept"
        @description "Choke price — the price at which quantity demanded falls to zero (P = intercept − slope × Q); the demand curve's starting vertical intercept."
        @synonyms "demand, choke price, maximum willingness to pay, demand curve intercept, demand function"
        @tier "domain"
      demandSlope : number = 1
        @label "Demand Slope"
        @description "How much price falls for each additional unit demanded — the magnitude of the demand curve's downward slope, and the denominator of point elasticity."
        @synonyms "demand slope, price sensitivity, demand curve steepness"
        @tier "domain"
      elasticityStep : number = 5
        @label "Elasticity Step"
        @description "Price increment used for the arc-elasticity (midpoint) measurement above the current price."
        @synonyms "arc elasticity step, midpoint formula, price change"
        @tier "domain"
      priceStart : number = 50
        @label "Initial Price"
        @description "Starting price on the price slider, before the learner adjusts it."
        @tier "domain"
      priceStep : number = 1
        @label "Price Step"
        @description "Slider increment for the price control."
        @tier "presentation"
      demandShiftStep : number = 10
        @label "Demand Shift Step"
        @description "How much the Demand +/- buttons move the demand intercept per press."
        @synonyms "demand shift, demand shock, shift in demand"
        @tier "domain"
      maxQuantity : number = 90
        @label "Max Quantity (axis)"
        @description "Right edge of the quantity axis, in units."
        @tier "presentation"
      maxPrice : number = 100
        @label "Max Price (axis)"
        @description "Top edge of the price axis, and the price slider's maximum, in currency units."
        @tier "presentation"
      demandColor : string = "#dc2626"
        @label "Demand Curve Color"
        @tier "presentation"
      priceLineColor : string = "#64748b"
        @label "Price Line Color"
        @tier "presentation"
      revenueColor : string = "#16a34a"
        @label "Revenue Rectangle Color"
        @tier "presentation"
      pointColor : string = "#7c3aed"
        @label "Point Marker Color"
        @tier "presentation"
    }
  }

  page "/econ-elasticity" as EconElasticityPage -> EconElasticitySim
}
