app std-earth-plates "1.0.0"
"Plate-tectonics boundary simulator — the learner picks a convergent/divergent/transform boundary and advances motion to see landforms and earthquakes accumulate, on a biology-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EarthPlatesOrbital {
  type EarthPlatesNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
  }
  type EarthPlatesEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type EarthPlatesShapePoint = {
    x : number!
    y : number!
  }
  type EarthPlatesShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [EarthPlatesShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type EarthPlatesBoundary = {
    type : "convergent" | "divergent" | "transform"!
    label : string
    description : string
    landform : string
    quakeProfile : string
  }

  entity EarthPlatesScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [EarthPlatesNode]
    edges : [EarthPlatesEdge]
    shapes : [EarthPlatesShape]
    boundaryType : string
    boundaryDescription : string
    advanceSteps : number
    landformLabel : string
    quakeProfileLabel : string
  }

  trait EarthPlatesSim -> @rebindable EarthPlatesScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.boundaryType (object/get (array/nth @config.boundaries 0) type))
        (set @entity.advanceSteps 0)
        (let (
            (selected (if (== @entity.boundaryType "convergent") (array/nth @config.boundaries 0) (if (== @entity.boundaryType "divergent") (array/nth @config.boundaries 1) (array/nth @config.boundaries 2))))
            (margin 24)
            (midX (/ @config.width 2))
            (surfaceY (* @config.height 0.45))
            (plateDepth (- (- @config.height @margin) @surfaceY))
            (isConvergent (== @entity.boundaryType "convergent"))
            (isDivergent (== @entity.boundaryType "divergent"))
            (isTransform (== @entity.boundaryType "transform"))
            (gapHalf (if @isConvergent (math/max 0 (- @config.plateGapHalf (* @entity.advanceSteps @config.convergeRatePixels))) (if @isDivergent (+ @config.plateGapHalf (* @entity.advanceSteps @config.divergeRatePixels)) @config.plateGapHalf)))
            (shearOffset (if @isTransform (* @entity.advanceSteps @config.shearRatePixels) 0))
            (leftWidth (- (- @midX @gapHalf) @margin))
            (rightX (+ (+ @midX @gapHalf) @shearOffset))
            (rightWidth (- (- @config.width @margin) @rightX))
            (halfCount (math/floor (/ @entity.advanceSteps 2)))
            (volcanoShapes (if (and @isConvergent (<= @config.volcanoThresholdSteps @entity.advanceSteps)) [ { type: line, x1: (+ @rightX 20), y1: @surfaceY, x2: (+ @rightX 34), y2: (- @surfaceY 40), color: @config.volcanoColor, lineWidth: 3 }, { type: line, x1: (+ @rightX 34), y1: (- @surfaceY 40), x2: (+ @rightX 48), y2: @surfaceY, color: @config.volcanoColor, lineWidth: 3 } ] []))
            (quakeNodes (if @isConvergent (array/map (array/range @entity.advanceSteps) (fn idx { id: (str/concat "q" @idx), x: (+ @midX (* @idx 14)), y: (+ @surfaceY (* @idx 18)), radius: 5, color: @config.quakeColor, label: "" })) (if @isTransform (array/map (array/range @entity.advanceSteps) (fn idx (let ( (dx (* (- @idx @halfCount) @config.transformQuakeSpacing)) ) { id: (str/concat "q" @idx), x: (+ @midX @dx), y: (+ @surfaceY 8), radius: 5, color: @config.quakeColor, label: "" }))) [])))
            (ridgeShapes (if @isDivergent [ { type: line, x1: (- @midX 14), y1: @surfaceY, x2: @midX, y2: (- @surfaceY 20), color: @config.crustNewColor, lineWidth: 3 }, { type: line, x1: @midX, y1: (- @surfaceY 20), x2: (+ @midX 14), y2: @surfaceY, color: @config.crustNewColor, lineWidth: 3 } ] []))
            (riftBand (if @isDivergent [ { type: rect, x: (- @midX @gapHalf), y: @surfaceY, width: (* @gapHalf 2), height: 16, color: @config.crustNewColor, fill: @config.crustNewColor } ] []))
            (trenchLine (if @isConvergent [ { type: line, x1: @midX, y1: @surfaceY, x2: (+ @midX (* @entity.advanceSteps 14)), y2: (+ @surfaceY (* @entity.advanceSteps 18)), color: "#475569", lineWidth: 2 } ] []))
            (faultLine (if @isTransform [ { type: line, x1: @midX, y1: (- @surfaceY 12), x2: @midX, y2: (+ @surfaceY 12), color: "#475569", lineWidth: 2 } ] []))
            (plateShapes (array/concat (array/concat (array/concat (array/concat (array/concat [ { type: rect, x: @margin, y: @surfaceY, width: @leftWidth, height: @plateDepth, color: @config.plateColorLeft, fill: @config.plateColorLeft }, { type: rect, x: @rightX, y: @surfaceY, width: @rightWidth, height: @plateDepth, color: @config.plateColorRight, fill: @config.plateColorRight } ] @trenchLine) @faultLine) @riftBand) @ridgeShapes) @volcanoShapes))
            (landformLabel (if (== @entity.advanceSteps 0) (str/concat "No motion yet — " (object/get @selected description)) (object/get @selected landform)))
            (quakeProfileLabel (str/concat (object/get @selected quakeProfile) " — " @entity.advanceSteps " event(s) recorded"))
            (boundaryDescription (object/get @selected description))
          )
          (do
            (set @entity.landformLabel @landformLabel)
            (set @entity.quakeProfileLabel @quakeProfileLabel)
            (set @entity.boundaryDescription @boundaryDescription)
            (set @entity.edges [])
            (set @entity.nodes @quakeNodes)
            (set @entity.shapes @plateShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.boundaries (fn bnd { type: button, action: SELECT_BOUNDARY, actionPayload: { boundaryType: (object/get @bnd type) }, label: (object/get @bnd label), variant: (if (== @entity.boundaryType (object/get @bnd type)) "primary" "ghost"), size: sm })) },
                { type: typography, variant: body, content: @entity.boundaryDescription },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADVANCE, label: (str/concat "Advance " @config.advanceStepYears " Million Years"), variant: primary, disabled: (if (<= @config.maxAdvanceSteps @entity.advanceSteps) true false) }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: h4, content: @entity.landformLabel },
                    { type: typography, variant: caption, content: @entity.quakeProfileLabel }
                  ] }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.boundaryType (object/get (array/nth @config.boundaries 0) type))
        (set @entity.advanceSteps 0)
        (let (
            (selected (if (== @entity.boundaryType "convergent") (array/nth @config.boundaries 0) (if (== @entity.boundaryType "divergent") (array/nth @config.boundaries 1) (array/nth @config.boundaries 2))))
            (margin 24)
            (midX (/ @config.width 2))
            (surfaceY (* @config.height 0.45))
            (plateDepth (- (- @config.height @margin) @surfaceY))
            (isConvergent (== @entity.boundaryType "convergent"))
            (isDivergent (== @entity.boundaryType "divergent"))
            (isTransform (== @entity.boundaryType "transform"))
            (gapHalf (if @isConvergent (math/max 0 (- @config.plateGapHalf (* @entity.advanceSteps @config.convergeRatePixels))) (if @isDivergent (+ @config.plateGapHalf (* @entity.advanceSteps @config.divergeRatePixels)) @config.plateGapHalf)))
            (shearOffset (if @isTransform (* @entity.advanceSteps @config.shearRatePixels) 0))
            (leftWidth (- (- @midX @gapHalf) @margin))
            (rightX (+ (+ @midX @gapHalf) @shearOffset))
            (rightWidth (- (- @config.width @margin) @rightX))
            (halfCount (math/floor (/ @entity.advanceSteps 2)))
            (volcanoShapes (if (and @isConvergent (<= @config.volcanoThresholdSteps @entity.advanceSteps)) [ { type: line, x1: (+ @rightX 20), y1: @surfaceY, x2: (+ @rightX 34), y2: (- @surfaceY 40), color: @config.volcanoColor, lineWidth: 3 }, { type: line, x1: (+ @rightX 34), y1: (- @surfaceY 40), x2: (+ @rightX 48), y2: @surfaceY, color: @config.volcanoColor, lineWidth: 3 } ] []))
            (quakeNodes (if @isConvergent (array/map (array/range @entity.advanceSteps) (fn idx { id: (str/concat "q" @idx), x: (+ @midX (* @idx 14)), y: (+ @surfaceY (* @idx 18)), radius: 5, color: @config.quakeColor, label: "" })) (if @isTransform (array/map (array/range @entity.advanceSteps) (fn idx (let ( (dx (* (- @idx @halfCount) @config.transformQuakeSpacing)) ) { id: (str/concat "q" @idx), x: (+ @midX @dx), y: (+ @surfaceY 8), radius: 5, color: @config.quakeColor, label: "" }))) [])))
            (ridgeShapes (if @isDivergent [ { type: line, x1: (- @midX 14), y1: @surfaceY, x2: @midX, y2: (- @surfaceY 20), color: @config.crustNewColor, lineWidth: 3 }, { type: line, x1: @midX, y1: (- @surfaceY 20), x2: (+ @midX 14), y2: @surfaceY, color: @config.crustNewColor, lineWidth: 3 } ] []))
            (riftBand (if @isDivergent [ { type: rect, x: (- @midX @gapHalf), y: @surfaceY, width: (* @gapHalf 2), height: 16, color: @config.crustNewColor, fill: @config.crustNewColor } ] []))
            (trenchLine (if @isConvergent [ { type: line, x1: @midX, y1: @surfaceY, x2: (+ @midX (* @entity.advanceSteps 14)), y2: (+ @surfaceY (* @entity.advanceSteps 18)), color: "#475569", lineWidth: 2 } ] []))
            (faultLine (if @isTransform [ { type: line, x1: @midX, y1: (- @surfaceY 12), x2: @midX, y2: (+ @surfaceY 12), color: "#475569", lineWidth: 2 } ] []))
            (plateShapes (array/concat (array/concat (array/concat (array/concat (array/concat [ { type: rect, x: @margin, y: @surfaceY, width: @leftWidth, height: @plateDepth, color: @config.plateColorLeft, fill: @config.plateColorLeft }, { type: rect, x: @rightX, y: @surfaceY, width: @rightWidth, height: @plateDepth, color: @config.plateColorRight, fill: @config.plateColorRight } ] @trenchLine) @faultLine) @riftBand) @ridgeShapes) @volcanoShapes))
            (landformLabel (if (== @entity.advanceSteps 0) (str/concat "No motion yet — " (object/get @selected description)) (object/get @selected landform)))
            (quakeProfileLabel (str/concat (object/get @selected quakeProfile) " — " @entity.advanceSteps " event(s) recorded"))
            (boundaryDescription (object/get @selected description))
          )
          (do
            (set @entity.landformLabel @landformLabel)
            (set @entity.quakeProfileLabel @quakeProfileLabel)
            (set @entity.boundaryDescription @boundaryDescription)
            (set @entity.edges [])
            (set @entity.nodes @quakeNodes)
            (set @entity.shapes @plateShapes)
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: stack, direction: horizontal, gap: xs, children: (array/map @config.boundaries (fn bnd { type: button, action: SELECT_BOUNDARY, actionPayload: { boundaryType: (object/get @bnd type) }, label: (object/get @bnd label), variant: (if (== @entity.boundaryType (object/get @bnd type)) "primary" "ghost"), size: sm })) },
                  { type: typography, variant: body, content: @entity.boundaryDescription },
                  { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                  { type: stack, direction: horizontal, gap: sm, children: [
                      { type: button, action: ADVANCE, label: (str/concat "Advance " @config.advanceStepYears " Million Years"), variant: primary, disabled: (if (<= @config.maxAdvanceSteps @entity.advanceSteps) true false) }
                    ] },
                  { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: h4, content: @entity.landformLabel },
                      { type: typography, variant: caption, content: @entity.quakeProfileLabel }
                    ] }
                ] }
            ]
        })

      SELECT_BOUNDARY -> idle when (== @entity.active true)
        (set @entity.boundaryType ?boundaryType)
        (set @entity.advanceSteps 0)
        (let (
            (selected (if (== @entity.boundaryType "convergent") (array/nth @config.boundaries 0) (if (== @entity.boundaryType "divergent") (array/nth @config.boundaries 1) (array/nth @config.boundaries 2))))
            (margin 24)
            (midX (/ @config.width 2))
            (surfaceY (* @config.height 0.45))
            (plateDepth (- (- @config.height @margin) @surfaceY))
            (isConvergent (== @entity.boundaryType "convergent"))
            (isDivergent (== @entity.boundaryType "divergent"))
            (isTransform (== @entity.boundaryType "transform"))
            (gapHalf (if @isConvergent (math/max 0 (- @config.plateGapHalf (* @entity.advanceSteps @config.convergeRatePixels))) (if @isDivergent (+ @config.plateGapHalf (* @entity.advanceSteps @config.divergeRatePixels)) @config.plateGapHalf)))
            (shearOffset (if @isTransform (* @entity.advanceSteps @config.shearRatePixels) 0))
            (leftWidth (- (- @midX @gapHalf) @margin))
            (rightX (+ (+ @midX @gapHalf) @shearOffset))
            (rightWidth (- (- @config.width @margin) @rightX))
            (halfCount (math/floor (/ @entity.advanceSteps 2)))
            (volcanoShapes (if (and @isConvergent (<= @config.volcanoThresholdSteps @entity.advanceSteps)) [ { type: line, x1: (+ @rightX 20), y1: @surfaceY, x2: (+ @rightX 34), y2: (- @surfaceY 40), color: @config.volcanoColor, lineWidth: 3 }, { type: line, x1: (+ @rightX 34), y1: (- @surfaceY 40), x2: (+ @rightX 48), y2: @surfaceY, color: @config.volcanoColor, lineWidth: 3 } ] []))
            (quakeNodes (if @isConvergent (array/map (array/range @entity.advanceSteps) (fn idx { id: (str/concat "q" @idx), x: (+ @midX (* @idx 14)), y: (+ @surfaceY (* @idx 18)), radius: 5, color: @config.quakeColor, label: "" })) (if @isTransform (array/map (array/range @entity.advanceSteps) (fn idx (let ( (dx (* (- @idx @halfCount) @config.transformQuakeSpacing)) ) { id: (str/concat "q" @idx), x: (+ @midX @dx), y: (+ @surfaceY 8), radius: 5, color: @config.quakeColor, label: "" }))) [])))
            (ridgeShapes (if @isDivergent [ { type: line, x1: (- @midX 14), y1: @surfaceY, x2: @midX, y2: (- @surfaceY 20), color: @config.crustNewColor, lineWidth: 3 }, { type: line, x1: @midX, y1: (- @surfaceY 20), x2: (+ @midX 14), y2: @surfaceY, color: @config.crustNewColor, lineWidth: 3 } ] []))
            (riftBand (if @isDivergent [ { type: rect, x: (- @midX @gapHalf), y: @surfaceY, width: (* @gapHalf 2), height: 16, color: @config.crustNewColor, fill: @config.crustNewColor } ] []))
            (trenchLine (if @isConvergent [ { type: line, x1: @midX, y1: @surfaceY, x2: (+ @midX (* @entity.advanceSteps 14)), y2: (+ @surfaceY (* @entity.advanceSteps 18)), color: "#475569", lineWidth: 2 } ] []))
            (faultLine (if @isTransform [ { type: line, x1: @midX, y1: (- @surfaceY 12), x2: @midX, y2: (+ @surfaceY 12), color: "#475569", lineWidth: 2 } ] []))
            (plateShapes (array/concat (array/concat (array/concat (array/concat (array/concat [ { type: rect, x: @margin, y: @surfaceY, width: @leftWidth, height: @plateDepth, color: @config.plateColorLeft, fill: @config.plateColorLeft }, { type: rect, x: @rightX, y: @surfaceY, width: @rightWidth, height: @plateDepth, color: @config.plateColorRight, fill: @config.plateColorRight } ] @trenchLine) @faultLine) @riftBand) @ridgeShapes) @volcanoShapes))
            (landformLabel (if (== @entity.advanceSteps 0) (str/concat "No motion yet — " (object/get @selected description)) (object/get @selected landform)))
            (quakeProfileLabel (str/concat (object/get @selected quakeProfile) " — " @entity.advanceSteps " event(s) recorded"))
            (boundaryDescription (object/get @selected description))
          )
          (do
            (set @entity.nodes @quakeNodes)
            (set @entity.edges [])
            (set @entity.shapes @plateShapes)
            (set @entity.landformLabel @landformLabel)
            (set @entity.quakeProfileLabel @quakeProfileLabel)
            (set @entity.boundaryDescription @boundaryDescription)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.boundaries (fn bnd { type: button, action: SELECT_BOUNDARY, actionPayload: { boundaryType: (object/get @bnd type) }, label: (object/get @bnd label), variant: (if (== @entity.boundaryType (object/get @bnd type)) "primary" "ghost"), size: sm })) },
                { type: typography, variant: body, content: @entity.boundaryDescription },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADVANCE, label: (str/concat "Advance " @config.advanceStepYears " Million Years"), variant: primary, disabled: (if (<= @config.maxAdvanceSteps @entity.advanceSteps) true false) }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: h4, content: @entity.landformLabel },
                    { type: typography, variant: caption, content: @entity.quakeProfileLabel }
                  ] }
              ] }
          ]
        })
        (emit PLATES_UPDATED { boundaryType: @entity.boundaryType, advanceSteps: @entity.advanceSteps, landformLabel: @entity.landformLabel, quakeProfileLabel: @entity.quakeProfileLabel })

      ADVANCE -> idle when (== @entity.active true)
        (set @entity.advanceSteps (math/min (+ @entity.advanceSteps 1) @config.maxAdvanceSteps))
        (let (
            (selected (if (== @entity.boundaryType "convergent") (array/nth @config.boundaries 0) (if (== @entity.boundaryType "divergent") (array/nth @config.boundaries 1) (array/nth @config.boundaries 2))))
            (margin 24)
            (midX (/ @config.width 2))
            (surfaceY (* @config.height 0.45))
            (plateDepth (- (- @config.height @margin) @surfaceY))
            (isConvergent (== @entity.boundaryType "convergent"))
            (isDivergent (== @entity.boundaryType "divergent"))
            (isTransform (== @entity.boundaryType "transform"))
            (gapHalf (if @isConvergent (math/max 0 (- @config.plateGapHalf (* @entity.advanceSteps @config.convergeRatePixels))) (if @isDivergent (+ @config.plateGapHalf (* @entity.advanceSteps @config.divergeRatePixels)) @config.plateGapHalf)))
            (shearOffset (if @isTransform (* @entity.advanceSteps @config.shearRatePixels) 0))
            (leftWidth (- (- @midX @gapHalf) @margin))
            (rightX (+ (+ @midX @gapHalf) @shearOffset))
            (rightWidth (- (- @config.width @margin) @rightX))
            (halfCount (math/floor (/ @entity.advanceSteps 2)))
            (volcanoShapes (if (and @isConvergent (<= @config.volcanoThresholdSteps @entity.advanceSteps)) [ { type: line, x1: (+ @rightX 20), y1: @surfaceY, x2: (+ @rightX 34), y2: (- @surfaceY 40), color: @config.volcanoColor, lineWidth: 3 }, { type: line, x1: (+ @rightX 34), y1: (- @surfaceY 40), x2: (+ @rightX 48), y2: @surfaceY, color: @config.volcanoColor, lineWidth: 3 } ] []))
            (quakeNodes (if @isConvergent (array/map (array/range @entity.advanceSteps) (fn idx { id: (str/concat "q" @idx), x: (+ @midX (* @idx 14)), y: (+ @surfaceY (* @idx 18)), radius: 5, color: @config.quakeColor, label: "" })) (if @isTransform (array/map (array/range @entity.advanceSteps) (fn idx (let ( (dx (* (- @idx @halfCount) @config.transformQuakeSpacing)) ) { id: (str/concat "q" @idx), x: (+ @midX @dx), y: (+ @surfaceY 8), radius: 5, color: @config.quakeColor, label: "" }))) [])))
            (ridgeShapes (if @isDivergent [ { type: line, x1: (- @midX 14), y1: @surfaceY, x2: @midX, y2: (- @surfaceY 20), color: @config.crustNewColor, lineWidth: 3 }, { type: line, x1: @midX, y1: (- @surfaceY 20), x2: (+ @midX 14), y2: @surfaceY, color: @config.crustNewColor, lineWidth: 3 } ] []))
            (riftBand (if @isDivergent [ { type: rect, x: (- @midX @gapHalf), y: @surfaceY, width: (* @gapHalf 2), height: 16, color: @config.crustNewColor, fill: @config.crustNewColor } ] []))
            (trenchLine (if @isConvergent [ { type: line, x1: @midX, y1: @surfaceY, x2: (+ @midX (* @entity.advanceSteps 14)), y2: (+ @surfaceY (* @entity.advanceSteps 18)), color: "#475569", lineWidth: 2 } ] []))
            (faultLine (if @isTransform [ { type: line, x1: @midX, y1: (- @surfaceY 12), x2: @midX, y2: (+ @surfaceY 12), color: "#475569", lineWidth: 2 } ] []))
            (plateShapes (array/concat (array/concat (array/concat (array/concat (array/concat [ { type: rect, x: @margin, y: @surfaceY, width: @leftWidth, height: @plateDepth, color: @config.plateColorLeft, fill: @config.plateColorLeft }, { type: rect, x: @rightX, y: @surfaceY, width: @rightWidth, height: @plateDepth, color: @config.plateColorRight, fill: @config.plateColorRight } ] @trenchLine) @faultLine) @riftBand) @ridgeShapes) @volcanoShapes))
            (landformLabel (if (== @entity.advanceSteps 0) (str/concat "No motion yet — " (object/get @selected description)) (object/get @selected landform)))
            (quakeProfileLabel (str/concat (object/get @selected quakeProfile) " — " @entity.advanceSteps " event(s) recorded"))
            (boundaryDescription (object/get @selected description))
          )
          (do
            (set @entity.nodes @quakeNodes)
            (set @entity.edges [])
            (set @entity.shapes @plateShapes)
            (set @entity.landformLabel @landformLabel)
            (set @entity.quakeProfileLabel @quakeProfileLabel)
            (set @entity.boundaryDescription @boundaryDescription)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.boundaries (fn bnd { type: button, action: SELECT_BOUNDARY, actionPayload: { boundaryType: (object/get @bnd type) }, label: (object/get @bnd label), variant: (if (== @entity.boundaryType (object/get @bnd type)) "primary" "ghost"), size: sm })) },
                { type: typography, variant: body, content: @entity.boundaryDescription },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADVANCE, label: (str/concat "Advance " @config.advanceStepYears " Million Years"), variant: primary, disabled: (if (<= @config.maxAdvanceSteps @entity.advanceSteps) true false) }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: h4, content: @entity.landformLabel },
                    { type: typography, variant: caption, content: @entity.quakeProfileLabel }
                  ] }
              ] }
          ]
        })
        (emit PLATES_UPDATED { boundaryType: @entity.boundaryType, advanceSteps: @entity.advanceSteps, landformLabel: @entity.landformLabel, quakeProfileLabel: @entity.quakeProfileLabel })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SELECT_BOUNDARY {
        boundaryType : string
      }
        @description "Learner picked a plate boundary type (convergent, divergent, or transform)."
        @tier "domain"
      ADVANCE {
      }
        @description "Learner pressed Advance to step plate motion forward, accumulating landforms and earthquakes."
        @tier "domain"
    }

    emits {
      PLATES_UPDATED -> external {
        boundaryType : string
        advanceSteps : number
        landformLabel : string
        quakeProfileLabel : string
      }
        @description "The plate-boundary state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "plate boundary update, landform, earthquake, subduction, rift, transform fault"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Earth Lab"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#f0f9ff"
        @label "Background Color"
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 420
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      boundaries : [EarthPlatesBoundary] = [
        { type: convergent, label: "Convergent", description: "Two plates move toward each other; the denser oceanic plate subducts beneath the other.", landform: "Subduction zone — volcanic arc and mountain range", quakeProfile: "Deep, inclined seismicity along the subducting slab (Wadati-Benioff zone)" },
        { type: divergent, label: "Divergent", description: "Two plates move apart; magma rises to fill the gap, forming new crust.", landform: "Rift valley / mid-ocean ridge with new oceanic crust", quakeProfile: "Shallow seismicity concentrated along the rift axis" },
        { type: transform, label: "Transform", description: "Two plates slide past each other horizontally; no crust is created or destroyed.", landform: "Transform fault with lateral (strike-slip) offset", quakeProfile: "Shallow, strike-slip seismicity along the fault trace" }
      ]
        @label "Boundaries"
        @description "Roster of the three plate-boundary types the learner can pick, each carrying the label/description shown and the landform + quake-profile text used in the readout."
        @tier "domain"
      plateColorLeft : string = "#92400e"
        @label "Left Plate Color"
        @tier "presentation"
      plateColorRight : string = "#78350f"
        @label "Right Plate Color"
        @tier "presentation"
      crustNewColor : string = "#f97316"
        @label "New Crust Color"
        @description "Color of freshly formed crust at a divergent rift."
        @tier "presentation"
      volcanoColor : string = "#dc2626"
        @label "Volcano Color"
        @tier "presentation"
      quakeColor : string = "#1e293b"
        @label "Quake Marker Color"
        @tier "presentation"
      plateGapHalf : number = 26
        @label "Initial Half-Gap (px)"
        @description "Half the starting gap between the two plates, in pixels, before any advance."
        @tier "domain"
      convergeRatePixels : number = 3
        @label "Convergence Rate (px/step)"
        @description "How many pixels the gap closes per Advance press in convergent mode."
        @tier "domain"
      divergeRatePixels : number = 4
        @label "Divergence Rate (px/step)"
        @description "How many pixels the rift widens per Advance press in divergent mode."
        @tier "domain"
      shearRatePixels : number = 6
        @label "Shear Rate (px/step)"
        @description "How many pixels the fault offsets per Advance press in transform mode."
        @tier "domain"
      transformQuakeSpacing : number = 10
        @label "Transform Quake Spacing (px)"
        @description "Horizontal spacing between successive quake markers along a transform fault."
        @tier "domain"
      volcanoThresholdSteps : number = 3
        @label "Volcano Threshold (steps)"
        @description "Number of Advance presses in convergent mode before the volcanic arc appears."
        @tier "domain"
      maxAdvanceSteps : number = 8
        @label "Max Advance Steps"
        @description "Caps how many times the learner can press Advance."
        @tier "domain"
      advanceStepYears : number = 5
        @label "Advance Step (million years)"
        @description "How many million years each Advance press represents, shown on the button label."
        @tier "presentation"
    }
  }

  page "/earth-plates" as EarthPlatesPage -> EarthPlatesSim
}
