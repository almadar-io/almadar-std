app std-prob-regression "1.0.0"
"Least-squares explorer — scatter points on a math-canvas; the regression line, residual segments, r and R² recompute live as points are added or moved, with an optional guess-the-line mode scored against the least-squares fit. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital ProbRegressionOrbital {
  type ProbRegressionPoint = {
    id : string
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }
  type ProbRegressionCurve = {
    label : string
    color : string
    samples : [ProbRegressionCurvePoint]
  }
  type ProbRegressionCurvePoint = {
    x : number!
    y : number!
  }
  type ProbRegressionShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbRegressionShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbRegressionShapePoint = {
    x : number!
    y : number!
  }

  entity ProbRegressionScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    points : [ProbRegressionPoint]
    slope : number
    intercept : number
    r : number
    rSquared : number
    guessSlope : number
    guessIntercept : number
    guessScore : number
    revealed : boolean = false
    curves : [ProbRegressionCurve]
    shapes : [ProbRegressionShape]
  }

  trait ProbRegressionSim -> @rebindable ProbRegressionScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.points @config.initialPoints)
        (set @entity.guessSlope 0)
        (set @entity.guessIntercept 50)
        (set @entity.revealed false)
        (let (
            (pts @config.initialPoints)
            (n (array/len @pts))
            (meanX (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p x)))) @n) 0))
            (meanY (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p y)))) @n) 0))
            (sxx (array/reduce @pts 0 (fn (acc p) (let ((dx (- (object/get @p x) @meanX))) (+ @acc (* @dx @dx))))))
            (syy (array/reduce @pts 0 (fn (acc p) (let ((dy (- (object/get @p y) @meanY))) (+ @acc (* @dy @dy))))))
            (sxy (array/reduce @pts 0 (fn (acc p) (+ @acc (* (- (object/get @p x) @meanX) (- (object/get @p y) @meanY))))))
            (newSlope (if (> @sxx 0) (/ @sxy @sxx) 0))
            (newIntercept (- @meanY (* @newSlope @meanX)))
            (newR (if (and (> @sxx 0) (> @syy 0)) (/ @sxy (math/sqrt (* @sxx @syy))) 0))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (residualShapes (if @config.showResiduals
              (array/map @pts (fn p
                (let (
                    (px (+ 24 (* (/ (object/get @p x) 100) @plotW)))
                    (py (- @config.height (+ 24 (* (/ (object/get @p y) 100) @plotH))))
                    (pyLine (- @config.height (+ 24 (* (/ (+ (* @newSlope (object/get @p x)) @newIntercept) 100) @plotH))))
                  )
                  { type: "line", x1: @px, y1: @py, x2: @px, y2: @pyLine, color: "#f59e0b", lineWidth: 1, opacity: 0.7 })))
              []))
            (fitCurve { label: "least squares", color: "#2563eb", samples: [
              { x: 0, y: (math/clamp @newIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @newSlope 100) @newIntercept) 0 100) }
            ]})
          )
          (do
            (set @entity.slope @newSlope)
            (set @entity.intercept @newIntercept)
            (set @entity.r @newR)
            (set @entity.rSquared (* @newR @newR))
            (set @entity.guessScore 0)
            (set @entity.shapes @residualShapes)
            (set @entity.curves (array/append [] @fitCurve))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADD_POINT, label: "Add Point", variant: primary },
                    { type: button, action: REVEAL_FIT, label: "Reveal Fit", variant: secondary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Guess slope: " (math/round @entity.guessSlope 2)) },
                { type: range-slider, min: -3, max: 3, step: 0.05, value: @entity.guessSlope, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "slope" } },
                { type: typography, variant: caption, content: (str/concat "Guess intercept: " (math/round @entity.guessIntercept 1)) },
                { type: range-slider, min: 0, max: 100, step: 1, value: @entity.guessIntercept, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "intercept" } },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 100, showAxes: true, showGrid: true, gridStep: 20, curves: @entity.curves, points: @entity.points, vectors: [], shapes: @entity.shapes, interactive: true, animate: false },
                { type: typography, variant: body, content: (if @config.showR (str/concat "r = " (math/round @entity.r 3) " — R² = " (math/round @entity.rSquared 3) " — guess score " @entity.guessScore "%") "") }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.points @config.initialPoints)
        (set @entity.guessSlope 0)
        (set @entity.guessIntercept 50)
        (set @entity.revealed false)
        (let (
            (pts @config.initialPoints)
            (n (array/len @pts))
            (meanX (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p x)))) @n) 0))
            (meanY (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p y)))) @n) 0))
            (sxx (array/reduce @pts 0 (fn (acc p) (let ((dx (- (object/get @p x) @meanX))) (+ @acc (* @dx @dx))))))
            (syy (array/reduce @pts 0 (fn (acc p) (let ((dy (- (object/get @p y) @meanY))) (+ @acc (* @dy @dy))))))
            (sxy (array/reduce @pts 0 (fn (acc p) (+ @acc (* (- (object/get @p x) @meanX) (- (object/get @p y) @meanY))))))
            (newSlope (if (> @sxx 0) (/ @sxy @sxx) 0))
            (newIntercept (- @meanY (* @newSlope @meanX)))
            (newR (if (and (> @sxx 0) (> @syy 0)) (/ @sxy (math/sqrt (* @sxx @syy))) 0))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (residualShapes (if @config.showResiduals
              (array/map @pts (fn p
                (let (
                    (px (+ 24 (* (/ (object/get @p x) 100) @plotW)))
                    (py (- @config.height (+ 24 (* (/ (object/get @p y) 100) @plotH))))
                    (pyLine (- @config.height (+ 24 (* (/ (+ (* @newSlope (object/get @p x)) @newIntercept) 100) @plotH))))
                  )
                  { type: "line", x1: @px, y1: @py, x2: @px, y2: @pyLine, color: "#f59e0b", lineWidth: 1, opacity: 0.7 })))
              []))
            (fitCurve { label: "least squares", color: "#2563eb", samples: [
              { x: 0, y: (math/clamp @newIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @newSlope 100) @newIntercept) 0 100) }
            ]})
          )
          (do
            (set @entity.slope @newSlope)
            (set @entity.intercept @newIntercept)
            (set @entity.r @newR)
            (set @entity.rSquared (* @newR @newR))
            (set @entity.guessScore 0)
            (set @entity.shapes @residualShapes)
            (set @entity.curves (array/append [] @fitCurve))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADD_POINT, label: "Add Point", variant: primary },
                    { type: button, action: REVEAL_FIT, label: "Reveal Fit", variant: secondary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Guess slope: " (math/round @entity.guessSlope 2)) },
                { type: range-slider, min: -3, max: 3, step: 0.05, value: @entity.guessSlope, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "slope" } },
                { type: typography, variant: caption, content: (str/concat "Guess intercept: " (math/round @entity.guessIntercept 1)) },
                { type: range-slider, min: 0, max: 100, step: 1, value: @entity.guessIntercept, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "intercept" } },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 100, showAxes: true, showGrid: true, gridStep: 20, curves: @entity.curves, points: @entity.points, vectors: [], shapes: @entity.shapes, interactive: true, animate: false },
                { type: typography, variant: body, content: (if @config.showR (str/concat "r = " (math/round @entity.r 3) " — R² = " (math/round @entity.rSquared 3) " — guess score " @entity.guessScore "%") "") }
              ] }
          ]
        })

      ADD_POINT -> idle when (== @entity.active true)
        (let (
            (newPoint { id: (str/concat "p" (array/len @entity.points)), x: (math/round (+ 5 (* (math/random) 90))), y: (math/round (+ 5 (* (math/random) 90))), label: "", color: "#334155", radius: 5 })
            (pts (array/append @entity.points @newPoint))
            (n (array/len @pts))
            (meanX (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p x)))) @n))
            (meanY (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p y)))) @n))
            (sxx (array/reduce @pts 0 (fn (acc p) (let ((dx (- (object/get @p x) @meanX))) (+ @acc (* @dx @dx))))))
            (syy (array/reduce @pts 0 (fn (acc p) (let ((dy (- (object/get @p y) @meanY))) (+ @acc (* @dy @dy))))))
            (sxy (array/reduce @pts 0 (fn (acc p) (+ @acc (* (- (object/get @p x) @meanX) (- (object/get @p y) @meanY))))))
            (newSlope (if (> @sxx 0) (/ @sxy @sxx) 0))
            (newIntercept (- @meanY (* @newSlope @meanX)))
            (newR (if (and (> @sxx 0) (> @syy 0)) (/ @sxy (math/sqrt (* @sxx @syy))) 0))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (residualShapes (if @config.showResiduals
              (array/map @pts (fn p
                (let (
                    (px (+ 24 (* (/ (object/get @p x) 100) @plotW)))
                    (py (- @config.height (+ 24 (* (/ (object/get @p y) 100) @plotH))))
                    (pyLine (- @config.height (+ 24 (* (/ (+ (* @newSlope (object/get @p x)) @newIntercept) 100) @plotH))))
                  )
                  { type: "line", x1: @px, y1: @py, x2: @px, y2: @pyLine, color: "#f59e0b", lineWidth: 1, opacity: 0.7 })))
              []))
            (fitCurve { label: "least squares", color: "#2563eb", samples: [
              { x: 0, y: (math/clamp @newIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @newSlope 100) @newIntercept) 0 100) }
            ]})
            (guessCurve { label: "your guess", color: "#dc2626", samples: [
              { x: 0, y: (math/clamp @entity.guessIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @entity.guessSlope 100) @entity.guessIntercept) 0 100) }
            ]})
          )
          (do
            (set @entity.points @pts)
            (set @entity.slope @newSlope)
            (set @entity.intercept @newIntercept)
            (set @entity.r @newR)
            (set @entity.rSquared (* @newR @newR))
            (set @entity.shapes @residualShapes)
            (set @entity.curves (if (and @config.guessMode (not @entity.revealed))
              (array/append [] @guessCurve)
              (if @config.guessMode
                (array/append (array/append [] @guessCurve) @fitCurve)
                (array/append [] @fitCurve))))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADD_POINT, label: "Add Point", variant: primary },
                    { type: button, action: REVEAL_FIT, label: "Reveal Fit", variant: secondary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Guess slope: " (math/round @entity.guessSlope 2)) },
                { type: range-slider, min: -3, max: 3, step: 0.05, value: @entity.guessSlope, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "slope" } },
                { type: typography, variant: caption, content: (str/concat "Guess intercept: " (math/round @entity.guessIntercept 1)) },
                { type: range-slider, min: 0, max: 100, step: 1, value: @entity.guessIntercept, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "intercept" } },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 100, showAxes: true, showGrid: true, gridStep: 20, curves: @entity.curves, points: @entity.points, vectors: [], shapes: @entity.shapes, interactive: true, animate: false },
                { type: typography, variant: body, content: (if @config.showR (str/concat "r = " (math/round @entity.r 3) " — R² = " (math/round @entity.rSquared 3) " — guess score " @entity.guessScore "%") "") }
              ] }
          ]
        })
        (emit REGRESSION_UPDATED { slope: @entity.slope, intercept: @entity.intercept, r: @entity.r, rSquared: @entity.rSquared, pointCount: (array/len @entity.points) })

      DRAG_POINT -> idle when (== @entity.active true)
        (let (
            (pts (array/map @entity.points (fn p
              (if (== (object/get @p id) ?id)
                (object/merge @p { x: (math/clamp ?x 0 100), y: (math/clamp ?y 0 100) })
                @p))))
            (n (array/len @pts))
            (meanX (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p x)))) @n) 0))
            (meanY (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p y)))) @n) 0))
            (sxx (array/reduce @pts 0 (fn (acc p) (let ((dx (- (object/get @p x) @meanX))) (+ @acc (* @dx @dx))))))
            (syy (array/reduce @pts 0 (fn (acc p) (let ((dy (- (object/get @p y) @meanY))) (+ @acc (* @dy @dy))))))
            (sxy (array/reduce @pts 0 (fn (acc p) (+ @acc (* (- (object/get @p x) @meanX) (- (object/get @p y) @meanY))))))
            (newSlope (if (> @sxx 0) (/ @sxy @sxx) 0))
            (newIntercept (- @meanY (* @newSlope @meanX)))
            (newR (if (and (> @sxx 0) (> @syy 0)) (/ @sxy (math/sqrt (* @sxx @syy))) 0))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (residualShapes (if @config.showResiduals
              (array/map @pts (fn p
                (let (
                    (px (+ 24 (* (/ (object/get @p x) 100) @plotW)))
                    (py (- @config.height (+ 24 (* (/ (object/get @p y) 100) @plotH))))
                    (pyLine (- @config.height (+ 24 (* (/ (+ (* @newSlope (object/get @p x)) @newIntercept) 100) @plotH))))
                  )
                  { type: "line", x1: @px, y1: @py, x2: @px, y2: @pyLine, color: "#f59e0b", lineWidth: 1, opacity: 0.7 })))
              []))
            (fitCurve { label: "least squares", color: "#2563eb", samples: [
              { x: 0, y: (math/clamp @newIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @newSlope 100) @newIntercept) 0 100) }
            ]})
            (guessCurve { label: "your guess", color: "#dc2626", samples: [
              { x: 0, y: (math/clamp @entity.guessIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @entity.guessSlope 100) @entity.guessIntercept) 0 100) }
            ]})
          )
          (do
            (set @entity.points @pts)
            (set @entity.slope @newSlope)
            (set @entity.intercept @newIntercept)
            (set @entity.r @newR)
            (set @entity.rSquared (* @newR @newR))
            (set @entity.shapes @residualShapes)
            (set @entity.curves (if (and @config.guessMode (not @entity.revealed))
              (array/append [] @guessCurve)
              (if @config.guessMode
                (array/append (array/append [] @guessCurve) @fitCurve)
                (array/append [] @fitCurve))))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADD_POINT, label: "Add Point", variant: primary },
                    { type: button, action: REVEAL_FIT, label: "Reveal Fit", variant: secondary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Guess slope: " (math/round @entity.guessSlope 2)) },
                { type: range-slider, min: -3, max: 3, step: 0.05, value: @entity.guessSlope, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "slope" } },
                { type: typography, variant: caption, content: (str/concat "Guess intercept: " (math/round @entity.guessIntercept 1)) },
                { type: range-slider, min: 0, max: 100, step: 1, value: @entity.guessIntercept, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "intercept" } },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 100, showAxes: true, showGrid: true, gridStep: 20, curves: @entity.curves, points: @entity.points, vectors: [], shapes: @entity.shapes, interactive: true, animate: false },
                { type: typography, variant: body, content: (if @config.showR (str/concat "r = " (math/round @entity.r 3) " — R² = " (math/round @entity.rSquared 3) " — guess score " @entity.guessScore "%") "") }
              ] }
          ]
        })
        (emit REGRESSION_UPDATED { slope: @entity.slope, intercept: @entity.intercept, r: @entity.r, rSquared: @entity.rSquared, pointCount: (array/len @entity.points) })

      GUESS_LINE -> idle when (== @entity.active true)
        (let (
            (gSlope (if (== ?param "slope") ?value @entity.guessSlope))
            (gIntercept (if (== ?param "intercept") ?value @entity.guessIntercept))
            (pts @entity.points)
            (n (array/len @pts))
            (meanX (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p x)))) @n) 0))
            (meanY (if (> @n 0) (/ (array/reduce @pts 0 (fn (acc p) (+ @acc (object/get @p y)))) @n) 0))
            (sxx (array/reduce @pts 0 (fn (acc p) (let ((dx (- (object/get @p x) @meanX))) (+ @acc (* @dx @dx))))))
            (sxy (array/reduce @pts 0 (fn (acc p) (+ @acc (* (- (object/get @p x) @meanX) (- (object/get @p y) @meanY))))))
            (newSlope (if (> @sxx 0) (/ @sxy @sxx) 0))
            (newIntercept (- @meanY (* @newSlope @meanX)))
            (ssFit (array/reduce @pts 0 (fn (acc p) (let ((e (- (object/get @p y) (+ (* @newSlope (object/get @p x)) @newIntercept)))) (+ @acc (* @e @e))))))
            (ssGuess (array/reduce @pts 0 (fn (acc p) (let ((e (- (object/get @p y) (+ (* @gSlope (object/get @p x)) @gIntercept)))) (+ @acc (* @e @e))))))
            (newScore (if (> @ssGuess 0) (math/round (math/clamp (* 100 (/ @ssFit @ssGuess)) 0 100)) 100))
            (guessCurve { label: "your guess", color: "#dc2626", samples: [
              { x: 0, y: (math/clamp @gIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @gSlope 100) @gIntercept) 0 100) }
            ]})
            (fitCurve { label: "least squares", color: "#2563eb", samples: [
              { x: 0, y: (math/clamp @newIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @newSlope 100) @newIntercept) 0 100) }
            ]})
          )
          (do
            (set @entity.guessSlope @gSlope)
            (set @entity.guessIntercept @gIntercept)
            (set @entity.guessScore @newScore)
            (set @entity.curves (if (and @config.guessMode (not @entity.revealed))
              (array/append [] @guessCurve)
              (if @config.guessMode
                (array/append (array/append [] @guessCurve) @fitCurve)
                (array/append [] @fitCurve))))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADD_POINT, label: "Add Point", variant: primary },
                    { type: button, action: REVEAL_FIT, label: "Reveal Fit", variant: secondary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Guess slope: " (math/round @entity.guessSlope 2)) },
                { type: range-slider, min: -3, max: 3, step: 0.05, value: @entity.guessSlope, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "slope" } },
                { type: typography, variant: caption, content: (str/concat "Guess intercept: " (math/round @entity.guessIntercept 1)) },
                { type: range-slider, min: 0, max: 100, step: 1, value: @entity.guessIntercept, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "intercept" } },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 100, showAxes: true, showGrid: true, gridStep: 20, curves: @entity.curves, points: @entity.points, vectors: [], shapes: @entity.shapes, interactive: true, animate: false },
                { type: typography, variant: body, content: (if @config.showR (str/concat "r = " (math/round @entity.r 3) " — R² = " (math/round @entity.rSquared 3) " — guess score " @entity.guessScore "%") "") }
              ] }
          ]
        })
        (emit REGRESSION_UPDATED { slope: @entity.slope, intercept: @entity.intercept, r: @entity.r, rSquared: @entity.rSquared, pointCount: (array/len @entity.points) })

      REVEAL_FIT -> idle when (== @entity.active true)
        (set @entity.revealed true)
        (let (
            (fitCurve { label: "least squares", color: "#2563eb", samples: [
              { x: 0, y: (math/clamp @entity.intercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @entity.slope 100) @entity.intercept) 0 100) }
            ]})
            (guessCurve { label: "your guess", color: "#dc2626", samples: [
              { x: 0, y: (math/clamp @entity.guessIntercept 0 100) },
              { x: 100, y: (math/clamp (+ (* @entity.guessSlope 100) @entity.guessIntercept) 0 100) }
            ]})
          )
          (set @entity.curves (if @config.guessMode
            (array/append (array/append [] @guessCurve) @fitCurve)
            (array/append [] @fitCurve)))
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: ADD_POINT, label: "Add Point", variant: primary },
                    { type: button, action: REVEAL_FIT, label: "Reveal Fit", variant: secondary }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Guess slope: " (math/round @entity.guessSlope 2)) },
                { type: range-slider, min: -3, max: 3, step: 0.05, value: @entity.guessSlope, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "slope" } },
                { type: typography, variant: caption, content: (str/concat "Guess intercept: " (math/round @entity.guessIntercept 1)) },
                { type: range-slider, min: 0, max: 100, step: 1, value: @entity.guessIntercept, showTooltip: true, action: "GUESS_LINE", actionPayload: { param: "intercept" } },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: 100, yMin: 0, yMax: 100, showAxes: true, showGrid: true, gridStep: 20, curves: @entity.curves, points: @entity.points, vectors: [], shapes: @entity.shapes, interactive: true, animate: false },
                { type: typography, variant: body, content: (if @config.showR (str/concat "r = " (math/round @entity.r 3) " — R² = " (math/round @entity.rSquared 3) " — guess score " @entity.guessScore "%") "") }
              ] }
          ]
        })
        (emit REGRESSION_UPDATED { slope: @entity.slope, intercept: @entity.intercept, r: @entity.r, rSquared: @entity.rSquared, pointCount: (array/len @entity.points) })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      DRAG_POINT {
        id : string
        x : number
        y : number
      }
        @description "A scatter point was dragged — id names the point, x/y its new coordinates; the fit recomputes live."
        @tier "domain"
      GUESS_LINE {
        param : string
        value : number
      }
        @description "Learner dragged a guess-the-line slider — param is slope or intercept; the guess is scored against the least-squares fit."
        @tier "domain"
    }

    emits {
      REGRESSION_UPDATED -> external {
        slope : number
        intercept : number
        r : number
        rSquared : number
        pointCount : number
      }
        @description "The least-squares fit after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "regression update, least squares, line of best fit, correlation"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Least Squares"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      initialPoints : [ProbRegressionPoint] = [
        { id: "p0", x: 15, y: 25, label: "", color: "#334155", radius: 5 },
        { id: "p1", x: 32, y: 40, label: "", color: "#334155", radius: 5 },
        { id: "p2", x: 48, y: 44, label: "", color: "#334155", radius: 5 },
        { id: "p3", x: 63, y: 62, label: "", color: "#334155", radius: 5 },
        { id: "p4", x: 80, y: 70, label: "", color: "#334155", radius: 5 }
      ]
        @label "Initial Points"
        @description "Scatter points the canvas starts with, in 0–100 data coordinates."
        @tier "domain"
      guessMode : boolean = true
        @label "Guess Mode"
        @description "When true the learner's guessed line is shown instead of the fit until Reveal Fit, and the guess is scored against least squares."
        @synonyms "guess the line, prediction, estimate the fit"
        @tier "domain"
      showResiduals : boolean = true
        @label "Show Residuals"
        @description "Draw vertical segments from each point to the regression line — the errors least squares minimizes."
        @synonyms "residuals, errors, deviations"
        @tier "domain"
      showR : boolean = true
        @label "Show r and R²"
        @description "Show the correlation coefficient r and coefficient of determination R² under the canvas."
        @synonyms "correlation coefficient, r squared, goodness of fit"
        @tier "domain"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
    }
  }

  page "/prob-regression" as ProbRegressionPage -> ProbRegressionSim
}
