app ui-chemistry-canvas "1.0.0"
"ChemistryCanvas — UI factory (1:1 with the @almadar/ui chemistry-canvas pattern)."
orbital ChemistryCanvasOrbital {
  type ChemistryCanvasAtomsItem = {
    id : string
    x : number!
    y : number!
    z : number
    element : string
    radius : number
    color : string
    charge : string
    lonePairs : number
  }
  type ChemistryCanvasBondsItem = {
    from : string!
    to : string!
    type : "single" | "double" | "triple"
    color : string
    state : "default" | "forming" | "breaking" | "highlight"
  }
  type ChemistryCanvasArrowsItem = {
    x : number!
    y : number!
    angle : number
    length : number
    color : string
    label : string
  }
  type ChemistryCanvasContainersItem = {
    x : number!
    y : number!
    width : number!
    height : number!
    color : string
    fill : string
    lineWidth : number
    divider : "none" | "solid" | "dashed" | "dotted"
    dividerColor : string
    leftLabel : string
    rightLabel : string
    label : string
    level : number
    levelColor : string
  }
  type ChemistryCanvasLattice3d = {
    basis : [ChemistryCanvasLattice3dBasisItem]!
    nx : number
    ny : number
    nz : number
    latticeConstant : number
    bonds : [ChemistryCanvasLattice3dBondsItem]
    bondRadius : number
    highlightCell : boolean
    dimColor : string
    showLabels : boolean
    selectedId : string
    selectedColor : string
  }
  type ChemistryCanvasLattice3dBasisItem = {
    key : string!
    dx : number!
    dy : number!
    dz : number!
    element : string
    color : string
    radius : number
    xEdge : boolean
    yEdge : boolean
    zEdge : boolean
  }
  type ChemistryCanvasLattice3dBondsItem = {
    from : string!
    to : string!
    dx : number
    dy : number
    dz : number
    color : string
  }
  type ChemistryCanvasShapesItem = {
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ChemistryCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type ChemistryCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type ChemistryCanvasReadoutsItem = {
    label : string!
    value : string!
    color : string
  }
  type ChemistryCanvasTracesItem = {
    x : number
    y : number
    width : number
    height : number
    series : [ChemistryCanvasTracesItemSeriesItem]!
    xLabel : string
    yLabel : string
    frameColor : string
    backgroundColor : string
    backgroundOpacity : number
  }
  type ChemistryCanvasTracesItemSeriesItem = {
    samples : [ChemistryCanvasTracesItemSeriesItemSamplesItem]!
    color : string
    label : string
  }
  type ChemistryCanvasTracesItemSeriesItemSamplesItem = {
    x : number!
    y : number!
  }
  type ChemistryCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type ChemistryCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }

  entity ChemistryCanvasItem [runtime] {
    id : string!
  }

  trait ChemistryCanvasRender -> @rebindable ChemistryCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          atoms: @config.atoms
          bonds: @config.bonds
          arrows: @config.arrows
          bondStyle: @config.bondStyle
          containers: @config.containers
          equation: @config.equation
          equationColor: @config.equationColor
          lattice3d: @config.lattice3d
          shapes: @config.shapes
          readouts: @config.readouts
          traces: @config.traces
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          type: chemistry-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          atoms: @payload.atoms
          bonds: @payload.bonds
          arrows: @payload.arrows
          bondStyle: @config.bondStyle
          containers: @payload.containers
          equation: @config.equation
          equationColor: @config.equationColor
          lattice3d: @config.lattice3d
          shapes: @payload.shapes
          readouts: @payload.readouts
          traces: @payload.traces
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          type: chemistry-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : ChemistryCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
    }

    listens {
      UPDATE {
        atoms : [ChemistryCanvasAtomsItem]
        bonds : [ChemistryCanvasBondsItem]
        arrows : [ChemistryCanvasArrowsItem]
        containers : [ChemistryCanvasContainersItem]
        shapes : [ChemistryCanvasShapesItem]
        readouts : [ChemistryCanvasReadoutsItem]
        traces : [ChemistryCanvasTracesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "backgroundColor prop"
        @tier "presentation"
      mode : "2d" | "3d" = "2d"
        @label "Mode"
        @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host."
        @tier "presentation"
      camera : json = {}
        @label "Camera"
        @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })."
        @tier "presentation"
      lighting : object = {}
        @label "Lighting"
        @description "3D only: scene light rig as data."
        @tier "presentation"
      post : object = {}
        @label "Post"
        @description "3D only: post-processing stack (bloom/vignette)."
        @tier "presentation"
      atoms : [ChemistryCanvasAtomsItem] = []
        @label "Atoms"
        @description "atoms prop"
        @tier "presentation"
      bonds : [ChemistryCanvasBondsItem] = []
        @label "Bonds"
        @description "bonds prop"
        @tier "presentation"
      arrows : [ChemistryCanvasArrowsItem] = []
        @label "Arrows"
        @description "arrows prop"
        @tier "presentation"
      bondStyle : "thick" | "parallel" = thick
        @label "Bond Style"
        @description "Bond line rendering: 'thick' varies stroke width by order (default), 'parallel' draws offset parallel strokes. 2D only."
        @tier "presentation"
      containers : [ChemistryCanvasContainersItem] = []
        @label "Containers"
        @description "Beaker/flask/container outlines (2D only)."
        @synonyms "beaker, flask, box, membrane, burette"
        @tier "presentation"
      equation : string
        @label "Equation"
        @description "Reaction equation text centered at the top of the canvas. 2D only."
        @synonyms "reaction equation, formula"
        @tier "presentation"
      equationColor : string
        @label "Equation Color"
        @description "Equation text color (default '#111827')."
        @tier "presentation"
      lattice3d : ChemistryCanvasLattice3d
        @label "Lattice3d"
        @description "A 3D crystal lattice block (simple cubic, BCC, FCC, rock salt, diamond, ...). 3D only."
        @tier "presentation"
      shapes : [ChemistryCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)."
        @tier "presentation"
      readouts : [ChemistryCanvasReadoutsItem] = []
        @label "Readouts"
        @description "Top-right status chip row, forwarded to LearningCanvas verbatim."
        @tier "presentation"
      traces : [ChemistryCanvasTracesItem] = []
        @label "Traces"
        @description "Inset sparkline panels, forwarded to LearningCanvas verbatim."
        @tier "presentation"
      showGrid : boolean
        @label "Show Grid"
        @description "3D only: show the ground grid (default off)."
        @tier "presentation"
      shadows : boolean
        @label "Shadows"
        @description "3D only: enable shadows. Omitted → the host default."
        @tier "presentation"
      interactive : boolean
        @label "Interactive"
        @description "2D: pointer interaction (click/hover). 3D: orbit camera controls."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "2D only: continuous redraw loop. 3D motion is entity-state driven."
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : ChemistryCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
    }
  }

  page "/chemistry-canvas" as ChemistryCanvasPage -> ChemistryCanvasRender
}
