app std-geo-urban "1.0.0"
"Urban land-use model engine — Burgess concentric, Hoyt sector, and Harris-Ullman multiple-nuclei overlays toggle on a config-declared city map; the learner cycles each zone's land-use tag and checks how many zones match the selected model's prediction, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital GeoUrbanOrbital {
  type GeoUrbanShapePoint = {
    x : number!
    y : number!
  }
  type GeoUrbanShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [GeoUrbanShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type GeoUrbanZone = {
    id : string!
    label : string!
    x : number!
    y : number!
    radius : number!
  }
  type GeoUrbanTag = {
    value : string!
    label : string!
    color : string!
  }
  type GeoUrbanZoneTag = {
    zoneId : string!
    tagIndex : number!
  }
  type GeoUrbanModelExpectation = {
    zoneId : string!
    tag : string!
  }
  type GeoUrbanModel = {
    code : string!
    label : string!
    color : string!
    overlays : [GeoUrbanShape]
    expectations : [GeoUrbanModelExpectation]
  }

  entity GeoUrbanScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    selectedModel : string
    zoneTags : [GeoUrbanZoneTag]
    score : number
    attempts : number
    checkReadout : string
    mapShapes : [GeoUrbanShape]
  }

  trait GeoUrbanSim -> @rebindable GeoUrbanScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.selectedModel "")
        (set @entity.zoneTags (array/map @config.zones (fn z { zoneId: (object/get @z id), tagIndex: 0 })))
        (set @entity.score 0)
        (set @entity.attempts 0)
        (set @entity.checkReadout "")
        (let (
            (modelSel (array/first (array/filter @config.models (fn m (== (object/get @m code) @entity.selectedModel)))))
            (overlayShapes (if (== @modelSel null) [] (array/map (object/get @modelSel overlays) (fn o (object/merge @o { color: (object/get @modelSel color), fill: (object/get @modelSel color), opacity: 0.15 })))))
            (zoneShapes (array/map @config.zones (fn z (let (
                    (zt (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))))
                    (tagIndex (if (== @zt null) 0 (object/get @zt tagIndex)))
                    (tag (array/nth @config.tags @tagIndex))
                  )
                  { type: circle, x: (object/get @z x), y: (object/get @z y), radius: (object/get @z radius), color: (object/get @tag color), fill: (object/get @tag color), opacity: 0.55, lineWidth: 2 }))))
            (zoneLabels (array/map @config.zones (fn z { type: text, x: (object/get @z x), y: (object/get @z y), text: (object/get @z label), fontSize: 11, align: "center", color: @config.textColor })))
            (mapShapes (array/concat (array/concat (array/concat @config.cityLayout @overlayShapes) @zoneShapes) @zoneLabels))
          )
          (do
            (set @entity.mapShapes @mapShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: (array/map @config.models (fn m { type: button, action: TOGGLE_MODEL, actionPayload: { model: (object/get @m code) }, label: (object/get @m label), variant: (if (== @entity.selectedModel (object/get @m code)) "primary" "secondary") })) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.mapShapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: caption, content: "Click a zone button to cycle its land-use tag, then check how well your tagging fits the selected model." },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.zones (fn z { type: button, action: TAG_ZONE, actionPayload: { zone: (object/get @z id) }, label: (str/concat (object/get @z label) ": " (object/get (array/nth @config.tags (object/get (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))) tagIndex)) label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CHECK, label: "Check Model Fit", variant: primary }
                  ] },
                { type: typography, variant: body, content: @entity.checkReadout },
                { type: typography, variant: body, content: (str/concat "Score: " @entity.score " / " (array/len @config.zones) " — attempts: " @entity.attempts) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.selectedModel "")
        (set @entity.zoneTags (array/map @config.zones (fn z { zoneId: (object/get @z id), tagIndex: 0 })))
        (set @entity.score 0)
        (set @entity.attempts 0)
        (set @entity.checkReadout "")
        (let (
            (modelSel (array/first (array/filter @config.models (fn m (== (object/get @m code) @entity.selectedModel)))))
            (overlayShapes (if (== @modelSel null) [] (array/map (object/get @modelSel overlays) (fn o (object/merge @o { color: (object/get @modelSel color), fill: (object/get @modelSel color), opacity: 0.15 })))))
            (zoneShapes (array/map @config.zones (fn z (let (
                    (zt (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))))
                    (tagIndex (if (== @zt null) 0 (object/get @zt tagIndex)))
                    (tag (array/nth @config.tags @tagIndex))
                  )
                  { type: circle, x: (object/get @z x), y: (object/get @z y), radius: (object/get @z radius), color: (object/get @tag color), fill: (object/get @tag color), opacity: 0.55, lineWidth: 2 }))))
            (zoneLabels (array/map @config.zones (fn z { type: text, x: (object/get @z x), y: (object/get @z y), text: (object/get @z label), fontSize: 11, align: "center", color: @config.textColor })))
            (mapShapes (array/concat (array/concat (array/concat @config.cityLayout @overlayShapes) @zoneShapes) @zoneLabels))
          )
          (do
            (set @entity.mapShapes @mapShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: (array/map @config.models (fn m { type: button, action: TOGGLE_MODEL, actionPayload: { model: (object/get @m code) }, label: (object/get @m label), variant: (if (== @entity.selectedModel (object/get @m code)) "primary" "secondary") })) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.mapShapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: caption, content: "Click a zone button to cycle its land-use tag, then check how well your tagging fits the selected model." },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.zones (fn z { type: button, action: TAG_ZONE, actionPayload: { zone: (object/get @z id) }, label: (str/concat (object/get @z label) ": " (object/get (array/nth @config.tags (object/get (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))) tagIndex)) label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CHECK, label: "Check Model Fit", variant: primary }
                  ] },
                { type: typography, variant: body, content: @entity.checkReadout },
                { type: typography, variant: body, content: (str/concat "Score: " @entity.score " / " (array/len @config.zones) " — attempts: " @entity.attempts) }
              ] }
          ]
        })

      TOGGLE_MODEL -> idle when (== @entity.active true)
        (set @entity.selectedModel (if (== @entity.selectedModel ?model) "" ?model))
        (set @entity.checkReadout "")
        (let (
            (modelSel (array/first (array/filter @config.models (fn m (== (object/get @m code) @entity.selectedModel)))))
            (overlayShapes (if (== @modelSel null) [] (array/map (object/get @modelSel overlays) (fn o (object/merge @o { color: (object/get @modelSel color), fill: (object/get @modelSel color), opacity: 0.15 })))))
            (zoneShapes (array/map @config.zones (fn z (let (
                    (zt (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))))
                    (tagIndex (if (== @zt null) 0 (object/get @zt tagIndex)))
                    (tag (array/nth @config.tags @tagIndex))
                  )
                  { type: circle, x: (object/get @z x), y: (object/get @z y), radius: (object/get @z radius), color: (object/get @tag color), fill: (object/get @tag color), opacity: 0.55, lineWidth: 2 }))))
            (zoneLabels (array/map @config.zones (fn z { type: text, x: (object/get @z x), y: (object/get @z y), text: (object/get @z label), fontSize: 11, align: "center", color: @config.textColor })))
            (mapShapes (array/concat (array/concat (array/concat @config.cityLayout @overlayShapes) @zoneShapes) @zoneLabels))
          )
          (do
            (set @entity.mapShapes @mapShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: (array/map @config.models (fn m { type: button, action: TOGGLE_MODEL, actionPayload: { model: (object/get @m code) }, label: (object/get @m label), variant: (if (== @entity.selectedModel (object/get @m code)) "primary" "secondary") })) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.mapShapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: caption, content: "Click a zone button to cycle its land-use tag, then check how well your tagging fits the selected model." },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.zones (fn z { type: button, action: TAG_ZONE, actionPayload: { zone: (object/get @z id) }, label: (str/concat (object/get @z label) ": " (object/get (array/nth @config.tags (object/get (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))) tagIndex)) label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CHECK, label: "Check Model Fit", variant: primary }
                  ] },
                { type: typography, variant: body, content: @entity.checkReadout },
                { type: typography, variant: body, content: (str/concat "Score: " @entity.score " / " (array/len @config.zones) " — attempts: " @entity.attempts) }
              ] }
          ]
        })
        (emit URBAN_UPDATED { selectedModel: @entity.selectedModel, score: @entity.score, attempts: @entity.attempts })

      TAG_ZONE -> idle when (== @entity.active true)
        (let (
            (zt (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) ?zone)))))
            (currentIndex (if (== @zt null) 0 (object/get @zt tagIndex)))
            (nextIndex (math/mod (+ @currentIndex 1) (array/len @config.tags)))
            (newZoneTags (array/map @entity.zoneTags (fn t (if (== (object/get @t zoneId) ?zone) (object/merge @t { tagIndex: @nextIndex }) @t))))
          )
          (do
            (set @entity.zoneTags @newZoneTags)
          )
        )
        (let (
            (modelSel (array/first (array/filter @config.models (fn m (== (object/get @m code) @entity.selectedModel)))))
            (overlayShapes (if (== @modelSel null) [] (array/map (object/get @modelSel overlays) (fn o (object/merge @o { color: (object/get @modelSel color), fill: (object/get @modelSel color), opacity: 0.15 })))))
            (zoneShapes (array/map @config.zones (fn z (let (
                    (zt2 (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))))
                    (tagIndex (if (== @zt2 null) 0 (object/get @zt2 tagIndex)))
                    (tag (array/nth @config.tags @tagIndex))
                  )
                  { type: circle, x: (object/get @z x), y: (object/get @z y), radius: (object/get @z radius), color: (object/get @tag color), fill: (object/get @tag color), opacity: 0.55, lineWidth: 2 }))))
            (zoneLabels (array/map @config.zones (fn z { type: text, x: (object/get @z x), y: (object/get @z y), text: (object/get @z label), fontSize: 11, align: "center", color: @config.textColor })))
            (mapShapes (array/concat (array/concat (array/concat @config.cityLayout @overlayShapes) @zoneShapes) @zoneLabels))
          )
          (do
            (set @entity.mapShapes @mapShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: (array/map @config.models (fn m { type: button, action: TOGGLE_MODEL, actionPayload: { model: (object/get @m code) }, label: (object/get @m label), variant: (if (== @entity.selectedModel (object/get @m code)) "primary" "secondary") })) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.mapShapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: caption, content: "Click a zone button to cycle its land-use tag, then check how well your tagging fits the selected model." },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.zones (fn z { type: button, action: TAG_ZONE, actionPayload: { zone: (object/get @z id) }, label: (str/concat (object/get @z label) ": " (object/get (array/nth @config.tags (object/get (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))) tagIndex)) label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CHECK, label: "Check Model Fit", variant: primary }
                  ] },
                { type: typography, variant: body, content: @entity.checkReadout },
                { type: typography, variant: body, content: (str/concat "Score: " @entity.score " / " (array/len @config.zones) " — attempts: " @entity.attempts) }
              ] }
          ]
        })
        (emit URBAN_UPDATED { selectedModel: @entity.selectedModel, score: @entity.score, attempts: @entity.attempts })

      CHECK -> idle when (== @entity.active true)
        (let (
            (modelSel (array/first (array/filter @config.models (fn m (== (object/get @m code) @entity.selectedModel)))))
            (hasModel (!= @modelSel null))
            (expectations (if @hasModel (object/get @modelSel expectations) []))
            (hits (array/filter @entity.zoneTags (fn t (let (
                    (exp (array/first (array/filter @expectations (fn e (== (object/get @e zoneId) (object/get @t zoneId))))))
                    (expectedTag (if (== @exp null) "" (object/get @exp tag)))
                    (actualTag (object/get (array/nth @config.tags (object/get @t tagIndex)) value))
                  )
                  (== @actualTag @expectedTag)))))
            (hitCount (array/len @hits))
            (zoneCount (array/len @config.zones))
          )
          (do
            (set @entity.score (if @hasModel @hitCount 0))
            (set @entity.attempts (if @hasModel (+ @entity.attempts 1) @entity.attempts))
            (set @entity.checkReadout (if @hasModel (str/concat (object/get @modelSel label) " fit: " @hitCount " / " @zoneCount " zones tagged as the model predicts") "Select a model overlay first, then tag the zones."))
          )
        )
        (let (
            (modelSel (array/first (array/filter @config.models (fn m (== (object/get @m code) @entity.selectedModel)))))
            (overlayShapes (if (== @modelSel null) [] (array/map (object/get @modelSel overlays) (fn o (object/merge @o { color: (object/get @modelSel color), fill: (object/get @modelSel color), opacity: 0.15 })))))
            (zoneShapes (array/map @config.zones (fn z (let (
                    (zt (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))))
                    (tagIndex (if (== @zt null) 0 (object/get @zt tagIndex)))
                    (tag (array/nth @config.tags @tagIndex))
                  )
                  { type: circle, x: (object/get @z x), y: (object/get @z y), radius: (object/get @z radius), color: (object/get @tag color), fill: (object/get @tag color), opacity: 0.55, lineWidth: 2 }))))
            (zoneLabels (array/map @config.zones (fn z { type: text, x: (object/get @z x), y: (object/get @z y), text: (object/get @z label), fontSize: 11, align: "center", color: @config.textColor })))
            (mapShapes (array/concat (array/concat (array/concat @config.cityLayout @overlayShapes) @zoneShapes) @zoneLabels))
          )
          (do
            (set @entity.mapShapes @mapShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: (array/map @config.models (fn m { type: button, action: TOGGLE_MODEL, actionPayload: { model: (object/get @m code) }, label: (object/get @m label), variant: (if (== @entity.selectedModel (object/get @m code)) "primary" "secondary") })) },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.mapShapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: caption, content: "Click a zone button to cycle its land-use tag, then check how well your tagging fits the selected model." },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.zones (fn z { type: button, action: TAG_ZONE, actionPayload: { zone: (object/get @z id) }, label: (str/concat (object/get @z label) ": " (object/get (array/nth @config.tags (object/get (array/first (array/filter @entity.zoneTags (fn t (== (object/get @t zoneId) (object/get @z id))))) tagIndex)) label)), variant: secondary, size: sm })) },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CHECK, label: "Check Model Fit", variant: primary }
                  ] },
                { type: typography, variant: body, content: @entity.checkReadout },
                { type: typography, variant: body, content: (str/concat "Score: " @entity.score " / " (array/len @config.zones) " — attempts: " @entity.attempts) }
              ] }
          ]
        })
        (emit URBAN_UPDATED { selectedModel: @entity.selectedModel, score: @entity.score, attempts: @entity.attempts })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      TOGGLE_MODEL {
        model : string
      }
        @description "Learner toggled an urban model overlay (Burgess, Hoyt, or Harris-Ullman) on the city map."
        @tier "domain"
      TAG_ZONE {
        zone : string
      }
        @description "Learner cycled a zone's land-use tag to the next category."
        @tier "domain"
      CHECK {
      }
        @description "Learner asked how many zones are tagged as the selected model predicts."
        @tier "domain"
    }

    emits {
      URBAN_UPDATED -> external {
        selectedModel : string
        score : number
        attempts : number
      }
        @description "The urban model state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "urban model, Burgess, concentric zone, Hoyt, sector model, Harris-Ullman, multiple nuclei, land use, zone tagging, model fit"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Urban Land-Use Models"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 460
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      models : [GeoUrbanModel] = [
        { code: "burgess", label: "Burgess Concentric", color: "#8b5cf6", overlays: [
            { type: circle, x: 320, y: 220, radius: 70, lineWidth: 2 },
            { type: circle, x: 320, y: 220, radius: 140, lineWidth: 2 },
            { type: circle, x: 320, y: 220, radius: 210, lineWidth: 2 }
          ], expectations: [
            { zoneId: "z1", tag: "commerce" },
            { zoneId: "z2", tag: "industry" },
            { zoneId: "z3", tag: "industry" },
            { zoneId: "z4", tag: "industry" },
            { zoneId: "z5", tag: "residential" }
          ] },
        { code: "hoyt", label: "Hoyt Sector", color: "#0ea5e9", overlays: [
            { type: polygon, points: [ { x: 320, y: 220 }, { x: 640, y: 170 }, { x: 640, y: 270 } ], lineWidth: 2 },
            { type: polygon, points: [ { x: 320, y: 220 }, { x: 0, y: 170 }, { x: 0, y: 270 } ], lineWidth: 2 }
          ], expectations: [
            { zoneId: "z1", tag: "commerce" },
            { zoneId: "z2", tag: "residential" },
            { zoneId: "z3", tag: "industry" },
            { zoneId: "z4", tag: "industry" },
            { zoneId: "z5", tag: "residential" }
          ] },
        { code: "harris", label: "Harris-Ullman Nuclei", color: "#e11d48", overlays: [
            { type: circle, x: 320, y: 220, radius: 50, lineWidth: 2 },
            { type: circle, x: 460, y: 220, radius: 55, lineWidth: 2 },
            { type: circle, x: 180, y: 220, radius: 55, lineWidth: 2 }
          ], expectations: [
            { zoneId: "z1", tag: "commerce" },
            { zoneId: "z2", tag: "residential" },
            { zoneId: "z3", tag: "commerce" },
            { zoneId: "z4", tag: "industry" },
            { zoneId: "z5", tag: "residential" }
          ] }
      ]
        @label "Urban Models"
        @description "The urban land-use models the learner can overlay; each declares its overlay shapes (recolored to the model color when active) and the land-use tag it predicts for every zone, used by Check Model Fit."
        @synonyms "Burgess, concentric zone model, Hoyt, sector model, Harris-Ullman, multiple nuclei model, urban model, city structure"
        @tier "domain"
      zones : [GeoUrbanZone] = [
        { id: "z1", label: "Central", x: 320, y: 220, radius: 32 },
        { id: "z2", label: "North", x: 320, y: 110, radius: 30 },
        { id: "z3", label: "East", x: 470, y: 220, radius: 30 },
        { id: "z4", label: "West", x: 170, y: 220, radius: 30 },
        { id: "z5", label: "South", x: 320, y: 340, radius: 30 }
      ]
        @label "City Zones"
        @description "Taggable city zones drawn as circles on the map; the learner cycles each zone's land-use tag."
        @synonyms "urban zone, city district, land-use zone, CBD, inner city, suburb"
        @tier "domain"
      cityLayout : [GeoUrbanShape] = [
        { type: line, x1: 0, y1: 295, x2: 640, y2: 335, color: "#38bdf8", lineWidth: 6, opacity: 0.35 },
        { type: line, x1: 60, y1: 220, x2: 580, y2: 220, color: "#475569", lineWidth: 3, opacity: 0.6 },
        { type: rect, x: 305, y: 205, width: 30, height: 30, color: "#334155", fill: "#334155", opacity: 0.3 }
      ]
        @label "City Layout"
        @description "Neutral base-map shapes always drawn under the zones and model overlays (river, transport corridor, central business district marker)."
        @synonyms "city map, base map, river, transport corridor, CBD"
        @tier "domain"
      tags : [GeoUrbanTag] = [
        { value: "commerce", label: "Commerce", color: "#f59e0b" },
        { value: "industry", label: "Industry", color: "#64748b" },
        { value: "residential", label: "Residential", color: "#22c55e" }
      ]
        @label "Land-Use Tags"
        @description "Ordered land-use categories a zone button cycles through; also the vocabulary the models' expectations refer to."
        @synonyms "land use, commercial, industrial, residential, zoning"
        @tier "domain"
      textColor : string = "#1e293b"
        @label "Text Color"
        @tier "presentation"
    }
  }

  page "/geo-urban" as GeoUrbanPage -> GeoUrbanSim
}
