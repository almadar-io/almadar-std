app std-civics-electoral "1.0.0"
"Electoral-college sandbox — flip swing states and watch Red/Blue electoral-vote totals race the 270 threshold, with a popular-vs-electoral split readout, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital CivicsElectoralOrbital {
  type CivicsElectoralShapePoint = {
    x : number!
    y : number!
  }
  type CivicsElectoralShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [CivicsElectoralShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type CivicsElectoralState = {
    id : string!
    name : string
    col : number!
    row : number!
    popShare : number!
    swing : boolean!
  }
  type CivicsElectoralEVCount = {
    id : string!
    ev : number!
  }
  type CivicsElectoralWinner = {
    id : string!
    winner : "red" | "blue" | "tossup"!
  }
  type CivicsElectoralScenario = {
    index : number!
    name : string!
    map : [CivicsElectoralWinner]!
  }

  entity CivicsElectoralScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    winnerMap : [json]
    scenarioName : string
    redEV : number
    blueEV : number
    tossupEV : number
    redPop : number
    bluePop : number
    splitNote : string
    renderChildren : [json]
  }

  trait CivicsElectoralSim -> @rebindable CivicsElectoralScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (let (
            (winnerMap @config.baselineMap)
            (scenarioName "Baseline")
            (totalEV (array/reduce @config.evCounts 0 (fn (acc e) (+ @acc (object/get @e ev)))))
            (redEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @evc ev)) @acc)))))
            (blueEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @evc ev)) @acc)))))
            (tossupEV (- @totalEV (+ @redEV @blueEV)))
            (redPopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @s popShare)) @acc)))))
            (bluePopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @s popShare)) @acc)))))
            (redPop (math/round @redPopRaw 1))
            (bluePop (math/round @bluePopRaw 1))
            (elecWinner (if (>= @redEV @config.threshold) "red" (if (>= @blueEV @config.threshold) "blue" "none")))
            (popLeader (if (> @redPop @bluePop) "red" (if (> @bluePop @redPop) "blue" "tied")))
            (splitNote (if (and (!= @elecWinner "none") (!= @elecWinner @popLeader)) " — split decision: the electoral winner trails in the popular vote" ""))
            (winnerText (if (== @elecWinner "red") "Red reaches 270 — wins the presidency" (if (== @elecWinner "blue") "Blue reaches 270 — wins the presidency" (str/concat "No majority yet — " @tossupEV " tossup EV outstanding"))))
            (winnerVariant (if (== @elecWinner "none") "info" "success"))
            (tileW (/ (- @config.width 50) 4))
            (tileH 56)
            (tileRects (array/map @config.states (fn s (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (fillC (if (== (object/get @w winner) "red") @config.redColor (if (== (object/get @w winner) "blue") @config.blueColor @config.tossupColor)))
              )
              { type: rect, id: (str/concat "tile-" (object/get @s id)), x: (+ 10 (* (object/get @s col) (+ @tileW 10))), y: (+ 10 (* (object/get @s row) (+ @tileH 10))), width: @tileW, height: @tileH, color: @fillC, fill: @fillC, opacity: 0.85, lineWidth: 1 }))))
            (tileLabels (array/map @config.states (fn s (let (
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              { type: text, id: (str/concat "tile-label-" (object/get @s id)), x: (+ (+ 10 (* (object/get @s col) (+ @tileW 10))) (/ @tileW 2)), y: (+ (+ 10 (* (object/get @s row) (+ @tileH 10))) (/ @tileH 2)), text: (str/concat (object/get @s id) " · " (object/get @evc ev)), fontSize: 13, align: "center", color: "#ffffff" }))))
            (barY (+ 30 (* 4 (+ @tileH 10))))
            (scale (/ (- @config.width 80) @totalEV))
            (thresholdX (+ 40 (* @config.threshold @scale)))
            (barShapes [
                { type: rect, id: "red-bar", x: 40, y: @barY, width: (* @redEV @scale), height: 28, color: @config.redColor, fill: @config.redColor, lineWidth: 1 },
                { type: text, id: "red-bar-label", x: 44, y: (+ @barY 18), text: (str/concat "Red " @redEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: rect, id: "blue-bar", x: 40, y: (+ @barY 40), width: (* @blueEV @scale), height: 28, color: @config.blueColor, fill: @config.blueColor, lineWidth: 1 },
                { type: text, id: "blue-bar-label", x: 44, y: (+ @barY 58), text: (str/concat "Blue " @blueEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: line, id: "threshold-line", x1: @thresholdX, y1: (- @barY 6), x2: @thresholdX, y2: (+ @barY 74), color: "#0f172a", lineWidth: 2 },
                { type: text, id: "threshold-label", x: @thresholdX, y: (- @barY 12), text: (str/concat @config.threshold " to win"), fontSize: 12, align: "center", color: "#0f172a" }
              ])
            (shapes (array/concat (array/concat @tileRects @tileLabels) @barShapes))
            (swingStates (array/filter @config.states (fn s (== (object/get @s swing) true))))
            (toggleButtons (array/map @swingStates (fn s { type: button, action: TOGGLE_STATE, actionPayload: { stateId: (object/get @s id) }, label: (str/concat "Flip " (object/get @s id)), variant: secondary })))
            (scenarioButtons (array/map @config.scenarios (fn sc { type: button, action: LOAD_SCENARIO, actionPayload: { index: (object/get @sc index) }, label: (object/get @sc name), variant: (if (== @scenarioName (object/get @sc name)) "primary" "ghost") })))
            (splitLine (str/concat "Popular vote share — Red " @redPop "% · Blue " @bluePop "%" @splitNote))
            (children [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Flip the swing states — the first ticket to 270 electoral votes wins the presidency." },
                { type: stack, direction: horizontal, gap: sm, children: @toggleButtons },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @splitLine },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "EV — Red " @redEV " · Blue " @blueEV " · Tossup " @tossupEV), variant: info },
                    { type: badge, label: @winnerText, variant: @winnerVariant }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: (array/concat @scenarioButtons [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ]) }
              ])
          )
          (do
            (set @entity.winnerMap @winnerMap)
            (set @entity.scenarioName @scenarioName)
            (set @entity.redEV @redEV)
            (set @entity.blueEV @blueEV)
            (set @entity.tossupEV @tossupEV)
            (set @entity.redPop @redPop)
            (set @entity.bluePop @bluePop)
            (set @entity.splitNote @splitNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit ELECTORAL_UPDATED { redEV: @entity.redEV, blueEV: @entity.blueEV, tossupEV: @entity.tossupEV, redPop: @entity.redPop, bluePop: @entity.bluePop, splitNote: @entity.splitNote, scenarioName: @entity.scenarioName })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (let (
            (winnerMap @config.baselineMap)
            (scenarioName "Baseline")
            (totalEV (array/reduce @config.evCounts 0 (fn (acc e) (+ @acc (object/get @e ev)))))
            (redEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @evc ev)) @acc)))))
            (blueEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @evc ev)) @acc)))))
            (tossupEV (- @totalEV (+ @redEV @blueEV)))
            (redPopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @s popShare)) @acc)))))
            (bluePopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @s popShare)) @acc)))))
            (redPop (math/round @redPopRaw 1))
            (bluePop (math/round @bluePopRaw 1))
            (elecWinner (if (>= @redEV @config.threshold) "red" (if (>= @blueEV @config.threshold) "blue" "none")))
            (popLeader (if (> @redPop @bluePop) "red" (if (> @bluePop @redPop) "blue" "tied")))
            (splitNote (if (and (!= @elecWinner "none") (!= @elecWinner @popLeader)) " — split decision: the electoral winner trails in the popular vote" ""))
            (winnerText (if (== @elecWinner "red") "Red reaches 270 — wins the presidency" (if (== @elecWinner "blue") "Blue reaches 270 — wins the presidency" (str/concat "No majority yet — " @tossupEV " tossup EV outstanding"))))
            (winnerVariant (if (== @elecWinner "none") "info" "success"))
            (tileW (/ (- @config.width 50) 4))
            (tileH 56)
            (tileRects (array/map @config.states (fn s (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (fillC (if (== (object/get @w winner) "red") @config.redColor (if (== (object/get @w winner) "blue") @config.blueColor @config.tossupColor)))
              )
              { type: rect, id: (str/concat "tile-" (object/get @s id)), x: (+ 10 (* (object/get @s col) (+ @tileW 10))), y: (+ 10 (* (object/get @s row) (+ @tileH 10))), width: @tileW, height: @tileH, color: @fillC, fill: @fillC, opacity: 0.85, lineWidth: 1 }))))
            (tileLabels (array/map @config.states (fn s (let (
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              { type: text, id: (str/concat "tile-label-" (object/get @s id)), x: (+ (+ 10 (* (object/get @s col) (+ @tileW 10))) (/ @tileW 2)), y: (+ (+ 10 (* (object/get @s row) (+ @tileH 10))) (/ @tileH 2)), text: (str/concat (object/get @s id) " · " (object/get @evc ev)), fontSize: 13, align: "center", color: "#ffffff" }))))
            (barY (+ 30 (* 4 (+ @tileH 10))))
            (scale (/ (- @config.width 80) @totalEV))
            (thresholdX (+ 40 (* @config.threshold @scale)))
            (barShapes [
                { type: rect, id: "red-bar", x: 40, y: @barY, width: (* @redEV @scale), height: 28, color: @config.redColor, fill: @config.redColor, lineWidth: 1 },
                { type: text, id: "red-bar-label", x: 44, y: (+ @barY 18), text: (str/concat "Red " @redEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: rect, id: "blue-bar", x: 40, y: (+ @barY 40), width: (* @blueEV @scale), height: 28, color: @config.blueColor, fill: @config.blueColor, lineWidth: 1 },
                { type: text, id: "blue-bar-label", x: 44, y: (+ @barY 58), text: (str/concat "Blue " @blueEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: line, id: "threshold-line", x1: @thresholdX, y1: (- @barY 6), x2: @thresholdX, y2: (+ @barY 74), color: "#0f172a", lineWidth: 2 },
                { type: text, id: "threshold-label", x: @thresholdX, y: (- @barY 12), text: (str/concat @config.threshold " to win"), fontSize: 12, align: "center", color: "#0f172a" }
              ])
            (shapes (array/concat (array/concat @tileRects @tileLabels) @barShapes))
            (swingStates (array/filter @config.states (fn s (== (object/get @s swing) true))))
            (toggleButtons (array/map @swingStates (fn s { type: button, action: TOGGLE_STATE, actionPayload: { stateId: (object/get @s id) }, label: (str/concat "Flip " (object/get @s id)), variant: secondary })))
            (scenarioButtons (array/map @config.scenarios (fn sc { type: button, action: LOAD_SCENARIO, actionPayload: { index: (object/get @sc index) }, label: (object/get @sc name), variant: (if (== @scenarioName (object/get @sc name)) "primary" "ghost") })))
            (splitLine (str/concat "Popular vote share — Red " @redPop "% · Blue " @bluePop "%" @splitNote))
            (children [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Flip the swing states — the first ticket to 270 electoral votes wins the presidency." },
                { type: stack, direction: horizontal, gap: sm, children: @toggleButtons },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @splitLine },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "EV — Red " @redEV " · Blue " @blueEV " · Tossup " @tossupEV), variant: info },
                    { type: badge, label: @winnerText, variant: @winnerVariant }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: (array/concat @scenarioButtons [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ]) }
              ])
          )
          (do
            (set @entity.winnerMap @winnerMap)
            (set @entity.scenarioName @scenarioName)
            (set @entity.redEV @redEV)
            (set @entity.blueEV @blueEV)
            (set @entity.tossupEV @tossupEV)
            (set @entity.redPop @redPop)
            (set @entity.bluePop @bluePop)
            (set @entity.splitNote @splitNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit ELECTORAL_UPDATED { redEV: @entity.redEV, blueEV: @entity.blueEV, tossupEV: @entity.tossupEV, redPop: @entity.redPop, bluePop: @entity.bluePop, splitNote: @entity.splitNote, scenarioName: @entity.scenarioName })

      TOGGLE_STATE -> idle when (== @entity.active true)
        (let (
            (st (array/first (array/filter @config.states (fn s (== (object/get @s id) ?stateId)))))
            (isSwing (if (== @st null) false (object/get @st swing)))
            (cur (array/first (array/filter @entity.winnerMap (fn m (== (object/get @m id) ?stateId)))))
            (curWinner (if (== @cur null) "tossup" (object/get @cur winner)))
            (cycledWinner (if (== @curWinner "red") "blue" (if (== @curWinner "blue") "tossup" "red")))
            (newWinner (if @isSwing @cycledWinner @curWinner))
            (winnerMap (if @isSwing (array/map @entity.winnerMap (fn m (if (== (object/get @m id) ?stateId) { id: ?stateId, winner: @newWinner } @m))) @entity.winnerMap))
            (scenarioName @entity.scenarioName)
            (totalEV (array/reduce @config.evCounts 0 (fn (acc e) (+ @acc (object/get @e ev)))))
            (redEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @evc ev)) @acc)))))
            (blueEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @evc ev)) @acc)))))
            (tossupEV (- @totalEV (+ @redEV @blueEV)))
            (redPopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @s popShare)) @acc)))))
            (bluePopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @s popShare)) @acc)))))
            (redPop (math/round @redPopRaw 1))
            (bluePop (math/round @bluePopRaw 1))
            (elecWinner (if (>= @redEV @config.threshold) "red" (if (>= @blueEV @config.threshold) "blue" "none")))
            (popLeader (if (> @redPop @bluePop) "red" (if (> @bluePop @redPop) "blue" "tied")))
            (splitNote (if (and (!= @elecWinner "none") (!= @elecWinner @popLeader)) " — split decision: the electoral winner trails in the popular vote" ""))
            (winnerText (if (== @elecWinner "red") "Red reaches 270 — wins the presidency" (if (== @elecWinner "blue") "Blue reaches 270 — wins the presidency" (str/concat "No majority yet — " @tossupEV " tossup EV outstanding"))))
            (winnerVariant (if (== @elecWinner "none") "info" "success"))
            (tileW (/ (- @config.width 50) 4))
            (tileH 56)
            (tileRects (array/map @config.states (fn s (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (fillC (if (== (object/get @w winner) "red") @config.redColor (if (== (object/get @w winner) "blue") @config.blueColor @config.tossupColor)))
              )
              { type: rect, id: (str/concat "tile-" (object/get @s id)), x: (+ 10 (* (object/get @s col) (+ @tileW 10))), y: (+ 10 (* (object/get @s row) (+ @tileH 10))), width: @tileW, height: @tileH, color: @fillC, fill: @fillC, opacity: 0.85, lineWidth: 1 }))))
            (tileLabels (array/map @config.states (fn s (let (
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              { type: text, id: (str/concat "tile-label-" (object/get @s id)), x: (+ (+ 10 (* (object/get @s col) (+ @tileW 10))) (/ @tileW 2)), y: (+ (+ 10 (* (object/get @s row) (+ @tileH 10))) (/ @tileH 2)), text: (str/concat (object/get @s id) " · " (object/get @evc ev)), fontSize: 13, align: "center", color: "#ffffff" }))))
            (barY (+ 30 (* 4 (+ @tileH 10))))
            (scale (/ (- @config.width 80) @totalEV))
            (thresholdX (+ 40 (* @config.threshold @scale)))
            (barShapes [
                { type: rect, id: "red-bar", x: 40, y: @barY, width: (* @redEV @scale), height: 28, color: @config.redColor, fill: @config.redColor, lineWidth: 1 },
                { type: text, id: "red-bar-label", x: 44, y: (+ @barY 18), text: (str/concat "Red " @redEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: rect, id: "blue-bar", x: 40, y: (+ @barY 40), width: (* @blueEV @scale), height: 28, color: @config.blueColor, fill: @config.blueColor, lineWidth: 1 },
                { type: text, id: "blue-bar-label", x: 44, y: (+ @barY 58), text: (str/concat "Blue " @blueEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: line, id: "threshold-line", x1: @thresholdX, y1: (- @barY 6), x2: @thresholdX, y2: (+ @barY 74), color: "#0f172a", lineWidth: 2 },
                { type: text, id: "threshold-label", x: @thresholdX, y: (- @barY 12), text: (str/concat @config.threshold " to win"), fontSize: 12, align: "center", color: "#0f172a" }
              ])
            (shapes (array/concat (array/concat @tileRects @tileLabels) @barShapes))
            (swingStates (array/filter @config.states (fn s (== (object/get @s swing) true))))
            (toggleButtons (array/map @swingStates (fn s { type: button, action: TOGGLE_STATE, actionPayload: { stateId: (object/get @s id) }, label: (str/concat "Flip " (object/get @s id)), variant: secondary })))
            (scenarioButtons (array/map @config.scenarios (fn sc { type: button, action: LOAD_SCENARIO, actionPayload: { index: (object/get @sc index) }, label: (object/get @sc name), variant: (if (== @scenarioName (object/get @sc name)) "primary" "ghost") })))
            (splitLine (str/concat "Popular vote share — Red " @redPop "% · Blue " @bluePop "%" @splitNote))
            (children [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Flip the swing states — the first ticket to 270 electoral votes wins the presidency." },
                { type: stack, direction: horizontal, gap: sm, children: @toggleButtons },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @splitLine },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "EV — Red " @redEV " · Blue " @blueEV " · Tossup " @tossupEV), variant: info },
                    { type: badge, label: @winnerText, variant: @winnerVariant }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: (array/concat @scenarioButtons [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ]) }
              ])
          )
          (do
            (set @entity.winnerMap @winnerMap)
            (set @entity.scenarioName @scenarioName)
            (set @entity.redEV @redEV)
            (set @entity.blueEV @blueEV)
            (set @entity.tossupEV @tossupEV)
            (set @entity.redPop @redPop)
            (set @entity.bluePop @bluePop)
            (set @entity.splitNote @splitNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit ELECTORAL_UPDATED { redEV: @entity.redEV, blueEV: @entity.blueEV, tossupEV: @entity.tossupEV, redPop: @entity.redPop, bluePop: @entity.bluePop, splitNote: @entity.splitNote, scenarioName: @entity.scenarioName })

      LOAD_SCENARIO -> idle when (== @entity.active true)
        (let (
            (scen (array/first (array/filter @config.scenarios (fn sc (== (object/get @sc index) ?index)))))
            (winnerMap (if (== @scen null) @config.baselineMap (object/get @scen map)))
            (scenarioName (if (== @scen null) "Baseline" (object/get @scen name)))
            (totalEV (array/reduce @config.evCounts 0 (fn (acc e) (+ @acc (object/get @e ev)))))
            (redEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @evc ev)) @acc)))))
            (blueEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @evc ev)) @acc)))))
            (tossupEV (- @totalEV (+ @redEV @blueEV)))
            (redPopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @s popShare)) @acc)))))
            (bluePopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @s popShare)) @acc)))))
            (redPop (math/round @redPopRaw 1))
            (bluePop (math/round @bluePopRaw 1))
            (elecWinner (if (>= @redEV @config.threshold) "red" (if (>= @blueEV @config.threshold) "blue" "none")))
            (popLeader (if (> @redPop @bluePop) "red" (if (> @bluePop @redPop) "blue" "tied")))
            (splitNote (if (and (!= @elecWinner "none") (!= @elecWinner @popLeader)) " — split decision: the electoral winner trails in the popular vote" ""))
            (winnerText (if (== @elecWinner "red") "Red reaches 270 — wins the presidency" (if (== @elecWinner "blue") "Blue reaches 270 — wins the presidency" (str/concat "No majority yet — " @tossupEV " tossup EV outstanding"))))
            (winnerVariant (if (== @elecWinner "none") "info" "success"))
            (tileW (/ (- @config.width 50) 4))
            (tileH 56)
            (tileRects (array/map @config.states (fn s (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (fillC (if (== (object/get @w winner) "red") @config.redColor (if (== (object/get @w winner) "blue") @config.blueColor @config.tossupColor)))
              )
              { type: rect, id: (str/concat "tile-" (object/get @s id)), x: (+ 10 (* (object/get @s col) (+ @tileW 10))), y: (+ 10 (* (object/get @s row) (+ @tileH 10))), width: @tileW, height: @tileH, color: @fillC, fill: @fillC, opacity: 0.85, lineWidth: 1 }))))
            (tileLabels (array/map @config.states (fn s (let (
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              { type: text, id: (str/concat "tile-label-" (object/get @s id)), x: (+ (+ 10 (* (object/get @s col) (+ @tileW 10))) (/ @tileW 2)), y: (+ (+ 10 (* (object/get @s row) (+ @tileH 10))) (/ @tileH 2)), text: (str/concat (object/get @s id) " · " (object/get @evc ev)), fontSize: 13, align: "center", color: "#ffffff" }))))
            (barY (+ 30 (* 4 (+ @tileH 10))))
            (scale (/ (- @config.width 80) @totalEV))
            (thresholdX (+ 40 (* @config.threshold @scale)))
            (barShapes [
                { type: rect, id: "red-bar", x: 40, y: @barY, width: (* @redEV @scale), height: 28, color: @config.redColor, fill: @config.redColor, lineWidth: 1 },
                { type: text, id: "red-bar-label", x: 44, y: (+ @barY 18), text: (str/concat "Red " @redEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: rect, id: "blue-bar", x: 40, y: (+ @barY 40), width: (* @blueEV @scale), height: 28, color: @config.blueColor, fill: @config.blueColor, lineWidth: 1 },
                { type: text, id: "blue-bar-label", x: 44, y: (+ @barY 58), text: (str/concat "Blue " @blueEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: line, id: "threshold-line", x1: @thresholdX, y1: (- @barY 6), x2: @thresholdX, y2: (+ @barY 74), color: "#0f172a", lineWidth: 2 },
                { type: text, id: "threshold-label", x: @thresholdX, y: (- @barY 12), text: (str/concat @config.threshold " to win"), fontSize: 12, align: "center", color: "#0f172a" }
              ])
            (shapes (array/concat (array/concat @tileRects @tileLabels) @barShapes))
            (swingStates (array/filter @config.states (fn s (== (object/get @s swing) true))))
            (toggleButtons (array/map @swingStates (fn s { type: button, action: TOGGLE_STATE, actionPayload: { stateId: (object/get @s id) }, label: (str/concat "Flip " (object/get @s id)), variant: secondary })))
            (scenarioButtons (array/map @config.scenarios (fn sc { type: button, action: LOAD_SCENARIO, actionPayload: { index: (object/get @sc index) }, label: (object/get @sc name), variant: (if (== @scenarioName (object/get @sc name)) "primary" "ghost") })))
            (splitLine (str/concat "Popular vote share — Red " @redPop "% · Blue " @bluePop "%" @splitNote))
            (children [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Flip the swing states — the first ticket to 270 electoral votes wins the presidency." },
                { type: stack, direction: horizontal, gap: sm, children: @toggleButtons },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @splitLine },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "EV — Red " @redEV " · Blue " @blueEV " · Tossup " @tossupEV), variant: info },
                    { type: badge, label: @winnerText, variant: @winnerVariant }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: (array/concat @scenarioButtons [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ]) }
              ])
          )
          (do
            (set @entity.winnerMap @winnerMap)
            (set @entity.scenarioName @scenarioName)
            (set @entity.redEV @redEV)
            (set @entity.blueEV @blueEV)
            (set @entity.tossupEV @tossupEV)
            (set @entity.redPop @redPop)
            (set @entity.bluePop @bluePop)
            (set @entity.splitNote @splitNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit ELECTORAL_UPDATED { redEV: @entity.redEV, blueEV: @entity.blueEV, tossupEV: @entity.tossupEV, redPop: @entity.redPop, bluePop: @entity.bluePop, splitNote: @entity.splitNote, scenarioName: @entity.scenarioName })

      RESET -> idle when (== @entity.active true)
        (let (
            (winnerMap @config.baselineMap)
            (scenarioName "Baseline")
            (totalEV (array/reduce @config.evCounts 0 (fn (acc e) (+ @acc (object/get @e ev)))))
            (redEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @evc ev)) @acc)))))
            (blueEV (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @evc ev)) @acc)))))
            (tossupEV (- @totalEV (+ @redEV @blueEV)))
            (redPopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "red") (+ @acc (object/get @s popShare)) @acc)))))
            (bluePopRaw (array/reduce @config.states 0 (fn (acc s) (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
              )
              (if (== (object/get @w winner) "blue") (+ @acc (object/get @s popShare)) @acc)))))
            (redPop (math/round @redPopRaw 1))
            (bluePop (math/round @bluePopRaw 1))
            (elecWinner (if (>= @redEV @config.threshold) "red" (if (>= @blueEV @config.threshold) "blue" "none")))
            (popLeader (if (> @redPop @bluePop) "red" (if (> @bluePop @redPop) "blue" "tied")))
            (splitNote (if (and (!= @elecWinner "none") (!= @elecWinner @popLeader)) " — split decision: the electoral winner trails in the popular vote" ""))
            (winnerText (if (== @elecWinner "red") "Red reaches 270 — wins the presidency" (if (== @elecWinner "blue") "Blue reaches 270 — wins the presidency" (str/concat "No majority yet — " @tossupEV " tossup EV outstanding"))))
            (winnerVariant (if (== @elecWinner "none") "info" "success"))
            (tileW (/ (- @config.width 50) 4))
            (tileH 56)
            (tileRects (array/map @config.states (fn s (let (
                (w (array/first (array/filter @winnerMap (fn m (== (object/get @m id) (object/get @s id))))))
                (fillC (if (== (object/get @w winner) "red") @config.redColor (if (== (object/get @w winner) "blue") @config.blueColor @config.tossupColor)))
              )
              { type: rect, id: (str/concat "tile-" (object/get @s id)), x: (+ 10 (* (object/get @s col) (+ @tileW 10))), y: (+ 10 (* (object/get @s row) (+ @tileH 10))), width: @tileW, height: @tileH, color: @fillC, fill: @fillC, opacity: 0.85, lineWidth: 1 }))))
            (tileLabels (array/map @config.states (fn s (let (
                (evc (array/first (array/filter @config.evCounts (fn e (== (object/get @e id) (object/get @s id))))))
              )
              { type: text, id: (str/concat "tile-label-" (object/get @s id)), x: (+ (+ 10 (* (object/get @s col) (+ @tileW 10))) (/ @tileW 2)), y: (+ (+ 10 (* (object/get @s row) (+ @tileH 10))) (/ @tileH 2)), text: (str/concat (object/get @s id) " · " (object/get @evc ev)), fontSize: 13, align: "center", color: "#ffffff" }))))
            (barY (+ 30 (* 4 (+ @tileH 10))))
            (scale (/ (- @config.width 80) @totalEV))
            (thresholdX (+ 40 (* @config.threshold @scale)))
            (barShapes [
                { type: rect, id: "red-bar", x: 40, y: @barY, width: (* @redEV @scale), height: 28, color: @config.redColor, fill: @config.redColor, lineWidth: 1 },
                { type: text, id: "red-bar-label", x: 44, y: (+ @barY 18), text: (str/concat "Red " @redEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: rect, id: "blue-bar", x: 40, y: (+ @barY 40), width: (* @blueEV @scale), height: 28, color: @config.blueColor, fill: @config.blueColor, lineWidth: 1 },
                { type: text, id: "blue-bar-label", x: 44, y: (+ @barY 58), text: (str/concat "Blue " @blueEV " EV"), fontSize: 13, align: "left", color: "#ffffff" },
                { type: line, id: "threshold-line", x1: @thresholdX, y1: (- @barY 6), x2: @thresholdX, y2: (+ @barY 74), color: "#0f172a", lineWidth: 2 },
                { type: text, id: "threshold-label", x: @thresholdX, y: (- @barY 12), text: (str/concat @config.threshold " to win"), fontSize: 12, align: "center", color: "#0f172a" }
              ])
            (shapes (array/concat (array/concat @tileRects @tileLabels) @barShapes))
            (swingStates (array/filter @config.states (fn s (== (object/get @s swing) true))))
            (toggleButtons (array/map @swingStates (fn s { type: button, action: TOGGLE_STATE, actionPayload: { stateId: (object/get @s id) }, label: (str/concat "Flip " (object/get @s id)), variant: secondary })))
            (scenarioButtons (array/map @config.scenarios (fn sc { type: button, action: LOAD_SCENARIO, actionPayload: { index: (object/get @sc index) }, label: (object/get @sc name), variant: (if (== @scenarioName (object/get @sc name)) "primary" "ghost") })))
            (splitLine (str/concat "Popular vote share — Red " @redPop "% · Blue " @bluePop "%" @splitNote))
            (children [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Flip the swing states — the first ticket to 270 electoral votes wins the presidency." },
                { type: stack, direction: horizontal, gap: sm, children: @toggleButtons },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @shapes, interactive: @config.interactive, animate: @config.animate },
                { type: typography, variant: body, content: @splitLine },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: badge, label: (str/concat "EV — Red " @redEV " · Blue " @blueEV " · Tossup " @tossupEV), variant: info },
                    { type: badge, label: @winnerText, variant: @winnerVariant }
                  ] },
                { type: stack, direction: horizontal, gap: sm, children: (array/concat @scenarioButtons [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ]) }
              ])
          )
          (do
            (set @entity.winnerMap @winnerMap)
            (set @entity.scenarioName @scenarioName)
            (set @entity.redEV @redEV)
            (set @entity.blueEV @blueEV)
            (set @entity.tossupEV @tossupEV)
            (set @entity.redPop @redPop)
            (set @entity.bluePop @bluePop)
            (set @entity.splitNote @splitNote)
            (set @entity.renderChildren @children)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit ELECTORAL_UPDATED { redEV: @entity.redEV, blueEV: @entity.blueEV, tossupEV: @entity.tossupEV, redPop: @entity.redPop, bluePop: @entity.bluePop, splitNote: @entity.splitNote, scenarioName: @entity.scenarioName })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      TOGGLE_STATE {
        stateId : string
      }
        @description "Learner flipped a swing state; its winner cycles red -> blue -> tossup -> red. Non-swing states ignore the event."
        @tier "domain"
      LOAD_SCENARIO {
        index : number
      }
        @description "Learner loaded a named what-if scenario from config.scenarios by its index, replacing the current winner map."
        @tier "domain"
      RESET {
      }
        @description "Learner reset the map back to config.baselineMap."
        @tier "domain"
    }

    emits {
      ELECTORAL_UPDATED -> external {
        redEV : number
        blueEV : number
        tossupEV : number
        redPop : number
        bluePop : number
        splitNote : string
        scenarioName : string
      }
        @description "The electoral map state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "electoral vote tally, EV totals, race to 270, swing state flip, popular vote split, scenario update"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Civics Lab"
        @label "Title"
        @description "Title shown above the lab."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 430
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      threshold : number = 270
        @label "Win Threshold"
        @description "Electoral votes needed to win the presidency — a majority of the total electors."
        @synonyms "270 to win, electoral majority, winning threshold"
        @tier "domain"
      states : [CivicsElectoralState] = [
        { id: "CA", name: "California", col: 0, row: 0, popShare: 11.7, swing: false },
        { id: "TX", name: "Texas", col: 1, row: 0, popShare: 8.9, swing: false },
        { id: "FL", name: "Florida", col: 2, row: 0, popShare: 7.6, swing: true },
        { id: "NY", name: "New York", col: 3, row: 0, popShare: 7.8, swing: false },
        { id: "PA", name: "Pennsylvania", col: 0, row: 1, popShare: 6.5, swing: true },
        { id: "OH", name: "Ohio", col: 1, row: 1, popShare: 5.6, swing: false },
        { id: "GA", name: "Georgia", col: 2, row: 1, popShare: 5.3, swing: true },
        { id: "NC", name: "North Carolina", col: 3, row: 1, popShare: 5.4, swing: true },
        { id: "MI", name: "Michigan", col: 0, row: 2, popShare: 5.4, swing: true },
        { id: "AZ", name: "Arizona", col: 1, row: 2, popShare: 3.4, swing: true },
        { id: "WI", name: "Wisconsin", col: 2, row: 2, popShare: 3.2, swing: true },
        { id: "CO", name: "Colorado", col: 3, row: 2, popShare: 2.9, swing: false },
        { id: "OR", name: "Other safe Red", col: 0, row: 3, popShare: 13.0, swing: false },
        { id: "OB", name: "Other safe Blue", col: 1, row: 3, popShare: 13.3, swing: false }
      ]
        @label "States"
        @description "The modeled map: twelve headline states plus two aggregate tiles for the remaining safe-red and safe-blue states. col/row place the tile on the canvas grid; popShare is the share of the national popular vote; swing marks the states the learner may flip."
        @synonyms "electoral map, swing states, battleground states, state tiles"
        @tier "domain"
      evCounts : [CivicsElectoralEVCount] = [
        { id: "CA", ev: 54 },
        { id: "TX", ev: 40 },
        { id: "FL", ev: 30 },
        { id: "NY", ev: 28 },
        { id: "PA", ev: 19 },
        { id: "OH", ev: 17 },
        { id: "GA", ev: 16 },
        { id: "NC", ev: 16 },
        { id: "MI", ev: 15 },
        { id: "AZ", ev: 11 },
        { id: "WI", ev: 10 },
        { id: "CO", ev: 10 },
        { id: "OR", ev: 136 },
        { id: "OB", ev: 136 }
      ]
        @label "Electoral Votes"
        @description "Electoral votes per state id; the aggregate tiles carry the remaining electors so the totals sum to 538."
        @synonyms "electoral votes, electors, EV counts"
        @tier "domain"
      baselineMap : [CivicsElectoralWinner] = [
        { id: "CA", winner: blue },
        { id: "TX", winner: red },
        { id: "FL", winner: red },
        { id: "NY", winner: blue },
        { id: "PA", winner: blue },
        { id: "OH", winner: red },
        { id: "GA", winner: red },
        { id: "NC", winner: red },
        { id: "MI", winner: blue },
        { id: "AZ", winner: red },
        { id: "WI", winner: blue },
        { id: "CO", winner: blue },
        { id: "OR", winner: red },
        { id: "OB", winner: blue }
      ]
        @label "Baseline Map"
        @description "The starting winner per state id — a narrow Blue win (272 to 266) that Red can flip by taking swing states."
        @synonyms "starting map, default outcome, baseline election"
        @tier "domain"
      scenarios : [CivicsElectoralScenario] = [
        { index: 0, name: "Tossup reset", map: [
          { id: "CA", winner: blue }, { id: "TX", winner: red }, { id: "FL", winner: tossup }, { id: "NY", winner: blue },
          { id: "PA", winner: tossup }, { id: "OH", winner: red }, { id: "GA", winner: tossup }, { id: "NC", winner: tossup },
          { id: "MI", winner: tossup }, { id: "AZ", winner: tossup }, { id: "WI", winner: tossup }, { id: "CO", winner: blue },
          { id: "OR", winner: red }, { id: "OB", winner: blue }
        ] },
        { index: 1, name: "Red sweep", map: [
          { id: "CA", winner: blue }, { id: "TX", winner: red }, { id: "FL", winner: red }, { id: "NY", winner: blue },
          { id: "PA", winner: red }, { id: "OH", winner: red }, { id: "GA", winner: red }, { id: "NC", winner: red },
          { id: "MI", winner: red }, { id: "AZ", winner: red }, { id: "WI", winner: red }, { id: "CO", winner: blue },
          { id: "OR", winner: red }, { id: "OB", winner: blue }
        ] }
      ]
        @label "Scenarios"
        @description "Named what-if maps the learner can load by index; each scenario replaces the whole winner map."
        @synonyms "what-if scenarios, election scenarios, preset maps"
        @tier "domain"
      redColor : string = "#dc2626"
        @label "Red Color"
        @description "Color for Red-won states and the Red EV bar."
        @tier "presentation"
      blueColor : string = "#2563eb"
        @label "Blue Color"
        @description "Color for Blue-won states and the Blue EV bar."
        @tier "presentation"
      tossupColor : string = "#94a3b8"
        @label "Tossup Color"
        @description "Color for undecided (tossup) states."
        @tier "presentation"
    }
  }

  page "/civics-electoral" as CivicsElectoralPage -> CivicsElectoralSim
}
