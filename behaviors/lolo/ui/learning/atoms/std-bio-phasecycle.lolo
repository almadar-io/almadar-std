app std-bio-phasecycle "1.0.0"
"Staged biology phase-cycle engine — the learner steps a Next/Prev cursor through an ordered roster of stages (e.g. mitosis phases), each revealing its own node/edge/shape snapshot, label, and description, and can predict the next stage before revealing it for immediate correct/incorrect feedback. Stage vocabulary is entirely config-declared, so the same mechanism serves any staged biology process, on a biology-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital BioPhaseCycleOrbital {
  type BioPhaseCycleNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
  }
  type BioPhaseCycleEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type BioPhaseCycleShapePoint = {
    x : number!
    y : number!
  }
  type BioPhaseCycleShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [BioPhaseCycleShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type BioPhaseCyclePhase = {
    label : string!
    description : string
    nodes : [BioPhaseCycleNode]
    edges : [BioPhaseCycleEdge]
    shapes : [BioPhaseCycleShape]
  }

  entity BioPhaseCycleScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [BioPhaseCycleNode]
    edges : [BioPhaseCycleEdge]
    shapes : [BioPhaseCycleShape]
    currentPhase : number
    phaseLabel : string
    phaseDescription : string
    predictedPhase : string
    feedback : string
  }

  trait BioPhaseCycleSim -> @rebindable BioPhaseCycleScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.currentPhase 0)
        (set @entity.phaseLabel (if (> (array/len @config.phases) 0) (object/get (array/nth @config.phases 0) label) ""))
        (set @entity.phaseDescription (if (> (array/len @config.phases) 0) (object/get (array/nth @config.phases 0) description) ""))
        (set @entity.nodes (object/get (array/nth @config.phases 0) nodes))
        (set @entity.edges (object/get (array/nth @config.phases 0) edges))
        (set @entity.shapes (object/get (array/nth @config.phases 0) shapes))
        (set @entity.predictedPhase "")
        (set @entity.feedback "")
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: @entity.phaseLabel },
                    { type: typography, variant: body, content: @entity.phaseDescription },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Predict what happens next" },
                        { type: stack, direction: horizontal, gap: xs, children: (array/map @config.phases (fn p { type: button, action: PREDICT, actionPayload: { choice: (object/get @p label) }, label: (object/get @p label), variant: (if (== @entity.predictedPhase (object/get @p label)) "primary" "ghost"), disabled: (if @config.predictMode false true), size: sm })) },
                        { type: typography, variant: caption, content: @entity.feedback }
                      ] },
                    { type: stack, direction: horizontal, gap: sm, children: [
                        { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                        { type: button, action: NEXT, label: "Next ▶", variant: primary }
                      ] }
                  ] }
              ]
            }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.currentPhase 0)
        (set @entity.phaseLabel (if (> (array/len @config.phases) 0) (object/get (array/nth @config.phases 0) label) ""))
        (set @entity.phaseDescription (if (> (array/len @config.phases) 0) (object/get (array/nth @config.phases 0) description) ""))
        (set @entity.nodes (object/get (array/nth @config.phases 0) nodes))
        (set @entity.edges (object/get (array/nth @config.phases 0) edges))
        (set @entity.shapes (object/get (array/nth @config.phases 0) shapes))
        (set @entity.predictedPhase "")
        (set @entity.feedback "")
        (render-ui main {
            type: box
            padding: md
            children: [
              {
                type: stack
                direction: vertical
                gap: md
                children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: biology-canvas,
                    width: @config.width,
                    height: @config.height,
                    backgroundColor: @config.backgroundColor,
                    nodes: @entity.nodes,
                    edges: @entity.edges,
                    shapes: @entity.shapes,
                    interactive: @config.interactive,
                    animate: @config.animate
                  },
                  { type: stack, direction: vertical, gap: sm, children: [
                      { type: typography, variant: h4, content: @entity.phaseLabel },
                      { type: typography, variant: body, content: @entity.phaseDescription },
                      { type: stack, direction: vertical, gap: xs, children: [
                          { type: typography, variant: caption, content: "Predict what happens next" },
                          { type: stack, direction: horizontal, gap: xs, children: (array/map @config.phases (fn p { type: button, action: PREDICT, actionPayload: { choice: (object/get @p label) }, label: (object/get @p label), variant: (if (== @entity.predictedPhase (object/get @p label)) "primary" "ghost"), disabled: (if @config.predictMode false true), size: sm })) },
                          { type: typography, variant: caption, content: @entity.feedback }
                        ] },
                      { type: stack, direction: horizontal, gap: sm, children: [
                          { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                          { type: button, action: NEXT, label: "Next ▶", variant: primary }
                        ] }
                    ] }
                ]
              }
            ]
        })

      NEXT -> idle when (== @entity.active true)
        (set @entity.currentPhase
          (if (< @entity.currentPhase (- (array/len @config.phases) 1))
            (+ @entity.currentPhase 1)
            @entity.currentPhase))
        (set @entity.phaseLabel (object/get (array/nth @config.phases @entity.currentPhase) label))
        (set @entity.phaseDescription (object/get (array/nth @config.phases @entity.currentPhase) description))
        (set @entity.nodes (object/get (array/nth @config.phases @entity.currentPhase) nodes))
        (set @entity.edges (object/get (array/nth @config.phases @entity.currentPhase) edges))
        (set @entity.shapes (object/get (array/nth @config.phases @entity.currentPhase) shapes))
        (set @entity.predictedPhase "")
        (set @entity.feedback "")
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: @entity.phaseLabel },
                    { type: typography, variant: body, content: @entity.phaseDescription },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Predict what happens next" },
                        { type: stack, direction: horizontal, gap: xs, children: (array/map @config.phases (fn p { type: button, action: PREDICT, actionPayload: { choice: (object/get @p label) }, label: (object/get @p label), variant: (if (== @entity.predictedPhase (object/get @p label)) "primary" "ghost"), disabled: (if @config.predictMode false true), size: sm })) },
                        { type: typography, variant: caption, content: @entity.feedback }
                      ] },
                    { type: stack, direction: horizontal, gap: sm, children: [
                        { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                        { type: button, action: NEXT, label: "Next ▶", variant: primary }
                      ] }
                  ] }
              ]
            }
          ]
        })
        (emit PHASE_CYCLE_UPDATED { currentPhase: @entity.currentPhase, phaseLabel: @entity.phaseLabel, predictedPhase: @entity.predictedPhase, feedback: @entity.feedback })

      PREV -> idle when (== @entity.active true)
        (set @entity.currentPhase
          (if (> @entity.currentPhase 0)
            (- @entity.currentPhase 1)
            @entity.currentPhase))
        (set @entity.phaseLabel (object/get (array/nth @config.phases @entity.currentPhase) label))
        (set @entity.phaseDescription (object/get (array/nth @config.phases @entity.currentPhase) description))
        (set @entity.nodes (object/get (array/nth @config.phases @entity.currentPhase) nodes))
        (set @entity.edges (object/get (array/nth @config.phases @entity.currentPhase) edges))
        (set @entity.shapes (object/get (array/nth @config.phases @entity.currentPhase) shapes))
        (set @entity.predictedPhase "")
        (set @entity.feedback "")
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: @entity.phaseLabel },
                    { type: typography, variant: body, content: @entity.phaseDescription },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Predict what happens next" },
                        { type: stack, direction: horizontal, gap: xs, children: (array/map @config.phases (fn p { type: button, action: PREDICT, actionPayload: { choice: (object/get @p label) }, label: (object/get @p label), variant: (if (== @entity.predictedPhase (object/get @p label)) "primary" "ghost"), disabled: (if @config.predictMode false true), size: sm })) },
                        { type: typography, variant: caption, content: @entity.feedback }
                      ] },
                    { type: stack, direction: horizontal, gap: sm, children: [
                        { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                        { type: button, action: NEXT, label: "Next ▶", variant: primary }
                      ] }
                  ] }
              ]
            }
          ]
        })
        (emit PHASE_CYCLE_UPDATED { currentPhase: @entity.currentPhase, phaseLabel: @entity.phaseLabel, predictedPhase: @entity.predictedPhase, feedback: @entity.feedback })

      PREDICT -> idle when (== @entity.active true)
        (set @entity.predictedPhase ?choice)
        (set @entity.feedback
          (if (< @entity.currentPhase (- (array/len @config.phases) 1))
            (if (== ?choice (object/get (array/nth @config.phases (+ @entity.currentPhase 1)) label))
              "Correct — click Next to see it happen."
              (str/concat "Not quite — click Next to see what actually follows " @entity.phaseLabel "."))
            "This is the last phase — there is nothing further to predict."))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: biology-canvas,
                  width: @config.width,
                  height: @config.height,
                  backgroundColor: @config.backgroundColor,
                  nodes: @entity.nodes,
                  edges: @entity.edges,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                },
                { type: stack, direction: vertical, gap: sm, children: [
                    { type: typography, variant: h4, content: @entity.phaseLabel },
                    { type: typography, variant: body, content: @entity.phaseDescription },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: "Predict what happens next" },
                        { type: stack, direction: horizontal, gap: xs, children: (array/map @config.phases (fn p { type: button, action: PREDICT, actionPayload: { choice: (object/get @p label) }, label: (object/get @p label), variant: (if (== @entity.predictedPhase (object/get @p label)) "primary" "ghost"), disabled: (if @config.predictMode false true), size: sm })) },
                        { type: typography, variant: caption, content: @entity.feedback }
                      ] },
                    { type: stack, direction: horizontal, gap: sm, children: [
                        { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                        { type: button, action: NEXT, label: "Next ▶", variant: primary }
                      ] }
                  ] }
              ]
            }
          ]
        })
        (emit PHASE_CYCLE_UPDATED { currentPhase: @entity.currentPhase, phaseLabel: @entity.phaseLabel, predictedPhase: @entity.predictedPhase, feedback: @entity.feedback })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      NEXT {
      }
        @description "Learner advanced the cursor to the next phase in the ordered roster."
        @tier "domain"
      PREV {
      }
        @description "Learner moved the cursor back to the previous phase in the ordered roster."
        @tier "domain"
      PREDICT {
        choice : string
      }
        @description "Learner guessed the next phase before advancing; verdicted against the following phase's label."
        @tier "domain"
    }

    emits {
      PHASE_CYCLE_UPDATED -> external {
        currentPhase : number
        phaseLabel : string
        predictedPhase : string
        feedback : string
      }
        @description "The stepper/prediction state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "phase cycle update, stage advance, mitosis phase, prediction feedback"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Cell Division Phase Cycle"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#f0fdf4"
        @label "Background Color"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      phases : [BioPhaseCyclePhase] = [
        { label: "Prophase", description: "Chromatin condenses into visible chromosomes and the nuclear envelope begins breaking down.", nodes: [
            { id: "membrane", x: 300, y: 200, radius: 140, color: "#dcfce7", label: "Cell", kind: cell },
            { id: "nucleus", x: 300, y: 200, radius: 70, color: "#bfdbfe", label: "Nucleus", kind: cell },
            { id: "chromosome-1", x: 280, y: 185, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-2", x: 320, y: 185, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-3", x: 280, y: 215, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-4", x: 320, y: 215, radius: 9, color: "#7c3aed", label: "", kind: molecule }
          ], edges: [], shapes: [] },
        { label: "Metaphase", description: "Chromosomes line up along the cell's equator, each attached to spindle fibers from opposite poles.", nodes: [
            { id: "membrane", x: 300, y: 200, radius: 140, color: "#dcfce7", label: "Cell", kind: cell },
            { id: "pole-a", x: 150, y: 200, radius: 8, color: "#f59e0b", label: "Pole", kind: organelle },
            { id: "pole-b", x: 450, y: 200, radius: 8, color: "#f59e0b", label: "Pole", kind: organelle },
            { id: "chromosome-1", x: 300, y: 150, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-2", x: 300, y: 185, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-3", x: 300, y: 215, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-4", x: 300, y: 250, radius: 9, color: "#7c3aed", label: "", kind: molecule }
          ], edges: [], shapes: [
            { type: line, x1: 150, y1: 200, x2: 300, y2: 150, color: "#94a3b8", lineWidth: 1 },
            { type: line, x1: 150, y1: 200, x2: 300, y2: 250, color: "#94a3b8", lineWidth: 1 },
            { type: line, x1: 450, y1: 200, x2: 300, y2: 150, color: "#94a3b8", lineWidth: 1 },
            { type: line, x1: 450, y1: 200, x2: 300, y2: 250, color: "#94a3b8", lineWidth: 1 }
          ] },
        { label: "Anaphase", description: "Sister chromatids separate and are pulled toward opposite poles by the spindle fibers.", nodes: [
            { id: "membrane", x: 300, y: 200, radius: 140, color: "#dcfce7", label: "Cell", kind: cell },
            { id: "pole-a", x: 150, y: 200, radius: 8, color: "#f59e0b", label: "Pole", kind: organelle },
            { id: "pole-b", x: 450, y: 200, radius: 8, color: "#f59e0b", label: "Pole", kind: organelle },
            { id: "chromosome-1", x: 210, y: 180, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-2", x: 210, y: 220, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-3", x: 390, y: 180, radius: 9, color: "#7c3aed", label: "", kind: molecule },
            { id: "chromosome-4", x: 390, y: 220, radius: 9, color: "#7c3aed", label: "", kind: molecule }
          ], edges: [], shapes: [] },
        { label: "Telophase", description: "Two nuclear envelopes reform around each set of chromosomes as the cytoplasm begins to divide.", nodes: [
            { id: "membrane-a", x: 190, y: 200, radius: 90, color: "#dcfce7", label: "Cell A", kind: cell },
            { id: "membrane-b", x: 410, y: 200, radius: 90, color: "#dcfce7", label: "Cell B", kind: cell },
            { id: "nucleus-a", x: 190, y: 200, radius: 45, color: "#bfdbfe", label: "Nucleus", kind: cell },
            { id: "nucleus-b", x: 410, y: 200, radius: 45, color: "#bfdbfe", label: "Nucleus", kind: cell }
          ], edges: [], shapes: [
            { type: rect, x: 290, y: 120, width: 20, height: 160, color: "#16a34a", fill: "#16a34a" }
          ] }
      ]
        @label "Phases"
        @description "Named stages the learner steps through; each stage supplies its own node/edge/shape snapshot so the same stepper serves any staged process (mitosis, meiosis, the cell cycle)."
        @tier "domain"
      predictMode : boolean = true
        @label "Predict Before Step"
        @description "When true, the learner picks what happens next before Next reveals the true following phase."
        @tier "domain"
    }
  }

  page "/bio-phasecycle" as BioPhaseCyclePage -> BioPhaseCycleSim
}
