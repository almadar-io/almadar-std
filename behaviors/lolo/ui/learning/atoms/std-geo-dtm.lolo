app std-geo-dtm "1.0.0"
"Demographic transition model engine — stages 1-5 redraw piecewise birth/death rate curves on a math-canvas; the learner pages through stages and drives birth/death rate sliders to reproduce each stage's target rates within a tolerance. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital GeoDtmOrbital {
  type GeoDtmShapePoint = {
    x : number!
    y : number!
  }
  type GeoDtmShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [GeoDtmShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type GeoDtmCurveSample = {
    x : number!
    y : number!
  }
  type GeoDtmCurve = {
    label : string
    color : string
    samples : [GeoDtmCurveSample]!
  }
  type GeoDtmStagePreset = {
    stage : number!
    name : string!
    birthRate : number!
    deathRate : number!
    description : string
  }

  entity GeoDtmScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    stageIndex : number
    birthRate : number
    deathRate : number
    stageName : string
    stageDescription : string
    matched : boolean = false
    matchReadout : string
    dtmCurves : [GeoDtmCurve]
    dtmShapes : [GeoDtmShape]
  }

  trait GeoDtmSim -> @rebindable GeoDtmScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.stageIndex 1)
        (set @entity.birthRate @config.birthRate)
        (set @entity.deathRate @config.deathRate)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (stageDenom (math/max 1 (- @config.stageCount 1)))
            (stagePreset (array/first (array/filter @config.stagePresets (fn s (== (object/get @s stage) @entity.stageIndex)))))
            (stagePresetFinal (if (== @stagePreset null) (array/first @config.stagePresets) @stagePreset))
            (stageName (object/get @stagePresetFinal name))
            (targetBirth (object/get @stagePresetFinal birthRate))
            (targetDeath (object/get @stagePresetFinal deathRate))
            (matched (and (<= (math/abs (- @entity.birthRate @targetBirth)) @config.matchTolerance) (<= (math/abs (- @entity.deathRate @targetDeath)) @config.matchTolerance)))
            (matchReadout (str/concat "Stage " @entity.stageIndex " — " @stageName ": target birth " @targetBirth ", death " @targetDeath " | your rates: birth " @entity.birthRate ", death " @entity.deathRate (if @matched " — stage reproduced" " — adjust the sliders to reproduce this stage")))
            (curveRows (array/map @config.stagePresets (fn s (let (
                    (xPos (+ @plotLeft (* (/ (- (object/get @s stage) 1) @stageDenom) @plotWidthPx)))
                  )
                  { x: @xPos, birthY: (- @plotBottom (* (/ (object/get @s birthRate) @config.rateAxisMax) @plotHeightPx)), deathY: (- @plotBottom (* (/ (object/get @s deathRate) @config.rateAxisMax) @plotHeightPx)), stage: (object/get @s stage) }))))
            (birthSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r birthY) })))
            (deathSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r deathY) })))
            (dtmCurves [ { label: "Birth rate", color: @config.birthColor, samples: @birthSamples }, { label: "Death rate", color: @config.deathColor, samples: @deathSamples } ])
            (currentX (+ @plotLeft (* (/ (- @entity.stageIndex 1) @stageDenom) @plotWidthPx)))
            (learnerBirthY (- @plotBottom (* (/ @entity.birthRate @config.rateAxisMax) @plotHeightPx)))
            (learnerDeathY (- @plotBottom (* (/ @entity.deathRate @config.rateAxisMax) @plotHeightPx)))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (markerShapes [
                { type: line, x1: @currentX, y1: @plotTop, x2: @currentX, y2: @plotBottom, color: @config.stageMarkerColor, lineWidth: 2 },
                { type: line, x1: @plotLeft, y1: @learnerBirthY, x2: @plotRight, y2: @learnerBirthY, color: @config.birthColor, lineWidth: 1, opacity: 0.5 },
                { type: line, x1: @plotLeft, y1: @learnerDeathY, x2: @plotRight, y2: @learnerDeathY, color: @config.deathColor, lineWidth: 1, opacity: 0.5 }
              ])
            (stageLabels (array/map @curveRows (fn r { type: text, x: (object/get @r x), y: (+ @plotBottom 16), text: (str/concat "S" (object/get @r stage)), fontSize: 10, align: "center", color: @config.textColor })))
            (dtmShapes (array/concat (array/concat @axisShapes @markerShapes) @stageLabels))
          )
          (do
            (set @entity.stageName @stageName)
            (set @entity.stageDescription (object/get @stagePresetFinal description))
            (set @entity.matched @matched)
            (set @entity.matchReadout @matchReadout)
            (set @entity.dtmCurves @dtmCurves)
            (set @entity.dtmShapes @dtmShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV_STAGE, label: "Prev Stage", variant: secondary, disabled: (if (> @entity.stageIndex 1) false true) },
                    { type: button, action: NEXT_STAGE, label: "Next Stage", variant: primary, disabled: (if (< @entity.stageIndex @config.stageCount) false true) }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.dtmCurves, points: [], vectors: [], shapes: @entity.dtmShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "birth" } },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "death" } }
                  ] },
                { type: typography, variant: body, content: @entity.matchReadout },
                { type: typography, variant: caption, content: @entity.stageDescription },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.stagePresets (fn s { type: badge, label: (str/concat "S" (object/get @s stage) " " (object/get @s name)), variant: (if (== (object/get @s stage) @entity.stageIndex) "primary" "neutral") })) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.stageIndex 1)
        (set @entity.birthRate @config.birthRate)
        (set @entity.deathRate @config.deathRate)
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (stageDenom (math/max 1 (- @config.stageCount 1)))
            (stagePreset (array/first (array/filter @config.stagePresets (fn s (== (object/get @s stage) @entity.stageIndex)))))
            (stagePresetFinal (if (== @stagePreset null) (array/first @config.stagePresets) @stagePreset))
            (stageName (object/get @stagePresetFinal name))
            (targetBirth (object/get @stagePresetFinal birthRate))
            (targetDeath (object/get @stagePresetFinal deathRate))
            (matched (and (<= (math/abs (- @entity.birthRate @targetBirth)) @config.matchTolerance) (<= (math/abs (- @entity.deathRate @targetDeath)) @config.matchTolerance)))
            (matchReadout (str/concat "Stage " @entity.stageIndex " — " @stageName ": target birth " @targetBirth ", death " @targetDeath " | your rates: birth " @entity.birthRate ", death " @entity.deathRate (if @matched " — stage reproduced" " — adjust the sliders to reproduce this stage")))
            (curveRows (array/map @config.stagePresets (fn s (let (
                    (xPos (+ @plotLeft (* (/ (- (object/get @s stage) 1) @stageDenom) @plotWidthPx)))
                  )
                  { x: @xPos, birthY: (- @plotBottom (* (/ (object/get @s birthRate) @config.rateAxisMax) @plotHeightPx)), deathY: (- @plotBottom (* (/ (object/get @s deathRate) @config.rateAxisMax) @plotHeightPx)), stage: (object/get @s stage) }))))
            (birthSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r birthY) })))
            (deathSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r deathY) })))
            (dtmCurves [ { label: "Birth rate", color: @config.birthColor, samples: @birthSamples }, { label: "Death rate", color: @config.deathColor, samples: @deathSamples } ])
            (currentX (+ @plotLeft (* (/ (- @entity.stageIndex 1) @stageDenom) @plotWidthPx)))
            (learnerBirthY (- @plotBottom (* (/ @entity.birthRate @config.rateAxisMax) @plotHeightPx)))
            (learnerDeathY (- @plotBottom (* (/ @entity.deathRate @config.rateAxisMax) @plotHeightPx)))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (markerShapes [
                { type: line, x1: @currentX, y1: @plotTop, x2: @currentX, y2: @plotBottom, color: @config.stageMarkerColor, lineWidth: 2 },
                { type: line, x1: @plotLeft, y1: @learnerBirthY, x2: @plotRight, y2: @learnerBirthY, color: @config.birthColor, lineWidth: 1, opacity: 0.5 },
                { type: line, x1: @plotLeft, y1: @learnerDeathY, x2: @plotRight, y2: @learnerDeathY, color: @config.deathColor, lineWidth: 1, opacity: 0.5 }
              ])
            (stageLabels (array/map @curveRows (fn r { type: text, x: (object/get @r x), y: (+ @plotBottom 16), text: (str/concat "S" (object/get @r stage)), fontSize: 10, align: "center", color: @config.textColor })))
            (dtmShapes (array/concat (array/concat @axisShapes @markerShapes) @stageLabels))
          )
          (do
            (set @entity.stageName @stageName)
            (set @entity.stageDescription (object/get @stagePresetFinal description))
            (set @entity.matched @matched)
            (set @entity.matchReadout @matchReadout)
            (set @entity.dtmCurves @dtmCurves)
            (set @entity.dtmShapes @dtmShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV_STAGE, label: "Prev Stage", variant: secondary, disabled: (if (> @entity.stageIndex 1) false true) },
                    { type: button, action: NEXT_STAGE, label: "Next Stage", variant: primary, disabled: (if (< @entity.stageIndex @config.stageCount) false true) }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.dtmCurves, points: [], vectors: [], shapes: @entity.dtmShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "birth" } },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "death" } }
                  ] },
                { type: typography, variant: body, content: @entity.matchReadout },
                { type: typography, variant: caption, content: @entity.stageDescription },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.stagePresets (fn s { type: badge, label: (str/concat "S" (object/get @s stage) " " (object/get @s name)), variant: (if (== (object/get @s stage) @entity.stageIndex) "primary" "neutral") })) }
              ] }
          ]
        })

      NEXT_STAGE -> idle when (== @entity.active true)
        (set @entity.stageIndex (math/min @config.stageCount (+ @entity.stageIndex 1)))
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (stageDenom (math/max 1 (- @config.stageCount 1)))
            (stagePreset (array/first (array/filter @config.stagePresets (fn s (== (object/get @s stage) @entity.stageIndex)))))
            (stagePresetFinal (if (== @stagePreset null) (array/first @config.stagePresets) @stagePreset))
            (stageName (object/get @stagePresetFinal name))
            (targetBirth (object/get @stagePresetFinal birthRate))
            (targetDeath (object/get @stagePresetFinal deathRate))
            (matched (and (<= (math/abs (- @entity.birthRate @targetBirth)) @config.matchTolerance) (<= (math/abs (- @entity.deathRate @targetDeath)) @config.matchTolerance)))
            (matchReadout (str/concat "Stage " @entity.stageIndex " — " @stageName ": target birth " @targetBirth ", death " @targetDeath " | your rates: birth " @entity.birthRate ", death " @entity.deathRate (if @matched " — stage reproduced" " — adjust the sliders to reproduce this stage")))
            (curveRows (array/map @config.stagePresets (fn s (let (
                    (xPos (+ @plotLeft (* (/ (- (object/get @s stage) 1) @stageDenom) @plotWidthPx)))
                  )
                  { x: @xPos, birthY: (- @plotBottom (* (/ (object/get @s birthRate) @config.rateAxisMax) @plotHeightPx)), deathY: (- @plotBottom (* (/ (object/get @s deathRate) @config.rateAxisMax) @plotHeightPx)), stage: (object/get @s stage) }))))
            (birthSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r birthY) })))
            (deathSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r deathY) })))
            (dtmCurves [ { label: "Birth rate", color: @config.birthColor, samples: @birthSamples }, { label: "Death rate", color: @config.deathColor, samples: @deathSamples } ])
            (currentX (+ @plotLeft (* (/ (- @entity.stageIndex 1) @stageDenom) @plotWidthPx)))
            (learnerBirthY (- @plotBottom (* (/ @entity.birthRate @config.rateAxisMax) @plotHeightPx)))
            (learnerDeathY (- @plotBottom (* (/ @entity.deathRate @config.rateAxisMax) @plotHeightPx)))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (markerShapes [
                { type: line, x1: @currentX, y1: @plotTop, x2: @currentX, y2: @plotBottom, color: @config.stageMarkerColor, lineWidth: 2 },
                { type: line, x1: @plotLeft, y1: @learnerBirthY, x2: @plotRight, y2: @learnerBirthY, color: @config.birthColor, lineWidth: 1, opacity: 0.5 },
                { type: line, x1: @plotLeft, y1: @learnerDeathY, x2: @plotRight, y2: @learnerDeathY, color: @config.deathColor, lineWidth: 1, opacity: 0.5 }
              ])
            (stageLabels (array/map @curveRows (fn r { type: text, x: (object/get @r x), y: (+ @plotBottom 16), text: (str/concat "S" (object/get @r stage)), fontSize: 10, align: "center", color: @config.textColor })))
            (dtmShapes (array/concat (array/concat @axisShapes @markerShapes) @stageLabels))
          )
          (do
            (set @entity.stageName @stageName)
            (set @entity.stageDescription (object/get @stagePresetFinal description))
            (set @entity.matched @matched)
            (set @entity.matchReadout @matchReadout)
            (set @entity.dtmCurves @dtmCurves)
            (set @entity.dtmShapes @dtmShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV_STAGE, label: "Prev Stage", variant: secondary, disabled: (if (> @entity.stageIndex 1) false true) },
                    { type: button, action: NEXT_STAGE, label: "Next Stage", variant: primary, disabled: (if (< @entity.stageIndex @config.stageCount) false true) }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.dtmCurves, points: [], vectors: [], shapes: @entity.dtmShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "birth" } },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "death" } }
                  ] },
                { type: typography, variant: body, content: @entity.matchReadout },
                { type: typography, variant: caption, content: @entity.stageDescription },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.stagePresets (fn s { type: badge, label: (str/concat "S" (object/get @s stage) " " (object/get @s name)), variant: (if (== (object/get @s stage) @entity.stageIndex) "primary" "neutral") })) }
              ] }
          ]
        })
        (emit DTM_UPDATED { stageIndex: @entity.stageIndex, stageName: @entity.stageName, birthRate: @entity.birthRate, deathRate: @entity.deathRate, matched: @entity.matched })

      PREV_STAGE -> idle when (== @entity.active true)
        (set @entity.stageIndex (math/max 1 (- @entity.stageIndex 1)))
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (stageDenom (math/max 1 (- @config.stageCount 1)))
            (stagePreset (array/first (array/filter @config.stagePresets (fn s (== (object/get @s stage) @entity.stageIndex)))))
            (stagePresetFinal (if (== @stagePreset null) (array/first @config.stagePresets) @stagePreset))
            (stageName (object/get @stagePresetFinal name))
            (targetBirth (object/get @stagePresetFinal birthRate))
            (targetDeath (object/get @stagePresetFinal deathRate))
            (matched (and (<= (math/abs (- @entity.birthRate @targetBirth)) @config.matchTolerance) (<= (math/abs (- @entity.deathRate @targetDeath)) @config.matchTolerance)))
            (matchReadout (str/concat "Stage " @entity.stageIndex " — " @stageName ": target birth " @targetBirth ", death " @targetDeath " | your rates: birth " @entity.birthRate ", death " @entity.deathRate (if @matched " — stage reproduced" " — adjust the sliders to reproduce this stage")))
            (curveRows (array/map @config.stagePresets (fn s (let (
                    (xPos (+ @plotLeft (* (/ (- (object/get @s stage) 1) @stageDenom) @plotWidthPx)))
                  )
                  { x: @xPos, birthY: (- @plotBottom (* (/ (object/get @s birthRate) @config.rateAxisMax) @plotHeightPx)), deathY: (- @plotBottom (* (/ (object/get @s deathRate) @config.rateAxisMax) @plotHeightPx)), stage: (object/get @s stage) }))))
            (birthSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r birthY) })))
            (deathSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r deathY) })))
            (dtmCurves [ { label: "Birth rate", color: @config.birthColor, samples: @birthSamples }, { label: "Death rate", color: @config.deathColor, samples: @deathSamples } ])
            (currentX (+ @plotLeft (* (/ (- @entity.stageIndex 1) @stageDenom) @plotWidthPx)))
            (learnerBirthY (- @plotBottom (* (/ @entity.birthRate @config.rateAxisMax) @plotHeightPx)))
            (learnerDeathY (- @plotBottom (* (/ @entity.deathRate @config.rateAxisMax) @plotHeightPx)))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (markerShapes [
                { type: line, x1: @currentX, y1: @plotTop, x2: @currentX, y2: @plotBottom, color: @config.stageMarkerColor, lineWidth: 2 },
                { type: line, x1: @plotLeft, y1: @learnerBirthY, x2: @plotRight, y2: @learnerBirthY, color: @config.birthColor, lineWidth: 1, opacity: 0.5 },
                { type: line, x1: @plotLeft, y1: @learnerDeathY, x2: @plotRight, y2: @learnerDeathY, color: @config.deathColor, lineWidth: 1, opacity: 0.5 }
              ])
            (stageLabels (array/map @curveRows (fn r { type: text, x: (object/get @r x), y: (+ @plotBottom 16), text: (str/concat "S" (object/get @r stage)), fontSize: 10, align: "center", color: @config.textColor })))
            (dtmShapes (array/concat (array/concat @axisShapes @markerShapes) @stageLabels))
          )
          (do
            (set @entity.stageName @stageName)
            (set @entity.stageDescription (object/get @stagePresetFinal description))
            (set @entity.matched @matched)
            (set @entity.matchReadout @matchReadout)
            (set @entity.dtmCurves @dtmCurves)
            (set @entity.dtmShapes @dtmShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV_STAGE, label: "Prev Stage", variant: secondary, disabled: (if (> @entity.stageIndex 1) false true) },
                    { type: button, action: NEXT_STAGE, label: "Next Stage", variant: primary, disabled: (if (< @entity.stageIndex @config.stageCount) false true) }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.dtmCurves, points: [], vectors: [], shapes: @entity.dtmShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "birth" } },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "death" } }
                  ] },
                { type: typography, variant: body, content: @entity.matchReadout },
                { type: typography, variant: caption, content: @entity.stageDescription },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.stagePresets (fn s { type: badge, label: (str/concat "S" (object/get @s stage) " " (object/get @s name)), variant: (if (== (object/get @s stage) @entity.stageIndex) "primary" "neutral") })) }
              ] }
          ]
        })
        (emit DTM_UPDATED { stageIndex: @entity.stageIndex, stageName: @entity.stageName, birthRate: @entity.birthRate, deathRate: @entity.deathRate, matched: @entity.matched })

      SET_RATES -> idle when (== @entity.active true)
        (set @entity.birthRate (if (== ?target "birth") ?value @entity.birthRate))
        (set @entity.deathRate (if (== ?target "death") ?value @entity.deathRate))
        (let (
            (plotLeft 50)
            (plotRight (- @config.width 30))
            (plotWidthPx (- @plotRight @plotLeft))
            (plotTop 30)
            (plotBottom (- @config.height 50))
            (plotHeightPx (- @plotBottom @plotTop))
            (stageDenom (math/max 1 (- @config.stageCount 1)))
            (stagePreset (array/first (array/filter @config.stagePresets (fn s (== (object/get @s stage) @entity.stageIndex)))))
            (stagePresetFinal (if (== @stagePreset null) (array/first @config.stagePresets) @stagePreset))
            (stageName (object/get @stagePresetFinal name))
            (targetBirth (object/get @stagePresetFinal birthRate))
            (targetDeath (object/get @stagePresetFinal deathRate))
            (matched (and (<= (math/abs (- @entity.birthRate @targetBirth)) @config.matchTolerance) (<= (math/abs (- @entity.deathRate @targetDeath)) @config.matchTolerance)))
            (matchReadout (str/concat "Stage " @entity.stageIndex " — " @stageName ": target birth " @targetBirth ", death " @targetDeath " | your rates: birth " @entity.birthRate ", death " @entity.deathRate (if @matched " — stage reproduced" " — adjust the sliders to reproduce this stage")))
            (curveRows (array/map @config.stagePresets (fn s (let (
                    (xPos (+ @plotLeft (* (/ (- (object/get @s stage) 1) @stageDenom) @plotWidthPx)))
                  )
                  { x: @xPos, birthY: (- @plotBottom (* (/ (object/get @s birthRate) @config.rateAxisMax) @plotHeightPx)), deathY: (- @plotBottom (* (/ (object/get @s deathRate) @config.rateAxisMax) @plotHeightPx)), stage: (object/get @s stage) }))))
            (birthSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r birthY) })))
            (deathSamples (array/map @curveRows (fn r { x: (object/get @r x), y: (object/get @r deathY) })))
            (dtmCurves [ { label: "Birth rate", color: @config.birthColor, samples: @birthSamples }, { label: "Death rate", color: @config.deathColor, samples: @deathSamples } ])
            (currentX (+ @plotLeft (* (/ (- @entity.stageIndex 1) @stageDenom) @plotWidthPx)))
            (learnerBirthY (- @plotBottom (* (/ @entity.birthRate @config.rateAxisMax) @plotHeightPx)))
            (learnerDeathY (- @plotBottom (* (/ @entity.deathRate @config.rateAxisMax) @plotHeightPx)))
            (axisShapes [
                { type: line, x1: @plotLeft, y1: @plotBottom, x2: @plotRight, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 },
                { type: line, x1: @plotLeft, y1: @plotTop, x2: @plotLeft, y2: @plotBottom, color: @config.axisColor, lineWidth: 1 }
              ])
            (markerShapes [
                { type: line, x1: @currentX, y1: @plotTop, x2: @currentX, y2: @plotBottom, color: @config.stageMarkerColor, lineWidth: 2 },
                { type: line, x1: @plotLeft, y1: @learnerBirthY, x2: @plotRight, y2: @learnerBirthY, color: @config.birthColor, lineWidth: 1, opacity: 0.5 },
                { type: line, x1: @plotLeft, y1: @learnerDeathY, x2: @plotRight, y2: @learnerDeathY, color: @config.deathColor, lineWidth: 1, opacity: 0.5 }
              ])
            (stageLabels (array/map @curveRows (fn r { type: text, x: (object/get @r x), y: (+ @plotBottom 16), text: (str/concat "S" (object/get @r stage)), fontSize: 10, align: "center", color: @config.textColor })))
            (dtmShapes (array/concat (array/concat @axisShapes @markerShapes) @stageLabels))
          )
          (do
            (set @entity.stageName @stageName)
            (set @entity.stageDescription (object/get @stagePresetFinal description))
            (set @entity.matched @matched)
            (set @entity.matchReadout @matchReadout)
            (set @entity.dtmCurves @dtmCurves)
            (set @entity.dtmShapes @dtmShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: PREV_STAGE, label: "Prev Stage", variant: secondary, disabled: (if (> @entity.stageIndex 1) false true) },
                    { type: button, action: NEXT_STAGE, label: "Next Stage", variant: primary, disabled: (if (< @entity.stageIndex @config.stageCount) false true) }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: @entity.dtmCurves, points: [], vectors: [], shapes: @entity.dtmShapes, interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Birth rate: " @entity.birthRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.birthRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "birth" } },
                    { type: typography, variant: caption, content: (str/concat "Death rate: " @entity.deathRate) },
                    { type: range-slider, min: 0, max: @config.rateAxisMax, step: 1, value: @entity.deathRate, showTooltip: true, onChange: SET_RATES, actionPayload: { target: "death" } }
                  ] },
                { type: typography, variant: body, content: @entity.matchReadout },
                { type: typography, variant: caption, content: @entity.stageDescription },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.stagePresets (fn s { type: badge, label: (str/concat "S" (object/get @s stage) " " (object/get @s name)), variant: (if (== (object/get @s stage) @entity.stageIndex) "primary" "neutral") })) }
              ] }
          ]
        })
        (emit DTM_UPDATED { stageIndex: @entity.stageIndex, stageName: @entity.stageName, birthRate: @entity.birthRate, deathRate: @entity.deathRate, matched: @entity.matched })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      NEXT_STAGE {
      }
        @description "Learner advanced to the next demographic transition stage."
        @tier "domain"
      PREV_STAGE {
      }
        @description "Learner returned to the previous demographic transition stage."
        @tier "domain"
      SET_RATES {
        value : number
        target : string
      }
        @description "Learner dragged a rate dial; target names which rate ('birth' or 'death')."
        @tier "domain"
    }

    emits {
      DTM_UPDATED -> external {
        stageIndex : number
        stageName : string
        birthRate : number
        deathRate : number
        matched : boolean
      }
        @description "The demographic transition model state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "demographic transition, DTM stage, birth rate, death rate, natural increase, stage reproduced"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Demographic Transition Model"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      stageCount : number = 5
        @label "Stage Count"
        @description "Number of demographic transition stages the model steps through."
        @synonyms "demographic transition, DTM, stage, demographic stages"
        @tier "domain"
      birthRate : number = 40
        @label "Starting Birth Rate"
        @description "Starting birth-rate dial (per mille), the value the learner adjusts to reproduce each stage."
        @synonyms "birth rate, fertility rate, natality, crude birth rate"
        @tier "domain"
      deathRate : number = 40
        @label "Starting Death Rate"
        @description "Starting death-rate dial (per mille), the value the learner adjusts to reproduce each stage."
        @synonyms "death rate, mortality rate, crude death rate"
        @tier "domain"
      stagePresets : [GeoDtmStagePreset] = [
        { stage: 1, name: "High Stationary", birthRate: 40, deathRate: 38, description: "Pre-industrial: high birth and death rates cancel out, so population growth is near zero." },
        { stage: 2, name: "Early Expanding", birthRate: 40, deathRate: 22, description: "Death rate falls with better food and sanitation while birth rate stays high — rapid natural increase." },
        { stage: 3, name: "Late Expanding", birthRate: 28, deathRate: 12, description: "Birth rate begins to fall with urbanization and contraception; growth slows." },
        { stage: 4, name: "Low Stationary", birthRate: 12, deathRate: 11, description: "Both rates low and roughly equal; population is large but stable." },
        { stage: 5, name: "Declining", birthRate: 8, deathRate: 11, description: "Birth rate drops below death rate; the population ages and begins to shrink." }
      ]
        @label "Stage Presets"
        @description "Ordered roster of demographic transition stages; each declares the target birth/death rates the learner must reproduce and a teaching description. Curve samples are interpolated between consecutive presets."
        @synonyms "demographic transition stage, high stationary, early expanding, late expanding, low stationary, declining stage, natural increase"
        @tier "domain"
      rateAxisMax : number = 50
        @label "Rate Axis Max"
        @description "Upper bound of the birth/death rate dials and the curve vertical axis, per mille."
        @tier "presentation"
      matchTolerance : number = 3
        @label "Match Tolerance"
        @description "Per-rate tolerance within which the learner's dials count as reproducing the current stage's target rates."
        @tier "domain"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 460
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      birthColor : string = "#2563eb"
        @label "Birth Rate Color"
        @tier "presentation"
      deathColor : string = "#dc2626"
        @label "Death Rate Color"
        @tier "presentation"
      stageMarkerColor : string = "#7c3aed"
        @label "Stage Marker Color"
        @tier "presentation"
      axisColor : string = "#94a3b8"
        @label "Axis Color"
        @tier "presentation"
      textColor : string = "#1e293b"
        @label "Text Color"
        @tier "presentation"
    }
  }

  page "/geo-dtm" as GeoDtmPage -> GeoDtmSim
}
