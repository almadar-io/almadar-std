app std-ling-syntaxtree "1.0.0"
"Universal Grammar syntax-tree builder — the learner assembles a sentence's constituent structure bottom-up, attaching one labelled bracket (NP, VP, PP, S) at a time in derivation order, with evidence text on every pick and a growing bracket-tree render on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LingSyntaxtreeOrbital {
  type LingSyntaxtreeShapePoint = {
    x : number!
    y : number!
  }
  type LingSyntaxtreeShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LingSyntaxtreeShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type LingSyntaxtreeWord = {
    text : string!
    pos : string
  }
  type LingSyntaxtreeStep = {
    constituent : "NP" | "VP" | "PP" | "S"!
    startIndex : number!
    endIndex : number!
    level : number!
    evidence : string
  }
  type LingSyntaxtreeSentence = {
    id : string!
    label : string
    words : [LingSyntaxtreeWord]!
    derivation : [LingSyntaxtreeStep]!
  }
  type LingSyntaxtreeConstituentOption = {
    key : "NP" | "VP" | "PP" | "S"!
    label : string
  }

  entity LingSyntaxtreeScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    renderChildren : [json]
    shapes : [LingSyntaxtreeShape]
    sentenceIndex : number
    stepIndex : number
    syntaxFeedback : string
  }

  trait LingSyntaxtreeSim -> @rebindable LingSyntaxtreeScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.sentenceIndex 0)
        (set @entity.stepIndex 0)
        (set @entity.syntaxFeedback "")
        (let (
            (currentSentence (array/nth @config.sentences 0))
            (sentenceWords (object/get @currentSentence words))
            (derivation (object/get @currentSentence derivation))
            (sentenceLabel (object/get @currentSentence label))
            (wordCount (array/len @sentenceWords))
            (totalSteps (array/len @derivation))
            (baseY (- @config.height @config.bottomMargin))
            (wordShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (w (array/nth @sentenceWords @idx))
                    (wx (+ @config.leftMargin (* @idx @config.wordSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "wr" @idx), x: (- @wx (/ @config.nodeWidth 2)), y: (- @baseY 14), width: @config.nodeWidth, height: 26, color: @config.wordNodeColor, fill: @config.wordNodeFill },
                    { type: "text", id: (str/concat "wt" @idx), x: @wx, y: @baseY, text: (object/get @w text), fontSize: @config.fontSize, align: "center", color: @config.wordTextColor },
                    { type: "text", id: (str/concat "wp" @idx), x: @wx, y: (+ @baseY 22), text: (object/get @w pos), fontSize: @config.posFontSize, align: "center", color: @config.posColor }
                  ]
                )))))
            (progressLabel (str/concat 0 "/" @totalSteps " constituents built"))
          )
          (do
            (set @entity.shapes @wordShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: @sentenceLabel },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.constituentOptions (fn opt { type: button, action: ATTACH, actionPayload: { constituent: (object/get @opt key) }, label: (object/get @opt label), variant: primary, size: sm })) },
              { type: typography, variant: caption, content: @progressLabel },
              { type: typography, variant: body, content: @entity.syntaxFeedback },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: RESET_TREE, label: "Reset Tree", variant: ghost },
                  { type: button, action: NEXT_SENTENCE, label: "Next Sentence", variant: secondary }
                ] }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.sentenceIndex 0)
        (set @entity.stepIndex 0)
        (set @entity.syntaxFeedback "")
        (let (
            (currentSentence (array/nth @config.sentences 0))
            (sentenceWords (object/get @currentSentence words))
            (derivation (object/get @currentSentence derivation))
            (sentenceLabel (object/get @currentSentence label))
            (wordCount (array/len @sentenceWords))
            (totalSteps (array/len @derivation))
            (baseY (- @config.height @config.bottomMargin))
            (wordShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (w (array/nth @sentenceWords @idx))
                    (wx (+ @config.leftMargin (* @idx @config.wordSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "wr" @idx), x: (- @wx (/ @config.nodeWidth 2)), y: (- @baseY 14), width: @config.nodeWidth, height: 26, color: @config.wordNodeColor, fill: @config.wordNodeFill },
                    { type: "text", id: (str/concat "wt" @idx), x: @wx, y: @baseY, text: (object/get @w text), fontSize: @config.fontSize, align: "center", color: @config.wordTextColor },
                    { type: "text", id: (str/concat "wp" @idx), x: @wx, y: (+ @baseY 22), text: (object/get @w pos), fontSize: @config.posFontSize, align: "center", color: @config.posColor }
                  ]
                )))))
            (progressLabel (str/concat 0 "/" @totalSteps " constituents built"))
          )
          (do
            (set @entity.shapes @wordShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: @sentenceLabel },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.constituentOptions (fn opt { type: button, action: ATTACH, actionPayload: { constituent: (object/get @opt key) }, label: (object/get @opt label), variant: primary, size: sm })) },
              { type: typography, variant: caption, content: @progressLabel },
              { type: typography, variant: body, content: @entity.syntaxFeedback },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: RESET_TREE, label: "Reset Tree", variant: ghost },
                  { type: button, action: NEXT_SENTENCE, label: "Next Sentence", variant: secondary }
                ] }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      ATTACH -> idle when (== @entity.active true)
        (let (
            (currentSentence (array/nth @config.sentences @entity.sentenceIndex))
            (sentenceWords (object/get @currentSentence words))
            (derivation (object/get @currentSentence derivation))
            (sentenceLabel (object/get @currentSentence label))
            (wordCount (array/len @sentenceWords))
            (totalSteps (array/len @derivation))
            (baseY (- @config.height @config.bottomMargin))
            (isDone (>= @entity.stepIndex @totalSteps))
            (expectedStep (if @isDone null (array/nth @derivation @entity.stepIndex)))
            (isCorrect (if @isDone false (== (object/get @expectedStep constituent) ?constituent)))
            (nextStepIndex (if @isCorrect (+ @entity.stepIndex 1) @entity.stepIndex))
            (wordShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (w (array/nth @sentenceWords @idx))
                    (wx (+ @config.leftMargin (* @idx @config.wordSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "wr" @idx), x: (- @wx (/ @config.nodeWidth 2)), y: (- @baseY 14), width: @config.nodeWidth, height: 26, color: @config.wordNodeColor, fill: @config.wordNodeFill },
                    { type: "text", id: (str/concat "wt" @idx), x: @wx, y: @baseY, text: (object/get @w text), fontSize: @config.fontSize, align: "center", color: @config.wordTextColor },
                    { type: "text", id: (str/concat "wp" @idx), x: @wx, y: (+ @baseY 22), text: (object/get @w pos), fontSize: @config.posFontSize, align: "center", color: @config.posColor }
                  ]
                )))))
            (builtShapes (array/flatten (array/map (array/range @nextStepIndex) (fn k (let (
                    (step (array/nth @derivation @k))
                    (leftX (+ @config.leftMargin (* (object/get @step startIndex) @config.wordSpacing)))
                    (rightX (+ @config.leftMargin (* (object/get @step endIndex) @config.wordSpacing)))
                    (midX (/ (+ @leftX @rightX) 2))
                    (levelY (- (- @baseY @config.wordLabelGap) (* (+ (object/get @step level) 1) @config.levelHeight)))
                  )
                  [
                    { type: "line", id: (str/concat "bl" @k), x1: @leftX, y1: @levelY, x2: @rightX, y2: @levelY, color: @config.bracketColor, lineWidth: 2 },
                    { type: "line", id: (str/concat "lt" @k), x1: @leftX, y1: @levelY, x2: @leftX, y2: (- @baseY 14), color: @config.bracketColor, lineWidth: 1.5 },
                    { type: "line", id: (str/concat "rt" @k), x1: @rightX, y1: @levelY, x2: @rightX, y2: (- @baseY 14), color: @config.bracketColor, lineWidth: 1.5 },
                    { type: "text", id: (str/concat "bt" @k), x: @midX, y: (- @levelY 10), text: (object/get @step constituent), fontSize: @config.fontSize, align: "center", color: @config.bracketLabelColor }
                  ]
                )))))
            (treeShapes (array/concat @wordShapes @builtShapes))
            (progressLabel (str/concat @nextStepIndex "/" @totalSteps " constituents built"))
            (feedback (if @isDone
                "This sentence is fully parsed — press Next Sentence to continue."
                (if @isCorrect
                  (str/concat "Correct — built " (object/get @expectedStep constituent) ". " (object/get @expectedStep evidence))
                  (str/concat "Not yet — the next constituent to build is " (object/get @expectedStep constituent) ". " (object/get @expectedStep evidence)))))
          )
          (do
            (set @entity.stepIndex @nextStepIndex)
            (set @entity.syntaxFeedback @feedback)
            (set @entity.shapes @treeShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: @sentenceLabel },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.constituentOptions (fn opt { type: button, action: ATTACH, actionPayload: { constituent: (object/get @opt key) }, label: (object/get @opt label), variant: primary, size: sm })) },
              { type: typography, variant: caption, content: @progressLabel },
              { type: typography, variant: body, content: @entity.syntaxFeedback },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: RESET_TREE, label: "Reset Tree", variant: ghost },
                  { type: button, action: NEXT_SENTENCE, label: "Next Sentence", variant: secondary }
                ] }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit SYNTAXTREE_UPDATED { sentenceIndex: @entity.sentenceIndex, stepIndex: @entity.stepIndex, totalSteps: (array/len (object/get (array/nth @config.sentences @entity.sentenceIndex) derivation)), feedback: @entity.syntaxFeedback })

      RESET_TREE -> idle when (== @entity.active true)
        (set @entity.stepIndex 0)
        (set @entity.syntaxFeedback "")
        (let (
            (currentSentence (array/nth @config.sentences @entity.sentenceIndex))
            (sentenceWords (object/get @currentSentence words))
            (derivation (object/get @currentSentence derivation))
            (sentenceLabel (object/get @currentSentence label))
            (wordCount (array/len @sentenceWords))
            (totalSteps (array/len @derivation))
            (baseY (- @config.height @config.bottomMargin))
            (wordShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (w (array/nth @sentenceWords @idx))
                    (wx (+ @config.leftMargin (* @idx @config.wordSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "wr" @idx), x: (- @wx (/ @config.nodeWidth 2)), y: (- @baseY 14), width: @config.nodeWidth, height: 26, color: @config.wordNodeColor, fill: @config.wordNodeFill },
                    { type: "text", id: (str/concat "wt" @idx), x: @wx, y: @baseY, text: (object/get @w text), fontSize: @config.fontSize, align: "center", color: @config.wordTextColor },
                    { type: "text", id: (str/concat "wp" @idx), x: @wx, y: (+ @baseY 22), text: (object/get @w pos), fontSize: @config.posFontSize, align: "center", color: @config.posColor }
                  ]
                )))))
            (progressLabel (str/concat 0 "/" @totalSteps " constituents built"))
          )
          (do
            (set @entity.shapes @wordShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: @sentenceLabel },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.constituentOptions (fn opt { type: button, action: ATTACH, actionPayload: { constituent: (object/get @opt key) }, label: (object/get @opt label), variant: primary, size: sm })) },
              { type: typography, variant: caption, content: @progressLabel },
              { type: typography, variant: body, content: @entity.syntaxFeedback },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: RESET_TREE, label: "Reset Tree", variant: ghost },
                  { type: button, action: NEXT_SENTENCE, label: "Next Sentence", variant: secondary }
                ] }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit SYNTAXTREE_UPDATED { sentenceIndex: @entity.sentenceIndex, stepIndex: @entity.stepIndex, totalSteps: (array/len (object/get (array/nth @config.sentences @entity.sentenceIndex) derivation)), feedback: @entity.syntaxFeedback })

      NEXT_SENTENCE -> idle when (== @entity.active true)
        (set @entity.sentenceIndex (math/mod (+ @entity.sentenceIndex 1) (array/len @config.sentences)))
        (set @entity.stepIndex 0)
        (set @entity.syntaxFeedback "")
        (let (
            (currentSentence (array/nth @config.sentences @entity.sentenceIndex))
            (sentenceWords (object/get @currentSentence words))
            (derivation (object/get @currentSentence derivation))
            (sentenceLabel (object/get @currentSentence label))
            (wordCount (array/len @sentenceWords))
            (totalSteps (array/len @derivation))
            (baseY (- @config.height @config.bottomMargin))
            (wordShapes (array/flatten (array/map (array/range @wordCount) (fn idx (let (
                    (w (array/nth @sentenceWords @idx))
                    (wx (+ @config.leftMargin (* @idx @config.wordSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "wr" @idx), x: (- @wx (/ @config.nodeWidth 2)), y: (- @baseY 14), width: @config.nodeWidth, height: 26, color: @config.wordNodeColor, fill: @config.wordNodeFill },
                    { type: "text", id: (str/concat "wt" @idx), x: @wx, y: @baseY, text: (object/get @w text), fontSize: @config.fontSize, align: "center", color: @config.wordTextColor },
                    { type: "text", id: (str/concat "wp" @idx), x: @wx, y: (+ @baseY 22), text: (object/get @w pos), fontSize: @config.posFontSize, align: "center", color: @config.posColor }
                  ]
                )))))
            (progressLabel (str/concat 0 "/" @totalSteps " constituents built"))
          )
          (do
            (set @entity.shapes @wordShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: @sentenceLabel },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.constituentOptions (fn opt { type: button, action: ATTACH, actionPayload: { constituent: (object/get @opt key) }, label: (object/get @opt label), variant: primary, size: sm })) },
              { type: typography, variant: caption, content: @progressLabel },
              { type: typography, variant: body, content: @entity.syntaxFeedback },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: RESET_TREE, label: "Reset Tree", variant: ghost },
                  { type: button, action: NEXT_SENTENCE, label: "Next Sentence", variant: secondary }
                ] }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit SYNTAXTREE_UPDATED { sentenceIndex: @entity.sentenceIndex, stepIndex: @entity.stepIndex, totalSteps: (array/len (object/get (array/nth @config.sentences @entity.sentenceIndex) derivation)), feedback: @entity.syntaxFeedback })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      ATTACH {
        constituent : string
      }
        @description "Learner pressed a constituent-category button to attach the next bottom-up derivation step to the parse tree."
        @tier "domain"
      RESET_TREE {
      }
        @description "Learner reset the current sentence's parse tree back to just the words, clearing all built constituents."
        @tier "domain"
      NEXT_SENTENCE {
      }
        @description "Learner advanced to the next sentence in the roster, resetting the parse tree."
        @tier "domain"
    }

    emits {
      SYNTAXTREE_UPDATED -> external {
        sentenceIndex : number
        stepIndex : number
        totalSteps : number
        feedback : string
      }
        @description "The parse-tree state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "syntax tree update, constituent attached, parse progress, derivation step"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Syntax Tree Builder"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 420
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      sentences : [LingSyntaxtreeSentence] = [
        { id: "s1", label: "The cat chased the mouse.", words: [
            { text: "The", pos: "Det" }, { text: "cat", pos: "N" }, { text: "chased", pos: "V" }, { text: "the", pos: "Det" }, { text: "mouse", pos: "N" }
          ], derivation: [
            { constituent: NP, startIndex: 0, endIndex: 1, level: 0, evidence: "A determiner (Det) and a noun (N) combine into a Noun Phrase — here the subject \"The cat\"." },
            { constituent: NP, startIndex: 3, endIndex: 4, level: 0, evidence: "A determiner (Det) and a noun (N) combine into a Noun Phrase — here the object \"the mouse\"." },
            { constituent: VP, startIndex: 2, endIndex: 4, level: 1, evidence: "A verb (V) and its object Noun Phrase combine into a Verb Phrase — \"chased the mouse\"." },
            { constituent: S, startIndex: 0, endIndex: 4, level: 2, evidence: "The subject Noun Phrase and the Verb Phrase combine into the full Sentence." }
          ] },
        { id: "s2", label: "A dog sat on the mat.", words: [
            { text: "A", pos: "Det" }, { text: "dog", pos: "N" }, { text: "sat", pos: "V" }, { text: "on", pos: "P" }, { text: "the", pos: "Det" }, { text: "mat", pos: "N" }
          ], derivation: [
            { constituent: NP, startIndex: 0, endIndex: 1, level: 0, evidence: "A determiner (Det) and a noun (N) combine into a Noun Phrase — here the subject \"A dog\"." },
            { constituent: NP, startIndex: 4, endIndex: 5, level: 0, evidence: "A determiner (Det) and a noun (N) combine into a Noun Phrase — here the object of the preposition, \"the mat\"." },
            { constituent: PP, startIndex: 3, endIndex: 5, level: 1, evidence: "A preposition (P) and its Noun Phrase combine into a Prepositional Phrase — \"on the mat\"." },
            { constituent: VP, startIndex: 2, endIndex: 5, level: 2, evidence: "A verb (V) and its Prepositional Phrase combine into a Verb Phrase — \"sat on the mat\"." },
            { constituent: S, startIndex: 0, endIndex: 5, level: 3, evidence: "The subject Noun Phrase and the Verb Phrase combine into the full Sentence." }
          ] },
        { id: "s3", label: "Birds sing.", words: [
            { text: "Birds", pos: "N" }, { text: "sing", pos: "V" }
          ], derivation: [
            { constituent: NP, startIndex: 0, endIndex: 0, level: 0, evidence: "A bare noun (N) alone forms a Noun Phrase — the subject \"Birds\"." },
            { constituent: VP, startIndex: 1, endIndex: 1, level: 0, evidence: "A single intransitive verb (V) with no object still forms a Verb Phrase — \"sing\"." },
            { constituent: S, startIndex: 0, endIndex: 1, level: 1, evidence: "The subject Noun Phrase and the Verb Phrase combine into the full Sentence." }
          ] }
      ]
        @label "Sentences"
        @description "Roster of sentences the learner parses. Each sentence carries its words (text + part-of-speech tag) and an ORDERED bottom-up derivation: each step names the constituent category built, the word-index span it covers, the tree level it renders at, and the evidence text shown when the learner attaches it (correctly or not)."
        @synonyms "sentence roster, derivation, bottom-up derivation, constituent span, part of speech, phrase structure rule"
        @tier "domain"
      constituentOptions : [LingSyntaxtreeConstituentOption] = [
        { key: NP, label: "NP — Noun Phrase" },
        { key: VP, label: "VP — Verb Phrase" },
        { key: PP, label: "PP — Prepositional Phrase" },
        { key: S, label: "S — Sentence" }
      ]
        @label "Constituent Options"
        @description "The four constituent-category buttons offered to the learner; pressing one attempts to attach it as the next derivation step."
        @synonyms "constituent category, phrase category, noun phrase button, verb phrase button"
        @tier "domain"
      leftMargin : number = 50
        @label "Left Margin (px)"
        @description "Horizontal offset of the first word node from the canvas edge, in pixels."
        @tier "presentation"
      wordSpacing : number = 90
        @label "Word Spacing (px)"
        @description "Horizontal distance between successive word nodes, in pixels."
        @tier "presentation"
      nodeWidth : number = 64
        @label "Word Node Width (px)"
        @description "Width of each word's background box, in pixels."
        @tier "presentation"
      levelHeight : number = 60
        @label "Tree Level Height (px)"
        @description "Vertical distance between successive constituent levels in the growing tree, in pixels."
        @tier "presentation"
      wordLabelGap : number = 30
        @label "Word Label Gap (px)"
        @description "Vertical gap between the word row and the first constituent level above it, in pixels."
        @tier "presentation"
      bottomMargin : number = 60
        @label "Bottom Margin (px)"
        @description "Vertical offset of the word row from the bottom of the canvas, in pixels."
        @tier "presentation"
      fontSize : number = 16
        @label "Word / Bracket Font Size"
        @tier "presentation"
      posFontSize : number = 12
        @label "Part-of-Speech Font Size"
        @tier "presentation"
      wordNodeColor : string = "#1e293b"
        @label "Word Node Border Color"
        @tier "presentation"
      wordNodeFill : string = "#e2e8f0"
        @label "Word Node Fill Color"
        @tier "presentation"
      wordTextColor : string = "#0f172a"
        @label "Word Text Color"
        @tier "presentation"
      posColor : string = "#64748b"
        @label "Part-of-Speech Text Color"
        @tier "presentation"
      bracketColor : string = "#2563eb"
        @label "Bracket Line Color"
        @tier "presentation"
      bracketLabelColor : string = "#1d4ed8"
        @label "Bracket Label Color"
        @tier "presentation"
    }
  }

  page "/ling-syntaxtree" as LingSyntaxtreePage -> LingSyntaxtreeSim
}
