app std-algo-binarysearch "1.0.0"
"Algorithm-animation engine (algorithm-canvas): Binary-search engine — efficiently finds a target value in a sorted array by repeatedly halving the search interval; composed by a learning orbital via `uses`."
orbital BinarySearchEngineOrbital {
  type AlgoBar = {
    value : number!
    color : string
    label : string
  }

  entity BinarySearchScene [runtime] {
    id : string!
    bars : [AlgoBar]
    low : number = 0
    high : number = 0
    target : number = 0
    found : boolean = false
    done : boolean = false
    running : boolean = true
  }

  trait BinarySearchSim -> @rebindable BinarySearchScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.bars @config.bars)
        (set @entity.low 0)
        (set @entity.high (- (array/len @config.bars) 1))
        (set @entity.target @config.target)
        (set @entity.running @config.running)
        (set @entity.done false)
        (set @entity.found false)
        (render-ui main {
          type: algorithm-canvas
          width: @config.width
          height: @config.height
          backgroundColor: @config.backgroundColor
          bars: @entity.bars
        })
        (emit BARS_UPDATED { bars: @entity.bars })
    }

    ticks {
      searchTick every 800ms
        when (and @entity.running (not @entity.done))
        (let (
          (mid (math/floor (/ (+ @entity.low @entity.high) 2)))
          (mid_val (object/get (array/nth @entity.bars @mid) value))
        )
        (let (
          (is_equal (== @mid_val @entity.target))
          (is_too_low (< @entity.target @mid_val))
          (is_too_high (> @entity.target @mid_val))
        )
        (do
          (if @is_equal
            (do
              (set @entity.found true)
              (set @entity.done true))
            (if (<= @entity.low @entity.high)
              (do
                (if @is_too_low
                  (set @entity.high (- @mid 1))
                  (set @entity.low (+ @mid 1)))
                (if (not (and (<= @entity.low @entity.high) (not @is_equal)))
                  (set @entity.done true)
                  (set @entity.done false)))
              (set @entity.done true)))
          (set @entity.bars (array/map @entity.bars
            (object/merge @item {
              color: (if @entity.found "#22c55e"
                       (if (and (>= @index @entity.low) (<= @index @entity.high)) "#f59e0b"
                         "#3b82f6"))
            })))
          (render-ui main {
            type: algorithm-canvas
            width: @config.width
            height: @config.height
            backgroundColor: @config.backgroundColor
            bars: @entity.bars
          })
          (emit BARS_UPDATED { bars: @entity.bars })
        )))
    }

    emits {
      BARS_UPDATED -> external {
        bars : [AlgoBar]
      }
        @description "The current bar array each step."
        @synonyms "tick, frame, step, redraw, compare, swap"
        @tier "domain"
    }

    config {
      running : boolean = true
        @label "Running"
        @description "Toggle to start/pause the search."
        @tier "domain"
      target : number = 5
        @label "Target Value"
        @description "The value to search for in the sorted array."
        @tier "domain"
      width : number = 600
        @label "Width"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
      bars : [AlgoBar] = [
        { value: 1, color: "#3b82f6", label: "1" },
        { value: 2, color: "#3b82f6", label: "2" },
        { value: 3, color: "#3b82f6", label: "3" },
        { value: 4, color: "#3b82f6", label: "4" },
        { value: 5, color: "#3b82f6", label: "5" },
        { value: 6, color: "#3b82f6", label: "6" },
        { value: 7, color: "#3b82f6", label: "7" },
        { value: 8, color: "#3b82f6", label: "8" },
        { value: 9, color: "#3b82f6", label: "9" }
      ]
        @label "Bars"
        @description "A sorted array of values."
        @tier "presentation"
    }
  }

  page "/algo-binarysearch" as BinarySearchEnginePage -> BinarySearchSim
}
