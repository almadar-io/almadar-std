app std-algo-stack "1.0.0"
"Algorithm-animation engine (algorithm-canvas): Stack engine — performs push and pop operations on a collection of elements, visualized as a growing and shrinking bar array; composed by a learning orbital via `uses`."
orbital StackEngineOrbital {
  type AlgoBar = {
    value : number!
    color : string
    label : string
  }

  entity StackScene [runtime] {
    id : string!
    bars : [AlgoBar]
    top : number = -1
    running : boolean = true
    done : boolean = false
    pushing : boolean = false
    popping : boolean = false
  }

  trait StackSim -> @rebindable StackScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.bars @config.bars)
        (set @entity.top -1)
        (set @entity.running @config.running)
        (set @entity.done false)
        (set @entity.pushing false)
        (set @entity.popping false)
        (render-ui main {
          type: algorithm-canvas
          width: @config.width
          height: @config.height
          backgroundColor: @config.backgroundColor
          bars: @entity.bars
        })
        (emit STACK_UPDATED { bars: @entity.bars, top: @entity.top })
    }

    ticks {
      stackTick every 1000ms
        when (and @entity.running (not @entity.done))
        (do
          (if (and (== @entity.top 9) (not @entity.pushing))
            (set @entity.done true)
            (set @entity.done false))
          (if @entity.pushing
            (do
              (set @entity.top (+ @entity.top 1))
              (set @entity.bars (array/map @entity.bars
                (if (== @index @entity.top)
                  (object/merge @item {
                    value: @config.next_value
                    color: "#3b82f6"
                    label: (string @config.next_value)
                  })
                  @item)))
              (set @entity.pushing false))
            (set @entity.pushing false))
          (if @entity.popping
            (do
              (set @entity.top (- @entity.top 1))
              (set @entity.bars (array/map @entity.bars
                (if (>= @index @entity.top)
                  (object/merge @item { color: "#e2e8f0", label: "" })
                  @item)))
              (set @entity.popping false))
            (set @entity.popping false))
          (render-ui main {
            type: algorithm-canvas
            width: @config.width
            height: @config.height
            backgroundColor: @config.backgroundColor
            bars: @entity.bars
          })
          (emit STACK_UPDATED { bars: @entity.bars, top: @entity.top })
        )
    }

    emits {
      STACK_UPDATED -> external {
        bars : [AlgoBar]
        top : number
      }
        @description "The current stack state each tick."
        @tier "domain"
    }

    config {
      running : boolean = true
        @label "Running"
        @description "Toggle to start/pause the stack operations."
        @tier "domain"
      pushing : boolean = false
        @label "Push"
        @description "Toggle to push an item onto the stack."
        @tier "domain"
      popping : boolean = false
        @label "Pop"
        @description "Toggle to pop an item from the stack."
        @tier "domain"
      next_value : number = 0
        @label "Next Value"
        @description "The value to push onto the stack."
        @tier "domain"
      width : number = 600
        @label "Width"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
      bars : [AlgoBar] = [
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" },
        { value: 0, color: "#e2e8f0", label: "" }
      ]
        @label "Stack Slots"
        @description "Pre-allocated slots for the stack elements."
        @tier "presentation"
    }
  }

  page "/algo-stack" as StackEnginePage -> StackSim
}
