app ui-physics-canvas "1.0.0"
"PhysicsCanvas — UI factory (1:1 with the @almadar/ui physics-canvas pattern)."
orbital PhysicsCanvasOrbital {
  type PhysicsCanvasBodiesItem = {
    id : string
    x : number!
    y : number!
    z : number
    radius : number
    color : string
    label : string
    vx : number
    vy : number
    vz : number
    fx : number
    fy : number
    fz : number
  }
  type PhysicsCanvasConstraintsItem = {
    from : string!
    to : string!
    color : string
    kind : "rod" | "spring" | "string"
  }
  type PhysicsCanvasSceneObjectsItem = {
    kind : "ground" | "wall" | "ramp" | "box" | "pivot"!
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    width : number
    height : number
    color : string
    fill : string
    label : string
  }
  type PhysicsCanvasTrailsItem = {
    id : string
    points : [PhysicsCanvasTrailsItemPointsItem]!
    color : string
    width : number
    opacity : number
    fade : boolean
  }
  type PhysicsCanvasTrailsItemPointsItem = {
    x : number!
    y : number!
    z : number
  }
  type PhysicsCanvasVectorsItem = {
    x : number
    y : number
    body : string
    dx : number!
    dy : number!
    scale : number
    color : string
    label : string
    dash : "dashed" | "dotted"
  }
  type PhysicsCanvasSurface3d = {
    nx : number!
    ny : number!
    heights : [number]!
    spacing : number
    x : number
    y : number
    bands : [PhysicsCanvasSurface3dBandsItem]
    color : string
    opacity : number
    flatShading : boolean
  }
  type PhysicsCanvasSurface3dBandsItem = {
    min : number
    color : string!
  }
  type PhysicsCanvasVectors3dItem = {
    id : string
    x : number!
    y : number!
    z : number
    dx : number!
    dy : number!
    dz : number
    color : string
    label : string
    width : number
  }
  type PhysicsCanvasAnglesItem = {
    x : number!
    y : number!
    from : number!
    to : number!
    radius : number
    color : string
    label : string
  }
  type PhysicsCanvasField = {
    kind : "arrows" | "into" | "out"!
    spacing : number
    angle : number
    size : number
    color : string
    x : number
    y : number
    width : number
    height : number
  }
  type PhysicsCanvasMetersItem = {
    label : string!
    value : number!
    max : number
    color : string
  }
  type PhysicsCanvasShapesItem = {
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [PhysicsCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type PhysicsCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type PhysicsCanvasReadoutsItem = {
    label : string!
    value : string!
    color : string
  }
  type PhysicsCanvasTracesItem = {
    x : number
    y : number
    width : number
    height : number
    series : [PhysicsCanvasTracesItemSeriesItem]!
    xLabel : string
    yLabel : string
    frameColor : string
    backgroundColor : string
    backgroundOpacity : number
  }
  type PhysicsCanvasTracesItemSeriesItem = {
    samples : [PhysicsCanvasTracesItemSeriesItemSamplesItem]!
    color : string
    label : string
  }
  type PhysicsCanvasTracesItemSeriesItemSamplesItem = {
    x : number!
    y : number!
  }
  type PhysicsCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type PhysicsCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }

  entity PhysicsCanvasItem [runtime] {
    id : string!
  }

  trait PhysicsCanvasRender -> @rebindable PhysicsCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          bodies: @config.bodies
          constraints: @config.constraints
          showVelocity: @config.showVelocity
          showForces: @config.showForces
          velocityScale: @config.velocityScale
          forceScale: @config.forceScale
          sceneObjects: @config.sceneObjects
          trails: @config.trails
          vectors: @config.vectors
          surface3d: @config.surface3d
          vectors3d: @config.vectors3d
          vectorScale: @config.vectorScale
          angles: @config.angles
          field: @config.field
          meters: @config.meters
          shapes: @config.shapes
          readouts: @config.readouts
          traces: @config.traces
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          type: physics-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          mode: @config.mode
          camera: @config.camera
          lighting: @config.lighting
          post: @config.post
          bodies: @payload.bodies
          constraints: @payload.constraints
          showVelocity: @config.showVelocity
          showForces: @config.showForces
          velocityScale: @config.velocityScale
          forceScale: @config.forceScale
          sceneObjects: @payload.sceneObjects
          trails: @payload.trails
          vectors: @payload.vectors
          surface3d: @config.surface3d
          vectors3d: @payload.vectors3d
          vectorScale: @config.vectorScale
          angles: @payload.angles
          field: @config.field
          meters: @payload.meters
          shapes: @payload.shapes
          readouts: @payload.readouts
          traces: @payload.traces
          showGrid: @config.showGrid
          shadows: @config.shadows
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          type: physics-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : PhysicsCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
    }

    listens {
      UPDATE {
        bodies : [PhysicsCanvasBodiesItem]
        constraints : [PhysicsCanvasConstraintsItem]
        sceneObjects : [PhysicsCanvasSceneObjectsItem]
        trails : [PhysicsCanvasTrailsItem]
        vectors : [PhysicsCanvasVectorsItem]
        vectors3d : [PhysicsCanvasVectors3dItem]
        angles : [PhysicsCanvasAnglesItem]
        meters : [PhysicsCanvasMetersItem]
        shapes : [PhysicsCanvasShapesItem]
        readouts : [PhysicsCanvasReadoutsItem]
        traces : [PhysicsCanvasTracesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "backgroundColor prop"
        @tier "presentation"
      mode : "2d" | "3d" = "2d"
        @label "Mode"
        @description "Painter: 2D raster (default) or 3D mesh scene via the lazy three.js host."
        @tier "presentation"
      camera : json = {}
        @label "Camera"
        @description "3D only: neutral camera pose ({ mode, zoom, fov, azimuth, target })."
        @tier "presentation"
      lighting : object = {}
        @label "Lighting"
        @description "3D only: scene light rig as data."
        @tier "presentation"
      post : object = {}
        @label "Post"
        @description "3D only: post-processing stack (bloom/vignette)."
        @tier "presentation"
      bodies : [PhysicsCanvasBodiesItem] = []
        @label "Bodies"
        @description "bodies prop"
        @tier "presentation"
      constraints : [PhysicsCanvasConstraintsItem] = []
        @label "Constraints"
        @description "constraints prop"
        @tier "presentation"
      showVelocity : boolean = true
        @label "Show Velocity"
        @description "showVelocity prop"
        @tier "presentation"
      showForces : boolean = false
        @label "Show Forces"
        @description "showForces prop"
        @tier "presentation"
      velocityScale : number = 20
        @label "Velocity Scale"
        @description "velocityScale prop"
        @tier "presentation"
      forceScale : number = 20
        @label "Force Scale"
        @description "forceScale prop"
        @tier "presentation"
      sceneObjects : [PhysicsCanvasSceneObjectsItem] = []
        @label "Scene Objects"
        @description "Ground/wall/ramp/box/pivot scene fixtures. 2D only."
        @tier "presentation"
      trails : [PhysicsCanvasTrailsItem] = []
        @label "Trails"
        @description "Fading trajectory polylines (2D) / trajectory tubes (3D)."
        @tier "presentation"
      vectors : [PhysicsCanvasVectorsItem] = []
        @label "Vectors"
        @description "Named force/velocity/free-body arrows, anchored by point or by body id. 2D only."
        @tier "presentation"
      surface3d : PhysicsCanvasSurface3d
        @label "Surface3d"
        @description "A 3D height-field surface mesh (wave, terrain, potential well). 3D only."
        @tier "presentation"
      vectors3d : [PhysicsCanvasVectors3dItem] = []
        @label "Vectors3d"
        @description "Labeled 3D arrows (field arrows, axis triads). 3D only."
        @tier "presentation"
      vectorScale : number = 1
        @label "Vector Scale"
        @description "Multiplies every `vectors3d` entry's `dx`/`dy`/`dz` (default 1). 3D only."
        @tier "presentation"
      angles : [PhysicsCanvasAnglesItem] = []
        @label "Angles"
        @description "Angle arcs between two bearings. 2D only."
        @tier "presentation"
      field : PhysicsCanvasField
        @label "Field"
        @description "A single uniform vector/into/out field lattice. 2D only."
        @tier "presentation"
      meters : [PhysicsCanvasMetersItem] = []
        @label "Meters"
        @description "Bottom-left labeled bar gauges. 2D only."
        @tier "presentation"
      shapes : [PhysicsCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates (2D mode only — ignored in 3D)."
        @tier "presentation"
      readouts : [PhysicsCanvasReadoutsItem] = []
        @label "Readouts"
        @description "Top-right status chip row, forwarded to LearningCanvas verbatim."
        @tier "presentation"
      traces : [PhysicsCanvasTracesItem] = []
        @label "Traces"
        @description "Inset sparkline panels, forwarded to LearningCanvas verbatim."
        @tier "presentation"
      showGrid : boolean
        @label "Show Grid"
        @description "3D only: show the ground grid (default off)."
        @tier "presentation"
      shadows : boolean
        @label "Shadows"
        @description "3D only: enable shadows. Omitted → the host default."
        @tier "presentation"
      interactive : boolean
        @label "Interactive"
        @description "2D: pointer interaction (click/hover). 3D: orbit camera controls."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "2D only: continuous redraw loop. 3D motion is entity-state driven."
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : PhysicsCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
    }
  }

  page "/physics-canvas" as PhysicsCanvasPage -> PhysicsCanvasRender
}
