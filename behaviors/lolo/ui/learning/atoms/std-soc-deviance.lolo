app std-soc-deviance "1.0.0"
"Deviance & labeling engine — the learner classifies each act through labeling theory: conforming, primary deviance (norm violation, informal sanction), or secondary deviance (formal label applied and internalized), with per-item feedback and a rubric-scored running total capped at a score cap, on a biology-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital SocDevOrbital {
  type SocDevNode = {
    id : string!
    x : number!
    y : number!
    radius : number
    color : string
    label : string
  }
  type SocDevEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type SocDevOption = {
    id : string!
    label : string!
    correct : boolean!
  }
  type SocDevScenario = {
    id : string!
    actText : string!
    explanation : string!
    options : [SocDevOption]!
  }
  type SocDevRubric = {
    pointsPerCorrect : number!
    penaltyPerMiss : number!
  }

  entity SocDevScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [SocDevNode]
    edges : [SocDevEdge]
    itemIndex : number
    score : number
    answeredCorrectly : boolean
    feedbackText : string
    explanationText : string
  }

  trait SocDevSim -> @rebindable SocDevScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.itemIndex 0)
        (set @entity.score 0)
        (set @entity.answeredCorrectly false)
        (set @entity.feedbackText "")
        (set @entity.explanationText "")
        (let (
            (currentScenario (array/nth @config.scenarios 0))
            (options (object/get @currentScenario options))
            (opt0 (array/nth @options 0))
            (opt1 (array/nth @options 1))
            (opt2 (array/nth @options 2))
            (devNodesCalc [
                { id: "act", x: (* @config.width 0.18), y: (/ @config.height 2), radius: @config.actNodeRadius, color: @config.actNodeColor, label: "Act" },
                { id: (object/get @opt0 id), x: (* @config.width 0.75), y: (* @config.height 0.25), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Conforming" },
                { id: (object/get @opt1 id), x: (* @config.width 0.75), y: (* @config.height 0.5), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Primary" },
                { id: (object/get @opt2 id), x: (* @config.width 0.75), y: (* @config.height 0.75), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Secondary" }
              ])
          )
          (do
            (set @entity.nodes @devNodesCalc)
            (set @entity.edges [])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_ITEM, label: "Next Act", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Act " (+ @entity.itemIndex 1) " of " (array/len @config.scenarios)) },
                { type: typography, variant: body, content: (object/get (array/nth @config.scenarios @entity.itemIndex) actText) },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: (array/map (object/get (array/nth @config.scenarios @entity.itemIndex) options) (fn o { type: button, action: CLASSIFY_ITEM, actionPayload: { optionId: (object/get @o id) }, label: (object/get @o label), variant: (if (and @entity.answeredCorrectly (object/get @o correct)) "success" "secondary") })) },
                { type: typography, variant: caption, content: @entity.feedbackText },
                { type: typography, variant: body, content: @entity.explanationText },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.score " / " @config.scoreCap) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.itemIndex 0)
        (set @entity.score 0)
        (set @entity.answeredCorrectly false)
        (set @entity.feedbackText "")
        (set @entity.explanationText "")
        (let (
            (currentScenario (array/nth @config.scenarios 0))
            (options (object/get @currentScenario options))
            (opt0 (array/nth @options 0))
            (opt1 (array/nth @options 1))
            (opt2 (array/nth @options 2))
            (devNodesCalc [
                { id: "act", x: (* @config.width 0.18), y: (/ @config.height 2), radius: @config.actNodeRadius, color: @config.actNodeColor, label: "Act" },
                { id: (object/get @opt0 id), x: (* @config.width 0.75), y: (* @config.height 0.25), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Conforming" },
                { id: (object/get @opt1 id), x: (* @config.width 0.75), y: (* @config.height 0.5), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Primary" },
                { id: (object/get @opt2 id), x: (* @config.width 0.75), y: (* @config.height 0.75), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Secondary" }
              ])
          )
          (do
            (set @entity.nodes @devNodesCalc)
            (set @entity.edges [])
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: stack, direction: horizontal, gap: sm, children: [
                      { type: button, action: NEXT_ITEM, label: "Next Act", variant: primary },
                      { type: button, action: RESET, label: "Reset", variant: ghost }
                    ] },
                  { type: typography, variant: caption, content: (str/concat "Act " (+ @entity.itemIndex 1) " of " (array/len @config.scenarios)) },
                  { type: typography, variant: body, content: (object/get (array/nth @config.scenarios @entity.itemIndex) actText) },
                  { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: [], interactive: @config.interactive, animate: @config.animate },
                  { type: stack, direction: vertical, gap: xs, children: (array/map (object/get (array/nth @config.scenarios @entity.itemIndex) options) (fn o { type: button, action: CLASSIFY_ITEM, actionPayload: { optionId: (object/get @o id) }, label: (object/get @o label), variant: (if (and @entity.answeredCorrectly (object/get @o correct)) "success" "secondary") })) },
                  { type: typography, variant: caption, content: @entity.feedbackText },
                  { type: typography, variant: body, content: @entity.explanationText },
                  { type: typography, variant: caption, content: (str/concat "Score: " @entity.score " / " @config.scoreCap) }
                ] }
            ]
        })

      CLASSIFY_ITEM -> idle when (== @entity.active true)
        (let (
            (currentScenario (array/nth @config.scenarios @entity.itemIndex))
            (options (object/get @currentScenario options))
            (selectedOption (array/first (array/filter @options (fn o (== (object/get @o id) ?optionId)))))
            (isCorrect (if (!= @selectedOption null) (object/get @selectedOption correct) false))
            (opt0 (array/nth @options 0))
            (opt1 (array/nth @options 1))
            (opt2 (array/nth @options 2))
            (correctOpt (array/first (array/filter @options (fn o (object/get @o correct)))))
            (correctId (object/get @correctOpt id))
            (newAnswered (or @entity.answeredCorrectly @isCorrect))
            (newScore (if (and @isCorrect (not @entity.answeredCorrectly))
              (math/min @config.scoreCap (+ @entity.score (object/get @config.rubric pointsPerCorrect)))
              (if (not @isCorrect)
                (math/max 0 (- @entity.score (object/get @config.rubric penaltyPerMiss)))
                @entity.score)))
            (newFeedback (if @isCorrect "Correct — that's the labeling-theory reading of this act." "Not quite — think about whether a label was applied and internalized. Try again."))
            (newExplanation (if @newAnswered (object/get @currentScenario explanation) ""))
            (newEdges (if @newAnswered [ { from: "act", to: @correctId, color: @config.highlightColor, label: "" } ] []))
            (newNodes [
                { id: "act", x: (* @config.width 0.18), y: (/ @config.height 2), radius: @config.actNodeRadius, color: @config.actNodeColor, label: "Act" },
                { id: (object/get @opt0 id), x: (* @config.width 0.75), y: (* @config.height 0.25), radius: @config.classNodeRadius, color: (if (and @newAnswered (object/get @opt0 correct)) @config.highlightColor @config.classNodeColor), label: "Conforming" },
                { id: (object/get @opt1 id), x: (* @config.width 0.75), y: (* @config.height 0.5), radius: @config.classNodeRadius, color: (if (and @newAnswered (object/get @opt1 correct)) @config.highlightColor @config.classNodeColor), label: "Primary" },
                { id: (object/get @opt2 id), x: (* @config.width 0.75), y: (* @config.height 0.75), radius: @config.classNodeRadius, color: (if (and @newAnswered (object/get @opt2 correct)) @config.highlightColor @config.classNodeColor), label: "Secondary" }
              ])
          )
          (do
            (set @entity.answeredCorrectly @newAnswered)
            (set @entity.score @newScore)
            (set @entity.feedbackText @newFeedback)
            (set @entity.explanationText @newExplanation)
            (set @entity.nodes @newNodes)
            (set @entity.edges @newEdges)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_ITEM, label: "Next Act", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Act " (+ @entity.itemIndex 1) " of " (array/len @config.scenarios)) },
                { type: typography, variant: body, content: (object/get (array/nth @config.scenarios @entity.itemIndex) actText) },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: (array/map (object/get (array/nth @config.scenarios @entity.itemIndex) options) (fn o { type: button, action: CLASSIFY_ITEM, actionPayload: { optionId: (object/get @o id) }, label: (object/get @o label), variant: (if (and @entity.answeredCorrectly (object/get @o correct)) "success" "secondary") })) },
                { type: typography, variant: caption, content: @entity.feedbackText },
                { type: typography, variant: body, content: @entity.explanationText },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.score " / " @config.scoreCap) }
              ] }
          ]
        })
        (emit DEVIANCE_UPDATED { itemIndex: @entity.itemIndex, score: @entity.score, answeredCorrectly: @entity.answeredCorrectly, feedback: @entity.feedbackText })

      NEXT_ITEM -> idle when (== @entity.active true)
        (let (
            (nextIndex (math/mod (+ @entity.itemIndex 1) (array/len @config.scenarios)))
            (currentScenario (array/nth @config.scenarios @nextIndex))
            (options (object/get @currentScenario options))
            (opt0 (array/nth @options 0))
            (opt1 (array/nth @options 1))
            (opt2 (array/nth @options 2))
            (newNodes [
                { id: "act", x: (* @config.width 0.18), y: (/ @config.height 2), radius: @config.actNodeRadius, color: @config.actNodeColor, label: "Act" },
                { id: (object/get @opt0 id), x: (* @config.width 0.75), y: (* @config.height 0.25), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Conforming" },
                { id: (object/get @opt1 id), x: (* @config.width 0.75), y: (* @config.height 0.5), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Primary" },
                { id: (object/get @opt2 id), x: (* @config.width 0.75), y: (* @config.height 0.75), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Secondary" }
              ])
          )
          (do
            (set @entity.itemIndex @nextIndex)
            (set @entity.answeredCorrectly false)
            (set @entity.feedbackText "")
            (set @entity.explanationText "")
            (set @entity.nodes @newNodes)
            (set @entity.edges [])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_ITEM, label: "Next Act", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Act " (+ @entity.itemIndex 1) " of " (array/len @config.scenarios)) },
                { type: typography, variant: body, content: (object/get (array/nth @config.scenarios @entity.itemIndex) actText) },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: (array/map (object/get (array/nth @config.scenarios @entity.itemIndex) options) (fn o { type: button, action: CLASSIFY_ITEM, actionPayload: { optionId: (object/get @o id) }, label: (object/get @o label), variant: (if (and @entity.answeredCorrectly (object/get @o correct)) "success" "secondary") })) },
                { type: typography, variant: caption, content: @entity.feedbackText },
                { type: typography, variant: body, content: @entity.explanationText },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.score " / " @config.scoreCap) }
              ] }
          ]
        })
        (emit DEVIANCE_UPDATED { itemIndex: @entity.itemIndex, score: @entity.score, answeredCorrectly: @entity.answeredCorrectly, feedback: @entity.feedbackText })

      RESET -> idle when (== @entity.active true)
        (set @entity.itemIndex 0)
        (set @entity.score 0)
        (set @entity.answeredCorrectly false)
        (set @entity.feedbackText "")
        (set @entity.explanationText "")
        (let (
            (currentScenario (array/nth @config.scenarios 0))
            (options (object/get @currentScenario options))
            (opt0 (array/nth @options 0))
            (opt1 (array/nth @options 1))
            (opt2 (array/nth @options 2))
            (devNodesCalc [
                { id: "act", x: (* @config.width 0.18), y: (/ @config.height 2), radius: @config.actNodeRadius, color: @config.actNodeColor, label: "Act" },
                { id: (object/get @opt0 id), x: (* @config.width 0.75), y: (* @config.height 0.25), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Conforming" },
                { id: (object/get @opt1 id), x: (* @config.width 0.75), y: (* @config.height 0.5), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Primary" },
                { id: (object/get @opt2 id), x: (* @config.width 0.75), y: (* @config.height 0.75), radius: @config.classNodeRadius, color: @config.classNodeColor, label: "Secondary" }
              ])
          )
          (do
            (set @entity.nodes @devNodesCalc)
            (set @entity.edges [])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: NEXT_ITEM, label: "Next Act", variant: primary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Act " (+ @entity.itemIndex 1) " of " (array/len @config.scenarios)) },
                { type: typography, variant: body, content: (object/get (array/nth @config.scenarios @entity.itemIndex) actText) },
                { type: biology-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, nodes: @entity.nodes, edges: @entity.edges, shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: vertical, gap: xs, children: (array/map (object/get (array/nth @config.scenarios @entity.itemIndex) options) (fn o { type: button, action: CLASSIFY_ITEM, actionPayload: { optionId: (object/get @o id) }, label: (object/get @o label), variant: (if (and @entity.answeredCorrectly (object/get @o correct)) "success" "secondary") })) },
                { type: typography, variant: caption, content: @entity.feedbackText },
                { type: typography, variant: body, content: @entity.explanationText },
                { type: typography, variant: caption, content: (str/concat "Score: " @entity.score " / " @config.scoreCap) }
              ] }
          ]
        })
        (emit DEVIANCE_UPDATED { itemIndex: @entity.itemIndex, score: @entity.score, answeredCorrectly: @entity.answeredCorrectly, feedback: @entity.feedbackText })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      CLASSIFY_ITEM {
        optionId : string
      }
        @description "Learner clicked one of the three classification buttons to label the current act as conforming, primary deviance, or secondary deviance."
        @tier "domain"
      NEXT_ITEM {
      }
        @description "Learner pressed Next Act to advance to the next scenario."
        @tier "domain"
      RESET {
      }
        @description "Learner pressed Reset to restart the exercise from the first act with a zeroed score."
        @tier "domain"
    }

    emits {
      DEVIANCE_UPDATED -> external {
        itemIndex : number
        score : number
        answeredCorrectly : boolean
        feedback : string
      }
        @description "The deviance-exercise state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "deviance update, classification, labeling theory, sanction, score change"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Deviance & Labeling"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      backgroundColor : string = "#f1f5f9"
        @label "Background Color"
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 460
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      actNodeColor : string = "#1e293b"
        @label "Act Node Color"
        @tier "presentation"
      classNodeColor : string = "#64748b"
        @label "Class Node Color"
        @tier "presentation"
      highlightColor : string = "#16a34a"
        @label "Highlight Color"
        @description "Color used for the correct classification node and the connecting edge once the act is classified correctly."
        @tier "presentation"
      actNodeRadius : number = 44
        @label "Act Node Radius"
        @tier "presentation"
      classNodeRadius : number = 40
        @label "Class Node Radius"
        @tier "presentation"
      rubric : SocDevRubric = { pointsPerCorrect: 1, penaltyPerMiss: 0 }
        @label "Rubric"
        @description "Scoring rubric: points added for the first correct classification of an act, points subtracted for each wrong attempt (score never drops below zero)."
        @synonyms "rubric, scoring, grading, points"
        @tier "domain"
      scoreCap : number = 4
        @label "Score Cap"
        @description "Maximum attainable score; correct answers beyond the cap do not increase it."
        @synonyms "score cap, maximum score, grading"
        @tier "domain"
      scenarios : [SocDevScenario] = [
        { id: "speeding", actText: "A driver is ticketed for speeding, pays the fine, and thinks no more of it; neither does anyone else.", explanation: "Lemert's primary deviance: a norm was violated and mildly sanctioned, but no deviant label was applied or internalized — the act passes without reshaping anyone's identity or status.", options: [
            { id: "speeding-conf", label: "Conforming — no norm was really broken.", correct: false },
            { id: "speeding-primary", label: "Primary deviance — norm violation, minor informal sanction, no label.", correct: true },
            { id: "speeding-secondary", label: "Secondary deviance — a formal label was internalized.", correct: false }
          ] },
        { id: "shoplifting", actText: "A teenager caught shoplifting is arrested, formally charged, and comes to be treated — and to see himself — as a 'delinquent'; he re-offends.", explanation: "Secondary deviance (Lemert): once the formal label is applied by the justice system and internalized, the deviant identity organizes further behavior — deviance amplified by the societal reaction itself, the core claim of labeling theory.", options: [
            { id: "shoplifting-primary", label: "Primary deviance — the label never stuck.", correct: false },
            { id: "shoplifting-conf", label: "Conforming — he was only adjusting to expectations.", correct: false },
            { id: "shoplifting-secondary", label: "Secondary deviance — the formal label was applied and internalized, organizing further deviance.", correct: true }
          ] },
        { id: "pen", actText: "An office worker takes a pen home from the supply closet; everyone does it, nobody comments, and it is never punished.", explanation: "Primary deviance: a minor norm violation that draws no sanction and no label. Most people commit such acts occasionally without any consequence for their identity — deviance is common; being labeled deviant is rare.", options: [
            { id: "pen-primary", label: "Primary deviance — a minor violation with no sanction and no label.", correct: true },
            { id: "pen-secondary", label: "Secondary deviance — the label reshapes her identity.", correct: false },
            { id: "pen-conf", label: "Conforming — taking office supplies is fully normative.", correct: false }
          ] },
        { id: "nurse", actText: "A nurse refuses an unsafe order from a supervisor because hospital policy and professional ethics forbid it, and is formally commended.", explanation: "Conforming: the act follows the governing norms (policy and professional ethics) rather than violating them. That the supervisor disliked it does not make it deviant — deviance is defined against the group's norms, not a superior's preference.", options: [
            { id: "nurse-primary", label: "Primary deviance — refusing a superior is always a violation.", correct: false },
            { id: "nurse-conf", label: "Conforming — the act follows the governing norms and is rewarded.", correct: true },
            { id: "nurse-secondary", label: "Secondary deviance — the commendation is a label.", correct: false }
          ] }
      ]
        @label "Scenarios"
        @description "Roster of acts to classify. Each item carries the act text, three labelled options (conforming / primary deviance / secondary deviance, exactly one correct) rendered as buttons in this exact order, and the explanation shown once the correct classification is made."
        @synonyms "deviance, labeling theory, Lemert, primary deviance, secondary deviance, formal sanction, informal sanction, social control"
        @tier "domain"
    }
  }

  page "/soc-deviance" as SocDevPage -> SocDevSim
}
