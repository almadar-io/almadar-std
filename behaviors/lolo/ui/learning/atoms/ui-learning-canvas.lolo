app ui-learning-canvas "1.0.0"
"LearningCanvas — UI factory (1:1 with the @almadar/ui learning-canvas pattern)."
;; @pattern "learning-canvas"
orbital LearningCanvasOrbital {
  type LearningCanvasShapesItem = {
    tone : "ink" | "label" | "guide" | "axis" | "grid" | "highlight" | "fill" | "series-1" | "series-2" | "series-3" | "series-4" | "series-5" | "series-6" | "series-7" | "series-8" | "primary" | "accent" | "success" | "warning" | "error" | "info" | "muted"
    fillTone : "ink" | "label" | "guide" | "axis" | "grid" | "highlight" | "fill" | "series-1" | "series-2" | "series-3" | "series-4" | "series-5" | "series-6" | "series-7" | "series-8" | "primary" | "accent" | "success" | "warning" | "error" | "info" | "muted"
    stroke : "thin" | "normal" | "bold"
    textSize : "xs" | "sm" | "base" | "lg" | "xl" | "2xl"
    font : "body" | "display" | "mono"
    textCase : "theme" | "verbatim"
    fillStyle : "solid" | "tint" | "outline" | "hatch"
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LearningCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    fontFamily : string
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "solid" | "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type LearningCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type LearningCanvasProjector = {
    tileWidth : number!
    floorHeight : number!
    diamondTopY : number!
    squareGrid : boolean!
    worldPixelDirect : boolean!
  }
  type LearningCanvasReadoutsItem = {
    label : string!
    value : string!
    color : string
  }
  type LearningCanvasTracesItem = {
    x : number
    y : number
    width : number
    height : number
    series : [LearningCanvasTracesItemSeriesItem]!
    xLabel : string
    yLabel : string
    frameColor : string
    backgroundColor : string
    backgroundOpacity : number
  }
  type LearningCanvasTracesItemSeriesItem = {
    samples : [LearningCanvasTracesItemSeriesItemSamplesItem]!
    color : string
    label : string
  }
  type LearningCanvasTracesItemSeriesItemSamplesItem = {
    x : number!
    y : number!
  }
  type LearningCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type LearningCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }
  type LearningCanvasSHAPEHOVERPayload = {
    id : string
    type : string
    index : number!
  }

  entity LearningCanvasItem [runtime] {
    id : string!
  }

  trait LearningCanvasRender -> @rebindable LearningCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          backgroundColor: @config.backgroundColor
          series: @config.series
          fontFamily: @config.fontFamily
          shapes: @config.shapes
          drawables: @config.drawables
          projector: @config.projector
          readouts: @config.readouts
          traces: @config.traces
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          onShapeHover: @config.onShapeHover
          description: @config.description
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: learning-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          backgroundColor: @config.backgroundColor
          series: @payload.series
          fontFamily: @config.fontFamily
          shapes: @payload.shapes
          drawables: @payload.drawables
          projector: @config.projector
          readouts: @payload.readouts
          traces: @payload.traces
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          onShapeHover: @config.onShapeHover
          description: @config.description
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: learning-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : LearningCanvasSHAPECLICKPayload
      }
        @description "Clicked shape payload: { id?, type?, index }."
        @tier "essential"
      @config.onShapeHover -> external {
        payload : LearningCanvasSHAPEHOVERPayload
      }
        @description "Hovered shape payload: { id?, type?, index }."
        @tier "essential"
    }

    listens {
      UPDATE {
        series : [string]
        shapes : [LearningCanvasShapesItem]
        drawables : [node]
        readouts : [LearningCanvasReadoutsItem]
        traces : [LearningCanvasTracesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in CSS pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in CSS pixels."
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "Canvas ground: a tone name, `var()` token or literal (default the theme's `--surface-diagram`)."
        @tier "presentation"
      series : [string] = []
        @label "Series"
        @description "Overrides the theme's categorical palette for this canvas: `series-1…N` resolve to these colors instead. For real-world conventions (CPK atom colors, resistor bands); unset, the theme's `--color-series-*` apply."
        @tier "presentation"
      fontFamily : string
        @label "Font Family"
        @description "Canvas text font family. Falls back to the theme's --font-family-body."
        @tier "presentation"
      shapes : [LearningCanvasShapesItem] = []
        @label "Shapes"
        @description "Declarative shapes to draw."
        @tier "presentation"
      drawables : [node] = []
        @label "Drawables"
        @description "Neutral game-canvas drawables (e.g. `draw-sprite`, `draw-fx-layer`) painted in world coordinates via the supplied `projector`. This lets the learning canvas reuse the game drawable vocabulary without reimplementing sprites/FX."
        @tier "presentation"
      projector : LearningCanvasProjector
        @label "Projector"
        @description "World-to-pixel projector for `drawables`. When absent, `drawables` are ignored."
        @tier "presentation"
      readouts : [LearningCanvasReadoutsItem] = []
        @label "Readouts"
        @description "Top-right status chip row (live measurements, scores, counters)."
        @synonyms "chips, stats, measurements"
        @tier "presentation"
      traces : [LearningCanvasTracesItem] = []
        @label "Traces"
        @description "Inset sparkline panels stacked from the bottom-right corner."
        @synonyms "sparkline, time series, history plot"
        @tier "presentation"
      keyMap : Map string string = { item: "INIT" }
        @label "Key Map"
        @description "Maps a keydown `e.code` — optionally prefixed `Mod+` (⌘/Ctrl), `Shift+`, `Alt+` — to a SEMANTIC event emitted as `UI:{event}` (e.g. `{ Space: TOGGLE_RUN, ArrowRight: STEP, KeyR: RESET }`); keystrokes inside inputs never route."
        @tier "presentation"
      keyUpMap : Map string string = { item: "INIT" }
        @label "Key Up Map"
        @description "Maps a keyup `e.code` to a semantic event emitted as `UI:{event}`."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction (click/hover)."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "Clicked shape payload: { id?, type?, index }."
        @tier "presentation"
      onShapeHover : event = "SHAPE_HOVER"
        @label "On Shape Hover"
        @description "Hovered shape payload: { id?, type?, index }."
        @tier "presentation"
      description : string
        @label "Description"
        @description "Text alternative for the canvas, rendered as visually hidden text and linked by aria-describedby."
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state."
        @tier "presentation"
      error : LearningCanvasError
        @label "Error"
        @description "Error state."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/learning-canvas" as LearningCanvasPage -> LearningCanvasRender
}
