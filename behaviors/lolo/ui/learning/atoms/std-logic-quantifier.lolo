app std-logic-quantifier "1.0.0"
"Predicate-logic model evaluator — a finite domain of objects with visible properties; the learner marks which ∀/∃ statements they believe true, evaluates them against the model, and can toggle object properties to flip a statement's truth. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LogicQuantifierOrbital {
  type LogicQuantPredicate = {
    key : string!
    label : string!
    color : string!
  }
  type LogicQuantObject = {
    id : string!
    label : string
    x : number!
    y : number!
    predicates : [string]
  }
  type LogicQuantStatement = {
    id : string!
    label : string!
    kind : "FORALL" | "EXISTS" | "FORALL_EXISTS"!
    px : string!
    py : string
  }

  entity LogicQuantifierState [runtime] {
    id : string!
    active : boolean = false
    title : string
    objects : [json]
    picks : [string]
    truthMap : [json]
    feedback : string
    shapes : [json]
  }

  trait LogicQuantifierSim -> @rebindable LogicQuantifierState [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.objects @config.domain)
        (set @entity.picks [])
        (set @entity.truthMap [])
        (set @entity.feedback "")
        (let (
            (objShapes (array/flatten (array/map @entity.objects (fn o
              (let (
                  (preds (object/get @o predicates))
                  (baseShapes [
                    { type: circle, id: (object/get @o id), x: (object/get @o x), y: (object/get @o y), radius: 28, color: "#64748b", fill: "transparent", lineWidth: 2, opacity: 1 },
                    { type: text, id: (str/concat "olabel-" (object/get @o id)), x: (object/get @o x), y: (+ (object/get @o y) 52), text: (object/get @o label), fontSize: 12, align: "center", color: "#334155" }
                  ])
                  (ringShapes (array/map (array/range (array/len @preds)) (fn i (let (
                        (pkey (array/nth @preds @i))
                        (pdef (array/find @config.predicates (fn p (== (object/get @p key) @pkey))))
                      )
                      { type: circle, id: (str/concat "ring-" (object/get @o id) "-" @pkey), x: (object/get @o x), y: (object/get @o y), radius: (+ 36 (* @i 9)), color: (object/get @pdef color), fill: "transparent", lineWidth: 3, opacity: 0.9 }))))
                )
                (array/concat @baseShapes @ringShapes))))))
          )
          (do
            (set @entity.shapes @objShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Mark the statements you believe true, then evaluate. Toggle an object's properties to change the model." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.predicates (fn p { type: stack, direction: horizontal, gap: xs, children: (array/map @entity.objects (fn o { type: button, action: TOGGLE_OBJECT, actionPayload: { object: (object/get @o id), predicate: (object/get @p key) }, label: (str/concat (object/get @p label) "·" (object/get @o label)), variant: (if (array/includes (object/get @o predicates) (object/get @p key)) "primary" "ghost"), size: sm })) })) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @config.statements (fn s { type: stack, direction: horizontal, gap: sm, children: [
                    { type: typography, variant: body, content: (object/get @s label) },
                    { type: button, action: PICK_TRUE_STATEMENTS, actionPayload: { statement: (object/get @s id) }, label: (if (array/includes @entity.picks (object/get @s id)) "True ✓" "Mark True"), variant: (if (array/includes @entity.picks (object/get @s id)) "primary" "ghost"), size: sm },
                    { type: button, action: EVALUATE_STATEMENT, actionPayload: { statement: (object/get @s id) }, label: "Evaluate", variant: secondary, size: sm },
                    { type: typography, variant: caption, content: (if @config.showTruthValues (if (!= (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) null) (if (object/get (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) truth) "T" "F") "?") "") }
                  ] })) },
                { type: typography, variant: caption, content: @entity.feedback }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.objects @config.domain)
        (set @entity.picks [])
        (set @entity.truthMap [])
        (set @entity.feedback "")
        (let (
            (objShapes (array/flatten (array/map @entity.objects (fn o
              (let (
                  (preds (object/get @o predicates))
                  (baseShapes [
                    { type: circle, id: (object/get @o id), x: (object/get @o x), y: (object/get @o y), radius: 28, color: "#64748b", fill: "transparent", lineWidth: 2, opacity: 1 },
                    { type: text, id: (str/concat "olabel-" (object/get @o id)), x: (object/get @o x), y: (+ (object/get @o y) 52), text: (object/get @o label), fontSize: 12, align: "center", color: "#334155" }
                  ])
                  (ringShapes (array/map (array/range (array/len @preds)) (fn i (let (
                        (pkey (array/nth @preds @i))
                        (pdef (array/find @config.predicates (fn p (== (object/get @p key) @pkey))))
                      )
                      { type: circle, id: (str/concat "ring-" (object/get @o id) "-" @pkey), x: (object/get @o x), y: (object/get @o y), radius: (+ 36 (* @i 9)), color: (object/get @pdef color), fill: "transparent", lineWidth: 3, opacity: 0.9 }))))
                )
                (array/concat @baseShapes @ringShapes))))))
          )
          (do
            (set @entity.shapes @objShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Mark the statements you believe true, then evaluate. Toggle an object's properties to change the model." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.predicates (fn p { type: stack, direction: horizontal, gap: xs, children: (array/map @entity.objects (fn o { type: button, action: TOGGLE_OBJECT, actionPayload: { object: (object/get @o id), predicate: (object/get @p key) }, label: (str/concat (object/get @p label) "·" (object/get @o label)), variant: (if (array/includes (object/get @o predicates) (object/get @p key)) "primary" "ghost"), size: sm })) })) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @config.statements (fn s { type: stack, direction: horizontal, gap: sm, children: [
                    { type: typography, variant: body, content: (object/get @s label) },
                    { type: button, action: PICK_TRUE_STATEMENTS, actionPayload: { statement: (object/get @s id) }, label: (if (array/includes @entity.picks (object/get @s id)) "True ✓" "Mark True"), variant: (if (array/includes @entity.picks (object/get @s id)) "primary" "ghost"), size: sm },
                    { type: button, action: EVALUATE_STATEMENT, actionPayload: { statement: (object/get @s id) }, label: "Evaluate", variant: secondary, size: sm },
                    { type: typography, variant: caption, content: (if @config.showTruthValues (if (!= (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) null) (if (object/get (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) truth) "T" "F") "?") "") }
                  ] })) },
                { type: typography, variant: caption, content: @entity.feedback }
              ] }
          ]
        })

      TOGGLE_OBJECT -> idle when (and (== @entity.active true) (== @config.allowEdit true))
        (set @entity.objects (array/map @entity.objects (fn o (if (== (object/get @o id) ?object)
          (object/merge @o { predicates: (if (array/includes (object/get @o predicates) ?predicate) (array/filter (object/get @o predicates) (fn p (!= @p ?predicate))) (array/append (object/get @o predicates) ?predicate)) })
          @o))))
        (set @entity.truthMap [])
        (set @entity.feedback "Model changed — re-evaluate the statements.")
        (let (
            (objShapes (array/flatten (array/map @entity.objects (fn o
              (let (
                  (preds (object/get @o predicates))
                  (baseShapes [
                    { type: circle, id: (object/get @o id), x: (object/get @o x), y: (object/get @o y), radius: 28, color: "#64748b", fill: "transparent", lineWidth: 2, opacity: 1 },
                    { type: text, id: (str/concat "olabel-" (object/get @o id)), x: (object/get @o x), y: (+ (object/get @o y) 52), text: (object/get @o label), fontSize: 12, align: "center", color: "#334155" }
                  ])
                  (ringShapes (array/map (array/range (array/len @preds)) (fn i (let (
                        (pkey (array/nth @preds @i))
                        (pdef (array/find @config.predicates (fn p (== (object/get @p key) @pkey))))
                      )
                      { type: circle, id: (str/concat "ring-" (object/get @o id) "-" @pkey), x: (object/get @o x), y: (object/get @o y), radius: (+ 36 (* @i 9)), color: (object/get @pdef color), fill: "transparent", lineWidth: 3, opacity: 0.9 }))))
                )
                (array/concat @baseShapes @ringShapes))))))
          )
          (do
            (set @entity.shapes @objShapes)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Mark the statements you believe true, then evaluate. Toggle an object's properties to change the model." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.predicates (fn p { type: stack, direction: horizontal, gap: xs, children: (array/map @entity.objects (fn o { type: button, action: TOGGLE_OBJECT, actionPayload: { object: (object/get @o id), predicate: (object/get @p key) }, label: (str/concat (object/get @p label) "·" (object/get @o label)), variant: (if (array/includes (object/get @o predicates) (object/get @p key)) "primary" "ghost"), size: sm })) })) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @config.statements (fn s { type: stack, direction: horizontal, gap: sm, children: [
                    { type: typography, variant: body, content: (object/get @s label) },
                    { type: button, action: PICK_TRUE_STATEMENTS, actionPayload: { statement: (object/get @s id) }, label: (if (array/includes @entity.picks (object/get @s id)) "True ✓" "Mark True"), variant: (if (array/includes @entity.picks (object/get @s id)) "primary" "ghost"), size: sm },
                    { type: button, action: EVALUATE_STATEMENT, actionPayload: { statement: (object/get @s id) }, label: "Evaluate", variant: secondary, size: sm },
                    { type: typography, variant: caption, content: (if @config.showTruthValues (if (!= (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) null) (if (object/get (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) truth) "T" "F") "?") "") }
                  ] })) },
                { type: typography, variant: caption, content: @entity.feedback }
              ] }
          ]
        })
        (emit QUANTIFIER_UPDATED { picks: @entity.picks, feedback: @entity.feedback })

      PICK_TRUE_STATEMENTS -> idle when (== @entity.active true)
        (set @entity.picks (if (array/includes @entity.picks ?statement) (array/filter @entity.picks (fn s (!= @s ?statement))) (array/append @entity.picks ?statement)))
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Mark the statements you believe true, then evaluate. Toggle an object's properties to change the model." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.predicates (fn p { type: stack, direction: horizontal, gap: xs, children: (array/map @entity.objects (fn o { type: button, action: TOGGLE_OBJECT, actionPayload: { object: (object/get @o id), predicate: (object/get @p key) }, label: (str/concat (object/get @p label) "·" (object/get @o label)), variant: (if (array/includes (object/get @o predicates) (object/get @p key)) "primary" "ghost"), size: sm })) })) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @config.statements (fn s { type: stack, direction: horizontal, gap: sm, children: [
                    { type: typography, variant: body, content: (object/get @s label) },
                    { type: button, action: PICK_TRUE_STATEMENTS, actionPayload: { statement: (object/get @s id) }, label: (if (array/includes @entity.picks (object/get @s id)) "True ✓" "Mark True"), variant: (if (array/includes @entity.picks (object/get @s id)) "primary" "ghost"), size: sm },
                    { type: button, action: EVALUATE_STATEMENT, actionPayload: { statement: (object/get @s id) }, label: "Evaluate", variant: secondary, size: sm },
                    { type: typography, variant: caption, content: (if @config.showTruthValues (if (!= (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) null) (if (object/get (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) truth) "T" "F") "?") "") }
                  ] })) },
                { type: typography, variant: caption, content: @entity.feedback }
              ] }
          ]
        })
        (emit QUANTIFIER_UPDATED { picks: @entity.picks, feedback: @entity.feedback })

      EVALUATE_STATEMENT -> idle when (== @entity.active true)
        (let (
            (st (array/find @config.statements (fn s (== (object/get @s id) ?statement))))
            (px (object/get @st px))
            (py (object/get @st py))
            (hasPx (array/filter @entity.objects (fn o (array/includes (object/get @o predicates) @px))))
            (hasPy (array/filter @entity.objects (fn o (array/includes (object/get @o predicates) @py))))
            (missingPx (array/filter @entity.objects (fn o (not (array/includes (object/get @o predicates) @px)))))
            (truth (if (== (object/get @st kind) "FORALL") (== (array/len @missingPx) 0)
              (if (== (object/get @st kind) "EXISTS") (> (array/len @hasPx) 0)
              (or (== (array/len @hasPx) 0) (> (array/len @hasPy) 0)))))
            (picked (array/includes @entity.picks ?statement))
          )
          (do
            (set @entity.truthMap (array/concat (array/filter @entity.truthMap (fn t (!= (object/get @t id) ?statement))) [{ id: ?statement, truth: @truth }]))
            (set @entity.feedback (if (== @picked @truth)
              (str/concat "Correct — " (object/get @st label) " is " (if @truth "true" "false") " in this model.")
              (str/concat (object/get @st label) " is actually " (if @truth "true" "false") " — check the model again.")))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: "Mark the statements you believe true, then evaluate. Toggle an object's properties to change the model." },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: xs, children: (array/map @config.predicates (fn p { type: stack, direction: horizontal, gap: xs, children: (array/map @entity.objects (fn o { type: button, action: TOGGLE_OBJECT, actionPayload: { object: (object/get @o id), predicate: (object/get @p key) }, label: (str/concat (object/get @p label) "·" (object/get @o label)), variant: (if (array/includes (object/get @o predicates) (object/get @p key)) "primary" "ghost"), size: sm })) })) },
                { type: stack, direction: vertical, gap: xs, children: (array/map @config.statements (fn s { type: stack, direction: horizontal, gap: sm, children: [
                    { type: typography, variant: body, content: (object/get @s label) },
                    { type: button, action: PICK_TRUE_STATEMENTS, actionPayload: { statement: (object/get @s id) }, label: (if (array/includes @entity.picks (object/get @s id)) "True ✓" "Mark True"), variant: (if (array/includes @entity.picks (object/get @s id)) "primary" "ghost"), size: sm },
                    { type: button, action: EVALUATE_STATEMENT, actionPayload: { statement: (object/get @s id) }, label: "Evaluate", variant: secondary, size: sm },
                    { type: typography, variant: caption, content: (if @config.showTruthValues (if (!= (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) null) (if (object/get (array/find @entity.truthMap (fn t (== (object/get @t id) (object/get @s id)))) truth) "T" "F") "?") "") }
                  ] })) },
                { type: typography, variant: caption, content: @entity.feedback }
              ] }
          ]
        })
        (emit QUANTIFIER_UPDATED { picks: @entity.picks, feedback: @entity.feedback })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      TOGGLE_OBJECT {
        object : string
        predicate : string
      }
        @description "Learner flipped one property of one domain object, changing the model and invalidating prior truth values."
        @tier "domain"
      PICK_TRUE_STATEMENTS {
        statement : string
      }
        @description "Learner marked or unmarked a quantified statement as one they believe is true in the model."
        @tier "domain"
      EVALUATE_STATEMENT {
        statement : string
      }
        @description "Learner evaluated one quantified statement against the visible model and got a verdict against their pick."
        @tier "domain"
    }

    emits {
      QUANTIFIER_UPDATED -> external {
        picks : [string]
        feedback : string
      }
        @description "The model/pick state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "quantifier evaluation, model check, for all, there exists, predicate logic, truth in a model"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      domain : [LogicQuantObject] = [
        { id: "a", label: "a", x: 140, y: 150, predicates: ["G", "S"] },
        { id: "b", label: "b", x: 300, y: 150, predicates: ["G"] },
        { id: "c", label: "c", x: 460, y: 150, predicates: [] }
      ]
        @label "Domain"
        @description "The finite domain of objects (position, label, and the predicate keys each object has); toggling a predicate on an object changes the model."
        @synonyms "domain of discourse, model, object, individual, universe of discourse"
        @tier "domain"
      predicates : [LogicQuantPredicate] = [
        { key: "G", label: "G", color: "#15803d" },
        { key: "S", label: "S", color: "#7c3aed" }
      ]
        @label "Predicates"
        @description "The property vocabulary (key, label, ring color); each predicate an object has is drawn as a colored ring around it."
        @synonyms "predicate, property, unary relation, monadic predicate"
        @tier "domain"
      statements : [LogicQuantStatement] = [
        { id: "s1", label: "∀x G(x)", kind: FORALL, px: "G" },
        { id: "s2", label: "∃x S(x)", kind: EXISTS, px: "S" },
        { id: "s3", label: "∀x(G(x) → ∃y S(y))", kind: FORALL_EXISTS, px: "G", py: "S" }
      ]
        @label "Statements"
        @description "Quantified statements evaluated against the model: FORALL px (every object has px), EXISTS px (some object has px), FORALL_EXISTS px py (if any object has px then some object has py)."
        @synonyms "universal quantifier, existential quantifier, for all, there exists, quantified statement, predicate logic"
        @tier "domain"
      allowEdit : boolean = true
        @label "Allow Model Edit"
        @description "When true the learner can toggle object predicates to change the model; when false the toggle buttons render but edits are ignored."
        @synonyms "editable model, change the model, flip truth value"
        @tier "domain"
      showTruthValues : boolean = true
        @label "Show Truth Values"
        @description "After a statement is evaluated, show its computed T/F beside it."
        @tier "domain"
      title : string = "Quantifier Model"
        @label "Title"
        @description "Title shown above the instrument."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 260
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = "#f8fafc"
        @label "Background Color"
        @description "Canvas background color."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
    }
  }

  page "/logic-quantifier" as LogicQuantifierPage -> LogicQuantifierSim
}
