                (baseOpacity (if @isRevealed 0.9 0.35))
                (finalOpacity (if @matchesFilter @baseOpacity (* @baseOpacity 0.25)))
                (xPos (+ @config.axisMarginLeft (* (/ (- @s.position @config.minPosition) (- @config.maxPosition @config.minPosition)) @axisWidth)))
                (rad (if @isCurrent @config.markerHighlightRadius @config.markerRadius))
              )
              (if @isCurrent
                [
                  { type: circle, id: (str/concat "ring-" @s.position), x: @xPos, y: @config.axisY, radius: (+ @rad 5), tone: @catColor, fillStyle: "outline", stroke: "bold", opacity: 1 },
                  { type: circle, id: (str/concat "marker-" @s.position), x: @xPos, y: @config.axisY, radius: @rad, tone: @col, fillTone: @col, fillStyle: "solid", opacity: @finalOpacity }
                ]
                [
                  { type: circle, id: (str/concat "marker-" @s.position), x: @xPos, y: @config.axisY, radius: @rad, tone: @col, fillTone: @col, fillStyle: "solid", opacity: @finalOpacity }
                ]
              )
            )))))
            (legendShapes (array/flatten (array/map @entity.categories [
                { type: circle, id: (str/concat "legend-dot-" @index), x: (+ @config.axisMarginLeft (* @index (/ @axisWidth (array/len @entity.categories)))), y: 22, radius: 5, tone: (object/get @item color), fillTone: (object/get @item color), fillStyle: "solid", opacity: 1 },
                { type: text, id: (str/concat "legend-label-" @index), x: (+ (+ @config.axisMarginLeft (* @index (/ @axisWidth (array/len @entity.categories)))) 12), y: 26, text: (object/get @item label), textSize: "xs", align: "left", tone: "label" }
              ])))
            (allShapes (array/concat @baseShapes @markerShapes @legendShapes))
            (filterButtons (array/concat [
                { type: button, action: FILTER_CATEGORY, actionPayload: { category: "all" }, label: @config.allLabel, variant: (if (== @entity.activeFilter "all") "secondary" "ghost"), size: sm, aria-pressed: (if (== @entity.activeFilter "all") "true" "false") }
              ] (array/map @entity.categories (fn cc { type: button, action: FILTER_CATEGORY, actionPayload: { category: (object/get @cc category) }, label: (object/get @cc label), variant: (if (== @entity.activeFilter (object/get @cc category)) "secondary" "ghost"), size: sm, aria-pressed: (if (== @entity.activeFilter (object/get @cc category)) "true" "false") }))))
          )
          (do
            (set @entity.narration @narration)
            (set @entity.currentStageLabel @stageLabel)
            (set @entity.currentStageDescription @boundedDescription)
            (set @entity.categoryTally @categoryTally)
            (set @entity.tallyItems @tallyItems)
            (set @entity.visibleThreadNote @visibleThreadNote)
            (set @entity.shapes @allShapes)
            (set @entity.filterButtons @filterButtons)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: stack, direction: horizontal, justify: between, align: start, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: h4, content: @entity.title },
                        (if (== @config.summary "") null { type: typography, variant: body2, color: muted, content: @config.summary })
                      ] },
                    { type: badge, label: (if (<= @entity.cursorIndex -1) "Not started" (if (>= @entity.cursorIndex (- (array/len @entity.stages) 1)) "Complete" (str/concat "Stage " (+ @entity.cursorIndex 1) " of " (array/len @entity.stages)))), variant: (if (<= @entity.cursorIndex -1) "neutral" (if (>= @entity.cursorIndex (- (array/len @entity.stages) 1)) "success" "primary")) }
                  ] },
                { type: stack, direction: horizontal, align: center, gap: sm, wrap: true, children: [
                    { type: button, action: NEXT, label: "Next", icon: "chevron-right", variant: primary, disabled: (>= @entity.cursorIndex (- (array/len @entity.stages) 1)) },
                    { type: button, action: PREV, label: "Prev", icon: "chevron-left", variant: secondary, disabled: (<= @entity.cursorIndex -1) },
                    { type: button, action: RESET_STEPPER, label: "Reset", icon: "rotate-ccw", variant: ghost },
                    { type: typography, variant: caption, color: muted, content: (str/concat "Stage " (+ @entity.cursorIndex 1) " of " (array/len @entity.stages)) }
                  ] },
                { type: progress-bar, value: (+ @entity.cursorIndex 1), max: (array/len @entity.stages), showPercentage: false },
                { type: stack, direction: horizontal, align: center, gap: xs, wrap: true, role: "group", aria-label: "Category lens", children: @entity.filterButtons },
                { type: math-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate, keyMap: { ArrowRight: NEXT, ArrowLeft: PREV, KeyR: RESET_STEPPER } },
                { type: card, variant: bordered, padding: md, title: (if (!= @entity.currentStageLabel "") @entity.currentStageLabel "Not Started"), children: [
                    { type: typography, variant: body, content: @entity.currentStageDescription }
                  ] },
                { type: stack, direction: horizontal, gap: xs, wrap: true, children: (array/map @entity.tallyItems (fn t { type: badge, variant: neutral, label: (str/concat (object/get @t label) ": " (str/concat "" (object/get @t count))) })) },
                { type: typography, variant: caption, color: muted, content: @entity.visibleThreadNote }
              ] }
          ]
        })
        (emit STEPPER_ADVANCED { cursorIndex: @entity.cursorIndex, activeFilter: @entity.activeFilter, currentLabel: @entity.narration })

      RESET_STEPPER -> idle when (== @entity.active true)
        (set @entity.cursorIndex -1)
        (set @entity.activeFilter "all")
        (let (
            (currentPosition (if (>= @entity.cursorIndex 0) (object/get (array/nth @entity.stages @entity.cursorIndex) position) (- @config.minPosition 1)))
            (currentStage (if (>= @entity.cursorIndex 0) (array/nth @entity.stages @entity.cursorIndex) null))
            (totalStages (array/len @entity.stages))
            (atEnd (and (>= @entity.cursorIndex 0) (>= @entity.cursorIndex (- @totalStages 1))))
            (stageLabel (if (!= @currentStage null) (object/get @currentStage label) ""))
            (stageDescription (if (!= @currentStage null) (object/get @currentStage description) @config.startPrompt))
            (boundedDescription (if @atEnd (str/concat @stageDescription @config.atEndNote) @stageDescription))
            (narration (if (!= @currentStage null) (str/concat (str/concat "" (object/get @currentStage position)) " — " @stageLabel ". " @boundedDescription) @config.startPrompt))
            (tallyParts (array/map @entity.categories (fn cc (str/concat (object/get @cc label) ": " (array/len (array/filter @entity.stages (fn s (and (<= @s.position @currentPosition) (== @s.category (object/get @cc category))))))))))
            (categoryTally (str/join @tallyParts " · "))
            (tallyItems (array/map @entity.categories (fn cc { label: (object/get @cc label), count: (array/len (array/filter @entity.stages (fn s (and (<= @s.position @currentPosition) (== @s.category (object/get @cc category)))))) })))
            (visibleThreadNote (if (== @entity.activeFilter "all") @config.allSummary (object/get (array/first (array/filter @entity.categorySummaries (fn cs (== @cs.category @entity.activeFilter)))) summary)))
            (axisWidth (- @config.width (+ @config.axisMarginLeft @config.axisMarginRight)))
            (baseShapes [
              { type: line, id: "axis", x1: @config.axisMarginLeft, y1: @config.axisY, x2: (- @config.width @config.axisMarginRight), y2: @config.axisY, tone: "axis", stroke: "normal", opacity: 1 },
              { type: text, id: "minPositionLabel", x: @config.axisMarginLeft, y: (+ @config.axisY 26), text: (str/concat "" @config.minPosition), textSize: "xs", align: "left", tone: "label" },
              { type: text, id: "maxPositionLabel", x: (- @config.width @config.axisMarginRight), y: (+ @config.axisY 26), text: (str/concat "" @config.maxPosition), textSize: "xs", align: "right", tone: "label" }
            ])
            (markerShapes (array/flatten (array/map @entity.stages (fn s (let (
                (isRevealed (<= @s.position @currentPosition))
                (isCurrent (== @s.position @currentPosition))
                (matchesFilter (or (== @entity.activeFilter "all") (== @s.category @entity.activeFilter)))
                (catColorObj (array/first (array/filter @entity.categories (fn cc (== @cc.category @s.category)))))
                (catColor (object/get @catColorObj color))
                (col (if @isRevealed @catColor @config.unreachedColor))
                (baseOpacity (if @isRevealed 0.9 0.35))
                (finalOpacity (if @matchesFilter @baseOpacity (* @baseOpacity 0.25)))
                (xPos (+ @config.axisMarginLeft (* (/ (- @s.position @config.minPosition) (- @config.maxPosition @config.minPosition)) @axisWidth)))
                (rad (if @isCurrent @config.markerHighlightRadius @config.markerRadius))
              )
              (if @isCurrent
                [
                  { type: circle, id: (str/concat "ring-" @s.position), x: @xPos, y: @config.axisY, radius: (+ @rad 5), tone: @catColor, fillStyle: "outline", stroke: "bold", opacity: 1 },
                  { type: circle, id: (str/concat "marker-" @s.position), x: @xPos, y: @config.axisY, radius: @rad, tone: @col, fillTone: @col, fillStyle: "solid", opacity: @finalOpacity }
                ]
                [
                  { type: circle, id: (str/concat "marker-" @s.position), x: @xPos, y: @config.axisY, radius: @rad, tone: @col, fillTone: @col, fillStyle: "solid", opacity: @finalOpacity }
                ]
              )
            )))))
            (legendShapes (array/flatten (array/map @entity.categories [
                { type: circle, id: (str/concat "legend-dot-" @index), x: (+ @config.axisMarginLeft (* @index (/ @axisWidth (array/len @entity.categories)))), y: 22, radius: 5, tone: (object/get @item color), fillTone: (object/get @item color), fillStyle: "solid", opacity: 1 },
                { type: text, id: (str/concat "legend-label-" @index), x: (+ (+ @config.axisMarginLeft (* @index (/ @axisWidth (array/len @entity.categories)))) 12), y: 26, text: (object/get @item label), textSize: "xs", align: "left", tone: "label" }
              ])))
            (allShapes (array/concat @baseShapes @markerShapes @legendShapes))
            (filterButtons (array/concat [
                { type: button, action: FILTER_CATEGORY, actionPayload: { category: "all" }, label: @config.allLabel, variant: (if (== @entity.activeFilter "all") "secondary" "ghost"), size: sm, aria-pressed: (if (== @entity.activeFilter "all") "true" "false") }
              ] (array/map @entity.categories (fn cc { type: button, action: FILTER_CATEGORY, actionPayload: { category: (object/get @cc category) }, label: (object/get @cc label), variant: (if (== @entity.activeFilter (object/get @cc category)) "secondary" "ghost"), size: sm, aria-pressed: (if (== @entity.activeFilter (object/get @cc category)) "true" "false") }))))
          )
          (do
            (set @entity.narration @narration)
            (set @entity.currentStageLabel @stageLabel)
            (set @entity.currentStageDescription @boundedDescription)
            (set @entity.categoryTally @categoryTally)
            (set @entity.tallyItems @tallyItems)
            (set @entity.visibleThreadNote @visibleThreadNote)
            (set @entity.shapes @allShapes)
            (set @entity.filterButtons @filterButtons)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: stack, direction: horizontal, justify: between, align: start, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: h4, content: @entity.title },
                        (if (== @config.summary "") null { type: typography, variant: body2, color: muted, content: @config.summary })
                      ] },
                    { type: badge, label: (if (<= @entity.cursorIndex -1) "Not started" (if (>= @entity.cursorIndex (- (array/len @entity.stages) 1)) "Complete" (str/concat "Stage " (+ @entity.cursorIndex 1) " of " (array/len @entity.stages)))), variant: (if (<= @entity.cursorIndex -1) "neutral" (if (>= @entity.cursorIndex (- (array/len @entity.stages) 1)) "success" "primary")) }
                  ] },
                { type: stack, direction: horizontal, align: center, gap: sm, wrap: true, children: [
                    { type: button, action: NEXT, label: "Next", icon: "chevron-right", variant: primary, disabled: (>= @entity.cursorIndex (- (array/len @entity.stages) 1)) },
                    { type: button, action: PREV, label: "Prev", icon: "chevron-left", variant: secondary, disabled: (<= @entity.cursorIndex -1) },
                    { type: button, action: RESET_STEPPER, label: "Reset", icon: "rotate-ccw", variant: ghost },
                    { type: typography, variant: caption, color: muted, content: (str/concat "Stage " (+ @entity.cursorIndex 1) " of " (array/len @entity.stages)) }
                  ] },
                { type: progress-bar, value: (+ @entity.cursorIndex 1), max: (array/len @entity.stages), showPercentage: false },
                { type: stack, direction: horizontal, align: center, gap: xs, wrap: true, role: "group", aria-label: "Category lens", children: @entity.filterButtons },
                { type: math-canvas, width: @config.width, height: @config.height, backgroundColor: @config.backgroundColor, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: @config.animate, keyMap: { ArrowRight: NEXT, ArrowLeft: PREV, KeyR: RESET_STEPPER } },
                { type: card, variant: bordered, padding: md, title: (if (!= @entity.currentStageLabel "") @entity.currentStageLabel "Not Started"), children: [
                    { type: typography, variant: body, content: @entity.currentStageDescription }
                  ] },
                { type: stack, direction: horizontal, gap: xs, wrap: true, children: (array/map @entity.tallyItems (fn t { type: badge, variant: neutral, label: (str/concat (object/get @t label) ": " (str/concat "" (object/get @t count))) })) },
                { type: typography, variant: caption, color: muted, content: @entity.visibleThreadNote }
              ] }
          ]
        })
        (emit STEPPER_ADVANCED { cursorIndex: @entity.cursorIndex, activeFilter: @entity.activeFilter, currentLabel: @entity.narration })

    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      ROSTER_LOADED {
        mode : string!
        stages : [LearnStepperStage]!
        categories : [LearnStepperCategory]!
        categorySummaries : [LearnStepperCategorySummary]!
      }
        @description "Runtime content feed, honoured only when rosterSource is event — mode names the instrument it is for (the matchMode it carries, blank when standalone) and stages, categories and categorySummaries are the roster; a matching instrument re-initialises from it exactly as INIT does from config, any other instrument hides."
        @tier "domain"
      NEXT {
      }
        @description "Learner advanced the cursor to the next stage in the ordered roster; clamps at the last stage with a narrated end note rather than wrapping."
        @tier "domain"
      PREV {
      }
        @description "Learner moved the cursor back to the previous stage in the ordered roster; clamps before the first stage, reverting to the start prompt."
        @tier "domain"
      FILTER_CATEGORY {
        category : string
      }
        @description "Learner picked a category lens (or all) — non-matching stage markers on the timeline dim rather than disappear, keeping the whole sequence in view."
        @tier "domain"
      RESET_STEPPER {
      }
        @description "Learner reset the cursor to before the first stage and cleared the category filter."
        @tier "domain"
    }

    emits {
      STEPPER_ADVANCED -> external {
        cursorIndex : number
        activeFilter : string
        currentLabel : string
      }
        @description "The cursor/filter state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "stepper update, cursor advance, stage reveal, timeline step"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      rosterSource : "config" | "event" = "config"
        @label "Roster Source"
        @description "Where the stages, categories and category summaries come from: config reads those knobs at INIT; event waits for ROSTER_LOADED and takes them from its payload. The axis range (minPosition/maxPosition) stays config."
        @tier "domain"
      title : string = "Stepper"
        @label "Title"
        @description "The instrument's name, the header's one hero."
        @tier "presentation"
      summary : string = ""
        @label "Concept"
        @description "One line under the title saying what the learner is looking at (keep it under ~65 characters). Empty shows no line."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 420
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      backgroundColor : string = ""
        @label "Background Color"
        @description "Canvas ground override; empty uses the theme's drawing ground."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      stages : [LearnStepperStage] = [
        { id: "stage-1", position: 1, label: "Stage One", category: "a", description: "First stage in the sequence." },
        { id: "stage-2", position: 2, label: "Stage Two", category: "b", description: "Second stage in the sequence." },
        { id: "stage-3", position: 3, label: "Stage Three", category: "a", description: "Third stage in the sequence." }
      ]
        @label "Stages"
        @description "Ordered roster of stages (position, label, category, description) stepped through by NEXT/PREV and filtered by FILTER_CATEGORY. Sorted ascending by position."
        @synonyms "stage roster, sequence, timeline, cycle, phase, event roster, ordered stages"
        @tier "domain"
      categories : [LearnStepperCategory] = [
        { category: "a", color: "series-1", label: "Category A" },
        { category: "b", color: "series-2", label: "Category B" }
      ]
        @label "Categories"
        @description "Marker color and button label per stage category, used for the axis dots, the legend, the FILTER_CATEGORY buttons, and the running per-category tally."
        @synonyms "category color, category legend, stage category, filter lens"
        @tier "domain"
      categorySummaries : [LearnStepperCategorySummary] = [
        { category: "a", summary: "Viewed through Category A alone, only the stages tagged A are highlighted." },
        { category: "b", summary: "Viewed through Category B alone, only the stages tagged B are highlighted." }
      ]
        @label "Category Summaries"
        @description "Narrative summary shown when the learner filters the sequence to a single category — how the sequence reads through that lens alone."
        @synonyms "historiographical lens, primary source lens, single-cause narrative, category narrative, visible thread"
        @tier "domain"
      allSummary : string = "Taken together, every stage contributes to the full sequence. No single category tells the whole story."
        @label "All-Lens Summary"
        @description "Narrative summary shown when no category filter is applied — the full, multi-category picture."
        @synonyms "multi-causal, full picture, no single lens"
        @tier "domain"
      allLabel : string = "All"
        @label "All Filter Label"
        @tier "presentation"
      startPrompt : string = "Press Next to begin."
        @label "Start Prompt"
        @description "Narration shown before the learner has advanced past the first stage."
        @tier "presentation"
      atEndNote : string = " — Last stage; press Reset to review from the start."
        @label "At-End Note"
        @description "Text appended to the current stage's description once the cursor reaches the final stage, narrating that Next is now deliberately clamped rather than doing nothing."
        @tier "presentation"
      minPosition : number = 0
        @label "Min Position"
        @description "Earliest position on the axis (before the first stage)."
        @tier "domain"
      maxPosition : number = 4
        @label "Max Position"
        @description "Latest position on the axis (after the last stage)."
        @tier "domain"
      axisY : number = 220
        @label "Axis Y"
        @description "Canvas y-position of the horizontal axis."
        @tier "presentation"
      axisMarginLeft : number = 60
        @label "Axis Left Margin"
        @tier "presentation"
      axisMarginRight : number = 60
        @label "Axis Right Margin"
        @tier "presentation"
      markerRadius : number = 8
        @label "Marker Radius"
        @tier "presentation"
      markerHighlightRadius : number = 14
        @label "Marker Highlight Radius"
        @description "Radius of the current step's marker, larger than an ordinary stage marker."
        @tier "presentation"
      unreachedColor : string = "muted"
        @label "Unreached Marker Color"
        @description "Color of stage markers the learner has not yet stepped to."
        @tier "presentation"
    }
  }

  page "/learn-stepper" as LearnStepperPage -> LearnStepperSim
}
