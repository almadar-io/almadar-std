app ui-algo-graph-canvas "1.0.0"
"AlgoGraphCanvas — UI factory (1:1 with the @almadar/ui algo-graph-canvas pattern)."
;; @pattern "algo-graph-canvas"
orbital AlgoGraphCanvasOrbital {
  type AlgoGraphCanvasNodesItem = {
    id : string!
    x : number
    y : number
    label : string
    state : "unvisited" | "frontier" | "current" | "visited" | "goal" | "path"
    color : string
    radius : number
    badge : AlgoGraphCanvasNodesItemBadge
  }
  type AlgoGraphCanvasNodesItemBadge = {
    text : string!
    color : string
  }
  type AlgoGraphCanvasEdgesItem = {
    from : string!
    to : string!
    directed : boolean
    weight : number
    label : string
    state : "default" | "tree" | "relaxed" | "candidate" | "path"
    color : string
  }
  type AlgoGraphCanvasShapesItem = {
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [AlgoGraphCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    fontFamily : string
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "solid" | "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type AlgoGraphCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type AlgoGraphCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type AlgoGraphCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }
  type AlgoGraphCanvasNODECLICKPayload = {
    id : string!
    label : string
    index : number!
  }

  entity AlgoGraphCanvasItem [runtime] {
    id : string!
  }

  trait AlgoGraphCanvasRender -> @rebindable AlgoGraphCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          nodes: @config.nodes
          edges: @config.edges
          layout: @config.layout
          root: @config.root
          shapes: @config.shapes
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          onNodeClick: @config.onNodeClick
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: algo-graph-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : AlgoGraphCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
      @config.onNodeClick -> external {
        payload : AlgoGraphCanvasNODECLICKPayload
      }
        @description "Fires when a node circle is clicked, alongside `onShapeClick`."
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "backgroundColor prop"
        @tier "presentation"
      nodes : [AlgoGraphCanvasNodesItem] = []
        @label "Nodes"
        @description "nodes prop"
        @tier "presentation"
      edges : [AlgoGraphCanvasEdgesItem] = []
        @label "Edges"
        @description "edges prop"
        @tier "presentation"
      layout : "manual" | "tree" | "layered" | "circle" = manual
        @label "Layout"
        @description "Deterministic layout to compute node positions; `manual` passes through `x`/`y`."
        @tier "presentation"
      root : string
        @label "Root"
        @description "`tree` layout only: preferred root id. Falls back to the first indegree-0 node."
        @tier "presentation"
      shapes : [AlgoGraphCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "interactive prop"
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "animate prop"
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      onNodeClick : event = "NODE_CLICK"
        @label "On Node Click"
        @description "Fires when a node circle is clicked, alongside `onShapeClick`."
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : AlgoGraphCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/algo-graph-canvas" as AlgoGraphCanvasPage -> AlgoGraphCanvasRender
}
