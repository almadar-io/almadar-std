app ui-algorithm-canvas [
  version: "1.0.0",
  description: "AlgorithmCanvas — UI factory (1:1 with the @almadar/ui algorithm-canvas pattern)."
]
;; @pattern "algorithm-canvas"
orbital AlgorithmCanvasOrbital {
  type AlgorithmCanvasBarsItem = {
    value : number!
    color : string
    label : string
  }
  type AlgorithmCanvasCellsItem = {
    row : number!
    col : number!
    value : number
    color : string
    label : string
    corner : AlgorithmCanvasCellsItemCorner
  }
  type AlgorithmCanvasCellsItemCorner = {
    tl : string
    tr : string
    bl : string
    br : string
  }
  type AlgorithmCanvasPointersItem = {
    index : number!
    label : string
    color : string
  }
  type AlgorithmCanvasRangesItem = {
    from : number!
    to : number!
    color : string
    label : string
    kind : "fill" | "bracket"
  }
  type AlgorithmCanvasSlotsItem = {
    value : string
    state : "empty" | "filled" | "highlight"
    color : string
  }
  type AlgorithmCanvasFramesItem = {
    label : string!
    detail : string
    state : "active" | "returning" | "done"
    color : string
  }
  type AlgorithmCanvasBucketsItem = {
    index : number!
    entries : [AlgorithmCanvasBucketsItemEntriesItem]!
  }
  type AlgorithmCanvasBucketsItemEntriesItem = {
    label : string!
    state : "default" | "highlight" | "probing"
    color : string
  }
  type AlgorithmCanvasAuxBarsItem = {
    value : number!
    color : string
    label : string
  }
  type AlgorithmCanvasRowLabelsItem = {
    index : number!
    text : string!
    color : string
  }
  type AlgorithmCanvasColLabelsItem = {
    index : number!
    text : string!
    color : string
  }
  type AlgorithmCanvasShapesItem = {
    tone : "ink" | "label" | "guide" | "axis" | "grid" | "highlight" | "fill" | "series-1" | "series-2" | "series-3" | "series-4" | "series-5" | "series-6" | "series-7" | "series-8" | "primary" | "accent" | "success" | "warning" | "error" | "info" | "muted"
    fillTone : "ink" | "label" | "guide" | "axis" | "grid" | "highlight" | "fill" | "series-1" | "series-2" | "series-3" | "series-4" | "series-5" | "series-6" | "series-7" | "series-8" | "primary" | "accent" | "success" | "warning" | "error" | "info" | "muted"
    stroke : "thin" | "normal" | "bold"
    textSize : "xs" | "sm" | "base" | "lg" | "xl" | "2xl"
    font : "body" | "display" | "mono"
    textCase : "theme" | "verbatim"
    fillStyle : "solid" | "tint" | "outline" | "hatch"
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [AlgorithmCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    fontFamily : string
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "solid" | "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type AlgorithmCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type AlgorithmCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type AlgorithmCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }

  entity AlgorithmCanvasItem [runtime] {
    id : string!
  }

  trait AlgorithmCanvasRender -> @rebindable AlgorithmCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          series: @config.series
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          bars: @config.bars
          cells: @config.cells
          pointers: @config.pointers
          ranges: @config.ranges
          slots: @config.slots
          slotOrientation: @config.slotOrientation
          frames: @config.frames
          buckets: @config.buckets
          auxBars: @config.auxBars
          rowLabels: @config.rowLabels
          colLabels: @config.colLabels
          shapes: @config.shapes
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: algorithm-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          backgroundColor: @config.backgroundColor
          series: @payload.series
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          bars: @payload.bars
          cells: @payload.cells
          pointers: @payload.pointers
          ranges: @payload.ranges
          slots: @payload.slots
          slotOrientation: @config.slotOrientation
          frames: @payload.frames
          buckets: @payload.buckets
          auxBars: @payload.auxBars
          rowLabels: @payload.rowLabels
          colLabels: @payload.colLabels
          shapes: @payload.shapes
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: algorithm-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : AlgorithmCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
    }

    listens {
      UPDATE {
        series : [string]
        bars : [AlgorithmCanvasBarsItem]
        cells : [AlgorithmCanvasCellsItem]
        pointers : [AlgorithmCanvasPointersItem]
        ranges : [AlgorithmCanvasRangesItem]
        slots : [AlgorithmCanvasSlotsItem]
        frames : [AlgorithmCanvasFramesItem]
        buckets : [AlgorithmCanvasBucketsItem]
        auxBars : [AlgorithmCanvasAuxBarsItem]
        rowLabels : [AlgorithmCanvasRowLabelsItem]
        colLabels : [AlgorithmCanvasColLabelsItem]
        shapes : [AlgorithmCanvasShapesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "backgroundColor prop"
        @tier "presentation"
      series : [string] = []
        @label "Series"
        @description "Overrides the theme's categorical palette (`series-1…N`) for this canvas — real-world conventions like CPK atom colors or resistor bands. Unset, the theme's `--color-series-*` apply."
        @tier "presentation"
      keyMap : Map string string = { item: "INIT" }
        @label "Key Map"
        @description "Maps a keydown `e.code` (optionally `Mod+`/`Shift+`/`Alt+` prefixed) to a SEMANTIC event emitted as `UI:{event}` — e.g. `{ Space: TOGGLE_RUN, ArrowRight: STEP, KeyR: RESET }`; keystrokes inside inputs never route."
        @tier "presentation"
      keyUpMap : Map string string = { item: "INIT" }
        @label "Key Up Map"
        @description "Maps a keyup `e.code` to a semantic event emitted as `UI:{event}`."
        @tier "presentation"
      bars : [AlgorithmCanvasBarsItem] = []
        @label "Bars"
        @description "Sorting/histogram bars; laid out left-to-right, height proportional to value."
        @tier "presentation"
      cells : [AlgorithmCanvasCellsItem] = []
        @label "Cells"
        @description "Grid/array/DP cells; laid out on a row/col lattice sized to the extent."
        @tier "presentation"
      pointers : [AlgorithmCanvasPointersItem] = []
        @label "Pointers"
        @description "Index cursors (i/j/lo/hi/mid); drawn as markers beneath the referenced bar/slot column."
        @tier "presentation"
      ranges : [AlgorithmCanvasRangesItem] = []
        @label "Ranges"
        @description "Highlighted index ranges over the bars panel (translucent fill bands or labeled brackets)."
        @tier "presentation"
      slots : [AlgorithmCanvasSlotsItem] = []
        @label "Slots"
        @description "Discrete value slots (registers/variables); laid out in a row or a vertical stack."
        @tier "presentation"
      slotOrientation : "horizontal" | "vertical" = horizontal
        @label "Slot Orientation"
        @description "Slot stack direction; horizontal lays slots left-to-right, vertical stacks bottom-up."
        @tier "presentation"
      frames : [AlgorithmCanvasFramesItem] = []
        @label "Frames"
        @description "Recursion/call-stack frames; laid out bottom-up like a real call stack."
        @tier "presentation"
      buckets : [AlgorithmCanvasBucketsItem] = []
        @label "Buckets"
        @description "Hash-table buckets; each row is an index chip plus its chained entries."
        @tier "presentation"
      auxBars : [AlgorithmCanvasAuxBarsItem] = []
        @label "Aux Bars"
        @description "Secondary bar strip inside the bars panel (e.g. a running total beside the primary values)."
        @tier "presentation"
      rowLabels : [AlgorithmCanvasRowLabelsItem] = []
        @label "Row Labels"
        @description "Row-header labels drawn to the left of the cells grid."
        @tier "presentation"
      colLabels : [AlgorithmCanvasColLabelsItem] = []
        @label "Col Labels"
        @description "Column-header labels drawn above the cells grid."
        @tier "presentation"
      shapes : [AlgorithmCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "interactive prop"
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "animate prop"
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : AlgorithmCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/algorithm-canvas" as AlgorithmCanvasPage -> AlgorithmCanvasRender
}
