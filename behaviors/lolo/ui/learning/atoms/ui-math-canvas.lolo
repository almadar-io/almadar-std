app ui-math-canvas "1.0.0"
"MathCanvas — UI factory (1:1 with the @almadar/ui math-canvas pattern)."
orbital MathCanvasOrbital {
  type MathCanvasCurvesItem = {
    label : string
    color : string
    samples : [MathCanvasCurvesItemSamplesItem]!
    dash : "dashed" | "dotted"
  }
  type MathCanvasCurvesItemSamplesItem = {
    x : number!
    y : number!
  }
  type MathCanvasPointsItem = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
    style : "closed" | "open"
  }
  type MathCanvasVectorsItem = {
    x : number!
    y : number!
    vx : number!
    vy : number!
    color : string
    label : string
  }
  type MathCanvasRegionsItem = {
    samples : [MathCanvasRegionsItemSamplesItem]!
    samples2 : [MathCanvasRegionsItemSamples2Item]
    baseline : number
    color : string
    opacity : number
    label : string
  }
  type MathCanvasRegionsItemSamplesItem = {
    x : number!
    y : number!
  }
  type MathCanvasRegionsItemSamples2Item = {
    x : number!
    y : number!
  }
  type MathCanvasBarsItem = {
    x : number!
    width : number!
    y0 : number
    y1 : number!
    color : string
    opacity : number
  }
  type MathCanvasGuidesItem = {
    kind : "vline" | "hline"!
    at : number!
    color : string
    dash : "dashed" | "dotted"
    label : string
  }
  type MathCanvasAnglesItem = {
    x : number!
    y : number!
    from : number!
    to : number!
    radius : number
    color : string
    label : string
  }
  type MathCanvasHopsItem = {
    from : number!
    to : number!
    color : string
    label : string
  }
  type MathCanvasShapesItem = {
    type : "line" | "arrow" | "circle" | "ellipse" | "rect" | "polygon" | "path" | "text" | "axis" | "grid" | "venn-region"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [MathCanvasShapesItemPointsItem]
    path : string
    text : string
    label : string
    fontSize : number
    fontFamily : string
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
    startAngle : number
    endAngle : number
    dash : "dashed" | "dotted"
    inside : [string]
    outside : [string]
  }
  type MathCanvasShapesItemPointsItem = {
    x : number!
    y : number!
  }
  type MathCanvasReadoutsItem = {
    label : string!
    value : string!
    color : string
  }
  type MathCanvasTracesItem = {
    x : number
    y : number
    width : number
    height : number
    series : [MathCanvasTracesItemSeriesItem]!
    xLabel : string
    yLabel : string
    frameColor : string
    backgroundColor : string
    backgroundOpacity : number
  }
  type MathCanvasTracesItemSeriesItem = {
    samples : [MathCanvasTracesItemSeriesItemSamplesItem]!
    color : string
    label : string
  }
  type MathCanvasTracesItemSeriesItemSamplesItem = {
    x : number!
    y : number!
  }
  type MathCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type MathCanvasSHAPECLICKPayload = {
    id : string
    type : string
    index : number!
  }

  entity MathCanvasItem [runtime] {
    id : string!
  }

  trait MathCanvasRender -> @rebindable MathCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          xMin: @config.xMin
          xMax: @config.xMax
          yMin: @config.yMin
          yMax: @config.yMax
          showAxes: @config.showAxes
          showGrid: @config.showGrid
          gridStep: @config.gridStep
          backgroundColor: @config.backgroundColor
          gridColor: @config.gridColor
          axisColor: @config.axisColor
          showTickLabels: @config.showTickLabels
          tickLabelFontSize: @config.tickLabelFontSize
          labelFontSize: @config.labelFontSize
          fontFamily: @config.fontFamily
          showCurveLabels: @config.showCurveLabels
          curves: @config.curves
          points: @config.points
          vectors: @config.vectors
          regions: @config.regions
          bars: @config.bars
          guides: @config.guides
          angles: @config.angles
          hops: @config.hops
          shapes: @config.shapes
          drawables: @config.drawables
          readouts: @config.readouts
          traces: @config.traces
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          isLoading: @config.isLoading
          error: @config.error
          type: math-canvas
        })
      UPDATE -> idle
        (render-ui main {
          className: @config.className
          width: @config.width
          height: @config.height
          title: @config.title
          xMin: @config.xMin
          xMax: @config.xMax
          yMin: @config.yMin
          yMax: @config.yMax
          showAxes: @config.showAxes
          showGrid: @config.showGrid
          gridStep: @config.gridStep
          backgroundColor: @config.backgroundColor
          gridColor: @config.gridColor
          axisColor: @config.axisColor
          showTickLabels: @config.showTickLabels
          tickLabelFontSize: @config.tickLabelFontSize
          labelFontSize: @config.labelFontSize
          fontFamily: @config.fontFamily
          showCurveLabels: @config.showCurveLabels
          curves: @payload.curves
          points: @payload.points
          vectors: @payload.vectors
          regions: @payload.regions
          bars: @payload.bars
          guides: @payload.guides
          angles: @payload.angles
          hops: @payload.hops
          shapes: @payload.shapes
          drawables: @payload.drawables
          readouts: @payload.readouts
          traces: @payload.traces
          interactive: @config.interactive
          animate: @config.animate
          onShapeClick: @config.onShapeClick
          keyMap: @config.keyMap
          keyUpMap: @config.keyUpMap
          isLoading: @config.isLoading
          error: @config.error
          type: math-canvas
        })
    }

    emits {
      @config.onShapeClick -> external {
        payload : MathCanvasSHAPECLICKPayload
      }
        @description "onShapeClick prop"
        @tier "essential"
    }

    listens {
      UPDATE {
        curves : [MathCanvasCurvesItem]
        points : [MathCanvasPointsItem]
        vectors : [MathCanvasVectorsItem]
        regions : [MathCanvasRegionsItem]
        bars : [MathCanvasBarsItem]
        guides : [MathCanvasGuidesItem]
        angles : [MathCanvasAnglesItem]
        hops : [MathCanvasHopsItem]
        shapes : [MathCanvasShapesItem]
        drawables : [node]
        readouts : [MathCanvasReadoutsItem]
        traces : [MathCanvasTracesItem]
      }
        @description "Live scene update; payload carries the current drawable state."
        @synonyms "tick, redraw, animate, frame"
        @tier "domain"
    }

    config {
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "height prop"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      xMin : number = -10
        @label "X Min"
        @description "xMin prop"
        @tier "presentation"
      xMax : number = 10
        @label "X Max"
        @description "xMax prop"
        @tier "presentation"
      yMin : number = -10
        @label "Y Min"
        @description "yMin prop"
        @tier "presentation"
      yMax : number = 10
        @label "Y Max"
        @description "yMax prop"
        @tier "presentation"
      showAxes : boolean = true
        @label "Show Axes"
        @description "showAxes prop"
        @tier "presentation"
      showGrid : boolean = true
        @label "Show Grid"
        @description "showGrid prop"
        @tier "presentation"
      gridStep : number = 1
        @label "Grid Step"
        @description "gridStep prop"
        @tier "presentation"
      backgroundColor : string
        @label "Background Color"
        @description "Canvas fill color; `var(--token, fallback)` strings resolve against the active theme. Default transparent."
        @tier "presentation"
      gridColor : string = "var(--color-border, #9ca3af)"
        @label "Grid Color"
        @description "Grid line color; resolves theme tokens (default `var(--color-border, #9ca3af)`)."
        @tier "presentation"
      axisColor : string = "var(--color-muted-foreground, #374151)"
        @label "Axis Color"
        @description "Axis line color; resolves theme tokens (default `var(--color-muted-foreground, #374151)`)."
        @tier "presentation"
      showTickLabels : boolean = false
        @label "Show Tick Labels"
        @description "Draw numeric labels on grid lines (default false)."
        @tier "presentation"
      tickLabelFontSize : number = 10
        @label "Tick Label Font Size"
        @description "Font size in px for axis tick labels (default 10)."
        @tier "presentation"
      labelFontSize : number = 12
        @label "Label Font Size"
        @description "Base font size in px for all other canvas annotations (points, vectors, guides, curves, regions, angles, hops; default 12)."
        @tier "presentation"
      fontFamily : string
        @label "Font Family"
        @description "Canvas text font family. Accepts a known game-font key (e.g. 'future-narrow') or a CSS font-family string."
        @tier "presentation"
      showCurveLabels : boolean = false
        @label "Show Curve Labels"
        @description "Draw each curve's `label` at its last in-range sample (default false)."
        @tier "presentation"
      curves : [MathCanvasCurvesItem] = []
        @label "Curves"
        @description "curves prop"
        @tier "presentation"
      points : [MathCanvasPointsItem] = []
        @label "Points"
        @description "points prop"
        @tier "presentation"
      vectors : [MathCanvasVectorsItem] = []
        @label "Vectors"
        @description "vectors prop"
        @tier "presentation"
      regions : [MathCanvasRegionsItem] = []
        @label "Regions"
        @description "Filled areas under curves or between curve pairs."
        @tier "presentation"
      bars : [MathCanvasBarsItem] = []
        @label "Bars"
        @description "Riemann/histogram bar strips."
        @tier "presentation"
      guides : [MathCanvasGuidesItem] = []
        @label "Guides"
        @description "Fixed reference lines (vline/hline)."
        @tier "presentation"
      angles : [MathCanvasAnglesItem] = []
        @label "Angles"
        @description "Angle-sweep arcs at a vertex."
        @tier "presentation"
      hops : [MathCanvasHopsItem] = []
        @label "Hops"
        @description "Number-line jump arcs."
        @tier "presentation"
      shapes : [MathCanvasShapesItem] = []
        @label "Shapes"
        @description "Extra declarative shapes in canvas pixel coordinates."
        @tier "presentation"
      drawables : [node] = []
        @label "Drawables"
        @description "Game-canvas drawables painted in math world coordinates (e.g. `draw-sprite` for a character sprite on the graph). The canvas maps their `ScenePos` through the same x/y world→pixel transform used for curves/points."
        @tier "presentation"
      readouts : [MathCanvasReadoutsItem] = []
        @label "Readouts"
        @description "Top-right status chips, forwarded verbatim to LearningCanvas."
        @tier "presentation"
      traces : [MathCanvasTracesItem] = []
        @label "Traces"
        @description "Inset sparkline panels, forwarded verbatim to LearningCanvas."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "interactive prop"
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "animate prop"
        @tier "presentation"
      onShapeClick : event = "SHAPE_CLICK"
        @label "On Shape Click"
        @description "onShapeClick prop"
        @tier "presentation"
      keyMap : Map string string = { item: "Item" }
        @label "Key Map"
        @description "Maps a keydown `e.code` → the board's SEMANTIC event (device-agnostic input), emitted as `UI:{event}` — same contract as the game canvas keyMap."
        @tier "presentation"
      keyUpMap : Map string string = { item: "Item" }
        @label "Key Up Map"
        @description "Maps a keyup `e.code` → the board's SEMANTIC event."
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "isLoading prop"
        @tier "presentation"
      error : MathCanvasError
        @label "Error"
        @description "error prop"
        @tier "presentation"
    }
  }

  page "/math-canvas" as MathCanvasPage -> MathCanvasRender
}
