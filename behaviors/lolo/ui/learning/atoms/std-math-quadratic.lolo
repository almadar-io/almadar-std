app std-math-quadratic "1.0.0"
"Parabola explorer — a/b/c sliders reshape y = ax² + bx + c live; the vertex, axis of symmetry, roots and discriminant readouts recompute, and the discriminant's sign drives the root display. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital MathQuadraticOrbital {
  type MathQuadraticSample = {
    x : number!
    y : number!
  }
  type MathQuadraticCurve = {
    label : string
    color : string
    samples : [MathQuadraticSample]
  }
  type MathQuadraticPoint = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }

  entity MathQuadraticState [runtime] {
    id : string!
    active : boolean = false
    title : string
    a : number
    b : number
    c : number
    vertexX : number
    vertexY : number
    discriminant : number
    equationLabel : string
    rootsLabel : string
    curves : [MathQuadraticCurve]
    points : [MathQuadraticPoint]
  }

  trait MathQuadraticSim -> @rebindable MathQuadraticState [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.a @config.initialA)
        (set @entity.b @config.initialB)
        (set @entity.c @config.initialC)
        (let (
            (aSafe (if (< (math/abs @entity.a) 0.05) (if (< @entity.a 0) -0.05 0.05) @entity.a))
            (vx (/ (- 0 @entity.b) (* 2 @aSafe)))
            (vy (+ (* @entity.a (* @vx @vx)) (+ (* @entity.b @vx) @entity.c)))
            (disc (- (* @entity.b @entity.b) (* 4 (* @entity.a @entity.c))))
            (discPos (math/max 0 @disc))
            (r1 (/ (+ (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (r2 (/ (- (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (rootLabel (if (> @disc 0.0001) (str/concat "Two real roots: x = " (math/round @r1 2) " and x = " (math/round @r2 2)) (if (> @disc -0.0001) (str/concat "One repeated root: x = " (math/round @r1 2)) "No real roots — the discriminant is negative")))
            (eqText (if (== @config.form "vertex") (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @vx 2) ")² + " (math/round @vy 2)) (if (== @config.form "factored") (if (> @disc 0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")(x − " (math/round @r2 2) ")") (if (> @disc -0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")²") "Not factorable over the real numbers — the discriminant is negative")) (str/concat "y = " (math/round @entity.a 2) "x² + " (math/round @entity.b 2) "x + " (math/round @entity.c 2)))))
            (parabola { label: "parabola", color: @config.curveColor, samples: (array/map @config.sampleXs (fn x { x: @x, y: (+ (* @entity.a (* @x @x)) (+ (* @entity.b @x) @entity.c)) })) })
            (axisLine { label: "axis of symmetry", color: @config.axisColor, samples: [ { x: @vx, y: @config.yMin }, { x: @vx, y: @config.yMax } ] })
            (rootPts (if (> @disc 0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 }, { x: @r2, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] (if (> @disc -0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] [])))
            (focusPts (if @config.showFocus [ { x: @vx, y: (+ @vy (/ 1 (* 4 @aSafe))), label: "focus", color: @config.focusColor, radius: 5 } ] []))
          )
          (do
            (set @entity.vertexX @vx)
            (set @entity.vertexY @vy)
            (set @entity.discriminant @disc)
            (set @entity.equationLabel @eqText)
            (set @entity.rootsLabel @rootLabel)
            (set @entity.curves [ @parabola, @axisLine ])
            (set @entity.points (array/concat [ { x: @vx, y: @vy, label: "vertex", color: @config.vertexColor, radius: 6 } ] (array/concat @rootPts @focusPts)))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @config.yMax, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: false, animate: false },
                { type: stack, direction: horizontal, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "a = " (math/round @entity.a 2)) },
                        { type: range-slider, min: -3, max: 3, step: 0.25, value: @entity.a, showTooltip: true, onChange: SET_A }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "b = " (math/round @entity.b 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.b, showTooltip: true, onChange: SET_B }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "c = " (math/round @entity.c 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.c, showTooltip: true, onChange: SET_C }
                      ] }
                  ] },
                { type: typography, variant: body, content: @entity.equationLabel },
                { type: typography, variant: body, content: (str/concat "Vertex (" (math/round @entity.vertexX 2) ", " (math/round @entity.vertexY 2) ") · axis of symmetry x = " (math/round @entity.vertexX 2)) },
                { type: typography, variant: body, content: @entity.rootsLabel },
                { type: typography, variant: caption, content: (if @config.showDiscriminant (str/concat "Discriminant Δ = b² − 4ac = " (math/round @entity.discriminant 2)) "") }
              ] }
          ]
        })
        (emit QUADRATIC_UPDATED { a: @entity.a, b: @entity.b, c: @entity.c, vertexX: @entity.vertexX, vertexY: @entity.vertexY, discriminant: @entity.discriminant, rootsLabel: @entity.rootsLabel })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.a @config.initialA)
        (set @entity.b @config.initialB)
        (set @entity.c @config.initialC)
        (let (
            (aSafe (if (< (math/abs @entity.a) 0.05) (if (< @entity.a 0) -0.05 0.05) @entity.a))
            (vx (/ (- 0 @entity.b) (* 2 @aSafe)))
            (vy (+ (* @entity.a (* @vx @vx)) (+ (* @entity.b @vx) @entity.c)))
            (disc (- (* @entity.b @entity.b) (* 4 (* @entity.a @entity.c))))
            (discPos (math/max 0 @disc))
            (r1 (/ (+ (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (r2 (/ (- (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (rootLabel (if (> @disc 0.0001) (str/concat "Two real roots: x = " (math/round @r1 2) " and x = " (math/round @r2 2)) (if (> @disc -0.0001) (str/concat "One repeated root: x = " (math/round @r1 2)) "No real roots — the discriminant is negative")))
            (eqText (if (== @config.form "vertex") (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @vx 2) ")² + " (math/round @vy 2)) (if (== @config.form "factored") (if (> @disc 0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")(x − " (math/round @r2 2) ")") (if (> @disc -0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")²") "Not factorable over the real numbers — the discriminant is negative")) (str/concat "y = " (math/round @entity.a 2) "x² + " (math/round @entity.b 2) "x + " (math/round @entity.c 2)))))
            (parabola { label: "parabola", color: @config.curveColor, samples: (array/map @config.sampleXs (fn x { x: @x, y: (+ (* @entity.a (* @x @x)) (+ (* @entity.b @x) @entity.c)) })) })
            (axisLine { label: "axis of symmetry", color: @config.axisColor, samples: [ { x: @vx, y: @config.yMin }, { x: @vx, y: @config.yMax } ] })
            (rootPts (if (> @disc 0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 }, { x: @r2, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] (if (> @disc -0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] [])))
            (focusPts (if @config.showFocus [ { x: @vx, y: (+ @vy (/ 1 (* 4 @aSafe))), label: "focus", color: @config.focusColor, radius: 5 } ] []))
          )
          (do
            (set @entity.vertexX @vx)
            (set @entity.vertexY @vy)
            (set @entity.discriminant @disc)
            (set @entity.equationLabel @eqText)
            (set @entity.rootsLabel @rootLabel)
            (set @entity.curves [ @parabola, @axisLine ])
            (set @entity.points (array/concat [ { x: @vx, y: @vy, label: "vertex", color: @config.vertexColor, radius: 6 } ] (array/concat @rootPts @focusPts)))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @config.yMax, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: false, animate: false },
                { type: stack, direction: horizontal, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "a = " (math/round @entity.a 2)) },
                        { type: range-slider, min: -3, max: 3, step: 0.25, value: @entity.a, showTooltip: true, onChange: SET_A }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "b = " (math/round @entity.b 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.b, showTooltip: true, onChange: SET_B }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "c = " (math/round @entity.c 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.c, showTooltip: true, onChange: SET_C }
                      ] }
                  ] },
                { type: typography, variant: body, content: @entity.equationLabel },
                { type: typography, variant: body, content: (str/concat "Vertex (" (math/round @entity.vertexX 2) ", " (math/round @entity.vertexY 2) ") · axis of symmetry x = " (math/round @entity.vertexX 2)) },
                { type: typography, variant: body, content: @entity.rootsLabel },
                { type: typography, variant: caption, content: (if @config.showDiscriminant (str/concat "Discriminant Δ = b² − 4ac = " (math/round @entity.discriminant 2)) "") }
              ] }
          ]
        })
        (emit QUADRATIC_UPDATED { a: @entity.a, b: @entity.b, c: @entity.c, vertexX: @entity.vertexX, vertexY: @entity.vertexY, discriminant: @entity.discriminant, rootsLabel: @entity.rootsLabel })

      SET_A -> idle when (== @entity.active true)
        (let (
            (na (math/clamp ?value -3 3))
            (aSafe (if (< (math/abs @na) 0.05) (if (< @na 0) -0.05 0.05) @na))
            (vx (/ (- 0 @entity.b) (* 2 @aSafe)))
            (vy (+ (* @na (* @vx @vx)) (+ (* @entity.b @vx) @entity.c)))
            (disc (- (* @entity.b @entity.b) (* 4 (* @na @entity.c))))
            (discPos (math/max 0 @disc))
            (r1 (/ (+ (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (r2 (/ (- (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (rootLabel (if (> @disc 0.0001) (str/concat "Two real roots: x = " (math/round @r1 2) " and x = " (math/round @r2 2)) (if (> @disc -0.0001) (str/concat "One repeated root: x = " (math/round @r1 2)) "No real roots — the discriminant is negative")))
            (eqText (if (== @config.form "vertex") (str/concat "y = " (math/round @na 2) "(x − " (math/round @vx 2) ")² + " (math/round @vy 2)) (if (== @config.form "factored") (if (> @disc 0.0001) (str/concat "y = " (math/round @na 2) "(x − " (math/round @r1 2) ")(x − " (math/round @r2 2) ")") (if (> @disc -0.0001) (str/concat "y = " (math/round @na 2) "(x − " (math/round @r1 2) ")²") "Not factorable over the real numbers — the discriminant is negative")) (str/concat "y = " (math/round @na 2) "x² + " (math/round @entity.b 2) "x + " (math/round @entity.c 2)))))
            (parabola { label: "parabola", color: @config.curveColor, samples: (array/map @config.sampleXs (fn x { x: @x, y: (+ (* @na (* @x @x)) (+ (* @entity.b @x) @entity.c)) })) })
            (axisLine { label: "axis of symmetry", color: @config.axisColor, samples: [ { x: @vx, y: @config.yMin }, { x: @vx, y: @config.yMax } ] })
            (rootPts (if (> @disc 0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 }, { x: @r2, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] (if (> @disc -0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] [])))
            (focusPts (if @config.showFocus [ { x: @vx, y: (+ @vy (/ 1 (* 4 @aSafe))), label: "focus", color: @config.focusColor, radius: 5 } ] []))
          )
          (do
            (set @entity.a @na)
            (set @entity.vertexX @vx)
            (set @entity.vertexY @vy)
            (set @entity.discriminant @disc)
            (set @entity.equationLabel @eqText)
            (set @entity.rootsLabel @rootLabel)
            (set @entity.curves [ @parabola, @axisLine ])
            (set @entity.points (array/concat [ { x: @vx, y: @vy, label: "vertex", color: @config.vertexColor, radius: 6 } ] (array/concat @rootPts @focusPts)))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @config.yMax, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: false, animate: false },
                { type: stack, direction: horizontal, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "a = " (math/round @entity.a 2)) },
                        { type: range-slider, min: -3, max: 3, step: 0.25, value: @entity.a, showTooltip: true, onChange: SET_A }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "b = " (math/round @entity.b 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.b, showTooltip: true, onChange: SET_B }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "c = " (math/round @entity.c 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.c, showTooltip: true, onChange: SET_C }
                      ] }
                  ] },
                { type: typography, variant: body, content: @entity.equationLabel },
                { type: typography, variant: body, content: (str/concat "Vertex (" (math/round @entity.vertexX 2) ", " (math/round @entity.vertexY 2) ") · axis of symmetry x = " (math/round @entity.vertexX 2)) },
                { type: typography, variant: body, content: @entity.rootsLabel },
                { type: typography, variant: caption, content: (if @config.showDiscriminant (str/concat "Discriminant Δ = b² − 4ac = " (math/round @entity.discriminant 2)) "") }
              ] }
          ]
        })
        (emit QUADRATIC_UPDATED { a: @entity.a, b: @entity.b, c: @entity.c, vertexX: @entity.vertexX, vertexY: @entity.vertexY, discriminant: @entity.discriminant, rootsLabel: @entity.rootsLabel })

      SET_B -> idle when (== @entity.active true)
        (let (
            (nb (math/clamp ?value -10 10))
            (aSafe (if (< (math/abs @entity.a) 0.05) (if (< @entity.a 0) -0.05 0.05) @entity.a))
            (vx (/ (- 0 @nb) (* 2 @aSafe)))
            (vy (+ (* @entity.a (* @vx @vx)) (+ (* @nb @vx) @entity.c)))
            (disc (- (* @nb @nb) (* 4 (* @entity.a @entity.c))))
            (discPos (math/max 0 @disc))
            (r1 (/ (+ (- 0 @nb) (math/sqrt @discPos)) (* 2 @aSafe)))
            (r2 (/ (- (- 0 @nb) (math/sqrt @discPos)) (* 2 @aSafe)))
            (rootLabel (if (> @disc 0.0001) (str/concat "Two real roots: x = " (math/round @r1 2) " and x = " (math/round @r2 2)) (if (> @disc -0.0001) (str/concat "One repeated root: x = " (math/round @r1 2)) "No real roots — the discriminant is negative")))
            (eqText (if (== @config.form "vertex") (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @vx 2) ")² + " (math/round @vy 2)) (if (== @config.form "factored") (if (> @disc 0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")(x − " (math/round @r2 2) ")") (if (> @disc -0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")²") "Not factorable over the real numbers — the discriminant is negative")) (str/concat "y = " (math/round @entity.a 2) "x² + " (math/round @nb 2) "x + " (math/round @entity.c 2)))))
            (parabola { label: "parabola", color: @config.curveColor, samples: (array/map @config.sampleXs (fn x { x: @x, y: (+ (* @entity.a (* @x @x)) (+ (* @nb @x) @entity.c)) })) })
            (axisLine { label: "axis of symmetry", color: @config.axisColor, samples: [ { x: @vx, y: @config.yMin }, { x: @vx, y: @config.yMax } ] })
            (rootPts (if (> @disc 0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 }, { x: @r2, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] (if (> @disc -0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] [])))
            (focusPts (if @config.showFocus [ { x: @vx, y: (+ @vy (/ 1 (* 4 @aSafe))), label: "focus", color: @config.focusColor, radius: 5 } ] []))
          )
          (do
            (set @entity.b @nb)
            (set @entity.vertexX @vx)
            (set @entity.vertexY @vy)
            (set @entity.discriminant @disc)
            (set @entity.equationLabel @eqText)
            (set @entity.rootsLabel @rootLabel)
            (set @entity.curves [ @parabola, @axisLine ])
            (set @entity.points (array/concat [ { x: @vx, y: @vy, label: "vertex", color: @config.vertexColor, radius: 6 } ] (array/concat @rootPts @focusPts)))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @config.yMax, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: false, animate: false },
                { type: stack, direction: horizontal, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "a = " (math/round @entity.a 2)) },
                        { type: range-slider, min: -3, max: 3, step: 0.25, value: @entity.a, showTooltip: true, onChange: SET_A }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "b = " (math/round @entity.b 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.b, showTooltip: true, onChange: SET_B }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "c = " (math/round @entity.c 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.c, showTooltip: true, onChange: SET_C }
                      ] }
                  ] },
                { type: typography, variant: body, content: @entity.equationLabel },
                { type: typography, variant: body, content: (str/concat "Vertex (" (math/round @entity.vertexX 2) ", " (math/round @entity.vertexY 2) ") · axis of symmetry x = " (math/round @entity.vertexX 2)) },
                { type: typography, variant: body, content: @entity.rootsLabel },
                { type: typography, variant: caption, content: (if @config.showDiscriminant (str/concat "Discriminant Δ = b² − 4ac = " (math/round @entity.discriminant 2)) "") }
              ] }
          ]
        })
        (emit QUADRATIC_UPDATED { a: @entity.a, b: @entity.b, c: @entity.c, vertexX: @entity.vertexX, vertexY: @entity.vertexY, discriminant: @entity.discriminant, rootsLabel: @entity.rootsLabel })

      SET_C -> idle when (== @entity.active true)
        (let (
            (nc (math/clamp ?value -10 10))
            (aSafe (if (< (math/abs @entity.a) 0.05) (if (< @entity.a 0) -0.05 0.05) @entity.a))
            (vx (/ (- 0 @entity.b) (* 2 @aSafe)))
            (vy (+ (* @entity.a (* @vx @vx)) (+ (* @entity.b @vx) @nc)))
            (disc (- (* @entity.b @entity.b) (* 4 (* @entity.a @nc))))
            (discPos (math/max 0 @disc))
            (r1 (/ (+ (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (r2 (/ (- (- 0 @entity.b) (math/sqrt @discPos)) (* 2 @aSafe)))
            (rootLabel (if (> @disc 0.0001) (str/concat "Two real roots: x = " (math/round @r1 2) " and x = " (math/round @r2 2)) (if (> @disc -0.0001) (str/concat "One repeated root: x = " (math/round @r1 2)) "No real roots — the discriminant is negative")))
            (eqText (if (== @config.form "vertex") (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @vx 2) ")² + " (math/round @vy 2)) (if (== @config.form "factored") (if (> @disc 0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")(x − " (math/round @r2 2) ")") (if (> @disc -0.0001) (str/concat "y = " (math/round @entity.a 2) "(x − " (math/round @r1 2) ")²") "Not factorable over the real numbers — the discriminant is negative")) (str/concat "y = " (math/round @entity.a 2) "x² + " (math/round @entity.b 2) "x + " (math/round @nc 2)))))
            (parabola { label: "parabola", color: @config.curveColor, samples: (array/map @config.sampleXs (fn x { x: @x, y: (+ (* @entity.a (* @x @x)) (+ (* @entity.b @x) @nc)) })) })
            (axisLine { label: "axis of symmetry", color: @config.axisColor, samples: [ { x: @vx, y: @config.yMin }, { x: @vx, y: @config.yMax } ] })
            (rootPts (if (> @disc 0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 }, { x: @r2, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] (if (> @disc -0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] [])))
            (focusPts (if @config.showFocus [ { x: @vx, y: (+ @vy (/ 1 (* 4 @aSafe))), label: "focus", color: @config.focusColor, radius: 5 } ] []))
          )
          (do
            (set @entity.c @nc)
            (set @entity.vertexX @vx)
            (set @entity.vertexY @vy)
            (set @entity.discriminant @disc)
            (set @entity.equationLabel @eqText)
            (set @entity.rootsLabel @rootLabel)
            (set @entity.curves [ @parabola, @axisLine ])
            (set @entity.points (array/concat [ { x: @vx, y: @vy, label: "vertex", color: @config.vertexColor, radius: 6 } ] (array/concat @rootPts @focusPts)))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @config.yMax, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: false, animate: false },
                { type: stack, direction: horizontal, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "a = " (math/round @entity.a 2)) },
                        { type: range-slider, min: -3, max: 3, step: 0.25, value: @entity.a, showTooltip: true, onChange: SET_A }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "b = " (math/round @entity.b 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.b, showTooltip: true, onChange: SET_B }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "c = " (math/round @entity.c 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.c, showTooltip: true, onChange: SET_C }
                      ] }
                  ] },
                { type: typography, variant: body, content: @entity.equationLabel },
                { type: typography, variant: body, content: (str/concat "Vertex (" (math/round @entity.vertexX 2) ", " (math/round @entity.vertexY 2) ") · axis of symmetry x = " (math/round @entity.vertexX 2)) },
                { type: typography, variant: body, content: @entity.rootsLabel },
                { type: typography, variant: caption, content: (if @config.showDiscriminant (str/concat "Discriminant Δ = b² − 4ac = " (math/round @entity.discriminant 2)) "") }
              ] }
          ]
        })
        (emit QUADRATIC_UPDATED { a: @entity.a, b: @entity.b, c: @entity.c, vertexX: @entity.vertexX, vertexY: @entity.vertexY, discriminant: @entity.discriminant, rootsLabel: @entity.rootsLabel })

      RESET -> idle when (== @entity.active true)
        (let (
            (na @config.initialA)
            (nb @config.initialB)
            (nc @config.initialC)
            (aSafe (if (< (math/abs @na) 0.05) (if (< @na 0) -0.05 0.05) @na))
            (vx (/ (- 0 @nb) (* 2 @aSafe)))
            (vy (+ (* @na (* @vx @vx)) (+ (* @nb @vx) @nc)))
            (disc (- (* @nb @nb) (* 4 (* @na @nc))))
            (discPos (math/max 0 @disc))
            (r1 (/ (+ (- 0 @nb) (math/sqrt @discPos)) (* 2 @aSafe)))
            (r2 (/ (- (- 0 @nb) (math/sqrt @discPos)) (* 2 @aSafe)))
            (rootLabel (if (> @disc 0.0001) (str/concat "Two real roots: x = " (math/round @r1 2) " and x = " (math/round @r2 2)) (if (> @disc -0.0001) (str/concat "One repeated root: x = " (math/round @r1 2)) "No real roots — the discriminant is negative")))
            (eqText (if (== @config.form "vertex") (str/concat "y = " (math/round @na 2) "(x − " (math/round @vx 2) ")² + " (math/round @vy 2)) (if (== @config.form "factored") (if (> @disc 0.0001) (str/concat "y = " (math/round @na 2) "(x − " (math/round @r1 2) ")(x − " (math/round @r2 2) ")") (if (> @disc -0.0001) (str/concat "y = " (math/round @na 2) "(x − " (math/round @r1 2) ")²") "Not factorable over the real numbers — the discriminant is negative")) (str/concat "y = " (math/round @na 2) "x² + " (math/round @nb 2) "x + " (math/round @nc 2)))))
            (parabola { label: "parabola", color: @config.curveColor, samples: (array/map @config.sampleXs (fn x { x: @x, y: (+ (* @na (* @x @x)) (+ (* @nb @x) @nc)) })) })
            (axisLine { label: "axis of symmetry", color: @config.axisColor, samples: [ { x: @vx, y: @config.yMin }, { x: @vx, y: @config.yMax } ] })
            (rootPts (if (> @disc 0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 }, { x: @r2, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] (if (> @disc -0.0001) [ { x: @r1, y: 0, label: "root", color: @config.rootColor, radius: 5 } ] [])))
            (focusPts (if @config.showFocus [ { x: @vx, y: (+ @vy (/ 1 (* 4 @aSafe))), label: "focus", color: @config.focusColor, radius: 5 } ] []))
          )
          (do
            (set @entity.a @na)
            (set @entity.b @nb)
            (set @entity.c @nc)
            (set @entity.vertexX @vx)
            (set @entity.vertexY @vy)
            (set @entity.discriminant @disc)
            (set @entity.equationLabel @eqText)
            (set @entity.rootsLabel @rootLabel)
            (set @entity.curves [ @parabola, @axisLine ])
            (set @entity.points (array/concat [ { x: @vx, y: @vy, label: "vertex", color: @config.vertexColor, radius: 6 } ] (array/concat @rootPts @focusPts)))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: @config.xMin, xMax: @config.xMax, yMin: @config.yMin, yMax: @config.yMax, showAxes: @config.showAxes, showGrid: @config.showGrid, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: false, animate: false },
                { type: stack, direction: horizontal, gap: md, children: [
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "a = " (math/round @entity.a 2)) },
                        { type: range-slider, min: -3, max: 3, step: 0.25, value: @entity.a, showTooltip: true, onChange: SET_A }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "b = " (math/round @entity.b 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.b, showTooltip: true, onChange: SET_B }
                      ] },
                    { type: stack, direction: vertical, gap: xs, children: [
                        { type: typography, variant: caption, content: (str/concat "c = " (math/round @entity.c 2)) },
                        { type: range-slider, min: -10, max: 10, step: 0.5, value: @entity.c, showTooltip: true, onChange: SET_C }
                      ] }
                  ] },
                { type: typography, variant: body, content: @entity.equationLabel },
                { type: typography, variant: body, content: (str/concat "Vertex (" (math/round @entity.vertexX 2) ", " (math/round @entity.vertexY 2) ") · axis of symmetry x = " (math/round @entity.vertexX 2)) },
                { type: typography, variant: body, content: @entity.rootsLabel },
                { type: typography, variant: caption, content: (if @config.showDiscriminant (str/concat "Discriminant Δ = b² − 4ac = " (math/round @entity.discriminant 2)) "") }
              ] }
          ]
        })
        (emit QUADRATIC_UPDATED { a: @entity.a, b: @entity.b, c: @entity.c, vertexX: @entity.vertexX, vertexY: @entity.vertexY, discriminant: @entity.discriminant, rootsLabel: @entity.rootsLabel })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_A {
        value : number
      }
        @description "Learner dragged the leading-coefficient slider to set a in y = ax² + bx + c."
        @tier "domain"
      SET_B {
        value : number
      }
        @description "Learner dragged the linear-coefficient slider to set b in y = ax² + bx + c."
        @tier "domain"
      SET_C {
        value : number
      }
        @description "Learner dragged the constant-term slider to set c in y = ax² + bx + c."
        @tier "domain"
    }

    emits {
      QUADRATIC_UPDATED -> external {
        a : number
        b : number
        c : number
        vertexX : number
        vertexY : number
        discriminant : number
        rootsLabel : string
      }
        @description "The parabola's coefficients and derived readouts after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "parabola update, quadratic, coefficients, vertex, roots, discriminant"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      initialA : number = 1
        @label "Initial a"
        @description "Starting leading coefficient a in y = ax² + bx + c — controls the parabola's opening direction and width."
        @synonyms "leading coefficient, quadratic coefficient, opening, vertical stretch"
        @tier "domain"
      initialB : number = 0
        @label "Initial b"
        @description "Starting linear coefficient b — moves the parabola's axis of symmetry off the y-axis."
        @synonyms "linear coefficient, axis shift"
        @tier "domain"
      initialC : number = 0
        @label "Initial c"
        @description "Starting constant term c — the parabola's y-intercept."
        @synonyms "constant term, y-intercept"
        @tier "domain"
      form : "standard" | "vertex" | "factored" = standard
        @label "Equation Form"
        @description "Which algebraic form the equation readout shows: standard ax² + bx + c, vertex a(x − h)² + k, or factored a(x − r₁)(x − r₂)."
        @synonyms "standard form, vertex form, factored form, completing the square"
        @tier "domain"
      sampleXs : [number] = [ -10, -9.5, -9, -8.5, -8, -7.5, -7, -6.5, -6, -5.5, -5, -4.5, -4, -3.5, -3, -2.5, -2, -1.5, -1, -0.5, 0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10 ]
        @label "Sample Xs"
        @description "X coordinates the parabola is sampled at to draw its curve."
        @tier "domain"
      showDiscriminant : boolean = true
        @label "Show Discriminant"
        @description "Show the discriminant Δ = b² − 4ac readout under the canvas."
        @synonyms "discriminant, delta, nature of roots"
        @tier "presentation"
      showFocus : boolean = false
        @label "Show Focus"
        @description "Mark the parabola's focus point (h, k + 1/4a) on the canvas."
        @synonyms "focus, focal point"
        @tier "presentation"
      title : string = "Quadratic Explorer"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      xMin : number = -10
        @label "X Min"
        @description "Minimum x value on the canvas."
        @tier "presentation"
      xMax : number = 10
        @label "X Max"
        @description "Maximum x value on the canvas."
        @tier "presentation"
      yMin : number = -10
        @label "Y Min"
        @description "Minimum y value on the canvas."
        @tier "presentation"
      yMax : number = 10
        @label "Y Max"
        @description "Maximum y value on the canvas."
        @tier "presentation"
      showAxes : boolean = true
        @label "Show Axes"
        @tier "presentation"
      showGrid : boolean = true
        @label "Show Grid"
        @tier "presentation"
      gridStep : number = 1
        @label "Grid Step"
        @tier "presentation"
      curveColor : string = "#2563eb"
        @label "Parabola Color"
        @tier "presentation"
      axisColor : string = "#94a3b8"
        @label "Axis Line Color"
        @tier "presentation"
      vertexColor : string = "#dc2626"
        @label "Vertex Color"
        @tier "presentation"
      rootColor : string = "#16a34a"
        @label "Root Color"
        @tier "presentation"
      focusColor : string = "#9333ea"
        @label "Focus Color"
        @tier "presentation"
    }
  }

  page "/math-quadratic" as MathQuadraticPage -> MathQuadraticSim
}
