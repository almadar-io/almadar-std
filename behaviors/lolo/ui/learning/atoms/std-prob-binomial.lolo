app std-prob-binomial "1.0.0"
"Binomial trial accumulator — each run flips n coins with bias p and drops the head-count into a histogram that converges to the overlaid theoretical binomial PMF, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital ProbBinomialOrbital {
  type ProbBinomialShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbBinomialShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbBinomialShapePoint = {
    x : number!
    y : number!
  }

  entity ProbBinomialScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    biasP : number
    counts : [number]
    runsRun : number
    lastHeads : number
    shapes : [ProbBinomialShape]
  }

  trait ProbBinomialSim -> @rebindable ProbBinomialScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.biasP @config.biasP)
        (set @entity.counts (array/map (array/range (+ @config.trialsPerRun 1)) (fn k 0)))
        (set @entity.runsRun 0)
        (set @entity.lastHeads 0)
        (let (
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (factN (array/reduce (array/range 1 (+ @config.trialsPerRun 1)) 1 (fn (acc i) (* @acc @i))))
            (pmfVals (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (factK (array/reduce (array/range 1 (+ @k 1)) 1 (fn (acc i) (* @acc @i))))
                  (factNmK (array/reduce (array/range 1 (+ (- @config.trialsPerRun @k) 1)) 1 (fn (acc i) (* @acc @i))))
                  (comb (/ @factN (* @factK @factNmK)))
                  (powP (math/pow @entity.biasP @k))
                  (powQ (math/pow (- 1 @entity.biasP) (- @config.trialsPerRun @k)))
                )
                (* @comb (* @powP @powQ))))))
            (maxPmf (math/max 0.0001 (array/max @pmfVals)))
            (maxVal (* @maxPmf 1.25))
            (pmfShapes (if @config.showTheoreticalPMF
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
                { type: "circle", x: (+ 24 (* (+ @k 0.5) (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) (* (/ (array/nth @pmfVals @k) @maxVal) @plotH)), radius: 4, fill: "#dc2626", lineWidth: 0 }))
              []))
          )
          (set @entity.shapes @pmfShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RUN_TRIAL, label: "Run Trial", variant: primary },
                    { type: button, action: RUN_MANY, label: "Run Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Bias p: " (math/round @entity.biasP 2) " — flips per trial: " @config.trialsPerRun) },
                { type: range-slider, min: 0, max: 1, step: 0.01, value: @entity.biasP, showTooltip: true, action: "SET_P" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.trialsPerRun, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.runsRun " run(s) — last trial heads: " @entity.lastHeads " / " @config.trialsPerRun) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.biasP @config.biasP)
        (set @entity.counts (array/map (array/range (+ @config.trialsPerRun 1)) (fn k 0)))
        (set @entity.runsRun 0)
        (set @entity.lastHeads 0)
        (let (
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (factN (array/reduce (array/range 1 (+ @config.trialsPerRun 1)) 1 (fn (acc i) (* @acc @i))))
            (pmfVals (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (factK (array/reduce (array/range 1 (+ @k 1)) 1 (fn (acc i) (* @acc @i))))
                  (factNmK (array/reduce (array/range 1 (+ (- @config.trialsPerRun @k) 1)) 1 (fn (acc i) (* @acc @i))))
                  (comb (/ @factN (* @factK @factNmK)))
                  (powP (math/pow @entity.biasP @k))
                  (powQ (math/pow (- 1 @entity.biasP) (- @config.trialsPerRun @k)))
                )
                (* @comb (* @powP @powQ))))))
            (maxPmf (math/max 0.0001 (array/max @pmfVals)))
            (maxVal (* @maxPmf 1.25))
            (pmfShapes (if @config.showTheoreticalPMF
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
                { type: "circle", x: (+ 24 (* (+ @k 0.5) (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) (* (/ (array/nth @pmfVals @k) @maxVal) @plotH)), radius: 4, fill: "#dc2626", lineWidth: 0 }))
              []))
          )
          (set @entity.shapes @pmfShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RUN_TRIAL, label: "Run Trial", variant: primary },
                    { type: button, action: RUN_MANY, label: "Run Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Bias p: " (math/round @entity.biasP 2) " — flips per trial: " @config.trialsPerRun) },
                { type: range-slider, min: 0, max: 1, step: 0.01, value: @entity.biasP, showTooltip: true, action: "SET_P" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.trialsPerRun, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.runsRun " run(s) — last trial heads: " @entity.lastHeads " / " @config.trialsPerRun) }
              ] }
          ]
        })

      RUN_TRIAL -> idle when (== @entity.active true)
        (let (
            (allowed (< @entity.runsRun @config.maxRuns))
            (heads (array/len (array/filter (array/range @config.trialsPerRun) (fn j (< (math/random) @entity.biasP)))))
            (newCounts (if @allowed
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k (if (== @k @heads) (+ (array/nth @entity.counts @k) 1) (array/nth @entity.counts @k))))
              @entity.counts))
            (newRuns (if @allowed (+ @entity.runsRun 1) @entity.runsRun))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (factN (array/reduce (array/range 1 (+ @config.trialsPerRun 1)) 1 (fn (acc i) (* @acc @i))))
            (pmfVals (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (factK (array/reduce (array/range 1 (+ @k 1)) 1 (fn (acc i) (* @acc @i))))
                  (factNmK (array/reduce (array/range 1 (+ (- @config.trialsPerRun @k) 1)) 1 (fn (acc i) (* @acc @i))))
                  (comb (/ @factN (* @factK @factNmK)))
                  (powP (math/pow @entity.biasP @k))
                  (powQ (math/pow (- 1 @entity.biasP) (- @config.trialsPerRun @k)))
                )
                (* @comb (* @powP @powQ))))))
            (maxPmf (math/max 0.0001 (array/max @pmfVals)))
            (props (array/map (array/range (+ @config.trialsPerRun 1)) (fn k (if (> @newRuns 0) (/ (array/nth @newCounts @k) @newRuns) 0))))
            (maxVal (* (math/max @maxPmf (array/max @props)) 1.25))
            (barShapes (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (barH (* (/ (array/nth @props @k) @maxVal) @plotH))
                )
                { type: "rect", x: (+ 24 (* @k (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) @barH), width: (* (/ @plotW (+ @config.trialsPerRun 1)) 0.7), height: @barH, fill: "#2563eb", opacity: 0.6, lineWidth: 0 }))))
            (pmfShapes (if @config.showTheoreticalPMF
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
                { type: "circle", x: (+ 24 (* (+ @k 0.5) (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) (* (/ (array/nth @pmfVals @k) @maxVal) @plotH)), radius: 4, fill: "#dc2626", lineWidth: 0 }))
              []))
          )
          (do
            (set @entity.counts @newCounts)
            (set @entity.runsRun @newRuns)
            (set @entity.lastHeads (if @allowed @heads @entity.lastHeads))
            (set @entity.shapes (array/concat @barShapes @pmfShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RUN_TRIAL, label: "Run Trial", variant: primary },
                    { type: button, action: RUN_MANY, label: "Run Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Bias p: " (math/round @entity.biasP 2) " — flips per trial: " @config.trialsPerRun) },
                { type: range-slider, min: 0, max: 1, step: 0.01, value: @entity.biasP, showTooltip: true, action: "SET_P" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.trialsPerRun, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.runsRun " run(s) — last trial heads: " @entity.lastHeads " / " @config.trialsPerRun) }
              ] }
          ]
        })
        (emit BINOMIAL_UPDATED { runsRun: @entity.runsRun, lastHeads: @entity.lastHeads, counts: @entity.counts })

      RUN_MANY -> idle when (== @entity.active true)
        (let (
            (room (math/max 0 (- @config.maxRuns @entity.runsRun)))
            (batchSize (math/min @config.runsPerStep @room))
            (batchHeads (array/map (array/range @batchSize) (fn r (array/len (array/filter (array/range @config.trialsPerRun) (fn j (< (math/random) @entity.biasP)))))))
            (newCounts (array/map (array/range (+ @config.trialsPerRun 1)) (fn k (+ (array/nth @entity.counts @k) (array/len (array/filter @batchHeads (fn h (== @h @k))))))))
            (newRuns (+ @entity.runsRun @batchSize))
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (factN (array/reduce (array/range 1 (+ @config.trialsPerRun 1)) 1 (fn (acc i) (* @acc @i))))
            (pmfVals (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (factK (array/reduce (array/range 1 (+ @k 1)) 1 (fn (acc i) (* @acc @i))))
                  (factNmK (array/reduce (array/range 1 (+ (- @config.trialsPerRun @k) 1)) 1 (fn (acc i) (* @acc @i))))
                  (comb (/ @factN (* @factK @factNmK)))
                  (powP (math/pow @entity.biasP @k))
                  (powQ (math/pow (- 1 @entity.biasP) (- @config.trialsPerRun @k)))
                )
                (* @comb (* @powP @powQ))))))
            (maxPmf (math/max 0.0001 (array/max @pmfVals)))
            (props (array/map (array/range (+ @config.trialsPerRun 1)) (fn k (if (> @newRuns 0) (/ (array/nth @newCounts @k) @newRuns) 0))))
            (maxVal (* (math/max @maxPmf (array/max @props)) 1.25))
            (barShapes (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (barH (* (/ (array/nth @props @k) @maxVal) @plotH))
                )
                { type: "rect", x: (+ 24 (* @k (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) @barH), width: (* (/ @plotW (+ @config.trialsPerRun 1)) 0.7), height: @barH, fill: "#2563eb", opacity: 0.6, lineWidth: 0 }))))
            (pmfShapes (if @config.showTheoreticalPMF
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
                { type: "circle", x: (+ 24 (* (+ @k 0.5) (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) (* (/ (array/nth @pmfVals @k) @maxVal) @plotH)), radius: 4, fill: "#dc2626", lineWidth: 0 }))
              []))
          )
          (do
            (set @entity.counts @newCounts)
            (set @entity.runsRun @newRuns)
            (set @entity.lastHeads (if (> @batchSize 0) (array/last @batchHeads) @entity.lastHeads))
            (set @entity.shapes (array/concat @barShapes @pmfShapes))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RUN_TRIAL, label: "Run Trial", variant: primary },
                    { type: button, action: RUN_MANY, label: "Run Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Bias p: " (math/round @entity.biasP 2) " — flips per trial: " @config.trialsPerRun) },
                { type: range-slider, min: 0, max: 1, step: 0.01, value: @entity.biasP, showTooltip: true, action: "SET_P" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.trialsPerRun, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.runsRun " run(s) — last trial heads: " @entity.lastHeads " / " @config.trialsPerRun) }
              ] }
          ]
        })
        (emit BINOMIAL_UPDATED { runsRun: @entity.runsRun, lastHeads: @entity.lastHeads, counts: @entity.counts })

      SET_P -> idle when (== @entity.active true)
        (set @entity.biasP (math/clamp ?value 0 1))
        (set @entity.counts (array/map (array/range (+ @config.trialsPerRun 1)) (fn k 0)))
        (set @entity.runsRun 0)
        (set @entity.lastHeads 0)
        (let (
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (factN (array/reduce (array/range 1 (+ @config.trialsPerRun 1)) 1 (fn (acc i) (* @acc @i))))
            (pmfVals (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (factK (array/reduce (array/range 1 (+ @k 1)) 1 (fn (acc i) (* @acc @i))))
                  (factNmK (array/reduce (array/range 1 (+ (- @config.trialsPerRun @k) 1)) 1 (fn (acc i) (* @acc @i))))
                  (comb (/ @factN (* @factK @factNmK)))
                  (powP (math/pow @entity.biasP @k))
                  (powQ (math/pow (- 1 @entity.biasP) (- @config.trialsPerRun @k)))
                )
                (* @comb (* @powP @powQ))))))
            (maxPmf (math/max 0.0001 (array/max @pmfVals)))
            (maxVal (* @maxPmf 1.25))
            (pmfShapes (if @config.showTheoreticalPMF
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
                { type: "circle", x: (+ 24 (* (+ @k 0.5) (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) (* (/ (array/nth @pmfVals @k) @maxVal) @plotH)), radius: 4, fill: "#dc2626", lineWidth: 0 }))
              []))
          )
          (set @entity.shapes @pmfShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RUN_TRIAL, label: "Run Trial", variant: primary },
                    { type: button, action: RUN_MANY, label: "Run Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Bias p: " (math/round @entity.biasP 2) " — flips per trial: " @config.trialsPerRun) },
                { type: range-slider, min: 0, max: 1, step: 0.01, value: @entity.biasP, showTooltip: true, action: "SET_P" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.trialsPerRun, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.runsRun " run(s) — last trial heads: " @entity.lastHeads " / " @config.trialsPerRun) }
              ] }
          ]
        })
        (emit BINOMIAL_UPDATED { runsRun: @entity.runsRun, lastHeads: @entity.lastHeads, counts: @entity.counts })

      RESET -> idle when (== @entity.active true)
        (set @entity.counts (array/map (array/range (+ @config.trialsPerRun 1)) (fn k 0)))
        (set @entity.runsRun 0)
        (set @entity.lastHeads 0)
        (let (
            (plotW (- @config.width 48))
            (plotH (- @config.height 48))
            (factN (array/reduce (array/range 1 (+ @config.trialsPerRun 1)) 1 (fn (acc i) (* @acc @i))))
            (pmfVals (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
              (let (
                  (factK (array/reduce (array/range 1 (+ @k 1)) 1 (fn (acc i) (* @acc @i))))
                  (factNmK (array/reduce (array/range 1 (+ (- @config.trialsPerRun @k) 1)) 1 (fn (acc i) (* @acc @i))))
                  (comb (/ @factN (* @factK @factNmK)))
                  (powP (math/pow @entity.biasP @k))
                  (powQ (math/pow (- 1 @entity.biasP) (- @config.trialsPerRun @k)))
                )
                (* @comb (* @powP @powQ))))))
            (maxPmf (math/max 0.0001 (array/max @pmfVals)))
            (maxVal (* @maxPmf 1.25))
            (pmfShapes (if @config.showTheoreticalPMF
              (array/map (array/range (+ @config.trialsPerRun 1)) (fn k
                { type: "circle", x: (+ 24 (* (+ @k 0.5) (/ @plotW (+ @config.trialsPerRun 1)))), y: (- (+ 24 @plotH) (* (/ (array/nth @pmfVals @k) @maxVal) @plotH)), radius: 4, fill: "#dc2626", lineWidth: 0 }))
              []))
          )
          (set @entity.shapes @pmfShapes)
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: RUN_TRIAL, label: "Run Trial", variant: primary },
                    { type: button, action: RUN_MANY, label: "Run Many", variant: secondary },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: caption, content: (str/concat "Bias p: " (math/round @entity.biasP 2) " — flips per trial: " @config.trialsPerRun) },
                { type: range-slider, min: 0, max: 1, step: 0.01, value: @entity.biasP, showTooltip: true, action: "SET_P" },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.trialsPerRun, yMin: 0, yMax: 1, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: false, animate: false },
                { type: typography, variant: body, content: (str/concat @entity.runsRun " run(s) — last trial heads: " @entity.lastHeads " / " @config.trialsPerRun) }
              ] }
          ]
        })
        (emit BINOMIAL_UPDATED { runsRun: @entity.runsRun, lastHeads: @entity.lastHeads, counts: @entity.counts })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SET_P {
        value : number
      }
        @description "Learner dragged the bias slider — value is the new coin bias p; changing p clears the accumulated runs."
        @tier "domain"
    }

    emits {
      BINOMIAL_UPDATED -> external {
        runsRun : number
        lastHeads : number
        counts : [number]
      }
        @description "The binomial accumulation state after each run — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "binomial trial, coin flip run, heads count, pmf convergence"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Binomial Trials"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      trialsPerRun : number = 10
        @label "Trials Per Run"
        @description "Number of coin flips n per trial — the histogram x-axis runs from 0 to n heads."
        @synonyms "n, flips per trial, binomial n, number of trials"
        @tier "domain"
      biasP : number = 0.5
        @label "Bias p"
        @description "Probability of heads on each flip — shifts the histogram and the theoretical PMF."
        @synonyms "coin bias, success probability, binomial p, weighted coin"
        @tier "domain"
      runsPerStep : number = 25
        @label "Runs Per Step"
        @description "How many trials Run Many adds to the histogram per click."
        @tier "domain"
      maxRuns : number = 500
        @label "Max Runs"
        @description "Cap on accumulated trials; further runs are ignored until Reset."
        @tier "domain"
      showTheoreticalPMF : boolean = true
        @label "Show Theoretical PMF"
        @description "Overlay the binomial probability mass function (Stirling-approximated factorials) as markers the empirical histogram converges to."
        @synonyms "pmf, theoretical distribution, binomial distribution"
        @tier "domain"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
    }
  }

  page "/prob-binomial" as ProbBinomialPage -> ProbBinomialSim
}
