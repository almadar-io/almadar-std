app std-ling-phonology "1.0.0"
"Phoneme-vs-allophone classifier — the learner studies a dataset of sound pairs (minimal pairs or complementary distribution), classifies the two sounds as separate phonemes or allophones of one phoneme, and gets a scored verdict with the distributional explanation; datasets and the evidence render on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LingPhonologyOrbital {
  type LingPhonologyShapePoint = {
    x : number!
    y : number!
  }
  type LingPhonologyShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LingPhonologyShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type LingPhonologyDataset = {
    id : string!
    name : string!
    sound1 : string!
    sound2 : string!
    examples : [string]!
    verdict : string!
    explanation : string!
  }
  type LingPhonologyFeatureRow = {
    sound : string!
    features : string!
  }

  entity LingPhonologyScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    renderChildren : [json]
    shapes : [LingPhonologyShape]
    datasetIndex : number
    score : number
    total : number
    answered : boolean
    feedback : string
  }

  trait LingPhonologySim -> @rebindable LingPhonologyScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.datasetIndex 0)
        (set @entity.score 0)
        (set @entity.total 0)
        (set @entity.answered false)
        (set @entity.feedback "")
        (let (
            (ds (array/nth @config.datasets 0))
            (rowShapes (array/map (array/range (array/len (object/get @ds examples))) (fn idx { type: "text", id: (str/concat "ex" @idx), x: @config.leftMargin, y: (+ @config.rowTop (* @idx @config.rowHeight)), text: (array/nth (object/get @ds examples) @idx), fontSize: @config.rowFontSize, align: "left", color: @config.rowColor })))
            (allShapes (array/concat [
                { type: "text", id: "hdr", x: @config.leftMargin, y: @config.headerY, text: (str/concat "[" (object/get @ds sound1) "]  vs  [" (object/get @ds sound2) "]"), fontSize: @config.headerFontSize, align: "left", color: @config.headerColor }
              ] @rowShapes))
            (scoreLabel (str/concat "Score: " @entity.score "/" @entity.total))
            (envLabel (str/concat "Environments to consider: " (str/join @config.environments ", ")))
          )
          (do
            (set @entity.shapes @allShapes)
            (set @entity.renderChildren (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat (object/get @ds name) " — are [" (object/get @ds sound1) "] and [" (object/get @ds sound2) "] separate phonemes or allophones of one phoneme?") },
                { type: typography, variant: caption, content: @envLabel },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "phonemes" }, label: "Separate phonemes", variant: primary },
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "allophones" }, label: "Allophones of one phoneme", variant: secondary },
                    { type: button, action: NEXT_DATASET, label: "Next Dataset", variant: ghost },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: (str/concat @entity.feedback " " @scoreLabel) }
              ] (if (> (array/len @config.featureMatrix) 0)
                (array/map @config.featureMatrix (fn r { type: typography, variant: caption, content: (str/concat "[" (object/get @r sound) "]: " (object/get @r features)) }))
                [])))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.datasetIndex 0)
        (set @entity.score 0)
        (set @entity.total 0)
        (set @entity.answered false)
        (set @entity.feedback "")
        (let (
            (ds (array/nth @config.datasets 0))
            (rowShapes (array/map (array/range (array/len (object/get @ds examples))) (fn idx { type: "text", id: (str/concat "ex" @idx), x: @config.leftMargin, y: (+ @config.rowTop (* @idx @config.rowHeight)), text: (array/nth (object/get @ds examples) @idx), fontSize: @config.rowFontSize, align: "left", color: @config.rowColor })))
            (allShapes (array/concat [
                { type: "text", id: "hdr", x: @config.leftMargin, y: @config.headerY, text: (str/concat "[" (object/get @ds sound1) "]  vs  [" (object/get @ds sound2) "]"), fontSize: @config.headerFontSize, align: "left", color: @config.headerColor }
              ] @rowShapes))
            (scoreLabel (str/concat "Score: " @entity.score "/" @entity.total))
            (envLabel (str/concat "Environments to consider: " (str/join @config.environments ", ")))
          )
          (do
            (set @entity.shapes @allShapes)
            (set @entity.renderChildren (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat (object/get @ds name) " — are [" (object/get @ds sound1) "] and [" (object/get @ds sound2) "] separate phonemes or allophones of one phoneme?") },
                { type: typography, variant: caption, content: @envLabel },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "phonemes" }, label: "Separate phonemes", variant: primary },
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "allophones" }, label: "Allophones of one phoneme", variant: secondary },
                    { type: button, action: NEXT_DATASET, label: "Next Dataset", variant: ghost },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: (str/concat @entity.feedback " " @scoreLabel) }
              ] (if (> (array/len @config.featureMatrix) 0)
                (array/map @config.featureMatrix (fn r { type: typography, variant: caption, content: (str/concat "[" (object/get @r sound) "]: " (object/get @r features)) }))
                [])))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      CLASSIFY_PAIR -> idle when (== @entity.active true)
        (let (
            (ds (array/nth @config.datasets @entity.datasetIndex))
            (correct (== ?answer (object/get @ds verdict)))
            (already @entity.answered)
            (newScore (if (and @correct (not @already)) (+ @entity.score 1) @entity.score))
            (newTotal (if @already @entity.total (+ @entity.total 1)))
            (feedback (if @already
                "Already answered — press Next Dataset to continue."
                (if @correct
                  (str/concat "Correct. " (object/get @ds explanation))
                  (str/concat "Not quite. " (object/get @ds explanation)))))
            (scoreLabel (str/concat "Score: " @newScore "/" @newTotal))
            (envLabel (str/concat "Environments to consider: " (str/join @config.environments ", ")))
          )
          (do
            (set @entity.score @newScore)
            (set @entity.total @newTotal)
            (set @entity.answered true)
            (set @entity.feedback @feedback)
            (set @entity.renderChildren (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat (object/get @ds name) " — are [" (object/get @ds sound1) "] and [" (object/get @ds sound2) "] separate phonemes or allophones of one phoneme?") },
                { type: typography, variant: caption, content: @envLabel },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "phonemes" }, label: "Separate phonemes", variant: primary },
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "allophones" }, label: "Allophones of one phoneme", variant: secondary },
                    { type: button, action: NEXT_DATASET, label: "Next Dataset", variant: ghost },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: (str/concat @entity.feedback " " @scoreLabel) }
              ] (if (> (array/len @config.featureMatrix) 0)
                (array/map @config.featureMatrix (fn r { type: typography, variant: caption, content: (str/concat "[" (object/get @r sound) "]: " (object/get @r features)) }))
                [])))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit PHONOLOGY_UPDATED { datasetIndex: @entity.datasetIndex, score: @entity.score, total: @entity.total, answered: @entity.answered, feedback: @entity.feedback })

      NEXT_DATASET -> idle when (== @entity.active true)
        (let (
            (nextIndex (math/mod (+ @entity.datasetIndex 1) (array/len @config.datasets)))
            (ds (array/nth @config.datasets @nextIndex))
            (rowShapes (array/map (array/range (array/len (object/get @ds examples))) (fn idx { type: "text", id: (str/concat "ex" @idx), x: @config.leftMargin, y: (+ @config.rowTop (* @idx @config.rowHeight)), text: (array/nth (object/get @ds examples) @idx), fontSize: @config.rowFontSize, align: "left", color: @config.rowColor })))
            (allShapes (array/concat [
                { type: "text", id: "hdr", x: @config.leftMargin, y: @config.headerY, text: (str/concat "[" (object/get @ds sound1) "]  vs  [" (object/get @ds sound2) "]"), fontSize: @config.headerFontSize, align: "left", color: @config.headerColor }
              ] @rowShapes))
            (scoreLabel (str/concat "Score: " @entity.score "/" @entity.total))
            (envLabel (str/concat "Environments to consider: " (str/join @config.environments ", ")))
          )
          (do
            (set @entity.datasetIndex @nextIndex)
            (set @entity.answered false)
            (set @entity.feedback "")
            (set @entity.shapes @allShapes)
            (set @entity.renderChildren (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat (object/get @ds name) " — are [" (object/get @ds sound1) "] and [" (object/get @ds sound2) "] separate phonemes or allophones of one phoneme?") },
                { type: typography, variant: caption, content: @envLabel },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "phonemes" }, label: "Separate phonemes", variant: primary },
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "allophones" }, label: "Allophones of one phoneme", variant: secondary },
                    { type: button, action: NEXT_DATASET, label: "Next Dataset", variant: ghost },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: (str/concat @entity.feedback " " @scoreLabel) }
              ] (if (> (array/len @config.featureMatrix) 0)
                (array/map @config.featureMatrix (fn r { type: typography, variant: caption, content: (str/concat "[" (object/get @r sound) "]: " (object/get @r features)) }))
                [])))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit PHONOLOGY_UPDATED { datasetIndex: @entity.datasetIndex, score: @entity.score, total: @entity.total, answered: @entity.answered, feedback: @entity.feedback })

      RESET -> idle when (== @entity.active true)
        (let (
            (ds (array/nth @config.datasets 0))
            (rowShapes (array/map (array/range (array/len (object/get @ds examples))) (fn idx { type: "text", id: (str/concat "ex" @idx), x: @config.leftMargin, y: (+ @config.rowTop (* @idx @config.rowHeight)), text: (array/nth (object/get @ds examples) @idx), fontSize: @config.rowFontSize, align: "left", color: @config.rowColor })))
            (allShapes (array/concat [
                { type: "text", id: "hdr", x: @config.leftMargin, y: @config.headerY, text: (str/concat "[" (object/get @ds sound1) "]  vs  [" (object/get @ds sound2) "]"), fontSize: @config.headerFontSize, align: "left", color: @config.headerColor }
              ] @rowShapes))
            (envLabel (str/concat "Environments to consider: " (str/join @config.environments ", ")))
          )
          (do
            (set @entity.datasetIndex 0)
            (set @entity.score 0)
            (set @entity.total 0)
            (set @entity.answered false)
            (set @entity.feedback "")
            (set @entity.shapes @allShapes)
            (set @entity.renderChildren (array/concat [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: (str/concat (object/get @ds name) " — are [" (object/get @ds sound1) "] and [" (object/get @ds sound2) "] separate phonemes or allophones of one phoneme?") },
                { type: typography, variant: caption, content: @envLabel },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "phonemes" }, label: "Separate phonemes", variant: primary },
                    { type: button, action: CLASSIFY_PAIR, actionPayload: { answer: "allophones" }, label: "Allophones of one phoneme", variant: secondary },
                    { type: button, action: NEXT_DATASET, label: "Next Dataset", variant: ghost },
                    { type: button, action: RESET, label: "Reset", variant: ghost }
                  ] },
                { type: typography, variant: body, content: (str/concat @entity.feedback " Score: 0/0") }
              ] (if (> (array/len @config.featureMatrix) 0)
                (array/map @config.featureMatrix (fn r { type: typography, variant: caption, content: (str/concat "[" (object/get @r sound) "]: " (object/get @r features)) }))
                [])))
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit PHONOLOGY_UPDATED { datasetIndex: @entity.datasetIndex, score: @entity.score, total: @entity.total, answered: @entity.answered, feedback: @entity.feedback })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      CLASSIFY_PAIR {
        answer : string
      }
        @description "Learner classified the current dataset's two sounds as separate phonemes or as allophones of one phoneme; scored when not already answered."
        @tier "domain"
      NEXT_DATASET {
      }
        @description "Learner advanced to the next phonology dataset, clearing the answered flag and feedback."
        @tier "domain"
      RESET {
      }
        @description "Learner reset the classifier to the first dataset with a zeroed score."
        @tier "domain"
    }

    emits {
      PHONOLOGY_UPDATED -> external {
        datasetIndex : number
        score : number
        total : number
        answered : boolean
        feedback : string
      }
        @description "The classifier state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "phonology update, phoneme classification, allophone verdict, minimal pair result"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Phoneme or Allophone?"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      datasets : [LingPhonologyDataset] = [
        { id: "sz", name: "English [s] and [z]", sound1: "s", sound2: "z", examples: [
            "sip [sɪp]  vs  zip [zɪp] — same environment, meaning changes",
            "seal [siːl]  vs  zeal [ziːl] — same environment, meaning changes",
            "A minimal pair exists: swapping [s] for [z] makes a different word."
          ], verdict: "phonemes", explanation: "A minimal pair (sip/zip) proves [s] and [z] contrast in identical environments and change meaning — they are separate phonemes /s/ and /z/." },
        { id: "ll", name: "English clear [l] and dark [ɫ]", sound1: "l", sound2: "ɫ", examples: [
            "leaf [liːf] — clear [l] only before a vowel",
            "feel [fiːɫ] — dark [ɫ] only word-finally after a vowel",
            "No minimal pair exists: the two sounds never occur in the same environment."
          ], verdict: "allophones", explanation: "Clear [l] and dark [ɫ] stand in complementary distribution — [l] in onsets, [ɫ] in codas — so they are allophones of one phoneme /l/." },
        { id: "dd", name: "Spanish [d] and [ð]", sound1: "d", sound2: "ð", examples: [
            "donde [donda] — [d] after a nasal",
            "nada [naða] — [ð] between vowels",
            "No minimal pair exists: each sound is tied to its own phonological environment."
          ], verdict: "allophones", explanation: "Stop [d] appears after pauses and nasals, fricative [ð] between vowels — complementary distribution makes them allophones of /d/." }
      ]
        @label "Datasets"
        @description "Roster of classification problems. Each dataset names the two sounds, lists evidence rows (minimal pairs or environment-restricted forms), and carries the expert verdict (phonemes or allophones) plus the distributional explanation shown after answering."
        @synonyms "phonology dataset, minimal pair, complementary distribution, phoneme analysis, allophony"
        @tier "domain"
      environments : [string] = ["word-initial", "between vowels", "after a nasal", "word-final"]
        @label "Environments"
        @description "The phonological environments the learner is prompted to check when deciding whether the two sounds can contrast."
        @synonyms "phonological environment, phonetic context, distribution"
        @tier "domain"
      featureMatrix : [LingPhonologyFeatureRow] = [
        { sound: "s", features: "+consonantal, −voice, +coronal, +strident" },
        { sound: "z", features: "+consonantal, +voice, +coronal, +strident" },
        { sound: "l", features: "+consonantal, +voice, +lateral, −velarized" },
        { sound: "ɫ", features: "+consonantal, +voice, +lateral, +velarized" }
      ]
        @label "Feature Matrix"
        @description "Distinctive-feature rows for the sounds under study, shown as captions under the classifier — near-identical feature bundles hint at allophony, a contrastive feature hints at separate phonemes."
        @synonyms "distinctive features, feature bundle, phonological features"
        @tier "domain"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 220
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      leftMargin : number = 30
        @label "Left Margin (px)"
        @tier "presentation"
      headerY : number = 40
        @label "Sound Header Y (px)"
        @tier "presentation"
      rowTop : number = 80
        @label "First Row Y (px)"
        @tier "presentation"
      rowHeight : number = 34
        @label "Row Height (px)"
        @tier "presentation"
      headerFontSize : number = 20
        @label "Sound Header Font Size"
        @tier "presentation"
      rowFontSize : number = 15
        @label "Evidence Row Font Size"
        @tier "presentation"
      headerColor : string = "#0f172a"
        @label "Sound Header Color"
        @tier "presentation"
      rowColor : string = "#334155"
        @label "Evidence Row Color"
        @tier "presentation"
    }
  }

  page "/ling-phonology" as LingPhonologyPage -> LingPhonologySim
}
