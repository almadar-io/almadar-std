app std-econ-phillips "1.0.0"
"Phillips-curve engine — a demand shock moves the economy along the short-run Phillips curve (inflation π = expected inflation − slope × (unemployment − natural rate)); each adjustment step adaptively raises expectations and returns unemployment to the natural rate, so the long-run Phillips curve is vertical and the inflation–unemployment tradeoff collapses, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EconPhillipsOrbital {
  type EconPhillipsSample = {
    x : number!
    y : number!
  }
  type EconPhillipsCurve = {
    label : string
    color : string
    samples : [EconPhillipsSample]!
  }
  type EconPhillipsMarker = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }

  entity EconPhillipsScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    naturalRate : number
    expectations : number
    unemployment : number
    inflation : number
    phase : string
    curves : [EconPhillipsCurve]
    points : [EconPhillipsMarker]
  }

  trait EconPhillipsSim -> @rebindable EconPhillipsScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.naturalRate @config.naturalRate)
        (set @entity.expectations @config.expectations)
        (set @entity.unemployment @config.naturalRate)
        (set @entity.inflation @config.expectations)
        (set @entity.phase "Long run")
        (let (
            (srpcLowY (math/clamp (- @entity.expectations (* @config.phillipsSlope (- 0 @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (srpcHighY (math/clamp (- @entity.expectations (* @config.phillipsSlope (- @config.maxUnemployment @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (newCurves [
                { label: "SRPC", color: @config.srpcColor, samples: [ { x: 0, y: @srpcLowY }, { x: @config.maxUnemployment, y: @srpcHighY } ] },
                { label: "LRPC", color: @config.lrpcColor, samples: [ { x: @entity.naturalRate, y: @config.minInflation }, { x: @entity.naturalRate, y: @config.maxInflation } ] }
              ])
            (newPoints [
                { x: @entity.unemployment, y: @entity.inflation, label: "Economy", color: @config.economyColor, radius: 6 },
                { x: @entity.naturalRate, y: @entity.expectations, label: "Expected", color: @config.expectationsColor, radius: 5 }
              ])
          )
          (do
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: @config.shockStep }, label: (str/concat "Demand +" @config.shockStep), variant: primary, size: sm },
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: (- 0 @config.shockStep) }, label: (str/concat "Demand −" @config.shockStep), variant: secondary, size: sm },
                    { type: button, action: STEP_ADJUSTMENT, label: "Adjust Expectations", variant: primary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxUnemployment, yMin: @config.minInflation, yMax: @config.maxInflation, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Unemployment " (math/round @entity.unemployment 2) "% (natural rate " (math/round @entity.naturalRate 2) "%) — inflation " (math/round @entity.inflation 2) "%") },
                { type: typography, variant: body, content: (str/concat "Expected inflation " (math/round @entity.expectations 2) "% — phase: " @entity.phase) },
                { type: alert, variant: (if (== @entity.phase "Short run") "warning" "success"), message: (if (== @entity.phase "Short run") "Short run: the shock moved the economy along the SRPC — lower unemployment bought with higher inflation. Now press Adjust Expectations." "Long run: expectations have caught up, unemployment is back at the natural rate, and only inflation is higher — the LRPC is vertical, so there is no lasting tradeoff.") }
              ] }
          ]
        })
        (emit PHILLIPS_UPDATED { unemployment: @entity.unemployment, inflation: @entity.inflation, expectations: @entity.expectations, phase: @entity.phase })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.naturalRate @config.naturalRate)
        (set @entity.expectations @config.expectations)
        (set @entity.unemployment @config.naturalRate)
        (set @entity.inflation @config.expectations)
        (set @entity.phase "Long run")
        (let (
            (srpcLowY (math/clamp (- @entity.expectations (* @config.phillipsSlope (- 0 @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (srpcHighY (math/clamp (- @entity.expectations (* @config.phillipsSlope (- @config.maxUnemployment @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (newCurves [
                { label: "SRPC", color: @config.srpcColor, samples: [ { x: 0, y: @srpcLowY }, { x: @config.maxUnemployment, y: @srpcHighY } ] },
                { label: "LRPC", color: @config.lrpcColor, samples: [ { x: @entity.naturalRate, y: @config.minInflation }, { x: @entity.naturalRate, y: @config.maxInflation } ] }
              ])
            (newPoints [
                { x: @entity.unemployment, y: @entity.inflation, label: "Economy", color: @config.economyColor, radius: 6 },
                { x: @entity.naturalRate, y: @entity.expectations, label: "Expected", color: @config.expectationsColor, radius: 5 }
              ])
          )
          (do
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: @config.shockStep }, label: (str/concat "Demand +" @config.shockStep), variant: primary, size: sm },
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: (- 0 @config.shockStep) }, label: (str/concat "Demand −" @config.shockStep), variant: secondary, size: sm },
                    { type: button, action: STEP_ADJUSTMENT, label: "Adjust Expectations", variant: primary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxUnemployment, yMin: @config.minInflation, yMax: @config.maxInflation, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Unemployment " (math/round @entity.unemployment 2) "% (natural rate " (math/round @entity.naturalRate 2) "%) — inflation " (math/round @entity.inflation 2) "%") },
                { type: typography, variant: body, content: (str/concat "Expected inflation " (math/round @entity.expectations 2) "% — phase: " @entity.phase) },
                { type: alert, variant: (if (== @entity.phase "Short run") "warning" "success"), message: (if (== @entity.phase "Short run") "Short run: the shock moved the economy along the SRPC — lower unemployment bought with higher inflation. Now press Adjust Expectations." "Long run: expectations have caught up, unemployment is back at the natural rate, and only inflation is higher — the LRPC is vertical, so there is no lasting tradeoff.") }
              ] }
          ]
        })
        (emit PHILLIPS_UPDATED { unemployment: @entity.unemployment, inflation: @entity.inflation, expectations: @entity.expectations, phase: @entity.phase })

      APPLY_SHOCK -> idle when (== @entity.active true)
        (let (
            (newU (math/clamp (- @entity.unemployment ?delta) 0.5 @config.maxUnemployment))
            (newPi (math/clamp (- @entity.expectations (* @config.phillipsSlope (- @newU @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (srpcLowY (math/clamp (- @entity.expectations (* @config.phillipsSlope (- 0 @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (srpcHighY (math/clamp (- @entity.expectations (* @config.phillipsSlope (- @config.maxUnemployment @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (newCurves [
                { label: "SRPC", color: @config.srpcColor, samples: [ { x: 0, y: @srpcLowY }, { x: @config.maxUnemployment, y: @srpcHighY } ] },
                { label: "LRPC", color: @config.lrpcColor, samples: [ { x: @entity.naturalRate, y: @config.minInflation }, { x: @entity.naturalRate, y: @config.maxInflation } ] }
              ])
            (newPoints [
                { x: @newU, y: @newPi, label: "Economy", color: @config.economyColor, radius: 6 },
                { x: @entity.naturalRate, y: @entity.expectations, label: "Expected", color: @config.expectationsColor, radius: 5 }
              ])
          )
          (do
            (set @entity.unemployment @newU)
            (set @entity.inflation @newPi)
            (set @entity.phase "Short run")
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: @config.shockStep }, label: (str/concat "Demand +" @config.shockStep), variant: primary, size: sm },
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: (- 0 @config.shockStep) }, label: (str/concat "Demand −" @config.shockStep), variant: secondary, size: sm },
                    { type: button, action: STEP_ADJUSTMENT, label: "Adjust Expectations", variant: primary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxUnemployment, yMin: @config.minInflation, yMax: @config.maxInflation, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Unemployment " (math/round @entity.unemployment 2) "% (natural rate " (math/round @entity.naturalRate 2) "%) — inflation " (math/round @entity.inflation 2) "%") },
                { type: typography, variant: body, content: (str/concat "Expected inflation " (math/round @entity.expectations 2) "% — phase: " @entity.phase) },
                { type: alert, variant: (if (== @entity.phase "Short run") "warning" "success"), message: (if (== @entity.phase "Short run") "Short run: the shock moved the economy along the SRPC — lower unemployment bought with higher inflation. Now press Adjust Expectations." "Long run: expectations have caught up, unemployment is back at the natural rate, and only inflation is higher — the LRPC is vertical, so there is no lasting tradeoff.") }
              ] }
          ]
        })
        (emit PHILLIPS_UPDATED { unemployment: @entity.unemployment, inflation: @entity.inflation, expectations: @entity.expectations, phase: @entity.phase })

      STEP_ADJUSTMENT -> idle when (== @entity.active true)
        (let (
            (newExpect (math/clamp (+ @entity.expectations (* @config.adaptiveRate (- @entity.inflation @entity.expectations))) @config.minInflation @config.maxInflation))
            (newU @entity.naturalRate)
            (newPi @newExpect)
            (converged (< (math/abs (- @newExpect @entity.expectations)) 0.0001))
            (srpcLowY (math/clamp (- @newExpect (* @config.phillipsSlope (- 0 @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (srpcHighY (math/clamp (- @newExpect (* @config.phillipsSlope (- @config.maxUnemployment @entity.naturalRate))) @config.minInflation @config.maxInflation))
            (newCurves [
                { label: "SRPC", color: @config.srpcColor, samples: [ { x: 0, y: @srpcLowY }, { x: @config.maxUnemployment, y: @srpcHighY } ] },
                { label: "LRPC", color: @config.lrpcColor, samples: [ { x: @entity.naturalRate, y: @config.minInflation }, { x: @entity.naturalRate, y: @config.maxInflation } ] }
              ])
            (newPoints [
                { x: @newU, y: @newPi, label: "Economy", color: @config.economyColor, radius: 6 },
                { x: @entity.naturalRate, y: @newExpect, label: "Expected", color: @config.expectationsColor, radius: 5 }
              ])
          )
          (do
            (set @entity.expectations @newExpect)
            (set @entity.unemployment @newU)
            (set @entity.inflation @newPi)
            (set @entity.phase (if @converged "Long run" "Adjusting"))
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: @config.shockStep }, label: (str/concat "Demand +" @config.shockStep), variant: primary, size: sm },
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: (- 0 @config.shockStep) }, label: (str/concat "Demand −" @config.shockStep), variant: secondary, size: sm },
                    { type: button, action: STEP_ADJUSTMENT, label: "Adjust Expectations", variant: primary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxUnemployment, yMin: @config.minInflation, yMax: @config.maxInflation, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Unemployment " (math/round @entity.unemployment 2) "% (natural rate " (math/round @entity.naturalRate 2) "%) — inflation " (math/round @entity.inflation 2) "%") },
                { type: typography, variant: body, content: (str/concat "Expected inflation " (math/round @entity.expectations 2) "% — phase: " @entity.phase) },
                { type: alert, variant: (if (== @entity.phase "Short run") "warning" "success"), message: (if (== @entity.phase "Short run") "Short run: the shock moved the economy along the SRPC — lower unemployment bought with higher inflation. Now press Adjust Expectations." "Long run: expectations have caught up, unemployment is back at the natural rate, and only inflation is higher — the LRPC is vertical, so there is no lasting tradeoff.") }
              ] }
          ]
        })
        (emit PHILLIPS_UPDATED { unemployment: @entity.unemployment, inflation: @entity.inflation, expectations: @entity.expectations, phase: @entity.phase })

      RESET -> idle when (== @entity.active true)
        (let (
            (srpcLowY (math/clamp (- @config.expectations (* @config.phillipsSlope (- 0 @config.naturalRate))) @config.minInflation @config.maxInflation))
            (srpcHighY (math/clamp (- @config.expectations (* @config.phillipsSlope (- @config.maxUnemployment @config.naturalRate))) @config.minInflation @config.maxInflation))
            (newCurves [
                { label: "SRPC", color: @config.srpcColor, samples: [ { x: 0, y: @srpcLowY }, { x: @config.maxUnemployment, y: @srpcHighY } ] },
                { label: "LRPC", color: @config.lrpcColor, samples: [ { x: @config.naturalRate, y: @config.minInflation }, { x: @config.naturalRate, y: @config.maxInflation } ] }
              ])
            (newPoints [
                { x: @config.naturalRate, y: @config.expectations, label: "Economy", color: @config.economyColor, radius: 6 },
                { x: @config.naturalRate, y: @config.expectations, label: "Expected", color: @config.expectationsColor, radius: 5 }
              ])
          )
          (do
            (set @entity.naturalRate @config.naturalRate)
            (set @entity.expectations @config.expectations)
            (set @entity.unemployment @config.naturalRate)
            (set @entity.inflation @config.expectations)
            (set @entity.phase "Long run")
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: @config.shockStep }, label: (str/concat "Demand +" @config.shockStep), variant: primary, size: sm },
                    { type: button, action: APPLY_SHOCK, actionPayload: { delta: (- 0 @config.shockStep) }, label: (str/concat "Demand −" @config.shockStep), variant: secondary, size: sm },
                    { type: button, action: STEP_ADJUSTMENT, label: "Adjust Expectations", variant: primary, size: sm },
                    { type: button, action: RESET, label: "Reset", variant: ghost, size: sm }
                  ] },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxUnemployment, yMin: @config.minInflation, yMax: @config.maxInflation, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Unemployment " (math/round @entity.unemployment 2) "% (natural rate " (math/round @entity.naturalRate 2) "%) — inflation " (math/round @entity.inflation 2) "%") },
                { type: typography, variant: body, content: (str/concat "Expected inflation " (math/round @entity.expectations 2) "% — phase: " @entity.phase) },
                { type: alert, variant: (if (== @entity.phase "Short run") "warning" "success"), message: (if (== @entity.phase "Short run") "Short run: the shock moved the economy along the SRPC — lower unemployment bought with higher inflation. Now press Adjust Expectations." "Long run: expectations have caught up, unemployment is back at the natural rate, and only inflation is higher — the LRPC is vertical, so there is no lasting tradeoff.") }
              ] }
          ]
        })
        (emit PHILLIPS_UPDATED { unemployment: @entity.unemployment, inflation: @entity.inflation, expectations: @entity.expectations, phase: @entity.phase })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      APPLY_SHOCK {
        delta : number
      }
        @description "Learner pressed a Demand +/- button; a positive delta is an expansionary demand shock that lowers unemployment along the SRPC."
        @tier "domain"
      STEP_ADJUSTMENT {
      }
        @description "Learner pressed Adjust Expectations — expected inflation adapts toward actual inflation and unemployment returns to the natural rate."
        @tier "domain"
      RESET {
      }
        @description "Learner pressed Reset — restores the configured natural rate and expected inflation."
        @tier "domain"
    }

    emits {
      PHILLIPS_UPDATED -> external {
        unemployment : number
        inflation : number
        expectations : number
        phase : string
      }
        @description "The Phillips-curve state after each learner action — a composed listener (readout, chart, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "phillips curve, inflation, unemployment, natural rate, NAIRU, adaptive expectations, stagflation, long-run phillips curve, SRPC, LRPC"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Phillips Curve"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 440
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      gridStep : number = 2
        @label "Grid Step"
        @description "Spacing between gridlines on the canvas, in percentage points."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      naturalRate : number = 5
        @label "Natural Rate"
        @description "The natural rate of unemployment (percent) — where the vertical long-run Phillips curve sits and where unemployment returns once expectations adjust."
        @synonyms "natural rate of unemployment, NAIRU, full employment, long-run equilibrium unemployment"
        @tier "domain"
      expectations : number = 2
        @label "Expected Inflation"
        @description "Initial expected inflation (percent); the SRPC crosses the natural rate at this inflation rate."
        @synonyms "expected inflation, inflation expectations, adaptive expectations"
        @tier "domain"
      shockStep : number = 1
        @label "Shock Step"
        @description "Percentage points of unemployment the Demand +/- buttons move the economy per press."
        @synonyms "demand shock, aggregate demand shock, policy stimulus"
        @tier "domain"
      adaptiveRate : number = 0.5
        @label "Adaptive Rate"
        @description "Fraction of the inflation surprise (actual − expected) folded into expected inflation on each adjustment step."
        @synonyms "adaptive expectations rate, expectations adjustment speed, learning rate"
        @tier "domain"
      phillipsSlope : number = 1
        @label "Phillips Slope"
        @description "How much inflation rises per point unemployment falls below the natural rate (the SRPC's slope magnitude)."
        @synonyms "phillips curve slope, sacrifice ratio, inflation sensitivity"
        @tier "domain"
      maxUnemployment : number = 10
        @label "Max Unemployment (axis)"
        @description "Right edge of the unemployment axis, in percent."
        @tier "presentation"
      minInflation : number = -4
        @label "Min Inflation (axis)"
        @description "Bottom edge of the inflation axis, in percent (allows deflation)."
        @tier "presentation"
      maxInflation : number = 10
        @label "Max Inflation (axis)"
        @description "Top edge of the inflation axis, in percent."
        @tier "presentation"
      srpcColor : string = "#2563eb"
        @label "SRPC Color"
        @tier "presentation"
      lrpcColor : string = "#dc2626"
        @label "LRPC Color"
        @tier "presentation"
      economyColor : string = "#16a34a"
        @label "Economy Marker Color"
        @tier "presentation"
      expectationsColor : string = "#9333ea"
        @label "Expectations Marker Color"
        @tier "presentation"
    }
  }

  page "/econ-phillips" as EconPhillipsPage -> EconPhillipsSim
}
