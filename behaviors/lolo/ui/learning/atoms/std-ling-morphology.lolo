app std-ling-morphology "1.0.0"
"Morpheme tree builder — the learner attaches morphemes from a bank one at a time under order and category constraints (prefixes before the root, suffixes after, exactly one root), gets a validity verdict per attachment, and can check the built word against a gloss table; the growing word renders as a labelled tree on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital LingMorphologyOrbital {
  type LingMorphologyShapePoint = {
    x : number!
    y : number!
  }
  type LingMorphologyShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LingMorphologyShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type LingMorphologyMorpheme = {
    form : string!
    category : "prefix" | "root" | "suffix"!
    gloss : string
  }
  type LingMorphologyGlossEntry = {
    morphemes : [string]!
    meaning : string!
  }

  entity LingMorphologyScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    renderChildren : [json]
    shapes : [LingMorphologyShape]
    attached : [string]
    verdict : string
    checkResult : string
  }

  trait LingMorphologySim -> @rebindable LingMorphologyScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.attached [])
        (set @entity.verdict "Attach a morpheme below to start building a word.")
        (set @entity.checkResult "")
        (set @entity.shapes [])
        (set @entity.renderChildren [
          { type: typography, variant: h4, content: @entity.title },
          { type: typography, variant: body, content: "Build a word by attaching morphemes in legal order — prefixes before the root, suffixes after it, exactly one root." },
          { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
          { type: typography, variant: body, content: @entity.verdict },
          { type: stack, direction: horizontal, gap: xs, children: (array/map @config.morphemeBank (fn m { type: button, action: ATTACH_MORPHEME, actionPayload: { form: (object/get @m form) }, label: (str/concat (object/get @m form) " (" (object/get @m category) ")"), variant: secondary, size: sm })) },
          { type: stack, direction: horizontal, gap: sm, children: [
              { type: button, action: REMOVE, label: "Remove Last", variant: ghost },
              { type: button, action: CHECK_WORD, label: "Check Word", variant: primary },
              { type: button, action: RESET, label: "Reset", variant: ghost }
            ] },
          { type: typography, variant: body, content: @entity.checkResult }
        ])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.attached [])
        (set @entity.verdict "Attach a morpheme below to start building a word.")
        (set @entity.checkResult "")
        (set @entity.shapes [])
        (set @entity.renderChildren [
          { type: typography, variant: h4, content: @entity.title },
          { type: typography, variant: body, content: "Build a word by attaching morphemes in legal order — prefixes before the root, suffixes after it, exactly one root." },
          { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
          { type: typography, variant: body, content: @entity.verdict },
          { type: stack, direction: horizontal, gap: xs, children: (array/map @config.morphemeBank (fn m { type: button, action: ATTACH_MORPHEME, actionPayload: { form: (object/get @m form) }, label: (str/concat (object/get @m form) " (" (object/get @m category) ")"), variant: secondary, size: sm })) },
          { type: stack, direction: horizontal, gap: sm, children: [
              { type: button, action: REMOVE, label: "Remove Last", variant: ghost },
              { type: button, action: CHECK_WORD, label: "Check Word", variant: primary },
              { type: button, action: RESET, label: "Reset", variant: ghost }
            ] },
          { type: typography, variant: body, content: @entity.checkResult }
        ])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })

      ATTACH_MORPHEME -> idle when (== @entity.active true)
        (let (
            (morpheme (array/find @config.morphemeBank (fn m (== (object/get @m form) ?form))))
            (found (!= @morpheme null))
            (cat (if @found (object/get @morpheme category) "suffix"))
            (orderLen (array/len @config.orderRules))
            (newRank (array/reduce (array/range @orderLen) 0 (fn acc i (if (== (array/nth @config.orderRules @i) @cat) @i @acc))))
            (attachedCount (array/len @entity.attached))
            (lastForm (if (> @attachedCount 0) (array/nth @entity.attached (- @attachedCount 1)) ""))
            (lastMorph (array/find @config.morphemeBank (fn m (== (object/get @m form) @lastForm))))
            (lastCat (if (!= @lastMorph null) (object/get @lastMorph category) ""))
            (lastRank (if (> @attachedCount 0) (array/reduce (array/range @orderLen) 0 (fn acc i (if (== (array/nth @config.orderRules @i) @lastCat) @i @acc))) 0))
            (rootCount (array/len (array/filter @entity.attached (fn f (== (object/get (array/find @config.morphemeBank (fn m (== (object/get @m form) @f))) category) "root")))))
            (orderOk (>= @newRank @lastRank))
            (rootOk (or (!= @cat "root") (== @rootCount 0)))
            (valid (and @found (and @orderOk @rootOk)))
            (newAttached (if @valid (array/append @entity.attached ?form) @entity.attached))
            (verdictText (if (not @found)
                "That morpheme is not in the bank."
                (if (not @rootOk)
                  (str/concat "Cannot attach " ?form " — the word already has a root; every word has exactly one.")
                  (if (not @orderOk)
                    (str/concat "Cannot attach " ?form " (" @cat ") after " @lastForm " (" @lastCat ") — morpheme order is " (str/join @config.orderRules " → ") ".")
                    (str/concat "Attached " ?form " (" @cat ") — \"" (object/get @morpheme gloss) "\". Order is legal.")))))
            (wordShapes (array/flatten (array/map (array/range (array/len @newAttached)) (fn idx (let (
                    (f (array/nth @newAttached @idx))
                    (m (array/find @config.morphemeBank (fn mm (== (object/get @mm form) @f))))
                    (mc (object/get @m category))
                    (bx (+ @config.morphLeft (* @idx @config.morphSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "mr" @idx), x: @bx, y: @config.wordRowY, width: @config.morphWidth, height: 40, color: @config.morphBorderColor, fill: (if (== @mc "prefix") @config.prefixFill (if (== @mc "root") @config.rootFill @config.suffixFill)) },
                    { type: "text", id: (str/concat "mt" @idx), x: (+ @bx (/ @config.morphWidth 2)), y: (+ @config.wordRowY 25), text: @f, fontSize: @config.morphFontSize, align: "center", color: @config.morphTextColor },
                    { type: "text", id: (str/concat "mc" @idx), x: (+ @bx (/ @config.morphWidth 2)), y: (+ @config.wordRowY 58), text: @mc, fontSize: @config.catFontSize, align: "center", color: @config.catColor },
                    { type: "line", id: (str/concat "ml" @idx), x1: (+ @bx (/ @config.morphWidth 2)), y1: @config.wordRowY, x2: (+ @bx (/ @config.morphWidth 2)), y2: @config.topBarY, color: @config.treeLineColor, lineWidth: 1.5 }
                  ]
                )))))
            (midX (+ @config.morphLeft (/ (+ @config.morphWidth (* (- (array/len @newAttached) 1) @config.morphSpacing)) 2)))
            (topBar (if (> (array/len @newAttached) 0)
                [
                  { type: "line", id: "wbar", x1: (+ @config.morphLeft (/ @config.morphWidth 2)), y1: @config.topBarY, x2: (+ @config.morphLeft (* (- (array/len @newAttached) 1) @config.morphSpacing) (/ @config.morphWidth 2)), y2: @config.topBarY, color: @config.treeLineColor, lineWidth: 2 },
                  { type: "text", id: "wlbl", x: @midX, y: (- @config.topBarY 12), text: (str/concat "Word: " (str/join @newAttached "")), fontSize: @config.morphFontSize, align: "center", color: @config.morphTextColor }
                ]
                []))
            (allShapes (array/concat @topBar @wordShapes))
          )
          (do
            (set @entity.attached @newAttached)
            (set @entity.verdict @verdictText)
            (set @entity.checkResult "")
            (set @entity.shapes @allShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Build a word by attaching morphemes in legal order — prefixes before the root, suffixes after it, exactly one root." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: body, content: @entity.verdict },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.morphemeBank (fn m { type: button, action: ATTACH_MORPHEME, actionPayload: { form: (object/get @m form) }, label: (str/concat (object/get @m form) " (" (object/get @m category) ")"), variant: secondary, size: sm })) },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: REMOVE, label: "Remove Last", variant: ghost },
                  { type: button, action: CHECK_WORD, label: "Check Word", variant: primary },
                  { type: button, action: RESET, label: "Reset", variant: ghost }
                ] },
              { type: typography, variant: body, content: @entity.checkResult }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit MORPHOLOGY_UPDATED { attached: @entity.attached, word: (str/join @entity.attached ""), verdict: @entity.verdict, checkResult: @entity.checkResult })

      REMOVE -> idle when (== @entity.active true)
        (let (
            (attachedCount (array/len @entity.attached))
            (newAttached (if (> @attachedCount 0) (array/take @entity.attached (- @attachedCount 1)) @entity.attached))
            (verdictText (if (> @attachedCount 0) (str/concat "Removed " (array/nth @entity.attached (- @attachedCount 1)) ".") "Nothing to remove — the word is empty."))
            (wordShapes (array/flatten (array/map (array/range (array/len @newAttached)) (fn idx (let (
                    (f (array/nth @newAttached @idx))
                    (m (array/find @config.morphemeBank (fn mm (== (object/get @mm form) @f))))
                    (mc (object/get @m category))
                    (bx (+ @config.morphLeft (* @idx @config.morphSpacing)))
                  )
                  [
                    { type: "rect", id: (str/concat "mr" @idx), x: @bx, y: @config.wordRowY, width: @config.morphWidth, height: 40, color: @config.morphBorderColor, fill: (if (== @mc "prefix") @config.prefixFill (if (== @mc "root") @config.rootFill @config.suffixFill)) },
                    { type: "text", id: (str/concat "mt" @idx), x: (+ @bx (/ @config.morphWidth 2)), y: (+ @config.wordRowY 25), text: @f, fontSize: @config.morphFontSize, align: "center", color: @config.morphTextColor },
                    { type: "text", id: (str/concat "mc" @idx), x: (+ @bx (/ @config.morphWidth 2)), y: (+ @config.wordRowY 58), text: @mc, fontSize: @config.catFontSize, align: "center", color: @config.catColor },
                    { type: "line", id: (str/concat "ml" @idx), x1: (+ @bx (/ @config.morphWidth 2)), y1: @config.wordRowY, x2: (+ @bx (/ @config.morphWidth 2)), y2: @config.topBarY, color: @config.treeLineColor, lineWidth: 1.5 }
                  ]
                )))))
            (midX (+ @config.morphLeft (/ (+ @config.morphWidth (* (- (array/len @newAttached) 1) @config.morphSpacing)) 2)))
            (topBar (if (> (array/len @newAttached) 0)
                [
                  { type: "line", id: "wbar", x1: (+ @config.morphLeft (/ @config.morphWidth 2)), y1: @config.topBarY, x2: (+ @config.morphLeft (* (- (array/len @newAttached) 1) @config.morphSpacing) (/ @config.morphWidth 2)), y2: @config.topBarY, color: @config.treeLineColor, lineWidth: 2 },
                  { type: "text", id: "wlbl", x: @midX, y: (- @config.topBarY 12), text: (str/concat "Word: " (str/join @newAttached "")), fontSize: @config.morphFontSize, align: "center", color: @config.morphTextColor }
                ]
                []))
            (allShapes (array/concat @topBar @wordShapes))
          )
          (do
            (set @entity.attached @newAttached)
            (set @entity.verdict @verdictText)
            (set @entity.checkResult "")
            (set @entity.shapes @allShapes)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Build a word by attaching morphemes in legal order — prefixes before the root, suffixes after it, exactly one root." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: body, content: @entity.verdict },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.morphemeBank (fn m { type: button, action: ATTACH_MORPHEME, actionPayload: { form: (object/get @m form) }, label: (str/concat (object/get @m form) " (" (object/get @m category) ")"), variant: secondary, size: sm })) },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: REMOVE, label: "Remove Last", variant: ghost },
                  { type: button, action: CHECK_WORD, label: "Check Word", variant: primary },
                  { type: button, action: RESET, label: "Reset", variant: ghost }
                ] },
              { type: typography, variant: body, content: @entity.checkResult }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit MORPHOLOGY_UPDATED { attached: @entity.attached, word: (str/join @entity.attached ""), verdict: @entity.verdict, checkResult: @entity.checkResult })

      CHECK_WORD -> idle when (== @entity.active true)
        (let (
            (wordStr (str/join @entity.attached ""))
            (entry (array/find @config.glossTable (fn e (== (str/join (object/get @e morphemes) "") @wordStr))))
            (resultText (if (== (array/len @entity.attached) 0)
                "Attach some morphemes first."
                (if (!= @entry null)
                  (str/concat "✓ \"" @wordStr "\" is a real word — " (object/get @entry meaning) ".")
                  (str/concat "✗ \"" @wordStr "\" is not in the gloss table — the order may be legal, but this combination is not an attested word."))))
          )
          (do
            (set @entity.checkResult @resultText)
            (set @entity.renderChildren [
              { type: typography, variant: h4, content: @entity.title },
              { type: typography, variant: body, content: "Build a word by attaching morphemes in legal order — prefixes before the root, suffixes after it, exactly one root." },
              { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
              { type: typography, variant: body, content: @entity.verdict },
              { type: stack, direction: horizontal, gap: xs, children: (array/map @config.morphemeBank (fn m { type: button, action: ATTACH_MORPHEME, actionPayload: { form: (object/get @m form) }, label: (str/concat (object/get @m form) " (" (object/get @m category) ")"), variant: secondary, size: sm })) },
              { type: stack, direction: horizontal, gap: sm, children: [
                  { type: button, action: REMOVE, label: "Remove Last", variant: ghost },
                  { type: button, action: CHECK_WORD, label: "Check Word", variant: primary },
                  { type: button, action: RESET, label: "Reset", variant: ghost }
                ] },
              { type: typography, variant: body, content: @entity.checkResult }
            ])
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit MORPHOLOGY_UPDATED { attached: @entity.attached, word: (str/join @entity.attached ""), verdict: @entity.verdict, checkResult: @entity.checkResult })

      RESET -> idle when (== @entity.active true)
        (set @entity.attached [])
        (set @entity.verdict "Attach a morpheme below to start building a word.")
        (set @entity.checkResult "")
        (set @entity.shapes [])
        (set @entity.renderChildren [
          { type: typography, variant: h4, content: @entity.title },
          { type: typography, variant: body, content: "Build a word by attaching morphemes in legal order — prefixes before the root, suffixes after it, exactly one root." },
          { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.width, yMin: 0, yMax: @config.height, showAxes: false, showGrid: false, gridStep: 1, curves: [], points: [], vectors: [], shapes: @entity.shapes, interactive: @config.interactive, animate: false },
          { type: typography, variant: body, content: @entity.verdict },
          { type: stack, direction: horizontal, gap: xs, children: (array/map @config.morphemeBank (fn m { type: button, action: ATTACH_MORPHEME, actionPayload: { form: (object/get @m form) }, label: (str/concat (object/get @m form) " (" (object/get @m category) ")"), variant: secondary, size: sm })) },
          { type: stack, direction: horizontal, gap: sm, children: [
              { type: button, action: REMOVE, label: "Remove Last", variant: ghost },
              { type: button, action: CHECK_WORD, label: "Check Word", variant: primary },
              { type: button, action: RESET, label: "Reset", variant: ghost }
            ] },
          { type: typography, variant: body, content: @entity.checkResult }
        ])
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: @entity.renderChildren }
          ]
        })
        (emit MORPHOLOGY_UPDATED { attached: @entity.attached, word: "", verdict: @entity.verdict, checkResult: @entity.checkResult })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      ATTACH_MORPHEME {
        form : string
      }
        @description "Learner attached a morpheme from the bank to the right edge of the growing word; the attachment is judged against the order and category constraints."
        @tier "domain"
      REMOVE {
      }
        @description "Learner removed the most recently attached morpheme from the word."
        @tier "domain"
      CHECK_WORD {
      }
        @description "Learner asked whether the built sequence is an attested word; the concatenated forms are looked up in the gloss table."
        @tier "domain"
      RESET {
      }
        @description "Learner cleared the word back to empty, removing every attached morpheme."
        @tier "domain"
    }

    emits {
      MORPHOLOGY_UPDATED -> external {
        attached : [string]
        word : string
        verdict : string
        checkResult : string
      }
        @description "The word-builder state after each learner action — a composed listener (readout, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "morphology update, morpheme attached, word built, gloss check"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Morpheme Tree Builder"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      morphemeBank : [LingMorphologyMorpheme] = [
        { form: "un", category: prefix, gloss: "not" },
        { form: "re", category: prefix, gloss: "again" },
        { form: "happy", category: root, gloss: "joyful" },
        { form: "tie", category: root, gloss: "fasten" },
        { form: "kind", category: root, gloss: "benevolent" },
        { form: "ness", category: suffix, gloss: "state or quality of" },
        { form: "ly", category: suffix, gloss: "in the manner of" }
      ]
        @label "Morpheme Bank"
        @description "The morphemes the learner can attach. Each carries its written form, its category (prefix, root, or suffix), and a gloss shown on attachment."
        @synonyms "morphemes, affixes, prefix, suffix, root, free morpheme, bound morpheme"
        @tier "domain"
      orderRules : [string] = ["prefix", "root", "suffix"]
        @label "Order Rules"
        @description "The legal left-to-right order of morpheme categories. An attachment is valid only if its category is not earlier in this list than the category of the previous morpheme — and a root is valid only if no root is attached yet."
        @synonyms "morpheme order, affix ordering, word structure rule, morphotactics"
        @tier "domain"
      glossTable : [LingMorphologyGlossEntry] = [
        { morphemes: ["un", "happy"], meaning: "not happy" },
        { morphemes: ["un", "happy", "ness"], meaning: "the state of not being happy" },
        { morphemes: ["re", "tie"], meaning: "fasten again" },
        { morphemes: ["un", "tie"], meaning: "reverse the fastening of" },
        { morphemes: ["un", "kind"], meaning: "not kind" },
        { morphemes: ["kind", "ness"], meaning: "the quality of being kind" },
        { morphemes: ["kind", "ly"], meaning: "in a kind manner" },
        { morphemes: ["happy", "ness"], meaning: "the state of being happy" }
      ]
        @label "Gloss Table"
        @description "Attested word combinations the Check Word button looks up. Each entry lists the exact morpheme sequence and its meaning — a sequence can be order-legal yet absent here, teaching that legality and attestation differ."
        @synonyms "gloss, word list, lexicon, attested words, morpheme combination"
        @tier "domain"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 260
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      morphLeft : number = 60
        @label "First Morpheme X (px)"
        @tier "presentation"
      morphSpacing : number = 130
        @label "Morpheme Spacing (px)"
        @tier "presentation"
      morphWidth : number = 100
        @label "Morpheme Box Width (px)"
        @tier "presentation"
      wordRowY : number = 150
        @label "Word Row Y (px)"
        @tier "presentation"
      topBarY : number = 70
        @label "Word Bar Y (px)"
        @tier "presentation"
      morphFontSize : number = 18
        @label "Morpheme Font Size"
        @tier "presentation"
      catFontSize : number = 12
        @label "Category Font Size"
        @tier "presentation"
      morphBorderColor : string = "#334155"
        @label "Morpheme Border Color"
        @tier "presentation"
      morphTextColor : string = "#0f172a"
        @label "Morpheme Text Color"
        @tier "presentation"
      catColor : string = "#64748b"
        @label "Category Text Color"
        @tier "presentation"
      treeLineColor : string = "#94a3b8"
        @label "Tree Line Color"
        @tier "presentation"
      prefixFill : string = "#dbeafe"
        @label "Prefix Fill Color"
        @tier "presentation"
      rootFill : string = "#dcfce7"
        @label "Root Fill Color"
        @tier "presentation"
      suffixFill : string = "#fef3c7"
        @label "Suffix Fill Color"
        @tier "presentation"
    }
  }

  page "/ling-morphology" as LingMorphologyPage -> LingMorphologySim
}
