app std-econ-market "1.0.0"
"Supply-and-demand market engine — the learner shifts demand/supply curve intercepts and sets a price to see surplus or shortage emerge against the computed equilibrium, on a math-canvas. Standalone by default; behind a lab router set matchMode and it renders only when MODE_SELECTED matches."
orbital EconMarketOrbital {
  type EconMarketSample = {
    x : number!
    y : number!
  }
  type EconMarketCurve = {
    label : string
    color : string
    samples : [EconMarketSample]!
  }
  type EconMarketMarker = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }

  entity EconMarketScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    demandIntercept : number
    demandSlope : number
    supplyIntercept : number
    supplySlope : number
    price : number
    equilibriumPrice : number
    equilibriumQuantity : number
    qDemanded : number
    qSupplied : number
    marketStatusLabel : string
    marketStatusMagnitude : number
    curves : [EconMarketCurve]
    points : [EconMarketMarker]
  }

  trait EconMarketSim -> @rebindable EconMarketScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when (== @config.matchMode "")
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.demandIntercept @config.demandIntercept)
        (set @entity.demandSlope @config.demandSlope)
        (set @entity.supplyIntercept @config.supplyIntercept)
        (set @entity.supplySlope @config.supplySlope)
        (set @entity.price @config.initialPrice)
        (let (
            (eqQ (/ (- @entity.demandIntercept @entity.supplyIntercept) (+ @entity.demandSlope @entity.supplySlope)))
            (eqP (- @entity.demandIntercept (* @entity.demandSlope @eqQ)))
            (qd (math/max 0 (/ (- @entity.demandIntercept @entity.price) @entity.demandSlope)))
            (qs (math/max 0 (/ (- @entity.price @entity.supplyIntercept) @entity.supplySlope)))
            (gapVal (- @qs @qd))
            (statusLabel (if (> @gapVal 0.0001) "Surplus" (if (< @gapVal -0.0001) "Shortage" "Equilibrium")))
            (statusMag (math/abs @gapVal))
            (demandZeroQ (math/min @config.maxQuantity (/ @entity.demandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @entity.demandIntercept (* @entity.demandSlope @demandZeroQ))))
            (supplyEndQ @config.maxQuantity)
            (supplyEndP (+ @entity.supplyIntercept (* @entity.supplySlope @supplyEndQ)))
            (marketCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @entity.demandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Supply", color: @config.supplyColor, samples: [ { x: 0, y: @entity.supplyIntercept }, { x: @supplyEndQ, y: @supplyEndP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] }
              ])
            (marketPoints [
                { x: @eqQ, y: @eqP, label: "Equilibrium", color: @config.equilibriumColor, radius: 6 },
                { x: @qd, y: @entity.price, label: "Qd", color: @config.demandColor, radius: 5 },
                { x: @qs, y: @entity.price, label: "Qs", color: @config.supplyColor, radius: 5 }
              ])
          )
          (do
            (set @entity.equilibriumQuantity @eqQ)
            (set @entity.equilibriumPrice @eqP)
            (set @entity.qDemanded @qd)
            (set @entity.qSupplied @qs)
            (set @entity.marketStatusLabel @statusLabel)
            (set @entity.marketStatusMagnitude @statusMag)
            (set @entity.curves @marketCurves)
            (set @entity.points @marketPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: @config.supplyShiftStep }, label: (str/concat "Supply +" @config.supplyShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: (- 0 @config.supplyShiftStep) }, label: (str/concat "Supply −" @config.supplyShiftStep), variant: secondary, size: sm }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Equilibrium — price $" (math/round @entity.equilibriumPrice 2) ", quantity " (math/round @entity.equilibriumQuantity 2)) },
                { type: typography, variant: body, content: (str/concat "At your price — quantity demanded " (math/round @entity.qDemanded 2) ", quantity supplied " (math/round @entity.qSupplied 2)) },
                { type: alert, variant: (if (== @entity.marketStatusLabel "Surplus") "warning" (if (== @entity.marketStatusLabel "Shortage") "error" "success")), message: (if (== @entity.marketStatusLabel "Equilibrium") "At equilibrium — quantity demanded equals quantity supplied." (str/concat @entity.marketStatusLabel " of " (math/round @entity.marketStatusMagnitude 2) " units — price " (if (== @entity.marketStatusLabel "Surplus") "above" "below") " equilibrium, so the market adjusts toward it.")) }
              ] }
          ]
        })

      MODE_SELECTED -> idle when (== ?mode @config.matchMode)
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.demandIntercept @config.demandIntercept)
        (set @entity.demandSlope @config.demandSlope)
        (set @entity.supplyIntercept @config.supplyIntercept)
        (set @entity.supplySlope @config.supplySlope)
        (set @entity.price @config.initialPrice)
        (let (
            (eqQ (/ (- @entity.demandIntercept @entity.supplyIntercept) (+ @entity.demandSlope @entity.supplySlope)))
            (eqP (- @entity.demandIntercept (* @entity.demandSlope @eqQ)))
            (qd (math/max 0 (/ (- @entity.demandIntercept @entity.price) @entity.demandSlope)))
            (qs (math/max 0 (/ (- @entity.price @entity.supplyIntercept) @entity.supplySlope)))
            (gapVal (- @qs @qd))
            (statusLabel (if (> @gapVal 0.0001) "Surplus" (if (< @gapVal -0.0001) "Shortage" "Equilibrium")))
            (statusMag (math/abs @gapVal))
            (demandZeroQ (math/min @config.maxQuantity (/ @entity.demandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @entity.demandIntercept (* @entity.demandSlope @demandZeroQ))))
            (supplyEndQ @config.maxQuantity)
            (supplyEndP (+ @entity.supplyIntercept (* @entity.supplySlope @supplyEndQ)))
            (marketCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @entity.demandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Supply", color: @config.supplyColor, samples: [ { x: 0, y: @entity.supplyIntercept }, { x: @supplyEndQ, y: @supplyEndP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] }
              ])
            (marketPoints [
                { x: @eqQ, y: @eqP, label: "Equilibrium", color: @config.equilibriumColor, radius: 6 },
                { x: @qd, y: @entity.price, label: "Qd", color: @config.demandColor, radius: 5 },
                { x: @qs, y: @entity.price, label: "Qs", color: @config.supplyColor, radius: 5 }
              ])
          )
          (do
            (set @entity.equilibriumQuantity @eqQ)
            (set @entity.equilibriumPrice @eqP)
            (set @entity.qDemanded @qd)
            (set @entity.qSupplied @qs)
            (set @entity.marketStatusLabel @statusLabel)
            (set @entity.marketStatusMagnitude @statusMag)
            (set @entity.curves @marketCurves)
            (set @entity.points @marketPoints)
          )
        )
        (render-ui main {
            type: box
            padding: md
            children: [
              { type: stack, direction: vertical, gap: md, children: [
                  { type: typography, variant: h4, content: @entity.title },
                  { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                  { type: stack, direction: horizontal, gap: sm, children: [
                      { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                      { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                      { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: @config.supplyShiftStep }, label: (str/concat "Supply +" @config.supplyShiftStep), variant: primary, size: sm },
                      { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: (- 0 @config.supplyShiftStep) }, label: (str/concat "Supply −" @config.supplyShiftStep), variant: secondary, size: sm }
                    ] },
                  { type: stack, direction: vertical, gap: xs, children: [
                      { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                      { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                    ] },
                  { type: divider },
                  { type: typography, variant: body, content: (str/concat "Equilibrium — price $" (math/round @entity.equilibriumPrice 2) ", quantity " (math/round @entity.equilibriumQuantity 2)) },
                  { type: typography, variant: body, content: (str/concat "At your price — quantity demanded " (math/round @entity.qDemanded 2) ", quantity supplied " (math/round @entity.qSupplied 2)) },
                  { type: alert, variant: (if (== @entity.marketStatusLabel "Surplus") "warning" (if (== @entity.marketStatusLabel "Shortage") "error" "success")), message: (if (== @entity.marketStatusLabel "Equilibrium") "At equilibrium — quantity demanded equals quantity supplied." (str/concat @entity.marketStatusLabel " of " (math/round @entity.marketStatusMagnitude 2) " units — price " (if (== @entity.marketStatusLabel "Surplus") "above" "below") " equilibrium, so the market adjusts toward it.")) }
                ] }
            ]
        })

      SHIFT_DEMAND -> idle when (== @entity.active true)
        (let (
            (newDemandIntercept (math/max (+ @entity.supplyIntercept 1) (math/min (* @config.maxPrice 3) (+ @entity.demandIntercept ?delta))))
            (eqQ (/ (- @newDemandIntercept @entity.supplyIntercept) (+ @entity.demandSlope @entity.supplySlope)))
            (eqP (- @newDemandIntercept (* @entity.demandSlope @eqQ)))
            (qd (math/max 0 (/ (- @newDemandIntercept @entity.price) @entity.demandSlope)))
            (qs (math/max 0 (/ (- @entity.price @entity.supplyIntercept) @entity.supplySlope)))
            (gapVal (- @qs @qd))
            (statusLabel (if (> @gapVal 0.0001) "Surplus" (if (< @gapVal -0.0001) "Shortage" "Equilibrium")))
            (statusMag (math/abs @gapVal))
            (demandZeroQ (math/min @config.maxQuantity (/ @newDemandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @newDemandIntercept (* @entity.demandSlope @demandZeroQ))))
            (supplyEndQ @config.maxQuantity)
            (supplyEndP (+ @entity.supplyIntercept (* @entity.supplySlope @supplyEndQ)))
            (newCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @newDemandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Supply", color: @config.supplyColor, samples: [ { x: 0, y: @entity.supplyIntercept }, { x: @supplyEndQ, y: @supplyEndP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] }
              ])
            (newPoints [
                { x: @eqQ, y: @eqP, label: "Equilibrium", color: @config.equilibriumColor, radius: 6 },
                { x: @qd, y: @entity.price, label: "Qd", color: @config.demandColor, radius: 5 },
                { x: @qs, y: @entity.price, label: "Qs", color: @config.supplyColor, radius: 5 }
              ])
          )
          (do
            (set @entity.demandIntercept @newDemandIntercept)
            (set @entity.equilibriumQuantity @eqQ)
            (set @entity.equilibriumPrice @eqP)
            (set @entity.qDemanded @qd)
            (set @entity.qSupplied @qs)
            (set @entity.marketStatusLabel @statusLabel)
            (set @entity.marketStatusMagnitude @statusMag)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: @config.supplyShiftStep }, label: (str/concat "Supply +" @config.supplyShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: (- 0 @config.supplyShiftStep) }, label: (str/concat "Supply −" @config.supplyShiftStep), variant: secondary, size: sm }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Equilibrium — price $" (math/round @entity.equilibriumPrice 2) ", quantity " (math/round @entity.equilibriumQuantity 2)) },
                { type: typography, variant: body, content: (str/concat "At your price — quantity demanded " (math/round @entity.qDemanded 2) ", quantity supplied " (math/round @entity.qSupplied 2)) },
                { type: alert, variant: (if (== @entity.marketStatusLabel "Surplus") "warning" (if (== @entity.marketStatusLabel "Shortage") "error" "success")), message: (if (== @entity.marketStatusLabel "Equilibrium") "At equilibrium — quantity demanded equals quantity supplied." (str/concat @entity.marketStatusLabel " of " (math/round @entity.marketStatusMagnitude 2) " units — price " (if (== @entity.marketStatusLabel "Surplus") "above" "below") " equilibrium, so the market adjusts toward it.")) }
              ] }
          ]
        })
        (emit MARKET_UPDATED { price: @entity.price, qDemanded: @entity.qDemanded, qSupplied: @entity.qSupplied, equilibriumPrice: @entity.equilibriumPrice, equilibriumQuantity: @entity.equilibriumQuantity, status: @entity.marketStatusLabel })

      SHIFT_SUPPLY -> idle when (== @entity.active true)
        (let (
            (newSupplyIntercept (math/max 0 (math/min (- @entity.demandIntercept 1) (+ @entity.supplyIntercept ?delta))))
            (eqQ (/ (- @entity.demandIntercept @newSupplyIntercept) (+ @entity.demandSlope @entity.supplySlope)))
            (eqP (- @entity.demandIntercept (* @entity.demandSlope @eqQ)))
            (qd (math/max 0 (/ (- @entity.demandIntercept @entity.price) @entity.demandSlope)))
            (qs (math/max 0 (/ (- @entity.price @newSupplyIntercept) @entity.supplySlope)))
            (gapVal (- @qs @qd))
            (statusLabel (if (> @gapVal 0.0001) "Surplus" (if (< @gapVal -0.0001) "Shortage" "Equilibrium")))
            (statusMag (math/abs @gapVal))
            (demandZeroQ (math/min @config.maxQuantity (/ @entity.demandIntercept @entity.demandSlope)))
            (demandZeroP (math/max 0 (- @entity.demandIntercept (* @entity.demandSlope @demandZeroQ))))
            (supplyEndQ @config.maxQuantity)
            (supplyEndP (+ @newSupplyIntercept (* @entity.supplySlope @supplyEndQ)))
            (newCurves [
                { label: "Demand", color: @config.demandColor, samples: [ { x: 0, y: @entity.demandIntercept }, { x: @demandZeroQ, y: @demandZeroP } ] },
                { label: "Supply", color: @config.supplyColor, samples: [ { x: 0, y: @newSupplyIntercept }, { x: @supplyEndQ, y: @supplyEndP } ] },
                { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @entity.price }, { x: @config.maxQuantity, y: @entity.price } ] }
              ])
            (newPoints [
                { x: @eqQ, y: @eqP, label: "Equilibrium", color: @config.equilibriumColor, radius: 6 },
                { x: @qd, y: @entity.price, label: "Qd", color: @config.demandColor, radius: 5 },
                { x: @qs, y: @entity.price, label: "Qs", color: @config.supplyColor, radius: 5 }
              ])
          )
          (do
            (set @entity.supplyIntercept @newSupplyIntercept)
            (set @entity.equilibriumQuantity @eqQ)
            (set @entity.equilibriumPrice @eqP)
            (set @entity.qDemanded @qd)
            (set @entity.qSupplied @qs)
            (set @entity.marketStatusLabel @statusLabel)
            (set @entity.marketStatusMagnitude @statusMag)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: @config.supplyShiftStep }, label: (str/concat "Supply +" @config.supplyShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: (- 0 @config.supplyShiftStep) }, label: (str/concat "Supply −" @config.supplyShiftStep), variant: secondary, size: sm }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Equilibrium — price $" (math/round @entity.equilibriumPrice 2) ", quantity " (math/round @entity.equilibriumQuantity 2)) },
                { type: typography, variant: body, content: (str/concat "At your price — quantity demanded " (math/round @entity.qDemanded 2) ", quantity supplied " (math/round @entity.qSupplied 2)) },
                { type: alert, variant: (if (== @entity.marketStatusLabel "Surplus") "warning" (if (== @entity.marketStatusLabel "Shortage") "error" "success")), message: (if (== @entity.marketStatusLabel "Equilibrium") "At equilibrium — quantity demanded equals quantity supplied." (str/concat @entity.marketStatusLabel " of " (math/round @entity.marketStatusMagnitude 2) " units — price " (if (== @entity.marketStatusLabel "Surplus") "above" "below") " equilibrium, so the market adjusts toward it.")) }
              ] }
          ]
        })
        (emit MARKET_UPDATED { price: @entity.price, qDemanded: @entity.qDemanded, qSupplied: @entity.qSupplied, equilibriumPrice: @entity.equilibriumPrice, equilibriumQuantity: @entity.equilibriumQuantity, status: @entity.marketStatusLabel })

      SET_PRICE -> idle when (== @entity.active true)
        (let (
            (newPrice (math/clamp ?value 0 @config.maxPrice))
            (qd (math/max 0 (/ (- @entity.demandIntercept @newPrice) @entity.demandSlope)))
            (qs (math/max 0 (/ (- @newPrice @entity.supplyIntercept) @entity.supplySlope)))
            (gapVal (- @qs @qd))
            (statusLabel (if (> @gapVal 0.0001) "Surplus" (if (< @gapVal -0.0001) "Shortage" "Equilibrium")))
            (statusMag (math/abs @gapVal))
            (demandCurve (array/nth @entity.curves 0))
            (supplyCurve (array/nth @entity.curves 1))
            (priceLine { label: "Your Price", color: @config.priceLineColor, samples: [ { x: 0, y: @newPrice }, { x: @config.maxQuantity, y: @newPrice } ] })
            (eqPoint (array/nth @entity.points 0))
            (newCurves [ @demandCurve, @supplyCurve, @priceLine ])
            (newPoints [ @eqPoint, { x: @qd, y: @newPrice, label: "Qd", color: @config.demandColor, radius: 5 }, { x: @qs, y: @newPrice, label: "Qs", color: @config.supplyColor, radius: 5 } ])
          )
          (do
            (set @entity.price @newPrice)
            (set @entity.qDemanded @qd)
            (set @entity.qSupplied @qs)
            (set @entity.marketStatusLabel @statusLabel)
            (set @entity.marketStatusMagnitude @statusMag)
            (set @entity.curves @newCurves)
            (set @entity.points @newPoints)
          )
        )
        (render-ui main {
          type: box
          padding: md
          children: [
            { type: stack, direction: vertical, gap: md, children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas, width: @config.width, height: @config.height, xMin: 0, xMax: @config.maxQuantity, yMin: 0, yMax: @config.maxPrice, showAxes: true, showGrid: true, gridStep: @config.gridStep, curves: @entity.curves, points: @entity.points, vectors: [], shapes: [], interactive: @config.interactive, animate: @config.animate },
                { type: stack, direction: horizontal, gap: sm, children: [
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: @config.demandShiftStep }, label: (str/concat "Demand +" @config.demandShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_DEMAND, actionPayload: { delta: (- 0 @config.demandShiftStep) }, label: (str/concat "Demand −" @config.demandShiftStep), variant: secondary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: @config.supplyShiftStep }, label: (str/concat "Supply +" @config.supplyShiftStep), variant: primary, size: sm },
                    { type: button, action: SHIFT_SUPPLY, actionPayload: { delta: (- 0 @config.supplyShiftStep) }, label: (str/concat "Supply −" @config.supplyShiftStep), variant: secondary, size: sm }
                  ] },
                { type: stack, direction: vertical, gap: xs, children: [
                    { type: typography, variant: caption, content: (str/concat "Your price: $" (math/round @entity.price 2)) },
                    { type: range-slider, min: 0, max: @config.maxPrice, step: @config.priceStep, value: @entity.price, showTooltip: true, onChange: SET_PRICE }
                  ] },
                { type: divider },
                { type: typography, variant: body, content: (str/concat "Equilibrium — price $" (math/round @entity.equilibriumPrice 2) ", quantity " (math/round @entity.equilibriumQuantity 2)) },
                { type: typography, variant: body, content: (str/concat "At your price — quantity demanded " (math/round @entity.qDemanded 2) ", quantity supplied " (math/round @entity.qSupplied 2)) },
                { type: alert, variant: (if (== @entity.marketStatusLabel "Surplus") "warning" (if (== @entity.marketStatusLabel "Shortage") "error" "success")), message: (if (== @entity.marketStatusLabel "Equilibrium") "At equilibrium — quantity demanded equals quantity supplied." (str/concat @entity.marketStatusLabel " of " (math/round @entity.marketStatusMagnitude 2) " units — price " (if (== @entity.marketStatusLabel "Surplus") "above" "below") " equilibrium, so the market adjusts toward it.")) }
              ] }
          ]
        })
        (emit MARKET_UPDATED { price: @entity.price, qDemanded: @entity.qDemanded, qSupplied: @entity.qSupplied, equilibriumPrice: @entity.equilibriumPrice, equilibriumQuantity: @entity.equilibriumQuantity, status: @entity.marketStatusLabel })
    }

    listens {
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; this instrument renders when the mode equals matchMode, otherwise renders null."
        @tier "domain"
      SHIFT_DEMAND {
        delta : number
      }
        @description "Learner pressed a Demand +/- button to shift the demand curve's intercept."
        @tier "domain"
      SHIFT_SUPPLY {
        delta : number
      }
        @description "Learner pressed a Supply +/- button to shift the supply curve's intercept."
        @tier "domain"
      SET_PRICE {
        value : number
      }
        @description "Learner dragged the price slider to set the market price."
        @tier "domain"
    }

    emits {
      MARKET_UPDATED -> external {
        price : number
        qDemanded : number
        qSupplied : number
        equilibriumPrice : number
        equilibriumQuantity : number
        status : string
      }
        @description "The market state after each learner action — a composed listener (readout, chart, grader) can subscribe; a harmless no-op when the atom runs standalone."
        @synonyms "market update, equilibrium, surplus, shortage, price change"
        @tier "domain"
    }

    config {
      matchMode : string = ""
        @label "Match Mode"
        @description "When composed behind a lab router, the MODE_SELECTED mode value this instrument responds to. Empty string means standalone — render immediately on INIT."
        @tier "presentation"
      title : string = "Supply & Demand Market"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 640
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 440
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      gridStep : number = 10
        @label "Grid Step"
        @description "Spacing between gridlines on the canvas, in data units (quantity/price)."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
      demandIntercept : number = 100
        @label "Demand Intercept"
        @description "Choke price — the price at which quantity demanded falls to zero (P = intercept − slope × Q); the demand curve's starting vertical intercept."
        @synonyms "demand, choke price, maximum willingness to pay, demand curve intercept, demand function"
        @tier "domain"
      demandSlope : number = 1
        @label "Demand Slope"
        @description "How much price falls for each additional unit demanded — the magnitude of the demand curve's downward slope."
        @synonyms "demand slope, price sensitivity, demand curve steepness"
        @tier "domain"
      supplyIntercept : number = 10
        @label "Supply Intercept"
        @description "Reservation price — the minimum price at which producers begin supplying (P = intercept + slope × Q); the supply curve's starting vertical intercept."
        @synonyms "supply, reservation price, minimum supply price, supply curve intercept, supply function"
        @tier "domain"
      supplySlope : number = 1
        @label "Supply Slope"
        @description "How much price rises for each additional unit supplied — the magnitude of the supply curve's upward slope."
        @synonyms "supply slope, marginal cost slope, supply curve steepness"
        @tier "domain"
      maxQuantity : number = 90
        @label "Max Quantity (axis)"
        @description "Right edge of the quantity axis, in units."
        @tier "presentation"
      maxPrice : number = 100
        @label "Max Price (axis)"
        @description "Top edge of the price axis, and the price slider's maximum, in currency units."
        @tier "presentation"
      initialPrice : number = 50
        @label "Initial Price"
        @description "Starting price on the price slider, before the learner adjusts it."
        @tier "domain"
      priceStep : number = 1
        @label "Price Step"
        @description "Slider increment for the price control."
        @tier "presentation"
      demandShiftStep : number = 10
        @label "Demand Shift Step"
        @description "How much the Demand +/- buttons move the demand intercept per press."
        @synonyms "demand shift, demand shock, shift in demand"
        @tier "domain"
      supplyShiftStep : number = 10
        @label "Supply Shift Step"
        @description "How much the Supply +/- buttons move the supply intercept per press."
        @synonyms "supply shift, supply shock, shift in supply"
        @tier "domain"
      demandColor : string = "#dc2626"
        @label "Demand Curve Color"
        @tier "presentation"
      supplyColor : string = "#2563eb"
        @label "Supply Curve Color"
        @tier "presentation"
      priceLineColor : string = "#64748b"
        @label "Price Line Color"
        @tier "presentation"
      equilibriumColor : string = "#16a34a"
        @label "Equilibrium Marker Color"
        @tier "presentation"
    }
  }

  page "/econ-market" as EconMarketPage -> EconMarketSim
}
