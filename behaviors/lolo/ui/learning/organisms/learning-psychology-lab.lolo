app learning-psychology-lab "1.0.0"
"Psychology lab organism — a classical (Pavlovian) conditioning trial-runner where the learner drives a Rescorla-Wagner acquisition/extinction curve, and a Maslow's-hierarchy-of-needs classifier where the learner sorts everyday scenarios onto a 5-tier needs pyramid, composed from the std-psych-conditioning and std-learn-classify instrument atoms behind a mode router."
orbital PsychologyLabOrbital {
  uses PsychConditioning from "std/behaviors/std-psych-conditioning"
  uses LearnClassify from "std/behaviors/std-learn-classify"

  type PsychologyLabShapePoint = {
    x : number!
    y : number!
  }
  type PsychologyLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [PsychologyLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }

  entity PsychologyLabItem [runtime] {
    id : string!
  }

  entity ConditioningScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    strength : number
    history : [number]
    trialCount : number
    phase : string
    curveShapes : [PsychologyLabShape]
  }

  entity ClassifyScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    itemIndex : number
    itemText : string
    correctCategory : string
    selectedCategory : string
    feedback : string
    correctCount : number
    attemptedCount : number
    backdropShapes : [PsychologyLabShape]
  }

  trait PsychologyLabRouter -> @rebindable PsychologyLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "conditioning" | "hierarchy" = conditioning
        @label "Mode"
        @description "Which psychology simulation to render: classical (Pavlovian) conditioning trials, or the Maslow's-hierarchy-of-needs scenario classifier."
        @synonyms "psychology, classical conditioning, Pavlovian conditioning, Pavlov, Pavlov's dog, stimulus, conditioned stimulus, unconditioned stimulus, conditioned response, unconditioned response, acquisition, extinction, Rescorla-Wagner, associative strength, associative learning, Maslow, Maslow's hierarchy, hierarchy of needs, needs pyramid, motivation, self-actualization, esteem needs, love and belonging, safety needs, physiological needs"
        @tier "domain"
    }
  }

  trait ConditioningSim = PsychConditioning.traits.PsychConditioningSim -> ConditioningScene {
    listens {
      PsychologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "conditioning"
      title: "Psychology Lab"
    }
  }

  trait ClassifySim = LearnClassify.traits.LearnClassifySim -> ClassifyScene {
    listens {
      PsychologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "hierarchy"
      title: "Psychology Lab"
      advanceLabel: "Next Scenario"
      items: [
        { text: "Grabbing a granola bar because you haven't eaten anything since breakfast yesterday.", category: "physiological" },
        { text: "Stocking the pantry with canned goods before a winter storm hits.", category: "physiological" },
        { text: "Installing a deadbolt lock after a break-in two doors down.", category: "safety" },
        { text: "Negotiating a long-term contract instead of freelance gigs, for steady income.", category: "safety" },
        { text: "Joining a weekly book club to make new friends in a new city.", category: "love-belonging" },
        { text: "Calling an old friend just to catch up and feel connected.", category: "love-belonging" },
        { text: "Working extra hours to earn the promotion and the recognition that comes with it.", category: "esteem" },
        { text: "Entering a competition to prove your skill to your peers.", category: "esteem" },
        { text: "Taking a sabbatical to finally write the novel you've always wanted to write.", category: "self-actualization" },
        { text: "Learning a new instrument purely for the joy of mastering it.", category: "self-actualization" }
      ]
      categories: [
        { value: "physiological", label: "Physiological", color: "#f97316" },
        { value: "safety", label: "Safety", color: "#eab308" },
        { value: "love-belonging", label: "Love & Belonging", color: "#22c55e" },
        { value: "esteem", label: "Esteem", color: "#3b82f6" },
        { value: "self-actualization", label: "Self-Actualization", color: "#a855f7" }
      ]
    }
  }

  page "/learning/psychology-lab" as PsychologyLabPage -> PsychologyLabRouter, ConditioningSim, ClassifySim
}
