app learning-probability-lab "1.0.0"
"Probability lab organism — dice, coin-flip, and general distribution/histogram displays (all a declarative math-canvas plotter driven by config data), an animated random-walk display (converged onto the existing std-prob-walk tick-based integrator), and an interactive Bayes' theorem simulator with a population-grid visualization and evidence trials — composed from the std-prob-trials, std-prob-walk, and std-prob-bayes instrument atoms behind a mode router."
orbital ProbabilityLabOrbital {
  uses ProbTrials from "std/behaviors/std-prob-trials"
  uses ProbWalk from "std/behaviors/std-prob-walk"
  uses ProbBayes from "std/behaviors/std-prob-bayes"

  type ProbabilityLabPoint = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }
  type ProbabilityLabCurve = {
    label : string
    color : string
    samples : [ProbabilityLabPoint]
  }
  type ProbabilityLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbabilityLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbabilityLabShapePoint = {
    x : number!
    y : number!
  }

  entity ProbabilityLabItem [runtime] {
    id : string!
  }

  entity DiceScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [ProbabilityLabCurve]
    points : [ProbabilityLabPoint]
    shapes : [ProbabilityLabShape]
  }

  entity CoinsScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [ProbabilityLabCurve]
    points : [ProbabilityLabPoint]
    shapes : [ProbabilityLabShape]
  }

  entity DistributionScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [ProbabilityLabCurve]
    points : [ProbabilityLabPoint]
    shapes : [ProbabilityLabShape]
  }

  entity RandomWalkScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    points : [ProbabilityLabPoint]
    running : boolean = false
  }

  entity BayesScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    priorH : number
    likelihoodEGivenH : number
    likelihoodEGivenNotH : number
    countTP : number
    countFN : number
    countFP : number
    countTN : number
    posteriorH : number
    trialsRun : number
    trialsPositive : number
    trialsTruePositive : number
    empiricalPosterior : number
    lastTrialLabel : string
    shapes : [ProbabilityLabShape]
  }

  trait ProbabilityLabRouter -> @rebindable ProbabilityLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "dice" | "coins" | "random-walk" | "distribution" | "bayes" = distribution
        @label "Mode"
        @description "What kind of probability or statistics visualization to render."
        @synonyms "chance, probability, statistics, dice, coin flip, random walk, sampling, distribution, histogram, law of large numbers, expected value, bayes theorem, bayesian, conditional probability, base rate, base rate fallacy, prior probability, posterior probability, likelihood ratio, positive predictive value, false positive paradox"
        @tier "domain"
    }
  }

  trait DiceSim = ProbTrials.traits.ProbTrialsSim -> DiceScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "dice"
      title: "Probability Lab"
    }
  }

  trait CoinsSim = ProbTrials.traits.ProbTrialsSim -> CoinsScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "coins"
      title: "Probability Lab"
    }
  }

  trait DistributionSim = ProbTrials.traits.ProbTrialsSim -> DistributionScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "distribution"
      title: "Probability Lab"
    }
  }

  trait RandomWalkSim = ProbWalk.traits.WalkSim -> RandomWalkScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "random-walk"
      title: "Probability Lab"
    }
  }

  trait BayesSim = ProbBayes.traits.ProbBayesSim -> BayesScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "bayes"
      title: "Probability Lab"
    }
  }

  page "/learning/probability-lab" as ProbabilityLabPage -> ProbabilityLabRouter, DiceSim, CoinsSim, DistributionSim, RandomWalkSim, BayesSim
}
