app learning-probability-lab "1.0.0"
"Probability lab organism — dice, coin-flip, and general distribution/histogram displays (all a declarative math-canvas plotter driven by config data), an animated random-walk display (converged onto the existing std-prob-walk tick-based integrator), an interactive Bayes' theorem simulator with a population-grid visualization and evidence trials, a Central Limit Theorem sampling engine with a growing means-histogram, a binomial trial accumulator converging to the theoretical PMF, a least-squares regression explorer with live r/R², and a confidence-interval capture display — composed from the std-prob-trials, std-prob-walk, std-prob-bayes, std-prob-clt, std-prob-binomial, std-prob-regression, and std-prob-confidence instrument atoms behind a mode router."
orbital ProbabilityLabOrbital {
  uses ProbTrials from "std/behaviors/std-prob-trials"
  uses ProbWalk from "std/behaviors/std-prob-walk"
  uses ProbBayes from "std/behaviors/std-prob-bayes"
  uses ProbClt from "std/behaviors/std-prob-clt"
  uses ProbBinomial from "std/behaviors/std-prob-binomial"
  uses ProbRegression from "std/behaviors/std-prob-regression"
  uses ProbConfidence from "std/behaviors/std-prob-confidence"

  type ProbabilityLabPoint = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }
  type ProbabilityLabCurve = {
    label : string
    color : string
    samples : [ProbabilityLabPoint]
  }
  type ProbabilityLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ProbabilityLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ProbabilityLabShapePoint = {
    x : number!
    y : number!
  }
  type ProbabilityLabRegPoint = {
    id : string
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }
  type ProbabilityLabInterval = {
    lo : number!
    hi : number!
    captured : boolean!
  }

  entity ProbabilityLabItem [runtime] {
    id : string!
  }

  entity DiceScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [ProbabilityLabCurve]
    points : [ProbabilityLabPoint]
    shapes : [ProbabilityLabShape]
  }

  entity CoinsScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [ProbabilityLabCurve]
    points : [ProbabilityLabPoint]
    shapes : [ProbabilityLabShape]
  }

  entity DistributionScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [ProbabilityLabCurve]
    points : [ProbabilityLabPoint]
    shapes : [ProbabilityLabShape]
  }

  entity RandomWalkScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    points : [ProbabilityLabPoint]
    running : boolean = false
  }

  entity BayesScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    priorH : number
    likelihoodEGivenH : number
    likelihoodEGivenNotH : number
    countTP : number
    countFN : number
    countFP : number
    countTN : number
    posteriorH : number
    trialsRun : number
    trialsPositive : number
    trialsTruePositive : number
    empiricalPosterior : number
    lastTrialLabel : string
    shapes : [ProbabilityLabShape]
  }

  entity CltScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    sampleSize : number
    means : [number]
    drawsRun : number
    lastSampleMean : number
    shapes : [ProbabilityLabShape]
  }

  entity BinomialScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    biasP : number
    counts : [number]
    runsRun : number
    lastHeads : number
    shapes : [ProbabilityLabShape]
  }

  entity RegressionScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    points : [ProbabilityLabRegPoint]
    slope : number
    intercept : number
    r : number
    rSquared : number
    guessSlope : number
    guessIntercept : number
    guessScore : number
    revealed : boolean = false
    curves : [ProbabilityLabCurve]
    shapes : [ProbabilityLabShape]
  }

  entity ConfidenceScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    level : number
    intervals : [ProbabilityLabInterval]
    intervalsDrawn : number
    captures : number
    lastCaptured : boolean = false
    shapes : [ProbabilityLabShape]
  }

  trait ProbabilityLabRouter -> @rebindable ProbabilityLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "dice" | "coins" | "random-walk" | "distribution" | "bayes" | "clt" | "binomial" | "regression" | "confidence" = distribution
        @label "Mode"
        @description "What kind of probability or statistics visualization to render."
        @synonyms "chance, probability, statistics, dice, coin flip, random walk, sampling, distribution, histogram, law of large numbers, expected value, bayes theorem, bayesian, conditional probability, base rate, base rate fallacy, prior probability, posterior probability, likelihood ratio, positive predictive value, false positive paradox, central limit theorem, sampling distribution, sample mean, binomial, binomial distribution, pmf, regression, least squares, line of best fit, correlation, scatter plot, confidence interval, capture rate, interval estimate"
        @tier "domain"
    }
  }

  trait DiceSim = ProbTrials.traits.ProbTrialsSim -> DiceScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "dice"
      title: "Probability Lab"
    }
  }

  trait CoinsSim = ProbTrials.traits.ProbTrialsSim -> CoinsScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "coins"
      title: "Probability Lab"
    }
  }

  trait DistributionSim = ProbTrials.traits.ProbTrialsSim -> DistributionScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "distribution"
      title: "Probability Lab"
    }
  }

  trait RandomWalkSim = ProbWalk.traits.WalkSim -> RandomWalkScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "random-walk"
      title: "Probability Lab"
    }
  }

  trait BayesSim = ProbBayes.traits.ProbBayesSim -> BayesScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "bayes"
      title: "Probability Lab"
    }
  }

  trait CltSim = ProbClt.traits.ProbCltSim -> CltScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "clt"
      title: "Probability Lab"
    }
  }

  trait BinomialSim = ProbBinomial.traits.ProbBinomialSim -> BinomialScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "binomial"
      title: "Probability Lab"
    }
  }

  trait RegressionSim = ProbRegression.traits.ProbRegressionSim -> RegressionScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "regression"
      title: "Probability Lab"
    }
  }

  trait ConfidenceSim = ProbConfidence.traits.ProbConfidenceSim -> ConfidenceScene {
    listens {
      ProbabilityLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "confidence"
      title: "Probability Lab"
    }
  }

  page "/learning/probability-lab" as ProbabilityLabPage -> ProbabilityLabRouter, DiceSim, CoinsSim, DistributionSim, RandomWalkSim, BayesSim, CltSim, BinomialSim, RegressionSim, ConfidenceSim
}
