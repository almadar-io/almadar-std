app learning-logic-lab "1.0.0"
"Propositional logic lab organism — toggle atomic proposition truth values and watch compound formulas evaluate live on a truth table, apply inference rules (modus ponens, modus tollens) step by step in a guided proof, test syllogisms on a Venn diagram, propagate values through a boolean circuit, classify arguments as valid or fallacious, or evaluate quantified statements against a finite model, composed from the std-logic-truthtable, std-logic-inference, std-logic-venn, std-logic-gates, std-logic-fallacy, and std-logic-quantifier instrument atoms behind a mode router."
orbital LogicLabOrbital {
  uses LogicTruthtable from "std/behaviors/std-logic-truthtable"
  uses LogicInference from "std/behaviors/std-logic-inference"
  uses LogicVenn from "std/behaviors/std-logic-venn"
  uses LogicGates from "std/behaviors/std-logic-gates"
  uses LogicFallacy from "std/behaviors/std-logic-fallacy"
  uses LogicQuantifier from "std/behaviors/std-logic-quantifier"

  entity LogicLabItem [runtime] {
    id : string!
  }

  entity TruthTableScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    valP : boolean
    valQ : boolean
    valR : boolean
    tableRows : [json]
    renderChildren : [json]
  }

  entity InferenceScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    proofLines : [json]
    feedback : string
    goalReached : boolean
    renderChildren : [json]
  }

  entity VennScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    shadedRegions : [string]
    markedRegions : [string]
    verdict : string
    shapes : [json]
  }

  entity GatesScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    circuitIndex : number
    inputs : [json]
    gateValues : [json]
    nodes : [json]
    edges : [json]
    propagated : boolean
    prediction : string
    feedback : string
  }

  entity FallacyScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    itemIndex : number
    selectedLabel : string
    revealed : boolean
    feedback : string
    correctCount : number
    attemptedCount : number
    cardShapes : [json]
  }

  entity QuantifierScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    objects : [json]
    picks : [string]
    truthMap : [json]
    feedback : string
    shapes : [json]
  }

  trait LogicLabRouter -> @rebindable LogicLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "truth-table" | "inference" | "venn" | "gates" | "fallacy" | "quantifier" = truth-table
        @label "Mode"
        @description "Which instrument the lab shows: truth-table toggling, guided inference proof, syllogism Venn tester, boolean circuit, fallacy classifier, or quantifier model evaluator."
        @synonyms "logic, boolean logic, propositional logic, truth table, truth value, proposition, atomic proposition, logical connective, conjunction, disjunction, negation, material implication, logical implication, AND gate, OR gate, NOT gate, inference rule, modus ponens, modus tollens, syllogism, logical deduction, logical proof, premise, logical argument, tautology, contradiction, logical equivalence, venn diagram, categorical syllogism, mood, figure, existential import, boolean circuit, digital logic, XOR gate, logic gate, fallacy, informal fallacy, ad hominem, straw man, false dilemma, affirming the consequent, valid argument, quantifier, predicate logic, universal quantifier, existential quantifier, for all, there exists, model, domain of discourse"
        @tier "domain"
    }
  }

  trait TruthTableSim = LogicTruthtable.traits.LogicTruthTableSim -> TruthTableScene {
    listens {
      LogicLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "truth-table"
      title: "Logic Lab"
    }
  }

  trait InferenceSim = LogicInference.traits.LogicInferenceSim -> InferenceScene {
    listens {
      LogicLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "inference"
      title: "Logic Lab"
    }
  }

  trait VennSim = LogicVenn.traits.LogicVennSim -> VennScene {
    listens {
      LogicLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "venn"
      title: "Logic Lab"
    }
  }

  trait GatesSim = LogicGates.traits.LogicGatesSim -> GatesScene {
    listens {
      LogicLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "gates"
      title: "Logic Lab"
    }
  }

  trait FallacySim = LogicFallacy.traits.LogicFallacySim -> FallacyScene {
    listens {
      LogicLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "fallacy"
      title: "Logic Lab"
    }
  }

  trait QuantifierSim = LogicQuantifier.traits.LogicQuantifierSim -> QuantifierScene {
    listens {
      LogicLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "quantifier"
      title: "Logic Lab"
    }
  }

  page "/learning/logic-lab" as LogicLabPage -> LogicLabRouter, TruthTableSim, InferenceSim, VennSim, GatesSim, FallacySim, QuantifierSim
}
