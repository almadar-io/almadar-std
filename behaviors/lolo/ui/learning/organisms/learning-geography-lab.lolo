app learning-geography-lab "1.0.0"
"Geography lab organism — an age-sex population pyramid simulator (learner drives birth/death/migration rate dials and steps a cohort-component projection across five age bands) and a simplified Köppen climate classifier (learner sets a summer/winter temperature and precipitation profile and a 12-month climograph classifies it), composed from the std-geo-population and std-geo-koppen instrument atoms behind a mode router."
orbital GeographyLabOrbital {
  uses GeoPopulation from "std/behaviors/std-geo-population"
  uses GeoKoppen from "std/behaviors/std-geo-koppen"

  type GeographyLabShapePoint = {
    x : number!
    y : number!
  }
  type GeographyLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [GeographyLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type GeographyLabCurveSample = {
    x : number!
    y : number!
  }
  type GeographyLabCurve = {
    label : string
    color : string
    samples : [GeographyLabCurveSample]!
  }

  entity GeographyLabItem [runtime] {
    id : string!
  }

  entity PopulationScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    birthRate : number
    deathRate : number
    migrationRate : number
    decadeStep : number
    c0Male : number
    c0Female : number
    c1Male : number
    c1Female : number
    c2Male : number
    c2Female : number
    c3Male : number
    c3Female : number
    c4Male : number
    c4Female : number
    totalPopulation : number
    dependencyRatio : number
    baseSharePercent : number
    pyramidClassCode : string
    pyramidClassLabel : string
    pyramidClassReadout : string
    pyramidShapes : [GeographyLabShape]
  }

  entity ClimateScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    tempSummer : number
    tempWinter : number
    precip : number
    coldestMonthTemp : number
    warmestMonthTemp : number
    annualPrecipTotal : number
    climateClassCode : string
    climateClassName : string
    climateClassReadout : string
    climateCurves : [GeographyLabCurve]
    climateShapes : [GeographyLabShape]
  }

  trait GeographyLabRouter -> @rebindable GeographyLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "population" | "climate" = population
        @label "Mode"
        @description "Which geography simulation to render: an age-sex population pyramid, or a Köppen climate classifier."
        @synonyms "geography, population pyramid, age-sex pyramid, demography, demographic transition, cohort, cohort-component, dependency ratio, birth rate, fertility rate, death rate, mortality rate, migration, net migration, expansive pyramid, constrictive pyramid, stationary pyramid, Köppen, Koppen, climate classification, climograph, climatograph, arid climate, tropical climate, temperate climate, continental climate, polar climate"
        @tier "domain"
    }
  }

  trait PopulationSim = GeoPopulation.traits.GeoPopulationSim -> PopulationScene {
    listens {
      GeographyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "population"
      title: "Geography Lab"
    }
  }

  trait KoppenSim = GeoKoppen.traits.GeoKoppenSim -> ClimateScene {
    listens {
      GeographyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "climate"
      title: "Geography Lab"
    }
  }

  page "/learning/geography-lab" as GeographyLabPage -> GeographyLabRouter, PopulationSim, KoppenSim
}
