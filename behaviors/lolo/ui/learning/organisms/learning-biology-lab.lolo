app learning-biology-lab "1.0.0"
"Biology lab organism — a photosynthesis-style process-rate simulator (learner adjusts light/CO₂/temperature and watches the rate and limiting factor recompute), a mitosis phase-cycle stepper with predict-before-reveal, an animated breathing cell-structure diagram, an animated food-web ecosystem, and a declarative classification-network render, composed from the std-bio-processrate, std-bio-phasecycle, std-bio-cell, std-bio-foodweb, and std-bio-network instrument atoms behind a mode router."
orbital BiologyLabOrbital {
  uses BioProcessRate from "std/behaviors/std-bio-processrate"
  uses BioPhaseCycle from "std/behaviors/std-bio-phasecycle"
  uses BioCell from "std/behaviors/std-bio-cell"
  uses BioFoodweb from "std/behaviors/std-bio-foodweb"
  uses BioNetwork from "std/behaviors/std-bio-network"

  type BiologyLabNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    kind : "cell" | "organelle" | "molecule" | "organism"
  }
  type BiologyLabEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type BiologyLabShapePoint = {
    x : number!
    y : number!
  }
  type BiologyLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [BiologyLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type BiologyLabPhase = {
    label : string!
    description : string
    nodes : [BiologyLabNode]
    edges : [BiologyLabEdge]
    shapes : [BiologyLabShape]
  }

  entity BiologyLabItem [runtime] {
    id : string!
  }

  entity ProcessRateScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [BiologyLabNode]
    edges : [BiologyLabEdge]
    shapes : [BiologyLabShape]
    light : number
    co2 : number
    temperature : number
    rate : number
    limitingFactor : string
  }

  entity PhaseCycleScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [BiologyLabNode]
    edges : [BiologyLabEdge]
    shapes : [BiologyLabShape]
    currentPhase : number
    phaseLabel : string
    phaseDescription : string
    predictedPhase : string
    feedback : string
  }

  entity CellNetworkScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    phase : number = 0
    nodes : [BiologyLabNode]
    running : boolean = false
  }

  entity FoodWebNetworkScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    phase : number = 0
    nodes : [BiologyLabNode]
    running : boolean = false
  }

  entity ClassificationNetworkScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [BiologyLabNode]
    edges : [BiologyLabEdge]
    shapes : [BiologyLabShape]
  }

  trait BiologyLabRouter -> @rebindable BiologyLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "cell" | "food-web" | "classification-network" | "process-rate" | "phase-cycle" = cell
        @label "Mode"
        @description "What kind of biology visualization or simulation to render."
        @synonyms "cell, organelle, membrane, nucleus, mitochondria, ecosystem, food web, trophic level, predator, prey, taxonomy, classification, phylogeny, photosynthesis, cellular respiration, reaction rate, limiting factor, light intensity, carbon dioxide, enzyme rate, mitosis, cell division, meiosis, cell cycle, phases, stages, life cycle, prophase, metaphase, anaphase, telophase"
        @tier "domain"
    }
  }

  trait ProcessRateSim = BioProcessRate.traits.BioProcessRateSim -> ProcessRateScene {
    listens {
      BiologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "process-rate"
      title: "Biology Lab"
    }
  }

  trait PhaseCycleSim = BioPhaseCycle.traits.BioPhaseCycleSim -> PhaseCycleScene {
    listens {
      BiologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "phase-cycle"
      title: "Biology Lab"
    }
  }

  trait CellNetworkSim = BioCell.traits.BioCellSim -> CellNetworkScene {
    listens {
      BiologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "cell"
      title: "Biology Lab"
    }
  }

  trait FoodWebNetworkSim = BioFoodweb.traits.BioFoodwebSim -> FoodWebNetworkScene {
    listens {
      BiologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "food-web"
      title: "Biology Lab"
    }
  }

  trait ClassificationNetworkSim = BioNetwork.traits.BioNetworkSim -> ClassificationNetworkScene {
    listens {
      BiologyLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "classification-network"
      title: "Biology Lab"
    }
  }

  page "/learning/biology-lab" as BiologyLabPage -> BiologyLabRouter, ProcessRateSim, PhaseCycleSim, CellNetworkSim, FoodWebNetworkSim, ClassificationNetworkSim
}
