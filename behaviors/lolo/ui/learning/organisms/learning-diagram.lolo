app learning-diagram "1.0.0"
"Semantic diagram organism — renders flowcharts, cycles, trees, and concept maps from typed nodes and edges; layout is computed deterministically by the renderer. Optional step-through stages highlight nodes one stage at a time."
orbital DiagramOrbital {
  type DiagramNode = {
    id : string!
    label : string!
    group : string
    color : string
  }
  type DiagramEdge = {
    from : string!
    to : string!
    label : string
    color : string
  }
  type DiagramStep = {
    label : string!
    activeNodes : [string]
  }
  type DiagramViewNode = {
    id : string!
    label : string
    group : string
    color : string
    size : number
  }
  type DiagramViewEdge = {
    source : string!
    target : string!
    label : string
    color : string
  }

  entity DiagramItem [runtime] {
    id : string!
    title : string
    layout : string
    currentStep : number = 0
    stepLabel : string
    viewNodes : [DiagramViewNode]
    viewEdges : [DiagramViewEdge]
  }

  trait DiagramRender -> @rebindable DiagramItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.title @config.title)
        (set @entity.layout
          (if (== @config.mode "concept-map") "force"
            (if (== @config.mode "flow") "flow"
              (if (== @config.mode "sequence") "flow"
                (if (== @config.mode "tree") "tree"
                  (if (== @config.mode "cycle") "radial" "force"))))))
        (set @entity.currentStep 0)
        (set @entity.stepLabel
          (if (> (array/len @config.steps) 0)
            (object/get (array/nth @config.steps 0) label)
            ""))
        (set @entity.viewEdges
          (array/map @config.edges (fn e {
            source: (object/get @e from),
            target: (object/get @e to),
            label: (object/get @e label),
            color: (object/get @e color)
          })))
        (set @entity.viewNodes
          (array/map @config.nodes (fn n
            (let ( (isActive (and (> (array/len @config.steps) 0)
                     (array/includes (object/get (array/nth @config.steps @entity.currentStep) activeNodes) (object/get @n id)))) )
            {
              id: (object/get @n id),
              label: (object/get @n label),
              group: (object/get @n group),
              color: (if @isActive "#f59e0b" (object/get @n color)),
              size: (if @isActive 12 8)
            }))))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: @entity.stepLabel },
                { type: graph-view,
                  layout: @entity.layout,
                  nodes: @entity.viewNodes,
                  edges: @entity.viewEdges,
                  height: @config.height,
                  showLabels: @config.showLabels
                },
                {
                  type: stack
                  direction: horizontal
                  gap: sm
                  children: [
                    { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                    { type: button, action: NEXT, label: "Next ▶", variant: primary }
                  ]
                }
              ]
            }
          ]
        })

      NEXT -> idle
        (set @entity.currentStep
          (if (< @entity.currentStep (- (array/len @config.steps) 1))
            (+ @entity.currentStep 1)
            @entity.currentStep))
        (set @entity.stepLabel
          (if (> (array/len @config.steps) 0)
            (object/get (array/nth @config.steps @entity.currentStep) label)
            ""))
        (set @entity.viewNodes
          (array/map @config.nodes (fn n
            (let ( (isActive (and (> (array/len @config.steps) 0)
                     (array/includes (object/get (array/nth @config.steps @entity.currentStep) activeNodes) (object/get @n id)))) )
            {
              id: (object/get @n id),
              label: (object/get @n label),
              group: (object/get @n group),
              color: (if @isActive "#f59e0b" (object/get @n color)),
              size: (if @isActive 12 8)
            }))))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: @entity.stepLabel },
                { type: graph-view,
                  layout: @entity.layout,
                  nodes: @entity.viewNodes,
                  edges: @entity.viewEdges,
                  height: @config.height,
                  showLabels: @config.showLabels
                },
                {
                  type: stack
                  direction: horizontal
                  gap: sm
                  children: [
                    { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                    { type: button, action: NEXT, label: "Next ▶", variant: primary }
                  ]
                }
              ]
            }
          ]
        })

      PREV -> idle
        (set @entity.currentStep
          (if (> @entity.currentStep 0)
            (- @entity.currentStep 1)
            @entity.currentStep))
        (set @entity.stepLabel
          (if (> (array/len @config.steps) 0)
            (object/get (array/nth @config.steps @entity.currentStep) label)
            ""))
        (set @entity.viewNodes
          (array/map @config.nodes (fn n
            (let ( (isActive (and (> (array/len @config.steps) 0)
                     (array/includes (object/get (array/nth @config.steps @entity.currentStep) activeNodes) (object/get @n id)))) )
            {
              id: (object/get @n id),
              label: (object/get @n label),
              group: (object/get @n group),
              color: (if @isActive "#f59e0b" (object/get @n color)),
              size: (if @isActive 12 8)
            }))))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: @entity.stepLabel },
                { type: graph-view,
                  layout: @entity.layout,
                  nodes: @entity.viewNodes,
                  edges: @entity.viewEdges,
                  height: @config.height,
                  showLabels: @config.showLabels
                },
                {
                  type: stack
                  direction: horizontal
                  gap: sm
                  children: [
                    { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                    { type: button, action: NEXT, label: "Next ▶", variant: primary }
                  ]
                }
              ]
            }
          ]
        })
    }

    config {
      mode : "concept-map" | "flow" | "tree" | "cycle" | "sequence" = concept-map
        @label "Mode"
        @description "What kind of diagram to render; the renderer maps this to a deterministic layout algorithm."
        @synonyms "diagram, flowchart, concept map, mind map, tree diagram, hierarchy, cycle diagram, feedback loop, process flow, workflow, state diagram, causal chain, relationship map, network diagram, sequence of steps, stages"
        @tier "domain"
      title : string = "Diagram"
        @label "Title"
        @description "Title shown above the diagram."
        @tier "presentation"
      nodes : [DiagramNode] = [
        { id: "input", label: "Input", group: "stage", color: "#2563eb" },
        { id: "process", label: "Process", group: "stage", color: "#7c3aed" },
        { id: "output", label: "Output", group: "stage", color: "#16a34a" }
      ]
        @label "Nodes"
        @description "Semantic nodes only — the renderer computes every position. Never provide coordinates or shapes."
        @tier "domain"
      edges : [DiagramEdge] = [
        { from: "input", to: "process", label: "flows to" },
        { from: "process", to: "output", label: "produces" }
      ]
        @label "Edges"
        @description "Edges reference node ids via from/to."
        @tier "domain"
      steps : [DiagramStep] = []
        @label "Steps"
        @description "Optional step-through stages; each stage names the node ids to highlight. Leave empty for a static diagram."
        @tier "domain"
      height : number = 420
        @label "Height"
        @description "Diagram height in pixels."
        @tier "presentation"
      showLabels : boolean = true
        @label "Show Labels"
        @description "Show node labels."
        @tier "presentation"
    }
  }

  page "/learning/diagram" as DiagramPage -> DiagramRender
}
