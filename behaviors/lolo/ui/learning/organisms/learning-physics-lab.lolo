app learning-physics-lab "1.0.0"
"Physics lab organism — a rigid pendulum, a coupled-oscillator wave, and a shared declarative diagram atom rendering field/ray-diagram/circuit sketches, composed from the std-physics-pendulum, std-physics-wave, and std-physics-diagram instrument atoms behind a mode router."
orbital PhysicsLabOrbital {
  uses Pendulum from "std/behaviors/std-physics-pendulum"
  uses Wave from "std/behaviors/std-physics-wave"
  uses Diagram from "std/behaviors/std-physics-diagram"

  type PhysicsLabBody = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
    vx : number
    vy : number
    fx : number
    fy : number
  }
  type PhysicsLabConstraint = {
    from : string!
    to : string!
    color : string
  }
  type PhysicsLabShapePoint = {
    x : number!
    y : number!
  }
  type PhysicsLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [PhysicsLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }

  entity PhysicsLabItem [runtime] {
    id : string!
  }

  entity PendulumScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    bodies : [PhysicsLabBody]
    constraints : [PhysicsLabConstraint]
    running : boolean = false
  }

  entity WaveScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    bodies : [PhysicsLabBody]
    running : boolean = false
  }

  entity FieldScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    bodies : [PhysicsLabBody]
    shapes : [PhysicsLabShape]
  }

  entity RayDiagramScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    bodies : [PhysicsLabBody]
    shapes : [PhysicsLabShape]
  }

  entity CircuitScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    bodies : [PhysicsLabBody]
    shapes : [PhysicsLabShape]
  }

  trait PhysicsLabRouter -> @rebindable PhysicsLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "wave" | "field" | "ray-diagram" | "pendulum" | "circuit" = wave
        @label "Mode"
        @description "What kind of physics visualization to render."
        @synonyms "oscillation, sine wave, sound wave, light, electric field, magnetic field, gravitational field, force, ray, lens, mirror, pendulum, swing, circuit, resistor, battery, current, projectile, bounce, gravity, kinematics, motion"
        @tier "domain"
    }
  }

  trait PendulumSim = Pendulum.traits.PendulumSim -> PendulumScene {
    listens {
      PhysicsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "pendulum"
      title: "Physics Lab"
      running: false
    }
  }

  trait WaveSim = Wave.traits.WaveSim -> WaveScene {
    listens {
      PhysicsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "wave"
      title: "Physics Lab"
      running: false
    }
  }

  trait FieldSim = Diagram.traits.PhysicsDiagramSim -> FieldScene {
    listens {
      PhysicsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "field"
      title: "Physics Lab"
    }
  }

  trait RayDiagramSim = Diagram.traits.PhysicsDiagramSim -> RayDiagramScene {
    listens {
      PhysicsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "ray-diagram"
      title: "Physics Lab"
    }
  }

  trait CircuitSim = Diagram.traits.PhysicsDiagramSim -> CircuitScene {
    listens {
      PhysicsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "circuit"
      title: "Physics Lab"
    }
  }

  page "/learning/physics-lab" as PhysicsLabPage -> PhysicsLabRouter, PendulumSim, WaveSim, FieldSim, RayDiagramSim, CircuitSim
}
