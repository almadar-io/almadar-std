app learning-freeform "1.0.0"
"Freeform learning canvas — renders any diagram, flowchart, concept map, comparison panel, or step-through sequence with labeled shapes and arrows on a generic canvas."
orbital FreeformOrbital {
  type FreeformShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [FreeformShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type FreeformShapePoint = {
    x : number!
    y : number!
  }
  type FreeformScene = {
    label : string
    shapes : [FreeformShape]
  }

  entity FreeformItem [runtime] {
    id : string!
    title : string
    currentStep : number = 0
    stepLabel : string
    shapes : [FreeformShape]
  }

  trait FreeformRender -> @rebindable FreeformItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.title @config.title)
        (set @entity.currentStep 0)
        (set @entity.stepLabel (object/get (array/nth @config.scenes 0) "label"))
        (set @entity.shapes (object/get (array/nth @config.scenes 0) "shapes"))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: @entity.stepLabel },
                {
                  type: learning-canvas
                  width: @config.width
                  height: @config.height
                  shapes: @entity.shapes
                  interactive: @config.interactive
                  animate: @config.animate
                },
                {
                  type: stack
                  direction: horizontal
                  gap: sm
                  children: [
                    { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                    { type: button, action: NEXT, label: "Next ▶", variant: primary }
                  ]
                }
              ]
            }
          ]
        })

      NEXT -> idle
        (set @entity.currentStep
          (if (< @entity.currentStep (- (array/len @config.scenes) 1))
            (+ @entity.currentStep 1)
            @entity.currentStep))
        (set @entity.stepLabel (object/get (array/nth @config.scenes @entity.currentStep) "label"))
        (set @entity.shapes (object/get (array/nth @config.scenes @entity.currentStep) "shapes"))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: @entity.stepLabel },
                {
                  type: learning-canvas
                  width: @config.width
                  height: @config.height
                  shapes: @entity.shapes
                  interactive: @config.interactive
                  animate: @config.animate
                },
                {
                  type: stack
                  direction: horizontal
                  gap: sm
                  children: [
                    { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                    { type: button, action: NEXT, label: "Next ▶", variant: primary }
                  ]
                }
              ]
            }
          ]
        })

      PREV -> idle
        (set @entity.currentStep
          (if (> @entity.currentStep 0)
            (- @entity.currentStep 1)
            @entity.currentStep))
        (set @entity.stepLabel (object/get (array/nth @config.scenes @entity.currentStep) "label"))
        (set @entity.shapes (object/get (array/nth @config.scenes @entity.currentStep) "shapes"))
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: typography, variant: body, content: @entity.stepLabel },
                {
                  type: learning-canvas
                  width: @config.width
                  height: @config.height
                  shapes: @entity.shapes
                  interactive: @config.interactive
                  animate: @config.animate
                },
                {
                  type: stack
                  direction: horizontal
                  gap: sm
                  children: [
                    { type: button, action: PREV, label: "◀ Prev", variant: ghost },
                    { type: button, action: NEXT, label: "Next ▶", variant: primary }
                  ]
                }
              ]
            }
          ]
        })
    }

    config {
      scenes : [FreeformScene] = [
        {
          label: "Overview",
          shapes: [
            { type: "rect", x: 200, y: 150, width: 200, height: 100, fill: "#dbeafe", color: "#2563eb", lineWidth: 2 },
            { type: "text", x: 300, y: 200, text: "Diagram", fontSize: 18, align: "center", color: "#1e40af" }
          ]
        }
      ]
        @label "Scenes"
        @description "Array of labeled scenes. Each scene is a full canvas of shapes. Single scene = static diagram. Multiple scenes = step-through sequence."
        @synonyms "diagram, flowchart, state machine, concept map, tree, hierarchy, timeline, node-link, arrow diagram, box diagram, labeled scene, step-through, process, sequence, tutorial, comparison, side-by-side, before after, conversion table, mapping, truth table, decision tree, pipeline, workflow, architecture, memory layout, data structure, pointer, reference, call stack, scope chain, type coercion, truthiness, equality, abstract operation, graph, network, circuit, logic gate, boolean, venn, set, subset, relation, function signature, pipeline stage, data flow, control flow, execution plan, compile step, parse tree, AST"
        @tier "domain"
      title : string = "Interactive Diagram"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
    }
  }

  page "/learning/freeform" as FreeformPage -> FreeformRender
}
