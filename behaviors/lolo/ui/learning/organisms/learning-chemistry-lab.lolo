app learning-chemistry-lab "1.0.0"
"Chemistry lab organism — a declarative molecule diagram (atoms, bonds, and arrows on a chemistry-canvas), an animated reversible-reaction bond form/break oscillator, and an interactive acid-base titration simulator (pH curve, equivalence point, indicator color), composed from the std-chem-molecule, std-chem-reaction, and std-chem-titration instrument atoms behind a mode router."
orbital ChemistryLabOrbital {
  uses ChemMolecule from "std/behaviors/std-chem-molecule"
  uses ChemReaction from "std/behaviors/std-chem-reaction"
  uses ChemTitration from "std/behaviors/std-chem-titration"

  type ChemistryLabAtom = {
    id : string
    x : number!
    y : number!
    element : string
    radius : number
    color : string
  }
  type ChemistryLabBond = {
    from : string!
    to : string!
    type : "single" | "double" | "triple"
    color : string
  }
  type ChemistryLabArrow = {
    x : number!
    y : number!
    angle : number
    length : number
    color : string
    label : string
  }
  type ChemistryLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [ChemistryLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type ChemistryLabShapePoint = {
    x : number!
    y : number!
  }
  type ChemistryLabCurvePoint = {
    value : number!
    label : string
  }
  type ChemistryLabReactionAtom = {
    id : string
    x : number!
    y : number!
    element : string
    radius : number
    color : string
    home : number
  }

  entity ChemistryLabItem [runtime] {
    id : string!
  }

  entity MoleculeScene [runtime] {
    id : string!
    title : string
    atoms : [ChemistryLabAtom]
    bonds : [ChemistryLabBond]
    arrows : [ChemistryLabArrow]
    shapes : [ChemistryLabShape]
  }

  entity ReactionScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    phase : number = 0
    atoms : [ChemistryLabReactionAtom]
    running : boolean = false
  }

  entity TitrationScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    atoms : [ChemistryLabAtom]
    bonds : [ChemistryLabBond]
    arrows : [ChemistryLabArrow]
    shapes : [ChemistryLabShape]
    titrationAcidStrength : string = "strong"
    titrationAcidKa : number = 0.000018
    titrationAcidConcentration : number = 0.1
    titrationAcidVolume : number = 25
    titrationBaseConcentration : number = 0.1
    titrationIndicatorMidpoint : number = 8.2
    titrationIndicatorAcidColor : string = "#fde68a"
    titrationIndicatorBaseColor : string = "#ec4899"
    titrantVolumeAdded : number = 0
    ph : number = 0
    equivalenceVolume : number = 0
    overshoot : boolean = false
    indicatorColor : string = "#fde68a"
    statusText : string = ""
    curvePoints : [ChemistryLabCurvePoint] = []
  }

  trait ChemistryLabRouter -> @rebindable ChemistryLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "molecule" | "reaction" | "titration" = molecule
        @label "Mode"
        @description "What kind of chemistry visualization to render: a static molecule/reaction diagram, or an interactive acid-base titration."
        @synonyms "molecule, atom, bond, ball and stick, formula, reaction, reactant, product, arrow, mechanism, titration, acid-base titration, pH curve, equivalence point, indicator, neutralization, burette, analyte, titrant"
        @tier "domain"
    }
  }

  trait MoleculeSim = ChemMolecule.traits.ChemMoleculeSim -> MoleculeScene {
    listens {
      ChemistryLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "molecule"
      title: "Chemistry Lab"
    }
  }

  trait ReactionSim = ChemReaction.traits.ChemReactionSim -> ReactionScene {
    listens {
      ChemistryLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "reaction"
      title: "Chemistry Lab"
    }
  }

  trait TitrationSim = ChemTitration.traits.ChemTitrationSim -> TitrationScene {
    listens {
      ChemistryLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "titration"
      title: "Chemistry Lab"
    }
  }

  page "/learning/chemistry-lab" as ChemistryLabPage -> ChemistryLabRouter, MoleculeSim, ReactionSim, TitrationSim
}
