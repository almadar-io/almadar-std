app learning-math-lab "1.0.0"
"Math lab organism — a declarative plotter for the seven config-driven canvas modes, plus the quadratic, derivative, riemann-sum, and matrix instrument atoms, composed behind a mode router."
orbital MathLabOrbital {
  uses Quadratic from "std/behaviors/std-math-quadratic"
  uses Derivative from "std/behaviors/std-math-derivative"
  uses Integral from "std/behaviors/std-math-integral"
  uses Matrix from "std/behaviors/std-math-matrix"

  type MathLabCurve = {
    label : string
    color : string
    samples : [MathLabPoint]
  }
  type MathLabPoint = {
    x : number!
    y : number!
    label : string
    color : string
    radius : number
  }
  type MathLabVector = {
    x : number!
    y : number!
    vx : number!
    vy : number!
    color : string
    label : string
  }
  type MathLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [MathLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type MathLabShapePoint = {
    x : number!
    y : number!
  }
  type MathLabPlotSample = {
    x : number!
    y : number!
  }
  type MathLabPlotCurve = {
    label : string
    color : string
    samples : [MathLabPlotSample]
  }

  entity MathLabRouterItem [runtime] {
    id : string!
  }

  entity MathLabItem [runtime] {
    id : string!
    active : boolean = false
    title : string
    curves : [MathLabCurve]
    points : [MathLabPoint]
    vectors : [MathLabVector]
    shapes : [MathLabShape]
  }

  entity QuadraticScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    a : number
    b : number
    c : number
    vertexX : number
    vertexY : number
    discriminant : number
    equationLabel : string
    rootsLabel : string
    curves : [MathLabPlotCurve]
    points : [MathLabPoint]
  }

  entity DerivativeScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    functionPreset : string
    px : number
    h : number
    fx : number
    slope : number
    secantSlope : number
    showSecant : boolean = false
    curves : [MathLabPlotCurve]
    points : [MathLabPoint]
  }

  entity IntegralScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    functionPreset : string
    method : string
    rectangles : number
    lowerBound : number
    upperBound : number
    approxArea : number
    exactArea : number
    curves : [MathLabPlotCurve]
  }

  entity MatrixScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    m11 : number
    m12 : number
    m21 : number
    m22 : number
    t11 : number
    t12 : number
    t21 : number
    t22 : number
    determinant : number
    animating : boolean = false
    animT : number = 0
    showBasis : boolean = false
    curves : [MathLabPlotCurve]
    vectors : [MathLabVector]
  }

  trait MathLabRouter -> @rebindable MathLabRouterItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "coordinate-plane" | "function-plot" | "vector" | "geometry" | "number-line" | "slope-field" | "area-integral" | "quadratic" | "derivative" | "riemann-sum" | "matrix" = coordinate-plane
        @label "Mode"
        @description "What kind of math visualization to render."
        @synonyms "graph, plot, axes, coordinate plane, function, vector, geometry, number line, slope field, riemann sum, area under curve, quadratic, parabola, vertex, discriminant, roots, derivative, tangent, secant, slope, rate of change, integral, rectangles, matrix, linear transformation, basis vectors, determinant"
        @tier "domain"
    }
  }

  trait MathLabRender -> @rebindable MathLabItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.active false)

      MODE_SELECTED -> idle when (or (== ?mode "coordinate-plane") (or (== ?mode "function-plot") (or (== ?mode "vector") (or (== ?mode "geometry") (or (== ?mode "number-line") (or (== ?mode "slope-field") (== ?mode "area-integral")))))))
        (set @entity.active true)
        (set @entity.title @config.title)
        (set @entity.curves @config.curves)
        (set @entity.points @config.points)
        (set @entity.vectors @config.vectors)
        (set @entity.shapes @config.shapes)
        (render-ui main {
          type: box
          padding: md
          children: [
            {
              type: stack
              direction: vertical
              gap: md
              children: [
                { type: typography, variant: h4, content: @entity.title },
                { type: math-canvas,
                  width: @config.width,
                  height: @config.height,
                  xMin: @config.xMin,
                  xMax: @config.xMax,
                  yMin: @config.yMin,
                  yMax: @config.yMax,
                  showAxes: @config.showAxes,
                  showGrid: @config.showGrid,
                  gridStep: @config.gridStep,
                  curves: @entity.curves,
                  points: @entity.points,
                  vectors: @entity.vectors,
                  shapes: @entity.shapes,
                  interactive: @config.interactive,
                  animate: @config.animate
                }
              ]
            }
          ]
        })
    }

    listens {
      MathLabRouter.MODE_SELECTED -> MODE_SELECTED
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode; the declarative plotter renders when the mode is one of the seven config-driven canvas modes, otherwise renders null."
        @tier "domain"
    }

    config {
      title : string = "Math Lab"
        @label "Title"
        @description "Title shown above the canvas."
        @tier "presentation"
      width : number = 600
        @label "Width"
        @description "Canvas width in pixels."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height in pixels."
        @tier "presentation"
      xMin : number = -5
        @label "X Min"
        @description "Minimum x value on the canvas."
        @tier "presentation"
      xMax : number = 5
        @label "X Max"
        @description "Maximum x value on the canvas."
        @tier "presentation"
      yMin : number = -5
        @label "Y Min"
        @description "Minimum y value on the canvas."
        @tier "presentation"
      yMax : number = 5
        @label "Y Max"
        @description "Maximum y value on the canvas."
        @tier "presentation"
      showAxes : boolean = true
        @label "Show Axes"
        @tier "presentation"
      showGrid : boolean = true
        @label "Show Grid"
        @tier "presentation"
      gridStep : number = 1
        @label "Grid Step"
        @tier "presentation"
      curves : [MathLabCurve] = [
        { label: "y = x²", color: "#2563eb", samples: [
          { x: -3, y: 9 }, { x: -2, y: 4 }, { x: -1, y: 1 },
          { x: 0, y: 0 }, { x: 1, y: 1 }, { x: 2, y: 4 }, { x: 3, y: 9 }
        ]}
      ]
        @label "Curves"
        @description "Sampled curves to plot."
        @tier "domain"
      points : [MathLabPoint] = [
        { x: -2, y: 4, label: "A", color: "#dc2626", radius: 4 },
        { x: 1, y: 1, label: "B", color: "#16a34a", radius: 4 }
      ]
        @label "Points"
        @description "Scatter points to highlight."
        @tier "presentation"
      vectors : [MathLabVector] = []
        @label "Vectors"
        @description "Vectors to draw (origin + components)."
        @tier "domain"
      shapes : [MathLabShape] = []
        @label "Shapes"
        @description "Extra declarative shapes such as polygons, text, or number-line ticks."
        @tier "presentation"
      interactive : boolean = false
        @label "Interactive"
        @description "Enable pointer interaction on the canvas."
        @tier "presentation"
      animate : boolean = false
        @label "Animate"
        @description "Enable continuous redraw loop."
        @tier "presentation"
    }
  }

  trait QuadraticSim = Quadratic.traits.MathQuadraticSim -> QuadraticScene {
    listens {
      MathLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "quadratic"
      title: "Math Lab"
    }
  }

  trait DerivativeSim = Derivative.traits.MathDerivativeSim -> DerivativeScene {
    listens {
      MathLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "derivative"
      title: "Math Lab"
    }
  }

  trait IntegralSim = Integral.traits.MathIntegralSim -> IntegralScene {
    listens {
      MathLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "riemann-sum"
      title: "Math Lab"
    }
  }

  trait MatrixSim = Matrix.traits.MathMatrixSim -> MatrixScene {
    listens {
      MathLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "matrix"
      title: "Math Lab"
    }
  }

  page "/learning/math-lab" as MathLabPage -> MathLabRouter, MathLabRender, QuadraticSim, DerivativeSim, IntegralSim, MatrixSim
}
