app learning-earth-lab "1.0.0"
"Earth-science lab organism — a plate-tectonics boundary simulator (learner picks convergent/divergent/transform and drives the motion) and an interactive water-cycle flux simulator (learner drives solar input and steps the cycle), composed from the std-earth-plates and std-earth-watercycle instrument atoms behind a mode router."
orbital EarthLabOrbital {
  uses EarthPlates from "std/behaviors/std-earth-plates"
  uses EarthWatercycle from "std/behaviors/std-earth-watercycle"

  type EarthLabNode = {
    id : string
    x : number!
    y : number!
    radius : number
    color : string
    label : string
  }
  type EarthLabEdge = {
    from : string!
    to : string!
    color : string
    label : string
  }
  type EarthLabShapePoint = {
    x : number!
    y : number!
  }
  type EarthLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [EarthLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }
  type EarthLabBoundary = {
    type : "convergent" | "divergent" | "transform"!
    label : string
    description : string
    landform : string
    quakeProfile : string
  }

  entity EarthLabItem [runtime] {
    id : string!
  }

  entity PlatesScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [EarthLabNode]
    edges : [EarthLabEdge]
    shapes : [EarthLabShape]
    boundaryType : string
    boundaryDescription : string
    advanceSteps : number
    landformLabel : string
    quakeProfileLabel : string
  }

  entity WatercycleScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    nodes : [EarthLabNode]
    edges : [EarthLabEdge]
    shapes : [EarthLabShape]
    solarInput : number
    cycleStep : number
    evaporationFlux : number
    condensationFlux : number
    precipitationFlux : number
    runoffFlux : number
    oceanReadout : string
    atmosphereReadout : string
    landReadout : string
  }

  trait EarthLabRouter -> @rebindable EarthLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "plates" | "water-cycle" = plates
        @label "Mode"
        @description "Which earth-science simulation to render: plate boundary tectonics, or the water cycle."
        @synonyms "earth science, geology, plate tectonics, tectonic plates, plate boundary, convergent boundary, divergent boundary, transform boundary, subduction, subduction zone, trench, volcanic arc, mid-ocean ridge, rift valley, seafloor spreading, continental drift, strike-slip fault, transform fault, earthquake, seismicity, Wadati-Benioff zone, water cycle, hydrologic cycle, evaporation, condensation, precipitation, runoff, reservoir, ocean, atmosphere, solar input, cloud formation, rainfall, infiltration"
        @tier "domain"
    }
  }

  trait PlatesSim = EarthPlates.traits.EarthPlatesSim -> PlatesScene {
    listens {
      EarthLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "plates"
      title: "Earth Lab"
    }
  }

  trait WatercycleSim = EarthWatercycle.traits.EarthWatercycleSim -> WatercycleScene {
    listens {
      EarthLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "water-cycle"
      title: "Earth Lab"
    }
  }

  page "/learning/earth-lab" as EarthLabPage -> EarthLabRouter, PlatesSim, WatercycleSim
}
