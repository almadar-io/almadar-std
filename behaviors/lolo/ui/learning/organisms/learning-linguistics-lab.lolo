app learning-linguistics-lab "1.0.0"
"Linguistics lab organism — a Universal Grammar syntax-tree builder (learner assembles a sentence's constituent structure bottom-up, one labelled bracket at a time) and a historical sound-change stepper (learner applies ordered Great Vowel Shift rules and watches every matching word's pronunciation shift at once), composed from the std-ling-syntaxtree and std-ling-soundchange instrument atoms behind a mode router."
orbital LinguisticsLabOrbital {
  uses LingSyntaxtree from "std/behaviors/std-ling-syntaxtree"
  uses LingSoundchange from "std/behaviors/std-ling-soundchange"

  type LinguisticsLabShapePoint = {
    x : number!
    y : number!
  }
  type LinguisticsLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [LinguisticsLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }

  entity LinguisticsLabItem [runtime] {
    id : string!
  }

  entity SyntaxtreeScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    renderChildren : [json]
    shapes : [LinguisticsLabShape]
    sentenceIndex : number
    stepIndex : number
    syntaxFeedback : string
  }

  entity SoundchangeScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    renderChildren : [json]
    shapes : [LinguisticsLabShape]
    ruleIndex : number
    changedSummary : string
    done : boolean
  }

  trait LinguisticsLabRouter -> @rebindable LinguisticsLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "syntax-tree" | "sound-change" = syntax-tree
        @label "Mode"
        @description "Which linguistics simulation to render: a Universal Grammar constituent-structure parse-tree builder, or a historical sound-change (vowel shift) stepper."
        @synonyms "linguistics, syntax, parse tree, constituent, constituent structure, phrase structure, Universal Grammar, grammar, sentence structure, X-bar theory, noun phrase, verb phrase, prepositional phrase, phonology, sound change, sound law, vowel shift, Great Vowel Shift, diphthongization, historical linguistics, phonetic change"
        @tier "domain"
    }
  }

  trait SyntaxtreeSim = LingSyntaxtree.traits.LingSyntaxtreeSim -> SyntaxtreeScene {
    listens {
      LinguisticsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "syntax-tree"
      title: "Linguistics Lab"
    }
  }

  trait SoundchangeSim = LingSoundchange.traits.LingSoundchangeSim -> SoundchangeScene {
    listens {
      LinguisticsLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "sound-change"
      title: "Linguistics Lab"
    }
  }

  page "/learning/linguistics-lab" as LinguisticsLabPage -> LinguisticsLabRouter, SyntaxtreeSim, SoundchangeSim
}
