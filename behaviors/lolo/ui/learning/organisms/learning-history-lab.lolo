app learning-history-lab "1.0.0"
"History lab organism — a WWI causal-chain counterfactual (toggle structural causes and triggers off/on and watch whether war still breaks out) and a Fall-of-Rome periodization timeline (step through events and filter by political/military/economic lens), composed from the std-hist-causalchain and std-learn-stepper instrument atoms behind a mode router."
orbital HistoryLabOrbital {
  uses HistCausalChain from "std/behaviors/std-hist-causalchain"
  uses LearnStepper from "std/behaviors/std-learn-stepper"

  type HistoryLabShapePoint = {
    x : number!
    y : number!
  }
  type HistoryLabShape = {
    type : "line" | "arrow" | "circle" | "rect" | "polygon" | "path" | "text" | "axis" | "grid"!
    id : string
    x : number
    y : number
    x1 : number
    y1 : number
    x2 : number
    y2 : number
    radius : number
    width : number
    height : number
    points : [HistoryLabShapePoint]
    path : string
    text : string
    label : string
    fontSize : number
    align : "left" | "center" | "right"
    axis : "x" | "y"
    min : number
    max : number
    step : number
    color : string
    fill : string
    lineWidth : number
    opacity : number
  }

  entity HistoryLabItem [runtime] {
    id : string!
  }

  entity CausalChainScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    removedIds : [string]
    activeIds : [string]
    totalContribution : number
    outcomeFires : boolean
    missingNecessaryLabel : string
    contributionReadout : string
    shapes : [HistoryLabShape]
  }

  entity StepperScene [runtime] {
    id : string!
    active : boolean = false
    title : string
    cursorIndex : number
    activeFilter : string
    narration : string
    categoryTally : string
    visibleThreadNote : string
    shapes : [HistoryLabShape]
    filterButtons : [json]
  }

  trait HistoryLabRouter -> @rebindable HistoryLabItem [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (emit MODE_SELECTED { mode: @config.mode })
    }

    emits {
      MODE_SELECTED -> external {
        mode : string
      }
        @description "Broadcast once on mount — tells each composed instrument trait which mode the lab is in; the instrument whose matchMode equals it renders, the others render null."
        @tier "domain"
    }

    config {
      mode : "causal-chain" | "timeline" = causal-chain
        @label "Mode"
        @description "Which history simulation to render: a WWI causal-chain counterfactual graph, or a Fall-of-Rome periodization timeline."
        @synonyms "history, historical causation, cause and effect, causal chain, counterfactual, counterfactual history, structural cause, proximate cause, trigger, casus belli, alliance system, militarism, nationalism, imperialism, imperial rivalry, assassination, Franz Ferdinand, WWI, World War One, First World War, July Crisis, timeline, periodization, fall of Rome, decline of Rome, Western Roman Empire, historiography, primary source lens, historical lens"
        @tier "domain"
    }
  }

  trait CausalChainSim = HistCausalChain.traits.HistCausalChainSim -> CausalChainScene {
    listens {
      HistoryLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "causal-chain"
      title: "History Lab"
    }
  }

  trait StepperSim = LearnStepper.traits.LearnStepperSim -> StepperScene {
    listens {
      HistoryLabRouter.MODE_SELECTED -> MODE_SELECTED
    }
    config {
      matchMode: "timeline"
      title: "History Lab"
      stages: [
        { id: "crisis-third-century", position: 235, label: "Crisis of the Third Century Begins", category: "political", description: "Decades of civil war and rapid emperor turnover near-collapse central authority across the Empire." },
        { id: "diocletians-reforms", position: 284, label: "Diocletian's Reforms", category: "political", description: "The Empire is split into a Tetrarchy and its administration overhauled to stabilize imperial control." },
        { id: "edict-max-prices", position: 301, label: "Edict on Maximum Prices", category: "economic", description: "Diocletian tries to halt runaway inflation from decades of currency debasement, with limited success." },
        { id: "goths-cross-danube", position: 376, label: "Goths Cross the Danube", category: "military", description: "Fleeing the Huns, the Goths are admitted into Roman territory, straining military and food supply." },
        { id: "battle-adrianople", position: 378, label: "Battle of Adrianople", category: "military", description: "A Roman field army is destroyed by Gothic forces, a catastrophic blow exposing imperial vulnerability." },
        { id: "empire-splits", position: 395, label: "Empire Permanently Splits East and West", category: "political", description: "Theodosius's sons divide administration; East and West never again reunite under one emperor." },
        { id: "sack-rome-alaric", position: 410, label: "Sack of Rome by Alaric", category: "military", description: "The city of Rome is sacked for the first time in 800 years, a profound symbolic and military shock." },
        { id: "vandals-seize-carthage", position: 439, label: "Vandals Seize Carthage", category: "economic", description: "Rome loses its wealthiest grain-producing province in North Africa, crippling tax revenue and food supply." },
        { id: "battle-catalaunian-plains", position: 451, label: "Battle of the Catalaunian Plains", category: "military", description: "A Roman-led coalition halts Attila's Huns, but the effort further drains dwindling military resources." },
        { id: "vandals-sack-rome", position: 455, label: "Vandals Sack Rome", category: "military", description: "A second sack of Rome underscores the collapse of Western military capacity to defend the capital." },
        { id: "romulus-augustulus-deposed", position: 476, label: "Romulus Augustulus Deposed", category: "political", description: "Odoacer deposes the last Western emperor; conventionally marked as the fall of the Western Roman Empire." }
      ]
      categories: [
        { category: "political", color: "#7c3aed", label: "Political" },
        { category: "military", color: "#b91c1c", label: "Military" },
        { category: "economic", color: "#15803d", label: "Economic" }
      ]
      categorySummaries: [
        { category: "political", summary: "Viewed through politics alone, Rome's fall is administrative: civil war, reform, and a permanent East-West split hollow out central authority long before any emperor is deposed." },
        { category: "military", summary: "Viewed through the military alone, Rome's fall is a string of defeats and incursions — Adrianople, two sacks of the capital, endless frontier pressure — that leave the West unable to defend itself." },
        { category: "economic", summary: "Viewed through economics alone, Rome's fall is fiscal: the loss of North Africa's tax base and decades of currency debasement starve the state of resources that war and administration both require." }
      ]
      allSummary: "Taken together, the threads reinforce each other — political fragmentation weakens defense, military defeat costs territory and revenue, and fiscal collapse starves the state of the resources reform would need. No single lens tells the whole story."
      allLabel: "All"
      startPrompt: "Press Next to begin."
      minPosition: 230
      maxPosition: 480
      axisY: 220
      axisMarginLeft: 60
      axisMarginRight: 60
      markerRadius: 8
      markerHighlightRadius: 14
      unreachedColor: "#d6d3d1"
    }
  }

  page "/learning/history-lab" as HistoryLabPage -> HistoryLabRouter, CausalChainSim, StepperSim
}
