app ui-drawer-slot [
  locales: [en, ar, sl],
  version: "1.0.0",
  description: "DrawerSlot — UI factory (1:1 with the @almadar/ui drawer-slot pattern)."
]
uses NotFound from "std/behaviors/std-not-found"
;; @pattern "drawer-slot"
orbital DrawerSlotOrbital {
  type DrawerSlotError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity DrawerSlotItem [runtime] {
    id : string!
  }

  trait DrawerSlotRender -> @rebindable DrawerSlotItem {
    initial: idle

    state idle {
      INIT -> idle
        (fetch DrawerSlotItem { emit: { failure: DrawerSlotLoadFailed } })
        (render-ui main {
          children: @config.children
          title: @config.title
          position: @config.position
          size: @config.size
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          entity: DrawerSlotItem
          sourceTrait: @config.sourceTrait
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          type: drawer-slot
        })
      DrawerSlotLoadFailed -> idle
        (notify error (str/concat "Couldn't load the drawer slot — " (default ?error "")))
    }

    emits {
      DrawerSlotLoadFailed {
        error : string
        code : string
      }
        @description "Drawer slot could not be loaded."
        @synonyms "error, failure, rejected"
        @tier "internal"
    }

    config {
      children : node
        @label "Children"
        @description "Content to display in the drawer"
        @tier "presentation"
      title : string
        @label "Title"
        @description "Override drawer title (extracted from children if not provided)"
        @tier "presentation"
      position : "left" | "right" = right
        @label "Position"
        @description "Drawer position"
        @tier "presentation"
      size : "sm" | "md" | "lg" | "xl" | "full" = md
        @label "Size"
        @description "Drawer size"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Custom class name"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : DrawerSlotError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      sourceTrait : string
        @label "Source Trait"
        @description "Source trait name for qualified event emission"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
    }
  }

  page "/drawer-slot" as DrawerSlotPage -> DrawerSlotRender
}

orbital NotFound = NotFound.orbitals.NotFoundOrbital {
  config { primaryHref: "/drawer-slot" }
}
