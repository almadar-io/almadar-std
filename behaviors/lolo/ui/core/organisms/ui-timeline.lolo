app ui-timeline "1.0.0"
"Timeline — UI factory (1:1 with the @almadar/ui timeline pattern)."
;; @pattern "timeline"
orbital TimelineOrbital {
    type TimelineLoaded = Event { data : [TimelineItem] } "Timeline rows finished loading; payload.data holds the collection"
  type TimelineError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type TimelineItemsItem = {
    id : string!
    title : string!
    description : string
    date : string
    status : "complete" | "active" | "pending" | "error"
    icon : icon
    tags : [string]
  }
  type TimelineItemActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost"
    roles : [string]
  }

  entity TimelineItem [runtime] {
    id : string!
  }

  trait TimelineRender -> @rebindable TimelineItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch TimelineItem { emit: { success: TimelineLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          entity: @entity
          title: @config.title
          items: @config.items
          fields: @config.fields
          titleField: @config.titleField
          descriptionField: @config.descriptionField
          dateField: @config.dateField
          statusField: @config.statusField
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          look: @config.look
          type: timeline
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          entity: @entity
          title: @config.title
          items: @config.items
          fields: @config.fields
          titleField: @config.titleField
          descriptionField: @config.descriptionField
          dateField: @config.dateField
          statusField: @config.statusField
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          look: @config.look
          type: timeline
        })
      TimelineLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          entity: @payload.data
          title: @config.title
          items: @config.items
          fields: @config.fields
          titleField: @config.titleField
          descriptionField: @config.descriptionField
          dateField: @config.dateField
          statusField: @config.statusField
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          look: @config.look
          type: timeline
        })
    }

    emits {
      VIEW -> external {
        id : string!
        row : @entity!
      }
        @description "User opened a record from the list."
        @tier "essential"
      TimelineLoaded
        @description "Timeline rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : TimelineError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      title : string
        @label "Title"
        @description "Timeline title"
        @tier "presentation"
      items : [TimelineItemsItem] = []
        @label "Items"
        @description "Timeline items"
        @tier "presentation"
      fields : [string] = []
        @label "Fields"
        @description "Entity fields the timeline draws; each slot is named by its own `*Field` prop."
        @tier "presentation"
      titleField : string
        @label "Title Field"
        @description "Entity field holding each item's title."
        @tier "presentation"
      descriptionField : string
        @label "Description Field"
        @description "Entity field holding each item's description."
        @tier "presentation"
      dateField : string
        @label "Date Field"
        @description "Entity field holding each item's date."
        @tier "presentation"
      statusField : string
        @label "Status Field"
        @description "Entity field holding each item's status (complete | active | pending | error)."
        @tier "presentation"
      itemActions : [TimelineItemActionsItem] = []
        @label "Item Actions"
        @description "Actions per item"
        @tier "presentation"
      look : "vertical-compact" | "vertical-spacious" | "horizontal" | "swimlane" = "vertical-spacious"
        @label "Look"
        @description "Layer 2 visual treatment."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/timeline" as TimelinePage -> TimelineRender
}
