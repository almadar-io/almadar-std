app ui-state-machine-view "1.0.0"
"StateMachineView — UI factory (1:1 with the @almadar/ui state-machine-view pattern)."
;; @pattern "state-machine-view"
orbital StateMachineViewOrbital {
  type StateMachineViewTrait = {
    name : string!
    linkedEntity : string!
    states : [StateMachineViewTraitStatesItem]!
    transitions : [StateMachineViewTraitTransitionsItem]!
    emittedEvents : [string]!
    listenedEvents : [string]!
  }
  type StateMachineViewTraitStatesItem = {
    name : string!
    isInitial : boolean
    isTerminal : boolean
  }
  type StateMachineViewTraitTransitionsItem = {
    from : string!
    to : string!
    event : string!
    guard : SExpr
    effects : [StateMachineViewTraitTransitionsItemEffectsItem]!
    index : number!
  }
  type StateMachineViewTraitTransitionsItemEffectsItem = {
    type : string!
    args : [SExpr]!
  }
  type StateMachineViewError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type StateMachineViewTRANSITIONCLICKTransition = {
    index : number!
    event : string!
    from : string!
    to : string!
  }

  entity StateMachineViewItem [runtime] {
    id : string!
  }

  trait StateMachineViewRender -> @rebindable StateMachineViewItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          activeState: @config.activeState
          activeTransition: @config.activeTransition
          visitedStates: @config.visitedStates
          stateClickEvent: @config.stateClickEvent
          transitionClickEvent: @config.transitionClickEvent
          onTransitionClick: @config.onTransitionClick
          selectedState: @config.selectedState
          pendingSourceState: @config.pendingSourceState
          nodeShape: @config.nodeShape
          entityFields: @config.entityFields
          direction: @config.direction
          showHeader: @config.showHeader
          className: @config.className
          trait: @config.traitProp
          isLoading: @config.isLoading
          error: @config.error
          type: state-machine-view
        })
    }

    emits {
      @config.stateClickEvent -> external {
        stateId : string!
      }
        @description "Emits UI:{stateClickEvent} with { stateId } when a state is clicked."
        @tier "essential"
      @config.transitionClickEvent -> external {
        index : number!
        event : string!
        from : string!
        to : string!
        transition : StateMachineViewTRANSITIONCLICKTransition
      }
        @description "Emits UI:{transitionClickEvent} with { index, event, from, to } when a transition label is clicked."
        @tier "essential"
    }

    config {
      activeState : string
        @label "Active State"
        @description "State execution is currently in."
        @tier "presentation"
      activeTransition : number
        @label "Active Transition"
        @description "`index` of the transition that just fired."
        @tier "presentation"
      visitedStates : [string] = []
        @label "Visited States"
        @description "States already passed through, in order."
        @tier "presentation"
      stateClickEvent : event = "STATE_CLICK"
        @label "State Click Event"
        @description "Emits UI:{stateClickEvent} with { stateId } when a state is clicked."
        @tier "presentation"
      transitionClickEvent : event = "TRANSITION_CLICK"
        @label "Transition Click Event"
        @description "Emits UI:{transitionClickEvent} with { index, event, from, to } when a transition label is clicked."
        @tier "presentation"
      onTransitionClick : event = "TRANSITION_CLICK"
        @label "On Transition Click"
        @description "Direct transition-click callback, for React hosts (e.g. a canvas node)."
        @tier "presentation"
      selectedState : string
        @label "Selected State"
        @description "State picked in an editor (first click)."
        @tier "presentation"
      pendingSourceState : string
        @label "Pending Source State"
        @description "Source of a transition being drawn — the next state click picks its target."
        @tier "presentation"
      nodeShape : "pill" | "gear" = pill
        @label "Node Shape"
        @description "Node silhouette. @default 'pill'"
        @tier "presentation"
      entityFields : [string] = []
        @label "Entity Fields"
        @description "Entity field names listed in the header."
        @tier "presentation"
      direction : "ltr" | "rtl" = ltr
        @label "Direction"
        @description "Flow direction. @default 'ltr'"
        @tier "presentation"
      showHeader : boolean
        @label "Show Header"
        @description "Show the trait header (name, entity, listens/emits). @default true"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      traitProp : StateMachineViewTrait
        @label "Trait"
        @description "The trait to draw (see `parseTraitLevel` / `traitLevelFromTrait`)."
        @synonyms "trait"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : StateMachineViewError
        @label "Error"
        @description "Error state"
        @tier "presentation"
    }
  }

  page "/state-machine-view" as StateMachineViewPage -> StateMachineViewRender
}
