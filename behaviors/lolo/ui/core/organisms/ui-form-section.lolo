app ui-form-section "1.0.0"
"FormSection — UI factory (1:1 with the @almadar/ui form-section pattern)."
orbital FormSectionOrbital {
    type FormSectionLoaded = Event { data : [FormSectionItem] } "FormSection rows finished loading; payload.data holds the collection"
  type FormSectionFieldsItem = {
    name : string
    field : string
    label : string
    type : string
    inputType : string
    placeholder : string
    required : boolean
    defaultValue : ControlValue
    options : [FormSectionFieldsItemOptionsItem]
    values : [string]
    relation : FormSectionFieldsItemRelation
    min : number
    max : number
    pattern : string
    validation : FormSectionFieldsItemValidation
    readonly : boolean
    disabled : boolean
    hint : string
  }
  type ControlValue = string | number | boolean | [string] | FileValue
  type FileValue = {
    name : string!
    url : string!
    mimeType : string!
    sizeBytes : number!
  }
  type FormSectionFieldsItemOptionsItem = {
    value : string!
    label : string!
  }
  type FormSectionFieldsItemRelation = {
    entity : string!
    displayField : string
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type FormSectionFieldsItemValidation = {
    enum : [string]
  }
  type FormSectionError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type FormSectionRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }
  type FormSectionFieldOverridesItem = {
    name : string!
    label : string
    placeholder : string
    hint : string
  }
  type FormSectionHiddenCalculationsItem = {
    variableName : string!
    expression : SExpr!
    triggerFields : [string]!
  }
  type FormSectionViolationTriggersItem = {
    condition : SExpr!
    violation : FormSectionViolationTriggersItemViolation!
    fieldId : string
  }
  type FormSectionViolationTriggersItemViolation = {
    law : string!
    article : string!
    actionType : "measure" | "admin" | "penalty"!
    message : string!
  }
  type FormSectionEvaluationContext = {
    formValues : Map string ControlValue!
    globalVariables : Map string ControlValue!
    localVariables : Map string ControlValue
    entity : Map string ControlValue
  }
  type FormSectionSectionsItem = {
    id : string!
    title : string!
    condition : SExpr
    fields : [FormSectionSectionsItemFieldsItem]!
    collapsible : boolean
  }
  type FormSectionSectionsItemFieldsItem = {
    name : string
    field : string
    label : string
    type : string
    inputType : string
    placeholder : string
    required : boolean
    defaultValue : ControlValue
    options : [FormSectionSectionsItemFieldsItemOptionsItem]
    values : [string]
    relation : FormSectionSectionsItemFieldsItemRelation
    min : number
    max : number
    pattern : string
    validation : FormSectionSectionsItemFieldsItemValidation
    readonly : boolean
    disabled : boolean
    hint : string
  }
  type FormSectionSectionsItemFieldsItemOptionsItem = {
    value : string!
    label : string!
  }
  type FormSectionSectionsItemFieldsItemRelation = {
    entity : string!
    displayField : string
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type FormSectionSectionsItemFieldsItemValidation = {
    enum : [string]
  }
  type FormSectionFIELDCHANGEChange = {
    fieldId : string!
    value : string | number | boolean | [string] | FormSectionFIELDCHANGEChangeValue!
    formValues : Map string ControlValue!
  }
  type FormSectionFIELDCHANGEChangeValue = {
    name : string!
    url : string!
    mimeType : string!
    sizeBytes : number!
  }

  entity FormSectionItem [runtime] {
    id : string!
  }

  trait FormSectionRender -> @rebindable FormSectionItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch FormSectionItem { emit: { success: FormSectionLoaded } })
        (render-ui main {
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @entity
          mode: @config.mode
          fields: @config.fields
          initialData: @entity
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          type: form-section
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @entity
          mode: @config.mode
          fields: @config.fields
          initialData: @entity
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          type: form-section
        })
      FormSectionLoaded -> idle
        (render-ui main {
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @payload.data
          mode: @config.mode
          fields: @config.fields
          initialData: @payload.data
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          type: form-section
        })
    }

    emits {
      @config.submitEvent -> external {
        data : @entity!
      }
        @description "Event dispatch props (for trait state machine integration)"
        @tier "essential"
      @config.cancelEvent -> external { }
        @description "Event to dispatch on cancel (defaults to 'CANCEL')"
        @tier "essential"
      @config.onFieldChange -> external {
        change : FormSectionFIELDCHANGEChange
      }
        @description "Callback when any field value changes"
        @tier "essential"
      FormSectionLoaded
        @description "FormSection rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      children : node
        @label "Children"
        @description "Form fields (traditional React children)"
        @tier "presentation"
      onSubmit : string
        @label "On Submit"
        @description "Submit event name for trait dispatch (emitted via eventBus as UI:{onSubmit})"
        @tier "presentation"
      onCancel : string
        @label "On Cancel"
        @description "Cancel event name for trait dispatch (emitted via eventBus as UI:{onCancel})"
        @tier "presentation"
      layout : "vertical" | "horizontal" | "inline" = vertical
        @label "Layout"
        @description "Form layout"
        @tier "presentation"
      gap : "sm" | "md" | "lg" = md
        @label "Gap"
        @description "Gap between fields"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      mode : string
        @label "Mode"
        @description "Form mode — 'create' for new records, 'edit' for updating existing. Accepts `string` so schema-driven callers (whose `config.mode` is typed as `string` per the trait's declared config block) compile cleanly. The runtime treats anything other than 'edit' as 'create'."
        @tier "presentation"
      fields : [FormSectionFieldsItem] = [{ name: "Name", field: "Field", label: "Label", type: "Type", inputType: "Input Type", placeholder: "Placeholder", required: false, options: [{ value: "Value", label: "Label" }, { value: "Value 2", label: "Label 2" }], values: ["Item", "Item 2"], relation: { entity: "Entity", displayField: "Display Field", cardinality: one }, min: 1, max: 1, pattern: "Pattern", validation: { enum: ["Item", "Item 2"] }, readonly: false, disabled: false, hint: "Hint" }, { name: "Name 2", field: "Field 2", label: "Label 2", type: "Type 2", inputType: "Input Type 2", placeholder: "Placeholder 2", required: true, options: [{ value: "Value", label: "Label" }, { value: "Value 2", label: "Label 2" }], values: ["Item", "Item 2"], relation: { entity: "Entity 2", displayField: "Display Field 2", cardinality: many }, min: 2, max: 2, pattern: "Pattern 2", validation: { enum: ["Item", "Item 2"] }, readonly: true, disabled: true, hint: "Hint 2" }]
        @label "Fields"
        @description "Fields definition (schema format) - accepts readonly for generated const arrays"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : FormSectionError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      submitLabel : string
        @label "Submit Label"
        @description "Submit button label"
        @tier "presentation"
      cancelLabel : string
        @label "Cancel Label"
        @description "Cancel button label (if provided, shows cancel button)"
        @tier "presentation"
      showCancel : boolean
        @label "Show Cancel"
        @description "Show cancel button (defaults to true for schema forms)"
        @tier "presentation"
      showSubmit : boolean = true
        @label "Show Submit"
        @description "Show submit button (defaults to true for schema forms). Set false when a parent atom owns the submit action externally (e.g. wizard footers)."
        @tier "presentation"
      title : string
        @label "Title"
        @description "Form title (used by ModalSlot to extract title)"
        @tier "presentation"
      submitEvent : event = "SUBMIT"
        @label "Submit Event"
        @description "Event dispatch props (for trait state machine integration)"
        @tier "presentation"
      cancelEvent : event = "CANCEL"
        @label "Cancel Event"
        @description "Event to dispatch on cancel (defaults to 'CANCEL')"
        @tier "presentation"
      relationsData : Map string [FormSectionRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation data props"
        @tier "presentation"
      relationsLoading : Map string boolean = {}
        @label "Relations Loading"
        @description "Loading state for relation data: { fieldName: boolean }"
        @tier "presentation"
      fieldOverrides : [FormSectionFieldOverridesItem] = []
        @label "Field Overrides"
        @description "Per-field display-copy overrides (label/placeholder/hint), merged by field name over the schema-enriched fields."
        @tier "presentation"
      conditionalFields : Map string SExpr = {}
        @label "Conditional Fields"
        @description "Inspection form extensions"
        @tier "presentation"
      hiddenCalculations : [FormSectionHiddenCalculationsItem] = []
        @label "Hidden Calculations"
        @description "Hidden calculations that emit GLOBAL_VARIABLE_SET on field change (boolean true means enabled but config loaded separately)"
        @tier "presentation"
      violationTriggers : [FormSectionViolationTriggersItem] = []
        @label "Violation Triggers"
        @description "Violation conditions that emit VIOLATION_DETECTED when met (boolean true means enabled but config loaded separately)"
        @tier "presentation"
      evaluationContext : FormSectionEvaluationContext
        @label "Evaluation Context"
        @description "Context for S-expression evaluation"
        @tier "presentation"
      sections : [FormSectionSectionsItem] = []
        @label "Sections"
        @description "Nested form sections with optional conditions"
        @tier "presentation"
      onFieldChange : event = "FIELD_CHANGE"
        @label "On Field Change"
        @description "Callback when any field value changes"
        @tier "presentation"
      configPath : string
        @label "Config Path"
        @description "Config path for form configuration (schema-driven)"
        @tier "presentation"
      repeatable : boolean
        @label "Repeatable"
        @description "Whether the form supports repeatable entries"
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/form-section" as FormSectionPage -> FormSectionRender
}
