app ui-media-gallery "1.0.0"
"MediaGallery — UI factory (1:1 with the @almadar/ui media-gallery pattern)."
;; @pattern "media-gallery"
orbital MediaGalleryOrbital {
    type MediaGalleryLoaded = Event { data : [MediaGalleryItem] } "MediaGallery rows finished loading; payload.data holds the collection"
  type MediaGalleryError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type MediaGalleryItemsItem = {
    id : string
    src : asset
    alt : string
    thumbnail : asset
    mediaType : "image" | "video"
    caption : string
    fileSize : string
  }
  type MediaGalleryActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost"
    roles : [string]
  }

  entity MediaGalleryItem [runtime] {
    id : string!
  }

  trait MediaGalleryRender -> @rebindable MediaGalleryItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch MediaGalleryItem { emit: { success: MediaGalleryLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          title: @config.title
          items: @config.items
          columns: @config.columns
          selectable: @config.selectable
          selectedItems: @config.selectedItems
          selectionEvent: @config.selectionEvent
          showUpload: @config.showUpload
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          aspectRatio: @config.aspectRatio
          srcField: @config.srcField
          captionField: @config.captionField
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: media-gallery
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          title: @config.title
          items: @config.items
          columns: @config.columns
          selectable: @config.selectable
          selectedItems: @config.selectedItems
          selectionEvent: @config.selectionEvent
          showUpload: @config.showUpload
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          aspectRatio: @config.aspectRatio
          srcField: @config.srcField
          captionField: @config.captionField
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: media-gallery
        })
      MediaGalleryLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @payload.data
          title: @config.title
          items: @config.items
          columns: @config.columns
          selectable: @config.selectable
          selectedItems: @config.selectedItems
          selectionEvent: @config.selectionEvent
          showUpload: @config.showUpload
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          aspectRatio: @config.aspectRatio
          srcField: @config.srcField
          captionField: @config.captionField
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: media-gallery
        })
    }

    emits {
      @config.selectionEvent -> external {
        selection : [string]!
      }
        @description "Event name emitted when selection changes (emitted as UI:{selectionEvent})"
        @tier "essential"
      MediaGalleryLoaded
        @description "MediaGallery rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : MediaGalleryError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc"
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      title : string
        @label "Title"
        @description "Gallery title"
        @tier "presentation"
      items : [MediaGalleryItemsItem] = []
        @label "Items"
        @description "Media items"
        @tier "presentation"
      columns : number = 3
        @label "Columns"
        @description "Column count"
        @tier "presentation"
      selectable : boolean = false
        @label "Selectable"
        @description "Enable item selection"
        @tier "presentation"
      selectedItems : [string] = []
        @label "Selected Items"
        @description "Selected item IDs"
        @tier "presentation"
      selectionEvent : event = "SELECTION"
        @label "Selection Event"
        @description "Event name emitted when selection changes (emitted as UI:{selectionEvent})"
        @tier "presentation"
      showUpload : boolean = false
        @label "Show Upload"
        @description "Show upload button"
        @tier "presentation"
      actions : [MediaGalleryActionsItem] = []
        @label "Actions"
        @description "Actions"
        @tier "presentation"
      aspectRatio : "square" | "landscape" | "portrait" = square
        @label "Aspect Ratio"
        @description "Aspect ratio for thumbnails"
        @tier "presentation"
      srcField : string = src
        @label "Src Field"
        @description "Record field holding each image's URL (entity mode). Default `src`."
        @tier "presentation"
      captionField : string = caption
        @label "Caption Field"
        @description "Record field holding each image's caption (entity mode). Default `caption`."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/media-gallery" as MediaGalleryPage -> MediaGalleryRender
}
