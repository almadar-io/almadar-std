app ui-form [
  version: "1.0.0",
  description: "Form — UI factory (1:1 with the @almadar/ui form pattern)."
]
;; @pattern "form"
orbital FormOrbital {
    type FormLoaded = Event { data : FormItem } "Form row finished loading; payload.data holds the single row"
  type FormFieldsItem = {
    name : string
    field : string
    label : string
    type : string
    inputType : string
    placeholder : string
    required : boolean
    defaultValue : ControlValue
    options : [FormFieldsItemOptionsItem]
    values : [string]
    labels : Map string string
    relation : FormFieldsItemRelation
    min : number
    max : number
    pattern : string
    validation : FormFieldsItemValidation
    readonly : boolean
    disabled : boolean
    hint : string
  }
  type ControlValue = string | number | boolean | [string] | FileValue
  type FileValue = {
    name : string!
    url : string!
    mimeType : string!
    sizeBytes : number!
  }
  type FormFieldsItemOptionsItem = {
    value : string!
    label : string!
  }
  type FormFieldsItemRelation = {
    entity : string!
    displayField : string
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type FormFieldsItemValidation = {
    enum : [string]
  }
  type FormError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type FormRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }
  type FormFieldOverridesItem = {
    name : string!
    label : string
    placeholder : string
    hint : string
  }
  type FormHiddenCalculationsItem = {
    variableName : string!
    expression : SExpr!
    triggerFields : [string]!
  }
  type FormViolationTriggersItem = {
    condition : SExpr!
    violation : FormViolationTriggersItemViolation!
    fieldId : string
  }
  type FormViolationTriggersItemViolation = {
    law : string!
    article : string!
    actionType : "measure" | "admin" | "penalty"!
    message : string!
  }
  type FormEvaluationContext = {
    formValues : Map string ControlValue!
    globalVariables : Map string ControlValue!
    localVariables : Map string ControlValue
    entity : Map string ControlValue
  }
  type FormSectionsItem = {
    id : string!
    title : string!
    condition : SExpr
    fields : [FormSectionsItemFieldsItem]!
    collapsible : boolean
  }
  type FormSectionsItemFieldsItem = {
    name : string
    field : string
    label : string
    type : string
    inputType : string
    placeholder : string
    required : boolean
    defaultValue : ControlValue
    options : [FormSectionsItemFieldsItemOptionsItem]
    values : [string]
    labels : Map string string
    relation : FormSectionsItemFieldsItemRelation
    min : number
    max : number
    pattern : string
    validation : FormSectionsItemFieldsItemValidation
    readonly : boolean
    disabled : boolean
    hint : string
  }
  type FormSectionsItemFieldsItemOptionsItem = {
    value : string!
    label : string!
  }
  type FormSectionsItemFieldsItemRelation = {
    entity : string!
    displayField : string
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type FormSectionsItemFieldsItemValidation = {
    enum : [string]
  }
  type FormFIELDCHANGEChange = {
    fieldId : string!
    value : string | number | boolean | [string] | FormFIELDCHANGEChangeValue!
    formValues : Map string ControlValue!
  }
  type FormFIELDCHANGEChangeValue = {
    name : string!
    url : string!
    mimeType : string!
    sizeBytes : number!
  }

  entity FormItem [runtime] {
    id : string!
  }

  trait FormRender -> @rebindable FormItem [interaction, instance] {
    initial: resolving

    state resolving {
      INIT -> idle when (and @config.selfFetch (!= (str/default ?id "") "") (!= @config.mode "create"))
        (fetch FormItem { id: ?id, emit: { success: FormLoaded } })
        (render-ui main {
          surface: @config.surface
          skeleton: @config.skeleton
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @entity
          mode: @config.mode
          fields: @config.fields
          initialData: @entity
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: form
        })
      INIT -> idle when (not (and @config.selfFetch (!= (str/default ?id "") "") (!= @config.mode "create")))
        (render-ui main {
          surface: @config.surface
          skeleton: @config.skeleton
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @entity
          mode: @config.mode
          fields: @config.fields
          initialData: @entity
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: form
        })
    }

    state idle {
      INIT -> idle
        (render-ui main {
          surface: @config.surface
          skeleton: @config.skeleton
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @entity
          mode: @config.mode
          fields: @config.fields
          initialData: @entity
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: form
        })
      FormLoaded -> idle
        (render-ui main {
          surface: @config.surface
          skeleton: @config.skeleton
          children: @config.children
          onSubmit: @config.onSubmit
          onCancel: @config.onCancel
          layout: @config.layout
          gap: @config.gap
          className: @config.className
          entity: @entity
          mode: @config.mode
          fields: @config.fields
          initialData: @payload.data
          isLoading: @config.isLoading
          error: @config.error
          submitLabel: @config.submitLabel
          cancelLabel: @config.cancelLabel
          showCancel: @config.showCancel
          showSubmit: @config.showSubmit
          title: @config.title
          submitEvent: @config.submitEvent
          cancelEvent: @config.cancelEvent
          relationsData: @config.relationsData
          relationsLoading: @config.relationsLoading
          fieldOverrides: @config.fieldOverrides
          conditionalFields: @config.conditionalFields
          hiddenCalculations: @config.hiddenCalculations
          violationTriggers: @config.violationTriggers
          evaluationContext: @config.evaluationContext
          sections: @config.sections
          onFieldChange: @config.onFieldChange
          configPath: @config.configPath
          repeatable: @config.repeatable
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: form
        })
    }

    emits {
      @config.submitEvent -> external {
        data : @entity!
      }
        @description "Event dispatch props (for trait state machine integration)"
        @tier "essential"
      @config.cancelEvent -> external { }
        @description "Event to dispatch on cancel (defaults to 'CANCEL')"
        @tier "essential"
      @config.onFieldChange -> external {
        change : FormFIELDCHANGEChange
      }
        @description "Callback when any field value changes"
        @tier "essential"
      FormLoaded
        @description "Form row finished loading; payload.data holds the single row."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    listens {
      INIT {
        id : string
      }
        @description "Mount payload; a host that routes to this panel by id (a :id page param) passes it here."
        @tier "internal"
    }

    config {
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface (with card padding) behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none" = form
        @label "Skeleton"
        @description "The shape an empty slot shows while this form's server render is in flight (`none` opts out). @default 'form'"
        @tier "presentation"
      children : node
        @label "Children"
        @description "Form fields (traditional React children)"
        @tier "presentation"
      onSubmit : string
        @label "On Submit"
        @description "Submit event name for trait dispatch (emitted via eventBus as UI:{onSubmit})"
        @tier "presentation"
      onCancel : string
        @label "On Cancel"
        @description "Cancel event name for trait dispatch (emitted via eventBus as UI:{onCancel})"
        @tier "presentation"
      layout : "vertical" | "horizontal" | "inline" = vertical
        @label "Layout"
        @description "Form layout"
        @tier "presentation"
      gap : "sm" | "md" | "lg" = md
        @label "Gap"
        @description "Gap between fields"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      mode : string
        @label "Mode"
        @description "Form mode — 'create' for new records, 'edit' for updating existing. Accepts `string` so schema-driven callers (whose `config.mode` is typed as `string` per the trait's declared config block) compile cleanly. The runtime treats anything other than 'edit' as 'create'."
        @tier "presentation"
      fields : [FormFieldsItem] = [{ name: "Name", field: "Field", label: "Label", type: "Type", inputType: "Input Type", placeholder: "Placeholder", required: false, options: [{ value: "Value", label: "Label" }, { value: "Value 2", label: "Label 2" }], values: ["Item", "Item 2"], relation: { entity: "Entity", displayField: "Display Field", cardinality: one }, min: 1, max: 1, pattern: "Pattern", validation: { enum: ["Item", "Item 2"] }, readonly: false, disabled: false, hint: "Hint" }, { name: "Name 2", field: "Field 2", label: "Label 2", type: "Type 2", inputType: "Input Type 2", placeholder: "Placeholder 2", required: true, options: [{ value: "Value", label: "Label" }, { value: "Value 2", label: "Label 2" }], values: ["Item", "Item 2"], relation: { entity: "Entity 2", displayField: "Display Field 2", cardinality: many }, min: 2, max: 2, pattern: "Pattern 2", validation: { enum: ["Item", "Item 2"] }, readonly: true, disabled: true, hint: "Hint 2" }]
        @label "Fields"
        @description "Fields definition (schema format) - accepts readonly for generated const arrays"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : FormError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      submitLabel : string
        @label "Submit Label"
        @description "Submit button label"
        @tier "presentation"
      cancelLabel : string
        @label "Cancel Label"
        @description "Cancel button label (if provided, shows cancel button)"
        @tier "presentation"
      showCancel : boolean
        @label "Show Cancel"
        @description "Show cancel button (defaults to true for schema forms)"
        @tier "presentation"
      showSubmit : boolean = true
        @label "Show Submit"
        @description "Show submit button (defaults to true for schema forms). Set false when a parent atom owns the submit action externally (e.g. wizard footers)."
        @tier "presentation"
      title : string
        @label "Title"
        @description "Form title (used by ModalSlot to extract title)"
        @tier "presentation"
      submitEvent : event = "SUBMIT"
        @label "Submit Event"
        @description "Event dispatch props (for trait state machine integration)"
        @tier "presentation"
      cancelEvent : event = "CANCEL"
        @label "Cancel Event"
        @description "Event to dispatch on cancel (defaults to 'CANCEL')"
        @tier "presentation"
      relationsData : Map string [FormRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation data props"
        @tier "presentation"
      relationsLoading : Map string boolean = {}
        @label "Relations Loading"
        @description "Loading state for relation data: { fieldName: boolean }"
        @tier "presentation"
      fieldOverrides : [FormFieldOverridesItem] = []
        @label "Field Overrides"
        @description "Per-field display-copy overrides (label/placeholder/hint), merged by field name over the schema-enriched fields."
        @tier "presentation"
      conditionalFields : Map string SExpr = {}
        @label "Conditional Fields"
        @description "Inspection form extensions"
        @tier "presentation"
      hiddenCalculations : [FormHiddenCalculationsItem] = []
        @label "Hidden Calculations"
        @description "Hidden calculations that emit GLOBAL_VARIABLE_SET on field change (boolean true means enabled but config loaded separately)"
        @tier "presentation"
      violationTriggers : [FormViolationTriggersItem] = []
        @label "Violation Triggers"
        @description "Violation conditions that emit VIOLATION_DETECTED when met (boolean true means enabled but config loaded separately)"
        @tier "presentation"
      evaluationContext : FormEvaluationContext
        @label "Evaluation Context"
        @description "Context for S-expression evaluation"
        @tier "presentation"
      sections : [FormSectionsItem] = []
        @label "Sections"
        @description "Nested form sections with optional conditions"
        @tier "presentation"
      onFieldChange : event = "FIELD_CHANGE"
        @label "On Field Change"
        @description "Callback when any field value changes"
        @tier "presentation"
      configPath : string
        @label "Config Path"
        @description "Config path for form configuration (schema-driven)"
        @tier "presentation"
      repeatable : boolean
        @label "Repeatable"
        @description "Whether the form supports repeatable entries"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own row on mount?"
        @description "true (default) = a mount that carries an id loads that one row (never the collection); a create-mode mount skips the load. false = a composing atom owns the load."
        @tier "internal"
    }
  }

  page "/form" as FormPage -> FormRender
}
