app ui-segment-renderer [
  version: "1.0.0",
  description: "SegmentRenderer — UI factory (1:1 with the @almadar/ui segment-renderer pattern)."
]
;; @pattern "segment-renderer"
orbital SegmentRendererOrbital {
  type SegmentRendererSegmentsItem = SegmentRendererSegmentsItemMarkdown | SegmentRendererSegmentsItemCode | SegmentRendererSegmentsItemQuiz | SegmentRendererSegmentsItemActivate | SegmentRendererSegmentsItemConnect | SegmentRendererSegmentsItemReflect | SegmentRendererSegmentsItemBloom | SegmentRendererSegmentsItemVisualization
  type SegmentRendererSegmentsItemMarkdown = {
    type : "markdown"!
    content : string!
  }
  type SegmentRendererSegmentsItemCode = {
    type : "code"!
    language : string!
    content : string!
    runnable : boolean
  }
  type SegmentRendererSegmentsItemQuiz = {
    type : "quiz"!
    question : string!
    answer : string!
  }
  type SegmentRendererSegmentsItemActivate = {
    type : "activate"!
    question : string!
  }
  type SegmentRendererSegmentsItemConnect = {
    type : "connect"!
    content : string!
  }
  type SegmentRendererSegmentsItemReflect = {
    type : "reflect"!
    prompt : string!
  }
  type SegmentRendererSegmentsItemBloom = {
    type : "bloom"!
    level : "remember" | "understand" | "apply" | "analyze" | "evaluate" | "create"!
    question : string!
    answer : string!
  }
  type SegmentRendererSegmentsItemVisualization = {
    type : "visualization"!
    visualizationType : "algorithms" | "math" | "physics" | "biology" | "chemistry" | "probability"!
    description : string!
  }
  type SegmentRendererAnnotationsItem = {
    id : string!
    text : string!
    kind : "question" | "note"!
  }
  type SegmentRendererUserProgress = {
    activationResponse : string
    reflectionNotes : [string]
    bloomAnswered : Map string boolean
  }
  type SegmentRendererCodeOutputsValue = {
    stdout : string!
    stderr : string!
    exitCode : number!
    testResults : [SegmentRendererCodeOutputsValueTestResultsItem]!
  }
  type SegmentRendererCodeOutputsValueTestResultsItem = {
    input : string!
    expectedOutput : string!
    actualOutput : string!
    passed : boolean!
  }

  entity SegmentRendererItem [runtime] {
    id : string!
  }

  trait SegmentRendererRender -> @rebindable SegmentRendererItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          segments: @config.segments
          lesson: @config.lesson
          activationSaveEvent: @config.activationSaveEvent
          reflectionSaveEvent: @config.reflectionSaveEvent
          bloomAnswerEvent: @config.bloomAnswerEvent
          askEvent: @config.askEvent
          noteEvent: @config.noteEvent
          askLabel: @config.askLabel
          noteLabel: @config.noteLabel
          annotations: @config.annotations
          annotationEvent: @config.annotationEvent
          className: @config.className
          containerClassName: @config.containerClassName
          userProgress: @config.userProgress
          runCodeEvent: @config.runCodeEvent
          resetCodeEvent: @config.resetCodeEvent
          codeOutputs: @config.codeOutputs
          runningCode: @config.runningCode
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: segment-renderer
        })
    }

    emits {
      @config.activationSaveEvent -> external {
        response : string!
      }
        @description "Event emitted when the activation prompt is saved or skipped (as `UI:<activationSaveEvent>`)"
        @tier "essential"
      @config.reflectionSaveEvent -> external {
        index : number!
        note : string!
      }
        @description "Event emitted when a reflection note is saved (as `UI:<reflectionSaveEvent>`)"
        @tier "essential"
      @config.bloomAnswerEvent -> external {
        index : number!
        level : "remember" | "understand" | "apply" | "analyze" | "evaluate" | "create"!
      }
        @description "Event emitted on the first reveal of a Bloom question (as `UI:<bloomAnswerEvent>`)"
        @tier "essential"
      @config.askEvent -> external {
        selectedText : string!
      }
        @description "Event emitted when the reader picks Ask on selected text (as `UI:<askEvent>`)"
        @tier "essential"
      @config.noteEvent -> external {
        selectedText : string!
      }
        @description "Event emitted when the reader picks Note on selected text (as `UI:<noteEvent>`)"
        @tier "essential"
      @config.annotationEvent -> external {
        annotationId : string
      }
        @description "Event emitted when a highlighted passage is clicked (as `UI:<annotationEvent>`)"
        @tier "essential"
      @config.runCodeEvent -> external {
        code : string!
        language : string!
        runId : string!
      }
        @description "Event a runnable code block emits on Run (`{ code, language, runId }`, runId = the segment index). Omit to render runnable blocks read-only."
        @tier "essential"
      @config.resetCodeEvent -> external {
        runId : string!
      }
        @description "Event a runnable code block emits on Reset (`{ runId }`)."
        @tier "essential"
    }

    config {
      segments : [SegmentRendererSegmentsItem] = []
        @label "Segments"
        @description "Parsed lesson segments (see `parseLessonSegments`). Ignored when `lesson` is given."
        @tier "presentation"
      lesson : string
        @label "Lesson"
        @description "Raw lesson markdown with learning tags; parsed with `parseLessonSegments` and rendered"
        @tier "presentation"
      activationSaveEvent : event = "ACTIVATION_SAVE"
        @label "Activation Save Event"
        @description "Event emitted when the activation prompt is saved or skipped (as `UI:<activationSaveEvent>`)"
        @tier "presentation"
      reflectionSaveEvent : event = "REFLECTION_SAVE"
        @label "Reflection Save Event"
        @description "Event emitted when a reflection note is saved (as `UI:<reflectionSaveEvent>`)"
        @tier "presentation"
      bloomAnswerEvent : event = "BLOOM_ANSWER"
        @label "Bloom Answer Event"
        @description "Event emitted on the first reveal of a Bloom question (as `UI:<bloomAnswerEvent>`)"
        @tier "presentation"
      askEvent : event = "ASK"
        @label "Ask Event"
        @description "Event emitted when the reader picks Ask on selected text (as `UI:<askEvent>`)"
        @tier "presentation"
      noteEvent : event = "NOTE"
        @label "Note Event"
        @description "Event emitted when the reader picks Note on selected text (as `UI:<noteEvent>`)"
        @tier "presentation"
      askLabel : string
        @label "Ask Label"
        @description "Ask action label (default: translated)"
        @tier "presentation"
      noteLabel : string
        @label "Note Label"
        @description "Note action label (default: translated)"
        @tier "presentation"
      annotations : [SegmentRendererAnnotationsItem] = []
        @label "Annotations"
        @description "Passages to highlight. Each `text` is matched exactly against the markdown segments, first segment whose source contains it, first occurrence inside one rendered text node (outside code); one that spans formatting is not highlighted."
        @tier "presentation"
      annotationEvent : event = "ANNOTATION"
        @label "Annotation Event"
        @description "Event emitted when a highlighted passage is clicked (as `UI:<annotationEvent>`)"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes for the root container"
        @tier "presentation"
      containerClassName : string
        @label "Container Class Name"
        @description "CSS classes for the outer wrapping div"
        @tier "presentation"
      userProgress : SegmentRendererUserProgress
        @label "User Progress"
        @description "User progress for restoring activation/reflection state"
        @tier "presentation"
      runCodeEvent : event = "RUN_CODE"
        @label "Run Code Event"
        @description "Event a runnable code block emits on Run (`{ code, language, runId }`, runId = the segment index). Omit to render runnable blocks read-only."
        @tier "presentation"
      resetCodeEvent : event = "RESET_CODE"
        @label "Reset Code Event"
        @description "Event a runnable code block emits on Reset (`{ runId }`)."
        @tier "presentation"
      codeOutputs : Map string SegmentRendererCodeOutputsValue = { item: { stdout: "Stdout", stderr: "Stderr", exitCode: 1, testResults: [{ input: "Input", expectedOutput: "Expected Output", actualOutput: "Actual Output", passed: false }, { input: "Input 2", expectedOutput: "Expected Output 2", actualOutput: "Actual Output 2", passed: true }] } }
        @label "Code Outputs"
        @description "The program's run results, keyed by segment runId."
        @tier "presentation"
      runningCode : string
        @label "Running Code"
        @description "The runId the program is currently running."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/segment-renderer" as SegmentRendererPage -> SegmentRendererRender
}
