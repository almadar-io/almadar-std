app ui-stat-card [
  version: "1.0.0",
  description: "StatCard — UI factory (1:1 with the @almadar/ui stat-card pattern)."
]
;; @pattern "stat-card"
orbital StatCardOrbital {
    type StatCardLoaded = Event { data : [StatCardItem] } "StatCard rows finished loading; payload.data holds the collection"
  type StatCardError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type StatCardAction = {
    label : string!
    event : string
    navigatesTo : string
  }
  type StatCardMetricsItem = {
    field : string
    label : string!
    value : string
    icon : icon
    format : string
    aggregate : "count" | "sum"
    filter : StatCardMetricsItemFilter
  }
  type StatCardMetricsItemFilter = {
    field : string!
    equals : string!
  }

  entity StatCardItem [runtime] {
    id : string!
  }

  trait StatCardRender -> @rebindable StatCardItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch StatCardItem { emit: { success: StatCardLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          label: @config.label
          title: @config.title
          value: @config.value
          previousValue: @config.previousValue
          currentValue: @config.currentValue
          trend: @config.trend
          trendDirection: @config.trendDirection
          invertTrend: @config.invertTrend
          icon: @config.icon
          iconBg: @config.iconBg
          iconColor: @config.iconColor
          subtitle: @config.subtitle
          action: @config.action
          metrics: @config.metrics
          compact: @config.compact
          sparklineData: @config.sparklineData
          surface: @config.surface
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: stat-card
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          label: @config.label
          title: @config.title
          value: @config.value
          previousValue: @config.previousValue
          currentValue: @config.currentValue
          trend: @config.trend
          trendDirection: @config.trendDirection
          invertTrend: @config.invertTrend
          icon: @config.icon
          iconBg: @config.iconBg
          iconColor: @config.iconColor
          subtitle: @config.subtitle
          action: @config.action
          metrics: @config.metrics
          compact: @config.compact
          sparklineData: @config.sparklineData
          surface: @config.surface
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: stat-card
        })
      StatCardLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @payload.data
          label: @config.label
          title: @config.title
          value: @config.value
          previousValue: @config.previousValue
          currentValue: @config.currentValue
          trend: @config.trend
          trendDirection: @config.trendDirection
          invertTrend: @config.invertTrend
          icon: @config.icon
          iconBg: @config.iconBg
          iconColor: @config.iconColor
          subtitle: @config.subtitle
          action: @config.action
          metrics: @config.metrics
          compact: @config.compact
          sparklineData: @config.sparklineData
          surface: @config.surface
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: stat-card
        })
    }

    emits {
      StatCardLoaded
        @description "StatCard rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : StatCardError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc"
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      label : string
        @label "Label"
        @description "Main label"
        @tier "presentation"
      title : string
        @label "Title"
        @description "Title (alias for label)"
        @tier "presentation"
      value : [string] = []
        @label "Value"
        @description "Primary value - accepts array from generated code (will use first element or length)"
        @tier "presentation"
      previousValue : number
        @label "Previous Value"
        @description "Previous value for comparison"
        @tier "presentation"
      currentValue : number
        @label "Current Value"
        @description "Current value as number for trend calculation"
        @tier "presentation"
      trend : number
        @label "Trend"
        @description "Manual trend percentage (overrides calculation)"
        @tier "presentation"
      trendDirection : "up" | "down" | "neutral"
        @label "Trend Direction"
        @description "Trend direction (overrides calculation)"
        @tier "presentation"
      invertTrend : boolean = false
        @label "Invert Trend"
        @description "Whether up is good (green) or bad (red)"
        @tier "presentation"
      icon : icon
        @label "Icon"
        @description "Icon to display (Lucide component or icon name string)"
        @tier "presentation"
      iconBg : string = "bg-muted"
        @label "Icon Bg"
        @description "Icon background color"
        @tier "presentation"
      iconColor : string = "text-foreground"
        @label "Icon Color"
        @description "Icon color"
        @tier "presentation"
      subtitle : string
        @label "Subtitle"
        @description "Subtitle or description"
        @tier "presentation"
      action : StatCardAction
        @label "Action"
        @description "Action button"
        @tier "presentation"
      metrics : [StatCardMetricsItem] = []
        @label "Metrics"
        @description "Metrics to display (schema format) - accepts readonly for compatibility with generated const arrays"
        @tier "presentation"
      compact : boolean
        @label "Compact"
        @description "Compact display mode"
        @tier "presentation"
      sparklineData : [number] = []
        @label "Sparkline Data"
        @description "Sparkline data points for an inline trend chart"
        @tier "presentation"
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/stat-card" as StatCardPage -> StatCardRender
}
