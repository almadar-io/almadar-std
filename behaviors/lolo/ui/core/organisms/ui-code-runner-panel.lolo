app ui-code-runner-panel [
  version: "1.0.0",
  description: "CodeRunnerPanel — UI factory (1:1 with the @almadar/ui code-runner-panel pattern)."
]
;; @pattern "code-runner-panel"
orbital CodeRunnerPanelOrbital {
  type CodeRunnerPanelOutput = {
    stdout : string!
    stderr : string!
    exitCode : number!
    testResults : [CodeRunnerPanelOutputTestResultsItem]!
  }
  type CodeRunnerPanelOutputTestResultsItem = {
    input : string!
    expectedOutput : string!
    actualOutput : string!
    passed : boolean!
  }

  entity CodeRunnerPanelItem [runtime] {
    id : string!
    code : string @intrinsic = ""
    language : string @intrinsic = ""
    runId : string @intrinsic
  }

  trait CodeRunnerPanelRender -> @rebindable CodeRunnerPanelItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.code @config.code)
        (set @entity.language @config.language)
        (set @entity.runId @config.runId)
        (render-ui main {
          code: @entity.code
          language: @entity.language
          runnable: @config.runnable
          runEvent: @config.runEvent
          resetEvent: @config.resetEvent
          runId: @entity.runId
          output: @config.output
          running: @config.running
          error: @config.error
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-runner-panel
        })
      RUN -> idle
        (set @entity.code ?code)
        (set @entity.language ?language)
        (set @entity.runId ?runId)
        (render-ui main {
          code: @entity.code
          language: @entity.language
          runnable: @config.runnable
          runEvent: @config.runEvent
          resetEvent: @config.resetEvent
          runId: @entity.runId
          output: @config.output
          running: @config.running
          error: @config.error
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-runner-panel
        })
      RESET -> idle
        (set @entity.runId ?runId)
        (render-ui main {
          code: @entity.code
          language: @entity.language
          runnable: @config.runnable
          runEvent: @config.runEvent
          resetEvent: @config.resetEvent
          runId: @entity.runId
          output: @config.output
          running: @config.running
          error: @config.error
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-runner-panel
        })
    }

    emits {
      @config.runEvent -> external {
        code : string!
        language : string!
        runId : string!
      }
        @description "Event emitted on Run as `UI:<runEvent>` with `{ code, language, runId }`. Defaults to 'RUN_CODE'."
        @tier "essential"
      @config.resetEvent -> external {
        runId : string!
      }
        @description "Event emitted on Reset as `UI:<resetEvent>` with `{ runId }`; Reset only restores the code when absent."
        @tier "essential"
    }

    listens {
      RUN {
        code : string!
        language : string!
        runId : string!
      }
      RESET {
        runId : string!
      }
    }

    config {
      code : string = ""
        @label "Code"
        @description "Initial code content"
        @tier "presentation"
      language : string = ""
        @label "Language"
        @description "Programming language for syntax highlighting"
        @tier "presentation"
      runnable : boolean = false
        @label "Runnable"
        @description "Whether the panel is editable and runnable (default false = read-only code block)"
        @tier "presentation"
      runEvent : event = "RUN"
        @label "Run Event"
        @description "Event emitted on Run as `UI:<runEvent>` with `{ code, language, runId }`. Defaults to 'RUN_CODE'."
        @tier "presentation"
      resetEvent : event = "RESET"
        @label "Reset Event"
        @description "Event emitted on Reset as `UI:<resetEvent>` with `{ runId }`; Reset only restores the code when absent."
        @tier "presentation"
      runId : string
        @label "Run Id"
        @description "Identifies this panel in its run/reset payloads (e.g. a lesson segment); empty when one panel stands alone."
        @tier "presentation"
      output : CodeRunnerPanelOutput
        @label "Output"
        @description "The program's result for the last run, bound back into the panel."
        @tier "presentation"
      running : boolean = false
        @label "Running"
        @description "True while the program is running the code."
        @tier "presentation"
      error : string
        @label "Error"
        @description "A run failure message from the program; replaces the output body."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/code-runner-panel" as CodeRunnerPanelPage -> CodeRunnerPanelRender
}
