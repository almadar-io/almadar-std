app ui-entity-table "1.0.0"
"EntityTable — UI factory (1:1 with the @almadar/ui entity-table pattern)."
;; @pattern "entity-table"
orbital EntityTableOrbital {
    type EntityTableLoaded = Event { data : [EntityTableItem] } "EntityTable rows finished loading; payload.data holds the collection"
  type EntityTableError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type EntityTableFieldsItem = {
    key : string
    header : string
    name : string
    label : string
    width : string
    sortable : boolean
    align : "left" | "center" | "right"
    format : "date" | "datetime" | "currency" | "number" | "boolean" | "percent"
  }
  type EntityTableColumnsItem = {
    key : string
    header : string
    name : string
    label : string
    width : string
    sortable : boolean
    align : "left" | "center" | "right"
    format : "date" | "datetime" | "currency" | "number" | "boolean" | "percent"
  }
  type EntityTableItemActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    placement : string
    icon : icon
    variant : string
    when : SExpr
    payload : SExpr
    roles : [string]
  }
  type EntityTableEmptyAction = {
    label : string!
    event : event
  }
  type EntityTableRowActionsItem = {
    label : string!
    icon : icon
    variant : "default" | "danger"
    event : event
    when : SExpr
    payload : SExpr
    roles : [string]
  }
  type EntityTableBulkActionsItem = {
    label : string!
    icon : icon
    variant : "default" | "danger"
    event : event
    roles : [string]
  }
  type EntityTableRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }

  entity EntityTableItem [runtime] {
    id : string!
  }

  trait EntityTableRender -> @rebindable EntityTableItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch EntityTableItem { emit: { success: EntityTableLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          fields: @config.fields
          columns: @config.columns
          itemClickEvent: @config.itemClickEvent
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          selectable: @config.selectable
          searchable: @config.searchable
          searchPlaceholder: @config.searchPlaceholder
          rowActions: (array/filter @config.rowActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          bulkActions: (array/filter @config.bulkActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          headerActions: @config.headerActions
          showTotal: @config.showTotal
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: entity-table
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          fields: @config.fields
          columns: @config.columns
          itemClickEvent: @config.itemClickEvent
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          selectable: @config.selectable
          searchable: @config.searchable
          searchPlaceholder: @config.searchPlaceholder
          rowActions: (array/filter @config.rowActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          bulkActions: (array/filter @config.bulkActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          headerActions: @config.headerActions
          showTotal: @config.showTotal
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: entity-table
        })
      EntityTableLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @payload.data
          fields: @config.fields
          columns: @config.columns
          itemClickEvent: @config.itemClickEvent
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          selectable: @config.selectable
          searchable: @config.searchable
          searchPlaceholder: @config.searchPlaceholder
          rowActions: (array/filter @config.rowActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          bulkActions: (array/filter @config.bulkActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          headerActions: @config.headerActions
          showTotal: @config.showTotal
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: entity-table
        })
    }

    emits {
      @config.itemClickEvent -> external {
        id : string!
        row : @entity!
      }
        @description "When set, rows are activatable and emit UI:{itemClickEvent} with { id, row }"
        @tier "essential"
      VIEW -> external {
        id : string!
        row : @entity!
      }
        @description "User opened a record from the list."
        @tier "essential"
      EntityTableLoaded
        @description "EntityTable rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : EntityTableError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc" = asc
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      fields : [EntityTableFieldsItem] = [{ key: "Key", header: "Header", name: "Name", label: "Label", width: "Width", sortable: false, align: left, format: date }, { key: "Key 2", header: "Header 2", name: "Name 2", label: "Label 2", width: "Width 2", sortable: true, align: center, format: datetime }]
        @label "Fields"
        @description "Fields to display - accepts string[] or Column[] for unified interface. Alias for columns"
        @tier "presentation"
      columns : [EntityTableColumnsItem] = []
        @label "Columns"
        @description "Columns can be Column objects or simple string field names"
        @tier "presentation"
      itemClickEvent : event = "ITEM_CLICK"
        @label "Item Click Event"
        @description "When set, rows are activatable and emit UI:{itemClickEvent} with { id, row }"
        @tier "presentation"
      itemActions : [EntityTableItemActionsItem] = [{ event: VIEW, label: View, variant: ghost }]
        @label "Item Actions"
        @description "Item actions from generated code - maps to rowActions"
        @tier "presentation"
      emptyIcon : icon
        @label "Empty Icon"
        @description "emptyIcon prop"
        @tier "presentation"
      emptyTitle : string
        @label "Empty Title"
        @description "emptyTitle prop"
        @tier "presentation"
      emptyDescription : string
        @label "Empty Description"
        @description "emptyDescription prop"
        @tier "presentation"
      emptyAction : EntityTableEmptyAction
        @label "Empty Action"
        @description "emptyAction prop"
        @tier "presentation"
      selectable : boolean = false
        @label "Selectable"
        @description "Selection"
        @tier "presentation"
      searchable : boolean = false
        @label "Searchable"
        @description "Search"
        @tier "presentation"
      searchPlaceholder : string
        @label "Search Placeholder"
        @description "searchPlaceholder prop"
        @tier "presentation"
      rowActions : [EntityTableRowActionsItem] = []
        @label "Row Actions"
        @description "Row actions"
        @tier "presentation"
      bulkActions : [EntityTableBulkActionsItem] = []
        @label "Bulk Actions"
        @description "Bulk actions"
        @tier "presentation"
      headerActions : node
        @label "Header Actions"
        @description "Header actions"
        @tier "presentation"
      showTotal : boolean = true
        @label "Show Total"
        @description "Show total count in pagination"
        @tier "presentation"
      look : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Look"
        @description "Layer 2 visual treatment — orthogonal to the semantic variant."
        @tier "presentation"
      relationsData : Map string [EntityTableRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names for a column whose field is relation-typed. Same contract DetailPanel takes."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/entity-table" as EntityTablePage -> EntityTableRender
}
