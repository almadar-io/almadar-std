app ui-detail-panel [
  version: "1.0.0",
  description: "DetailPanel — UI factory (1:1 with the @almadar/ui detail-panel pattern)."
]
;; @pattern "detail-panel"
orbital DetailPanelOrbital {
    type DetailPanelLoaded = Event { data : DetailPanelItem } "DetailPanel row finished loading; payload.data holds the single row"
  type DetailPanelError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type DetailPanelStatus = {
    label : string!
    variant : "default" | "success" | "warning" | "danger" | "info"
  }
  type DetailPanelSectionsItem = {
    title : string!
    fields : [DetailPanelSectionsItemFieldsItem]!
  }
  type DetailPanelSectionsItemFieldsItem = {
    label : string!
    value : node!
    icon : icon
    copyable : boolean
  }
  type DetailPanelActionsItem = {
    label : string!
    icon : icon
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost" | "danger"
    when : SExpr
    payload : SExpr
    roles : [string]
  }
  type DetailPanelBackAction = {
    label : string!
    icon : icon
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost" | "danger"
    when : SExpr
    payload : SExpr
  }
  type DetailPanelFieldsItem = {
    name : string!
    label : string
    icon : icon
    variant : "h3" | "h4" | "overline" | "avatar" | "body" | "caption" | "badge" | "small" | "progress"
    format : "date" | "time" | "datetime" | "currency" | "number" | "boolean" | "percent"
    colorMap : Map string DetailPanelFieldsItemColorMapValue
    labels : Map string string
    type : string
    values : [string]
    relation : DetailPanelFieldsItemRelation
  }
  type DetailPanelFieldsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type DetailPanelFieldsItemRelation = {
    entity : string!
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type DetailPanelRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }
  type DetailPanelStagesItem = {
    value : string!
    label : string!
  }
  type DetailPanelActivityItem = {
    id : string!
    title : string!
    description : string
    date : string
    status : "complete" | "active" | "pending" | "error"
    icon : icon
    tags : [string]
  }
  type DetailPanelLineItemColumnsItem = {
    key : string!
    field : string
    header : string
    label : string
    width : string
    align : "left" | "center" | "right"
    className : string
    weight : "normal" | "medium" | "semibold"
    format : "badge" | "date" | "currency" | "number" | "percent" | "boolean"
    colorMap : Map string DetailPanelLineItemColumnsItemColorMapValue
    labels : Map string string
    variant : "h3" | "h4"
    icon : icon
    sortable : boolean
  }
  type DetailPanelLineItemColumnsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type DetailPanelTotalsItem = {
    name : string!
    label : string
    icon : icon
    variant : "h3" | "h4" | "overline" | "avatar" | "body" | "caption" | "badge" | "small" | "progress"
    format : "date" | "time" | "datetime" | "currency" | "number" | "boolean" | "percent"
    colorMap : Map string DetailPanelTotalsItemColorMapValue
    labels : Map string string
    type : string
    values : [string]
    relation : DetailPanelTotalsItemRelation
  }
  type DetailPanelTotalsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type DetailPanelTotalsItemRelation = {
    entity : string!
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type ReplyNodeRow = {
    authorName : string
    content : string
    authorAvatarUrl : string
    postedAt : string
    voteCount : number
    userVote : "up" | "down" | "none"
    collapsed : boolean
    replies : [ReplyNodeRow]
  }
  type DetailPanelTabsItem = {
    id : string!
    label : string!
    fields : [string]
    content : node
  }

  entity DetailPanelItem [runtime] {
    id : string!
    authorName : string = "Author Name"
    content : string = "Content"
    authorAvatarUrl : string = "Author Avatar Url"
    postedAt : string = "Posted At"
    voteCount : number = 1
    userVote : "up" | "down" | "none" = up
    collapsed : boolean = false
    replies : [ReplyNodeRow] = []
  }

  trait DetailPanelRender -> @rebindable DetailPanelItem [interaction, instance] {
    initial: resolving

    state resolving {
      INIT -> idle when (and @config.selfFetch (!= (str/default ?id "") "") (!= @config.mode "create"))
        (fetch DetailPanelItem { id: ?id, emit: { success: DetailPanelLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          skeleton: @config.skeleton
          entity: @entity
          title: @config.title
          onTitleCommit: @config.onTitleCommit
          subtitle: @config.subtitle
          status: @config.status
          avatar: @config.avatar
          sections: @config.sections
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          backAction: @config.backAction
          closeEvent: @config.closeEvent
          footer: @config.footer
          slideOver: @config.slideOver
          surface: @config.surface
          fields: @config.fields
          fieldNames: @config.fieldNames
          initialData: @entity
          mode: @config.mode
          position: @config.position
          width: @config.width
          displayFields: @config.displayFields
          showActions: @config.showActions
          relationsData: @config.relationsData
          look: @config.look
          avatarField: @config.avatarField
          coverField: @config.coverField
          mediaField: @config.mediaField
          stageField: @config.stageField
          stages: @config.stages
          activity: @config.activity
          activityContent: @config.activityContent
          latitudeField: @config.latitudeField
          longitudeField: @config.longitudeField
          lineItems: @entity
          lineItemColumns: @config.lineItemColumns
          lineItemsContent: @config.lineItemsContent
          totals: @config.totals
          thread: @entity
          threadContent: @config.threadContent
          tabs: @config.tabs
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: detail-panel
        })
      INIT -> idle when (not (and @config.selfFetch (!= (str/default ?id "") "") (!= @config.mode "create")))
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          skeleton: @config.skeleton
          entity: @entity
          title: @config.title
          onTitleCommit: @config.onTitleCommit
          subtitle: @config.subtitle
          status: @config.status
          avatar: @config.avatar
          sections: @config.sections
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          backAction: @config.backAction
          closeEvent: @config.closeEvent
          footer: @config.footer
          slideOver: @config.slideOver
          surface: @config.surface
          fields: @config.fields
          fieldNames: @config.fieldNames
          initialData: @entity
          mode: @config.mode
          position: @config.position
          width: @config.width
          displayFields: @config.displayFields
          showActions: @config.showActions
          relationsData: @config.relationsData
          look: @config.look
          avatarField: @config.avatarField
          coverField: @config.coverField
          mediaField: @config.mediaField
          stageField: @config.stageField
          stages: @config.stages
          activity: @config.activity
          activityContent: @config.activityContent
          latitudeField: @config.latitudeField
          longitudeField: @config.longitudeField
          lineItems: @entity
          lineItemColumns: @config.lineItemColumns
          lineItemsContent: @config.lineItemsContent
          totals: @config.totals
          thread: @entity
          threadContent: @config.threadContent
          tabs: @config.tabs
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: detail-panel
        })
    }

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          skeleton: @config.skeleton
          entity: @entity
          title: @config.title
          onTitleCommit: @config.onTitleCommit
          subtitle: @config.subtitle
          status: @config.status
          avatar: @config.avatar
          sections: @config.sections
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          backAction: @config.backAction
          closeEvent: @config.closeEvent
          footer: @config.footer
          slideOver: @config.slideOver
          surface: @config.surface
          fields: @config.fields
          fieldNames: @config.fieldNames
          initialData: @entity
          mode: @config.mode
          position: @config.position
          width: @config.width
          displayFields: @config.displayFields
          showActions: @config.showActions
          relationsData: @config.relationsData
          look: @config.look
          avatarField: @config.avatarField
          coverField: @config.coverField
          mediaField: @config.mediaField
          stageField: @config.stageField
          stages: @config.stages
          activity: @config.activity
          activityContent: @config.activityContent
          latitudeField: @config.latitudeField
          longitudeField: @config.longitudeField
          lineItems: @entity
          lineItemColumns: @config.lineItemColumns
          lineItemsContent: @config.lineItemsContent
          totals: @config.totals
          thread: @entity
          threadContent: @config.threadContent
          tabs: @config.tabs
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: detail-panel
        })
      DetailPanelLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          skeleton: @config.skeleton
          entity: @payload.data
          title: @config.title
          onTitleCommit: @config.onTitleCommit
          subtitle: @config.subtitle
          status: @config.status
          avatar: @config.avatar
          sections: @config.sections
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          backAction: @config.backAction
          closeEvent: @config.closeEvent
          footer: @config.footer
          slideOver: @config.slideOver
          surface: @config.surface
          fields: @config.fields
          fieldNames: @config.fieldNames
          initialData: @payload.data
          mode: @config.mode
          position: @config.position
          width: @config.width
          displayFields: @config.displayFields
          showActions: @config.showActions
          relationsData: @config.relationsData
          look: @config.look
          avatarField: @config.avatarField
          coverField: @config.coverField
          mediaField: @config.mediaField
          stageField: @config.stageField
          stages: @config.stages
          activity: @config.activity
          activityContent: @config.activityContent
          latitudeField: @config.latitudeField
          longitudeField: @config.longitudeField
          lineItems: @entity
          lineItemColumns: @config.lineItemColumns
          lineItemsContent: @config.lineItemsContent
          totals: @config.totals
          thread: @entity
          threadContent: @config.threadContent
          tabs: @config.tabs
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: detail-panel
        })
    }

    emits {
      @config.closeEvent -> external { }
        @description "The event of the declared action that dismisses the panel. The matching action renders as the header close ×; omitted, no × is drawn."
        @tier "essential"
      DetailPanelLoaded
        @description "DetailPanel row finished loading; payload.data holds the single row."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    listens {
      INIT {
        id : string
      }
        @description "Mount payload; a host that routes to this panel by id (a :id page param) passes it here."
        @tier "internal"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : DetailPanelError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc"
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none" = detail
        @label "Skeleton"
        @description "Skeleton drawn while loading, and the shape an empty slot shows while this element's server render is in flight (`none` opts out)."
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      onTitleCommit : event = ""
        @label "On Title Commit"
        @description "When bound, the title becomes editable in place: clicking it swaps the heading for an input, Enter or blur commits, Escape reverts. Receives the committed title and the record's id so the host can persist a partial update. Unbound, the title stays a plain heading."
        @tier "presentation"
      subtitle : string
        @label "Subtitle"
        @description "subtitle prop"
        @tier "presentation"
      status : DetailPanelStatus
        @label "Status"
        @description "status prop"
        @tier "presentation"
      avatar : node
        @label "Avatar"
        @description "avatar prop"
        @tier "presentation"
      sections : [DetailPanelSectionsItem] = []
        @label "Sections"
        @description "sections prop"
        @tier "presentation"
      actions : [DetailPanelActionsItem] = []
        @label "Actions"
        @description "Unified actions array - first action with variant='primary' is the main action"
        @tier "presentation"
      maxInlineActions : number = 2
        @label "Max Inline Actions"
        @description "Max inline action buttons before the rest collapse into a '⋯' overflow menu (mirrors DataGrid's maxInlineActions). Defaults to 2 — primary + secondary visible, the rest under the menu — so every detail panel carries the same action pattern."
        @tier "presentation"
      backAction : DetailPanelBackAction
        @label "Back Action"
        @description "Navigation-back affordance. Renders top-LEFT before the title (OS/back convention — Almadar_UX §8.4), spatially separated from the right-aligned action buttons + close X. Never inferred from actions[] labels."
        @tier "presentation"
      closeEvent : event = "CLOSE"
        @label "Close Event"
        @description "The event of the declared action that dismisses the panel. The matching action renders as the header close ×; omitted, no × is drawn."
        @tier "presentation"
      footer : node
        @label "Footer"
        @description "footer prop"
        @tier "presentation"
      slideOver : boolean = false
        @label "Slide Over"
        @description "slideOver prop"
        @tier "presentation"
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out. Inline mode only; the slide-over is itself a surface."
        @tier "presentation"
      fields : [DetailPanelFieldsItem] = [{ name: "Name", label: "Label", icon: "circle", variant: h3, format: date, type: "Type", values: ["Item", "Item 2"], relation: { entity: "Entity", cardinality: one } }, { name: "Name 2", label: "Label 2", icon: "circle", variant: h4, format: time, type: "Type 2", values: ["Item", "Item 2"], relation: { entity: "Entity 2", cardinality: many } }]
        @label "Fields"
        @description "Fields to display: field names, or declared fields ({ name, label, variant, format, colorMap, labels })"
        @tier "presentation"
      fieldNames : [string] = []
        @label "Field Names"
        @description "Alias for fields - backwards compatibility"
        @tier "presentation"
      mode : string
        @label "Mode"
        @description "Display mode (passed by compiler)"
        @tier "presentation"
      position : "left" | "right"
        @label "Position"
        @description "Panel position (for drawer/sidebar placement)"
        @tier "presentation"
      width : string
        @label "Width"
        @description "Panel width (CSS value, e.g., '400px', '50%')"
        @tier "presentation"
      displayFields : [string] = []
        @label "Display Fields"
        @description "Display fields (alias for fields)"
        @tier "presentation"
      showActions : boolean = true
        @label "Show Actions"
        @description "When false, hides the action buttons + overflow menu (and the close ×). Defaults to true."
        @tier "presentation"
      relationsData : Map string [DetailPanelRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names."
        @tier "presentation"
      look : "panel" | "profile" | "showcase" | "workflow" | "map" | "ledger" | "conversation" | "workspace" = panel
        @label "Look"
        @description "Page variant: panel (labelled fields, default), profile (person/member hero), showcase (image-first product/listing), workflow (lifecycle stepper + activity), map (location hero), ledger (document with line items + totals), conversation (thread beside the record), workspace (tabbed record)."
        @tier "presentation"
      avatarField : string
        @label "Avatar Field"
        @description "Record field holding the avatar image. The profile look always shows an avatar, with the title's initials when this is unset or empty."
        @tier "presentation"
      coverField : string
        @label "Cover Field"
        @description "Record field holding the cover image (profile)."
        @tier "presentation"
      mediaField : string
        @label "Media Field"
        @description "Record field holding the image, or list of images, the showcase look leads with."
        @tier "presentation"
      stageField : string
        @label "Stage Field"
        @description "Record field holding the current lifecycle stage (workflow)."
        @tier "presentation"
      stages : [DetailPanelStagesItem] = []
        @label "Stages"
        @description "The lifecycle in order, `{ value, label }` per stage (workflow)."
        @tier "presentation"
      activity : [DetailPanelActivityItem] = []
        @label "Activity"
        @description "Activity entries shown under the record (workflow)."
        @tier "presentation"
      activityContent : node
        @label "Activity Content"
        @description "Activity composed in instead of `activity` — e.g. the record's own history trait (workflow)."
        @tier "presentation"
      latitudeField : string
        @label "Latitude Field"
        @description "Record fields holding the location (map)."
        @tier "presentation"
      longitudeField : string
        @label "Longitude Field"
        @description "longitudeField prop"
        @tier "presentation"
      lineItemColumns : [DetailPanelLineItemColumnsItem] = []
        @label "Line Item Columns"
        @description "Columns of the line-items table (ledger)."
        @tier "presentation"
      lineItemsContent : node
        @label "Line Items Content"
        @description "Line items composed in instead of `lineItems` — e.g. the child rows' own trait (ledger)."
        @tier "presentation"
      totals : [DetailPanelTotalsItem] = []
        @label "Totals"
        @description "Record fields shown as the document's totals, in order (ledger)."
        @tier "presentation"
      threadContent : node
        @label "Thread Content"
        @description "The thread composed in instead of `thread` — e.g. the replies' own trait with its composer (conversation)."
        @tier "presentation"
      tabs : [DetailPanelTabsItem] = []
        @label "Tabs"
        @description "Tabs after the overview tab, each listing declared field names (workspace)."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own row on mount?"
        @description "true (default) = a mount that carries an id loads that one row (never the collection); a create-mode mount skips the load. false = a composing atom owns the load."
        @tier "internal"
    }
  }

  page "/detail-panel" as DetailPanelPage -> DetailPanelRender
}
