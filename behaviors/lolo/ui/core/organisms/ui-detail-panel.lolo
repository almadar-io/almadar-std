app ui-detail-panel "1.0.0"
"DetailPanel — UI factory (1:1 with the @almadar/ui detail-panel pattern)."
orbital DetailPanelOrbital {
    type DetailPanelLoaded = Event { data : [DetailPanelItem] } "DetailPanel rows finished loading; payload.data holds the collection"
  type DetailPanelError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type DetailPanelStatus = {
    label : string!
    variant : "default" | "success" | "warning" | "danger" | "info"
  }
  type DetailPanelSectionsItem = {
    title : string!
    fields : [DetailPanelSectionsItemFieldsItem]!
  }
  type DetailPanelSectionsItemFieldsItem = {
    label : string!
    value : node!
    icon : icon
    copyable : boolean
  }
  type DetailPanelActionsItem = {
    label : string!
    icon : icon
    event : string
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost" | "danger"
  }
  type DetailPanelBackAction = {
    label : string!
    icon : icon
    event : string
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost" | "danger"
  }
  type DetailPanelFieldsItem = {
    key : string!
    header : string
    type : string
    values : [string]
    relation : DetailPanelFieldsItemRelation
  }
  type DetailPanelFieldsItemRelation = {
    entity : string!
    cardinality : "one" | "many" | "one-to-many" | "many-to-one" | "many-to-many"
  }
  type DetailPanelRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }

  entity DetailPanelItem [runtime] {
    id : string!
  }

  trait DetailPanelRender -> @rebindable DetailPanelItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (fetch DetailPanelItem { emit: { success: DetailPanelLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          title: @config.title
          subtitle: @config.subtitle
          status: @config.status
          avatar: @config.avatar
          sections: @config.sections
          actions: @config.actions
          maxInlineActions: @config.maxInlineActions
          backAction: @config.backAction
          footer: @config.footer
          slideOver: @config.slideOver
          fields: @config.fields
          fieldNames: @config.fieldNames
          initialData: @entity
          mode: @config.mode
          position: @config.position
          width: @config.width
          displayFields: @config.displayFields
          showActions: @config.showActions
          relationsData: @config.relationsData
          type: detail-panel
        })
      DetailPanelLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @payload.data
          title: @config.title
          subtitle: @config.subtitle
          status: @config.status
          avatar: @config.avatar
          sections: @config.sections
          actions: @config.actions
          maxInlineActions: @config.maxInlineActions
          backAction: @config.backAction
          footer: @config.footer
          slideOver: @config.slideOver
          fields: @config.fields
          fieldNames: @config.fieldNames
          initialData: @payload.data
          mode: @config.mode
          position: @config.position
          width: @config.width
          displayFields: @config.displayFields
          showActions: @config.showActions
          relationsData: @config.relationsData
          type: detail-panel
        })
    }

    emits {
      DetailPanelLoaded
        @description "DetailPanel rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : DetailPanelError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc" = asc
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      subtitle : string
        @label "Subtitle"
        @description "subtitle prop"
        @tier "presentation"
      status : DetailPanelStatus
        @label "Status"
        @description "status prop"
        @tier "presentation"
      avatar : node
        @label "Avatar"
        @description "avatar prop"
        @tier "presentation"
      sections : [DetailPanelSectionsItem] = []
        @label "Sections"
        @description "sections prop"
        @tier "presentation"
      actions : [DetailPanelActionsItem] = []
        @label "Actions"
        @description "Unified actions array - first action with variant='primary' is the main action"
        @tier "presentation"
      maxInlineActions : number = 2
        @label "Max Inline Actions"
        @description "Max inline action buttons before the rest collapse into a '⋯' overflow menu (mirrors DataGrid's maxInlineActions). Defaults to 2 — primary + secondary visible, the rest under the menu — so every detail panel carries the same action pattern."
        @tier "presentation"
      backAction : DetailPanelBackAction
        @label "Back Action"
        @description "Navigation-back affordance. Renders top-LEFT before the title (OS/back convention — Almadar_UX §8.4), spatially separated from the right-aligned action buttons + close X. Never inferred from actions[] labels."
        @tier "presentation"
      footer : node
        @label "Footer"
        @description "footer prop"
        @tier "presentation"
      slideOver : boolean = false
        @label "Slide Over"
        @description "slideOver prop"
        @tier "presentation"
      fields : [DetailPanelFieldsItem] = [{ key: "Key", header: "Header", type: "Type", values: ["Item", "Item 2"], relation: { entity: "Entity", cardinality: one } }, { key: "Key 2", header: "Header 2", type: "Type 2", values: ["Item", "Item 2"], relation: { entity: "Entity 2", cardinality: many } }]
        @label "Fields"
        @description "Fields to display - accepts string[], {key, header}[], or DetailField[]"
        @tier "presentation"
      fieldNames : [string] = []
        @label "Field Names"
        @description "Alias for fields - backwards compatibility"
        @tier "presentation"
      mode : string
        @label "Mode"
        @description "Display mode (passed by compiler)"
        @tier "presentation"
      position : "left" | "right" = left
        @label "Position"
        @description "Panel position (for drawer/sidebar placement)"
        @tier "presentation"
      width : string
        @label "Width"
        @description "Panel width (CSS value, e.g., '400px', '50%')"
        @tier "presentation"
      displayFields : [string] = []
        @label "Display Fields"
        @description "Display fields (alias for fields)"
        @tier "presentation"
      showActions : boolean = true
        @label "Show Actions"
        @description "When false, hides the action buttons + overflow menu (and the close ×). Defaults to true."
        @tier "presentation"
      relationsData : Map string [DetailPanelRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names."
        @tier "presentation"
    }
  }

  page "/detail-panel" as DetailPanelPage -> DetailPanelRender
}
