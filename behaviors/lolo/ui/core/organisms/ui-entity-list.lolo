app ui-entity-list "1.0.0"
"EntityList — UI factory (1:1 with the @almadar/ui entity-list pattern)."
;; @pattern "entity-list"
orbital EntityListOrbital {
    type EntityListLoaded = Event { data : [EntityListItem] } "EntityList rows finished loading; payload.data holds the collection"
  type EntityListError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type EntityListFieldsItem = {
    name : string!
    label : string
    icon : icon
    variant : "h3" | "h4" | "body" | "caption" | "badge" | "small" | "progress"
    format : "date" | "currency" | "number" | "boolean" | "percent"
    colorMap : Map string EntityListFieldsItemColorMapValue
    labels : Map string string
  }
  type EntityListFieldsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type EntityListItemActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    placement : string
    variant : "primary" | "secondary" | "ghost" | "danger" | "default"
    icon : icon
    when : SExpr
    roles : [string]
  }

  entity EntityListItem [runtime] {
    id : string!
  }

  trait EntityListRender -> @rebindable EntityListItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch EntityListItem { emit: { success: EntityListLoaded } })
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          entityType: @config.entityType
          selectable: @config.selectable
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          showDividers: @config.showDividers
          variant: @config.variant
          emptyMessage: @config.emptyMessage
          children: @config.children
          fields: @config.fields
          fieldNames: @config.fieldNames
          itemClickEvent: @config.itemClickEvent
          completedField: @config.completedField
          disabledField: @config.disabledField
          type: entity-list
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @entity
          entityType: @config.entityType
          selectable: @config.selectable
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          showDividers: @config.showDividers
          variant: @config.variant
          emptyMessage: @config.emptyMessage
          children: @config.children
          fields: @config.fields
          fieldNames: @config.fieldNames
          itemClickEvent: @config.itemClickEvent
          completedField: @config.completedField
          disabledField: @config.disabledField
          type: entity-list
        })
      EntityListLoaded -> idle
        (render-ui main {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          entity: @payload.data
          entityType: @config.entityType
          selectable: @config.selectable
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          showDividers: @config.showDividers
          variant: @config.variant
          emptyMessage: @config.emptyMessage
          children: @config.children
          fields: @config.fields
          fieldNames: @config.fieldNames
          itemClickEvent: @config.itemClickEvent
          completedField: @config.completedField
          disabledField: @config.disabledField
          type: entity-list
        })
    }

    emits {
      ITEM_ACTIONS -> external { }
        @description "Item actions - schema-driven or function-based"
        @tier "essential"
      @config.itemClickEvent -> external {
        id : string!
        row : @entity!
      }
        @description "When set, clicking a row emits UI:{itemClickEvent} with { id, row }. Omit = rows are not clickable."
        @tier "essential"
      VIEW -> external {
        id : string!
        row : @entity!
      }
        @description "User opened a record from the list."
        @tier "essential"
      EntityListLoaded
        @description "EntityList rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : EntityListError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc" = asc
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      entityType : string
        @label "Entity Type"
        @description "Entity type name for display"
        @tier "presentation"
      selectable : boolean = false
        @label "Selectable"
        @description "selectable prop"
        @tier "presentation"
      itemActions : [EntityListItemActionsItem] = [{ event: VIEW, label: View, variant: ghost }]
        @label "Item Actions"
        @description "Item actions - schema-driven or function-based"
        @tier "presentation"
      showDividers : boolean
        @label "Show Dividers"
        @description "showDividers prop"
        @tier "presentation"
      variant : "default" | "card" = default
        @label "Variant"
        @description "variant prop"
        @tier "presentation"
      emptyMessage : string
        @label "Empty Message"
        @description "emptyMessage prop"
        @tier "presentation"
      children : node
        @label "Children"
        @description "children prop"
        @tier "presentation"
      fields : [EntityListFieldsItem] = [{ name: "Name", label: "Label", icon: "circle", variant: h3, format: date }, { name: "Name 2", label: "Label 2", icon: "circle", variant: h4, format: currency }]
        @label "Fields"
        @description "Fields to display: field names, or declared fields ({ name, label, variant, format, colorMap, labels })"
        @tier "presentation"
      fieldNames : [string] = []
        @label "Field Names"
        @description "Alias for fields - backwards compatibility"
        @tier "presentation"
      itemClickEvent : event = "ITEM_CLICK"
        @label "Item Click Event"
        @description "When set, clicking a row emits UI:{itemClickEvent} with { id, row }. Omit = rows are not clickable."
        @tier "presentation"
      completedField : string
        @label "Completed Field"
        @description "Row field that marks an item completed (`true` strikes its title through)"
        @tier "presentation"
      disabledField : string
        @label "Disabled Field"
        @description "Row field that marks an item disabled (`true` dims the row and disables its click)"
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/entity-list" as EntityListPage -> EntityListRender
}
