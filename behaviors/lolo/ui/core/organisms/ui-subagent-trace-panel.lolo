app ui-subagent-trace-panel "1.0.0"
"SubagentTracePanel — UI factory (1:1 with the @almadar/ui subagent-trace-panel pattern)."
;; @pattern "subagent-trace-panel"
orbital SubagentTracePanelOrbital {
  type SubagentTracePanelError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type SubagentTracePanelSubagentsItem = {
    id : string!
    name : string!
    role : string!
    orbitalName : string
    parentId : string
    status : "running" | "complete" | "error"!
    task : string!
    messages : [SubagentTracePanelSubagentsItemMessagesItem]!
    durationMs : number
    timeline : [SubagentTracePanelSubagentsItemTimelineItem]
  }
  type SubagentTracePanelSubagentsItemMessagesItem = {
    message : string!
    tool : string
    timestamp : number!
  }
  type SubagentTracePanelSubagentsItemTimelineItem = SubagentTracePanelSubagentsItemTimelineItemMessage | SubagentTracePanelSubagentsItemTimelineItemToolCall | SubagentTracePanelSubagentsItemTimelineItemToolResult | SubagentTracePanelSubagentsItemTimelineItemFileOperation | SubagentTracePanelSubagentsItemTimelineItemSchemaDiff | SubagentTracePanelSubagentsItemTimelineItemError | SubagentTracePanelSubagentsItemTimelineItemMilestone
  type SubagentTracePanelSubagentsItemTimelineItemMessage = {
    type : "message"!
    role : "user" | "assistant" | "system" | "tool"!
    content : string!
    timestamp : number!
    isStreaming : boolean
    label : string
  }
  type SubagentTracePanelSubagentsItemTimelineItemToolCall = {
    type : "tool_call"!
    tool : string!
    argsText : string!
    timestamp : number!
    isExecuting : boolean
  }
  type SubagentTracePanelSubagentsItemTimelineItemToolResult = {
    type : "tool_result"!
    tool : string!
    resultText : string!
    success : boolean!
    timestamp : number!
    durationMs : number
  }
  type SubagentTracePanelSubagentsItemTimelineItemFileOperation = {
    type : "file_operation"!
    operation : "ls" | "read_file" | "write_file" | "edit_file"!
    path : string!
    success : boolean
    timestamp : number!
  }
  type SubagentTracePanelSubagentsItemTimelineItemSchemaDiff = {
    type : "schema_diff"!
    filePath : string!
    hunks : [SubagentTracePanelSubagentsItemTimelineItemSchemaDiffHunksItem]!
    timestamp : number!
  }
  type SubagentTracePanelSubagentsItemTimelineItemSchemaDiffHunksItem = {
    oldStart : number!
    oldLines : number!
    newStart : number!
    newLines : number!
    lines : [SubagentTracePanelSubagentsItemTimelineItemSchemaDiffHunksItemLinesItem]!
  }
  type SubagentTracePanelSubagentsItemTimelineItemSchemaDiffHunksItemLinesItem = {
    type : "add" | "remove" | "context"!
    content : string!
  }
  type SubagentTracePanelSubagentsItemTimelineItemError = {
    type : "error"!
    message : string!
    code : string
    timestamp : number!
  }
  type SubagentTracePanelSubagentsItemTimelineItemMilestone = {
    type : "milestone"!
    milestone : string!
    summary : string
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItem = SubagentTracePanelCoordinatorActivitiesItemMessage | SubagentTracePanelCoordinatorActivitiesItemToolCall | SubagentTracePanelCoordinatorActivitiesItemToolResult | SubagentTracePanelCoordinatorActivitiesItemFileOperation | SubagentTracePanelCoordinatorActivitiesItemSchemaDiff | SubagentTracePanelCoordinatorActivitiesItemError | SubagentTracePanelCoordinatorActivitiesItemCoordinatorDecision | SubagentTracePanelCoordinatorActivitiesItemPlanCommitted | SubagentTracePanelCoordinatorActivitiesItemPendingQuestion | SubagentTracePanelCoordinatorActivitiesItemClarificationQuestion | SubagentTracePanelCoordinatorActivitiesItemAnalysis | SubagentTracePanelCoordinatorActivitiesItemOrbitalStarted | SubagentTracePanelCoordinatorActivitiesItemOrbitalDone | SubagentTracePanelCoordinatorActivitiesItemSchemaChange | SubagentTracePanelCoordinatorActivitiesItemDone | SubagentTracePanelCoordinatorActivitiesItemCancelled | SubagentTracePanelCoordinatorActivitiesItemLlmResponse
  type SubagentTracePanelCoordinatorActivitiesItemMessage = {
    type : "message"!
    role : "user" | "assistant" | "system"!
    content : string!
    timestamp : number!
    isStreaming : boolean
  }
  type SubagentTracePanelCoordinatorActivitiesItemToolCall = {
    type : "tool_call"!
    tool : string!
    kind : "input" | "read" | "invalid"
    argsText : string!
    timestamp : number!
    isExecuting : boolean
  }
  type SubagentTracePanelCoordinatorActivitiesItemToolResult = {
    type : "tool_result"!
    tool : string!
    kind : "input" | "read" | "invalid"
    success : boolean!
    detail : string
    rows : number
    resultText : string!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemFileOperation = {
    type : "file_operation"!
    operation : "ls" | "read_file" | "write_file" | "edit_file"!
    path : string!
    success : boolean
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemSchemaDiff = {
    type : "schema_diff"!
    filePath : string!
    hunks : [SubagentTracePanelCoordinatorActivitiesItemSchemaDiffHunksItem]!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemSchemaDiffHunksItem = {
    oldStart : number!
    oldLines : number!
    newStart : number!
    newLines : number!
    lines : [SubagentTracePanelCoordinatorActivitiesItemSchemaDiffHunksItemLinesItem]!
  }
  type SubagentTracePanelCoordinatorActivitiesItemSchemaDiffHunksItemLinesItem = {
    type : "add" | "remove" | "context"!
    content : string!
  }
  type SubagentTracePanelCoordinatorActivitiesItemError = {
    type : "error"!
    message : string!
    code : string
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemCoordinatorDecision = {
    type : "coordinator_decision"!
    organism : string!
    reason : string!
    priorOrganism : string
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemPlanCommitted = {
    type : "plan_committed"!
    orbitals : [string]!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemPendingQuestion = {
    type : "pending_question"!
    questionId : string!
    question : string!
    orbitalName : string
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemClarificationQuestion = {
    type : "clarification_question"!
    level : "organism" | "molecule" | "atom_trait"!
    scope : SubagentTracePanelCoordinatorActivitiesItemClarificationQuestionScope!
    question : string!
    candidates : [SubagentTracePanelCoordinatorActivitiesItemClarificationQuestionCandidatesItem]!
    skipDefault : string!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemClarificationQuestionScope = {
    orbitalName : string
    traitName : string
  }
  type SubagentTracePanelCoordinatorActivitiesItemClarificationQuestionCandidatesItem = {
    id : string!
    label : string!
    description : string!
    whyThisFits : string!
  }
  type SubagentTracePanelCoordinatorActivitiesItemAnalysis = {
    type : "analysis"!
    organism : string!
    organismReason : string
    complexity : SubagentTracePanelCoordinatorActivitiesItemAnalysisComplexity
    renames : [SubagentTracePanelCoordinatorActivitiesItemAnalysisRenamesItem]!
    deletes : [string]!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemAnalysisComplexity = {
    category : string!
    reasoning : string!
  }
  type SubagentTracePanelCoordinatorActivitiesItemAnalysisRenamesItem = {
    from : string!
    to : string!
  }
  type SubagentTracePanelCoordinatorActivitiesItemOrbitalStarted = {
    type : "orbital_started"!
    orbitalName : string!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemOrbitalDone = {
    type : "orbital_done"!
    orbitalName : string!
    traitCount : number
    transitionCount : number
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemSchemaChange = {
    type : "schema_change"!
    changeKind : "orbital-added" | "orbital-removed" | "entity-fields-changed" | "trait-added" | "trait-removed" | "trait-config-changed" | "state-machine-changed" | "guard-changed" | "effect-changed" | "render-ui-changed" | "event-wiring-changed" | "page-changed" | "theme-changed" | "behavior-composed"!
    orbitalName : string!
    traitName : string
    transitionEvent : string
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemDone = {
    type : "done"!
    orbitalCount : number!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemCancelled = {
    type : "cancelled"!
    message : string!
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemLlmResponse = {
    type : "llm_response"!
    content : string!
    llm : SubagentTracePanelCoordinatorActivitiesItemLlmResponseLlm
    timestamp : number!
  }
  type SubagentTracePanelCoordinatorActivitiesItemLlmResponseLlm = {
    service : string!
    provider : string!
    model : string!
    systemPrompt : string!
    userPrompt : string!
    toolCallsJson : string
    attempt : number
    durationMs : number!
    promptTokens : number
    completionTokens : number
    cachedPromptTokens : number
    costUSD : number
  }
  type SubagentTracePanelCoordinatorMessagesItem = {
    role : "system" | "user" | "assistant" | "tool"!
    content : string!
    toolCalls : [SubagentTracePanelCoordinatorMessagesItemToolCallsItem]
    toolCallId : string
    toolName : string
    reasoningContent : string
  }
  type SubagentTracePanelCoordinatorMessagesItemToolCallsItem = {
    id : string!
    name : string!
  }

  entity SubagentTracePanelItem [runtime] {
    id : string!
  }

  trait SubagentTracePanelRender -> @rebindable SubagentTracePanelItem [interaction, instance] {
    initial: closed

    state closed {
      INIT -> closed
        (render-ui main {
          label: "Open Subagent-trace-panel"
          action: OPEN
          type: button
        })
      OPEN -> open
        (render-ui overlay {
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          sortBy: @config.sortBy
          sortDirection: @config.sortDirection
          searchValue: @config.searchValue
          page: @config.pageProp
          pageSize: @config.pageSize
          totalCount: @config.totalCount
          activeFilters: @config.activeFilters
          selectedIds: @config.selectedIds
          subagents: @config.subagents
          focusedOrbital: @config.focusedOrbital
          disclosureLevel: @config.disclosureLevel
          open: @config.open
          onClose: @config.onClose
          coordinatorActivities: @config.coordinatorActivities
          coordinatorMessages: @config.coordinatorMessages
          mode: @config.mode
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: subagent-trace-panel
        })
    }

    state open {
      CLOSE -> closed
        (render-ui overlay null)
        (render-ui main {
          label: "Open Subagent-trace-panel"
          action: OPEN
          type: button
        })
    }

    emits {
      @config.onClose -> external { }
        @description "Optional dismiss handler."
        @tier "essential"
      OPEN -> external {
        id : string
      }
        @description "Open the Subagent-trace-panel."
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : SubagentTracePanelError
        @label "Error"
        @description "Error state (UiError)"
        @tier "presentation"
      sortBy : string
        @label "Sort By"
        @description "Current sort field"
        @tier "presentation"
      sortDirection : "asc" | "desc"
        @label "Sort Direction"
        @description "Current sort direction"
        @tier "presentation"
      searchValue : string
        @label "Search Value"
        @description "Current search query value"
        @tier "presentation"
      pageProp : number
        @label "Page"
        @description "Current page number"
        @synonyms "page"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Number of items per page"
        @tier "presentation"
      totalCount : number
        @label "Total Count"
        @description "Total number of items"
        @tier "presentation"
      activeFilters : Map string string = {}
        @label "Active Filters"
        @description "Active filters"
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently selected item IDs"
        @tier "presentation"
      subagents : [SubagentTracePanelSubagentsItem] = [{ id: "Id", name: "Name", role: "Role", orbitalName: "Orbital Name", parentId: "Parent Id", status: running, task: "Task", messages: [{ message: "Message", tool: "Tool", timestamp: 1 }, { message: "Message 2", tool: "Tool 2", timestamp: 2 }], durationMs: 1, timeline: [] }, { id: "Id 2", name: "Name 2", role: "Role 2", orbitalName: "Orbital Name 2", parentId: "Parent Id 2", status: complete, task: "Task 2", messages: [{ message: "Message", tool: "Tool", timestamp: 1 }, { message: "Message 2", tool: "Tool 2", timestamp: 2 }], durationMs: 2, timeline: [] }]
        @label "Subagents"
        @description "All known subagents from the runner."
        @tier "presentation"
      focusedOrbital : string
        @label "Focused Orbital"
        @description "Current canvas focus orbital — only used by overlay mode. Tab mode ignores this."
        @tier "presentation"
      disclosureLevel : number = 1
        @label "Disclosure Level"
        @description "Drives density: 1-2 → compact, 3-4 → full activity embed (when mode='overlay')."
        @tier "presentation"
      open : boolean = false
        @label "Open"
        @description "Whether the panel is visible. Typically auto-opens during generation in overlay mode."
        @tier "presentation"
      onClose : event = "CLOSE"
        @label "On Close"
        @description "Optional dismiss handler."
        @tier "presentation"
      coordinatorActivities : [SubagentTracePanelCoordinatorActivitiesItem] = []
        @label "Coordinator Activities"
        @description "Full coordinator activities (tool calls, results, messages, errors)."
        @tier "presentation"
      coordinatorMessages : [SubagentTracePanelCoordinatorMessagesItem] = []
        @label "Coordinator Messages"
        @description "Canonical Coordinator conversation — same shape live and on reload. When present, takes precedence over `coordinatorActivities` for the Coordinator section."
        @tier "presentation"
      mode : "overlay" | "tab" = overlay
        @label "Mode"
        @description "Rendering mode. - `'overlay'` (default): floating side panel positioned absolutely over the canvas. Density follows `disclosureLevel` (compact L1/L2, rich L3+). The `open` flag actually hides the panel when false. - `'tab'`: full-width content for a dedicated 'trace' supplemental tab. Always renders rich (regardless of disclosure level), always visible (the `open` flag is ignored), and includes an empty state when no subagents are present so users see the surface even before generation starts."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/subagent-trace-panel" as SubagentTracePanelPage -> SubagentTracePanelRender
}
