app ui-modal-slot [
  locales: [en, ar, sl],
  version: "1.0.0",
  description: "ModalSlot — UI factory (1:1 with the @almadar/ui modal-slot pattern)."
]
uses NotFound from "std/behaviors/std-not-found"
;; @pattern "modal-slot"
orbital ModalSlotOrbital {
  type ModalSlotError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity ModalSlotItem [runtime] {
    id : string!
  }

  trait ModalSlotRender -> @rebindable ModalSlotItem {
    initial: idle

    state idle {
      INIT -> idle
        (fetch ModalSlotItem { limit: @config.maxRows, emit: { failure: ModalSlotLoadFailed } })
        (render-ui main {
          children: @config.children
          title: @config.title
          size: @config.size
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          entity: ModalSlotItem
          sourceTrait: @config.sourceTrait
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          type: modal-slot
        })
      ModalSlotLoadFailed -> idle
        (notify error (str/concat "Couldn't load the modal slot — " (default ?error "")))
    }

    emits {
      ModalSlotLoadFailed {
        error : string
        code : string
      }
        @description "Modal slot could not be loaded."
        @synonyms "error, failure, rejected"
        @tier "internal"
    }

    config {
      children : node
        @label "Children"
        @description "Content to display in the modal"
        @tier "presentation"
      title : string
        @label "Title"
        @description "Override modal title (extracted from children if not provided)"
        @tier "presentation"
      size : "sm" | "md" | "lg" | "xl" | "full" = md
        @label "Size"
        @description "Modal size"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Custom class name"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : ModalSlotError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      sourceTrait : string
        @label "Source Trait"
        @description "Source trait name for qualified event emission"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      maxRows : number = 500
        @label "Most rows per load"
        @description "Most rows one load reads."
        @tier "policy"
    }
  }

  page "/modal-slot" as ModalSlotPage -> ModalSlotRender
}

orbital NotFound = NotFound.orbitals.NotFoundOrbital {
  config { primaryHref: "/modal-slot" }
}
