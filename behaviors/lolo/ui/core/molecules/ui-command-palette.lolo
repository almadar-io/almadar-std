app ui-command-palette "1.0.0"
"CommandPalette — UI factory (1:1 with the @almadar/ui command-palette pattern)."
;; @pattern "command-palette"
orbital CommandPaletteOrbital {
  type CommandPaletteCommandsItem = {
    id : string!
    label : string!
    icon : icon
    shortcut : string
    keywords : [string]
    group : string
    disabled : boolean
    event : event
    action : event
    actionPayload : @payload action
    roles : [string]
  }
  type CommandPaletteSELECTCommand = {
    id : string!
    label : string!
    icon : icon
    shortcut : string
    keywords : [string]
    group : string
    disabled : boolean
    event : event
    action : event
    actionPayload : @payload action
  }

  entity CommandPaletteItem [runtime] {
    id : string!
    open : boolean @intrinsic = false
  }

  trait CommandPaletteRender -> @rebindable CommandPaletteItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.open @config.open)
        (render-ui main {
          open: @entity.open
          onOpenChange: @config.onOpenChange
          commands: (array/filter @config.commands (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          onSelect: @config.onSelect
          placeholder: @config.placeholder
          emptyLabel: @config.emptyLabel
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: command-palette
        })
      OPEN_CHANGE -> idle
        (set @entity.open ?open)
        (render-ui main {
          open: @entity.open
          onOpenChange: @config.onOpenChange
          commands: (array/filter @config.commands (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          onSelect: @config.onSelect
          placeholder: @config.placeholder
          emptyLabel: @config.emptyLabel
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: command-palette
        })
    }

    emits {
      @config.onOpenChange -> external {
        open : boolean
      }
        @description "Called to open/close the overlay (Escape, overlay click, or a selection)"
        @tier "essential"
      @config.onSelect -> external {
        command : CommandPaletteSELECTCommand
      }
        @description "Called with the selected command (click, or Enter on the highlighted row)"
        @tier "essential"
    }

    listens {
      OPEN_CHANGE {
        open : boolean
      }
    }

    config {
      open : boolean = false
        @label "Open"
        @description "Whether the palette overlay is open"
        @tier "presentation"
      onOpenChange : event = "OPEN_CHANGE"
        @label "On Open Change"
        @description "Called to open/close the overlay (Escape, overlay click, or a selection)"
        @tier "presentation"
      commands : [CommandPaletteCommandsItem] = []
        @label "Commands"
        @description "Commands listed in the palette, filtered as the user types"
        @tier "presentation"
      onSelect : event = "SELECT"
        @label "On Select"
        @description "Called with the selected command (click, or Enter on the highlighted row)"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Search field placeholder. Defaults to the translated 'Type a command...'."
        @tier "presentation"
      emptyLabel : string
        @label "Empty Label"
        @description "Label shown when no command matches the query. Defaults to the translated message."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes on the overlay's dialog"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/command-palette" as CommandPalettePage -> CommandPaletteRender
}
