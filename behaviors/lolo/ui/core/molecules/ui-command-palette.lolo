app ui-command-palette "1.0.0"
"CommandPalette — UI factory (1:1 with the @almadar/ui command-palette pattern)."
;; @pattern "command-palette"
orbital CommandPaletteOrbital {
  type CommandPaletteCommandsItem = {
    id : string!
    label : string!
    icon : icon
    shortcut : string
    keywords : [string]
    group : string
    disabled : boolean
    event : event
    action : event
    actionPayload : @payload action
    roles : [string]
  }
  type CommandPaletteSELECTCommand = {
    id : string!
    label : string!
    icon : icon
    shortcut : string
    keywords : [string]
    group : string
    disabled : boolean
    event : event
    action : event
    actionPayload : @payload action
  }

  entity CommandPaletteItem [runtime] {
    id : string!
    open : boolean @intrinsic = false
  }

  trait CommandPaletteRender -> @rebindable CommandPaletteItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.open @config.open)
        (render-ui main {
          open: @entity.open
          onOpenChange: @config.onOpenChange
          commands: (array/filter @config.commands (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          onSelect: @config.onSelect
          placeholder: @config.placeholder
          emptyLabel: @config.emptyLabel
          className: @config.className
          type: command-palette
        })
      OPEN_CHANGE -> idle
        (set @entity.open ?open)
        (render-ui main {
          open: @entity.open
          onOpenChange: @config.onOpenChange
          commands: (array/filter @config.commands (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          onSelect: @config.onSelect
          placeholder: @config.placeholder
          emptyLabel: @config.emptyLabel
          className: @config.className
          type: command-palette
        })
    }

    emits {
      @config.onOpenChange -> external {
        open : boolean
      }
        @description "Called to open/close the overlay (Escape, overlay click, or a selection)"
        @tier "essential"
      @config.onSelect -> external {
        command : CommandPaletteSELECTCommand
      }
        @description "Called with the selected command (click, or Enter on the highlighted row)"
        @tier "essential"
    }

    listens {
      OPEN_CHANGE {
        open : boolean
      }
    }

    config {
      open : boolean = false
        @label "Open"
        @description "Whether the palette overlay is open"
        @tier "presentation"
      onOpenChange : event = "OPEN_CHANGE"
        @label "On Open Change"
        @description "Called to open/close the overlay (Escape, overlay click, or a selection)"
        @tier "presentation"
      commands : [CommandPaletteCommandsItem] = []
        @label "Commands"
        @description "Commands listed in the palette, filtered as the user types"
        @tier "presentation"
      onSelect : event = "SELECT"
        @label "On Select"
        @description "Called with the selected command (click, or Enter on the highlighted row)"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Search field placeholder. Defaults to the translated 'Type a command...'."
        @tier "presentation"
      emptyLabel : string
        @label "Empty Label"
        @description "Label shown when no command matches the query. Defaults to the translated message."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes on the overlay's dialog"
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/command-palette" as CommandPalettePage -> CommandPaletteRender
}
