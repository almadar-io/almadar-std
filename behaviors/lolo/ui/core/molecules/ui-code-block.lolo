app ui-code-block "1.0.0"
"CodeBlock — UI factory (1:1 with the @almadar/ui code-block pattern)."
;; @pattern "code-block"
orbital CodeBlockOrbital {
  type CodeBlockDiffItem = {
    type : "added" | "removed" | "unchanged" | "context"!
    beforeLineNumber : number
    afterLineNumber : number
    content : string!
  }
  type CodeBlockFilesItem = {
    label : string!
    code : string!
    language : "text" | "json" | "javascript" | "js" | "typescript" | "ts" | "jsx" | "tsx" | "css" | "markdown" | "md" | "bash" | "shell" | "sh" | "yaml" | "yml" | "rust" | "python" | "py" | "sql" | "diff" | "toml" | "go" | "graphql" | "html" | "xml" | "clojure" | "clj" | "edn" | "haskell" | "hs" | "lisp" | "scheme" | "scala" | "elixir" | "ex" | "exs" | "erlang" | "erl" | "elm" | "fsharp" | "fs" | "fsx" | "ocaml" | "ml" | "java" | "c" | "cpp" | "c++" | "cc" | "cxx" | "hpp" | "h" | "csharp" | "cs" | "objectivec" | "objc" | "php" | "ruby" | "rb" | "swift" | "kotlin" | "kt" | "lua" | "r" | "dart" | "julia" | "fortran" | "f90" | "f95" | "perl" | "pl" | "powershell" | "ps1" | "makefile" | "make" | "nginx" | "ini" | "orb" | "lolo"
  }
  type CodeBlockActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost"
    roles : [string]
  }
  type CodeBlockError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type CodeBlockDiagnosticsItem = {
    line : number!
    column : number
    endLine : number
    endColumn : number
    severity : "error" | "warning"!
    message : string!
    approximate : boolean
  }

  entity CodeBlockItem [runtime] {
    id : string!
    code : string @intrinsic
    editorId : string @intrinsic
  }

  trait CodeBlockRender -> @rebindable CodeBlockItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.code @config.code)
        (set @entity.editorId @config.editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      CHANGE -> idle
        (set @entity.code ?code)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      EDITOR_FOCUS -> idle
        (set @entity.editorId ?editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      EDITOR_BLUR -> idle
        (set @entity.editorId ?editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      MOTION -> idle
        (set @entity.editorId ?editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      OPERATE -> idle
        (set @entity.editorId ?editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      INSERT_TEXT -> idle
        (set @entity.editorId ?editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
      SET_MODE -> idle
        (set @entity.editorId ?editorId)
        (render-ui main {
          code: @entity.code
          language: @config.language
          showCopyButton: @config.showCopyButton
          showLanguageBadge: @config.showLanguageBadge
          maxHeight: @config.maxHeight
          foldable: @config.foldable
          className: @config.className
          editable: @config.editable
          onChange: @config.onChange
          title: @config.title
          mode: @config.mode
          diff: @config.diff
          oldValue: @config.oldValue
          newValue: @config.newValue
          showLineNumbers: @config.showLineNumbers
          wordWrap: @config.wordWrap
          files: @config.files
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          showCopy: @config.showCopy
          editorId: @entity.editorId
          onEditorFocus: @config.onEditorFocus
          onEditorBlur: @config.onEditorBlur
          onMotion: @config.onMotion
          onOperate: @config.onOperate
          onInsertText: @config.onInsertText
          onSetMode: @config.onSetMode
          motions: @config.motions
          operators: @config.operators
          problems: @config.problems
          diagnostics: @config.diagnostics
          onGoToDefinition: @config.onGoToDefinition
          diagnosticsCode: @config.diagnosticsCode
          lineNumbers: @config.lineNumbers
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: code-block
        })
    }

    emits {
      @config.onChange -> external {
        code : string
      }
        @description "GAP-51: called with the new code on every keystroke when `editable === true`. Consumers should debounce + parse downstream — `CodeBlock` does not."
        @tier "essential"
      @config.onEditorFocus -> external {
        editorId : string!
      }
        @description "Declarative bus emit fired when this editor gains focus."
        @tier "essential"
      @config.onEditorBlur -> external {
        editorId : string!
      }
        @description "Declarative bus emit fired when this editor loses focus."
        @tier "essential"
      @config.onGoToDefinition -> external {
        identifier : string
      }
        @description "Editable only: Cmd/Ctrl+click, or Cmd/Ctrl+Enter at the caret, on an identifier `definitionAt` accepts."
        @tier "essential"
    }

    listens {
      MOTION {
        editorId : string!
        motion : "left" | "right" | "up" | "down" | "word-forward" | "word-back" | "word-end" | "line-start" | "line-end" | "first-nonblank" | "doc-start" | "doc-end" | "paragraph-forward" | "paragraph-back" | "line" | "selection" | "match-bracket"!
        count : number!
      }
      OPERATE {
        editorId : string!
        operator : "delete" | "yank" | "change" | "put" | "put-before" | "undo" | "redo" | "join" | "toggle-case" | "indent" | "dedent" | "replace"!
        motion : "left" | "right" | "up" | "down" | "word-forward" | "word-back" | "word-end" | "line-start" | "line-end" | "first-nonblank" | "doc-start" | "doc-end" | "paragraph-forward" | "paragraph-back" | "line" | "selection" | "match-bracket"!
        count : number!
      }
      INSERT_TEXT {
        editorId : string!
        text : string!
      }
      SET_MODE {
        editorId : string!
        mode : string!
        caret : "bar" | "block" | "underline"!
      }
      CHANGE {
        code : string
      }
      EDITOR_FOCUS {
        editorId : string!
      }
      EDITOR_BLUR {
        editorId : string!
      }
    }

    config {
      code : string
        @label "Code"
        @description "The code content to display"
        @tier "presentation"
      language : string = text
        @label "Language"
        @description "Programming language for syntax highlighting (any Prism id; loaded on demand if not pre-registered)"
        @tier "presentation"
      showCopyButton : boolean = true
        @label "Show Copy Button"
        @description "Show the copy button"
        @tier "presentation"
      showLanguageBadge : boolean = true
        @label "Show Language Badge"
        @description "Show the language badge"
        @tier "presentation"
      maxHeight : scalar = "60vh"
        @label "Max Height"
        @description "Maximum height before scrolling"
        @tier "presentation"
      foldable : boolean
        @label "Foldable"
        @description "Enable brace-based code folding of multi-line `{}`/`[]` blocks (default: true)."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      editable : boolean = false
        @label "Editable"
        @description "When true, render an editable surface that composes a transparent `Textarea` over a Prism-highlighted overlay. The overlay re-tokenizes on each keystroke (driven from a local mirror of the textarea value), so users see syntax-highlighted code while still being able to type. Folding is skipped in editable mode. History: GAP-51 first-cut shipped plain (no-highlighting) editable text; GAP-77 (2026-04-12) added the Prism overlay layer. Default: false (existing read-only behavior unchanged)."
        @tier "presentation"
      onChange : event = "CHANGE"
        @label "On Change"
        @description "GAP-51: called with the new code on every keystroke when `editable === true`. Consumers should debounce + parse downstream — `CodeBlock` does not."
        @tier "presentation"
      title : string
        @label "Title"
        @description "── Viewer props (absorbed from CodeViewer / DocCodeBlock) ────────────────"
        @tier "presentation"
      mode : "code" | "diff" = code
        @label "Mode"
        @description "Diff or plain-code display mode"
        @tier "presentation"
      diff : [CodeBlockDiffItem] = []
        @label "Diff"
        @description "Pre-computed diff lines"
        @tier "presentation"
      oldValue : string
        @label "Old Value"
        @description "Old source text — generates diff when combined with newValue"
        @tier "presentation"
      newValue : string
        @label "New Value"
        @description "New source text — generates diff when combined with oldValue"
        @tier "presentation"
      showLineNumbers : boolean = false
        @label "Show Line Numbers"
        @description "Show line numbers in code / diff mode"
        @tier "presentation"
      wordWrap : boolean = false
        @label "Word Wrap"
        @description "Enable word-wrap in code / diff mode"
        @tier "presentation"
      files : [CodeBlockFilesItem] = []
        @label "Files"
        @description "Multiple files shown as tabs"
        @tier "presentation"
      actions : [CodeBlockActionsItem] = []
        @label "Actions"
        @description "Action badges in the toolbar"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : CodeBlockError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      showCopy : boolean
        @label "Show Copy"
        @description "Show copy button (viewer alias for showCopyButton)"
        @tier "presentation"
      editorId : string
        @label "Editor Id"
        @description "Stable identity for the keyboard router / plugin host to target this editor. Unset = this instance never receives capability events."
        @tier "presentation"
      onEditorFocus : event = "EDITOR_FOCUS"
        @label "On Editor Focus"
        @description "Declarative bus emit fired when this editor gains focus."
        @tier "presentation"
      onEditorBlur : event = "EDITOR_BLUR"
        @label "On Editor Blur"
        @description "Declarative bus emit fired when this editor loses focus."
        @tier "presentation"
      onMotion : event = "MOTION"
        @label "On Motion"
        @description "Declarative bus listen: move the cursor per the vim-style motion vocabulary."
        @tier "presentation"
      onOperate : event = "OPERATE"
        @label "On Operate"
        @description "Declarative bus listen: apply a text operator over a motion's range."
        @tier "presentation"
      onInsertText : event = "INSERT_TEXT"
        @label "On Insert Text"
        @description "Declarative bus listen: insert literal text at the cursor."
        @tier "presentation"
      onSetMode : event = "SET_MODE"
        @label "On Set Mode"
        @description "Declarative bus listen: switch editor mode and caret style."
        @tier "presentation"
      motions : ["left" | "right" | "up" | "down" | "word-forward" | "word-back" | "word-end" | "line-start" | "line-end" | "first-nonblank" | "doc-start" | "doc-end" | "paragraph-forward" | "paragraph-back" | "line" | "selection" | "match-bracket"] = ["left", "right", "up", "down", "word-forward", "word-back", "word-end", "line-start", "line-end", "first-nonblank", "doc-start", "doc-end", "paragraph-forward", "paragraph-back", "line", "selection", "match-bracket"]
        @label "Motions"
        @description "Motion vocabulary this editor accepts. Default: the full `EditorMotion` set."
        @tier "presentation"
      operators : ["delete" | "yank" | "change" | "put" | "put-before" | "undo" | "redo" | "join" | "toggle-case" | "indent" | "dedent" | "replace"] = ["delete", "yank", "change", "put", "put-before", "undo", "redo", "join", "toggle-case", "indent", "dedent", "replace"]
        @label "Operators"
        @description "Operator vocabulary this editor accepts. Default: the full `EditorOperator` set."
        @tier "presentation"
      problems : number
        @label "Problems"
        @description "Editable only: how many problems the host knows the code has (some, like a parse error, have no line to mark). With `assist`, the editor offers to fix them."
        @tier "presentation"
      diagnostics : [CodeBlockDiagnosticsItem] = []
        @label "Diagnostics"
        @description "Editable only: problems located in the code (1-based line/column in characters, `endColumn` just past the last one), each underlined exactly — red wavy for an error, amber for a warning, dotted where the position is approximate. The message of the one under the caret shows below the editor."
        @tier "presentation"
      onGoToDefinition : event = "GO_TO_DEFINITION"
        @label "On Go To Definition"
        @description "Editable only: Cmd/Ctrl+click, or Cmd/Ctrl+Enter at the caret, on an identifier `definitionAt` accepts."
        @tier "presentation"
      diagnosticsCode : string
        @label "Diagnostics Code"
        @description "The code `diagnostics` were computed on. When the editor's text has moved on, each range is carried over the edit; a range the edit touches is dropped until the code is checked again. Absent: they describe the current text."
        @tier "presentation"
      lineNumbers : boolean
        @label "Line Numbers"
        @description "Editable only: number the lines in a gutter (lines with errors in red). Default on."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/code-block" as CodeBlockPage -> CodeBlockRender
}
