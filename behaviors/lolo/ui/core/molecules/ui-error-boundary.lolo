app ui-error-boundary [
  version: "1.0.0",
  description: "ErrorBoundary — UI factory (1:1 with the @almadar/ui error-boundary pattern)."
]
;; @pattern "error-boundary"
orbital ErrorBoundaryOrbital {
  entity ErrorBoundaryItem [runtime] {
    id : string!
  }

  trait ErrorBoundaryRender -> @rebindable ErrorBoundaryItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          children: @config.children
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          type: error-boundary
        })
    }

    config {
      children : node
        @label "Children"
        @description "Content to render when no error"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes for the wrapper"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
    }
  }

  page "/error-boundary" as ErrorBoundaryPage -> ErrorBoundaryRender
}
