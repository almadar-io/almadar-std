app ui-calendar-grid [
  version: "1.0.0",
  description: "CalendarGrid — UI factory (1:1 with the @almadar/ui calendar-grid pattern)."
]
;; @pattern "calendar-grid"
orbital CalendarGridOrbital {
    type CalendarGridLoaded = Event { data : [CalendarGridItem] } "CalendarGrid rows finished loading; payload.data holds the collection"

  entity CalendarGridItem [runtime] {
    id : string!
    title : string = "Title"
    startTime : string = "Start Time"
    endTime : string = "End Time"
    color : string = "Color"
  }

  trait CalendarGridRender -> @rebindable CalendarGridItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch CalendarGridItem { emit: { success: CalendarGridLoaded } })
        (render-ui main {
          weekStart: @config.weekStart
          timeSlots: @config.timeSlots
          events: @entity
          onSlotClick: @config.onSlotClick
          onDayClick: @config.onDayClick
          onEventClick: @config.onEventClick
          className: @config.className
          surface: @config.surface
          longPressEvent: @config.longPressEvent
          longPressPayload: @config.longPressPayload
          swipeLeftEvent: @config.swipeLeftEvent
          swipeRightEvent: @config.swipeRightEvent
          dayWindow: @config.dayWindow
          titleField: @config.titleField
          startField: @config.startField
          endField: @config.endField
          colorField: @config.colorField
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: calendar-grid
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          weekStart: @config.weekStart
          timeSlots: @config.timeSlots
          events: @entity
          onSlotClick: @config.onSlotClick
          onDayClick: @config.onDayClick
          onEventClick: @config.onEventClick
          className: @config.className
          surface: @config.surface
          longPressEvent: @config.longPressEvent
          longPressPayload: @config.longPressPayload
          swipeLeftEvent: @config.swipeLeftEvent
          swipeRightEvent: @config.swipeRightEvent
          dayWindow: @config.dayWindow
          titleField: @config.titleField
          startField: @config.startField
          endField: @config.endField
          colorField: @config.colorField
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: calendar-grid
        })
      CalendarGridLoaded -> idle
        (render-ui main {
          weekStart: @config.weekStart
          timeSlots: @config.timeSlots
          events: @payload.data
          onSlotClick: @config.onSlotClick
          onDayClick: @config.onDayClick
          onEventClick: @config.onEventClick
          className: @config.className
          surface: @config.surface
          longPressEvent: @config.longPressEvent
          longPressPayload: @config.longPressPayload
          swipeLeftEvent: @config.swipeLeftEvent
          swipeRightEvent: @config.swipeRightEvent
          dayWindow: @config.dayWindow
          titleField: @config.titleField
          startField: @config.startField
          endField: @config.endField
          colorField: @config.colorField
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: calendar-grid
        })
    }

    emits {
      @config.onSlotClick -> external {
        day : date
        time : string
      }
        @description "Called when a time slot is clicked"
        @tier "essential"
      @config.onDayClick -> external {
        day : date
      }
        @description "Called when a day header is clicked"
        @tier "essential"
      @config.onEventClick -> external {
        event : @entity
      }
        @description "Called when an event is clicked"
        @tier "essential"
      @config.longPressEvent -> external {
        date : string!
        time : string
      }
        @description "Event emitted on long-press of a time slot: UI:{longPressEvent} with { date, time, ...longPressPayload }"
        @tier "essential"
      @config.swipeLeftEvent -> external { }
        @description "Event emitted on swipe left (next week): UI:{swipeLeftEvent}"
        @tier "essential"
      @config.swipeRightEvent -> external { }
        @description "Event emitted on swipe right (prev week): UI:{swipeRightEvent}"
        @tier "essential"
      CalendarGridLoaded
        @description "CalendarGrid rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      weekStart : date = "2024-01-01"
        @label "Week Start"
        @description "Start of the week (defaults to current week's Monday)"
        @tier "presentation"
      timeSlots : [string] = []
        @label "Time Slots"
        @description "Time slot labels (defaults to 09:00-17:00)"
        @tier "presentation"
      onSlotClick : event = "SLOT_CLICK"
        @label "On Slot Click"
        @description "Called when a time slot is clicked"
        @tier "presentation"
      onDayClick : event = "DAY_CLICK"
        @label "On Day Click"
        @description "Called when a day header is clicked"
        @tier "presentation"
      onEventClick : event = "EVENT_CLICK"
        @label "On Event Click"
        @description "Called when an event is clicked"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      longPressEvent : event = "LONG_PRESS"
        @label "Long Press Event"
        @description "Event emitted on long-press of a time slot: UI:{longPressEvent} with { date, time, ...longPressPayload }"
        @tier "presentation"
      longPressPayload : @payload @config.longPressEvent
        @label "Long Press Payload"
        @description "Additional payload for long-press events"
        @tier "presentation"
      swipeLeftEvent : event = "SWIPE_LEFT"
        @label "Swipe Left Event"
        @description "Event emitted on swipe left (next week): UI:{swipeLeftEvent}"
        @tier "presentation"
      swipeRightEvent : event = "SWIPE_RIGHT"
        @label "Swipe Right Event"
        @description "Event emitted on swipe right (prev week): UI:{swipeRightEvent}"
        @tier "presentation"
      dayWindow : "auto"
        @label "Day Window"
        @description "Override the viewport-driven day window. `'auto'` (default) tracks `window.innerWidth` — 1 day on mobile, 3 on tablet, 7 on laptop+. Pass an explicit number to force a fixed window (useful for print layouts or screenshot tests)."
        @tier "presentation"
      titleField : string = title
        @label "Title Field"
        @description "Row field holding the chip label. Defaults to `title`. Lets a host bound to its own entity name the column instead of being forced to rename its fields to this grid's contract (same accessor idiom as `DataList`'s `senderField` / `DataGrid`'s `imageField`)."
        @tier "presentation"
      startField : string = startTime
        @label "Start Field"
        @description "Row field holding the start timestamp (ISO or epoch). Defaults to `startTime`."
        @tier "presentation"
      endField : string = endTime
        @label "End Field"
        @description "Row field holding the end timestamp (ISO or epoch). Defaults to `endTime`. When a row carries an end, the event's chip renders in its start slot and every further slot it covers shows a subdued continuation bar — without this, multi-hour events silently collapsed to their first hour."
        @tier "presentation"
      colorField : string = color
        @label "Color Field"
        @description "Row field holding the chip's Tailwind colour class. Defaults to `color`."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/calendar-grid" as CalendarGridPage -> CalendarGridRender
}
