app ui-floating-toolbar "1.0.0"
"FloatingToolbar — UI factory (1:1 with the @almadar/ui floating-toolbar pattern)."
;; @pattern "floating-toolbar"
orbital FloatingToolbarOrbital {
  type FloatingToolbarItemsItem = {
    id : string!
    icon : icon!
    label : string!
    event : event
    action : event
    actionPayload : @payload action
    active : boolean
    disabled : boolean
    testId : string
    roles : [string]
  }

  entity FloatingToolbarItem [runtime] {
    id : string!
  }

  trait FloatingToolbarRender -> @rebindable FloatingToolbarItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          items: (array/filter @config.items (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          position: @config.position
          children: @config.children
          className: @config.className
          type: floating-toolbar
        })
    }

    config {
      items : [FloatingToolbarItemsItem] = []
        @label "Items"
        @description "Tool items rendered as icon buttons"
        @tier "presentation"
      position : "bottom-center" | "bottom-left" | "bottom-right" | "top-center" | "top-left" | "top-right" = "bottom-center"
        @label "Position"
        @description "Strip position within the app frame."
        @tier "presentation"
      children : node
        @label "Children"
        @description "Custom cells appended after the items, separated by a divider"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes on the positioned root"
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/floating-toolbar" as FloatingToolbarPage -> FloatingToolbarRender
}
