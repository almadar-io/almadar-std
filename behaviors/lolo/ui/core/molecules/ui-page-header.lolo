app ui-page-header "1.0.0"
"PageHeader — UI factory (1:1 with the @almadar/ui page-header pattern)."
;; @pattern "page-header"
orbital PageHeaderOrbital {
  type PageHeaderBreadcrumbsItem = {
    label : string!
    href : string
  }
  type PageHeaderStatus = {
    label : string!
    variant : "default" | "success" | "warning" | "danger" | "info"
  }
  type PageHeaderActionsItem = {
    label : string!
    navigatesTo : string
    event : event
    variant : "primary" | "secondary" | "ghost" | "danger"
    icon : icon
    loading : boolean
    disabled : boolean
    roles : [string]
  }
  type PageHeaderError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type PageHeaderTabsItem = {
    label : string!
    value : string!
    count : number
  }

  entity PageHeaderItem [runtime] {
    id : string!
  }

  trait PageHeaderRender -> @rebindable PageHeaderItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          skeleton: @config.skeleton
          title: @config.title
          icon: @config.icon
          subtitle: @config.subtitle
          showBack: @config.showBack
          backEvent: @config.backEvent
          breadcrumbs: @config.breadcrumbs
          status: @config.status
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          tabs: @config.tabs
          activeTab: @config.activeTab
          onTabChange: @config.onTabChange
          children: @config.children
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: page-header
        })
    }

    emits {
      @config.backEvent -> external { }
        @description "Event to emit when back is clicked (default: BACK)"
        @tier "essential"
      @config.onTabChange -> external {
        value : string
      }
        @description "onTabChange prop"
        @tier "essential"
    }

    config {
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none" = header
        @label "Skeleton"
        @description "The shape an empty slot shows while this header's server render is in flight (`none` opts out). @default 'header'"
        @tier "presentation"
      title : scalar
        @label "Title"
        @description "Page title - accepts string or number from generated code accessing dynamic entity data"
        @tier "presentation"
      icon : icon
        @label "Icon"
        @description "Icon shown before the title."
        @tier "presentation"
      subtitle : scalar
        @label "Subtitle"
        @description "Optional subtitle/description"
        @tier "presentation"
      showBack : boolean = false
        @label "Show Back"
        @description "Show back button"
        @tier "presentation"
      backEvent : event = "BACK"
        @label "Back Event"
        @description "Event to emit when back is clicked (default: BACK)"
        @tier "presentation"
      breadcrumbs : [PageHeaderBreadcrumbsItem] = []
        @label "Breadcrumbs"
        @description "Breadcrumbs"
        @tier "presentation"
      status : PageHeaderStatus
        @label "Status"
        @description "Status badge — a bare string (an entity's status field bound directly, e.g. `status: @entity.status`) renders as a default-variant badge"
        @tier "presentation"
      actions : [PageHeaderActionsItem] = []
        @label "Actions"
        @description "Actions array - first action with variant='primary' (or first action) is the main action"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : PageHeaderError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      tabs : [PageHeaderTabsItem] = []
        @label "Tabs"
        @description "Tabs for sub-navigation"
        @tier "presentation"
      activeTab : string
        @label "Active Tab"
        @description "activeTab prop"
        @tier "presentation"
      onTabChange : event = "TAB_CHANGE"
        @label "On Tab Change"
        @description "onTabChange prop"
        @tier "presentation"
      children : node
        @label "Children"
        @description "Custom content in the header"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/page-header" as PageHeaderPage -> PageHeaderRender
}
