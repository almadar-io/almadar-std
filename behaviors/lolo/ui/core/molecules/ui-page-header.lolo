app ui-page-header "1.0.0"
"PageHeader — UI factory (1:1 with the @almadar/ui page-header pattern)."
;; @pattern "page-header"
orbital PageHeaderOrbital {
  type PageHeaderBreadcrumbsItem = {
    label : string!
    href : string
  }
  type PageHeaderStatus = {
    label : string!
    variant : "default" | "success" | "warning" | "danger" | "info"
  }
  type PageHeaderActionsItem = {
    label : string!
    navigatesTo : string
    event : event
    variant : "primary" | "secondary" | "ghost" | "danger"
    icon : icon
    loading : boolean
    disabled : boolean
    roles : [string]
  }
  type PageHeaderError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type PageHeaderTabsItem = {
    label : string!
    value : string!
    count : number
  }

  entity PageHeaderItem [runtime] {
    id : string!
  }

  trait PageHeaderRender -> @rebindable PageHeaderItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          title: @config.title
          icon: @config.icon
          subtitle: @config.subtitle
          showBack: @config.showBack
          backEvent: @config.backEvent
          breadcrumbs: @config.breadcrumbs
          status: @config.status
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          tabs: @config.tabs
          activeTab: @config.activeTab
          onTabChange: @config.onTabChange
          children: @config.children
          className: @config.className
          type: page-header
        })
    }

    emits {
      @config.backEvent -> external { }
        @description "Event to emit when back is clicked (default: BACK)"
        @tier "essential"
      @config.onTabChange -> external {
        value : string
      }
        @description "onTabChange prop"
        @tier "essential"
    }

    config {
      title : scalar
        @label "Title"
        @description "Page title - accepts string or number from generated code accessing dynamic entity data"
        @tier "presentation"
      icon : icon
        @label "Icon"
        @description "Icon shown before the title."
        @tier "presentation"
      subtitle : scalar
        @label "Subtitle"
        @description "Optional subtitle/description"
        @tier "presentation"
      showBack : boolean = false
        @label "Show Back"
        @description "Show back button"
        @tier "presentation"
      backEvent : event = "BACK"
        @label "Back Event"
        @description "Event to emit when back is clicked (default: BACK)"
        @tier "presentation"
      breadcrumbs : [PageHeaderBreadcrumbsItem] = []
        @label "Breadcrumbs"
        @description "Breadcrumbs"
        @tier "presentation"
      status : PageHeaderStatus
        @label "Status"
        @description "Status badge — a bare string (an entity's status field bound directly, e.g. `status: @entity.status`) renders as a default-variant badge"
        @tier "presentation"
      actions : [PageHeaderActionsItem] = []
        @label "Actions"
        @description "Actions array - first action with variant='primary' (or first action) is the main action"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : PageHeaderError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      tabs : [PageHeaderTabsItem] = []
        @label "Tabs"
        @description "Tabs for sub-navigation"
        @tier "presentation"
      activeTab : string
        @label "Active Tab"
        @description "activeTab prop"
        @tier "presentation"
      onTabChange : event = "TAB_CHANGE"
        @label "On Tab Change"
        @description "onTabChange prop"
        @tier "presentation"
      children : node
        @label "Children"
        @description "Custom content in the header"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/page-header" as PageHeaderPage -> PageHeaderRender
}
