app ui-pagination "1.0.0"
"Pagination — UI factory (1:1 with the @almadar/ui pagination pattern)."
;; @pattern "pagination"
orbital PaginationOrbital {
  entity PaginationItem [runtime] {
    id : string!
    pageSize : number @intrinsic
  }

  trait PaginationRender -> @rebindable PaginationItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.pageSize @config.pageSize)
        (render-ui main {
          currentPage: @config.currentPage
          totalPages: @config.totalPages
          onPageChange: @config.onPageChange
          showPageSize: @config.showPageSize
          pageSizeOptions: @config.pageSizeOptions
          pageSize: @entity.pageSize
          onPageSizeChange: @config.onPageSizeChange
          showJumpToPage: @config.showJumpToPage
          showTotal: @config.showTotal
          totalItems: @config.totalItems
          maxVisiblePages: @config.maxVisiblePages
          className: @config.className
          pageChangeEvent: @config.pageChangeEvent
          pageSizeChangeEvent: @config.pageSizeChangeEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: pagination
        })
      PAGE_SIZE_CHANGE -> idle
        (set @entity.pageSize ?pageSize)
        (render-ui main {
          currentPage: @config.currentPage
          totalPages: @config.totalPages
          onPageChange: @config.onPageChange
          showPageSize: @config.showPageSize
          pageSizeOptions: @config.pageSizeOptions
          pageSize: @entity.pageSize
          onPageSizeChange: @config.onPageSizeChange
          showJumpToPage: @config.showJumpToPage
          showTotal: @config.showTotal
          totalItems: @config.totalItems
          maxVisiblePages: @config.maxVisiblePages
          className: @config.className
          pageChangeEvent: @config.pageChangeEvent
          pageSizeChangeEvent: @config.pageSizeChangeEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: pagination
        })
    }

    emits {
      @config.onPageChange -> external {
        page : number
      }
        @description "Callback when page changes (optional - can be a no-op if not interactive)"
        @tier "essential"
      @config.onPageSizeChange -> external {
        size : number
        pageSize : number!
      }
        @description "Callback when page size changes"
        @tier "essential"
    }

    listens {
      PAGE_SIZE_CHANGE {
        size : number
        pageSize : number!
      }
    }

    config {
      currentPage : number = 1
        @label "Current Page"
        @description "Current page (1-indexed)"
        @tier "presentation"
      totalPages : number = 1
        @label "Total Pages"
        @description "Total number of pages"
        @tier "presentation"
      onPageChange : event = "PAGE_CHANGE"
        @label "On Page Change"
        @description "Callback when page changes (optional - can be a no-op if not interactive)"
        @tier "presentation"
      showPageSize : boolean = false
        @label "Show Page Size"
        @description "Show page size selector"
        @tier "presentation"
      pageSizeOptions : [number] = [10, 20, 50, 100]
        @label "Page Size Options"
        @description "Page size options"
        @tier "presentation"
      pageSize : number
        @label "Page Size"
        @description "Current page size"
        @tier "presentation"
      onPageSizeChange : event = "PAGE_SIZE_CHANGE"
        @label "On Page Size Change"
        @description "Callback when page size changes"
        @tier "presentation"
      showJumpToPage : boolean = false
        @label "Show Jump To Page"
        @description "Show jump to page input"
        @tier "presentation"
      showTotal : boolean = false
        @label "Show Total"
        @description "Show total count"
        @tier "presentation"
      totalItems : number
        @label "Total Items"
        @description "Total items count"
        @tier "presentation"
      maxVisiblePages : number = 7
        @label "Max Visible Pages"
        @description "Maximum number of page buttons to show"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      pageChangeEvent : event = "PAGE_CHANGE"
        @label "Page Change Event"
        @description "Declarative page change event — emits UI:{pageChangeEvent} with { page }"
        @tier "presentation"
      pageSizeChangeEvent : event = "PAGE_SIZE_CHANGE"
        @label "Page Size Change Event"
        @description "Declarative page size change event — emits UI:{pageSizeChangeEvent} with { pageSize }"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/pagination" as PaginationPage -> PaginationRender
}
