app ui-gantt "1.0.0"
"Gantt — view-only task schedule rendering rows as bars on a day axis. — UI factory (1:1 with the @almadar/ui gantt pattern)."
;; @capabilities "gantt chart, project timeline, schedule view, task bars, dependency arrows, roadmap, milestone plan"
;; @pattern "gantt"
orbital GanttOrbital {
    type GanttLoaded = Event { data : [GanttItem] } "Gantt rows finished loading; payload.data holds the collection"
  type GanttLinksItem = {
    from : string!
    to : string!
  }
  type GanttStatusColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type GanttError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity GanttItem [runtime] {
    id : string!
  }

  trait GanttRender -> @rebindable GanttItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch GanttItem { emit: { success: GanttLoaded } })
        (render-ui main {
          tasks: @entity
          links: @config.links
          titleField: @config.titleField
          startField: @config.startField
          endField: @config.endField
          durationField: @config.durationField
          statusField: @config.statusField
          statusColorMap: @config.statusColorMap
          groupField: @config.groupField
          rangeStart: @config.rangeStart
          rangeEnd: @config.rangeEnd
          showToday: @config.showToday
          dayWidth: @config.dayWidth
          barClickEvent: @config.barClickEvent
          surface: @config.surface
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: gantt
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          tasks: @entity
          links: @config.links
          titleField: @config.titleField
          startField: @config.startField
          endField: @config.endField
          durationField: @config.durationField
          statusField: @config.statusField
          statusColorMap: @config.statusColorMap
          groupField: @config.groupField
          rangeStart: @config.rangeStart
          rangeEnd: @config.rangeEnd
          showToday: @config.showToday
          dayWidth: @config.dayWidth
          barClickEvent: @config.barClickEvent
          surface: @config.surface
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: gantt
        })
      GanttLoaded -> idle
        (render-ui main {
          tasks: @payload.data
          links: @config.links
          titleField: @config.titleField
          startField: @config.startField
          endField: @config.endField
          durationField: @config.durationField
          statusField: @config.statusField
          statusColorMap: @config.statusColorMap
          groupField: @config.groupField
          rangeStart: @config.rangeStart
          rangeEnd: @config.rangeEnd
          showToday: @config.showToday
          dayWidth: @config.dayWidth
          barClickEvent: @config.barClickEvent
          surface: @config.surface
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: gantt
        })
    }

    emits {
      @config.barClickEvent -> external {
        id : string!
      }
        @description "Event emitted when a bar is clicked: UI:{barClickEvent} with { id }"
        @tier "essential"
      GanttLoaded
        @description "Gantt rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      links : [GanttLinksItem] = []
        @label "Links"
        @description "Dependency arrows between task ids"
        @tier "presentation"
      titleField : string = title
        @label "Title Field"
        @description "Row field holding the bar label. Defaults to `title`."
        @tier "presentation"
      startField : string = start
        @label "Start Field"
        @description "Row field holding the start timestamp (ISO or epoch). Defaults to `start`."
        @tier "presentation"
      endField : string = end
        @label "End Field"
        @description "Row field holding the end timestamp (ISO or epoch). Defaults to `end`. When absent, `durationField` (days) is used instead."
        @tier "presentation"
      durationField : string
        @label "Duration Field"
        @description "Row field holding the task length in days, used when the row has no end."
        @tier "presentation"
      statusField : string = status
        @label "Status Field"
        @description "Row field holding the bar status. Defaults to `status`."
        @tier "presentation"
      statusColorMap : Map string GanttStatusColorMapValue = { item: default }
        @label "Status Color Map"
        @description "Bar colour per exact status value; unmapped statuses are primary bars."
        @tier "presentation"
      groupField : string
        @label "Group Field"
        @description "Row field rows are grouped under header rows by. Empty (default) = flat list."
        @tier "presentation"
      rangeStart : date = "2024-01-01"
        @label "Range Start"
        @description "First visible day (ISO or Date). Defaults to 2 days before the earliest task."
        @tier "presentation"
      rangeEnd : date = "2024-01-01"
        @label "Range End"
        @description "Last visible day (ISO or Date). Defaults to 2 days after the latest task end."
        @tier "presentation"
      showToday : boolean = true
        @label "Show Today"
        @description "Paint the today marker line when today falls inside the range (default true)."
        @tier "presentation"
      dayWidth : number = 28
        @label "Day Width"
        @description "Pixels per day on the axis (default 28)"
        @tier "presentation"
      barClickEvent : event = "BAR_CLICK"
        @label "Bar Click Event"
        @description "Event emitted when a bar is clicked: UI:{barClickEvent} with { id }"
        @tier "presentation"
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : GanttError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/gantt" as GanttPage -> GanttRender
}
