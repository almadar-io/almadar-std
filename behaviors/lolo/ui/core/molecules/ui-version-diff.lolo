app ui-version-diff "1.0.0"
"A line diff between two versions — two whole texts, or a pre-computed diff such as one commit. — UI factory (1:1 with the @almadar/ui version-diff pattern)."
;; @capabilities "version diff, compare revisions, what changed, before and after, code diff, commit diff, revision comparison"
;; @pattern "version-diff"
orbital VersionDiffOrbital {
  type VersionDiffRevisionsItem = {
    id : string!
    label : string!
    author : string
    timestamp : string
    content : string!
  }
  type VersionDiffHunksItem = {
    header : string!
    lines : [VersionDiffHunksItemLinesItem]!
  }
  type VersionDiffHunksItemLinesItem = {
    type : "added" | "removed" | "unchanged" | "context"!
    beforeLineNumber : number
    afterLineNumber : number
    content : string!
  }

  entity VersionDiffItem [runtime] {
    id : string!
  }

  trait VersionDiffRender -> @rebindable VersionDiffItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          revisions: @config.revisions
          hunks: @config.hunks
          beforeId: @config.beforeId
          afterId: @config.afterId
          view: @config.view
          onSelectBefore: @config.onSelectBefore
          onSelectAfter: @config.onSelectAfter
          onRevert: @config.onRevert
          selectBeforeEvent: @config.selectBeforeEvent
          selectAfterEvent: @config.selectAfterEvent
          revertEvent: @config.revertEvent
          language: @config.language
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: version-diff
        })
    }

    emits {
      @config.onSelectBefore -> external {
        id : string
      }
        @description "Called when the user picks a different 'before' revision."
        @tier "essential"
      @config.onSelectAfter -> external {
        id : string
      }
        @description "Called when the user picks a different 'after' revision."
        @tier "essential"
      @config.onRevert -> external {
        id : string
      }
        @description "Called when the user clicks the revert button (passes the 'before' id)."
        @tier "essential"
    }

    config {
      revisions : [VersionDiffRevisionsItem] = []
        @label "Revisions"
        @description "All available revisions (at least 2). Accepts either a typed array (direct consumers) or the runtime payload shape from a render-ui binding (`@payload.revisions`). Narrowed to `[]` internally when the value isn't an array."
        @tier "presentation"
      hunks : [VersionDiffHunksItem] = []
        @label "Hunks"
        @description "A pre-computed diff to render instead of diffing `revisions` (no revision pickers)."
        @tier "presentation"
      beforeId : string
        @label "Before Id"
        @description "Currently selected 'before' revision id."
        @tier "presentation"
      afterId : string
        @label "After Id"
        @description "Currently selected 'after' revision id."
        @tier "presentation"
      view : "side-by-side" | "inline" = "side-by-side"
        @label "View"
        @description "Display mode to start in; the toggle switches it."
        @tier "presentation"
      onSelectBefore : event = "SELECT_BEFORE"
        @label "On Select Before"
        @description "Called when the user picks a different 'before' revision."
        @tier "presentation"
      onSelectAfter : event = "SELECT_AFTER"
        @label "On Select After"
        @description "Called when the user picks a different 'after' revision."
        @tier "presentation"
      onRevert : event = "REVERT"
        @label "On Revert"
        @description "Called when the user clicks the revert button (passes the 'before' id)."
        @tier "presentation"
      selectBeforeEvent : event = "SELECT_BEFORE"
        @label "Select Before Event"
        @description "Event name dispatched via event bus when the 'before' revision changes. Payload: { id }."
        @tier "presentation"
      selectAfterEvent : event = "SELECT_AFTER"
        @label "Select After Event"
        @description "Event name dispatched via event bus when the 'after' revision changes. Payload: { id }."
        @tier "presentation"
      revertEvent : event = "REVERT"
        @label "Revert Event"
        @description "Event name dispatched via event bus when the user clicks revert. Payload: { id }."
        @tier "presentation"
      language : string
        @label "Language"
        @description "Language label (informational)."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/version-diff" as VersionDiffPage -> VersionDiffRender
}
