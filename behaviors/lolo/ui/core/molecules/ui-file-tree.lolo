app ui-file-tree [
  version: "1.0.0",
  description: "FileTree — UI factory (1:1 with the @almadar/ui file-tree pattern)."
]
;; @pattern "file-tree"
orbital FileTreeOrbital {
  type FileTreeTreeItem = {
    name : string!
    path : string!
    type : "file" | "dir"!
    children : [FileTreeTreeItem]
    note : string
    expandable : boolean
    size : number
    language : string
  }
  type FileTreeItemsItem = {
    id : string!
    label : string!
    parentId : string
    icon : string
  }

  entity FileTreeItem [runtime] {
    id : string!
  }

  trait FileTreeRender -> @rebindable FileTreeItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          tree: @config.tree
          items: @config.items
          selectedPath: @config.selectedPath
          selectedId: @config.selectedId
          look: @config.look
          onFileSelect: @config.onFileSelect
          onNodeExpand: @config.onNodeExpand
          expandedPaths: @config.expandedPaths
          onNodeSelect: @config.onNodeSelect
          onNodeAction: @config.onNodeAction
          nodeActionIcon: @config.nodeActionIcon
          nodeActionLabel: @config.nodeActionLabel
          onNodeReorder: @config.onNodeReorder
          className: @config.className
          indent: @config.indent
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: file-tree
        })
    }

    emits {
      @config.onFileSelect -> external {
        path : string
      }
        @description "Called when a file is clicked"
        @tier "essential"
      @config.onNodeExpand -> external {
        path : string
      }
        @description "Called the first time a node marked `expandable` is expanded, with its path, so its children can be loaded."
        @tier "essential"
    }

    config {
      tree : [FileTreeTreeItem] = []
        @label "Tree"
        @description "The tree data (pre-nested). Ignored when `items` is provided."
        @tier "presentation"
      items : [FileTreeItemsItem] = []
        @label "Items"
        @description "Flat node list, nested by `parentId` at render time — takes precedence over `tree` when provided. A `parentId` with no matching row renders that node as a root rather than dropping it."
        @tier "presentation"
      selectedPath : string
        @label "Selected Path"
        @description "Currently selected file path"
        @tier "presentation"
      selectedId : string
        @label "Selected Id"
        @description "Currently selected node id, in flat `items` mode: the row highlights and every ancestor auto-expands so the selection is always visible — the 'you are here' a navigation tree needs."
        @tier "presentation"
      look : "files" | "nav" = files
        @label "Look"
        @description "Visual treatment for flat `items` mode: `files` (default) keeps the monospace file-browser look; `nav` renders a sidebar navigation tree — regular font, document icons, roomier hit areas."
        @tier "presentation"
      onFileSelect : event = "FILE_SELECT"
        @label "On File Select"
        @description "Called when a file is clicked"
        @tier "presentation"
      onNodeExpand : event = "NODE_EXPAND"
        @label "On Node Expand"
        @description "Called the first time a node marked `expandable` is expanded, with its path, so its children can be loaded."
        @tier "presentation"
      expandedPaths : [string] = []
        @label "Expanded Paths"
        @description "Paths to show expanded (e.g. to reveal a node): each is expanded when it appears here, loading its children if needed."
        @tier "presentation"
      onNodeSelect : event = ""
        @label "On Node Select"
        @description "Called when a node is clicked, in flat `items` mode; carries the selected node's id. Presence-gated: binding this prop is what turns on the click-to-select affordance, mirroring Badge's `onRemove`."
        @tier "presentation"
      onNodeAction : event = ""
        @label "On Node Action"
        @description "Called from the row's hover action button, in flat `items` mode; carries that node's id. Presence-gated: binding it renders the action."
        @tier "presentation"
      nodeActionIcon : string
        @label "Node Action Icon"
        @description "Icon for the row hover action (default: plus)."
        @tier "presentation"
      nodeActionLabel : string
        @label "Node Action Label"
        @description "Accessible label/tooltip for the row hover action."
        @tier "presentation"
      onNodeReorder : event = ""
        @label "On Node Reorder"
        @description "Called when a row is dropped onto another, in flat `items` mode; carries the moved node's id, its new parent id (`null` for a root drop), and its index within the new parent's children. Presence-gated: binding this prop is what turns on row dragging."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "CSS class"
        @tier "presentation"
      indent : number = 16
        @label "Indent"
        @description "Indent size per level in px (default: 16)"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/file-tree" as FileTreePage -> FileTreeRender
}
