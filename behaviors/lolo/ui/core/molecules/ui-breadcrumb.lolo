app ui-breadcrumb "1.0.0"
"Breadcrumb — UI factory (1:1 with the @almadar/ui breadcrumb pattern)."
orbital BreadcrumbOrbital {
  type BreadcrumbItemsItem = {
    label : string!
    href : string
    path : string
    icon : icon
    isCurrent : boolean
    event : string
  }

  entity BreadcrumbItem [runtime] {
    id : string!
  }

  trait BreadcrumbRender -> @rebindable BreadcrumbItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          items: @config.items
          fromNavStack: @config.fromNavStack
          itemEvent: @config.itemEvent
          separator: @config.separator
          maxItems: @config.maxItems
          className: @config.className
          type: breadcrumb
        })
    }

    emits {
      @config.itemEvent -> external {
        id : string
      }
        @description "Event emitted when a non-current crumb is clicked, with payload `{ label, href, index }` — the trait handles it with `(navigate ?href)`. Without it, stack crumbs navigate directly."
        @tier "essential"
    }

    config {
      items : [BreadcrumbItemsItem] = []
        @label "Items"
        @description "Breadcrumb items. Omit together with `fromNavStack` to render the orbital-scoped navigation stack instead of an authored trail."
        @tier "presentation"
      fromNavStack : boolean = false
        @label "From Nav Stack"
        @description "Render the current orbital's navigation stack (NavStackProvider) as the trail: one crumb per visited/declared level, last entry current. The stack is client-session state both execution paths maintain; outside a provider this renders nothing."
        @tier "presentation"
      itemEvent : string = "ITEM"
        @label "Item Event"
        @description "Event emitted when a non-current crumb is clicked, with payload `{ label, href, index }` — the trait handles it with `(navigate ?href)`. Without it, stack crumbs navigate directly."
        @tier "presentation"
      separator : icon
        @label "Separator"
        @description "Separator icon (canonical kebab-case name or LucideIcon component)"
        @tier "presentation"
      maxItems : number
        @label "Max Items"
        @description "Maximum items to show (truncates with ellipsis)"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
    }
  }

  page "/breadcrumb" as BreadcrumbPage -> BreadcrumbRender
}
