app ui-input-group "1.0.0"
"InputGroup — UI factory (1:1 with the @almadar/ui input-group pattern)."
;; @pattern "input-group"
orbital InputGroupOrbital {
  type InputGroupOptionsItem = {
    value : string!
    label : string!
  }

  entity InputGroupItem [runtime] {
    id : string!
  }

  trait InputGroupRender -> @rebindable InputGroupItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          placeholder: @config.placeholder
          value: @config.value
          disabled: @config.disabled
          action: @config.action
          inputType: @config.inputType
          label: @config.label
          helperText: @config.helperText
          error: @config.error
          leftIcon: @config.leftIcon
          rightIcon: @config.rightIcon
          clearable: @config.clearable
          onClear: @config.onClear
          options: @config.options
          rows: @config.rows
          onChange: @config.onChange
          leftAddon: @config.leftAddon
          rightAddon: @config.rightAddon
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: input-group
        })
    }

    emits {
      @config.action -> external {
        value : match @config.inputType {
          "number" -> number
          _ -> string
        }!
      }
        @description "Declarative event name for trait dispatch."
        @tier "essential"
      @config.onClear -> external { }
        @description "Callback or declarative event key when clear button is clicked"
        @tier "essential"
      @config.onChange -> external { }
        @description "onChange handler or declarative event key for trait dispatch"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Placeholder text"
        @tier "presentation"
      value : scalar
        @label "Value"
        @description "Current value"
        @tier "presentation"
      disabled : boolean
        @label "Disabled"
        @description "Whether input is disabled"
        @tier "presentation"
      action : event = "ACTION"
        @label "Action"
        @description "Declarative event name for trait dispatch."
        @tier "presentation"
      inputType : "text" | "email" | "password" | "number" | "tel" | "url" | "search" | "date" | "datetime-local" | "time" | "checkbox" | "select" | "textarea"
        @label "Input Type"
        @description "Input type — selects the field's data mode. Use 'password' for masked credentials / secret / passphrase entry (there is no separate password pattern); 'email', 'tel', 'url', 'number', 'search', 'date', and 'time' for their respective values; and 'select' / 'textarea' for choice and multi-line entry in addition to the standard single-line types."
        @tier "presentation"
      label : string
        @label "Label"
        @description "label prop"
        @tier "presentation"
      helperText : string
        @label "Helper Text"
        @description "helperText prop"
        @tier "presentation"
      error : string
        @label "Error"
        @description "error prop"
        @tier "presentation"
      leftIcon : icon
        @label "Left Icon"
        @description "leftIcon prop"
        @tier "presentation"
      rightIcon : icon
        @label "Right Icon"
        @description "rightIcon prop"
        @tier "presentation"
      clearable : boolean
        @label "Clearable"
        @description "Show clear button when input has value"
        @tier "presentation"
      onClear : event = "CLEAR"
        @label "On Clear"
        @description "Callback or declarative event key when clear button is clicked"
        @tier "presentation"
      options : [InputGroupOptionsItem] = []
        @label "Options"
        @description "Options for select type"
        @tier "presentation"
      rows : number
        @label "Rows"
        @description "Rows for textarea type"
        @tier "presentation"
      onChange : event = "CHANGE"
        @label "On Change"
        @description "onChange handler or declarative event key for trait dispatch"
        @tier "presentation"
      leftAddon : node
        @label "Left Addon"
        @description "Left addon (icon, button, or text)"
        @tier "presentation"
      rightAddon : node
        @label "Right Addon"
        @description "Right addon (icon, button, or text)"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/input-group" as InputGroupPage -> InputGroupRender
}
