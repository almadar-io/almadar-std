app ui-sortable-list "1.0.0"
"SortableList — a drag-and-drop reorderable list of items. — UI factory (1:1 with the @almadar/ui sortable-list pattern)."
;; @capabilities "checklist, task list, to-do list, priority list, ranked list, drag-to-reorder queue"
orbital SortableListOrbital {
    type SortableListLoaded = Event { data : [SortableListItem] } "SortableList rows finished loading; payload.data holds the collection"

  entity SortableListItem [runtime] {
    id : string!
  }

  trait SortableListRender -> @rebindable SortableListItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch SortableListItem { emit: { success: SortableListLoaded } })
        (render-ui main {
          items: @entity
          renderItem: (fn item { content: (object/get @item @config.itemLabelField ""), type: typography })
          reorderEvent: @config.reorderEvent
          reorderPayload: @config.reorderPayload
          dragHandlePosition: @config.dragHandlePosition
          className: @config.className
          type: sortable-list
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          items: @entity
          renderItem: (fn item { content: (object/get @item @config.itemLabelField ""), type: typography })
          reorderEvent: @config.reorderEvent
          reorderPayload: @config.reorderPayload
          dragHandlePosition: @config.dragHandlePosition
          className: @config.className
          type: sortable-list
        })
      SortableListLoaded -> idle
        (render-ui main {
          items: @payload.data
          renderItem: (fn item { content: (object/get @item @config.itemLabelField ""), type: typography })
          reorderEvent: @config.reorderEvent
          reorderPayload: @config.reorderPayload
          dragHandlePosition: @config.dragHandlePosition
          className: @config.className
          type: sortable-list
        })
    }

    emits {
      @config.reorderEvent -> external {
        fromIndex : number!
        toIndex : number!
        item : @entity!
      }
        @description "reorderEvent prop"
        @tier "essential"
      SortableListLoaded
        @description "SortableList rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      itemLabelField : string = "id"
        @label "Item label field"
        @description "Row field rendered as each item's label (defaults to id)."
        @tier "presentation"
      reorderEvent : event = "REORDER"
        @label "Reorder Event"
        @description "reorderEvent prop"
        @tier "presentation"
      reorderPayload : @payload @config.reorderEvent
        @label "Reorder Payload"
        @description "reorderPayload prop"
        @tier "presentation"
      dragHandlePosition : "left" | "right" = left
        @label "Drag Handle Position"
        @description "dragHandlePosition prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/sortable-list" as SortableListPage -> SortableListRender
}
