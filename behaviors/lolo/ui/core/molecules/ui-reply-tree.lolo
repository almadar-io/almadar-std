app ui-reply-tree [
  version: "1.0.0",
  description: "ReplyTree — UI factory (1:1 with the @almadar/ui reply-tree pattern)."
]
;; @pattern "reply-tree"
orbital ReplyTreeOrbital {
    type ReplyTreeLoaded = Event { data : [ReplyTreeItem] } "ReplyTree rows finished loading; payload.data holds the collection"
  type ReplyNodeRow = {
    authorName : string
    content : string
    authorAvatarUrl : string
    postedAt : string
    voteCount : number
    userVote : "up" | "down" | "none"
    collapsed : boolean
    replies : [ReplyNodeRow]
  }

  entity ReplyTreeItem [runtime] {
    id : string!
    authorName : string = "Author Name"
    content : string = "Content"
    authorAvatarUrl : string = "Author Avatar Url"
    postedAt : string = "Posted At"
    voteCount : number = 1
    userVote : "up" | "down" | "none" = up
    collapsed : boolean = false
    replies : [ReplyNodeRow] = []
  }

  trait ReplyTreeRender -> @rebindable ReplyTreeItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch ReplyTreeItem { emit: { success: ReplyTreeLoaded } })
        (render-ui main {
          nodes: @entity
          maxDepth: @config.maxDepth
          onVote: @config.onVote
          onReply: @config.onReply
          onFlag: @config.onFlag
          onContinueThread: @config.onContinueThread
          voteEvent: @config.voteEvent
          replyEvent: @config.replyEvent
          flagEvent: @config.flagEvent
          continueThreadEvent: @config.continueThreadEvent
          showActions: @config.showActions
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: reply-tree
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          nodes: @entity
          maxDepth: @config.maxDepth
          onVote: @config.onVote
          onReply: @config.onReply
          onFlag: @config.onFlag
          onContinueThread: @config.onContinueThread
          voteEvent: @config.voteEvent
          replyEvent: @config.replyEvent
          flagEvent: @config.flagEvent
          continueThreadEvent: @config.continueThreadEvent
          showActions: @config.showActions
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: reply-tree
        })
      ReplyTreeLoaded -> idle
        (render-ui main {
          nodes: @payload.data
          maxDepth: @config.maxDepth
          onVote: @config.onVote
          onReply: @config.onReply
          onFlag: @config.onFlag
          onContinueThread: @config.onContinueThread
          voteEvent: @config.voteEvent
          replyEvent: @config.replyEvent
          flagEvent: @config.flagEvent
          continueThreadEvent: @config.continueThreadEvent
          showActions: @config.showActions
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: reply-tree
        })
    }

    emits {
      @config.onVote -> external {
        nodeId : string
        vote : string
      }
        @description "onVote prop"
        @tier "essential"
      @config.onReply -> external {
        parentNodeId : string
        content : string!
      }
        @description "onReply prop"
        @tier "essential"
      @config.onFlag -> external {
        nodeId : string
      }
        @description "onFlag prop"
        @tier "essential"
      @config.onContinueThread -> external {
        nodeId : string
      }
        @description "onContinueThread prop"
        @tier "essential"
      ReplyTreeLoaded
        @description "ReplyTree rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      maxDepth : number = 6
        @label "Max Depth"
        @description "maxDepth prop"
        @tier "presentation"
      onVote : event = "VOTE"
        @label "On Vote"
        @description "onVote prop"
        @tier "presentation"
      onReply : event = "REPLY"
        @label "On Reply"
        @description "onReply prop"
        @tier "presentation"
      onFlag : event = "FLAG"
        @label "On Flag"
        @description "onFlag prop"
        @tier "presentation"
      onContinueThread : event = "CONTINUE_THREAD"
        @label "On Continue Thread"
        @description "onContinueThread prop"
        @tier "presentation"
      voteEvent : event = "VOTE"
        @label "Vote Event"
        @description "voteEvent prop"
        @tier "presentation"
      replyEvent : event = "REPLY"
        @label "Reply Event"
        @description "replyEvent prop"
        @tier "presentation"
      flagEvent : event = "FLAG"
        @label "Flag Event"
        @description "flagEvent prop"
        @tier "presentation"
      continueThreadEvent : event = "CONTINUE_THREAD"
        @label "Continue Thread Event"
        @description "continueThreadEvent prop"
        @tier "presentation"
      showActions : boolean = true
        @label "Show Actions"
        @description "showActions prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/reply-tree" as ReplyTreePage -> ReplyTreeRender
}
