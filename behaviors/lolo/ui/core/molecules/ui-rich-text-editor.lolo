app ui-rich-text-editor "1.0.0"
"RichTextEditor — UI factory (1:1 with the @almadar/ui rich-text-editor pattern)."
orbital RichTextEditorOrbital {
  entity RichTextEditorItem [runtime] {
    id : string!
    value : string
  }

  trait RichTextEditorRender -> @rebindable RichTextEditorItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.value @config.value)
        (render-ui main {
          value: @entity.value
          onChange: @config.onChange
          changeEvent: @config.changeEvent
          readOnly: @config.readOnly
          placeholder: @config.placeholder
          showToolbar: @config.showToolbar
          className: @config.className
          type: rich-text-editor
        })
      CHANGE -> idle
        (set @entity.value ?value)
        (render-ui main {
          value: @entity.value
          onChange: @config.onChange
          changeEvent: @config.changeEvent
          readOnly: @config.readOnly
          placeholder: @config.placeholder
          showToolbar: @config.showToolbar
          className: @config.className
          type: rich-text-editor
        })
    }

    emits {
      @config.onChange -> external {
        value : string
      }
        @description "onChange prop"
        @tier "essential"
    }

    listens {
      CHANGE {
        value : string
      }
    }

    config {
      value : string
        @label "Value"
        @description "The rich text content as HTML. Sanitized before rendering and on every change."
        @tier "presentation"
      onChange : event = "CHANGE"
        @label "On Change"
        @description "onChange prop"
        @tier "presentation"
      changeEvent : event = "CHANGE"
        @label "Change Event"
        @description "changeEvent prop"
        @tier "presentation"
      readOnly : boolean = false
        @label "Read Only"
        @description "readOnly prop"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "placeholder prop"
        @tier "presentation"
      showToolbar : boolean = true
        @label "Show Toolbar"
        @description "showToolbar prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
    }
  }

  page "/rich-text-editor" as RichTextEditorPage -> RichTextEditorRender
}
