app ui-graph-canvas [
  version: "1.0.0",
  description: "GraphCanvas — UI factory (1:1 with the @almadar/ui graph-canvas pattern)."
]
;; @pattern "graph-canvas"
orbital GraphCanvasOrbital {
  type GraphCanvasNodesItem = {
    id : string!
    label : string
    group : string
    color : string
    size : number
    badge : number
    mark : GraphCanvasNodesItemMark
    x : number
    y : number
  }
  type GraphCanvasNodesItemMark = GraphCanvasNodesItemMarkSuggested | GraphCanvasNodesItemMarkProposed
  type GraphCanvasNodesItemMarkSuggested = {
    kind : "suggested"!
    suggestionId : string!
  }
  type GraphCanvasNodesItemMarkProposed = {
    kind : "proposed"!
    suggestionId : string!
    tint : string
  }
  type GraphCanvasEdgesItem = {
    source : string!
    target : string!
    label : string
    weight : number
    color : string
  }
  type GraphCanvasProposedEdgesItem = {
    source : string!
    target : string!
    label : string
    weight : number
    color : string
  }
  type GraphCanvasSimilarityItem = {
    source : string!
    target : string!
    weight : number!
  }
  type GraphCanvasActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost"
    roles : [string]
  }
  type GraphCanvasError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type GraphCanvasNODECLICKNode = {
    id : string!
    label : string
    group : string
    color : string
    size : number
    badge : number
    mark : GraphCanvasNODECLICKNodeMark
    x : number
    y : number
  }
  type GraphCanvasNODECLICKNodeMark = GraphCanvasNODECLICKNodeMarkSuggested | GraphCanvasNODECLICKNodeMarkProposed
  type GraphCanvasNODECLICKNodeMarkSuggested = {
    kind : "suggested"!
    suggestionId : string!
  }
  type GraphCanvasNODECLICKNodeMarkProposed = {
    kind : "proposed"!
    suggestionId : string!
    tint : string
  }
  type GraphCanvasMARKCLICKNode = {
    id : string!
    label : string
    group : string
    color : string
    size : number
    badge : number
    mark : GraphCanvasMARKCLICKNodeMark
    x : number
    y : number
  }
  type GraphCanvasMARKCLICKNodeMark = GraphCanvasMARKCLICKNodeMarkSuggested | GraphCanvasMARKCLICKNodeMarkProposed
  type GraphCanvasMARKCLICKNodeMarkSuggested = {
    kind : "suggested"!
    suggestionId : string!
  }
  type GraphCanvasMARKCLICKNodeMarkProposed = {
    kind : "proposed"!
    suggestionId : string!
    tint : string
  }
  type GraphCanvasNODEDOUBLECLICKNode = {
    id : string!
    label : string
    group : string
    color : string
    size : number
    badge : number
    mark : GraphCanvasNODEDOUBLECLICKNodeMark
    x : number
    y : number
  }
  type GraphCanvasNODEDOUBLECLICKNodeMark = GraphCanvasNODEDOUBLECLICKNodeMarkSuggested | GraphCanvasNODEDOUBLECLICKNodeMarkProposed
  type GraphCanvasNODEDOUBLECLICKNodeMarkSuggested = {
    kind : "suggested"!
    suggestionId : string!
  }
  type GraphCanvasNODEDOUBLECLICKNodeMarkProposed = {
    kind : "proposed"!
    suggestionId : string!
    tint : string
  }
  type GraphCanvasBADGECLICKNode = {
    id : string!
    label : string
    group : string
    color : string
    size : number
    badge : number
    mark : GraphCanvasBADGECLICKNodeMark
    x : number
    y : number
  }
  type GraphCanvasBADGECLICKNodeMark = GraphCanvasBADGECLICKNodeMarkSuggested | GraphCanvasBADGECLICKNodeMarkProposed
  type GraphCanvasBADGECLICKNodeMarkSuggested = {
    kind : "suggested"!
    suggestionId : string!
  }
  type GraphCanvasBADGECLICKNodeMarkProposed = {
    kind : "proposed"!
    suggestionId : string!
    tint : string
  }

  entity GraphCanvasItem [runtime] {
    id : string!
  }

  trait GraphCanvasRender -> @rebindable GraphCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          description: @config.description
          title: @config.title
          nodes: @config.nodes
          edges: @config.edges
          proposedEdges: @config.proposedEdges
          similarity: @config.similarity
          height: @config.height
          showLabels: @config.showLabels
          interactive: @config.interactive
          draggable: @config.draggable
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          onNodeClick: @config.onNodeClick
          onMarkClick: @config.onMarkClick
          onNodeDoubleClick: @config.onNodeDoubleClick
          onBadgeClick: @config.onBadgeClick
          nodeClickEvent: @config.nodeClickEvent
          selectedNodeId: @config.selectedNodeId
          repulsion: @config.repulsion
          linkDistance: @config.linkDistance
          nodeSpacing: @config.nodeSpacing
          linkOpacity: @config.linkOpacity
          layout: @config.layout
          isLoading: @config.isLoading
          error: @config.error
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: graph-canvas
        })
    }

    emits {
      @config.onNodeClick -> external {
        node : GraphCanvasNODECLICKNode
        id : string!
      }
        @description "On node click"
        @tier "essential"
      @config.onMarkClick -> external {
        node : GraphCanvasMARKCLICKNode
      }
        @description "On marked-node click (suggestion/proposal target). Takes priority over onNodeClick."
        @tier "essential"
      @config.onNodeDoubleClick -> external {
        node : GraphCanvasNODEDOUBLECLICKNode
      }
        @description "On node double-click (e.g. to drill in)"
        @tier "essential"
      @config.onBadgeClick -> external {
        node : GraphCanvasBADGECLICKNode
      }
        @description "On node badge click (e.g. to expand a merged cluster)."
        @tier "essential"
    }

    config {
      description : string
        @label "Description"
        @description "Text alternative for the graph, rendered as visually hidden text and linked by aria-describedby."
        @tier "presentation"
      title : string
        @label "Title"
        @description "Graph title"
        @tier "presentation"
      nodes : [GraphCanvasNodesItem] = []
        @label "Nodes"
        @description "Graph nodes"
        @tier "presentation"
      edges : [GraphCanvasEdgesItem] = []
        @label "Edges"
        @description "Graph edges (the only rendered links)"
        @tier "presentation"
      proposedEdges : [GraphCanvasProposedEdgesItem] = []
        @label "Proposed Edges"
        @description "Uncommitted proposal links — rendered dashed/faint in a separate pass, never folded into the layout springs."
        @tier "presentation"
      similarity : [GraphCanvasSimilarityItem] = []
        @label "Similarity"
        @description "All-pairs similarity (cosine 0–1) used ONLY for layout, never drawn. It is the secondary macro-layout: non-connected pairs get a weak spring (higher cosine ⇒ closer) so clusters arrange relative to each other; drawn `edges` stay the primary tight structure. When omitted, edges alone drive the layout."
        @tier "presentation"
      height : number = 400
        @label "Height"
        @description "Canvas height"
        @tier "presentation"
      showLabels : boolean = true
        @label "Show Labels"
        @description "Show node labels"
        @tier "presentation"
      interactive : boolean = true
        @label "Interactive"
        @description "Enable zoom/pan"
        @tier "presentation"
      draggable : boolean = true
        @label "Draggable"
        @description "Enable node dragging"
        @tier "presentation"
      actions : [GraphCanvasActionsItem] = []
        @label "Actions"
        @description "Actions"
        @tier "presentation"
      onNodeClick : event = "NODE_CLICK"
        @label "On Node Click"
        @description "On node click"
        @tier "presentation"
      onMarkClick : event = "MARK_CLICK"
        @label "On Mark Click"
        @description "On marked-node click (suggestion/proposal target). Takes priority over onNodeClick."
        @tier "presentation"
      onNodeDoubleClick : event = "NODE_DOUBLE_CLICK"
        @label "On Node Double Click"
        @description "On node double-click (e.g. to drill in)"
        @tier "presentation"
      onBadgeClick : event = "BADGE_CLICK"
        @label "On Badge Click"
        @description "On node badge click (e.g. to expand a merged cluster)."
        @tier "presentation"
      nodeClickEvent : event = "NODE_CLICK"
        @label "Node Click Event"
        @description "Node click event"
        @tier "presentation"
      selectedNodeId : string
        @label "Selected Node Id"
        @description "Currently selected node id (rendered emphasized)"
        @tier "presentation"
      repulsion : number = 800
        @label "Repulsion"
        @description "Force-sim repulsion strength between nodes (larger ⇒ more spread out)"
        @tier "presentation"
      linkDistance : number = 100
        @label "Link Distance"
        @description "Force-sim target edge length (larger ⇒ more spread out)"
        @tier "presentation"
      nodeSpacing : number = 28
        @label "Node Spacing"
        @description "Minimum empty gap (px) enforced between node edges so nodes never overlap."
        @tier "presentation"
      linkOpacity : number = 0.18
        @label "Link Opacity"
        @description "Base opacity for links when nothing is hovered (kept faint so dense graphs stay readable; incident links brighten on hover)."
        @tier "presentation"
      layout : "force" | "circular" | "grid" = force
        @label "Layout"
        @description "Layout algorithm"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : GraphCanvasError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/graph-canvas" as GraphCanvasPage -> GraphCanvasRender
}
