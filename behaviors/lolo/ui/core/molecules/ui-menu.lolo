app ui-menu "1.0.0"
"Menu — UI factory (1:1 with the @almadar/ui menu pattern)."
;; @pattern "menu"
orbital MenuOrbital {
  type MenuItemsItem = {
    id : string
    label : string!
    icon : icon
    badge : string
    disabled : boolean
    title : string
    event : event
    href : string
    url : string
    variant : "default" | "danger"
    subMenu : [MenuItemsItem]
    roles : [string]
  }

  entity MenuItem [runtime] {
    id : string!
  }

  trait MenuRender -> @rebindable MenuItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          trigger: @config.trigger
          items: (array/filter @config.items (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          position: @config.position
          className: @config.className
          header: @config.header
          footer: @config.footer
          type: menu
        })
    }

    config {
      trigger : node
        @label "Trigger"
        @description "Menu trigger element"
        @tier "presentation"
      items : [MenuItemsItem] = []
        @label "Items"
        @description "Menu items"
        @tier "presentation"
      position : "top-left" | "top-right" | "bottom-left" | "bottom-right" | "top-start" | "top-end" | "bottom-start" | "bottom-end" = "bottom-left"
        @label "Position"
        @description "Menu position"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      header : node
        @label "Header"
        @description "Optional slot rendered above the items."
        @tier "presentation"
      footer : node
        @label "Footer"
        @description "Optional slot rendered below the items."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/menu" as MenuPage -> MenuRender
}
