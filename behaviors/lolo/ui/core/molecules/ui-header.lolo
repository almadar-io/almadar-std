app ui-header "1.0.0"
"Header — UI factory (1:1 with the @almadar/ui header pattern)."
;; @pattern "header"
orbital HeaderOrbital {
  type HeaderNavigationItemsItem = {
    label : string!
    href : string
    icon : icon
    badge : string
    active : boolean
    children : [HeaderNavigationItemsItem]
  }
  type HeaderUserAvatar = {
    src : asset
    alt : string
    initials : string
  }
  type HeaderError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity HeaderItem [runtime] {
    id : string!
  }

  trait HeaderRender -> @rebindable HeaderItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          logo: @config.logo
          logoSrc: @config.logoSrc
          brandName: @config.brandName
          navigationItems: @config.navigationItems
          showMenuToggle: @config.showMenuToggle
          isMenuOpen: @config.isMenuOpen
          onMenuToggle: @config.onMenuToggle
          showSearch: @config.showSearch
          searchPlaceholder: @config.searchPlaceholder
          onSearch: @config.onSearch
          userAvatar: @config.userAvatar
          userName: @config.userName
          onUserClick: @config.onUserClick
          actions: @config.actions
          sticky: @config.sticky
          variant: @config.variant
          look: @config.look
          onLogoClick: @config.onLogoClick
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: header
        })
    }

    emits {
      @config.onMenuToggle -> external { }
        @description "Menu toggle callback"
        @tier "essential"
      @config.onSearch -> external {
        value : string
      }
        @description "Search callback"
        @tier "essential"
      @config.onUserClick -> external { }
        @description "Callback when user avatar is clicked"
        @tier "essential"
      @config.onLogoClick -> external { }
        @description "Callback when logo/brand is clicked"
        @tier "essential"
    }

    config {
      logo : node
        @label "Logo"
        @description "Logo/Brand content"
        @tier "presentation"
      logoSrc : asset = "https://almadar-kflow-assets.web.app/shared/ui-roguelike-board/default/units/player.png"
        @label "Logo Src"
        @description "Logo image source"
        @tier "presentation"
      brandName : string = KFlow
        @label "Brand Name"
        @description "Brand/App name"
        @tier "presentation"
      navigationItems : [HeaderNavigationItemsItem] = []
        @label "Navigation Items"
        @description "Navigation items (for desktop header variant)"
        @tier "presentation"
      showMenuToggle : boolean = true
        @label "Show Menu Toggle"
        @description "Show menu toggle button"
        @tier "presentation"
      isMenuOpen : boolean = false
        @label "Is Menu Open"
        @description "Is menu open (for toggle icon)"
        @tier "presentation"
      onMenuToggle : event = "MENU_TOGGLE"
        @label "On Menu Toggle"
        @description "Menu toggle callback"
        @tier "presentation"
      showSearch : boolean = false
        @label "Show Search"
        @description "Show search input"
        @tier "presentation"
      searchPlaceholder : string
        @label "Search Placeholder"
        @description "Search placeholder"
        @tier "presentation"
      onSearch : event = "SEARCH"
        @label "On Search"
        @description "Search callback"
        @tier "presentation"
      userAvatar : HeaderUserAvatar
        @label "User Avatar"
        @description "User avatar configuration"
        @tier "presentation"
      userName : string
        @label "User Name"
        @description "User name (display name or email)"
        @tier "presentation"
      onUserClick : event = "USER_CLICK"
        @label "On User Click"
        @description "Callback when user avatar is clicked"
        @tier "presentation"
      actions : node
        @label "Actions"
        @description "Action buttons (right side)"
        @tier "presentation"
      sticky : boolean = true
        @label "Sticky"
        @description "Sticky header"
        @tier "presentation"
      variant : "mobile" | "desktop" = mobile
        @label "Variant"
        @description "Variant - mobile shows menu toggle, desktop shows full nav"
        @tier "presentation"
      look : "hero" | "compact-bar" | "breadcrumb" | "contextual" | "editorial-banner" = "compact-bar"
        @label "Look"
        @description "Layer 2 visual treatment — orthogonal to the structural variant (which currently flips mobile vs desktop)."
        @tier "presentation"
      onLogoClick : event = "LOGO_CLICK"
        @label "On Logo Click"
        @description "Callback when logo/brand is clicked"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator (closed circuit)"
        @tier "presentation"
      error : HeaderError
        @label "Error"
        @description "Error state (closed circuit)"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/header" as HeaderPage -> HeaderRender
}
