app ui-positioned-canvas "1.0.0"
"PositionedCanvas — UI factory (1:1 with the @almadar/ui positioned-canvas pattern)."
orbital PositionedCanvasOrbital {
    type PositionedCanvasLoaded = Event { data : [PositionedCanvasItem] } "PositionedCanvas rows finished loading; payload.data holds the collection"

  entity PositionedCanvasItem [runtime] {
    id : string!
    label : string = "Label"
    x : number = 1
    y : number = 1
    capacity : number = 1
    partySize : number = 1
    serverName : string = "Server Name"
    status : "empty" | "seated" | "ordered" | "awaiting-bill" | "cleaning" = empty
    shape : "round" | "rectangle" | "square" = round
  }

  trait PositionedCanvasRender -> @rebindable PositionedCanvasItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch PositionedCanvasItem { emit: { success: PositionedCanvasLoaded } })
        (render-ui main {
          items: @entity
          width: @config.width
          height: @config.height
          selectedId: @config.selectedId
          editable: @config.editable
          onSelect: @config.onSelect
          onMove: @config.onMove
          selectEvent: @config.selectEvent
          moveEvent: @config.moveEvent
          className: @config.className
          type: positioned-canvas
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          items: @entity
          width: @config.width
          height: @config.height
          selectedId: @config.selectedId
          editable: @config.editable
          onSelect: @config.onSelect
          onMove: @config.onMove
          selectEvent: @config.selectEvent
          moveEvent: @config.moveEvent
          className: @config.className
          type: positioned-canvas
        })
      PositionedCanvasLoaded -> idle
        (render-ui main {
          items: @payload.data
          width: @config.width
          height: @config.height
          selectedId: @config.selectedId
          editable: @config.editable
          onSelect: @config.onSelect
          onMove: @config.onMove
          selectEvent: @config.selectEvent
          moveEvent: @config.moveEvent
          className: @config.className
          type: positioned-canvas
        })
    }

    emits {
      @config.onSelect -> external {
        id : string
      }
        @description "onSelect prop"
        @tier "essential"
      @config.onMove -> external {
        id : string
        x : number
        y : number
      }
        @description "onMove prop"
        @tier "essential"
      PositionedCanvasLoaded
        @description "PositionedCanvas rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      width : number = 800
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number = 600
        @label "Height"
        @description "height prop"
        @tier "presentation"
      selectedId : string
        @label "Selected Id"
        @description "selectedId prop"
        @tier "presentation"
      editable : boolean = false
        @label "Editable"
        @description "editable prop"
        @tier "presentation"
      onSelect : event = "SELECT"
        @label "On Select"
        @description "onSelect prop"
        @tier "presentation"
      onMove : event = "MOVE"
        @label "On Move"
        @description "onMove prop"
        @tier "presentation"
      selectEvent : event = "SELECT"
        @label "Select Event"
        @description "selectEvent prop"
        @tier "presentation"
      moveEvent : event = "MOVE"
        @label "Move Event"
        @description "moveEvent prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/positioned-canvas" as PositionedCanvasPage -> PositionedCanvasRender
}
