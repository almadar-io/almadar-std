app ui-commit-row "1.0.0"
"One version in a history list — a commit row with select and restore. — UI factory (1:1 with the @almadar/ui commit-row pattern)."
;; @capabilities "version history row, commit entry, revision list item, change log entry, restore point, undo history item"
;; @pattern "commit-row"
orbital CommitRowOrbital {
  entity CommitRowItem [runtime] {
    id : string!
    sha : string @intrinsic = ""
  }

  trait CommitRowRender -> @rebindable CommitRowItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.sha @config.sha)
        (render-ui main {
          sha: @entity.sha
          message: @config.message
          author: @config.author
          timestamp: @config.timestamp
          kind: @config.kind
          additions: @config.additions
          deletions: @config.deletions
          selected: @config.selected
          current: @config.current
          selectEvent: @config.selectEvent
          restoreEvent: @config.restoreEvent
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: commit-row
        })
      SELECT -> idle
        (set @entity.sha ?sha)
        (render-ui main {
          sha: @entity.sha
          message: @config.message
          author: @config.author
          timestamp: @config.timestamp
          kind: @config.kind
          additions: @config.additions
          deletions: @config.deletions
          selected: @config.selected
          current: @config.current
          selectEvent: @config.selectEvent
          restoreEvent: @config.restoreEvent
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: commit-row
        })
      RESTORE -> idle
        (set @entity.sha ?sha)
        (render-ui main {
          sha: @entity.sha
          message: @config.message
          author: @config.author
          timestamp: @config.timestamp
          kind: @config.kind
          additions: @config.additions
          deletions: @config.deletions
          selected: @config.selected
          current: @config.current
          selectEvent: @config.selectEvent
          restoreEvent: @config.restoreEvent
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: commit-row
        })
    }

    emits {
      @config.selectEvent -> external {
        sha : string!
      }
        @description "Emitted when the row is picked. Payload: { sha }."
        @tier "essential"
      @config.restoreEvent -> external {
        sha : string!
      }
        @description "Emitted by the Restore button. Payload: { sha }."
        @tier "essential"
    }

    listens {
      SELECT {
        sha : string!
      }
      RESTORE {
        sha : string!
      }
    }

    config {
      sha : string = ""
        @label "Sha"
        @description "Commit id; the first 7 characters are shown, the whole id on hover."
        @tier "presentation"
      message : string = ""
        @label "Message"
        @description "Commit message."
        @tier "presentation"
      author : string
        @label "Author"
        @description "author prop"
        @tier "presentation"
      timestamp : string
        @label "Timestamp"
        @description "Display time (already formatted, e.g. '2 min ago')."
        @tier "presentation"
      kind : "user" | "agent" | "restore" | "undo" | "redo" | "snapshot" | "merge"
        @label "Kind"
        @description "What made this version (a user save, an agent turn, a restore, an undo/redo, a snapshot, a merge of a teammate's work)."
        @tier "presentation"
      additions : number
        @label "Additions"
        @description "additions prop"
        @tier "presentation"
      deletions : number
        @label "Deletions"
        @description "deletions prop"
        @tier "presentation"
      selected : boolean = false
        @label "Selected"
        @description "The row the user picked (shows its detail)."
        @tier "presentation"
      current : boolean = false
        @label "Current"
        @description "The version the app is at now — it cannot be restored to."
        @tier "presentation"
      selectEvent : event = "SELECT"
        @label "Select Event"
        @description "Emitted when the row is picked. Payload: { sha }."
        @tier "presentation"
      restoreEvent : event = "RESTORE"
        @label "Restore Event"
        @description "Emitted by the Restore button. Payload: { sha }."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/commit-row" as CommitRowPage -> CommitRowRender
}
