app ui-stat-display [
  version: "1.0.0",
  description: "StatDisplay — UI factory (1:1 with the @almadar/ui stat-display pattern)."
]
;; @pattern "stat-display"
orbital StatDisplayOrbital {
  type StatDisplayError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity StatDisplayItem [runtime] {
    id : string!
  }

  trait StatDisplayRender -> @rebindable StatDisplayItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          label: @config.label
          value: @config.value
          max: @config.max
          target: @config.target
          trend: @config.trend
          trendPolarity: @config.trendPolarity
          trendFormat: @config.trendFormat
          sparklineData: @config.sparklineData
          clickEvent: @config.clickEvent
          prefix: @config.prefix
          suffix: @config.suffix
          icon: @config.icon
          iconBg: @config.iconBg
          iconColor: @config.iconColor
          format: @config.format
          size: @config.size
          variant: @config.variant
          compact: @config.compact
          look: @config.look
          surface: @config.surface
          className: @config.className
          isLoading: @config.isLoading
          skeleton: @config.skeleton
          error: @config.error
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: stat-display
        })
    }

    config {
      label : string = ""
        @label "Label"
        @description "Display label (e.g., 'Total', 'Remaining')"
        @tier "presentation"
      value : scalar = ""
        @label "Value"
        @description "Primary value (number or formatted string)"
        @tier "presentation"
      max : number
        @label "Max"
        @description "Optional denominator. >0 renders 'value / max'; 0 or omitted hides the divider."
        @tier "presentation"
      target : number
        @label "Target"
        @description "Optional progress target. >0 renders a progress bar at value/target."
        @tier "presentation"
      trend : number
        @label "Trend"
        @description "Signed delta vs previous period. >0 renders ↑ green, <0 renders ↓ red, 0 hides. Polarity reversal via `trendPolarity`."
        @tier "presentation"
      trendPolarity : "higher-is-better" | "lower-is-better" = "higher-is-better"
        @label "Trend Polarity"
        @description "Controls whether `trend > 0` is 'good' (default) or 'bad'. `lower-is-better` inverts the color logic."
        @tier "presentation"
      trendFormat : "absolute" | "percent" = absolute
        @label "Trend Format"
        @description "When `'percent'`, renders trend with a `%` suffix (e.g. `↓ 3.3%`); default is `'absolute'`."
        @tier "presentation"
      sparklineData : [number] = []
        @label "Sparkline Data"
        @description "Optional inline sparkline data appended to the trend row. Length < 2 renders nothing."
        @tier "presentation"
      clickEvent : string
        @label "Click Event"
        @description "Event name emitted as `UI:{clickEvent}` with `{ metricLabel }` when the card is clicked."
        @tier "presentation"
      prefix : string
        @label "Prefix"
        @description "Prefix prepended to the formatted value (e.g. '≈ ')."
        @tier "presentation"
      suffix : string
        @label "Suffix"
        @description "Suffix appended to the formatted value (e.g. ' /mo', ' ms')."
        @tier "presentation"
      icon : icon
        @label "Icon"
        @description "Lucide icon name or component"
        @tier "presentation"
      iconBg : string = "bg-muted"
        @label "Icon Bg"
        @description "Icon background color class"
        @tier "presentation"
      iconColor : string = "text-foreground"
        @label "Icon Color"
        @description "Icon color class"
        @tier "presentation"
      format : string
        @label "Format"
        @description "Display format: 'number', 'currency', 'percent'"
        @tier "presentation"
      size : "sm" | "md" | "lg" = md
        @label "Size"
        @description "Size variant"
        @tier "presentation"
      variant : "default" | "primary" | "success" | "warning" | "error" | "info" = default
        @label "Variant"
        @description "Color variant"
        @tier "presentation"
      compact : boolean = false
        @label "Compact"
        @description "Compact mode (inline, no card wrapper)"
        @tier "presentation"
      look : "elevated" | "flat" | "progress-backed" | "gauge" | "sparkline" = elevated
        @label "Look"
        @description "Layer 2 visual treatment."
        @tier "presentation"
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton drawn while loading, and the shape an empty slot shows while this element's server render is in flight (`none` opts out)."
        @tier "presentation"
      error : StatDisplayError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/stat-display" as StatDisplayPage -> StatDisplayRender
}
