app ui-swipeable-row "1.0.0"
"SwipeableRow — UI factory (1:1 with the @almadar/ui swipeable-row pattern)."
;; @pattern "swipeable-row"
orbital SwipeableRowOrbital {
    type SwipeableRowLoaded = Event { data : SwipeableRowItem } "SwipeableRow row finished loading; payload.data holds the single row"
  type SwipeableRowLeftActionsItem = {
    label : string!
    icon : icon
    variant : "primary" | "secondary" | "danger" | "ghost"
    event : event!
    eventPayload : @payload event
    when : SExpr
    roles : [string]
  }
  type SwipeableRowRightActionsItem = {
    label : string!
    icon : icon
    variant : "primary" | "secondary" | "danger" | "ghost"
    event : event!
    eventPayload : @payload event
    when : SExpr
    roles : [string]
  }

  entity SwipeableRowItem [runtime] {
    id : string!
  }

  trait SwipeableRowRender -> @rebindable SwipeableRowItem [interaction, instance] {
    initial: resolving

    state resolving {
      INIT -> idle when (and @config.selfFetch (!= (str/default ?id "") ""))
        (fetch SwipeableRowItem { id: ?id, emit: { success: SwipeableRowLoaded } })
        (render-ui main {
          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          threshold: @config.threshold
          children: @config.children
          itemData: @entity
          className: @config.className
          type: swipeable-row
        })
      INIT -> idle when (not (and @config.selfFetch (!= (str/default ?id "") "")))
        (render-ui main {
          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          threshold: @config.threshold
          children: @config.children
          itemData: @entity
          className: @config.className
          type: swipeable-row
        })
    }

    state idle {
      INIT -> idle
        (render-ui main {
          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          threshold: @config.threshold
          children: @config.children
          itemData: @entity
          className: @config.className
          type: swipeable-row
        })
      SwipeableRowLoaded -> idle
        (render-ui main {
          leftActions: (array/filter @config.leftActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          rightActions: (array/filter @config.rightActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          threshold: @config.threshold
          children: @config.children
          itemData: @payload.data
          className: @config.className
          type: swipeable-row
        })
    }

    emits {
      SwipeableRowLoaded
        @description "SwipeableRow row finished loading; payload.data holds the single row."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    listens {
      INIT {
        id : string
      }
        @description "Mount payload; a host that routes to this panel by id (a :id page param) passes it here."
        @tier "internal"
    }

    config {
      leftActions : [SwipeableRowLeftActionsItem] = []
        @label "Left Actions"
        @description "leftActions prop"
        @tier "presentation"
      rightActions : [SwipeableRowRightActionsItem] = []
        @label "Right Actions"
        @description "rightActions prop"
        @tier "presentation"
      threshold : number = 80
        @label "Threshold"
        @description "threshold prop"
        @tier "presentation"
      children : node
        @label "Children"
        @description "children prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own row on mount?"
        @description "true (default) = a mount that carries an id loads that one row (never the collection); a create-mode mount skips the load. false = a composing atom owns the load."
        @tier "internal"
    }
  }

  page "/swipeable-row" as SwipeableRowPage -> SwipeableRowRender
}
