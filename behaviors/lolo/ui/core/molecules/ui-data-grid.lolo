app ui-data-grid "1.0.0"
"DataGrid — structured records grid rendering rows over configurable columns, with sort, select, and drag-reorder. — UI factory (1:1 with the @almadar/ui data-grid pattern)."
;; @capabilities "admin table, records grid, user list, CRUD list, manage-records view, spreadsheet-style data grid, sortable columns"
;; @pattern "data-grid"
orbital DataGridOrbital {
    type DataGridLoaded = Event { data : [DataGridItem] } "DataGrid rows finished loading; payload.data holds the collection"
  type DataGridEmptyAction = {
    label : string!
    event : event
  }
  type DataGridFieldsItem = {
    name : string!
    label : string
    icon : icon
    variant : "h3" | "h4" | "body" | "caption" | "badge" | "small" | "progress"
    format : "date" | "datetime" | "currency" | "number" | "boolean" | "percent"
    colorMap : Map string DataGridFieldsItemColorMapValue
    labels : Map string string
  }
  type DataGridFieldsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type DataGridColumnsItem = {
    name : string!
    label : string
    icon : icon
    variant : "h3" | "h4" | "body" | "caption" | "badge" | "small" | "progress"
    format : "date" | "datetime" | "currency" | "number" | "boolean" | "percent"
    colorMap : Map string DataGridColumnsItemColorMapValue
    labels : Map string string
  }
  type DataGridColumnsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type DataGridItemActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    icon : icon
    variant : "primary" | "secondary" | "ghost" | "danger"
    when : SExpr
    payload : SExpr
    roles : [string]
  }
  type DataGridError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type DataGridRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }

  entity DataGridItem [runtime] {
    id : string!
  }

  trait DataGridRender -> @rebindable DataGridItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch DataGridItem { emit: { success: DataGridLoaded } })
        (render-ui main {
          dragGroup: @config.dragGroup
          accepts: @config.accepts
          sortable: @config.sortable
          dropEvent: @config.dropEvent
          reorderEvent: @config.reorderEvent
          positionEvent: @config.positionEvent
          dndItemIdField: @config.dndItemIdField
          dndRoot: @config.dndRoot
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          entity: @entity
          fields: @config.fields
          columns: @config.columns
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          itemClickEvent: @config.itemClickEvent
          maxInlineActions: @config.maxInlineActions
          scrollX: @config.scrollX
          cols: @config.cols
          gap: @config.gap
          minCardWidth: @config.minCardWidth
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          imageField: @config.imageField
          selectable: @config.selectable
          selectionEvent: @config.selectionEvent
          infiniteScroll: @config.infiniteScroll
          loadMoreEvent: @config.loadMoreEvent
          hasMore: @config.hasMore
          pageSize: @config.pageSize
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: data-grid
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          dragGroup: @config.dragGroup
          accepts: @config.accepts
          sortable: @config.sortable
          dropEvent: @config.dropEvent
          reorderEvent: @config.reorderEvent
          positionEvent: @config.positionEvent
          dndItemIdField: @config.dndItemIdField
          dndRoot: @config.dndRoot
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          entity: @entity
          fields: @config.fields
          columns: @config.columns
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          itemClickEvent: @config.itemClickEvent
          maxInlineActions: @config.maxInlineActions
          scrollX: @config.scrollX
          cols: @config.cols
          gap: @config.gap
          minCardWidth: @config.minCardWidth
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          imageField: @config.imageField
          selectable: @config.selectable
          selectionEvent: @config.selectionEvent
          infiniteScroll: @config.infiniteScroll
          loadMoreEvent: @config.loadMoreEvent
          hasMore: @config.hasMore
          pageSize: @config.pageSize
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: data-grid
        })
      DataGridLoaded -> idle
        (render-ui main {
          dragGroup: @config.dragGroup
          accepts: @config.accepts
          sortable: @config.sortable
          dropEvent: @config.dropEvent
          reorderEvent: @config.reorderEvent
          positionEvent: @config.positionEvent
          dndItemIdField: @config.dndItemIdField
          dndRoot: @config.dndRoot
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          entity: @payload.data
          fields: @config.fields
          columns: @config.columns
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          itemClickEvent: @config.itemClickEvent
          maxInlineActions: @config.maxInlineActions
          scrollX: @config.scrollX
          cols: @config.cols
          gap: @config.gap
          minCardWidth: @config.minCardWidth
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          imageField: @config.imageField
          selectable: @config.selectable
          selectionEvent: @config.selectionEvent
          infiniteScroll: @config.infiniteScroll
          loadMoreEvent: @config.loadMoreEvent
          hasMore: @config.hasMore
          pageSize: @config.pageSize
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: data-grid
        })
    }

    emits {
      @config.itemClickEvent -> external {
        id : string!
        row : @entity!
      }
        @description "When set, clicking a card emits UI:{itemClickEvent} with { id, row }. Omit = cards are not clickable."
        @tier "essential"
      @config.selectionEvent -> external {
        selectedIds : [string]!
      }
        @description "Selection change event name (emits UI:{selectionEvent} with { selectedIds: string[] })"
        @tier "essential"
      @config.loadMoreEvent -> external { }
        @description "Event emitted when more items needed: UI:{loadMoreEvent}"
        @tier "essential"
      VIEW -> external {
        id : string!
        row : @entity!
      }
        @description "User opened a record from the list."
        @tier "essential"
      DataGridLoaded
        @description "DataGrid rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      dragGroup : string
        @label "Drag Group"
        @description "When set, items in this container are draggable and announce this group as their source"
        @tier "presentation"
      accepts : string
        @label "Accepts"
        @description "When set, the container accepts drops whose dragGroup matches this value (or '*' for any group)"
        @tier "presentation"
      sortable : boolean
        @label "Sortable"
        @description "Enable in-container reorder; items can be dragged to new positions among siblings"
        @tier "presentation"
      dropEvent : string
        @label "Drop Event"
        @description "Bus event fired on cross-container drop. Payload: { id, sourceGroup, targetGroup, newIndex }"
        @tier "presentation"
      reorderEvent : string
        @label "Reorder Event"
        @description "Bus event fired on in-container reorder. Payload: { id, oldIndex, newIndex }"
        @tier "presentation"
      positionEvent : string
        @label "Position Event"
        @description "Bus event fired N times per drop (one per item in affected zones) so the trait can persist new positions for the WHOLE zone, not just the moved item. Payload: { id, position }"
        @tier "presentation"
      dndItemIdField : string
        @label "Dnd Item Id Field"
        @description "Row field used as the @dnd-kit draggable id (default 'id')"
        @tier "presentation"
      dndRoot : boolean
        @label "Dnd Root"
        @description "Mark this container as the DnD root for its subtree — descendant zones share one DndContext (cross-container drag). Use on an outer container whose own items are not draggable."
        @tier "presentation"
      emptyIcon : icon
        @label "Empty Icon"
        @description "Domain icon for the empty state."
        @tier "presentation"
      emptyTitle : string
        @label "Empty Title"
        @description "Specific title ('No orders yet')."
        @tier "presentation"
      emptyDescription : string
        @label "Empty Description"
        @description "What will appear here once rows exist."
        @tier "presentation"
      emptyAction : DataGridEmptyAction
        @label "Empty Action"
        @description "Create-the-first-item action."
        @tier "presentation"
      fields : [DataGridFieldsItem] = []
        @label "Fields"
        @description "Field definitions for rendering each card. The pattern contract in `@almadar/core/patterns` documents `columns` as the wire-format alias the compiler emits — both names resolve to the same shape here. Pass either."
        @tier "presentation"
      columns : [DataGridColumnsItem] = []
        @label "Columns"
        @description "Alias for `fields` — the compiler emits `columns` for field defs."
        @tier "presentation"
      itemActions : [DataGridItemActionsItem] = []
        @label "Item Actions"
        @description "Per-item action buttons"
        @tier "presentation"
      itemClickEvent : event = "ITEM_CLICK"
        @label "Item Click Event"
        @description "When set, clicking a card emits UI:{itemClickEvent} with { id, row }. Omit = cards are not clickable."
        @tier "presentation"
      maxInlineActions : number
        @label "Max Inline Actions"
        @description "Max inline primary action buttons before the rest collapse into a '⋯' overflow menu. Omit = all inline."
        @tier "presentation"
      scrollX : boolean = false
        @label "Scroll X"
        @description "Lay items in a single horizontally-scrolling row (kanban columns) sized to `minCardWidth` instead of a wrapping grid."
        @tier "presentation"
      cols : number
        @label "Cols"
        @description "Number of columns (uses auto-fit if omitted)"
        @tier "presentation"
      gap : "none" | "sm" | "md" | "lg" | "xl" = md
        @label "Gap"
        @description "Gap between cards"
        @tier "presentation"
      minCardWidth : number = 280
        @label "Min Card Width"
        @description "Minimum card width in pixels (used when cols is not set, default 280)"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : DataGridError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      imageField : string
        @label "Image Field"
        @description "Entity field name containing an image URL for card thumbnails"
        @tier "presentation"
      selectable : boolean = false
        @label "Selectable"
        @description "Enable multi-select with checkboxes"
        @tier "presentation"
      selectionEvent : event = "SELECTION"
        @label "Selection Event"
        @description "Selection change event name (emits UI:{selectionEvent} with { selectedIds: string[] })"
        @tier "presentation"
      infiniteScroll : boolean
        @label "Infinite Scroll"
        @description "Enable infinite scroll loading"
        @tier "presentation"
      loadMoreEvent : event = "LOAD_MORE"
        @label "Load More Event"
        @description "Event emitted when more items needed: UI:{loadMoreEvent}"
        @tier "presentation"
      hasMore : boolean
        @label "Has More"
        @description "Whether more items are available for infinite scroll"
        @tier "presentation"
      pageSize : number = 0
        @label "Page Size"
        @description "Max items to show before 'Show More' button. Defaults to 0 (disabled)."
        @tier "presentation"
      look : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Look"
        @description "Layer 2 visual treatment — mirrors the `entity-table` look enum so data-grid / data-list / entity-table share one knob name from authors."
        @tier "presentation"
      relationsData : Map string [DataGridRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names for a field whose type is relation. Same contract DetailPanel takes."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/data-grid" as DataGridPage -> DataGridRender
}
