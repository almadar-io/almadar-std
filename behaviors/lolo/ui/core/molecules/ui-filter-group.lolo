app ui-filter-group "1.0.0"
"FilterGroup — a panel of filter controls that narrows a collection by field values. — UI factory (1:1 with the @almadar/ui filter-group pattern)."
;; @capabilities "search refinement panel, facet filters, admin list filters, records filter sidebar, filter chips panel"
;; @pattern "filter-group"
orbital FilterGroupOrbital {
  type FilterGroupFiltersItem = {
    field : string!
    label : string!
    filterType : "text" | "select" | "toggle" | "checkbox" | "date" | "daterange" | "date-range" | "numberrange" | "number-range"
    type : "text" | "select" | "toggle" | "checkbox" | "date" | "daterange" | "date-range" | "numberrange" | "number-range"
    options : [string]
    min : number
    max : number
    step : number
  }

  entity FilterGroupItem [runtime] {
    id : string!
    query : string @intrinsic
  }

  trait FilterGroupRender -> @rebindable FilterGroupItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (fetch FilterGroupItem {})
        (set @entity.query @config.query)
        (render-ui main {
          entity: FilterGroupItem
          filters: @config.filters
          onFilterChange: @config.onFilterChange
          onClearAll: @config.onClearAll
          className: @config.className
          variant: @config.variant
          showIcon: @config.showIcon
          query: @entity.query
          isLoading: @config.isLoading
          look: @config.look
          event: @config.event
          clearEvent: @config.clearEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: filter-group
        })
      EVENT -> idle
        (set @entity.query ?query)
        (render-ui main {
          entity: FilterGroupItem
          filters: @config.filters
          onFilterChange: @config.onFilterChange
          onClearAll: @config.onClearAll
          className: @config.className
          variant: @config.variant
          showIcon: @config.showIcon
          query: @entity.query
          isLoading: @config.isLoading
          look: @config.look
          event: @config.event
          clearEvent: @config.clearEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: filter-group
        })
      CLEAR -> idle
        (set @entity.query ?query)
        (render-ui main {
          entity: FilterGroupItem
          filters: @config.filters
          onFilterChange: @config.onFilterChange
          onClearAll: @config.onClearAll
          className: @config.className
          variant: @config.variant
          showIcon: @config.showIcon
          query: @entity.query
          isLoading: @config.isLoading
          look: @config.look
          event: @config.event
          clearEvent: @config.clearEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: filter-group
        })
    }

    emits {
      @config.onFilterChange -> external {
        field : string
        value : string
      }
        @description "Callback when a filter changes - for EntityStore integration"
        @tier "essential"
      @config.onClearAll -> external { }
        @description "Callback to clear all filters"
        @tier "essential"
      @config.event -> external {
        entity : string!
        field : string!
        value : string!
        query : string
      }
        @description "Declarative filter event — emits UI:{event} via eventBus on filter change (alongside canonical UI:FILTER)"
        @tier "essential"
      @config.clearEvent -> external {
        entity : string!
        query : string
      }
        @description "Declarative clear event — emits UI:{clearEvent} via eventBus on clear-all (alongside canonical UI:CLEAR_FILTERS)"
        @tier "essential"
    }

    listens {
      EVENT {
        entity : string!
        field : string!
        value : string!
        query : string
      }
      CLEAR {
        entity : string!
        query : string
      }
    }

    config {
      filters : [FilterGroupFiltersItem] = [{ field: "Field", label: "Label", filterType: text, type: text, options: ["Item", "Item 2"], min: 1, max: 1, step: 1 }, { field: "Field 2", label: "Label 2", filterType: select, type: select, options: ["Item", "Item 2"], min: 2, max: 2, step: 2 }]
        @label "Filters"
        @description "Filter definitions from schema"
        @tier "presentation"
      onFilterChange : event = "FILTER_CHANGE"
        @label "On Filter Change"
        @description "Callback when a filter changes - for EntityStore integration"
        @tier "presentation"
      onClearAll : event = "CLEAR_ALL"
        @label "On Clear All"
        @description "Callback to clear all filters"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      variant : "default" | "compact" | "pills" | "vertical" = default
        @label "Variant"
        @description "Variant style"
        @tier "presentation"
      showIcon : boolean = true
        @label "Show Icon"
        @description "Show filter icon"
        @tier "presentation"
      query : string
        @label "Query"
        @description "Query singleton binding for state management. When provided, syncs filter state with the query singleton. Example: '@TaskQuery'"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      look : "toolbar" | "chips" | "pills" | "popover-trigger" | "inline-column-header" = toolbar
        @label "Look"
        @description "Layer 2 visual treatment — orthogonal to the semantic variant."
        @tier "presentation"
      event : event = "EVENT"
        @label "Event"
        @description "Declarative filter event — emits UI:{event} via eventBus on filter change (alongside canonical UI:FILTER)"
        @tier "presentation"
      clearEvent : event = "CLEAR"
        @label "Clear Event"
        @description "Declarative clear event — emits UI:{clearEvent} via eventBus on clear-all (alongside canonical UI:CLEAR_FILTERS)"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/filter-group" as FilterGroupPage -> FilterGroupRender
}
