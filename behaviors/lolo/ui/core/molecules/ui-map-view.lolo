app ui-map-view "1.0.0"
"MapView — UI factory (1:1 with the @almadar/ui map-view pattern)."
;; @pattern "map-view"
orbital MapViewOrbital {
  type MapViewMarkersItem = {
    id : string!
    lat : number!
    lng : number!
    label : string
    category : string
  }
  type MapViewRoutesItem = {
    id : string!
    waypoints : [MapViewRoutesItemWaypointsItem]!
    color : string
    weight : number
    opacity : number
    dashArray : string
    label : string
  }
  type MapViewRoutesItemWaypointsItem = {
    lat : number!
    lng : number!
  }
  type MapViewMARKERCLICKMarker = {
    id : string!
    lat : number!
    lng : number!
    label : string
    category : string
  }

  entity MapViewItem [runtime] {
    id : string!
  }

  trait MapViewRender -> @rebindable MapViewItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          surface: @config.surface
          markers: @config.markers
          routes: @config.routes
          centerLat: @config.centerLat
          centerLng: @config.centerLng
          zoom: @config.zoom
          height: @config.height
          onMarkerClick: @config.onMarkerClick
          onMapClick: @config.onMapClick
          mapClickEvent: @config.mapClickEvent
          markerClickEvent: @config.markerClickEvent
          showClickedPin: @config.showClickedPin
          className: @config.className
          showAttribution: @config.showAttribution
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: map-view
        })
    }

    emits {
      @config.onMarkerClick -> external {
        marker : MapViewMARKERCLICKMarker
        id : string!
        lat : number!
        lng : number!
        label : string
        category : string
      }
        @description "Callback when a marker is clicked (programmatic use)"
        @tier "essential"
      @config.onMapClick -> external {
        lat : number
        lng : number
        latitude : number!
        longitude : number!
      }
        @description "Callback when the map is clicked (programmatic use)"
        @tier "essential"
    }

    config {
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      markers : [MapViewMarkersItem] = []
        @label "Markers"
        @description "Array of markers to display"
        @tier "presentation"
      routes : [MapViewRoutesItem] = []
        @label "Routes"
        @description "Routes (polylines with optional popups) drawn over the tile layer"
        @tier "presentation"
      centerLat : number = 51.505
        @label "Center Lat"
        @description "Map center latitude"
        @tier "presentation"
      centerLng : number = -0.09
        @label "Center Lng"
        @description "Map center longitude"
        @tier "presentation"
      zoom : number = 13
        @label "Zoom"
        @description "Zoom level (1-18, default 13)"
        @tier "presentation"
      height : string = "400px"
        @label "Height"
        @description "Height of the map container (default '400px')"
        @tier "presentation"
      onMarkerClick : event = "MARKER_CLICK"
        @label "On Marker Click"
        @description "Callback when a marker is clicked (programmatic use)"
        @tier "presentation"
      onMapClick : event = "MAP_CLICK"
        @label "On Map Click"
        @description "Callback when the map is clicked (programmatic use)"
        @tier "presentation"
      mapClickEvent : event = "MAP_CLICK"
        @label "Map Click Event"
        @description "Event name dispatched via event bus when the map is clicked. Payload: { latitude, longitude }"
        @tier "presentation"
      markerClickEvent : event = "MARKER_CLICK"
        @label "Marker Click Event"
        @description "Event name dispatched via event bus when a marker is clicked. Payload: full MapMarkerData spread."
        @tier "presentation"
      showClickedPin : boolean = false
        @label "Show Clicked Pin"
        @description "Whether to show a pin at the clicked location"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      showAttribution : boolean = true
        @label "Show Attribution"
        @description "Show attribution (default true)"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/map-view" as MapViewPage -> MapViewRender
}
