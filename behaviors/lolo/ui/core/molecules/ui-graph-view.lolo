app ui-graph-view "1.0.0"
"GraphView — UI factory (1:1 with the @almadar/ui graph-view pattern)."
;; @pattern "graph-view"
orbital GraphViewOrbital {
  type GraphViewNodesItem = {
    id : string!
    label : string
    color : string
    size : number
    group : string
  }
  type GraphViewEdgesItem = {
    source : string!
    target : string!
    color : string
    label : string
  }
  type GraphViewNODECLICKNode = {
    id : string!
    label : string
    color : string
    size : number
    group : string
  }
  type GraphViewNODEHOVERNode = {
    id : string!
    label : string
    color : string
    size : number
    group : string
  }

  entity GraphViewItem [runtime] {
    id : string!
  }

  trait GraphViewRender -> @rebindable GraphViewItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          nodes: @config.nodes
          edges: @config.edges
          onNodeClick: @config.onNodeClick
          onNodeHover: @config.onNodeHover
          width: @config.width
          height: @config.height
          className: @config.className
          showLabels: @config.showLabels
          zoomToFit: @config.zoomToFit
          layout: @config.layout
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: graph-view
        })
    }

    emits {
      @config.onNodeClick -> external {
        node : GraphViewNODECLICKNode
      }
        @description "Callback when a node is clicked"
        @tier "essential"
      @config.onNodeHover -> external {
        node : GraphViewNODEHOVERNode
      }
        @description "Callback when a node is hovered (null on leave)"
        @tier "essential"
    }

    config {
      nodes : [GraphViewNodesItem] = [{ id: "Id", label: "Label", color: "Color", size: 1, group: "Group" }, { id: "Id 2", label: "Label 2", color: "Color 2", size: 2, group: "Group 2" }]
        @label "Nodes"
        @description "Graph nodes"
        @tier "presentation"
      edges : [GraphViewEdgesItem] = [{ source: "Source", target: "Target", color: "Color", label: "Label" }, { source: "Source 2", target: "Target 2", color: "Color 2", label: "Label 2" }]
        @label "Edges"
        @description "Graph edges"
        @tier "presentation"
      onNodeClick : event = "NODE_CLICK"
        @label "On Node Click"
        @description "Callback when a node is clicked"
        @tier "presentation"
      onNodeHover : event = "NODE_HOVER"
        @label "On Node Hover"
        @description "Callback when a node is hovered (null on leave)"
        @tier "presentation"
      width : number
        @label "Width"
        @description "Width in pixels"
        @tier "presentation"
      height : number
        @label "Height"
        @description "Height in pixels"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      showLabels : boolean = true
        @label "Show Labels"
        @description "Show node labels (default true)"
        @tier "presentation"
      zoomToFit : boolean = true
        @label "Zoom To Fit"
        @description "Auto zoom-to-fit after layout settles (default true)"
        @tier "presentation"
      layout : "force" | "flow" | "tree" | "radial" = force
        @label "Layout"
        @description "Layout mode. force = physics simulation (default); flow = layered left-to-right process flow; tree = top-down hierarchy tiers from the roots; radial = concentric rings by depth (a pure cycle renders as a single ring). Non-force layouts are deterministic."
        @synonyms "layout mode, flow layout, tree layout, radial layout, hierarchy layout"
        @tier "domain"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/graph-view" as GraphViewPage -> GraphViewRender
}
