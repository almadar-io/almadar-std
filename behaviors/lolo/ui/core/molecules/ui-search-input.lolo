app ui-search-input "1.0.0"
"SearchInput — UI factory (1:1 with the @almadar/ui search-input pattern)."
;; @pattern "search-input"
orbital SearchInputOrbital {
  entity SearchInputItem [runtime] {
    id : string!
    value : string @intrinsic
  }

  trait SearchInputRender -> @rebindable SearchInputItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (fetch SearchInputItem {})
        (set @entity.value @config.value)
        (render-ui main {
          value: @entity.value
          onSearch: @config.onSearch
          debounceMs: @config.debounceMs
          isLoading: @config.isLoading
          placeholder: @config.placeholder
          clearable: @config.clearable
          className: @config.className
          event: @config.event
          entity: SearchInputItem
          query: @config.query
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: search-input
        })
      SEARCH -> idle
        (set @entity.value ?value)
        (render-ui main {
          value: @entity.value
          onSearch: @config.onSearch
          debounceMs: @config.debounceMs
          isLoading: @config.isLoading
          placeholder: @config.placeholder
          clearable: @config.clearable
          className: @config.className
          event: @config.event
          entity: SearchInputItem
          query: @config.query
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: search-input
        })
    }

    emits {
      @config.onSearch -> external {
        value : string
      }
        @description "Callback when search value changes"
        @tier "essential"
      @config.event -> external {
        searchTerm : string!
        entity : string
      }
        @description "Declarative search event — emits UI:{event} via eventBus on query submit (alongside canonical UI:SEARCH)"
        @tier "essential"
    }

    listens {
      SEARCH {
        value : string
      }
    }

    config {
      value : string
        @label "Value"
        @description "Search value (controlled mode)"
        @tier "presentation"
      onSearch : event = "SEARCH"
        @label "On Search"
        @description "Callback when search value changes"
        @tier "presentation"
      debounceMs : number = 300
        @label "Debounce Ms"
        @description "Debounce delay in milliseconds"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Show loading state"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Placeholder text (the translated 'Search' when omitted)"
        @tier "presentation"
      clearable : boolean = true
        @label "Clearable"
        @description "Show clear button"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      event : event = "EVENT"
        @label "Event"
        @description "Declarative search event — emits UI:{event} via eventBus on query submit (alongside canonical UI:SEARCH)"
        @tier "presentation"
      query : string
        @label "Query"
        @description "Query singleton binding for state management. When provided, syncs search state with the query singleton. Example: '@TaskQuery'"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/search-input" as SearchInputPage -> SearchInputRender
}
