app ui-modal "1.0.0"
"Modal — UI factory (1:1 with the @almadar/ui modal pattern)."
;; @pattern "modal"
orbital ModalOrbital {
  entity ModalItem [runtime] {
    id : string!
  }

  trait ModalRender -> @rebindable ModalItem [interaction, instance] {
    initial: closed

    state closed {
      INIT -> closed
        (render-ui main {
          label: "Open Modal"
          action: OPEN
          type: button
        })
      OPEN -> open
        (render-ui modal {
          isOpen: @config.isOpen
          onClose: @config.onClose
          onExited: @config.onExited
          title: @config.title
          children: @config.children
          footer: @config.footer
          size: @config.size
          showCloseButton: @config.showCloseButton
          closeOnOverlayClick: @config.closeOnOverlayClick
          closeOnEscape: @config.closeOnEscape
          className: @config.className
          closeEvent: @config.closeEvent
          swipeDownToClose: @config.swipeDownToClose
          look: @config.look
          contained: @config.contained
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: modal
        })
    }

    state open {
      CLOSE -> closed
        (render-ui modal null)
        (render-ui main {
          label: "Open Modal"
          action: OPEN
          type: button
        })
    }

    emits {
      @config.onClose -> external { }
        @description "Callback when modal should close (injected by slot wrapper)"
        @tier "essential"
      @config.onExited -> external { }
        @description "Fires after the exit animation completes (the modal is about to unmount)."
        @tier "essential"
      OPEN -> external {
        id : string
      }
        @description "Open the Modal."
        @tier "essential"
    }

    config {
      isOpen : boolean = true
        @label "Is Open"
        @description "Whether the modal is open (defaults to true when rendered by slot wrapper)"
        @tier "presentation"
      onClose : event = "CLOSE"
        @label "On Close"
        @description "Callback when modal should close (injected by slot wrapper)"
        @tier "presentation"
      onExited : event = "EXITED"
        @label "On Exited"
        @description "Fires after the exit animation completes (the modal is about to unmount)."
        @tier "presentation"
      title : string
        @label "Title"
        @description "title prop"
        @tier "presentation"
      children : node
        @label "Children"
        @description "Modal content (can be empty if using slot content)"
        @tier "presentation"
      footer : node
        @label "Footer"
        @description "footer prop"
        @tier "presentation"
      size : "sm" | "md" | "lg" | "xl" | "full" = md
        @label "Size"
        @description "size prop"
        @tier "presentation"
      showCloseButton : boolean = true
        @label "Show Close Button"
        @description "showCloseButton prop"
        @tier "presentation"
      closeOnOverlayClick : boolean = true
        @label "Close On Overlay Click"
        @description "closeOnOverlayClick prop"
        @tier "presentation"
      closeOnEscape : boolean = true
        @label "Close On Escape"
        @description "closeOnEscape prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      closeEvent : event = "CLOSE"
        @label "Close Event"
        @description "Declarative close event — emits UI:{closeEvent} via eventBus when modal should close"
        @tier "presentation"
      swipeDownToClose : boolean = true
        @label "Swipe Down To Close"
        @description "Enable swipe-down-to-close on mobile bottom sheet (default: true)"
        @tier "presentation"
      look : "centered-card" | "top-sheet" | "side-drawer" | "full-screen" = "centered-card"
        @label "Look"
        @description "Layer 2 visual treatment — orthogonal to the semantic variant."
        @tier "presentation"
      contained : boolean = false
        @label "Contained"
        @description "Render inside the nearest positioned ancestor (a preview frame) instead of portaling over the whole window; page scroll is left alone."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/modal" as ModalPage -> ModalRender
}
