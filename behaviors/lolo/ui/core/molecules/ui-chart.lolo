app ui-chart "1.0.0"
"Chart — UI factory (1:1 with the @almadar/ui chart pattern)."
;; @pattern "chart"
orbital ChartOrbital {
  type ChartSeriesItem = {
    name : string!
    data : [ChartSeriesItemDataItem]!
    color : string
    dashed : boolean
  }
  type ChartSeriesItemDataItem = {
    label : string!
    value : number!
    color : string
  }
  type ChartDataItem = {
    label : string!
    value : number!
    color : string
  }
  type ChartScatterDataItem = {
    x : number!
    y : number!
    label : string
    size : number
    color : string
  }
  type ChartActionsItem = {
    label : string!
    event : event
    navigatesTo : string
    variant : "primary" | "secondary" | "ghost"
    roles : [string]
  }
  type ChartError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity ChartItem [runtime] {
    id : string!
  }

  trait ChartRender -> @rebindable ChartItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          title: @config.title
          subtitle: @config.subtitle
          chartType: @config.chartType
          look: @config.look
          series: @config.series
          data: @config.data
          scatterData: @config.scatterData
          height: @config.height
          showLegend: @config.showLegend
          showValues: @config.showValues
          stack: @config.stack
          timeAxis: @config.timeAxis
          period: @config.period
          drillEvent: @config.drillEvent
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          isLoading: @config.isLoading
          error: @config.error
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: chart
        })
    }

    config {
      title : string
        @label "Title"
        @description "Chart title"
        @tier "presentation"
      subtitle : string
        @label "Subtitle"
        @description "Chart subtitle / description"
        @tier "presentation"
      chartType : "bar" | "line" | "pie" | "area" | "donut" | "scatter" | "histogram"
        @label "Chart Type"
        @description "Chart type (legacy alias for `look`)."
        @synonyms "chart style, graph type, bar chart, line chart, pie chart, area chart, donut chart, scatter plot, histogram"
        @tier "domain"
      look : "bar-vertical" | "bar-horizontal" | "line" | "area" | "pie" | "donut" | "scatter" | "histogram"
        @label "Look"
        @description "Layer 2 visual treatment — drives the chart sub-renderer (bar / line / pie / etc.)."
        @synonyms "chart style, render style, visual treatment"
        @tier "presentation"
      series : [ChartSeriesItem] = []
        @label "Series"
        @description "Multi-series data"
        @tier "presentation"
      data : [ChartDataItem] = []
        @label "Data"
        @description "Simple single-series shorthand (bar/line/pie/area/donut/histogram)"
        @tier "presentation"
      scatterData : [ChartScatterDataItem] = []
        @label "Scatter Data"
        @description "Raw {x,y} points for scatter"
        @tier "presentation"
      height : number = 200
        @label "Height"
        @description "Chart height in px"
        @tier "presentation"
      showLegend : boolean = true
        @label "Show Legend"
        @description "Show legend"
        @tier "presentation"
      showValues : boolean = false
        @label "Show Values"
        @description "Show values on chart"
        @tier "presentation"
      stack : "none" | "stack" | "normalize" = none
        @label "Stack"
        @description "Stack mode for bar / area"
        @tier "presentation"
      timeAxis : boolean = false
        @label "Time Axis"
        @description "Format X-axis labels as time (ISO date in → 'Mar 2026'-style label out)"
        @tier "presentation"
      period : "day" | "week" | "month" | "quarter" | "year"
        @label "Period"
        @description "Bucket granularity of a time axis — labels read 'Oct 2', 'Week of Sep 28', 'Oct 2026', 'Q4 2026' or '2026'"
        @tier "presentation"
      drillEvent : string
        @label "Drill Event"
        @description "Event name emitted as `UI:{drillEvent}` with `{ label, value, seriesLabel? }` on data-point click"
        @tier "presentation"
      actions : [ChartActionsItem] = []
        @label "Actions"
        @description "Top-level chart actions (export, refresh, etc.)"
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state"
        @tier "presentation"
      error : ChartError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/chart" as ChartPage -> ChartRender
}
