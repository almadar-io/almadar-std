app ui-wizard-container "1.0.0"
"WizardContainer — UI factory (1:1 with the @almadar/ui wizard-container pattern)."
;; @pattern "wizard-container"
orbital WizardContainerOrbital {
  type WizardContainerStepsItem = {
    id : string
    tabId : string
    title : string
    name : string
    description : string
    content : node
    optional : boolean
    sections : [WizardContainerStepsItemSectionsItem]
    globalVariablesRequired : [string]
    globalVariablesSet : [string]
    localVariables : [string]
    entityMapping : WizardContainerStepsItemEntityMapping
    validationRules : [WizardContainerStepsItemValidationRulesItem]
    lawReferences : [WizardContainerStepsItemLawReferencesItem]
    phase : string
    contextMenu : [string]
  }
  type WizardContainerStepsItemSectionsItem = {
    id : string!
    title : string
    description : string
    fields : [WizardContainerStepsItemSectionsItemFieldsItem]
    subsections : [WizardContainerStepsItemSectionsItem]
    condition : SExpr
    repeatable : boolean
    minItems : number
    addButtonLabel : string
    hiddenCalculations : [WizardContainerStepsItemSectionsItemHiddenCalculationsItem]
    dataSource : Map string ControlValue
    readOnly : boolean
  }
  type WizardContainerStepsItemSectionsItemFieldsItem = {
    id : string!
    type : string!
    label : string
    required : boolean
    repeatable : boolean
    options : [WizardContainerStepsItemSectionsItemFieldsItemOptionsItem]
    defaultValue : [string]
    condition : SExpr
    placeholder : string
    entityField : string
    minLength : number
    maxLength : number
    dataSource : Map string ControlValue
    displayFields : [string]
    searchConfig : Map string ControlValue
    hiddenCalculations : [WizardContainerStepsItemSectionsItemFieldsItemHiddenCalculationsItem]
    signatureConfig : Map string ControlValue
    displayTemplate : Map string ControlValue
    lawReference : Map string ControlValue
    contextMenu : [string]
    calculated : Map string ControlValue
    readOnly : boolean
    minDate : string
    stats : [WizardContainerStepsItemSectionsItemFieldsItemStatsItem]
    items : [WizardContainerStepsItemSectionsItemFieldsItemItemsItem]
  }
  type WizardContainerStepsItemSectionsItemFieldsItemOptionsItem = {
    value : string!
    label : string!
    isDefault : boolean
  }
  type ControlValue = string | number | boolean | [string] | FileValue
  type FileValue = {
    name : string!
    url : string!
    mimeType : string!
    sizeBytes : number!
  }
  type WizardContainerStepsItemSectionsItemFieldsItemHiddenCalculationsItem = {
    variable : string!
    expression : string!
    scope : string
  }
  type WizardContainerStepsItemSectionsItemFieldsItemStatsItem = {
    label : string!
    value : [string]!
    icon : string
  }
  type WizardContainerStepsItemSectionsItemFieldsItemItemsItem = {
    id : string!
    label : string!
    autoCheck : boolean
  }
  type WizardContainerStepsItemSectionsItemHiddenCalculationsItem = {
    variable : string!
    expression : string!
    scope : string
  }
  type WizardContainerStepsItemEntityMapping = {
    entity : string!
    mode : string!
    parentField : string
    idField : string
  }
  type WizardContainerStepsItemValidationRulesItem = {
    condition : SExpr!
    message : string!
  }
  type WizardContainerStepsItemLawReferencesItem = {
    law : string!
    article : string!
    description : string
  }
  type WizardContainerError = {
    message : string!
    name : string
    code : string
    stack : string
  }

  entity WizardContainerItem [runtime] {
    id : string!
  }

  trait WizardContainerRender -> @rebindable WizardContainerItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          steps: @config.steps
          currentStep: @config.currentStep
          onStepChange: @config.onStepChange
          onComplete: @config.onComplete
          showProgress: @config.showProgress
          allowBack: @config.allowBack
          compact: @config.compact
          className: @config.className
          isLoading: @config.isLoading
          error: @config.error
          nextEvent: @config.nextEvent
          backEvent: @config.backEvent
          completeEvent: @config.completeEvent
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: wizard-container
        })
    }

    emits {
      @config.onStepChange -> external {
        stepIndex : number
      }
        @description "Callback when step changes"
        @tier "essential"
      @config.onComplete -> external { }
        @description "Callback when wizard is completed"
        @tier "essential"
      @config.nextEvent -> external {
        step : number!
      }
        @description "Emits UI:{nextEvent} when advancing to next step"
        @tier "essential"
      @config.backEvent -> external {
        step : number!
      }
        @description "Emits UI:{backEvent} when going to previous step"
        @tier "essential"
    }

    config {
      steps : [WizardContainerStepsItem] = [{ id: "Id", tabId: "Tab Id", title: "Title", name: "Name", description: "Description", content: "Content", optional: false, sections: [{ id: "Id", title: "Title", description: "Description", fields: [{ id: "Id", type: "Type", label: "Label", required: false, repeatable: false, options: [], defaultValue: [], placeholder: "Placeholder", entityField: "Entity Field", minLength: 1, maxLength: 1, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: false, minDate: "Min Date", stats: [], items: [] }, { id: "Id 2", type: "Type 2", label: "Label 2", required: true, repeatable: true, options: [], defaultValue: [], placeholder: "Placeholder 2", entityField: "Entity Field 2", minLength: 2, maxLength: 2, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: true, minDate: "Min Date 2", stats: [], items: [] }], subsections: [], repeatable: false, minItems: 1, addButtonLabel: "Add Button Label", hiddenCalculations: [{ variable: "Variable", expression: "Expression", scope: "Scope" }, { variable: "Variable 2", expression: "Expression 2", scope: "Scope 2" }], readOnly: false }, { id: "Id 2", title: "Title 2", description: "Description 2", fields: [{ id: "Id", type: "Type", label: "Label", required: false, repeatable: false, options: [], defaultValue: [], placeholder: "Placeholder", entityField: "Entity Field", minLength: 1, maxLength: 1, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: false, minDate: "Min Date", stats: [], items: [] }, { id: "Id 2", type: "Type 2", label: "Label 2", required: true, repeatable: true, options: [], defaultValue: [], placeholder: "Placeholder 2", entityField: "Entity Field 2", minLength: 2, maxLength: 2, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: true, minDate: "Min Date 2", stats: [], items: [] }], subsections: [], repeatable: true, minItems: 2, addButtonLabel: "Add Button Label 2", hiddenCalculations: [{ variable: "Variable", expression: "Expression", scope: "Scope" }, { variable: "Variable 2", expression: "Expression 2", scope: "Scope 2" }], readOnly: true }], globalVariablesRequired: ["Item", "Item 2"], globalVariablesSet: ["Item", "Item 2"], localVariables: ["Item", "Item 2"], entityMapping: { entity: "Entity", mode: "Mode", parentField: "Parent Field", idField: "Id Field" }, validationRules: [{ condition: {}, message: "Message" }, { condition: {}, message: "Message 2" }], lawReferences: [{ law: "Law", article: "Article", description: "Description" }, { law: "Law 2", article: "Article 2", description: "Description 2" }], phase: "Phase", contextMenu: ["Item", "Item 2"] }, { id: "Id 2", tabId: "Tab Id 2", title: "Title 2", name: "Name 2", description: "Description 2", content: "Content 2", optional: true, sections: [{ id: "Id", title: "Title", description: "Description", fields: [{ id: "Id", type: "Type", label: "Label", required: false, repeatable: false, options: [], defaultValue: [], placeholder: "Placeholder", entityField: "Entity Field", minLength: 1, maxLength: 1, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: false, minDate: "Min Date", stats: [], items: [] }, { id: "Id 2", type: "Type 2", label: "Label 2", required: true, repeatable: true, options: [], defaultValue: [], placeholder: "Placeholder 2", entityField: "Entity Field 2", minLength: 2, maxLength: 2, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: true, minDate: "Min Date 2", stats: [], items: [] }], subsections: [], repeatable: false, minItems: 1, addButtonLabel: "Add Button Label", hiddenCalculations: [{ variable: "Variable", expression: "Expression", scope: "Scope" }, { variable: "Variable 2", expression: "Expression 2", scope: "Scope 2" }], readOnly: false }, { id: "Id 2", title: "Title 2", description: "Description 2", fields: [{ id: "Id", type: "Type", label: "Label", required: false, repeatable: false, options: [], defaultValue: [], placeholder: "Placeholder", entityField: "Entity Field", minLength: 1, maxLength: 1, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: false, minDate: "Min Date", stats: [], items: [] }, { id: "Id 2", type: "Type 2", label: "Label 2", required: true, repeatable: true, options: [], defaultValue: [], placeholder: "Placeholder 2", entityField: "Entity Field 2", minLength: 2, maxLength: 2, displayFields: [], hiddenCalculations: [], contextMenu: [], readOnly: true, minDate: "Min Date 2", stats: [], items: [] }], subsections: [], repeatable: true, minItems: 2, addButtonLabel: "Add Button Label 2", hiddenCalculations: [{ variable: "Variable", expression: "Expression", scope: "Scope" }, { variable: "Variable 2", expression: "Expression 2", scope: "Scope 2" }], readOnly: true }], globalVariablesRequired: ["Item", "Item 2"], globalVariablesSet: ["Item", "Item 2"], localVariables: ["Item", "Item 2"], entityMapping: { entity: "Entity 2", mode: "Mode 2", parentField: "Parent Field 2", idField: "Id Field 2" }, validationRules: [{ condition: {}, message: "Message" }, { condition: {}, message: "Message 2" }], lawReferences: [{ law: "Law", article: "Article", description: "Description" }, { law: "Law 2", article: "Article 2", description: "Description 2" }], phase: "Phase 2", contextMenu: ["Item", "Item 2"] }]
        @label "Steps"
        @description "Wizard steps"
        @tier "presentation"
      currentStep : scalar
        @label "Current Step"
        @description "Current step index (controlled) - accepts number or string for generated code compatibility"
        @tier "presentation"
      onStepChange : event = "STEP_CHANGE"
        @label "On Step Change"
        @description "Callback when step changes"
        @tier "presentation"
      onComplete : event = "COMPLETE"
        @label "On Complete"
        @description "Callback when wizard is completed"
        @tier "presentation"
      showProgress : boolean = true
        @label "Show Progress"
        @description "Show progress indicator"
        @tier "presentation"
      allowBack : boolean = true
        @label "Allow Back"
        @description "Allow navigation to previous steps"
        @tier "presentation"
      compact : boolean = false
        @label "Compact"
        @description "Modal mode (compact header, no padding)"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      isLoading : boolean
        @label "Is Loading"
        @description "Loading state indicator"
        @tier "presentation"
      error : WizardContainerError
        @label "Error"
        @description "Error state"
        @tier "presentation"
      nextEvent : event = "NEXT"
        @label "Next Event"
        @description "Emits UI:{nextEvent} when advancing to next step"
        @tier "presentation"
      backEvent : event = "BACK"
        @label "Back Event"
        @description "Emits UI:{backEvent} when going to previous step"
        @tier "presentation"
      completeEvent : event = "COMPLETE"
        @label "Complete Event"
        @description "Emits UI:{completeEvent} when wizard completes"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/wizard-container" as WizardContainerPage -> WizardContainerRender
}
