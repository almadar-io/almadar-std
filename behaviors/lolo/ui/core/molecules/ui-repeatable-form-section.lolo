app ui-repeatable-form-section "1.0.0"
"RepeatableFormSection — a form section that repeats a fixed group of fields, letting the user add or remove entries. — UI factory (1:1 with the @almadar/ui repeatable-form-section pattern)."
;; @capabilities "dynamic line items, repeatable field group, add/remove entry rows, multi-entry form block"
;; @pattern "repeatable-form-section"
orbital RepeatableFormSectionOrbital {
  type RepeatableFormSectionItemsItem = {
    id : string!
    addedInState : string
    addedAt : string
  }

  entity RepeatableFormSectionItem [runtime] {
    id : string!
  }

  trait RepeatableFormSectionRender -> @rebindable RepeatableFormSectionItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          sectionType: @config.sectionType
          title: @config.title
          items: @config.items
          renderItem: (fn item { content: (object/get @item @config.itemLabelField ""), type: typography })
          minItems: @config.minItems
          maxItems: @config.maxItems
          allowReorder: @config.allowReorder
          addLabel: @config.addLabel
          emptyMessage: @config.emptyMessage
          readOnly: @config.readOnly
          className: @config.className
          onAdd: @config.onAdd
          onRemove: @config.onRemove
          onReorder: @config.onReorder
          trackAddedInState: @config.trackAddedInState
          currentState: @config.currentState
          showAuditInfo: @config.showAuditInfo
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: repeatable-form-section
        })
    }

    emits {
      @config.onAdd -> external { }
        @description "Add handler"
        @tier "essential"
      @config.onRemove -> external {
        itemId : string
        index : number
      }
        @description "Remove handler"
        @tier "essential"
      @config.onReorder -> external {
        fromIndex : number
        toIndex : number
      }
        @description "Reorder handler"
        @tier "essential"
    }

    config {
      sectionType : string = ""
        @label "Section Type"
        @description "Section type identifier"
        @tier "presentation"
      title : string = ""
        @label "Title"
        @description "Section title"
        @tier "presentation"
      items : [RepeatableFormSectionItemsItem] = [{ id: "Id", addedInState: "Added In State", addedAt: "Added At" }, { id: "Id 2", addedInState: "Added In State 2", addedAt: "Added At 2" }]
        @label "Items"
        @description "Items in the section"
        @tier "presentation"
      itemLabelField : string = "id"
        @label "Item label field"
        @description "Row field rendered as each item's label (defaults to id)."
        @tier "presentation"
      minItems : number = 0
        @label "Min Items"
        @description "Minimum items required"
        @tier "presentation"
      maxItems : number
        @label "Max Items"
        @description "Maximum items allowed"
        @tier "presentation"
      allowReorder : boolean = false
        @label "Allow Reorder"
        @description "Allow reordering"
        @tier "presentation"
      addLabel : string
        @label "Add Label"
        @description "Add button label"
        @tier "presentation"
      emptyMessage : string
        @label "Empty Message"
        @description "Empty state message"
        @tier "presentation"
      readOnly : boolean = false
        @label "Read Only"
        @description "Read-only mode"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      onAdd : event = "ADD"
        @label "On Add"
        @description "Add handler"
        @tier "presentation"
      onRemove : event = "REMOVE"
        @label "On Remove"
        @description "Remove handler"
        @tier "presentation"
      onReorder : event = "REORDER"
        @label "On Reorder"
        @description "Reorder handler"
        @tier "presentation"
      trackAddedInState : boolean = false
        @label "Track Added In State"
        @description "Inspection-specific enhancements"
        @tier "presentation"
      currentState : string
        @label "Current State"
        @description "Current inspection state (used when trackAddedInState is true)"
        @tier "presentation"
      showAuditInfo : boolean = false
        @label "Show Audit Info"
        @description "Show audit metadata (addedInState, addedAt)"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/repeatable-form-section" as RepeatableFormSectionPage -> RepeatableFormSectionRender
}
