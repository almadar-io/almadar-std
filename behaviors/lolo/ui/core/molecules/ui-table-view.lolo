app ui-table-view [
  version: "1.0.0",
  description: "TableView — sortable, selectable data table rendering rows over configurable columns, with inline row actions and grouping. — UI factory (1:1 with the @almadar/ui table-view pattern)."
]
;; @capabilities "admin console table, records list, CRUD data table, user list, manage-users grid, sortable columns, row selection with bulk actions, grouped list view"
;; @pattern "table-view"
orbital TableViewOrbital {
    type TableViewLoaded = Event { data : [TableViewItem] } "TableView rows finished loading; payload.data holds the collection"
  type TableViewEmptyAction = {
    label : string!
    event : event
  }
  type TableViewColumnsItem = {
    key : string!
    field : string
    header : string
    label : string
    width : string
    align : "left" | "center" | "right"
    className : string
    weight : "normal" | "medium" | "semibold"
    format : "badge" | "date" | "currency" | "number" | "percent" | "boolean"
    colorMap : Map string TableViewColumnsItemColorMapValue
    labels : Map string string
    variant : "h3" | "h4"
    icon : icon
    sortable : boolean
  }
  type TableViewColumnsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type TableViewFieldsItem = {
    key : string!
    field : string
    header : string
    label : string
    width : string
    align : "left" | "center" | "right"
    className : string
    weight : "normal" | "medium" | "semibold"
    format : "badge" | "date" | "currency" | "number" | "percent" | "boolean"
    colorMap : Map string TableViewFieldsItemColorMapValue
    labels : Map string string
    variant : "h3" | "h4"
    icon : icon
    sortable : boolean
  }
  type TableViewFieldsItemColorMapValue = "default" | "primary" | "secondary" | "success" | "warning" | "danger" | "error" | "info" | "neutral" | "destructive"
  type TableViewItemActionsItem = {
    label : string!
    event : event!
    icon : icon
    variant : "primary" | "secondary" | "ghost" | "danger"
    when : SExpr
    payload : SExpr
    roles : [string]
  }
  type TableViewError = {
    message : string!
    name : string
    code : string
    stack : string
  }
  type TableViewRelationsDataValueItem = {
    value : string!
    label : string!
    description : string
    disabled : boolean
  }

  entity TableViewItem [runtime] {
    id : string!
  }

  trait TableViewRender -> @rebindable TableViewItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle when @config.selfFetch
        (fetch TableViewItem { emit: { success: TableViewLoaded } })
        (render-ui main {
          dragGroup: @config.dragGroup
          accepts: @config.accepts
          sortable: @config.sortable
          dropEvent: @config.dropEvent
          reorderEvent: @config.reorderEvent
          positionEvent: @config.positionEvent
          dndItemIdField: @config.dndItemIdField
          dndRoot: @config.dndRoot
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          entity: @entity
          columns: @config.columns
          fields: @config.fields
          surface: @config.surface
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          itemClickEvent: @config.itemClickEvent
          selectable: @config.selectable
          selectEvent: @config.selectEvent
          selectedIds: @config.selectedIds
          sortEvent: @config.sortEvent
          sortColumn: @config.sortColumn
          sortDirection: @config.sortDirection
          className: @config.className
          emptyMessage: @config.emptyMessage
          isLoading: @config.isLoading
          skeleton: @config.skeleton
          error: @config.error
          groupBy: @config.groupBy
          pageSize: @config.pageSize
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: table-view
        })
      INIT -> idle when (not @config.selfFetch)
        (render-ui main {
          dragGroup: @config.dragGroup
          accepts: @config.accepts
          sortable: @config.sortable
          dropEvent: @config.dropEvent
          reorderEvent: @config.reorderEvent
          positionEvent: @config.positionEvent
          dndItemIdField: @config.dndItemIdField
          dndRoot: @config.dndRoot
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          entity: @entity
          columns: @config.columns
          fields: @config.fields
          surface: @config.surface
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          itemClickEvent: @config.itemClickEvent
          selectable: @config.selectable
          selectEvent: @config.selectEvent
          selectedIds: @config.selectedIds
          sortEvent: @config.sortEvent
          sortColumn: @config.sortColumn
          sortDirection: @config.sortDirection
          className: @config.className
          emptyMessage: @config.emptyMessage
          isLoading: @config.isLoading
          skeleton: @config.skeleton
          error: @config.error
          groupBy: @config.groupBy
          pageSize: @config.pageSize
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: table-view
        })
      TableViewLoaded -> idle
        (render-ui main {
          dragGroup: @config.dragGroup
          accepts: @config.accepts
          sortable: @config.sortable
          dropEvent: @config.dropEvent
          reorderEvent: @config.reorderEvent
          positionEvent: @config.positionEvent
          dndItemIdField: @config.dndItemIdField
          dndRoot: @config.dndRoot
          emptyIcon: @config.emptyIcon
          emptyTitle: @config.emptyTitle
          emptyDescription: @config.emptyDescription
          emptyAction: @config.emptyAction
          entity: @payload.data
          columns: @config.columns
          fields: @config.fields
          surface: @config.surface
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          itemClickEvent: @config.itemClickEvent
          selectable: @config.selectable
          selectEvent: @config.selectEvent
          selectedIds: @config.selectedIds
          sortEvent: @config.sortEvent
          sortColumn: @config.sortColumn
          sortDirection: @config.sortDirection
          className: @config.className
          emptyMessage: @config.emptyMessage
          isLoading: @config.isLoading
          skeleton: @config.skeleton
          error: @config.error
          groupBy: @config.groupBy
          pageSize: @config.pageSize
          look: @config.look
          relationsData: @config.relationsData
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: table-view
        })
    }

    emits {
      @config.itemClickEvent -> external {
        id : string!
        row : @entity!
      }
        @description "When set, the whole row is clickable and emits UI:{itemClickEvent} with { id, row } (action-button clicks stopPropagation so they still win). Mirrors DataList's contract. Omit = rows are not clickable."
        @tier "essential"
      @config.selectEvent -> external {
        selectedIds : [string]!
      }
        @description "Event emitted on selection change: UI:{selectEvent} with { selectedIds }."
        @tier "essential"
      @config.sortEvent -> external {
        column : string!
        direction : "asc" | "desc"!
      }
        @description "Event emitted on sortable-header click: UI:{sortEvent} with { column, direction }."
        @tier "essential"
      VIEW -> external {
        id : string!
        row : @entity!
      }
        @description "User opened a record from the list."
        @tier "essential"
      TableViewLoaded
        @description "TableView rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    config {
      dragGroup : string
        @label "Drag Group"
        @description "When set, items in this container are draggable and announce this group as their source"
        @tier "presentation"
      accepts : string
        @label "Accepts"
        @description "When set, the container accepts drops whose dragGroup matches this value (or '*' for any group)"
        @tier "presentation"
      sortable : boolean
        @label "Sortable"
        @description "Enable in-container reorder; items can be dragged to new positions among siblings"
        @tier "presentation"
      dropEvent : string
        @label "Drop Event"
        @description "Bus event fired on cross-container drop. Payload: { id, sourceGroup, targetGroup, newIndex }"
        @tier "presentation"
      reorderEvent : string
        @label "Reorder Event"
        @description "Bus event fired on in-container reorder. Payload: { id, oldIndex, newIndex }"
        @tier "presentation"
      positionEvent : string
        @label "Position Event"
        @description "Bus event fired N times per drop (one per item in affected zones) so the trait can persist new positions for the WHOLE zone, not just the moved item. Payload: { id, position }"
        @tier "presentation"
      dndItemIdField : string
        @label "Dnd Item Id Field"
        @description "Row field used as the @dnd-kit draggable id (default 'id')"
        @tier "presentation"
      dndRoot : boolean
        @label "Dnd Root"
        @description "Mark this container as the DnD root for its subtree — descendant zones share one DndContext (cross-container drag). Use on an outer container whose own items are not draggable."
        @tier "presentation"
      emptyIcon : icon
        @label "Empty Icon"
        @description "Domain icon for the empty state."
        @tier "presentation"
      emptyTitle : string
        @label "Empty Title"
        @description "Specific title ('No orders yet')."
        @tier "presentation"
      emptyDescription : string
        @label "Empty Description"
        @description "What will appear here once rows exist."
        @tier "presentation"
      emptyAction : TableViewEmptyAction
        @label "Empty Action"
        @description "Create-the-first-item action."
        @tier "presentation"
      columns : [TableViewColumnsItem] = []
        @label "Columns"
        @description "Column definitions. The compiler emits `columns`; `fields` is the alias."
        @tier "presentation"
      fields : [TableViewFieldsItem] = []
        @label "Fields"
        @description "Alias for `columns`."
        @tier "presentation"
      surface : "auto" | "none" = auto
        @label "Surface"
        @description "Content surface: `auto` paints the theme's surface behind this block unless it already sits on one (a card, dialog or another block); `none` opts out."
        @tier "presentation"
      itemActions : [TableViewItemActionsItem] = []
        @label "Item Actions"
        @description "Per-row actions, collected under a trailing kebab overflow menu."
        @tier "presentation"
      maxInlineActions : number
        @label "Max Inline Actions"
        @description "maxInlineActions prop"
        @tier "presentation"
      itemClickEvent : event = "ITEM_CLICK"
        @label "Item Click Event"
        @description "When set, the whole row is clickable and emits UI:{itemClickEvent} with { id, row } (action-button clicks stopPropagation so they still win). Mirrors DataList's contract. Omit = rows are not clickable."
        @tier "presentation"
      selectable : boolean = false
        @label "Selectable"
        @description "Render a leading checkbox column. Selection changes emit `selectEvent`."
        @tier "presentation"
      selectEvent : event = "SELECT"
        @label "Select Event"
        @description "Event emitted on selection change: UI:{selectEvent} with { selectedIds }."
        @tier "presentation"
      selectedIds : [string] = []
        @label "Selected Ids"
        @description "Currently-selected ids (controlled). Falls back to local state when omitted."
        @tier "presentation"
      sortEvent : event = "SORT"
        @label "Sort Event"
        @description "Event emitted on sortable-header click: UI:{sortEvent} with { column, direction }."
        @tier "presentation"
      sortColumn : string
        @label "Sort Column"
        @description "Current sort column (display hint for the active header arrow)."
        @tier "presentation"
      sortDirection : "asc" | "desc"
        @label "Sort Direction"
        @description "Current sort direction (display hint)."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes applied to the table root."
        @tier "presentation"
      emptyMessage : string
        @label "Empty Message"
        @description "Message shown when there are no rows."
        @tier "presentation"
      isLoading : boolean = false
        @label "Is Loading"
        @description "Loading state."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none" = table
        @label "Skeleton"
        @description "Skeleton drawn while loading, and the shape an empty slot shows while this element's server render is in flight (`none` opts out)."
        @tier "presentation"
      error : TableViewError
        @label "Error"
        @description "Error state."
        @tier "presentation"
      groupBy : string
        @label "Group By"
        @description "Group rows under section headers by a field value."
        @tier "presentation"
      pageSize : number = 0
        @label "Page Size"
        @description "Max rows before a 'Show More' button. Defaults to 0 (show all)."
        @tier "presentation"
      look : "dense" | "spacious" | "striped" | "borderless" | "bordered" = dense
        @label "Look"
        @description "Layer 2 visual treatment — mirrors the data-list / entity-table look enum so authors share one knob name across row renderers."
        @tier "presentation"
      relationsData : Map string [TableViewRelationsDataValueItem] = {}
        @label "Relations Data"
        @description "Relation display data: { fieldName: [{value, label}] } — injected server-side by the runtime (relation-option injection) or bound by compiled codegen; resolves stored foreign ids to display names for a column whose field is relation-typed. Same contract DetailPanel takes."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
      selfFetch : boolean = true
        @label "Fetch its own rows on mount?"
        @description "true (default) = standalone mount self-populates on INIT. false = a composing atom owns the fetch and routes its loaded event here — suppresses the wrapper's own un-hydrated fetch so it cannot race the composer's."
        @tier "internal"
    }
  }

  page "/table-view" as TableViewPage -> TableViewRender
}
