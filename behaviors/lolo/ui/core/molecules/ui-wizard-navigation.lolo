app ui-wizard-navigation "1.0.0"
"WizardNavigation — UI factory (1:1 with the @almadar/ui wizard-navigation pattern)."
;; @pattern "wizard-navigation"
orbital WizardNavigationOrbital {
  entity WizardNavigationItem [runtime] {
    id : string!
    currentStep : number @intrinsic = 1
    totalSteps : number @intrinsic = 1
  }

  trait WizardNavigationRender -> @rebindable WizardNavigationItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.currentStep @config.currentStep)
        (set @entity.totalSteps @config.totalSteps)
        (render-ui main {
          currentStep: @entity.currentStep
          totalSteps: @entity.totalSteps
          isValid: @config.isValid
          showBack: @config.showBack
          showNext: @config.showNext
          showComplete: @config.showComplete
          backLabel: @config.backLabel
          nextLabel: @config.nextLabel
          completeLabel: @config.completeLabel
          onBack: @config.onBack
          onNext: @config.onNext
          onComplete: @config.onComplete
          onBackClick: @config.onBackClick
          onNextClick: @config.onNextClick
          onCompleteClick: @config.onCompleteClick
          compact: @config.compact
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: wizard-navigation
        })
      BACK -> idle
        (set @entity.currentStep ?currentStep)
        (set @entity.totalSteps ?totalSteps)
        (render-ui main {
          currentStep: @entity.currentStep
          totalSteps: @entity.totalSteps
          isValid: @config.isValid
          showBack: @config.showBack
          showNext: @config.showNext
          showComplete: @config.showComplete
          backLabel: @config.backLabel
          nextLabel: @config.nextLabel
          completeLabel: @config.completeLabel
          onBack: @config.onBack
          onNext: @config.onNext
          onComplete: @config.onComplete
          onBackClick: @config.onBackClick
          onNextClick: @config.onNextClick
          onCompleteClick: @config.onCompleteClick
          compact: @config.compact
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: wizard-navigation
        })
      NEXT -> idle
        (set @entity.currentStep ?currentStep)
        (set @entity.totalSteps ?totalSteps)
        (render-ui main {
          currentStep: @entity.currentStep
          totalSteps: @entity.totalSteps
          isValid: @config.isValid
          showBack: @config.showBack
          showNext: @config.showNext
          showComplete: @config.showComplete
          backLabel: @config.backLabel
          nextLabel: @config.nextLabel
          completeLabel: @config.completeLabel
          onBack: @config.onBack
          onNext: @config.onNext
          onComplete: @config.onComplete
          onBackClick: @config.onBackClick
          onNextClick: @config.onNextClick
          onCompleteClick: @config.onCompleteClick
          compact: @config.compact
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: wizard-navigation
        })
      COMPLETE -> idle
        (set @entity.currentStep ?currentStep)
        (set @entity.totalSteps ?totalSteps)
        (render-ui main {
          currentStep: @entity.currentStep
          totalSteps: @entity.totalSteps
          isValid: @config.isValid
          showBack: @config.showBack
          showNext: @config.showNext
          showComplete: @config.showComplete
          backLabel: @config.backLabel
          nextLabel: @config.nextLabel
          completeLabel: @config.completeLabel
          onBack: @config.onBack
          onNext: @config.onNext
          onComplete: @config.onComplete
          onBackClick: @config.onBackClick
          onNextClick: @config.onNextClick
          onCompleteClick: @config.onCompleteClick
          compact: @config.compact
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: wizard-navigation
        })
    }

    emits {
      @config.onBack -> external {
        currentStep : number!
        totalSteps : number!
      }
        @description "Event to emit on Back click — emits UI:{onBack} with { currentStep, totalSteps }"
        @tier "essential"
      @config.onNext -> external {
        currentStep : number!
        totalSteps : number!
      }
        @description "Event to emit on Next click — emits UI:{onNext} with { currentStep, totalSteps }"
        @tier "essential"
      @config.onComplete -> external {
        currentStep : number!
        totalSteps : number!
      }
        @description "Event to emit on Complete click — emits UI:{onComplete} with { currentStep, totalSteps }"
        @tier "essential"
      @config.onBackClick -> external { }
        @description "Direct callback for Back (alternative to event)"
        @tier "essential"
      @config.onNextClick -> external { }
        @description "Direct callback for Next (alternative to event)"
        @tier "essential"
      @config.onCompleteClick -> external { }
        @description "Direct callback for Complete (alternative to event)"
        @tier "essential"
    }

    listens {
      BACK {
        currentStep : number!
        totalSteps : number!
      }
      NEXT {
        currentStep : number!
        totalSteps : number!
      }
      COMPLETE {
        currentStep : number!
        totalSteps : number!
      }
    }

    config {
      currentStep : number = 1
        @label "Current Step"
        @description "Current step index (0-based)"
        @tier "presentation"
      totalSteps : number = 1
        @label "Total Steps"
        @description "Total number of steps"
        @tier "presentation"
      isValid : boolean = true
        @label "Is Valid"
        @description "Whether the current step is valid (enables Next/Complete)"
        @tier "presentation"
      showBack : boolean = true
        @label "Show Back"
        @description "Show the Back button"
        @tier "presentation"
      showNext : boolean = true
        @label "Show Next"
        @description "Show the Next button"
        @tier "presentation"
      showComplete : boolean = true
        @label "Show Complete"
        @description "Show the Complete button (on last step)"
        @tier "presentation"
      backLabel : string
        @label "Back Label"
        @description "Custom label for Back button"
        @tier "presentation"
      nextLabel : string
        @label "Next Label"
        @description "Custom label for Next button"
        @tier "presentation"
      completeLabel : string
        @label "Complete Label"
        @description "Custom label for Complete button"
        @tier "presentation"
      onBack : event = "BACK"
        @label "On Back"
        @description "Event to emit on Back click — emits UI:{onBack} with { currentStep, totalSteps }"
        @tier "presentation"
      onNext : event = "NEXT"
        @label "On Next"
        @description "Event to emit on Next click — emits UI:{onNext} with { currentStep, totalSteps }"
        @tier "presentation"
      onComplete : event = "COMPLETE"
        @label "On Complete"
        @description "Event to emit on Complete click — emits UI:{onComplete} with { currentStep, totalSteps }"
        @tier "presentation"
      onBackClick : event = "BACK_CLICK"
        @label "On Back Click"
        @description "Direct callback for Back (alternative to event)"
        @tier "presentation"
      onNextClick : event = "NEXT_CLICK"
        @label "On Next Click"
        @description "Direct callback for Next (alternative to event)"
        @tier "presentation"
      onCompleteClick : event = "COMPLETE_CLICK"
        @label "On Complete Click"
        @description "Direct callback for Complete (alternative to event)"
        @tier "presentation"
      compact : boolean = false
        @label "Compact"
        @description "Compact mode (smaller padding)"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/wizard-navigation" as WizardNavigationPage -> WizardNavigationRender
}
