app ui-document-panel "1.0.0"
"DocumentPanel — a record rendered as one continuous document: editable title over the rich-text body, editing controls tucked into the header corner. — UI factory (1:1 with the @almadar/ui document-panel pattern)."
;; @capabilities "document page, note editor, wiki page, article editor, writing surface, rich text document, content editing canvas"
;; @pattern "document-panel"
orbital DocumentPanelOrbital {
  type DocumentPanelActionsItem = {
    label : string!
    event : event
    icon : icon
    variant : "primary" | "secondary" | "ghost" | "danger"
    roles : [string]
  }

  entity DocumentPanelItem [runtime] {
    id : string!
    title : string @intrinsic
    value : string @intrinsic
  }

  trait DocumentPanelRender -> @rebindable DocumentPanelItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.title @config.title)
        (set @entity.value @config.value)
        (render-ui main {
          title: @entity.title
          subtitle: @config.subtitle
          coverImage: @config.coverImage
          icon: @config.icon
          value: @entity.value
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: document-panel
        })
      TITLE_COMMIT -> idle
        (set @entity.title ?title)
        (render-ui main {
          title: @entity.title
          subtitle: @config.subtitle
          coverImage: @config.coverImage
          icon: @config.icon
          value: @entity.value
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: document-panel
        })
      CONTENT_CHANGE -> idle
        (set @entity.value ?value)
        (render-ui main {
          title: @entity.title
          subtitle: @config.subtitle
          coverImage: @config.coverImage
          icon: @config.icon
          value: @entity.value
          actions: (array/filter @config.actions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: document-panel
        })
    }

    emits {
      @config.titleCommitEvent -> external {
        title : string!
        id : string!
      }
        @description "Emitted when the title commits: { title, id }"
        @tier "essential"
      @config.contentChangeEvent -> external {
        value : string!
      }
        @description "Forwarded to the embedded RichTextEditor's autosave stream: { value }"
        @tier "essential"
      @config.editEvent -> external {
        id : string!
      }
        @description "Emitted by the header Edit affordance and a click on the read body: { id }"
        @tier "essential"
      @config.doneEvent -> external {
        id : string!
      }
        @description "Emitted by the Done button that ends the editing session: { id }"
        @tier "essential"
    }

    listens {
      TITLE_COMMIT {
        title : string!
        id : string!
      }
      CONTENT_CHANGE {
        value : string!
      }
    }

    config {
      title : string
        @label "Title"
        @description "Document title (falls back to 'Untitled' for a blank draft)"
        @tier "presentation"
      subtitle : string
        @label "Subtitle"
        @description "Muted byline under the title; hidden when empty"
        @tier "presentation"
      coverImage : string
        @label "Cover Image"
        @description "Cover/hero image URL painted as a full-bleed banner above the header row (Notion/article-hero shape); hidden when empty"
        @tier "presentation"
      icon : icon
        @label "Icon"
        @description "Document icon rendered beside the title (a file glyph, a domain icon); hidden when empty"
        @tier "presentation"
      value : string
        @label "Value"
        @description "The document body as rich-text HTML"
        @tier "presentation"
      actions : [DocumentPanelActionsItem] = []
        @label "Actions"
        @description "Header actions (settings, history, …). At most one explicit primary stays inline; the rest live under a single '⋯' menu — the title owns its row."
        @tier "presentation"
      maxInlineActions : number
        @label "Max Inline Actions"
        @description "0 collapses even the primary action into the menu"
        @tier "presentation"
      editing : boolean = false
        @label "Editing"
        @description "false = read surface with click-to-edit body; true = live editor"
        @tier "presentation"
      titleCommitEvent : event = "TITLE_COMMIT"
        @label "Title Commit Event"
        @description "Emitted when the title commits: { title, id }"
        @tier "presentation"
      contentChangeEvent : event = "CONTENT_CHANGE"
        @label "Content Change Event"
        @description "Forwarded to the embedded RichTextEditor's autosave stream: { value }"
        @tier "presentation"
      editEvent : event = "EDIT"
        @label "Edit Event"
        @description "Emitted by the header Edit affordance and a click on the read body: { id }"
        @tier "presentation"
      doneEvent : event = "DONE"
        @label "Done Event"
        @description "Emitted by the Done button that ends the editing session: { id }"
        @tier "presentation"
      editLabel : string
        @label "Edit Label"
        @description "editLabel prop"
        @tier "presentation"
      doneLabel : string
        @label "Done Label"
        @description "doneLabel prop"
        @tier "presentation"
      autosaveHint : string
        @label "Autosave Hint"
        @description "Muted caption beside Done telling the author work persists on its own"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Placeholder for an empty body"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The viewer's role that each action's `roles` is checked against; bind it at the call site (e.g. `viewerRole: @user.role`). Empty = only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/document-panel" as DocumentPanelPage -> DocumentPanelRender
}
