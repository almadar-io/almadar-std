app ui-document-panel "1.0.0"
"DocumentPanel — a record rendered as one continuous document: editable title over the rich-text body, editing controls tucked into the header corner. — UI factory (1:1 with the @almadar/ui document-panel pattern)."
;; @capabilities "document page, note editor, wiki page, article editor, writing surface, rich text document, content editing canvas"
orbital DocumentPanelOrbital {
    type DocumentPanelLoaded = Event { data : [DocumentPanelItem] } "DocumentPanel rows finished loading; payload.data holds the collection"
  type DocumentPanelActionsItem = {
    label : string!
    event : string
    icon : icon
    variant : "primary" | "secondary" | "ghost" | "danger"
  }

  entity DocumentPanelItem [runtime] {
    id : string!
    title : string
    value : string
  }

  trait DocumentPanelRender -> @rebindable DocumentPanelItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (fetch DocumentPanelItem { emit: { success: DocumentPanelLoaded } })
        (set @entity.title @config.title)
        (set @entity.value @config.value)
        (render-ui main {
          entity: @entity
          title: @entity.title
          subtitle: @config.subtitle
          value: @entity.value
          actions: @config.actions
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          type: document-panel
        })
      DocumentPanelLoaded -> idle
        (render-ui main {
          entity: @payload.data
          title: @entity.title
          subtitle: @config.subtitle
          value: @entity.value
          actions: @config.actions
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          type: document-panel
        })
      TITLE_COMMIT -> idle
        (set @entity.title ?title)
        (render-ui main {
          entity: @entity
          title: @entity.title
          subtitle: @config.subtitle
          value: @entity.value
          actions: @config.actions
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          type: document-panel
        })
      CONTENT_CHANGE -> idle
        (set @entity.value ?value)
        (render-ui main {
          entity: @entity
          title: @entity.title
          subtitle: @config.subtitle
          value: @entity.value
          actions: @config.actions
          maxInlineActions: @config.maxInlineActions
          editing: @config.editing
          titleCommitEvent: @config.titleCommitEvent
          contentChangeEvent: @config.contentChangeEvent
          editEvent: @config.editEvent
          doneEvent: @config.doneEvent
          editLabel: @config.editLabel
          doneLabel: @config.doneLabel
          autosaveHint: @config.autosaveHint
          placeholder: @config.placeholder
          className: @config.className
          type: document-panel
        })
    }

    emits {
      @config.titleCommitEvent -> external {
        title : string!
        id : string!
      }
        @description "Emitted when the title commits: { title, id }"
        @tier "essential"
      @config.contentChangeEvent -> external {
        value : string!
      }
        @description "Forwarded to the embedded RichTextEditor's autosave stream: { value }"
        @tier "essential"
      @config.editEvent -> external {
        id : string!
      }
        @description "Emitted by the header Edit affordance and a click on the read body: { id }"
        @tier "essential"
      @config.doneEvent -> external {
        id : string!
      }
        @description "Emitted by the Done button that ends the editing session: { id }"
        @tier "essential"
      DocumentPanelLoaded
        @description "DocumentPanel rows finished loading; payload.data holds the collection."
        @synonyms "loaded, fetched, retrieved"
        @tier "essential"
    }

    listens {
      TITLE_COMMIT {
        title : string!
        id : string!
      }
      CONTENT_CHANGE {
        value : string!
      }
    }

    config {
      title : string
        @label "Title"
        @description "Document title (falls back to 'Untitled' for a blank draft)"
        @tier "presentation"
      subtitle : string
        @label "Subtitle"
        @description "Muted byline under the title; hidden when empty"
        @tier "presentation"
      value : string
        @label "Value"
        @description "The document body as rich-text HTML"
        @tier "presentation"
      actions : [DocumentPanelActionsItem] = []
        @label "Actions"
        @description "Header actions (settings, history, …). At most one explicit primary stays inline; the rest live under a single '⋯' menu — the title owns its row."
        @tier "presentation"
      maxInlineActions : number
        @label "Max Inline Actions"
        @description "0 collapses even the primary action into the menu"
        @tier "presentation"
      editing : boolean = false
        @label "Editing"
        @description "false = read surface with click-to-edit body; true = live editor"
        @tier "presentation"
      titleCommitEvent : string = "TITLE_COMMIT"
        @label "Title Commit Event"
        @description "Emitted when the title commits: { title, id }"
        @tier "presentation"
      contentChangeEvent : string = "CONTENT_CHANGE"
        @label "Content Change Event"
        @description "Forwarded to the embedded RichTextEditor's autosave stream: { value }"
        @tier "presentation"
      editEvent : string = "EDIT"
        @label "Edit Event"
        @description "Emitted by the header Edit affordance and a click on the read body: { id }"
        @tier "presentation"
      doneEvent : string = "DONE"
        @label "Done Event"
        @description "Emitted by the Done button that ends the editing session: { id }"
        @tier "presentation"
      editLabel : string
        @label "Edit Label"
        @description "editLabel prop"
        @tier "presentation"
      doneLabel : string
        @label "Done Label"
        @description "doneLabel prop"
        @tier "presentation"
      autosaveHint : string
        @label "Autosave Hint"
        @description "Muted caption beside Done telling the author work persists on its own"
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Placeholder for an empty body"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
    }
  }

  page "/document-panel" as DocumentPanelPage -> DocumentPanelRender
}
