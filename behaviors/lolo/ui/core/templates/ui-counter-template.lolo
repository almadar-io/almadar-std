app ui-counter-template "1.0.0"
"CounterTemplate — UI factory (1:1 with the @almadar/ui counter-template pattern)."
;; @pattern "counter-template"
orbital CounterTemplateOrbital {
  entity CounterTemplateItem [runtime] {
    id : string!
    count : number = 1
    decrementDisabled : boolean = false
    incrementDisabled : boolean = false
    decrementLabel : string = "Decrement Label"
    incrementLabel : string = "Increment Label"
    rangeText : string = "Range Text"
  }

  trait CounterTemplateRender -> @rebindable CounterTemplateItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (fetch CounterTemplateItem {})
        (render-ui main {
          entity: @entity
          className: @config.className
          onIncrement: @config.onIncrement
          onDecrement: @config.onDecrement
          onReset: @config.onReset
          incrementEvent: @config.incrementEvent
          decrementEvent: @config.decrementEvent
          resetEvent: @config.resetEvent
          title: @config.title
          showReset: @config.showReset
          size: @config.size
          variant: @config.variant
          type: counter-template
        })
    }

    emits {
      @config.onIncrement -> external { }
        @description "Called when increment is clicked"
        @tier "essential"
      @config.onDecrement -> external { }
        @description "Called when decrement is clicked"
        @tier "essential"
      @config.onReset -> external { }
        @description "Called when reset is clicked"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "External styling override"
        @tier "presentation"
      onIncrement : event = "INCREMENT"
        @label "On Increment"
        @description "Called when increment is clicked"
        @tier "presentation"
      onDecrement : event = "DECREMENT"
        @label "On Decrement"
        @description "Called when decrement is clicked"
        @tier "presentation"
      onReset : event = "RESET"
        @label "On Reset"
        @description "Called when reset is clicked"
        @tier "presentation"
      incrementEvent : event = "INCREMENT"
        @label "Increment Event"
        @description "Declarative event key — emits UI:{incrementEvent} via bus on increment"
        @tier "presentation"
      decrementEvent : event = "DECREMENT"
        @label "Decrement Event"
        @description "Declarative event key — emits UI:{decrementEvent} via bus on decrement"
        @tier "presentation"
      resetEvent : event = "RESET"
        @label "Reset Event"
        @description "Declarative event key — emits UI:{resetEvent} via bus on reset"
        @tier "presentation"
      title : string
        @label "Title"
        @description "Title displayed above the counter"
        @tier "presentation"
      showReset : boolean = true
        @label "Show Reset"
        @description "Show reset button"
        @tier "presentation"
      size : "sm" | "md" | "lg" = md
        @label "Size"
        @description "Counter display size"
        @tier "presentation"
      variant : "minimal" | "standard" | "full" = minimal
        @label "Variant"
        @description "Template variant"
        @tier "presentation"
    }
  }

  page "/counter-template" as CounterTemplatePage -> CounterTemplateRender
}
