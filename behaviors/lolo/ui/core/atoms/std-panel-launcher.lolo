app std-panel-launcher "1.0.0"
"std-panel-launcher — a floating button on the page that opens a side panel holding one trait (an assistant, a help panel, a cart). Closed: the button floats bottom-right. Open: the panel shows `contentTrait` under `title` and the button steps aside; the panel's close button (or Escape on small screens) brings the button back. The panel slot defaults to `dock`, which pushes the page aside on wide screens and becomes a side sheet below 1024px. List the trait on every page that should carry the button — it never injects itself."
;; @capabilities "floating action button, launcher, side panel, docked panel, chat launcher, help panel, assistant button"
orbital PanelLauncherOrbital {
  entity PanelLauncherView [runtime] {
    id : string!
  }

  trait PanelLauncher -> @rebindable PanelLauncherView [interaction, instance] {
    config {
      contentTrait : trait
        @label "What does the panel hold?"
        @description "The trait the panel shows when it is open."
        @synonyms "panel content, body, assistant, chat"
        @tier "presentation"
      title : string = "Panel"
        @label "Panel title"
        @description "Heading at the top of the open panel."
        @tier "presentation"
      icon : icon = message-circle
        @label "Button icon"
        @tier "presentation"
      label : string = "Open panel"
        @label "Button label"
        @description "What the floating button does, read to screen readers and shown as its tooltip."
        @synonyms "aria label, button name, tooltip"
        @tier "presentation"
      closeLabel : string = "Close panel"
        @label "Close button label"
        @tier "presentation"
      panelSlot : slot = dock
        @label "Where the panel opens"
        @description "`dock` pushes the page aside (a side sheet on small screens); `drawer` slides over it."
        @tier "presentation"
    }
    initial: closed

    state closed {
      INIT -> closed
        (render-ui floating {
          action: OPEN
          icon: @config.icon
          label: @config.label
          type: floating-action-button
        })
      OPEN -> open
        (render-ui floating null)
        (render-ui @config.panelSlot {
          children: [{
            align: center
            children: [{
              content: @config.title
              type: typography
              variant: h4
            }, {
              action: CLOSE
              aria-label: @config.closeLabel
              icon: x
              type: button
              variant: ghost
            }]
            direction: horizontal
            justify: between
            type: stack
          }, @config.contentTrait]
          direction: vertical
          gap: md
          className: "h-full min-h-0 p-4"
          type: stack
        })
    }

    state open {
      CLOSE -> closed
        (render-ui @config.panelSlot null)
        (render-ui floating {
          action: OPEN
          icon: @config.icon
          label: @config.label
          type: floating-action-button
        })
    }

    emits {
      OPEN
        @description "Open the panel."
        @synonyms "show, launch, expand"
        @tier "presentation"
      CLOSE
        @description "Close the panel."
        @synonyms "hide, dismiss, collapse"
        @tier "presentation"
    }
  }

  page "/panel-launcher" as PanelLauncherPage -> PanelLauncher
}
