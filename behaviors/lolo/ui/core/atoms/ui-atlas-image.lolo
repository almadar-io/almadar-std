app ui-atlas-image "1.0.0"
"AtlasImage — UI factory (1:1 with the @almadar/ui atlas-image pattern)."
;; @pattern "atlas-image"
orbital AtlasImageOrbital {
  type AtlasImageAsset = {
    url : string
    atlas : string
    sprite : string
    name : string
    category : string
  }

  entity AtlasImageItem [runtime] {
    id : string!
  }

  trait AtlasImageRender -> @rebindable AtlasImageItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          asset: @config.asset
          size: @config.size
          width: @config.width
          height: @config.height
          fill: @config.fill
          fit: @config.fit
          alt: @config.alt
          className: @config.className
          style: @config.style
          aria-hidden: @config.ariaHidden
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          type: atlas-image
        })
    }

    config {
      asset : AtlasImageAsset
        @label "Asset"
        @description "asset prop"
        @tier "presentation"
      size : number
        @label "Size"
        @description "Square pixel size (icon usage). Ignored when `fill`."
        @tier "presentation"
      width : number
        @label "Width"
        @description "width prop"
        @tier "presentation"
      height : number
        @label "Height"
        @description "height prop"
        @tier "presentation"
      fill : boolean = false
        @label "Fill"
        @description "Absolutely fill the nearest positioned ancestor (background usage)."
        @tier "presentation"
      fit : "contain" | "cover" | "fill" = contain
        @label "Fit"
        @description "fit prop"
        @tier "presentation"
      alt : string
        @label "Alt"
        @description "alt prop"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      style : Map string string = {}
        @label "Style"
        @description "style prop"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "aria-hidden prop"
        @synonyms "aria-hidden"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
    }
  }

  page "/atlas-image" as AtlasImagePage -> AtlasImageRender
}
