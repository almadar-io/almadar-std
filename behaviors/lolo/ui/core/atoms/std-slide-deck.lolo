app std-slide-deck [
  version: "1.0.0",
  description: "std-slide-deck — generic presentation atom. An ordered list of slide nodes (`config.slides`, any render tree or @trait) shown one at a time, with a previous/next arrow on either side, a dot strip and a k / n counter underneath, and NEXT / PREV events that step one slide through `config.slideCount` slides, for whatever the call site maps to them (a key map, a wheel or swipe gesture, a remote). A deck whose body is a canvas scene can also be driven by clicks on its drawables: the canvas sends PICK and `config.pickTargets` names the slide each drawable goes to. The cursor clamps at either end unless `loop` is on. Each visit mounts the slide fresh, so its own entry animations replay. Carries no content or visual style: a realization supplies the slides and restyles via `bodyContent`. The default body picks the slide inside a mapped-children lambda, which expands static slides only; a deck whose slides hold stateful traits (forms, live lists) overrides `bodyContent` with one `presence` per slide gated on `@entity.slideIndex`. Every move emits SLIDE_CHANGED for speaker notes, timers or analytics."
]
;; @capabilities "slide deck, presentation, pitch deck, keynote-style slideshow, previous and next slide arrows, next and previous events for keys and gestures, jump to slide from dots, slide counter"
;; @synonyms "slideshow, deck, presentation, slides, pitch"
orbital SlideDeckOrbital {
  entity SlideDeck [runtime] {
    id : string!
    slideIndex : number @description "Zero-based index of the slide currently shown." @synonyms "current slide, cursor, position" = 0
  }

  trait SlideDeckPresenter -> @rebindable SlideDeck [client] {
    initial: presenting

    state presenting {
      INIT -> presenting
        (set @entity.slideIndex @config.startIndex)
        (when @config.paints (render-ui main @config.bodyContent))
      GO_TO -> presenting
        (set @entity.slideIndex ?index)
        (emit SLIDE_CHANGED { index: @entity.slideIndex })
        (when @config.paints (render-ui main @config.bodyContent))
      NEXT -> presenting when (< @entity.slideIndex (- @config.slideCount 1))
        (set @entity.slideIndex (+ @entity.slideIndex 1))
        (emit SLIDE_CHANGED { index: @entity.slideIndex })
        (when @config.paints (render-ui main @config.bodyContent))
      NEXT -> presenting when (and @config.loop (>= @entity.slideIndex (- @config.slideCount 1)) (> @config.slideCount 1))
        (set @entity.slideIndex 0)
        (emit SLIDE_CHANGED { index: @entity.slideIndex })
        (when @config.paints (render-ui main @config.bodyContent))
      NEXT -> presenting when (or (<= @config.slideCount 1) (and (not @config.loop) (>= @entity.slideIndex (- @config.slideCount 1))))
      PREV -> presenting when (> @entity.slideIndex 0)
        (set @entity.slideIndex (- @entity.slideIndex 1))
        (emit SLIDE_CHANGED { index: @entity.slideIndex })
        (when @config.paints (render-ui main @config.bodyContent))
      PREV -> presenting when (and @config.loop (<= @entity.slideIndex 0) (> @config.slideCount 1))
        (set @entity.slideIndex (- @config.slideCount 1))
        (emit SLIDE_CHANGED { index: @entity.slideIndex })
        (when @config.paints (render-ui main @config.bodyContent))
      PREV -> presenting when (and (<= @entity.slideIndex 0) (or (not @config.loop) (<= @config.slideCount 1)))
      PICK -> presenting when (>= (object/get @config.pickTargets (default ?unitId "") -1) 0)
        (set @entity.slideIndex (object/get @config.pickTargets (default ?unitId "") 0))
        (emit SLIDE_CHANGED { index: @entity.slideIndex })
        (when @config.paints (render-ui main @config.bodyContent))
      PICK -> presenting when (< (object/get @config.pickTargets (default ?unitId "") -1) 0)
    }

    emits {
      SLIDE_CHANGED -> external {
        index : number!
      }
        @description "The deck moved to a new slide (zero-based index)."
        @synonyms "slide shown, advanced, went back"
        @tier "domain"
    }

    listens {
      GO_TO {
        index : number!
      }
        @description "Show a zero-based slide index. The arrows and dots send the already-bounded target; a remote or table of contents can send any index."
        @synonyms "jump, seek, select slide"
        @tier "domain"
      NEXT {}
        @description "Step to the next of `slideCount` slides; at the last it wraps to the first when `loop` is on and does nothing otherwise."
        @synonyms "next slide, forward, advance"
        @tier "domain"
      PREV {}
        @description "Step to the previous of `slideCount` slides; at the first it wraps to the last when `loop` is on and does nothing otherwise."
        @synonyms "previous slide, back"
        @tier "domain"
      PICK {
        unitId : string
        x : number
        z : number
      }
        @description "A drawable of a canvas in the deck's body was clicked (the shape a canvas's `unitClickEvent` sends): the deck goes to the slide `pickTargets` lists for the drawable's id and ignores any other."
        @synonyms "click a body, pick a station, select on the canvas"
        @tier "domain"
    }

    config {
      slides : [trait] = []
        @label "Slides"
        @description "Ordered slide nodes; each entry is a render tree or a @trait reference and is shown one at a time."
        @tier "domain"
      slideCount : number = 0
        @label "Slide count for stepping"
        @description "How many slides NEXT and PREV step through. Set it only when the deck is stepped by those events (keys, gestures, a remote); the arrows and dots bound their own target from `slides`. 0 leaves NEXT and PREV without effect. A number of its own because slides may hold translated text, which a guard cannot read."
        @tier "domain"
      pickTargets : Map string number = {}
        @label "Slides by picked drawable"
        @description "For a deck whose body is a canvas: the zero-based slide a click on a drawable goes to, by the drawable's id. Set the canvas's `unitClickEvent` to PICK."
        @tier "domain"
      startIndex : number = 0
        @label "Start slide"
        @description "Zero-based slide shown on first render; clamped to the deck."
        @tier "presentation"
      loop : boolean = false
        @label "Loop"
        @description "Wrap from the last slide to the first (and back) instead of stopping at either end."
        @tier "presentation"
      showArrows : boolean = true
        @label "Show arrows"
        @description "Previous/next buttons on the left and right of the slide."
        @tier "presentation"
      showProgress : boolean = true
        @label "Show progress"
        @description "Dot strip and k / n counter under the slide; dots jump to their slide."
        @tier "presentation"
      stageMinHeight : string = "70vh"
        @label "Stage height"
        @description "Minimum height of the slide stage (any CSS length, e.g. 70vh or 640px); the slide is centred vertically inside it so short and tall slides share one frame."
        @tier "presentation"
      prevIcon : icon = chevron-left
        @label "Previous icon"
        @tier "presentation"
      nextIcon : icon = chevron-right
        @label "Next icon"
        @tier "presentation"
      paints : boolean = true
        @label "Paints"
        @description "On, the deck paints its arrows, stage and counter. Off, it only keeps the cursor and emits SLIDE_CHANGED, for a page that paints its own stage (a canvas)."
        @tier "presentation"
      bodyContent : render-ui = {
        type: stack
        direction: vertical
        gap: md
        className: "w-full"
        children: [{
          type: stack
          direction: horizontal
          gap: md
          align: center
          children: [
            (if @config.showArrows { type: button, variant: ghost, size: lg, icon: @config.prevIcon, aria-label: "Previous slide", action: GO_TO, actionPayload: { index: (if @config.loop (math/wrap (- @entity.slideIndex 1) 0 (array/len @config.slides)) (math/max 0 (- @entity.slideIndex 1))) }, disabled: (and (== @config.loop false) (<= @entity.slideIndex 0)) } null),
            { type: center, className: "flex-1 min-w-0", minHeight: @config.stageMinHeight, children: (array/map [@entity.slideIndex] (fn i { type: box, className: "w-full", children: [(if (>= @i 0) (array/nth @config.slides @i) null)] })) },
            (if @config.showArrows { type: button, variant: ghost, size: lg, icon: @config.nextIcon, aria-label: "Next slide", action: GO_TO, actionPayload: { index: (if @config.loop (math/wrap (+ @entity.slideIndex 1) 0 (array/len @config.slides)) (math/min (- (array/len @config.slides) 1) (+ @entity.slideIndex 1))) }, disabled: (and (== @config.loop false) (>= @entity.slideIndex (- (array/len @config.slides) 1))) } null)
          ]
        }, (if @config.showProgress {
          type: stack
          direction: horizontal
          gap: md
          align: center
          justify: center
          children: (array/map [(array/len @config.slides)] (fn n {
            type: stack
            direction: horizontal
            gap: md
            align: center
            children: [
              { type: progress-dots, count: @n, currentIndex: @entity.slideIndex, onDotClick: GO_TO, size: sm },
              { type: typography, variant: caption, color: muted, content: (str/concat "" (+ @entity.slideIndex 1) " / " @n) }
            ]
          }))
        } null)]
      }
        @label "Body content tree"
        @description "Render-ui tree for the deck. Default: slide centred between previous/next arrows, dot strip and counter below. A realization overrides this to restyle (full-bleed, bottom bar, no chrome) while keeping the same cursor, keys and emits."
        @tier "internal"
    }
  }

  page "/slide-deck" as SlideDeckPage -> SlideDeckPresenter
}
