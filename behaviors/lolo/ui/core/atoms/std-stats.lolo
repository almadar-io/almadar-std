app std-stats [
  version: "3.2.0",
  description: "std-stats — embeddable analytics-card atom. ITEMS_LOADED aggregates @payload.data per @config.metrics (count|sum|avg|min|max|variance with optional where, baselineWhere (typed MetricWhere AND lists: = != < <= > >= against value/bound or another column via otherField, `in` over values, relative windows within / older-than / older-than-ms over days), format, icon, max, target, trend, trendPolarity, sparkline) and renders one stat-display per entry. Variance metrics compute actual - baseline using the `where` and `baselineWhere` row conditions and report the signed delta as trend. clickEvent emits UI:{clickEvent} { metricLabel } when a card is clicked. Drop into a dashboard alongside std-browse / std-search / std-filter. `config.statsLook` switches the whole body between the default per-metric card grid ('cards'), a Stripe-dashboard KPI tile row ('kpi-tiles'), a single hero metric card ('hero-metric'), and a chart-first sparkline tile grid ('sparkline-row')."
]
orbital StatsItemOrbital {
    type StatsNumber = number
    type StatsInstant = instant
    type StatsDate = date
    type MetricWhere = MetricWhereLt | MetricWhereLe | MetricWhereGt | MetricWhereGe | MetricWhereEq | MetricWhereNe | MetricWhereIn | MetricWhereWithin | MetricWhereOlderThan | MetricWhereOlderThanMs
    type MetricWhereLt = { op : "<"!, kind : "number" | "instant"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, value : string, bound : number, otherField : field (@entity @config.rowEntity) (string | number | boolean) }
    type MetricWhereLe = { op : "<="!, kind : "number" | "instant"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, value : string, bound : number, otherField : field (@entity @config.rowEntity) (string | number | boolean) }
    type MetricWhereGt = { op : ">"!, kind : "number" | "instant"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, value : string, bound : number, otherField : field (@entity @config.rowEntity) (string | number | boolean) }
    type MetricWhereGe = { op : ">="!, kind : "number" | "instant"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, value : string, bound : number, otherField : field (@entity @config.rowEntity) (string | number | boolean) }
    type MetricWhereEq = { op : "="!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, value : string | number | boolean, otherField : field (@entity @config.rowEntity) (string | number | boolean) }
    type MetricWhereNe = { op : "!="!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, value : string | number | boolean, otherField : field (@entity @config.rowEntity) (string | number | boolean) }
    type MetricWhereIn = { op : "in"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, values : [string] }
    type MetricWhereWithin = { op : "within"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, days : number }
    type MetricWhereOlderThan = { op : "older-than"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, days : number }
    type MetricWhereOlderThanMs = { op : "older-than-ms"!, field : field (@entity @config.rowEntity) (string | number | boolean | date | datetime)!, days : number }
    type StatCard = { label : string!, position : number, value : number, icon : string, format : "number" | "currency" | "percent", variant : "default" | "primary" | "success" | "warning" | "error" | "info", prefix : string, suffix : string, max : number, target : number, trend : number?, trendPolarity : "higher-is-better" | "lower-is-better", trendFormat : "absolute" | "percent", sparklineData : [number], clickEvent : string }

  ;; Author-side metric definition. Superset of StatCard with the
  ;; aggregation knobs (aggregation/field) the trait consumes on
  ;; ITEMS_LOADED to compute `value` from @payload.data.
  ;; `where` / `baselineWhere` are AND lists of MetricWhere row conditions:
  ;; `=`/`!=` compare against `value`. Ordering ops (`<` `<=` `>` `>=`) must
  ;; state `kind`: "number" compares the row value to `bound`, "instant"
  ;; compares an ISO instant row value to the instant text in `value`; with
  ;; `otherField` set either kind compares against that column of the same
  ;; row instead. A row value that is not of the clause's kind makes the
  ;; clause false; an ordering clause without `kind` is false for every row. `in` matches when the field equals one of
  ;; `values`. Relative windows read `days`: `within` keeps rows whose ISO
  ;; date/datetime field is at or after now minus `days` days, `older-than`
  ;; keeps those strictly before it (days 0 = already past), and
  ;; `older-than-ms` is `older-than` for epoch-millisecond number fields.
  ;; Two conditions on one field give a window (older-than 30 + within 60).
  ;; An empty or missing list counts every row.
    type MetricSpec = { label : string!, value : number, icon : string, format : "number" | "currency" | "percent", variant : "default" | "primary" | "success" | "warning" | "error" | "info", prefix : string, suffix : string, max : number, target : number, trend : number, trendPolarity : "higher-is-better" | "lower-is-better", trendFormat : "absolute" | "percent", sparklineData : [number], clickEvent : string, aggregation : "count" | "sum" | "avg" | "min" | "max" | "variance", field : field (@entity @config.rowEntity) number, where : [MetricWhere], baselineWhere : [MetricWhere] }

  entity StatsRow [runtime] {
    id : string!
    label : string
    value : number
  }

  entity StatsItem [runtime] {
    id : string!
    cards : [StatCard] @intrinsic @description "A collection of statistical cards to display." @synonyms "statistics, items, displays" = []
  }

  trait StatsItemStats -> @rebindable StatsItem   [client]{
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.cards (array/map @config.metrics (fn metric {
          clickEvent: (object/get @metric clickEvent "")
          format: (object/get @metric format number)
          icon: (object/get @metric icon "")
          label: (object/get @metric label)
          position: @index
          max: (object/get @metric max 0)
          prefix: (object/get @metric prefix "")
          sparklineData: (object/get @metric sparklineData [])
          suffix: (object/get @metric suffix "")
          target: (object/get @metric target 0)
          trend: (object/get @metric trend)
          trendFormat: (object/get @metric trendFormat absolute)
          trendPolarity: (object/get @metric trendPolarity higher-is-better)
          value: (object/get @metric value 0)
          variant: (object/get @metric variant default)
        })))
        (if (= @config.statsLook kpi-tiles)
          (render-ui main @config.kpiTilesBodyContent)
          (if (= @config.statsLook hero-metric)
            (render-ui main @config.heroMetricBodyContent)
            (if (= @config.statsLook sparkline-row)
              (render-ui main @config.sparklineRowBodyContent)
              (render-ui main @config.bodyContent))))
      ;; Pre-seed cards from @config.metrics so the atom renders a
      ;; visible skeleton on initial mount even before any upstream
      ;; ITEMS_LOADED fires. If a metric defines a static `value`,
      ;; honor it (useful for default / standalone previews); otherwise
      ;; render 0 until ITEMS_LOADED recomputes.
      ITEMS_LOADED -> idle
        (set @entity.cards (array/map @config.metrics (fn metric (let ((rows (array/filter ?data (fn row (array/every (object/get @metric where []) (fn w (let ((v (object/get @row @w.field))) (if (= @w.op "in") (and (validate/required @w.values) (validate/string @v) (array/includes @w.values @v)) (if (= @w.op "within") (and (validate/required @w.days) (let ((i (as @v StatsInstant)) (d (as @v StatsDate))) (if (!= @i null) (<= (time/diff (time/now) @i) (* @w.days 86400000)) (if (!= @d null) (let ((dt (as (str/concat @d "T00:00:00Z") StatsInstant))) (and (!= @dt null) (<= (time/diff (time/now) @dt) (* @w.days 86400000)))) false)))) (if (= @w.op "older-than") (and (validate/required @w.days) (let ((i (as @v StatsInstant)) (d (as @v StatsDate))) (if (!= @i null) (> (time/diff (time/now) @i) (* @w.days 86400000)) (if (!= @d null) (let ((dt (as (str/concat @d "T00:00:00Z") StatsInstant))) (and (!= @dt null) (> (time/diff (time/now) @dt) (* @w.days 86400000)))) false)))) (if (= @w.op "older-than-ms") (and (validate/required @w.days) (let ((n (as @v StatsNumber))) (and (!= @n null) (< @n (- (let ((epoch : StatsInstant "1970-01-01T00:00:00Z")) (time/diff @now @epoch "ms")) (* @w.days 86400000)))))) (if (= @w.op "=") (if (validate/required @w.otherField) (= @v (object/get @row @w.otherField)) (= @v @w.value)) (if (= @w.op "!=") (if (validate/required @w.otherField) (!= @v (object/get @row @w.otherField)) (!= @v @w.value)) (if (= @w.op "<") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (< @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (< (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (< @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (< (time/diff @a @b) 0))))) (if (= @w.op "<=") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (<= @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (<= (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (<= @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (<= (time/diff @a @b) 0))))) (if (= @w.op ">") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (> @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (> (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (> @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (> (time/diff @a @b) 0))))) (if (= @w.op ">=") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (>= @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (>= (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (>= @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (>= (time/diff @a @b) 0))))) false)))))))))))))))) (baseRows (array/filter ?data (fn row (array/every (object/get @metric baselineWhere []) (fn w (let ((v (object/get @row @w.field))) (if (= @w.op "in") (and (validate/required @w.values) (validate/string @v) (array/includes @w.values @v)) (if (= @w.op "within") (and (validate/required @w.days) (let ((i (as @v StatsInstant)) (d (as @v StatsDate))) (if (!= @i null) (<= (time/diff (time/now) @i) (* @w.days 86400000)) (if (!= @d null) (let ((dt (as (str/concat @d "T00:00:00Z") StatsInstant))) (and (!= @dt null) (<= (time/diff (time/now) @dt) (* @w.days 86400000)))) false)))) (if (= @w.op "older-than") (and (validate/required @w.days) (let ((i (as @v StatsInstant)) (d (as @v StatsDate))) (if (!= @i null) (> (time/diff (time/now) @i) (* @w.days 86400000)) (if (!= @d null) (let ((dt (as (str/concat @d "T00:00:00Z") StatsInstant))) (and (!= @dt null) (> (time/diff (time/now) @dt) (* @w.days 86400000)))) false)))) (if (= @w.op "older-than-ms") (and (validate/required @w.days) (let ((n (as @v StatsNumber))) (and (!= @n null) (< @n (- (let ((epoch : StatsInstant "1970-01-01T00:00:00Z")) (time/diff @now @epoch "ms")) (* @w.days 86400000)))))) (if (= @w.op "=") (if (validate/required @w.otherField) (= @v (object/get @row @w.otherField)) (= @v @w.value)) (if (= @w.op "!=") (if (validate/required @w.otherField) (!= @v (object/get @row @w.otherField)) (!= @v @w.value)) (if (= @w.op "<") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (< @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (< (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (< @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (< (time/diff @a @b) 0))))) (if (= @w.op "<=") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (<= @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (<= (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (<= @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (<= (time/diff @a @b) 0))))) (if (= @w.op ">") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (> @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (> (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (> @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (> (time/diff @a @b) 0))))) (if (= @w.op ">=") (if (validate/required @w.otherField) (let ((o (object/get @row @w.otherField))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @o StatsNumber))) (and (!= @a null) (!= @b null) (>= @a @b))) (let ((a (as @v StatsInstant)) (b (as @o StatsInstant))) (and (!= @a null) (!= @b null) (>= (time/diff @a @b) 0))))) (if (= @w.kind "number") (let ((a (as @v StatsNumber)) (b (as @w.bound StatsNumber))) (and (!= @a null) (!= @b null) (>= @a @b))) (let ((a (as @v StatsInstant)) (b (as @w.value StatsInstant))) (and (!= @a null) (!= @b null) (>= (time/diff @a @b) 0))))) false))))))))))))))))) {
          clickEvent: (object/get @metric clickEvent "")
          format: (object/get @metric format number)
          icon: (object/get @metric icon "")
          label: (object/get @metric label)
          position: @index
          max: (object/get @metric max 0)
          prefix: (object/get @metric prefix "")
          sparklineData: (object/get @metric sparklineData [])
          suffix: (object/get @metric suffix "")
          target: (object/get @metric target 0)
          trend: (if (= (object/get @metric aggregation count) variance) (- (if (!= @metric.field null) (array/sum @rows @metric.field) 0) (if (!= @metric.field null) (array/sum @baseRows @metric.field) 0)) (object/get @metric trend))
          trendFormat: (object/get @metric trendFormat absolute)
          trendPolarity: (object/get @metric trendPolarity higher-is-better)
          value: (if (= (object/get @metric aggregation count) sum) (if (!= @metric.field null) (array/sum @rows @metric.field) 0) (if (= (object/get @metric aggregation count) avg) (if (!= @metric.field null) (array/avg @rows @metric.field) 0) (if (= (object/get @metric aggregation count) min) (if (!= @metric.field null) (array/min @rows @metric.field) 0) (if (= (object/get @metric aggregation count) max) (if (!= @metric.field null) (array/max @rows @metric.field) 0) (if (= (object/get @metric aggregation count) variance) (if (!= @metric.field null) (array/sum @rows @metric.field) 0) (array/len @rows))))))
          variant: (object/get @metric variant default)
        }))))
        (if (= @config.statsLook kpi-tiles)
          (render-ui main @config.kpiTilesBodyContent)
          (if (= @config.statsLook hero-metric)
            (render-ui main @config.heroMetricBodyContent)
            (if (= @config.statsLook sparkline-row)
              (render-ui main @config.sparklineRowBodyContent)
              (render-ui main @config.bodyContent))))
    }

    listens {
      ITEMS_LOADED {
        data : [@entity @config.rowEntity]!
        totalCount : number
      }
        @description "Data has been loaded and is ready for processing."
        @synonyms "data ready, update, refresh, loaded"
        @tier "domain"
    }

    config {
      rowEntity : entity = StatsRow
        @label "Row entity"
        @description "The entity whose rows ITEMS_LOADED delivers; every metric's `field`, `where` and `baselineWhere` names a column of it."
        @tier "internal"
      metricLabels : [string] = []
        @label "Metric labels"
        @description "In metric order: the label shown on each card, in place of its `metrics` label (render-only, so it may be translated)"
        @tier "presentation"
      metrics : [MetricSpec] = [{
        aggregation: count
        format: number
        icon: list
        label: "Total Items"
        sparklineData: [2, 4, 3, 6, 5, 8, 7]
        variant: primary
      }, {
        aggregation: count
        format: number
        icon: check-circle
        label: Active
        sparklineData: [1, 3, 2, 4, 6, 5, 7]
        variant: success
      }, {
        aggregation: avg
        field: value
        format: number
        icon: trending-up
        label: "Avg Value"
        sparklineData: [5, 4, 6, 3, 5, 7, 6]
        variant: info
      }]
        @label "Metrics"
        @description "One stat card per entry; declares aggregation, format, and styling"
        @synonyms "list of KPI cards / stat tiles / metric cards. each entry has label / value / format / icon / variant / aggregation. user phrases: 'replace metrics with X, Y, Z' -> rewrite array; 'add Revenue tile' -> append entry; 'change KPIs to X' -> rewrite array"
        @tier "presentation"
      title : string = ""
        @label "Section title"
        @description "Heading shown above the stat-card grid"
        @synonyms "the section header text. user phrases: 'rename section to X' / 'title the KPIs X' / 'change section title to X' -> X"
        @tier "presentation"
      theme : string = ""
        @label "Theme"
        @description "Data-theme skin applied to the stat body root — for chrome-less pages composed without an AppShell."
        @tier "presentation"
      viewPattern : pattern = data-grid
        @label "Render pattern"
        @description "UI pattern used to arrange the stat cards"
        @synonyms "internal pattern selector. user prompts rarely target this directly"
        @tier "internal"
      statLook : "elevated" | "flat" | "progress-backed" | "gauge" | "sparkline" = elevated
        @label "Stat display look"
        @description "Layer 2 visual treatment for stat / KPI cards."
        @tier "presentation"
      statsLook : "cards" | "kpi-tiles" | "hero-metric" | "sparkline-row" = cards
        @label "Stats look"
        @description "Layer 3 body layout: default per-metric stat-card grid ('cards'), Stripe-dashboard KPI tile row ('kpi-tiles'), single oversize hero number ('hero-metric'), or chart-first sparkline tile grid ('sparkline-row')."
        @tier "presentation"
      bodyContent : render-ui = { data-theme: @config.theme, type: box, children: [(if (!= @config.title "") { content: @config.title, type: typography, variant: h3 } { children: [], gap: none, type: stack }), {
        entity: @entity.cards
        fields: []
        renderItem: (fn card {
          clickEvent: @card.clickEvent
          format: @card.format
          icon: @card.icon
          label: (if (= (array/len @config.metricLabels) 0) @card.label (array/nth @config.metricLabels @card.position))
          look: @config.statLook
          max: @card.max
          prefix: @card.prefix
          sparklineData: @card.sparklineData
          suffix: @card.suffix
          target: @card.target
          trend: @card.trend
          trendFormat: @card.trendFormat
          trendPolarity: @card.trendPolarity
          type: stat-display
          value: @card.value
          variant: @card.variant
        })
        type: @config.viewPattern
      }] }
        @label "Body content tree"
        @description "Render-ui SExpr rendered after metrics aggregate for statsLook='cards' — the canonical data-grid call mapping @entity.cards through stat-display. Other statsLook values render kpiTilesBodyContent / heroMetricBodyContent / sparklineRowBodyContent instead; all four share this trait's state machine, aggregation pipeline, and listens."
        @tier "internal"
      kpiTilesBodyContent : render-ui = { data-theme: @config.theme, type: box, children: [(if (!= @config.title "") { content: @config.title, type: typography, variant: h3 } { children: [], gap: none, type: stack }), {
        className: w-full
        entity: @entity.cards
        fields: []
        gap: lg
        minCardWidth: 220
        renderItem: (fn card {
          children: [{
            align: center
            children: [{
              className: "uppercase tracking-wide"
              color: muted
              content: (if (= (array/len @config.metricLabels) 0) @card.label (array/nth @config.metricLabels @card.position))
              type: typography
              variant: caption
              weight: medium
            }, {
              color: muted
              name: @card.icon
              size: sm
              type: icon
            }]
            direction: horizontal
            gap: xs
            justify: between
            type: stack
          }, {
            align: baseline
            children: [{
              color: muted
              content: @card.prefix
              type: typography
              variant: caption
            }, {
              className: "text-4xl font-bold tracking-tight"
              format: @card.format
              type: animated-counter
              value: @card.value
            }, {
              color: muted
              content: @card.suffix
              type: typography
              variant: caption
            }]
            direction: horizontal
            gap: xs
            type: stack
          }, {
            align: center
            children: [{
              showValue: true
              size: sm
              type: trend-indicator
              value: @card.trend
            }, {
              className: flex-1
              color: auto
              data: @card.sparklineData
              fill: true
              height: 24
              type: sparkline
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          className: "rounded-lg border border-[var(--color-border)] bg-[var(--color-surface)] p-card-lg shadow-elevation-sm hover:shadow-elevation-md transition-shadow"
          direction: vertical
          gap: sm
          type: stack
        })
        type: data-grid
      }] }
        @label "KPI tiles body content tree"
        @description "Render-ui SExpr for statsLook='kpi-tiles' — Stripe-dashboard style tile grid: huge typography number, label, trend indicator, sparkline hint."
        @tier "internal"
      heroMetricBodyContent : render-ui = { data-theme: @config.theme, type: box, children: [(if (!= @config.title "") { content: @config.title, type: typography, variant: h3 } { children: [], gap: none, type: stack }), {
        entity: @entity.cards
        fields: []
        gap: none
        renderItem: (fn card {
          children: [{
            children: [{
              align: center
              children: [{
                align: center
                children: [{
                  color: muted
                  name: @card.icon
                  size: md
                  type: icon
                }, {
                  className: "uppercase tracking-widest"
                  color: muted
                  content: (if (= (array/len @config.metricLabels) 0) @card.label (array/nth @config.metricLabels @card.position))
                  type: typography
                  variant: overline
                  weight: bold
                }]
                direction: horizontal
                gap: sm
                justify: center
                type: stack
              }, {
                align: baseline
                children: [{
                  color: muted
                  content: @card.prefix
                  type: typography
                  variant: h2
                  weight: normal
                }, {
                  className: "text-7xl md:text-8xl font-bold tracking-tighter tabular-nums text-[var(--color-foreground)]"
                  format: @card.format
                  type: animated-counter
                  value: @card.value
                }, {
                  color: muted
                  content: @card.suffix
                  type: typography
                  variant: h2
                  weight: normal
                }]
                className: py-section
                direction: horizontal
                gap: xs
                justify: center
                type: stack
              }, {
                showValue: true
                size: md
                type: trend-indicator
                value: @card.trend
              }]
              className: "relative z-10 w-full max-w-2xl mx-auto text-center"
              direction: vertical
              gap: md
              type: stack
            }, {
              className: "absolute inset-x-0 bottom-0 w-full opacity-10 pointer-events-none"
              color: auto
              data: @card.sparklineData
              fill: true
              height: 96
              strokeWidth: 1
              type: sparkline
            }]
            look: elevated
            padding: lg
            type: "card"
          }]
          className: "relative w-full rounded-xl shadow-lg overflow-hidden"
          direction: vertical
          gap: none
          type: stack
        })
        type: data-list
      }] }
        @label "Hero metric body content tree"
        @description "Render-ui SExpr for statsLook='hero-metric' — one elevated card, one oversize number, background sparkline."
        @tier "internal"
      sparklineRowBodyContent : render-ui = { data-theme: @config.theme, type: box, children: [(if (!= @config.title "") { content: @config.title, type: typography, variant: h3 } { children: [], gap: none, type: stack }), {
        className: w-full
        entity: @entity.cards
        fields: []
        gap: md
        minCardWidth: 260
        renderItem: (fn card {
          children: [{
            align: center
            children: [{
              color: muted
              name: @card.icon
              size: xs
              type: icon
            }, {
              className: "uppercase tracking-wide truncate"
              color: muted
              content: (if (= (array/len @config.metricLabels) 0) @card.label (array/nth @config.metricLabels @card.position))
              type: typography
              variant: overline
              weight: semibold
            }]
            direction: horizontal
            gap: xs
            type: stack
          }, {
            className: w-full
            color: auto
            data: @card.sparklineData
            fill: true
            height: 64
            strokeWidth: 2
            type: sparkline
          }, {
            align: baseline
            children: [{
              align: baseline
              children: [{
                color: muted
                content: @card.prefix
                type: typography
                variant: caption
              }, {
                className: "text-2xl font-semibold tabular-nums"
                format: @card.format
                type: animated-counter
                value: @card.value
              }, {
                color: muted
                content: @card.suffix
                type: typography
                variant: caption
              }]
              direction: horizontal
              gap: xs
              type: stack
            }, {
              showValue: true
              size: sm
              type: trend-indicator
              value: @card.trend
            }]
            direction: horizontal
            gap: sm
            justify: between
            type: stack
          }]
          className: "surface-content p-card-md hover:shadow-elevation-dialog transition-shadow min-h-[180px]"
          direction: vertical
          gap: sm
          type: stack
        })
        type: data-grid
      }] }
        @label "Sparkline row body content tree"
        @description "Render-ui SExpr for statsLook='sparkline-row' — chart-first tiles where the mini trend line is the visual centerpiece, label above, value+delta footer."
        @tier "internal"
    }
  }

  ;; Variance is computed as actual - baseline using `where` + `baselineWhere`.
  ;; For variance, `trend` carries the signed delta (StatDisplay renders it as ↑/↓ with
  ;; success/error coloring based on trendPolarity). For other aggregations, `trend`
  ;; falls back to the metric's authored value (defaults to 0).
  page "/statsitems" as StatsItemStatsPage -> StatsItemStats
}