app std-tag-taxonomy "1.1.0"
"std-tag-taxonomy — hierarchical category tag tree (parent/child). TagBrowse fetches root-level Tag rows (parentId = \"\") on INIT and renders the active level via data-grid; SELECT_TAG drills into the chosen tag's children by fetching rows whose parentId matches it, binding @entity.id to that parent so the level is remembered; SHOW_ROOT resets back to the root level, surfaced as a back affordance while drilled in. Flat taxonomies (all parentId \"\") render exactly one level, unchanged. TagSelected is emitted on selection for consumers to filter content by tag."
orbital TagTaxonomyOrbital {
    type TagLoaded = Event { data : [Tag] } "Fired when the tag collection finishes loading"

    type TagLoadFailed = Event { error : string, code : string } "Fired when the tag collection fails to load"

    type TagSelected = Event { tagId : string! } "Fired when a tag is selected to drill into its children"

    type TagCommit = { name : string!, parentId : string }

  entity Tag [persistent: tags] {
    id : string!
    name : string! @description "The descriptive label for this item." @synonyms "label, title, description"
    parentId : Tag @description "Reference to the parent tag in the hierarchy; empty marks a root." @synonyms "parent, superior, ancestor"
    slug : string @description "A unique, URL-friendly identifier." @synonyms "identifier, key, code"
    color : string @description "A visual identifier, often used for categorization." @synonyms "hue, shade, tint, category color"
    count : number @description "The number of items associated with this entry." @synonyms "quantity, total, size, amount" = 0
    createdAt : string
  }

  trait TagBrowse -> Tag [interaction, collection] {
    initial: loading

    state loading {
      LEVEL_RELOAD -> loading
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), (str/default ?tagId "")]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
      INIT -> loading
        (set @entity.id "")
        (set @entity.parentId "")
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), ""]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      TagLoaded -> browsing
        (render-ui main {
          children: [{
            action: SHOW_ROOT
            disabled: (if (!= @entity.id "") false true)
            icon: arrow-left
            label: "All categories"
            size: sm
            type: button
            variant: ghost
          }, {
            content: @config.title
            type: typography
            variant: h3
          }, (if @config.allowEdit {
            action: NEW_TAG
            icon: plus
            label: "New category"
            size: sm
            type: button
            variant: secondary
          } null), {
            entity: ?data
            fields: []
            gap: sm
            minCardWidth: 180
            renderItem: (fn tag {
              children: [{
                children: [{
                  align: center
                  children: [{
                    align: center
                    children: [{
                      name: "tag"
                      size: sm
                      type: icon
                    }, {
                      className: truncate
                      content: @tag.name
                      type: typography
                      variant: body
                      weight: medium
                    }]
                    className: min-w-0
                    direction: horizontal
                    gap: sm
                    type: stack
                  }, {
                    label: @tag.count
                    size: sm
                    type: badge
                    variant: neutral
                  }]
                  direction: horizontal
                  gap: sm
                  justify: between
                  type: stack
                }, {
                  action: SELECT_TAG
                  actionPayload: { tagId: @tag.id }
                  className: "w-full justify-center"
                  icon: chevron-right
                  label: Open
                  size: sm
                  type: button
                  variant: ghost
                }]
                direction: vertical
                gap: xs
                type: stack
              }]
              className: "cursor-pointer hover:shadow-md transition-shadow"
              look: flat-bordered
              padding: sm
              type: card
            })
            type: data-grid
          }]
          direction: vertical
          gap: md
          type: stack
        })
      TagLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
    }

    state browsing {
      INIT -> loading
        (set @entity.id "")
        (set @entity.parentId "")
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), ""]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SELECT_TAG -> editing
        (set @entity.id ?tagId)
        (set @entity.parentId ?tagId)
        (emit TagSelected { tagId: ?tagId })
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), ?tagId]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading children…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SHOW_ROOT -> loading
        (set @entity.id "")
        (set @entity.parentId "")
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), ""]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      TagLoaded -> browsing
        (render-ui main {
          children: [{
            action: SHOW_ROOT
            disabled: (if (!= @entity.id "") false true)
            icon: arrow-left
            label: "All categories"
            size: sm
            type: button
            variant: ghost
          }, {
            content: @config.title
            type: typography
            variant: h3
          }, (if @config.allowEdit {
            action: NEW_TAG
            icon: plus
            label: "New category"
            size: sm
            type: button
            variant: secondary
          } null), {
            entity: ?data
            fields: []
            gap: sm
            minCardWidth: 180
            renderItem: (fn tag {
              children: [{
                children: [{
                  align: center
                  children: [{
                    align: center
                    children: [{
                      name: "tag"
                      size: sm
                      type: icon
                    }, {
                      className: truncate
                      content: @tag.name
                      type: typography
                      variant: body
                      weight: medium
                    }]
                    className: min-w-0
                    direction: horizontal
                    gap: sm
                    type: stack
                  }, {
                    label: @tag.count
                    size: sm
                    type: badge
                    variant: neutral
                  }]
                  direction: horizontal
                  gap: sm
                  justify: between
                  type: stack
                }, {
                  action: SELECT_TAG
                  actionPayload: { tagId: @tag.id }
                  className: "w-full justify-center"
                  icon: chevron-right
                  label: Open
                  size: sm
                  type: button
                  variant: ghost
                }]
                direction: vertical
                gap: xs
                type: stack
              }]
              className: "cursor-pointer hover:shadow-md transition-shadow"
              look: flat-bordered
              padding: sm
              type: card
            })
            type: data-grid
          }]
          direction: vertical
          gap: md
          type: stack
        })
      NEW_TAG -> creating when @config.allowEdit
        (render-ui modal {
          children: [{
            content: "New category"
            type: typography
            variant: h3
          }, {
            color: muted
            content: (if (!= @entity.id "") "Created inside the open category." "Created at the top level.")
            type: typography
            variant: caption
          }, { type: divider }, {
            cancelEvent: CANCEL_TAG
            entity: { parentId: @entity.id }
            fields: (name)
            mode: create
            submitEvent: COMMIT_TAG
            type: form-section
          }]
          direction: vertical
          gap: md
          type: stack
        })
      TagLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
    }

    state creating {
      COMMIT_TAG -> creating
        (persist create Tag {
          name: (object/get ?data name)
          parentId: (str/default (object/get ?data parentId) "")
        } {
          emit: { failure: TagCreateFailed, success: TagCreated }
        })
      ;; A filter expression binds @entity to the candidate ROW, so the open
      ;; level must travel by payload: the arm emits LEVEL_RELOAD carrying the
      ;; trait's own level id, and loading refetches from it.
      CANCEL_TAG -> loading
        (render-ui modal null)
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
        (emit LEVEL_RELOAD { tagId: @entity.id })
      ;; Refetch the level the new tag landed on — its own parentId names it.
      TagCreated -> loading
        (render-ui modal null)
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), (str/default (object/get ?row parentId) "")]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
      TagCreateFailed -> creating
        (render-ui modal {
          message: ?error
          type: alert
          variant: error
        })
    }

    state editing {
      INIT -> loading
        (set @entity.id "")
        (set @entity.parentId "")
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), ""]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SELECT_TAG -> editing
        (set @entity.id ?tagId)
        (set @entity.parentId ?tagId)
        (emit TagSelected { tagId: ?tagId })
      TagSelected -> editing
        (set @entity.id ?tagId)
        (set @entity.parentId ?tagId)
      TagLoaded -> browsing
        (render-ui main {
          children: [{
            action: SHOW_ROOT
            disabled: (if (!= @entity.id "") false true)
            icon: arrow-left
            label: "All categories"
            size: sm
            type: button
            variant: ghost
          }, {
            content: @config.title
            type: typography
            variant: h3
          }, (if @config.allowEdit {
            action: NEW_TAG
            icon: plus
            label: "New category"
            size: sm
            type: button
            variant: secondary
          } null), {
            entity: ?data
            fields: []
            gap: sm
            minCardWidth: 180
            renderItem: (fn tag {
              children: [{
                children: [{
                  align: center
                  children: [{
                    align: center
                    children: [{
                      name: "tag"
                      size: sm
                      type: icon
                    }, {
                      className: truncate
                      content: @tag.name
                      type: typography
                      variant: body
                      weight: medium
                    }]
                    className: min-w-0
                    direction: horizontal
                    gap: sm
                    type: stack
                  }, {
                    label: @tag.count
                    size: sm
                    type: badge
                    variant: neutral
                  }]
                  direction: horizontal
                  gap: sm
                  justify: between
                  type: stack
                }, {
                  action: SELECT_TAG
                  actionPayload: { tagId: @tag.id }
                  className: "w-full justify-center"
                  icon: chevron-right
                  label: Open
                  size: sm
                  type: button
                  variant: ghost
                }]
                direction: vertical
                gap: xs
                type: stack
              }]
              className: "cursor-pointer hover:shadow-md transition-shadow"
              look: flat-bordered
              padding: sm
              type: card
            })
            type: data-grid
          }]
          direction: vertical
          gap: md
          type: stack
        })
      TagLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
    }

    state error {
      INIT -> loading
        (set @entity.id "")
        (set @entity.parentId "")
        (fetch Tag {
          filter: ["=", (object/get @entity parentId), ""]
          emit: { failure: TagLoadFailed, success: TagLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading categories…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    emits {
      SELECT_TAG {
        tagId : string!
      }
        @description "Signals a tag has been chosen for navigation."
        @synonyms "choose, pick, activate, navigate"
        @tier "domain"
      TagLoaded {
        data : [Tag]
      }
        @description "Signals that the tag data has been successfully retrieved."
        @synonyms "loaded, fetched, received, ready"
        @tier "domain"
      TagLoadFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load tag data."
        @synonyms "error, failed, problem, issue"
        @tier "internal"
      TagSelected {
        tagId : string!
      }
        @description "Signals a tag has been chosen for further exploration."
        @synonyms "chosen, picked, activated, highlighted"
        @tier "domain"
      NEW_TAG
        @description "Opens the new-category form (rendered only when allowEdit is on); the creation lands at the level currently open."
        @synonyms "add tag, create category, new category"
        @tier "domain"
      COMMIT_TAG {
        data : TagCommit
      }
        @description "The new-category form committed; data carries the name and the parent level."
        @synonyms "save tag, create tag"
        @tier "internal"
      CANCEL_TAG
        @description "The new-category form was dismissed without creating."
        @synonyms "cancel, back"
        @tier "internal"
      LEVEL_RELOAD {
        tagId : string
      }
        @description "Internal hop that refetches the open level after the new-category form closes (a fetch filter cannot read trait state, so the level travels by payload)."
        @synonyms "reload level, refresh"
        @tier "internal"
      TagCreated {
        row : Tag
      }
        @description "A new tag row persisted; the open level refetches to show it."
        @synonyms "created, added"
        @tier "internal"
      TagCreateFailed {
        error : string
        code : string
      }
        @description "The tag create failed."
        @synonyms "error, failure"
        @tier "internal"
    }

    listens {
      SELECT_TAG {
        tagId : string!
      }
        @description "A tag in the taxonomy was selected for navigation."
        @synonyms "choose, pick, activate, navigate"
        @tier "domain"
      TagLoaded {
        data : [Tag]
      }
        @description "Indicates tag data has been successfully retrieved."
        @synonyms "loaded, fetched, received"
        @tier "domain"
      TagLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load tag data."
        @synonyms "error, failure, load failed"
        @tier "internal"
      TagSelected {
        tagId : string!
      }
        @description "A tag in the taxonomy has been chosen by the user."
        @synonyms "chosen, picked, activated, selected"
        @tier "domain"
      NEW_TAG
        @description "The New-category affordance was clicked."
        @synonyms "add tag, create category"
        @tier "domain"
      COMMIT_TAG {
        data : TagCommit
      }
        @description "The new-category form committed."
        @synonyms "save tag, create tag"
        @tier "internal"
      CANCEL_TAG
        @description "The new-category form was dismissed."
        @synonyms "cancel, back"
        @tier "internal"
      LEVEL_RELOAD {
        tagId : string
      }
        @description "Refetch the open level."
        @synonyms "reload level, refresh"
        @tier "internal"
      TagCreated {
        row : Tag
      }
        @description "A new tag row persisted."
        @synonyms "created, added"
        @tier "internal"
      TagCreateFailed {
        error : string
        code : string
      }
        @description "The tag create failed."
        @synonyms "error, failure"
        @tier "internal"
    }

    config {
      title : string = Categories
        @label "Section title"
        @description "Heading shown above the tag tree"
        @tier "presentation"
      allowEdit : boolean = false
        @label "Allow editing"
        @description "Render the New-category affordance: creations land at the level currently open (top level, or inside the drilled-into category). Rename is a follow-up (ledgered)."
        @tier "domain"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
    }
  }

  page "/tags/browse" as TagBrowsePage -> TagBrowse
}