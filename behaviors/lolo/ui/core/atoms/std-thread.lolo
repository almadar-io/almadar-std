app std-thread [
  version: "1.3.0",
  description: "std-thread — forum-style nested replies with collapse. Owns ThreadPost (persistent). INIT fetches, scoped by @config.threadRootId when set (blank = every root, the default). The list holds top-level posts, each with its replies nested (one level). REPLY persists a child post under @payload.parentId in the same thread root, stamped with the real @user identity, and adds it to the parent's replies and replyCount. A consumer that mounts this as page comments forwards its own document-opened signal to SET_THREAD_ROOT { rootId }, which stamps @entity.replyRootId (scratch — the persisted threadRootId column is written only by the reply persist create) and refetches filtered by the payload; a plain INIT re-entry now also falls back through @entity.replyRootId before @config.threadRootId, so it stays scoped to the last SET_THREAD_ROOT instead of re-widening — only the after-create/after-select refetches still scope directly off their own event payload. Layer 3 variants override `bodyContent` to deliver chat-bubble, email-threaded, or linear-comments UX while inheriting the same trait, state machine, emits, and listens. A non-empty sectionTitle switches the default bodyContent into titled-comments mode: header + post list + a standalone composer button (without it an empty thread has no REPLY emitter at all — the affordance only existed per-row)."
]
type ItemAction = { label : string!, event : event, icon : string, roles : [string], when : SExpr }
orbital ThreadPostOrbital {
  uses RoleGate from "std/behaviors/std-role-gate"

  uses Button from "std/behaviors/ui-button"

  ;; Forward relation: array of child ThreadPost IDs whose parentId === this.id.
  ;; Lowers to `type: "relation", cardinality: "many"` (orbital-lolo lower.rs).
  ;; @rebindable rewrites the target to the rebound entity in variant atoms.
  ;; `(fetch ThreadPost { include: ["replies"] })` triggers @almadar/runtime's
  ;; populateRelations to hydrate each ID into the full row inline so the
  ;; variant's bodyContent can render `@reply.authorName` etc. without
  ;; per-reply lookups.
  ;; Master-detail focus: SELECT sets this to the clicked row so split-pane
  ;; variants (email-threaded) can bind @entity.focusedRow.<field> in their
  ;; detail pane. Unused by list/bubble variants.
    type ThreadPostLoaded = Event { data : [ThreadPost] } "Fired when the thread-post collection finishes loading"

    type ThreadPostLoadFailed = Event { error : string, code : string } "Fired when the thread-post collection fails to load"

    ;; Flat, not { row: … }: `persist create`'s success emit is the stored row
    ;; itself. Declared to the fields this atom reads back.
    type ThreadPostCreated = Event { id : string!, threadRootId : string!, parentId : string } "Fired after a new thread-post persists successfully"

    type ThreadPostCreateFailed = Event { error : string, code : string } "Fired when a new thread-post fails to persist"

    type ReplyParentLoaded = Event { data : ThreadPost! } "Fired when the post a new reply answers has loaded"

    type ReplyParentLoadFailed = Event { error : string } "Fired when the post a new reply answers cannot be loaded"

    type ReplyParentUpdated = Event ThreadPost "Fired after a new reply is added to its parent post's replies"

    type SetThreadRoot = Event { rootId : string! } "Fired to scope every ThreadPost fetch, and new-reply threadRootId stamping, to the descendants of one document root"

  entity ThreadPost [persistent: threadposts] {
    id : string!
    parentId : string @description "Identifier of the parent ThreadPost in a nested thread." @synonyms "parent, ancestor, source"
    threadRootId : string! @description "Identifier of the top-level thread this post belongs to." @synonyms "rootId, topLevelId, parentThreadId"
    authorId : string! @description "Unique identifier for the post's author." @synonyms "user id, creator id, author"
    authorName : string! @description "The name of the post's author." @synonyms "author, username, poster"
    content : string! @description "The main text content of the post." @synonyms "text, message, body"
    createdAt : string
    voteCount : number @description "The number of votes associated with this item." @synonyms "votes, rating, score" = 0
    replyCount : number @description "The number of replies to this post." @synonyms "count, number of replies, child posts" = 0
    replies : [ThreadPost] @description "A list of child ThreadPost entities." @synonyms "children, descendants, sub-posts"
    focusedRow : Map string scalar @intrinsic @description "The currently selected or active row within the thread." @synonyms "selection, active, current" = {}
    replyDraft : string @intrinsic @description "Reply text being composed." = ""
    replyParentId : string @intrinsic @description "Post the reply being composed answers." = ""
    replyRootId : string @intrinsic @description "Thread root the reply being composed belongs to." = ""
    lastReplyId : string @intrinsic @description "Reply just created, added to its parent post's replies." = ""
  }

  trait ThreadPostBrowse -> @rebindable ThreadPost [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", (str/default @entity.replyRootId @config.threadRootId), ""] ["=", (object/get @entity threadRootId), (str/default @entity.replyRootId @config.threadRootId)]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
      ThreadPostLoaded -> browsing
        (render-ui main @config.bodyContent)
      ThreadPostLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SET_THREAD_ROOT -> loading
        (set @entity.replyRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
    }

    state browsing {
      INIT -> loading
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", (str/default @entity.replyRootId @config.threadRootId), ""] ["=", (object/get @entity threadRootId), (str/default @entity.replyRootId @config.threadRootId)]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
      ThreadPostLoaded -> browsing
        (render-ui main @config.bodyContent)
      ;; Inline reply: when the event already carries the composed text (e.g.
      ;; reply-tree's inline composer), persist directly and stay in `browsing`
      ;; so the box stays inline instead of swapping to a full composer view.
      REPLY -> browsing when (not ["=", (str/default ?content ""), ""])
        (persist create ThreadPost {
          authorId: @user.id
          authorName: @user.name
          createdAt: @now
          content: ?content
          parentId: (str/default ?parentNodeId ?parentId)
          threadRootId: (str/default @entity.replyRootId (str/default @config.threadRootId root))
        } {
          emit: { failure: ThreadPostCreateFailed, success: ThreadPostCreated }
        })
      ;; Reply with no text yet (e.g. an email "Reply" button) opens the composer.
      REPLY -> replying when ["=", (str/default ?content ""), ""]
        (set @entity.replyParentId (str/default ?parentNodeId ?parentId))
        (render-ui main {
          children: [{
            content: "Write a reply"
            type: typography
            variant: h4
          }, {
            aria-label: "Your reply"
            onChange: EDIT_REPLY
            placeholder: "Your reply…"
            type: textarea
          }, {
            children: [{
              action: SUBMIT_REPLY
              icon: send
              label: Submit
              type: button
              variant: primary
            }, {
              action: CANCEL_REPLY
              label: Cancel
              type: button
              variant: secondary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      ;; Scoped to the row just created, not @config.threadRootId — a runtime-
      ;; scoped consumer (SET_THREAD_ROOT-driven, e.g. std-wiki's WikiComments)
      ;; never sets config.threadRootId, so that filter was permanently blank/
      ;; unfiltered here and every document's posts bled together on refetch.
      ;; ?threadRootId is the FLAT field on ThreadPostCreated's payload (the
      ;; row's own scope, per the create effect's fallback chain) — NOT
      ;; ?row.threadRootId; ThreadPostCreated's payload is the created row
      ;; itself (see the type alias above), no `row` wrapper exists.
      ThreadPostCreated -> browsing when (not ["=", (str/default ?parentId ""), ""])
        (set @entity.replyDraft "")
        (set @entity.replyParentId "")
        (set @entity.lastReplyId ?id)
        (fetch ThreadPost {
          id: ?parentId
          emit: { failure: ReplyParentLoadFailed, success: ReplyParentLoaded }
        })
      ThreadPostCreated -> browsing when ["=", (str/default ?parentId ""), ""]
        (set @entity.replyDraft "")
        (set @entity.replyParentId "")
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?threadRootId, ""] ["=", (object/get @entity threadRootId), ?threadRootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
      ReplyParentLoaded -> browsing
        (persist update ThreadPost {
          id: ?data.id
          replies: (array/append (object/get ?data replies []) @entity.lastReplyId)
          replyCount: (+ (object/get ?data replyCount 0) 1)
        } {
          emit: { failure: ThreadPostCreateFailed, success: ReplyParentUpdated }
        })
      ReplyParentLoadFailed -> browsing
        (notify error (str/concat "Couldn't attach the reply to its post — " ?error))
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", (str/default @entity.replyRootId @config.threadRootId), ""] ["=", (object/get @entity threadRootId), (str/default @entity.replyRootId @config.threadRootId)]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
      ReplyParentUpdated -> browsing
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?threadRootId, ""] ["=", (object/get @entity threadRootId), ?threadRootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
      ;; SELECT's payload IS { id, row } (caller-constructed, unlike the
      ;; persist-auto-emitted ThreadPostCreated) — ?row.threadRootId is
      ;; correct here.
      SELECT -> loading
        (set @entity.focusedRow ?row)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?row.threadRootId, ""] ["=", (object/get @entity threadRootId), ?row.threadRootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
      ;; Inline composers (bodyContent overrides with their own textarea +
      ;; submit button) fire the composer triad while the trait sits in
      ;; browsing — without these arms every such click is swallowed.
      EDIT_REPLY -> browsing
        (set @entity.replyDraft ?value)
      SUBMIT_REPLY -> browsing when (not ["=", (str/default @entity.replyDraft ""), ""])
        (persist create ThreadPost {
          authorId: @user.id
          authorName: @user.name
          createdAt: @now
          content: @entity.replyDraft
          parentId: (str/default @entity.replyParentId "")
          threadRootId: (str/default @entity.replyRootId (str/default @config.threadRootId root))
        } {
          emit: { failure: ThreadPostCreateFailed, success: ThreadPostCreated }
        })
      CANCEL_REPLY -> browsing
        (set @entity.replyDraft "")
        (set @entity.replyParentId "")
      ;; replying.SUBMIT_REPLY -> browsing lands here before the persist
      ;; resolves; a failure must be caught here too, not just replying's twin arm.
      ThreadPostCreateFailed -> browsing
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      ;; replying.ThreadPostCreated -> browsing fires this same refetch; a
      ;; failure must be caught here too, not just loading's twin arm.
      ThreadPostLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SET_THREAD_ROOT -> loading
        (set @entity.replyRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
    }

    state replying {
      EDIT_REPLY -> replying
        (set @entity.replyDraft ?value)
      SUBMIT_REPLY -> browsing when (not ["=", (str/default @entity.replyDraft ""), ""])
        (persist create ThreadPost {
          authorId: @user.id
          authorName: @user.name
          createdAt: @now
          content: @entity.replyDraft
          parentId: (str/default @entity.replyParentId "")
          threadRootId: (str/default @entity.replyRootId (str/default @config.threadRootId root))
        } {
          emit: { failure: ThreadPostCreateFailed, success: ThreadPostCreated }
        })
      CANCEL_REPLY -> browsing
        (set @entity.replyDraft "")
        (set @entity.replyParentId "")
      ;; Scoped to the row just created (?threadRootId, flat) — see the twin
      ;; arm in `browsing` for why.
      ThreadPostCreated -> browsing when (not ["=", (str/default ?parentId ""), ""])
        (set @entity.replyDraft "")
        (set @entity.replyParentId "")
        (set @entity.lastReplyId ?id)
        (fetch ThreadPost {
          id: ?parentId
          emit: { failure: ReplyParentLoadFailed, success: ReplyParentLoaded }
        })
      ThreadPostCreated -> browsing when ["=", (str/default ?parentId ""), ""]
        (set @entity.replyDraft "")
        (set @entity.replyParentId "")
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?threadRootId, ""] ["=", (object/get @entity threadRootId), ?threadRootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
      ThreadPostCreateFailed -> replying
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SET_THREAD_ROOT -> loading
        (set @entity.replyRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
    }

    state error {
      INIT -> loading
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", (str/default @entity.replyRootId @config.threadRootId), ""] ["=", (object/get @entity threadRootId), (str/default @entity.replyRootId @config.threadRootId)]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
      SET_THREAD_ROOT -> loading
        (set @entity.replyRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (and (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId]) ["=", (str/default (object/get @entity parentId) ""), ""])
          include: (replies)
        })
        (render-ui main { type: skeleton, variant: list, rows: 6 })
    }

    emits {
      SELECT -> external {
        id : string
        row : @entity!
      }
        @description "Indicates a post or reply has been chosen for interaction."
        @synonyms "choose, highlight, focus, activate"
        @tier "domain"
      REPLY {
        parentId : string
        parentNodeId : string
        content : string
      }
        @description "Indicates a new reply has been created and added to the thread."
        @synonyms "add, post, respond, submit"
        @tier "domain"
      EDIT_REPLY {
        value : string!
      }
        @description "Indicates a reply has been modified."
        @synonyms "update, change, modify"
        @tier "presentation"
      SUBMIT_REPLY
        @description "Signals the composed draft should be persisted as a new post — the draft is read from the entity frame (@entity.content), so bare buttons can emit it."
        @synonyms "post, send, add, publish"
        @tier "domain"
      CANCEL_REPLY
        @description "Indicates a reply creation was aborted by the user."
        @synonyms "abort, dismiss, undo, cancel"
        @tier "presentation"
      ThreadPostLoaded {
        data : [ThreadPost]
      }
        @description "Signals a thread post has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved"
        @tier "domain"
      ThreadPostLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load a thread post."
        @synonyms "load error, fetch failed, retrieval failed"
        @tier "internal"
      ThreadPostCreated
        @description "A new post has been added to the thread — payload is the created ThreadPost row itself (flat: ?id, ?threadRootId, ?authorId, ?content, …), not wrapped under a row field."
        @synonyms "new post, added, created"
        @tier "domain"
      ReplyParentLoaded -> internal {
        data : ThreadPost!
      }
        @tier "internal"
      ReplyParentUpdated -> internal
        @tier "internal"
      ReplyParentLoadFailed -> internal {
        error : string
      }
        @tier "internal"
      ThreadPostCreateFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to create a new thread post."
        @synonyms "error, failed, creation failed"
        @tier "internal"
    }

    listens {
      SELECT {
        id : string
        row : @entity!
      }
        @description "A post or reply has been chosen for interaction."
        @synonyms "choose, highlight, focus, activate"
        @tier "domain"
      REPLY {
        parentId : string
        parentNodeId : string
        content : string
      }
        @description "A new reply has been created and is ready for processing."
        @synonyms "new reply, post added, response received"
        @tier "domain"
      EDIT_REPLY {
        value : string!
      }
        @description "A reply is being modified."
        @synonyms "update, change, revise"
        @tier "presentation"
      SUBMIT_REPLY
        @description "A new reply has been submitted and is awaiting processing — the draft is read from the entity frame (@entity.content), no payload required."
        @synonyms "post, send, add, submit"
        @tier "domain"
      CANCEL_REPLY
        @description "Aborts the process of creating a new reply."
        @synonyms "abort, dismiss, undo, close"
        @tier "domain"
      ThreadPostLoaded {
        data : [ThreadPost]
      }
        @description "Indicates a thread post has been successfully retrieved."
        @synonyms "loaded, fetched, received, retrieved"
        @tier "domain"
      ThreadPostLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load a thread post."
        @synonyms "error, failure, load failed"
        @tier "internal"
      ThreadPostCreated
        @description "A new post has been added to the thread — payload is the created ThreadPost row itself (flat: ?id, ?threadRootId, ?authorId, ?content, …), not wrapped under a row field."
        @synonyms "new post, added, created"
        @tier "domain"
      ThreadPostCreateFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to create a new thread post."
        @synonyms "error, failure, rejected, invalid"
        @tier "internal"
      ReplyParentLoaded {
        data : ThreadPost!
      }
        @tier "internal"
      ReplyParentUpdated
        @tier "internal"
      ReplyParentLoadFailed {
        error : string
      }
        @tier "internal"
      SET_THREAD_ROOT {
        rootId : string!
      }
        @description "Scopes every fetch, and new-reply threadRootId stamping, to the descendants of one document root."
        @synonyms "scope, focus, set root, document scope, thread scope"
        @tier "domain"
    }

    config {
      threadRootId : string = ""
        @label "Root post id"
        @description "Top-level post whose descendants are loaded, filters every fetch and defaults new top-level replies' threadRootId (blank = all roots, unfiltered)"
        @synonyms "rootId, topLevelId, scope, threadScope"
        @tier "domain"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      sectionTitle : string = ""
        @label "sectionTitle"
        @description "Section header rendered by the default bodyContent when non-empty, along with a standalone composer button — the only REPLY affordance an empty thread has. Blank (the default) keeps the bare post list for embedded threads that bring their own chrome (chat rails, custom comment sections)."
        @synonyms "header, comments title, discussion title"
        @tier "presentation"
      composerLabel : string = "Add comment"
        @label "composerLabel"
        @description "Label of the standalone composer button rendered under the post list when sectionTitle is non-empty."
        @synonyms "reply label, comment button, add comment"
        @tier "presentation"
      bodyContent : render-ui = {
        children: [(if ["!=", @config.sectionTitle, ""] {
          content: @config.sectionTitle
          type: typography
          variant: h4
        } {
          children: []
          gap: none
          type: stack
        }), {
          entity: ?data
          fields: [{
            label: Author
            name: authorName
            variant: h4
          }, {
            label: ""
            name: content
            variant: body
          }, {
            label: Votes
            name: voteCount
            variant: caption
          }]
          gap: sm
          itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
          look: @config.tableLook
          type: data-list
          variant: card
        }, (if ["!=", @config.sectionTitle, ""] <trait.ThreadReplyGate /> {
          children: []
          gap: none
          type: stack
        })]
        direction: vertical
        gap: md
        type: stack
      }
        @label "Body content tree"
        @description "Render-ui SExpr rendered after thread posts load. Default is the canonical forum-style data-list. Layer 3 variants override this with their own tree (chat bubbles, email-threaded cards, linear comment stacks, etc.) to deliver entirely different thread UX while inheriting the same trait, state machine, emits, and listens."
        @tier "internal"
      itemActions : [ItemAction] = [{
        event: REPLY
        icon: message-square
        label: Reply
      }]
        @label "Row actions"
        @description "Actions offered on each row; give an item `roles` to show it only to those viewer roles."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The signed-in viewer's role that each action's `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`) in an app whose identity carries a role; left empty, only actions with no `roles` show."
        @tier "policy"
      replyRoles : [string] = []
        @label "Roles that can reply"
        @description "Roles (matched against viewerRole) that see the thread's Reply button. Empty = everyone."
        @tier "policy"
    }
  }

  trait ThreadReplyButton = Button.traits.ButtonRender {
    config {
      action: REPLY
      icon: message-square
      label: @config.composerLabel
      variant: secondary
    }
  }

  trait ThreadReplyGate = RoleGate.traits.RoleGate {
    config {
      roles: @config.replyRoles
      viewerRole: @config.viewerRole
      content: <trait.ThreadReplyButton />
    }
  }

  page "/threadposts" as ThreadPostBrowsePage -> ThreadPostBrowse
}