app std-thread "1.3.0"
"std-thread — forum-style nested replies with collapse + flat-mode toggle. Owns ThreadPost (persistent). flat:true covers 1:1 linear inquiry threads; flat:false renders forum-style nested. INIT fetches, scoped by @config.threadRootId when set (blank = every root, the default). REPLY persists a child post under @payload.parentId, stamped with the real @user identity. A consumer that mounts this as page comments forwards its own document-opened signal to SET_THREAD_ROOT { rootId }, which stamps the frame and refetches filtered by the payload; the after-create and after-select refetch arms keep filtering by @config.threadRootId, so a mutation re-widens the panel until the consumer re-fires SET_THREAD_ROOT. Layer 3 variants override `bodyContent` to deliver chat-bubble, email-threaded, or linear-comments UX while inheriting the same trait, state machine, emits, and listens. A non-empty sectionTitle switches the default bodyContent into titled-comments mode: header + post list + a standalone composer button (without it an empty thread has no REPLY emitter at all — the affordance only existed per-row)."
orbital ThreadPostOrbital {
  ;; Forward relation: array of child ThreadPost IDs whose parentId === this.id.
  ;; Lowers to `type: "relation", cardinality: "many"` (orbital-lolo lower.rs).
  ;; @rebindable rewrites the target to the rebound entity in variant atoms.
  ;; `(fetch ThreadPost { include: ["replies"] })` triggers @almadar/runtime's
  ;; populateRelations to hydrate each ID into the full row inline so the
  ;; variant's bodyContent can render `@reply.authorName` etc. without
  ;; per-reply lookups.
  ;; Master-detail focus: SELECT sets this to the clicked row so split-pane
  ;; variants (email-threaded) can bind @entity.focusedRow.<field> in their
  ;; detail pane. Unused by list/bubble variants.
    type ThreadPostLoaded = Event { data : [ThreadPost] } "Fired when the thread-post collection finishes loading"

    type ThreadPostLoadFailed = Event { error : string, code : string } "Fired when the thread-post collection fails to load"

    ;; Bare entity alias, not { row: ThreadPost } — `persist create`'s success
    ;; emit is the created row itself (flat), matching @almadar/runtime's
    ;; EffectExecutor.ts (`successPayload = persisted ?? data`, emitted
    ;; directly) AND orbital-core's executor.rs (`executed_with_value(effect,
    ;; value)`), verified live 2026-08-30: a wrapped declaration validates and
    ;; compiles clean but silently returns undefined for every `?row.<field>`
    ;; access — no validator connects a persist-emit's declared shape to what
    ;; the effect that fires it actually produces.
    type ThreadPostCreated = Event ThreadPost "Fired after a new thread-post persists successfully"

    type ThreadPostCreateFailed = Event { error : string, code : string } "Fired when a new thread-post fails to persist"

    type SetThreadRoot = Event { rootId : string! } "Fired to scope every ThreadPost fetch, and new-reply threadRootId stamping, to the descendants of one document root"

  entity ThreadPost [persistent: threadposts] {
    id : string!
    parentId : string @description "Identifier of the parent ThreadPost in a nested thread." @synonyms "parent, ancestor, source"
    threadRootId : string! @description "Identifier of the top-level thread this post belongs to." @synonyms "rootId, topLevelId, parentThreadId"
    authorId : string! @description "Unique identifier for the post's author." @synonyms "user id, creator id, author"
    authorName : string! @description "The name of the post's author." @synonyms "author, username, poster"
    content : string! @description "The main text content of the post." @synonyms "text, message, body"
    createdAt : string
    voteCount : number @description "The number of votes associated with this item." @synonyms "votes, rating, score" = 0
    replyCount : number @description "The number of replies to this post." @synonyms "count, number of replies, child posts" = 0
    replies : [ThreadPost] @description "A list of child ThreadPost entities." @synonyms "children, descendants, sub-posts"
    focusedRow : object @description "The currently selected or active row within the thread." @synonyms "selection, active, current" = {}
  }

  trait ThreadPostBrowse -> @rebindable ThreadPost [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", @config.threadRootId, ""] ["=", (object/get @entity threadRootId), @config.threadRootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
      ThreadPostLoaded -> browsing
        (render-ui main @config.bodyContent)
      ThreadPostLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SET_THREAD_ROOT -> loading
        (set @entity.threadRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
    }

    state browsing {
      INIT -> loading
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", @config.threadRootId, ""] ["=", (object/get @entity threadRootId), @config.threadRootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
      ThreadPostLoaded -> browsing
        (render-ui main @config.bodyContent)
      ;; Inline reply: when the event already carries the composed text (e.g.
      ;; reply-tree's inline composer), persist directly and stay in `browsing`
      ;; so the box stays inline instead of swapping to a full composer view.
      REPLY -> browsing when (not ["=", (str/default ?content ""), ""])
        (persist create ThreadPost {
          authorId: @user.id
          authorName: @user.name
          content: ?content
          parentId: (str/default ?parentNodeId ?parentId)
          threadRootId: (str/default ?parentNodeId (str/default @entity.threadRootId (str/default @config.threadRootId root)))
        } {
          emit: { failure: ThreadPostCreateFailed, success: ThreadPostCreated }
        })
      ;; Reply with no text yet (e.g. an email "Reply" button) opens the composer.
      REPLY -> replying when ["=", (str/default ?content ""), ""]
        (set @entity.parentId (str/default ?parentNodeId ?parentId))
        (set @entity.threadRootId (str/default ?parentNodeId (str/default @entity.threadRootId (str/default @config.threadRootId root))))
        (render-ui main {
          children: [{
            content: "Write a reply"
            type: typography
            variant: h4
          }, {
            onChange: EDIT_REPLY
            placeholder: "Your reply…"
            type: textarea
          }, {
            children: [{
              action: SUBMIT_REPLY
              icon: send
              label: Submit
              type: button
              variant: primary
            }, {
              action: CANCEL_REPLY
              label: Cancel
              type: button
              variant: secondary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      ;; Scoped to the row just created, not @config.threadRootId — a runtime-
      ;; scoped consumer (SET_THREAD_ROOT-driven, e.g. std-wiki's WikiComments)
      ;; never sets config.threadRootId, so that filter was permanently blank/
      ;; unfiltered here and every document's posts bled together on refetch.
      ;; ?threadRootId is the FLAT field on ThreadPostCreated's payload (the
      ;; row's own scope, per the create effect's fallback chain) — NOT
      ;; ?row.threadRootId; ThreadPostCreated's payload is the created row
      ;; itself (see the type alias above), no `row` wrapper exists.
      ThreadPostCreated -> browsing
        (set @entity.content "")
        (set @entity.parentId "")
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?threadRootId, ""] ["=", (object/get @entity threadRootId), ?threadRootId])
          include: (replies)
        })
      ;; SELECT's payload IS { id, row } (caller-constructed, unlike the
      ;; persist-auto-emitted ThreadPostCreated) — ?row.threadRootId is
      ;; correct here.
      SELECT -> loading
        (set @entity.focusedRow ?row)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?row.threadRootId, ""] ["=", (object/get @entity threadRootId), ?row.threadRootId])
          include: (replies)
        })
      ;; Inline composers (bodyContent overrides with their own textarea +
      ;; submit button) fire the composer triad while the trait sits in
      ;; browsing — without these arms every such click is swallowed.
      EDIT_REPLY -> browsing
        (set @entity.content ?value)
      SUBMIT_REPLY -> browsing when (not ["=", (str/default @entity.content ""), ""])
        (persist create ThreadPost {
          authorId: @user.id
          authorName: @user.name
          content: @entity.content
          parentId: (str/default @entity.parentId "")
          threadRootId: (str/default @entity.threadRootId (str/default @config.threadRootId root))
        } {
          emit: { failure: ThreadPostCreateFailed, success: ThreadPostCreated }
        })
      CANCEL_REPLY -> browsing
        (set @entity.content "")
        (set @entity.parentId "")
      ;; replying.SUBMIT_REPLY -> browsing lands here before the persist
      ;; resolves; a failure must be caught here too, not just replying's twin arm.
      ThreadPostCreateFailed -> browsing
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      ;; replying.ThreadPostCreated -> browsing fires this same refetch; a
      ;; failure must be caught here too, not just loading's twin arm.
      ThreadPostLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SET_THREAD_ROOT -> loading
        (set @entity.threadRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
    }

    state replying {
      EDIT_REPLY -> replying
        (set @entity.content ?value)
      SUBMIT_REPLY -> browsing when (not ["=", (str/default @entity.content ""), ""])
        (persist create ThreadPost {
          authorId: @user.id
          authorName: @user.name
          content: @entity.content
          parentId: (str/default @entity.parentId "")
          threadRootId: (str/default @entity.threadRootId (str/default @config.threadRootId root))
        } {
          emit: { failure: ThreadPostCreateFailed, success: ThreadPostCreated }
        })
      CANCEL_REPLY -> browsing
        (set @entity.content "")
        (set @entity.parentId "")
      ;; Scoped to the row just created (?threadRootId, flat) — see the twin
      ;; arm in `browsing` for why.
      ThreadPostCreated -> browsing
        (set @entity.content "")
        (set @entity.parentId "")
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?threadRootId, ""] ["=", (object/get @entity threadRootId), ?threadRootId])
          include: (replies)
        })
      ThreadPostCreateFailed -> replying
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SET_THREAD_ROOT -> loading
        (set @entity.threadRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
    }

    state error {
      INIT -> loading
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", @config.threadRootId, ""] ["=", (object/get @entity threadRootId), @config.threadRootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
      SET_THREAD_ROOT -> loading
        (set @entity.threadRootId ?rootId)
        (fetch ThreadPost {
          emit: { failure: ThreadPostLoadFailed, success: ThreadPostLoaded }
          filter: (or ["=", ?rootId, ""] ["=", (object/get @entity threadRootId), ?rootId])
          include: (replies)
        })
        (render-ui main { size: sm, type: spinner })
    }

    emits {
      SELECT -> external {
        id : string
        row : object!
      }
        @description "Indicates a post or reply has been chosen for interaction."
        @synonyms "choose, highlight, focus, activate"
        @tier "domain"
      REPLY {
        parentId : string
        parentNodeId : string
        content : string
      }
        @description "Indicates a new reply has been created and added to the thread."
        @synonyms "add, post, respond, submit"
        @tier "domain"
      EDIT_REPLY {
        value : string!
      }
        @description "Indicates a reply has been modified."
        @synonyms "update, change, modify"
        @tier "presentation"
      SUBMIT_REPLY
        @description "Signals the composed draft should be persisted as a new post — the draft is read from the entity frame (@entity.content), so bare buttons can emit it."
        @synonyms "post, send, add, publish"
        @tier "domain"
      CANCEL_REPLY
        @description "Indicates a reply creation was aborted by the user."
        @synonyms "abort, dismiss, undo, cancel"
        @tier "presentation"
      ThreadPostLoaded {
        data : [ThreadPost]
      }
        @description "Signals a thread post has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved"
        @tier "domain"
      ThreadPostLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load a thread post."
        @synonyms "load error, fetch failed, retrieval failed"
        @tier "internal"
      ThreadPostCreated
        @description "A new post has been added to the thread — payload is the created ThreadPost row itself (flat: ?id, ?threadRootId, ?authorId, ?content, …), not wrapped under a row field."
        @synonyms "new post, added, created"
        @tier "domain"
      ThreadPostCreateFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to create a new thread post."
        @synonyms "error, failed, creation failed"
        @tier "internal"
    }

    listens {
      SELECT {
        id : string
        row : object!
      }
        @description "A post or reply has been chosen for interaction."
        @synonyms "choose, highlight, focus, activate"
        @tier "domain"
      REPLY {
        parentId : string
        parentNodeId : string
        content : string
      }
        @description "A new reply has been created and is ready for processing."
        @synonyms "new reply, post added, response received"
        @tier "domain"
      EDIT_REPLY {
        value : string!
      }
        @description "A reply is being modified."
        @synonyms "update, change, revise"
        @tier "presentation"
      SUBMIT_REPLY
        @description "A new reply has been submitted and is awaiting processing — the draft is read from the entity frame (@entity.content), no payload required."
        @synonyms "post, send, add, submit"
        @tier "domain"
      CANCEL_REPLY
        @description "Aborts the process of creating a new reply."
        @synonyms "abort, dismiss, undo, close"
        @tier "domain"
      ThreadPostLoaded {
        data : [ThreadPost]
      }
        @description "Indicates a thread post has been successfully retrieved."
        @synonyms "loaded, fetched, received, retrieved"
        @tier "domain"
      ThreadPostLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load a thread post."
        @synonyms "error, failure, load failed"
        @tier "internal"
      ThreadPostCreated
        @description "A new post has been added to the thread — payload is the created ThreadPost row itself (flat: ?id, ?threadRootId, ?authorId, ?content, …), not wrapped under a row field."
        @synonyms "new post, added, created"
        @tier "domain"
      ThreadPostCreateFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to create a new thread post."
        @synonyms "error, failure, rejected, invalid"
        @tier "internal"
      SET_THREAD_ROOT {
        rootId : string!
      }
        @description "Scopes every fetch, and new-reply threadRootId stamping, to the descendants of one document root."
        @synonyms "scope, focus, set root, document scope, thread scope"
        @tier "domain"
    }

    config {
      flat : boolean = false
        @label "Flat thread"
        @description "Render replies as a linear list instead of nested tree"
        @tier "presentation"
      threadRootId : string = ""
        @label "Root post id"
        @description "Top-level post whose descendants are loaded, filters every fetch and defaults new top-level replies' threadRootId (blank = all roots, unfiltered)"
        @synonyms "rootId, topLevelId, scope, threadScope"
        @tier "domain"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      recipientName : string = Conversation
        @label "recipientName"
        @description "Header/recipient label for chat-style threads."
        @tier "presentation"
      sectionTitle : string = ""
        @label "sectionTitle"
        @description "Section header rendered by the default bodyContent when non-empty, along with a standalone composer button — the only REPLY affordance an empty thread has. Blank (the default) keeps the bare post list for embedded threads that bring their own chrome (chat rails, custom comment sections)."
        @synonyms "header, comments title, discussion title"
        @tier "presentation"
      composerLabel : string = "Add comment"
        @label "composerLabel"
        @description "Label of the standalone composer button rendered under the post list when sectionTitle is non-empty."
        @synonyms "reply label, comment button, add comment"
        @tier "presentation"
      emailAuthorBinding : string = @item.authorName
        @label "emailAuthorBinding"
        @description "List-pane binding for the message author."
        @tier "presentation"
      emailSubjectBinding : string = @item.subject
        @label "emailSubjectBinding"
        @description "List-pane binding for the message subject."
        @tier "presentation"
      emailPreviewBinding : string = @item.preview
        @label "emailPreviewBinding"
        @description "List-pane binding for the message preview text."
        @tier "presentation"
      detailSubjectBinding : string = @entity.focusedRow.subject
        @label "detailSubjectBinding"
        @description "Detail-pane binding for the focused message subject."
        @tier "presentation"
      detailAuthorBinding : string = @entity.focusedRow.authorName
        @label "detailAuthorBinding"
        @description "Detail-pane binding for the focused message author."
        @tier "presentation"
      detailFromBinding : string = @entity.focusedRow.fromAddress
        @label "detailFromBinding"
        @description "Detail-pane binding for the From address."
        @tier "presentation"
      detailToBinding : string = @entity.focusedRow.toAddress
        @label "detailToBinding"
        @description "Detail-pane binding for the To address."
        @tier "presentation"
      detailDateBinding : string = @entity.focusedRow.createdAt
        @label "detailDateBinding"
        @description "Detail-pane binding for the timestamp."
        @tier "presentation"
      detailContentBinding : string = @entity.focusedRow.content
        @label "detailContentBinding"
        @description "Detail-pane binding for the message body."
        @tier "presentation"
      replyAuthorBinding : string = @reply.authorName
        @label "replyAuthorBinding"
        @description "Reply binding for the reply author."
        @tier "presentation"
      replyFromBinding : string = @reply.fromAddress
        @label "replyFromBinding"
        @description "Reply binding for the reply From address."
        @tier "presentation"
      replyDateBinding : string = @reply.createdAt
        @label "replyDateBinding"
        @description "Reply binding for the reply timestamp."
        @tier "presentation"
      replyContentBinding : string = @reply.content
        @label "replyContentBinding"
        @description "Reply binding for the reply body."
        @tier "presentation"
      bodyContent : render-ui = {
        children: [(if ["!=", @config.sectionTitle, ""] {
          content: @config.sectionTitle
          type: typography
          variant: h4
        } {
          children: []
          gap: none
          type: stack
        }), {
          entity: ?data
          fields: [{
            label: Author
            name: authorName
            variant: h4
          }, {
            label: ""
            name: content
            variant: body
          }, {
            label: Votes
            name: voteCount
            variant: caption
          }]
          gap: sm
          itemActions: [{
            event: REPLY
            icon: message-square
            label: Reply
          }]
          look: @config.tableLook
          type: data-list
          variant: card
        }, (if ["!=", @config.sectionTitle, ""] {
          action: REPLY
          icon: message-square
          label: @config.composerLabel
          type: button
          variant: secondary
        } {
          children: []
          gap: none
          type: stack
        })]
        direction: vertical
        gap: md
        type: stack
      }
        @label "Body content tree"
        @description "Render-ui SExpr rendered after thread posts load. Default is the canonical forum-style data-list. Layer 3 variants override this with their own tree (chat bubbles, email-threaded cards, linear comment stacks, etc.) to deliver entirely different thread UX while inheriting the same trait, state machine, emits, and listens."
        @tier "internal"
    }
  }

  page "/threadposts" as ThreadPostBrowsePage -> ThreadPostBrowse
}