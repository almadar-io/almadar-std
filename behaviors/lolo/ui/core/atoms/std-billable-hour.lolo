app std-billable-hour "1.0.0"
"std-billable-hour — generic billable-hour timesheet primitive for legal, agency, and consulting domains. Lists entries in `browsing`; opens entry detail in `viewing_single` with Invoice / Write Off actions."
type ItemAction = { label : string!, event : event, navigatesTo : string, variant : string, icon : string, roles : [string], when : SExpr }
type ColumnSpec = { key : string!, field : string, header : string, width : string, align : string, className : string, weight : string, format : string, icon : string }
orbital BillableHourOrbital {
  uses RoleGate from "std/behaviors/std-role-gate"

  uses Button from "std/behaviors/ui-button"

  uses TableView from "std/behaviors/ui-table-view"

    type BillableHourLoaded = Event { data : [BillableHour] } "Fired when the billable-hour collection finishes loading"

    type BillableHourLoadFailed = Event { error : string, code : string } "Fired when the billable-hour collection fails to load"

  entity BillableHour [persistent: billablehours] {
    id : string!
    workerId : string! @description "Unique identifier for the worker." @synonyms "employeeId, staffId, userId"
    workerName : string @description "The name of the worker associated with the time entry." @synonyms "employee, staff, personnel" = ""
    matterId : string @description "Unique identifier for the associated case or project." @synonyms "caseId, projectID, reference" = ""
    projectId : string @description "Identifier for the project associated with the time entry." @synonyms "project, task, reference" = ""
    workDate : date! @description "The date on which the work was performed." @synonyms "date, transaction date, service date"
    hours : number @description "The quantity of time recorded." @synonyms "duration, time, amount" = 0
    rate : number @description "The hourly charge for the work performed." @synonyms "price, cost, amount" = 0
    description : string @description "A textual explanation of the hour entry." @synonyms "explanation, notes, details, comment" = ""
    isBillable : boolean @description "Indicates whether the hour is eligible for billing." @synonyms "billable flag, billing status, billable indicator" = true
    invoiceStatus : "unbilled" | "invoiced" | "paid" | "written_off" @description "The current billing status of the hour entry." @synonyms "status, billing status, payment status" = unbilled
  }

  trait DenseHoursTable = TableView.traits.TableViewRender -> BillableHour {
    config {
      columns: @config.columns
      emptyMessage: "No time entries"
      itemActions: @config.itemActions
      viewerRole: @config.viewerRole
      look: @config.tableLook
      maxInlineActions: 2
      selfFetch: false
    }

    listens {
      BillableHourTimesheet.BillableHourLoaded -> TableViewLoaded
    }
  }

  trait BillableHourTimesheet -> BillableHour [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: table, rows: 6 }]
        })
      BillableHourLoaded -> browsing
        (render-ui main {
          children: [(if @config.showHeader {
            children: [{
              align: center
              children: [{ name: clock, size: lg, type: icon }, {
                content: @config.title
                type: typography
                variant: h3
              }]
              direction: horizontal
              gap: sm
              type: stack
            }, { type: divider }]
            direction: vertical
            gap: md
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), {
            children: [@trait.DenseHoursTable]
            className: overflow-x-auto
            direction: vertical
            gap: none
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      BillableHourLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
    }

    state browsing {
      INIT -> loading
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main { rows: 4, type: skeleton })
      OPEN_HOURS -> viewing_single
        (set @entity.id ?row.id)
        (set @entity.workerId ?row.workerId)
        (set @entity.workerName ?row.workerName)
        (set @entity.matterId ?row.matterId)
        (set @entity.projectId ?row.projectId)
        (set @entity.workDate ?row.workDate)
        (set @entity.hours ?row.hours)
        (set @entity.rate ?row.rate)
        (set @entity.description ?row.description)
        (set @entity.isBillable ?row.isBillable)
        (set @entity.invoiceStatus ?row.invoiceStatus)
        (render-ui main {
          children: [{
            align: center
            children: [{
              action: CLOSE_VIEW
              label: Back
              type: button
              variant: ghost
            }, { name: clock, size: lg, type: icon }, {
              content: @entity.workerName
              type: typography
              variant: h3
            }, {
              label: @entity.invoiceStatus
              type: badge
              variant: default
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            children: [{
              children: [{
                color: muted
                content: Matter
                type: typography
                variant: caption
              }, {
                content: @entity.matterId
                type: typography
                variant: body
              }]
              direction: horizontal
              gap: md
              type: stack
            }, {
              children: [{
                color: muted
                content: Project
                type: typography
                variant: caption
              }, {
                content: @entity.projectId
                type: typography
                variant: body
              }]
              direction: horizontal
              gap: md
              type: stack
            }, {
              children: [{
                color: muted
                content: Description
                type: typography
                variant: caption
              }, {
                content: @entity.description
                type: typography
                variant: body
              }]
              direction: horizontal
              gap: md
              type: stack
            }]
            direction: vertical
            gap: sm
            type: stack
          }, { type: divider }, {
            children: [{
              icon: clock
              label: Hours
              look: @config.statLook
              type: stat-display
              value: @entity.hours
            }, {
              icon: dollar-sign
              label: Rate
              look: @config.statLook
              type: stat-display
              value: @entity.rate
            }, {
              icon: calendar
              label: Date
              look: @config.statLook
              type: stat-display
              value: @entity.workDate
            }]
            cols: 3
            type: simple-grid
          }, {
            align: center
            children: [<RoleGate.traits.RoleGate linkedEntity={BillableHour} roles={@config.invoiceRoles} viewerRole={@config.viewerRole} content={<Button.traits.ButtonRender linkedEntity={BillableHour} action={INVOICE_HOURS} actionPayload={{ id: ?row.id }} label={Invoice} variant={primary} />} />, <RoleGate.traits.RoleGate linkedEntity={BillableHour} roles={@config.writeOffRoles} viewerRole={@config.viewerRole} content={<Button.traits.ButtonRender linkedEntity={BillableHour} action={WRITE_OFF_HOURS} actionPayload={{ id: ?row.id }} label={"Write Off"} variant={danger} />} />]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      WRITE_OFF_HOURS -> loading
        (set @entity.id ?id)
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Writing off hours…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state viewing_single {
      CLOSE_VIEW -> loading
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: table, rows: 6 }]
        })
      INVOICE_HOURS -> loading
        (set @entity.id ?id)
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Invoicing hours…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      WRITE_OFF_HOURS -> loading
        (set @entity.id ?id)
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Writing off hours…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state error {
      INIT -> loading
        (fetch BillableHour {
          emit: { failure: BillableHourLoadFailed, success: BillableHourLoaded }
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: table, rows: 6 }]
        })
    }

    emits {
      OPEN_HOURS {
        id : string!
        row : BillableHour
      }
        @description "Signals the display of the hours list."
        @synonyms "show, display, list"
        @tier "domain"
      CLOSE_VIEW
        @description "Indicates the detail view has been dismissed."
        @synonyms "dismiss, close, hide"
        @tier "domain"
      INVOICE_HOURS {
        id : string!
      }
        @description "Signals that billable hours have been invoiced."
        @synonyms "invoice, charge, bill"
        @tier "presentation"
      WRITE_OFF_HOURS {
        id : string!
      }
        @description "Indicates billable hours have been written off."
        @synonyms "deduct, remove, cancel"
        @tier "presentation"
      BillableHourLoaded {
        data : [BillableHour]
      }
        @description "Signals that a billable hour data set has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved, populated"
        @tier "domain"
      BillableHourLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load billable hour data."
        @synonyms "error, failed, problem, unsuccessful"
        @tier "internal"
    }

    listens {
      OPEN_HOURS {
        id : string!
        row : BillableHour
      }
        @description "Indicates a request to display the hours list."
        @synonyms "show, display, list"
        @tier "domain"
      CLOSE_VIEW
        @description "Dismisses the current view or detail panel."
        @synonyms "close, dismiss, hide, cancel"
        @tier "domain"
      INVOICE_HOURS {
        id : string!
      }
        @description "Hours are marked as ready for invoicing."
        @synonyms "invoice, bill, submit"
        @tier "domain"
      WRITE_OFF_HOURS {
        id : string!
      }
        @description "Hours have been marked as non-billable."
        @synonyms "deduct, remove, expense, adjust"
        @tier "presentation"
      BillableHourLoaded {
        data : [BillableHour]
      }
        @description "Indicates that billable hour data has been successfully retrieved."
        @synonyms "loaded, fetched, received, populated"
        @tier "domain"
      BillableHourLoadFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load billable hour data."
        @synonyms "error, failed, problem, unsuccessful"
        @tier "internal"
    }

    config {
      showHeader : boolean = true
        @label "Show the list's own title row?"
        @description "Off when the page already carries a page header naming the same thing, so the page shows one title."
        @tier "presentation"
      title : string = "Time Entries"
        @label "Section title"
        @description "Heading shown above the time-entries list"
        @tier "presentation"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "bordered" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      columns : [ColumnSpec] = [{
        align: left
        field: workerName
        header: Worker
        key: workerName
        width: "minmax(8rem, 1fr)"
      }, {
        align: left
        field: matterId
        header: Matter
        key: matterId
        width: "8rem"
      }, {
        align: left
        field: workDate
        format: date
        header: Date
        key: workDate
        width: "8rem"
      }, {
        align: right
        field: hours
        format: number
        header: Hours
        key: hours
        width: "6rem"
      }, {
        align: right
        field: rate
        format: currency
        header: Rate
        key: rate
        width: "7rem"
      }, {
        align: center
        field: invoiceStatus
        format: badge
        header: Status
        key: invoiceStatus
        width: "8rem"
      }]
        @label "Table columns"
        @description "ColumnSpec list for the dense hours ledger table."
        @tier "presentation"
      itemActions : [ItemAction] = [{
        event: OPEN_HOURS
        icon: arrow-right
        label: Open
        variant: ghost
      }, {
        event: WRITE_OFF_HOURS
        label: "Write Off"
        variant: danger
      }]
        @label "Row actions"
        @description "Per-row actions rendered by the hours table."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The signed-in viewer's role that each action's `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`) in an app whose identity carries a role; left empty, only actions with no `roles` show."
        @tier "policy"
      statLook : "elevated" | "flat" | "progress-backed" | "gauge" | "sparkline" = elevated
        @label "Stat display look"
        @description "Layer 2 visual treatment for stat / KPI cards."
        @tier "presentation"
      invoiceRoles : [string] = []
        @label "Roles that can invoice"
        @description "Roles (matched against viewerRole) that see the Invoice button. Empty = everyone."
        @tier "policy"
      writeOffRoles : [string] = []
        @label "Roles that can write off"
        @description "Roles (matched against viewerRole) that see the Write Off button. Empty = everyone."
        @tier "policy"
    }
  }

  page "/timesheet" as BillableHourPage -> BillableHourTimesheet
}