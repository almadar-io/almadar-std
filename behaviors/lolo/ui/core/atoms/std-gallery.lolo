app std-gallery [
  version: "1.0.0",
  description: "std-gallery — image gallery primitive. Browses GalleryItems in a media-gallery grid; opens a lightbox modal for full-size viewing."
]
type FilterSpec = { field : string!, label : string, options : [string] }
type GalleryItemRelatedRow = { id : string! }
orbital GalleryItemOrbital {
  uses Spinner from "std/behaviors/ui-spinner"
  uses Typography from "std/behaviors/ui-typography"
  uses Icon from "std/behaviors/ui-icon"
  uses Divider from "std/behaviors/ui-divider"
  uses Alert from "std/behaviors/ui-alert"

    type GalleryItemLoaded = Event { data : [GalleryItem]!, totalCount : number! } "Fired when GalleryItem finishes loading; payload.data holds the gallery"

    type GalleryItemPageLoaded = Event { data : [GalleryItem], totalCount : number } "Fired when one page of GalleryItem finishes loading after a search, filter or REFETCH_PAGE"

    type GalleryItemLoadFailed = Event { error : string, code : string } "Fired when GalleryItem fails to load"

    type GalleryItemRelatedLoaded = Event { data : [GalleryItemRelatedRow]!, totalCount : number! } "Related rows whose text matches the query loaded"

  entity GalleryItem [runtime, shared] {
    id : string!
    name : string! @description "A user-friendly identifier for the item." @synonyms "title, label, identifier"
    description : string @description "A brief textual summary of the item's content." @synonyms "caption, summary, details, notes"
    status : "active" | "inactive" | "pending" @description "Indicates the current state of the item." @synonyms "state, condition, flag" = active
    createdAt : string
    imageUrl : image @description "The URL pointing to the image resource." @synonyms "image, src, path" = "https://picsum.photos/seed/gallery/800/600"
    galleryPage : number @intrinsic @description "The page the gallery shows." = 1
    galleryTotalCount : number @intrinsic @description "Images the active search and filter match, across every page." = 0
    gallerySearchTerm : string @intrinsic @description "The search query the paged gallery applies." = ""
    galleryFilterField : string @intrinsic @description "The field the paged gallery's active filter matches." = ""
    galleryFilterValue : string @intrinsic @description "The value the paged gallery's active filter matches; empty means no filter." = ""
  }

  trait LoadingSpinner = Spinner.traits.SpinnerRender -> GalleryItem {
    config {}
  }

  trait LoadingCaption = Typography.traits.TypographyRender -> GalleryItem {
    config {
      color: muted
      content: "Loading gallery…"
      variant: caption
    }
  }

  trait GalleryIcon = Icon.traits.IconRender -> GalleryItem {
    config {
      name: image
    }
  }

  trait TitleDivider = Divider.traits.DividerRender -> GalleryItem {
    config {}
  }

  trait ErrorAlert = Alert.traits.AlertRender -> GalleryItem {
    config {
      message: "Failed to load gallery items"
      variant: error
    }
  }

  trait ReloadSpinner = Spinner.traits.SpinnerRender -> GalleryItem {
    config {
      size: sm
    }
  }

  trait ReloadCaption = Typography.traits.TypographyRender -> GalleryItem {
    config {
      color: muted
      content: "Loading gallery…"
      variant: caption
    }
  }

  trait RetrySpinner = Spinner.traits.SpinnerRender -> GalleryItem {
    config {
      size: sm
    }
  }

  trait GalleryItemGallery -> @rebindable GalleryItem {
    initial: loading

    state loading {
      INIT -> loading
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemLoaded }
          limit: @config.maxRows
        })
        (render-ui main {
          align: center
          children: [@trait.LoadingSpinner, @trait.LoadingCaption]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      GalleryItemLoaded -> loading when (> ?totalCount (array/len ?data))
        (emit GalleryItemLoadFailed { error: (str/concat "GalleryItem has " ?totalCount " images, over the maxRows cap of " @config.maxRows), code: "GALLERY_OVER_CAP" })
      GalleryItemLoaded -> browsing
        (set @entity.galleryPage 1)
        (set @entity.gallerySearchTerm "")
        (set @entity.galleryFilterField "")
        (set @entity.galleryFilterValue "")
        (render-ui main {
          children: [{
            align: center
            children: [@trait.GalleryIcon, {
              content: @config.title
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, @trait.TitleDivider, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if (> (array/len @config.filters) 0) {
            children: [{
              entity: GalleryItem
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), { captionField: @config.nameField, entity: ?data, pageSize: 0, srcField: @config.imageField, type: media-gallery }]
          direction: vertical
          gap: md
          type: stack
        })
      GalleryItemLoadFailed -> error
        (render-ui main {
          children: [@trait.ErrorAlert]
          type: box
        })
    }

    state browsing {
      ;; Revisit re-entry: refetch without repainting over the rendered gallery.
      INIT -> loading
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemLoaded }
          limit: @config.maxRows
        })
      ;; REFETCH_* stays in `browsing` and DOES NOT replace the gallery grid
      ;; with a spinner — search-as-you-type would otherwise unmount the
      ;; media-gallery every keystroke and flicker. The fetch fires in the
      ;; background; when GalleryItemLoaded arrives below, React reconciles
      ;; the grid in place instead of unmounting it.
      REFETCH_QUERY -> browsing when (or (= @config.searchRelation null) (= ?searchTerm ""))
        (set @entity.gallerySearchTerm ?searchTerm)
        (set @entity.galleryPage 1)
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemPageLoaded }
          filter: (and (or (= ?searchTerm "") (str/includes (object/get @entity @config.searchField) ?searchTerm)) (or (= @entity.galleryFilterValue "") (= (object/get @entity @entity.galleryFilterField) @entity.galleryFilterValue)))
          limit: @config.pageSize
          offset: 0
        })
      REFETCH_QUERY -> browsing when (and (!= @config.searchRelation null) (!= ?searchTerm ""))
        (set @entity.gallerySearchTerm ?searchTerm)
        (set @entity.galleryPage 1)
        (fetch @config.relatedEntity {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemRelatedLoaded }
          filter: (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") ?searchTerm))
          limit: @config.relatedMaxRows
        })
      GalleryItemRelatedLoaded -> browsing when (> ?totalCount (array/len ?data))
        (emit GalleryItemLoadFailed { error: (str/concat @config.relatedEntity " has " ?totalCount " rows matching the search, over the relatedMaxRows cap of " @config.relatedMaxRows), code: "GALLERY_RELATED_OVER_CAP" })
      GalleryItemRelatedLoaded -> browsing
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemPageLoaded }
          filter: (and (if (= @config.searchRelation null) false (array/includes (array/map ?data (fn r (object/get @r id))) (object/get @entity @config.searchRelation))) (or (= @entity.galleryFilterValue "") (= (object/get @entity @entity.galleryFilterField) @entity.galleryFilterValue)))
          limit: @config.pageSize
          offset: (* (- @entity.galleryPage 1) @config.pageSize)
        })
      REFETCH_FILTER -> browsing when (or (= @config.searchRelation null) (= @entity.gallerySearchTerm ""))
        (set @entity.galleryFilterField ?field)
        (set @entity.galleryFilterValue ?value)
        (set @entity.galleryPage 1)
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemPageLoaded }
          filter: (and (or (= @entity.gallerySearchTerm "") (str/includes (object/get @entity @config.searchField) @entity.gallerySearchTerm)) (or (= ?value "") (= (object/get @entity ?field) ?value)))
          limit: @config.pageSize
          offset: 0
        })
      REFETCH_FILTER -> browsing when (and (!= @config.searchRelation null) (!= @entity.gallerySearchTerm ""))
        (set @entity.galleryFilterField ?field)
        (set @entity.galleryFilterValue ?value)
        (set @entity.galleryPage 1)
        (fetch @config.relatedEntity {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemRelatedLoaded }
          filter: (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") @entity.gallerySearchTerm))
          limit: @config.relatedMaxRows
        })
      REFETCH_PAGE -> browsing when (or (= @config.searchRelation null) (= @entity.gallerySearchTerm ""))
        (set @entity.galleryPage ?page)
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemPageLoaded }
          filter: (and (or (= @entity.gallerySearchTerm "") (str/includes (object/get @entity @config.searchField) @entity.gallerySearchTerm)) (or (= @entity.galleryFilterValue "") (= (object/get @entity @entity.galleryFilterField) @entity.galleryFilterValue)))
          limit: @config.pageSize
          offset: (* (- ?page 1) @config.pageSize)
        })
      REFETCH_PAGE -> browsing when (and (!= @config.searchRelation null) (!= @entity.gallerySearchTerm ""))
        (set @entity.galleryPage ?page)
        (fetch @config.relatedEntity {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemRelatedLoaded }
          filter: (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") @entity.gallerySearchTerm))
          limit: @config.relatedMaxRows
        })
      GalleryItemLoadFailed -> browsing
        (notify error (str/concat "Couldn't refresh the gallery — " ?error))
      GalleryItemPageLoaded -> browsing
        (set @entity.galleryTotalCount ?totalCount)
        (render-ui main {
          children: [{
            align: center
            children: [@trait.GalleryIcon, {
              content: @config.title
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, @trait.TitleDivider, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if (> (array/len @config.filters) 0) {
            children: [{
              entity: GalleryItem
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), { captionField: @config.nameField, entity: ?data, pageSize: 0, srcField: @config.imageField, type: media-gallery }, {
            currentPage: @entity.galleryPage
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
            totalPages: (math/max 1 (math/ceil (/ ?totalCount @config.pageSize)))
            type: pagination
          }]
          direction: vertical
          gap: md
          type: stack
        })
      VIEW -> viewing
        (set @entity.id ?id)
        (render-ui modal {
          children: [{
            closeAction: CLOSE
            currentIndex: 0
            images: [{
              alt: (object/get ?row @config.nameField)
              caption: (object/get ?row @config.nameField)
              src: (object/get ?row @config.imageField)
            }]
            isOpen: true
            showCounter: true
            type: lightbox
          }]
          type: box
        })
    }

    state viewing {
      INIT -> loading
        (render-ui modal null)
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemLoaded }
          limit: @config.maxRows
        })
        (render-ui main {
          align: center
          children: [@trait.ReloadSpinner, @trait.ReloadCaption]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      CLOSE -> loading
        (render-ui modal null)
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemLoaded }
          limit: @config.maxRows
        })
        (render-ui main {
          align: center
          children: [@trait.ReloadSpinner, @trait.ReloadCaption]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state error {
      INIT -> loading
        (fetch GalleryItem {
          emit: { failure: GalleryItemLoadFailed, success: GalleryItemLoaded }
          limit: @config.maxRows
        })
        (render-ui main {
          align: center
          children: [@trait.RetrySpinner]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    emits {
      GalleryItemRelatedLoaded
        @description "Signals that the related rows matching the search query have loaded."
        @synonyms "related loaded, relation matched"
        @tier "internal"
      VIEW -> external {
        id : string!
        row : GalleryItem!
      }
        @description "Signals an item has been selected for viewing."
        @synonyms "select, choose, display"
        @tier "domain"
      GalleryItemLoaded {
        data : [GalleryItem]!
        totalCount : number!
      }
        @description "Indicates a GalleryItem has finished loading."
        @synonyms "loaded, ready, available"
        @tier "internal"
      GalleryItemPageLoaded {
        data : [GalleryItem]
        totalCount : number
      }
        @description "Indicates one page of GalleryItem finished loading after a search, filter or page change."
        @synonyms "page loaded, results loaded, filtered"
        @tier "internal"
      GalleryItemLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a GalleryItem failed to load."
        @synonyms "error, failure, problem, load error"
        @tier "internal"
    }

    listens {
      REFETCH_QUERY {
        searchTerm : string!
      }
        @description "Triggers a gallery refresh based on the current search query."
        @synonyms "refresh, reload, update, re-query"
        @tier "domain"
      REFETCH_FILTER {
        entity : string!
        field : string!
        value : string!
        query : string
      }
        @description "Triggers a gallery refresh based on current filter criteria."
        @synonyms "refresh, filter, update, reload"
        @tier "domain"
      REFETCH_PAGE {
        page : number!
      }
        @description "Triggers a gallery page refresh."
        @synonyms "reload, refresh, update, paginate"
        @tier "domain"
      VIEW {
        id : string!
        row : GalleryItem!
      }
        @description "Indicates a GalleryItem has been selected for viewing."
        @synonyms "select, choose, display"
        @tier "domain"
      CLOSE
        @description "Indicates the gallery or lightbox has been dismissed."
        @synonyms "dismiss, hide, close, cancel"
        @tier "domain"
      GalleryItemLoaded {
        data : [GalleryItem]!
        totalCount : number!
      }
        @description "Indicates a GalleryItem has finished loading."
        @synonyms "loaded, ready, available"
        @tier "internal"
      GalleryItemPageLoaded {
        data : [GalleryItem]
        totalCount : number
      }
        @description "Indicates one page of GalleryItem finished loading after a search, filter or page change."
        @synonyms "page loaded, results loaded, filtered"
        @tier "internal"
      GalleryItemLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a GalleryItem failed to load."
        @synonyms "error, fail, problem, loading issue"
        @tier "internal"
    }

    config {
      title : string = Gallery
        @label "Section title"
        @description "Heading shown above the image gallery"
        @tier "presentation"
      nameField : field @entity string = name
        @label "Name field"
        @description "Entity field providing the lightbox alt text and caption for the selected item"
        @synonyms "title field, label field"
        @tier "presentation"
      imageField : field @entity string = imageUrl
        @label "Image field"
        @description "Entity field holding the image URL shown in the lightbox for the selected item"
        @synonyms "image url field, thumbnail field, src field"
        @tier "presentation"
      searchField : field @entity string = name
        @label "Which column does the search box match against?"
        @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `name` column must set this to a real field (e.g. title, caption) or the search box can never match a row."
        @synonyms "search column, search on field, match field, search key"
        @tier "policy"
      relatedMaxRows : number = 500
        @label "Related rows matched per search"
        @description "Most related-entity rows one relation search may match. The search turns the matches into the ids that narrow the main read, so a partial set would hide results; a search matching more is refused through the failure event instead of showing part of it."
        @synonyms "relation search cap, related match limit, search match cap"
        @tier "policy"
      relatedEntity : entity = GalleryItem
        @label "Related entity"
        @description "The entity a relation search matches through: the target of searchRelation."
        @tier "presentation"
      searchRelation : (field @entity (@entity @config.relatedEntity))?
        @label "Search through relation"
        @description "A relation field of the searched entity. When set, the query matches the related rows' relatedSearchField and the results are the rows pointing at them; unset, searchField on the row itself is matched."
        @tier "presentation"
      relatedSearchField : (field (@entity @config.relatedEntity) string)?
        @label "Related search field"
        @description "Field of the related entity matched against the query when searchRelation is set."
        @tier "presentation"
      bodySearch : boolean = false
        @label "Show the gallery's own search box?"
        @description "Embeds a search box above the gallery grid. Set false (the default) when the page already provides a search affordance (a toolbar Search molecule), so the surface shows one search box instead of two."
        @synonyms "inline search, list search, built-in search, show search, duplicate search"
        @tier "presentation"
      searchPlaceholder : string = "Search…"
        @label "Search box placeholder text"
        @description "Hint text inside the gallery search box (e.g. 'Search photos…')."
        @synonyms "search hint, placeholder, search box text, search label"
        @tier "presentation"
      filters : [FilterSpec] = []
        @label "Which filters should appear above the gallery?"
        @description "Dropdown filter facets by field, rendered as an embedded filter bar above the grid; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this gallery and routes `XFilter.FILTER -> REFETCH_FILTER` — that is the wired owner and remains the primary path. Use this knob only for a standalone gallery with no page-level filter affordance."
        @synonyms "filter bar, faceted filters, field filters, dropdowns"
        @tier "presentation"
      filterBarLook : "toolbar" | "chips" | "pills" | "popover-trigger" | "inline-column-header" = toolbar
        @label "Filter bar look"
        @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty."
        @synonyms "filter bar style, facet style, chips, pills"
        @tier "presentation"
      maxRows : number = 500
        @label "Gallery image cap"
        @description "Most images one whole-gallery load may return. The grid shows every image, so a partial read would hide images; a gallery holding more is refused through GalleryItemLoadFailed instead of showing part of it. Search, filter and REFETCH_PAGE reads use pageSize."
        @synonyms "gallery limit, image cap, max images"
        @tier "policy"
      pageSize : number = 20
        @label "How many images to fetch per page?"
        @description "Images per page for search, filter and page-change reads, which render their own page bar. The first load reads the whole gallery up to maxRows."
        @synonyms "fetch limit, records per page, batch size, page limit"
        @tier "presentation"
    }
  }

  page "/galleryitems/gallery" as GalleryItemGalleryPage -> GalleryItemGallery, LoadingSpinner, LoadingCaption, GalleryIcon, TitleDivider, ErrorAlert, ReloadSpinner, ReloadCaption, RetrySpinner
}