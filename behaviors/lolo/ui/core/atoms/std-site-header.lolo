app std-site-header "1.0.0"
"std-site-header — the sticky top bar of a public website: brand (logo + name, linking home when `homeHref` is set), navigation links with the current page marked (a link with children opens a dropdown), an optional light/dark toggle, an optional language picker (std-language-picker: the same page in each language, default language at the root and the others under /<code>/), and an optional call-to-action button. On small screens the links fold into a menu opened by a toggle, with child links indented under their parent and the call-to-action button at the bottom. Links follow `href` (in-app path, #anchor, or absolute URL); the header action and the small-screen menu links also emit NAV_CLICKED { href, label }. Pick for marketing sites, docs portals and product websites; for signed-in app chrome use std-app-layout."
type SiteNavLink = { label : string!, href : string!, children : [SiteNavLink] }
type SiteLanguage = { code : string!, label : string!, href : string! }
orbital SiteHeaderOrbital {
  uses LanguagePicker from "std/behaviors/std-language-picker"

  entity SiteHeaderView [runtime] {
    id : string!
    menuOpen : boolean = false
  }

  trait SiteHeaderRender -> @rebindable SiteHeaderView [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.menuOpen false)
        (render-ui main @config.headerContent)
      MENU_TOGGLE -> idle
        (set @entity.menuOpen (not @entity.menuOpen))
        (render-ui main @config.headerContent)
      NAV_LINK -> idle
        (set @entity.menuOpen false)
        (render-ui main @config.headerContent)
        (emit NAV_CLICKED { href: ?href, label: ?label })
    }

    emits {
      NAV_CLICKED -> external {
        href : string
        label : string
      }
        @description "A navigation link or the header action was clicked; carries its href and label."
        @synonyms "menu click, nav click, header link"
        @tier "domain"
    }

    listens {
      NAV_LINK {
        href : string
        label : string
      }
        @description "Navigation link click."
        @tier "internal"
    }

    config {
      brandName : string = "Almadar"
        @label "Brand name"
        @synonyms "site name, company, logo text"
        @tier "presentation"
      logoSrc : string = ""
        @label "Logo image"
        @description "Logo URL; empty shows the name only"
        @tier "presentation"
      homeHref : string = ""
        @label "Home link"
        @description "Where the brand (logo + name) links to, usually the site's home page; empty leaves the brand unlinked"
        @synonyms "logo link, home page, brand link"
        @tier "presentation"
      links : [SiteNavLink] = [{ label: "Features", href: "/features" }, { label: "Pricing", href: "/pricing" }, { label: "About", href: "/about" }]
        @label "Navigation links"
        @synonyms "menu, nav items, top navigation"
        @tier "presentation"
      currentPath : string = "/"
        @label "Current page path"
        @description "Marks the matching link as active"
        @tier "presentation"
      languages : [SiteLanguage] = []
        @label "Languages"
        @description "Every language this page exists in, each named in its own language, with the href of THIS page in that language (default language at the root, others under /<code>/). Empty hides the language picker."
        @synonyms "locales, translations, language switcher, i18n"
        @tier "presentation"
      showThemeToggle : boolean = false
        @label "Light/dark toggle"
        @description "Show a button that switches the site between its light and dark mode"
        @synonyms "dark mode, theme switch, color mode"
        @tier "presentation"
      currentLanguage : string = "en"
        @label "Current language"
        @description "The code of the language this page is in"
        @synonyms "locale, active language, page language"
        @tier "presentation"
      actionLabel : string = ""
        @label "Header action label"
        @description "Call-to-action button at the right; empty hides it"
        @synonyms "cta, sign up button, get started"
        @tier "presentation"
      actionHref : string = ""
        @label "Header action link"
        @tier "presentation"
      headerContent : render-ui = {
        type: stack
        direction: vertical
        gap: none
        className: "sticky top-0 z-50"
        children: [{
          type: header
          variant: desktop
          sticky: false
          showMenuToggle: false
          brandName: @config.brandName
          logoSrc: @config.logoSrc
          brandHref: @config.homeHref
          className: "hidden lg:flex"
          navigationItems: (array/map @config.links (fn entry {
            label: (object/get @entry label "")
            href: (object/get @entry href "")
            active: (== (object/get @entry href "") @config.currentPath)
            children: (array/map (object/get @entry children []) (fn child {
              label: (object/get @child label "")
              href: (object/get @child href "")
              active: (== (object/get @child href "") @config.currentPath)
            }))
          }))
          actions: [@trait.SiteHeaderLanguages, { type: theme-toggle, size: sm, className: (if @config.showThemeToggle "" hidden) }, {
            type: button
            label: @config.actionLabel
            href: @config.actionHref
            variant: primary
            size: sm
            action: NAV_LINK
            actionPayload: { href: @config.actionHref, label: @config.actionLabel }
            className: (if (== @config.actionLabel "") hidden "")
          }]
        }, {
          type: header
          variant: mobile
          sticky: false
          showMenuToggle: true
          isMenuOpen: @entity.menuOpen
          onMenuToggle: MENU_TOGGLE
          brandName: @config.brandName
          logoSrc: @config.logoSrc
          brandHref: @config.homeHref
          className: "lg:hidden"
          actions: [@trait.SiteHeaderLanguages, { type: theme-toggle, size: sm, className: (if @config.showThemeToggle "" hidden) }]
        }, {
          type: stack
          direction: vertical
          gap: xs
          align: stretch
          className: (if @entity.menuOpen "lg:hidden border-b border-border bg-card px-4 py-3" hidden)
          children: [{
          type: stack
          direction: vertical
          gap: xs
          align: stretch
          children: (array/map @config.links (fn (entry) {
            type: stack
            direction: vertical
            gap: xs
            align: stretch
            children: [{
              type: button
              variant: (if (== (object/get @entry href "") @config.currentPath) secondary ghost)
              label: (object/get @entry label "")
              href: (object/get @entry href "")
              action: NAV_LINK
              actionPayload: { href: (object/get @entry href ""), label: (object/get @entry label "") }
              className: "justify-start"
            }, {
              type: stack
              direction: vertical
              gap: xs
              align: stretch
              className: "ps-6"
              children: (array/map (object/get @entry children []) (fn (child) {
                type: button
                variant: (if (== (object/get @child href "") @config.currentPath) secondary ghost)
                label: (object/get @child label "")
                href: (object/get @child href "")
                action: NAV_LINK
                actionPayload: { href: (object/get @child href ""), label: (object/get @child label "") }
                className: "justify-start"
              }))
            }]
          }))
          }, {
            type: button
            label: @config.actionLabel
            href: @config.actionHref
            variant: primary
            size: md
            action: NAV_LINK
            actionPayload: { href: @config.actionHref, label: @config.actionLabel }
            className: (if (== @config.actionLabel "") hidden "mt-2 w-full")
          }]
        }]
      }
        @label "Header body"
        @tier "internal"
    }
  }

  trait SiteHeaderLanguages = LanguagePicker.traits.LanguagePickerRender -> SiteHeaderView {
    config {
      languages: @config.languages
      currentLanguage: @config.currentLanguage
    }
  }

  page "/site-header" as SiteHeaderPage -> SiteHeaderRender, SiteHeaderLanguages
}
