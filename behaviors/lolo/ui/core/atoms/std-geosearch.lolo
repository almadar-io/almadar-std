app std-geosearch [
  version: "1.0.0",
  description: "std-geosearch — location-aware search variant: search-input + map-view + range-slider for radius. Owns a GeoSearchResult runtime entity; GEO_SEARCH persists @payload.searchTerm/lat/lng/radiusKm so cross-trait listeners can route them into geo-aware data atoms."
]
orbital GeoSearchResultOrbital {
  uses UiSearchInput from "std/behaviors/ui-search-input"
  uses UiMapView from "std/behaviors/ui-map-view"
  uses UiRangeSlider from "std/behaviors/ui-range-slider"
  uses UiStack from "std/behaviors/ui-stack"
  entity GeoSearchResult [runtime] {
    id : string!
    searchTerm : string @description "The user's search query string." @synonyms "query, text, input" = ""
    centerLat : number @description "Latitude coordinate of the search center." @synonyms "lat, y, north" = 0
    centerLng : number @description "The longitude coordinate of the search center." @synonyms "longitude, lng" = 0
    radiusKm : number @description "The search radius in kilometers." @synonyms "range, distance, extent" = 10
    boundsNorth : number @description "Northern boundary coordinate of the search area." @synonyms "north, upper, top"
    boundsSouth : number @description "Southern boundary coordinate of the search area." @synonyms "south, bottom, lowerBoundary"
    boundsEast : number @description "The eastern boundary coordinate of the search area." @synonyms "east, right, longitude"
    boundsWest : number @description "Western boundary coordinate of the search area." @synonyms "west, longitude, x"
  }

  trait GeoSearchResultSearch -> GeoSearchResult [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.radiusKm @config.defaultRadiusKm)
        (set @entity.searchTerm "")
        (set @entity.centerLat @config.defaultCenterLat)
        (set @entity.centerLng @config.defaultCenterLng)
        (render-ui main {
          children: [{
            event: GEO_TERM
            placeholder: @config.placeholder
            type: search-input
          }, {
            centerLat: @entity.centerLat
            centerLng: @entity.centerLng
            height: "240px"
            markers: []
            type: map-view
            zoom: 12
          }, {
            action: GEO_RADIUS
            max: 100
            min: 1
            showTooltip: true
            step: 1
            type: range-slider
            value: @entity.radiusKm
          }]
          direction: vertical
          gap: md
          type: stack
        })
      GEO_TERM -> idle
        (set @entity.searchTerm ?searchTerm)
        (emit GEO_SEARCH { searchTerm: @entity.searchTerm, lat: @entity.centerLat, lng: @entity.centerLng, radiusKm: @entity.radiusKm })
        (render-ui main {
          children: [{
            event: GEO_TERM
            placeholder: @config.placeholder
            type: search-input
          }, {
            centerLat: @entity.centerLat
            centerLng: @entity.centerLng
            height: "240px"
            markers: []
            type: map-view
            zoom: 12
          }, {
            action: GEO_RADIUS
            max: 100
            min: 1
            showTooltip: true
            step: 1
            type: range-slider
            value: @entity.radiusKm
          }]
          direction: vertical
          gap: md
          type: stack
        })
      GEO_RADIUS -> idle
        (set @entity.radiusKm ?value)
        (emit GEO_SEARCH { searchTerm: @entity.searchTerm, lat: @entity.centerLat, lng: @entity.centerLng, radiusKm: @entity.radiusKm })
        (render-ui main {
          children: [{
            event: GEO_TERM
            placeholder: @config.placeholder
            type: search-input
          }, {
            centerLat: @entity.centerLat
            centerLng: @entity.centerLng
            height: "240px"
            markers: []
            type: map-view
            zoom: 12
          }, {
            action: GEO_RADIUS
            max: 100
            min: 1
            showTooltip: true
            step: 1
            type: range-slider
            value: @entity.radiusKm
          }]
          direction: vertical
          gap: md
          type: stack
        })
    }

    emits {
      GEO_SEARCH -> external {
        searchTerm : string!
        lat : number!
        lng : number!
        radiusKm : number!
      }
        @description "A search request: the term, the center and the radius the person has set."
        @synonyms "search, locate, find, query"
        @tier "domain"
    }

    listens {
      GEO_TERM {
        searchTerm : string!
      }
        @description "The person entered a search term."
        @tier "internal"
      GEO_RADIUS {
        value : number!
      }
        @description "The person moved the radius slider."
        @tier "internal"
    }

    config {
      placeholder : string = "Search nearby…"
        @label "Search placeholder"
        @description "Hint text in the location search input"
        @tier "presentation"
      defaultRadiusKm : number = 10
        @label "Default radius (km)"
        @description "Initial search radius around the chosen center"
        @tier "presentation"
      defaultCenterLat : number = 0
        @label "Default center latitude"
        @description "Latitude the map and the search start centered on"
        @tier "presentation"
      defaultCenterLng : number = 0
        @label "Default center longitude"
        @description "Longitude the map and the search start centered on"
        @tier "presentation"
    }
  }

  page "/geosearchresults/search" as GeoSearchResultSearchPage -> GeoSearchResultSearch
}