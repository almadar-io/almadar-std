app std-collection-fetch [
  version: "1.0.0",
  description: "std-collection-fetch — headless collection fetcher. On INIT it fetches every row of the linked entity and emits CollectionItemLoaded for a sibling (stats, list) to consume; a failure emits CollectionItemLoadFailed and notifies with config.failureMessage followed by the error. Renders nothing."
]
uses Spec from "almadar-std/collection-fetch"

orbital CollectionItemOrbital {
  entity CollectionItem [runtime] {
    id : string!
  }

  trait CollectionItemFetcher -> @rebindable CollectionItem {
    initial: idle

    state idle {
      INIT -> idle
        (fetch CollectionItem {
          limit: @config.maxRows
          emit: { failure: CollectionItemLoadFailed, success: CollectionItemLoaded }
        })
      CollectionItemLoadFailed -> idle
        (notify error (if (validate/required ?error) (str/concat @config.failureMessage " — " ?error) @config.failureMessage))
    }

    emits {
      CollectionItemLoaded -> external {
        data : [@entity]!
        totalCount : number
      }
        @description "Signals the fetched rows are ready."
        @tier "internal"
      CollectionItemLoadFailed -> external
        @description "Indicates the rows failed to load."
        @tier "internal"
    }

    listens {
      CollectionItemLoadFailed {
        error : string
        code : string
      }
        @description "Indicates the rows failed to load."
        @tier "internal"
    }

    config {
      failureMessage : string = "Couldn't load the collection"
        @label "Failure message"
        @description "Shown in the error toast when the fetch fails; the error text follows it."
        @tier "presentation"
      maxRows : number = 10000
        @label "Most rows per load"
        @description "A sibling computes counts and sums from these rows, so the load reads the whole collection up to this many rows; figures over a larger collection are computed from the first rows only until the store computes them."
        @tier "policy"
    }
  }

  page "/collectionitems" as CollectionItemPage -> CollectionItemFetcher
}
