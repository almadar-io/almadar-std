app std-canvas-theme [
  version: "1.0.0",
  description: "std-canvas-theme — the drawing axes a native canvas paints with, resolved from the merged theme tokens (twin of orbital-core canvas_theme.rs, pinned by 124 Chromium fixtures). CANVAS_THEME_RESOLVE reads the color, typography, radii and type-scale tokens plus the diagram, geometry and surface strings (an absent token is the empty string) and emits CANVAS_THEME_RESULT: the 22 tones, the 8 series, the ground and surfaces as the rgb() or rgba() text Chromium computes, strokes, dash and dot lists, fill, marker, label, text sizes and corner. A missing series color rotates the primary hue in oklch by 45 degrees per step; hex, rgb() and rgba() tokens parse, any other form stays unresolved."
]
uses Spec from "almadar-std/canvas-theme"

type TokDensitySpacing = { space0 : string?, space1 : string?, space2 : string?, space3 : string?, space4 : string?, space5 : string?, space6 : string?, space7 : string?, space8 : string?, space9 : string?, space10 : string?, space11 : string?, space12 : string? }
type TokDensity = { spacing : TokDensitySpacing?, buttonHeightSm : string?, buttonHeightMd : string?, buttonHeightLg : string?, inputHeightSm : string?, inputHeightMd : string?, inputHeightLg : string?, rowHeightCompact : string?, rowHeightNormal : string?, rowHeightSpacious : string?, cardPaddingSm : string?, cardPaddingMd : string?, cardPaddingLg : string?, dialogPadding : string?, sectionGap : string? }
type TokTypeScaleScaleXs = { size : string?, lineHeight : string? }
type TokTypeScaleScaleSm = { size : string?, lineHeight : string? }
type TokTypeScaleScaleBase = { size : string?, lineHeight : string? }
type TokTypeScaleScaleLg = { size : string?, lineHeight : string? }
type TokTypeScaleScaleXl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN2xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN3xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN4xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleDisplay1 = { size : string?, lineHeight : string? }
type TokTypeScaleScaleDisplay2 = { size : string?, lineHeight : string? }
type TokTypeScaleScale = { xs : TokTypeScaleScaleXs?, sm : TokTypeScaleScaleSm?, base : TokTypeScaleScaleBase?, lg : TokTypeScaleScaleLg?, xl : TokTypeScaleScaleXl?, "2xl" : TokTypeScaleScaleN2xl?, "3xl" : TokTypeScaleScaleN3xl?, "4xl" : TokTypeScaleScaleN4xl?, display-1 : TokTypeScaleScaleDisplay1?, display-2 : TokTypeScaleScaleDisplay2? }
type TokTypeScaleIntentsHeadingMajor = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsHeadingMinor = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyEmphasis = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyDefault = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyQuiet = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsCaption = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsNumeric = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntents = { headingMajor : TokTypeScaleIntentsHeadingMajor?, headingMinor : TokTypeScaleIntentsHeadingMinor?, bodyEmphasis : TokTypeScaleIntentsBodyEmphasis?, bodyDefault : TokTypeScaleIntentsBodyDefault?, bodyQuiet : TokTypeScaleIntentsBodyQuiet?, caption : TokTypeScaleIntentsCaption?, numeric : TokTypeScaleIntentsNumeric? }
type TokTypeScale = { displayFamily : string?, bodyFamily : string?, monoFamily : string?, headingWeight : string?, headingTransform : string?, headingTracking : string?, headingStyle : string?, headingShadow : string?, scale : TokTypeScaleScale?, intents : TokTypeScaleIntents?, fontImport : string? }
type TokMotionDurations = { instant : string?, fast : string?, normal : string?, slow : string?, dramatic : string? }
type TokMotionEasings = { linear : string?, standard : string?, emphasized : string?, spring : string? }
type TokMotionIntentsEnter = { duration : string?, easing : string? }
type TokMotionIntentsExit = { duration : string?, easing : string? }
type TokMotionIntentsHover = { duration : string?, easing : string? }
type TokMotionIntentsPress = { duration : string?, easing : string? }
type TokMotionIntentsExpand = { duration : string?, easing : string? }
type TokMotionIntentsTransition = { duration : string?, easing : string? }
type TokMotionIntents = { enter : TokMotionIntentsEnter?, exit : TokMotionIntentsExit?, hover : TokMotionIntentsHover?, press : TokMotionIntentsPress?, expand : TokMotionIntentsExpand?, transition : TokMotionIntentsTransition? }
type TokMotionShapes = { modalEnter : string?, modalExit : string?, popoverEnter : string?, popoverExit : string?, toastEnter : string?, toastExit : string?, pageEnter : string?, enterRise : string?, enterScale : string?, enterSlide : string? }
type TokMotionEntry = { default : string?, stagger : string? }
type TokMotion = { durations : TokMotionDurations?, easings : TokMotionEasings?, intents : TokMotionIntents?, shapes : TokMotionShapes?, entry : TokMotionEntry?, busyDelay : string?, awaitingSkeleton : boolean? }
type TokIconography = { family : string?, strokeWidth : string?, defaultSize : string? }
type TokElevation = { cardElevation : string?, popoverElevation : string?, dialogElevation : string?, toastElevation : string?, interactiveElevation : string?, pressedElevation : string? }
type TokGeometry = { radiusContainer : string?, radiusInteractive : string?, radiusPill : string?, borderHairline : string?, borderStandard : string?, borderHeavy : string?, cornerShape : string?, cornerShapePill : string?, cornerShapeInteractive : string?, borderStyle : string?, borderStyleInteractive : string? }
type TokIllustration = { loadingAsset : string?, style : string? }
type TokSurface = { backdrop : string?, cardImage : string?, pageImage : string?, pageImageSize : string?, diagram : string?, edgeMask : string?, edgeHeight : string?, textureMask : string?, textureSize : string?, accentImage : string?, scrim : string? }
type TokDiagram = { strokeThin : string?, strokeNormal : string?, strokeBold : string?, lineCap : string?, lineJoin : string?, dash : string?, dot : string?, fillStyle : string?, fillOpacity : string?, roughness : string?, glow : string?, shadow : string?, marker : string?, labelFont : string?, labelSize : string?, labelWeight : string?, labelCase : string?, corner : string? }
type TokScene = { materialRoughness : string?, materialMetalness : string?, materialFlat : string?, materialOutline : string?, lightAmbient : string?, lightKey : string?, lightKeyColor : string?, fog : string? }
type ThemeTokens = { color : Map string string?, colors : Map string string?, radii : Map string string?, spacing : Map string string?, typography : Map string string?, shadows : Map string string?, density : TokDensity?, typeScale : TokTypeScale?, motion : TokMotion?, iconography : TokIconography?, elevation : TokElevation?, geometry : TokGeometry?, illustration : TokIllustration?, surface : TokSurface?, diagram : TokDiagram?, scene : TokScene? }


orbital CanvasThemeOrbital {
  uses Theme from "std/behaviors/std-theme-resolve"

  entity CanvasThemeRun [runtime] {
    id : string!
    plist : [[number]] @description "Every color token and the type-scale ground parsed to rgba lists, empty when unparsable." = []
    pm : Map string [number] @description "The parsed colors by token key." = {}
    derived : [[number]] @description "The primary and its seven oklch hue rotations." = []
    px : [[number]] @description "Each px-bearing token parsed to a one-item list, empty when unparsable." = []
    colorsOut : [string] @description "The computed css text of the 22 tones then ground, muted, card and primary-foreground, empty when unresolved." = []
    ground : string = ""
    surfaceMuted : string = ""
    surfaceCard : string = ""
    surfaceOnPrimary : string = ""
    tones : Map string string = {}
    series : [string] = []
    strokeThin : number = 0
    strokeNormal : number = 0
    strokeBold : number = 0
    lineCap : string = ""
    lineJoin : string = ""
    dash : [number] = []
    dot : [number] = []
    fillStyle : string = ""
    fillOpacity : number = 0
    marker : string = ""
    labelSize : string = ""
    labelWeight : string = ""
    labelUppercase : boolean = false
    text : Map string number = {}
    corner : number = 0
  }

  trait CtMerge = Theme.traits.ThemeResolve {
    listens {
      CanvasTheme.THEME_MERGE -> THEME_MERGE
    }
  }

  trait CanvasTheme -> CanvasThemeRun [lifecycle, instance] {
    initial: ready

    state ready {
      INIT -> ready
      CANVAS_THEME_PRESET -> ready
        (emit THEME_MERGE { mode: (if (str/endsWith ?key "-dark") "dark" "light"), base: ?base, variant: ?variant })
      THEME_MERGED -> ready
        (emit CANVAS_THEME_RESOLVE { colors: (object/get ?tokens "colors" {}), typography: (object/get ?tokens "typography" {}), radii: (object/get ?tokens "radii" {}), textSizes: (object/set (object/set (object/set (object/set (object/set (object/set {} "xs" (object/get ?tokens "typeScale.scale.xs.size" "")) "sm" (object/get ?tokens "typeScale.scale.sm.size" "")) "base" (object/get ?tokens "typeScale.scale.base.size" "")) "lg" (object/get ?tokens "typeScale.scale.lg.size" "")) "xl" (object/get ?tokens "typeScale.scale.xl.size" "")) "2xl" (object/get ?tokens "typeScale.scale.2xl.size" "")), surfaceDiagram: (object/get ?tokens "surface.diagram" ""), strokeThin: (object/get ?tokens "diagram.strokeThin" ""), strokeNormal: (object/get ?tokens "diagram.strokeNormal" ""), strokeBold: (object/get ?tokens "diagram.strokeBold" ""), borderHairline: (object/get ?tokens "geometry.borderHairline" ""), borderStandard: (object/get ?tokens "geometry.borderStandard" ""), borderHeavy: (object/get ?tokens "geometry.borderHeavy" ""), corner: (object/get ?tokens "diagram.corner" ""), dash: (object/get ?tokens "diagram.dash" ""), dot: (object/get ?tokens "diagram.dot" ""), fillOpacity: (object/get ?tokens "diagram.fillOpacity" ""), fillStyle: (object/get ?tokens "diagram.fillStyle" ""), lineCap: (object/get ?tokens "diagram.lineCap" ""), lineJoin: (object/get ?tokens "diagram.lineJoin" ""), marker: (object/get ?tokens "diagram.marker" ""), labelSize: (object/get ?tokens "diagram.labelSize" ""), labelWeight: (object/get ?tokens "diagram.labelWeight" ""), labelCase: (object/get ?tokens "diagram.labelCase" ""), hasLabelSize: (object/has ?tokens "diagram.labelSize"), hasLabelWeight: (object/has ?tokens "diagram.labelWeight") })
      CANVAS_THEME_RESOLVE -> ready
        (set @entity.plist (array/map (array/append (object/values ?colors) ?surfaceDiagram) (fn v (let ((t (str/trim @v))) (if (str/startsWith @t "#") (if (validate/pattern @t "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$") (let ((ds (array/map (str/split (str/lower (str/slice @t 1 (str/len @t))) "") (fn c (array/indexOf (str/split "0123456789abcdef" "") @c))))) (let ((n (array/len @ds))) (let ((ch (if (<= @n 4) (array/map @ds (fn d (* @d 17))) (array/map (array/range 0 (/ @n 2)) (fn i (+ (* (array/nth @ds (* @i 2)) 16) (array/nth @ds (+ (* @i 2) 1)))))))) (list (array/nth @ch 0) (array/nth @ch 1) (array/nth @ch 2) (if (> (array/len @ch) 3) (/ (array/nth @ch 3) 255) 1))))) []) (if (and (or (str/startsWith @t "rgba(") (str/startsWith @t "rgb(")) (str/endsWith @t ")")) (let ((toks (array/filter (str/split (str/replace-pattern (str/slice @t (if (str/startsWith @t "rgba(") 5 4) (- (str/len @t) 1)) "[,/\\s]+" " ") " ") (fn s (!= @s ""))))) (if (and (or (== (array/len @toks) 3) (== (array/len @toks) 4)) (array/every @toks (fn s (validate/pattern @s "^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?%?$")))) (let ((vals (array/map @toks (fn s (if (str/endsWith @s "%") (/ (str/to-number (str/slice @s 0 (- (str/len @s) 1))) 100) (str/to-number @s)))))) (list (array/nth @vals 0) (array/nth @vals 1) (array/nth @vals 2) (if (== (array/len @vals) 4) (array/nth @vals 3) 1))) [])) []))))))
        (set @entity.pm (let ((keys (object/keys ?colors))) (array/reduce (array/range 0 (array/len @keys)) {} (fn acc i (object/set @acc (array/nth @keys @i) (array/nth @entity.plist @i))))))
        (set @entity.derived (let ((p (object/get @entity.pm "primary" []))) (if (== (array/len @p) 0) (array/map (array/range 0 8) (fn n [])) (let ((lr (array/map (array/slice @p 0 3) (fn v (let ((x (/ @v 255))) (if (<= @x 0.04045) (/ @x 12.92) (math/pow (/ (+ @x 0.055) 1.055) 2.4))))))) (let ((r (array/nth @lr 0)) (g (array/nth @lr 1)) (b (array/nth @lr 2))) (let ((l (let ((q (+ (+ (* 0.4122214708 @r) (* 0.5363325363 @g)) (* 0.0514459929 @b)))) (if (< @q 0) (- 0 (math/pow (- 0 @q) 0.3333333333333333)) (math/pow @q 0.3333333333333333)))) (m (let ((q (+ (+ (* 0.2119034982 @r) (* 0.6806995451 @g)) (* 0.1073969566 @b)))) (if (< @q 0) (- 0 (math/pow (- 0 @q) 0.3333333333333333)) (math/pow @q 0.3333333333333333)))) (s (let ((q (+ (+ (* 0.0883024619 @r) (* 0.2817188376 @g)) (* 0.6299787005 @b)))) (if (< @q 0) (- 0 (math/pow (- 0 @q) 0.3333333333333333)) (math/pow @q 0.3333333333333333))))) (let ((okl (+ (+ (* 0.2104542553 @l) (* 0.793617785 @m)) (* -0.0040720468 @s))) (oa (+ (+ (* 1.9779984951 @l) (* -2.428592205 @m)) (* 0.4505937099 @s))) (ob (+ (+ (* 0.0259040371 @l) (* 0.7827717662 @m)) (* -0.808675766 @s)))) (let ((ch (math/sqrt (+ (* @oa @oa) (* @ob @ob))))) (let ((hue (if (< @ch 0.000001) 0 (let ((x (math/mod (* (math/atan2 @ob @oa) 57.29577951308232) 360))) (if (< @x 0) (+ @x 360) @x))))) (array/map (array/range 0 8) (fn n (if (== @n 0) @p (let ((l2 (math/clamp @okl 0.45 0.72)) (c2 (math/max @ch 0.12)) (h (let ((x (math/mod (+ @hue (* 45 @n)) 360))) (if (< @x 0) (+ @x 360) @x)))) (let ((a2 (* @c2 (math/cos (* @h 0.017453292519943295)))) (b2 (* @c2 (math/sin (* @h 0.017453292519943295))))) (let ((l3 (let ((w (+ (+ @l2 (* 0.3963377774 @a2)) (* 0.2158037573 @b2)))) (* @w (* @w @w)))) (m3 (let ((w (+ (- @l2 (* 0.1055613458 @a2)) (* -0.0638541728 @b2)))) (* @w (* @w @w)))) (s3 (let ((w (+ (- @l2 (* 0.0894841775 @a2)) (* -1.291485548 @b2)))) (* @w (* @w @w))))) (list (let ((u (+ (- (* 4.0767416621 @l3) (* 3.3077115913 @m3)) (* 0.2309699292 @s3)))) (math/clamp (* (if (<= @u 0.0031308) (* @u 12.92) (- (* 1.055 (math/pow @u (/ 1 2.4))) 0.055)) 255) 0 255)) (let ((u (+ (+ (* -1.2684380046 @l3) (* 2.6097574011 @m3)) (* -0.3413193965 @s3)))) (math/clamp (* (if (<= @u 0.0031308) (* @u 12.92) (- (* 1.055 (math/pow @u (/ 1 2.4))) 0.055)) 255) 0 255)) (let ((u (+ (- (* -0.0041960863 @l3) (* 0.7034186147 @m3)) (* 1.707614701 @s3)))) (math/clamp (* (if (<= @u 0.0031308) (* @u 12.92) (- (* 1.055 (math/pow @u (/ 1 2.4))) 0.055)) 255) 0 255)) (array/nth @p 3)))))))))))))))))
        (set @entity.px (array/map (list ?strokeThin ?strokeNormal ?strokeBold ?borderHairline ?borderStandard ?borderHeavy (object/get ?typography "border-width-thin" "") (object/get ?typography "border-width" "") (object/get ?typography "border-width-thick" "") ?corner (object/get ?radii "sm" "") (object/get ?textSizes "xs" "") (object/get ?textSizes "sm" "") (object/get ?textSizes "base" "") (object/get ?textSizes "lg" "") (object/get ?textSizes "xl" "") (object/get ?textSizes "2xl" "")) (fn v (let ((t (str/trim @v))) (let ((u (str/trim (if (str/endsWith @t "px") (str/slice @t 0 (- (str/len @t) 2)) @t)))) (if (validate/pattern @u "^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?$") (list (str/to-number @u)) []))))))
        (set @entity.colorsOut (array/map (array/concat (array/map [{ tone: "ink", key: "diagram-ink", alias: "foreground", n: 0 }, { tone: "label", key: "diagram-label", alias: "muted-foreground", n: 0 }, { tone: "guide", key: "diagram-guide", alias: "muted-foreground", n: 0 }, { tone: "axis", key: "diagram-axis", alias: "foreground", n: 0 }, { tone: "grid", key: "diagram-grid", alias: "border", n: 0 }, { tone: "highlight", key: "diagram-highlight", alias: "primary", n: 0 }, { tone: "fill", key: "diagram-fill", alias: "muted", n: 0 }, { tone: "series-1", key: "series-1", alias: "", n: 1 }, { tone: "series-2", key: "series-2", alias: "", n: 2 }, { tone: "series-3", key: "series-3", alias: "", n: 3 }, { tone: "series-4", key: "series-4", alias: "", n: 4 }, { tone: "series-5", key: "series-5", alias: "", n: 5 }, { tone: "series-6", key: "series-6", alias: "", n: 6 }, { tone: "series-7", key: "series-7", alias: "", n: 7 }, { tone: "series-8", key: "series-8", alias: "", n: 8 }, { tone: "primary", key: "primary", alias: "", n: 0 }, { tone: "accent", key: "accent", alias: "", n: 0 }, { tone: "success", key: "success", alias: "", n: 0 }, { tone: "warning", key: "warning", alias: "", n: 0 }, { tone: "error", key: "error", alias: "", n: 0 }, { tone: "info", key: "info", alias: "", n: 0 }, { tone: "muted", key: "muted-foreground", alias: "", n: 0 }] (fn e (let ((c1 (object/get @entity.pm @e.key []))) (if (> (array/len @c1) 0) @c1 (if (> @e.n 0) (array/nth @entity.derived (- @e.n 1)) (if (== @e.alias "") [] (object/get @entity.pm @e.alias []))))))) (let ((card (object/get @entity.pm "card" []))) (list (if (> (array/len (array/last @entity.plist)) 0) (array/last @entity.plist) @card) (object/get @entity.pm "muted" []) @card (object/get @entity.pm "primary-foreground" [])))) (fn c (if (== (array/len @c) 0) "" (let ((x (array/map (array/slice @c 0 3) (fn q (math/clamp (math/round @q) 0 255))))) (if (>= (array/nth @c 3) 1) (str/concat "rgb(" (array/nth @x 0) ", " (array/nth @x 1) ", " (array/nth @x 2) ")") (str/concat "rgba(" (array/nth @x 0) ", " (array/nth @x 1) ", " (array/nth @x 2) ", " (let ((tx (str/concat (array/nth @c 3)))) (if (str/includes @tx "e-") (let ((pr (str/split @tx "e-"))) (str/concat "0." (str/repeat "0" (- (str/to-int (array/nth @pr 1)) 1)) (str/replace (array/nth @pr 0) "." ""))) @tx)) ")")))))))
        (set @entity.tones (array/reduce (array/range 0 22) {} (fn acc i (object/set @acc (array/nth ["ink", "label", "guide", "axis", "grid", "highlight", "fill", "series-1", "series-2", "series-3", "series-4", "series-5", "series-6", "series-7", "series-8", "primary", "accent", "success", "warning", "error", "info", "muted"] @i) (let ((s (array/nth @entity.colorsOut @i))) (if (== @s "") "currentColor" @s))))))
        (set @entity.series (array/map (array/range 7 15) (fn i (let ((s (array/nth @entity.colorsOut @i))) (if (== @s "") "currentColor" @s)))))
        (set @entity.ground (or (array/nth @entity.colorsOut 22) "transparent"))
        (set @entity.surfaceMuted (or (array/nth @entity.colorsOut 23) "transparent"))
        (set @entity.surfaceCard (or (array/nth @entity.colorsOut 24) "transparent"))
        (set @entity.surfaceOnPrimary (or (array/nth @entity.colorsOut 25) "transparent"))
        (set @entity.strokeThin (array/first (array/flatten (list (array/nth @entity.px 0) (array/nth @entity.px 3) (array/nth @entity.px 6) (list 1)))))
        (set @entity.strokeNormal (if (> (array/len (array/nth @entity.px 1)) 0) (array/first (array/nth @entity.px 1)) (* (array/first (array/flatten (list (array/nth @entity.px 4) (array/nth @entity.px 7) (list 1)))) 1.5)))
        (set @entity.strokeBold (if (> (array/len (array/nth @entity.px 2)) 0) (array/first (array/nth @entity.px 2)) (* (array/first (array/flatten (list (array/nth @entity.px 5) (array/nth @entity.px 8) (list 2)))) 1.5)))
        (set @entity.lineCap (if (== ?lineCap "") "round" ?lineCap))
        (set @entity.lineJoin (if (== ?lineJoin "") "round" ?lineJoin))
        (set @entity.dash (let ((toks (array/filter (str/split (str/replace-pattern (str/trim ?dash) "[,\\s]+" " ") " ") (fn s (!= @s ""))))) (if (and (> (array/len @toks) 0) (array/every @toks (fn s (and (validate/pattern @s "^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?$") (>= (str/to-number @s) 0))))) (array/map @toks (fn s (str/to-number @s))) (list 6 4))))
        (set @entity.dot (let ((toks (array/filter (str/split (str/replace-pattern (str/trim ?dot) "[,\\s]+" " ") " ") (fn s (!= @s ""))))) (if (and (> (array/len @toks) 0) (array/every @toks (fn s (and (validate/pattern @s "^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?$") (>= (str/to-number @s) 0))))) (array/map @toks (fn s (str/to-number @s))) (list 1 4))))
        (set @entity.fillStyle (if (== ?fillStyle "") "tint" ?fillStyle))
        (set @entity.fillOpacity (if (validate/pattern (str/trim ?fillOpacity) "^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)([eE][+-]?[0-9]+)?$") (str/to-number (str/trim ?fillOpacity)) 0.18))
        (set @entity.marker (if (== ?marker "") "triangle" ?marker))
        (set @entity.labelSize (if ?hasLabelSize ?labelSize "sm"))
        (set @entity.labelWeight (if ?hasLabelWeight ?labelWeight (if (object/has ?typography "font-weight-medium") (object/get ?typography "font-weight-medium") "500")))
        (set @entity.labelUppercase (== ?labelCase "uppercase"))
        (set @entity.text (array/reduce (array/range 0 6) {} (fn acc i (object/set @acc (array/nth ["xs", "sm", "base", "lg", "xl", "2xl"] @i) (array/first (array/flatten (list (array/nth @entity.px (+ 11 @i)) (list (array/nth [12, 14, 16, 20, 24, 32] @i)))))))))
        (set @entity.corner (array/first (array/flatten (list (array/nth @entity.px 9) (array/nth @entity.px 10) (list 4)))))
        (emit CANVAS_THEME_RESULT { ground: @entity.ground, surfaceMuted: @entity.surfaceMuted, surfaceCard: @entity.surfaceCard, surfaceOnPrimary: @entity.surfaceOnPrimary, tones: @entity.tones, series: @entity.series, strokeThin: @entity.strokeThin, strokeNormal: @entity.strokeNormal, strokeBold: @entity.strokeBold, lineCap: @entity.lineCap, lineJoin: @entity.lineJoin, dash: @entity.dash, dot: @entity.dot, fillStyle: @entity.fillStyle, fillOpacity: @entity.fillOpacity, marker: @entity.marker, labelSize: @entity.labelSize, labelWeight: @entity.labelWeight, labelUppercase: @entity.labelUppercase, text: @entity.text, corner: @entity.corner })
    }

    emits {
      THEME_MERGE -> internal {
        mode : string
        base : ThemeTokens
        variant : ThemeTokens
      }
      CANVAS_THEME_RESOLVE -> internal {
        colors : Map string string!
        typography : Map string string!
        radii : Map string string!
        textSizes : Map string string!
        surfaceDiagram : string!
        strokeThin : string!
        strokeNormal : string!
        strokeBold : string!
        borderHairline : string!
        borderStandard : string!
        borderHeavy : string!
        corner : string!
        dash : string!
        dot : string!
        fillOpacity : string!
        fillStyle : string!
        lineCap : string!
        lineJoin : string!
        marker : string!
        labelSize : string!
        labelWeight : string!
        labelCase : string!
        hasLabelSize : boolean!
        hasLabelWeight : boolean!
      }
      CANVAS_THEME_RESULT -> external {
        ground : string
        surfaceMuted : string
        surfaceCard : string
        surfaceOnPrimary : string
        tones : Map string string
        series : [string]
        strokeThin : number
        strokeNormal : number
        strokeBold : number
        lineCap : string
        lineJoin : string
        dash : [number]
        dot : [number]
        fillStyle : string
        fillOpacity : number
        marker : string
        labelSize : string
        labelWeight : string
        labelUppercase : boolean
        text : Map string number
        corner : number
      }
        @description "The canvas theme resolved from the tokens."
        @synonyms "canvas theme, drawing tokens"
        @tier "primary"
    }

    listens {
      CtMerge.THEME_MERGED -> THEME_MERGED
      THEME_MERGED { tokens : ThemeTokens! }
        @description "The merged tokens arrive; resolve the canvas theme over them."
        @synonyms "merged theme tokens"
      CANVAS_THEME_PRESET { key : string!  base : ThemeTokens!  variant : ThemeTokens }
        @description "Resolve the canvas theme from one preset: the dark key merges the dark variant onto the base axis by axis, the colors map filling gaps from the base."
        @synonyms "resolve preset canvas theme"
      CANVAS_THEME_RESOLVE { colors : Map string string!  typography : Map string string!  radii : Map string string!  textSizes : Map string string!  surfaceDiagram : string!  strokeThin : string!  strokeNormal : string!  strokeBold : string!  borderHairline : string!  borderStandard : string!  borderHeavy : string!  corner : string!  dash : string!  dot : string!  fillOpacity : string!  fillStyle : string!  lineCap : string!  lineJoin : string!  marker : string!  labelSize : string!  labelWeight : string!  labelCase : string!  hasLabelSize : boolean!  hasLabelWeight : boolean! }
        @description "Resolve the canvas theme from the merged theme tokens."
        @synonyms "resolve canvas theme"
    }
  }

  page "/canvas-theme" as CanvasThemePage -> CanvasTheme, CtMerge
}
