app ui-box [
  version: "1.0.0",
  description: "Box — UI factory (1:1 with the @almadar/ui box pattern)."
]
;; @pattern "box"
orbital BoxOrbital {
  entity BoxItem [runtime] {
    id : string!
  }

  trait BoxRender -> @rebindable BoxItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          padding: @config.padding
          paddingX: @config.paddingX
          paddingY: @config.paddingY
          margin: @config.margin
          marginX: @config.marginX
          marginY: @config.marginY
          bg: @config.bg
          border: @config.border
          rounded: @config.rounded
          shadow: @config.shadow
          display: @config.display
          fullWidth: @config.fullWidth
          fullHeight: @config.fullHeight
          overflow: @config.overflow
          position: @config.position
          action: @config.action
          actionPayload: @config.actionPayload
          hoverEvent: @config.hoverEvent
          tapReveal: @config.tapReveal
          maxWidth: @config.maxWidth
          edgeTop: @config.edgeTop
          edgeBottom: @config.edgeBottom
          edgeColor: @config.edgeColor
          edgeFlip: @config.edgeFlip
          texture: @config.texture
          backdrop: @config.backdrop
          children: @config.children
          enter: @config.enter
          enterDelay: @config.enterDelay
          skeleton: @config.skeleton
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: box
        })
    }

    emits {
      @config.action -> external { }
        @description "Declarative event name — emits UI:{action} via eventBus on click"
        @tier "essential"
      @config.hoverEvent -> external {
        hovered : boolean!
      }
        @description "Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false } on mouseEnter/mouseLeave"
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes applied to the root element."
        @tier "presentation"
      padding : "none" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl" = md
        @label "Padding"
        @description "Padding on all sides"
        @tier "presentation"
      paddingX : "none" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl"
        @label "Padding X"
        @description "Horizontal padding (overrides padding for x-axis)"
        @tier "presentation"
      paddingY : "none" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl"
        @label "Padding Y"
        @description "Vertical padding (overrides padding for y-axis)"
        @tier "presentation"
      margin : "none" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "auto"
        @label "Margin"
        @description "Margin on all sides"
        @tier "presentation"
      marginX : "none" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "auto"
        @label "Margin X"
        @description "Horizontal margin"
        @tier "presentation"
      marginY : "none" | "xs" | "sm" | "md" | "lg" | "xl" | "2xl" | "auto"
        @label "Margin Y"
        @description "Vertical margin"
        @tier "presentation"
      bg : "transparent" | "primary" | "secondary" | "muted" | "accent" | "surface" | "overlay" | "gradient" | "inverse" = transparent
        @label "Bg"
        @description "Background color"
        @tier "presentation"
      border : boolean = true
        @label "Border"
        @description "Show border"
        @tier "presentation"
      rounded : "none" | "sm" | "md" | "lg" | "xl" | "2xl" | "full" = none
        @label "Rounded"
        @description "Border radius"
        @tier "presentation"
      shadow : "none" | "sm" | "md" | "lg" | "xl" = none
        @label "Shadow"
        @description "Box shadow"
        @tier "presentation"
      display : "block" | "inline" | "inline-block" | "flex" | "inline-flex" | "grid"
        @label "Display"
        @description "Display type"
        @tier "presentation"
      fullWidth : boolean = false
        @label "Full Width"
        @description "Fill available width"
        @tier "presentation"
      fullHeight : boolean = false
        @label "Full Height"
        @description "Fill available height"
        @tier "presentation"
      overflow : "auto" | "hidden" | "visible" | "scroll"
        @label "Overflow"
        @description "Overflow behavior"
        @tier "presentation"
      position : "relative" | "absolute" | "fixed" | "sticky"
        @label "Position"
        @description "Position"
        @tier "presentation"
      action : event = "ACTION"
        @label "Action"
        @description "Declarative event name — emits UI:{action} via eventBus on click"
        @tier "presentation"
      actionPayload : @payload @config.action
        @label "Action Payload"
        @description "Payload to include with the action event"
        @tier "presentation"
      hoverEvent : event = "HOVER"
        @label "Hover Event"
        @description "Declarative hover event — emits UI:{hoverEvent} with { hovered: true/false } on mouseEnter/mouseLeave"
        @tier "presentation"
      tapReveal : boolean = true
        @label "Tap Reveal"
        @description "When true (default), a touch/pen tap also fires `hoverEvent` (toggling hovered) so hover-only reveals work on touch."
        @tier "presentation"
      maxWidth : string
        @label "Max Width"
        @description "Maximum width (CSS value, e.g., '550px', '80rem')"
        @tier "presentation"
      edgeTop : "none" | "curve" | "wave" | "arc" | "tilt" | "step" | "scallop" = none
        @label "Edge Top"
        @description "Shape cut into the top edge of a full-width band; 'curve' uses the theme's shape"
        @tier "presentation"
      edgeBottom : "none" | "curve" | "wave" | "arc" | "tilt" | "step" | "scallop" = none
        @label "Edge Bottom"
        @description "Shape cut into the bottom edge of a full-width band; 'curve' uses the theme's shape"
        @tier "presentation"
      edgeColor : "background" | "muted" | "surface" | "gradient" | "inverse" = background
        @label "Edge Color"
        @description "Surface of the neighbouring band, which fills the cut"
        @tier "presentation"
      edgeFlip : boolean = false
        @label "Edge Flip"
        @description "Mirror the edge shapes horizontally"
        @tier "presentation"
      texture : boolean = false
        @label "Texture"
        @description "Lay the theme's texture over the band"
        @tier "presentation"
      backdrop : node
        @label "Backdrop"
        @description "Scene behind the band's content (photo, illustration, pattern); never takes clicks"
        @tier "presentation"
      children : node
        @label "Children"
        @description "Children elements"
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      skeleton : "header" | "table" | "list" | "grid" | "detail" | "stats" | "form" | "card" | "text" | "none"
        @label "Skeleton"
        @description "Skeleton shown while this element's server render is in flight: a shape (`table`, `list`, …), `{ variant, rows?, columns?, fields? }`, or `none`."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/box" as BoxPage -> BoxRender
}
