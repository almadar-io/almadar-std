app std-selection "1.0.0"
"std-selection as a Function"
type FilterSpec = { field : string!, label : string, options : [string] }
orbital SelectableItemOrbital {
    type SelectableItemLoaded = Event { data : [SelectableItem] } "Fired when SelectableItem finishes loading; payload.data holds the list"

    type SelectableItemLoadFailed = Event { error : string, code : string } "Fired when SelectableItem fails to load"

  entity SelectableItem [runtime] {
    id : string!
    name : string! @description "The item's display text or identifier." @synonyms "label, title, identifier"
    description : string @description "A textual explanation of the item." @synonyms "details, explanation, notes"
    status : "active" | "inactive" | "pending" @description "Indicates the current operational state of the item." @synonyms "state, condition, flag" = active
    createdAt : string
  }

  trait SelectableItemSelection -> @rebindable SelectableItem [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SelectableItemLoaded -> idle
        (render-ui main {
          children: [{
            align: center
            children: [{ name: check-square, type: icon }, {
              content: SelectableItems
              type: typography
              variant: h2
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if [">", (array/len @config.filters), 0] {
            children: [{
              entity: SelectableItem
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), { type: divider }, {
            color: muted
            content: "Choose a selectableitem to continue."
            type: typography
            variant: caption
          }, {
            className: "transition-shadow hover:shadow-md cursor-pointer"
            entity: ?data
            fields: []
            itemActions: [{
              event: SELECT
              icon: check
              label: Select
            }]
            look: @config.tableLook
            pageSize: @config.displayPageSize
            renderItem: (fn item {
              align: center
              children: [{ label: @item.name, type: checkbox }]
              direction: horizontal
              gap: sm
              type: stack
            })
            type: data-grid
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      SelectableItemLoadFailed -> error
        (render-ui main {
          align: center
          children: [{
            color: error
            name: alert-triangle
            type: icon
          }, {
            content: "Failed to load"
            type: typography
            variant: h3
          }, {
            color: muted
            content: ?error
            type: typography
            variant: body
          }, {
            action: RETRY
            icon: rotate-ccw
            label: Retry
            type: button
            variant: primary
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state idle {
      ;; REFETCH_* stays in `idle` and DOES NOT replace the pick-list with a
      ;; spinner — same reasoning as std-browse's REFETCH_* arms: a skeleton
      ;; on refetch unmounts the list and flickers every keystroke. The fetch
      ;; fires in the background; the SelectableItemLoaded arm below
      ;; re-renders in place once it lands.
      REFETCH_QUERY -> idle
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
          filter: (or ["=", ?searchTerm, ""] (str/includes (object/get @entity name) ?searchTerm))
        })
      REFETCH_FILTER -> idle
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
          filter: (or ["=", ?value, ""] ["=", (object/get @entity ?field), ?value])
        })
      ;; No filter carried over on REFETCH_PAGE, mirroring std-browse exactly.
      ;; Paging is safe here: this atom's selection is a single transient id
      ;; carried only in the SELECT/CONFIRM_SELECTION payload (`?id`), never
      ;; accumulated into a persisted @entity array, so turning a page cannot
      ;; strand an "already selected" item — there is no multi-item selection
      ;; state to strand. A future multi-select variant that DOES accumulate
      ;; picks into an @entity field would need to carry that array across
      ;; REFETCH_PAGE explicitly; this single-pick atom does not need to.
      REFETCH_PAGE -> idle
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
          limit: @config.pageSize
          offset: ["*", ["-", ?page, 1], @config.pageSize]
        })
      SelectableItemLoaded -> idle
        (render-ui main {
          children: [{
            align: center
            children: [{ name: check-square, type: icon }, {
              content: SelectableItems
              type: typography
              variant: h2
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if [">", (array/len @config.filters), 0] {
            children: [{
              entity: SelectableItem
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), { type: divider }, {
            color: muted
            content: "Choose a selectableitem to continue."
            type: typography
            variant: caption
          }, {
            className: "transition-shadow hover:shadow-md cursor-pointer"
            entity: ?data
            fields: []
            itemActions: [{
              event: SELECT
              icon: check
              label: Select
            }]
            look: @config.tableLook
            pageSize: @config.displayPageSize
            renderItem: (fn item {
              align: center
              children: [{ label: @item.name, type: checkbox }]
              direction: horizontal
              gap: sm
              type: stack
            })
            type: data-grid
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      SELECT -> selecting
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [{ name: check-square, type: icon }, {
                content: SelectableItems
                type: typography
                variant: h2
              }]
              direction: horizontal
              gap: md
              type: stack
            }, {
              align: center
              children: [{ label: Selecting, type: badge }, {
                action: CLEAR
                icon: x
                label: Clear
                type: button
                variant: ghost
              }]
              direction: horizontal
              gap: sm
              type: stack
            }]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, { type: divider }, {
            message: ?id
            type: alert
            variant: info
          }, {
            children: [{
              action: CONFIRM_SELECTION
              actionPayload: { id: ?id }
              icon: check
              label: Confirm
              type: button
              variant: primary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: lg
          type: stack
        })
    }

    state selecting {
      CONFIRM_SELECTION -> selected
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [{ name: check-circle, type: icon }, {
                content: "Selection Confirmed"
                type: typography
                variant: h2
              }]
              direction: horizontal
              gap: md
              type: stack
            }, { label: Confirmed, type: badge }]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, { type: divider }, {
            message: "Selection confirmed successfully."
            type: alert
            variant: success
          }, {
            align: center
            children: [{
              content: "Selected ID:"
              type: typography
              variant: caption
            }, {
              content: ?id
              type: typography
              variant: body
            }]
            direction: horizontal
            gap: md
            type: stack
          }, {
            action: CLEAR
            icon: rotate-ccw
            label: "Clear Selection"
            type: button
            variant: ghost
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      CLEAR -> loading
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
        })
        (render-ui main { type: spinner })
    }

    state selected {
      CLEAR -> loading
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
        })
        (render-ui main { type: spinner })
    }

    state error {
      INIT -> loading
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
        })
        (render-ui main { type: spinner })
      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never
      ;; delivers it, so the affordance must target a first-class user event
      RETRY -> loading
        (fetch SelectableItem {
          emit: { failure: SelectableItemLoadFailed, success: SelectableItemLoaded }
        })
        (render-ui main { type: spinner })
    }

    emits {
      SelectableItemLoaded
        @description "Indicates a selectable item has been successfully loaded."
        @synonyms "loaded, initialized, ready"
        @tier "domain"
      SelectableItemLoadFailed
        @description "Indicates a selectable item failed to load."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
    }

    listens {
      SELECT {
        id : string!
      }
        @description "Indicates an item has been chosen."
        @synonyms "chosen, picked, highlighted"
        @tier "domain"
      CONFIRM_SELECTION {
        id : string!
      }
        @description "Indicates a selection has been finalized."
        @synonyms "accept, finalize, submit, choose"
        @tier "domain"
      SelectableItemLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a selectable item failed to load."
        @synonyms "error, failure, problem, load error"
        @tier "internal"
      REFETCH_QUERY {
        searchTerm : string!
      }
        @description "Triggers a pick-list refresh based on the current search term."
        @synonyms "refresh, reload, update, re-query, search"
        @tier "domain"
      REFETCH_FILTER {
        field : string!
        value : string!
      }
        @description "Triggers a pick-list refresh based on current filter criteria."
        @synonyms "refresh, filter, update, reload"
        @tier "domain"
      REFETCH_PAGE {
        page : number!
      }
        @description "Triggers a pick-list page refresh."
        @synonyms "reload, refresh, update, paginate"
        @tier "domain"
    }

    config {
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      bodySearch : boolean = false
        @label "Show the pick-list's own search box?"
        @description "Embeds a search box above the pick-list. Set true only when the page has no other search affordance (e.g. no page-level std-search), so the surface shows one search box instead of two. False is the default — this atom has never had a search box (0 consumers today)."
        @synonyms "inline search, list search, built-in search, show search"
        @tier "presentation"
      searchPlaceholder : string = "Search…"
        @label "Search box placeholder text"
        @description "Hint text inside the pick-list search box."
        @synonyms "search hint, placeholder, search box text"
        @tier "presentation"
      filters : [FilterSpec] = []
        @label "Which filters should appear above the pick-list?"
        @description "Dropdown filter facets by field, rendered as an embedded filter bar above the rows; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, the right setting whenever the page already composes std-filter beside this list and routes XFilter.FILTER -> REFETCH_FILTER — that is the wired owner and remains the primary path. Use this knob only for a standalone pick-list with no page-level filter affordance."
        @synonyms "filter bar, faceted filters, field filters, dropdowns"
        @tier "presentation"
      filterBarLook : "toolbar" | "chips" | "pills" | "popover-trigger" | "inline-column-header" = toolbar
        @label "Filter bar look"
        @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty."
        @synonyms "filter bar style, facet style, chips, pills"
        @tier "presentation"
      pageSize : number = 20
        @label "How many candidates per page when paging?"
        @description "Records fetched from the server per REFETCH_PAGE request. The initial load and search/filter refetches remain unpaginated (load every candidate) unless a consumer wires REFETCH_PAGE, so the default pick-list surface is unchanged. Safe to page: this atom's selection is a single transient id (never an accumulated array), so no already-picked item can be stranded on another page."
        @synonyms "fetch limit, records per page, page limit"
        @tier "presentation"
      displayPageSize : number = 20
        @label "How many candidates to show at once?"
        @description "Rows visible per page before the data-grid's own pagination control appears — 20 matches the pick-list density sweet spot (Miller's law, 10-25 rows)."
        @synonyms "visible rows, items per page, display limit, show per page"
        @tier "presentation"
    }
  }

  page "/selectableitems/selection" as SelectableItemSelectionPage -> SelectableItemSelection
}