app std-behavior-tour [
  version: "1.0.0",
  description: "std-behavior-tour — plays a real behavior through a scripted sequence so people can watch it work: a guided demo on a website, or a step-by-step tutorial. The composing program embeds the running behavior in the `demo` slot and lists `events` (the event each step sends) and `captions` (what is shown while it plays; only ever rendered, so they may be translated). The composed std-learn-transport owns Play / Pause / Step / Reset and the clock; on every step the tour emits TOUR_STEP { index, event } and shows that step's caption, and the program routes TOUR_STEP to the behavior's own events with a filtered listen (`Tour.TOUR_STEP -> MOVE when (= ?event \"MOVE\")`). Reset emits TOUR_RESET. `loop` quietly resets the demo after the last step (TOUR_RESET, intro caption) and plays again. `playWhenVisible` starts it the first time it scrolls into view (never under reduced motion), and `compact` keeps only Play / Pause and Reset. Pick to demonstrate or teach a behavior."
]

orbital BehaviorTourOrbital {
  entity TourScene [runtime, shared] {
    id : string!
    active : boolean = false
    title : string
    running : boolean = false
    steps : int = 0
    elapsedMs : number = 0
    done : boolean = false
    cursor : int = 0
    shown : int = -1
  }

  uses LearnTransport from "std/behaviors/std-learn-transport"

  trait TourTransport = LearnTransport.traits.LearnTransportSim -> TourScene {
    config {
      title: @config.title
      summary: @config.summary
      autoRun: @config.autoPlay
      stepIntervalMs: @config.stepIntervalMs
      runWhenVisible: false
      compact: @config.compact
      playLabel: @config.playLabel
      pauseLabel: @config.pauseLabel
      stepLabel: @config.stepLabel
      resetLabel: @config.resetLabel
      runningLabel: @config.runningLabel
      pausedLabel: @config.pausedLabel
      doneLabel: @config.doneLabel
      stepWord: @config.stepWord
      ofWord: @config.ofWord
      speedLabel: @config.speedLabel
    }

    listens {
      BehaviorTour.TOUR_PLAY -> TOGGLE_RUN
      SPEED_SET {
        speed : number
      }
        @description "The viewer picked a playback speed."
        @tier "presentation"
      MODE_SELECTED {
        mode : string
      }
        @description "Lab router broadcast naming the active mode."
        @tier "domain"
    }
  }

  trait TourEmptyDemo -> TourScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main null)
    }
  }

  trait BehaviorTour -> @rebindable TourScene [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.cursor 0)
        (set @entity.shown -1)
        (render-ui main @config.tourContent)
      LEARN_STEP -> idle when (and (== @entity.active true) (not (== @entity.done true)) (> (array/len @config.events) 0) (>= @entity.cursor (array/len @config.events)))
        (set @entity.cursor 0)
        (set @entity.shown -1)
        (emit TOUR_RESET { })
        (render-ui main @config.tourContent)
      LEARN_STEP -> idle when (and (== @entity.active true) (not (== @entity.done true)) (< @entity.cursor (array/len @config.events)))
        (let (
            (count (array/len @config.events))
            (at @entity.cursor)
            (next (+ @at 1))
          )
          (do
            (set @entity.shown @at)
            (set @entity.cursor @next)
            (set @entity.done (and (not @config.loop) (>= @next @count)))
            (emit TOUR_STEP { index: @at, event: (array/nth @config.events @at) })))
        (render-ui main @config.tourContent)
      TOUR_VISIBLE -> idle when (and (== @entity.active true) (not (== @entity.running true)) (not (== @entity.done true)))
        (emit TOUR_PLAY { })
        (render-ui main @config.tourContent)
      LEARN_RESET -> idle
        (set @entity.cursor 0)
        (set @entity.done false)
        (set @entity.shown -1)
        (emit TOUR_RESET { })
        (render-ui main @config.tourContent)
    }

    emits {
      TOUR_PLAY {
      }
        @description "The demo scrolled into view with playWhenVisible on: starts the composed transport's clock."
        @tier "internal"
      TOUR_STEP -> external {
        index : int
        event : string
      }
        @description "One scripted step: the program routes it to the demo behavior's own event with a filtered listen on `event`."
        @synonyms "tour step, demo step, tutorial step, next step"
        @tier "domain"
      TOUR_RESET -> external {
      }
        @description "Reset was pressed: the program returns the demo behavior to its starting state."
        @synonyms "restart tour, reset demo"
        @tier "domain"
    }

    listens {
      TourTransport.LEARN_STEP -> LEARN_STEP
      TourTransport.LEARN_RESET -> LEARN_RESET
      LEARN_STEP {
        steps : int
      }
        @description "One tick of the composed transport, or its Step button."
        @tier "internal"
      LEARN_RESET {
      }
        @description "The composed transport's Reset."
        @tier "internal"
    }

    config {
      title : string = ""
        @label "Title"
        @description "Shown in the control bar; empty hides it"
        @tier "presentation"
      summary : string = ""
        @label "Summary"
        @description "One line under the title; empty hides it"
        @tier "presentation"
      demo : trait = @trait.TourEmptyDemo
        @label "Demo"
        @description "The running behavior the tour plays, as a @trait reference"
        @tier "domain"
      events : [string] = []
        @label "Step events"
        @description "In order: the event name each step sends to the demo"
        @synonyms "script, walkthrough, tutorial steps"
        @tier "domain"
      captions : [string] = []
        @label "Step captions"
        @description "In the same order as the events: what is shown while each step plays (rendered only, so it may be translated)"
        @tier "presentation"
      introCaption : string = ""
        @label "Intro caption"
        @description "Shown before the first step and after Reset"
        @tier "presentation"
      autoPlay : boolean = false
        @label "Play on load"
        @description "Start playing as soon as the tour appears"
        @tier "presentation"
      loop : boolean = true
        @label "Loop"
        @description "Start again from the first step after the last one instead of stopping"
        @tier "presentation"
      playWhenVisible : boolean = false
        @label "Play when visible"
        @description "Start playing the first time the tour scrolls into view (never under reduced motion)"
        @tier "presentation"
      compact : boolean = true
        @label "Compact controls"
        @description "Show only Play / Pause and Reset"
        @tier "presentation"
      stepIntervalMs : number = 2200
        @label "Step interval"
        @description "Milliseconds each step stays on screen while playing"
        @tier "presentation"
      playLabel : string = "Play"
        @label "Play label"
        @tier "presentation"
      pauseLabel : string = "Pause"
        @label "Pause label"
        @tier "presentation"
      stepLabel : string = "Step"
        @label "Step label"
        @tier "presentation"
      resetLabel : string = "Reset"
        @label "Reset label"
        @tier "presentation"
      runningLabel : string = "Running"
        @label "Running label"
        @tier "presentation"
      pausedLabel : string = "Paused"
        @label "Paused label"
        @tier "presentation"
      doneLabel : string = "Done"
        @label "Done label"
        @tier "presentation"
      stepWord : string = "Step"
        @label "Step word"
        @tier "presentation"
      ofWord : string = "of"
        @label "Of word"
        @tier "presentation"
      speedLabel : string = "Speed"
        @label "Speed label"
        @tier "presentation"
      tourContent : render-ui = {
        type: stack
        direction: vertical
        gap: md
        children: [{
          type: animated-reveal
          trigger: scroll
          animation: none
          threshold: 0.4
          revealEvent: (if @config.playWhenVisible TOUR_VISIBLE "")
          children: [{
            type: card
            padding: lg
            children: [@config.demo]
          }]
        }, {
          type: stack
          direction: horizontal
          gap: sm
          align: start
          className: (if (and (< @entity.shown 0) (== @config.introCaption "")) hidden "")
          children: [{
            type: icon
            name: message-square-text
            size: md
            color: primary
          }, {
            type: typography
            variant: body
            content: (if (< @entity.shown 0) @config.introCaption (array/nth @config.captions @entity.shown))
          }]
        }, @trait.TourTransport]
      }
        @label "Tour layout"
        @tier "internal"
    }
  }

  page "/tour" as BehaviorTourPage -> BehaviorTour
}
