app std-youtube-embed [
  version: "2.0.1",
  description: "std-youtube-embed. YouTube iframe embed with ready and failed signals. Bind via `uses Youtube from \"std/behaviors/std-youtube-embed\"` and configure `videoId` / `autoplay` / `controls` / `start` at the call site. SPECIAL: the default render IS the embed itself, so passing `uiTrait: \"@trait.YourPlayerSkin\"` OVERRIDES the embed (e.g., a custom player skin) rather than supplements it. Leave `uiTrait` unset to render the atom's default embed. A replacement skin keeps the READY / FAILED producers by embedding `<Youtube.traits.YoutubePlayer />` (the shared YoutubeEmbed frame supplies the video) or its own video-embed with readyEvent READY and errorEvent FAILED."
]
orbital YoutubeEmbedOrbital {
    uses VideoEmbed from "std/behaviors/ui-video-embed"
    uses UiErrorState from "std/behaviors/ui-error-state"

    type YoutubeEmbedLoaded = Event { data : [YoutubeEmbed] } "Fired when YoutubeEmbed finishes loading"

    type YoutubeEmbedLoadFailed = Event { error : string } "Fired when YoutubeEmbed fails to load"

    type YoutubeEmbedReady = Event { videoId : string }

    type YoutubeEmbedFailed = Event { error : string, code : string }

  entity YoutubeEmbed [runtime, shared] {
    id : string!
    videoId : string @description "The unique identifier for the video." @synonyms "video identifier, video key, video reference" = ""
    autoplay : boolean @description "Indicates whether the video should begin playing automatically." @synonyms "auto-play, auto, play automatically" = false
    controls : boolean @description "Indicates whether embed controls are visible." @synonyms "show controls, control visibility, enable controls" = true
    start : number @description "The time (in seconds) to start playback." @synonyms "startTime, offset, position" = 0
    error : string @description "Contains an error message, if one occurred." @synonyms "message, problem, fault" = ""
    name : string @description "A user-friendly identifier for the YouTube embed." @synonyms "title, label, identifier"
    description : string @description "A textual explanation of the embed's function." @synonyms "explanation, details, summary"
    status : "active" | "inactive" | "pending" @description "Indicates the current operational state of the embed." @synonyms "state, condition, enabled" = active
    createdAt : string
  }

  ;; The embed itself: a video-embed bound to the shared YoutubeEmbed frame
  ;; (YoutubeEmbedHost's INIT stores videoId/autoplay/controls/start
  ;; there). The player's own ready / error signals are READY / FAILED, the
  ;; events the READY -> ready and FAILED -> error transitions below wait on;
  ;; its playing signal is PLAYBACK_STARTED. A custom `uiTrait` skin that wants
  ;; the same producers embeds `<YouTube.traits.YoutubePlayer />` (or its own
  ;; video-embed with readyEvent READY / errorEvent FAILED).
  trait YoutubePlayer = VideoEmbed.traits.VideoEmbedRender -> YoutubeEmbed {
    config {
      videoId: @entity.videoId
      autoplay: @entity.autoplay
      controls: @entity.controls
      start: @entity.start
      title: "YouTube video"
      readyEvent: READY
      playEvent: PLAYBACK_STARTED
      errorEvent: FAILED
    }
  }

  trait VideoErrorDisplay = UiErrorState.traits.ErrorStateRender -> YoutubeEmbed {
    config {
      message: @entity.error
      onRetry: RETRY
      title: "Video Failed"
    }
  }

  ;; Default UI: a sibling trait whose painting IS the YouTube embed surface.
  ;; Consumers override `uiTrait` to REPLACE the embed with a skinned player
  ;; (the skin then embeds YoutubePlayer, or its own video-embed, to keep the
  ;; READY / FAILED producers).
  trait YoutubeEmbedDefaultPlayer -> YoutubeEmbed [client] {
    initial: ready

    state ready {
      INIT -> ready
        (render-ui main { children: [@trait.YoutubePlayer], type: box })
      PLAYBACK_STARTED -> ready
        (emit PLAY { source: default-player })
    }

    emits {
      PLAY -> external {
        source : string
      }
        @description "Indicates the video playback has started."
        @synonyms "play, start, begin, playing"
        @tier "domain"
    }

    listens {
      PLAYBACK_STARTED {
        source : string
      }
        @description "The embedded player began or resumed playing."
        @synonyms "playing, started, resumed"
        @tier "internal"
    }
  }

  trait YoutubeEmbedHost -> YoutubeEmbed [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.videoId @config.videoId)
        (set @entity.autoplay @config.autoplay)
        (set @entity.controls @config.controls)
        (set @entity.start @config.start)
        (fetch YoutubeEmbed {
          emit: { failure: YoutubeEmbedLoadFailed, success: YoutubeEmbedLoaded }
        })
        (render-ui main { children: [@config.uiTrait], type: box })
      READY -> ready
        (emit YoutubeEmbedReady { videoId: @entity.videoId })
        (render-ui main { children: [@config.uiTrait], type: box })
      FAILED -> error
        (set @entity.error ?error)
        (emit YoutubeEmbedFailed { code: youtube_embed_failed, error: @entity.error })
        (render-ui main { children: [@trait.VideoErrorDisplay], type: box })
      YoutubeEmbedLoaded -> idle
      YoutubeEmbedLoadFailed -> idle
        (notify error (str/concat "Couldn't load the YouTube embed — " ?error))
    }

    state ready {
      INIT -> idle
        (set @entity.videoId @config.videoId)
        (set @entity.autoplay @config.autoplay)
        (set @entity.controls @config.controls)
        (set @entity.start @config.start)
        (fetch YoutubeEmbed {
          emit: { failure: YoutubeEmbedLoadFailed, success: YoutubeEmbedLoaded }
        })
        (render-ui main { children: [@config.uiTrait], type: box })
      ;; Self-loop on the external emit so ORB_X_UNUSED_EMISSION sees an
      ;; in-atom listener for YoutubeEmbedReady.
      YoutubeEmbedReady -> ready
      FAILED -> error
        (set @entity.error ?error)
        (emit YoutubeEmbedFailed { code: youtube_playback_failed, error: @entity.error })
        (render-ui main { children: [@trait.VideoErrorDisplay], type: box })
    }

    state error {
      INIT -> idle
        (set @entity.videoId @config.videoId)
        (set @entity.autoplay @config.autoplay)
        (set @entity.controls @config.controls)
        (set @entity.start @config.start)
        (fetch YoutubeEmbed {
          emit: { failure: YoutubeEmbedLoadFailed, success: YoutubeEmbedLoaded }
        })
        (render-ui main { children: [@config.uiTrait], type: box })
      ;; Mirrors the ready self-loop: YoutubeEmbedFailed is emitted
      ;; from the FAILED transition body for downstream consumers, listened
      ;; to here so the validator doesn't flag the emission as unused.
      YoutubeEmbedFailed -> error
      RETRY -> idle
        (set @entity.error "")
        (emit FAILED { error: @entity.error })
        (render-ui main { children: [@config.uiTrait], type: box })
    }

    emits {
      YoutubeEmbedLoaded -> external {
        data : [YoutubeEmbed]
      }
        @description "Indicates the YouTube embed is ready for playback."
        @synonyms "ready, initialized, available"
        @tier "internal"
      YoutubeEmbedLoadFailed -> external {
        error : string
      }
        @description "Indicates that loading the YouTube embed failed."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
      YoutubeEmbedReady -> external {
        videoId : string
      }
        @description "Signals the YouTube embed is initialized and ready for use."
        @synonyms "initialized, loaded, available"
        @tier "domain"
      YoutubeEmbedFailed -> external {
        error : string
        code : string
      }
        @description "Indicates the YouTube embed failed to load."
        @synonyms "error, failure, problem"
        @tier "internal"
      FAILED {
        error : string!
      }
        @description "Indicates a failure to load or initialize the YouTube embed."
        @synonyms "error, failure, problem, issue"
        @tier "internal"
    }

    listens {
      FAILED {
        error : string!
      }
        @description "Indicates an error occurred during embed initialization."
        @synonyms "error, failure, problem"
        @tier "internal"
      YoutubeEmbedLoaded {
        data : [YoutubeEmbed]
      }
        @description "Indicates the YouTube embed is ready for interaction."
        @synonyms "ready, initialized, available"
        @tier "internal"
      YoutubeEmbedLoadFailed {
        error : string
      }
        @description "Indicates that loading the YouTube embed failed."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
      YoutubeEmbedReady {
        videoId : string
      }
        @description "Indicates the YouTube embed is initialized and ready for use."
        @synonyms "initialized, loaded, available"
        @tier "domain"
      YoutubeEmbedFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load or initialize the YouTube embed."
        @synonyms "error, failure, problem, issue"
        @tier "internal"
    }

    config {
      uiTrait : trait = @trait.YoutubeEmbedDefaultPlayer
        @label "Player skin"
        @description "Trait that replaces the default YouTube embed surface"
        @tier "internal"
      videoId : string = ""
        @label "YouTube video ID"
        @description "Eleven-character YouTube ID from the share URL"
        @tier "presentation"
      autoplay : boolean = false
        @label "Autoplay"
        @description "Start playback automatically when the embed loads"
        @tier "presentation"
      controls : boolean = true
        @label "Show controls"
        @description "Display the YouTube player controls overlay"
        @tier "presentation"
      start : number = 0
        @label "Start at seconds"
        @description "Number of seconds to skip in before playback begins"
        @tier "presentation"
    }
  }

  ;; Internal chain triggers fired by the embedded player (YoutubePlayer, in
  ;; the default skin or any override skin). READY → ready state, FAILED → error state.
  page "/youtubeembeds" as YoutubeEmbedPage -> YoutubeEmbedHost, YoutubePlayer, VideoErrorDisplay
}