app std-saved-search "1.0.0"
"std-saved-search — persisted query + alert subscription. Owns a SavedSearch entity (one row per saved query) and a single manage trait that lists saved searches in a data-grid, lets users toggle their alert subscription / rename the search / delete it, and persists each change."
type ItemAction = { label : string!, event : event, variant : string, icon : string, roles : [string], when : SExpr }
orbital SavedSearchOrbital {
    type SavedSearchLoaded = Event { data : [SavedSearch] } "Fired when the saved-search collection finishes loading"

    type SavedSearchLoadFailed = Event { error : string, code : string } "Fired when the saved-search collection fails to load"

    type SavedSearchUpdated = Event SavedSearch "Fired after a saved-search row's update persists (toggle alert / rename / change frequency)"

    type SavedSearchDeleted = Event { id : string! } "Fired after a saved-search row is deleted"

    type SavedSearchCreated = Event SavedSearch "Fired after the current search is saved as a new row"

  entity SavedSearch [persistent: savedsearches] {
    id : string!
    name : string! @description "A user-defined label for the saved search." @synonyms "title, label, search name"
    query : string @description "The text of the search query." @synonyms "search, expression, criteria"
    filters : Map string scalar @description "Criteria used to define the search." @synonyms "criteria, conditions, constraints"
    alertEnabled : boolean @description "Indicates whether alerts are enabled for this saved search." @synonyms "enabled, active, notification status" = false
    alertFrequency : "instant" | "daily" | "weekly" @description "How often alerts are triggered." @synonyms "frequency, interval, recurrence" = daily
    userId : string @description "Identifier of the user who created the saved search." @synonyms "creator, owner, user_id"
    lastNotifiedAt : datetime @description "Timestamp of the last notification sent." @synonyms "last_notification, notified_at, last_alert"
    createdAt : string
  }

  trait SavedSearchManage -> SavedSearch [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading saved searches…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SavedSearchLoaded -> browsing
        (render-ui main {
          children: [{
            children: [{ name: bookmark, size: lg, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            cols: 1
            entity: ?data
            fields: [{
              label: Name
              name: name
              variant: h4
            }, {
              label: Query
              name: query
              variant: caption
            }, {
              label: Frequency
              name: alertFrequency
              variant: badge
            }, {
              label: Alerts
              name: alertEnabled
              variant: badge
            }]
            gap: sm
            itemClickEvent: @config.itemClickEvent
            itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
            look: @config.tableLook
            type: data-grid
          }]
          direction: vertical
          gap: md
          type: stack
        })
      SavedSearchLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
    }

    state browsing {
      INIT -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading saved searches…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      TOGGLE_ALERT -> browsing
        (set @entity.id ?id)
        (set @entity.alertEnabled ?enabled)
        (persist update SavedSearch @entity {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchUpdated }
        })
      DELETE -> browsing
        (set @entity.id ?id)
        ;; `persist delete` takes an ID, not a row — passing @entity handed the
        ;; whole object to the id slot and failed at runtime while validating
        ;; clean. Matches the corpus idiom (std-board, std-esign-flow, …).
        (persist delete SavedSearch ?id {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchDeleted }
        })
      ;; The page's live search, fed by whichever search/filter traits the
      ;; consumer wires in, so SAVE_CURRENT captures what the viewer sees.
      TRACK_QUERY -> browsing
        (set @entity.query ?query)
      ;; One filter change at a time (std-filter's FILTER shape); an empty
      ;; value clears that filter, matching std-browse's REFETCH_FILTER.
      TRACK_FILTERS -> browsing
        (set @entity.filters (if ["=", ?value, ""] (object/omit @entity.filters [?field]) (object/set @entity.filters ?field ?value)))
      SAVE_CURRENT -> browsing
        (persist create SavedSearch {
          name: (if @entity.query @entity.query @config.defaultSearchName)
          query: @entity.query
          filters: @entity.filters
          userId: @user.id
          createdAt: @now
        } {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchCreated }
        })
      EDIT -> editing
        (set @entity.id ?id)
        (render-ui main {
          children: [{
            children: [{ name: pencil, size: lg, type: icon }, {
              content: "Edit saved search"
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            action: RENAME
            placeholder: Name
            type: input
            value: @entity.name
          }, {
            action: CHANGE_FREQUENCY
            options: [{ label: Instant, value: instant }, { label: Daily, value: daily }, { label: Weekly, value: weekly }]
            placeholder: "Alert frequency"
            type: select
            value: @entity.alertFrequency
          }, {
            checked: @entity.alertEnabled
            label: "Alerts enabled"
            type: switch
          }, {
            children: [{
              action: SAVE
              icon: check
              label: Save
              type: button
              variant: primary
            }, {
              action: CANCEL
              icon: x
              label: Cancel
              type: button
              variant: secondary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      SavedSearchUpdated -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
      SavedSearchDeleted -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
      SavedSearchCreated -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
      ;; editing.SAVE -> browsing lands here before the persist resolves; a
      ;; failure must be caught here too, not just by loading's twin arm.
      SavedSearchLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
    }

    state editing {
      RENAME -> editing
        (set @entity.name ?value)
      CHANGE_FREQUENCY -> editing
        (set @entity.alertFrequency ?value)
      SAVE -> browsing
        (persist update SavedSearch @entity {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchUpdated }
        })
      CANCEL -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
    }

    state error {
      INIT -> loading
        (fetch SavedSearch {
          emit: { failure: SavedSearchLoadFailed, success: SavedSearchLoaded }
        })
        (render-ui main { size: sm, type: spinner })
    }

    emits {
      TOGGLE_ALERT {
        id : string!
        enabled : boolean!
      }
        @description "Indicates the alert subscription status has been changed."
        @synonyms "subscribe, unsubscribe, notify, alert-state"
        @tier "domain"
      DELETE {
        id : string!
      }
        @description "Signals a saved search has been removed."
        @synonyms "remove, discard, clear"
        @tier "presentation"
      EDIT {
        id : string!
        row : SavedSearch
      }
        @description "Indicates a saved search is being modified."
        @synonyms "modify, update, change"
        @tier "presentation"
      RENAME {
        value : string!
      }
        @description "Indicates a saved search has been renamed."
        @synonyms "update, modify, change name"
        @tier "presentation"
      CHANGE_FREQUENCY {
        value : string!
      }
        @description "Indicates a change in the alert frequency setting."
        @synonyms "update, modify, adjust, refresh"
        @tier "presentation"
      SAVE
        @description "Indicates a saved search has been persisted."
        @synonyms "persist, store, update"
        @tier "domain"
      CANCEL
        @description "Aborts the current operation."
        @synonyms "abort, dismiss, undo"
        @tier "domain"
      SavedSearchLoaded {
        data : [SavedSearch]
      }
        @description "Signals that a saved search has been successfully retrieved."
        @synonyms "loaded, retrieved, fetched"
        @tier "domain"
      SavedSearchLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load saved search data."
        @synonyms "error, failure, load error"
        @tier "internal"
      SavedSearchCreated
        @description "Indicates the current search has been saved as a new row."
        @synonyms "saved, created, bookmarked"
        @tier "presentation"
      SavedSearchUpdated
        @description "Indicates a saved search has been modified and persisted."
        @synonyms "modified, changed, updated, persisted"
        @tier "presentation"
      SavedSearchDeleted {
        id : string!
      }
        @description "Indicates a saved search has been removed."
        @synonyms "removed, purged, discarded"
        @tier "presentation"
    }

    listens {
      TOGGLE_ALERT {
        id : string!
        enabled : boolean!
      }
        @description "Alert subscription status has been changed."
        @synonyms "subscribe, unsubscribe, notify, enable, disable"
        @tier "domain"
      DELETE {
        id : string!
      }
        @description "A saved search has been removed from the system."
        @synonyms "remove, purge, discard"
        @tier "domain"
      EDIT {
        id : string!
      }
        @description "A saved search is being edited by the user."
        @synonyms "modify, update, change"
        @tier "presentation"
      RENAME {
        value : string!
      }
        @description "A saved search's name has been modified."
        @synonyms "update, modify, change"
        @tier "presentation"
      CHANGE_FREQUENCY {
        value : string!
      }
        @description "A saved search's update frequency has been modified."
        @synonyms "update, refresh, interval"
        @tier "presentation"
      SAVE
        @description "A saved search has been persisted."
        @synonyms "persist, store, update, commit"
        @tier "domain"
      CANCEL
        @description "Aborts the current operation or view."
        @synonyms "dismiss, close, undo"
        @tier "domain"
      TRACK_QUERY {
        query : string
      }
        @description "The page's current search text changed."
        @synonyms "search changed, query changed, typed search"
        @tier "domain"
      TRACK_FILTERS {
        field : string!
        value : string!
      }
        @description "The page's current filters changed."
        @synonyms "filters changed, criteria changed"
        @tier "domain"
      SAVE_CURRENT
        @description "Save the page's current search and filters as a new saved search."
        @synonyms "save search, bookmark search, remember search"
        @tier "domain"
      SavedSearchCreated
        @description "The current search was saved as a new row."
        @synonyms "saved, created, bookmarked"
        @tier "presentation"
      SavedSearchLoaded {
        data : [SavedSearch]
      }
        @description "Indicates that saved search data has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved, initialized"
        @tier "domain"
      SavedSearchLoadFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load saved search data."
        @synonyms "error, failure, load error"
        @tier "internal"
      SavedSearchUpdated
        @description "A saved search's details have been modified."
        @synonyms "modified, changed, updated"
        @tier "presentation"
      SavedSearchDeleted {
        id : string!
      }
        @description "Indicates a saved search has been removed from the system."
        @synonyms "removed, purged, discarded"
        @tier "internal"
    }

    config {
      title : string = "Saved Searches"
        @label "Section title"
        @description "Heading shown above the saved-search list"
        @tier "presentation"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      defaultSearchName : string = "Saved search"
        @label "Default saved-search name"
        @description "Name given to a saved search when the current search has no query text (filters only). Renamable afterwards."
        @tier "presentation"
      itemClickEvent : event = EDIT
        @label "Row click"
        @description "Event emitted when a row is clicked; opens the saved search for editing. Empty disables the row click."
        @tier "presentation"
      itemActions : [ItemAction] = [{
        event: TOGGLE_ALERT
        icon: bell
        label: "Toggle alert"
        variant: secondary
      }, {
        event: EDIT
        icon: pencil
        label: Edit
        variant: secondary
      }, {
        event: DELETE
        icon: trash-2
        label: Delete
        variant: danger
      }]
        @label "Row actions"
        @description "Actions offered on each row; give an item `roles` to show it only to those viewer roles."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The signed-in viewer's role that each action's `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`) in an app whose identity carries a role; left empty, only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/savedsearches" as SavedSearchManagePage -> SavedSearchManage
}