app std-prose [
  version: "1.0.0",
  description: "std-prose — a block of long-form text at a comfortable reading width: optional eyebrow, heading and meta line (date, author), then markdown body with headings, lists, links and code blocks. Supports right-to-left text, and can set the text on a solid panel over a patterned page. Pick for articles, blog posts, about and mission pages, policy text and install notes."
]
orbital ProseOrbital {

  entity ProseView [runtime] {
    id : string!
  }

  trait ProseRender -> @rebindable ProseView [client] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          type: box
          paddingY: xl
          bg: (if (== @config.surface muted) muted transparent)
          fullWidth: true
          dir: @config.direction
          children: [{
            type: container
            size: md
            maxWidth: md
            padding: lg
            children: [{
              type: box
              bg: (if (== @config.surface panel) surface transparent)
              border: (== @config.surface panel)
              rounded: (if (== @config.surface panel) lg none)
              padding: (if (== @config.surface panel) md none)
              children: [{
                type: stack
                direction: vertical
                gap: md
                children: [{
                  type: badge
                  label: @config.eyebrow
                  variant: primary
                  className: (if (== @config.eyebrow "") hidden "self-start")
                }, {
                  type: typography
                  content: @config.heading
                  variant: @config.headingLevel
                  size: "3xl"
                  weight: bold
                  className: (if (== @config.heading "") hidden "tracking-tight text-balance")
                }, {
                  type: typography
                  content: @config.meta
                  variant: caption
                  color: muted
                  className: (if (== @config.meta "") hidden "")
                }, {
                  type: markdown-content
                  content: @config.body
                  direction: @config.direction
                }]
              }]
            }]
          }]
        })
    }

    config {
      eyebrow : string = ""
        @label "Eyebrow"
        @description "Small badge above the heading; empty hides it"
        @tier "presentation"
      heading : string = ""
        @label "Heading"
        @description "Empty hides it"
        @synonyms "title"
        @tier "presentation"
      headingLevel : "h1" | "h2" = h2
        @label "Heading level"
        @description "h1 when this text is the page's main content (its title names the page); h2 when it is one section among others"
        @synonyms "page title, heading rank, outline level"
        @tier "presentation"
      meta : string = ""
        @label "Meta line"
        @description "Date, author or reading time under the heading; empty hides it"
        @synonyms "byline, date, author"
        @tier "presentation"
      body : string = "Write the text here in **markdown**."
        @label "Body"
        @description "Markdown text"
        @synonyms "content, article, text, copy"
        @tier "presentation"
      direction : "ltr" | "rtl" = ltr
        @label "Text direction"
        @tier "presentation"
      surface : "plain" | "muted" | "panel" = plain
        @label "Surface"
        @description "plain: the text sits on the page. muted: a full-width muted band. panel: the text column sits on a solid bordered panel and the page shows either side, for a page whose background is a pattern or a picture"
        @synonyms "background, reading panel, card"
        @tier "presentation"
    }
  }

  page "/prose" as ProsePage -> ProseRender
}
