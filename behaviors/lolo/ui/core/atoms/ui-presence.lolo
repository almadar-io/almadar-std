app ui-presence "1.0.0"
"Presence — UI factory (1:1 with the @almadar/ui presence pattern)."
;; @pattern "presence"
orbital PresenceOrbital {
  entity PresenceItem [runtime] {
    id : string!
  }

  trait PresenceRender -> @rebindable PresenceItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          animation: @config.animation
          animate: @config.animate
          onExited: @config.onExited
          show: @config.show
          className: @config.className
          children: @config.children
          type: presence
        })
    }

    emits {
      @config.onExited -> external { }
        @description "Fired after the exit animation completes (before unmount)."
        @tier "essential"
    }

    config {
      animation : "modal" | "overlay" | "slide-up" | "drawer" | "popover" | "toast" | "fade" | "page" = modal
        @label "Animation"
        @description "Which motion preset to use (maps to `animate-<name>-in/out`)."
        @tier "presentation"
      animate : boolean
        @label "Animate"
        @description "Per-instance opt-out. Global opt-out is `--motion-enable` / reduced-motion. @default true"
        @tier "presentation"
      onExited : event = "EXITED"
        @label "On Exited"
        @description "Fired after the exit animation completes (before unmount)."
        @tier "presentation"
      show : boolean = false
        @label "Show"
        @description "When false, the exit animation runs, then children unmount."
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "className prop"
        @tier "presentation"
      children : node
        @label "Children"
        @description "children prop"
        @tier "presentation"
    }
  }

  page "/presence" as PresencePage -> PresenceRender
}
