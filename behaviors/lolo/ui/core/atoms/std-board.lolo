app std-board "1.3.0"
"std-board — generic N-column board primitive. `config.columns` is an array of column definitions ({ key, label, icon, variant }); the trait `array/map`s them on `BoardItemsLoaded` into `@entity.boards` where each board carries its filtered items + a count. The render is a `data-grid` over `@entity.boards` (one card per column) whose `renderItem` lambda nests a `data-list` over `@col.items` (the cards in that stage). N is config-driven — pass any number of columns; the outer `data-grid`'s `cols` is bound to `@config.gridCols` so the grid wraps if you exceed it. Topology = loading / viewing_board / viewing_card / adding / error — distinct from the cookie-cutter `loading/browsing/viewing_single/error` CRUD shape. App-level atoms (e.g. std-pipeline) compose std-board via `uses` and add a sibling persistor + extended source entity. `config.boardLook` switches the board body between the default N-column grid ('columns') and a Trello-style wide-column kanban ('kanban-classic'). `viewing_board` listens for REFETCH_QUERY/REFETCH_FILTER/REFETCH_PAGE (the std-search/std-filter/std-pagination wiring targets, no render on refetch — @entity.boards is bound reactively) and can optionally render its own search box (config.bodySearch, default false) and filter bar (config.filters, default []); no pagination control is rendered — a board's columns are not a paged list."
type ObjectSpec = { id : string, label : string, value : string }
type ColumnSpec = { key : string!, label : string!, icon : string, variant : string }
type FilterSpec = { field : string!, label : string, options : [string] }
orbital BoardOrbital {
    type BoardItem = { id : string!, title : string, description : string, stage : string, notes : string, position : number }

    type BoardColumn = { key : string!, label : string!, icon : string, variant : "default" | "primary" | "success" | "warning" | "error" | "info", count : number, items : [BoardItem] }

    type BoardItemsLoaded = Event { data : [ObjectSpec] } "Fired when board items finish loading (from an upstream fetcher / persistor)"

    type BoardItemsLoadFailed = Event { error : string, code : string } "Fired when the upstream fetch fails"

    type BoardItemsSaved = Event { row : @entity } "Fired when a board item has been persisted"

    type BoardItemsSaveFailed = Event { error : string, code : string } "Fired when a persist intent fails"

  entity BoardView [persistent: board_items] {
    id : string!
    title : string! @description "The descriptive name of the board." @synonyms "name, heading, label"
    description : string @description "A textual explanation or summary of the board." @synonyms "summary, details, notes, explanation" = ""
    stage : "todo" | "doing" | "done" @description "The current status or lifecycle phase of the board." @synonyms "status, lifecycle, progress, state" = todo
    notes : string @description "Free-form text providing additional information." @synonyms "comments, remarks, details, annotations" = ""
    position : number @description "The sequential order of this item within a collection." @synonyms "order, sequence, index, rank" = 0
    boards : [BoardColumn] @intrinsic = []
    currentId : string @intrinsic = ""
    currentTitle : string @intrinsic = ""
    currentDescription : string @intrinsic = ""
    currentStage : string @intrinsic = ""
    currentNotes : string @intrinsic = ""
    currentRow : object @intrinsic = {}
    errorMessage : string @intrinsic = ""
  }

  trait BoardItemBoard -> @rebindable BoardView [interaction, instance] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
        })
        (render-ui main {
          title: "Loading board…"
          type: loading-state
        })
      BoardItemsLoaded -> viewing_board
        (set @entity.boards (array/map @config.columns (fn col {
          count: (array/len (array/filter ?data (fn item ["=", (object/get @item @config.groupByField), (object/get @col key)])))
          icon: (object/get @col icon circle)
          items: (array/sort (array/filter ?data (fn item ["=", (object/get @item @config.groupByField), (object/get @col key)])) position)
          key: (object/get @col key)
          label: (object/get @col label)
          variant: (object/get @col variant default)
        })))
        (if ["=", @config.boardLook, kanban-classic]
          (render-ui main @config.kanbanClassicBodyContent)
          (render-ui main @config.bodyContent))
      BoardItemsLoadFailed -> error
        (set @entity.errorMessage ?error)
        (render-ui main {
          message: @entity.errorMessage
          title: "Failed to load board"
          type: error-state
        })
      ;; Card move/delete and add-card save all land here from their own
      ;; states; without this the persist success is dropped and the spinner
      ;; never resolves (only the failure twin below used to recover).
      BoardItemsSaved -> loading
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
        })
        (render-ui main {
          title: "Refreshing board…"
          type: loading-state
        })
      BoardItemsSaveFailed -> error
        (set @entity.errorMessage ?error)
        (render-ui main {
          message: @entity.errorMessage
          title: "Save failed"
          type: error-state
        })
    }

    state viewing_board {
      INIT -> loading
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
        })
        (render-ui main {
          title: "Loading board…"
          type: loading-state
        })
      OPEN_CARD -> viewing_card
        (set @entity.currentId ?id)
        (set @entity.currentTitle ?title)
        (set @entity.currentDescription ?description)
        (set @entity.currentStage ?stage)
        (set @entity.currentNotes ?row.notes)
        (set @entity.currentRow ?row)
        (render-ui main {
          children: [{
            align: center
            children: [{
              action: CLOSE_CARD
              icon: arrow-left
              label: Back
              type: button
              variant: ghost
            }, { name: credit-card, type: icon }, {
              content: @entity.currentTitle
              type: typography
              variant: h3
            }, {
              label: @entity.currentStage
              type: badge
              variant: primary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            children: [{
              children: [{
                color: muted
                content: Description
                type: typography
                variant: caption
              }, {
                content: @entity.currentDescription
                type: typography
                variant: body
              }, { type: divider }, {
                color: muted
                content: Notes
                type: typography
                variant: caption
              }, {
                content: @entity.currentNotes
                type: typography
                variant: body
              }]
              direction: vertical
              gap: sm
              type: stack
            }]
            look: @config.cardLook
            type: card
          }, { type: divider }, {
            color: muted
            content: "Move to stage:"
            type: typography
            variant: caption
          }, {
            entity: @entity.boards
            fields: []
            gap: sm
            renderItem: (fn col {
              action: MOVE_CARD
              actionPayload: { id: @entity.currentId, targetGroup: @col.key }
              icon: @col.icon
              label: @col.label
              type: button
              variant: secondary
            })
            type: data-list
            variant: default
          }, @config.cardActionsContent]
          direction: vertical
          gap: md
          type: stack
        })
      ADD_CARD -> adding
        (set @entity.currentId "")
        (set @entity.currentTitle "")
        (set @entity.currentDescription "")
        (set @entity.currentStage "")
        (set @entity.currentNotes "")
        (render-ui main {
          children: [{
            align: center
            children: [{
              action: CANCEL_ADD
              icon: x
              label: Cancel
              type: button
              variant: ghost
            }, { name: plus, type: icon }, {
              content: "New board item"
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            cancelEvent: CANCEL_ADD
            entity: @entity
            fields: @config.formFields
            mode: create
            submitEvent: SAVE_CARD
            type: form-section
          }]
          direction: vertical
          gap: md
          type: stack
        })
      MOVE_CARD -> viewing_board
        (persist update BoardView { id: ?id, stage: ?targetGroup } {
          emit: { failure: BoardItemsSaveFailed, success: BoardItemsSaved }
        })
      REORDER_CARD -> viewing_board
      REORDER_POSITION -> viewing_board
        (persist update BoardView { id: ?id, position: ?position } {
          emit: { failure: BoardItemsSaveFailed, success: BoardItemsSaved }
        })
      BoardItemsSaved -> viewing_board
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
        })
      ;; REFETCH_* stay in viewing_board and issue no render-ui, matching
      ;; std-browse's REFETCH_QUERY/REFETCH_FILTER/REFETCH_PAGE: a render here
      ;; would swap the whole board tree on every keystroke. The fetch runs in
      ;; the background; the BoardItemsLoaded arm below already recomputes
      ;; @entity.boards, which the mounted data-grid is bound to, so the grid
      ;; updates in place with no unmount/flicker.
      REFETCH_QUERY -> viewing_board
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
          filter: (or ["=", ?searchTerm, ""] (str/includes (object/get @entity title) ?searchTerm))
        })
      REFETCH_FILTER -> viewing_board
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
          filter: (or ["=", ?value, ""] ["=", (object/get @entity ?field), ?value])
        })
      ;; A board's columns are not a paged list — paging the underlying fetch
      ;; would show only one page's worth of items spread across all columns,
      ;; which is wrong kanban UX. This arm exists so a consumer CAN wire
      ;; std-pagination if they have a reason to; std-board itself never
      ;; renders a pagination control (see bodyContent/kanbanClassicBodyContent).
      REFETCH_PAGE -> viewing_board
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
          limit: @config.pageSize
          offset: ["*", ["-", ?page, 1], @config.pageSize]
        })
      BoardItemsLoaded -> viewing_board
        (set @entity.boards (array/map @config.columns (fn col {
          count: (array/len (array/filter ?data (fn item ["=", (object/get @item @config.groupByField), (object/get @col key)])))
          icon: (object/get @col icon circle)
          items: (array/sort (array/filter ?data (fn item ["=", (object/get @item @config.groupByField), (object/get @col key)])) position)
          key: (object/get @col key)
          label: (object/get @col label)
          variant: (object/get @col variant default)
        })))
    }

    state viewing_card {
      CLOSE_CARD -> loading
        (fetch BoardView {
          emit: { failure: BoardItemsLoadFailed, success: BoardItemsLoaded }
        })
        (render-ui main {
          title: "Refreshing board…"
          type: loading-state
        })
      MOVE_CARD -> loading
        (persist update BoardView { id: ?id, stage: ?targetGroup } {
          emit: { failure: BoardItemsSaveFailed, success: BoardItemsSaved }
        })
        (render-ui main {
          title: "Moving item…"
          type: loading-state
        })
      DELETE_CARD -> loading
        (persist delete BoardView ?id {
          emit: { failure: BoardItemsSaveFailed, success: BoardItemsSaved }
        })
        (render-ui main {
          title: "Deleting item…"
          type: loading-state
        })
    }

    state adding {
      SAVE_CARD -> loading
        (persist create BoardView ?data {
          emit: { failure: BoardItemsSaveFailed, success: BoardItemsSaved }
        })
        (render-ui main {
          title: "Saving…"
          type: loading-state
        })
      CANCEL_ADD -> viewing_board
        (render-ui main {
          title: "Cancelling…"
          type: loading-state
        })
    }

    state error {
      INIT -> loading
        (render-ui main {
          title: "Retrying…"
          type: loading-state
        })
    }

    emits {
      OPEN_CARD {
        id : string!
        row : object!
      }
        @description "Indicates a card within the board has been selected."
        @synonyms "select, choose, activate, display"
        @tier "domain"
      CLOSE_CARD
        @description "Signals a card is being dismissed or closed."
        @synonyms "dismiss, hide, close, remove"
        @tier "domain"
      ADD_CARD
        @description "Signals a new card is being added to the board."
        @synonyms "create, new, append"
        @tier "domain"
      CANCEL_ADD
        @description "Aborts an in-progress addition operation."
        @synonyms "discard, undo, reset"
        @tier "presentation"
      SAVE_CARD {
        data : @entity!
      }
        @description "Signals that a card's data has been successfully saved."
        @synonyms "persist, update, store"
        @tier "domain"
      MOVE_CARD {
        id : string!
        sourceGroup : string
        targetGroup : string!
        newIndex : number
      }
        @description "Signals a card has been repositioned within a column."
        @synonyms "reorder, drag, reposition"
        @tier "presentation"
      REORDER_CARD {
        id : string!
        oldIndex : number
        newIndex : number
      }
        @description "Signals a change in the order of cards within a column."
        @synonyms "rearrange, sort, shuffle, reposition"
        @tier "presentation"
      DELETE_CARD {
        id : string!
      }
        @description "Signals removal of a card from the board."
        @synonyms "remove, delete, discard"
        @tier "presentation"
      EDIT_CARD -> external {
        id : string!
        row : object
      }
        @description "Signals a request to edit the currently open card. The board renders no edit form itself — consumers override cardActionsContent with an Edit button and wire this emit to their edit modal/form trait."
        @synonyms "edit, modify, update, change"
        @tier "domain"
      BoardItemsLoaded {
        data : [ObjectSpec]
      }
        @description "Signals that board items have been successfully loaded."
        @synonyms "loaded, fetched, retrieved, populated"
        @tier "domain"
      BoardItemsLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load board items."
        @synonyms "error, failed, problem, loading failure"
        @tier "internal"
      BoardItemsSaved { row : @entity }
        @description "Signals that board items have been successfully saved."
        @synonyms "saved, persisted, updated"
        @tier "domain"
      BoardItemsSaveFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to save board items."
        @synonyms "error, failed, save error"
        @tier "internal"
    }

    listens {
      OPEN_CARD {
        id : string!
        row : object!
        title : string
        description : string
        stage : string
      }
        @description "A card within the board has been selected or activated."
        @synonyms "select, activate, view, show"
        @tier "domain"
      CLOSE_CARD
        @description "Indicates a card has been dismissed or removed."
        @synonyms "dismiss, remove, hide, close"
        @tier "presentation"
      ADD_CARD
        @description "Indicates a new card is being added to the board."
        @synonyms "create, new, append"
        @tier "domain"
      CANCEL_ADD
        @description "Aborts the addition or editing of a board item."
        @synonyms "discard, undo, revert, dismiss"
        @tier "domain"
      SAVE_CARD {
        data : @entity!
      }
        @description "Indicates a card's data has been successfully saved."
        @synonyms "persist, update, store"
        @tier "domain"
      MOVE_CARD {
        id : string!
        sourceGroup : string
        targetGroup : string!
        newIndex : number
      }
        @description "Indicates a card has been repositioned within the board."
        @synonyms "reorder, drag, shuffle"
        @tier "presentation"
      REORDER_CARD {
        id : string!
        oldIndex : number
        newIndex : number
      }
        @description "Indicates a card's position within a column has changed."
        @synonyms "reposition, sort, rearrange"
        @tier "presentation"
      REORDER_POSITION {
        id : string!
        position : number!
      }
        @description "Indicates a change in the order of items within a column."
        @synonyms "sort, rearrange, reposition"
        @tier "presentation"
      DELETE_CARD {
        id : string!
      }
        @description "Indicates a board card has been removed."
        @synonyms "remove, discard, delete"
        @tier "presentation"
      REFETCH_QUERY {
        searchTerm : string!
      }
        @description "Triggers a board refresh based on the current search query."
        @synonyms "refresh, reload, update, re-query"
        @tier "domain"
      REFETCH_FILTER {
        field : string!
        value : string!
      }
        @description "Triggers a board refresh based on current filter criteria."
        @synonyms "refresh, filter, update, reload"
        @tier "domain"
      REFETCH_PAGE {
        page : number!
      }
        @description "Triggers a board refresh for a given page. std-board itself renders no pagination control; this exists so a composed std-pagination can drive one."
        @synonyms "reload, refresh, update, paginate"
        @tier "domain"
      BoardItemsLoaded {
        data : [ObjectSpec]
      }
        @description "Data for the board columns has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved, populated"
        @tier "domain"
      BoardItemsLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load board items."
        @synonyms "error, failed, problem, loading issue"
        @tier "internal"
      BoardItemsSaved { row : @entity }
        @description "Indicates board items have been successfully saved."
        @synonyms "saved, updated, persisted"
        @tier "presentation"
      BoardItemsSaveFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to save board items."
        @synonyms "error, failed, save error"
        @tier "internal"
    }

    config {
      title : string = Board
        @label "Board title"
        @description "Heading shown above the column board"
        @tier "presentation"
      columns : [ColumnSpec] = [{
        icon: circle
        key: todo
        label: "To Do"
        variant: default
      }, {
        icon: circle-dot
        key: doing
        label: "In Progress"
        variant: primary
      }, {
        icon: check-circle
        key: done
        label: Done
        variant: success
      }]
        @label "Columns"
        @description "Board columns; each row's stage maps to a column key"
        @tier "domain"
      gridCols : number = 3
        @label "Grid columns"
        @description "Outer grid column count before the board wraps"
        @tier "presentation"
      formFields : [string] = (title description stage notes)
        @label "New-card fields"
        @description "Fields shown in the add-card form"
        @tier "presentation"
      cardLook : "elevated" | "flat-bordered" | "borderless-divider" | "ticket" | "invoice" | "chip" | "tile-image-first" = elevated
        @label "Card look"
        @description "Layer 2 visual treatment for cards rendered by this board."
        @tier "presentation"
      cardTitleBinding : string = @item.title
        @label "Card title binding"
        @description "Per-card binding for the title slot."
        @tier "presentation"
      cardDescriptionBinding : string = @item.description
        @label "Card description binding"
        @description "Per-card binding for the description slot."
        @tier "presentation"
      cardStageBinding : string = @item.stage
        @label "Card stage binding"
        @description "Per-card binding for the stage/status slot."
        @tier "presentation"
      cardIdBinding : string = @item.id
        @label "Card id binding"
        @description "Per-card binding for the id used in action payloads."
        @tier "presentation"
      groupByField : string = stage
        @label "Group-by field"
        @description "Entity field whose value matches a column key — items are filtered into columns by it. Default 'stage'; set to 'status' (or any field) for entities that track state under a different name."
        @tier "presentation"
      boardLook : "columns" | "kanban-classic" = columns
        @label "Board look"
        @description "Layer 3 body layout: default N-column data-grid ('columns'), or a Trello-style wide-column kanban with sticky column headers ('kanban-classic')."
        @tier "presentation"
      bodySearch : boolean = false
        @label "Show the board's own search box?"
        @description "Renders an inline search box above the columns. Defaults false: unlike std-browse, std-board has never had a search box, so defaulting this true would silently add one to every existing consumer. The wired path — composing std-search beside the board and routing its FILTER/SEARCH event to REFETCH_QUERY — works regardless of this knob; set true only for a standalone board with no page-level search affordance."
        @synonyms "inline search, board search, built-in search, show search, duplicate search"
        @tier "presentation"
      searchPlaceholder : string = "Search…"
        @label "Search box placeholder text"
        @description "Hint text inside the board's embedded search box (e.g. 'Search cards…'). Only shown when bodySearch is true."
        @synonyms "search hint, placeholder, search box text, search label"
        @tier "presentation"
      filters : [FilterSpec] = []
        @label "Which filters should appear above the board?"
        @description "Dropdown filter facets by field, rendered as an embedded filter bar above the columns; each selection fires REFETCH_FILTER on this trait. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this board and routes its FILTER event to REFETCH_FILTER — that is the wired owner and remains the primary path. Use this knob only for a standalone board with no page-level filter affordance."
        @synonyms "filter bar, faceted filters, field filters, column filters, dropdowns"
        @tier "presentation"
      filterBarLook : "toolbar" | "chips" | "pills" | "popover-trigger" | "inline-column-header" = toolbar
        @label "Filter bar look"
        @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty."
        @synonyms "filter bar style, facet style, chips, pills"
        @tier "presentation"
      pageSize : number = 10
        @label "Fetch page size"
        @description "Records fetched per REFETCH_PAGE request. std-board renders no pagination control itself — this only feeds the fetch limit/offset when a consumer wires a composed std-pagination to REFETCH_PAGE."
        @synonyms "fetch limit, records per page, batch size, page limit"
        @tier "presentation"
      cardActionsContent : render-ui = {
        align: center
        children: [{
          action: DELETE_CARD
          actionPayload: { id: @entity.currentId }
          icon: trash-2
          label: Delete
          type: button
          variant: danger
        }]
        direction: horizontal
        gap: sm
        type: stack
      }
        @label "Card panel actions"
        @description "Actions row of the open-card panel. Default is the Delete button only. Override to add consumer-wired actions — e.g. an Edit button with action: EDIT_CARD and actionPayload: { id: @entity.currentId, row: @entity.currentRow }, listened to by the organism's edit modal. Never leave a button here without a listener."
        @tier "presentation"
      bodyContent : render-ui = {
        children: [{
          align: center
          children: [{ name: kanban-square, type: icon }, {
            content: @config.title
            type: typography
            variant: h3
          }]
          direction: horizontal
          gap: sm
          type: stack
        }, { type: divider }, (if @config.bodySearch {
          children: [{
            className: "w-full max-w-md"
            clearable: true
            event: REFETCH_QUERY
            placeholder: @config.searchPlaceholder
            type: search-input
          }]
          direction: horizontal
          gap: sm
          type: stack
        } {
          children: []
          gap: none
          type: stack
        }), (if [">", (array/len @config.filters), 0] {
          children: [{
            entity: BoardView
            event: REFETCH_FILTER
            filters: @config.filters
            look: @config.filterBarLook
            type: filter-group
          }]
          direction: horizontal
          gap: sm
          type: stack
        } {
          children: []
          gap: none
          type: stack
        }), {
          cols: @config.gridCols
          dndRoot: true
          entity: @entity.boards
          fields: []
          gap: md
          renderItem: (fn col {
            children: [{
              children: [{
                align: center
                children: [{ name: @col.icon, type: icon }, {
                  content: @col.label
                  type: typography
                  variant: h4
                }, {
                  label: @col.count
                  type: badge
                  variant: @col.variant
                }]
                direction: horizontal
                gap: xs
                type: stack
              }, {
                accepts: "*"
                dragGroup: @col.key
                dropEvent: MOVE_CARD
                entity: @col.items
                fields: []
                gap: sm
                positionEvent: REORDER_POSITION
                renderItem: (fn item {
                  children: [{
                    children: [{
                      content: @config.cardTitleBinding
                      type: typography
                      variant: h4
                    }, {
                      color: muted
                      content: @config.cardDescriptionBinding
                      type: typography
                      variant: caption
                    }, {
                      align: center
                      children: [{
                        action: OPEN_CARD
                        actionPayload: { description: @config.cardDescriptionBinding, id: @config.cardIdBinding, row: @item, stage: @config.cardStageBinding, title: @config.cardTitleBinding }
                        icon: arrow-right
                        label: Open
                        type: button
                        variant: ghost
                      }]
                      direction: horizontal
                      gap: xs
                      type: stack
                    }]
                    direction: vertical
                    gap: xs
                    type: stack
                  }]
                  look: @config.cardLook
                  type: card
                })
                reorderEvent: REORDER_CARD
                sortable: true
                type: data-list
              }]
              direction: vertical
              gap: sm
              type: stack
            }]
            look: @config.cardLook
            type: card
          })
          type: data-grid
        }, {
          action: ADD_CARD
          icon: plus
          label: "Add item"
          type: floating-action-button
          variant: primary
        }]
        direction: vertical
        gap: md
        type: stack
      }
        @label "Body content tree"
        @description "Render-ui SExpr rendered after the board loads for boardLook='columns' — the canonical column data-grid with nested per-column data-lists. boardLook='kanban-classic' renders kanbanClassicBodyContent instead; both share this trait's state machine, emits, and listens."
        @tier "internal"
      kanbanClassicBodyContent : render-ui = {
        children: [{
          align: center
          children: [{ name: kanban-square, type: icon }, {
            content: @config.title
            type: typography
            variant: h2
          }]
          className: px-card-md
          direction: horizontal
          gap: sm
          type: stack
        }, { type: divider }, (if @config.bodySearch {
          children: [{
            className: "w-full max-w-md"
            clearable: true
            event: REFETCH_QUERY
            placeholder: @config.searchPlaceholder
            type: search-input
          }]
          className: px-card-md
          direction: horizontal
          gap: sm
          type: stack
        } {
          children: []
          gap: none
          type: stack
        }), (if [">", (array/len @config.filters), 0] {
          children: [{
            entity: BoardView
            event: REFETCH_FILTER
            filters: @config.filters
            look: @config.filterBarLook
            type: filter-group
          }]
          className: px-card-md
          direction: horizontal
          gap: sm
          type: stack
        } {
          children: []
          gap: none
          type: stack
        }), {
          className: "w-full pb-2"
          dndRoot: true
          entity: @entity.boards
          fields: []
          gap: lg
          minCardWidth: 300
          renderItem: (fn col {
            children: [{
              children: [{
                align: center
                children: [{ name: @col.icon, type: icon }, {
                  className: flex-1
                  content: @col.label
                  type: typography
                  variant: h4
                }, {
                  label: @col.count
                  size: sm
                  type: badge
                  variant: primary
                }]
                className: "p-card-md border-b border-[var(--color-border)] sticky top-0 bg-[var(--color-surface)]"
                direction: horizontal
                gap: sm
                type: stack
              }, {
                accepts: "*"
                className: "p-card-md min-h-[120px]"
                dragGroup: @col.key
                dropEvent: MOVE_CARD
                entity: @col.items
                fields: []
                gap: sm
                positionEvent: REORDER_POSITION
                renderItem: (fn item {
                  children: [{
                    children: [{
                      content: @config.cardTitleBinding
                      type: typography
                      variant: body
                      weight: medium
                    }, {
                      className: line-clamp-2
                      color: muted
                      content: @config.cardDescriptionBinding
                      type: typography
                      variant: caption
                    }, {
                      align: center
                      children: [{
                        label: @config.cardStageBinding
                        size: sm
                        type: badge
                        variant: @col.variant
                      }, {
                        action: OPEN_CARD
                        actionPayload: { description: @config.cardDescriptionBinding, id: @config.cardIdBinding, row: @item, stage: @config.cardStageBinding, title: @config.cardTitleBinding }
                        className: ml-auto
                        icon: arrow-right
                        label: Open
                        size: sm
                        type: button
                        variant: ghost
                      }]
                      className: pt-1
                      direction: horizontal
                      gap: xs
                      type: stack
                    }]
                    direction: vertical
                    gap: xs
                    type: stack
                  }]
                  className: "cursor-grab hover:shadow-lg transition-shadow"
                  look: @config.cardLook
                  padding: sm
                  type: card
                })
                reorderEvent: REORDER_CARD
                sortable: true
                type: data-list
              }]
              direction: vertical
              gap: none
              type: stack
            }]
            className: "w-[300px] bg-[var(--color-surface-subtle)] rounded-lg overflow-hidden"
            look: elevated
            padding: none
            type: card
          })
          scrollX: true
          type: data-grid
        }, {
          action: ADD_CARD
          icon: plus
          label: "Add card"
          type: floating-action-button
          variant: primary
        }]
        className: h-full
        direction: vertical
        gap: md
        type: stack
      }
        @label "Kanban classic body content tree"
        @description "Render-ui SExpr for boardLook='kanban-classic' — Trello-style wide elevated columns with sticky headers, dense cards with a status badge; per-item cards honor config.cardLook (the column wrapper stays elevated — it is column chrome, not a card)."
        @tier "internal"
    }
  }

  page "/board" as BoardPage -> BoardItemBoard
}