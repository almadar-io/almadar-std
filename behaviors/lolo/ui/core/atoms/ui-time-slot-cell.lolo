app ui-time-slot-cell "1.0.0"
"TimeSlotCell — UI factory (1:1 with the @almadar/ui time-slot-cell pattern)."
;; @pattern "time-slot-cell"
orbital TimeSlotCellOrbital {
  entity TimeSlotCellItem [runtime] {
    id : string!
    time : string @intrinsic = ""
  }

  trait TimeSlotCellRender -> @rebindable TimeSlotCellItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.time @config.time)
        (render-ui main {
          time: @entity.time
          onClick: @config.onClick
          className: @config.className
          children: @config.children
          isOccupied: @config.isOccupied
          onPointerDown: @config.onPointerDown
          onPointerUp: @config.onPointerUp
          onPointerCancel: @config.onPointerCancel
          onPointerLeave: @config.onPointerLeave
          type: time-slot-cell
        })
      CLICK -> idle
        (set @entity.time ?time)
        (render-ui main {
          time: @entity.time
          onClick: @config.onClick
          className: @config.className
          children: @config.children
          isOccupied: @config.isOccupied
          onPointerDown: @config.onPointerDown
          onPointerUp: @config.onPointerUp
          onPointerCancel: @config.onPointerCancel
          onPointerLeave: @config.onPointerLeave
          type: time-slot-cell
        })
    }

    emits {
      @config.onClick -> external {
        time : string
      }
        @description "Called when the slot is clicked"
        @tier "essential"
      @config.onPointerDown -> external { }
        @description "onPointerDown prop"
        @tier "essential"
      @config.onPointerUp -> external { }
        @description "onPointerUp prop"
        @tier "essential"
      @config.onPointerCancel -> external { }
        @description "onPointerCancel prop"
        @tier "essential"
      @config.onPointerLeave -> external { }
        @description "onPointerLeave prop"
        @tier "essential"
    }

    listens {
      CLICK {
        time : string
      }
    }

    config {
      time : string = ""
        @label "Time"
        @description "Time label for this slot (e.g. '09:00')"
        @tier "presentation"
      onClick : event = "CLICK"
        @label "On Click"
        @description "Called when the slot is clicked"
        @tier "presentation"
      className : string
        @label "Class Name"
        @description "Additional CSS classes"
        @tier "presentation"
      children : node
        @label "Children"
        @description "Event content placed inside the slot"
        @tier "presentation"
      isOccupied : boolean = false
        @label "Is Occupied"
        @description "Whether this slot contains an event"
        @tier "presentation"
      onPointerDown : event = "POINTER_DOWN"
        @label "On Pointer Down"
        @description "onPointerDown prop"
        @tier "presentation"
      onPointerUp : event = "POINTER_UP"
        @label "On Pointer Up"
        @description "onPointerUp prop"
        @tier "presentation"
      onPointerCancel : event = "POINTER_CANCEL"
        @label "On Pointer Cancel"
        @description "onPointerCancel prop"
        @tier "presentation"
      onPointerLeave : event = "POINTER_LEAVE"
        @label "On Pointer Leave"
        @description "onPointerLeave prop"
        @tier "presentation"
    }
  }

  page "/time-slot-cell" as TimeSlotCellPage -> TimeSlotCellRender
}
