app std-behavior-catalog [
  version: "1.4.0",
  description: "std-behavior-catalog — browse the installed behaviors under the `scope` registry folders (`behavior/catalog`), search them by meaning (the list carries no vectors; a search lists the current topic's registry folder, or the whole scope, with its vectors, embeds the query with std-llm (LLM_EMBED) and ranks by cosine similarity to each behavior's description; results under `minScore` drop out), open one's knobs and events (`behavior/describe`), and pick one: PICKED { behavior, trait, value } carries the behavior name, its first trait as a value ready to bind, and the whole behavior as a value ready to embed or store. With `pick: toggle` each card carries an on/off switch instead: TOGGLED { behavior, checked, topic, value } per change, and SELECTION { behaviors } seeds which are on. After listing it emits CATALOG_TOPICS { topics } (each package and topic once, with its count), and SCOPE { paths } replaces the scope knob's registry folders at run time (the catalog lists them again; a SCOPE naming exactly the folders it already lists, in the same order, and carrying no fingerprints or the same ones, is ignored and reads nothing; fingerprints are one opaque string per folder that changes when the folder's files do), and TOPIC { package, topic } narrows the rows and search results to that topic (an empty topic lists everything). Pick for block libraries, plugin pickers, plugin on/off settings and any page that lets users choose a building block.",
  egress: ["https://api.openai.com", "https://openrouter.ai"]
]
;; @capabilities "browse installed behaviors, search behaviors by meaning, describe a behavior's knobs and events, pick a behavior to bind"

type BehaviorCatalogHit = {
  behavior : string!
  package : string!
  description : string!
  topic : string!
  level : string!
  capabilities : [string]
  traits : [trait]
  value : behavior!
  vectors : Map string [number]
}
type BehaviorCatalogRow = {
  behavior : string!
  package : string!
  description : string!
  topic : string!
  level : string!
  score : number!
}
type BehaviorCatalogTopic = {
  package : string!
  prefix : string
  topic : string!
  count : number!
}
type BehaviorCatalogKnobField = {
  name : string!
  type : string!
  label : string
  description : string
}
type BehaviorCatalogDescribedTrait = {
  trait : string!
  knobs : [BehaviorCatalogKnobField]!
}
type BehaviorCatalogDescribedOrbital = {
  traits : [BehaviorCatalogDescribedTrait]!
}
type BehaviorCatalogDescription = {
  behavior : string!
  knobs : [BehaviorCatalogKnobField]!
  orbitals : [BehaviorCatalogDescribedOrbital]!
}

uses Llm from "std/behaviors/std-llm"

orbital BehaviorCatalogOrbital {

  entity BehaviorCatalogView [runtime] {
    id : string!
    query : string = ""
    entries : [BehaviorCatalogHit] = []
    topics : [BehaviorCatalogTopic] @description "Every listed package and topic with its count, as CATALOG_TOPICS last announced them." = []
    searchHits : [BehaviorCatalogHit] @description "The behaviors a search ranks, listed with their vectors: the current topic's registry folder, or the whole scope." = []
    rows : [BehaviorCatalogRow] = []
    detail : string = ""
    knobs : [BehaviorCatalogKnobField] = []
    error : string = ""
    selected : [string] = []
    paths : [string] @description "The registry folders SCOPE named; empty lists the scope knob's." = []
    fingerprints : [string] @description "The fingerprints SCOPE carried beside the folders, one per folder; empty when it carried none." = []
    topicPackage : string @description "The package of the topic the rows are narrowed to; empty with topic for every listed behavior." = ""
    topic : string @description "The topic the rows are narrowed to (TOPIC); empty for every listed behavior." = ""
    status : "loading" | "ready" | "searching" | "describing" | "failed" = loading
  }

  trait BehaviorCatalogLlm = Llm.traits.LlmClient {
    listens {
      BehaviorCatalog.LLM_EMBED -> LLM_EMBED
    }
  }

  trait BehaviorCatalog -> @rebindable BehaviorCatalogView [optimistic] {
    config {
      scope : [string] = ["almadar-std/ui/core"]
        @label "Where to look"
        @description "Registry folders (`<prefix>/<topic>[/<tier>]`) the catalog lists."
        @tier "domain"
      minScore : number = 0.3
        @label "Minimum match"
        @description "Cosine similarity a behavior needs to its description to stay in search results."
        @tier "policy"
      searchPlaceholder : string = "Search building blocks"
        @label "Search placeholder"
        @tier "presentation"
      pickLabel : string = "Use"
        @label "Pick button label"
        @tier "presentation"
      describeLabel : string = "Details"
        @label "Details button label"
        @tier "presentation"
      emptyLabel : string = "Nothing matches."
        @label "Empty message"
        @tier "presentation"
      emptyDescription : string = ""
        @label "Empty explanation"
        @description "A line under the empty message saying why nothing is listed."
        @tier "presentation"
      emptyIcon : string = "search"
        @label "Empty icon"
        @tier "presentation"
      look : "list" | "chips" = list
        @label "How are behaviors shown?"
        @description "list = a search box over a card per behavior with Use and Details; chips = the best matches for the current query as a row of chips under a prompt that lives elsewhere (route its text to SEARCH), nothing while the query is empty."
        @synonyms "suggestion chips, prompt suggestions, compact catalog"
        @tier "presentation"
      maxChips : number = 4
        @label "How many chips?"
        @description "In the chips look, how many of the best matches are shown."
        @tier "presentation"
      pick : "button" | "toggle" = button
        @label "How is a behavior chosen?"
        @description "button = a Use button per card that picks it once (PICKED); toggle = an on/off switch per card for a set of chosen behaviors (TOGGLED), seeded by SELECTION."
        @synonyms "enable disable, on off switch, plugin toggles, choose many"
        @tier "presentation"
      toggleLabel : string = "Enabled"
        @label "Switch label"
        @tier "presentation"
      startPackage : string = ""
        @label "Starting package"
        @description "With startTopic, the package of the topic the rows start narrowed to; empty lists every behavior."
        @tier "domain"
      startTopic : string = ""
        @label "Starting topic"
        @description "The topic the rows start narrowed to (as TOPIC would); empty lists every behavior."
        @tier "domain"
      loadOnInit : boolean = true
        @label "List on start"
        @description "List the folders as the page mounts; off waits for CATALOG_LOAD, so a host that mounts the catalog before it is shown reads nothing until then."
        @tier "policy"
      perTopic : boolean = false
        @label "Load each topic when opened"
        @description "List only the topics with their counts at first, and a topic's behaviors, without their traits, when it is opened; off lists every behavior up front."
        @tier "policy"
    }
    initial: loading

    state loading {
      SCOPE -> loading when (or (!= ?paths @entity.paths) (and (!= ?fingerprints null) (!= ?fingerprints @entity.fingerprints)))
        (set @entity.paths ?paths)
        (set @entity.fingerprints (if (!= ?fingerprints null) ?fingerprints []))
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: ?paths } { vectors: false emit: { success: LISTED, failure: LIST_FAILED } })
      INIT -> loading when (and @config.loadOnInit @config.perTopic)
        (set @entity.topicPackage @config.startPackage)
        (set @entity.topic @config.startTopic)
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          topics: true
          emit: { success: TOPICS_LISTED, failure: LIST_FAILED }
        })
      INIT -> loading when (and @config.loadOnInit (not @config.perTopic))
        (set @entity.topicPackage @config.startPackage)
        (set @entity.topic @config.startTopic)
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          emit: { success: LISTED, failure: LIST_FAILED }
        })
      INIT -> loading when (not @config.loadOnInit)
        (set @entity.topicPackage @config.startPackage)
        (set @entity.topic @config.startTopic)
        (render-ui main <loading-state message="Loading the catalog" />)
      CATALOG_LOAD -> loading when @config.perTopic
        (set @entity.topicPackage @config.startPackage)
        (set @entity.topic @config.startTopic)
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          topics: true
          emit: { success: TOPICS_LISTED, failure: LIST_FAILED }
        })
      CATALOG_LOAD -> loading when (not @config.perTopic)
        (set @entity.topicPackage @config.startPackage)
        (set @entity.topic @config.startTopic)
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          emit: { success: LISTED, failure: LIST_FAILED }
        })
      SELECTION -> loading
        (set @entity.selected ?behaviors)
      TOPIC -> loading
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
      TOPICS_LISTED -> loading when (!= @entity.topic "")
        (set @entity.topics ?result)
        (emit CATALOG_TOPICS { topics: ?result })
        (behavior/catalog { paths: [(str/concat (object/get (array/find ?result (fn t (and (= @t.package @entity.topicPackage) (= @t.topic @entity.topic)))) prefix "") "/" @entity.topic)] } { vectors: false traits: false emit: { success: TOPIC_LISTED, failure: LIST_FAILED } })
      TOPICS_LISTED -> ready when (= @entity.topic "")
        (set @entity.topics ?result)
        (set @entity.entries [])
        (set @entity.rows [])
        (set @entity.status ready)
        (emit CATALOG_TOPICS { topics: ?result })
        (emit CATALOG_SHOWN {})
      TOPIC_LISTED -> ready
        (set @entity.entries ?result)
        (set @entity.rows (array/map ?result (fn e { behavior: @e.behavior, package: @e.package, description: @e.description, topic: @e.topic, level: @e.level, score: 0 })))
        (set @entity.status ready)
        (emit CATALOG_SHOWN {})
      LISTED -> ready
        (set @entity.entries ?result)
        (set @entity.rows (array/map (array/filter ?result (fn e (or (= @entity.topic "") (and (= @e.package @entity.topicPackage) (= @e.topic @entity.topic))))) (fn e { behavior: @e.behavior, package: @e.package, description: @e.description, topic: @e.topic, level: @e.level, score: 0 })))
        (set @entity.status ready)
        (set @entity.topics (array/map (array/unique (array/map ?result (fn e { package: @e.package, topic: @e.topic }))) (fn t { package: @t.package, topic: @t.topic, count: (array/count ?result (fn e (and (= @e.package @t.package) (= @e.topic @t.topic)))) })))
        (emit CATALOG_TOPICS { topics: @entity.topics })
        (emit CATALOG_SHOWN {})
      LIST_FAILED -> failed when (= @config.look chips)
        (set @entity.error ?error)
        (set @entity.status failed)
        (render-ui main null)
      LIST_FAILED -> failed when (!= @config.look chips)
        (set @entity.error ?error)
        (set @entity.status failed)
        (render-ui main <error-state title="The catalog could not be listed" message={?error} retryEvent="RETRY" />)
    }

    state ready {
      SCOPE -> loading when (or (!= ?paths @entity.paths) (and (!= ?fingerprints null) (!= ?fingerprints @entity.fingerprints)))
        (set @entity.paths ?paths)
        (set @entity.fingerprints (if (!= ?fingerprints null) ?fingerprints []))
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: ?paths } { vectors: false emit: { success: LISTED, failure: LIST_FAILED } })
      INIT -> ready
        (emit CATALOG_TOPICS { topics: @entity.topics })
        (emit CATALOG_SHOWN {})
      CATALOG_SHOWN -> ready when (= @config.look chips)
        (render-ui main {
          type: stack
          direction: horizontal
          gap: sm
          justify: center
          className: (if (= @entity.query "") "hidden" "flex-wrap")
          children: (array/map (array/take @entity.rows @config.maxChips) (fn row {
            type: button
            label: @row.behavior
            variant: secondary
            size: sm
            className: "rounded-full"
            action: PICK
            actionPayload: { behavior: @row.behavior }
          }))
        })
      CATALOG_SHOWN -> ready when (!= @config.look chips)
        (render-ui main {
          type: stack
          direction: vertical
          gap: md
          children: [{
            type: search-input
            placeholder: @config.searchPlaceholder
            value: @entity.query
            event: SEARCH
          }, {
            type: empty-state
            icon: @config.emptyIcon
            title: @config.emptyLabel
            description: @config.emptyDescription
            className: (if (= (array/len @entity.rows) 0) "" hidden)
          }, {
            type: stack
            direction: horizontal
            gap: sm
            className: "grid grid-cols-1 xl:grid-cols-2"
            children: (array/map @entity.rows (fn row {
              type: card
              padding: md
              className: "h-full"
              children: [{
                type: stack
                direction: vertical
                gap: sm
                justify: between
                className: "h-full"
                children: [{
                  type: stack
                  direction: horizontal
                  gap: sm
                  align: start
                  justify: between
                  children: [{
                    type: stack
                    direction: vertical
                    gap: none
                    children: [
                      { type: typography, content: (array/last (str/split @row.behavior "/")), variant: h4, weight: semibold },
                      { type: typography, content: @row.behavior, variant: caption, color: muted }
                    ]
                  }, {
                    type: stack
                    direction: horizontal
                    gap: xs
                    children: [
                      { type: badge, label: @row.level, variant: info },
                      { type: badge, label: (str/concat (math/round (* @row.score 100)) "%"), variant: success, className: (if (> @row.score 0) "" hidden) }
                    ]
                  }]
                }, {
                  type: typography
                  content: @row.description
                  variant: body
                  color: muted
                  className: "line-clamp-2"
                }, {
                  type: stack
                  direction: horizontal
                  gap: sm
                  align: center
                  children: [
                    { type: button, label: @config.pickLabel, variant: primary, size: sm, action: PICK, actionPayload: { behavior: @row.behavior }, className: (if (= @config.pick toggle) hidden "") },
                    { type: switch, label: @config.toggleLabel, checked: (array/includes @entity.selected @row.behavior), action: TOGGLE, actionPayload: { behavior: @row.behavior }, className: (if (= @config.pick toggle) "" hidden) },
                    { type: button, label: @config.describeLabel, variant: ghost, size: sm, action: DESCRIBE, actionPayload: { behavior: @row.behavior } }
                  ]
                }, {
                  type: stack
                  direction: vertical
                  gap: xs
                  className: (if (= @entity.detail @row.behavior) "" hidden)
                  children: (array/map @entity.knobs (fn k {
                    type: typography
                    content: (str/concat (object/get @k label @k.name) " · " @k.type " — " (object/get @k description ""))
                    variant: caption
                  }))
                }]
              }]
            }))
          }]
        })
      SEARCH -> ready when (= ?searchTerm "")
        (set @entity.query "")
        (set @entity.rows (array/map (array/filter @entity.entries (fn e (or (= @entity.topic "") (and (= @e.package @entity.topicPackage) (= @e.topic @entity.topic))))) (fn e { behavior: @e.behavior, package: @e.package, description: @e.description, topic: @e.topic, level: @e.level, score: 0 })))
        (emit CATALOG_SHOWN {})
      TOPIC -> loading when @config.perTopic
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (set @entity.query "")
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the topic" />)
        (behavior/catalog { paths: [(str/concat (object/get (array/find @entity.topics (fn t (and (= @t.package ?package) (= @t.topic ?topic)))) prefix "") "/" ?topic)] } { vectors: false traits: false emit: { success: TOPIC_LISTED, failure: LIST_FAILED } })
      TOPIC -> ready when (not @config.perTopic)
        (set @entity.topicPackage ?package)
        (set @entity.topic ?topic)
        (set @entity.query "")
        (set @entity.rows (array/map (array/filter @entity.entries (fn e (or (= ?topic "") (and (= @e.package ?package) (= @e.topic ?topic))))) (fn e { behavior: @e.behavior, package: @e.package, description: @e.description, topic: @e.topic, level: @e.level, score: 0 })))
        (emit CATALOG_SHOWN {})
      SEARCH -> searching when (!= ?searchTerm "")
        (set @entity.query ?searchTerm)
        (set @entity.status searching)
        (behavior/catalog { paths: (if (= @entity.topic "") (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) (let ((inTopic (array/find @entity.entries (fn e (and (= @e.package @entity.topicPackage) (= @e.topic @entity.topic)))))) (if (= @inTopic null) (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) [(str/concat (array/first (str/split @inTopic.behavior "/")) "/" @entity.topic)]))) } {
          emit: { success: SEARCH_LISTED, failure: SEARCH_LIST_FAILED }
        })
      PICK -> ready
        (emit PICKED { behavior: ?behavior, description: (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) description ""), trait: (array/first (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) traits [])), value: (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) value) })
      TOGGLE -> ready when ?checked
        (set @entity.selected (array/append (array/filter @entity.selected (fn b (!= @b ?behavior))) ?behavior))
        (emit TOGGLED { behavior: ?behavior, checked: true, topic: (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) topic ""), value: (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) value) })
        (emit CATALOG_SHOWN {})
      TOGGLE -> ready when (not ?checked)
        (set @entity.selected (array/filter @entity.selected (fn b (!= @b ?behavior))))
        (emit TOGGLED { behavior: ?behavior, checked: false, topic: (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) topic ""), value: (object/get (array/find @entity.entries (fn e (= @e.behavior ?behavior))) value) })
        (emit CATALOG_SHOWN {})
      SELECTION -> ready
        (set @entity.selected ?behaviors)
        (emit CATALOG_SHOWN {})
      DESCRIBE -> describing
        (set @entity.detail ?behavior)
        (set @entity.status describing)
        (behavior/describe { behavior: ?behavior } {
          emit: { success: DESCRIBED, failure: DESCRIBE_FAILED }
        })
    }

    state searching {
      SCOPE -> loading when (or (!= ?paths @entity.paths) (and (!= ?fingerprints null) (!= ?fingerprints @entity.fingerprints)))
        (set @entity.paths ?paths)
        (set @entity.fingerprints (if (!= ?fingerprints null) ?fingerprints []))
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: ?paths } { vectors: false emit: { success: LISTED, failure: LIST_FAILED } })
      SEARCH_LISTED -> searching
        (set @entity.searchHits ?result)
        (emit LLM_EMBED { texts: (array/prepend [] @entity.query) })
      SEARCH_LIST_FAILED -> ready
        (set @entity.error ?error)
        (set @entity.status ready)
        (render-ui toast { type: alert, variant: error, message: (str/concat "Search failed: " ?error) })
        (emit CATALOG_SHOWN {})
      INIT -> loading
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          emit: { success: LISTED, failure: LIST_FAILED }
        })
      EMBEDDED -> ready when (> (array/len ?embeddings) 0)
        (set @entity.rows (array/sort (array/flatten (array/map @entity.searchHits (fn e (let ((c (if (object/has @e.vectors description) (array/cosine (object/get @e.vectors description) (array/first ?embeddings)) 0))) (if (== @c null) [] (if (and (>= @c @config.minScore) (or (= @entity.topic "") (and (= @e.package @entity.topicPackage) (= @e.topic @entity.topic)))) [{ behavior: @e.behavior, package: @e.package, description: @e.description, topic: @e.topic, level: @e.level, score: (or @c 0) }] [])))))) score desc))
        (set @entity.status ready)
        (emit CATALOG_SHOWN {})
      EMBEDDED -> ready when (= (array/len ?embeddings) 0)
        (set @entity.error "The model returned no embedding")
        (set @entity.status ready)
        (render-ui toast { type: alert, variant: error, message: "Search is unavailable: the model returned no embedding." })
        (emit CATALOG_SHOWN {})
      SEARCH_FAILED -> ready
        (set @entity.error ?message)
        (set @entity.status ready)
        (render-ui toast { type: alert, variant: error, message: (str/concat "Search failed: " ?message) })
        (emit CATALOG_SHOWN {})
    }

    state describing {
      SCOPE -> loading when (or (!= ?paths @entity.paths) (and (!= ?fingerprints null) (!= ?fingerprints @entity.fingerprints)))
        (set @entity.paths ?paths)
        (set @entity.fingerprints (if (!= ?fingerprints null) ?fingerprints []))
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: ?paths } { vectors: false emit: { success: LISTED, failure: LIST_FAILED } })
      INIT -> loading
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          emit: { success: LISTED, failure: LIST_FAILED }
        })
      DESCRIBED -> ready
        (set @entity.knobs (object/get ?result knobs []))
        (set @entity.status ready)
        (emit CATALOG_SHOWN {})
      DESCRIBE_FAILED -> ready
        (set @entity.error ?error)
        (set @entity.knobs [])
        (set @entity.status ready)
        (render-ui toast { type: alert, variant: error, message: (str/concat "Details failed: " ?error) })
        (emit CATALOG_SHOWN {})
    }

    state failed {
      SCOPE -> loading
        (set @entity.paths ?paths)
        (set @entity.fingerprints (if (!= ?fingerprints null) ?fingerprints []))
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: ?paths } { vectors: false emit: { success: LISTED, failure: LIST_FAILED } })
      INIT -> failed when (= @config.look chips)
        (render-ui main null)
      INIT -> failed when (!= @config.look chips)
        (render-ui main <error-state title="The catalog could not be listed" message={@entity.error} retryEvent="RETRY" />)
      RETRY -> loading
        (set @entity.status loading)
        (render-ui main <loading-state message="Loading the catalog" />)
        (behavior/catalog { paths: (if (> (array/len @entity.paths) 0) @entity.paths @config.scope) } {
          vectors: false
          emit: { success: LISTED, failure: LIST_FAILED }
        })
    }

    emits {
      PICKED -> external {
        behavior : string!
        description : string
        trait : trait
        value : behavior
      }
      TOGGLED -> external {
        behavior : string!
        checked : boolean!
        topic : string!
        value : behavior
      }
      CATALOG_SHOWN
      CATALOG_TOPICS -> external {
        topics : [BehaviorCatalogTopic]!
      }
        @description "Every listed behavior's package and topic once, with how many behaviors each holds, after the catalog is listed: feed a topic picker that answers TOPIC."
        @synonyms "catalog topics, behavior categories, topic counts"
        @tier "primary"
      LISTED {
        result : [BehaviorCatalogHit]!
      }
      TOPICS_LISTED {
        result : [BehaviorCatalogTopic]!
      }
      TOPIC_LISTED {
        result : [BehaviorCatalogHit]!
      }
      LIST_FAILED {
        error : string!
      }
      SEARCH_LISTED {
        result : [BehaviorCatalogHit]!
      }
        @description "behavior/catalog with vectors over the search's folder."
        @tier "internal"
      SEARCH_LIST_FAILED {
        error : string!
      }
        @tier "internal"
      LLM_EMBED -> external {
        texts : [string]!
      }
        @description "Ask std-llm to embed the search query."
        @tier "internal"
      DESCRIBED {
        result : BehaviorCatalogDescription!
      }
      DESCRIBE_FAILED {
        error : string!
      }
    }

    listens {
      BehaviorCatalogLlm.LLM_EMBED_RESULT -> EMBEDDED
      BehaviorCatalogLlm.LLM_FAILED -> SEARCH_FAILED
      EMBEDDED {
        embeddings : [[number]]!
      }
      SEARCH_FAILED {
        code : string
        message : string!
      }
      SEARCH {
        searchTerm : string!
      }
      PICK {
        behavior : string!
      }
      DESCRIBE {
        behavior : string!
      }
      TOGGLE {
        behavior : string!
        checked : boolean!
      }
      SELECTION {
        behaviors : [string]!
      }
      TOPIC {
        package : string!
        topic : string!
      }
        @description "Narrow the rows (and search results) to one package's topic; an empty topic lists every behavior again."
        @synonyms "filter by topic, pick category, browse topic"
      RETRY
      CATALOG_LOAD
        @description "List the folders now: the start a catalog mounted with loadOnInit off waits for; heard only while it has not listed yet."
        @synonyms "load the catalog, start listing"
      SCOPE {
        paths : [string]!
        fingerprints : [string]
      }
        @description "Replace the registry folders the catalog lists (and searches) with these, at run time, and list them again; the same folders in the same order are a no-op, unless the fingerprints it carries (one per folder, how each folder's files stand) differ from the last SCOPE's; the scope knob is what it lists until then."
        @synonyms "set scope, installed packages, list these packages"
    }
  }

  page "/behavior-catalog" as BehaviorCatalogPage -> BehaviorCatalog, BehaviorCatalogLlm
}
