app std-calendar "1.4.0"
"std-calendar as a Function — owns the fetch + SELECT_DAY state machine; default bodyContent renders the month-grid + upcoming-events tree. `config.calendarLook` switches the body between the default month-grid ('month'), a day-grouped agenda list ('agenda-list'), and a 7-column week timeline ('week-timeline') while inheriting the same trait, state machine, emits, and listens."
type ItemAction = { label : string!, event : string, navigatesTo : string, variant : primary | secondary | ghost | danger, icon : string }
orbital CalendarEventOrbital {
    type CalendarEventLoaded = Event { data : [CalendarEvent] } "Fired when CalendarEvent finishes loading; payload.data holds the events"

    type CalendarEventLoadFailed = Event { error : string, code : string } "Fired when CalendarEvent fails to load"

  entity CalendarEvent [runtime] {
    id : string!
    name : string! @description "event title shown on the calendar" @synonyms "title, label, summary, subject"
    description : string @description "event details or notes" @synonyms "details, notes, body, summary"
    status : "active" | "inactive" | "pending" @description "event lifecycle status" @synonyms "state, stage, phase" = active
    createdAt : string
    date : datetime
    time : string @description "event start time of day" @synonyms "start, scheduled time, begins, when, start time" = ""
    duration : number @description "event length in minutes" @synonyms "minutes, length, span, duration" = 60
    selectedRange : string @intrinsic = month
    weekAnchor : date @intrinsic
  }

  trait CalendarEventCalendar -> @rebindable CalendarEvent [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (set @entity.weekAnchor (time/now))
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading calendar…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      CalendarEventLoaded -> month-view
        (if ["=", @config.calendarLook, agenda-list]
          (render-ui main @config.agendaListBodyContent)
          (if ["=", @config.calendarLook, week-timeline]
            (render-ui main @config.weekTimelineBodyContent)
            (render-ui main @config.bodyContent)))
      CalendarEventLoadFailed -> error
        (render-ui main {
          align: center
          children: [{
            color: error
            name: alert-triangle
            type: icon
          }, {
            content: "Failed to load"
            type: typography
            variant: h3
          }, {
            color: muted
            content: ?error
            type: typography
            variant: body
          }, {
            action: RETRY
            icon: rotate-ccw
            label: Retry
            type: button
            variant: primary
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state month-view {
      INIT -> loading
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
        })
        (render-ui main { type: spinner })
      SELECT_DAY -> loading
        (set @entity.selectedRange ?value)
        ;; filter reads the candidate ROW's configured start column — never a
        ;; hardcoded `date`, which retargeted consumers (startField=startTime) lack
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
          filter: (time/isAfter (time/parse (object/get @entity @config.startField)) (if ["=", ?value, week] (time/subtract (time/now) 1 week) (if ["=", ?value, "3months"] (time/subtract (time/now) 3 month) (if ["=", ?value, year] (time/subtract (time/now) 1 year) (time/subtract (time/now) 1 month)))))
        })
      CALENDAR_PREV_WEEK -> loading
        (set @entity.weekAnchor (time/subtract @entity.weekAnchor 1 week))
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
        })
      CALENDAR_NEXT_WEEK -> loading
        (set @entity.weekAnchor (time/add @entity.weekAnchor 1 week))
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
        })
    }

    state error {
      INIT -> loading
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
        })
        (render-ui main { type: spinner })
      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never
      ;; delivers it, so the affordance must target a first-class user event
      RETRY -> loading
        (fetch CalendarEvent {
          emit: { failure: CalendarEventLoadFailed, success: CalendarEventLoaded }
        })
        (render-ui main { type: spinner })
    }

    emits {
      CalendarEventLoaded
        @description "Indicates that calendar events have been successfully retrieved."
        @synonyms "loaded, fetched, retrieved, populated"
        @tier "domain"
      CalendarEventLoadFailed
        @description "Indicates a failure to load calendar events."
        @synonyms "error, failed, problem, loading issue"
        @tier "internal"
      @config.onEventClick -> external {
        event : object
      }
        @description "Emitted when a calendar chip is clicked: UI:{onEventClick} with { event } carrying the clicked row."
        @tier "presentation"
    }

    listens {
      SELECT_DAY {
        value : string!
      }
        @description "A day has been chosen within the calendar view."
        @synonyms "choose, pick, set, highlight"
        @tier "domain"
      SELECT_SLOT {
        time : string!
      }
        @description "A time slot has been chosen for an event."
        @synonyms "choose, pick, schedule, book"
        @tier "domain"
      CalendarEventLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load calendar events."
        @synonyms "error, failure, problem, failed"
        @tier "internal"
      CALENDAR_PREV_WEEK
        @description "Move the week timeline one week earlier."
        @synonyms "previous week, back a week, earlier week, last week"
        @tier "domain"
      CALENDAR_NEXT_WEEK
        @description "Move the week timeline one week later."
        @synonyms "next week, forward a week, later week, following week"
        @tier "domain"
    }

    config {
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      timeBinding : string = @item.time
        @label "Time binding"
        @description "Per-row binding for the event time slot."
        @tier "presentation"
      titleBinding : string = @item.name
        @label "Title binding"
        @description "Per-row binding for the event title slot."
        @tier "presentation"
      badgeBinding : string = @item.status
        @label "Badge binding"
        @description "Per-row binding for the event status/badge slot."
        @tier "presentation"
      descriptionBinding : string = @item.description
        @label "Description binding"
        @description "Per-row binding for the event description slot."
        @tier "presentation"
      startField : string = "date"
        @label "Start field"
        @description "Row column holding the timestamp the calendar grid places each chip by. Rebound hosts point this at their own column (e.g. startTime, startsAt, dueAt); the chip's LABEL comes from titleBinding, not from here."
        @synonyms "start column, date column, when field, timestamp field"
        @tier "presentation"
      onEventClick : string = ""
        @label "On Event Click"
        @description "Event emitted when a calendar chip is clicked: UI:{onEventClick} with { event } carrying the clicked row. Empty means chips are not clickable."
        @synonyms "open event, event click, select event, chip click"
        @tier "presentation"
      calendarLook : "month" | "agenda-list" | "week-timeline" = month
        @label "Calendar look"
        @description "Layer 3 body layout: default month-grid + upcoming-events list ('month'), day-grouped agenda list ('agenda-list'), or 7-column week timeline ('week-timeline')."
        @tier "presentation"
      title : string = "Calendar"
        @label "Title"
        @description "Header text shown above the calendar body."
        @tier "presentation"
      agendaItemActions : [ItemAction] = [{ event: SELECT_DAY, icon: eye, label: View }]
        @label "Agenda item actions"
        @description "Per-item action buttons on agenda-list rows — data-list itemActions descriptors (label/event/icon/variant). Consumers override to wire their own row actions (View/Edit/Delete) so agenda hosts never need a second table for actions."
        @synonyms "agenda actions, row actions, event actions, list actions"
        @tier "presentation"
      agendaGroupBy : string = date
        @label "Agenda group-by field"
        @description "Row field the agenda list groups its day sections by. Rebound hosts point this at their own timestamp column (e.g. startTime, scheduledAt)."
        @synonyms "group field, section field, day field"
        @tier "presentation"
      bodyContent : render-ui = {
        children: [{
          align: center
          children: [{
            align: center
            children: [{ name: calendar, type: icon }, {
              content: @config.title
              type: typography
              variant: h2
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, {
            onSelect: SELECT_DAY
            selected: @entity.selectedRange
            type: date-range-selector
          }]
          direction: horizontal
          gap: md
          justify: between
          type: stack
        }, { type: divider }, {
          events: ?data
          onEventClick: @config.onEventClick
          renderItem: (fn item {
            content: @config.titleBinding
            type: typography
            variant: small
          })
          startField: @config.startField
          type: calendar-grid
        }, { type: divider }, {
          content: "Upcoming Events"
          type: typography
          variant: h4
        }, {
          entity: ?data
          fields: [{
            icon: calendar
            label: Event
            name: name
            variant: h4
          }, {
            label: Time
            name: time
            variant: badge
          }, {
            format: date
            label: Date
            name: date
            variant: caption
          }, {
            label: Status
            name: status
            variant: badge
          }]
          itemActions: [{
            event: SELECT_DAY
            icon: eye
            label: View
          }]
          look: @config.tableLook
          type: data-list
        }]
        direction: vertical
        gap: lg
        type: stack
      }
        @label "Body content tree"
        @description "Render-ui SExpr rendered after events load for calendarLook='month' — the month-grid + upcoming-events list. calendarLook='agenda-list' / 'week-timeline' render agendaListBodyContent / weekTimelineBodyContent instead; all three share this trait's state machine, emits, and listens."
        @tier "internal"
      agendaListBodyContent : render-ui = {
        children: [{
          align: center
          children: [{
            align: center
            children: [{ name: list, type: icon }, {
              content: Agenda
              type: typography
              variant: h2
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, {
            onSelect: SELECT_DAY
            selected: @entity.selectedRange
            type: date-range-selector
          }]
          direction: horizontal
          gap: md
          justify: between
          type: stack
        }, { type: divider }, {
          entity: ?data
          fields: []
          gap: md
          groupBy: @config.agendaGroupBy
          itemActions: @config.agendaItemActions
          renderItem: (fn item {
            children: [{
              align: start
              children: [{
                align: center
                children: [{
                  color: muted
                  content: @config.timeBinding
                  format: time
                  type: typography
                  variant: overline
                }, {
                  color: muted
                  name: clock
                  size: sm
                  type: icon
                }]
                className: "w-16 shrink-0"
                direction: vertical
                gap: xs
                type: stack
              }, { orientation: vertical, type: divider }, {
                children: [{
                  align: center
                  children: [{
                    className: truncate
                    content: @config.titleBinding
                    type: typography
                    variant: h4
                    weight: medium
                  }, {
                    label: @config.badgeBinding
                    size: sm
                    type: badge
                    variant: default
                  }]
                  direction: horizontal
                  gap: sm
                  justify: between
                  type: stack
                }, {
                  className: truncate
                  color: muted
                  content: @config.descriptionBinding
                  type: typography
                  variant: body2
                }]
                className: "flex-1 min-w-0"
                direction: vertical
                gap: xs
                type: stack
              }]
              direction: horizontal
              gap: md
              type: stack
            }]
            look: flat-bordered
            padding: md
            type: card
          })
          type: data-list
          variant: default
        }]
        className: "w-full p-card-md"
        direction: vertical
        gap: lg
        type: stack
      }
        @label "Agenda list body content tree"
        @description "Render-ui SExpr for calendarLook='agenda-list' — events grouped by day with overline day headers (Today, Tomorrow, …) and a time marker per event."
        @tier "internal"
      weekTimelineBodyContent : render-ui = {
        children: [{
          align: center
          children: [{
            align: center
            children: [{ name: calendar, type: icon }, {
              content: Week
              type: typography
              variant: h2
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, {
            align: center
            children: [{
              action: CALENDAR_PREV_WEEK
              icon: chevron-left
              label: "Previous week"
              type: button
              variant: ghost
            }, {
              color: muted
              content: (time/format @entity.weekAnchor "MMM D, YYYY")
              type: typography
              variant: caption
            }, {
              action: CALENDAR_NEXT_WEEK
              icon: chevron-right
              label: "Next week"
              type: button
              variant: ghost
            }]
            direction: horizontal
            gap: xs
            type: stack
          }, {
            onSelect: SELECT_DAY
            selected: @entity.selectedRange
            type: date-range-selector
          }]
          direction: horizontal
          gap: md
          justify: between
          type: stack
        }, { type: divider }, {
          className: w-full
          dayWindow: 7
          events: ?data
          onEventClick: @config.onEventClick
          renderItem: (fn item {
            content: @config.titleBinding
            type: typography
            variant: small
          })
          startField: @config.startField
          swipeLeftEvent: CALENDAR_NEXT_WEEK
          swipeRightEvent: CALENDAR_PREV_WEEK
          type: calendar-grid
          weekStart: @entity.weekAnchor
        }]
        direction: vertical
        gap: md
        type: stack
      }
        @label "Week timeline body content tree"
        @description "Render-ui SExpr for calendarLook='week-timeline' — events grouped by weekday in a 7-column timeline window."
        @tier "internal"
    }
  }

  page "/calendarevents/calendar" as CalendarEventCalendarPage -> CalendarEventCalendar
}