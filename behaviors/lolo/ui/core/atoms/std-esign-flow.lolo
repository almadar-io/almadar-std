app std-esign-flow "1.2.0"
"std-esign-flow — the send-for-signature flow: list signature requests, create one (pick document + recipient), resend or cancel, track status. Composes std-file-store + std-esign-request; no document-rendering or code-preview chrome. v1.2 (W5): EnvelopeDispatcher wires sessions to the real `esign` service — SEND_ENVELOPE dispatches a DocuSign envelope (the document rides the event as an UploadDropZone-shaped file payload, since StoredFile rows are metadata-only) and stamps `envelopeId`/`sentAt`/status=sent; the browse grid's per-row \"Refresh status\" pulls getEnvelopeStatus and maps completed/delivered/declined onto signed/viewed/declined."
orbital SignatureSessionOrbital {
  uses StoredFile from "std/behaviors/std-file-store"

  uses ESignRequest from "std/behaviors/std-esign-request"

  uses Modal from "std/behaviors/std-modal"

  uses Confirmation from "std/behaviors/std-confirmation"

    type SignatureSessionLoaded = Event { data : [SignatureSession] } "Fired when the SignatureSession collection finishes loading"

    type SignatureSessionLoadFailed = Event { error : string, code : string } "Fired when the SignatureSession collection fails to load"

  entity SignatureSession [persistent: signaturesessions] {
    id : string!
    documentId : string! @description "Unique identifier for the associated document." @synonyms "fileID, docID, documentReference"
    documentName : string @description "The name of the document associated with the signature request." @synonyms "filename, document, file" = ""
    recipientName : string! @description "The name of the recipient for the signature request." @synonyms "recipient, name, user"
    recipientEmail : email! @description "The email address of the recipient." @synonyms "email, address, contact"
    requesterName : string @description "The name of the user initiating the signature request." @synonyms "initiator, sender, originator" = ""
    status : "draft" | "sent" | "viewed" | "signed" | "declined" @description "Current state of the signature request." @synonyms "state, condition, stage" = draft
    sentAt : datetime @description "Timestamp indicating when the request was sent." @synonyms "sent date, submission time, dispatched"
    signedAt : datetime @description "The date and time the signature was applied." @synonyms "signed date, completion date, signature time"
    envelopeId : string @description "Provider envelope id stamped when the real e-sign dispatch succeeds; blank = never dispatched. Written by EnvelopeDispatcher, not user-facing." @synonyms "docusign id, provider reference" = ""
    pendingId : string @description "Unique identifier for a pending action or task." @synonyms "taskId, pendingKey, referenceId" = ""
  }

  trait SignatureSessionBrowse -> SignatureSession [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (fetch SignatureSession {
          emit: { failure: SignatureSessionLoadFailed, success: SignatureSessionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading signature requests…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SignatureSessionLoaded -> browsing
        (render-ui main {
          children: [{
            children: [{
              children: [{ name: file-signature, type: icon }, {
                content: "Signature Requests"
                type: typography
                variant: h2
              }]
              direction: horizontal
              gap: md
              type: stack
            }, {
              action: CREATE
              icon: plus
              label: "New Signature Request"
              type: button
              variant: primary
            }]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, { type: divider }, {
            entity: ?data
            fields: [{
              icon: file-text
              label: Document
              name: documentName
              variant: h4
            }, {
              label: Recipient
              name: recipientName
              variant: body
            }, {
              label: Email
              name: recipientEmail
              variant: caption
            }, {
              label: Status
              name: status
              variant: badge
            }, {
              label: Sent
              name: sentAt
              variant: caption
            }]
            itemActions: [{
              event: RESEND_REQUEST
              label: Resend
              variant: primary
            }, {
              event: REQUEST_DELETE
              label: Cancel
              variant: danger
            }, {
              event: CHECK_ENVELOPE_STATUS
              label: "Refresh status"
              variant: secondary
            }]
            type: data-grid
          }]
          direction: vertical
          gap: lg
          type: stack
        })
      SignatureSessionLoadFailed -> error
        (render-ui main {
          align: center
          children: [{
            color: error
            name: alert-triangle
            type: icon
          }, {
            content: "Failed to load signature requests"
            type: typography
            variant: h3
          }, {
            color: muted
            content: ?error
            type: typography
            variant: body
          }, {
            action: RETRY
            icon: rotate-ccw
            label: Retry
            type: button
            variant: primary
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state browsing {
      INIT -> loading
        (fetch SignatureSession {
          emit: { failure: SignatureSessionLoadFailed, success: SignatureSessionLoaded }
        })
        (render-ui main { type: spinner })
    }

    state error {
      INIT -> loading
        (fetch SignatureSession {
          emit: { failure: SignatureSessionLoadFailed, success: SignatureSessionLoaded }
        })
        (render-ui main { type: spinner })
      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never
      ;; delivers it, so the affordance must target a first-class user event
      RETRY -> loading
        (fetch SignatureSession {
          emit: { failure: SignatureSessionLoadFailed, success: SignatureSessionLoaded }
        })
        (render-ui main { type: spinner })
    }

    emits {
      CREATE
        @description "Indicates a new signature request has been initiated."
        @synonyms "new, initiate, start, begin"
        @tier "domain"
      RESEND_REQUEST {
        id : string!
        row : SignatureSession
      }
        @description "Indicates a signature request has been resent."
        @synonyms "resend, retransmit, repeat"
        @tier "presentation"
      CHECK_ENVELOPE_STATUS {
        id : string!
        row : SignatureSession
      }
        @description "Pull the provider's current envelope status for this request."
        @synonyms "refresh status, check signature, poll envelope"
        @tier "domain"
      REQUEST_DELETE {
        id : string!
        row : SignatureSession
      }
        @description "Signals a signature request has been removed."
        @synonyms "remove, purge, discard"
        @tier "presentation"
      SignatureSessionLoaded
        @description "Signals that a signature session has been successfully loaded."
        @synonyms "loaded, initialized, ready"
        @tier "domain"
      SignatureSessionLoadFailed
        @description "Indicates failure to load a signature session."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
    }

    listens {
      SignatureSessionLoadFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load a signature session."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
      SignatureSessionPersistor.SESSION_CREATED -> INIT
      SignatureSessionPersistor.SESSION_RESENT -> INIT
      SignatureSessionPersistor.SESSION_DELETED -> INIT
    }
  }

  trait SignatureSessionCreate = Modal.traits.ModalRecordModal -> SignatureSession {
    events {
      OPEN: CREATE
    }

    config {
      icon: file-signature
      title: "New Signature Request"
      fields: (documentId recipientName recipientEmail requesterName)
      mode: create
    }

    listens {
      SignatureSessionBrowse.CREATE -> CREATE
      CREATE {
        id : string
        row : SignatureSession
      }
        @description "A new signature request is being initiated."
        @synonyms "new, start, begin, initiate"
        @tier "domain"
      SAVE {
        data : @entity!
      }
        @description "Data has been persisted; update the UI accordingly."
        @synonyms "persist, store, update, commit"
        @tier "domain"
      ModalRecordLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load record data for a modal."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
    }
  }

  trait SignatureSessionDelete = Confirmation.traits.ConfirmActionConfirmation -> SignatureSession {
    events {
      REQUEST: DELETE
      CONFIRM: CONFIRM_DELETE
    }

    config {
      icon: alert-triangle
      title: "Cancel Signature Request"
      alertMessage: "Are you sure you want to cancel this signature request?"
      confirmLabel: "Cancel Request"
    }

    listens {
      SignatureSessionBrowse.REQUEST_DELETE -> DELETE
      DELETE {
        id : string
        row : SignatureSession
      }
        @description "A request to remove a signature request from the list."
        @synonyms "remove, dismiss, discard"
        @tier "presentation"
      ConfirmActionLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load data needed for an action."
        @synonyms "error, failure, problem, unsuccessful"
        @tier "internal"
    }
  }

  trait SignatureSessionPersistor -> SignatureSession [lifecycle, instance] {
    initial: idle

    state idle {
      INIT -> idle
      DO_CREATE -> idle
        (persist create SignatureSession ?data {
          emit: { success: SESSION_CREATED }
        })
      DO_RESEND -> idle
        (persist update SignatureSession ?id {
          emit: { success: SESSION_RESENT }
        })
      DO_DELETE -> idle
        (persist delete SignatureSession ?id {
          emit: { success: SESSION_DELETED }
        })
    }

    emits {
      SESSION_CREATED -> external {
        id : string
      }
        @description "A new signature session has been initialized."
        @synonyms "start, begin, initialize"
        @tier "domain"
      SESSION_RESENT -> external {
        id : string
      }
        @description "Indicates a signature request has been resent."
        @synonyms "resend, retransmit, send again"
        @tier "presentation"
      SESSION_DELETED -> external {
        id : string
      }
        @description "Indicates a signature session has been removed or invalidated."
        @synonyms "removed, cleared, expired, terminated"
        @tier "internal"
    }

    listens {
      DO_CREATE {
        data : @entity!
      }
        @description "Initiates the creation of a new signature request."
        @synonyms "new, add, generate, start"
        @tier "domain"
      DO_RESEND {
        id : string
      }
        @description "A request to resend a signature request."
        @synonyms "retry, repeat, send again"
        @tier "presentation"
      DO_DELETE {
        id : string
      }
        @description "A request to remove an item from the current view."
        @synonyms "remove, discard, clear, erase"
        @tier "presentation"
      SignatureSessionCreate.SAVE -> DO_CREATE
      SignatureSessionBrowse.RESEND_REQUEST -> DO_RESEND
      SignatureSessionDelete.CONFIRM_DELETE -> DO_DELETE
    }
  }

  ;; W5: the real e-sign wire. SEND_ENVELOPE dispatches a provider envelope —
  ;; the document travels IN the event as an UploadDropZone-shaped file payload
  ;; (StoredFile rows are metadata-only, so there is nothing to fetch); the
  ;; session row is stamped envelopeId/sentAt/status=sent on success. The
  ;; browse grid's "Refresh status" action pulls the provider status and maps
  ;; completed/delivered/declined onto the session's signed/viewed/declined.
  trait EnvelopeDispatcher -> SignatureSession [lifecycle, instance] {
    initial: idle

    state idle {
      SEND_ENVELOPE -> dispatching
        (set @entity.id ?id)
        (call-service esign sendEnvelope {
          documentContent: (object/get ?file content)
          documentName: (object/get ?row documentName)
          emailSubject: (str/concat "Signature requested: " (object/get ?row documentName))
          recipientEmail: (object/get ?row recipientEmail)
          recipientName: (object/get ?row recipientName)
        } {
          emit: { failure: ENVELOPE_SEND_FAILED, success: ENVELOPE_SENT }
        })
      CHECK_ENVELOPE_STATUS -> polling when ["!=", (object/get ?row envelopeId), ""]
        (set @entity.id ?id)
        (call-service esign getEnvelopeStatus {
          envelopeId: (object/get ?row envelopeId)
        } {
          emit: { failure: ENVELOPE_STATUS_FAILED, success: ENVELOPE_STATUS_LOADED }
        })
      CHECK_ENVELOPE_STATUS -> idle
        (notify info "This request was never dispatched to the e-sign provider — send it first")
      ENVELOPE_STAMPED -> idle
      ENVELOPE_STAMP_FAILED -> idle
        (notify warning "Could not record the envelope state on the request")
    }

    state dispatching {
      ENVELOPE_SENT -> idle
        (persist update SignatureSession {
          id: @entity.id
          envelopeId: ?envelopeId
          sentAt: @now
          status: sent
        } {
          emit: { failure: ENVELOPE_STAMP_FAILED, success: ENVELOPE_STAMPED }
        })
        (notify success "Signature request sent")
      ENVELOPE_SEND_FAILED -> idle
        (notify warning "Could not send the signature request")
    }

    state polling {
      ENVELOPE_STATUS_LOADED -> idle when ["=", ?status, "completed"]
        (persist update SignatureSession {
          id: @entity.id
          signedAt: @now
          status: signed
        } {
          emit: { failure: ENVELOPE_STAMP_FAILED, success: ENVELOPE_STAMPED }
        })
      ENVELOPE_STATUS_LOADED -> idle when ["=", ?status, "delivered"]
        (persist update SignatureSession {
          id: @entity.id
          status: viewed
        } {
          emit: { failure: ENVELOPE_STAMP_FAILED, success: ENVELOPE_STAMPED }
        })
      ENVELOPE_STATUS_LOADED -> idle when ["=", ?status, "declined"]
        (persist update SignatureSession {
          id: @entity.id
          status: declined
        } {
          emit: { failure: ENVELOPE_STAMP_FAILED, success: ENVELOPE_STAMPED }
        })
      ENVELOPE_STATUS_LOADED -> idle
        (persist update SignatureSession {
          id: @entity.id
          status: sent
        } {
          emit: { failure: ENVELOPE_STAMP_FAILED, success: ENVELOPE_STAMPED }
        })
      ENVELOPE_STATUS_FAILED -> idle
        (notify warning "Could not read the envelope status")
    }

    emits {
      ENVELOPE_SENT {
        envelopeId : string
        status : string
      }
        @description "The provider accepted the envelope; carries its id."
        @tier "internal"
      ENVELOPE_SEND_FAILED {
        error : string
        code : string
      }
        @description "The e-sign provider rejected or failed the dispatch."
        @tier "internal"
      ENVELOPE_STATUS_LOADED {
        status : string
        completedAt : string
      }
        @description "The provider returned the envelope's current status."
        @tier "internal"
      ENVELOPE_STATUS_FAILED {
        error : string
        code : string
      }
        @description "Reading the envelope status failed."
        @tier "internal"
      ENVELOPE_STAMPED -> external {
        id : string
      }
        @description "The session row now carries the latest provider state (envelopeId / status / timestamps)."
        @tier "domain"
      ENVELOPE_STAMP_FAILED {
        error : string
        code : string
      }
        @description "Writing the provider state back onto the session row failed."
        @tier "internal"
    }

    listens {
      SEND_ENVELOPE {
        id : string!
        row : SignatureSession
        file : { name : string, size : number, type : string, content : string }
      }
        @description "Dispatch this session as a real e-sign envelope; `file.content` is the document as a base64 data URL (UploadDropZone shape)."
        @synonyms "send envelope, dispatch signature, send for signing"
        @tier "domain"
      SignatureSessionBrowse.CHECK_ENVELOPE_STATUS -> CHECK_ENVELOPE_STATUS
      CHECK_ENVELOPE_STATUS {
        id : string!
        row : SignatureSession
      }
        @description "Pull the provider's current envelope status and stamp it onto the session row."
        @synonyms "refresh status, check signature, poll envelope"
        @tier "domain"
      ENVELOPE_SENT {
        envelopeId : string
        status : string
      }
      ENVELOPE_SEND_FAILED {
        error : string
        code : string
      }
      ENVELOPE_STATUS_LOADED {
        status : string
        completedAt : string
      }
      ENVELOPE_STATUS_FAILED {
        error : string
        code : string
      }
      ENVELOPE_STAMPED {
        id : string
      }
      ENVELOPE_STAMP_FAILED {
        error : string
        code : string
      }
    }
  }

  page "/esign-flow" as SignatureSessionPage -> SignatureSessionBrowse, SignatureSessionCreate, SignatureSessionDelete, SignatureSessionPersistor, EnvelopeDispatcher
}