app std-theme-resolve [
  version: "1.0.0",
  description: "std-theme-resolve — theme preset lookup and precedence (twin of orbital-core base theme.rs). THEME_KEYS lists the data-theme keys a preset set defines (base-light when the base tokens declare anything, base-dark when a dark variant exists; sorted in keys). THEME_RESOLVE picks the orbital theme over the app theme over the minimalist default, splits a base-light or base-dark key (a bare base is light), lets a requested mode override the key suffix, and answers the key, base, mode, whether the base preset is held and whether its dark variant merges (the merge itself is std-canvas-theme CANVAS_THEME_PRESET for the canvas axes). An unknown base keeps the key as given with no tokens; a default whose preset is missing keeps the fixed minimalist-light key. THEME_CARRY names the presets a program carries: every referenced base, every switched-to base and the default, each once, sorted, only those the preset set holds."
]
uses Spec from "almadar-std/theme-resolve"

type ThemePresetInfo = { name : string!, declaresTokens : boolean!, hasDark : boolean! }
type TokDensitySpacing = { space0 : string?, space1 : string?, space2 : string?, space3 : string?, space4 : string?, space5 : string?, space6 : string?, space7 : string?, space8 : string?, space9 : string?, space10 : string?, space11 : string?, space12 : string? }
type TokDensity = { spacing : TokDensitySpacing?, buttonHeightSm : string?, buttonHeightMd : string?, buttonHeightLg : string?, inputHeightSm : string?, inputHeightMd : string?, inputHeightLg : string?, rowHeightCompact : string?, rowHeightNormal : string?, rowHeightSpacious : string?, cardPaddingSm : string?, cardPaddingMd : string?, cardPaddingLg : string?, dialogPadding : string?, sectionGap : string? }
type TokTypeScaleScaleXs = { size : string?, lineHeight : string? }
type TokTypeScaleScaleSm = { size : string?, lineHeight : string? }
type TokTypeScaleScaleBase = { size : string?, lineHeight : string? }
type TokTypeScaleScaleLg = { size : string?, lineHeight : string? }
type TokTypeScaleScaleXl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN2xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN3xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleN4xl = { size : string?, lineHeight : string? }
type TokTypeScaleScaleDisplay1 = { size : string?, lineHeight : string? }
type TokTypeScaleScaleDisplay2 = { size : string?, lineHeight : string? }
type TokTypeScaleScale = { xs : TokTypeScaleScaleXs?, sm : TokTypeScaleScaleSm?, base : TokTypeScaleScaleBase?, lg : TokTypeScaleScaleLg?, xl : TokTypeScaleScaleXl?, "2xl" : TokTypeScaleScaleN2xl?, "3xl" : TokTypeScaleScaleN3xl?, "4xl" : TokTypeScaleScaleN4xl?, display-1 : TokTypeScaleScaleDisplay1?, display-2 : TokTypeScaleScaleDisplay2? }
type TokTypeScaleIntentsHeadingMajor = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsHeadingMinor = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyEmphasis = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyDefault = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsBodyQuiet = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsCaption = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntentsNumeric = { size : string?, weight : string?, slot : string? }
type TokTypeScaleIntents = { headingMajor : TokTypeScaleIntentsHeadingMajor?, headingMinor : TokTypeScaleIntentsHeadingMinor?, bodyEmphasis : TokTypeScaleIntentsBodyEmphasis?, bodyDefault : TokTypeScaleIntentsBodyDefault?, bodyQuiet : TokTypeScaleIntentsBodyQuiet?, caption : TokTypeScaleIntentsCaption?, numeric : TokTypeScaleIntentsNumeric? }
type TokTypeScale = { displayFamily : string?, bodyFamily : string?, monoFamily : string?, headingWeight : string?, headingTransform : string?, headingTracking : string?, headingStyle : string?, headingShadow : string?, scale : TokTypeScaleScale?, intents : TokTypeScaleIntents?, fontImport : string? }
type TokMotionDurations = { instant : string?, fast : string?, normal : string?, slow : string?, dramatic : string? }
type TokMotionEasings = { linear : string?, standard : string?, emphasized : string?, spring : string? }
type TokMotionIntentsEnter = { duration : string?, easing : string? }
type TokMotionIntentsExit = { duration : string?, easing : string? }
type TokMotionIntentsHover = { duration : string?, easing : string? }
type TokMotionIntentsPress = { duration : string?, easing : string? }
type TokMotionIntentsExpand = { duration : string?, easing : string? }
type TokMotionIntentsTransition = { duration : string?, easing : string? }
type TokMotionIntents = { enter : TokMotionIntentsEnter?, exit : TokMotionIntentsExit?, hover : TokMotionIntentsHover?, press : TokMotionIntentsPress?, expand : TokMotionIntentsExpand?, transition : TokMotionIntentsTransition? }
type TokMotionShapes = { modalEnter : string?, modalExit : string?, popoverEnter : string?, popoverExit : string?, toastEnter : string?, toastExit : string?, pageEnter : string?, enterRise : string?, enterScale : string?, enterSlide : string? }
type TokMotionEntry = { default : string?, stagger : string? }
type TokMotion = { durations : TokMotionDurations?, easings : TokMotionEasings?, intents : TokMotionIntents?, shapes : TokMotionShapes?, entry : TokMotionEntry?, busyDelay : string?, awaitingSkeleton : boolean? }
type TokIconography = { family : string?, strokeWidth : string?, defaultSize : string? }
type TokElevation = { cardElevation : string?, popoverElevation : string?, dialogElevation : string?, toastElevation : string?, interactiveElevation : string?, pressedElevation : string? }
type TokGeometry = { radiusContainer : string?, radiusInteractive : string?, radiusPill : string?, borderHairline : string?, borderStandard : string?, borderHeavy : string?, cornerShape : string?, cornerShapePill : string?, cornerShapeInteractive : string?, borderStyle : string?, borderStyleInteractive : string? }
type TokIllustration = { loadingAsset : string?, style : string? }
type TokSurface = { backdrop : string?, cardImage : string?, pageImage : string?, pageImageSize : string?, diagram : string?, edgeMask : string?, edgeHeight : string?, textureMask : string?, textureSize : string?, accentImage : string?, scrim : string? }
type TokDiagram = { strokeThin : string?, strokeNormal : string?, strokeBold : string?, lineCap : string?, lineJoin : string?, dash : string?, dot : string?, fillStyle : string?, fillOpacity : string?, roughness : string?, glow : string?, shadow : string?, marker : string?, labelFont : string?, labelSize : string?, labelWeight : string?, labelCase : string?, corner : string? }
type TokScene = { materialRoughness : string?, materialMetalness : string?, materialFlat : string?, materialOutline : string?, lightAmbient : string?, lightKey : string?, lightKeyColor : string?, fog : string? }
type ThemeTokens = { color : (Map string string)?, colors : (Map string string)?, radii : (Map string string)?, spacing : (Map string string)?, typography : (Map string string)?, shadows : (Map string string)?, density : TokDensity?, typeScale : TokTypeScale?, motion : TokMotion?, iconography : TokIconography?, elevation : TokElevation?, geometry : TokGeometry?, illustration : TokIllustration?, surface : TokSurface?, diagram : TokDiagram?, scene : TokScene? }
type ThemeUse = { name : string!, theme : string! }

orbital ThemeResolveOrbital {
  entity ThemeResolveRun [runtime] {
    id : string!
    ref : string @description "The winning theme reference, empty when none is declared." = ""
    key : string = ""
    base : string = ""
    mode : string = ""
    found : boolean = false
    mergesVariant : boolean = false
    declared : [string] = []
    keys : [string] = []
    names : [string] = []
    vars : Map string string @description "The CSS custom properties of the last THEME_CSS_VARS." = {}
  }

  trait ThemeResolve -> ThemeResolveRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      THEME_KEYS -> ready
        (set @entity.declared (array/flatten (array/map ?presets (fn p (array/concat (if @p.declaresTokens (list (str/concat @p.name "-light")) []) (if @p.hasDark (list (str/concat @p.name "-dark")) []))))))
        (set @entity.keys (array/sort @entity.declared))
        (emit THEME_KEYS_RESULT { declared: @entity.declared, keys: @entity.keys })
      THEME_RESOLVE -> ready
        (set @entity.ref (let ((m (array/filter ?orbitals (fn o (== @o.name ?orbital))))) (let ((ot (let ((first (array/nth @m 0))) (if (= @first null) "" (object/get @first "theme"))))) (if (!= @ot "") @ot ?appTheme))))
        (set @entity.mode (if ?hasMode ?requestedMode (if (str/endsWith @entity.ref "-dark") "dark" "light")))
        (set @entity.base (if (== @entity.ref "") "minimalist" (if (str/endsWith @entity.ref "-dark") (str/slice @entity.ref 0 (- (str/len @entity.ref) 5)) (if (str/endsWith @entity.ref "-light") (str/slice @entity.ref 0 (- (str/len @entity.ref) 6)) @entity.ref))))
        (set @entity.found (array/some ?presets (fn p (== @p.name @entity.base))))
        (set @entity.mergesVariant (and @entity.found (and (== @entity.mode "dark") (array/some ?presets (fn p (and (== @p.name @entity.base) @p.hasDark))))))
        (set @entity.key (if (and (== @entity.ref "") (not @entity.found)) "minimalist-light" (str/concat @entity.base "-" @entity.mode)))
        (emit THEME_RESOLVED { key: @entity.key, base: @entity.base, mode: @entity.mode, found: @entity.found, mergesVariant: @entity.mergesVariant })
      THEME_MERGE -> ready
        (let ((noVar : ThemeTokens {}) (noMap : Map string string {}) (vr : ThemeTokens (default ?variant @noVar))) (emit THEME_MERGED { tokens: { color: (if (and (== ?mode "dark") (object/has @vr "color")) (object/get @vr "color") (object/get ?base "color")), colors: (if (and (== ?mode "dark") (object/has @vr "colors")) (object/merge (object/get ?base "colors" @noMap) (object/get @vr "colors" @noMap)) (object/get ?base "colors")), radii: (if (and (== ?mode "dark") (object/has @vr "radii")) (object/get @vr "radii") (object/get ?base "radii")), spacing: (if (and (== ?mode "dark") (object/has @vr "spacing")) (object/get @vr "spacing") (object/get ?base "spacing")), typography: (if (and (== ?mode "dark") (object/has @vr "typography")) (object/get @vr "typography") (object/get ?base "typography")), shadows: (if (and (== ?mode "dark") (object/has @vr "shadows")) (object/get @vr "shadows") (object/get ?base "shadows")), density: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density") (object/get ?base "density")), typeScale: (if (and (== ?mode "dark") (object/has @vr "typeScale")) (object/get @vr "typeScale") (object/get ?base "typeScale")), motion: (if (and (== ?mode "dark") (object/has @vr "motion")) (object/get @vr "motion") (object/get ?base "motion")), iconography: (if (and (== ?mode "dark") (object/has @vr "iconography")) (object/get @vr "iconography") (object/get ?base "iconography")), elevation: (if (and (== ?mode "dark") (object/has @vr "elevation")) (object/get @vr "elevation") (object/get ?base "elevation")), geometry: (if (and (== ?mode "dark") (object/has @vr "geometry")) (object/get @vr "geometry") (object/get ?base "geometry")), illustration: (if (and (== ?mode "dark") (object/has @vr "illustration")) (object/get @vr "illustration") (object/get ?base "illustration")), surface: (if (and (== ?mode "dark") (object/has @vr "surface")) (object/get @vr "surface") (object/get ?base "surface")), diagram: (if (and (== ?mode "dark") (object/has @vr "diagram")) (object/get @vr "diagram") (object/get ?base "diagram")), scene: (if (and (== ?mode "dark") (object/has @vr "scene")) (object/get @vr "scene") (object/get ?base "scene")) } }))
      THEME_CSS_VARS -> ready
        (let ((noVar : ThemeTokens {}) (noMap : Map string string {}) (vr : ThemeTokens (default ?variant @noVar))) (set @entity.vars (array/reduce (array/flatten (list (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space0") (object/has ?base "density.spacing.space0")) (list { n: "--space-0", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space0") (object/get ?base "density.spacing.space0")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space1") (object/has ?base "density.spacing.space1")) (list { n: "--space-1", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space1") (object/get ?base "density.spacing.space1")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space2") (object/has ?base "density.spacing.space2")) (list { n: "--space-2", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space2") (object/get ?base "density.spacing.space2")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space3") (object/has ?base "density.spacing.space3")) (list { n: "--space-3", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space3") (object/get ?base "density.spacing.space3")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space4") (object/has ?base "density.spacing.space4")) (list { n: "--space-4", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space4") (object/get ?base "density.spacing.space4")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space5") (object/has ?base "density.spacing.space5")) (list { n: "--space-5", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space5") (object/get ?base "density.spacing.space5")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space6") (object/has ?base "density.spacing.space6")) (list { n: "--space-6", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space6") (object/get ?base "density.spacing.space6")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space7") (object/has ?base "density.spacing.space7")) (list { n: "--space-7", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space7") (object/get ?base "density.spacing.space7")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space8") (object/has ?base "density.spacing.space8")) (list { n: "--space-8", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space8") (object/get ?base "density.spacing.space8")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space9") (object/has ?base "density.spacing.space9")) (list { n: "--space-9", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space9") (object/get ?base "density.spacing.space9")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space10") (object/has ?base "density.spacing.space10")) (list { n: "--space-10", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space10") (object/get ?base "density.spacing.space10")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space11") (object/has ?base "density.spacing.space11")) (list { n: "--space-11", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space11") (object/get ?base "density.spacing.space11")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.spacing.space12") (object/has ?base "density.spacing.space12")) (list { n: "--space-12", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.spacing.space12") (object/get ?base "density.spacing.space12")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.buttonHeightSm") (object/has ?base "density.buttonHeightSm")) (list { n: "--button-height-sm", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.buttonHeightSm") (object/get ?base "density.buttonHeightSm")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.buttonHeightMd") (object/has ?base "density.buttonHeightMd")) (list { n: "--button-height-md", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.buttonHeightMd") (object/get ?base "density.buttonHeightMd")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.buttonHeightLg") (object/has ?base "density.buttonHeightLg")) (list { n: "--button-height-lg", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.buttonHeightLg") (object/get ?base "density.buttonHeightLg")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.inputHeightSm") (object/has ?base "density.inputHeightSm")) (list { n: "--input-height-sm", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.inputHeightSm") (object/get ?base "density.inputHeightSm")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.inputHeightMd") (object/has ?base "density.inputHeightMd")) (list { n: "--input-height-md", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.inputHeightMd") (object/get ?base "density.inputHeightMd")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.inputHeightLg") (object/has ?base "density.inputHeightLg")) (list { n: "--input-height-lg", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.inputHeightLg") (object/get ?base "density.inputHeightLg")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.rowHeightCompact") (object/has ?base "density.rowHeightCompact")) (list { n: "--row-height-compact", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.rowHeightCompact") (object/get ?base "density.rowHeightCompact")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.rowHeightNormal") (object/has ?base "density.rowHeightNormal")) (list { n: "--row-height-normal", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.rowHeightNormal") (object/get ?base "density.rowHeightNormal")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.rowHeightSpacious") (object/has ?base "density.rowHeightSpacious")) (list { n: "--row-height-spacious", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.rowHeightSpacious") (object/get ?base "density.rowHeightSpacious")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.cardPaddingSm") (object/has ?base "density.cardPaddingSm")) (list { n: "--card-padding-sm", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.cardPaddingSm") (object/get ?base "density.cardPaddingSm")) }) []) (if (if (and (== ?mode "dark") (object/has @vr "density")) (object/has @vr "density.cardPaddingMd") (object/has ?base "density.cardPaddingMd")) (list { n: "--card-padding-md", x: (if (and (== ?mode "dark") (object/has @vr "density")) (object/get @vr "density.cardPaddingMd") (object/get ?base "density.cardPadd