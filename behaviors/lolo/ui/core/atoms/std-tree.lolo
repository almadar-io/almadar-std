app std-tree "1.0.0"
"std-tree — generic hierarchical node browser. Fetches a flat TreeNode collection and renders it through file-tree's flat `items` mode (parentId-nested at render time by the component, not the .lolo); OPEN_NODE is the external handoff for a selected node's id. Rebindable: pass `fields` at the call site to retarget it at any parent-pointer entity (categories, org units, comment threads). Search/filter are wired (REFETCH_QUERY/REFETCH_FILTER re-fetch the flat node set server-side). `look: rail` renders the compact sidebar-navigation form (slim caption, nav-styled rows) for mounting in an app layout's sidebarTrait; SET_CURRENT marks the open record so the row highlights and its ancestors auto-expand; `childAction: true` renders a hover plus-affordance per row emitting CHILD_REQUESTED { parentId } for the host's create-draft writer; pagination is deliberately NOT offered — a hierarchy is not a paged list, and paging a flat node set would sever children from parents that fell on another page."
type FilterSpec = { field : string!, label : string, options : [string] }
orbital TreeNodeOrbital {
    type TreeNodeLoaded = Event { data : [TreeNode] } "Fired when the tree node collection finishes loading"

    type TreeNodeLoadFailed = Event { error : string, code : string } "Fired when the tree node collection fails to load"

  entity TreeNode [persistent: treenodes] {
    id : string!
    name : string! @description "The descriptive label for this node." @synonyms "label, title, text"
    parentId : string @description "Reference to the parent node in the hierarchy; empty marks a root." @synonyms "parent, superior, ancestor" = ""
    icon : string @description "Icon name shown beside the node." @synonyms "glyph, symbol, pictogram" = ""
    createdAt : string
  }

  trait TreeBrowse -> @rebindable TreeNode [interaction, collection] {
    initial: loading

    state loading {
      SET_CURRENT -> loading
        (set @entity.id ?id)
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
        })
      INIT -> loading
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading tree…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      TreeNodeLoaded -> browsing
        (render-ui main {
          children: [(if ["=", @config.look, "rail"] {
            className: "px-2 pb-1 uppercase tracking-wide"
            color: muted
            content: @config.title
            type: typography
            variant: caption
          } {
            align: center
            children: [{ name: list-tree, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }, {
              label: (array/len ?data)
              size: sm
              type: badge
              variant: neutral
            }]
            direction: horizontal
            gap: sm
            type: stack
          }), (if ["=", @config.look, "rail"] {
            children: []
            gap: none
            type: stack
          } { type: divider }), (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if [">", (array/len @config.filters), 0] {
            children: [{
              entity: TreeNode
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), {
            items: (array/map ?data (fn row {
              icon: (str/default (object/get @row @config.iconField) "")
              id: @row.id
              label: (str/default (object/get @row @config.labelField) "")
              parentId: (str/default (object/get @row @config.parentField) "")
            }))
            look: (if ["=", @config.look, "rail"] nav files)
            nodeActionIcon: plus
            nodeActionLabel: @config.childActionLabel
            onNodeAction: (if @config.childAction ADD_CHILD null)
            onNodeSelect: OPEN_NODE
            selectedId: (str/default (object/get @entity id) "")
            type: file-tree
          }]
          direction: vertical
          gap: md
          type: stack
        })
      TreeNodeLoadFailed -> error
        (render-ui main {
          align: center
          children: [{
            color: error
            name: alert-triangle
            type: icon
          }, {
            content: "Failed to load tree"
            type: typography
            variant: body
          }, {
            color: muted
            content: ?error
            type: typography
            variant: caption
          }, {
            action: RETRY
            icon: rotate-ccw
            label: Retry
            type: button
            variant: ghost
          }]
          className: py-8
          direction: vertical
          gap: sm
          type: stack
        })
    }

    state browsing {
      INIT -> loading
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading tree…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      ;; REFETCH_* stays in `browsing` and DOES NOT replace the tree with a
      ;; spinner — search-as-you-type would otherwise unmount file-tree every
      ;; keystroke and flicker. The fetch fires in the background; when
      ;; TreeNodeLoaded arrives (handler below) React reconciles the tree in
      ;; place. No REFETCH_PAGE: a hierarchy is not a paged list — paging the
      ;; flat node set would sever children from parents on another page.
      REFETCH_QUERY -> browsing
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
          filter: (or ["=", ?searchTerm, ""] (str/includes (str/default (object/get @entity @config.labelField) "") ?searchTerm))
        })
      REFETCH_FILTER -> browsing
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
          filter: (or ["=", ?value, ""] ["=", (object/get @entity ?field), ?value])
        })
      OPEN_NODE -> browsing
        (set @entity.id ?id)
      ;; The open record changed (routed from the host document's load
      ;; events): remember it and re-fetch so the re-render highlights the
      ;; row and unfolds its ancestors.
      SET_CURRENT -> browsing
        (set @entity.id ?id)
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
        })
      ADD_CHILD -> browsing
        (emit CHILD_REQUESTED { parentId: ?id })
      TreeNodeLoaded -> browsing
        (render-ui main {
          children: [(if ["=", @config.look, "rail"] {
            className: "px-2 pb-1 uppercase tracking-wide"
            color: muted
            content: @config.title
            type: typography
            variant: caption
          } {
            align: center
            children: [{ name: list-tree, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }, {
              label: (array/len ?data)
              size: sm
              type: badge
              variant: neutral
            }]
            direction: horizontal
            gap: sm
            type: stack
          }), (if ["=", @config.look, "rail"] {
            children: []
            gap: none
            type: stack
          } { type: divider }), (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if [">", (array/len @config.filters), 0] {
            children: [{
              entity: TreeNode
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), {
            items: (array/map ?data (fn row {
              icon: (str/default (object/get @row @config.iconField) "")
              id: @row.id
              label: (str/default (object/get @row @config.labelField) "")
              parentId: (str/default (object/get @row @config.parentField) "")
            }))
            look: (if ["=", @config.look, "rail"] nav files)
            nodeActionIcon: plus
            nodeActionLabel: @config.childActionLabel
            onNodeAction: (if @config.childAction ADD_CHILD null)
            onNodeSelect: OPEN_NODE
            selectedId: (str/default (object/get @entity id) "")
            type: file-tree
          }]
          direction: vertical
          gap: md
          type: stack
        })
      TreeNodeLoadFailed -> error
        (render-ui main {
          align: center
          children: [{
            color: error
            name: alert-triangle
            type: icon
          }, {
            content: "Failed to load tree"
            type: typography
            variant: body
          }, {
            color: muted
            content: ?error
            type: typography
            variant: caption
          }, {
            action: RETRY
            icon: rotate-ccw
            label: Retry
            type: button
            variant: ghost
          }]
          className: py-8
          direction: vertical
          gap: sm
          type: stack
        })
    }

    state error {
      INIT -> loading
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
        })
        (render-ui main { type: spinner })
      ;; the error screen's Retry button: INIT is lifecycle-only and the bus never
      ;; delivers it, so the affordance must target a first-class user event
      RETRY -> loading
        (fetch TreeNode {
          emit: { failure: TreeNodeLoadFailed, success: TreeNodeLoaded }
        })
        (render-ui main { type: spinner })
    }

    emits {
      OPEN_NODE {
        id : string!
      }
        @description "Signals a tree node has been selected for external handoff."
        @synonyms "select, choose, open, activate"
        @tier "domain"
      CHILD_REQUESTED -> external {
        parentId : string!
      }
        @description "Create a new record under this node — the host routes it into its create-draft writer with parentId stamped."
        @synonyms "new subpage, add child page, create under"
        @tier "domain"
      TreeNodeLoaded {
        data : [TreeNode]
      }
        @description "Indicates the tree node collection has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved, ready"
        @tier "domain"
      TreeNodeLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load the tree node collection."
        @synonyms "error, failed, problem, unsuccessful"
        @tier "internal"
    }

    listens {
      SET_CURRENT {
        id : string!
      }
        @description "Mark this record as the open one (routed from the host document's load events); its row highlights and its ancestors auto-expand."
        @synonyms "highlight current, select node, you are here"
        @tier "domain"
      ADD_CHILD {
        id : string!
      }
        @description "The row's hover + affordance was clicked."
        @synonyms "add inside, new child"
        @tier "presentation"
      REFETCH_QUERY {
        searchTerm : string!
      }
        @description "Triggers a tree refresh based on the current search query."
        @synonyms "refresh, reload, update, re-query"
        @tier "domain"
      REFETCH_FILTER {
        field : string!
        value : string!
      }
        @description "Triggers a tree refresh based on current filter criteria."
        @synonyms "refresh, filter, update, reload"
        @tier "domain"
      OPEN_NODE {
        id : string!
      }
        @description "A tree node was selected for external handoff."
        @synonyms "select, choose, open, activate"
        @tier "domain"
      TreeNodeLoaded {
        data : [TreeNode]
      }
        @description "Indicates the tree node collection has been successfully retrieved."
        @synonyms "loaded, fetched, retrieved, ready"
        @tier "domain"
      TreeNodeLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load the tree node collection."
        @synonyms "error, failed, problem, unsuccessful"
        @tier "internal"
    }

    config {
      title : string = Tree
        @label "Section title"
        @description "Heading shown above the tree"
        @tier "presentation"
      labelField : string = name
        @label "Label column"
        @description "Entity field rendered as each node's label. Config-driven on purpose: the trait-level `fields {}` remap is compiled-path-only (the JS runtime never applies it), so a rebind names its columns here and both execution paths agree."
        @synonyms "title field, name column, display field"
        @tier "domain"
      parentField : string = parentId
        @label "Parent column"
        @description "Entity field holding the parent reference the hierarchy nests by."
        @synonyms "parent id field, hierarchy column"
        @tier "domain"
      iconField : string = icon
        @label "Icon column"
        @description "Entity field holding each node's icon name; point it at a nonexistent field (or empty) to suppress per-node icons."
        @synonyms "glyph field, icon column"
        @tier "presentation"
      look : "full" | "rail" = full
        @label "Tree look"
        @description "full = standalone section (heading, count, divider); rail = compact sidebar navigation (slim caption, nav-styled rows) for an app layout's sidebarTrait slot."
        @synonyms "sidebar tree, rail look, nav tree, compact"
        @tier "presentation"
      childAction : boolean = false
        @label "Row + affordance?"
        @description "Render a hover + on every row that emits CHILD_REQUESTED { parentId } — wire it to the host's create-draft writer so new records are born inside the node."
        @synonyms "add inside, new subpage button, plus on rows"
        @tier "domain"
      childActionLabel : string = "Add inside"
        @label "Row + tooltip"
        @description "Accessible label on the row's + affordance (e.g. New subpage)."
        @tier "presentation"
      bodySearch : boolean = false
        @label "Show the tree's own search box?"
        @description "Embeds a search box above the tree that re-fetches the flat node set server-side. Set false (the default) when the page already provides a search affordance (a toolbar Search molecule), so the surface shows one search box instead of two."
        @synonyms "inline search, list search, built-in search, show search, duplicate search"
        @tier "presentation"
      searchPlaceholder : string = "Search…"
        @label "Search box placeholder text"
        @description "Hint text inside the tree search box (e.g. 'Search nodes…')."
        @synonyms "search hint, placeholder, search box text, search label"
        @tier "presentation"
      filters : [FilterSpec] = []
        @label "Which filters should appear above the tree?"
        @description "Dropdown filter facets by field, rendered as an embedded filter bar above the tree; each selection fires REFETCH_FILTER on this trait, re-fetching the flat node set. Empty (the default) = no filter bar, which is the right setting whenever the page already composes std-filter beside this tree and routes `XFilter.FILTER -> REFETCH_FILTER` — that is the wired owner and remains the primary path."
        @synonyms "filter bar, faceted filters, field filters, dropdowns"
        @tier "presentation"
      filterBarLook : "toolbar" | "chips" | "pills" | "popover-trigger" | "inline-column-header" = toolbar
        @label "Filter bar look"
        @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty."
        @synonyms "filter bar style, facet style, chips, pills"
        @tier "presentation"
    }
  }

  page "/tree" as TreePage -> TreeBrowse
}
