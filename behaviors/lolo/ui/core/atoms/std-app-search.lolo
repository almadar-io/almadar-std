app std-app-search [
  version: "1.0.0",
  description: "std-app-search — reusable global search: wraps a host content view and, on a SEARCH trigger, fetches the linked entity filtered by @config.searchField and renders the matching results, then CLEAR_SEARCH returns to the host view. Rebind to any entity; point @config.idleContent at the normal view and wire a trigger (e.g. AppLayout SEARCH) into SEARCH."
]
type AppSearchFieldSpec = { name : string!, label : string, variant : h3 | h4 | body | caption | badge | small | progress, icon : string, format : date | currency | number | boolean | percent, event : string, href : string, payload : string, disabled : boolean, confirm : string, hidden : boolean }
type AppSearchRelatedRow = { id : string! }
type AppSearchActionSpec = { label : string!, event : event!, variant : primary | secondary | ghost | danger, icon : string, href : string, payload : string, disabled : boolean, confirm : string, hidden : boolean, roles : [string] }
orbital AppSearchOrbital {
  type AppSearchLoaded = Event { data : [AppSearchTarget]!, totalCount : number } "One page of filtered search results loaded"
  type AppSearchFailed = Event { error : string } "Search fetch failed"
  type AppSearchRelatedLoaded = Event { data : [AppSearchRelatedRow]!, totalCount : number! } "Related rows whose text matches the query loaded"

  entity AppSearchTarget [runtime] {
    id : string!
    name : string @description "The primary human-readable label matched by search." @synonyms "title, label, productName"
    searchTerm : string @intrinsic @description "The current search query the user submitted." @synonyms "query, term, q" = ""
    appSearchPage : number @intrinsic @description "The results page the search shows." = 1
  }

  trait AppSearchIdleHint -> AppSearchTarget [client] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: sm
          className: "py-12"
          children: [{ type: icon, name: search, size: lg, color: muted }, {
            type: typography
            variant: caption
            color: muted
            content: "Start typing to search"
          }]
        })
    }
  }

  trait AppSearch -> @rebindable AppSearchTarget {
    initial: idle

    state idle {
      INIT -> idle
        (fetch AppSearchTarget {
          limit: 1
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: md
          children: [@config.idleContent]
        })
      APP_SEARCH -> searching when (not (validate/required @config.searchRelation))
        (set @entity.searchTerm ?value)
        (set @entity.appSearchPage 1)
        (fetch AppSearchTarget {
          filter: (or (= ?value "") (str/includes (object/get @entity @config.searchField) ?value))
          emit: { success: AppSearchLoaded, failure: AppSearchFailed }
          limit: @config.pageSize
          offset: 0
        })
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: md
          className: "py-12"
          children: [{ type: spinner }, {
            type: typography
            variant: caption
            color: muted
            content: "Searching…"
          }]
        })
      APP_SEARCH -> searching when (validate/required @config.searchRelation)
        (set @entity.searchTerm ?value)
        (set @entity.appSearchPage 1)
        (fetch @config.relatedEntity {
          filter: (or (= ?value "") (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") ?value)))
          emit: { success: AppSearchRelatedLoaded, failure: AppSearchFailed }
          limit: @config.relatedMaxRows
        })
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: md
          className: "py-12"
          children: [{ type: spinner }, {
            type: typography
            variant: caption
            color: muted
            content: "Searching…"
          }]
        })
    }

    state searching {
      INIT -> idle
        (set @entity.searchTerm "")
        (fetch AppSearchTarget {
          limit: 1
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: md
          children: [@config.idleContent]
        })
      APP_SEARCH -> searching when (not (validate/required @config.searchRelation))
        (set @entity.searchTerm ?value)
        (set @entity.appSearchPage 1)
        (fetch AppSearchTarget {
          filter: (or (= ?value "") (str/includes (object/get @entity @config.searchField) ?value))
          emit: { success: AppSearchLoaded, failure: AppSearchFailed }
          limit: @config.pageSize
          offset: 0
        })
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: md
          className: "py-12"
          children: [{ type: spinner }, {
            type: typography
            variant: caption
            color: muted
            content: "Searching…"
          }]
        })
      APP_SEARCH -> searching when (validate/required @config.searchRelation)
        (set @entity.searchTerm ?value)
        (set @entity.appSearchPage 1)
        (fetch @config.relatedEntity {
          filter: (or (= ?value "") (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") ?value)))
          emit: { success: AppSearchRelatedLoaded, failure: AppSearchFailed }
          limit: @config.relatedMaxRows
        })
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: md
          className: "py-12"
          children: [{ type: spinner }, {
            type: typography
            variant: caption
            color: muted
            content: "Searching…"
          }]
        })
      AppSearchRelatedLoaded -> searching when (> ?totalCount (array/len ?data))
        (emit AppSearchFailed { error: (str/concat @config.relatedEntity " has " ?totalCount " rows matching the search, over the relatedMaxRows cap of " @config.relatedMaxRows) })
      AppSearchRelatedLoaded -> searching
        (fetch AppSearchTarget {
          filter: (or (= @entity.searchTerm "") (if (not (validate/required @config.searchRelation)) false (array/includes (array/map ?data (fn r (object/get @r id))) (object/get @entity @config.searchRelation))))
          emit: { success: AppSearchLoaded, failure: AppSearchFailed }
          limit: @config.pageSize
          offset: (* (- @entity.appSearchPage 1) @config.pageSize)
        })
      AppSearchLoaded -> results
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          className: "max-w-6xl mx-auto w-full p-4"
          children: [{
            type: stack
            direction: horizontal
            gap: sm
            justify: between
            align: center
            children: [{ size: xl, type: icon, name: search }, {
              type: typography
              variant: h2
              content: @config.resultsTitle
            }, {
              type: button
              variant: ghost
              icon: x
              label: "Clear search"
              action: CLEAR_SEARCH
            }]
          }, {
            type: typography
            variant: caption
            color: muted
            content: (str/concat (str/concat "Matching “" @entity.searchTerm) "”")
          }, { type: divider }, {
            type: data-grid
            entity: @payload.data
            fields: @config.resultFields
            itemActions: (array/filter @config.resultActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
            pageSize: 0
          }, {
            type: pagination
            currentPage: @entity.appSearchPage
            totalPages: (math/max 1 (math/ceil (/ ?totalCount @config.pageSize)))
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
          }]
        })
      AppSearchFailed -> idle
        (render-ui main {
          type: stack
          direction: vertical
          gap: md
          children: [{
            type: alert
            variant: error
            message: ?error
          }, @config.idleContent]
        })
    }

    state results {
      INIT -> idle
        (set @entity.searchTerm "")
        (fetch AppSearchTarget {
          limit: 1
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: md
          children: [@config.idleContent]
        })
      APP_SEARCH -> searching when (not (validate/required @config.searchRelation))
        (set @entity.searchTerm ?value)
        (set @entity.appSearchPage 1)
        (fetch AppSearchTarget {
          filter: (or (= ?value "") (str/includes (object/get @entity @config.searchField) ?value))
          emit: { success: AppSearchLoaded, failure: AppSearchFailed }
          limit: @config.pageSize
          offset: 0
        })
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: md
          className: "py-12"
          children: [{ type: spinner }, {
            type: typography
            variant: caption
            color: muted
            content: "Searching…"
          }]
        })
      APP_SEARCH -> searching when (validate/required @config.searchRelation)
        (set @entity.searchTerm ?value)
        (set @entity.appSearchPage 1)
        (fetch @config.relatedEntity {
          filter: (or (= ?value "") (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") ?value)))
          emit: { success: AppSearchRelatedLoaded, failure: AppSearchFailed }
          limit: @config.relatedMaxRows
        })
        (render-ui main {
          type: stack
          align: center
          direction: vertical
          gap: md
          className: "py-12"
          children: [{ type: spinner }, {
            type: typography
            variant: caption
            color: muted
            content: "Searching…"
          }]
        })
      REFETCH_PAGE -> searching when (not (validate/required @config.searchRelation))
        (set @entity.appSearchPage ?page)
        (fetch AppSearchTarget {
          filter: (or (= @entity.searchTerm "") (str/includes (object/get @entity @config.searchField) @entity.searchTerm))
          emit: { success: AppSearchLoaded, failure: AppSearchFailed }
          limit: @config.pageSize
          offset: (* (- ?page 1) @config.pageSize)
        })
      REFETCH_PAGE -> searching when (validate/required @config.searchRelation)
        (set @entity.appSearchPage ?page)
        (fetch @config.relatedEntity {
          filter: (or (= @entity.searchTerm "") (if (= @config.relatedSearchField null) false (str/includes (default (object/get @entity @config.relatedSearchField) "") @entity.searchTerm)))
          emit: { success: AppSearchRelatedLoaded, failure: AppSearchFailed }
          limit: @config.relatedMaxRows
        })
      CLEAR_SEARCH -> idle
        (set @entity.searchTerm "")
        (render-ui main {
          type: stack
          direction: vertical
          gap: md
          children: [@config.idleContent]
        })
    }

    emits {
      AppSearchLoaded
      AppSearchFailed
      AppSearchRelatedLoaded
    }

    listens {
      APP_SEARCH {
        value : string!
      }
        @description "A search query was submitted (e.g. from the AppLayout top-bar search)."
        @synonyms "query, find, lookup"
        @tier "domain"
      AppSearchFailed {
        error : string
      }
      REFETCH_PAGE {
        page : number!
      }
        @description "Loads another page of the search results."
        @synonyms "paginate, next page, change page"
        @tier "domain"
    }

    config {
      idleContent : trait = @trait.AppSearchIdleHint
        @label "Idle content"
        @description "The normal content view (e.g. the data ledger/browse trait) shown when no search is active."
        @tier "presentation"
      searchField : (field @entity string)? = name
        @label "Search field"
        @description "Entity field matched against the query (case-insensitive substring). `null` for an entity with no text column: only searchRelation can then match."
        @tier "presentation"
      pageSize : number = 20
        @label "Results per page"
        @description "Search results shown per page; every search reads the first page and the results render their own page bar."
        @synonyms "page size, results per page, page limit"
        @tier "presentation"
      relatedMaxRows : number = 500
        @label "Related rows matched per search"
        @description "Most related-entity rows one relation search may match. The search turns the matches into the ids that narrow the main read, so a partial set would hide results; a search matching more is refused through the failure event instead of showing part of it."
        @synonyms "relation search cap, related match limit, search match cap"
        @tier "policy"
      relatedEntity : entity = AppSearchTarget
        @label "Related entity"
        @description "The entity a relation search matches through: the target of searchRelation."
        @tier "presentation"
      searchRelation : (field @entity (@entity @config.relatedEntity))?
        @label "Search through relation"
        @description "A relation field of the searched entity. When set, the query matches the related rows' relatedSearchField and the results are the rows pointing at them; unset, searchField on the row itself is matched."
        @tier "presentation"
      relatedSearchField : (field (@entity @config.relatedEntity) string)?
        @label "Related search field"
        @description "Field of the related entity matched against the query when searchRelation is set."
        @tier "presentation"
      resultsTitle : string = "Search results"
        @label "Results title"
        @description "Heading shown above the search-results grid."
        @tier "presentation"
      resultFields : [AppSearchFieldSpec] = [{
        label: Name
        name: name
        variant: h4
      }]
        @label "Result columns"
        @description "Columns shown in the search-results grid; maps entity fields to display cells."
        @tier "presentation"
      resultActions : [AppSearchActionSpec] = []
        @label "Result row actions"
        @description "Optional per-row actions on a result, e.g. { label: \"View Details\", event: \"VIEW\" }."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The signed-in viewer's role that each action's `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`) in an app whose identity carries a role; left empty, only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/app-search" as AppSearchPage -> AppSearch
}
