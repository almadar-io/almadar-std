app std-version-history "1.0.0"
"std-version-history — wiki/CMS revision history with diff + rollback. Browses revisions; opens detail in `viewing_single`; compares the opened revision with the newest in `comparing`; Rollback emits RevisionRolledBack { row } for the consumer to restore onto its source document. `RevisionManage` is a rebindable single-entity trait: a consumer rebinds it to its own entity via `linkedEntity`. `config.scopeField` names the Revision field holding the parent document id; a page-mounted `{id}` route param scopes INIT's own fetch, and a consumer forwards SHOW_HISTORY { key } (via a `listens` override) to rescope the feed to one document — empty scopeField (default) or no id keeps today's unfiltered global feed. Rollback and retry refetches stay scoped."
type ItemAction = { label : string!, event : event, variant : string, icon : string, roles : [string], when : SExpr }
orbital RevisionOrbital {
    type RevisionLoaded = Event { data : [Revision] } "Fired when the revision collection finishes loading"

    type RevisionLoadFailed = Event { error : string, code : string } "Fired when the revision collection fails to load"

    type RevisionRolledBack = Event { row : Revision! } "The revision to roll back to: the consumer restores row.content onto its source document (listen for it)"

  entity Revision [persistent: revisions] {
    id : string!
    documentId : string! @description "Unique identifier for the associated document." @synonyms "reference, identifier, source"
    documentType : string! @description "Specifies the kind of document this revision belongs to." @synonyms "type, kind, category"
    versionNumber : number! @description "A sequential identifier representing the revision's order." @synonyms "sequence, order, iteration"
    authorId : string @description "Unique identifier for the user who made the change." @synonyms "user identifier, creator, contributor"
    authorName : string @description "The name of the user who made the change." @synonyms "user, contributor, owner"
    content : string @description "The snapshotted body of the revision — plain text or the rich-text HTML a document-look record carries. Rollback emits RevisionRolledBack { row }; the consumer restores row.content onto its source document." @synonyms "text, body, data, value"
    summary : string @description "A brief explanation of the revision's changes." @synonyms "description, note, comment, explanation"
    searchTerm : string @intrinsic @description "The current search query the user submitted." @synonyms "query, term, q" = ""
    createdAt : string
    scopeKey : string @intrinsic @description "The parent document id the feed is currently scoped to, set by SHOW_HISTORY. Empty when browsing the unfiltered global feed." @synonyms "scope, filter key, document scope" = ""
    revisions : [Revision] @intrinsic @description "The loaded revisions, newest first — what Compare diffs against." @synonyms "versions, history" = []
  }

  trait RevisionManage -> @rebindable Revision [interaction, collection] {
    initial: loading

    state loading {
      INIT -> loading
        (set @entity.scopeKey (str/default ?id ""))
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", (str/default ?id ""), ""] ["=", (object/get @entity @config.scopeField), ?id])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      RevisionLoaded -> browsing
        (set @entity.revisions (array/sort ?data "versionNumber" "desc"))
        (render-ui main {
          children: [{
            align: center
            children: [{ name: history, size: lg, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, {
            cols: 1
            entity: ?data
            fields: [{
              label: Version
              name: versionNumber
              variant: badge
            }, {
              label: Author
              name: authorName
              variant: caption
            }, {
              label: Summary
              name: summary
              variant: h4
            }, {
              label: Saved
              format: date
              name: createdAt
              variant: caption
            }]
            gap: sm
            itemClickEvent: @config.itemClickEvent
            itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
            look: @config.tableLook
            type: data-grid
          }]
          direction: vertical
          gap: md
          type: stack
        })
      RevisionLoadFailed -> error
        (render-ui main {
          message: ?error
          type: alert
          variant: error
        })
      SHOW_HISTORY -> loading
        (set @entity.scopeKey ?key)
        (fetch Revision {
          filter: ["=", (object/get @entity @config.scopeField), ?key]
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state browsing {
      INIT -> loading
        (set @entity.scopeKey (str/default ?id ""))
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", (str/default ?id ""), ""] ["=", (object/get @entity @config.scopeField), ?id])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      OPEN_REVISION -> viewing_single
        (set @entity.id ?row.id)
        (set @entity.documentId ?row.documentId)
        (set @entity.documentType ?row.documentType)
        (set @entity.versionNumber ?row.versionNumber)
        (set @entity.authorId ?row.authorId)
        (set @entity.authorName ?row.authorName)
        (set @entity.content ?row.content)
        (set @entity.summary ?row.summary)
        (set @entity.createdAt ?row.createdAt)
        (render-ui main {
          children: [{
            align: center
            children: [{
              action: CLOSE_VIEW
              label: Back
              type: button
              variant: ghost
            }, { name: file-text, size: lg, type: icon }, {
              content: @entity.summary
              type: typography
              variant: h3
            }, {
              label: @entity.versionNumber
              type: badge
              variant: default
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            children: [{
              children: [{
                color: muted
                content: Author
                type: typography
                variant: caption
              }, {
                content: @entity.authorName
                type: typography
                variant: body
              }]
              direction: horizontal
              gap: md
              type: stack
            }, {
              children: [{
                color: muted
                content: Saved
                type: typography
                variant: caption
              }, {
                content: @entity.createdAt
                type: typography
                variant: body
              }]
              direction: horizontal
              gap: md
              type: stack
            }, {
              children: [{
                color: muted
                content: Content
                type: typography
                variant: caption
              }, {
                content: @entity.content
                type: typography
                variant: body
              }]
              direction: horizontal
              gap: md
              type: stack
            }]
            direction: vertical
            gap: sm
            type: stack
          }, { type: divider }, {
            children: [{
              icon: tag
              label: Version
              look: @config.statLook
              type: stat-display
              value: @entity.versionNumber
            }, {
              icon: file
              label: Document
              look: @config.statLook
              type: stat-display
              ;; The captured title, never the raw foreign id — also keeps this
              ;; binding scalar when a consumer retypes documentId as a relation.
              value: (str/default @entity.summary "")
            }, {
              icon: layers
              label: Type
              look: @config.statLook
              type: stat-display
              value: @entity.documentType
            }]
            cols: 3
            type: simple-grid
          }, {
            align: center
            children: [{
              action: COMPARE
              actionPayload: { id: @entity.id }
              label: Compare
              type: button
              variant: secondary
            }, {
              action: ROLLBACK
              actionPayload: { row: @entity }
              label: Rollback
              type: button
              variant: danger
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      ROLLBACK -> loading
        (emit RevisionRolledBack { row: ?row })
        (set @entity.scopeKey (object/get ?row @config.scopeField ""))
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", (object/get ?row @config.scopeField ""), ""] ["=", (object/get @entity @config.scopeField), (object/get ?row @config.scopeField "")])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Rolling back…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SHOW_HISTORY -> loading
        (set @entity.scopeKey ?key)
        (fetch Revision {
          filter: ["=", (object/get @entity @config.scopeField), ?key]
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state viewing_single {
      CLOSE_VIEW -> loading
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", @entity.scopeKey, ""] ["=", (object/get @entity @config.scopeField), @entity.scopeKey])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      COMPARE -> comparing
        (set @entity.id ?id)
        (render-ui main {
          children: [{
            align: center
            children: [{
              action: CLOSE_VIEW
              label: Back
              type: button
              variant: ghost
            }, { name: git-compare, size: lg, type: icon }, {
              content: "Compare versions"
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            afterId: (object/get (array/first @entity.revisions) "id" "")
            beforeId: @entity.id
            revisions: (array/map @entity.revisions (fn r { id: @r.id, label: (str/concat "v" (str/default @r.versionNumber "")), author: @r.authorName, timestamp: @r.createdAt, content: @r.content }))
            type: version-diff
            view: side-by-side
          }, {
            align: center
            children: [{
              action: ROLLBACK
              actionPayload: { row: @entity }
              label: Rollback
              type: button
              variant: danger
            }]
            direction: horizontal
            gap: sm
            type: stack
          }]
          direction: vertical
          gap: md
          type: stack
        })
      ROLLBACK -> loading
        (emit RevisionRolledBack { row: ?row })
        (set @entity.scopeKey (object/get ?row @config.scopeField ""))
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", (object/get ?row @config.scopeField ""), ""] ["=", (object/get @entity @config.scopeField), (object/get ?row @config.scopeField "")])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Rolling back…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SHOW_HISTORY -> loading
        (set @entity.scopeKey ?key)
        (fetch Revision {
          filter: ["=", (object/get @entity @config.scopeField), ?key]
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state comparing {
      CLOSE_VIEW -> loading
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", @entity.scopeKey, ""] ["=", (object/get @entity @config.scopeField), @entity.scopeKey])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      ROLLBACK -> loading
        (emit RevisionRolledBack { row: ?row })
        (set @entity.scopeKey (object/get ?row @config.scopeField ""))
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", (object/get ?row @config.scopeField ""), ""] ["=", (object/get @entity @config.scopeField), (object/get ?row @config.scopeField "")])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Rolling back…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
      SHOW_HISTORY -> loading
        (set @entity.scopeKey ?key)
        (fetch Revision {
          filter: ["=", (object/get @entity @config.scopeField), ?key]
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main {
          align: center
          children: [{ type: spinner }, {
            color: muted
            content: "Loading version history…"
            type: typography
            variant: caption
          }]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state error {
      INIT -> loading
        (set @entity.scopeKey (str/default ?id ""))
        (fetch Revision {
          filter: (or ["=", @config.scopeField, ""] ["=", (str/default ?id ""), ""] ["=", (object/get @entity @config.scopeField), ?id])
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main { size: sm, type: spinner })
      SHOW_HISTORY -> loading
        (set @entity.scopeKey ?key)
        (fetch Revision {
          filter: ["=", (object/get @entity @config.scopeField), ?key]
          emit: { failure: RevisionLoadFailed, success: RevisionLoaded }
        })
        (render-ui main { size: sm, type: spinner })
    }

    emits {
      OPEN_REVISION {
        id : string!
        row : Revision
      }
        @description "Signals a revision has been selected for viewing."
        @synonyms "select, choose, display"
        @tier "domain"
      CLOSE_VIEW
        @description "Indicates the view has been closed or dismissed."
        @synonyms "dismiss, hide, close"
        @tier "domain"
      COMPARE {
        id : string!
      }
        @description "Signals a request to compare the opened revision with the newest one."
        @synonyms "compare, diff, contrast"
        @tier "presentation"
      ROLLBACK {
        row : Revision!
      }
        @description "Requests a rollback to this revision."
        @synonyms "reverted, undone, restored"
        @tier "domain"
      RevisionLoaded {
        data : [Revision]
      }
        @description "Signals a revision has been successfully retrieved and is ready."
        @synonyms "loaded, fetched, retrieved, available"
        @tier "domain"
      RevisionLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load revision data."
        @synonyms "error, fail, problem, unsuccessful"
        @tier "internal"
      RevisionRolledBack -> external {
        row : Revision!
      }
        @description "The revision to roll back to; the consumer restores row.content onto its source document."
        @synonyms "restored, reverted, undone"
        @tier "domain"
    }

    listens {
      INIT {
        id : string
      }
        @description "Optional route param delivered on mount (e.g. an :id page segment); scopes INIT's own fetch to rows whose scopeField equals id. Absent id or empty scopeField config keeps the unfiltered global feed."
        @synonyms "route id, deep link, initial scope"
        @tier "domain"
      OPEN_REVISION {
        id : string!
        row : Revision
      }
        @description "A revision has been selected for viewing."
        @synonyms "select, choose, load"
        @tier "domain"
      CLOSE_VIEW
        @description "Indicates the revision history view has been closed."
        @synonyms "dismiss, hide, cancel"
        @tier "domain"
      COMPARE {
        id : string!
      }
        @description "Indicates a request to compare the opened revision with the newest one."
        @synonyms "diff, compare, contrast"
        @tier "presentation"
      ROLLBACK {
        row : Revision!
      }
        @description "A rollback to this revision was requested."
        @synonyms "reverted, undone, restored"
        @tier "domain"
      RevisionLoaded {
        data : [Revision]
      }
        @description "Indicates a revision has been successfully retrieved and is ready."
        @synonyms "loaded, fetched, retrieved, available"
        @tier "domain"
      RevisionLoadFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to retrieve revision data."
        @synonyms "error, failure, problem, fetch failed"
        @tier "internal"
      SHOW_HISTORY {
        key : string!
      }
        @description "Requests the revision feed scoped to one parent document; stores the key and refetches filtered by config.scopeField."
        @synonyms "view history, doc history, filter revisions"
        @tier "domain"
    }

    config {
      title : string = "Version History"
        @label "Section title"
        @description "Heading shown above the revision list"
        @tier "presentation"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      statLook : "elevated" | "flat" | "progress-backed" | "gauge" | "sparkline" = elevated
        @label "Stat display look"
        @description "Layer 2 visual treatment for stat / KPI cards."
        @tier "presentation"
      scopeField : string = ""
        @label "Scope field"
        @description "Revision entity field holding the parent document's id. When set, a page-mounted {id} route param scopes INIT's fetch, and a SHOW_HISTORY { key } event rescopes the feed, to rows whose scopeField equals the id/key; rollback and retry refetches stay scoped too. Empty (default) or no id = unfiltered global feed, unchanged from prior behavior."
        @tier "domain"
      itemClickEvent : event = OPEN_REVISION
        @label "Row click"
        @description "Event emitted when a row is clicked; opens the revision. Empty disables the row click."
        @tier "presentation"
      itemActions : [ItemAction] = [{
        event: OPEN_REVISION
        icon: arrow-right
        label: Open
        variant: ghost
      }, {
        event: ROLLBACK
        icon: rotate-ccw
        label: Rollback
        variant: danger
      }]
        @label "Row actions"
        @description "Actions offered on each row; give an item `roles` to show it only to those viewer roles."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The signed-in viewer's role that each action's `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`) in an app whose identity carries a role; left empty, only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/revisions/manage" as RevisionManagePage -> RevisionManage
}