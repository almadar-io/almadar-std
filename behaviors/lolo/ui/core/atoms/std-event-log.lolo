app std-event-log [
  version: "2.1.0",
  description: "std-event-log — generic chronological event feed (Stripe activity log / GitHub PR timeline / Linear event feed style). Renders a vertical `timeline` with type-coded dots, a single horizontal chip-bar of kind filters (All + per-kind), reverse-chronological sort, and an inline form for logging events that weren't auto-captured. `config.kindOptions` maps each kind → status/icon/label so consuming molecules/organisms get type-coded visuals without re-implementing topology. Topology = loading / viewing / backfilling / error."
]
type ObjectSpec = { id : string, label : string, value : string }
type FilterSpec = { field : string!, label : string, options : [string] }
type EventLogRelatedRow = { id : string! }
orbital EventLogOrbital {
    type EventLogEntry = { id : string!, title : string!, description : string, date : string, status : "complete" | "active" | "pending" | "error", kind : "created" | "updated" | "approved" | "rejected" }

    type KindOption = { key : string!, label : string!, icon : string, status : "complete" | "active" | "pending" | "error" }

    type FilterChip = { id : string!, label : string!, icon : string }

    type EventLogLoaded = Event { data : [ObjectSpec]!, totalCount : number } "Fired when one page of event entries finishes loading"

    type EventLogLoadFailed = Event { error : string, code : string } "Fired when fetch fails"

    type EventLogRelatedLoaded = Event { data : [EventLogRelatedRow]!, totalCount : number! } "Related rows whose text matches the query loaded"

    type EventLogSaved = Event @entity "Fired when an entry has been persisted"

    type EventLogSaveFailed = Event { error : string, code : string } "Fired when persist fails"

  entity EventLogView [runtime] {
    id : string!
    title : string @description "The descriptive name or heading for the event log." @synonyms "heading, label, name" = ""
    description : string @description "A human-readable explanation of the event." @synonyms "text, details, explanation, summary" = ""
    kind : "created" | "updated" | "approved" | "rejected" @description "The type of event being logged." @synonyms "event type, event category, kind, status" = created
    date : date @description "The timestamp associated with the event." @synonyms "timestamp, time, occurred"
    allEntries : [EventLogEntry] @description "An array of log entry objects." @synonyms "entries, records, items, data" = []
    entries : [EventLogEntry] @description "A list of log entries, each with associated data." @synonyms "records, items, data, events" = []
    filterChips : [FilterChip] @description "Represents selectable filter options for event categories." @synonyms "filters, categories, types, selections" = []
    filterKind : string @description "The type of filter currently applied to the event log." @synonyms "filter, category, type" = ""
    backfillTitle : string @description "A descriptive title for a manually added event." @synonyms "manual title, user-provided title, custom title" = ""
    backfillDescription : string @description "A textual explanation for the event backfill process." @synonyms "explanation, details, notes, information" = ""
    backfillDate : date @description "The date and time when the event was manually added." @synonyms "timestamp, entered date, manual date"
    backfillKind : string @description "Specifies the category or type of the manually added event." @synonyms "event type, category, kind" = ""
    errorMessage : string @description "A human-readable message indicating an error condition." @synonyms "error, error message, problem, issue" = ""
    eventLogPage : number @intrinsic @description "The page the log shows." = 1
    eventLogTotalCount : number @intrinsic @description "Entries the log's filter matches, across every page." = 0
    eventLogSearchTerm : string @intrinsic @description "The search query the log applies to every page." = ""
    eventLogFilterField : string @intrinsic @description "The field the log's extra filter matches." = ""
    eventLogFilterValue : string @intrinsic @description "The value the log's extra filter matches; empty means no extra filter." = ""
  }

  trait EventLogTimeline -> @rebindable EventLogView {
    initial: loading

    state loading {
      INIT -> loading
        (set @entity.eventLogPage 1)
        (set @entity.eventLogSearchTerm "")
        (set @entity.eventLogFilterField "")
        (set @entity.eventLogFilterValue "")
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: list, rows: 6 }]
        })
      EventLogLoaded -> viewing
        (set @entity.eventLogTotalCount ?totalCount)
        (set @entity.filterChips (array/prepend (array/map @config.kindOptions (fn k {
          icon: (object/get @k icon circle)
          id: (object/get @k key)
          label: (object/get @k label)
        })) {
          icon: list
          id: ""
          label: All
        }))
        (set @entity.allEntries (array/sort (array/map ?data (fn row {
          date: (object/get @row createdAt (object/get @row date ""))
          description: (object/get @row description "")
          id: (object/get @row id "")
          kind: (object/get @row kind "")
          status: (object/get (or (array/find @config.kindOptions (fn k (= (object/get @k key) (object/get @row kind "")))) {}) status pending)
          title: (object/get @row title "")
        })) date desc))
        (set @entity.entries (array/sort (array/map ?data (fn row {
          date: (object/get @row createdAt (object/get @row date ""))
          description: (object/get @row description "")
          id: (object/get @row id "")
          kind: (object/get @row kind "")
          status: (object/get (or (array/find @config.kindOptions (fn k (= (object/get @k key) (object/get @row kind "")))) {}) status pending)
          title: (object/get @row title "")
        })) date desc))
        (render-ui main {
          children: [{
            align: center
            children: [{ name: history, size: lg, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }, {
              action: OPEN_BACKFILL
              icon: plus
              label: "Log event"
              type: button
              variant: primary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if (> (array/len @config.filters) 0) {
            children: [{
              entity: EventLogView
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), {
            activeTab: @entity.filterKind
            tabChangeEvent: APPLY_FILTER
            tabs: (array/map @entity.filterChips (fn chip { id: (object/get @chip id ""), icon: (object/get @chip icon list), label: (if (= @index 0) @config.allLabel (if (= (array/len @config.kindLabels) 0) (object/get @chip label "") (array/nth @config.kindLabels (- @index 1)))) }))
            type: tabs
          }, {
            color: muted
            content: (str/concat ?totalCount " entries")
            type: typography
            variant: caption
          }, {
            entity: @entity.entries
            fields: (title description date status)
            titleField: @config.titleField
            descriptionField: @config.descriptionField
            dateField: @config.dateField
            statusField: @config.statusField
            look: @config.timelineLook
            type: timeline
          }, {
            currentPage: @entity.eventLogPage
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
            totalPages: (math/max 1 (math/ceil (/ ?totalCount @config.pageSize)))
            type: pagination
          }]
          direction: vertical
          gap: md
          type: stack
        })
      EventLogLoadFailed -> error
        (set @entity.errorMessage ?error)
        (render-ui main {
          message: @entity.errorMessage
          title: "Failed to load"
          type: error-state
        })
      EventLogSaved -> loading
        (set @entity.eventLogPage 1)
        (set @entity.eventLogSearchTerm "")
        (set @entity.eventLogFilterField "")
        (set @entity.eventLogFilterValue "")
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: list, rows: 6 }]
        })
      EventLogSaveFailed -> error
        (set @entity.errorMessage ?error)
        (render-ui main {
          message: @entity.errorMessage
          title: "Save failed"
          type: error-state
        })
    }

    state viewing {
      ;; revisit re-entry: re-fetch in place, no render — keeps the rendered
      ;; timeline on screen instead of flashing the loading skeleton over it.
      INIT -> loading
        (set @entity.eventLogPage 1)
        (set @entity.eventLogSearchTerm "")
        (set @entity.eventLogFilterField "")
        (set @entity.eventLogFilterValue "")
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
      APPLY_FILTER -> viewing when (or (= @config.searchRelation null) (= @entity.eventLogSearchTerm ""))
        (set @entity.filterKind ?tabId)
        (set @entity.eventLogPage 1)
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (and (or (= ?tabId "") (= (object/get @entity @config.kindField) ?tabId)) (or (= @entity.eventLogSearchTerm "") (str/includes (object/get @entity @config.searchField) @entity.eventLogSearchTerm)) (or (= @entity.eventLogFilterValue "") (= (object/get @entity @entity.eventLogFilterField) @entity.eventLogFilterValue)))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
      APPLY_FILTER -> viewing when (and (!= @config.searchRelation null) (!= @entity.eventLogSearchTerm ""))
        (set @entity.filterKind ?tabId)
        (set @entity.eventLogPage 1)
        (fetch @config.relatedEntity {
          emit: { failure: EventLogLoadFailed, success: EventLogRelatedLoaded }
          filter: (str/includes (object/get @entity @config.relatedSearchField) @entity.eventLogSearchTerm)
          limit: @config.relatedMaxRows
        })
      ;; REFETCH_* stays in `viewing` and DOES NOT replace the timeline with a
      ;; skeleton — same reasoning as std-browse's REFETCH_* arms: a skeleton
      ;; on refetch unmounts the timeline and flickers every keystroke. The
      ;; fetch fires in the background; the EventLogLoaded arm below re-renders
      ;; in place once it lands. Each refetch also honours the current kind
      ;; tab (@entity.filterKind) so search/generic-filter compound with it
      ;; instead of resetting it.
      REFETCH_QUERY -> viewing when (or (= @config.searchRelation null) (= ?searchTerm ""))
        (set @entity.eventLogSearchTerm ?searchTerm)
        (set @entity.eventLogPage 1)
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (and (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind)) (or (= ?searchTerm "") (str/includes (object/get @entity @config.searchField) ?searchTerm)) (or (= @entity.eventLogFilterValue "") (= (object/get @entity @entity.eventLogFilterField) @entity.eventLogFilterValue)))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
      REFETCH_QUERY -> viewing when (and (!= @config.searchRelation null) (!= ?searchTerm ""))
        (set @entity.eventLogSearchTerm ?searchTerm)
        (set @entity.eventLogPage 1)
        (fetch @config.relatedEntity {
          emit: { failure: EventLogLoadFailed, success: EventLogRelatedLoaded }
          filter: (str/includes (object/get @entity @config.relatedSearchField) ?searchTerm)
          limit: @config.relatedMaxRows
        })
      EventLogRelatedLoaded -> viewing when (> ?totalCount (array/len ?data))
        (emit EventLogLoadFailed { error: (str/concat @config.relatedEntity " has " ?totalCount " rows matching the search, over the relatedMaxRows cap of " @config.relatedMaxRows), code: "EVENT_LOG_RELATED_OVER_CAP" })
      EventLogRelatedLoaded -> viewing
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (and (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind)) (array/includes (array/map ?data (fn r (object/get @r id))) (object/get @entity @config.searchRelation)) (or (= @entity.eventLogFilterValue "") (= (object/get @entity @entity.eventLogFilterField) @entity.eventLogFilterValue)))
          limit: @config.pageSize
          offset: (* (- @entity.eventLogPage 1) @config.pageSize)
          orderBy: (str/concat @config.dateField ":desc")
        })
      REFETCH_FILTER -> viewing when (or (= @config.searchRelation null) (= @entity.eventLogSearchTerm ""))
        (set @entity.eventLogFilterField ?field)
        (set @entity.eventLogFilterValue ?value)
        (set @entity.eventLogPage 1)
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (and (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind)) (or (= @entity.eventLogSearchTerm "") (str/includes (object/get @entity @config.searchField) @entity.eventLogSearchTerm)) (or (= ?value "") (= (object/get @entity ?field) ?value)))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
      REFETCH_FILTER -> viewing when (and (!= @config.searchRelation null) (!= @entity.eventLogSearchTerm ""))
        (set @entity.eventLogFilterField ?field)
        (set @entity.eventLogFilterValue ?value)
        (set @entity.eventLogPage 1)
        (fetch @config.relatedEntity {
          emit: { failure: EventLogLoadFailed, success: EventLogRelatedLoaded }
          filter: (str/includes (object/get @entity @config.relatedSearchField) @entity.eventLogSearchTerm)
          limit: @config.relatedMaxRows
        })
      REFETCH_PAGE -> viewing when (or (= @config.searchRelation null) (= @entity.eventLogSearchTerm ""))
        (set @entity.eventLogPage ?page)
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (and (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind)) (or (= @entity.eventLogSearchTerm "") (str/includes (object/get @entity @config.searchField) @entity.eventLogSearchTerm)) (or (= @entity.eventLogFilterValue "") (= (object/get @entity @entity.eventLogFilterField) @entity.eventLogFilterValue)))
          limit: @config.pageSize
          offset: (* (- ?page 1) @config.pageSize)
          orderBy: (str/concat @config.dateField ":desc")
        })
      REFETCH_PAGE -> viewing when (and (!= @config.searchRelation null) (!= @entity.eventLogSearchTerm ""))
        (set @entity.eventLogPage ?page)
        (fetch @config.relatedEntity {
          emit: { failure: EventLogLoadFailed, success: EventLogRelatedLoaded }
          filter: (str/includes (object/get @entity @config.relatedSearchField) @entity.eventLogSearchTerm)
          limit: @config.relatedMaxRows
        })
      EventLogLoadFailed -> viewing
        (notify error (str/concat "Couldn't refresh the event log — " ?error))
      EventLogLoaded -> viewing
        (set @entity.eventLogTotalCount ?totalCount)
        (set @entity.filterChips (array/prepend (array/map @config.kindOptions (fn k {
          icon: (object/get @k icon circle)
          id: (object/get @k key)
          label: (object/get @k label)
        })) {
          icon: list
          id: ""
          label: All
        }))
        (set @entity.allEntries (array/sort (array/map ?data (fn row {
          date: (object/get @row createdAt (object/get @row date ""))
          description: (object/get @row description "")
          id: (object/get @row id "")
          kind: (object/get @row kind "")
          status: (object/get (or (array/find @config.kindOptions (fn k (= (object/get @k key) (object/get @row kind "")))) {}) status pending)
          title: (object/get @row title "")
        })) date desc))
        (set @entity.entries (array/sort (array/map ?data (fn row {
          date: (object/get @row createdAt (object/get @row date ""))
          description: (object/get @row description "")
          id: (object/get @row id "")
          kind: (object/get @row kind "")
          status: (object/get (or (array/find @config.kindOptions (fn k (= (object/get @k key) (object/get @row kind "")))) {}) status pending)
          title: (object/get @row title "")
        })) date desc))
        (render-ui main {
          children: [{
            align: center
            children: [{ name: history, size: lg, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }, {
              action: OPEN_BACKFILL
              icon: plus
              label: "Log event"
              type: button
              variant: primary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if (> (array/len @config.filters) 0) {
            children: [{
              entity: EventLogView
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), {
            activeTab: @entity.filterKind
            tabChangeEvent: APPLY_FILTER
            tabs: (array/map @entity.filterChips (fn chip { id: (object/get @chip id ""), icon: (object/get @chip icon list), label: (if (= @index 0) @config.allLabel (if (= (array/len @config.kindLabels) 0) (object/get @chip label "") (array/nth @config.kindLabels (- @index 1)))) }))
            type: tabs
          }, {
            color: muted
            content: (str/concat ?totalCount " entries")
            type: typography
            variant: caption
          }, {
            entity: @entity.entries
            fields: (title description date status)
            titleField: @config.titleField
            descriptionField: @config.descriptionField
            dateField: @config.dateField
            statusField: @config.statusField
            look: @config.timelineLook
            type: timeline
          }, {
            currentPage: @entity.eventLogPage
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
            totalPages: (math/max 1 (math/ceil (/ ?totalCount @config.pageSize)))
            type: pagination
          }]
          direction: vertical
          gap: md
          type: stack
        })
      OPEN_BACKFILL -> backfilling
        (set @entity.backfillTitle "")
        (set @entity.backfillDescription "")
        (set @entity.backfillDate "")
        (set @entity.backfillKind "")
        (render-ui main {
          children: [{
            align: center
            children: [{
              action: CANCEL_BACKFILL
              icon: arrow-left
              label: Back
              type: button
              variant: ghost
            }, { name: plus-circle, size: lg, type: icon }, {
              content: "Log event"
              type: typography
              variant: h3
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, { type: divider }, {
            children: [{
              cancelEvent: CANCEL_BACKFILL
              entity: @entity
              fields: @config.formFields
              mode: create
              submitEvent: SAVE_BACKFILL
              type: form-section
            }]
            look: @config.cardLook
            type: card
          }]
          direction: vertical
          gap: md
          type: stack
        })
    }

    state backfilling {
      INIT -> loading
        (set @entity.eventLogPage 1)
        (set @entity.eventLogSearchTerm "")
        (set @entity.eventLogFilterField "")
        (set @entity.eventLogFilterValue "")
        (fetch EventLogView {
          emit: { failure: EventLogLoadFailed, success: EventLogLoaded }
          filter: (or (= @entity.filterKind "") (= (object/get @entity @config.kindField) @entity.filterKind))
          limit: @config.pageSize
          offset: 0
          orderBy: (str/concat @config.dateField ":desc")
        })
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: list, rows: 6 }]
        })
      SAVE_BACKFILL -> loading
        (persist create EventLogView ?data {
          emit: { failure: EventLogSaveFailed, success: EventLogSaved }
        })
      CANCEL_BACKFILL -> viewing
        (render-ui main {
          children: [{
            align: center
            children: [{ name: history, size: lg, type: icon }, {
              content: @config.title
              type: typography
              variant: h3
            }, {
              action: OPEN_BACKFILL
              icon: plus
              label: "Log event"
              type: button
              variant: primary
            }]
            direction: horizontal
            gap: sm
            type: stack
          }, (if @config.bodySearch {
            children: [{
              className: "w-full max-w-md"
              clearable: true
              event: REFETCH_QUERY
              placeholder: @config.searchPlaceholder
              type: search-input
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), (if (> (array/len @config.filters) 0) {
            children: [{
              entity: EventLogView
              event: REFETCH_FILTER
              filters: @config.filters
              look: @config.filterBarLook
              type: filter-group
            }]
            direction: horizontal
            gap: sm
            type: stack
          } {
            children: []
            gap: none
            type: stack
          }), {
            activeTab: @entity.filterKind
            tabChangeEvent: APPLY_FILTER
            tabs: (array/map @entity.filterChips (fn chip { id: (object/get @chip id ""), icon: (object/get @chip icon list), label: (if (= @index 0) @config.allLabel (if (= (array/len @config.kindLabels) 0) (object/get @chip label "") (array/nth @config.kindLabels (- @index 1)))) }))
            type: tabs
          }, {
            color: muted
            content: (str/concat @entity.eventLogTotalCount " entries")
            type: typography
            variant: caption
          }, {
            entity: @entity.entries
            fields: (title description date status)
            titleField: @config.titleField
            descriptionField: @config.descriptionField
            dateField: @config.dateField
            statusField: @config.statusField
            look: @config.timelineLook
            type: timeline
          }, {
            currentPage: @entity.eventLogPage
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
            totalPages: (math/max 1 (math/ceil (/ @entity.eventLogTotalCount @config.pageSize)))
            type: pagination
          }]
          direction: vertical
          gap: md
          type: stack
        })
    }

    state error {
      INIT -> loading
        (render-ui main {
          type: stack
          direction: vertical
          gap: lg
          children: [{ type: skeleton, variant: header }, { type: skeleton, variant: list, rows: 6 }]
        })
    }

    emits {
      EventLogRelatedLoaded
        @description "Signals that the related rows matching the search query have loaded."
        @synonyms "related loaded, relation matched"
        @tier "internal"
      APPLY_FILTER {
        tabId : string
      }
        @description "Signals a filter has been applied to the event log."
        @synonyms "filter, refine, narrow, update"
        @tier "presentation"
      OPEN_BACKFILL
        @description "Initiates a backfill operation to retrieve historical events."
        @synonyms "refresh, retrieve, load history"
        @tier "internal"
      SAVE_BACKFILL {
        data : @entity!
      }
        @description "Indicates successful completion of backfill data saving."
        @synonyms "saved, persisted, committed"
        @tier "presentation"
      CANCEL_BACKFILL
        @description "Aborts the backfill process."
        @synonyms "abort, stop, dismiss, undo"
        @tier "presentation"
      EventLogLoaded {
        data : [ObjectSpec]!
        totalCount : number
      }
        @description "Signals the event log has finished loading."
        @synonyms "loaded, ready, initialized"
        @tier "internal"
      EventLogLoadFailed {
        error : string
        code : string
      }
        @description "Indicates that loading the event log failed."
        @synonyms "error, failure, failed, problem"
        @tier "internal"
      EventLogSaved
        @description "Indicates a new event has been successfully logged."
        @synonyms "saved, added, created, recorded"
        @tier "domain"
      EventLogSaveFailed {
        error : string
        code : string
      }
        @description "Indicates that saving an event failed."
        @synonyms "error, failure, failed, problem"
        @tier "internal"
    }

    listens {
      APPLY_FILTER {
        tabId : string
      }
        @description "Signals a filter has been applied to the event feed."
        @synonyms "filter, refine, change view"
        @tier "presentation"
      OPEN_BACKFILL
        @description "Initiates a backfill operation to retrieve historical events."
        @synonyms "fetch history, retrieve data, load past"
        @tier "internal"
      SAVE_BACKFILL {
        data : @entity!
      }
        @description "Indicates a backfill operation has been successfully saved."
        @synonyms "saved, persisted, completed"
        @tier "presentation"
      CANCEL_BACKFILL
        @description "Aborts an in-progress backfill operation."
        @synonyms "abort, stop, dismiss, undo"
        @tier "presentation"
      EventLogLoaded {
        data : [ObjectSpec]!
        totalCount : number
      }
        @description "Signals the event log has finished loading."
        @synonyms "loaded, ready, initialized"
        @tier "internal"
      EventLogLoadFailed {
        error : string
        code : string
      }
        @description "Indicates the event log failed to load."
        @synonyms "error, failure, failed, loading error"
        @tier "internal"
      EventLogSaved
        @description "Indicates a new event has been successfully recorded."
        @synonyms "saved, added, created, persisted"
        @tier "domain"
      EventLogSaveFailed {
        error : string
        code : string
      }
        @description "Indicates an attempt to save an event failed."
        @synonyms "error, failure, save failed"
        @tier "internal"
      REFETCH_QUERY {
        searchTerm : string!
      }
        @description "Triggers an activity feed refresh based on the current search term."
        @synonyms "refresh, reload, update, re-query, search"
        @tier "domain"
      REFETCH_FILTER {
        entity : string!
        field : string!
        value : string!
        query : string
      }
        @description "Triggers an activity feed refresh based on a field/value filter, in addition to the built-in kind tabs."
        @synonyms "refresh, filter, update, reload"
        @tier "domain"
      REFETCH_PAGE {
        page : number!
      }
        @description "Triggers an activity feed page refresh."
        @synonyms "reload, refresh, update, paginate"
        @tier "domain"
    }

    config {
      title : string = Activity
        @label "Section title"
        @description "Heading shown above the activity timeline"
        @tier "presentation"
      searchField : field @entity string = title
        @label "Which column does the search box match against?"
        @description "Name the field on this entity the search box's str/includes filter matches against. Declared, never inferred: an entity with no `title` column must set this to a real field or the search box can never match an entry."
        @synonyms "search column, search on field, match field, search key"
        @tier "policy"
      relatedMaxRows : number = 500
        @label "Related rows matched per search"
        @description "Most related-entity rows one relation search may match. The search turns the matches into the ids that narrow the main read, so a partial set would hide results; a search matching more is refused through the failure event instead of showing part of it."
        @synonyms "relation search cap, related match limit, search match cap"
        @tier "policy"
      relatedEntity : entity = EventLogView
        @label "Related entity"
        @description "The entity a relation search matches through: the target of searchRelation."
        @tier "presentation"
      searchRelation : (field @entity (@entity @config.relatedEntity))?
        @label "Search through relation"
        @description "A relation field of the searched entity. When set, the query matches the related rows' relatedSearchField and the results are the rows pointing at them; unset, searchField on the row itself is matched."
        @tier "presentation"
      relatedSearchField : (field (@entity @config.relatedEntity) string)?
        @label "Related search field"
        @description "Field of the related entity matched against the query when searchRelation is set."
        @tier "presentation"
      kindField : field @entity string = kind
        @label "Which column holds each entry's kind?"
        @description "Name the field on this entity the kind filter compares against (the values of kindOptions). An entity whose kind lives under another column (e.g. status) sets it here, or the kind filter can never match an entry."
        @synonyms "kind column, type field, category column, filter by kind"
        @tier "policy"
      kindLabels : [string] = []
        @label "Kind labels"
        @description "In kindOptions order: the label shown on each kind's filter chip, in place of its kindOptions label (render-only, so it may be translated)"
        @tier "presentation"
      allLabel : string = "All"
        @label "All label"
        @description "Label of the chip that shows every kind"
        @tier "presentation"
      kindOptions : [KindOption] = [{
        icon: plus-circle
        key: created
        label: Created
        status: active
      }, {
        icon: edit-3
        key: updated
        label: Updated
        status: pending
      }, {
        icon: check-circle
        key: approved
        label: Approved
        status: complete
      }, {
        icon: x-circle
        key: rejected
        label: Rejected
        status: error
      }]
        @label "Event kinds"
        @description "Maps each event kind to its label, icon, and status color"
        @tier "presentation"
      formFields : [field @entity] = (backfillTitle backfillDescription backfillKind backfillDate)
        @label "Backfill fields"
        @description "Inputs shown in the form for manually logging missed events"
        @tier "presentation"
      cardLook : "elevated" | "flat-bordered" | "borderless-divider" | "ticket" | "invoice" | "chip" | "tile-image-first" = elevated
        @label "Card look"
        @description "Layer 2 visual treatment for cards rendered by this atom."
        @tier "presentation"
      titleField : field @entity string = title
        @label "Title field"
        @description "Entity field holding each event's title."
        @tier "presentation"
      descriptionField : field @entity string = description
        @label "Description field"
        @description "Entity field holding each event's description."
        @tier "presentation"
      dateField : field @entity = date
        @label "Date field"
        @description "Entity field holding each event's date."
        @tier "presentation"
      statusField : field @entity string
        @label "Status field"
        @description "Entity field holding each event's status (complete | active | pending | error). Unset = events carry no status."
        @tier "presentation"
      timelineLook : "vertical-compact" | "vertical-spacious" | "horizontal" | "swimlane" = vertical-spacious
        @label "Timeline look"
        @description "Layer 2 visual treatment for the timeline."
        @tier "presentation"
      bodySearch : boolean = false
        @label "Show the log's own search box?"
        @description "Embeds a search box above the activity feed. Set true only when the page has no other search affordance (e.g. no page-level std-search), so the surface shows one search box instead of two. False is the default — no consumer of this atom has ever had a search box."
        @synonyms "inline search, log search, built-in search, show search"
        @tier "presentation"
      searchPlaceholder : string = "Search activity…"
        @label "Search box placeholder text"
        @description "Hint text inside the log's search box."
        @synonyms "search hint, placeholder, search box text"
        @tier "presentation"
      filters : [FilterSpec] = []
        @label "Which filters should appear above the feed?"
        @description "Dropdown filter facets by field, rendered as an embedded filter bar above the timeline; each selection fires REFETCH_FILTER on this trait, ANDed with the current kind tab. Empty (the default) = no filter bar — the right setting whenever the page already composes std-filter beside this atom and routes XFilter.FILTER -> REFETCH_FILTER, or relies solely on the built-in kind-filter chips (driven by kindOptions, which this knob does not duplicate or replace). Use this knob only for an extra facet beyond kind (e.g. actor, priority)."
        @synonyms "filter bar, faceted filters, field filters, dropdowns"
        @tier "presentation"
      filterBarLook : "toolbar" | "chips" | "pills" | "popover-trigger" | "inline-column-header" = toolbar
        @label "Filter bar look"
        @description "Visual treatment for the embedded filter bar, mirroring std-filter's own enum. Only applies when `filters` is non-empty."
        @synonyms "filter bar style, facet style, chips, pills"
        @tier "presentation"
      pageSize : number = 20
        @label "How many entries per page?"
        @description "Entries shown per page, newest first. Every load, search and filter refetch reads the first page; the log renders its own page bar."
        @synonyms "fetch limit, records per page, page limit"
        @tier "presentation"
    }
  }

  page "/event-log" as EventLogPage -> EventLogTimeline
}