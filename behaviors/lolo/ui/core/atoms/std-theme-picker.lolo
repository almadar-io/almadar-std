app std-theme-picker [
  version: "1.0.0",
  kv: { themes: [read, write] },
  description: "std-theme-picker — the viewer's theme switcher: a select listing the themes the app offers, the one in effect selected. Picking one runs theme/set where the pick happens, in the viewer's browser, so @currentTheme of every orbital, an orbital's own theme included, becomes that key and the whole app repaints at once; the empty entry (the default label) runs theme/clear and the declared themes apply again. A key the program does not declare (the app's theme, an orbital's theme or the app's themes list) is refused with undeclared-theme and the reason is shown under the select. The kernel holds the pick for the viewer's session. With keep on, it is also kept in the bound ThemePick entity, one row per viewer (id the viewer's @user.id), and bound again when the picker mounts; an importing orbital that wants it kept beyond the session turns keep on and retags the entity, for example [persistent: theme_picks]. Compose ThemePicker once per page, in the slot where the select belongs."
]
type ThemeChoiceOption = { value : string!, label : string! }
orbital ThemePickerOrbital {
  entity ThemePick [runtime] {
    id : string! @description "The viewer the pick belongs to: their @user.id."
    theme : string @description "The theme key the viewer picked; empty for the declared themes." = ""
    current : string @description "The theme key in effect for the viewer, as the select shows it." = ""
    problem : string @description "Why the last pick was refused; empty when it was not." = ""
  }

  trait ThemePicker -> @rebindable ThemePick {
    initial: idle

    state idle {
      INIT -> idle when @config.keep
        (set @entity.current @currentTheme)
        (render-ui @config.slot @config.pickerContent)
        (fetch ThemePick { filter: { id: @user.id }, limit: 1, emit: { success: PICKS_READ, failure: PICKS_UNREAD } })
      INIT -> idle when (not @config.keep)
        (set @entity.current @currentTheme)
        (render-ui @config.slot @config.pickerContent)
      PICKS_READ -> idle
        (let ((kept (object/get (default (array/find ?data (fn r (== @r.id @user.id))) { id: "", theme: "" }) theme "")))
          (when (!= @kept "") (theme/set @kept { emit: { success: THEME_BOUND, failure: THEME_REFUSED } })))
      PICKS_UNREAD -> idle
        (set @entity.problem (default ?error "the kept theme could not be read"))
        (render-ui @config.slot @config.pickerContent)
      THEME_PICKED -> idle when (!= ?value "")
        (theme/set ?value { emit: { success: THEME_BOUND, failure: THEME_REFUSED } })
      THEME_PICKED -> idle when (== ?value "")
        (theme/clear { emit: { success: THEME_CLEARED, failure: THEME_REFUSED } })
      THEME_BOUND -> idle
        (set @entity.current ?theme)
        (set @entity.problem "")
        (render-ui @config.slot @config.pickerContent)
        (when @config.keep (persist upsert ThemePick { id: @user.id, theme: ?theme } { emit: { success: PICK_KEPT, failure: PICK_UNKEPT } }))
        (emit THEME_CHOSEN { theme: ?theme })
      THEME_CLEARED -> idle
        (set @entity.current ?theme)
        (set @entity.problem "")
        (render-ui @config.slot @config.pickerContent)
        (when @config.keep (persist upsert ThemePick { id: @user.id, theme: "" } { emit: { success: PICK_KEPT, failure: PICK_UNKEPT } }))
        (emit THEME_CHOSEN { theme: "" })
      THEME_REFUSED -> idle
        (set @entity.problem (str/concat ?kind ": " ?error))
        (render-ui @config.slot @config.pickerContent)
      PICK_KEPT -> idle
      PICK_UNKEPT -> idle
        (set @entity.problem (default ?error "the pick could not be kept"))
        (render-ui @config.slot @config.pickerContent)
    }

    emits {
      THEME_CHOSEN -> external { theme : string! }
        @description "The viewer chose a theme key, or the empty key for the declared themes; ThemeLocal keeps it in the browser."
        @tier "secondary"
    }

    listens {
      THEME_PICKED { value : string! }
        @description "The viewer chose a theme key from the select; empty returns to the declared themes."
      PICKS_READ { data : [ThemePick]!, totalCount : number }
        @description "The kept picks were read."
      PICKS_UNREAD { error : string, code : string }
        @description "The kept picks could not be read."
      THEME_BOUND { theme : string! }
        @description "theme/set bound the key to the viewer's session."
      THEME_CLEARED { theme : string! }
        @description "theme/clear returned the session to its declared themes; theme is the one now in effect."
      THEME_REFUSED { error : string!, kind : string! }
        @description "theme/set or theme/clear refused, for example undeclared-theme."
      PICK_KEPT { id : string }
        @description "The pick was kept in ThemePick."
      PICK_UNKEPT { error : string, code : string }
        @description "The pick could not be kept."
    }

    config {
      keep : boolean = false
        @label "Keep the pick"
        @description "Off: the pick lasts as long as the viewer's session, held by the kernel. On: the pick is also kept in the bound ThemePick entity and bound again when the picker mounts; retag the entity (for example [persistent: theme_picks], one table for every page) to keep it beyond the session."
        @synonyms "remember theme, persist theme, save appearance"
        @tier "presentation"
      slot : slot = main
        @label "Slot"
        @description "Where the select renders; a page-level slot such as hud-top shows it on every page that composes the picker."
        @tier "presentation"
      themes : [ThemeChoiceOption] = []
        @label "Themes"
        @description "The themes the viewer may pick, each a registry key (value) and its label. Each key must be in the app's themes list, or be the app's or an orbital's theme, so its stylesheet ships."
        @synonyms "skins, color schemes, appearance options, theme list"
        @tier "presentation"
      label : string = "Theme"
        @label "Label"
        @description "The select's visible label."
        @tier "presentation"
      defaultLabel : string = "Default"
        @label "Default entry"
        @description "The label of the empty entry that returns to the declared themes."
        @tier "presentation"
      pickerContent : render-ui = {
        type: stack
        direction: vertical
        gap: xs
        children: [
          {
            type: select
            label: @config.label
            options: (array/concat [{ value: "", label: @config.defaultLabel }] @config.themes)
            value: @entity.current
            action: THEME_PICKED
          },
          { type: typography, variant: caption, color: error, className: (if (== @entity.problem "") hidden ""), content: @entity.problem }
        ]
      }
        @label "Picker body"
        @tier "internal"
    }
  }


  trait ThemeRestore -> @rebindable ThemePick {
    @description "Binds the viewer's kept pick when a page mounts and draws nothing. Compose it on every page of an app whose ThemePicker keeps picks (keep on, the same entity retagged), so the kept theme applies wherever the viewer lands, not only on the page that shows the select."
    initial: idle

    state idle {
      INIT -> idle
        (fetch ThemePick { filter: { id: @user.id }, limit: 1, emit: { success: RESTORE_READ, failure: RESTORE_UNREAD } })
      RESTORE_READ -> idle
        (let ((kept (object/get (default (array/find ?data (fn r (== @r.id @user.id))) { id: "", theme: "" }) theme "")))
          (when (and (!= @kept "") (!= @kept @currentTheme)) (theme/set @kept { emit: { success: RESTORE_BOUND, failure: RESTORE_REFUSED } })))
      RESTORE_UNREAD -> idle
        (emit THEME_RESTORE_FAILED { error: (default ?error "the kept theme could not be read") })
      RESTORE_BOUND -> idle
        (emit THEME_CHOSEN { theme: ?theme })
      RESTORE_REFUSED -> idle
        (emit THEME_RESTORE_FAILED { error: (str/concat ?kind ": " ?error) })
    }

    emits {
      THEME_CHOSEN -> external { theme : string! }
        @description "The kept pick was bound; ThemeLocal keeps it in the browser."
        @tier "secondary"
      THEME_RESTORE_FAILED -> external { error : string! }
        @description "The kept theme could not be read or bound; the declared themes stay. An app may show it."
        @tier "secondary"
    }

    listens {
      RESTORE_READ { data : [ThemePick]!, totalCount : number }
        @description "The viewer's kept pick was read."
      RESTORE_UNREAD { error : string, code : string }
        @description "The kept pick could not be read; the declared themes stay."
      RESTORE_BOUND { theme : string! }
        @description "theme/set bound the kept key to the viewer's session."
      RESTORE_REFUSED { error : string!, kind : string! }
        @description "theme/set refused the kept key, for example a theme the app no longer declares; the declared themes stay."
    }
  }


  entity ThemeLocalRun [runtime] {
    id : string!
  }

  trait ThemeLocal -> @rebindable ThemeLocalRun [client] {
    @description "Keeps the viewer's theme in the browser (kv, IndexedDB) and binds it as soon as a page mounts, before any server read, so the page does not paint the declared theme first. Every choice the picker makes and every pick ThemeRestore binds from the server is kept again, so the server's copy still wins across devices. The key is one per browser and app locale."
    initial: idle

    state idle {
      INIT -> idle
        (kv/get @config.store "theme" { key: "theme", emit: { success: LOCAL_READ, failure: LOCAL_UNREAD } })
      LOCAL_READ -> idle when (and ?found (validate/string ?value) (!= ?value ""))
        (when (!= ?value @currentTheme) (theme/set ?value { emit: { success: LOCAL_BOUND, failure: LOCAL_REFUSED } }))
      LOCAL_READ -> idle when (not (and ?found (validate/string ?value) (!= ?value "")))
      LOCAL_UNREAD -> idle
        (emit THEME_RESTORE_FAILED { error: (str/concat "the browser's kept theme could not be read: " (default ?error "")) })
      LOCAL_BOUND -> idle
      LOCAL_REFUSED -> idle
        (emit THEME_RESTORE_FAILED { error: (str/concat ?kind ": " ?error) })
      THEME_CHOSEN -> idle
        (kv/put @config.store "theme" ?theme { emit: { success: LOCAL_KEPT, failure: LOCAL_UNKEPT } })
      LOCAL_KEPT -> idle
      LOCAL_UNKEPT -> idle
        (emit THEME_RESTORE_FAILED { error: (str/concat "the theme could not be kept in the browser: " (default ?error "")) })
    }

    config {
      store : string = "themes"
        @label "Store"
        @description "The browser kv store the theme is kept in, declared in the app's kv grant."
        @tier "infra"
    }

    emits {
      THEME_RESTORE_FAILED -> external { error : string! }
        @description "The browser's kept theme could not be read, bound or kept; the declared themes stay."
        @tier "secondary"
    }

    listens {
      *.THEME_CHOSEN -> THEME_CHOSEN
      THEME_CHOSEN { theme : string! }
        @description "A theme was chosen or restored; keep it in the browser."
      LOCAL_READ { found : boolean!, value : string, key : string }
      LOCAL_UNREAD { error : string, kind : string }
      LOCAL_BOUND { theme : string! }
      LOCAL_REFUSED { error : string!, kind : string! }
      LOCAL_KEPT { }
      LOCAL_UNKEPT { error : string, kind : string }
    }
  }

  page "/theme-picker" as ThemePickerPage -> ThemePicker, ThemeRestore, ThemeLocal
}
