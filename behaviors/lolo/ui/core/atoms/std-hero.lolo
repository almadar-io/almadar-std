app std-hero [
  version: "1.0.0",
  description: "std-hero — the headline block at the top of a page, or a call-to-action banner further down. Optional eyebrow badge, headline, supporting text, up to two link actions, an optional copyable command, optional media below or beside the copy, and an optional backdrop scene behind it all. `look: banner` turns it into a contained call-to-action card. Links follow `href` (in-app path, #anchor, or absolute URL); each click also emits CTA_PRIMARY / CTA_SECONDARY with the href. Pick for landing, product, pricing and campaign pages."
]
orbital HeroOrbital {
  entity HeroView [runtime] {
    id : string!
  }

  trait HeroRender -> @rebindable HeroView [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (if (== @config.mediaPosition side)
          (render-ui main @config.sideContent)
          (render-ui main @config.stackedContent))
      HERO_PRIMARY -> idle
        (emit CTA_PRIMARY { href: ?href })
      HERO_SECONDARY -> idle
        (emit CTA_SECONDARY { href: ?href })
    }

    emits {
      CTA_PRIMARY -> external {
        href : string
      }
        @description "The primary action was clicked; carries its href."
        @synonyms "primary cta, main button, get started click"
        @tier "domain"
      CTA_SECONDARY -> external {
        href : string
      }
        @description "The secondary action was clicked; carries its href."
        @synonyms "secondary cta, second button, learn more click"
        @tier "domain"
    }

    listens {
      HERO_PRIMARY {
        href : string
      }
        @description "Primary action button click."
        @tier "internal"
      HERO_SECONDARY {
        href : string
      }
        @description "Secondary action button click."
        @tier "internal"
    }

    config {
      look : "hero" | "banner" | "header" = hero
        @label "Look"
        @description "hero = full-width page opener with an h1; banner = contained call-to-action card with an h2; header = compact opener at the top of an app page"
        @synonyms "cta banner, call to action, callout, page header, masthead"
        @tier "presentation"
      eyebrow : string = ""
        @label "Eyebrow"
        @description "Small badge above the headline; empty hides it"
        @synonyms "tag, kicker, label above title"
        @tier "presentation"
      headline : string = "Build what you mean"
        @label "Headline"
        @description "Main headline"
        @synonyms "title, heading"
        @tier "presentation"
      lede : string = ""
        @label "Supporting text"
        @description "One or two sentences under the headline; empty hides it"
        @synonyms "subtitle, subheading, description, tagline"
        @tier "presentation"
      alignment : "center" | "start" = center
        @label "Alignment"
        @description "Center the copy, or align it to the start edge"
        @tier "presentation"
      primaryLabel : string = "Get started"
        @label "Primary action label"
        @description "Empty hides the primary action"
        @tier "presentation"
      primaryHref : string = "#"
        @label "Primary action link"
        @description "In-app path, #anchor, or absolute URL"
        @tier "presentation"
      secondaryLabel : string = ""
        @label "Secondary action label"
        @description "Empty hides the secondary action"
        @tier "presentation"
      secondaryHref : string = ""
        @label "Secondary action link"
        @description "In-app path, #anchor, or absolute URL"
        @tier "presentation"
      command : string = ""
        @label "Command"
        @description "A shell command shown in a copyable code box under the actions, e.g. an install one-liner; empty hides it"
        @synonyms "install command, cli, terminal snippet"
        @tier "presentation"
      mediaSrc : string = ""
        @label "Media image"
        @description "Screenshot or illustration URL; empty hides it"
        @synonyms "hero image, screenshot, picture"
        @tier "presentation"
      mediaAlt : string = ""
        @label "Media alt text"
        @tier "presentation"
      illustration : string = ""
        @label "Illustration"
        @description "Inline SVG shown beside or below the copy instead of the media image; empty uses the media image"
        @synonyms "artwork, graphic, drawing, svg"
        @tier "presentation"
      backgroundSrc : string = ""
        @label "Background photo"
        @description "Photo URL filling the block behind the copy when the surface is image"
        @synonyms "background image, hero photo, cover photo"
        @tier "presentation"
      backgroundPosition : "center" | "top" | "bottom" | "left" | "right" = center
        @label "Background photo focus"
        @description "Which part of the photo stays visible when it is cropped"
        @tier "presentation"
      edgeTop : "none" | "curve" | "wave" | "arc" | "tilt" | "step" | "scallop" = none
        @label "Top edge"
        @description "Shape cut into the top of the block; curve uses the theme's shape"
        @tier "presentation"
      edgeBottom : "none" | "curve" | "wave" | "arc" | "tilt" | "step" | "scallop" = none
        @label "Bottom edge"
        @description "Shape cut into the bottom of the block; curve uses the theme's shape"
        @tier "presentation"
      edgeColor : "background" | "muted" | "surface" | "gradient" | "inverse" = background
        @label "Edge fill"
        @description "The surface of the neighbouring section, which fills the cut"
        @tier "presentation"
      texture : boolean = false
        @label "Texture"
        @description "Lay the theme's texture over the block"
        @tier "presentation"
      mediaPosition : "below" | "side" = below
        @label "Media position"
        @description "Below the copy, or beside it on wide screens"
        @tier "presentation"
      surface : "plain" | "muted" | "accent" | "inverse" | "image" = plain
        @label "Surface"
        @description "Background behind the block: plain, muted, a soft theme gradient (accent), inverted colors (inverse), or a photo (image, set Background photo)"
        @tier "presentation"
      height : "auto" | "tall" = auto
        @label "Height"
        @description "auto fits the copy; tall fills most of the screen with the copy centred, for a hero over a backdrop scene"
        @tier "presentation"
      backdropContent : render-ui = {
        type: box
        className: "hidden"
      }
        @label "Backdrop"
        @description "A scene behind the whole block, such as an animated canvas; it fills the block, never takes clicks, and the copy stays on top. Empty by default."
        @tier "presentation"
      copyContent : render-ui = {
        type: stack
        direction: vertical
        gap: lg
        align: (if (== @config.alignment center) center start)
        children: [{
          type: badge
          label: @config.eyebrow
          variant: primary
          size: md
        }, {
          type: typography
          content: @config.headline
          variant: (if (== @config.look hero) h1 h2)
          weight: bold
          align: (if (== @config.alignment center) center left)
          className: "tracking-tight text-balance"
        }, {
          type: typography
          content: @config.lede
          variant: large
          color: (if (== @config.look header) primary muted)
          align: (if (== @config.alignment center) center left)
          className: (if (== @config.lede "") hidden "max-w-2xl text-pretty")
        }, {
          type: stack
          direction: horizontal
          gap: md
          wrap: true
          justify: (if (== @config.alignment center) center start)
          className: (if (== @config.primaryLabel "") (if (== @config.secondaryLabel "") hidden "pt-2") "pt-2")
          children: [{
            type: button
            label: @config.primaryLabel
            href: @config.primaryHref
            variant: primary
            size: lg
            action: HERO_PRIMARY
            actionPayload: { href: @config.primaryHref }
            className: (if (== @config.primaryLabel "") hidden "")
          }, {
            type: button
            label: @config.secondaryLabel
            href: @config.secondaryHref
            variant: secondary
            size: lg
            action: HERO_SECONDARY
            actionPayload: { href: @config.secondaryHref }
            className: (if (== @config.secondaryLabel "") hidden "")
          }]
        }, {
          type: box
          fullWidth: true
          className: (if (== @config.command "") hidden "max-w-xl")
          children: [{
            type: code-block
            code: @config.command
            language: bash
            showLanguageBadge: false
            showCopyButton: true
          }]
        }]
      }
        @label "Copy block"
        @tier "internal"
      mediaContent : render-ui = {
        type: image
        src: @config.mediaSrc
        alt: @config.mediaAlt
        rounded: xl
        bordered: true
        loading: eager
      }
        @label "Media block"
        @tier "internal"
      illustrationContent : render-ui = {
        type: animated-graphic
        svgContent: @config.illustration
        animation: draw
        animate: true
        width: "100%"
        height: (if (== @config.look header) 200 380)
        alt: ""
      }
        @label "Illustration block"
        @tier "internal"
      stackedContent : render-ui = {
        type: box
        paddingY: (if (== @config.look hero) "2xl" (if (== @config.look banner) xl lg))
        bg: (if (== @config.surface muted) muted (if (== @config.surface accent) gradient (if (or (== @config.surface inverse) (== @config.surface image)) inverse transparent)))
        rounded: (if (== @config.look header) "2xl" none)
        edgeTop: @config.edgeTop
        edgeBottom: @config.edgeBottom
        edgeColor: @config.edgeColor
        texture: @config.texture
        fullWidth: true
        position: relative
        overflow: hidden
        className: (if (== @config.height tall) "flex min-h-[80vh] items-center" "")
        children: [{
          type: box
          position: absolute
          className: "inset-0 pointer-events-none"
          aria-hidden: true
          children: [{
            type: image
            src: @config.backgroundSrc
            alt: ""
            fit: cover
            position: @config.backgroundPosition
            priority: (== @config.look hero)
            className: "h-full"
          }, {
            type: box
            className: (if (== @config.surface image) "band-scrim" "hidden")
          }, @config.backdropContent]
        }, {
          type: box
          position: relative
          fullWidth: true
          children: [{
              type: container
              size: xl
              maxWidth: xl
              padding: lg
              children: [{
                type: box
                padding: (if (== @config.look banner) xl none)
                rounded: (if (== @config.look banner) "2xl" none)
                border: (== @config.look banner)
                bg: (if (== @config.look banner) muted transparent)
                children: [{
                  type: stack
                  direction: vertical
                  gap: "2xl"
                  align: (if (== @config.alignment center) center stretch)
                  children: [@config.copyContent, (if (== @config.illustration "") @config.mediaContent @config.illustrationContent)]
                }]
              }]
          }]
        }]
      }
        @label "Stacked body"
        @tier "internal"
      sideContent : render-ui = {
        type: box
        paddingY: (if (== @config.look hero) "2xl" (if (== @config.look banner) xl lg))
        bg: (if (== @config.surface muted) muted (if (== @config.surface accent) gradient (if (or (== @config.surface inverse) (== @config.surface image)) inverse transparent)))
        rounded: (if (== @config.look header) "2xl" none)
        edgeTop: @config.edgeTop
        edgeBottom: @config.edgeBottom
        edgeColor: @config.edgeColor
        texture: @config.texture
        fullWidth: true
        position: relative
        overflow: hidden
        className: (if (== @config.height tall) "flex min-h-[80vh] items-center" "")
        children: [{
          type: box
          position: absolute
          className: "inset-0 pointer-events-none"
          aria-hidden: true
          children: [{
            type: image
            src: @config.backgroundSrc
            alt: ""
            fit: cover
            position: @config.backgroundPosition
            priority: (== @config.look hero)
            className: "h-full"
          }, {
            type: box
            className: (if (== @config.surface image) "band-scrim" "hidden")
          }, @config.backdropContent]
        }, {
          type: box
          position: relative
          fullWidth: true
          children: [{
              type: container
              size: xl
              maxWidth: xl
              padding: lg
              children: [{
                type: box
                padding: (if (== @config.look banner) xl none)
                rounded: (if (== @config.look banner) "2xl" none)
                border: (== @config.look banner)
                bg: (if (== @config.look banner) muted transparent)
                children: [{
                  type: split
                  ratio: "1:1"
                  gap: xl
                  align: center
                  children: [@config.copyContent, (if (== @config.illustration "") @config.mediaContent @config.illustrationContent)]
                }]
              }]
          }]
        }]
      }
        @label "Side-by-side body"
        @tier "internal"
    }
  }

  page "/hero" as HeroPage -> HeroRender
}
