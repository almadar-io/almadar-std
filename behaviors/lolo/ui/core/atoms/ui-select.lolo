app ui-select "1.0.0"
"Select — UI factory (1:1 with the @almadar/ui select pattern)."
;; @pattern "select"
orbital SelectOrbital {
  type SelectOptionsItem = {
    value : string!
    label : string!
  }
  type SelectGroupsItem = {
    label : string!
    options : [SelectGroupsItemOptionsItem]!
  }
  type SelectGroupsItemOptionsItem = {
    value : string!
    label : string!
  }

  entity SelectItem [runtime] {
    id : string!
  }

  trait SelectRender -> @rebindable SelectItem [interaction, instance] {
    initial: idle

    state idle {
      INIT -> idle
        (render-ui main {
          className: @config.className
          label: @config.label
          options: @config.options
          groups: @config.groups
          placeholder: @config.placeholder
          value: @config.value
          action: @config.action
          error: @config.error
          multiple: @config.multiple
          searchable: @config.searchable
          clearable: @config.clearable
          onChange: @config.onChange
          onValueChange: @config.onValueChange
          enter: @config.enter
          enterDelay: @config.enterDelay
          aria-label: @config.ariaLabel
          aria-labelledby: @config.ariaLabelledby
          aria-describedby: @config.ariaDescribedby
          aria-live: @config.ariaLive
          aria-current: @config.ariaCurrent
          aria-pressed: @config.ariaPressed
          aria-expanded: @config.ariaExpanded
          aria-selected: @config.ariaSelected
          aria-hidden: @config.ariaHidden
          aria-busy: @config.ariaBusy
          role: @config.role
          lang: @config.lang
          dir: @config.dir
          tabIndex: @config.tabIndex
          type: select
        })
    }

    emits {
      @config.action -> external {
        value : string!
      }
        @description "Declarative event name for trait dispatch — emits `{ value }` on selection commit (same gestures as `onChange`)."
        @tier "essential"
      @config.onChange -> external {
        value : string!
      }
        @description "onChange handler (native ChangeEvent) or declarative event key for trait dispatch"
        @tier "essential"
      @config.onValueChange -> external {
        value : string!
      }
        @description "Value-based change: a React callback (internal use) OR a declarative event key that emits `{ value }` on the bus (render-ui / lolo authoring). Mirrors the `onChange` handler|event convention so it's an event-emitting prop, not a bare callback."
        @tier "essential"
    }

    config {
      className : string
        @label "Class Name"
        @description "Additional CSS classes applied to the root element."
        @tier "presentation"
      label : string
        @label "Label"
        @description "Visible label naming the control."
        @tier "presentation"
      options : [SelectOptionsItem] = []
        @label "Options"
        @description "Select options (flat list)"
        @tier "presentation"
      groups : [SelectGroupsItem] = []
        @label "Groups"
        @description "Grouped options — rendered as <optgroup> in native mode, sections in rich mode."
        @tier "presentation"
      placeholder : string
        @label "Placeholder"
        @description "Placeholder text"
        @tier "presentation"
      value : string
        @label "Value"
        @description "Current value (string for single, string[] for multiple)"
        @tier "presentation"
      action : event = "ACTION"
        @label "Action"
        @description "Declarative event name for trait dispatch — emits `{ value }` on selection commit (same gestures as `onChange`)."
        @tier "presentation"
      error : string
        @label "Error"
        @description "Error message"
        @tier "presentation"
      multiple : boolean
        @label "Multiple"
        @description "Allow selecting multiple values — activates the rich dropdown."
        @tier "presentation"
      searchable : boolean
        @label "Searchable"
        @description "Show a search input inside the dropdown — activates the rich dropdown."
        @tier "presentation"
      clearable : boolean
        @label "Clearable"
        @description "Show a clear button when a value is selected."
        @tier "presentation"
      onChange : event = "CHANGE"
        @label "On Change"
        @description "onChange handler (native ChangeEvent) or declarative event key for trait dispatch"
        @tier "presentation"
      onValueChange : event = "VALUE_CHANGE"
        @label "On Value Change"
        @description "Value-based change: a React callback (internal use) OR a declarative event key that emits `{ value }` on the bus (render-ui / lolo authoring). Mirrors the `onChange` handler|event convention so it's an event-emitting prop, not a bare callback."
        @tier "presentation"
      enter : "none" | "fade" | "rise" | "scale" | "slide"
        @label "Enter"
        @description "How this element animates in when it mounts (theme-styled); overrides the theme's default slot entry. `none` opts out."
        @tier "presentation"
      enterDelay : number
        @label "Enter Delay"
        @description "Stagger step for the entry: waits this many `--motion-enter-stagger` steps before animating."
        @tier "presentation"
      ariaLabel : string
        @label "Aria-label"
        @description "Accessible name read by screen readers when the visible text is missing or not descriptive (e.g. an icon-only control)."
        @synonyms "aria-label"
        @tier "presentation"
      ariaLabelledby : string
        @label "Aria-labelledby"
        @description "Id of the element whose text names this one."
        @synonyms "aria-labelledby"
        @tier "presentation"
      ariaDescribedby : string
        @label "Aria-describedby"
        @description "Id of the element whose text describes this one (help text, error)."
        @synonyms "aria-describedby"
        @tier "presentation"
      ariaLive : "off" | "polite" | "assertive"
        @label "Aria-live"
        @description "Announce changes to this region: polite waits for a pause, assertive interrupts."
        @synonyms "aria-live"
        @tier "presentation"
      ariaCurrent : "page" | "step" | "location" | "date" | "time" | "true" | "false"
        @label "Aria-current"
        @description "Marks the current item in a set: the current page, step, location, date or time."
        @synonyms "aria-current"
        @tier "presentation"
      ariaPressed : "true" | "false" | "mixed"
        @label "Aria-pressed"
        @description "Toggle-button state."
        @synonyms "aria-pressed"
        @tier "presentation"
      ariaExpanded : boolean
        @label "Aria-expanded"
        @description "Whether the element it controls is expanded."
        @synonyms "aria-expanded"
        @tier "presentation"
      ariaSelected : boolean
        @label "Aria-selected"
        @description "Whether this item is selected (tabs, options, grid cells)."
        @synonyms "aria-selected"
        @tier "presentation"
      ariaHidden : boolean
        @label "Aria-hidden"
        @description "Hide from assistive technology (decorative content only)."
        @synonyms "aria-hidden"
        @tier "presentation"
      ariaBusy : boolean
        @label "Aria-busy"
        @description "This region is updating; assistive technology waits before announcing it."
        @synonyms "aria-busy"
        @tier "presentation"
      role : "alert" | "alertdialog" | "application" | "article" | "banner" | "blockquote" | "button" | "caption" | "cell" | "checkbox" | "code" | "columnheader" | "combobox" | "complementary" | "contentinfo" | "definition" | "deletion" | "dialog" | "document" | "emphasis" | "feed" | "figure" | "form" | "generic" | "grid" | "gridcell" | "group" | "heading" | "img" | "insertion" | "link" | "list" | "listbox" | "listitem" | "log" | "main" | "marquee" | "math" | "menu" | "menubar" | "menuitem" | "menuitemcheckbox" | "menuitemradio" | "meter" | "navigation" | "none" | "note" | "option" | "paragraph" | "presentation" | "progressbar" | "radio" | "radiogroup" | "region" | "row" | "rowgroup" | "rowheader" | "scrollbar" | "search" | "searchbox" | "separator" | "slider" | "spinbutton" | "status" | "strong" | "subscript" | "superscript" | "switch" | "tab" | "table" | "tablist" | "tabpanel" | "term" | "textbox" | "time" | "timer" | "toolbar" | "tooltip" | "tree" | "treegrid" | "treeitem"
        @label "Role"
        @description "WAI-ARIA role when the element's native semantics don't describe it."
        @tier "presentation"
      lang : string
        @label "Lang"
        @description "Language of this element's content (BCP 47, e.g. ar, sl, en)."
        @tier "presentation"
      dir : "ltr" | "rtl" | "auto"
        @label "Dir"
        @description "Text direction of this element's content."
        @tier "presentation"
      tabIndex : number
        @label "Tab Index"
        @description "0 puts the element in the Tab order; -1 makes it focusable only programmatically."
        @tier "presentation"
    }
  }

  page "/select" as SelectPage -> SelectRender
}
