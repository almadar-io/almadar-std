app std-delay [
  version: "1.0.0",
  description: "std-delay — wait a declared number of milliseconds, then emit one event. START arms the deadline, CANCEL disarms it, ELAPSED fires once when the deadline passes. Replaces the retired async/delay operator."
]
orbital DelayOrbital {
  entity DelayTimer [runtime] {
    id : string!
    deadline : instant? @description "The instant at which ELAPSED fires; null while idle." = null
    waitedMs : number @description "Milliseconds the armed wait was set to." = 0
  }

  trait Delay -> @rebindable DelayTimer [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.deadline null)
      START -> waiting
        (set @entity.waitedMs (if (== ?delayMs null) @config.delayMs ?delayMs))
        (set @entity.deadline (time/add @now @entity.waitedMs "ms"))
    }

    state waiting {
      INIT -> idle
        (set @entity.deadline null)
      START -> waiting
        (set @entity.waitedMs (if (== ?delayMs null) @config.delayMs ?delayMs))
        (set @entity.deadline (time/add @now @entity.waitedMs "ms"))
      CANCEL -> idle
        (set @entity.deadline null)
      TIMER_DUE -> idle
        (set @entity.deadline null)
        (emit ELAPSED { waitedMs: @entity.waitedMs })
    }

    emits {
      ELAPSED -> external {
        waitedMs : number!
      }
        @description "The wait ended."
        @synonyms "done, elapsed, time up, fired"
        @tier "domain"
      TIMER_DUE -> internal { }
        @tier "internal"
    }

    listens {
      START {
        delayMs : number
      }
        @description "Arm the wait; delayMs overrides the configured delay. Re-arming restarts it."
        @synonyms "begin, wait, schedule"
      CANCEL { }
        @description "Disarm the wait; ELAPSED does not fire."
        @synonyms "stop, abort"
    }

    ticks {
      deadlineCheck every 100ms
        when (and (!= @entity.deadline null) (not (time/isBefore @now (default @entity.deadline @now))))
        (emit TIMER_DUE { })
    }

    config {
      delayMs : number = 1000
        @label "Delay (ms)"
        @description "Milliseconds between START and ELAPSED when START carries no delayMs. Resolution is the 100ms deadline check."
        @synonyms "wait, sleep, pause, timeout"
        @tier "domain"
    }
  }

  page boot as DelayOrbitalStart -> Delay
}
