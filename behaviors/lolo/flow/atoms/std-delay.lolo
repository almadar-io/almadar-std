app std-delay [
  version: "1.0.0",
  description: "std-delay — wait a declared number of milliseconds, then emit one event. START arms the deadline, CANCEL disarms it, ELAPSED fires once when the deadline passes. Replaces the retired async/delay operator. A START or CANCEL carrying a key arms or disarms that key's own deadline instead, in either state, so one timer serves many waits at once (a server's open connections); each fires ELAPSED { key, waitedMs } once it passes. A keyless START, CANCEL and ELAPSED are the single timer, unchanged. The trait rests in idle with nothing armed, waiting with the single timer armed, keyed with keyed deadlines armed and keyedWaiting with both; its two 100ms checks run only in the states that have something armed, so a timer nothing armed never ticks."
]
type DelayKeyed = { key : string!, deadline : instant!, waitedMs : number! }

orbital DelayOrbital {
  entity DelayTimer [runtime] {
    id : string!
    deadline : instant? @description "The instant at which ELAPSED fires; null while idle." = null
    waitedMs : number @description "Milliseconds the armed wait was set to." = 0
    keyed : [DelayKeyed] @description "The keyed deadlines armed, each firing ELAPSED with its key." = []
  }

  trait Delay -> @rebindable DelayTimer [client] {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.deadline null)
        (set @entity.keyed [])
      START -> waiting when (= (default ?key "") "")
        (set @entity.waitedMs (if (== ?delayMs null) @config.delayMs ?delayMs))
        (set @entity.deadline (time/add @now @entity.waitedMs "ms"))
      START -> keyed when (!= (default ?key "") "")
        (set @entity.keyed (array/append (array/filter @entity.keyed (fn d (!= @d.key ?key))) { key: (default ?key ""), deadline: (time/add @now (if (== ?delayMs null) @config.delayMs ?delayMs) "ms"), waitedMs: (if (== ?delayMs null) @config.delayMs ?delayMs) }))
      CANCEL -> idle when (!= (default ?key "") "")
      KEYED_DUE -> idle
    }

    state waiting {
      INIT -> idle
        (set @entity.deadline null)
        (set @entity.keyed [])
      START -> waiting when (= (default ?key "") "")
        (set @entity.waitedMs (if (== ?delayMs null) @config.delayMs ?delayMs))
        (set @entity.deadline (time/add @now @entity.waitedMs "ms"))
      START -> keyedWaiting when (!= (default ?key "") "")
        (set @entity.keyed (array/append (array/filter @entity.keyed (fn d (!= @d.key ?key))) { key: (default ?key ""), deadline: (time/add @now (if (== ?delayMs null) @config.delayMs ?delayMs) "ms"), waitedMs: (if (== ?delayMs null) @config.delayMs ?delayMs) }))
      CANCEL -> idle when (= (default ?key "") "")
        (set @entity.deadline null)
      CANCEL -> waiting when (!= (default ?key "") "")
      TIMER_DUE -> idle
        (set @entity.deadline null)
        (emit ELAPSED { waitedMs: @entity.waitedMs })
      KEYED_DUE -> waiting
    }

    state keyed {
      INIT -> idle
        (set @entity.deadline null)
        (set @entity.keyed [])
      START -> keyedWaiting when (= (default ?key "") "")
        (set @entity.waitedMs (if (== ?delayMs null) @config.delayMs ?delayMs))
        (set @entity.deadline (time/add @now @entity.waitedMs "ms"))
      START -> keyed when (!= (default ?key "") "")
        (set @entity.keyed (array/append (array/filter @entity.keyed (fn d (!= @d.key ?key))) { key: (default ?key ""), deadline: (time/add @now (if (== ?delayMs null) @config.delayMs ?delayMs) "ms"), waitedMs: (if (== ?delayMs null) @config.delayMs ?delayMs) }))
      CANCEL -> keyed when (and (!= (default ?key "") "") (array/some @entity.keyed (fn d (!= @d.key ?key))))
        (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key ?key))))
      CANCEL -> idle when (and (!= (default ?key "") "") (not (array/some @entity.keyed (fn d (!= @d.key ?key)))))
        (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key ?key))))
      KEYED_DUE -> keyed when (and (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline)))) (> (array/len @entity.keyed) 1))
        (let ((due (array/find @entity.keyed (fn d (not (time/isBefore @now @d.deadline))))))
          (when (!= @due null)
            (do
              (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key @due.key))))
              (emit ELAPSED { key: @due.key, waitedMs: @due.waitedMs })
              (when (array/some @entity.keyed (fn d (and (!= @d.key @due.key) (not (time/isBefore @now @d.deadline)))))
                (emit KEYED_DUE { left: (- (array/len @entity.keyed) 1) })))))
      KEYED_DUE -> idle when (and (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline)))) (<= (array/len @entity.keyed) 1))
        (let ((due (array/find @entity.keyed (fn d (not (time/isBefore @now @d.deadline))))))
          (when (!= @due null)
            (do
              (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key @due.key))))
              (emit ELAPSED { key: @due.key, waitedMs: @due.waitedMs })
              (when (array/some @entity.keyed (fn d (and (!= @d.key @due.key) (not (time/isBefore @now @d.deadline)))))
                (emit KEYED_DUE { left: (- (array/len @entity.keyed) 1) })))))
      KEYED_DUE -> keyed when (not (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline)))))
    }

    state keyedWaiting {
      INIT -> idle
        (set @entity.deadline null)
        (set @entity.keyed [])
      START -> keyedWaiting when (= (default ?key "") "")
        (set @entity.waitedMs (if (== ?delayMs null) @config.delayMs ?delayMs))
        (set @entity.deadline (time/add @now @entity.waitedMs "ms"))
      START -> keyedWaiting when (!= (default ?key "") "")
        (set @entity.keyed (array/append (array/filter @entity.keyed (fn d (!= @d.key ?key))) { key: (default ?key ""), deadline: (time/add @now (if (== ?delayMs null) @config.delayMs ?delayMs) "ms"), waitedMs: (if (== ?delayMs null) @config.delayMs ?delayMs) }))
      CANCEL -> keyed when (= (default ?key "") "")
        (set @entity.deadline null)
      CANCEL -> keyedWaiting when (and (!= (default ?key "") "") (array/some @entity.keyed (fn d (!= @d.key ?key))))
        (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key ?key))))
      CANCEL -> waiting when (and (!= (default ?key "") "") (not (array/some @entity.keyed (fn d (!= @d.key ?key)))))
        (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key ?key))))
      TIMER_DUE -> keyed
        (set @entity.deadline null)
        (emit ELAPSED { waitedMs: @entity.waitedMs })
      KEYED_DUE -> keyedWaiting when (and (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline)))) (> (array/len @entity.keyed) 1))
        (let ((due (array/find @entity.keyed (fn d (not (time/isBefore @now @d.deadline))))))
          (when (!= @due null)
            (do
              (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key @due.key))))
              (emit ELAPSED { key: @due.key, waitedMs: @due.waitedMs })
              (when (array/some @entity.keyed (fn d (and (!= @d.key @due.key) (not (time/isBefore @now @d.deadline)))))
                (emit KEYED_DUE { left: (- (array/len @entity.keyed) 1) })))))
      KEYED_DUE -> waiting when (and (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline)))) (<= (array/len @entity.keyed) 1))
        (let ((due (array/find @entity.keyed (fn d (not (time/isBefore @now @d.deadline))))))
          (when (!= @due null)
            (do
              (set @entity.keyed (array/filter @entity.keyed (fn d (!= @d.key @due.key))))
              (emit ELAPSED { key: @due.key, waitedMs: @due.waitedMs })
              (when (array/some @entity.keyed (fn d (and (!= @d.key @due.key) (not (time/isBefore @now @d.deadline)))))
                (emit KEYED_DUE { left: (- (array/len @entity.keyed) 1) })))))
      KEYED_DUE -> keyedWaiting when (not (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline)))))
    }

    emits {
      ELAPSED -> external {
        waitedMs : number!
        key : string
      }
        @description "The wait ended; key names the keyed deadline that passed, absent for the single timer."
        @synonyms "done, elapsed, time up, fired"
        @tier "domain"
      TIMER_DUE -> internal { }
        @tier "internal"
      KEYED_DUE -> internal {
        left : number
      }
        @description "A keyed deadline may have passed; each one due fires ELAPSED in turn."
        @tier "internal"
    }

    listens {
      START {
        delayMs : number
        key : string
      }
        @description "Arm the wait; delayMs overrides the configured delay. Re-arming restarts it. With a key, arm (or restart) that key's own deadline and leave the single timer as it is."
        @synonyms "begin, wait, schedule"
      CANCEL {
        key : string
      }
        @description "Disarm the wait; ELAPSED does not fire. With a key, disarm only that key's deadline."
        @synonyms "stop, abort"
    }

    ticks {
      deadlineCheck every 100ms in waiting, keyedWaiting [background]
        when (and (!= @entity.deadline null) (not (time/isBefore @now (default @entity.deadline @now))))
        (emit TIMER_DUE { })
      keyedCheck every 100ms in keyed, keyedWaiting [background]
        when (array/some @entity.keyed (fn d (not (time/isBefore @now @d.deadline))))
        (emit KEYED_DUE { left: (array/len @entity.keyed) })
    }

    config {
      delayMs : number = 1000
        @label "Delay (ms)"
        @description "Milliseconds between START and ELAPSED when START carries no delayMs. Resolution is the 100ms deadline check."
        @synonyms "wait, sleep, pause, timeout"
        @tier "domain"
    }
  }

  page boot as DelayOrbitalStart -> Delay
}
