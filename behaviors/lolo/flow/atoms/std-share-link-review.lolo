app std-share-link-review [
  version: "1.0.0",
  locales: [en, ar, sl],
  description: "std-share-link-review — approval by shared link, for a reviewer with no account (a client signing off a design, a draft or a video). The link's token is a std-opaque-token (LinkMint mints it, LinkResolve finds its link): a signed-in person issues a link for one item with ISSUE_LINK { targetId, title, mediaUrl, mediaType, days }, which mints a token, stores only its SHA-256 as the link's id with the item and an expiry `days` from now, and answers LINK_ISSUED { targetId, url } once. Opening `/review-link/:token` (a public route) runs the guest trait on the server: LinkResolve reads exactly the link the token hashes to (the entity is `@read server`, so no visitor can list links), and the guest shows the item with its title, and lets the reviewer approve it or request changes with their name and a note; an expired, revoked or already-decided link says so and takes no decision. The decision is stored on the link and announced as LINK_DECIDED { targetId, decision, reviewerName, note }, for the host app to act on (mark the asset approved, notify its owner)."
]
type ReviewLinkField = { name : string!, value : string! }

orbital ShareLinkReviewOrbital {
  uses Typography from "std/behaviors/ui-typography"
  uses Button from "std/behaviors/ui-button"
  uses Opaque from "std/behaviors/std-opaque-token"

  expects entity Viewer [identity] {
    id : string!
  }

  entity ReviewLink [persistent: review_links] {
    @read server "A link is found only by the hash of its unguessable token, on the server; no visitor lists links."
    @create (!= @user.role "anonymous")
    @update none "Only the link's server trait writes it, addressed by the hash of a token only the link's holder has."
    @delete (!= @user.role "anonymous")
    id : string!
    targetId : string! @description "The item under review (an asset, a draft)." @synonyms "asset, item, document"
    title : string @description "What the reviewer is asked to approve." @synonyms "name, subject" = ""
    mediaUrl : string @description "Where the item's image or video is served from; blank for a text-only item." @synonyms "file url, preview" = ""
    mediaType : "image" | "video" | "none" @description "What mediaUrl is." @synonyms "kind" = none
    status : "open" | "approved" | "changes-requested" | "revoked" @description "Where the review stands." @synonyms "state, decision" = open
    expiresAt : instant @description "When the link stops working." @synonyms "expiry, valid until"
    issuedBy : string @description "Who issued the link." @synonyms "owner, sender" = ""
    reviewerName : string @description "The name the reviewer gave." @synonyms "approver, client contact" = ""
    decisionNote : string @description "The reviewer's note." @synonyms "comment, feedback" = ""
    decidedAt : instant @description "When the reviewer decided." @synonyms "approved at, answered at"
  }

  entity ReviewLinkDraft [runtime] {
    id : string!
    pendingTargetId : string @description "The item the link in hand is for." = ""
    draftName : string @description "The name the reviewer is typing." = ""
    draftNote : string @description "The note the reviewer is typing." = ""
    openHash : string @description "The id of the link the reviewer opened." = ""
  }

  ;; Issues one link per request; the plain token leaves only in LINK_ISSUED.
  trait ReviewLinkIssuer -> ReviewLinkDraft {
    initial: idle

    state idle {
      INIT -> idle
      ISSUE_LINK -> issuing when (validate/required ?targetId)
        (set @entity.pendingTargetId ?targetId)
        (emit LINK_TOKEN_MINT {
          key: ?targetId
          fields: [{ name: "targetId", value: ?targetId }, { name: "title", value: (default ?title "") }, { name: "mediaUrl", value: (default ?mediaUrl "") }, { name: "mediaType", value: (if (= ?mediaType "image") "image" (if (= ?mediaType "video") "video" "none")) }, { name: "status", value: "open" }, { name: "issuedBy", value: (default @user.id "") }]
          ttlMs: (* (default ?days @config.defaultDays) 86400000)
        })
      REVOKE_LINK -> idle
        (persist update ReviewLink { id: ?id, status: "revoked" } { emit: { failure: LINK_WRITE_FAILED } })
        (emit LINK_REVOKED { id: ?id })
      LINK_WRITE_FAILED -> idle
        (notify error (str/concat "Couldn't revoke the link — " (default ?error "")))
    }

    state issuing {
      INIT -> idle
      LINK_TOKEN_MINTED -> idle
        (emit LINK_ISSUED { targetId: @entity.pendingTargetId, url: (str/concat @config.baseUrl "/review-link/" ?token) })
      LINK_TOKEN_REFUSED -> idle
        (emit LINK_FAILED { message: (default ?message "") })
    }

    emits {
      LINK_ISSUED -> external {
        targetId : string!
        url : string!
      }
        @description "A review link was issued; url is the only place the token appears, so show or send it now."
        @tier "domain"
      LINK_REVOKED -> external {
        id : string!
      }
        @description "A review link was revoked and stops working."
        @tier "secondary"
      LINK_FAILED -> external {
        message : string
      }
        @description "The link could not be issued."
        @tier "secondary"
      LINK_TOKEN_MINT -> external {
        key : string!
        fields : [ReviewLinkField]!
        ttlMs : number!
      }
        @description "Internal: asks LinkMint to mint the link's token."
        @tier "internal"
      LINK_WRITE_FAILED {
        error : string
        code : string
      }
        @description "A review link could not be revoked."
        @synonyms "error, failure, rejected"
        @tier "internal"
    }

    listens {
      ISSUE_LINK -> input {
        targetId : string!
        title : string
        mediaUrl : string
        mediaType : string
        days : number
      }
        @description "Issue a link that lets someone without an account approve one item."
        @synonyms "share for approval, client approval link, send for sign-off"
        @tier "domain"
      REVOKE_LINK {
        id : string!
      }
        @description "Stop a review link working."
        @tier "domain"
      LINK_TOKEN_MINTED {
        key : string!
        token : string!
        id : string!
        expiresAt : instant
      }
        @tier "internal"
      LINK_TOKEN_REFUSED {
        key : string!
        code : string!
        message : string!
        token : string
      }
        @tier "internal"
      LinkMint.TOKEN_MINTED -> LINK_TOKEN_MINTED
      LinkMint.TOKEN_REFUSED -> LINK_TOKEN_REFUSED
    }

    config {
      baseUrl : string = ""
        @label "Address of the app"
        @description "Prefix of the link sent to reviewers, e.g. https://app.example.com; blank gives a path."
        @tier "infra"
      defaultDays : number = 14
        @label "Days a review link works"
        @description "How long a link stays usable when the request names no duration."
        @tier "policy"
    }
  }

  ;; The reviewer's page: runs on the server, reads exactly the link its token
  ;; names (through LinkResolve), and records one decision.
  trait ReviewLinkGuest -> ReviewLinkDraft [server] {
    initial: opening

    state opening {
      INIT -> opening
        (emit LINK_TOKEN_RESOLVE { key: "review", token: (default ?token "") })
      LINK_FOUND -> open when (and (= ?row.status "open") (!= ?row.mediaType "none"))
        (set @entity.openHash ?id)
        (set @entity.pendingTargetId ?row.targetId)
        (render-ui main <Stack direction={vertical} gap={lg}>
          <Typography.traits.TypographyRender content={(default ?row.title "")} variant={h2} />
          <AnnotatedMedia src={(default ?row.mediaUrl "")} mediaType={(if (= ?row.mediaType "video") "video" "image")} title={(default ?row.title "")} pins={[]} placing={false} />
          <Input label={(i18n/t "yourName")} value={@entity.draftName} onChange={NAME_TYPED} />
          <Input inputType={textarea} rows={4} label={(i18n/t "note")} value={@entity.draftNote} onChange={NOTE_TYPED} />
          <Stack direction={horizontal} gap={sm}>
            <Button.traits.ButtonRender action={APPROVE} icon={check} label={(i18n/t "approve")} variant={primary} />
            <Button.traits.ButtonRender action={REQUEST_CHANGES} icon={message-square} label={(i18n/t "requestChanges")} variant={secondary} />
          </Stack>
        </Stack>)
      LINK_FOUND -> open when (= ?row.status "open")
        (set @entity.openHash ?id)
        (set @entity.pendingTargetId ?row.targetId)
        (render-ui main <Stack direction={vertical} gap={lg}>
          <Typography.traits.TypographyRender content={(default ?row.title "")} variant={h2} />
          <Input label={(i18n/t "yourName")} value={@entity.draftName} onChange={NAME_TYPED} />
          <Input inputType={textarea} rows={4} label={(i18n/t "note")} value={@entity.draftNote} onChange={NOTE_TYPED} />
          <Stack direction={horizontal} gap={sm}>
            <Button.traits.ButtonRender action={APPROVE} icon={check} label={(i18n/t "approve")} variant={primary} />
            <Button.traits.ButtonRender action={REQUEST_CHANGES} icon={message-square} label={(i18n/t "requestChanges")} variant={secondary} />
          </Stack>
        </Stack>)
      LINK_FOUND -> closed
        (render-ui main <Stack direction={vertical} gap={sm}>
          <Typography.traits.TypographyRender content={(default ?row.title "")} variant={h2} />
          <Typography.traits.TypographyRender content={(if (= ?row.status "revoked") (i18n/t "revoked") (i18n/t "alreadyDecided"))} variant={body} />
        </Stack>)
      LINK_REFUSED -> closed when (= ?code "expired")
        (render-ui main <Stack direction={vertical} gap={sm}>
          <Typography.traits.TypographyRender content={(i18n/t "expired")} variant={body} />
        </Stack>)
      LINK_REFUSED -> closed
        (render-ui main <Stack direction={vertical} gap={sm}>
          <Typography.traits.TypographyRender content={(i18n/t "notFound")} variant={h3} />
        </Stack>)
    }

    state open {
      INIT -> opening
        (emit LINK_TOKEN_RESOLVE { key: "review", token: (default ?token "") })
      NAME_TYPED -> open
        (set @entity.draftName (default ?value ""))
      NOTE_TYPED -> open
        (set @entity.draftNote (default ?value ""))
      APPROVE -> deciding when (validate/required @entity.draftName)
        (persist update ReviewLink { id: @entity.openHash, status: "approved", reviewerName: @entity.draftName, decisionNote: @entity.draftNote, decidedAt: @now } {
          emit: { failure: DecisionFailed, success: DecisionSaved }
        })
      REQUEST_CHANGES -> deciding when (and (validate/required @entity.draftName) (validate/required @entity.draftNote))
        (persist update ReviewLink { id: @entity.openHash, status: "changes-requested", reviewerName: @entity.draftName, decisionNote: @entity.draftNote, decidedAt: @now } {
          emit: { failure: DecisionFailed, success: DecisionSaved }
        })
      APPROVE -> open
        (notify warning (i18n/t "nameRequired"))
      REQUEST_CHANGES -> open
        (notify warning (i18n/t "noteRequired"))
    }

    state deciding {
      INIT -> opening
        (emit LINK_TOKEN_RESOLVE { key: "review", token: (default ?token "") })
      DecisionSaved -> closed
        (emit LINK_DECIDED { targetId: @entity.pendingTargetId, decision: (default ?status ""), reviewerName: @entity.draftName, note: @entity.draftNote })
        (render-ui main <Stack direction={vertical} gap={sm}>
          <Typography.traits.TypographyRender content={(i18n/t "thanks")} variant={h3} />
        </Stack>)
      DecisionFailed -> open
        (notify error (i18n/t "saveFailed"))
    }

    state closed {
      INIT -> opening
        (emit LINK_TOKEN_RESOLVE { key: "review", token: (default ?token "") })
    }

    emits {
      LINK_DECIDED -> external {
        targetId : string!
        decision : string!
        reviewerName : string!
        note : string
      }
        @description "A reviewer with a link approved the item or asked for changes."
        @synonyms "client approved, sign-off received, changes requested"
        @tier "primary"
      LINK_TOKEN_RESOLVE -> external {
        key : string!
        token : string!
      }
        @description "Internal: asks LinkResolve for the link the route token names."
        @tier "internal"
      DecisionSaved {
        id : string
        status : string
      }
        @tier "internal"
      DecisionFailed {
        error : string
        code : string
      }
        @tier "internal"
    }

    listens {
      INIT {
        token : string
      }
        @description "Open the review behind a link (route param)."
        @tier "presentation"
      NAME_TYPED {
        value : string
      }
        @tier "presentation"
      NOTE_TYPED {
        value : string
      }
        @tier "presentation"
      APPROVE
        @description "Approve the item."
        @tier "presentation"
      REQUEST_CHANGES
        @description "Ask for changes, with a note."
        @tier "presentation"
      LINK_FOUND {
        key : string!
        id : string!
        row : ReviewLink
      }
        @tier "internal"
      LINK_REFUSED {
        key : string!
        code : string!
        message : string!
        token : string
      }
        @tier "internal"
      LinkResolve.TOKEN_RESOLVED -> LINK_FOUND
      LinkResolve.TOKEN_REFUSED -> LINK_REFUSED
      DecisionSaved {
        id : string
        status : string
      }
        @tier "internal"
      DecisionFailed {
        error : string
        code : string
      }
        @tier "internal"
    }
  }

  ;; The link's token: minted for the issuer, resolved for the guest, never stored.
  trait LinkMint = Opaque.traits.OpaqueTokenMint {
    config {
      tokenEntity: ReviewLink
      expiresAtField: expiresAt
    }
    listens {
      MINT_TOKEN {
        key : string
        fields : [ReviewLinkField]!
        ttlMs : number
      }
      ReviewLinkIssuer.LINK_TOKEN_MINT -> MINT_TOKEN
      TOKEN_DRAWN {
        value : string!
      }
      TOKEN_DRAW_FAILED {
        error : string!
      }
      TOKEN_SAVED {
        id : string!
      }
      TOKEN_NOT_SAVED {
        error : string!
        code : string
      }
    }
  }

  trait LinkResolve = Opaque.traits.OpaqueTokenResolve {
    config {
      tokenEntity: ReviewLink
      expiresAtField: expiresAt
      singleUse: false
    }
    listens {
      RESOLVE_TOKEN {
        key : string
        token : string!
      }
      ReviewLinkGuest.LINK_TOKEN_RESOLVE -> RESOLVE_TOKEN
      TOKEN_ROW_FOUND {
        data : ReviewLink!
      }
      TOKEN_ROW_ABSENT {
        error : string
        code : string
      }
      TOKEN_SPENT {
        id : string!
        expiresAt : instant
      }
      TOKEN_ROW_CLAIMED {
        data : ReviewLink!
      }
      TOKEN_NOT_SPENT {
        error : string
        code : string
      }
    }
  }

  page "/review-link/:token" as ReviewLinkPage -> ReviewLinkGuest, ReviewLinkIssuer, LinkMint, LinkResolve [access: public]
}
