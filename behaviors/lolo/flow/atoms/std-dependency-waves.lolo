app std-dependency-waves [
  version: "1.0.0",
  description: "std-dependency-waves — the publish order and parallel waves of a dependency graph, as data. WAVES_REQUEST carries nodes { name, deps }; a dep naming no node is ignored. WAVES_ANSWERED returns order (every node after each of its deps, ties by name) and waves (a node sits one wave after its deepest dep, so a wave's nodes can run at once; names sorted). A dependency cycle answers WAVES_CYCLE instead, one entry per cycle, its members sorted and joined by ' <-> '. Levels settle in one round per node; a level that reaches the node count means a cycle. An acyclic graph closes reach in one pass in level order. A cyclic one names its cycles by repeated forward-colour and backward-search passes over index arrays (strongly connected components of two or more nodes, no recursion), at most one pass per node. No cap on path length or node count."
]
uses Spec from "almadar-std/dependency-waves"
;; @capabilities "dependency order, topological waves, publish waves, cycle refusal, build order, parallel stages"

type WaveNode = { name : string!, deps : [string]! }
type WaveSortKey = { k : string!, v : string! }
type WaveSortKeys = [WaveSortKey]
type WaveReach = Map string [string]
type WaveLevel = Map string number
type WaveStrings = [string]

orbital DependencyWavesOrbital {
  entity WavesRun [runtime] {
    id : string!
    order : [string] = []
    waves : [[string]] = []
    cycles : [string] = []
    reach : Map string [string]
  }

  trait Waves -> WavesRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      WAVES_REQUEST -> ready
        (let ((names (array/map @payload.nodes (fn n (object/get @n "name")))) (emptyReach : WaveReach {}) (emptyLevel : WaveLevel {}))
          (let ((deps (array/reduce @payload.nodes @emptyReach (fn (acc n) (object/set @acc (object/get @n "name") (array/filter (object/get @n "deps") (fn d (array/includes @names @d))))))))
            (let ((idx (array/reduce (array/range 0 (array/len @names)) @emptyLevel (fn (acc i) (object/set @acc (default (array/nth @names @i) "") @i)))))
              (let ((dix (array/map @payload.nodes (fn nd (array/map (array/filter (object/get @nd "deps") (fn d (object/has @idx @d))) (fn d (object/get @idx @d)))))))
                (let ((lv (array/reduce (array/range 0 (array/len @names)) (array/map @names (fn x 0)) (fn (cur r) (array/map @dix (fn ds (array/reduce @ds 0 (fn (m j) (math/max @m (+ (default (array/nth @cur @j) 0) 1))))))))))
                  (let ((top (array/reduce @lv 0 (fn (m l) (math/max @m @l)))))
                    (let ((cyclic (>= @top (array/len @names)))
                          (recs (array/sort (array/map (array/range 0 (array/len @names)) (fn i { k: (let ((t (str/concat "000000" (default (array/nth @lv @i) 0)))) (str/concat (str/slice @t (- (str/len @t) 6) (str/len @t)) "|" (default (array/nth @names @i) ""))), v: (default (array/nth @names @i) ""), l: (default (array/nth @lv @i) 0) })) "k" "asc")))
                      (let ((sorted (array/map @recs (fn s (object/get @s "v")))))
                        (let ((reach (if @cyclic
                                       @emptyReach
                                       (array/reduce @sorted @emptyReach (fn (acc x) (object/set @acc @x (array/unique (array/concat (object/get @deps @x []) (array/flatten (array/map (object/get @deps @x []) (fn d (object/get @acc @d []))))))))))))
                          (let ((keys (if @cyclic (let ((cons (array/map (array/range 0 (array/len @names)) (fn i (array/filter (array/range 0 (array/len @names)) (fn j (array/includes (default (array/nth @dix @j) []) @i)))))))
                              (let ((asg (array/reduce (array/range 0 (array/len @names)) (array/map (array/range 0 (array/len @names)) (fn i (- 0 1))) (fn (a o) (if (not (array/some @a (fn x (< @x 0)))) @a
                                (let ((col (array/reduce (array/range 0 (array/len @names)) (array/map (array/range 0 (array/len @names)) (fn i (if (< (default (array/nth @a @i) 0) 0) @i (- 0 1)))) (fn (c r) (array/map (array/range 0 (array/len @names)) (fn i (if (< (default (array/nth @a @i) 0) 0) (array/reduce (default (array/nth @cons @i) []) @i (fn (m j) (math/max @m (default (array/nth @c @j) 0)))) (- 0 1))))))))
                                  (let ((mem (array/reduce (array/range 0 (array/len @names)) (array/map (array/range 0 (array/len @names)) (fn i (if (= (default (array/nth @col @i) 0) @i) @i (- 0 1)))) (fn (mm r) (array/map (array/range 0 (array/len @names)) (fn v (if (>= (default (array/nth @mm @v) 0) 0) (default (array/nth @mm @v) 0) (if (and (< (default (array/nth @a @v) 0) 0) (array/some (default (array/nth @dix @v) []) (fn d (and (>= (default (array/nth @col @d) 0) 0) (= (default (array/nth @col @d) 0) (default (array/nth @col @v) 0)) (= (default (array/nth @mm @d) 0) (default (array/nth @col @v) 0)))))) (default (array/nth @col @v) 0) (- 0 1)))))))))
                                    (array/map (array/range 0 (array/len @names)) (fn v (if (>= (default (array/nth @a @v) 0) 0) (default (array/nth @a @v) 0) (default (array/nth @mem @v) 0)))))))))))
                                (array/unique (array/map (array/filter (array/map (array/filter (array/range 0 (array/len @names)) (fn r (= (default (array/nth @asg @r) 0) @r))) (fn r (array/filter (array/range 0 (array/len @names)) (fn v (= (default (array/nth @asg @v) 0) @r))))) (fn g (>= (array/len @g) 2))) (fn g (str/join (array/map (array/sort (array/map @g (fn v { k: (default (array/nth @names @v) ""), v: (default (array/nth @names @v) "") })) "k" "asc") (fn s (object/get @s "v"))) " <-> ")))))) [])))
                              (do
                                (set @entity.reach @reach)
                                (set @entity.cycles (array/map (array/sort (array/map @keys (fn s { k: @s, v: @s })) "k" "asc") (fn s (object/get @s "v"))))
                                (set @entity.order @sorted)
                                (set @entity.waves (array/map (array/range 0 (+ (if @cyclic 0 @top) 1)) (fn w (array/map (array/filter @recs (fn r (= (object/get @r "l") @w))) (fn r (object/get @r "v"))))))
                                (emit WAVES_COMPUTED { cycles: (array/len @entity.cycles) }))))))))))))
      WAVES_COMPUTED -> ready when (> (array/len @entity.cycles) 0)
        (emit WAVES_CYCLE { cycles: @entity.cycles })
      WAVES_COMPUTED -> ready when (= (array/len @entity.cycles) 0)
        (emit WAVES_ANSWERED { order: @entity.order, waves: @entity.waves, reach: @entity.reach })
    }

    emits {
      WAVES_COMPUTED -> internal { cycles : number! }
      WAVES_ANSWERED -> external { order : [string]!, waves : [[string]]!, reach : Map string [string]! }
        @description "The nodes in dependency order and their parallel waves."
        @tier "domain"
      WAVES_CYCLE -> external { cycles : [string]! }
        @description "The dependency cycles refused: each lists its sorted members joined by ' <-> '."
        @tier "domain"
    }

    listens {
      WAVES_REQUEST -> input { nodes : [WaveNode]! }
        @description "Order a dependency graph and group it into parallel waves."
        @synonyms "dependency waves, publish order, topological sort, build order, cycle check"
    }
  }

  page boot as DependencyWavesOrbitalStart -> Waves
}
