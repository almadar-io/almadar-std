app std-mod-queue [
  version: "1.0.0",
  description: "std-mod-queue — moderation queue for content review. Owns a ModQueueItem entity (one row per flagged target) and a single review trait that loads pending items, renders them in a data-grid with Approve / Reject / Escalate actions, and persists the reviewer's verdict back to the row."
]
type ItemAction = { label : string!, event : event, navigatesTo : string, variant : primary | secondary | ghost | danger, icon : string, roles : [string], when : SExpr }
orbital ModQueueItemOrbital {
    uses Spinner from "std/behaviors/ui-spinner"
    uses Typography from "std/behaviors/ui-typography"
    uses Icon from "std/behaviors/ui-icon"
    uses Button from "std/behaviors/ui-button"
    uses Divider from "std/behaviors/ui-divider"
    uses Alert from "std/behaviors/ui-alert"

    type ModQueueItemLoaded = Event { data : [ModQueueItem]!, totalCount : number } "Fired when a page of the moderation queue finishes loading"

    type ModQueueEscalationScanned = Event { data : [ModQueueItem]!, totalCount : number } "Fired when the scan for pending items over the auto-escalate threshold finishes"

    type ModQueueItemLoadFailed = Event { error : string, code : string } "Fired when the moderation queue collection fails to load"

    type ModQueueItemReviewed = Event ModQueueItem "Fired after a queue row's status persists (approve / reject / escalate)"

    type ModQueueItemReviewFailed = Event { error : string, code : string } "Fired when a queue row's status update fails to persist"

  entity ModQueueItem [persistent: modqueueitems] {
    id : string!
    targetId : string! @description "Unique identifier for the item being moderated." @synonyms "item id, reference id, identifier"
    targetType : string! @description "Specifies the kind of item being moderated." @synonyms "item type, content type, object type"
    reason : "spam" | "abuse" | "off-topic" | "misinformation" | "nsfw" | "other" @description "The justification for flagging the content." @synonyms "flag reason, justification, cause"
    flagCount : number @description "The number of times this item has been flagged." @synonyms "flags, flag_count, count"
    status : "pending" | "approved" | "rejected" | "escalated" @description "Current state of the moderation item." @synonyms "state, condition, stage" = pending
    reviewedBy : string @description "The user who performed the review action." @synonyms "reviewer, reviewerId, assignedTo"
    reviewedAt : datetime @description "Timestamp indicating when the item was last reviewed." @synonyms "review date, review time, last reviewed"
    notes : string @description "Free-text comments or observations related to the item." @synonyms "comment, remark, observation, details"
    page : number @intrinsic @description "The page the list shows." = 1
    seedRow : ModQueueItem @intrinsic @description "The row an edit-mode modal pre-fills from when its payload carries no row (a scalar-only action event still opens a fully seeded form)."
  }

  trait LoadingSpinner = Spinner.traits.SpinnerRender -> ModQueueItem {
    config {}
  }

  trait ErrorSpinner = Spinner.traits.SpinnerRender -> ModQueueItem {
    config {
      size: sm
    }
  }

  trait LoadingText = Typography.traits.TypographyRender -> ModQueueItem {
    config {
      color: muted
      content: "Loading moderation queue…"
      variant: caption
    }
  }

  trait ShieldAlertIcon = Icon.traits.IconRender -> ModQueueItem {
    config {
      name: shield-alert
    }
  }

  trait ModQueueTitle = Typography.traits.TypographyRender -> ModQueueItem {
    config {
      content: @config.title
      variant: h3
    }
  }

  trait CloseButton = Button.traits.ButtonRender -> ModQueueItem [server] {
    config {
      action: CLOSE
      icon: x
      label: Close
      variant: ghost
    }
  }

  trait ModQueueDivider = Divider.traits.DividerRender -> ModQueueItem {
    config {}
  }

  trait ErrorAlert = Alert.traits.AlertRender -> ModQueueItem {
    config {
      message: ?error
      variant: error
    }
  }

  trait ModQueueItemReview -> ModQueueItem {
    initial: idle

    state idle {
      INIT -> idle
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
      ModQueueItemLoaded -> idle
      ModQueueItemLoadFailed -> idle
        (notify error (str/concat "Couldn't load the moderation queue — " ?error))
      OPEN -> loading when @config.enabled
        (fetch ModQueueItem {
          filter: (and (= (object/get @entity status) pending) (>= (object/get @entity flagCount) @config.autoEscalateThreshold))
          limit: @config.batchSize
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueEscalationScanned }
        })
        (render-ui @config.reviewSlot {
          align: center
          children: [@trait.LoadingSpinner, @trait.LoadingText]
          className: py-12
          direction: vertical
          gap: md
          type: stack
        })
    }

    state loading {
      INIT -> idle
        (render-ui @config.reviewSlot null)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
      ModQueueEscalationScanned -> loading when (> (array/len ?data) 0)
        (set @entity.id (object/get (array/first ?data) id))
        (persist update ModQueueItem { id: @entity.id, status: escalated } {
          emit: { failure: ModQueueItemReviewFailed, success: ModQueueItemReviewed }
        })
      ModQueueEscalationScanned -> loading when (= (array/len ?data) 0)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
      ModQueueItemReviewed -> loading
        (fetch ModQueueItem {
          filter: (and (= (object/get @entity status) pending) (>= (object/get @entity flagCount) @config.autoEscalateThreshold))
          limit: @config.batchSize
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueEscalationScanned }
        })
      ModQueueItemReviewFailed -> error
        (render-ui @config.reviewSlot {
          children: [@trait.ErrorAlert]
          type: stack
        })
      ModQueueItemLoaded -> reviewing
        (render-ui @config.reviewSlot {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldAlertIcon, @trait.ModQueueTitle]
              direction: horizontal
              gap: sm
              type: stack
            }, @trait.CloseButton]
            direction: horizontal
            gap: sm
            justify: between
            type: stack
          }, @trait.ModQueueDivider, {
            cols: 1
            entity: ?data
            fields: [{
              label: Type
              name: targetType
              variant: badge
            }, {
              label: Reason
              name: reason
              variant: caption
            }, {
              label: Flags
              name: flagCount
              variant: caption
            }, {
              label: Status
              name: status
              variant: badge
            }]
            gap: sm
            itemActions: (array/filter @config.itemActions (fn action (or (= (array/len (object/get @action roles [])) 0) (array/includes (object/get @action roles []) @config.viewerRole))))
            look: @config.tableLook
            type: data-grid
          }, {
            currentPage: @entity.page
            pageChangeEvent: REFETCH_PAGE
            showPageSize: false
            totalPages: (math/max 1 (math/ceil (/ ?totalCount @config.pageSize)))
            type: pagination
          }]
          direction: vertical
          gap: md
          type: stack
        })
      ModQueueItemLoadFailed -> error
        (render-ui @config.reviewSlot {
          children: [@trait.ErrorAlert]
          type: stack
        })
      CLOSE -> idle
        (render-ui @config.reviewSlot null)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
    }

    state reviewing {
      INIT -> idle
        (render-ui @config.reviewSlot null)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
      APPROVE -> reviewing
        (persist update ModQueueItem { id: ?row.id, status: approved } {
          emit: { failure: ModQueueItemReviewFailed, success: ModQueueItemReviewed }
        })
      REJECT -> reviewing
        (persist update ModQueueItem { id: ?row.id, status: rejected } {
          emit: { failure: ModQueueItemReviewFailed, success: ModQueueItemReviewed }
        })
      ESCALATE -> reviewing
        (persist update ModQueueItem { id: ?row.id, status: escalated } {
          emit: { failure: ModQueueItemReviewFailed, success: ModQueueItemReviewed }
        })
      ModQueueItemReviewed -> loading
        (fetch ModQueueItem {
          filter: (and (= (object/get @entity status) pending) (>= (object/get @entity flagCount) @config.autoEscalateThreshold))
          limit: @config.batchSize
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueEscalationScanned }
        })
      REFETCH_PAGE -> loading
        (set @entity.page ?page)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: (* (- ?page 1) @config.pageSize)
        })
      ModQueueItemReviewFailed -> reviewing
        (render-ui @config.reviewSlot {
          children: [@trait.ErrorAlert]
          type: stack
        })
      CLOSE -> idle
        (render-ui @config.reviewSlot null)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
    }

    state error {
      INIT -> idle
        (render-ui @config.reviewSlot null)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
      OPEN -> loading
        (fetch ModQueueItem {
          filter: (and (= (object/get @entity status) pending) (>= (object/get @entity flagCount) @config.autoEscalateThreshold))
          limit: @config.batchSize
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueEscalationScanned }
        })
        (render-ui @config.reviewSlot {
          children: [@trait.ErrorSpinner]
          type: stack
        })
      CLOSE -> idle
        (render-ui @config.reviewSlot null)
        (set @entity.page 1)
        (fetch ModQueueItem {
          emit: { failure: ModQueueItemLoadFailed, success: ModQueueItemLoaded }
          limit: @config.pageSize
          offset: 0
        })
    }

    emits {
      APPROVE {
        id : string!
        row : ModQueueItem
      }
        @description "Signals that a moderation item has been approved."
        @synonyms "accept, confirm, pass"
        @tier "domain"
      REJECT {
        id : string!
        row : ModQueueItem
      }
        @description "Signals that a moderation item has been rejected."
        @synonyms "deny, dismiss, decline"
        @tier "domain"
      ESCALATE {
        id : string!
        row : ModQueueItem
      }
        @description "Signals a flagged item requires further review."
        @synonyms "flag, defer, elevate"
        @tier "presentation"
      CLOSE
        @description "Dismisses the moderation queue overlay."
        @synonyms "dismiss, hide, cancel, done"
        @tier "domain"
      ModQueueItemLoaded {
        data : [ModQueueItem]!
        totalCount : number
      }
        @description "A page of moderation items is ready for review."
        @synonyms "loaded, fetched, available, ready"
        @tier "internal"
      ModQueueEscalationScanned {
        data : [ModQueueItem]!
        totalCount : number
      }
        @description "Internal: the pending items at or over the auto-escalate threshold."
        @tier "internal"
      ModQueueItemLoadFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load moderation queue items."
        @synonyms "error, failure, problem, failed"
        @tier "internal"
      ModQueueItemReviewed
        @description "Signals a moderation queue item has been reviewed and a verdict recorded."
        @synonyms "reviewed, processed, judged, completed"
        @tier "domain"
      ModQueueItemReviewFailed {
        error : string
        code : string
      }
        @description "Indicates a failure to load or process a moderation queue item."
        @synonyms "error, failure, problem, issue"
        @tier "internal"
    }

    listens {
      REFETCH_PAGE {
        page : number!
      }
        @description "Triggers a moderation queue page refresh."
        @synonyms "reload, refresh, update, paginate"
        @tier "domain"
      OPEN
        @description "Summons the moderation queue (host nav/affordance requests it)."
        @synonyms "open, show, review, view queue, moderation queue"
        @tier "domain"
      CLOSE
        @description "Dismisses the moderation queue overlay."
        @synonyms "dismiss, hide, cancel, done"
        @tier "domain"
      APPROVE {
        id : string!
        row : ModQueueItem
      }
        @description "Signals that a moderation item has been approved."
        @synonyms "accept, confirm, pass"
        @tier "domain"
      REJECT {
        id : string!
        row : ModQueueItem
      }
        @description "Signals a content item has been rejected during review."
        @synonyms "dismiss, deny, decline"
        @tier "domain"
      ESCALATE {
        id : string!
        row : ModQueueItem
      }
        @description "Signals a moderation item requires further review."
        @synonyms "flag, defer, elevate"
        @tier "presentation"
      ModQueueItemLoaded {
        data : [ModQueueItem]!
        totalCount : number
      }
        @description "A page of moderation items is ready for review."
        @synonyms "loaded, fetched, available, ready"
        @tier "internal"
      ModQueueEscalationScanned {
        data : [ModQueueItem]!
        totalCount : number
      }
        @description "Internal: the pending items at or over the auto-escalate threshold."
        @tier "internal"
      ModQueueItemLoadFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load a moderation queue item."
        @synonyms "error, failure, problem, issue"
        @tier "internal"
      ModQueueItemReviewed
        @description "A moderation queue item's review status has been updated."
        @synonyms "reviewed, updated, verdict, decision"
        @tier "domain"
      ModQueueItemReviewFailed {
        error : string
        code : string
      }
        @description "Indicates failure to load a moderation queue item for review."
        @synonyms "error, failure, problem, issue"
        @tier "internal"
    }

    config {
      enabled : boolean = false
        @label "Enable moderation queue"
        @description "Send submissions to a review queue before they go live. Off by default."
        @synonyms "enable, turn on, enforce, require, activate, apply, switch on, moderation, moderation queue, content review queue, flag for review, content moderation, review flagged content, abuse review, spam queue, report queue"
        @tier "policy"
      title : string = "Moderation Queue"
        @label "Section title"
        @description "Heading shown above the moderation queue"
        @tier "presentation"
      pageSize : number = 50
        @label "How many items to fetch per page?"
        @description "Moderation items fetched from the server per page request; the list's own pager loads later pages through REFETCH_PAGE."
        @synonyms "fetch limit, records per page, batch size, page limit"
        @tier "presentation"
      batchSize : number = 50
        @label "Items read per escalation pass"
        @description "Most pending items over the threshold one escalation read returns. The review escalates the first, marks it escalated so it leaves the filter, and reads again, so every one is escalated before the grid shows."
        @synonyms "escalation batch, scan limit"
        @tier "infra"
      autoEscalateThreshold : number = 5
        @label "Auto-escalate at"
        @description "Flag count after which an item is auto-escalated to senior review"
        @tier "policy"
      tableLook : "dense" | "spacious" | "striped" | "borderless" | "card-rows" = dense
        @label "Table look"
        @description "Layer 2 visual treatment for the data table rendered by this atom."
        @tier "presentation"
      reviewSlot : slot = modal
        @label "Review slot"
        @description "UI slot the moderation queue renders into. Defaults to the modal overlay so it never seizes the host's main content; summoned via OPEN, cleared via CLOSE."
        @tier "internal"
      itemActions : [ItemAction] = [{
        event: APPROVE
        icon: check
        label: Approve
        variant: primary
      }, {
        event: REJECT
        icon: x
        label: Reject
        variant: danger
      }, {
        event: ESCALATE
        icon: alert-triangle
        label: Escalate
        variant: secondary
      }]
        @label "Row actions"
        @description "Actions offered on each row; give an item `roles` to show it only to those viewer roles."
        @tier "presentation"
      viewerRole : string = ""
        @label "Viewer's role"
        @description "The signed-in viewer's role that each action's `roles` is checked against. Bind it explicitly at the call site (e.g. `viewerRole: @user.role`) in an app whose identity carries a role; left empty, only actions with no `roles` show."
        @tier "policy"
    }
  }

  page "/modqueueitems/review" as ModQueueItemReviewPage -> ModQueueItemReview
}