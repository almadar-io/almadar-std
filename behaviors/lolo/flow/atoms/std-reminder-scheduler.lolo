app std-reminder-scheduler [
  version: "1.2.0",
  description: "std-reminder-scheduler — scheduled rules over a target entity: deadline reminders by default, or threshold rules (`rule: threshold`: a field, optionally as a percentage of another, at least or at most a value, or a list that is not empty) so data that arrived without an event (seeded, imported) still fires the same alerts once. Deadline reminders: A periodic tick scans the target for records whose `dateField` deadline (an instant) is within `offsetHours` of now and that have not been reminded yet, and emits `ReminderDue` for each — every matching record, via a self-driving scan loop. `direction` picks which side of now the scan matches: 'future' (default) fires for deadlines up to `offsetHours` ahead; 'past' fires once a record's date is at least `offsetHours` behind now. `matches` restricts the scan to records whose named fields equal the given values. Marks each record's `markField` (default `remindedAt`; one field per rule) so it isn't reminded twice — and only when the record actually matched the scan, so records outside the window stay eligible for later passes. A failed scan or dedup write answers ReminderScanFailed { message }. Compose alongside std-notify-on-event to deliver the reminder."
]
orbital ReminderSchedulerOrbital {
    type ScanRecordsLoaded = Event { data : [@entity @config.targetEntity]! } "Internal: target records due for a reminder."

    type ScanFailed = Event { error : string, code : string } "Internal: scan fetch / persist failed."

    type ReminderStepped = Event { id : string } "Internal: one record reminded; drives the next loop pass."

    type ReminderMatch = { field : string!, value : string! }

    type ReminderDue = Event { entityId : string, severity : string, template : string, row : @entity @config.targetEntity } "Re-emitted per record that is due (its row rides along); wire to std-notify-on-event or the app's router."

  entity ReminderRunLog [persistent: reminder_runs] {
    @create none "A substrate atom: the composing program decides who reaches the trait that writes these rows, so this atom states no creator of its own."
    @read none "This program declares no identity entity, so it has no signed-in viewer to scope reads to: every visitor may read these rows."
    id : string!
    targetEntity : string @description "The entity to which the reminder applies." @synonyms "subject, referenced entity, related object" = ""
    recordCount : number @description "The number of records processed during this run." @synonyms "count, total, size" = 0
    ranAt : instant @description "Timestamp indicating when the process was executed." @synonyms "execution time, timestamp, run time" = "1970-01-01T00:00:00Z"
    errors : string @description "Records any errors encountered during processing." @synonyms "error, problem, fault" = ""
    dueAt : instant @description "Deadline timestamp (also lets the standalone default target validate)." @synonyms "deadline, due, expiry" = "1970-01-01T00:00:00Z"
    remindedAt : instant @description "When this record was last reminded — the dedup marker; absent = not yet reminded." @synonyms "notified at, last reminder"
    headId : string @description "Scratch: id of the record the scan loop is currently reminding." @synonyms "current id, cursor" = ""
  }

  trait ReminderScheduler -> @rebindable ReminderRunLog {
    initial: idle

    state idle {
      INIT -> idle
      ScanRecordsLoaded -> scanning when (and @config.enabled (> (array/len ?data) 0))
        (set @entity.headId (object/get (array/first ?data) id))
        (emit ReminderDue {
          entityId: @entity.headId
          severity: @config.severity
          template: @config.template
          row: (array/first ?data)
        })
        (persist update @config.targetEntity (object/set { id: @entity.headId } @config.markField @now) {
          emit: { failure: ScanFailed, success: ReminderStepped }
        })
      ScanRecordsLoaded -> idle when (= (array/len ?data) 0)
      ;; A disabled scan acknowledges the batch without marking anything —
      ;; the dedup write fires only for a record that actually matched.
      ScanRecordsLoaded -> idle when (= @config.enabled false)
      ScanFailed -> idle
        (emit ReminderScanFailed { message: (if (validate/required ?error) (str/concat "Couldn't scan for reminders — " ?error) "Couldn't scan for reminders") })
    }

    state scanning {
      INIT -> idle
      ReminderStepped -> scanning
        (fetch @config.targetEntity {
          emit: { failure: ScanFailed, success: ScanRecordsLoaded }
          filter: (and (== (object/get @entity @config.markField) null) (array/every @config.matches (fn m (= (object/get @entity @m.field) @m.value))) (if (= @config.rule "threshold") (or (and (= @config.guardOp "present") (> (array/len (default (object/get @entity @config.guardField) [])) 0)) (and (= @config.guardOp "gte") (>= (let ((part (default (object/get @entity @config.guardField) 0)) (whole (default (object/get @entity @config.divisorField) 0))) (if (= @config.divisorField "") @part (if (> @whole 0) (* (/ @part @whole) 100) 0))) @config.guardValue)) (and (= @config.guardOp "lte") (<= (let ((part (default (object/get @entity @config.guardField) 0)) (whole (default (object/get @entity @config.divisorField) 0))) (if (= @config.divisorField "") @part (if (> @whole 0) (* (/ @part @whole) 100) 0))) @config.guardValue))) (and (validate/required (object/get @entity @config.dateField)) (or (and (= @config.direction "future") (time/isAfter (time/toInstant (object/get @entity @config.dateField)) @now) (time/isBefore (time/toInstant (object/get @entity @config.dateField)) (time/add @now @config.offsetHours "hour"))) (and (= @config.direction "past") (time/isBefore (time/toInstant (object/get @entity @config.dateField)) (time/subtract @now @config.offsetHours "hour")))))))
          limit: 1
        })
      ScanRecordsLoaded -> scanning when (> (array/len ?data) 0)
        (set @entity.headId (object/get (array/first ?data) id))
        (emit ReminderDue {
          entityId: @entity.headId
          severity: @config.severity
          template: @config.template
          row: (array/first ?data)
        })
        (persist update @config.targetEntity (object/set { id: @entity.headId } @config.markField @now) {
          emit: { failure: ScanFailed, success: ReminderStepped }
        })
      ScanRecordsLoaded -> idle when (= (array/len ?data) 0)
      ScanFailed -> idle
        (emit ReminderScanFailed { message: (if (validate/required ?error) (str/concat "Couldn't scan for reminders — " ?error) "Couldn't scan for reminders") })
    }

    emits {
      ReminderDue -> external {
        entityId : string
        severity : string
        template : string
        row : @entity @config.targetEntity
      }
      ReminderScanFailed -> external {
        message : string!
      }
        @description "The scan or its dedup write failed; the scan runs in the background with no viewer, so route this to whoever should hear it."
      ScanRecordsLoaded {
        data : [@entity @config.targetEntity]!
      }
      ScanFailed {
        error : string
        code : string
      }
      ReminderStepped {
        id : string
      }
    }

    listens {
      ScanRecordsLoaded {
        data : [@entity @config.targetEntity]!
      }
      ScanFailed {
        error : string
        code : string
      }
      ReminderStepped {
        id : string
      }
    }

    ticks {
      scanCycle every "*/15 * * * *" [background]
        (fetch @config.targetEntity {
          emit: { failure: ScanFailed, success: ScanRecordsLoaded }
          filter: (and (== (object/get @entity @config.markField) null) (array/every @config.matches (fn m (= (object/get @entity @m.field) @m.value))) (if (= @config.rule "threshold") (or (and (= @config.guardOp "present") (> (array/len (default (object/get @entity @config.guardField) [])) 0)) (and (= @config.guardOp "gte") (>= (let ((part (default (object/get @entity @config.guardField) 0)) (whole (default (object/get @entity @config.divisorField) 0))) (if (= @config.divisorField "") @part (if (> @whole 0) (* (/ @part @whole) 100) 0))) @config.guardValue)) (and (= @config.guardOp "lte") (<= (let ((part (default (object/get @entity @config.guardField) 0)) (whole (default (object/get @entity @config.divisorField) 0))) (if (= @config.divisorField "") @part (if (> @whole 0) (* (/ @part @whole) 100) 0))) @config.guardValue))) (and (validate/required (object/get @entity @config.dateField)) (or (and (= @config.direction "future") (time/isAfter (time/toInstant (object/get @entity @config.dateField)) @now) (time/isBefore (time/toInstant (object/get @entity @config.dateField)) (time/add @now @config.offsetHours "hour"))) (and (= @config.direction "past") (time/isBefore (time/toInstant (object/get @entity @config.dateField)) (time/subtract @now @config.offsetHours "hour")))))))
          limit: 1
        })
      
    }

    config {
      enabled : boolean = false
        @label "Send deadline reminders"
        @description "Automatically remind about upcoming deadlines. Off by default."
        @synonyms "enable, turn on, activate, switch on, reminders, deadline reminders, due-date reminders, advance notice, heads up, nudge before due"
        @tier "infra"
      targetEntity : entity = ReminderRunLog
        @label "Target entity"
        @description "Entity to scan for upcoming deadlines (e.g. 'Task', 'ClassSession'). Defaults to the atom's own log so the standalone validates; rebind per composition. Typed `entity`, so a rename of the bound entity threads through to this value automatically."
        @synonyms "entity to monitor, entity to watch, record type, object type"
        @tier "internal"
      dateField : string = dueAt
        @label "Which date field is the deadline?"
        @description "Field on the target entity holding the deadline (e.g. 'dueAt', 'startsAt'). Holds an instant (ISO datetime)."
        @synonyms "due date field, timestamp field, cutoff field, expiry field, when it's due"
        @tier "internal"
      offsetHours : number = 24
        @label "How many hours before the deadline to remind?"
        @description "A reminder fires once the deadline is within this many hours of now."
        @synonyms "advance notice, lead time, heads up, early warning hours, how far ahead"
        @tier "infra"
      direction : "future" | "past" = "future"
        @label "Scan which side of now?"
        @description "'future' (default) matches records whose dateField is still ahead, up to offsetHours out — upcoming-deadline reminders. 'past' matches records whose dateField is at least offsetHours behind now — act-after-the-fact policies. The emitted event and the dedup marker are identical either way."
        @synonyms "direction, past due, overdue, after the deadline, look back, backward scan, past-window"
        @tier "infra"
      matches : [ReminderMatch] = []
        @label "Only records where"
        @description "Field/value pairs a record must equal to be scanned at all (empty = every record), e.g. channel = linkedin and status = published. A record that does not match is never reminded nor marked."
        @synonyms "only when, where, filter, restrict to, only records with"
        @tier "infra"
      rule : "deadline" | "threshold" = deadline
        @label "What makes a record due?"
        @description "deadline (default): its dateField falls in the offsetHours window. threshold: its guardField passes guardOp against guardValue (as a percentage of divisorField when one is named), such as a budget past 90% of its hours; guardOp present matches a non-empty list, such as a message that mentions people."
        @synonyms "rule, condition, trigger kind"
      guardField : string = ""
        @label "Which field is measured?"
        @description "For a threshold rule: the field compared, such as usedHours, or the list checked by present."
        @synonyms "measured field, value field"
      divisorField : string = ""
        @label "Measured as a percentage of which field?"
        @description "For a threshold rule: when named, the measure is guardField divided by this field, times 100 (a record whose divisor is 0 or missing measures 0); blank compares guardField itself."
        @synonyms "total field, limit field, out of"
      guardOp : "gte" | "lte" | "present" = gte
        @label "How is it compared?"
        @description "gte: at least guardValue; lte: at most guardValue; present: the guardField list is not empty."
        @synonyms "comparison, operator"
      guardValue : number = 0
        @label "Against what value?"
        @description "The threshold the measure is compared with, such as 90 for 90%."
        @synonyms "threshold, limit"
      markField : string = remindedAt
        @label "Which field marks a record as done?"
        @description "The record field the scan stamps with the time once it fires, so a record fires once per rule; give each rule over one entity its own field (alerted90At, alerted100At) so every threshold fires once."
        @synonyms "dedup field, fired at, reminded at"
      severity : string = info
        @label "How urgent are the reminders?"
        @description "Severity passed to the notifier: info / warning / error."
        @synonyms "urgency level, priority, importance, alert level, how urgent"
        @tier "infra"
      template : string = ""
        @label "What should the reminder message say?"
        @description "Message body passed to the notifier."
        @synonyms "message text, reminder body, notification copy, alert message, what to say"
        @tier "presentation"
    }
  }

  page boot as ReminderSchedulerStart -> ReminderScheduler
}