app std-lifecycle [
  version: "1.2.0",
  description: "std-lifecycle — age-based status lifecycle for a target entity. A periodic tick scans the target for records in `fromStatus` whose `dateField` is older than `ageDays`, and transitions each one to `toStatus` — every matching record, via a self-driving scan loop (process the head of a filtered fetch, persist the status, re-fetch until the set drains). With `action: delete` the same scan removes each aged record instead of changing its status (retention): `fromStatus` then narrows by `statusField` when set, and a record whose `dateField` is 0 is never aged. Compose onto any orbital and bind `targetEntity` + the status/date knobs."
]
uses Spec from "almadar-std/lifecycle"

orbital LifecycleOrbital {
    type ScanRecordsLoaded = Event { data : [@entity @config.targetEntity]! } "Internal: target records matching the lifecycle filter."

    type ScanFailed = Event { error : string, code : string } "Internal: scan fetch / persist failed."

    type LifecycleDeleted = Event { entityId : string } "Re-emitted per record as it is deleted by the delete action; rename to wire downstream listeners."

    type LifecycleStepped = Event { id : string } "Internal: one record transitioned; drives the next loop pass."

    type LifecycleTransitioned = Event { entityId : string, status : string } "Re-emitted per record as it transitions; rename to wire downstream listeners."

  entity LifecycleRunLog [persistent: lifecycle_runs] {
    id : string!
    targetEntity : string @description "The entity to which lifecycle rules apply." @synonyms "subject, reference, target" = ""
    recordCount : number @description "The number of records processed." @synonyms "count, size, quantity" = 0
    ranAt : number @description "Timestamp indicating when the lifecycle run occurred." @synonyms "timestamp, execution time, run time" = 0
    errors : string @description "A textual description of any errors encountered." @synonyms "error message, problem, issue, fault" = ""
    status : string @description "Lifecycle status (also lets the standalone default target validate)." @synonyms "state, stage" = ""
    headId : string @description "Scratch: id of the record the scan loop is currently transitioning." @synonyms "current id, cursor" = ""
    headStatus : string @description "Scratch: the status applied to the current record." @synonyms "new status, to status" = ""
  }

  trait LifecycleScheduler -> @rebindable LifecycleRunLog {
    initial: idle

    state idle {
      INIT -> idle
      ScanRecordsLoaded -> idle when (and @config.enabled @config.dryRun (= @config.action "status") (> (array/len ?data) 0))
        (notify info (str/concat "Dry run — " (array/len ?data) " record(s) would transition, nothing was written."))
      ScanRecordsLoaded -> scanning when (and @config.enabled (not @config.dryRun) (= @config.action "status") (> (array/len ?data) 0))
        @ensures (= @entity.headStatus @config.toStatus)
        (set @entity.headId (object/get (array/first ?data) id))
        (set @entity.headStatus @config.toStatus)
        (emit LifecycleTransitioned { entityId: @entity.headId, status: @entity.headStatus })
        (persist update @config.targetEntity { id: @entity.headId, status: @entity.headStatus } {
          emit: { failure: ScanFailed, success: LifecycleStepped }
        })
      ScanRecordsLoaded -> idle when (and @config.enabled @config.dryRun (= @config.action "delete") (> @config.ageDays 0) (> (array/len ?data) 0))
        (notify info (str/concat "Dry run — " (array/len ?data) " record(s) would be deleted, nothing was deleted."))
      ScanRecordsLoaded -> scanning when (and @config.enabled (not @config.dryRun) (= @config.action "delete") (> @config.ageDays 0) (> (array/len ?data) 0))
        (set @entity.headId (object/get (array/first ?data) id))
        (emit LifecycleDeleted { entityId: @entity.headId })
        (persist delete @config.targetEntity @entity.headId {
          emit: { failure: ScanFailed, success: LifecycleStepped }
        })
      ScanRecordsLoaded -> idle when (= (array/len ?data) 0)
      ScanFailed -> idle
        (notify error (str/concat "Couldn't scan for lifecycle transitions — " ?error))
    }

    state scanning {
      INIT -> scanning
      LifecycleStepped -> scanning
        (if (= @config.action "delete")
          (fetch @config.targetEntity {
            emit: { failure: ScanFailed, success: ScanRecordsLoaded }
            filter: (and (or (= @config.fromStatus "") (= (object/get @entity @config.statusField) @config.fromStatus)) (> (object/get @entity @config.dateField) 0) (< (object/get @entity @config.dateField) (- @now (* @config.ageDays 86400000))))
          })
          (fetch @config.targetEntity {
            emit: { failure: ScanFailed, success: ScanRecordsLoaded }
            filter: (and (= (object/get @entity status) @config.fromStatus) (< (object/get @entity @config.dateField) (- @now (* @config.ageDays 86400000))))
          }))
      ScanRecordsLoaded -> scanning when (and (= @config.action "status") (> (array/len ?data) 0))
        @ensures (= @entity.headStatus @config.toStatus)
        (set @entity.headId (object/get (array/first ?data) id))
        (set @entity.headStatus @config.toStatus)
        (emit LifecycleTransitioned { entityId: @entity.headId, status: @entity.headStatus })
        (persist update @config.targetEntity { id: @entity.headId, status: @entity.headStatus } {
          emit: { failure: ScanFailed, success: LifecycleStepped }
        })
      ScanRecordsLoaded -> scanning when (and (= @config.action "delete") (> (array/len ?data) 0))
        (set @entity.headId (object/get (array/first ?data) id))
        (emit LifecycleDeleted { entityId: @entity.headId })
        (persist delete @config.targetEntity @entity.headId {
          emit: { failure: ScanFailed, success: LifecycleStepped }
        })
      ScanRecordsLoaded -> idle when (= (array/len ?data) 0)
      ScanFailed -> idle
        (notify error (str/concat "Couldn't scan for lifecycle transitions — " ?error))
    }

    emits {
      LifecycleTransitioned -> external {
        entityId : string
        status : string
      }
      LifecycleDeleted -> external {
        entityId : string
      }
      ScanRecordsLoaded {
        data : [@entity @config.targetEntity]!
      }
      ScanFailed {
        error : string
        code : string
      }
      LifecycleStepped {
        id : string
      }
    }

    listens {
      ScanRecordsLoaded {
        data : [@entity @config.targetEntity]!
      }
      ScanFailed {
        error : string
        code : string
      }
      LifecycleStepped {
        id : string
      }
    }

    ticks {
      scanCycle every "0 * * * *" [background]
        (if (= @config.action "delete")
          (fetch @config.targetEntity {
            emit: { failure: ScanFailed, success: ScanRecordsLoaded }
            filter: (and (or (= @config.fromStatus "") (= (object/get @entity @config.statusField) @config.fromStatus)) (> (object/get @entity @config.dateField) 0) (< (object/get @entity @config.dateField) (- @now (* @config.ageDays 86400000))))
          })
          (fetch @config.targetEntity {
            emit: { failure: ScanFailed, success: ScanRecordsLoaded }
            filter: (and (= (object/get @entity status) @config.fromStatus) (< (object/get @entity @config.dateField) (- @now (* @config.ageDays 86400000))))
          }))
    }

    config {
      enabled : boolean = false
        @label "Auto-archive old records"
        @description "Automatically change the status of records once they age past a threshold. Off by default."
        @synonyms "enable, turn on, enforce, require, activate, apply, switch on, retention, ttl, expire, archive after, sunset, lifecycle, age out, time-based status, scheduled transitions, expire old records, auto-archive"
        @tier "infra"
      targetEntity : entity = LifecycleRunLog
        @label "Target entity"
        @description "Entity name to scan and transition (e.g. 'Task'). Defaults to the atom's own log so the standalone validates; rebind per composition. Typed `entity`, so a rename of the bound entity threads through to this value automatically."
        @tier "internal"
      fromStatus : string = ""
        @label "Which status triggers the age-out?"
        @description "Only records currently in this status are candidates for automatic transition."
        @synonyms "source status, current status, eligible status, starting status"
        @tier "infra"
      toStatus : string = ""
        @label "What status should old records move to?"
        @description "Status assigned once a record ages past the threshold (e.g. 'archived', 'expired')."
        @synonyms "target status, end status, destination status, archive status"
        @tier "infra"
      dateField : string = ranAt
        @label "Which date field measures the record's age?"
        @description "Numeric (ms-epoch) entity field compared against the age threshold (e.g. 'createdAt')."
        @tier "internal"
      ageDays : number = 30
        @label "How old (in days) before a record is transitioned?"
        @description "Records older than this many days move from the source status to the destination status. With the delete action, 0 turns the sweep off rather than deleting everything."
        @synonyms "age threshold, days until archive, expiry days, max age, retention days"
        @tier "infra"
      action : "status" | "delete" = status
        @label "What happens to records past the age threshold?"
        @description "status moves each aged record from the source status to the destination status. delete removes each aged record (retention); the destination status is ignored, the source status narrows the sweep only when set, and a record whose date field is 0 is never aged."
        @synonyms "retention, ttl, purge, expire, delete after, remove old records, prune, clean up, keep for, data retention"
        @tier "infra"
      statusField : string = status
        @label "Which field holds the status the sweep matches?"
        @description "Used by the delete action when a source status is set: the field compared with it (e.g. 'state'). The status action always reads and writes `status`."
        @synonyms "status column, state field, match field"
        @tier "internal"
      dryRun : boolean = false
        @label "Run in dry-run mode (no changes written)?"
        @description "When true, the scan runs but no status transitions are persisted and no records are deleted."
        @synonyms "test mode, preview, simulate, dry run, no write"
        @tier "infra"
    }
  }

  page "/lifecycle/scheduler" as LifecycleSchedulerPage -> LifecycleScheduler
}