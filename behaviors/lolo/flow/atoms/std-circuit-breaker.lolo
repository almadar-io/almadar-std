app std-circuit-breaker [
  version: "1.0.0",
  description: "std-circuit-breaker as a Function"
]
uses Spec from "almadar-std/circuit-breaker"

orbital ServiceNodeOrbital {
    uses Icon from "std/behaviors/ui-icon"
    uses Typography from "std/behaviors/ui-typography"
    uses StatusDot from "std/behaviors/ui-status-dot"
    uses Alert from "std/behaviors/ui-alert"
    uses StatDisplay from "std/behaviors/ui-stat-display"
    uses Meter from "std/behaviors/ui-meter"
    uses Button from "std/behaviors/ui-button"
    uses Divider from "std/behaviors/ui-divider"
    uses SimpleGrid from "std/behaviors/ui-simple-grid"

  entity ServiceNode [runtime] {
    id : string
    name : string @description "A user-defined identifier for the circuit breaker." @synonyms "identifier, label, designation"
    description : string @description "A textual explanation of the service node's function." @synonyms "explanation, details, notes, information"
    status : "active" | "inactive" | "pending" @description "Current operational state of the component." @synonyms "state, condition, operationalStatus" = active
    createdAt : string
    failureCount : number @intrinsic @description "The number of times the circuit breaker has failed." @synonyms "error count, failures, error occurrences" = 0
    successCount : number @intrinsic @description "Number of successful operations." @synonyms "successes, hits, completions" = 0
    threshold : number @intrinsic @description "Maximum value before triggering an action." @synonyms "limit, cap, boundary" = 5
    openedAt : number @intrinsic @description "When the circuit last opened, in epoch milliseconds; the cooldown tick measures from it. 0 = never opened." @synonyms "tripped at, opened time" = 0
  }

  trait ShieldIcon = Icon.traits.IconRender -> ServiceNode {
    config {
      name: shield
    }
  }

  trait AlertTriangleIcon = Icon.traits.IconRender -> ServiceNode {
    config {
      name: alert-triangle
    }
  }

  trait ActivityIcon = Icon.traits.IconRender -> ServiceNode {
    config {
      name: activity
    }
  }

  trait ServiceNodeLabel = Typography.traits.TypographyRender -> ServiceNode {
    config {
      content: ServiceNode
      variant: h2
    }
  }

  trait ClosedStatusDot = StatusDot.traits.StatusDotRender -> ServiceNode {
    config {
      label: "Circuit Closed"
      pulse: false
      status: online
    }
  }

  trait OpenStatusDot = StatusDot.traits.StatusDotRender -> ServiceNode {
    config {
      label: "Circuit Open"
      pulse: true
      status: critical
    }
  }

  trait HalfOpenStatusDot = StatusDot.traits.StatusDotRender -> ServiceNode {
    config {
      label: "Circuit Half-Open"
      pulse: true
      status: warning
    }
  }

  trait SuccessAlert = Alert.traits.AlertRender -> ServiceNode {
    config {
      message: "Service is healthy. All requests are being processed."
      variant: success
    }
  }

  trait ErrorAlert = Alert.traits.AlertRender -> ServiceNode {
    config {
      message: "Circuit is open. Requests are being rejected to prevent cascading failures."
      variant: error
    }
  }

  trait WarningAlert = Alert.traits.AlertRender -> ServiceNode {
    config {
      message: "Testing recovery. Limited requests are being allowed through."
      variant: warning
    }
  }

  trait FailuresStat = StatDisplay.traits.StatDisplayRender -> ServiceNode {
    config {
      label: Failures
      look: @config.statLook
      value: @entity.failureCount
    }
  }

  trait SuccessesStat = StatDisplay.traits.StatDisplayRender -> ServiceNode {
    config {
      label: Successes
      look: @config.statLook
      value: @entity.successCount
    }
  }

  trait FailuresMeter = Meter.traits.MeterRender -> ServiceNode {
    config {
      max: @entity.threshold
      min: 0
      value: @entity.failureCount
    }
  }

  trait ResetButton = Button.traits.ButtonRender -> ServiceNode {
    config {
      action: RESET
      icon: rotate-ccw
      label: Reset
      variant: ghost
    }
  }

  trait CircuitDivider = Divider.traits.DividerRender -> ServiceNode {
    config {}
  }

  trait StatsGrid = SimpleGrid.traits.SimpleGridRender -> ServiceNode {
    config {
      children: [@trait.FailuresStat, @trait.SuccessesStat]
      cols: 2
    }
  }

  trait ServiceNodeCircuitBreaker -> ServiceNode [interaction, collection] {
    initial: closed

    state closed {
      INIT -> closed
        @ensures (and (= @entity.failureCount 0) (= @entity.successCount 0))
        (set @entity.failureCount 0)
        (set @entity.successCount 0)
        (set @entity.threshold @config.failureThreshold)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
      FAILURE -> open
        @ensures (> @entity.openedAt 0)
        (set @entity.openedAt (time/now))
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.AlertTriangleIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.ErrorAlert, @trait.StatsGrid, @trait.FailuresMeter, @trait.ResetButton]
          direction: vertical
          gap: lg
          type: stack
        })
      SUCCESS -> closed
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
    }

    state open {
      INIT -> closed
        @ensures (and (= @entity.failureCount 0) (= @entity.successCount 0))
        (set @entity.failureCount 0)
        (set @entity.successCount 0)
        (set @entity.threshold @config.failureThreshold)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
      TIMEOUT -> halfOpen
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ActivityIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.HalfOpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.WarningAlert, @trait.StatsGrid]
          direction: vertical
          gap: lg
          type: stack
        })
      RESET -> closed
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
    }

    state halfOpen {
      INIT -> closed
        @ensures (and (= @entity.failureCount 0) (= @entity.successCount 0))
        (set @entity.failureCount 0)
        (set @entity.successCount 0)
        (set @entity.threshold @config.failureThreshold)
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
      SUCCESS -> closed
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
      FAILURE -> open
        @ensures (> @entity.openedAt 0)
        (set @entity.openedAt (time/now))
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.AlertTriangleIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.OpenStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.ErrorAlert, @trait.StatsGrid, @trait.FailuresMeter, @trait.ResetButton]
          direction: vertical
          gap: lg
          type: stack
        })
      RESET -> closed
        (render-ui main {
          children: [{
            align: center
            children: [{
              align: center
              children: [@trait.ShieldIcon, @trait.ServiceNodeLabel]
              direction: horizontal
              gap: md
              type: stack
            }, @trait.ClosedStatusDot]
            direction: horizontal
            gap: md
            justify: between
            type: stack
          }, @trait.CircuitDivider, @trait.SuccessAlert, @trait.StatsGrid, @trait.FailuresMeter]
          direction: vertical
          gap: lg
          type: stack
        })
    }

    ticks {
      cooldownCheck every 1s
        when (and (== @state "open") (>= (- @now @entity.openedAt) @config.cooldownMs))
        (emit TIMEOUT)
    }

    emits {
      TIMEOUT -> internal {
      }
        @description "The open circuit's cooldown elapsed; the breaker lets a trial request through (halfOpen)."
        @synonyms "cooldown elapsed, retry window, trial period"
    }

    config {
      failureThreshold : number = 5
        @label "Failure threshold"
        @description "Number of consecutive failures before the circuit opens and starts rejecting requests."
        @synonyms "open trigger, failure count"
        @tier "domain"
      cooldownMs : number = 30000
        @label "Cooldown (ms)"
        @description "How long the circuit stays open before it moves to half-open and lets a trial request through."
        @synonyms "reset timeout, open duration, retry delay"
        @tier "domain"
      statLook : "elevated" | "flat" | "progress-backed" | "gauge" | "sparkline" = elevated
        @label "Stat display look"
        @description "Layer 2 visual treatment for stat / KPI cards."
        @tier "presentation"
    }
  }

  page "/servicenodes" as ServiceNodePage -> ServiceNodeCircuitBreaker
}