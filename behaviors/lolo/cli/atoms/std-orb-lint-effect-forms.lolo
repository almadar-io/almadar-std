app std-orb-lint-effect-forms [
  version: "1.0.0",
  inbound: ["cli-lint-effect-forms"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-effect-forms - the `orb lint effect-forms <file>` command, the port of the structural checks of the set, fetch, fetch-stream and persist effects (expressions/effect/set.rs, fetch.rs, persist.rs). The effects of every inline trait transition and tick are flattened by std-orb-effect-leaves (through do, if, when and let). set: ORB_EFF_SET_INVALID_BINDING, ORB_EFF_SET_PAYLOAD_NOT_ALLOWED, ORB_BINDING_SET_TARGET_MISSING_PATH and ORB_X_ENUM_VALUE_NOT_MEMBER (a string literal assigned to an enum field of the trait's linked entity). fetch and fetch-stream: ORB_EFF_FETCH_INVALID_ENTITY (an undeclared entity, a non-string name, a raw binding as third argument, too many arguments), ORB_EFF_FETCH_INVALID_INCLUDE and ORB_EFF_FETCH_INVALID_OPTION (deliver, total and the nearest structure). persist: ORB_EFF_FETCH_INVALID_ENTITY, ORB_PERSIST_ID_NOT_A_PATH, ORB_PERSIST_CREATE_LITERAL_ID, ORB_ENTITY_INTRINSIC_FIELD_PERSISTED, ORB_PERSIST_CREATE_MISSING_POLICY_FIELD and ORB_PERSIST_WHERE_NOT_A_PREDICATE. Each finding carries the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint effect-forms: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-effect-forms"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type LfVal = string | number | boolean | [LfVal?] | Map string LfVal?
type LfLeaf = { p : string!, e : LfVal!, oi : number!, ti : number! }
type LfItems = { type : string }
type LfField = { name : string, type : string, values : [string], intrinsic : boolean, items : LfItems }
type LfEntity = { name : string, fields : [LfField], create_policy : LfVal, browser : boolean }
type LfExpect = { kind : string, name : string }
type LfTransition = { effects : [LfVal?] }
type LfTick = { effects : [LfVal?] }
type LfMachine = { transitions : [LfTransition] }
type LfTrait = { name : string, linkedEntity : string, stateMachine : LfMachine, ticks : [LfTick] }
type LfOrbital = { name : string, entity : LfEntity, auxiliaryEntities : [LfEntity], expects : [LfExpect], traits : [LfTrait] }
type LfProgram = { orbitals : [LfOrbital] }
type LfItem = { p : string, k : number, msg : string, t : [LfVal?] }
orbital OrbLintEffectFormsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintEffectFormsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    opNames : [string] = []
    orbitals : [LfOrbital] = []
    known : [string] = []
    defs : Map string LfEntity = {}
  }

  trait OrbLintEffectForms -> OrbLintEffectFormsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_OPERATOR_NAMES -> ready
        (set @entity.opNames @payload.names)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get @payload.program "orbitals" []))
        (set @entity.known (let ((orbitals (object/get @payload.program "orbitals" []))) (array/unique (array/filter (array/concat (array/map (array/flatten (array/map @orbitals (fn o (array/concat (if (validate/object (object/get @o "entity" {  })) [(object/get @o "entity")] []) (array/filter (object/get @o "auxiliaryEntities" []) (fn x (validate/object @x))))))) (fn x (object/get @x "name" ""))) (array/flatten (array/map @orbitals (fn o (array/map (array/filter (object/get @o "expects" []) (fn x (or (= (object/get @x "kind" "") "entity") (= (object/get @x "kind" "") "identity")))) (fn x (object/get @x "name" ""))))))) (fn n (!= @n ""))))))
