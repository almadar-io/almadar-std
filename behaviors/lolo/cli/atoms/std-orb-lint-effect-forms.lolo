app std-orb-lint-effect-forms [
  version: "1.0.0",
  inbound: ["cli-lint-effect-forms"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-effect-forms - the `orb lint effect-forms <file>` command, the port of the structural checks of the set, fetch, fetch-stream and persist effects (expressions/effect/set.rs, fetch.rs, persist.rs). The effects of every inline trait transition and tick are flattened by std-orb-effect-leaves (through do, if, when and let). The `@entity.<field>` references of an entity's `@create` policy come from std-orb-lint-input's OrbLintExprNodes (LINT_EXPR_ASK / LINT_EXPR_NODES). set: ORB_EFF_SET_INVALID_BINDING, ORB_EFF_SET_PAYLOAD_NOT_ALLOWED, ORB_BINDING_SET_TARGET_MISSING_PATH and ORB_X_ENUM_VALUE_NOT_MEMBER (a string literal assigned to an enum field of the trait's linked entity, or held by an enum field of the record literal set into a to-one relation field, read against the related entity). fetch and fetch-stream: ORB_EFF_FETCH_INVALID_ENTITY (an undeclared entity, a non-string name, a raw binding as third argument, too many arguments), ORB_EFF_FETCH_INVALID_INCLUDE and ORB_EFF_FETCH_INVALID_OPTION (deliver, total and the nearest structure). persist: ORB_EFF_FETCH_INVALID_ENTITY, ORB_PERSIST_ID_NOT_A_PATH, ORB_PERSIST_CREATE_LITERAL_ID, ORB_ENTITY_INTRINSIC_FIELD_PERSISTED, ORB_PERSIST_CREATE_MISSING_POLICY_FIELD and ORB_PERSIST_WHERE_NOT_A_PREDICATE, and for the data literal of a persist create, update or upsert the row-literal checks against the target entity: ORB_X_ROW_LITERAL_UNKNOWN_FIELD (a key the entity does not declare) and ORB_X_ROW_LITERAL_MISSING_REQUIRED (a persist create literal omitting a required, default-less, non-nullable, non-intrinsic field), ORB_X_ROW_LITERAL_FIELD_TYPE_MISMATCH (a null literal into a field that is not declared nullable, or a string, number or boolean literal into a field of another scalar type). Each finding carries the Rust path, message and suggestion (status 500, exit 1). The rule asks std-orb-effect-leaves for the set, fetch, fetch-stream and persist effects (heads) and reads every argument, literal and object key from their flat typed nodes; the operations of a persist batch are checked from the batch's own nodes, after the effects themselves. Clean answers `lint effect-forms: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-effect-forms"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type LfExpr = string | number | boolean | [LfExpr?] | Map string LfExpr?
type LfLeaf = { p : string!, n : [LfNode]!, oi : number!, ti : number! }
type LfItems = { type : string }
type LfRelation = { cardinality : string, entity : string }
type LfField = { name : string, type : string, nullable : boolean, values : [string], intrinsic : boolean, required : boolean, default : LfExpr?, mergedFrom : string, items : LfItems, relation : LfRelation }
type LfEntity = { name : string, fields : [LfField], create_policy : LfExpr, browser : boolean }
type LfExpect = { kind : string, name : string }
type LfTrait = { name : string, linkedEntity : string }
type LfOrbital = { name : string, entity : LfEntity, auxiliaryEntities : [LfEntity], expects : [LfExpect], traits : [LfTrait] }
type LfProgram = { orbitals : [LfOrbital] }
type LfNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type LfExprItem = { e : LfExpr?, eff : boolean! }
type LfWalkSlot = { kind : string!, args : [number] }
type LfWalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type LfBatchIt = { p : string, k : number, msg : string, act : string, cnt : number, ei : number, di : number }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEffectFormsCodes = { effSetInvalidBinding : LintCodeDecl , effSetPayloadNotAllowed : LintCodeDecl , bindingSetTargetMissingPath : LintCodeDecl , xEnumValueNotMember : LintCodeDecl , effFetchInvalidEntity : LintCodeDecl , effFetchInvalidInclude : LintCodeDecl , effFetchInvalidOption : LintCodeDecl , persistBatchOpsNotArray : LintCodeDecl , persistBatchBadOp : LintCodeDecl , persistBatchMixedPlacement : LintCodeDecl , persistWhereNotAPredicate : LintCodeDecl , persistIdNotAPath : LintCodeDecl , persistCreateLiteralId : LintCodeDecl , entityIntrinsicFieldPersisted : LintCodeDecl , persistCreateMissingPolicyField : LintCodeDecl , rowLiteralUnknownField : LintCodeDecl , rowLiteralFieldTypeMismatch : LintCodeDecl , rowLiteralMissingRequired : LintCodeDecl }

orbital OrbLintEffectFormsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintEffectFormsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    opNames : [string] = []
    orbitals : [LfOrbital] = []
    known : [string] = []
    defs : Map string LfEntity = {}
    policyFields : Map string [string] = {}
  }

  trait OrbLintEffectForms -> OrbLintEffectFormsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_OPERATOR_NAMES -> ready
        (set @entity.opNames @payload.names)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get (default @payload.program { orbitals: [] }) "orbitals" []))
        (set @entity.known (let ((orbitals (object/get (default @payload.program { orbitals: [] }) "orbitals" []))) (array/unique (array/filter (array/concat (array/map (array/flatten (array/map @orbitals (fn o (array/concat (if (validate/object (object/get @o "entity" {  })) [(object/get @o "entity")] []) (array/filter (object/get @o "auxiliaryEntities" []) (fn x (validate/object @x))))))) (fn x (object/get @x "name" ""))) (array/flatten (array/map @orbitals (fn o (array/map (array/filter (object/get @o "expects" []) (fn x (or (= (object/get @x "kind" "") "entity") (= (object/get @x "kind" "") "identity")))) (fn x (object/get @x "name" ""))))))) (fn n (!= @n ""))))))
        (set @entity.defs (let ((orbitals (object/get (default @payload.program { orbitals: [] }) "orbitals" []))) (let ((pn (array/map (array/flatten (array/map @orbitals (fn o (if (validate/object (object/get @o "entity" {  })) [(object/get @o "entity")] [])))) (fn x (object/get @x "name" ""))))) (let ((dups (array/filter @pn (fn n (> (array/len (array/filter @pn (fn m (= @m @n)))) 1))))) (default (object/fromEntries (array/map (array/filter (array/flatten (array/map @orbitals (fn o (array/concat (if (validate/object (object/get @o "entity" {  })) [(object/get @o "entity")] []) (array/filter (object/get @o "auxiliaryEntities" []) (fn x (validate/object @x))))))) (fn x (not (array/includes @dups (object/get @x "name" ""))))) (fn x [(object/get @x "name" ""), @x]))) {})))))
        (emit EF_POLICY { })
      EF_POLICY -> ready
        (emit LINT_EXPR_ASK { requestId: (str/concat "effect-forms-policy:" @entity.scope), items: (array/map (object/values @entity.defs) (fn d { e: (object/get @d "create_policy" null), eff: false })) })
      LINT_EXPR_NODES -> ready when (= @payload.requestId (str/concat "effect-forms-policy:" @entity.scope))
        (set @entity.policyFields (let ((nn : LfNode { k: "nil", ks: [], hd: "", nms: [], rt: "", nm: "", pa: [], bd: -1, wh: "", tx: "", pv: false, hs: false, sl: [], lb: [], lv: null }) (nofl : [LfNode] []) (names : [string] (object/keys @entity.defs)))
          (default (object/fromEntries (array/map (array/range 0 (array/len @names)) (fn i [(default (array/nth @names @i) ""), (array/unique (array/flatten (array/map (default (array/nth @payload.nodes @i) @nofl) (fn nd (if (and (= (object/get @nd "k") "bind") (= (object/get @nd "wh") "w") (= (object/get @nd "nm") "entity") (> (array/len (object/get @nd "pa")) 0)) [(default (array/first (str/split (default (array/first (object/get @nd "pa")) "") "[")) "")] [])))))]))) {})))
        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "effect-forms" @entity.scope), orbitals: @entity.orbitals, heads: ["set", "fetch", "fetch-stream", "persist"] })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "effect-forms" @entity.scope))
        (set @entity.findings (let ((orbitals : [LfOrbital] @entity.orbitals) (known : [string] @entity.known) (defs : Map string LfEntity @entity.defs) (opnames : [string] @entity.opNames) (nOrbF : LfOrbital { name: "", entity: { name: "", fields: [], create_policy: "", browser: false }, auxiliaryEntities: [], expects: [], traits: [] }) (nLeaf : LfLeaf { p: "", n: [], oi: 0, ti: 0 }) (nTraitF : LfTrait { name: "", linkedEntity: "" }) (nFld : LfField { name: "", type: "", values: [], intrinsic: false, items: { type: "" } }) (nn : LfNode { k: "nil", ks: [], hd: "", nms: [], rt: "", nm: "", pa: [], bd: -1, wh: "", tx: "", pv: false, hs: false, sl: [], lb: [], lv: null })) (let ((bi : [[LfBatchIt]] (array/map @payload.leaves (fn l (let ((nb : [LfNode] (object/get @l "n" [])) (p (object/get @l "p"))) (let ((rti (- (array/len @nb) 1)) (rt : LfNode (default (array/nth @nb @rti) @nn))) (let ((rtks : [number] (object/get @rt "ks"))) (let ((rtcr : [number] (array/map (array/range 0 (array/len @rtks)) (fn j (- (+ (- @rti (array/sum @rtks)) (array/sum (array/take @rtks (+ @j 1)))) 1))))) (let ((n : number (if (array/includes ["call", "arr", "proj", "rui"] (object/get @rt "k")) (array/len @rtks) 0))) (let ((h : string (if (> @n 0) (default (array/first (default (object/get (default (array/nth @nb (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) "") ""))) (let ((a1i (default (array/nth @rtcr 1) 0)) (a1 : LfNode (default (array/nth @nb @a1i) @nn))) (let ((a1ks : [number] (object/get @a1 "ks"))) (let ((a1cr : [number] (array/map (array/range 0 (array/len @a1ks)) (fn j (- (+ (- @a1i (array/sum @a1ks)) (array/sum (array/take @a1ks (+ @j 1)))) 1))))) (let ((a2i (default (array/nth @rtcr 2) 0)) (a2 : LfNode (default (array/nth @nb @a2i) @nn))) (let ((a2ks : [number] (object/get @a2 "ks"))) (let ((a2cr : [number] (array/map (array/range 0 (array/len @a2ks)) (fn j (- (+ (- @a2i (array/sum @a2ks)) (array/sum (array/take @a2ks (+ @j 1)))) 1))))) (let ((s1ok (and (> @n 1) (or (and (= (obje