    emits {
      EF_POLICY { }
        @description "Internal: the entities are held; flatten their create policies."
        @tier "internal"
      LINT_EXPR_ASK -> external { requestId : string!  items : [LfExprItem]! }
        @description "Ask the expression nodes of std-orb-lint-input to flatten these expressions."
        @tier "internal"
      EFFECT_LEAVES_EXPAND -> external { requestId : string!  orbitals : [LfOrbital]!  heads : [string]! }
        @description "Ask std-orb-effect-leaves to flatten the effects of every inline trait."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      EFFECT_LEAVES_HEARD { requestId : string!  leaves : [LfLeaf]! }
        @description "std-orb-effect-leaves's answer: the effects to check, flattened."
      OrbEffectLeaves.EFFECT_LEAVES_EXPANDED -> EFFECT_LEAVES_HEARD
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LfProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "The installed operator names, namespaced ones included."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      LINT_EXPR_NODES { requestId : string!  nodes : [[LfNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked expression."
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
    config {
      codes : LintEffectFormsCodes = { effSetInvalidBinding: { code: "ORB_EFF_SET_INVALID_BINDING", category: "effect", description: "A set effect is missing its binding or its value" }, effSetPayloadNotAllowed: { code: "ORB_EFF_SET_PAYLOAD_NOT_ALLOWED", category: "effect", description: "A set effect targets @payload, which is read-only; it should target @entity" }, bindingSetTargetMissingPath: { code: "ORB_BINDING_SET_TARGET_MISSING_PATH", category: "binding", description: "A set effect targets a binding root without a field path" }, xEnumValueNotMember: { code: "ORB_X_ENUM_VALUE_NOT_MEMBER", category: "cross", description: "A set effect assigns a string literal that is not a declared member of the target field's enum" }, effFetchInvalidEntity: { code: "ORB_EFF_FETCH_INVALID_ENTITY", category: "effect", description: "A fetch effect is missing an entity name or references an invalid entity" }, effFetchInvalidInclude: { code: "ORB_EFF_FETCH_INVALID_INCLUDE", category: "effect", description: "A fetch includes a relation that the fetched entity has no relation field for" }, effFetchInvalidOption: { code: "ORB_EFF_FETCH_INVALID_OPTION", category: "effect", description: "A fetch deliver option is not one of the allowed values rows or ids" }, persistBatchOpsNotArray: { code: "ORB_PERSIST_BATCH_OPS_NOT_ARRAY", category: "persist", description: "A persist batch operations expression is missing or not array-typed" }, persistBatchBadOp: { code: "ORB_PERSIST_BATCH_BAD_OP", category: "persist", description: "A persist batch contains an operation that is not valid in a batch" }, persistBatchMixedPlacement: { code: "ORB_PERSIST_BATCH_MIXED_PLACEMENT", category: "persist", description: "A persist batch writes both browser-stored and server-stored entities in one effect, which no single executor can hold" }, persistWhereNotAPredicate: { code: "ORB_PERSIST_WHERE_NOT_A_PREDICATE", category: "persist", description: "A persist where clause is not a valid row predicate" }, persistIdNotAPath: { code: "ORB_PERSIST_ID_NOT_A_PATH", category: "persist", description: "A persist effect names its row id with an expression instead of a binding path or literal id, so no row key resolves" }, persistCreateLiteralId: { code: "ORB_PERSIST_CREATE_LITERAL_ID", category: "persist", description: "A persist create names a literal id, so a second run fails with a duplicate id" }, entityIntrinsicFieldPersisted: { code: "ORB_ENTITY_INTRINSIC_FIELD_PERSISTED", category: "entity_mutation", description: "A persist data literal names an @intrinsic field, which is trait-owned view-state and never a persisted column" }, persistCreateMissingPolicyField: { code: "ORB_PERSIST_CREATE_MISSING_POLICY_FIELD", category: "persist", description: "A persist create data literal omits a field its entity's create access policy compares, so the row can never satisfy the policy" }, rowLiteralUnknownField: { code: "ORB_X_ROW_LITERAL_UNKNOWN_FIELD", category: "effect", description: "A record literal written into an entity (a `persist` data literal, or a `set` into a relation field) names a key the entity does not declare." }, rowLiteralFieldTypeMismatch: { code: "ORB_X_ROW_LITERAL_FIELD_TYPE_MISMATCH", category: "effect", description: "A record literal written into an entity carries a value whose type the declared field does not admit." }, rowLiteralMissingRequired: { code: "ORB_X_ROW_LITERAL_MISSING_REQUIRED", category: "effect", description: "A `persist create` data literal omits a column the entity requires (no default, not framework-stamped)." } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEffectFormsCli -> OrbLintEffectFormsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint effect-forms <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "effect-forms") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint effect-forms: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "effect-forms") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint effect-forms: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-effect-forms" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint effect-forms` with its arguments and working directory."
        @synonyms "orb lint effect-forms"
      OrbLintEffectForms.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEffectLeaves = LeavesUse.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [LfOrbital]!  heads : [string]! }
        @description "Flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[LfNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintEffectForms.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbLintExprNodes = Input.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string LfWalkSlot!  projections : Map string LfWalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [LfExprItem]! }
        @description "A rule asks to flatten expressions."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbLintEffectForms.LINT_EXPR_ASK -> LINT_EXPR_ASK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEffectFormsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEffectFormsOrbitalStart -> OrbLintEffectForms, OrbLintEffectFormsCli, OrbLintInput, OrbLintExprNodes, Packs, OrbEffectLeaves, Versions
}
