        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "effect-forms" @payload.scope), orbitals: (object/get @payload.program "orbitals" []) })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "effect-forms" @entity.scope))
        (set @entity.findings (let ((orbitals @entity.orbitals) (known @entity.known) (defs @entity.defs) (opnames @entity.opNames)) (let ((leaves : [LfLeaf] (array/concat @payload.leaves (array/flatten (array/map @payload.leaves (fn l (let ((e (object/get @l "e")) (p (object/get @l "p"))) (if (validate/array @e) (if (and (>= (array/len @e) 3) (let ((sq (array/nth @e 0))) (if (validate/string @sq) (= @sq "persist") false)) (let ((sq (array/nth @e 1))) (if (validate/string @sq) (= @sq "batch") false))) (let ((items (let ((ops (array/nth @e 2))) (let ((mb (if (validate/array @ops) (if (and (= (array/len @ops) 3) (let ((sq (array/nth @ops 0))) (if (validate/string @sq) (= @sq "array/map") false))) (let ((lm (array/nth @ops 2))) (if (and (validate/array @lm) (>= (array/len @lm) 3) (or (let ((sq (array/nth @lm 0))) (if (validate/string @sq) (= @sq "fn") false)) (let ((sq (array/nth @lm 0))) (if (validate/string @sq) (= @sq "lambda") false)))) (array/last @lm) null)) null) null))) (let ((oh (if (validate/array @ops) (if (= (array/len @ops) 0) null (array/nth @ops 0)) null))) (if (validate/array @ops) (if (or (= (array/len @ops) 0) (not (validate/string @oh)) (let ((sq @oh)) (if (validate/string @sq) (= @sq "list") false))) (let ((els (if (= (array/len @ops) 0) (array/slice @ops 0 0) (if (let ((sq @oh)) (if (validate/string @sq) (= @sq "list") false)) (array/slice @ops 1 (array/len @ops)) @ops)))) (let ((els @els)) (array/flatten (array/map (array/range 0 (array/len @els)) (fn i (let ((el (array/nth @els @i))) (let ((ip (str/concat @p ".ops[" @i "]"))) (if (validate/array @el) (if (= (array/len @el) 0) [{ p: @ip, k: 2, msg: "batch op must start with an action", t: [] }] (let ((hd (array/nth @el 0))) (if (validate/string @hd) (if (array/includes ["create", "update", "delete"] @hd) [{ p: @ip, k: 1, msg: "", t: @el }] (if (or (array/includes @opnames @hd) (str/startsWith @hd "agent/")) [] [{ p: @ip, k: 2, msg: (str/concat "batch op action '" @hd "' is not one of create, updat