app std-orb-compile [
  version: "1.0.0",
  inbound: ["cli-compile"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-compile — the `orb compile <FILE> [flags]` command (spec/cli/orb-compile.lolo; port of orbital-cli commands/compile.rs). The source is first checked by the std validate program (std-orb-validate composed here: the core checks plus the policy lints) as `--json`; any error finding refuses with status 500 on stderr `Error: <path> fails `orb validate` with N error(s), so it is not compiled:` and one `[CODE] path: message[ 💡 suggestion]` line per error. A clean source is generated by program/eval null { generate: { path, output, shell, mode?, frontend?, backend?, backendUrl?, patterns?, devLogs?, host?, emitOrb? } } on the host (every relative path joined to the directory the command runs in; output defaults to ./output, shell to typescript), which validates the lowered program again, writes the project and answers { lines, files, warnings, nextSteps }: lines are exactly what `orb compile` printed, joined by newlines on stdout. A host refusal answers status 500 on stderr `Error: <reason>` (the reason carrying the `program/eval:` prefix); no file, a second file, an unknown flag or a valueless value flag answers the usage (status 400, exit 2). Known differences: a shell, mode or host value outside the accepted set is refused by the host (status 500) where clap exits 2; the header lines printed before a failure are not printed."
]
uses Spec from "almadar-std/orb-compile"
uses Args from "std/behaviors/std-args"
uses Validate from "std/behaviors/std-orb-validate"
uses LintEngine from "std/behaviors/std-orb-lint-engine"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type ReportFinding = { code : string!, path : string, message : string!, suggestion : string, fixGuidance : string, expectedShape : string, validValues : [string], line : number, column : number, endLine : number, endColumn : number, approximate : boolean, needsInstall : boolean }
type ReportStats = { orbitals : number!, entities : number!, traits : number!, pages : number! }
type ValidationReport = { success : boolean!, valid : boolean!, errors : [ReportFinding], warnings : [ReportFinding], stats : ReportStats }
type RuleFound = { rule : string!, findings : [OrbFinding]! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type GenerateAnswer = { lines : [string]!, files : number!, warnings : [string]!, nextSteps : [string]! }

orbital OrbCompileOrbital {
  entity CompileRun [runtime] {
    id : string!
    cwd : string = ""
    positionals : [string] = []
    flags : Map string [string]
    file : string = ""
    json : boolean = false
    denyWarnings : boolean = false
    report : ValidationReport
    errors : [ReportFinding] = []
    warnings : [ReportFinding] = []
    valid : boolean = false
  }

  trait Checks = Validate.traits.ValidateEngine {
    listens {
      OrbCompile.VALIDATE_START -> VALIDATE_START
      VALIDATE_START {
        file : string!
        path : string!
        cwd : string!
        json : boolean!
        denyWarnings : boolean!
        finalProgram : boolean!
        hasPatterns : boolean!
        patterns : string!
        hasServices : boolean!
        services : string!
      }
        @description "Validate the program at the absolute path."
      LINT_COLLECTED { findings : [OrbFinding]!  found : [RuleFound]! }
        @description "std-orb-lint-engine's LINT_COLLECTED: every rule's findings for the file."
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "std-orb-lint-input's LINT_INPUT_UNREAD: the file could not be read or lowered."
      Lint.OrbLintEngine.LINT_COLLECTED -> LINT_COLLECTED
      Lint.OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbCompile.COMPILE_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbCompile -> CompileRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      COMPILE_CALLED -> parsing
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit COMPILE_ARGS_PARSE { stage: "compile" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "output" aliases: ["-o"] takesValue: true repeatable: false }, { name: "shell" aliases: ["-s"] takesValue: true repeatable: false }, { name: "mode" aliases: ["-m"] takesValue: true repeatable: false }, { name: "frontend" aliases: [] takesValue: true repeatable: false }, { name: "backend" aliases: [] takesValue: true repeatable: false }, { name: "backend-url" aliases: [] takesValue: true repeatable: false }, { name: "patterns" aliases: [] takesValue: true repeatable: false }, { name: "dev-logs" aliases: [] takesValue: false repeatable: false }, { name: "host" aliases: [] takesValue: true repeatable: false }, { name: "emit-orb" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      COMPILE_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1))
        (emit COMPILE_ANSWERED { status: 400, body: "", stderr: "usage: orb compile <FILE> [-o|--output DIR] [-s|--shell SHELL] [-m|--mode MODE] [--frontend SHELL] [--backend SHELL] [--backend-url URL] [--patterns PATH] [--dev-logs] [--host HOST] [--emit-orb PATH]" })
      COMPILE_ARGS_DONE -> validating when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.positionals @payload.positionals)
        (set @entity.flags @payload.flags)
        (emit VALIDATE_START { file: (array/first @payload.positionals), path: (if (os/path-is-absolute (array/first @payload.positionals)) (array/first @payload.positionals) (os/path-join @entity.cwd (array/first @payload.positionals))), cwd: @entity.cwd, json: true, denyWarnings: false, finalProgram: false, hasPatterns: false, patterns: "", hasServices: false, services: "" })
    }

    state validating {
      INIT -> validating
      VALIDATE_REPORTED -> ready when (!= @payload.status 200)
        (emit COMPILE_ANSWERED { status: 500, body: "", stderr: @payload.stderr })
      VALIDATE_REPORTED -> ready when (and (= @payload.status 200) (> (array/len (object/get (json/parse @payload.body ValidationReport) "errors" [])) 0))
        (emit COMPILE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " (if (os/path-is-absolute (array/first @entity.positionals)) (array/first @entity.positionals) (os/path-join @entity.cwd (array/first @entity.positionals))) " fails `orb validate` with " (array/len (object/get (json/parse @payload.body ValidationReport) "errors" [])) " error(s), so it is not compiled:
" (str/join (array/map (object/get (json/parse @payload.body ValidationReport) "errors" []) (fn f (str/concat "[" (object/get @f "code" "") "] " (object/get @f "path" "") ": " (object/get @f "message" "") (if (!= (object/get @f "suggestion" "") "") (str/concat " 💡 " (object/get @f "suggestion")) "")))) "
")) })
      VALIDATE_REPORTED -> generating when (and (= @payload.status 200) (= (array/len (object/get (json/parse @payload.body ValidationReport) "errors" [])) 0))
        (program/eval null { generate: (object/merge { path: (if (os/path-is-absolute (array/first @entity.positionals)) (array/first @entity.positionals) (os/path-join @entity.cwd (array/first @entity.positionals))), output: (if (os/path-is-absolute (if (!= (object/get @entity.flags "output") null) (array/first (object/get @entity.flags "output")) "./output")) (if (!= (object/get @entity.flags "output") null) (array/first (object/get @entity.flags "output")) "./output") (os/path-join @entity.cwd (if (!= (object/get @entity.flags "output") null) (array/first (object/get @entity.flags "output")) "./output"))), shell: (if (!= (object/get @entity.flags "shell") null) (array/first (object/get @entity.flags "shell")) "typescript") } (if (!= (object/get @entity.flags "mode") null) { mode: (array/first (object/get @entity.flags "mode")) } {}) (if (!= (object/get @entity.flags "frontend") null) { frontend: (array/first (object/get @entity.flags "frontend")) } {}) (if (!= (object/get @entity.flags "backend") null) { backend: (array/first (object/get @entity.flags "backend")) } {}) (if (!= (object/get @entity.flags "backend-url") null) { backendUrl: (array/first (object/get @entity.flags "backend-url")) } {}) (if (!= (object/get @entity.flags "patterns") null) { patterns: (if (os/path-is-absolute (array/first (object/get @entity.flags "patterns"))) (array/first (object/get @entity.flags "patterns")) (os/path-join @entity.cwd (array/first (object/get @entity.flags "patterns")))) } {}) (if (!= (object/get @entity.flags "dev-logs") null) { devLogs: true } {}) (if (!= (object/get @entity.flags "host") null) { host: (array/first (object/get @entity.flags "host")) } {}) (if (!= (object/get @entity.flags "emit-orb") null) { emitOrb: (if (os/path-is-absolute (array/first (object/get @entity.flags "emit-orb"))) (array/first (object/get @entity.flags "emit-orb")) (os/path-join @entity.cwd (array/first (object/get @entity.flags "emit-orb")))) } {})) } { key: "compile" emit: { success: COMPILE_GENERATED, failure: COMPILE_REFUSED } })
    }

    state generating {
      INIT -> generating
      COMPILE_GENERATED -> ready
        (emit COMPILE_ANSWERED { status: 200, body: (str/join (object/get @payload.result "lines") "
") })
      COMPILE_REFUSED -> ready
        (emit COMPILE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " @payload.error) })
    }

    emits {
      COMPILE_ANSWERED -> external {
        status : number!
        body : string!
        stderr : string
      }
        @description "The command's answer, which the cli hook prints."
        @tier "internal"
      COMPILE_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words."
        @tier "internal"
      VALIDATE_START {
        file : string!
        path : string!
        cwd : string!
        json : boolean!
        denyWarnings : boolean!
        finalProgram : boolean!
        hasPatterns : boolean!
        patterns : string!
        hasServices : boolean!
        services : string!
      }
        @description "Internal: ask the composed std validate engine to check the source."
        @tier "internal"
      COMPILE_REFUSED {
        error : string
      }
        @description "The program could not be generated."
        @tier "internal"
      COMPILE_GENERATED {
        result : GenerateAnswer!
      }
        @description "program/eval: what `orb compile` printed, line by line."
        @tier "internal"
    }

    listens {
      COMPILE_CALLED -> inbound "cli-compile" answers COMPILE_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb compile`."
        @synonyms "orb compile, generate the app from a program, write the project for a shell, typescript python rust android ios chrome-extension output"
      COMPILE_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED."
      ArgsCli.ARGS_PARSED -> COMPILE_ARGS_DONE
      VALIDATE_REPORTED { status : number!  body : string!  stderr : string }
        @description "The composed validate engine's answer: the --json report of the source."
      Checks.VALIDATE_ANSWERED -> VALIDATE_REPORTED
    }
  }

  page boot as OrbCompilePage -> OrbCompile, ArgsCli, Checks
}

orbital Lint = LintEngine.orbitals.OrbLintEngineOrbital {
  listens {
    OrbCompileOrbital.Checks.LINT_RUN -> OrbLintEngine.LINT_RUN
  }
}
