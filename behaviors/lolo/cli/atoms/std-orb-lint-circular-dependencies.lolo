app std-orb-lint-circular-dependencies [
  version: "1.0.0",
  inbound: ["cli-lint-circular-dependencies"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-circular-dependencies — the `orb lint circular-dependencies <file>` command, the port of validate_circular_dependencies (circuit/cross_orbital/cycles.rs, ORB_X_CIRCULAR_DEPENDENCY). It builds an event-level graph whose node is (trait, event its arm receives): an arm's emits (an `(emit X)` effect at any array depth, an object carrying `emit: X`, and the `emit` map values of a fetch or persist effect) reach the arms a `listens` route triggers. A route is an edge only when it can propagate (some transition on its trigger has an emit effect or an emit-carrying effect option), is not a lifecycle trigger (INIT, LOAD, RESET), the emitter is another trait, the route's source matches the emitter, neither the emitting arm nor the listen carries a guard (a guard names the loop's exit), and an edge across orbitals needs the emitter's `scope: external` emit, an externally scoped listen or an orbital-sourced listen. The first cycle found by a depth-first walk in sorted node order is reported once at `traits` with its node path (the Rust walk follows hash order, so the path it prints is not stable; this lint's path is). Reports ORB_X_CIRCULAR_DEPENDENCY (status 500, exit 1). Clean answers `lint circular-dependencies: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-circular-dependencies"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type CycNode = string | number | boolean | [CycNode?] | Map string CycNode?
type CycNodes = [CycNode?]
type CycMap = Map string CycNode?
type CycSource = { kind : string, trait : string, orbital : string }
type CycListen = { event : string, triggers : string, scope : string, source : CycSource, guard : CycNode? }
type CycEmit = { event : string, scope : string }
type CycTransition = { event : string, guard : CycNode?, effects : [CycNode?] }
type CycMachine = { transitions : [CycTransition] }
type CycTrait = { name : string, emits : [CycEmit], listens : [CycListen], stateMachine : CycMachine }
type CycOrbital = { name : string, traits : [CycTrait] }
type CycProgram = { orbitals : [CycOrbital] }
type CycRow = { tr : string, orb : string, arm : string, emitted : string, ek : string, guarded : boolean }
type CycOut = { ev : [string] }
type CycTypeRef = string | CycTypeNode
type CycTypeNode = { kind : string, fields : Map string CycTypeRef? }
type CycParam = { name : string, type : CycTypeRef }
type CycShape = { params : [CycParam] }
type CycAdj = { k : string, deps : [string] }
type CycEdge = { from : string, to : string, fk : string, tk : string }
type CycRowMap = Map string [CycRow]
type CycEdgeMap = Map string [CycEdge]
type CycPeel = { e : [CycEdge], d : boolean }
type CycWalk = { stack : [string], idx : [number], vis : [string], found : [string] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintCircularDependenciesCodes = { lintOperatorShapesUnread : LintCodeDecl , xCircularDependency : LintCodeDecl }

orbital OrbLintCircularDependenciesOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintCircularDependenciesRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    emitOps : [string] = []
    shapesUnread : boolean = false
  }

  trait OrbLintCircularDependencies -> OrbLintCircularDependenciesRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SHAPES_HEARD -> ready
        (set @entity.shapesUnread false)
        (set @entity.emitOps (array/sort (array/filter (object/keys @payload.operators) (fn k
          (array/some (object/get (object/get @payload.operators @k) "params" []) (fn pr
            (let ((ty (object/get @pr "type" null)))
              (if (validate/object @ty)
                (let ((nd (as @ty CycTypeNode)))
                  (if (= @nd null) false (object/has (object/get @nd "fields" {}) "emit")))
                false))))))))
      SHAPES_UNREAD -> ready
        (set @entity.shapesUnread true)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if @entity.shapesUnread [{ code: @config.codes.lintOperatorShapesUnread.code, path: "operators", message: "the installed @almadar/std operator table does not match the operator shape type, so the operators that can carry an emit option are unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }]
          (let ((nos : [string] [])
                (nonum : [number] [])
                (nonodes : CycNodes [])
                (notd : [CycTrait] [])
                (notr : [CycTransition] [])
                (noem : [CycEmit] [])
                (nol : [CycListen] [])
                (noedges : [CycEdge] [])
                (norows : [CycRow] [])
                (nomap : CycMap {})
                (nokids : [CycOut] [])
                (nout : CycOut { ev: [] })
                (propops @entity.emitOps)
                (lifecycle : [string] ["INIT", "LOAD", "RESET"])
                (orbitals (object/get @payload.program "orbitals" [])))
            (let ((rows (array/flatten (array/map @orbitals (fn ro
                    (let ((orn (object/get @ro "name" "")))
                      (array/flatten (array/map (array/filter (object/get @ro "traits" @notd) (fn rt (object/has @rt "stateMachine"))) (fn rtd
                        (let ((trn (object/get @rtd "name" "")))
                          (array/flatten (array/map (object/get (object/get @rtd "stateMachine" {}) "transitions" @notr) (fn rx
                            (let ((arm (object/get @rx "event" ""))
                                  (guarded (and (object/has @rx "guard") (!= (object/get @rx "guard" null) null))))
                              (array/map (array/unique (array/flatten (array/map (object/get @rx "effects" @nonodes) (fn re
                                (let ((txt (json/stringify @re)))
                                (if (not (str/includes @txt "\"emit\"")) @nos
                                (if (and (str/startsWith @txt "[\"emit\"") (= (array/len (str/split @txt "\"emit\"")) 2))
                                  (let ((fpa (json/parse @txt CycNodes))) (if (= @fpa null) @nos (if (< (array/len @fpa) 2) @nos (let ((m1 (array/nth @fpa 1))) (if (validate/string @m1) [(str/concat @m1 "")] @nos)))))
                                  (object/get (default (tree/fold @re (fn (tn fk)
                                    (let ((nr : CycOut { ev: [] }))
                                      (if (validate/array @tn)
                                        (let ((len (array/len @tn))
                                              (hd (if (> (array/len @tn) 0) (array/nth @tn 0) null)))
                                          { ev: (array/concat
                                              (if (= @len 0) @nos
                                                (array/concat
                                                  (if (and (>= @len 2) (= (json/stringify @hd) (json/stringify "emit")))
                                                    (let ((m1 (array/nth @tn 1))) (if (validate/string @m1) [(str/concat @m1 "")] @nos))
                                                    @nos)
                                                  (if (or (= (json/stringify @hd) (json/stringify "fetch")) (= (json/stringify @hd) (json/stringify "persist")))
                                                    (array/flatten (array/map @tn (fn mi
                                                      (if (not (validate/object @mi)) @nos
                                                        (let ((mo3 (as @mi CycMap)))
                                                          (if (= @mo3 null) @nos
                                                            (let ((mem (object/get @mo3 "emit" null)))
                                                              (if (not (validate/object @mem)) @nos
                                                                (let ((me (as @mem CycMap)))
                                                                  (if (= @me null) @nos
                                                                    (array/flatten (array/map (object/values @me) (fn mv
                                                                      (if (and (validate/string @mv) (!= (str/concat @mv "") "")) [(str/concat @mv "")] @nos))))))))))))))
                                                    @nos)))
                                              (array/flatten (array/map (default @fk @nokids) (fn fr (object/get (if (= @fr null) @nr @fr) "ev" @nos))))) })
                                        (if (validate/object @tn)
                                          { ev: (let ((mo (as @tn CycMap)))
                                              (if (= @mo null) @nos
                                                (let ((ev2 (object/get @mo "emit" null)))
                                                  (if (validate/string @ev2) [(str/concat @ev2 "")] @nos)))) }
                                          @nr))))
                                    "CycNode") @nout) "ev" @nos))))))))
                                (fn rev { tr: @trn, orb: @orn, arm: @arm, emitted: @rev, ek: (str/replaceAll (str/replaceAll @rev "~" "~t") "." "~d"), guarded: @guarded }))))))))))))))))
              (let ((externals (array/flatten (array/map @orbitals (fn xo
                      (array/flatten (array/map (array/filter (object/get @xo "traits" @notd) (fn xt (object/has @xt "stateMachine"))) (fn xtd
                        (let ((xn (object/get @xtd "name" "")))
                          (array/map (array/filter (object/get @xtd "emits" @noem) (fn xe (= (object/get @xe "scope" "") "external"))) (fn xe2 { tr: @xn, ev: (object/get @xe2 "event" "") }))))))))))
                    (rbe : CycRowMap (array/groupBy @rows "ek")))
                (let ((edges (array/flatten (array/map @orbitals (fn o
                        (let ((on (object/get @o "name" "")))
                          (array/flatten (array/map (array/filter (object/get @o "traits" @notd) (fn tt (object/has @tt "stateMachine"))) (fn td
                            (let ((tdn (object/get @td "name" ""))
                                  (lsn (object/get @td "listens" @nol)))
                              (if (= (array/len @lsn) 0) @noedges
                                (let ((trs (object/get (object/get @td "stateMachine" {}) "transitions" @notr))
                                      (trigs (array/unique (array/map @lsn (fn lt (object/get @lt "triggers" (object/get @lt "event" "")))))))
                                  (let ((propEvs (array/unique (array/map (array/filter (array/filter @trs (fn pf (array/includes @trigs (object/get @pf "event" "")))) (fn pt2
                                          (array/some (object/get @pt2 "effects" @nonodes) (fn pe
                                            (if (validate/array @pe)
                                              (let ((pa (as @pe CycNodes)))
                                                (if (= @pa null) false
                                                  (if (= (array/len @pa) 0) false
                                                    (and (>= (array/len @pa) 2)
                                                      (or (and (= (json/stringify (array/nth @pa 0)) (json/stringify "emit")) (validate/string (array/nth @pa 1)))
                                                          (let ((p0 (array/nth @pa 0)))
                                                            (and (validate/string @p0) (array/includes @propops (str/concat @p0 ""))
                                                              (array/some (array/drop @pa 1) (fn po
                                                                (and (validate/object @po)
                                                                  (let ((pmo (as @po CycMap)))
                                                                    (and (!= @pmo null) (object/has @pmo "emit")))))))))))))
                                              (if (validate/object @pe)
                                                (let ((pm2 (as @pe CycMap)))
                                                  (if (= @pm2 null) false
                                                    (let ((pe2 (object/get @pm2 "emit" null))) (validate/string @pe2))))
                                                false)))))) (fn pt (object/get @pt "event" ""))))))
                                    (array/flatten (array/map @lsn (fn l
                                      (let ((lev (object/get @l "event" ""))
                                            (trig (object/get @l "triggers" (object/get @l "event" "")))
                                            (src (object/get @l "source" {}))
                                            (lsc (object/get @l "scope" ""))
                                            (lguard (and (object/has @l "guard") (!= (object/get @l "guard" null) null))))
                                        (let ((sk (object/get @src "kind" ""))
                                              (st (object/get @src "trait" ""))
                                              (so (object/get @src "orbital" "")))
                                          (if (and (not (array/includes @lifecycle @trig)) (not @lguard) (array/includes @propEvs @trig))
                                            (array/map (array/filter (object/get @rbe (str/replaceAll (str/replaceAll @lev "~" "~t") "." "~d") @norows) (fn r
                                              (and (not (object/get @r "guarded"))
                                                   (!= (object/get @r "tr") @tdn)
                                                   (if (= @sk "trait") (= @st (object/get @r "tr"))
                                                     (if (= @sk "orbital") (and (= @so (object/get @r "orb")) (= @st (object/get @r "tr"))) true))
                                                   (or (= (object/get @r "orb") @on)
                                                       (or (array/some @externals (fn xx (and (= (object/get @xx "tr") (object/get @r "tr")) (= (object/get @xx "ev") @lev))))
                                                           (= @lsc "external")
                                                           (= @sk "orbital"))))))
                                              (fn r2 (let ((fm (str/concat (object/get @r2 "tr") "." (object/get @r2 "arm"))) (tt2 (str/concat @tdn "." @trig)))
                                                { from: @fm, to: @tt2, fk: (str/replaceAll (str/replaceAll @fm "~" "~t") "." "~d"), tk: (str/replaceAll (str/replaceAll @tt2 "~" "~t") "." "~d") })))
                                            @noedges)))))))))))))))))))
                  (let ((peeled (object/get (array/reduce (array/range 0 (+ (array/len (array/unique (array/map @edges (fn pk (object/get @pk "fk" ""))))) 1)) (let ((p0 : CycPeel { e: @edges, d: false })) @p0)
                          (fn (pst pi)
                            (let ((cur (object/get @pst "e" @noedges)))
                              (if (or (object/get @pst "d" false) (= (array/len @cur) 0)) @pst
                                (let ((fm : CycEdgeMap (array/groupBy @cur "fk")))
                                  (let ((nxt (array/filter @cur (fn pe (object/has @fm (object/get @pe "tk" ""))))))
                                    { e: @nxt, d: (= (array/len @nxt) (array/len @cur)) })))))) "e" @noedges)))
                    (if (= (array/len @peeled) 0) []
                      (let ((adj (array/map (array/unique (array/map @peeled (fn ek (object/get @ek "from" "")))) (fn af { k: @af, deps: (array/sort (array/unique (array/map (array/filter @peeled (fn ed (= (object/get @ed "from" "") @af))) (fn et (object/get @et "to" ""))))) }))))
                        (let ((keys (array/sort (array/map @adj (fn ak (object/get @ak "k" ""))))))
                          (let ((found (object/get (array/reduce (array/range 0 (+ (* 5 (array/len @peeled)) 5)) { stack: @nos, idx: @nonum, vis: @nos, found: @nos }
                                  (fn (wst wi)
                                    (let ((fd (object/get @wst "found")))
                                      (if (> (array/len @fd) 0) @wst
                                        (let ((stack (object/get @wst "stack")) (idx (object/get @wst "idx")) (vis (object/get @wst "vis")))
                                          (if (= (array/len @stack) 0)
                                            (let ((roots (array/filter @keys (fn kk (not (array/includes @vis @kk))))))
                                              (if (= (array/len @roots) 0) @wst
                                                (let ((r0 (array/first @roots))) { stack: [@r0], idx: [0], vis: (array/append @vis @r0), found: @nos })))
                                            (let ((top (array/last @stack)) (i (array/last @idx)))
                                              (let ((ae (array/find @adj (fn az (= (object/get @az "k" "") @top)))))
                                                (let ((deps (if (= @ae null) @nos (object/get @ae "deps" @nos))))
                                                  (if (>= @i (array/len @deps))
                                                    { stack: (array/dropLast @stack 1), idx: (array/dropLast @idx 1), vis: @vis, found: @nos }
                                                    (let ((d (array/nth @deps @i)))
                                                      (if (array/includes @stack @d)
                                                        { stack: @stack, idx: (array/append (array/dropLast @idx 1) (+ @i 1)), vis: @vis, found: (array/append @stack @d) }
                                                        (if (array/includes @vis @d)
                                                          { stack: @stack, idx: (array/append (array/dropLast @idx 1) (+ @i 1)), vis: @vis, found: @nos }
                                                          { stack: (array/append @stack @d), idx: (array/append (array/append (array/dropLast @idx 1) (+ @i 1)) 0), vis: (array/append @vis @d), found: @nos }))))))))))))) "found")))
                            (if (= (array/len @found) 0) []
                              [{ code: @config.codes.xCircularDependency.code, path: "traits", message: (str/concat "Circular event dependency detected: " (str/join @found " -> ")), suggestion: "Break the cycle by removing one of the listener/emitter relationships", severity: "error" }]))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "circular-dependencies", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CycProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      SHAPES_HEARD { operators : Map string CycShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every installed operators params with their types; an operator whose options param has an `emit` field can carry an async result event."
      SHAPES_UNREAD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator table does not match the shape type."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbLintInput.LINT_OPERATOR_SHAPES -> SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> SHAPES_UNREAD
    }
    config {
      codes : LintCircularDependenciesCodes = { lintOperatorShapesUnread: { code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", category: "lint", description: "The installed operator table could not be read or does not match the operator shape type, so a lint cannot run" }, xCircularDependency: { code: "ORB_X_CIRCULAR_DEPENDENCY", category: "cross", description: "Traits form a circular event dependency" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintCircularDependenciesCli -> OrbLintCircularDependenciesRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint circular-dependencies <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "circular-dependencies") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint circular-dependencies: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "circular-dependencies") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint circular-dependencies: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-circular-dependencies" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint circular-dependencies` with its arguments and working directory."
        @synonyms "orb lint circular-dependencies"
      OrbLintCircularDependencies.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintCircularDependenciesCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintCircularDependenciesOrbitalStart -> OrbLintCircularDependencies, OrbLintCircularDependenciesCli, OrbLintInput, Packs, Versions
}
