app std-orb-lint-engine [
  version: "1.0.0",
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-engine — the rule engine of the lint umbrella. For a LINT_RUN { file } it composes every file-taking std-orb-lint-* rule trait (shared-types is left out: it walks the std and io behavior trees and takes no file), asks the lint input to read and lower the file once (LINT_REQUEST), collects LINT_FOUND { rule, findings } from each rule, then asks the input for each lazy child the resolved program split off (LINT_LAZY names them; LINT_CHILD_REQUEST { index } replays every rule on that child, each rule echoing the pass's scope (empty for the program, the child's orbital) so every pass's answers are distinct deliveries (EXEC-QUEUE-4), and a child's findings' paths prefixed `lazy[<scope>].` as the compiler's validate_lazy_children prefixed them) and answers LINT_COLLECTED { findings, found } once every rule answered for the program and every child, or LINT_INPUT_UNREAD when the file cannot be read or lowered. It declares no cli hook: std-orb-lint-all (the `orb lint all` hook) and std-orb-validate and std-orb-compile (the policy lints) compose its orbital."
]
uses Spec from "almadar-std/lint-engine"
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type RuleFound = { rule : string!, findings : [OrbFinding]! }
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type LeafVal = string | number | boolean | [LeafVal?] | Map string LeafVal?
type LeafTransition = { effects : [LeafVal?] }
type LeafTick = { effects : [LeafVal?] }
type LeafMachine = { transitions : [LeafTransition] }
type LeafTrait = { name : string, stateMachine : LeafMachine, ticks : [LeafTick] }
type LeafOrbital = { name : string, traits : [LeafTrait] }
type PatternEventProp = { pattern : string!, prop : string!, field : string! }
type LsuSource = { kind : string, trait : string, orbital : string }
type LsuListen = { event : string, source : LsuSource }
type LsuEmit = { event : string }
type LsuTrait = { name : string, emits : [LsuEmit], listens : [LsuListen], stateMachine : FiredMachine }
type LsuOrbital = { name : string, traits : [LsuTrait] }
type LsuProgram = { orbitals : [LsuOrbital] }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type PgVal = string | number | boolean | [PgVal?] | Map string PgVal?
type PgCalls = [[PgVal?]]
type PgField = { type : string?, default : PgVal? }
type PgEmit = { event : string }
type PgTransition = { guard : PgVal?, effects : [PgVal?]? }
type PgTick = { guard : PgVal?, effects : [PgVal?]? }
type PgMachine = { transitions : [PgTransition]? }
type PgTrait = { name : string, stateMachine : PgMachine?, ticks : [PgTick]?, config : Map string PgField?, emits : [PgEmit]? }
type PgOrbital = { name : string, traits : [PgVal] }
type PgProgram = { orbitals : [PgOrbital], egress : [string]? }
type PgSite = { path : string!, call : [PgVal?]!, config : Map string PgField!, declared : [string]! }
type PgEmitObj = Map string PgVal?
type PgSites = [PgSite]
type PgSeg = { k : string!, id : string!, sql : string!, at : string!, em : PgEmitObj!, dc : [string]!, fs : [OrbFinding]! }
type PgShapeParam = { name : string, type : PgShapeType }
type PgShapeType = string | PgShapeNode
type PgShapeNode = { kind : string, fields : Map string PgShapeType? }
type PgShape = { minArity : number?, maxArity : number?, params : [PgShapeParam] }
type PgEmitConfigItem = { id : string!, path : string!, emit : PgEmitObj!, allowedKeys : [string]!, checkDeclared : boolean!, declared : [string]! }
type EmitConfigResult = { id : string!, findings : [OrbFinding]! }
type SqlGuardVerdict = { ok : boolean!, reason : string! }
type LnProgram = { orbitals : [HcOrbital], egress : [string]? }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]!, config : Map string HcVal?, inGuard : boolean? }
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitOrder : [string]?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type EmitResult = { id : string!, findings : [OrbFinding]! }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcClosed = { request : boolean?, intRange : HcIntRange? }
type HcOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HcOauthOp]! }
type HcGrantNeed = Map string HcVal
type HcHttpWire = { requestKeys : [string]!, bodyKeys : [string]!, queryEncodings : [string]!, authSchemes : [HcAuthScheme]!, defaultPorts : Map string number! }
type HcAuthScheme = { name : string!, keys : [string]!, required : [string]?, onUnauthorized : [string]? }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcOrbital = { name : string, traits : [HcVal] }
type CsProgramCS = { orbitals : [CsOrbitalCS], services : [CsServiceDef]? }
type SrService = { actions : Map string SrAction! }
type CsHostFact = { emitKeys : [string]? }
type SrAction = { params : [SrParam]!, hasKey : boolean! }
type SrParam = { name : string!, type : string!, required : boolean!, kind : string! }
type CsOrbitalCS = { name : string, traits : [CsVal] }
type CsServiceDef = { name : string }
type CsVal = string | number | boolean | [CsVal?] | Map string CsVal?
type EwProgram = { orbitals : [EwOrbital] }
type EwOrbital = { name : string, traits : [EwTrait] }
type EwTrait = { name : string, sourceBehavior : EwSb?, emits : [EwEmit], listens : [EwListen], stateMachine : EwMachine, ticks : [EwTick] }
type EwSb = { behavior : string }
type EwEmit = { event : string, scope : string, definerKnob : string, scopeOverridden : boolean }
type EwListen = { event : string, triggers : string, scope : string, source : EwSource }
type EwMachine = { transitions : [EwTransition] }
type EwTick = { effects : [EwNode?] }
type EwNode = string | number | boolean | [EwNode?] | Map string EwNode?
type EwTransition = { event : string, effects : [EwNode?] }
type EwSource = { kind : string, trait : string, orbital : string }
type LnProgramHE = { orbitals : [HcOrbital] }
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitKeys : [string]? }
type CiNode = string | number | boolean | [CiNode?] | Map string CiNode?

