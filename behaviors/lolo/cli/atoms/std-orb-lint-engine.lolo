  uses ThemeUndeclared from "std/behaviors/std-orb-lint-theme-undeclared"
  uses ItemActionEvent from "std/behaviors/std-orb-lint-item-action-event"
  uses FieldPath from "std/behaviors/std-orb-lint-field-path"
  uses RenderUiPattern from "std/behaviors/std-orb-lint-render-ui-pattern"
  uses HttpSite from "std/behaviors/std-orb-lint-http-site"
  uses KeyedCallKeys from "std/behaviors/std-orb-lint-keyed-call-keys"
  uses Postgres from "std/behaviors/std-orb-lint-postgres"
  uses Redis from "std/behaviors/std-orb-lint-redis"
  uses CrossEmitter from "std/behaviors/std-orb-lint-cross-emitter"
  uses CrossRegistry from "std/behaviors/std-orb-lint-cross-registry"
  uses SigilContext from "std/behaviors/std-orb-lint-sigil-context"
  uses TimeUnit from "std/behaviors/std-orb-lint-time-unit"
  uses UserFieldExists from "std/behaviors/std-orb-lint-user-field-exists"
  uses ConfigRoleLists from "std/behaviors/std-orb-lint-config-role-lists"
  uses BindingFields from "std/behaviors/std-orb-lint-binding-fields"
  uses BindingRoots from "std/behaviors/std-orb-lint-binding-roots"
  uses BindingSetters from "std/behaviors/std-orb-lint-binding-setters"
  uses BindingTraits from "std/behaviors/std-orb-lint-binding-traits"
  uses BrowserEffects from "std/behaviors/std-orb-lint-browser-effects"
  uses CallService from "std/behaviors/std-orb-lint-call-service"
  uses CircuitClientBound from "std/behaviors/std-orb-lint-circuit-client-bound"
  uses CircuitEmits from "std/behaviors/std-orb-lint-circuit-emits"
  uses CircuitGraph from "std/behaviors/std-orb-lint-circuit-graph"
  uses CircuitItemActions from "std/behaviors/std-orb-lint-circuit-item-actions"
  uses ComposedWiring from "std/behaviors/std-orb-lint-composed-wiring"
  uses ConfigDanglingRef from "std/behaviors/std-orb-lint-config-dangling-ref"
  uses ConfigKnob from "std/behaviors/std-orb-lint-config-knob"
  uses DispatchContract from "std/behaviors/std-orb-lint-dispatch-contract"
  uses EffectForms from "std/behaviors/std-orb-lint-effect-forms"
  uses EmbedConfigForward from "std/behaviors/std-orb-lint-embed-config-forward"
  uses EmitDeclaration from "std/behaviors/std-orb-lint-emit-declaration"
  uses EntityMutation from "std/behaviors/std-orb-lint-entity-mutation"
  uses EventWiring from "std/behaviors/std-orb-lint-event-wiring"
  uses FetchDeliver from "std/behaviors/std-orb-lint-fetch-deliver"
  uses GroupbyEnumColumnGap from "std/behaviors/std-orb-lint-groupby-enum-column-gap"
  uses HostEffects from "std/behaviors/std-orb-lint-host-effects"
  uses HttpRequest from "std/behaviors/std-orb-lint-http-request"
  uses IconExists from "std/behaviors/std-orb-lint-icon-exists"
  uses MergedFields from "std/behaviors/std-orb-lint-merged-fields"
  uses Oauth from "std/behaviors/std-orb-lint-oauth"
  uses OrbitalRefConfig from "std/behaviors/std-orb-lint-orbital-ref-config"
  uses PageContentOwner from "std/behaviors/std-orb-lint-page-content-owner"
  uses PatternProps from "std/behaviors/std-orb-lint-pattern-props"
  uses Placement from "std/behaviors/std-orb-lint-placement"
  uses RuiBinding from "std/behaviors/std-orb-lint-rui-binding"
  uses RuiEffects from "std/behaviors/std-orb-lint-rui-effects"
  uses ServiceDef from "std/behaviors/std-orb-lint-service-def"
  uses SetColumn from "std/behaviors/std-orb-lint-set-column"
  uses SexprBinding from "std/behaviors/std-orb-lint-sexpr-binding"
  uses SlotTick from "std/behaviors/std-orb-lint-slot-tick"
  uses ThemeRef from "std/behaviors/std-orb-lint-theme-ref"
  uses ThemeValues from "std/behaviors/std-orb-lint-theme-values"
  uses TraitEmbeds from "std/behaviors/std-orb-lint-trait-embeds"
  uses TraitMounts from "std/behaviors/std-orb-lint-trait-mounts"
  uses TraitRefs from "std/behaviors/std-orb-lint-trait-refs"
  uses Hc from "std/behaviors/std-orb-lint-host-calls"
  uses Sr from "std/behaviors/std-orb-lint-service-registry"
  uses Vl from "std/behaviors/std-orb-value-leaves"
  uses Chain from "std/behaviors/std-orb-embed-chain"
  uses Leaves from "std/behaviors/std-orb-effect-leaves"
  uses Pp from "std/behaviors/std-orb-produced-program"
  uses Ec from "std/behaviors/std-orb-emit-config"
  uses Sg from "std/behaviors/std-sql-select-guard"
  uses EcR from "std/behaviors/std-orb-emit-config-redis"

  entity OrbLintEngineRun [runtime] {
    id : string!
    found : [RuleFound] = []
    done : [RuleFound] = []
    orbitals : [string] = []
    child : number = 0
  }

  trait OrbLintEngine -> OrbLintEngineRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> collecting
        (set @entity.found [])
        (set @entity.done [])
        (set @entity.orbitals [])
        (set @entity.child 0)
        (emit LINT_REQUEST { file: @payload.file })
        (emit LINT_CALL_SITES_REQUEST { file: @payload.file, stamp: true, references: true })
    }

    state collecting {
      INIT -> collecting
      LINT_LAZY_HEARD -> collecting
        (set @entity.orbitals @payload.orbitals)
      LINT_FOUND -> collecting
        (set @entity.found (array/concat @entity.found [{ rule: @payload.rule, findings: (if (= @payload.scope "") @payload.findings (let ((prefix (str/concat "lazy[" @payload.scope "]."))) (array/map @payload.findings (fn f (object/merge @f { path: (str/concat @prefix (object/get @f "path")) }))))) }]))
        (emit LINT_SETTLE { })
      LINT_INPUT_UNREAD -> ready
      LINT_SETTLE -> collecting when (< (array/len @entity.found) (if (= @entity.child 0) @config.ruleCount (- @config.ruleCount @config.programOnlyCount)))
      LINT_SETTLE -> collecting when (and (>= (array/len @entity.found) (if (= @entity.child 0) @config.ruleCount (- @config.ruleCount @config.programOnlyCount))) (< @entity.child (array/len @entity.orbitals)))
        (set @entity.done (array/concat @entity.done @entity.found))
        (set @entity.found [])
        (set @entity.child (+ @entity.child 1))
        (emit LINT_CHILD_REQUEST { index: (- @entity.child 1) })
      LINT_SETTLE -> ready when (and (>= (array/len @entity.found) (if (= @entity.child 0) @config.ruleCount (- @config.ruleCount @config.programOnlyCount))) (>= @entity.child (array/len @entity.orbitals)))
        (emit LINT_COLLECTED { findings: (array/flatten (array/map (array/concat @entity.done @entity.found) (fn r (object/get @r "findings")))), found: (array/concat @entity.done @entity.found) })
    }

    emits {
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file once for every rule."
        @tier "internal"
      LINT_CALL_SITES_REQUEST -> external { file : string!  stamp : boolean!  references : boolean! }
        @description "Ask the call sites input to read the file once for the composition rules: the stamped program of a ledger-less .orb and the references with their declarations."
        @tier "internal"
      LINT_CHILD_REQUEST -> external { index : number! }
        @description "Ask the lint input to offer every rule the lazy child at this index."
        @tier "internal"
      LINT_COLLECTED -> external { findings : [OrbFinding]!  found : [RuleFound]! }
        @description "Every rule's findings for the file and its lazy children, flattened, and the findings by rule (one entry per rule per program): the structured answer of a run, heard by the hook and by a program that composes the engine (std-orb-validate)."
        @tier "internal"
      LINT_SETTLE { }
        @description "Internal: check whether every rule answered."
        @tier "internal"
    }

    config {
      ruleCount : number = 138
        @label "Rule count"
        @description "How many composed rule traits answer LINT_FOUND before the run settles."
      programOnlyCount : number = 4
        @label "Program-pass-only rules"
        @description "How many of those rules read the call sites input and answer once, for the program pass only: a lazy child's pass waits for the others."
    }

    listens {
      LINT_RUN { file : string! }
        @description "Run every lint rule over this file; the cli hook and std-orb-validate emit it."
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
      LINT_FOUND { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "One rule atom's findings for the file or the lazy child being linted."
      LINT_LAZY_HEARD { orbitals : [string]! }
        @description "std-orb-lint-input's LINT_LAZY: the lazy children to lint after the program."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
      CallSiteInput.LINT_CALL_SITES_UNREAD -> LINT_INPUT_UNREAD
      OrbLintInput.LINT_LAZY -> LINT_LAZY_HEARD
      OrbLintCollectionPolicy.LINT_FOUND -> LINT_FOUND
      OrbLintCrossDuplicateEntity.LINT_FOUND -> LINT_FOUND
      OrbLintEmitConfigRef.LINT_FOUND -> LINT_FOUND
      OrbLintEntityBrowserStorage.LINT_FOUND -> LINT_FOUND
      OrbLintEntityDuplicateField.LINT_FOUND -> LINT_FOUND
      OrbLintEntityEmptyEnum.LINT_FOUND -> LINT_FOUND
      OrbLintEntityFieldType.LINT_FOUND -> LINT_FOUND
      OrbLintEntityLocaleInstances.LINT_FOUND -> LINT_FOUND
