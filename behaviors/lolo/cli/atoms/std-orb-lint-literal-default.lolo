app std-orb-lint-literal-default [
  version: "1.0.0",
  inbound: ["cli-lint-literal-default"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-literal-default — the `orb lint literal-default <file>` command, the port of ORB_E_LITERAL_UNION_DEFAULT_MISMATCH. It lowers the file with program/read and, for every orbital's inline entity, checks each field that declares a non-empty values list and a string default: the default must be one of the values. Each mismatch is reported with its path and suggestion (status 500, exit 1). A non-string default is not this rule's business. Clean answers `lint literal-default: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-literal-default"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type LiteralValue = string | number | boolean | [LiteralValue] | Map string LiteralValue
type LiteralField = { name : string, values : [string], default : LiteralValue }
type LiteralEntity = { name : string, fields : [LiteralField] }
type LiteralOrbital = { entity : LiteralEntity }
type LiteralProgram = { orbitals : [LiteralOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintLiteralDefaultOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintLiteralDefaultRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintLiteralDefault -> OrbLintLiteralDefaultRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((ent (object/get @o "entity" {})))
                (if (validate/object @ent) (let ((fields (object/get @ent "fields" [])))
                  (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                    (let ((fld (array/nth @fields @fi)))
                      (let ((vals (object/get @fld "values" [])) (dv (object/get @fld "default" "")))
                        (if (or (= (array/len @vals) 0) (not (object/has @fld "default")) (not (validate/string @dv)) (array/includes @vals @dv))
                          []
                          (let ((label (object/get @fld "name" (str/concat "[index " @fi "]"))))
                            (let ((joined (str/join @vals ", ")))
                              [{ code: "ORB_E_LITERAL_UNION_DEFAULT_MISMATCH", path: (str/concat "orbitals[" @oi "].entity(" (object/get @ent "name" "") ").fields[" @fi "](" @label ")"), message: (str/concat "Field '" @label "' default '" @dv "' is not one of the declared values [" @joined "]"), suggestion: (str/concat "Pick a default from [" @joined "] or add '" @dv "' to the values list"), severity: "error" }]))))))))) []))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "literal-default", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LiteralProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintLiteralDefaultCli -> OrbLintLiteralDefaultRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint literal-default <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "literal-default") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint literal-default: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "literal-default") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint literal-default: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-literal-default" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint literal-default` with its arguments and working directory."
        @synonyms "orb lint literal-default, orb lint literal-default, values union default"
      OrbLintLiteralDefault.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintLiteralDefaultCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintLiteralDefaultOrbitalStart -> OrbLintLiteralDefault, OrbLintLiteralDefaultCli, OrbLintInput, Packs, Versions
}
