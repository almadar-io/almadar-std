app std-orb-lint-literal-default [
  version: "1.0.0",
  inbound: ["cli-lint-literal-default"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-literal-default — the `orb lint literal-default <file>` command, the port of ORB_E_LITERAL_UNION_DEFAULT_MISMATCH. It lowers the file with program/read and, for every orbital's inline entity, checks each field that declares a non-empty values list and a string default: the default must be one of the values. Each mismatch is reported with its path and suggestion (status 500, exit 1). A non-string default is not this rule's business. Clean answers `lint literal-default: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-literal-default"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintLiteralDefaultOrbital {
  entity OrbLintLiteralDefaultRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintLiteralDefault -> OrbLintLiteralDefaultRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "literal-default", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((ent (object/get @o "entity" {})))
                (if (validate/object @ent) (let ((fields (object/get @ent "fields" [])))
                  (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                    (let ((fld (array/nth @fields @fi)))
                      (let ((vals (object/get @fld "values" [])))
                        (if (or (= (array/len @vals) 0) (not (object/has @fld "default")) (not (str/startsWith (json/stringify (object/get @fld "default")) "\"")) (array/includes @vals (object/get @fld "default")))
                          []
                          (let ((label (object/get @fld "name" (str/concat "[index " @fi "]"))))
                            (let ((joined (str/join @vals ", ")))
                              [(str/concat "[ORB_E_LITERAL_UNION_DEFAULT_MISMATCH] orbitals[" @oi "].entity(" (object/get @ent "name" "") ").fields[" @fi "](" @label "): Field '" @label "' default '" (object/get @fld "default") "' is not one of the declared values [" @joined "]\n  suggestion: Pick a default from [" @joined "] or add '" (object/get @fld "default") "' to the values list")]))))))))) []))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "literal-default" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintLiteralDefaultCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintLiteralDefaultCli -> OrbLintLiteralDefaultRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint literal-default <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "literal-default") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint literal-default: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "literal-default") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "literal-default")
        (emit LINT_ANSWERED { status: 500, body: "lint literal-default: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-literal-default" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint literal-default` with its arguments and working directory."
        @synonyms "orb lint literal-default, orb lint literal-default, values union default"
      OrbLintLiteralDefault.LINT_FOUND -> LINT_FOUND
      OrbLintLiteralDefault.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-literal-default" as OrbLintLiteralDefaultPage -> OrbLintLiteralDefault, OrbLintLiteralDefaultCli
}
