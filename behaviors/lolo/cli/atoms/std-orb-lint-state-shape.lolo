app std-orb-lint-state-shape [
  version: "1.0.0",
  inbound: ["cli-lint-state-shape"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-state-shape — the `orb lint state-shape <file>` command, the port of ORB_T_DUPLICATE_STATE, ORB_T_MULTIPLE_INITIAL_STATES and ORB_T_NO_INITIAL_STATE (trait_validator.rs validate_state_machine). It lowers the file with program/read and, for every inline trait with a state machine, reports an empty state list (and stops there), each repeated state name, no initial state, and several initial states (listed as the Rust debug form), each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint state-shape: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-state-shape"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type StateShapeState = { name : string, isInitial : boolean }
type StateShapeArm = { event : string, from : string | [string] }
type StateShapeEvent = { key : string, external : boolean }
type StateShapeMachine = { states : [StateShapeState], transitions : [StateShapeArm], events : [StateShapeEvent] }
type StateShapeTrait = { category : string, stateMachine : StateShapeMachine }
type StateShapeOrbital = { traits : [StateShapeTrait] }
type StateShapeProgram = { orbitals : [StateShapeOrbital] }

orbital OrbLintStateShapeOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintStateShapeRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintStateShape -> OrbLintStateShapeRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((trList (object/get (array/nth @orbitals @oi) "traits" [])))
              (array/flatten (array/map (array/range 0 (array/len @trList)) (fn ti
                (let ((td (array/nth @trList @ti)))
                  (if (not (validate/object (object/get @td "stateMachine" null)))
                    []
                    (let ((sm (object/get @td "stateMachine")) (tpath (str/concat "orbitals[" @oi "].traits[" @ti "]")))
                      (let ((sts (object/get @sm "states" [])) (where (str/concat @tpath ".stateMachine")))
                        (if (= (array/len @sts) 0)
                          [{ code: "ORB_T_NO_INITIAL_STATE", path: (str/concat @where ".states"), message: "State machine must have at least one state", suggestion: "Add at least one state to the state machine", severity: "error" }]
                          (let ((names (array/map @sts (fn s (object/get @s "name" "")))) (inits (array/map (array/filter @sts (fn s (= (object/get @s "isInitial" false) true))) (fn s (object/get @s "name" "")))))
                            (array/flatten [
                              (array/flatten (array/map (array/range 0 (array/len @sts)) (fn k (if (array/includes (array/take @names @k) (array/nth @names @k)) [{ code: "ORB_T_DUPLICATE_STATE", path: (str/concat @where ".states[" @k "]"), message: (str/concat "Duplicate state name: '" (array/nth @names @k) "'"), suggestion: "Each state must have a unique name", severity: "error" }] []))))
                              (if (= (array/len @inits) 0) [{ code: "ORB_T_NO_INITIAL_STATE", path: (str/concat @where ".states"), message: "State machine must have an initial state", suggestion: "Mark one state with isInitial: true", severity: "error" }] [])
                              (if (> (array/len @inits) 1) [{ code: "ORB_T_MULTIPLE_INITIAL_STATES", path: (str/concat @where ".states"), message: (str/concat "Multiple initial states found: [" (str/join (array/map @inits (fn n (str/concat "\"" @n "\""))) ", ") "]"), suggestion: "Only one state should be marked as initial", severity: "error" }] [])
                              (if (and (> (array/len @inits) 0) (or (not (object/has @td "category")) (= (object/get @td "category") "interaction")))
                                (let ((init0 (array/first @inits)))
                                  (if (array/some (object/get @sm "transitions" []) (fn tr (and (= (object/get @tr "event" "") "INIT") (let ((frm (object/get @tr "from" ""))) (let ((froms (if (validate/string @frm) (array/append [] @frm) @frm))) (or (array/includes @froms @init0) (array/includes @froms "*")))))))
                                    []
                                    [{ code: "ORB_T_MISSING_INIT_TRANSITION", path: (str/concat @where ".transitions"), message: (str/concat "Interaction trait should have INIT transition on initial state '" @init0 "'"), suggestion: "Add a transition: { from: 'initialState', to: 'initialState', event: 'INIT', effects: [...] }", severity: "error" }]))
                                [])
                              (if (> (array/len @inits) 0)
                                (let ((init0 (array/first @inits)))
                                  (array/flatten (array/map (array/range 0 (array/len (object/get @sm "events" []))) (fn ei
                                    (let ((ev (array/nth (object/get @sm "events" []) @ei)))
                                      (if (and (= (object/get @ev "external" false) true)
                                               (not (array/some (object/get @sm "transitions" []) (fn tr (and (= (object/get @tr "event" "") (object/get @ev "key" "")) (let ((frm (object/get @tr "from" ""))) (let ((froms (if (validate/string @frm) (array/append [] @frm) @frm))) (or (array/includes @froms @init0) (array/includes @froms "*")))))))))
                                        [{ code: "ORB_T_EXTERNAL_INPUT_NOT_RESTING", path: (str/concat @where ".events[" @ei "]"), message: (str/concat "External input '" (object/get @ev "key" "") "' is not accepted from the initial state '" @init0 "'"), suggestion: "Declare as external only a complete command the trait handles from its initial state (e.g. a persistor's DO_CREATE), or add that transition", severity: "error" }]
                                        []))))))
                                [])]))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "state-shape", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : StateShapeProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintStateShapeCli -> OrbLintStateShapeRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint state-shape <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "state-shape") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint state-shape: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "state-shape") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint state-shape: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-state-shape" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint state-shape` with its arguments and working directory."
        @synonyms "orb lint state-shape"
      OrbLintStateShape.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintStateShapeCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintStateShapeOrbitalStart -> OrbLintStateShape, OrbLintStateShapeCli, OrbLintInput, Packs, Versions
}
