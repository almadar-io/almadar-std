app std-orb-lint-sigil-context [
  version: "1.0.0",
  inbound: ["cli-lint-sigil-context"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-sigil-context - the `orb lint sigil-context <file>` command, the port of ORB_BINDING_UNKNOWN_ROOT and ORB_BINDING_PAYLOAD_IN_TICK (traits/sigil_context.rs). It lowers the file with program/read and walks the guard and effects of every inline trait transition (guard and effect context) the `@ensures` of every transition (guard sigils plus the `ensuresSigils` knob), the `@holds` of every state and the invariants of every entity and auxiliary entity (guard sigils), and the effects of every tick (tick context): every `@root` binding string must name a sigil the installed @almadar/core binding rules allow in that context (read from LINT_LANGUAGE_FACTS), unless it is bound by an enclosing `(fn (x) ...)` parameter, a sequential `let` name, or, inside a collection callback (a collection or std-array operator of two or more arguments in the installed operator table, read from LINT_OPERATOR_SHAPES), `item` / `index`. `@item` / `@index` outside a callback get the out-of-scope diagnostic; `@payload` in a tick is ORB_BINDING_PAYLOAD_IN_TICK; PascalCase roots (entity bindings) are skipped. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint sigil-context: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-sigil-context"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type SgShape = string | number | boolean | [SgShape?] | Map string SgShape?
type SgTransition = { guard : SgShape?, effects : [SgShape], ensures : [SgShape]? }
type SgTick = { effects : [SgShape] }
type SgState = { holds : SgShape? }
type SgMachine = { transitions : [SgTransition], states : [SgState]? }
type SgTrait = { name : string, stateMachine : SgMachine, ticks : [SgTick] }
type SgEntity = { invariants : [SgShape] }
type SgOrbital = { name : string, traits : [SgTrait], entity : SgEntity?, auxiliaryEntities : [SgEntity]? }
type SgProgram = { orbitals : [SgOrbital]! }
type SgOpShape = { category : string, minArity : number }
type SgProgType = { type : string }
type SgHit = { ip : string, rel : string, r : string }
type SgAtHit = { ip : string!, path : string!, r : string!, at : number! }
type SgAtNode = { path : string!, node : string!, at : number! }
type SgAtIdx = Map string [SgAtNode]
type SgCall = { path : string!, node : SgShape! }
type SgIdx = Map string [SgCall]
type SgPair = { pfx : string!, before : [string]! }
type SgScope = { ip : string!, q : string!, qb : string!, ql : number!, kind : string!, names : [string]!, pairs : [SgPair]! }
type SgRoot = { x : SgShape?, w : string!, c : string! }

type GtCallHit = { path : string, node : GtVal?, at : number }
type GtVal = string | number | boolean | [GtVal?] | Map string GtVal?
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintSigilContextCodes = { bindingPayloadInTick : LintCodeDecl , bindingUnknownRoot : LintCodeDecl , lintOperatorShapesUnread : LintCodeDecl , lintLanguageFactsUnread : LintCodeDecl , lintIndexMissing : LintCodeDecl }

orbital OrbLintSigilContextOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintSigilContextRun [runtime] {
    iRoots : Map string [string] = {}
    indexHeard : boolean = false
    indexScope : string = ""
    sGuardRoots : Map string [string] = {}
    sitesGuardHeard : boolean = false
    sitesGuardScope : string = ""
    uItem : Map string [string] = {}
    uGuardItem : Map string [string] = {}
    unitsHeard : boolean = false
    unitsScope : string = ""
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    collOps : [string] = []
    guardAllowed : [string] = []
    effectAllowed : [string] = []
    tickAllowed : [string] = []
    shapesUnread : boolean = false
    factsUnread : boolean = false
  }

  trait OrbLintSigilContext -> OrbLintSigilContextRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SHAPES_HEARD -> ready
        (set @entity.shapesUnread false)
        (set @entity.collOps (array/filter (object/keys @payload.operators) (fn k (and (or (= (object/get (object/get @payload.operators @k) "category" "") "collection") (= (object/get (object/get @payload.operators @k) "category" "") "std-array")) (>= (object/get (object/get @payload.operators @k) "minArity" 0) 2)))))
      SHAPES_UNREAD -> ready
        (set @entity.shapesUnread true)
      FACTS_HEARD -> ready
        (set @entity.factsUnread false)
        (set @entity.guardAllowed @payload.guardSigils)
        (set @entity.effectAllowed @payload.effectSigils)
        (set @entity.tickAllowed @payload.tickSigils)
      FACTS_UNREAD -> ready
        (set @entity.factsUnread true)
      INDEX_HEARD -> ready
        (set @entity.iRoots @payload.roots)
        (set @entity.indexHeard true)
        (set @entity.indexScope @payload.scope)
      SITES_HEARD -> ready
        (set @entity.sGuardRoots @payload.guardRoots)
        (set @entity.sitesGuardHeard true)
        (set @entity.sitesGuardScope @payload.scope)
      UNITS_HEARD -> ready
        (set @entity.uItem @payload.itemRoots)
        (set @entity.uGuardItem @payload.guardItemRoots)
        (set @entity.unitsHeard true)
        (set @entity.unitsScope @payload.scope)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (and @entity.indexHeard (= @entity.indexScope @payload.scope) @entity.sitesGuardHeard (= @entity.sitesGuardScope @payload.scope) @entity.unitsHeard (= @entity.unitsScope @payload.scope))
(let ((nohits : [SgHit] []) (noroots : [SgRoot] []) (nostr : [string] []) (nohits0 : [SgAtHit] [])  (nof : [OrbFinding] []) (collSet : Map string boolean (default (object/fromEntries (array/map @entity.collOps (fn c [@c true]))) {})) (orbitals : [SgOrbital] (object/get @payload.program "orbitals" [])) (eAt : [string] (array/map @entity.effectAllowed (fn a (str/concat (quote "@") @a)))) (gAt : [string] (array/map @entity.guardAllowed (fn a (str/concat (quote "@") @a)))))
  (if (or @entity.shapesUnread @entity.factsUnread)
    (array/concat
      (if @entity.shapesUnread [{ code: @config.codes.lintOperatorShapesUnread.code, path: "operators", message: "the installed @almadar/std operator table does not match the operator shape type, so the collection callback operators are unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }] @nof)
      (if @entity.factsUnread [{ code: @config.codes.lintLanguageFactsUnread.code, path: "bindingRules", message: "the installed @almadar/core language facts could not be read, so the sigils allowed in a guard, an effect and a tick are unknown", suggestion: "Reinstall @almadar/core so its orbLanguage declares bindingRules", severity: "error" }] @nof))
    (let ((roots : [SgRoot] (array/flatten
  (array/map @orbitals
    (fn o
      (let ((oi @index))
        (let ((trts : [SgTrait] (object/get @o "traits" [])))
          (array/concat
            (array/flatten
              (array/map @trts
                (fn t
                  (let ((ti @index))
                    (if (not (object/has @t "stateMachine"))
                      @noroots
                      (let ((tp (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]")) (trs : [SgTransition] (object/get @t "stateMachine.transitions" [])) (tks : [SgTick] (object/get @t "ticks" [])))
                      (array/concat
                        (array/flatten
                          (array/map @trs
                            (fn tr
                              (let ((xp (str/concat @tp ".stateMachine.transitions[" @index "]")) (uni (str/concat @oi "-" @ti "-" @index)))
                                (let ((effs : [SgShape] (object/get @tr "effects" [])) (g (object/get @tr "guard" null)))
                                  (array/concat
                                    (array/concat
                                      (if (and (!= @g null) (or (!= (object/get @entity.uGuardItem @uni null) null) (array/some (object/get @entity.sGuardRoots @uni @nostr) (fn r (not (array/includes @gAt @r)))))) [{ x: @g, w: (str/concat @xp ".guard"), c: "guard" }] @noroots)
                                      (if (or (!= (object/get @entity.uItem @uni null) null) (array/some (object/get @entity.iRoots @uni @nostr) (fn r (not (array/includes @eAt @r))))) (array/map @effs (fn e { x: @e, w: (str/concat @xp ".effects[" @index "]"), c: "effect" })) @noroots))
                                    (let ((ens : [SgShape] (object/get @tr "ensures" [])))
                                      (array/map @ens (fn e { x: @e, w: (str/concat @xp ".ensures[" @index "]"), c: "ensures" })))))))))
                        (array/concat
                        (let ((sts : [SgState] (object/get @t "stateMachine.states" [])))
                          (array/flatten
                            (array/map @sts
                              (fn st
                                (let ((h (object/get @st "holds" null)))
                                  (if (!= @h null) [{ x: @h, w: (str/concat @tp ".stateMachine.states[" @index "].holds"), c: "holds" }] @noroots))))))
                        (array/flatten
                          (array/map @tks
                            (fn tk
                              (let ((ki @index) (teffs : [SgShape] (object/get @tk "effects" [])))
                                (array/map @teffs (fn e { x: @e, w: (str/concat @tp ".ticks[" @ki "].effects[" @index "]"), c: "tick" }))))))))))))))
            (array/concat
            (let ((ent (object/get @o "entity" null)))
              (if (validate/object @ent)
                (let ((invs : [SgShape] (object/get @ent "invariants" [])))
                  (let ((r : [SgRoot] (array/map @invs (fn iv { x: @iv, w: (str/concat "orbitals[" @oi "].entity.invariants[" @index "]"), c: "invariant" })))) @r))
                @noroots))
            (let ((auxs : [SgEntity] (object/get @o "auxiliaryEntities" [])))
              (array/flatten
                (array/map @auxs
                  (fn a
                    (let ((ai @index) (invs : [SgShape] (object/get @a "invariants" [])))
                      (let ((r : [SgRoot] (array/map @invs (fn iv { x: @iv, w: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "].invariants[" @index "]"), c: "invariant" })))) @r)))))))))))))))
      (let ((collHeads : [string] (array/concat ["fn" "let"] @entity.collOps)) (aMap : Map string [string] { guard: @entity.guardAllowed, effect: @entity.effectAllowed, tick: @entity.tickAllowed, ensures: (array/concat @entity.guardAllowed @config.ensuresSigils), holds: @entity.guardAllowed, invariant: @entity.guardAllowed }) (cs : [string] (array/map @roots (fn r (object/get @r "c" "")))) (ws : [string] (array/map @roots (fn r (object/get @r "w" "")))))
  (let ((raw (tree/index @roots @collHeads { prefixes: [(quote "@")] })))
    (let ((byNode : Map string [SgAtNode] (array/groupBy (array/flatten (object/values (default (as (object/omit @raw @collHeads) SgAtIdx) {}))) "node")))
    (let ((ats : [SgAtHit] (array/sort (array/flatten (array/map (object/entries @byNode) (fn en
            (let ((nd : string (array/nth @en 0)) (rt (str/replace-pattern (str/replaceAll (str/slice @nd 1) "[" ".") "\..*$" "")) (hits : [SgAtNode] (array/nth @en 1)))
              (if (or (< (str/len @nd) 2) (= @rt "") (validate/pattern @rt "^[A-Z]"))
                @nohits0
                (array/map (if (or (= @rt "item") (= @rt "index")) @hits (array/filter @hits (fn a (not (array/includes (object/get @aMap (default (array/nth @cs (default (str/to-int (str/slice (default (array/first (str/split (object/get @a "path" "") "]")) "") 1)) 0)) "") @nostr) @rt)))))
                  (fn a { ip: (str/slice (default (array/first (str/split (object/get @a "path" "") "]")) "") 1), path: (object/get @a "path" ""), r: @rt, at: (object/get @a "at" 0) }))))))) "at")))
      (if (= (array/len @ats) 0)
        @nof
        (let ((cset : Map string boolean (default (object/fromEntries (array/map @ats (fn h [(object/get @h "ip" ""), true]))) {})) (ix (default (as (object/omit @raw [(quote "@")]) SgIdx) {})))
          (let ((ssBy : Map string [SgScope] (array/groupBy (array/flatten (array/map (array/filter (array/flatten (object/values @ix)) (fn c (object/has @cset (str/slice (default (array/first (str/split (object/get @c "path" "") "]")) "") 1)))) (fn c
                  (let ((cn (object/get @c "node" null)) (q (object/get @c "path" "")))
                    (if (not (and (validate/array @cn) (>= (array/len @cn) 3)))
                      []
                      (let ((p1 (array/nth @cn 1)) (op (array/nth @cn 0)) (ip (str/slice (default (array/first (str/split @q "]")) "") 1)))
                        (if (and (= (array/len @cn) 3) (= @op "fn"))
                          [{ ip: @ip, q: @q, qb: (str/concat @q "["), ql: (str/len @q), kind: "fn", names: (if (validate/array @p1) (array/flatten (array/map @p1 (fn x (if (validate/string @x) [@x] @nostr)))) (if (validate/string @p1) [@p1] @nostr)), pairs: [] }]
                          (if (and (= (array/len @cn) 3) (= @op "let"))
                            (if (validate/array @p1)
                              (let ((nms (array/map @p1 (fn pr (if (and (validate/array @pr) (> (array/len @pr) 0)) (let ((nm0 (array/nth @pr 0))) (if (validate/string @nm0) [@nm0] @nostr)) @nostr)))))
                                [{ ip: @ip, q: @q, qb: (str/concat @q "["), ql: (str/len @q), kind: "la", names: (array/flatten @nms), pairs: (array/map (array/range 0 (array/len @p1)) (fn bi { pfx: (str/concat "[1][" @bi "][1]"), before: (array/flatten (array/slice @nms 0 @bi)) })) }])
                              (if (validate/object @p1)
                                [{ ip: @ip, q: @q, qb: (str/concat @q "["), ql: (str/len @q), kind: "lo", names: (object/keys @p1), pairs: [] }]
                                [{ ip: @ip, q: @q, qb: (str/concat @q "["), ql: (str/len @q), kind: "l0", names: @nostr, pairs: [] }]))
                            (if (and (validate/string @op) (object/has @collSet @op))
                              [{ ip: @ip, q: @q, qb: (str/concat @q "["), ql: (str/len @q), kind: "co", names: ["item" "index"], pairs: [] }]
                              []))))))))) "ip")))
            (let ((hs : [SgAtHit] (array/filter @ats (fn hit
                    (let ((hp (object/get @hit "path" "")) (rt (object/get @hit "r" "")))
                      (not (array/some (object/get @ssBy (object/get @hit "ip" "") [])
                        (fn s
                          (and (str/startsWith @hp (object/get @s "qb"))
                            (let ((sfx (str/slice @hp (object/get @s "ql"))) (kind (object/get @s "kind")) (names : [string] (object/get @s "names")))
                              (if (= @kind "co")
                                (or (str/startsWith @sfx "[0]") (and (not (str/startsWith @sfx "[1]")) (array/includes @names @rt)))
                                (if (str/startsWith @sfx "[2]")
                                  (array/includes @names @rt)
                                  (if (= @kind "lo")
                                    (or (not (str/startsWith @sfx "[1]")) (array/includes @names @rt))
                                    (if (= @kind "la")
                                      (let ((pf (array/find (object/get @s "pairs") (fn pq (str/startsWith @sfx (object/get @pq "pfx"))))))
                                        (or (= @pf null) (array/includes (object/get @pf "before") @rt)))
                                      true))))))))))))))
              (array/map @hs
                (fn h
                  (let ((root (object/get @h "r" "")) (rel (str/slice (object/get @h "path" "") (+ (str/len (object/get @h "ip" "")) 4))) (c (default (array/nth @cs (default (str/to-int (object/get @h "ip" "")) 0)) "")))
                    (let ((allowed : [string] (object/get @aMap @c @nostr)) (w (default (array/nth @ws (default (str/to-int (object/get @h "ip" "")) 0)) "")))
                      { code: (if (and (= @c "tick") (= @root "payload")) @config.codes.bindingPayloadInTick.code @config.codes.bindingUnknownRoot.code), path: (str/concat @w @rel), message: (if (or (= @root "item") (= @root "index")) (str/concat "Binding @" @root " is not in scope here — @item / @index are bound only inside a collection callback (array/map, array/filter, …).") (str/concat "Binding @" @root " is not allowed in " @c " context. Allowed sigils: " (str/join @allowed ", "))), suggestion: (if (or (= @root "item") (= @root "index")) "Under `children:` the collection callback must use the EXPLICIT lambda form — `(array/map <collection> (fn (item) <node>))`. The implicit shorthand `(array/map <collection> { … })` is not recognised there, so its body is not treated as a lambda and @item never comes into scope. Both a raw `type:` object and a JSX element are valid as <node>." (str/concat "Use one of: " (str/join (array/map @allowed (fn a (str/concat (quote "@") @a))) ", "))), severity: "error" })))))))))))))))
[{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without LINT_INDEX and LINT_SITES and LINT_UNITS, so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_INDEX and LINT_SITES and LINT_UNITS before LINT_INPUT; this rule did not hear them", severity: "error" }]))
        (set @entity.indexHeard false)
        (set @entity.sitesGuardHeard false)
        (set @entity.unitsHeard false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "sigil-context", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : SgProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the binding roots of every trait and transition effect list."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      SITES_HEARD { scope : string!  guardHeads : Map string [string]!  guardRoots : Map string [string]!  calls : Map string [GtCallHit]!  trait : [GtCallHit]!  entity : [GtCallHit]! }
        @description "std-orb-lint-input's LINT_SITES: guard heads and roots, the call hits by head and the @trait. and @entity. leaves."
      OrbLintInput.LINT_SITES -> SITES_HEARD
      UNITS_HEARD { scope : string!  keys : Map string [string]!  guardKeys : Map string [string]!  emitStr : [string]!  guardEmitStr : [string]!  itemRoots : Map string [string]!  guardItemRoots : Map string [string]! }
        @description "std-orb-lint-input's LINT_UNITS: the object keys, string emits and @item/@index roots of every transition, tick and config unit."
      OrbLintInput.LINT_UNITS -> UNITS_HEARD
      SHAPES_HEARD { operators : Map string SgOpShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every installed operator with its category and arity; a collection or std-array operator of two or more arguments introduces @item and @index into its callback arguments."
      SHAPES_UNREAD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator table does not match the shape type."
      FACTS_HEARD { programTypes : Map string SgProgType!  guardSigils : [string]!  effectSigils : [string]!  tickSigils : [string]!  fieldTypes : [string]! }
        @description "std-orb-lint-input's LINT_LANGUAGE_FACTS: the sigils the installed binding rules allow in a guard, an effect and a tick."
      FACTS_UNREAD { error : string! }
        @description "std-orb-lint-input's LINT_LANGUAGE_FACTS_UNREAD: the installed language facts could not be read."
      OrbLintInput.LINT_OPERATOR_SHAPES -> SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> SHAPES_UNREAD
      OrbLintInput.LINT_LANGUAGE_FACTS -> FACTS_HEARD
      OrbLintInput.LINT_LANGUAGE_FACTS_UNREAD -> FACTS_UNREAD
    }
    config {
      ensuresSigils : [string] = ["fromEntity"]
        @label "Ensures-only sigils"
        @description "The sigils an @ensures reads beyond the guard rule's: the entity row before the transition's effects."
      codes : LintSigilContextCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without a shared program fact the rule reads (the structural index, sites, units, embeds or entities), so the rule cannot check the program" }, bindingPayloadInTick: { code: "ORB_BINDING_PAYLOAD_IN_TICK", category: "binding", description: "A binding reads @payload inside a tick, where a firing has no delivery" }, bindingUnknownRoot: { code: "ORB_BINDING_UNKNOWN_ROOT", category: "binding", description: "A binding names a root the context does not provide" }, lintOperatorShapesUnread: { code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", category: "lint", description: "The installed operator table could not be read or does not match the operator shape type, so a lint cannot run" }, lintLanguageFactsUnread: { code: "ORB_LINT_LANGUAGE_FACTS_UNREAD", category: "lint", description: "The installed language facts could not be read, so the lint rule could not check what it needs" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintSigilContextCli -> OrbLintSigilContextRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint sigil-context <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint sigil-context <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "sigil-context") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint sigil-context: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "sigil-context") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint sigil-context: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-sigil-context" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint sigil-context` with its arguments and working directory."
        @synonyms "orb lint sigil-context"
      OrbLintSigilContext.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintSigilContextCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintSigilContextOrbitalStart -> OrbLintSigilContext, OrbLintSigilContextCli, OrbLintInput, Packs, Versions
}
