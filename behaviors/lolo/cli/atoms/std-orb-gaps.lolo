        (set @entity.markE (array/filter (array/map (array/zip @entity.curLines @entity.curFlags) (fn p (if (and (array/nth @p 1) (validate/pattern (array/nth @p 0) "^<!-- END GENERATED ROLL-UP -->$")) { at: @index, text: (array/nth @p 0) } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.fail (if (or (!= (array/len @entity.markB) 1) (!= (array/len @entity.markE) 1)) "docs/Almadar_Gaps.md needs exactly one ordered roll-up marker pair" (if (< (object/get (array/first @entity.markE) "at") (object/get (array/first @entity.markB) "at")) "docs/Almadar_Gaps.md needs exactly one ordered roll-up marker pair" "")))
