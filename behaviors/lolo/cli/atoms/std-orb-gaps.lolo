        (set @entity.uEntries (object/get (array/find @entity.scans (fn s (= (object/get @s "key") (str/concat @entity.uRepo "/Almadar_Gaps.md")))) "entries"))
        (set @entity.uPend0 (array/filter @entity.merged (fn e (= (object/get @e "repo") @entity.uRepo))))
