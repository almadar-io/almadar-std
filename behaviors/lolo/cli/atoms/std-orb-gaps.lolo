      GAPS_S3 -> analyzing
        (set @entity.curLines (object/get (default (array/first @entity.scans) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "lines"))
        (set @entity.curFlags (object/get (default (array/first @entity.scans) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "flags"))
        (set @entity.curN (array/len @entity.curLines))
        (set @entity.markB (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (validate/pattern (default (array/nth @entity.curLines @i) "") "^<!-- BEGIN GENERATED ROLL-UP:.*-->$")) { at: @index, text: (default (array/nth @entity.curLines @i) "") } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.markE (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (validate/pattern (default (array/nth @entity.curLines @i) "") "^<!-- END GENERATED ROLL-UP -->$")) { at: @index, text: (default (array/nth @entity.curLines @i) "") } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.fail (if (or (!= (array/len @entity.markB) 1) (!= (array/len @entity.markE) 1)) "docs/Almadar_Gaps.md needs exactly one ordered roll-up marker pair" (if (< (object/get (default (array/first @entity.markE) { at: 0, text: "" }) "at") (object/get (default (array/first @entity.markB) { at: 0, text: "" }) "at")) "docs/Almadar_Gaps.md needs exactly one ordered roll-up marker pair" "")))
