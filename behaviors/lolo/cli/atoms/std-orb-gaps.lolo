          flags: (if (or (= @entity.cursor 0) (= @entity.curKey "__body__") (= @entity.curKey "__u__")) @entity.curFlags (array/take [true] 0)),
          gapLines: (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (str/startsWith (default (array/nth @entity.curLines @i) "") "- **G-") (or (< @entity.curBegin 0) (< @index @entity.curBegin))) { code: (array/nth (str/split (default (array/nth @entity.curLines @i) "") "**") 1), line: (default (array/nth @entity.curLines @i) ""), path: @entity.curKey } { code: "", line: "", path: "" }))) (fn r (!= (object/get @r "code") ""))),
