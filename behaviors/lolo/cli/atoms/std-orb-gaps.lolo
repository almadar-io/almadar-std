        (set @entity.hdrSrcs (array/map @entity.markB (fn m (array/nth (str/split (object/get @m "text") "`") 3))))
        (set @entity.mEntries (array/map (object/get (array/find @entity.scans (fn s (= (object/get @s "key") "__body__"))) "entries") (fn e
          (object/set @e "repo" (let ((hs (array/filter @entity.hdrIdx (fn j (< @j (object/get @e "at")))))) (if (= (array/len @hs) 0) "" (array/nth @entity.hdrRepos (- (array/len @hs) 1))))))))
