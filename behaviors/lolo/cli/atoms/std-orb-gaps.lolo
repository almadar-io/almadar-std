        (set @entity.mPost (if (< (+ @entity.eIdx 1) @entity.curN) (str/concat "\n" (str/join (array/slice @entity.curLines (+ @entity.eIdx 1) @entity.curN) "\n")) ""))
        (set @entity.jobs [
          { key: "__root__", text: (str/concat @entity.mPre @entity.mPost), repo: "ROOT" },
          { key: "__body__", text: (str/concat "\n" (if (> @entity.eIdx (+ @entity.bIdx 1)) (str/concat (str/join (array/slice @entity.curLines (+ @entity.bIdx 1) @entity.eIdx) "\n") "\n") "")), repo: "" } ])
