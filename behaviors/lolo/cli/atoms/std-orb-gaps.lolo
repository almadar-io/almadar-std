        (set @entity.findings (array/concat
          (array/map (array/filter (array/range 1 (array/len @entity.reads)) (fn i (not (object/get (default (array/nth @entity.reads @i) { path: "", ok: false, text: "" }) "ok")))) (fn i (str/concat "UNREADABLE " (object/get (default (array/nth @entity.reads @i) { path: "", ok: false, text: "" }) "path"))))
          (array/map (array/filter (object/keys @entity.codeGroups) (fn code (> (array/len (object/get @entity.codeGroups @code)) 1))) (fn code (str/concat "DUPLICATE " @code)))
          (array/map (array/filter (array/range 1 (array/len @entity.reads)) (fn i (and (object/get (default (array/nth @entity.reads @i) { path: "", ok: false, text: "" }) "ok") (not (str/includes (object/get (default (array/nth @entity.reads @i) { path: "", ok: false, text: "" }) "text") "code: `G-"))))) (fn i (str/concat "NO_COUNTER " (object/get (default (array/nth @entity.reads @i) { path: "", ok: false, text: "" }) "path"))))
          (array/map (array/filter @entity.codeRefs (fn r (and (not (str/includes (object/get @r "line") "[mechanical")) (not (str/includes (object/get @r "line") "[architectural")) (not (str/includes (object/get @r "line") "[owner-decision"))))) (fn r (str/concat "NO_TAG " (object/get @r "code") " (" (object/get @r "path") ")")))))
        (emit GAPS_ANSWERED { status: (if (= (array/len @entity.findings) 0) 200 500), body: (if (= (array/len @entity.findings) 0) "gaps: clean" (str/join @entity.findings "\n")) })
      GAPS_FAIL -> ready
