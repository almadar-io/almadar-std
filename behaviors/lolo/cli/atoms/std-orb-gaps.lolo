        (emit GAPS_UPD_APPEND { })
      GAPS_UPD_APPEND -> scanning when (< @entity.upc (array/len @entity.uPend))
        (set @entity.jobs [{ key: "__u__", text: @entity.uText, repo: "" }])
        (set @entity.stage "u")
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_UPD_INSERT -> updating
        (set @entity.curLines (object/get (array/last @entity.scans) "lines"))
        (set @entity.curFlags (object/get (array/last @entity.scans) "flags"))
        (set @entity.markB (array/filter (array/map (array/zip @entity.curLines @entity.curFlags) (fn p (if (and (array/nth @p 1) (validate/pattern (array/nth @p 0) "^#{2,3} .+$")) { at: @index, text: (array/nth @p 0) } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.uText (let ((en (array/nth @entity.uPend @entity.upc)))
          (let ((hl (if (= (object/get @en "heading") "") "## Open gaps" (str/concat "### " (object/get @en "heading")))))
            (let ((si (array/findIndex @entity.markB (fn m (= (object/get @m "text") @hl)))))
              (if (< @si 0)
                (str/concat (str/trimEnd @entity.uText) "\n\n" @hl "\n\n" (object/get @en "body") "\n")
                (if (< (+ @si 1) (array/len @entity.markB))
                  (str/concat (str/trimEnd (str/join (array/slice @entity.curLines 0 (object/get (array/nth @entity.markB (+ @si 1)) "at")) "\n")) "\n\n" (object/get @en "body") "\n\n" (str/join (array/slice @entity.curLines (object/get (array/nth @entity.markB (+ @si 1)) "at") (array/len @entity.curLines)) "\n"))
                  (str/concat (str/trimEnd @entity.uText) "\n\n" (object/get @en "body") "\n\n")))))))
        (set @entity.upc (+ @entity.upc 1))
        (emit GAPS_UPD_APPEND { })
      GAPS_UPD_APPEND -> updating when (>= @entity.upc (array/len @entity.uPend))
        (set @entity.uPrefix (if (= @entity.uRepo "orbital-rust") "ORB" (let ((dir (os/path-base @entity.uRepo))) (if (= @dir "almadar") "ALMADAR" (str/upper (str/replace-pattern @dir "^almadar-" ""))))))
        (set @entity.uCi (array/findIndex (str/split @entity.uText "\n") (fn l (validate/pattern @l (str/concat "Next code: `G-" @entity.uPrefix "-\\d+`")))))
        (set @entity.fail (if (and (< @entity.uCi 0) (array/some @entity.uPend (fn p (not (array/some @entity.uEntries (fn e (= (object/get @e "code") (object/get @p "code")))))))) (str/concat @entity.uRepo "/Almadar_Gaps.md needs a Next code counter before accepting new gaps") ""))
        (emit GAPS_UPD_COUNT { })
      GAPS_UPD_COUNT -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: " @entity.fail) })
      GAPS_UPD_COUNT -> updating when (= @entity.fail "")
        (set @entity.uText (if (< @entity.uCi 0) @entity.uText
          (let ((lines (str/split @entity.uText "\n"))
                (needle (str/concat "Next code: `G-" @entity.uPrefix "-")))
            (let ((digits (array/first (str/split (array/nth (str/split (array/nth @lines @entity.uCi) @needle) 1) "`"))))
              (let ((num (array/max (array/append (array/map (array/filter (array/concat (array/map @entity.merged (fn e (object/get @e "code"))) (array/map @entity.uEntries (fn e (object/get @e "code")))) (fn c (and (str/startsWith @c (str/concat "G-" @entity.uPrefix "-")) (validate/pattern @c (str/concat "^G-" @entity.uPrefix "-\\d+$"))))) (fn c (+ 1 (str/to-number (str/replace @c (str/concat "G-" @entity.uPrefix "-") ""))))) (str/to-number @digits)))))
                (str/join (array/flatten (array/map @lines (fn line
                  (if (= @index @entity.uCi)
                    [(str/replace @line (str/concat @needle @digits "`") (str/concat @needle (str/padStart (str/concat @num) 3 "0") "`"))]
                    (if (and (> (array/len @entity.uPend) 0) (= @line "_No open gaps._"))
                      (if (= @index (- (array/len @lines) 1)) [""] (array/take ["x"] 0))
                      [@line]))))) "\n"))))))
        (set @entity.utexts (if (!= @entity.uText (str/join @entity.uLines "\n")) (array/append @entity.utexts { path: (str/concat @entity.uRepo "/Almadar_Gaps.md"), ok: true, text: @entity.uText }) @entity.utexts))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_UPD_NEXT { })
      GAPS_UPD_NEXT -> updating
        (emit GAPS_UPD { })
      GAPS_UPD -> scanning when (and (>= @entity.cursor (array/len @entity.ledgerRepos)) (> (array/len @entity.utexts) 0))
        (set @entity.fkeys (array/map @entity.ledgerRepos (fn r (let ((p (str/concat @r "/Almadar_Gaps.md"))) (if (array/some @entity.utexts (fn u (= (object/get @u "path") @p))) (str/concat "new:" @p) @p)))))
        (set @entity.jobs (array/map @entity.utexts (fn u { key: (str/concat "new:" (object/get @u "path")), text: (object/get @u "text"), repo: "" })))
        (set @entity.stage "r")
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_UPD -> merging when (and (>= @entity.cursor (array/len @entity.ledgerRepos)) (= (array/len @entity.utexts) 0))
        (set @entity.fkeys (array/map @entity.ledgerRepos (fn r (str/concat @r "/Almadar_Gaps.md"))))
        (emit GAPS_RENDER { })
    }

    state writing {
      INIT -> writing
      GAPS_W_NEXT -> writing when (and (< @entity.wcur (array/len @entity.outFiles)) (= @entity.mode "out"))
        (os/mkdir (str/concat @config.outRoot "/" @entity.outRel "/" (os/path-dir (object/get (array/nth @entity.outFiles @entity.wcur) "path"))) true { key: "mkdir" emit: { success: GAPS_W_MKDIR, failure: GAPS_W_FAILED } })
      GAPS_W_MKDIR -> writing
        (os/write-file (str/concat @config.outRoot "/" @entity.outRel "/" (object/get (array/nth @entity.outFiles @entity.wcur) "path")) (bytes/from-string (object/get (array/nth @entity.outFiles @entity.wcur) "text")) { key: "write" emit: { success: GAPS_W_WROTE, failure: GAPS_W_FAILED } })
      GAPS_W_NEXT -> writing when (and (< @entity.wcur (array/len @entity.outFiles)) (= @entity.mode "write"))
        (os/write-file (str/concat @config.root "/" (object/get (array/nth @entity.outFiles @entity.wcur) "path")) (bytes/from-string (object/get (array/nth @entity.outFiles @entity.wcur) "text")) { key: "write" emit: { success: GAPS_W_WROTE, failure: GAPS_W_FAILED } })
      GAPS_W_WROTE -> writing
        (set @entity.wcur (+ @entity.wcur 1))
        (emit GAPS_W_NEXT { })
      GAPS_W_FAILED -> ready
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: cannot write " (object/get (array/nth @entity.outFiles @entity.wcur) "path")) })
      GAPS_W_NEXT -> ready when (>= @entity.wcur (array/len @entity.outFiles))
        (emit GAPS_ANSWERED { status: 200, body: (str/join @entity.out "\n") })
    }

    emits {
      GAPS_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      GAPS_PARSED { }
        @description "Internal: the arguments were read."
        @tier "internal"
      GAPS_FAIL { }
        @description "Internal: answer with the error held in fail."
        @tier "internal"
      GAPS_READ { }
        @description "Internal: read the next file."
        @tier "internal"
      GAPS_READ_NEXT { }
        @description "Internal: continue with the next file."
        @tier "internal"
      GAPS_FILE_READ {
        data : bytes!
      }
        @description "A file read."
        @tier "internal"
      GAPS_FILE_UNREAD {
        error : string
      }
        @description "A file that could not be read."
        @tier "internal"
      GAPS_SCAN { }
        @description "Internal: scan the next job's text."
        @tier "internal"
      GAPS_SCAN_NEXT { }
        @description "Internal: continue with the next job."
        @tier "internal"
      GAPS_CHECK { }
        @description "Internal: collect the gap lines of the ledgers scanned."
        @tier "internal"
      GAPS_REPORT { }
        @description "Internal: answer with the findings."
        @tier "internal"
      GAPS_PROBE { }
        @description "Internal: probe the next candidate repo directory."
        @tier "internal"
      GAPS_PROBED { }
        @description "Internal: every candidate repo directory was probed."
        @tier "internal"
      GAPS_PROBE_NEXT { }
        @description "Internal: continue with the next candidate."
        @tier "internal"
      GAPS_PROBE_GM { }
        @description "Internal: read the candidate's .gitmodules."
        @tier "internal"
      GAPS_PROBE_LEDGER { }
        @description "Internal: read the candidate's ledger."
        @tier "internal"
      GAPS_DIR {
        entries : [GapDirEntry]!
      }
        @description "A directory listed."
        @tier "internal"
      GAPS_DIR_MISSING {
        error : string
      }
        @description "A directory that could not be listed."
        @tier "internal"
      GAPS_GM_TEXT {
        data : bytes!
      }
        @description "A .gitmodules read."
        @tier "internal"
      GAPS_GM_FAIL {
        error : string
      }
        @description "A .gitmodules that could not be read."
        @tier "internal"
      GAPS_PL_READ {
        data : bytes!
      }
        @description "A candidate's ledger read."
        @tier "internal"
      GAPS_PL_FAIL {
        error : string
      }
        @description "A candidate's ledger that could not be read."
        @tier "internal"
      GAPS_S3 { }
        @description "Internal: find the roll-up markers in the master."
        @tier "internal"
      GAPS_S3B { }
        @description "Internal: the markers were checked."
        @tier "internal"
      GAPS_S4 { }
        @description "Internal: collect and validate the entries of both sides."
        @tier "internal"
      GAPS_S4B { }
        @description "Internal: the entries were validated."
        @tier "internal"
      GAPS_ROWS { }
        @description "Internal: compare each code across master, repos and baseline."
        @tier "internal"
      GAPS_ROWS_DONE { }
        @description "Internal: the comparison rows are ready."
        @tier "internal"
      GAPS_ROLLUP { }
        @description "Internal: check the master for unsynchronized edits."
        @tier "internal"
      GAPS_ROLLUP_B { }
        @description "Internal: the master was checked."
        @tier "internal"
      GAPS_MERGE { }
        @description "Internal: choose the winning side per code."
        @tier "internal"
      GAPS_MERGE_B { }
        @description "Internal: the merge was decided."
        @tier "internal"
      GAPS_UPD { }
        @description "Internal: rewrite the next repo ledger."
        @tier "internal"
      GAPS_UPD_APPEND { }
        @description "Internal: add the next new entry to the repo ledger."
        @tier "internal"
      GAPS_UPD_INSERT { }
        @description "Internal: place the new entry under its section."
        @tier "internal"
      GAPS_UPD_COUNT { }
        @description "Internal: advance the Next code counter."
        @tier "internal"
      GAPS_UPD_NEXT { }
        @description "Internal: continue with the next repo ledger."
        @tier "internal"
      GAPS_RENDER { }
        @description "Internal: render the generated roll-up."
        @tier "internal"
      GAPS_RENDERED { }
        @description "Internal: the roll-up was rendered."
        @tier "internal"
      GAPS_W_NEXT { }
        @description "Internal: write the next file."
        @tier "internal"
      GAPS_W_MKDIR { }
        @description "A directory made."
        @tier "internal"
      GAPS_W_WROTE {
        bytes : number!
      }
        @description "A file written."
        @tier "internal"
      GAPS_W_FAILED {
        error : string
      }
        @description "A directory or file that could not be written."
        @tier "internal"
    }

    config {
      root : string = "~/kflow.ai.builder/.gaps-parity"
        @label "Monorepo root"
        @description "Directory holding docs/Almadar_Gaps.md and the repo ledgers; the fs grant covers it."
      outRoot : string = "~/.almadar/gaps-out"
        @label "Out root"
        @description "Directory --out <dir> writes under; the out grant covers it."
      order : [string] = ["packages/almadar-eslint", "packages/almadar-core", "packages/almadar-logger", "packages/almadar-std", "packages/almadar-behaviors", "packages/almadar-syntax", "packages/almadar-runtime", "packages/almadar-server", "packages/almadar-ui", "packages/almadar-verify", "packages/almadar-tools", "tools/almadar-pattern-sync", "tools/runtime-verify", "packages/almadar-playground-runtime", "tools/asset-workflow", "apps/builder", "apps/kflow", "apps/nata", "apps/rawi", "almadar", "orbital-rust"]
        @label "Repo order"
        @description "Upstream to downstream order of the repos in the roll-up, per the root CLAUDE.md dependency map; unlisted repos follow alphabetically."
      deprecated : [string] = ["packages/almadar-agent"]
        @label "Retired repos"
        @description "Submodule paths whose ledgers are no longer read."
    }

    listens {
      GAPS_CALLED -> inbound "cli-gaps" answers GAPS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb gaps` with its arguments and working directory."
        @synonyms "orb gaps, check gap ledgers, sync gap ledgers"
    }
  }

  page "/orb-gaps" as OrbGapsPage -> OrbGaps
}
