            (array/map @entity.bEntries (fn e { code: (object/get @e "code"), side: "p", repo: (object/get @e "repo"), heading: (object/get @e "heading"), body: (object/get @e "body") }))) "code"))
          (fn kv
            (let ((mm (array/find (array/nth @kv 1) (fn s (= (object/get @s "side") "m"))))
                  (ll (array/find (array/nth @kv 1) (fn s (= (object/get @s "side") "l"))))
                  (pp (array/find (array/nth @kv 1) (fn s (= (object/get @s "side") "p")))))
              (let ((sm (if (= @mm null) "" (json/stringify [(object/get @mm "repo") (object/get @mm "heading") (object/get @mm "body")])))
                    (sl (if (= @ll null) "" (json/stringify [(object/get @ll "repo") (object/get @ll "heading") (object/get @ll "body")])))
                    (sp (if (= @pp null) "" (json/stringify [(object/get @pp "repo") (object/get @pp "heading") (object/get @pp "body")]))))
                (let ((side (if (and (!= @sp "") (not (array/includes @entity.repos (object/get @pp "repo"))) (= @sm "") (= @sl "")) "skip"
