          (array/map (array/filter @entity.codeRefs (fn r (and (not (str/includes (object/get @r "line") "[mechanical")) (not (str/includes (object/get @r "line") "[architectural")) (not (str/includes (object/get @r "line") "[owner-decision"))))) (fn r (str/concat "NO_TAG " (object/get @r "code") " (" (object/get @r "path") ")")))))
