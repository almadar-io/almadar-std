app std-orb-gaps [
  version: "1.0.0",
  inbound: ["cli-gaps"],
  fs: { "~/kflow.ai.builder/**": [read, write], "~/.almadar/gaps-out/**": [write, create] },
  description: "std-orb-gaps — the `orb gaps` command, the port of tools/almadar-gaps (check, sync, rollup). `check` reads docs/Almadar_Gaps.md under the root knob and every repo ledger its generated roll-up names, then reports duplicate gap codes, repo ledgers without a Next code counter, unreadable ledgers and entries without a [mechanical], [architectural] or [owner-decision] tag, one line each (status 500, exit 1); a clean tree answers `gaps: clean` (status 200, exit 0). `sync` and `status` reconcile the master with the repo ledgers by gap code: the repos come from the .gitmodules files, fenced code blocks never count, a three-way merge against tools/almadar-gaps/.sync-state.json decides which side wins per entry and refuses divergent edits, a repo's Next code never decreases, and the preview names every change; --write saves the ledger files and the baseline, --out <dir> saves the proposed files and the baseline under the outRoot knob (~/.almadar/gaps-out, the out grant), --check fails while any ledger file would change, --from master|repos makes one side authoritative. `rollup` rebuilds the master's generated roll-up from the repo ledgers. Any unknown command answers the usage (status 400, exit 2)."
]
uses Spec from "almadar-std/orb-gaps"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type GapEntry = { code : string!, repo : string!, heading : string!, body : string!, at : number!, endAt : number! }
type GapMark = { at : number!, text : string! }
type GapSpan = { lo : number!, hi : number! }
type GapCodeRef = { code : string!, line : string!, path : string! }
type GapScan = { key : string!, lines : [string]!, flags : [boolean]!, entries : [GapEntry]!, gapLines : [GapCodeRef]! }
type GapJob = { key : string!, text : string!, repo : string! }
type GapRead = { path : string!, ok : boolean!, text : string! }
type GapCand = { path : string!, nested : boolean! }
type GapProbe = { path : string!, nested : boolean!, dirOk : boolean!, hasLedger : boolean!, hasPy : boolean!, hasModules : boolean! }
type GapDirEntry = { name : string!, kind : string! }
type GapSortKey = { sort : string!, path : string! }
type GapSig = { code : string!, side : string!, repo : string!, heading : string!, body : string! }
type GapRow = { code : string!, side : string!, m : string!, l : string!, p : string!, pRepo : string!, eRepo : string!, eHeading : string!, eBody : string! }
type GapBaseline = { version : number!, entries : [SExpr]! }

orbital OrbGapsOrbital {
  entity OrbGapsRun [runtime] {
    id : string!
    argv : [string] = []
    rest : [string] = []
    allowed : [string] = []
    cwd : string = ""
    cmd : string = ""
    mode : string = ""
    outDir : string = ""
    from : string = ""
    fail : string = ""
    stage : string = ""
    queue : [string] = []
    reads : [GapRead] = []
    work : [GapCand] = []
    probes : [GapProbe] = []
    cursor : number = 0
    repos : [string] = []
    ledgerRepos : [string] = []
    jobs : [GapJob] = []
    scans : [GapScan] = []
    curLines : [string] = []
    curFences : [string] = []
    curCand : [GapMark] = []
    curSpans : [GapSpan] = []
    curFlags : [boolean] = []
    curBounds : [number] = []
    curSecs : [GapMark] = []
    curStarts : [GapMark] = []
    curKey : string = ""
    curRepo : string = ""
    curN : number = 0
    curBegin : number = 0
    findings : [string] = []
    codeRefs : [GapCodeRef] = []
    mOwn : [string] = []
    lOwn : [string] = []
    markB : [GapMark] = []
    markE : [GapMark] = []
    bIdx : number = 0
    eIdx : number = 0
    mPre : string = ""
    mPost : string = ""
    masterText : string = ""
    hdrIdx : [number] = []
    hdrRepos : [string] = []
    hdrSrcs : [string] = []
    mEntries : [GapEntry] = []
    lEntries : [GapEntry] = []
    rEntries : [GapEntry] = []
    bEntries : [GapEntry] = []
    mCodes : [string] = []
    lCodes : [string] = []
    rCodes : [string] = []
    hasBaseline : boolean = false
    errs : [string] = []
    codes : [string] = []
    rows : [GapRow] = []
    merged : [GapEntry] = []
    out : [string] = []
    uRepo : string = ""
    uLines : [string] = []
    uEntries : [GapEntry] = []
    uPend0 : [GapEntry] = []
    uPend : [GapEntry] = []
    uText : string = ""
    upc : number = 0
    utexts : [GapRead] = []
    fkeys : [string] = []
    rollupText : string = ""
    nextMaster : string = ""
    outFiles : [GapRead] = []
    wcur : number = 0
    outRel : string = ""
    ucur : number = 0
    uPrefix : string = ""
    uCi : number = 0
  }

  trait OrbGaps -> OrbGapsRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      GAPS_CALLED -> ready
        (set @entity.argv (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv"))
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (set @entity.cmd (str/default (array/first @entity.argv) ""))
        (set @entity.rest (array/drop @entity.argv 1))
        (set @entity.allowed (if (= @entity.cmd "sync") ["--from" "--out" "--write" "--check"] (if (= @entity.cmd "rollup") ["--out" "--write" "--check"] (array/take ["--out"] 0))))
        (set @entity.mode (if (array/includes @entity.rest "--write") "write" (if (array/includes @entity.rest "--check") "check" (if (array/includes @entity.rest "--out") "out" "preview"))))
        (set @entity.outDir (if (array/includes @entity.rest "--out") (str/default (array/nth @entity.rest (+ (array/indexOf @entity.rest "--out") 1)) "") ""))
        (set @entity.from (if (array/includes @entity.rest "--from") (str/default (array/nth @entity.rest (+ (array/indexOf @entity.rest "--from") 1)) "") ""))
        (set @entity.fail (if (not (array/includes (str/split "check|sync|status|rollup" "|") @entity.cmd)) "usage"
          (if (and (= @entity.cmd "check") (> (array/len @entity.rest) 0)) "usage"
            (str/default (array/find (array/concat
              (array/map (array/range 0 (array/len @entity.rest)) (fn i (if (and (> @i 0) (array/includes ["--out" "--from"] (array/nth @entity.rest (- @i 1))) (not (str/startsWith (array/nth @entity.rest @i) "--"))) ""
                (if (not (array/includes @entity.allowed (array/nth @entity.rest @i))) (str/concat "unrecognized option: " (array/nth @entity.rest @i))
                  (if (!= (array/indexOf @entity.rest (array/nth @entity.rest @i)) @i) (str/concat "duplicate option: " (array/nth @entity.rest @i))
                    (if (and (array/includes ["--out" "--from"] (array/nth @entity.rest @i)) (or (>= (+ @i 1) (array/len @entity.rest)) (str/startsWith (str/default (array/nth @entity.rest (+ @i 1)) "") "--"))) (str/concat (array/nth @entity.rest @i) " needs a value") ""))))))
              [(if (> (+ (if (array/includes @entity.rest "--write") 1 0) (if (array/includes @entity.rest "--check") 1 0) (if (array/includes @entity.rest "--out") 1 0)) 1) "choose only one of --write, --check, --out" "")
               (if (and (array/includes @entity.rest "--from") (not (or (= @entity.from "master") (= @entity.from "repos")))) "--from must be master or repos" "")
               (if (and (array/includes @entity.rest "--out") (or (str/startsWith @entity.outDir "/") (str/includes @entity.outDir ".."))) "--out must name a directory under the outRoot knob, not a path" "")]) (fn m (!= @m ""))) ""))))
        (set @entity.stage "")
        (set @entity.queue [])
        (set @entity.reads [])
        (set @entity.work [])
        (set @entity.probes [])
        (set @entity.cursor 0)
        (set @entity.repos [])
        (set @entity.ledgerRepos [])
        (set @entity.jobs [])
        (set @entity.scans [])
        (set @entity.curLines [])
        (set @entity.curFences [])
        (set @entity.curCand [])
        (set @entity.curSpans [])
        (set @entity.curFlags [])
        (set @entity.curBounds [])
        (set @entity.curSecs [])
        (set @entity.curStarts [])
        (set @entity.curKey "")
        (set @entity.curRepo "")
        (set @entity.curN 0)
        (set @entity.curBegin 0)
        (set @entity.findings [])
        (set @entity.codeRefs [])
        (set @entity.mOwn [])
        (set @entity.lOwn [])
        (set @entity.markB [])
        (set @entity.markE [])
        (set @entity.bIdx 0)
        (set @entity.eIdx 0)
        (set @entity.mPre "")
        (set @entity.mPost "")
        (set @entity.masterText "")
        (set @entity.hdrIdx [])
        (set @entity.hdrRepos [])
        (set @entity.hdrSrcs [])
        (set @entity.mEntries [])
        (set @entity.lEntries [])
        (set @entity.rEntries [])
        (set @entity.bEntries [])
        (set @entity.mCodes [])
        (set @entity.lCodes [])
        (set @entity.rCodes [])
        (set @entity.hasBaseline false)
        (set @entity.errs [])
        (set @entity.codes [])
        (set @entity.rows [])
        (set @entity.merged [])
        (set @entity.out [])
        (set @entity.uRepo "")
        (set @entity.uLines [])
        (set @entity.uEntries [])
        (set @entity.uPend0 [])
        (set @entity.uPend [])
        (set @entity.uText "")
        (set @entity.upc 0)
        (set @entity.utexts [])
        (set @entity.fkeys [])
        (set @entity.rollupText "")
        (set @entity.nextMaster "")
        (set @entity.outFiles [])
        (set @entity.wcur 0)
        (set @entity.outRel @entity.outDir)
        (emit GAPS_PARSED { })
      GAPS_PARSED -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: (if (= @entity.fail "usage") 400 500), body: (if (= @entity.fail "usage") "usage: orb gaps check | sync [--from master|repos] [--write | --check | --out <dir>] | status | rollup [--write | --check | --out <dir>]" (str/concat "error: " @entity.fail)) })
      GAPS_PARSED -> reading when (and (= @entity.fail "") (= @entity.cmd "check"))
        (set @entity.queue (str/split "docs/Almadar_Gaps.md" "|"))
        (set @entity.stage "c1")
        (emit GAPS_READ { })
      GAPS_PARSED -> probing when (and (= @entity.fail "") (!= @entity.cmd "check"))
        (set @entity.work [{ path: ".", nested: false }])
        (emit GAPS_PROBE { })
    }

    state probing {
      INIT -> probing
      GAPS_PROBE -> probing when (< @entity.cursor (array/len @entity.work))
        (os/list-dir (str/concat @config.root "/" (object/get (array/nth @entity.work @entity.cursor) "path")) { key: "dir" emit: { success: GAPS_DIR, failure: GAPS_DIR_MISSING } })
      GAPS_DIR -> probing
        (set @entity.probes (array/append @entity.probes {
          path: (object/get (array/nth @entity.work @entity.cursor) "path"),
          nested: (object/get (array/nth @entity.work @entity.cursor) "nested"),
          dirOk: true,
          hasLedger: (array/some @payload.entries (fn e (= (object/get @e "name") "Almadar_Gaps.md"))),
          hasPy: (array/some @payload.entries (fn e (= (object/get @e "name") "pyproject.toml"))),
          hasModules: (array/some @payload.entries (fn e (= (object/get @e "name") ".gitmodules"))) }))
        (emit GAPS_PROBE_GM { })
      GAPS_DIR_MISSING -> probing
        (set @entity.probes (array/append @entity.probes { path: (object/get (array/nth @entity.work @entity.cursor) "path"), nested: (object/get (array/nth @entity.work @entity.cursor) "nested"), dirOk: false, hasLedger: false, hasPy: false, hasModules: false }))
        (emit GAPS_PROBE_NEXT { })
      GAPS_PROBE_GM -> probing when (object/get (array/last @entity.probes) "hasModules")
        (os/read-file (str/concat @config.root "/" (object/get (array/nth @entity.work @entity.cursor) "path") "/.gitmodules") { key: "modules" emit: { success: GAPS_GM_TEXT, failure: GAPS_GM_FAIL } })
      GAPS_PROBE_GM -> probing when (not (object/get (array/last @entity.probes) "hasModules"))
        (emit GAPS_PROBE_LEDGER { })
      GAPS_GM_TEXT -> probing
        (set @entity.work (array/concat @entity.work (array/map
          (array/filter (str/split (bytes/to-string @payload.data) "\n") (fn l (validate/pattern @l "^\\s*path\\s*=")))
          (fn l { path: (os/path-normalize (os/path-join (object/get (array/nth @entity.work @entity.cursor) "path") (str/trim (str/replace-pattern @l "^\\s*path\\s*=" "")))), nested: (!= (object/get (array/nth @entity.work @entity.cursor) "path") ".") }))))
        (emit GAPS_PROBE_LEDGER { })
      GAPS_GM_FAIL -> probing
        (emit GAPS_PROBE_LEDGER { })
      GAPS_PROBE_LEDGER -> probing when (object/get (array/last @entity.probes) "hasLedger")
        (os/read-file (str/concat @config.root "/" (object/get (array/nth @entity.work @entity.cursor) "path") "/Almadar_Gaps.md") { key: "ledger" emit: { success: GAPS_PL_READ, failure: GAPS_PL_FAIL } })
      GAPS_PROBE_LEDGER -> probing when (not (object/get (array/last @entity.probes) "hasLedger"))
        (emit GAPS_PROBE_NEXT { })
      GAPS_PL_READ -> probing
        (set @entity.reads (array/append @entity.reads { path: (os/path-normalize (os/path-join (object/get (array/nth @entity.work @entity.cursor) "path") "Almadar_Gaps.md")), ok: true, text: (bytes/to-string @payload.data) }))
        (emit GAPS_PROBE_NEXT { })
      GAPS_PL_FAIL -> probing
        (emit GAPS_PROBE_NEXT { })
      GAPS_PROBE_NEXT -> probing
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_PROBE { })
      GAPS_PROBE -> probing when (>= @entity.cursor (array/len @entity.work))
        (set @entity.repos (array/map (array/sort (array/map
          (array/filter @entity.probes (fn p (and (!= (object/get @p "path") ".") (object/get @p "dirOk") (not (object/get @p "hasPy")) (or (not (object/get @p "nested")) (object/get @p "hasLedger")) (not (array/includes @config.deprecated (object/get @p "path"))))))
          (fn p { sort: (str/concat (str/padStart (str/concat (let ((i (array/indexOf @config.order (object/get @p "path")))) (if (< @i 0) (array/len @config.order) @i))) 3 "0") "|" (str/collate-key (object/get @p "path"))), path: (object/get @p "path") })) "sort") (fn k (object/get @k "path"))))
        (set @entity.findings (array/map @entity.repos (fn p (if (= @p "orbital-rust") "ORB" (let ((dir (os/path-base @p))) (if (= @dir "almadar") "ALMADAR" (str/upper (str/replace-pattern @dir "^almadar-" "")))))))) 
        (set @entity.fail (let ((dup (array/find @entity.findings (fn v (< (array/indexOf @entity.findings @v) @index))))) (if (= @dup null) "" (str/concat "two repos derive the same gap prefix G-" @dup "-"))))
        (emit GAPS_PROBED { })
      GAPS_PROBED -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: " @entity.fail) })
      GAPS_PROBED -> reading when (= @entity.fail "")
        (set @entity.queue (str/split "docs/Almadar_Gaps.md|tools/almadar-gaps/.sync-state.json" "|"))
        (set @entity.stage "s2")
        (set @entity.cursor 0)
        (emit GAPS_READ { })
    }

    state reading {
      INIT -> reading
      GAPS_READ -> reading when (< @entity.cursor (array/len @entity.queue))
        (os/read-file (str/concat @config.root "/" (array/nth @entity.queue @entity.cursor)) { key: "ledger" emit: { success: GAPS_FILE_READ, failure: GAPS_FILE_UNREAD } })
      GAPS_FILE_READ -> reading
        (set @entity.reads (array/append @entity.reads { path: (array/nth @entity.queue @entity.cursor), ok: true, text: (bytes/to-string @payload.data) }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_READ_NEXT { })
      GAPS_FILE_UNREAD -> reading
        (set @entity.reads (array/append @entity.reads { path: (array/nth @entity.queue @entity.cursor), ok: false, text: "" }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_READ_NEXT { })
      GAPS_READ_NEXT -> reading
        (emit GAPS_READ { })
      GAPS_READ -> scanning when (and (>= @entity.cursor (array/len @entity.queue)) (or (= @entity.stage "c1") (= @entity.stage "c3")))
        (set @entity.jobs (array/map @entity.reads (fn r { key: (object/get @r "path"), text: (object/get @r "text"), repo: "" })))
        (set @entity.stage (if (= @entity.stage "c1") "c2" "c4"))
        (set @entity.scans [])
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_READ -> ready when (and (>= @entity.cursor (array/len @entity.queue)) (= @entity.stage "s2") (not (object/get (array/find @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) "ok")))
        (emit GAPS_ANSWERED { status: 500, body: "error: cannot read docs/Almadar_Gaps.md" })
      GAPS_READ -> scanning when (and (>= @entity.cursor (array/len @entity.queue)) (= @entity.stage "s2") (object/get (array/find @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) "ok"))
        (set @entity.ledgerRepos (array/filter @entity.repos (fn r (array/some @entity.reads (fn x (and (= (object/get @x "path") (str/concat @r "/Almadar_Gaps.md")) (object/get @x "ok")))))))
        (set @entity.masterText (object/get (array/find @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) "text"))
        (set @entity.jobs (array/concat
          (array/map (array/filter @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) (fn r { key: (object/get @r "path"), text: (object/get @r "text"), repo: "ROOT" }))
          (array/map @entity.ledgerRepos (fn r { key: (str/concat @r "/Almadar_Gaps.md"), text: (object/get (array/find @entity.reads (fn x (= (object/get @x "path") (str/concat @r "/Almadar_Gaps.md")))) "text"), repo: @r }))))
        (set @entity.stage "s3")
        (set @entity.scans [])
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
    }

    state scanning {
      INIT -> scanning
      GAPS_SCAN -> scanning when (< @entity.cursor (array/len @entity.jobs))
        (set @entity.curKey (object/get (array/nth @entity.jobs @entity.cursor) "key"))
        (set @entity.curRepo (object/get (array/nth @entity.jobs @entity.cursor) "repo"))
        (set @entity.curLines (str/split (object/get (array/nth @entity.jobs @entity.cursor) "text") "\n"))
        (set @entity.curN (array/len @entity.curLines))
        (set @entity.curBegin (array/findIndex @entity.curLines (fn l (str/includes @l "<!-- BEGIN GENERATED ROLL-UP"))))
        (set @entity.curCand (array/filter (array/map @entity.curLines (fn l (if (validate/pattern @l "^\\s*(`{3,}|~{3,})") { at: @index, text: @l } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.curFences (array/reduce @entity.curCand (array/take [""] 0) (fn acc m
          (let ((prev (if (= (array/len @acc) 0) "" (array/last @acc)))
                (lead (str/trimStart (object/get @m "text"))))
            (array/append @acc
              (if (!= @prev "")
                (if (validate/pattern (str/trim (object/get @m "text")) (str/concat "^" (str/slice @prev 0 1) "{" (str/len @prev) ",}$")) "" @prev)
                (str/slice @lead 0 (- (str/len @lead) (str/len (str/replace-pattern @lead (str/concat "^" (str/slice @lead 0 1) "+") "")))))))))) 
        (set @entity.curSpans (array/map (array/filter (array/range 0 (array/len @entity.curCand)) (fn k (and (!= (array/nth @entity.curFences @k) "") (or (= @k 0) (= (array/nth @entity.curFences (- @k 1)) ""))))) (fn k
          { lo: (object/get (array/nth @entity.curCand @k) "at"),
            hi: (let ((j (array/find (array/range (+ @k 1) (array/len @entity.curCand)) (fn j (= (array/nth @entity.curFences @j) ""))))) (if (= @j null) @entity.curN (object/get (array/nth @entity.curCand @j) "at"))) })))
        (set @entity.curFlags (array/map (array/range 0 @entity.curN) (fn i (not (array/some @entity.curSpans (fn sp (and (<= (object/get @sp "lo") @i) (<= @i (object/get @sp "hi")))))))))
        (set @entity.curBounds (array/filter (array/map (array/zip @entity.curLines @entity.curFlags) (fn p (if (and (array/nth @p 1) (validate/pattern (array/nth @p 0) "^(?:#{1,4} |[-*+] |Next (?:cross-repo )?code:|_No open gaps\\._|---\\s*$|<!--)")) @index -1))) (fn i (>= @i 0))))
        (set @entity.curSecs (array/filter (array/map (array/zip @entity.curLines @entity.curFlags) (fn p (if (and (array/nth @p 1) (validate/pattern (array/nth @p 0) "^#{1,4} ")) { at: @index, text: (array/nth @p 0) } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.curStarts (array/filter (array/map (array/zip @entity.curLines @entity.curFlags) (fn p (if (and (array/nth @p 1) (validate/pattern (array/nth @p 0) "^- \\*\\*G-[A-Z0-9_-]+-\\d+\\*\\*")) { at: @index, text: (array/nth @p 0) } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.scans (array/append @entity.scans {
          key: @entity.curKey,
          lines: @entity.curLines,
          flags: @entity.curFlags,
          gapLines: (array/filter (array/map (array/zip @entity.curLines @entity.curFlags) (fn p (if (and (array/nth @p 1) (str/startsWith (array/nth @p 0) "- **G-") (or (< @entity.curBegin 0) (< @index @entity.curBegin))) { code: (array/nth (str/split (array/nth @p 0) "**") 1), line: (array/nth @p 0), path: @entity.curKey } { code: "", line: "", path: "" }))) (fn r (!= (object/get @r "code") ""))),
          entries: (array/map @entity.curStarts (fn m
            (let ((s (object/get @m "at"))
                  (e (math/default (array/nth @entity.curBounds (+ (array/indexOf @entity.curBounds (object/get @m "at")) 1)) @entity.curN))
                  (hs (array/filter @entity.curSecs (fn j (< (object/get @j "at") (object/get @m "at"))))))
              (let ((body (str/trimEnd (str/join (array/slice @entity.curLines @s @e) "\n")))
                    (hl (if (= (array/len @hs) 0) "" (object/get (array/last @hs) "text"))))
                { code: (array/nth (str/split (object/get @m "text") "**") 1),
                  repo: @entity.curRepo,
                  heading: (if (validate/pattern @hl "^#{3,4} ") (str/replace-pattern @hl "^#{1,4} " "") ""),
                  body: @body,
                  at: @s,
                  endAt: (+ @s (array/len (str/split @body "\n"))) }))))
        }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_SCAN_NEXT { })
      GAPS_SCAN_NEXT -> scanning
        (emit GAPS_SCAN { })
      GAPS_SCAN -> reading when (and (>= @entity.cursor (array/len @entity.jobs)) (= @entity.stage "c2"))
        (set @entity.queue (array/concat (str/split "docs/Almadar_Gaps.md" "|") (array/map (array/filter (array/zip (object/get (array/first @entity.scans) "lines") (object/get (array/first @entity.scans) "flags")) (fn p (and (array/nth @p 1) (str/startsWith (array/nth @p 0) "## `")))) (fn p (str/concat (array/nth (str/split (array/nth @p 0) "`") 1) "/Almadar_Gaps.md")))))
