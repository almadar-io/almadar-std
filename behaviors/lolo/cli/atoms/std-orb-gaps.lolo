            (fn p { code: (object/get @p "0"), repo: (let ((r (object/get @p "1.repo"))) (object/get @config.ownerMoves @r @r)), heading: (object/get @p "1.heading"), body: (object/get @p "1.body"), at: 0, endAt: 0 }))
          (array/take @entity.mEntries 0)))
        (set @entity.errs [
          (default (array/find (array/map (array/range 0 (array/len @entity.hdrIdx)) (fn h
