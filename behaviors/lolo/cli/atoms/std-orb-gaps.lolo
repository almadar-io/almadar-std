              (if (< (array/indexOf @entity.hdrRepos (default (array/nth @entity.hdrRepos @h) "")) @h) (str/concat "duplicate repo section: " (default (array/nth @entity.hdrRepos @h) "")) "")))) (fn m (!= @m ""))) ""),
          (if (array/some @entity.mEntries (fn e (= (object/get @e "repo") ""))) "gap outside an explicit repo section in master roll-up" ""),
          (default (array/find (array/map (array/filter @entity.repos (fn r (and (array/includes @entity.hdrRepos @r) (not (array/includes @entity.ledgerRepos @r))))) (fn r (str/concat "missing ledger: " @r "/Almadar_Gaps.md"))) (fn m (!= @m ""))) ""),
          (if (and @entity.hasBaseline (= (json/parse (object/get (default (array/find @entity.reads (fn r (= (object/get @r "path") @config.baseline))) { path: "", ok: false, text: "" }) "text") GapBaseline) null)) (str/concat "the sync baseline " @config.baseline " is not readable") "") ,
