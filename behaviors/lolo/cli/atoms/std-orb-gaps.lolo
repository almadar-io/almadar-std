        (set @entity.curFlags (array/map (array/range 0 @entity.curN) (fn i (not (array/some @entity.curSpans (fn sp (and (<= (object/get @sp "lo") @i) (<= @i (object/get @sp "hi")))))))))
        (set @entity.curBounds (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (validate/pattern (default (array/nth @entity.curLines @i) "") "^(?:#{1,4} |[-*+] |Next (?:cross-repo )?code:|_No open gaps\\._|---\\s*$|<!--)")) @index -1))) (fn i (>= @i 0))))
        (set @entity.curSecs (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (validate/pattern (default (array/nth @entity.curLines @i) "") "^#{1,4} ")) { at: @index, text: (default (array/nth @entity.curLines @i) "") } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.curStarts (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (validate/pattern (default (array/nth @entity.curLines @i) "") "^- \\*\\*G-[A-Z0-9_-]+-\\d+\\*\\*")) { at: @index, text: (default (array/nth @entity.curLines @i) "") } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
