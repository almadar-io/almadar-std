        (set @entity.hdrIdx (array/map @entity.markB (fn m (object/get @m "at"))))
        (set @entity.hdrRepos (array/map @entity.markB (fn m (let ((r (default (array/nth (str/split (object/get @m "text") "`") 1) ""))) (object/get @config.ownerMoves @r @r)))))
        (set @entity.hdrSrcs (array/map @entity.markB (fn m (let ((p (default (array/nth (str/split (object/get @m "text") "`") 3) ""))) (str/concat (object/get @config.ownerMoves (os/path-dir @p) (os/path-dir @p)) "/" (os/path-base @p))))))
        (set @entity.mEntries (array/map (object/get (default (array/find @entity.scans (fn s (= (object/get @s "key") "__body__"))) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "entries") (fn e
          (object/set @e "repo" (let ((hs (array/filter @entity.hdrIdx (fn j (< @j (object/get @e "at")))))) (if (= (array/len @hs) 0) "" (array/nth @entity.hdrRepos (- (array/len @hs) 1))))))))
        (set @entity.mEntries (array/filter @entity.mEntries (fn e (not (array/includes @config.deprecated (object/get @e "repo"))))))
        (set @entity.hdrSrcs (array/map (array/filter (array/range 0 (array/len @entity.hdrRepos)) (fn i (not (array/includes @config.deprecated (default (array/nth @entity.hdrRepos @i) ""))))) (fn i (default (array/nth @entity.hdrSrcs @i) ""))))
        (set @entity.hdrIdx (array/map (array/filter (array/range 0 (array/len @entity.hdrRepos)) (fn i (not (array/includes @config.deprecated (default (array/nth @entity.hdrRepos @i) ""))))) (fn i (default (array/nth @entity.hdrIdx @i) 0))))
        (set @entity.hdrRepos (array/filter @entity.hdrRepos (fn r (not (array/includes @config.deprecated @r)))))
        (set @entity.lEntries (array/flatten (array/map @entity.ledgerRepos (fn r (object/get (default (array/find @entity.scans (fn s (= (object/get @s "key") (str/concat @r "/Almadar_Gaps.md")))) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "entries")))))
        (set @entity.rEntries (object/get (default (array/find @entity.scans (fn s (= (object/get @s "key") "__root__"))) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "entries"))
