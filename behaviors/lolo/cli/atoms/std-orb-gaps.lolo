    state analyzing {
      INIT -> analyzing
      GAPS_CHECK -> analyzing
        (set @entity.codeRefs (array/flatten (array/map @entity.scans (fn s (object/get @s "gapLines")))))
        (emit GAPS_REPORT { })
      GAPS_REPORT -> ready
