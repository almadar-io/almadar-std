        (set @entity.stage "c3")
        (emit GAPS_READ { })
      GAPS_SCAN -> analyzing when (and (>= @entity.cursor (array/len @entity.jobs)) (= @entity.stage "c4"))
        (emit GAPS_CHECK { })
      GAPS_SCAN -> analyzing when (and (>= @entity.cursor (array/len @entity.jobs)) (= @entity.stage "s3"))
        (emit GAPS_S3 { })
      GAPS_SCAN -> analyzing when (and (>= @entity.cursor (array/len @entity.jobs)) (= @entity.stage "s4"))
        (emit GAPS_S4 { })
      GAPS_SCAN -> updating when (and (>= @entity.cursor (array/len @entity.jobs)) (= @entity.stage "u"))
        (emit GAPS_UPD_INSERT { })
      GAPS_SCAN -> merging when (and (>= @entity.cursor (array/len @entity.jobs)) (= @entity.stage "r"))
