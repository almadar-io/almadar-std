                    (sl (if (= @ll null) "" (json/stringify [(object/get (default @ll { code: "", side: "", repo: "", heading: "", body: "" }) "repo") (object/get (default @ll { code: "", side: "", repo: "", heading: "", body: "" }) "heading") (object/get (default @ll { code: "", side: "", repo: "", heading: "", body: "" }) "body")])))
                    (sp (if (= @pp null) "" (json/stringify [(object/get (default @pp { code: "", side: "", repo: "", heading: "", body: "" }) "repo") (object/get (default @pp { code: "", side: "", repo: "", heading: "", body: "" }) "heading") (object/get (default @pp { code: "", side: "", repo: "", heading: "", body: "" }) "body")]))))
                (let ((side (if (and (!= @sp "") (not (array/includes @entity.repos (object/get (default @pp { code: "", side: "", repo: "", heading: "", body: "" }) "repo"))) (= @sm "") (= @sl "")) "skip"
                              (if (!= @entity.from "")
                                (if (= @entity.from "master") (if (= @sm "") "n" "m") (if (= @sl "") "n" "l"))
                                (if (= @sm @sl) (if (= @sm "") "n" "m")
                                  (if (and @entity.hasBaseline (= @sm @sp)) (if (= @sl "") "n" "l")
                                    (if (and @entity.hasBaseline (= @sl @sp)) (if (= @sm "") "n" "m") "x")))))))
                  { code: @c, side: @side, m: @sm, l: @sl, p: @sp,
                    pRepo: (if (= @pp null) "" (object/get (default @pp { code: "", side: "", repo: "", heading: "", body: "" }) "repo")),
                    eRepo: (if (= @side "m") (object/get (default @mm { code: "", side: "", repo: "", heading: "", body: "" }) "repo") (if (= @side "l") (object/get (default @ll { code: "", side: "", repo: "", heading: "", body: "" }) "repo") "")),
                    eHeading: (if (= @side "m") (object/get (default @mm { code: "", side: "", repo: "", heading: "", body: "" }) "heading") (if (= @side "l") (object/get (default @ll { code: "", side: "", repo: "", heading: "", body: "" }) "heading") "")),
                    eBody: (if (= @side "m") (object/get (default @mm { code: "", side: "", repo: "", heading: "", body: "" }) "body") (if (= @side "l") (object/get (default @ll { code: "", side: "", repo: "", heading: "", body: "" }) "body") "")) })))))))
        (emit GAPS_ROWS_DONE { })
      GAPS_ROWS_DONE -> merging when (= @entity.cmd "rollup")
        (emit GAPS_ROLLUP { })
      GAPS_ROWS_DONE -> merging when (!= @entity.cmd "rollup")
        (emit GAPS_MERGE { })
      GAPS_ROLLUP -> merging
        (set @entity.fail (let ((bad (array/find @entity.rows (fn r (and @entity.hasBaseline (or (!= (object/get @r "m") "") (!= (object/get @r "p") "")) (!= (object/get @r "m") (object/get @r "p")) (!= (object/get @r "m") (object/get @r "l"))))))) (if (= @bad null) "" (str/concat "master has unsynchronized edits for " (object/get @bad "code") "; use sync to preserve them, or sync --from repos to explicitly replace them"))))
        (emit GAPS_ROLLUP_B { })
      GAPS_ROLLUP_B -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: " @entity.fail) })
      GAPS_ROLLUP_B -> merging when (= @entity.fail "")
        (set @entity.fkeys (array/map @entity.ledgerRepos (fn r (str/concat @r "/Almadar_Gaps.md"))))
        (emit GAPS_RENDER { })
      GAPS_MERGE -> merging
        (set @entity.fail (default (array/find (array/concat
          (array/map (array/filter @entity.rows (fn r (and (!= (object/get @r "side") "skip") (!= (object/get @r "p") "") (not (array/includes @entity.ledgerRepos (object/get @r "pRepo")))))) (fn r (str/concat "baseline owner ledger unavailable: " (object/get @r "pRepo") " (" (object/get @r "code") ")")))
          [(if (array/some @entity.rows (fn r (= (object/get @r "side") "x"))) (str/concat "sync conflicts: " (str/join (array/map (array/filter @entity.rows (fn r (= (object/get @r "side") "x"))) (fn r (object/get @r "code"))) ", ") ". Reconcile these entries or explicitly select --from master|repos; no files written.") "")]) (fn m (!= @m ""))) ""))
        (emit GAPS_MERGE_B { })
      GAPS_MERGE_B -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: " @entity.fail) })
      GAPS_MERGE_B -> updating when (= @entity.fail "")
        (set @entity.merged (array/map (array/filter @entity.rows (fn r (or (= (object/get @r "side") "m") (= (object/get @r "side") "l")))) (fn r { code: (object/get @r "code"), repo: (object/get @r "eRepo"), heading: (object/get @r "eHeading"), body: (object/get @r "eBody"), at: 0, endAt: 0 })))
        (set @entity.out (array/flatten (array/map (array/filter @entity.rows (fn r (or (!= (object/get @r "m") "") (!= (object/get @r "l") "")))) (fn r
          (let ((cs (if (= (object/get @r "side") "m") (object/get @r "m") (if (= (object/get @r "side") "l") (object/get @r "l") ""))))
            (array/concat
              (if (!= (object/get @r "m") @cs) [(str/concat (if (= @cs "") "delete" "update") " master " (object/get @r "code"))] (array/take ["x"] 0))
              (if (!= (object/get @r "l") @cs) [(str/concat (if (= @cs "") "delete" "update") " repo " (object/get @r "code"))] (array/take ["x"] 0))))))))
        (set @entity.utexts [])
        (set @entity.ucur 0)
        (emit GAPS_UPD { })
      GAPS_RENDER -> merging
        (set @entity.rollupText (str/concat "<!-- BEGIN GENERATED ROLL-UP: orb gaps rollup --write; sync edits by gap code with sync --write -->\n\n"
          (str/join
            (array/map
              (array/filter (array/range 0 (array/len @entity.ledgerRepos)) (fn i (> (array/len (object/get (default (array/find @entity.scans (fn s (= (object/get @s "key") (array/nth @entity.fkeys @i)))) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "entries")) 0)))
              (fn i
                (let ((r (default (array/nth @entity.ledgerRepos @i) ""))
                      (en (object/get (default (array/find @entity.scans (fn s (= (object/get @s "key") (array/nth @entity.fkeys @i)))) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "entries")))
                  (str/concat "## `" @r "` (source: `" @r "/Almadar_Gaps.md`)\n\n"
                    (str/join
                      (array/flatten
                        (array/map (array/range 0 (array/len @en))
                          (fn j
                            (let ((e (default (array/nth @en @j) { code: "", repo: "", heading: "", body: "", at: 0, endAt: 0 }))
                                  (ph (if (= @j 0) "" (object/get (default (array/nth @en (- @j 1)) { code: "", repo: "", heading: "", body: "", at: 0, endAt: 0 }) "heading"))))
                              (if (and (!= (object/get @e "heading") @ph) (!= (object/get @e "heading") ""))
                                [(str/concat (if (> @j 0) "\n" "") "#### " (object/get @e "heading") "\n") (object/get @e "body")]
                                [(object/get @e "body")])))))
                      "\n")))))
            "\n\n")
          "\n\n<!-- END GENERATED ROLL-UP -->"))
        (set @entity.nextMaster (str/concat @entity.mPre @entity.rollupText @entity.mPost))
        (emit GAPS_RENDERED { })
      GAPS_RENDERED -> ready when (and (= @entity.cmd "rollup") (= @entity.mode "check") (!= @entity.nextMaster @entity.masterText))
        (emit GAPS_ANSWERED { status: 500, body: "error: docs/Almadar_Gaps.md roll-up is stale — run: orb gaps rollup --write" })
      GAPS_RENDERED -> ready when (and (= @entity.cmd "rollup") (= @entity.mode "check") (= @entity.nextMaster @entity.masterText))
        (emit GAPS_ANSWERED { status: 200, body: (str/concat "roll-up current: " (array/len @entity.lEntries) " repo-owned gaps") })
      GAPS_RENDERED -> ready when (and (= @entity.cmd "rollup") (= @entity.mode "preview"))
        (emit GAPS_ANSWERED { status: 500, body: "error: pass exactly one of --out <dir> or --write" })
      GAPS_RENDERED -> writing when (and (= @entity.cmd "rollup") (or (= @entity.mode "write") (= @entity.mode "out")))
        (set @entity.outFiles [{ path: "docs/Almadar_Gaps.md", ok: true, text: @entity.nextMaster }])
        (set @entity.out (array/append @entity.out (str/concat "roll-up: " (array/len @entity.lEntries) " repo-owned gaps from " (array/len @entity.ledgerRepos) " repos")))
        (set @entity.wcur 0)
        (emit GAPS_W_NEXT { })
      GAPS_RENDERED -> ready when (and (!= @entity.cmd "rollup") (or (= @entity.mode "preview") (= @entity.mode "check")))
        (set @entity.out (array/append @entity.out (str/concat "sync: " (array/len @entity.merged) " repo-owned gaps; " (+ (array/len @entity.utexts) (if (!= @entity.nextMaster @entity.masterText) 1 0)) " ledger files to update" (if @entity.hasBaseline "" "; baseline not initialized"))))
        (emit GAPS_ANSWERED { status: (if (and (= @entity.mode "check") (> (+ (array/len @entity.utexts) (if (!= @entity.nextMaster @entity.masterText) 1 0)) 0)) 500 200), body: (str/join (if (and (= @entity.mode "check") (> (+ (array/len @entity.utexts) (if (!= @entity.nextMaster @entity.masterText) 1 0)) 0)) (array/append @entity.out "error: ledgers differ; run sync --write") @entity.out) "\n") })
      GAPS_RENDERED -> writing when (and (!= @entity.cmd "rollup") (or (= @entity.mode "write") (= @entity.mode "out")))
        (set @entity.out (array/append @entity.out (str/concat "sync: " (array/len @entity.merged) " repo-owned gaps; " (+ (array/len @entity.utexts) (if (!= @entity.nextMaster @entity.masterText) 1 0)) " ledger files to update" (if @entity.hasBaseline "" "; baseline not initialized"))))
        (set @entity.outFiles (array/concat @entity.utexts (if (!= @entity.nextMaster @entity.masterText) [{ path: "docs/Almadar_Gaps.md", ok: true, text: @entity.nextMaster }] (array/take @entity.utexts 0)) [{ path: @config.baseline, ok: true, text: (str/concat "{\n  \"version\": 1,\n  \"entries\": " (if (= (array/len @entity.merged) 0) "[]" (str/concat "[\n" (str/join (array/map @entity.merged (fn e (str/concat "    [\n      " (json/stringify (object/get @e "code")) ",\n      {\n        \"repo\": " (json/stringify (object/get @e "repo")) ",\n        \"heading\": " (json/stringify (object/get @e "heading")) ",\n        \"body\": " (json/stringify (object/get @e "body")) "\n      }\n    ]"))) ",\n") "\n  ]")) "\n}\n") }]))
        (set @entity.wcur 0)
        (emit GAPS_W_NEXT { })
    }

    state planning {
      INIT -> planning
      GAPS_PLANS -> planning
        (set @entity.pLines (str/split (str/join (array/map (array/filter @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Plans.md"))) (fn r (object/get @r "text"))) "") "\n"))
        (set @entity.pSec (array/findIndex @entity.pLines (fn l (str/startsWith @l @config.planHeading))))
        (set @entity.pEndSec (if (< @entity.pSec 0) 0
          (let ((n (array/findIndex (array/slice @entity.pLines (+ @entity.pSec 1) (array/len @entity.pLines)) (fn l (str/startsWith @l "## ")))))
            (if (< @n 0) (array/len @entity.pLines) (+ @entity.pSec 1 @n)))))
        (set @entity.pTags (array/map (array/flatten (array/map @entity.scans (fn s (object/get @s "entries")))) (fn e
          { code: (object/get @e "code"),
            tags: (array/map (array/drop (str/split (object/get @e "body") "Root cause: ") 1) (fn p (str/trim (default (array/first (str/split @p ".")) "")))) })))
        (set @entity.pCauses (if (< @entity.pSec 0) (array/take [{ id: "", name: "", closed: false, codes: [""] }] 0)
          (let ((sec (array/slice @entity.pLines @entity.pSec @entity.pEndSec)))
            (let ((flags (array/reduce @sec (array/take [true] 0) (fn acc l
                    (array/append @acc
                      (if (str/startsWith @l "### ") (array/some @config.causeSections (fn h (str/startsWith @l @h)))
                        (if (str/startsWith @l "## ") false
                          (if (= (array/len @acc) 0) false (array/last @acc)))))))))
              (array/map (array/filter (array/range 0 (array/len @sec)) (fn i (and (default (array/nth @flags @i) false) (validate/pattern (default (array/nth @sec @i) "") "^- \\*\\*[A-Z]+[0-9]+ [^*]+\\*\\*"))))
                (fn i
                  (let ((line (default (array/nth @sec @i) "")))
                    (let ((bold (default (array/nth (str/split @line "**") 1) "")))
                      (let ((cid (default (array/first (str/split @bold " ")) "")))
                        { id: @cid,
                          name: @bold,
                          closed: (str/includes @line "[closed]"),
                          codes: (array/map (array/filter @entity.pTags (fn t (and (= (array/len (object/get @t "tags")) 1) (= (array/first (object/get @t "tags")) @cid)))) (fn t (object/get @t "code"))) })))))))))
        (emit GAPS_PLANS_B { })
      GAPS_PLANS_B -> planning
        (set @entity.pBeginAt (let ((hits (array/filter (array/range (math/max @entity.pSec 0) @entity.pEndSec) (fn i (= (array/nth @entity.pLines @i) @config.markerBegin))))) (if (= (array/len @hits) 1) (default (array/first @hits) -1) -1)))
        (set @entity.pEndAt (let ((hits (array/filter (array/range (math/max @entity.pSec 0) @entity.pEndSec) (fn i (= (array/nth @entity.pLines @i) @config.markerEnd))))) (if (= (array/len @hits) 1) (default (array/first @hits) -1) -1)))
        (set @entity.pTable (array/concat
          ["| Cause | Open | Gaps |", "|---|---|---|"]
          (array/map @entity.pCauses (fn c (str/concat "| " (object/get @c "name") " | " (array/len (object/get @c "codes")) " | " (if (= (array/len (object/get @c "codes")) 0) "(none)" (str/join (object/get @c "codes") ", ")) " |")))
          (array/map @config.freeTags (fn f (str/concat "| " @f " | " (array/len (array/filter @entity.pTags (fn t (and (= (array/len (object/get @t "tags")) 1) (= (array/first (object/get @t "tags")) @f))))) " | (see docs/Almadar_Gaps.md) |")))))
        (set @entity.pDrift (and (>= @entity.pBeginAt 0) (>= @entity.pEndAt 0) (> @entity.pEndAt @entity.pBeginAt)
          (!= (str/join (array/slice @entity.pLines (+ @entity.pBeginAt 1) @entity.pEndAt) "\n") (str/join @entity.pTable "\n"))))
        (set @entity.pSummary (str/concat (array/len @entity.pTags) " open: "
          (str/join (array/concat
            (array/map (array/filter @entity.pCauses (fn c (> (array/len (object/get @c "codes")) 0))) (fn c (str/concat (default (array/first (str/split (object/get @c "name") " ")) "") " " (array/len (object/get @c "codes")))))
            (array/map (array/filter @config.freeTags (fn f (> (array/len (array/filter @entity.pTags (fn t (and (= (array/len (object/get @t "tags")) 1) (= (array/first (object/get @t "tags")) @f))))) 0))) (fn f (str/concat @f " " (array/len (array/filter @entity.pTags (fn t (and (= (array/len (object/get @t "tags")) 1) (= (array/first (object/get @t "tags")) @f))))))))) ", ")))
        (set @entity.errs (if (< @entity.pSec 0) (array/append (array/take ["x"] 0) "docs/Almadar_Plans.md has no P-017 section")
          (array/concat
            (if (= (array/len @entity.pCauses) 0) (array/append (array/take ["x"] 0) "docs/Almadar_Plans.md P-017 lists no causes under its cause subsections") (array/take ["x"] 0))
            (if (or (< @entity.pBeginAt 0) (< @entity.pEndAt 0) (< @entity.pEndAt @entity.pBeginAt)) (array/append (array/take ["x"] 0) "docs/Almadar_Plans.md P-017 needs exactly one ordered p017-gaps marker pair") (array/take ["x"] 0))
            (array/map (array/filter (array/map @entity.pCauses (fn c (object/get @c "id"))) (fn i (< (array/indexOf (array/map @entity.pCauses (fn c (object/get @c "id"))) @i) @index))) (fn i (str/concat "duplicate cause id: " @i)))
            (array/map (array/filter (array/map @entity.pTags (fn t (object/get @t "code"))) (fn c (< (array/indexOf (array/map @entity.pTags (fn t (object/get @t "code"))) @c) @index))) (fn c (str/concat "duplicate gap code: " @c)))
            (array/map (array/filter @entity.pTags (fn t (= (array/len (object/get @t "tags")) 0))) (fn t (str/concat "untagged: " (object/get @t "code") " has no Root cause tag")))
            (array/map (array/filter @entity.pTags (fn t (> (array/len (object/get @t "tags")) 1))) (fn t (str/concat "double-tagged: " (object/get @t "code") " (" (str/join (object/get @t "tags") ", ") ")")))
            (array/map (array/filter @entity.pTags (fn t (and (= (array/len (object/get @t "tags")) 1) (not (array/includes (array/concat (array/map @entity.pCauses (fn c (object/get @c "id"))) @config.freeTags) (array/first (object/get @t "tags"))))))) (fn t (str/concat "unknown tag: " (object/get @t "code") " is tagged " (default (array/first (object/get @t "tags")) ""))))
            (array/map (array/filter @entity.pCauses (fn c (and (= (array/len (object/get @c "codes")) 0) (not (object/get @c "closed"))))) (fn c (str/concat "cause " (object/get @c "id") " has no open gaps and is not marked [closed]")))
            (array/map (array/filter @entity.pCauses (fn c (and (> (array/len (object/get @c "codes")) 0) (object/get @c "closed")))) (fn c (str/concat "cause " (object/get @c "id") " is marked [closed] but has open gaps: " (str/join (object/get @c "codes") ", ")))))))
        (set @entity.pFail (str/join (array/concat @entity.errs (if (and @entity.pDrift (!= @entity.mode "write")) (array/append (array/take ["x"] 0) "docs/Almadar_Plans.md P-017 gap table is stale; run: orb gaps plans --write") (array/take ["x"] 0))) "\n"))
        (emit GAPS_PLANS_C { })
      GAPS_PLANS_C -> ready when (!= @entity.pFail "")
        (emit GAPS_ANSWERED { status: 500, body: @entity.pFail })
      GAPS_PLANS_C -> writing when (and (= @entity.pFail "") (= @entity.mode "write") @entity.pDrift)
        (set @entity.outFiles [{ path: "docs/Almadar_Plans.md", ok: true, text: (str/join (array/concat (array/slice @entity.pLines 0 (+ @entity.pBeginAt 1)) @entity.pTable (array/slice @entity.pLines @entity.pEndAt (array/len @entity.pLines))) "\n") }])
        (set @entity.out [(str/concat "plans: written (" @entity.pSummary ")")])
        (set @entity.wcur 0)
        (emit GAPS_W_NEXT { })
      GAPS_PLANS_C -> ready when (and (= @entity.pFail "") (or (!= @entity.mode "write") (not @entity.pDrift)))
        (emit GAPS_ANSWERED { status: 200, body: (str/concat "plans: aligned (" @entity.pSummary ")") })
    }

    state updating {
      INIT -> updating
      GAPS_UPD -> updating when (< @entity.ucur (array/len @entity.ledgerRepos))
        (set @entity.uRepo (default (array/nth @entity.ledgerRepos @entity.ucur) ""))
        (set @entity.uLines (str/split (object/get (default (array/find @entity.reads (fn r (= (object/get @r "path") (str/concat @entity.uRepo "/Almadar_Gaps.md")))) { path: "", ok: false, text: "" }) "text") "\n"))
        (set @entity.uEntries (object/get (default (array/find @entity.scans (fn s (= (object/get @s "key") (str/concat @entity.uRepo "/Almadar_Gaps.md")))) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "entries"))
        (set @entity.uPend0 (array/filter @entity.merged (fn e (= (object/get @e "repo") @entity.uRepo))))
        (set @entity.uText (str/join (array/flatten (array/map @entity.uLines (fn line
          (let ((i @index))
           (let ((ex (array/find @entity.uEntries (fn e (and (<= (object/get @e "at") @i) (< @i (object/get @e "endAt")))))))
            (if (= @ex null) [@line]
              (if (!= @i (object/get @ex "at")) (array/take ["x"] 0)
                (let ((tail (str/slice (default (array/nth @entity.uLines (- (object/get @ex "endAt") 1)) "") (str/len (str/trimEnd (default (array/nth @entity.uLines (- (object/get @ex "endAt") 1)) "")))))
                      (r (array/find @entity.uPend0 (fn p (and (= (object/get @p "code") (object/get @ex "code")) (= (object/get @p "heading") (object/get @ex "heading")))))))
                  (if (= @r null) [@tail]
                    (let ((rl (str/split (object/get @r "body") "\n")))
                      (array/append (array/dropLast @rl 1) (str/concat (default (array/last @rl) "") @tail)))))))))))) "\n"))
        (set @entity.uPend (array/filter @entity.uPend0 (fn p (not (array/some @entity.uEntries (fn e (and (= (object/get @e "code") (object/get @p "code")) (= (object/get @e "heading") (object/get @p "heading")))))))))
        (set @entity.upc 0)
        (emit GAPS_UPD_APPEND { })
      GAPS_UPD_APPEND -> scanning when (< @entity.upc (array/len @entity.uPend))
        (set @entity.jobs [{ key: "__u__", text: @entity.uText, repo: "" }])
        (set @entity.stage "u")
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_UPD_INSERT -> updating
        (set @entity.curLines (object/get (default (array/last @entity.scans) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "lines"))
        (set @entity.curFlags (object/get (default (array/last @entity.scans) { key: "", lines: [], flags: [], entries: [], gapLines: [] }) "flags"))
        (set @entity.markB (array/filter (array/map (array/range 0 (math/min (array/len @entity.curLines) (array/len @entity.curFlags))) (fn i (if (and (default (array/nth @entity.curFlags @i) false) (validate/pattern (default (array/nth @entity.curLines @i) "") "^#{2,3} .+$")) { at: @index, text: (default (array/nth @entity.curLines @i) "") } { at: -1, text: "" }))) (fn m (>= (object/get @m "at") 0))))
        (set @entity.uText (let ((en (default (array/nth @entity.uPend @entity.upc) { code: "", repo: "", heading: "", body: "", at: 0, endAt: 0 })))
          (let ((hl (if (= (object/get @en "heading") "") "## Open gaps" (str/concat "### " (object/get @en "heading")))))
            (let ((si (array/findIndex @entity.markB (fn m (= (object/get @m "text") @hl)))))
              (if (< @si 0)
                (str/concat (str/trimEnd @entity.uText) "\n\n" @hl "\n\n" (object/get @en "body") "\n")
                (if (< (+ @si 1) (array/len @entity.markB))
                  (str/concat (str/trimEnd (str/join (array/slice @entity.curLines 0 (object/get (default (array/nth @entity.markB (+ @si 1)) { at: 0, text: "" }) "at")) "\n")) "\n\n" (object/get @en "body") "\n\n" (str/join (array/slice @entity.curLines (object/get (default (array/nth @entity.markB (+ @si 1)) { at: 0, text: "" }) "at") (array/len @entity.curLines)) "\n"))
                  (str/concat (str/trimEnd @entity.uText) "\n\n" (object/get @en "body") "\n\n")))))))
        (set @entity.upc (+ @entity.upc 1))
        (emit GAPS_UPD_APPEND { })
      GAPS_UPD_APPEND -> updating when (>= @entity.upc (array/len @entity.uPend))
        (set @entity.uPrefix (if (= @entity.uRepo "orbital-rust") "ORB" (let ((dir (os/path-base @entity.uRepo))) (if (= @dir "almadar") "ALMADAR" (str/upper (str/replace-pattern @dir "^almadar-" ""))))))
        (set @entity.uCi (array/findIndex (str/split @entity.uText "\n") (fn l (validate/pattern @l (str/concat "Next code: `G-" @entity.uPrefix "-\\d+`")))))
        (set @entity.fail (if (and (< @entity.uCi 0) (array/some @entity.uPend (fn p (not (array/some @entity.uEntries (fn e (= (object/get @e "code") (object/get @p "code")))))))) (str/concat @entity.uRepo "/Almadar_Gaps.md needs a Next code counter before accepting new gaps") ""))
        (emit GAPS_UPD_COUNT { })
      GAPS_UPD_COUNT -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: " @entity.fail) })
      GAPS_UPD_COUNT -> updating when (= @entity.fail "")
        (set @entity.uText (if (< @entity.uCi 0) @entity.uText
          (let ((lines (str/split @entity.uText "\n"))
                (needle (str/concat "Next code: `G-" @entity.uPrefix "-")))
            (let ((digits (default (array/first (str/split (default (array/nth (str/split (default (array/nth @lines @entity.uCi) "") @needle) 1) "") "`")) "")))
              (let ((num (array/max (array/append (array/map (array/filter (array/concat (array/map @entity.merged (fn e (object/get @e "code"))) (array/map @entity.uEntries (fn e (object/get @e "code")))) (fn c (and (str/startsWith @c (str/concat "G-" @entity.uPrefix "-")) (validate/pattern @c (str/concat "^G-" @entity.uPrefix "-\\d+$"))))) (fn c (+ 1 (default (str/to-number (str/replace @c (str/concat "G-" @entity.uPrefix "-") "")) 0)))) (default (str/to-number @digits) 0)))))
                (str/join (array/flatten (array/map @lines (fn line
                  (if (= @index @entity.uCi)
                    [(str/replace @line (str/concat @needle @digits "`") (str/concat @needle (str/padStart (str/concat (default @num 0)) 3 "0") "`"))]
                    (if (and (> (array/len @entity.uPend) 0) (= @line "_No open gaps._"))
                      (if (= @index (- (array/len @lines) 1)) [""] (array/take ["x"] 0))
                      [@line]))))) "\n"))))))
        (set @entity.utexts (if (!= @entity.uText (str/join @entity.uLines "\n")) (array/append @entity.utexts { path: (str/concat @entity.uRepo "/Almadar_Gaps.md"), ok: true, text: @entity.uText }) @entity.utexts))
        (set @entity.ucur (+ @entity.ucur 1))
        (emit GAPS_UPD_NEXT { })
      GAPS_UPD_NEXT -> updating
        (emit GAPS_UPD { })
      GAPS_UPD -> scanning when (and (>= @entity.ucur (array/len @entity.ledgerRepos)) (> (array/len @entity.utexts) 0))
        (set @entity.fkeys (array/map @entity.ledgerRepos (fn r (let ((p (str/concat @r "/Almadar_Gaps.md"))) (if (array/some @entity.utexts (fn u (= (object/get @u "path") @p))) (str/concat "new:" @p) @p)))))
        (set @entity.jobs (array/map @entity.utexts (fn u { key: (str/concat "new:" (object/get @u "path")), text: (object/get @u "text"), repo: "" })))
        (set @entity.stage "r")
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_UPD -> merging when (and (>= @entity.ucur (array/len @entity.ledgerRepos)) (= (array/len @entity.utexts) 0))
        (set @entity.fkeys (array/map @entity.ledgerRepos (fn r (str/concat @r "/Almadar_Gaps.md"))))
        (emit GAPS_RENDER { })
    }

    state writing {
      INIT -> writing
      GAPS_W_NEXT -> writing when (and (< @entity.wcur (array/len @entity.outFiles)) (= @entity.mode "out"))
        (os/mkdir (str/concat @config.outRoot "/" @entity.outRel "/" (os/path-dir (object/get (default (array/nth @entity.outFiles @entity.wcur) { path: "", ok: false, text: "" }) "path"))) true { key: "mkdir" emit: { success: GAPS_W_MKDIR, failure: GAPS_W_FAILED } })
      GAPS_W_MKDIR -> writing
        (os/write-file (str/concat @config.outRoot "/" @entity.outRel "/" (object/get (default (array/nth @entity.outFiles @entity.wcur) { path: "", ok: false, text: "" }) "path")) (bytes/from-string (object/get (default (array/nth @entity.outFiles @entity.wcur) { path: "", ok: false, text: "" }) "text")) { key: "write" emit: { success: GAPS_W_WROTE, failure: GAPS_W_FAILED } })
      GAPS_W_NEXT -> writing when (and (< @entity.wcur (array/len @entity.outFiles)) (= @entity.mode "write"))
        (os/write-file { anchor: "cwd" path: (object/get (default (array/nth @entity.outFiles @entity.wcur) { path: "", ok: false, text: "" }) "path") } (bytes/from-string (object/get (default (array/nth @entity.outFiles @entity.wcur) { path: "", ok: false, text: "" }) "text")) { key: "write" emit: { success: GAPS_W_WROTE, failure: GAPS_W_FAILED } })
      GAPS_W_WROTE -> writing
        (set @entity.wcur (+ @entity.wcur 1))
        (emit GAPS_W_NEXT { })
      GAPS_W_FAILED -> ready
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: cannot write " (object/get (default (array/nth @entity.outFiles @entity.wcur) { path: "", ok: false, text: "" }) "path")) })
      GAPS_W_NEXT -> ready when (>= @entity.wcur (array/len @entity.outFiles))
        (emit GAPS_ANSWERED { status: 200, body: (str/join @entity.out "\n") })
    }

    emits {
      GAPS_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      GAPS_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the words after the verb against the --from, --out, --write and --check flags."
        @tier "internal"
      GAPS_PARSED { }
        @description "Internal: the arguments were read."
        @tier "internal"
      GAPS_FAIL { }
        @description "Internal: answer with the error held in fail."
        @tier "internal"
      GAPS_READ { }
        @description "Internal: read the next file."
        @tier "internal"
      GAPS_READ_NEXT { }
        @description "Internal: continue with the next file."
        @tier "internal"
      GAPS_FILE_READ {
        data : bytes!
      }
        @description "A file read."
        @tier "internal"
      GAPS_FILE_UNREAD {
        error : string
      }
        @description "A file that could not be read."
        @tier "internal"
      GAPS_SCAN { }
        @description "Internal: scan the next job's text."
        @tier "internal"
      GAPS_SCAN_NEXT { }
        @description "Internal: continue with the next job."
        @tier "internal"
      GAPS_CHECK { }
        @description "Internal: collect the gap lines of the ledgers scanned."
        @tier "internal"
      GAPS_REPORT { }
        @description "Internal: answer with the findings."
        @tier "internal"
      GAPS_PROBE { }
        @description "Internal: probe the next candidate repo directory."
        @tier "internal"
      GAPS_PROBED { }
        @description "Internal: every candidate repo directory was probed."
        @tier "internal"
      GAPS_PROBE_NEXT { }
        @description "Internal: continue with the next candidate."
        @tier "internal"
      GAPS_PROBE_GM { }
        @description "Internal: read the candidate's .gitmodules."
        @tier "internal"
      GAPS_PROBE_LEDGER { }
        @description "Internal: read the candidate's ledger."
        @tier "internal"
      GAPS_DIR {
        entries : [GapDirEntry]!
      }
        @description "A directory listed."
        @tier "internal"
      GAPS_DIR_MISSING {
        error : string
      }
        @description "A directory that could not be listed."
        @tier "internal"
      GAPS_GM_TEXT {
        data : bytes!
      }
        @description "A .gitmodules read."
        @tier "internal"
      GAPS_GM_FAIL {
        error : string
      }
        @description "A .gitmodules that could not be read."
        @tier "internal"
      GAPS_PL_READ {
        data : bytes!
      }
        @description "A candidate's ledger read."
        @tier "internal"
      GAPS_PL_FAIL {
        error : string
      }
        @description "A candidate's ledger that could not be read."
        @tier "internal"
      GAPS_S3 { }
        @description "Internal: find the roll-up markers in the master."
        @tier "internal"
      GAPS_S3B { }
        @description "Internal: the markers were checked."
        @tier "internal"
      GAPS_S4 { }
        @description "Internal: collect and validate the entries of both sides."
        @tier "internal"
      GAPS_S4B { }
        @description "Internal: the entries were validated."
        @tier "internal"
      GAPS_ROWS { }
        @description "Internal: compare each code across master, repos and baseline."
        @tier "internal"
      GAPS_ROWS_DONE { }
        @description "Internal: the comparison rows are ready."
        @tier "internal"
      GAPS_ROLLUP { }
        @description "Internal: check the master for unsynchronized edits."
        @tier "internal"
      GAPS_ROLLUP_B { }
        @description "Internal: the master was checked."
        @tier "internal"
      GAPS_MERGE { }
        @description "Internal: choose the winning side per code."
        @tier "internal"
      GAPS_MERGE_B { }
        @description "Internal: the merge was decided."
        @tier "internal"
      GAPS_UPD { }
        @description "Internal: rewrite the next repo ledger."
        @tier "internal"
      GAPS_UPD_APPEND { }
        @description "Internal: add the next new entry to the repo ledger."
        @tier "internal"
      GAPS_UPD_INSERT { }
        @description "Internal: place the new entry under its section."
        @tier "internal"
      GAPS_UPD_COUNT { }
        @description "Internal: advance the Next code counter."
        @tier "internal"
      GAPS_UPD_NEXT { }
        @description "Internal: continue with the next repo ledger."
        @tier "internal"
      GAPS_RENDER { }
        @description "Internal: render the generated roll-up."
        @tier "internal"
      GAPS_RENDERED { }
        @description "Internal: the roll-up was rendered."
        @tier "internal"
      GAPS_PLANS { }
        @description "Internal: read the cause list and the gap tags."
        @tier "internal"
      GAPS_PLANS_B { }
        @description "Internal: build the table and list the problems."
        @tier "internal"
      GAPS_PLANS_C { }
        @description "Internal: answer, or write the table."
        @tier "internal"
      GAPS_W_NEXT { }
        @description "Internal: write the next file."
        @tier "internal"
      GAPS_W_MKDIR { }
        @description "A directory made."
        @tier "internal"
      GAPS_W_WROTE {
        bytes : number!
      }
        @description "A file written."
        @tier "internal"
      GAPS_W_FAILED {
        error : string
      }
        @description "A directory or file that could not be written."
        @tier "internal"
    }

    config {
      planHeading : string = "## P-017 "
        @label "Plans heading"
        @description "The heading prefix of the Plans section whose causes the ledger tags name."
      causeSections : [string] = ["### Kernel", "### Language front", "### Hosts", "### Tooling", "### std, apps, release"]
        @label "Cause subsections"
        @description "Heading prefixes of the subsections that list the causes as bullets."
      freeTags : [string] = ["one-off", "periphery"]
        @label "Free tags"
        @description "Root-cause tags that name no cause."
      markerBegin : string = "<!-- p017-gaps:begin -->"
        @label "Table begin marker"
        @description "The line that opens the generated gap table in the Plans section."
      markerEnd : string = "<!-- p017-gaps:end -->"
        @label "Table end marker"
        @description "The line that closes the generated gap table in the Plans section."
      baseline : string = ".almadar/gaps-sync-state.json"
        @label "Baseline"
        @description "The sync baseline file, relative to the working root; gitignored."
      outRoot : string = "~/.almadar/gaps-out"
        @label "Out root"
        @description "Directory --out <dir> writes under; the out grant covers it."
      foldedLedgers : [string] = ["orbital-rust/crates/orbital-shell-typescript/core", "orbital-rust/crates/orbital-shell-typescript/runtime/logger", "orbital-rust/crates/orbital-shell-typescript/tooling/eslint", "orbital-rust/crates/orbital-shell-typescript/tooling/syntax", "orbital-rust/crates/orbital-shell-typescript/src/chrome"]
        @label "Folded ledgers"
        @description "Explicit ledger owner directories folded into an active repository; no archive tree is scanned."
      order : [string] = ["orbital-rust/crates/orbital-shell-typescript/tooling/eslint", "orbital-rust/crates/orbital-shell-typescript/core", "orbital-rust/crates/orbital-shell-typescript/runtime/logger", "packages/almadar-std", "packages/almadar-behaviors", "orbital-rust/crates/orbital-shell-typescript/tooling/syntax", "apps/builder", "apps/kflow", "apps/nata", "apps/rawi", "almadar", "orbital-rust", "orbital-rust/crates/orbital-core", "orbital-rust/crates/orbital-canvas", "orbital-rust/crates/orbital-ffi", "orbital-rust/crates/orbital-wasm", "orbital-rust/crates/orbital-shell-typescript", "orbital-rust/crates/orbital-shell-typescript/src/chrome", "orbital-rust/crates/orbital-shell-python", "orbital-rust/crates/orbital-shell-rust", "orbital-rust/crates/orbital-shell-ios", "orbital-rust/crates/orbital-shell-android"]
        @label "Repo order"
        @description "Upstream to downstream order of the repos in the roll-up, per the root CLAUDE.md dependency map; unlisted repos follow alphabetically."
      ownerMoves : Map string string = { "packages/almadar-core": "orbital-rust/crates/orbital-shell-typescript/core", "packages/almadar-logger": "orbital-rust/crates/orbital-shell-typescript/runtime/logger", "packages/almadar-eslint": "orbital-rust/crates/orbital-shell-typescript/tooling/eslint", "packages/almadar-syntax": "orbital-rust/crates/orbital-shell-typescript/tooling/syntax" }
        @label "Relocated owners"
        @description "Exact old-to-active ledger owner paths, applied to master and baseline before merging."
      deprecated : [string] = ["packages/almadar-agent", "packages/almadar-runtime", "packages/almadar-server", "packages/almadar-verify", "packages/almadar-tools", "tools/almadar-pattern-sync", "tools/runtime-verify", "packages/almadar-playground-runtime", "tools/asset-workflow", "packages/almadar-auth", "packages/almadar-db"]
        @label "Retired repos"
        @description "Exact retired owner paths excluded from discovery and the active master roll-up; prior baseline entries are skipped when absent on both active sides."
    }

    listens {
      GAPS_CALLED -> inbound "cli-gaps" answers GAPS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb gaps` with its arguments and working directory."
        @synonyms "orb gaps, check gap ledgers, sync gap ledgers"
      GAPS_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> GAPS_ARGS_DONE
    }
  }

  page boot as OrbGapsOrbitalStart -> OrbGaps, ArgsCli
}
