app std-orb-gaps [
  version: "1.0.0",
  inbound: ["cli-gaps"],
  fs: { "~/.almadar/gaps-out/**": [write, create], cwd: "**": [read, write] },
  description: "std-orb-gaps — the `orb gaps` command, (check, sync, rollup). `check` reads docs/Almadar_Gaps.md under the directory the command runs in (the cwd grant anchor) and every repo ledger its generated roll-up names, then reports duplicate gap codes, repo ledgers without a Next code counter, unreadable ledgers and entries without a [mechanical], [architectural] or [owner-decision] tag, one line each (status 500, exit 1); a clean tree answers `gaps: clean` (status 200, exit 0). `sync` and `status` reconcile the master with the repo ledgers by gap code: the owners come from the .gitmodules files and the explicit foldedLedgers paths, fenced code blocks never count, a three-way merge against the baseline knob file (.almadar/gaps-sync-state.json) decides which side wins per entry and refuses divergent edits, a repo's Next code never decreases, and the preview names every change; --write saves the ledger files and the baseline, --out <dir> saves the proposed files and the baseline under the outRoot knob (~/.almadar/gaps-out, the out grant), --check fails while any ledger file would change, --from master|repos makes one side authoritative. `rollup` rebuilds the master's generated roll-up from the repo ledgers. `plans [--write | --check]` aligns docs/Almadar_Plans.md with docs/Almadar_Gaps.md by root cause: every ledger entry carries exactly one `Root cause: <TAG>.` tag, the tag is a cause id of the P-017 section (the bullets under its cause subsections) or one-off or periphery, a cause with no open gaps is marked [closed] and a [closed] cause has none, and the table between the p017-gaps markers is generated (--write replaces only that block; the default and --check refuse with one line per problem, status 500, exit 1; aligned answers `plans: aligned (N open: ...)`). Any unknown command answers the usage (status 400, exit 2)."
]
uses Spec from "almadar-std/orb-gaps"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type GapEntry = { code : string!, repo : string!, heading : string!, body : string!, at : number!, endAt : number! }
type GapMark = { at : number!, text : string! }
type GapSpan = { lo : number!, hi : number! }
type GapCodeRef = { code : string!, line : string!, path : string! }
type GapScan = { key : string!, lines : [string]!, flags : [boolean]!, entries : [GapEntry]!, gapLines : [GapCodeRef]! }
type GapJob = { key : string!, text : string!, repo : string! }
type GapRead = { path : string!, ok : boolean!, text : string! }
type GapCand = { path : string!, nested : boolean! }
type GapProbe = { path : string!, nested : boolean!, dirOk : boolean!, hasLedger : boolean!, hasPy : boolean!, hasModules : boolean! }
type GapDirEntry = { name : string!, kind : string! }
type GapSortKey = { sort : string!, path : string! }
type GapSig = { code : string!, side : string!, repo : string!, heading : string!, body : string! }
type GapRow = { code : string!, side : string!, m : string!, l : string!, p : string!, pRepo : string!, eRepo : string!, eHeading : string!, eBody : string! }
type GapTag = { code : string!, tags : [string]! }
type GapCause = { id : string!, name : string!, closed : boolean!, codes : [string]! }
type GapBaseline = { version : number!, entries : [[string, { repo : string!, heading : string!, body : string! }]]! }

orbital OrbGapsOrbital {
  uses Args from "std/behaviors/std-args"

  entity OrbGapsRun [runtime] {
    id : string!
    cwd : string = ""
    cmd : string = ""
    mode : string = ""
    outDir : string = ""
    from : string = ""
    fail : string = ""
    stage : string = ""
    queue : [string] = []
    reads : [GapRead] = []
    work : [GapCand] = []
    probes : [GapProbe] = []
    cursor : number = 0
    repos : [string] = []
    ledgerRepos : [string] = []
    jobs : [GapJob] = []
    scans : [GapScan] = []
    curLines : [string] = []
    curFences : [string] = []
    curCand : [GapMark] = []
    curSpans : [GapSpan] = []
    curFlags : [boolean] = []
    curBounds : [number] = []
    curSecs : [GapMark] = []
    curStarts : [GapMark] = []
    curKey : string = ""
    curRepo : string = ""
    curN : number = 0
    curBegin : number = 0
    findings : [string] = []
    codeRefs : [GapCodeRef] = []
    codeGroups : Map string [GapCodeRef] = {}
    mOwn : [string] = []
    lOwn : [string] = []
    markB : [GapMark] = []
    markE : [GapMark] = []
    bIdx : number = 0
    eIdx : number = 0
    mPre : string = ""
    mPost : string = ""
    masterText : string = ""
    hdrIdx : [number] = []
    hdrRepos : [string] = []
    hdrSrcs : [string] = []
    mEntries : [GapEntry] = []
    lEntries : [GapEntry] = []
    rEntries : [GapEntry] = []
    bEntries : [GapEntry] = []
    mCodes : [string] = []
    lCodes : [string] = []
    rCodes : [string] = []
    hasBaseline : boolean = false
    errs : [string] = []
    codes : [string] = []
    rows : [GapRow] = []
    groups : Map string [GapSig] = {}
    merged : [GapEntry] = []
    out : [string] = []
    uRepo : string = ""
    uLines : [string] = []
    uEntries : [GapEntry] = []
    uPend0 : [GapEntry] = []
    uPend : [GapEntry] = []
    uText : string = ""
    upc : number = 0
    utexts : [GapRead] = []
    fkeys : [string] = []
    rollupText : string = ""
    nextMaster : string = ""
    outFiles : [GapRead] = []
    wcur : number = 0
    outRel : string = ""
    ucur : number = 0
    uPrefix : string = ""
    uCi : number = 0
    pLines : [string] = []
    pSec : number = 0
    pEndSec : number = 0
    pTags : [GapTag] = []
    pCauses : [GapCause] = []
    pTable : [string] = []
    pBeginAt : number = 0
    pEndAt : number = 0
    pDrift : boolean = false
    pSummary : string = ""
    pFail : string = ""
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbGaps.GAPS_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbGaps -> OrbGapsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      GAPS_CALLED -> ready when (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (emit GAPS_ANSWERED { status: 500, body: "Error: orb gaps: the command arguments could not be read" })
      GAPS_CALLED -> ready when (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (set @entity.cwd (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [], cwd: "" }) "cwd"))
        (set @entity.cmd (default (array/first (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [], cwd: "" }) "argv")) ""))
        (emit GAPS_ARGS_PARSE { stage: "gaps" argv: (array/drop (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [], cwd: "" }) "argv") 1) flags: [{ name: "from" aliases: [] takesValue: true repeatable: false }, { name: "out" aliases: [] takesValue: true repeatable: false }, { name: "write" aliases: [] takesValue: false repeatable: false }, { name: "check" aliases: [] takesValue: false repeatable: false }] })
      GAPS_ARGS_DONE -> ready
        (set @entity.mode (if (object/has @payload.flags "write") "write" (if (object/has @payload.flags "check") "check" (if (object/has @payload.flags "out") "out" "preview"))))
        (set @entity.outDir (if (object/has @payload.flags "out") (default (array/first (default (object/get @payload.flags "out") [])) "") ""))
        (set @entity.from (if (object/has @payload.flags "from") (default (array/first (default (object/get @payload.flags "from") [])) "") ""))
        (set @entity.fail (if (not (array/includes (str/split "check|sync|status|rollup|plans" "|") @entity.cmd)) "usage"
          (if (and (= @entity.cmd "check") (> (array/len @payload.words) 0)) "usage"
            (default (array/find (array/concat
              (array/map @payload.errors (fn e (if (str/startsWith @e "unknown flag: ") (str/concat "unrecognized option: " (str/replace @e "unknown flag: " ""))
                (if (str/startsWith @e "repeated flag: ") (str/concat "duplicate option: " (str/replace @e "repeated flag: " ""))
                  (if (str/startsWith @e "missing value for --") (str/concat "--" (str/replace @e "missing value for --" "") " needs a value")
                    (str/concat "unrecognized option: " (str/replace @e "flag takes no value: " "")))))))
              (array/map @payload.positionals (fn t (str/concat "unrecognized option: " @t)))
              (array/map (array/filter ["--from", "--out", "--write", "--check"] (fn f (and (object/has @payload.flags (str/replace @f "--" "")) (not (array/includes (if (= @entity.cmd "sync") ["--from", "--out", "--write", "--check"] (if (= @entity.cmd "rollup") ["--out", "--write", "--check"] (if (= @entity.cmd "plans") ["--write", "--check"] (array/take ["--out"] 0)))) @f))))) (fn f (str/concat "unrecognized option: " @f)))
              (array/map (array/filter ["--from", "--out"] (fn f (and (> (array/len (default (object/get @payload.flags (str/replace @f "--" "")) [])) 0) (str/startsWith (default (array/first (default (object/get @payload.flags (str/replace @f "--" "")) [])) "") "--")))) (fn f (str/concat @f " needs a value")))
              [(if (> (+ (if (object/has @payload.flags "write") 1 0) (if (object/has @payload.flags "check") 1 0) (if (object/has @payload.flags "out") 1 0)) 1) "choose only one of --write, --check, --out" "")
               (if (and (object/has @payload.flags "from") (not (or (= @entity.from "master") (= @entity.from "repos")))) "--from must be master or repos" "")
               (if (and (object/has @payload.flags "out") (or (str/startsWith @entity.outDir "/") (str/includes @entity.outDir ".."))) "--out must name a directory under the outRoot knob, not a path" "")]) (fn m (!= @m ""))) ""))))
        (set @entity.stage "")
        (set @entity.queue [])
        (set @entity.reads [])
        (set @entity.work [])
        (set @entity.probes [])
        (set @entity.cursor 0)
        (set @entity.repos [])
        (set @entity.ledgerRepos [])
        (set @entity.jobs [])
        (set @entity.scans [])
        (set @entity.curLines [])
        (set @entity.curFences [])
        (set @entity.curCand [])
        (set @entity.curSpans [])
        (set @entity.curFlags [])
        (set @entity.curBounds [])
        (set @entity.curSecs [])
        (set @entity.curStarts [])
        (set @entity.curKey "")
        (set @entity.curRepo "")
        (set @entity.curN 0)
        (set @entity.curBegin 0)
        (set @entity.findings [])
        (set @entity.codeRefs [])
        (set @entity.codeGroups {})
        (set @entity.mOwn [])
        (set @entity.lOwn [])
        (set @entity.markB [])
        (set @entity.markE [])
        (set @entity.bIdx 0)
        (set @entity.eIdx 0)
        (set @entity.mPre "")
        (set @entity.mPost "")
        (set @entity.masterText "")
        (set @entity.hdrIdx [])
        (set @entity.hdrRepos [])
        (set @entity.hdrSrcs [])
        (set @entity.mEntries [])
        (set @entity.lEntries [])
        (set @entity.rEntries [])
        (set @entity.bEntries [])
        (set @entity.mCodes [])
        (set @entity.lCodes [])
        (set @entity.rCodes [])
        (set @entity.hasBaseline false)
        (set @entity.errs [])
        (set @entity.codes [])
        (set @entity.rows [])
        (set @entity.groups {})
        (set @entity.merged [])
        (set @entity.out [])
        (set @entity.uRepo "")
        (set @entity.uLines [])
        (set @entity.uEntries [])
        (set @entity.uPend0 [])
        (set @entity.uPend [])
        (set @entity.uText "")
        (set @entity.upc 0)
        (set @entity.ucur 0)
        (set @entity.utexts [])
        (set @entity.fkeys [])
        (set @entity.rollupText "")
        (set @entity.nextMaster "")
        (set @entity.outFiles [])
        (set @entity.wcur 0)
        (set @entity.pLines [])
        (set @entity.pSec 0)
        (set @entity.pEndSec 0)
        (set @entity.pTags [])
        (set @entity.pCauses [])
        (set @entity.pTable [])
        (set @entity.pBeginAt 0)
        (set @entity.pEndAt 0)
        (set @entity.pDrift false)
        (set @entity.pSummary "")
        (set @entity.pFail "")
        (set @entity.outRel @entity.outDir)
        (emit GAPS_PARSED { })
      GAPS_PARSED -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: (if (= @entity.fail "usage") 400 500), body: (if (= @entity.fail "usage") "usage: orb gaps check | sync [--from master|repos] [--write | --check | --out <dir>] | status | rollup [--write | --check | --out <dir>] | plans [--write | --check]" (str/concat "error: " @entity.fail)) })
      GAPS_PARSED -> reading when (and (= @entity.fail "") (= @entity.cmd "check"))
        (set @entity.queue (str/split "docs/Almadar_Gaps.md" "|"))
        (set @entity.stage "c1")
        (emit GAPS_READ { })
      GAPS_PARSED -> reading when (and (= @entity.fail "") (= @entity.cmd "plans"))
        (set @entity.queue (str/split "docs/Almadar_Gaps.md|docs/Almadar_Plans.md" "|"))
        (set @entity.stage "p1")
        (emit GAPS_READ { })
      GAPS_PARSED -> probing when (and (= @entity.fail "") (!= @entity.cmd "check") (!= @entity.cmd "plans"))
        (set @entity.work (array/concat [{ path: ".", nested: false }] (array/map @config.foldedLedgers (fn p { path: @p, nested: true }))))
        (emit GAPS_PROBE { })
    }

    state probing {
      INIT -> probing
      GAPS_PROBE -> probing when (< @entity.cursor (array/len @entity.work))
        (os/list-dir { anchor: "cwd" path: (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path") } { key: "dir" emit: { success: GAPS_DIR, failure: GAPS_DIR_MISSING } })
      GAPS_DIR -> probing
        (set @entity.probes (array/append @entity.probes {
          path: (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path"),
          nested: (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "nested"),
          dirOk: true,
          hasLedger: (array/some @payload.entries (fn e (= (object/get @e "name") "Almadar_Gaps.md"))),
          hasPy: (array/some @payload.entries (fn e (= (object/get @e "name") "pyproject.toml"))),
          hasModules: (array/some @payload.entries (fn e (= (object/get @e "name") ".gitmodules"))) }))
        (emit GAPS_PROBE_GM { })
      GAPS_DIR_MISSING -> probing
        (set @entity.probes (array/append @entity.probes { path: (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path"), nested: (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "nested"), dirOk: false, hasLedger: false, hasPy: false, hasModules: false }))
        (emit GAPS_PROBE_NEXT { })
      GAPS_PROBE_GM -> probing when (object/get (default (array/last @entity.probes) { path: "", nested: false, dirOk: false, hasLedger: false, hasPy: false, hasModules: false }) "hasModules")
        (os/read-file { anchor: "cwd" path: (str/concat (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path") "/.gitmodules") } { key: "modules" emit: { success: GAPS_GM_TEXT, failure: GAPS_GM_FAIL } })
      GAPS_PROBE_GM -> probing when (not (object/get (default (array/last @entity.probes) { path: "", nested: false, dirOk: false, hasLedger: false, hasPy: false, hasModules: false }) "hasModules"))
        (emit GAPS_PROBE_LEDGER { })
      GAPS_GM_TEXT -> probing when (= (bytes/to-string @payload.data) null)
        (emit GAPS_GM_FAIL { error: "the .gitmodules is not text" })
      GAPS_GM_TEXT -> probing when (!= (bytes/to-string @payload.data) null)
        (set @entity.work (array/concat @entity.work (array/map
          (array/filter (str/split (default (bytes/to-string @payload.data) "") "\n") (fn l (validate/pattern @l "^\\s*path\\s*=")))
          (fn l { path: (os/path-normalize (os/path-join (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path") (str/trim (str/replace-pattern @l "^\\s*path\\s*=" "")))), nested: (!= (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path") ".") }))))
        (emit GAPS_PROBE_LEDGER { })
      GAPS_GM_FAIL -> probing
        (emit GAPS_PROBE_LEDGER { })
      GAPS_PROBE_LEDGER -> probing when (object/get (default (array/last @entity.probes) { path: "", nested: false, dirOk: false, hasLedger: false, hasPy: false, hasModules: false }) "hasLedger")
        (os/read-file { anchor: "cwd" path: (str/concat (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path") "/Almadar_Gaps.md") } { key: "ledger" emit: { success: GAPS_PL_READ, failure: GAPS_PL_FAIL } })
      GAPS_PROBE_LEDGER -> probing when (not (object/get (default (array/last @entity.probes) { path: "", nested: false, dirOk: false, hasLedger: false, hasPy: false, hasModules: false }) "hasLedger"))
        (emit GAPS_PROBE_NEXT { })
      GAPS_PL_READ -> probing when (= (bytes/to-string @payload.data) null)
        (emit GAPS_PL_FAIL { error: "the ledger is not text" })
      GAPS_PL_READ -> probing when (!= (bytes/to-string @payload.data) null)
        (set @entity.reads (array/append @entity.reads { path: (os/path-normalize (os/path-join (object/get (default (array/nth @entity.work @entity.cursor) { path: "", nested: false }) "path") "Almadar_Gaps.md")), ok: true, text: (default (bytes/to-string @payload.data) "") }))
        (emit GAPS_PROBE_NEXT { })
      GAPS_PL_FAIL -> probing
        (emit GAPS_PROBE_NEXT { })
      GAPS_PROBE_NEXT -> probing
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_PROBE { })
      GAPS_PROBE -> probing when (>= @entity.cursor (array/len @entity.work))
        (set @entity.repos (array/map (array/sort (array/map
          (array/filter @entity.probes (fn p (and (!= (object/get @p "path") ".") (object/get @p "dirOk") (not (object/get @p "hasPy")) (or (not (object/get @p "nested")) (object/get @p "hasLedger")) (not (array/includes @config.deprecated (object/get @p "path"))))))
          (fn p { sort: (str/concat (str/padStart (str/concat (let ((i (array/indexOf @config.order (object/get @p "path")))) (if (< @i 0) (array/len @config.order) @i))) 3 "0") "|" (str/collate-key (object/get @p "path"))), path: (object/get @p "path") })) "sort") (fn k (object/get @k "path"))))
        (set @entity.findings (array/map @entity.repos (fn p (if (= @p "orbital-rust") "ORB" (let ((dir (os/path-base @p))) (if (= @dir "almadar") "ALMADAR" (str/upper (str/replace-pattern @dir "^almadar-" "")))))))) 
        (set @entity.fail (let ((dup (array/find @entity.findings (fn v (< (array/indexOf @entity.findings @v) @index))))) (if (= @dup null) "" (str/concat "two repos derive the same gap prefix G-" @dup "-"))))
        (emit GAPS_PROBED { })
      GAPS_PROBED -> ready when (!= @entity.fail "")
        (emit GAPS_ANSWERED { status: 500, body: (str/concat "error: " @entity.fail) })
      GAPS_PROBED -> reading when (= @entity.fail "")
        (set @entity.queue (array/append (str/split "docs/Almadar_Gaps.md" "|") @config.baseline))
        (set @entity.stage "s2")
        (set @entity.cursor 0)
        (emit GAPS_READ { })
    }

    state reading {
      INIT -> reading
      GAPS_READ -> reading when (< @entity.cursor (array/len @entity.queue))
        (os/read-file { anchor: "cwd" path: (default (array/nth @entity.queue @entity.cursor) "") } { key: "ledger" emit: { success: GAPS_FILE_READ, failure: GAPS_FILE_UNREAD } })
      GAPS_FILE_READ -> reading when (= (bytes/to-string @payload.data) null)
        (emit GAPS_FILE_UNREAD { error: "the file is not text" })
      GAPS_FILE_READ -> reading when (!= (bytes/to-string @payload.data) null)
        (set @entity.reads (array/append @entity.reads { path: (default (array/nth @entity.queue @entity.cursor) ""), ok: true, text: (default (bytes/to-string @payload.data) "") }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_READ_NEXT { })
      GAPS_FILE_UNREAD -> reading
        (set @entity.reads (array/append @entity.reads { path: (default (array/nth @entity.queue @entity.cursor) ""), ok: false, text: "" }))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit GAPS_READ_NEXT { })
      GAPS_READ_NEXT -> reading
        (emit GAPS_READ { })
      GAPS_READ -> scanning when (and (>= @entity.cursor (array/len @entity.queue)) (or (= @entity.stage "c1") (= @entity.stage "c3")))
        (set @entity.jobs (array/map @entity.reads (fn r { key: (object/get @r "path"), text: (object/get @r "text"), repo: "" })))
        (set @entity.stage (if (= @entity.stage "c1") "c2" "c4"))
        (set @entity.scans [])
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_READ -> ready when (and (>= @entity.cursor (array/len @entity.queue)) (= @entity.stage "p1") (array/some @entity.reads (fn r (not (object/get @r "ok")))))
        (emit GAPS_ANSWERED { status: 500, body: (str/join (array/map (array/filter @entity.reads (fn r (not (object/get @r "ok")))) (fn r (str/concat "error: cannot read " (object/get @r "path")))) "\n") })
      GAPS_READ -> scanning when (and (>= @entity.cursor (array/len @entity.queue)) (= @entity.stage "p1") (not (array/some @entity.reads (fn r (not (object/get @r "ok"))))))
        (set @entity.jobs (array/map (array/filter @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) (fn r { key: "docs/Almadar_Gaps.md", text: (object/get @r "text"), repo: "ROOT" })))
        (set @entity.stage "p2")
        (set @entity.scans [])
        (set @entity.cursor 0)
        (emit GAPS_SCAN { })
      GAPS_READ -> ready when (and (>= @entity.cursor (array/len @entity.queue)) (= @entity.stage "s2") (not (object/get (default (array/find @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) { path: "", ok: false, text: "" }) "ok")))
        (emit GAPS_ANSWERED { status: 500, body: "error: cannot read docs/Almadar_Gaps.md" })
      GAPS_READ -> scanning when (and (>= @entity.cursor (array/len @entity.queue)) (= @entity.stage "s2") (object/get (default (array/find @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) { path: "", ok: false, text: "" }) "ok"))
        (set @entity.ledgerRepos (array/filter @entity.repos (fn r (array/some @entity.reads (fn x (and (= (object/get @x "path") (str/concat @r "/Almadar_Gaps.md")) (object/get @x "ok")))))))
        (set @entity.masterText (object/get (default (array/find @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) { path: "", ok: false, text: "" }) "text"))
        (set @entity.jobs (array/concat
          (array/map (array/filter @entity.reads (fn r (= (object/get @r "path") "docs/Almadar_Gaps.md"))) (fn r { key: (object/get @r "path"), text: (object/get @r "text"), repo: "ROOT" }))
          (array/map @entity.ledgerRepos (fn r { key: (str/concat @r "/Almadar_Gaps.md"), text: (object/get (default (array/find @entity.reads (fn x (= (object/get @x "path") (str/concat @r "/Almadar_Gaps.md")))) { path: "", ok: false, text: "" }) "text"), repo: @r }))))
