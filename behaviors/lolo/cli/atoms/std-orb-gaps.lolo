              (if (< (array/indexOf @entity.hdrRepos (array/nth @entity.hdrRepos @h)) @h) (str/concat "duplicate repo section: " (array/nth @entity.hdrRepos @h)) "")))) (fn m (!= @m ""))) ""),
          (if (array/some @entity.mEntries (fn e (= (object/get @e "repo") ""))) "gap outside an explicit repo section in master roll-up" ""),
          (str/default (array/find (array/map (array/filter @entity.repos (fn r (and (array/includes @entity.hdrRepos @r) (not (array/includes @entity.ledgerRepos @r))))) (fn r (str/concat "missing ledger: " @r "/Almadar_Gaps.md"))) (fn m (!= @m ""))) ""),
          (let ((d (array/find @entity.mCodes (fn c (< (array/indexOf @entity.mCodes @c) @index))))) (if (= @d null) "" (str/concat "duplicate gap code: " @d))),
          (let ((d (array/find @entity.lCodes (fn c (< (array/indexOf @entity.lCodes @c) @index))))) (if (= @d null) "" (str/concat "duplicate gap code: " @d))),
