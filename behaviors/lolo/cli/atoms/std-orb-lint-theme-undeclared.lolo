app std-orb-lint-theme-undeclared [
  version: "1.0.0",
  inbound: ["cli-lint-theme-undeclared"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-theme-undeclared — the `orb lint theme-undeclared <file>` command, the port of ORB_THEME_UNDECLARED (theme.rs validate_data_themes, G-UI-106). It lowers the file with program/read and, per trait, folds every transition effect, tick effect and config default for a `data-theme` value that resolves to a literal theme (the string itself, or the literal string default of the `@config.<knob>` it reads; an unset knob, another binding or an empty value is no theme). A theme whose base (the key without its -dark or -light mode) is not declared by the app theme, an orbital theme or an entry of the `themes` list (each a key or an inline theme name) is reported once per trait, sorted (status 500, exit 1). Clean answers `lint theme-undeclared: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-theme-undeclared"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type TdVal = string | number | boolean | [TdVal?] | Map string TdVal?
type TdStr = string
type TdCH = { path : string!, node : TdVal! }
type TdIdx = Map string [TdCH]
type TdRes = { t : [string] }
type TdKnob = { default : TdVal? }
type TdTransition = { effects : [TdVal?] }
type TdMachine = { transitions : [TdTransition] }
type TdTick = { effects : [TdVal?] }
type TdTrait = { name : string, config : Map string TdKnob, stateMachine : TdMachine, ticks : [TdTick] }
type TdNamed = { name : string }
type TdOrbital = { name : string, theme : string | TdNamed, traits : [TdTrait] }
type TdProgram = { theme : string | TdNamed, themes : [string | TdNamed], orbitals : [TdOrbital] }


type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintThemeUndeclaredCodes = { themeUndeclared : LintCodeDecl , lintIndexMissing : LintCodeDecl }

orbital OrbLintThemeUndeclaredOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintThemeUndeclaredRun [runtime] {
    uKeys : Map string [string] = {}
    unitsHeard : boolean = false
    unitsScope : string = ""
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintThemeUndeclared -> OrbLintThemeUndeclaredRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      UNITS_HEARD -> ready
        (set @entity.uKeys @payload.keys)
        (set @entity.unitsHeard true)
        (set @entity.unitsScope @payload.scope)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (and @entity.unitsHeard (= @entity.unitsScope @payload.scope))
(let ((orbitals (object/get @payload.program "orbitals" [])) (dq "\""))
          (let ((declared (array/concat
                    (array/flatten (array/map (object/get @payload.program "themes" []) (fn k (if (validate/string @k) [(if (str/endsWith @k "-dark") (str/slice @k 0 (- (str/len @k) 5)) (if (str/endsWith @k "-light") (str/slice @k 0 (- (str/len @k) 6)) @k))] (if (validate/object @k) (let ((nm (object/get @k "name" ""))) (if (and (validate/string @nm) (!= @nm "")) [@nm] [])) [])))))
                    (if (validate/string (object/get @payload.program "theme" null)) (if (= (object/get @payload.program "theme" null) "") [] [(if (str/endsWith (object/get @payload.program "theme" null) "-dark") (str/slice (object/get @payload.program "theme" null) 0 (- (str/len (object/get @payload.program "theme" null)) 5)) (if (str/endsWith (object/get @payload.program "theme" null) "-light") (str/slice (object/get @payload.program "theme" null) 0 (- (str/len (object/get @payload.program "theme" null)) 6)) (object/get @payload.program "theme" null)))]) (if (validate/object (object/get @payload.program "theme" null)) (let ((nm (object/get (object/get @payload.program "theme" null) "name" ""))) (if (and (validate/string @nm) (!= @nm "")) [@nm] [])) []))
                    (array/flatten (array/map @orbitals (fn o (if (validate/string (object/get @o "theme" null)) (if (= (object/get @o "theme" null) "") [] [(if (str/endsWith (object/get @o "theme" null) "-dark") (str/slice (object/get @o "theme" null) 0 (- (str/len (object/get @o "theme" null)) 5)) (if (str/endsWith (object/get @o "theme" null) "-light") (str/slice (object/get @o "theme" null) 0 (- (str/len (object/get @o "theme" null)) 6)) (object/get @o "theme" null)))]) (if (validate/object (object/get @o "theme" null)) (let ((nm (object/get (object/get @o "theme" null) "name" ""))) (if (and (validate/string @nm) (!= @nm "")) [@nm] [])) [])))))))
                (zero 0))
              (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                (let ((orb (array/nth @orbitals @oi)))
                  (let ((trs (object/get @orb "traits" [])))
                    (array/flatten (array/map (array/range 0 (array/len @trs)) (fn tj
                      (let ((td (array/nth @trs @tj)))
                        (let ((cfg (object/get @td "config" {})) (tname (object/get @td "name" "")) (units (array/concat [(str/concat @oi "-" @tj "-c")] (array/map (array/range 0 (array/len (object/get (object/get @td "stateMachine" {}) "transitions" []))) (fn n (str/concat @oi "-" @tj "-" @n))) (array/map (array/range 0 (array/len (object/get @td "ticks" []))) (fn n (str/concat @oi "-" @tj "-k" @n))))) (themeless (and (!= (object/get @td "stateMachine" null) null) (not (array/some @units (fn u (array/includes (object/get @entity.uKeys @u []) "data-theme")))))))
                          (let ((roots (if @themeless [] (array/concat
                                  (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "transitions" []) (fn tr (array/filter (object/get @tr "effects" []) (fn e (validate/array @e))))))
                                  (array/flatten (array/map (object/get @td "ticks" []) (fn tk (array/filter (object/get @tk "effects" []) (fn e (validate/array @e))))))
                                  (array/map (array/filter (object/values @cfg) (fn kn (object/has @kn "default"))) (fn kn (object/get @kn "default")))))))
                            (let ((found (array/sort (array/unique (array/filter (array/map (array/filter (array/flatten (object/values (default (as (tree/index (let ((srcl : [TdVal?] [0 @roots])) @srcl) [] { prefixes: [""] }) TdIdx) {}))) (fn c (str/endsWith (object/get @c "path" "") ".data-theme"))) (fn c (let ((v (default (as (object/get @c "node" null) TdStr) ""))) (if (str/startsWith @v (quote "@config.")) (let ((kn (object/get @cfg (str/slice @v 8) null))) (if (validate/object @kn) (let ((d (object/get @kn "default" null))) (if (validate/string @d) @d "")) "")) @v)))) (fn lit (not (or (= @lit "") (str/startsWith @lit (quote "@"))))))))))
                              (array/map (array/filter @found (fn t (not (array/includes @declared (if (str/endsWith @t "-dark") (str/slice @t 0 (- (str/len @t) 5)) (if (str/endsWith @t "-light") (str/slice @t 0 (- (str/len @t) 6)) @t)))))) (fn t
                                { code: @config.codes.themeUndeclared.code, path: (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @tj " (" @tname ")]"), message: (str/concat "'" @tname "' shows a frame in theme " @dq @t @dq ", which the program does not declare"), suggestion: (str/concat "add " @dq @t @dq " to the app's `themes: [...]` (the themes a program switches to inside a page)"), severity: "error" }))))))))))))))))
[{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without LINT_UNITS, so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_UNITS before LINT_INPUT; this rule did not hear it", severity: "error" }]))
        (set @entity.unitsHeard false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "theme-undeclared", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : TdProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      UNITS_HEARD { scope : string!  keys : Map string [string]!  guardKeys : Map string [string]!  emitStr : [string]!  guardEmitStr : [string]!  itemRoots : Map string [string]!  guardItemRoots : Map string [string]! }
        @description "std-orb-lint-input's LINT_UNITS: the object keys, string emits and @item/@index roots of every transition, tick and config unit."
      OrbLintInput.LINT_UNITS -> UNITS_HEARD
    }
    config {
      codes : LintThemeUndeclaredCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without a shared program fact the rule reads (the structural index, sites, units, embeds or entities), so the rule cannot check the program" }, themeUndeclared: { code: "ORB_THEME_UNDECLARED", category: "theme", description: "A frame is shown in a literal theme that the program does not declare, so no stylesheet ships for it" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintThemeUndeclaredCli -> OrbLintThemeUndeclaredRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint theme-undeclared <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint theme-undeclared <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "theme-undeclared") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint theme-undeclared: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "theme-undeclared") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint theme-undeclared: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-theme-undeclared" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint theme-undeclared` with its arguments and working directory."
        @synonyms "orb lint theme-undeclared"
      OrbLintThemeUndeclared.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintThemeUndeclaredCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintThemeUndeclaredOrbitalStart -> OrbLintThemeUndeclared, OrbLintThemeUndeclaredCli, OrbLintInput, Packs, Versions
}
