app std-orb-lint-not-found [
  version: "1.0.0",
  inbound: ["cli-lint-not-found"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-not-found - the `orb lint not-found <file>` command, the `[notFound]` page lint of `orb validate --final` (G-ORB-COMPILER-004, owner-approved): the program is the whole app, so one that declares route pages (a page with a path and no protocol) must declare exactly one `[notFound]` page. No `[notFound]` page is a warning at the program, two or more is an error at the second. Each finding reads its code from the rule's `codes` record (notFoundMissing, notFoundDuplicate). Clean answers `lint not-found: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-not-found"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type NfPage = { path : string, protocol : string, isNotFound : boolean }
type NfOrbital = { name : string, pages : [NfPage] }
type NfProgram = { orbitals : [NfOrbital] }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type NotFoundCodes = { notFoundMissing : LintCodeDecl, notFoundDuplicate : LintCodeDecl }
orbital OrbLintNotFoundOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintNotFoundRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintNotFound -> OrbLintNotFoundRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((allp (array/flatten (array/map (object/get @payload.program "orbitals" []) (fn o (object/get @o "pages" [])))))) (let ((routes (array/filter @allp (fn p (and (!= (object/get @p "path" "") "") (= (object/get @p "protocol" "") ""))))) (marked (array/filter @allp (fn p (= (object/get @p "isNotFound" false) true))))) (array/concat (if (and (> (array/len @routes) 0) (= (array/len @marked) 0)) [{ code: @config.codes.notFoundMissing.code, path: "orbitals", message: "The program declares route pages but no `[notFound]` page, so a path no page matches has nothing to show", suggestion: "Declare one page with the `[notFound]` modifier", severity: "warning" }] []) (if (> (array/len @marked) 1) [{ code: @config.codes.notFoundDuplicate.code, path: "orbitals", message: (str/concat "The program declares " (array/len @marked) " `[notFound]` pages; a path no page matches can show only one"), suggestion: "Keep one page with the `[notFound]` modifier", severity: "error" }] [])))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "not-found", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    config {
      codes : NotFoundCodes = { notFoundMissing: { code: "ORB_PAGE_NOT_FOUND_MISSING", category: "page", description: "A program with route pages declares no [notFound] page." }, notFoundDuplicate: { code: "ORB_PAGE_NOT_FOUND_DUPLICATE", category: "page", description: "A program declares more than one [notFound] page." } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : NfProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintNotFoundCli -> OrbLintNotFoundRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint not-found <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "not-found") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint not-found: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "not-found") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint not-found: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-not-found" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint not-found` with its arguments and working directory."
        @synonyms "orb lint not-found"
      OrbLintNotFound.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintNotFoundCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintNotFoundOrbitalStart -> OrbLintNotFound, OrbLintNotFoundCli, OrbLintInput, Packs, Versions
}
