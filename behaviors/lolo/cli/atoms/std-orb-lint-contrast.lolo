app std-orb-lint-contrast [
  version: "1.0.0",
  inbound: ["cli-lint-contrast"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-contrast — the `orb lint contrast <file>` command, the WCAG 2.2 AA rule for Rasm looks. For every orbital that composes std-rasm-theme (a trait whose ref names an alias that the orbital's uses binds to std/behaviors/std-rasm-theme), and for the std-rasm-theme atom itself when it is the file, it takes each style of the trait's `styles` config, merges `base` and the style's `looks`, resolves palette names against the installed @almadar/core theme named after the style (std-orb-lint-input's LINT_THEME_PALETTES; light colors, then the dark variant when the theme has one, named `styles.<s>.dark.looks.<key>`), and checks the ratios with the kernel color/contrast operator: a look with textColor needs 4.5 (3.0 from 24px, or from 18.66px at weight 600) against its backdrop (the fill of the look its `on` names, else its own fill, else surface/ground/idle's; a plate or halo backing uses its own fill) and a text size under 13px is rasm-text-size; a stroke of a pressable, textfield, choice, toggle, card/surface, range or focus/ring/inner look needs 3.0 against the fill of its `on` look or surface/ground/idle unless its own fill already reaches 3.0 there. Looks with a material are skipped, colours that are empty, none, transparent or alpha 0 are skipped, a translucent backdrop is the warning rasm-contrast-translucent, a colour that is not a hex or rgb colour after resolution is the warning rasm-contrast-unparsed and a style whose theme file is unreadable is the warning rasm-contrast-theme-unread. One finding per failure (status 500, exit 1). Clean answers `lint contrast: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-contrast"
type CxVal = string | number | boolean | [CxVal] | Map string CxVal
type CxKnob = { default : CxVal }
type CxCfg = { styles : CxKnob, base : CxKnob }
type CxTrait = { name : string, config : CxCfg }
type CxOrbital = { name : string, traits : [CxTrait] }
type CxProgram = { orbitals : [CxOrbital] }
type CxLook = { fill : string, textColor : string, stroke : string, font : string, backing : string, on : string, material : CxVal }
type CxLookTbl = Map string CxLook
type CxStyle = { looks : CxLookTbl }
type CxStyleTbl = Map string CxStyle
type CxVariant = { tag : string, p : Map string string }
type CxPalette = { light : Map string string!, dark : Map string string! }
type CxSite = { oi : number!, ti : number! }
type CxRow = { e : string!, raw : string!, c : string!, skip : boolean!, ok : boolean!, tr : boolean! }
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type ContrastCodes = { contrast : LintCodeDecl, textSize : LintCodeDecl, translucent : LintCodeDecl, unparsed : LintCodeDecl, themeUnread : LintCodeDecl }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }

orbital OrbLintContrastOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintContrastRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    palettes : Map string CxPalette = {}
    sites : [CxSite] = []
  }

  trait OrbLintContrast -> OrbLintContrastRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      THEME_PALETTES_HEARD -> ready
        (set @entity.palettes @payload.palettes)
        (set @entity.sites @payload.sites)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (!= @payload.scope "") []
          (let ((orbitals (object/get @payload.program "orbitals" [])) (palettes @entity.palettes)) (object/values (object/fromEntries (array/map (array/flatten (array/map @entity.sites (fn site (let ((orb : CxOrbital (default (array/nth @orbitals (object/get @site "oi")) { name: "", traits: [] })) (td : CxTrait (default (array/nth (object/get @orb "traits" []) (object/get @site "ti")) { name: "", config: { styles: { default: {} }, base: { default: {} } } })) (nk : CxKnob { default: {} })) (let ((bk : CxKnob (object/get (object/get @td "config" {}) "base" @nk)) (sk : CxKnob (object/get (object/get @td "config" {}) "styles" @nk))) (let ((base : CxLookTbl (default (as (object/get @bk "default") CxLookTbl) {})) (styles : CxStyleTbl (default (as (object/get @sk "default") CxStyleTbl) {}))) (array/flatten (array/map (object/keys @styles) (fn sname (let ((pl : CxPalette? (object/get @palettes @sname null))) (if (or (= @pl null) (= (array/len (object/keys (object/get @pl "light" {}))) 0)) [{ code: @config.codes.themeUnread.code, path: (str/concat "styles." @sname), message: (str/concat "Style '" @sname "' has no readable theme palette: the installed @almadar/core has no theme '" @sname "' with colors"), suggestion: "Name each style after an installed theme", severity: "warning" }] (let ((st : CxStyle (default (object/get @styles @sname) { looks: {} })) (sl : CxLookTbl (object/get @st "looks" {}))) (let ((keys : [string] (array/unique (array/concat (object/keys @base) (object/keys @sl))))) (let ((looks : CxLookTbl (default (as (object/fromEntries (array/map @keys (fn k [@k, (object/merge (default (object/get @base @k) {}) (default (object/get @sl @k) {}))]))) CxLookTbl) {})) (variants : [CxVariant] (array/concat [{ tag: "", p: (object/get @pl "light" {}) }] (if (> (array/len (object/keys (object/get @pl "dark" {}))) 0) [{ tag: "dark", p: (object/merge (object/get @pl "light" {}) (object/get @pl "dark" {})) }] [])))) (array/flatten (array/map @variants (fn v (let ((vp : Map string string (object/get @v "p" {})) (pre (str/concat "styles." @sname (if (= (object/get @v "tag") "") "" ".dark") ".looks.")) (gl : CxLook (default (object/get @looks "surface/ground/idle") {})) (ground (object/get @gl "fill" ""))) (array/flatten (array/map @keys (fn k (let ((L : CxLook (default (object/get @looks @k) {})) (path (str/concat @pre @k))) (let ((fillR (object/get @L "fill" "")) (tcR (object/get @L "textColor" "")) (stR (object/get @L "stroke" "")) (font (object/get @L "font" "")) (mat (object/has @L "material")) (backing (object/get @L "backing" "none")) (onK (object/get @L "on" ""))) (let ((onR (if (= @onK "") "" (object/get (default (object/get @looks @onK) {}) "fill" "")))) (let ((onUse (not (or (= @onR "") (= @onR "none") (= @onR "transparent")))) (fillUse (not (or (= @fillR "") (= @fillR "none") (= @fillR "transparent")))) (plate (or (= @backing "plate") (= @backing "halo")))) (let ((bdTR (if @plate @fillR (if @onUse @onR (if @fillUse @fillR @ground)))) (bdTK (if @plate @k (if @onUse @onK (if @fillUse @k "surface/ground/idle")))) (bdNR (if @onUse @onR @ground)) (bdNK (if @onUse @onK "surface/ground/idle"))) (let ((rows0 : [CxRow] (array/map [@fillR, @tcR, @stR, @bdTR, @bdNR, @ground] (fn c (let ((cc (default (object/get @vp @c null) @c))) { e: "", raw: @c, c: @cc, skip: (or (= @c "") (= @c "none") (= @c "transparent") (= @cc "transparent") (validate/pattern @cc "^rgba\\(.*,\\s*0(\\.0+)?\\s*\\)$")), ok: (validate/pattern @cc "^(#[0-9a-fA-F]{3,8}|rgba?\\([0-9., %]+\\))$"), tr: (or (and (validate/pattern @cc "^rgba\\(") (not (validate/pattern @cc ",\\s*1(\\.0+)?\\s*\\)$"))) (validate/pattern @cc "^#[0-9a-fA-F]{6}([0-9a-eA-E][0-9a-fA-F]|[0-9a-fA-F][0-9a-eA-E])$") (validate/pattern @cc "^#[0-9a-fA-F]{3}[0-9a-eA-E]$")) })))) (nr : CxRow { e: "", raw: "", c: "", skip: true, ok: false, tr: false })) (let ((gW0 : CxRow (default (array/nth @rows0 5) @nr))) (let ((gUse (and (object/get @gW0 "ok") (not (object/get @gW0 "skip")) (not (object/get @gW0 "tr")) (or (validate/pattern (object/get @gW0 "c") "^#[0-9a-fA-F]{6}$") (validate/pattern (object/get @gW0 "c") "^rgba?\\("))))) (let ((gch : [number] (if (validate/pattern (object/get @gW0 "c") "^#[0-9a-fA-F]{6}$") [(+ (* 16 (default (array/findIndex (str/split "0123456789abcdef" "") (fn h (= @h (str/lower (str/slice (object/get @gW0 "c") 1 2))))) 0)) (default (array/findIndex (str/split "0123456789abcdef" "") (fn h (= @h (str/lower (str/slice (object/get @gW0 "c") 2 3))))) 0)) (+ (* 16 (default (array/findIndex (str/split "0123456789abcdef" "") (fn h (= @h (str/lower (str/slice (object/get @gW0 "c") 3 4))))) 0)) (default (array/findIndex (str/split "0123456789abcdef" "") (fn h (= @h (str/lower (str/slice (object/get @gW0 "c") 4 5))))) 0)) (+ (* 16 (default (array/findIndex (str/split "0123456789abcdef" "") (fn h (= @h (str/lower (str/slice (object/get @gW0 "c") 5 6))))) 0)) (default (array/findIndex (str/split "0123456789abcdef" "") (fn h (= @h (str/lower (str/slice (object/get @gW0 "c") 6 7))))) 0))] (array/map [0 1 2] (fn i (default (str/to-number (default (array/nth (str/split (str/replace (str/replace (str/replace (str/replace (object/get @gW0 "c") "rgba(" "") "rgb(" "") ")" "") " " "") ",") @i) "0")) 0)))))) (let ((rows : [CxRow] (array/map @rows0 (fn r (if (not (and (object/get @r "ok") (object/get @r "tr"))) (object/merge @r { e: (if (object/get @r "ok") (object/get @r "c") "") }) (if (not (and @gUse (validate/pattern (object/get @r "c") "^rgba\\("))) @r (let ((tp : [string] (str/split (str/replace (str/replace (str/replace (str/replace (object/get @r "c") "rgba(" "") "rgb(" "") ")" "") " " "") ",")) (ta : number (default (str/to-number (default (array/nth @tp 3) "1")) 1))) (object/merge @r { e: (str/concat "rgb(" (str/join (array/map [0 1 2] (fn i (+ (* (default (str/to-number (default (array/nth @tp @i) "0")) 0) @ta) (* (default (array/nth @gch @i) 0) (- 1 @ta))))) ",") ")") })))))))) (let ((fillW : CxRow (default (array/nth @rows 0) @nr)) (tcW : CxRow (default (array/nth @rows 1) @nr)) (gW : CxRow (default (array/nth @rows 5) @nr)) (stW : CxRow (default (array/nth @rows 2) @nr)) (bdT : CxRow (default (array/nth @rows 3) @nr)) (bdN : CxRow (default (array/nth @rows 4) @nr)) (toks (str/split @font " "))) (let ((sizeTok (array/find @toks (fn t (validate/pattern @t "^[0-9.]+px$")))) (wTok (array/first @toks))) (let ((size : number? (if (= @sizeTok null) null (str/to-number (str/replace @sizeTok "px" "")))) (weight (if (and (!= @wTok null) (validate/pattern @wTok "^[0-9]+$")) (default (str/to-number @wTok) 400) 400))) (let ((req (if (and (!= @size null) (or (>= @size 24) (and (>= @size 18.66) (>= @weight 600)))) 3 4.5)) (textOn (and (not @mat) (not (object/get @tcW "skip")))) (strokeOn (and (not @mat) (not (object/get @stW "skip")) (or (str/startsWith @k "pressable/") (str/startsWith @k "textfield/") (str/startsWith @k "choice/") (str/startsWith @k "toggle/") (str/startsWith @k "card/surface/") (str/startsWith @k "range/") (= @k "focus/ring/inner"))))) (let ((textOk (and @textOn (object/get @tcW "ok") (object/get @bdT "ok") (not (object/get @bdT "skip")) (!= (object/get @bdT "e") ""))) (strokeOk (and @strokeOn (object/get @stW "ok") (object/get @bdN "ok") (not (object/get @bdN "skip")) (!= (object/get @bdN "e") "")))) (let ((tRatio (if @textOk (/ (math/round (* (color/contrast (object/get @tcW "c") (object/get @bdT "e")) 100)) 100) 21)) (sRatio (if @strokeOk (/ (math/round (* (color/contrast (object/get @stW "c") (object/get @bdN "e")) 100)) 100) 21)) (fRatio (if (and @strokeOk (not (object/get @fillW "skip")) (object/get @fillW "ok") (not (object/get @fillW "tr"))) (color/contrast (object/get @fillW "c") (object/get @bdN "e")) 0))) (array/flatten [
  (if (and @textOk (< @tRatio @req)) [{ code: @config.codes.contrast.code, path: @path, message: (str/concat "Text " (object/get @tcW "raw") " (" (object/get @tcW "c") ") on " (object/get @bdT "raw") " (" (object/get @bdT "c") ")" (if (object/get @bdT "tr") (str/concat " over " (object/get @gW "raw") " (" (object/get @gW "c") ")") "") " is " @tRatio ":1, below the " @req ":1 that " (if (= @req 3) "large" "body") " text needs"), suggestion: "Darken or lighten the text colour, or change the backdrop it sits on", severity: "error" }] [])
  (if (and @textOn (!= @size null) (< @size 13)) [{ code: @config.codes.textSize.code, path: @path, message: (str/concat "Text is " @size "px (font '" @font "'), below the 13px floor"), suggestion: "Raise the font size to at least 13px", severity: "error" }] [])
  (if (and @strokeOk (< @sRatio 3) (< @fRatio 3)) [{ code: @config.codes.contrast.code, path: @path, message: (str/concat "Stroke " (object/get @stW "raw") " (" (object/get @stW "c") ") on " (object/get @bdN "raw") " (" (object/get @bdN "c") ")" (if (object/get @bdN "tr") (str/concat " over " (object/get @gW "raw") " (" (object/get @gW "c") ")") "") " is " @sRatio ":1, below the 3:1 a control edge needs"), suggestion: "Darken or lighten the stroke, or give the look a fill that reaches 3:1 on its backdrop", severity: "error" }] [])
  (if (or (and @textOn (not (object/get @bdT "skip")) (object/get @bdT "ok") (object/get @bdT "tr") (= (object/get @bdT "e") "")) (and @strokeOn (not (object/get @bdN "skip")) (object/get @bdN "ok") (object/get @bdN "tr") (= (object/get @bdN "e") ""))) [{ code: @config.codes.translucent.code, path: (str/concat @pre (if (and @textOn (not (object/get @bdT "skip")) (object/get @bdT "ok") (object/get @bdT "tr") (= (object/get @bdT "e") "")) (if (= @bdTK "surface/ground/idle") "surface/ground/idle" (if (not @gUse) "surface/ground/idle" @bdTK)) (if (= @bdNK "surface/ground/idle") "surface/ground/idle" (if (not @gUse) "surface/ground/idle" @bdNK)))), message: (str/concat "The backdrop " (if (and @textOn (not (object/get @bdT "skip")) (object/get @bdT "ok") (object/get @bdT "tr") (= (object/get @bdT "e") "")) (object/get @bdT "raw") (object/get @bdN "raw")) " (" (if (and @textOn (not (object/get @bdT "skip")) (object/get @bdT "ok") (object/get @bdT "tr") (= (object/get @bdT "e") "")) (object/get @bdT "c") (object/get @bdN "c")) ") is translucent and no opaque hex or rgb ground lies behind it, so contrast over it is not decided by the look table"), suggestion: "Give the ground (surface/ground/idle) an opaque fill", severity: "warning" }] [])
  (if (and @textOn (not (object/get @tcW "ok"))) [{ code: @config.codes.unparsed.code, path: @path, message: (str/concat "textColor '" (object/get @tcW "raw") "' does not resolve to a hex or rgb colour in the theme '" @sname "'"), suggestion: "Use a palette name of the theme or a hex or rgb colour", severity: "warning" }] [])
  (if (and @strokeOn (not (object/get @stW "ok"))) [{ code: @config.codes.unparsed.code, path: @path, message: (str/concat "stroke '" (object/get @stW "raw") "' does not resolve to a hex or rgb colour in the theme '" @sname "'"), suggestion: "Use a palette name of the theme or a hex or rgb colour", severity: "warning" }] [])
])))))))))))))))))))))))))))))))))))))) (fn f [(str/concat (object/get @f "code") "|" (object/get @f "path") "|" (object/get @f "message")), @f])))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "contrast", scope: @entity.scope, findings: @entity.findings })
    }

    config {
      codes : ContrastCodes = { contrast: { code: "rasm-contrast", category: "rasm", description: "A Rasm look's text or control edge is below its WCAG 2.2 AA contrast ratio against its backdrop" }, textSize: { code: "rasm-text-size", category: "rasm", description: "A Rasm text look is under 13px" }, translucent: { code: "rasm-contrast-translucent", category: "rasm", description: "A Rasm look is checked against a translucent backdrop, which contrast cannot decide" }, unparsed: { code: "rasm-contrast-unparsed", category: "rasm", description: "A Rasm look names a colour that does not resolve to a hex or rgb colour in its theme" }, themeUnread: { code: "rasm-contrast-theme-unread", category: "rasm", description: "A Rasm style names no readable installed theme, so its palette is unknown" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits."
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CxProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      THEME_PALETTES_HEARD { palettes : Map string CxPalette!  sites : [CxSite]!  unread : [string]! }
        @description "std-orb-lint-input's LINT_THEME_PALETTES: the installed theme palettes of the styles the program's std-rasm-theme traits declare, and the traits that declare them."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbLintInput.LINT_THEME_PALETTES -> THEME_PALETTES_HEARD
    }
  }

  trait OrbLintContrastCli -> OrbLintContrastRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint contrast: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint contrast <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint contrast <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "contrast") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint contrast: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "contrast") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint contrast: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-contrast" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint contrast` with its arguments and working directory."
        @synonyms "orb lint contrast"
      OrbLintContrast.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintContrastCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintContrastOrbitalStart -> OrbLintContrast, OrbLintContrastCli, OrbLintInput, Packs, Versions
}
