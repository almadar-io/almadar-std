    }
    config {
      codes : LintOrbitalRefClosureCodes = { oEntityUnmapped: { code: "ORB_O_ENTITY_UNMAPPED", category: "orbital_ref", description: "A kept trait, relation or page references an out-of-orbital entity that entities {} never maps" }, oEntityUnknownKey: { code: "ORB_O_ENTITY_UNKNOWN_KEY", category: "orbital_ref", description: "An entities key names no entity in the upstream out-of-orbital closure" }, oEntityTargetUnknown: { code: "ORB_O_ENTITY_TARGET_UNKNOWN", category: "orbital_ref", description: "An entities value names no entity the consumer schema declares" }, oFieldRenameUnapplied: { code: "ORB_O_FIELD_RENAME_UNAPPLIED", category: "orbital_ref", description: "A fields rename left the pre-rename field name in a config default position the rewrite does not reach" }, oEntityExpectAmbiguous: { code: "ORB_O_ENTITY_EXPECT_AMBIGUOUS", category: "orbital_ref", description: "An entity an imported orbital expects of a sibling is provided by several sibling imports and no entities entry binds it" }, oRoleUnknownUpstream: { code: "ORB_O_ROLE_UNKNOWN_UPSTREAM", category: "orbital_ref", description: "A roles key names no value in any upstream identity field vocabulary" }, oRoleTargetNotMember: { code: "ORB_O_ROLE_TARGET_NOT_MEMBER", category: "orbital_ref", description: "A roles target is not a member of the consumer roster field vocabulary" }, uConfigUnknownKey: { code: "ORB_U_CONFIG_UNKNOWN_KEY", category: "uses", description: "A uses config override names a knob the imported behavior app-level config never declared" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintOrbitalRefClosureCli -> OrbLintOrbitalRefClosureRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-ref-closure <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-ref-closure <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-ref-closure <file>" }) (emit LINT_CALL_SITES_REQUEST { file: @f, stamp: false, references: true })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-ref-closure") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint orbital-ref-closure: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-ref-closure") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_CALL_SITES_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint orbital-ref-closure: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_CALL_SITES_REQUEST -> external { file : string!  stamp : boolean!  references : boolean! }
        @description "Ask the call sites input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_CALL_SITES_UNREAD -> external { file : string!  error : string! }
        @description "The call sites input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-orbital-ref-closure" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint orbital-ref-closure` with its arguments and working directory."
        @synonyms "orb lint orbital-ref-closure"
      OrbLintOrbitalRefClosure.LINT_FOUND -> LINT_FOUND
      LINT_CALL_SITES_UNREAD { file : string!  error : string! }
        @description "The call sites input could not read or lower the file."
      CallSiteInput.LINT_CALL_SITES_UNREAD -> LINT_CALL_SITES_UNREAD
    }
  }

  trait CallSiteInput = CsInput.traits.CallSiteInput {
    listens {
      OrbLintOrbitalRefClosureCli.LINT_CALL_SITES_REQUEST -> LINT_CALL_SITES_REQUEST
    }
  }

  page boot as OrbLintOrbitalRefClosureOrbitalStart -> OrbLintOrbitalRefClosure, OrbLintOrbitalRefClosureCli, CallSiteInput
}
