app std-orb-lint-orbital-ref-closure [
  version: "1.0.0",
  inbound: ["cli-lint-orbital-ref-closure"],
  fs: { cwd: "**": [read], "/**": [read] },
  description: "std-orb-lint-orbital-ref-closure — the `orb lint orbital-ref-closure <file>` command, the call-site checks of an orbital reference (`orbital X = Alias.orbitals.Y { … }`) and of the `uses` imports that feed it which need the imported file's other orbitals: the port of the matching diagnostics collected in phases/inline/orbital.rs (the out-of-orbital entity closure and the roles remap) and turned into errors by validate_orbital_ref_diagnostics and validate_uses_config_diagnostics. Each orbital reference arrives with its resolved upstream orbital, the other orbitals of the same import (aliasOrbitals) and the traits that survive its omit/only (std-orb-lint-call-site-input); each `uses` import arrives with the app-level config the imported file declares. The lint reports ORB_O_ENTITY_UNMAPPED (a kept trait, relation or page names an out-of-orbital entity that `entities {}` never maps, an entity only auxiliary in the import, never a sibling's primary or an identity roster, is cloned and never demanded), ORB_O_ENTITY_UNKNOWN_KEY, ORB_O_ENTITY_TARGET_UNKNOWN (also for the target of an `entities {}` entry that binds an entity the upstream orbital expects of a sibling), ORB_O_ENTITY_EXPECT_AMBIGUOUS (an entity the import expects of a sibling that several sibling imports provide and no `entities {}` entry binds), ORB_O_ROLE_UNKNOWN_UPSTREAM and ORB_O_ROLE_TARGET_NOT_MEMBER (the consumer roster is the program's own identity entities, or the imported copies when it declares none), ORB_O_FIELD_RENAME_UNAPPLIED (a bare field name a `fields {}` rename left in a config default, outside the key/name/field members the rewrite reaches) and ORB_U_CONFIG_UNKNOWN_KEY, at `<call-site path>.entities(<entity>)`, `.roles(<literal>)`, `.fields(<name>)` and `.uses(<alias>).config(<key>)`; the call-site path is the structured `orbitals[<index>]` the compiler reports its own findings under, and each root that names an entity or a field carries it as the structured `entity` / `field` members std-orb-validate matches the findings it drops on (a role or uses root names neither and drops nothing). Clean answers `lint orbital-ref-closure: clean` (status 200, exit 0); findings status 500, exit 1. Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500. A reference whose import does not resolve is skipped: the compiler reports that failure itself."
]
uses Spec from "almadar-std/lint-orbital-ref-closure"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", entity : string, field : string }
type RcNode = string | number | boolean | [RcNode?] | Map string RcNode?
type RcKnob = { default : RcNode? }
type RcItems = { values : [string] }
type RcRel = { entity : string }
type RcField = { name : string, values : [string], items : RcItems?, relation : RcRel? }
type RcEntity = { name : string, identity : boolean, fields : [RcField] }
type RcListen = { guard : RcNode?, payloadMapping : Map string RcNode? }
type RcTransition = { guard : RcNode?, effects : [RcNode?] }
type RcMachine = { transitions : [RcTransition] }
type RcTrait = { name : string, stateMachine : RcMachine?, ticks : [RcTransition], config : Map string RcKnob, listens : [RcListen], linkedEntity : string, sourceEntityDefinition : RcEntity? }
type RcPage = { path : string, primaryEntity : string }
type RcExpect = { kind : string, name : string, shape : [RcField] }
type RcDecl = { name : string, entity : RcEntity!, auxiliaryEntities : [RcEntity], traits : [RcTrait], pages : [RcPage], expects : [RcExpect] }
type RcCallSite = { ref : string, entities : Map string string, roles : Map string [string], fields : Map string string, config : Map string RcKnob }
type RcOrbRow = { kind : string, path : string, callSite : RcCallSite!, declaration : RcDecl!, aliasOrbitals : [RcDecl]! }
type RcOrbDeclRow = { path : string, declaration : RcDecl! }
type RcUsesCall = { as : string, config : Map string RcKnob }
type RcUsesRow = { kind : string, path : string, callSite : RcUsesCall!, declaration : Map string RcKnob! }
type RcRefObj = { ref : string, entity : string }
type RcEntityRef = string | RcEntity
type RcCOrbital = { name : string, entity : RcEntityRef!, auxiliaryEntities : [RcEntity], expects : [RcExpect], reference : RcRefObj? }
type RcKept = { orbital : number!, traits : [string]! }
type RcRefRow = { kind : string!, path : string!, callSite : RcNode!, declaration : RcNode!, aliasOrbitals : [RcNode] }
type RcProgram = { orbitals : [RcCOrbital]! }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintOrbitalRefClosureCodes = { oEntityUnmapped : LintCodeDecl , oEntityUnknownKey : LintCodeDecl , oEntityTargetUnknown : LintCodeDecl , oFieldRenameUnapplied : LintCodeDecl , oEntityExpectAmbiguous : LintCodeDecl , oRoleUnknownUpstream : LintCodeDecl , oRoleTargetNotMember : LintCodeDecl , uConfigUnknownKey : LintCodeDecl }

