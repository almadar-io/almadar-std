n 2))) (if (and (validate/object @cfg) (object/has @cfg "filter")) (= (tree/fold (object/get @cfg "filter" null) (fn (n k) (if (validate/string @n) (= @n (str/concat (quote "@entity.") @fd)) (if (validate/array @n) (or (and (= (array/len @n) 3) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "object/get") false)) (let ((sq (array/nth @n 1))) (if (validate/string @sq) (= @sq (quote "@entity")) false)) (let ((sq (array/nth @n 2))) (if (validate/string @sq) (= @sq @fd) false))) (array/some @k (fn c (if (validate/boolean @c) @c false)))) (if (validate/object @n) (array/some (object/values @k) (fn c (if (validate/boolean @c) @c false))) false)))) "ScVal") true) false))) (array/some @k (fn c (if (validate/boolean @c) @c false)))) (if (validate/object @n) (array/some (object/values @k) (fn c (if (validate/boolean @c) @c false))) false))) "ScVal") true))) [] [{ code: @config.codes.setColumnWithoutRow.code, path: (str/concat @tp ".stateMachine.transitions[" @i "]"), message: (str/concat "trait " (str/concat "\"" @tn "\"") " sets '@entity." @fd "' on event " (str/concat "\"" @ev "\"") " with no row in scope (no id/row-bearing event payload, no @entity.id bound anywhere in the trait), and never runs persist create/update on " (str/concat "\"" @lk "\"") " anywhere — this write can never land"), suggestion: (str/concat "Run (persist create " @lk " ...) or (persist update " @lk " ...) somewhere in this trait, bind a row (set @entity.id ...) before this transition, or declare '" @fd "' @intrinsic if it is trait-local scratch state"), severity: "error" }])))))))))))))))))))))))) [])))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "set-column", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : ScProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintSetColumnCodes = { setColumnWithoutRow: { code: "ORB_SET_COLUMN_WITHOUT_ROW", category: "entity_mutation", description: "A set writes an entity column with no row in scope and no persist create or update that could land it" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintSetColumnCli -> OrbLintSetColumnRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint set-column <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint set-column <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "set-column") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint set-column: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "set-column") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint set-column: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-set-column" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint set-column` with its arguments and working directory."
        @synonyms "orb lint set-column"
      OrbLintSetColumn.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintSetColumnCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintSetColumnOrbitalStart -> OrbLintSetColumn, OrbLintSetColumnCli, OrbLintInput, Packs, Versions
}
