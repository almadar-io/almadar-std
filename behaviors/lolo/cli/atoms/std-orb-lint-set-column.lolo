app std-orb-lint-set-column [
  version: "1.0.0",
  inbound: ["cli-lint-set-column"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-set-column - the `orb lint set-column <file>` command, the port of ORB_SET_COLUMN_WITHOUT_ROW (entities/entity_mutation.rs). For every inline trait linked to a persistent entity (persistence unset or persistent) that never runs `persist create|upsert|update` of that entity (a `[shared]` entity also counts a sibling trait of the orbital that does, and `persist batch` list builders are followed) and binds no row with `(set @entity.id …)` anywhere, a transition is reported for each `(set @entity.<field> …)` it runs when its event carries no row (no `id` or `row` payload field, no payload field typed @entity, the entity or a list of it, no payload field stamped with the entity) unless the field is `@intrinsic`, a restate-persistor sibling persists the very payload the field is set from, or the field only scopes a read's `filter`. Reported at the transition with the Rust message and suggestion (status 500, exit 1). Clean answers `lint set-column: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-set-column"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type ScVal = string | number | boolean | [ScVal?] | Map string ScVal?
type ScNodes = [ScVal?]
type ScS = string
type ScCall = { path : string!, node : [ScVal?]!, at : number! }
type ScIndex = Map string [ScCall]
type ScPf = { name : string, type : string, entity : string }
type ScEmit = { event : string, payloadSchema : [ScPf] }
type ScEvent = { key : string, payloadSchema : [ScPf] }
type ScSource = { kind : string, trait : string }
type ScListen = { event : string, source : ScSource, triggers : string }
type ScField = { name : string, intrinsic : boolean }
type ScEntity = { name : string, shared : boolean, persistence : string, fields : [ScField] }
type ScTransition = { event : string, guard : ScVal?, effects : [ScVal?] }
type ScTick = { effects : [ScVal?] }
type ScMachine = { events : [ScEvent], transitions : [ScTransition] }
type ScTrait = { name : string, linkedEntity : string, stateMachine : ScMachine, ticks : [ScTick], emits : [ScEmit], listens : [ScListen] }
type ScOrbital = { name : string, entity : ScEntity, auxiliaryEntities : [ScEntity], traits : [ScTrait] }
type ScProgram = { orbitals : [ScOrbital] }
type EmStrs = [string]
type ScRec = { nm : string, lk : string, lands : boolean }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintSetColumnCodes = { setColumnWithoutRow : LintCodeDecl }

