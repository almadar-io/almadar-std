app std-program-host [
  version: "1.0.0",
  inbound: ["cli-host"],
  fs: { cwd: "**/*.lolo": [read], "/**/*.orb": [read] },
  kernel: { "guest": [spawn] },
  description: "std-program-host — the runtime as a .lolo program (`orb host <shell> <program>`). The cli-host command takes argv: the guest program path, then optional `--grant=<kind>` flags (a kind the guestGrants knob holds: fs, exec, net, credentials) that narrow the guestGrants knob to those kinds; with no flag the guest gets the whole knob, and the knob defaults to no grants at all, so the guest never inherits the host's own. It resolves the program (program/read { resolve }, EXEC-LOAD-1) and opens it as a guest session with program/open, passing the grants at open and only there (EXEC-CONC-7); the host holds the grant `kernel: { guest: [spawn] }` and the kernel refuses an open whose grants the host does not hold, naming them. It emits HOST_LOADED { path } once the guest is open, or HOST_REFUSED { reason } when argv names no program, the file cannot be read, resolved or opened, or a flag names a kind the knob does not hold; the command is answered with a status and body (200 loaded, 400 usage or refused grants, 500 unreadable or refused at open). Once loaded, each HOST_EVENT { key, orbital, trait, event, payload } (payload as JSON text) is forwarded to the guest by a keyed program/dispatch { guest } to Orbital.Trait.EVENT, run on the guest's own lane, and each guest answer is relayed as HOST_ANSWERED { key, result }; a failed dispatch is answered under the key it was sent with. With `--route <path>` the host navigates the guest to that route right after it opens, keyed by the route string, and the answer comes back as HOST_ANSWERED. A guest's lazy pages are carried: each `uses lazy` program the resolve answers rides the opened value in `lazyPrograms`, keyed by the `orbRef` of its page, so program/navigate can load it; a HOST_NAVIGATE { key, route } is forwarded to the guest as a keyed program/navigate and answered as HOST_ANSWERED like an event. A second trait, ProgramApps, lets one running orb host many apps loaded on demand. The appsDir knob names a folder holding one subfolder per app, each with its resolved program at <appsDir>/<app>/current/app.orb (current: the release std-deploy-host made active); idleMs (default 600000) closes an app unused that long and idleCheckMs (default 60000) sets how often that is checked (the check runs on a one second tick and acts once idleCheckMs has passed since the last one). APP_REQUEST { key, app, address, payload, options } runs the event address on the app: a loaded app has its lastUsedMs updated and gets a keyed program/dispatch (options merged with its guest and the key); an app not loaded is marked loading, the request is queued, its file is read with program/read and opened with program/open with no grants, and every queued request for it is replayed when it opens; a request for an app that is loading is only queued. APP_GUEST { key, app } answers APP_GUEST_ANSWERED { key, guest } with the app guest handle, loading the app first the same way (queued while it loads, APP_FAILED { key, error } when the load fails). Each answer is emitted as APP_ANSWERED { key, result } or APP_FAILED { key, error }; an empty app name or appsDir, an unreadable or refused file, or a failed dispatch answers APP_FAILED, and a failed load answers every queued request of that app and forgets the app. APP_UNLOAD { app } closes the app guest, forgets it and emits APP_UNLOADED { app }; the idle tick does the same for each loaded app unused longer than idleMs. The loaded apps are the apps field of the AppHost entity (name, guest, lastUsedMs, loading) and the waiting requests its waiting field."
]
uses Spec from "almadar-std/program-host"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type HostOpened = { guest : string! }
type HostLazyPage = { orbital : string!, orbRef : string! }
type HostLazy = { orbital : string!, program : SExpr! }
type HostProgram = { name : string, orbitals : [orbital], lazyPages : [HostLazyPage]?, lazyPrograms : (Map string SExpr)? }
type HostResolved = { program : HostProgram!, lazy : [HostLazy] }
type HostFsGrant = { glob : string!, modes : [string]! }
type HostNetGrant = { target : string!, kinds : [string]! }
type AppValue = string | number | boolean | [AppValue?] | Map string AppValue?
type AppLoaded = { name : string!, guest : string!, lastUsedMs : instant!, loading : boolean! }
type AppWaiting = { key : string!, app : string!, address : string!, payload : AppValue, options : Map string AppValue, guestOnly : boolean }
type HostGrants = { fs : [HostFsGrant]?, exec : [string]?, net : [HostNetGrant]?, credentials : [string]? }

orbital ProgramHostOrbital {
  uses Args from "std/behaviors/std-args"

  entity GuestProgram [runtime] {
    id : string!
    path : string! = ""
    file : string! = ""
    cwd : string! = ""
    guest : string! = ""
    loaded : boolean! = false
    grants : HostGrants = {}
    route : string! = ""
  }

  entity AppHost [runtime] {
    id : string!
    apps : [AppLoaded]! = []
    waiting : [AppWaiting]! = []
    lastSweepMs : instant! = 0
    answeringKey : string! = ""
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      ProgramHost.HOST_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait ProgramHost -> GuestProgram [optimistic] {
    initial: waiting

    state waiting {
      INIT -> waiting
      HOST_CALLED -> waiting when (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (emit HOST_COMMAND_ANSWERED { status: 500, body: "Error: orb host: the command arguments could not be read" })
      HOST_CALLED -> parsing when (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (set @entity.cwd (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [], cwd: "" }) "cwd"))
        (emit HOST_ARGS_PARSE { stage: "host" argv: (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [] }) "argv") flags: [{ name: "grant" aliases: [] takesValue: true repeatable: true }, { name: "route" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      HOST_ARGS_DONE -> waiting when (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0))
        (emit HOST_REFUSED { reason: "usage: orb host <shell> <program.lolo> [--grant=<kind>] [--route=<path>]" })
        (emit HOST_COMMAND_ANSWERED { status: 400, body: "usage: orb host <shell> <program.lolo> [--grant=<kind>] [--route=<path>]" })
      HOST_ARGS_DONE -> waiting when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (> (array/len (array/filter (default (object/get @payload.flags "grant") []) (fn k (not (object/has @config.guestGrants @k))))) 0))
        (emit HOST_REFUSED { reason: "a grant flag names a kind the guestGrants knob does not hold" })
        (emit HOST_COMMAND_ANSWERED { status: 400, body: "host: a grant flag names a kind the guestGrants knob does not hold" })
      HOST_ARGS_DONE -> reading when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (= (array/len (array/filter (default (object/get @payload.flags "grant") []) (fn k (not (object/has @config.guestGrants @k))))) 0))
        (set @entity.path (default (array/first @payload.positionals) ""))
        (set @entity.route (default (array/first (default (object/get @payload.flags "route") [])) ""))
        (set @entity.grants (let ((sel (default (object/get @payload.flags "grant") []))) { fs: (if (or (= (array/len @sel) 0) (array/includes @sel "fs")) (default (object/get @config.guestGrants "fs") []) []) exec: (if (or (= (array/len @sel) 0) (array/includes @sel "exec")) (default (object/get @config.guestGrants "exec") []) []) net: (if (or (= (array/len @sel) 0) (array/includes @sel "net")) (default (object/get @config.guestGrants "net") []) []) credentials: (if (or (= (array/len @sel) 0) (array/includes @sel "credentials")) (default (object/get @config.guestGrants "credentials") []) []) }))
        (set @entity.file (if (os/path-is-absolute (default (array/first @payload.positionals) "")) (array/first @payload.positionals) (str/concat @entity.cwd "/" (array/first @payload.positionals))))
        (program/read "" { resolve: true text: false path: @entity.file } { key: "program" emit: { success: HOST_PROGRAM_READ, failure: HOST_LOAD_FAILED } })
    }

    state reading {
      INIT -> reading
      HOST_PROGRAM_READ -> reading
        (program/open (if (= (array/len (default @payload.result.lazy [])) 0) @payload.result.program (object/set @payload.result.program "lazyPrograms" (object/fromEntries (array/map (default @payload.result.lazy []) (fn l [(object/get (default (array/find (default @payload.result.program.lazyPages []) (fn p (= @p.orbital @l.orbital))) { orbital: "", orbRef: "" }) "orbRef") @l.program]))))) { grants: @entity.grants } { key: "guest" emit: { success: HOST_GUEST_OPENED, failure: HOST_LOAD_FAILED } })
      HOST_GUEST_OPENED -> hosting when (= @entity.route "")
        (set @entity.guest @payload.result.guest)
        (set @entity.loaded true)
        (emit HOST_LOADED { path: @entity.path })
        (emit HOST_COMMAND_ANSWERED { status: 200, body: (str/concat "hosting " @entity.path) })
      HOST_GUEST_OPENED -> hosting when (!= @entity.route "")
        (set @entity.guest @payload.result.guest)
        (set @entity.loaded true)
        (emit HOST_LOADED { path: @entity.path })
        (emit HOST_COMMAND_ANSWERED { status: 200, body: (str/concat "hosting " @entity.path) })
        (program/navigate { guest: @payload.result.guest route: @entity.route key: @entity.route emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_LOAD_FAILED -> waiting
        (emit HOST_REFUSED { reason: @payload.error })
        (emit HOST_COMMAND_ANSWERED { status: 500, body: (str/concat "host: " (default @payload.error "")) })
    }

    state hosting {
      INIT -> hosting
      HOST_EVENT -> hosting
        (program/dispatch (str/concat @payload.orbital "." @payload.trait "." @payload.event) @payload.payload { guest: @entity.guest key: @payload.key emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_NAVIGATE -> hosting
        (program/navigate { guest: @entity.guest route: @payload.route key: @payload.key emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_GUEST_ANSWERED -> hosting
        (emit HOST_ANSWERED { key: @payload.key, result: (json/stringify @payload.result) })
      HOST_GUEST_FAILED -> hosting
        (emit HOST_ANSWERED { key: (default @payload.key ""), result: (json/stringify { ok: false, error: @payload.error }) })
    }

    emits {
      HOST_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the --grant flag."
        @tier "internal"
      HOST_COMMAND_ANSWERED -> internal { status : number!  body : string! }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      HOST_LOADED -> external { path : string! }
        @description "The guest program was read and parsed."
      HOST_REFUSED -> external { reason : string! }
        @description "The command or the guest program was refused."
      HOST_ANSWERED -> external { key : string!  result : string! }
        @description "A guest's answer to a forwarded event."
      HOST_PROGRAM_READ { result : HostResolved! }
        @description "The guest program resolved."
        @tier "internal"
      HOST_GUEST_OPENED { result : HostOpened! }
        @description "The guest session opened; its handle keys every dispatch."
        @tier "internal"
      HOST_LOAD_FAILED { error : string }
        @description "A read, resolve or open that failed."
        @tier "internal"
      HOST_GUEST_ANSWERED { key : string, result : string }
        @description "The keyed dispatch completed."
        @tier "internal"
      HOST_GUEST_FAILED { key : string, error : string }
        @description "The keyed dispatch failed."
        @tier "internal"
    }

    listens {
      HOST_CALLED -> inbound "cli-host" answers HOST_COMMAND_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb host` with its arguments and working directory."
        @synonyms "orb host, runtime host, host a program"
      HOST_EVENT { key : string!, orbital : string!, trait : string!, event : string!, payload : string }
        @description "An external event for the guest program."
      HOST_NAVIGATE { key : string!, route : string! }
        @description "Route the guest to a page: the kernel loads the page's program when it is lazy and mounts its traits, and the answer comes back as HOST_ANSWERED under the key."
      HOST_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> HOST_ARGS_DONE
    }

    config {
      guestGrants : HostGrants = {}
        @label "Guest grants"
        @description "The os grants the guest is opened with, by kind (fs, exec, net, credentials) in the form a program declares them; the guest gets nothing else, and the host must hold every one (the kernel refuses an open it does not cover). The default is no grants."
        @synonyms "guest permissions, sandbox grants"
        @tier "domain"
    }
  }

  trait ProgramApps -> AppHost [optimistic] {
    initial: serving

    state serving {
      INIT -> serving
      APP_REQUEST -> serving when (or (= @payload.app "") (= @config.appsDir ""))
        (emit APP_FAILED { key: @payload.key, error: "no app or appsDir named for the request" })
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) (not @a.loading)))))
        (let ((a (array/find @entity.apps (fn x (= @x.name @payload.app)))))
          (do
            (set @entity.apps (array/map @entity.apps (fn x (if (= @x.name @payload.app) (object/set @x "lastUsedMs" (time/now)) @x))))
            (set @entity.answeringKey @payload.key)
            (program/dispatch @payload.address @payload.payload (object/merge (default @payload.options {}) { guest: @a.guest emit: { success: APP_ANSWERED_IN, failure: APP_FAILED_IN } }))))
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) @a.loading))))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: @payload.address payload: @payload.payload options: (default @payload.options {}) }))
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (not (array/some @entity.apps (fn a (= @a.name @payload.app)))))
        (set @entity.apps (array/append @entity.apps { name: @payload.app guest: "" lastUsedMs: (time/now) loading: true }))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: @payload.address payload: @payload.payload options: (default @payload.options {}) }))
        (program/read "" { resolve: true text: false path: (str/concat @config.appsDir "/" @payload.app "/current/app.orb") } { key: @payload.app emit: { success: APP_PROGRAM_READ, failure: APP_LOAD_FAILED } })
      APP_GUEST -> serving when (or (= @payload.app "") (= @config.appsDir ""))
        (emit APP_FAILED { key: @payload.key, error: "no app or appsDir named for the request" })
      APP_GUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) (not @a.loading)))))
        (let ((a (array/find @entity.apps (fn x (= @x.name @payload.app)))))
          (do
            (set @entity.apps (array/map @entity.apps (fn x (if (= @x.name @payload.app) (object/set @x "lastUsedMs" (time/now)) @x))))
            (emit APP_GUEST_ANSWERED { key: @payload.key, guest: @a.guest })))
      APP_GUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) @a.loading))))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: "" payload: {} options: {} guestOnly: true }))
      APP_GUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (not (array/some @entity.apps (fn a (= @a.name @payload.app)))))
        (set @entity.apps (array/append @entity.apps { name: @payload.app guest: "" lastUsedMs: (time/now) loading: true }))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: "" payload: {} options: {} guestOnly: true }))
        (program/read "" { resolve: true text: false path: (str/concat @config.appsDir "/" @payload.app "/current/app.orb") } { key: @payload.app emit: { success: APP_PROGRAM_READ, failure: APP_LOAD_FAILED } })
      APP_PROGRAM_READ -> serving
        (program/open (if (= (array/len (default @payload.result.lazy [])) 0) @payload.result.program (object/set @payload.result.program "lazyPrograms" (object/fromEntries (array/map (default @payload.result.lazy []) (fn l [(object/get (default (array/find (default @payload.result.program.lazyPages []) (fn p (= @p.orbital @l.orbital))) { orbital: "", orbRef: "" }) "orbRef") @l.program]))))) { split: true, declared: true } { key: @payload.key emit: { success: APP_OPENED, failure: APP_LOAD_FAILED } })
      APP_OPENED -> serving
        (set @entity.apps (array/map @entity.apps (fn x (if (= @x.name @payload.key) { name: @x.name guest: @payload.result.guest lastUsedMs: (time/now) loading: false } @x))))
        (emit APP_DRAIN { app: @payload.key, guest: @payload.result.guest })
      APP_DRAIN -> serving when (and (array/some @entity.waiting (fn w (= @w.app @payload.app))) (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "guestOnly") false))
        (let ((w (default (array/find @entity.waiting (fn x (= @x.app @payload.app))) { key: "" app: "" address: "" payload: "" options: {} })))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (emit APP_DRAIN { app: @payload.app, guest: @payload.guest })
            (emit APP_GUEST_ANSWERED { key: @w.key, guest: @payload.guest })))
      APP_DRAIN -> serving when (and (array/some @entity.waiting (fn w (= @w.app @payload.app))) (not (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "guestOnly") false)))
        (let ((w (default (array/find @entity.waiting (fn x (= @x.app @payload.app))) { key: "" app: "" address: "" payload: "" options: {} })))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (set @entity.answeringKey @w.key)
            (program/dispatch @w.address @w.payload (object/merge (default @w.options {}) { guest: @payload.guest emit: { success: APP_ANSWERED_IN, failure: APP_FAILED_IN } }))
            (emit APP_DRAIN { app: @payload.app, guest: @payload.guest })))
      APP_LOAD_FAILED -> serving
        (set @entity.apps (array/filter @entity.apps (fn x (!= @x.name @payload.key))))
        (emit APP_FAIL_DRAIN { app: @payload.key, error: (default @payload.error "") })
      APP_FAIL_DRAIN -> serving when (array/some @entity.waiting (fn w (= @w.app @payload.app)))
        (let ((w (array/find @entity.waiting (fn x (= @x.app @payload.app)))))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (emit APP_FAILED { key: @w.key, error: @payload.error })
            (emit APP_FAIL_DRAIN { app: @payload.app, error: @payload.error })))
      APP_ANSWERED_IN -> serving
        (emit APP_ANSWERED { key: @entity.answeringKey, result: @payload.result })
      APP_FAILED_IN -> serving
        (emit APP_FAILED { key: @entity.answeringKey, error: (default @payload.error "") })
      APP_UNLOAD -> serving when (array/some @entity.apps (fn a (and (= @a.name @payload.app) (not @a.loading))))
        (let ((a (array/find @entity.apps (fn x (= @x.name @payload.app)))))
          (do
            (set @entity.apps (array/filter @entity.apps (fn x (!= @x.name @payload.app))))
            (emit APP_UNLOADED { app: @payload.app })
            (program/close @a.guest)))
      APP_IDLE_SWEEP -> serving when (array/some @entity.apps (fn a (and (not @a.loading) (> (time/diff (time/now) @a.lastUsedMs "ms") @config.idleMs))))
        (let ((a (array/find @entity.apps (fn x (and (not @x.loading) (> (time/diff (time/now) @x.lastUsedMs "ms") @config.idleMs))))))
          (do
            (set @entity.apps (array/filter @entity.apps (fn x (!= @x.name @a.name))))
            (emit APP_UNLOADED { app: @a.name })
            (emit APP_IDLE_SWEEP { swept: (+ @payload.swept 1) })
            (program/close @a.guest)))
    }

    ticks {
      idleCheck every 1s when (>= (time/diff (time/now) @entity.lastSweepMs "ms") @config.idleCheckMs)
        (set @entity.lastSweepMs (time/now))
        (emit APP_IDLE_SWEEP { swept: 0 })
    }

    emits {
      APP_ANSWERED -> external { key : string!  result : AppValue }
        @description "A hosted app's answer to an APP_REQUEST, under the request's key."
      APP_GUEST_ANSWERED -> external { key : string!  guest : string! }
        @description "The guest handle of a hosted app, answering an APP_GUEST under its key."
      APP_FAILED -> external { key : string!  error : string! }
        @description "An APP_REQUEST that could not be answered: no app named, the app's file unreadable or refused at open, or the dispatch failed."
      APP_UNLOADED -> external { app : string! }
        @description "A hosted app was closed: by APP_UNLOAD or because it sat unused past idleMs."
      APP_PROGRAM_READ { result : HostResolved!, key : string }
        @description "An app's program resolved."
        @tier "internal"
      APP_OPENED { result : HostOpened!, key : string }
        @description "An app's guest session opened."
        @tier "internal"
      APP_LOAD_FAILED { error : string, key : string }
        @description "An app's read, resolve or open failed."
        @tier "internal"
      APP_DRAIN { app : string!, guest : string! }
        @description "Replay the next request queued for an app that just opened."
        @tier "internal"
      APP_FAIL_DRAIN { app : string!, error : string! }
        @description "Answer the next request queued for an app that failed to load."
        @tier "internal"
      APP_ANSWERED_IN { key : string!, result : AppValue }
        @description "The keyed dispatch to an app completed."
        @tier "internal"
      APP_FAILED_IN { key : string, error : string }
        @description "The keyed dispatch to an app failed."
        @tier "internal"
      APP_IDLE_SWEEP { swept : number! }
        @description "Close the next app unused past idleMs."
        @tier "internal"
    }

    listens {
      APP_REQUEST { key : string!, app : string!, address : string!, payload : AppValue, options : Map string AppValue }
        @description "Run an event on a hosted app, loading the app from appsDir when it is not open."
      APP_GUEST { key : string!, app : string! }
        @description "Ask for the guest handle of a hosted app, loading the app from appsDir when it is not open; answered as APP_GUEST_ANSWERED, or APP_FAILED under the key."
      APP_UNLOAD { app : string! }
        @description "Close a hosted app and forget it."
    }

    config {
      appsDir : string = ""
        @label "Apps folder"
        @description "The folder holding one subfolder per app, each with its resolved program at <appsDir>/<app>/current/app.orb (current: the release std-deploy-host made active)."
        @tier "domain"
      idleMs : number = 600000
        @label "Idle limit"
        @description "Close a hosted app unused for this many milliseconds."
        @tier "domain"
      idleCheckMs : number = 60000
        @label "Idle check interval"
        @description "How often, in milliseconds, hosted apps are checked for idleness."
        @tier "domain"
    }
  }

  page boot as ProgramHostOrbitalStart -> ProgramHost, ArgsCli, ProgramApps
}
