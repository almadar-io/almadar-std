app std-program-host [
  version: "1.0.0",
  inbound: ["cli-host"],
  fs: { cwd: "**/*.lolo": [read], "/**/*.orb": [read], "/**/app.env": [read], "/srv/orb/apps/**": [read] },
  kernel: { "guest": [spawn] },
  description: "std-program-host — the runtime as a .lolo program (`orb host <shell> <program>`). The cli-host command takes argv: the guest program path, then optional `--grant=<kind>` flags (a kind the guestGrants knob holds: fs, exec, net, credentials) that narrow the guestGrants knob to those kinds; with no flag the guest gets the whole knob, and the knob defaults to no grants at all, so the guest never inherits the host's own. It resolves the program (program/read { resolve }, EXEC-LOAD-1) and opens it as a guest session with program/open, passing the grants at open and only there (EXEC-CONC-7); the host holds the grant `kernel: { guest: [spawn] }` and the kernel refuses an open whose grants the host does not hold, naming them. It emits HOST_LOADED { path } once the guest is open, or HOST_REFUSED { reason } when argv names no program, the file cannot be read, resolved or opened, or a flag names a kind the knob does not hold; the command is answered with a status and body (200 loaded, 400 usage or refused grants, 500 unreadable or refused at open). Once loaded, each HOST_EVENT { key, orbital, trait, event, payload } (payload as JSON text) is forwarded to the guest by a keyed program/dispatch { guest } to Orbital.Trait.EVENT, run on the guest's own lane, and each guest answer is relayed as HOST_ANSWERED { key, result }; a failed dispatch is answered under the key it was sent with. With `--route <path>` the host navigates the guest to that route right after it opens, keyed by the route string, and the answer comes back as HOST_ANSWERED. A guest's lazy pages are carried: each `uses lazy` program the resolve answers rides the opened value in `lazyPrograms`, keyed by the `orbRef` of its page, so program/navigate can load it; a HOST_NAVIGATE { key, route } is forwarded to the guest as a keyed program/navigate and answered as HOST_ANSWERED like an event. A second trait, ProgramApps, lets one running orb host many apps loaded on demand. The appsDir knob names a folder holding one subfolder per app, each with its resolved program at <appsDir>/<app>/current/app.orb (current: the release std-deploy-host made active); idleMs (default 600000) closes an app unused that long and idleCheckMs (default 60000) sets how often that is checked (the check runs on a one second tick and acts once idleCheckMs has passed since the last one). APP_REQUEST { key, app, address, payload, options } runs the event address on the app (an app is opened with program/open { log: { app, release } }, so every log line of its guest work carries its name and release, and with the env its <appsDir>/<app>/current/app.env lists, and with the opener's program port when its own declared grants ask for it (kernel: { guest: [program] }), one NAME=value per line, blank lines and # comments skipped, values taken literally, no file meaning no env of its own; any other read failure fails the load) (an address that is an inbound record { inbound, body, headers } delivers that hook to the app instead, answered with its handler's { status, body }): a loaded app has its lastUsedMs updated and gets a keyed program/dispatch (options merged with its guest and the key); an app not loaded is marked loading, the request is queued, its file is read with program/read and opened with program/open with no grants, and every queued request for it is replayed when it opens; a request for an app that is loading is only queued. APP_GUEST { key, app } answers APP_GUEST_ANSWERED { key, guest } with the app guest handle, loading the app first the same way (queued while it loads, APP_FAILED { key, error } when the load fails). Each answer is emitted as APP_ANSWERED { key, result } or APP_FAILED { key, error }; an empty app name or appsDir, an unreadable or refused file, or a failed dispatch answers APP_FAILED, and a failed load answers every queued request of that app and forgets the app. APP_UNLOAD { app } closes the app guest, forgets it and emits APP_UNLOADED { app }; the idle tick does the same for each loaded app unused longer than idleMs, and the release check does it for a loaded app whose current no longer exists (readlink answers not-found: the app folder was removed). APPS_LIST { key } answers APPS_LISTED { key, apps } with every guest held (name, guest, release, current, loading, lastUsedMs). The loaded apps are the apps field of the AppHost entity (name, guest, lastUsedMs, loading) and the waiting requests its waiting field."
]
uses Spec from "almadar-std/program-host"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type HostOpened = { guest : string! }
type AppDispatchError = { code : string?, status : number?, kind : string?, message : string? }
type AppHostCode = { code : string!, category : string!, description : string! }
type AppHostCodes = { sessionEnded : AppHostCode! }
type HostLazyPage = { orbital : string!, orbRef : string! }
type HostLazy = { orbital : string!, program : SExpr! }
type HostKernelGrant = { target : string!, kinds : [string]! }
type HostProgramGrants = { kernel : [HostKernelGrant]? }
type HostProgram = { name : string, orbitals : [orbital], lazyPages : [HostLazyPage]?, lazyPrograms : (Map string SExpr)?, osGrants : HostProgramGrants? }
type HostResolved = { program : HostProgram!, lazy : [HostLazy] }
type HostFsGrant = { glob : string!, modes : [string]! }
type HostNetGrant = { target : string!, kinds : [string]! }
type AppValue = string | number | boolean | [AppValue?] | Map string AppValue?
type AppLoaded = { name : string!, guest : string!, lastUsedMs : instant!, loading : boolean!, env : (Map string string)?, release : string?, current : boolean?, retiredMs : instant? }
type AppListed = { name : string!, guest : string!, release : string!, current : boolean!, loading : boolean!, lastUsedMs : instant! }
type AppPin = { clientId : string!, app : string!, guest : string! }
type AppHook = { inbound : string!, body : string!, headers : Map string string }
type AppAddress = string | AppHook
type AppWaiting = { key : string!, app : string!, address : AppAddress!, payload : AppValue, options : Map string AppValue, guestOnly : boolean, clientId : string, mounting : boolean }
type HostGrants = { fs : [HostFsGrant]?, exec : [string]?, net : [HostNetGrant]?, credentials : [string]? }

orbital ProgramHostOrbital {
  uses Args from "std/behaviors/std-args"

  entity GuestProgram [runtime] {
    id : string!
    path : string! = ""
    file : string! = ""
    cwd : string! = ""
    guest : string! = ""
    loaded : boolean! = false
    grants : HostGrants = {}
    route : string! = ""
  }

  entity AppHost [runtime] {
    id : string!
    apps : [AppLoaded]! = []
    waiting : [AppWaiting]! = []
    pins : [AppPin]! = []
    lastSweepMs : instant! = "1970-01-01T00:00:00Z"
    lastReleaseCheckMs : instant! = "1970-01-01T00:00:00Z"
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      ProgramHost.HOST_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait ProgramHost -> GuestProgram [optimistic] {
    initial: waiting

    state waiting {
      INIT -> waiting
      HOST_CALLED -> waiting when (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (emit HOST_COMMAND_ANSWERED { status: 500, body: "Error: orb host: the command arguments could not be read" })
      HOST_CALLED -> parsing when (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (set @entity.cwd (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [], cwd: "" }) "cwd"))
        (emit HOST_ARGS_PARSE { stage: "host" argv: (object/get (default (json/parse (default @payload.rawBody "") OrbCommandArgs) { argv: [] }) "argv") flags: [{ name: "grant" aliases: [] takesValue: true repeatable: true }, { name: "route" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      HOST_ARGS_DONE -> waiting when (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0))
        (emit HOST_REFUSED { reason: "usage: orb host <shell> <program.lolo> [--grant=<kind>] [--route=<path>]" })
        (emit HOST_COMMAND_ANSWERED { status: 400, body: "usage: orb host <shell> <program.lolo> [--grant=<kind>] [--route=<path>]" })
      HOST_ARGS_DONE -> waiting when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (> (array/len (array/filter (default (object/get @payload.flags "grant") []) (fn k (not (object/has @config.guestGrants @k))))) 0))
        (emit HOST_REFUSED { reason: "a grant flag names a kind the guestGrants knob does not hold" })
        (emit HOST_COMMAND_ANSWERED { status: 400, body: "host: a grant flag names a kind the guestGrants knob does not hold" })
      HOST_ARGS_DONE -> reading when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (= (array/len (array/filter (default (object/get @payload.flags "grant") []) (fn k (not (object/has @config.guestGrants @k))))) 0))
        (set @entity.path (default (array/first @payload.positionals) ""))
        (set @entity.route (default (array/first (default (object/get @payload.flags "route") [])) ""))
        (set @entity.grants (let ((sel (default (object/get @payload.flags "grant") []))) { fs: (if (or (= (array/len @sel) 0) (array/includes @sel "fs")) (default (object/get @config.guestGrants "fs") []) []) exec: (if (or (= (array/len @sel) 0) (array/includes @sel "exec")) (default (object/get @config.guestGrants "exec") []) []) net: (if (or (= (array/len @sel) 0) (array/includes @sel "net")) (default (object/get @config.guestGrants "net") []) []) credentials: (if (or (= (array/len @sel) 0) (array/includes @sel "credentials")) (default (object/get @config.guestGrants "credentials") []) []) }))
        (set @entity.file (if (os/path-is-absolute (default (array/first @payload.positionals) "")) (array/first @payload.positionals) (str/concat @entity.cwd "/" (array/first @payload.positionals))))
        (program/read "" { resolve: true text: false path: @entity.file } { key: "program" emit: { success: HOST_PROGRAM_READ, failure: HOST_LOAD_FAILED } })
    }

    state reading {
      INIT -> reading
      HOST_PROGRAM_READ -> reading
        (program/open (if (= (array/len (default @payload.result.lazy [])) 0) @payload.result.program (object/set @payload.result.program "lazyPrograms" (object/fromEntries (array/map (default @payload.result.lazy []) (fn l [(object/get (default (array/find (default @payload.result.program.lazyPages []) (fn p (= @p.orbital @l.orbital))) { orbital: "", orbRef: "" }) "orbRef") @l.program]))))) { grants: @entity.grants } { key: "guest" emit: { success: HOST_GUEST_OPENED, failure: HOST_LOAD_FAILED } })
      HOST_GUEST_OPENED -> hosting when (= @entity.route "")
        (set @entity.guest @payload.result.guest)
        (set @entity.loaded true)
        (emit HOST_LOADED { path: @entity.path })
        (emit HOST_COMMAND_ANSWERED { status: 200, body: (str/concat "hosting " @entity.path) })
      HOST_GUEST_OPENED -> hosting when (!= @entity.route "")
        (set @entity.guest @payload.result.guest)
        (set @entity.loaded true)
        (emit HOST_LOADED { path: @entity.path })
        (emit HOST_COMMAND_ANSWERED { status: 200, body: (str/concat "hosting " @entity.path) })
        (program/navigate { guest: @payload.result.guest route: @entity.route key: @entity.route emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_LOAD_FAILED -> waiting
        (emit HOST_REFUSED { reason: @payload.error })
        (emit HOST_COMMAND_ANSWERED { status: 500, body: (str/concat "host: " (default @payload.error "")) })
    }

    state hosting {
      INIT -> hosting
      HOST_EVENT -> hosting
        (program/dispatch (str/concat @payload.orbital "." @payload.trait "." @payload.event) @payload.payload { guest: @entity.guest key: @payload.key emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_NAVIGATE -> hosting
        (program/navigate { guest: @entity.guest route: @payload.route key: @payload.key emit: { success: HOST_GUEST_ANSWERED, failure: HOST_GUEST_FAILED } })
      HOST_GUEST_ANSWERED -> hosting
        (emit HOST_ANSWERED { key: @payload.key, result: (json/stringify @payload.result) })
      HOST_GUEST_FAILED -> hosting
        (emit HOST_ANSWERED { key: (default @payload.key ""), result: (json/stringify { ok: false, error: @payload.error }) })
    }

    emits {
      HOST_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the --grant flag."
        @tier "internal"
      HOST_COMMAND_ANSWERED -> internal { status : number!  body : string! }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      HOST_LOADED -> external { path : string! }
        @description "The guest program was read and parsed."
      HOST_REFUSED -> external { reason : string! }
        @description "The command or the guest program was refused."
      HOST_ANSWERED -> external { key : string!  result : string! }
        @description "A guest's answer to a forwarded event."
      HOST_PROGRAM_READ { result : HostResolved! }
        @description "The guest program resolved."
        @tier "internal"
      HOST_GUEST_OPENED { result : HostOpened! }
        @description "The guest session opened; its handle keys every dispatch."
        @tier "internal"
      HOST_LOAD_FAILED { error : string }
        @description "A read, resolve or open that failed."
        @tier "internal"
      HOST_GUEST_ANSWERED { key : string, result : AppValue }
        @description "The keyed dispatch completed."
        @tier "internal"
      HOST_GUEST_FAILED { key : string, error : string }
        @description "The keyed dispatch failed."
        @tier "internal"
    }

    listens {
      HOST_CALLED -> inbound "cli-host" answers HOST_COMMAND_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb host` with its arguments and working directory."
        @synonyms "orb host, runtime host, host a program"
      HOST_EVENT { key : string!, orbital : string!, trait : string!, event : string!, payload : string }
        @description "An external event for the guest program."
      HOST_NAVIGATE { key : string!, route : string! }
        @description "Route the guest to a page: the kernel loads the page's program when it is lazy and mounts its traits, and the answer comes back as HOST_ANSWERED under the key."
      HOST_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> HOST_ARGS_DONE
    }

    config {
      guestGrants : HostGrants = {}
        @label "Guest grants"
        @description "The os grants the guest is opened with, by kind (fs, exec, net, credentials) in the form a program declares them; the guest gets nothing else, and the host must hold every one (the kernel refuses an open it does not cover). The default is no grants."
        @synonyms "guest permissions, sandbox grants"
        @tier "domain"
    }
  }

  trait ProgramApps -> AppHost [optimistic] {
    initial: serving

    state serving {
      INIT -> serving when (= (array/len @config.resident) 0)
      INIT -> serving when (> (array/len @config.resident) 0)
        (emit APP_RESIDENT_LOAD { index: 0 })
      APP_RESIDENT_LOAD -> serving when (and (< @payload.index (array/len @config.resident)) (!= @config.appsDir "") (not (array/some @entity.apps (fn a (= @a.name (default (array/nth @config.resident @payload.index) ""))))))
        (set @entity.apps (array/append @entity.apps { name: (default (array/nth @config.resident @payload.index) "") guest: "" lastUsedMs: (time/now) loading: true current: true release: "" }))
        (os/readlink (str/concat @config.appsDir "/" (default (array/nth @config.resident @payload.index) "") "/current") { key: (default (array/nth @config.resident @payload.index) "") emit: { success: APP_LINK_READ, failure: APP_LINK_UNREAD } })
        (emit APP_RESIDENT_LOAD { index: (+ @payload.index 1) })
      APP_RESIDENT_LOAD -> serving when (and (< @payload.index (array/len @config.resident)) (or (= @config.appsDir "") (array/some @entity.apps (fn a (= @a.name (default (array/nth @config.resident @payload.index) ""))))))
        (emit APP_RESIDENT_LOAD { index: (+ @payload.index 1) })
      APP_RESIDENT_LOAD -> serving when (>= @payload.index (array/len @config.resident))

      APP_REQUEST -> serving when (or (= @payload.app "") (= @config.appsDir ""))
        (emit APP_FAILED { key: @payload.key, error: "no app or appsDir named for the request" })
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading)))) (and (!= (default @payload.clientId "") "") (not (default @payload.mounting false)) (not (array/some @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId (default @payload.clientId ""))))))))
        (let ((cur (array/find @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading))))))
          (do
            (set @entity.pins (array/append @entity.pins { clientId: (default @payload.clientId "") app: @payload.app guest: @cur.guest }))
            (emit APP_FAILED { key: @payload.key, error: "session ended: mount again with the frames the client holds", status: 409, code: @config.codes.sessionEnded.code })))
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading)))) (not (and (!= (default @payload.clientId "") "") (not (default @payload.mounting false)) (not (array/some @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId (default @payload.clientId "")))))))))
        (let ((cid (default @payload.clientId "")))
          (let ((pin (array/find @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId @cid) (!= @cid ""))))) (cur (array/find @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading))))))
            (let ((g (if (and (!= @pin null) (array/some @entity.apps (fn a (and (= @a.guest @pin.guest) (not @a.loading))))) @pin.guest @cur.guest)))
              (do
                (set @entity.apps (array/map @entity.apps (fn x (if (= @x.guest @g) (object/set @x "lastUsedMs" (time/now)) @x))))
                (when (and (!= @cid "") (= @pin null))
                  (set @entity.pins (array/append @entity.pins { clientId: @cid app: @payload.app guest: @g })))
                (program/dispatch @payload.address @payload.payload (object/merge (default @payload.options {}) { guest: @g }) { key: @payload.key emit: { success: APP_ANSWERED_IN, failure: APP_FAILED_IN } })))))
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (not (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading))))) (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) @a.loading))))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: @payload.address payload: @payload.payload options: (default @payload.options {}) clientId: (default @payload.clientId "") mounting: (default @payload.mounting false) }))
      APP_REQUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (not (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true))))))
        (set @entity.apps (array/append @entity.apps { name: @payload.app guest: "" lastUsedMs: (time/now) loading: true current: true release: "" }))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: @payload.address payload: @payload.payload options: (default @payload.options {}) clientId: (default @payload.clientId "") mounting: (default @payload.mounting false) }))
        (os/readlink (str/concat @config.appsDir "/" @payload.app "/current") { key: @payload.app emit: { success: APP_LINK_READ, failure: APP_LINK_UNREAD } })
      APP_GUEST -> serving when (or (= @payload.app "") (= @config.appsDir ""))
        (emit APP_FAILED { key: @payload.key, error: "no app or appsDir named for the request" })
      APP_GUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading)))))
        (let ((cid (default @payload.clientId "")))
          (let ((pin (array/find @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId @cid) (!= @cid ""))))) (cur (array/find @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading))))))
            (let ((g (if (and (!= @pin null) (array/some @entity.apps (fn a (and (= @a.guest @pin.guest) (not @a.loading))))) @pin.guest @cur.guest)))
              (do
                (set @entity.apps (array/map @entity.apps (fn x (if (= @x.guest @g) (object/set @x "lastUsedMs" (time/now)) @x))))
                (when (and (!= @cid "") (= @pin null))
                  (set @entity.pins (array/append @entity.pins { clientId: @cid app: @payload.app guest: @g })))
                (emit APP_GUEST_ANSWERED { key: @payload.key, guest: @g })))))
      APP_GUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (not (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) (not @a.loading))))) (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true) @a.loading))))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: "" payload: {} options: {} guestOnly: true }))
      APP_GUEST -> serving when (and (!= @payload.app "") (!= @config.appsDir "") (not (array/some @entity.apps (fn a (and (= @a.name @payload.app) (default @a.current true))))))
        (set @entity.apps (array/append @entity.apps { name: @payload.app guest: "" lastUsedMs: (time/now) loading: true current: true release: "" }))
        (set @entity.waiting (array/append @entity.waiting { key: @payload.key app: @payload.app address: "" payload: {} options: {} guestOnly: true }))
        (os/readlink (str/concat @config.appsDir "/" @payload.app "/current") { key: @payload.app emit: { success: APP_LINK_READ, failure: APP_LINK_UNREAD } })

      APP_LINK_READ -> serving
        (set @entity.apps (array/map @entity.apps (fn x (if (and (= @x.name (default @payload.key "")) @x.loading) (object/set @x "release" @payload.target) @x))))
        (os/read-file (str/concat @config.appsDir "/" (default @payload.key "") "/" @payload.target "/app.env") { key: (default @payload.key "") emit: { success: APP_ENV_READ, failure: APP_ENV_UNREAD } })
      APP_LINK_UNREAD -> serving when (= (default @payload.kind "") "invalid")
        (emit APP_LINK_READ { target: "current", key: (default @payload.key "") })
      APP_LINK_UNREAD -> serving when (!= (default @payload.kind "") "invalid")
        (emit APP_LOAD_FAILED { key: (default @payload.key ""), error: (str/concat "the app's current release could not be read: " (default @payload.error "")) })
      APP_ENV_READ -> serving
        (let ((lines (str/split (default (bytes/to-string @payload.data) "") "\n")))
          (let ((env (object/fromEntries (array/map (array/filter (array/map @lines (fn l (str/trim @l))) (fn l (and (!= @l "") (not (str/startsWith @l "#")) (str/includes @l "=")))) (fn l (let ((parts (str/split @l "="))) [(str/trim (default (array/first @parts) "")) (str/join (array/drop @parts 1) "=")]))))))
            (set @entity.apps (array/map @entity.apps (fn x (if (and (= @x.name (default @payload.key "")) @x.loading) (object/set @x "env" @env) @x))))))
        (program/open null { path: (str/concat @config.appsDir "/" (default @payload.key "") "/" (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "release") "current") "/app.orb"), split: true, log: { app: (default @payload.key ""), release: (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "release") "current") }, declared: true, program: "declared", withhold: ["listen", "self-signal"], env: (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "env") {}) } { key: (default @payload.key "") emit: { success: APP_OPENED, failure: APP_LOAD_FAILED } })
      APP_ENV_UNREAD -> serving when (= (default @payload.kind "") "not-found")
        (program/open null { path: (str/concat @config.appsDir "/" (default @payload.key "") "/" (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "release") "current") "/app.orb"), split: true, log: { app: (default @payload.key ""), release: (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "release") "current") }, declared: true, program: "declared", withhold: ["listen", "self-signal"], env: (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "env") {}) } { key: (default @payload.key "") emit: { success: APP_OPENED, failure: APP_LOAD_FAILED } })
      APP_ENV_UNREAD -> serving when (!= (default @payload.kind "") "not-found")
        (emit APP_LOAD_FAILED { key: (default @payload.key ""), error: (str/concat "app.env could not be read: " (default @payload.error "")) })
      APP_OPENED -> serving when (not (array/some @entity.apps (fn a (and (= @a.name @payload.key) (not @a.loading)))))
        (set @entity.apps (array/map @entity.apps (fn x (if (and (= @x.name @payload.key) @x.loading) (object/merge @x { guest: @payload.result.guest lastUsedMs: (time/now) loading: false current: true }) @x))))
        (emit APP_DRAIN { app: @payload.key, guest: @payload.result.guest })
      APP_OPENED -> serving when (array/some @entity.apps (fn a (and (= @a.name @payload.key) (not @a.loading))))
        (emit APP_RELEASED { app: @payload.key, release: (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name @payload.key) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "release") "") })
        (set @entity.apps (array/map @entity.apps (fn x (if (= @x.name @payload.key) (if @x.loading (object/merge @x { guest: @payload.result.guest lastUsedMs: (time/now) loading: false current: true }) (if (default @x.current true) (object/merge @x { current: false retiredMs: (time/now) }) @x)) @x))))
      APP_DRAIN -> serving when (not (array/some @entity.waiting (fn w (= @w.app @payload.app))))
      APP_DRAIN -> serving when (and (array/some @entity.waiting (fn w (= @w.app @payload.app))) (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "guestOnly") false))
        (let ((w (default (array/find @entity.waiting (fn x (= @x.app @payload.app))) { key: "" app: "" address: "" payload: "" options: {} })))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (emit APP_DRAIN { app: @payload.app, guest: @payload.guest })
            (emit APP_GUEST_ANSWERED { key: @w.key, guest: @payload.guest })))
      APP_DRAIN -> serving when (and (array/some @entity.waiting (fn w (= @w.app @payload.app))) (not (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "guestOnly") false)) (and (!= (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "clientId") "") "") (not (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "mounting") false)) (not (array/some @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "clientId") ""))))))))
        (let ((w (default (array/find @entity.waiting (fn x (= @x.app @payload.app))) { key: "" app: "" address: "" payload: "" options: {} clientId: "" })))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (set @entity.pins (array/append @entity.pins { clientId: (default (object/get @w "clientId") "") app: @payload.app guest: @payload.guest }))
            (emit APP_FAILED { key: @w.key, error: "session ended: mount again with the frames the client holds", status: 409, code: @config.codes.sessionEnded.code })
            (emit APP_DRAIN { app: @payload.app, guest: @payload.guest })))
      APP_DRAIN -> serving when (and (array/some @entity.waiting (fn w (= @w.app @payload.app))) (not (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "guestOnly") false)) (not (and (!= (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "clientId") "") "") (not (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "mounting") false)) (not (array/some @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId (default (object/get (default (array/find @entity.waiting (fn w (= @w.app @payload.app))) {}) "clientId") "")))))))))
        (let ((w (default (array/find @entity.waiting (fn x (= @x.app @payload.app))) { key: "" app: "" address: "" payload: "" options: {} })))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (when (and (!= (default (object/get @w "clientId") "") "") (not (array/some @entity.pins (fn p (and (= @p.app @payload.app) (= @p.clientId (default (object/get @w "clientId") ""))))))) (set @entity.pins (array/append @entity.pins { clientId: (default (object/get @w "clientId") "") app: @payload.app guest: @payload.guest })))
            (program/dispatch @w.address @w.payload (object/merge (default @w.options {}) { guest: @payload.guest }) { key: @w.key emit: { success: APP_ANSWERED_IN, failure: APP_FAILED_IN } })
            (emit APP_DRAIN { app: @payload.app, guest: @payload.guest })))
      APP_LOAD_FAILED -> serving when (array/some @entity.apps (fn a (and (= @a.name @payload.key) (not @a.loading))))
        (emit APP_RELEASE_FAILED { app: @payload.key, release: (default (object/get (default (array/find @entity.apps (fn a (and (= @a.name @payload.key) @a.loading))) { name: "", guest: "", lastUsedMs: (time/now), loading: false }) "release") ""), error: (default @payload.error "") })
        (set @entity.apps (array/filter @entity.apps (fn x (not (and (= @x.name @payload.key) @x.loading)))))
      APP_LOAD_FAILED -> serving when (not (array/some @entity.apps (fn a (and (= @a.name @payload.key) (not @a.loading)))))
        (set @entity.apps (array/filter @entity.apps (fn x (!= @x.name @payload.key))))
        (emit APP_FAIL_DRAIN { app: @payload.key, error: (default @payload.error "") })
      APP_FAIL_DRAIN -> serving when (not (array/some @entity.waiting (fn w (= @w.app @payload.app))))
      APP_FAIL_DRAIN -> serving when (array/some @entity.waiting (fn w (= @w.app @payload.app)))
        (let ((w (array/find @entity.waiting (fn x (= @x.app @payload.app)))))
          (do
            (set @entity.waiting (array/filter @entity.waiting (fn x (!= @x.key @w.key))))
            (emit APP_FAILED { key: @w.key, error: @payload.error })
            (emit APP_FAIL_DRAIN { app: @payload.app, error: @payload.error })))
      APP_ANSWERED_IN -> serving
        (emit APP_ANSWERED { key: @payload.key, result: @payload.result })
      APP_FAILED_IN -> serving
        (let ((first : AppDispatchError? (array/first (default @payload.errors []))))
          (emit APP_FAILED { key: @payload.key, error: (default @payload.error ""), status: (if (= @first null) null @first.status), code: (if (= @first null) null @first.code) }))

      APP_RELEASE_CHECK -> serving when (< @payload.index (array/len (array/filter @entity.apps (fn a (and (default @a.current true) (not @a.loading))))))
        (let ((a (array/nth (array/filter @entity.apps (fn x (and (default @x.current true) (not @x.loading)))) @payload.index)))
          (do
            (os/readlink (str/concat @config.appsDir "/" @a.name "/current") { key: @a.name emit: { success: APP_RELEASE_SEEN, failure: APP_RELEASE_UNSEEN } })
            (emit APP_RELEASE_CHECK { index: (+ @payload.index 1) })))
      APP_RELEASE_CHECK -> serving when (and (>= @payload.index (array/len (array/filter @entity.apps (fn a (and (default @a.current true) (not @a.loading)))))) (= (array/len @config.resident) 0))
      APP_RELEASE_CHECK -> serving when (and (>= @payload.index (array/len (array/filter @entity.apps (fn a (and (default @a.current true) (not @a.loading)))))) (> (array/len @config.resident) 0))
        (emit APP_RESIDENT_LOAD { index: 0 })
      APP_RELEASE_SEEN -> serving when (and (array/some @entity.apps (fn a (and (= @a.name (default @payload.key "")) (default @a.current true) (not @a.loading) (!= (default @a.release "") @payload.target)))) (not (array/some @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading)))))
        (set @entity.apps (array/append @entity.apps { name: (default @payload.key "") guest: "" lastUsedMs: (time/now) loading: true current: false release: @payload.target }))
        (os/read-file (str/concat @config.appsDir "/" (default @payload.key "") "/" @payload.target "/app.env") { key: (default @payload.key "") emit: { success: APP_ENV_READ, failure: APP_ENV_UNREAD } })
      APP_RELEASE_SEEN -> serving when (not (and (array/some @entity.apps (fn a (and (= @a.name (default @payload.key "")) (default @a.current true) (not @a.loading) (!= (default @a.release "") @payload.target)))) (not (array/some @entity.apps (fn a (and (= @a.name (default @payload.key "")) @a.loading))))))
      APP_RELEASE_UNSEEN -> serving when (= (default @payload.kind "") "invalid")
        (emit APP_RELEASE_SEEN { target: "current", key: (default @payload.key "") })
      APP_RELEASE_UNSEEN -> serving when (and (= (default @payload.kind "") "not-found") (array/some @entity.apps (fn a (and (= @a.name (default @payload.key "")) (not @a.loading)))))
        (emit APP_UNLOAD { app: (default @payload.key "") })
      APP_RELEASE_UNSEEN -> serving when (and (!= (default @payload.kind "") "invalid") (not (and (= (default @payload.kind "") "not-found") (array/some @entity.apps (fn a (and (= @a.name (default @payload.key "")) (not @a.loading)))))))
      APPS_LIST -> serving
        (emit APPS_LISTED { key: @payload.key, apps: (array/map @entity.apps (fn a { name: @a.name, guest: @a.guest, release: (default @a.release ""), current: (default @a.current true), loading: @a.loading, lastUsedMs: @a.lastUsedMs })) })

      APP_UNLOAD -> serving when (= (array/len (array/filter @entity.apps (fn a (and (= @a.name @payload.app) (not @a.loading))))) 1)
        (let ((a (array/find @entity.apps (fn x (and (= @x.name @payload.app) (not @x.loading))))))
          (do
            (set @entity.apps (array/filter @entity.apps (fn x (!= @x.guest @a.guest))))
            (set @entity.pins (array/filter @entity.pins (fn p (!= @p.guest @a.guest))))
            (emit APP_UNLOADED { app: @payload.app })
            (program/close @a.guest)))
      APP_UNLOAD -> serving when (> (array/len (array/filter @entity.apps (fn a (and (= @a.name @payload.app) (not @a.loading))))) 1)
        (let ((a (array/find @entity.apps (fn x (and (= @x.name @payload.app) (not @x.loading) (not (default @x.current true)))))))
          (do
            (set @entity.apps (array/filter @entity.apps (fn x (!= @x.guest @a.guest))))
            (set @entity.pins (array/filter @entity.pins (fn p (!= @p.guest @a.guest))))
            (emit APP_RELEASE_CLOSED { app: @payload.app, release: (default @a.release "") })
            (emit APP_UNLOAD { app: @payload.app })
            (program/close @a.guest)))
      APP_IDLE_SWEEP -> serving when (array/some @entity.apps (fn a (and (not @a.loading) (or (and (default @a.current true) (not (array/includes @config.resident @a.name)) (> (time/diff (time/now) @a.lastUsedMs "ms") @config.idleMs)) (and (not (default @a.current true)) (or (> (time/diff (time/now) @a.lastUsedMs "ms") @config.idleMs) (> (time/diff (time/now) (default @a.retiredMs (time/now)) "ms") @config.drainMs)))))))
        (let ((a (array/find @entity.apps (fn x (and (not @x.loading) (or (and (default @x.current true) (not (array/includes @config.resident @x.name)) (> (time/diff (time/now) @x.lastUsedMs "ms") @config.idleMs)) (and (not (default @x.current true)) (or (> (time/diff (time/now) @x.lastUsedMs "ms") @config.idleMs) (> (time/diff (time/now) (default @x.retiredMs (time/now)) "ms") @config.drainMs)))))))))
          (do
            (set @entity.apps (array/filter @entity.apps (fn x (!= @x.guest @a.guest))))
            (set @entity.pins (array/filter @entity.pins (fn p (!= @p.guest @a.guest))))
            (when (default @a.current true)
              (emit APP_UNLOADED { app: @a.name }))
            (when (not (default @a.current true))
              (emit APP_RELEASE_CLOSED { app: @a.name, release: (default @a.release "") }))
            (emit APP_IDLE_SWEEP { swept: (+ @payload.swept 1) })
            (program/close @a.guest)))
    }

    ticks {
      idleCheck every 1s when (>= (time/diff (time/now) @entity.lastSweepMs "ms") @config.idleCheckMs)
        (set @entity.lastSweepMs (time/now))
        (emit APP_IDLE_SWEEP { swept: 0 })
      releaseCheck every 1s when (and (> @config.releaseCheckMs 0) (>= (time/diff (time/now) @entity.lastReleaseCheckMs "ms") @config.releaseCheckMs))
        (set @entity.lastReleaseCheckMs (time/now))
        (emit APP_RELEASE_CHECK { index: 0 })
    }

    emits {
      APP_ANSWERED -> external { key : string!  result : AppValue }
        @description "A hosted app's answer to an APP_REQUEST, under the request's key."
      APP_GUEST_ANSWERED -> external { key : string!  guest : string! }
        @description "The guest handle of a hosted app, answering an APP_GUEST under its key."
      APP_FAILED -> external { key : string!  error : string!  status : number?  code : string? }
        @description "An APP_REQUEST that could not be answered: no app named, the app's file unreadable or refused at open, or the dispatch failed, or (status 409, code SESSION_ENDED) a request from a client with no pin that is not mounting: the client is pinned and must send its mounts again."
      APP_UNLOADED -> external { app : string! }
        @description "A hosted app was closed: by APP_UNLOAD, because it sat unused past idleMs, or because its current was removed."
      APPS_LISTED -> external { key : string!  apps : [AppListed]! }
        @description "Every guest the host holds, answering an APPS_LIST under its key: name, guest handle, release, whether it is the current release, whether it is still loading, and when it was last used."
      APP_RELEASED -> external { app : string!  release : string! }
        @description "A new release of a loaded app opened and is now the app's current guest; clients pinned to the earlier release stay on it."
      APP_RELEASE_FAILED -> external { app : string!  release : string!  error : string! }
        @description "A new release of a loaded app could not be read or opened; the earlier release keeps serving."
      APP_RELEASE_CLOSED -> external { app : string!  release : string! }
        @description "An earlier release of an app was closed: unused past idleMs, past drainMs since it stopped being current, or by APP_UNLOAD."
      APP_LINK_READ { target : string!, key : string }
        @description "The release a loading app's current links to (current itself when it is a folder)."
        @tier "internal"
      APP_LINK_UNREAD { error : string, kind : string, key : string }
        @description "A loading app's current could not be read as a link: invalid (a folder, not a link) loads the folder, anything else fails the load."
        @tier "internal"
      APP_ENV_READ { data : bytes!, key : string }
        @description "An app's app.env read: its NAME=value lines are the env it is opened with."
        @tier "internal"
      APP_ENV_UNREAD { error : string, kind : string, key : string }
        @description "An app's app.env could not be read: not-found opens the app with no env of its own, anything else fails its load."
        @tier "internal"
        @description "An app's program resolved."
        @tier "internal"
      APP_OPENED { result : HostOpened!, key : string }
        @description "An app's guest session opened."
        @tier "internal"
      APP_LOAD_FAILED { error : string, key : string }
        @description "An app's folder, read, resolve or open failed."
        @tier "internal"
      APP_DRAIN { app : string!, guest : string! }
        @description "Replay the next request queued for an app that just opened."
        @tier "internal"
      APP_FAIL_DRAIN { app : string!, error : string! }
        @description "Answer the next request queued for an app that failed to load."
        @tier "internal"
      APP_ANSWERED_IN { key : string!, result : AppValue }
        @description "The keyed dispatch to an app completed."
        @tier "internal"
      APP_FAILED_IN { key : string!, error : string, errors : [AppDispatchError]? }
        @description "The keyed dispatch to an app failed."
        @tier "internal"
      APP_IDLE_SWEEP { swept : number! }
        @description "Close the next guest unused past idleMs, or retired past drainMs."
        @tier "internal"
      APP_RELEASE_CHECK { index : number! }
        @description "Look at the next loaded app's current link."
        @tier "internal"
      APP_RELEASE_SEEN { target : string!, key : string }
        @description "The release a loaded app's current links to now."
        @tier "internal"
      APP_RELEASE_UNSEEN { error : string, kind : string, key : string }
        @description "A loaded app's current could not be read as a link: invalid means it is a folder (the release current), anything else keeps the loaded release."
        @tier "internal"
      APP_RESIDENT_LOAD { index : number! }
        @description "Load the next resident app at start."
        @tier "internal"
      APP_UNLOAD { app : string! }
        @description "Close the next guest of an app being unloaded."
        @tier "internal"
    }

    listens {
      APP_REQUEST { key : string!, app : string!, address : AppAddress!, payload : AppValue, options : Map string AppValue, clientId : string?, mounting : boolean? }
        @description "Run an event on a hosted app, loading the app from appsDir when it is not open; a request naming a clientId stays on the release that client first used."
      APP_GUEST { key : string!, app : string!, clientId : string? }
        @description "Ask for the guest handle of a hosted app (the release the clientId is pinned to, else the current one), loading the app from appsDir when it is not open; answered as APP_GUEST_ANSWERED, or APP_FAILED under the key."
      APP_UNLOAD { app : string! }
        @description "Close every guest of a hosted app and forget it."
      APPS_LIST { key : string! }
        @description "Ask for every guest the host holds; answered as APPS_LISTED under the key."
    }

    config {
      codes : AppHostCodes = { sessionEnded: { code: "SESSION_ENDED", category: "session", description: "A request from a client with no pin that is not mounting: the client is pinned and must send its mounts again" } }
        @label "Failure codes"
        @description "The codes APP_FAILED carries."
        @tier "internal"
      appsDir : string = "/srv/orb/apps"
        @label "Apps folder"
        @description "The folder holding one subfolder per app (the std-deploy-host layout under its root /srv/orb; a composer that moves it grants fs read on its own folder), each with its release at <appsDir>/<app>/current (a link to releases/<n>, or a folder), holding app.orb and app.env."
        @tier "domain"
      idleMs : number = 600000
        @label "Idle limit"
        @description "Close a hosted app's guest unused for this many milliseconds (never the current guest of a resident app)."
        @tier "domain"
      idleCheckMs : number = 60000
        @label "Idle check interval"
        @description "How often, in milliseconds, hosted apps are checked for idleness."
        @tier "domain"
      releaseCheckMs : number = 5000
        @label "Release check interval"
        @description "How often, in milliseconds, each loaded app's current is resolved to see whether a new release was linked; 0 never looks."
        @tier "domain"
      drainMs : number = 1800000
        @label "Drain limit"
        @description "How long an earlier release keeps serving the clients pinned to it after a new release became current; past it the earlier guest closes and those clients reach the current release."
        @tier "domain"
      resident : [string] = []
        @label "Resident apps"
        @description "Apps opened when the host starts and never closed for idleness, for apps whose background work must run with nobody connected; one not loaded yet (its release came after the start, or its load failed) is opened again after each release check."
        @tier "domain"
    }
  }

  page boot as ProgramHostOrbitalStart -> ProgramHost, ArgsCli, ProgramApps
}
