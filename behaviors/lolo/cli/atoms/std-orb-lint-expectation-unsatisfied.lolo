app std-orb-lint-expectation-unsatisfied [
  version: "1.0.0",
  inbound: ["cli-lint-expectation-unsatisfied"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-expectation-unsatisfied — the `orb lint expectation-unsatisfied <file>` command, the port of the ORB_S_EXPECTATION_UNSATISFIED findings of validate_expectation_links (composition/expectations.rs). For every non-spec orbital's `expects` entry it reports: a strict (spec obligation) entity, identity, event, state, transition, page or config expectation nothing in the program provides (providers are the inline entities of non-spec orbitals; traits and pages are looked up in every orbital), `a spec obligation is never deferred`; an `expects trait T { state S }` whose present trait declares no such state; an `expects trait T { S --E--> S2 }` whose present trait has no such transition; and an `expects trait T { emits E }` whose present trait does not emit E. An absent provider of a lenient expectation is deferred, never reported. The program is the resolved program the lint input reads. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint expectation-unsatisfied: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-expectation-unsatisfied"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type LObj = Map string LNode?
type ExField = { name : string, type : string, required : boolean, primaryKey : boolean, unique : boolean, values : [string], default : LNode?, relation : LNode?, items : LNode?, properties : LNode? }
type UsEntity = { name : string, identity : boolean, shared : boolean, browser : boolean, persistence : string, collection : string, fields : [ExField], readPolicy : LNode?, createPolicy : LNode?, updatePolicy : LNode?, deletePolicy : LNode?, accessWaivers : LNode? }
type UsExpect = { kind : string, name : string, strict : boolean, traitName : string, state : string, from : string, to : string, event : string, protocol : string, path : string, traits : [string], shape : [ExField], payload : [ExField], persistence : string, shared : boolean, browser : boolean, readPolicy : LNode?, createPolicy : LNode?, updatePolicy : LNode?, deletePolicy : LNode?, accessWaivers : LNode?, knob : ExField }
type ExEmit = { event : string, payloadSchema : [ExField] }
type ExState = { name : string }
type ExTransition = { from : LNode, to : string, event : string, guard : LNode?, effects : [LNode?] }
type ExMachine = { states : [ExState], transitions : [ExTransition] }
type ExKnob = { type : string, values : [string], default : LNode?, items : LNode?, properties : LNode? }
type ExTrait = { name : string, emits : [ExEmit], stateMachine : ExMachine, ticks : [ExTransition], config : Map string ExKnob? }
type ExPageTrait = { ref : string, name : string }
type ExPage = { name : string, path : string, protocol : string, traits : [ExPageTrait] }
type UsOrbital = { name : string, spec : boolean, expects : [UsExpect], entity : UsEntity, auxiliaryEntities : [UsEntity], traits : [ExTrait], pages : [ExPage] }
type UsProgram = { orbitals : [UsOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintExpectationUnsatisfiedCodes = { sExpectationUnsatisfied : LintCodeDecl }

orbital OrbLintExpectationUnsatisfiedOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintExpectationUnsatisfiedRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintExpectationUnsatisfied -> OrbLintExpectationUnsatisfiedRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbs (object/get @payload.program "orbitals" [])))
 (let ((provs (array/flatten (array/map (array/filter @orbs (fn o (not (object/get @o "spec" false)))) (fn o (array/map (array/filter (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])) (fn e (!= (object/get @e "name" "") ""))) (fn e { n: (object/get @e "name" ""), id: (object/get @e "identity" false) }))))))
       (allpg (array/flatten (array/map @orbs (fn o (array/map (object/get @o "pages" []) (fn pg { protocol: (object/get @pg "protocol" ""), path: (object/get @pg "path" "") }))))))
       (want (default (object/fromEntries (array/flatten (array/map @orbs (fn o (array/map (object/get @o "expects" []) (fn x [(object/get @x "traitName" ""), true])))))) {})))
 (let ((pn (default (object/fromEntries (array/map @provs (fn p [(object/get @p "n"), true]))) {}))
       (anyid (array/some @provs (fn p (object/get @p "id"))))
       (trs (array/flatten (array/map @orbs (fn o (let ((on (object/get @o "name" ""))) (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t (let ((tn (object/get @t "name" ""))) { name: @tn, on: @on, cfg: (object/keys (object/get @t "config" {})), states: (if (object/has @want @tn) (array/map (object/get @t "stateMachine.states" []) (fn s (object/get @s "name" ""))) []), emits: (if (object/has @want @tn) (array/map (object/get @t "emits" []) (fn e (object/get @e "event" ""))) []), trans: (if (object/has @want @tn) (array/map (object/get @t "stateMachine.transitions" []) (fn tr { event: (object/get @tr "event" ""), to: (object/get @tr "to" ""), from: (object/get @tr "from" null) })) []) })))))))))
  (let ((tidx (default (object/fromEntries (array/map (array/reverse @trs) (fn r [(object/get @r "name"), @r]))) {}))
        (cfgset (default (object/fromEntries (array/flatten (array/map @trs (fn r (array/map (object/get @r "cfg") (fn k [@k, true])))))) {})))
(array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
  (let ((o (array/nth @orbs @oi)))
   (if (or (object/get @o "spec" false) (not (object/has @o "expects"))) []
    (let ((on (object/get @o "name" "")) (xs (object/get @o "expects" [])))
     (array/flatten (array/map (array/range 0 (array/len @xs)) (fn j
      (let ((x (array/nth @xs @j)))
       (let ((base (str/concat "orbitals[" @oi " (" @on ")].expects[" @j "]")) (kind (object/get @x "kind" "")) (strict (object/get @x "strict" false)))
        (array/concat
  (if @strict
   (let ((unprov (if (= @kind "entity") (if (object/has @pn (object/get @x "name" "")) "" (str/concat "entity `" (object/get @x "name" "") "`"))
  (if (= @kind "identity") (if (!= (object/get @x "name" "") "") (if (object/has @pn (object/get @x "name" "")) "" (str/concat "identity `" (object/get @x "name" "") "`")) (if @anyid "" "an [identity] entity"))
  (if (= @kind "event") (if (object/has @tidx (object/get @x "traitName" "")) "" (str/concat "trait `" (object/get @x "traitName" "") "` (to emit `" (object/get @x "event" "") "`)"))
  (if (or (= @kind "state") (= @kind "transition")) (if (object/has @tidx (object/get @x "traitName" "")) "" (str/concat "trait `" (object/get @x "traitName" "") "`"))
  (if (= @kind "page")
    (let ((pr (object/get @x "protocol" "")))
      (if (array/some @allpg (fn pg (if (!= @pr "") (= (object/get @pg "protocol" "") @pr) (and (= (object/get @pg "protocol" "") "") (= (object/get @pg "path" "") (object/get @x "path" ""))))))
        "" (if (!= @pr "") (str/concat "a `" @pr "` page") (str/concat "page `" (object/get @x "path" "") "`"))))
  (if (= @kind "config") (if (object/has @cfgset (object/get @x "name" "")) "" (str/concat "config knob `" (object/get @x "name" "") "` on a trait"))
    ""))))))))
    (if (!= @unprov "") [{ code: @config.codes.sExpectationUnsatisfied.code, path: @base, message: (str/concat "`" @on "` expects " @unprov ", but nothing in this program provides it — " "a spec obligation is never deferred" "."), suggestion: "Provide it in an orbital of this program (give the providing import that name, or declare it here).", severity: "error" }] [])) [])
  (if (= @kind "state") (let ((tr (object/get @tidx (object/get @x "traitName" "") null)))
  (if (or (= @tr null) (array/includes (object/get @tr "states" []) (object/get @x "state" ""))) []
    [{ code: @config.codes.sExpectationUnsatisfied.code, path: @base, message: (str/concat "`" @on "` expects " (str/concat "trait `" (object/get @x "traitName" "") "` to declare state `" (object/get @x "state" "") "`") ", but nothing in this program provides it — " (str/concat "`" (object/get @x "traitName" "") "` declares no such state") "."), suggestion: "Provide it in an orbital of this program (give the providing import that name, or declare it here).", severity: "error" }]))
    (if (= @kind "transition") (let ((tr (object/get @tidx (object/get @x "traitName" "") null)))
  (if (or (= @tr null) (array/some (object/get @tr "trans" [])
        (fn t (and (= (object/get @t "event" "") (object/get @x "event" "")) (= (object/get @t "to" "") (object/get @x "to" ""))
                   (or (= (default (as (object/get @t "from" null) LStr) "") (object/get @x "from" "")) (array/includes (default (as (object/get @t "from" null) LNodes) []) (object/get @x "from" ""))))))) []
    [{ code: @config.codes.sExpectationUnsatisfied.code, path: @base, message: (str/concat "`" @on "` expects " (str/concat "trait `" (object/get @x "traitName" "") "` to move `" (object/get @x "from" "") "` to `" (object/get @x "to" "") "` on `" (object/get @x "event" "") "`") ", but nothing in this program provides it — " (str/concat "`" (object/get @x "traitName" "") "` has no such transition") "."), suggestion: "Provide it in an orbital of this program (give the providing import that name, or declare it here).", severity: "error" }]))
      (if (= @kind "event") (let ((tr (object/get @tidx (object/get @x "traitName" "") null)))
  (if (or (= @tr null) (array/includes (object/get @tr "emits" []) (object/get @x "event" ""))) []
    [{ code: @config.codes.sExpectationUnsatisfied.code, path: @base, message: (str/concat "`" @on "` expects `" (object/get @x "traitName" "") "." (object/get @x "event" "") "`, but trait `" (object/get @x "traitName" "") "` in `" (object/get @tr "on") "` does not emit `" (object/get @x "event" "") "`."), suggestion: (str/concat "Declare `" (object/get @x "event" "") "` in `" (object/get @x "traitName" "") "`'s `emits`, or listen to the trait that emits it."), severity: "error" }])) []))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "expectation-unsatisfied", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : UsProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintExpectationUnsatisfiedCodes = { sExpectationUnsatisfied: { code: "ORB_S_EXPECTATION_UNSATISFIED", category: "schema", description: "An orbital expects an entity, trait, event, or config default that nothing in the program provides" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintExpectationUnsatisfiedCli -> OrbLintExpectationUnsatisfiedRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint expectation-unsatisfied <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "expectation-unsatisfied") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint expectation-unsatisfied: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "expectation-unsatisfied") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint expectation-unsatisfied: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-expectation-unsatisfied" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint expectation-unsatisfied` with its arguments and working directory."
        @synonyms "orb lint expectation-unsatisfied"
      OrbLintExpectationUnsatisfied.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintExpectationUnsatisfiedCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintExpectationUnsatisfiedOrbitalStart -> OrbLintExpectationUnsatisfied, OrbLintExpectationUnsatisfiedCli, OrbLintInput, Packs, Versions
}
