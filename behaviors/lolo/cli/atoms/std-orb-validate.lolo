app std-orb-validate [
  version: "1.0.0",
  inbound: ["cli-validate"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-validate — the `orb validate <file> [--json] [--deny-warnings] [--final] [--patterns <path>] [--services <path>]` command (spec/cli/orb-validate.lolo; port of orbital-cli commands/validate.rs validate_schema). The core checks are the host op `(program/validate null { report: true path final denyWarnings patterns services })`, which answers exactly the report `orb validate --json` printed: { success, valid, errors?, warnings?, stats? }. The path is the working directory joined to the file when relative. --json prints that report as 2-space pretty JSON (status 200, as Rust exited 0 for an invalid program). The text form prints `Validating schema: <file>` on stdout, then on errors `Schema validation errors:` and one `  ❌ [CODE] path: message @ line:col 💡 suggestion` line per error on stderr followed by `Error: Schema validation failed with N error(s)` (status 500); on warnings alone `Schema validation warnings:` and `  ⚠️  …` lines on stdout, and under --deny-warnings `Error: Schema validation failed: N warning(s) under --deny-warnings` on stderr (status 500). A file the host could not read (FILE_READ_ERROR) prints `Error: <reason>` on stderr (status 500). Under --final the host is never asked for the retired `final` check: the final-only rules of the composed std-orb-lint-engine (expectation-final, not-found, control-unhandled; their findings arrive in LINT_COLLECTED.final over the same lint input) join the policy findings in the same host call; without --final they are dropped. Policy lints (the std-orb-lint-engine orbital, composed here; it answers LINT_COLLECTED) merge into the report: an error-severity lint finding joins errors, a warning joins warnings. Usage error: status 400 (exit 2). Known differences from the Rust bytes: a finding the host reports without a line prints no ` @ line:col`; lint findings carry no source position."
]
uses Spec from "almadar-std/orb-validate"
uses Args from "std/behaviors/std-args"
uses LintEngine from "std/behaviors/std-orb-lint-engine"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type RuleFound = { rule : string!, findings : [OrbFinding]! }
type CascadeRoot = { orbital : number!, code : string!, path : string!, message : string!, entity : string, field : string }
type CascadeDrop = { root : number!, code : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type ReportFinding = { code : string!, path : string, message : string!, suggestion : string, fixGuidance : string, expectedShape : string, validValues : [string], entity : string, field : string, line : number, column : number, endLine : number, endColumn : number, approximate : boolean, needsInstall : boolean }
type ReportStats = { orbitals : number!, entities : number!, traits : number!, pages : number! }
type ValidateOptions = { report : boolean!, path : string!, denyWarnings : boolean!, patterns : string, services : string }
type ValidationReport = { success : boolean!, valid : boolean!, errors : [ReportFinding], warnings : [ReportFinding], stats : ReportStats }

orbital Lint = LintEngine.orbitals.OrbLintEngineOrbital {
  listens {
    OrbValidateOrbital.ValidateEngine.LINT_RUN -> OrbLintEngine.LINT_RUN
  }
}

type LintCodeDecl = { code : string!, category : string!, description : string! }
type ValidateCodes = { lintInputUnread : LintCodeDecl }

orbital OrbValidateOrbital {
  entity ValidateRun [runtime] {
    id : string!
    cwd : string = ""
    file : string = ""
    json : boolean = false
    denyWarnings : boolean = false
    finalProgram : boolean = false
    report : ValidationReport = { success: true, valid: true }
    cascade : [CascadeRoot] = []
    dropped : [CascadeDrop] = []
    errors : [ReportFinding] = []
    warnings : [ReportFinding] = []
    valid : boolean = false
    options : ValidateOptions = { report: true, path: "", denyWarnings: false }
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbValidate.VALIDATE_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbValidate -> ValidateRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      VALIDATE_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit VALIDATE_ANSWERED { status: 500, body: "", stderr: "Error: orb validate: the command arguments could not be read" })
      VALIDATE_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit VALIDATE_ARGS_PARSE { stage: "validate" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "deny-warnings" aliases: [] takesValue: false repeatable: false }, { name: "final" aliases: [] takesValue: false repeatable: false }, { name: "patterns" aliases: [] takesValue: true repeatable: false }, { name: "services" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      VALIDATE_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1))
        (emit VALIDATE_ANSWERED { status: 400, body: "", stderr: "usage: orb validate <FILE> [--json] [--patterns <PATH>] [--services <PATH>] [--deny-warnings] [--final]" })
      ;; the positional default never fires: this arm requires exactly one positional
      VALIDATE_ARGS_DONE -> working when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (emit VALIDATE_START { file: (default (array/first @payload.positionals) ""), path: (if (os/path-is-absolute (default (array/first @payload.positionals) "")) (default (array/first @payload.positionals) "") (os/path-join @entity.cwd (default (array/first @payload.positionals) ""))), cwd: @entity.cwd, json: (object/has @payload.flags "json"), denyWarnings: (object/has @payload.flags "deny-warnings"), finalProgram: (object/has @payload.flags "final"), hasPatterns: (object/has @payload.flags "patterns"), patterns: (default (array/first (default (object/get @payload.flags "patterns") [""])) ""), hasServices: (object/has @payload.flags "services"), services: (default (array/first (default (object/get @payload.flags "services") [""])) "") })
    }

    state working {
      INIT -> working
      VALIDATE_DONE -> ready
        (emit VALIDATE_ANSWERED { status: @payload.status, body: @payload.body, stderr: @payload.stderr })
    }

    emits {
      VALIDATE_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      VALIDATE_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words."
        @tier "internal"
      VALIDATE_START {
        file : string!
        path : string!
        cwd : string!
        json : boolean!
        denyWarnings : boolean!
        finalProgram : boolean!
        hasPatterns : boolean!
        patterns : string!
        hasServices : boolean!
        services : string!
      }
        @description "Internal: validate the program at the absolute path."
        @tier "internal"
    }

    listens {
      VALIDATE_CALLED -> inbound "cli-validate" answers VALIDATE_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb validate`."
        @synonyms "orb validate, check a program, the 0 errors 0 warnings bar, validate a lolo file"
      VALIDATE_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED."
      ArgsCli.ARGS_PARSED -> VALIDATE_ARGS_DONE
      ValidateEngine.VALIDATE_ANSWERED -> VALIDATE_DONE
      VALIDATE_DONE { status : number!  body : string!  stderr : string }
        @description "Internal: the engine's answer, relayed to the hook by its handler."
        @tier "internal"
    }
  }

  trait ValidateEngine -> ValidateRun [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      VALIDATE_START -> linting
        (set @entity.cwd @payload.cwd)
        (set @entity.file @payload.file)
        (set @entity.json @payload.json)
        (set @entity.denyWarnings @payload.denyWarnings)
        (set @entity.finalProgram @payload.finalProgram)
        (set @entity.options (object/merge (object/merge { report: true path: @payload.path denyWarnings: @payload.denyWarnings } (if @payload.hasPatterns { patterns: @payload.patterns } {})) (if @payload.hasServices { services: @payload.services } {})))
        (emit LINT_RUN { file: @payload.file })
    }

    state linting {
      INIT -> linting
      LINT_COLLECTED -> validating
        (set @entity.cascade (array/map (array/filter (array/flatten (array/map (array/filter @payload.found (fn r (= (object/get @r "rule") @config.cascadeRule))) (fn r (object/get @r "findings")))) (fn f (or (!= (object/get @f "entity" null) null) (!= (object/get @f "field" null) null)))) (fn f (object/merge (object/merge { orbital: (if (str/startsWith (object/get @f "path" "") (quote "orbitals[")) (default (str/to-int (default (array/first (str/split (default (array/first (str/split (str/slice (object/get @f "path" "") 9 (str/len (object/get @f "path" ""))) "]")) "") " ")) "")) -1) -1), code: (object/get @f "code"), path: (object/get @f "path"), message: (object/get @f "message") } (if (!= (object/get @f "entity" null) null) { entity: (object/get @f "entity") } {})) (if (!= (object/get @f "field" null) null) { field: (object/get @f "field") } {})))))
        (program/validate null (object/merge @entity.options { findings: (if @entity.finalProgram (array/concat @payload.findings @payload.final) @payload.findings) }) { key: "validate" emit: { success: VALIDATE_CHECKED, failure: VALIDATE_REFUSED } })
      LINT_INPUT_UNREAD -> validating
        (program/validate null (object/merge @entity.options { findings: [{ code: @config.codes.lintInputUnread.code, path: "", message: (str/concat "the lint rules did not run: " @payload.file " could not be read or lowered" (if (= @payload.error "") "" (str/concat ": " @payload.error))), suggestion: "Fix the read error; the std lint rules need the file read and lowered before they run.", severity: "error", validValues: [] }] }) { key: "validate" emit: { success: VALIDATE_CHECKED, failure: VALIDATE_REFUSED } })
    }

    state validating {
      INIT -> validating
      VALIDATE_REFUSED -> idle
        (emit VALIDATE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " @payload.error) })
      VALIDATE_CHECKED -> rendering
        (set @entity.report @payload.result)
        (set @entity.dropped (array/filter (array/concat (array/map (object/get @payload.result "errors" []) (fn f { root: (if (or (str/startsWith (object/get @f "code" "") (quote "ORB_O_")) (str/startsWith (object/get @f "code" "") (quote "ORB_U_"))) -1 (let ((o (if (str/startsWith (object/get @f "path" "") (quote "orbitals[")) (default (str/to-int (default (array/first (str/split (default (array/first (str/split (str/slice (object/get @f "path" "") 9 (str/len (object/get @f "path" ""))) "]")) "") " ")) "")) -1) -1))) (array/findIndex @entity.cascade (fn c (and (or (= @o -1) (= (object/get @c "orbital") @o)) (or (= (object/get @c "entity" null) null) (= (object/get @f "entity" null) (object/get @c "entity" null))) (or (= (object/get @c "field" null) null) (= (object/get @f "field" null) (object/get @c "field" null)))))))), code: (object/get @f "code" "") })) (array/map (object/get @payload.result "warnings" []) (fn f { root: (if (or (str/startsWith (object/get @f "code" "") (quote "ORB_O_")) (str/startsWith (object/get @f "code" "") (quote "ORB_U_"))) -1 (let ((o (if (str/startsWith (object/get @f "path" "") (quote "orbitals[")) (default (str/to-int (default (array/first (str/split (default (array/first (str/split (str/slice (object/get @f "path" "") 9 (str/len (object/get @f "path" ""))) "]")) "") " ")) "")) -1) -1))) (array/findIndex @entity.cascade (fn c (and (or (= @o -1) (= (object/get @c "orbital") @o)) (or (= (object/get @c "entity" null) null) (= (object/get @f "entity" null) (object/get @c "entity" null))) (or (= (object/get @c "field" null) null) (= (object/get @f "field" null) (object/get @c "field" null)))))))), code: (object/get @f "code" "") }))) (fn d (>= (object/get @d "root") 0))))
        (set @entity.errors (array/map (array/filter (object/get @payload.result "errors" []) (fn f (< (if (or (str/startsWith (object/get @f "code" "") (quote "ORB_O_")) (str/startsWith (object/get @f "code" "") (quote "ORB_U_"))) -1 (let ((o (if (str/startsWith (object/get @f "path" "") (quote "orbitals[")) (default (str/to-int (default (array/first (str/split (default (array/first (str/split (str/slice (object/get @f "path" "") 9 (str/len (object/get @f "path" ""))) "]")) "") " ")) "")) -1) -1))) (array/findIndex @entity.cascade (fn c (and (or (= @o -1) (= (object/get @c "orbital") @o)) (or (= (object/get @c "entity" null) null) (= (object/get @f "entity" null) (object/get @c "entity" null))) (or (= (object/get @c "field" null) null) (= (object/get @f "field" null) (object/get @c "field" null)))))))) 0))) (fn f (let ((ix (array/findIndex @entity.cascade (fn c (and (= (object/get @c "code") (object/get @f "code" "")) (= (object/get @c "path") (object/get @f "path" "")) (= (object/get @c "message") (object/get @f "message" ""))))))) (if (< @ix 0) @f (let ((ds (array/filter @entity.dropped (fn d (= (object/get @d "root") @ix))))) (if (= (array/len @ds) 0) @f (object/merge @f { message: (str/concat (object/get @f "message" "") " (" (array/len @ds) " downstream finding" (if (= (array/len @ds) 1) "" "s") " suppressed: " (str/join (array/map @ds (fn d (object/get @d "code" ""))) ", ") ")") }))))))))
        (set @entity.warnings (array/map (array/filter (object/get @payload.result "warnings" []) (fn f (< (if (or (str/startsWith (object/get @f "code" "") (quote "ORB_O_")) (str/startsWith (object/get @f "code" "") (quote "ORB_U_"))) -1 (let ((o (if (str/startsWith (object/get @f "path" "") (quote "orbitals[")) (default (str/to-int (default (array/first (str/split (default (array/first (str/split (str/slice (object/get @f "path" "") 9 (str/len (object/get @f "path" ""))) "]")) "") " ")) "")) -1) -1))) (array/findIndex @entity.cascade (fn c (and (or (= @o -1) (= (object/get @c "orbital") @o)) (or (= (object/get @c "entity" null) null) (= (object/get @f "entity" null) (object/get @c "entity" null))) (or (= (object/get @c "field" null) null) (= (object/get @f "field" null) (object/get @c "field" null)))))))) 0))) (fn f (let ((ix (array/findIndex @entity.cascade (fn c (and (= (object/get @c "code") (object/get @f "code" "")) (= (object/get @c "path") (object/get @f "path" "")) (= (object/get @c "message") (object/get @f "message" ""))))))) (if (< @ix 0) @f (let ((ds (array/filter @entity.dropped (fn d (= (object/get @d "root") @ix))))) (if (= (array/len @ds) 0) @f (object/merge @f { message: (str/concat (object/get @f "message" "") " (" (array/len @ds) " downstream finding" (if (= (array/len @ds) 1) "" "s") " suppressed: " (str/join (array/map @ds (fn d (object/get @d "code" ""))) ", ") ")") }))))))))
        (set @entity.valid (object/get @payload.result "valid" false))
        (emit VALIDATE_RENDER { })
    }

    state rendering {
      INIT -> rendering
      VALIDATE_RENDER -> idle when @entity.json
        (emit VALIDATE_ANSWERED { status: 200, body: (json/stringify (object/merge (object/merge (object/merge { success: (object/get @entity.report "success" true), valid: @entity.valid } (if (> (array/len @entity.errors) 0) { errors: @entity.errors } {})) (if (> (array/len @entity.warnings) 0) { warnings: @entity.warnings } {})) (if (object/has @entity.report "stats") { stats: (object/get @entity.report "stats") } {})) { pretty: true }) })
      VALIDATE_RENDER -> idle when (and (not @entity.json) (> (array/len @entity.errors) 0) (= (object/get (array/first @entity.errors) "code" "") "FILE_READ_ERROR"))
        (emit VALIDATE_ANSWERED { status: 500, body: (str/concat "Validating schema: " @entity.file), stderr: (str/concat "Error: " (str/replace (object/get (array/first @entity.errors) "message" "") "Failed to read schema file: " "")) })
      ;; the line and suggestion defaults never fire: each is read only after object/has
      VALIDATE_RENDER -> idle when (and (not @entity.json) (> (array/len @entity.errors) 0) (!= (object/get (array/first @entity.errors) "code" "") "FILE_READ_ERROR"))
        (emit VALIDATE_ANSWERED { status: 500, body: (str/concat "Validating schema: " @entity.file), stderr: (str/join (array/concat ["Schema validation errors:"] (array/map @entity.errors (fn f (str/concat "  ❌ " (if (= (object/get @f "code" "") "") "" (str/concat "[" (object/get @f "code") "] " (object/get @f "path" "") ": ")) (object/get @f "message") (if (object/has @f "line") (str/concat " @ " (object/get @f "line" 0) ":" (object/get @f "column" 0)) "") (if (object/has @f "suggestion") (str/concat " 💡 " (object/get @f "suggestion" "")) "")))) [(str/concat "Error: Schema validation failed with " (array/len @entity.errors) " error(s)")]) "\n") })
      ;; the line and suggestion defaults never fire: each is read only after object/has
      VALIDATE_RENDER -> idle when (and (not @entity.json) (= (array/len @entity.errors) 0) (> (array/len @entity.warnings) 0))
        (emit VALIDATE_ANSWERED { status: (if @entity.denyWarnings 500 200), body: (str/join (array/concat [(str/concat "Validating schema: " @entity.file), "Schema validation warnings:"] (array/map @entity.warnings (fn f (str/concat "  ⚠️  " (if (= (object/get @f "code" "") "") "" (str/concat "[" (object/get @f "code") "] " (object/get @f "path" "") ": ")) (object/get @f "message") (if (object/has @f "line") (str/concat " @ " (object/get @f "line" 0) ":" (object/get @f "column" 0)) "") (if (object/has @f "suggestion") (str/concat " 💡 " (object/get @f "suggestion" "")) ""))))) "\n"), stderr: (if @entity.denyWarnings (str/concat "Error: Schema validation failed: " (array/len @entity.warnings) " warning(s) under --deny-warnings") "") })
      VALIDATE_RENDER -> idle when (and (not @entity.json) (= (array/len @entity.errors) 0) (= (array/len @entity.warnings) 0))
        (emit VALIDATE_ANSWERED { status: 200, body: (str/concat "Validating schema: " @entity.file) })
    }

    emits {
      VALIDATE_ANSWERED -> external {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      VALIDATE_REFUSED {
        error : string!
      }
        @description "The host could not run the validation."
        @tier "internal"
      VALIDATE_CHECKED {
        result : ValidationReport!
      }
        @description "program/validate: the report orb validate --json prints, the lint findings placed and positioned in it."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the composed std-orb-lint-engine to lint the file; it answers LINT_COLLECTED."
        @tier "internal"
      VALIDATE_RENDER { }
        @description "Internal: the report holds the core and lint findings, print it."
        @tier "internal"
    }

    listens {
      VALIDATE_START {
        file : string!
        path : string!
        cwd : string!
        json : boolean!
        denyWarnings : boolean!
        finalProgram : boolean!
        hasPatterns : boolean!
        patterns : string!
        hasServices : boolean!
        services : string!
      }
        @description "Validate the program at the absolute path."
      OrbValidate.VALIDATE_START -> VALIDATE_START
      LINT_COLLECTED { findings : [OrbFinding]!  found : [RuleFound]!  final : [OrbFinding]! }
        @description "std-orb-lint-engine's LINT_COLLECTED: every rule's findings for the file."
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "std-orb-lint-input's LINT_INPUT_UNREAD: the file could not be read or lowered."
      Lint.OrbLintEngine.LINT_COLLECTED -> LINT_COLLECTED
      Lint.OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
    config {
      cascadeRule : string = "orbital-ref-closure"
        @label "Cascade-root rule"
        @description "The lint rule whose findings are import roots: the compiler findings under an orbital such a finding names are the same cause restated, so they are dropped and counted on the root."
      codes : ValidateCodes = { lintInputUnread: { code: "ORB_LINT_INPUT_UNREAD", category: "lint", description: "A lint input file could not be read or lowered, so the lint rules did not run" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  page boot as OrbValidatePage -> OrbValidate, ArgsCli, ValidateEngine
}
