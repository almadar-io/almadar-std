app std-orb-lint-page-unreachable [
  version: "1.0.0",
  inbound: ["cli-lint-page-unreachable"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-page-unreachable — the `orb lint page-unreachable <file>` command, the port of the inline-page half of validate_page_reachability. It lowers the file with program/read and reports ORB_PAGE_UNREACHABLE for every route page (a page with a protocol is an endpoint and is skipped) that nothing can route a viewer to: not the boot page (the first route page in declaration order), not a parameterized page (any :name segment), not the literal path of an href or navigatesTo value (a str/concat of literals counts) in a trait config default or a render-ui payload, not the target or static str/concat prefix of a navigate effect anywhere in a trait, not the app signIn route, and not a labelled page when the program mentions @pages. Findings carry the page location orbitals[i].pages[j] (status 500, exit 1). Clean answers `lint page-unreachable: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500. A `uses lazy` page (the program's lazyPages[], each with its path and the links its own behavior carries) is reached by an href, a navigate target or a navigate prefix longer than one character; every reached lazy page adds its links to the hrefs until nothing grows, so an unreached lazy page's links reach nothing, and a parameterized lazy page is skipped. An unreached one reports at lazyPages[k]."
]
uses Spec from "almadar-std/lint-page-unreachable"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type ReachEntry = { loc : string, path : string, labelled : boolean }
type ReachVal = string | number | boolean | [ReachVal?] | Map string ReachVal?
type ReachPageTrait = { ref : string?, name : string? }
type ReachPage = { path : string, protocol : string, label : string, isNotFound : boolean, traits : [ReachPageTrait]? }
type ReachField = { default : ReachVal? }
type ReachStrings = [string]
type ReachPart = { ok : boolean!, v : string! }
type ReachCall = { path : string!, node : ReachVal! }
type ReachIndex = Map string [ReachCall]
type ReachEffect = [ReachVal?]
type ReachEffects = { effects : [ReachVal?] }
type ReachMachine = { transitions : [ReachEffects] }
type ReachTrait = { stateMachine : ReachMachine, ticks : [ReachEffects], config : Map string ReachField }
type ReachOrbital = { traits : [ReachTrait], config : Map string ReachField, pages : [ReachPage] }
type ReachSite = { signIn : string }
type ReachLazy = { path : string, links : [string]? }
type ReachProgram = { site : ReachSite, config : Map string ReachField, orbitals : [ReachOrbital], lazyPages : [ReachLazy]? }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintPageUnreachableCodes = { lintIndexMissing : LintCodeDecl , pageUnreachable : LintCodeDecl }

orbital OrbLintPageUnreachableOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintPageUnreachableRun [runtime] {
    iHeads : Map string [string] = {}
    iRoots : Map string [string] = {}
    uKeys : Map string [string] = {}
    indexHeard : boolean = false
    indexScope : string = ""
    unitsHeard : boolean = false
    unitsScope : string = ""
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintPageUnreachable -> OrbLintPageUnreachableRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      INDEX_HEARD -> ready
        (set @entity.iHeads @payload.heads)
        (set @entity.iRoots @payload.roots)
        (set @entity.indexHeard true)
        (set @entity.indexScope @payload.scope)
      UNITS_HEARD -> ready
        (set @entity.uKeys @payload.keys)
        (set @entity.unitsHeard true)
        (set @entity.unitsScope @payload.scope)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (and @entity.indexHeard (= @entity.indexScope @payload.scope) @entity.unitsHeard (= @entity.unitsScope @payload.scope))
(let ((orbitals (object/get @payload.program "orbitals" [])) (appCfg (object/get @payload.program "config" {})) (signIn (object/get (object/get @payload.program "site" {}) "signIn" "")) (nostr : [string] []) (hrefTr : Map string boolean (default (object/fromEntries (array/map (array/filter (object/keys @entity.uKeys) (fn uk (array/some ["href", "navigatesTo"] (fn h (array/includes (object/get @entity.uKeys @uk @nostr) @h))))) (fn uk [(str/join (array/take (str/split @uk "-") 2) "-"), true]))) {})))
          (let ((trx (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((trl (object/get (array/nth @orbitals @oi) "traits" []))) (array/flatten (array/map (array/range 0 (array/len @trl)) (fn ti (let ((tk (str/concat @oi "-" @ti)) (t (array/nth @trl @ti))) (if (or (not (object/has @t "stateMachine")) (array/includes (object/get @entity.iHeads @tk @nostr) "navigate") (array/includes (object/get @entity.iRoots @tk @nostr) (quote "@pages")) (object/get @hrefTr @tk false)) [{ oi: @oi, nm: (object/get @t "name" ""), t: @t }] [])))))))))))
            (let ((trs (array/map @trx (fn x (object/get @x "t")))))
              (let ((effects (array/concat
                                (array/flatten (array/map @trs (fn tr (array/flatten (array/map (object/get (object/get @tr "stateMachine" {}) "transitions" []) (fn t (array/map (array/filter (object/get @t "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))
                                (array/flatten (array/map @trs (fn tr (array/flatten (array/map (object/get @tr "ticks" []) (fn k (array/map (array/filter (object/get @k "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))))
                    (transEffects (array/flatten (array/map @trs (fn tr (array/flatten (array/map (object/get (object/get @tr "stateMachine" {}) "transitions" []) (fn t (array/map (array/filter (object/get @t "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))))
                (let ((trCfg (array/map @trs (fn tr (array/filter (array/map (object/values (object/get @tr "config" {})) (fn f (object/get @f "default" null))) (fn v (!= @v null))))))
                      (orbCfg (array/map @orbitals (fn orb (array/filter (array/map (object/values (object/get @orb "config" {})) (fn f (object/get @f "default" null))) (fn v (!= @v null))))))
                      (appCfgDefaults (array/filter (array/map (object/values @appCfg) (fn f (object/get @f "default" null))) (fn v (!= @v null))))
                      (trLinks (array/map @trx (fn x (let ((tr (object/get @x "t")))
                        (let ((cfgDefs : Map string string (object/fromEntries (array/flatten (array/map [@appCfg, (object/get (default (array/nth @orbitals (object/get @x "oi")) {}) "config" {}), (object/get @tr "config" {})] (fn cm (array/flatten (array/map (object/keys @cm) (fn ck (let ((dv (object/get (object/get @cm @ck) "default" null))) (if (validate/string @dv) [[@ck, @dv]] [])))))))))))
                        (let ((cfgs (array/filter (array/map (object/values (object/get @tr "config" {})) (fn f (object/get @f "default" null))) (fn v (!= @v null))))
                              (pays (array/filter (array/map (array/filter (array/map (array/filter (array/concat
                                        (array/flatten (array/map (object/get (object/get @tr "stateMachine" {}) "transitions" []) (fn t (object/get @t "effects" []))))
                                        (array/flatten (array/map (object/get @tr "ticks" []) (fn k (object/get @k "effects" []))))) (fn r (not (validate/object @r)))) (fn x (if (validate/array @x) (default (as @x ReachEffect) []) []))) (fn e (and (validate/array @e) (> (array/len @e) 2) (validate/string (array/first @e)) (= (array/first @e) "render-ui")))) (fn e (array/nth @e 2))) (fn v (!= @v null)))))
                          (default (tree/fold { cfg: @cfgs, pay: @pays } (fn (n kids)
                                  (array/concat
                                    (if (and (validate/object @n) (not (validate/array @n)))
                                      (array/flatten (array/map ["href" "navigatesTo"] (fn k
                                        (let ((hv (object/get @n @k null)))
                                          (let ((hvs (if (and (validate/array @hv) (= (array/len @hv) 4) (= (array/first @hv) "if")) [(array/nth @hv 2) (array/nth @hv 3)] [@hv])))
                                            (array/flatten (array/map @hvs (fn c
                                              (if (and (validate/string @c) (!= @c "") (not (str/startsWith @c (quote "@"))))
                                                [@c]
                                                (let ((parts (if (validate/array @c) (as @c ReachStrings) null)))
                                                  (let ((rps : [ReachPart] (if (and (!= @parts null) (> (array/len @parts) 1) (= (array/first @parts) "str/concat"))
                                                                (array/map (array/drop @parts 1) (fn p (if (str/startsWith @p (quote "@config."))
                                                                  (let ((cs (str/split @p "."))) (if (and (= (array/len @cs) 2) (object/has @cfgDefs (default (array/nth @cs 1) ""))) { ok: true, v: (object/get @cfgDefs (default (array/nth @cs 1) "") "") } { ok: false, v: "" }))
                                                                  (if (str/startsWith @p (quote "@")) { ok: false, v: "" } { ok: true, v: @p }))))
                                                                [{ ok: false, v: "" }])))
                                                    (let ((joined (str/join (array/map @rps (fn r (object/get @r "v"))) "")))
                                                      (if (and (!= @parts null) (array/every @rps (fn r (object/get @r "ok"))) (!= @joined ""))
                                                        [@joined]
                                                        @nostr)))))))))))))
                                      [])
                                    (if (validate/array @n) (array/flatten (array/filter @kids (fn r (!= @r null)))) (if (validate/object @n) (array/flatten (array/filter (object/values @kids) (fn r (!= @r null)))) [])))) ReachVal) [])))))))
                      (navs (array/concat
                              (if (= @signIn "") [] [@signIn])
                              (array/flatten (array/map @effects (fn v
                                (array/flatten (array/map (object/get (default (as (tree/index @v ["navigate"]) ReachIndex) {}) "navigate" []) (fn c
                                  (let ((n (default (as (object/get @c "node") ReachEffect) [])))
                                    (if (> (array/len @n) 1)
                                      (let ((tg (array/nth @n 1)))
                                        (if (validate/string @tg)
                                          [@tg]
                                          (if (and (validate/array @tg) (> (array/len @tg) 1) (= (array/first @tg) "str/concat") (validate/string (array/nth @tg 1)))
                                            [(array/nth @tg 1)]
                                            [])))
                                      []))))))))))
                      (sigil (= (tree/fold { app: @appCfgDefaults, orb: @orbCfg, tr: @trCfg, eff: @transEffects } (fn (n kids)
                                      (if (validate/string @n)
                                        (= @n (quote "@pages"))
                                        (if (validate/array @n)
                                          (array/some @kids (fn r (= @r true)))
                                          (if (validate/object @n) (array/some (object/values @kids) (fn r (= @r true))) false)))) ReachVal) true)))
                  (let ((entries (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                                    (let ((pgs (object/get (array/nth @orbitals @oi) "pages" [])))
                                      (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                                        (let ((pg (array/nth @pgs @pj)))
                                          (if (and (object/has @pg "path") (not (object/has @pg "protocol")) (!= (object/get @pg "isNotFound" false) true))
                                            [{ loc: (str/concat "orbitals[" @oi "].pages[" @pj "]"), path: (object/get @pg "path" ""), labelled: (object/has @pg "label"), oi: @oi, refs: (array/map (object/get @pg "traits" []) (fn r (default (as (object/get @r "ref" (object/get @r "name" "")) string) ""))) }]
                                            [])))))))))))
                    (let ((attributed (default (object/fromEntries (array/flatten (array/map @entries (fn en (array/map (object/get @en "refs") (fn nm [(str/concat (object/get @en "oi") "|" @nm) true])))))) {}))
                          (lzs (object/get @payload.program "lazyPages" [])))
                      (let ((globalLinks (array/flatten (array/map (array/range 0 (array/len @trx)) (fn i (let ((x (array/nth @trx @i))) (if (object/has @attributed (str/concat (object/get @x "oi") "|" (object/get @x "nm"))) [] (array/nth @trLinks @i)))))))
                            (items (array/concat
                              (array/map (array/range 0 (array/len @entries)) (fn n
                                (let ((en (array/nth @entries @n)))
                                  (let ((pth (object/get @en "path")) (isParam (array/some (str/split (object/get @en "path") "/") (fn seg (str/startsWith @seg ":")))))
                                    { loc: (object/get @en "loc"), path: @pth, lazy: false, skip: @isParam, root: (or (= @n 0) @isParam),
                                      pre: (or (and @sigil (object/get @en "labelled")) (array/includes @navs @pth) (array/some @navs (fn tg (and (> (str/len @tg) 1) (str/startsWith @pth @tg))))),
                                      links: (array/flatten (array/map (array/range 0 (array/len @trx)) (fn i (let ((x (array/nth @trx @i))) (if (and (= (object/get @x "oi") (object/get @en "oi")) (array/includes (object/get @en "refs") (object/get @x "nm"))) (array/nth @trLinks @i) []))))) }))))
                              (array/map (array/range 0 (array/len @lzs)) (fn k
                                (let ((lz (array/nth @lzs @k)))
                                  (let ((lpth (object/get @lz "path" "")))
                                    { loc: (str/concat "lazyPages[" @k "]"), path: @lpth, lazy: true, skip: (array/some (str/split @lpth "/") (fn seg (str/startsWith @seg ":"))), root: false,
                                      pre: (or (array/includes @navs @lpth) (array/some @navs (fn tg (and (> (str/len @tg) 1) (str/startsWith @lpth @tg))))),
                                      links: (object/get @lz "links" []) }))))))) 
                        (let ((reached (array/reduce (array/range 0 (+ (array/len @items) 1))
                                          (array/unique (array/concat @globalLinks (array/flatten (array/map (array/filter @items (fn it (object/get @it "root"))) (fn it (object/get @it "links"))))))
                                          (fn (acc pass)
                                            (array/unique (array/concat @acc (array/flatten (array/map
                                              (array/filter @items (fn it (and (not (object/get @it "root")) (or (object/get @it "pre") (array/includes @acc (object/get @it "path"))))))
                                              (fn it (object/get @it "links"))))))))))
                          (array/flatten (array/map @items (fn it
                            (if (or (object/get @it "skip") (object/get @it "root") (object/get @it "pre") (array/includes @reached (object/get @it "path")))
                              []
                              [{ code: @config.codes.pageUnreachable.code, path: (object/get @it "loc"), message: (str/concat "page '" (object/get @it "path") "' is declared but appears in no link, navItems entry or navigate effect"), suggestion: (str/concat "add an href to a nav/footer/link component, or a navigate effect, targeting '" (object/get @it "path") "', or remove the " (if (object/get @it "lazy") "`uses lazy` page" "page") " if nothing should reach it"), severity: "error" }])))))))))))))
[{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without LINT_INDEX or LINT_UNITS, so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_INDEX or LINT_UNITS before LINT_INPUT; this rule did not hear it", severity: "error" }]))
        (set @entity.indexHeard false)
        (set @entity.unitsHeard false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "page-unreachable", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : ReachProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads and binding roots each inline trait and transition effect list uses."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      UNITS_HEARD { scope : string!  keys : Map string [string]!  guardKeys : Map string [string]!  emitStr : [string]!  guardEmitStr : [string]!  itemRoots : Map string [string]!  guardItemRoots : Map string [string]! }
        @description "std-orb-lint-input's LINT_UNITS: the object keys, string emits and @item/@index roots of every transition, tick and config unit."
      OrbLintInput.LINT_UNITS -> UNITS_HEARD
    }
    config {
      codes : LintPageUnreachableCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without a shared program fact the rule reads (the structural index, sites, units, embeds or entities), so the rule cannot check the program" }, pageUnreachable: { code: "ORB_PAGE_UNREACHABLE", category: "page", description: "A page is declared but appears in no link, navItems entry or navigate effect" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintPageUnreachableCli -> OrbLintPageUnreachableRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-unreachable <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-unreachable <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "page-unreachable") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint page-unreachable: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "page-unreachable") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint page-unreachable: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-page-unreachable" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint page-unreachable` with its arguments and working directory."
        @synonyms "orb lint page-unreachable"
      OrbLintPageUnreachable.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPageUnreachableCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPageUnreachableOrbitalStart -> OrbLintPageUnreachable, OrbLintPageUnreachableCli, OrbLintInput, Packs, Versions
}
