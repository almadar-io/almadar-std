app std-orb-lint-tick-requires-runtime [
  version: "1.0.0",
  inbound: ["cli-lint-tick-requires-runtime"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-tick-requires-runtime — the `orb lint tick-requires-runtime <file>` command, the port of ORB_TICK_REQUIRES_RUNTIME (entity_mutation.rs validate_trait_tick_guards). It lowers the file with program/read and, for every inline trait that declares at least one non-cron tick (a numeric interval, or a string that is not a valid 5-field cron expression, as `orbital_core_base::cron::is_valid_cron_expression` decides) and is linked to a persistent entity (no persistence mode, or `persistent`; the last entity of that name in the program wins, auxiliary entities included), reports the trait once at `...ticks` with the Rust message and suggestion (status 500, exit 1). It also reports ORB_TICK_ASYNC_EFFECT for each effect of a non-cron tick whose tree calls an operator of the registry's std-llm category (llm/call-tools, llm/compact, llm/embed, llm/generate, llm/switch, llm/token-count), found with tree/fold, at `...ticks[i].effects[j]`. Clean answers `lint tick-requires-runtime: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-tick-requires-runtime"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type TickShape = string | number | boolean | [TickShape?] | Map string TickShape?
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type TickInterval = string | number
type TickDecl = { name : string, interval : TickInterval, effects : [TickShape?] }
type TickEntity = { name : string, persistence : string }
type TickTrait = { name : string, linkedEntity : string, ticks : [TickDecl] }
type TickOrbital = { name : string, entity : TickEntity, auxiliaryEntities : [TickEntity], traits : [TickTrait] }
type TickProgram = { orbitals : [TickOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintTickRequiresRuntimeCodes = { tickRequiresRuntime : LintCodeDecl , lintNodeUnchecked : LintCodeDecl , tickAsyncEffect : LintCodeDecl }

orbital OrbLintTickRequiresRuntimeOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintTickRequiresRuntimeRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintTickRequiresRuntime -> OrbLintTickRequiresRuntimeRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])) (llm ["llm/call-tools" "llm/compact" "llm/embed" "llm/generate" "llm/switch" "llm/token-count"]))
          (let ((ents (array/flatten (array/map @orbitals (fn o (array/filter (array/concat (array/append [] (object/get @o "entity" null)) (object/get @o "auxiliaryEntities" [])) (fn e (validate/object @e))))))))
            (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
              (let ((orb (array/nth @orbitals @oi)))
                (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                  (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                    (let ((ticks (object/get @td "ticks" [])) (linked (object/get @td "linkedEntity" "")) (tn (object/get @td "name" "")) (where (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]")))
                      (let ((tks (array/map (array/range 0 (array/len @ticks)) (fn i (let ((k (array/nth @ticks @i)) (sx (let ((iv (object/get (array/nth @ticks @i) "interval" ""))) (if (validate/string @iv) @iv "")))) { k: @k, i: @i, nc: (if (validate/number (object/get @k "interval" null)) true (not (let ((fs (str/split (str/replace-pattern (str/trim @sx) "\\s+" " ") " "))) (and (= (array/len @fs) 5) (array/every @fs (fn fl (array/every (str/split @fl ",") (fn pt (validate/pattern @pt "^(\\*|[0-9]+|[0-9]+-[0-9]+|(\\*|[0-9]+)/[0-9]*[1-9][0-9]*)$"))))))))) }))))) 
                        (array/concat
                          (if (or (= (array/len @ticks) 0) (not (array/some @tks (fn t (object/get @t "nc")))) (= @linked ""))
                            []
                            (let ((owners (array/filter @ents (fn e (= (object/get @e "name" "") @linked)))))
                              (if (or (= (array/len @owners) 0) (!= (object/get (array/last @owners) "persistence" "persistent") "persistent"))
                                []
                                [{ code: @config.codes.tickRequiresRuntime.code, path: (str/concat @where ".ticks"), message: (str/concat "trait \"" @tn "\" runs a non-cron tick against entity \"" @linked "\", which is Persistent — a persistent entity mutated on every tick is usually meant to be [runtime]"), suggestion: (str/concat "Mark entity \"" @linked "\" [runtime], or switch the tick to a Cron interval if it's a server-scheduled job"), severity: "error" }])))
                          (array/flatten (array/map @tks (fn t
                            (let ((tk (object/get @t "k")) (i (object/get @t "i")))
                              (if (not (object/get @t "nc"))
                                []
                                (array/flatten (array/map (array/range 0 (array/len (object/get @tk "effects" []))) (fn j
                                  (let ((ef (array/nth (object/get @tk "effects" []) @j)))
                                    (let ((fd (tree/fold @ef (fn (n k)
                                      (if (validate/array @n)
                                        (array/concat
                                          (if (validate/string (array/nth @n 0)) (if (array/includes @llm (array/nth @n 0)) [(array/nth @n 0)] []) [])
                                          (array/flatten (array/filter @k (fn r (validate/array @r)))))
                                        (if (validate/object @n)
                                          (array/flatten (array/filter (object/values @k) (fn r (validate/array @r))))
                                          []))) TickShape))) (if (= @fd null) (let ((up (str/concat @where ".ticks[" @i "].effects[" @j "]"))) [{ code: @config.codes.lintNodeUnchecked.code, path: @up, message: (str/concat @payload.file ": schema node at " @up " is not a TickShape; this rule could not check it"), suggestion: "", severity: "error" }]) (let ((op (if (> (array/len @fd) 0) (let ((o0 (array/first @fd))) (if (validate/string @o0) @o0 "")) ""))) (if (= @op "")
                                        []
                                        [{ code: @config.codes.tickAsyncEffect.code, path: (str/concat @where ".ticks[" @i "].effects[" @j "]"), message: (str/concat "trait \"" @tn "\" tick '" (object/get @tk "name" "") "' calls server-async operator '" @op "' on a non-cron interval — repeated per-tick agent/LLM calls can pile up"), suggestion: "Trigger the async call from an explicit event-driven transition, or use a Cron-scheduled tick", severity: "error" }])))))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "tick-requires-runtime", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : TickProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintTickRequiresRuntimeCodes = { tickRequiresRuntime: { code: "ORB_TICK_REQUIRES_RUNTIME", category: "trait", description: "A non-cron tick mutates a persistent entity, which should usually be runtime" }, lintNodeUnchecked: { code: "LINT_NODE_UNCHECKED", category: "lint", description: "A lint rule met a schema node of an unexpected shape and could not check it" }, tickAsyncEffect: { code: "ORB_TICK_ASYNC_EFFECT", category: "tick", description: "A tick calls a server-async operator, which ticks cannot run" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintTickRequiresRuntimeCli -> OrbLintTickRequiresRuntimeRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint tick-requires-runtime <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "tick-requires-runtime") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint tick-requires-runtime: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "tick-requires-runtime") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint tick-requires-runtime: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-tick-requires-runtime" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint tick-requires-runtime` with its arguments and working directory."
        @synonyms "orb lint tick-requires-runtime"
      OrbLintTickRequiresRuntime.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintTickRequiresRuntimeCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintTickRequiresRuntimeOrbitalStart -> OrbLintTickRequiresRuntime, OrbLintTickRequiresRuntimeCli, OrbLintInput, Packs, Versions
}
