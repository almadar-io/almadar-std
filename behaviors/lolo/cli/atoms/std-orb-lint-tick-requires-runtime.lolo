app std-orb-lint-tick-requires-runtime [
  version: "1.0.0",
  inbound: ["cli-lint-tick-requires-runtime"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-tick-requires-runtime — the `orb lint tick-requires-runtime <file>` command, the port of ORB_TICK_REQUIRES_RUNTIME (entity_mutation.rs validate_trait_tick_guards). It lowers the file with program/read and, for every inline trait that declares at least one non-cron tick (a numeric interval; the lowerer keeps a cron schedule as a string and refuses a malformed one, so a string interval is cron) and is linked to a persistent entity (no persistence mode, or `persistent`; the last entity of that name in the program wins, auxiliary entities included), reports the trait once at `...ticks` with the Rust message and suggestion (status 500, exit 1). The ORB_TICK_ASYNC_EFFECT half walks the tick effect tree and is not part of this rule. Clean answers `lint tick-requires-runtime: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-tick-requires-runtime"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintTickRequiresRuntimeOrbital {
  entity OrbLintTickRequiresRuntimeRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintTickRequiresRuntime -> OrbLintTickRequiresRuntimeRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "tick-requires-runtime", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals" [])))
          (let ((ents (array/flatten (array/map @orbitals (fn o (array/filter (array/concat (array/append [] (object/get @o "entity" null)) (object/get @o "auxiliaryEntities" [])) (fn e (validate/object @e))))))))
            (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
              (let ((orb (array/nth @orbitals @oi)))
                (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                  (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                    (let ((ticks (object/get @td "ticks" [])) (linked (object/get @td "linkedEntity" "")))
                      (if (or (= (array/len @ticks) 0) (not (array/some @ticks (fn k (validate/number (object/get @k "interval" null))))) (= @linked ""))
                        []
                        (let ((owners (array/filter @ents (fn e (= (object/get @e "name" "") @linked)))))
                          (if (or (= (array/len @owners) 0) (!= (object/get (array/last @owners) "persistence" "persistent") "persistent"))
                            []
                            (let ((tn (object/get @td "name" "")) (where (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]")))
                              [{ code: "ORB_TICK_REQUIRES_RUNTIME", path: (str/concat @where ".ticks"), message: (str/concat "trait \"" @tn "\" runs a non-cron tick against entity \"" @linked "\", which is Persistent — a persistent entity mutated on every tick is usually meant to be [runtime]"), suggestion: (str/concat "Mark entity \"" @linked "\" [runtime], or switch the tick to a Cron interval if it's a server-scheduled job"), severity: "error" }]))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "tick-requires-runtime" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintTickRequiresRuntimeCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintTickRequiresRuntimeCli -> OrbLintTickRequiresRuntimeRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint tick-requires-runtime <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "tick-requires-runtime") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint tick-requires-runtime: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "tick-requires-runtime") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "tick-requires-runtime")
        (emit LINT_ANSWERED { status: 500, body: "lint tick-requires-runtime: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-tick-requires-runtime" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint tick-requires-runtime` with its arguments and working directory."
        @synonyms "orb lint tick-requires-runtime"
      OrbLintTickRequiresRuntime.LINT_FOUND -> LINT_FOUND
      OrbLintTickRequiresRuntime.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-tick-requires-runtime" as OrbLintTickRequiresRuntimePage -> OrbLintTickRequiresRuntime, OrbLintTickRequiresRuntimeCli
}
