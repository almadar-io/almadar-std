app std-verify-walk [
  version: "1.0.0",
  inbound: ["cli-verify-walk"],
  fs: { cwd: "**/*.lolo": [read] },
  description: "std-verify-walk — the `orb verify-walk <program.lolo>` command, the L1 walk as a std program. It reads the program (os/read-file, program/read), asks std-machine for the transition rows (MACHINE_READ), then plays the plannable rows in ONE program/step call (each from its own state), so there is no per-row cascade. A payload is built only from declared values (the first listed value of each slot); a row with a required slot that declares none is `unplanned` and lists the missing slots. Verdicts: pass (fired and landed in its target or a sibling target of the same group), fail, guard-blocked (a guard blocked the payload; not passed), unplanned. One line per row, then `N passed, M failed, U unplanned, G guard-blocked`; status 200 (exit 0) when none failed, else 500 (exit 1); usage status 400 (exit 2); every failed read, parse or step answers 500 with its error. Transitions only: no render probe, no wiring checks, imports unresolved."
]
uses Spec from "almadar-std/verify-walk"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type VerifyRow = { trait : string!, from : string!, event : string!, to : string!, verdict : string! }
type WalkProgram = { orbitals : [orbital] }
type WalkSlot = { name : string!, type : string!, required : boolean!, values : [string], entity : string }
type WalkPlayed = { trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, targets : [string]!, result : WalkResult! }
type WalkResult = { transitionFired : boolean!, state : WalkAfter! }
type WalkAfter = { before : string, after : string }
type WalkNote = { trait : string!, from : string!, event : string!, missing : string! }
type WalkMachineRow = { orbital : string!, trait : string!, from : string!, event : string!, to : string!, guarded : boolean!, payload : [WalkSlot]! }

orbital VerifyWalkOrbital {
  uses Machine from "std/behaviors/std-machine"

  entity VerifyReport [runtime] {
    id : string!
    rows : [VerifyRow]! = []
    passed : number! = 0
    failed : number! = 0
    unplanned : number! = 0
    guardBlocked : number! = 0
    notes : [WalkNote] = []
    program : string = ""
    machineRows : [WalkMachineRow] = []
  }

  trait WalkMachine = Machine.traits.Machine {
    listens {
      VerifyWalk.WALK_MACHINE_READ -> MACHINE_READ
    }
  }

  trait VerifyWalk -> VerifyReport [integration] {
    initial: ready

    state ready {
      INIT -> ready
      VERIFY_WALK_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit VERIFY_WALK_ANSWERED { status: 400, body: "usage: orb verify-walk <program.lolo>" })
      VERIFY_WALK_CALLED -> reading when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (os/read-file { anchor: "cwd" path: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) } { key: "file" emit: { success: WALK_FILE_READ, failure: WALK_FAILED } })
    }

    state reading {
      INIT -> reading
      WALK_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { key: "program" emit: { success: WALK_PROGRAM, failure: WALK_FAILED } })
      WALK_PROGRAM -> machine
        (set @entity.program (json/stringify @payload.result))
        (emit WALK_MACHINE_READ { program: @payload.result })
      WALK_FAILED -> ready
        (emit VERIFY_WALK_ANSWERED { status: 500, body: (str/concat "verify-walk: " @payload.error) })
    }

    state machine {
      INIT -> machine
      WALK_MACHINE_ANSWERED -> ready when (= (array/len @payload.rows) 0)
        (emit VERIFY_WALK_ANSWERED { status: 500, body: "verify-walk: the program has no transitions" })
      WALK_MACHINE_ANSWERED -> stepping when (> (array/len @payload.rows) 0)
        (set @entity.machineRows @payload.rows)
        (set @entity.notes (array/map (array/filter @payload.rows (fn r (> (array/len (array/filter (object/get @r "payload") (fn s (and (object/get @s "required") (= (array/len (object/get @s "values" [])) 0))))) 0)))
          (fn r { trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"),
                  missing: (str/join (array/map (array/filter (object/get @r "payload") (fn s (and (object/get @s "required") (= (array/len (object/get @s "values" [])) 0)))) (fn s (object/get @s "name"))) ",") })))
        (emit WALK_PLAY { rows: (array/filter @payload.rows (fn r (= (array/len (array/filter (object/get @r "payload") (fn s (and (object/get @s "required") (= (array/len (object/get @s "values" [])) 0))))) 0))) })
      WALK_FAILED -> ready
        (emit VERIFY_WALK_ANSWERED { status: 500, body: (str/concat "verify-walk: " @payload.error) })
    }

    state stepping {
      INIT -> stepping
      WALK_PLAY -> stepping when (= (array/len @payload.rows) 0)
        (emit WALK_STEPPED { result: [] })
      WALK_PLAY -> stepping when (> (array/len @payload.rows) 0)
        (program/step (json/parse @entity.program WalkProgram) (array/map @payload.rows (fn r
          { orbital: (object/get @r "orbital"), trait: (object/get @r "trait"), from: (object/get @r "from"), event: (object/get @r "event"), to: (object/get @r "to"), guarded: (object/get @r "guarded"),
            targets: (array/map (array/filter @entity.machineRows (fn g (and (= (object/get @g "trait") (object/get @r "trait")) (= (object/get @g "from") (object/get @r "from")) (= (object/get @g "event") (object/get @r "event"))))) (fn g (object/get @g "to"))),
            payload: (array/reduce (array/filter (object/get @r "payload") (fn s (> (array/len (object/get @s "values" [])) 0))) {} (fn acc s
              (object/set @acc (object/get @s "name") (array/first (object/get @s "values")))))
          })) { key: "steps" emit: { success: WALK_STEPPED, failure: WALK_FAILED } })
      WALK_STEPPED -> ready
        (set @entity.rows (array/concat
          (array/map @payload.result (fn p
            { trait: (object/get @p "trait"), from: (object/get @p "from"), event: (object/get @p "event"), to: (object/get @p "to"),
              verdict: (if (and (object/get (object/get @p "result") "transitionFired") (array/includes (object/get @p "targets") (object/get (object/get (object/get @p "result") "state") "after"))) "pass"
                (if (and (not (object/get (object/get @p "result") "transitionFired")) (object/get @p "guarded")) "guard-blocked" "fail")) }))
          (array/map @entity.notes (fn n { trait: (object/get @n "trait"), from: (object/get @n "from"), event: (object/get @n "event"),
            to: (object/get (array/find @entity.machineRows (fn g (and (= (object/get @g "trait") (object/get @n "trait")) (= (object/get @g "from") (object/get @n "from")) (= (object/get @g "event") (object/get @n "event"))))) "to"),
            verdict: "unplanned" }))))
        (set @entity.failed (array/len (array/filter @entity.rows (fn r (= (object/get @r "verdict") "fail")))))
        (set @entity.passed (array/len (array/filter @entity.rows (fn r (= (object/get @r "verdict") "pass")))))
        (set @entity.unplanned (array/len (array/filter @entity.rows (fn r (= (object/get @r "verdict") "unplanned")))))
        (set @entity.guardBlocked (array/len (array/filter @entity.rows (fn r (= (object/get @r "verdict") "guard-blocked")))))
        (emit VERIFY_WALK_ANSWERED { status: (if (= @entity.failed 0) 200 500), body: (str/join (array/concat
          (array/map @entity.rows (fn r (str/concat (object/get @r "verdict") "  " (object/get @r "trait") " " (object/get @r "from") " --" (object/get @r "event") "--> " (object/get @r "to")
            (if (= (object/get @r "verdict") "unplanned") (str/concat "  missing: " (object/get (array/find @entity.notes (fn n (and (= (object/get @n "trait") (object/get @r "trait")) (= (object/get @n "from") (object/get @r "from")) (= (object/get @n "event") (object/get @r "event"))))) "missing")) ""))))
          [(str/concat @entity.passed " passed, " @entity.failed " failed, " @entity.unplanned " unplanned, " @entity.guardBlocked " guard-blocked")]) "\n") })
      WALK_FAILED -> ready
        (emit VERIFY_WALK_ANSWERED { status: 500, body: (str/concat "verify-walk: " @payload.error) })
    }

    emits {
      VERIFY_WALK_ANSWERED -> internal { status : number!  body : string! }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      WALK_MACHINE_READ -> external { program : SExpr! }
        @description "Ask std-machine for the program's transition rows."
        @tier "internal"
      WALK_FILE_READ { data : bytes! }
        @description "The program file read."
        @tier "internal"
      WALK_PROGRAM { result : SExpr! }
        @description "The program parsed."
        @tier "internal"
      WALK_PLAY { rows : [WalkMachineRow]! }
        @description "Plan done: the rows to play."
        @tier "internal"
      WALK_STEPPED { result : [WalkPlayed]! }
        @description "Every row played."
        @tier "internal"
      WALK_FAILED { error : string }
        @description "A read, parse or step that failed."
        @tier "internal"
    }

    listens {
      VERIFY_WALK_CALLED -> inbound "cli-verify-walk" answers VERIFY_WALK_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb verify-walk` with its arguments and working directory."
        @synonyms "orb verify-walk, L1 walk, play every transition"
      WalkMachine.MACHINE_ANSWERED -> WALK_MACHINE_ANSWERED
      WALK_MACHINE_ANSWERED { rows : [WalkMachineRow]! }
        @description "std-machine's MACHINE_ANSWERED."
    }
  }

  page "/verify-walk" as VerifyWalkPage -> VerifyWalk, WalkMachine
}
