app std-orb-lint-fetch-deliver [
  version: "1.0.0",
  inbound: ["cli-lint-fetch-deliver"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-fetch-deliver - the `orb lint fetch-deliver <file>` command, the port of entities/fetch_deliver.rs. Option checks: for every inline trait it finds each `(fetch X { … })` in the transition effects (through nested arrays, not through objects) whose options carry `deliver: \"ids\"`: with an `include` option it is ORB_FETCH_DELIVER_IDS_ENTITY_REFS, without a non-empty `emit.success` it is ORB_FETCH_DELIVER_IDS_NO_SUCCESS, each reported at `orbitals[i (O)].traits[j (T)].stateMachine.transitions[n].effects` with the include findings first, once per fetch. Reads: a fetch with `deliver: ids` and/or `total: none` and a success event restricts what the receiving arms may read of that event's payload. The receivers are the fetching trait's own arms of the success event plus the arms a `listens` route triggers (the route's source decided by the listen-address rules; a mapped payload carries only the mapped fields, the original delivery stays reachable as `@event.payload`). Every receiving guard, effect and route guard or mapping is walked with the operators' declared value-source slots (std-orb-lint-input's LINT_OPERATOR_WALK) and field projections: a binding or interpolated binding that reads inside a restricted `data` is ORB_FETCH_DELIVER_IDS_ROWS_READ, one that reads `totalCount` of a `total: none` fetch is ORB_FETCH_TOTAL_NONE_READ; the one allowed read of `data` is a whole `@payload.data` as a first-level prop of a `render-ui` argument. Clean answers `lint fetch-deliver: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-fetch-deliver"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type FdVal = string | number | boolean | [FdVal?] | Map string FdVal?
type FdListenSource = { kind : string, trait : string, traitId : string, orbital : string, orbitalId : string }
type FdListen = { event : string, triggers : string, guard : FdVal, payloadMapping : Map string FdVal?, source : FdListenSource }
type FdTransition = { event : string, guard : FdVal, effects : [FdVal?] }
type FdMachine = { transitions : [FdTransition] }
type FdTrait = { name : string, id : string, listens : [FdListen], stateMachine : FdMachine }
type FdOrbital = { name : string, id : string, traits : [FdTrait] }
type FdProgram = { orbitals : [FdOrbital] }
type FdHit = { k : number! }
type FdHitAt = { i : number!, k : number! }
type FdOptMap = Map string FdVal?
type FdStr = string
type FdGrp = { k : string!, li : number!, ev : string! }
type FdCall = { path : string!, node : [FdVal?]! }
type FdIndex = Map string [FdCall]
type FdHits = [FdHit]
type FdAnnE = { p : [string]!, i : boolean!, n : boolean! }
type FdTrans = { ev : string!, g : FdVal?, ef : [FdVal?]! }
type FdTr = { oi : number!, ti : number!, on : string!, oid : string!, tn : string!, tid : string!, tp : string!, ls : [FdListen]!, ts : [FdTrans]! }
type FdRs = { fi : number!, ev : string!, ids : boolean!, nt : boolean!, d : [FdAnnE]! }
type FdRt = { ri : number!, li : number!, lx : number!, trig : string!, lev : string!, g : FdVal?, hg : boolean!, mp : Map string FdVal?, hm : boolean! }
type FdCb = { li : number!, ev : string!, pl : [FdAnnE]!, og : [FdAnnE]! }
type FdItem = { rid : number!, ti : number!, kd : string!, nm : string!, bp : string!, arm : string!, e : FdVal?, cx : string!, pl : [FdAnnE]!, og : [FdAnnE]!, pf : string! }
type FdOp = { t : string!, f : string!, s : [string]! }
type FdTerm = { b : [FdAnnE]!, o : [FdOp]!, r : boolean!, s : boolean! }
type FdUse = { at : string!, w : string!, t : string!, m : string!, ai : boolean!, an : boolean!, ri : boolean!, rn : boolean! }
type FdRes = { a : [FdAnnE]!, u : [FdUse]! }
type FdRep = { at : string!, w : string!, t : string!, i : boolean!, n : boolean! }
type FdOut = { rid : number!, ti : number!, kd : string!, nm : string!, bp : string!, arm : string!, a : [FdAnnE]!, u : [FdRep]! }
type FdKu = { u : [FdUse]!, seg : string!, r : string! }
type FdOw = { has : boolean!, w : string!, t : string!, m : string!, xi : boolean! }
type FdSpec = { ts : [FdTerm]!, ku : [FdKu]!, ow : FdOw! }
type FdNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type FdExprItem = { e : FdVal?, eff : boolean! }
type WalkSlot = { kind : string!, args : [number] }
type WalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type FdProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintFetchDeliverCodes = { fetchDeliverIdsEntityRefs : LintCodeDecl , fetchDeliverIdsNoSuccess : LintCodeDecl , fetchDeliverIdsRowsRead : LintCodeDecl , fetchTotalNoneRead : LintCodeDecl }

orbital OrbLintFetchDeliverOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintFetchDeliverRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    projs : Map string FdProj = {}
    asked : [FdItem] = []
    base : [OrbFinding] = []
    tr : [FdTr] = []
    rs : [FdRs] = []
    rt : [FdRt] = []
    ro : [FdOut] = []
    cb : [FdCb] = []
  }

  trait OrbLintFetchDeliver -> OrbLintFetchDeliverRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_OPERATOR_WALK -> ready
        (set @entity.projs @payload.projections)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.base (let ((orbitals : [FdOrbital] (object/get @payload.program "orbitals" [])) (nOrb : FdOrbital { name: "", id: "", traits: [] }) (nMach : FdMachine { transitions: [] }) (nTrait : FdTrait { name: "", id: "", listens: [], stateMachine: @nMach }) (nTrn : FdTransition { event: "", guard: "", effects: [] }) (nMap : FdOptMap {}) (nIdx : FdIndex {})) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((o : FdOrbital (default (array/nth @orbitals @oi) @nOrb))) (let ((trs : [FdTrait] (object/get @o "traits" []))) (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti (let ((t : FdTrait (default (array/nth @trs @ti) @nTrait))) (let ((trans : [FdTransition] (object/get (object/get @t "stateMachine" @nMach) "transitions" []))) (let ((hits : [FdHitAt] (array/flatten (array/map (array/range 0 (array/len @trans)) (fn i (let ((tr : FdTransition (default (array/nth @trans @i) @nTrn)) (hs : [FdHit] (array/flatten (array/map (array/filter (let ((idx : FdIndex (default (as (tree/index (object/get @tr "effects" []) ["fetch"]) FdIndex) @nIdx))) (array/flatten (array/map (array/filter (object/get @idx "fetch" []) (fn cl (not (str/includes (object/get @cl "path") ".")))) (fn cl (array/map (array/slice (object/get @cl "node") 2 (array/len (object/get @cl "node"))) (fn a (default (as @a FdOptMap) @nMap))))))) (fn m (= (default (as (object/get @m "deliver") FdStr) "") "ids"))) (fn m (array/concat (if (object/has @m "include") [{ k: 1 }] []) (if (= (default (as (object/get (default (as (object/get @m "emit") FdOptMap) @nMap) "success") FdStr) "") "") [{ k: 2 }] []))))))) (array/map @hs (fn h { i: @i, k: (object/get @h "k") })))))))) (array/concat (array/map (array/filter @hits (fn h (= (object/get @h "k") 1))) (fn h { code: @config.codes.fetchDeliverIdsEntityRefs.code, path: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")].stateMachine.transitions[" (object/get @h "i") "].effects"), message: "`deliver: ids` with `include`: included relations are row content, and `ids` delivers no rows", suggestion: "Drop `include`, or drop `deliver: ids`", severity: "error" })) (array/map (array/filter @hits (fn h (= (object/get @h "k") 2))) (fn h { code: @config.codes.fetchDeliverIdsNoSuccess.code, path: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")].stateMachine.transitions[" (object/get @h "i") "].effects"), message: "`deliver: ids` without `emit.success`: the reference is only usable passed whole to a `render-ui` prop, and no event carries it", suggestion: "Declare `emit: { success: <Event> }` and pass `@payload.data` whole to a `render-ui` prop in that event's arm, or drop `deliver: ids`", severity: "error" }))))))))))))))))
        (set @entity.tr (let ((orbs (object/get @payload.program "orbitals" []))) (let ((orbs : [FdOrbital] (object/get @payload.program "orbitals" [])) (nOrb : FdOrbital { name: "", id: "", traits: [] }) (nMach : FdMachine { transitions: [] }) (nTrait : FdTrait { name: "", id: "", listens: [], stateMachine: @nMach })) (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi (let ((o : FdOrbital (default (array/nth @orbs @oi) @nOrb))) (let ((trs : [FdTrait] (object/get @o "traits" []))) (array/map (array/range 0 (array/len @trs)) (fn ti (let ((t : FdTrait (default (array/nth @trs @ti) @nTrait))) (let ((r : FdTr { oi: @oi, ti: @ti, on: (object/get @o "name" ""), oid: (object/get @o "id" ""), tn: (object/get @t "name" ""), tid: (object/get @t "id" ""), tp: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]"), ls: (object/get @t "listens" []), ts: (array/map (object/get (object/get @t "stateMachine" @nMach) "transitions" []) (fn x { ev: (object/get @x "event" ""), g: (object/get @x "guard"), ef: (object/get @x "effects" []) })) })) @r))))))))))))
        (emit FD_ROUTE { })
      FD_ROUTE -> ready
        (set @entity.rs (let ((nTr : FdTr { oi: 0, ti: 0, on: "", oid: "", tn: "", tid: "", tp: "", ls: [], ts: [] }) (nMap : FdOptMap {}) (nIdx : FdIndex {})) (array/flatten (array/map (array/range 0 (array/len @entity.tr)) (fn fi (let ((tf : FdTr (default (array/nth @entity.tr @fi) @nTr))) (let ((opts : [FdOptMap] (array/flatten (array/map (object/get @tf "ts") (fn x (let ((idx : FdIndex (default (as (tree/index (object/get @x "ef") ["fetch"]) FdIndex) @nIdx))) (array/flatten (array/map (array/filter (object/get @idx "fetch" []) (fn cl (not (str/includes (object/get @cl "path") ".")))) (fn cl (array/map (array/slice (object/get @cl "node") 2 (array/len (object/get @cl "node"))) (fn a (default (as @a FdOptMap) @nMap)))))))))))) (let ((ie : [string] (array/filter (array/map (array/filter @opts (fn m (= (default (as (object/get @m "deliver") FdStr) "") "ids"))) (fn m (default (as (object/get (default (as (object/get @m "emit") FdOptMap) @nMap) "success") FdStr) ""))) (fn x (!= @x "")))) (ne : [string] (array/filter (array/map (array/filter @opts (fn m (= (default (as (object/get @m "total") FdStr) "") "none"))) (fn m (default (as (object/get (default (as (object/get @m "emit") FdOptMap) @nMap) "success") FdStr) ""))) (fn x (!= @x ""))))) (array/map (array/sort (array/unique (array/concat @ie @ne))) (fn ev (let ((idsb (array/includes @ie @ev)) (ntb (array/includes @ne @ev))) (let ((r : FdRs { fi: @fi, ev: @ev, ids: @idsb, nt: @ntb, d: (array/concat (if @idsb [{ p: ["data"], i: true, n: false }] []) (if @ntb [{ p: ["totalCount"], i: false, n: true }] [])) })) @r))))))))))))
        (emit FD_ROUTE2 { })
      FD_ROUTE2 -> ready when (= (array/len @entity.rs) 0)
        (set @entity.findings @entity.base)
        (emit LINT_FINISH { })
      FD_ROUTE2 -> ready when (> (array/len @entity.rs) 0)
        (set @entity.rt (let ((nTr : FdTr { oi: 0, ti: 0, on: "", oid: "", tn: "", tid: "", tp: "", ls: [], ts: [] }) (nRs : FdRs { fi: 0, ev: "", ids: false, nt: false, d: [] }) (nSrc : FdListenSource { kind: "", trait: "", traitId: "", orbital: "", orbitalId: "" }) (nLis : FdListen { event: "", triggers: "", guard: "", payloadMapping: {}, source: @nSrc })) (array/flatten (array/map (array/range 0 (array/len @entity.rs)) (fn ri (let ((r : FdRs (default (array/nth @entity.rs @ri) @nRs))) (let ((f : FdTr (default (array/nth @entity.tr (object/get @r "fi")) @nTr))) (array/flatten (array/map (array/range 0 (array/len @entity.tr)) (fn li (let ((l : FdTr (default (array/nth @entity.tr @li) @nTr))) (array/flatten (array/map (array/range 0 (array/len (object/get @l "ls"))) (fn lx (let ((L : FdListen (default (array/nth (object/get @l "ls") @lx) @nLis))) (let ((parts : [string] (str/split (object/get @L "event" "") ".")) (hsrc (object/has @L "source")) (src : FdListenSource (default (object/get @L "source") @nSrc))) (let ((bare : string (if (or @hsrc (<= (array/len @parts) 1)) (object/get @L "event" "") (default (array/last @parts) ""))) (sk : FdListenSource (if @hsrc { kind: (object/get @src "kind" ""), trait: (object/get @src "trait" ""), traitId: (object/get @src "traitId" ""), orbital: (object/get @src "orbital" ""), orbitalId: (object/get @src "orbitalId" "") } (if (<= (array/len @parts) 1) { kind: "any", trait: "", traitId: "", orbital: "", orbitalId: "" } (if (= (array/len @parts) 2) (if (= (default (array/nth @parts 0) "") "*") { kind: "any", trait: "", traitId: "", orbital: "", orbitalId: "" } { kind: "trait", trait: (default (array/nth @parts 0) ""), traitId: "", orbital: "", orbitalId: "" }) { kind: "orbital", trait: (default (array/nth @parts (- (array/len @parts) 2)) ""), traitId: "", orbital: (str/join (array/take @parts (- (array/len @parts) 2)) "."), orbitalId: "" }))))) (if (and (= @bare (object/get @r "ev")) (if (= (object/get @sk "kind") "any") true (if (= (object/get @sk "kind") "trait") (if (!= (object/get @sk "traitId") "") (= (object/get @f "tid") (object/get @sk "traitId")) (and (= (object/get @f "on") (object/get @l "on")) (= (object/get @f "tn") (object/get @sk "trait")))) (if (= (object/get @sk "kind") "orbital") (if (and (!= (object/get @sk "orbitalId") "") (!= (object/get @sk "traitId") "")) (and (= (object/get @f "oid") (object/get @sk "orbitalId")) (= (object/get @f "tid") (object/get @sk "traitId"))) (and (= (object/get @f "on") (object/get @sk "orbital")) (= (object/get @f "tn") (object/get @sk "trait")))) false)))) [{ ri: @ri, li: @li, lx: @lx, trig: (object/get @L "triggers" @bare), lev: (object/get @L "event" ""), g: (object/get @L "guard"), hg: (object/has @L "guard"), mp: (object/get @L "payloadMapping" {}), hm: (validate/object (object/get @L "payloadMapping")) }] []))))))))))))))))))
        (emit FD_ROUTED { })
      FD_ROUTED -> ready
        (emit FD_ASK { ph: "r", items: (let ((nTr : FdTr { oi: 0, ti: 0, on: "", oid: "", tn: "", tid: "", tp: "", ls: [], ts: [] }) (nRs : FdRs { fi: 0, ev: "", ids: false, nt: false, d: [] }) (nRt : FdRt { ri: 0, li: 0, lx: 0, trig: "", lev: "", g: null, hg: false, mp: {}, hm: false }) (nMap : FdOptMap {})) (array/flatten (array/map (array/range 0 (array/len @entity.rt)) (fn k (let ((q : FdRt (default (array/nth @entity.rt @k) @nRt))) (let ((d : [FdAnnE] (object/get (default (array/nth @entity.rs (object/get @q "ri")) @nRs) "d")) (tp : string (object/get (default (array/nth @entity.tr (object/get @q "li")) @nTr) "tp"))) (let ((guard : [FdItem] (if (object/get @q "hg") [{ rid: @k, ti: 0, bp: @tp, arm: (str/concat "listens `" (object/get @q "lev") "`"), pl: @d, og: @d, kd: "g", nm: "", e: (object/get @q "g"), cx: "g", pf: "listens.guard" }] [])) (mp : FdOptMap (default (object/get @q "mp") @nMap)) (maps : [FdItem] (array/map (object/keys @mp) (fn nm { rid: @k, ti: 0, bp: @tp, arm: (str/concat "listens `" (object/get @q "lev") "`"), pl: @d, og: @d, kd: "m", nm: @nm, e: (default (object/get @mp @nm) null), cx: "m", pf: (str/concat "listens.payloadMapping." @nm) })))) (array/concat @guard @maps)))))))) })
      FD_ASK -> ready
        (set @entity.asked @payload.items)
        (emit LINT_EXPR_ASK { requestId: (str/concat "fetch-deliver:" @payload.ph), items: (array/map @payload.items (fn x { e: (object/get @x "e"), eff: (= (object/get @x "cx") "e") })) })
      LINT_EXPR_NODES -> ready when (str/startsWith @payload.requestId "fetch-deliver:")
