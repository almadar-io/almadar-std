      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
      FD_ROUTE { }
        @description "Internal: the program is held; decide the restricted success events."
        @tier "internal"
      FD_ROUTE2 { }
        @description "Internal: the restricted success events are held; route them."
        @tier "internal"
      FD_ROUTED { }
        @description "Internal: the listen routes are held; scan their guards and mappings."
        @tier "internal"
      FD_ARMS { }
