        (emit FD_ASK { ph: "s", items: (let ((nTr : FdTr { oi: 0, ti: 0, on: "", oid: "", tn: "", tid: "", tp: "", ls: [], ts: [] }) (nCb : FdCb { li: 0, ev: "", pl: [], og: [] }) (nTrans : FdTrans { ev: "", g: null, ef: [] }) (nGrp : FdGrp { k: "", li: 0, ev: "" })) (let ((cb : [FdCb] @entity.cb) (tr : [FdTr] @entity.tr)) (let ((gs : [FdGrp] (array/sort (array/unique (array/map @cb (fn x { k: (str/concat (str/padStart (str/concat "" (object/get @x "li")) 8 "0") "|" (object/get @x "ev")), li: (object/get @x "li"), ev: (object/get @x "ev") }))) "k"))) (array/flatten (array/map (array/range 0 (array/len @gs)) (fn gi (let ((g : FdGrp (default (array/nth @gs @gi) @nGrp))) (let ((mine : [FdCb] (array/filter @cb (fn x (and (= (object/get @x "li") (object/get @g "li")) (= (object/get @x "ev") (object/get @g "ev")))))) (t : FdTr (default (array/nth @tr (object/get @g "li")) @nTr))) (let ((pl : [FdAnnE] (array/flatten (array/map @mine (fn x (object/get @x "pl"))))) (og : [FdAnnE] (array/flatten (array/map @mine (fn x (object/get @x "og")))))) (array/flatten (array/map (array/range 0 (array/len (object/get @t "ts"))) (fn ti (let ((tn : FdTrans (default (array/nth (object/get @t "ts") @ti) @nTrans))) (if (!= (object/get @tn "ev") (object/get @g "ev")) [] (let ((bp : string (str/concat (object/get @t "tp") ".stateMachine.transitions[" @ti "]")) (arm : string (str/concat "`" (object/get @g "ev") "`"))) (array/concat (if (!= (object/get @tn "g") null) [{ rid: @gi, ti: @ti, pl: @pl, og: @og, bp: @bp, arm: @arm, kd: "g", nm: "", e: (default (object/get @tn "g") null), cx: "g", pf: "guard" }] []) (array/map (array/range 0 (array/len (object/get @tn "ef"))) (fn j { rid: @gi, ti: @ti, pl: @pl, og: @og, bp: @bp, arm: @arm, kd: "e", nm: (str/concat "" @j), e: (default (array/nth (object/get @tn "ef") @j) null), cx: "e", pf: (str/concat "effects[" @j "]") })))))))))))))))))) })
      FD_ANSWER -> ready when (= @payload.ph "s")
