app std-orb-lint-store-binding [
  version: "1.0.0",
  inbound: ["cli-lint-store-binding"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-store-binding — the `orb lint store-binding <file>` command, the port of store_binding.rs (EXEC-STORE-4). It lowers the file with program/read and checks the program-level store and each entity store (primary and auxiliary): ORB_STORE_ON_NON_PERSISTENT for a store on a runtime or browser-local entity, then, once per driver at its first binding, ORB_STORE_UNKNOWN_ORBITAL for a driver naming no orbital and ORB_STORE_DRIVER_CONTRACT for a driver with no trait handling every row verb; then, when the program binds a driver, ORB_STORE_VERB_OUTSIDE_SEAM for each (emit <row verb> …) in a trait outside a driver orbital (the store seam alone asks a driver, one frame per ask); then ORB_STORE_DRIVER_NOT_CONDITIONAL for a single persist delete or update on an entity whose driver declares writeCapabilities.conditional false (status 500, exit 1). a driver declaring `queryCapabilities.indexes` runtime or deploy with no trait handling ROWS_ENSURE_INDEXES is ORB_STORE_DRIVER_CONTRACT too (a driver declaring none, or nothing, needs no such verb). Clean answers `lint store-binding: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-store-binding"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type StoreShape = string | number | boolean | [StoreShape] | Map string StoreShape
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type StoreBindArm = { event : string, effects : [StoreShape] }
type StoreBindMachine = { transitions : [StoreBindArm] }
type StoreBindTrait = { name : string, stateMachine : StoreBindMachine }
type StoreBindEntity = { name : string, store : string, persistence : string, browser : boolean }
type StoreBindCaps = { conditional : boolean }
type StoreBindCapsSlot = { default : StoreBindCaps }
type StoreBindQuery = { indexes : string }
type StoreBindQuerySlot = { default : StoreBindQuery }
type StoreBindConfig = { writeCapabilities : StoreBindCapsSlot, queryCapabilities : StoreBindQuerySlot }
type StoreBindOrbital = { name : string, config : StoreBindConfig, entity : StoreBindEntity, auxiliaryEntities : [StoreBindEntity], traits : [StoreBindTrait] }
type StoreBindProgram = { store : string, orbitals : [StoreBindOrbital]! }

orbital OrbLintStoreBindingOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintStoreBindingRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintStoreBinding -> OrbLintStoreBindingRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((names (array/map @orbitals (fn o (object/get @o "name")))))
            (array/concat
            (let ((bound (array/concat
                           (if (object/has @payload.program "store") [{ path: "store", driver: (object/get @payload.program "store"), bad: false, label: "" }] [])
                           (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                             (let ((ents (array/filter (array/concat [(object/get (array/nth @orbitals @oi) "entity" {})] (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])) (fn xe (validate/object @xe)))))
                               (array/map (array/filter @ents (fn e (object/has @e "store")))
                                 (fn e { path: (str/concat "orbitals[" @oi "].entity." (object/get @e "name" "")), driver: (object/get @e "store"), bad: (or (= (object/get @e "persistence" "") "runtime") (= (object/get @e "browser" false) true)), label: (object/get @e "name" "") })))))))))
              (array/flatten (array/map (array/range 0 (array/len @bound)) (fn bi
                (let ((b (array/nth @bound @bi)))
                  (let ((d (object/get @b "driver")))
                    (array/concat
                      (if (object/get @b "bad")
                        [{ code: "ORB_STORE_ON_NON_PERSISTENT", path: (object/get @b "path"), message: (str/concat "entity " (object/get @b "label") " binds store " @d " but its rows live in no store (runtime or browser-local)"), suggestion: "Drop `store:`, or declare the entity [persistent: <collection>]", severity: "error" }]
                        [])
                      (if (!= (array/first (array/filter (array/range 0 (array/len @bound)) (fn j (= (object/get (array/nth @bound @j) "driver") @d)))) @bi)
                        []
                        (if (not (array/includes @names @d))
                          [{ code: "ORB_STORE_UNKNOWN_ORBITAL", path: (object/get @b "path"), message: (str/concat "store " @d " names no orbital of this program"), suggestion: "", severity: "error" }]
                          (let ((handled (array/flatten (array/map (object/get (array/first (array/filter @orbitals (fn o (= (object/get @o "name") @d)))) "traits" []) (fn t (array/map (object/get (object/get @t "stateMachine" {}) "transitions" []) (fn x (object/get @x "event" ""))))))))
                            (let ((missing (array/filter (array/concat ["ROW_READ", "ROW_LIST", "ROWS_QUERY", "ROWS_WRITE"] (if (array/includes ["runtime", "deploy"] (object/get (object/get (object/get (object/get (array/first (array/filter @orbitals (fn o (= (object/get @o "name") @d)))) "config" {}) "queryCapabilities" {}) "default" {}) "indexes" "")) ["ROWS_ENSURE_INDEXES"] [])) (fn v (not (array/includes @handled @v))))))
                              (if (= (array/len @missing) 0)
                                []
                                [{ code: "ORB_STORE_DRIVER_CONTRACT", path: (object/get @b "path"), message: (str/concat "store driver " @d " has no trait handling [" (str/join (array/map @missing (fn v (str/concat "\"" @v "\""))) ", ") "] (spec/store/row-store.lolo RowStoreDriver)"), suggestion: "Compose a std store driver atom, or give the driver a trait that answers every row verb", severity: "error" }]))))))))))))
(let ((drivers (array/filter (array/unique (array/concat (if (object/has @payload.program "store") [(object/get @payload.program "store")] [])
                                (array/flatten (array/map @orbitals (fn o (array/map (array/filter (array/filter (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])) (fn xe (validate/object @xe))) (fn e (object/has @e "store"))) (fn e (object/get @e "store"))))))))
                            (fn d (array/includes @names @d)))))
              (if (= (array/len @drivers) 0)
                []
                (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((orb (array/nth @orbitals @oi)))
                    (if (array/includes @drivers (object/get @orb "name"))
                      []
                      (array/flatten (array/map (object/get @orb "traits" []) (fn td
                        (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "transitions" []) (fn tr
                          (array/flatten (array/map (object/get @tr "effects" []) (fn ef
                            (let ((fres (tree/fold @ef (fn (n k)
                                (if (validate/array @n)
                                  (array/concat
                                    (let ((h0 (array/nth @n 0)) (a0 (array/nth @n 1))) (if (validate/string @h0) (if (= @h0 "emit") (if (validate/string @a0) (if (array/includes ["ROW_READ", "ROW_LIST", "ROWS_QUERY", "ROWS_WRITE"] @a0) [@a0] []) []) []) []))
                                    (array/flatten (array/filter @k (fn r (validate/array @r)))))
                                  [])) StoreShape))) (if (= @fres null) (let ((up (str/concat "orbitals[" @oi "].traits." (object/get @td "name" "")))) [{ code: "LINT_NODE_UNCHECKED", path: @up, message: (str/concat @payload.file ": schema node at " @up " is not a StoreShape; this rule could not check it"), suggestion: "", severity: "error" }]) (array/map
                              @fres
                              (fn verb { code: "ORB_STORE_VERB_OUTSIDE_SEAM", path: (str/concat "orbitals[" @oi "].traits." (object/get @td "name" "")), message: (str/concat "trait " (object/get @td "name" "") " emits the row verb " @verb "; a store driver is asked only by the store seam, one frame per ask (EXEC-STORE-4)"), suggestion: "Read and write the rows through persist/fetch on an entity bound to the driver", severity: "error" }))))))))))))))))))))
            (let ((bnd (array/flatten (array/map @orbitals (fn o
                     (array/flatten (array/map (array/filter (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])) (fn xe (validate/object @xe))) (fn e
                       (if (and (!= (object/get @e "persistence" "") "runtime") (not (object/get @e "browser" false)))
                         (let ((dv (if (object/has @e "store") (object/get @e "store") (if (object/has @payload.program "store") (object/get @payload.program "store") ""))))
                           (if (= @dv "") [] [{ name: (object/get @e "name" ""), driver: @dv }]))
                         [])))))))))
              (if (= (array/len @bnd) 0)
                []
                (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((orb (array/nth @orbitals @oi)))
                    (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                      (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                        (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "transitions" []) (fn tr
                          (array/flatten (array/map (object/get @tr "effects" []) (fn ef
                            (let ((fres (tree/fold @ef (fn (n k)
                                (if (validate/array @n)
                                  (array/concat
                                    (let ((h0 (array/nth @n 0)) (v0 (array/nth @n 1)) (e0 (array/nth @n 2))) (if (validate/string @h0) (if (= @h0 "persist") (if (validate/string @v0) (if (or (= @v0 "delete") (= @v0 "update")) (if (validate/string @e0) [@e0] []) []) []) []) []))
                                    (array/flatten (array/filter @k (fn r (validate/array @r)))))
                                  [])) StoreShape))) (if (= @fres null) (let ((up (str/concat "orbitals[" @oi " (" (object/get @orb "name") ")].traits[" @ti " (" (object/get @td "name") ")]"))) [{ code: "LINT_NODE_UNCHECKED", path: @up, message: (str/concat @payload.file ": schema node at " @up " is not a StoreShape; this rule could not check it"), suggestion: "", severity: "error" }]) (array/flatten (array/map
                              @fres
                              (fn en
                                (let ((hits (array/filter @bnd (fn x (= (object/get @x "name") @en)))))
                                  (if (= (array/len @hits) 0)
                                    []
                                    (let ((dv (object/get (array/last @hits) "driver")))
                                      (let ((drv (array/filter @orbitals (fn o (= (object/get @o "name") @dv)))))
                                        (if (and (> (array/len @drv) 0) (= (object/get (object/get (object/get (object/get (array/first @drv) "config" {}) "writeCapabilities" {}) "default" {}) "conditional" null) false))
                                          [{ code: "ORB_STORE_DRIVER_NOT_CONDITIONAL", path: (str/concat "orbitals[" @oi " (" (object/get @orb "name") ")].traits[" @ti " (" (object/get @td "name") ")]"), message: (str/concat "persist on " @en " is one conditional op (EXEC-STEP-8), and its store driver " @dv " declares writeCapabilities.conditional false"), suggestion: "Bind the entity to a driver that writes conditionally, or take rows through a persist batch", severity: "error" }]
                                          []))))))))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "store-binding", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : StoreBindProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintStoreBindingCli -> OrbLintStoreBindingRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint store-binding: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint store-binding <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "store-binding") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint store-binding: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "store-binding") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint store-binding: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-store-binding" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint store-binding` with its arguments and working directory."
        @synonyms "orb lint store-binding, orb lint store-binding, store binding, store driver, store on non persistent"
      OrbLintStoreBinding.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintStoreBindingCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintStoreBindingOrbitalStart -> OrbLintStoreBinding, OrbLintStoreBindingCli, OrbLintInput, Packs, Versions
}
