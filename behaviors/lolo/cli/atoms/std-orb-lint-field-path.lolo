app std-orb-lint-field-path [
  version: "1.0.0",
  inbound: ["cli-lint-field-path"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-field-path — the `orb lint field-path <file>` command, the port of ORB_RUI_INVALID_FIELD_PATH (field_path.rs validate_field_paths). It lowers the file with program/read and walks the pattern (third element) of every render-ui effect of every transition the way the compiler's pattern validator does (a pattern object with a type, then its children: one object, a list, a mapped-children `array/map` with a lambda, or the arms of a conditional node). For a pattern with a literal entity name the program defines and a `fields` list, each dotted entry is checked: its first segment must be a relation field of the entity (name or name+Id), the second must be a field of the relation's target entity, and more than two segments is reported. Entity definitions are the primary and auxiliary entities of every orbital, a later one replacing an earlier one of the same name and a primary name declared in two orbitals dropped, as the compiler builds them. An unknown entity or relation target is silent. ORB_X_UNRESOLVED_PATTERN_FIELD_REF is not ported: it reads the pattern registry's field-ref prop kinds, which no lint input carries. Children written as operator calls are not expanded, since no lint input carries the namespaced operator names. Clean answers `lint field-path: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-field-path"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type RuVal = string | number | boolean | [RuVal?] | Map string RuVal?
type RuHit = { p : string!, m : string!, s : string! }
type RuRes = { nd : [RuHit]!, ls : [RuHit]!, la : [RuHit]!, mp : [RuHit]!, lm : [RuHit]! }
type RuTransition = { effects : [RuVal?] }
type RuMachine = { transitions : [RuTransition] }
type RuTrait = { name : string, stateMachine : RuMachine }
type RuField = { name : string, type : string, relation : RuRelation }
type RuRelation = { entity : string }
type RuEntity = { name : string, fields : [RuField] }
type RuOrbital = { name : string, entity : RuEntity, auxiliaryEntities : [RuEntity], traits : [RuTrait] }
type RuProgram = { orbitals : [RuOrbital] }

orbital OrbLintFieldPathOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintFieldPathRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintFieldPath -> OrbLintFieldPathRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])) (noh : [RuHit] []) (noe : [RuEntity] [])
 (allEnts (array/flatten (array/map @orbitals (fn o (array/concat
      (let ((en (object/get @o "entity" null))) (if (and (validate/object @en) (validate/string (object/get @en "name" null))) [@en] @noe))
      (array/filter (object/get @o "auxiliaryEntities" @noe) (fn x (and (validate/object @x) (validate/string (object/get @x "name" null))))))))))
 (pnames (array/flatten (array/map @orbitals (fn o (let ((en (object/get @o "entity" null))) (if (and (validate/object @en) (validate/string (object/get @en "name" null))) [(object/get @en "name")] (array/take [""] 0)))))))
 (dups (array/filter @pnames (fn nm (> (array/len (array/filter @pnames (fn x (= @x @nm)))) 1))))
 (ents (array/reverse (array/filter @allEnts (fn e (not (array/includes @dups (object/get @e "name"))))))))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (let ((trs (object/get @orb "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn tj
                  (let ((td (array/nth @trs @tj)))
                    (let ((trans (object/get (object/get @td "stateMachine" {}) "transitions" [])))
                      (array/flatten (array/map (array/range 0 (array/len @trans)) (fn ti
                        (let ((effs (object/get (array/nth @trans @ti) "effects" [])))
                          (array/flatten (array/map (array/range 0 (array/len @effs)) (fn ej
                            (let ((e (array/nth @effs @ej)))
                              (if (and (validate/array @e) (> (array/len @e) 2) (let ((hd (array/nth @e 0))) (and (validate/string @hd) (= @hd "render-ui"))))
                                (let ((fr (tree/fold (array/nth @e 2) (fn (n k)
  (let ((nr : RuRes { nd: [], ls: [], la: [], mp: [], lm: [] }))
    (if (validate/array @n)
      (let ((len (array/len @n)))
        (let ((items (array/range 0 @len)))
        { nd: (if (and (validate/array @n) (or (= (array/len @n) 3) (= (array/len @n) 4)) (let ((hd (array/nth @n 0))) (and (validate/string @hd) (= @hd "if")))) (array/concat (let ((arm (array/nth @n 2)) (ar (let ((r0 (array/nth @k 2))) (if (= @r0 null) @nr @r0)))) (if (and (validate/array @arm) (= (array/len @arm) 3) (let ((hd (array/nth @arm 0))) (and (validate/string @hd) (= @hd "array/map"))) (let ((lam (array/nth @arm 2))) (and (validate/array @lam) (= (array/len @lam) 3) (let ((hd (array/nth @lam 0))) (and (validate/string @hd) (= @hd "fn"))) (let ((pr (array/nth @lam 1))) (or (validate/string @pr) (and (validate/array @pr) (array/some @pr (fn q (validate/string @q))))))))) (array/map (object/get @ar "mp") (fn h { p: (str/concat "[2]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })) (if (validate/array @arm) (if (and (validate/array @arm) (or (= (array/len @arm) 3) (= (array/len @arm) 4)) (let ((hd (array/nth @arm 0))) (and (validate/string @hd) (= @hd "if")))) (array/map (object/get @ar "nd") (fn h { p: (str/concat "[2]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })) (array/map (object/get @ar "la") (fn h { p: (str/concat "[2]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))) (array/map (object/get @ar "nd") (fn h { p: (str/concat "[2]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))))) (if (= @len 4) (let ((arm (array/nth @n 3)) (ar (let ((r0 (array/nth @k 3))) (if (= @r0 null) @nr @r0)))) (if (and (validate/array @arm) (= (array/len @arm) 3) (let ((hd (array/nth @arm 0))) (and (validate/string @hd) (= @hd "array/map"))) (let ((lam (array/nth @arm 2))) (and (validate/array @lam) (= (array/len @lam) 3) (let ((hd (array/nth @lam 0))) (and (validate/string @hd) (= @hd "fn"))) (let ((pr (array/nth @lam 1))) (or (validate/string @pr) (and (validate/array @pr) (array/some @pr (fn q (validate/string @q))))))))) (array/map (object/get @ar "mp") (fn h { p: (str/concat "[3]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })) (if (validate/array @arm) (if (and (validate/array @arm) (or (= (array/len @arm) 3) (= (array/len @arm) 4)) (let ((hd (array/nth @arm 0))) (and (validate/string @hd) (= @hd "if")))) (array/map (object/get @ar "nd") (fn h { p: (str/concat "[3]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })) (array/map (object/get @ar "la") (fn h { p: (str/concat "[3]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))) (array/map (object/get @ar "nd") (fn h { p: (str/concat "[3]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))))) [])) (object/get @nr "nd")),
          ls: (array/flatten (array/map @items (fn i (let ((it (array/nth @n @i)) (ir (let ((r0 (array/nth @k @i))) (if (= @r0 null) @nr @r0)))) (if (and (validate/array @it) (= (array/len @it) 3) (let ((hd (array/nth @it 0))) (and (validate/string @hd) (= @hd "array/map"))) (let ((lam (array/nth @it 2))) (and (validate/array @lam) (= (array/len @lam) 3) (let ((hd (array/nth @lam 0))) (and (validate/string @hd) (= @hd "fn"))) (let ((pr (array/nth @lam 1))) (or (validate/string @pr) (and (validate/array @pr) (array/some @pr (fn q (validate/string @q))))))))) (array/map (object/get @ir "mp") (fn h { p: (str/concat "[" @i "]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })) (array/map (object/get @ir "nd") (fn h { p: (str/concat "[" @i "]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))))))),
          la: (array/flatten (array/map @items (fn i (let ((ir (let ((r0 (array/nth @k @i))) (if (= @r0 null) @nr @r0)))) (array/map (object/get @ir "nd") (fn h { p: (str/concat "[" @i "]" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })))))),
          mp: (if (and (validate/array @n) (= (array/len @n) 3) (let ((hd (array/nth @n 0))) (and (validate/string @hd) (= @hd "array/map"))) (let ((lam (array/nth @n 2))) (and (validate/array @lam) (= (array/len @lam) 3) (let ((hd (array/nth @lam 0))) (and (validate/string @hd) (= @hd "fn"))) (let ((pr (array/nth @lam 1))) (or (validate/string @pr) (and (validate/array @pr) (array/some @pr (fn q (validate/string @q))))))))) (object/get (let ((r0 (array/nth @k 2))) (if (= @r0 null) @nr @r0)) "lm") (object/get @nr "mp")),
          lm: (if (and (= @len 3) (let ((hd (array/nth @n 0))) (and (validate/string @hd) (= @hd "fn")))) (object/get (let ((r0 (array/nth @k 2))) (if (= @r0 null) @nr @r0)) "nd") (object/get @nr "nd")) }))
      (if (validate/object @n)
        (let ((t (object/get @n "type" null)) (ch (object/get @n "children" null)) (chk (let ((r0 (object/get @k "children" null))) (if (= @r0 null) @nr @r0))))
          { nd: (if (validate/string @t)
                  (array/concat (let ((fields (object/get @n "fields" null)) (ename (object/get @n "entity" null)))
 (if (and (validate/array @fields) (validate/string @ename))
  (let ((base (array/find @ents (fn e (= (object/get @e "name") @ename)))))
   (if (= @base null) @noh
    (array/flatten (array/map @fields (fn f (if (and (validate/string @f) (str/includes @f "."))
     (let ((fp @f)) (let ((segs (str/split @fp ".")))
      (let ((first (array/nth @segs 0)) (second (array/nth @segs 1)))
       (let ((rel (array/find (object/get @base "fields" []) (fn f (and (= (object/get @f "type" "") "relation") (validate/string (object/get @f "name" null)) (or (= (object/get @f "name") @first) (= (object/get @f "name") (str/concat @first "Id"))))))))
        (if (= @rel null)
         [{ p: "", m: (str/concat "Field path '" @fp "' - '" @ename "' has no relation field '" @first "' to traverse"), s: (str/concat "Add a relation field for '" @first "' or use a direct field reference") }]
         (let ((rl (object/get @rel "relation" null)))
          (if (not (and (validate/object @rl) (validate/string (object/get @rl "entity" null)))) @noh
           (let ((tname (object/get @rl "entity")))
            (let ((target (array/find @ents (fn e (= (object/get @e "name") @tname)))))
             (if (= @target null) @noh
              (array/concat
               (if (array/some (object/get @target "fields" []) (fn f (= (object/get @f "name" null) @second))) @noh
                [{ p: "", m: (str/concat "Field path '" @fp "' - '" @ename "' has no field '" @second "' on related entity '" @tname "'"), s: (str/concat "Check that '" @tname "' entity has a '" @second "' field") }])
               (if (> (array/len @segs) 2)
                [{ p: "", m: (str/concat "Field path '" @fp "' has more than 2 levels of nesting (max recommended: 2)"), s: "Consider flattening the data structure or using a custom pattern" }]
                @noh))))))))))))
     []))))))
  @noh))
                    (if (= @ch null) (object/get @nr "nd")
                      (if (and (validate/array @ch) (= (array/len @ch) 3) (let ((hd (array/nth @ch 0))) (and (validate/string @hd) (= @hd "array/map"))) (let ((lam (array/nth @ch 2))) (and (validate/array @lam) (= (array/len @lam) 3) (let ((hd (array/nth @lam 0))) (and (validate/string @hd) (= @hd "fn"))) (let ((pr (array/nth @lam 1))) (or (validate/string @pr) (and (validate/array @pr) (array/some @pr (fn q (validate/string @q))))))))) (array/map (object/get @chk "mp") (fn h { p: (str/concat ".children" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))
                        (if (validate/array @ch) (array/map (object/get @chk "ls") (fn h { p: (str/concat ".children" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") }))
                          (if (validate/object @ch) (array/map (object/get @chk "nd") (fn h { p: (str/concat ".children" (object/get @h "p")), m: (object/get @h "m"), s: (object/get @h "s") })) (object/get @nr "nd"))))))
                  (object/get @nr "nd")),
            ls: (object/get @nr "nd"), la: (object/get @nr "nd"), mp: (object/get @nr "nd"), lm: (object/get @nr "nd") })
        @nr)))) RuVal)))
                                  (if (= @fr null) []
                                    (array/map (object/get @fr "nd") (fn h { code: "ORB_RUI_INVALID_FIELD_PATH", path: (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @tj " (" (object/get @td "name" "") ")].stateMachine.transitions[" @ti "].effects[" @ej "][2]" (object/get @h "p")), message: (object/get @h "m"), suggestion: (object/get @h "s"), severity: "error" }))))
                                [])))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "field-path", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : RuProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintFieldPathCli -> OrbLintFieldPathRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint field-path <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "field-path") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint field-path: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "field-path") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint field-path: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-field-path" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint field-path` with its arguments and working directory."
        @synonyms "orb lint field-path"
      OrbLintFieldPath.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintFieldPathCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintFieldPathOrbitalStart -> OrbLintFieldPath, OrbLintFieldPathCli, OrbLintInput, Packs, Versions
}
