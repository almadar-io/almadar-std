app std-orb-lint-schema-header [
  version: "1.0.0",
  inbound: ["cli-lint-schema-header"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-schema-header — the `orb lint schema-header <file>` command, the port of ORB_S_MISSING_NAME, ORB_S_NO_ORBITALS and ORB_S_EMPTY_VERSION (cross_orbital/mod.rs validate_cross_orbital). It lowers the file with program/read and reports an empty or absent schema name, a schema with no orbitals, and a version that is present but empty, each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint schema-header: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-schema-header"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type SchemaHeaderOrbital = { name : string }
type SchemaHeaderProgram = { name : string, orbitals : [SchemaHeaderOrbital], version : string }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintSchemaHeaderCodes = { sMissingName : LintCodeDecl , sNoOrbitals : LintCodeDecl , sEmptyVersion : LintCodeDecl }

orbital OrbLintSchemaHeaderOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintSchemaHeaderRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintSchemaHeader -> OrbLintSchemaHeaderRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((res @payload.program))
          (array/flatten [
            (if (= (object/get @res "name" "") "") [{ code: @config.codes.sMissingName.code, path: "name", message: "Schema name is required", suggestion: "Add a name for your schema", severity: "error" }] [])
            (if (= (array/len (object/get @res "orbitals" [])) 0) [{ code: @config.codes.sNoOrbitals.code, path: "orbitals", message: "Schema must have at least one orbital", suggestion: "Add at least one orbital to define application features", severity: "error" }] [])
            (if (and (object/has @res "version") (= (object/get @res "version") "")) [{ code: @config.codes.sEmptyVersion.code, path: "version", message: "Schema version should not be empty", suggestion: "Use semantic versioning (e.g., '1.0.0')", severity: "error" }] [])])))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "schema-header", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : SchemaHeaderProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintSchemaHeaderCodes = { sMissingName: { code: "ORB_S_MISSING_NAME", category: "schema", description: "The schema does not declare a name" }, sNoOrbitals: { code: "ORB_S_NO_ORBITALS", category: "schema", description: "The schema declares no orbitals" }, sEmptyVersion: { code: "ORB_S_EMPTY_VERSION", category: "schema", description: "The schema version is empty" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintSchemaHeaderCli -> OrbLintSchemaHeaderRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint schema-header: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint schema-header <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "schema-header") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint schema-header: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "schema-header") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint schema-header: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-schema-header" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint schema-header` with its arguments and working directory."
        @synonyms "orb lint schema-header"
      OrbLintSchemaHeader.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintSchemaHeaderCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintSchemaHeaderOrbitalStart -> OrbLintSchemaHeader, OrbLintSchemaHeaderCli, OrbLintInput, Packs, Versions
}
