app std-orb-lint-schema-header [
  version: "1.0.0",
  inbound: ["cli-lint-schema-header"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-schema-header — the `orb lint schema-header <file>` command, the port of ORB_S_MISSING_NAME, ORB_S_NO_ORBITALS and ORB_S_EMPTY_VERSION (cross_orbital/mod.rs validate_cross_orbital). It lowers the file with program/read and reports an empty or absent schema name, a schema with no orbitals, and a version that is present but empty, each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint schema-header: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-schema-header"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintSchemaHeaderOrbital {
  entity OrbLintSchemaHeaderRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintSchemaHeader -> OrbLintSchemaHeaderRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "schema-header", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((res @payload.result))
          (array/flatten [
            (if (= (object/get @res "name" "") "") [{ code: "ORB_S_MISSING_NAME", path: "name", message: "Schema name is required", suggestion: "Add a name for your schema", severity: "error" }] [])
            (if (= (array/len (object/get @res "orbitals" [])) 0) [{ code: "ORB_S_NO_ORBITALS", path: "orbitals", message: "Schema must have at least one orbital", suggestion: "Add at least one orbital to define application features", severity: "error" }] [])
            (if (and (object/has @res "version") (= (object/get @res "version") "")) [{ code: "ORB_S_EMPTY_VERSION", path: "version", message: "Schema version should not be empty", suggestion: "Use semantic versioning (e.g., '1.0.0')", severity: "error" }] [])])))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "schema-header" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintSchemaHeaderCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintSchemaHeaderCli -> OrbLintSchemaHeaderRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint schema-header <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "schema-header") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint schema-header: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "schema-header") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "schema-header")
        (emit LINT_ANSWERED { status: 500, body: "lint schema-header: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-schema-header" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint schema-header` with its arguments and working directory."
        @synonyms "orb lint schema-header"
      OrbLintSchemaHeader.LINT_FOUND -> LINT_FOUND
      OrbLintSchemaHeader.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-schema-header" as OrbLintSchemaHeaderPage -> OrbLintSchemaHeader, OrbLintSchemaHeaderCli
}
