app std-orb-lint-binding-traits [
  version: "1.0.0",
  inbound: ["cli-lint-binding-traits"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-binding-traits - the `orb lint binding-traits <file>` command, the port of the @trait.<Name> binding rules of binding.rs (validate_trait_binding_usage, detect_trait_binding_cycles): ORB_BINDING_TRAIT_MISSING_NAME, ORB_BINDING_TRAIT_INVALID_FORMAT, ORB_BINDING_TRAIT_SELF_REFERENCE, ORB_BINDING_TRAIT_UNKNOWN, ORB_BINDING_TRAIT_OUTSIDE_RENDER_UI and ORB_BINDING_TRAIT_CYCLE. It lowers the file with program/read and walks every inline trait: a trait-typed config knob bound to @trait.<Name> must name a trait of the orbital, and an @trait binding is allowed only inside a render-ui effect (a guard, a non-render effect and a tick get the outside-render-ui error); an allowed binding must be single-segment, name a PascalCase trait of the orbital and not the trait itself. The @trait references of an orbital's transition and tick effects form a graph; the first cycle found by a depth-first walk in declaration order is reported once per orbital. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint binding-traits: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-binding-traits"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type BtShape = string | number | boolean | [BtShape?] | Map string BtShape?
type BtNodes = [BtShape?]
type BtS = string
type BtCfg = { type : string, default : BtShape? }
type BtTransition = { guard : BtShape?, effects : [BtShape] }
type BtTick = { guard : BtShape?, effects : [BtShape] }
type BtMachine = { transitions : [BtTransition] }
type BtTrait = { name : string?, stateMachine : BtMachine, ticks : [BtTick], config : Map string BtCfg }
type BtOrbital = { name : string, traits : [BtTrait] }
type BtProgram = { orbitals : [BtOrbital]! }
type BtCH = { path : string!, node : BtShape! }
type BtHits = Map string [BtCH]
type BtHit = { rel : string!, s : string!, rd : boolean! }
type BtRoot = { x : BtShape?, w : string!, allow : boolean!, tn : string!, oi : number!, only : boolean!, kn : [string]! }
type BtIdx = { ti : number!, t : BtTrait!, nm : string! }
type BtWalk = { st : [string], ix : [number], col : Map string number, done : boolean, res : [string] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintBindingTraitsCodes = { lintIndexMissing : LintCodeDecl , bindingTraitOutsideRenderUi : LintCodeDecl , bindingTraitInvalidFormat : LintCodeDecl , bindingTraitMissingName : LintCodeDecl , bindingTraitSelfReference : LintCodeDecl , bindingTraitUnknown : LintCodeDecl , bindingTraitCycle : LintCodeDecl }

orbital OrbLintBindingTraitsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintBindingTraitsRun [runtime] {
    id : string!
    scope : string = ""
    roots : Map string [string] = {}
    indexed : boolean = false
    indexScope : string = ""
    embeds : Map string [string] = {}
    embedded : boolean = false
    embedsScope : string = ""
    findings : [OrbFinding] = []

  }

  trait OrbLintBindingTraits -> OrbLintBindingTraitsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      INDEX_HEARD -> ready
        (set @entity.roots @payload.roots)
        (set @entity.indexed true)
        (set @entity.indexScope @payload.scope)
      EMBEDS_HEARD -> ready
        (set @entity.embeds @payload.effectsWalk)
        (set @entity.embedsScope @payload.scope)
        (set @entity.embedded true)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (and @entity.indexed (= @entity.indexScope @payload.scope) @entity.embedded (= @entity.embedsScope @payload.scope))
(let ((nohits : [BtHit] []) (noroots : [BtRoot] []) (nostr : [string] []) (nonum : [number] []) (noidx : [BtIdx] []) (nof : [OrbFinding] []) (tP : string (str/concat (quote "@") "trait")) (tP2 : string (str/concat (quote "@") "trait.")) (orbitals : [BtOrbital] (object/get @payload.program "orbitals" [])))
  (let ((roots : [BtRoot] (object/get (array/reduce @orbitals { i: 0, out: @noroots } (fn (oa o)
          (let ((oi : number (object/get @oa "i")) (trts : [BtTrait] (object/get @o "traits" [])) (tkn : [string] (object/get (array/reduce @trts { i: 0, out: @nostr } (fn (ka t) (let ((nmv (object/get @t "name" null))) (if (= @nmv null) @ka { i: 0, out: (array/append (object/get @ka "out") @nmv) }))))  "out")))
            { i: (+ @oi 1), out: (array/concat (object/get @oa "out") (object/get (array/reduce @trts { i: 0, out: @noroots } (fn (ta t)
              (let ((ti : number (object/get @ta "i")))
                { i: (+ @ti 1), out: (array/concat (object/get @ta "out")
                  (if (or (not (object/has @t "stateMachine")) (not (array/some (object/get @entity.roots (str/concat @oi "-" @ti) @nostr) (fn r (str/startsWith @r @tP)))))
                    @noroots
                    (let ((tp (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]")) (tn (object/get @t "name" "")) (trs : [BtTransition] (object/get (object/get @t "stateMachine" { transitions: [] }) "transitions" [])) (tks : [BtTick] (object/get @t "ticks" [])) (cfg : Map string BtCfg (object/get @t "config" {})))
                      (array/concat
                        (array/flatten
                          (array/map (array/sort (object/keys @cfg))
                            (fn kn
                              (let ((cf : BtCfg? (object/get @cfg @kn)))
                                (if (= @cf null)
                                  @noroots
                                  (let ((dv (object/get @cf "default" null)))
                                    (if (= (object/get @cf "type" "") "trait")
                                      (if (validate/string @dv)
                                        (if (str/startsWith @dv @tP2)
                                          [{ x: @dv, w: (str/concat @tp ".config." @kn), allow: true, tn: @tn, oi: @oi, only: true, kn: @tkn }]
                                          @noroots)
                                        @noroots)
                                      @noroots)))))))
                        (array/concat
                          (object/get (array/reduce @trs { i: 0, out: @noroots } (fn (xa tr)
                            (let ((xi : number (object/get @xa "i")) (effs : [BtShape] (object/get @tr "effects" [])) (g (object/get @tr "guard" null)))
                              (let ((xp (str/concat @tp ".stateMachine.transitions[" @xi "]")))
                                { i: (+ @xi 1), out: (array/concat (object/get @xa "out")
                                  (if (!= @g null) [{ x: @g, w: (str/concat @xp ".guard"), allow: false, tn: @tn, oi: @oi, only: false, kn: @tkn }] @noroots)
                                  (object/get (array/reduce @effs { i: 0, out: @noroots } (fn (ea ef)
                                    (let ((ei : number (object/get @ea "i")))
                                      { i: (+ @ei 1), out: (if (validate/object @ef) (object/get @ea "out") (array/append (object/get @ea "out") { x: @ef, w: (str/concat @xp ".effects[" @ei "]"), allow: false, tn: @tn, oi: @oi, only: false, kn: @tkn })) }))) "out")) })))) "out")
                          (object/get (array/reduce @tks { i: 0, out: @noroots } (fn (ka tk)
                            (let ((ki : number (object/get @ka "i")) (teffs : [BtShape] (object/get @tk "effects" [])) (tg (object/get @tk "guard" null)))
                              { i: (+ @ki 1), out: (array/concat (object/get @ka "out")
                                (if (!= @tg null) [{ x: @tg, w: (str/concat @tp ".ticks[" @ki "].guard"), allow: false, tn: @tn, oi: @oi, only: false, kn: @tkn }] @noroots)
                                (object/get (array/reduce @teffs { i: 0, out: @noroots } (fn (ea ef)
                                  (let ((ei : number (object/get @ea "i")))
                                    { i: (+ @ei 1), out: (if (validate/object @ef) (object/get @ea "out") (array/append (object/get @ea "out") { x: @ef, w: (str/concat @tp ".ticks[" @ki "].effects[" @ei "]"), allow: false, tn: @tn, oi: @oi, only: false, kn: @tkn })) }))) "out")) }))) "out")))))) }))) "out")) })))
          "out")))
    (array/concat
      (array/flatten
        (array/map @roots
          (fn x
            (let ((hs : [BtHit] (let ((ix : BtHits (default (as (tree/index (object/get @x "x" null) ["render-ui"] { prefixes: [@tP] }) BtHits) {}))) (let ((rds : [string] (array/map (object/get @ix "render-ui" []) (fn c (object/get @c "path" ""))))) (array/map (array/filter (array/flatten (object/values @ix)) (fn c (let ((nd (object/get @c "node" null))) (and (validate/string @nd) (>= (str/len (default (as @nd BtS) "")) 6))))) (fn c (let ((lp (object/get @c "path" ""))) { rel: (let ((p (object/get @c "path" ""))) (if (= @p "") "" (if (str/startsWith @p "[") @p (str/concat "." @p)))), s: (default (as (object/get @c "node" null) BtS) ""), rd: (array/some @rds (fn rp (or (= @rp "") (= @lp @rp) (str/startsWith @lp (str/concat @rp "[")) (str/startsWith @lp (str/concat @rp "."))))) })))))))
              (array/flatten
                (array/map @hs
                  (fn h
                    (let ((s (object/get @h "s")) (p (str/concat (object/get @x "w") (object/get @h "rel"))) (tn (object/get @x "tn")) (known : [string] (object/get @x "kn")))
              (if (not (or (object/get @x "allow") (object/get @h "rd")))
                (if (object/get @x "only") @nof [{ code: @config.codes.bindingTraitOutsideRenderUi.code, path: @p, message: (str/concat (quote "@") "trait binding '" @s "' appears outside a render-ui effect; @trait references are render-only composition primitives and may only be used inside a (render-ui ...) pattern tree"), suggestion: "Move the @trait reference into a render-ui children array, or replace it with the intended data/payload binding", severity: "error" }])
                (let ((fnds : [OrbFinding] (if (not (validate/pattern @s "^@[\\p{L}_][\\p{L}0-9_]*(\\.[\\p{L}0-9_]+|\\[\\d+\\])*$"))
                    [{ code: @config.codes.bindingTraitInvalidFormat.code, path: @p, message: (str/concat "Invalid " (quote "@") "trait binding format: '" @s "'"), suggestion: (str/concat "Use " (quote "@") "trait.<PascalCaseTraitName> — a .slot suffix is not supported"), severity: "error" }]
                    (let ((parts (str/split (str/slice @s 1) ".")))
                      (if (= (array/len @parts) 1)
                        [{ code: @config.codes.bindingTraitMissingName.code, path: @p, message: (str/concat (quote "@") "trait binding missing trait name"), suggestion: (str/concat "Use " (quote "@") "trait.<TraitName> to reference another trait's current frame"), severity: "error" }]
                        (let ((nm (default (array/nth @parts 1) "")))
                          (if (not (validate/pattern @nm "^[A-Z][a-zA-Z0-9]*$"))
                            [{ code: @config.codes.bindingTraitInvalidFormat.code, path: @p, message: (str/concat (quote "@") "trait binding trait name '" @nm "' is not PascalCase"), suggestion: (str/concat "Trait names must be PascalCase (e.g., " (quote "@") "trait.ItemSearch)"), severity: "error" }]
                            (if (= @nm @tn)
                              [{ code: @config.codes.bindingTraitSelfReference.code, path: @p, message: (str/concat "Trait '" @nm "' references itself via " (quote "@") "trait"), suggestion: "A trait's render-ui cannot embed its own frame; restructure to avoid self-reference", severity: "error" }]
                              (if (and (> (array/len @known) 0) (not (array/includes @known @nm)))
                                [{ code: @config.codes.bindingTraitUnknown.code, path: @p, message: (str/concat (quote "@") "trait." @nm " references a trait not declared in this orbital"), suggestion: "Declare the trait in the orbital, or check spelling", severity: "error" }]
                                (if (> (array/len @parts) 2) [{ code: @config.codes.bindingTraitInvalidFormat.code, path: @p, message: (str/concat (quote "@") "trait binding has too many segments: '" @s "' (expected " (quote "@") "trait.<Name>)"), suggestion: "", severity: "error" }] @nof))))))))))
                  (if (object/get @x "only") (array/filter @fnds (fn f (= (object/get @f "code") "ORB_BINDING_TRAIT_UNKNOWN"))) @fnds)))))))))))
      (object/get (array/reduce @orbitals { i: 0, out: @nof } (fn (oa o)
        (let ((oi : number (object/get @oa "i")) (trts : [BtTrait] (object/get @o "traits" [])))
          { i: (+ @oi 1), out: (array/concat (object/get @oa "out")
            (let ((inl : [BtIdx] (object/get (array/reduce @trts { i: 0, out: @noidx } (fn (ia t)
                    (let ((ti : number (object/get @ia "i")) (nmv (object/get @t "name" null)))
                      { i: (+ @ti 1), out: (if (= @nmv null) (object/get @ia "out") (if (object/has @t "stateMachine") (array/append (object/get @ia "out") { ti: @ti, t: @t, nm: @nmv }) (object/get @ia "out"))) }))) "out")))
              (let ((names : [string] (array/map @inl (fn e (object/get @e "nm")))))
                (let ((adj : Map string [string] (object/fromEntries (array/map @inl (fn e [(object/get @e "nm"), (object/get @entity.embeds (str/concat @oi "-" (object/get @e "ti")) @nostr)])))))
                  (if (= (array/len (array/flatten (object/values @adj))) 0)
                    @nof
                    (let ((w (array/reduce (array/range 0 (+ (* 3 (array/len @names)) (array/len (array/flatten (object/values @adj))) 2)) { stack: @nostr, idx: @nonum, vis: @nostr, found: @nostr }
                      (fn (acc step)
                        (if (> (array/len (object/get @acc "found")) 0)
                          @acc
                          (let ((stack (object/get @acc "stack")) (idx (object/get @acc "idx")) (vis (object/get @acc "vis")))
                            (if (= (array/len @stack) 0)
                              (let ((r0 (array/first (array/filter @names (fn nm (not (array/includes @vis @nm)))))))
                                (if (= @r0 null)
                                  @acc
                                  { stack: [@r0], idx: [0], vis: (array/append @vis @r0), found: @nostr }))
                              (let ((top (array/last @stack)) (i (array/last @idx)))
                                (if (= @top null)
                                  @acc
                                  (if (= @i null)
                                    @acc
                                    (let ((kids (object/get @adj @top @nostr)))
                                      (let ((d (array/nth @kids @i)))
                                        (if (= @d null)
                                          { stack: (array/dropLast @stack 1), idx: (array/dropLast @idx 1), vis: @vis, found: @nostr }
                                          (if (not (object/has @adj @d))
                                            { stack: @stack, idx: (array/append (array/dropLast @idx 1) (+ @i 1)), vis: @vis, found: @nostr }
                                            (if (array/includes @stack @d)
                                              { stack: @stack, idx: (array/append (array/dropLast @idx 1) (+ @i 1)), vis: @vis, found: (array/append (array/slice @stack (array/indexOf @stack @d) (array/len @stack)) @d) }
                                              (if (array/includes @vis @d)
                                                { stack: @stack, idx: (array/append (array/dropLast @idx 1) (+ @i 1)), vis: @vis, found: @nostr }
                                                { stack: (array/append @stack @d), idx: (array/append (array/append (array/dropLast @idx 1) (+ @i 1)) 0), vis: (array/append @vis @d), found: @nostr }))))))))))))))))
                      (let ((cy : [string] (object/get @w "found")))
                        (let ((c0 (array/first @cy)))
                          (if (= @c0 null)
                            @nof
                            (let ((ent (array/find @inl (fn e (= (object/get @e "nm") @c0)))))
                              (if (= @ent null)
                                @nof
                                [{ code: @config.codes.bindingTraitCycle.code, path: (str/concat "orbitals[" @oi "].traits[" (object/get @ent "ti") " (" @c0 ")]"), message: (str/concat (quote "@") "trait reference cycle detected: " (str/join @cy " -> ")), suggestion: (str/concat "Break the cycle by removing one of the " (quote "@") "trait.X references"), severity: "error" }]))))))))))) }))) "out"))))
[{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without the structural index (LINT_INDEX) and the trait embeds (LINT_EMBEDS), so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_INDEX and LINT_EMBEDS before LINT_INPUT; this rule did not hear both", severity: "error" }]))
        (set @entity.indexed false)
        (set @entity.embedded false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "binding-traits", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : BtProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the binding roots each inline trait uses; a trait is searched for @trait references only when a root starts with @trait."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      EMBEDS_HEARD { scope : string!  effectsWalk : Map string [string]! }
        @description "std-orb-lint-input's LINT_EMBEDS: the child trait names each trait's non-object effects embed, in walk order, by `<orbital index>-<trait index>`; the reference graph of the cycle check."
      OrbLintInput.LINT_EMBEDS -> EMBEDS_HEARD

    }
    config {
      codes : LintBindingTraitsCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without a shared program fact the rule reads (the structural index, sites, units, embeds or entities), so the rule cannot check the program" }, bindingTraitOutsideRenderUi: { code: "ORB_BINDING_TRAIT_OUTSIDE_RENDER_UI", category: "binding", description: "An @trait binding appears outside a render-ui effect, where it is the only place trait references are allowed" }, bindingTraitInvalidFormat: { code: "ORB_BINDING_TRAIT_INVALID_FORMAT", category: "binding", description: "A trait binding or trait-typed config default is not a valid trait reference" }, bindingTraitMissingName: { code: "ORB_BINDING_TRAIT_MISSING_NAME", category: "binding", description: "A @trait binding does not name the trait it refers to" }, bindingTraitSelfReference: { code: "ORB_BINDING_TRAIT_SELF_REFERENCE", category: "binding", description: "A trait references itself through a trait binding" }, bindingTraitUnknown: { code: "ORB_BINDING_TRAIT_UNKNOWN", category: "binding", description: "A @trait binding references a trait that is not declared in this orbital" }, bindingTraitCycle: { code: "ORB_BINDING_TRAIT_CYCLE", category: "binding", description: "A cycle exists in @trait references" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintBindingTraitsCli -> OrbLintBindingTraitsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint binding-traits <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint binding-traits <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint binding-traits <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "binding-traits") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint binding-traits: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "binding-traits") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint binding-traits: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-binding-traits" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint binding-traits` with its arguments and working directory."
        @synonyms "orb lint binding-traits"
      OrbLintBindingTraits.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintBindingTraitsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintBindingTraitsOrbitalStart -> OrbLintBindingTraits, OrbLintBindingTraitsCli, OrbLintInput, Packs, Versions
}
