app std-orb-lint-emit-config-ref [
  version: "1.0.0",
  inbound: ["cli-lint-emit-config-ref"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-emit-config-ref — the `orb lint emit-config-ref <file>` command, the port of ORB_EMIT_CONFIG_REF_INVALID. It lowers the file with program/read and, for every inline trait emit named `@config.<knob>`, checks the Option B contract: the knob is a declared config field (else unknown), string- or event-typed (else not string), carries a default (else no default) and that default is a string literal (else not string). Each failure is reported with its path and suggestion (status 500, exit 1). Clean answers `lint emit-config-ref: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-emit-config-ref"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintEmitConfigRefOrbital {
  entity OrbLintEmitConfigRefRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintEmitConfigRef -> OrbLintEmitConfigRefRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "emit-config-ref", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((trs (object/get @o "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                  (let ((t (array/nth @trs @ti)))
                    (array/flatten (array/map (object/get @t "emits" []) (fn e
                      (let ((ev (object/get @e "event" "")))
                        (let ((knob (str/slice @ev 8 (str/len @ev))))
                          (if (or (not (str/startsWith @ev (str/concat (quote "@") "config."))) (= @knob "") (> (array/len (str/split @knob ".")) 1))
                            []
                            (let ((field (object/get (object/get @t "config" {}) @knob null)))
                              (let ((why (if (= @field null)
                                             (str/concat "emits references `@config." @knob "` but `" @knob "` is not a declared config field on this trait.")
                                             (if (not (or (= (object/get @field "type" "") "string") (= (object/get @field "type" "") "event")))
                                               (str/concat "emits references `@config." @knob "` but the `" @knob "` config field is not string-typed (or its call-site/default value isn't a string literal).")
                                               (if (not (object/has @field "default"))
                                                 (str/concat "emits references `@config." @knob "` but the `" @knob "` config field has no declared default.")
                                                 (if (str/startsWith (json/stringify (object/get @field "default")) "\"")
                                                   ""
                                                   (str/concat "emits references `@config." @knob "` but the `" @knob "` config field is not string-typed (or its call-site/default value isn't a string literal).")))))))
                                (if (= @why "")
                                  []
                                  [(str/concat "[ORB_EMIT_CONFIG_REF_INVALID] orbitals[" @oi " (" (object/get @o "name") ")].traits[" @ti " (" (object/get @t "name") ")].emits(" @ev "): " @why "\n  suggestion: Declare `config { " @knob " : string = \"...\" }` on this trait, or reference an existing string-typed knob with a default.")]))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "emit-config-ref" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintEmitConfigRefCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintEmitConfigRefCli -> OrbLintEmitConfigRefRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint emit-config-ref <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "emit-config-ref") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint emit-config-ref: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "emit-config-ref") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "emit-config-ref")
        (emit LINT_ANSWERED { status: 500, body: "lint emit-config-ref: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-emit-config-ref" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint emit-config-ref` with its arguments and working directory."
        @synonyms "orb lint emit-config-ref, duplicate trait ids"
      OrbLintEmitConfigRef.LINT_FOUND -> LINT_FOUND
      OrbLintEmitConfigRef.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-emit-config-ref" as OrbLintEmitConfigRefPage -> OrbLintEmitConfigRef, OrbLintEmitConfigRefCli
}
