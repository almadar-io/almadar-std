app std-orb-lint-emit-config-ref [
  version: "1.0.0",
  inbound: ["cli-lint-emit-config-ref"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-emit-config-ref — the `orb lint emit-config-ref <file>` command, the port of ORB_EMIT_CONFIG_REF_INVALID. It lowers the file with program/read and, for every inline trait emit named `@config.<knob>`, checks the Option B contract: the knob is a declared config field (else unknown), string- or event-typed (else not string), carries a default (else no default) and that default is a string literal (else not string). Each failure is reported with its path and suggestion (status 500, exit 1). Clean answers `lint emit-config-ref: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-emit-config-ref"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type EmitRefValue = string | number | boolean | [EmitRefValue] | Map string EmitRefValue
type EmitRefKnob = { type : string, default : EmitRefValue }
type EmitRefEmit = { event : string }
type EmitRefTrait = { name : string, emits : [EmitRefEmit], config : Map string EmitRefKnob }
type EmitRefOrbital = { name : string, traits : [EmitRefTrait] }
type EmitRefProgram = { orbitals : [EmitRefOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintEmitConfigRefOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEmitConfigRefRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEmitConfigRef -> OrbLintEmitConfigRefRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((trs (object/get @o "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                  (let ((t (array/nth @trs @ti)))
                    (array/flatten (array/map (object/get @t "emits" []) (fn e
                      (let ((ev (object/get @e "event" "")))
                        (let ((knob (str/slice @ev 8 (str/len @ev))))
                          (if (or (not (str/startsWith @ev (str/concat (quote "@") "config."))) (= @knob "") (> (array/len (str/split @knob ".")) 1))
                            []
                            (let ((field (object/get (object/get @t "config" {}) @knob null)))
                              (let ((why (if (= @field null)
                                             (str/concat "emits references `@config." @knob "` but `" @knob "` is not a declared config field on this trait.")
                                             (if (not (or (= (object/get @field "type" "") "string") (= (object/get @field "type" "") "event")))
                                               (str/concat "emits references `@config." @knob "` but the `" @knob "` config field is not string-typed (or its call-site/default value isn't a string literal).")
                                               (if (not (object/has @field "default"))
                                                 (str/concat "emits references `@config." @knob "` but the `" @knob "` config field has no declared default.")
                                                 (if (str/startsWith (json/stringify (object/get @field "default")) "\"")
                                                   ""
                                                   (str/concat "emits references `@config." @knob "` but the `" @knob "` config field is not string-typed (or its call-site/default value isn't a string literal).")))))))
                                (if (= @why "")
                                  []
                                  [{ code: "ORB_EMIT_CONFIG_REF_INVALID", path: (str/concat "orbitals[" @oi " (" (object/get @o "name") ")].traits[" @ti " (" (object/get @t "name") ")].emits(" @ev ")"), message: @why, suggestion: (str/concat "Declare `config { " @knob " : string = \"...\" }` on this trait, or reference an existing string-typed knob with a default."), severity: "error" }]))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "emit-config-ref", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : EmitRefProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEmitConfigRefCli -> OrbLintEmitConfigRefRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint emit-config-ref: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint emit-config-ref <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "emit-config-ref") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint emit-config-ref: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "emit-config-ref") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint emit-config-ref: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-emit-config-ref" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint emit-config-ref` with its arguments and working directory."
        @synonyms "orb lint emit-config-ref, duplicate trait ids"
      OrbLintEmitConfigRef.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEmitConfigRefCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEmitConfigRefOrbitalStart -> OrbLintEmitConfigRef, OrbLintEmitConfigRefCli, OrbLintInput, Packs, Versions
}
