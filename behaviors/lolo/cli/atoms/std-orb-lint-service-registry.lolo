app std-orb-lint-service-registry [
  version: "1.0.0",
  description: "std-orb-lint-service-registry — the service lints' view of the services registry of the installed @almadar/core. It reads no file: std-orb-lint-input reads orbLanguage.services once and sends LINT_SERVICES { services } (or LINT_SERVICES_UNREAD { error }) before LINT_INPUT, which this trait keeps. SERVICE_REGISTRY_ASK { requestId } is answered by SERVICE_REGISTRY_ANSWER { requestId, unread, services }: per service its actions, and per action the declared params (name, declared type text, whether required, and the kind a literal must have: string, number, boolean, object or array, empty for a type that is not checked: a named type or a union of words that are not literals) and whether the action's response shape names a `key` field. A service with no action is declared-only: its name is known and its actions are not checked. A request that arrives before the input is heard waits; when the registry is unread the answer is unread."
]
uses Spec from "almadar-std/lint-service-registry"
type SrParam = { name : string!, type : string!, required : boolean!, kind : string! }
type SrAction = { params : [SrParam]!, hasKey : boolean! }
type SrService = { actions : Map string SrAction! }
type SrServices = Map string SrService
type SrAsk = { requestId : string! }

orbital OrbLintServiceRegistryOrbital {
  entity OrbLintServiceRegistryRun [runtime] {
    id : string!
    services : SrServices = {}
    loaded : boolean = false
    failed : boolean = false
    pending : [SrAsk] = []
  }

  trait ServiceRegistry -> OrbLintServiceRegistryRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_SERVICES_HEARD -> ready
        (set @entity.services @payload.services)
        (set @entity.loaded true)
        (emit SR_DRAIN { })
      LINT_SERVICES_UNREAD_HEARD -> ready
        (set @entity.failed true)
        (emit SR_DRAIN { })
      SERVICE_REGISTRY_ASK -> ready when (or @entity.loaded @entity.failed)
        (emit SR_RUN { requestId: @payload.requestId })
      SERVICE_REGISTRY_ASK -> ready when (not (or @entity.loaded @entity.failed))
        (set @entity.pending (array/append @entity.pending @payload))
      SR_DRAIN -> ready when (and (or @entity.loaded @entity.failed) (> (array/len @entity.pending) 0))
        (emit SR_RUN { requestId: (object/get (array/first @entity.pending) "requestId") })
        (set @entity.pending (array/slice @entity.pending 1 (array/len @entity.pending)))
      SR_DRAIN -> ready when (not (and (or @entity.loaded @entity.failed) (> (array/len @entity.pending) 0)))
      SR_RUN -> ready when @entity.failed
        (emit SERVICE_REGISTRY_ANSWER { requestId: @payload.requestId, unread: true, services: {} })
        (emit SR_DRAIN { })
      SR_RUN -> ready when (not @entity.failed)
        (emit SERVICE_REGISTRY_ANSWER { requestId: @payload.requestId, unread: false, services: @entity.services })
        (emit SR_DRAIN { })
    }

    emits {
      SERVICE_REGISTRY_ANSWER -> external { requestId : string!  unread : boolean!  services : Map string SrService! }
        @description "The services registry of the installed @almadar/core, projected for the service lints."
        @tier "internal"
      SR_DRAIN { }
        @description "Internal: answer the requests that waited for the registry."
        @tier "internal"
      SR_RUN { requestId : string! }
        @description "Internal: answer one request."
        @tier "internal"
    }

    listens {
      SERVICE_REGISTRY_ASK { requestId : string! }
        @description "Ask for the services registry."
        @tier "internal"
      LINT_SERVICES_HEARD { services : Map string SrService! }
        @description "std-orb-lint-input's LINT_SERVICES: the services registry of the installed @almadar/core, projected."
      LINT_SERVICES_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_SERVICES_UNREAD: the services registry could not be read."
    }
  }

  page boot as OrbLintServiceRegistryOrbitalStart -> ServiceRegistry
}
