app std-orb-lint-identity-unique [
  version: "1.0.0",
  inbound: ["cli-lint-identity-unique"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-identity-unique — the `orb lint identity-unique <file>` command, the port of ORB_S_IDENTITY_NOT_UNIQUE (user_identity.rs validate_user_identity, roster check). It lowers the file with program/read and reports when more than one differently named entity is tagged [identity]; primary entities shadow imported auxiliary copies. Status 500, exit 1. Clean answers `lint identity-unique: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-identity-unique"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintIdentityUniqueOrbital {
  entity OrbLintIdentityUniqueRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintIdentityUnique -> OrbLintIdentityUniqueRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "identity-unique", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (let ((prim (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                        (let ((en (object/get (array/nth @orbitals @oi) "entity" {})))
                          (if (and (validate/object @en) (object/get @en "identity" false)) [(object/get @en "name")] []))))))
                (aux (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                        (array/map (array/filter (object/get (array/nth @orbitals @oi) "auxiliaryEntities" []) (fn en (and (validate/object @en) (object/get @en "identity" false)))) (fn en (object/get @en "name"))))))))
            (let ((names (array/unique (if (> (array/len @prim) 0) @prim @aux))))
              (if (> (array/len @names) 1)
                [{ code: "ORB_S_IDENTITY_NOT_UNIQUE", path: "orbitals", message: (str/concat (array/len @names) " entities are tagged [identity]: " (str/join (array/sort @names) ", ") ". `@user` resolves to a single viewer, so more than one declaration makes every `@user.x` ambiguous."), suggestion: "Keep exactly one [identity] entity and reference it from the other orbitals (`ownerId : <IdentityEntity>`).", severity: "error" }]
                [])))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "identity-unique" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintIdentityUniqueCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintIdentityUniqueCli -> OrbLintIdentityUniqueRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint identity-unique <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "identity-unique") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint identity-unique: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "identity-unique") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "identity-unique")
        (emit LINT_ANSWERED { status: 500, body: "lint identity-unique: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-identity-unique" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint identity-unique` with its arguments and working directory."
        @synonyms "orb lint identity-unique, orb lint identity-unique, one identity entity"
      OrbLintIdentityUnique.LINT_FOUND -> LINT_FOUND
      OrbLintIdentityUnique.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-identity-unique" as OrbLintIdentityUniquePage -> OrbLintIdentityUnique, OrbLintIdentityUniqueCli
}
