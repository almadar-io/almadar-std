app std-orb-lint-identity-unique [
  version: "1.0.0",
  inbound: ["cli-lint-identity-unique"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-identity-unique — the `orb lint identity-unique <file>` command, the port of ORB_S_IDENTITY_NOT_UNIQUE (user_identity.rs validate_user_identity, roster check). It lowers the file with program/read and reports when more than one differently named entity is tagged [identity]; primary entities shadow imported auxiliary copies. Status 500, exit 1. Clean answers `lint identity-unique: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-identity-unique"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type IdentityEntity = { name : string, identity : boolean }
type IdentityOrbital = { entity : IdentityEntity, auxiliaryEntities : [IdentityEntity] }
type IdentityProgram = { orbitals : [IdentityOrbital] }

orbital OrbLintIdentityUniqueOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintIdentityUniqueRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintIdentityUnique -> OrbLintIdentityUniqueRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((prim (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                        (let ((en (object/get (array/nth @orbitals @oi) "entity" {})))
                          (if (and (validate/object @en) (object/get @en "identity" false)) [(object/get @en "name")] []))))))
                (aux (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                        (array/map (array/filter (object/get (array/nth @orbitals @oi) "auxiliaryEntities" []) (fn en (and (validate/object @en) (object/get @en "identity" false)))) (fn en (object/get @en "name"))))))))
            (let ((names (array/unique (if (> (array/len @prim) 0) @prim @aux))))
              (if (> (array/len @names) 1)
                [{ code: "ORB_S_IDENTITY_NOT_UNIQUE", path: "orbitals", message: (str/concat (array/len @names) " entities are tagged [identity]: " (str/join (array/sort @names) ", ") ". `@user` resolves to a single viewer, so more than one declaration makes every `@user.x` ambiguous."), suggestion: "Keep exactly one [identity] entity and reference it from the other orbitals (`ownerId : <IdentityEntity>`).", severity: "error" }]
                [])))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "identity-unique", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : IdentityProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintIdentityUniqueCli -> OrbLintIdentityUniqueRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint identity-unique: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint identity-unique <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "identity-unique") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint identity-unique: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "identity-unique") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint identity-unique: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-identity-unique" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint identity-unique` with its arguments and working directory."
        @synonyms "orb lint identity-unique, orb lint identity-unique, one identity entity"
      OrbLintIdentityUnique.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintIdentityUniqueCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintIdentityUniqueOrbitalStart -> OrbLintIdentityUnique, OrbLintIdentityUniqueCli, OrbLintInput, Packs, Versions
}
