app std-orb-lint-untyped-array [
  version: "1.0.0",
  inbound: ["cli-lint-untyped-array"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-untyped-array — the `orb lint untyped-array <file>` command, the port of ORB_X_UNTYPED_ARRAY (array payload fields declare an element type). It lowers the file with program/read and checks the payload fields of every trait emit and event, through nested properties at any depth with tree/fold, and the top-level fields of each orbital's primary entity (an array without items, reported at `.items`). Status 500, exit 1. Clean answers `lint untyped-array: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-untyped-array"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type FieldShape = string | number | boolean | [FieldShape] | Map string FieldShape
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintUntypedArrayOrbital {
  entity OrbLintUntypedArrayRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintUntypedArray -> OrbLintUntypedArrayRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "untyped-array", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (array/concat
                (let ((ent (object/get @orb "entity" {})))
                  (if (validate/object @ent)
                    (array/flatten (array/map (array/range 0 (array/len (object/get @ent "fields" []))) (fn fi
                      (let ((f (array/nth (object/get @ent "fields" []) @fi)))
                        (if (and (= (object/get @f "type" "") "array") (not (object/has @f "items")))
                          [{ code: "ORB_X_UNTYPED_ARRAY", path: (str/concat "orbitals[" @oi "].entity.fields[" @fi "].items"), message: (str/concat "Field '" (object/get @f "name" "<unnamed>") "' is typed `array` but its element type is undeclared."), suggestion: "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.", severity: "error" }]
                          [])))))
                    []))
                (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                  (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                    (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]")))
                      (array/concat
                        (array/flatten (array/map (array/flatten (array/map (object/get @td "emits" []) (fn em (array/map (object/get @em "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".emits(" (object/get @em "event" "") ")") }))))) (fn x (array/map (tree/fold (object/get @x "f") (fn (n k)
                              (if (validate/array @n)
                                (array/flatten @k)
                                (if (validate/object @n)
                                  (let ((nm (object/get @n "name" "")))
                                    (array/concat
                                      (if (and (= (object/get @n "type" "") "array") (not (object/has @n "properties")) (not (object/has @n "entity")) (not (object/has @n "items"))) [{ rel: "", nm: @nm }] [])
                                      (array/map (object/get @k "properties" []) (fn h { rel: (str/concat "." @nm (object/get @h "rel")), nm: (object/get @h "nm") }))))
                                  []))) FieldShape) (fn h { code: "ORB_X_UNTYPED_ARRAY", path: (str/concat (object/get @x "w") (object/get @h "rel") "." (object/get @h "nm")), message: (str/concat "Field '" (object/get @h "nm") "' is typed `array` but its element type is undeclared."), suggestion: "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.", severity: "error" })))))
                        (array/flatten (array/map (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "events" []) (fn ev (array/map (object/get @ev "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".events(" (object/get @ev "key" "") ")") }))))) (fn x (array/map (tree/fold (object/get @x "f") (fn (n k)
                              (if (validate/array @n)
                                (array/flatten @k)
                                (if (validate/object @n)
                                  (let ((nm (object/get @n "name" "")))
                                    (array/concat
                                      (if (and (= (object/get @n "type" "") "array") (not (object/has @n "properties")) (not (object/has @n "entity")) (not (object/has @n "items"))) [{ rel: "", nm: @nm }] [])
                                      (array/map (object/get @k "properties" []) (fn h { rel: (str/concat "." @nm (object/get @h "rel")), nm: (object/get @h "nm") }))))
                                  []))) FieldShape) (fn h { code: "ORB_X_UNTYPED_ARRAY", path: (str/concat (object/get @x "w") (object/get @h "rel") "." (object/get @h "nm")), message: (str/concat "Field '" (object/get @h "nm") "' is typed `array` but its element type is undeclared."), suggestion: "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.", severity: "error" }))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "untyped-array" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintUntypedArrayCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintUntypedArrayCli -> OrbLintUntypedArrayRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint untyped-array <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "untyped-array") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint untyped-array: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "untyped-array") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "untyped-array")
        (emit LINT_ANSWERED { status: 500, body: "lint untyped-array: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-untyped-array" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint untyped-array` with its arguments and working directory."
        @synonyms "orb lint untyped-array, orb lint untyped-array, untyped array"
      OrbLintUntypedArray.LINT_FOUND -> LINT_FOUND
      OrbLintUntypedArray.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-untyped-array" as OrbLintUntypedArrayPage -> OrbLintUntypedArray, OrbLintUntypedArrayCli
}
