app std-orb-lint-untyped-array [
  version: "1.0.0",
  inbound: ["cli-lint-untyped-array"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-untyped-array — the `orb lint untyped-array <file>` command, the port of ORB_X_UNTYPED_ARRAY (array payload fields declare an element type). It lowers the file with program/read and checks the payload fields of every trait emit and event, through nested properties at any depth with tree/fold, and the top-level fields of each non-spec orbital's primary and auxiliary entities (an array without items, reported at `.items`). Status 500, exit 1. Clean answers `lint untyped-array: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-untyped-array"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type FieldShape = string | number | boolean | [FieldShape?] | Map string FieldShape?
type UntypedField = { name : string, type : string, items : FieldShape }
type UntypedEntity = { fields : [UntypedField] }
type UntypedEmit = { event : string, payloadSchema : [FieldShape] }
type UntypedEvent = { key : string, payloadSchema : [FieldShape] }
type UntypedMachine = { events : [UntypedEvent] }
type UntypedTrait = { name : string, emits : [UntypedEmit], stateMachine : UntypedMachine }
type UntypedOrbital = { name : string, entity : UntypedEntity, auxiliaryEntities : [UntypedEntity], traits : [UntypedTrait], spec : boolean }
type UntypedProgram = { orbitals : [UntypedOrbital]! }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintUntypedArrayOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintUntypedArrayRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintUntypedArray -> OrbLintUntypedArrayRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (array/concat
                (let ((auxs (object/get @orb "auxiliaryEntities" [])))
                  (array/flatten (array/map
                    (array/concat [{ ent: (object/get @orb "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                      (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
                    (fn eb
                      (let ((ent (object/get @eb "ent")))
                        (if (and (validate/object @ent) (not (object/get @orb "spec" false)))
                          (array/flatten (array/map (array/range 0 (array/len (object/get @ent "fields" []))) (fn fi
                            (let ((f (array/nth (object/get @ent "fields" []) @fi)))
                              (if (and (= (object/get @f "type" "") "array") (not (object/has @f "items")))
                                [{ code: "ORB_X_UNTYPED_ARRAY", path: (str/concat (object/get @eb "base") ".fields[" @fi "].items"), message: (str/concat "Field '" (object/get @f "name" "<unnamed>") "' is typed `array` but its element type is undeclared."), suggestion: "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.", severity: "error" }]
                                [])))))
                          []))))))
                (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                  (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                    (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]")))
                      (array/concat
                        (array/flatten (array/map (array/flatten (array/map (object/get @td "emits" []) (fn em (array/map (object/get @em "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".emits(" (object/get @em "event" "") ")") }))))) (fn x (array/map (tree/fold (object/get @x "f") (fn (n k)
                              (if (validate/array @n)
                                (array/flatten (array/filter @k (fn r (validate/array @r))))
                                (if (validate/object @n)
                                  (let ((nm0 (object/get @n "name" "")))
                                   (let ((nm (if (validate/string @nm0) @nm0 "")))
                                    (array/concat
                                      (if (and (= (object/get @n "type" "") "array") (not (object/has @n "properties")) (not (object/has @n "entity")) (not (object/has @n "items"))) [{ rel: "", nm: @nm }] [])
                                      (array/map (object/get @k "properties" []) (fn h { rel: (str/concat "." @nm (let ((r0 (object/get @h "rel" ""))) (if (validate/string @r0) @r0 ""))), nm: (let ((n0 (object/get @h "nm" ""))) (if (validate/string @n0) @n0 "")) })))))
                                  []))) FieldShape) (fn h (let ((rel (let ((r0 (object/get @h "rel" ""))) (if (validate/string @r0) @r0 ""))) (hn (let ((n0 (object/get @h "nm" ""))) (if (validate/string @n0) @n0 "")))) { code: "ORB_X_UNTYPED_ARRAY", path: (str/concat (object/get @x "w") @rel "." @hn), message: (str/concat "Field '" @hn "' is typed `array` but its element type is undeclared."), suggestion: "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.", severity: "error" }))))))
                        (array/flatten (array/map (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "events" []) (fn ev (array/map (object/get @ev "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".events(" (object/get @ev "key" "") ")") }))))) (fn x (array/map (tree/fold (object/get @x "f") (fn (n k)
                              (if (validate/array @n)
                                (array/flatten (array/filter @k (fn r (validate/array @r))))
                                (if (validate/object @n)
                                  (let ((nm0 (object/get @n "name" "")))
                                   (let ((nm (if (validate/string @nm0) @nm0 "")))
                                    (array/concat
                                      (if (and (= (object/get @n "type" "") "array") (not (object/has @n "properties")) (not (object/has @n "entity")) (not (object/has @n "items"))) [{ rel: "", nm: @nm }] [])
                                      (array/map (object/get @k "properties" []) (fn h { rel: (str/concat "." @nm (let ((r0 (object/get @h "rel" ""))) (if (validate/string @r0) @r0 ""))), nm: (let ((n0 (object/get @h "nm" ""))) (if (validate/string @n0) @n0 "")) })))))
                                  []))) FieldShape) (fn h (let ((rel (let ((r0 (object/get @h "rel" ""))) (if (validate/string @r0) @r0 ""))) (hn (let ((n0 (object/get @h "nm" ""))) (if (validate/string @n0) @n0 "")))) { code: "ORB_X_UNTYPED_ARRAY", path: (str/concat (object/get @x "w") @rel "." @hn), message: (str/concat "Field '" @hn "' is typed `array` but its element type is undeclared."), suggestion: "Declare the element type as `[T]` (e.g. `[string]`) instead of the bare `array`.", severity: "error" })))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "untyped-array", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : UntypedProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintUntypedArrayCli -> OrbLintUntypedArrayRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint untyped-array <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "untyped-array") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint untyped-array: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "untyped-array") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint untyped-array: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-untyped-array" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint untyped-array` with its arguments and working directory."
        @synonyms "orb lint untyped-array, orb lint untyped-array, untyped array"
      OrbLintUntypedArray.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintUntypedArrayCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintUntypedArrayOrbitalStart -> OrbLintUntypedArray, OrbLintUntypedArrayCli, OrbLintInput, Packs, Versions
}
