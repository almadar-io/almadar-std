app std-orb-lint-entity-persistence [
  version: "1.0.0",
  inbound: ["cli-lint-entity-persistence"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-entity-persistence — the `orb lint entity-persistence <file>` command, the port of ORB_E_MISSING_COLLECTION and ORB_S_SHARED_WITHOUT_PERSISTENCE_MODE (entity.rs validate_entity). It lowers the file with program/read and reports each orbital entity that is persistent and carries no collection name, and each shared entity with no persistence mode, with its path and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-persistence: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-persistence"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type PersistenceEntity = { name : string, persistence : string, collection : string, shared : boolean }
type PersistenceOrbital = { entity : PersistenceEntity, spec : boolean }
type PersistenceProgram = { orbitals : [PersistenceOrbital] }

orbital OrbLintEntityPersistenceOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityPersistenceRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityPersistence -> OrbLintEntityPersistenceRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ent (object/get (array/nth @orbitals @oi) "entity" {})))
              (if (and (validate/object @ent) (not (object/get (array/nth @orbitals @oi) "spec" false)))
                (array/concat
                  (if (and (= (object/get @ent "persistence" "") "persistent") (not (object/has @ent "collection")))
                    [{ code: "ORB_E_MISSING_COLLECTION", path: (str/concat "orbitals[" @oi "].entity.collection"), message: "Persistent entity requires a collection name", suggestion: "Add a 'collection' property for database storage", severity: "error" }]
                    [])
                  (if (and (= (object/get @ent "shared" false) true) (not (object/has @ent "persistence")))
                    [{ code: "ORB_S_SHARED_WITHOUT_PERSISTENCE_MODE", path: (str/concat "orbitals[" @oi "].entity.persistence"), message: (str/concat "Entity '" (object/get @ent "name" "") "' is [shared] but declares no persistence mode — nothing about a shared entity may be inferred."), suggestion: "Add an explicit `persistent: <collection>` or `runtime` persistence tag alongside `[shared]`.", severity: "error" }]
                    []))
                [])))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-persistence", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PersistenceProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEntityPersistenceCli -> OrbLintEntityPersistenceRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-persistence <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-persistence") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-persistence: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-persistence") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-persistence: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-persistence" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-persistence` with its arguments and working directory."
        @synonyms "orb lint entity-persistence, duplicate field names"
      OrbLintEntityPersistence.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityPersistenceCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityPersistenceOrbitalStart -> OrbLintEntityPersistence, OrbLintEntityPersistenceCli, OrbLintInput, Packs, Versions
}
