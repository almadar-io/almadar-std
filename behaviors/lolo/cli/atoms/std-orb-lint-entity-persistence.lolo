app std-orb-lint-entity-persistence [
  version: "1.0.0",
  inbound: ["cli-lint-entity-persistence"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-persistence — the `orb lint entity-persistence <file>` command, the port of ORB_E_MISSING_COLLECTION and ORB_S_SHARED_WITHOUT_PERSISTENCE_MODE (entity.rs validate_entity and validate_all_entities). It lowers the file with program/read and reports each primary and auxiliary entity that is persistent and carries no collection name, and each shared entity (primary, auxiliary or a trait's data entity) with no persistence mode, with its path and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-persistence: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-persistence"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type PersistenceEntity = { name : string, persistence : string, collection : string, shared : boolean }
type PersistenceTrait = { name : string, dataEntities : [PersistenceEntity] }
type PersistenceOrbital = { name : string, entity : PersistenceEntity, auxiliaryEntities : [PersistenceEntity], traits : [PersistenceTrait], spec : boolean }
type PersistenceProgram = { orbitals : [PersistenceOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEntityPersistenceCodes = { eMissingCollection : LintCodeDecl , sSharedWithoutPersistenceMode : LintCodeDecl }

orbital OrbLintEntityPersistenceOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityPersistenceRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityPersistence -> OrbLintEntityPersistenceRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (default (array/nth @orbitals @oi) {})) (auxs (object/get (default (array/nth @orbitals @oi) {}) "auxiliaryEntities" [])) (trList (object/get (default (array/nth @orbitals @oi) {}) "traits" [])))
              (array/concat
                (array/flatten (array/map
                  (array/concat [{ ent: (object/get @orb "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                    (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
                  (fn eb
                    (let ((ent (object/get @eb "ent")) (base (object/get @eb "base")))
                      (if (and (validate/object @ent) (not (object/get @orb "spec" false)))
                        (array/concat
                          (if (and (= (object/get @ent "persistence" "") "persistent") (not (object/has @ent "collection")))
                            [{ code: @config.codes.eMissingCollection.code, path: (str/concat @base ".collection"), message: "Persistent entity requires a collection name", suggestion: "Add a 'collection' property for database storage", severity: "error" }]
                            [])
                          (if (and (= (object/get @ent "shared" false) true) (not (object/has @ent "persistence")))
                            [{ code: @config.codes.sSharedWithoutPersistenceMode.code, path: (str/concat @base ".persistence"), message: (str/concat "Entity '" (object/get @ent "name" "") "' is [shared] but declares no persistence mode — nothing about a shared entity may be inferred."), suggestion: "Add an explicit `persistent: <collection>` or `runtime` persistence tag alongside `[shared]`.", severity: "error" }]
                            []))
                        [])))))
                (array/flatten (array/map (array/range 0 (array/len @trList)) (fn ti
                  (let ((td (default (array/nth @trList @ti) {})) (des (object/get (default (array/nth @trList @ti) {}) "dataEntities" [])))
                    (array/flatten (array/map (array/range 0 (array/len @des)) (fn di
                      (let ((de (array/nth @des @di)))
                        (if (and (validate/object @de) (= (object/get @de "shared" false) true) (not (object/has @de "persistence")))
                          [{ code: @config.codes.sSharedWithoutPersistenceMode.code, path: (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")].dataEntities[" @di "].persistence"), message: (str/concat "Entity '" (object/get @de "name" "") "' is [shared] but declares no persistence mode — nothing about a shared entity may be inferred."), suggestion: "Add an explicit `persistent: <collection>` or `runtime` persistence tag alongside `[shared]`.", severity: "error" }]
                          []))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-persistence", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PersistenceProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintEntityPersistenceCodes = { eMissingCollection: { code: "ORB_E_MISSING_COLLECTION", category: "entity", description: "A persistent entity does not declare a collection name" }, sSharedWithoutPersistenceMode: { code: "ORB_S_SHARED_WITHOUT_PERSISTENCE_MODE", category: "schema", description: "A shared entity declares no persistence mode, and none may be inferred" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEntityPersistenceCli -> OrbLintEntityPersistenceRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-persistence <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-persistence <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-persistence") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-persistence: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-persistence") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-persistence: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-persistence" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint entity-persistence` with its arguments and working directory."
        @synonyms "orb lint entity-persistence, duplicate field names"
      OrbLintEntityPersistence.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityPersistenceCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityPersistenceOrbitalStart -> OrbLintEntityPersistence, OrbLintEntityPersistenceCli, OrbLintInput, Packs, Versions
}
