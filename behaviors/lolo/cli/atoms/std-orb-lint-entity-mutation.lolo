app std-orb-lint-entity-mutation [
  version: "1.0.0",
  inbound: ["cli-lint-entity-mutation"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-mutation - the `orb lint entity-mutation <file>` command, the port of the multi-trait entity mutation trio of entities/entity_mutation.rs. Per orbital, over its inline traits: a trait's mutated fields are the `(set @entity.<f> …)` targets in its guards, transition effects and tick effects, and its reads are every `@entity.<f>` it names there (id, createdAt and updatedAt aside). On a `[shared]` entity, a field written by two or more traits is ORB_SHARED_ENTITY_FIELD_CONFLICT, and a slot that two or more render roots read it into is ORB_SHARED_ENTITY_RENDER_AUTHORITY: a top-level render-ui effect counts as a read only when it names a field of the entity that is not `@intrinsic` (an intrinsic field is the trait's own frame, never persisted, so reading it is not a render read of the shared row — this is a deliberate difference from the Rust check), each reader is attributed to the root trait that embeds it through `@trait.<Name>` in render-ui effects. On a `[runtime]` entity that is not shared, two or more mutating traits that are not instances of one source trait and that can share a page (page membership closes over `@trait.<Name>` embeds in effects) are ORB_ENTITY_SPLIT_MUTATION when one of them reads a field it never writes that another writes. Each finding carries the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint entity-mutation: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-mutation"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type EmVal = string | number | boolean | [EmVal?] | Map string EmVal?
type EmField = { name : string, intrinsic : boolean }
type EmEntity = { name : string, shared : boolean, persistence : string, fields : [EmField] }
type EmSrc = { behavior : string, originalName : string }
type EmTransition = { guard : EmVal?, effects : [EmVal?] }
type EmTick = { effects : [EmVal?] }
type EmMachine = { transitions : [EmTransition] }
type EmTrait = { name : string, linkedEntity : string, sourceBehavior : EmSrc, stateMachine : EmMachine, ticks : [EmTick] }
type EmPage = { name : string, traits : [EmVal?] }
type EmOrbital = { name : string, entity : EmEntity, auxiliaryEntities : [EmEntity], traits : [EmTrait], pages : [EmPage] }
type EmProgram = { orbitals : [EmOrbital] }
type EmStrs = [string]
type EmNodes = [EmVal?]
type EmS = string
type EmCall = { path : string!, node : [EmVal?]!, at : number! }
type EmIndex = Map string [EmCall]
type EmRec = { nm : string, lk : string, sets : [string], reads : [string], rslots : [string], refs : [string], prefs : [string], sb : string }
type EmPageClos = { pg : string, members : [string] }
type EmClos = { vis : [string], front : [string] }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEntityMutationCodes = { sharedEntityRenderAuthority : LintCodeDecl , sharedEntityFieldConflict : LintCodeDecl , entitySplitMutation : LintCodeDecl }

orbital OrbLintEntityMutationOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityMutationRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityMutation -> OrbLintEntityMutationRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" []))) (let ((emNo : [string] []) (emItems (array/flatten (array/map @orbitals (fn o (array/flatten (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t (let ((trans : [EmTransition] (object/get @t "stateMachine.transitions" [])) (tks : [EmTick] (object/get @t "ticks" []))) (array/concat (array/map (array/filter @trans (fn x (!= (object/get @x "guard" null) null))) (fn x { w: (object/get @x "guard" null) })) (array/concat (array/flatten (array/map @trans (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))) (array/flatten (array/map @tks (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))))))))) (emKeys (array/map @emItems (fn kx (bytes/to-base64 (bytes/from-string (json/stringify @kx)))))) (emFirst (default (object/fromEntries (array/map (array/range 0 (array/len @emKeys)) (fn xk [(default (array/nth @emKeys @xk) ""), @xk]))) {})) (emFD (default (object/fromEntries (array/map (object/values @emFirst) (fn xk [(default (array/nth @emKeys @xk) ""), (let ((rt (array/nth @emItems @xk))) (default (as (default (array/concat (array/flatten (array/map (array/filter (array/map (default (as (json/nodes @rt) EmNodes) []) (fn y (default (as @y EmS) ""))) (fn y (str/startsWith @y (quote "@entity.")))) (fn y (array/flatten (array/map (array/take (str/split (str/slice @y 8 (str/len @y)) ".") 1) (fn seg (array/flatten (array/map (array/take (str/split @seg "[") 1) (fn fl (if (or (= @fl "") (= @fl "id") (= @fl "createdAt") (= @fl "updatedAt")) [] [(str/concat "r:" @fl)])))))))))) (array/flatten (array/map (object/get (default (as (tree/index @rt ["set"]) EmIndex) {}) "set" []) (fn c (let ((nd (object/get @c "node"))) (if (< (array/len @nd) 2) [] (let ((tg (array/nth @nd 1))) (if (and (validate/string @tg) (str/startsWith @tg (qu