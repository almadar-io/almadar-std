app std-orb-lint-fetch-by-id-payload [
  version: "1.0.0",
  inbound: ["cli-lint-fetch-by-id-payload"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-fetch-by-id-payload — the `orb lint fetch-by-id-payload <file>` command, the port of ORB_EFF_FETCH_BY_ID_PAYLOAD_LIST (entities/fetch_by_id_payload.rs, run per trait from closed_circuit). It needs the RESOLVED program (program/read resolve), so a `use`-imported atom's traits are checked too. For every trait with a state machine it finds each `(fetch X { emit: { success: E } … })` in transition effects (through nested arrays, not through objects), keyed when the options carry `id`. An event E that only by-id fetches produce and whose declared `data` field (the trait's emits, then its state-machine events) has a list type is reported once at `orbitals[i (O)].traits[j (T)].stateMachine.transitions[n].effects` with the Rust message and suggestion (status 500, exit 1); an event a list fetch in the same trait also produces is not reported. Clean answers `lint fetch-by-id-payload: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-fetch-by-id-payload"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type FbVal = string | number | boolean | [FbVal?] | Map string FbVal?
type FbField = { name : string, type : string }
type FbEmit = { event : string, payloadSchema : [FbField] }
type FbEvent = { key : string, payloadSchema : [FbField] }
type FbTransition = { effects : [FbVal] }
type FbMachine = { events : [FbEvent], transitions : [FbTransition] }
type FbTrait = { name : string, emits : [FbEmit], stateMachine : FbMachine }
type FbHit = { i : number!, e : string!, id : boolean! }
type FbOrbital = { name : string, traits : [FbVal] }
type FbProgram = { orbitals : [FbOrbital] }
type FbFound = { e : string, id : boolean }
type FbCall = { path : string!, node : FbVal! }
type FbIndex = Map string [FbCall]

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintFetchByIdPayloadCodes = { effFetchByIdPayloadList : LintCodeDecl }

orbital OrbLintFetchByIdPayloadOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintFetchByIdPayloadRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintFetchByIdPayload -> OrbLintFetchByIdPayloadRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])) (fetches (object/get (default (as (tree/index @payload.program ["fetch"]) FbIndex) {}) "fetch" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (default (array/nth @orbitals @oi) {})))
              (let ((trs (object/get @o "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                  (let ((t (as (array/nth @trs @ti) FbTrait)))
                    (if (or (= @t null) (= (object/get @t "stateMachine" null) null))
                      []
                      (let ((sm (default (object/get @t "stateMachine") {})))
                        (let ((trans (object/get @sm "transitions" [])))
                          (let ((found : [FbHit] (array/flatten (array/map (array/range 0 (array/len @trans)) (fn i
                                  (let ((pre (str/concat "orbitals[" @oi "].traits[" @ti "].stateMachine.transitions[" @i "].effects[")))
                                    (array/flatten (array/map (array/filter @fetches (fn c (and (str/startsWith (object/get @c "path" "") @pre) (not (str/includes (str/slice (object/get @c "path" "") (str/len @pre)) "."))))) (fn c
                                      (let ((n (object/get @c "node" null)))
                                        (if (validate/array @n)
                                          (array/flatten (array/map (array/slice @n 2 (array/len @n)) (fn a
                                            (if (validate/object @a)
                                              (let ((em (object/get @a "emit" null)))
                                                (if (and (validate/object @em) (validate/string (object/get @em "success" null)) (!= (object/get @em "success" "") ""))
                                                  (let ((hit (as { i: @i, e: (object/get @em "success"), id: (object/has @a "id") } FbHit))) (if (= @hit null) [] [@hit]))
                                                  []))
                                              []))))
                                          [])))))))))))
                            (let ((ids  (array/filter @found (fn p (object/get @p "id")))))
                              (let ((lists  (array/map (array/filter @found (fn p (not (object/get @p "id")))) (fn p (object/get @p "e")))))
                                (let ((evs  (array/unique (array/map @ids (fn p (object/get @p "e"))))))
                                  (array/flatten (array/map @evs (fn ev
                                    (if (array/includes @lists @ev)
                                      []
                                      (let ((fields  (array/concat
                                              (array/flatten (array/map (array/filter (object/get @t "emits" []) (fn e (= (object/get @e "event" "") @ev))) (fn e (object/get @e "payloadSchema" []))))
                                              (array/flatten (array/map (array/filter (object/get @sm "events" []) (fn e (= (object/get @e "key" "") @ev))) (fn e (object/get @e "payloadSchema" [])))))))
                                        (let ((field  (array/find @fields (fn f (= (object/get @f "name" "") "data")))) (ih (array/find @ids (fn p (= (object/get @p "e") @ev)))))
                                          (if (or (= @field null) (= @ih null) (not (str/startsWith (object/get @field "type" "") "[")))
                                            []
                                            [{ code: @config.codes.effFetchByIdPayloadList.code, path: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")].stateMachine.transitions[" (object/get @ih "i") "].effects"), message: (str/concat "`(fetch … { id: … })` delivers one row as `payload.data`, but `" @ev "` declares `data : " (object/get @field "type" "") "`"), suggestion: (str/concat "Declare `" @ev " { data : <Row> }` (a struct type of the fields read) and read it with `(object/get ?data <field> <default>)`"), severity: "error" }])))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "fetch-by-id-payload", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : FbProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintFetchByIdPayloadCodes = { effFetchByIdPayloadList: { code: "ORB_EFF_FETCH_BY_ID_PAYLOAD_LIST", category: "effect", description: "A fetch by id effect takes its id from a payload that is a list rather than a single value" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintFetchByIdPayloadCli -> OrbLintFetchByIdPayloadRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint fetch-by-id-payload <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint fetch-by-id-payload <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "fetch-by-id-payload") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint fetch-by-id-payload: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "fetch-by-id-payload") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint fetch-by-id-payload: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-fetch-by-id-payload" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint fetch-by-id-payload` with its arguments and working directory."
        @synonyms "orb lint fetch-by-id-payload"
      OrbLintFetchByIdPayload.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintFetchByIdPayloadCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintFetchByIdPayloadOrbitalStart -> OrbLintFetchByIdPayload, OrbLintFetchByIdPayloadCli, OrbLintInput, Packs, Versions
}
