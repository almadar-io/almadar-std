app std-orb-lint-orbital-ref-extend [
  version: "1.0.0",
  inbound: ["cli-lint-orbital-ref-extend"],
  fs: { cwd: "**": [read], "/**": [read] },
  description: "std-orb-lint-orbital-ref-extend — the `orb lint orbital-ref-extend <file>` command, the port of validate_orbital_ref_extend_diagnostics and the extend collection in phases/inline/orbital.rs. For each orbital written as a reference to an imported orbital (`orbital X = Alias.orbitals.Y { extend { … } }`) it pairs the unresolved call site with the resolved upstream orbital (std-orb-lint-call-site-input) and reports ORB_O_EXTEND_FIELD_COLLISION (error: an extend field already on the upstream primary entity after `fields {}` renames, or equal to a `fields {}` rename target) and ORB_O_EXTEND_FIELD_UNREAD (warning: no kept upstream trait, read as the compiler's deferred import load sees it with the reference's `traits { }` overrides applied and its field names read through the `fields {}` renames, and no sibling trait reads, sets or renders the field, and no surviving orbital config knob value names it), at `orbitals[<index>].extend(<field>)` with the compiler's messages and suggestions (status 500 when any finding is reported, exit 1). Clean answers `lint orbital-ref-extend: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500. A call site whose import does not resolve is skipped: the compiler reports that failure itself."
]
uses Spec from "almadar-std/lint-orbital-ref-extend"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type XfVal = string | number | boolean | [XfVal?] | Map string XfVal?
type XfNodes = [XfVal?]
type XfField = { name : string }
type XfEntity = { fields : [XfField] }
type XfKnob = { default : XfVal?, forwardedFrom : string, nestedForwardedFrom : [string], type : string, label : string, description : string, synonyms : string, tier : string }
type XfTransition = { guard : XfVal?, effects : [XfVal?] }
type XfListen = { guard : XfVal?, payloadMapping : Map string XfVal? }
type XfMachine = { transitions : [XfTransition] }
type XfTrait = { name : string, stateMachine : XfMachine?, ticks : [XfTransition], listens : [XfListen], config : Map string XfKnob? }
type XfTraitOverride = { config : Map string XfKnob?, fields : Map string string? }
type XfRef = { ref : string, extend : [XfField], fields : Map string string?, config : Map string XfKnob?, traits : Map string XfTraitOverride? }
type XfUse = { from : string!, as : string! }
type XfOrbital = { name : string, uses : [XfUse], reference : XfRef?, entity : XfVal?, traits : [XfTrait], config : Map string XfKnob? }
type XfProgram = { orbitals : [XfOrbital] }
type XfRefRow = { kind : string!, path : string!, declaration : XfOrbital! }
type XfKept = { orbital : number!, traits : [string]! }
type XfRename = { from : string!, to : string! }
type XfKeptTrait = { reads : [string]!, tf : [XfRename]!, forwards : XfNodes! }
type XfTarget = { oi : number!, reference : string!, ext : [string]!, existing : [string]!, renames : [string]!, sources : [XfRename]!, kept : [XfKeptTrait]!, sibReads : [string]!, cfgNames : [string]! }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintOrbitalRefExtendCodes = { oExtendFieldCollision : LintCodeDecl , oExtendFieldUnread : LintCodeDecl }

orbital OrbLintOrbitalRefExtendOrbital {
  uses CsInput from "std/behaviors/std-orb-lint-call-site-input"

