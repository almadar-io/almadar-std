        (emit LINT_SITES_READY { })
      LINT_SITES_READY -> ready
        (set @entity.findings (array/flatten (array/map @entity.targets (fn tg (let ((ext (object/get @tg "ext")) (existing (object/get @tg "existing")) (renames (object/get @tg "renames")) (sources (object/get @tg "sources")) (refName (object/get @tg "reference")) (oi (object/get @tg "oi")) (kept (object/get @tg "kept")) (sibReads (object/get @tg "sibReads")) (cfgNames (object/get @tg "cfgNames"))) (let ((unread (array/filter @ext (fn c (and (not (array/includes @existing @c)) (not (array/includes @renames @c)) (not (array/some @kept (fn kt (array/some (array/flatten (array/map (array/concat (array/map (array/filter @sources (fn p (= (object/get @p "to") @c))) (fn p (object/get @p "from"))) (if (array/some @sources (fn p (= (object/get @p "from") @c))) [] [@c])) (fn y (array/concat (array/map (array/filter (object/get @kt "tf") (fn p (= (object/get @p "to") @y))) (fn p (object/get @p "from"))) (if (array/some (object/get @kt "tf") (fn p (= (object/get @p "from") @y))) [] [@y]))))) (fn x (array/includes (object/get @kt "reads") (json/stringify @x))))))) (not (array/includes @sibReads (json/stringify @c))) (not (array/includes @cfgNames (json/stringify @c)))))))) (array/concat (array/flatten (array/map @ext (fn n (if (array/includes @existing @n) [{ code: @config.codes.oExtendFieldCollision.code, path: (str/concat "orbitals[" @oi "].extend(" @n ")"), message: (str/concat "`extend {}` field '" @n "' collides with an existing field on '" @refName "': already declared on the upstream primary entity (after `fields {}` renames)"), suggestion: (str/concat "Rename '" @n "' in `extend {}` to a name not already on the upstream primary entity and not a `fields {}` rename target."), severity: "error" }] (if (array/includes @renames @n) [{ code: @config.codes.oExtendFieldCollision.code, path: (str/concat "orbitals[" @oi "].extend(" @n ")"), message: (str/concat "`extend {}` field '" @n "' collides with an existing field on '" @refName "': equals a `fields {}` rename target"), su