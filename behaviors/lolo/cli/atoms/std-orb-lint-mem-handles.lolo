app std-orb-lint-mem-handles [
  version: "1.0.0",
  inbound: ["cli-lint-mem-handles"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-mem-handles — the `orb lint mem-handles <file>` command, the typestate check of EXEC-METAL-3 over a trait's transition graph. It lowers the file with program/read and, for every inline trait that calls a mem/ operator, walks the graph (transition = edge from each `from` state to its `to` state, guards ignored, so every written path counts) carrying the set of handle facts true on some path into each state until nothing changes. HANDLE SOURCE: a handle is named only by the exact argument `@entity.<field>` (or, inside one transition, `@payload.<field>`); an argument that is anything else (a let binding, a computed value, an array element) is skipped, no finding. A handle enters a field only where a transition sets `@entity.<f>` from `@payload.arena`, `@payload.block` or `@payload.borrow` (the documented success payloads of mem/arena-new, mem/alloc and mem/borrow); any other `set @entity.<f>` rebinds f and forgets what was known of it. Order inside one effect or guard is its pre-order, mem calls before the sets nested in the same top-level effect. ORB_MEM_USE_AFTER_FREE: a mem/ call taking the handle (alloc, borrow, write, read, read-uint, length) on a path after mem/free, mem/arena-drop or mem/release of the same source. ORB_MEM_DOUBLE_FREE: a second mem/free, mem/arena-drop or mem/release of the same source on a path; dropping an arena also kills every block field the trait allocated from that arena field (the link is a mem/alloc whose success route sets that field from `@payload.block`), so a later free of such a block is a double free. ORB_MEM_ALIAS: a mem/borrow with the literal mode \"exclusive\" of a block source while a borrow of that source is live, or any borrow while an exclusive one is live; a borrow is live from the transition that sets its field from `@payload.borrow` (the borrow effect's success route; the field must be set by exactly one borrow call's route, else it is untracked) until mem/release of that field, and two borrow calls of one source inside one transition conflict at once. ORB_MEM_LEAK: a mem/arena-new whose arena is stored in an entity field (success route sets it from `@payload.arena`) and reaches a RESTING state of the trait without mem/arena-drop of that field on some path; RESTING means the trait's initial state or a state with no transition to a different state. A `stack` arena (literal kind) dies with its dispatch and is never a leak. Not tracked: handles outside the file's inline traits (composed `uses` traits are their own file's), handles passed through a payload, a let or an emit, and arenas overwritten without a drop. Clean answers `lint mem-handles: clean` (status 200, exit 0); findings are status 500, exit 1. Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-mem-handles"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type MhValue = string | number | boolean | [MhValue?] | Map string MhValue?
type MhCall = [MhValue?]
type MhEmit = { success : string! }
type MhOpts = { emit : MhEmit! }
type MhOp = { k : string!, j : number!, at : string!, h : string!, src : string!, key : string!, lit : string!, ev : string!, f : string!, v : string! }
type MhT = { j : number!, ev : string!, to : string!, from : [string]!, ops : [MhOp]! }
type MhLink = { f : string!, h : string!, tgt : string! }
type MhAcc = { s : [string]!, f : [OrbFinding]! }
type MhRound = { facts : Map string [string]!, fnd : [OrbFinding]! }
type MhFrom = string | [string]
type MhState = { name : string, isInitial : boolean }
type MhTransition = { from : MhFrom, to : string, event : string, guard : MhValue, effects : [MhValue] }
type MhMachine = { states : [MhState], transitions : [MhTransition] }
type MhTrait = { name : string, stateMachine : MhMachine }
type MhOrbital = { name : string, traits : [MhTrait] }
type MhProgram = { orbitals : [MhOrbital] }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type GtCallHit = { path : string, node : GtVal?, at : number }
type GtVal = string | number | boolean | [GtVal?] | Map string GtVal?
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintMemHandlesCodes = { useAfterFree : LintCodeDecl, doubleFree : LintCodeDecl, alias : LintCodeDecl, leak : LintCodeDecl , lintIndexMissing : LintCodeDecl }

orbital OrbLintMemHandlesOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintMemHandlesRun [runtime] {
    sCalls : Map string [GtCallHit] = {}
    sitesCallsHeard : boolean = false
    sitesCallsScope : string = ""
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintMemHandles -> OrbLintMemHandlesRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SITES_HEARD -> ready
        (set @entity.sCalls @payload.calls)
        (set @entity.sitesCallsHeard true)
        (set @entity.sitesCallsScope @payload.scope)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (and @entity.sitesCallsHeard (= @entity.sitesCallsScope @payload.scope))
(let ((orbitals (object/get @payload.program "orbitals" [])) (memHits : [GtCallHit] (array/flatten (array/map (array/filter (object/keys @entity.sCalls) (fn h (str/startsWith @h "mem/"))) (fn h (object/get @entity.sCalls @h []))))))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (default (array/nth @orbitals @oi) {})))
              (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                (let ((td (default (array/nth (object/get @orb "traits" []) @ti) {})))
                  (if (or (not (validate/object (object/get @td "stateMachine" null))) (not (array/some @memHits (fn mh (str/startsWith (object/get @mh "path" "") (str/concat "orbitals[" @oi "].traits[" @ti "]"))))))
                    []
                    (let ((tx (object/get (object/get @td "stateMachine" {}) "transitions" []))
                          (stNames : [string] (array/map (object/get (object/get @td "stateMachine" {}) "states" []) (fn s (object/get @s "name" ""))))
                          (initials : [string] (array/map (array/filter (object/get (object/get @td "stateMachine" {}) "states" []) (fn s (object/get @s "isInitial" false))) (fn s (object/get @s "name" ""))))
                          (sig : string (str/slice "x@" 1))
                          (prefix : string (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")].stateMachine")))
                      (let ((perT : [MhT] (array/map (array/range 0 (array/len @tx)) (fn j
                              (let ((t (default (array/nth @tx @j) {})))
                                (let ((items (array/concat (if (object/has @t "guard") [(object/get @t "guard")] []) (object/get @t "effects" [])))
                                      (at : string (str/concat @prefix ".transitions[" @j "]")))
                                  { j: @j,
                                    ev: (object/get @t "event" ""),
                                    to: (object/get @t "to" ""),
                                    from: (let ((f (object/get @t "from" ""))) (if (validate/array @f) @f [@f])),
                                    ops: (array/flatten (array/map @items (fn e
                                      (let ((nd (array/filter (array/map (json/nodes [@e]) (fn n (default (as @n MhCall) []))) (fn c (and (> (array/len @c) 0) (!= (as (array/first @c) string) null))))))
                                        (array/concat
                                          (array/map (array/filter @nd (fn c (str/startsWith (default (as (array/first @c) string) "") "mem/"))) (fn c
                                            (let ((hd : string (default (as (array/first @c) string) "")) (a0 : string (default (as (array/nth @c 1) string) "")) (a1 : string (default (as (array/nth @c 2) string) "")) (opt (as (array/last @c) MhOpts)))
                                              { k: "mem", j: @j, at: @at, h: @hd, src: @a0, f: "", v: "",
                                                key: (if (str/startsWith @a0 (str/concat @sig "entity.")) (str/slice @a0 8) (if (str/startsWith @a0 (str/concat @sig "payload.")) (str/concat "payload." (str/slice @a0 9)) "")),
                                                lit: (if (= @hd "mem/arena-new") @a0 @a1),
                                                ev: (if (= @opt null) "" (object/get (object/get @opt "emit") "success" "")) })))
                                          (array/map (array/filter @nd (fn c (and (= (default (as (array/first @c) string) "") "set") (> (array/len @c) 2) (str/startsWith (default (as (array/nth @c 1) string) "") (str/concat @sig "entity."))))) (fn c
                                            { k: "set", j: @j, at: @at, h: "", src: "", key: "", lit: "", ev: "",
                                              f: (str/slice (default (as (array/nth @c 1) string) "") 8),
                                              v: (default (as (array/nth @c 2) string) "") }))))))) }))))))
                        (if (not (array/some @perT (fn p (> (array/len (object/get @p "ops")) 0))))
                          []
                          (let ((rows : [MhLink] (array/flatten (array/map (array/flatten (array/map @perT (fn p (array/filter (object/get @p "ops") (fn o (and (= (object/get @o "k") "mem") (!= (object/get @o "ev") "") (array/includes ["mem/alloc" "mem/borrow" "mem/arena-new"] (object/get @o "h")))))))) (fn o
                                  (let ((want : string (if (= (object/get @o "h") "mem/alloc") (str/concat @sig "payload.block") (if (= (object/get @o "h") "mem/borrow") (str/concat @sig "payload.borrow") (str/concat @sig "payload.arena"))))
                                        (tgt : string (if (= (object/get @o "h") "mem/borrow") (str/concat (object/get @o "key") "|" (object/get @o "lit")) (if (= (object/get @o "h") "mem/alloc") (object/get @o "key") (object/get @o "lit")))))
                                    (array/flatten (array/map @perT (fn p
                                      (if (!= (object/get @p "ev") (object/get @o "ev"))
                                        []
                                        (array/map (array/filter (object/get @p "ops") (fn s (and (= (object/get @s "k") "set") (= (object/get @s "v") @want)))) (fn s
                                          { f: (object/get @s "f"), h: (object/get @o "h"), tgt: @tgt }))))))))))))
                            (let ((links : [MhLink] (array/filter @rows (fn r (and (not (array/some @rows (fn r2 (and (= (object/get @r2 "f") (object/get @r "f")) (= (object/get @r2 "h") (object/get @r "h")) (!= (object/get @r2 "tgt") (object/get @r "tgt")))))) (or (= (object/get @r "h") "mem/arena-new") (and (!= (object/get @r "tgt") "") (not (str/startsWith (object/get @r "tgt") "|")))))))))
                              (let ((rinit : MhRound { facts: {}, fnd: [] }))
                               (let ((done : MhRound (array/reduce (array/range 0 (+ (array/len @stNames) 1)) @rinit (fn racc r
                                      (let ((tinit : MhRound { facts: (object/get @racc "facts"), fnd: [] }))
                                       (array/reduce @perT @tinit (fn acc2 p
                                        (let ((inM : Map string [string] (object/get @acc2 "facts")))
                                          (let ((inF : [string] (array/unique (array/flatten (array/map (array/flatten (array/map (object/get @p "from") (fn s (if (= @s "*") @stNames [@s])))) (fn s (object/get @inM @s []))))))
                                                (to : string (object/get @p "to"))
                                                (ainit : MhAcc { s: [], f: [] }))
                                            (let ((res : MhAcc (array/reduce (object/get @p "ops") (let ((a0 : MhAcc { s: @inF, f: [] })) @a0) (fn acc o
                                                    (let ((S : [string] (object/get @acc "s")) (F : [OrbFinding] (object/get @acc "f")) (k : string (object/get @o "key")) (h : string (object/get @o "h")) (lit : string (object/get @o "lit")))
                                                      (if (= (object/get @o "k") "set")
                                                        (let ((f : string (object/get @o "f")) (v : string (object/get @o "v")))
                                                          (let ((bl (array/find @links (fn l (and (= (object/get @l "f") @f) (= (object/get @l "h") "mem/borrow")))))
                                                                (made (array/find @links (fn l (and (= (object/get @l "f") @f) (= (object/get @l "h") "mem/arena-new") (!= (object/get @l "tgt") "stack"))))))
                                                            { s: (array/concat
                                                                   (array/filter @S (fn x (not (or (= @x (str/concat "F:" @f)) (and (or (str/startsWith @x "BX:") (str/startsWith @x "BS:")) (str/endsWith @x (str/concat ":" @f))) (and (= @v (str/concat @sig "payload.arena")) (str/startsWith @x (str/concat "A:" @f ":"))) (and (= @v (str/concat @sig "payload.block")) (or (str/startsWith @x (str/concat "BX:" @f ":")) (str/startsWith @x (str/concat "BS:" @f ":"))))))))
                                                                   (if (and (= @v (str/concat @sig "payload.arena")) (!= @made null)) [(str/concat "A:" @f ":" (object/get @o "j"))] [])
                                                                   (if (and (= @v (str/concat @sig "payload.borrow")) (!= @bl null) (array/includes ["exclusive" "shared"] (default (array/nth (str/split (object/get @bl "tgt") "|") 1) "")))
                                                                     [(str/concat (if (= (array/nth (str/split (object/get @bl "tgt") "|") 1) "exclusive") "BX" "BS") ":" (default (array/first (str/split (object/get @bl "tgt") "|")) "") ":" @f)]
                                                                     [])),
                                                              f: @F }))
                                                        (if (= @k "")
                                                          @acc
                                                          (let ((src : string (object/get @o "src")) (at : string (object/get @o "at"))
                                                                (isEnd : boolean (array/includes ["mem/free" "mem/arena-drop" "mem/release"] @h))
                                                                (freed : boolean (array/includes @S (str/concat "F:" @k)))
                                                                (modeOk : boolean (and (= @h "mem/borrow") (array/includes ["exclusive" "shared"] @lit))))
                                                            (let ((conflict : boolean (and @modeOk (array/some @S (fn x (or (str/startsWith @x (str/concat "BX:" @k ":")) (str/startsWith @x (str/concat "pBX:" @k ":")) (and (= @lit "exclusive") (or (str/startsWith @x (str/concat "BS:" @k ":")) (str/startsWith @x (str/concat "pBS:" @k ":"))))))))))
                                                              { s: (if (= @h "mem/free")
                                                                     (array/concat @S [(str/concat "F:" @k)])
                                                                     (if (= @h "mem/arena-drop")
                                                                       (let ((blocks : [string] (array/map (array/filter @links (fn l (and (= (object/get @l "h") "mem/alloc") (= (object/get @l "tgt") @k)))) (fn l (object/get @l "f"))))) (array/concat (array/filter @S (fn x (not (or (str/startsWith @x (str/concat "A:" @k ":")) (array/some @blocks (fn b (or (str/startsWith @x (str/concat "BX:" @b ":")) (str/startsWith @x (str/concat "BS:" @b ":"))))))))) [(str/concat "F:" @k)] (array/map @blocks (fn b (str/concat "F:" @b)))))
                                                                       (if (= @h "mem/release")
                                                                         (array/concat (array/filter @S (fn x (not (and (or (str/startsWith @x "BX:") (str/startsWith @x "BS:")) (str/endsWith @x (str/concat ":" @k)))))) [(str/concat "F:" @k)])
                                                                         (if @modeOk
                                                                           (array/concat @S [(str/concat (if (= @lit "exclusive") "pBX:" "pBS:") @k ":")])
                                                                           @S)))),
                                                                f: (array/concat @F
                                                                     (if (and @freed (not @isEnd))
                                                                       [{ code: @config.codes.useAfterFree.code, path: @at, message: (str/concat "`(" @h " " @src " ...)` uses a handle that `mem/free`, `mem/arena-drop` or `mem/release` already ended on some path to this transition"), suggestion: "Stop using the handle after it is freed, dropped or released, or rebind the field from a fresh allocation first", severity: "error" }]
                                                                       [])
                                                                     (if (and @freed @isEnd)
                                                                       [{ code: @config.codes.doubleFree.code, path: @at, message: (str/concat "`(" @h " " @src ")` ends a handle that `mem/free`, `mem/arena-drop` or `mem/release` already ended on some path to this transition"), suggestion: "End each handle once on every path, or set the field to a new handle between the two", severity: "error" }]
                                                                       [])
                                                                     (if @conflict
                                                                       [{ code: @config.codes.alias.code, path: @at, message: (str/concat "`(mem/borrow " @src " \"" @lit "\")` borrows a block that another borrow of it (an exclusive one, or any when this one is exclusive) still holds on some path to this transition"), suggestion: "`mem/release` the earlier borrow before borrowing again", severity: "error" }]
                                                                       [])) })))))))))
                                              { facts: (object/set @inM @to (array/unique (array/concat (object/get @inM @to []) (array/filter (object/get @res "s") (fn x (not (or (str/startsWith @x "pB") (str/startsWith @x (str/concat "F:payload."))))))))),
                                                fnd: (array/concat (object/get @acc2 "fnd") (object/get @res "f")) }))))))))))
                                (let ((inFinal : Map string [string] (object/get @done "facts"))
                                      (resting : [string] (array/filter @stNames (fn s (or (array/includes @initials @s) (not (array/some @perT (fn p (and (!= (object/get @p "to") @s) (or (array/includes (object/get @p "from") @s) (array/includes (object/get @p "from") "*")))))))))))
                                  (array/concat (object/get @done "fnd")
                                    (array/map (array/unique (array/flatten (array/map @resting (fn r (array/filter (object/get @inFinal @r []) (fn x (str/startsWith @x "A:"))))))) (fn fact
                                      (let ((parts : [string] (str/split @fact ":")))
                                        { code: @config.codes.leak.code,
                                          path: (str/concat @prefix ".transitions[" (default (array/nth @parts 2) "") "]"),
                                          message: (str/concat "The arena stored in '" @sig "entity." (default (array/nth @parts 1) "") "' can reach the resting state(s) '" (str/join (array/filter @resting (fn r (array/includes (object/get @inFinal @r []) @fact))) "', '") "' without `mem/arena-drop`"),
                                          suggestion: "Drop the arena on every path to a resting state, including the failure routes",
                                          severity: "error" }))))))))))))))))))))))
[{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without LINT_SITES, so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_SITES before LINT_INPUT; this rule did not hear it", severity: "error" }]))
        (set @entity.sitesCallsHeard false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "mem-handles", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : MhProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      SITES_HEARD { scope : string!  guardHeads : Map string [string]!  guardRoots : Map string [string]!  calls : Map string [GtCallHit]!  trait : [GtCallHit]!  entity : [GtCallHit]! }
        @description "std-orb-lint-input's LINT_SITES: guard heads and roots, the call hits by head and the @trait. and @entity. leaves."
      OrbLintInput.LINT_SITES -> SITES_HEARD
    }
    config {
      codes : LintMemHandlesCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without the structural index the rule gates on, so the rule cannot check the program" }, useAfterFree: { code: "ORB_MEM_USE_AFTER_FREE", category: "mem", description: "A mem/ call takes a handle after it was freed, dropped or released on some path" }, doubleFree: { code: "ORB_MEM_DOUBLE_FREE", category: "mem", description: "A handle is freed, dropped or released a second time on some path" }, alias: { code: "ORB_MEM_ALIAS", category: "mem", description: "An exclusive borrow of a block while another borrow of it is live, or a borrow while an exclusive one is live" }, leak: { code: "ORB_MEM_LEAK", category: "mem", description: "An arena reaches a resting state on some path without being dropped" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintMemHandlesCli -> OrbLintMemHandlesRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint mem-handles <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint mem-handles <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "mem-handles") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint mem-handles: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "mem-handles") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint mem-handles: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-mem-handles" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint mem-handles` with its arguments and working directory."
        @synonyms "orb lint mem-handles"
      OrbLintMemHandles.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintMemHandlesCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintMemHandlesOrbitalStart -> OrbLintMemHandles, OrbLintMemHandlesCli, OrbLintInput, Packs, Versions
}
