                          [{ oi: @oi, ti: @ti, tn: (object/get @t "name" ""), src: (object/get @l "src"), li: (object/get @l "li"), e: @e, event: (object/get @l "event"), body: (array/nth @x 2), pre: (array/slice @effs 0 @e) }]
                          @nou))))))))))))))))))))))) (let ((cands : [VsCand] (array/map @units (fn u
  (let ((body (object/get @u "body" null)))
    (if (not (array/some (array/flatten (object/values (tree/index @body ["let"] { prefixes: [(quote "@entity.")] }))) (fn hh (validate/string (object/get @hh "node" null))))) @nocand
