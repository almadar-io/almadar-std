        (set @entity.haveOwners true)
        (emit LINT_COMPUTE { })
      OWNERS_HEARD -> ready when (not @entity.haveFired)
        (set @entity.owners @payload.owners)
        (set @entity.haveOwners true)
      LINT_COMPUTE -> ready
        (set @entity.findings (let ((noe : [VstrNode?] []) (nos : [string] []) (nob : [boolean] []) (nobm : Map string boolean {}) (nobp : VsByPattern {}) (noh : [VsHit] []) (noli : [VsListen] []) (noem : [VsEmit] []) (notrs : [VsTrans] []) (notks : [VsTick] []) (notraits : [VsTrait] []) (noorbs : [VsOrbital] []) (noorb : VsOrbital {}) (notrait : VsTrait {}) (notrans : VsTrans {}) (notick : VsTick {}) (nou1 : VsUnit { oi: 0, ti: 0, tn: "", src: "", li: 0, e: 0, event: "", body: null, pre: [] }) (nofact : VsFact { direct: false, embeds: [] }) (noobj : VsObj {}) (nolet : VsLets {}) (nocand : VsCand {}) (nopend : [VsPend] []) (nocfg : Map string VsField {}) (nofield : VsField {}) (noo : [VsOutlet] []) (noaff : VsAffRow { aff: [], prod: [] }) (nof : [OrbFinding] []) (nopat : VsPattern {}) (nopat2 : Map string VsPatProp {}) (nopp : VsPatProp {})) (let ((strandOrbs : [number] (array/unique (array/map (array/filter @entity.owners (fn w (array/includes ["channel", "sole"] (object/get @w "kind" "")))) (fn w (object/get @w "orbital" 0)))))) (let ((orbs : [VsOrbital] (default (as (object/get @entity.program "orbitals" null) VsOrbitals) @noorbs))) (let ((outlets : Map string [VsOutlet] (default (object/fromEntries (array/map (object/keys @entity.patterns) (fn pn [(str/replaceAll (str/replaceAll @pn "~" "~t") "." "~d"), (array/flatten (array/map (object/keys (object/get (object/get @entity.patterns @pn @nopat) "props" @nopat2)) (fn pr
