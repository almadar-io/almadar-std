app std-orb-lint-viewer-stranded [
  version: "1.0.0",
  inbound: ["cli-lint-viewer-stranded"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-viewer-stranded - the `orb lint viewer-stranded <file>` command, the port of ORB_CIRCUIT_VIEWER_STRANDED (circuit/closed_circuit.rs validate_viewer_stranded_for_owner). For each page whose content owner std-orb-lint-page-content-owner resolves to a channel or a sole writer, an arm of the owner that is a user-triggered affordance (an event some trait of the orbital fires by a control or an effect, emits or listens for, closed over listens routes; async-result events of fetch and persist and bus-excluded events are no affordance) and repaints a main slot with a body that offers no way on is ORB_CIRCUIT_VIEWER_STRANDED. A body offers a way on when it holds a content-body pattern (a pattern with an entity-kind prop), a pattern node whose event, event-ref, event-listen, callback or event-map prop (or the eventField of an event-list item) holds a live value (a binding, or a non-empty name the bus delivers), an @trait.X embed of a trait that is not inline in the orbital or whose own main bodies offer a way on (the least fixed point over the embed graph, so a cycle earns no credit), or an @entity.f or @config.k binding with no same-arm literal source (a set before the render-ui in the same arm, through let, do and if, or a tree-shaped config default), whose literal trees are read the same way. An arm that runs its own fetch or persist, a null body, an arm that leaves for a state with another producible arm, and a second arm of an event already reported are silent. Each finding carries the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint viewer-stranded: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-viewer-stranded"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type VstrNode = string | number | boolean | [VstrNode?] | Map string VstrNode?
type VstrNodes = [VstrNode?]
type VsTrans = { from : string | [string], to : string, event : string, effects : [VstrNode?] }
type VsMachine = { transitions : [VsTrans] }
type VsTick = { effects : [VstrNode?] }
type VsField = { default : VstrNode? }
type VsEmit = { event : string }
type VsListen = { event : string, triggers : string }
type VsTrait = { name : string, stateMachine : VsMachine, ticks : [VsTick], config : Map string VsField?, emits : [VsEmit], listens : [VsListen] }
type VsOrbital = { name : string, traits : [VsTrait] }
type VsProgram = { orbitals : [VsOrbital] }
type VsPatProp = { kind : string? }
type VsPattern = { props : Map string VsPatProp? }
type VsByPattern = { pattern : string, prop : string, field : string }
type VsOutlet = { prop : string, field : string }
type VsUnit = { oi : number!, ti : number!, tn : string!, src : string!, li : number!, e : number!, event : string!, body : VstrNode?, pre : [VstrNode?]! }
type VsHit = { at : number, path : string, node : [VstrNode?] }
type VsStr = string
type VsObj = Map string VstrNode?
type VsAcc = { lets : VsLets!, fields : VsCand! }
type VsRes = { leaves : [VstrNode?]!, pend : [VsPend]! }
type VsPend = { e : VstrNode?, ll : VsLets }
type VsLets = Map string VstrNode?
type VsCand = Map string [VstrNode?]
type VsFact = { direct : boolean!, embeds : [string]! }
type VsPoolSt = { pool : [VstrNode?]!, re : [string]!, rc : [string]!, rt : [string]! }
type VsWay = { w : Map string boolean, uw : [boolean] }
type VsAffRow = { aff : [string], prod : [string] }
type VsAff = Map string VsAffRow
type VsOrbitals = [VsOrbital]
type VsOwner = { orbital : number, page : number, kind : string, names : [string] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintViewerStrandedCodes = { circuitViewerStranded : LintCodeDecl }

type WalkSlot = { kind : string!, args : [number] }
orbital OrbLintViewerStrandedOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Fired from "std/behaviors/std-orb-fired-events"
  uses Owner from "std/behaviors/std-orb-lint-page-content-owner"

  entity OrbLintViewerStrandedRun [runtime] {
