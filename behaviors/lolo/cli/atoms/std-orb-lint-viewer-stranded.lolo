                { lets: (object/merge (object/get @acc "lets") (default (default (object/fromEntries (array/map (array/filter (default (as (array/nth @n 1) VstrNodes) @noe) (fn bp (let ((bpa (default (as @bp VstrNodes) @noe))) (and (>= (array/len @bpa) 2) (!= (as (array/nth @bpa 0) VsStr) null))))) (fn bp [(default (as (array/nth (default (as @bp VstrNodes) @noe) 0) VsStr) ""), (array/nth (default (as @bp VstrNodes) @noe) 1)]))) {}) {})), fields: (object/get @acc "fields") }
