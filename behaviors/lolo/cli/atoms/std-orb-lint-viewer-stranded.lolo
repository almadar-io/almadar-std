            (let ((t (default (array/nth @trs @ti) @notrait)) (fa (object/get @affs (str/concat @oi "") @noaff)))
              (let ((trans (object/get @t "stateMachine.transitions" @notrs)))
                (let ((hits (array/map (array/range 0 (array/len @trans)) (fn k
                    (let ((arm (default (array/nth @trans @k) @notrans)))
                      (let ((ev (object/get @arm "event" "")) (effs (object/get @arm "effects" @noe)) (fr (object/get @arm "from" "")) (to (object/get @arm "to" "")))
                        (if (or (array/includes @entity.busExcluded @ev) (not (array/includes (object/get @fa "aff" @nos) @ev))) false
                          (if (array/some @effs (fn x (and (validate/array @x) (array/includes ["fetch", "persist"] (array/nth @x 0))))) false
                            (if (and (not (and (validate/string @fr) (= @fr @to)))
                                     (array/some @trans (fn q (and (!= (object/get @q "event" "") @ev) (not (array/includes @entity.busExcluded (object/get @q "event" ""))) (array/includes (object/get @fa "prod" @nos) (object/get @q "event" ""))
                                                                   (let ((qf (object/get @q "from" ""))) (if (validate/string @qf) (= @qf @to) (array/includes @qf @to)))))))
                              false
                              (array/some (array/range 0 (array/len @units)) (fn ui
                                (let ((u (default (array/nth @units @ui) @nou1)))
                                  (and (= (object/get @u "oi") @oi) (= (object/get @u "ti") @ti) (= (object/get @u "src") "t") (= (object/get @u "li") @k)
                                       (not (default (array/nth (object/get @wayOn "uw" @nob) @ui) false)))))))))))))))
                  (array/flatten (array/map (array/range 0 (array/len @trans)) (fn k
                    (let ((ev (object/get (default (array/nth @trans @k) @notrans) "event" "")))
                      (if (and (default (array/nth @hits @k) false) (not (array/some (array/range 0 @k) (fn j (and (default (array/nth @hits @j) false) (= (object/get (default (array/nth @trans @j) @notrans) "event" "") @ev))))))
                        [{ code: @config.codes.circuitViewerStranded.code, path: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" @on ")].stateMachine.transitions[" @k "]"), message: (str/concat "'" @on "' owns this page's content region, and '" @ev "' repaints it with a body that carries no data surface, no wired control and no sibling embed — the screen the viewer came from is gone and there is nothing to click"), suggestion: "render this OVER the page instead of replacing it: move the body into a dedicated overlay trait writing only 'modal' (a modal-close arm rendered from the trait that owns 'main' is rejected by CIRCUIT_MODAL_EXIT_INCOMPLETE, which is why it needs its own trait), or give the arm a wired control back to the state it came from", severity: "error" }]
                        @nof))))))))))))))))))))))))))))
        (set @entity.haveFired false)
        (set @entity.haveOwners false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "viewer-stranded", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_COMPUTE { }
        @description "Internal: the program, the fired events and the page owners are in, compute the findings."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    config {
      codes : LintViewerStrandedCodes = { circuitViewerStranded: { code: "ORB_CIRCUIT_VIEWER_STRANDED", category: "circuit", description: "A page's content owner repaints its region on a user-triggered event with a body that offers no way on" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
      mainSlots : [string] = ["main", "content", "screen"]
        @label "Main slots"
        @description "The inline content slots a state paints."
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : VsProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      PATTERNS_HEARD { patterns : Map string VsPattern! }
        @description "std-orb-lint-input's LINT_PATTERNS: the installed pattern registry's props, each with its kind."
      PROPS_HEARD { byPattern : [VsByPattern]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: the event props per pattern, an event-list prop with its eventField."
      SEMANTICS_HEARD { busExcluded : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the events the bus never delivers."
      FIRED_HEARD { scope : string!  byControl : Map string [string]!  byEffect : Map string [string]! }
        @description "std-orb-fired-events' FIRED_EVENTS: the events each trait fires by a control or by an effect."
      OWNERS_HEARD { scope : string!  owners : [VsOwner]! }
        @description "std-orb-lint-page-content-owner's PAGE_OWNERS: the content owner of each page."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbLintInput.LINT_PATTERNS -> PATTERNS_HEARD
      OrbLintInput.LINT_EVENT_PROPS -> PROPS_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> SEMANTICS_HEARD
      OrbFiredEvents.FIRED_EVENTS -> FIRED_HEARD
      OrbLintPageContentOwner.PAGE_OWNERS -> OWNERS_HEARD
    }
  }

  trait OrbLintViewerStrandedCli -> OrbLintViewerStrandedRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint viewer-stranded <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "viewer-stranded") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint viewer-stranded: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "viewer-stranded") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint viewer-stranded: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-viewer-stranded" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint viewer-stranded` with its arguments and working directory."
        @synonyms "orb lint viewer-stranded"
      OrbLintViewerStranded.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbFiredEvents = Fired.traits.OrbFiredEvents {
    listens {
      FIRED_PROPS_HEARD { names : [string]!  maps : [string]!  listens : Map string [string]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: the event-bearing prop names of the installed pattern registry."
      FIRED_SEMANTICS_HEARD { functions : [string]!  busExcluded : [string]!  targetOptions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators."
      FIRED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      FIRED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : VsProgram!  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
      OrbLintInput.LINT_EVENT_PROPS -> FIRED_PROPS_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> FIRED_SEMANTICS_HEARD
      OrbLintInput.LINT_OPERATOR_WALK -> FIRED_WALK_HEARD
      OrbLintInput.LINT_INPUT -> FIRED_INPUT_HEARD
    }
  }
  trait OrbLintPageContentOwner = Owner.traits.OrbLintPageContentOwner {
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintViewerStrandedCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintViewerStrandedOrbitalStart -> OrbLintViewerStranded, OrbLintViewerStrandedCli, OrbLintInput, OrbFiredEvents, OrbLintPageContentOwner, Packs, Versions
}
