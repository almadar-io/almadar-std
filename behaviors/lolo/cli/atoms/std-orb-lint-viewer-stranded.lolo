      (if (= @kd "event-list") [{ prop: @pr, field: (object/get (default (array/find @entity.byPattern (fn bp (and (= (object/get @bp "pattern" "") @pn) (= (object/get @bp "prop" "") @pr)))) @nobp) "field" "event") }] @noo))))))]))) {}))) (let ((contentTypes : Map string boolean (default (object/fromEntries (array/map (array/filter (object/keys @entity.patterns) (fn pn (array/some (object/values (object/get (object/get @entity.patterns @pn @nopat) "props" @nopat2)) (fn pr (= (object/get (default @pr @nopp) "kind" "") "entity"))))) (fn pn [(str/replaceAll (str/replaceAll @pn "~" "~t") "." "~d"), true]))) {}))) (let ((inlines : Map string boolean (default (object/fromEntries (array/flatten (array/map @strandOrbs (fn oi (array/map (array/filter (object/get (default (array/nth @orbs @oi) @noorb) "traits" @notraits) (fn t (object/has @t "stateMachine"))) (fn t [(str/concat @oi "|" (object/get @t "name" "")), true])))))) {}))) (let ((units : [VsUnit] (let ((nou : [VsUnit] []))
  (array/flatten (array/map @strandOrbs (fn oi
    (let ((trs (object/get (default (array/nth @orbs @oi) @noorb) "traits" [])))
      (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
        (let ((t (default (array/nth @trs @ti) @notrait)))
          (if (not (object/has @t "stateMachine")) @nou
            (let ((trans (object/get @t "stateMachine.transitions" [])) (tks (object/get @t "ticks" [])))
              (let ((lists (array/concat
                  (array/map (array/range 0 (array/len @trans)) (fn i { src: "t", li: @i, event: (object/get (default (array/nth @trans @i) @notrans) "event" ""), effects: (object/get (default (array/nth @trans @i) @notrans) "effects" @noe) }))
                  (array/map (array/range 0 (array/len @tks)) (fn i { src: "k", li: @i, event: "", effects: (object/get (default (array/nth @tks @i) @notick) "effects" @noe) })))))
