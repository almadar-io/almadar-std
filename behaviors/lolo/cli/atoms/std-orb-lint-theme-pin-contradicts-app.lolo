app std-orb-lint-theme-pin-contradicts-app [
  version: "1.0.0",
  inbound: ["cli-lint-theme-pin-contradicts-app"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-theme-pin-contradicts-app — the `orb lint theme-pin-contradicts-app <file>` command, the port of ORB_THEME_PIN_CONTRADICTS_APP (theme.rs validate_theme_pin_matches_app). It lowers the file with program/read and, when the app declares a theme (a key, or an inline theme's name), reports each orbital whose traits pin a literal non-empty config.theme default (not an @ binding) that differs from it, listing the distinct pins sorted (status 500, exit 1). Clean answers `lint theme-pin-contradicts-app: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-theme-pin-contradicts-app"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ThemePinValue = string | number | boolean | [ThemePinValue] | Map string ThemePinValue
type ThemePinKnob = { default : ThemePinValue }
type ThemePinConfig = { theme : ThemePinKnob }
type ThemePinTrait = { config : ThemePinConfig }
type ThemePinOrbital = { name : string, traits : [ThemePinTrait] }
type ThemePinNamed = { name : string }
type ThemePinProgram = { theme : string | ThemePinNamed, orbitals : [ThemePinOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintThemePinContradictsAppCodes = { themePinContradictsApp : LintCodeDecl }

orbital OrbLintThemePinContradictsAppOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintThemePinContradictsAppRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintThemePinContradictsApp -> OrbLintThemePinContradictsAppRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((raw (object/get @payload.program "theme" null)))
          (let ((dq "\"") (appKey (if (validate/string @raw) @raw (if (validate/object @raw) (object/get @raw "name" "") ""))) (orbitals (object/get @payload.program "orbitals" [])))
            (if (= @appKey "")
              []
              (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                (let ((orb (array/nth @orbitals @oi)))
                  (let ((pins (array/unique (array/filter (array/map (object/get @orb "traits" []) (fn td (let ((cfg (if (validate/object @td) (object/get @td "config" null) null))) (if (validate/object @cfg) (let ((th (object/get @cfg "theme" null))) (if (validate/object @th) (let ((d (object/get @th "default" null))) (if (and (validate/string @d) (!= @d "") (not (str/startsWith @d (quote "@")))) @d "")) "")) "")))) (fn p (!= @p ""))))))
                    (let ((divergent (array/sort (array/filter @pins (fn p (!= @p @appKey))))))
                      (if (= (array/len @divergent) 0)
                        []
                        [{ code: @config.codes.themePinContradictsApp.code, path: (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].theme"), message: (str/concat (object/get @orb "name" "") " pins theme " (str/join (array/map @divergent (fn p (str/concat @dq @p @dq))) ", ") " while the app declares " @dq @appKey @dq " at the app level"), suggestion: (str/concat "remove the config pin so the orbital inherits the app theme via @currentTheme - or, for a deliberate per-orbital override, declare it as the orbital's own `theme " @dq "<key>" @dq "`"), severity: "error" }])))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "theme-pin-contradicts-app", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : ThemePinProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintThemePinContradictsAppCodes = { themePinContradictsApp: { code: "ORB_THEME_PIN_CONTRADICTS_APP", category: "theme", description: "An orbital pins a theme that differs from the theme the app declares at app level" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintThemePinContradictsAppCli -> OrbLintThemePinContradictsAppRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint theme-pin-contradicts-app <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint theme-pin-contradicts-app <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "theme-pin-contradicts-app") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint theme-pin-contradicts-app: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "theme-pin-contradicts-app") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint theme-pin-contradicts-app: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-theme-pin-contradicts-app" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint theme-pin-contradicts-app` with its arguments and working directory."
        @synonyms "orb lint theme-pin-contradicts-app"
      OrbLintThemePinContradictsApp.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintThemePinContradictsAppCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintThemePinContradictsAppOrbitalStart -> OrbLintThemePinContradictsApp, OrbLintThemePinContradictsAppCli, OrbLintInput, Packs, Versions
}
