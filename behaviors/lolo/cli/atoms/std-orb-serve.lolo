app std-orb-serve [
  version: "1.0.0",
  inbound: ["cli-serve"],
  env: ["HOME", "FIREBASE_AUTH_EMULATOR_HOST", "FIREBASE_PROJECT_ID"],
  fs: { "~/.almadar/serve": [create], "~/.almadar/serve/**": [write, create], cwd: ".orbital": [create], cwd: ".orbital/serve": [create], cwd: ".orbital/serve/**": [write, create] },
  description: "std-orb-serve — the `orb serve <file> [--port N] [--host H] [--no-mock] [--client-dir DIR] [--open] [--no-emulators]` command (spec/cli/orb-serve.lolo; port of orbital-cli program_command.rs serve_program and server_overrides). It resolves the app with program/read { resolve: true, path }. An app that declares its own http endpoint is composed alone, and --port, --host or --client-dir is refused (status 400): its server's options are set in the program. Without --client-dir the app gets a browser client prepared first: program/eval generate { mode: client, webClient: true } compiles it client-mode into <cwd>/.orbital/serve/<app> and lays the typescript shell's prebuilt web client, with the app's runtime files over it, out in .orbital/serve/<app>/web-client, which becomes the clientDir; when FIREBASE_AUTH_EMULATOR_HOST and FIREBASE_PROJECT_ID are both set, that folder's __/firebase/init.json names the Auth emulator for the page. Otherwise it writes ~/.almadar/serve/<app path with / as _>.server.lolo, which imports std-http-server's HttpServerOrbital with the serve options as its call-site config (host, port, portFromEnv false and, with --client-dir made absolute against the working directory and required to lie under it, clientDir relative to the working directory), resolves it with program/read so each knob reaches the trait bodies, and composes the app with std-http-server's resolved program (behavior/resolve, for its header grants) carrying that configured orbital, adding the listen grant for host:port and the anchored cwd read grant of the client dir. The compose, prepare-client and answer half is std-orb-serve-handoff's ServeHandoff, which std-orb-launchpad composes as well. The command never runs the program: it answers a hand-off the bootloader acts on, status 200 with headers orb-run: server, orb-mock: on (default) or off (--no-mock), orb-app: the absolute app path, and the composed program's JSON as the body. --open and --no-emulators answer status 500 on stderr with the texts the Rust command bailed with; a port that is not an integer in 0..65535 answers status 400 on stderr; a client dir outside the working directory, an app that names no app or a program that does not resolve or compose answers status 500 on stderr `Error: <reason>`; a missing or second file or an unknown flag answers the usage (status 400, exit 2). Defaults: port 3030, host 127.0.0.1. The resolved app is written (with its catalogs and lazy behaviors) to ~/.almadar/serve/<app path with / as _>.orb, the directory read from the HOME env grant and written under the fs grant ~/.almadar/serve/**; orb-app names that file, so the bootloader finds the catalogs."
]
uses Spec from "almadar-std/orb-serve"
uses Args from "std/behaviors/std-args"
uses Handoff from "std/behaviors/std-orb-serve-handoff"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type ServePage = { protocol : string }
type ServeOrbital = { name : string!, pages : [ServePage] }
type ServeProgram = { name : string, orbitals : [ServeOrbital] }
type ServeApp = { program : ServeProgram!, text : string! }
type ServeAppRead = { program : ServeProgram!, loadedResolved : boolean!, programPath : string! }

orbital OrbServeOrbital {
  entity ServeRun [runtime] {
    id : string!
    path : string = ""
    host : string = ""
    port : number = 0
    rel : string = ""
    hasClient : boolean = false
    mock : boolean = true
    out : string = ""
    flagged : boolean = false
    serverName : string = ""
    serverPath : string = ""
    serverOrbitals : [ServeOrbital] = []
    appName : string = ""
    app : ServeProgram = { name: "" }
    cwd : string = ""
    prepare : boolean @description "Serve prepares the browser client itself (no --client-dir), from the composed program." = false
    source : string @description "The app file itself, whose folder holds its locales/ and public/." = ""
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbServe.SERVE_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbServe -> ServeRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SERVE_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit SERVE_ANSWERED { status: 400, body: "", stderr: "usage: orb serve <FILE> [--port N] [--host H] [--no-mock] [--client-dir DIR] [--open] [--no-emulators]" })
      SERVE_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.path (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit SERVE_ARGS_PARSE { stage: "serve" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "port" aliases: ["-p"] takesValue: true repeatable: false }, { name: "host" aliases: [] takesValue: true repeatable: false }, { name: "client-dir" aliases: [] takesValue: true repeatable: false }, { name: "no-mock" aliases: [] takesValue: false repeatable: false }, { name: "open" aliases: [] takesValue: false repeatable: false }, { name: "no-emulators" aliases: [] takesValue: false repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      SERVE_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1))
        (emit SERVE_ANSWERED { status: 400, body: "", stderr: "usage: orb serve <FILE> [--port N] [--host H] [--no-mock] [--client-dir DIR] [--open] [--no-emulators]" })
      SERVE_ARGS_DONE -> working when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (emit SERVE_START {
          cwd: @entity.path
          path: (if (os/path-is-absolute (array/first @payload.positionals)) (array/first @payload.positionals) (os/path-join @entity.path (array/first @payload.positionals)))
          portText: (array/first (default (object/get @payload.flags "port") ["3030"]))
          portOk: (and (>= (str/to-number (array/first (default (object/get @payload.flags "port") ["3030"]))) 0) (<= (str/to-number (array/first (default (object/get @payload.flags "port") ["3030"]))) 65535) (= (str/to-int (array/first (default (object/get @payload.flags "port") ["3030"]))) (str/to-number (array/first (default (object/get @payload.flags "port") ["3030"])))))
          host: (array/first (default (object/get @payload.flags "host") ["127.0.0.1"]))
          hasClient: (!= (object/get @payload.flags "client-dir") null)
          clientDir: (if (== (object/get @payload.flags "client-dir") null) "" (if (os/path-is-absolute (array/first (object/get @payload.flags "client-dir"))) (array/first (object/get @payload.flags "client-dir")) (os/path-join @entity.path (array/first (object/get @payload.flags "client-dir")))))
          clientGiven: (array/first (default (object/get @payload.flags "client-dir") [""]))
          clientInside: (if (== (object/get @payload.flags "client-dir") null) true (str/startsWith (if (os/path-is-absolute (array/first (object/get @payload.flags "client-dir"))) (array/first (object/get @payload.flags "client-dir")) (os/path-join @entity.path (array/first (object/get @payload.flags "client-dir")))) (str/concat @entity.path "/")))
          mock: (== (object/get @payload.flags "no-mock") null)
          open: (!= (object/get @payload.flags "open") null)
          noEmulators: (!= (object/get @payload.flags "no-emulators") null)
          flagged: (or (!= (object/get @payload.flags "port") null) (!= (object/get @payload.flags "host") null) (!= (object/get @payload.flags "client-dir") null))
        })
    }

    state working {
      INIT -> working
      SERVE_DONE -> ready
        (emit SERVE_ANSWERED { status: @payload.status, body: @payload.body, stderr: @payload.stderr, headers: @payload.headers })
    }

    emits {
      SERVE_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
        headers : Map string string
      }
        @description "Internal: the command's answer, which the cli hook prints; headers carry the bootloader hand-off."
        @tier "internal"
      SERVE_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words."
        @tier "internal"
      SERVE_START {
        cwd : string!
        path : string!
        portText : string!
        portOk : boolean!
        host : string!
        hasClient : boolean!
        clientDir : string!
        clientGiven : string!
        clientInside : boolean!
        mock : boolean!
        open : boolean!
        noEmulators : boolean!
        flagged : boolean!
      }
        @description "Internal: the parsed serve request."
        @tier "internal"
    }

    listens {
      SERVE_CALLED -> inbound "cli-serve" answers SERVE_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb serve`."
        @synonyms "orb serve, serve a program, run the app on a port, http server for a lolo program"
      SERVE_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED."
      ArgsCli.ARGS_PARSED -> SERVE_ARGS_DONE
      ServeEngine.SERVE_ANSWERED -> SERVE_DONE
      ServeHandoff.SERVE_ANSWERED -> SERVE_DONE
      SERVE_DONE { status : number!  body : string!  stderr : string  headers : Map string string }
        @description "Internal: the engine's answer, relayed to the hook by its handler."
        @tier "internal"
    }
  }

  trait ServeEngine -> ServeRun [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      SERVE_START -> idle when @payload.open
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: "Error: orb serve --open has no declared counterpart in std-http-server: open the browser yourself" })
      SERVE_START -> idle when (and (not @payload.open) @payload.noEmulators)
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: "Error: orb serve --no-emulators has no declared counterpart in std-http-server: sign-in is selected by AUTH_PROVIDER in the environment" })
      SERVE_START -> idle when (and (not @payload.open) (not @payload.noEmulators) (not @payload.portOk))
        (emit SERVE_ANSWERED { status: 400, body: "", stderr: (str/concat "error: invalid value '" @payload.portText "' for '--port <PORT>': not an integer from 0 to 65535") })
      SERVE_START -> idle when (and (not @payload.open) (not @payload.noEmulators) @payload.portOk (not @payload.clientInside))
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: --client-dir " @payload.clientGiven " is outside the working directory " @payload.cwd "; the server reads its client under it") })
      SERVE_START -> homing when (and (not @payload.open) (not @payload.noEmulators) @payload.portOk @payload.clientInside)
        (set @entity.path @payload.path)
        (set @entity.host @payload.host)
        (set @entity.port (str/to-number @payload.portText))
        (set @entity.hasClient @payload.hasClient)
        (set @entity.rel (if @payload.hasClient (str/slice @payload.clientDir (+ (str/len @payload.cwd) 1) (str/len @payload.clientDir)) ""))
        (set @entity.mock @payload.mock)
        (set @entity.flagged @payload.flagged)
        (set @entity.cwd @payload.cwd)
        (os/getenv "HOME" { key: "home" emit: { success: SERVE_HOME, failure: SERVE_REFUSED } })
    }

    state homing {
      INIT -> homing
      SERVE_REFUSED -> idle
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " @payload.error) })
      SERVE_HOME -> idle when (= @payload.value "")
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: "Error: HOME is not set; orb serve writes the resolved app under ~/.almadar/serve" })
      SERVE_HOME -> making when (!= @payload.value "")
        (set @entity.out (os/path-join @payload.value ".almadar/serve" (str/concat (str/replaceAll @entity.path "/" "_") ".orb")))
        (set @entity.serverName (str/concat (str/replaceAll @entity.path "/" "_") ".server.lolo"))
        (set @entity.serverPath (os/path-join @payload.value ".almadar/serve" (str/concat (str/replaceAll @entity.path "/" "_") ".server.lolo")))
        (os/mkdir "~/.almadar/serve" true { key: "servedir" emit: { success: SERVE_DIR, failure: SERVE_DIR_FAILED } })
    }

    state making {
      INIT -> making
      SERVE_DIR_FAILED -> idle
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: orb serve could not create ~/.almadar/serve: " @payload.error) })
      SERVE_DIR -> reading
        (program/read "" { resolve: true path: @entity.path output: @entity.out text: false } { key: "app" emit: { success: SERVE_APP_READ, failure: SERVE_REFUSED } })
    }

    state reading {
      INIT -> reading
      SERVE_REFUSED -> idle
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " @payload.error) })
      SERVE_APP_READ -> idle when (= (default (object/get (object/get @payload.result "program") "name") "") "")
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: "Error: the program to serve names no app" })
      SERVE_APP_READ -> idle when (and (!= (default (object/get (object/get @payload.result "program") "name") "") "") (array/some (object/get @payload.result.program "orbitals" []) (fn o (array/some (object/get @o "pages" []) (fn pg (= (object/get @pg "protocol" "route") "http"))))) @entity.flagged)
        (emit SERVE_ANSWERED { status: 400, body: "", stderr: (str/concat "Error: " (object/get (object/get @payload.result "program") "name") " declares its own http endpoint, so its host, port and client folder are set in the program; drop --port, --host and --client-dir") })
      SERVE_APP_READ -> idle when (and (!= (default (object/get (object/get @payload.result "program") "name") "") "") (array/some (object/get @payload.result.program "orbitals" []) (fn o (array/some (object/get @o "pages" []) (fn pg (= (object/get @pg "protocol" "route") "http"))))) (not @entity.flagged))
        (set @entity.appName (object/get (object/get @payload.result "program") "name"))
        (set @entity.out @payload.result.programPath)
        (set @entity.app (object/get @payload.result "program"))
        (emit SERVE_DECLARED_READY { program: (object/get @payload.result "program"), serverOrbital: (object/get (array/find (object/get @payload.result.program "orbitals" []) (fn o (array/some (object/get @o "pages" []) (fn pg (= (object/get @pg "protocol" "route") "http"))))) "name"), appName: @entity.appName, host: @entity.host, port: @entity.port, rel: @entity.rel, hasClient: @entity.hasClient, mock: @entity.mock, path: @entity.out })
      SERVE_APP_READ -> writing when (and (and (!= (default (object/get (object/get @payload.result "program") "name") "") "") (not (array/some (object/get @payload.result.program "orbitals" []) (fn o (array/some (object/get @o "pages" []) (fn pg (= (object/get @pg "protocol" "route") "http"))))))) @entity.hasClient)
        (set @entity.appName (object/get (object/get @payload.result "program") "name"))
        (set @entity.out @payload.result.programPath)
        (set @entity.app (object/get @payload.result "program"))
        (emit SERVE_WRITE_SERVER { })
      SERVE_APP_READ -> writing when (and (and (!= (default (object/get (object/get @payload.result "program") "name") "") "") (not (array/some (object/get @payload.result.program "orbitals" []) (fn o (array/some (object/get @o "pages" []) (fn pg (= (object/get @pg "protocol" "route") "http"))))))) (not @entity.hasClient))
        (set @entity.appName (object/get (object/get @payload.result "program") "name"))
        (set @entity.out @payload.result.programPath)
        (set @entity.app (object/get @payload.result "program"))
        (set @entity.rel (str/concat ".orbital/serve/" (object/get (object/get @payload.result "program") "name") "/web-client"))
        (set @entity.hasClient true)
        (set @entity.prepare true)
        (emit SERVE_WRITE_SERVER { })
    }

    state writing {
      INIT -> writing
      SERVE_WRITE_SERVER -> resolving
        (os/write-file (str/concat "~/.almadar/serve/" @entity.serverName) (bytes/from-string (str/concat
          "app orb-served-server [version: \"1.0.0\"]\n"
          "uses Server from \"std/behaviors/std-http-server\"\n"
          "orbital HttpServerOrbital = Server.orbitals.HttpServerOrbital {\n  config {\n"
          "    host: " (json/stringify @entity.host) "\n"
          "    port: " (json/stringify @entity.port) "\n"
          "    portFromEnv: false\n"
          (if @entity.hasClient (str/concat "    clientDir: " (json/stringify @entity.rel) "\n") "")
          "  }\n}\n")) { key: "serverText" emit: { success: SERVE_SERVER_WRITTEN, failure: SERVE_REFUSED } })
    }

    state resolving {
      INIT -> resolving
      SERVE_REFUSED -> idle
        (emit SERVE_ANSWERED { status: 500, body: "", stderr: (str/concat "Error: " @payload.error) })
      SERVE_SERVER_WRITTEN -> resolving
        (program/read "" { resolve: true path: @entity.serverPath } { key: "server" emit: { success: SERVE_SERVER_READ, failure: SERVE_REFUSED } })
      SERVE_SERVER_READ -> resolving
        (set @entity.serverOrbitals (object/get (object/get @payload.result "program") "orbitals" []))
        (behavior/resolve { behavior: "std/behaviors/std-http-server" } {} { key: "serverHeader" emit: { success: SERVE_SERVER_RESOLVED, failure: SERVE_REFUSED } })
      SERVE_SERVER_RESOLVED -> idle
        (emit SERVE_COMPOSE_READY { programs: [@entity.app, (object/set @payload.result "orbitals" @entity.serverOrbitals)], appName: @entity.appName, host: @entity.host, port: @entity.port, rel: @entity.rel, hasClient: @entity.hasClient, mock: @entity.mock, path: @entity.out, prepare: @entity.prepare, cwd: @entity.cwd, source: @entity.path })
    }

    emits {
      SERVE_ANSWERED -> external {
        status : number!
        body : string!
        stderr : string
        headers : Map string string
      }
        @description "The command's answer, which the cli hook prints; headers carry the bootloader hand-off."
        @tier "internal"
      SERVE_REFUSED {
        error : string
      }
        @description "The app could not be read or the server could not be resolved."
        @tier "internal"
      SERVE_HOME {
        value : string!
      }
        @description "os/getenv: the HOME directory."
        @tier "internal"
      SERVE_DIR { }
        @description "os/mkdir: the directory serve writes the resolved app into exists."
        @tier "internal"
      SERVE_DIR_FAILED {
        error : string
        kind : string
      }
        @description "os/mkdir: the serve directory could not be created."
        @tier "internal"
      SERVE_APP_READ {
        result : ServeAppRead!
      }
        @description "program/read: the resolved app."
        @tier "internal"
      SERVE_WRITE_SERVER { }
        @description "Write the server program, std-http-server imported with the serve options as its call-site config."
        @tier "internal"
      SERVE_SERVER_WRITTEN { bytes : number }
        @description "os/write-file: the server program, std-http-server imported with the serve options as its call-site config, is written."
        @tier "internal"
      SERVE_SERVER_READ {
        result : ServeApp!
      }
        @description "program/read: the written server program resolved, its orbital configured with the serve options."
        @tier "internal"
      SERVE_SERVER_RESOLVED {
        result : ServeProgram!
      }
        @description "behavior/resolve: std-http-server, whose header (grants, environment, egress) the served server keeps around the configured orbital."
        @tier "internal"
      SERVE_DECLARED_READY {
        program : ServeProgram!
        serverOrbital : string!
        appName : string!
        host : string!
        port : number!
        rel : string!
        hasClient : boolean!
        mock : boolean!
        path : string!
      }
        @tier "internal"
        @description "The app declares its own http endpoint, served by its orbital serverOrbital: composed alone, with the serve options set on that orbital."
      SERVE_COMPOSE_READY {
        programs : [ServeProgram]!
        appName : string!
        host : string!
        port : number!
        rel : string!
        hasClient : boolean!
        mock : boolean!
        path : string!
        prepare : boolean!
        cwd : string!
        source : string!
      }
        @description "Internal: the resolved server, ready to compose with the app."
        @tier "internal"
    }

    listens {
      SERVE_START {
        cwd : string!
        path : string!
        portText : string!
        portOk : boolean!
        host : string!
        hasClient : boolean!
        clientDir : string!
        clientGiven : string!
        clientInside : boolean!
        mock : boolean!
        open : boolean!
        noEmulators : boolean!
        flagged : boolean!
      }
        @description "Compose the app with std-http-server."
      OrbServe.SERVE_START -> SERVE_START
    }
  }

  trait ServeHandoff = Handoff.traits.ServeHandoff {
    listens {
      ServeEngine.SERVE_COMPOSE_READY -> SERVE_COMPOSE_READY
      ServeEngine.SERVE_DECLARED_READY -> SERVE_DECLARED_READY
    }
  }

  page boot as OrbServePage -> OrbServe, ArgsCli, ServeEngine, ServeHandoff
}
