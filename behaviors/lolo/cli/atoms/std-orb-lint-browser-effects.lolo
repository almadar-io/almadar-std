app std-orb-lint-browser-effects [
  version: "1.0.0",
  inbound: ["cli-lint-browser-effects"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-browser-effects — the `orb lint browser-effects <file>` command, the port of the browser/beacon, browser/page-facts, on-device (browser/prompt, browser/embed) and browser/tab-* checks of effect/http.rs (check_beacon_call, check_page_facts_call, check_on_device_call, check_tab_call and the background-tick loop of validate_http_effects), found at any depth of a guard or effect of an inline trait. Everything the operator table states comes from it through std-orb-lint-host-calls (std-orb-lint-input's LINT_OPERATOR_SHAPES and LINT_HOST_FACTS): the keys a beacon request and its options may carry, the facts a page-facts list may name, the operators of the on-device and tab families (`family`), a tab operator's request keys in the order the table declares them, the emit keys of each operator in the order the operator documents them and the default port of each http scheme. Reports ORB_BEACON_URL_NOT_ABSOLUTE (a literal beacon URL that does not begin with http:// or https://), ORB_BEACON_TEXT_REQUIRED (no request, or a request without `text`), ORB_BEACON_OPTION_UNKNOWN (a request or options key the table does not declare; `key` given in both), ORB_PAGE_FACTS_FIELD_INVALID (not a list, an empty list, a word that is not a page fact, a fact listed twice), ORB_ON_DEVICE_SCHEMA_INVALID (a literal browser/prompt response schema that is not a JSON object), the ORB_HOST_EFFECT_ARITY and ORB_HOST_EFFECT_OPTION_UNKNOWN of browser/prompt, browser/embed and every browser/tab-* operator, ORB_TAB_REQUEST_INVALID (a tab request that is not an object or text from data, or carries a key the operator does not declare), ORB_ON_DEVICE_EFFECT_ON_SERVER and ORB_TAB_EFFECT_ON_SERVER (an on-device or tab call in an effect of a `[background]` tick, which runs on the server), ORB_HTTP_ORIGIN_NOT_STATIC and ORB_HTTP_EGRESS_UNDECLARED for the beacon URL (the origin of the URL against the program's `egress`, with the default port of the scheme), and, through std-orb-emit-config, ORB_EFF_EMIT_KEY_INVALID, ORB_EFF_EMIT_INVALID_NAME and ORB_EFF_EMIT_UNDECLARED_EVENT for the `emit` block of each of these operators. Not reported here: the part of ORB_TAB_REQUEST_INVALID that parses a literal tab request as the kernel's tab-call parser reads it (a request whose keys are all declared and whose values the parser refuses); the key and cancelled findings, which belong to std-orb-lint-keyed-call-keys. Findings carry the Rust path (the guard or effect), message and suggestion (status 500, exit 1). Clean answers `lint browser-effects: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-browser-effects"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOrbital = { name : string, traits : [HcVal] }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]!, config : Map string HcVal?, inGuard : boolean? }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcClosed = { request : boolean?, intRange : HcIntRange? }
type HcOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HcOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HcOauthOp]! }
type HcGrantNeed = Map string HcVal
type HcAuthScheme = { name : string!, keys : [string]!, required : [string]?, onUnauthorized : [string]? }
type HcHttpWire = { requestKeys : [string]!, bodyKeys : [string]!, queryEncodings : [string]!, authSchemes : [HcAuthScheme]!, defaultPorts : Map string number! }
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitKeys : [string]? }
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitOrder : [string]?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type HcValMap = Map string HcVal?
type LnVal = string | number | boolean | [LnVal?] | Map string LnVal?
type LnProgram = { orbitals : [HcOrbital], egress : [string]? }
type HcValMap = Map string HcVal?
type HcStrings = [string]
type HcLooseList = [HcVal?]
type EmitVal = string | number | boolean | [EmitVal?] | Map string EmitVal?
type EmitObj = Map string EmitVal?
type Seg = { items : [EmitItem]!, pre : [OrbFinding]!, post : [OrbFinding]! }
type EmitItem = { id : string!, path : string!, emit : EmitObj!, allowedKeys : [string]!, checkDeclared : boolean!, declared : [string]! }
type EmitResult = { id : string!, findings : [OrbFinding]! }


type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintBrowserEffectsCodes = { lintOperatorShapesUnread : LintCodeDecl , httpOriginNotStatic : LintCodeDecl , httpEgressUndeclared : LintCodeDecl , beaconUrlNotAbsolute : LintCodeDecl , beaconOptionUnknown : LintCodeDecl , beaconTextRequired : LintCodeDecl , pageFactsFieldInvalid : LintCodeDecl , hostEffectArity : LintCodeDecl , onDeviceSchemaInvalid : LintCodeDecl , hostEffectOptionUnknown : LintCodeDecl , tabRequestInvalid : LintCodeDecl , onDeviceEffectOnServer : LintCodeDecl , tabEffectOnServer : LintCodeDecl }

orbital OrbLintBrowserEffectsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Calls from "std/behaviors/std-orb-lint-host-calls"
  uses EmitConfigUse from "std/behaviors/std-orb-emit-config"

  entity OrbLintBrowserEffectsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    egressRaw : [string] = []
    segs : [Seg] = []
    emitRes : [EmitResult] = []

  }

  trait OrbLintBrowserEffects -> OrbLintBrowserEffectsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.egressRaw (default (object/get @payload.program "egress" null) []))
        (emit HOST_CALLS_COLLECT { requestId: (str/concat "browser-effects:" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["browser/beacon", "browser/page-facts"], operators: ["browser/beacon", "browser/page-facts", "http"], fields: ["family"] })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "browser-effects:") (or @payload.unread (not (object/has @payload.facts "http.httpWire"))))
        (set @entity.findings [{ code: @config.codes.lintOperatorShapesUnread.code, path: "operators", message: "the installed @almadar/std operator table could not be read, so the browser effects' vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }])
        (emit LINT_FINISH { })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "browser-effects:") (not @payload.unread) (object/has @payload.facts "http.httpWire"))
        (set @entity.segs (let ((facts @payload.facts) (none : [OrbFinding] []) (noitems : [EmitItem] []) (nos : [string] []) (nov : [string] []))
          (let ((fbeacon (object/get @facts "browser/beacon")) (ffacts (object/get @facts "browser/page-facts")) (fhttp (object/get @facts "http")))
            (let ((requestKeys (object/get (object/get @fbeacon "keys") "request" @nos)) (optionKeys (object/get (object/get @fbeacon "keys") "options" @nos)) (factWords (object/get (object/get @ffacts "words") "fields[]" @nos))
                  (dports (object/get (object/get @fhttp "httpWire" { requestKeys: [], bodyKeys: [], queryEncodings: [], authSchemes: [], defaultPorts: {} }) "defaultPorts")) (egressRaw @entity.egressRaw))
              (let ((egOrigins (array/filter (array/map @egressRaw (fn eg (let ((parts (str/split @eg "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (or (= @pp null) (= (array/first @sp) "")) null (str/concat (str/lower (array/first @sp)) ":" @pp)))) (str/concat (str/lower @auth) ":" @dp))))) (if (or (= @hp null) (not (= @rem ""))) null (str/concat @scheme "://" @hp))))))))))))) (fn x (!= @x null)))))
                (array/map (array/range 0 (array/len @payload.calls)) (fn ci
                  (let ((c (array/nth @payload.calls @ci)))
                    (let ((a (object/get @c "call")) (p (object/get @c "path")) (h (object/get @c "head")))
                      (let ((n (array/len @a)) (fh (object/get @facts @h)) (cfg (default (as (object/get @c "config") HcValMap) {})))
                        (let ((fam (object/get @fh "family" "")) (eo (object/get @fh "emitOrder" @nos)))
                          { items: (array/flatten (array/map (array/range 1 @n) (fn ai (let ((av (array/nth @a @ai))) (if (and (validate/object @av) (validate/object (object/get (default (as @av HcValMap) {}) "emit" null))) [{ id: (str/concat "e" @ci "." @ai), path: @p, emit: (default (as (object/get (default (as @av HcValMap) {}) "emit") EmitObj) {}), allowedKeys: @eo, checkDeclared: true, declared: (object/get @c "declared") }] @noitems))))), pre: (if (= @h "browser/beacon") (array/concat (let ((u (if (> @n 1) (array/nth @a 1) null))) (if (and (validate/string @u) (not (or (str/startsWith @u (quote "@")) (str/startsWith @u "?") (str/startsWith @u "$")))) (if (or (str/startsWith (str/lower @u) "http://") (str/startsWith (str/lower @u) "https://")) (let ((uv @u) (ofd false)) (if (not (validate/string @uv)) (if @ofd @none [{ code: @config.codes.httpOriginNotStatic.code, path: @p, message: (str/concat "`http` beacon URL origin must be a string literal or a `url`-typed @config knob (egress cannot be checked otherwise)"), suggestion: "Declare `origin: url = \"https://host\"` in config and pass @config.origin", severity: "error" }]) (let ((kn (if (and (str/startsWith @uv (str/concat (quote "@") "config.")) (> (str/len @uv) 8) (not (str/includes (str/slice @uv 8) "."))) (str/slice @uv 8) null))) (if (= @kn null) (if (or (str/startsWith @uv (quote "@")) (str/startsWith @uv "?") (str/startsWith @uv "$")) (if @ofd @none [{ code: @config.codes.httpOriginNotStatic.code, path: @p, message: (str/concat "`http` beacon URL origin must be a string literal or a `url`-typed @config knob (egress cannot be checked otherwise)"), suggestion: "Declare `origin: url = \"https://host\"` in config and pass @config.origin", severity: "error" }]) (let ((lu @uv)) (let ((co (let ((parts (str/split @lu "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (or (= @pp null) (= (array/first @sp) "")) null (str/concat (str/lower (array/first @sp)) ":" @pp)))) (str/concat (str/lower @auth) ":" @dp))))) (if (or (= @hp null) (not true)) null (str/concat @scheme "://" @hp))))))))))))) (if (and (!= @co null) (array/includes @egOrigins @co)) @none [{ code: @config.codes.httpEgressUndeclared.code, path: @p, message: (str/concat "beacon URL origin '" @lu "' is not declared in the program's `egress`"), suggestion: "Add the exact scheme://host[:port] origin to the app's `egress: [...]`", severity: "error" }])))) (let ((fld (object/get @cfg @kn null))) (if (and (validate/object @fld) (= (object/get (default (as @fld HcValMap) {}) "type" null) "url")) (let ((dv (object/get (default (as @fld HcValMap) {}) "default" null))) (if (and (validate/string @dv) (not (or (str/startsWith @dv (quote "@")) (str/startsWith @dv "?") (str/startsWith @dv "$")))) (let ((lu @dv)) (let ((co (let ((parts (str/split @lu "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/