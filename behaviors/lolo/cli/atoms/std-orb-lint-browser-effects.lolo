        (emit LINT_PLANNED { })

      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "browser-effects", scope: @entity.scope, findings: @entity.findings })
      LINT_PLANNED -> ready
        (emit EMIT_CONFIG_CHECK { requestId: (str/concat "emit" @entity.scope), items: (array/flatten (array/map @entity.segs (fn s (object/get @s "items")))) })
      EMIT_HEARD -> ready
        (set @entity.emitRes @payload.results)
        (emit LINT_ASSEMBLE { })
      LINT_ASSEMBLE -> ready
        (set @entity.findings (let ((none : [OrbFinding] [])) (array/flatten (array/map @entity.segs (fn s (array/concat (object/get @s "pre") (array/flatten (array/map (object/get @s "items") (fn it (object/get (default (array/find @entity.emitRes (fn r (= (object/get @r "id") (object/get @it "id")))) { id: "", findings: @none }) "findings")))) (object/get @s "post")))))))
        (emit LINT_FINISH { })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
      HOST_CALLS_COLLECT -> external { requestId : string!  orbitals : [HcOrbital]!  heads : [string]!  operators : [string]!  fields : [string]! }
        @description "Ask the shared collector for the calls this rule checks."
        @tier "internal"
      LINT_PLANNED { }
        @description "Internal: the calls are planned, ask the emit-config checker."
        @tier "internal"
      LINT_ASSEMBLE { }
        @description "Internal: merge the emit-config findings into the call findings."
        @tier "internal"
      EMIT_CONFIG_CHECK -> external { requestId : string!  items : [EmitItem]! }
        @description "Ask std-orb-emit-config to check each call's emit object."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LnProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      HOST_CALLS_HEARD { requestId : string!  unread : boolean!  calls : [HcCall]!  facts : Map string HcFact! }
        @description "The shared collector's answer: the calls of the asked heads and the table entries."
      HostCalls.HOST_CALLS_COLLECTED -> HOST_CALLS_HEARD
      EMIT_HEARD { requestId : string!  results : [EmitResult]! }
        @description "std-orb-emit-config's answer: the findings of each call's emit object."
      OrbEmitConfig.EMIT_CONFIG_CHECKED -> EMIT_HEARD
    }
    config {
      codes : LintBrowserEffectsCodes = { lintOperatorShapesUnread: { code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", category: "lint", description: "The installed operator table could not be read or does not match the operator shape type, so a lint cannot run" }, httpOriginNotStatic: { code: "ORB_HTTP_ORIGIN_NOT_STATIC", category: "http", description: "An http origin is not a string literal or a url-typed config knob, so egress cannot be checked" }, httpEgressUndeclared: { code: "ORB_HTTP_EGRESS_UNDECLARED", category: "http", description: "An outbound request targets an origin that is not declared in the program egress list" }, beaconUrlNotAbsolute: { code: "ORB_BEACON_URL_NOT_ABSOLUTE", category: "browser", description: "A browser beacon effect targets a URL that is not an absolute http(s) URL" }, beaconOptionUnknown: { code: "ORB_BEACON_OPTION_UNKNOWN", category: "beacon", description: "A browser beacon request carries an option key that is not a known beacon request key" }, beaconTextRequired: { code: "ORB_BEACON_TEXT_REQUIRED", category: "browser", description: "browser/beacon needs a request carrying a text field" }, pageFactsFieldInvalid: { code: "ORB_PAGE_FACTS_FIELD_INVALID", category: "page", description: "A browser/page-facts effect declares no facts" }, hostEffectArity: { code: "ORB_HOST_EFFECT_ARITY", category: "effect", description: "A host effect is called with the wrong number of arguments" }, onDeviceSchemaInvalid: { code: "ORB_ON_DEVICE_SCHEMA_INVALID", category: "browser", description: "A browser prompt response schema is not valid JSON Schema text describing a JSON object" }, hostEffectOptionUnknown: { code: "ORB_HOST_EFFECT_OPTION_UNKNOWN", category: "host_effect", description: "A host effect is given an option outside the set of options it accepts" }, tabRequestInvalid: { code: "ORB_TAB_REQUEST_INVALID", category: "browser", description: "A browser/tab request is not an object of the operation's closed keys or has refused literal values" }, onDeviceEffectOnServer: { code: "ORB_ON_DEVICE_EFFECT_ON_SERVER", category: "browser", description: "An on-device model effect runs in a background tick on the server, which has no on-device model" }, tabEffectOnServer: { code: "ORB_TAB_EFFECT_ON_SERVER", category: "tab", description: "A browser tab effect is used in a transition that runs on the server, which holds no tabs" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintBrowserEffectsCli -> OrbLintBrowserEffectsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint browser-effects <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "browser-effects") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint browser-effects: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "browser-effects") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint browser-effects: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-browser-effects" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint browser-effects` with its arguments and working directory."
        @synonyms "orb lint browser-effects"
      OrbLintBrowserEffects.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintBrowserEffectsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }
  trait HostCalls = Calls.traits.HostCalls {
    listens {
      OrbLintBrowserEffects.HOST_CALLS_COLLECT -> HOST_CALLS_COLLECT
      LINT_OPERATOR_SHAPES_HEARD { operators : Map string HcShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every operator's arity, host and params."
      LINT_OPERATOR_SHAPES_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator shapes could not be read."
      LINT_HOST_FACTS_HEARD { operators : Map string HcExtras! }
        @description "std-orb-lint-input's LINT_HOST_FACTS: the closedCall, oauth, grant, defaultPorts, httpWire, family and emitKeys of the operators that state any."
      LINT_HOST_FACTS_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_HOST_FACTS_UNREAD: the host-effect facts could not be read."
      OrbLintInput.LINT_OPERATOR_SHAPES -> LINT_OPERATOR_SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> LINT_OPERATOR_SHAPES_UNREAD_HEARD
      OrbLintInput.LINT_HOST_FACTS -> LINT_HOST_FACTS_HEARD
      OrbLintInput.LINT_HOST_FACTS_UNREAD -> LINT_HOST_FACTS_UNREAD_HEARD
    }
  }
  trait OrbEmitConfig = EmitConfigUse.traits.OrbEmitConfig {
    listens {
      EMIT_CONFIG_CHECK { requestId : string!  items : [EmitItem]! }
        @description "Check each item's emit object against its allowed keys and the events its trait declares."
      OrbLintBrowserEffects.EMIT_CONFIG_CHECK -> EMIT_CONFIG_CHECK
    }
  }
  page boot as OrbLintBrowserEffectsOrbitalStart -> OrbLintBrowserEffects, OrbLintBrowserEffectsCli, OrbLintInput, Packs, Versions, HostCalls, OrbEmitConfig
}
