app std-orb-vectors [
  version: "1.0.0",
  inbound: ["cli-behaviors-vectors-snapshot"],
  fs: { cwd: "**": [read, write, remove, create] },
  env: ["ALMADAR_VECTORS_DIR", "HOME", "EMBEDDING_PROVIDER", "EMBEDDING_API_KEY", "OPENAI_API_KEY", "OPEN_ROUTER_API_KEY", "EMBEDDING_MODEL", "LMSTUDIO_EMBEDDING_MODEL"],
  exec: ["kill"],
  egress: ["https://api.openai.com", "https://openrouter.ai", "http://127.0.0.1:1234"],
  description: "std-orb-vectors — the `orb behaviors vectors snapshot --package <dir> [--out <path>]` command. It finds the installed package (its root, its prefix and its locked snapshot path), takes the package's organism texts then its capability texts, reads the environment the Rust command reads (ALMADAR_VECTORS_DIR or HOME for the user store; EMBEDDING_PROVIDER, EMBEDDING_API_KEY, OPENAI_API_KEY, OPEN_ROUTER_API_KEY and EMBEDDING_MODEL for the provider model, empty when no provider is configured), and hands the texts to std-vector-snapshot, which resolves, embeds and persists what is missing and writes the snapshot (default <package>/dist/vectors.vec). It answers `<prefix>: <n> vectors (<model>) -> <out>`. The legacy `vectors import` command is retired and has no program. The package and the texts arrive as VECTORS_PACKAGE_NEEDED / VECTORS_TEXTS_NEEDED requests answered by behavior/packages and behavior/texts; until those operators exist the answers are the events VECTORS_PACKAGE_FOUND, ORGANISM_TEXTS_FOUND and CAPABILITY_TEXTS_FOUND."
]
uses Spec from "almadar-std/orb-vectors"
uses Snapshot from "std/behaviors/std-vector-snapshot"
uses Resolve from "std/behaviors/std-vector-resolve"
uses Store from "std/behaviors/std-vector-store"
uses Llm from "std/behaviors/std-llm"
uses Write from "std/behaviors/std-vector-write"
uses Quantize from "std/behaviors/std-vector-quantize"
uses F32 from "std/behaviors/std-f32"
uses Delay from "std/behaviors/std-delay"
uses Sig6 from "std/behaviors/std-sig6"
uses BigCmp from "std/behaviors/std-bigcmp"

type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type WantedText = { key : string!, text : string! }
type TextRow = { key : string!, text : string!, hash : string! }
type StoreEntry = { found : boolean!, dims : number!, scale : number!, record : bytes!, vector : [number]! }

orbital OrbVectorsOrbital {
  uses Args from "std/behaviors/std-args"

  entity OrbVectorsRun [runtime] {
    id : string!
    pkgDir : string = ""
    outArg : string = ""
    root : string = ""
    prefix : string = ""
    lockedPath : string = ""
    organism : [TextRow] = []
    wanted : [WantedText] = []
    envDir : string = ""
    envHome : string = ""
    envProv : string = ""
    envKey : string = ""
    envOpenai : string = ""
    envRouter : string = ""
    envModel : string = ""
    envLmModel : string = ""
    providerKind : string = ""
    embedModel : string = ""
    userDir : string = ""
    providerModel : string = ""
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbVectors.VECTORS_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait VcStore = Store.traits.VectorLookup {
    listens {
      VcResolve.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      VcSnapshot.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      VcWrite.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      VcSig6.SIG6_DONE -> SIG6_DONE
      VcSig6.SIG6_REFUSED -> SIG6_REFUSED
    }
  }

  trait VcWrite = Write.traits.VectorWrite {
    listens {
      VcResolve.VECTOR_WRITE -> VECTOR_WRITE
      VcQuantize.QUANTIZED -> QUANTIZED
      VcQuantize.QUANTIZE_REFUSED -> QUANTIZE_REFUSED
      VcStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      VcStore.VECTOR_REFUSED -> VECTOR_REFUSED
      VcDelay.ELAPSED -> ELAPSED
    }
  }

  trait VcQuantize = Quantize.traits.VectorQuantize {
    listens {
      VcWrite.QUANTIZE -> QUANTIZE
      VcF32.F32_ENCODED -> F32_ENCODED
      VcF32.F32_REFUSED -> F32_REFUSED
      VcSig6.SIG6_DONE -> SIG6_DONE
      VcSig6.SIG6_REFUSED -> SIG6_REFUSED
    }
  }

  trait VcF32 = F32.traits.F32Encode {
    listens {
      VcQuantize.F32_ENCODE -> F32_ENCODE
      VcSig6.F32_ENCODE -> F32_ENCODE
    }
  }

  trait VcSig6 = Sig6.traits.Sig6 {
    listens {
      VcQuantize.SIG6 -> SIG6
      VcStore.SIG6 -> SIG6
      VcBigCmp.BIGCMP_ANSWERED -> BIGCMP_ANSWERED
      VcF32.F32_ENCODED -> F32_ENCODED
      VcF32.F32_REFUSED -> F32_REFUSED
    }
  }

  trait VcBigCmp = BigCmp.traits.BigCmp {
    listens {
      VcSig6.BIGCMP_BATCH -> BIGCMP_BATCH
    }
  }

  trait VcDelay = Delay.traits.Delay {
    listens {
      VcWrite.LOCK_WAIT -> START
    }
  }

  trait VcLlmOrShared = Llm.traits.LlmClient {
    events {
      LLM_EMBED: LLM_EMBED_ORS
    }
    config {
      embedProvider: openrouter
      embedOrigin: "https://openrouter.ai"
      embedBasePath: "/api/v1"
      embedModel: "baai/bge-base-en-v1.5"
      embedApiKey: "EMBEDDING_API_KEY"
    }
    listens {
      VcResolve.LLM_EMBED_ORS -> LLM_EMBED_ORS
    }
  }

  trait VcLlmOrOwn = Llm.traits.LlmClient {
    events {
      LLM_EMBED: LLM_EMBED_ORO
    }
    config {
      embedProvider: openrouter
      embedOrigin: "https://openrouter.ai"
      embedBasePath: "/api/v1"
      embedModel: "baai/bge-base-en-v1.5"
      embedApiKey: "OPEN_ROUTER_API_KEY"
    }
    listens {
      VcResolve.LLM_EMBED_ORO -> LLM_EMBED_ORO
    }
  }

  trait VcLlmOaShared = Llm.traits.LlmClient {
    events {
      LLM_EMBED: LLM_EMBED_OAS
    }
    config {
      embedProvider: openai
      embedOrigin: "https://api.openai.com"
      embedBasePath: "/v1"
      embedModel: "baai/bge-base-en-v1.5"
      embedApiKey: "EMBEDDING_API_KEY"
    }
    listens {
      VcResolve.LLM_EMBED_OAS -> LLM_EMBED_OAS
    }
  }

  trait VcLlmOaOwn = Llm.traits.LlmClient {
    events {
      LLM_EMBED: LLM_EMBED_OAO
    }
    config {
      embedProvider: openai
      embedOrigin: "https://api.openai.com"
      embedBasePath: "/v1"
      embedModel: "baai/bge-base-en-v1.5"
      embedApiKey: "OPENAI_API_KEY"
    }
    listens {
      VcResolve.LLM_EMBED_OAO -> LLM_EMBED_OAO
    }
  }

  trait VcLlmLm = Llm.traits.LlmClient {
    events {
      LLM_EMBED: LLM_EMBED_LM
    }
    config {
      embedProvider: lmstudio
      embedOrigin: "http://127.0.0.1:1234"
      embedBasePath: "/v1"
      embedModel: "text-embedding-bge-base-en-v1.5"
      embedApiKey: "EMBEDDING_API_KEY"
    }
    listens {
      VcResolve.LLM_EMBED_LM -> LLM_EMBED_LM
    }
  }


  trait VcResolve = Resolve.traits.VectorResolve {
    listens {
      VcSnapshot.RESOLVE -> RESOLVE
      VcSnapshot.USER_STORE_READ -> USER_STORE_READ
      VcStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      VcStore.VECTOR_REFUSED -> VECTOR_REFUSED
      VcLlmOrShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      VcLlmOrShared.LLM_FAILED -> LLM_FAILED
      VcLlmOrOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      VcLlmOrOwn.LLM_FAILED -> LLM_FAILED
      VcLlmOaShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      VcLlmOaShared.LLM_FAILED -> LLM_FAILED
      VcLlmOaOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      VcLlmOaOwn.LLM_FAILED -> LLM_FAILED
      VcLlmLm.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      VcLlmLm.LLM_FAILED -> LLM_FAILED
      VcWrite.VECTOR_WRITTEN -> VECTOR_WRITTEN
      VcWrite.VECTOR_WRITE_REFUSED -> VECTOR_WRITE_REFUSED
      RESOLVE {
        wanted : [WantedText]!
        snapshots : [bytes]!
        snapshotPaths : [string]
        userDir : string!
        providerModel : string!
        providerKind : string
        embedModel : string
      }
      USER_STORE_READ {
        data : bytes!
      }
      VECTOR_RESOLVED {
        model : string!
        entries : [StoreEntry]!
      }
      VECTOR_REFUSED {
        code : string!
        detail : string!
      }
      LLM_EMBED_RESULT {
        embeddings : [[number]]!
      }
      LLM_FAILED {
        code : string
        message : string!
      }
      VECTOR_WRITTEN {
        path : string!
        count : number!
      }
      VECTOR_WRITE_REFUSED {
        code : string!
        detail : string!
      }
    }
  }


  trait VcSnapshot = Snapshot.traits.Snapshot {
    listens {
      OrbVectors.SNAPSHOT -> SNAPSHOT
      VcResolve.USER_STORE_NEEDED -> USER_STORE_NEEDED
      VcResolve.VECTORS_ANSWERED -> VECTORS_ANSWERED
      VcResolve.VECTORS_REFUSED -> VECTORS_REFUSED
      VcStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      VcStore.VECTOR_REFUSED -> VECTOR_REFUSED
      SNAPSHOT {
        wanted : [WantedText]!
        userDir : string!
        providerModel : string!
        providerKind : string
        embedModel : string
        out : string!
        locked : string!
      }
      USER_STORE_NEEDED {
        model : string!
        path : string!
      }
      VECTORS_ANSWERED {
        model : string!
        vectors : [{ key : string!, vector : [number]! }]!
      }
      VECTORS_REFUSED {
        code : string!
        detail : string!
      }
      VECTOR_RESOLVED {
        model : string!
        entries : [StoreEntry]!
      }
      VECTOR_REFUSED {
        code : string!
        detail : string!
      }
    }
  }

  trait OrbVectors -> OrbVectorsRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      SNAPSHOT_CALLED -> parsing
        (emit VECTORS_ARGS_PARSE { stage: "vectors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "package" aliases: [] takesValue: true repeatable: false }, { name: "out" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      VECTORS_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (!= (array/len (or (object/get @payload.flags "package") [])) 1))
        (emit VECTORS_CMD_ANSWERED { status: 400, body: "usage: orb behaviors vectors snapshot --package <dir> [--out <path>]" })
      VECTORS_ARGS_DONE -> packaging when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0) (= (array/len (or (object/get @payload.flags "package") [])) 1))
        (set @entity.pkgDir (array/first (object/get @payload.flags "package")))
        (set @entity.outArg (array/first (or (object/get @payload.flags "out") [""])))
        (emit VECTORS_PACKAGE_NEEDED { dir: @entity.pkgDir })
    }

    state packaging {
      INIT -> packaging
      VECTORS_PACKAGE_FOUND -> organism
        (set @entity.root @payload.root)
        (set @entity.prefix @payload.prefix)
        (set @entity.lockedPath (str/default @payload.vectors ""))
        (emit VECTORS_TEXTS_NEEDED { prefix: @payload.prefix, kind: "organism" })
      VECTORS_PACKAGE_FAILED -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: @payload.error })
    }

    state organism {
      INIT -> organism
      ORGANISM_TEXTS_FOUND -> capability
        (set @entity.organism @payload.texts)
        (emit VECTORS_TEXTS_NEEDED { prefix: @entity.prefix, kind: "capability" })
      VECTORS_TEXTS_FAILED -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: @payload.error })
    }

    state capability {
      INIT -> capability
      CAPABILITY_TEXTS_FOUND -> env1
        (set @entity.wanted (array/map (array/concat @entity.organism @payload.texts) (fn t { key: @t.key, text: @t.text })))
        (os/getenv "ALMADAR_VECTORS_DIR" { emit: { success: ENV1, failure: ENVF } })
      VECTORS_TEXTS_FAILED -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: @payload.error })
    }

    state env1 {
      INIT -> env1
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV1 -> env2
        (set @entity.envDir (str/default @payload.value ""))
        (os/getenv "HOME" { emit: { success: ENV2, failure: ENVF } })
    }

    state env2 {
      INIT -> env2
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV2 -> env3
        (set @entity.envHome (str/default @payload.value ""))
        (os/getenv "EMBEDDING_PROVIDER" { emit: { success: ENV3, failure: ENVF } })
    }

    state env3 {
      INIT -> env3
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV3 -> env4
        (set @entity.envProv (str/default @payload.value ""))
        (os/getenv "EMBEDDING_API_KEY" { emit: { success: ENV4, failure: ENVF } })
    }

    state env4 {
      INIT -> env4
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV4 -> env5
        (set @entity.envKey (str/default @payload.value ""))
        (os/getenv "OPENAI_API_KEY" { emit: { success: ENV5, failure: ENVF } })
    }

    state env5 {
      INIT -> env5
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV5 -> env6
        (set @entity.envOpenai (str/default @payload.value ""))
        (os/getenv "OPEN_ROUTER_API_KEY" { emit: { success: ENV6, failure: ENVF } })
    }

    state env6 {
      INIT -> env6
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV6 -> env7
        (set @entity.envRouter (str/default @payload.value ""))
        (os/getenv "EMBEDDING_MODEL" { emit: { success: ENV7, failure: ENVF } })
    }

    state env7 {
      INIT -> env7
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV7 -> env8
        (set @entity.envModel (str/default @payload.value ""))
        (os/getenv "LMSTUDIO_EMBEDDING_MODEL" { emit: { success: ENV8, failure: ENVF } })
    }

    state env8 {
      INIT -> env8
      ENVF -> ready
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat "cannot read the environment: " @payload.error) })
      ENV8 -> running
        (set @entity.envLmModel (str/default @payload.value ""))
        (set @entity.userDir (if (!= @entity.envDir "") @entity.envDir (str/concat @entity.envHome "/.almadar/vectors")))
        (set @entity.providerKind (if (== (if (!= @entity.envProv "") @entity.envProv "openrouter") "openai") (if (!= @entity.envKey "") "openai-shared" (if (!= @entity.envOpenai "") "openai-own" "")) (if (== (if (!= @entity.envProv "") @entity.envProv "openrouter") "openrouter") (if (!= @entity.envKey "") "openrouter-shared" (if (!= @entity.envRouter "") "openrouter-own" "")) "lmstudio")))
        (set @entity.providerModel (if (== @entity.providerKind "") "" (if (== (if (!= @entity.envProv "") @entity.envProv "openrouter") "lmstudio") "baai/bge-base-en-v1.5" (if (!= @entity.envModel "") @entity.envModel "baai/bge-base-en-v1.5"))))
        (set @entity.embedModel (if (== @entity.providerKind "") "" (if (== (if (!= @entity.envProv "") @entity.envProv "openrouter") "lmstudio") (if (!= @entity.envLmModel "") @entity.envLmModel "text-embedding-bge-base-en-v1.5") @entity.providerModel)))
        (emit SNAPSHOT { wanted: @entity.wanted, userDir: @entity.userDir, providerModel: @entity.providerModel, providerKind: @entity.providerKind, embedModel: @entity.embedModel, out: (if (!= @entity.outArg "") @entity.outArg (str/concat @entity.root "/dist/vectors.vec")), locked: @entity.lockedPath })
    }

    state running {
      INIT -> running
      SNAPSHOT_DONE -> ready
        (emit VECTORS_CMD_ANSWERED { status: 200, body: (str/concat @entity.prefix ": " @payload.records " vectors (" @payload.model ") -> " @payload.out) })
      SNAPSHOT_REFUSED -> ready when (= @payload.code "ORB_VECTOR_EMPTY")
        (emit VECTORS_CMD_ANSWERED { status: 500, body: @payload.detail })
      SNAPSHOT_REFUSED -> ready when (!= @payload.code "ORB_VECTOR_EMPTY")
        (emit VECTORS_CMD_ANSWERED { status: 500, body: (str/concat @payload.code ": " @payload.detail) })
    }

    emits {
      VECTORS_CMD_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      VECTORS_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @tier "internal"
      VECTORS_PACKAGE_NEEDED -> external {
        dir : string!
      }
        @description "Ask behavior/packages for the installed package at this directory; answered by VECTORS_PACKAGE_FOUND { root, prefix, vectors } or VECTORS_PACKAGE_FAILED { error }."
        @tier "secondary"
      VECTORS_TEXTS_NEEDED -> external {
        prefix : string!
        kind : string!
      }
        @description "Ask behavior/texts for this package's organism or capability texts; answered by ORGANISM_TEXTS_FOUND or CAPABILITY_TEXTS_FOUND { texts }, or VECTORS_TEXTS_FAILED { error }."
        @tier "secondary"
      SNAPSHOT -> external {
        wanted : [WantedText]!
        userDir : string!
        providerModel : string!
        providerKind : string
        embedModel : string
        out : string!
        locked : string!
      }
        @tier "secondary"
      ENV1 -> internal {
        value : string
      }
      ENV2 -> internal {
        value : string
      }
      ENV3 -> internal {
        value : string
      }
      ENV4 -> internal {
        value : string
      }
      ENV5 -> internal {
        value : string
      }
      ENV6 -> internal {
        value : string
      }
      ENV7 -> internal {
        value : string
      }
      ENV8 -> internal {
        value : string
      }
      ENVF -> internal {
        error : string!
        kind : string!
      }
    }

    listens {
      SNAPSHOT_CALLED -> inbound "cli-behaviors-vectors-snapshot" answers VECTORS_CMD_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors vectors snapshot` with its arguments."
        @synonyms "orb behaviors vectors snapshot, write vectors.vec"
      ArgsCli.ARGS_PARSED -> VECTORS_ARGS_DONE
      VECTORS_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
      VcSnapshot.SNAPSHOT_DONE -> SNAPSHOT_DONE
      VcSnapshot.SNAPSHOT_REFUSED -> SNAPSHOT_REFUSED
      SNAPSHOT_DONE {
        model : string!
        records : number!
        out : string!
      }
      SNAPSHOT_REFUSED {
        code : string!
        detail : string!
      }
      VECTORS_PACKAGE_FOUND {
        root : string!
        prefix : string!
        vectors : string
      }
        @description "The installed package: its root directory, its prefix and its locked vectors path (absent when none)."
      VECTORS_PACKAGE_FAILED {
        error : string!
      }
        @description "behavior/packages failed: the directory is not an installed behavior package."
      ORGANISM_TEXTS_FOUND {
        texts : [TextRow]!
      }
        @description "The package's organism texts in embed order."
      CAPABILITY_TEXTS_FOUND {
        texts : [TextRow]!
      }
        @description "The package's capability texts in embed order."
      VECTORS_TEXTS_FAILED {
        error : string!
      }
        @description "behavior/texts failed."
    }
  }

  page "/orb-vectors" as OrbVectorsPage -> OrbVectors, ArgsCli, VcSnapshot, VcResolve, VcStore, VcWrite, VcQuantize, VcF32, VcSig6, VcBigCmp, VcDelay, VcLlmOrShared, VcLlmOrOwn, VcLlmOaShared, VcLlmOaOwn, VcLlmLm
}
