                                   (let ((li (array/filter (array/range 0 @argc) (fn i (let ((a (array/nth @n (+ @i 1)))) (and (validate/array @a) (>= (array/len @a) 3) (let ((a0 (array/nth @a 0))) (and (validate/string @a0) (object/has @fnSet (str/replaceAll (str/replaceAll @a0 "~" "~t") "." "~d")))))))))) 
                                     (if (> (array/len @li) 0) (let ((lc (array/nth @kk (+ (array/last @li) 1)))) (object/get @lc "ls" [])) []))
                                   (if (= @sm "listed")
                                     (let ((picked (object/get @sl "args" [])))
                                       (if (and (> (array/len @picked) 0) (not (array/some @picked (fn i (or (< @i 0) (>= @i @argc))))))
                                         (array/flatten (array/map @picked (fn i (let ((pc (array/nth @kk (+ @i 1)))) (object/get @pc "s" [])))))
                                         []))
                                     [])))))))
                    { s: @s, ls: (let ((lc (array/nth @kk @argc))) (object/get @lc "s" [])) }))))))))
    (if (validate/string @n) { s: [@n], ls: [] } @ns))) "FiredNode") "s" []) [])))))) (fn x (and (not (str/startsWith @x (quote "@"))) (not (object/has @busSet (str/replaceAll (str/replaceAll @x "~" "~t") "." "~d")))))) (fn x { k: "c", h: @x, site: @site, kind: (object/get @ctl (str/replaceAll (str/replaceAll @site "~" "~t") "." "~d") ""), src: "" })) []))))))))
                    (eo (if @hasEm (let ((em (object/get @n "emit" null))) (if (validate/object @em) (array/flatten (array/map (object/values @em) (fn v (if (validate/string @v) [{ k: "o", h: @v, site: "", kind: "", src: "" }] [])))) [])) [])))
                (let ((all (array/concat (if (= (array/len @kids) 0) [] (array/filter @kids (fn x (!= (object/get @x "k") "o")))) (array/concat @own @eo))))
                  (if (= (array/len @all) 0) @nr { h: "", ok: false, it: (if (object/has @n "~ti") (array/map @all (fn x (if (= (object/get @x "k") "c") { k: "c", h: (object/get @x "h"), site: (object/get @x "site"), kind: (object/get @x "kind"), src: (object/get @n "~ti") } @x))) @all) })))))))
      (if (validate/string @n) { h: @n, ok: true, it: [] } @nr)))) "FiredNode")))
                        (let ((items (object/get @fr "it" [])) (trs (object/get @t "stateMachine.transitions" [])) (sts (object/get @t "stateMachine.states" [])))
                          (let ((evAll (array/map (array/filter @items (fn x (= (object/get @x "k") "e"))) (fn x (object/get @x "h")))) (init (array/find @sts (fn s (= (object/get @s "isInitial" false) true)))))
                            (let ((tp (array/map @trs (fn x { x: @x, a: (or (= (object/get @x "guard" null) null) (array/includes @evAll (str/concat "~T" (array/indexOf @trs @x)))) }))))
                              (let ((reach (if (= @init null) [] (array/reduce (array/range 0 (array/len @sts)) [(object/get @init "name" "")] (fn (vis i) (array/unique (array/concat @vis (array/map (array/filter @tp (fn p (and (object/get @p "a") (let ((fr (let ((f (object/get (object/get @p "x") "from" ""))) (if (validate/string @f) (array/append [] @f) @f)))) (or (array/includes @fr "*") (array/some @fr (fn q (array/includes @vis @q)))))))) (fn p (object/get (object/get @p "x") "to" ""))))))))))
                                (let ((liveIdx (array/map (array/filter @tp (fn p (and (object/get @p "a") (or (= @init null) (let ((fr (let ((f (object/get (object/get @p "x") "from" ""))) (if (validate/string @f) (array/append [] @f) @f)))) (or (array/includes @fr "*") (array/some @fr (fn q (array/includes @reach @q))))))))) (fn p (str/concat "t" (array/indexOf @trs (object/get @p "x")))))))
                                  { trait: (object/get @t "name" ""), ev: (array/filter @evAll (fn e (not (str/startsWith @e "~T")))), ctl: (array/map (array/filter @items (fn x (= (object/get @x "k") "c"))) (fn x (object/get @x "h"))), lv: (array/map (array/filter @items (fn x (and (= (object/get @x "k") "c") (= (object/get @x "kind") "y") (or (= (object/get @x "src") "tick") (array/includes @liveIdx (object/get @x "src")))))) (fn x { ev: (object/get @x "h"), site: (object/get @x "site") })), br: (array/map (array/filter @items (fn x (= (object/get @x "k") "b"))) (fn x (object/get @x "h"))) })))))))))))))))
            (let ((tnames (array/unique (array/map @recs (fn r (object/get @r "trait" "")))))
                  (g (array/groupBy @recs (fn r (str/replaceAll (str/replaceAll (object/get @r "trait" "") "~" "~t") "." "~d")))))
              (emit FIRED_EVENTS {
                scope: @payload.scope,
                byControl: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "ctl" []))))))]))) {}),
                byEffect: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "ev" []))))))]))) {}),
                controls: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (let ((pairs (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "lv" [])))))) (array/map (array/sort (array/unique (array/map @pairs (fn p (object/get @p "ev"))))) (fn ev { event: @ev, sites: (array/sort (array/unique (array/map (array/filter @pairs (fn p (= (object/get @p "ev") @ev))) (fn p (object/get @p "site"))))) })))]))) {}),
                bridged: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "br" []))))))]))) {}) }))))
    }

    emits {
      FIRED_EVENTS -> external { scope : string!  byControl : Map string [string]!  byEffect : Map string [string]!  controls : Map string [FiredControl]!  bridged : Map string [string]! }
        @description "The event names the program produces, per trait: byControl by a rendered control's event-bearing prop, byEffect by an emit effect or an operator's emit config; controls the live non-notification controls of the registry's control props with the pattern.prop sites that fire each (reachable, unguarded-false transitions and ticks only); bridged the events a bridged behavior/apply embed in the trait delivers into the embed."
        @tier "internal"
    }

    listens {
      FIRED_PROPS_HEARD { names : [string]!  maps : [string]!  listens : Map string [string]!  controls : [ControlProp]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: the event-bearing prop names of the installed pattern registry."
      FIRED_SEMANTICS_HEARD { functions : [string]!  busExcluded : [string]!  targetOptions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators, the bus-excluded events and the dispatch target options."
      FIRED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      FIRED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
    }
  }

  page boot as OrbFiredEventsOrbitalStart -> OrbFiredEvents
}
