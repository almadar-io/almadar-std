app std-orb-fired-events [
  version: "1.0.0",
  description: "std-orb-fired-events — the one place a lint run decides which event names a composition produces, the port of the compiler's collect_schema_fired_events. For every inline trait of the lowered program it walks the transition effects, the tick effects and the config defaults and answers FIRED_EVENTS { scope, byControl, byEffect }, each a map from trait name to its event names. byEffect holds the event of an `(emit EVENT)` effect and every string under an `emit` config of an operator call; byControl holds the string leaves of the event-bearing props of a rendered pattern (LINT_EVENT_PROPS names, the leaves read through the operators' value-source slots) and the leaves of the values of an event-map prop, never a binding. A branch whose condition is provably false, folding the trait's literal config knobs into the condition, contributes nothing; the walk of a value's leaves skips a provably false branch without the knobs. The rules that ask whether something is fired compose this trait and read FIRED_EVENTS; they never walk effects themselves."
]
uses Spec from "almadar-std/fired-events"
type FiredItem = { k : string!, h : string!, site : string!, kind : string!, src : string! }
type FiredR = { h : string!, ok : boolean!, it : [FiredItem]! }
type FiredS = { s : [string]!, ls : [string]! }
type FiredLive = { ev : string!, site : string! }
type FiredRec = { trait : string!, ev : [string]!, ctl : [string]!, lv : [FiredLive]!, br : [string]! }
type FiredScalar = string | number | boolean
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredFrom = string | [string]
type FiredTransition = { event : string, from : FiredFrom, to : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredState = { name : string, isInitial : boolean }
type FiredMachine = { states : [FiredState], transitions : [FiredTransition] }
type ControlProp = { pattern : string!, prop : string!, kind : string!, notification : boolean! }
type FiredControl = { event : string!, sites : [string]! }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type WalkSlot = { kind : string!, args : [number] }

