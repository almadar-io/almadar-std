                        (let ((items (array/filter (object/get @fr "it" []) (fn x (validate/array @x)))))
                          { trait: (object/get @t "name" ""), ev: (array/map (array/filter @items (fn x (= (array/nth @x 0) "e"))) (fn x (array/nth @x 1))), ctl: (array/map (array/filter @items (fn x (= (array/nth @x 0) "c"))) (fn x (array/nth @x 1))) })))))))))))
            (let ((tnames (array/unique (array/map @recs (fn r (object/get @r "trait" "")))))
                  (g (array/groupBy @recs (fn r (str/replaceAll (str/replaceAll (object/get @r "trait" "") "~" "~t") "." "~d")))))
              (emit FIRED_EVENTS {
                scope: @payload.scope,
                byControl: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "ctl" []))))))]))) {}),
                byEffect: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "ev" []))))))]))) {}) }))))
    }

    emits {
      FIRED_EVENTS -> external { scope : string!  byControl : Map string [string]!  byEffect : Map string [string]! }
        @description "The event names the program produces, per trait: byControl by a rendered control's event-bearing prop, byEffect by an emit effect or an operator's emit config."
        @tier "internal"
    }

    listens {
      FIRED_PROPS_HEARD { names : [string]!  maps : [string]!  listens : Map string [string]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: the event-bearing prop names of the installed pattern registry."
      FIRED_SEMANTICS_HEARD { semantics : Map string string!  functions : [string]!  busExcluded : [string]!  targetOptions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: each operator's declared returnSemantics and the function-returning operators."
      FIRED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
    }
  }

  page boot as OrbFiredEventsOrbitalStart -> OrbFiredEvents
}
