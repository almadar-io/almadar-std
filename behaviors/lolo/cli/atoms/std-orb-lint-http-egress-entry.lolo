app std-orb-lint-http-egress-entry [
  version: "1.0.0",
  inbound: ["cli-lint-http-egress-entry"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-http-egress-entry — the `orb lint http-egress-entry <file>` command, the port of ORB_HTTP_EGRESS_ENTRY_INVALID (effect/http.rs validate_http_effects over http_wire parse_egress_entry). It lowers the file with program/read and reports each app `egress` entry that is not `scheme://host[:port]` for http, https, redis, rediss, postgres or postgresql (no path, query, credentials, space, backslash, empty host or a port outside 0..65535), with the Rust path, message and suggestion (status 500, exit 1). The other ORB_HTTP rules check the arguments of `http` calls nested in effects, which this lint cannot walk without a tree fold. Clean answers `lint http-egress-entry: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-http-egress-entry"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type HttpEgressProgram = { egress : [string] }

orbital OrbLintHttpEgressEntryOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintHttpEgressEntryRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintHttpEgressEntry -> OrbLintHttpEgressEntryRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((entries (object/get @payload.program "egress" [])))
          (array/flatten (array/map (array/range 0 (array/len @entries)) (fn i
            (let ((en (array/nth @entries @i)))
              (if (validate/pattern @en "^([Hh][Tt][Tt][Pp][Ss]?|[Rr][Ee][Dd][Ii][Ss][Ss]?|[Pp][Oo][Ss][Tt][Gg][Rr][Ee][Ss]([Qq][Ll])?)://(\\[[^\\]/?#\\\\@ ]+\\]|[^:/?#\\\\@ \\[][^:/?#\\\\@ ]*)(:\\+?0*([0-5]?[0-9]{1,4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?$")
                []
                [{ code: "ORB_HTTP_EGRESS_ENTRY_INVALID", path: (str/concat "egress[" @i "]"), message: (str/concat "egress entry '" @en "' is not scheme://host[:port]"), suggestion: "Write an origin only: no path, query, credentials or trailing slash", severity: "error" }])))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "http-egress-entry", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : HttpEgressProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintHttpEgressEntryCli -> OrbLintHttpEgressEntryRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint http-egress-entry <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "http-egress-entry") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint http-egress-entry: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "http-egress-entry") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint http-egress-entry: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-http-egress-entry" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint http-egress-entry` with its arguments and working directory."
        @synonyms "orb lint http-egress-entry, http egress entry"
      OrbLintHttpEgressEntry.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintHttpEgressEntryCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintHttpEgressEntryOrbitalStart -> OrbLintHttpEgressEntry, OrbLintHttpEgressEntryCli, OrbLintInput, Packs, Versions
}
