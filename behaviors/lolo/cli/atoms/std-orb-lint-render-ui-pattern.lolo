app std-orb-lint-render-ui-pattern [
  version: "1.0.0",
  inbound: ["cli-lint-render-ui-pattern"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-render-ui-pattern — the `orb lint render-ui-pattern <file>` command, the port of render_ui/pattern.rs validate_pattern: the walk over every render-ui pattern of every inline trait transition (an array effect's pattern at [2], an object effect's at .render_ui.pattern), with ORB_RUI_INVALID_PATTERN (unknown pattern type or name, an operator named as a pattern, a node that is not an object, string or null), ORB_RUI_MISSING_PATTERN_TYPE, ORB_RUI_INVALID_PROP (with the did-you-mean), ORB_RUI_MISSING_REQUIRED_PROP, ORB_RUI_PROP_TYPE_MISMATCH (type, enum, if-branch enum, bare string for an array prop, render-node prop given plain objects, nested enum sub-field), ORB_RUI_ELEMENT_SHAPE_MISMATCH, ORB_RUI_FORM_FIELD_INTRINSIC, ORB_RUI_CHILD_NOT_DRAWABLE, ORB_RUI_MISSING_ACTION and ORB_A11Y_UNNAMED. The children of a pattern are read as the compiler reads them: a mapped (array/map c (fn x node)) child is checked as its node, an operator call or conditional in a children position is flattened to the literal fragments it combines, and a conditional render node validates its arms. The pattern facts come from std-orb-lint-input's LINT_PATTERNS (the installed registry) and the operator names from its LINT_OPERATOR_NAMES. It walks the tree level by level and reports the findings in the compiler's depth-first order with the Rust path, message and suggestion (status 500, exit 1). Not here: the itemActions, field-path and field-ref checks (item_actions.rs, field_path.rs) and ORB_X_ENTITY_PROP_CONTRACT. Clean answers `lint render-ui-pattern: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-render-ui-pattern"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type RuiVal = string | number | boolean | [RuiVal?] | Map string RuiVal?
type RuiField = { name : string, intrinsic : boolean }
type RuiEntity = { name : string, fields : [RuiField] }
type RuiTransition = { effects : [RuiVal?] }
type RuiMachine = { transitions : [RuiTransition] }
type RuiTrait = { name : string, linkedEntity : string, stateMachine : RuiMachine? }
type RuiOrbital = { name : string, entity : RuiEntity?, traits : [RuiTrait] }
type RuiProgram = { orbitals : [RuiOrbital] }
type RuiWork = { node : string!, path : string!, ord : string!, linked : string! }
type RuiKeyed = { key : string!, code : string!, path : string!, message : string!, suggestion : string! }
type RuiStep = { f : [RuiKeyed]!, n : [RuiWork]! }
type RuiTarget = { v : RuiVal?, p : string!, o : string!, kind : string!, draw : boolean! }
type RuiPiece = { v : RuiVal?, k : string! }
type RuiLeaf = { v : RuiVal?, d : boolean!, s : string! }
type RuiPair = { v : RuiVal?, s : RuiPatternPropShape!, d : boolean!, t : string! }
type RuiIntr = { name : string!, fields : [string]! }
type RuiRaw = { code : string!, path : string!, message : string!, suggestion : string! }
type RuiQuery = { u : string!, valid : [string]!, pat : boolean! }
type RuiCand = { v : string!, p : number!, d : number! }
type RuiPatternPropShape = { types : [string], requiredOnParent : boolean, requiredNames : [string], enumValues : [string], kind : string, itemKind : string, items : RuiPatternPropShape, properties : Map string RuiPatternPropShape }
type RuiPatternShape = { drawHost : boolean, drawable : boolean, fieldsContract : string, accessibleName : [string], props : Map string RuiPatternPropShape }

orbital OrbLintRenderUiPatternOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintRenderUiPatternRun [runtime] {
    id : string!
    scope : string = ""
    propsOf : Map string (Map string RuiPatternPropShape) = {}
    drawHosts : [string] = []
    drawables : [string] = []
    forms : [string] = []
    actionRequired : [string] = []
    accessible : Map string [string] = {}
    names : [string] = []
    ops : [string] = []
    intr : [RuiIntr] = []
    frontier : [RuiWork] = []
    stepRes : [RuiStep] = []
    found : [RuiKeyed] = []
    level : number = 0
  }

  trait OrbLintRenderUiPattern -> OrbLintRenderUiPatternRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_PATTERNS_HEARD -> ready
        (set @entity.names (object/keys @payload.patterns))
        (set @entity.propsOf (object/mapValues @payload.patterns (fn e (object/get @e "props" {}))))
        (set @entity.drawHosts (array/filter (object/keys @payload.patterns) (fn n (object/get (object/get @payload.patterns @n {}) "drawHost" false))))
        (set @entity.drawables (array/filter (object/keys @payload.patterns) (fn n (object/get (object/get @payload.patterns @n {}) "drawable" false))))
        (set @entity.actionRequired (array/filter (object/keys @payload.patterns) (fn n (object/get (object/get @payload.patterns @n {}) "requiresAction" false))))
        (set @entity.forms (array/filter (object/keys @payload.patterns) (fn n (= (object/get (object/get @payload.patterns @n {}) "fieldsContract" "") "form"))))
        (set @entity.accessible (object/fromEntries (array/map (array/filter (object/keys @payload.patterns) (fn n (object/has (object/get @payload.patterns @n {}) "accessibleName"))) (fn n [@n, (object/get (object/get @payload.patterns @n {}) "accessibleName" [])]))))
      LINT_OPERATOR_NAMES_HEARD -> ready
        (set @entity.ops @payload.names)
      LINT_INPUT -> walking
        (set @entity.scope @payload.scope)
        (set @entity.found [])
        (set @entity.level 0)
        (set @entity.intr (array/map (array/filter (object/get @payload.program "orbitals" []) (fn o2 (!= (object/get (object/get @o2 "entity" {}) "name" "") ""))) (fn o3 { name: (object/get (object/get @o3 "entity" {}) "name" ""), fields: (array/map (array/filter (object/get (object/get @o3 "entity" {}) "fields" []) (fn f2 (object/get @f2 "intrinsic" false))) (fn f3 (object/get @f3 "name" ""))) })))
        (set @entity.frontier (let ((orbitals (object/get @payload.program "orbitals" []))) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((trs (object/get (array/nth @orbitals @oi) "traits" []))) (array/flatten (array/map (array/range 0 (array/len @trs)) (fn tj (let ((tr0 (array/nth @trs @tj))) (if (not (object/has @tr0 "stateMachine")) [] (let ((trans (object/get (object/get @tr0 "stateMachine" {}) "transitions" [])) (base (str/concat "orbitals[" @oi " (" (object/get (array/nth @orbitals @oi) "name" "") ")].traits[" @tj " (" (object/get @tr0 "name" "") ")].stateMachine.transitions["))) (array/flatten (array/map (array/range 0 (array/len @trans)) (fn tk (let ((effs (object/get (array/nth @trans @tk) "effects" []))) (array/flatten (array/map (array/range 0 (array/len @effs)) (fn em (let ((e (array/nth @effs @em)) (ep (str/concat @base @tk "].effects[" @em "]"))) (let ((e_k (if (validate/object @e) "o" (if (validate/array @e) "a" (if (validate/string @e) "s" (if (validate/number @e) "n" (if (validate/boolean @e) "b" "z")))))) (e_s (if (validate/string @e) @e "")) (e_n (if (validate/number @e) @e 0)) (e_b (if (validate/boolean @e) @e false)) (e_a (if (validate/array @e) @e [])) (e_o (if (validate/object @e) @e {})) (e_len (array/len @e_a)) (e_h (let ((h0 (if (> @e_len 0) (array/nth @e_a 0) null))) (if (validate/string @h0) @h0 "")))) (if (and (= @e_k "a") (> @e_len 2) (array/includes ["render-ui", "render_ui"] @e_h)) [{ node: (json/stringify (array/nth @e_a 2)), path: (str/concat @ep "[2]"), ord: (str/concat (str/padStart (str/concat "" @oi) 6 "0") "x" (str/padStart (str/concat "" @tj) 6 "0") "x" (str/padStart (str/concat "" @tk) 6 "0") "x" (str/padStart (str/concat "" @em) 6 "0")), linked: (object/get @tr0 "linkedEntity" "") }] (if (= @e_k "o") (let ((r1 (object/get @e_o "render_ui" null)) (r2 (object/get @e_o "render-ui" null))) (let ((r1_k (if (validate/object @r1) "o" (if (validate/array @r1) "a" (if (validate/string @r1) "s" (if (val