app std-orb-behaviors [
  version: "1.0.0",
  inbound: ["cli-behaviors-catalog", "cli-behaviors-describe", "cli-behaviors-source", "cli-behaviors-which", "cli-behaviors-texts", "cli-behaviors-expects"],
  fs: { "/dev/fd/0": [read], cwd: "**": [read] },
  description: "std-orb-behaviors — the `orb behaviors catalog|describe|source|which|texts|expects` commands over the behavior reflection operators. `catalog <scope…> [--exposure <e>]… [--json] [--no-vectors]` lists the installed behaviors under the scopes (`behavior/catalog`; `--no-vectors` is its `vectors: false` option, reading no vector store) as one table row each, or as JSON with --json; `describe <behavior>.traits.<Trait>|<behavior>|<behavior>.orbitals.<Orbital>|- [--json] [--knob-vectors]` prints the description as JSON (`behavior/describe`; `-` reads a trait or orbital value as JSON from stdin; `--knob-vectors` attaches each knob's embedding vector, `behavior/describe`'s `knobVectors` option); `source <behavior> [--json]` prints the behavior's program as JSON (`behavior/source`); `which <spec>` prints `<path> (<owner>)`, the file the specifier resolves to and the package that owns it (`behavior/resolve` with `path: true`); `texts <scope…> [--kind organism|capability|knob] [--json]` prints the embedding texts under the scopes as one compact JSON array of { key, text, hash } (`behavior/texts`; `--json` is accepted, the only format). `expects <file.orb|spec> [--json]` prints each orbital's derived expectations as one compact JSON line, `{ <orbital>: { expectations, diagnostics } }` (`behavior/resolve` with `expects: true`; a spec naming an existing file under the working directory is read as that file, an absolute path when relative to the hook's cwd, `--json` is accepted, the only format). Each answers status 200 (exit 0). Each subcommand is its own cli hook, so the other `orb behaviors` subcommands (vectors) stay with the Rust command. A missing operand answers the usage (status 400, exit 2); a failed reflection answers its error (status 500, exit 1)."
]
uses Spec from "almadar-std/orb-behaviors"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type OrbBehaviorsCatalogHit = {
  behavior : string!
  package : string!
  topic : string!
  level : string!
  exposure : string
  description : string!
  capabilities : [string]
  traits : [trait]!
  value : behavior!
  vectors : Map string [number]
  model : string
}
type OrbBehaviorsWhich = { path : string!, owner : string! }
type OrbBehaviorsText = { key : string!, text : string!, hash : string! }
type ExpectValue = string | number | boolean | [ExpectValue?] | Map string ExpectValue?
type DescribeValue = { behavior : string!, trait : string, orbital : string }
type OrbBehaviorsKnobField = {
  key : string!
  type : string!
  label : string
  description : string
  tier : string
  vector : [number]
}
type TraitEvents = {
  emits : [string]!
  listens : [string]!
  transitions : [string]!
}
type TraitDescription = {
  value : trait
  knobs : [OrbBehaviorsKnobField]!
  events : TraitEvents!
  model : string
}
type OrbBehaviorsDescription = {
  behavior : string!
  knobs : [OrbBehaviorsKnobField]!
}

orbital OrbBehaviorsOrbital {
  uses Args from "std/behaviors/std-args"

  entity OrbBehaviorsRun [runtime] {
    id : string!
    sub : string = ""
    json : boolean = false
    exposure : [string] = []
    paths : [string] = []
    spec : string = ""
    noVectors : boolean = false
    knobVectors : boolean = false
    kind : string = ""
    cwd : string = ""
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbBehaviors.BEHAVIORS_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbBehaviors -> OrbBehaviorsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      CATALOG_CALLED -> parsing
        (set @entity.sub "catalog")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "no-vectors" aliases: [] takesValue: false repeatable: false }, { name: "exposure" aliases: [] takesValue: true repeatable: true }] })
      DESCRIBE_CALLED -> parsing
        (set @entity.sub "describe")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "knob-vectors" aliases: [] takesValue: false repeatable: false }] })
      SOURCE_CALLED -> parsing
        (set @entity.sub "source")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }] })
      WHICH_CALLED -> parsing
        (set @entity.sub "which")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [] })
      EXPECTS_CALLED -> parsing
        (set @entity.sub "expects")
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }] })
      TEXTS_CALLED -> parsing
        (set @entity.sub "texts")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "kind" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "catalog") (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "usage: orb behaviors catalog <scope…> [--exposure <e>]… [--json] [--no-vectors]" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "describe") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "usage: orb behaviors describe <behavior>.traits.<Trait>" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "source") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "usage: orb behaviors source <behavior>" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "which") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "usage: orb behaviors which <spec>" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "texts") (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "usage: orb behaviors texts <scope…> [--kind organism|capability|knob] [--json]" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "expects") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "usage: orb behaviors expects <spec>" })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "expects") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.spec (array/nth @payload.positionals 0))
        (emit BEHAVIORS_EXPECTS { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "which") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.spec (array/nth @payload.positionals 0))
        (emit BEHAVIORS_WHICH { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "texts") (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0))
        (set @entity.paths @payload.positionals)
        (set @entity.kind (or (array/first (or (object/get @payload.flags "kind") [])) ""))
        (emit BEHAVIORS_TEXTS { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "catalog") (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0))
        (set @entity.json (!= (object/get @payload.flags "json") null))
        (set @entity.noVectors (!= (object/get @payload.flags "no-vectors") null))
        (set @entity.exposure (or (object/get @payload.flags "exposure") []))
        (set @entity.paths @payload.positionals)
        (emit BEHAVIORS_CATALOG { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "describe") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1) (!= (array/nth @payload.positionals 0) "-"))
        (set @entity.knobVectors (!= (object/get @payload.flags "knob-vectors") null))
        (set @entity.spec (array/nth @payload.positionals 0))
        (emit BEHAVIORS_DESCRIBE { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "describe") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1) (= (array/nth @payload.positionals 0) "-"))
        (set @entity.knobVectors (!= (object/get @payload.flags "knob-vectors") null))
        (emit BEHAVIORS_STDIN { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "source") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.spec (array/nth @payload.positionals 0))
        (emit BEHAVIORS_SOURCE { })
    }

    state working {
      INIT -> working
      BEHAVIORS_CATALOG -> working
        (behavior/catalog { paths: @entity.paths, exposure: @entity.exposure } {
          vectors: (not @entity.noVectors)
          emit: { success: CATALOG_LISTED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_DESCRIBE -> working when (str/includes @entity.spec ".traits.")
        (behavior/describe { behavior: (array/first (str/split @entity.spec ".traits.")), trait: (array/nth (str/split @entity.spec ".traits.") 1) } {
          knobVectors: @entity.knobVectors
          emit: { success: TRAIT_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_DESCRIBE -> working when (not (str/includes @entity.spec ".traits."))
        (behavior/describe { behavior: @entity.spec } {
          knobVectors: @entity.knobVectors
          emit: { success: BEHAVIOR_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_STDIN -> working
        (os/read-file "/dev/fd/0" { emit: { success: STDIN_READ, failure: STDIN_FAILED } })
      STDIN_READ -> working
        (behavior/describe (json/parse (bytes/to-string @payload.data) DescribeValue) {
          knobVectors: @entity.knobVectors
          emit: { success: TRAIT_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_SOURCE -> working
        (behavior/source { behavior: (array/first (str/split @entity.spec ".traits.")) } {
          emit: { success: SOURCED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_WHICH -> working
        (behavior/resolve { behavior: @entity.spec } { path: true } {
          emit: { success: WHICH_RESOLVED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_TEXTS -> working when (= @entity.kind "")
        (behavior/texts { paths: @entity.paths } {
          emit: { success: TEXTS_LISTED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_TEXTS -> working when (!= @entity.kind "")
        (behavior/texts { paths: @entity.paths, kind: @entity.kind } {
          emit: { success: TEXTS_LISTED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_EXPECTS -> working when (str/startsWith @entity.spec "/")
        (behavior/resolve { behavior: @entity.spec } { expects: true } {
          emit: { success: EXPECTS_DERIVED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_EXPECTS -> working when (not (str/startsWith @entity.spec "/"))
        (os/exists { anchor: "cwd" path: @entity.spec } { key: "expects" emit: { success: EXPECTS_EXISTS, failure: EXPECTS_EXISTS_FAILED } })
      EXPECTS_EXISTS -> working when @payload.ok
        (behavior/resolve { behavior: (str/concat @entity.cwd "/" @entity.spec) } { expects: true } {
          emit: { success: EXPECTS_DERIVED, failure: BEHAVIORS_FAILED }
        })
      EXPECTS_EXISTS -> working when (not @payload.ok)
        (behavior/resolve { behavior: @entity.spec } { expects: true } {
          emit: { success: EXPECTS_DERIVED, failure: BEHAVIORS_FAILED }
        })
      EXPECTS_DERIVED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result) })
      WHICH_RESOLVED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (str/concat @payload.result.path " (" @payload.result.owner ")") })
      TEXTS_LISTED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result) })
      CATALOG_LISTED -> ready when @entity.json
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      CATALOG_LISTED -> ready when (not @entity.json)
        (emit BEHAVIORS_ANSWERED { status: 200, body: (str/join (array/map @payload.result (fn e (str/concat (str/padEnd (object/get @e behavior "") 48 " ") " " (str/padEnd (object/get @e level "") 9 " ") " " (str/padEnd (object/get @e exposure "-") 10 " ") " " (object/get @e description "")))) "\n") })
      TRAIT_DESCRIBED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      BEHAVIOR_DESCRIBED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      SOURCED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      BEHAVIORS_FAILED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: @payload.error })
      EXPECTS_EXISTS_FAILED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: @payload.error })
      STDIN_FAILED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: (str/concat "stdin is not readable: " @payload.error) })
    }

    emits {
      BEHAVIORS_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      BEHAVIORS_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the subcommand's flags."
        @tier "internal"
      BEHAVIORS_CATALOG { }
        @description "Internal: list the behaviors under the scopes."
        @tier "internal"
      BEHAVIORS_DESCRIBE { }
        @description "Internal: describe the named trait or behavior."
        @tier "internal"
      BEHAVIORS_EXPECTS { }
        @description "Internal: derive the expectations of the named behavior or file."
        @tier "internal"
      EXPECTS_EXISTS {
        ok : boolean!
      }
        @description "Internal: os/exists's success, whether the operand is a file under the working directory."
        @tier "internal"
      EXPECTS_EXISTS_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/exists's failure."
        @tier "internal"
      BEHAVIORS_WHICH { }
        @description "Internal: resolve the specifier to its file and owner."
        @tier "internal"
      BEHAVIORS_TEXTS { }
        @description "Internal: list the embedding texts under the scopes."
        @tier "internal"
      STDIN_READ {
        data : bytes!
      }
        @description "Internal: os/read's success, the bytes read from stdin."
        @tier "internal"
      STDIN_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/read's failure."
        @tier "internal"
      BEHAVIORS_STDIN { }
        @description "Internal: read a trait or orbital value from stdin and describe it."
        @tier "internal"
      BEHAVIORS_SOURCE { }
        @description "Internal: read the named behavior's program."
        @tier "internal"
    }

    listens {
      CATALOG_CALLED -> inbound "cli-behaviors-catalog" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors catalog` with its arguments."
        @synonyms "orb behaviors catalog, list behaviors"
      DESCRIBE_CALLED -> inbound "cli-behaviors-describe" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors describe` with its operand."
        @synonyms "orb behaviors describe, describe behavior"
      SOURCE_CALLED -> inbound "cli-behaviors-source" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors source` with its operand."
        @synonyms "orb behaviors source, behavior source"
      WHICH_CALLED -> inbound "cli-behaviors-which" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors which` with its specifier."
        @synonyms "orb behaviors which, where a behavior resolves"
      EXPECTS_CALLED -> inbound "cli-behaviors-expects" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors expects` with its specifier or file."
        @synonyms "orb behaviors expects, derive a behavior's expectations"
      TEXTS_CALLED -> inbound "cli-behaviors-texts" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb behaviors texts` with its scopes."
        @synonyms "orb behaviors texts, behavior embedding texts"
      BEHAVIORS_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> BEHAVIORS_ARGS_DONE
      BEHAVIORS_CATALOG { }
        @description "Self: list the behaviors."
      BEHAVIORS_DESCRIBE { }
        @description "Self: describe the behavior."
      BEHAVIORS_STDIN { }
        @description "Self: describe the value on stdin."
      STDIN_READ {
        data : bytes!
      }
        @description "os/read's success: the bytes read from stdin."
      STDIN_FAILED {
        error : string!
        kind : string
      }
        @description "os/read's failure."
      BEHAVIORS_SOURCE { }
        @description "Self: read the program."
      BEHAVIORS_WHICH { }
        @description "Self: resolve the specifier."
      BEHAVIORS_EXPECTS { }
        @description "Self: derive the expectations."
      EXPECTS_EXISTS {
        ok : boolean!
      }
        @description "os/exists's success: whether the operand is a file."
      EXPECTS_EXISTS_FAILED {
        error : string!
        kind : string
      }
        @description "os/exists's failure."
      EXPECTS_DERIVED {
        result : Map string ExpectValue!
      }
        @description "behavior/resolve's success with expects: true."
      BEHAVIORS_TEXTS { }
        @description "Self: list the embedding texts."
      WHICH_RESOLVED {
        result : OrbBehaviorsWhich!
      }
        @description "behavior/resolve's success with path: true."
      TEXTS_LISTED {
        result : [OrbBehaviorsText]!
      }
        @description "behavior/texts's success."
      CATALOG_LISTED {
        result : [OrbBehaviorsCatalogHit]!
      }
        @description "behavior/catalog's success."
      TRAIT_DESCRIBED {
        result : TraitDescription!
      }
        @description "behavior/describe's success for a trait."
      BEHAVIOR_DESCRIBED {
        result : OrbBehaviorsDescription!
      }
        @description "behavior/describe's success for a whole behavior."
      SOURCED {
        result : SExpr!
      }
        @description "behavior/source's success."
      BEHAVIORS_FAILED {
        error : string!
      }
        @description "A reflection operator's failure."
    }
  }

  page boot as OrbBehaviorsOrbitalStart -> OrbBehaviors, ArgsCli
}
