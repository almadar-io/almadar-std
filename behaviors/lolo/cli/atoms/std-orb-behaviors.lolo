app std-orb-behaviors [
  version: "1.0.0",
  inbound: ["cli-behaviors-catalog", "cli-behaviors-describe", "cli-behaviors-source", "cli-behaviors-which", "cli-behaviors-texts", "cli-behaviors-expects"],
  fs: { "/dev/fd/0": [read], cwd: "**": [read], "~/.almadar/vectors/**": [read, write, remove, create], "~/.almadar/sidecars/**": [read], "/**": [read], "~/.orb/node_modules/**": [read], env ALMADAR_VECTORS_DIR: "**": [read, write, remove, create] },
  env: ["PATH", "ALMADAR_VECTORS_DIR", "HOME", "EMBEDDING_PROVIDER", "EMBEDDING_API_KEY", "OPENAI_API_KEY", "OPEN_ROUTER_API_KEY", "EMBEDDING_MODEL", "LMSTUDIO_EMBEDDING_MODEL"],
  exec: ["kill", "orb"],
  net: { "127.0.0.1:1234": [tcp], "openrouter.ai:443": [tcp], "api.openai.com:443": [tcp] },
  description: "std-orb-behaviors — the `orb behaviors catalog|describe|source|which|texts|expects` commands over the behavior reflection operators. `catalog <scope…> [--exposure <e>]… [--json] [--no-vectors] [--no-traits] [--topics]` (`--topics` lists each package and topic once with its count, counted here over the rows) lists the installed behaviors under the scopes (`behavior/catalog`, which lists no vectors; `--no-vectors` reads no vector store) as one table row each, or as JSON with --json; `describe <behavior>.traits.<Trait>|<behavior>|<behavior>.orbitals.<Orbital>|- [--json] [--knob-vectors]` prints the description as JSON (`behavior/describe`; `-` reads a trait or orbital value as JSON from stdin; `--knob-vectors` attaches each knob's embedding vector; a whole-behavior description carries each orbital's `forwards`, the unhandled controls its `emitsScope external` traits leave for the embedder, from the control-unhandled analysis over std-orb-fired-events); `source <behavior> [--json]` prints the behavior's program as JSON (`behavior/source`); `which <spec>` prints `<path> (<owner>)`, the file the specifier resolves to and the package that owns it (`behavior/resolve` with `path: true`); `texts <scope…> [--kind organism|capability|knob] [--json]` prints the embedding texts under the scopes as one compact JSON array of { key, text, hash } (built by std-behavior-texts; `--json` is accepted, the only format). `expects <file.orb|spec> [--json]` prints each orbital's derived expectations as one compact JSON line, `{ <orbital>: { expectations, diagnostics } }` (`behavior/resolve` with `expects: true`; a spec naming an existing file under the working directory is read as that file, an absolute path when relative to the hook's cwd, `--json` is accepted, the only format). Each answers status 200 (exit 0). With vectors, the catalog lists rows asked for with `texts: true`, builds the organism and capability texts (std-behavior-texts), reads the packages' snapshots and the environment (std-vector-sources) and resolves every text's vector (std-vector-resolve: snapshots, then the user store, then the configured provider); `describe --knob-vectors` does the same for the trait's knob texts, and `texts` builds every kind itself, package by package in first-mention order and path order. A missing operand answers the usage (status 400, exit 2); a failed reflection answers its error (status 500, exit 1)."
]
uses Spec from "almadar-std/orb-behaviors"
uses Texts from "std/behaviors/std-behavior-texts"
uses ControlUnhandled from "std/behaviors/std-orb-lint-control-unhandled"
uses Borrows from "std/behaviors/std-behavior-borrows"
uses Fired from "std/behaviors/std-orb-fired-events"
uses Chain from "std/behaviors/std-orb-embed-chain"
uses LintInput from "std/behaviors/std-orb-lint-input"
uses Sources from "std/behaviors/std-vector-sources"
uses Cv from "std/behaviors/std-catalog-vectors"
uses Resolve from "std/behaviors/std-vector-resolve"
uses Store from "std/behaviors/std-vector-store"
uses Llm from "std/behaviors/std-llm"
uses Write from "std/behaviors/std-vector-write"
uses Quantize from "std/behaviors/std-vector-quantize"
uses F32 from "std/behaviors/std-f32"
uses Delay from "std/behaviors/std-delay"
uses Req from "std/behaviors/std-http-request"
uses Http from "std/behaviors/std-http-client"
uses Sig6 from "std/behaviors/std-sig6"
uses BigCmp from "std/behaviors/std-bigcmp"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type OrbBehaviorsCatalogHit = {
  behavior : string!
  package : string!
  topic : string!
  level : string!
  exposure : string
  description : string!
  capabilities : [string]
  traits : [trait]
  value : behavior!
  vectors : Map string [number]
  model : string
  name : string
  rank : number
  textOrder : number
  defaultEntityName : string
  connectableEvents : [string]
  capabilitiesText : string
  pattern : string
}
type StoreEntry = { found : boolean!, dims : number!, scale : number!, record : bytes!, vector : [number]! }
type OrbBehaviorsPackage = { root : string!, prefix : string!, vectors : string, vectorsRel : string, vectorsIn : string }
type WantedText = { key : string!, text : string! }
type TextRow = { key : string!, text : string!, hash : string! }
type KeyedVector = { key : string!, vector : [number]! }
type DescribedValue = { behavior : string!, orbital : string! }
type DescribedKnob = { name : string!, label : string, description : string, synonyms : string, values : [string] }
type DescribedTrait = { trait : string!, ref : string, knobs : [DescribedKnob] }
type DescribedField = { name : string }
type DescribedEntity = { name : string!, fields : [DescribedField] }
type DescribedOrbital = { value : DescribedValue!, entity : DescribedEntity, traits : [DescribedTrait], knobs : [DescribedKnob] }
type DescribedBehavior = { behavior : string!, orbitals : [DescribedOrbital]! }
type WrittenKnob = { type : string! }
type WrittenRef = { ref : string! }
type WrittenOrbital = { name : string!, reference : WrittenRef, config : Map string WrittenKnob }
type WrittenProgram = { orbitals : [WrittenOrbital] }
type OrbBehaviorsCatalogTopic = { package : string!, prefix : string!, topic : string!, count : number! }
type OrbBehaviorsWhich = { path : string!, owner : string! }
type OrbBehaviorsSourceFile = { path : string!, source : string! }
type ExpectValue = string | number | boolean | [ExpectValue?] | Map string ExpectValue?
type DescribeValue = { behavior : string!, trait : string, orbital : string }
type OrbBehaviorsKnobField = {
  key : string!
  type : string!
  label : string
  description : string
  tier : string
  vector : [number]
}
type TraitEvents = {
  emits : [string]!
  listens : [string]!
  transitions : [string]!
}
type TraitDescription = {
  value : trait
  knobs : [OrbBehaviorsKnobField]!
  events : TraitEvents!
  model : string
}
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type CuForward = { orbital : string!, trait : string!, event : string!, via : [string]! }
type OrbBehaviorsDescription = {
  behavior : string!
  knobs : [DescribedKnob]!
  orbitals : [DescribedOrbital]
}

type WalkSlot = { kind : string!, args : [number] }
orbital OrbBehaviorsOrbital {
  uses Args from "std/behaviors/std-args"

  entity OrbBehaviorsRun [runtime] {
    id : string!
    sub : string = ""
    json : boolean = false
    exposure : [string] = []
    paths : [string] = []
    spec : string = ""
    noVectors : boolean = false
    noTraits : boolean = false
    topics : boolean = false
    knobVectors : boolean = false
    kind : string = ""
    cwd : string = ""
    rows : [OrbBehaviorsCatalogHit] = []
    wanted : [WantedText] = []
    vpaths : [{ path : string!, in : string!, rel : string! }] = []
    vpath : string = ""
    stem : string = ""
    base : TraitDescription
    trait : string = ""
    cur : OrbBehaviorsCatalogHit?
    whole : DescribedBehavior
    ranks : [number] = []
    gi : number = 0
    ri : number = 0
    grp : [OrbBehaviorsCatalogHit] = []
    gOrg : [TextRow] = []
    gCap : [TextRow] = []
    gKnobs : [TextRow] = []
    acc : [TextRow] = []
    raw : OrbBehaviorsDescription = { behavior: "", knobs: [], orbitals: [] }
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbBehaviors.BEHAVIORS_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait BvStore = Store.traits.VectorLookup {
    listens {
      BvResolve.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      BvSnapshot.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      BvWrite.VECTOR_LOOKUP_MANY -> VECTOR_LOOKUP_MANY
      BvSig6.SIG6_DONE -> SIG6_DONE
      BvSig6.SIG6_REFUSED -> SIG6_REFUSED
    }
  }

  trait BvWrite = Write.traits.VectorWrite {
    listens {
      BvResolve.VECTOR_WRITE -> VECTOR_WRITE
      BvQuantize.QUANTIZED -> QUANTIZED
      BvQuantize.QUANTIZE_REFUSED -> QUANTIZE_REFUSED
      BvStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      BvStore.VECTOR_REFUSED -> VECTOR_REFUSED
      BvDelay.ELAPSED -> ELAPSED
    }
  }

  trait BvQuantize = Quantize.traits.VectorQuantize {
    listens {
      BvWrite.QUANTIZE -> QUANTIZE
      BvF32.F32_ENCODED -> F32_ENCODED
      BvF32.F32_REFUSED -> F32_REFUSED
      BvSig6.SIG6_DONE -> SIG6_DONE
      BvSig6.SIG6_REFUSED -> SIG6_REFUSED
    }
  }

  trait BvF32 = F32.traits.F32Encode {
    listens {
      BvQuantize.F32_ENCODE -> F32_ENCODE
      BvSig6.F32_ENCODE -> F32_ENCODE
    }
  }

  trait BvSig6 = Sig6.traits.Sig6 {
    listens {
      BvQuantize.SIG6 -> SIG6
      BvStore.SIG6 -> SIG6
      BvBigCmp.BIGCMP_ANSWERED -> BIGCMP_ANSWERED
      BvF32.F32_ENCODED -> F32_ENCODED
      BvF32.F32_REFUSED -> F32_REFUSED
    }
  }

  trait BvBigCmp = BigCmp.traits.BigCmp {
    listens {
      BvSig6.BIGCMP_BATCH -> BIGCMP_BATCH
    }
  }

  trait BvDelay = Delay.traits.Delay {
    listens {
      BvWrite.LOCK_WAIT -> START
    }
  }

  trait ResolveLlmOrShared = Resolve.traits.ResolveLlmOrShared {
    listens {
      BvResolve.LLM_EMBED_ORS -> LLM_EMBED_ORS
      ResolveOrSharedWait.WAITED_ORS -> LLM_EMBED_WAITED
      ResolveOrSharedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOrSharedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOrSharedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmOrOwn = Resolve.traits.ResolveLlmOrOwn {
    listens {
      BvResolve.LLM_EMBED_ORO -> LLM_EMBED_ORO
      ResolveOrOwnWait.WAITED_ORO -> LLM_EMBED_WAITED
      ResolveOrOwnRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOrOwnRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOrOwnRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmOaShared = Resolve.traits.ResolveLlmOaShared {
    listens {
      BvResolve.LLM_EMBED_OAS -> LLM_EMBED_OAS
      ResolveOaSharedWait.WAITED_OAS -> LLM_EMBED_WAITED
      ResolveOaSharedRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOaSharedRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOaSharedRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmOaOwn = Resolve.traits.ResolveLlmOaOwn {
    listens {
      BvResolve.LLM_EMBED_OAO -> LLM_EMBED_OAO
      ResolveOaOwnWait.WAITED_OAO -> LLM_EMBED_WAITED
      ResolveOaOwnRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveOaOwnRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveOaOwnRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveLlmLm = Resolve.traits.ResolveLlmLm {
    listens {
      BvResolve.LLM_EMBED_LM -> LLM_EMBED_LM
      ResolveLmWait.WAITED_LM -> LLM_EMBED_WAITED
      ResolveLmRequest.HTTP_RESULT -> LLM_EMBED_WIRE_RESULT
      ResolveLmRequest.HTTP_REQUEST_FAILED -> LLM_EMBED_WIRE_FAILED
      ResolveLmRequest.HTTP_REQUEST_REFUSED -> LLM_EMBED_WIRE_REFUSED
    }
  }
  trait ResolveOrSharedWait = Resolve.traits.ResolveOrSharedWait {}
  trait ResolveOrSharedRequest = Resolve.traits.ResolveOrSharedRequest {}
  trait ResolveOrSharedHttp = Resolve.traits.ResolveOrSharedHttp {}
  trait ResolveOrOwnWait = Resolve.traits.ResolveOrOwnWait {}
  trait ResolveOrOwnRequest = Resolve.traits.ResolveOrOwnRequest {}
  trait ResolveOrOwnHttp = Resolve.traits.ResolveOrOwnHttp {}
  trait ResolveOaSharedWait = Resolve.traits.ResolveOaSharedWait {}
  trait ResolveOaSharedRequest = Resolve.traits.ResolveOaSharedRequest {}
  trait ResolveOaSharedHttp = Resolve.traits.ResolveOaSharedHttp {}
  trait ResolveOaOwnWait = Resolve.traits.ResolveOaOwnWait {}
  trait ResolveOaOwnRequest = Resolve.traits.ResolveOaOwnRequest {}
  trait ResolveOaOwnHttp = Resolve.traits.ResolveOaOwnHttp {}
  trait ResolveLmWait = Resolve.traits.ResolveLmWait {}
  trait ResolveLmRequest = Resolve.traits.ResolveLmRequest {}
  trait ResolveLmHttp = Resolve.traits.ResolveLmHttp {}

  trait BvResolve = Resolve.traits.VectorResolve {
    listens {
      OrbBehaviors.BV_RESOLVE -> RESOLVE
      CatalogVectors.CV_RESOLVE -> RESOLVE
      BvSources.USER_STORE_READ -> USER_STORE_READ
      BvStore.VECTOR_RESOLVED -> VECTOR_RESOLVED
      BvStore.VECTOR_REFUSED -> VECTOR_REFUSED
      ResolveLlmOrShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrShared.LLM_FAILED -> LLM_FAILED
      ResolveLlmOrOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOrOwn.LLM_FAILED -> LLM_FAILED
      ResolveLlmOaShared.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOaShared.LLM_FAILED -> LLM_FAILED
      ResolveLlmOaOwn.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmOaOwn.LLM_FAILED -> LLM_FAILED
      ResolveLlmLm.LLM_EMBED_RESULT -> LLM_EMBED_RESULT
      ResolveLlmLm.LLM_FAILED -> LLM_FAILED
      BvWrite.VECTOR_WRITTEN -> VECTOR_WRITTEN
      BvWrite.VECTOR_WRITE_REFUSED -> VECTOR_WRITE_REFUSED
      RESOLVE {
        wanted : [WantedText]!
        snapshots : [bytes]!
        snapshotPaths : [string]
        userDir : string!
        userAnchor : string!
        providerModel : string!
        providerKind : string
        embedModel : string
      }
      USER_STORE_READ {
        data : bytes!
      }
      VECTOR_RESOLVED {
        model : string!
        entries : [StoreEntry]!
      }
      VECTOR_REFUSED {
        code : string!
        detail : string!
      }
      LLM_EMBED_RESULT {
        embeddings : [[number]]!
      }
      LLM_FAILED {
        code : string
        message : string!
      }
      VECTOR_WRITTEN {
        path : string!
        count : number!
      }
      VECTOR_WRITE_REFUSED {
        code : string!
        detail : string!
      }
    }
  }


  trait BvTexts = Texts.traits.BehaviorTexts {
    listens {
      OrbBehaviors.BV_ENTRY_TEXTS -> BUILD_ENTRY_TEXTS
      CatalogVectors.CV_ENTRY_TEXTS -> BUILD_ENTRY_TEXTS
      OrbBehaviors.BV_KNOB_TEXTS -> BUILD_KNOB_TEXTS
    }
  }

  trait BvSources = Sources.traits.VectorSources {
    listens {
      OrbBehaviors.BV_SOURCES -> SOURCES
      CatalogVectors.CV_SOURCES -> SOURCES
      BvResolve.USER_STORE_NEEDED -> USER_STORE_NEEDED
    }
  }

  trait CatalogVectors = Cv.traits.CatalogVectors {
    listens {
      OrbBehaviors.BV_CATALOG_VECTORS -> CATALOG_VECTORS_ASK
      BvTexts.ENTRY_TEXTS_BUILT -> ENTRY_TEXTS_BUILT
      BvSources.SOURCES_READY -> SOURCES_READY
      BvSources.SOURCES_REFUSED -> SOURCES_REFUSED
      BvResolve.VECTORS_ANSWERED -> VECTORS_ANSWERED
      BvResolve.VECTORS_REFUSED -> VECTORS_REFUSED
    }
  }

  trait OrbLintControlUnhandled = ControlUnhandled.traits.OrbLintControlUnhandled {
  }
  trait Versions = LintInput.traits.Versions {
  }
  trait Packs = LintInput.traits.Packs {
  }
  trait BehaviorBorrows = Borrows.traits.BehaviorBorrows {
    listens {
      OrbBehaviors.BV_BORROWS_DESCRIBE -> BORROWS_DESCRIBE
      OrbLintOrbitalRefClosure.LINT_FOUND -> BORROWS_FOUND
    }
  }
  trait OrbLintOrbitalRefClosure = Borrows.traits.OrbLintOrbitalRefClosure {
  }
  trait OrbLintInput = LintInput.traits.OrbLintInput {
    listens {
      OrbBehaviors.BV_LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }
  trait OrbFiredEvents = Fired.traits.OrbFiredEvents {
    listens {
      FIRED_PROPS_HEARD { names : [string]!  maps : [string]!  listens : Map string [string]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: the event-bearing prop names of the installed pattern registry."
      FIRED_SEMANTICS_HEARD { functions : [string]!  busExcluded : [string]!  targetOptions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators."
      FIRED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      FIRED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
      OrbLintInput.LINT_EVENT_PROPS -> FIRED_PROPS_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> FIRED_SEMANTICS_HEARD
      OrbLintInput.LINT_OPERATOR_WALK -> FIRED_WALK_HEARD
      OrbLintInput.LINT_INPUT -> FIRED_INPUT_HEARD
    }
  }
  trait OrbEmbedChain = Chain.traits.OrbEmbedChain {
    listens {
      EMBED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
      OrbLintInput.LINT_INPUT -> EMBED_INPUT_HEARD
      EMBED_INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads and binding roots each inline trait uses."
      OrbLintInput.LINT_INDEX -> EMBED_INDEX_HEARD
    }
  }

  trait OrbBehaviors -> OrbBehaviorsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      CATALOG_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors catalog <scope…> [--exposure <e>]… [--json] [--no-vectors] [--no-traits] [--topics]" })
      CATALOG_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.sub "catalog")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "no-vectors" aliases: [] takesValue: false repeatable: false }, { name: "no-traits" aliases: [] takesValue: false repeatable: false }, { name: "topics" aliases: [] takesValue: false repeatable: false }, { name: "exposure" aliases: [] takesValue: true repeatable: true }] })
      DESCRIBE_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors describe <behavior>.traits.<Trait>" })
      DESCRIBE_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.sub "describe")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "knob-vectors" aliases: [] takesValue: false repeatable: false }] })
      SOURCE_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors source <behavior>" })
      SOURCE_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.sub "source")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }] })
      WHICH_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors which <spec>" })
      WHICH_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.sub "which")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [] })
      EXPECTS_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors expects <spec>" })
      EXPECTS_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.sub "expects")
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }] })
      TEXTS_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors texts <scope…> [--kind organism|capability|knob] [--json]" })
      TEXTS_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.sub "texts")
        (emit BEHAVIORS_ARGS_PARSE { stage: "behaviors" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "kind" aliases: [] takesValue: true repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "catalog") (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors catalog <scope…> [--exposure <e>]… [--json] [--no-vectors] [--no-traits] [--topics]" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "describe") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors describe <behavior>.traits.<Trait>" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "source") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors source <behavior>" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "which") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors which <spec>" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "texts") (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors texts <scope…> [--kind organism|capability|knob] [--json]" })
      BEHAVIORS_ARGS_DONE -> ready when (and (= @entity.sub "expects") (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1)))
        (emit BEHAVIORS_ANSWERED { status: 400, body: "", stderr: "usage: orb behaviors expects <spec>" })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "expects") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.spec (default (array/nth @payload.positionals 0) ""))
        (emit BEHAVIORS_EXPECTS { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "which") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.spec (default (array/nth @payload.positionals 0) ""))
        (emit BEHAVIORS_WHICH { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "texts") (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0))
        (set @entity.paths @payload.positionals)
        (set @entity.kind (default (array/first (default (object/get @payload.flags "kind") [])) ""))
        (emit BEHAVIORS_TEXTS { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "catalog") (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0))
        (set @entity.json (object/has @payload.flags "json"))
        (set @entity.noVectors (object/has @payload.flags "no-vectors"))
        (set @entity.noTraits (object/has @payload.flags "no-traits"))
        (set @entity.topics (object/has @payload.flags "topics"))
        (set @entity.exposure (default (object/get @payload.flags "exposure") []))
        (set @entity.paths @payload.positionals)
        (emit BEHAVIORS_CATALOG { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "describe") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1) (!= (array/nth @payload.positionals 0) "-"))
        (set @entity.knobVectors (object/has @payload.flags "knob-vectors"))
        (set @entity.spec (default (array/nth @payload.positionals 0) ""))
        (emit BEHAVIORS_DESCRIBE { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "describe") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1) (= (array/nth @payload.positionals 0) "-"))
        (set @entity.knobVectors (object/has @payload.flags "knob-vectors"))
        (emit BEHAVIORS_STDIN { })
      BEHAVIORS_ARGS_DONE -> working when (and (= @entity.sub "source") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1))
        (set @entity.spec (default (array/nth @payload.positionals 0) ""))
        (emit BEHAVIORS_SOURCE { })
    }

    state working {
      INIT -> working
      BEHAVIORS_CATALOG -> working when (and (not @entity.topics) @entity.noVectors)
        (behavior/catalog { paths: @entity.paths, exposure: @entity.exposure } {
          traits: (not @entity.noTraits)
          emit: { success: CATALOG_LISTED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_CATALOG -> working when (and (not @entity.topics) (not @entity.noVectors))
        (emit BV_CATALOG_VECTORS { paths: @entity.paths, exposure: @entity.exposure, traits: (not @entity.noTraits) })
      BEHAVIORS_CATALOG -> working when @entity.topics
        (behavior/catalog { paths: @entity.paths, exposure: @entity.exposure } {
          traits: false
          emit: { success: CATALOG_TOPIC_ROWS, failure: BEHAVIORS_FAILED }
        })
      CATALOG_TOPIC_ROWS -> working
        (emit CATALOG_TOPICS_LISTED { result: (let ((rows @payload.result)) (array/map (array/filter (array/range 0 (array/len @rows)) (fn i (let ((r (default (array/nth @rows @i) {}))) (= @i (array/findIndex @rows (fn x (and (= (object/get @x "package" "") (object/get @r "package" "")) (= (object/get @x "topic" "") (object/get @r "topic" ""))))))))) (fn i (let ((r (default (array/nth @rows @i) {}))) { package: (object/get @r "package" ""), prefix: (default (array/first (str/split (object/get @r "behavior" "") "/")) ""), topic: (object/get @r "topic" ""), count: (array/len (array/filter @rows (fn x (and (= (object/get @x "package" "") (object/get @r "package" "")) (= (object/get @x "topic" "") (object/get @r "topic" "")))))) }))) ) })
      BEHAVIORS_DESCRIBE -> working when (and (str/includes @entity.spec ".traits.") (not @entity.knobVectors))
        (behavior/describe { behavior: (array/first (str/split @entity.spec ".traits.")), trait: (array/nth (str/split @entity.spec ".traits.") 1) } {
          emit: { success: TRAIT_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_DESCRIBE -> working when (and (str/includes @entity.spec ".traits.") @entity.knobVectors)
        (behavior/describe { behavior: (array/first (str/split @entity.spec ".traits.")), trait: (array/nth (str/split @entity.spec ".traits.") 1) } {
          emit: { success: KNOB_BASE_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_DESCRIBE -> working when (not (str/includes @entity.spec ".traits."))
        (emit BV_BORROWS_DESCRIBE { behavior: @entity.spec })
      BEHAVIOR_DESCRIBED -> working
        (set @entity.raw @payload.result)
        (behavior/source { behavior: (array/first (str/split @entity.spec ".orbitals.")) } {
          file: true
          emit: { success: FORWARDS_PATH_RESOLVED, failure: BEHAVIORS_FAILED }
        })
      FORWARDS_PATH_RESOLVED -> working
        (emit BV_LINT_REQUEST { file: @payload.result.path })
      FORWARDS_HEARD -> ready when (= @payload.scope "")
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify (object/merge @entity.raw { orbitals: (array/map (default @entity.raw.orbitals []) (fn o (object/merge @o { forwards: (array/map (array/filter @payload.forwards (fn f (= @f.orbital @o.value.orbital))) (fn f (object/pick @f ["trait", "event", "via"]))) }))) }) { pretty: true }) })
      FORWARDS_UNREAD -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: (str/concat "behavior/describe: the forwarded controls of " @payload.file " cannot be read: " @payload.error) })
      CATALOG_ATTACHED -> ready when @entity.json
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      CATALOG_ATTACHED -> ready when (not @entity.json)
        (emit BEHAVIORS_ANSWERED { status: 200, body: (str/join (array/map @payload.result (fn e (str/concat (str/padEnd (object/get @e behavior "") 48 " ") " " (str/padEnd (object/get @e level "") 9 " ") " " (str/padEnd (object/get @e exposure "-") 10 " ") " " (object/get @e description "")))) "
") })
      TRAIT_ATTACHED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      KNOB_BASE_DESCRIBED -> working
        (set @entity.base @payload.result)
        (set @entity.trait (default (array/nth (str/split @entity.spec ".traits.") 1) ""))
        (behavior/resolve { behavior: (array/first (str/split @entity.spec ".traits.")) } { path: true } {
          emit: { success: KNOB_PATH_RESOLVED, failure: BEHAVIORS_FAILED }
        })
      KNOB_PATH_RESOLVED -> working
        (set @entity.vpath @payload.result.path)
        (set @entity.stem (str/replace-pattern (os/path-base @payload.result.path) "\\.[^.]*$" ""))
        (behavior/packages { emit: { success: PACKAGES_LISTED, failure: BEHAVIORS_FAILED } })
      PACKAGES_LISTED -> working when (and (= @entity.sub "describe") (not (array/some @payload.result (fn p (str/startsWith @entity.vpath (str/concat @p.root "/"))))))
        (emit TRAIT_ATTACHED { result: @entity.base })
      PACKAGES_LISTED -> working when (and (= @entity.sub "describe") (array/some @payload.result (fn p (str/startsWith @entity.vpath (str/concat @p.root "/")))))
        (set @entity.vpaths (array/map (array/filter @payload.result (fn p (and (str/startsWith @entity.vpath (str/concat @p.root "/")) (!= (default @p.vectors "") "")))) (fn p { path: (default @p.vectors ""), in: (default @p.vectorsIn ""), rel: (default @p.vectorsRel "") })))
        (behavior/describe { behavior: (array/first (str/split @entity.spec ".traits.")) } {
          emit: { success: KNOB_WHOLE_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      KNOB_WHOLE_DESCRIBED -> working
        (set @entity.whole (as @payload.result DescribedBehavior))
        (behavior/source { behavior: (array/first (str/split @entity.spec ".traits.")) } {
          emit: { success: KNOB_SOURCED, failure: BEHAVIORS_FAILED }
        })
      KNOB_SOURCED -> working when (!= (as @payload.result WrittenProgram) null)
        (emit BV_KNOB_TEXTS { name: @entity.stem, described: @entity.whole, written: (default (as @payload.result WrittenProgram) { orbitals: [] }) })
      KNOB_SOURCED -> ready when (= (as @payload.result WrittenProgram) null)
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: "behavior/source: the program is not a program" })
      KNOB_TEXTS_BUILT -> working when (= @entity.sub "describe")
        (set @entity.wanted (array/filter (array/map (default @entity.base.knobs []) (fn k (let ((key (str/concat @entity.stem "/" (default (array/first (array/map (array/filter (default @entity.whole.orbitals []) (fn o (array/some (default @o.traits []) (fn t (= @t.trait @entity.trait))))) (fn o (default @o.value.orbital "")))) "") "/" @entity.trait "/" @k.key))) (let ((hit (array/find @payload.texts (fn t (= @t.key @key))))) (if (= @hit null) { key: "", text: "" } { key: @key, text: (default @hit.text "") }))))) (fn w (!= @w.key ""))))
        (emit BV_SOURCES { paths: @entity.vpaths })
      BEHAVIORS_STDIN -> working
        (os/read-file "/dev/fd/0" { emit: { success: STDIN_READ, failure: STDIN_FAILED } })
      STDIN_READ -> working when (not @entity.knobVectors)
        (behavior/describe (json/parse (default (bytes/to-string @payload.data) "") DescribeValue) {
          emit: { success: TRAIT_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      STDIN_READ -> ready when @entity.knobVectors
        (emit BEHAVIORS_ANSWERED { status: 501, body: "", stderr: "describe -: --knob-vectors is not carried for a value read from stdin" })
      BEHAVIORS_SOURCE -> working
        (behavior/source { behavior: (array/first (str/split @entity.spec ".traits.")) } {
          emit: { success: SOURCED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_WHICH -> working
        (behavior/resolve { behavior: @entity.spec } { path: true } {
          emit: { success: WHICH_RESOLVED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_TEXTS -> ready when (and (!= @entity.kind "") (!= @entity.kind "organism") (!= @entity.kind "capability") (!= @entity.kind "knob"))
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: (str/concat "unknown --kind `" @entity.kind "` (one of organism, capability, knob)") })
      BEHAVIORS_TEXTS -> working when (or (= @entity.kind "") (= @entity.kind "organism") (= @entity.kind "capability") (= @entity.kind "knob"))
        (behavior/catalog { paths: @entity.paths, exposure: [] } {
          traits: false
          texts: true
          emit: { success: TEXTS_ROWS, failure: BEHAVIORS_FAILED }
        })
      TEXTS_ROWS -> working
        (set @entity.rows (array/sort @payload.result "textOrder"))
        (set @entity.ranks (array/unique (array/map @payload.result (fn r (default @r.rank 0)))))
        (set @entity.gi 0)
        (set @entity.acc [])
        (emit TX_GROUP { at: @entity.gi })
      TX_GROUP -> ready when (>= @entity.gi (array/len @entity.ranks))
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @entity.acc) })
      TX_GROUP -> working when (< @entity.gi (array/len @entity.ranks))
        (set @entity.grp (array/filter @entity.rows (fn r (= (default @r.rank 0) (default (array/nth @entity.ranks @entity.gi) 0)))))
        (set @entity.ri 0)
        (set @entity.gKnobs [])
        (emit BV_ENTRY_TEXTS { rows: (array/filter @entity.rows (fn r (= (default @r.rank 0) (default (array/nth @entity.ranks @entity.gi) 0)))) })
      ENTRY_TEXTS_BUILT -> working when (= @entity.sub "texts")
        (set @entity.gOrg @payload.organism)
        (set @entity.gCap @payload.capability)
        (set @entity.cur (array/nth @entity.grp @entity.ri))
        (emit TX_KNOB { at: @entity.ri })
      TX_KNOB -> working when (and (or (= @entity.kind "") (= @entity.kind "knob")) (< @entity.ri (array/len @entity.grp)) (!= (default @entity.cur.exposure "") "internal"))
        (behavior/describe { behavior: (default @entity.cur.behavior "") } {
          emit: { success: TX_DESCRIBED, failure: BEHAVIORS_FAILED }
        })
      TX_KNOB -> working when (and (or (= @entity.kind "") (= @entity.kind "knob")) (< @entity.ri (array/len @entity.grp)) (= (default @entity.cur.exposure "") "internal"))
        (set @entity.ri (+ @entity.ri 1))
        (set @entity.cur (array/nth @entity.grp @entity.ri))
        (emit TX_KNOB { at: @entity.ri })
      TX_KNOB -> working when (or (and (!= @entity.kind "") (!= @entity.kind "knob")) (>= @entity.ri (array/len @entity.grp)))
        (set @entity.acc (array/concat @entity.acc (array/concat (if (or (= @entity.kind "") (= @entity.kind "organism")) @entity.gOrg []) (array/concat (if (or (= @entity.kind "") (= @entity.kind "capability")) @entity.gCap []) @entity.gKnobs))))
        (set @entity.gi (+ @entity.gi 1))
        (emit TX_GROUP { at: @entity.gi })
      TX_DESCRIBED -> working
        (set @entity.whole (as @payload.result DescribedBehavior))
        (behavior/source { behavior: (default @entity.cur.behavior "") } {
          emit: { success: TX_SOURCED, failure: BEHAVIORS_FAILED }
        })
      TX_SOURCED -> working when (!= (as @payload.result WrittenProgram) null)
        (emit BV_KNOB_TEXTS { name: (default @entity.cur.name ""), described: @entity.whole, written: (default (as @payload.result WrittenProgram) { orbitals: [] }) })
      TX_SOURCED -> ready when (= (as @payload.result WrittenProgram) null)
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: "behavior/source: the program is not a program" })
      KNOB_TEXTS_BUILT -> working when (= @entity.sub "texts")
        (set @entity.gKnobs (array/concat @entity.gKnobs @payload.texts))
        (set @entity.ri (+ @entity.ri 1))
        (set @entity.cur (array/nth @entity.grp @entity.ri))
        (emit TX_KNOB { at: @entity.ri })
      KNOB_TEXTS_REFUSED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: @payload.error })
      SOURCES_READY -> working when (!= @entity.sub "catalog")
        (emit BV_RESOLVE { wanted: @entity.wanted, snapshots: @payload.snapshots, snapshotPaths: @payload.snapshotPaths, userDir: @payload.userDir, userAnchor: @payload.userAnchor, providerModel: @payload.providerModel, providerKind: @payload.providerKind, embedModel: @payload.embedModel })
      SOURCES_REFUSED -> ready when (!= @entity.sub "catalog")
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: (str/concat @payload.code ": " @payload.detail) })
      VECTORS_REFUSED -> ready when (!= @entity.sub "catalog")
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: (str/concat @payload.code ": " @payload.detail) })
      CATALOG_VECTORS_ROWS -> working
        (emit CATALOG_ATTACHED { result: (array/map @payload.rows (fn r (object/merge @r { model: @payload.model }))) })
      CATALOG_VECTORS_REFUSED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: (str/concat @payload.code ": " @payload.detail) })
      VECTORS_ANSWERED -> working when (and (= @entity.sub "describe") (validate/required @entity.base))
        (emit TRAIT_ATTACHED { result: (object/merge @entity.base { model: @payload.model, knobs: (array/map (default @entity.base.knobs []) (fn k (let ((hit (array/find @payload.vectors (fn v (= @v.key (str/concat @entity.stem "/" (default (array/first (array/map (array/filter (default @entity.whole.orbitals []) (fn o (array/some (default @o.traits []) (fn t (= @t.trait @entity.trait))))) (fn o (default @o.value.orbital "")))) "") "/" @entity.trait "/" @k.key)))))) (if (= @hit null) @k (object/merge @k { vector: @hit.vector }))))) }) })
      BEHAVIORS_EXPECTS -> working when (str/startsWith @entity.spec "/")
        (behavior/resolve { behavior: @entity.spec } { expects: true } {
          emit: { success: EXPECTS_DERIVED, failure: BEHAVIORS_FAILED }
        })
      BEHAVIORS_EXPECTS -> working when (not (str/startsWith @entity.spec "/"))
        (os/exists { anchor: "cwd" path: @entity.spec } { key: "expects" emit: { success: EXPECTS_EXISTS, failure: EXPECTS_EXISTS_FAILED } })
      EXPECTS_EXISTS -> working when @payload.ok
        (behavior/resolve { behavior: (str/concat @entity.cwd "/" @entity.spec) } { expects: true } {
          emit: { success: EXPECTS_DERIVED, failure: BEHAVIORS_FAILED }
        })
      EXPECTS_EXISTS -> working when (not @payload.ok)
        (behavior/resolve { behavior: @entity.spec } { expects: true } {
          emit: { success: EXPECTS_DERIVED, failure: BEHAVIORS_FAILED }
        })
      EXPECTS_DERIVED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result) })
      WHICH_RESOLVED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (str/concat @payload.result.path " (" @payload.result.owner ")") })
      CATALOG_LISTED -> ready when @entity.json
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      CATALOG_TOPICS_LISTED -> ready when @entity.json
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      CATALOG_TOPICS_LISTED -> ready when (not @entity.json)
        (emit BEHAVIORS_ANSWERED { status: 200, body: (str/join (array/map @payload.result (fn t (str/concat (str/padEnd @t.package 24 " ") " " (str/padEnd @t.topic 24 " ") " " (json/stringify @t.count)))) "\n") })
      CATALOG_LISTED -> ready when (not @entity.json)
        (emit BEHAVIORS_ANSWERED { status: 200, body: (str/join (array/map @payload.result (fn e (str/concat (str/padEnd (object/get @e behavior "") 48 " ") " " (str/padEnd (object/get @e level "") 9 " ") " " (str/padEnd (object/get @e exposure "-") 10 " ") " " (object/get @e description "")))) "\n") })
      TRAIT_DESCRIBED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      SOURCED -> ready
        (emit BEHAVIORS_ANSWERED { status: 200, body: (json/stringify @payload.result { pretty: true }) })
      BEHAVIORS_FAILED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: @payload.error })
      EXPECTS_EXISTS_FAILED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: @payload.error })
      STDIN_FAILED -> ready
        (emit BEHAVIORS_ANSWERED { status: 500, body: "", stderr: (str/concat "stdin is not readable: " @payload.error) })
    }

    emits {
      BEHAVIORS_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      BEHAVIORS_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the subcommand's flags."
        @tier "internal"
      BEHAVIORS_CATALOG { }
        @description "Internal: list the behaviors under the scopes."
        @tier "internal"
      CATALOG_TOPICS_LISTED {
        result : [OrbBehaviorsCatalogTopic]!
      }
        @description "Internal: the listing's topics counted."
        @tier "internal"
      BV_LINT_REQUEST -> external {
        file : string!
      }
        @tier "secondary"
      BV_BORROWS_DESCRIBE -> external {
        behavior : string!
      }
        @tier "secondary"
      BV_CATALOG_VECTORS -> external {
        paths : [string]!
        exposure : [string]!
        traits : boolean!
      }
        @tier "secondary"
      BV_ENTRY_TEXTS -> external {
        rows : [OrbBehaviorsCatalogHit]!
      }
        @tier "secondary"
      BV_KNOB_TEXTS -> external {
        name : string!
        described : DescribedBehavior!
        written : WrittenProgram!
      }
        @tier "secondary"
      BV_SOURCES -> external {
        paths : [{ path : string!, in : string!, rel : string! }]!
      }
        @tier "secondary"
      BV_RESOLVE -> external {
        wanted : [WantedText]!
        snapshots : [bytes]!
        snapshotPaths : [string]
        userDir : string!
        userAnchor : string!
        providerModel : string!
        providerKind : string
        embedModel : string
      }
        @tier "secondary"
      TX_GROUP {
        at : number!
      }
        @tier "internal"
      TX_KNOB {
        at : number!
      }
        @tier "internal"
      CATALOG_ATTACHED {
        result : [OrbBehaviorsCatalogHit]!
      }
        @tier "internal"
      TRAIT_ATTACHED {
        result : TraitDescription!
      }
        @tier "internal"
      BEHAVIORS_DESCRIBE { }
        @description "Internal: describe the named trait or behavior."
        @tier "internal"
      BEHAVIORS_EXPECTS { }
        @description "Internal: derive the expectations of the named behavior or file."
        @tier "internal"
      EXPECTS_EXISTS {
        ok : boolean!
      }
        @description "Internal: os/exists's success, whether the operand is a file under the working directory."
        @tier "internal"
      EXPECTS_EXISTS_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/exists's failure."
        @tier "internal"
      BEHAVIORS_WHICH { }
        @description "Internal: resolve the specifier to its file and owner."
        @tier "internal"
      BEHAVIORS_TEXTS { }
        @description "Internal: list the embedding texts under the scopes."
        @tier "internal"
      STDIN_READ {
        data : bytes!
      }
        @description "Internal: os/read's success, the bytes read from stdin."
        @tier "internal"
      STDIN_FAILED {
        error : string!
        kind : string
      }
        @description "Internal: os/read's failure."
        @tier "internal"
      BEHAVIORS_STDIN { }
        @description "Internal: read a trait or orbital value from stdin and describe it."
        @tier "internal"
      BEHAVIORS_SOURCE { }
        @description "Internal: read the named behavior's program."
        @tier "internal"
    }

    listens {
      CATALOG_CALLED -> inbound "cli-behaviors-catalog" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb behaviors catalog` with its arguments."
        @synonyms "orb behaviors catalog, list behaviors"
      DESCRIBE_CALLED -> inbound "cli-behaviors-describe" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb behaviors describe` with its operand."
        @synonyms "orb behaviors describe, describe behavior"
      SOURCE_CALLED -> inbound "cli-behaviors-source" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb behaviors source` with its operand."
        @synonyms "orb behaviors source, behavior source"
      WHICH_CALLED -> inbound "cli-behaviors-which" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb behaviors which` with its specifier."
        @synonyms "orb behaviors which, where a behavior resolves"
      EXPECTS_CALLED -> inbound "cli-behaviors-expects" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb behaviors expects` with its specifier or file."
        @synonyms "orb behaviors expects, derive a behavior's expectations"
      TEXTS_CALLED -> inbound "cli-behaviors-texts" answers BEHAVIORS_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb behaviors texts` with its scopes."
        @synonyms "orb behaviors texts, behavior embedding texts"
      BEHAVIORS_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> BEHAVIORS_ARGS_DONE
      BEHAVIORS_CATALOG { }
        @description "Self: list the behaviors."
      BehaviorBorrows.BORROWS_DESCRIBED -> BEHAVIOR_DESCRIBED
      BehaviorBorrows.BORROWS_FAILED -> BEHAVIORS_FAILED
      FORWARDS_PATH_RESOLVED {
        result : OrbBehaviorsSourceFile!
      }
        @description "behavior/source's success with file: true, for the described behavior's forwarded controls: the file the lint input reads."
      OrbLintControlUnhandled.CONTROLS_FORWARDED -> FORWARDS_HEARD
      FORWARDS_HEARD {
        scope : string!
        forwards : [CuForward]!
      }
        @description "std-orb-lint-control-unhandled's CONTROLS_FORWARDED: the unhandled controls a trait leaves for its embedder."
      OrbLintInput.LINT_INPUT_UNREAD -> FORWARDS_UNREAD
      FORWARDS_UNREAD {
        file : string!
        error : string!
      }
        @description "std-orb-lint-input's LINT_INPUT_UNREAD: the described behavior's file could not be read or lowered."
      TX_GROUP {
        at : number!
      }
        @description "Self: texts of the next package."
      TX_KNOB {
        at : number!
      }
        @description "Self: knob texts of the next behavior."
      CatalogVectors.CATALOG_VECTORS_ROWS -> CATALOG_VECTORS_ROWS
      CATALOG_VECTORS_ROWS {
        rows : [OrbBehaviorsCatalogHit]!
        model : string!
      }
      CatalogVectors.CATALOG_VECTORS_REFUSED -> CATALOG_VECTORS_REFUSED
      CATALOG_VECTORS_REFUSED {
        code : string!
        detail : string!
      }
      CATALOG_TOPIC_ROWS {
        result : [OrbBehaviorsCatalogHit]!
      }
        @description "behavior/catalog's success for the topics listing: the rows std counts per package and topic."
      CATALOG_ATTACHED {
        result : [OrbBehaviorsCatalogHit]!
      }
        @description "Self: the catalog with its vectors attached."
      TRAIT_ATTACHED {
        result : TraitDescription!
      }
        @description "Self: the trait description with its knob vectors attached."
      TEXTS_ROWS {
        result : [OrbBehaviorsCatalogHit]!
      }
        @description "behavior/catalog's success for the texts command."
      PACKAGES_LISTED {
        result : [OrbBehaviorsPackage]!
      }
        @description "behavior/packages's success."
      KNOB_BASE_DESCRIBED {
        result : TraitDescription!
      }
        @description "behavior/describe's success for the trait whose knob vectors are asked."
      KNOB_PATH_RESOLVED {
        result : OrbBehaviorsWhich!
      }
        @description "behavior/resolve's success for the trait's behavior."
      KNOB_WHOLE_DESCRIBED {
        result : DescribedBehavior!
      }
        @description "behavior/describe's success for the whole behavior."
      KNOB_SOURCED {
        result : SExpr!
      }
        @description "behavior/source's success for the knob texts."
      TX_DESCRIBED {
        result : DescribedBehavior!
      }
        @description "behavior/describe's success for a behavior whose knob texts are built."
      TX_SOURCED {
        result : SExpr!
      }
        @description "behavior/source's success for a behavior whose knob texts are built."
      BvTexts.ENTRY_TEXTS_BUILT -> ENTRY_TEXTS_BUILT
      ENTRY_TEXTS_BUILT {
        organism : [TextRow]!
        capability : [TextRow]!
        wanted : [WantedText]!
      }
      BvTexts.KNOB_TEXTS_BUILT -> KNOB_TEXTS_BUILT
      KNOB_TEXTS_BUILT {
        texts : [TextRow]!
      }
      BvTexts.KNOB_TEXTS_REFUSED -> KNOB_TEXTS_REFUSED
      KNOB_TEXTS_REFUSED {
        error : string!
      }
      BvSources.SOURCES_READY -> SOURCES_READY
      SOURCES_READY {
        snapshots : [bytes]!
        snapshotPaths : [string]!
        userDir : string!
        userAnchor : string!
        providerModel : string!
        providerKind : string!
        embedModel : string!
      }
      BvSources.SOURCES_REFUSED -> SOURCES_REFUSED
      SOURCES_REFUSED {
        code : string!
        detail : string!
      }
      BvResolve.VECTORS_ANSWERED -> VECTORS_ANSWERED
      VECTORS_ANSWERED {
        model : string!
        vectors : [KeyedVector]!
      }
      BvResolve.VECTORS_REFUSED -> VECTORS_REFUSED
      VECTORS_REFUSED {
        code : string!
        detail : string!
      }
      BEHAVIORS_DESCRIBE { }
        @description "Self: describe the behavior."
      BEHAVIORS_STDIN { }
        @description "Self: describe the value on stdin."
      STDIN_READ {
        data : bytes!
      }
        @description "os/read's success: the bytes read from stdin."
      STDIN_FAILED {
        error : string!
        kind : string
      }
        @description "os/read's failure."
      BEHAVIORS_SOURCE { }
        @description "Self: read the program."
      BEHAVIORS_WHICH { }
        @description "Self: resolve the specifier."
      BEHAVIORS_EXPECTS { }
        @description "Self: derive the expectations."
      EXPECTS_EXISTS {
        ok : boolean!
      }
        @description "os/exists's success: whether the operand is a file."
      EXPECTS_EXISTS_FAILED {
        error : string!
        kind : string
      }
        @description "os/exists's failure."
      EXPECTS_DERIVED {
        result : Map string ExpectValue!
      }
        @description "behavior/resolve's success with expects: true."
      BEHAVIORS_TEXTS { }
        @description "Self: list the embedding texts."
      WHICH_RESOLVED {
        result : OrbBehaviorsWhich!
      }
        @description "behavior/resolve's success with path: true."
      CATALOG_LISTED {
        result : [OrbBehaviorsCatalogHit]!
      }
        @description "behavior/catalog's success."
      CATALOG_TOPICS_LISTED {
        result : [OrbBehaviorsCatalogTopic]!
      }
        @description "Self: the listing's packages and topics, each once in first-appearance order, with its count."
      TRAIT_DESCRIBED {
        result : TraitDescription!
      }
        @description "behavior/describe's success for a trait."
      BEHAVIOR_DESCRIBED {
        result : OrbBehaviorsDescription!
      }
        @description "behavior/describe's success for a whole behavior."
      SOURCED {
        result : SExpr!
      }
        @description "behavior/source's success."
      BEHAVIORS_FAILED {
        error : string!
      }
        @description "A reflection operator's failure."
    }
  }

  page boot as OrbBehaviorsOrbitalStart -> OrbBehaviors, OrbLintControlUnhandled, BehaviorBorrows, OrbLintOrbitalRefClosure, OrbLintInput, OrbFiredEvents, OrbEmbedChain, Packs, Versions, ArgsCli, CatalogVectors, BvTexts, BvSources, BvResolve, BvStore, BvWrite, BvQuantize, BvF32, BvSig6, BvBigCmp, BvDelay, ResolveLlmOrShared, ResolveLlmOrOwn, ResolveLlmOaShared, ResolveLlmOaOwn, ResolveLlmLm, ResolveOrSharedWait, ResolveOrSharedRequest, ResolveOrSharedHttp, ResolveOrOwnWait, ResolveOrOwnRequest, ResolveOrOwnHttp, ResolveOaSharedWait, ResolveOaSharedRequest, ResolveOaSharedHttp, ResolveOaOwnWait, ResolveOaOwnRequest, ResolveOaOwnHttp, ResolveLmWait, ResolveLmRequest, ResolveLmHttp
}
