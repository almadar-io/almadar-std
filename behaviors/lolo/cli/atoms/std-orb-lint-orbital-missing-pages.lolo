app std-orb-lint-orbital-missing-pages [
  version: "1.0.0",
  inbound: ["cli-lint-orbital-missing-pages"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-orbital-missing-pages — the `orb lint orbital-missing-pages <file>` command, the port of the ORB_O_MISSING_PAGES check in validate_all_pages. It lowers the file with program/read and reports every non-spec orbital that declares no page, with its path and suggestion (status 500, exit 1). Clean answers `lint orbital-missing-pages: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-orbital-missing-pages"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type MissingPagesPage = { path : string }
type MissingPagesOrbital = { name : string, spec : boolean, reference : string, pages : [MissingPagesPage] }
type MissingPagesProgram = { orbitals : [MissingPagesOrbital]! }

orbital OrbLintOrbitalMissingPagesOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintOrbitalMissingPagesRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintOrbitalMissingPages -> OrbLintOrbitalMissingPagesRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ob (array/nth @orbitals @oi)))
              (if (or (object/get @ob "spec" false) (object/has @ob "reference") (> (array/len (object/get @ob "pages" [])) 0))
                []
                [{ code: "ORB_O_MISSING_PAGES", path: (str/concat "orbitals[" @oi "]"), message: (str/concat "Orbital '" (object/get @ob "name" "") "' has no pages defined - traits won't be accessible"), suggestion: "Add a pages array with at least one page to expose the orbital's traits", severity: "error" }])))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "orbital-missing-pages", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : MissingPagesProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintOrbitalMissingPagesCli -> OrbLintOrbitalMissingPagesRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-missing-pages <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-missing-pages") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint orbital-missing-pages: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-missing-pages") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint orbital-missing-pages: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-orbital-missing-pages" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint orbital-missing-pages` with its arguments and working directory."
        @synonyms "orb lint orbital-missing-pages"
      OrbLintOrbitalMissingPages.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintOrbitalMissingPagesCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintOrbitalMissingPagesOrbitalStart -> OrbLintOrbitalMissingPages, OrbLintOrbitalMissingPagesCli, OrbLintInput, Packs, Versions
}
