app std-orb-lint-orbital-missing-pages [
  version: "1.0.0",
  inbound: ["cli-lint-orbital-missing-pages"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-orbital-missing-pages — the `orb lint orbital-missing-pages <file>` command, the port of the ORB_O_MISSING_PAGES check in validate_all_pages. It lowers the file with program/read and reports every non-spec orbital that declares no page, with its path and suggestion (status 500, exit 1). Clean answers `lint orbital-missing-pages: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-orbital-missing-pages"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintOrbitalMissingPagesOrbital {
  entity OrbLintOrbitalMissingPagesRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintOrbitalMissingPages -> OrbLintOrbitalMissingPagesRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "orbital-missing-pages", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ob (array/nth @orbitals @oi)))
              (if (or (object/get @ob "spec" false) (object/has @ob "reference") (> (array/len (object/get @ob "pages" [])) 0))
                []
                [(str/concat "[ORB_O_MISSING_PAGES] orbitals[" @oi "]: Orbital '" (object/get @ob "name" "") "' has no pages defined - traits won't be accessible\n  suggestion: Add a pages array with at least one page to expose the orbital's traits")])))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "orbital-missing-pages" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintOrbitalMissingPagesCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintOrbitalMissingPagesCli -> OrbLintOrbitalMissingPagesRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint orbital-missing-pages <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-missing-pages") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint orbital-missing-pages: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "orbital-missing-pages") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "orbital-missing-pages")
        (emit LINT_ANSWERED { status: 500, body: "lint orbital-missing-pages: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-orbital-missing-pages" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint orbital-missing-pages` with its arguments and working directory."
        @synonyms "orb lint orbital-missing-pages"
      OrbLintOrbitalMissingPages.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalMissingPages.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-orbital-missing-pages" as OrbLintOrbitalMissingPagesPage -> OrbLintOrbitalMissingPages, OrbLintOrbitalMissingPagesCli
}
