app std-orb-lint-transition-refs [
  version: "1.0.0",
  inbound: ["cli-lint-transition-refs"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-transition-refs — the `orb lint transition-refs <file>` command, the port of ORB_T_INVALID_TRANSITION and ORB_T_UNDEFINED_EVENT (trait_validator.rs validate_transitions). It lowers the file with program/read and, for every inline trait with at least one state, reports per transition a source state that is not declared (`*` allowed; list sources checked one by one), a target state that is not declared, and, when the trait declares events, an event other than INIT that is not among them, each with the Rust path and message (the Rust valid-values list is not printed). Status 500, exit 1. Clean answers `lint transition-refs: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-transition-refs"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type TrRefsFrom = string | [string]
type TrRefsState = { name : string }
type TrRefsEvent = { key : string }
type TrRefsTransition = { from : TrRefsFrom, event : string, to : string }
type TrRefsMachine = { states : [TrRefsState], events : [TrRefsEvent], transitions : [TrRefsTransition] }
type TrRefsTrait = { stateMachine : TrRefsMachine }
type TrRefsOrbital = { traits : [TrRefsTrait] }
type TrRefsProgram = { orbitals : [TrRefsOrbital] }

orbital OrbLintTransitionRefsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintTransitionRefsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintTransitionRefs -> OrbLintTransitionRefsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((trList (object/get (array/nth @orbitals @oi) "traits" [])))
              (array/flatten (array/map (array/range 0 (array/len @trList)) (fn ti
                (let ((td (array/nth @trList @ti)))
                  (if (not (validate/object (object/get @td "stateMachine" null)))
                    []
                    (let ((sm (object/get @td "stateMachine")) (tpath (str/concat "orbitals[" @oi "].traits[" @ti "]")))
                      (let ((sts (object/get @sm "states" [])) (where (str/concat @tpath ".stateMachine")))
                        (if (= (array/len @sts) 0)
                          []
                          (let ((names (array/map @sts (fn s (object/get @s "name" "")))) (evs (array/map (object/get @sm "events" []) (fn e (object/get @e "key" "")))) (tx (object/get @sm "transitions" [])))
                            (array/flatten (array/map (array/range 0 (array/len @tx)) (fn k
                              (let ((tr (array/nth @tx @k)) (p (str/concat @where ".transitions[" @k "]")) (frm (object/get (array/nth @tx @k) "from" "")) (ev (object/get (array/nth @tx @k) "event" "")))
                                (let ((froms (if (validate/string @frm) (array/append [] @frm) @frm)))
                                  (array/flatten [
                                    (array/flatten (array/map @froms (fn f (if (and (!= @f "*") (not (array/includes @names @f))) [{ code: "ORB_T_INVALID_TRANSITION", path: (str/concat @p ".from"), message: (str/concat "Source state '" @f "' does not exist"), suggestion: "", severity: "error" }] []))))
                                    (if (not (array/includes @names (object/get @tr "to" ""))) [{ code: "ORB_T_INVALID_TRANSITION", path: (str/concat @p ".to"), message: (str/concat "Target state '" (object/get @tr "to" "") "' does not exist"), suggestion: "", severity: "error" }] [])
                                    (if (and (> (array/len @evs) 0) (!= @ev "INIT") (not (array/includes @evs @ev))) [{ code: "ORB_T_UNDEFINED_EVENT", path: (str/concat @p ".event"), message: (str/concat "Event '" @ev "' is not defined in events array"), suggestion: "Add the event to the stateMachine.events array", severity: "error" }] [])])))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "transition-refs", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : TrRefsProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintTransitionRefsCli -> OrbLintTransitionRefsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint transition-refs <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "transition-refs") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint transition-refs: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "transition-refs") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint transition-refs: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-transition-refs" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint transition-refs` with its arguments and working directory."
        @synonyms "orb lint transition-refs"
      OrbLintTransitionRefs.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintTransitionRefsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintTransitionRefsOrbitalStart -> OrbLintTransitionRefs, OrbLintTransitionRefsCli, OrbLintInput, Packs, Versions
}
