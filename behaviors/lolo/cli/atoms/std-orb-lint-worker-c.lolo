app std-orb-lint-worker-c [
  version: "1.0.0",
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-worker-c — one lint worker: the lint engine's collecting trait and producers over a subset of its rule traits, composed from std-orb-lint-engine. A host opens it as a guest session, hands it the file and the language packs it scanned (LintWorker.WORKER_GO) and hears WORKER_DONE { ok, error, found, final }. The rule traits listed here are this worker's share of the partition: every rule trait of the engine is in exactly one worker, with the rules it listens to."
]
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type RuleFound = { rule : string!, findings : [OrbFinding]! }
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type LeafTrait = { name : string }
type LeafOrbital = { name : string, traits : [LeafTrait] }
type LeafNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type PatternEventProp = { pattern : string!, prop : string!, field : string! }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcByLiteral = { key : string!, required : Map string [string]! }
type HcClosed = { request : boolean?, intRange : HcIntRange?, requestKeysByLiteral : HcByLiteral? }
type HcGrantNeed = Map string HcVal
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcOrbital = { name : string, traits : [HcVal] }
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, family : string?, emitKeys : [string]? }
type WalkSlot = { kind : string!, args : [number] }
type WalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type ExprAskItem = { e : FiredNode?, eff : boolean! }
type WorkerPack = { name : string!, text : string! }

orbital OrbLintWorkerCOrbital {
  uses Engine from "std/behaviors/std-orb-lint-engine"
  uses Worker0 from "std/behaviors/std-orb-lint-worker"

  entity OrbLintWorkerCRun [runtime] {
    id : string!
  }

  trait OrbLintEngine = Engine.traits.OrbLintEngine {
    config {
      rules: ["entity-semantic-default", "entity-shape", "http-egress-entry", "inbound", "init-coverage", "page-empty-traits", "page-path-uniqueness", "client-tick-locality", "fetch-by-id-payload", "orbital-config-dead-knob", "sign-in-route", "route-init-params", "trait-id-uniqueness", "slot", "retired-effect-forms", "transition-refs", "engine-rule-count", "id-ledger", "program-eval", "listen-route-starves-required-field", "listen-source-never-produces", "entity-access", "filter-field-never-written", "derived-field-write", "field-path", "sigil-context", "time-unit", "binding-roots", "call-service", "circuit-client-bound", "circuit-item-actions", "composed-wiring", "effect-forms", "expectation-final", "icon-exists", "oauth", "orbital-ref-closure", "invariants", "rui-binding"]
      finalRules: ["expectation-final"]
      programOnlyRules: ["engine-rule-count", "id-ledger", "orbital-ref-closure", "invariants"]
    }
    listens {
      LINT_RUN { file : string! }
        @description "Run every lint rule over this file; the cli hook and std-orb-validate emit it."
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
      LINT_FOUND { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "One rule atom's findings for the file or the lazy child being linted."
      LINT_LAZY_HEARD { orbitals : [string]! }
        @description "std-orb-lint-input's LINT_LAZY: the lazy children to lint after the program."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
      CallSiteInput.LINT_CALL_SITES_UNREAD -> LINT_INPUT_UNREAD
      OrbLintInput.LINT_LAZY -> LINT_LAZY_HEARD
      OrbLintEntitySemanticDefault.LINT_FOUND -> LINT_FOUND
      OrbLintEntityShape.LINT_FOUND -> LINT_FOUND
      OrbLintHttpEgressEntry.LINT_FOUND -> LINT_FOUND
      OrbLintInbound.LINT_FOUND -> LINT_FOUND
      OrbLintInitCoverage.LINT_FOUND -> LINT_FOUND
      OrbLintPageEmptyTraits.LINT_FOUND -> LINT_FOUND
      OrbLintPagePathUniqueness.LINT_FOUND -> LINT_FOUND
      OrbLintClientTickLocality.LINT_FOUND -> LINT_FOUND
      OrbLintFetchByIdPayload.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalConfigDeadKnob.LINT_FOUND -> LINT_FOUND
      OrbLintSignInRoute.LINT_FOUND -> LINT_FOUND
      OrbLintRouteInitParams.LINT_FOUND -> LINT_FOUND
      OrbLintTraitIdUniqueness.LINT_FOUND -> LINT_FOUND
      OrbLintSlot.LINT_FOUND -> LINT_FOUND
      OrbLintRetiredEffectForms.LINT_FOUND -> LINT_FOUND
      OrbLintTransitionRefs.LINT_FOUND -> LINT_FOUND
      OrbLintEngineRuleCount.LINT_FOUND -> LINT_FOUND
      OrbLintIdLedger.LINT_FOUND -> LINT_FOUND
      OrbLintProgramEval.LINT_FOUND -> LINT_FOUND
      OrbLintListenRouteStarvesRequiredField.LINT_FOUND -> LINT_FOUND
      OrbLintListenSourceNeverProduces.LINT_FOUND -> LINT_FOUND
      OrbLintEntityAccess.LINT_FOUND -> LINT_FOUND
      OrbLintFilterFieldNeverWritten.LINT_FOUND -> LINT_FOUND
      OrbLintDerivedFieldWrite.LINT_FOUND -> LINT_FOUND
      OrbLintFieldPath.LINT_FOUND -> LINT_FOUND
      OrbLintSigilContext.LINT_FOUND -> LINT_FOUND
      OrbLintTimeUnit.LINT_FOUND -> LINT_FOUND
      OrbLintBindingRoots.LINT_FOUND -> LINT_FOUND
      OrbLintCallService.LINT_FOUND -> LINT_FOUND
      OrbLintCircuitClientBound.LINT_FOUND -> LINT_FOUND
      OrbLintCircuitItemActions.LINT_FOUND -> LINT_FOUND
      OrbLintComposedWiring.LINT_FOUND -> LINT_FOUND
      OrbLintEffectForms.LINT_FOUND -> LINT_FOUND
      OrbLintExpectationFinal.LINT_FOUND -> LINT_FOUND
      OrbLintIconExists.LINT_FOUND -> LINT_FOUND
      OrbLintOauth.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalRefClosure.LINT_FOUND -> LINT_FOUND
      OrbLintInvariants.LINT_FOUND -> LINT_FOUND
      OrbLintRuiBinding.LINT_FOUND -> LINT_FOUND
      Worker.LINT_RUN -> LINT_RUN
    }
  }
  trait Packs = Worker0.traits.PacksGiven {
    listens {
      PACKS_GIVEN { packs : [WorkerPack]!  coreRoot : string!  stdRoot : string! }
      LANG_SCAN { cwd : string! }
      OrbLintInput.LINT_PACKS_RUN -> LANG_SCAN
      Worker.PACKS_GIVEN -> PACKS_GIVEN
    }
  }
  trait Worker = Worker0.traits.LintWorker {
    listens {
      WORKER_GO -> input { file : string!  packs : [WorkerPack]!  coreRoot : string!  stdRoot : string! }
      WORKER_UNREAD { file : string!  error : string! }
      WORKER_COLLECTED { findings : [OrbFinding]!  found : [RuleFound]!  final : [OrbFinding]! }
      OrbLintEngine.LINT_COLLECTED -> WORKER_COLLECTED
      OrbLintInput.LINT_INPUT_UNREAD -> WORKER_UNREAD
    }
  }
  trait OrbLintExpectationFinal = Engine.traits.OrbLintExpectationFinal {
  }
  trait OrbLintInput = Engine.traits.OrbLintInput {
  }
  trait OrbLintEntitySemanticDefault = Engine.traits.OrbLintEntitySemanticDefault {
  }
  trait OrbLintEntityShape = Engine.traits.OrbLintEntityShape {
  }
  trait OrbLintHttpEgressEntry = Engine.traits.OrbLintHttpEgressEntry {
  }
  trait OrbLintInbound = Engine.traits.OrbLintInbound {
  }
  trait OrbLintInitCoverage = Engine.traits.OrbLintInitCoverage {
  }
  trait OrbLintPageEmptyTraits = Engine.traits.OrbLintPageEmptyTraits {
  }
  trait OrbLintPagePathUniqueness = Engine.traits.OrbLintPagePathUniqueness {
  }
  trait OrbLintClientTickLocality = Engine.traits.OrbLintClientTickLocality {
  }
  trait OrbLintFetchByIdPayload = Engine.traits.OrbLintFetchByIdPayload {
  }
  trait OrbLintOrbitalConfigDeadKnob = Engine.traits.OrbLintOrbitalConfigDeadKnob {
  }
  trait OrbFiredEvents = Engine.traits.OrbFiredEvents {
  }
  trait OrbLintSignInRoute = Engine.traits.OrbLintSignInRoute {
  }
  trait OrbLintRouteInitParams = Engine.traits.OrbLintRouteInitParams {
  }
  trait OrbLintTraitIdUniqueness = Engine.traits.OrbLintTraitIdUniqueness {
  }
  trait OrbLintSlot = Engine.traits.OrbLintSlot {
  }
  trait OrbLintRetiredEffectForms = Engine.traits.OrbLintRetiredEffectForms {
  }
  trait OrbLintTransitionRefs = Engine.traits.OrbLintTransitionRefs {
  }
  trait OrbLintEngineRuleCount = Engine.traits.OrbLintEngineRuleCount {
  }
  trait OrbLintIdLedger = Engine.traits.OrbLintIdLedger {
  }
  trait OrbLintProgramEval = Engine.traits.OrbLintProgramEval {
  }
  trait OrbLintListenRouteStarvesRequiredField = Engine.traits.OrbLintListenRouteStarvesRequiredField {
  }
  trait OrbLintListenSourceNeverProduces = Engine.traits.OrbLintListenSourceNeverProduces {
  }
  trait OrbLintEntityAccess = Engine.traits.OrbLintEntityAccess {
  }
  trait OrbLintFilterFieldNeverWritten = Engine.traits.OrbLintFilterFieldNeverWritten {
  }
  trait OrbLintDerivedFieldWrite = Engine.traits.OrbLintDerivedFieldWrite {
  }
  trait OrbLintFieldPath = Engine.traits.OrbLintFieldPath {
  }
  trait OrbLintSigilContext = Engine.traits.OrbLintSigilContext {
  }
  trait OrbLintTimeUnit = Engine.traits.OrbLintTimeUnit {
  }
  trait OrbEmbedChain = Engine.traits.OrbEmbedChain {
  }
  trait OrbEffectLeaves = Engine.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [LeafOrbital]!  heads : [string]! }
        @description "The effect-sequencing rules' asks: flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[LeafNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintProgramEval.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintEffectForms.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbProducedProgram = Engine.traits.OrbProducedProgram {
  }
  trait OrbLintBindingRoots = Engine.traits.OrbLintBindingRoots {
  }
  trait OrbLintCallService = Engine.traits.OrbLintCallService {
  }
  trait OrbLintCircuitClientBound = Engine.traits.OrbLintCircuitClientBound {
  }
  trait OrbLintCircuitItemActions = Engine.traits.OrbLintCircuitItemActions {
  }
  trait OrbLintComposedWiring = Engine.traits.OrbLintComposedWiring {
  }
  trait OrbLintEffectForms = Engine.traits.OrbLintEffectForms {
  }
  trait OrbLintExprNodes = Engine.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string WalkSlot!  projections : Map string WalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [ExprAskItem]! }
        @description "A rule offers the expressions whose nodes it needs."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbLintEffectForms.LINT_EXPR_ASK -> LINT_EXPR_ASK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }
  trait OrbLintIconExists = Engine.traits.OrbLintIconExists {
  }
  trait OrbLintOauth = Engine.traits.OrbLintOauth {
  }
  trait OrbLintOrbitalRefClosure = Engine.traits.OrbLintOrbitalRefClosure {
  }
  trait OrbLintInvariants = Engine.traits.OrbLintInvariants {
  }
  trait OrbLintRuiBinding = Engine.traits.OrbLintRuiBinding {
  }
  trait OrbEmitConfigCallService = Engine.traits.OrbEmitConfigCallService {
  }
  trait OrbEmitConfigOauth = Engine.traits.OrbEmitConfigOauth {
  }
  trait HostCalls = Engine.traits.HostCalls {
    listens {
      HOST_CALLS_COLLECT { requestId : string!  orbitals : [HcOrbital]!  heads : [string]!  operators : [string]!  fields : [string]! }
      OrbLintOauth.HOST_CALLS_COLLECT -> HOST_CALLS_COLLECT
      LINT_OPERATOR_SHAPES_HEARD { operators : Map string HcShape! }
      LINT_OPERATOR_SHAPES_UNREAD_HEARD { error : string! }
      LINT_HOST_FACTS_HEARD { operators : Map string HcExtras! }
      LINT_HOST_FACTS_UNREAD_HEARD { error : string! }
      OrbLintInput.LINT_OPERATOR_SHAPES -> LINT_OPERATOR_SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> LINT_OPERATOR_SHAPES_UNREAD_HEARD
      OrbLintInput.LINT_HOST_FACTS -> LINT_HOST_FACTS_HEARD
      OrbLintInput.LINT_HOST_FACTS_UNREAD -> LINT_HOST_FACTS_UNREAD_HEARD
    }
  }
  trait ServiceRegistry = Engine.traits.ServiceRegistry {
  }
  trait OrbValueLeaves = Engine.traits.OrbValueLeaves {
  }
  trait CallSiteInput = Engine.traits.CallSiteInput {
  }
  trait OrbProducedEvents = Engine.traits.OrbProducedEvents {
    listens {
      PRODUCED_SEMANTICS_HEARD { functions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators."
      PRODUCED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      PRODUCED_PATTERNS_HEARD { byPattern : [PatternEventProp]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: each pattern's event props and event-list fields."
      PRODUCED_SLOTS_HEARD { emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the emit option slots the operator table declares."
      PRODUCED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "A program whose produced events are asked: trait-ref-config offers one upstream trait at a time."
      OrbLintInput.LINT_EVENT_PROPS -> PRODUCED_PATTERNS_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> PRODUCED_SEMANTICS_HEARD
      OrbLintInput.LINT_OPERATOR_WALK -> PRODUCED_WALK_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> PRODUCED_SLOTS_HEARD
    }
  }

  page boot as OrbLintWorkerCOrbitalStart -> OrbLintEngine, Packs, Worker, OrbLintExpectationFinal, OrbLintInput, OrbLintEntitySemanticDefault, OrbLintEntityShape, OrbLintHttpEgressEntry, OrbLintInbound, OrbLintInitCoverage, OrbLintPageEmptyTraits, OrbLintPagePathUniqueness, OrbLintClientTickLocality, OrbLintFetchByIdPayload, OrbLintOrbitalConfigDeadKnob, OrbFiredEvents, OrbLintSignInRoute, OrbLintRouteInitParams, OrbLintTraitIdUniqueness, OrbLintSlot, OrbLintRetiredEffectForms, OrbLintTransitionRefs, OrbLintEngineRuleCount, OrbLintIdLedger, OrbLintProgramEval, OrbLintListenRouteStarvesRequiredField, OrbLintListenSourceNeverProduces, OrbLintEntityAccess, OrbLintFilterFieldNeverWritten, OrbLintDerivedFieldWrite, OrbLintFieldPath, OrbLintSigilContext, OrbLintTimeUnit, OrbEmbedChain, OrbEffectLeaves, OrbProducedProgram, OrbLintBindingRoots, OrbLintCallService, OrbLintCircuitClientBound, OrbLintCircuitItemActions, OrbLintComposedWiring, OrbLintEffectForms, OrbLintExprNodes, OrbLintIconExists, OrbLintOauth, OrbLintOrbitalRefClosure, OrbLintInvariants, OrbLintRuiBinding, OrbEmitConfigCallService, OrbEmitConfigOauth, HostCalls, ServiceRegistry, OrbValueLeaves, CallSiteInput, OrbProducedEvents
}
