app std-orb-lint-binding-setters [
  version: "1.0.0",
  inbound: ["cli-lint-binding-setters"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-binding-setters - the `orb lint binding-setters <file>` command, the port of the write-side binding rules of binding.rs: ORB_BINDING_ENTITY_FIELD_NEVER_SET, ORB_BINDING_PERSIST_ROW_ID_NEVER_SET (validate_entity_fields_have_setters), ORB_BINDING_EMBED_READS_ARM_WRITE (validate_embed_reads_arm_writes) and the call-site capture half of ORB_BINDING_PAYLOAD_FIELD_UNDECLARED (validate_callsite_payload_captures). It lowers the file with program/read and, per orbital, indexes the sites where a transition renders an embedded trait (`@trait.<Child>` in its guard or effects) with the fields that transition sets, the values it sets and the payload its event declares. Every @entity.<field> a trait reads (guard, effects, tick effects) must be set by a (set @entity.<field> ...) somewhere in the trait, unless the field is intrinsic or has a declared default, a trait on the same [shared] entity sets it, or a rendering parent on the same entity sets it. A persist update or delete of the whole @entity needs a (set @entity.id ...). A render-only child of a persistent, non-shared entity that reads an @entity field its composing transition writes shows the value from before the write. A @callsitePayload.<path> capture must resolve in the payload of some composing event up the embed chain. The lifecycle events the bus never delivers are read from LINT_OPERATOR_SEMANTICS. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint binding-setters: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-binding-setters"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type SsShape = string | number | boolean | [SsShape?] | Map string SsShape?
type SsField = { name : string, properties : [SsField]? }
type SsEvent = { key : string, payloadSchema : [SsField]? }
type SsTr = { event : string, guard : SsShape?, effects : [SsShape] }
type SsTick = { effects : [SsShape] }
type SsMachine = { transitions : [SsTr], events : [SsEvent] }
type SsCfg = { default : SsShape? }
type SsTrait = { name : string, linkedEntity : string, stateMachine : SsMachine, ticks : [SsTick], config : Map string SsCfg }
type SsName = { name : string, intrinsic : boolean }
type SsEntity = { name : string, shared : boolean, persistence : string, fields : [SsName] }
type SsOrbital = { name : string, entity : SsEntity, auxiliaryEntities : [SsEntity], traits : [SsTrait] }
type SsProgram = { orbitals : [SsOrbital] }
type SsDef = { shared : boolean, persistent : boolean, exempt : [string] }
type SsX = { w : string, j : number, x : SsShape? }
type SsXT = { w : string, j : number, t : [string] }
type SsRow = { ev : string, g : [string], e : [string] }
type SsT = { n : string, l : string, tp : string, trs : [SsRow], tk : [string], cfg : [string], hasCfg : boolean, ro : boolean, pls : Map string [SsField] }
type SsSite = { pn : string, pl : string, ev : string, sf : [string], ss : Map string string, pay : [SsField]?, hasPay : boolean }
type SsLink = { c : string, i : number }
type SsPair = { f : string, ev : string }
type SsAnc = { stack : [string], seen : [string], res : [number] }
type SsSiteC = { emb : [string], site : SsSite }
type SsSets = { n : string, s : [string] }

orbital OrbLintBindingSettersOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintBindingSettersRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    busExcluded : [string] = []
    semanticsHeard : boolean = false
  }

  trait OrbLintBindingSetters -> OrbLintBindingSettersRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SEMANTICS_HEARD -> ready
        (set @entity.busExcluded @payload.busExcluded)
        (set @entity.semanticsHeard true)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((nostr : [string] []) (nonum : [number] []) (nof : [OrbFinding] []) (nosc : [SsSiteC] []) (noxs : [SsX] []) (nofields : [SsField] []) (nosets : [SsSets] []) (nosite : SsSite { pn: "", pl: "", ev: "", sf: [], ss: {}, pay: null, hasPay: false }) (nolinks : [SsLink] []) (busEx : [string] @entity.busExcluded) (eP : string (str/concat (quote "@") "entity.")) (eB : string (str/concat (quote "@") "entity")) (tP2 : string (str/concat (quote "@") "trait.")) (pP : string (str/concat (quote "@") "payload.")) (cP : string (str/concat (quote "@") "callsitePayload.")) (cpP : string (str/concat (quote "@") "callsitePayload.")) (orbitals : [SsOrbital] (object/get @payload.program "orbitals" [])))
  (let ((entIdx : Map string SsDef (or (object/fromEntries
  (array/flatten (array/map @orbitals (fn o
    (array/map
      (array/filter (array/concat [(object/get @o "entity" null)] (object/get @o "auxiliaryEntities" [])) (fn e (validate/object @e)))
      (fn e [(object/get @e "name" ""), { shared: (object/get @e "shared" false), persistent: (= (object/get @e "persistence" "persistent") "persistent"), exempt: (array/map (array/filter (object/get @e "fields" []) (fn f (or (object/get @f "intrinsic" false) (object/has @f "default")))) (fn f (object/get @f "name" ""))) }]))))))
  {})))
    (array/flatten
      (array/map (array/range 0 (array/len @orbitals))
        (fn oi
          (let ((o (array/nth @orbitals @oi)))
  (let ((trts : [SsTrait] (object/get @o "traits" [])))
    (let ((rows : [SsT] (array/map (array/filter (array/range 0 (array/len @trts)) (fn ti (object/has (array/nth @trts @ti) "stateMachine")))
  (fn ti
    (let ((t (array/nth @trts @ti)) (cfgm : Map string SsCfg (object/get (array/nth @trts @ti) "config" {})))
      (let ((trs : [SsTr] (object/get (object/get @t "stateMachine" { transitions: [] }) "transitions" [])) (tks : [SsTick] (object/get @t "ticks" [])))
        (let ((xs : [SsX] (array/concat
                (array/concat
                  (array/flatten (array/map (array/range 0 (array/len @trs)) (fn j
                    (let ((g (object/get (array/nth @trs @j) "guard" null)) (effs : [SsShape] (object/get (array/nth @trs @j) "effects" [])))
                      (array/concat
                        (if (!= @g null) [{ w: "g", j: @j, x: @g }] @noxs)
                        (array/map @effs (fn ef { w: "e", j: @j, x: @ef })))))))
                  (array/flatten (array/map @tks (fn tk (array/map (object/get @tk "effects" []) (fn ef { w: "t", j: 0, x: @ef }))))))
                (array/flatten (array/map (object/keys @cfgm) (fn kn (if (= (object/get (object/get @cfgm @kn) "default" null) null) @noxs [{ w: "c", j: 0, x: (object/get (object/get @cfgm @kn) "default" null) }])))))))
          (let ((tx : [SsXT] (array/map @xs (fn q { w: (object/get @q "w" ""), j: (object/get @q "j" 0), t: (or (tree/fold (object/get @q "x" null) (fn (n k) (if (validate/string @n)
  (if (str/startsWith @n @eP)
    (let ((fld (array/first (str/split (array/first (str/split (str/slice @n 8) ".")) "["))))
      (array/concat
        (if (and (!= @fld "") (not (array/includes ["id", "createdAt", "updatedAt"] @fld))) [(str/concat "r:" @fld)] @nostr)
        [(str/concat "e:" (array/first (str/split (str/slice @n 8) ".")))]))
    (if (= @n @eB)
      ["e:*"]
      (if (str/startsWith @n @tP2)
        (let ((tnm (str/slice @n 7)))
          (if (and (!= @tnm "") (not (str/includes @tnm "."))) [(str/concat "t:" @tnm)] @nostr))
        (if (and (str/startsWith @n @cP) (> (str/len @n) 17))
          [(str/concat "c:" (str/slice @n 17))]
          @nostr))))
  (if (validate/array @n)
    (let ((len (array/len @n)) (o0 (if (> (array/len @n) 0) (array/nth @n 0) "")) (o1 (if (> (array/len @n) 1) (array/nth @n 1) "")) (o3 (if (> (array/len @n) 3) (array/nth @n 3) "")) (o2 (if (> (array/len @n) 2) (array/nth @n 2) "")))
      (array/concat
        (if (and (>= @len 2) (validate/string @o0) (validate/string @o1))
          (array/concat
            (if (and (= @o0 "set") (str/startsWith @o1 @eP))
              (array/concat
                (let ((sf (array/first (str/split (array/first (str/split (str/slice @o1 8) ".")) "["))))
                  (if (!= @sf "") [(str/concat "s:" @sf)] @nostr))
                (if (>= @len 3)
                  [(str/concat "v:" (array/first (str/split (str/slice @o1 8) ".")) "|" (if (validate/string @o2) (if (str/startsWith @o2 @pP) (str/concat "?" (str/slice @o2 9)) "") ""))]
                  @nostr))
              @nostr)
            (if (and (= @o0 "persist") (>= @len 4) (or (= @o1 "update") (= @o1 "delete")) (validate/string @o3) (= @o3 @eB)) ["p:1"] @nostr))
          @nostr)
        (array/flatten (array/map @k (fn r (let ((rr : [string]? @r)) (if (validate/array @rr) @rr @nostr)))))))
    (if (validate/object @n)
      (array/flatten (array/map (object/values @k) (fn r (let ((rr : [string]? @r)) (if (validate/array @rr) @rr @nostr)))))
      @nostr)))) SsShape) @nostr) }))))
            { n: (object/get @t "name" ""),
              l: (object/get @t "linkedEntity" ""),
              tp: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]"),
              trs: (array/map (array/range 0 (array/len @trs)) (fn j { ev: (object/get (array/nth @trs @j) "event" ""),
                     g: (array/flatten (array/map (array/filter @tx (fn q (and (= (object/get @q "w" "") "g") (= (object/get @q "j" 0) @j)))) (fn q (object/get @q "t" @nostr)))),
                     e: (array/flatten (array/map (array/filter @tx (fn q (and (= (object/get @q "w" "") "e") (= (object/get @q "j" 0) @j)))) (fn q (object/get @q "t" @nostr)))) })),
              tk: (array/flatten (array/map (array/filter @tx (fn q (= (object/get @q "w" "") "t"))) (fn q (object/get @q "t" @nostr)))),
              cfg: (array/flatten (array/map (array/filter @tx (fn q (= (object/get @q "w" "") "c"))) (fn q (object/get @q "t" @nostr)))),
              hasCfg: (object/has @t "config"),
              pls: (or (object/fromEntries (array/flatten (array/map (object/get (object/get @t "stateMachine" { events: [] }) "events" []) (fn e (if (object/has @e "payloadSchema") [[(object/get @e "key" ""), (object/get @e "payloadSchema")]] []))))) {}),
              ro: (array/every @trs (fn tr (array/includes @busEx (object/get @tr "event" "")))) }))))))))
      (let ((names : [string] (array/map @rows (fn r (object/get @r "n" ""))))
            (setsRows : [SsSets] (array/map @rows (fn r { n: (object/get @r "n" ""), s: (array/unique (array/map (array/filter (array/concat (array/flatten (array/map (object/get @r "trs" []) (fn tr (array/concat (object/get @tr "g" @nostr) (object/get @tr "e" @nostr))))) (object/get @r "tk" @nostr)) (fn q (str/startsWith @q "s:"))) (fn q (str/slice @q 2)))) })))
            (roByName : Map string boolean (or (object/fromEntries (array/map @rows (fn r [(object/get @r "n" ""), (object/get @r "ro" false)]))) {})))
        (let ((setsByName : Map string [SsSets] (array/groupBy @setsRows "n"))
              (sc : [SsSiteC] (array/flatten (array/map (array/range 0 (array/len @rows)) (fn k
        (let ((rw (array/nth @rows @k)))
          (array/flatten (array/map (object/get @rw "trs" []) (fn tr
            (let ((toks : [string] (array/concat (object/get @tr "g" @nostr) (object/get @tr "e" @nostr))))
              (let ((emb (array/unique (array/map (array/filter @toks (fn q (str/startsWith @q "t:"))) (fn q (str/slice @q 2))))))
                (if (= (array/len @emb) 0)
                  @nosc
                  [{ emb: @emb,
                     site: { pn: (object/get @rw "n" ""), pl: (object/get @rw "l" ""), ev: (object/get @tr "ev" ""),
                             sf: (array/unique (array/map (array/filter @toks (fn q (str/startsWith @q "s:"))) (fn q (str/slice @q 2)))),
                             ss: (or (object/fromEntries (array/map (array/filter (object/get @tr "e" @nostr) (fn q (str/startsWith @q "v:"))) (fn q [(array/first (str/split (str/slice @q 2) "|")), (str/slice (str/slice @q 2) (+ 1 (str/len (array/first (str/split (str/slice @q 2) "|")))))]))) {}),
                             pay: (object/get (object/get @rw "pls" {}) (object/get @tr "ev" "") null),
                             hasPay: (object/has (object/get @rw "pls" {}) (object/get @tr "ev" "")) } }])))))))))))
      (sites : [SsSite] (array/map @sc (fn c (object/get @c "site" @nosite))))
      (parentsOf : Map string [SsLink] (array/groupBy (array/flatten (array/map (array/range 0 (array/len @sc)) (fn i (array/map (object/get (array/nth @sc @i) "emb") (fn c { c: @c, i: @i }))))) "c")))
          (array/concat
  (array/flatten (array/map (array/range 0 (array/len @rows)) (fn k (let ((rw (array/nth @rows @k)))
  (if (= (object/get @rw "l" "") "")
    @nof
    (let ((l (object/get @rw "l" "")) (def (object/get @entIdx (object/get @rw "l" "") null)) (tp (object/get @rw "tp" "")) (tname (object/get @rw "n" "")))
      (let ((sets : [string] (object/get (array/nth @setsRows @k) "s" @nostr)) (rtrs : [SsRow] (object/get @rw "trs" [])))
        (let ((exempt : [string] (if (= @def null) @nostr (object/get @def "exempt" @nostr)))
              (groupSets : [string] (if (and (!= @def null) (object/get @def "shared" false))
                 (array/unique (array/flatten (array/map (array/range 0 (array/len @rows)) (fn j (if (= (object/get (array/nth @rows @j) "l") @l) (object/get (array/nth @setsRows @j) "s" @nostr) @nostr)))))
                 @nostr))
              (credit : [string] (array/flatten (array/map (object/get (array/reduce (array/range 0 (+ (array/len @names) 2)) { stack: [(object/get @rw "n" "")], seen: @nostr, res: @nonum }
  (fn (acc st)
    (let ((stack (object/get @acc "stack" @nostr)) (seen (object/get @acc "seen" @nostr)) (res (object/get @acc "res" @nonum)))
      (if (= (array/len @stack) 0)
        @acc
        (let ((nm (array/last @stack)) (rest (array/dropLast @stack 1)))
          (if (array/includes @seen @nm)
            { stack: @rest, seen: @seen, res: @res }
            (let ((idxs (array/map (object/get @parentsOf @nm @nolinks) (fn lk (object/get @lk "i" 0)))))
              { stack: (array/concat @rest (array/map @idxs (fn i (object/get (array/nth @sites @i) "pn")))), seen: (array/append @seen @nm), res: (array/concat @res @idxs) }))))))) "res") (fn i (let ((site (array/nth @sites @i))) (if (= (object/get @site "pl" "") @l) (array/concat (object/get @site "sf" @nostr) (let ((sg (object/get @setsByName (object/get @site "pn" "") @nosets))) (if (= (array/len @sg) 0) @nostr (object/get (array/last @sg) "s" @nostr)))) @nostr)))))))
          (let ((pairs : [SsPair] (array/concat
                   (array/flatten (array/map @rtrs (fn tr (array/map (array/unique (array/map (array/filter (array/concat (object/get @tr "g" @nostr) (object/get @tr "e" @nostr)) (fn q (str/startsWith @q "r:"))) (fn q (str/slice @q 2)))) (fn f { f: @f, ev: (object/get @tr "ev" "") })))))
                   (array/map (array/unique (array/map (array/filter (object/get @rw "tk" @nostr) (fn q (str/startsWith @q "r:"))) (fn q (str/slice @q 2)))) (fn f { f: @f, ev: "TICK" })))))
            (let ((byF : Map string [SsPair] (array/groupBy @pairs "f")))
              (let ((pev (array/find @rtrs (fn tr (array/includes (object/get @tr "e" @nostr) "p:1")))))
                (array/concat
                  (if (and (not (array/includes @sets "id")) (!= @pev null) (not (array/includes @groupSets "id")) (not (array/includes @credit "id")))
                    [{ code: "ORB_BINDING_PERSIST_ROW_ID_NEVER_SET", path: @tp, message: (str/concat "trait \"" @tname "\" runs (persist update|delete " @l " " @eB ") on event \"" (object/get @pev "ev" "") "\" but no transition runs (set " @eP "id <value>); the row key resolves empty, and the runtime refuses the write and reports success without ever touching a row"), suggestion: (str/concat "Bind the row key before the write — (set " @eP "id ?row.id) on the transition that selects the " @l " row, or ?data.id on the fetch success that loaded it"), severity: "error" }]
                    @nof)
                  (array/flatten
                    (array/map (array/unique (array/map @pairs (fn q (object/get @q "f" ""))))
                      (fn f
                        (if (or (array/includes @exempt @f) (array/includes @sets @f) (array/includes @groupSets @f) (array/includes @credit @f))
                          @nof
                          (let ((ev (object/get (array/first (object/get @byF @f)) "ev")))
                            [{ code: "ORB_BINDING_ENTITY_FIELD_NEVER_SET", path: @tp, message: (str/concat "trait \"" @tname "\" reads " @eP @f " (first seen on event \"" @ev "\") but no transition runs (set " @eP @f " <value>); per the explicit-binding rule, every " @eP "X must be set explicitly or it stays undefined"), suggestion: (str/concat "Add (set " @eP @f " <default-or-payload>) in the trait's INIT transition or in a transition that runs before the read on entity \"" @l "\""), severity: "error" }])))))))))))))))))
  (array/concat
    (array/flatten (array/map (array/range 0 (array/len @rows)) (fn k (let ((rw (array/nth @rows @k)))
  (let ((l (object/get @rw "l" "")) (def (object/get @entIdx (object/get @rw "l" "") null)) (child (object/get @rw "n" "")))
    (if (or (not (object/get @rw "hasCfg" false)) (= @l "") (= @def null) (not (object/get @def "persistent" false)) (object/get @def "shared" false) (not (object/get @rw "ro" false)))
      @nof
      (let ((cfgToks : [string] (object/get @rw "cfg" @nostr)))
        (let ((whole (array/includes @cfgToks "e:*")) (flds : [string] (array/unique (array/map (array/filter @cfgToks (fn q (and (str/startsWith @q "e:") (!= @q "e:*")))) (fn q (str/slice @q 2))))))
          (if (and (= (array/len @flds) 0) (not @whole))
            @nof
            (let ((composing (array/unique (object/get (array/reduce (array/range 0 (+ (array/len @names) 2)) { stack: [@child], seen: @nostr, res: @nonum }
                      (fn (acc st)
                        (let ((stack (object/get @acc "stack" @nostr)) (seen (object/get @acc "seen" @nostr)) (res (object/get @acc "res" @nonum)))
                          (if (= (array/len @stack) 0)
                            @acc
                            (let ((nm (array/last @stack)) (rest (array/dropLast @stack 1)))
                              (if (array/includes @seen @nm)
                                { stack: @rest, seen: @seen, res: @res }
                                (let ((idxs (array/map (object/get @parentsOf @nm @nolinks) (fn lk (object/get @lk "i" 0)))))
                                  { stack: (array/concat @rest (array/filter (array/map @idxs (fn i (object/get (array/nth @sites @i) "pn"))) (fn pn (object/get @roByName @pn false)))), seen: (array/append @seen @nm), res: (array/concat @res @idxs) }))))))) "res"))))
              (array/flatten
                (array/map @composing
                  (fn i
                    (let ((site (array/nth @sites @i)))
                      (if (or (array/includes @busEx (object/get @site "ev" "")) (!= (object/get @site "pl" "") @l))
                        @nof
                        (let ((ssm : Map string string (object/get @site "ss" {})))
                          (let ((stale : [string] (array/filter (array/sort (object/keys @ssm)) (fn f (or @whole (array/includes @flds @f))))))
                            (if (= (array/len @stale) 0)
                              @nof
                              (let ((reads (str/join (array/map @stale (fn f (str/concat @eP @f))) ", ")) (host (object/get @site "pn" "")) (ev (object/get @site "ev" "")) (allCapt (array/every @stale (fn f (!= (object/get @ssm @f "") "")))))
                                [{ code: "ORB_BINDING_EMBED_READS_ARM_WRITE", path: (str/concat "orbitals[" @oi "] (embeds " @child ": " @reads ")"), message: (str/concat "`" @host "." @ev "` writes " @reads " and renders " @child ", which reads it when it mounts: it shows the value from before `" @ev "`"), suggestion: (if @allCapt (str/concat "Read what `" @ev "` used, as a call-site capture: " (str/join (array/map @stale (fn f (str/concat @eP @f " → " (object/get @ssm @f "")))) ", ")) (str/concat "Pass what `" @ev "` writes into `" @child "` through a call-site capture instead of reading it as `" @eB "`")), severity: "error" }])))))))))))))))))))
    (array/flatten (array/map (array/range 0 (array/len @rows)) (fn k (let ((rw (array/nth @rows @k)))
  (let ((paths : [string] (array/map (array/filter (object/get @rw "cfg" @nostr) (fn q (str/startsWith @q "c:"))) (fn q (str/slice @q 2)))) (child (object/get @rw "n" "")))
    (if (= (array/len @paths) 0)
      @nof
      (let ((anc : [number] (object/get (array/reduce (array/range 0 (+ (array/len @names) 2)) { stack: [(object/get @rw "n" "")], seen: @nostr, res: @nonum }
  (fn (acc st)
    (let ((stack (object/get @acc "stack" @nostr)) (seen (object/get @acc "seen" @nostr)) (res (object/get @acc "res" @nonum)))
      (if (= (array/len @stack) 0)
        @acc
        (let ((nm (array/last @stack)) (rest (array/dropLast @stack 1)))
          (if (array/includes @seen @nm)
            { stack: @rest, seen: @seen, res: @res }
            (let ((idxs (array/map (object/get @parentsOf @nm @nolinks) (fn lk (object/get @lk "i" 0)))))
              { stack: (array/concat @rest (array/map @idxs (fn i (object/get (array/nth @sites @i) "pn")))), seen: (array/append @seen @nm), res: (array/concat @res @idxs) }))))))) "res")))
        (if (= (array/len @anc) 0)
          @nof
          (array/flatten
            (array/map @paths
              (fn fp
                (let ((segs : [string] (array/filter (array/map (str/split @fp ".") (fn q (array/first (str/split @q "[")))) (fn q (!= @q "")))))
                  (if (= (array/len @segs) 0)
                    @nof
                    (let ((satisfied (array/some @anc (fn i (let ((site (array/nth @sites @i))) (and (object/get @site "hasPay" false) (= (object/get (array/reduce @segs { lv: (object/get @site "pay" null), miss: "", stop: false } (fn (acc sg)
                       (if (or (object/get @acc "stop" false) (!= (object/get @acc "miss" "") ""))
                         @acc
                         (let ((fm (array/find (object/get @acc "lv" @nofields) (fn q (= (object/get @q "name") @sg)))))
                           (if (= @fm null)
                             { lv: (object/get @acc "lv" @nofields), miss: @sg, stop: false }
                             (let ((props (object/get @fm "properties" null)))
                               (if (= @props null) { lv: (object/get @acc "lv" @nofields), miss: "", stop: true } { lv: @props, miss: "", stop: false }))))))) "miss") "")))))))
                      (if @satisfied
                        @nof
                        (let ((withPay (array/find @anc (fn i (object/get (array/nth @sites @i) "hasPay" false)))))
                          (let ((target (array/nth @sites (if (= @withPay null) (array/first @anc) @withPay))))
                            (let ((ev (object/get @target "ev" "")) (f0 (array/first @segs)) (p (str/concat "orbitals[" @oi "] (embeds " @child ": " @cpP @fp ")")) (restPath (str/join (array/slice @segs 1 (array/len @segs)) ".")))
                              (let ((schema : [SsField]? (object/get @target "pay" null)))
                                (let ((hybrid (and (>= (array/len @segs) 2) (= @f0 "payload") (or (= @schema null) (= (array/len (array/filter @schema (fn q (= (object/get @q "name") "payload")))) 0)))))
                                  (if (object/get @target "hasPay" false)
                                    (let ((res (array/reduce @segs { lv: @schema, miss: "", stop: false } (fn (acc sg)
                       (if (or (object/get @acc "stop" false) (!= (object/get @acc "miss" "") ""))
                         @acc
                         (let ((fm (array/find (object/get @acc "lv" @nofields) (fn q (= (object/get @q "name") @sg)))))
                           (if (= @fm null)
                             { lv: (object/get @acc "lv" @nofields), miss: @sg, stop: false }
                             (let ((props (object/get @fm "properties" null)))
                               (if (= @props null) { lv: (object/get @acc "lv" @nofields), miss: "", stop: true } { lv: @props, miss: "", stop: false })))))))))
                                      [{ code: "ORB_BINDING_PAYLOAD_FIELD_UNDECLARED", path: @p, message: (str/concat "Payload field '" (object/get @res "miss" "") "' is not declared in event '" @ev "' payload schema"), suggestion: (if @hybrid (str/concat "the `?` sigil already denotes the event payload — `?payload." @restPath "` lowers to `@payload.payload." @restPath "`; write `?" @restPath "` or `@payload." @restPath "` instead") (str/concat "Add { \"name\": \"" (object/get @res "miss" "") "\", \"type\": \"...\" } to the event's payload array")), severity: "error" }])
                                    [{ code: "ORB_BINDING_PAYLOAD_FIELD_UNDECLARED", path: @p, message: (str/concat "Event '" @ev "' uses @payload." @f0 " (.lolo spelling: `?" @f0 "` or `@payload." @f0 "`) but has no payload schema defined"), suggestion: (if @hybrid (str/concat "the `?` sigil already denotes the event payload — `?payload." @restPath "` lowers to `@payload.payload." @restPath "`; write `?" @restPath "` or `@payload." @restPath "` instead") (str/concat "Add a payload schema to the '" @ev "' event definition, or bind a field the event declares")), severity: "error" }]))))))))))))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "binding-setters", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : SsProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      SEMANTICS_HEARD { semantics : Map string string!  functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the lifecycle events the bus never delivers (the emit operator's busExcluded list)."
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> SEMANTICS_HEARD
    }
  }

  trait OrbLintBindingSettersCli -> OrbLintBindingSettersRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint binding-setters <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "binding-setters") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint binding-setters: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "binding-setters") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint binding-setters: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-binding-setters" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint binding-setters` with its arguments and working directory."
        @synonyms "orb lint binding-setters"
      OrbLintBindingSetters.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintBindingSettersCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintBindingSettersOrbitalStart -> OrbLintBindingSetters, OrbLintBindingSettersCli, OrbLintInput, Packs, Versions
}
