app std-orb-lint-id-refs [
  version: "1.0.0",
  inbound: ["cli-lint-id-refs"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-id-refs — the `orb lint id-refs <file>` command, the port of the compiler's ORB_ID_UNKNOWN_REF, ORB_ID_KIND_MISMATCH, ORB_ID_NAME_MISMATCH and ORB_ID_LEDGER_ORPHAN (id_integrity.rs). It lowers the file with program/read and checks every dual-carry id the compiler walks: the primary and auxiliary entities (extends, and field relations at any depth through items and properties), each trait data entity, every trait of the orbital and of its inline pages and page objects (linked entity, entityRefIds, emits, listens and their sources, a reference trait's ref), and the page object ref, linkedEntity and traitRefIds: the id's kind prefix against the position, the id against the declared nodes and the ledger, and the sibling name against the ledger curName (an `@config.<key>` curName is satisfied by the owning trait's config default). A ledger row that no declared node, checked id or `@trait.<Name>` embed carries is an orphan (an event row is carried by its live parent trait). Each finding has the Rust path and message (status 500, exit 1): positions of the entities and pages come first, then the traits, then the orphans. Clean answers `lint id-refs: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-id-refs"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type IdRefsExpr = string | number | boolean | [IdRefsExpr?] | Map string IdRefsExpr?
type IdRefsRelation = { entityId : string, entity : string }
type IdRefsField = { relation : IdRefsRelation, items : IdRefsField, properties : Map string IdRefsField }
type IdRefsEntity = { id : string, extendsId : string, extends : string, fields : [IdRefsField] }
type IdRefsEmit = { eventId : string, event : string }
type IdRefsSource = { kind : string, orbitalId : string, orbital : string, traitId : string, trait : string }
type IdRefsListen = { eventId : string, event : string, triggersId : string, triggers : string, source : IdRefsSource }
type IdRefsHit = { rel : string, id : string, name : string }
type IdRefsHits = [IdRefsHit]
type IdRefsHitMap = Map string IdRefsHits
type IdRefsPos = { id : string, exp : string, name : string, hasName : boolean, path : string }
type IdRefsPositions = [IdRefsPos]
type IdRefsForm = [IdRefsExpr?]
type IdRefsConfig = { default : IdRefsExpr }
type IdRefsArm = { effects : [IdRefsExpr?] }
type IdRefsMachine = { transitions : [IdRefsArm] }
type IdRefsTick = { effects : [IdRefsExpr?] }
type IdRefsTrait = { id : string, name : string, ref : string, refId : string, linkedEntityId : string, linkedEntity : string, entityRefIds : Map string string, traitEmbedIds : Map string string, emits : [IdRefsEmit], listens : [IdRefsListen], dataEntities : [IdRefsEntity], stateMachine : IdRefsMachine, ticks : [IdRefsTick], config : Map string IdRefsConfig }
type IdRefsPage = { id : string, name : string, ref : string, refId : string, linkedEntityId : string, linkedEntity : string, traitRefIds : [string], traits : [IdRefsTrait] }
type IdRefsOrbital = { id : string, name : string, entity : IdRefsEntity, auxiliaryEntities : [IdRefsEntity], pages : [IdRefsPage], traits : [IdRefsTrait] }
type IdRefsLedgerEntry = { id : string, kind : string, curName : string, parent : string }
type IdRefsLedger = { entries : Map string IdRefsLedgerEntry }
type IdRefsProgram = { orbitals : [IdRefsOrbital]!, ledger : IdRefsLedger }

orbital OrbLintIdRefsOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintIdRefsRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintIdRefs -> OrbLintIdRefsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((emptyHits (json/parse "[]" IdRefsHits)) (orbitals (object/get @payload.program "orbitals" [])) (ledgerEntries (object/get (object/get @payload.program "ledger" {}) "entries" {})))
          (let ((slots (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((orb (array/nth @orbitals @oi)))
                    (let ((op (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")]")) (trs (object/get @orb "traits" [])) (pgs (object/get @orb "pages" [])))
                      (array/concat
                        (array/map (array/filter (array/range 0 (array/len @trs)) (fn ti (validate/object (array/nth @trs @ti)))) (fn ti { t: (array/nth @trs @ti), tp: (str/concat @op ".traits[" @ti "]"), own: true }))
                        (array/flatten (array/map (array/filter (array/range 0 (array/len @pgs)) (fn pix (validate/object (array/nth @pgs @pix)))) (fn pix
                          (let ((pg (array/nth @pgs @pix)))
                            (let ((pts (object/get @pg "traits" [])) (isObj (object/has @pg "ref")))
                              (array/map (array/filter (array/range 0 (array/len @pts)) (fn ti (validate/object (array/nth @pts @ti))))
                                (fn ti { t: (array/nth @pts @ti), tp: (if @isObj (str/concat @op ".pages[" @pix "].traits[" @ti "]") (str/concat @op ".pages[" @pix " (" (object/get @pg "name" "") ")].traits[" @ti "]")), own: (not @isObj) }))))))))))))))
                (sortedKeys (array/sort (object/keys @ledgerEntries))))
            (let ((ownInline (array/filter @slots (fn s (and (object/get @s "own") (object/has (object/get @s "t") "stateMachine")))))
                  (inlineSlots (array/filter @slots (fn s (object/has (object/get @s "t") "stateMachine"))))
                  (refSlots (array/filter @slots (fn s (not (object/has (object/get @s "t") "stateMachine"))))))
              (let ((declared (array/concat
                      (array/flatten (array/map @orbitals (fn orb (array/concat
                        (if (object/has @orb "id") [(object/get @orb "id")] [])
                        (let ((ee (object/get @orb "entity" null))) (if (and (validate/object @ee) (not (object/has @ee "extends")) (object/has @ee "id")) [(object/get @ee "id")] []))
                        (array/map (array/filter (object/get @orb "auxiliaryEntities" []) (fn ae (and (validate/object @ae) (not (object/has @ae "extends")) (object/has @ae "id")))) (fn ae (object/get @ae "id")))
                        (array/map (array/filter (object/get @orb "pages" []) (fn pg (and (validate/object @pg) (not (object/has @pg "ref")) (object/has @pg "id")))) (fn pg (object/get @pg "id")))))))
                      (array/flatten (array/map @ownInline (fn s (let ((tr (object/get @s "t")))
                        (array/concat
                          (if (object/has @tr "id") [(object/get @tr "id")] [])
                          (array/map (array/filter (object/get @tr "emits" []) (fn em (object/has @em "eventId"))) (fn em (object/get @em "eventId")))
                          (array/map (array/filter (object/get @tr "dataEntities" []) (fn de (object/has @de "id"))) (fn de (object/get @de "id"))))))))))
                    (declTraitIds (array/map (array/filter @ownInline (fn s (object/has (object/get @s "t") "id"))) (fn s (object/get (object/get @s "t") "id"))))
                    (entBodies (array/concat
                      (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                        (let ((orb (array/nth @orbitals @oi)))
                          (let ((op (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")]")) (ee (object/get @orb "entity" null)) (auxs (object/get @orb "auxiliaryEntities" [])))
                            (array/concat
                              (if (and (validate/object @ee) (not (object/has @ee "extends"))) [{ ent: @ee, base: (str/concat @op ".entity") }] [])
                              (array/flatten (array/map (array/filter (array/range 0 (array/len @auxs)) (fn ai (let ((ae (array/nth @auxs @ai))) (and (validate/object @ae) (not (object/has @ae "extends")))))) (fn ai [{ ent: (array/nth @auxs @ai), base: (str/concat @op ".auxiliaryEntities[" @ai "]") }])))))))))
                      (array/flatten (array/map @inlineSlots (fn s (let ((des (object/get (object/get @s "t") "dataEntities" [])))
                        (array/map (array/filter (array/range 0 (array/len @des)) (fn di (validate/object (array/nth @des @di)))) (fn di { ent: (array/nth @des @di), base: (str/concat (object/get @s "tp") ".dataEntities[" @di "]") }))))))))
                    (extendsPos (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                      (let ((orb (array/nth @orbitals @oi)))
                        (let ((op (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")]")) (ee (object/get @orb "entity" null)) (auxs (object/get @orb "auxiliaryEntities" [])))
                          (array/concat
                            (if (and (validate/object @ee) (object/has @ee "extends") (object/has @ee "extendsId")) [{ id: (object/get @ee "extendsId"), exp: "ent_", name: (object/get @ee "extends" ""), hasName: true, path: (str/concat @op ".entity.extends") }] [])
                            (array/flatten (array/map (array/filter (array/range 0 (array/len @auxs)) (fn ai (let ((ae (array/nth @auxs @ai))) (and (validate/object @ae) (object/has @ae "extends") (object/has @ae "extendsId"))))) (fn ai (let ((ae (array/nth @auxs @ai))) [{ id: (object/get @ae "extendsId"), exp: "ent_", name: (object/get @ae "extends" ""), hasName: true, path: (str/concat @op ".auxiliaryEntities[" @ai "].extends") }])))))))))))
                    (pagePos (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                      (let ((orb (array/nth @orbitals @oi)))
                        (let ((op (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")]")) (pgs (object/get @orb "pages" [])))
                          (array/flatten (array/map (array/filter (array/range 0 (array/len @pgs)) (fn pix (let ((pg (array/nth @pgs @pix))) (and (validate/object @pg) (object/has @pg "ref"))))) (fn pix
                            (let ((pg (array/nth @pgs @pix)) (pp (str/concat @op ".pages[" @pix "]")))
                              (let ((pts (object/get @pg "traits" [])) (rids (object/get @pg "traitRefIds" [])))
                                (array/concat
                                  (if (object/has @pg "refId") [{ id: (object/get @pg "refId"), exp: "pag_", name: (object/get @pg "ref" ""), hasName: true, path: (str/concat @pp ".ref") }] [])
                                  (if (object/has @pg "linkedEntityId") [{ id: (object/get @pg "linkedEntityId"), exp: "ent_", name: (object/get @pg "linkedEntity" ""), hasName: (object/has @pg "linkedEntity"), path: (str/concat @pp ".linkedEntity") }] [])
                                  (array/map (array/filter (array/range 0 (array/len @rids)) (fn ti (!= (array/nth @rids @ti) "")))
                                    (fn ti (let ((tn (if (< @ti (array/len @pts)) (array/nth @pts @ti) null)))
                                      (let ((named (if (validate/object @tn) (or (object/has @tn "stateMachine") (object/has @tn "ref") (object/has @tn "name")) false)))
                                        { id: (array/nth @rids @ti), exp: "trt_", name: (if @named (if (object/has @tn "stateMachine") (object/get @tn "name" "") (if (object/has @tn "ref") (object/get @tn "ref" "") (object/get @tn "name" ""))) ""), hasName: @named, path: (str/concat @pp ".traitRefIds[" @ti "]") }))))))))))))))))
                    (fieldFolds (array/flatten (array/map @entBodies (fn eb (let ((fl (object/get (object/get @eb "ent") "fields" []))) (array/map (array/range 0 (array/len @fl)) (fn fi { eb: @eb, fi: @fi, res: (tree/fold (array/nth @fl @fi) (fn (n k)
                              (array/concat
                                (let ((rl (object/get @n "relation" null))) (if (and (validate/object @rl) (object/has @rl "entityId")) [{ rel: "", id: (object/get @rl "entityId"), name: (object/get @rl "entity" "") }] []))
                                (array/map (or (as (object/get @k "items" @emptyHits) IdRefsHits) []) (fn h { rel: (str/concat ".items" (object/get @h "rel")), id: (object/get @h "id"), name: (object/get @h "name") }))
                                (let ((props (or (as (object/get @k "properties" {}) IdRefsHitMap) {}))) (array/flatten (array/map (array/sort (object/keys @props)) (fn key (array/map (object/get @props @key []) (fn h { rel: (str/concat ".properties." @key (object/get @h "rel")), id: (object/get @h "id"), name: (object/get @h "name") }))))))))
                              "IdRefsField") })))))))
                    (fieldPos (array/flatten (array/map @fieldFolds (fn r (let ((res (object/get @r "res"))) (if (= @res null) [] (array/map @res (fn h { id: (object/get @h "id"), exp: "ent_", name: (object/get @h "name"), hasName: true, path: (str/concat (object/get (object/get @r "eb") "base") ".fields[" (object/get @r "fi") "]" (object/get @h "rel") ".relation") }))))))))
                    (trPositions (array/flatten (array/map @slots (fn s
                      (let ((tr (object/get @s "t")) (tp (object/get @s "tp")))
                        (if (object/has @tr "stateMachine")
                          (let ((ems (object/get @tr "emits" [])) (lns (object/get @tr "listens" [])) (erids (object/get @tr "entityRefIds" {})))
                            (array/concat
                              (if (object/has @tr "linkedEntityId") [{ id: (object/get @tr "linkedEntityId"), exp: "ent_", name: (object/get @tr "linkedEntity" ""), hasName: (object/has @tr "linkedEntity"), path: (str/concat @tp ".linkedEntity") }] [])
                              (array/map (object/keys @erids) (fn key { id: (object/get @erids @key), exp: "ent_", name: "", hasName: false, path: (str/concat @tp ".entityRefIds[" @key "]") }))
                              (array/flatten (array/map (array/filter (array/range 0 (array/len @ems)) (fn ei (object/has (array/nth @ems @ei) "eventId"))) (fn ei (let ((em (array/nth @ems @ei))) [{ id: (object/get @em "eventId"), exp: "evt_", name: (object/get @em "event" ""), hasName: (object/has @em "event"), path: (str/concat @tp ".emits[" @ei " (" (object/get @em "event" "") ")]") }]))))
                              (array/flatten (array/map (array/range 0 (array/len @lns)) (fn li
                                (let ((ln (array/nth @lns @li)) (lp (str/concat @tp ".listens[" @li "]")))
                                  (let ((src (object/get @ln "source" {})))
                                    (array/concat
                                      (if (object/has @ln "eventId") [{ id: (object/get @ln "eventId"), exp: "evt_", name: (object/get @ln "event" ""), hasName: (object/has @ln "event"), path: (str/concat @lp ".event") }] [])
                                      (if (object/has @ln "triggersId") [{ id: (object/get @ln "triggersId"), exp: "evt_", name: (object/get @ln "triggers" ""), hasName: (object/has @ln "triggers"), path: (str/concat @lp ".triggers") }] [])
                                      (if (and (= (object/get @src "kind" "") "orbital") (object/has @src "orbitalId")) [{ id: (object/get @src "orbitalId"), exp: "orb_", name: (object/get @src "orbital" ""), hasName: true, path: (str/concat @lp ".source.orbital") }] [])
                                      (if (and (or (= (object/get @src "kind" "") "orbital") (= (object/get @src "kind" "") "trait")) (object/has @src "traitId")) [{ id: (object/get @src "traitId"), exp: "trt_", name: (object/get @src "trait" ""), hasName: true, path: (str/concat @lp ".source.trait") }] [])))))))))
                          (array/concat
                            (if (object/has @tr "refId") [{ id: (object/get @tr "refId"), exp: "trt_", name: (object/get @tr "ref" ""), hasName: (object/has @tr "ref"), path: (str/concat @tp ".ref") }] [])
                            (if (object/has @tr "linkedEntityId") [{ id: (object/get @tr "linkedEntityId"), exp: "ent_", name: (object/get @tr "linkedEntity" ""), hasName: (object/has @tr "linkedEntity"), path: (str/concat @tp ".linkedEntity") }] []))))))))
                    (ledgerTraitKeys (array/filter @sortedKeys (fn key (= (object/get (object/get @ledgerEntries @key) "kind" "") "trait")))))
                (let ((positions (as (array/concat @extendsPos @fieldPos @pagePos @trPositions) IdRefsPositions))
                      (embedSeen (array/flatten (array/map @slots (fn s
                        (let ((tr (object/get @s "t")))
                          (let ((isInline (object/has @tr "stateMachine")) (cfg (let ((c (object/get @tr "config" null))) (if (validate/object @c) (object/values @c) []))))
                            (let ((names (array/flatten (array/concat
                                    (if @isInline (array/map (object/get (object/get @tr "stateMachine" {}) "transitions" []) (fn a (array/map (array/filter (or (as (json/nodes (array/filter (object/get @a "effects" []) (fn r (not (validate/object @r))))) IdRefsForm) []) (fn n (if (validate/string @n) (and (str/startsWith @n (quote "@trait.")) (> (str/len @n) 7)) false))) (fn n (if (validate/string @n) (array/first (str/split (array/first (str/split (str/slice @n 7 (str/len @n)) ".")) "[")) ""))))) [])
                                    (if @isInline (array/map (object/get @tr "ticks" []) (fn tk (array/map (array/filter (or (as (json/nodes (array/filter (object/get @tk "effects" []) (fn r (not (validate/object @r))))) IdRefsForm) []) (fn n (if (validate/string @n) (and (str/startsWith @n (quote "@trait.")) (> (str/len @n) 7)) false))) (fn n (if (validate/string @n) (array/first (str/split (array/first (str/split (str/slice @n 7 (str/len @n)) ".")) "[")) ""))))) [])
                                    (array/map (array/filter @cfg (fn c (object/has @c "default"))) (fn c (array/map (array/filter (or (as (json/nodes (object/get @c "default")) IdRefsForm) []) (fn n (if (validate/string @n) (and (str/startsWith @n (quote "@trait.")) (> (str/len @n) 7)) false))) (fn n (if (validate/string @n) (array/first (str/split (array/first (str/split (str/slice @n 7 (str/len @n)) ".")) "[")) ""))))))))
                                  (embedIdList (if @isInline (object/values (object/get @tr "traitEmbedIds" {})) []))
                                  (embedKeys (if @isInline (object/keys (object/get @tr "traitEmbedIds" {})) [])))
                                (array/concat @embedIdList
                                  (array/map (array/filter (array/map (array/filter @names (fn nm (and (!= @nm "") (not (array/includes @embedKeys @nm))))) (fn nm (array/find @ledgerTraitKeys (fn key (= (object/get (object/get @ledgerEntries @key) "curName" "") @nm))))) (fn key (validate/string @key))) (fn key (object/get (object/get @ledgerEntries @key) "id" ""))))))))))))
                  (let ((seen (array/concat @declared (array/map (or @positions []) (fn p (object/get @p "id"))) @embedSeen))
                        (configHolders (array/filter @ownInline (fn s (array/some (let ((c (object/get (object/get @s "t") "config" null))) (if (validate/object @c) (object/values @c) [])) (fn c (validate/string (object/get @c "default" null))))))))
                    (array/concat
                      (array/flatten (array/map (or @positions []) (fn p
                        (let ((id (object/get @p "id")) (exp (object/get @p "exp")) (nm (object/get @p "name")))
                          (let ((kinds (array/filter ["orb_" "ent_" "trt_" "evt_" "pag_" "svc_" "thm_" "pal_"] (fn k (and (> (str/len @id) (str/len @k)) (str/startsWith @id @k))))))
                            (let ((got (if (> (array/len @kinds) 0) (array/first @kinds) "<unknown>")) (entry (object/get @ledgerEntries @id null)))
                             (let ((cur (if (validate/object @entry) (object/get @entry "curName" "") "")) (parent (if (validate/object @entry) (object/get @entry "parent" "") "")))
                              (array/flatten [
                                (if (= @got @exp) [] [{ code: "ORB_ID_KIND_MISMATCH", path: (object/get @p "path" ""), message: (str/concat "id `" @id "` has kind `" @got "` but this position requires a `" @exp "` id."), suggestion: "", severity: "error" }])
                                (if (or (array/includes @declared @id) (object/has @ledgerEntries @id)) [] [{ code: "ORB_ID_UNKNOWN_REF", path: (object/get @p "path" ""), message: (str/concat "id `" @id "` matches no arena node nor ledger entry."), suggestion: "", severity: "error" }])
                                (if (and (object/get @p "hasName") (not (str/includes @nm ".")) (object/has @ledgerEntries @id) (!= @cur @nm) (not (and (str/startsWith @cur (quote "@config.")) (let ((holder (array/last (array/filter @configHolders (fn s (= (object/get (object/get @s "t") "id" "") @parent)))))) (and (validate/object @holder) (= (object/get (object/get (object/get (object/get @holder "t") "config" {}) (str/slice @cur 8 (str/len @cur)) {}) "default" null) @nm))))))
                                  [{ code: "ORB_ID_NAME_MISMATCH", path: (object/get @p "path" ""), message: (str/concat "name `" @nm "` disagrees with ledger curName `" @cur "` for id `" @id "`."), suggestion: "", severity: "error" }]
                                  [])]))))))))
                      (array/flatten (array/map @sortedKeys (fn key
                        (let ((e (object/get @ledgerEntries @key)))
                          (let ((eid (object/get @e "id" "")) (ekind (object/get @e "kind" "")) (eparent (object/get @e "parent" "")))
                            (if (or (array/includes @seen @eid) (and (= @ekind "event") (!= @eparent "") (array/includes @declTraitIds @eparent)))
                              []
                              [{ code: "ORB_ID_LEDGER_ORPHAN", path: (str/concat "ledger.entries[" @eid "]"), message: (str/concat "ledger row `" @eid "` (kind `" (object/get { orbital: "orb", entity: "ent", trait: "trt", event: "evt", page: "pag", service: "svc", theme: "thm", palette: "pal" } @ekind "") "`, curName `" (object/get @e "curName" "") "`) is carried by no node in the schema — stale."), suggestion: "", severity: "error" }]))))))
                      (array/flatten (array/map @fieldFolds (fn r (let ((res (object/get @r "res"))) (if (= @res null) [{ code: "LINT_NODE_UNCHECKED", path: (str/concat (object/get (object/get @r "eb") "base") ".fields[" (object/get @r "fi") "]"), message: (str/concat @payload.file ": schema node at " (str/concat (object/get (object/get @r "eb") "base") ".fields[" (object/get @r "fi") "]") " is not a IdRefsField; this rule could not check it"), suggestion: "", severity: "error" }] [])))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "id-refs", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : IdRefsProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintIdRefsCli -> OrbLintIdRefsRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint id-refs <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "id-refs") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint id-refs: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "id-refs") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint id-refs: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-id-refs" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint id-refs` with its arguments and working directory."
        @synonyms "orb lint id-refs, id refs"
      OrbLintIdRefs.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintIdRefsCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintIdRefsOrbitalStart -> OrbLintIdRefs, OrbLintIdRefsCli, OrbLintInput, Packs, Versions
}
