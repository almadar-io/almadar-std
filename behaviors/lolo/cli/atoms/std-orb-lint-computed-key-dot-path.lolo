app std-orb-lint-computed-key-dot-path [
  version: "1.0.0",
  inbound: ["cli-lint-computed-key-dot-path"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-computed-key-dot-path - the `orb lint computed-key-dot-path <file>` command. A COMPUTED key of object/get, object/has or object/set is read as ONE whole key; only a literal string key is a dotted path. A key built with str/concat from a string literal containing \".\" was written as a path and now names a single key, so the read misses or the write adds a flat entry. Each such call in a guard, an effect or a tick effect of a trait is an error ORB_COMPUTED_KEY_DOT_PATH at the transition or tick. Literal path keys and keys joined with another separator are clean. Clean answers `lint computed-key-dot-path: clean` (status 200, exit 0); findings fail the run (status 500, exit 1). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-computed-key-dot-path"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type CkVal = string | number | boolean | [CkVal?] | Map string CkVal?
type CkNodes = [CkVal?]
type CkStr = string
type CkCall = { path : string!, node : CkVal!, at : number! }
type CkIdx = Map string [CkCall]
type CkHit = { op : string! }
type CkHits = [CkHit]
type CkField = { name : string, type : string, items : CkVal, properties : CkVal }
type CkEntity = { name : string, fields : [CkField] }
type CkTick = { effects : [CkVal] }
type CkArm = { guard : CkVal, effects : [CkVal] }
type CkMachine = { transitions : [CkArm] }
type CkTrait = { name : string, linkedEntity : string, stateMachine : CkMachine, ticks : [CkTick] }
type CkOrbital = { name : string, entity : CkEntity, auxiliaryEntities : [CkEntity], traits : [CkTrait] }
type CkProgram = { orbitals : [CkOrbital]! }
type CkRoot = { w : string, e : [CkVal] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintComputedKeyDotPathCodes = { computedKeyDotPath : LintCodeDecl }

orbital OrbLintComputedKeyDotPathOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintComputedKeyDotPathRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintComputedKeyDotPath -> OrbLintComputedKeyDotPathRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbs (object/get @payload.program "orbitals" [])))
 (array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
  (let ((o (default (array/nth @orbs @oi) {})))
   (let ((trs (object/get @o "traits" [])))
    (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
     (let ((t (default (array/nth @trs @ti) {})))
      (let ((trans (object/get (object/get @t "stateMachine" {}) "transitions" []))
            (ticks (object/get @t "ticks" []))
            (base (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]")))
       (let ((roots (array/concat
                     (array/map (array/range 0 (array/len @trans)) (fn ni
                       (let ((tr (default (array/nth @trans @ni) {})))
                         { w: (str/concat @base ".stateMachine.transitions[" @ni "]"), e: (array/concat (if (object/has @tr "guard") [(object/get @tr "guard")] []) (object/get @tr "effects" [])) })))
                     (array/map (array/range 0 (array/len @ticks)) (fn ki { w: (str/concat @base ".ticks[" @ki "]"), e: (object/get (default (array/nth @ticks @ki) {}) "effects" []) })))))
        (if (= (array/len @roots) 0) []
         (array/flatten (array/map @roots (fn x
          (let ((hits (default (as (array/flatten (array/map (array/sort (array/flatten (object/values (default (as (tree/index (object/get @x "e") ["object/set" "object/get" "object/has"]) CkIdx) {}))) "at") (fn c
                  (let ((l (default (as (object/get @c "node" []) CkNodes) [])))
                   (let ((h (if (> (array/len @l) 0) (default (as (array/nth @l 0) CkStr) "") ""))
                         (a2 (if (> (array/len @l) 2) (array/nth @l 2) null)))
                    (if (and (validate/array @a2)
                          (= (tree/fold @a2 (fn (n2 k2)
                               (if (validate/array @n2)
                                (let ((hd (if (> (array/len @n2) 0) (default (as (array/nth @n2 0) CkStr) "") "")))
                                 (if (= @hd "str/concat")
                                  (array/some (array/slice @n2 1 (array/len @n2)) (fn s (and (validate/string @s) (not (str/startsWith @s (quote "@"))) (str/includes @s "."))))
                                  (if (= @hd "let")
                                   (= (array/last @k2) true)
                                   (if (and (= @hd "if") (= (array/len @n2) 4))
                                    (or (= (array/nth @k2 2) true) (= (array/nth @k2 3) true))
                                    false))))
                                false)) CkVal) true))
                      [{ op: @h }]
                      [])))))) CkHits) [])))
           (array/map @hits (fn h { code: @config.codes.computedKeyDotPath.code, path: (object/get @x "w"), message: (str/concat (object/get @h "op") " reads a computed key as one whole key, so the key built with str/concat from a literal containing \".\" names a single key and never a path"), suggestion: "Pass the path as a string literal (only a literal key is a dotted path), or join the key parts with a separator other than \".\", such as \"|\".", severity: "error" }))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "computed-key-dot-path", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CkProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintComputedKeyDotPathCodes = { computedKeyDotPath: { code: "ORB_COMPUTED_KEY_DOT_PATH", category: "lint", description: "object/set, object/get or object/has on a Map field with a str/concat key containing a literal dot: the key is read as a dot path, so the value nests instead of being one map entry" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintComputedKeyDotPathCli -> OrbLintComputedKeyDotPathRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint computed-key-dot-path: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint computed-key-dot-path <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint computed-key-dot-path <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "computed-key-dot-path") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint computed-key-dot-path: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "computed-key-dot-path") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint computed-key-dot-path: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-computed-key-dot-path" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint computed-key-dot-path` with its arguments and working directory."
        @synonyms "orb lint computed-key-dot-path, dot path key, map key"
      OrbLintComputedKeyDotPath.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintComputedKeyDotPathCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintComputedKeyDotPathOrbitalStart -> OrbLintComputedKeyDotPath, OrbLintComputedKeyDotPathCli, OrbLintInput, Packs, Versions
}
