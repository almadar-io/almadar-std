app std-orb-complete [
  version: "1.0.0",
  inbound: ["cli-complete"],
  fs: { cwd: "**": [read], "/**": [read] },
  description: "std-orb-complete — the `orb complete <file.lolo> --offset <n>` command (spec/cli/orb-complete.lolo; port of orbital-lolo complete.rs). It answers one compact JSON line { candidates, context, prefix } (keys in alphabetical order). Offsets count characters, which equals the Rust byte offset for ASCII sources. Served from the source and the installed @almadar/core language tables, found through its package.json orbLanguage block (vocabulary: effects and types; patterns: tags and props): modifier-key and modifier-value (app and page brackets), trait-ref, orbital-ref, config-key, entity-field, trait-embed, pattern-tag, pattern-prop, effect, field-type and keyword. trait-ref, orbital-ref and config-key read the behavior a `uses` line names through behavior/describe. Import-path completion walks every installed package's `orb.source` tree (behavior/packages, each package.json, os/list-dir) and offers the `.lolo` file stems as Rust does; it needs each tree inside the working directory (G-STD-096 item 4). A `pages {}` remap-entry bracket offers the remap keys. --stdin answers status 400 (G-STD-094). The statement-keyword and modifier-key tables are literals here because they are Rust constants of the parser, not installed data (G-STD-096)."
]
uses Spec from "almadar-std/orb-complete"
uses Args from "std/behaviors/std-args"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type CoreManifest = { orbLanguage : LanguageBlock? }
type LanguageBlock = { patterns : string?, vocabulary : string? }
type Vocabulary = { effects : [string]!, types : [string]! }
type PatternDef = { propsSchema : Map string PatternProp? }
type PatternProp = { type : string? }
type PatternProps = Map string PatternProp
type PatternsRegistry = { patterns : Map string PatternDef! }
type PatternRow = { pattern : string!, tag : string!, props : [string]! }
type Cand = { label : string!, kind : string!, detail : string? }
type DescKnob = { type : string? }
type DescTrait = { trait : string?, config : Map string DescKnob? }
type DescValue = { orbital : string? }
type DescOrbital = { value : DescValue?, config : Map string DescKnob?, traits : [DescTrait]? }
type DescConfig = Map string DescKnob
type Described = { orbitals : [DescOrbital]? }
type CompletePackage = { root : string!, prefix : string!, vectors : string? }
type CompletePackageManifest = { orb : CompletePackageOrb? }
type CompletePackageOrb = { source : string? }
type CompleteEntry = { name : string!, kind : string! }
type CompleteTree = { dir : string!, pre : string! }
type BraceScan = { s : boolean!, i : number!, st : [number]! }
type Scan = { i : number!, s : boolean!, st : [number]!, k : [number]! }

orbital OrbCompleteOrbital {
  entity CompleteRun [runtime] {
    id : string!
    cwd : string = ""
    file : string = ""
    offset : number = 0
    source : string = ""
    vocabularyPath : string = ""
    patternsPath : string = ""
    effects : [string] = []
    types : [string] = []
    rows : [PatternRow] = []
    before : string = ""
    line : string = ""
    word : string = ""
    lead : string = ""
    inside : string = ""
    header : string = ""
    entry : string = ""
    scan : Scan = { i: 0, s: false, st: [], k: [] }
    fImport : boolean = false
    fMod : string = ""
    fSuffix : boolean = false
    fTag : boolean = false
    fProp : boolean = false
    fConfig : boolean = false
    fEffect : boolean = false
    fType : boolean = false
    fStart : boolean = false
    alias : string = ""
    behavior : string = ""
    member : string = ""
    name : string = ""
    target : string = ""
    ctx : string = ""
    cands : [Cand] = []
    packages : [CompletePackage] = []
    pcursor : number = 0
    trees : [CompleteTree] = []
    dcursor : number = 0
    imports : [Cand] = []
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbComplete.COMPLETE_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbComplete -> CompleteRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      COMPLETE_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit COMPLETE_ANSWERED { status: 400, body: "usage: orb complete <file.lolo> --offset <n>" })
      COMPLETE_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (emit COMPLETE_ARGS_PARSE { stage: "complete" argv: (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") flags: [{ name: "offset" aliases: [] takesValue: true repeatable: false }, { name: "stdin" aliases: [] takesValue: false repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      COMPLETE_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (and (= (array/len @payload.positionals) 0) (not (object/has @payload.flags "stdin"))) (> (array/len @payload.positionals) 1) (not (object/has @payload.flags "offset")) (= (str/to-int (default (array/first (default (object/get @payload.flags "offset") [])) "")) null))
        (emit COMPLETE_ANSWERED { status: 400, body: "usage: orb complete <file.lolo> --offset <n>" })
      COMPLETE_ARGS_DONE -> ready when (and (= (array/len @payload.errors) 0) (object/has @payload.flags "stdin"))
        (emit COMPLETE_ANSWERED { status: 400, body: "orb complete --stdin is pending (G-STD-094)" })
      COMPLETE_ARGS_DONE -> working when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1) (not (object/has @payload.flags "stdin")) (object/has @payload.flags "offset") (!= (str/to-int (default (array/first (default (object/get @payload.flags "offset") [])) "")) null))
        (emit COMPLETE_START { file: (default (array/nth @payload.positionals 0) ""), offset: (str/to-int (default (array/first (default (object/get @payload.flags "offset") [])) "")), cwd: @entity.cwd })
    }

    state working {
      INIT -> working
      COMPLETE_DONE -> ready
        (emit COMPLETE_ANSWERED { status: @payload.status, body: @payload.body })
    }

    emits {
      COMPLETE_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      COMPLETE_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words."
        @tier "internal"
      COMPLETE_START {
        file : string!
        offset : number!
        cwd : string!
      }
        @description "Internal: complete at the offset of the file."
        @tier "internal"
    }

    listens {
      COMPLETE_CALLED -> inbound "cli-complete" answers COMPLETE_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb complete`."
        @synonyms "orb complete, what is valid at a cursor offset in a lolo file"
      COMPLETE_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED."
      ArgsCli.ARGS_PARSED -> COMPLETE_ARGS_DONE
      CompleteEngine.COMPLETE_ANSWERED -> COMPLETE_DONE
      COMPLETE_DONE { status : number!  body : string! }
        @description "Internal: the engine's answer, relayed to the hook by its handler."
        @tier "internal"
    }
  }

  trait CompleteEngine -> CompleteRun [optimistic] {
    initial: idle

    state idle {
      INIT -> idle
      COMPLETE_START -> loading when (not (os/path-is-absolute @payload.file))
        (set @entity.file @payload.file)
        (set @entity.offset @payload.offset)
        (set @entity.cwd @payload.cwd)
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "source" emit: { success: COMPLETE_SOURCE, failure: COMPLETE_FAILED } })
      COMPLETE_START -> loading when (os/path-is-absolute @payload.file)
        (set @entity.file @payload.file)
        (set @entity.offset @payload.offset)
        (set @entity.cwd @payload.cwd)
        (os/read-file (str/concat "/" (str/slice @payload.file 1 (str/len @payload.file))) { key: "source" emit: { success: COMPLETE_SOURCE, failure: COMPLETE_FAILED } })
    }

    state loading {
      INIT -> loading
      COMPLETE_FAILED -> idle
        (emit COMPLETE_ANSWERED { status: 500, body: (str/concat "orb complete: " (default @payload.error "")) })
      COMPLETE_SOURCE -> loading when (= (bytes/to-string @payload.data) null)
        (emit COMPLETE_FAILED { error: "the source file is not valid text" })
      COMPLETE_SOURCE -> loading when (!= (bytes/to-string @payload.data) null)
        (set @entity.source (let ((text (bytes/to-string @payload.data))) (if (= @text null) @entity.source @text)))
        (os/read-file { anchor: "cwd" path: "node_modules/@almadar/core/package.json" } { key: "manifest" emit: { success: COMPLETE_MANIFEST, failure: COMPLETE_FAILED } })
      COMPLETE_MANIFEST -> loading when (= (bytes/to-string @payload.data) null)
        (emit COMPLETE_FAILED { error: "the installed @almadar/core package.json is not valid text" })
      COMPLETE_MANIFEST -> idle when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (or (= (json/parse @text CoreManifest) null) (= (object/get (json/parse @text CoreManifest) "orbLanguage") null) (= (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "vocabulary") null) (= (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "patterns") null))))
        (emit COMPLETE_ANSWERED { status: 500, body: "orb complete: the installed @almadar/core declares no orbLanguage vocabulary and patterns" })
      COMPLETE_MANIFEST -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text CoreManifest) null) (!= (object/get (json/parse @text CoreManifest) "orbLanguage") null) (!= (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "vocabulary") null) (!= (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "patterns") null)))
        (set @entity.vocabularyPath (let ((text (bytes/to-string @payload.data))) (if (= @text null) @entity.vocabularyPath (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "vocabulary"))))
        (set @entity.patternsPath (let ((text (bytes/to-string @payload.data))) (if (= @text null) @entity.patternsPath (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "patterns"))))
        (let ((text (bytes/to-string @payload.data))) (if (= @text null) (emit COMPLETE_FAILED { error: "the installed @almadar/core package.json is not valid text" }) (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/core/" (object/get (object/get (json/parse @text CoreManifest) "orbLanguage") "vocabulary")) } { key: "vocabulary" emit: { success: COMPLETE_VOCABULARY, failure: COMPLETE_FAILED } })))
      COMPLETE_VOCABULARY -> loading when (= (bytes/to-string @payload.data) null)
        (emit COMPLETE_FAILED { error: "the installed @almadar/core vocabulary is not valid text" })
      COMPLETE_VOCABULARY -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (= (json/parse @text Vocabulary) null)))
        (emit COMPLETE_FAILED { error: "the installed @almadar/core vocabulary is not a vocabulary" })
      COMPLETE_VOCABULARY -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text Vocabulary) null)))
        (set @entity.effects (let ((text (bytes/to-string @payload.data))) (if (= @text null) @entity.effects (object/get (json/parse @text Vocabulary) "effects"))))
        (set @entity.types (let ((text (bytes/to-string @payload.data))) (if (= @text null) @entity.types (object/get (json/parse @text Vocabulary) "types"))))
        (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/core/" @entity.patternsPath) } { key: "patterns" emit: { success: COMPLETE_PATTERNS, failure: COMPLETE_FAILED } })
      COMPLETE_PATTERNS -> loading when (= (bytes/to-string @payload.data) null)
        (emit COMPLETE_FAILED { error: "the installed @almadar/core patterns registry is not valid text" })
      COMPLETE_PATTERNS -> loading when (!= (bytes/to-string @payload.data) null)
        (let ((text (bytes/to-string @payload.data))) (if (= @text null) (emit COMPLETE_FAILED { error: "the installed @almadar/core patterns registry is not valid text" }) (let ((reg (json/parse @text PatternsRegistry))) (if (= @reg null) (emit COMPLETE_FAILED { error: "the installed @almadar/core patterns registry is not a patterns registry" }) (emit COMPLETE_RUN { source: @entity.source, offset: @entity.offset, effects: @entity.effects, types: @entity.types, rows: (let ((pats (object/get @reg "patterns"))) (array/map (object/keys @pats) (fn p { pattern: @p, tag: (str/join (array/map (str/split @p "-") (fn s (str/concat (str/upper (str/slice @s 0 1)) (str/slice @s 1 (str/len @s))))) ""), props: (object/keys (default (object/get (object/get @pats @p) "propsSchema") {})) }))) })))))
      COMPLETE_RUN -> loading
        (set @entity.source @payload.source)
        (set @entity.offset @payload.offset)
        (set @entity.effects @payload.effects)
        (set @entity.types @payload.types)
        (set @entity.rows @payload.rows)
        (set @entity.before (str/slice @payload.source 0 (math/min @payload.offset (str/len @payload.source))))
        (set @entity.line (default (array/last (str/split @entity.before "\n")) ""))
        (set @entity.word (default (object/get (array/reduce (array/reverse (str/split @entity.before "")) { done: false, acc: "" } (fn a c (if (or (object/get @a "done") (not (str/includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" @c))) { done: true, acc: (object/get @a "acc") } { done: false, acc: (str/concat @c (object/get @a "acc")) }))) "acc") ""))
        (set @entity.lead (str/slice @entity.before 0 (- (str/len @entity.before) (str/len @entity.word))))
        (set @entity.scan (let ((init : Scan { i: 0, s: false, st: [], k: [] })) (array/reduce (str/split @entity.before "") @init (fn a c (if (= @c "\"") { i: (+ (object/get @a "i") 1), s: (not (object/get @a "s")), st: (object/get @a "st"), k: (object/get @a "k") } (if (and (not (object/get @a "s")) (= @c "[")) { i: (+ (object/get @a "i") 1), s: false, st: (object/get @a "st"), k: (array/append (object/get @a "k") (object/get @a "i")) } (if (and (not (object/get @a "s")) (= @c "]")) { i: (+ (object/get @a "i") 1), s: false, st: (object/get @a "st"), k: (array/dropLast (object/get @a "k") 1) } (if (and (not (object/get @a "s")) (= @c "{")) { i: (+ (object/get @a "i") 1), s: false, st: (array/append (object/get @a "st") (object/get @a "i")), k: (object/get @a "k") } (if (and (not (object/get @a "s")) (= @c "}")) { i: (+ (object/get @a "i") 1), s: false, st: (array/dropLast (object/get @a "st") 1), k: (object/get @a "k") } { i: (+ (object/get @a "i") 1), s: (object/get @a "s"), st: (object/get @a "st"), k: (object/get @a "k") })))))))))
        (set @entity.inside (default (array/last (str/split @entity.before "<")) ""))
        (set @entity.header (if (= (array/len (object/get @entity.scan "st")) 0) "" (str/trim (default (array/last (str/split (str/slice @entity.before 0 (default (array/last (object/get @entity.scan "st")) 0)) "\n")) ""))))
        (set @entity.entry (if (= (array/len (object/get @entity.scan "k")) 0) "" (str/trim (default (array/last (str/split (str/replaceAll (str/slice @entity.lead (+ (default (array/first (object/get @entity.scan "k")) 0) 1) (str/len @entity.lead)) "," "\n") "\n")) ""))))
        (set @entity.fImport (and (> (array/len (str/split @entity.line "\"")) 1) (let ((w (str/split (str/trim (str/join (array/dropLast (str/split @entity.line "\"") 1) "\"")) " "))) (and (= (array/len @w) 3) (= (default (array/nth @w 0) "") "uses") (= (default (array/nth @w 2) "") "from")))))
        (set @entity.fMod (if (= (array/len (object/get @entity.scan "k")) 0) "" (let ((bracket (default (array/first (object/get @entity.scan "k")) 0))) (let ((head (str/slice @entity.before 0 @bracket)) (hw (default (array/first (str/split (str/trim (default (array/last (str/split (str/slice @entity.before 0 @bracket) "\n")) "")) " ")) ""))) (if (or (= @hw "app") (= @hw "page")) @hw (let ((braces (object/get (let ((init : BraceScan { s: false, i: 0, st: [] })) (array/reduce (str/split @head "") @init (fn a c (if (= @c "\"") { s: (not (object/get @a "s")), i: (+ (object/get @a "i") 1), st: (object/get @a "st") } (if (and (not (object/get @a "s")) (= @c "{")) { s: false, i: (+ (object/get @a "i") 1), st: (array/append (object/get @a "st") (object/get @a "i")) } (if (and (not (object/get @a "s")) (= @c "}")) { s: false, i: (+ (object/get @a "i") 1), st: (array/dropLast (object/get @a "st") 1) } { s: (object/get @a "s"), i: (+ (object/get @a "i") 1), st: (object/get @a "st") })))))) "st"))) (if (and (> (array/len @braces) 0) (= (str/trim (default (array/last (str/split (str/slice @head 0 (default (array/last @braces) 0)) "\n")) "")) "pages") (str/startsWith (str/trimStart (str/slice @head (math/max (+ (default (array/last @braces) 0) 1) (- (str/len @head) (str/len (default (array/last (str/split @head "\n")) "")))) (str/len @head))) "\"")) "remap" "")))))))
        (set @entity.fSuffix (or (str/endsWith @entity.lead ".traits.") (str/endsWith @entity.lead ".orbitals.")))
        (set @entity.fTag (and (> (array/len (str/split @entity.before "<")) 1) (not (str/includes @entity.inside ">")) (not (str/startsWith @entity.inside "/")) (not (str/startsWith @entity.inside "trait.")) (not (or (str/includes @entity.inside " ") (str/includes @entity.inside "\n") (str/includes @entity.inside "\t")))))
        (set @entity.fProp (and (> (array/len (str/split @entity.before "<")) 1) (not (str/includes @entity.inside ">")) (not (str/startsWith @entity.inside "/")) (not (str/startsWith @entity.inside "trait.")) (or (str/includes @entity.inside " ") (str/includes @entity.inside "\n") (str/includes @entity.inside "\t")) (array/some @entity.rows (fn r (= (object/get @r "tag") (default (array/first (str/split (str/trim @entity.inside) " ")) "")))) (not (or (str/endsWith (str/trimEnd @entity.lead) "=") (> (- (array/len (str/split @entity.inside "{")) 1) (- (array/len (str/split @entity.inside "}")) 1))))))
        (set @entity.fConfig (and (>= (array/len (object/get @entity.scan "st")) 2) (not (str/includes @entity.line ":")) (str/endsWith @entity.header "config")))
        (set @entity.fEffect (str/endsWith (str/trimEnd @entity.lead) "("))
        (set @entity.fType (and (> (array/len (object/get @entity.scan "st")) 0) (str/startsWith @entity.header "entity ") (str/endsWith (str/trimEnd (str/trimStart (str/slice @entity.line 0 (- (str/len @entity.line) (str/len @entity.word))))) ":") (!= (str/trim (str/slice (str/trimEnd (str/trimStart (str/slice @entity.line 0 (- (str/len @entity.line) (str/len @entity.word))))) 0 (- (str/len (str/trimEnd (str/trimStart (str/slice @entity.line 0 (- (str/len @entity.line) (str/len @entity.word)))))) 1))) "") (array/every (str/split (str/trim (str/slice (str/trimEnd (str/trimStart (str/slice @entity.line 0 (- (str/len @entity.line) (str/len @entity.word))))) 0 (- (str/len (str/trimEnd (str/trimStart (str/slice @entity.line 0 (- (str/len @entity.line) (str/len @entity.word)))))) 1))) "") (fn c (str/includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" @c)))))
        (set @entity.fStart (and (or (= @entity.header "") (array/includes ["orbital", "trait", "entity"] (default (array/first (str/split @entity.header " ")) ""))) (or (= (str/trim @entity.lead) "") (= (str/trim (str/trimStart (str/slice @entity.line 0 (- (str/len @entity.line) (str/len @entity.word))))) ""))))
        (set @entity.target (if (and @entity.fConfig (str/includes (str/trim (default (array/last (str/split (str/slice @entity.before 0 (default (array/nth (object/get @entity.scan "st") (- (array/len (object/get @entity.scan "st")) 2)) 0)) "\n")) "")) "=")) (str/trim (default (array/nth (str/split (str/trim (default (array/last (str/split (str/slice @entity.before 0 (default (array/nth (object/get @entity.scan "st") (- (array/len (object/get @entity.scan "st")) 2)) 0)) "\n")) "")) "=") 1) "")) ""))
        (set @entity.member (if @entity.fSuffix (if (str/endsWith @entity.lead ".traits.") "traits" "orbitals") (if (>= (array/len (str/split @entity.target ".")) 3) (str/trim (default (array/nth (str/split @entity.target ".") 1) "")) "")))
        (set @entity.alias (if @entity.fSuffix (default (object/get (array/reduce (array/reverse (str/split (str/slice @entity.lead 0 (- (str/len @entity.lead) (if (= @entity.member "traits") 8 10))) "")) { done: false, acc: "" } (fn a c (if (or (object/get @a "done") (not (str/includes "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" @c))) { done: true, acc: (object/get @a "acc") } { done: false, acc: (str/concat @c (object/get @a "acc")) }))) "acc") "") (if (>= (array/len (str/split @entity.target ".")) 3) (str/trim (default (array/first (str/split @entity.target ".")) "")) "")))
        (set @entity.name (if (>= (array/len (str/split @entity.target ".")) 3) (default (array/first (str/split (str/trim (default (array/nth (str/split @entity.target ".") 2) "")) " ")) "") ""))
        (set @entity.behavior (let ((w (array/find (array/map (str/split @entity.source "\n") (fn l (str/split (str/trim @l) " "))) (fn w (and (>= (array/len @w) 4) (= (default (array/nth @w 0) "") "uses") (= (default (array/nth @w 1) "") @entity.alias)))))) (if (or (= @w null) (= @entity.alias "")) "" (str/replaceAll (str/replaceAll (default (array/nth @w 3) "") "\"" "") "{" ""))))
        (set @entity.ctx (if @entity.fImport "import-path" (if (!= @entity.fMod "") "modifier" (if @entity.fSuffix (if (str/endsWith @entity.lead ".traits.") "trait-ref" "orbital-ref") (if (str/endsWith @entity.lead (quote "@entity.")) "entity-field" (if (str/endsWith @entity.lead "<trait.") "trait-embed" (if @entity.fTag "pattern-tag" (if @entity.fProp "pattern-prop" (if @entity.fConfig "config-key" (if @entity.fEffect "effect" (if @entity.fType "field-type" (if @entity.fStart "keyword" "none"))))))))))) )
        (set @entity.cands (if (= @entity.ctx "modifier") (if (= @entity.entry "") (array/map (array/filter (if (= @entity.fMod "app") ["version", "description", "theme", "themes", "locales", "egress", "inbound", "store", "fs", "exec", "net", "env", "stdio", "sys", "desktop", "kv", "deployment", "public", "origin", "icon", "siteName", "signIn"] (if (= @entity.fMod "remap") ["access", "indexing", "title", "description", "translationOf", "label", "icon", "roles"] ["view", "entity", "initial", "access", "indexing", "title", "description", "translationOf"])) (fn k (not (str/includes (str/slice @entity.before (+ (default (array/first (object/get @entity.scan "k")) 0) 1) (str/len @entity.before)) (str/concat @k ":"))))) (fn k { label: @k kind: "keyword" })) (let ((e (str/trim (if (str/endsWith @entity.entry ":") (str/slice @entity.entry 0 (- (str/len @entity.entry) 1)) @entity.entry)))) (array/map (if (= @e "access") ["public", "authenticated"] (if (= @e "indexing") ["index", "noindex"] [])) (fn k { label: @k kind: "keyword" })))) (if (= @entity.ctx "entity-field") (if (and (str/includes @entity.before "orbital ") (str/includes (str/concat "orbital " (default (array/last (str/split @entity.before "orbital ")) "") (str/slice @entity.source @entity.offset (str/len @entity.source))) "entity ") (str/includes (default (array/nth (str/split (str/concat "orbital " (default (array/last (str/split @entity.before "orbital ")) "") (str/slice @entity.source @entity.offset (str/len @entity.source))) (if (str/includes (str/concat "orbital " (default (array/last (str/split @entity.before "orbital ")) "") (str/slice @entity.source @entity.offset (str/len @entity.source))) "\n  entity ") "\n  entity " "entity ")) 1) "") "{")) (array/map (array/filter (array/map (str/split (default (array/first (str/split (str/join (array/drop (str/split (default (array/nth (str/split (str/concat "orbital " (default (array/last (str/split @entity.before "orbital ")) "") (str/slice @entity.source @entity.of