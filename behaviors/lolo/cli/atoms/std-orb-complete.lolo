ray/map @entity.effects (fn e { label: @e kind: "operator" })) (if (= @entity.ctx "field-type") (array/map @entity.types (fn e { label: @e kind: "keyword" detail: "type" })) (if (= @entity.ctx "keyword") (array/map (if (or (= @entity.header "") false) ["app", "type", "uses", "orbital", "theme", "config"] (let ((w (str/split @entity.header " "))) (if (= (array/first @w) "orbital") (if (= (default (array/nth @w 2) "") "=") ["entity", "entities", "fields", "roles", "events", "pages", "omit", "only", "config", "extend", "retype", "mock", "traits", "listens", "trait"] ["uses", "expects", "type", "entity", "trait", "page", "theme", "config"]) (if (= (array/first @w) "trait") (if (= (default (array/nth @w 2) "") "=") ["events", "fields", "config", "on", "name", "listens", "emitsScope"] ["initial", "state", "emits", "listens", "ticks", "config"]) (if (= (array/first @w) "entity") ["derived"] []))))) (fn k { label: @k kind: "keyword" })) [])))))))))
        (set @entity.word (if @entity.fImport (default (array/last (str/split @entity.line "\"")) "") @entity.word))
        (emit COMPLETE_STAGE { behavior: @entity.behavior member: @entity.member name: @entity.name context: (if (= @entity.ctx "modifier") (if (= @entity.entry "") "modifier-key" "modifier-value") @entity.ctx) prefix: @entity.word candidates: (array/sort (array/reduce (array/filter @entity.cands (fn c (str/startsWith (str/lower (object/get @c "label")) (str/lower @entity.word)))) [] (fn a c (if (array/some @a (fn x (= (object/get @x "label") (object/get @c "label")))) @a (array/append @a @c)))) "label" "asc") })
      COMPLETE_STAGE -> loading when (and (array/includes ["trait-ref", "orbital-ref", "config-key"] @payload.context) (!= @payload.behavior ""))
        (behavior/describe { behavior: @payload.behavior } { key: "describe" emit: { success: COMPLETE_DESCRIBED, failure: COMPLETE_DESCRIBE_FAILED } })
      COMPLETE_STAGE -> loading when (and (array/includes ["trait-ref", "orbital-ref", "config-key"] @payload.context) (= @payload.behavior ""))
        (emit COMPLETE_CTX { context: "none", prefix: @payload.prefix, candidates: [] })
      COMPLETE_STAGE -> loading when (= @payload.context "import-path")
        (set @entity.packages [])
        (set @entity.pcursor 0)
        (set @entity.trees [])
        (set @entity.dcursor 0)
        (set @entity.imports [])
        (behavior/packages { key: "packages" emit: { success: COMPLETE_PACKAGES, failure: COMPLETE_FAILED } })
      COMPLETE_STAGE -> loading when (not (array/includes ["trait-ref", "orbital-ref", "config-key", "import-path"] @payload.context))
        (emit COMPLETE_CTX { context: @payload.context, prefix: @payload.prefix, candidates: @payload.candidates })
      COMPLETE_DESCRIBE_FAILED -> loading
        (emit COMPLETE_CTX { context: "none", prefix: @entity.word, candidates: [] })
      COMPLETE_DESCRIBED -> loading
        (let ((nv : DescValue {}) (nd : DescOrbital {}) (nt : DescTrait {}) (ec : DescConfig {})) (emit COMPLETE_CTX { context: @entity.ctx, prefix: @entity.word, candidates: (array/sort (array/reduce (array/filter (if (= @entity.ctx "trait-ref") (array/map (array/flatten (array/map (default (object/get @payload.result "orbitals") []) (fn o (array/map (default (object/get @o "traits") []) (fn t @t))))) (fn t { label: (object/get @t "trait" ""), kind: "trait", detail: @entity.alias })) (if (= @entity.ctx "orbital-ref") (array/map (default (object/get @payload.result "orbitals") []) (fn o { label: (object/get (default (object/get @o "value") @nv) "orbital" ""), kind: "orbital", detail: @entity.alias })) (if (= @entity.member "traits") (array/map (object/keys (default (object/get (default (array/find (array/flatten (array/map (default (object/get @payload.result "orbitals") []) (fn o (array/map (default (object/get @o "traits") []) (fn t @t))))) (fn t (= (object/get @t "trait") @entity.name))) @nt) "config") @ec)) (fn k { label: @k, kind: "config-key", detail: (object/get (object/get (default (object/get (default (array/find (array/flatten (array/map (default (object/get @payload.result "orbitals") []) (fn o (array/map (default (object/get @o "traits") []) (fn t @t))))) (fn t (= (object/get @t "trait") @entity.name))) @nt) "config") @ec) @k) "type") })) (if (= @entity.member "orbitals") (array/map (object/keys (default (object/get (default (array/find (default (object/get @payload.result "orbitals") []) (fn o (= (object/get (default (object/get @o "value") @nv) "orbital") @entity.name))) @nd) "config") @ec)) (fn k { label: @k, kind: "config-key", detail: (object/get (object/get (default (object/get (default (array/find (default (object/get @payload.result "orbitals") []) (fn o (= (object/get (default (object/get @o "value") @nv) "orbital") @entity.name))) @nd) "config") @ec) @k) "type") })) [])))) (fn c (str/startsWith (str/lower (object/get @c "label")) (str/lower @entity.word)))) [] (fn a c (if (array/some @a (fn x (= (object/get @x "label") (object/get @c "label")))) @a (array/append @a @c)))) "label" "asc") }))
      COMPLETE_PACKAGES -> loading
        (set @entity.packages @payload.result)
        (emit COMPLETE_PKG_NEXT { })
      COMPLETE_PKG_NEXT -> loading when (and (< @entity.pcursor (array/len @entity.packages)) (!= (array/nth @entity.packages @entity.pcursor) null))
        (os/read-file { anchor: "cwd" path: (os/path-join (os/path-relative @entity.cwd (object/get (array/nth @entity.packages @entity.pcursor) "root")) "package.json") } { key: "pkgmanifest" emit: { success: COMPLETE_PKG_MANIFEST, failure: COMPLETE_FAILED } })
      COMPLETE_PKG_NEXT -> loading when (and (< @entity.pcursor (array/len @entity.packages)) (= (array/nth @entity.packages @entity.pcursor) null))
        (emit COMPLETE_FAILED { error: "the package cursor points at no package" })
      COMPLETE_PKG_NEXT -> loading when (and (>= @entity.pcursor (array/len @entity.packages)) (array/some @entity.packages (fn p (= (object/get @p "prefix") "almadar-std"))))
        (emit COMPLETE_DIR_NEXT { })
      COMPLETE_PKG_NEXT -> loading when (and (>= @entity.pcursor (array/len @entity.packages)) (not (array/some @entity.packages (fn p (= (object/get @p "prefix") "almadar-std")))))
        (emit COMPLETE_CTX { context: "none", prefix: @entity.word, candidates: [] })
      COMPLETE_PKG_MANIFEST -> loading when (= (bytes/to-string @payload.data) null)
        (emit COMPLETE_FAILED { error: "a package manifest is not valid text" })
      COMPLETE_PKG_MANIFEST -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (= (json/parse @text CompletePackageManifest) null)))
        (emit COMPLETE_FAILED { error: "a package manifest is not a package manifest" })
      COMPLETE_PKG_MANIFEST -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text CompletePackageManifest) null) (= (object/get (json/parse @text CompletePackageManifest) "orb.source" "") "")))
        (emit COMPLETE_CTX { context: "none", prefix: @entity.word, candidates: [] })
      COMPLETE_PKG_MANIFEST -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text CompletePackageManifest) null) (!= (object/get (json/parse @text CompletePackageManifest) "orb.source" "") "") (!= (array/nth @entity.packages @entity.pcursor) null)))
        (set @entity.trees (let ((text (bytes/to-string @payload.data))) (if (= @text null) @entity.trees (array/append @entity.trees { dir: (os/path-join (os/path-relative @entity.cwd (object/get (array/nth @entity.packages @entity.pcursor) "root")) (object/get (json/parse @text CompletePackageManifest) "orb.source" "")), pre: (if (= (object/get (array/nth @entity.packages @entity.pcursor) "prefix") "almadar-std") "std/behaviors/" (str/concat (object/get (array/nth @entity.packages @entity.pcursor) "prefix") "/")) }))))
        (set @entity.pcursor (+ @entity.pcursor 1))
        (emit COMPLETE_PKG_NEXT { })
      COMPLETE_PKG_MANIFEST -> loading when (let ((text (bytes/to-string @payload.data))) (and (!= @text null) (!= (json/parse @text CompletePackageManifest) null) (!= (object/get (json/parse @text CompletePackageManifest) "orb.source" "") "") (= (array/nth @entity.packages @entity.pcursor) null)))
        (emit COMPLETE_FAILED { error: "the package cursor points at no package" })
      COMPLETE_DIR_NEXT -> loading when (and (< @entity.dcursor (array/len @entity.trees)) (!= (array/nth @entity.trees @entity.dcursor) null))
        (os/list-dir { anchor: "cwd" path: (object/get (array/nth @entity.trees @entity.dcursor) "dir") } { key: "dir" emit: { success: COMPLETE_DIR_LISTED, failure: COMPLETE_FAILED } })
      COMPLETE_DIR_NEXT -> loading when (and (< @entity.dcursor (array/len @entity.trees)) (= (array/nth @entity.trees @entity.dcursor) null))
        (emit COMPLETE_FAILED { error: "the directory cursor points at no directory" })
      COMPLETE_DIR_NEXT -> loading when (>= @entity.dcursor (array/len @entity.trees))
        (emit COMPLETE_CTX { context: "import-path", prefix: @entity.word, candidates: (let ((none : [Cand] [])) (array/reduce (array/sort @entity.imports "label" "asc") @none (fn a c (if (and (> (array/len @a) 0) (= (object/get (array/last @a) "label") (object/get @c "label"))) @a (array/append @a @c))))) })
      COMPLETE_DIR_LISTED -> loading when (!= (array/nth @entity.trees @entity.dcursor) null)
        (set @entity.imports (let ((added : [Cand] (array/filter (array/map (array/filter @payload.entries (fn e (and (= (object/get @e "kind") "file") (str/endsWith (object/get @e "name") ".lolo") (> (str/len (object/get @e "name")) 5)))) (fn e { label: (str/concat (object/get (array/nth @entity.trees @entity.dcursor) "pre") (str/slice (object/get @e "name") 0 (- (str/len (object/get @e "name")) 5))), kind: "import-path", detail: (str/slice (object/get @e "name") 0 (- (str/len (object/get @e "name")) 5)) })) (fn c (str/startsWith (str/lower (object/get @c "label")) (str/lower @entity.word)))))) (array/concat @entity.imports @added)))
        (set @entity.trees (array/concat @entity.trees (array/map (array/filter @payload.entries (fn e (= (object/get @e "kind") "dir"))) (fn e { dir: (os/path-join (object/get (array/nth @entity.trees @entity.dcursor) "dir") (object/get @e "name")), pre: (object/get (array/nth @entity.trees @entity.dcursor) "pre") }))))
        (set @entity.dcursor (+ @entity.dcursor 1))
        (emit COMPLETE_DIR_NEXT { })
      COMPLETE_DIR_LISTED -> loading when (= (array/nth @entity.trees @entity.dcursor) null)
        (emit COMPLETE_FAILED { error: "the directory cursor points at no directory" })
      COMPLETE_CTX -> idle
        (emit COMPLETE_ANSWERED { status: 200, body: (json/stringify @payload) })
    }

    emits {
      COMPLETE_ANSWERED -> external {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      COMPLETE_RUN {
        source : string!
        offset : number!
        effects : [string]!
        types : [string]!
        rows : [PatternRow]!
      }
        @description "Internal: complete at the offset against the loaded language tables."
        @tier "internal"
      COMPLETE_STAGE {
        context : string!
        prefix : string!
        candidates : [Cand]!
        behavior : string!
        member : string!
        name : string!
      }
        @description "Internal: the analysed completion, before any behavior lookup."
        @tier "internal"
      COMPLETE_DESCRIBED {
        result : Described!
      }
        @description "behavior/describe: the used behavior's contract."
        @tier "internal"
      COMPLETE_DESCRIBE_FAILED {
        error : string
      }
        @description "behavior/describe failed."
        @tier "internal"
      COMPLETE_CTX {
        context : string!
        prefix : string!
        candidates : [Cand]!
      }
        @description "The completion: its context, the partial word and the candidates."
        @tier "internal"
      COMPLETE_PACKAGES {
        result : [CompletePackage]!
      }
        @description "behavior/packages: the installed behavior packages."
        @tier "internal"
      COMPLETE_PKG_MANIFEST {
        data : bytes!
      }
        @description "os/read-file: an installed package.json."
        @tier "internal"
      COMPLETE_DIR_LISTED {
        entries : [CompleteEntry]!
      }
        @description "os/list-dir: one directory of a package .lolo tree."
        @tier "internal"
      COMPLETE_PKG_NEXT {
      }
        @description "Internal: read the next package manifest."
        @tier "internal"
      COMPLETE_DIR_NEXT {
      }
        @description "Internal: list the next directory of the package trees."
        @tier "internal"
      COMPLETE_FAILED {
        error : string
      }
        @description "A read failed."
        @tier "internal"
      COMPLETE_SOURCE {
        data : bytes!
      }
        @description "os/read-file: the source."
        @tier "internal"
      COMPLETE_MANIFEST {
        data : bytes!
      }
        @description "os/read-file: the installed @almadar/core package.json."
        @tier "internal"
      COMPLETE_VOCABULARY {
        data : bytes!
      }
        @description "os/read-file: the installed vocabulary."
        @tier "internal"
      COMPLETE_PATTERNS {
        data : bytes!
      }
        @description "os/read-file: the installed patterns registry."
        @tier "internal"
    }

    listens {
      COMPLETE_START {
        file : string!
        offset : number!
        cwd : string!
      }
        @description "Complete at an offset of a file."
      OrbComplete.COMPLETE_START -> COMPLETE_START
    }
  }

  page boot as OrbCompleteOrbitalStart -> OrbComplete, ArgsCli, CompleteEngine
}
