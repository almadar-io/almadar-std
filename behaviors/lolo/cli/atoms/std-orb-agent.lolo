app std-orb-agent [
  version: "1.0.0",
  inbound: ["cli-fix", "cli-eval", "cli-trace", "cli-login", "cli-status"],
  exec: ["bun"],
  stdio: [in, out, err],
  fs: { exe-dir: "agent/**": [read], env ORB_AGENT_DIR: "**": [read] },
  env: ["ORB_AGENT_FALLBACK", "ORB_AGENT_DIR", "ORB_BUN_PATH", "PATH", "HOME", "TMPDIR", "SHELL", "USER", "LANG", "TERM", "ANTHROPIC_API_KEY"],
  description: "std-orb-agent — the `orb fix <file>`, `orb eval [--all] [spec]`, `orb trace [session]`, `orb login` and `orb status` commands, which hand their words to the agent bundle run by bun through std-cli with the terminal handed to the agent (stdio inherit: its prompts and live output reach the user, nothing is captured). The bundle is $ORB_AGENT_DIR/cli.js when that file exists, else agent/cli.js beside the running orb binary (os/current-exe); the child gets ORB_BINARY_PATH set to that binary. Both bundle checks go through the grant anchors (env ORB_AGENT_DIR and exe-dir), so the program reads nothing else on disk. bun is found on PATH; the ORB_BUN_PATH and bun-beside-orb lookups wait for std-cli to take a per-run anchored command (exec: [env ORB_BUN_PATH, exe-dir "bun"]), since its command knob is one literal string. Delegation is opt-in: without ORB_AGENT_FALLBACK=1 the command answers `agent delegation is disabled (attempted: <words>). Set ORB_AGENT_FALLBACK=1 to opt in.` (status 500, exit 1). A wrong number of words answers the usage (status 400, exit 2); no cli.js at either place answers the missing-bundle message and a bun that cannot start the missing-runtime message (status 500, exit 1). An agent that exits 0 answers status 200 and an empty body (exit 0); any other exit answers status 500 and an empty body (exit 1), the agent having already written its own output. The agent's exact exit code is not passed through yet: that waits for InboundAnswer to gain an exit field. The child gets the host variables listed in the passEnv knob of the AgentCli trait."
]
uses Spec from "almadar-std/orb-agent"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbAgentOrbital {
  uses Cli from "std/behaviors/std-cli"

  entity OrbAgentRun [runtime] {
    id : string!
    args : [string] @description "The agent subcommand and its words for the call in flight." = []
    exePath : string @description "Absolute path of the running orb binary." = ""
    entry : string @description "The agent bundle path being checked." = ""
    fromEnv : boolean @description "The bundle path being checked came from ORB_AGENT_DIR." = false
  }

  trait AgentCli = Cli.traits.CliRunner {
    listens {
      OrbAgent.AGENT_EXEC -> CLI_RUN
    }
    config {
      command: "bun"
      stdio: "inherit"
      passEnv: ["PATH", "HOME", "TMPDIR", "SHELL", "USER", "LANG", "TERM", "ANTHROPIC_API_KEY", "ORB_AGENT_FALLBACK", "ORB_AGENT_DIR", "ORB_BUN_PATH"]
    }
  }

  trait OrbAgent -> OrbAgentRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      FIX_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit AGENT_ANSWERED { status: 400, body: "usage: orb fix <file>" })
      FIX_CALLED -> working when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (set @entity.args (array/concat ["fix"] (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))
        (emit AGENT_START { })
      EVAL_CALLED -> ready when (> (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 2)
        (emit AGENT_ANSWERED { status: 400, body: "usage: orb eval [--all] [spec]" })
      EVAL_CALLED -> working when (<= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 2)
        (set @entity.args (array/concat ["eval"] (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))
        (emit AGENT_START { })
      TRACE_CALLED -> ready when (> (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit AGENT_ANSWERED { status: 400, body: "usage: orb trace [session]" })
      TRACE_CALLED -> working when (<= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (set @entity.args (array/concat ["trace"] (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))
        (emit AGENT_START { })
      LOGIN_CALLED -> ready when (> (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0)
        (emit AGENT_ANSWERED { status: 400, body: "usage: orb login" })
      LOGIN_CALLED -> working when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0)
        (set @entity.args ["login"])
        (emit AGENT_START { })
      STATUS_CALLED -> ready when (> (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0)
        (emit AGENT_ANSWERED { status: 400, body: "usage: orb status" })
      STATUS_CALLED -> working when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0)
        (set @entity.args ["status"])
        (emit AGENT_START { })
    }

    state working {
      INIT -> working
      AGENT_START -> working
        (os/getenv "ORB_AGENT_FALLBACK" { key: "fallback" emit: { success: AGENT_GATE failure: AGENT_HOST_FAILED } })
      AGENT_GATE -> ready when (!= @payload.value "1")
        (emit AGENT_ANSWERED { status: 500, body: (str/concat "agent delegation is disabled (attempted: " (str/join @entity.args " ") "). Set ORB_AGENT_FALLBACK=1 to opt in.") })
      AGENT_GATE -> working when (= @payload.value "1")
        (os/current-exe { key: "exe" emit: { success: AGENT_EXE failure: AGENT_HOST_FAILED } })
      AGENT_EXE -> working
        (set @entity.exePath @payload.path)
        (os/getenv "ORB_AGENT_DIR" { key: "dir" emit: { success: AGENT_DIR failure: AGENT_HOST_FAILED } })
      AGENT_DIR -> working when (and (!= @payload.value null) (!= @payload.value ""))
        (set @entity.entry (str/concat @payload.value "/cli.js"))
        (set @entity.fromEnv true)
        (os/exists { anchor: { env: "ORB_AGENT_DIR" } path: "cli.js" } { key: "entry" emit: { success: AGENT_ENTRY_CHECKED failure: AGENT_HOST_FAILED } })
      AGENT_DIR -> working when (or (== @payload.value null) (= @payload.value ""))
        (set @entity.entry (str/concat (os/path-dir @entity.exePath) "/agent/cli.js"))
        (set @entity.fromEnv false)
        (os/exists { anchor: "exe-dir" path: "agent/cli.js" } { key: "entry" emit: { success: AGENT_ENTRY_CHECKED failure: AGENT_HOST_FAILED } })
      AGENT_ENTRY_CHECKED -> working when @payload.ok
        (emit AGENT_EXEC { stage: "agent" argv: (array/concat [@entity.entry] @entity.args) env: (object/fromEntries [["ORB_BINARY_PATH", @entity.exePath]]) })
      AGENT_ENTRY_CHECKED -> working when (and (not @payload.ok) @entity.fromEnv)
        (set @entity.entry (str/concat (os/path-dir @entity.exePath) "/agent/cli.js"))
        (set @entity.fromEnv false)
        (os/exists { anchor: "exe-dir" path: "agent/cli.js" } { key: "entry" emit: { success: AGENT_ENTRY_CHECKED failure: AGENT_HOST_FAILED } })
      AGENT_ENTRY_CHECKED -> ready when (and (not @payload.ok) (not @entity.fromEnv))
        (emit AGENT_ANSWERED { status: 500, body: "Agent bundle not found. Set ORB_AGENT_DIR or place agent/cli.js next to the orb binary." })
      AGENT_RAN -> ready when (= @payload.exitCode 0)
        (emit AGENT_ANSWERED { status: 200, body: "" })
      AGENT_RAN -> ready when (!= @payload.exitCode 0)
        (emit AGENT_ANSWERED { status: 500, body: "" })
      AGENT_CLI_FAILED -> ready when (= @payload.code "cli_spawn_failed")
        (emit AGENT_ANSWERED { status: 500, body: "Bun runtime not found. Install Bun (https://bun.sh) or set ORB_BUN_PATH." })
      AGENT_CLI_FAILED -> ready when (!= @payload.code "cli_spawn_failed")
        (emit AGENT_ANSWERED { status: 500, body: (str/concat @payload.code ": " @payload.error) })
      AGENT_HOST_FAILED -> ready
        (emit AGENT_ANSWERED { status: 500, body: (str/concat "host_failed: " (or @payload.error "")) })
    }

    emits {
      AGENT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      AGENT_START { }
        @description "Internal: check the opt-in, then find the agent bundle."
        @tier "internal"
      AGENT_EXEC {
        stage : string!
        argv : [string]!
        env : Map string string!
      }
        @description "Internal: run bun on the agent bundle with the call's words and the child's ORB_BINARY_PATH."
        @tier "internal"
      AGENT_GATE -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for ORB_AGENT_FALLBACK."
        @tier "internal"
      AGENT_EXE -> internal {
        path : string
      }
        @description "Internal: the os/current-exe answer."
        @tier "internal"
      AGENT_ENTRY_CHECKED -> internal {
        ok : boolean!
      }
        @description "Internal: whether the candidate agent bundle exists."
        @tier "internal"
      AGENT_DIR -> internal {
        value : string
      }
        @description "Internal: the os/getenv answer for ORB_AGENT_DIR."
        @tier "internal"
      AGENT_HOST_FAILED -> internal {
        error : string
      }
        @description "Internal: an os/getenv, os/current-exe or os/exists failure."
        @tier "internal"
    }

    listens {
      FIX_CALLED -> inbound "cli-fix" answers AGENT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb fix` with its file argument."
        @synonyms "orb fix, auto-fix schema"
      EVAL_CALLED -> inbound "cli-eval" answers AGENT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb eval` with its spec name and --all flag."
        @synonyms "orb eval, run evaluation specs"
      TRACE_CALLED -> inbound "cli-trace" answers AGENT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb trace` with its session id."
        @synonyms "orb trace, view agent trace"
      LOGIN_CALLED -> inbound "cli-login" answers AGENT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb login`."
        @synonyms "orb login, authenticate"
      STATUS_CALLED -> inbound "cli-status" answers AGENT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb status`."
        @synonyms "orb status, agent status"
      AGENT_GATE {
        value : string
        key : string!
      }
        @description "The os/getenv answer for ORB_AGENT_FALLBACK."
      AGENT_EXE {
        path : string
        key : string!
      }
        @description "The os/current-exe answer."
      AGENT_ENTRY_CHECKED {
        ok : boolean!
        key : string!
      }
        @description "The os/exists answer for the candidate agent bundle."
      AGENT_DIR {
        value : string
        key : string!
      }
        @description "The os/getenv answer for ORB_AGENT_DIR."
      AGENT_HOST_FAILED {
        error : string
        kind : string
        key : string!
      }
        @description "An os/getenv, os/current-exe or os/exists failure."
      AGENT_RAN {
        stage : string!
        exitCode : number!
        signal : number!
        stdout : string!
        stderr : string!
      }
        @description "std-cli's CLI_DONE: the agent exited, with its code; the streams are empty as the agent wrote them to the terminal."
      AGENT_CLI_FAILED {
        stage : string!
        error : string!
        code : string!
      }
        @description "std-cli's CLI_FAILED: the agent could not be run."
      AgentCli.CLI_DONE -> AGENT_RAN
      AgentCli.CLI_FAILED -> AGENT_CLI_FAILED
    }
  }

  page "/orb-agent" as OrbAgentPage -> OrbAgent, AgentCli
}
