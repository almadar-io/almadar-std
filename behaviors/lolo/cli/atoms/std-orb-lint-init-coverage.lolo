app std-orb-lint-init-coverage [
  version: "1.0.0",
  inbound: ["cli-lint-init-coverage"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-init-coverage — the `orb lint init-coverage <file>` command, the port of ORB_CIRCUIT_INIT_UNCOVERED_STATE (G-ORB-186). It lowers the file with program/read and, for every trait a page of its orbital declares whose initial state handles INIT, reports each reachable state with no INIT arm (status 500, exit 1). Reachability follows transitions from their from states or the wildcard and skips a statically false guard (statically false (a falsy literal, a comparison of two literals, or an and/or/not of those, folded with tree/fold) that cannot hold). Clean answers `lint init-coverage: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-init-coverage"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type InitFrom = string | [string]
type InitGuard = string | number | boolean | [InitGuard?] | Map string InitGuard?
type InitState = { name : string, isInitial : boolean }
type InitTransition = { from : InitFrom!, event : string!, to : string!, guard : InitGuard }
type InitMachine = { states : [InitState], transitions : [InitTransition] }
type InitTrait = { name : string, stateMachine : InitMachine }
type InitPageTrait = { ref : string, name : string, stateMachine : InitMachine }
type InitPage = { traits : [InitPageTrait] }
type InitOrbital = { name : string, pages : [InitPage], traits : [InitTrait] }
type InitProgram = { orbitals : [InitOrbital] }

orbital OrbLintInitCoverageOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintInitCoverageRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintInitCoverage -> OrbLintInitCoverageRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (let ((pageTraits (array/flatten (array/map (object/get @o "pages" []) (fn p (array/map (object/get @p "traits" []) (fn r (if (object/has @r "ref") (object/get @r "ref" "") (if (object/has @r "stateMachine") (object/get @r "name" "") ""))))))))
                    (trs (object/get @o "traits" [])))
                (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                  (let ((t (array/nth @trs @ti)))
                    (let ((sm (object/get @t "stateMachine" {})))
                      (let ((states (object/get @sm "states" []))
                            (arms (array/map (object/get @sm "transitions" []) (fn a
                              (let ((raw (object/get @a "from" ""))
                                    (g0 (object/get @a "guard" null)))
                                { froms: (if (validate/array @raw) @raw [@raw]), event: (object/get @a "event" ""), to: (object/get @a "to" ""), dead: (and (!= @g0 null) (object/get (tree/fold @g0 (fn (n k) (if (validate/array @n) (let ((len (array/len @k)) (kk (array/map @k (fn r (if (= @r null) { f: true, t: false, lit: true, v: "null" } @r))))) (let ((op (if (and (> @len 0) (validate/string (array/nth @n 0))) (array/nth @n 0) null)) (args (array/drop @kk 1))) (if (= @len 0) { f: true, t: false, lit: false, v: "" } (if (= @op null) { f: false, t: true, lit: false, v: "" } (if (= @op "and") { f: (array/some @args (fn x (object/get @x "f"))), t: (and (> (array/len @args) 0) (array/every @args (fn x (object/get @x "t")))), lit: false, v: "" } (if (= @op "or") { f: (and (> (array/len @args) 0) (array/every @args (fn x (object/get @x "f")))), t: (array/some @args (fn x (object/get @x "t"))), lit: false, v: "" } (if (= @op "not") { f: (and (= @len 2) (object/get (array/nth @kk 1) "t")), t: (and (= @len 2) (object/get (array/nth @kk 1) "f")), lit: false, v: "" } (if (array/includes ["=", "==", "!="] @op) (if (and (= @len 3) (object/get (array/nth @kk 1) "lit") (object/get (array/nth @kk 2) "lit")) (let ((eq (= (object/get (array/nth @kk 1) "v") (object/get (array/nth @kk 2) "v")))) { f: (= @eq (= @op "!=")), t: (= @eq (!= @op "!=")), lit: false, v: "" }) { f: false, t: false, lit: false, v: "" }) { f: false, t: false, lit: false, v: "" })))))))) (if (validate/object @n) { f: (= (array/len (object/keys @n)) 0), t: (> (array/len (object/keys @n)) 0), lit: false, v: "" } (if (validate/string @n) { f: (= @n ""), t: (and (!= @n "") (not (str/startsWith (json/stringify @n) "\"@"))), lit: (not (str/startsWith (json/stringify @n) "\"@")), v: (json/stringify @n) } (if (validate/number @n) { f: (= @n 0), t: (!= @n 0), lit: true, v: (json/stringify @n) } { f: (not @n), t: @n, lit: true, v: (json/stringify @n) }))))) "InitGuard") "f")) }))))
                            (initialRow (array/find (object/get @sm "states" []) (fn s (= (object/get @s "isInitial" false) true)))))
                        (if (or (= @initialRow null) (not (array/includes @pageTraits (object/get @t "name"))))
                          []
                          (let ((initial (object/get @initialRow "name")))
                            (if (not (array/some @arms (fn a (and (= (object/get @a "event") "INIT") (array/some (object/get @a "froms") (fn f (or (= @f @initial) (= @f "*"))))))))
                              []
                              (let ((reachable (array/reduce (array/range 0 (array/len @states)) [@initial]
                                  (fn (cur i) (array/unique (array/concat @cur (array/map (array/filter @arms (fn a (and (not (object/get @a "dead")) (array/some (object/get @a "froms") (fn f (or (= @f "*") (array/includes @cur @f))))))) (fn a (object/get @a "to")))))))))
                                (array/map (array/filter @states (fn st (and (array/includes @reachable (object/get @st "name")) (not (array/some @arms (fn a (and (= (object/get @a "event") "INIT") (array/some (object/get @a "froms") (fn f (or (= @f (object/get @st "name")) (= @f "*")))))))))))
                                  (fn st { code: "ORB_CIRCUIT_INIT_UNCOVERED_STATE", path: (str/concat "orbitals[" @oi " (" (object/get @o "name") ")].traits[" @ti " (" (object/get @t "name") ")].stateMachine.states." (object/get @st "name")), message: (str/concat "Page trait '" (object/get @t "name") "' handles INIT in '" @initial "' but not in reachable state '" (object/get @st "name") "': revisiting the page from there does nothing"), suggestion: (str/concat "Add an `INIT` arm to state '" (object/get @st "name") "' that re-initializes the trait (as '" @initial "' does)"), severity: "error" })))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "init-coverage", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : InitProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintInitCoverageCli -> OrbLintInitCoverageRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint init-coverage <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "init-coverage") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint init-coverage: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "init-coverage") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint init-coverage: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-init-coverage" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint init-coverage` with its arguments and working directory."
        @synonyms "orb lint init-coverage, page trait INIT coverage"
      OrbLintInitCoverage.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintInitCoverageCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintInitCoverageOrbitalStart -> OrbLintInitCoverage, OrbLintInitCoverageCli, OrbLintInput, Packs, Versions
}
