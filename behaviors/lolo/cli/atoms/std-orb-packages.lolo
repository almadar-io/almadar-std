        (os/rename (str/concat "~/.orb/node_modules/" (str/concat @entity.stage ".old")) (str/concat "~/.orb/node_modules/" (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name")) { key: "restore" emit: { success: PKG_RESTORED, failure: PKG_RESTORE_FAILED } })
