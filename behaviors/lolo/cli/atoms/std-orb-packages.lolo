        (os/mkdir (str/concat "~/.orb/node_modules/" (str/replace-pattern (str/concat @entity.stage "/" (str/slice (object/get (default (if (>= @entity.ei 0) (array/nth @entity.files @entity.ei) null) { path: "", data: (bytes/from-string ""), executable: false }) "path") 8)) "/[^/]*$" "")) true 493 { key: "entrydir" emit: { success: PKG_ENTRY_DIR, failure: PKG_ENTRY_DIR_FAILED } })
