        (os/mkdir { anchor: "cwd" path: (str/concat "node_modules/" (str/replace-pattern (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name") "/?[^/]*$" "")) } true 493 { key: "destdir" emit: { success: PKG_DEST_READY, failure: PKG_DEST_READY_FAILED } })
      PKG_DEST_READY_FAILED -> installing when (= (default @payload.kind "") "exists")
        (emit PKG_DEST_READY { })
      PKG_DEST_READY_FAILED -> installing when (!= (default @payload.kind "") "exists")
        (emit PKG_INSTALL_FAILED { error: (default @payload.error "") })
      PKG_DEST_READY -> installing when @entity.global
        (set @entity.hadOld true)
        (os/rename (str/concat "~/.orb/node_modules/" (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name")) (str/concat "~/.orb/node_modules/" (str/concat @entity.stage ".old")) { key: "oldclear" emit: { success: PKG_OLD_CLEARED, failure: PKG_OLD_CLEAR_FAILED } })
      PKG_DEST_READY -> installing when (not @entity.global)
        (set @entity.hadOld true)
        (os/rename { anchor: "cwd" path: (str/concat "node_modules/" (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name")) } { anchor: "cwd" path: (str/concat "node_modules/" (str/concat @entity.stage ".old")) } { key: "oldclear" emit: { success: PKG_OLD_CLEARED, failure: PKG_OLD_CLEAR_FAILED } })
      PKG_OLD_CLEAR_FAILED -> installing when (= (default @payload.kind "") "not-found")
        (set @entity.hadOld false)
        (emit PKG_OLD_CLEARED { })
      PKG_OLD_CLEAR_FAILED -> installing when (!= (default @payload.kind "") "not-found")
        (set @entity.hadOld false)
        (emit PKG_INSTALL_FAILED { error: (str/concat "the installed package could not be set aside, so it is untouched: " (default @payload.error "")) })
      PKG_OLD_CLEARED -> installing when @entity.global
        (os/rename (str/concat "~/.orb/node_modules/" @entity.stage) (str/concat "~/.orb/node_modules/" (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name")) { key: "place" emit: { success: PKG_PLACED, failure: PKG_PLACE_FAILED } })
      PKG_OLD_CLEARED -> installing when (not @entity.global)
        (os/rename { anchor: "cwd" path: (str/concat "node_modules/" @entity.stage) } { anchor: "cwd" path: (str/concat "node_modules/" (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name")) } { key: "place" emit: { success: PKG_PLACED, failure: PKG_PLACE_FAILED } })
