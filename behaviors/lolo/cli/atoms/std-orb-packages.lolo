        (emit PKG_RESOLVE_FAILED { error: @payload.error, kind: @payload.kind })
      PKG_VERSIONS -> resolving when (and (= @payload.status 200) (!= (json/parse @payload.body VersionList) null) (> (array/len (array/filter (object/get (json/parse @payload.body VersionList) "versions") (fn v (and (not (default (object/get @v "yanked") false)) (= (str/replace-pattern (object/get @v "version") "^[0-9]+\\.[0-9]+\\.[0-9]+$" "") ""))))) 0))
        (set @entity.targets (array/concat @entity.targets (let ((best (default (array/first (array/sort (array/map (array/filter (object/get (json/parse @payload.body VersionList) "versions") (fn v (and (not (default (object/get @v "yanked") false)) (= (str/replace-pattern (object/get @v "version") "^[0-9]+\\.[0-9]+\\.[0-9]+$" "") "")))) (fn v { version: (object/get @v "version"), key: (+ (* 1000000000000 (default (str/to-number (default (array/nth (str/split (object/get @v "version") ".") 0) "")) 0)) (* 1000000 (default (str/to-number (default (array/nth (str/split (object/get @v "version") ".") 1) "")) 0)) (default (str/to-number (default (array/nth (str/split (object/get @v "version") ".") 2) "")) 0)) })) "key" "desc")) { version: "", key: 0 }))) (let ((p0 (str/to-number (default (array/nth (str/split (object/get (default (array/nth @entity.rows @entity.cursor) { package: "", kinds: [], version: "", path: "", link: false }) "version") ".") 0) ""))) (p1 (str/to-number (default (array/nth (str/split (object/get (default (array/nth @entity.rows @entity.cursor) { package: "", kinds: [], version: "", path: "", link: false }) "version") ".") 1) ""))) (p2 (str/to-number (default (array/nth (str/split (object/get (default (array/nth @entity.rows @entity.cursor) { package: "", kinds: [], version: "", path: "", link: false }) "version") ".") 2) "")))) (if (and (!= @p0 null) (!= @p1 null) (!= @p2 null) (> (object/get @best "key") (+ (* 1000000000000 @p0) (* 1000000 @p1) @p2))) [{ name: (object/get (default (array/nth @entity.rows @entity.cursor) { package: "", kinds: [], version: "", path: "", link: false }) "package"), version: (object/get @best "version"), url: "", integrity: "" }] [])))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_UPGRADE_NEXT { })
      PKG_VERSIONS -> resolving when (or (!= @payload.status 200) (= (json/parse @payload.body VersionList) null) (= (array/len (array/filter (object/get (json/parse @payload.body VersionList) "versions") (fn v (and (not (default (object/get @v "yanked") false)) (= (str/replace-pattern (object/get @v "version") "^[0-9]+\\.[0-9]+\\.[0-9]+$" "") ""))))) 0))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_UPGRADE_NEXT { })
      PKG_VERSIONS_UNLISTED -> ready
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat "ORB_PACKAGE_UNREACHABLE: " (default @payload.error "")) })
      PKG_UPGRADE_NEXT -> resolving when (>= @entity.cursor (array/len @entity.rows))
        (set @entity.cursor 0)
        (emit PKG_TARGET_NEXT { })
      PKG_TARGET_NEXT -> ready when (and (>= @entity.cursor (array/len @entity.targets)) (= (array/len @entity.refused) 0) (= @entity.cmd "update"))
        (emit PACKAGES_ANSWERED { status: 200, body: (str/join (array/map @entity.rows (fn r (str/concat (str/padEnd (object/get @r "package") 34 " ") " " (str/padEnd (object/get @r "version") 12 " ") " " (str/padEnd (str/join (object/get @r "kinds") ", ") 26 " ") " ok" (if (object/get @r "link") " (linked)" "")))) "\n"), stderr: "" })
      PKG_TARGET_NEXT -> ready when (and (>= @entity.cursor (array/len @entity.targets)) (= (array/len @entity.refused) 0) (= @entity.cmd "add"))
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat "installed nothing for " (str/join @entity.args " ")) })
      PKG_TARGET_NEXT -> ready when (and (>= @entity.cursor (array/len @entity.targets)) (> (array/len @entity.refused) 0))
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat (if (= @entity.cmd "add") "not added:\n  " "these packages could not be installed:\n  ") (str/join @entity.refused "\n  ")) })
      PKG_TARGET_NEXT -> downloading when (and (< @entity.cursor (array/len @entity.targets)) (!= (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "url") ""))
        (emit PKG_DOWNLOAD { url: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "url") })
      PKG_TARGET_NEXT -> resolving when (and (< @entity.cursor (array/len @entity.targets)) (= (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "url") ""))
        (emit PK_GET { key: "resolve", method: "GET", target: (str/concat "/packages/" (str/encode-uri-component (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name")) "/" (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "version")), headers: [{ name: "accept", value: "application/json" }], body: (bytes/from-string ""), stream: "none" })
      PKG_RESOLVED -> downloading when (and (= @payload.status 200) (!= (json/parse @payload.body Resolved) null))
        (set @entity.targets (let ((resolved (json/parse @payload.body Resolved))) (if (= @resolved null) @entity.targets (array/map (array/range 0 (array/len @entity.targets)) (fn i (if (= @i @entity.cursor) { name: (object/get (default (array/nth @entity.targets @i) { name: "", version: "", url: "", integrity: "" }) "name"), version: (object/get (default (array/nth @entity.targets @i) { name: "", version: "", url: "", integrity: "" }) "version"), url: (object/get @resolved "url"), integrity: (object/get @resolved "integrity") } (default (array/nth @entity.targets @i) { name: "", version: "", url: "", integrity: "" })))))))
        (emit PKG_DOWNLOAD { url: (object/get (json/parse @payload.body Resolved) "url") })
      PKG_RESOLVED -> resolving when (or (!= @payload.status 200) (= (json/parse @payload.body Resolved) null))
        (set @entity.refused (array/append @entity.refused (str/concat (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name") " version " (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "version") ": ORB_PACKAGE_NOT_FOUND (registry answered " @payload.status ")")))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PACKAGE_REFUSED { name: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name"), problem: "ORB_PACKAGE_NOT_FOUND" })
        (emit PKG_TARGET_NEXT { })
      PKG_RESOLVE_FAILED -> ready
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat "ORB_PACKAGE_UNREACHABLE: " (default @payload.error "")) })
    }

    state downloading {
      INIT -> downloading
      PKG_DOWNLOAD -> downloading when (str/startsWith @payload.url @config.registry)
        (emit PK_GET { key: "tarball", method: "GET", target: (str/slice @payload.url (str/len @config.registry) (str/len @payload.url)), headers: [{ name: "accept", value: "application/gzip" }], body: (bytes/from-string ""), stream: "none" })
      PKG_DOWNLOAD -> downloading when (and (not (str/startsWith @payload.url @config.registry)) (str/startsWith @payload.url @config.sourceOrigin))
        (emit PK_SRC_GET { key: "tarball", method: "GET", target: (str/slice @payload.url (str/len @config.sourceOrigin) (str/len @payload.url)), headers: [{ name: "accept", value: "application/gzip" }], body: (bytes/from-string ""), stream: "none" })
      PKG_DOWNLOAD -> resolving when (and (not (str/startsWith @payload.url @config.registry)) (not (str/startsWith @payload.url @config.sourceOrigin)))
        (set @entity.refused (array/append @entity.refused (str/concat @payload.url ": ORB_PACKAGE_SOURCE (not under the registry or the source origin)")))
        (emit PACKAGE_REFUSED { name: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name"), problem: "ORB_PACKAGE_SOURCE" })
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_TARGET_NEXT { })
      PK_REPLIED -> downloading when (= @payload.key "tarball")
        (emit PKG_DOWNLOADED { status: @payload.status, headers: @payload.headers, body: @payload.body, key: @payload.key })
      PK_FAILED -> downloading when (= @payload.key "tarball")
        (emit PKG_DOWNLOAD_FAILED { error: @payload.error, kind: @payload.kind })
      PKG_DOWNLOADED -> verifying when (= @payload.status 200)
        (set @entity.tarballSize (bytes/length @payload.body))
        (set @entity.digest "")
        (set @entity.unpacked false)
        (emit PKG_HASH { requestId: "tarball", data: @payload.body, encoding: "hex" })
      PKG_DOWNLOADED -> resolving when (!= @payload.status 200)
        (set @entity.refused (array/append @entity.refused (str/concat (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name") ": ORB_PACKAGE_DOWNLOAD (the tarball url answered " @payload.status ")")))
        (emit PACKAGE_REFUSED { name: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name"), problem: "ORB_PACKAGE_DOWNLOAD" })
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_TARGET_NEXT { })
      PKG_DOWNLOAD_FAILED -> ready
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat "ORB_PACKAGE_UNREACHABLE: " (default @payload.error "")) })
    }

    state verifying {
      INIT -> verifying
      PKG_DIGESTED -> verifying
        (set @entity.digest @payload.digest)
        (emit PKG_VERIFY { })
      PKG_HASH_FAILED -> verifying
        (set @entity.digest "")
        (emit PKG_VERIFY { })
      PKG_VERIFY -> installing when (and (!= @entity.digest "") (= @entity.digest (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "integrity")))
        (emit PKG_INSTALL { })
      PKG_VERIFY -> resolving when (or (= @entity.digest "") (!= @entity.digest (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "integrity")))
        (emit PACKAGE_REFUSED { name: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name"), problem: (if (= @entity.digest "") "integrity-unavailable" "integrity-mismatch") })
        (set @entity.refused (array/append @entity.refused (str/concat (if (!= (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name") "") (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name") (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "url")) ": " (if (= @entity.digest "") "integrity-unavailable (the tarball could not be hashed" "integrity-mismatch (the tarball hashed to a different sha256 than the registry integrity") "; " @entity.tarballSize " bytes; nothing was installed or recorded)")))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_TARGET_NEXT { })
    }

    state installing {
      INIT -> installing
      PKG_INSTALL -> checking
        (emit PKG_CHECK { })
    }

    state checking {
      INIT -> checking
      PKG_CHECK -> resolving when @entity.unpacked
        (emit PACKAGE_INSTALLED { name: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name"), version: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "version"), kinds: [] })
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_TARGET_NEXT { })
      PKG_CHECK -> resolving when (not @entity.unpacked)
        (emit PACKAGE_REFUSED { name: (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name"), problem: "install-unavailable" })
        (set @entity.refused (array/append @entity.refused (str/concat (object/get (default (array/nth @entity.targets @entity.cursor) { name: "", version: "", url: "", integrity: "" }) "name") ": install-unavailable (unpack into node_modules and the kind check are not ported)")))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_TARGET_NEXT { })
    }

    emits {
      PACKAGES_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      PACKAGE_INSTALLED -> external { name : string!  version : string!  kinds : [PackageKind]! }
        @description "A package passed its integrity check and was installed (not yet reachable: integrity is pending)."
      PACKAGE_REFUSED -> external { name : string!  problem : string! }
        @description "A package was refused; integrity-unavailable until std-sha256 lands."
      PKG_ARGS_UNREAD {  }
        @description "Internal: the call's arguments could not be read."
        @tier "internal"
      PKG_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the --json and --global flags."
        @tier "internal"
      PKG_DIR { }
        @description "Internal: start locating the install directory."
        @tier "internal"
      PKG_W_START { }
        @description "Internal: start the node-style walk over every ancestor node_modules."
        @tier "internal"
      PKG_W_RUNG { }
        @description "Internal: list the next node_modules rung."
        @tier "internal"
      PKG_W_ROOT { entries : [Scanned]! }
        @description "Internal: a rung's entries."
        @tier "internal"
      PKG_W_ROOT_ABSENT { kind : string  error : string }
        @description "Internal: a rung could not be listed."
        @tier "internal"
      PKG_W_SCOPE { }
        @description "Internal: list the next scope directory of the rung."
        @tier "internal"
      PKG_W_SCOPED { entries : [Scanned]! }
        @description "Internal: a scope directory's entries."
        @tier "internal"
      PKG_W_SCOPE_FAILED { kind : string  error : string }
        @description "Internal: a scope directory could not be listed."
        @tier "internal"
      PKG_W_READ { }
        @description "Internal: read the next package's manifest."
        @tier "internal"
      PKG_W_OPEN { }
        @description "Internal: open the manifest of the package at wpath."
        @tier "internal"
      PKG_W_HAVE { }
        @description "Internal: the package's orb block is read; resolve its real path."
        @tier "internal"
      PKG_W_MANIFEST { data : bytes! }
        @description "Internal: a package.json read."
        @tier "internal"
      PKG_W_MANIFEST_FAILED { kind : string  error : string }
        @description "Internal: a directory with no readable package.json (skipped)."
        @tier "internal"
      PKG_W_REAL { path : string! }
        @description "Internal: a package directory's real path."
        @tier "internal"
      PKG_W_REAL_FAILED { kind : string  error : string }
        @description "Internal: a package directory's real path could not be read."
        @tier "internal"
      PKG_W_LOCK { data : bytes! }
        @description "Internal: a package's sidecars.lock.json read."
        @tier "internal"
      PKG_W_LOCK_ABSENT { kind : string  error : string }
        @description "Internal: a package ships no sidecars.lock.json (or it could not be read)."
        @tier "internal"
      PKG_W_APPEND { }
        @description "Internal: the behavior package read is kept."
        @tier "internal"
      PKG_W_DONE { }
        @description "Internal: every rung is walked."
        @tier "internal"
      PKG_FAILED { error : string }
        @description "Internal: a host call failed."
        @tier "internal"
      PKG_LOCK_READ { data : bytes! }
        @description "Internal: the lockfile bytes."
        @tier "internal"
      PKG_LOCK_ABSENT { kind : string  error : string }
        @description "Internal: the lockfile read failed."
        @tier "internal"
      PKG_ROOT { entries : [Scanned]! }
        @description "Internal: node_modules entries."
        @tier "internal"
      PKG_ROOT_ABSENT { kind : string  error : string }
        @description "Internal: node_modules could not be listed."
        @tier "internal"
      PKG_SCOPE { }
        @description "Internal: list the next scope directory."
        @tier "internal"
      PKG_SCOPED { entries : [Scanned]! }
        @description "Internal: a scope directory listing."
        @tier "internal"
      PKG_SCOPE_FAILED { kind : string  error : string }
        @description "Internal: a scope directory could not be listed."
        @tier "internal"
      PKG_READ { }
        @description "Internal: read the next package.json."
        @tier "internal"
      PKG_MANIFEST { data : bytes! }
        @description "Internal: a package.json."
        @tier "internal"
      PKG_MANIFEST_FAILED { kind : string  error : string }
        @description "Internal: a package.json could not be read."
        @tier "internal"
      PKG_DISPATCH { }
        @description "Internal: the scan is done; run the command."
        @tier "internal"
      PKG_RM_NEXT { }
        @description "Internal: remove the next named package."
        @tier "internal"
      PKG_RM_GLOB { }
        @description "Internal: glob the next program pattern."
        @tier "internal"
      PKG_RM_GLOBBED { paths : [string]! }
        @description "Internal: a glob answer."
        @tier "internal"
      PKG_RM_GLOB_FAILED { kind : string  error : string }
        @description "Internal: a glob failed."
        @tier "internal"
      PKG_RM_SCAN { }
        @description "Internal: read the next program file."
        @tier "internal"
      PKG_RM_FILE { data : bytes! }
        @description "Internal: a program file."
        @tier "internal"
      PKG_RM_FILE_UNREAD { kind : string  error : string }
        @description "Internal: a program file could not be read."
        @tier "internal"
      PKG_RM_DELETE { }
        @description "Internal: delete the package directory or link."
        @tier "internal"
      PKG_RM_DELETED { }
        @description "Internal: the package is deleted."
        @tier "internal"
      PKG_DONE { }
        @description "Internal: the command's work is done."
        @tier "internal"
      PKG_LOCK_DIR { }
        @description "Internal: the lockfile directory exists."
        @tier "internal"
      PKG_LOCK_WRITTEN { bytes : number }
        @description "Internal: the lockfile is written."
        @tier "internal"
      PKG_PLAN_ADD { }
        @description "Internal: parse the next add spec."
        @tier "internal"
      PKG_UPGRADE_NEXT { }
        @description "Internal: check the next installed package for a newer version."
        @tier "internal"
      PKG_UPGRADE_ROW { }
        @description "Internal: the row under the cursor."
        @tier "internal"
      PKG_VERSIONS { status : number!  headers : Map string string  body : string!  key : string }
        @description "Internal: a registry version list."
        @tier "internal"
      PKG_VERSIONS_UNLISTED { error : string  kind : string }
        @description "Internal: the version list could not be fetched."
        @tier "internal"
      PKG_PLANNED { }
        @description "Internal: the add specs are parsed."
        @tier "internal"
      PKG_LIST { }
        @description "Internal: print the rows."
        @tier "internal"
      PKG_LIST_ROOT { }
        @description "Internal: list node_modules."
        @tier "internal"
      PKG_INSTALL { }
        @description "Internal: unpack a verified tarball (pending)."
        @tier "internal"
      PKG_CHECK { }
        @description "Internal: check the installed package declares a loadable kind (pending)."
        @tier "internal"
      PKG_TARGET_NEXT { }
        @description "Internal: resolve the next target."
        @tier "internal"
      PKG_RESOLVED { status : number!  headers : Map string string  body : string!  key : string }
        @description "Internal: a resolved version."
        @tier "internal"
      PKG_RESOLVE_FAILED { error : string  kind : string }
        @description "Internal: the registry could not be reached."
        @tier "internal"
      PK_GET -> external { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
        @description "Internal: one registry call, for the HTTP client."
        @tier "internal"
      PK_SRC_GET -> external { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
        @description "Internal: one tarball call to the source origin, for its HTTP client."
        @tier "internal"
      PKG_DOWNLOAD { url : string! }
        @description "Internal: download this tarball url."
        @tier "internal"
      PKG_DOWNLOADED { status : number!  headers : Map string string  body : bytes!  key : string }
        @description "Internal: the tarball bytes."
        @tier "internal"
      PKG_DOWNLOAD_FAILED { error : string  kind : string }
        @description "Internal: the download failed."
        @tier "internal"
      PKG_HASH { requestId : string!  data : bytes!  encoding : string! }
        @description "Internal: hash the downloaded tarball bytes."
        @tier "internal"
      PKG_VERIFY { }
        @description "Internal: the integrity step, pending std-sha256: always refuses integrity-unavailable."
        @tier "internal"
    }

    config {
      registry : string
        @label "Registry"
        @description "The registry origin (scheme://host[:port], no trailing slash) name@version resolves through; must be the origin the composed RegistryHttp trait is configured with (its host, port and serverName knobs; the program declares that host as a net grant)."
      sourceOrigin : string = "https://registry.npmjs.org"
        @label "Tarball source origin"
        @description "The origin, besides the registry, a tarball url may be downloaded from (scheme://host[:port], no trailing slash); must be the origin the composed SourceHttp trait is configured with (its host, port and serverName knobs; the program declares that host as a net grant). One client trait is one host, so another origin is another sibling client and its own knob."
      lockfile : string = "orb.lock.json"
        @label "Lockfile"
        @description "The lockfile name inside the install directory."
      baseline : [BaselineEntry] = []
        @label "Baseline"
        @description "The exact name@version packages `orb update` installs when missing, seeded by the installer."
      programGlobs : [string] = ["**/*.lolo", "**/*.orb"]
        @label "Program globs"
        @description "The program files remove scans for imports of a behavior package prefix."
      skipDirs : [string] = ["/node_modules/", "/.git/", "/dist/", "/target/"]
        @label "Skipped directories"
        @description "Path fragments the remove import scan never reads."
    }

    listens {
      PK_REPLIED { status : number!  headers : Map string string  body : bytes!  key : string! }
        @description "Internal: the HTTP client's reply from the registry."
      PK_FAILED { key : string!  error : string!  kind : string! }
        @description "Internal: the registry call produced no reply."
      RegistryHttp.HTTP_REPLIED -> PK_REPLIED
      RegistryHttp.HTTP_FAILED -> PK_FAILED
      SourceHttp.HTTP_REPLIED -> PK_REPLIED
      SourceHttp.HTTP_FAILED -> PK_FAILED
      PACKAGES_CALLED -> inbound "cli-packages" answers PACKAGES_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb list|add|update|remove` with its arguments and working directory."
        @synonyms "orb add, orb remove, orb list, orb update, install a package"
      PKG_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      PKG_DIGESTED { requestId : string  digest : string! }
        @description "Internal: the tarball's SHA-256 (hex)."
      PKG_HASH_FAILED { requestId : string  reason : string! }
        @description "Internal: the tarball could not be hashed."
      Digest.SHA256_DIGESTED -> PKG_DIGESTED
      Digest.SHA256_REFUSED -> PKG_HASH_FAILED
      ArgsCli.ARGS_PARSED -> PKG_ARGS_DONE
    }
  }

  page boot as OrbPackagesOrbitalStart -> OrbPackages, ArgsCli, Digest, RegistryHttp, SourceHttp
}
