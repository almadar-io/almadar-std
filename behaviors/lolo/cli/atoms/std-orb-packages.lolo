      PKG_ENTRY -> installing when (and (>= @entity.ei (array/len @entity.files)) @entity.global)
        (os/mkdir (str/concat "~/.orb/node_modules/" (str/replace-pattern (object/get (default (if (>= @entity.cursor 0) (array/nth @entity.targets @entity.cursor) null) { name: "", version: "", url: "", integrity: "" }) "name") "/?[^/]*$" "")) true 493 { key: "destdir" emit: { success: PKG_DEST_READY, failure: PKG_DEST_READY_FAILED } })
