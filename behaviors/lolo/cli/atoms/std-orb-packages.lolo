app std-orb-packages [
  version: "1.0.0",
  inbound: ["cli-packages"],
  fs: { cwd: "**": [read, write, remove], "/**": [read], "~/.orb/**": [read, write, create, remove], "~/.orb": [create] },
  net: { "registry.npmjs.org:443": [tcp] },
  description: "std-orb-packages — the `orb list|add|update|remove [--global]` client of the package registry (spec/cli/orb-packages.lolo; golden: orbital-cli packages.rs), bun-free. Packages live in <dir>/node_modules (dir = the working directory, or ~/.orb with --global) and the lockfile <dir>/<lockfile> holds { packages: [{ name, version, url, integrity }] }. Every command first reads the lockfile (absent = empty) and scans node_modules (scoped names included; the entry kind symlink is the workspace link), reading each package.json: a package is an orb package when it declares orbLanguage, orb, orbVocabulary or orbProgram.kind shell|desktop, and its kinds are those. list prints one row per orb package sorted by name (package 34, version 12, kinds 26, `ok`, ` (linked)`, ` [<prefix>/]`) or --json rows. remove refuses a behavior package whose prefix a .lolo or .orb file under the working directory still imports, deletes the package (a link is unlinked, never its target) and drops its lock entry. add parses name@exact-version (a range is refused ORB_PACKAGE_RANGE; a workspace-linked package is refused ORB_PACKAGE_LINKED) or a direct tarball URL, resolves name@version through GET <registry>/packages/<name>/<version> and downloads the tarball over http. update seeds the missing baseline entries and moves each non-linked package to the highest non-yanked stable version of GET <registry>/packages/<name>. After the download the tarball bytes are hashed by std-sha256 (hex) and compared with the registry integrity: equal goes on to the unpack step, a different digest is refused `integrity-mismatch`, an unhashable one `integrity-unavailable`; nothing is unpacked, written to node_modules or recorded in the lockfile on a refusal, and the check is never skipped. The hash is interpreted, so it fits packages of tens of kilobytes. Not yet ported: unpack and install after a verified tarball, the kind-loads-for-this-orb problem column, the behaviors count, the update-check record and the engines subcommands. Tarballs come only from the registry knob (RegistryHttp) or the sourceOrigin knob (SourceHttp, one client per origin); any other host is refused ORB_PACKAGE_SOURCE."
]
uses Spec from "almadar-std/orb-packages"
uses Http from "std/behaviors/std-http-client"
type HttpHeader = { name : string!, value : string! }
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type PackageKind = "language" | "behaviors" | "language pack" | "shell" | "desktop"
type PackageRow = { package : string!, kinds : [PackageKind]!, version : string!, path : string!, link : boolean!, prefix : string?, behaviors : number?, problem : string? }
type LockEntry = { name : string!, version : string!, url : string!, integrity : string! }
type BaselineEntry = { name : string!, version : string!, registry : string! }
type LockFile = { packages : [LockEntry]! }
type PackageTarget = { name : string!, version : string!, url : string!, integrity : string! }
type Marker = { x : string? }
type OrbPackagesBlock = { prefix : string? }
type ProgramBlock = { kind : string?, name : string? }
type OrbPackagesManifest = { name : string?, version : string?, orbLanguage : Marker?, orb : OrbPackagesBlock?, orbVocabulary : Marker?, orbProgram : ProgramBlock? }
type Resolved = { name : string!, version : string!, url : string!, integrity : string!, yanked : boolean? }
type VersionRow = { version : string!, yanked : boolean? }
type VersionList = { name : string!, versions : [VersionRow]! }
type Scanned = { name : string!, kind : string! }
type WalkOrb = { prefix : string?, registry : string?, source : string?, vectors : string?, compiler : string? }
type WalkManifest = { name : string?, version : string?, orb : WalkOrb? }
type LockedFile = { sha256 : string!, bytes : number!, url : string! }
type LockDoc = { version : number!, files : Map string LockedFile }
type WalkPkg = { name : string!, dir : string! }
type WalkRow = { name : string!, version : string!, root : string!, prefix : string!, registry : string?, source : string?, vectors : string?, compiler : string!, lock : LockDoc? }

orbital OrbPackagesOrbital {
  uses Args from "std/behaviors/std-args"
  uses Sha from "std/behaviors/std-sha256"

  entity PackageCall [runtime] {
    id : string!
    status : number = 0
    lock : [LockEntry] = []
    cmd : string = ""
    args : [string] = []
    json : boolean = false
    global : boolean = false
    cwd : string = ""
    dir : string = ""
    lockDirty : boolean = false
    pkgs : [Scanned] = []
    scopes : [string] = []
    cursor : number = 0
    rows : [PackageRow] = []
    targets : [PackageTarget] = []
    refused : [string] = []
    out : [string] = []
    err : string = ""
    globs : [string] = []
    gcursor : number = 0
    paths : [string] = []
    hits : [string] = []
    tarballSize : number = 0
    digest : string = ""
    unpacked : boolean = false
    ancestors : boolean = false
    rungs : [string] = []
    wr : number = 0
    wcur : [WalkPkg] = []
    wpkgs : [WalkPkg] = []
    wc : number = 0
    wrows : [WalkRow] = []
    wpend : WalkRow = { name: "", version: "", root: "", prefix: "", compiler: "" }
    wpath : string = ""
  }

  trait RegistryHttp = Http.traits.HttpClient {
    config {
      host: "registry.npmjs.org"
      port: 443
      tls: true
      serverName: "registry.npmjs.org"
    }
    listens {
      OrbPackages.PK_GET -> HTTP_SEND
    }
  }

  trait SourceHttp = Http.traits.HttpClient {
    config {
      host: "registry.npmjs.org"
      port: 443
      tls: true
      serverName: "registry.npmjs.org"
    }
    listens {
      OrbPackages.PK_SRC_GET -> HTTP_SEND
    }
  }

  trait Digest = Sha.traits.Sha256 {
    listens {
      OrbPackages.PKG_HASH -> SHA256_DIGEST
    }
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbPackages.PKG_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbPackages -> PackageCall [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      PACKAGES_CALLED -> parsing when (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (emit PKG_ARGS_UNREAD { })
      PACKAGES_CALLED -> parsing when (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null)
        (set @entity.cwd (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "cwd"))
        (let ((argv (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv"))) (if (= @argv null) (emit PKG_ARGS_UNREAD { }) (emit PKG_ARGS_PARSE { stage: "packages" argv: @argv flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }, { name: "global" aliases: [] takesValue: false repeatable: false }, { name: "ancestors" aliases: [] takesValue: false repeatable: false }] })))
    }

    state parsing {
      INIT -> parsing
      PKG_ARGS_UNREAD -> ready
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: "Error: the call's arguments could not be read" })
      PKG_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0) (not (array/includes ["list", "add", "update", "remove"] (array/first @payload.positionals))))
        (emit PACKAGES_ANSWERED { status: 400, body: "usage: orb list|add|update|remove [--json] [--global] [<package>…]", stderr: "" })
      PKG_ARGS_DONE -> locating when (and (= (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0) (array/includes ["list", "add", "update", "remove"] (array/first @payload.positionals)))
        (set @entity.cmd (default (array/first @payload.positionals) ""))
        (set @entity.args (array/drop @payload.positionals 1))
        (set @entity.json (object/has @payload.flags "json"))
        (set @entity.global (object/has @payload.flags "global"))
        (set @entity.ancestors (object/has @payload.flags "ancestors"))
        (set @entity.lock [])
        (set @entity.pkgs [])
        (set @entity.rows [])
        (set @entity.targets [])
        (set @entity.refused [])
        (set @entity.out [])
        (set @entity.lockDirty false)
        (emit PKG_DIR { })
    }

    state locating {
      INIT -> locating
      PKG_DIR -> locking when @entity.global
        (set @entity.dir "~/.orb")
        (os/read-file (str/concat "~/.orb/" @config.lockfile) { key: "lock" emit: { success: PKG_LOCK_READ, failure: PKG_LOCK_ABSENT } })
      PKG_DIR -> locking when (not @entity.global)
        (set @entity.dir @entity.cwd)
        (os/read-file { anchor: "cwd" path: @config.lockfile } { key: "lock" emit: { success: PKG_LOCK_READ, failure: PKG_LOCK_ABSENT } })
    }

    state locking {
      INIT -> locking
      PKG_LOCK_READ -> scanning when (!= (json/parse (default (bytes/to-string @payload.data) "") LockFile) null)
        (set @entity.lock (object/get (json/parse (default (bytes/to-string @payload.data) "") LockFile) "packages"))
        (emit PKG_LIST_ROOT { })
      PKG_LOCK_READ -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") LockFile) null)
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat @entity.dir "/" @config.lockfile ": not a valid lockfile (expected { packages: [{ name, version, url, integrity }] })") })
      PKG_LOCK_ABSENT -> scanning when (= @payload.kind "not-found")
        (emit PKG_LIST_ROOT { })
      PKG_LOCK_ABSENT -> ready when (!= @payload.kind "not-found")
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat @entity.dir "/" @config.lockfile ": " (default @payload.error "")) })
    }

    state scanning {
      INIT -> scanning
      PKG_LIST_ROOT -> scanning when @entity.global
        (os/list-dir "~/.orb/node_modules" { key: "root" emit: { success: PKG_ROOT, failure: PKG_ROOT_ABSENT } })
      PKG_LIST_ROOT -> scanning when (not @entity.global)
        (os/list-dir { anchor: "cwd" path: "node_modules" } { key: "root" emit: { success: PKG_ROOT, failure: PKG_ROOT_ABSENT } })
      PKG_ROOT -> scanning
        (set @entity.pkgs (array/map (array/filter @payload.entries (fn e (and (not (str/startsWith (object/get @e "name") ".")) (= (str/replace-pattern (object/get @e "name") "^\\x40" "") (object/get @e "name")) (array/includes ["dir", "symlink"] (object/get @e "kind"))))) (fn e { name: (object/get @e "name"), kind: (object/get @e "kind") })))
        (set @entity.scopes (array/map (array/filter @payload.entries (fn e (!= (str/replace-pattern (object/get @e "name") "^\\x40" "") (object/get @e "name")))) (fn e (object/get @e "name"))))
        (emit PKG_SCOPE { })
      PKG_ROOT_ABSENT -> scanning when (= @payload.kind "not-found")
        (set @entity.pkgs [])
        (set @entity.scopes [])
        (emit PKG_SCOPE { })
      PKG_ROOT_ABSENT -> ready when (!= @payload.kind "not-found")
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat @entity.dir "/node_modules: " (default @payload.error "")) })
      PKG_SCOPE -> scanning when (and (> (array/len @entity.scopes) 0) @entity.global)
        (os/list-dir (str/concat "~/.orb/node_modules/" (default (array/first @entity.scopes) "")) { key: "scope" emit: { success: PKG_SCOPED, failure: PKG_SCOPE_FAILED } })
      PKG_SCOPE -> scanning when (and (> (array/len @entity.scopes) 0) (not @entity.global))
        (os/list-dir { anchor: "cwd" path: (str/concat "node_modules/" (default (array/first @entity.scopes) "")) } { key: "scope" emit: { success: PKG_SCOPED, failure: PKG_SCOPE_FAILED } })
      PKG_SCOPE -> reading when (= (array/len @entity.scopes) 0)
        (set @entity.cursor 0)
        (set @entity.rows [])
        (emit PKG_READ { })
      PKG_SCOPED -> scanning
        (set @entity.pkgs (array/concat @entity.pkgs (array/map (array/filter @payload.entries (fn e (array/includes ["dir", "symlink"] (object/get @e "kind")))) (fn e { name: (str/concat (default (array/first @entity.scopes) "") "/" (object/get @e "name")), kind: (object/get @e "kind") }))))
        (set @entity.scopes (array/drop @entity.scopes 1))
        (emit PKG_SCOPE { })
      PKG_SCOPE_FAILED -> scanning
        (set @entity.scopes (array/drop @entity.scopes 1))
        (emit PKG_SCOPE { })
    }

    state reading {
      INIT -> reading
      PKG_READ -> reading when (and (< @entity.cursor (array/len @entity.pkgs)) @entity.global)
        (os/read-file (str/concat "~/.orb/node_modules/" (object/get (default (array/nth @entity.pkgs @entity.cursor) { name: "", kind: "" }) "name") "/package.json") { key: "manifest" emit: { success: PKG_MANIFEST, failure: PKG_MANIFEST_FAILED } })
      PKG_READ -> reading when (and (< @entity.cursor (array/len @entity.pkgs)) (not @entity.global))
        (os/read-file { anchor: "cwd" path: (str/concat "node_modules/" (object/get (default (array/nth @entity.pkgs @entity.cursor) { name: "", kind: "" }) "name") "/package.json") } { key: "manifest" emit: { success: PKG_MANIFEST, failure: PKG_MANIFEST_FAILED } })
      PKG_READ -> dispatching when (>= @entity.cursor (array/len @entity.pkgs))
        (set @entity.rows (array/sort @entity.rows "package" "asc"))
        (emit PKG_DISPATCH { })
      PKG_MANIFEST -> reading when (or (= (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) null) (and (= (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orbLanguage") null) (= (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orb") null) (= (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orbVocabulary") null) (not (array/includes ["shell", "desktop"] (default (object/get (default (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orbProgram") { }) "kind") "")))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_READ { })
      PKG_MANIFEST -> reading when (and (!= (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) null) (or (!= (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orbLanguage") null) (!= (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orb") null) (!= (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orbVocabulary") null) (array/includes ["shell", "desktop"] (default (object/get (default (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest) "orbProgram") { }) "kind") ""))))
        (set @entity.rows (array/append @entity.rows (let ((m (json/parse (default (bytes/to-string @payload.data) "") OrbPackagesManifest)) (p (default (array/nth @entity.pkgs @entity.cursor) { name: "", kind: "" }))) (let ((row { package: (object/get @p "name"), kinds: (array/concat (if (!= (object/get @m "orbLanguage") null) ["language"] []) (if (!= (object/get @m "orb") null) ["behaviors"] []) (if (!= (object/get @m "orbVocabulary") null) ["language pack"] []) (if (= (default (object/get (default (object/get @m "orbProgram") { }) "kind") "") "shell") ["shell"] []) (if (= (default (object/get (default (object/get @m "orbProgram") { }) "kind") "") "desktop") ["desktop"] [])), version: (default (object/get @m "version") ""), path: (str/concat @entity.dir "/node_modules/" (object/get @p "name")), link: (= (object/get @p "kind") "symlink") })) (if (and (!= (object/get @m "orb") null) (!= (object/get (object/get @m "orb") "prefix") null)) (object/merge @row { prefix: (object/get (object/get @m "orb") "prefix") }) @row)))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_READ { })
      PKG_MANIFEST_FAILED -> reading
        (set @entity.cursor (+ @entity.cursor 1))
        (emit PKG_READ { })
    }

    state dispatching {
      INIT -> dispatching
      PKG_DISPATCH -> listing when (and (= @entity.cmd "list") (not @entity.ancestors))
        (emit PKG_LIST { })
      PKG_DISPATCH -> walking when (and (= @entity.cmd "list") @entity.ancestors)
        (emit PKG_W_START { })
      PKG_DISPATCH -> removing when (= @entity.cmd "remove")
        (set @entity.cursor 0)
        (emit PKG_RM_NEXT { })
      PKG_DISPATCH -> ready when (and (= @entity.cmd "add") (= (array/len @entity.args) 0))
        (emit PACKAGES_ANSWERED { status: 400, body: "", stderr: "usage: orb add <package, an at sign and an exact version | tarball url> [--global]" })
      PKG_DISPATCH -> resolving when (and (= @entity.cmd "add") (> (array/len @entity.args) 0))
        (set @entity.targets [])
        (set @entity.cursor 0)
        (emit PKG_PLAN_ADD { })
      PKG_DISPATCH -> resolving when (= @entity.cmd "update")
        (set @entity.targets (array/map (array/filter @config.baseline (fn b (= (array/len (array/filter @entity.rows (fn r (= (object/get @r "package") (object/get @b "name"))))) 0))) (fn b { name: (object/get @b "name"), version: (object/get @b "version"), url: "", integrity: "" })))
        (set @entity.refused (array/map (array/filter @config.baseline (fn b (and (= (array/len (array/filter @entity.rows (fn r (= (object/get @r "package") (object/get @b "name"))))) 0) (!= (object/get @b "registry") @config.registry)))) (fn b (str/concat (object/get @b "name") ": ORB_PACKAGE_SOURCE (baseline registry " (object/get @b "registry") " is not the registry knob)"))))
        (set @entity.cursor 0)
        (emit PKG_UPGRADE_NEXT { })
    }

    state walking {
      INIT -> walking
      PKG_FAILED -> ready
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (default @payload.error "") })
      PKG_W_START -> walking
        (set @entity.rungs (array/append (let ((segs (array/filter (str/split @entity.cwd "/") (fn s (!= @s ""))))) (array/map (array/range 0 (+ (array/len @segs) 1)) (fn k (str/concat (str/join (array/map (array/slice @segs 0 (- (array/len @segs) @k)) (fn s (str/concat "/" @s))) "") "/node_modules")))) "~/.orb/node_modules"))
        (set @entity.wr 0)
        (set @entity.wpkgs [])
        (set @entity.wrows [])
        (emit PKG_W_RUNG { })
      PKG_W_RUNG -> walking when (and (< @entity.wr (array/len @entity.rungs)) (str/startsWith (default (array/nth @entity.rungs @entity.wr) "") "/"))
        (os/list-dir (str/concat "/" (str/slice (default (array/nth @entity.rungs @entity.wr) "") 1 (str/len (default (array/nth @entity.rungs @entity.wr) "")))) { key: "wroot" emit: { success: PKG_W_ROOT, failure: PKG_W_ROOT_ABSENT } })
      PKG_W_RUNG -> walking when (and (< @entity.wr (array/len @entity.rungs)) (not (str/startsWith (default (array/nth @entity.rungs @entity.wr) "") "/")))
        (os/list-dir "~/.orb/node_modules" { key: "wroot" emit: { success: PKG_W_ROOT, failure: PKG_W_ROOT_ABSENT } })
      PKG_W_RUNG -> walking when (>= @entity.wr (array/len @entity.rungs))
        (set @entity.wc 0)
        (emit PKG_W_READ { })
      PKG_W_ROOT -> walking
        (set @entity.wcur (array/map (array/filter @payload.entries (fn e (and (not (str/startsWith (default (object/get @e "name") "") ".")) (= (str/replace-pattern (default (object/get @e "name") "") "^\\x40" "") (default (object/get @e "name") "")) (array/includes ["dir", "symlink"] (default (object/get @e "kind") ""))))) (fn e { name: (default (object/get @e "name") ""), dir: (default (array/nth @entity.rungs @entity.wr) "") })))
        (set @entity.scopes (array/map (array/filter @payload.entries (fn e (!= (str/replace-pattern (default (object/get @e "name") "") "^\\x40" "") (default (object/get @e "name") "")))) (fn e (default (object/get @e "name") ""))))
        (emit PKG_W_SCOPE { })
      PKG_W_ROOT_ABSENT -> walking when (= (default @payload.kind "") "not-found")
        (set @entity.wcur [])
        (set @entity.scopes [])
        (emit PKG_W_SCOPE { })
      PKG_W_ROOT_ABSENT -> ready when (!= (default @payload.kind "") "not-found")
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat (default (array/nth @entity.rungs @entity.wr) "") ": " (default @payload.error "")) })
      PKG_W_SCOPE -> walking when (and (> (array/len @entity.scopes) 0) (str/startsWith (default (array/nth @entity.rungs @entity.wr) "") "/"))
        (os/list-dir (str/concat "/" (str/slice (default (array/nth @entity.rungs @entity.wr) "") 1 (str/len (default (array/nth @entity.rungs @entity.wr) ""))) "/" (default (array/first @entity.scopes) "")) { key: "wscope" emit: { success: PKG_W_SCOPED, failure: PKG_W_SCOPE_FAILED } })
      PKG_W_SCOPE -> walking when (and (> (array/len @entity.scopes) 0) (not (str/startsWith (default (array/nth @entity.rungs @entity.wr) "") "/")))
        (os/list-dir (str/concat "~/.orb/node_modules/" (default (array/first @entity.scopes) "")) { key: "wscope" emit: { success: PKG_W_SCOPED, failure: PKG_W_SCOPE_FAILED } })
      PKG_W_SCOPE -> walking when (= (array/len @entity.scopes) 0)
        (set @entity.wpkgs (array/concat @entity.wpkgs (array/sort @entity.wcur "name" "asc")))
        (set @entity.wr (+ @entity.wr 1))
        (emit PKG_W_RUNG { })
      PKG_W_SCOPED -> walking
        (set @entity.wcur (array/concat @entity.wcur (array/map (array/filter @payload.entries (fn e (array/includes ["dir", "symlink"] (default (object/get @e "kind") "")))) (fn e { name: (str/concat (default (array/first @entity.scopes) "") "/" (default (object/get @e "name") "")), dir: (default (array/nth @entity.rungs @entity.wr) "") }))))
        (set @entity.scopes (array/drop @entity.scopes 1))
        (emit PKG_W_SCOPE { })
      PKG_W_SCOPE_FAILED -> walking
        (set @entity.scopes (array/drop @entity.scopes 1))
        (emit PKG_W_SCOPE { })
      PKG_W_READ -> walking when (< @entity.wc (array/len @entity.wpkgs))
        (set @entity.wpath (str/concat (default (object/get (default (array/nth @entity.wpkgs @entity.wc) { name: "", dir: "" }) "dir") "") "/" (default (object/get (default (array/nth @entity.wpkgs @entity.wc) { name: "", dir: "" }) "name") "")))
        (emit PKG_W_OPEN { })
      PKG_W_OPEN -> walking when (str/startsWith @entity.wpath "/")
        (os/read-file (str/concat "/" (str/slice @entity.wpath 1 (str/len @entity.wpath)) "/package.json") { key: "wmanifest" emit: { success: PKG_W_MANIFEST, failure: PKG_W_MANIFEST_FAILED } })
      PKG_W_OPEN -> walking when (not (str/startsWith @entity.wpath "/"))
        (os/read-file (str/concat "~/.orb/node_modules/" (default (object/get (default (array/nth @entity.wpkgs @entity.wc) { name: "", dir: "" }) "name") "") "/package.json") { key: "wmanifest" emit: { success: PKG_W_MANIFEST, failure: PKG_W_MANIFEST_FAILED } })
      PKG_W_READ -> walking when (>= @entity.wc (array/len @entity.wpkgs))
        (emit PKG_W_DONE { })
      PKG_W_MANIFEST_FAILED -> walking
        (set @entity.wc (+ @entity.wc 1))
        (emit PKG_W_READ { })
      PKG_W_MANIFEST -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") WalkManifest) null)
        (emit PACKAGES_ANSWERED { status: 500, body: "", stderr: (str/concat @entity.wpath "/package.json: not a valid package.json") })
