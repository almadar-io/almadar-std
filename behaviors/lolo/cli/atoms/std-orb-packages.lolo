    emits {
      PACKAGES_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      PACKAGE_INSTALLED -> external { name : string!  version : string!  kinds : [PackageKind]! }
        @description "A package passed its integrity check, was written into node_modules and recorded in the lock."
      PACKAGE_REFUSED -> external { name : string!  problem : string! }
        @description "A package was refused: integrity, archive, layout, source, download, install or not-found."
      PKG_ARGS_UNREAD {  }
        @description "Internal: the call's arguments could not be read."
        @tier "internal"
      PKG_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words against the --json and --global flags."
        @tier "internal"
      PKG_DIR { }
        @description "Internal: start locating the install directory."
        @tier "internal"
      PKG_W_START { }
        @description "Internal: start the node-style walk over every ancestor node_modules."
        @tier "internal"
      PKG_W_RUNG { }
        @description "Internal: list the next node_modules rung."
        @tier "internal"
      PKG_W_ROOT { entries : [Scanned]! }
        @description "Internal: a rung's entries."
        @tier "internal"
      PKG_W_ROOT_ABSENT { kind : string  error : string }
        @description "Internal: a rung could not be listed."
        @tier "internal"
      PKG_W_SCOPE { }
        @description "Internal: list the next scope directory of the rung."
        @tier "internal"
      PKG_W_SCOPED { entries : [Scanned]! }
        @description "Internal: a scope directory's entries."
        @tier "internal"
      PKG_W_SCOPE_FAILED { kind : string  error : string }
        @description "Internal: a scope directory could not be listed."
        @tier "internal"
      PKG_W_READ { }
        @description "Internal: read the next package's manifest."
        @tier "internal"
      PKG_W_OPEN { }
        @description "Internal: open the manifest of the package at wpath."
        @tier "internal"
      PKG_W_HAVE { }
        @description "Internal: the package's orb block is read; resolve its real path."
        @tier "internal"
      PKG_W_MANIFEST { data : bytes! }
        @description "Internal: a package.json read."
        @tier "internal"
      PKG_W_MANIFEST_FAILED { kind : string  error : string }
        @description "Internal: a directory with no readable package.json (skipped)."
        @tier "internal"
      PKG_W_REAL { path : string! }
        @description "Internal: a package directory's real path."
        @tier "internal"
      PKG_W_REAL_FAILED { kind : string  error : string }
        @description "Internal: a package directory's real path could not be read."
        @tier "internal"
      PKG_W_LOCK { data : bytes! }
        @description "Internal: a package's sidecars.lock.json read."
        @tier "internal"
      PKG_W_LOCK_ABSENT { kind : string  error : string }
        @description "Internal: a package ships no sidecars.lock.json (or it could not be read)."
        @tier "internal"
      PKG_W_APPEND { }
        @description "Internal: the behavior package read is kept."
        @tier "internal"
      PKG_W_DONE { }
        @description "Internal: every rung is walked."
        @tier "internal"
      PKG_FAILED { error : string }
        @description "Internal: a host call failed."
        @tier "internal"
      PKG_LOCK_READ { data : bytes! }
        @description "Internal: the lockfile bytes."
        @tier "internal"
      PKG_LOCK_ABSENT { kind : string  error : string }
        @description "Internal: the lockfile read failed."
        @tier "internal"
      PKG_ROOT { entries : [Scanned]! }
        @description "Internal: node_modules entries."
        @tier "internal"
      PKG_ROOT_ABSENT { kind : string  error : string }
        @description "Internal: node_modules could not be listed."
        @tier "internal"
      PKG_SCOPE { }
        @description "Internal: list the next scope directory."
        @tier "internal"
      PKG_SCOPED { entries : [Scanned]! }
        @description "Internal: a scope directory listing."
        @tier "internal"
      PKG_SCOPE_FAILED { kind : string  error : string }
        @description "Internal: a scope directory could not be listed."
        @tier "internal"
      PKG_READ { }
        @description "Internal: read the next package.json."
        @tier "internal"
      PKG_MANIFEST { data : bytes! }
        @description "Internal: a package.json."
        @tier "internal"
      PKG_MANIFEST_FAILED { kind : string  error : string }
        @description "Internal: a package.json could not be read."
        @tier "internal"
      PKG_DISPATCH { }
        @description "Internal: the scan is done; run the command."
        @tier "internal"
      PKG_RM_NEXT { }
        @description "Internal: remove the next named package."
        @tier "internal"
      PKG_RM_GLOB { }
        @description "Internal: glob the next program pattern."
        @tier "internal"
      PKG_RM_GLOBBED { paths : [string]! }
        @description "Internal: a glob answer."
        @tier "internal"
      PKG_RM_GLOB_FAILED { kind : string  error : string }
        @description "Internal: a glob failed."
        @tier "internal"
      PKG_RM_SCAN { }
        @description "Internal: read the next program file."
        @tier "internal"
      PKG_RM_FILE { data : bytes! }
        @description "Internal: a program file."
        @tier "internal"
      PKG_RM_FILE_UNREAD { kind : string  error : string }
        @description "Internal: a program file could not be read."
        @tier "internal"
      PKG_RM_DELETE { }
        @description "Internal: delete the package directory or link."
        @tier "internal"
      PKG_RM_DELETED { }
        @description "Internal: the package is deleted."
        @tier "internal"
      PKG_DONE { }
        @description "Internal: the command's work is done."
        @tier "internal"
      PKG_LOCK_DIR { }
        @description "Internal: the lockfile directory exists."
        @tier "internal"
      PKG_LOCK_WRITTEN { bytes : number }
        @description "Internal: the lockfile is written."
        @tier "internal"
      PKG_PLAN_ADD { }
        @description "Internal: parse the next add spec."
        @tier "internal"
      PKG_UPGRADE_NEXT { }
        @description "Internal: check the next installed package for a newer version."
        @tier "internal"
      PKG_VERSIONS { status : number!  key : string }
        @description "Internal: a registry packument is read into the entity."
        @tier "internal"
      PKG_SEMVER { requestId : string!  version : string!  range : string! }
        @description "Internal: ask std-semver a range question: requestId update asks whether a language version satisfies a language range (core: its orbLanguage.version against the range this orb reads; any other package: the core language against its language range); requestId fixes asks whether the installed version satisfies an urgent release's fixes range."
        @tier "internal"
      PKG_CAND_NEXT { at : number!  fixed : boolean }
        @description "Internal: judge the next candidate version of the package under the cursor; fixed marks an urgent candidate whose fixes range already admits the installed version."
        @tier "internal"
      PKG_RUNNING_FAILED { kind : string  error : string }
        @description "Internal: a host call reading the running orb's version failed."
        @tier "internal"
      PKG_PATH_READ { value : string }
        @description "Internal: the PATH the orb --version child is given."
        @tier "internal"
      PKG_SPAWNED { pid : number!  stdout : number! }
        @description "Internal: orb --version started."
        @tier "internal"
      PKG_VERSION_TEXT { data : bytes! }
        @description "Internal: orb --version output."
        @tier "internal"
      PKG_WAITED { code : number }
        @description "Internal: orb --version exited."
        @tier "internal"
      PKG_VERSIONS_UNLISTED { error : string  kind : string }
        @description "Internal: the version list could not be fetched."
        @tier "internal"
      PKG_PLANNED { }
        @description "Internal: the add specs are parsed."
        @tier "internal"
      PKG_LIST { }
        @description "Internal: print the rows."
        @tier "internal"
      PKG_LIST_ROOT { }
        @description "Internal: list node_modules."
        @tier "internal"
      PKG_UNGZIPPED { }
        @description "Internal: the verified tarball is gunzipped."
        @tier "internal"
      PKG_UNTARRED { }
        @description "Internal: the gunzipped archive is read as ustar."
        @tier "internal"
      PKG_LAYOUT { }
        @description "Internal: the archive entries are checked to sit under package/."
        @tier "internal"
      PKG_STAGE_CLEAR { }
        @description "Internal: clear any leftover staging directory of the package."
        @tier "internal"
      PKG_STAGE_READY { }
        @description "Internal: the staging directory is clear."
        @tier "internal"
      PKG_STAGE_CLEAR_FAILED { kind : string  error : string }
        @description "Internal: a leftover staging directory could not be removed."
        @tier "internal"
      PKG_ENTRY { }
        @description "Internal: write the next archive entry into staging."
        @tier "internal"
      PKG_ENTRY_DIR { }
        @description "Internal: the entry's parent directory exists."
        @tier "internal"
      PKG_ENTRY_DIR_FAILED { kind : string  error : string }
        @description "Internal: an entry's parent directory could not be created."
        @tier "internal"
      PKG_ENTRY_WRITTEN { bytes : number }
        @description "Internal: an entry is written."
        @tier "internal"
      PKG_OLD_CLEARED { }
        @description "Internal: the old package directory is gone."
        @tier "internal"
      PKG_OLD_CLEAR_FAILED { kind : string  error : string }
        @description "Internal: the old package directory could not be removed."
        @tier "internal"
      PKG_DEST_READY { }
        @description "Internal: the directory that holds the package exists."
        @tier "internal"
      PKG_DEST_READY_FAILED { kind : string  error : string }
        @description "Internal: the directory that holds the package could not be created."
        @tier "internal"
      PKG_PLACED { }
        @description "Internal: the staging directory is renamed into node_modules."
        @tier "internal"
      PKG_UNAME { sysname : string!  nodename : string  release : string  version : string  machine : string! }
        @description "Internal: the os/uname answer that picks this host's orb platform package."
        @tier "internal"
      PKG_UNAME_FAILED { kind : string  error : string }
        @description "Internal: os/uname failed, so this host's orb platform package is not known."
        @tier "internal"
      PKG_PLACE_FAILED { kind : string  error : string }
        @description "Internal: the staging directory could not be renamed into place; the previous package is renamed back from its backup."
        @tier "internal"
      PKG_RESTORED { }
        @description "Internal: the previous package is back in place."
        @tier "internal"
      PKG_RESTORE_FAILED { kind : string  error : string }
        @description "Internal: the previous package could not be renamed back from its backup, which stays beside the staging directory."
        @tier "internal"
      PKG_BACKUP_NEXT { }
        @description "Internal: remove the backup of the replaced package, if one was set aside."
        @tier "internal"
      PKG_BACKUP_GONE { }
        @description "Internal: the backup of the replaced package is removed (or there was none)."
        @tier "internal"
      PKG_STAGE_SCOPE_TIDIED { }
        @description "Internal: the empty scope directory the staging directory was renamed out of is removed, or was not empty."
        @tier "internal"
      PKG_STAGE_ROOT_TIDIED { }
        @description "Internal: the empty staging root is removed, or still holds a kept backup."
        @tier "internal"
      PKG_INSTALL_FAILED { error : string }
        @description "Internal: a host call failed while installing one package; that package is refused."
        @tier "internal"
      PKG_TARGET_NEXT { }
        @description "Internal: resolve the next target."
        @tier "internal"
      PKG_RESOLVED { status : number!  key : string }
        @description "Internal: a version manifest is read into the entity."
        @tier "internal"
      PKG_RESOLVE_FAILED { error : string  kind : string }
        @description "Internal: the registry could not be reached."
        @tier "internal"
      PK_GET -> external { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
        @description "Internal: one registry call, for the HTTP client."
        @tier "internal"
      PK_SRC_GET -> external { key : string!  method : string!  target : string!  headers : [HttpHeader]!  body : bytes!  stream : string! }
        @description "Internal: one tarball call to the source origin, for its HTTP client."
        @tier "internal"
      PKG_DOWNLOAD { url : string! }
        @description "Internal: download this tarball url."
        @tier "internal"
      PKG_DOWNLOADED { status : number!  headers : Map string string  body : bytes!  key : string }
        @description "Internal: the tarball bytes."
        @tier "internal"
      PKG_DOWNLOAD_FAILED { error : string  kind : string }
        @description "Internal: the download failed."
        @tier "internal"
      PKG_VERIFY { }
        @description "Internal: compare the tarball's sha512 digest with the registry integrity."
        @tier "internal"
    }

    config {
      registry : string = "https://registry.npmjs.org"
        @label "Registry"
        @description "The npm registry origin (scheme://host[:port], no trailing slash) packuments and version manifests are read from; must be the origin the composed RegistryHttp trait is configured with (its host, port and serverName knobs; the program declares that host as a net grant)."
      sourceOrigin : string = "https://registry.npmjs.org"
        @label "Tarball source origin"
        @description "The origin, besides the registry, a tarball url may be downloaded from (scheme://host[:port], no trailing slash); must be the origin the composed SourceHttp trait is configured with (its host, port and serverName knobs; the program declares that host as a net grant). One client trait is one host, so another origin is another sibling client and its own knob."
      lockfile : string = "orb.lock.json"
        @label "Lockfile"
        @description "The lockfile name inside the install directory."
      corePackage : string = (quote "@almadar/core")
        @label "Core package"
        @description "The package whose orbLanguage.version is the language every other package is checked against, and which `orb update` resolves before them."
      baseline : [BaselineEntry] = [{ name: (quote "@almadar/core"), registry: "https://registry.npmjs.org" }, { name: (quote "@almadar/std"), registry: "https://registry.npmjs.org" }, { name: (quote "@almadar/lolo-ar"), registry: "https://registry.npmjs.org" }, { name: (quote "@almadar/lolo-sl"), registry: "https://registry.npmjs.org" }, { name: (quote "@almadar/orb-shell-typescript"), registry: "https://registry.npmjs.org" }]
        @label "Baseline"
        @description "The packages `orb update` installs when missing, each resolved like an upgrade from nothing: the newest stable, non-deprecated version whose language is compatible (core: its orbLanguage.version is in the range this orb reads; any other package: its language range accepts the core language this update installs, else the installed one), read from its registry."
      orbPlatforms : [OrbPlatform] = [{ sysname: "Darwin", machine: "arm64", package: (quote "@almadar/orb-darwin-arm64"), os: "darwin", cpu: "arm64" }, { sysname: "Darwin", machine: "x86_64", package: (quote "@almadar/orb-darwin-x64"), os: "darwin", cpu: "x64" }, { sysname: "Linux", machine: "x86_64", package: (quote "@almadar/orb-linux-x64"), os: "linux", cpu: "x64" }, { sysname: "Linux", machine: "aarch64", package: (quote "@almadar/orb-linux-arm64"), os: "linux", cpu: "arm64" }, { sysname: "Linux", machine: "arm64", package: (quote "@almadar/orb-linux-arm64"), os: "linux", cpu: "arm64" }, { sysname: "Windows_NT", machine: "AMD64", package: (quote "@almadar/orb-windows-x64"), os: "win32", cpu: "x64" }]
        @label "Orb platform packages"
        @description "The orb binary's own package per platform, keyed by the sysname and machine os/uname answers. `orb update --global` (not --urgent) asks os/uname and resolves the entry that matches this host like a baseline package, in the registry knob, but on its own compatibility rule: an orb platform package has no language range, so a version is compatible when its package.json declares orbReads, a range of core languages, and the target core language satisfies it (a version with no orbReads is skipped ORB_PACKAGE_NO_LANGUAGE). A host that matches no entry, or whose os/uname fails, gets one loud ORB_PACKAGE_PLATFORM line on stderr and no orb package is considered."
      maxUnpackedBytes : number = 536870912
        @label "Largest unpacked tarball"
        @description "The most bytes a package tarball may inflate to; a larger one is refused ORB_PACKAGE_ARCHIVE (output-limit)."
      maxEntries : number = 100000
        @label "Most archive entries"
        @description "The most files a package archive may hold; more is refused ORB_PACKAGE_ARCHIVE (entry-limit)."
      programGlobs : [string] = ["**/*.lolo", "**/*.orb"]
        @label "Program globs"
        @description "The program files remove scans for imports of a behavior package prefix."
      skipDirs : [string] = ["/node_modules/", "/.git/", "/dist/", "/target/"]
        @label "Skipped directories"
        @description "Path fragments the remove import scan never reads."
    }

    listens {
      PK_REPLIED { status : number!  headers : Map string string  body : bytes!  key : string! }
        @description "Internal: the HTTP client's reply from the registry."
      PK_FAILED { key : string!  error : string!  kind : string! }
        @description "Internal: the registry call produced no reply."
      RegistryHttp.HTTP_REPLIED -> PK_REPLIED
      RegistryHttp.HTTP_FAILED -> PK_FAILED
      SourceHttp.HTTP_REPLIED -> PK_REPLIED
      SourceHttp.HTTP_FAILED -> PK_FAILED
      PACKAGES_CALLED -> inbound "cli-packages" answers PACKAGES_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb list|add|update|remove` with its arguments and working directory."
        @synonyms "orb add, orb remove, orb list, orb update, install a package"
      PKG_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      PKG_SAT { requestId : string!  value : boolean! }
        @description "std-semver's SEMVER_SATISFIED: the range check answered."
      PKG_SAT_REFUSED { requestId : string!  operation : string!  reason : string! }
        @description "std-semver's SEMVER_REFUSED: the range check refused."
      Versions.SEMVER_SATISFIED -> PKG_SAT
      Versions.SEMVER_REFUSED -> PKG_SAT_REFUSED
      ArgsCli.ARGS_PARSED -> PKG_ARGS_DONE
    }
  }

  page boot as OrbPackagesOrbitalStart -> OrbPackages, ArgsCli, Versions, RegistryHttp, SourceHttp
}
