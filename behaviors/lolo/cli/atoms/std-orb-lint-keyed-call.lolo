app std-orb-lint-keyed-call [
  version: "1.0.0",
  inbound: ["cli-lint-keyed-call"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-keyed-call — the `orb lint keyed-call <file>` command, the port of the key-and-emit rules of keyed_call.rs that need no type inference: ORB_EFFECT_OPTION_DROPPED (a `persist` or `fetch` whose options object declares both `emit` and `key`, which the completion never echoes; reported at the top effect of the transition or tick, once per such call) and ORB_CALL_SERVICE_KEY_DUPLICATE (two `call-service` calls in one transition whose trailing options carry the same literal `key`; a key starting with @ or ? is computed and never duplicates; reported at the second call). It needs the RESOLVED program (program/read resolve), so a `use`-imported atom's traits are checked too. Findings print as `[code] path: message` (status 500, exit 1); clean answers `lint keyed-call: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500. ORB_CALL_KEY_UNUSED, ORB_CANCEL_CALL_NO_KEYED_CALL and the key-expression type check are not ported here: they need the substrate and tab operator set or inferred expression types, which the lint input does not carry."
]
uses Spec from "almadar-std/lint-keyed-call"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type KcVal = string | number | boolean | [KcVal?] | Map string KcVal?
type KcTransition = { effects : [KcVal]? }
type KcTick = { effects : [KcVal]? }
type KcMachine = { transitions : [KcTransition]? }
type KcTrait = { name : string, stateMachine : KcMachine?, ticks : [KcTick]? }
type KcOrbital = { name : string, traits : [KcVal] }
type KcProgram = { orbitals : [KcOrbital] }
type KcHeads = [string]

orbital OrbLintKeyedCallOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintKeyedCallRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintKeyedCall -> OrbLintKeyedCallRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((sites (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                  (let ((o (array/nth @orbitals @oi)))
                    (let ((trs (object/get @o "traits" [])))
                      (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti
                        (let ((t (as (array/nth @trs @ti) KcTrait)))
                          (if (or (= @t null) (= (object/get @t "stateMachine" null) null))
                            []
                            [{ site: (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]"), trait: @t }]))))))))))))
            (let ((places (array/flatten (array/map @sites (fn s
                    (let ((sm (object/get (object/get @s "trait") "stateMachine")) (ticks (default (object/get (object/get @s "trait") "ticks" []) [])))
                      (let ((trans (default (object/get @sm "transitions" []) [])))
                        (array/concat
                          (array/flatten (array/map (array/range 0 (array/len @trans)) (fn i
                            (let ((effs (default (object/get (array/nth @trans @i) "effects" []) [])))
                              (array/map (array/range 0 (array/len @effs)) (fn j { path: (str/concat (object/get @s "site") ".stateMachine.transitions[" @i "].effects[" @j "]"), effect: (array/nth @effs @j) }))))))
                          (array/flatten (array/map (array/range 0 (array/len @ticks)) (fn i
                            (let ((effs (default (object/get (array/nth @ticks @i) "effects" []) [])))
                              (array/map (array/range 0 (array/len @effs)) (fn j { path: (str/concat (object/get @s "site") ".ticks[" @i "].effects[" @j "]"), effect: (array/nth @effs @j) }))))))))))))))
              (array/concat
                (array/flatten (array/map @places (fn pl
                  (array/map (default (as (default (tree/fold (object/get @pl "effect") (fn (n k)
                      (array/concat
                        (if (and (validate/array @n) (> (array/len @n) 0) (validate/string (array/first @n)) (array/includes ["persist", "fetch"] (array/first @n))
                              (array/some (array/slice @n 1 (array/len @n)) (fn a (and (validate/object @a) (object/has @a "emit") (object/has @a "key")))))
                          [(array/first @n)]
                          [])
                        (if (validate/array @n) (array/flatten (array/filter @k (fn c (!= @c null)))) (if (validate/object @n) (array/flatten (array/map (object/keys @k) (fn key (default (object/get @k @key []) [])))) [])))) KcVal) []) KcHeads) []) (fn head
                    { code: "ORB_EFFECT_OPTION_DROPPED", path: (object/get @pl "path"), message: (str/concat "`" @head "` carries no `key`, so its completion would never echo the `key` its options declare"), suggestion: (str/concat "Remove `key` from the `" @head "` options, or tell the arm apart by its event"), severity: "error" })))))
                (array/flatten (array/map @sites (fn s
                  (let ((trans (default (object/get (object/get (object/get @s "trait") "stateMachine") "transitions" []) [])))
                    (array/flatten (array/map (array/range 0 (array/len @trans)) (fn i
                      (let ((effs (default (object/get (array/nth @trans @i) "effects" []) [])))
                        (let ((keys (array/map @effs (fn e
                                (if (and (validate/array @e) (> (array/len @e) 4) (validate/string (array/first @e)) (= (array/first @e) "call-service"))
                                  (let ((opts (array/nth @e (- (array/len @e) 1))))
                                    (if (and (validate/object @opts) (or (object/has @opts "emit") (object/has @opts "key")))
                                      (let ((k (object/get @opts "key" null)))
                                        (if (and (validate/string @k) (not (str/startsWith @k (quote "@"))) (not (str/startsWith @k "?"))) @k null))
                                      null))
                                  null)))))
                          (array/flatten (array/map (array/range 0 (array/len @keys)) (fn j
                            (let ((k (array/nth @keys @j)))
                              (if (or (= @k null) (not (array/includes (array/slice @keys 0 @j) @k)))
                                []
                                [{ code: "ORB_CALL_SERVICE_KEY_DUPLICATE", path: (str/concat (object/get @s "site") ".stateMachine.transitions[" @i "].effects[" @j "]"), message: (str/concat "call-service key '" @k "' is already used by another call in this transition"), suggestion: "Give each call-service of a transition its own key", severity: "error" }])))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "keyed-call", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : KcProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintKeyedCallCli -> OrbLintKeyedCallRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint keyed-call <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "keyed-call") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint keyed-call: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "keyed-call") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint keyed-call: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-keyed-call" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint keyed-call` with its arguments and working directory."
        @synonyms "orb lint keyed-call"
      OrbLintKeyedCall.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintKeyedCallCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintKeyedCallOrbitalStart -> OrbLintKeyedCall, OrbLintKeyedCallCli, OrbLintInput, Packs, Versions
}
