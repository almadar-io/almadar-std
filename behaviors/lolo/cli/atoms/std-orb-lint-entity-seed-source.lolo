app std-orb-lint-entity-seed-source [
  version: "1.0.0",
  inbound: ["cli-lint-entity-seed-source"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-entity-seed-source — the `orb lint entity-seed-source <file>` command, the port of ORB_E_SEED_SOURCE_CONFLICT (entity.rs validate_browser_storage; primary and auxiliary entities). It lowers the file with program/read and reports, per orbital entity, a `mock` seed declared together with written-out instances or locale instances, with the Rust path, message and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-seed-source: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-seed-source"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintEntitySeedSourceOrbital {
  entity OrbLintEntitySeedSourceRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntitySeedSource -> OrbLintEntitySeedSourceRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-seed-source", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((auxs (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
             (array/flatten (array/map
              (array/concat [{ ent: (object/get (array/nth @orbitals @oi) "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
              (fn eb
            (let ((ent (object/get @eb "ent")))
              (if (and (validate/object @ent) (not (object/get (array/nth @orbitals @oi) "spec" false))) (let ((rows (object/get @ent "instances" [])) (locRows (object/get @ent "localeInstances" {})))
                (if (and (object/get @ent "seedMock" false) (or (> (array/len @rows) 0) (> (array/len (object/keys @locRows)) 0)))
                  [{ code: "ORB_E_SEED_SOURCE_CONFLICT", path: (str/concat (object/get @eb "base") ".instances"), message: (str/concat "Entity '" (object/get @ent "name" "") "' declares both `mock` seeding and written-out `instances` — exactly one seed source"), suggestion: "Keep the written-out rows, or drop them and keep `mock`.", severity: "error" }]
                  [])) [])))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "entity-seed-source" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintEntitySeedSourceCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintEntitySeedSourceCli -> OrbLintEntitySeedSourceRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-seed-source <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-seed-source") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-seed-source: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-seed-source") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "entity-seed-source")
        (emit LINT_ANSWERED { status: 500, body: "lint entity-seed-source: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-seed-source" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-seed-source` with its arguments and working directory."
        @synonyms "orb lint entity-seed-source, seed source"
      OrbLintEntitySeedSource.LINT_FOUND -> LINT_FOUND
      OrbLintEntitySeedSource.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-entity-seed-source" as OrbLintEntitySeedSourcePage -> OrbLintEntitySeedSource, OrbLintEntitySeedSourceCli
}
