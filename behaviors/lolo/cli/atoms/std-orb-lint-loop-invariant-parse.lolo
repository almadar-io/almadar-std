app std-orb-lint-loop-invariant-parse [
  version: "1.0.0",
  inbound: ["cli-lint-loop-invariant-parse"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-loop-invariant-parse — the `orb lint loop-invariant-parse <file>` command. It lowers the file with program/read and walks the guard and every effect of every inline trait transition: inside the lambda of any operator taking an fn, a call to json/parse or bytes/to-string whose argument references none of that lambda's parameters, nor a name bound by a let or an inner lambda inside it, re-parses the same value for every element. Each such call is a warning ORB_W_LOOP_INVARIANT_PARSE; a call is judged against its nearest enclosing lambda and reported once. Across transitions of one orbital, a json/parse of an entity field (or of a record key read from it with object/get, directly or through array/first, array/last or array/nth) whose every set writes a json/stringify result (a whole value, or the key of an appended or assigned record) is ORB_JSON_ROUNDTRIP at the parse site; one set from any other value makes the parse legitimate. Clean answers `lint loop-invariant-parse: clean` (status 200, exit 0); warnings fail the run like errors (status 500, exit 1). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-loop-invariant-parse"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LoopExpr = string | number | boolean | [LoopExpr?] | Map string LoopExpr?
type LoopTransition = { guard : LoopExpr?, effects : [LoopExpr?] }
type LoopMachine = { transitions : [LoopTransition] }
type LoopTrait = { name : string, stateMachine : LoopMachine }
type LoopOrbital = { name : string, traits : [LoopTrait] }
type LoopInvariantProgram = { orbitals : [LoopOrbital]! }

type RtVal = string | number | boolean | [RtVal?] | Map string RtVal?
type RtCall = { path : string!, node : RtVal! }
type RtIndex = Map string [RtCall]
type RtWrite = { o : string!, f : string!, v : RtVal, w : string! }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintLoopInvariantParseCodes = { lintNodeUnchecked : LintCodeDecl , wLoopInvariantParse : LintCodeDecl , jsonRoundtrip : LintCodeDecl }

orbital OrbLintLoopInvariantParseOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintLoopInvariantParseRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintLoopInvariantParse -> OrbLintLoopInvariantParseRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                  (let ((trs (object/get (object/get @td "stateMachine" {}) "transitions" [])))
                    (array/flatten (array/map (array/range 0 (array/len @trs)) (fn tj
                      (let ((tr (array/nth @trs @tj)) (base (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")].stateMachine.transitions[" @tj "]")))
                        (let ((roots (array/concat
                                (if (object/has @tr "guard") [{ w: (str/concat @base ".guard"), e: (object/get @tr "guard") }] [])
                                (array/map (array/range 0 (array/len (object/get @tr "effects" []))) (fn ei { w: (str/concat @base ".effects[" @ei "]"), e: (array/nth (object/get @tr "effects" []) @ei) })))))
                          (array/flatten (array/map @roots (fn x
                            (let ((fres (tree/fold (object/get @x "e")
                                  (fn (n k)
                                    (if (validate/array @n)
                                      (let ((op (let ((o0 (array/nth @n 0))) (if (validate/string @o0) @o0 ""))) (all (array/flatten (array/filter @k (fn r (!= @r null))))))
                                        (if (= @op "fn")
                                          (let ((p (array/nth @n 1)))
                                            (let ((params (if (validate/string @p) [@p] (if (validate/array @p) (array/flatten (array/map @p (fn q (if (validate/string @q) [@q] [])))) [])))
                                                  (inner @all))
                                              (let ((bound (array/concat @params (array/map (array/filter @inner (fn f (= (object/get @f "kind") "bind"))) (fn f (object/get @f "name"))))))
                                                (array/concat
                                                  (array/filter @all (fn f (!= (object/get @f "kind") "call")))
                                                  (array/map @params (fn q { kind: "bind", name: @q, op: "", refs: (array/filter [""] (fn q false)), binds: (array/filter [""] (fn q false)) }))
                                                  (array/map
                                                    (array/filter @inner (fn c (and (= (object/get @c "kind") "call") (not (array/some (object/get @c "refs") (fn nm (and (not (array/includes (object/get @c "binds") @nm)) (array/includes @bound @nm))))))))
                                                    (fn c { kind: "hit", name: "", op: (object/get @c "op"), refs: (array/filter [""] (fn q false)), binds: (array/filter [""] (fn q false)) }))))))
                                          (if (= @op "let")
                                            (let ((bs (array/nth @n 1)))
                                              (array/concat @all
                                                (if (validate/array @bs) (array/flatten (array/map @bs (fn b (if (validate/array @b) (let ((nm (array/nth @b 0))) (if (validate/string @nm) [{ kind: "bind", name: @nm, op: "", refs: (array/filter [""] (fn q false)), binds: (array/filter [""] (fn q false)) }] [])) [])))) [])))
                                            (if (or (= @op "json/parse") (= @op "bytes/to-string"))
                                              (let ((arg @all) (a1 (if (> (array/len @n) 1) (array/nth @n 1) "")))
                                                (array/concat
                                                  (array/append @all { kind: "call", name: "", op: @op, refs: (array/map (array/filter @arg (fn f (= (object/get @f "kind") "ref"))) (fn f (object/get @f "name"))), binds: (array/map (array/filter @arg (fn f (= (object/get @f "kind") "bind"))) (fn f (object/get @f "name"))) })
                                                  (if (and (= @op "json/parse") (validate/array @a1) (> (array/len @a1) 0) (= (let ((h (array/nth @a1 0))) (if (validate/string @h) @h "")) "json/stringify")) [{ kind: "roundtrip", name: "", op: @op, refs: (array/filter [""] (fn q false)), binds: (array/filter [""] (fn q false)) }] [])))
                                              @all))))
                                      (if (and (validate/string @n) (str/startsWith @n (quote "@")))
                                        [{ kind: "ref", name: (array/first (str/split (str/slice @n 1 (str/len @n)) ".")), op: "", refs: (array/filter [""] (fn q false)), binds: (array/filter [""] (fn q false)) }]
                                        [])))
                                  LoopExpr))) (if (= @fres null) (let ((up (object/get @x "w"))) [{ code: @config.codes.lintNodeUnchecked.code, path: @up, message: (str/concat @payload.file ": schema node at " @up " is not a LoopExpr; this rule could not check it"), suggestion: "", severity: "error" }]) (array/concat (array/map
                              (array/filter
                                @fres
                                (fn f (= (object/get @f "kind") "hit")))
                              (fn c
                                { code: @config.codes.wLoopInvariantParse.code, path: (object/get @x "w"), message: (str/concat (object/get @c "op") " re-parses the same value for every element; bind it once with let outside the lambda"), suggestion: "Bind the parsed value once with `let` outside the lambda and use the bound name inside it.", severity: "warning" }))
                              (array/map
                                (array/filter @fres (fn f (= (object/get @f "kind") "roundtrip")))
                                (fn c
                                  { code: @config.codes.jsonRoundtrip.code, path: (object/get @x "w"), message: "json/parse re-parses a value json/stringify just serialized: this round trip launders the value's type past the checker", suggestion: "Narrow the value with `(as value T)` instead; keep json/parse for text that arrives as text (a body, a file, rawBody).", severity: "error" }))))))))))))))))))))))))
        (set @entity.findings (array/concat @entity.findings (let ((idx (default (as (tree/index @payload.program ["set" "json/parse"]) RtIndex) {})) (ent (quote "@entity.")))
          (let ((writes (array/flatten (array/map (object/get @idx "set" []) (fn c
                  (let ((n (object/get @c "node" null)) (cp (object/get @c "path" "")))
                    (if (and (validate/array @n) (> (array/len @n) 2))
                      (let ((t (array/nth @n 1)))
                        (if (and (validate/string @t) (str/startsWith @t @ent))
                          [{ o: (default (array/first (str/split @cp ".traits[")) ""), f: (str/slice @t (str/len @ent) (str/len @t)), v: (array/nth @n 2), w: @cp }]
                          []))
                      [])))))))
            (array/flatten (array/map (object/get @idx "json/parse" []) (fn p
              (let ((pn (object/get @p "node" null)) (pp (object/get @p "path" "")))
                (let ((po (default (array/first (str/split @pp ".traits[")) ""))
                      (slots (if (and (validate/array @pn) (> (array/len @pn) 1))
                               (let ((a (array/nth @pn 1)))
                                 (if (validate/string @a)
                                   (if (str/startsWith @a @ent) [{ f: (str/slice @a (str/len @ent) (str/len @a)), k: "" }] [])
                                   (if (and (validate/array @a) (> (array/len @a) 2) (= (array/nth @a 0) "object/get"))
                                     (let ((x (array/nth @a 1)) (kk (array/nth @a 2)))
                                       (let ((r (if (validate/array @x)
                                                  (if (and (> (array/len @x) 1) (array/includes ["array/first" "array/last" "array/nth"] (array/nth @x 0))) (array/nth @x 1) "")
                                                  @x)))
                                         (if (and (validate/string @kk) (validate/string @r) (str/startsWith @r @ent))
                                           [{ f: (str/slice @r (str/len @ent) (str/len @r)), k: @kk }]
                                           [])))
                                     [])))
                               [])))
                  (array/flatten (array/map @slots (fn sl
                    (let ((f (object/get @sl "f")) (k (object/get @sl "k")))
                      (let ((mine (array/filter @writes (fn w (and (= (object/get @w "o") @po) (= (object/get @w "f") @f))))))
                        (let ((kinds (array/map @mine (fn w
                                (let ((v (object/get @w "v" null)) (ww (object/get @w "w")))
                                  (let ((kd (if (validate/array @v)
                                      (let ((h (let ((h0 (array/nth @v 0))) (if (validate/string @h0) @h0 ""))))
                                        (if (= @h "json/stringify")
                                          (if (= @k "") "str" "other")
                                          (if (and (> (array/len @v) 1) (= (array/nth @v 1) (str/concat @ent @f)))
                                            (if (array/includes ["array/drop" "array/take" "array/filter" "array/rest" "array/slice"] @h)
                                              "skip"
                                              (if (and (= @h "array/append") (!= @k "") (= (array/len @v) 3))
                                                (let ((m (array/nth @v 2)))
                                                  (if (validate/object @m)
                                                    (if (object/has @m @k)
                                                      (let ((e (object/get @m @k))) (if (and (validate/array @e) (= (array/nth @e 0) "json/stringify")) "str" "other"))
                                                      "skip")
                                                    "other"))
                                                "other"))
                                            "other")))
                                      (if (and (validate/object @v) (!= @k ""))
                                        (if (object/has @v @k)
                                          (let ((e (object/get @v @k))) (if (and (validate/array @e) (= (array/nth @e 0) "json/stringify")) "str" "other"))
                                          "skip")
                                        "other"))))
                                    { w: @ww, kind: @kd })))))
                              (stringified (array/filter @kinds (fn q (= (object/get @q "kind") "str")))))
                          (if (and (> (array/len @stringified) 0) (not (array/some @kinds (fn q (= (object/get @q "kind") "other")))))
                            [{ code: @config.codes.jsonRoundtrip.code, path: @pp, message: (str/concat "json/parse re-parses entity field '" @f (if (= @k "") "" (str/concat "." @k)) "' whose every write is a json/stringify (written in " (default (array/first (str/split (object/get (default (array/first @stringified) {}) "w" "") ".effects[")) "") "): this round trip launders the value's type past the checker"), suggestion: "Store the typed value in the field, or narrow it with `(as value T)`; keep json/parse for text that arrives as text (a body, a file, rawBody).", severity: "error" }]
                            []))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "loop-invariant-parse", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LoopInvariantProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintLoopInvariantParseCodes = { lintNodeUnchecked: { code: "LINT_NODE_UNCHECKED", category: "lint", description: "A lint rule met a schema node of an unexpected shape and could not check it" }, wLoopInvariantParse: { code: "ORB_W_LOOP_INVARIANT_PARSE", category: "lint", description: "A parse inside a lambda re-parses the same value for every element and should be bound once outside" } , jsonRoundtrip: { code: "ORB_JSON_ROUNDTRIP", category: "lint", description: "json/parse re-parses what json/stringify just serialized; a stringify→parse round trip launders a value's type past the checker (owner hard rule, CLAUDE.md). Narrow with `as`." } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintLoopInvariantParseCli -> OrbLintLoopInvariantParseRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint loop-invariant-parse <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint loop-invariant-parse <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint loop-invariant-parse <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "loop-invariant-parse") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint loop-invariant-parse: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "loop-invariant-parse") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint loop-invariant-parse: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-loop-invariant-parse" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint loop-invariant-parse` with its arguments and working directory."
        @synonyms "orb lint loop-invariant-parse, duplicate field names"
      OrbLintLoopInvariantParse.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintLoopInvariantParseCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintLoopInvariantParseOrbitalStart -> OrbLintLoopInvariantParse, OrbLintLoopInvariantParseCli, OrbLintInput, Packs, Versions
}
