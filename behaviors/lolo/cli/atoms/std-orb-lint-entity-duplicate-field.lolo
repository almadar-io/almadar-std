app std-orb-lint-entity-duplicate-field [
  version: "1.0.0",
  inbound: ["cli-lint-entity-duplicate-field"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-entity-duplicate-field — the `orb lint entity-duplicate-field <file>` command, the port. It lowers the file with program/read and, for every orbital's inline entity, reports each field whose non-empty name an earlier field of the same entity already uses, with the Rust path, message and suggestion (status 500, exit 1). Unnamed fields are skipped. Clean answers `lint entity-duplicate-field: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-duplicate-field"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintEntityDuplicateFieldOrbital {
  entity OrbLintEntityDuplicateFieldRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintEntityDuplicateField -> OrbLintEntityDuplicateFieldRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-duplicate-field", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ent (object/get (array/nth @orbitals @oi) "entity" {})))
              (if (validate/object @ent) (let ((fields (object/get @ent "fields" [])))
                (let ((names (array/map @fields (fn f (object/get @f "name" "")))))
                  (array/flatten (array/map (array/range 0 (array/len @names)) (fn fi
                    (let ((nm (array/nth @names @fi)))
                      (if (or (= @nm "") (= (array/len (array/filter (array/range 0 @fi) (fn k (= (array/nth @names @k) @nm)))) 0))
                        []
                        [(str/concat "[ORB_E_DUPLICATE_FIELD] orbitals[" @oi "].entity.fields[" @fi "].name: Duplicate field name: '" @nm "'\n  suggestion: Each field must have a unique name within the entity")]))))))) [])))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "entity-duplicate-field" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintEntityDuplicateFieldCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintEntityDuplicateFieldCli -> OrbLintEntityDuplicateFieldRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-duplicate-field <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-duplicate-field") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-duplicate-field: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-duplicate-field") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "entity-duplicate-field")
        (emit LINT_ANSWERED { status: 500, body: "lint entity-duplicate-field: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-duplicate-field" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-duplicate-field` with its arguments and working directory."
        @synonyms "orb lint entity-duplicate-field, duplicate field names"
      OrbLintEntityDuplicateField.LINT_FOUND -> LINT_FOUND
      OrbLintEntityDuplicateField.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-entity-duplicate-field" as OrbLintEntityDuplicateFieldPage -> OrbLintEntityDuplicateField, OrbLintEntityDuplicateFieldCli
}
