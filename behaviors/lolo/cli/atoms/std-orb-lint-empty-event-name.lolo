app std-orb-lint-empty-event-name [
  version: "1.0.0",
  inbound: ["cli-lint-empty-event-name"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-empty-event-name — the `orb lint empty-event-name <file>` command, the port of ORB_T_EMPTY_EVENT_NAME (trait_validator.rs validate_state_machine). It lowers the file with program/read and, for every inline trait with at least one state, reports an empty key in stateMachine.events, an empty event in the trait emits and an empty event in stateMachine.transitions, in that order, each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint empty-event-name: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-empty-event-name"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintEmptyEventNameOrbital {
  entity OrbLintEmptyEventNameRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEmptyEventName -> OrbLintEmptyEventNameRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "empty-event-name", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((trList (object/get (array/nth @orbitals @oi) "traits" [])))
              (array/flatten (array/map (array/range 0 (array/len @trList)) (fn ti
                (let ((td (array/nth @trList @ti)))
                  (if (not (validate/object (object/get @td "stateMachine" null)))
                    []
                    (let ((sm (object/get @td "stateMachine")) (tpath (str/concat "orbitals[" @oi "].traits[" @ti "]")))
                      (let ((sts (object/get @sm "states" [])) (where (str/concat @tpath ".stateMachine")))
                        (if (= (array/len @sts) 0)
                          []
                          (array/flatten [
                            (array/flatten (array/map (array/range 0 (array/len (object/get @sm "events" []))) (fn k (if (= (object/get (array/nth (object/get @sm "events" []) @k) "key" "") "") [{ code: "ORB_T_EMPTY_EVENT_NAME", path: (str/concat @where ".events" "[" @k "].key"), message: "Event name is empty", suggestion: "Name the event, or remove it; an unset optional event knob declares no event", severity: "error" }] []))))
                            (array/flatten (array/map (array/range 0 (array/len (object/get @td "emits" []))) (fn k (if (= (object/get (array/nth (object/get @td "emits" []) @k) "event" "") "") [{ code: "ORB_T_EMPTY_EVENT_NAME", path: (str/concat @tpath ".emits" "[" @k "].event"), message: "Event name is empty", suggestion: "Name the event, or remove it; an unset optional event knob declares no event", severity: "error" }] []))))
                            (array/flatten (array/map (array/range 0 (array/len (object/get @sm "transitions" []))) (fn k (if (= (object/get (array/nth (object/get @sm "transitions" []) @k) "event" "") "") [{ code: "ORB_T_EMPTY_EVENT_NAME", path: (str/concat @where ".transitions" "[" @k "].event"), message: "Event name is empty", suggestion: "Name the event, or remove it; an unset optional event knob declares no event", severity: "error" }] []))))])))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "empty-event-name" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintEmptyEventNameCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintEmptyEventNameCli -> OrbLintEmptyEventNameRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint empty-event-name <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "empty-event-name") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint empty-event-name: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "empty-event-name") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "empty-event-name")
        (emit LINT_ANSWERED { status: 500, body: "lint empty-event-name: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-empty-event-name" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint empty-event-name` with its arguments and working directory."
        @synonyms "orb lint empty-event-name"
      OrbLintEmptyEventName.LINT_FOUND -> LINT_FOUND
      OrbLintEmptyEventName.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-empty-event-name" as OrbLintEmptyEventNamePage -> OrbLintEmptyEventName, OrbLintEmptyEventNameCli
}
