app std-orb-lint-empty-event-name [
  version: "1.0.0",
  inbound: ["cli-lint-empty-event-name"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-empty-event-name — the `orb lint empty-event-name <file>` command, the port of ORB_T_EMPTY_EVENT_NAME (trait_validator.rs validate_state_machine). It lowers the file with program/read and, for every inline trait with at least one state, reports an empty key in stateMachine.events, an empty event in the trait emits and an empty event in stateMachine.transitions, in that order, each with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint empty-event-name: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-empty-event-name"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type EmptyEventState = { name : string }
type EmptyEventKey = { key : string }
type EmptyEventTransition = { event : string }
type EmptyEventMachine = { states : [EmptyEventState], events : [EmptyEventKey], transitions : [EmptyEventTransition] }
type EmptyEventEmit = { event : string }
type EmptyEventTrait = { stateMachine : EmptyEventMachine, emits : [EmptyEventEmit] }
type EmptyEventOrbital = { traits : [EmptyEventTrait] }
type EmptyEventProgram = { orbitals : [EmptyEventOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEmptyEventNameCodes = { tEmptyEventName : LintCodeDecl }

orbital OrbLintEmptyEventNameOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEmptyEventNameRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEmptyEventName -> OrbLintEmptyEventNameRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((trList (object/get (default (array/nth @orbitals @oi) {}) "traits" [])))
              (array/flatten (array/map (array/range 0 (array/len @trList)) (fn ti
                (let ((td (default (array/nth @trList @ti) {})))
                  (if (not (validate/object (object/get @td "stateMachine" null)))
                    []
                    (let ((sm (default (object/get @td "stateMachine") {})) (tpath (str/concat "orbitals[" @oi "].traits[" @ti "]")))
                      (let ((sts (object/get @sm "states" [])) (where (str/concat @tpath ".stateMachine")))
                        (if (= (array/len @sts) 0)
                          []
                          (array/flatten [
                            (array/flatten (array/map (array/range 0 (array/len (object/get @sm "events" []))) (fn k (if (= (object/get (array/nth (object/get @sm "events" []) @k) "key" "") "") [{ code: @config.codes.tEmptyEventName.code, path: (str/concat @where ".events" "[" @k "].key"), message: "Event name is empty", suggestion: "Name the event, or remove it; an unset optional event knob declares no event", severity: "error" }] []))))
                            (array/flatten (array/map (array/range 0 (array/len (object/get @td "emits" []))) (fn k (if (= (object/get (array/nth (object/get @td "emits" []) @k) "event" "") "") [{ code: @config.codes.tEmptyEventName.code, path: (str/concat @tpath ".emits" "[" @k "].event"), message: "Event name is empty", suggestion: "Name the event, or remove it; an unset optional event knob declares no event", severity: "error" }] []))))
                            (array/flatten (array/map (array/range 0 (array/len (object/get @sm "transitions" []))) (fn k (if (= (object/get (array/nth (object/get @sm "transitions" []) @k) "event" "") "") [{ code: @config.codes.tEmptyEventName.code, path: (str/concat @where ".transitions" "[" @k "].event"), message: "Event name is empty", suggestion: "Name the event, or remove it; an unset optional event knob declares no event", severity: "error" }] []))))])))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "empty-event-name", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : EmptyEventProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintEmptyEventNameCodes = { tEmptyEventName: { code: "ORB_T_EMPTY_EVENT_NAME", category: "trait", description: "An event name is empty" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEmptyEventNameCli -> OrbLintEmptyEventNameRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (!= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint empty-event-name <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "empty-event-name") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint empty-event-name: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "empty-event-name") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint empty-event-name: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-empty-event-name" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint empty-event-name` with its arguments and working directory."
        @synonyms "orb lint empty-event-name"
      OrbLintEmptyEventName.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEmptyEventNameCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEmptyEventNameOrbitalStart -> OrbLintEmptyEventName, OrbLintEmptyEventNameCli, OrbLintInput, Packs, Versions
}
