          [{ path: (str/concat (if (= @entity.outDir "") (str/concat @entity.pack "/renderers") (str/concat @entity.outDir "/renderers")) "/CorePatternRegistry." @entity.ext),
             text: (str/replaceAll @entity.regTpl "{{entries}}" (str/join (array/concat
               (array/map @entity.pats (fn pr (let ((q (json/stringify (object/get @pr "name"))) (fnm (str/join (array/map (array/filter (str/split (str/replaceAll (object/get @pr "name") "_" "-") "-") (fn sg (> (str/len @sg) 0))) (fn sg (str/concat (str/upper (str/slice @sg 0 1)) (str/slice @sg 1)))) "")))
                 (if (= @entity.platform "ios")
                   (str/concat "        " @q ": { props, modifier, onEvent in " (if (array/includes @entity.natives (object/get @pr "name")) (str/concat @fnm "Renderer(props: props, modifier: modifier, onEvent: onEvent) }") (str/concat "FallbackRendererView(patternName: " @q ", props: props, modifier: modifier, onEvent: onEvent) }")))
                   (str/concat "        " @q " to { props, modifier, onEvent -> " (if (array/includes @entity.natives (object/get @pr "name")) (str/concat @fnm "Renderer(props, modifier, onEvent) }") (str/concat "FallbackRenderer(" @q ", props, modifier, onEvent) }")))))))
               (array/map (str/split "canvas|game-canvas|canvas-2d|game-canvas-2d" "|") (fn al (if (= @entity.platform "ios")
                 (str/concat "        " (json/stringify @al) ": { props, modifier, onEvent in GameCanvas2dRenderer(props: props, modifier: modifier, onEvent: onEvent) }")
                 (str/concat "        " (json/stringify @al) " to { props, modifier, onEvent -> GameCanvas2dRenderer(props, modifier, onEvent) }"))))
               (array/map (array/sort (object/get (json/parse @entity.listsText NativeLists) "canvas")) (fn cn (let ((fixed (array/includes (object/get (json/parse @entity.listsText NativeLists) "fixedSize") @cn)))
                 (if (= @entity.platform "ios")
                   (str/concat "        " (json/stringify @cn) ": { props, modifier, onEvent in LearningCanvasRenderer(pattern: " (json/stringify @cn) ", props: props, modifier: modifier, onEvent: onEvent" (if @fixed ", fixedSize: true" "") ") }")
                   (str/concat "        " (json/stringify @cn) " to { props, modifier, onEvent -> LearningCanvasRenderer(" (json/stringify @cn) ", props, modifier, onEvent" (if @fixed ", fixedSize = true" "") ") }")))))) ",\n")) }
           { path: (str/concat (if (= @entity.outDir "") @entity.pack @entity.outDir) "/package.json"),
             text: (str/concat "{\n  \"name\": " (json/stringify (object/get (json/parse @entity.manText PackManifest) "name")) ",\n  \"version\": " (json/stringify (object/get (json/parse @entity.manText PackManifest) "version")) ",\n  \"private\": true,\n  \"description\": " (json/stringify (object/get (json/parse @entity.manText PackManifest) "description")) ",\n  \"orbRenderer\": {\n    \"target\": " (json/stringify @entity.platform) ",\n    \"rendererInterface\": 2,\n    \"patternsRegistry\": " (json/stringify @entity.coreVer) ",\n    \"coverage\": [\n" (str/join (array/map (let ((all (array/sort (array/concat @entity.natives (object/get (json/parse @entity.listsText NativeLists) "canvas"))))) (array/filter @all (fn cv (= (array/indexOf @all @cv) @index)))) (fn cv (str/concat "      " (json/stringify @cv)))) ",\n") "\n    ],\n    \"sources\": \"renderers\",\n    \"fixtures\": \"fixtures\"\n  }\n}\n") }]))
        (set @entity.outFiles (let ((tk (json/parse @entity.tokText NativeTokens))) (array/concat @entity.outFiles
          [{ path: (str/concat (if (= @entity.outDir "") (str/concat @entity.pack "/renderers") (str/concat @entity.outDir "/renderers")) "/AlmadarBreakpoints." @entity.ext), text: (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll @entity.bpTpl "{{sm}}" (str/concat (object/get (object/get @tk "breakpoints") "sm"))) "{{md}}" (str/concat (object/get (object/get @tk "breakpoints") "md"))) "{{lg}}" (str/concat (object/get (object/get @tk "breakpoints") "lg"))) "{{xl}}" (str/concat (object/get (object/get @tk "breakpoints") "xl"))) "{{xxl}}" (str/concat (object/get (object/get @tk "breakpoints") "xxl"))) }
           { path: (str/concat (if (= @entity.outDir "") (str/concat @entity.pack "/renderers") (str/concat @entity.outDir "/renderers")) "/AlmadarSizes." @entity.ext), text: (str/replaceAll @entity.szTpl "{{members}}" (str/join (array/concat (array/map (object/get (object/get @tk "sizes") "maxWidth") (fn en (str/replaceAll (str/replaceAll (object/get (object/get @tk "sizeLine") @entity.ext) "{{name}}" (str/concat "maxW" (str/replaceAll (str/join (array/map (str/split (object/get @en "key") "-") (fn pt (str/concat (str/upper (str/slice @pt 0 1)) (str/slice @pt 1)))) "") "." "_"))) "{{value}}" (str/concat (object/get @en "value"))))) (array/map (object/get (object/get @tk "sizes") "width") (fn en (str/replaceAll (str/replaceAll (object/get (object/get @tk "sizeLine") @entity.ext) "{{name}}" (str/concat "w" (str/replaceAll (str/join (array/map (str/split (object/get @en "key") "-") (fn pt (str/concat (str/upper (str/slice @pt 0 1)) (str/slice @pt 1)))) "") "." "_"))) "{{value}}" (str/concat (object/get @en "value"))))) (array/map (object/get (object/get @tk "sizes") "minWidth") (fn en (str/replaceAll (str/replaceAll (object/get (object/get @tk "sizeLine") @entity.ext) "{{name}}" (str/concat "minW" (str/replaceAll (str/join (array/map (str/split (object/get @en "key") "-") (fn pt (str/concat (str/upper (str/slice @pt 0 1)) (str/slice @pt 1)))) "") "." "_"))) "{{value}}" (str/concat (object/get @en "value")))))) "\n")) }
           { path: (str/concat (if (= @entity.outDir "") (str/concat @entity.pack "/renderers") (str/concat @entity.outDir "/renderers")) "/VerificationIds." @entity.ext), text: (let ((cid (json/parse @entity.idsText CoreIds))) (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll @entity.vidTpl "{{actionOverflow}}" (str/concat (object/get @cid "actionPrefix") (object/get @cid "overflowKey"))) "{{actionPrefix}}" (object/get @cid "actionPrefix")) "{{separator}}" (object/get @cid "nativeIdSeparator")) "{{patternPrefix}}" (object/get (object/get @cid "nativeIdPrefix") "pattern")) "{{rowPrefix}}" (object/get (object/get @cid "nativeIdPrefix") "row")) "{{fieldPrefix}}" (object/get (object/get @cid "nativeIdPrefix") "field")) "{{slotPrefix}}" (object/get (object/get @cid "nativeIdPrefix") "slot")) "{{gestures}}" (str/join (array/map (let ((gv (object/values (object/get @cid "gestureEventProps")))) (array/filter @gv (fn g (= (array/indexOf @gv @g) @index)))) (fn gs (str/replaceAll (str/replaceAll (object/get (object/get @tk "gestureTpl") @entity.ext) "{{name}}" (str/camelCase @gs)) "{{prefix}}" (str/concat (object/get @cid "actionPrefix") @gs ":")))) ""))) }])))
        (set @entity.rcur 0)
        (set @entity.wcur 0)
        (emit NS_RM_NEXT { })
      NS_READ_FAIL -> ready
        (emit SHELL_RENDERERS_ANSWERED { status: 500, body: (str/concat "error: cannot read " @entity.curPath) })
    }

    state rscan {
      INIT -> rscan
      RS_LISTS_READ -> rscan
        (set @entity.listsText (bytes/to-string @payload.data))
        (set @entity.curPath @entity.registryPath)
        (os/read-file { anchor: "cwd" path: @entity.registryPath } { key: "registry", emit: { success: RS_REG_READ, failure: NS_READ_FAIL } })
      RS_REG_READ -> rscan
        (set @entity.liveNames (object/keys (object/get (json/parse (bytes/to-string @payload.data) PatReg) "patterns")))
        (set @entity.regText (bytes/to-string @payload.data))
        (set @entity.curPath @entity.mappingPath)
        (os/read-file { anchor: "cwd" path: @entity.mappingPath } { key: "mapping", emit: { success: RS_MAP_READ, failure: NS_READ_FAIL } })
      RS_MAP_READ -> rscan
        (set @entity.mapText (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/register.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/register.tpl") } { key: "regtpl", emit: { success: RS_TPL_READ, failure: NS_READ_FAIL } })
      RS_TPL_READ -> rscan
        (set @entity.rsReg (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/stub.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/stub.tpl") } { key: "stub", emit: { success: RS_STUB_READ, failure: RS_STUB_NONE } })
      RS_STUB_READ -> rscan
        (set @entity.rsStub (bytes/to-string @payload.data))
        (set @entity.dcur 0)
        (set @entity.outFiles (array/take @entity.outFiles 0))
        (set @entity.removals (array/take @entity.removals 0))
        (emit RS_DOM { })
      RS_STUB_NONE -> rscan
        (set @entity.dcur 0)
        (set @entity.outFiles (array/take @entity.outFiles 0))
        (set @entity.removals (array/take @entity.removals 0))
        (emit RS_DOM { })
      RS_DOM -> rscan when (< @entity.dcur (array/len @entity.domains))
        (set @entity.curDomain (array/nth @entity.domains @entity.dcur))
        (set @entity.rfiles (array/take @entity.rfiles 0))
        (set @entity.rrecs (array/take @entity.rrecs 0))
        (set @entity.tcur 0)
        (emit RS_LIST { })
      RS_LIST -> rscan when (< @entity.tcur 4)
        (os/list-dir { anchor: "cwd" path: (str/concat @entity.pack "/src/components/" @entity.curDomain "/" (array/nth (str/split "atoms|molecules|organisms|templates" "|") @entity.tcur)) } { key: "dir", emit: { success: RS_DIR, failure: RS_DIR_MISSING } })
      RS_DIR -> rscan
        (set @entity.rfiles (array/concat @entity.rfiles
          (array/map (array/filter @payload.entries (fn en (and (str/endsWith (object/get @en "name") ".rs") (!= (object/get @en "name") "mod.rs") (!= (object/get @en "name") "register.rs"))))
            (fn en (str/concat (array/nth (str/split "atoms|molecules|organisms|templates" "|") @entity.tcur) "/" (object/get @en "name"))))))
        (set @entity.tcur (+ @entity.tcur 1))
        (emit RS_LIST { })
      RS_DIR_MISSING -> rscan
        (set @entity.tcur (+ @entity.tcur 1))
        (emit RS_LIST { })
      RS_LIST -> rscan when (>= @entity.tcur 4)
        (set @entity.hcur 0)
        (emit RS_FREAD { })
      RS_FREAD -> rscan when (< @entity.hcur (array/len @entity.rfiles))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/src/components/" @entity.curDomain "/" (array/nth @entity.rfiles @entity.hcur)) } { key: "body", emit: { success: RS_FILE_READ, failure: RS_FILE_FAIL } })
      RS_FILE_READ -> rscan
        (set @entity.rrecs (array/append @entity.rrecs
          (let ((tx (bytes/to-string @payload.data)) (fk (array/nth @entity.rfiles @entity.hcur)))
            (let ((first (array/first (str/split @tx "\n"))))
              { tier: (array/first (str/split @fk "/")),
                module: (str/replaceAll (array/last (str/split @fk "/")) ".rs" ""),
                structName: (str/default (array/find (array/map (array/drop (str/split @tx "pub struct ") 1) (fn pc (object/get (array/reduce (str/split @pc "") { done: false, o: "" } (fn (a c) (if (object/get @a "done") @a (if (validate/pattern @c "^[A-Za-z0-9_]$") { done: false, o: (str/concat (object/get @a "o") @c) } { done: true, o: (object/get @a "o") })))) "o"))) (fn sn (str/endsWith @sn "Renderer"))) ""),
                prune: (and (validate/pattern @first "^//! Auto-generated (?:Dioxus )?renderer for the `([^`]+)` pattern\\.") (not (array/includes @entity.liveNames (array/nth (str/split @first "`") 1)))),
                fallback: (str/includes @tx "🔧") }))))
        (set @entity.hcur (+ @entity.hcur 1))
        (emit RS_FREAD { })
      RS_FILE_FAIL -> rscan
        (set @entity.hcur (+ @entity.hcur 1))
        (emit RS_FREAD { })
      RS_FREAD -> rscan when (>= @entity.hcur (array/len @entity.rfiles))
        (emit RS_BUILD { })
      RS_BUILD -> rscan
        (let ((dm (json/parse @entity.mapText MapReg)) (rg (json/parse @entity.regText PatReg)))
          (do
            (set @entity.rlive (array/filter @entity.rrecs (fn rc (and (not (object/get @rc "prune")) (!= (object/get @rc "structName") "")))))
            (set @entity.removals (array/concat @entity.removals (if (= @entity.outDir "") (array/map (array/filter @entity.rrecs (fn rc (object/get @rc "prune"))) (fn rc (str/concat @entity.curDomain "/" (object/get @rc "tier") "/" (object/get @rc "module") ".rs"))) (array/take @entity.removals 0))))
            (set @entity.rkeys (array/map @entity.rlive (fn rc (str/concat (object/get @rc "tier") "/" (object/get @rc "module")))))
            (set @entity.rstubs (if (= @entity.platform "tui")
              (array/map
                (array/filter (object/keys (object/get @dm "mappings"))
                  (fn nm (and (array/includes @entity.liveNames @nm)
                              (or (str/includes (str/default (object/get (object/get (object/get @dm "mappings") @nm) "importPath") "") (str/concat "/components/" @entity.curDomain "/"))
                                  (and (= @entity.curDomain "core") (str/includes (str/default (object/get (object/get (object/get @dm "mappings") @nm) "importPath") "") "/components/avl/")))
                              (not (array/includes @entity.rkeys (str/concat (object/get (object/get (object/get @rg "patterns") @nm) "tier") "/" (str/replaceAll @nm "-" "_")))))))
                (fn nm { name: @nm, tier: (object/get (object/get (object/get @rg "patterns") @nm) "tier"), module: (str/replaceAll @nm "-" "_"), structName: (str/concat (object/get (object/get (object/get @dm "mappings") @nm) "component") "Renderer") }))
              (array/take @entity.rstubs 0)))
            (emit RS_BUILD2 { })))
      RS_BUILD2 -> rscan
        (set @entity.rall (object/get (array/reduce (array/concat (array/map (array/sort (array/concat (array/map (array/filter @entity.rlive (fn rc (= (object/get @rc "tier") "atoms"))) (fn rc { sort: (str/collate-key (object/get @rc "module")), module: (object/get @rc "module"), structName: (object/get @rc "structName") })) (array/map (array/filter @entity.rstubs (fn st (= (object/get @st "tier") "atoms"))) (fn st { sort: (str/collate-key (object/get @st "module")), module: (object/get @st "module"), structName: (object/get @st "structName") }))) "sort") (fn k { tier: "atoms", module: (object/get @k "module"), structName: (object/get @k "structName"), alias: "" })) (array/map (array/sort (array/concat (array/map (array/filter @entity.rlive (fn rc (= (object/get @rc "tier") "molecules"))) (fn rc { sort: (str/collate-key (object/get @rc "module")), module: (object/get @rc "module"), structName: (object/get @rc "structName") })) (array/map (array/filter @entity.rstubs (fn st (= (object/get @st "tier") "molecules"))) (fn st { sort: (str/collate-key (object/get @st "module")), module: (object/get @st "module"), structName: (object/get @st "structName") }))) "sort") (fn k { tier: "molecules", module: (object/get @k "module"), structName: (object/get @k "structName"), alias: "" })) (array/map (array/sort (array/concat (array/map (array/filter @entity.rlive (fn rc (= (object/get @rc "tier") "organisms"))) (fn rc { sort: (str/collate-key (object/get @rc "module")), module: (object/get @rc "module"), structName: (object/get @rc "structName") })) (array/map (array/filter @entity.rstubs (fn st (= (object/get @st "tier") "organisms"))) (fn st { sort: (str/collate-key (object/get @st "module")), module: (object/get @st "module"), structName: (object/get @st "structName") }))) "sort") (fn k { tier: "organisms", module: (object/get @k "module"), structName: (object/get @k "structName"), alias: "" })) (array/map (array/sort (array/concat (array/map (array/filter @entity.rlive (fn rc (= (object/get @rc "tier") "templates"))) (fn rc { sort: (str/collate-key (object/get @rc "module")), module: (object/get @rc "module"), structName: (object/get @rc "structName") })) (array/map (array/filter @entity.rstubs (fn st (= (object/get @st "tier") "templates"))) (fn st { sort: (str/collate-key (object/get @st "module")), module: (object/get @st "module"), structName: (object/get @st "structName") }))) "sort") (fn k { tier: "templates", module: (object/get @k "module"), structName: (object/get @k "structName"), alias: "" }))) { used: [], out: [] }
          (fn (a e) (let ((al0 (str/concat (str/join (array/map (array/filter (str/split (object/get @e "module") "_") (fn sg (> (str/len @sg) 0))) (fn sg (str/concat (str/upper (str/slice @sg 0 1)) (str/slice @sg 1)))) "") "Renderer")))
            (let ((al (if (array/includes (object/get @a "used") @al0) (str/concat (str/join (array/map (array/filter (str/split (object/get @e "tier") "_") (fn sg (> (str/len @sg) 0))) (fn sg (str/concat (str/upper (str/slice @sg 0 1)) (str/slice @sg 1)))) "") (str/join (array/map (array/filter (str/split (object/get @e "module") "_") (fn sg (> (str/len @sg) 0))) (fn sg (str/concat (str/upper (str/slice @sg 0 1)) (str/slice @sg 1)))) "") "Renderer") @al0)))
              { used: (array/append (object/get @a "used") @al), out: (array/append (object/get @a "out") { tier: (object/get @e "tier"), module: (object/get @e "module"), structName: (object/get @e "structName"), alias: @al }) })))) "out"))
        (emit RS_BUILD3 { })
      RS_BUILD3 -> rscan
        (do
          (set @entity.outFiles (array/concat @entity.outFiles
            (array/map (str/split "atoms|molecules|organisms|templates" "|") (fn tr { path: (str/concat (str/concat (if (= @entity.outDir "") @entity.pack @entity.outDir) "/src/components/" @entity.curDomain "/") @tr "/mod.rs"),
              text: (str/concat "//! " @entity.curDomain " " @tr " renderers.\n\n" (str/join (array/map (array/filter @entity.rall (fn e (= (object/get @e "tier") @tr))) (fn e (str/concat "pub mod " (if (array/includes (object/get (json/parse @entity.listsText GateLists) "rustKeywords") (object/get @e "module")) (str/concat "r#" (object/get @e "module")) (object/get @e "module")) ";"))) "\n") "\n") }))
            (array/map @entity.rstubs (fn st { path: (str/concat (str/concat (if (= @entity.outDir "") @entity.pack @entity.outDir) "/src/components/" @entity.curDomain "/") (object/get @st "tier") "/" (object/get @st "module") ".rs"),
              text: (str/replaceAll (str/replaceAll @entity.rsStub "{{name}}" (object/get @st "name")) "{{Struct}}" (object/get @st "structName")) }))
            [{ path: (str/concat (str/concat (if (= @entity.outDir "") @entity.pack @entity.outDir) "/src/components/" @entity.curDomain "/") "mod.rs"), text: (str/concat "//! " @entity.curDomain " pattern renderers, mirroring almadar-ui/components/" @entity.curDomain ".\n\npub mod register;\n\npub mod atoms;\npub mod molecules;\npub mod organisms;\npub mod templates;\n") }
             { path: (str/concat (str/concat (if (= @entity.outDir "") @entity.pack @entity.outDir) "/src/components/" @entity.curDomain "/") "register.rs"),
               text: (str/replaceAll (str/replaceAll (str/replaceAll @entity.rsReg "{{domain}}" @entity.curDomain)
                 "{{imports}}" (str/join (array/map @entity.rall (fn e (str/concat "use crate::components::" @entity.curDomain "::" (object/get @e "tier") "::" (if (array/includes (object/get (json/parse @entity.listsText GateLists) "rustKeywords") (object/get @e "module")) (str/concat "r#" (object/get @e "module")) (object/get @e "module")) "::" (object/get @e "structName") " as " (object/get @e "alias") ";"))) "\n"))
                 "{{registrations}}" (str/join (array/map @entity.rall (fn e (str/concat "    registry.register(Box::new(" (object/get @e "alias") "));"))) "\n")) }]))
          (set @entity.offenders (array/concat @entity.offenders
            (array/map (array/filter @entity.rlive (fn rc (object/get @rc "fallback"))) (fn rc (str/concat @entity.curDomain "/" (object/get @rc "tier") "/" (object/get @rc "module") ".rs")))
            (array/map @entity.rstubs (fn st (str/concat @entity.curDomain "/" (object/get @st "tier") "/" (object/get @st "module") ".rs")))))
          (set @entity.summary (str/concat @entity.summary (if (= @entity.summary "") "" "; ") @entity.curDomain " " (array/len @entity.rall) " renderers (" (array/len @entity.rstubs) " stub(s))"))
          (set @entity.dcur (+ @entity.dcur 1))
          (emit RS_DOM { }))
      RS_DOM -> pruning when (>= @entity.dcur (array/len @entity.domains))
        (set @entity.outFiles (array/append @entity.outFiles { path: (str/concat (if (= @entity.outDir "") @entity.pack @entity.outDir) "/src/components/mod.rs"), text: (str/concat "//! Component-structured renderers mirroring almadar-ui/components.\n\n" (str/join (array/map (array/sort (array/map @entity.domains (fn dn { sort: @dn, name: @dn })) "sort") (fn k (str/concat "pub mod " (object/get @k "name") ";\n"))) "")) }))
        (set @entity.summary (str/concat @entity.platform ": " @entity.summary " (" (array/len @entity.removals) " orphan(s) " (if (= @entity.outDir "") "pruned" "found") ")" (if (> (array/len @entity.offenders) 0) (str/concat "\nerror: " (array/len @entity.offenders) " placeholder renderer(s), implement a real renderer for each:\n" (str/join (array/map (array/sort (array/map @entity.offenders (fn o { sort: @o, name: @o })) "sort") (fn k (str/concat "  " (object/get @k "name")))) "\n")) "")))
        (set @entity.bad @entity.offenders)
        (set @entity.rmBase "/src/components/")
        (set @entity.rcur 0)
        (set @entity.wcur 0)
        (emit NS_RM_NEXT { })
    }

    state pruning {
      INIT -> pruning
      NS_RM_NEXT -> pruning when (< @entity.rcur (array/len @entity.removals))
        (os/remove { anchor: "cwd" path: (str/concat @entity.pack @entity.rmBase (array/nth @entity.removals @entity.rcur)) } { key: "rm", emit: { success: NS_RM_OK, failure: SHELL_W_FAILED } })
      NS_RM_OK -> pruning
        (set @entity.rcur (+ @entity.rcur 1))
        (emit NS_RM_NEXT { })
      NS_RM_NEXT -> writing when (>= @entity.rcur (array/len @entity.removals))
        (emit SHELL_W_NEXT { })
    }

    state writing {
      INIT -> writing
      SHELL_W_NEXT -> writing when (and (< @entity.wcur (array/len @entity.outFiles)) (!= @entity.outDir ""))
        (os/mkdir { anchor: "cwd" path: (os/path-dir (object/get (array/nth @entity.outFiles @entity.wcur) "path")) } true { key: "mkdir", emit: { success: SHELL_W_MKDIR, failure: SHELL_W_FAILED } })
      SHELL_W_NEXT -> writing when (and (< @entity.wcur (array/len @entity.outFiles)) (= @entity.outDir ""))
        (emit SHELL_W_WRITE { })
      SHELL_W_MKDIR -> writing
        (emit SHELL_W_WRITE { })
      SHELL_W_WRITE -> writing
        (os/write-file { anchor: "cwd" path: (object/get (array/nth @entity.outFiles @entity.wcur) "path") } (bytes/from-string (object/get (array/nth @entity.outFiles @entity.wcur) "text")) { key: "write", emit: { success: SHELL_W_WROTE, failure: SHELL_W_FAILED } })
      SHELL_W_WROTE -> writing
        (set @entity.wcur (+ @entity.wcur 1))
        (emit SHELL_W_NEXT { })
      SHELL_W_FAILED -> ready
        (emit SHELL_RENDERERS_ANSWERED { status: 500, body: (str/concat "error: cannot write " (object/get (array/nth @entity.outFiles @entity.wcur) "path")) })
      SHELL_W_NEXT -> ready when (>= @entity.wcur (array/len @entity.outFiles))
        (emit SHELL_RENDERERS_ANSWERED { status: (if (and (= (array/len @entity.bad) 0) (= (array/len @entity.violations) 0)) 200 500), body: @entity.summary })
    }

    emits {
      SHELL_RENDERERS_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      SHELL_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the words after the target against the --table and --out flags."
        @tier "internal"
      NS_LISTS_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_REG_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_VER_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_STUB_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_TPL_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_MAN_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_FILE_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_DIR {
        entries : [DirEntry]!
      }
        @description "A tier directory listing."
        @tier "internal"
      NS_RM_OK { }
        @description "An orphan removed."
        @tier "internal"
      NS_READ_FAIL { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_DIR_MISSING { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_FILE_FAIL { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_LIST { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_FREAD { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_BUILD { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_RM_NEXT { }
        @description "Internal: native renderer plan step."
        @tier "internal"
      NS_TOK_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_BP_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_SZ_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_VID_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      NS_IDS_READ {
        data : bytes!
      }
        @description "A file read for the native renderer plan."
        @tier "internal"
      RS_LISTS_READ {
        data : bytes!
      }
        @description "A file read for the Rust renderer plan."
        @tier "internal"
      RS_REG_READ {
        data : bytes!
      }
        @description "A file read for the Rust renderer plan."
        @tier "internal"
      RS_MAP_READ {
        data : bytes!
      }
        @description "A file read for the Rust renderer plan."
        @tier "internal"
      RS_TPL_READ {
        data : bytes!
      }
        @description "A file read for the Rust renderer plan."
        @tier "internal"
      RS_STUB_READ {
        data : bytes!
      }
        @description "A file read for the Rust renderer plan."
        @tier "internal"
      RS_FILE_READ {
        data : bytes!
      }
        @description "A file read for the Rust renderer plan."
        @tier "internal"
      RS_DIR {
        entries : [DirEntry]!
      }
        @description "A tier directory listing."
        @tier "internal"
      RS_STUB_NONE { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_DIR_MISSING { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_FILE_FAIL { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_DOM { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_LIST { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_FREAD { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_BUILD { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_BUILD2 { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      RS_BUILD3 { }
        @description "Internal: Rust renderer plan step."
        @tier "internal"
      SHELL_CHECKED { }
        @description "Internal: the material members were checked."
        @tier "internal"
      SHELL_MEMBERS_READ {
        data : bytes!
      }
        @description "The known Icons.Filled members file's bytes."
        @tier "internal"
      SHELL_MEMBERS_FAIL { }
        @description "The members file could not be read."
        @tier "internal"
      SHELL_READ { }
        @description "Internal: read the table file."
        @tier "internal"
      SHELL_W_NEXT { }
        @description "Internal: write the next generated file."
        @tier "internal"
      SHELL_W_WRITE { }
        @description "Internal: write the current generated file."
        @tier "internal"
      SHELL_TABLE_READ {
        data : bytes!
      }
        @description "The table file's bytes."
        @tier "internal"
      SHELL_TABLE_FAIL { }
        @description "The table file could not be read."
        @tier "internal"
      SHELL_W_MKDIR { }
        @description "A directory made."
        @tier "internal"
      SHELL_W_WROTE {
        bytes : number!
      }
        @description "A file written."
        @tier "internal"
      SHELL_W_FAILED {
        error : string
      }
        @description "A directory or file that could not be written."
        @tier "internal"
    }

    listens {
      SHELL_CALLED -> inbound "cli-shell-renderers" answers SHELL_RENDERERS_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb shell-renderers` with its arguments and working directory."
        @synonyms "orb shell-renderers, generate native renderer files"
      SHELL_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      ArgsCli.ARGS_PARSED -> SHELL_ARGS_DONE
    }
  }

  page "/orb-shell-renderers" as OrbShellRenderersPage -> OrbShellRenderers, ArgsCli
}
