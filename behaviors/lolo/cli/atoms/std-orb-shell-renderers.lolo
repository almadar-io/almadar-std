app std-orb-shell-renderers [
  version: "1.0.0",
  inbound: ["cli-shell-renderers"],
  fs: { cwd: "**": [read, write, create, remove] },
  description: "std-orb-shell-renderers — the `orb shell-renderers <target>` command, the generator of the native shells' renderer files. Target icon-map reads the icon table (packages/almadar-ui/lib/iconNativeMap.json, or --table) and writes IconMap.swift into the iOS SwiftUI pack and IconMap.kt into the Android Compose pack, or both into --out <dir>, and answers `icon-map: N icons, 2 files` (status 200, exit 0). A missing or unknown target, a word or flag it does not know answers the usage (status 400, exit 2); an unreadable or malformed table answers `error: cannot read <file>` (status 500, exit 1)."
]
uses Spec from "almadar-std/orb-shell-renderers"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type IconGlyph = { sfSymbol : string!, materialSymbol : string! }
type IconTable = { fallback : IconGlyph!, map : Map string IconGlyph! }
type IconMembers = [string]
type PropDef = { required : boolean, kind : string }
type PatEntry = { tier : string!, propsSchema : Map string PropDef }
type TokenRule = { re : string!, rule : string! }
type AtomRule = { label : string!, re : string! }
type ActionCall = { name : string!, opener : string!, boundary : boolean!, mode : string!, platform : string! }
type MapEntry = { component : string!, importPath : string }
type MapReg = { mappings : Map string MapEntry! }
type RsRec = { tier : string!, module : string!, structName : string!, prune : boolean!, fallback : boolean! }
type RsOut = { name : string, tier : string!, module : string!, structName : string!, alias : string }
type GateLists = { rustKeywords : [string]!, actionCalls : [ActionCall]!, chrome : Map string [string]!, accessor : string!, tokenRules : Map string [TokenRule]!, atomOwned : Map string [AtomRule]!, subcomposeRoots : string!, localDecl : string! }
type PatReg = { patterns : Map string PatEntry! }
type PatRef = { name : string!, tier : string! }
type NativeLists = { deferred : [string]!, canvas : [string]!, fixedSize : [string]!, families : Map string string! }
type CoreVersion = { version : string! }
type PackManifest = { name : string!, version : string!, description : string! }
type DirEntry = { name : string!, kind : string! }
type SizeEntry = { key : string!, value : number! }
type SizeScales = { maxWidth : [SizeEntry]!, width : [SizeEntry]!, minWidth : [SizeEntry]! }
type CoreIds = { actionPrefix : string!, overflowKey : string!, gestureEventProps : Map string string!, nativeIdPrefix : Map string string!, nativeIdSeparator : string! }
type NativeTokens = { breakpoints : Map string number!, sizes : SizeScales!, gestureTpl : Map string string!, sizeLine : Map string string! }
type RenderFile = { path : string!, text : string! }

orbital OrbShellRenderersOrbital {
  uses Args from "std/behaviors/std-args"

  entity OrbShellRenderersRun [runtime] {
    id : string!
    target : string = ""
    cwd : string = ""
    tablePath : string = ""
    membersPath : string = ""
    tableText : string = ""
    badMembers : [string] = []
    platform : string = ""
    pack : string = ""
    ext : string = ""
    registryPath : string = ""
    listsPath : string = ""
    curPath : string = ""
    listsText : string = ""
    regText : string = ""
    coreVer : string = ""
    stubTpl : string = ""
    regTpl : string = ""
    manText : string = ""
    pats : [PatRef] = []
    have : [string] = []
    stubbed : [string] = []
    tcur : number = 0
    hcur : number = 0
    rcur : number = 0
    keys : [string] = []
    natives : [string] = []
    missing : [PatRef] = []
    orphans : [string] = []
    bad : [string] = []
    removals : [string] = []
    summary : string = ""
    rlive : [RsRec] = []
    rkeys : [string] = []
    rstubs : [RsOut] = []
    rall : [RsOut] = []
    rmBase : string = "/renderers/"
    domains : [string] = []
    dcur : number = 0
    curDomain : string = ""
    liveNames : [string] = []
    mapText : string = ""
    rsStub : string = ""
    rsReg : string = ""
    rfiles : [string] = []
    rrecs : [RsRec] = []
    offenders : [string] = []
    mappingPath : string = ""
    violations : [string] = []
    tokText : string = ""
    idsText : string = ""
    tokensPath : string = ""
    idsPath : string = ""
    bpTpl : string = ""
    szTpl : string = ""
    vidTpl : string = ""
    outDir : string = ""
    outFiles : [RenderFile] = []
    wcur : number = 0
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbShellRenderers.SHELL_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait OrbShellRenderers -> OrbShellRenderersRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      SHELL_CALLED -> ready
        (set @entity.cwd (object/get (json/parse @payload.rawBody OrbCommandArgs) "cwd"))
        (set @entity.target (str/default (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) ""))
        (emit SHELL_ARGS_PARSE { stage: "shell-renderers" argv: (array/drop (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") 1) flags: [{ name: "table" aliases: [] takesValue: true repeatable: false }, { name: "out" aliases: [] takesValue: true repeatable: false }, { name: "members" aliases: [] takesValue: true repeatable: false }, { name: "registry" aliases: [] takesValue: true repeatable: false }, { name: "lists" aliases: [] takesValue: true repeatable: false }, { name: "mapping" aliases: [] takesValue: true repeatable: false }, { name: "tokens" aliases: [] takesValue: true repeatable: false }, { name: "ids" aliases: [] takesValue: true repeatable: false }] })
      SHELL_ARGS_DONE -> ready when (or (not (array/includes (str/split "icon-map|ios|android|dioxus|tui" "|") @entity.target)) (> (array/len @payload.errors) 0) (> (array/len @payload.positionals) 0))
        (emit SHELL_RENDERERS_ANSWERED { status: 400, body: "usage: orb shell-renderers icon-map|ios|android|dioxus|tui [--table <file>] [--members <file>] [--registry <file>] [--lists <file>] [--out <dir>]" })
      SHELL_ARGS_DONE -> planning when (and (!= @entity.target "icon-map") (array/includes (str/split "ios|android" "|") @entity.target) (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0))
        (set @entity.platform @entity.target)
        (set @entity.pack (if (= @entity.target "ios") "orbital-rust/crates/orbital-shell-ios/renderers/swiftui" "orbital-rust/crates/orbital-shell-android/renderers/compose"))
        (set @entity.ext (if (= @entity.target "ios") "swift" "kt"))
        (set @entity.registryPath (if (!= (object/get @payload.flags "registry") null) (str/default (array/first (object/get @payload.flags "registry")) "") "orbital-rust/crates/orbital-shell-typescript/renderers/core/dist/patterns/patterns-registry.json"))
        (set @entity.listsPath (if (!= (object/get @payload.flags "lists") null) (str/default (array/first (object/get @payload.flags "lists")) "") "orbital-rust/crates/orbital-shell-ios/renderers/swiftui/pattern-lists.json"))
        (set @entity.tokensPath (if (!= (object/get @payload.flags "tokens") null) (str/default (array/first (object/get @payload.flags "tokens")) "") "orbital-rust/crates/orbital-shell-typescript/renderers/web/src/core/tokens/native-tokens.json"))
        (set @entity.idsPath (if (!= (object/get @payload.flags "ids") null) (str/default (array/first (object/get @payload.flags "ids")) "") "orbital-rust/crates/orbital-shell-typescript/renderers/core/src/types/verification-ids.json"))
        (set @entity.outDir (if (!= (object/get @payload.flags "out") null) (str/default (array/first (object/get @payload.flags "out")) "") ""))
        (set @entity.curPath @entity.listsPath)
        (os/read-file { anchor: "cwd" path: @entity.listsPath } { key: "lists", emit: { success: NS_LISTS_READ, failure: NS_READ_FAIL } })
      SHELL_ARGS_DONE -> rscan when (and (array/includes (str/split "dioxus|tui" "|") @entity.target) (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0))
        (set @entity.platform @entity.target)
        (set @entity.pack (str/concat "orbital-rust/crates/orbital-shell-rust/renderers/" @entity.target))
        (set @entity.domains (if (= @entity.target "dioxus") (str/split "core|game" "|") (str/split "core" "|")))
        (set @entity.registryPath (if (!= (object/get @payload.flags "registry") null) (str/default (array/first (object/get @payload.flags "registry")) "") "orbital-rust/crates/orbital-shell-typescript/renderers/core/dist/patterns/patterns-registry.json"))
        (set @entity.mappingPath (if (!= (object/get @payload.flags "mapping") null) (str/default (array/first (object/get @payload.flags "mapping")) "") "orbital-rust/crates/orbital-shell-typescript/renderers/core/dist/patterns/component-mapping.json"))
        (set @entity.listsPath (if (!= (object/get @payload.flags "lists") null) (str/default (array/first (object/get @payload.flags "lists")) "") "orbital-rust/crates/orbital-shell-ios/renderers/swiftui/pattern-lists.json"))
        (set @entity.outDir (if (!= (object/get @payload.flags "out") null) (str/default (array/first (object/get @payload.flags "out")) "") ""))
        (set @entity.curPath @entity.listsPath)
        (os/read-file { anchor: "cwd" path: @entity.listsPath } { key: "lists", emit: { success: RS_LISTS_READ, failure: NS_READ_FAIL } })
      SHELL_ARGS_DONE -> reading when (and (= @entity.target "icon-map") (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 0))
        (set @entity.tablePath (if (!= (object/get @payload.flags "table") null) (str/default (array/first (object/get @payload.flags "table")) "") "packages/almadar-ui/lib/iconNativeMap.json"))
        (set @entity.membersPath (if (!= (object/get @payload.flags "members") null) (str/default (array/first (object/get @payload.flags "members")) "") "orbital-rust/crates/orbital-shell-android/renderers/compose/material-icons-filled-members.json"))
        (set @entity.outDir (if (!= (object/get @payload.flags "out") null) (str/default (array/first (object/get @payload.flags "out")) "") ""))
        (emit SHELL_READ { })
    }

    state reading {
      INIT -> reading
      SHELL_READ -> reading
        (os/read-file { anchor: "cwd" path: @entity.tablePath } { key: "table", emit: { success: SHELL_TABLE_READ, failure: SHELL_TABLE_FAIL } })
      SHELL_TABLE_READ -> reading
        (set @entity.tableText (bytes/to-string @payload.data))
        (os/read-file { anchor: "cwd" path: @entity.membersPath } { key: "members", emit: { success: SHELL_MEMBERS_READ, failure: SHELL_MEMBERS_FAIL } })
      SHELL_MEMBERS_FAIL -> ready
        (emit SHELL_RENDERERS_ANSWERED { status: 500, body: (str/concat "error: cannot read " @entity.membersPath) })
      SHELL_MEMBERS_READ -> reading
        (let ((tbl (json/parse @entity.tableText IconTable))
              (known (json/parse (bytes/to-string @payload.data) IconMembers)))
          (let ((bad (array/filter
                       (array/concat
                         (array/map (array/sort (object/keys (object/get @tbl "map"))) (fn nm (object/get (object/get (object/get @tbl "map") @nm) "materialSymbol")))
                         [(object/get (object/get @tbl "fallback") "materialSymbol")])
                       (fn sy (not (array/includes @known (str/join (array/map (array/filter (str/split @sy "_") (fn seg (> (str/len @seg) 0))) (fn seg (str/concat (str/upper (str/slice @seg 0 1)) (str/slice @seg 1)))) "")))))))
            (set @entity.badMembers (array/filter @bad (fn sy (= (array/indexOf @bad @sy) @index))))))
        (emit SHELL_CHECKED { })
      SHELL_CHECKED -> ready when (> (array/len @entity.badMembers) 0)
        (emit SHELL_RENDERERS_ANSWERED { status: 500, body: (str/concat "error: " (array/len @entity.badMembers) " materialSymbol value(s) have no Icons.Filled.* member: " (str/join @entity.badMembers ", ")) })
      SHELL_CHECKED -> writing when (= (array/len @entity.badMembers) 0)
        (let ((tbl (json/parse @entity.tableText IconTable))
              (names (array/sort (object/keys (object/get (json/parse @entity.tableText IconTable) "map")))))
          (do
          (set @entity.summary (str/concat "icon-map: " (array/len @names) " icons, 2 files"))
          (set @entity.outFiles (array/concat
            [{ path: (if (= @entity.outDir "") "orbital-rust/crates/orbital-shell-ios/renderers/swiftui/renderers/IconMap.swift" (str/concat @entity.outDir "/IconMap.swift")),
               text: (str/concat "// generated by almadar-sync icon-map from packages/almadar-ui/lib/iconNativeMap.ts\nimport Foundation\n\nenum IconMap {\n    static let table: [String: String] = [\n"
                 (str/join (array/map @names (fn n (str/concat "        " (json/stringify @n) ": " (json/stringify (object/get (object/get (object/get @tbl "map") @n) "sfSymbol")) ","))) "\n")
                 "\n    ]\n\n    static let fallback: String = " (json/stringify (object/get (object/get @tbl "fallback") "sfSymbol")) "\n\n    static func resolve(_ name: String) -> String {\n        table[name] ?? fallback\n    }\n}\n") }]
            [{ path: (if (= @entity.outDir "") "orbital-rust/crates/orbital-shell-android/renderers/compose/renderers/IconMap.kt" (str/concat @entity.outDir "/IconMap.kt")),
               text: (str/concat "// generated by almadar-sync icon-map from packages/almadar-ui/lib/iconNativeMap.ts\npackage generated.patterns.core\n\nimport androidx.compose.material.icons.Icons\nimport androidx.compose.material.icons.filled.*\nimport androidx.compose.ui.graphics.vector.ImageVector\n\n// `table`/`resolve` give the Material Symbols glyph NAME (e.g. " (json/stringify "add") ");\n// `vectors`/`resolveVector` give the real Compose ImageVector — every\n// `materialSymbol` deterministically converted to `Icons.Filled.<Member>`\n// (arrow_back -> ArrowBack) and verified against the resolved\n// material-icons-core + material-icons-extended classpath at generation\n// time (wave C5) — a name with no real member is a generation error, not\n// a silent per-icon fallback.\nobject IconMap {\n    val table: Map<String, String> = mapOf(\n"
                 (str/join (array/map @names (fn n (str/concat "        " (json/stringify @n) " to " (json/stringify (object/get (object/get (object/get @tbl "map") @n) "materialSymbol")) ","))) "\n")
                 "\n    )\n\n    val fallback: String = " (json/stringify (object/get (object/get @tbl "fallback") "materialSymbol")) "\n\n    fun resolve(name: String): String = table[name] ?: fallback\n\n    val vectors: Map<String, ImageVector> = mapOf(\n"
                 (str/join (array/map @names (fn n (str/concat "        " (json/stringify @n) " to Icons.Filled." (str/join (array/map (array/filter (str/split (object/get (object/get (object/get @tbl "map") @n) "materialSymbol") "_") (fn seg (> (str/len @seg) 0))) (fn seg (str/concat (str/upper (str/slice @seg 0 1)) (str/slice @seg 1)))) "") ","))) "\n")
                 "\n    )\n\n    val fallbackVector: ImageVector = Icons.Filled." (str/join (array/map (array/filter (str/split (object/get (object/get @tbl "fallback") "materialSymbol") "_") (fn seg (> (str/len @seg) 0))) (fn seg (str/concat (str/upper (str/slice @seg 0 1)) (str/slice @seg 1)))) "") "\n\n    fun resolveVector(name: String): ImageVector = vectors[name] ?: fallbackVector\n}\n") }]))
          (set @entity.wcur 0)
          (emit SHELL_W_NEXT { })))
      SHELL_TABLE_FAIL -> ready
        (emit SHELL_RENDERERS_ANSWERED { status: 500, body: (str/concat "error: cannot read " @entity.tablePath) })
    }

    state planning {
      INIT -> planning
      NS_LISTS_READ -> planning
        (set @entity.listsText (bytes/to-string @payload.data))
        (set @entity.curPath @entity.registryPath)
        (os/read-file { anchor: "cwd" path: @entity.registryPath } { key: "registry", emit: { success: NS_REG_READ, failure: NS_READ_FAIL } })
      NS_REG_READ -> planning
        (set @entity.regText (bytes/to-string @payload.data))
        (set @entity.curPath "orbital-rust/crates/orbital-shell-typescript/renderers/core/package.json")
        (os/read-file { anchor: "cwd" path: "orbital-rust/crates/orbital-shell-typescript/renderers/core/package.json" } { key: "corepkg", emit: { success: NS_VER_READ, failure: NS_READ_FAIL } })
      NS_VER_READ -> planning
        (set @entity.coreVer (object/get (json/parse (bytes/to-string @payload.data) CoreVersion) "version"))
        (set @entity.curPath (str/concat @entity.pack "/stub.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/stub.tpl") } { key: "stub", emit: { success: NS_STUB_READ, failure: NS_READ_FAIL } })
      NS_STUB_READ -> planning
        (set @entity.stubTpl (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/registry.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/registry.tpl") } { key: "regtpl", emit: { success: NS_TPL_READ, failure: NS_READ_FAIL } })
      NS_TPL_READ -> planning
        (set @entity.regTpl (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/package.json"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/package.json") } { key: "manifest", emit: { success: NS_MAN_READ, failure: NS_READ_FAIL } })
      NS_MAN_READ -> planning
        (set @entity.manText (bytes/to-string @payload.data))
        (set @entity.curPath @entity.tokensPath)
        (os/read-file { anchor: "cwd" path: @entity.tokensPath } { key: "tokens", emit: { success: NS_TOK_READ, failure: NS_READ_FAIL } })
      NS_TOK_READ -> planning
        (set @entity.tokText (bytes/to-string @payload.data))
        (set @entity.curPath @entity.idsPath)
        (os/read-file { anchor: "cwd" path: @entity.idsPath } { key: "ids", emit: { success: NS_IDS_READ, failure: NS_READ_FAIL } })
      NS_IDS_READ -> planning
        (set @entity.idsText (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/breakpoints.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/breakpoints.tpl") } { key: "bptpl", emit: { success: NS_BP_READ, failure: NS_READ_FAIL } })
      NS_BP_READ -> planning
        (set @entity.bpTpl (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/sizes.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/sizes.tpl") } { key: "sztpl", emit: { success: NS_SZ_READ, failure: NS_READ_FAIL } })
      NS_SZ_READ -> planning
        (set @entity.szTpl (bytes/to-string @payload.data))
        (set @entity.curPath (str/concat @entity.pack "/verification-ids.tpl"))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/verification-ids.tpl") } { key: "vidtpl", emit: { success: NS_VID_READ, failure: NS_READ_FAIL } })
      NS_VID_READ -> planning
        (set @entity.vidTpl (bytes/to-string @payload.data))
        (set @entity.pats (array/map
          (array/filter
            (array/map (array/map (array/sort (array/map (object/keys (object/get (json/parse @entity.regText PatReg) "patterns")) (fn nm { sort: (str/collate-key @nm), name: @nm })) "sort") (fn k (object/get @k "name")))
              (fn nm { name: @nm, tier: (object/get (object/get (object/get (json/parse @entity.regText PatReg) "patterns") @nm) "tier") }))
            (fn pr (and (array/includes (str/split "atoms|molecules|organisms|templates" "|") (object/get @pr "tier"))
                        (not (array/includes (object/get (json/parse @entity.listsText NativeLists) "deferred") (object/get @pr "name")))
                        (not (array/includes (object/get (json/parse @entity.listsText NativeLists) "canvas") (object/get @pr "name"))))))
          (fn pr { name: (object/get @pr "name"), tier: (object/get @pr "tier") })))
        (set @entity.keys (array/map @entity.pats (fn pr (str/concat (object/get @pr "tier") "/" (str/replaceAll (object/get @pr "name") "-" "_") "." @entity.ext))))
        (set @entity.tcur 0)
        (emit NS_LIST { })
      NS_LIST -> planning when (< @entity.tcur 4)
        (os/list-dir { anchor: "cwd" path: (str/concat @entity.pack "/renderers/" (array/nth (str/split "atoms|molecules|organisms|templates" "|") @entity.tcur)) } { key: "dir", emit: { success: NS_DIR, failure: NS_DIR_MISSING } })
      NS_DIR -> planning
        (set @entity.have (array/concat @entity.have
          (array/map (array/filter @payload.entries (fn en (str/endsWith (object/get @en "name") (str/concat "." @entity.ext))))
            (fn en (str/concat (array/nth (str/split "atoms|molecules|organisms|templates" "|") @entity.tcur) "/" (object/get @en "name"))))))
        (set @entity.tcur (+ @entity.tcur 1))
        (emit NS_LIST { })
      NS_DIR_MISSING -> planning
        (set @entity.tcur (+ @entity.tcur 1))
        (emit NS_LIST { })
      NS_LIST -> planning when (>= @entity.tcur 4)
        (set @entity.hcur 0)
        (emit NS_FREAD { })
      NS_FREAD -> planning when (< @entity.hcur (array/len @entity.have))
        (os/read-file { anchor: "cwd" path: (str/concat @entity.pack "/renderers/" (array/nth @entity.have @entity.hcur)) } { key: "body", emit: { success: NS_FILE_READ, failure: NS_FILE_FAIL } })
      NS_FILE_READ -> planning when (str/includes (bytes/to-string @payload.data) "🔧")
        (set @entity.stubbed (array/append @entity.stubbed (array/nth @entity.have @entity.hcur)))
        (set @entity.violations (array/concat @entity.violations (let ((tx (bytes/to-string @payload.data)) (ix (array/indexOf @entity.keys (array/nth @entity.have @entity.hcur))))
          (if (< @ix 0) (array/take @entity.violations 0)
            (let ((nm (object/get (array/nth @entity.pats @ix) "name")) (tr (object/get (array/nth @entity.pats @ix) "tier")) (gl (json/parse @entity.listsText GateLists)))
              (array/concat
                (array/map (array/filter (object/get (object/get @gl "chrome") @entity.platform) (fn tk (str/includes @tx @tk))) (fn tk (str/concat "[chrome] " @nm ": body contains page chrome " (json/stringify @tk) " — chrome belongs to the generated page")))
                (array/map (array/filter (array/map (object/get (object/get @gl "tokenRules") @entity.platform) (fn ru { rule: (object/get @ru "rule"), line: (array/find (str/split @tx "\n") (fn ln (and (not (validate/pattern @ln (object/get @gl "accessor"))) (validate/pattern @ln (object/get @ru "re"))))) })) (fn rr (!= (object/get @rr "line") null)))
                  (fn rr (str/concat "[token-only] " @nm ": body has " (object/get @rr "rule") " outside a theme accessor: " (str/trim (object/get @rr "line")))))
                (if (= @tr "atoms") (array/take @entity.violations 0)
                  (array/map (array/filter (object/get (object/get @gl "atomOwned") @entity.platform) (fn ar (validate/pattern @tx (object/get @ar "re")))) (fn ar (str/concat "[composes-atoms] " @nm ": " @tr " body draws " (json/stringify (object/get @ar "label")) " directly — compose the atom renderer instead"))))
                (if (= @entity.platform "android")
                  (let ((roots (- (array/len (str/split (str/replace-pattern @tx (object/get @gl "subcomposeRoots") "§§") "§§")) 1)) (declared (- (array/len (str/split @tx ".almadarFlexFill()")) 1)))
                    (if (> @roots @declared) (array/append (array/take @entity.violations 0) (str/concat "[flex-basis] " @nm ": body has " @roots " subcompose root(s) (Lazy*, Pager, BoxWithConstraints) but declares " @declared " .almadarFlexFill() — an undeclared root throws when a flex row asks its intrinsic width")) (array/take @entity.violations 0)))
                  (let ((decl (array/find (str/split (array/last (str/split @tx ") -> AnyView {\n")) "\n") (fn ln (validate/pattern @ln (object/get @gl "localDecl"))))))
                    (if (!= @decl null) (array/append (array/take @entity.violations 0) (str/concat "[body-declarations] " @nm ": body declares " (json/stringify (str/trim @decl)) " — move it to the pattern header or AtomKit")) (array/take @entity.violations 0))))
                (let ((pd (object/get (object/get (object/get (json/parse @entity.regText PatReg) "patterns") @nm) "propsSchema")))
