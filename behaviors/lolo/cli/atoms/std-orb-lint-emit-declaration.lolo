app std-orb-lint-emit-declaration [
  version: "1.0.0",
  inbound: ["cli-lint-emit-declaration"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-emit-declaration — the `orb lint emit-declaration <file>` command, the port of validate_emit_against_declaration (effect/emit_declaration.rs). It lowers the file with program/read and checks each `emit` effect of every inline trait transition and tick, however nested in do, if, when and let (std-orb-effect-leaves flattens them): an event the trait's `emits` array does not declare is ORB_T_EVT_UNDECLARED, and an emit of a declared external event that carries a payload object missing a required payload field (or carries a non-object payload while the event has required fields) is ORB_X_PAYLOAD_MISMATCH, each with the Rust path, message and suggestion (status 500, exit 1). ORB_EFF_MISSING_REQUIRED_EMIT (validate_required_emit_success) is not here: no operator in the table sets requiresEmitSuccess, so the Rust pass is inert. The rule asks std-orb-effect-leaves for the emit effects (heads: emit) and reads the event name and the payload object's keys from their flat typed nodes. Clean answers `lint emit-declaration: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-emit-declaration"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type EmdField = { name : string, required : boolean }
type EmdEmit = { event : string, scope : string, payloadSchema : [EmdField] }
type EmdTrait = { name : string, emits : [EmdEmit] }
type EmdOrbital = { name : string, traits : [EmdTrait] }
type EmdNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type EmdLeaf = { p : string!, n : [EmdNode]!, oi : number!, ti : number! }
type EmdWalkSlot = { kind : string!, args : [number] }
type EmdWalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type EmdExprItem = { eff : boolean! }
type EmdProgram = { orbitals : [EmdOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEmitDeclarationCodes = { tEvtUndeclared : LintCodeDecl , xPayloadMismatch : LintCodeDecl }

orbital OrbLintEmitDeclarationOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintEmitDeclarationRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    orbitals : [EmdOrbital] = []
  }

  trait OrbLintEmitDeclaration -> OrbLintEmitDeclarationRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get @payload.program "orbitals" []))
        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "emitdecl" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["emit"] })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "emitdecl" @entity.scope))
        (set @entity.findings (let ((orbitals @entity.orbitals) (nof : [OrbFinding] []) (nn : EmdNode { k: "nil", ks: [], hd: "", nms: [], rt: "", nm: "", pa: [], bd: -1, wh: "", tx: "", pv: false, hs: false, sl: [], lb: [], lv: null })) (let ((idx (object/fromEntries (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (array/map (array/range 0 (array/len (object/get (array/nth @orbitals @oi) "traits" []))) (fn ti [(str/concat @oi "-" @ti), (object/get (array/nth (object/get (array/nth @orbitals @oi) "traits" []) @ti) "emits" [])])))))) ) ) (array/flatten (array/map @payload.leaves (fn l (let ((n : [EmdNode] (object/get @l "n" [])) (p (object/get @l "p"))) (let ((rti (- (array/len @n) 1)) (rt : EmdNode (default (array/nth @n @rti) @nn))) (let ((rtks : [number] (object/get @rt "ks"))) (let ((rtcr : [number] (array/map (array/range 0 (array/len @rtks)) (fn j (- (+ (- @rti (array/sum @rtks)) (array/sum (array/take @rtks (+ @j 1)))) 1))))) (if (not (and (array/includes ["call", "arr", "proj", "rui"] (object/get @rt "k")) (>= (array/len @rtks) 2) (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) "") "emit"))) @nof (let ((xi (default (array/nth @rtcr 1) 0)) (x : EmdNode (default (array/nth @n @xi) @nn))) (if (or (and (= (object/get @x "k") "nil") (!= (object/get @x "lv") null)) (and (= (object/get @x "k") "bind") (= (object/get @x "wh") "w")) (= (object/get @x "k") "cat")) (let ((ev : string (if (= (object/get @x "k") "nil") (default (array/first (default (object/get @x "lv") [])) "") (if (= (object/get @x "k") "bind") (object/get @x "tx") (object/get (default (array/nth @n (- @xi 1)) @nn) "tx"))))) (let ((decls (array/filter (object/get @idx (str/concat (object/get @l "oi") "-" (object/get @l "ti")) []) (fn d (= (object/get @d "event" "") @ev))))) (if (= (array/len @decls) 0) [{ code: @config.codes.tEvtUndeclared.code, path: @p, message: (str/concat "Event '" @ev "' is emitted but not declared in trait's emits array"), suggestion: "Add the event to the trait's 'emits' array with proper payload schema", severity: "error" }] (let ((d (array/first @decls))) (if (not (and (= (object/get @d "scope" "") "external") (>= (array/len @rtks) 3))) @nof (let ((req (array/map (array/filter (object/get @d "payloadSchema" []) (fn f (= (object/get @f "required" false) true))) (fn f (object/get @f "name" ""))))) (let ((pli (default (array/nth @rtcr 2) 0)) (pl : EmdNode (default (array/nth @n @pli) @nn))) (if (= (object/get @pl "k") "obj") (let ((keys : [string] (object/get @pl "nms"))) (array/map (array/filter @req (fn r (not (array/includes @keys @r)))) (fn r { code: @config.codes.xPayloadMismatch.code, path: @p, message: (str/concat "External emit '" @ev "' is missing required payload field '" @r "'"), suggestion: (str/concat "Add the '" @r "' field to the emit payload"), severity: "error" }))) (if (= (array/len @req) 0) @nof [{ code: @config.codes.xPayloadMismatch.code, path: @p, message: (str/concat "External emit '" @ev "' requires payload with fields: [" (str/join (array/map @req (fn r (json/stringify @r))) ", ") "]"), suggestion: "Add a payload object with the required fields", severity: "error" }]))))))))) @nof)))))))))))))
        (emit LINT_FINISH { })

      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "emit-declaration", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      EFFECT_LEAVES_EXPAND -> external { requestId : string!  orbitals : [EmdOrbital]!  heads : [string]! }
        @description "Ask std-orb-effect-leaves to flatten the effects of every inline trait."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      EFFECT_LEAVES_HEARD { requestId : string!  leaves : [EmdLeaf]! }
        @description "std-orb-effect-leaves's answer: the effects to check, flattened."
      OrbEffectLeaves.EFFECT_LEAVES_EXPANDED -> EFFECT_LEAVES_HEARD
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : EmdProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintEmitDeclarationCodes = { tEvtUndeclared: { code: "ORB_T_EVT_UNDECLARED", category: "trait", description: "An event is emitted but not declared in the trait's emits array" }, xPayloadMismatch: { code: "ORB_X_PAYLOAD_MISMATCH", category: "cross", description: "An external emit is missing a payload field required by the event's declaration" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEmitDeclarationCli -> OrbLintEmitDeclarationRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint emit-declaration <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "emit-declaration") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint emit-declaration: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "emit-declaration") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint emit-declaration: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-emit-declaration" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint emit-declaration` with its arguments and working directory."
        @synonyms "orb lint emit-declaration"
      OrbLintEmitDeclaration.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEffectLeaves = LeavesUse.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [EmdOrbital]!  heads : [string]! }
        @description "Flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[EmdNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintEmitDeclaration.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbLintExprNodes = Input.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string EmdWalkSlot!  projections : Map string EmdWalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [EmdExprItem]! }
        @description "A rule asks to flatten expressions."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEmitDeclarationCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEmitDeclarationOrbitalStart -> OrbLintEmitDeclaration, OrbLintEmitDeclarationCli, OrbLintInput, Packs, OrbEffectLeaves, OrbLintExprNodes, Versions
}
