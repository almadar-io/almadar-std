app std-orb-lint-entity-empty-enum [
  version: "1.0.0",
  inbound: ["cli-lint-entity-empty-enum"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-empty-enum — the `orb lint entity-empty-enum <file>` command, the port. It lowers the file with program/read and, for every orbital's inline primary and auxiliary entity, reports each top-level field of type enum whose values list is empty or absent, with the Rust path, message and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. Clean answers `lint entity-empty-enum: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-empty-enum"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type EmptyEnumField = { type : string, values : [string] }
type EmptyEnumEntity = { fields : [EmptyEnumField] }
type EmptyEnumOrbital = { entity : EmptyEnumEntity, auxiliaryEntities : [EmptyEnumEntity], spec : boolean }
type EmptyEnumProgram = { orbitals : [EmptyEnumOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEntityEmptyEnumCodes = { eEmptyEnumValues : LintCodeDecl }

orbital OrbLintEntityEmptyEnumOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntityEmptyEnumRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEntityEmptyEnum -> OrbLintEntityEmptyEnumRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((auxs (object/get (default (array/nth @orbitals @oi) {}) "auxiliaryEntities" [])))
              (array/flatten (array/map
                (array/concat [{ ent: (object/get (default (array/nth @orbitals @oi) {}) "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                  (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
                (fn eb
                  (let ((ent (object/get @eb "ent")) (base (object/get @eb "base")))
                    (if (and (validate/object @ent) (not (object/get (default (array/nth @orbitals @oi) {}) "spec" false)))
                      (let ((fields (object/get @ent "fields" [])))
                        (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                          (let ((f (default (array/nth @fields @fi) {})))
                            (if (!= (object/get @f "type" "") "enum")
                              []
                              (if (= (array/len (object/get @f "values" [])) 0)
                                (if (object/has @f "values")
                                  [{ code: @config.codes.eEmptyEnumValues.code, path: (str/concat @base ".fields[" @fi "].values"), message: "Enum field must have at least one value", suggestion: "Add values array with possible enum values", severity: "error" }]
                                  [{ code: @config.codes.eEmptyEnumValues.code, path: (str/concat @base ".fields[" @fi "].values"), message: "Enum field requires a 'values' array", suggestion: (str/concat "Add values: [" (json/stringify "option1") ", " (json/stringify "option2") "] for enum fields"), severity: "error" }])
                                [])))))))
                      [])))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-empty-enum", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : EmptyEnumProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintEntityEmptyEnumCodes = { eEmptyEnumValues: { code: "ORB_E_EMPTY_ENUM_VALUES", category: "entity", description: "An enum field declares no values" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEntityEmptyEnumCli -> OrbLintEntityEmptyEnumRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-empty-enum <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-empty-enum <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-empty-enum") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-empty-enum: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-empty-enum") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-empty-enum: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-empty-enum" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint entity-empty-enum` with its arguments and working directory."
        @synonyms "orb lint entity-empty-enum, duplicate field names"
      OrbLintEntityEmptyEnum.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntityEmptyEnumCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntityEmptyEnumOrbitalStart -> OrbLintEntityEmptyEnum, OrbLintEntityEmptyEnumCli, OrbLintInput, Packs, Versions
}
