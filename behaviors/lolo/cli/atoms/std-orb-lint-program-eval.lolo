app std-orb-lint-program-eval [
  version: "1.0.0",
  inbound: ["cli-lint-program-eval"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-program-eval — the `orb lint program-eval <file>` command, the port of validate_program_eval (effect/program_eval.rs). It lowers the file with program/read and walks the effects of every inline trait transition and tick, descending through do, if, when and let, and checks each `program/eval` call: its `emit` option may carry only success and failure (ORB_EFF_EMIT_KEY_INVALID), each value must be a string identifier (ORB_EFF_EMIT_INVALID_NAME) declared in the trait's emits (ORB_EFF_EMIT_UNDECLARED_EVENT), and a call with no non-empty `emit.failure` drops the validator's errors (ORB_EFF_PROGRAM_EVAL_FAILURE_MISSING), each with the Rust path, message and suggestion (status 500, exit 1). The rule asks std-orb-effect-leaves for the program/eval effects (heads: program/eval) and reads the emit objects' keys and values from their flat typed nodes. Clean answers `lint program-eval: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-program-eval"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type PevNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type PevLeaf = { p : string!, n : [PevNode]!, oi : number!, ti : number! }
type PevWalkSlot = { kind : string!, args : [number] }
type PevWalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type PevExprItem = { eff : boolean! }
type PevEmit = { event : string }
type PevEo = { keys : [string]!, vis : [number]! }
type PevTrait = { name : string, emits : [PevEmit] }
type PevOrbital = { name : string, traits : [PevTrait] }
type PevDecl = { oi : number!, ti : number!, events : [string]! }
type PevAcc = { n : number!, rows : [PevDecl]! }
type PevProgram = { orbitals : [PevOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintProgramEvalCodes = { effEmitKeyInvalid : LintCodeDecl , effEmitInvalidName : LintCodeDecl , effEmitUndeclaredEvent : LintCodeDecl , effProgramEvalFailureMissing : LintCodeDecl }

orbital OrbLintProgramEvalOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintProgramEvalRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    orbitals : [PevOrbital] = []
    declared : [PevDecl] = []
  }

  trait OrbLintProgramEval -> OrbLintProgramEvalRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get @payload.program "orbitals" []))
        (set @entity.declared (let ((init : PevAcc { n: 0, rows: [] })) (object/get (array/reduce (object/get @payload.program "orbitals" []) @init (fn (oa orb) { n: (+ (object/get @oa "n") 1), rows: (array/concat (object/get @oa "rows") (let ((init2 : PevAcc { n: 0, rows: [] })) (object/get (array/reduce (object/get @orb "traits" []) @init2 (fn (ta td) { n: (+ (object/get @ta "n") 1), rows: (array/concat (object/get @ta "rows") [{ oi: (object/get @oa "n"), ti: (object/get @ta "n"), events: (array/map (object/get @td "emits" []) (fn d (object/get @d "event" ""))) }]) })) "rows"))) })) "rows")))
        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "program-eval" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["program/eval"] })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "program-eval" @entity.scope))
        (set @entity.findings (let ((orbitals @entity.orbitals) (nn : PevNode { k: "nil", ks: [], hd: "", nms: [], rt: "", nm: "", pa: [], bd: -1, wh: "", tx: "", pv: false, hs: false, sl: [], lb: [], lv: null })) (array/flatten (array/map @payload.leaves (fn l (let ((n : [PevNode] (object/get @l "n" [])) (p (object/get @l "p"))) (let ((rti (- (array/len @n) 1)) (rt : PevNode (default (array/nth @n @rti) @nn))) (let ((rtks : [number] (object/get @rt "ks"))) (let ((rtcr : [number] (array/map (array/range 0 (array/len @rtks)) (fn j (- (+ (- @rti (array/sum @rtks)) (array/sum (array/take @rtks (+ @j 1)))) 1))))) (if (not (and (array/includes ["call", "arr", "proj", "rui"] (object/get @rt "k")) (> (array/len @rtks) 0) (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) "") "program/eval"))) [] (let ((declared (array/flatten (array/map (array/filter @entity.declared (fn q (and (= (object/get @q "oi") (object/get @l "oi")) (= (object/get @q "ti") (object/get @l "ti"))))) (fn q (object/get @q "events")))))) (let ((nEo : PevEo { keys: [], vis: [] }) (eos : [PevEo] (array/flatten (array/map (array/range 1 (array/len @rtks)) (fn j (let ((ai (default (array/nth @rtcr @j) 0)) (a : PevNode (default (array/nth @n @ai) @nn))) (if (and (= (object/get @a "k") "obj") (array/includes (object/get @a "nms") "emit")) (let ((aks : [number] (object/get @a "ks"))) (let ((acr : [number] (array/map (array/range 0 (array/len @aks)) (fn j (- (+ (- @ai (array/sum @aks)) (array/sum (array/take @aks (+ @j 1)))) 1))))) (let ((ei (array/findIndex (object/get @a "nms") (fn q (= @q "emit"))))) (let ((ei (default (array/nth @acr @ei) 0)) (e : PevNode (default (array/nth @n @ei) @nn))) (if (= (object/get @e "k") "obj") (let ((eks : [number] (object/get @e "ks"))) (let ((ecr : [number] (array/map (array/range 0 (array/len @eks)) (fn j (- (+ (- @ei (array/sum @eks)) (array/sum (array/take @eks (+ @j 1)))) 1))))) [{ keys: (object/get @e "nms"), vis: @ecr }])) []))))) []))))))) (array/concat (array/flatten (array/map (array/range 0 (array/len @eos)) (fn q (let ((eo : PevEo (default (array/nth @eos @q) @nEo))) (array/flatten (array/map (array/range 0 (array/len (object/get @eo "keys"))) (fn m (let ((k (default (array/nth (object/get @eo "keys") @m) ""))) (if (not (array/includes ["success", "failure"] @k)) [{ code: @config.codes.effEmitKeyInvalid.code, path: @p, message: (str/concat "emit." @k " is not supported on this operator (allowed: success, failure)") , suggestion: "Remove the invalid key or use a different operator that supports it", severity: "error" }] (let ((vni (default (array/nth (object/get @eo "vis") @m) 0)) (vn : PevNode (default (array/nth @n @vni) @nn))) (if (or (and (= (object/get @vn "k") "nil") (!= (object/get @vn "lv") null)) (and (= (object/get @vn "k") "bind") (= (object/get @vn "wh") "w")) (= (object/get @vn "k") "cat")) (let ((v : string (if (= (object/get @vn "k") "nil") (default (array/first (default (object/get @vn "lv") [])) "") (if (= (object/get @vn "k") "bind") (object/get @vn "tx") (object/get (default (array/nth @n (- @vni 1)) @nn) "tx"))))) (if (not (validate/pattern @v "^[A-Za-z][A-Za-z0-9_]*$")) [{ code: @config.codes.effEmitInvalidName.code, path: @p, message: (str/concat "emit." @k " = '" @v "' is not a valid identifier") , suggestion: "Declare an `Event<T>` type alias and reference its name (e.g. 'PatientLoaded' or 'PATIENT_LOADED')", severity: "error" }] (if (array/includes @declared @v) [] [{ code: @config.codes.effEmitUndeclaredEvent.code, path: @p, message: (str/concat "emit." @k " = '" @v "' is not declared in the trait's emits array") , suggestion: "Declare the event in the trait's `emits` block with its payload shape", severity: "error" }]))) [{ code: @config.codes.effEmitInvalidName.code, path: @p, message: (str/concat "emit." @k " must be a string event name") , suggestion: "e.g. emit.success = 'PATIENT_LOADED'", severity: "error" }])))))))))))  (if (array/some (array/range 0 (array/len @eos)) (fn q (let ((eo : PevEo (default (array/nth @eos @q) @nEo))) (array/some (array/range 0 (array/len (object/get @eo "keys"))) (fn m (and (= (default (array/nth (object/get @eo "keys") @m) "") "failure") (let ((vni (default (array/nth (object/get @eo "vis") @m) 0)) (vn : PevNode (default (array/nth @n @vni) @nn))) (and (or (and (= (object/get @vn "k") "nil") (!= (object/get @vn "lv") null)) (and (= (object/get @vn "k") "bind") (= (object/get @vn "wh") "w")) (= (object/get @vn "k") "cat")) (!= (if (= (object/get @vn "k") "nil") (default (array/first (default (object/get @vn "lv") [])) "") (if (= (object/get @vn "k") "bind") (object/get @vn "tx") (object/get (default (array/nth @n (- @vni 1)) @nn) "tx"))) ""))))))))) [] [{ code: @config.codes.effProgramEvalFailureMissing.code, path: @p, message: "`program/eval` carries no `emit.failure` event — the validator's errors come back through it and would be dropped", suggestion: "Add `{ emit: { success: \"<EVENT>\", failure: \"<FAILURE_EVENT>\" } }` as the last arg and handle the failure event in an arm.", severity: "error" }]))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "program-eval", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      EFFECT_LEAVES_EXPAND -> external { requestId : string!  orbitals : [PevOrbital]!  heads : [string]! }
        @description "Ask std-orb-effect-leaves to flatten the effects of every inline trait."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      EFFECT_LEAVES_HEARD { requestId : string!  leaves : [PevLeaf]! }
        @description "std-orb-effect-leaves's answer: the effects to check, flattened."
      OrbEffectLeaves.EFFECT_LEAVES_EXPANDED -> EFFECT_LEAVES_HEARD
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PevProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintProgramEvalCodes = { effEmitKeyInvalid: { code: "ORB_EFF_EMIT_KEY_INVALID", category: "effect", description: "An emit config carries a key that the operator does not support" }, effEmitInvalidName: { code: "ORB_EFF_EMIT_INVALID_NAME", category: "effect", description: "The event name inside an emit effect is not a valid string event name" }, effEmitUndeclaredEvent: { code: "ORB_EFF_EMIT_UNDECLARED_EVENT", category: "effect", description: "An event named in emit is not declared in the trait's emits array" }, effProgramEvalFailureMissing: { code: "ORB_EFF_PROGRAM_EVAL_FAILURE_MISSING", category: "effect", description: "program/eval carries no emit.failure event, so validator errors would be dropped" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintProgramEvalCli -> OrbLintProgramEvalRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint program-eval <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint program-eval <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint program-eval <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "program-eval") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint program-eval: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "program-eval") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint program-eval: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-program-eval" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint program-eval` with its arguments and working directory."
        @synonyms "orb lint program-eval"
      OrbLintProgramEval.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEffectLeaves = LeavesUse.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [PevOrbital]!  heads : [string]! }
        @description "Flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[PevNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintProgramEval.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbLintExprNodes = Input.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string PevWalkSlot!  projections : Map string PevWalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [PevExprItem]! }
        @description "A rule asks to flatten expressions."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintProgramEvalCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintProgramEvalOrbitalStart -> OrbLintProgramEval, OrbLintProgramEvalCli, OrbLintInput, Packs, OrbEffectLeaves, OrbLintExprNodes, Versions
}
