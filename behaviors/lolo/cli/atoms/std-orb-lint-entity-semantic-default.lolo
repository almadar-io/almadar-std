app std-orb-lint-entity-semantic-default [
  version: "1.0.0",
  inbound: ["cli-lint-entity-semantic-default"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-semantic-default — the `orb lint entity-semantic-default <file>` command, the port of ORB_E_SEMANTIC_VALUE_INVALID and ORB_E_DEFAULT_TYPE_MISMATCH (entity.rs validate_field). It lowers the file with program/read and, for every top-level field of the primary entity typed email, url, phone, uuid or image whose default is a string literal, reports an empty default and a default the validate/email, validate/url (also for image), validate/phone or validate/uuid operator rejects, with the Rust path, message and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. It also checks every primary and auxiliary entity field's default against its declared type (config_type.rs check_field_def_shape): primitive kinds, enum membership of a non-string default, relation ids (to-many relations take an array of id strings), array elements and object members, with the Rust messages, skipping an `@` binding, an array headed by a namespaced operator, an optional field's null and a string default of an enum field (ORB_E_LITERAL_UNION_DEFAULT_MISMATCH owns that); union, tuple and event-typed fields and bare-operator calls are not ported. Clean answers `lint entity-semantic-default: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-semantic-default"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type FieldShape = string | number | boolean | [FieldShape] | Map string FieldShape
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type SemanticDefaultField = { type : string, default : FieldShape?, values : [string], required : boolean, relation : Map string string, properties : Map string FieldShape, items : FieldShape }
type SemanticDefaultEntity = { fields : [SemanticDefaultField] }
type SemanticDefaultEntityRef = SemanticDefaultEntity | string
type SemanticDefaultOrbital = { entity : SemanticDefaultEntityRef, auxiliaryEntities : [SemanticDefaultEntity], spec : boolean }
type SemanticDefaultProgram = { orbitals : [SemanticDefaultOrbital]! }
type SchemaRec = { np : string, t : string, hv : boolean, vals : [FieldShape], req : boolean, hp : boolean, keys : [string], many : boolean }
type ValRec = { np : string, dp : string, kind : string, raw : FieldShape? }

orbital OrbLintEntitySemanticDefaultOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntitySemanticDefaultRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintEntitySemanticDefault -> OrbLintEntitySemanticDefaultRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals : [SemanticDefaultOrbital] (object/get @payload.program "orbitals" [])))
          (array/concat
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((ent (object/get (array/nth @orbitals @oi) "entity" {})))
              (if (validate/object @ent) (if (not (object/get (array/nth @orbitals @oi) "spec" false)) (let ((fields (object/get @ent "fields" [])))
                (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                  (let ((f (array/nth @fields @fi)))
                    (let ((kind (object/get @f "type" "")) (lit (object/get @f "default" 0)) (at (str/concat "orbitals[" @oi "].entity.fields[" @fi "].default")))
                      (if (and (array/includes ["email" "url" "phone" "uuid" "image"] @kind) (validate/string @lit))
                        (if (= @lit "")
                          [{ code: "ORB_E_SEMANTIC_VALUE_INVALID", path: @at, message: (str/concat "A '" @kind "' field cannot default to an empty string"), suggestion: "Drop the default — the mock generator synthesizes a valid value", severity: "error" }]
                          (if (if (= @kind "email") (validate/email @lit) (if (= @kind "phone") (validate/phone @lit) (if (= @kind "uuid") (validate/uuid @lit) (validate/url @lit))))
                            []
                            [{ code: "ORB_E_SEMANTIC_VALUE_INVALID", path: @at, message: (str/concat "'" @lit "' is not a valid " @kind), suggestion: (str/concat "Provide a valid " @kind " or drop the default"), severity: "error" }]))
                        []))))))) []) [])))))
          (let ((ents (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
                      (let ((auxs (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
                        (array/filter
                          (array/concat (let ((e0 (object/get (array/nth @orbitals @oi) "entity" {}))) (if (validate/object @e0) [{ ent: @e0, base: (str/concat "orbitals[" @oi "].entity") }] []))
                            (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
                          (fn eb (and (validate/object (object/get @eb "ent")) (not (object/get (array/nth @orbitals @oi) "spec" false)))))))))))
              (array/flatten (array/map @ents (fn eb
                (let ((fields (object/get (object/get @eb "ent") "fields" [])))
                  (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                    (let ((f (array/nth @fields @fi)) (at (str/concat (object/get @eb "base") ".fields[" @fi "].default")))
                      (if (not (object/has @f "default"))
                        []
                        (let ((dflt (object/get @f "default")))
                          (if (or (and (object/has @f "values") (validate/string @dflt)) (and (not (object/get @f "required" false)) (= @dflt null)))
                            []
                          (let ((sch (tree/fold @f (fn (n k)
                              (if (validate/array @n)
                                (array/flatten @k)
                                (if (validate/object @n)
                                  (let ((t0 (object/get @n "type" 0)))
                                    (if (not (validate/string @t0))
                                      (array/flatten (array/map (array/sort (object/keys @n)) (fn key
                                        (array/map (object/get @k @key []) (fn h (object/set @h "np" (str/concat "." @key (object/get @h "np"))))))))
                                      (let ((ft (if (validate/string @t0) @t0 ""))
                                            (v0 (object/get @n "values" []))
                                            (r0 (object/get @n "required" false))
                                            (pr0 (object/get @n "properties" {}))
                                            (rl0 (object/get @n "relation" {})))
                                        (let ((vals (if (validate/array @v0) @v0 []))
                                              (req (if (validate/boolean @r0) @r0 false))
                                              (pr (if (validate/object @pr0) @pr0 {}))
                                              (cd0 (if (validate/object @rl0) (object/get @rl0 "cardinality" "") "")))
                                          (let ((cd (if (validate/string @cd0) @cd0 "")))
                                            (array/concat
                                              [{ np: "", t: @ft, hv: (object/has @n "values"), vals: @vals, req: @req, hp: (object/has @n "properties"), keys: (array/sort (object/keys @pr)), many: (and (= @ft "relation") (object/has @n "relation") (array/includes ["many" "one-to-many" "many-to-many"] @cd)) }]
                                              (if (and (= @ft "array") (object/has @n "items"))
                                                (array/map (object/get @k "items" []) (fn h (object/set @h "np" (str/concat "[]" (object/get @h "np")))))
                                                (if (and (= @ft "object") (object/has @n "properties"))
                                                  (object/get @k "properties" [])
                                                  []))))))))
                                  []))) FieldShape))
                              (val (if (= @dflt null)
                                [{ np: "", dp: "", kind: "null", raw: @dflt }]
                                (tree/fold @dflt (fn (n k) (let ((nn @n))
                                  (if (validate/array @n)
                                    (array/concat
                                      [{ np: "", dp: "", kind: (let ((h0 (array/nth @n 0))) (if (validate/string @h0) (if (str/includes @h0 "/") "deferred" "array") "array")), raw: @nn }]
                                      (array/flatten (array/map (array/range 0 (array/len @k)) (fn i
                                        (array/map (array/nth @k @i) (fn h (object/set (object/set @h "np" (str/concat "[]" (object/get @h "np"))) "dp" (str/concat "[" @i "]" (object/get @h "dp")))))))))
                                    (if (validate/object @n)
                                      (array/concat
                                        [{ np: "", dp: "", kind: "object", raw: @nn }]
                                        (array/flatten (array/map (object/keys @k) (fn key
                                          (array/map (object/get @k @key []) (fn h (object/set (object/set @h "np" (str/concat "." @key (object/get @h "np"))) "dp" (str/concat "." @key (object/get @h "dp")))))))))
                                      [{ np: "", dp: "", kind: (if (validate/string @n) (if (= (str/slice @n 0 1) (str/decode-uri-component "%40")) "deferred" "string") (if (validate/number @n) "number" (if (validate/boolean @n) "boolean" "null"))), raw: @nn }])))) FieldShape))))
                              (let ((found (array/flatten (array/map (if (validate/array @val) @val []) (fn vn
                                      (let ((m (array/filter (if (validate/array @sch) @sch []) (fn sn (= (object/get @sn "np") (object/get @vn "np"))))))
                                        (if (= (array/len @m) 0)
                                          []
                                          (let ((sn (array/first @m)))
                                            (let ((kd (object/get @vn "kind"))
                                                  (raw (object/get @vn "raw"))
                                                  (t (object/get @sn "t")))
                                              (let ((rs (if (validate/string @raw) @raw ""))
                                                    (vs (array/map (object/get @sn "vals") (fn x (if (validate/string @x) @x (json/stringify @x)))))
                                                    (desc (if (validate/array @raw)
                                                            (str/concat "(" (str/join (array/map @raw (fn bi (if (validate/array @bi) (let ((b0 (array/nth @bi 0))) (if (validate/string @b0) (str/concat "(" @b0 " …)") "(…)")) (if (validate/string @bi) @bi (if (validate/number @bi) (str/concat @bi "") (if (validate/boolean @bi) (if @bi "true" "false") (if (validate/object @bi) "{…}" "null"))))))) " ") ")")
                                                            (if (validate/string @raw) @raw (if (validate/number @raw) (str/concat @raw "") (if (validate/boolean @raw) (if @raw "true" "false") (if (validate/object @raw) "{…}" "null")))))))
                              (if (= @kd "deferred")
                                []
                                (if (array/includes ["union" "tuple" "event" "EventAddress"] @t)
                                  []
                                  (if (= @t "array")
                                    (if (= @kd "array") [] [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "expected an array, got " @desc), suggestion: "wrap the value(s) in `[ … ]`", severity: "error" }])
                                    (if (= @t "object")
                                      (if (= @kd "object") [] [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "expected an object, got " @desc), suggestion: (if (object/get @sn "hp") (str/concat "write this entry as an object literal `{ … }` with fields: " (str/join (object/get @sn "keys") ", ")) "write this entry as an object literal `{ … }`"), severity: "error" }])
                                      (let ((enum (if (object/get @sn "hv")
                                                    (if (= @kd "string")
                                                      (if (array/includes (object/get @sn "vals") @raw) "ok" "bad")
                                                      (if (= @kd "null") "ok" "wrong"))
                                                    "ok")))
                                        (if (= @enum "bad")
                                          [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "'" @rs "' isn't a legal enum value (allowed: " (str/join @vs ", ") ")"), suggestion: "", severity: "error" }]
                                          (if (= @enum "wrong")
                                            [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "expected a string member of [" (str/join @vs ", ") "], got " @kd), suggestion: "", severity: "error" }]
                                            (if (= @t "relation")
                                              (if (object/get @sn "many")
                                                (if (= @kd "null")
                                                  (if (object/get @sn "req") [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: "expected an array of relation ids, got null on a required field", suggestion: "", severity: "error" }] [])
                                                  (if (= @kd "array")
                                                    (let ((ra (if (validate/array @raw) @raw []))) (array/flatten (array/map (array/range 0 (array/len @ra)) (fn ii (let ((it (array/nth @ra @ii))) (if (if (validate/string @it) true (if (validate/array @it) (let ((h0 (array/nth @it 0))) (if (validate/string @h0) (str/includes @h0 "/") false)) false))
                                                          []
                                                          [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp") "[" @ii "]"), message: (str/concat "expected a relation id string, got " (if (validate/number @it) "number" (if (validate/boolean @it) "boolean" (if (validate/array @it) "array" (if (validate/object @it) "object" "null"))))), suggestion: "a to-many relation's default holds an array of id strings, never rows — store rows in a typed `Map string <Row>` field", severity: "error" }]))))))
                                                    [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "expected an array of relation ids, got " @kd), suggestion: "a to-many relation's default is absent, null, or an array of id strings", severity: "error" }]))
                                                (let ((tag "relation")) (let ((ok (if (= @tag "string") (= @kd "string") (if (= @tag "number") (= @kd "number") (if (= @tag "boolean") (= @kd "boolean") (if (= @tag "relation") (or (= @kd "string") (= @kd "null")) (or (= @kd "string") (= @kd "number")))))))) (if @ok [] [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "expected " @tag ", got " @kd), suggestion: (if (= @kd "object") "to declare an array of object records, define a named type alias — `type Item = { field : T, … }` — then annotate the knob `name : [Item]`. A bare `[json]` array lowers to unconstrained object elements; `[string]`/scalar element types cannot carry objects." ""), severity: "error" }]))))
                                              (if (array/includes ["string" "number" "boolean" "date" "datetime" "timestamp"] @t)
                                                (let ((tag @t)) (let ((ok (if (= @tag "string") (= @kd "string") (if (= @tag "number") (= @kd "number") (if (= @tag "boolean") (= @kd "boolean") (if (= @tag "relation") (or (= @kd "string") (= @kd "null")) (or (= @kd "string") (= @kd "number")))))))) (if @ok [] [{ code: "ORB_E_DEFAULT_TYPE_MISMATCH", path: (str/concat @at (object/get @vn "dp")), message: (str/concat "expected " @tag ", got " @kd), suggestion: (if (= @kd "object") "to declare an array of object records, define a named type alias — `type Item = { field : T, … }` — then annotate the knob `name : [Item]`. A bare `[json]` array lowers to unconstrained object elements; `[string]`/scalar element types cannot carry objects." ""), severity: "error" }])))
                                                [])))))))))))))))))))
                                (if (= (object/get @f "type" "") "relation")
                                  (array/map @found (fn x (object/set @x "suggestion" "a relation field's default is absent, null, or an id string; store a row in a typed `Map string <Row>` field")))
                                  @found))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-semantic-default", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : SemanticDefaultProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEntitySemanticDefaultCli -> OrbLintEntitySemanticDefaultRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-semantic-default <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-semantic-default") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-semantic-default: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-semantic-default") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-semantic-default: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-semantic-default" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-semantic-default` with its arguments and working directory."
        @synonyms "orb lint entity-semantic-default, semantic default"
      OrbLintEntitySemanticDefault.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntitySemanticDefaultCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntitySemanticDefaultOrbitalStart -> OrbLintEntitySemanticDefault, OrbLintEntitySemanticDefaultCli, OrbLintInput, Packs, Versions
}
