app std-orb-lint-entity-semantic-default [
  version: "1.0.0",
  inbound: ["cli-lint-entity-semantic-default"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-entity-semantic-default — the `orb lint entity-semantic-default <file>` command, the port of ORB_E_SEMANTIC_VALUE_INVALID (entity.rs validate_field). It lowers the file with program/read and, for every top-level field of a primary or auxiliary entity typed email, url, phone, uuid or image whose default is a string literal, reports an empty default and a default the validate/email, validate/url (also for image), validate/phone or validate/uuid operator rejects, with the Rust path, message and suggestion (status 500, exit 1). Orbitals marked `spec` are skipped, as validate_all_entities skips them. The default-against-declared-type check (ORB_E_DEFAULT_TYPE_MISMATCH, check_field_def_shape) is the compiler type checker's (config_type), not this lint's. Clean answers `lint entity-semantic-default: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-entity-semantic-default"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type FieldShape = string | number | boolean | [FieldShape?] | Map string FieldShape?
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type SemanticDefaultField = { type : string, default : FieldShape?, values : [string], required : boolean, relation : Map string string, properties : Map string FieldShape, items : FieldShape }
type SemanticDefaultEntity = { fields : [SemanticDefaultField] }
type SemanticDefaultEntityRef = SemanticDefaultEntity | string
type SemanticDefaultOrbital = { entity : SemanticDefaultEntityRef, auxiliaryEntities : [SemanticDefaultEntity], spec : boolean }
type SemanticDefaultProgram = { orbitals : [SemanticDefaultOrbital]! }

orbital OrbLintEntitySemanticDefaultOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintEntitySemanticDefaultRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintEntitySemanticDefault -> OrbLintEntitySemanticDefaultRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals : [SemanticDefaultOrbital] (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((auxs (object/get (array/nth @orbitals @oi) "auxiliaryEntities" [])))
              (array/flatten (array/map
                (array/concat [{ ent: (object/get (array/nth @orbitals @oi) "entity" {}), base: (str/concat "orbitals[" @oi "].entity") }]
                  (array/map (array/range 0 (array/len @auxs)) (fn ai { ent: (array/nth @auxs @ai), base: (str/concat "orbitals[" @oi "].auxiliaryEntities[" @ai "]") })))
                (fn eb
                  (let ((ent (object/get @eb "ent")))
                    (if (and (validate/object @ent) (not (object/get (array/nth @orbitals @oi) "spec" false))) (let ((fields (object/get @ent "fields" [])))
                      (array/flatten (array/map (array/range 0 (array/len @fields)) (fn fi
                        (let ((f (array/nth @fields @fi)))
                          (let ((kind (object/get @f "type" "")) (lit (object/get @f "default" 0)) (at (str/concat (object/get @eb "base") ".fields[" @fi "].default")))
                            (if (and (array/includes ["email" "url" "phone" "uuid" "image"] @kind) (validate/string @lit))
                              (if (= @lit "")
                                [{ code: "ORB_E_SEMANTIC_VALUE_INVALID", path: @at, message: (str/concat "A '" @kind "' field cannot default to an empty string"), suggestion: "Drop the default — the mock generator synthesizes a valid value", severity: "error" }]
                                (if (if (= @kind "email") (validate/email @lit) (if (= @kind "phone") (validate/phone @lit) (if (= @kind "uuid") (validate/uuid @lit) (validate/url @lit))))
                                  []
                                  [{ code: "ORB_E_SEMANTIC_VALUE_INVALID", path: @at, message: (str/concat "'" @lit "' is not a valid " @kind), suggestion: (str/concat "Provide a valid " @kind " or drop the default"), severity: "error" }]))
                              []))))))) [])))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "entity-semantic-default", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : SemanticDefaultProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEntitySemanticDefaultCli -> OrbLintEntitySemanticDefaultRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint entity-semantic-default: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint entity-semantic-default <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "entity-semantic-default") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint entity-semantic-default: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "entity-semantic-default") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint entity-semantic-default: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-entity-semantic-default" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint entity-semantic-default` with its arguments and working directory."
        @synonyms "orb lint entity-semantic-default, semantic default"
      OrbLintEntitySemanticDefault.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEntitySemanticDefaultCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEntitySemanticDefaultOrbitalStart -> OrbLintEntitySemanticDefault, OrbLintEntitySemanticDefaultCli, OrbLintInput, Packs, Versions
}
