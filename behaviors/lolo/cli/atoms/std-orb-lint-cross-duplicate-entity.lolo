app std-orb-lint-cross-duplicate-entity [
  version: "1.0.0",
  inbound: ["cli-lint-cross-duplicate-entity"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-cross-duplicate-entity — the `orb lint cross-duplicate-entity <file>` command, the port of ORB_X_DUPLICATE_ENTITY. It lowers the file with program/read and reports each inline entity name declared by more than one orbital, once, with the orbital names (status 500, exit 1). Clean answers `lint cross-duplicate-entity: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-cross-duplicate-entity"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type CrossDupField = { name : string!, type : string!, values : [string] }
type CrossDupEntity = { name : string, collection : string, persistence : string, fields : [CrossDupField] }
type CrossDupOrbital = { name : string, entity : CrossDupEntity, auxiliaryEntities : [CrossDupEntity] }
type CrossDupDecl = { orb : string!, owned : boolean!, name : string!, collection : string!, persistence : string!, fields : [CrossDupField]! }
type CrossDupFit = { c : CrossDupDecl!, w : CrossDupDecl! }
type CrossDupProgram = { orbitals : [CrossDupOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintCrossDuplicateEntityCodes = { xDuplicateEntity : LintCodeDecl, xCollectionEnumMismatch : LintCodeDecl }

orbital OrbLintCrossDuplicateEntityOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintCrossDuplicateEntityRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintCrossDuplicateEntity -> OrbLintCrossDuplicateEntityRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((owners (array/map @orbitals (fn o (if (validate/object (object/get @o "entity" {})) (object/get (object/get @o "entity" {}) "name" "") null)))))
            (let ((dupNames (array/filter @owners (fn x (and (!= @x null) (> (array/len (array/filter @owners (fn y (= @y @x)))) 1))))))
             (let ((ents (array/flatten (array/map @orbitals (fn o
                    (array/concat
                      (if (validate/object (object/get @o "entity" {})) [{ orb: (default @o.name ""), owned: true, name: (default @o.entity.name ""), collection: (default @o.entity.collection ""), persistence: (default @o.entity.persistence ""), fields: (default @o.entity.fields []) }] [])
                      (array/map (default @o.auxiliaryEntities []) (fn a { orb: (default @o.name ""), owned: false, name: (default @a.name ""), collection: (default @a.collection ""), persistence: (default @a.persistence ""), fields: (default @a.fields []) }))))))))
              (array/concat
                (let ((ownedFindings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((owners (array/map @orbitals (fn o (if (validate/object (object/get @o "entity" {})) (object/get (object/get @o "entity" {}) "name" "") null)))))
            (array/flatten (array/map (array/range 0 (array/len @owners)) (fn oi
              (let ((nm (array/nth @owners @oi)))
                (if (or (= @nm null) (!= (array/first (array/filter (array/range 0 (array/len @owners)) (fn j (= (array/nth @owners @j) @nm)))) @oi) (< (array/len (array/filter @owners (fn x (= @x @nm)))) 2))
                  []
                  (let ((places (array/map (array/filter @orbitals (fn o (= (if (validate/object (object/get @o "entity" {})) (object/get (object/get @o "entity" {}) "name" "") null) @nm))) (fn o (str/concat "\"" (default (object/get @o "name") "") "\"")))))
                    [{ code: @config.codes.xDuplicateEntity.code, path: "orbitals", message: (str/concat "Entity '" @nm "' is defined in multiple orbitals: [" (str/join @places ", ") "]"), suggestion: "Each entity name must be unique across all orbitals", severity: "error" }]))))))))))
                  @ownedFindings)
                (array/flatten (array/map (array/unique (array/map @ents (fn x @x.name))) (fn nm
                  (let ((group (array/filter @ents (fn x (= @x.name @nm)))))
                    (let ((involved (array/unique (array/map (array/filter @group (fn x (array/some @group (fn y (and (!= @x.orb @y.orb)
                      (let ((dir (array/map [{ c: @x, w: @y }, { c: @y, w: @x }] (fn d
                        (and (= @d.c.collection @d.w.collection)
                          (array/every @d.c.fields (fn f (array/some @d.w.fields (fn g (and (= @g.name @f.name) (= @g.type @f.type)))))))))))
                        (if (= @x.owned true) (not (default (array/nth @dir 1) false))
                          (if (= @y.owned true) (not (default (array/nth @dir 0) false))
                            (not (or (default (array/nth @dir 0) false) (default (array/nth @dir 1) false)))))))))))
                      (fn x @x.orb)))))
                      (if (or (array/includes @dupNames @nm) (= (array/len @involved) 0))
                        []
                        [{ code: @config.codes.xDuplicateEntity.code, path: "orbitals", message: (str/concat "Entity '" @nm "' is defined in multiple orbitals with different shapes: [" (str/join (array/map @involved (fn o (str/concat "\"" @o "\""))) ", ") "]"), suggestion: "Each entity name must be unique across all orbitals", severity: "error" }]))))))
                (let ((hits (array/flatten (array/map (array/range 0 (array/len @ents)) (fn j
                    (let ((b (array/nth @ents @j)))
                      (if (or (!= @b.persistence "persistent") (= @b.collection ""))
                        []
                        (array/flatten (array/map (array/filter @b.fields (fn f (> (array/len (default @f.values [])) 0))) (fn f
                          (let ((prior (array/filter (array/slice @ents 0 @j) (fn a (and (= @a.persistence "persistent") (= @a.collection @b.collection)
                              (array/some @a.fields (fn g (and (= @g.name @f.name) (> (array/len (default @g.values [])) 0)
                                (or (> (array/len (array/filter (default @g.values []) (fn v (not (array/includes (default @f.values []) @v))))) 0) (> (array/len (array/filter (default @f.values []) (fn v (not (array/includes (default @g.values []) @v))))) 0))))))))))
                            (if (= (array/len @prior) 0)
                              []
                              (let ((a (array/first @prior)))
                                (let ((ga (array/find @a.fields (fn g (= @g.name @f.name)))))
                                  [{ an: @a.name, bn: @b.name, c: @b.collection, f: @f.name, av: (default @ga.values []), bv: (default @f.values []) }]))))))))))))))
                  (array/flatten (array/map (array/range 0 (array/len @hits)) (fn k
                    (let ((h (array/nth @hits @k)))
                      (if (array/some (array/slice @hits 0 @k) (fn e (and (= @e.c @h.c) (= @e.f @h.f))))
                        []
                        (let ((onlyA (array/sort (array/filter (default @h.av []) (fn v (not (array/includes (default @h.bv []) @v)))))) (onlyB (array/sort (array/filter (default @h.bv []) (fn v (not (array/includes (default @h.av []) @v)))))))
                          [{ code: @config.codes.xCollectionEnumMismatch.code, path: "orbitals", message: (str/concat "entities '" @h.an "' and '" @h.bn "' share collection '" @h.c "' but declare field '" @h.f "' with different enum values: " (if (= (array/len @onlyA) 0) "(none)" (str/join @onlyA ", ")) " versus " (if (= (array/len @onlyB) 0) "(none)" (str/join @onlyB ", "))), suggestion: "Give both declarations the same value set, or keep one owner entity for the collection", severity: "error", validValues: (array/sort (array/unique (array/concat (default @h.av []) (default @h.bv [])))), entity: @h.bn, field: @h.f }])))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "cross-duplicate-entity", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CrossDupProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintCrossDuplicateEntityCodes = { xDuplicateEntity: { code: "ORB_X_DUPLICATE_ENTITY", category: "cross", description: "The same entity name is defined in more than one orbital" }, xCollectionEnumMismatch: { code: "ORB_X_COLLECTION_ENUM_MISMATCH", category: "cross", description: "Two persistent entities on one collection declare the same field as an enum with different value sets, so one entity's rows fail the other's type" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintCrossDuplicateEntityCli -> OrbLintCrossDuplicateEntityRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint cross-duplicate-entity <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint cross-duplicate-entity <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "cross-duplicate-entity") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint cross-duplicate-entity: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "cross-duplicate-entity") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint cross-duplicate-entity: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-cross-duplicate-entity" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint cross-duplicate-entity` with its arguments and working directory."
        @synonyms "orb lint cross-duplicate-entity, orb lint cross-duplicate-entity, values union default"
      OrbLintCrossDuplicateEntity.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintCrossDuplicateEntityCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintCrossDuplicateEntityOrbitalStart -> OrbLintCrossDuplicateEntity, OrbLintCrossDuplicateEntityCli, OrbLintInput, Packs, Versions
}
