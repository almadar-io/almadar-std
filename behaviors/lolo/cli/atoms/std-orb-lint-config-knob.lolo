app std-orb-lint-config-knob [
  version: "1.0.0",
  inbound: ["cli-lint-config-knob"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-config-knob — the `orb lint config-knob <file>` command, the port of the per-knob declaration checks of validate_config_field (types/config_type.rs). It lowers the file with program/read and, for every config knob of every inline trait, reports ORB_T_CONFIG_OBJECT_ARRAY_FORBIDDEN (a knob typed `object` or `[object]`), ORB_T_CONFIG_TIER_INVALID (a `@tier` outside domain, policy, infra, presentation, internal), ORB_T_SECRET_DEFAULT_NOT_STRING (a `secret` knob whose default is not a string), ORB_T_INVALID_EVENT_DEFAULT (an `event` knob whose default names no event of the trait's event set, holds a Trait.EVENT address while it defines an emitted event, or is neither a string nor a computed value) ORB_T_INVALID_PATTERN_DEFAULT (a `pattern` knob whose default is no installed pattern) and ORB_T_INVALID_SLOT_DEFAULT (a `slot` knob whose string default is not one of the slots in LINT_UI_VOCAB; an unreadable vocabulary answers ORB_LINT_UI_VOCAB_UNREAD at the knob), at `orbitals[<i> (<orbital>)].traits[<j> (<trait>)].config(<knob>)` with the compiler's message and suggestion (status 500, exit 1). A `field`, `[field]`, `render-ui` or `node` knob is checked for tier and type only, as the compiler does. Clean answers `lint config-knob: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-config-knob"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type KnobNode = string | number | boolean | [KnobNode?] | Map string KnobNode?
type KnobField = { type : string, default : KnobNode?, tier : string }
type KnobEmit = { event : string }
type KnobListen = { event : string, triggers : string }
type KnobEvent = { key : string }
type KnobTransition = { event : string }
type KnobMachine = { events : [KnobEvent], transitions : [KnobTransition] }
type KnobTrait = { name : string, config : Map string KnobField, emits : [KnobEmit], listens : [KnobListen], stateMachine : KnobMachine }
type KnobOrbital = { name : string, traits : [KnobTrait] }
type KnobProgram = { orbitals : [KnobOrbital] }
type KnobPattern = { drawHost : boolean }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintConfigKnobCodes = { tConfigObjectArrayForbidden : LintCodeDecl , tConfigTierInvalid : LintCodeDecl , tInvalidEventDefault : LintCodeDecl , tSecretDefaultNotString : LintCodeDecl , lintUiVocabUnread : LintCodeDecl , tInvalidSlotDefault : LintCodeDecl , tInvalidPatternDefault : LintCodeDecl }

orbital OrbLintConfigKnobOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintConfigKnobRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    patterns : [string] = []
    ops : [string] = []
    slots : [string] = []
    vocabUnread : boolean = false
  }

  trait OrbLintConfigKnob -> OrbLintConfigKnobRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_PATTERNS_HEARD -> ready
        (set @entity.patterns (object/keys @payload.patterns))
      LINT_OPERATOR_NAMES_HEARD -> ready
        (set @entity.ops @payload.names)
      UI_VOCAB_HEARD -> ready
        (set @entity.vocabUnread false)
        (set @entity.slots @payload.slots)
      UI_VOCAB_UNREAD -> ready
        (set @entity.vocabUnread true)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" []))) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((orb (array/nth @orbitals @oi))) (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti (let ((td (array/nth (object/get @orb "traits" []) @ti))) (if (not (object/has @td "stateMachine")) [] (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]"))) (let ((cfg (object/get @td "config" {})) (sm (object/get @td "stateMachine" {}))) (let ((raw (array/concat (array/concat (array/concat (array/concat (array/map (object/get @td "emits" []) (fn e (object/get @e "event" ""))) (array/map (object/get @td "listens" []) (fn e (object/get @e "event" "")))) (array/filter (array/map (object/get @td "listens" []) (fn l (object/get @l "triggers" ""))) (fn s (!= @s "")))) (array/map (object/get @sm "events" []) (fn e (object/get @e "key" "")))) (array/map (object/get @sm "transitions" []) (fn t (object/get @t "event" ""))))) (definers (array/unique (array/filter (array/map (array/concat (array/concat (array/map (object/get @td "emits" []) (fn e (object/get @e "event" ""))) (array/map (object/get @sm "events" []) (fn e (object/get @e "key" "")))) (array/map (object/get @sm "transitions" []) (fn t (object/get @t "event" "")))) (fn e (if (and (str/startsWith @e (quote "@config.")) (> (str/len @e) 8) (not (str/includes (str/slice @e 8 (str/len @e)) "."))) (str/slice @e 8 (str/len @e)) ""))) (fn s (!= @s "")))))) (let ((events (array/unique (array/flatten (array/map @raw (fn e (let ((kn (if (and (str/startsWith @e (quote "@config.")) (> (str/len @e) 8) (not (str/includes (str/slice @e 8 (str/len @e)) "."))) (str/slice @e 8 (str/len @e)) ""))) (if (!= @kn "") (let ((dv (object/get (object/get @cfg @kn {}) "default" null))) (if (and (validate/string @dv) (!= @dv "") (not (str/startsWith @dv (quote "@")))) [@dv] [])) (if (!= @e "") [@e] []))))))))) (array/flatten (array/map (object/keys @cfg) (fn k (let ((f (object/get @cfg @k)) (p (str/concat @tp ".config(" @k ")"))) (let ((ft (object/get @f "type" "")) (d (object/get @f "default" null)) (tier (object/get @f "tier" null))) (array/concat (array/concat (if (or (= @ft "[object]") (= @ft "object")) [{ code: @config.codes.tConfigObjectArrayForbidden.code, path: @p, message: (str/concat "Config field uses banned type '" @ft "'. Declare a named struct alias (e.g. `type FieldConfig = { name: string, label: string }`) and use the alias (`[FieldConfig]`) so the catalog + TS codegen carry real types. For inline render-ui trees, use the `render-ui` type instead."), suggestion: "Author the shape: `type <Name> = { field1: <T1>, field2: <T2> }`, then use `[<Name>]` (for arrays) or `<Name>` (for single objects) on the config field. For render-ui trees use `: render-ui`.", severity: "error" }] []) (if (and (validate/string @tier) (not (array/includes ["domain", "policy", "infra", "presentation", "internal"] @tier))) [{ code: @config.codes.tConfigTierInvalid.code, path: @p, message: (str/concat "Config field `@tier` value '" @tier "' is invalid. Allowed values: domain, policy, infra, presentation, internal."), suggestion: "Use one of: domain, policy, infra, presentation, internal.", severity: "error" }] [])) (if (array/includes ["field", "[field]", "render-ui", "node", "[node]"] @ft) [] (if (= @ft "event") (if (= @d null) [] (if (validate/string @d) (if (and (str/includes @d ".") (not (str/startsWith @d (quote "@")))) (if (array/includes @definers @k) [{ code: @config.codes.tInvalidEventDefault.code, path: @p, message: (str/concat "Config field typed `event` holds the address '" @d "' but this knob names an event the trait emits — an emitted event is a bare name"), suggestion: "Use a bare event name here; `Trait.EVENT` addresses another trait's input", severity: "error" }] []) (if (and (not (array/includes @definers @k)) (!= @d "") (not (str/startsWith @d (quote "@"))) (> (array/len @events) 0) (not (array/includes @events @d))) [{ code: @config.codes.tInvalidEventDefault.code, path: @p, message: (str/concat "Config field typed `event` holds '" @d "' but the trait's event set has no such key — must be one of: " (str/join (array/sort @events) ", ")), suggestion: "", severity: "error" }] [])) (if (and (validate/array @d) (> (array/len @d) 0) (!= (let ((h (array/first @d))) (if (validate/string @h) @h "")) "") (or (array/includes @entity.ops (let ((h (array/first @d))) (if (validate/string @h) @h ""))) (str/includes (let ((h (array/first @d))) (if (validate/string @h) @h "")) "/"))) [] [{ code: @config.codes.tInvalidEventDefault.code, path: @p, message: "Config field typed `event` must hold a string event name", suggestion: "Use a string event key, e.g. `event : event = SEARCH`, or \"\" for a default-off outlet", severity: "error" }]))) (if (= @ft "secret") (if (and (!= @d null) (not (validate/string @d))) [{ code: @config.codes.tSecretDefaultNotString.code, path: @p, message: "Config field typed `secret` must default to a string credential reference (an env-var key name)", suggestion: "Use a string env-var name, e.g. `connectionRef : secret = \"CRM_DB_URL\"`", severity: "error" }] []) (if (and (= @ft "slot") (validate/string @d)) (if @entity.vocabUnread [{ code: @config.codes.lintUiVocabUnread.code, path: @p, message: "the installed @almadar/core declares no readable UI vocabulary, so the valid slots of this `slot` knob are unknown", suggestion: "Reinstall @almadar/core so its language data declares orbLanguage.uiVocabulary", severity: "error" }] (if (array/includes @entity.slots @d) [] [{ code: @config.codes.tInvalidSlotDefault.code, path: @p, message: (str/concat "Config field typed `slot` has invalid default '" @d "' — must be one of: " (str/join @entity.slots ", ")), suggestion: "", severity: "error" }])) (if (and (= @ft "pattern") (validate/string @d) (not (array/includes @entity.patterns @d))) [{ code: @config.codes.tInvalidPatternDefault.code, path: @p, message: (str/concat "Config field typed `pattern` has invalid default '" @d "' — must be a known pattern type"), suggestion: "Use a known pattern type or ensure custom pattern is registered", severity: "error" }] []))))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "config-knob", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : KnobProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      LINT_PATTERNS_HEARD { patterns : Map string KnobPattern! }
        @description "std-orb-lint-input's LINT_PATTERNS: the installed pattern registry."
      OrbLintInput.LINT_PATTERNS -> LINT_PATTERNS_HEARD
      LINT_OPERATOR_NAMES_HEARD { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES_HEARD
      UI_VOCAB_HEARD { slots : [string]!  itemActionBaseProps : [string]!  lucideIcons : [string]!  themeKeys : [string]!  deliveryRoots : [string]!  eventSourceKeys : [string]! }
        @description "std-orb-lint-input's LINT_UI_VOCAB: the installed UI vocabulary; its slots are the valid defaults of a `slot` knob."
      UI_VOCAB_UNREAD { error : string! }
        @description "std-orb-lint-input's LINT_UI_VOCAB_UNREAD: the UI vocabulary could not be read."
      OrbLintInput.LINT_UI_VOCAB -> UI_VOCAB_HEARD
      OrbLintInput.LINT_UI_VOCAB_UNREAD -> UI_VOCAB_UNREAD
    }
    config {
      codes : LintConfigKnobCodes = { tConfigObjectArrayForbidden: { code: "ORB_T_CONFIG_OBJECT_ARRAY_FORBIDDEN", category: "trait", description: "A config field uses a banned bare object or array type instead of a named struct alias" }, tConfigTierInvalid: { code: "ORB_T_CONFIG_TIER_INVALID", category: "trait", description: "A config field declares a tier value outside domain, policy, infra, presentation and internal" }, tInvalidEventDefault: { code: "ORB_T_INVALID_EVENT_DEFAULT", category: "trait", description: "A config field typed event holds a value that is not a valid event name or member of the trait's event set" }, tSecretDefaultNotString: { code: "ORB_T_SECRET_DEFAULT_NOT_STRING", category: "trait", description: "A config field typed secret does not default to a string credential reference" }, lintUiVocabUnread: { code: "ORB_LINT_UI_VOCAB_UNREAD", category: "lint", description: "The installed @almadar/core declares no readable UI vocabulary, so a UI lint check cannot run" }, tInvalidSlotDefault: { code: "ORB_T_INVALID_SLOT_DEFAULT", category: "trait", description: "A slot-typed config field has a default that is not a valid slot" }, tInvalidPatternDefault: { code: "ORB_T_INVALID_PATTERN_DEFAULT", category: "trait", description: "A pattern-typed config knob has a default that is not a known pattern type" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintConfigKnobCli -> OrbLintConfigKnobRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint config-knob <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "config-knob") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint config-knob: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "config-knob") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint config-knob: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-config-knob" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint config-knob` with its arguments and working directory."
        @synonyms "orb lint config-knob"
      OrbLintConfigKnob.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintConfigKnobCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintConfigKnobOrbitalStart -> OrbLintConfigKnob, OrbLintConfigKnobCli, OrbLintInput, Packs, Versions
}
