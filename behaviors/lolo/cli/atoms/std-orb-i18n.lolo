app std-orb-i18n [
  version: "1.0.0",
  inbound: ["cli-i18n"],
  exec: ["orb"],
  env: ["PATH"],
  fs: { cwd: "node_modules/**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-i18n — the `orb i18n vocab [--json]` and `orb i18n check` commands (spec/cli/orb-i18n.lolo; golden: orbital-cli i18n.rs). The English side is installed data: the 12 parser sections are the lists in the file @almadar/core declares as orbLanguage.vocabulary, the `orb` section is read from the knob orbSource under @almadar/core (the stand-in src/i18n/en.json until core emits it into the vocabulary file), and the operator table is the key set of the file @almadar/std declares as orbLanguage.operators. The language packs come from std-orb-language (composed: its pack scan answers each pack's vocabulary text). vocab prints the 14 sections (text or 2-space JSON). check reports Missing, Empty and Orphan keys per language and section, Collision values, SelectorNotUnique first-token keywords and the parser-word coverage; clean answers `orb i18n check: ok — 0 problems`, otherwise status 500 with every problem listed, never truncated. Not ported: the parser-vs-English equality gate (the parser lists ARE the English table now)."
]
uses Spec from "almadar-std/orb-i18n"
uses Language from "std/behaviors/std-orb-language"

type OrbCommandArgs = { argv : [string]!, cwd : string! }
type ArgFlag = { name : string!, aliases : [string]!, takesValue : boolean!, repeatable : boolean! }
type LangBlock = { vocabulary : string?, operators : string? }
type PackageManifest = { orbLanguage : LangBlock? }
type EnglishParser = { keywords : [string]!, shapes : [string]!, tags : [string]!, categories : [string]!, capabilities : [string]!, annotations : [string]!, sigils : [string]!, effects : [string]!, types : [string]!, units : [string]!, literals : [string]!, reservedEvents : [string]! }
type PackMeta = { code : string! }
type PackDef = { meta : PackMeta!, keywords : Map string string, shapes : Map string string, tags : Map string string, categories : Map string string, capabilities : Map string string, annotations : Map string string, sigils : Map string string, effects : Map string string, types : Map string string, units : Map string string, literals : Map string string, reservedEvents : Map string string, orb : Map string string, operators : Map string string }
type PackEntry = { code : string!, def : PackDef! }
type EnSection = { name : string!, keys : [string]! }
type OrbOnly = { orb : Map string string! }
type OperatorEntry = { category : string? }
type OperatorTable = { operators : Map string OperatorEntry! }

orbital OrbI18nOrbital {
  uses Args from "std/behaviors/std-args"
  uses Semver from "std/behaviors/std-semver"

  entity I18nCall [runtime] {
    id : string!
    args : OrbCommandArgs = { argv: [], cwd: "" }
    cwd : string = ""
    cmd : string = ""
    json : boolean = false
    eng : EnglishParser = { keywords: [], shapes: [], tags: [], categories: [], capabilities: [], annotations: [], sigils: [], effects: [], types: [], units: [], literals: [], reservedEvents: [] }
    orbKeys : [string] = []
    opKeys : [string] = []
    enSections : [EnSection] = []
    defs : [PackEntry] = []
    packProblem : string = ""
    cov : [string] = []
    pcov : [string] = []
  }

  trait ArgsCli = Args.traits.ArgsParser {
    listens {
      OrbI18n.I18N_ARGS_PARSE -> ARGS_PARSE
    }
  }

  trait Versions = Semver.traits.Semver {
    listens {
      Packs.LANG_SEMVER -> SEMVER_SATISFIES
    }
  }

  trait Packs = Language.traits.OrbLanguageEngine {
    listens {
      OrbI18n.I18N_PACKS_RUN -> LANG_SCAN
      LANG_SAT { requestId : string!  value : boolean! }
        @description "std-semver's SEMVER_SATISFIED: the range check answered."
      LANG_SAT_REFUSED { requestId : string!  operation : string!  reason : string! }
        @description "std-semver's SEMVER_REFUSED: the range check refused."
      Versions.SEMVER_SATISFIED -> LANG_SAT
      Versions.SEMVER_REFUSED -> LANG_SAT_REFUSED
    }
  }

  trait OrbI18n -> I18nCall [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      I18N_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit I18N_ANSWERED { status: 400, body: "", stderr: "usage: orb i18n vocab [--json] | orb i18n check" })
      I18N_CALLED -> parsing when (!= (json/parse @payload.rawBody OrbCommandArgs) null)
        (set @entity.args (default (json/parse @payload.rawBody OrbCommandArgs) @entity.args))
        (set @entity.cwd (object/get @entity.args "cwd"))
        (emit I18N_ARGS_PARSE { stage: "i18n" argv: (object/get @entity.args "argv") flags: [{ name: "json" aliases: [] takesValue: false repeatable: false }] })
    }

    state parsing {
      INIT -> parsing
      I18N_ARGS_DONE -> ready when (or (> (array/len @payload.errors) 0) (!= (array/len @payload.positionals) 1) (not (array/includes ["vocab", "check"] (array/first @payload.positionals))) (and (= (array/first @payload.positionals) "check") (object/has @payload.flags "json")))
        (emit I18N_ANSWERED { status: 400, body: "", stderr: "usage: orb i18n vocab [--json] | orb i18n check" })
      I18N_ARGS_DONE -> loading when (and (= (array/len @payload.errors) 0) (= (array/len @payload.positionals) 1) (array/includes ["vocab", "check"] (array/first @payload.positionals)) (or (= (array/first @payload.positionals) "vocab") (not (object/has @payload.flags "json"))))
        (set @entity.cmd (default (array/first @payload.positionals) ""))
        (set @entity.json (object/has @payload.flags "json"))
        (os/read-file { anchor: "cwd" path: "node_modules/@almadar/core/package.json" } { key: "core" emit: { success: I18N_CORE_PKG, failure: I18N_FAILED } })
    }

    state loading {
      INIT -> loading
      I18N_FAILED -> ready
        (emit I18N_ANSWERED { status: 500, body: "", stderr: (str/concat "orb i18n: " (default @payload.error "")) })
      I18N_CORE_PKG -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) null)
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: core package.json is unreadable" })
      I18N_CORE_PKG -> ready when (and (!= (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) null) (let ((none : PackageManifest { orbLanguage: null }) (noLang : LangBlock { vocabulary: null, operators: null }) (m : PackageManifest (default (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) @none)) (l : LangBlock (default (object/get @m "orbLanguage") @noLang))) (= (object/get @l "vocabulary") null)))
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: core declares no orbLanguage.vocabulary" })
      I18N_CORE_PKG -> loading when (and (!= (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) null) (let ((none : PackageManifest { orbLanguage: null }) (noLang : LangBlock { vocabulary: null, operators: null }) (m : PackageManifest (default (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) @none)) (l : LangBlock (default (object/get @m "orbLanguage") @noLang))) (!= (object/get @l "vocabulary") null)))
        (let ((none : PackageManifest { orbLanguage: null }) (noLang : LangBlock { vocabulary: null, operators: null }) (m : PackageManifest (default (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) @none)) (l : LangBlock (default (object/get @m "orbLanguage") @noLang))) (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/core/" (default (object/get @l "vocabulary") "")) } { key: "vocabulary" emit: { success: I18N_ENG_FILE, failure: I18N_FAILED } }))
      I18N_ENG_FILE -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") EnglishParser) null)
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: the core vocabulary file is not the 12 parser sections" })
      I18N_ENG_FILE -> loading when (!= (json/parse (default (bytes/to-string @payload.data) "") EnglishParser) null)
        (set @entity.eng (default (json/parse (default (bytes/to-string @payload.data) "") EnglishParser) @entity.eng))
        (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/core/" @config.orbSource) } { key: "orb" emit: { success: I18N_ORB_FILE, failure: I18N_FAILED } })
      I18N_ORB_FILE -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") OrbOnly) null)
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: the orb source has no orb section" })
      I18N_ORB_FILE -> loading when (!= (json/parse (default (bytes/to-string @payload.data) "") OrbOnly) null)
        (set @entity.orbKeys (object/keys (object/get (json/parse (default (bytes/to-string @payload.data) "") OrbOnly) "orb")))
        (os/read-file { anchor: "cwd" path: "node_modules/@almadar/std/package.json" } { key: "std" emit: { success: I18N_STD_PKG, failure: I18N_FAILED } })
      I18N_STD_PKG -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) null)
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: std package.json is unreadable" })
      I18N_STD_PKG -> ready when (and (!= (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) null) (let ((none : PackageManifest { orbLanguage: null }) (noLang : LangBlock { vocabulary: null, operators: null }) (m : PackageManifest (default (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) @none)) (l : LangBlock (default (object/get @m "orbLanguage") @noLang))) (= (object/get @l "operators") null)))
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: std declares no orbLanguage.operators" })
      I18N_STD_PKG -> loading when (and (!= (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) null) (let ((none : PackageManifest { orbLanguage: null }) (noLang : LangBlock { vocabulary: null, operators: null }) (m : PackageManifest (default (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) @none)) (l : LangBlock (default (object/get @m "orbLanguage") @noLang))) (!= (object/get @l "operators") null)))
        (let ((none : PackageManifest { orbLanguage: null }) (noLang : LangBlock { vocabulary: null, operators: null }) (m : PackageManifest (default (json/parse (default (bytes/to-string @payload.data) "") PackageManifest) @none)) (l : LangBlock (default (object/get @m "orbLanguage") @noLang))) (os/read-file { anchor: "cwd" path: (str/concat "node_modules/@almadar/std/" (default (object/get @l "operators") "")) } { key: "operators" emit: { success: I18N_OPS_FILE, failure: I18N_FAILED } }))
      I18N_OPS_FILE -> ready when (= (json/parse (default (bytes/to-string @payload.data) "") OperatorTable) null)
        (emit I18N_ANSWERED { status: 500, body: "", stderr: "orb i18n: the std operator table is unreadable" })
      I18N_OPS_FILE -> loading when (!= (json/parse (default (bytes/to-string @payload.data) "") OperatorTable) null)
        (set @entity.opKeys (object/keys (object/get (json/parse (default (bytes/to-string @payload.data) "") OperatorTable) "operators")))
        (emit I18N_LOADED { tag: "0" })
      ;; every configured parser section is a field of the English parser record, so the empty list never answers
      I18N_LOADED -> ready when (= @entity.cmd "vocab")
        (emit I18N_ANSWERED { status: 200, body: (if @entity.json (str/concat "{\n" (str/join (array/concat (array/map @config.parserSections (fn s (str/concat "  " (json/stringify @s) ": " (let ((a (default (object/get @entity.eng @s) []))) (if (= (array/len @a) 0) "[]" (str/concat "[\n    " (str/join (array/map @a (fn w (json/stringify @w))) ",\n    ") "\n  ]")))))) [(str/concat "  " (json/stringify "orb") ": " (let ((a (array/map (array/sort (array/map @entity.orbKeys (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))))) (if (= (array/len @a) 0) "[]" (str/concat "[\n    " (str/join (array/map @a (fn w (json/stringify @w))) ",\n    ") "\n  ]")))) (str/concat "  " (json/stringify "operators") ": " (let ((a (array/map (array/sort (array/map @entity.opKeys (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))))) (if (= (array/len @a) 0) "[]" (str/concat "[\n    " (str/join (array/map @a (fn w (json/stringify @w))) ",\n    ") "\n  ]"))))]) ",\n") "\n}") (str/join (array/concat (array/map @config.parserSections (fn s (let ((ws (default (object/get @entity.eng @s) []))) (str/concat @s " (" (array/len @ws) "): " (str/join @ws " "))))) [(str/concat "orb (" (array/len @entity.orbKeys) "): " (str/join (array/map (array/sort (array/map @entity.orbKeys (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))) " ")) (str/concat "operators (" (array/len @entity.opKeys) "): " (str/join (array/map (array/sort (array/map @entity.opKeys (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))) " "))]) "\n")), stderr: "" })
      I18N_LOADED -> checking when (= @entity.cmd "check")
        (set @entity.defs [])
        (set @entity.packProblem "")
        (emit I18N_PACKS_RUN { cwd: @entity.cwd })
    }

    state checking {
      INIT -> checking
      LANGUAGE_PACK_VOCAB_HEARD -> ready when (= (json/parse @payload.text PackDef) null)
        (emit I18N_ANSWERED { status: 500, body: (str/concat "orb i18n check: language packs → " @payload.name " is not a language pack"), stderr: "" })
      LANGUAGE_PACK_VOCAB_HEARD -> checking when (!= (json/parse @payload.text PackDef) null)
        (set @entity.defs (array/append @entity.defs { code: (object/get (object/get (json/parse @payload.text PackDef) "meta") "code"), def: (json/parse @payload.text PackDef) }))
      LANGUAGE_PACKS_DONE_HEARD -> ready when (!= @payload.problem "")
        (emit I18N_ANSWERED { status: 500, body: (str/concat "orb i18n check: language packs → " @payload.problem), stderr: "" })
      LANGUAGE_PACKS_DONE_HEARD -> checking when (= @payload.problem "")
        (emit I18N_COMPUTE { tag: "0" })
      I18N_COMPUTE -> checking
        (set @entity.enSections (array/map @config.sections (fn s (let ((raw (if (= @s "orb") @entity.orbKeys (if (= @s "operators") @entity.opKeys (default (object/get @entity.eng @s) []))))) { name: @s, keys: (array/map (array/sort (array/map @raw (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))) }))))
        (set @entity.defs (array/sort @entity.defs "code" "asc"))
        (set @entity.cov (array/concat (array/flatten (array/map @entity.defs (fn e (let ((c (object/get @e "code")) (d (object/get @e "def"))) (array/flatten (array/map @entity.enSections (fn sec (let ((s (object/get @sec "name")) (E (object/get @sec "keys")) (M (default (object/get @d (object/get @sec "name")) {}))) (array/concat (array/map (array/filter @E (fn k (or (= (object/get @M @k) null) (= (object/get @M @k) "")))) (fn k (str/concat "  " @c "." @s "." @k ": " (if (= (object/get @M @k) null) "Missing" "Empty")))) (array/map (array/filter (array/map (array/sort (array/map (object/keys @M) (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))) (fn k (not (array/includes @E @k)))) (fn k (str/concat "  " @c "." @s "." @k ": Orphan")))))))))))) (array/flatten (array/map @entity.defs (fn e (let ((c (object/get @e "code")) (d (object/get @e "def"))) (array/flatten (array/map @entity.enSections (fn sec (let ((s (object/get @sec "name")) (M (default (object/get @d (object/get @sec "name")) {}))) (let ((ks (array/map (array/sort (array/map (object/keys @M) (fn k { k: @k })) "k" "asc") (fn o (object/get @o "k"))))) (array/map (array/filter (array/range 0 (array/len @ks)) (fn i (> (array/len (array/filter (array/range 0 @i) (fn j (= (object/get @M (default (array/nth @ks @j) "")) (object/get @M (default (array/nth @ks @i) "")))))) 0))) (fn i (str/concat "  " @c "." @s "." (default (array/nth @ks @i) "") ": Collision")))))))))))) (let ((u (array/sort (array/sort (array/concat (array/concat (array/map @config.selectorKeywords (fn kw { v: @kw, code: "en", section: "keywords", key: @kw })) [{ v: "orbitals", code: "en", section: "orb", key: "orbitals" }]) (array/flatten (array/map @entity.defs (fn e (let ((c (object/get @e "code")) (d (object/get @e "def"))) (array/concat (array/map (array/filter @config.selectorKeywords (fn kw (!= (object/get (default (object/get @d "keywords") {}) @kw) null))) (fn kw { v: (default (object/get (default (object/get @d "keywords") {}) @kw) ""), code: @c, section: "keywords", key: @kw })) (if (object/has (default (object/get @d "orb") {}) "orbitals") [{ v: (default (object/get (default (object/get @d "orb") {}) "orbitals") ""), code: @c, section: "orb", key: "orbitals" }] []))))))) "code" "asc") "v" "asc"))) (array/map (array/filter @u (fn x (> (array/len (array/filter @u (fn y (and (= (object/get @y "v") (object/get @x "v")) (!= (object/get @y "code") (object/get @x "code")))))) 0))) (fn x (str/concat "  " (object/get @x "code") "." (object/get @x "section") "." (object/get @x "key") ": SelectorNotUnique"))))))
        (set @entity.pcov (array/flatten (array/map @entity.defs (fn e (let ((c (object/get @e "code")) (d (object/get @e "def"))) (array/flatten (array/map @config.parserSections (fn s (let ((M (default (object/get @d @s) {}))) (array/map (array/filter (default (object/get @entity.eng @s) []) (fn w (or (= (object/get @M @w) null) (= (object/get @M @w) "")))) (fn w (str/concat "  " @c "." @s "." @w ": " (if (= (object/get @M @w) null) "missing" "empty")))))))))))))
        (emit I18N_REPORT { tag: "0" })
      I18N_REPORT -> ready when (= (+ (array/len @entity.cov) (array/len @entity.pcov)) 0)
        (emit I18N_ANSWERED { status: 200, body: "orb i18n check: ok — 0 problems", stderr: "" })
      I18N_REPORT -> ready when (> (+ (array/len @entity.cov) (array/len @entity.pcov)) 0)
        (emit I18N_ANSWERED { status: 500, body: (str/join (array/concat [(str/concat "orb i18n check: " (+ (array/len @entity.cov) (array/len @entity.pcov)) " problem(s)")] (if (> (array/len @entity.cov) 0) (array/concat [""] [(str/concat "translation coverage — non-English tables vs en.json (" (array/len @entity.cov) "):")] @entity.cov) []) (if (> (array/len @entity.pcov) 0) (array/concat [""] [(str/concat "translation coverage — non-English tables vs orbital-lolo parser vocabulary (" (array/len @entity.pcov) "):")] @entity.pcov) [])) "\n"), stderr: "" })
    }

    emits {
      I18N_ANSWERED -> internal {
        status : number!
        body : string!
        stderr : string
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      I18N_ARGS_PARSE {
        stage : string!
        argv : [string]!
        flags : [ArgFlag]!
      }
        @description "Internal: parse the call's words."
        @tier "internal"
      I18N_PACKS_RUN { cwd : string! }
        @description "Internal: run the std-orb-language pack scan."
        @tier "internal"
      I18N_FAILED { kind : string  error : string }
        @description "Internal: a host call failed."
        @tier "internal"
      I18N_CORE_PKG { data : bytes! }
        @description "Internal: core's package.json."
        @tier "internal"
      I18N_ENG_FILE { data : bytes! }
        @description "Internal: the core vocabulary file."
        @tier "internal"
      I18N_ORB_FILE { data : bytes! }
        @description "Internal: the orb section source."
        @tier "internal"
      I18N_STD_PKG { data : bytes! }
        @description "Internal: std's package.json."
        @tier "internal"
      I18N_OPS_FILE { data : bytes! }
        @description "Internal: std's operator table."
        @tier "internal"
      I18N_LOADED { tag : string }
        @description "Internal: the English side is loaded."
        @tier "internal"
      I18N_COMPUTE { tag : string }
        @description "Internal: compute the problems."
        @tier "internal"
      I18N_REPORT { tag : string }
        @description "Internal: print the problems."
        @tier "internal"
    }

    config {
      orbSource : string = "src/i18n/en.json"
        @label "Orb section source"
        @description "The file under @almadar/core whose orb section is the English structural key table (a stand-in until core emits the section into its vocabulary file)."
      parserSections : [string] = ["keywords", "shapes", "tags", "categories", "capabilities", "annotations", "sigils", "effects", "types", "units", "literals", "reservedEvents"]
      sections : [string] = ["keywords", "shapes", "tags", "categories", "capabilities", "annotations", "sigils", "effects", "types", "units", "literals", "reservedEvents", "orb", "operators"]
      selectorKeywords : [string] = ["app", "uses", "expects", "type", "theme", "orbital"]
    }

    listens {
      I18N_CALLED -> inbound "cli-i18n" answers I18N_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb i18n vocab [--json]` or `orb i18n check` with its arguments and working directory."
        @synonyms "orb i18n, language vocabulary, translation coverage"
      I18N_ARGS_DONE {
        stage : string!
        flags : Map string [string]!
        positionals : [string]!
        errors : [string]!
        words : [string]!
      }
        @description "std-args's ARGS_PARSED: the call's words, parsed."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      ArgsCli.ARGS_PARSED -> I18N_ARGS_DONE
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbI18nOrbitalStart -> OrbI18n, ArgsCli, Packs, Versions
}
