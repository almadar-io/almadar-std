app std-orb-produced-events [
  version: "1.0.0",
  description: "std-orb-produced-events - the one place a lint run decides which event names an effect tree produces, the port of the compiler's collect_effect_produced_events. For every inline trait of the offered program it walks the transition effects and the tick effects (not the config defaults) and answers PRODUCED_EVENTS { scope, byControl, byEffect }, each a map from trait name to its event names. byEffect holds the string slots of every operator call's `emit` map that the operator table names (PRODUCED_SLOTS_HEARD, from std-orb-lint-input's LINT_OPERATOR_SEMANTICS emitSlots) and the string `emit: \"X\"` form. byControl holds, for each rendered pattern, the leaves of its own event props and the eventField of its own event-list props (PRODUCED_PATTERNS_HEARD, from LINT_EVENT_PROPS byPattern); leaves are read through the operators' value-source slots (LINT_OPERATOR_WALK) with every branch counted. `(emit X)` is not an effect tree's production, no bus-excluded event is dropped, and an empty name or a binding is never credited. It is not std-orb-fired-events with a flag: a program that composes both needs two distinct traits, because the composed address of a trait is its source trait's name."
]
uses Spec from "almadar-std/produced-events"
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type FiredNames = [string]
type FiredNodes = [FiredNode?]
type FiredMap = Map string FiredNode?
type FiredItem = [string]
type FiredLf = { lf : [FiredNode?]!, ll : [FiredNode?]! }
type WalkSlot = { kind : string!, args : [number] }
type FiredPatternProp = { pattern : string!, prop : string!, field : string! }

orbital OrbProducedEventsOrbital {
  entity OrbProducedEventsRun [runtime] {
    id : string!
    walk : Map string WalkSlot = {}
    functions : [string] = []
    rows : [FiredPatternProp] = []
    slots : [string] = []
  }

  trait OrbProducedEvents -> OrbProducedEventsRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      PRODUCED_SEMANTICS_HEARD -> ready
        (set @entity.functions @payload.functions)
      PRODUCED_WALK_HEARD -> ready
        (set @entity.walk @payload.slots)
      PRODUCED_PATTERNS_HEARD -> ready
        (set @entity.rows @payload.byPattern)
      PRODUCED_SLOTS_HEARD -> ready
        (set @entity.slots @payload.emitSlots)
      PRODUCED_INPUT_HEARD -> ready
        (let ((slots @entity.slots) (sem @entity.walk) (noslot : WalkSlot { kind: "", args: [] }) (nr : [FiredItem] []) (nl : FiredLf { lf: [], ll: [] }) (fnSet (default (object/fromEntries (array/map @entity.functions (fn x [(str/replaceAll (str/replaceAll @x "~" "~t") "." "~d"), true]))) {})) (rowsBy (default (array/groupBy @entity.rows (fn row (str/replaceAll (str/replaceAll (object/get @row "pattern") "~" "~t") "." "~d"))) {})))
          (let ((recs (array/flatten (array/map (object/get @payload.program "orbitals" []) (fn o
                  (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t
                    (let ((effs (array/concat
                                   (array/flatten (array/map (object/get @t "stateMachine.transitions" []) (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r })))))
                                   (array/flatten (array/map (object/get @t "ticks" []) (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))
                      (let ((fr (tree/fold @effs (fn (n k)
  (if (validate/array @n)
    (array/flatten (array/map @k (fn r (if (= @r null) @nr @r))))
    (if (validate/object @n)
      (let ((kv (object/keys @k)))
        (let ((kids0 (array/flatten (array/map (object/values @k) (fn r (if (= @r null) @nr @r)))))
              (hasEm (object/has @k "emit"))
              (ty (object/get @n "type" null)))
          (if (and (= (array/len @kids0) 0) (not @hasEm) (not (validate/string @ty))) @nr
            (let ((kids (if (str/includes (json/stringify @kv) ".")
                          (array/flatten (array/map @kv (fn key (let ((r (object/get @k @key null))) (if (= @r null) @nr @r)))))
                          @kids0))
                  (emitEv (if @hasEm
                            (let ((em (object/get @n "emit" null)))
                              (if (validate/object @em)
                                (array/map (array/flatten (array/map @slots (fn sl (let ((v (object/get @em @sl null))) (if (validate/string @v) [(str/concat @v "")] []))))) (fn x ["e", @x]))
                                (if (validate/string @em) [["e", (str/concat @em "")]] [])))
                            []))
                  (rows (if (validate/string @ty) (object/get @rowsBy (str/replaceAll (str/replaceAll @ty "~" "~t") "." "~d") []) [])))
              (let ((ctlItems (if (= (array/len @rows) 0) [] (array/flatten (array/map @rows (fn row
  (let ((prop (object/get @row "prop")) (field (object/get @row "field")))
    (if (object/has @n @prop)
      (let ((leaves (let ((v (object/get @n @prop null))) (if (validate/array @v) (let ((sr (tree/fold @v (fn (n k)
  (if (validate/array @n)
    (let ((len (array/len @n)) (kk : [FiredLf] (array/map @k (fn r (default (as @r FiredLf) @nl)))))
      (let ((argc (- @len 1)))
        (let ((sl (let ((h (array/nth @n 0))) (if (and (> @len 0) (validate/string @h)) (default (object/get @sem @h) @noslot) @noslot))) (sm (object/get @sl "kind" "")))
          (let ((lamIdx (if (= @sm "lambdaResult") (array/filter (array/range 0 (if (> @argc 0) @argc 0)) (fn i (let ((a (array/nth @n (+ @i 1)))) (and (validate/array @a) (>= (array/len @a) 3) (let ((a0 (array/nth @a 0))) (and (validate/string @a0) (object/has @fnSet (str/replaceAll (str/replaceAll @a0 "~" "~t") "." "~d")))))))) []))
                (picked (if (= @sm "listed") (object/get @sl "args" []) [])))
            (let ((sel (if (= @sm "branches") (if (< @argc 2) null (array/flatten (array/map (array/range 2 @len) (fn j (object/get (array/nth @kk @j) "lf")))))
                         (if (= @sm "args") (if (< @argc 1) null (array/flatten (array/map (array/range 1 @len) (fn j (object/get (array/nth @kk @j) "lf")))))
                           (if (= @sm "last") (if (>= @argc 1) (object/get (array/nth @kk @argc) "lf") null)
                             (if (= @sm "lambdaResult") (if (> (array/len @lamIdx) 0) (object/get (array/nth @kk (+ (array/last @lamIdx) 1)) "ll") null)
                               (if (and (> (array/len @picked) 0) (not (array/some @picked (fn i (or (< @i 0) (>= @i @argc)))))) (array/flatten (array/map @picked (fn i (object/get (array/nth @kk (+ @i 1)) "lf")))) null)))))))
              { lf: (if (= @sel null) [@n] (if (and (= (array/len @sel) 0) (!= @sm "branches")) [@n] @sel)), ll: (if (> @len 0) (object/get (array/last @kk) "lf") []) })))))
    { lf: [@n], ll: [] })) "FiredNode"))) (default (as (object/get @sr "lf" []) FiredNodes) [])) (if (= @v null) [] [@v])))))
        (if (= @field "")
          (array/map (array/flatten (array/map @leaves (fn lf (if (validate/string @lf) [(str/concat @lf "")] [])))) (fn x ["c", @x]))
          (array/map (array/flatten (array/map @leaves (fn lf (let ((items : FiredNodes (if (validate/array @lf) (default (as @lf FiredNodes) []) [@lf]))) (array/flatten (array/map @items (fn it (let ((m : FiredMap? (as @it FiredMap))) (if (= @m null) [] (let ((fv : FiredNode? (object/get @m @field null))) (if (validate/string @fv) [(str/concat @fv "")] []))))))))))) (fn x ["c", @x]))))
      []))))))))
                (let ((all (array/concat (array/concat @kids @emitEv) @ctlItems)))
                  (if (= (array/len @all) 0) @nr @all)))))))
      @nr))) "FiredNode")))
                        (let ((items (array/filter (default @fr []) (fn x (validate/array @x)))))
                          { trait: (object/get @t "name" ""), ev: (array/map (array/filter @items (fn x (= (array/nth @x 0) "e"))) (fn x (array/nth @x 1))), ctl: (array/map (array/filter @items (fn x (= (array/nth @x 0) "c"))) (fn x (array/nth @x 1))) }))))))))))
            (let ((tnames (array/unique (array/map @recs (fn r (object/get @r "trait" "")))))
                  (g (array/groupBy @recs (fn r (str/replaceAll (str/replaceAll (object/get @r "trait" "") "~" "~t") "." "~d")))))
              (emit PRODUCED_EVENTS {
                scope: @payload.scope,
                byControl: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/filter (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "ctl" [])))) (fn x (and (!= @x "") (not (str/startsWith @x (quote "@"))))))))]))) {}),
                byEffect: (default (object/fromEntries (array/map @tnames (fn nm [@nm, (array/sort (array/unique (array/filter (array/flatten (array/map (object/get @g (str/replaceAll (str/replaceAll @nm "~" "~t") "." "~d") []) (fn r (object/get @r "ev" [])))) (fn x (and (!= @x "") (not (str/startsWith @x (quote "@"))))))))]))) {}) }))))
    }

    emits {
      PRODUCED_EVENTS -> external { scope : string!  byControl : Map string [string]!  byEffect : Map string [string]! }
        @description "The event names the effect trees produce, per trait: byControl by a rendered pattern's own event prop or event-list field, byEffect by an operator's emit map or the string emit form."
        @tier "internal"
    }

    listens {
      PRODUCED_SEMANTICS_HEARD { functions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators."
      PRODUCED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      PRODUCED_PATTERNS_HEARD { byPattern : [FiredPatternProp]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: each pattern's event props and event-list fields."
      PRODUCED_SLOTS_HEARD { emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the emit option slots the operator table declares."
      PRODUCED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "A program whose produced events are asked."
    }
  }

  page boot as OrbProducedEventsOrbitalStart -> OrbProducedEvents
}
