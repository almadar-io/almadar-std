app std-orb-lint-http-request [
  version: "1.0.0",
  inbound: ["cli-lint-http-request"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-http-request — the `orb lint http-request <file>` command, the port of the call-shape checks of effect/http.rs (check_http_call, check_request, check_auth, check_token_exchange, check_rotate) that need nothing the operator table does not state: every `(http <method> <origin> <path> <request>? <options>?)` call, found at any depth of a guard or effect of an inline trait. The method words and the auth scheme words come from the installed operator table (the `method` parameter and the `auth.scheme` field of `request`) through std-orb-lint-host-calls. Reports ORB_HTTP_METHOD_UNKNOWN (a method that is not text or not one of the table's words), ORB_HTTP_PATH_INVALID (a literal path that does not begin with a single `/`, contains a backslash, or carries a `#` fragment; an `oauth-endpoint` call has no path), ORB_HTTP_AUTH_SCHEME_UNKNOWN (an auth object whose scheme is missing, not text or not one of the table's words), ORB_HTTP_PAGINATE_MAX_MISSING (a paginate object without `max`), ORB_HTTP_STREAM_WITHOUT_ON_MESSAGE (a request with `stream` and no `emit.onMessage` in the options) and ORB_HTTP_TOKEN_ROTATE_INVALID (an auth.rotate of a token-exchange or jwt-bearer scheme that is not { field, credential }, lacks `grant: refresh_token`, a field, or a credential that is the credential of auth.body.refresh_token). Not reported here: ORB_HTTP_AUTH_INVALID, ORB_HTTP_BODY_CONFLICT, ORB_HTTP_HEADER_INVALID, ORB_HTTP_REQUEST_OPTION_INVALID and ORB_HTTP_OPTION_UNKNOWN, which need data the operator table does not state or the compiler's type inference. Findings carry the Rust path (the guard or effect), message and suggestion (status 500, exit 1). Clean answers `lint http-request: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-http-request"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOrbital = { name : string, traits : [HcVal] }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]! }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcClosed = { request : boolean?, intRange : HcIntRange? }
type HcOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HcOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HcOauthOp]! }
type HcGrantNeed = Map string HcVal
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type HcValMap = Map string HcVal?
type LnVal = string | number | boolean | [LnVal?] | Map string LnVal?
type LnProgram = { orbitals : [HcOrbital] }
type HcValMap = Map string HcVal?


orbital OrbLintHttpRequestOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Calls from "std/behaviors/std-orb-lint-host-calls"

  entity OrbLintHttpRequestRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []

  }

  trait OrbLintHttpRequest -> OrbLintHttpRequestRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (emit HOST_CALLS_COLLECT { requestId: (str/concat "http-request:" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["http"], operators: ["http"], fields: [] })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "http-request:") @payload.unread)
        (set @entity.findings [{ code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", path: "operators", message: "the installed @almadar/std operator table could not be read, so the http vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }])
        (emit LINT_FINISH { })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "http-request:") (not @payload.unread))
        (set @entity.findings (let ((facts @payload.facts) (none : [OrbFinding] []) (nos : [string] []))
          (let ((fhttp (object/get @facts "http")))
            (let ((methods (object/get (object/get @fhttp "words") "method" @nos)) (schemes (object/get (object/get @fhttp "words") "request/auth/scheme" @nos)) (etarget (object/get (object/get @fhttp "oauth" { endpointTarget: "", endpointKinds: [], ops: [] }) "endpointTarget" "")))
              (array/flatten (array/map @payload.calls (fn c
                (let ((a (object/get @c "call")) (p (object/get @c "path")))
                  (let ((n (array/len @a)))
                    (let ((last (array/last @a))) (let ((m (if (> @n 1) (array/nth @a 1) null))) (let ((o (if (> @n 2) (array/nth @a 2) null))) (let ((pth (if (> @n 3) (array/nth @a 3) null))) (let ((trailing (and (> @n 4) (validate/object @last) (or (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "emit") (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "key"))))) (let ((hasOpts (or @trailing (and (= @n 6) (validate/object @last))))) (let ((optsv (if @hasOpts @last null))) (let ((reqv (if (or (= @n 6) (and (= @n 5) (not @hasOpts))) (array/nth @a 4) null))) (let ((req (if (validate/object @reqv) (or (json/parse (json/stringify @reqv) HcValMap) {}) null))) (let ((opts (if (validate/object @optsv) (or (json/parse (json/stringify @optsv) HcValMap) {}) null))) (array/concat (if (and (validate/string @m) (array/includes @methods @m)) @none [{ code: "ORB_HTTP_METHOD_UNKNOWN", path: @p, message: (str/concat "`http` method must be one of " (str/join @methods " ")), suggestion: "", severity: "error" }]) (if (and (validate/string @o) (= @o @etarget)) @none (if (and (validate/string @pth) (not (or (str/startsWith @pth (quote "@")) (str/startsWith @pth "?") (str/startsWith @pth "$")))) (if (or (not (str/startsWith @pth "/")) (str/startsWith @pth "//") (str/includes @pth "\\")) [{ code: "ORB_HTTP_PATH_INVALID", path: @p, message: (str/concat "invalid http path " (str/concat "\"" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll @pth "\\" "\\\\") "\"" "\\\"") "\n" "\\n") "\r" "\\r") "\t" "\\t") "\"") ": request leaves the declared origin: " @pth), suggestion: "Use an absolute request path beginning with `/`; origin is a separate argument", severity: "error" }] (if (str/includes @pth "#") [{ code: "ORB_HTTP_PATH_INVALID", path: @p, message: (str/concat "invalid http path " (str/concat "\"" (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll (str/replaceAll @pth "\\" "\\\\") "\"" "\\\"") "\n" "\\n") "\r" "\\r") "\t" "\\t") "\"") ": path must not carry a fragment"), suggestion: "Use an absolute request path beginning with `/`; origin is a separate argument", severity: "error" }] @none)) @none)) (if (= @req null) @none (let ((av (object/get @req "auth" null))) (if (validate/object @av) (let ((auth (or (json/parse (json/stringify @av) HcValMap) {}))) (let ((scheme (object/get @auth "scheme" null))) (if (not (and (validate/string @scheme) (array/includes @schemes @scheme))) [{ code: "ORB_HTTP_AUTH_SCHEME_UNKNOWN", path: @p, message: (str/concat "`http` auth.scheme must be one of the closed scheme set"), suggestion: "Use a declared HTTP auth scheme", severity: "error" }] (if (and (or (= @scheme "token-exchange") (= @scheme "jwt-bearer")) (object/has @auth "rotate")) (let ((rotate (object/get @auth "rotate" null))) (if (validate/object @rotate) (let ((rm (or (json/parse (json/stringify @rotate) HcValMap) {}))) (array/concat (array/map (array/filter (array/sort (object/keys @rm)) (fn key (not (array/includes ["field", "credential"] @key)))) (fn key { code: "ORB_HTTP_TOKEN_ROTATE_INVALID", path: @p, message: (str/concat "`" @key "` is not a key of auth.rotate"), suggestion: "Use `rotate: { field: \"refresh_token\", credential: <the body.refresh_token credential> }` with `grant: refresh_token`", severity: "error" })) (if (let ((g (object/get @auth "grant" null))) (and (validate/string @g) (= @g "refresh_token"))) @none [{ code: "ORB_HTTP_TOKEN_ROTATE_INVALID", path: @p, message: (str/concat "auth.rotate needs `grant: refresh_token`"), suggestion: "Use `rotate: { field: \"refresh_token\", credential: <the body.refresh_token credential> }` with `grant: refresh_token`", severity: "error" }]) (if (let ((f (object/get @rm "field" null))) (and (validate/string @f) (!= @f ""))) @none [{ code: "ORB_HTTP_TOKEN_ROTATE_INVALID", path: @p, message: (str/concat "auth.rotate.field must be a non-empty string"), suggestion: "Use `rotate: { field: \"refresh_token\", credential: <the body.refresh_token credential> }` with `grant: refresh_token`", severity: "error" }]) (let ((cv (object/get @rm "credential" null)) (bslot (let ((bv (object/get @auth "body" null))) (if (validate/object @bv) (let ((bm (or (json/parse (json/stringify @bv) HcValMap) {}))) (let ((hit (array/find (array/sort (object/keys @bm)) (fn key (let ((fv (object/get @bm @key null))) (and (validate/object @fv) (!= (object/get (or (json/parse (json/stringify @fv) HcValMap) {}) "refresh_token" null) null))))))) (if (= @hit null) null (object/get (or (json/parse (json/stringify (object/get @bm @hit null)) HcValMap) {}) "refresh_token" null)))) null)))) (let ((ci (if (validate/string @cv) (json/stringify [@cv "app"]) (if (validate/object @cv) (let ((sm (or (json/parse (json/stringify @cv) HcValMap) {}))) (let ((nm (object/get @sm "credential" null)) (sc (object/get @sm "scope" null))) (if (not (validate/string @nm)) null (if (= @sc null) (json/stringify [@nm "app"]) (if (validate/string @sc) (json/stringify [@nm @sc]) null))))) null)))) (if (= @ci null) [{ code: "ORB_HTTP_TOKEN_ROTATE_INVALID", path: @p, message: (str/concat "auth.rotate.credential must be a secret knob or { credential, scope? }"), suggestion: "Use `rotate: { field: \"refresh_token\", credential: <the body.refresh_token credential> }` with `grant: refresh_token`", severity: "error" }] (if (or (= @bslot null) (not (validate/object @bslot)) (!= (if (validate/string @bslot) (json/stringify [@bslot "app"]) (if (validate/object @bslot) (let ((sm (or (json/parse (json/stringify @bslot) HcValMap) {}))) (let ((nm (object/get @sm "credential" null)) (sc (object/get @sm "scope" null))) (if (not (validate/string @nm)) null (if (= @sc null) (json/stringify [@nm "app"]) (if (validate/string @sc) (json/stringify [@nm @sc]) null))))) null)) @ci)) [{ code: "ORB_HTTP_TOKEN_ROTATE_INVALID", path: @p, message: (str/concat "auth.rotate.credential must be the credential of auth.body.refresh_token"), suggestion: "Use `rotate: { field: \"refresh_token\", credential: <the body.refresh_token credential> }` with `grant: refresh_token`", severity: "error" }] @none)))))) [{ code: "ORB_HTTP_TOKEN_ROTATE_INVALID", path: @p, message: (str/concat "auth.rotate must be { field, credential }"), suggestion: "Use `rotate: { field: \"refresh_token\", credential: <the body.refresh_token credential> }` with `grant: refresh_token`", severity: "error" }])) @none)))) @none))) (if (= @req null) @none (let ((pv (object/get @req "paginate" null))) (if (validate/object @pv) (if (= (object/get (or (json/parse (json/stringify @pv) HcValMap) {}) "max" null) null) [{ code: "ORB_HTTP_PAGINATE_MAX_MISSING", path: @p, message: (str/concat "`http` paginate requires `max`"), suggestion: "Bound the walk with `max: <number>`", severity: "error" }] @none) @none))) (if (= @req null) @none (if (= (object/get @req "stream" null) null) @none (let ((emv (if (= @opts null) null (object/get @opts "emit" null)))) (if (and (validate/object @emv) (!= (object/get (or (json/parse (json/stringify @emv) HcValMap) {}) "onMessage" null) null)) @none [{ code: "ORB_HTTP_STREAM_WITHOUT_ON_MESSAGE", path: @p, message: (str/concat "`http` stream requires `emit.onMessage`"), suggestion: "Add `emit: { onMessage: <EVENT> }` to the call options", severity: "error" }]))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "http-request", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
      HOST_CALLS_COLLECT -> external { requestId : string!  orbitals : [HcOrbital]!  heads : [string]!  operators : [string]!  fields : [string]! }
        @description "Ask the shared collector for the calls this rule checks."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LnProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      HOST_CALLS_HEARD { requestId : string!  unread : boolean!  calls : [HcCall]!  facts : Map string HcFact! }
        @description "The shared collector's answer: the calls of the asked heads and the table entries."
      HostCalls.HOST_CALLS_COLLECTED -> HOST_CALLS_HEARD
    }
  }

  trait OrbLintHttpRequestCli -> OrbLintHttpRequestRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint http-request <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "http-request") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint http-request: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "http-request") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint http-request: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-http-request" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint http-request` with its arguments and working directory."
        @synonyms "orb lint http-request"
      OrbLintHttpRequest.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintHttpRequestCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }
  trait HostCalls = Calls.traits.HostCalls {
    listens {
      OrbLintHttpRequest.HOST_CALLS_COLLECT -> HOST_CALLS_COLLECT
      LANGUAGE_PACKS_DONE_HEARD { problem : string!  coreRoot : string!  stdRoot : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished, with the installed @almadar/std root when it is compatible."
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }
  page boot as OrbLintHttpRequestOrbitalStart -> OrbLintHttpRequest, OrbLintHttpRequestCli, OrbLintInput, Packs, Versions, HostCalls
}
