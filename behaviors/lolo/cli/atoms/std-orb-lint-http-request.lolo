app std-orb-lint-http-request [
  version: "1.0.0",
  inbound: ["cli-lint-http-request"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-http-request — the `orb lint http-request <file>` command, the port of effect/http.rs check_http_call, check_request, check_auth, check_token_exchange, check_rotate, check_url_position and the emit block of the keyed call: every `(http <method> <origin> <path> <request>? <options>?)` call, found at any depth of a guard or effect of an inline trait. Everything the operator table states comes from it through std-orb-lint-host-calls (std-orb-lint-input's LINT_OPERATOR_SHAPES and LINT_HOST_FACTS): the method words, the request keys, the body keys, the query encodings, per auth scheme its keys, required keys and onUnauthorized words, the key set of every nested request object (`keys` by path: auth.body, auth.storeAs, auth.grantRequest, retry, multipart, paginate, presign, webpush), the default port of each http scheme and the emit keys in the order the operator documents them. Reports ORB_HTTP_METHOD_UNKNOWN (a method that is not text or not one of the table's words), ORB_HTTP_PATH_INVALID (a literal path that does not begin with a single `/`, contains a backslash, or carries a `#` fragment; an `oauth-endpoint` call has no path), ORB_HTTP_AUTH_SCHEME_UNKNOWN (an auth object whose scheme is missing, not text or not one of the table's words), ORB_HTTP_OPTION_UNKNOWN (a key outside the request, auth, auth.body, auth.body credential slot, auth.storeAs, auth.grantRequest, auth.grantRequest.retry, retry, presign, multipart, multipart part, paginate, webpush, webpush.subscription or webpush.subscription.keys key set; a queryEncoding that is not a table word), ORB_HTTP_BODY_CONFLICT (more than one body key, or a body on GET), ORB_HTTP_AUTH_INVALID (an onUnauthorized outside the table's words; a required key of the scheme that is missing or empty), ORB_HTTP_PAGINATE_MAX_MISSING (a paginate object without `max`), ORB_HTTP_STREAM_WITHOUT_ON_MESSAGE (a request with `stream` and no `emit.onMessage` in the options), ORB_HTTP_TOKEN_ROTATE_INVALID (an auth.rotate of a token-exchange or jwt-bearer scheme that is not { field, credential }, lacks `grant: refresh_token`, a field, or a credential that is the credential of auth.body.refresh_token), ORB_HTTP_ORIGIN_NOT_STATIC and ORB_HTTP_EGRESS_UNDECLARED (the origin and an auth tokenUrl against the program's `egress`: the origin of a literal, or of a url-typed @config knob's literal default, read with the scheme's default port; an origin from data is allowed when `egress` is declared), and, through std-orb-emit-config, ORB_EFF_EMIT_KEY_INVALID, ORB_EFF_EMIT_INVALID_NAME and ORB_EFF_EMIT_UNDECLARED_EVENT for the options' `emit` block. Not reported here (the compiler's parsers and type inference, not the operator table): ORB_HTTP_AUTH_INVALID for an hmac-sha256 prefix, a jwt-bearer alg or claims, a presign, a webpush ttl, urgency or endpoint, a token exchange using user credentials in an app-scoped cache and an unparseable grantRequest; ORB_HTTP_HEADER_INVALID; ORB_HTTP_REQUEST_OPTION_INVALID. The key and cancelled findings belong to std-orb-lint-keyed-call-keys. Findings carry the Rust path (the guard or effect), message and suggestion (status 500, exit 1). Clean answers `lint http-request: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-http-request"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOrbital = { name : string, traits : [HcVal] }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]!, config : Map string HcVal?, inGuard : boolean? }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcClosed = { request : boolean?, intRange : HcIntRange? }
type HcOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HcOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HcOauthOp]! }
type HcGrantNeed = Map string HcVal
type HcAuthScheme = { name : string!, keys : [string]!, required : [string]?, onUnauthorized : [string]? }
type HcHttpWire = { requestKeys : [string]!, bodyKeys : [string]!, queryEncodings : [string]!, authSchemes : [HcAuthScheme]!, defaultPorts : Map string number! }
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitKeys : [string]? }
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitOrder : [string]?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type HcValMap = Map string HcVal?
type LnVal = string | number | boolean | [LnVal?] | Map string LnVal?
type LnProgram = { orbitals : [HcOrbital], egress : [string]? }
type HcValMap = Map string HcVal?
type HcValList = [HcVal?]
type EmitVal = string | number | boolean | [EmitVal?] | Map string EmitVal?
type EmitObj = Map string EmitVal?
type Seg = { items : [EmitItem]!, pre : [OrbFinding]!, post : [OrbFinding]! }
type EmitItem = { id : string!, path : string!, emit : EmitObj!, allowedKeys : [string]!, checkDeclared : boolean!, declared : [string]! }
type EmitResult = { id : string!, findings : [OrbFinding]! }


orbital OrbLintHttpRequestOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Calls from "std/behaviors/std-orb-lint-host-calls"
  uses EmitConfigUse from "std/behaviors/std-orb-emit-config"

  entity OrbLintHttpRequestRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    egressRaw : [string] = []
    segs : [Seg] = []
    emitRes : [EmitResult] = []

  }

  trait OrbLintHttpRequest -> OrbLintHttpRequestRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.egressRaw (or (object/get @payload.program "egress" null) []))
        (emit HOST_CALLS_COLLECT { requestId: (str/concat "http-request:" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["http"], operators: ["http"], fields: [] })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "http-request:") (or @payload.unread (not (object/has @payload.facts "http.httpWire"))))
        (set @entity.findings [{ code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", path: "operators", message: "the installed @almadar/std operator table could not be read, so the http vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }])
        (emit LINT_FINISH { })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "http-request:") (not @payload.unread) (object/has @payload.facts "http.httpWire"))
        (set @entity.segs (let ((facts @payload.facts) (none : [OrbFinding] []) (noitems : [EmitItem] []) (nos : [string] []))
          (let ((fhttp (object/get @facts "http")))
            (let ((wire (object/get @fhttp "httpWire" { requestKeys: [], bodyKeys: [], queryEncodings: [], authSchemes: [], defaultPorts: {} })))
              (let ((methods (object/get (object/get @fhttp "words") "method" @nos)) (schemes (object/get (object/get @fhttp "words") "request/auth/scheme" @nos)) (etarget (object/get (object/get @fhttp "oauth" { endpointTarget: "", endpointKinds: [], ops: [] }) "endpointTarget" ""))
                    (reqKeys (object/get @wire "requestKeys")) (bodyKeys (object/get @wire "bodyKeys")) (qenc (object/get @wire "queryEncodings")) (tbl (object/get @wire "authSchemes")) (dports (object/get @wire "defaultPorts"))
                    (kx (object/get @fhttp "keys")) (emitOrder (object/get @fhttp "emitOrder" @nos)) (egressRaw @entity.egressRaw))
                (let ((onWords (array/unique (array/flatten (array/map @tbl (fn s (object/get @s "onUnauthorized" @nos))))))
                      (exSchemes (array/map (array/filter @tbl (fn s (array/includes (object/get @s "keys") "storeAs"))) (fn s (object/get @s "name"))))
                      (grSchemes (array/map (array/filter @tbl (fn s (array/includes (object/get @s "keys") "grantRequest"))) (fn s (object/get @s "name"))))
                      (egOrigins (array/filter (array/map @egressRaw (fn eg (let ((parts (str/split @eg "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (or (= @pp null) (= (array/first @sp) "")) null (str/concat (str/lower (array/first @sp)) ":" @pp)))) (str/concat (str/lower @auth) ":" @dp))))) (if (or (= @hp null) (not (= @rem ""))) null (str/concat @scheme "://" @hp))))))))))))) (fn x (!= @x null)))))
                  (array/map (array/range 0 (array/len @payload.calls)) (fn ci
                    (let ((c (array/nth @payload.calls @ci)))
                      (let ((a (object/get @c "call")) (p (object/get @c "path")))
                        (let ((n (array/len @a)))
                          (let ((last (array/last @a))) (let ((m (if (> @n 1) (array/nth @a 1) null))) (let ((o (if (> @n 2) (array/nth @a 2) null))) (let ((pth (if (> @n 3) (array/nth @a 3) null))) (let ((trailing (and (> @n 4) (validate/object @last) (or (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "emit") (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "key"))))) (let ((hasOpts (or @trailing (and (= @n 6) (validate/object @last))))) (let ((optsv (if @hasOpts @last null))) (let ((reqv (if (or (= @n 6) (and (= @n 5) (not @hasOpts))) (array/nth @a 4) null))) (let ((req (if (validate/object @reqv) (or (json/parse (json/stringify @reqv) HcValMap) {}) null))) (let ((opts (if (validate/object @optsv) (or (json/parse (json/stringify @optsv) HcValMap) {}) null))) (let ((cfg (or (json/parse (json/stringify (object/get @c "config")) HcValMap) {}))) { items: (if (and (!= @opts null) (validate/object (object/get @opts "emit" null))) [{ id: (str/concat "e" @ci), path: @p, emit: (if (and (!= @opts null) (validate/object (object/get @opts "emit" null))) (or (json/parse (json/stringify (object/get @opts "emit")) EmitObj) {}) {}), allowedKeys: @emitOrder, checkDeclared: true, declared: (object/get @c "declared") }] @noitems), pre: (array/concat (if (and (validate/string @m) (array/includes @methods @m)) @none [{ code: "ORB_HTTP_METHOD_UNKNOWN", path: @p, message: (str/concat "`http` method must be one of " (str/join @methods " ")), suggestion: "", severity: "error" }]) (if (and (> @n 2) (not (and (validate/string @o) (= @o @etarget)))) (let ((uv @o) (ofd (> (array/len @egressRaw) 0))) (if (not (validate/string @uv)) (if @ofd @none [{ code: "ORB_HTTP_ORIGIN_NOT_STATIC", path: @p, message: (str/concat "`http` origin must be a string literal or a `url`-typed @config knob (egress cannot be checked otherwise)"), suggestion: "Declare `origin: url = \"https://host\"` in config and pass @config.origin", severity: "error" }]) (let ((kn (if (and (str/startsWith @uv (str/concat (quote "@") "config.")) (> (str/len @uv) 8) (not (str/includes (str/slice @uv 8) "."))) (str/slice @uv 8) null))) (if (= @kn null) (if (or (str/startsWith @uv (quote "@")) (str/startsWith @uv "?") (str/startsWith @uv "$")) (if @ofd @none [{ code: "ORB_HTTP_ORIGIN_NOT_STATIC", path: @p, message: (str/concat "`http` origin must be a string literal or a `url`-typed @config knob (egress cannot be checked otherwise)"), suggestion: "Declare `origin: url = \"https://host\"` in config and pass @config.origin", severity: "error" }]) (let ((lu @uv)) (let ((co (let ((parts (str/split @lu "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (or (= @pp null) (= (array/first @sp) "")) null (str/concat (str/lower (array/first @sp)) ":" @pp)))) (str/concat (str/lower @auth) ":" @dp))))) (if (or (= @hp null) (not (and (not (str/includes @rem "?")) (not (str/includes @rem "#")) (not (str/includes @rem "\\")) (let ((pre (str/replace-pattern @rem "/+$" ""))) (and (not (str/includes @pre "//")) (not (array/some (str/split @pre "/") (fn sg (or (= @sg ".") (= @sg "..")))))))) )) null (str/concat @scheme "://" @hp))))))))))))) (if (and (!= @co null) (array/includes @egOrigins @co)) @none [{ code: "ORB_HTTP_EGRESS_UNDECLARED", path: @p, message: (str/concat "origin '" @lu "' is not declared in the program's `egress`"), suggestion: "Add the exact scheme://host[:port] origin to the app's `egress: [...]`", severity: "error" }])))) (let ((fld (object/get @cfg @kn null))) (if (and (validate/object @fld) (= (object/get (or (json/parse (json/stringify @fld) HcValMap) {}) "type" null) "url")) (let ((dv (object/get (or (json/parse (json/stringify @fld) HcValMap) {}) "default" null))) (if (and (validate/string @dv) (not (or (str/startsWith @dv (quote "@")) (str/startsWith @dv "?") (str/startsWith @dv "$")))) (let ((lu @dv)) (let ((co (let ((parts (str/split @lu "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (or (= @pp null) (= (array/first @sp) "")) null (str/concat (str/lower (array/first @sp)) ":" @pp)))) (str/concat (str/lower @auth) ":" @dp))))) (if (or (= @hp null) (not (and (not (str/includes @rem "?")) (not (str/includes @rem "#")) (not (str/includes @rem "\\")) (let ((pre (str/replace-pattern @rem "/+$" ""))) (and (not (str/includes @pre "//")) (not (array/some (str/split @pre "/") (fn sg (or (= @sg ".") (= @sg "..")))))))) )) null (str/concat @scheme "://" @hp))))))))))))) (if (and (!= @co null) (array/includes @egOrigins @co)) @none [{ code: "ORB_HTTP_EGRESS_UNDECLARED", path: @p, message: (str/concat "origin '" @lu "' is not declared in the program's `egress`"), suggestion: "Add the exact scheme://host[:port] origin to the app's `egress: [...]`", severity: "error" }]))) @none)) (if @ofd @none [{ code: "ORB_HTTP_ORIGIN_NOT_STATIC", p