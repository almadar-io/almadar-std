app std-orb-lint-expectation-persistent-unwritten [
  version: "1.0.0",
  inbound: ["cli-lint-expectation-persistent-unwritten"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-expectation-persistent-unwritten — the `orb lint expectation-persistent-unwritten <file>` command, the port of persistent_never_written (composition/expectations.rs), code ORB_S_EXPECTATION_UNSATISFIED. A strict (spec obligation) `expects entity X [persistent]` whose provider entity is present obliges the program to write X: it is reported when no inline trait of any orbital lands a `persist create|update|upsert` of X in a transition or tick effect (a single persist op, or a persist batch whose followable list builders array/concat, array/prepend, array/append, array/filter, array/map over an op template, array/flatten, array/take and if are folded with tree/fold, falling back to the literal and mapped op tuples when a builder cannot be followed). A lenient expectation, an absent provider and a non-persistent storage mode are not this rule. The program is the resolved program the lint input reads. Findings carry the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint expectation-persistent-unwritten: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-expectation-persistent-unwritten"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type LObj = Map string LNode?
type ExKnob = { type : string, values : [string], default : LNode?, items : LNode?, properties : LNode? }
type ExWaivers = { read : string, create : string, update : string, delete : string }
type ExField = { name : string, type : string, required : boolean, primaryKey : boolean, unique : boolean, values : [string], default : LNode?, relation : LNode?, items : LNode?, properties : LNode? }
type ExEntity = { name : string, identity : boolean, shared : boolean, browser : boolean, persistence : string, collection : string, fields : [ExField], read_policy : LNode?, create_policy : LNode?, update_policy : LNode?, delete_policy : LNode?, access_waivers : ExWaivers? }
type ExExpect = { kind : string, name : string, strict : boolean, traitName : string, state : string, from : string, to : string, event : string, protocol : string, path : string, traits : [string], shape : [ExField], payload : [ExField], persistence : string, shared : boolean, browser : boolean, read_policy : LNode?, create_policy : LNode?, update_policy : LNode?, delete_policy : LNode?, access_waivers : ExWaivers?, knob : ExKnob }
type ExEmit = { event : string, payloadSchema : [ExField] }
type ExState = { name : string }
type ExTransition = { from : LNode, to : string, event : string, guard : LNode?, effects : [LNode?] }
type ExMachine = { states : [ExState], transitions : [ExTransition] }
type ExTrait = { name : string, emits : [ExEmit], stateMachine : ExMachine, ticks : [ExTransition], config : Map string ExKnob? }
type ExPageTrait = { ref : string, name : string }
type ExPage = { name : string, path : string, protocol : string, traits : [ExPageTrait] }
type ExOrbital = { name : string, spec : boolean, expects : [ExExpect], entity : ExEntity, auxiliaryEntities : [ExEntity], traits : [ExTrait], pages : [ExPage] }
type ExProgram = { orbitals : [ExOrbital] }
type BwR = { lok : boolean, les : [string], eok : boolean, ees : [string], bok : boolean, bes : [string], aok : boolean, aes : [string], rok : boolean, res : [string], arr : boolean, head : string, hstr : boolean }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintExpectationPersistentUnwrittenCodes = { sExpectationUnsatisfied : LintCodeDecl }

orbital OrbLintExpectationPersistentUnwrittenOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintExpectationPersistentUnwrittenRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintExpectationPersistentUnwritten -> OrbLintExpectationPersistentUnwrittenRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbs (object/get @payload.program "orbitals" [])))
 (let ((provs (array/filter (array/flatten (array/map (array/filter @orbs (fn o (not (object/get @o "spec" false)))) (fn o (array/map (array/filter (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" [])) (fn e (!= (object/get @e "name" "") ""))) (fn e { n: (object/get @e "name" ""), id: (object/get @e "identity" false), on: (object/get @o "name" ""), e: @e }))))) (fn p (!= (object/get @p "n") ""))))
       (alltr (array/flatten (array/map @orbs (fn o (array/map (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine"))) (fn t { t: @t, on: (object/get @o "name" "") }))))))
       (allpg (array/flatten (array/map @orbs (fn o (object/get @o "pages" []))))))
(array/flatten (array/map (array/range 0 (array/len @orbs)) (fn oi
  (let ((o (default (array/nth @orbs @oi) {})))
   (if (or (object/get @o "spec" false) (not (object/has @o "expects"))) []
    (let ((on (object/get @o "name" "")) (xs (object/get @o "expects" [])))
     (array/flatten (array/map (array/range 0 (array/len @xs)) (fn j
      (let ((x (default (array/nth @xs @j) {})))
       (let ((base (str/concat "orbitals[" @oi " (" @on ")].expects[" @j "]")) (kind (object/get @x "kind" "")) (strict (object/get @x "strict" false)))
        (if (and (= @kind "entity") @strict (= (object/get @x "persistence" "") "persistent") (array/some @provs (fn p (= (object/get @p "n") (object/get @x "name" "")))) (not (array/some @alltr (fn p
  (array/some (let ((nn (as (json/nodes [(array/map (object/get (object/get (object/get @p "t") "stateMachine") "transitions" []) (fn t (object/get @t "effects" []))), (array/map (object/get (object/get @p "t") "ticks" []) (fn t (object/get @t "effects" [])))]) LNodes))) (if (= @nn null) [] @nn)) (fn n (let ((l (default (as @n LNodes) [])))
  (let ((h (default (as (if (> (array/len @l) 0) (array/nth @l 0) null) LStr) "")) (a1 (default (as (if (> (array/len @l) 1) (array/nth @l 1) null) LStr) "")))
    (and (= @h "persist")
      (if (= @a1 "batch")
        (and (> (array/len @l) 2)
          (let ((r (tree/fold (array/nth @l 2) (fn (n k)
  (let ((f : BwR { lok: false, les: [], eok: false, ees: [], bok: false, bes: [], aok: false, aes: [], rok: false, res: [], arr: false, head: "", hstr: false }))
    (if (not (validate/array @n)) @f
    (let ((l @n)) (let ((len (array/len @l)) (head (default (as (if (> (array/len @l) 0) (array/nth @l 0) null) LStr) "")) (hstr (!= (as (if (> (array/len @l) 0) (array/nth @l 0) null) LStr) null)) (kr (array/map @k (fn r (default @r @f)))))
     (let ((rest (array/drop @kr 1)) (ent (default (as (if (> (array/len @l) 1) (array/nth @l 1) null) LStr) "")))
      (let ((allL { ok: (array/every @kr (fn r (object/get @r "lok"))), es: (array/flatten (array/map @kr (fn r (object/get @r "les")))) }) (restL { ok: (array/every @rest (fn r (object/get @r "lok"))), es: (array/flatten (array/map @rest (fn r (object/get @r "les")))) }) (restE { ok: (array/every @rest (fn r (object/get @r "eok"))), es: (array/flatten (array/map @rest (fn r (object/get @r "ees")))) }) (allE { ok: (array/every @kr (fn r (object/get @r "eok"))), es: (array/flatten (array/map @kr (fn r (object/get @r "ees")))) }))
       (let ((istup (and (> @len 0) (array/includes ["create", "update", "delete"] @head))))
        (let ((e (if @istup (if (or (= @ent "") (str/startsWith @ent (str/concat (quote "@") ""))) { ok: false, es: [] } { ok: true, es: (if (= @head "delete") [] [@ent]) })
                   (if (and (= @head "if") (= @len 4)) { ok: (array/every [(array/nth @kr 2), (array/nth @kr 3)] (fn r (object/get @r "eok"))), es: (array/flatten (array/map [(array/nth @kr 2), (array/nth @kr 3)] (fn r (object/get @r "ees")))) } { ok: false, es: [] }))))
         (let ((lst (if (= @len 0) { ok: true, es: [] }
                      (if @hstr
                        (if (= @head "list") @restE
                          (if (= @head "array/concat") @restL
                            (if (and (array/includes ["array/prepend", "array/append"] @head) (= @len 3))
                              { ok: (and (object/get (array/nth @kr 1) "lok") (object/get (array/nth @kr 2) "eok")), es: (array/concat (object/get (array/nth @kr 1) "les") (object/get (array/nth @kr 2) "ees")) }
                              (if (and (= @head "array/filter") (= @len 3)) { ok: (object/get (array/nth @kr 1) "lok"), es: (object/get (array/nth @kr 1) "les") }
                                (if (and (= @head "array/map") (= @len 3)) { ok: (object/get (array/nth @kr 2) "bok"), es: (object/get (array/nth @kr 2) "bes") }
                                  (if (and (= @head "array/flatten") (= @len 2))
                                    (let ((m (default (array/nth @kr 1) {})))
                                      (if (not (object/get @m "arr")) { ok: false, es: [] }
                                        (if (and (object/get @m "hstr") (= (object/get @m "head") "list")) { ok: (object/get @m "rok"), es: (object/get @m "res") }
                                          (if (object/get @m "hstr") { ok: false, es: [] } { ok: (object/get @m "aok"), es: (object/get @m "aes") }))))
                                    (if (and (= @head "array/take") (= @len 3))
                                      (if (= (json/stringify (array/nth @l 2)) "0") { ok: true, es: [] } { ok: (object/get (array/nth @kr 1) "lok"), es: (object/get (array/nth @kr 1) "les") })
                                      (if (and (= @head "if") (= @len 4)) { ok: (array/every [(array/nth @kr 2), (array/nth @kr 3)] (fn r (object/get @r "lok"))), es: (array/flatten (array/map [(array/nth @kr 2), (array/nth @kr 3)] (fn r (object/get @r "les")))) } { ok: false, es: [] }))))))))
                        { ok: (object/get @allE "ok"), es: (object/get @allE "es") }))))
          (let ((body (if (and (array/includes ["fn"] @head) (>= @len 3)) (array/last @kr) @f)))
           { lok: (object/get @lst "ok"), les: (object/get @lst "es"), eok: (object/get @e "ok"), ees: (object/get @e "es"), bok: (object/get @body "eok"), bes: (object/get @body "ees"),
             aok: (object/get @allL "ok"), aes: (object/get @allL "es"), rok: (object/get @restL "ok"), res: (object/get @restL "es"), arr: true, head: @head, hstr: @hstr }))))))))))) "LNode")))
            (if (and (!= @r null) (object/get @r "lok"))
              (array/includes (object/get @r "les" []) (object/get @x "name" ""))
              (array/some (let ((ops (default (as (if (> (array/len @l) 2) (array/nth @l 2) null) LNodes) [])))(array/flatten (array/map (array/filter (array/map (if (= (array/len @ops) 0) []
        (if (!= (as (if (> (array/len @ops) 0) (array/nth @ops 0) null) LStr) null)
          (if (= (default (as (if (> (array/len @ops) 0) (array/nth @ops 0) null) LStr) "") "list") (array/drop @ops 1)
            (if (and (= (default (as (if (> (array/len @ops) 0) (array/nth @ops 0) null) LStr) "") "array/map") (= (array/len @ops) 3))
              (let ((fl (default (as (array/nth @ops 2) LNodes) []))) (if (and (> (array/len @fl) 2) (array/includes ["fn"] (default (as (if (> (array/len @fl) 0) (array/nth @fl 0) null) LStr) ""))) [(array/last @fl)] []))
              []))
          @ops)) (fn el (default (as @el LNodes) []))) (fn tp (and (> (array/len @tp) 0) (array/includes ["create", "update", "delete"] (default (as (if (> (array/len @tp) 0) (array/nth @tp 0) null) LStr) "")))))
        (fn tp (let ((a (default (as (if (> (array/len @tp) 0) (array/nth @tp 0) null) LStr) "")) (en (default (as (if (> (array/len @tp) 1) (array/nth @tp 1) null) LStr) "")))
          (if (or (= @a "delete") (= @en "") (str/startsWith @en (str/concat (quote "@") ""))) []
            (let ((dp (if (= @a "create") 2 3)))
              [{ a: @a, e: @en, has: (> (array/len @tp) @dp), d: (as (if (> (array/len @tp) @dp) (array/nth @tp @dp) null) LObj) }]))))))) (fn w (= (object/get @w "e") (object/get @x "name" "")))))))
        (and (array/includes ["create", "upsert", "update"] @a1) (= (default (as (if (> (array/len @l) 2) (array/nth @l 2) null) LStr) "") (object/get @x "name" "")))))))))))))
  [{ code: @config.codes.sExpectationUnsatisfied.code, path: @base, message: (str/concat "`" @on "` expects entity `" (object/get @x "name" "") "` to be persisted, but nothing in this program provides it — no trait in the program writes `" (object/get @x "name" "") "` with a `persist create|update|upsert`."), suggestion: "Provide it in an orbital of this program (give the providing import that name, or declare it here).", severity: "error" }]
  [])))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "expectation-persistent-unwritten", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : ExProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintExpectationPersistentUnwrittenCodes = { sExpectationUnsatisfied: { code: "ORB_S_EXPECTATION_UNSATISFIED", category: "schema", description: "An orbital expects an entity, trait, event, or config default that nothing in the program provides" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintExpectationPersistentUnwrittenCli -> OrbLintExpectationPersistentUnwrittenRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (!= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint expectation-persistent-unwritten <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "expectation-persistent-unwritten") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint expectation-persistent-unwritten: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "expectation-persistent-unwritten") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint expectation-persistent-unwritten: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-expectation-persistent-unwritten" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint expectation-persistent-unwritten` with its arguments and working directory."
        @synonyms "orb lint expectation-persistent-unwritten"
      OrbLintExpectationPersistentUnwritten.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintExpectationPersistentUnwrittenCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintExpectationPersistentUnwrittenOrbitalStart -> OrbLintExpectationPersistentUnwritten, OrbLintExpectationPersistentUnwrittenCli, OrbLintInput, Packs, Versions
}
