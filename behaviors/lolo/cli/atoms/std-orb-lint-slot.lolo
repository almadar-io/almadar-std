app std-orb-lint-slot [
  version: "1.0.0",
  inbound: ["cli-lint-slot"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-slot — the `orb lint slot <file>` command, the port of the page slot checks ORB_SLOT_MAIN_NOT_COVERED (a page passes when any trait on it paints a non-null render-ui on any slot in any transition), ORB_SLOT_CONTENTION, ORB_SLOT_CONTENTION_RUNTIME (slot.rs validate_page_slots) and ORB_SLOT_INVALID_NESTING, which by owner ruling (2026-10-24) flags real nesting only: a trait, in a state an arm entered by painting overlay A, takes a live arm that paints a different overlay B without clearing A, or one arm paints two overlays; two traits each owning one overlay never nest (slot.rs validate_slot_nesting flagged any two overlay slots on a page). It lowers the file with program/read and walks the traits of every route page (an endpoint or boot page is not checked), resolving by-ref page traits to their declarations (wider than Rust by owner ruling), leaving out a trait a sibling embeds with `@trait.X` (it paints inside that sibling, so it owns no page slot), reading a render-ui anywhere in an arm's effects (inside `if` and `do` too), counting a trait once per slot and never reporting contention on the shared overlay slots modal and toast, and reports each slot finding (a slot named by a `@config.<knob>` binding is read through the trait's declared default, as the compiler sees it after inlining) with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint slot: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-slot"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type SlotExpr = string | number | boolean | [SlotExpr?] | Map string SlotExpr?
type SlotState = { name : string, isInitial : boolean }
type SlotArm = { from : SlotExpr, to : string, guard : SlotExpr?, effects : [SlotExpr?], event : string }
type SlotMachine = { states : [SlotState], transitions : [SlotArm] }
type SlotConfigKnob = { default : SlotExpr? }
type SlotForm = [SlotExpr?]
type SlotText = { v : string }
type SlotTick = { guard : SlotExpr?, effects : [SlotExpr?] }
type SlotTrait = { name : string, ref : string, stateMachine : SlotMachine, config : Map string SlotConfigKnob, ticks : [SlotTick] }
type SlotPage = { protocol : string, traits : [SlotTrait] }
type SlotDomainContext = { category : string }
type SlotOrbital = { domainContext : SlotDomainContext, pages : [SlotPage], traits : [SlotTrait] }
type SlotProgram = { orbitals : [SlotOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintSlotCodes = { slotMainNotCovered : LintCodeDecl , slotContention : LintCodeDecl , slotContentionRuntime : LintCodeDecl , slotInvalidNesting : LintCodeDecl }

orbital OrbLintSlotOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintSlotRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintSlot -> OrbLintSlotRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals : [SlotOrbital] (object/get @payload.program "orbitals" [])))
          
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((pgList (object/get (array/nth @orbitals @oi) "pages" [])) (orbTraits (object/get (array/nth @orbitals @oi) "traits" [])))
              (array/flatten (array/map (array/range 0 (array/len @pgList)) (fn pj
                (if (!= (object/get (array/nth @pgList @pj) "protocol" null) null) []
                (let ((where (str/concat "orbitals[" @oi "].pages[" @pj "]"))
                      (trs0 (array/flatten (array/map (object/get (array/nth @pgList @pj) "traits" []) (fn r
                        (if (not (validate/object @r)) []
                          (if (object/has @r "stateMachine") (array/map [0] (fn z @r))
                            (array/filter @orbTraits (fn t (= (object/get @t "name" "") (object/get @r "name" (object/get @r "ref" ""))))))))))))
                  (let ((embedded (let ((kids (array/map (array/concat @orbTraits @trs0) (fn t
                          (let ((own (object/get @t "name" ""))
                                (ns (array/concat
                                  (array/flatten (array/map (object/values (let ((cf (object/get @t "config" null))) (if (validate/object @cf) @cf {}))) (fn k (array/map (let ((nd (object/get @k "default" null))) (if (= @nd null) [] (let ((ns (as (json/nodes @nd) SlotForm))) (if (= @ns null) [] @ns)))) (fn n (if (validate/string @n) (if (str/startsWith @n (quote "@trait.")) (let ((h1 (array/first (str/split (str/slice @n 7 (str/len @n)) ".")))) (if (= @h1 null) "" (let ((h2 (array/first (str/split @h1 "[")))) (if (= @h2 null) "" @h2)))) "") ""))))))
                                  (array/flatten (array/map (let ((trl (object/get (object/get @t "stateMachine" {}) "transitions" null))) (if (validate/array @trl) @trl [])) (fn a (array/concat (array/map (let ((nd (object/get @a "guard" null))) (if (= @nd null) [] (let ((ns (as (json/nodes @nd) SlotForm))) (if (= @ns null) [] @ns)))) (fn n (if (validate/string @n) (if (str/startsWith @n (quote "@trait.")) (let ((h1 (array/first (str/split (str/slice @n 7 (str/len @n)) ".")))) (if (= @h1 null) "" (let ((h2 (array/first (str/split @h1 "[")))) (if (= @h2 null) "" @h2)))) "") ""))) (array/map (let ((nd (array/filter (object/get @a "effects" []) (fn r (not (validate/object @r)))))) (if (= @nd null) [] (let ((ns (as (json/nodes @nd) SlotForm))) (if (= @ns null) [] @ns)))) (fn n (if (validate/string @n) (if (str/startsWith @n (quote "@trait.")) (let ((h1 (array/first (str/split (str/slice @n 7 (str/len @n)) ".")))) (if (= @h1 null) "" (let ((h2 (array/first (str/split @h1 "[")))) (if (= @h2 null) "" @h2)))) "") "")))))))
                                  (array/flatten (array/map (let ((tks (object/get @t "ticks" null))) (if (validate/array @tks) @tks [])) (fn k (array/concat (array/map (let ((nd (object/get @k "guard" null))) (if (= @nd null) [] (let ((ns (as (json/nodes @nd) SlotForm))) (if (= @ns null) [] @ns)))) (fn n (if (validate/string @n) (if (str/startsWith @n (quote "@trait.")) (let ((h1 (array/first (str/split (str/slice @n 7 (str/len @n)) ".")))) (if (= @h1 null) "" (let ((h2 (array/first (str/split @h1 "[")))) (if (= @h2 null) "" @h2)))) "") ""))) (array/map (let ((nd (array/filter (object/get @k "effects" []) (fn r (not (validate/object @r)))))) (if (= @nd null) [] (let ((ns (as (json/nodes @nd) SlotForm))) (if (= @ns null) [] @ns)))) (fn n (if (validate/string @n) (if (str/startsWith @n (quote "@trait.")) (let ((h1 (array/first (str/split (str/slice @n 7 (str/len @n)) ".")))) (if (= @h1 null) "" (let ((h2 (array/first (str/split @h1 "[")))) (if (= @h2 null) "" @h2)))) "") ""))))))))))
                            { n: (object/get @t "name" ""), ns: (array/filter @ns (fn nm (and (!= @nm "") (!= @nm @own)))) })))))
                          (array/reduce (array/range 0 (array/len @kids)) (array/flatten (array/map @trs0 (fn t (let ((kd (array/find @kids (fn k (= (object/get @k "n") (object/get @t "name" "")))))) (if (= @kd null) [] (object/get @kd "ns" []))))))
                            (fn (cur i) (array/unique (array/concat @cur (array/flatten (array/map (array/filter @kids (fn k (array/includes @cur (object/get @k "n")))) (fn k (object/get @k "ns")))))))))))
                  (let ((trs (array/filter @trs0 (fn t (not (array/includes @embedded (object/get @t "name" "")))))))
                  (let ((facts (array/map @trs (fn t
                          (let ((sm (object/get @t "stateMachine" {})))
                            (let ((init (let ((is0 (array/find (object/get @sm "states" []) (fn s (= (object/get @s "isInitial" false) true))))) (if (= @is0 null) null (object/get @is0 "name" null))))
                                  (arms (array/map (object/get @sm "transitions" []) (fn a
                                    { froms: (let ((raw (object/get @a "from" ""))) (if (validate/array @raw) @raw (array/map [0] (fn z @raw))))
                                      to: (object/get @a "to" "")
                                      dead: (and (object/has @a "guard") (= (let ((g4 (object/get @a "guard" null))) (if (validate/array @g4) (if (validate/string (array/nth @g4 0)) (let ((op4 (array/nth @g4 0)) (cl (array/filter (array/map (array/range 1 9) (fn i4 (if (= (array/nth @g4 @i4) null) "N" (let ((a4 (array/nth @g4 @i4))) (let ((g3 @a4)) (if (validate/array @g3) (if (validate/string (array/nth @g3 0)) (let ((op3 (array/nth @g3 0)) (cl (array/filter (array/map (array/range 1 9) (fn i3 (if (= (array/nth @g3 @i3) null) "N" (let ((a3 (array/nth @g3 @i3))) (let ((g2 @a3)) (if (validate/array @g2) (if (validate/string (array/nth @g2 0)) (let ((op2 (array/nth @g2 0)) (cl (array/filter (array/map (array/range 1 9) (fn i2 (if (= (array/nth @g2 @i2) null) "N" (let ((a2 (array/nth @g2 @i2))) (let ((g1 @a2)) (if (validate/array @g1) (if (validate/string (array/nth @g1 0)) (let ((op1 (array/nth @g1 0)) (cl (array/filter (array/map (array/range 1 9) (fn i1 (if (= (array/nth @g1 @i1) null) "N" (let ((a1 (array/nth @g1 @i1))) (let ((g0 @a1)) (if (validate/array @g0) "U" (if (validate/boolean @g0) (if @g0 "T" "F") (if (= @g0 null) "F" (if (validate/number @g0) (if (= @g0 0) "F" "T") (if (validate/string @g0) (if (= @g0 "") "F" (if (str/startsWith @g0 (quote "@")) "U" "T")) (if (validate/object @g0) (if (= (array/len (object/keys @g0)) 0) "F" "T") "U"))))))))))) (fn c (!= @c "N"))))) (if (= @op1 "and") (if (array/includes @cl "F") "F" (if (and (> (array/len @cl) 0) (= (array/len (array/filter @cl (fn c (= @c "T")))) (array/len @cl))) "T" "U")) (if (= @op1 "or") (if (array/includes @cl "T") "T" (if (and (> (array/len @cl) 0) (= (array/len (array/filter @cl (fn c (= @c "F")))) (array/len @cl))) "F" "U")) (if (= @op1 "not") (if (= (array/len @cl) 1) (if (= (array/nth @cl 0) "T") "F" (if (= (array/nth @cl 0) "F") "T" "U")) "U") (if (or (= @op1 "=") (= @op1 "==") (= @op1 "!=")) (if (and (= (array/len @cl) 2) (or (validate/boolean (array/nth @g1 1)) (validate/number (array/nth @