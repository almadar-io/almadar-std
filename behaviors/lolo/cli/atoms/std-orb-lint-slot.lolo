                                      []))))))))
                              (array/map (array/unique (array/flatten (array/map @facts (fn f
                                  (let ((live (array/filter (object/get @f "arms") (fn a (not (object/get @a "dead"))))))
                                    (array/flatten (array/map (object/get @f "reach") (fn st
                                      (let ((open (array/unique (array/flatten (array/map (array/filter @live (fn a (= (object/get @a "to") @st))) (fn a (array/map (array/filter (object/get @a "rend") (fn r (and (object/get @r "p") (array/includes @config.overlaySlots (object/get @r "s"))))) (fn r (object/get @r "s")))))))))
                                        (array/flatten (array/map (array/filter @live (fn a (array/some (object/get @a "froms") (fn x (or (= @x @st) (= @x "*")))))) (fn a
                                          (let ((paints (array/unique (array/map (array/filter (object/get @a "rend") (fn r (and (object/get @r "p") (array/includes @config.overlaySlots (object/get @r "s"))))) (fn r (object/get @r "s")))))
                                                (clears (array/map (array/filter (object/get @a "rend") (fn r (not (object/get @r "p")))) (fn r (object/get @r "s")))))
                                            (array/flatten (array/map @paints (fn b
                                              (array/concat
                                                (array/map (array/filter @open (fn o (and (!= @o @b) (not (array/includes @clears @o))))) (fn o
                                                  (str/concat "Overlay '" @b "' opens over the open overlay '" @o "' in trait '" (object/get @f "tn") "' state '" @st "'. Consider if nesting is intended.")))
                                                (array/map (array/filter @paints (fn o (and (!= @o @b) (= (array/nth (array/sort [@o, @b]) 0) @o)))) (fn o
                                                  (str/concat "Overlays '" @o "' and '" @b "' open together in trait '" (object/get @f "tn") "' from state '" @st "'. Consider if nesting is intended."))))))))))))))))))))
                                (fn m { code: @config.codes.slotInvalidNesting.code, path: @where, message: @m, suggestion: "Avoid nesting modals within modals", severity: "error" }))
                            ])))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "slot", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }


    config {
      codes : LintSlotCodes = { slotMainNotCovered: { code: "ORB_SLOT_MAIN_NOT_COVERED", category: "slot", description: "No trait on a page renders anything into the main slot" }, slotContention: { code: "ORB_SLOT_CONTENTION", category: "slot", description: "Multiple traits on a page render into the same slot" }, slotContentionRuntime: { code: "ORB_SLOT_CONTENTION_RUNTIME", category: "slot", description: "Several traits render to the same slot in the same state, so they contend for it" }, slotInvalidNesting: { code: "ORB_SLOT_INVALID_NESTING", category: "slot", description: "A slot is nested in an invalid way" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
      overlaySlots : [string] = ["modal", "drawer", "overlay"]
        @label "Overlay slots"
        @description "Slots of which a page should use at most one."
      renderOps : [string] = ["render-ui"]
        @label "Render operators"
        @description "The effect operators that paint a slot."
      sharedSlots : [string] = ["modal", "toast"]
        @label "Shared overlay slots"
        @description "Slots sibling traits may share without contending."
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : SlotProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintSlotCli -> OrbLintSlotRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint slot: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint slot <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint slot <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "slot") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint slot: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "slot") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint slot: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-slot" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint slot` with its arguments and working directory."
        @synonyms "orb lint slot, seed source"
      OrbLintSlot.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintSlotCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintSlotOrbitalStart -> OrbLintSlot, OrbLintSlotCli, OrbLintInput, Packs, Versions
}
