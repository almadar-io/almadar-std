                                (array/map (array/map (array/filter (object/get @a "rend") (fn r (object/get @r "p"))) (fn r (object/get @r "s"))) (fn s { slot: @s, tn: (object/get @f "tn") })))))))))
                          (anyPaint (array/flatten (array/map @facts (fn f (array/flatten (array/map (object/get @f "arms") (fn a (array/map (array/filter (object/get @a "rend") (fn r (object/get @r "p"))) (fn r (object/get @r "s"))))))))))
