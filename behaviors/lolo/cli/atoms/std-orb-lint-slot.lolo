                                    [{ code: @config.codes.slotContention.code, path: @where, message: (str/concat "Slot '" @sl "' has contention: multiple traits render to it: [" (str/join (array/map @names (fn n (json/stringify @n))) ", ") "]"), suggestion: "Each slot should be owned by exactly one trait", severity: "error" }]
