                                      (let ((states (if (= @fr "*") (array/filter (object/get @f "reach") (fn st (!= @st (object/get @f "init")))) (if (and (!= @fr (object/get @f "init")) (array/includes (object/get @f "reach") @fr)) [@fr] []))))
