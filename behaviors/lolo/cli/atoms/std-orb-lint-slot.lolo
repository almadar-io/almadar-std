(= @c "F")))) (array/len @cl))) "F" "U")) (if (= @op4 "not") (if (= (array/len @cl) 1) (if (= (array/nth @cl 0) "T") "F" (if (= (array/nth @cl 0) "F") "T" "U")) "U") (if (or (= @op4 "=") (= @op4 "==") (= @op4 "!=")) (if (and (= (array/len @cl) 2) (or (validate/boolean (array/nth @g4 1)) (validate/number (array/nth @g4 1)) (= (array/nth @g4 1) null) (let ((q41 (array/nth @g4 1))) (and (validate/string @q41) (not (str/startsWith @q41 (quote "@")))))) (or (validate/boolean (array/nth @g4 2)) (validate/number (array/nth @g4 2)) (= (array/nth @g4 2) null) (let ((q42 (array/nth @g4 2))) (and (validate/string @q42) (not (str/startsWith @q42 (quote "@"))))))) (let ((eq (= (json/stringify (array/nth @g4 1)) (json/stringify (array/nth @g4 2))))) (if (= @eq (!= @op4 "!=")) "T" "F")) "U") "U"))))) (if (= (array/nth @g4 0) null) "F" "T")) (if (validate/boolean @g4) (if @g4 "T" "F") (if (= @g4 null) "F" (if (validate/number @g4) (if (= @g4 0) "F" "T") (if (validate/string @g4) (if (= @g4 "") "F" (if (str/startsWith @g4 (quote "@")) "U" "T")) (if (validate/object @g4) (if (= (array/len (object/keys @g4)) 0) "F" "T") "U"))))))) "F"))
                                      rend: (array/flatten (array/map (let ((nd (array/filter (object/get @a "effects" []) (fn r (not (validate/object @r)))))) (if (= @nd null) [] (let ((ns (as (json/nodes @nd) SlotForm))) (if (= @ns null) [] @ns)))) (fn f
                                        (if (validate/array @f)
                                          (let ((hd (array/nth @f 0)))
                                            (if (validate/string @hd)
                                              (if (array/includes @config.renderOps @hd)
                                                (let ((sv (array/nth @f 1)))
                                                  (if (validate/string @sv)
                                                    (if (= (str/slice @sv 0 8) (quote "@config."))
                                                      (let ((kb (object/get (object/get @t "config" {}) (str/slice @sv 8 (str/len @sv)) {})))
                                                        (if (and (object/has @kb "default") (= (object/get @kb "default" @sv) null)) []
                                                        [{ s: (let ((dv (object/get @kb "default" @sv))) (if (validate/string @dv) @dv @sv)), p: (!= (array/nth @f 2) null) }]))
