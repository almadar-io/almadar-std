app std-orb-lint-listen-wildcard-unkeyed [
  version: "1.0.0",
  inbound: ["cli-lint-listen-wildcard-unkeyed"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-listen-wildcard-unkeyed — the `orb lint listen-wildcard-unkeyed <file>` command, the port of ORB_LISTEN_WILDCARD_UNKEYED (listen_unkeyed.rs validate_wildcard_listen_keyed, a warning). A trait that makes call keys (an (as … CallKey) anywhere in its own definition) and listens `*.EVENT` for an event some trait emits with a CallKey-typed `key` payload field, with a guard that never reads @payload.key, hears other callers' replies. It lowers the file with program/read and reports each such listens route at orbitals.<orbital>.traits.<trait>.listens with the Rust message and suggestion (status 500, exit 1). Clean answers `lint listen-wildcard-unkeyed: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-listen-wildcard-unkeyed"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type CkVal = string | number | boolean | [CkVal?] | Map string CkVal?
type CkField = { name : string, type : string }
type CkEmit = { event : string, payloadSchema : [CkField] }
type CkSource = { kind : string }
type CkListen = { event : string, triggers : string, source : CkSource, guard : CkVal }
type CkTraitView = { name : string, emits : [CkEmit], listens : [CkListen] }
type CkOrbital = { name : string, traits : [CkVal] }
type CkProgram = { orbitals : [CkOrbital] }

orbital OrbLintListenWildcardUnkeyedOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintListenWildcardUnkeyedRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintListenWildcardUnkeyed -> OrbLintListenWildcardUnkeyedRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((keyed (array/flatten (array/map @orbitals (fn orb
                  (array/flatten (array/map (object/get @orb "traits" []) (fn tr
                    (let ((td (json/parse (json/stringify @tr) CkTraitView)))
                      (array/flatten (array/map (object/get @td "emits" []) (fn em
                        (if (array/some (object/get @em "payloadSchema" []) (fn f (and (= (object/get @f "name" "") "key") (= (object/get @f "type" "") "CallKey"))))
                          [(object/get @em "event" "")]
                          [])))))))))))))
            (array/flatten (array/map @orbitals (fn orb
              (array/flatten (array/map (object/get @orb "traits" []) (fn tr
                (let ((td (json/parse (json/stringify @tr) CkTraitView)))
                  (if (!= (tree/fold @tr (fn (n k)
                          (if (validate/array @n)
                            (or (if (= (array/len @n) 3) (if (and (validate/string (array/nth @n 0)) (validate/string (array/nth @n 2))) (and (= (array/nth @n 0) "as") (= (array/nth @n 2) "CallKey")) false) false) (array/some @k (fn r (= @r true))))
                            (if (validate/object @n) (array/some (object/values @k) (fn r (= @r true))) false))) CkVal) true)
                    []
                    (array/flatten (array/map (object/get @td "listens" []) (fn l
                      (let ((ev (object/get @l "event" "")) (triggered (object/get @l "triggers" (object/get @l "event" ""))))
                        (if (and (= (object/get (object/get @l "source" {}) "kind" "") "any")
                                 (array/includes @keyed @ev)
                                 (!= (tree/fold (object/get @l "guard" null) (fn (n k)
                                       (if (validate/string @n)
                                         (or (= @n (quote "@payload.key")) (str/startsWith @n (quote "@payload.key.")))
                                         (if (validate/array @n)
                                           (array/some @k (fn r (= @r true)))
                                           (if (validate/object @n) (array/some (object/values @k) (fn r (= @r true))) false)))) CkVal) true))
                          [{ code: "ORB_LISTEN_WILDCARD_UNKEYED", path: (str/concat "orbitals." (object/get @orb "name" "") ".traits." (object/get @td "name" "") ".listens"), message: (str/concat "listens route `*." @ev " -> " @triggered "` in `" (object/get @orb "name" "") "." (object/get @td "name" "") "` hears every caller's `" @ev "`, whose payload carries the call's `key`, and its guard never reads it"), suggestion: (str/concat "guard the route on the call's own key: `*." @ev " -> " @triggered " when (= ?key <the key this trait sent>)`"), severity: "warning" }]
                          []))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "listen-wildcard-unkeyed", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CkProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintListenWildcardUnkeyedCli -> OrbLintListenWildcardUnkeyedRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint listen-wildcard-unkeyed <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "listen-wildcard-unkeyed") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint listen-wildcard-unkeyed: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "listen-wildcard-unkeyed") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint listen-wildcard-unkeyed: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-listen-wildcard-unkeyed" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint listen-wildcard-unkeyed` with its arguments and working directory."
        @synonyms "orb lint listen-wildcard-unkeyed"
      OrbLintListenWildcardUnkeyed.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintListenWildcardUnkeyedCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintListenWildcardUnkeyedOrbitalStart -> OrbLintListenWildcardUnkeyed, OrbLintListenWildcardUnkeyedCli, OrbLintInput, Packs, Versions
}
