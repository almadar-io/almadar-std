)) (validate/array @pv48)) @none [{ code: @config.codes.oauthProviderUnknown.code, path: @p, message: (str/concat "provider " (if (and (validate/number @pv48) (= @pv48 (math/floor @pv48))) (str/concat (json/stringify @pv48) ".0") (json/stringify @pv48)) " is not one of " (str/join @providers ", ")), suggestion: "", severity: "error" }])) (let ((o49 (if (> @n 2) (array/nth @a 2) null))) (if (= @o49 null) @none (if (validate/object @o49) (let ((bad (array/find (object/keys (default (as @o49 HcValMap) {})) (fn k (not (array/includes ["emit"] @k)))))) (if (= @bad null) @none [{ code: @config.codes.hostEffectOptionUnknown.code, path: @p, message: (str/concat "`" @h "` options accept only emit, got `" @bad "`"), suggestion: "", severity: "error" }])) [{ code: @config.codes.hostEffectOptionUnknown.code, path: @p, message: (str/concat "`" @h "` options must be an object"), suggestion: "", severity: "error" }])))))), post: @none }])))))))))))))
        (emit LINT_PLANNED { }))))))))

      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "oauth", scope: @entity.scope, findings: @entity.findings })
      LINT_PLANNED -> ready
        (emit EMIT_CONFIG_CHECK { requestId: (str/concat "emit" @entity.scope), items: (array/flatten (array/map @entity.segs (fn s (object/get @s "items")))) })
      EMIT_HEARD -> ready
        (set @entity.emitRes @payload.results)
        (emit LINT_ASSEMBLE { })
      LINT_ASSEMBLE -> ready
        (set @entity.findings (let ((none : [OrbFinding] [])) (array/flatten (array/map @entity.segs (fn s (array/concat (object/get @s "pre") (array/flatten (array/map (object/get @s "items") (fn it (object/get (default (array/find @entity.emitRes (fn r (= (object/get @r "id") (object/get @it "id")))) { id: "", findings: @none }) "findings")))) (object/get @s "post")))))))
        (emit LINT_FINISH { })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
      HOST_CALLS_COLLECT -> external { requestId : string!  orbitals : [HcOrbital]!  heads : [string]!  operators : [string]!  fields : [string]! }
        @description "Ask the shared collector for the calls this rule checks."
        @tier "internal"
      LINT_PLANNED { }
        @description "Internal: the calls are planned, ask the emit-config checker."
        @tier "internal"
      LINT_ASSEMBLE { }
        @description "Internal: merge the emit-config findings into the call findings."
        @tier "internal"
      EMIT_CONFIG_CHECK -> external { requestId : string!  items : [EmitItem]! }
        @description "Ask std-orb-emit-config to check each call's emit object."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : LnProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      HOST_CALLS_HEARD { requestId : string!  unread : boolean!  calls : [HcCall]!  facts : Map string HcFact! }
        @description "The shared collector's answer: the calls of the asked heads and the table entries."
      HostCalls.HOST_CALLS_COLLECTED -> HOST_CALLS_HEARD
      EMIT_HEARD { requestId : string!  results : [EmitResult]! }
        @description "std-orb-emit-config's answer: the findings of each call's emit object."
      OrbEmitConfig.EMIT_CONFIG_CHECKED -> EMIT_HEARD
    }
    config {
      codes : LintOauthCodes = { lintOperatorShapesUnread: { code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", category: "lint", description: "The installed operator table could not be read or does not match the operator shape type, so a lint cannot run" }, oauthClientInvalid: { code: "ORB_OAUTH_CLIENT_INVALID", category: "oauth", description: "An OAuth client block uses a key that is not a valid OAuth client key" }, httpEgressUndeclared: { code: "ORB_HTTP_EGRESS_UNDECLARED", category: "http", description: "An outbound request targets an origin that is not declared in the program egress list" }, oauthProviderUnknown: { code: "ORB_OAUTH_PROVIDER_UNKNOWN", category: "oauth", description: "The OAuth clients map is keyed by something other than a known provider tag" }, hostEffectArity: { code: "ORB_HOST_EFFECT_ARITY", category: "effect", description: "A host effect is called with the wrong number of arguments" }, oauthOptionUnknown: { code: "ORB_OAUTH_OPTION_UNKNOWN", category: "oauth", description: "An oauth-authorize call passes an option that is not recognized" }, hostEffectOptionUnknown: { code: "ORB_HOST_EFFECT_OPTION_UNKNOWN", category: "host_effect", description: "A host effect is given an option outside the set of options it accepts" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintOauthCli -> OrbLintOauthRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint oauth <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint oauth <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint oauth <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "oauth") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint oauth: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "oauth") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint oauth: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-oauth" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint oauth` with its arguments and working directory."
        @synonyms "orb lint oauth"
      OrbLintOauth.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintOauthCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }
  trait HostCalls = Calls.traits.HostCalls {
    listens {
      OrbLintOauth.HOST_CALLS_COLLECT -> HOST_CALLS_COLLECT
      LINT_OPERATOR_SHAPES_HEARD { operators : Map string HcShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every operator's arity, host and params."
      LINT_OPERATOR_SHAPES_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator shapes could not be read."
      LINT_HOST_FACTS_HEARD { operators : Map string HcExtras! }
        @description "std-orb-lint-input's LINT_HOST_FACTS: the closedCall, grant, defaultPorts, family and emitKeys of the operators that state any."
      LINT_HOST_FACTS_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_HOST_FACTS_UNREAD: the host-effect facts could not be read."
      OrbLintInput.LINT_OPERATOR_SHAPES -> LINT_OPERATOR_SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> LINT_OPERATOR_SHAPES_UNREAD_HEARD
      OrbLintInput.LINT_HOST_FACTS -> LINT_HOST_FACTS_HEARD
      OrbLintInput.LINT_HOST_FACTS_UNREAD -> LINT_HOST_FACTS_UNREAD_HEARD
    }
  }
  trait OrbEmitConfig = EmitConfigUse.traits.OrbEmitConfig {
    listens {
      EMIT_CONFIG_CHECK { requestId : string!  items : [EmitItem]! }
        @description "Check each item's emit object against its allowed keys and the events its trait declares."
      OrbLintOauth.EMIT_CONFIG_CHECK -> EMIT_CONFIG_CHECK
    }
  }
  page boot as OrbLintOauthOrbitalStart -> OrbLintOauth, OrbLintOauthCli, OrbLintInput, Packs, Versions, HostCalls, OrbEmitConfig
}
