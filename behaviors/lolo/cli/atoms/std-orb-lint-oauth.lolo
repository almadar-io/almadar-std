        (emit LINT_FINISH { })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "oauth:") (not @payload.unread) (object/has @payload.facts "browser/beacon") (object/has @payload.facts "oauth-authorize") (object/has @payload.facts "oauth-connection-status"))
        (let ((fbeacon0 (object/get @payload.facts "browser/beacon"))) (if (= @fbeacon0 null) (do (set @entity.findings [{ code: @config.codes.lintOperatorShapesUnread.code, path: "operators", message: "the installed @almadar/std operator table could not be read, so the oauth vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the oauth vocabulary", severity: "error" }]) (emit LINT_FINISH { })) (let ((fauth0 (object/get @payload.facts "oauth-authorize"))) (if (= @fauth0 null) (do (set @entity.findings [{ code: @config.codes.lintOperatorShapesUnread.code, path: "operators", message: "the installed @almadar/std operator table could not be read, so the oauth vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the oauth vocabulary", severity: "error" }]) (emit LINT_FINISH { })) (let ((fstat0 (object/get @payload.facts "oauth-connection-status"))) (if (= @fstat0 null) (do (set @entity.findings [{ code: @config.codes.lintOperatorShapesUnread.code, path: "operators", message: "the installed @almadar/std operator table could not be read, so the oauth vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the oauth vocabulary", severity: "error" }]) (emit LINT_FINISH { })) (do
        (set @entity.segs (let ((facts @payload.facts) (none : [OrbFinding] []) (noitems : [EmitItem] []) (nos : [string] []))
