app std-orb-lint-oauth [
  version: "1.0.0",
  inbound: ["cli-lint-oauth"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-oauth — the `orb lint oauth <file>` command, the port of effect/oauth.rs (validate_oauth_effects): the `oauth-client` auth of an `http` call, the `oauth-endpoint` target and the `oauth-authorize`, `oauth-connection-status` and `oauth-connection-forget` effects, found at any depth of a guard or effect of an inline trait. The op words, each op's required and optional inputs and the endpoint word it is sent to (the `oauth` entry of `http`), the client object's keys, the provider, mode and client-auth words and the endpoint keys, and the authorize keys all come from the installed operator table through std-orb-lint-host-calls. Reports ORB_OAUTH_CLIENT_INVALID (a client that is not an object, an unknown key, a tag, mode or clientAuth that is missing, not a word or not one of the table's words, a missing clientId, not exactly one of issuer or endpoints, endpoints that are not an object, an unknown endpoint, a missing authorization or token endpoint, `clients` that declare no client, a client under another tag, both client and clients, neither), ORB_OAUTH_PROVIDER_UNKNOWN (a provider that is not a table word; a `clients` key that is not a provider), ORB_OAUTH_OP_UNKNOWN (no op, an op that is not in the table, an input the op requires and the call lacks, an input the op does not take, `clients` on an op other than code), ORB_OAUTH_ENDPOINT_MISMATCH (an `oauth-endpoint` without an oauth-client auth, an op sent to the wrong endpoint or with the wrong method, discovery sent to an endpoint), ORB_OAUTH_REQUEST_CONFLICT (an oauth-client request that carries more than `auth`) and ORB_OAUTH_OPTION_UNKNOWN (an oauth-authorize option the table does not declare, a missing redirectUri, options that are not an object), and the ORB_HOST_EFFECT_ARITY and ORB_HOST_EFFECT_OPTION_UNKNOWN of the three oauth effects. A literal issuer or endpoint URL outside `egress` (ORB_HTTP_EGRESS_UNDECLARED) is not reported here: the default port of an http scheme is not stated in the operator table. The key and emit-block findings of oauth-authorize belong to std-orb-lint-keyed-call-keys and the emit-config rules. Findings carry the Rust path (the guard or effect), message and suggestion (status 500, exit 1). Clean answers `lint oauth: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-oauth"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOrbital = { name : string, traits : [HcVal] }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]! }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcClosed = { request : boolean?, intRange : HcIntRange? }
type HcOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HcOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HcOauthOp]! }
type HcGrantNeed = Map string HcVal
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type HcValMap = Map string HcVal?
type LnVal = string | number | boolean | [LnVal?] | Map string LnVal?
type LnProgram = { orbitals : [HcOrbital] }
type HcValMap = Map string HcVal?
type HcStrings = [string]


orbital OrbLintOauthOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Calls from "std/behaviors/std-orb-lint-host-calls"

  entity OrbLintOauthRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []

  }

  trait OrbLintOauth -> OrbLintOauthRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (emit HOST_CALLS_COLLECT { requestId: (str/concat "oauth:" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["http", "oauth-authorize", "oauth-connection-status", "oauth-connection-forget"], operators: ["http", "oauth-authorize", "oauth-connection-status"], fields: [] })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "oauth:") @payload.unread)
        (set @entity.findings [{ code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", path: "operators", message: "the installed @almadar/std operator table could not be read, so the oauth vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the oauth vocabulary of http", severity: "error" }])
        (emit LINT_FINISH { })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "oauth:") (not @payload.unread))
        (set @entity.findings (let ((facts @payload.facts) (none : [OrbFinding] []) (nos : [string] []) (noo : [HcOauthOp] []))
          (let ((fhttp (object/get @facts "http")) (fauth (object/get @facts "oauth-authorize")) (fstat (object/get @facts "oauth-connection-status")))
            (let ((oauthSpec (object/get @fhttp "oauth" null)) (clientKeys (object/get (object/get @fauth "keys") "client" @nos)) (authorizeKeys (object/get (object/get @fauth "keys") "authorize" @nos)) (providers (object/get (object/get @fstat "words") "provider" @nos)) (modes (object/get (object/get @fhttp "words") "request/auth/client/mode" @nos)) (clientAuths (object/get (object/get @fhttp "words") "request/auth/client/clientAuth" @nos)) (endpointKeys (object/get (object/get @fhttp "keys") "request/auth/client/endpoints" @nos)))
              (let ((oauthOps (or (object/get @oauthSpec "ops" null) @noo)) (etarget (object/get @oauthSpec "endpointTarget" "")))
                (let ((allInputs (array/unique (array/flatten (array/map @oauthOps (fn o (array/concat (object/get @o "required") (object/get @o "optional"))))))))
                  (array/flatten (array/map @payload.calls (fn c
                    (let ((a (object/get @c "call")) (p (object/get @c "path")) (h (object/get @c "head")))
                      (let ((n (array/len @a)))
                        (if (= @h "http") (let ((last (array/last @a))) (let ((tgt (if (> @n 2) (array/nth @a 2) null))) (let ((trailing (and (> @n 4) (validate/object @last) (or (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "emit") (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "key"))))) (let ((endpointTarget (and (validate/string @tgt) (= @tgt @etarget)))) (let ((hasOpts (or @trailing (and (= @n 6) (validate/object @last))))) (let ((reqv (if (or (= @n 6) (and (= @n 5) (not @hasOpts))) (array/nth @a 4) null))) (let ((req (if (validate/object @reqv) (or (json/parse (json/stringify @reqv) HcValMap) {}) null))) (let ((authv (if (= @req null) null (object/get @req "auth" null)))) (let ((auth (if (validate/object @authv) (or (json/parse (json/stringify @authv) HcValMap) {}) null))) (let ((scheme (if (= @auth null) null (object/get @auth "scheme" null)))) (if (not (and (!= @auth null) (validate/string @scheme) (= @scheme "oauth-client"))) (if @endpointTarget [{ code: "ORB_OAUTH_ENDPOINT_MISMATCH", path: @p, message: (str/concat "`oauth-endpoint` needs an `oauth-client` auth"), suggestion: "Write auth: { scheme: oauth-client, op: <op>, client: <client>, … }", severity: "error" }] @none) (array/concat (if (= @req null) @none (let ((extra (array/find (object/keys @req) (fn k (!= @k "auth"))))) (if (= @extra null) @none [{ code: "ORB_OAUTH_REQUEST_CONFLICT", path: @p, message: (str/concat "an `oauth-client` request carries only `auth`, not `" @extra "`"), suggestion: "The driver builds the whole request; remove body, query, headers, retry, paginate, stream and presign", severity: "error" }]))) (if (and (object/has @auth "client") (not (object/has @auth "clients"))) (let ((c5 (object/get @auth "client" null))) (if (validate/object @c5) (let ((m6 (or (json/parse (json/stringify @c5) HcValMap) {}))) (array/concat (array/map (array/filter (array/sort (object/keys @m6)) (fn key (not (array/includes @clientKeys @key)))) (fn key { code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "`" @key "` is not a key of an OAuth client"), suggestion: "", severity: "error" })) (let ((w7 (object/get @m6 "tag" null))) (if (validate/string @w7) (if (and (not (or (str/startsWith @w7 (quote "@")) (str/startsWith @w7 "?") (str/startsWith @w7 "$"))) (not (array/includes @providers @w7))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `tag` must be one of " (str/join @providers ", ") ", not `" @w7 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w7) @none (if (object/has @m6 "tag") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `tag` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `tag`"), suggestion: "", severity: "error" }])))) (let ((w8 (object/get @m6 "mode" null))) (if (validate/string @w8) (if (and (not (or (str/startsWith @w8 (quote "@")) (str/startsWith @w8 "?") (str/startsWith @w8 "$"))) (not (array/includes @modes @w8))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `mode` must be one of " (str/join @modes ", ") ", not `" @w8 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w8) @none (if (object/has @m6 "mode") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `mode` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `mode`"), suggestion: "", severity: "error" }])))) (let ((w9 (object/get @m6 "clientAuth" null))) (if (validate/string @w9) (if (and (not (or (str/startsWith @w9 (quote "@")) (str/startsWith @w9 "?") (str/startsWith @w9 "$"))) (not (array/includes @clientAuths @w9))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `clientAuth` must be one of " (str/join @clientAuths ", ") ", not `" @w9 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w9) @none (if (object/has @m6 "clientAuth") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `clientAuth` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `clientAuth`"), suggestion: "", severity: "error" }])))) (if (object/has @m6 "clientId") @none [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "an OAuth client needs `clientId`"), suggestion: "", severity: "error" }]) (if (and (let ((x (object/get @m6 "issuer" null))) (!= @x null)) (not (let ((x (object/get @m6 "endpoints" null))) (!= @x null)))) @none (if (and (not (let ((x (object/get @m6 "issuer" null))) (!= @x null))) (let ((x (object/get @m6 "endpoints" null))) (!= @x null))) (let ((ep (object/get @m6 "endpoints" null))) (if (validate/object @ep) (let ((em (or (json/parse (json/stringify @ep) HcValMap) {}))) (array/concat (array/map (array/filter (array/sort (object/keys @em)) (fn key (not (array/includes @endpointKeys @key)))) (fn key { code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "`" @key "` is not an OAuth endpoint"), suggestion: "", severity: "error" })) (array/map (array/filter ["authorization", "token"] (fn key (not (object/has @em @key)))) (fn key { code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth endpoints need `" @key "`"), suggestion: "", severity: "error" })))) (if (or (validate/string @ep) (validate/array @ep)) @none [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth `endpoints` must be an object"), suggestion: "", severity: "error" }]))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "an OAuth client has exactly one of `issuer` or `endpoints`"), suggestion: "Name a discovered issuer, or the endpoints themselves", severity: "error" }])))) (if (or (and (validate/string @c5) (or (str/startsWith @c5 (quote "@")) (str/startsWith @c5 "?") (str/startsWith @c5 "$"))) (validate/array @c5)) @none [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "an OAuth client is an object { tag, mode, issuer | endpoints, clientId, clientSecret?, clientAuth }"), suggestion: "", severity: "error" }]))) (if (and (not (object/has @auth "client")) (object/has @auth "clients")) (let ((cs (object/get @auth "clients" null))) (if (validate/object @cs) (let ((cm (or (json/parse (json/stringify @cs) HcValMap) {}))) (array/concat (if (= (array/len (object/keys @cm)) 0) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "`clients` declares no client"), suggestion: "", severity: "error" }] @none) (array/flatten (array/map (array/sort (object/keys @cm)) (fn tag (if (not (array/includes @providers @tag)) [{ code: "ORB_OAUTH_PROVIDER_UNKNOWN", path: @p, message: (str/concat "`clients` is keyed by provider tag, not `" @tag "`"), suggestion: "", severity: "error" }] (let ((cv (object/get @cm @tag null))) (array/concat (let ((c0 @cv)) (if (validate/object @c0) (let ((m1 (or (json/parse (json/stringify @c0) HcValMap) {}))) (array/concat (array/map (array/filter (array/sort (object/keys @m1)) (fn key (not (array/includes @clientKeys @key)))) (fn key { code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "`" @key "` is not a key of an OAuth client"), suggestion: "", severity: "error" })) (let ((w2 (object/get @m1 "tag" null))) (if (validate/string @w2) (if (and (not (or (str/startsWith @w2 (quote "@")) (str/startsWith @w2 "?") (str/startsWith @w2 "$"))) (not (array/includes @providers @w2))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `tag` must be one of " (str/join @providers ", ") ", not `" @w2 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w2) @none (if (object/has @m1 "tag") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `tag` must be a word"), suggestion: "", seve