                (let ((allInputs (array/unique (array/flatten (array/map @oauthOps (fn o (array/concat (object/get @o "required") (object/get @o "optional"))))))))
                  (array/map (array/range 0 (array/len @payload.calls)) (fn ci
                    (let ((c (array/nth @payload.calls @ci)))
                      (let ((a (object/get @c "call")) (p (object/get @c "path")) (h (object/get @c "head")))
                        (let ((n (array/len @a)) (eo (object/get (object/get @facts @h) "emitOrder" @nos)))
                          { items: (if (= @h "oauth-authorize") (if (and (>= @n 3) (<= @n 4)) (let ((ov (if (> @n 3) (array/nth @a 3) null))) (if (and (validate/object @ov) (validate/object (object/get (or (json/parse (json/stringify @ov) HcValMap) {}) "emit" null))) [{ id: (str/concat "e" @ci), path: @p, emit: (or (json/parse (json/stringify (object/get (or (json/parse (json/stringify @ov) HcValMap) {}) "emit")) EmitObj) {}), allowedKeys: @eo, checkDeclared: true, declared: (object/get @c "declared") }] @noitems)) @noitems) (if (or (= @h "oauth-connection-status") (= @h "oauth-connection-forget")) (if (and (>= @n 2) (<= @n 3)) (let ((ov (if (> @n 2) (array/nth @a 2) null))) (if (and (validate/object @ov) (validate/object (object/get (or (json/parse (json/stringify @ov) HcValMap) {}) "emit" null))) [{ id: (str/concat "e" @ci), path: @p, emit: (or (json/parse (json/stringify (object/get (or (json/parse (json/stringify @ov) HcValMap) {}) "emit")) EmitObj) {}), allowedKeys: @eo, checkDeclared: true, declared: (object/get @c "declared") }] @noitems)) @noitems) @noitems)), pre: (if (= @h "http") (let ((last (array/last @a))) (let ((tgt (if (> @n 2) (array/nth @a 2) null))) (let ((trailing (and (> @n 4) (validate/object @last) (or (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "emit") (object/has (or (json/parse (json/stringify @last) HcValMap) {}) "key"))))) (let ((endpointTarget (and (validate/string @tgt) (= @tgt @etarget)))) (let ((hasOpts (or @trailing (and (= @n 6) (validate/object @last))))) (let ((reqv (if (or (= @n 6) (and (= @n 5) (not @hasOpts))) (array/nth @a 4) null))) (let ((req (if (validate/object @reqv) (or (json/parse (json/stringify @reqv) HcValMap) {}) null))) (let ((authv (if (= @req null) null (object/get @req "auth" null)))) (let ((auth (if (validate/object @authv) (or (json/parse (json/stringify @authv) HcValMap) {}) null))) (let ((scheme (if (= @auth null) null (object/get @auth "scheme" null)))) (if (not (and (!= @auth null) (validate/string @scheme) (= @scheme "oauth-client"))) (if @endpointTarget [{ code: "ORB_OAUTH_ENDPOINT_MISMATCH", path: @p, message: (str/concat "`oauth-endpoint` needs an `oauth-client` auth"), suggestion: "Write auth: { scheme: oauth-client, op: <op>, client: <client>, … }", severity: "error" }] @none) (array/concat (if (= @req null) @none (let ((extra (array/find (object/keys @req) (fn k (!= @k "auth"))))) (if (= @extra null) @none [{ code: "ORB_OAUTH_REQUEST_CONFLICT", path: @p, message: (str/concat "an `oauth-client` request carries only `auth`, not `" @extra "`"), suggestion: "The driver builds the whole request; remove body, query, headers, retry, paginate, stream and presign", severity: "error" }]))) (if (and (object/has @auth "client") (not (object/has @auth "clients"))) (array/concat (let ((c32 (object/get @auth "client" null))) (if (validate/object @c32) (let ((m33 (or (json/parse (json/stringify @c32) HcValMap) {}))) (array/concat (array/map (array/filter (array/sort (object/keys @m33)) (fn key (not (array/includes @clientKeys @key)))) (fn key { code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "`" @key "` is not a key of an OAuth client"), suggestion: "", severity: "error" })) (let ((w34 (object/get @m33 "tag" null))) (if (validate/string @w34) (if (and (not (or (str/startsWith @w34 (quote "@")) (str/startsWith @w34 "?") (str/startsWith @w34 "$"))) (not (array/includes @providers @w34))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `tag` must be one of " (str/join @providers ", ") ", not `" @w34 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w34) @none (if (object/has @m33 "tag") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `tag` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `tag`"), suggestion: "", severity: "error" }])))) (let ((w35 (object/get @m33 "mode" null))) (if (validate/string @w35) (if (and (not (or (str/startsWith @w35 (quote "@")) (str/startsWith @w35 "?") (str/startsWith @w35 "$"))) (not (array/includes @modes @w35))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `mode` must be one of " (str/join @modes ", ") ", not `" @w35 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w35) @none (if (object/has @m33 "mode") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `mode` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `mode`"), suggestion: "", severity: "error" }])))) (let ((w36 (object/get @m33 "clientAuth" null))) (if (validate/string @w36) (if (and (not (or (str/startsWith @w36 (quote "@")) (str/startsWith @w36 "?") (str/startsWith @w36 "$"))) (not (array/includes @clientAuths @w36))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `clientAuth` must be one of " (str/join @clientAuths ", ") ", not `" @w36 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w36) @none (if (object/has @m33 "clientAuth") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `clientAuth` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `clientAuth`"), suggestion: "", severity: "error" }])))) (if (object/has @m33 "clientId") @none [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "an OAuth client needs `clientId`"), suggestion: "", severity: "error" }]) (if (and (let ((x (object/get @m33 "issuer" null))) (!= @x null)) (not (let ((x (object/get @m33 "endpoints" null))) (!= @x null)))) @none (if (and (not (let ((x (object/get @m33 "issuer" null))) (!= @x null))) (let ((x (object/get @m33 "endpoints" null))) (!= @x null))) (let ((ep (object/get @m33 "e