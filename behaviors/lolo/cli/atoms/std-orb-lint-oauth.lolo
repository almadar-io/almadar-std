app std-orb-lint-oauth [
  version: "1.0.0",
  inbound: ["cli-lint-oauth"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-oauth — the `orb lint oauth <file>` command, the port of effect/oauth.rs (validate_oauth_effects): the `oauth-client` auth of an `http` call, the `oauth-endpoint` target and the `oauth-authorize`, `oauth-connection-status` and `oauth-connection-forget` effects, found at any depth of a guard or effect of an inline trait. The op words, each op's required and optional inputs and the endpoint word it is sent to (the `oauth` entry of `http`), the client object's keys, the provider, mode and client-auth words and the endpoint keys, and the authorize keys all come from the installed operator table through std-orb-lint-host-calls. Reports ORB_OAUTH_CLIENT_INVALID (a client that is not an object, an unknown key, a tag, mode or clientAuth that is missing, not a word or not one of the table's words, a missing clientId, not exactly one of issuer or endpoints, endpoints that are not an object, an unknown endpoint, a missing authorization or token endpoint, `clients` that declare no client, a client under another tag, both client and clients, neither), ORB_OAUTH_PROVIDER_UNKNOWN (a provider that is not a table word; a `clients` key that is not a provider), ORB_OAUTH_OP_UNKNOWN (no op, an op that is not in the table, an input the op requires and the call lacks, an input the op does not take, `clients` on an op other than code), ORB_OAUTH_ENDPOINT_MISMATCH (an `oauth-endpoint` without an oauth-client auth, an op sent to the wrong endpoint or with the wrong method, discovery sent to an endpoint), ORB_OAUTH_REQUEST_CONFLICT (an oauth-client request that carries more than `auth`) and ORB_OAUTH_OPTION_UNKNOWN (an oauth-authorize option the table does not declare, a missing redirectUri, options that are not an object), and the ORB_HOST_EFFECT_ARITY and ORB_HOST_EFFECT_OPTION_UNKNOWN of the three oauth effects. A literal issuer or endpoint URL outside the program's `egress` is ORB_HTTP_EGRESS_UNDECLARED (the origin of the URL read with the scheme's default port, the `defaultPorts` of the http operator's httpWire in the operator table), and the `emit` block of oauth-authorize, oauth-connection-status and oauth-connection-forget is checked through std-orb-emit-config with the emit keys of the operator table (ORB_EFF_EMIT_KEY_INVALID, ORB_EFF_EMIT_INVALID_NAME, ORB_EFF_EMIT_UNDECLARED_EVENT). The key findings belong to std-orb-lint-keyed-call-keys. Findings carry the Rust path (the guard or effect), message and suggestion (status 500, exit 1). Clean answers `lint oauth: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-oauth"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOrbital = { name : string, traits : [HcVal] }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]!, config : Map string HcVal?, inGuard : boolean? }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcClosed = { request : boolean?, intRange : HcIntRange? }
type HcOauthOp = { name : string!, required : [string]!, optional : [string]!, endpoint : string? }
type HcOauth = { endpointTarget : string!, endpointKinds : [string]!, ops : [HcOauthOp]! }
type HcGrantNeed = Map string HcVal
type HcAuthScheme = { name : string!, keys : [string]!, required : [string]?, onUnauthorized : [string]? }
type HcHttpWire = { requestKeys : [string]!, bodyKeys : [string]!, queryEncodings : [string]!, authSchemes : [HcAuthScheme]!, defaultPorts : Map string number! }
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitKeys : [string]? }
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, oauth : HcOauth?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, httpWire : HcHttpWire?, family : string?, emitOrder : [string]?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type HcValMap = Map string HcVal?
type LnVal = string | number | boolean | [LnVal?] | Map string LnVal?
type LnProgram = { orbitals : [HcOrbital], egress : [string]? }
type HcValMap = Map string HcVal?
type HcStrings = [string]
type EmitVal = string | number | boolean | [EmitVal?] | Map string EmitVal?
type EmitObj = Map string EmitVal?
type Seg = { items : [EmitItem]!, pre : [OrbFinding]!, post : [OrbFinding]! }
type EmitItem = { id : string!, path : string!, emit : EmitObj!, allowedKeys : [string]!, checkDeclared : boolean!, declared : [string]! }
type EmitResult = { id : string!, findings : [OrbFinding]! }


orbital OrbLintOauthOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Calls from "std/behaviors/std-orb-lint-host-calls"
  uses EmitConfigUse from "std/behaviors/std-orb-emit-config"

  entity OrbLintOauthRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    egressRaw : [string] = []
    segs : [Seg] = []
    emitRes : [EmitResult] = []

  }

  trait OrbLintOauth -> OrbLintOauthRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.egressRaw (or (object/get @payload.program "egress" null) []))
        (emit HOST_CALLS_COLLECT { requestId: (str/concat "oauth:" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["http", "oauth-authorize", "oauth-connection-status", "oauth-connection-forget"], operators: ["http", "oauth-authorize", "oauth-connection-status", "oauth-connection-forget"], fields: [] })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "oauth:") (or @payload.unread (not (object/has @payload.facts "http.httpWire"))))
        (set @entity.findings [{ code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", path: "operators", message: "the installed @almadar/std operator table could not be read, so the oauth vocabulary is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the oauth vocabulary of http", severity: "error" }])
        (emit LINT_FINISH { })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "oauth:") (not @payload.unread) (object/has @payload.facts "http.httpWire"))
        (set @entity.segs (let ((facts @payload.facts) (none : [OrbFinding] []) (noitems : [EmitItem] []) (nos : [string] []) (noo : [HcOauthOp] []))
          (let ((fhttp (object/get @facts "http")) (fauth (object/get @facts "oauth-authorize")) (fstat (object/get @facts "oauth-connection-status")) (egressRaw @entity.egressRaw))
            (let ((oauthSpec (object/get @fhttp "oauth" null)) (clientKeys (object/get (object/get @fauth "keys") "client" @nos)) (authorizeKeys (object/get (object/get @fauth "keys") "authorize" @nos)) (providers (object/get (object/get @fstat "words") "provider" @nos)) (modes (object/get (object/get @fhttp "words") "request/auth/client/mode" @nos)) (clientAuths (object/get (object/get @fhttp "words") "request/auth/client/clientAuth" @nos)) (endpointKeys (object/get (object/get @fhttp "keys") "request/auth/client/endpoints" @nos))
                  (dports (object/get (object/get @fhttp "httpWire" { requestKeys: [], bodyKeys: [], queryEncodings: [], authSchemes: [], defaultPorts: {} }) "defaultPorts")))
              (let ((oauthOps (or (object/get @oauthSpec "ops" null) @noo)) (etarget (object/get @oauthSpec "endpointTarget" "")) (egOrigins (array/filter (array/map @egressRaw (fn eg (let ((parts (str/split @eg "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (str/len (array/first (str/split @rest "/"))) (str/len @rest)) (if (str/includes @rest "?") (str/len (array/first (str/split @rest "?"))) (str/len @rest)) (if (str/includes @rest "#") (str/len (array/first (str/split @rest "#"))) (str/len @rest)) (if (str/includes @rest "\\") (str/len (array/first (str/split @rest "\\"))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (str/len (array/first (str/split @after "]"))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (or (= @pp null) (= (array/first @sp) "")) null (str/concat (str/lower (array/first @sp)) ":" @pp)))) (str/concat (str/lower @aut