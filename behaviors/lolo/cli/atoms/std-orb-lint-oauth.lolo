` must be one of " (str/join @modes ", ") ", not `" @w14 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w14) @none (if (object/has @m12 "mode") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `mode` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `mode`"), suggestion: "", severity: "error" }])))) (let ((w15 (object/get @m12 "clientAuth" null))) (if (validate/string @w15) (if (and (not (or (str/startsWith @w15 (quote "@")) (str/startsWith @w15 "?") (str/startsWith @w15 "$"))) (not (array/includes @clientAuths @w15))) [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `clientAuth` must be one of " (str/join @clientAuths ", ") ", not `" @w15 "`"), suggestion: "", severity: "error" }] @none) (if (validate/array @w15) @none (if (object/has @m12 "clientAuth") [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client `clientAuth` must be a word"), suggestion: "", severity: "error" }] [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "OAuth client needs `clientAuth`"), suggestion: "", severity: "error" }])))) (if (object/has @m12 "clientId") @none [{ code: "ORB_OAUTH_CLIENT_INVALID", path: @p, message: (str/concat "an OAuth client needs `clientId`"), suggestion: "", severity: "error" }]) (if (and (let ((x (object/get @m12 "issuer" null))) (!= @x null)) (not (let ((x (object/get @m12 "endpoints" null))) (!= @x null)))) @none (if (and (not (let ((x (object/get @m12 "issuer" null))) (!= @x null))) (let ((x (object/get @m12 "endpoints" null))) (!= @x null))) (let ((ep (object/get @m12 "endpoints" null))) (if (validate/object @ep) (let ((em (or (json/parse (json/stringify @ep) HcValMap) {}))) (array/concat (array/map (array/filter (array/sort (object/keys @em)) (fn key (not (array/includes @endpointKeys @key)))) (fn key { code: "ORB_OAUTH_CLIENT_INVALID", p