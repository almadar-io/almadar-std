                  (dports (default (object/get @fbeacon "defaultPorts" null) {})))
              (let ((egOrigins (array/filter (array/map @egressRaw (fn eg (let ((parts (str/split @eg "://"))) (if (< (array/len @parts) 2) null (let ((scheme (str/lower (array/first @parts))) (rest (str/join (array/slice @parts 1 (array/len @parts)) "://"))) (let ((dp (object/get @dports @scheme null))) (if (= @dp null) null (let ((end (math/min (if (str/includes @rest "/") (array/reduce (array/take (str/split @rest "/") 1) 0 (fn (m sg) (str/len @sg))) (str/len @rest)) (if (str/includes @rest "?") (array/reduce (array/take (str/split @rest "?") 1) 0 (fn (m sg) (str/len @sg))) (str/len @rest)) (if (str/includes @rest "#") (array/reduce (array/take (str/split @rest "#") 1) 0 (fn (m sg) (str/len @sg))) (str/len @rest)) (if (str/includes @rest "\\") (array/reduce (array/take (str/split @rest "\\") 1) 0 (fn (m sg) (str/len @sg))) (str/len @rest))))) (let ((auth (str/slice @rest 0 @end)) (rem (str/slice @rest @end))) (if (or (= @auth "") (str/includes @auth (quote "@")) (str/includes @auth " ")) null (let ((hp (if (str/startsWith @auth "[") (let ((after (str/slice @auth 1))) (if (not (str/includes @after "]")) null (let ((close (array/reduce (array/take (str/split @after "]") 1) 0 (fn (m sg) (str/len @sg))))) (let ((hostb (str/slice @auth 0 (+ @close 2))) (tail (str/slice @after (+ @close 1)))) (if (= @hostb "[]") null (if (= @tail "") (str/concat (str/lower @hostb) ":" @dp) (if (str/startsWith @tail ":") (let ((pp (let ((ps (str/slice @tail 1))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (if (= @pp null) null (str/concat (str/lower @hostb) ":" @pp))) null)))))))  (if (str/includes @auth ":") (let ((sp (str/split @auth ":"))) (let ((pp (let ((ps (str/join (array/slice @sp 1 (array/len @sp)) ":"))) (let ((pn (str/to-int @ps))) (if (and (!= @pn null) (not (str/startsWith @ps "-")) (>= @pn 0) (<= @pn 65535)) @pn null))))) (let ((sh (array/first @sp))) (if (or (= @pp null) (= @sh null) (= @sh ""