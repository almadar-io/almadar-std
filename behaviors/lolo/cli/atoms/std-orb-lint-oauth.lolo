      HOST_CALLS_HEARD { requestId : string!  unread : boolean!  calls : [HcCall]!  facts : Map string HcFact! }
        @description "The shared collector's answer: the calls of the asked heads and the table entries."
      HostCalls.HOST_CALLS_COLLECTED -> HOST_CALLS_HEARD
      EMIT_HEARD { requestId : string!  results : [EmitResult]! }
        @description "std-orb-emit-config's answer: the findings of each call's emit object."
      OrbEmitConfig.EMIT_CONFIG_CHECKED -> EMIT_HEARD
    }
  }

  trait OrbLintOauthCli -> OrbLintOauthRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint oauth <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "oauth") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint oauth: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "oauth") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint oauth: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-oauth" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint oauth` with its arguments and working directory."
        @synonyms "orb lint oauth"
      OrbLintOauth.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintOauthCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }
  trait HostCalls = Calls.traits.HostCalls {
    listens {
      OrbLintOauth.HOST_CALLS_COLLECT -> HOST_CALLS_COLLECT
      LINT_OPERATOR_SHAPES_HEARD { operators : Map string HcShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every operator's arity, host and params."
      LINT_OPERATOR_SHAPES_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator shapes could not be read."
      LINT_HOST_FACTS_HEARD { operators : Map string HcExtras! }
        @description "std-orb-lint-input's LINT_HOST_FACTS: the closedCall, oauth, grant, defaultPorts, httpWire, family and emitKeys of the operators that state any."
      LINT_HOST_FACTS_UNREAD_HEARD { error : string! }
        @description "std-orb-lint-input's LINT_HOST_FACTS_UNREAD: the host-effect facts could not be read."
      OrbLintInput.LINT_OPERATOR_SHAPES -> LINT_OPERATOR_SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> LINT_OPERATOR_SHAPES_UNREAD_HEARD
      OrbLintInput.LINT_HOST_FACTS -> LINT_HOST_FACTS_HEARD
      OrbLintInput.LINT_HOST_FACTS_UNREAD -> LINT_HOST_FACTS_UNREAD_HEARD
    }
  }
  trait OrbEmitConfig = EmitConfigUse.traits.OrbEmitConfig {
    listens {
      EMIT_CONFIG_CHECK { requestId : string!  items : [EmitItem]! }
        @description "Check each item's emit object against its allowed keys and the events its trait declares."
      OrbLintOauth.EMIT_CONFIG_CHECK -> EMIT_CONFIG_CHECK
    }
  }
  page boot as OrbLintOauthOrbitalStart -> OrbLintOauth, OrbLintOauthCli, OrbLintInput, Packs, Versions, HostCalls, OrbEmitConfig
}
