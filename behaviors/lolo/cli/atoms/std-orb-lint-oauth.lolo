app std-orb-lint-oauth [
  version: "1.0.0",
  inbound: ["cli-lint-oauth"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-oauth — the `orb lint oauth <file>` command, the port of effect/oauth.rs (validate_oauth_effects): the `oauth-authorize`, `oauth-connection-status` and `oauth-connection-forget` effects, found at any depth of a guard or effect of an inline trait. The client object's keys, the provider, mode and client-auth words and the endpoint keys, and the authorize keys all come from the installed operator table through std-orb-lint-host-calls. Reports ORB_OAUTH_CLIENT_INVALID (a client that is not an object, an unknown key, a tag, mode or clientAuth that is missing, not a word or not one of the table's words, a missing clientId, not exactly one of issuer or endpoints, endpoints that are not an object, an unknown endpoint, a missing authorization or token endpoint), ORB_OAUTH_PROVIDER_UNKNOWN (a provider that is not a table word) and ORB_OAUTH_OPTION_UNKNOWN (an oauth-authorize option the table does not declare, a missing redirectUri, options that are not an object), and the ORB_HOST_EFFECT_ARITY and ORB_HOST_EFFECT_OPTION_UNKNOWN of the three oauth effects. A literal issuer or endpoint URL outside the program's `egress` is ORB_HTTP_EGRESS_UNDECLARED (the origin of the URL read with the scheme's default port, the `defaultPorts` of `browser/beacon` in the operator table), and the `emit` block of oauth-authorize, oauth-connection-status and oauth-connection-forget is checked through std-orb-emit-config with the emit keys of the operator table (ORB_EFF_EMIT_KEY_INVALID, ORB_EFF_EMIT_INVALID_NAME, ORB_EFF_EMIT_UNDECLARED_EVENT). The key findings belong to std-orb-lint-keyed-call-keys. Findings carry the Rust path (the guard or effect), message and suggestion (status 500, exit 1). Clean answers `lint oauth: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-oauth"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string], entity : string, field : string }
type HcVal = string | number | boolean | [HcVal?] | Map string HcVal?
type HcOrbital = { name : string, traits : [HcVal] }
type HcCall = { head : string!, path : string!, call : [HcVal?]!, tname : string!, tick : string!, bg : boolean!, declared : [string]!, config : Map string HcVal?, inGuard : boolean? }
type HcType = string | HcTypeNode
type HcTypeNode = { kind : string!, fields : Map string HcType?, optional : [string]? }
type HcParam = { name : string!, optional : boolean?, type : HcType }
type HcIntRange = { arg : number!, min : number!, max : number! }
type HcByLiteral = { key : string!, required : Map string [string]! }
type HcClosed = { request : boolean?, intRange : HcIntRange?, requestKeysByLiteral : HcByLiteral? }
type HcGrantNeed = Map string HcVal
type HcShape = { category : string?, minArity : number?, maxArity : number?, runsOn : string?, host : string?, hasSideEffects : boolean!, params : [HcParam]! }
type HcExtras = { closedCall : HcClosed?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, family : string?, emitKeys : [string]? }
type HcFact = { minArity : number!, maxArity : number?, runsOn : string?, host : string?, params : [HcParam]!, closedCall : HcClosed?, grant : [HcGrantNeed]?, defaultPorts : Map string number?, family : string?, emitOrder : [string]?, hasOptions : boolean!, optionKeys : [string]!, emitKeys : [string]!, hasRequest : boolean!, requestFields : [string]!, requestRequired : [string]!, words : Map string [string]!, keys : Map string [string]! }
type HcValMap = Map string HcVal?
type LnVal = string | number | boolean | [LnVal?] | Map string LnVal?
type LnProgram = { orbitals : [HcOrbital], egress : [string]? }
type HcValMap = Map string HcVal?
type HcStrings = [string]
type EmitVal = string | number | boolean | [EmitVal?] | Map string EmitVal?
type EmitObj = Map string EmitVal?
type Seg = { items : [EmitItem]!, pre : [OrbFinding]!, post : [OrbFinding]! }
type EmitItem = { id : string!, path : string!, emit : EmitObj!, allowedKeys : [string]!, checkDeclared : boolean!, declared : [string]! }
type EmitResult = { id : string!, findings : [OrbFinding]! }


type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintOauthCodes = { lintOperatorShapesUnread : LintCodeDecl   , oauthClientInvalid : LintCodeDecl , httpEgressUndeclared : LintCodeDecl , oauthProviderUnknown : LintCodeDecl  , hostEffectArity : LintCodeDecl , oauthOptionUnknown : LintCodeDecl , hostEffectOptionUnknown : LintCodeDecl }

orbital OrbLintOauthOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Calls from "std/behaviors/std-orb-lint-host-calls"
  uses EmitConfigUse from "std/behaviors/std-orb-emit-config"

  entity OrbLintOauthRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    egressRaw : [string] = []
    segs : [Seg] = []
    emitRes : [EmitResult] = []

  }

  trait OrbLintOauth -> OrbLintOauthRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.egressRaw (default (object/get @payload.program "egress" null) []))
        (emit HOST_CALLS_COLLECT { requestId: (str/concat "oauth:" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["oauth-authorize", "oauth-connection-status", "oauth-connection-forget"], operators: ["browser/beacon", "oauth-authorize", "oauth-connection-status", "oauth-connection-forget"], fields: [] })
      HOST_CALLS_HEARD -> ready when (and (str/startsWith @payload.requestId "oauth:") (or @payload.unread (not (object/has @payload.facts "browser/beacon")) (not (object/has @payload.facts "oauth-authorize")) (not (object/has @payload.facts "oauth-connection-status"))))
