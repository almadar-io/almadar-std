app std-orb-lint-duplicate-inbound-hook [
  version: "1.0.0",
  inbound: ["cli-lint-duplicate-inbound-hook"],
  fs: { "./packages/almadar-std/behaviors/lolo/**": [read], "./packages/almadar-behaviors/behaviors/lolo/**": [read] },
  description: "std-orb-lint-duplicate-inbound-hook — the `orb lint duplicate-inbound-hook` command, the guard behind the one-program-per-hook rule the cli resolver enforces at run time. It walks every .lolo under the std and io behavior trees, lowers each file that names an inbound hook with program/read, collects the hooks that the file's OWN traits handle (a trait written out in the file; a trait composed from another behavior is a reference, so a hook re-declared only because of composition is not counted), and reports every hook handled by more than one file, with the files (status 500, exit 1). When every hook has one owner the answer is `duplicate-inbound-hook: clean` (status 200, exit 0). A file that could not be read or lowered is listed as UNREAD and fails the run. Any argument is the usage (status 400, exit 2). Like shared-types it walks the trees and takes no file, so std-orb-lint-all (one file per rule) does not run it."
]
uses Spec from "almadar-std/lint-duplicate-inbound-hook"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LintHook = { name : string!, file : string! }
type LintEntry = { name : string!, kind : string! }
type LintFile = { root : number!, rel : string! }

orbital OrbLintDuplicateInboundHookOrbital {
  entity OrbLintDuplicateInboundHookRun [runtime] {
    id : string!
    paths : [LintFile] = []
    queue : [LintFile] = []
    cursor : number = 0
    hooks : [LintHook] = []
    unread : [string] = []
    dups : [string] = []
  }

  trait OrbLintDuplicateInboundHook -> OrbLintDuplicateInboundHookRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint duplicate-inbound-hook" })
      LINT_CALLED -> walking when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 0)
        (set @entity.paths [])
        (set @entity.queue [{ root: 0, rel: "" }, { root: 1, rel: "" }])
        (set @entity.hooks [])
        (set @entity.unread [])
        (set @entity.cursor 0)
        (emit LINT_WALK { })
      LINT_FINISH -> ready when (and (= (array/len @entity.dups) 0) (= (array/len @entity.unread) 0))
        (emit LINT_ANSWERED { status: 200, body: "duplicate-inbound-hook: clean" })
      LINT_FINISH -> ready when (or (> (array/len @entity.dups) 0) (> (array/len @entity.unread) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map (array/concat
          (array/map @entity.dups (fn n (let ((files (array/sort (array/map (array/filter @entity.hooks (fn h (= (object/get @h "name") @n))) (fn h (object/get @h "file"))) "" "asc"))) { code: "inbound-hook-duplicate", path: @n, message: (str/concat "hook '" @n "' is handled by " (array/len @files) " programs: " (str/join @files ", ")), suggestion: "one program owns a hook; split the shared trait into a cli trait and an engine trait and compose the engine", severity: "error" })))
          (array/map @entity.unread (fn u { code: "unread", path: @u, message: "the file could not be read or listed", suggestion: "", severity: "error" }))) (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
    }

    state walking {
      INIT -> walking
      LINT_WALK -> reading when (= (array/len @entity.queue) 0)
        (set @entity.cursor 0)
        (emit LINT_READ { })
      LINT_WALK -> walking when (and (> (array/len @entity.queue) 0) (= (object/get (array/first @entity.queue) "root") 0))
        (os/list-dir (str/concat "./packages/almadar-std/behaviors/lolo/" (object/get (array/first @entity.queue) "rel")) { key: "dir" emit: { success: LINT_LISTED, failure: LINT_LIST_FAILED } })
      LINT_WALK -> walking when (and (> (array/len @entity.queue) 0) (= (object/get (array/first @entity.queue) "root") 1))
        (os/list-dir (str/concat "./packages/almadar-behaviors/behaviors/lolo/" (object/get (array/first @entity.queue) "rel")) { key: "dir" emit: { success: LINT_LISTED, failure: LINT_LIST_FAILED } })
      LINT_LISTED -> walking
        (set @entity.paths (array/concat @entity.paths (array/map (array/filter @payload.entries (fn e (and (!= (object/get @e "kind") "dir") (str/endsWith (object/get @e "name") ".lolo")))) (fn e { root: (object/get (array/first @entity.queue) "root"), rel: (str/concat (object/get (array/first @entity.queue) "rel") (object/get @e "name")) }))))
        (set @entity.queue (array/concat (array/drop @entity.queue 1) (array/map (array/filter @payload.entries (fn e (= (object/get @e "kind") "dir"))) (fn e { root: (object/get (array/first @entity.queue) "root"), rel: (str/concat (object/get (array/first @entity.queue) "rel") (object/get @e "name") "/") }))))
        (emit LINT_WALK { })
      LINT_LIST_FAILED -> walking
        (set @entity.unread (array/append @entity.unread (str/concat (object/get (array/first @entity.queue) "rel") " (not listed: " @payload.error ")")))
        (set @entity.queue (array/drop @entity.queue 1))
        (emit LINT_WALK { })
    }

    state reading {
      INIT -> reading
      LINT_READ -> reading when (and (< @entity.cursor (array/len @entity.paths)) (= (object/get (array/nth @entity.paths @entity.cursor) "root") 0))
        (os/open (str/concat "./packages/almadar-std/behaviors/lolo/" (object/get (array/nth @entity.paths @entity.cursor) "rel")) "r" { key: "open" emit: { success: LINT_OPENED, failure: LINT_FILE_UNREAD } })
      LINT_READ -> reading when (and (< @entity.cursor (array/len @entity.paths)) (= (object/get (array/nth @entity.paths @entity.cursor) "root") 1))
        (os/open (str/concat "./packages/almadar-behaviors/behaviors/lolo/" (object/get (array/nth @entity.paths @entity.cursor) "rel")) "r" { key: "open" emit: { success: LINT_OPENED, failure: LINT_FILE_UNREAD } })
      LINT_READ -> ready when (>= @entity.cursor (array/len @entity.paths))
        (set @entity.dups (array/sort (array/filter (array/unique (array/map @entity.hooks (fn h (object/get @h "name")))) (fn n (> (array/len (array/filter @entity.hooks (fn h (= (object/get @h "name") @n)))) 1))) "" "asc"))
        (emit LINT_FINISH { })
      LINT_OPENED -> reading
        (os/read @payload.fd 4194304 { key: "chunk" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FILE_READ -> reading when (str/includes (bytes/to-string @payload.data) "inbound \"")
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_FILE_READ -> reading when (not (str/includes (bytes/to-string @payload.data) "inbound \""))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit LINT_READ { })
      LINT_PROGRAM_READ -> reading
        (set @entity.hooks (array/concat @entity.hooks (array/map (array/unique (array/flatten (array/map (object/get @payload.result "orbitals") (fn o (array/flatten (array/map (object/get @o "traits" []) (fn t (array/map (array/filter (object/get (object/get @t "stateMachine" {}) "events" []) (fn e (validate/object (object/get @e "inbound" null)))) (fn e (object/get (object/get @e "inbound") "name")))))))))) (fn n { name: @n, file: (object/get (array/nth @entity.paths @entity.cursor) "rel") }))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit LINT_READ { })
      LINT_FILE_UNREAD -> reading
        (set @entity.unread (array/append @entity.unread (object/get (array/nth @entity.paths @entity.cursor) "rel")))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit LINT_READ { })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_LISTED { entries : [LintEntry]! }
        @description "A directory listed."
        @tier "internal"
      LINT_LIST_FAILED { error : string }
        @description "A directory that could not be listed."
        @tier "internal"
      LINT_OPENED { fd : number! }
        @description "A file opened."
        @tier "internal"
      LINT_FILE_READ { data : bytes!, eof : boolean }
        @description "A file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "A file that could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "A file lowered by program/read."
        @tier "internal"
      LINT_WALK { }
        @description "Internal: list the next directory."
        @tier "internal"
      LINT_READ { }
        @description "Internal: read the next file."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-duplicate-inbound-hook" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint duplicate-inbound-hook` with its arguments and working directory."
        @synonyms "orb lint duplicate-inbound-hook, shared type copies guard"
    }
  }

  page "/orb-lint-duplicate-inbound-hook" as OrbLintDuplicateInboundHookPage -> OrbLintDuplicateInboundHook
}
