app std-orb-lint-collection-policy [
  version: "1.0.0",
  inbound: ["cli-lint-collection-policy"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-collection-policy — the `orb lint collection-policy <file>` command, the port of ORB_S_COLLECTION_POLICY_CONFLICT (entity_access.rs validate_collection_policy_agreement). It lowers the file with program/read and reports each entity that binds a persistent collection already bound by an earlier entity with different @read/@create/@update/@delete directives (status 500, exit 1). Clean answers `lint collection-policy: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-collection-policy"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type PolicyValue = string | number | boolean | [PolicyValue] | Map string PolicyValue
type PolicyEntity = { name : string, collection : string, read_policy : PolicyValue, create_policy : PolicyValue, update_policy : PolicyValue, delete_policy : PolicyValue }
type PolicyOrbital = { entity : PolicyEntity, auxiliaryEntities : [PolicyEntity] }
type PolicyProgram = { orbitals : [PolicyOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintCollectionPolicyOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintCollectionPolicyRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintCollectionPolicy -> OrbLintCollectionPolicyRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (let ((es (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((o (array/nth @orbitals @oi)))
              (array/filter (array/concat [(object/get @o "entity" {})] (object/get @o "auxiliaryEntities" []))
                (fn en (and (validate/object @en) (object/has @en "collection") (or (object/has @en "read_policy") (object/has @en "create_policy") (object/has @en "update_policy") (object/has @en "delete_policy")))))))))))
            (array/flatten (array/map (array/range 0 (array/len @es)) (fn i
              (let ((en (array/nth @es @i)))
                (let ((fi (array/first (array/filter (array/range 0 (array/len @es)) (fn j (= (object/get (array/nth @es @j) "collection") (object/get @en "collection"))))))
                      (first (array/find @es (fn x (= (object/get @x "collection") (object/get @en "collection"))))))
                  (if (and (!= @fi @i) (!= [(object/get @first "read_policy" "") (object/get @first "create_policy" "") (object/get @first "update_policy" "") (object/get @first "delete_policy" "")] [(object/get @en "read_policy" "") (object/get @en "create_policy" "") (object/get @en "update_policy" "") (object/get @en "delete_policy" "")]))
                    [{ code: "ORB_S_COLLECTION_POLICY_CONFLICT", path: (str/concat (object/get @en "name") ".@access"), message: (str/concat "entities `" (object/get @first "name") "` and `" (object/get @en "name") "` both bind collection `" (object/get @en "collection") "` but declare different access directives. One collection is one table and cannot have two visibility rules — give them identical directives, or bind one of them to its own collection."), suggestion: "", severity: "error" }]
                    [])))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "collection-policy", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PolicyProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintCollectionPolicyCli -> OrbLintCollectionPolicyRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint collection-policy <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "collection-policy") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint collection-policy: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "collection-policy") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint collection-policy: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-collection-policy" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint collection-policy` with its arguments and working directory."
        @synonyms "orb lint collection-policy, orb lint collection-policy, shared collection access directives"
      OrbLintCollectionPolicy.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintCollectionPolicyCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintCollectionPolicyOrbitalStart -> OrbLintCollectionPolicy, OrbLintCollectionPolicyCli, OrbLintInput, Packs, Versions
}
