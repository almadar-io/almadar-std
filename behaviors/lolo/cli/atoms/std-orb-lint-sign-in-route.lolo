app std-orb-lint-sign-in-route [
  version: "1.0.0",
  inbound: ["cli-lint-sign-in-route"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-sign-in-route — the `orb lint sign-in-route <file>` command, the port of validate_sign_in_route. It lowers the file with program/read and reports ORB_P_HOST_RESERVED_ROUTE for any page declared on the host's own `/login` route, and ORB_P_SIGN_IN_UNKNOWN_ROUTE when the app's `signIn:` route (other than `/login`) is no page of the program or is itself `access: authenticated` (route params compare as one `:` segment), each with its path and suggestion (status 500, exit 1). Pages recorded by `uses lazy` (the program's lazyPages) count as pages for both checks, but a lazy page's own access is not read. Clean answers `lint sign-in-route: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-sign-in-route"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintSignInRouteOrbital {
  entity OrbLintSignInRouteRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintSignInRoute -> OrbLintSignInRouteRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "sign-in-route", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((sgi (if (object/has @payload.result "site") (object/get (object/get @payload.result "site") "signIn" "") "")) (allp (array/flatten (array/map (object/get @payload.result "orbitals") (fn orb (object/get @orb "pages" [])))))
        (lazyp (object/get @payload.result "lazyPages" [])))
          (array/flatten [
            (array/flatten (array/map (array/filter (array/concat @allp @lazyp) (fn pg (or (= (object/get @pg "path" "") "/login") (= (object/get @pg "path" "") "/login/")))) (fn pg
              [{ code: "ORB_P_HOST_RESERVED_ROUTE", path: (object/get @pg "path"), message: (str/concat "'" (object/get @pg "path") "' is the host's own sign-in route; no page may be declared on it"), suggestion: "move this page to another route; name `signIn: \"/login\"` to send viewers to the host's sign-in", severity: "error" }])))
            (if (or (= @sgi "") (= @sgi "/login") (= @sgi "/login/"))
              []
              (let ((tgt (str/join (array/map (str/split @sgi "/") (fn seg (if (str/startsWith @seg ":") ":" @seg))) "/")))
                (let ((hits (array/filter @allp (fn pg (= (str/join (array/map (str/split (object/get @pg "path" "") "/") (fn seg (if (str/startsWith @seg ":") ":" @seg))) "/") @tgt)))))
                  (if (and (= (array/len @hits) 0) (= (array/len (array/filter @lazyp (fn pg (= (str/join (array/map (str/split (object/get @pg "path" "") "/") (fn seg (if (str/startsWith @seg ":") ":" @seg))) "/") @tgt)))) 0))
                    [{ code: "ORB_P_SIGN_IN_UNKNOWN_ROUTE", path: "site.signIn", message: (str/concat "the `signIn` route '" @sgi "' is no page of this app"), suggestion: "point `signIn:` at a page anonymous viewers can open", severity: "error" }]
                    (if (and (> (array/len @hits) 0) (= (object/get (array/first @hits) "access" "") "authenticated"))
                      [{ code: "ORB_P_SIGN_IN_UNKNOWN_ROUTE", path: "site.signIn", message: (str/concat "the `signIn` route '" @sgi "' is itself `access: authenticated`"), suggestion: "point `signIn:` at a page anonymous viewers can open", severity: "error" }]
                      [])))))])))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "sign-in-route" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintSignInRouteCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintSignInRouteCli -> OrbLintSignInRouteRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint sign-in-route <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "sign-in-route") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint sign-in-route: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "sign-in-route") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "sign-in-route")
        (emit LINT_ANSWERED { status: 500, body: "lint sign-in-route: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-sign-in-route" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint sign-in-route` with its arguments and working directory."
        @synonyms "orb lint sign-in-route"
      OrbLintSignInRoute.LINT_FOUND -> LINT_FOUND
      OrbLintSignInRoute.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-sign-in-route" as OrbLintSignInRoutePage -> OrbLintSignInRoute, OrbLintSignInRouteCli
}
