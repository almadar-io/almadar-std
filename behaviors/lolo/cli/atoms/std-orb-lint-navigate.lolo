app std-orb-lint-navigate [
  version: "1.0.0",
  inbound: ["cli-lint-navigate"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-navigate — the `orb lint navigate <file>` command, the port of validate_navigate and validate_send_server (effect/navigate.rs). It lowers the file with program/read, builds the declared page set (every inline page with the required payload fields of its traits' INIT events, every `expects page` route and every `uses lazy` page, a declaration keeping its own payload) and walks the effects of every inline trait transition and tick, descending through do, if, when and let. A `navigate` with no path is ORB_EFF_UNKNOWN_TYPE; a literal target that is neither an http(s) URL nor starts with / or @ is ORB_P_INVALID_PATH; a target that resolves to no declared page (the host sign-in route /login and external URLs aside, and a target that is wholly a binding) is ORB_EFF_NAVIGATE_TARGET_UNREACHABLE; a target page whose INIT requires payload fields the navigate does not pass is ORB_EFF_NAVIGATE_MISSING_PAYLOAD per field. A `send-server` with no event name is ORB_EFF_UNKNOWN_TYPE. Each finding carries the Rust path, message and suggestion (status 500, exit 1). The rule asks std-orb-effect-leaves for the navigate and send-server effects (heads: navigate, send-server) and reads the path, its str/concat prefix and the payload object's keys from their flat typed nodes. Clean answers `lint navigate: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-navigate"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type NavNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type NavLeaf = { p : string!, n : [NavNode]!, oi : number!, ti : number! }
type NavWalkSlot = { kind : string!, args : [number] }
type NavWalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type NavExprItem = { eff : boolean! }
type NavField = { name : string, required : boolean }
type NavEvent = { key : string, payloadSchema : [NavField] }
type NavMachine = { transitions : [NavTransition], events : [NavEvent] }
type NavTransition = { event : string }
type NavTrait = { name : string, stateMachine : NavMachine }
type NavPageTrait = { ref : string, name : string, stateMachine : NavMachine }
type NavPage = { path : string, traits : [NavPageTrait] }
type NavExpect = { kind : string, path : string, protocol : string }
type NavOrbital = { name : string, traits : [NavTrait], pages : [NavPage], expects : [NavExpect] }
type NavLazy = { path : string }
type NavProgram = { orbitals : [NavOrbital], lazyPages : [NavLazy] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintNavigateCodes = { effUnknownType : LintCodeDecl , pInvalidPath : LintCodeDecl , effNavigateTargetUnreachable : LintCodeDecl , effNavigateMissingPayload : LintCodeDecl }

orbital OrbLintNavigateOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintNavigateRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    orbitals : [NavOrbital] = []
    lazyPages : [NavLazy] = []
  }

  trait OrbLintNavigate -> OrbLintNavigateRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get @payload.program "orbitals" []))
        (set @entity.lazyPages (object/get @payload.program "lazyPages" []))
        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "navigate" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["navigate", "send-server"] })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "navigate" @entity.scope))
        (set @entity.findings (let ((orbitals @entity.orbitals) (nn : NavNode { k: "nil", ks: [], hd: "", nms: [], rt: "", nm: "", pa: [], bd: -1, wh: "", tx: "", pv: false, hs: false, sl: [], lb: [], lv: null })) (let ((entries (array/concat (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((o (array/nth @orbitals @oi))) (let ((visible (array/flatten (array/map (array/slice @orbitals 0 (+ @oi 1)) (fn vo (array/filter (object/get @vo "traits" []) (fn vt (object/has @vt "stateMachine")))))))) (array/concat (array/flatten (array/map (object/get @o "pages" []) (fn pg (let ((pth (object/get @pg "path"))) (if (= @pth null) [] [{ path: @pth , set: true, req: (array/unique (array/flatten (array/map (object/get @pg "traits" []) (fn r (let ((td (if (object/has @r "stateMachine") @r (array/last (array/filter @visible (fn vt (= (object/get @vt "name" "") (if (object/has @r "ref") (object/get @r "ref") (object/get @r "name" ""))))))))) (if (= @td null) (array/filter [""] (fn q false)) (array/flatten (array/map (array/filter (object/get (object/get @td "stateMachine" {  }) "events" []) (fn ev (= (object/get @ev "key" "") "INIT"))) (fn ev (array/map (array/filter (object/get @ev "payloadSchema" []) (fn fd (object/get @fd "required" false))) (fn fd (object/get @fd "name" "")))))))))))) }]))))) (array/map (array/filter (object/get @o "expects" []) (fn ex (and (= (object/get @ex "kind" "") "page") (not (object/has @ex "protocol"))))) (fn ex { path: (object/get @ex "path" "") , set: false, req: (array/filter [""] (fn q false)) })))))))) (array/map @entity.lazyPages (fn lz { path: (object/get @lz "path" "") , set: false, req: (array/filter [""] (fn q false)) }))))) (let ((reg (array/reduce @entries (array/filter @entries (fn q false)) (fn (acc en) (let ((idx (array/findIndex @acc (fn x (= (object/get @x "path") (object/get @en "path")))))) (if (< @idx 0) (array/append @acc { path: (object/get @en "path") , set: (object/get @en "set") , req: (object/get @en "req") }) (if (object/get @en "set") (array/map (array/range 0 (array/len @acc)) (fn j (if (= @j @idx) { path: (object/get @en "path") , set: true, req: (object/get @en "req") } (array/nth @acc @j)))) @acc))))))) (let ((ls @payload.leaves)) (array/flatten (array/map @ls (fn l (let ((n : [NavNode] (object/get @l "n" [])) (p (object/get @l "p"))) (let ((rti (- (array/len @n) 1)) (rt : NavNode (default (array/nth @n @rti) @nn))) (let ((rtks : [number] (object/get @rt "ks"))) (let ((rtcr : [number] (array/map (array/range 0 (array/len @rtks)) (fn j (- (+ (- @rti (array/sum @rtks)) (array/sum (array/take @rtks (+ @j 1)))) 1))))) (if (not (and (array/includes ["call", "arr", "proj", "rui"] (object/get @rt "k")) (> (array/len @rtks) 0) (or (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) "") "navigate") (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) "") "send-server")))) [] (let ((nk (array/len @rtks)) (h (default (array/first (default (object/get (default (array/nth @n (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) ""))) (if (= @h "send-server") (if (< @nk 2) [{ code: @config.codes.effUnknownType.code, path: @p, message: "send-server requires an event name", suggestion: "Use: [\"send-server\", \"EVENT_NAME\"] or [\"send-server\", \"EVENT_NAME\", { payload }]", severity: "error" }] []) (if (< @nk 2) [{ code: @config.codes.effUnknownType.code, path: @p, message: "navigate requires a path", suggestion: "Use: [\"navigate\", \"/path\"]", severity: "error" }] (let ((ti (default (array/nth @rtcr 1) 0)) (t : NavNode (default (array/nth @n @ti) @nn))) (let ((tks : [number] (object/get @t "ks"))) (let ((tcr : [number] (array/map (array/range 0 (array/len @tks)) (fn j (- (+ (- @ti (array/sum @tks)) (array/sum (array/take @tks (+ @j 1)))) 1))))) (let ((t1i (default (array/nth @tcr 1) 0)) (t1 : NavNode (default (array/nth @n @t1i) @nn))) (let ((oi (default (array/nth @rtcr 2) 0)) (o : NavNode (default (array/nth @n @oi) @nn))) (let ((hasnp (or (or (and (= (object/get @t "k") "nil") (!= (object/get @t "lv") null)) (and (= (object/get @t "k") "bind") (= (object/get @t "wh") "w")) (= (object/get @t "k") "cat")) (and (array/includes ["call", "arr", "proj", "rui"] (object/get @t "k")) (> (array/len @tks) 1) (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @tcr 0) 0)) @nn) "lv") [])) "") "str/concat") (or (and (= (object/get @t1 "k") "nil") (!= (object/get @t1 "lv") null)) (and (= (object/get @t1 "k") "bind") (= (object/get @t1 "wh") "w")) (= (object/get @t1 "k") "cat"))))) (np : string (if (or (and (= (object/get @t "k") "nil") (!= (object/get @t "lv") null)) (and (= (object/get @t "k") "bind") (= (object/get @t "wh") "w")) (= (object/get @t "k") "cat")) (if (= (object/get @t "k") "nil") (default (array/first (default (object/get @t "lv") [])) "") (if (= (object/get @t "k") "bind") (object/get @t "tx") (object/get (default (array/nth @n (- @ti 1)) @nn) "tx"))) (if (and (array/includes ["call", "arr", "proj", "rui"] (object/get @t "k")) (> (array/len @tks) 1) (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @tcr 0) 0)) @nn) "lv") [])) "") "str/concat") (or (and (= (object/get @t1 "k") "nil") (!= (object/get @t1 "lv") null)) (and (= (object/get @t1 "k") "bind") (= (object/get @t1 "wh") "w")) (= (object/get @t1 "k") "cat"))) (if (= (object/get @t1 "k") "nil") (default (array/first (default (object/get @t1 "lv") [])) "") (if (= (object/get @t1 "k") "bind") (object/get @t1 "tx") (object/get (default (array/nth @n (- @t1i 1)) @nn) "tx"))) ""))) (okeys : [string] (if (and (> @nk 2) (= (object/get @o "k") "obj")) (object/get @o "nms") []))) (if (not @hasnp) [] (let ((ext (or (str/startsWith @np "http://") (str/startsWith @np "https://"))) (dyn (array/includes ["call", "arr", "proj", "rui", "let", "lam"] (object/get @t "k"))) (q (str/includes @np "?")) (route (array/first (str/split @np "?")))) (if (= @route null) [] (array/concat (if (or @ext (str/startsWith @np "/") (str/startsWith @np (quote "@"))) [] [{ code: @config.codes.pInvalidPath.code, path: @p, message: (str/concat "Navigate path should start with '/': '" @np "'") , suggestion: "Use absolute paths starting with /", severity: "error" }]) (if (or @ext (= (str/replace-pattern @route "/+$" "") "/login")) [] (let ((m (if @q (let ((ex (array/find @reg (fn r (= (object/get @r "path") @route))))) (if (!= @ex null) @ex (let ((pm (array/find @reg (fn r (let ((pp (array/filter (str/split @route "/") (fn s (!= @s "")))) (qq (array/filter (str/split (object/get @r "path") "/") (fn s (!= @s ""))))) (and (= (array/len @pp) (array/len @qq)) (array/every (array/zip @qq @pp) (fn z (or (str/startsWith (array/nth @z 0) ":") (= (array/nth @z 0) (array/nth @z 1))))))))))) (if (!= @pm null) @pm (array/find @reg (fn r (str/startsWith (object/get @r "path") (str/replace-pattern @route "/+$" "")))))))) (if @dyn (let ((first (array/first (array/sort (array/map (array/filter @reg (fn r (str/startsWith (object/get @r "path") @np))) (fn r (object/get @r "path"))))))) (if (= @first null) null (array/find @reg (fn r (= (object/get @r "path") @first))))) (let ((ex (array/find @reg (fn r (= (object/get @r "path") @np))))) (if (!= @ex null) @ex (let ((pm (array/find @reg (fn r (let ((pp (array/filter (str/split @np "/") (fn s (!= @s "")))) (qq (array/filter (str/split (object/get @r "path") "/") (fn s (!= @s ""))))) (and (= (array/len @pp) (array/len @qq)) (array/every (array/zip @qq @pp) (fn z (or (str/startsWith (array/nth @z 0) ":") (= (array/nth @z 0) (array/nth @z 1))))))))))) (if (!= @pm null) @pm (array/find @reg (fn r (str/startsWith (object/get @r "path") (str/replace-pattern @np "/+$" "")))))))))))) (array/concat (if (and (= @m null) (> (array/len @reg) 0) (not (str/startsWith @np (quote "@")))) [{ code: @config.codes.effNavigateTargetUnreachable.code, path: @p, message: (str/concat "Navigate target '" @np "' doesn't resolve to any declared page") , suggestion: (str/concat "Declare a matching `pages[].path` (e.g. `page \"" @np "\" -> ...`) or correct the navigate path") , severity: "error" }] []) (if (= @m null) [] (array/flatten (array/map (object/get @m "req") (fn rf (if (array/includes @okeys @rf) [] [{ code: @config.codes.effNavigateMissingPayload.code, path: @p, message: (str/concat "Navigation to '" (object/get @m "path") "' requires payload field '" @rf "' for INIT event") , suggestion: (str/concat "Add payload to navigate effect: [\"navigate\", \"" @np "\", { \"" @rf "\": \"@entity." @rf "\" }]") , severity: "error" }]))))))))))))))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "navigate", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      EFFECT_LEAVES_EXPAND -> external { requestId : string!  orbitals : [NavOrbital]!  heads : [string]! }
        @description "Ask std-orb-effect-leaves to flatten the effects of every inline trait."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      EFFECT_LEAVES_HEARD { requestId : string!  leaves : [NavLeaf]! }
        @description "std-orb-effect-leaves's answer: the effects to check, flattened."
      OrbEffectLeaves.EFFECT_LEAVES_EXPANDED -> EFFECT_LEAVES_HEARD
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : NavProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintNavigateCodes = { effUnknownType: { code: "ORB_EFF_UNKNOWN_TYPE", category: "effect", description: "An effect has an unknown type or is malformed" }, pInvalidPath: { code: "ORB_P_INVALID_PATH", category: "page", description: "A page or navigate path does not start with a slash" }, effNavigateTargetUnreachable: { code: "ORB_EFF_NAVIGATE_TARGET_UNREACHABLE", category: "effect", description: "A navigate target path does not resolve to any declared page" }, effNavigateMissingPayload: { code: "ORB_EFF_NAVIGATE_MISSING_PAYLOAD", category: "effect", description: "A navigate effect omits a payload field the target page requires for its INIT event" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintNavigateCli -> OrbLintNavigateRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint navigate <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint navigate <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint navigate <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "navigate") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint navigate: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "navigate") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint navigate: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-navigate" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint navigate` with its arguments and working directory."
        @synonyms "orb lint navigate"
      OrbLintNavigate.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEffectLeaves = LeavesUse.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [NavOrbital]!  heads : [string]! }
        @description "Flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[NavNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintNavigate.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbLintExprNodes = Input.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string NavWalkSlot!  projections : Map string NavWalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [NavExprItem]! }
        @description "A rule asks to flatten expressions."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintNavigateCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintNavigateOrbitalStart -> OrbLintNavigate, OrbLintNavigateCli, OrbLintInput, Packs, OrbEffectLeaves, OrbLintExprNodes, Versions
}
