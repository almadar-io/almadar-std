app std-orb-update-notice [
  version: "1.0.0",
  inbound: ["cli-notice"],
  env: ["ORB_NO_UPDATE_CHECK", "CI", "PATH", "HOME"],
  exec: [exe, "orb"],
  fs: { "~/.orb/**": [read, write, create], "~/.orb": [create], cwd: "orb.lock.json": [read] },
  net: { "registry.npmjs.org:443": [tcp], "*.npmjs.org:443": [tcp] },
  description: "std-orb-update-notice — the daily updates-available notice and the urgent auto-update (spec/cli/orb-update-notice.lolo; golden: orbital-cli update_notice.rs). The call's first argv word `record` (after orb update) stamps ~/.orb/.update-check.json as checked now with nothing available and no urgent rows and prints nothing. Any other call is quiet when ORB_NO_UPDATE_CHECK or CI is set, and silent when stderr is not a terminal; a quiet call on a terminal only reports, loudly on stderr, each failed urgent row the cache holds, and never scans or updates. Otherwise it reads the cache { checkedAt (seconds), available [[name, installed, newest, store]] (a three-word row is the global store), urgent [[store, status, text]] (status applied or failed) }: a cache under a day old with no failed urgent row answers its list, an older, absent or garbled one rescans, and a cache with a failed urgent row acts at once on those stores without waiting for the day. The scan covers the global store (each @almadar/ dependency of ~/.orb/package.json with its range and its installed version in ~/.orb/node_modules/<name>/package.json) and the working directory's orb-installed packages (each name and version pinned in ./orb.lock.json, any version above the pinned one counts): it asks std-npm-lookup for the versions, walks the stable ones (no prerelease) from the newest down until std-semver says one satisfies the range, and keeps the package when that version compares above the installed one; a package that is not installed, whose lookup is refused, whose range std-semver refuses, or that no stable version satisfies is skipped. The registry's per-version orbRelease block (severity, advisory, fixes) is read by the update itself, not here: after the scan the notice runs `orb update --urgent` (project store, when the lockfile pins packages) and `orb update --urgent --global` through std-cli with ORB_NO_UPDATE_CHECK set so the child never recurses, and records what each printed. Every stdout line of the child is an applied urgent update (recorded status applied and printed as `orb: applied urgent <line> (<store> store)`); a non-zero exit, or a child that could not run, records status failed with the child's stderr and prints `orb: URGENT UPDATE FAILED for the <store> packages: <why>` and that the vulnerable version is still installed, on stderr, so the installed version is kept and nothing is hidden. Normal updates keep the one stderr line `orb: updates available (<name> <from> → <to>, …); run `orb update --global`` (a project package says `in this project` and `orb update`). The cache is written (a failed write is ignored) with the urgent rows, and the answer carries the stderr lines or nothing."
]
uses Spec from "almadar-std/orb-update-notice"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type NoticeLockEntry = { name : string!, version : string! }
type NoticeLock = { packages : [NoticeLockEntry]! }
type NoticeManifest = { dependencies : Map string string! }
type NoticeInstalled = { version : string! }
type NoticeDep = { name : string!, range : string!, store : string?, installed : string? }

orbital OrbUpdateNoticeOrbital {
  uses Npm from "std/behaviors/std-npm-lookup"
  uses Semver from "std/behaviors/std-semver"
  uses Cli from "std/behaviors/std-cli"
  uses Record from "std/behaviors/std-orb-update-record"

  entity UpdateNoticeRun [runtime] {
    id : string!
    mode : string = ""
    nowSec : number = 0
    checkedAt : number = 0
    cached : [[string]] = []
    deps : [NoticeDep] = []
    cursor : number = 0
    installed : string = ""
    cands : [string] = []
    cc : number = 0
    found : [[string]] = []
    quiet : boolean = false
    phase : string = "global"
    keepStamp : boolean = false
    hasProject : boolean = false
    cachedUrgent : [[string]] = []
    urgentRows : [[string]] = []
    stores : [string] = []
    sc : number = 0
  }

  trait Registry = Npm.traits.NpmLookup {
    listens {
      OrbUpdateNotice.UN_ASK -> NPM_LOOKUP
      NPM_LOOKUP_PACKUMENT { status : number!  headers : Map string string  body : string! }
      NPM_LOOKUP_UNREACHABLE { error : string!  kind : string! }
      RegistryHttp.REGISTRY_HTTP_REPLIED -> NPM_LOOKUP_PACKUMENT with { status: ?status, headers: ?headers, body: (default (bytes/to-string ?body) "") } when (= ?key "lookup")
      RegistryHttp.REGISTRY_HTTP_FAILED -> NPM_LOOKUP_UNREACHABLE with { error: ?error, kind: ?kind } when (= ?key "lookup")
      RegistryTimeout.TIMED_OUT -> NPM_LOOKUP_UNREACHABLE with { error: (str/concat "timeout of " ?timeoutMs "ms exceeded"), kind: "timeout" } when (= ?key "lookup")
    }
  }

  trait RegistryHttp = Npm.traits.LookupHttp {
    events {
      HTTP_REPLIED: REGISTRY_HTTP_REPLIED
      HTTP_FAILED: REGISTRY_HTTP_FAILED
      HTTP_CANCEL: REGISTRY_HTTP_CANCEL
    }
    listens {
      Registry.NPM_LOOKUP_HTTP_SEND -> HTTP_SEND
      RegistryTimeout.TIMED_OUT -> REGISTRY_HTTP_CANCEL with { key: ?key }
    }
  }

  trait RegistryTimeout = Npm.traits.LookupTimeout {
    listens {
      Registry.NPM_LOOKUP_HTTP_SEND -> START with { key: (as ?key CallKey) }
      RegistryHttp.REGISTRY_HTTP_REPLIED -> SUCCEEDED with { key: (as ?key CallKey) }
      RegistryHttp.REGISTRY_HTTP_FAILED -> FAILED with { key: (as ?key CallKey), error: ?error }
    }
  }

  trait Versions = Semver.traits.Semver {
    listens {
      OrbUpdateNotice.UN_SAT -> SEMVER_SATISFIES
      OrbUpdateNotice.UN_CMP -> SEMVER_COMPARE
    }
  }

  trait UpdateRecord = Record.traits.UpdateRecordStore {
    listens {
      OrbUpdateNotice.UN_RECORD_READ -> UPDATE_RECORD_READ
      OrbUpdateNotice.UN_RECORD_WRITE -> UPDATE_RECORD_WRITE
    }
  }

  trait OrbCli = Cli.traits.CliRunner {
    listens {
      OrbUpdateNotice.UN_CLI_RUN -> CLI_RUN
    }
    config {
      commands: ["orb"]
      passEnv: ["PATH", "HOME"]
      env: { ORB_NO_UPDATE_CHECK: "1" }
    }
  }

  trait OrbUpdateNotice -> UpdateNoticeRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      UPDATE_NOTICE_CALLED -> ready when (or (not (validate/required @payload.rawBody)) (= (json/parse @payload.rawBody OrbCommandArgs) null))
        (emit UPDATE_NOTICE_ANSWERED { status: 500, body: "", stderr: "Error: orb update-notice: the command arguments could not be read" })
      UPDATE_NOTICE_CALLED -> writing when (and (validate/required @payload.rawBody) (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (default (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) "") "record")))
        (set @entity.mode "record")
        (set @entity.nowSec (math/floor (time/diff (time/now) @config.epoch "s")))
        (set @entity.found [])
        (emit UN_WRITE { })
      UPDATE_NOTICE_CALLED -> gating when (and (validate/required @payload.rawBody) (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (default (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) "") "record")))
        (set @entity.mode "check")
        (set @entity.nowSec (math/floor (time/diff (time/now) @config.epoch "s")))
        (set @entity.found [])
        (emit UN_GATE { })
    }

    state gating {
      INIT -> gating
      UN_GATE -> gating
        (os/getenv "ORB_NO_UPDATE_CHECK" { key: "noupd" emit: { success: UN_ENV_NOUPD, failure: UN_ENV_FAILED } })
      UN_ENV_NOUPD -> gating when (!= @payload.value null)
        (set @entity.quiet true)
        (os/getenv "CI" { key: "ci" emit: { success: UN_ENV_CI, failure: UN_ENV_FAILED } })
      UN_ENV_NOUPD -> gating when (= @payload.value null)
        (os/getenv "CI" { key: "ci" emit: { success: UN_ENV_CI, failure: UN_ENV_FAILED } })
      UN_ENV_CI -> gating when (!= @payload.value null)
        (set @entity.quiet true)
        (os/isatty 2 { key: "tty" emit: { success: UN_TTY, failure: UN_ENV_FAILED } })
      UN_ENV_CI -> gating when (= @payload.value null)
        (os/isatty 2 { key: "tty" emit: { success: UN_TTY, failure: UN_ENV_FAILED } })
      UN_ENV_FAILED -> ready
        (emit UPDATE_NOTICE_ANSWERED { status: 200, body: "", stderr: "" })
      UN_TTY -> ready when (not @payload.ok)
        (emit UPDATE_NOTICE_ANSWERED { status: 200, body: "", stderr: "" })
      UN_TTY -> reading when @payload.ok
        (emit UN_RECORD_READ { })
    }

    state reading {
      INIT -> reading
      UN_CACHE_READ -> reading when (>= ?checkedAt 0)
        (set @entity.checkedAt ?checkedAt)
        (set @entity.cached ?available)
        (set @entity.cachedUrgent ?urgent)
        (emit UN_DUE { })
      UN_CACHE_ABSENT -> reading
        (set @entity.checkedAt 0)
        (set @entity.cached [])
        (set @entity.cachedUrgent [])
        (emit UN_DUE { })
      UN_DUE -> ready when @entity.quiet
        (emit UPDATE_NOTICE_ANSWERED { status: 200, body: "", stderr: (str/join (array/map (array/filter @entity.cachedUrgent (fn r (= (default (array/nth @r 1) "") "failed"))) (fn r (str/concat "orb: URGENT UPDATE FAILED for the " (default (array/nth @r 0) "") " packages: " (default (array/nth @r 2) "") "\norb: the vulnerable version is still installed; fix the cause and run `orb update --urgent" (if (= (default (array/nth @r 0) "") "global") " --global" "") "`"))) "\n") })
      UN_DUE -> ready when (and (not @entity.quiet) (< (- @entity.nowSec @entity.checkedAt) 86400) (= (array/len (array/filter @entity.cachedUrgent (fn r (= (default (array/nth @r 1) "") "failed")))) 0))
        (emit UPDATE_NOTICE_ANSWERED { status: 200, body: "", stderr: (let ((g (array/flatten (array/map (array/filter @entity.cached (fn t (= (default (array/nth @t 3) "global") "global"))) (fn t (let ((a (array/nth @t 0)) (b (array/nth @t 1)) (c (array/nth @t 2))) (if (and (validate/required @a) (and (validate/required @b) (validate/required @c))) [(str/concat @a " " @b " → " @c)] [])))))) (q (array/flatten (array/map (array/filter @entity.cached (fn t (= (default (array/nth @t 3) "global") "project"))) (fn t (let ((a (array/nth @t 0)) (b (array/nth @t 1)) (c (array/nth @t 2))) (if (and (validate/required @a) (and (validate/required @b) (validate/required @c))) [(str/concat @a " " @b " → " @c)] []))))))) (str/join (array/filter [(if (= (array/len @g) 0) "" (str/concat "orb: updates available (" (str/join @g ", ") "); run `orb update --global`")), (if (= (array/len @q) 0) "" (str/concat "orb: updates available in this project (" (str/join @q ", ") "); run `orb update`"))] (fn x (!= @x ""))) "\n")) })
      UN_DUE -> urgenting when (and (not @entity.quiet) (< (- @entity.nowSec @entity.checkedAt) 86400) (not (= (array/len (array/filter @entity.cachedUrgent (fn r (= (default (array/nth @r 1) "") "failed")))) 0)))
        (set @entity.found @entity.cached)
        (set @entity.keepStamp true)
        (set @entity.stores (array/unique (array/map (array/filter @entity.cachedUrgent (fn r (= (default (array/nth @r 1) "") "failed"))) (fn r (default (array/nth @r 0) "")))))
        (set @entity.urgentRows [])
        (set @entity.sc 0)
        (emit UN_URGENT_NEXT { })
      UN_DUE -> scanning when (and (not @entity.quiet) (>= (- @entity.nowSec @entity.checkedAt) 86400))
        (set @entity.phase "global")
        (os/read-file "~/.orb/package.json" { key: "manifest" emit: { success: UN_MANIFEST_READ, failure: UN_MANIFEST_ABSENT } })
    }

    state scanning {
      INIT -> scanning
      UN_MANIFEST_READ -> scanning when (!= (json/parse (default (bytes/to-string @payload.data) "") NoticeManifest) null)
        (set @entity.deps (array/map (array/filter (object/entries (object/get (json/parse (default (bytes/to-string @payload.data) "") NoticeManifest) "dependencies" {})) (fn t (str/startsWith (array/nth @t 0) (quote "@almadar/")))) (fn t { name: (array/nth @t 0), range: (array/nth @t 1), store: "global", installed: "" })))
        (set @entity.cursor 0)
        (emit UN_NEXT { })
      UN_MANIFEST_READ -> scanning when (= (json/parse (default (bytes/to-string @payload.data) "") NoticeManifest) null)
        (emit UN_END_PHASE { })
      UN_MANIFEST_ABSENT -> scanning
        (emit UN_END_PHASE { })
      UN_NEXT -> scanning when (>= @entity.cursor (array/len @entity.deps))
        (emit UN_END_PHASE { })
      UN_END_PHASE -> scanning when (= @entity.phase "global")
        (set @entity.phase "project")
        (set @entity.deps [])
        (set @entity.cursor 0)
        (os/read-file { anchor: "cwd" path: "orb.lock.json" } { key: "lock" emit: { success: UN_LOCK_READ, failure: UN_LOCK_ABSENT } })
      UN_LOCK_READ -> scanning when (!= (json/parse (default (bytes/to-string @payload.data) "") NoticeLock) null)
        (set @entity.deps (array/map (object/get (json/parse (default (bytes/to-string @payload.data) "") NoticeLock) "packages") (fn e { name: (object/get @e "name"), range: ">=0.0.0", store: "project", installed: (object/get @e "version") })))
        (set @entity.hasProject (> (array/len (object/get (json/parse (default (bytes/to-string @payload.data) "") NoticeLock) "packages")) 0))
        (set @entity.cursor 0)
        (emit UN_NEXT { })
      UN_LOCK_READ -> scanning when (= (json/parse (default (bytes/to-string @payload.data) "") NoticeLock) null)
        (set @entity.deps [])
        (emit UN_NEXT { })
      UN_LOCK_ABSENT -> scanning
        (set @entity.deps [])
        (emit UN_NEXT { })
      UN_END_PHASE -> urgenting when (= @entity.phase "project")
        (set @entity.stores (if @entity.hasProject ["project", "global"] ["global"]))
        (set @entity.urgentRows [])
        (set @entity.sc 0)
        (emit UN_URGENT_NEXT { })
      UN_NEXT -> looking when (and (< @entity.cursor (array/len @entity.deps)) (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null)) (!= (default (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "installed") "") ""))
        (set @entity.installed (default (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "installed") ""))
        (emit UN_ASK { requestId: (str/concat @entity.cursor), name: (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "name"), tag: "latest" })
      UN_NEXT -> scanning when (and (< @entity.cursor (array/len @entity.deps)) (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null)) (= (default (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "installed") "") ""))
        (os/read-file (str/concat "~/.orb/node_modules/" (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "name") "/package.json") { key: "installed" emit: { success: UN_PKG_READ, failure: UN_PKG_ABSENT } })
      UN_NEXT -> scanning when (and (< @entity.cursor (array/len @entity.deps)) (not (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null))))
        (emit UN_END_PHASE { })
      UN_PKG_ABSENT -> scanning
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_PKG_READ -> scanning when (not (validate/required (json/parse (default (bytes/to-string @payload.data) "") NoticeInstalled)))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_PKG_READ -> scanning when (and (validate/required (json/parse (default (bytes/to-string @payload.data) "") NoticeInstalled)) (not (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_PKG_READ -> looking when (and (validate/required (json/parse (default (bytes/to-string @payload.data) "") NoticeInstalled)) (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null)))
        (set @entity.installed (object/get (json/parse (default (bytes/to-string @payload.data) "") NoticeInstalled) "version"))
        (emit UN_ASK { requestId: (str/concat @entity.cursor), name: (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "name"), tag: "latest" })
    }

    state looking {
      INIT -> looking
      UN_LOOKED -> looking
        (set @entity.cands (array/reverse (array/filter @payload.versions (fn v (not (str/includes @v "-"))))))
        (set @entity.cc 0)
        (emit UN_TRY { })
      UN_LOOK_REFUSED -> scanning
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_TRY -> scanning when (>= @entity.cc (array/len @entity.cands))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_TRY -> scanning when (and (< @entity.cc (array/len @entity.cands)) (not (and (validate/required (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null)) (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null)))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_TRY -> looking when (and (< @entity.cc (array/len @entity.cands)) (and (validate/required (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null)) (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null))))
        (emit UN_SAT { requestId: (str/concat @entity.cursor "." @entity.cc), version: (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null), range: (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "range") })
      UN_SATISFIED -> looking when (not @payload.value)
        (set @entity.cc (+ @entity.cc 1))
        (emit UN_TRY { })
      UN_SATISFIED -> scanning when (and @payload.value (not (validate/required (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_SATISFIED -> looking when (and @payload.value (validate/required (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null)))
        (emit UN_CMP { requestId: @payload.requestId, a: (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null), b: @entity.installed })
      UN_SEMVER_REFUSED -> scanning
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_COMPARED -> scanning when (and (= @payload.value 1) (not (and (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null)) (validate/required (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null)))))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_COMPARED -> scanning when (and (= @payload.value 1) (and (validate/required (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null)) (validate/required (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null))))
        (set @entity.found (array/append @entity.found [(object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "name"), @entity.installed, (if (>= @entity.cc 0) (array/nth @entity.cands @entity.cc) null), (default (object/get (if (>= @entity.cursor 0) (array/nth @entity.deps @entity.cursor) null) "store") "global")]))
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
      UN_COMPARED -> scanning when (!= @payload.value 1)
        (set @entity.cursor (+ @entity.cursor 1))
        (emit UN_NEXT { })
    }

    state urgenting {
      INIT -> urgenting
      UN_URGENT_NEXT -> writing when (>= @entity.sc (array/len @entity.stores))
        (emit UN_WRITE { })
      UN_URGENT_NEXT -> urgenting when (and (< @entity.sc (array/len @entity.stores)) (= (default (if (>= @entity.sc 0) (array/nth @entity.stores @entity.sc) null) "") "global"))
        (emit UN_CLI_RUN { stage: "global", argv: ["update", "--urgent", "--global"] })
      UN_URGENT_NEXT -> urgenting when (and (< @entity.sc (array/len @entity.stores)) (!= (default (if (>= @entity.sc 0) (array/nth @entity.stores @entity.sc) null) "") "global"))
        (emit UN_CLI_RUN { stage: (default (if (>= @entity.sc 0) (array/nth @entity.stores @entity.sc) null) ""), argv: ["update", "--urgent"] })
      UN_CLI_DONE -> urgenting
        (set @entity.urgentRows (array/concat @entity.urgentRows (let ((st @payload.stage)) (array/concat (array/map (array/filter (str/split @payload.stdout "\n") (fn l (!= (str/trim @l) ""))) (fn l [@st, "applied", (str/trim @l)])) (if (= @payload.exitCode 0) [] [[@st, "failed", (if (= (str/trim @payload.stderr) "") (str/concat "orb exited with code " @payload.exitCode) (str/trim @payload.stderr))]])))))
        (set @entity.sc (+ @entity.sc 1))
        (emit UN_URGENT_NEXT { })
      UN_CLI_FAILED -> urgenting
        (set @entity.urgentRows (array/append @entity.urgentRows [@payload.stage, "failed", (str/concat "orb could not be run: " @payload.error " (" @payload.code ")")]))
        (set @entity.sc (+ @entity.sc 1))
        (emit UN_URGENT_NEXT { })
    }

    state writing {
      INIT -> writing
      UN_WRITE -> writing
        (emit UN_RECORD_WRITE { checkedAt: (if @entity.keepStamp @entity.checkedAt @entity.nowSec), available: @entity.found, urgent: @entity.urgentRows })
      UN_WRITTEN -> ready
        (emit UPDATE_NOTICE_ANSWERED { status: 200, body: "", stderr: (if (= @entity.mode "record") "" (str/join (array/filter [(let ((g (array/flatten (array/map (array/filter @entity.found (fn t (= (default (array/nth @t 3) "global") "global"))) (fn t (let ((a (array/nth @t 0)) (b (array/nth @t 1)) (c (array/nth @t 2))) (if (and (validate/required @a) (and (validate/required @b) (validate/required @c))) [(str/concat @a " " @b " → " @c)] [])))))) (q (array/flatten (array/map (array/filter @entity.found (fn t (= (default (array/nth @t 3) "global") "project"))) (fn t (let ((a (array/nth @t 0)) (b (array/nth @t 1)) (c (array/nth @t 2))) (if (and (validate/required @a) (and (validate/required @b) (validate/required @c))) [(str/concat @a " " @b " → " @c)] []))))))) (str/join (array/filter [(if (= (array/len @g) 0) "" (str/concat "orb: updates available (" (str/join @g ", ") "); run `orb update --global`")), (if (= (array/len @q) 0) "" (str/concat "orb: updates available in this project (" (str/join @q ", ") "); run `orb update`"))] (fn x (!= @x ""))) "\n")), (str/join (array/concat (array/map (array/filter @entity.urgentRows (fn r (= (default (array/nth @r 1) "") "applied"))) (fn r (str/concat "orb: applied urgent " (default (array/nth @r 2) "") " (" (default (array/nth @r 0) "") " store)"))) (array/map (array/filter @entity.urgentRows (fn r (= (default (array/nth @r 1) "") "failed"))) (fn r (str/concat "orb: URGENT UPDATE FAILED for the " (default (array/nth @r 0) "") " packages: " (default (array/nth @r 2) "") "\norb: the vulnerable version is still installed; fix the cause and run `orb update --urgent" (if (= (default (array/nth @r 0) "") "global") " --global" "") "`")))) "\n")] (fn x (!= @x ""))) "\n")) })
    }

    emits {
      UPDATE_NOTICE_ANSWERED -> external { status : number!  body : string!  stderr : string }
        @description "The notice line on stderr, or nothing."
        @tier "primary"
      UN_GATE { }
        @description "Internal: check the environment gates."
        @tier "internal"
      UN_DUE { }
        @description "Internal: the cache is loaded; decide fresh or stale."
        @tier "internal"
      UN_NEXT { }
        @description "Internal: read the next declared package."
        @tier "internal"
      UN_TRY { }
        @description "Internal: test the next stable candidate against the range."
        @tier "internal"
      UN_WRITE { }
        @description "Internal: write the cache."
        @tier "internal"
      UN_ASK { requestId : string!  name : string!  tag : string }
        @description "Internal: ask the registry for the package's versions."
        @tier "internal"
      UN_SAT { requestId : string!  version : string!  range : string! }
        @description "Internal: ask std-semver whether the candidate satisfies the range."
        @tier "internal"
      UN_CMP { requestId : string!  a : string!  b : string! }
        @description "Internal: ask std-semver to order the candidate against the installed version."
        @tier "internal"
      UN_ENV_NOUPD { value : string? }
        @description "Internal: ORB_NO_UPDATE_CHECK."
        @tier "internal"
      UN_ENV_CI { value : string? }
        @description "Internal: CI."
        @tier "internal"
      UN_ENV_FAILED { error : string  kind : string }
        @description "Internal: an environment read was denied."
        @tier "internal"
      UN_TTY { ok : boolean! }
        @description "Internal: whether stderr is a terminal."
        @tier "internal"
      UN_RECORD_READ { }
        @description "Internal: ask the update record owner to read the cache."
        @tier "internal"
      UN_RECORD_WRITE { checkedAt : number!  available : [[string]]!  urgent : [[string]]! }
        @description "Internal: ask the update record owner to write the cache."
        @tier "internal"
      UN_MANIFEST_READ { data : bytes! }
        @description "Internal: the user store manifest."
        @tier "internal"
      UN_MANIFEST_ABSENT { error : string  kind : string }
        @description "Internal: no manifest."
        @tier "internal"
      UN_PKG_READ { data : bytes! }
        @description "Internal: an installed package's manifest."
        @tier "internal"
      UN_PKG_ABSENT { error : string  kind : string }
        @description "Internal: the package is not installed."
        @tier "internal"
      UN_END_PHASE { }
        @description "Internal: the current store's packages are all judged; go to the next store or to the urgent updates."
        @tier "internal"
      UN_LOCK_READ { data : bytes! }
        @description "Internal: the working directory's orb.lock.json."
        @tier "internal"
      UN_LOCK_ABSENT { error : string  kind : string }
        @description "Internal: no readable orb.lock.json in the working directory."
        @tier "internal"
      UN_URGENT_NEXT { }
        @description "Internal: run the urgent update of the next store."
        @tier "internal"
      UN_CLI_RUN { stage : string!  argv : [string]! }
        @description "Internal: run orb update --urgent for one store through std-cli."
        @tier "internal"
    }

    config {
      epoch : instant = "1970-01-01T00:00:00.000Z"
        @description "The Unix epoch the cache's checkedAt seconds are counted from."
        @tier "infra"
    }

    listens {
      UPDATE_NOTICE_CALLED -> inbound "cli-notice" answers UPDATE_NOTICE_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run the daily updates-available notice, or `record` after orb update."
        @synonyms "update check, new version available, outdated packages"
      UN_CACHE_READ { checkedAt : number!  available : [[string]]!  urgent : [[string]]! }
        @description "Internal: the cache, read."
      UN_CACHE_ABSENT { }
        @description "Internal: no usable cache: absent, in another shape, or unreadable."
      UN_WRITTEN { }
        @description "Internal: the cache write finished or failed (ignored)."
      UpdateRecord.UPDATE_RECORD_LOADED -> UN_CACHE_READ
      UpdateRecord.UPDATE_RECORD_ABSENT -> UN_CACHE_ABSENT
      UpdateRecord.UPDATE_RECORD_UNREADABLE -> UN_CACHE_ABSENT
      UpdateRecord.UPDATE_RECORD_FAILED -> UN_CACHE_ABSENT
      UpdateRecord.UPDATE_RECORD_WRITTEN -> UN_WRITTEN
      UpdateRecord.UPDATE_RECORD_WRITE_FAILED -> UN_WRITTEN
      UN_CLI_DONE { stage : string!  exitCode : number!  signal : number!  stdout : string!  stdoutBytes : bytes!  stderr : string! }
        @description "std-cli's CLI_DONE for an orb update --urgent run."
      UN_CLI_FAILED { stage : string!  error : string!  code : string! }
        @description "std-cli's CLI_FAILED: orb could not be run."
      UN_LOOKED { requestId : string!  name : string!  versions : [string]!  distTags : Map string string  version : string!  tarballs : Map string string }
        @description "Internal: the package's versions."
      UN_LOOK_REFUSED { requestId : string!  name : string  code : string!  status : number!  error : string! }
        @description "Internal: the lookup failed."
      UN_SATISFIED { requestId : string!  value : boolean! }
        @description "Internal: the satisfies answer."
      UN_COMPARED { requestId : string!  value : number! }
        @description "Internal: the compare answer."
      UN_SEMVER_REFUSED { requestId : string!  operation : string!  reason : string! }
        @description "Internal: std-semver refused."
      Registry.NPM_LOOKED -> UN_LOOKED
      Registry.NPM_LOOKUP_REFUSED -> UN_LOOK_REFUSED
      Versions.SEMVER_SATISFIED -> UN_SATISFIED
      Versions.SEMVER_COMPARED -> UN_COMPARED
      Versions.SEMVER_REFUSED -> UN_SEMVER_REFUSED
      OrbCli.CLI_DONE -> UN_CLI_DONE
      OrbCli.CLI_FAILED -> UN_CLI_FAILED
    }
  }

  page boot as OrbUpdateNoticePage -> OrbUpdateNotice, UpdateRecord, Registry, RegistryHttp, RegistryTimeout, Versions, OrbCli
}
