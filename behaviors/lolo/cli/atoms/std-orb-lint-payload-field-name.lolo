app std-orb-lint-payload-field-name [
  version: "1.0.0",
  inbound: ["cli-lint-payload-field-name"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-payload-field-name — the `orb lint payload-field-name <file>` command, the port of ORB_X_PAYLOAD_FIELD_NAME (payload field names are valid identifiers). It lowers the file with program/read and checks the top-level payload fields of every trait emit and event (nested properties are walked at any depth with tree/fold). Status 500, exit 1. Clean answers `lint payload-field-name: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-payload-field-name"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type PayloadShape = string | number | boolean | [PayloadShape] | Map string PayloadShape
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintPayloadFieldNameOrbital {
  entity OrbLintPayloadFieldNameRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintPayloadFieldName -> OrbLintPayloadFieldNameRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "payload-field-name", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                  (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]")))
                    (let ((roots (array/concat
                      (array/flatten (array/map (object/get @td "emits" []) (fn em (array/map (object/get @em "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".emits(" (object/get @em "event" "") ")") })))))
                      (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "events" []) (fn ev (array/map (object/get @ev "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".events(" (object/get @ev "key" "") ")") }))))))))
                      (array/flatten (array/map @roots (fn x
                        (array/map
                          (tree/fold (object/get @x "f")
                            (fn (n k)
                              (if (validate/array @n)
                                (array/flatten (array/filter @k (fn r (validate/array @r))))
                                (if (validate/object @n)
                                  (let ((nm (object/get @n "name" "")))
                                    (array/concat
                                      (if (or (= @nm "") (!= (str/replace-pattern @nm "^[A-Za-z_][A-Za-z0-9_]*$" "") "")) [{ rel: "", nm: @nm }] [])
                                      (array/map (object/get @k "properties" []) (fn h { rel: (str/concat "." @nm (object/get @h "rel")), nm: (object/get @h "nm") }))))
                                  [])))
                            PayloadShape)
                          (fn h { code: "ORB_X_PAYLOAD_FIELD_NAME", path: (str/concat (object/get @x "w") (object/get @h "rel") "." (object/get @h "nm")), message: (str/concat "Payload field name '" (object/get @h "nm") "' is not a valid TypeScript identifier"), suggestion: "Use a single identifier (letters, digits, underscores; no dot, no space, no leading digit). For a nested shape, declare an object field with nested properties instead of a dotted name.", severity: "error" })))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "payload-field-name" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintPayloadFieldNameCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintPayloadFieldNameCli -> OrbLintPayloadFieldNameRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint payload-field-name <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "payload-field-name") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint payload-field-name: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "payload-field-name") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "payload-field-name")
        (emit LINT_ANSWERED { status: 500, body: "lint payload-field-name: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-payload-field-name" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint payload-field-name` with its arguments and working directory."
        @synonyms "orb lint payload-field-name, orb lint payload-field-name, payload field name"
      OrbLintPayloadFieldName.LINT_FOUND -> LINT_FOUND
      OrbLintPayloadFieldName.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-payload-field-name" as OrbLintPayloadFieldNamePage -> OrbLintPayloadFieldName, OrbLintPayloadFieldNameCli
}
