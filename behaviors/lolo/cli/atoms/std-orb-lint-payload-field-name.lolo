app std-orb-lint-payload-field-name [
  version: "1.0.0",
  inbound: ["cli-lint-payload-field-name"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-payload-field-name — the `orb lint payload-field-name <file>` command, the port of ORB_X_PAYLOAD_FIELD_NAME (payload field names are valid identifiers). It lowers the file with program/read and checks the top-level payload fields of every trait emit and event (nested properties are walked at any depth with tree/fold). Status 500, exit 1. Clean answers `lint payload-field-name: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-payload-field-name"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type PayloadShape = string | number | boolean | [PayloadShape] | Map string PayloadShape
type PayloadFieldEmit = { event : string, payloadSchema : [PayloadShape] }
type PayloadFieldEvent = { key : string, payloadSchema : [PayloadShape] }
type PayloadFieldMachine = { events : [PayloadFieldEvent] }
type PayloadFieldTrait = { name : string, emits : [PayloadFieldEmit], stateMachine : PayloadFieldMachine }
type PayloadFieldOrbital = { name : string, traits : [PayloadFieldTrait] }
type PayloadFieldProgram = { orbitals : [PayloadFieldOrbital] }
type OrbFinding ={ code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

orbital OrbLintPayloadFieldNameOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintPayloadFieldNameRun [runtime] {
    id : string!
    findings : [OrbFinding] = []
  }

  trait OrbLintPayloadFieldName -> OrbLintPayloadFieldNameRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                  (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]")))
                    (let ((roots (array/concat
                      (array/flatten (array/map (object/get @td "emits" []) (fn em (array/map (object/get @em "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".emits(" (object/get @em "event" "") ")") })))))
                      (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "events" []) (fn ev (array/map (object/get @ev "payloadSchema" []) (fn pf { f: @pf, w: (str/concat @tp ".events(" (object/get @ev "key" "") ")") }))))))))
                      (array/flatten (array/map @roots (fn x
                        (array/map
                          (tree/fold (object/get @x "f")
                            (fn (n k)
                              (if (validate/array @n)
                                (array/flatten (array/filter @k (fn r (validate/array @r))))
                                (if (validate/object @n)
                                  (let ((nm0 (object/get @n "name" "")))
                                   (let ((nm (if (validate/string @nm0) @nm0 "")))
                                    (array/concat
                                      (if (or (= @nm "") (!= (str/replace-pattern @nm "^[A-Za-z_][A-Za-z0-9_]*$" "") "")) [{ rel: "", nm: @nm }] [])
                                      (array/map (object/get @k "properties" []) (fn h { rel: (str/concat "." @nm (let ((r0 (object/get @h "rel" ""))) (if (validate/string @r0) @r0 ""))), nm: (let ((n0 (object/get @h "nm" ""))) (if (validate/string @n0) @n0 "")) })))))
                                  [])))
                            PayloadShape)
                          (fn h (let ((rel (let ((r0 (object/get @h "rel" ""))) (if (validate/string @r0) @r0 ""))) (hn (let ((n0 (object/get @h "nm" ""))) (if (validate/string @n0) @n0 "")))) { code: "ORB_X_PAYLOAD_FIELD_NAME", path: (str/concat (object/get @x "w") @rel "." @hn), message: (str/concat "Payload field name '" @hn "' is not a valid TypeScript identifier"), suggestion: "Use a single identifier (letters, digits, underscores; no dot, no space, no leading digit). For a nested shape, declare an object field with nested properties instead of a dotted name.", severity: "error" }))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "payload-field-name", findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PayloadFieldProgram }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintPayloadFieldNameCli -> OrbLintPayloadFieldNameRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint payload-field-name <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "payload-field-name") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint payload-field-name: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "payload-field-name") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint payload-field-name: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-payload-field-name" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint payload-field-name` with its arguments and working directory."
        @synonyms "orb lint payload-field-name, orb lint payload-field-name, payload field name"
      OrbLintPayloadFieldName.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPayloadFieldNameCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPayloadFieldNameOrbitalStart -> OrbLintPayloadFieldName, OrbLintPayloadFieldNameCli, OrbLintInput, Packs, Versions
}
