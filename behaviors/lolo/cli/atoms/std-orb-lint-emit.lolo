app std-orb-lint-emit [
  version: "1.0.0",
  inbound: ["cli-lint-emit"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-emit — the `orb lint emit <file>` command, the port of validate_emit (effect/emit.rs). It lowers the file with program/read and walks the effects of every inline trait transition and tick, descending through the do, if, when and let effect-sequencing forms, and checks each `emit` effect: no event name is CIRCUIT_ORPHAN_EVENT, a string that is not an identifier (a letter, then letters, digits and underscores) is ORB_T_EVT_INVALID_NAME, and a first argument that is an object, a list, a number, a boolean or null is ORB_EFF_EMIT_INVALID_NAME, each with the Rust path, message and suggestion (status 500, exit 1). The emit config blocks of the async operators belong to those operators' own lints. Clean answers `lint emit: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-emit"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type EmitVal = string | number | boolean | [EmitVal?] | Map string EmitVal?
type EmitTransition = { effects : [EmitVal?] }
type EmitMachine = { transitions : [EmitTransition] }
type EmitTick = { effects : [EmitVal?] }
type EmitTrait = { name : string, stateMachine : EmitMachine, ticks : [EmitTick] }
type EmitOrbital = { name : string, traits : [EmitTrait] }
type EmitLeaf = { p : string!, e : EmitVal!, oi : number!, ti : number! }
type EmitProgram = { orbitals : [EmitOrbital] }

orbital OrbLintEmitOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintEmitRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    orbitals : [EmitOrbital] = []
  }

  trait OrbLintEmit -> OrbLintEmitRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get @payload.program "orbitals" []))
        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "emit" @payload.scope), orbitals: (object/get @payload.program "orbitals" []) })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "emit" @entity.scope))
        (set @entity.findings (let ((orbitals @entity.orbitals))
          (let ((ls @payload.leaves))
          (array/flatten (array/map @ls (fn l
            (let ((e (object/get @l "e")) (p (object/get @l "p")))
              (if (not (and (validate/array @e) (> (array/len @e) 0) (= (array/nth @e 0) "emit"))) []
              (if (< (array/len @e) 2)
                [{ code: "CIRCUIT_ORPHAN_EVENT", path: @p, message: "emit requires event name", suggestion: "Use: [\"emit\", \"EVENT_NAME\"]", severity: "error" }]
                (let ((x (array/nth @e 1)))
                  (if (validate/string @x)
                    (if (validate/pattern @x "^[A-Za-z][A-Za-z0-9_]*$") []
                      [{ code: "ORB_T_EVT_INVALID_NAME", path: @p, message: (str/concat "Event name '" @x "' is not a valid identifier"), suggestion: "Declare the event via `type EventName = Event<Payload>` and reference it by identifier", severity: "error" }])
                    (if (or (validate/array @x) (validate/number @x) (validate/boolean @x) (= @x null))
                      [{ code: "ORB_EFF_EMIT_INVALID_NAME", path: @p, message: (str/concat "emit's first argument must be the event name (a string identifier), got " (if (validate/array @x) "a list" (if (validate/number @x) "a number" (if (validate/boolean @x) "a boolean" "null")))), suggestion: "Write `(emit EVENT_NAME)` or `(emit EVENT_NAME { … })` with an event declared in the trait's `emits` block", severity: "error" }]
                      [{ code: "ORB_EFF_EMIT_INVALID_NAME", path: @p, message: "emit's first argument must be the event name, but an object was passed — this looks like the payload with the event name missing", suggestion: "Write `(emit EVENT_NAME { … })` — the event name comes first, then the payload object. The event must be declared in the trait's `emits` block.", severity: "error" }]))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "emit", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      EFFECT_LEAVES_EXPAND -> external { requestId : string!  orbitals : [EmitOrbital]! }
        @description "Ask std-orb-effect-leaves to flatten the effects of every inline trait."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      EFFECT_LEAVES_HEARD { requestId : string!  leaves : [EmitLeaf]! }
        @description "std-orb-effect-leaves's answer: the effects to check, flattened."
      OrbEffectLeaves.EFFECT_LEAVES_EXPANDED -> EFFECT_LEAVES_HEARD
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : EmitProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
  }

  trait OrbLintEmitCli -> OrbLintEmitRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint emit <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "emit") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint emit: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "emit") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint emit: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-emit" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint emit` with its arguments and working directory."
        @synonyms "orb lint emit"
      OrbLintEmit.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEffectLeaves = LeavesUse.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [EmitOrbital]! }
        @description "Flatten the effects of every inline trait."
      OrbLintEmit.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEmitCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEmitOrbitalStart -> OrbLintEmit, OrbLintEmitCli, OrbLintInput, Packs, OrbEffectLeaves, Versions
}
