app std-orb-lint-emit [
  version: "1.0.0",
  inbound: ["cli-lint-emit"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-emit — the `orb lint emit <file>` command, the port of validate_emit (effect/emit.rs). It lowers the file with program/read and walks the effects of every inline trait transition and tick, descending through the do, if, when and let effect-sequencing forms, and checks each `emit` effect: no event name is CIRCUIT_ORPHAN_EVENT, a string that is not an identifier (a letter, then letters, digits and underscores) is ORB_T_EVT_INVALID_NAME, and a first argument that is an object, a list, a number, a boolean or null is ORB_EFF_EMIT_INVALID_NAME, each with the Rust path, message and suggestion (status 500, exit 1). The emit config blocks of the async operators belong to those operators' own lints. The rule asks std-orb-effect-leaves for the emit effects (heads: emit) and reads each one from its flat typed nodes (std-orb-lint-input's OrbLintExprNodes: the event name is the second child, a number, a boolean or null is a literal node carrying its JSON text). Clean answers `lint emit: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-emit"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type EmitTrait = { name : string }
type EmitOrbital = { name : string, traits : [EmitTrait] }
type EmitNode = { k : string!, ks : [number]!, hd : string!, nms : [string]!, rt : string!, nm : string!, pa : [string]!, bd : number!, wh : string!, tx : string!, pv : boolean!, hs : boolean!, sl : [number]!, lb : [number]!, lv : [string]? }
type EmitLeaf = { p : string!, n : [EmitNode]!, oi : number!, ti : number! }
type EmitWalkSlot = { kind : string!, args : [number] }
type EmitWalkProj = { sourceArg : number!, keyArg : number!, defaultArg : number }
type EmitExprItem = { eff : boolean! }
type EmitProgram = { orbitals : [EmitOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintEmitCodes = { circuitOrphanEvent : LintCodeDecl , tEvtInvalidName : LintCodeDecl , effEmitInvalidName : LintCodeDecl }

orbital OrbLintEmitOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses LeavesUse from "std/behaviors/std-orb-effect-leaves"

  entity OrbLintEmitRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    orbitals : [EmitOrbital] = []
  }

  trait OrbLintEmit -> OrbLintEmitRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.orbitals (object/get @payload.program "orbitals" []))
        (emit EFFECT_LEAVES_EXPAND { requestId: (str/concat "emit" @payload.scope), orbitals: (object/get @payload.program "orbitals" []), heads: ["emit"] })
      EFFECT_LEAVES_HEARD -> ready when (= @payload.requestId (str/concat "emit" @entity.scope))
        (set @entity.findings (let ((nn : EmitNode { k: "nil", ks: [], hd: "", nms: [], rt: "", nm: "", pa: [], bd: -1, wh: "", tx: "", pv: false, hs: false, sl: [], lb: [], lv: null })) (array/flatten (array/map @payload.leaves (fn l (let ((n : [EmitNode] (object/get @l "n" [])) (p (object/get @l "p"))) (let ((rti (- (array/len @n) 1)) (rt : EmitNode (default (array/nth @n @rti) @nn))) (let ((rtks : [number] (object/get @rt "ks"))) (let ((rtcr : [number] (array/map (array/range 0 (array/len @rtks)) (fn j (- (+ (- @rti (array/sum @rtks)) (array/sum (array/take @rtks (+ @j 1)))) 1))))) (if (not (and (array/includes ["call", "arr", "proj", "rui"] (object/get @rt "k")) (> (array/len @rtks) 0) (= (default (array/first (default (object/get (default (array/nth @n (default (array/nth @rtcr 0) 0)) @nn) "lv") [])) "") "emit"))) [] (if (< (array/len @rtks) 2) [{ code: @config.codes.circuitOrphanEvent.code, path: @p, message: "emit requires event name", suggestion: "Use: [\"emit\", \"EVENT_NAME\"]", severity: "error" }] (let ((xi (default (array/nth @rtcr 1) 0)) (x : EmitNode (default (array/nth @n @xi) @nn))) (if (or (and (= (object/get @x "k") "nil") (!= (object/get @x "lv") null)) (and (= (object/get @x "k") "bind") (= (object/get @x "wh") "w")) (= (object/get @x "k") "cat")) (let ((txt : string (if (= (object/get @x "k") "nil") (default (array/first (default (object/get @x "lv") [])) "") (if (= (object/get @x "k") "bind") (object/get @x "tx") (object/get (default (array/nth @n (- @xi 1)) @nn) "tx"))))) (if (validate/pattern @txt "^[A-Za-z][A-Za-z0-9_]*$") [] [{ code: @config.codes.tEvtInvalidName.code, path: @p, message: (str/concat "Event name '" @txt "' is not a valid identifier"), suggestion: "Declare the event via `type EventName = Event<Payload>` and reference it by identifier", severity: "error" }])) (if (or (array/includes ["call", "arr", "proj", "rui", "let", "lam"] (object/get @x "k")) (and (= (object/get @x "k") "nil") (= (object/get @x "lv") null) (!= (object/get @x "tx") "") (!= (object/get @x "tx") "true") (!= (object/get @x "tx") "false") (!= (object/get @x "tx") "null")) (and (= (object/get @x "k") "nil") (= (object/get @x "lv") null) (or (= (object/get @x "tx") "true") (= (object/get @x "tx") "false"))) (and (= (object/get @x "k") "nil") (= (object/get @x "lv") null) (= (object/get @x "tx") "null"))) [{ code: @config.codes.effEmitInvalidName.code, path: @p, message: (str/concat "emit's first argument must be the event name (a string identifier), got " (if (array/includes ["call", "arr", "proj", "rui", "let", "lam"] (object/get @x "k")) "a list" (if (and (= (object/get @x "k") "nil") (= (object/get @x "lv") null) (!= (object/get @x "tx") "") (!= (object/get @x "tx") "true") (!= (object/get @x "tx") "false") (!= (object/get @x "tx") "null")) "a number" (if (and (= (object/get @x "k") "nil") (= (object/get @x "lv") null) (or (= (object/get @x "tx") "true") (= (object/get @x "tx") "false"))) "a boolean" "null")))), suggestion: "Write `(emit EVENT_NAME)` or `(emit EVENT_NAME { … })` with an event declared in the trait's `emits` block", severity: "error" }] [{ code: @config.codes.effEmitInvalidName.code, path: @p, message: "emit's first argument must be the event name, but an object was passed — this looks like the payload with the event name missing", suggestion: "Write `(emit EVENT_NAME { … })` — the event name comes first, then the payload object. The event must be declared in the trait's `emits` block.", severity: "error" }]))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "emit", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      EFFECT_LEAVES_EXPAND -> external { requestId : string!  orbitals : [EmitOrbital]!  heads : [string]! }
        @description "Ask std-orb-effect-leaves to flatten the effects of every inline trait."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      EFFECT_LEAVES_HEARD { requestId : string!  leaves : [EmitLeaf]! }
        @description "std-orb-effect-leaves's answer: the effects to check, flattened."
      OrbEffectLeaves.EFFECT_LEAVES_EXPANDED -> EFFECT_LEAVES_HEARD
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : EmitProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintEmitCodes = { circuitOrphanEvent: { code: "CIRCUIT_ORPHAN_EVENT", category: "circuit", description: "An action or emit raises an event that has no transition handler" }, tEvtInvalidName: { code: "ORB_T_EVT_INVALID_NAME", category: "trait", description: "An event name is not a valid UPPER_SNAKE_CASE identifier" }, effEmitInvalidName: { code: "ORB_EFF_EMIT_INVALID_NAME", category: "effect", description: "The event name inside an emit effect is not a valid string event name" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintEmitCli -> OrbLintEmitRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint emit <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint emit <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "emit") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint emit: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "emit") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint emit: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-emit" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint emit` with its arguments and working directory."
        @synonyms "orb lint emit"
      OrbLintEmit.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbEffectLeaves = LeavesUse.traits.OrbEffectLeaves {
    listens {
      EFFECT_LEAVES_EXPAND { requestId : string!  orbitals : [EmitOrbital]!  heads : [string]! }
        @description "Flatten the effects of every inline trait whose head is asked."
      LINT_EXPR_NODES { requestId : string!  nodes : [[EmitNode]]! }
        @description "std-orb-lint-input's LINT_EXPR_NODES: the flat typed nodes of each asked effect."
      OrbLintEmit.EFFECT_LEAVES_EXPAND -> EFFECT_LEAVES_EXPAND
      OrbLintExprNodes.LINT_EXPR_NODES -> LINT_EXPR_NODES
    }
  }
  trait OrbLintExprNodes = Input.traits.OrbLintExprNodes {
    listens {
      LINT_OPERATOR_NAMES { names : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_NAMES: every installed operator name, the recognized call heads."
      LINT_OPERATOR_SEMANTICS { functions : [string]!  busExcluded : [string]!  targetOptions : [string]!  emitSlots : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the operators whose result is a function (a lambda form)."
      LINT_OPERATOR_WALK { slots : Map string EmitWalkSlot!  projections : Map string EmitWalkProj! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots and field projections."
      LINT_EXPR_ASK { requestId : string!  items : [EmitExprItem]! }
        @description "A rule asks to flatten expressions."
      OrbLintInput.LINT_OPERATOR_NAMES -> LINT_OPERATOR_NAMES
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> LINT_OPERATOR_SEMANTICS
      OrbLintInput.LINT_OPERATOR_WALK -> LINT_OPERATOR_WALK
      OrbEffectLeaves.LINT_EXPR_ASK -> LINT_EXPR_ASK
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintEmitCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintEmitOrbitalStart -> OrbLintEmit, OrbLintEmitCli, OrbLintInput, Packs, OrbEffectLeaves, OrbLintExprNodes, Versions
}
