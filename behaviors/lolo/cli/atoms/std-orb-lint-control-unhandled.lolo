app std-orb-lint-control-unhandled [
  version: "1.0.0",
  inbound: ["cli-lint-control-unhandled"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-control-unhandled - the `orb lint control-unhandled <file>` command, the port of validate_controls_handled (final_program.rs, G-ORB-187), the `orb validate --final` rule: a control event that a trait's rendered patterns fire (std-orb-fired-events' byControl, which already drops provably false branches and bus-excluded names) reaches the rendering trait and every trait that embeds it, directly or transitively through any referrer (std-orb-embed-chain's embedders) plus every `listens` route out of them. A control none of those handle, by a transition of the trait or a host, or by a listens route (an `any` source, or a trait or orbital source naming one of them, on the orbital or on any trait), does nothing when operated: ORB_EMIT_CONTROL_UNHANDLED at orbitals.<O>.traits.<T>. An event named by an emits entry carrying a definerKnob is the atom offering an affordance and is exempt. The finding reads its code from the rule's `codes` knob. Clean answers `lint control-unhandled: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-control-unhandled"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type EmbedMap = Map string [string]
type FiredControl = { event : string!, sites : [string]! }
type CuSource = { kind : string, trait : string, orbital : string }
type CuListen = { event : string, source : CuSource }
type CuEmit = { event : string, definerKnob : string, scope : string, scopeOverridden : boolean }
type CnExpr = string | number | boolean | [CnExpr?] | Map string CnExpr?
type CnStr = string
type CnKids = Map string CnFacts?
type CnFacts = { cons : boolean!, ui : boolean!, ft : boolean!, sets : [string]!, emits : [string]!, refs : [string]!, rrefs : [string]! }
type CnArm = { event : string!, facts : CnFacts! }
type CnTraitArms = { name : string!, arms : [CnArm]! }
type CnQuiet = { orbital : string!, trait : string!, event : string!, sites : [string]!, handler : string! }
type CuTransition = { event : string, effects : [CnExpr?] }
type CuMachine = { transitions : [CuTransition] }
type CuTrait = { name : string, emits : [CuEmit], listens : [CuListen], stateMachine : CuMachine }
type CuOrbital = { name : string, traits : [CuTrait], listens : [CuListen] }
type CuProgram = { orbitals : [CuOrbital] }
type LintCodeDecl = { code : string!, category : string!, description : string! }
type ControlUnhandledCodes = { controlUnhandled : LintCodeDecl, controlNoConsequence : LintCodeDecl }
type CuUnhandled = { orbital : string!, trait : string!, event : string!, sites : [string]!, forwarded : boolean! }
type CuForward = { orbital : string!, trait : string!, event : string!, via : [string]! }

type WalkSlot = { kind : string!, args : [number] }
orbital OrbLintControlUnhandledOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses Fired from "std/behaviors/std-orb-fired-events"
  uses Chain from "std/behaviors/std-orb-embed-chain"

  entity OrbLintControlUnhandledRun [runtime] {
    id : string!
    scope : string = ""
    program : CuProgram! = {}
    controls : Map string [FiredControl] = {}
    bridged : Map string [string] = {}
    chains : [EmbedMap] = []
    haveFired : boolean = false
    haveChains : boolean = false
    unhandled : [CuUnhandled] = []
    quiet : [CnQuiet] = []
    findings : [OrbFinding] = []
    forwards : [CuForward] = []
  }

  trait OrbLintControlUnhandled -> OrbLintControlUnhandledRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.program @payload.program)
      FIRED_HEARD -> ready when @entity.haveChains
        (set @entity.scope @payload.scope)
        (set @entity.controls @payload.controls)
        (set @entity.bridged @payload.bridged)
        (set @entity.haveFired true)
        (emit LINT_COMPUTE { })
      FIRED_HEARD -> ready when (not @entity.haveChains)
        (set @entity.scope @payload.scope)
        (set @entity.controls @payload.controls)
        (set @entity.bridged @payload.bridged)
        (set @entity.haveFired true)
      CHAINS_HEARD -> ready when @entity.haveFired
        (set @entity.chains @payload.embedders)
        (set @entity.haveChains true)
        (emit LINT_COMPUTE { })
      CHAINS_HEARD -> ready when (not @entity.haveFired)
        (set @entity.chains @payload.embedders)
        (set @entity.haveChains true)
      LINT_COMPUTE -> ready
        (set @entity.unhandled (let ((orbitals (object/get @entity.program "orbitals" [])) (bc @entity.controls) (br @entity.bridged) (chains @entity.chains)) (let ((allListens (array/flatten (array/map @orbitals (fn o (array/concat (object/get @o "listens" []) (array/flatten (array/map (object/get @o "traits" []) (fn t (object/get @t "listens" [])))))))))) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((o (default (array/nth @orbitals @oi) {}))) (let ((ts (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine")))) (bridgedAll (array/flatten (array/map (object/get @o "traits" []) (fn t (object/get @br (object/get @t "name" "") []))))) (chain (default (array/nth @chains @oi) {}))) (array/flatten (array/map @ts (fn t (let ((tn (object/get @t "name" ""))) (let ((scope (array/concat [@tn] (object/get @chain @tn []))) (knobs (array/map (array/filter (object/get @t "emits" []) (fn e (!= (object/get @e "definerKnob" "") ""))) (fn e (object/get @e "event" ""))))) (array/flatten (array/map (object/get @bc @tn []) (fn cc (let ((ev (object/get @cc "event" ""))) (if (or (= @ev "") (array/includes @bridgedAll @ev) (str/startsWith @ev (quote "@")) (array/includes @knobs @ev) (array/some @ts (fn x (and (array/includes @scope (object/get @x "name" "")) (array/some (object/get (object/get @x "stateMachine" {}) "transitions" []) (fn tr (= (object/get @tr "event" "") @ev)))))) (array/some @allListens (fn l (and (= (object/get @l "event" "") @ev) (let ((src (object/get @l "source" {}))) (let ((k (object/get @src "kind" ""))) (or (= @k "any") (and (array/includes ["trait" "orbital"] @k) (array/includes @scope (object/get @src "trait" "")))))))))) [] [{ orbital: (object/get @o "name" ""), trait: @tn, event: @ev, sites: (object/get @cc "sites"), forwarded: (array/some (object/get @t "emits" []) (fn e (and (= (object/get @e "event" "") @ev) (= (object/get @e "scope" "") "external") (= (object/get @e "scopeOverridden" false) true)))) }]))))))))))))))))))
        (set @entity.quiet (let ((orbitals (object/get @entity.program "orbitals" [])) (bc @entity.controls) (br @entity.bridged) (chains @entity.chains)) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((o (default (array/nth @orbitals @oi) {}))) (let ((ts (array/filter (object/get @o "traits" []) (fn t (object/has @t "stateMachine")))) (bridgedAll (array/flatten (array/map (object/get @o "traits" []) (fn t (object/get @br (object/get @t "name" "") []))))) (chain (default (array/nth @chains @oi) {}))) (let ((tarms : [CnTraitArms] (array/map @ts (fn t { name: (object/get @t "name" ""), arms: (array/map (object/get (object/get @t "stateMachine" {}) "transitions" []) (fn tr { event: (object/get @tr "event" ""), facts: (let ((nF : CnFacts { cons: false, ui: false, ft: false, sets: [], emits: [], refs: [], rrefs: [] })) (default (tree/fold (object/get @tr "effects" []) (fn (n k) (if (not (validate/array @n)) (if (and (validate/string @n) (str/startsWith (default (as @n CnStr) "") (quote "@entity."))) (let ((leaf : CnFacts { cons: false, ui: false, ft: false, sets: [], emits: [], refs: [(default (as @n CnStr) "")], rrefs: [] })) @leaf) (let ((km : CnKids (default (as @k CnKids) {})) (noRefs : [string] [])) (let ((mapped : CnFacts { cons: false, ui: false, ft: false, sets: [], emits: [], refs: (array/flatten (array/map (object/values @km) (fn q (if (= @q null) @noRefs (object/get @q "refs" @noRefs))))), rrefs: [] })) @mapped))) (let ((len : number (array/len @n)) (hd : string (if (and (> (array/len @n) 0) (validate/string (array/nth @n 0))) (default (as (array/nth @n 0) CnStr) "") "")) (a1 : string (if (and (> (array/len @n) 1) (validate/string (array/nth @n 1))) (default (as (array/nth @n 1) CnStr) "") "")) (kk : [CnFacts] (array/map @k (fn q (if (= @q null) @nF @q))))) (let ((kr : [string] (array/flatten (array/map (array/filter (array/range 0 @len) (fn i (or (!= @hd "set") (>= @i 2)))) (fn i (object/get (default (array/nth @kk @i) @nF) "refs" []))))) (r : boolean (= @hd "render-ui"))) (let ((out : CnFacts { ui: (or (= @hd "render-ui") (array/some @kk (fn x (object/get @x "ui" false)))), ft: (or (= @hd "fetch") (array/some @kk (fn x (object/get @x "ft" false)))), cons: (or (array/includes ["persist" "call-service" "navigate" "navigate-back"] @hd) (str/startsWith @hd "os/") (str/startsWith @hd "program/") (array/some @kk (fn x (object/get @x "cons" false)))), sets: (array/concat (if (and (= @hd "set") (str/startsWith @a1 (quote "@entity."))) [(default (array/nth (str/split @a1 ".") 1) "")] []) (array/flatten (array/map @kk (fn x (object/get @x "sets" []))))), emits: (array/concat (if (and (= @hd "emit") (!= @a1 "")) [@a1] []) (array/flatten (array/map @kk (fn x (object/get @x "emits" []))))), refs: (if @r [] @kr), rrefs: (array/concat (if @r @kr []) (array/flatten (array/map @kk (fn x (object/get @x "rrefs" []))))) })) @out))))) "CnExpr") @nF)) })) })))) (let ((shown (array/unique (array/map (array/flatten (array/map @tarms (fn ta (array/flatten (array/map (object/get @ta "arms" []) (fn a (object/get (object/get @a "facts") "rrefs" []))))))) (fn s (default (array/nth (str/split @s ".") 1) "")))))) (array/flatten (array/map @ts (fn t (let ((tn (object/get @t "name" ""))) (let ((scope (array/concat [@tn] (object/get @chain @tn []))) (knobs (array/map (array/filter (object/get @t "emits" []) (fn e (!= (object/get @e "definerKnob" "") ""))) (fn e (object/get @e "event" "")))) (arms : [CnArm] [])) (array/flatten (array/map (object/get @bc @tn []) (fn cc (let ((ev (object/get @cc "event" ""))) (let ((hits (array/flatten (array/map (array/filter @tarms (fn ta (array/includes @scope (object/get @ta "name" "")))) (fn ta (array/map (array/filter (object/get @ta "arms" []) (fn a (= (object/get @a "event") @ev))) (fn a { event: @ev, facts: (object/get @a "facts") }))))))) (if (or (= @ev "") (str/startsWith @ev (quote "@")) (= (array/len @hits) 0) (array/some @hits (fn a (let ((f (object/get @a "facts"))) (or (object/get @f "cons" false) (object/get @f "ui" false) (object/get @f "ft" false) (> (array/len (object/get @f "emits" [])) 0) (array/some (object/get @f "sets" []) (fn x (array/includes @shown @x)))))))) [] [{ orbital: (object/get @o "name" ""), trait: @tn, event: @ev, sites: (object/get @cc "sites"), handler: (default (array/first (array/map (array/filter @tarms (fn ta (array/some (object/get @ta "arms" []) (fn a (= (object/get @a "event") @ev))))) (fn ta (object/get @ta "name" "")))) @tn) }]))))))))))))))))))))
        (set @entity.findings (array/concat (array/map @entity.unhandled (fn u { code: @config.codes.controlUnhandled.code, path: (str/concat "orbitals." (object/get @u "orbital") ".traits." (object/get @u "trait")), message: (str/concat "A control rendered by '" (object/get @u "trait") "' (" (str/join (object/get @u "sites") ", ") ") fires '" (object/get @u "event") "', which no transition of '" (object/get @u "trait") "' or an embedder of it handles and no `listens` routes"), suggestion: (str/concat "Handle '" (object/get @u "event") "' in '" (object/get @u "trait") "' (or the trait that embeds it), route it with `listens`, or remove the control"), severity: "error" })) (array/map @entity.quiet (fn q { code: @config.codes.controlNoConsequence.code, path: (str/concat "orbitals." (object/get @q "orbital") ".traits." (object/get @q "trait")), message: (str/concat "control " (str/join (object/get @q "sites") ", ") " emits " (object/get @q "event") ", whose handler in " (object/get @q "handler") " changes nothing the app or the viewer can observe"), suggestion: (str/concat "Make '" (object/get @q "event") "' persist, fetch, navigate, emit an event, render, or set a field a render reads, or remove the control"), severity: "error" }))))
        (set @entity.forwards (array/map (array/filter @entity.unhandled (fn u (object/get @u "forwarded"))) (fn u { orbital: (object/get @u "orbital"), trait: (object/get @u "trait"), event: (object/get @u "event"), via: (object/get @u "sites") })))
        (set @entity.haveFired false)
        (set @entity.haveChains false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "control-unhandled", scope: @entity.scope, findings: @entity.findings })
        (emit CONTROLS_FORWARDED { scope: @entity.scope, forwards: @entity.forwards })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      CONTROLS_FORWARDED -> external { scope : string!  forwards : [CuForward]! }
        @description "The unhandled controls a trait leaves on purpose: its composer declared `emitsScope external` for the event, so an embedding organism handles it. Offered to a describe of the behavior."
        @tier "internal"
      LINT_COMPUTE { }
        @description "Internal: both the fired events and the embed chains are in, compute the findings."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    config {
      codes : ControlUnhandledCodes = { controlUnhandled: { code: "ORB_EMIT_CONTROL_UNHANDLED", category: "emit", description: "A rendered control fires an event nothing handles or routes." }, controlNoConsequence: { code: "ORB_CONTROL_NO_CONSEQUENCE", category: "emit", description: "A rendered control fires an event whose handlers change nothing the app or the viewer can observe." } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CuProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      FIRED_HEARD { scope : string!  controls : Map string [FiredControl]!  bridged : Map string [string]! }
        @description "std-orb-fired-events' FIRED_EVENTS: the events each trait fires by a control or by an effect."
      CHAINS_HEARD { scope : string!  chains : [EmbedMap]!  embedders : [EmbedMap]! }
        @description "std-orb-embed-chain's EMBED_CHAINS: per orbital, each trait's host names."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      OrbFiredEvents.FIRED_EVENTS -> FIRED_HEARD
      OrbEmbedChain.EMBED_CHAINS -> CHAINS_HEARD
    }
  }

  trait OrbLintControlUnhandledCli -> OrbLintControlUnhandledRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint control-unhandled <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (let ((argFile (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")))) (if (= @argFile null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint control-unhandled <file>" }) (emit LINT_REQUEST { file: @argFile })))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "control-unhandled") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint control-unhandled: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "control-unhandled") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint control-unhandled: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-control-unhandled" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint control-unhandled` with its arguments and working directory."
        @synonyms "orb lint control-unhandled"
      OrbLintControlUnhandled.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait OrbFiredEvents = Fired.traits.OrbFiredEvents {
    listens {
      FIRED_PROPS_HEARD { names : [string]!  maps : [string]!  listens : Map string [string]! }
        @description "std-orb-lint-input's LINT_EVENT_PROPS: the event-bearing prop names of the installed pattern registry."
      FIRED_SEMANTICS_HEARD { functions : [string]!  busExcluded : [string]!  targetOptions : [string]! }
        @description "std-orb-lint-input's LINT_OPERATOR_SEMANTICS: the function-returning operators."
      FIRED_WALK_HEARD { slots : Map string WalkSlot! }
        @description "std-orb-lint-input's LINT_OPERATOR_WALK: each operator's value-source slots."
      FIRED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
      OrbLintInput.LINT_EVENT_PROPS -> FIRED_PROPS_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> FIRED_SEMANTICS_HEARD
      OrbLintInput.LINT_OPERATOR_WALK -> FIRED_WALK_HEARD
      OrbLintInput.LINT_INPUT -> FIRED_INPUT_HEARD
    }
  }
  trait OrbEmbedChain = Chain.traits.OrbEmbedChain {
    listens {
      EMBED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
      OrbLintInput.LINT_INPUT -> EMBED_INPUT_HEARD
      EMBED_INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads and binding roots each inline trait uses."
      OrbLintInput.LINT_INDEX -> EMBED_INDEX_HEARD
    }
  }
  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintControlUnhandledCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintControlUnhandledOrbitalStart -> OrbLintControlUnhandled, OrbLintControlUnhandledCli, OrbLintInput, OrbFiredEvents, OrbEmbedChain, Packs, Versions
}
