app std-orb-embed-chain [
  version: "1.0.0",
  description: "std-orb-embed-chain — the one place a lint run decides which traits embed which, the port of the compiler's EmbedGraph host chain (phases/program/embed_graph.rs, embed_host_name_chain). For every orbital of the lowered program it finds each inline trait's direct host (the first trait, in program order, whose config defaults, transition guards and effects, or tick guards and effects reference it as `@trait.<Name>`; a trait never hosts itself) and answers EMBED_CHAINS { scope, chains } with one map per orbital, in the program's orbital order, from each inline trait name to its host names innermost first (cycle-guarded). A rule that asks whether a trait is embedded under another composes this trait and reads EMBED_CHAINS; it never walks references itself."
]
uses Spec from "almadar-std/embed-chain"
type FiredNode = string | number | boolean | [FiredNode?] | Map string FiredNode?
type FiredField = { default : FiredNode? }
type FiredTransition = { event : string, guard : FiredNode?, effects : [FiredNode?] }
type FiredTick = { guard : FiredNode?, effects : [FiredNode?] }
type FiredMachine = { transitions : [FiredTransition] }
type FiredTrait = { name : string, stateMachine : FiredMachine, ticks : [FiredTick], config : Map string FiredField? }
type FiredOrbital = { traits : [FiredTrait] }
type FiredProgram = { orbitals : [FiredOrbital] }
type RedNodes = [FiredNode?]
type EmbedMap = Map string [string]

orbital OrbEmbedChainOrbital {
  entity OrbEmbedChainRun [runtime] {
    id : string!
    roots : Map string [string] = {}
  }

  trait OrbEmbedChain -> OrbEmbedChainRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      EMBED_INDEX_HEARD -> ready
        (set @entity.roots @payload.roots)
      EMBED_INPUT_HEARD -> ready
        (let ((nr : [string] []))
          (let ((res (let ((orbs (object/get @payload.program "orbitals" []))) (array/map (array/range 0 (array/len @orbs)) (fn oi (let ((o (array/nth @orbs @oi)))
          (let ((trs0 (object/get @o "traits" []))) (let ((inlK (array/filter (array/range 0 (array/len @trs0)) (fn i (object/has (array/nth @trs0 @i) "stateMachine"))))) (let ((inl (array/map @inlK (fn i (array/nth @trs0 @i)))))
            (let ((names (array/map @inl (fn t (object/get @t "name" ""))))
                  (pairs (array/flatten (array/map (array/range 0 (array/len @inl)) (fn kx
                    (let ((t (array/nth @inl @kx))) (let ((tn (object/get @t "name" "")))
                      (let ((gt (array/includes (object/get @entity.roots (str/concat @oi "-" (array/nth @inlK @kx)) []) (quote "@trait")))) (let ((roots (if @gt (array/concat (array/concat
                                      (array/map (object/values (object/get @t "config" {})) (fn f { x: (object/get (default @f {}) "default" null) }))
                                      (array/flatten (array/map (object/get @t "stateMachine.transitions" []) (fn x [{ x: (object/get @x "guard" null) }, { x: (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) }]))))
                                      (array/flatten (array/map (object/get @t "ticks" []) (fn x [{ x: (object/get @x "guard" null) }, { x: (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) }])))) [])))
                        (if @gt
                          (let ((fr (tree/fold @roots (fn (n k)
  (if (validate/array @n) (array/flatten (array/map @k (fn r (if (= @r null) @nr @r))))
    (if (validate/object @n) (array/flatten (array/map (object/values @k) (fn r (if (= @r null) @nr @r))))
      (if (and (validate/string @n) (str/startsWith @n (quote "@trait."))) [(array/first (str/split (array/first (str/split (str/slice @n 7 (str/len @n)) ".")) "["))] @nr)))) "FiredNode")))
                            (array/map (array/filter (array/unique (default @fr [])) (fn c (and (!= @c "") (!= @c @tn)))) (fn c [@c, @tn])))
                          []))))))))))
              (let ((hosts (default (object/fromEntries (array/reverse @pairs)) {})))
                (let ((chains (object/fromEntries (array/map @names (fn nm [@nm, (object/get (array/reduce (array/range 0 (+ (array/len @names) 1)) { cur: @nm, ch: (array/drop @names (array/len @names)), stop: false } (fn (acc i) (if (object/get @acc "stop") @acc (let ((h (object/get @hosts (object/get @acc "cur") ""))) (if (or (= @h "") (= @h @nm) (array/includes (object/get @acc "ch") @h)) { cur: (object/get @acc "cur"), ch: (object/get @acc "ch"), stop: true } { cur: @h, ch: (array/append (object/get @acc "ch") @h), stop: false}))))) "ch")])))))
                  (let ((emb (object/fromEntries (array/map @names (fn nm [@nm, (array/filter (object/get (array/reduce (array/range 0 (+ (array/len @names) 1)) { seen: [@nm] } (fn (acc i) { seen: (array/unique (array/concat (object/get @acc "seen") (array/flatten (array/map (object/get @acc "seen") (fn s (array/map (array/filter @pairs (fn p (= (array/first @p) @s))) (fn p (array/nth @p 1)))))))) }) ) "seen") (fn x (!= @x @nm)))]))))) { c: (default @chains {}), e: (default @emb {}) }))))))))))) )) (emit EMBED_CHAINS { scope: @payload.scope, chains: (array/map @res (fn r (object/get @r "c"))), embedders: (array/map @res (fn r (object/get @r "e"))) })))
    }

    emits {
      EMBED_CHAINS -> external { scope : string!  chains : [EmbedMap]!  embedders : [EmbedMap]! }
        @description "Per orbital, in program order: each inline trait's host names, innermost first."
        @tier "internal"
    }

    listens {
      EMBED_INPUT_HEARD { file : string!  raw : string!  latin : boolean!  program : FiredProgram  scope : string! }
        @description "std-orb-lint-input's LINT_INPUT: the lowered program."
      EMBED_INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads and binding roots each inline trait uses; a trait is searched for @trait references only when its roots hold @trait."
    }
  }

  page boot as OrbEmbedChainOrbitalStart -> OrbEmbedChain
}
