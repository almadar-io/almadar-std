app std-orb-lint-generic-types [
  version: "1.0.0",
  inbound: ["cli-lint-generic-types"],
  fs: { cwd: "**": [read] },
  description: "std-orb-lint-generic-types - the `orb lint generic-types <file>` command, the port of ORB_T_GENERIC_TYPE_DEPRECATED. It lowers the file with program/read and reports every inline trait config knob typed json, any or scalar (or a list of them) and every emit payload field typed json, any, scalar or shapeless object, with its path and suggestion (status 500, exit 1). Top-level entity fields, the orbital types map and event payloads are checked; nested properties and array items are not walked. Clean answers `lint generic-types: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-generic-types"
type OrbCommandArgs = { argv : [string]!, cwd : string! }

orbital OrbLintGenericTypesOrbital {
  entity OrbLintGenericTypesRun [runtime] {
    id : string!
    findings : [string] = []
  }

  trait OrbLintGenericTypes -> OrbLintGenericTypesRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_RUN -> reading
        (set @entity.findings [])
        (os/read-file { anchor: "cwd" path: @payload.file } { key: "file" emit: { success: LINT_FILE_READ, failure: LINT_FILE_UNREAD } })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "generic-types", findings: @entity.findings })
    }

    state reading {
      INIT -> reading
      LINT_FILE_READ -> reading
        (program/read (bytes/to-string @payload.data) { emit: { success: LINT_PROGRAM_READ, failure: LINT_FILE_UNREAD } })
      LINT_PROGRAM_READ -> ready
        (set @entity.findings (let ((orbitals (object/get @payload.result "orbitals")))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((orb (array/nth @orbitals @oi)))
              (array/concat
                (array/concat
                  (array/flatten (array/map (array/filter (array/concat [(object/get @orb "entity" {})] (object/get @orb "auxiliaryEntities" [])) (fn xe (validate/object @xe))) (fn en
                    (array/flatten (array/map (object/get @en "fields" []) (fn f
                      (if (and (= (object/get @f "type" "") "object") (not (object/has @f "items")) (= (array/len (object/keys (object/get @f "properties" {}))) 0)) [(str/concat "[ORB_T_GENERIC_TYPE_DEPRECATED] " (str/concat "entities." (object/get @en "name" "") ".fields." (object/get @f "name" "<unnamed>")) ": Entity field declares the generic type 'object (no declared properties — authored `object`/`json`)' — generic types (`json`, shapeless `object`, `any`, `scalar`) are not allowed in a declaration position.\n  suggestion: Replace the generic type: renderable content → `node`; structured data → an inline `{ k: T }` shape, a named `type` alias, or `Map K V`; a value of several kinds → a named tagged-union `type` alias (or the concrete primitive); the row of an entity a config knob names → `@entity @config.<knob>`; the row of the linked entity → `@entity @config.<knob>`; genuinely polymorphic atoms → a declared type parameter.")] [])))))))
                  (let ((tys (object/get @orb "types" {})))
                    (array/flatten (array/map (object/keys @tys) (fn al
                      (array/flatten (array/map (object/get @tys @al) (fn pf
                        (let ((ty (object/get @pf "type" ""))) (if (and (not (object/has @pf "items")) (or (= @ty "json") (= @ty "any") (= @ty "scalar") (= @ty "[json]") (= @ty "[any]") (= @ty "[scalar]") (and (= @ty "object") (= (array/len (object/get @pf "properties" [])) 0)))) [(str/concat "[ORB_T_GENERIC_TYPE_DEPRECATED] " (str/concat "orbitals[" @oi "].types." @al "." (object/get @pf "name" "")) ": Payload field declares the generic type '" (if (= @ty "object") "object (no declared properties)" @ty) "' — generic types (`json`, shapeless `object`, `any`, `scalar`) are not allowed in a declaration position.\n  suggestion: Replace the generic type: renderable content → `node`; structured data → an inline `{ k: T }` shape, a named `type` alias, or `Map K V`; a value of several kinds → a named tagged-union `type` alias (or the concrete primitive); the row of an entity a config knob names → `@entity @config.<knob>`; the row of the linked entity → `@entity @config.<knob>`; genuinely polymorphic atoms → a declared type parameter.")] []))))))))))
                (array/flatten (array/map (array/range 0 (array/len (object/get @orb "traits" []))) (fn ti
                  (let ((td (array/nth (object/get @orb "traits" []) @ti)))
                    (let ((tp (str/concat "orbitals[" @oi " (" (object/get @orb "name" "") ")].traits[" @ti " (" (object/get @td "name" "") ")]"))
                          (cfg (object/get @td "config" {})))
                      (array/concat
                        (array/concat
                          (array/flatten (array/map (object/keys @cfg) (fn k
                            (let ((ty (object/get (object/get @cfg @k) "type" "")))
                              (if (or (= @ty "json") (= @ty "any") (= @ty "scalar") (= @ty "[json]") (= @ty "[any]") (= @ty "[scalar]"))
                                [(str/concat "[ORB_T_GENERIC_TYPE_DEPRECATED] " @tp ".config." @k ": Config field declares the generic type '" @ty "' — generic types (`json`, shapeless `object`, `any`, `scalar`) are not allowed in a declaration position.\n  suggestion: Replace the generic type: renderable content → `node`; structured data → an inline `{ k: T }` shape, a named `type` alias, or `Map K V`; a value of several kinds → a named tagged-union `type` alias (or the concrete primitive); the row of an entity a config knob names → `@entity @config.<knob>`; the row of the linked entity → `@entity @config.<knob>`; genuinely polymorphic atoms → a declared type parameter.")]
                                [])))))
                          (array/flatten (array/map (object/get @td "emits" []) (fn em
                            (array/flatten (array/map (object/get @em "payloadSchema" []) (fn pf
                              (let ((ty (object/get @pf "type" ""))) (if (and (not (object/has @pf "items")) (or (= @ty "json") (= @ty "any") (= @ty "scalar") (= @ty "[json]") (= @ty "[any]") (= @ty "[scalar]") (and (= @ty "object") (= (array/len (object/get @pf "properties" [])) 0)))) [(str/concat "[ORB_T_GENERIC_TYPE_DEPRECATED] " (str/concat @tp ".emits." (object/get @em "event" "") "." (object/get @pf "name" "")) ": Payload field declares the generic type '" (if (= @ty "object") "object (no declared properties)" @ty) "' — generic types (`json`, shapeless `object`, `any`, `scalar`) are not allowed in a declaration position.\n  suggestion: Replace the generic type: renderable content → `node`; structured data → an inline `{ k: T }` shape, a named `type` alias, or `Map K V`; a value of several kinds → a named tagged-union `type` alias (or the concrete primitive); the row of an entity a config knob names → `@entity @config.<knob>`; the row of the linked entity → `@entity @config.<knob>`; genuinely polymorphic atoms → a declared type parameter.")] [])))))))))
                        (array/flatten (array/map (object/get (object/get @td "stateMachine" {}) "events" []) (fn ev
                          (array/flatten (array/map (object/get @ev "payloadSchema" []) (fn pf
                            (let ((ty (object/get @pf "type" ""))) (if (and (not (object/has @pf "items")) (or (= @ty "json") (= @ty "any") (= @ty "scalar") (= @ty "[json]") (= @ty "[any]") (= @ty "[scalar]") (and (= @ty "object") (= (array/len (object/get @pf "properties" [])) 0)))) [(str/concat "[ORB_T_GENERIC_TYPE_DEPRECATED] " (str/concat @tp ".events." (object/get @ev "key" "") "." (object/get @pf "name" "")) ": Payload field declares the generic type '" (if (= @ty "object") "object (no declared properties)" @ty) "' — generic types (`json`, shapeless `object`, `any`, `scalar`) are not allowed in a declaration position.\n  suggestion: Replace the generic type: renderable content → `node`; structured data → an inline `{ k: T }` shape, a named `type` alias, or `Map K V`; a value of several kinds → a named tagged-union `type` alias (or the concrete primitive); the row of an entity a config knob names → `@entity @config.<knob>`; the row of the linked entity → `@entity @config.<knob>`; genuinely polymorphic atoms → a declared type parameter.")] [])))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FILE_UNREAD -> ready
        (emit LINT_UNREAD { rule: "generic-types" })
    }

    emits {
      LINT_UNREAD -> external { rule : string! }
        @description "This rule could not read or lower the file."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "The lint request this trait answers, from the cli trait or the umbrella."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FILE_READ { data : bytes! }
        @description "The file read."
        @tier "internal"
      LINT_FILE_UNREAD { error : string }
        @description "The file could not be read or lowered."
        @tier "internal"
      LINT_PROGRAM_READ { result : string }
        @description "The file lowered by program/read."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      OrbLintGenericTypesCli.LINT_RUN -> LINT_RUN
    }
  }

  trait OrbLintGenericTypesCli -> OrbLintGenericTypesRun [integration] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint generic-types <file>" })
      LINT_CALLED -> waiting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "generic-types") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint generic-types: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "generic-types") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join @payload.findings "\n") })
      LINT_UNREAD -> ready when (= @payload.rule "generic-types")
        (emit LINT_ANSWERED { status: 500, body: "lint generic-types: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the rule trait to lint this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [string]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_UNREAD -> external { rule : string! }
        @description "The rule trait could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-generic-types" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint generic-types` with its arguments and working directory."
        @synonyms "orb lint generic-types, duplicate field names"
      OrbLintGenericTypes.LINT_FOUND -> LINT_FOUND
      OrbLintGenericTypes.LINT_UNREAD -> LINT_UNREAD
    }
  }

  page "/orb-lint-generic-types" as OrbLintGenericTypesPage -> OrbLintGenericTypes, OrbLintGenericTypesCli
}
