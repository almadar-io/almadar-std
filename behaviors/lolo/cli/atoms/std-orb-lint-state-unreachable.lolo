app std-orb-lint-state-unreachable [
  version: "1.0.0",
  inbound: ["cli-lint-state-unreachable"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-state-unreachable — the `orb lint state-unreachable <file>` command, the port of ORB_T_STATE_UNREACHABLE (trait_validator.rs validate_state_machine). It lowers the file with program/read and, for every inline trait with an initial state, follows the transition edges from the first initial state (a `*` source adds no edge; the INIT self-loop on the initial state is skipped) and reports each declared state not reached, with the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint state-unreachable: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-state-unreachable"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type StUnreachFrom = string | [string]
type StUnreachState = { name : string, isInitial : boolean }
type StUnreachTransition = { from : StUnreachFrom, event : string, to : string }
type StUnreachMachine = { states : [StUnreachState], transitions : [StUnreachTransition] }
type StUnreachTrait = { stateMachine : StUnreachMachine }
type StUnreachOrbital = { traits : [StUnreachTrait] }
type StUnreachProgram = { orbitals : [StUnreachOrbital] }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintStateUnreachableCodes = { tStateUnreachable : LintCodeDecl }

orbital OrbLintStateUnreachableOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintStateUnreachableRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintStateUnreachable -> OrbLintStateUnreachableRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((orbitals (object/get @payload.program "orbitals" [])))
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((trList (object/get (array/nth @orbitals @oi) "traits" [])))
              (array/flatten (array/map (array/range 0 (array/len @trList)) (fn ti
                (let ((td (array/nth @trList @ti)))
                  (if (not (validate/object (object/get @td "stateMachine" null)))
                    []
                    (let ((sm (object/get @td "stateMachine")) (tpath (str/concat "orbitals[" @oi "].traits[" @ti "]")))
                      (let ((sts (object/get @sm "states" [])) (where (str/concat @tpath ".stateMachine")))
                        (if (= (array/len @sts) 0)
                          []
                          (let ((initRow (array/find @sts (fn s (= (object/get @s "isInitial" false) true)))) (tx (object/get @sm "transitions" [])))
                            (if (= @initRow null)
                              []
                              (let ((initial (object/get @initRow "name" "")))
                                (let ((edges (array/flatten (array/map @tx (fn tr
                                    (let ((frm (object/get @tr "from" "")))
                                      (let ((froms (if (validate/string @frm) (array/append [] @frm) @frm)))
                                        (if (and (= (object/get @tr "event" "") "INIT") (or (array/includes @froms "*") (array/includes @froms @initial)) (= (object/get @tr "to" "") @initial))
                                          []
                                          (array/map (array/filter @froms (fn f (!= @f "*"))) (fn f { from: @f, to: (object/get @tr "to" "") }))))))))))
                                  (let ((reached (array/reduce (array/range 0 (array/len @sts)) [@initial] (fn (cur i) (array/unique (array/concat @cur (array/map (array/filter @edges (fn e (array/includes @cur (object/get @e "from")))) (fn e (object/get @e "to")))))))))
                                    (array/map (array/filter @sts (fn s (not (array/includes @reached (object/get @s "name" ""))))) (fn s { code: @config.codes.tStateUnreachable.code, path: (str/concat @where ".states"), message: (str/concat "State '" (object/get @s "name" "") "' is unreachable from the initial state '" @initial "' via any transition path"), suggestion: "Add a transition that reaches this state, or remove the dead state", severity: "error" })))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "state-unreachable", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : StUnreachProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintStateUnreachableCodes = { tStateUnreachable: { code: "ORB_T_STATE_UNREACHABLE", category: "trait", description: "A state is unreachable from the initial state through any transition path" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintStateUnreachableCli -> OrbLintStateUnreachableRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint state-unreachable <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "state-unreachable") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint state-unreachable: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "state-unreachable") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint state-unreachable: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-state-unreachable" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint state-unreachable` with its arguments and working directory."
        @synonyms "orb lint state-unreachable"
      OrbLintStateUnreachable.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintStateUnreachableCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintStateUnreachableOrbitalStart -> OrbLintStateUnreachable, OrbLintStateUnreachableCli, OrbLintInput, Packs, Versions
}
