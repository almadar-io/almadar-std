app std-orb-lint-page-modifiers [
  version: "1.0.0",
  inbound: ["cli-lint-page-modifiers"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-page-modifiers — the `orb lint page-modifiers <file>` command, the port of validate_page_modifiers. It lowers the file with program/read and, for every route page (a page with a protocol is an endpoint and is skipped), reports ORB_P_INDEX_REQUIRES_PUBLIC (an `indexing: index` page lacking `access: public`, `title:` or `description:`), ORB_P_INDEX_PARAM_ROUTE (an indexed page whose route has a `:` segment) and ORB_P_AUTH_NO_SIGN_IN (an `access: authenticated` page when the app declares no `signIn:`), each with its path and suggestion (status 500, exit 1). It also reports ORB_P_TRANSLATION_DUPLICATE_LOCALE (an explicit `translationOf:` group holding more than one page in one locale, the locale being the page path's first segment when declared, else the first declared locale). Clean answers `lint page-modifiers: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-page-modifiers"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }

type PageModsPage = { path : string, protocol : string, name : string, access : string, title : string, description : string, indexing : string, translationOf : string }
type PageModsOrbital = { pages : [PageModsPage] }
type PageModsSite = { signIn : string }
type PmEnt = { g : string!, l : string!, p : string! }
type PmKey = { g : string!, l : string! }
type PmScan = { done : [PmKey]!, found : [OrbFinding]! }
type PageModsProgram = { site : PageModsSite, locales : [string], orbitals : [PageModsOrbital]! }

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintPageModifiersCodes = { pIndexRequiresPublic : LintCodeDecl , pIndexParamRoute : LintCodeDecl , pAuthNoSignIn : LintCodeDecl , pTranslationDuplicateLocale : LintCodeDecl }

orbital OrbLintPageModifiersOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintPageModifiersRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
  }

  trait OrbLintPageModifiers -> OrbLintPageModifiersRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((sgi (let ((site (object/get @payload.program "site"))) (if (= @site null) "" (object/get @site "signIn" "")))) (orbitals (object/get @payload.program "orbitals" [])) (locs (object/get @payload.program "locales" [])))
          (array/flatten [
          (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi
            (let ((pgs (object/get (array/nth @orbitals @oi) "pages" [])))
              (array/flatten (array/map (array/range 0 (array/len @pgs)) (fn pj
                (let ((pg (array/nth @pgs @pj)))
                  (let ((rt (object/get @pg "path")))
                  (if (or (= @rt null) (object/has @pg "protocol"))
                    []
                    (let ((where (str/concat "orbitals[" @oi "].pages[" @pj "]")) (pname (object/get @pg "name" "")) (pacc (object/get @pg "access" "")))
                      (let ((lacks (array/flatten [
                          (if (!= @pacc "public") ["`access: public`"] [])
                          (if (object/has @pg "title") [] ["`title:`"])
                          (if (object/has @pg "description") [] ["`description:`"])])))
                        (array/flatten [
                          (if (and (= (object/get @pg "indexing" "") "index") (> (array/len @lacks) 0))
                            [{ code: @config.codes.pIndexRequiresPublic.code, path: @where, message: (str/concat "page '" @pname "' (" @rt ") declares `indexing: index` but lacks " (str/join @lacks ", ")), suggestion: "an indexed page is public, titled and described; otherwise declare `indexing: noindex`", severity: "error" }]
                            [])
                          (if (and (= (object/get @pg "indexing" "") "index") (array/some (str/split @rt "/") (fn seg (str/startsWith @seg ":"))))
                            [{ code: @config.codes.pIndexParamRoute.code, path: @where, message: (str/concat "page '" @pname "' (" @rt ") is a parameter route; it cannot be `indexing: index` because its concrete URLs are not declared"), suggestion: "declare `indexing: noindex` on parameter routes", severity: "error" }]
                            [])
                          (if (and (= @pacc "authenticated") (= @sgi ""))
                            [{ code: @config.codes.pAuthNoSignIn.code, path: @where, message: (str/concat "page '" @pname "' (" @rt ") is `access: authenticated` but the app declares no `signIn:` route"), suggestion: (str/concat "add `signIn: " "\"" "/<route>" "\"" "` to the app bracket — the page a non-admitted viewer is sent to"), severity: "error" }]
                            [])])))))))))))))
          (let ((f0 (array/first @locs)) (ents : [PmEnt] (array/flatten (array/map @orbitals (fn o
                  (array/flatten (array/map (object/get @o "pages" []) (fn pg
                      (let ((pth (object/get @pg "path")) (tr (object/get @pg "translationOf")))
                        (if (and (!= @pth null) (!= @tr null) (not (object/has @pg "protocol")) (!= @f0 null))
                          (let ((segs (array/filter (str/split @pth "/") (fn s (!= @s "")))) (seg (if (> (array/len @segs) 0) (array/first @segs) "")))
                            [{ g: @tr, l: (if (array/some @locs (fn lc (= @lc @seg))) @seg @f0), p: @pth }])
                          [])))))))))
              (st0 : PmScan { done: [], found: [] }))
            (object/get (array/reduce @ents @st0 (fn (acc en)
              (let ((done : [PmKey] (object/get @acc "done" [])) (found : [OrbFinding] (object/get @acc "found" [])))
                (if (array/some @done (fn d (and (= (object/get @d "g") (object/get @en "g")) (= (object/get @d "l") (object/get @en "l")))))
                  @acc
                  (let ((same (array/filter @ents (fn x (and (= (object/get @x "g") (object/get @en "g")) (= (object/get @x "l") (object/get @en "l")))))))
                    (let ((second (array/nth @same 1)))
                      (if (= @second null)
                        @acc
                        { done: (array/append @done { g: (object/get @en "g"), l: (object/get @en "l") }), found: (array/append @found { code: @config.codes.pTranslationDuplicateLocale.code, path: (object/get @second "p"), message: (str/concat "translation group '" (object/get @en "g") "' holds " (array/len @same) " pages in locale '" (object/get @en "l") "' (" (str/join (array/map @same (fn x (object/get @x "p"))) ", ") "); each locale may hold one"), suggestion: "give each page its own locale prefix, or a different `translationOf:`", severity: "error" }) }))))))) "found" [])) ])))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "page-modifiers", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : PageModsProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
    }
    config {
      codes : LintPageModifiersCodes = { pIndexRequiresPublic: { code: "ORB_P_INDEX_REQUIRES_PUBLIC", category: "page", description: "A page declares indexing: index but lacks the public access it requires" }, pIndexParamRoute: { code: "ORB_P_INDEX_PARAM_ROUTE", category: "page", description: "A parameter-route page is marked indexing index although its concrete URLs are not declared" }, pAuthNoSignIn: { code: "ORB_P_AUTH_NO_SIGN_IN", category: "page", description: "A page requires authenticated access but the app declares no signIn route" }, pTranslationDuplicateLocale: { code: "ORB_P_TRANSLATION_DUPLICATE_LOCALE", category: "page", description: "A translation group holds more than one page in the same locale" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintPageModifiersCli -> OrbLintPageModifiersRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint page-modifiers: the command arguments could not be read" })
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-modifiers <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-modifiers <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint page-modifiers <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "page-modifiers") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint page-modifiers: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "page-modifiers") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint page-modifiers: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-page-modifiers" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint page-modifiers` with its arguments and working directory."
        @synonyms "orb lint page-modifiers"
      OrbLintPageModifiers.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintPageModifiersCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintPageModifiersOrbitalStart -> OrbLintPageModifiers, OrbLintPageModifiersCli, OrbLintInput, Packs, Versions
}
