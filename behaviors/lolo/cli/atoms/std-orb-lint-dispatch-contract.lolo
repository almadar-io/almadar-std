app std-orb-lint-dispatch-contract [
  version: "1.0.0",
  inbound: ["cli-lint-dispatch-contract"],
  env: ["PATH"],
  exec: [exe],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-dispatch-contract - the `orb lint dispatch-contract <file>` command, the port of the dispatch-contract checks of entities/entity_mutation.rs. A `[client]` trait (dispatch client): ORB_T_LOCAL_TRAIT_TOUCHES_SERVER for a transition whose guard reads `@user` and for each transition or tick effect that runs a server-bound effect (a transition whose guard is statically false is skipped); ORB_T_LOCAL_ON_NON_SHARED_PERSISTENT when it writes its linked entity (a `set @entity.<f>` anywhere, or a `persist create|upsert|update` of it in a transition, following `persist batch` list builders) while that entity is neither `[shared]` nor client-resident (`[runtime]` or browser-stored). An `[optimistic]` trait: ORB_T_CLIENT_TICK_SERVER_EFFECT for a tick that is not `[background]` and carries a server-bound effect, reported at the tick's effects. A trait with a declared dispatch: ORB_AUTH_GUARD_CLIENT_ONLY (a warning) for a transition guard that reads `@user` while the transition runs server-bound effects, unless every arm of its (from, event) pair runs the same server-bound effects. Where an effect runs follows effect_site (the sites and entity params come from LINT_OPERATOR_SHAPES, the browser-stored entities from the resolved program): an operator whose installed runsOn is server stays server except a `persist batch` whose named entities are all browser-stored, a data effect on a literal browser-stored entity, a `program/live` whose literal options name `kind: \"trace\"`, `cancel-call` and a `program/self` whose literal options name `mounted: true`, which the kernel places at run time (EXEC-DIST-14, EXEC-DIST-15); an `if` or `when` branch whose condition is statically false is dead, and a `let` pair name or `fn` parameter list is never a call. It needs the RESOLVED program (program/read resolve). Findings print as `[code] path: message` (status 500, exit 1); clean answers `lint dispatch-contract: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-dispatch-contract"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type DcVal = string | number | boolean | [DcVal?] | Map string DcVal?
type DcNodes = [DcVal?]
type DcS = string
type DcSlots = { kind : string!, args : [number] }
type DcProjection = { sourceArg : number!, keyArg : number!, defaultArg : number }
type DcBatchNode = { known : boolean!, targets : [string]!, written : [string]!, function : boolean!, functionKnown : boolean!, functionTargets : [string]!, functionWritten : [string]! }
type DcCall = { path : string!, node : [DcVal?]!, at : number! }
type DcIndex = Map string [DcCall]
type DcField = { name : string, intrinsic : boolean }
type DcEntity = { name : string, shared : boolean, browser : boolean, persistence : string, fields : [DcField] }
type DcTransition = { event : string, from : DcVal, guard : DcVal?, effects : [DcVal?] }
type DcTick = { name : string, runsInBackground : boolean, effects : [DcVal?] }
type DcMachine = { transitions : [DcTransition] }
type DcTrait = { name : string, linkedEntity : string, dispatch : string, stateMachine : DcMachine, ticks : [DcTick] }
type DcOrbital = { name : string, entity : DcEntity, auxiliaryEntities : [DcEntity], traits : [DcTrait] }
type DcProgram = { orbitals : [DcOrbital] }
type DcTypeRef = string | DcTypeNode
type DcTypeNode = { kind : string }
type DcParam = { name : string, type : DcTypeRef }
type DcShape = { runsOn : string?, params : [DcParam] }
type EmStrs = [string]
type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintDispatchContractCodes = { lintIndexMissing : LintCodeDecl , lintOperatorShapesUnread : LintCodeDecl , tLocalOnNonSharedPersistent : LintCodeDecl , tLocalTraitTouchesServer : LintCodeDecl , tClientTickServerEffect : LintCodeDecl , authGuardClientOnly : LintCodeDecl }

orbital OrbLintDispatchContractOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintDispatchContractRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    servers : [string] = []
    entityIdx : Map string number = {}
    slots : Map string DcSlots = {}
    functions : [string] = []
    shapesUnread : boolean = false
    heads : Map string [string] = {}
    roots : Map string [string] = {}
    indexed : boolean = false
    indexScope : string = ""
  }

  trait OrbLintDispatchContract -> OrbLintDispatchContractRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      WALK_HEARD -> ready
        (set @entity.slots ?slots)
      SEMANTICS_HEARD -> ready
        (set @entity.functions ?functions)
      SHAPES_HEARD -> ready
        (set @entity.shapesUnread false)
        (set @entity.servers (array/sort (array/filter (object/keys @payload.operators) (fn k (= (object/get (object/get @payload.operators @k) "runsOn" "") "server")))))
        (set @entity.entityIdx (object/fromEntries (array/flatten (array/map (object/keys @payload.operators) (fn k
          (let ((ps (object/get (object/get @payload.operators @k) "params" [])))
            (array/flatten (array/map (array/range 0 (array/len @ps)) (fn i
              (let ((ty (object/get (default (array/nth @ps @i) {}) "type" null)))
                (if (validate/object @ty)
                  (let ((nd (as @ty DcTypeNode)))
                    (if (= (object/get @nd "kind" "") "entity") [[@k, @i]] []))
                  [])))))))))))
      INDEX_HEARD -> ready
        (set @entity.heads @payload.heads)
        (set @entity.roots @payload.roots)
        (set @entity.indexed true)
        (set @entity.indexScope @payload.scope)
      SHAPES_UNREAD -> ready
        (set @entity.shapesUnread true)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if (not (and @entity.indexed (= @entity.indexScope @payload.scope))) [{ code: @config.codes.lintIndexMissing.code, path: "", message: "the lint input arrived without the structural index (LINT_INDEX), so this rule cannot check the program", suggestion: "std-orb-lint-input sends LINT_INDEX before LINT_INPUT; this rule did not hear it", severity: "error" }] (let ((batchTargets : Map string DcBatchNode (let ((empty : Map string DcBatchNode {})) (array/reduce (array/filter (object/get (default (as (tree/index @payload.program ["persist"]) DcIndex) {}) "persist" []) (fn call (and (> (array/len @call.node) 2) (= (array/nth @call.node 1) "batch")))) @empty (fn (acc call) (let ((ops (array/nth @call.node 2))) (object/set @acc (value/key @ops) (let ((missing : DcBatchNode { known: false, targets: [], written: [], function: false, functionKnown: false, functionTargets: [], functionWritten: [] })) (default (as (default (tree/fold @ops (fn (rawNode rawChildren) (let ((marked (and (validate/array @rawNode) (> (array/len @rawNode) 0) (= (array/nth @rawNode 0) "list")))) (let ((node (if @marked (array/slice @rawNode 1 (array/len @rawNode)) @rawNode)) (children (if @marked (array/slice @rawChildren 1 (array/len @rawChildren)) @rawChildren))) (if (validate/array @node) (let ((size (array/len @node)) (head (if (> @size 0) (array/nth @node 0) null))) (let ((name (if (validate/string @head) @head ""))) (if (array/includes ["create", "update", "delete"] @name) (let ((target (if (> @size 1) (array/nth @node 1) null))) (let ((valid (and (= @size (if (= @name "update") 4 3)) (validate/string @target) (!= @target "") (not (str/startsWith @target (quote "@")))))) { known: @valid, targets: (if @valid [(default (as @target DcS) "")] []), written: (if (and @valid (!= @name "delete")) [(default (as @target DcS) "")] []), function: false, functionKnown: false, functionTargets: [], functionWritten: [] })) (if (array/includes @entity.functions @name) (let ((body (defa