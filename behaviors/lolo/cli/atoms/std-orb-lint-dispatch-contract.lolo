the installed @almadar/std operator table does not match the operator shape type, so where an effect runs is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }] (let ((servers : [string] @entity.servers) (eidx : Map string number @entity.entityIdx) (orbitals (object/get @payload.program "orbitals" []))) (let ((heads : Map string [string] @entity.heads) (roots : Map string [string] @entity.roots) (serverSet (default (object/fromEntries (array/map (array/concat @servers ["call-service"]) (fn x [@x, true]))) {}))) (let ((defs (let ((pn (array/map (array/flatten (array/map @orbitals (fn o (let ((en (object/get @o "entity" null))) (if (validate/object @en) [@en] []))))) (fn x (object/get @x "name" ""))))) (let ((dups (array/filter @pn (fn n (> (array/len (array/filter @pn (fn m (= @m @n)))) 1))))) (object/fromEntries (array/map (array/filter (array/flatten (array/map @orbitals (fn o (array/concat (let ((en (object/get @o "entity" null))) (if (validate/object @en) [@en] [])) (array/filter (object/get @o "auxiliaryEntities" []) (fn x (validate/object @x))))))) (fn x (not (array/includes @dups (object/get @x "name" ""))))) (fn x [(object/get @x "name" ""), @x]))))))) (let ((browser (array/map (array/filter (object/values @defs) (fn d (= (object/get @d "browser" false) true))) (fn d (object/get @d "name" ""))))) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((o (default (array/nth @orbitals @oi) {}))) (let ((trs : [DcTrait] (object/get @o "traits" []))) (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti (let ((t (default (array/nth @trs @ti) {}))) (if (object/has @t "stateMachine") (let ((tp (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]")) (usrT (array/includes (object/get @roots (str/concat @oi "-" @ti) []) (quote "@user"))) (hsT (array/some (object/get @heads (str/concat @oi "-" @ti) []) (fn h (object/has @serverSet @h))))) (let ((trans : [DcTransition] (object/get @t "stateMachine.transitions" [])) (tks : [DcTick] (object/get @t "ticks" [])) (tn (object/get @t "name" "")) (lk (object/get @t "linkedEntity" "")) (dp (object/get @t "dispatch" ""))) (let ((teffs (array/concat (array/flatten (array/map @trans (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))) (array/flatten (array/map @tks (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r })))))))) (let ((roots (array/concat (array/map (array/filter @trans (fn x (!= (object/get @x "guard" null) null))) (fn x { w: (object/get @x "guard" null) })) (array/concat (array/flatten (array/map @trans (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))) (array/flatten (array/map @tks (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))) (array/concat (if (= @dp "client") (array/concat (let ((ed (object/get @defs @lk null))) (if (and (!= @lk "") (!= @ed null) (array/some (object/get @heads (str/concat @oi "-" @ti) []) (fn h (or (= @h "set") (= @h "persist")))) (or (!= (array/len (array/filter (array/flatten (array/map @roots (fn rt (default (as (default (array/concat (array/flatten (array/map (array/filter (array/map (default (as (json/nodes @rt) DcNodes) []) (fn y (default (as @y DcS) ""))) (fn y (str/startsWith @y (quote "@entity.")))) (fn y (array/flatten (array/map (array/take (str/split (str/slice @y 8 (str/len @y)) ".") 1) (fn seg (array/flatten (array/map (array/take (str/split @seg "[") 1) (fn fl (if (or (= @fl "") (= @fl "id") (= @fl "createdAt") (= @fl "updatedAt")) [] [(str/concat "r:" @fl)])))))))))) (array/flatten (array/map (object/get (default (as (tree/index @rt ["set"]) DcIndex) {}) "set" []) (fn c (let ((nd (object/get @c "node"))) (if (< (array/len