false)))) (if (= @h0 "or") (array/some (array/slice @k 1 (array/len @k)) (fn r (if (validate/object @r) (object/get @r "st" false) false))) (if (= @h0 "not") (and (= (array/len (array/slice @k 1 (array/len @k))) 1) (let ((a0r (array/nth (array/slice @k 1 (array/len @k)) 0))) (if (validate/object @a0r) (object/get @a0r "sf" false) false))) (if (and (array/includes ["=", "==", "!="] @h0) (= (array/len (array/slice @n 1 (array/len @n))) 2)) (let ((cz (let ((a0 (array/nth (array/slice @n 1 (array/len @n)) 0)) (a1 (array/nth (array/slice @n 1 (array/len @n)) 1))) (let ((lv (and (or (= @a0 null) (validate/boolean @a0) (validate/number @a0) (and (validate/string @a0) (not (str/startsWith @a0 (quote "@"))))) (or (= @a1 null) (validate/boolean @a1) (validate/number @a1) (and (validate/string @a1) (not (str/startsWith @a1 (quote "@")))))))) (let ((same (if @lv (= (value/key @a0) (value/key @a1)) false))) { lv: @lv, same: @same }))))) (and (object/get @cz "lv" false) (= (object/get @cz "same" false) (not (= @h0 "!="))))) false)))))), ch: (array/map @k (fn c (if (validate/object @c) (object/get @c "h" false) false))) }))) (if (validate/object @n) { f: (array/some (object/values @k) (fn c (if (validate/object @c) (object/get @c "f" false) false))), h: (array/some (object/values @k) (fn c (if (validate/object @c) (object/get @c "f" false) false))), sf: (= (array/len (object/keys @n)) 0), st: (!= (array/len (object/keys @n)) 0), ch: [] } (if (validate/string @n) { f: false, h: false, sf: (= @n ""), st: (and (!= @n "") (not (str/startsWith @n (quote "@")))), ch: [] } (if (validate/number @n) { f: false, h: false, sf: (= @n 0), st: (!= @n 0), ch: [] } (if (validate/boolean @n) { f: false, h: false, sf: (not @n), st: @n, ch: [] } { f: false, h: false, sf: true, st: false, ch: [] })))))) "DcVal") {  }) "f" false) true))))) (value/key @se))))) [] [{ code: @config.codes.authGuardClientOnly.code, path: (str/concat @tp ".stateMachine.transitions[" @i "].guard"), message: (str/concat "trait " (str/concat "\"" @tn "\"") " transition '" (object/get @tr "event" "") "' guards on @user, but this trait's dispatch is client-only (" (if (= @dp "client") "[client]" "[optimistic]") ") — the client state machine advances optimistically before the server evaluates this guard; the effects stay server-gated, the UI transition does not, since the client can construct any @user value it likes"), suggestion: "If this guard is meant as an authorization boundary, move the mutation to a server-gated (not `[client]` or `[optimistic]`) trait; otherwise treat it as a UX precondition only.", severity: "warning" }])))) [])))))) [])))))) []))))))))))))))))))
        (set @entity.indexed false)
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "dispatch-contract", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"
    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : DcProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      WALK_HEARD { slots : Map string DcSlots!, projections : Map string DcProjection! }
        @description "Declared operator result provenance from the installed table."
      SEMANTICS_HEARD { functions : [string]! }
        @description "The installed operators that construct function values."
      OrbLintInput.LINT_OPERATOR_WALK -> WALK_HEARD
      OrbLintInput.LINT_OPERATOR_SEMANTICS -> SEMANTICS_HEARD
      SHAPES_HEARD { operators : Map string DcShape! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES: every installed operator's runsOn site and params; a server operator with an entity param is a data effect that runs on the client for a browser-stored entity."
      SHAPES_UNREAD { error : string! }
        @description "std-orb-lint-input's LINT_OPERATOR_SHAPES_UNREAD: the operator table does not match the shape type."
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the operator heads each trait and transition uses; the server-bound walk of a unit runs only when its heads hold a server operator."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES -> SHAPES_HEARD
      OrbLintInput.LINT_OPERATOR_SHAPES_UNREAD -> SHAPES_UNREAD
    }
    config {
      codes : LintDispatchContractCodes = { lintIndexMissing: { code: "ORB_LINT_INDEX_MISSING", category: "lint", description: "The lint input arrived without a shared program fact the rule reads (the structural index, sites, units, embeds or entities), so the rule cannot check the program" }, lintOperatorShapesUnread: { code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", category: "lint", description: "The installed operator table could not be read or does not match the operator shape type, so a lint cannot run" }, tLocalOnNonSharedPersistent: { code: "ORB_T_LOCAL_ON_NON_SHARED_PERSISTENT", category: "trait", description: "A client-dispatch trait is linked to an entity that is neither shared nor client-resident, hiding server-gated writes behind optimism" }, tLocalTraitTouchesServer: { code: "ORB_T_LOCAL_TRAIT_TOUCHES_SERVER", category: "trait", description: "A client trait transition guards on or touches server-only state" }, tClientTickServerEffect: { code: "ORB_T_CLIENT_TICK_SERVER_EFFECT", category: "trait", description: "A tick that runs in the browser has effects that reach the server, and nothing replays a tick there" }, authGuardClientOnly: { code: "ORB_AUTH_GUARD_CLIENT_ONLY", category: "auth", description: "A transition guards on @user but its trait dispatches client-only, so the UI transition advances before the server evaluates the guard" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
    }

  }

  trait OrbLintDispatchContractCli -> OrbLintDispatchContractRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (or (= @a null) (!= (array/len (object/get @a "argv")) 1)))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint dispatch-contract <file>" })
      LINT_CALLED -> waiting when (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (and (!= @a null) (= (array/len (object/get @a "argv")) 1)))
        (let ((a (json/parse @payload.rawBody OrbCommandArgs))) (if (= @a null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint dispatch-contract <file>" }) (let ((f (array/first (object/get @a "argv")))) (if (= @f null) (emit LINT_ANSWERED { status: 400, body: "usage: orb lint dispatch-contract <file>" }) (emit LINT_REQUEST { file: @f })))))
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "dispatch-contract") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint dispatch-contract: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "dispatch-contract") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint dispatch-contract: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-dispatch-contract" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string!
      }
        @description "Run `orb lint dispatch-contract` with its arguments and working directory."
        @synonyms "orb lint dispatch-contract"
      OrbLintDispatchContract.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintDispatchContractCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintDispatchContractOrbitalStart -> OrbLintDispatchContract, OrbLintDispatchContractCli, OrbLintInput, Packs, Versions
}
