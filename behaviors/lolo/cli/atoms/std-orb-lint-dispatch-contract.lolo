app std-orb-lint-dispatch-contract [
  version: "1.0.0",
  inbound: ["cli-lint-dispatch-contract"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-dispatch-contract - the `orb lint dispatch-contract <file>` command, the port of the dispatch-contract checks of entities/entity_mutation.rs. A `[client]` trait (dispatch client): ORB_T_LOCAL_TRAIT_TOUCHES_SERVER for a transition whose guard reads `@user` and for each transition or tick effect that runs a server-bound effect (a transition whose guard is statically false is skipped); ORB_T_LOCAL_ON_NON_SHARED_PERSISTENT when it writes its linked entity (a `set @entity.<f>` anywhere, or a `persist create|upsert|update` of it in a transition, following `persist batch` list builders) while that entity is neither `[shared]` nor client-resident (`[runtime]` or browser-stored). An `[optimistic]` trait: ORB_T_CLIENT_TICK_SERVER_EFFECT for a tick that is not `[background]` and carries a server-bound effect, reported at the tick's effects. A trait with a declared dispatch: ORB_AUTH_GUARD_CLIENT_ONLY (a warning) for a transition guard that reads `@user` while the transition runs server-bound effects, unless every arm of its (from, event) pair runs the same server-bound effects. Where an effect runs follows effect_site (the sites and entity params come from LINT_OPERATOR_SHAPES, the browser-stored entities from the resolved program): an operator whose installed runsOn is server stays server except an `http` with a keyless request, a `persist batch` whose named entities are all browser-stored and a data effect on a literal browser-stored entity; an `if` or `when` branch whose condition is statically false is dead, and a `let` pair name or `fn` parameter list is never a call. It needs the RESOLVED program (program/read resolve). Findings print as `[code] path: message` (status 500, exit 1); clean answers `lint dispatch-contract: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-dispatch-contract"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type DcVal = string | number | boolean | [DcVal?] | Map string DcVal?
type DcField = { name : string, intrinsic : boolean }
type DcEntity = { name : string, shared : boolean, browser : boolean, persistence : string, fields : [DcField] }
type DcTransition = { event : string, from : DcVal, guard : DcVal?, effects : [DcVal?] }
type DcTick = { name : string, runsInBackground : boolean, effects : [DcVal?] }
type DcMachine = { transitions : [DcTransition] }
type DcTrait = { name : string, linkedEntity : string, dispatch : string, stateMachine : DcMachine, ticks : [DcTick] }
type DcOrbital = { name : string, entity : DcEntity, auxiliaryEntities : [DcEntity], traits : [DcTrait] }
type DcProgram = { orbitals : [DcOrbital] }
type DcTypeRef = string | DcTypeNode
type DcTypeNode = { kind : string }
type DcParam = { name : string, type : DcTypeRef }
type DcShape = { runsOn : string?, params : [DcParam] }
type EmStrs = [string]
orbital OrbLintDispatchContractOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"

  entity OrbLintDispatchContractRun [runtime] {
    id : string!
    scope : string = ""
    findings : [OrbFinding] = []
    servers : [string] = []
    entityIdx : Map string number = {}
    shapesUnread : boolean = false
  }

  trait OrbLintDispatchContract -> OrbLintDispatchContractRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      SHAPES_HEARD -> ready
        (set @entity.shapesUnread false)
        (set @entity.servers (array/sort (array/filter (object/keys @payload.operators) (fn k (= (object/get (object/get @payload.operators @k) "runsOn" "") "server")))))
        (set @entity.entityIdx (object/fromEntries (array/flatten (array/map (object/keys @payload.operators) (fn k
          (let ((ps (object/get (object/get @payload.operators @k) "params" [])))
            (array/flatten (array/map (array/range 0 (array/len @ps)) (fn i
              (let ((ty (object/get (array/nth @ps @i) "type" null)))
                (if (validate/object @ty)
                  (let ((nd (json/parse (json/stringify @ty) DcTypeNode)))
                    (if (and (!= @nd null) (= (object/get @nd "kind" "") "entity")) [[@k, @i]] []))
                  [])))))))))))
      SHAPES_UNREAD -> ready
        (set @entity.shapesUnread true)
      LINT_INPUT -> ready
        (set @entity.scope @payload.scope)
        (set @entity.findings (if @entity.shapesUnread [{ code: "ORB_LINT_OPERATOR_SHAPES_UNREAD", path: "operators", message: "the installed @almadar/std operator table does not match the operator shape type, so where an effect runs is unknown", suggestion: "Reinstall @almadar/std so its operator table declares the params of every operator", severity: "error" }] (let ((servers : [string] @entity.servers) (eidx : Map string number @entity.entityIdx) (orbitals (object/get @payload.program "orbitals" []))) (let ((defs (let ((pn (array/map (array/flatten (array/map @orbitals (fn o (if (validate/object (object/get @o "entity" {  })) [(object/get @o "entity")] [])))) (fn x (object/get @x "name" ""))))) (let ((dups (array/filter @pn (fn n (> (array/len (array/filter @pn (fn m (= @m @n)))) 1))))) (object/fromEntries (array/map (array/filter (array/flatten (array/map @orbitals (fn o (array/concat (if (validate/object (object/get @o "entity" {  })) [(object/get @o "entity")] []) (array/filter (object/get @o "auxiliaryEntities" []) (fn x (validate/object @x))))))) (fn x (not (array/includes @dups (object/get @x "name" ""))))) (fn x [(object/get @x "name" ""), @x]))))))) (let ((browser (array/map (array/filter (object/values @defs) (fn d (= (object/get @d "browser" false) true))) (fn d (object/get @d "name" ""))))) (array/flatten (array/map (array/range 0 (array/len @orbitals)) (fn oi (let ((o (array/nth @orbitals @oi))) (let ((trs : [DcTrait] (object/get @o "traits" []))) (array/flatten (array/map (array/range 0 (array/len @trs)) (fn ti (let ((t (array/nth @trs @ti))) (if (object/has @t "stateMachine") (let ((tp (str/concat "orbitals[" @oi " (" (object/get @o "name" "") ")].traits[" @ti " (" (object/get @t "name" "") ")]"))) (let ((trans : [DcTransition] (object/get @t "stateMachine.transitions" [])) (tks : [DcTick] (object/get @t "ticks" [])) (tn (object/get @t "name" "")) (lk (object/get @t "linkedEntity" "")) (dp (object/get @t "dispatch" ""))) (let ((teffs (array/concat (array/flatten (array/map @trans (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))) (array/flatten (array/map @tks (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r })))))))) (let ((roots (array/concat (array/map (array/filter @trans (fn x (!= (object/get @x "guard" null) null))) (fn x { w: (object/get @x "guard" null) })) (array/concat (array/flatten (array/map @trans (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))) (array/flatten (array/map @tks (fn x (array/map (array/filter (object/get @x "effects" []) (fn r (not (validate/object @r)))) (fn r { w: @r }))))))))) (array/concat (if (= @dp "client") (array/concat (let ((ed (object/get @defs @lk null))) (if (and (!= @lk "") (!= @ed null) (or (!= (array/len (array/filter (array/flatten (array/map @roots (fn rt (or (json/parse (json/stringify (or (tree/fold @rt (fn (n k) (if (validate/string @n) (if (str/startsWith @n (quote "@entity.")) (let ((fl (array/first (str/split (array/first (str/split (str/slice @n 8 (str/len @n)) ".")) "[")))) (if (or (= @fl "") (= @fl "id") (= @fl "createdAt") (= @fl "updatedAt")) [] [(str/concat "r:" @fl)])) []) (if (validate/array @n) (array/concat (if (and (>= (array/len @n) 2) (let ((sq (array/nth @n 0))) (if (validate/string @sq) (= @sq "set") false))) (let ((tg (array/nth @n 1))) (if (and (validate/string @tg) (str/startsWith @tg (quote "@entity."))) (let ((sf (array/first (str/split (array/first (str/split (str/slice @tg 8 (str/len @tg)) ".")) "[")))) (if (= @sf "") [] [(str/concat "s:" @sf)])) [])) []) (array/flatten (array/filter @k (fn zz (!= @zz null))))) (if (validate/object @n) (array/flatten (array/filter (object/values @k) (fn zz (!= @zz null)))) [])))) "DcVal") [])) EmStrs) [])))) (fn z (str/startsWith @z "s:")))) 0) (array/some @teffs (fn ef (= (tree/fold @ef (fn (n k) (if (validate/arra