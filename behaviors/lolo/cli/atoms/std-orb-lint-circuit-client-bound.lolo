app std-orb-lint-circuit-client-bound [
  version: "1.0.0",
  inbound: ["cli-lint-circuit-client-bound"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-circuit-client-bound - the `orb lint circuit-client-bound <file>` command, the port of the checks validate_closed_circuit runs only on client-bound traits (circuit/closed_circuit.rs): a trait a route page declares plus the transitive closure of the traits it embeds as `@trait.<Name>` in config defaults, guards, effects and ticks. ORB_CIRCUIT_FAILURE_ARM_MISSING and ORB_CIRCUIT_FAILURE_ARM_RENDERS_NOTHING (a transition whose fetch, persist, call-service or other failureOps effect declares `emit: { failure: X }` lands in a state with no arm for X, or whose arms neither paint nor emit a declared event or inbound answer), ORB_CIRCUIT_MODAL_SHELL_CLOSE_DEAF and ORB_CIRCUIT_SELF_OVERLAY_IN_SHELL (a pattern painted into an overlay slot whose state has no CLOSE or CANCEL arm; a self-overlaying node reachable through children or a registry node-typed prop of an overlay payload) and ORB_CIRCUIT_DEAD_BODILESS_ACTION (an effect-less arm that leaves a state some other arm painted a main slot for). It also reports ORB_T_TRAIT_UNMOUNTED: in a program (an orbital with pages, or any orbital of a file with more than one non-spec orbital), a trait with transitions that no page of any orbital lists, directly or through the @trait embed closure, is never mounted; the suggestion names the page that already mounts one of its embedded children. The overlay, main and self-overlay vocabularies and the failure operator list are the rule's knobs. Each finding carries the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint circuit-client-bound: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-circuit-client-bound"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type CbNode = string | number | boolean | [CbNode?] | Map string CbNode?
type CbFrom = string | [string]
type CbAnswer = { answers : string }
type CbEvent = { key : string, inbound : CbAnswer? }
type CbTransition = { from : CbFrom, to : string, event : string, guard : CbNode?, effects : [CbNode?] }
type CbMachine = { transitions : [CbTransition], events : [CbEvent] }
type CbEmit = { event : string }
type CbField = { default : CbNode? }
type CbTick = { guard : CbNode?, effects : [CbNode?] }
type CbRef = { ref : string, name : string }
type CbPage = { protocol : string, traits : [CbRef] }
type CbTrait = { name : string, stateMachine : CbMachine, emits : [CbEmit], config : Map string CbField?, ticks : [CbTick] }
type CbOrbital = { name : string, spec : boolean, traits : [CbTrait], pages : [CbPage] }
type CbProgram = { orbitals : [CbOrbital] }
type CbPatProp = { types : [string]! }
type CbPattern = { props : Map string CbPatProp? }
type CbPay = { self : boolean!, pat : boolean!, sty : boolean! }
type CbR = { s : [string]!, f : [string]!, ex : [string]!, b : boolean!, e : boolean!, sf : boolean!, ne : boolean!, nod : boolean!, pl : [CbPay]! }
type CbTr = { f : [string]!, e : string!, to : string!, fs : string!, n : number!, empty : boolean!, main : boolean! }
type CbKid = { n : string!, ch : [string]! }
type CbKidMap = Map string [CbKid]
type CbCall = { path : string!, node : [CbNode?]! }
type CbIndex = Map string [CbCall]

type LintCodeDecl = { code : string!, category : string!, description : string! }
type LintCircuitClientBoundCodes = { tTraitUnmounted : LintCodeDecl , circuitFailureArmMissing : LintCodeDecl , circuitFailureArmRendersNothing : LintCodeDecl , circuitSelfOverlayInShell : LintCodeDecl , circuitModalShellCloseDeaf : LintCodeDecl , circuitDeadBodilessAction : LintCodeDecl }

orbital OrbLintCircuitClientBoundOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"


  entity OrbLintCircuitClientBoundRun [runtime] {
    id : string!
    scope : string = ""
    program : CbProgram = {}
    roots : Map string [string] = {}
    patterns : Map string CbPattern = {}
    findings : [OrbFinding] = []
  }

  trait OrbLintCircuitClientBound -> OrbLintCircuitClientBoundRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      INDEX_HEARD -> ready
        (set @entity.roots @payload.roots)
      PATTERNS_HEARD -> ready
        (set @entity.patterns @payload.patterns)
      LINT_INPUT -> ready
        (set @entity.program @payload.program)
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((nos : [string] [])
                (nof : [OrbFinding] [])
                (nop : [CbPay] [])
                (notd : [CbTrait] [])
                (notr : [CbTransition] [])
                (noem : [CbEmit] [])
                (noev : [CbEvent] [])
                (nopg : [CbPage] [])
                (nor : [CbRef] [])
                (notk : [CbTick] [])
                (lnone : LNodes [])
                (nr : CbR { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: false, ne: false, nod: false, pl: @nop })
                (ovSet (default (object/fromEntries (array/map @config.overlaySlots (fn x [@x, true]))) {}))
                (mainSet (default (object/fromEntries (array/map @config.mainSlots (fn x [@x, true]))) {}))
                (opSet (default (object/fromEntries (array/map @config.failureOps (fn x [(str/replaceAll @x "/" "~s"), true]))) {})))
            (array/flatten (array/map (object/get @entity.program "orbitals" []) (fn (o oi)
              (let ((trs0 : [CbTrait] (object/get @o "traits" @notd)))
                (let ((inlK (array/filter (array/range 0 (array/len @trs0)) (fn i (object/has (default (array/nth @trs0 @i) {}) "stateMachine")))))
                  (let ((kids : [CbKid] (array/map @inlK (fn ti
                          (let ((t (default (array/nth @trs0 @ti) {})) (gt (array/includes (object/get @entity.roots (str/concat @oi "-" @ti) @nos) (quote "@trait"))))
                            { n: (object/get @t "name" ""),
                              ch: (if (not @gt) @nos
                                    (array/unique (array/filter
                                      (array/concat (array/concat
                                        (let ((nn (as (json/nodes (array/map (object/values (object/get @t "config" {})) (fn f (object/get (default @f {}) "default" null)))) LNodes))) (array/map (if (= @nn null) @lnone @nn) (fn nd (let ((st (default (as @nd LStr) ""))) (if (str/startsWith @st (quote "@trait.")) (array/first (str/split (array/first (str/split (str/slice @st 7 (str/len @st)) ".")) "[")) "")))))
                                        (let ((nn (as (json/nodes (array/map (object/get @t "stateMachine.transitions" @notr) (fn x [(object/get @x "guard" null), (object/get @x "effects" [])]))) LNodes))) (array/map (if (= @nn null) @lnone @nn) (fn nd (let ((st (default (as @nd LStr) ""))) (if (str/startsWith @st (quote "@trait.")) (array/first (str/split (array/first (str/split (str/slice @st 7 (str/len @st)) ".")) "[")) ""))))))
                                        (let ((nn (as (json/nodes (array/map (object/get @t "ticks" @notk) (fn x [(object/get @x "guard" null), (object/get @x "effects" [])]))) LNodes))) (array/map (if (= @nn null) @lnone @nn) (fn nd (let ((st (default (as @nd LStr) ""))) (if (str/startsWith @st (quote "@trait.")) (array/first (str/split (array/first (str/split (str/slice @st 7 (str/len @st)) ".")) "[")) ""))))))
                                      (fn c (and (!= @c "") (!= @c (object/get @t "name" ""))))))) }))))
                        (seeds (array/flatten (array/map (array/filter (object/get @o "pages" @nopg) (fn p (= (object/get @p "protocol" "") ""))) (fn p (array/map (object/get @p "traits" @nor) (fn r (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" "")))))))))
                    (let ((bound (array/reduce (array/range 0 (+ (array/len @kids) 1)) (array/unique @seeds) (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map (array/filter @kids (fn k0 (array/includes @acc (object/get @k0 "n")))) (fn k0 (object/get @k0 "ch")))))))))
                          (mounted (array/reduce (array/range 0 (+ (array/len @kids) 1)) (array/unique (array/flatten (array/map (object/get @entity.program "orbitals" []) (fn o2 (array/flatten (array/map (object/get @o2 "pages" @nopg) (fn p (array/map (object/get @p "traits" @nor) (fn r (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" ""))))))))))) (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map (array/filter @kids (fn k0 (array/includes @acc (object/get @k0 "n")))) (fn k0 (object/get @k0 "ch")))))))))
                          (isprog (or (> (array/len (object/get @o "pages" @nopg)) 0) (> (array/len (array/filter (object/get @entity.program "orbitals" []) (fn x (not (object/get @x "spec" false))))) 1))))
                      (array/flatten (array/map @inlK (fn ti
                        (let ((t (default (array/nth @trs0 @ti) {})))
                          (if (not (array/includes @bound (object/get @t "name" ""))) (let ((tn (object/get @t "name" "")) (on (object/get @o "name" "")) (nt (array/len (object/get @t "stateMachine.transitions" @notr))))
                            (if (or (not @isprog) (= @nt 0) (array/includes @mounted @tn)) @nof
                              (let ((tp (str/concat "orbitals[" @oi " (" @on ")].traits[" @ti " (" @tn ")]"))
                                    (kd (array/find @kids (fn k0 (= (object/get @k0 "n") @tn))))
                                    (pgs (object/get @o "pages" @nopg)))
                                (let ((ch (if (= @kd null) @nos (object/get @kd "ch"))))
                                  (let ((paths (array/map (array/filter @pgs (fn p (array/some (object/get @p "traits" @nor) (fn r (array/includes @ch (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" ""))))))) (fn p (object/get @p "path" "")))))
                                    [{ code: @config.codes.tTraitUnmounted.code, path: @tp, message: (str/concat "'" @on "." @tn "' owns a state machine (" @nt " transition(s)) but is listed on no page (route or protocol endpoint) and no page's @trait embed closure reaches it — nothing mounts it, so it can never handle an event in the shipped app"), suggestion: (if (= (array/len @paths) 0) (str/concat "declare " @tn " on a page — its traits follow `->`, comma-separated, e.g. `page \"/path\" as SomePage -> " @tn "` — or embed it in a mounted trait's render-ui as @trait." @tn) (str/concat "add " @tn " to the page decl already mounting one of its embedded children (" (str/join @paths ", ") "): " (str/join (array/map @paths (fn pa (let ((pg (default (array/find @pgs (fn p (= (object/get @p "path" "") @pa))) {}))) (str/concat "page \"" @pa "\" as " (object/get @pg "name" "") " -> " (str/join (array/concat [@tn] (array/map (object/get @pg "traits" @nor) (fn r (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" ""))))) ", "))))) "; "))), severity: "error" }])))))
                            (let ((tn (object/get @t "name" "")) (on (object/get @o "name" "")))
                              (let ((tp (str/concat "orbitals[" @oi " (" @on ")].traits[" @ti " (" @tn ")]"))
                                    (trs : [CbTransition] (object/get @t "stateMachine.transitions" @notr))
                                    (reported (array/concat (array/map (object/get @t "emits" @noem) (fn e (object/get @e "event" ""))) (array/flatten (array/map (object/get @t "stateMachine.events" @noev) (fn ev (let ((ib (object/get @ev "inbound" null))) (if (validate/object @ib) (array/append @nos (object/get @ib "answers" "")) @nos))))))))
                                (let ((tl : [CbTr] (array/map (array/range 0 (array/len @trs)) (fn n0
                                        (let ((x (default (array/nth @trs @n0) {})))
                                          (let ((fr (object/get @x "from" "")) (effs (object/get @x "effects" [])))
                                            { f: (if (validate/string @fr) (array/append @nos @fr) @fr),
                                              e: (object/get @x "event" ""),
                                              to: (object/get @x "to" ""),
                                              fs: (if (validate/string @fr) @fr (str/concat "[" (str/join @fr ", ") "]")),
                                              n: @n0,
                                              empty: (= (array/len @effs) 0),
                                              main: (array/some @effs (fn e (and (validate/array @e) (>= (array/len @e) 3) (let ((h0 (array/nth @e 0))) (if (validate/string @h0) (= @h0 "render-ui") false)) (let ((h1 (array/nth @e 1))) (if (validate/string @h1) (object/has @mainSet @h1) false))))) }))))))
                                  (let ((painted (array/unique (array/map (array/filter @tl (fn x (object/get @x "main"))) (fn x (object/get @x "to"))))))
                                    (array/concat
                                      (array/concat
                                        (array/flatten (array/map @tl (fn x (let ((effs (object/get (array/nth @trs (object/get @x "n")) "effects" []))) (let ((fq (let ((ix (default (as (tree/index @effs @config.failureOps) CbIndex) {})))
                                    (array/flatten (array/map (array/filter (array/flatten (array/map (object/keys @ix) (fn hd (object/get @ix @hd [])))) (fn c (not (str/includes (object/get @c "path" "") ".")))) (fn c
                                      (array/flatten (array/map (object/get @c "node" []) (fn q (if (validate/object @q) (let ((em (object/get @q "emit" null))) (if (validate/object @em) (let ((fv (object/get @em "failure" null))) (if (validate/string @fv) (if (!= @fv "") [@fv] @nos) @nos)) @nos)) @nos)))))))))) (let ((fails (array/sort (array/unique @fq)))) (array/flatten (array/map @fails (fn fe (let ((arms (array/filter @tl (fn a (and (or (array/includes (object/get @a "f") (object/get @x "to")) (array/includes (object/get @a "f") "*")) (= (object/get @a "e") @fe)))))) (if (= (array/len @arms) 0) [{ code: @config.codes.circuitFailureArmMissing.code, path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "transition " (object/get @x "fs") "--[" (object/get @x "e") "]-->" (object/get @x "to") " declares `emit: { failure: " @fe " }` but state '" (object/get @x "to") "' has no arm handling '" @fe "' — the failure is never caught"), suggestion: (str/concat "Add a transition `from: '" (object/get @x "to") "', event: '" @fe "'` that handles the failure (e.g. render an error toast)."), severity: "error" }] (if (array/some @arms (fn a (let ((ix (default (as (tree/index (object/get (array/nth @trs (object/get @a "n")) "effects" []) ["render-ui" "emit"]) CbIndex) {})))
                                          (or (array/some (object/get @ix "render-ui" []) (fn c (and (not (str/includes (object/get @c "path" "") ".")) (>= (array/len (object/get @c "node" [])) 3) (!= (array/nth (object/get @c "node" []) 2) null))))
                                              (array/some (object/get @ix "emit" []) (fn c (and (not (str/includes (object/get @c "path" "") ".")) (>= (array/len (object/get @c "node" [])) 2) (let ((h1 (array/nth (object/get @c "node" []) 1))) (if (validate/string @h1) (array/includes @reported @h1) false))))))))) @nof [{ code: @config.codes.circuitFailureArmRendersNothing.code, path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "state '" (object/get @x "to") "' handles failure event '" @fe "' but its arm neither renders nor emits a declared event — the failure reaches no one"), suggestion: (str/concat "Emit a failure event the trait declares in `emits` from the '" @fe "' arm (its embedder presents it), or render it."), severity: "error" }]))))))))))))
                                        (array/flatten (array/map @tl (fn x (let ((effs (object/get (array/nth @trs (object/get @x "n")) "effects" []))) (let ((pq (let ((ix (default (as (tree/index @effs ["render-ui"]) CbIndex) {})))
                                    (let ((qual (array/filter (object/get @ix "render-ui" []) (fn c (let ((nn (object/get @c "node" []))) (and (not (str/includes (object/get @c "path" "") ".")) (>= (array/len @nn) 3) (let ((h1 (array/nth @nn 1))) (and (validate/string @h1) (object/has @ovSet @h1)))))))))
                                      (array/map (array/filter @qual (fn c (not (array/some @qual (fn d (and (!= (object/get @d "path" "") (object/get @c "path" "")) (str/startsWith (object/get @c "path" "") (object/get @d "path" ""))))))))
                                        (fn c (let ((p (array/nth (object/get @c "node" []) 2))) { self: (or (and (validate/object @p) (let ((sv (object/get @p "slideOver" null))) (if (validate/boolean @sv) (= @sv true) false))) (object/get (let ((q (tree/fold @p (fn (n k) (if (validate/array @n) (let ((ne (array/some @k (fn q (object/get (if (= @q null) @nr @q) "nod"))))) { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: false, ne: @ne, nod: @ne, pl: @nop }) (if (validate/object @n) (let ((tv (object/get @n "type" null))) (let ((pt (if (validate/string @tv) @tv "")) (sf (or (let ((sv (object/get @n "slideOver" null))) (if (validate/boolean @sv) (= @sv true) false)) (and (validate/string @tv) (array/includes @config.selfOverlayPatterns @tv))))) (let ((ne (array/some (array/filter (object/keys @n) (fn key (and (not (str/includes @key ".")) (or (= @key "children") (and (!= @pt "") (let ((pe (object/get @entity.patterns @pt null))) (if (= @pe null) false (let ((pp (object/get @pe "props" null))) (if (= @pp null) false (let ((pr (object/get @pp @key null))) (if (= @pr null) false (array/includes (object/get @pr "types" @nos) "node")))))))))))) (fn key (object/get (object/get @k @key @nr) "nod"))))) { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: @sf, ne: @ne, nod: (or @sf @ne), pl: @nop }))) @nr))) "CbNode"))) (if (= @q null) @nr @q)) "ne")), pat: (and (!= @p null) (not (validate/string @p))), sty: (and (validate/object @p) (let ((tv (object/get @p "type" null))) (if (validate/string @tv) (array/includes @config.selfOverlayPatterns @tv) false))) }))))))) (array/flatten (array/map @pq (fn pl (array/concat (if (object/get @pl "self") [{ code: @config.codes.circuitSelfOverlayInShell.code, path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "transition " (object/get @x "fs") "--[" (object/get @x "e") "]-->" (object/get @x "to") " renders a self-overlaying pattern (`slideOver: true`, or a nested `modal`/`confirm-dialog`) inside an overlay slot payload — the generic portal shell wraps it too, stacking two overlay chromes"), suggestion: "Render the inner content pattern into the slot instead (the shell already provides the chrome and the X), or make the self-overlaying pattern the slot payload's ROOT node, which the shell renders bare.", severity: "error" }] @nof) (if (and (object/get @pl "pat") (not (object/get @pl "sty")) (not (array/some @tl (fn a (and (or (array/includes (object/get @a "f") (object/get @x "to")) (array/includes (object/get @a "f") "*")) (array/includes @config.shellDismissEvents (object/get @a "e"))))))) [{ code: @config.codes.circuitModalShellCloseDeaf.code, path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "state '" (object/get @x "to") "' mounts an overlay-slot pattern but has no `CLOSE`/`CANCEL` arm — the shell's own X/Escape/overlay-click control fires into nothing"), suggestion: (str/concat "Add a `CLOSE` (or `CANCEL`) arm in state '" (object/get @x "to") "' that clears the overlay slot."), severity: "error" }] @nof)))))))))))
                                      (array/flatten (array/map @tl (fn x (if (or (not (object/get @x "empty")) (not (array/some (object/get @x "f") (fn s (and (!= @s (object/get @x "to")) (array/includes @painted @s)))))) @nof [{ code: @config.codes.circuitDeadBodilessAction.code, path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "]"), message: (str/concat "'" (object/get @x "e") "' moves " (object/get @x "fs") " -> " (object/get @x "to") " but carries no effects — the machine leaves " (object/get @x "fs") " while the screen keeps its paint, so every affordance routed here is dead and the surface now disagrees with the state it is in"), suggestion: (str/concat "give the arm the body '" (object/get @x "to") "' should show — copy " (object/get @x "to") "'s INIT render (and its fetch, if any) into the arm. An (emit INIT) is not a substitute: the bus never delivers lifecycle events"), severity: "error" }])))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "circuit-client-bound", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CbProgram!  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the binding roots each inline trait uses; a trait is searched for @trait references only when its roots hold @trait."
      PATTERNS_HEARD { patterns : Map string CbPattern! }
        @description "std-orb-lint-input's LINT_PATTERNS: the installed pattern registry's props, each with its types."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      OrbLintInput.LINT_PATTERNS -> PATTERNS_HEARD
    }

    config {
      codes : LintCircuitClientBoundCodes = { tTraitUnmounted: { code: "ORB_T_TRAIT_UNMOUNTED", category: "trait", description: "A trait owns a state machine but is listed on no page and reached by no embed" }, circuitFailureArmMissing: { code: "ORB_CIRCUIT_FAILURE_ARM_MISSING", category: "circuit", description: "A transition starting an asynchronous client call has no failure arm to handle its error" }, circuitFailureArmRendersNothing: { code: "ORB_CIRCUIT_FAILURE_ARM_RENDERS_NOTHING", category: "circuit", description: "A state handles a failure event but its arm neither renders nor emits a declared event, so the failure reaches no one" }, circuitSelfOverlayInShell: { code: "ORB_CIRCUIT_SELF_OVERLAY_IN_SHELL", category: "circuit", description: "A self-overlaying pattern is rendered inside an overlay slot payload, stacking two overlay chromes" }, circuitModalShellCloseDeaf: { code: "ORB_CIRCUIT_MODAL_SHELL_CLOSE_DEAF", category: "circuit", description: "A state mounting an overlay-slot pattern has no CLOSE or CANCEL transition to dismiss it" }, circuitDeadBodilessAction: { code: "ORB_CIRCUIT_DEAD_BODILESS_ACTION", category: "circuit", description: "A transition changes state but carries no effects, so the screen keeps its paint and affordances routed to it are dead" } }
        @label "Emitted codes"
        @description "The finding codes this rule emits, with their category and meaning; the registry is generated from this declaration."
      overlaySlots : [string] = ["modal", "drawer", "dock", "overlay"]
        @label "Overlay slots"
        @description "The slots the generic portal shell wraps."
      mainSlots : [string] = ["main", "content", "screen"]
        @label "Main slots"
        @description "The inline content slots a state paints."
      selfOverlayPatterns : [string] = ["modal", "confirm-dialog"]
        @label "Self-overlaying patterns"
        @description "The patterns that draw their own overlay chrome."
      shellDismissEvents : [string] = ["CLOSE", "CANCEL"]
        @label "Shell dismiss events"
        @description "The events the portal shell fires at a trait that mounts it."
      failureOps : [string] = ["fetch", "persist", "call-service", "http", "postgres", "random-bytes", "credential-status", "credential-forget", "access-check", "oauth-authorize", "oauth-connection-status", "oauth-connection-forget", "program/eval", "program/compose", "credential-list", "credential-set", "credential-remove", "credential-test", "credential-mode", "credential-rotate"]
        @label "Failure-emitting operators"
        @description "The operators whose emit map carries the async-result failure event."
    }

  }

  trait OrbLintCircuitClientBoundCli -> OrbLintCircuitClientBoundRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (!= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint circuit-client-bound <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse (default @payload.rawBody "") OrbCommandArgs) null) (= (array/len (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (default (array/first (object/get (json/parse (default @payload.rawBody "") OrbCommandArgs) "argv")) "") })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "circuit-client-bound") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint circuit-client-bound: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "circuit-client-bound") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint circuit-client-bound: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-circuit-client-bound" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint circuit-client-bound` with its arguments and working directory."
        @synonyms "orb lint circuit-client-bound"
      OrbLintCircuitClientBound.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }


  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintCircuitClientBoundCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintCircuitClientBoundOrbitalStart -> OrbLintCircuitClientBound, OrbLintCircuitClientBoundCli, OrbLintInput, Packs, Versions
}
