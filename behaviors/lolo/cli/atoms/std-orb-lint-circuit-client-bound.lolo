app std-orb-lint-circuit-client-bound [
  version: "1.0.0",
  inbound: ["cli-lint-circuit-client-bound"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-circuit-client-bound - the `orb lint circuit-client-bound <file>` command, the port of the checks validate_closed_circuit runs only on client-bound traits (circuit/closed_circuit.rs): a trait a route page declares plus the transitive closure of the traits it embeds as `@trait.<Name>` in config defaults, guards, effects and ticks. ORB_CIRCUIT_FAILURE_ARM_MISSING and ORB_CIRCUIT_FAILURE_ARM_RENDERS_NOTHING (a transition whose fetch, persist, call-service or other failureOps effect declares `emit: { failure: X }` lands in a state with no arm for X, or whose arms neither paint nor emit a declared event or inbound answer), ORB_CIRCUIT_MODAL_SHELL_CLOSE_DEAF and ORB_CIRCUIT_SELF_OVERLAY_IN_SHELL (a pattern painted into an overlay slot whose state has no CLOSE or CANCEL arm; a self-overlaying node reachable through children or a registry node-typed prop of an overlay payload) and ORB_CIRCUIT_DEAD_BODILESS_ACTION (an effect-less arm that leaves a state some other arm painted a main slot for). The overlay, main and self-overlay vocabularies and the failure operator list are the rule's knobs. Each finding carries the Rust path, message and suggestion (status 500, exit 1). Clean answers `lint circuit-client-bound: clean` (status 200, exit 0). Anything but one file argument is the usage (status 400, exit 2); an unreadable or unlowerable file is status 500."
]
uses Spec from "almadar-std/lint-circuit-client-bound"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type LNode = string | number | boolean | [LNode?] | Map string LNode?
type LNodes = [LNode?]
type LStr = string
type CbNode = string | number | boolean | [CbNode?] | Map string CbNode?
type CbFrom = string | [string]
type CbAnswer = { answers : string }
type CbEvent = { key : string, inbound : CbAnswer? }
type CbTransition = { from : CbFrom, to : string, event : string, guard : CbNode?, effects : [CbNode?] }
type CbMachine = { transitions : [CbTransition], events : [CbEvent] }
type CbEmit = { event : string }
type CbField = { default : CbNode? }
type CbTick = { guard : CbNode?, effects : [CbNode?] }
type CbRef = { ref : string, name : string }
type CbPage = { protocol : string, traits : [CbRef] }
type CbTrait = { name : string, stateMachine : CbMachine, emits : [CbEmit], config : Map string CbField?, ticks : [CbTick] }
type CbOrbital = { name : string, traits : [CbTrait], pages : [CbPage] }
type CbProgram = { orbitals : [CbOrbital] }
type CbPatProp = { types : [string]! }
type CbPattern = { props : Map string CbPatProp? }
type CbPay = { self : boolean!, pat : boolean!, sty : boolean! }
type CbR = { s : [string]!, f : [string]!, ex : [string]!, b : boolean!, e : boolean!, sf : boolean!, ne : boolean!, nod : boolean!, pl : [CbPay]! }
type CbTr = { f : [string]!, e : string!, to : string!, fs : string!, n : number!, empty : boolean!, main : boolean! }
type CbKid = { n : string!, ch : [string]! }
type CbKidMap = Map string [CbKid]

orbital OrbLintCircuitClientBoundOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"


  entity OrbLintCircuitClientBoundRun [runtime] {
    id : string!
    scope : string = ""
    program : CbProgram = {}
    roots : Map string [string] = {}
    patterns : Map string CbPattern = {}
    findings : [OrbFinding] = []
  }

  trait OrbLintCircuitClientBound -> OrbLintCircuitClientBoundRun [optimistic] {
    initial: ready

    state ready {
      INIT -> ready
      INDEX_HEARD -> ready
        (set @entity.roots @payload.roots)
      PATTERNS_HEARD -> ready
        (set @entity.patterns @payload.patterns)
      LINT_INPUT -> ready
        (set @entity.program @payload.program)
        (set @entity.scope @payload.scope)
        (set @entity.findings (let ((nos : [string] [])
                (nof : [OrbFinding] [])
                (nop : [CbPay] [])
                (notd : [CbTrait] [])
                (notr : [CbTransition] [])
                (noem : [CbEmit] [])
                (noev : [CbEvent] [])
                (nopg : [CbPage] [])
                (nor : [CbRef] [])
                (notk : [CbTick] [])
                (lnone : LNodes [])
                (nr : CbR { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: false, ne: false, nod: false, pl: @nop })
                (ovSet (or (object/fromEntries (array/map @config.overlaySlots (fn x [@x, true]))) {}))
                (mainSet (or (object/fromEntries (array/map @config.mainSlots (fn x [@x, true]))) {}))
                (opSet (or (object/fromEntries (array/map @config.failureOps (fn x [(str/replaceAll @x "/" "~s"), true]))) {})))
            (array/flatten (array/map (object/get @entity.program "orbitals" []) (fn (o oi)
              (let ((trs0 : [CbTrait] (object/get @o "traits" @notd)))
                (let ((inlK (array/filter (array/range 0 (array/len @trs0)) (fn i (object/has (array/nth @trs0 @i) "stateMachine")))))
                  (let ((kids : [CbKid] (array/map @inlK (fn ti
                          (let ((t (array/nth @trs0 @ti)) (gt (array/includes (object/get @entity.roots (str/concat @oi "-" @ti) @nos) (quote "@trait"))))
                            { n: (object/get @t "name" ""),
                              ch: (if (not @gt) @nos
                                    (array/unique (array/filter
                                      (array/concat (array/concat
                                        (let ((nn (json/parse (json/stringify (json/nodes (array/map (object/values (object/get @t "config" {})) (fn f (object/get (or @f {}) "default" null))))) LNodes))) (array/map (if (= @nn null) @lnone @nn) (fn nd (let ((st (or (json/parse (json/stringify @nd) LStr) ""))) (if (str/startsWith @st (quote "@trait.")) (array/first (str/split (array/first (str/split (str/slice @st 7 (str/len @st)) ".")) "[")) "")))))
                                        (let ((nn (json/parse (json/stringify (json/nodes (array/map (object/get @t "stateMachine.transitions" @notr) (fn x [(object/get @x "guard" null), (object/get @x "effects" [])])))) LNodes))) (array/map (if (= @nn null) @lnone @nn) (fn nd (let ((st (or (json/parse (json/stringify @nd) LStr) ""))) (if (str/startsWith @st (quote "@trait.")) (array/first (str/split (array/first (str/split (str/slice @st 7 (str/len @st)) ".")) "[")) ""))))))
                                        (let ((nn (json/parse (json/stringify (json/nodes (array/map (object/get @t "ticks" @notk) (fn x [(object/get @x "guard" null), (object/get @x "effects" [])])))) LNodes))) (array/map (if (= @nn null) @lnone @nn) (fn nd (let ((st (or (json/parse (json/stringify @nd) LStr) ""))) (if (str/startsWith @st (quote "@trait.")) (array/first (str/split (array/first (str/split (str/slice @st 7 (str/len @st)) ".")) "[")) ""))))))
                                      (fn c (and (!= @c "") (!= @c (object/get @t "name" ""))))))) }))))
                        (seeds (array/flatten (array/map (array/filter (object/get @o "pages" @nopg) (fn p (= (object/get @p "protocol" "") ""))) (fn p (array/map (object/get @p "traits" @nor) (fn r (if (!= (object/get @r "ref" "") "") (object/get @r "ref" "") (object/get @r "name" "")))))))))
                    (let ((bound (array/reduce (array/range 0 (+ (array/len @kids) 1)) (array/unique @seeds) (fn (acc i) (array/unique (array/concat @acc (array/flatten (array/map (array/filter @kids (fn k0 (array/includes @acc (object/get @k0 "n")))) (fn k0 (object/get @k0 "ch"))))))))))
                      (array/flatten (array/map @inlK (fn ti
                        (let ((t (array/nth @trs0 @ti)))
                          (if (not (array/includes @bound (object/get @t "name" ""))) @nof
                            (let ((tn (object/get @t "name" "")) (on (object/get @o "name" "")))
                              (let ((tp (str/concat "orbitals[" @oi " (" @on ")].traits[" @ti " (" @tn ")]"))
                                    (trs : [CbTransition] (object/get @t "stateMachine.transitions" @notr))
                                    (reported (array/concat (array/map (object/get @t "emits" @noem) (fn e (object/get @e "event" ""))) (array/flatten (array/map (object/get @t "stateMachine.events" @noev) (fn ev (let ((ib (object/get @ev "inbound" null))) (if (validate/object @ib) (array/append @nos (object/get @ib "answers" "")) @nos))))))))
                                (let ((tl : [CbTr] (array/map (array/range 0 (array/len @trs)) (fn n0
                                        (let ((x (array/nth @trs @n0)))
                                          (let ((fr (object/get @x "from" "")) (effs (object/get @x "effects" [])))
                                            { f: (if (validate/string @fr) (array/append @nos @fr) @fr),
                                              e: (object/get @x "event" ""),
                                              to: (object/get @x "to" ""),
                                              fs: (if (validate/string @fr) @fr (str/concat "[" (str/join @fr ", ") "]")),
                                              n: @n0,
                                              empty: (= (array/len @effs) 0),
                                              main: (array/some @effs (fn e (and (validate/array @e) (>= (array/len @e) 3) (let ((h0 (array/nth @e 0))) (if (validate/string @h0) (= @h0 "render-ui") false)) (let ((h1 (array/nth @e 1))) (if (validate/string @h1) (object/has @mainSet @h1) false))))) }))))))
                                  (let ((painted (array/unique (array/map (array/filter @tl (fn x (object/get @x "main"))) (fn x (object/get @x "to"))))))
                                    (array/concat
                                      (array/concat
                                        (array/flatten (array/map @tl (fn x (let ((effs (object/get (array/nth @trs (object/get @x "n")) "effects" []))) (let ((fq (tree/fold @effs (fn (n k) (if (validate/array @n) (let ((kr (array/map @k (fn q (if (= @q null) @nr @q)))) (h0 (if (> (array/len @n) 0) (array/nth @n 0) null))) { s: @nos, f: (array/concat (if (and (validate/string @h0) (object/has @opSet (str/replaceAll @h0 "/" "~s"))) (array/flatten (array/map @kr (fn q (object/get @q "ex")))) @nos) (array/flatten (array/map @kr (fn q (object/get @q "f"))))), ex: @nos, b: false, e: false, sf: false, ne: false, nod: false, pl: @nop }) (if (validate/object @n) (let ((em (object/get @n "emit" null))) { s: @nos, f: @nos, ex: (if (validate/object @em) (let ((fv (object/get @em "failure" null))) (if (validate/string @fv) (if (!= @fv "") (array/append @nos @fv) @nos) @nos)) @nos), b: false, e: false, sf: false, ne: false, nod: false, pl: @nop }) @nr))) "CbNode"))) (let ((fails (array/sort (array/unique (object/get (if (= @fq null) @nr @fq) "f"))))) (array/flatten (array/map @fails (fn fe (let ((arms (array/filter @tl (fn a (and (or (array/includes (object/get @a "f") (object/get @x "to")) (array/includes (object/get @a "f") "*")) (= (object/get @a "e") @fe)))))) (if (= (array/len @arms) 0) [{ code: "ORB_CIRCUIT_FAILURE_ARM_MISSING", path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "transition " (object/get @x "fs") "--[" (object/get @x "e") "]-->" (object/get @x "to") " declares `emit: { failure: " @fe " }` but state '" (object/get @x "to") "' has no arm handling '" @fe "' — the failure is never caught"), suggestion: (str/concat "Add a transition `from: '" (object/get @x "to") "', event: '" @fe "'` that handles the failure (e.g. render an error toast)."), severity: "error" }] (if (array/some @arms (fn a (let ((ar (tree/fold (object/get (array/nth @trs (object/get @a "n")) "effects" []) (fn (n k) (if (validate/array @n) (let ((kr (array/map @k (fn q (if (= @q null) @nr @q))))) { s: @nos, f: @nos, ex: @nos, b: (or (and (>= (array/len @n) 3) (let ((h0 (array/nth @n 0))) (if (validate/string @h0) (= @h0 "render-ui") false)) (!= (array/nth @n 2) null)) (array/some @kr (fn q (object/get @q "b")))), e: (or (and (>= (array/len @n) 2) (let ((h0 (array/nth @n 0))) (if (validate/string @h0) (= @h0 "emit") false)) (let ((h1 (array/nth @n 1))) (if (validate/string @h1) (array/includes @reported @h1) false))) (array/some @kr (fn q (object/get @q "e")))), sf: false, ne: false, nod: false, pl: @nop }) @nr)) "CbNode"))) (let ((arr (if (= @ar null) @nr @ar))) (or (object/get @arr "b") (object/get @arr "e")))))) @nof [{ code: "ORB_CIRCUIT_FAILURE_ARM_RENDERS_NOTHING", path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "state '" (object/get @x "to") "' handles failure event '" @fe "' but its arm neither renders nor emits a declared event — the failure reaches no one"), suggestion: (str/concat "Emit a failure event the trait declares in `emits` from the '" @fe "' arm (its embedder presents it), or render it."), severity: "error" }]))))))))))))
                                        (array/flatten (array/map @tl (fn x (let ((effs (object/get (array/nth @trs (object/get @x "n")) "effects" []))) (let ((pq (tree/fold @effs (fn (n k) (if (validate/array @n) (let ((kr (array/map @k (fn q (if (= @q null) @nr @q)))) (h0 (if (> (array/len @n) 0) (array/nth @n 0) null)) (h1 (if (> (array/len @n) 1) (array/nth @n 1) null))) (if (and (>= (array/len @n) 3) (validate/string @h0) (= @h0 "render-ui") (validate/string @h1) (object/has @ovSet @h1)) (let ((p (array/nth @n 2))) { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: false, ne: false, nod: false, pl: [{ self: (or (and (validate/object @p) (let ((sv (object/get @p "slideOver" null))) (if (validate/boolean @sv) (= @sv true) false))) (object/get (let ((q (tree/fold @p (fn (n k) (if (validate/array @n) (let ((ne (array/some @k (fn q (object/get (if (= @q null) @nr @q) "nod"))))) { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: false, ne: @ne, nod: @ne, pl: @nop }) (if (validate/object @n) (let ((tv (object/get @n "type" null))) (let ((pt (if (validate/string @tv) @tv "")) (sf (or (let ((sv (object/get @n "slideOver" null))) (if (validate/boolean @sv) (= @sv true) false)) (and (validate/string @tv) (array/includes @config.selfOverlayPatterns @tv))))) (let ((ne (array/some (array/filter (object/keys @n) (fn key (and (not (str/includes @key ".")) (or (= @key "children") (and (!= @pt "") (let ((pe (object/get @entity.patterns @pt null))) (if (= @pe null) false (let ((pp (object/get @pe "props" null))) (if (= @pp null) false (let ((pr (object/get @pp @key null))) (if (= @pr null) false (array/includes (object/get @pr "types" @nos) "node")))))))))))) (fn key (object/get (object/get @k @key @nr) "nod"))))) { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: @sf, ne: @ne, nod: (or @sf @ne), pl: @nop }))) @nr))) "CbNode"))) (if (= @q null) @nr @q)) "ne")), pat: (and (!= @p null) (not (validate/string @p))), sty: (and (validate/object @p) (let ((tv (object/get @p "type" null))) (if (validate/string @tv) (array/includes @config.selfOverlayPatterns @tv) false))) }] }) { s: @nos, f: @nos, ex: @nos, b: false, e: false, sf: false, ne: false, nod: false, pl: (array/flatten (array/map @kr (fn q (object/get @q "pl")))) })) @nr)) "CbNode"))) (array/flatten (array/map (object/get (if (= @pq null) @nr @pq) "pl") (fn pl (array/concat (if (object/get @pl "self") [{ code: "ORB_CIRCUIT_SELF_OVERLAY_IN_SHELL", path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "transition " (object/get @x "fs") "--[" (object/get @x "e") "]-->" (object/get @x "to") " renders a self-overlaying pattern (`slideOver: true`, or a nested `modal`/`confirm-dialog`) inside an overlay slot payload — the generic portal shell wraps it too, stacking two overlay chromes"), suggestion: "Render the inner content pattern into the slot instead (the shell already provides the chrome and the X), or make the self-overlaying pattern the slot payload's ROOT node, which the shell renders bare.", severity: "error" }] @nof) (if (and (object/get @pl "pat") (not (object/get @pl "sty")) (not (array/some @tl (fn a (and (or (array/includes (object/get @a "f") (object/get @x "to")) (array/includes (object/get @a "f") "*")) (array/includes @config.shellDismissEvents (object/get @a "e"))))))) [{ code: "ORB_CIRCUIT_MODAL_SHELL_CLOSE_DEAF", path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "].effects"), message: (str/concat "state '" (object/get @x "to") "' mounts an overlay-slot pattern but has no `CLOSE`/`CANCEL` arm — the shell's own X/Escape/overlay-click control fires into nothing"), suggestion: (str/concat "Add a `CLOSE` (or `CANCEL`) arm in state '" (object/get @x "to") "' that clears the overlay slot."), severity: "error" }] @nof)))))))))))
                                      (array/flatten (array/map @tl (fn x (if (or (not (object/get @x "empty")) (not (array/some (object/get @x "f") (fn s (and (!= @s (object/get @x "to")) (array/includes @painted @s)))))) @nof [{ code: "ORB_CIRCUIT_DEAD_BODILESS_ACTION", path: (str/concat @tp ".stateMachine.transitions[" (object/get @x "n") "]"), message: (str/concat "'" (object/get @x "e") "' moves " (object/get @x "fs") " -> " (object/get @x "to") " but carries no effects — the machine leaves " (object/get @x "fs") " while the screen keeps its paint, so every affordance routed here is dead and the surface now disagrees with the state it is in"), suggestion: (str/concat "give the arm the body '" (object/get @x "to") "' should show — copy " (object/get @x "to") "'s INIT render (and its fetch, if any) into the arm. An (emit INIT) is not a substitute: the bus never delivers lifecycle events"), severity: "error" }])))))))))))))))))))))))
        (emit LINT_FINISH { })
      LINT_FINISH -> ready
        (emit LINT_FOUND { rule: "circuit-client-bound", scope: @entity.scope, findings: @entity.findings })
    }

    emits {
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "This rule's findings for the file, offered to the lint-all umbrella."
        @tier "internal"
      LINT_FINISH { }
        @description "Internal: answer with the verdict."
        @tier "internal"

    }

    listens {
      LINT_INPUT { file : string!  raw : string!  latin : boolean!  program : CbProgram  scope : string! }
        @description "The lint input: the file read, its language decided and the program lowered."
      OrbLintInput.LINT_INPUT -> LINT_INPUT
      INDEX_HEARD { scope : string!  heads : Map string [string]!  roots : Map string [string]! }
        @description "std-orb-lint-input's LINT_INDEX: the binding roots each inline trait uses; a trait is searched for @trait references only when its roots hold @trait."
      PATTERNS_HEARD { patterns : Map string CbPattern! }
        @description "std-orb-lint-input's LINT_PATTERNS: the installed pattern registry's props, each with its types."
      OrbLintInput.LINT_INDEX -> INDEX_HEARD
      OrbLintInput.LINT_PATTERNS -> PATTERNS_HEARD
    }

    config {
      overlaySlots : [string] = ["modal", "drawer", "dock", "overlay"]
        @label "Overlay slots"
        @description "The slots the generic portal shell wraps."
      mainSlots : [string] = ["main", "content", "screen"]
        @label "Main slots"
        @description "The inline content slots a state paints."
      selfOverlayPatterns : [string] = ["modal", "confirm-dialog"]
        @label "Self-overlaying patterns"
        @description "The patterns that draw their own overlay chrome."
      shellDismissEvents : [string] = ["CLOSE", "CANCEL"]
        @label "Shell dismiss events"
        @description "The events the portal shell fires at a trait that mounts it."
      failureOps : [string] = ["fetch", "persist", "call-service", "http", "redis", "postgres", "random-bytes", "credential-status", "credential-forget", "access-check", "oauth-authorize", "oauth-connection-status", "oauth-connection-forget", "program/eval", "program/compose", "credential-list", "credential-set", "credential-remove", "credential-test", "credential-mode", "credential-rotate"]
        @label "Failure-emitting operators"
        @description "The operators whose emit map carries the async-result failure event."
    }

  }

  trait OrbLintCircuitClientBoundCli -> OrbLintCircuitClientBoundRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (or (= (json/parse @payload.rawBody OrbCommandArgs) null) (!= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint circuit-client-bound <file>" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_FOUND -> ready when (and (= @payload.rule "circuit-client-bound") (= (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 200, body: "lint circuit-client-bound: clean" })
      LINT_FOUND -> ready when (and (= @payload.rule "circuit-client-bound") (> (array/len @payload.findings) 0))
        (emit LINT_ANSWERED { status: 500, body: (str/join (array/map @payload.findings (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion")))))) "\n") })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint circuit-client-bound: the file could not be read or lowered" })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  scope : string!  findings : [OrbFinding]! }
        @description "The rule trait's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-circuit-client-bound" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint circuit-client-bound` with its arguments and working directory."
        @synonyms "orb lint circuit-client-bound"
      OrbLintCircuitClientBound.LINT_FOUND -> LINT_FOUND
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }


  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintCircuitClientBoundCli.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  page boot as OrbLintCircuitClientBoundOrbitalStart -> OrbLintCircuitClientBound, OrbLintCircuitClientBoundCli, OrbLintInput, Packs, Versions
}
