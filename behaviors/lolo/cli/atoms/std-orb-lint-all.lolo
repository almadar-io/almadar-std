app std-orb-lint-all [
  version: "1.0.0",
  inbound: ["cli-lint-all"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-all — the `orb lint all <file> [--json]` umbrella. It holds no rule logic: it composes every file-taking std-orb-lint-* rule trait (shared-types is left out: it walks the std and io behavior trees and takes no file), broadcasts LINT_RUN { file } and collects LINT_FOUND { rule, findings } from each. Each rule answers its findings as { code, path, message, suggestion, severity } records, which the umbrella collects as they are (every ported Rust code is an error; ORB_AUTH_GUARD_CLIENT_ONLY, ORB_O_EXTEND_FIELD_UNREAD, ORB_LISTEN_WILDCARD_UNKEYED, ORB_OS_GRANT_UNUSED and ORB_EMIT_REPEATS_IDENTICALLY are the Rust warnings, so a rule porting one answers severity warning). It prints the rules with findings grouped and a total, or with --json a { findings } object of the structured findings, and exits 1 when any error-severity finding exists."
]
uses Spec from "almadar-std/lint-all"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error" }
type RuleFound = { rule : string!, findings : [OrbFinding]! }

orbital OrbLintAllOrbital {
  uses Input from "std/behaviors/std-orb-lint-input"
  uses CollectionPolicy from "std/behaviors/std-orb-lint-collection-policy"
  uses CrossDuplicateEntity from "std/behaviors/std-orb-lint-cross-duplicate-entity"
  uses EmitConfigRef from "std/behaviors/std-orb-lint-emit-config-ref"
  uses EntityBrowserStorage from "std/behaviors/std-orb-lint-entity-browser-storage"
  uses EntityDuplicateField from "std/behaviors/std-orb-lint-entity-duplicate-field"
  uses EntityEmptyEnum from "std/behaviors/std-orb-lint-entity-empty-enum"
  uses EntityFieldType from "std/behaviors/std-orb-lint-entity-field-type"
  uses EntityLocaleInstances from "std/behaviors/std-orb-lint-entity-locale-instances"
  uses EntityMockMember from "std/behaviors/std-orb-lint-entity-mock-member"
  uses EntitySeedSource from "std/behaviors/std-orb-lint-entity-seed-source"
  uses EntityPersistence from "std/behaviors/std-orb-lint-entity-persistence"
  uses EntitySemanticDefault from "std/behaviors/std-orb-lint-entity-semantic-default"
  uses EntityShape from "std/behaviors/std-orb-lint-entity-shape"
  uses HttpEgressEntry from "std/behaviors/std-orb-lint-http-egress-entry"
  uses GenericTypes from "std/behaviors/std-orb-lint-generic-types"
  uses IdentityUnique from "std/behaviors/std-orb-lint-identity-unique"
  uses Inbound from "std/behaviors/std-orb-lint-inbound"
  uses InitCoverage from "std/behaviors/std-orb-lint-init-coverage"
  uses EventIdUniqueness from "std/behaviors/std-orb-lint-event-id-uniqueness"
  uses ListenTrigger from "std/behaviors/std-orb-lint-listen-trigger"
  uses LiteralDefault from "std/behaviors/std-orb-lint-literal-default"
  uses OrbitalDuplicateName from "std/behaviors/std-orb-lint-orbital-duplicate-name"
  uses OrbitalMissingPages from "std/behaviors/std-orb-lint-orbital-missing-pages"
  uses PageEmptyTraits from "std/behaviors/std-orb-lint-page-empty-traits"
  uses PageModifiers from "std/behaviors/std-orb-lint-page-modifiers"
  uses IdRefs from "std/behaviors/std-orb-lint-id-refs"
  uses PagePath from "std/behaviors/std-orb-lint-page-path"
  uses PagePathUniqueness from "std/behaviors/std-orb-lint-page-path-uniqueness"
  uses PayloadFieldName from "std/behaviors/std-orb-lint-payload-field-name"
  uses RelationTargets from "std/behaviors/std-orb-lint-relation-targets"
  uses SignInRoute from "std/behaviors/std-orb-lint-sign-in-route"
  uses StoreBinding from "std/behaviors/std-orb-lint-store-binding"
  uses TraitIdUniqueness from "std/behaviors/std-orb-lint-trait-id-uniqueness"
  uses UntypedArray from "std/behaviors/std-orb-lint-untyped-array"
  uses SchemaHeader from "std/behaviors/std-orb-lint-schema-header"
  uses DuplicateTransition from "std/behaviors/std-orb-lint-duplicate-transition"
  uses StateShape from "std/behaviors/std-orb-lint-state-shape"
  uses EmptyEventName from "std/behaviors/std-orb-lint-empty-event-name"
  uses Slot from "std/behaviors/std-orb-lint-slot"
  uses TransitionRefs from "std/behaviors/std-orb-lint-transition-refs"
  uses StateUnreachable from "std/behaviors/std-orb-lint-state-unreachable"
  uses ThemePinContradictsApp from "std/behaviors/std-orb-lint-theme-pin-contradicts-app"
  uses AssetInlineUrl from "std/behaviors/std-orb-lint-asset-inline-url"
  uses MissingOrbitalName from "std/behaviors/std-orb-lint-missing-orbital-name"
  uses DuplicateUseAlias from "std/behaviors/std-orb-lint-duplicate-use-alias"
  uses TickRequiresRuntime from "std/behaviors/std-orb-lint-tick-requires-runtime"

  entity OrbLintAllRun [runtime] {
    id : string!
    found : [RuleFound] = []
    all : [OrbFinding] = []
    asJson : boolean = false
  }

  trait OrbLintAll -> OrbLintAllRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (not (or (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1) (and (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 2) (= (array/nth (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") 1) "--json"))))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint all <file> [--json]" })
      LINT_CALLED -> collecting when (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1)
        (set @entity.found [])
        (set @entity.asJson false)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
      LINT_CALLED -> collecting when (and (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 2) (= (array/nth (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") 1) "--json"))
        (set @entity.found [])
        (set @entity.asJson true)
        (emit LINT_REQUEST { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state collecting {
      INIT -> collecting
      LINT_FOUND -> collecting
        (set @entity.found (array/concat @entity.found [{ rule: @payload.rule, findings: @payload.findings }]))
        (emit LINT_SETTLE { })
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: "lint all: the file could not be read or lowered" })
      LINT_SETTLE -> collecting when (< (array/len @entity.found) @config.ruleCount)
      LINT_SETTLE -> collecting when (>= (array/len @entity.found) @config.ruleCount)
        (set @entity.all (array/flatten (array/map @entity.found (fn r (object/get @r "findings")))))
        (emit LINT_COLLECTED { findings: (array/flatten (array/map @entity.found (fn r (object/get @r "findings")))) })
        (emit LINT_REPORT { })
      LINT_REPORT -> ready when (and (not @entity.asJson) (= (array/len @entity.all) 0))
        (emit LINT_ANSWERED { status: 200, body: (str/concat "lint all: clean (" (array/len @entity.found) " rules)") })
      LINT_REPORT -> ready when @entity.asJson
        (emit LINT_ANSWERED { status: (if (> (array/len (array/filter @entity.all (fn x (= (object/get @x "severity") "error")))) 0) 500 200), body: (json/stringify { findings: @entity.all }) })
      LINT_REPORT -> ready when (and (not @entity.asJson) (> (array/len @entity.all) 0))
        (emit LINT_ANSWERED { status: (if (> (array/len (array/filter @entity.all (fn x (= (object/get @x "severity") "error")))) 0) 500 200), body: (let ((hits (array/sort (array/filter @entity.found (fn r (> (array/len (object/get @r "findings")) 0))) "rule" "asc"))) (str/join (array/concat (array/flatten (array/map @hits (fn r (array/concat [(str/concat "== " (object/get @r "rule") " (" (array/len (object/get @r "findings")) ")")] (array/map (object/get @r "findings") (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion"))))))))))  [(str/concat "lint all: " (array/len @entity.all) " finding(s) in " (array/len @hits) " rule(s)")]) "\n")) })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_REQUEST -> external { file : string! }
        @description "Ask the lint input to read and lower this file once for every rule."
        @tier "internal"
      LINT_FOUND -> external { rule : string!  findings : [OrbFinding]! }
        @description "One rule atom's findings for the file."
        @tier "internal"
      LINT_INPUT_UNREAD -> external { file : string! }
        @description "The lint input could not read or lower the file."
        @tier "internal"
      LINT_COLLECTED -> external { findings : [OrbFinding]! }
        @description "Every rule's findings for the file, flattened: the structured answer of a run, heard by a program that composes the umbrella (std-orb-validate)."
        @tier "internal"
      LINT_SETTLE { }
        @description "Internal: check whether every rule answered."
        @tier "internal"
      LINT_REPORT { }
        @description "Internal: every rule answered."
        @tier "internal"
    }

    config {
      ruleCount : number = 46
        @label "Rule count"
        @description "How many composed rule traits answer LINT_FOUND before the run settles."
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-all" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint all` with its arguments and working directory."
        @synonyms "orb lint all, run every lint rule"
      LINT_INPUT_UNREAD { file : string! }
        @description "The lint input could not read or lower the file."
      OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
      OrbLintCollectionPolicy.LINT_FOUND -> LINT_FOUND
      OrbLintCrossDuplicateEntity.LINT_FOUND -> LINT_FOUND
      OrbLintEmitConfigRef.LINT_FOUND -> LINT_FOUND
      OrbLintEntityBrowserStorage.LINT_FOUND -> LINT_FOUND
      OrbLintEntityDuplicateField.LINT_FOUND -> LINT_FOUND
      OrbLintEntityEmptyEnum.LINT_FOUND -> LINT_FOUND
      OrbLintEntityFieldType.LINT_FOUND -> LINT_FOUND
      OrbLintEntityLocaleInstances.LINT_FOUND -> LINT_FOUND
      OrbLintEntityMockMember.LINT_FOUND -> LINT_FOUND
      OrbLintEntitySeedSource.LINT_FOUND -> LINT_FOUND
      OrbLintEntityPersistence.LINT_FOUND -> LINT_FOUND
      OrbLintEntitySemanticDefault.LINT_FOUND -> LINT_FOUND
      OrbLintEntityShape.LINT_FOUND -> LINT_FOUND
      OrbLintHttpEgressEntry.LINT_FOUND -> LINT_FOUND
      OrbLintGenericTypes.LINT_FOUND -> LINT_FOUND
      OrbLintIdentityUnique.LINT_FOUND -> LINT_FOUND
      OrbLintInbound.LINT_FOUND -> LINT_FOUND
      OrbLintInitCoverage.LINT_FOUND -> LINT_FOUND
      OrbLintEventIdUniqueness.LINT_FOUND -> LINT_FOUND
      OrbLintListenTrigger.LINT_FOUND -> LINT_FOUND
      OrbLintLiteralDefault.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalDuplicateName.LINT_FOUND -> LINT_FOUND
      OrbLintOrbitalMissingPages.LINT_FOUND -> LINT_FOUND
      OrbLintPageEmptyTraits.LINT_FOUND -> LINT_FOUND
      OrbLintPageModifiers.LINT_FOUND -> LINT_FOUND
      OrbLintIdRefs.LINT_FOUND -> LINT_FOUND
      OrbLintPagePath.LINT_FOUND -> LINT_FOUND
      OrbLintPagePathUniqueness.LINT_FOUND -> LINT_FOUND
      OrbLintPayloadFieldName.LINT_FOUND -> LINT_FOUND
      OrbLintRelationTargets.LINT_FOUND -> LINT_FOUND
      OrbLintSignInRoute.LINT_FOUND -> LINT_FOUND
      OrbLintStoreBinding.LINT_FOUND -> LINT_FOUND
      OrbLintTraitIdUniqueness.LINT_FOUND -> LINT_FOUND
      OrbLintUntypedArray.LINT_FOUND -> LINT_FOUND
      OrbLintSchemaHeader.LINT_FOUND -> LINT_FOUND
      OrbLintDuplicateTransition.LINT_FOUND -> LINT_FOUND
      OrbLintSlot.LINT_FOUND -> LINT_FOUND
      OrbLintStateShape.LINT_FOUND -> LINT_FOUND
      OrbLintEmptyEventName.LINT_FOUND -> LINT_FOUND
      OrbLintTransitionRefs.LINT_FOUND -> LINT_FOUND
      OrbLintStateUnreachable.LINT_FOUND -> LINT_FOUND
      OrbLintMissingOrbitalName.LINT_FOUND -> LINT_FOUND
      OrbLintAssetInlineUrl.LINT_FOUND -> LINT_FOUND
      OrbLintThemePinContradictsApp.LINT_FOUND -> LINT_FOUND
      OrbLintDuplicateUseAlias.LINT_FOUND -> LINT_FOUND
      OrbLintTickRequiresRuntime.LINT_FOUND -> LINT_FOUND
    }
  }

  trait Versions = Input.traits.Versions {
  }
  trait Packs = Input.traits.Packs {
  }
  trait OrbLintInput = Input.traits.OrbLintInput {
    listens {
      OrbLintAll.LINT_REQUEST -> LINT_REQUEST
      LANG_SCAN_ANSWERED { status : number!  body : string!  stderr : string! }
        @description "std-orb-language's SCAN_ANSWERED: a failed scan answers 500 and never reaches LANGUAGE_PACKS_DONE."
      LANGUAGE_PACK_VOCAB_HEARD { name : string!  text : string! }
        @description "std-orb-language's LANGUAGE_PACK_VOCAB: a checked pack and its vocabulary text."
      LANGUAGE_PACKS_DONE_HEARD { problem : string! }
        @description "std-orb-language's LANGUAGE_PACKS_DONE: the scan finished."
      Packs.SCAN_ANSWERED -> LANG_SCAN_ANSWERED
      Packs.LANGUAGE_PACK_VOCAB -> LANGUAGE_PACK_VOCAB_HEARD
      Packs.LANGUAGE_PACKS_DONE -> LANGUAGE_PACKS_DONE_HEARD
    }
  }

  trait OrbLintCollectionPolicy = CollectionPolicy.traits.OrbLintCollectionPolicy {
  }
  trait OrbLintCrossDuplicateEntity = CrossDuplicateEntity.traits.OrbLintCrossDuplicateEntity {
  }
  trait OrbLintEmitConfigRef = EmitConfigRef.traits.OrbLintEmitConfigRef {
  }
  trait OrbLintEntityBrowserStorage = EntityBrowserStorage.traits.OrbLintEntityBrowserStorage {
  }
  trait OrbLintEntityDuplicateField = EntityDuplicateField.traits.OrbLintEntityDuplicateField {
  }
  trait OrbLintEntityEmptyEnum = EntityEmptyEnum.traits.OrbLintEntityEmptyEnum {
  }
  trait OrbLintEntityFieldType = EntityFieldType.traits.OrbLintEntityFieldType {
  }
  trait OrbLintEntityLocaleInstances = EntityLocaleInstances.traits.OrbLintEntityLocaleInstances {
  }
  trait OrbLintEntityMockMember = EntityMockMember.traits.OrbLintEntityMockMember {
  }
  trait OrbLintEntitySeedSource = EntitySeedSource.traits.OrbLintEntitySeedSource {
  }
  trait OrbLintEntityPersistence = EntityPersistence.traits.OrbLintEntityPersistence {
  }
  trait OrbLintEntitySemanticDefault = EntitySemanticDefault.traits.OrbLintEntitySemanticDefault {
  }
  trait OrbLintEntityShape = EntityShape.traits.OrbLintEntityShape {
  }
  trait OrbLintHttpEgressEntry = HttpEgressEntry.traits.OrbLintHttpEgressEntry {
  }
  trait OrbLintGenericTypes = GenericTypes.traits.OrbLintGenericTypes {
  }
  trait OrbLintIdentityUnique = IdentityUnique.traits.OrbLintIdentityUnique {
  }
  trait OrbLintInbound = Inbound.traits.OrbLintInbound {
  }
  trait OrbLintInitCoverage = InitCoverage.traits.OrbLintInitCoverage {
  }
  trait OrbLintEventIdUniqueness = EventIdUniqueness.traits.OrbLintEventIdUniqueness {
  }
  trait OrbLintListenTrigger = ListenTrigger.traits.OrbLintListenTrigger {
  }
  trait OrbLintLiteralDefault = LiteralDefault.traits.OrbLintLiteralDefault {
  }
  trait OrbLintOrbitalDuplicateName = OrbitalDuplicateName.traits.OrbLintOrbitalDuplicateName {
  }
  trait OrbLintOrbitalMissingPages = OrbitalMissingPages.traits.OrbLintOrbitalMissingPages {
  }
  trait OrbLintPageEmptyTraits = PageEmptyTraits.traits.OrbLintPageEmptyTraits {
  }
  trait OrbLintPageModifiers = PageModifiers.traits.OrbLintPageModifiers {
  }
  trait OrbLintIdRefs = IdRefs.traits.OrbLintIdRefs {
  }
  trait OrbLintPagePath = PagePath.traits.OrbLintPagePath {
  }
  trait OrbLintPagePathUniqueness = PagePathUniqueness.traits.OrbLintPagePathUniqueness {
  }
  trait OrbLintPayloadFieldName = PayloadFieldName.traits.OrbLintPayloadFieldName {
  }
  trait OrbLintRelationTargets = RelationTargets.traits.OrbLintRelationTargets {
  }
  trait OrbLintSignInRoute = SignInRoute.traits.OrbLintSignInRoute {
  }
  trait OrbLintStoreBinding = StoreBinding.traits.OrbLintStoreBinding {
  }
  trait OrbLintTraitIdUniqueness = TraitIdUniqueness.traits.OrbLintTraitIdUniqueness {
  }
  trait OrbLintUntypedArray = UntypedArray.traits.OrbLintUntypedArray {
  }
  trait OrbLintSchemaHeader = SchemaHeader.traits.OrbLintSchemaHeader {
  }
  trait OrbLintDuplicateTransition = DuplicateTransition.traits.OrbLintDuplicateTransition {
  }
  trait OrbLintSlot = Slot.traits.OrbLintSlot {
  }
  trait OrbLintStateShape = StateShape.traits.OrbLintStateShape {
  }
  trait OrbLintEmptyEventName = EmptyEventName.traits.OrbLintEmptyEventName {
  }
  trait OrbLintTransitionRefs = TransitionRefs.traits.OrbLintTransitionRefs {
  }
  trait OrbLintStateUnreachable = StateUnreachable.traits.OrbLintStateUnreachable {
  }
  trait OrbLintMissingOrbitalName = MissingOrbitalName.traits.OrbLintMissingOrbitalName {
  }
  trait OrbLintAssetInlineUrl = AssetInlineUrl.traits.OrbLintAssetInlineUrl {
  }
  trait OrbLintThemePinContradictsApp = ThemePinContradictsApp.traits.OrbLintThemePinContradictsApp {
  }
  trait OrbLintDuplicateUseAlias = DuplicateUseAlias.traits.OrbLintDuplicateUseAlias {
  }
  trait OrbLintTickRequiresRuntime = TickRequiresRuntime.traits.OrbLintTickRequiresRuntime {
  }

  page boot as OrbLintAllOrbitalStart -> OrbLintAll, OrbLintInput, Packs, Versions, OrbLintCollectionPolicy, OrbLintCrossDuplicateEntity, OrbLintEmitConfigRef, OrbLintEntityBrowserStorage, OrbLintEntityDuplicateField, OrbLintEntityEmptyEnum, OrbLintEntityFieldType, OrbLintEntityLocaleInstances, OrbLintEntityMockMember, OrbLintEntityPersistence, OrbLintEntitySeedSource, OrbLintEntitySemanticDefault, OrbLintEntityShape, OrbLintHttpEgressEntry, OrbLintGenericTypes, OrbLintIdentityUnique, OrbLintInbound, OrbLintInitCoverage, OrbLintEventIdUniqueness, OrbLintListenTrigger, OrbLintLiteralDefault, OrbLintOrbitalDuplicateName, OrbLintOrbitalMissingPages, OrbLintPageEmptyTraits, OrbLintPageModifiers, OrbLintIdRefs, OrbLintPagePath, OrbLintPagePathUniqueness, OrbLintPayloadFieldName, OrbLintRelationTargets, OrbLintSignInRoute, OrbLintStoreBinding, OrbLintTraitIdUniqueness, OrbLintUntypedArray, OrbLintSchemaHeader, OrbLintDuplicateTransition, OrbLintStateShape, OrbLintEmptyEventName, OrbLintSlot, OrbLintTransitionRefs, OrbLintStateUnreachable, OrbLintMissingOrbitalName, OrbLintDuplicateUseAlias, OrbLintThemePinContradictsApp, OrbLintTickRequiresRuntime, OrbLintAssetInlineUrl, Versions, Packs
}
