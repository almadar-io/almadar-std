app std-orb-lint-all [
  version: "1.0.0",
  inbound: ["cli-lint-all"],
  env: ["PATH"],
  exec: ["orb"],
  fs: { cwd: "**": [read], "/**": [read], "~/.orb/node_modules/**": [read] },
  description: "std-orb-lint-all — the `orb lint all <file> [--json]` hook, the only declarer of cli-lint-all. It holds no rule logic: it composes the std-orb-lint-engine orbital (every file-taking std-orb-lint-* rule trait, collected into one answer), asks it LINT_RUN { file } and hears LINT_COLLECTED { findings, found }. Each rule answers its findings as { code, path, message, suggestion, severity } records, which the engine collects as they are (ORB_AUTH_GUARD_CLIENT_ONLY, ORB_O_EXTEND_FIELD_UNREAD, ORB_LISTEN_WILDCARD_UNKEYED, ORB_OS_GRANT_UNUSED and ORB_EMIT_REPEATS_IDENTICALLY are the warnings). It prints the rules with findings grouped and a total, or with --json a { findings } object of the structured findings, and exits 1 when any error-severity finding exists."
]
uses Spec from "almadar-std/lint-all"
uses LintEngine from "std/behaviors/std-orb-lint-engine"
type OrbCommandArgs = { argv : [string]!, cwd : string! }
type OrbFinding = { code : string!, path : string!, message : string!, suggestion : string!, severity : "warning" | "error", validValues : [string] }
type RuleFound = { rule : string!, findings : [OrbFinding]! }

orbital OrbLintAllOrbital {
  entity OrbLintAllRun [runtime] {
    id : string!
    found : [RuleFound] = []
    all : [OrbFinding] = []
    asJson : boolean = false
  }

  trait OrbLintAll -> OrbLintAllRun [client] {
    initial: ready

    state ready {
      INIT -> ready
      LINT_CALLED -> ready when (= (json/parse @payload.rawBody OrbCommandArgs) null)
        (emit LINT_ANSWERED { status: 500, body: "Error: orb lint all: the command arguments could not be read" })
      LINT_CALLED -> ready when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (not (or (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1) (and (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 2) (= (array/nth (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") 1) "--json")))))
        (emit LINT_ANSWERED { status: 400, body: "usage: orb lint all <file> [--json]" })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 1))
        (set @entity.asJson false)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
      LINT_CALLED -> waiting when (and (!= (json/parse @payload.rawBody OrbCommandArgs) null) (= (array/len (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) 2) (= (array/nth (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv") 1) "--json"))
        (set @entity.asJson true)
        (emit LINT_RUN { file: (array/first (object/get (json/parse @payload.rawBody OrbCommandArgs) "argv")) })
    }

    state waiting {
      INIT -> waiting
      LINT_INPUT_UNREAD -> ready
        (emit LINT_ANSWERED { status: 500, body: (str/concat "lint all: the file could not be read or lowered" (if (= @payload.error "") "" (str/concat ": " @payload.error))) })
      LINT_COLLECTED -> waiting
        (set @entity.found @payload.found)
        (set @entity.all @payload.findings)
        (emit LINT_REPORT { })
      LINT_REPORT -> ready when (and (not @entity.asJson) (= (array/len @entity.all) 0))
        (emit LINT_ANSWERED { status: 200, body: (str/concat "lint all: clean (" (array/len @entity.found) " rules)") })
      LINT_REPORT -> ready when @entity.asJson
        (emit LINT_ANSWERED { status: (if (> (array/len (array/filter @entity.all (fn x (= (object/get @x "severity") "error")))) 0) 500 200), body: (json/stringify { findings: @entity.all }) })
      LINT_REPORT -> ready when (and (not @entity.asJson) (> (array/len @entity.all) 0))
        (emit LINT_ANSWERED { status: (if (> (array/len (array/filter @entity.all (fn x (= (object/get @x "severity") "error")))) 0) 500 200), body: (let ((hits (array/sort (array/filter @entity.found (fn r (> (array/len (object/get @r "findings")) 0))) "rule" "asc"))) (str/join (array/concat (array/flatten (array/map @hits (fn r (array/concat [(str/concat "== " (object/get @r "rule") " (" (array/len (object/get @r "findings")) ")")] (array/map (object/get @r "findings") (fn x (str/concat "[" (object/get @x "code") "] " (object/get @x "path") ": " (object/get @x "message") (if (= (object/get @x "suggestion") "") "" (str/concat "\n  suggestion: " (object/get @x "suggestion"))))))))))  [(str/concat "lint all: " (array/len @entity.all) " finding(s) in " (array/len @hits) " rule(s)")]) "\n")) })
    }

    emits {
      LINT_ANSWERED -> internal {
        status : number!
        body : string!
      }
        @description "Internal: the command's answer, which the cli hook prints."
        @tier "internal"
      LINT_RUN -> external { file : string! }
        @description "Ask the lint engine to run every rule over this file."
        @tier "internal"
      LINT_REPORT { }
        @description "Internal: the engine answered, print the run."
        @tier "internal"
    }

    listens {
      LINT_CALLED -> inbound "cli-lint-all" answers LINT_ANSWERED {
        headers : Map string string
        rawBody : string
      }
        @description "Run `orb lint all` with its arguments and working directory."
        @synonyms "orb lint all, run every lint rule"
      LINT_INPUT_UNREAD { file : string!  error : string! }
        @description "The lint input could not read or lower the file."
      LINT_COLLECTED { findings : [OrbFinding]!  found : [RuleFound]! }
        @description "The engine's answer: every rule's findings for the file, flattened, and the findings by rule."
      Rules.OrbLintEngine.LINT_COLLECTED -> LINT_COLLECTED
      Rules.OrbLintInput.LINT_INPUT_UNREAD -> LINT_INPUT_UNREAD
    }
  }

  page boot as OrbLintAllOrbitalStart -> OrbLintAll
}

orbital Rules = LintEngine.orbitals.OrbLintEngineOrbital {
  listens {
    OrbLintAllOrbital.OrbLintAll.LINT_RUN -> OrbLintEngine.LINT_RUN
  }
}
